---
/**
 * «Page not found», in the style of the home page (Starlight's own 404 is off: `disable404Route` in astro.config.mjs).
 * GitHub Pages serves dist/404.html for every missing address, so GoatCounter (count.js) records which broken links
 * people follow. Images: far side of the Moon by LRO (NASA, public domain) and the first far-side photo by «Луна-3»
 * (7 Oct 1959, public domain on Wikimedia Commons); credits on uchebnik/istochniki.
 */
import '@fontsource/alice';
import '@fontsource/great-vibes';
import StarrySky from '../components/StarrySky.astro';
import { MOTION_SCRIPT } from '../plugins/motion.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const textbook = `${base}uchebnik/`;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Страница не найдена — Физика, которая нравится</title>
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#070b22" />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<script is:inline set:html={MOTION_SCRIPT} />
		<script is:inline data-goatcounter="https://irenegorbunova.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
	</head>
	<body>
		<StarrySky />

		<header class="nav">
			<a class="nav__brand" href={base}>
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><path d="M12 1.5l2.2 8.3 8.3 2.2-8.3 2.2L12 22.5l-2.2-8.3L1.5 12l8.3-2.2z"></path></svg
				>
				<span>Физика</span>
			</a>
		</header>

		<main class="lost">
			<div class="lost__moon">
				<img src={`${base}moon/moon-far.jpg`} width="560" height="560" alt="Обратная сторона Луны, снимок зонда LRO (NASA)" />
			</div>
			<p class="lost__code">Страница не найдена · 404</p>
			<h1 class="lost__title">Эта страница на обратной стороне Луны — отсюда её&nbsp;не&nbsp;видно.</h1>
			<div class="lost__actions">
				<a class="btn btn--primary" href={textbook}>Открыть учебник</a>
				<a class="btn btn--ghost" href={base}>На главную</a>
			</div>
			<figure class="lost__first">
				<img src={`${base}moon/luna-3.jpg`} width="640" height="493" alt="Первый снимок обратной стороны Луны" loading="lazy" />
				<figcaption>Первый снимок обратной стороны Луны сделала станция «Луна-3» 7&nbsp;октября 1959&nbsp;года.</figcaption>
			</figure>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #070b22;
		--text: #e9ecff;
		--muted: #a8afd6;
		--faint: #747cab;
		--gold: #f3c969;
		--gold-hi: #ffdf9c;
		--line: rgb(255 255 255 / 0.12);
		--font: 'Alice', Georgia, serif;
		--font-display: 'Great Vibes', cursive;
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
		font-size: 1.1rem;
		line-height: 1.65;
		font-synthesis-weight: none;
		-webkit-font-smoothing: antialiased;
	}
	a {
		color: inherit;
	}

	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		padding: 0.9rem clamp(1rem, 4vw, 2.5rem);
		background: linear-gradient(180deg, rgb(5 8 25 / 0.75), rgb(5 8 25 / 0));
	}
	.nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}
	.nav__brand span {
		font-family: var(--font-display);
		font-size: 1.9rem;
		line-height: 1;
	}
	.nav__brand svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: var(--gold);
		filter: drop-shadow(0 0 6px rgb(243 201 105 / 0.7));
	}

	.lost {
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 5rem 1rem 2.5rem;
	}
	.lost > * {
		animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	.lost__moon {
		position: relative;
		width: clamp(9.5rem, 30vw, 14rem);
		aspect-ratio: 1;
		margin-bottom: 1.4rem;
	}
	.lost__moon::before {
		content: '';
		position: absolute;
		inset: -45%;
		border-radius: 50%;
		background: radial-gradient(
			circle closest-side,
			rgb(255 246 222 / 0.22) 0%,
			rgb(255 240 210 / 0.1) 40%,
			rgb(190 200 255 / 0.04) 65%,
			transparent 100%
		);
		pointer-events: none;
	}
	.lost__moon img {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		filter: sepia(0.12) brightness(1.05);
		animation: float 7s ease-in-out infinite;
	}
	.lost__code {
		margin: 0 0 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--gold);
		animation-delay: 0.15s;
	}
	.lost__title {
		max-width: 30rem;
		margin: 0;
		font-weight: 400;
		font-size: clamp(1.35rem, 3.4vw, 1.9rem);
		line-height: 1.35;
		text-shadow: 0 0 30px rgb(140 160 255 / 0.35);
		animation-delay: 0.3s;
	}
	.lost__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin: 1.6rem 0 2.2rem;
		animation-delay: 0.45s;
	}
	.lost__first {
		margin: 0;
		width: min(15rem, 100%);
		animation-delay: 0.6s;
	}
	.lost__first img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		border: 1px solid var(--line);
		box-shadow: 0 14px 40px rgb(0 0 0 / 0.4);
	}
	.lost__first figcaption {
		margin-top: 0.55rem;
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--muted);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 1.6rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.98rem;
		text-decoration: none;
		transition:
			transform 0.2s,
			box-shadow 0.2s,
			background 0.2s;
	}
	.btn--primary {
		background: linear-gradient(180deg, var(--gold-hi), var(--gold));
		color: #1a1405;
		box-shadow: 0 0 24px rgb(243 201 105 / 0.35);
	}
	.btn--primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 0 36px rgb(243 201 105 / 0.55);
	}
	.btn--ghost {
		border: 1px solid rgb(243 201 105 / 0.6);
		background: rgb(255 255 255 / 0.04);
		backdrop-filter: blur(6px);
	}
	.btn--ghost:hover {
		border-color: var(--gold);
		background: rgb(243 201 105 / 0.12);
	}
	.btn:focus-visible,
	.nav__brand:focus-visible {
		outline: 2px solid var(--gold);
		outline-offset: 3px;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
	}
	@keyframes float {
		50% {
			transform: translateY(-7px);
		}
	}
</style>
