---
import '@fontsource/alice';
import '@fontsource/great-vibes';
import StarrySky from '../components/StarrySky.astro';
import SiteStats from '../components/SiteStats.astro';
import HeroMoon from '../components/moon/HeroMoon.astro';
import NovoeList from '../components/NovoeList.astro';
import { MOTION_SCRIPT } from '../plugins/motion.mjs';
import { getImage } from 'astro:assets';
import irinaPortrait from '../assets/irina-portrait.jpg';
import irinaFace from '../assets/irina-face.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const textbook = `${base}uchebnik/`;

// «Обо мне»: on a computer the portrait fills the column left of the text, on a phone the face is a circle.
// High quality on purpose: the photo must stay sharp on every screen. The portrait is cropped to the height of
// the text, so it is drawn wider than its column: sizes="36rem" is that drawn width, not the column's.
const QUALITY = { avif: 80, webp: 92, jpg: 92 };
const srcset = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
	(await getImage({ src, widths, format, quality: QUALITY[format] })).srcSet.attribute;
const FACE = [200, 400, 600, 990];
const PORTRAIT = [336, 672, 1008, 1344];
const photo = {
	faceAvif: await srcset(irinaFace, FACE, 'avif'),
	faceWebp: await srcset(irinaFace, FACE, 'webp'),
	portraitAvif: await srcset(irinaPortrait, PORTRAIT, 'avif'),
	portraitWebp: await srcset(irinaPortrait, PORTRAIT, 'webp'),
	fallback: await getImage({ src: irinaPortrait, width: 1008, format: 'jpg', quality: QUALITY.jpg }),
};
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Физика, которая нравится</title>
		<meta
			name="description"
			content="Учитель физики и репетитор: занятия по физике для 7–11 классов и учебник с интерактивными моделями."
		/>
		<meta name="theme-color" content="#070b22" />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<script is:inline set:html={MOTION_SCRIPT} />
		<script is:inline data-goatcounter="https://irenegorbunova.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<StarrySky />
		<SiteStats />

		<header class="nav">
			<a class="nav__brand" href="#top">
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><path d="M12 1.5l2.2 8.3 8.3 2.2-8.3 2.2L12 22.5l-2.2-8.3L1.5 12l8.3-2.2z"></path></svg
				>
				<span>Физика</span>
			</a>
			<nav class="nav__links" aria-label="Разделы">
				<a href="#obo-mne">Обо мне</a>
				<a href="#zanyatiya">Занятия</a>
				<a href="#kontakty">Контакты</a>
				<a class="nav__cta" href={textbook}>Учебник</a>
			</nav>
		</header>

		<main id="top">
			<section class="hero">
				<h1 class="hero__name">Физика,<br />которая нравится</h1>
				<p class="hero__lead">Интерактивный учебник Ирины Горбуновой, который помогает понять и полюбить физику</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href={textbook}>Открыть учебник</a>
				</div>
				<a class="hero__scroll" href="#obo-mne" aria-label="Листать вниз">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
				</a>
				<HeroMoon />
			</section>

			<section id="obo-mne" class="section">
				<div class="panel about" data-reveal>
					<picture class="about__pic">
						<source media="(max-width: 48rem)" type="image/avif" srcset={photo.faceAvif} sizes="12rem" />
						<source media="(max-width: 48rem)" type="image/webp" srcset={photo.faceWebp} sizes="12rem" />
						<source type="image/avif" srcset={photo.portraitAvif} sizes="36rem" />
						<source type="image/webp" srcset={photo.portraitWebp} sizes="36rem" />
						<img
							class="about__photo"
							src={photo.fallback.src}
							width={photo.fallback.attributes.width}
							height={photo.fallback.attributes.height}
							alt="Ирина"
							loading="lazy"
							decoding="async"
						/>
					</picture>
					<div class="about__text">
						<div class="about__head">
							<h2>Обо мне</h2>
							<div class="binary" data-binary>
								<button
									type="button"
									class="binary__btn"
									aria-label="Двойная звезда"
									aria-expanded="false"
									aria-controls="binary-card"
									aria-describedby="binary-card"
								>
									<svg class="binary__sky" viewBox="0 0 420 130" aria-hidden="true">
										<path class="binary__route" d="M114 22 Q46 22 32 84 Q200 -6 374 92"></path>
										<g class="binary__stops">
											<circle cx="114" cy="22" r="2.2"></circle>
											<circle cx="32" cy="84" r="2.2"></circle>
											<circle cx="374" cy="92" r="2.2"></circle>
											<text class="binary__east" x="134" y="26">Россия</text>
											<text x="32" y="114">Италия</text>
											<text x="374" y="122">Китай</text>
										</g>
										<path class="binary__trail binary__trail--a" d=""></path>
										<path class="binary__trail binary__trail--b" d=""></path>
										<circle class="binary__star binary__star--a" cx="384" cy="92" r="4.5"></circle>
										<circle class="binary__star binary__star--b" cx="364" cy="92" r="4.5"></circle>
									</svg>
								</button>
								<div class="binary__card" id="binary-card" role="tooltip">
									<p class="binary__title">Двойная звезда</p>
									<p>
										Две звезды равной массы кружат вокруг общего центра масс, и&nbsp;ни одна не вращается вокруг
										другой. Физики называют такую пару связанной системой: звёзды удерживают друг друга
										притяжением, светят друг другу и всюду движутся вместе. Для меня это символ нашей семьи:
										вместе с мужем мы прошли путь из России через Италию в&nbsp;Китай.
									</p>
									<p>
										В полёте каждая звезда рисует петли и волны. По такой волнистой траектории Сириуса Фридрих
										Бессель в&nbsp;1844&nbsp;году понял, что рядом с ним есть невидимый спутник. Сам спутник, белый
										карлик Сириус&nbsp;B, впервые увидели в телескоп только в&nbsp;1862&nbsp;году.
									</p>
								</div>
							</div>
						</div>
						<p>Меня зовут Ирина, я учитель физики.</p>
						<p>
							Преподавать самую красивую науку я начала ещё студенткой: сначала как репетитор, а на последнем курсе
							университета совмещала учёбу с работой в государственной школе в Москве. Там я проработала четыре
							прекрасных года
							и с большим удовольствием открывала ученикам физические явления и законы, по которым устроен мир.
						</p>
						<p>
							Вслед за мужем, учёным-физиком, я переехала в Италию, и со&nbsp;школой пришлось расстаться. Я жила в стране,
							где родился Архимед, сделал свои великие открытия Энрико Ферми и преподавал Галилей. И, конечно, я
							продолжала преподавать, уже онлайн. Так я работаю и сейчас, из Китая, куда нас привела научная жизнь мужа.
						</p>
						<p>
							Вместе с ним мы создали <a href={textbook}>интерактивный учебник физики</a> для <span class="nowrap">7–11&nbsp;классов</span>. Он
							построен по классическим школьным учебникам: в&nbsp;нём всё самое нужное по школьной программе, а ещё много
							опытов и наглядных примеров, которые помогают погрузиться в мир физики и понять&nbsp;её.
						</p>
					</div>
				</div>
			</section>

			<section id="zanyatiya" class="section">
				<h2 class="section__title" data-reveal>Занятия</h2>
				<div class="cards">
					<article class="panel card" data-reveal>
						<svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true"
							><path d="M4 5.5A2.5 2.5 0 016.5 3H20v15H6.5A2.5 2.5 0 004 20.5z"></path><path d="M4 20.5A2.5 2.5 0 016.5 18H20v3H6.5A2.5 2.5 0 014 20.5z"
							></path></svg
						>
						<h3>Школьная программа</h3>
						<p>Обсуждаем простым языком физические законы и явления. Помогаю научиться решать задачи и понимать их смысл.</p>
					</article>
					<article class="panel card" data-reveal>
						<svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true"
							><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.5"
							></circle></svg
						>
						<h3>ОГЭ и ЕГЭ</h3>
						<p>Разбираем и решаем задачи из сборников ОГЭ и ЕГЭ. Учимся понимать задачи и законы, которые в них работают.</p>
					</article>
					<article class="panel card" data-reveal>
						<svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true"
							><rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M8 20h8M12 16v4"></path></svg
						>
						<h3>Формат</h3>
						<p>Занятия проводятся онлайн. Предпочтительные часовые пояса&nbsp;— Сибирь и Дальний Восток России (МСК+2&nbsp;— МСК+9).</p>
					</article>
				</div>
				<p class="signup" data-reveal>
					<a class="btn btn--primary" href="#kontakty" data-signup>Записаться на занятия</a>
				</p>
			</section>

			<section id="uchebnik" class="section">
				<div class="panel book" data-reveal>
					<div class="book__text">
						<h2>Учебник</h2>
						<p>
							Физика с 7 по 11 класс: теория, модели, с которыми можно экспериментировать прямо на
							странице, определения и выводы формул, биографии учёных и интересные факты.
						</p>
						<a class="btn btn--primary" href={textbook}>Перейти к учебнику</a>
					</div>
					<svg class="book__demo" viewBox="0 0 320 200" aria-hidden="true">
						<line class="demo__ground" x1="8" y1="180" x2="312" y2="180"></line>
						<path class="demo__path" d="M20 180 Q160 -100 300 180"></path>
						<g class="demo__x"><circle class="demo__ball" cx="20" cy="180" r="7"></circle></g>
					</svg>
				</div>
			</section>

			<section id="novoe" class="section">
				<div class="panel novoe-panel" data-reveal>
					<h2>Новое в учебнике</h2>
					<NovoeList tone="home" n={3} />
				</div>
			</section>

			<section id="kontakty" class="section">
				<div class="panel contacts" data-reveal>
					<h2>Контакты</h2>
					<div class="contacts__list">
						<a class="contact" href="https://t.me/lafrira" target="_blank" rel="noopener"><span>Telegram</span><span>@lafrira</span></a>
						<a class="contact" href="mailto:gorbunova.irina.serg@gmail.com"><span>Почта</span><span>gorbunova.irina.serg@gmail.com</span></a>
					</div>
					<!-- feedback: the message goes to Irina's e-mail through FormSubmit (formsubmit.co); nothing is shown on the site -->
					<form class="feedback" data-feedback action="https://formsubmit.co/ajax/gorbunova.irina.serg@gmail.com" method="post">
						<textarea name="message" rows="4" maxlength="4000" required aria-label="Сообщение" placeholder="Запись на занятие, комментарий, отзыв или замеченная ошибка…"></textarea>
						<input class="feedback__trap" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
						<div class="feedback__row">
							<p class="feedback__status" data-status role="status" aria-live="polite"></p>
							<button class="btn btn--primary" type="submit" data-send>Отправить</button>
						</div>
					</form>
				</div>
			</section>
		</main>

		<footer class="footer">
			<span>© 2026. Все права защищены.</span>
			<a href={textbook}>Учебник физики</a>
		</footer>

		<script>
			// «Обо мне»: a binary star of two equal masses (both circle their common centre of mass) drifts along the
			// route Россия → Италия → Китай and stays in the last stop. Each star leaves a trail: while the pair drifts,
			// the trails curl into loops, as the path of a real binary star does (Bessel found Sirius B from it, 1844).
			// Between phones and wide screens the corner is narrow: there the pair just circles in the last stop, without
			// the route, the names and the trails. Hover, tap or keyboard focus opens the caption («Двойная звезда»);
			// opening it replays the route once the story is over and sends `ig:binary` (counted by SiteStats.astro).
			const binary = document.querySelector<HTMLElement>('[data-binary]');
			if (binary) {
				const $ = <T extends Element>(q: string) => binary.querySelector<T>(q)!;
				const sky = $<SVGSVGElement>('.binary__sky');
				const btn = $<HTMLButtonElement>('.binary__btn');
				const starA = $<SVGCircleElement>('.binary__star--a');
				const starB = $<SVGCircleElement>('.binary__star--b');
				const trailA = $<SVGPathElement>('.binary__trail--a');
				const trailB = $<SVGPathElement>('.binary__trail--b');
				type P = [number, number];
				// the route: two quadratic arcs, sampled by length so the pair moves evenly along them
				const arc = (a: P, c: P, b: P) => {
					const pts: P[] = [];
					for (let i = 0; i <= 200; i++) {
						const u = i / 200;
						const v = 1 - u;
						pts.push([v * v * a[0] + 2 * v * u * c[0] + u * u * b[0], v * v * a[1] + 2 * v * u * c[1] + u * u * b[1]]);
					}
					const len = [0];
					for (let i = 1; i < pts.length; i++) len.push(len[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
					return (f: number): P => {
						const target = f * len[len.length - 1];
						let i = 1;
						while (i < len.length - 1 && len[i] < target) i++;
						const k = (target - len[i - 1]) / (len[i] - len[i - 1] || 1);
						return [pts[i - 1][0] + k * (pts[i][0] - pts[i - 1][0]), pts[i - 1][1] + k * (pts[i][1] - pts[i - 1][1])];
					};
				};
				const RUSSIA: P = [114, 22];
				const ITALY: P = [32, 84];
				const CHINA: P = [374, 92];
				const leg1 = arc(RUSSIA, [46, 22], ITALY);
				const leg2 = arc(ITALY, [200, -6], CHINA);
				// seconds: stay, fly, stay, fly, then stay for good
				const T = [1.2, 3.5, 2.5, 9];
				const END = T[0] + T[1] + T[2] + T[3];
				const PERIOD = 1.1; // one turn of the pair, s
				const R = 10; // each star's distance from the centre of mass
				const ease = (u: number) => (1 - Math.cos(Math.PI * u)) / 2;
				const centre = (t: number): P => {
					if (t < T[0]) return RUSSIA;
					if ((t -= T[0]) < T[1]) return leg1(ease(t / T[1]));
					if ((t -= T[1]) < T[2]) return ITALY;
					if ((t -= T[2]) < T[3]) return leg2(ease(t / T[3]));
					return CHINA;
				};
				let a = '';
				let b = '';
				const step = (t: number) => {
					const [x, y] = centre(t);
					const phi = (2 * Math.PI * t) / PERIOD;
					const dx = R * Math.cos(phi);
					const dy = R * Math.sin(phi);
					const ax = (x + dx).toFixed(1), ay = (y + dy).toFixed(1);
					const bx = (x - dx).toFixed(1), by = (y - dy).toFixed(1);
					starA.setAttribute('cx', ax);
					starA.setAttribute('cy', ay);
					starB.setAttribute('cx', bx);
					starB.setAttribute('cy', by);
					// the trails stop growing one turn after the last stop: from then on they would only redraw a circle
					if (t <= END + PERIOD) {
						a += `${a ? 'L' : 'M'}${ax} ${ay}`;
						b += `${b ? 'L' : 'M'}${bx} ${by}`;
						trailA.setAttribute('d', a);
						trailB.setAttribute('d', b);
					}
				};
				const narrow = matchMedia('(max-width: 60rem)');
				const layout = () => {
					binary.classList.toggle('binary--compact', narrow.matches);
					sky.setAttribute('viewBox', narrow.matches ? '344 62 60 60' : '0 0 420 130');
				};
				narrow.addEventListener('change', layout);
				layout();

				let visible = false;
				let started = -1;
				let shift = 0; // time spent off screen, not counted
				let hiddenAt = 0;
				const elapsed = () => (performance.now() - started - shift) / 1000;
				const frame = () => {
					if (!visible) return;
					step(narrow.matches ? END + PERIOD + elapsed() : elapsed());
					requestAnimationFrame(frame);
				};
				const restart = () => {
					a = b = '';
					started = performance.now();
					shift = 0;
				};
				new IntersectionObserver(([e]) => {
					if (e.isIntersecting === visible) return;
					visible = e.isIntersecting;
					if (visible) {
						if (started < 0) restart();
						else shift += performance.now() - hiddenAt;
						requestAnimationFrame(frame);
					} else hiddenAt = performance.now();
				}).observe(binary);

				// the caption: hover, tap, keyboard
				let hover = false;
				let focus = false;
				let pinned = false;
				let open = false;
				const update = () => {
					const now = hover || focus || pinned;
					if (now === open) return;
					open = now;
					if (open) {
						if (elapsed() > END + PERIOD) restart();
						document.dispatchEvent(new CustomEvent('ig:binary'));
					}
					binary.classList.toggle('is-open', open);
					btn.setAttribute('aria-expanded', String(open));
				};
				const close = () => {
					hover = focus = pinned = false;
					update();
				};
				binary.addEventListener('pointerenter', (e) => {
					if (e.pointerType === 'mouse') {
						hover = true;
						update();
					}
				});
				binary.addEventListener('pointerleave', (e) => {
					if (e.pointerType === 'mouse') {
						hover = false;
						update();
					}
				});
				btn.addEventListener('click', () => {
					// the first click (or tap) keeps the caption open, the next one closes it
					if (pinned) hover = focus = pinned = false;
					else pinned = true;
					update();
				});
				btn.addEventListener('focus', () => {
					if (btn.matches(':focus-visible')) {
						focus = true;
						update();
					}
				});
				btn.addEventListener('blur', () => {
					focus = pinned = false;
					update();
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && open) close();
				});
				document.addEventListener('pointerdown', (e) => {
					if (open && !binary.contains(e.target as Node)) close();
				});
			}

			// Once the page is scrolled, the bar gets its own background, so the text below does not show through it.
			const nav = document.querySelector<HTMLElement>('.nav')!;
			const solid = () => nav.toggleAttribute('data-solid', scrollY > 8);
			addEventListener('scroll', solid, { passive: true });
			solid();

			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ rootMargin: '0px 0px -10% 0px' },
			);
			items.forEach((el) => io.observe(el));

			// feedback form (FormSubmit's AJAX endpoint answers JSON with success "true" / "false")
			for (const form of document.querySelectorAll<HTMLFormElement>('[data-feedback]')) {
				const text = form.querySelector('textarea')!;
				const status = form.querySelector<HTMLElement>('[data-status]')!;
				const send = form.querySelector<HTMLButtonElement>('[data-send]')!;
				const say = (msg: string, kind = '') => {
					status.textContent = msg;
					status.dataset.kind = kind;
				};
				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					const message = text.value.trim();
					if (!message) return;
					send.disabled = true;
					say('Отправляю…');
					try {
						const res = await fetch(form.action, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
							body: JSON.stringify({
								message,
								_honey: (form.elements.namedItem('_honey') as HTMLInputElement).value,
								_subject: 'Сообщение с сайта «Физика, которая нравится»',
								_template: 'box',
								_captcha: 'false',
							}),
						});
						const data = (await res.json().catch(() => ({}))) as { success?: string | boolean };
						if (!res.ok || String(data.success) !== 'true') throw new Error('not sent');
						text.value = '';
						say('Спасибо! Сообщение отправлено.', 'ok');
						document.dispatchEvent(new CustomEvent('ig:feedback'));
