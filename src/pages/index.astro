---
import '@fontsource/alice';
import '@fontsource/great-vibes';
import StarrySky from '../components/StarrySky.astro';
import SiteStats from '../components/SiteStats.astro';
import HeroMoon from '../components/moon/HeroMoon.astro';
import NovoeList from '../components/NovoeList.astro';
import { MOTION_SCRIPT } from '../plugins/motion.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const textbook = `${base}uchebnik/`;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Физика, которая нравится</title>
		<meta
			name="description"
			content="Учитель физики и репетитор: занятия по физике для 7–11 классов и учебник с интерактивными моделями."
		/>
		<meta name="theme-color" content="#070b22" />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<script is:inline set:html={MOTION_SCRIPT} />
		<script is:inline data-goatcounter="https://irenegorbunova.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<StarrySky />
		<SiteStats />

		<header class="nav">
			<a class="nav__brand" href="#top">
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><path d="M12 1.5l2.2 8.3 8.3 2.2-8.3 2.2L12 22.5l-2.2-8.3L1.5 12l8.3-2.2z"></path></svg
				>
				<span>Физика</span>
			</a>
			<nav class="nav__links" aria-label="Разделы">
				<a href="#obo-mne">Обо мне</a>
				<a href="#zanyatiya">Занятия</a>
				<a href="#kontakty">Контакты</a>
				<a class="nav__cta" href={textbook}>Учебник</a>
			</nav>
		</header>

		<main id="top">
			<section class="hero">
				<h1 class="hero__name">Физика,<br />которая нравится</h1>
				<p class="hero__lead">Интерактивный учебник Ирины Горбуновой, который помогает понять и полюбить физику</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href={textbook}>Открыть учебник</a>
				</div>
				<a class="hero__scroll" href="#obo-mne" aria-label="Листать вниз">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
				</a>
				<HeroMoon />
			</section>

			<section id="obo-mne" class="section">
				<div class="panel about" data-reveal>
					<div class="about__photo" aria-label="Место для фотографии">
						<svg viewBox="0 0 24 24" aria-hidden="true"
							><circle cx="12" cy="8.5" r="4"></circle><path d="M4 21c1.5-4.5 4.5-6.5 8-6.5s6.5 2 8 6.5"
							></path></svg
						>
						<span>Фото</span>
					</div>
					<div class="about__text">
						<h2>Обо мне</h2>
						<p class="ph">Образование: вуз, специальность</p>
						<p class="ph">Опыт: сколько лет преподаёте, в какой школе работаете</p>
						<p class="ph">Подход: как проходят занятия и чего добиваются ученики</p>
						<ul class="facts">
							<li><strong class="ph">N</strong><span>лет преподаю</span></li>
							<li><strong class="ph">N</strong><span>учеников</span></li>
							<li><strong>7–11</strong><span>классы</span></li>
						</ul>
					</div>
				</div>
			</section>

			<section id="zanyatiya" class="section">
				<h2 class="section__title" data-reveal>Занятия</h2>
				<div class="cards">
					<article class="panel card" data-reveal>
						<svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true"
							><path d="M4 5.5A2.5 2.5 0 016.5 3H20v15H6.5A2.5 2.5 0 004 20.5z"></path><path d="M4 20.5A2.5 2.5 0 016.5 18H20v3H6.5A2.5 2.5 0 014 20.5z"
							></path></svg
						>
						<h3>Школьная программа</h3>
						<p>Обсуждаем простым языком физические законы и явления. Помогаю научиться решать задачи и понимать их смысл.</p>
					</article>
					<article class="panel card" data-reveal>
						<svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true"
							><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.5"
							></circle></svg
						>
						<h3>ОГЭ и ЕГЭ</h3>
						<p>Разбираем и решаем задачи из сборников ОГЭ и ЕГЭ. Учимся понимать задачи и законы, которые в них работают.</p>
					</article>
					<article class="panel card" data-reveal>
						<svg class="card__icon" viewBox="0 0 24 24" aria-hidden="true"
							><rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M8 20h8M12 16v4"></path></svg
						>
						<h3>Формат</h3>
						<p>Занятия проводятся онлайн. Предпочтительные часовые пояса&nbsp;— Сибирь и Дальний Восток России (МСК+2&nbsp;— МСК+9).</p>
					</article>
				</div>
			</section>

			<section id="uchebnik" class="section">
				<div class="panel book" data-reveal>
					<div class="book__text">
						<h2>Учебник</h2>
						<p>
							Физика с 7 по 11 класс: теория, модели, с которыми можно экспериментировать прямо на
							странице, определения и выводы формул, биографии учёных и интересные факты.
						</p>
						<a class="btn btn--primary" href={textbook}>Перейти к учебнику</a>
					</div>
					<svg class="book__demo" viewBox="0 0 320 200" aria-hidden="true">
						<line class="demo__ground" x1="8" y1="180" x2="312" y2="180"></line>
						<path class="demo__path" d="M20 180 Q160 -100 300 180"></path>
						<g class="demo__x"><circle class="demo__ball" cx="20" cy="180" r="7"></circle></g>
					</svg>
				</div>
			</section>

			<section id="novoe" class="section">
				<div class="panel novoe-panel" data-reveal>
					<h2>Новое в учебнике</h2>
					<NovoeList tone="home" n={3} />
				</div>
			</section>

			<section id="kontakty" class="section">
				<div class="panel contacts" data-reveal>
					<h2>Контакты</h2>
					<div class="contacts__list">
						<a class="contact" href="https://t.me/lafrira" target="_blank" rel="noopener"><span>Telegram</span><span>@lafrira</span></a>
						<a class="contact" href="mailto:gorbunova.irina.serg@gmail.com"><span>Почта</span><span>gorbunova.irina.serg@gmail.com</span></a>
					</div>
					<!-- feedback: the message goes to Irina's e-mail through FormSubmit (formsubmit.co); nothing is shown on the site -->
					<form class="feedback" data-feedback action="https://formsubmit.co/ajax/gorbunova.irina.serg@gmail.com" method="post">
						<textarea name="message" rows="4" maxlength="4000" required aria-label="Сообщение" placeholder="Комментарий, отзыв или замеченная ошибка…"></textarea>
						<input class="feedback__trap" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
						<div class="feedback__row">
							<p class="feedback__status" data-status role="status" aria-live="polite"></p>
							<button class="btn btn--primary" type="submit" data-send>Отправить</button>
						</div>
					</form>
				</div>
			</section>
		</main>

		<footer class="footer">
			<span>© 2026. Все права защищены.</span>
			<a href={textbook}>Учебник физики</a>
		</footer>

		<script>
			// Once the page is scrolled, the bar gets its own background, so the text below does not show through it.
			const nav = document.querySelector<HTMLElement>('.nav')!;
			const solid = () => nav.toggleAttribute('data-solid', scrollY > 8);
			addEventListener('scroll', solid, { passive: true });
			solid();

			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-visible');
							io.unobserve(e.target);
						}
					}
				},
				{ rootMargin: '0px 0px -10% 0px' },
			);
			items.forEach((el) => io.observe(el));

			// feedback form (FormSubmit's AJAX endpoint answers JSON with success "true" / "false")
			for (const form of document.querySelectorAll<HTMLFormElement>('[data-feedback]')) {
				const text = form.querySelector('textarea')!;
				const status = form.querySelector<HTMLElement>('[data-status]')!;
				const send = form.querySelector<HTMLButtonElement>('[data-send]')!;
				const say = (msg: string, kind = '') => {
					status.textContent = msg;
					status.dataset.kind = kind;
				};
				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					const message = text.value.trim();
					if (!message) return;
					send.disabled = true;
					say('Отправляю…');
					try {
						const res = await fetch(form.action, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
							body: JSON.stringify({
								message,
								_honey: (form.elements.namedItem('_honey') as HTMLInputElement).value,
								_subject: 'Сообщение с сайта «Физика, которая нравится»',
								_template: 'box',
								_captcha: 'false',
							}),
						});
						const data = (await res.json().catch(() => ({}))) as { success?: string | boolean };
						if (!res.ok || String(data.success) !== 'true') throw new Error('not sent');
						text.value = '';
						say('Спасибо! Сообщение отправлено.', 'ok');
						document.dispatchEvent(new CustomEvent('ig:feedback'));
					} catch {
						say('Не получилось отправить. Попробуйте ещё раз или напишите на почту.', 'err');
					} finally {
						send.disabled = false;
					}
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #070b22;
		--text: #e9ecff;
		--muted: #a8afd6;
		--faint: #747cab;
		--gold: #f3c969;
		--gold-hi: #ffdf9c;
		--line: rgb(255 255 255 / 0.12);
		--glass: rgb(13 18 50 / 0.55);
		--font: 'Alice', Georgia, serif;
		--font-display: 'Great Vibes', cursive;
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
		font-size: 1.1rem;
		line-height: 1.65;
		font-synthesis-weight: none;
		-webkit-font-smoothing: antialiased;
	}
	a {
		color: inherit;
	}
	h1,
	h2,
	h3 {
		margin: 0;
		line-height: 1.15;
	}
	h2 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.8rem, 7vw, 4rem);
	}

	/* Placeholder text: easy to spot and to replace. */
	.ph {
		color: var(--faint);
		font-style: italic;
	}
	.ph::before {
		content: '[';
	}
	.ph::after {
		content: ']';
	}

	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem clamp(1rem, 4vw, 2.5rem);
		background: linear-gradient(180deg, rgb(5 8 25 / 0.75), rgb(5 8 25 / 0));
	}
	/* The background the bar gets once the page is scrolled (see the script). */
	.nav::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgb(7 11 34 / 0.86);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
		box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
		opacity: 0;
		transition: opacity 0.25s;
	}
	.nav[data-solid]::before {
		opacity: 1;
	}
	.nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
	.nav__brand span {
		font-family: var(--font-display);
		font-size: 1.9rem;
		line-height: 1;
		letter-spacing: 0;
	}
	.nav__brand svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: var(--gold);
		filter: drop-shadow(0 0 6px rgb(243 201 105 / 0.7));
	}
	.nav__links {
		display: flex;
		align-items: center;
		gap: clamp(0.4rem, 1.2vw, 0.75rem);
	}
	.nav__links a {
		color: var(--text);
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.5rem;
		line-height: 1.2;
		padding: 0.15rem 1rem;
		border: 1px solid rgb(243 201 105 / 0.6);
		border-radius: 999px;
		white-space: nowrap;
		transition:
			background-color 0.2s,
			border-color 0.2s;
	}
	.nav__links a:hover {
		border-color: var(--gold);
		background: rgb(243 201 105 / 0.12);
	}

	.hero {
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 6rem 1rem 4rem;
		position: relative;
		overflow-x: clip; /* the Moon's glow (moon/HeroMoon.astro) never widens the page */
	}
	.hero > * {
		animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	.hero__eyebrow {
		margin: 0 0 1rem;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--gold);
		animation-delay: 0.1s;
	}
	.hero__name {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(4rem, 14vw, 8.5rem);
		text-shadow: 0 0 40px rgb(140 160 255 / 0.35);
		animation-delay: 0.25s;
	}
	.hero__lead {
		max-width: 34rem;
		margin: 1.25rem 0 2.25rem;
		font-size: clamp(1.05rem, 2.4vw, 1.3rem);
		animation-delay: 0.45s;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		animation-delay: 0.6s;
	}
	.hero__scroll {
		position: absolute;
		bottom: 1.5rem;
		width: 2.5rem;
		height: 2.5rem;
		display: grid;
		place-items: center;
		color: var(--muted);
		animation:
			rise 1s 0.9s both,
			bob 2.4s 2s ease-in-out infinite;
	}
	.hero__scroll svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.8rem 1.6rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.98rem;
		text-decoration: none;
		transition:
			transform 0.2s,
			box-shadow 0.2s,
			background 0.2s;
	}
	.btn--primary {
		background: linear-gradient(180deg, var(--gold-hi), var(--gold));
		color: #1a1405;
		box-shadow: 0 0 24px rgb(243 201 105 / 0.35);
	}
	.btn--primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 0 36px rgb(243 201 105 / 0.55);
	}
	.btn--ghost {
		border: 1px solid var(--line);
		background: rgb(255 255 255 / 0.04);
		backdrop-filter: blur(6px);
	}
	.btn--ghost:hover {
		background: rgb(255 255 255 / 0.1);
	}

	.section {
		width: min(68rem, 100% - 2rem);
		margin: 0 auto;
		padding: clamp(3rem, 8vw, 6rem) 0;
		scroll-margin-top: 3rem;
	}
	.section__title {
		text-align: center;
		margin-bottom: 2rem;
	}
	.panel {
		background: var(--glass);
		border: 1px solid var(--line);
		border-radius: 1.5rem;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.35);
	}

	.about {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: clamp(1.5rem, 5vw, 3.5rem);
		align-items: center;
		padding: clamp(1.5rem, 5vw, 3rem);
	}
	.about__photo {
		width: clamp(9rem, 22vw, 14rem);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 2px dashed rgb(243 201 105 / 0.45);
		display: grid;
		place-items: center;
		align-content: center;
		gap: 0.25rem;
		color: var(--faint);
		background: radial-gradient(circle at 35% 30%, rgb(120 130 220 / 0.25), transparent 70%);
	}
	.about__photo svg {
		width: 40%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.about__photo span {
		font-size: 0.85rem;
	}
	.about__text h2 {
		margin-bottom: 0.75rem;
	}
	.about__text p {
		margin: 0.4rem 0;
	}
	.facts {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
	}
	.facts li {
		display: flex;
		flex-direction: column;
	}
	.facts strong {
		font-family: var(--font);
		font-variant-numeric: lining-nums;
		font-size: 2.2rem;
		font-weight: 600;
		line-height: 1;
		color: var(--gold-hi);
	}
	.facts strong.ph {
		color: var(--faint);
	}
	.facts span {
		font-size: 0.85rem;
		color: var(--muted);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.card {
		padding: 1.75rem 1.5rem;
		transition:
			transform 0.3s,
			border-color 0.3s;
	}
	.card:hover {
		transform: translateY(-4px);
		border-color: rgb(243 201 105 / 0.4);
	}
	.card__icon {
		width: 2.25rem;
		height: 2.25rem;
		fill: none;
		stroke: var(--gold);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		margin-bottom: 1rem;
	}
	.card h3 {
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}
	.card p {
		margin: 0;
	}

	.book {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 2rem;
		align-items: center;
		padding: clamp(1.5rem, 5vw, 3rem);
	}
	.book__text h2 {
		margin-bottom: 0.75rem;
	}
	.book__text p {
		color: var(--muted);
		margin: 0 0 1.5rem;
	}
	.book__demo {
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.demo__ground {
		stroke: var(--line);
		stroke-width: 2;
	}
	.demo__path {
		fill: none;
		stroke: rgb(168 175 214 / 0.45);
		stroke-width: 1.5;
		stroke-dasharray: 5 6;
	}
	.demo__ball {
		fill: var(--gold);
		filter: drop-shadow(0 0 8px var(--gold));
	}
	/* Exact projectile motion: x linear in time, y = 2τ − τ² up and τ² down. */
	.demo__x {
		animation: demo-x 3s linear infinite;
	}
	.demo__ball {
		animation:
			demo-y 3s infinite,
			demo-fade 3s infinite;
	}
	@keyframes demo-x {
		0% {
			transform: translateX(0);
		}
		80%,
		100% {
			transform: translateX(280px);
		}
	}
	@keyframes demo-y {
		0% {
			transform: translateY(0);
			animation-timing-function: cubic-bezier(0.3333, 0.6667, 0.6667, 1);
		}
		40% {
			transform: translateY(-140px);
			animation-timing-function: cubic-bezier(0.3333, 0, 0.6667, 0.3333);
		}
		80%,
		100% {
			transform: translateY(0);
		}
	}
	@keyframes demo-fade {
		0% {
			opacity: 0;
		}
		4%,
		84% {
			opacity: 1;
		}
		96%,
		100% {
			opacity: 0;
