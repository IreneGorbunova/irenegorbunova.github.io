---
// «Полный экран»: a button above every model of a chapter opens the model on the whole screen, laid out to use the
// screen (./fs.ts, ./view.ts). On a page that is not a chapter nothing is rendered.
import Loader from './Loader.astro';

const id = Astro.locals.starlightRoute?.entry?.id ?? '';
const isChapter = /^uchebnik\/\d+-klass\/[^/]+\/[^/]+$/.test(id);
---

{isChapter && <Loader />}
