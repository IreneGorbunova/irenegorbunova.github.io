---
/**
 * Counts which models are used: the first time a visitor touches a model (a <figure class="… not-content">)
 * on a page, one GoatCounter event «Модель: <chapter> / <section>» is sent. No personal data; nothing is
 * sent on localhost or from automated browsers (GoatCounter's count.js skips them). Rendered once per chapter page.
 */
---

<script>
	type GC = { count?: (o: { path: string; title?: string; event?: boolean }) => void };
	const content = document.querySelector<HTMLElement>('.sl-markdown-content');
	if (content) {
		const chapter =
			document.querySelector('#starlight__sidebar a[aria-current="page"]')?.textContent?.trim() ||
			document.querySelector('h1')?.textContent?.trim() ||
			location.pathname;
		const figures = [...content.querySelectorAll<HTMLElement>('figure.not-content')].filter(
			(f) => !f.parentElement?.closest('figure.not-content'),
		);
		const heads = [...content.querySelectorAll<HTMLElement>('h2, h3')];
		const headOf = (f: Element) =>
			heads.filter((h) => h.compareDocumentPosition(f) & Node.DOCUMENT_POSITION_FOLLOWING).pop();
		// a name for every model: the heading above it, numbered when one heading has several models
		const names = new Map<Element, string>();
		const byHead = new Map<Element | undefined, HTMLElement[]>();
		for (const f of figures) {
			const h = headOf(f);
			byHead.set(h, [...(byHead.get(h) ?? []), f]);
		}
		for (const [h, fs] of byHead) {
			const title = h?.textContent?.trim() || 'вступление';
			fs.forEach((f, i) => names.set(f, fs.length > 1 ? `${title} (${i + 1})` : title));
		}

		const sent = new Set<Element>();
		const send = (f: Element, tries = 0) => {
			const gc = (window as unknown as { goatcounter?: GC }).goatcounter;
			if (!gc?.count) {
				// count.js loads asynchronously; wait for it a little
				if (tries < 10) setTimeout(() => send(f, tries + 1), 1000);
				return;
			}
			const name = `${chapter} / ${names.get(f) ?? 'модель'}`;
			gc.count({ path: `Модель: ${name}`, title: name, event: true });
		};
		const touch = (e: Event) => {
			const f = (e.target as Element | null)?.closest?.('figure.not-content');
			const top = f && figures.find((x) => x === f || x.contains(f));
			if (!top || sent.has(top)) return;
			sent.add(top);
			send(top);
		};
		content.addEventListener('pointerdown', touch);
		content.addEventListener('input', touch);
		content.addEventListener('keydown', (e) => {
			if (['Enter', ' '].includes(e.key) || e.key.startsWith('Arrow')) touch(e);
		});
	}
</script>
