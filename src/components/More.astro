---
/**
 * An inline «more» word: the term is underlined with dots, a tap opens a small window with the
 * children (a short definition, a fact, an example). Use it inside a sentence, on one line:
 *   частицы <More term="непрерывно движутся">Об этом говорят **диффузия** — …</More>.
 * Children are inline markdown (bold, math, <br/>). The body sits in a <template> (allowed inside
 * a paragraph) and is shown in one shared popover; without popover support it opens inline.
 * The script lives in MoreSetup.astro, rendered once per chapter page from PageTitle.astro: a script
 * inside an inline component is repeated after every use.
 */
interface Props {
	term: string;
}
const { term } = Astro.props;
---

<span class="ig-more" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" data-more>{term}</span><template data-more-body><slot /></template>

<style is:global>
	/* a span, not a <button>: a button does not break across lines */
	.ig-more {
		color: var(--sl-color-text-accent);
		text-decoration: underline dotted;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.22em;
		cursor: pointer;
	}
	.ig-more:hover,
	.ig-more[aria-expanded='true'] {
		text-decoration-style: solid;
	}
	.ig-more:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
		border-radius: 3px;
	}
	.ig-pop {
		position: fixed;
		inset: auto;
		margin: 0;
		width: min(24rem, 100vw - 2rem);
		max-height: min(60vh, 28rem);
		overflow-y: auto;
		padding: 1rem 2.6rem 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		box-shadow: 0 18px 50px rgb(0 0 0 / 0.45);
	}
	.ig-pop:popover-open {
		animation: ig-pop-in 0.2s ease-out;
	}
	.ig-pop__close {
		position: absolute;
		top: 0.45rem;
		right: 0.45rem;
		width: 2rem;
		height: 2rem;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--sl-color-gray-2);
		font-size: 1.35rem;
		line-height: 1;
		cursor: pointer;
	}
	.ig-pop__close:hover {
		color: var(--sl-color-white);
	}
	.ig-pop .katex {
		font-size: 1.05em;
	}
	.ig-more-inline {
		display: block;
		margin: 0.5rem 0;
		padding: 0.6rem 0.9rem;
		border-left: 3px solid var(--sl-color-text-accent);
		background: var(--ig-surface);
		font-size: var(--sl-text-sm);
	}
	@media (max-width: 40rem) {
		.ig-pop {
			left: 0.75rem !important;
			right: 0.75rem;
			top: auto !important;
			bottom: 0.75rem;
			width: auto;
		}
	}
	@keyframes ig-pop-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ig-pop:popover-open {
			animation: none;
		}
	}
</style>
