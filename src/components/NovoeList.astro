---
/**
 * «Новое в учебнике»: tiles of the chapters changed last (data/novoe.ts), each a link with the grade, «новая глава» or
 * «обновлена», and the date. tone="home" on the dark home page, tone="book" (Starlight colours) on «Об учебнике».
 */
import { novoe } from '../data/novoe';

interface Props {
	tone: 'home' | 'book';
	n?: number;
}
const { tone, n = 6 } = Astro.props;
const items = await novoe(n);
---

{
	items.length > 0 && (
		<ul class={`novoe novoe--${tone} not-content`} data-novoe>
			{items.map((i) => (
				<li>
					<a class="novoe__item" href={i.href}>
						<span class="novoe__kind">{i.isNew ? 'Новая глава' : 'Обновлена'}</span>
						<span class="novoe__title">{i.title}</span>
						<span class="novoe__meta">
							{i.grade} · {i.date}
						</span>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.novoe {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.novoe li {
		margin: 0;
	}
	.novoe__item {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		height: 100%;
		box-sizing: border-box;
		padding: 0.85rem 1.1rem;
		border: 1px solid var(--nv-line);
		border-radius: var(--nv-radius);
		background: var(--nv-bg);
		color: var(--nv-text);
		text-decoration: none;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.novoe__item:hover,
	.novoe__item:focus-visible {
		border-color: var(--nv-hover);
		background: var(--nv-bg-hover);
	}
	.novoe__kind {
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--nv-accent);
	}
	.novoe__title {
		font-weight: 700;
		line-height: 1.3;
	}
	.novoe__meta {
		font-size: 0.9rem;
		color: var(--nv-muted);
	}
	.novoe--home {
		--nv-line: var(--line);
		--nv-radius: 1rem;
		--nv-bg: rgb(255 255 255 / 0.03);
		--nv-bg-hover: rgb(255 255 255 / 0.07);
		--nv-hover: rgb(243 201 105 / 0.5);
		--nv-text: var(--text);
		--nv-muted: var(--muted);
		--nv-accent: var(--gold);
		text-align: left;
	}
	.novoe--book {
		--nv-line: var(--sl-color-gray-5);
		--nv-radius: 0.75rem;
		--nv-bg: transparent;
		--nv-bg-hover: var(--sl-color-gray-7, var(--sl-color-gray-6));
		--nv-hover: var(--sl-color-accent);
		--nv-text: var(--sl-color-white);
		--nv-muted: var(--sl-color-gray-3);
		--nv-accent: var(--sl-color-text-accent);
		margin-block: 1rem 0;
	}
</style>
