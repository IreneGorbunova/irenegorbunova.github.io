---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ChapterStar from './sky/ChapterStar.astro';

// Chapter pages are uchebnik/<grade>/<section>/<chapter>; only they get a star.
const isChapter = /^uchebnik\/\d+-klass\/[^/]+\/[^/]+$/.test(Astro.locals.starlightRoute.entry.id);
---

<Default />
{isChapter && <ChapterStar />}
