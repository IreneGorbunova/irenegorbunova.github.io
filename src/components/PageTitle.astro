---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ChapterStar from './sky/ChapterStar.astro';
import MoreSetup from './MoreSetup.astro';
import ModelStats from './ModelStats.astro';
import Constellation from './sky/Constellation.astro';
import { skySections } from './sky/sections';

// Chapter pages are uchebnik/<grade>/<section>/<chapter>; only they get a star.
const isChapter = /^uchebnik\/\d+-klass\/[^/]+\/[^/]+$/.test(Astro.locals.starlightRoute.entry.id);
const id = Astro.locals.starlightRoute.entry.id;
const sec = isChapter ? skySections(Astro.locals.starlightRoute).find((s) => s.chapters.some((c) => c.id === id)) : undefined;
---

<Default />
{isChapter && (sec ? <ChapterStar><Constellation sec={sec} size="mini" current={id} /></ChapterStar> : <ChapterStar />)}
{isChapter && <MoreSetup glossary={Astro.locals.starlightRoute.entry.data.glossary} />}
<ModelStats />
