---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ChapterSky from './sky/ChapterSky.astro';
import MoreSetup from './MoreSetup.astro';
import SiteStats from './SiteStats.astro';
import Constellation from './sky/Constellation.astro';
import { skySections } from './sky/sections';

// Chapter pages are uchebnik/<grade>/<section>/<chapter>; they get their section's constellation under the title.
const id = Astro.locals.starlightRoute.entry.id;
const isChapter = /^uchebnik\/\d+-klass\/[^/]+\/[^/]+$/.test(id);
const sec = isChapter ? skySections(Astro.locals.starlightRoute).find((s) => s.chapters.some((c) => c.id === id)) : undefined;
---

<Default />
{isChapter && <ChapterSky>{sec && <Constellation sec={sec} size="mini" current={id} />}</ChapterSky>}
{isChapter && <MoreSetup glossary={Astro.locals.starlightRoute.entry.data.glossary} />}
<SiteStats />
