---
/**
 * Step-by-step derivation: steps appear one at a time, formulas are "written in".
 * Without JavaScript every step is visible.
 */
interface Props {
	title?: string;
}
const { title = 'Вывод' } = Astro.props;
---

<section class="derivation" data-derivation>
	<p class="derivation__title">{title}</p>
	<ol class="derivation__steps">
		<slot />
	</ol>
	<div class="derivation__controls" hidden>
		<button type="button" class="derivation__btn derivation__btn--primary" data-next>
			Следующий шаг
			<span class="derivation__counter" data-counter></span>
		</button>
		<button type="button" class="derivation__btn" data-all>Показать всё</button>
		<button type="button" class="derivation__btn" data-reset hidden>Сначала</button>
	</div>
</section>

<style is:global>
	.derivation {
		margin-block: 2rem;
		padding: 1.25rem 1.25rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.derivation__title {
		margin: 0 0 0.75rem;
		font-family: var(--ig-font-display);
		font-size: var(--sl-text-4xl);
		font-weight: 400;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.derivation__steps {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: dstep;
	}
	.derivation .step {
		position: relative;
		counter-increment: dstep;
		padding: 0.5rem 0 0.5rem 2.75rem;
		border-top: 1px dashed var(--sl-color-gray-5);
		line-height: var(--sl-line-height);
		color: var(--sl-color-text);
	}
	.derivation .step:first-child {
		border-top: 0;
	}
	.derivation .step::before {
		content: counter(dstep);
		position: absolute;
		left: 0;
		top: 0.7rem;
		width: 1.9rem;
		height: 1.9rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		font-weight: 700;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-black);
		background: var(--sl-color-accent);
	}
	.derivation .step > :first-child {
		margin-top: 0.2rem;
	}
	.derivation .step p {
		margin: 0.4rem 0;
	}
	.derivation .step strong {
		color: var(--sl-color-white);
	}
	.derivation__controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.derivation__controls[hidden],
	.derivation__btn[hidden] {
		display: none;
	}
	.derivation__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.derivation__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.derivation__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.derivation__btn--primary:hover {
		filter: brightness(1.08);
	}
	.derivation__counter {
		opacity: 0.7;
		margin-left: 0.35rem;
		font-variant-numeric: tabular-nums;
	}

	/* Hidden steps exist only when the script is running. */
	.derivation.is-interactive .step:not(.is-shown) {
		display: none;
	}
	.derivation.is-interactive .step.is-entering {
		animation: dstep-in 0.5s ease-out both;
	}
	.derivation.is-interactive .step.is-entering .katex-display > .katex {
		animation: dstep-write 1.1s cubic-bezier(0.45, 0.05, 0.35, 1) 0.15s both;
	}
	@keyframes dstep-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}
	}
	@keyframes dstep-write {
		from {
			clip-path: inset(-0.5em 100% -0.5em 0);
		}
		to {
			clip-path: inset(-0.5em -0.5em -0.5em 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.derivation.is-interactive .step.is-entering,
		.derivation.is-interactive .step.is-entering .katex-display > .katex {
			animation: none;
		}
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	for (const root of document.querySelectorAll<HTMLElement>('[data-derivation]')) {
		const steps = Array.from(root.querySelectorAll<HTMLElement>('.step'));
		const controls = root.querySelector<HTMLElement>('.derivation__controls')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const all = root.querySelector<HTMLButtonElement>('[data-all]')!;
		const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
		const counter = root.querySelector<HTMLElement>('[data-counter]')!;
		if (steps.length < 2) continue;

		let shown = 0;
		const update = () => {
			const done = shown >= steps.length;
			next.hidden = done;
			all.hidden = done;
			reset.hidden = !done;
			counter.textContent = `${shown + 1} из ${steps.length}`;
			// the chapter counts its «вывод» step (sky/ChapterSky.astro) and its stars light
			if (done) {
				const title = root.querySelector('.derivation__title')?.textContent?.trim();
				document.dispatchEvent(new CustomEvent('ig:derivation-done', { detail: { title } }));
			}
		};
		const show = (step: HTMLElement, animate: boolean) => {
			step.classList.add('is-shown');
			if (animate) {
				step.classList.add('is-entering');
				step.addEventListener('animationend', () => step.classList.remove('is-entering'), {
					once: true,
				});
			}
		};

		root.classList.add('is-interactive');
		controls.hidden = false;
		show(steps[0], false);
		shown = 1;
		update();

		next.addEventListener('click', () => {
			const step = steps[shown];
			show(step, true);
			shown += 1;
			update();
			step.scrollIntoView({
				block: 'nearest',
				behavior: reduceMotion.matches ? 'auto' : 'smooth',
			});
		});
		all.addEventListener('click', () => {
			while (shown < steps.length) show(steps[shown++], true);
			update();
		});
		reset.addEventListener('click', () => {
			steps.forEach((s, i) => i > 0 && s.classList.remove('is-shown', 'is-entering'));
			shown = 1;
			update();
			root.scrollIntoView({ block: 'start', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
		});
	}
</script>
