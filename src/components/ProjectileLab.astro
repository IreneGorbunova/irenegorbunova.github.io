</style>

<script>
	const G = 9.8;
	const S = 10;
	const OX = 48;
	const OY = 354;
	const K = 2.4; // arrow length, px per (m/s)
	const MAX_TRACES = 4;
	const SVG_NS = 'http://www.w3.org/2000/svg';
	const RHO = 1.2; // air density, kg/m³
	const DT = 0.002; // RK4 step, s
	const EVERY = 4; // every 4th RK4 point (0,008 s) is drawn

	const fmt = (v: number, digits = 1) =>
		v.toLocaleString('ru-RU', { minimumFractionDigits: digits, maximumFractionDigits: digits });
	const px = (x: number) => OX + x * S;
	const py = (y: number) => OY - y * S;

	type Throw = { deg: number; a: number; v0: number; T: number; H: number; L: number };
	type Body = { name: string; short: string; m: number; d: number; C: number; info: string; it: boolean };
	// A throw with air: states (x, y, υx, υy) every DT, the last one is the landing point at time T.
	type AirThrow = Throw & { xH: number; st: Float64Array; n: number; k: number };

	// Quadratic drag: a = −k·υ·υ⃗ − g·ŷ with k = C·ρ·S / (2m).
	const flyAir = (p: Throw, k: number): AirThrow => {
		const f = (s: number[]) => {
			const v = Math.hypot(s[2], s[3]);
			return [s[2], s[3], -k * v * s[2], -G - k * v * s[3]];
		};
		const out: number[] = [];
		let s = [0, 0, p.v0 * Math.cos(p.a), p.v0 * Math.sin(p.a)];
		out.push(...s);
		let H = 0;
		let xH = 0;
		for (let i = 1; i < 100000; i++) {
			const k1 = f(s);
			const k2 = f(s.map((u, j) => u + (DT / 2) * k1[j]));
			const k3 = f(s.map((u, j) => u + (DT / 2) * k2[j]));
			const k4 = f(s.map((u, j) => u + DT * k3[j]));
			const nx = s.map((u, j) => u + (DT / 6) * (k1[j] + 2 * k2[j] + 2 * k3[j] + k4[j]));
			if (s[3] > 0 && nx[3] <= 0) {
				// top of the path: υy is linear over a step, so y gains υy·τ/2 until υy = 0
				const fr = s[3] / (s[3] - nx[3]);
				H = s[1] + (s[3] * fr * DT) / 2;
				xH = s[0] + fr * (nx[0] - s[0]);
			}
			if (nx[1] < 0) {
				const fr = s[1] / (s[1] - nx[1]);
				const land = s.map((u, j) => u + fr * (nx[j] - u));
				land[1] = 0;
				out.push(...land);
				return { ...p, T: (i - 1 + fr) * DT, H, xH, L: land[0], st: Float64Array.from(out), n: i + 1, k };
			}
			s = nx;
			out.push(...s);
		}
		throw new Error('no landing');
	};

	// State at time t (linear between RK4 points; the last interval ends at the landing).
	const stateAt = (q: AirThrow, t: number) => {
		const u = Math.min(t, q.T) / DT;
		const i = Math.min(Math.floor(u), q.n - 2);
		const tb = i + 1 === q.n - 1 ? q.T / DT : i + 1;
		const fr = Math.min(1, (u - i) / (tb - i));
		const at = (j: number) => q.st[4 * i + j] + fr * (q.st[4 * (i + 1) + j] - q.st[4 * i + j]);
		return { i, x: at(0), y: at(1), vx: at(2), vy: at(3) };
	};

	const airPath = (q: AirThrow, t: number) => {
		const e = stateAt(q, t);
		let d = `M ${px(0)} ${py(0)}`;
		for (let i = EVERY; i <= e.i; i += EVERY) d += ` L ${px(q.st[4 * i]).toFixed(1)} ${py(q.st[4 * i + 1]).toFixed(1)}`;
		return `${d} L ${px(e.x).toFixed(1)} ${py(e.y).toFixed(1)}`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-lab]')) {
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const aIn = q<HTMLInputElement>('[data-angle]');
		const vIn = q<HTMLInputElement>('[data-speed]');
		const aOut = q<HTMLOutputElement>('[data-a-out]');
		const vOut = q<HTMLOutputElement>('[data-v-out]');
		const traces = q<SVGGElement>('[data-traces]');
		const preview = q<SVGPathElement>('[data-preview]');
		const trail = q<SVGPathElement>('[data-trail]');
		const hline = q<SVGLineElement>('[data-hline]');
		const hlabel = q<SVGTextElement>('[data-hlabel]');
		const llabel = q<SVGTextElement>('[data-llabel]');
		const arc = q<SVGPathElement>('[data-arc]');
		const alabel = q<SVGTextElement>('[data-alabel]');
		const ball = q<SVGCircleElement>('[data-ball]');
		const vec = {
			v: q<SVGLineElement>('[data-vec-v]'),
			vx: q<SVGLineElement>('[data-vec-vx]'),
			vy: q<SVGLineElement>('[data-vec-vy]'),
		};
		const outT = q<HTMLElement>('[data-T]');
		const outH = q<HTMLElement>('[data-H]');
		const outL = q<HTMLElement>('[data-L]');
		const live = q<HTMLElement>('[data-live]');
		const airIn = q<HTMLInputElement>('[data-air]');
		const bodyGroup = q<HTMLElement>('[data-body-group]');
		const bodyBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-body]')];
		const bodyInfo = q<HTMLElement>('[data-body-info]');
		const ghost = q<SVGPathElement>('[data-ghost]');
		const ghostLabel = q<SVGTextElement>('[data-ghost-label]');
		const alt = [q<HTMLElement>('[data-T0]'), q<HTMLElement>('[data-H0]'), q<HTMLElement>('[data-L0]')];
		const noteNoAir = q<HTMLElement>('[data-note-noair]');
		const noteAir = q<HTMLElement>('[data-note-air]');
		const BODIES: Body[] = JSON.parse(root.dataset.bodies!);

		let raf = 0;
		let body = 0;

		const current = (): Throw => {
			const deg = Number(aIn.value);
			const v0 = Number(vIn.value);
			const a = (deg * Math.PI) / 180;
			return {
				deg,
				a,
				v0,
				T: (2 * v0 * Math.sin(a)) / G,
				H: (v0 * Math.sin(a)) ** 2 / (2 * G),
				L: (v0 * v0 * Math.sin(2 * a)) / G,
			};
		};

		const withAir = (p: Throw) => {
			const b = BODIES[body];
			return flyAir(p, (b.C * RHO * Math.PI * b.d * b.d) / 4 / (2 * b.m));
		};

		// Exact parabola segment from launch to time t as a quadratic Bézier:
		// the control point is r0 + v0 * t / 2.
		const segment = (p: Throw, t: number) => {
			const vx = p.v0 * Math.cos(p.a);
			const vy = p.v0 * Math.sin(p.a);
			const x = vx * t;
			const y = vy * t - (G * t * t) / 2;
			return `M ${px(0)} ${py(0)} Q ${px((vx * t) / 2)} ${py((vy * t) / 2)} ${px(x)} ${py(y)}`;
		};

		const setLine = (el: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
			el.setAttribute('x1', String(x1));
			el.setAttribute('y1', String(y1));
			el.setAttribute('x2', String(x2));
			el.setAttribute('y2', String(y2));
			el.style.visibility = Math.hypot(x2 - x1, y2 - y1) < 4 ? 'hidden' : 'visible';
		};

		const setVectors = (x: number, y: number, vx: number, vy: number) => {
			ball.setAttribute('cx', String(x));
			ball.setAttribute('cy', String(y));
			setLine(vec.vx, x, y, x + vx * K, y);
			setLine(vec.vy, x, y, x, y - vy * K);
			setLine(vec.v, x, y, x + vx * K, y - vy * K);
		};

		const placeBall = (p: Throw, t: number) => {
			const vx = p.v0 * Math.cos(p.a);
			const vy = p.v0 * Math.sin(p.a) - G * t;
			setVectors(px(vx * t), py(p.v0 * Math.sin(p.a) * t - (G * t * t) / 2), vx, vy);
			return { t, x: vx * t, y: p.v0 * Math.sin(p.a) * t - (G * t * t) / 2, v: Math.hypot(vx, vy), vx };
		};

		const placeAir = (r: AirThrow, t: number) => {
			const e = stateAt(r, t);
			setVectors(px(e.x), py(e.y), e.vx, e.vy);
			return { t, x: e.x, y: e.y, v: Math.hypot(e.vx, e.vy), vx: e.vx };
		};

		// p: the throw that flies (with air when it is on); p0: the same throw without air.
		const drawStatic = (p: Throw, xH: number, p0: Throw | null) => {
			preview.setAttribute('d', p0 ? airPath(p as AirThrow, p.T) : segment(p, p.T));
			setLine(hline, px(xH), py(p.H), px(xH), py(0));
			hlabel.setAttribute('x', String(px(xH) + 6));
			hlabel.setAttribute('y', String(py(p.H / 2) + 5));
			hlabel.style.visibility = p.H * S > 18 ? 'visible' : 'hidden';
			const nearEdge = px(p.L) > 650;
			llabel.setAttribute('x', String(px(p.L) + (nearEdge ? -8 : 8)));
			llabel.setAttribute('y', String(py(0) - 8));
			llabel.setAttribute('text-anchor', nearEdge ? 'end' : 'start');
			const r = 40;
			arc.setAttribute(
				'd',
				`M ${OX + r} ${OY} A ${r} ${r} 0 0 0 ${OX + r * Math.cos(p.a)} ${OY - r * Math.sin(p.a)}`,
			);
			alabel.setAttribute('x', String(OX + (r + 10) * Math.cos(p.a / 2)));
			alabel.setAttribute('y', String(OY - (r + 10) * Math.sin(p.a / 2) + 5));
			aOut.value = `${p.deg}°`;
			vOut.value = `${fmt(p.v0, Number.isInteger(p.v0) ? 0 : 1)} м/с`;
			outT.textContent = `${fmt(p.T, 2)} с`;
			outH.textContent = `${fmt(p.H)} м`;
			outL.textContent = `${fmt(p.L)} м`;
			ghost.setAttribute('d', p0 ? segment(p0, p0.T) : '');
			ghostLabel.style.visibility = p0 ? 'visible' : 'hidden';
			if (p0) {
				ghostLabel.setAttribute('x', String(px(p0.L / 2) + 8));
				ghostLabel.setAttribute('y', String(py(p0.H) - 6));
				alt[0].textContent = `без воздуха ${fmt(p0.T, 2)} с`;
				alt[1].textContent = `без воздуха ${fmt(p0.H)} м`;
				alt[2].textContent = `без воздуха ${fmt(p0.L)} м`;
			}
		};

		// With air, throws of different bodies at one angle have close tops: lift a label above the ones it would cover.
		const unclutter = (text: SVGTextElement) => {
			const others = [...traces.querySelectorAll('text')].filter((t) => t !== text);
			for (let k = 0; k < 8; k++) {
				const a = text.getBBox();
				const hit = others.find((t) => {
					const o = t.getBBox();
					return a.x < o.x + o.width && o.x < a.x + a.width && a.y < o.y + o.height && o.y < a.y + a.height;
				});
				if (!hit) return;
				const o = hit.getBBox();
				text.setAttribute('y', String(o.y - 4 - (a.y + a.height - Number(text.getAttribute('y')))));
			}
		};

		const addTrace = (p: Throw, d: string, label: string, xH: number) => {
			const g = document.createElementNS(SVG_NS, 'g');
			g.classList.add('lab__trace');
			const path = document.createElementNS(SVG_NS, 'path');
			path.setAttribute('d', d);
			const text = document.createElementNS(SVG_NS, 'text');
			text.setAttribute('x', String(px(xH) - 8));
			text.setAttribute('y', String(py(p.H) - 6));
			text.setAttribute('text-anchor', 'end');
			text.textContent = label;
			g.append(path, text);
			traces.append(g);
			while (traces.children.length > MAX_TRACES) traces.firstElementChild!.remove();
			return text;
		};

		const setMode = () => {
			const on = airIn.checked;
			root.classList.toggle('is-air', on);
			bodyGroup.hidden = !on;
			alt.forEach((el) => (el.hidden = !on));
			noteNoAir.hidden = on;
			noteAir.hidden = !on;
			bodyBtns.forEach((b, k) => b.setAttribute('aria-checked', String(k === body)));
			bodyInfo.textContent = BODIES[body].info;
		};

		const reset = () => {
			cancelAnimationFrame(raf);
			setMode();
			const p0 = current();
			trail.setAttribute('d', '');
			if (airIn.checked) {
				const r = withAir(p0);
				drawStatic(r, r.xH, p0);
				placeAir(r, 0);
			} else {
				drawStatic(p0, p0.L / 2, null);
				placeBall(p0, 0);
			}
			live.textContent = 'Выберите угол и скорость и нажмите «Бросить».';
		};

		const launch = () => {
			cancelAnimationFrame(raf);
			const p0 = current();
			const r = airIn.checked ? withAir(p0) : null;
			const p = r ?? p0;
			const b = BODIES[body];
			if (r) drawStatic(r, r.xH, p0);
			else drawStatic(p0, p0.L / 2, null);
			const start = performance.now();
			const frame = (now: number) => {
				const t = Math.min((now - start) / 1000, p.T);
				if (r) {
					const s = placeAir(r, t);
					trail.setAttribute('d', airPath(r, t));
					if (t < p.T) {
						const nw = (h: string) => `<span class="lab__nowrap">${h}</span>`;
						live.innerHTML = [
							nw(`<i>t</i> = ${fmt(s.t, 2)} с`),
							nw(`<i>x</i> = ${fmt(s.x)} м`),
							nw(`<i>y</i> = ${fmt(Math.max(s.y, 0))} м`),
							nw(`<i>υ</i> = ${fmt(s.v)} м/с`),
							nw(`<i>υ<sub>x</sub></i> = ${fmt(s.vx)} м/с`),
						].join(' · ');
						raf = requestAnimationFrame(frame);
						return;
					}
				} else {
					const s = placeBall(p0, t);
					trail.setAttribute('d', segment(p0, t));
					if (t < p.T) {
						live.innerHTML = `<i>t</i> = ${fmt(s.t, 2)} с · <i>x</i> = ${fmt(s.x)} м · <i>y</i> = ${fmt(Math.max(s.y, 0))} м · <i>υ</i> = ${fmt(s.v)} м/с`;
						raf = requestAnimationFrame(frame);
						return;
					}
				}
				Object.values(vec).forEach((v) => (v.style.visibility = 'hidden'));
				if (r) {
					unclutter(addTrace(r, airPath(r, r.T), `${b.short} ${r.deg}°`, r.xH));
					const what = b.it ? 'Ядро упало' : 'Мяч упал';
					live.textContent = `${what} через ${fmt(r.T, 2)} с на расстоянии ${fmt(r.L)} м. Без воздуха — ${fmt(p0.L)} м.`;
				} else {
					addTrace(p0, segment(p0, p0.T), `${p0.deg}°`, p0.L / 2);
					live.textContent = `Мяч упал через ${fmt(p0.T, 2)} с на расстоянии ${fmt(p0.L)} м.`;
				}
			};
			raf = requestAnimationFrame(frame);
		};

		aIn.addEventListener('input', reset);
		vIn.addEventListener('input', reset);
		airIn.addEventListener('change', reset);
		bodyBtns.forEach((btn, k) =>
			btn.addEventListener('click', () => {
				body = k;
				reset();
			}),
		);
		q<HTMLButtonElement>('[data-throw]').addEventListener('click', launch);
		q<HTMLButtonElement>('[data-clear]').addEventListener('click', () => traces.replaceChildren());
		reset();
	}
</script>
