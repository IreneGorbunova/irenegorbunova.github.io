---
/**
 * Interactive model: a body thrown at an angle to the horizon (no air resistance).
 * Equal scales on both axes (10 px per metre), so angles on screen are true angles.
 *
 * Optional air resistance (`air` shows the switch and turns it on; without `air` the model is airless, as before): quadratic drag
 * F = ½·C·ρ·S·υ², ρ = 1,2 kg/m³, integrated with RK4 (fixed step 0,002 s). With air on, the airless
 * parabola for the same angle and speed stays as a thin dashed ghost, and the readouts show both.
 * Drag coefficients for these Reynolds numbers (≈ 1–3·10⁵ at 15–25 m/s):
 *   tennis ball 0,55 (wind tunnel 0,55–0,66, free flight ≈ 0,51: Chadwick & Haake 2000; Goodwill, Chin & Haake 2004);
 *   football 0,25 (around and past the drag crisis: ≈ 0,47 below it, 0,15–0,20 well above it; Asai et al. 2007, Asai & Seo 2013);
 *   shot 0,47 (smooth sphere below the drag crisis, Achenbach 1972).
 */
interface Props {
	/** Start with air resistance switched on. */
	air?: boolean;
}
const { air = false } = Astro.props;
const BODIES = [
	{ name: 'футбольный мяч', short: 'футбол', m: 0.43, d: 0.22, C: 0.25, info: '0,43 кг, диаметр 22 см', it: false },
	{ name: 'теннисный мяч', short: 'теннис', m: 0.058, d: 0.067, C: 0.55, info: '0,058 кг, диаметр 6,7 см', it: false },
	{ name: 'ядро для толкания', short: 'ядро', m: 7.26, d: 0.12, C: 0.47, info: '7,26 кг, диаметр 12 см', it: true },
];
const uid = `lab-${Math.random().toString(36).slice(2, 8)}`;
const OX = 48;
const OY = 354;
const S = 10;
const XMAX = 66;
const YMAX = 33;
const xs = [10, 20, 30, 40, 50, 60];
const ys = [10, 20, 30];
---

<figure class="lab not-content" data-lab data-bodies={JSON.stringify(BODIES)}>
	<svg
		class="lab__plot"
		viewBox="0 0 720 384"
		role="img"
		aria-label="Траектория тела, брошенного под углом к горизонту"
	>
		<defs>
			{
				['v', 'vx', 'vy'].map((k) => (
					<marker
						id={`${uid}-${k}`}
						class={`lab__head lab__head--${k}`}
						viewBox="0 0 10 10"
						refX="7"
						refY="5"
						markerWidth="6"
						markerHeight="6"
						orient="auto"
					>
						<path d="M0,0 L10,5 L0,10 z" />
					</marker>
				))
			}
		</defs>

		<g class="lab__grid">
			{xs.map((x) => <line x1={OX + x * S} y1={OY} x2={OX + x * S} y2={OY - YMAX * S} />)}
			{ys.map((y) => <line x1={OX} y1={OY - y * S} x2={OX + XMAX * S} y2={OY - y * S} />)}
		</g>
		<line class="lab__axis" x1={OX} y1={OY} x2={OX + XMAX * S} y2={OY} />
		<line class="lab__axis" x1={OX} y1={OY} x2={OX} y2={OY - YMAX * S} />
		<g class="lab__ticks">
			<text x={OX} y={OY + 20} text-anchor="middle">0</text>
			{xs.map((x) => <text x={OX + x * S} y={OY + 20} text-anchor="middle">{x}</text>)}
			{ys.map((y) => <text x={OX - 8} y={OY - y * S + 5} text-anchor="end">{y}</text>)}
			<text class="lab__axis-name" x={OX + XMAX * S} y={OY - 8} text-anchor="end">x, м</text>
			<text class="lab__axis-name" x={OX + 8} y={OY - YMAX * S + 14}>y, м</text>
		</g>

		<g data-traces></g>
		<path class="lab__ghost" data-ghost></path>
		<text class="lab__ghost-label" data-ghost-label>без воздуха</text>
		<path class="lab__preview" data-preview></path>
		<line class="lab__hline" data-hline></line>
		<text class="lab__mark" data-hlabel>H</text>
		<text class="lab__mark" data-llabel>L</text>
		<path class="lab__arc" data-arc></path>
		<text class="lab__mark" data-alabel>α</text>
		<path class="lab__trail" data-trail></path>
		<line class="lab__vec lab__vec--vx" marker-end={`url(#${uid}-vx)`} data-vec-vx></line>
		<line class="lab__vec lab__vec--vy" marker-end={`url(#${uid}-vy)`} data-vec-vy></line>
		<line class="lab__vec lab__vec--v" marker-end={`url(#${uid}-v)`} data-vec-v></line>
		<circle class="lab__ball" r="7" cx={OX} cy={OY} data-ball></circle>
	</svg>

	<div class="lab__controls">
		<label class="lab__slider">
			<span class="lab__slider-name">Угол броска <i>α</i></span>
			<output data-a-out>45°</output>
			<input type="range" min="5" max="85" step="1" value="45" data-angle />
		</label>
		<label class="lab__slider">
			<span class="lab__slider-name">Начальная скорость <i>υ</i><sub>0</sub></span>
			<output data-v-out>20 м/с</output>
			<input type="range" min="5" max="25" step="0.5" value="20" data-speed />
		</label>
		<div class="lab__air" hidden={!air}>
			<label class="lab__check"><input type="checkbox" checked={air} data-air /> Учесть сопротивление воздуха</label>
			<div class="lab__bodies" role="radiogroup" aria-label="Что бросаем" hidden={!air} data-body-group>
				{
					BODIES.map((b, k) => (
						<button type="button" class="lab__body" role="radio" aria-checked={k === 0 ? 'true' : 'false'} data-body={k}>
							{b.name}
						</button>
					))
				}
				<span class="lab__body-info" data-body-info>{BODIES[0].info}</span>
			</div>
		</div>
		<div class="lab__buttons">
			<button type="button" class="lab__btn lab__btn--primary" data-throw>Бросить</button>
			<button type="button" class="lab__btn" data-clear>Стереть следы</button>
		</div>
	</div>

	<dl class="lab__stats">
		<div><dt>Время полёта</dt><dd data-T>—</dd><dd class="lab__alt" hidden data-T0></dd></div>
		<div><dt>Наибольшая высота <i>H</i></dt><dd data-H>—</dd><dd class="lab__alt" hidden data-H0></dd></div>
		<div><dt>Дальность <i>L</i></dt><dd data-L>—</dd><dd class="lab__alt" hidden data-L0></dd></div>
	</dl>
	<p class="lab__live" data-live aria-live="polite"></p>

	<figcaption class="lab__legend">
		<span class="lab__key lab__key--v"></span><i>υ</i> — скорость
		<span class="lab__key lab__key--vx"></span><i>υ<sub>x</sub></i>
		<span class="lab__key lab__key--vy"></span><i>υ<sub>y</sub></i> — её проекции.
		{' '}<span data-note-noair>Сопротивление воздуха не учитывается,</span><span hidden data-note-air>Тонкий пунктир — тот же бросок без воздуха,</span> <span class="lab__nowrap"><i>g</i> = 9,8 м/с²</span>.
	</figcaption>
</figure>

