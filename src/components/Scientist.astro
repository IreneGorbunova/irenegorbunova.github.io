---
/**
 * A scientist card: portrait, name, years and one line. A click opens a window with
 * the details passed as children (biography, discoveries, facts, legends).
 * The portrait comes from public/portraits/<portrait> (see scripts/fetch_portrait.py).
 */
interface Props {
	name: string;
	years: string;
	portrait: string;
	role: string;
	summary: string;
	/** Alt text when the picture is not a portrait (default «Портрет: <name>»). */
	alt?: string;
}
const { name, years, portrait, role, summary, alt = `Портрет: ${name}` } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = `${base}portraits/${portrait}`;
const id = `sci-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="sci">
	<button type="button" class="sci__card not-content" aria-haspopup="dialog" data-sci-open={id}>
		<img class="sci__portrait" src={src} alt={alt} loading="lazy" width="88" height="88" />
		<span class="sci__text">
			<span class="sci__name">{name}</span>
			<span class="sci__years">{years}</span>
			<span class="sci__summary">{summary}</span>
			<span class="sci__more">Подробнее</span>
		</span>
	</button>
	<dialog id={id} class="sci__dialog ig-dialog" aria-labelledby={`${id}-title`}>
		<button type="button" class="ig-dialog__close not-content" aria-label="Закрыть" data-sci-close>×</button>
		<header class="sci__head not-content">
			<img class="sci__portrait sci__portrait--big" src={src} alt={alt} width="168" height="168" />
			<div>
				<p class="sci__name sci__name--big" id={`${id}-title`}>{name}</p>
				<p class="sci__years">{years}</p>
				<p class="sci__role">{role}</p>
			</div>
		</header>
		<div class="sci__body">
			<slot />
		</div>
	</dialog>
</div>

<style is:global>
	.sci__card {
		display: flex;
		gap: 1rem;
		align-items: center;
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 1rem;
		text-align: start;
		font: inherit;
		color: var(--sl-color-text);
		background: var(--ig-surface);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		cursor: pointer;
		transition:
			transform 0.25s,
			border-color 0.25s,
			box-shadow 0.25s;
	}
	.sci__card:hover,
	.sci__card:focus-visible {
		transform: translateY(-3px);
		border-color: var(--sl-color-accent);
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
	}
	.sci__portrait {
		flex: none;
		width: 88px;
		height: 88px;
		border-radius: 50%;
		object-fit: cover;
		object-position: top;
		border: 3px solid var(--sl-color-accent);
		box-shadow: 0 0 0 4px var(--ig-surface), 0 0 22px color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
		transition: transform 0.35s;
	}
	.sci__card:hover .sci__portrait {
		transform: scale(1.06) rotate(-2deg);
	}
	.sci__portrait--big {
		width: 168px;
		height: 168px;
	}
	.sci__text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.sci__name {
		margin: 0;
		font-family: var(--ig-font-display);
		font-size: 1.9rem;
		line-height: 1.15;
		color: var(--sl-color-white);
	}
	.sci__name--big {
		font-size: 2.8rem;
	}
	.sci__years {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.sci__summary {
		margin-top: 0.3rem;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.sci__more {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.sci__more::after {
		content: ' →';
	}
	.sci__role {
		margin: 0.25rem 0 0;
		font-style: italic;
		color: var(--sl-color-gray-2);
	}

	.sci__head {
		display: flex;
		gap: 1.5rem;
		align-items: center;
		margin-bottom: 1.25rem;
	}
	.sci__head p {
		margin: 0;
	}
	.sci__body .sl-anchor-link {
		display: none;
	}
	.sci__body h4 {
		font-family: var(--ig-font-display);
		font-size: 2rem;
		font-weight: 400;
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.sci__head {
			flex-direction: column;
			text-align: center;
			gap: 0.75rem;
		}
		.sci__portrait--big {
			width: 128px;
			height: 128px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sci__card,
		.sci__portrait {
			transition: none;
		}
	}
</style>

<script>
	for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-sci-open]')) {
		const dialog = document.getElementById(btn.dataset.sciOpen!) as HTMLDialogElement;
		btn.addEventListener('click', () => dialog.showModal());
		dialog.querySelector('[data-sci-close]')!.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
	}
</script>
