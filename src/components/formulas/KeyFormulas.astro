---
/**
 * «Формулы главы»: the chapter's formulas from its frontmatter (`formulas:`) and a button that opens them
 * as flip cards. Renders nothing for a chapter without formulas.
 */
import CardDeck from './CardDeck.astro';
import FormulaList from './FormulaList.astro';
import { cardParts, chapterLabel } from './render';

const { entry } = Astro.locals.starlightRoute;
const items = entry.data.formulas ?? [];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cards = items.map((f) => cardParts(entry.id, chapterLabel(entry), `${base}${entry.id}/`, f));
const title = items.every((f) => f.tex)
	? 'Формулы главы'
	: items.every((f) => !f.tex)
		? 'Главные понятия'
		: 'Формулы и понятия главы';
const deckId = 'deck-chapter';
---

{
	items.length > 0 && (
		<section class="kf not-content" aria-labelledby="kf-title">
			<p class="kf__title" id="kf-title">
				{title}
			</p>
			<FormulaList items={items} />
			<div class="kf__foot">
				<button type="button" class="kf__learn" data-deck-open={deckId}>
					Учить карточки ({items.length})
				</button>
				<a class="kf__all" href={`${base}uchebnik/formuly/`}>
					Все формулы учебника
				</a>
			</div>
			<CardDeck id={deckId} cards={cards} />
		</section>
	)
}

<style is:global>
	.kf {
		margin-block: 2rem;
		padding: 1.1rem 1.25rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.kf__title {
		margin: 0 0 0.35rem;
		font-family: var(--ig-font-display);
		font-size: var(--sl-text-4xl);
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.kf__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-top: 0.9rem;
	}
	.kf__learn {
		margin: 0;
		padding: 0.55rem 1.1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		cursor: pointer;
	}
	.kf__learn:hover {
		filter: brightness(1.08);
	}
	.kf__all {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
</style>
