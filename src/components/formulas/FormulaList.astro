---
/**
 * Rows of formula and concept cards: the formula and its name; a tap opens what each letter means,
 * the units and what to remember. Works without JavaScript (<details>).
 */
import { inline, symbolsHtml, tex, type Formula } from './render';

interface Props {
	items: Formula[];
}
const { items } = Astro.props;
---

<ul class="kf-list">
	{
		items.map((f) => (
			<li>
				<details class="kf-row">
					<summary>
						{f.tex ? (
							<>
								<span class="kf-row__tex" set:html={tex(`\\displaystyle ${f.tex}`)} />
								<span class="kf-row__name" set:html={inline(f.name)} />
							</>
						) : (
							<span class="kf-row__term" set:html={inline(f.name)} />
						)}
					</summary>
					<div class="kf-row__more">
						{f.def && <p set:html={inline(f.def)} />}
						<Fragment set:html={symbolsHtml(f)} />
						{f.note && <p class="kf-row__note" set:html={inline(f.note)} />}
					</div>
				</details>
			</li>
		))
	}
</ul>

<style is:global>
	.kf-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.kf-list > li + li {
		border-top: 1px dashed var(--sl-color-gray-5);
	}
	.kf-row > summary {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.2rem 1rem;
		padding: 0.6rem 2rem 0.6rem 0.25rem;
		position: relative;
		list-style: none;
		cursor: pointer;
	}
	.kf-row > summary::-webkit-details-marker {
		display: none;
	}
	.kf-row > summary::after {
		content: '';
		position: absolute;
		right: 0.5rem;
		top: 50%;
		width: 0.5rem;
		height: 0.5rem;
		border-right: 2px solid var(--sl-color-gray-3);
		border-bottom: 2px solid var(--sl-color-gray-3);
		transform: translateY(-70%) rotate(45deg);
		transition: transform 0.2s;
	}
	.kf-row[open] > summary::after {
		transform: translateY(-30%) rotate(225deg);
	}
	.kf-row > summary:hover::after {
		border-color: var(--sl-color-accent);
	}
	.kf-row__tex {
		max-width: 100%;
		padding: 0.3rem 0.2rem;
		overflow-x: auto;
		overflow-y: hidden;
		color: var(--sl-color-white);
	}
	.kf-row__tex .katex {
		font-size: 1.25em;
	}
	.kf-row__name {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.kf-row__term {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.kf-row__more {
		padding: 0 0.25rem 0.8rem;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}
	.kf-row__more p {
		margin: 0.4rem 0 0;
	}
	.kf-row__note {
		color: var(--sl-color-gray-2);
		font-style: italic;
	}
	.kf-sym {
		margin: 0.4rem 0 0;
		display: grid;
		gap: 0.25rem;
	}
	.kf-sym > div {
		display: grid;
		grid-template-columns: minmax(2.75rem, auto) 1fr;
		gap: 0.75rem;
		align-items: baseline;
	}
	.kf-sym dt {
		text-align: right;
		color: var(--sl-color-white);
	}
	.kf-sym dd {
		margin: 0;
	}
	.kf-sym__unit {
		white-space: nowrap;
		color: var(--sl-color-text-accent);
	}
	@media (prefers-reduced-motion: reduce) {
		.kf-row > summary::after {
			transition: none;
		}
	}
</style>
