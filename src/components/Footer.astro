---
import Default from '@astrojs/starlight/components/Footer.astro';
import TestParts from './test/TestParts.astro';

// «Источники иллюстраций» is not in the sidebar (Irina, 13 Nov 2026): it is linked here, under every textbook page
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Default />
<p class="copyright">
	© Ирина Горбунова, 2026. Все права защищены. <a href={`${base}uchebnik/istochniki/`}>Источники иллюстраций</a>
</p>
<TestParts />

<style>
	.copyright {
		margin: 2.5rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.copyright a {
		margin-left: 0.5em;
		color: inherit;
	}
</style>
