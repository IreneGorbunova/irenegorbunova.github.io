---
/**
 * The page's <head> plus the picture for link previews (og:image): Telegram, VK, WhatsApp and others show it next to
 * a shared link. A chapter has its own card, public/og/<slug>.jpg (its opening scene with the title, made by
 * scripts/make-share.mjs); every other page of the textbook shows the textbook's card.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const id = Astro.locals.starlightRoute.entry.id;
const slug = /^uchebnik\/\d+-klass\/[^/]+\/[^/]+$/.test(id) ? id.split('/').pop()! : '';
const file = slug && existsSync(join(process.cwd(), 'public/og', `${slug}.jpg`)) ? `${slug}.jpg` : 'uchebnik.jpg';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const image = new URL(`${base}og/${file}`, Astro.site).href;
---

<Default />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
