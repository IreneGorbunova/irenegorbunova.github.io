---
/** List of portraits with their sources, built from src/data/portraits/*.json. */
type Credit = { file: string; person: string; source: string; author: string; license: string };
const records = Object.values(
	import.meta.glob<Credit>('../data/portraits/*.json', { eager: true, import: 'default' }),
).sort((a, b) => a.person.localeCompare(b.person, 'ru'));
---

<ul>
	{
		records.map((r) => (
			<li>
				<strong>{r.person}</strong>. Автор: {r.author}. <a href={r.source}>Wikimedia Commons</a>, {r.license}.
			</li>
		))
	}
</ul>
