---
/**
 * «Посмотри в телескоп»: the same object as nine instruments show it, from the naked eye and Galileo's tube to
 * the space telescopes. A dividing line splits the frame: on the left the chosen telescope's view, on the right the
 * best picture of today; a small window shows the telescope's true field of view (how large the object looked in
 * the eyepiece). Everything the telescope does to the picture follows from its numbers (./data.ts, ./telescope.ts).
 * The mirrors in the timeline are drawn to one scale, next to a person 1,7 m tall.
 */
import { SCOPES, TARGETS, JUPITER_MOONS, HOW } from './data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const json = JSON.stringify({ scopes: SCOPES, targets: TARGETS, moons: JUPITER_MOONS, how: HOW, base });
// the mirrors to scale: 6,5 m is 60 px
const PX_PER_MM = 60 / 6500;
const first = TARGETS[0];
---

<div class="tscope not-content" data-tscope>
	<div class="ts-targets" role="group" aria-label="На что смотреть">
		{
			TARGETS.map((t) => (
				<button type="button" class="ts-target" data-target={t.id} aria-pressed={t === first ? 'true' : 'false'}>
					<img src={`${base}telescope/${t.file}-thumb.webp`} alt="" width="72" height="72" loading="lazy" />
					<span>{t.name}</span>
				</button>
			))
		}
	</div>

	<div class="ts-main">
		<div class="ts-stage is-loading" data-ts-stage tabindex="0" role="group" aria-label="Вид в телескоп слева от линии и современный снимок справа">
			<div class="ts-view">
				<img class="ts-img" data-ts-ref alt="" decoding="async" />
			</div>
			<div class="ts-view ts-view--tel" data-ts-tel>
				<div class="ts-ch" data-ts-ch><img class="ts-img" alt="" decoding="async" /></div>
				<div class="ts-ch" data-ts-ch><img class="ts-img" alt="" decoding="async" /></div>
				<div class="ts-ch" data-ts-ch><img class="ts-img" alt="" decoding="async" /></div>
				<p class="ts-nothing" data-ts-nothing hidden></p>
			</div>
			<div class="ts-split" data-ts-split role="slider" tabindex="0" aria-label="Граница между видом в телескоп и современным снимком" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
				<span class="ts-split__grip" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M9 6l-5 6 5 6M15 6l5 6-5 6" /></svg>
				</span>
			</div>
			<p class="ts-tag ts-tag--l" data-ts-tag-l></p>
			<p class="ts-tag ts-tag--r" data-ts-tag-r></p>
			<div class="ts-eye" data-ts-eye>
				<div class="ts-eye__glass" data-ts-eye-glass>
					<img class="ts-img" data-ts-eye-img alt="" decoding="async" />
					<span class="ts-eye__dot" data-ts-eye-dot hidden></span>
					<span data-ts-eye-moons></span>
				</div>
				<p class="ts-eye__cap" data-ts-eye-cap></p>
			</div>
			<div class="ts-zoom">
				<button type="button" data-ts-full aria-pressed="false" aria-label="На весь экран">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
				</button>
				<button type="button" data-ts-zoom="in" aria-label="Крупнее">+</button>
				<button type="button" data-ts-zoom="out" aria-label="Мельче">−</button>
			</div>
		</div>

		<aside class="ts-info" aria-live="polite">
			<p class="ts-info__year" data-ts-year></p>
			<h3 class="ts-info__name" data-ts-name></h3>
			<dl class="ts-stats">
				<div data-ts-stat="d"><dt>Зеркало</dt><dd></dd></div>
				<div data-ts-stat="light"><dt>Собирает света</dt><dd></dd></div>
				<div data-ts-stat="theta"><dt>Различает детали от</dt><dd></dd></div>
				<div data-ts-stat="mlim"><dt>Самые слабые звёзды</dt><dd></dd></div>
				<div data-ts-stat="how"><dt>Как смотрят</dt><dd></dd></div>
				<div data-ts-stat="color"><dt>Цвета</dt><dd></dd></div>
			</dl>
			<p class="ts-info__note" data-ts-note></p>
			<p class="ts-info__text" data-ts-text></p>
		</aside>
	</div>

	<div class="ts-line">
		<div class="ts-line__head">
			<p class="ts-line__h">Телескопы по порядку. Кружки — их объективы и зеркала в одном масштабе</p>
			<button type="button" class="ts-real" data-ts-real aria-pressed="false" title="Дрожание воздуха и уплывающее небо">Как в жизни</button>
			<button type="button" class="ts-play" data-ts-play aria-pressed="false">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z" /></svg>
				<span>Пройти 400 лет</span>
			</button>
		</div>
		<div class="ts-scopes" role="group" aria-label="Телескоп">
			<div class="ts-scope ts-scope--man" aria-hidden="true">
				<span class="ts-scope__pic">
					<svg viewBox="0 0 10 24" style={`height:${(1700 * PX_PER_MM).toFixed(1)}px`}><circle cx="5" cy="2.6" r="2.4" /><path d="M5 5.4v9M5 7.5L1.2 12M5 7.5l3.8 4.5M5 14.4L2 23M5 14.4L8 23" /></svg>
				</span>
				<span class="ts-scope__year">для масштаба</span>
				<span class="ts-scope__name">человек, 1,7 м</span>
			</div>
			{
				SCOPES.map((s, i) => (
					<button type="button" class="ts-scope" data-scope={s.id} aria-pressed={i === 1 ? 'true' : 'false'}>
						<span class="ts-scope__pic">
							<span class="ts-scope__mirror" style={`width:${Math.max(3, s.d * PX_PER_MM).toFixed(1)}px;height:${Math.max(3, s.d * PX_PER_MM).toFixed(1)}px`} />
						</span>
						<span class="ts-scope__year">{s.year}</span>
						<span class="ts-scope__name">{s.short}</span>
					</button>
				))
			}
		</div>
	</div>

	<p class="ts-realnote" data-ts-real-note></p>
	<p class="ts-about" data-ts-about></p>
	<p class="ts-credit" data-ts-credit></p>
	<details class="ts-how">
		<summary>Как это посчитано</summary>
		<p>
			Справа от линии — лучший снимок объекта. Слева он же, но изменённый так, как его «портит» выбранный телескоп. Резкость: телескоп не различает деталей мельче своего предела, и снимок размыт ровно на эту величину в масштабе кадра. Предел задаёт диаметр объектива (чем он больше, тем мельче детали), а на Земле ещё и дрожание воздуха — около одной угловой секунды. Глубина: чем меньше света собирает телескоп, тем больше слабых деталей пропадает; у туманностей и галактик это оценено по записям наблюдателей. Цвет: глаз в окуляре не различает цветов слабого света, поэтому туманности и галактики в старых телескопах серые, хотя Луна и планеты цветные; фотопластинка была чёрно-белой. Цветная кайма у трубы Галилея — свойство простой линзы. Если диск планеты меньше того, что различает телескоп, планета показана точкой.
		</p>
		<p>
			Кнопка «Как в жизни» добавляет две вещи. Воздух над наземным телескопом дрожит: изображение смещается примерно на половину угловой секунды и то резче, то мутнее. А в телескопах без часового привода небо уплывает из поля зрения со скоростью 15″ в секунду — из-за вращения Земли.
		</p>
		<p>
			Круглое окно внизу слева показывает настоящее поле зрения телескопа: каким по размеру объект выглядел в окуляре. У камер это прямоугольный кадр.
		</p>
	</details>
	<script type="application/json" data-ts-data set:html={json} />
</div>

<script>
	import './telescope';
</script>

<style is:global>
	@media (min-width: 72rem) {
		:root:has([data-tscope]) {
			--sl-content-width: 62rem;
		}
	}
	.tscope {
		--ts-sky: #000;
		color: var(--sl-color-white);
	}
	.tscope button {
		font: inherit;
		cursor: pointer;
	}
	.tscope :focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	/* what to look at */
	.ts-targets {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.25rem;
		overflow-x: auto;
	}
	.ts-target {
		flex: none;
		display: grid;
		justify-items: center;
		gap: 0.3rem;
		width: 5.6rem;
		padding: 0.4rem 0.2rem 0.45rem;
		font-size: var(--sl-text-xs);
		line-height: 1.2;
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid transparent;
		border-radius: 0.9rem;
	}
	.ts-target img {
		width: 3.6rem;
		height: 3.6rem;
		border-radius: 50%;
		object-fit: cover;
		background: var(--ts-sky);
		border: 2px solid var(--sl-color-gray-5);
	}
	.ts-target:hover img {
		border-color: var(--sl-color-gray-3);
	}
	.ts-target[aria-pressed='true'] {
		color: var(--sl-color-white);
		background: var(--ig-surface);
		border-color: var(--sl-color-gray-5);
	}
	.ts-target[aria-pressed='true'] img {
		border-color: var(--sl-color-accent);
	}

	/* the frame */
	.ts-main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 19.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		overflow: hidden;
		background: var(--ig-surface);
	}
	.ts-stage {
		position: relative;
		aspect-ratio: 1 / 1;
		max-height: 78vh;
		min-height: 18rem;
		overflow: hidden;
		background: var(--ts-sky);
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}
	.ts-stage.is-drag {
		cursor: grabbing;
	}
	.ts-stage.is-loading .ts-img {
		opacity: 0;
	}
	.ts-view,
	.ts-ch {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: var(--ts-sky);
	}
	.ts-img {
		position: absolute;
		left: 50%;
		top: 50%;
		max-width: none;
		transform-origin: 50% 50%;
		transition: opacity 0.3s;
		pointer-events: none;
	}
	/* one image; with a single lens three: the red, the green and the blue one, added together */
	.ts-ch + .ts-ch {
		display: none;
	}
	.ts-view--tel.is-chroma .ts-ch {
		display: block;
		isolation: isolate;
		mix-blend-mode: screen;
	}
	.ts-view--tel.is-chroma .ts-ch::after {
		content: '';
		position: absolute;
		inset: 0;
		mix-blend-mode: multiply;
		background: #f00;
	}
	.ts-view--tel.is-chroma .ts-ch:nth-child(2)::after {
		background: #0f0;
	}
	.ts-view--tel.is-chroma .ts-ch:nth-child(3)::after {
		background: #00f;
	}
	.ts-view--tel.is-nothing .ts-ch {
		visibility: hidden;
	}
	.ts-nothing {
		position: absolute;
		left: 1rem;
		top: 50%;
		width: min(42%, 15rem);
		margin: 0;
		transform: translateY(-50%);
		font-size: var(--sl-text-sm);
		line-height: 1.35;
		color: hsl(230, 25%, 70%);
	}
	/* the disc is not resolved: a point of light in the middle of the frame */
	.ts-view--tel.is-point::after {
		content: '';
		position: absolute;
		left: 25%;
		top: 50%;
		width: 7px;
		height: 7px;
		margin: -3px 0 0 -3px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 14px 5px hsl(45 100% 85% / 0.75);
	}
	.ts-view--tel.is-point .ts-nothing {
		top: 62%;
	}
	.ts-nothing[hidden] {
		display: none;
	}
	.ts-split {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 44px;
		margin-left: -22px;
		cursor: ew-resize;
		touch-action: none;
	}
	.ts-split::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 2px;
		margin-left: -1px;
		background: hsl(45 100% 85% / 0.9);
		box-shadow: 0 0 8px hsl(232 60% 4% / 0.9);
	}
	.ts-split__grip {
		position: absolute;
		left: 50%;
		top: 50%;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		margin: -20px 0 0 -20px;
		border-radius: 50%;
		background: hsl(42, 90%, 62%);
		color: hsl(232, 50%, 10%);
		box-shadow: 0 2px 12px hsl(232 60% 4% / 0.7);
	}
	.ts-split__grip svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ts-tag {
		position: absolute;
		top: 0.6rem;
		max-width: 46%;
		margin: 0;
		padding: 0.2rem 0.6rem;
		font-size: var(--sl-text-xs);
		line-height: 1.3;
		border-radius: 0.5rem;
		background: hsl(232 55% 6% / 0.78);
		color: hsl(40, 30%, 94%);
		pointer-events: none;
	}
	.ts-tag--l {
		left: 0.6rem;
		color: hsl(42, 90%, 72%);
	}
	.ts-tag--r {
		right: 0.6rem;
		text-align: right;
	}
	/* the true field of view */
	.ts-eye {
		position: absolute;
		left: 0.6rem;
		bottom: 0.6rem;
		width: 148px;
		pointer-events: none;
	}
	.ts-eye__glass {
		position: relative;
		width: 148px;
		height: 148px;
		overflow: hidden;
		border-radius: 50%;
		background: var(--ts-sky);
		box-shadow:
			0 0 0 2px hsl(42 60% 60% / 0.7),
			0 0 0 6px hsl(232 50% 8% / 0.85),
			inset 0 0 22px 6px hsl(232 60% 3%);
	}
	.ts-eye.is-camera .ts-eye__glass {
		border-radius: 0.5rem;
	}
	.ts-eye__dot {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 4px;
		height: 4px;
		margin: -2px 0 0 -2px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 6px 2px hsl(45 100% 85% / 0.8);
	}
	.ts-eye__dot[hidden] {
		display: none;
	}
	.ts-eye__moon {
		position: absolute;
		top: 50%;
		width: 2px;
		height: 2px;
		margin: -1px 0 0 -1px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 3px 1px hsl(0 0% 100% / 0.6);
	}
	.ts-eye__cap {
		margin: 0.55rem 0 0;
		padding: 0.15rem 0.4rem;
		font-size: 0.72rem;
		line-height: 1.3;
		text-align: center;
		border-radius: 0.4rem;
		background: hsl(232 55% 6% / 0.78);
		color: hsl(40, 30%, 92%);
	}
	.ts-zoom {
		position: absolute;
		right: 0.6rem;
		bottom: 0.6rem;
		display: grid;
		gap: 0.35rem;
	}
	.ts-zoom button {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		font-size: 1.35rem;
		line-height: 1;
		color: #fff;
		background: hsl(232 50% 10% / 0.82);
		border: 1px solid hsl(230 30% 40%);
		border-radius: 0.7rem;
	}

	.ts-zoom svg {
		width: 1.2rem;
		height: 1.2rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ts-zoom button[aria-pressed='true'] {
		background: hsl(42, 90%, 62%);
		color: hsl(232, 50%, 10%);
	}

	/* the whole screen: the objects above, the frame with the numbers, the telescopes below */
	html.ts-lock {
		overflow: hidden;
	}
	.tscope.is-full {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto minmax(0, 1fr) auto;
		gap: 0.4rem;
		padding: 0.5rem;
		background: var(--sl-color-bg);
	}
	.tscope.is-full .ts-targets {
		margin: 0;
	}
	.tscope.is-full .ts-target {
		grid-auto-flow: column;
		align-items: center;
		width: auto;
		padding: 0.2rem 0.6rem 0.2rem 0.25rem;
	}
	.tscope.is-full .ts-target img {
		width: 2.2rem;
		height: 2.2rem;
	}
	.tscope.is-full .ts-main {
		min-height: 0;
	}
	.tscope.is-full .ts-stage {
		aspect-ratio: auto;
		min-height: 0;
		max-height: none;
		height: 100%;
	}
	.tscope.is-full .ts-info {
		overflow: auto;
	}
	.tscope.is-full .ts-line {
		margin: 0;
		padding: 0.4rem 0.6rem 0.3rem;
	}
	.tscope.is-full .ts-line__h,
	.tscope.is-full .ts-about,
	.tscope.is-full .ts-credit,
	.tscope.is-full .ts-how {
		display: none;
	}
	.tscope.is-full .ts-line__head {
		float: right;
		margin: 0 0 0 0.6rem;
	}
	.tscope.is-full .ts-scope {
		grid-template-rows: 34px auto auto;
		padding: 0.15rem 0.2rem 0.25rem;
	}
	.tscope.is-full .ts-scope__mirror {
		transform: scale(0.5);
		transform-origin: 50% 100%;
	}
	.tscope.is-full .ts-scope--man svg {
		transform: scale(0.5);
		transform-origin: 50% 100%;
	}
	@media (max-width: 56rem) {
		.tscope.is-full .ts-main {
			grid-template-rows: minmax(0, 1fr);
		}
		.tscope.is-full .ts-info,
		.tscope.is-full .ts-line__head,
		.tscope.is-full .ts-realnote {
			display: none;
		}
	}

	/* the numbers */
	.ts-info {
		padding: 1rem 1.1rem;
		border-left: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-base);
		line-height: 1.45;
	}
	.ts-info p {
		margin: 0;
	}
	.ts-info__year {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.ts-info__name {
		margin: 0.1rem 0 0.7rem;
		font-family: var(--ig-font-display);
		font-size: 2rem;
		font-weight: 400;
		line-height: 1.1;
		color: var(--sl-color-white);
	}
	.ts-stats {
		display: grid;
		gap: 0.3rem;
		margin: 0 0 0.8rem;
	}
	.ts-stats > div {
		display: grid;
		grid-template-columns: 8.2rem 1fr;
		gap: 0.6rem;
		padding: 0.3rem 0;
		border-top: 1px dashed var(--sl-color-gray-5);
	}
	.ts-stats dt {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.ts-stats dd {
		margin: 0;
		font-weight: 700;
	}
	.ts-stats dd span {
		display: block;
		font-size: var(--sl-text-sm);
		font-weight: 400;
		color: var(--sl-color-gray-2);
	}
	.ts-info .ts-info__note {
		margin-bottom: 0.7rem;
		padding: 0.55rem 0.7rem;
		border-left: 3px solid var(--sl-color-accent);
		border-radius: 0 0.5rem 0.5rem 0;
		background: color-mix(in srgb, var(--sl-color-accent-low) 55%, transparent);
	}
	.ts-info__note[hidden] {
		display: none;
	}
	.ts-info__text {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	/* the telescopes in order */
	.ts-line {
		margin-top: 0.9rem;
		padding: 0.8rem 0.9rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ts-line__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-bottom: 0.4rem;
	}
