---
/**
 * «Посмотри в телескоп»: the same object as ten instruments show it, from the naked eye and Galileo's tube to
 * the space telescopes, and a school telescope of our days beside them (after Webb, set apart: it is the one a pupil
 * may look through, and «Пройти 400 лет», which is history, leaves it out). A dividing line splits the frame: on the left the chosen telescope's view, on the right the
 * best picture of today; a small window shows the telescope's true field of view (how large the object looked in
 * the eyepiece). Everything the telescope does to the picture follows from its numbers (./data.ts, ./telescope.ts).
 * The mirrors in the timeline are drawn to one scale, next to a person 1,7 m tall.
 * On a phone the telescopes come right under the frame and the numbers after them, so that the frame stays in sight
 * while one chooses; on a computer the frame has a fixed height and the numbers scroll beside it, so that nothing
 * jumps when the telescope changes.
 */
import { SCOPES, TARGETS, JUPITER_MOONS, HOW } from './data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const json = JSON.stringify({ scopes: SCOPES, targets: TARGETS, moons: JUPITER_MOONS, how: HOW, base });
// the mirrors to scale: 6,5 m is 60 px
const PX_PER_MM = 60 / 6500;
const first = TARGETS[0];
---

<div class="tscope not-content" data-tscope>
	<div class="ts-targets" role="group" aria-label="На что смотреть">
		{
			TARGETS.map((t) => (
				<button type="button" class="ts-target" data-target={t.id} aria-pressed={t === first ? 'true' : 'false'}>
					<img src={`${base}telescope/${t.file}-thumb.webp`} alt="" width="72" height="72" loading="lazy" />
					<span>{t.name}</span>
				</button>
			))
		}
	</div>

	<div class="ts-main">
		<div class="ts-stage is-loading" data-ts-stage tabindex="0" role="group" aria-label="Вид в телескоп слева от линии и современный снимок справа">
			<!-- the labels and the Sun's warning sit above the picture, the window of the field of view and the buttons below
			     it: the picture is fitted between the two bands and never lies under them, at any zoom -->
			<div class="ts-band ts-band--top">
				<p class="ts-tag ts-tag--l" data-ts-tag-l></p>
				<p class="ts-tag ts-tag--r" data-ts-tag-r></p>
				<p class="ts-warn" data-ts-warn role="note" hidden></p>
			</div>
			<div class="ts-pic" data-ts-pic>
				<div class="ts-view">
					<img class="ts-img" data-ts-ref alt="" decoding="async" />
				</div>
				<div class="ts-view ts-view--tel" data-ts-tel>
					<div class="ts-ch" data-ts-ch><img class="ts-img" alt="" decoding="async" /></div>
					<div class="ts-ch" data-ts-ch><img class="ts-img" alt="" decoding="async" /></div>
					<div class="ts-ch" data-ts-ch><img class="ts-img" alt="" decoding="async" /></div>
				</div>
				<p class="ts-nothing" data-ts-nothing hidden></p>
			</div>
			<div class="ts-band ts-band--bot" data-ts-bot>
				<div class="ts-eye" data-ts-eye>
					<div class="ts-eye__glass" data-ts-eye-glass>
						<img class="ts-img" data-ts-eye-img alt="" decoding="async" />
						<img class="ts-img ts-eye__glow" data-ts-eye-glow alt="" decoding="async" hidden />
						<span class="ts-eye__dot" data-ts-eye-dot hidden></span>
						<span data-ts-eye-moons></span>
						<p class="ts-eye__note" data-ts-eye-note hidden></p>
					</div>
					<p class="ts-eye__cap" data-ts-eye-cap></p>
				</div>
				<div class="ts-zoom" data-ts-zoombox>
					<button type="button" data-ts-full aria-pressed="false" aria-label="На весь экран" title="На весь экран">
						<svg class="ts-full-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
						<svg class="ts-full-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
					</button>
					<button type="button" data-ts-zoom="in" aria-label="Крупнее">+</button>
					<button type="button" data-ts-zoom="out" aria-label="Мельче">−</button>
				</div>
			</div>
			<div class="ts-split" data-ts-split role="slider" tabindex="0" aria-label="Граница между видом в телескоп и современным снимком" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
				<span class="ts-split__grip" data-ts-grip aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M9 6l-5 6 5 6M15 6l5 6-5 6" /></svg>
				</span>
			</div>
		</div>

		<aside class="ts-info" aria-live="polite">
			<p class="ts-info__year" data-ts-year></p>
			<h3 class="ts-info__name" data-ts-name></h3>
			<dl class="ts-stats">
				<div data-ts-stat="d"><dt>Зеркало</dt><dd></dd></div>
				<div data-ts-stat="light"><dt>Собирает света</dt><dd></dd></div>
				<div data-ts-stat="theta"><dt>Различает детали&nbsp;от</dt><dd></dd></div>
				<div data-ts-stat="mlim"><dt>Самые слабые звёзды</dt><dd></dd></div>
				<div data-ts-stat="how"><dt>Как смотрят</dt><dd></dd></div>
				<div data-ts-stat="color"><dt>Цвета</dt><dd></dd></div>
			</dl>
			<p class="ts-info__note" data-ts-note></p>
			<p class="ts-info__text" data-ts-text></p>
		</aside>
	</div>

	<div class="ts-line">
		<div class="ts-line__head">
			<p class="ts-line__h">Телескопы по порядку. Кружки — их объективы и зеркала в одном масштабе</p>
			<button type="button" class="ts-real" data-ts-real aria-pressed="false" title="Дрожание воздуха и уплывающее небо">Как в жизни</button>
			<button type="button" class="ts-play" data-ts-play aria-pressed="false">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z" /></svg>
				<span>Пройти 400 лет</span>
			</button>
		</div>
		<div class="ts-scopes" role="group" aria-label="Телескоп">
			<div class="ts-scope ts-scope--man" aria-hidden="true">
				<span class="ts-scope__pic">
					<svg viewBox="0 0 10 24" style={`height:${(1700 * PX_PER_MM).toFixed(1)}px`}><circle cx="5" cy="2.6" r="2.4" /><path d="M5 5.4v9M5 7.5L1.2 12M5 7.5l3.8 4.5M5 14.4L2 23M5 14.4L8 23" /></svg>
				</span>
				<span class="ts-scope__year">для масштаба</span>
				<span class="ts-scope__name">человек, 1,7&nbsp;м</span>
			</div>
			{
				SCOPES.map((s, i) => (
					<button type="button" class={s.aside ? 'ts-scope ts-scope--aside' : 'ts-scope'} data-scope={s.id} aria-pressed={i === 1 ? 'true' : 'false'}>
						<span class="ts-scope__pic">
							<span class="ts-scope__mirror" style={`width:${Math.max(3, s.d * PX_PER_MM).toFixed(1)}px;height:${Math.max(3, s.d * PX_PER_MM).toFixed(1)}px`} />
						</span>
						<span class="ts-scope__year">{s.year}</span>
						<span class="ts-scope__name">{s.short}</span>
					</button>
				))
			}
		</div>
	</div>

	<p class="ts-realnote" data-ts-real-note></p>
	<p class="ts-about" data-ts-about></p>
	<p class="ts-credit" data-ts-credit></p>
	<details class="ts-how">
		<summary>Как это посчитано</summary>
		<p>
			Справа от линии — лучший снимок объекта. Слева он же, но изменённый так, как его «портит» выбранный телескоп. Резкость: телескоп не различает деталей мельче своего предела, и снимок размыт ровно на эту величину в масштабе кадра. Предел задаёт диаметр объектива (чем он больше, тем мельче детали), а на Земле ещё и дрожание воздуха — около одной угловой секунды. Глубина: чем меньше света собирает телескоп, тем больше слабых деталей пропадает; у туманностей и галактик это оценено по записям наблюдателей. Цвет: глаз в окуляре не различает цветов слабого света, поэтому туманности и галактики в старых телескопах серые, хотя Луна и планеты цветные; фотопластинка была чёрно-белой. Цветная кайма у трубы Галилея — свойство простой линзы. Если диск планеты меньше того, что различает телескоп, планета показана точкой. Свечение Млечного Пути в окуляре тем слабее, чем больше увеличение: в трубе Галилея от него остаётся около 2 %, и на его месте видны звёзды.
		</p>
		<p>
			Кнопка «Как в жизни» добавляет две вещи. Воздух над наземным телескопом дрожит: изображение смещается примерно на половину угловой секунды и то резче, то мутнее. А в телескопах без часового привода небо уплывает из поля зрения со скоростью 15″ в секунду — из-за вращения Земли.
		</p>
		<p>
			Круглое окно внизу слева показывает настоящее поле зрения телескопа: каким по размеру объект выглядел в окуляре. У камер это прямоугольный кадр.
		</p>
	</details>
	<script type="application/json" data-ts-data set:html={json} />
</div>

<script>
	import './telescope';
</script>

<style is:global>
	@media (min-width: 72rem) {
		:root:has([data-tscope]) {
			--sl-content-width: 62rem;
		}
	}
	.tscope {
		--ts-sky: #000;
		/* the frame's height on a computer: fixed, so that the picture keeps its scale from one telescope to the next */
		--ts-h: clamp(28rem, calc(100vh - 10rem), 46rem);
		/* the bands above and below the picture: the labels (one line here, two on a phone) and the window of the field
		   of view with the buttons */
		--ts-top: 2.5rem;
		--ts-eye: 132px;
		--ts-bot: calc(var(--ts-eye) + 1.25rem);
		color: var(--sl-color-white);
		/* (the phone's frame takes its height from this width) */
		container-type: inline-size;
	}
	.tscope button {
		font: inherit;
		cursor: pointer;
	}
	.tscope :focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	/* what to look at */
	.ts-targets {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.25rem;
		overflow-x: auto;
	}
	/* a strip that scrolls fades out at the side where more is hidden */
	.ts-targets.is-r,
	.ts-scopes.is-r {
		mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
	}
	.ts-targets.is-l,
	.ts-scopes.is-l {
		mask-image: linear-gradient(to left, #000 calc(100% - 3rem), transparent);
	}
	.ts-targets.is-l.is-r,
	.ts-scopes.is-l.is-r {
		mask-image: linear-gradient(to right, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
	}
	.ts-target {
		flex: none;
		display: grid;
		justify-items: center;
		gap: 0.3rem;
		width: 5.6rem;
		padding: 0.4rem 0.2rem 0.45rem;
		font-size: var(--sl-text-xs);
		line-height: 1.2;
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid transparent;
		border-radius: 0.9rem;
	}
	.ts-target img {
		width: 3.6rem;
		height: 3.6rem;
		border-radius: 50%;
		object-fit: cover;
		background: var(--ts-sky);
		border: 2px solid var(--sl-color-gray-5);
	}
	.ts-target:hover img {
		border-color: var(--sl-color-gray-3);
	}
	.ts-target[aria-pressed='true'] {
		color: var(--sl-color-white);
		background: var(--ig-surface);
		border-color: var(--sl-color-gray-5);
	}
	.ts-target[aria-pressed='true'] img {
		border-color: var(--sl-color-accent);
	}

	/* the frame */
	.ts-main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 19.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		overflow: hidden;
		background: var(--ig-surface);
	}
	.ts-stage {
		position: relative;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		/* a phone: a square picture between the two bands */
		height: calc(100cqw + var(--ts-top) + var(--ts-bot));
		max-height: 78vh;
		min-height: 18rem;
		overflow: hidden;
		background: var(--ts-sky);
		/* a finger moving up or down scrolls the page; once the picture is zoomed, it pans the picture */
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.ts-stage.is-zoomed {
		touch-action: none;
	}
	.ts-stage.is-drag {
		cursor: grabbing;
	}
	.ts-stage.is-loading .ts-img {
		opacity: 0;
	}
	.ts-pic {
		position: relative;
		min-height: 0;
		overflow: hidden;
	}
	.ts-band {
		position: relative;
		z-index: 1;
		display: flex;
		background: var(--ts-sky);
	}
	.ts-band--top {
		display: grid;
		grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
		align-items: start;
		gap: 0.4rem 0.6rem;
		min-height: var(--ts-top);
		padding: 0.5rem 0.6rem 0.3rem;
	}
	.ts-band--bot {
		align-items: center;
		justify-content: space-between;
		height: var(--ts-bot);
		padding: 0 0.6rem;
	}
	/* a wide frame: the window with its caption under it on the left of the picture, the buttons on its right, the
	   grip's lane under it (telescope.ts chooses this when the picture comes out larger) */
	.ts-stage.is-wide {
		--ts-bot: 3.5rem;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-rows: auto minmax(0, 1fr) var(--ts-bot);
	}
	.ts-stage.is-wide .ts-band--top {
		grid-column: 1 / -1;
	}
	.ts-stage.is-wide .ts-pic {
		grid-column: 2;
		grid-row: 2;
	}
	.ts-stage.is-wide .ts-band--bot {
		display: contents;
	}
	.ts-stage.is-wide .ts-eye {
		grid-column: 1;
		grid-row: 2 / 4;
		align-self: end;
		flex-direction: column;
		width: calc(var(--ts-eye) + 1.2rem);
		padding: 0 0.6rem 0.6rem;
	}
	.ts-stage.is-wide .ts-eye__cap {
		text-align: center;
	}
	.ts-stage.is-wide .ts-zoom {
		grid-column: 3;
		grid-row: 2 / 4;
		align-self: end;
		padding: 0 0.6rem 0.6rem;
	}
	.ts-view,
	.ts-ch {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: var(--ts-sky);
	}
	.ts-img {
		position: absolute;
		left: 50%;
		top: 50%;
		max-width: none;
		transform-origin: 50% 50%;
		transition: opacity 0.3s;
		pointer-events: none;
	}
	/* one image; with a single lens three: the red, the green and the blue one, added together */
	.ts-ch + .ts-ch {
		display: none;
	}
	.ts-view--tel.is-chroma .ts-ch {
		display: block;
		isolation: isolate;
		mix-blend-mode: screen;
	}
	.ts-view--tel.is-chroma .ts-ch::after {
		content: '';
		position: absolute;
		inset: 0;
		mix-blend-mode: multiply;
		background: #f00;
	}
	.ts-view--tel.is-chroma .ts-ch:nth-child(2)::after {
		background: #0f0;
	}
	.ts-view--tel.is-chroma .ts-ch:nth-child(3)::after {
		background: #00f;
	}
	.ts-view--tel.is-nothing .ts-ch {
		visibility: hidden;
	}
	.ts-nothing {
		position: absolute;
		left: 1rem;
		top: 50%;
		width: 15rem;
		margin: 0;
		transform: translateY(-50%);
		font-size: var(--sl-text-sm);
		line-height: 1.35;
		color: hsl(230, 25%, 70%);
	}
	/* the disc is not resolved: a point of light in the middle of the frame */
	.ts-view--tel.is-point::after {
		content: '';
		position: absolute;
		left: 25%;
		top: 50%;
		width: 7px;
		height: 7px;
		margin: -3px 0 0 -3px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 14px 5px hsl(45 100% 85% / 0.75);
	}
	/* (the words start under the point) */
	.ts-view--tel.is-point ~ .ts-nothing {
		top: calc(50% + 1.4rem);
		transform: none;
	}
	.ts-nothing[hidden] {
		display: none;
	}
	/* the Milky Way: the second layer is its unresolved glow, added on top of the stars */
	.ts-view--tel.is-glow .ts-ch:nth-child(2) {
		display: block;
		mix-blend-mode: screen;
	}
	.ts-eye__glow {
		mix-blend-mode: screen;
	}
	.ts-eye__glow[hidden] {
		display: none;
	}
	/* the Sun: a warning that stays on the frame, under the labels */
	.ts-warn {
		grid-column: 1 / -1;
		margin: 0;
		padding: 0.35rem 0.6rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-red-high);
		background: color-mix(in srgb, var(--sl-color-red-low) 92%, transparent);
		border: 1px solid var(--sl-color-red);
		border-radius: 0.5rem;
		pointer-events: none;
	}
	.ts-warn[hidden] {
		display: none;
	}
	/* the line runs down the picture into the band below, where its grip is */
	.ts-split {
		position: absolute;
		z-index: 2;
		top: var(--ts-split-top, 0px);
		bottom: 0;
		width: 44px;
		margin-left: -22px;
		cursor: ew-resize;
		touch-action: none;
	}
	.ts-split::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 2px;
		margin-left: -1px;
		background: hsl(45 100% 85% / 0.9);
		box-shadow: 0 0 8px hsl(232 60% 4% / 0.9);
	}
	.ts-split__grip {
		position: absolute;
		left: 50%;
		bottom: calc(var(--ts-bot) / 2 - 20px);
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		margin: 0 0 0 -20px;
		border-radius: 50%;
		background: hsl(42, 90%, 62%);
		color: hsl(232, 50%, 10%);
		box-shadow: 0 2px 12px hsl(232 60% 4% / 0.7);
	}
	.ts-split__grip svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ts-tag {
		margin: 0;
		padding: 0.2rem 0.6rem;
		font-size: var(--sl-text-xs);
		line-height: 1.3;
		border-radius: 0.5rem;
		background: hsl(232 55% 6% / 0.78);
		color: hsl(40, 30%, 94%);
		pointer-events: none;
	}
	.ts-tag--l {
		color: hsl(42, 90%, 72%);
	}
	.ts-tag--r {
		justify-self: end;
		text-align: right;
	}
	.ts-tag:empty {
		visibility: hidden;
	}
	.ts-band--top.is-long .ts-tag--r {
		grid-column: 1 / -1;
	}
	/* the true field of view */
	/* the window and its caption beside it (under it on a phone) */
	.ts-eye {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		pointer-events: none;
	}
	.ts-eye__glass {
		position: relative;
		flex: none;
		width: var(--ts-eye);
		height: var(--ts-eye);
		overflow: hidden;
		border-radius: 50%;
		background: var(--ts-sky);
		box-shadow:
			0 0 0 2px hsl(42 60% 60% / 0.7),
			0 0 0 6px hsl(232 50% 8% / 0.85),
			inset 0 0 22px 6px hsl(232 60% 3%);
	}
	.ts-eye.is-camera .ts-eye__glass {
		border-radius: 0.5rem;
	}
	.ts-eye__dot {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 4px;
		height: 4px;
		margin: -2px 0 0 -2px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 6px 2px hsl(45 100% 85% / 0.8);
	}
	.ts-eye__dot[hidden] {
		display: none;
	}
	.ts-eye__moon {
		position: absolute;
		top: 50%;
		width: 2px;
		height: 2px;
		margin: -1px 0 0 -1px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 3px 1px hsl(0 0% 100% / 0.6);
	}
	/* the field is smaller than a few dots of the picture: words instead of a blur */
	.ts-eye__note {
		position: absolute;
		inset: 0;
