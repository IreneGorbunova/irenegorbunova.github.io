---
/**
 * Colors of the people kit (src/components/people/), from theme-aware variables. Renders nothing; a page that draws a
 * person with the kit's own prefixes includes it once (the old helpers' callers keep their own pp-, ph-, sw- rules).
 * Prefixes: hm- indoor clothes, pkh- home clothes, pkw- winter clothes, pks- swimwear. Shirt, jacket and trunks colors:
 * the classes hm-red, hm-blue, hm-green, hm-gold. The far arm and leg are darkened (filter on the far group).
 */
---

<style is:global>
	:root {
		--hm-skin: hsl(26, 55%, 72%);
		--hm-line: hsl(222, 35%, 14%);
		--hm-pants: hsl(225, 25%, 34%);
		--hm-shoe: hsl(210, 15%, 88%);
		--hm-hair: hsl(25, 40%, 28%);
		--hm-hair-b: hsl(38, 55%, 45%);
		--hm-boot: hsl(24, 38%, 34%);
		--hm-fur: hsl(36, 40%, 84%);
		--hm-wool: var(--ig-v);
		--hm-scarf: hsl(150, 50%, 50%);
		--hm-glove: hsl(222, 25%, 30%);
		--hm-lowshoe: hsl(24, 38%, 30%);
	}
	:root[data-theme='light'] {
		--hm-line: hsl(222, 30%, 22%);
		--hm-pants: hsl(225, 30%, 30%);
		--hm-shoe: hsl(210, 12%, 97%);
	}
	.hm-far,
	.pkh-far,
	.pkw-far,
	.pks-far {
		filter: brightness(0.8);
	}
	.hm-outline,
	.pkh-outline,
	.pkw-outline,
	.pks-outline {
		fill: none;
		stroke: var(--hm-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.hm-limb,
	.hm-limb-skin,
	.pkh-skin-limb,
	.pkh-sleeve,
	.pkh-pants,
	.pkw-sleeve,
	.pkw-pants,
	.pks-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.hm-limb-skin,
	.pkh-skin-limb,
	.pks-limb {
		stroke: var(--hm-skin);
	}
	.hm-limb.hm-pants,
	.pkh-pants,
	.pkw-pants,
	.pkw-sleeve {
		stroke: var(--hm-pants);
	}
	.hm-shirt,
	.pkh-shirt,
	.pkw-coat {
		fill: var(--hm-pants);
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	.hm-seam,
	.pkw-zip {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.7;
		opacity: 0.55;
	}
	.hm-skin,
	.pkh-skin,
	.pkw-skin,
	.pks-skin {
		fill: var(--hm-skin);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.hm-ear,
	.pkh-ear,
	.pkw-ear,
	.pks-ear {
		stroke-width: 0.5;
	}
	.hm-cheek,
	.pkh-cheek,
	.pkw-cheek,
	.pks-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	.hm-eye,
	.pkh-eye,
	.pkw-eye,
	.pks-eye,
	.pks-dot,
	.hm-sole,
	.pkh-sole,
	.pkw-sole,
	.pkh-belt {
		fill: var(--hm-line);
	}
	.hm-brow,
	.hm-mouth,
	.pkh-brow,
	.pkh-mouth,
	.pkw-mouth,
	.pks-brow,
	.pks-mouth,
	.pks-toes,
	.pkh-collar {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.7;
		stroke-linecap: round;
	}
	.hm-hair,
	.pkh-hair,
	.pkw-hair,
	.pks-hair {
		fill: var(--hm-hair);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	.hm-blond .hm-hair {
		fill: var(--hm-hair-b);
	}
	.hm-tie {
		fill: var(--g7-red, var(--ig-vy));
	}
	.hm-shoe {
		fill: var(--hm-shoe);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.pkh-shoe {
		fill: var(--hm-lowshoe);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.hm-lace,
	.pkw-lace {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	/* winter */
	.pkw-hat,
	.pkw-pompom,
	.pkw-mitten {
		fill: var(--hm-wool);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.pkw-hat-band {
		fill: color-mix(in oklab, var(--hm-wool) 70%, var(--hm-line));
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.pkw-scarf {
		fill: var(--hm-scarf);
		stroke: var(--hm-line);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	.hm-glove,
	.pkh-glove,
	.pkw-glove,
	.pks-glove {
		fill: var(--hm-glove);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.hm-mitten,
	.pkh-mitten,
	.pks-mitten {
		fill: var(--hm-wool);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.pkw-boot {
		fill: var(--hm-boot);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.pkw-cuff {
		fill: var(--hm-fur);
	}
	.pkw-ski {
		fill: var(--ig-vy);
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	.pkw-bind,
	.pkw-holder,
	.pkw-strap {
		fill: var(--hm-line);
	}
	.pkw-blade,
	.pkw-shoe {
		fill: hsl(210, 12%, 82%);
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	.pkw-lattice,
	.pkw-shoe-rim {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	.pkw-pole {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	/* swimwear */
	.pks-trunk {
		fill: none;
		stroke-linecap: butt;
	}
	.pks-suit {
		stroke: var(--hm-line);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	/* shirt, jacket and trunks colors: the class goes on the torso and the sleeves */
	.hm-red {
		fill: var(--ig-vy);
		stroke: var(--ig-vy);
	}
	.hm-blue {
		fill: var(--ig-vx);
		stroke: var(--ig-vx);
	}
	.hm-green {
		fill: hsl(150, 50%, 50%);
		stroke: hsl(150, 50%, 50%);
	}
	.hm-gold {
		fill: var(--ig-v);
		stroke: var(--ig-v);
	}
	:is(.hm-shirt, .pkh-shirt, .pkw-coat, .pks-suit):is(.hm-red, .hm-blue, .hm-green, .hm-gold) {
		stroke: var(--hm-line);
	}
	:is(.hm-limb, .pkh-sleeve, .pkw-sleeve, .pks-trunk):is(.hm-red, .hm-blue, .hm-green, .hm-gold) {
		fill: none;
	}
</style>
