---
/**
 * Today's Moon in the night sky of the home page: the real phase for the visitor's date (./phase.ts), drawn over a
 * photo of the near side (LRO, NASA, public domain): the unlit part dark with a faint earthshine, a soft terminator,
 * a glow. Northern-hemisphere view: lit on the right while waxing. Placed inside `.hero` by the script in a free spot
 * that never touches the title, the tagline or the buttons. Hover, tap or keyboard focus opens a caption with the
 * phase; opening it sends `ig:moon` (counted by SiteStats.astro).
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="moon" data-moon data-src={`${base}moon/moon-near.jpg`}>
	<div class="moon__drift">
		<button
			type="button"
			class="moon__btn"
			aria-label="Луна сегодня"
			aria-expanded="false"
			aria-controls="moon-card"
			aria-describedby="moon-card"
		>
			<span class="moon__glow" aria-hidden="true"></span>
			<canvas class="moon__disc" aria-hidden="true"></canvas>
		</button>
		<div class="moon__card" id="moon-card" role="tooltip">
			<p class="moon__title">Луна сегодня</p>
			<p class="moon__name" data-name></p>
			<p class="moon__line" data-lit></p>
			<p class="moon__line" data-next></p>
		</div>
	</div>
</div>

<style>
	.moon {
		position: absolute;
		z-index: 2;
		left: 0;
		top: 0;
		width: 0;
		display: none;
		opacity: 0;
		animation: none; /* not the hero's «rise» */
		transition: opacity 1.6s ease;
	}
	.moon.is-placed {
		display: block;
	}
	.moon.is-ready {
		opacity: 1;
	}
	.moon__drift {
		position: relative;
		width: 100%;
		will-change: transform;
	}
	.moon__btn {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 1;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		cursor: pointer;
		color: inherit;
		-webkit-tap-highlight-color: transparent;
	}
	.moon__btn:focus-visible {
		outline: 2px solid rgb(243 201 105 / 0.85);
		outline-offset: 6px;
	}
	.moon__disc {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		transition: filter 0.3s;
	}
	.moon__btn:hover .moon__disc,
	.moon__btn[aria-expanded='true'] .moon__disc {
		filter: brightness(1.08);
	}
	.moon__glow {
		position: absolute;
		inset: -70%;
		border-radius: 50%;
		pointer-events: none;
		background: radial-gradient(
			circle closest-side,
			rgb(255 246 222 / 0.5) 0%,
			rgb(255 240 210 / 0.24) 36%,
			rgb(190 200 255 / 0.08) 62%,
			transparent 100%
		);
		opacity: var(--glow, 0.5);
		transform: translateX(var(--glow-x, 0));
	}

	.moon__card {
		position: absolute;
		top: calc(100% + 0.9rem);
		left: var(--card-x, 0);
		width: max-content;
		max-width: min(15.5rem, calc(100vw - 2rem));
		padding: 0.7rem 1.1rem 0.8rem;
		text-align: left;
		background: rgb(13 18 50 / 0.9);
		border: 1px solid rgb(243 201 105 / 0.45);
		border-radius: 1rem;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 14px 40px rgb(0 0 0 / 0.45);
		font-size: 1rem;
		line-height: 1.4;
		color: var(--text, #e9ecff);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0s 0.2s;
	}
	.moon.is-open .moon__card {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}
	.moon__card p {
		margin: 0;
	}
	.moon__title {
		font-family: var(--font-display, 'Great Vibes', cursive);
		font-size: 1.65rem;
		line-height: 1.1;
		color: var(--gold-hi, #ffdf9c);
		margin-bottom: 0.2rem !important;
	}
	.moon__name {
		font-weight: 700;
	}
	.moon__name::first-letter {
		text-transform: uppercase;
	}
	.moon__line {
		color: var(--muted, #a8afd6);
		font-size: 0.95rem;
	}
</style>

<script>
	import { moonPhase, daysText, type MoonPhase } from './phase';

	const root = document.querySelector<HTMLElement>('[data-moon]');
	const hero = root?.closest<HTMLElement>('.hero');
	if (root && hero) {
		const drift = root.querySelector<HTMLElement>('.moon__drift')!;
		const btn = root.querySelector<HTMLButtonElement>('.moon__btn')!;
		const canvas = root.querySelector<HTMLCanvasElement>('.moon__disc')!;
		const card = root.querySelector<HTMLElement>('.moon__card')!;
		const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
		const img = new Image();
		let phase: MoonPhase = moonPhase();
		let size = 0;

		/* ---------- drawing ---------- */

		const toLin = new Float32Array(256).map((_, v) => Math.pow(v / 255, 2.2));
		const toSrgb = (x: number) => 255 * Math.pow(Math.min(1, Math.max(0, x)), 1 / 2.2);

		function draw() {
			if (!size || !img.complete || !img.naturalWidth) return;
			const dpr = Math.min(window.devicePixelRatio || 1, 3);
			const N = Math.round(size * dpr);
			canvas.width = canvas.height = N;
			ctx.clearRect(0, 0, N, N);
			ctx.drawImage(img, 0, 0, N, N);
			const data = ctx.getImageData(0, 0, N, N);
			const px = data.data;
			const k = phase.fraction;
			const si = Math.sin((phase.angle * Math.PI) / 180) * (phase.waxing ? 1 : -1); // Sun to the right while waxing
			const ci = Math.cos((phase.angle * Math.PI) / 180);
			const w = 0.03; // softness of the terminator
			const sun = 2.1 * (0.85 + 0.15 * k); // a thin crescent is a little dimmer per area than the full Moon
			const earth = 0.0025 + 0.007 * (1 - k); // earthshine: strongest when the Moon is a thin crescent
			const R = N / 2;
			for (let j = 0; j < N; j++) {
				const y = (j + 0.5 - R) / R;
				for (let i = 0; i < N; i++) {
					const x = (i + 0.5 - R) / R;
					const r2 = x * x + y * y;
					const o = 4 * (j * N + i);
					const edge = (1 - Math.sqrt(r2)) * R + 0.5;
					if (edge <= 0) {
						px[o + 3] = 0;
						continue;
					}
					const z = Math.sqrt(Math.max(0, 1 - r2));
					const mu0 = x * si + z * ci; // cosine of the Sun's incidence
					const s = mu0 / w > 30 ? mu0 : w * Math.log1p(Math.exp(mu0 / w));
					// Lommel–Seeliger law: the Moon's disc is evenly bright at full moon, darker towards the terminator
					const t = Math.min(1.12, (2 * s) / (s + z + 0.02));
					const lit = Math.pow(t, 0.6) * sun; // the eye sees a crescent brighter than the law alone
					const a = toLin[px[o + 1]];
					// the night side hides only part of the sky behind it, as the air in front of the Moon glows too
					const cover = 0.55 + 0.45 * Math.min(1, t * 4);
					px[o] = toSrgb(a * (lit * 1.0 + earth * 0.75)) / cover;
					px[o + 1] = toSrgb(a * (lit * 0.97 + earth * 0.88)) / cover;
					px[o + 2] = toSrgb(a * (lit * 0.9 + earth * 1.1)) / cover;
					px[o + 3] = 255 * Math.min(1, edge) * cover;
				}
			}
			ctx.putImageData(data, 0, 0);
			root!.style.setProperty('--glow', (0.12 + 0.88 * Math.pow(k, 1.3)).toFixed(3));
			root!.style.setProperty('--glow-x', `${((phase.waxing ? 1 : -1) * (1 - k) * size * 0.22).toFixed(1)}px`);
			root!.classList.add('is-ready');
		}

		function fillCard() {
			const p = phase;
			card.querySelector('[data-name]')!.textContent = p.name;
			card.querySelector('[data-lit]')!.textContent = `освещено ${Math.round(p.fraction * 100)} %`;
			card.querySelector('[data-next]')!.textContent = `до ${p.nextEvent === 'full' ? 'полнолуния' : 'новолуния'} ${daysText(p.days)}`;
		}

		/* ---------- a free place in the hero ---------- */

		type Box = { x: number; y: number; w: number; h: number };
		const PAD = 22; // distance to the text, more than the parallax drift
		const DRIFT = 8;

		let roomy = false; // the hero got extra top padding to make room for the Moon
		function place(tries = 3) {
			if (roomy && tries === 3) {
				hero!.style.paddingTop = '';
				roomy = false;
			}
			const W = hero!.clientWidth;
			const H = hero!.clientHeight;
			const nav = document.querySelector<HTMLElement>('.nav');
			const top = (nav ? nav.offsetHeight : 0) + 8;
			const boxes: Box[] = [...hero!.querySelectorAll<HTMLElement>('.hero__name, .hero__lead, .hero__actions, .hero__scroll')].map(
				(el) => ({ x: el.offsetLeft, y: el.offsetTop, w: el.offsetWidth, h: el.offsetHeight }),
			);
			const sMax = Math.round(Math.min(132, Math.max(76, W * 0.085)));
			const prefer = { x: W * 0.8, y: H * 0.24 };
			for (let s = sMax; s >= 56; s -= 4) {
				let best: { x: number; y: number; d: number } | null = null;
				for (let y = top + DRIFT; y + s + DRIFT + 12 <= H; y += 6) {
					for (let x = 12 + DRIFT; x + s + DRIFT + 12 <= W; x += 6) {
						const free = boxes.every((b) => x + s + PAD <= b.x || x - PAD >= b.x + b.w || y + s + PAD <= b.y || y - PAD >= b.y + b.h);
						if (!free) continue;
						const d = Math.hypot(x + s / 2 - prefer.x, y + s / 2 - prefer.y);
						if (!best || d < best.d) best = { x, y, d };
					}
				}
				if (best) {
					root!.style.left = `${best.x}px`;
					root!.style.top = `${best.y}px`;
					root!.style.width = `${s}px`;
					root!.classList.add('is-placed');
					if (s !== size) {
						size = s;
						draw();
					}
					positionCard();
					return;
				}
			}
			// no room above the title (a short narrow phone): move the hero's text down a little and try again
			const title = hero!.querySelector<HTMLElement>('.hero__name');
			if (tries > 0 && title && W < 640) {
				hero!.style.paddingTop = `${Math.ceil(parseFloat(getComputedStyle(hero!).paddingTop) + top + DRIFT + 64 + PAD - title.offsetTop)}px`;
				roomy = true;
				place(tries - 1);
				return;
			}
			// still no room: no Moon rather than a Moon over the text
			root!.classList.remove('is-placed', 'is-open');
		}

		/** The caption under the Moon, kept inside the hero horizontally. */
		function positionCard() {
			const W = hero!.clientWidth;
			const left = root!.offsetLeft;
			const cw = card.offsetWidth;
			const want = size / 2 - cw / 2;
			const x = Math.min(W - 12 - cw - left, Math.max(12 - left, want));
			root!.style.setProperty('--card-x', `${Math.round(x)}px`);
		}

		/* ---------- caption: hover, tap, keyboard ---------- */

		let hover = false;
		let focus = false;
		let pinned = false;
		let open = false;
		const update = () => {
			const now = hover || focus || pinned;
			if (now === open) return;
			open = now;
			if (open) {
				phase = moonPhase();
				fillCard();
				positionCard();
				document.dispatchEvent(new CustomEvent('ig:moon'));
			}
			root!.classList.toggle('is-open', open);
			btn.setAttribute('aria-expanded', String(open));
		};
		const close = () => {
			hover = focus = pinned = false;
			update();
		};
		root.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') {
				hover = true;
				update();
			}
		});
		root.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse') {
				hover = false;
				update();
			}
		});
		btn.addEventListener('click', () => {
			// the first click (or tap) keeps the caption open, the next one closes it
			if (pinned) hover = focus = pinned = false;
			else pinned = true;
			update();
		});
		btn.addEventListener('focus', () => {
			if (btn.matches(':focus-visible')) {
				focus = true;
				update();
			}
		});
		btn.addEventListener('blur', () => {
			focus = false;
			pinned = false;
			update();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && open) close();
		});
		document.addEventListener('pointerdown', (e) => {
			if (open && !root.contains(e.target as Node)) close();
		});

		/* ---------- gentle drift with the sky's parallax ---------- */

		const target = { x: 0, y: 0 };
		const cur = { x: 0, y: 0 };
		let raf = 0;
		const tick = () => {
			cur.x += (target.x - cur.x) * 0.05;
			cur.y += (target.y - cur.y) * 0.05;
			drift.style.transform = `translate(${cur.x.toFixed(2)}px, ${cur.y.toFixed(2)}px)`;
			raf = Math.abs(target.x - cur.x) + Math.abs(target.y - cur.y) > 0.02 ? requestAnimationFrame(tick) : 0;
		};
		window.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse') return;
			target.x = (e.clientX / window.innerWidth - 0.5) * 2 * DRIFT;
			target.y = (e.clientY / window.innerHeight - 0.5) * 2 * DRIFT * 0.75;
			if (!raf) raf = requestAnimationFrame(tick);
		});

		/* ---------- start ---------- */

		fillCard();
		img.onload = draw;
		img.src = root.dataset.src!;
		place();
		document.fonts?.ready.then(place);
		let resizeTimer = 0;
		let lastW = window.innerWidth;
		let lastH = window.innerHeight;
		window.addEventListener('resize', () => {
			// phones change the height while scrolling (the address bar): only a real change of the window matters
			if (window.innerWidth === lastW && Math.abs(window.innerHeight - lastH) < 120) return;
			lastW = window.innerWidth;
			lastH = window.innerHeight;
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => place(), 150);
		});
		// the phase moves on slowly: redraw every ten minutes
		setInterval(() => {
			phase = moonPhase();
			draw();
			if (open) fillCard();
		}, 600000);
	}
</script>
