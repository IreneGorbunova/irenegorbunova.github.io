---
/**
 * «Лунная задача» — one problem about the Moon in every chapter (the author loves the Moon). In a chapter:
 *
 *   ## Лунная задача
 *
 *   <LunarTask>
 *
 *   The statement (markdown, formulas).
 *
 *   <details>
 *   <summary>Возможное решение</summary>
 *   …
 *   </details>
 *
 *   </LunarTask>
 *
 * The heading gets a crescent from textbook.css (`h2#лунная-задача`); the box adds a faint Moon in its corner.
 */
---

<div class="lunar">
	<svg class="lunar__moon" viewBox="0 0 100 100" aria-hidden="true">
		<circle class="lunar__disc" cx="50" cy="50" r="46" />
		<circle class="lunar__mare" cx="36" cy="34" r="13" />
		<circle class="lunar__mare" cx="58" cy="28" r="8" />
		<circle class="lunar__mare" cx="62" cy="56" r="11" />
		<circle class="lunar__mare" cx="40" cy="64" r="7" />
		<circle class="lunar__crater" cx="70" cy="76" r="4.5" />
		<circle class="lunar__crater" cx="24" cy="54" r="3.5" />
	</svg>
	<div class="lunar__body">
		<slot />
	</div>
</div>

<style>
	.lunar {
		position: relative;
		overflow: hidden;
		margin-top: 1rem;
		padding: 1rem 1.25rem 0.5rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 30%, var(--sl-color-gray-5));
		border-radius: 1rem;
		background: radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--sl-color-accent-high) 14%, transparent), transparent 22rem);
	}
	.lunar__moon {
		position: absolute;
		top: -2.25rem;
		right: -2.25rem;
		width: 8rem;
		height: 8rem;
		pointer-events: none;
	}
	.lunar__disc {
		fill: var(--sl-color-accent-high);
		opacity: 0.13;
	}
	.lunar__mare,
	.lunar__crater {
		fill: var(--sl-color-accent-high);
		opacity: 0.1;
	}
	.lunar__body {
		position: relative;
	}
	.lunar__body > :global(:first-child) {
		margin-top: 0;
		padding-right: 3.5rem;
	}
</style>
