---
/**
 * The chapter's star under the title. Its rays light as the student moves a model, goes through a derivation,
 * answers a question and (where the chapter has «Решите сами») solves three problems. See rays.ts.
 * A chapter of a section with a constellation passes the constellation as the slot; it replaces the star picture.
 * Hidden without JavaScript.
 */
import { PROBLEMS } from '../../data/problems/index.mjs';
import { LABEL, needOf, starSvg } from './rays';

const { entry } = Astro.locals.starlightRoute;
const slug = entry.id.split('/').pop()!;
const need = needOf(slug in PROBLEMS);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="cstar" data-cstar={entry.id} data-slug={slug} data-need={need.join('')} hidden>
	{Astro.slots.has('default') ? <slot /> : <svg class="cstar__svg" viewBox="-20 -20 40 40" aria-hidden="true" set:html={starSvg(need)} />}
	<p class="cstar__items">
		<span class="sr-only">Звезда главы:</span>
		{
			need.map((r, i) => (
				<>
					<span class="cstar__item" data-item={r}>
						{LABEL[r]}
						<span class="sr-only" data-sr>
							{' '}
							— ещё нет
						</span>
					</span>
					{i < need.length - 1 && <span aria-hidden="true"> · </span>}
				</>
			))
		}
	</p>
	<a class="cstar__link" href={`${base}uchebnik/nebo/`}>Моё небо</a>
</div>

<style is:global>
	.cstar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.7rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.cstar[hidden] {
		display: none;
	}
	.cstar__svg {
		flex: none;
		width: 2.5rem;
		height: 2.5rem;
		overflow: visible;
	}
	.cstar .ray {
		stroke: var(--sl-color-gray-5);
		stroke-width: 2.2;
		stroke-linecap: round;
		transition: stroke 0.4s;
	}
	.cstar .ray.is-lit {
		stroke: var(--sl-color-accent);
		filter: drop-shadow(0 0 2px var(--sl-color-accent));
	}
	.cstar .ray.is-new {
		animation: cstar-ray 1s ease-out;
	}
	.cstar .core {
		fill: var(--sl-color-gray-4);
		transition: fill 0.4s;
	}
	.cstar .core.is-lit {
		fill: var(--sl-color-accent-high);
	}
	.cstar.is-full .cstar__svg {
		animation: cstar-twinkle 3.2s ease-in-out infinite;
	}
	.cstar.is-full .core {
		fill: var(--sl-color-white);
		filter: drop-shadow(0 0 4px var(--sl-color-accent));
	}
	.cstar__items {
		margin: 0;
	}
	.cstar__item.is-lit {
		color: var(--sl-color-text-accent);
	}
	.cstar__link {
		color: var(--sl-color-text-accent);
	}
	@keyframes cstar-ray {
		0% {
			stroke-width: 5;
			filter: drop-shadow(0 0 8px var(--sl-color-accent));
		}
	}
	@keyframes cstar-twinkle {
		50% {
			transform: scale(1.12) rotate(8deg);
			filter: drop-shadow(0 0 6px var(--sl-color-accent));
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cstar .ray.is-new,
		.cstar.is-full .cstar__svg {
			animation: none;
		}
		.cstar .ray,
		.cstar .core {
			transition: none;
		}
	}
</style>

<script>
	import { load, save, TRAINER_GOAL, type Ray } from './rays';

	const root = document.querySelector<HTMLElement>('[data-cstar]');
	if (root) {
		const id = root.dataset.cstar!;
		const slug = root.dataset.slug!;
		const need = root.dataset.need!.split('') as Ray[];
		const content = document.querySelector<HTMLElement>('.sl-markdown-content');
		const done = new Set((load()[id] ?? '').split('').filter((r) => need.includes(r as Ray)) as Ray[]);

		const paint = (fresh?: Ray) => {
			for (const line of root.querySelectorAll<SVGElement>('.ray')) {
				const r = line.dataset.ray as Ray;
				line.classList.toggle('is-lit', done.has(r));
				if (r === fresh) line.classList.add('is-new');
			}
			root.querySelector('.core')?.classList.toggle('is-lit', done.size > 0);
			root.classList.toggle('is-full', done.size === need.length);
			for (const item of root.querySelectorAll<HTMLElement>('[data-item]')) {
				const lit = done.has(item.dataset.item as Ray);
				item.classList.toggle('is-lit', lit);
				item.querySelector('[data-sr]')!.textContent = lit ? ' — сделано' : ' — ещё нет';
			}
		};

		const light = (r: Ray) => {
			if (!need.includes(r) || done.has(r)) return;
			done.add(r);
			const all = load();
			all[id] = need.filter((x) => done.has(x)).join('');
			save(all);
			paint(r);
			document.dispatchEvent(new CustomEvent('ig:sky')); // the section's constellation repaints
		};

		root.hidden = false;
		paint();

		// m: the student touched a model (every model is a <figure class="… not-content">)
		const onModel = (e: Event) => {
			if ((e.target as Element | null)?.closest?.('figure.not-content')) light('m');
		};
		content?.addEventListener('pointerdown', onModel);
		content?.addEventListener('input', onModel);
		content?.addEventListener('keydown', (e) => {
			if (['Enter', ' '].includes(e.key) || e.key.startsWith('Arrow')) onModel(e);
		});
		// d: a derivation was opened to the last step (Derivation.astro)
		document.addEventListener('ig:derivation-done', () => light('d'));
		// q: a question was answered (every quiz marks the right option with .is-right)
		if (content) {
			new MutationObserver((list) => {
				if (list.some((m) => (m.target as Element).classList.contains('is-right'))) light('q');
			}).observe(content, { attributes: true, attributeFilter: ['class'], subtree: true });
		}
		// t: three problems solved in «Решите сами» (Trainer.astro)
		try {
			const solved = JSON.parse(localStorage.getItem('ig:trainer') ?? '{}')?.[slug]?.solved ?? 0;
			if (solved >= TRAINER_GOAL) light('t');
		} catch {
			/* storage off */
		}
		document.addEventListener('ig:trainer', (e) => {
			if ((e as CustomEvent<{ solved: number }>).detail.solved >= TRAINER_GOAL) light('t');
		});
	}
</script>
