---
/** The table of saturated-vapour density ρ₀(t), −10…30 °C, in three column pairs (rounded table values). */
import { RHO0, T_MIN } from './data';
const rows = 14;
const cols = 3;
const cell = (k: number) => (k < RHO0.length ? { t: T_MIN + k, r: RHO0[k] } : null);
const ru = (v: number) => v.toFixed(1).replace('.', ',');
const deg = (t: number) => (t < 0 ? `−${-t}` : String(t));
---

<div class="vsat not-content">
	<table class="vsat__table">
		<caption>Плотность насыщенного водяного пара <i>ρ</i><sub>0</sub> при разных температурах</caption>
		<thead>
			<tr>
				{[...Array(cols).keys()].map(() => (
					<>
						<th><i>t</i>, °C</th>
						<th><i>ρ</i><sub>0</sub>, г/м³</th>
					</>
				))}
			</tr>
		</thead>
		<tbody>
			{[...Array(rows).keys()].map((i) => (
				<tr>
					{[...Array(cols).keys()].map((j) => {
						const c = cell(j * rows + i);
						return c ? (
							<>
								<th>{deg(c.t)}</th>
								<td>{ru(c.r)}</td>
							</>
						) : (
							<>
								<th></th>
								<td></td>
							</>
						);
					})}
				</tr>
			))}
		</tbody>
	</table>
	<p class="vsat__note">Значения округлены до 0,1 г/м³. Ниже 0 °C — плотность пара, насыщенного над льдом.</p>
</div>

<style is:global>
	.vsat {
		margin-block: 1rem 1.5rem;
		overflow-x: auto;
	}
	.vsat i {
		font-family: var(--ig-font-math);
	}
	.vsat__table {
		display: table;
		width: 100%;
		max-width: 34rem;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
		text-align: center;
	}
	.vsat__table caption {
		margin-bottom: 0.4rem;
		font-weight: 600;
		color: var(--sl-color-white);
		text-align: left;
	}
	.vsat__table th,
	.vsat__table td {
		padding: 0.15rem 0.3rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.vsat__table thead th {
		font-size: var(--sl-text-xs);
		font-weight: 600;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.vsat__table tbody th {
		font-weight: 400;
		color: var(--sl-color-gray-3);
		background: var(--sl-color-gray-6);
	}
	.vsat__table td {
		color: var(--sl-color-white);
	}
	.vsat__note {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
