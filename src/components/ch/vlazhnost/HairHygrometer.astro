---
/**
 * A hair hygrometer: a defatted hair lengthens in moist air and turns a small axle with a long pointer.
 * The elongation is drawn to scale (about 2.5 % of the hair from dry to saturated air); the pointer magnifies it.
 */
const C = { x: 64, y: 150 }; // axle
const L = 120; // pointer length
const HAIR_TOP = 26;
const A0 = -60; // pointer angle at 0 %, degrees (0 = to the right)
const A1 = 60; // at 100 %
const marks = [0, 20, 40, 60, 80, 100];
const ang = (p: number) => ((A0 + ((A1 - A0) * p) / 100) * Math.PI) / 180;
const pt = (p: number, r: number) => [C.x + r * Math.cos(ang(p)), C.y + r * Math.sin(ang(p))];
const arc = (r: number) => {
	const [x0, y0] = pt(0, r);
	const [x1, y1] = pt(100, r);
	return `M${x0.toFixed(1)},${y0.toFixed(1)} A${r},${r} 0 0 1 ${x1.toFixed(1)},${y1.toFixed(1)}`;
};
---

<figure class="vhair not-content" data-vhair data-cx={C.x} data-cy={C.y} data-l={L} data-top={HAIR_TOP}>
	<svg class="vhair__svg" viewBox="0 0 250 300" aria-hidden="true">
		<rect class="vhair__frame" x="8" y="6" width="234" height="288" rx="10"></rect>
		<rect class="vhair__clamp" x="52" y="16" width="20" height="10" rx="2"></rect>
		<path class="vhair__scale" d={arc(L + 6)}></path>
		{
			[...Array(21).keys()].map((i) => {
				const p = i * 5;
				const [x0, y0] = pt(p, L + 6);
				const [x1, y1] = pt(p, L + (p % 20 === 0 ? 16 : 11));
				return <line class="vhair__tick" x1={x0} y1={y0} x2={x1} y2={y1} />;
			})
		}
		{
			marks.map((p) => {
				const [x, y] = pt(p, L + 28);
				return (
					<text class="vhair__num" x={x} y={y + 4} text-anchor="middle">
						{p}
					</text>
				);
			})
		}
		<text class="vhair__unit" x="226" y="34" text-anchor="middle">%</text>
		<line class="vhair__hair" x1={C.x - 2} y1={HAIR_TOP} x2={C.x - 2} y2={C.y}></line>
		<line class="vhair__thread" x1={C.x + 2} x2={C.x + 2} y1={C.y} data-thread></line>
		<rect class="vhair__weight" x={C.x - 4} width="12" height="16" rx="2" data-weight></rect>
		<g data-pointer>
			<line class="vhair__pointer" x1="-14" y1="0" x2={L} y2="0"></line>
			<circle class="vhair__axle" r="4"></circle>
		</g>
		<text class="vhair__label" x="54" y="90" text-anchor="end">волос</text>
	</svg>
	<div class="vhair__side">
		<label class="vhair__slider">
			<span>Относительная влажность воздуха</span>
			<output data-out></output>
			<input type="range" min="0" max="100" step="5" value="40" data-in />
		</label>
		<p class="vhair__note" data-note></p>
	</div>
</figure>

<style is:global>
	.vhair {
		display: grid;
		grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
		gap: 1.25rem;
		align-items: center;
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vhair__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.vhair__svg text {
		font-family: var(--__sl-font);
	}
	.vhair__frame {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	.vhair__clamp,
	.vhair__weight {
		fill: var(--sl-color-gray-4);
	}
	.vhair__scale {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.vhair__tick {
		stroke: var(--sl-color-gray-3);
	}
	.vhair__num,
	.vhair__unit,
	.vhair__label {
		fill: var(--sl-color-gray-3);
		font-size: 13px;
	}
	.vhair__hair {
		stroke: var(--ig-v);
		stroke-width: 1.4;
	}
	.vhair__thread {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.vhair__pointer {
		stroke: var(--ig-vy);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.vhair__axle {
		fill: var(--sl-color-gray-2);
	}
	.vhair__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.vhair__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.vhair__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--ig-vy);
	}
	.vhair__note {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	@media (max-width: 40rem) {
		.vhair {
			grid-template-columns: 1fr;
			padding: 0.75rem;
		}
		.vhair__svg {
			max-width: 15rem;
			margin-inline: auto;
		}
	}
</style>

<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
	for (const root of document.querySelectorAll<HTMLElement>('[data-vhair]')) {
		const cx = Number(root.dataset.cx);
		const cy = Number(root.dataset.cy);
		const hair = cy - Number(root.dataset.top); // hair length on the drawing, px
		const input = root.querySelector<HTMLInputElement>('[data-in]')!;
		const pointer = root.querySelector<SVGGElement>('[data-pointer]')!;
		const weight = root.querySelector<SVGRectElement>('[data-weight]')!;
		const thread = root.querySelector<SVGLineElement>('[data-thread]')!;
		// From dry to saturated air the hair grows by about 2.5 %, here 3.5 px; this turns the pointer by 120°.
		const E = 0.025 * hair;
		let shown = Number(input.value);
		let goal = shown;
		let raf = 0;
		const place = (p: number) => {
			const e = (E * p) / 100; // elongation, px
			const deg = -60 + (120 * p) / 100;
			pointer.setAttribute('transform', `translate(${cx},${cy}) rotate(${deg.toFixed(2)})`);
			const wy = cy + 70 + e;
			weight.setAttribute('y', wy.toFixed(2));
			thread.setAttribute('y2', wy.toFixed(2));
		};
		const tick = () => {
			shown += (goal - shown) * (reduce.matches ? 1 : 0.12);
			if (Math.abs(goal - shown) < 0.05) shown = goal;
			place(shown);
			raf = shown === goal ? 0 : requestAnimationFrame(tick);
		};
		const update = () => {
			goal = Number(input.value);
			root.querySelector<HTMLOutputElement>('[data-out]')!.value = `${goal} %`;
			const e = (2.5 * goal) / 100;
			root.querySelector<HTMLElement>('[data-note]')!.innerHTML =
				`Волос длиной 20 см стал длиннее примерно на ${(e * 2).toLocaleString('ru-RU', { maximumFractionDigits: 1 })} мм, чем в совсем сухом воздухе. Такое удлинение глазом не заметно, а стрелка, насаженная на тонкую ось, увеличивает его во много раз.`;
			if (!raf) raf = requestAnimationFrame(tick);
		};
		input.addEventListener('input', update);
		place(shown);
		update();
	}
</script>
