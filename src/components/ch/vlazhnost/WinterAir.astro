---
/**
 * Why rooms are dry in winter: outdoor air with a given t and φ is warmed up in the room. The amount of vapour
 * in 1 m³ stays the same, ρ₀ grows, φ falls. A live two-line calculation with the rounded table values.
 */
---

<figure class="vwin not-content" data-vwin>
	<div class="vwin__cards">
		<div class="vwin__card vwin__card--out">
			<p class="vwin__where">На улице</p>
			<p class="vwin__big"><span data-phi-out></span></p>
			<div class="vwin__bar"><span data-bar-out></span></div>
			<p class="vwin__small" data-out-desc></p>
		</div>
		<div class="vwin__arrow" aria-hidden="true">
			<svg viewBox="0 0 60 30"><path d="M4,15 H50 M40,6 L52,15 L40,24"></path></svg>
			<span>воздух нагрели</span>
		</div>
		<div class="vwin__card vwin__card--in">
			<p class="vwin__where">В комнате</p>
			<p class="vwin__big"><span data-phi-in></span></p>
			<div class="vwin__bar"><span data-bar-in></span></div>
			<p class="vwin__small" data-in-desc></p>
		</div>
	</div>
	<div class="vwin__calc" data-calc></div>
	<div class="vwin__controls">
		<label class="vwin__slider">
			<span>Температура на улице</span>
			<output data-o-tout></output>
			<input type="range" min="-10" max="10" step="1" value="-10" data-i-tout />
		</label>
		<label class="vwin__slider">
			<span>Влажность на улице</span>
			<output data-o-phi></output>
			<input type="range" min="50" max="100" step="5" value="80" data-i-phi />
		</label>
		<label class="vwin__slider">
			<span>Температура в комнате</span>
			<output data-o-tin></output>
			<input type="range" min="16" max="26" step="1" value="20" data-i-tin />
		</label>
	</div>
	<p class="vwin__live" data-live aria-live="polite"></p>
</figure>

<style is:global>
	.vwin {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vwin__cards {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 0.75rem;
		align-items: center;
	}
	.vwin__card {
		padding: 0.7rem 0.9rem;
		border-radius: 0.8rem;
		background: var(--sl-color-gray-6);
	}
	.vwin__card p {
		margin: 0;
	}
	.vwin__where {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.vwin__big {
		font-size: 2.2rem;
		line-height: 1.2;
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.vwin__card--out .vwin__big {
		color: var(--ig-vx);
	}
	.vwin__card--in .vwin__big {
		color: var(--ig-v);
	}
	.vwin__bar {
		height: 0.5rem;
		margin: 0.3rem 0 0.4rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		overflow: hidden;
	}
	.vwin__bar span {
		display: block;
		height: 100%;
		border-radius: 999px;
		background: var(--ig-vx);
		transition: width 0.35s ease-out;
	}
	.vwin__card--in .vwin__bar span {
		background: var(--ig-v);
	}
	.vwin__small {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.vwin__arrow {
		display: grid;
		justify-items: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.vwin__arrow svg {
		width: 3.5rem;
	}
	.vwin__arrow path {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.vwin__calc {
		margin-top: 0.75rem;
		padding: 0.1rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.vwin__calc .katex {
		font-size: 1.08em;
	}
	.vwin__controls {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem 1.25rem;
		margin-top: 0.9rem;
	}
	.vwin__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.vwin__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.vwin__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.vwin__live {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	@media (max-width: 40rem) {
		.vwin {
			padding: 0.75rem;
		}
		.vwin__cards {
			grid-template-columns: 1fr;
		}
		.vwin__arrow {
			grid-auto-flow: column;
			gap: 0.5rem;
			align-items: center;
		}
		.vwin__arrow svg {
			width: 2rem;
			transform: rotate(90deg);
		}
		.vwin__controls {
			grid-template-columns: 1fr;
		}
		.vwin__calc .katex {
			font-size: 0.98em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.vwin__bar span {
			transition: none;
		}
	}
</style>

<script>
	import { rho0, fixed, tex, renderTex } from './vl';

	for (const root of document.querySelectorAll<HTMLElement>('[data-vwin]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const iOut = $<HTMLInputElement>('[data-i-tout]');
		const iPhi = $<HTMLInputElement>('[data-i-phi]');
		const iIn = $<HTMLInputElement>('[data-i-tin]');
		const deg = (t: number) => `${t < 0 ? '−' : ''}${Math.abs(t)} °C`;
		const degTex = (t: number) => `${t}\\,^\\circ\\text{C}`;

		const draw = () => {
			const tOut = Number(iOut.value);
			const phiOut = Number(iPhi.value);
			const tIn = Number(iIn.value);
			const r0o = rho0(tOut);
			const r0i = rho0(tIn);
			// Each line uses the rounded number shown in the line before, as in a pupil's notebook.
			const rho = Math.round(((phiOut / 100) * r0o) * 10) / 10;
			const phiIn = Math.round((rho / r0i) * 100);
			const exact1 = Math.abs((phiOut / 100) * r0o - rho) < 1e-9;
			const exact2 = Math.abs((rho / r0i) * 100 - phiIn) < 1e-9;

			$('[data-phi-out]').textContent = `${phiOut} %`;
			$('[data-phi-in]').textContent = `${phiIn} %`;
			$<HTMLElement>('[data-bar-out]').style.width = `${phiOut}%`;
			$<HTMLElement>('[data-bar-in]').style.width = `${phiIn}%`;
			$('[data-out-desc]').textContent = `${deg(tOut)}, в 1 м³ ${fixed(rho)} г пара`;
			$('[data-in-desc]').textContent = `${deg(tIn)}, в 1 м³ те же ${fixed(rho)} г пара`;
			$<HTMLOutputElement>('[data-o-tout]').value = deg(tOut);
			$<HTMLOutputElement>('[data-o-phi]').value = `${phiOut} %`;
			$<HTMLOutputElement>('[data-o-tin]').value = deg(tIn);
			renderTex(
				$('[data-calc]'),
				`\\begin{aligned}
				\\rho &= \\frac{\\varphi_{\\text{ул}}}{100\\,\\%}\\cdot \\rho_0(${degTex(tOut)}) \\\\ &= ${tex(fixed(phiOut / 100, 2))}\\cdot ${tex(fixed(r0o))}~\\text{г/м}^3 ${exact1 ? '=' : '\\approx'} ${tex(fixed(rho))}~\\text{г/м}^3,\\\\
				\\varphi_{\\text{к}} &= \\frac{\\rho}{\\rho_0(${degTex(tIn)})}\\cdot 100\\,\\% \\\\ &= \\frac{${tex(fixed(rho))}}{${tex(fixed(r0i))}}\\cdot 100\\,\\% ${exact2 ? '=' : '\\approx'} ${phiIn}\\,\\%.
				\\end{aligned}`,
			);
			$('[data-live]').innerHTML =
				phiIn < 30
					? `Пара в 1 м³ столько же, сколько было на улице, а насыщенный пар при ${deg(tIn)} имеет плотность ${fixed(r0i)} г/м³ — во много раз больше. Поэтому в комнате очень сухо.`
					: phiIn <= 60
						? 'Влажность в комнате ниже, чем на улице, но ещё в пределах нормы.'
						: 'Влажность в комнате высокая.';
		};
		[iOut, iPhi, iIn].forEach((i) => i.addEventListener('input', draw));
		draw();
	}
</script>
