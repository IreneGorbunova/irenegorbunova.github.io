	}
	.vpis__thermo line {
		stroke: var(--sl-color-gray-3);
	}
	.vpis__thermo text {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
	}
	.vpis__thermo .vpis__tval {
		fill: var(--ig-vy);
		font-size: 14px;
		font-weight: 700;
	}

	.vpis__side {
		display: grid;
		gap: 0.7rem;
		align-content: center;
	}
	.vpis__meter {
