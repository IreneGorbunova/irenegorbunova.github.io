	}
	.vpis__m {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.vpis__tube {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.vpis__liquid,
	.vpis__bulb {
