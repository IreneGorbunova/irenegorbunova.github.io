---
/**
 * «Пар под поршнем»: 7,7 г of water vapour (no air) in a cylinder of up to 1 m³ under a piston. Cooling (ρ₀ falls)
 * or compressing (ρ = m/V grows) makes the vapour saturated; past that point the excess condenses into drops on the
 * walls and the bottom, and the vapour density stays ρ₀(t). Heating or expanding evaporates the drops again.
 * Each dot is 0,1 g of vapour: a condensing dot flies into a drop, an evaporating one leaves a drop; while there is
 * water, dots keep leaving and returning at the same rate (dynamic equilibrium). ρ₀ comes from the chapter's table
 * (data.ts), the temperature is kept constant while the volume changes (slow compression).
 */
const BOT = 270; // inner bottom of the cylinder
const thY = (t: number) => 222 - 6 * t; // thermometer scale, 0…30 °C
---

<figure class="vpis not-content" data-vpis>
	<div class="vpis__top">
		<svg class="vpis__scene" viewBox="0 0 300 292" aria-hidden="true" data-scene>
			<rect class="vpis__glass" x="50" y="22" width="160" height={BOT - 22}></rect>
			<rect class="vpis__gas" x="50" width="160" data-gas></rect>
			<g data-drops></g>
			<g data-mols></g>
			<path class="vpis__wall" d={`M48,20 V${BOT + 2} H212 V20`}></path>
			<g class="vpis__piston" data-piston>
				<line class="vpis__rod" x1="130" x2="130" data-rod></line>
				<rect class="vpis__handle" x="108" width="44" height="9" rx="4.5" data-handle></rect>
				<rect class="vpis__head" x="50.5" width="159" height="12" rx="2" data-head></rect>
				<rect class="vpis__grip" x="44" width="172" height="52" data-grip></rect>
			</g>
			<text class="vpis__label" x="140" data-plabel>поршень</text>
			<g class="vpis__dim">
				<line x1="31" x2="31" y2={BOT} data-dim></line>
				<path data-dimhead></path>
				<text x="19" text-anchor="middle" data-dimtext><tspan class="vpis__m">V</tspan></text>
			</g>
			<text class="vpis__label vpis__wlabel" x="130" y="287" text-anchor="middle" data-wlabel>капли воды</text>
			<g class="vpis__thermo">
				<rect class="vpis__tube" x="252" y="36" width="12" height="196" rx="6"></rect>
				<rect class="vpis__liquid" x="255" width="6" rx="3" data-tliq></rect>
				<circle class="vpis__bulb" cx="258" cy="240" r="10"></circle>
				{[0, 10, 20, 30].map((t) => (
					<g>
						<line x1="264" x2="270" y1={thY(t)} y2={thY(t)} />
						<text x="274" y={thY(t) + 4}>{t}</text>
					</g>
				))}
				<text class="vpis__tval" x="258" y="270" text-anchor="middle" data-tval></text>
			</g>
		</svg>

		<div class="vpis__side">
			<div class="vpis__meter">
				<div class="vpis__meter-head">
					<span>Плотность пара: <i>ρ</i> = <b data-rho>—</b></span>
					<span class="vpis__state" data-state>—</span>
				</div>
				<div class="vpis__bar"><span class="vpis__bar-fill" data-rho-bar></span><span class="vpis__bar-max" data-rho0-bar></span></div>
				<div class="vpis__meter-foot">насыщенный пар при этой температуре: <span class="nw"><i>ρ</i><sub>0</sub> = <span data-rho0>—</span></span></div>
			</div>
			<div class="vpis__formula" data-formula></div>
			<dl class="vpis__stats">
				<div><dt>Температура <i>t</i></dt><dd data-s-t></dd></div>
				<div><dt>Объём <i>V</i></dt><dd data-s-v></dd></div>
				<div><dt>Пар <i>m</i></dt><dd data-s-m></dd></div>
				<div><dt>Вода в каплях</dt><dd data-s-w></dd></div>
			</dl>
			<p class="vpis__live" data-live aria-live="polite"></p>
		</div>
	</div>

	<div class="vpis__controls">
		<label class="vpis__slider vpis__slider--t">
			<span>Температура <i>t</i></span>
			<output data-o-t></output>
			<input type="range" min="0" max="30" step="1" value="18" data-i-t />
		</label>
		<label class="vpis__slider vpis__slider--v">
			<span>Объём <i>V</i></span>
			<output data-o-v></output>
			<input type="range" min="0.2" max="1" step="0.05" value="1" data-i-v />
		</label>
		<div class="vpis__buttons">
			<button type="button" class="vpis__btn" data-reset>Сначала</button>
		</div>
	</div>

	<figcaption class="vpis__caption">
		<span class="vpis__key vpis__key--mol"></span>0,1 г водяного пара
		<span class="vpis__key vpis__key--drop"></span>капли воды (нарисованы крупнее, чем на самом деле). В цилиндре 7,7&nbsp;г воды и пара вместе, воздуха нет. Поршень двигают медленно, и температура пара не меняется: её задаёт ползунок. Значения <i>ρ</i><sub>0</sub> взяты из таблицы.
	</figcaption>
</figure>

<style is:global>
