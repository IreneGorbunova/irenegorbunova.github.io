---
/**
 * Main model: 1 m³ of air with water vapour. Air temperature t, the mass of water per cubic metre and the
 * temperature of a cold glass are set by sliders or by dragging the state point on the ρ₀(t) graph.
 * Vapour density never exceeds ρ₀(t): the excess becomes droplets (fog); a glass colder than the dew point
 * gets dew. ρ₀ comes from the rounded table (data.ts), linear between whole degrees.
 */
import { RHO0, T_MIN } from './data';

// Graph geometry: t from 0 to 30 °C, ρ from 0 to 32 g/m³.
const G = { X0: 54, Y0: 270, PW: 360, PH: 236, TMAX: 30, RMAX: 32 };
const gx = (t: number) => G.X0 + (t / G.TMAX) * G.PW;
const gy = (r: number) => G.Y0 - (r / G.RMAX) * G.PH;
const pts = Array.from({ length: 31 }, (_, t) => [gx(t), gy(RHO0[t - T_MIN])] as const);
const curve = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const above = `${curve} L${gx(30)},${gy(G.RMAX)} L${gx(0)},${gy(G.RMAX)} Z`;
const below = `${curve} L${gx(30)},${G.Y0} L${gx(0)},${G.Y0} Z`;
const tTicks = [0, 5, 10, 15, 20, 25, 30];
const rTicks = [5, 10, 15, 20, 25, 30];
// Scene: the box is 1 m³ of air; the thermometer scale goes from 0 to 30 °C.
const thY = (t: number) => 214 - t * 5;
---

<figure class="vhum not-content" data-vhum>
	<div class="vhum__views">
		<svg class="vhum__scene" viewBox="0 0 300 270" aria-hidden="true" data-scene>
			<text class="vhum__cap" x="119" y="18" text-anchor="middle">1 м³ воздуха</text>
			<rect class="vhum__box" x="14" y="28" width="210" height="210" rx="6"></rect>
			<g data-mols></g>
			<rect class="vhum__haze" x="15" y="29" width="208" height="208" rx="5" opacity="0" data-haze></rect>
			<g data-fog></g>
			<g class="vhum__glass">
				<path class="vhum__water" d="M155.6,186 L188.4,186 L186,236 L158,236 Z" data-gwater></path>
				<path class="vhum__glass-wall" d="M150,168 L194,168 L189,238 L155,238 Z"></path>
				<g data-drops></g>
			</g>
			<text class="vhum__small" x="172" y="256" text-anchor="middle" data-glabel>стакан</text>
			<g class="vhum__thermo">
				<rect class="vhum__tube" x="257" y="44" width="12" height="180" rx="6"></rect>
				<rect class="vhum__liquid" x="260" width="6" rx="3" data-tliq></rect>
				<circle class="vhum__bulb" cx="263" cy="232" r="10"></circle>
				{[0, 10, 20, 30].map((t) => (
					<g>
						<line x1="269" x2="275" y1={thY(t)} y2={thY(t)} />
						<text x="279" y={thY(t) + 4}>{t}</text>
					</g>
				))}
				<text class="vhum__small" x="263" y="256" text-anchor="middle">°C</text>
			</g>
		</svg>

		<svg class="vhum__graph" viewBox="0 0 440 310" data-graph>
			<path class="vhum__above" d={above}></path>
			<path class="vhum__below" d={below}></path>
			<g class="vhum__grid">
				{tTicks.slice(1).map((t) => <line x1={gx(t)} x2={gx(t)} y1={G.Y0} y2={gy(G.RMAX)} />)}
				{rTicks.map((r) => <line x1={G.X0} x2={gx(G.TMAX)} y1={gy(r)} y2={gy(r)} />)}
			</g>
			<line class="vhum__axis" x1={G.X0} y1={G.Y0} x2={gx(G.TMAX) + 8} y2={G.Y0}></line>
			<line class="vhum__axis" x1={G.X0} y1={G.Y0} x2={G.X0} y2={gy(G.RMAX) - 6}></line>
			<g class="vhum__ticks">
				{tTicks.map((t) => <text x={gx(t)} y={G.Y0 + 20} text-anchor="middle">{t}</text>)}
				{rTicks.map((r) => <text x={G.X0 - 8} y={gy(r) + 5} text-anchor="end">{r}</text>)}
				<text x={gx(G.TMAX) + 10} y={G.Y0 + 36} text-anchor="end"><tspan class="vhum__m">t</tspan>, °C</text>
				<text x={G.X0 - 8} y={gy(G.RMAX) - 12} text-anchor="start"><tspan class="vhum__m">ρ</tspan>, г/м³</text>
			</g>
			<text class="vhum__zone" x={gx(7)} y={gy(23)} text-anchor="middle">пар конденсируется:</text>
			<text class="vhum__zone" x={gx(7)} y={gy(23) + 18} text-anchor="middle">туман, роса</text>
			<text class="vhum__zone" x={gx(21)} y={gy(4)} text-anchor="middle">пар ненасыщенный</text>
			<path class="vhum__curve" d={curve}></path>
			<text class="vhum__curve-name" x={gx(22.6)} y={gy(27.5)} text-anchor="end">насыщенный пар <tspan class="vhum__m">ρ</tspan><tspan class="vhum__sub" dy="4">0</tspan></text>

			<line class="vhum__gtick" data-gline></line>
			<path class="vhum__gmark" data-gmark></path>
			<text class="vhum__gtext" text-anchor="middle" data-gtext>стакан</text>
			<line class="vhum__guide" data-vline></line>
			<line class="vhum__gap" data-gap></line>
			<line class="vhum__dew" data-dh></line>
			<line class="vhum__dew" data-dv></line>
			<circle class="vhum__dewpt" r="5" data-dpt></circle>
			<text class="vhum__dewtext" text-anchor="middle" data-dtext><tspan class="vhum__m">t</tspan><tspan class="vhum__sub" dy="4">р</tspan></text>
			<circle class="vhum__sat" r="6" data-sat></circle>
			<circle class="vhum__ghost" r="7" data-ghost></circle>
			<line class="vhum__drop" data-dropline></line>
			<rect class="vhum__hit" x={G.X0} y={gy(G.RMAX)} width={G.PW} height={G.PH} data-hit></rect>
			<g class="vhum__pt" tabindex="0" role="slider" aria-label="Состояние воздуха: стрелки влево-вправо меняют температуру, вверх-вниз — количество пара" data-pt>
				<circle class="vhum__pt-halo" r="15"></circle>
				<circle class="vhum__pt-core" r="8"></circle>
			</g>
		</svg>
	</div>

	<div class="vhum__controls">
		<label class="vhum__slider vhum__slider--t">
			<span>Температура воздуха <i>t</i></span>
			<output data-o-t></output>
			<input type="range" min="0" max="30" step="1" value="22" data-i-t />
		</label>
		<label class="vhum__slider vhum__slider--w">
			<span>Воды в 1 м³</span>
			<output data-o-w></output>
			<input type="range" min="4.8" max="30.4" step="0.1" value="10" data-i-w />
		</label>
		<label class="vhum__slider vhum__slider--g">
			<span>Температура стакана</span>
			<output data-o-g></output>
			<input type="range" min="0" max="30" step="1" value="6" data-i-g />
		</label>
		<div class="vhum__buttons">
			<button type="button" class="vhum__btn vhum__btn--primary" data-night>Ночь: остудить воздух</button>
			<button type="button" class="vhum__btn" data-reset>Сначала</button>
		</div>
	</div>
	<p class="vhum__live" data-live aria-live="polite"></p>

	<div class="vhum__meter" aria-hidden="true">
		<div class="vhum__bar">
			<span class="vhum__zone-dry"></span><span class="vhum__zone-ok"></span><span class="vhum__zone-wet"></span>
			<span class="vhum__needle" data-needle></span>
		</div>
		<div class="vhum__scale">
			<span>0 %</span><span class="vhum__scale-ok">40–60 % — комфортно</span><span>100 %</span>
		</div>
	</div>

	<div class="vhum__formula" data-formula></div>

	<dl class="vhum__stats">
		<div><dt>Пар в 1 м³: <i>ρ</i></dt><dd data-s-rho></dd></div>
		<div><dt>Насыщенный пар: <i>ρ</i><sub>0</sub></dt><dd data-s-rho0></dd></div>
		<div><dt>Точка росы <i>t</i><sub>р</sub></dt><dd data-s-dew></dd></div>
		<div><dt>Капельки в 1 м³</dt><dd data-s-fog></dd></div>
	</dl>

	<figcaption class="vhum__legend">
		<span class="vhum__key vhum__key--pt"></span>состояние воздуха
		<span class="vhum__key vhum__key--sat"></span>насыщенный пар при той же температуре
		<span class="vhum__key vhum__key--dew"></span>точка росы. «Воды в 1 м³» — это пар вместе с капельками тумана. Значения <i>ρ</i><sub>0</sub> взяты из таблицы (округлены до <span class="nw">0,1 г/м³</span>).
	</figcaption>
</figure>

<style is:global>
	.vhum {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vhum i {
		font-family: var(--ig-font-math);
	}
	.vhum__views {
		display: grid;
		grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
	}
	.vhum__views svg {
		display: block;
		width: 100%;
		height: auto;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}
	.vhum svg text {
		font-family: var(--__sl-font);
	}
	.vhum__cap {
		fill: var(--sl-color-gray-2);
		font-size: 14px;
	}
	.vhum__small {
		fill: var(--sl-color-gray-3);
		font-size: 12.5px;
	}
	.vhum__box {
		fill: color-mix(in srgb, var(--ig-vx) 5%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
		stroke-dasharray: 7 5;
	}
	.vhum__mol {
		fill: var(--ig-vx);
	}
	.vhum__haze {
		fill: var(--sl-color-gray-3);
		pointer-events: none;
	}
	.vhum__fogdrop {
		fill: var(--sl-color-gray-2);
	}
	.vhum__water {
		fill: color-mix(in srgb, var(--ig-vx) 40%, transparent);
	}
	.vhum__glass-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 10%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.vhum__dropc {
		fill: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-white));
		stroke: var(--ig-vx);
		stroke-width: 0.8;
		transition: r 0.6s ease-out;
	}
	.vhum__tube {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.vhum__liquid,
	.vhum__bulb {
		fill: var(--ig-vy);
	}
	.vhum__thermo line {
		stroke: var(--sl-color-gray-3);
	}
	.vhum__thermo text {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
	}

	.vhum__grid line {
		stroke: var(--sl-color-gray-5);
	}
	.vhum__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.vhum__ticks text {
		fill: var(--sl-color-gray-3);
		font-size: 14px;
	}
	.vhum__m {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.vhum__sub {
		font-size: 0.72em;
	}
	.vhum__above {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 16%, transparent);
	}
	.vhum__below {
		fill: color-mix(in srgb, var(--ig-vx) 7%, transparent);
	}
	.vhum__zone {
		fill: var(--sl-color-gray-3);
		font-size: 13.5px;
	}
	.vhum__curve {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.vhum__curve-name {
		fill: var(--ig-vx);
		font-size: 14px;
	}
	.vhum__guide {
		stroke: var(--ig-v);
		stroke-width: 1.2;
		stroke-dasharray: 3 4;
	}
	.vhum__gap {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-dasharray: 2 3;
	}
	.vhum__dew {
		stroke: var(--ig-vy);
		stroke-width: 1.6;
		stroke-dasharray: 5 4;
	}
	.vhum__dewpt {
		fill: var(--ig-vy);
	}
	.vhum__dewtext {
		fill: var(--ig-vy);
		font-size: 16px;
	}
	.vhum__sat {
		fill: var(--ig-surface);
		stroke: var(--ig-vx);
		stroke-width: 2.5;
	}
	.vhum__ghost {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
		stroke-dasharray: 3 3;
	}
	.vhum__drop {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.vhum__gtick {
		stroke: var(--ig-vx);
		stroke-width: 1.2;
		stroke-dasharray: 2 4;
		opacity: 0.8;
	}
	.vhum__gmark {
		fill: var(--ig-vx);
	}
	.vhum__gtext {
		fill: var(--ig-vx);
		font-size: 12px;
	}
	.vhum__hit {
		fill: transparent;
		cursor: crosshair;
	}
	.vhum__pt {
		cursor: grab;
		outline: none;
	}
	.vhum__pt-core {
		fill: var(--ig-v);
		stroke: var(--sl-color-black);
		stroke-width: 1.5;
	}
	.vhum__pt-halo {
		fill: var(--ig-v);
		opacity: 0.22;
	}
	.vhum__pt:focus-visible .vhum__pt-halo {
		opacity: 0.5;
	}

	.vhum__meter {
		margin-top: 0.9rem;
	}
	.vhum__bar {
		position: relative;
		display: grid;
		grid-template-columns: 40fr 20fr 40fr;
		height: 0.8rem;
		border-radius: 999px;
		overflow: visible;
	}
	.vhum__bar > span:not(.vhum__needle) {
		height: 100%;
	}
	.vhum__zone-dry {
		background: color-mix(in srgb, var(--ig-v) 45%, transparent);
		border-radius: 999px 0 0 999px;
	}
	.vhum__zone-ok {
		background: color-mix(in srgb, var(--sl-color-green) 65%, transparent);
	}
	.vhum__zone-wet {
		background: color-mix(in srgb, var(--ig-vx) 50%, transparent);
		border-radius: 0 999px 999px 0;
	}
	.vhum__needle {
		position: absolute;
		top: -0.35rem;
		width: 0.3rem;
		height: 1.5rem;
		margin-left: -0.15rem;
		border-radius: 0.2rem;
		background: var(--sl-color-white);
		box-shadow: 0 0 0 2px var(--ig-surface);
		transition: left 0.25s ease-out;
	}
	.vhum__scale {
		display: flex;
		justify-content: space-between;
		margin-top: 0.35rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.vhum__scale-ok {
		color: var(--sl-color-green);
	}
	.vhum__formula {
		min-height: 4rem;
		margin: 0.6rem 0 0;
		padding: 0.1rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.vhum__formula .katex {
		font-size: 1.2em;
	}
	.vhum .vl-phi {
		color: var(--ig-v);
	}
	.vhum .vl-rho0 {
		color: var(--ig-vx);
	}
	.vhum__stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0.75rem 0 0;
	}
	.vhum__stats div {
		padding: 0.4rem 0.6rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
	}
	.vhum__stats dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.vhum__stats dd {
		margin: 0;
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.vhum__controls {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem 1.25rem;
		margin-top: 0.9rem;
		align-items: end;
	}
	.vhum__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.vhum__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.vhum__slider input {
		grid-column: 1 / -1;
		width: 100%;
	}
	.vhum__slider--t input {
		accent-color: var(--ig-vy);
	}
	.vhum__slider--w input {
		accent-color: var(--ig-v);
	}
	.vhum__slider--g input {
		accent-color: var(--ig-vx);
	}
	.vhum__buttons {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.vhum__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.vhum__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.vhum__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.vhum__live {
		min-height: 3em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	.vhum__legend {
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.vhum__key {
		display: inline-block;
		width: 0.7rem;
		height: 0.7rem;
		margin: 0 0.3rem 0 0.6rem;
		border-radius: 50%;
		vertical-align: -0.05rem;
	}
	.vhum__key:first-child {
		margin-left: 0;
	}
	.vhum__key--pt {
		background: var(--ig-v);
	}
	.vhum__key--sat {
		border: 2.5px solid var(--ig-vx);
	}
	.vhum__key--dew {
		background: var(--ig-vy);
	}
	@media (max-width: 50rem) {
		.vhum__views {
			grid-template-columns: 1fr;
		}
		.vhum__scene {
			max-width: 21rem;
			margin-inline: auto;
		}
		.vhum__stats {
			grid-template-columns: 1fr 1fr;
		}
		.vhum__controls {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 30rem) {
		.vhum {
			padding: 0.75rem;
		}
		.vhum__formula .katex {
			font-size: 1.02em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.vhum__needle,
		.vhum__dropc {
			transition: none;
		}
	}
</style>

<script>
	import { rho0, dewPoint, fixed, ru, tex, renderTex, clamp } from './vl';

	const NS = 'http://www.w3.org/2000/svg';
	const G = { X0: 54, Y0: 270, PW: 360, PH: 236, TMAX: 30, RMAX: 32 };
	const gx = (t: number) => G.X0 + (t / G.TMAX) * G.PW;
	const gy = (r: number) => G.Y0 - (r / G.RMAX) * G.PH;
	const BOX = { x0: 18, y0: 32, x1: 220, y1: 234 };
	const W_MIN = 4.8;
	const W_MAX = 30.4;
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

	const set = (el: Element, attrs: Record<string, string | number>) => {
		for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
	};
	const circle = (parent: Element, cls: string) => {
		const c = document.createElementNS(NS, 'circle');
		c.setAttribute('class', cls);
		parent.append(c);
		return c;
	};
	// A tiny deterministic random generator: the same picture on every load.
	const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

	for (const root of document.querySelectorAll<HTMLElement>('[data-vhum]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const rand = rng(12345);
		const iT = $<HTMLInputElement>('[data-i-t]');
		const iW = $<HTMLInputElement>('[data-i-w]');
		const iG = $<HTMLInputElement>('[data-i-g]');
		const night = $<HTMLButtonElement>('[data-night]');
		const live = $<HTMLElement>('[data-live]');
		const formula = $<HTMLElement>('[data-formula]');
		const graph = $<SVGSVGElement>('[data-graph]');
		const pt = $<SVGGElement>('[data-pt]');

		const s = { t: 22, w: 10, g: 6 };
		let saved = s.t; // temperature to return to in the morning
		let mode: 'day' | 'night' = 'day';
		let target: number | null = null;

		// Vapour molecules (3 dots per gram) and fog droplets.
		const mols = Array.from({ length: 92 }, () => {
			const el = circle($('[data-mols]'), 'vhum__mol');
			set(el, { r: 2.3, opacity: 0 });
			const a = rand() * 6.283;
			return {
				el,
				x: BOX.x0 + rand() * (BOX.x1 - BOX.x0),
				y: BOX.y0 + rand() * (BOX.y1 - BOX.y0),
				vx: Math.cos(a),
				vy: Math.sin(a),
				on: false,
			};
		});
		const fog = Array.from({ length: 48 }, () => {
			const el = circle($('[data-fog]'), 'vhum__fogdrop');
			set(el, { r: (2.2 + rand() * 1.6).toFixed(1), opacity: 0 });
			return { el, x: BOX.x0 + rand() * (BOX.x1 - BOX.x0), y: BOX.y0 + rand() * (BOX.y1 - BOX.y0), ph: rand() * 6.283 };
		});
		// Dew droplets on the front of the glass (inside the trapezoid 150..194 at the top, 155..189 at the bottom).
		const drops = Array.from({ length: 54 }, () => {
			const y = 174 + rand() * 60;
			const k = (y - 168) / 70;
			const xl = 150 + 5 * k + 3;
			const xr = 194 - 5 * k - 3;
			const el = circle($('[data-drops]'), 'vhum__dropc');
			set(el, { cx: (xl + rand() * (xr - xl)).toFixed(1), cy: y.toFixed(1), r: 0 });
			return { el, r: 1.8 + rand() * 1.6 };
		});
		let dropsShown = 0;

		const vapour = () => Math.min(s.w, rho0(s.t));
		const excess = () => Math.max(0, s.w - rho0(s.t));
		const dewTarget = () => clamp(Math.round((rho0(s.g) < vapour() ? vapour() - rho0(s.g) : 0) * 4.5), 0, drops.length);

		const draw = () => {
			const r0 = rho0(s.t);
			const v = vapour();
			const ex = excess();
			const dew = dewPoint(s.w);
			const phi = (v / r0) * 100;

			// Graph.
			const x = gx(s.t);
			const y = gy(v);
			pt.setAttribute('transform', `translate(${x.toFixed(1)},${y.toFixed(1)})`);
			set($('[data-vline]'), { x1: x, x2: x, y1: y, y2: G.Y0 });
			set($('[data-sat]'), { cx: x, cy: gy(r0) });
			set($('[data-gap]'), { x1: x, x2: x, y1: y - 9, y2: gy(r0) + 7, opacity: r0 - v > 1.2 ? 1 : 0 });
			const showDew = ex === 0 && s.t - dew > 0.15 && dew >= 0;
			const dx = gx(Math.max(dew, 0));
			set($('[data-dh]'), { x1: x, x2: dx, y1: y, y2: y, opacity: showDew ? 1 : 0 });
			set($('[data-dv]'), { x1: dx, x2: dx, y1: y, y2: G.Y0, opacity: showDew ? 1 : 0 });
			set($('[data-dpt]'), { cx: dx, cy: y, opacity: showDew ? 1 : 0 });
			set($('[data-dtext]'), { x: dx - 12, y: G.Y0 - 8, opacity: showDew && s.t - dew > 1.2 ? 1 : 0 });
			set($('[data-ghost]'), { cx: x, cy: gy(s.w), opacity: ex > 0.05 ? 1 : 0 });
			set($('[data-dropline]'), { x1: x, x2: x, y1: gy(s.w) + 7, y2: y - 9, opacity: ex > 0.6 ? 1 : 0 });
			const gX = gx(s.g);
			set($('[data-gline]'), { x1: gX, x2: gX, y1: G.Y0, y2: gy(rho0(s.g)) });
			$('[data-gmark]').setAttribute('d', `M${gX},${G.Y0 - 2} l-6,-10 h12 z`);
			set($('[data-gtext]'), { x: clamp(gX, 70, 400), y: G.Y0 - 16 });
			pt.setAttribute('aria-valuetext', `t = ${ru(s.t, 0)} °C, ρ = ${fixed(v)} г/м³, φ = ${Math.round(phi)} %`);

			// Scene: thermometer, glass, haze.
			const th = clamp(214 - s.t * 5, 44, 232);
			set($('[data-tliq]'), { y: th, height: 232 - th });
			$('[data-glabel]').textContent = `стакан: ${ru(s.g, 0)} °C`;
			$('[data-haze]').setAttribute('opacity', String(Math.min(0.5, ex * 0.09)));

			// Numbers.
			$<HTMLOutputElement>('[data-o-t]').value = `${ru(s.t, 0)} °C`;
			$<HTMLOutputElement>('[data-o-w]').value = `${fixed(s.w)} г`;
			$<HTMLOutputElement>('[data-o-g]').value = `${ru(s.g, 0)} °C`;
			$('[data-s-rho]').textContent = `${fixed(v)} г/м³`;
			$('[data-s-rho0]').textContent = `${fixed(r0)} г/м³`;
			$('[data-s-dew]').textContent =
				Math.abs(dew - Math.round(dew)) < 0.05 ? `${ru(dew, 0)} °C` : `≈ ${ru(dew, 1)} °C`;
			$('[data-s-fog]').textContent = ex > 0.05 ? `${fixed(ex)} г` : 'нет';
			$<HTMLElement>('[data-needle]').style.left = `${clamp(phi, 0, 100)}%`;

			// φ from the rounded numbers shown, as a pupil would compute it.
			const vR = Math.round(v * 10) / 10;
			const r0R = Math.round(r0 * 10) / 10;
			const phiR = (vR / r0R) * 100;
			const exact = Math.abs(phiR - Math.round(phiR)) < 1e-6;
			renderTex(
				formula,
				`\\htmlClass{vl-phi}{\\varphi} = \\dfrac{\\rho}{\\htmlClass{vl-rho0}{\\rho_0}}\\cdot 100\\,\\% = \\dfrac{${tex(fixed(vR))}}{\\htmlClass{vl-rho0}{${tex(fixed(r0R))}}}\\cdot 100\\,\\% ${exact ? '=' : '\\approx'} \\htmlClass{vl-phi}{${Math.round(phiR)}\\,\\%}`,
			);

			// What to notice.
			let msg: string;
			if (ex > 0.05) {
				msg = `Воздух охладился ниже точки росы, и пар стал насыщенным (<i>φ</i> = 100 %). Лишние ${fixed(ex)} г пара в каждом кубическом метре превратились в капельки воды — это туман.`;
			} else if (phi > 99.5) {
				msg = 'Пар насыщенный: <i>φ</i> = 100 %. Ещё чуть холоднее — и начнётся конденсация.';
			} else {
				const feel = phi < 40 ? 'Воздух сухой.' : phi <= 60 ? 'Влажность комфортная.' : 'Воздух влажный.';
				const glass =
					rho0(s.g) < v
						? `Стакан (${ru(s.g, 0)} °C) холоднее точки росы — воздух у его стенок охлаждается, пар становится насыщенным, и на стекле выпадает роса.`
						: `Стакан (${ru(s.g, 0)} °C) не холоднее точки росы — роса на нём не выпадает.`;
				msg = `${feel} ${glass}`;
			}
			live.innerHTML = msg;

			iT.value = String(Math.round(s.t));
			iW.value = String(s.w);
			iG.value = String(s.g);
		};

		// Molecules, fog and dew are animated every frame.
		let last = 0;
		let visible = true;
		let raf = 0;
		const frame = (now: number) => {
			const dt = Math.min(0.05, (now - last) / 1000 || 0);
			last = now;
			if (target !== null) {
				const step = 3 * dt;
				s.t = Math.abs(target - s.t) <= step ? target : s.t + Math.sign(target - s.t) * step;
				if (s.t === target) target = null;
				draw();
			}
			const nMol = Math.round(vapour() * 3);
			const speed = reduce.matches ? 0 : 28 * Math.sqrt((s.t + 273) / 293);
			mols.forEach((m, i) => {
				const on = i < nMol;
				if (on !== m.on) {
					m.on = on;
					m.el.setAttribute('opacity', on ? '1' : '0');
				}
				if (!on) return;
				m.x += m.vx * speed * dt;
				m.y += m.vy * speed * dt;
				if (m.x < BOX.x0 || m.x > BOX.x1) m.vx = -m.vx;
				if (m.y < BOX.y0 || m.y > BOX.y1) m.vy = -m.vy;
				m.x = clamp(m.x, BOX.x0, BOX.x1);
				m.y = clamp(m.y, BOX.y0, BOX.y1);
				// A little random turning, like a molecule after collisions.
				if (rand() < dt * 2) {
					const a = rand() * 6.283;
					m.vx = Math.cos(a);
					m.vy = Math.sin(a);
				}
				m.el.setAttribute('cx', m.x.toFixed(1));
				m.el.setAttribute('cy', m.y.toFixed(1));
			});
			const nFog = Math.round(Math.min(fog.length, excess() * 9));
			fog.forEach((f, i) => {
				f.ph += dt * 0.8;
				const on = i < nFog;
				f.el.setAttribute('opacity', on ? '0.75' : '0');
				if (!on || reduce.matches) {
					f.el.setAttribute('cx', f.x.toFixed(1));
					f.el.setAttribute('cy', f.y.toFixed(1));
					return;
				}
				f.y += dt * 4;
				if (f.y > BOX.y1) f.y = BOX.y0;
				f.el.setAttribute('cx', (f.x + 4 * Math.sin(f.ph)).toFixed(1));
				f.el.setAttribute('cy', f.y.toFixed(1));
			});
			// Dew grows or dries up gradually: about 12 droplets per second.
			const want = dewTarget();
			const rate = reduce.matches ? drops.length : 12 * dt;
			const next = want > dropsShown ? Math.min(want, dropsShown + rate) : Math.max(want, dropsShown - rate);
			if (Math.floor(next) !== Math.floor(dropsShown) || next === want) {
				drops.forEach((d, i) => d.el.setAttribute('r', i < Math.floor(next) ? String(d.r) : '0'));
			}
			dropsShown = next;
			raf = visible ? requestAnimationFrame(frame) : 0;
		};
		new IntersectionObserver((e) => {
			visible = e[0].isIntersecting;
			if (visible && !raf) {
				last = performance.now();
				raf = requestAnimationFrame(frame);
			}
		}).observe(root);

		const setNight = (m: 'day' | 'night') => {
			mode = m;
			night.textContent = m === 'day' ? 'Ночь: остудить воздух' : 'Утро: нагреть воздух';
		};
		const stop = () => {
			target = null;
		};
		iT.addEventListener('input', () => {
			stop();
			s.t = Number(iT.value);
			saved = s.t;
			setNight('day');
			draw();
		});
		iW.addEventListener('input', () => {
			stop();
			s.w = Number(iW.value);
			draw();
		});
		iG.addEventListener('input', () => {
			s.g = Number(iG.value);
			draw();
		});
		night.addEventListener('click', () => {
			if (mode === 'day') {
				saved = Math.round(s.t);
				target = Math.max(0, Math.floor(dewPoint(s.w)) - 3);
				if (target >= s.t) target = Math.max(0, Math.round(s.t) - 6);
				setNight('night');
			} else {
				target = saved;
				setNight('day');
			}
			if (reduce.matches) {
				s.t = target;
				target = null;
				draw();
			}
		});
		$('[data-reset]').addEventListener('click', () => {
			stop();
			Object.assign(s, { t: 22, w: 10, g: 6 });
			saved = 22;
			setNight('day');
			draw();
		});

		// Dragging the state point (or clicking anywhere on the graph) sets t and the amount of water.
		const toState = (e: PointerEvent) => {
			const p = graph.createSVGPoint();
			p.x = e.clientX;
			p.y = e.clientY;
			const q = p.matrixTransform(graph.getScreenCTM()!.inverse());
			stop();
			s.t = clamp(Math.round(((q.x - G.X0) / G.PW) * G.TMAX), 0, 30);
			s.w = clamp(Math.round(((G.Y0 - q.y) / G.PH) * G.RMAX * 10) / 10, W_MIN, W_MAX);
			saved = s.t;
			setNight('day');
			draw();
		};
		let dragging = false;
		const down = (e: PointerEvent) => {
			dragging = true;
			graph.setPointerCapture(e.pointerId);
			toState(e);
		};
		pt.addEventListener('pointerdown', down);
		$('[data-hit]').addEventListener('pointerdown', down);
		graph.addEventListener('pointermove', (e) => dragging && toState(e));
		graph.addEventListener('pointerup', () => (dragging = false));
		graph.addEventListener('pointercancel', () => (dragging = false));
		pt.addEventListener('keydown', (e) => {
			const k = e.key;
			if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(k)) return;
			e.preventDefault();
			stop();
			if (k === 'ArrowLeft') s.t = Math.max(0, Math.round(s.t) - 1);
			if (k === 'ArrowRight') s.t = Math.min(30, Math.round(s.t) + 1);
			if (k === 'ArrowUp') s.w = Math.min(W_MAX, Math.round(s.w * 10 + 5) / 10);
			if (k === 'ArrowDown') s.w = Math.max(W_MIN, Math.round(s.w * 10 - 5) / 10);
			saved = s.t;
			setNight('day');
			draw();
		});

		draw();
		dropsShown = dewTarget();
		drops.forEach((d, i) => d.el.setAttribute('r', i < dropsShown ? String(d.r) : '0'));
	}
</script>
