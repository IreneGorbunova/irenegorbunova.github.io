</style>

<script>
	import { scene, clamp, reduce } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const RUN = 10; // s: still air until x = 0.4, then the wind
	// the air over the film inside the magnifier (model units: px, s)
	const LX = 318;
	const LY = 118;
	const LR = 70;
	const XL = LX - LR;
	const XR = LX + LR;
	const TOP = LY - LR + 2; // further up the vapour is lost to the open air
	const YS = 120; // the surface of the water film
	const RATE = 8; // molecules leaving the film per second (steady: depends only on the temperature)
	const SPEED = 80;
	const WIND = 160; // drift at 35 px and more above the film
	const TAU = 2; // s, averaging of the counts

	interface Mol {
		x: number;
		y: number;
		vx: number;
		vy: number;
		k: number;
		age: number;
		c?: SVGCircleElement;
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-vsw]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const vapG = $<SVGGElement>('[data-vap]');
		const filmMols = Array.from(root.querySelectorAll<SVGCircleElement>('[data-film] circle')).map((c) => ({
			c,
			x: Number(c.getAttribute('cx')),
			y: Number(c.getAttribute('cy')),
		}));
		const windG = $<SVGGElement>('[data-wind]');
		const windLabel = $<SVGTextElement>('[data-windlabel]');
		const boy = $<SVGGElement>('[data-boy]');
		const down = $<SVGGElement>('[data-arms-down]');
		const hug = $<SVGGElement>('[data-arms-hug]');
		const smile = $<SVGPathElement>('[data-smile]');
		const chatter = $<SVGPathElement>('[data-chatter]');
		const shiver = $<SVGGElement>('[data-shiver]');
		const skinDrops = Array.from(root.querySelectorAll<SVGCircleElement>('[data-skindrops] circle'));
		const outT = $<SVGTSpanElement>('[data-out]');
		const inT = $<SVGTSpanElement>('[data-in]');
		const netT = $<SVGTSpanElement>('[data-net]');
		const status = $<SVGTextElement>('[data-status]');

		let mols: Mol[] = [];
		let spawnAcc = 0;
		let emaOut = RATE;
		let emaIn = 0.75 * RATE;
		let lastX = -1;
		let lastNow = 0;

		const spawn = (): Mol => {
			const a = (Math.random() - 0.5) * 1.6;
			return { x: XL + 6 + Math.random() * (XR - XL - 12), y: YS - 1, vx: SPEED * Math.sin(a), vy: -SPEED * Math.cos(a), k: 0.25, age: 0 };
		};
		/** One step of the vapour; returns how many molecules left the film and how many came back. */
		const step = (dt: number, wind: number) => {
			let out = 0;
			let back = 0;
			spawnAcc += RATE * dt;
			while (spawnAcc >= 1) {
				spawnAcc -= 1;
				mols.push(spawn());
				out++;
			}
			for (const m of mols) {
				m.age += dt;
				m.k -= dt;
				if (m.k <= 0) {
					const a = Math.random() * 2 * Math.PI;
					m.vx = SPEED * Math.cos(a);
					m.vy = SPEED * Math.sin(a);
					m.k = 0.06 + Math.random() * 0.12;
				}
				const u = WIND * wind * clamp((YS - m.y) / 35);
				m.x += (m.vx + u) * dt;
				m.y += m.vy * dt;
				if (m.y >= YS) {
					m.age = -1; // came back into the water
					back++;
				} else if (m.y < TOP) m.age = -2;
				else if (m.x > XR || m.x < XL) {
					// still air around is just as humid (wrap around); the wind brings dry air (lost)
					if (wind > 0.5) m.age = -2;
					else m.x += m.x > XR ? XL - XR : XR - XL;
				}
			}
			for (const m of mols) if (m.age < 0 && m.c) m.c.remove();
			mols = mols.filter((m) => m.age >= 0);
			return { out, back };
		};
		const reset = () => {
			for (const m of mols) m.c?.remove();
			mols = [];
			spawnAcc = 0;
			// start from the steady state of still air
			for (let i = 0; i < 12 * 30; i++) step(1 / 30, 0);
			emaOut = RATE;
			emaIn = 0.75 * RATE;
		};

		scene(root, RUN, (x) => {
			const now = performance.now() / 1000;
			if (x < lastX - 0.01 || lastX < 0) reset();
			const dt = lastNow ? Math.min(now - lastNow, 0.05) : 0;
			lastNow = now;
			lastX = x;
			const wind = clamp((x - 0.4) / 0.1);
			const still = reduce();
			if (dt > 0 && !still) {
				const { out, back } = step(dt, wind);
				emaOut += (out - emaOut * dt) / TAU;
				emaIn += (back - emaIn * dt) / TAU;
			}
			for (const m of mols) {
				if (!m.c) {
					m.c = document.createElementNS(NS, 'circle');
					m.c.setAttribute('r', '4');
					vapG.append(m.c);
				}
				m.c.setAttribute('class', m.age < 0.45 ? 'vsw__mol is-fast' : 'vsw__mol');
				m.c.setAttribute('cx', m.x.toFixed(1));
				m.c.setAttribute('cy', m.y.toFixed(1));
			}
			for (const [i, f] of filmMols.entries()) {
				f.c.setAttribute('cx', (f.x + 1.8 * Math.sin(7 * now + i * 1.7)).toFixed(1));
				f.c.setAttribute('cy', (f.y + 1.4 * Math.cos(9 * now + i * 2.3)).toFixed(1));
			}
			const nOut = Math.round(emaOut);
			const nIn = Math.round(emaIn);
			outT.textContent = String(nOut);
			inT.textContent = String(nIn);
			netT.textContent = String(Math.max(0, nOut - nIn));
			// the beach
			windG.style.setProperty('--wind', wind.toFixed(2));
			windLabel.style.opacity = wind.toFixed(2);
			const cold = clamp((x - 0.52) / 0.1);
			down.style.opacity = (1 - cold).toFixed(2);
			hug.style.opacity = cold.toFixed(2);
			smile.style.opacity = (1 - cold).toFixed(2);
			chatter.style.opacity = cold.toFixed(2);
			shiver.style.opacity = (cold * (0.6 + 0.4 * Math.sin(now * 20))).toFixed(2);
			boy.setAttribute('transform', `translate(${(cold * 0.9 * Math.sin(now * 55)).toFixed(2)} 0)`);
			for (const d of skinDrops) d.style.opacity = x < Number(d.dataset.x0) ? '1' : '0';
			status.textContent = wind > 0.5 ? 'Ветер уносит пар: холоднее' : 'Тихо: пар остаётся у кожи';
		});
	}
</script>
