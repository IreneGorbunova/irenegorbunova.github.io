		margin-top: 0.5rem;
	}
	.vsw__foot p {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.vsw__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.vsw__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.vsw__bg {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 35%, transparent);
	}
	.vsw__sky {
		fill: color-mix(in srgb, var(--ig-vx) 16%, var(--ig-surface));
	}
	.vsw__sun circle {
		fill: var(--ig-v);
	}
	.vsw__sun line {
		stroke: var(--ig-v);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.vsw__sea {
		fill: color-mix(in srgb, var(--ig-vx) 50%, var(--ig-surface));
	}
	.vsw__waves path {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
		stroke-width: 1.5;
		stroke-linecap: round;
		animation: vsw-wave 3s ease-in-out infinite alternate;
	}
	.vsw__waves path:nth-child(2) {
