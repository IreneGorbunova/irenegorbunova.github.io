---
/**
 * «Бросок вверх»: a ball is thrown straight up from the ground with υ0 = 10…30 м/с (g = 9,8 м/с², no air). Axis Oy
 * points up from the point of the throw: υy = υ0 − g t, y = υ0 t − g t²/2. Rise time υ0/g (1,02…3,06 с), the
 * greatest height υ0²/(2g) (5,1…45,9 м), the flight 2υ0/g. Real time.
 * Left: the height column to scale, 0…50 м (4,4 px per metre); the ball (drawn larger) carries its velocity arrow
 * (1,6 px per м/с, gold, the color of velocity in the chapter); a dashed line marks the greatest height.
 * Right: the graphs υy(t) (−30…30 м/с) and y(t) (0…50 м), both over 0…6,5 с, drawn as the ball flies; the faint
 * curve shows the whole flight in advance.
 */
import G7Styles from '../g7/G7Styles.astro';

const GY = 250; // the ground
const PXM = 4.4;
const CX = 52;
// graphs: t from 0 to 6,5 с over 200 px
const GX0 = 128;
const GW = 200;
const V0Y = 62; // υ = 0 line of the first graph (±30 м/с over ±48 px)
const Y0Y = 232; // y = 0 line of the second graph (50 м over 96 px)
---

<G7Styles />
<figure class="g7 throwup not-content" data-throwup>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 262" role="img" aria-label="Мяч, брошенный вертикально вверх, и графики его скорости и координаты" data-svg>
			<!-- the height column -->
			<line class="ln" x1="20" x2="20" y1={GY} y2={GY - 50 * PXM}></line>
			{[0, 10, 20, 30, 40, 50].map((m) => (
				<>
					<line class="ln" x1="20" x2="26" y1={GY - m * PXM} y2={GY - m * PXM} />
					<text class="t-small t-num" x="29" y={GY - m * PXM + 3.5}>{m}</text>
				</>
			))}
			<text class="t-small" x="8" y={GY - 50 * PXM - 8}>y, м</text>
			<line class="throwup__ground" x1="0" x2="100" y1={GY + 1.5} y2={GY + 1.5}></line>
			<line class="throwup__top" data-top x1="34" x2="96"></line>
			<text class="t-small t-gold" data-toplab x="62"></text>
			<line class="arrow arrow--gold" data-varrow></line>
			<path class="head--gold" data-vhead></path>
			<circle class="throwup__ball" data-ball cx={CX} r="6"></circle>
			<!-- graph of υy -->
			<text class="t-small" x={GX0 + 6} y={V0Y - 40}><tspan class="t-i">υ<tspan baseline-shift="sub" font-size="9">y</tspan></tspan>, м/с</text>
			<line class="ln" x1={GX0} x2={GX0} y1={V0Y - 50} y2={V0Y + 50}></line>
			<line class="ln" x1={GX0} x2={GX0 + GW + 4} y1={V0Y} y2={V0Y}></line>
			{[-30, 30].map((v) => <text class="t-small t-num" x={GX0 - 3} y={V0Y - v * 1.6 + 3.5} text-anchor="end">{v > 0 ? v : '−30'}</text>)}
			<text class="t-small" x={GX0 + GW + 4} y={V0Y - 4} text-anchor="end">t, с</text>
			<path class="throwup__ghost" data-vghost></path>
			<path class="throwup__curve" data-vcurve></path>
			<circle class="throwup__dot" r="3.2" data-vdot></circle>
			<!-- graph of y -->
			<text class="t-small" x={GX0 + 6} y={Y0Y - 92}><tspan class="t-i">y</tspan>, м</text>
			<line class="ln" x1={GX0} x2={GX0} y1={Y0Y} y2={Y0Y - 100}></line>
			<line class="ln" x1={GX0} x2={GX0 + GW + 4} y1={Y0Y} y2={Y0Y}></line>
			{[25, 50].map((m) => <text class="t-small t-num" x={GX0 - 3} y={Y0Y - m * 1.92 + 3.5} text-anchor="end">{m}</text>)}
			{[0, 1, 2, 3, 4, 5, 6].map((s) => (
				<>
					<line class="ln" x1={GX0 + (s / 6.5) * GW} x2={GX0 + (s / 6.5) * GW} y1={Y0Y} y2={Y0Y + 4} />
					<text class="t-small t-num" x={GX0 + (s / 6.5) * GW} y={Y0Y + 14} text-anchor="middle">{s}</text>
				</>
			))}
			<text class="t-small" x={GX0 + GW + 4} y={Y0Y + 14} text-anchor="end">t, с</text>
			<path class="throwup__ghost" data-yghost></path>
			<path class="throwup__curve" data-ycurve></path>
			<circle class="throwup__dot" r="3.2" data-ydot></circle>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Начальная скорость <i>υ</i><sub>0</sub></span>
				<output data-ov></output>
				<input type="range" min="10" max="30" step="1" value="20" data-v0 aria-label="Начальная скорость, метры в секунду" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Бросить мяч</button>
			<ul class="g7__read" aria-live="polite">
				<li><span>Время <i>t</i></span><b data-t>0 с</b></li>
				<li><span>Высота <i>y</i></span><b data-y>0 м</b></li>
				<li><span>Скорость <i>υ<sub>y</sub></i></span><b data-vy></b></li>
				<li class="is-key"><span>Время подъёма</span><b data-tup></b></li>
				<li class="is-key"><span>Наибольшая высота</span><b data-h></b></li>
				<li><span>Время полёта</span><b data-tfl></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Ось <i>Oy</i> направлена вверх, начало — в точке броска; сопротивления воздуха нет. Золотая стрелка — скорость мяча. Высота слева в масштабе, мяч нарисован крупнее; время идёт как в жизни.
	</figcaption>
</figure>

<style is:global>
	.throwup__ground {
		stroke: var(--g7-ink);
		stroke-width: 3;
	}
	.throwup__top {
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.throwup__ball {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.throwup__ghost {
		fill: none;
		stroke: var(--g7-faint);
		stroke-width: 1.5;
		stroke-dasharray: 3 3;
	}
	.throwup__curve {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.2;
	}
	.throwup__dot {
		fill: var(--g7-blue);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';

	const G = 9.8;
	const GY = 250;
	const PXM = 4.4;
	const CX = 52;
	const GX0 = 128;
	const GW = 200;
	const V0Y = 62;
	const Y0Y = 232;
	const tx = (t: number) => GX0 + (t / 6.5) * GW;
	const vy = (v: number) => V0Y - v * 1.6;
	const yy = (y: number) => Y0Y - y * 1.92;
	for (const root of document.querySelectorAll<HTMLElement>('[data-throwup]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const v0In = $<HTMLInputElement>('[data-v0]');
		let t = -1;
		const curves = (v0: number, upTo: number) => {
			const T = (2 * v0) / G;
			let a = '';
			let b = '';
			const n = 60;
			for (let i = 0; i <= n; i++) {
				const s = (Math.min(upTo, T) * i) / n;
				a += `${i ? 'L' : 'M'}${tx(s).toFixed(1)} ${vy(v0 - G * s).toFixed(1)} `;
				b += `${i ? 'L' : 'M'}${tx(s).toFixed(1)} ${yy(v0 * s - (G * s * s) / 2).toFixed(1)} `;
			}
			return [a, b];
		};
		const draw = () => {
			const v0 = Number(v0In.value);
			const T = (2 * v0) / G;
			const H = (v0 * v0) / (2 * G);
			const s = Math.min(Math.max(0, t), T);
			const v = t < 0 ? v0 : v0 - G * s;
			const y = v0 * s - (G * s * s) / 2;
			$('[data-ov]').textContent = `${v0} м/с`;
			const [ga, gb] = curves(v0, T);
			$('[data-vghost]').setAttribute('d', ga);
			$('[data-yghost]').setAttribute('d', gb);
			const [ca, cb] = curves(v0, s);
			$('[data-vcurve]').setAttribute('d', t < 0 ? '' : ca);
			$('[data-ycurve]').setAttribute('d', t < 0 ? '' : cb);
			$('[data-vdot]').setAttribute('cx', tx(s).toFixed(1));
			$('[data-vdot]').setAttribute('cy', vy(v).toFixed(1));
			$('[data-ydot]').setAttribute('cx', tx(s).toFixed(1));
			$('[data-ydot]').setAttribute('cy', yy(y).toFixed(1));
			const by = GY - 6 - y * PXM;
			$('[data-ball]').setAttribute('cy', by.toFixed(1));
			// the velocity arrow, 1,6 px per м/с, from the edge of the ball
			const landed = t >= T;
			const L = Math.abs(v) * 1.6;
			const dir = v >= 0 ? -1 : 1;
			const show = !landed && L > 3;
			const y1 = by + dir * 7;
			const y2 = y1 + dir * L;
			const ar = $('[data-varrow]');
			ar.setAttribute('x1', String(CX));
			ar.setAttribute('x2', String(CX));
			ar.setAttribute('y1', y1.toFixed(1));
			ar.setAttribute('y2', (y2 - dir * 4).toFixed(1));
			ar.setAttribute('opacity', show ? '1' : '0');
			$('[data-vhead]').setAttribute('d', show ? `M${CX - 5} ${(y2 - dir * 7).toFixed(1)} L${CX} ${y2.toFixed(1)} L${CX + 5} ${(y2 - dir * 7).toFixed(1)} Z` : '');
			const top = GY - H * PXM;
			$('[data-top]').setAttribute('y1', top.toFixed(1));
			$('[data-top]').setAttribute('y2', top.toFixed(1));
			$('[data-toplab]').setAttribute('y', (top - 4).toFixed(1));
			$('[data-toplab]').textContent = `H = ${fmt(H, 1)} м`;
			$('[data-t]').textContent = `${fmt(s, 2)} с`;
			$('[data-y]').textContent = `${fmt(Math.max(0, y), 1)} м`;
			$('[data-vy]').textContent = `${fmt(landed ? -v0 : v, 1)} м/с`;
			$('[data-tup]').textContent = `${fmt(v0 / G, 2)} с`;
			$('[data-h]').textContent = `${fmt(H, 1)} м`;
			$('[data-tfl]').textContent = `${fmt(T, 2)} с`;
		};
		const wake = loop(root, (d) => {
			if (t < 0) return false;
			t += d;
			draw();
			return t < (2 * Number(v0In.value)) / G;
		});
		$('[data-go]').addEventListener('click', () => {
			t = 0;
			wake();
		});
		v0In.addEventListener('input', () => {
			t = -1;
			draw();
		});
		draw();
	}
</script>
