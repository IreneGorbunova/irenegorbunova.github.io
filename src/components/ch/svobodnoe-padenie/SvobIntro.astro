---
/**
 * Two short looping opening scenes of «Свободное падение». No terms of the chapter in the pictures.
 *
 * Ruler: a room, two teenagers seen from the knees up, 2 px per centimeter (the floor lies 85 см below the frame).
 *   The boy (172 см) holds a 30 см ruler by its top end; the girl (162 см) keeps her open hand at the ruler's lower
 *   end. The boy lets go without warning; the ruler falls freely, h = g t²/2 with g = 9,8 м/с², and the girl's
 *   fingers close after her reaction time 0,20 с, when the ruler has fallen 19,6 см (≈ 20 см, 39 px). The clock in
 *   the corner counts real seconds; the scene runs ten times slower than real time.
 *   The hands are drawn by the scene itself (palm, two fingers behind the ruler, the thumb in front): the boy pinches
 *   the top end between the thumb and the index finger and opens them; the girl's thumb closes on the ruler.
 * Paper: a girl (160 см, 1,35 px per centimeter) holds a tennis ball (58 г, 6,7 см) and a sheet of paper at
 *   shoulder height, 1,31 м above the floor, and lets both go. The ball falls in 0,52 с (air drag changes it by less
 *   than 0,01 с). The flat sheet sways and sinks at about 0,75 м/с on average, landing after 1,8 с. In the second
 *   part the same sheet is crumpled into a ball 6 см across: with a drag coefficient 0,6 its terminal speed is
 *   6,9 м/с, it lands after 0,54 с, 0,02 с after the tennis ball (computed in the script step by step). The scene
 *   runs three times slower than real time.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

// the ruler: 30 см, 2 px per см, drawn from its top end (y = 0) down
const ticks = Array.from({ length: 31 }, (_, i) => i);
---

<PeopleStyles />
<IntroFrame data-svintro>
	<div class="intro__card" data-scene="ruler">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик держит линейку, девочка держит раскрытую ладонь у её нижнего конца. Мальчик отпускает линейку, девочка ловит её, и линейка успевает пролететь около двадцати сантиметров">
			<rect class="sv-wall" x="0" y="0" width="360" height="240"></rect>
			<!-- a window with a frame and a sill, a shelf with books -->
			<rect class="sv-window" x="22" y="22" width="92" height="104" rx="2"></rect>
			<path class="sv-frame" d="M22 22 h92 v104 h-92 Z M68 22 V126 M22 74 H114"></path>
			<rect class="sv-sill" x="16" y="126" width="104" height="6" rx="1"></rect>
			<rect class="sv-shelf" x="292" y="40" width="68" height="4"></rect>
			<rect class="sv-book sv-book--a" x="298" y="14" width="8" height="26"></rect>
			<rect class="sv-book sv-book--b" x="307" y="18" width="7" height="22"></rect>
			<rect class="sv-book sv-book--c" x="315" y="12" width="9" height="28"></rect>
			<rect class="sv-book sv-book--a" x="326" y="20" width="6" height="20" transform="rotate(12 329 40)"></rect>
			<g data-boy></g>
			<g data-girl></g>
			<!-- the fingers behind the ruler -->
			<g class="sv-back" data-back></g>
			<g data-ruler>
				<rect class="sv-ruler" x="-4" y="0" width="8" height="60" rx="0.8"></rect>
				{ticks.map((i) => <line class="sv-tick" x1="-4" x2={i % 5 === 0 ? -0.5 : -2.2} y1={60 - 2 * i} y2={60 - 2 * i} />)}
			</g>
			<!-- the palms and the thumbs in front of the ruler -->
			<g data-front></g>
			<g data-mark opacity="0">
				<path class="sv-bracket" d="M168 180 h-5 V219 h5"></path>
				<text class="sv-num" x="159" y="204" text-anchor="end">≈ 20&nbsp;см</text>
			</g>
			<text class="sv-label" x="10" y="232">время: <tspan class="sv-num" data-clock>0,00&nbsp;с</tspan></text>
		</svg>
		<div class="intro__foot">
			<p>
				Линейку отпускают без предупреждения, и, пока пальцы сжимаются, она{' '}
				<More term="успевает пролететь около 20 см">
					Линейка падает с постоянным ускорением <i>g</i>&nbsp;≈&nbsp;9,8&nbsp;м/с² и за время <i>t</i> пролетает <i>h</i>&nbsp;=&nbsp;<i>gt</i>²/2. Поэтому по пройденному пути находят время реакции: <i>t</i>&nbsp;=&nbsp;√(2<i>h</i>/<i>g</i>)&nbsp;≈&nbsp;0,2&nbsp;с для 20&nbsp;см. В сцене время замедлено в 10 раз. Об этом — в разделе{' '}
					<a href="#скорость-и-путь-при-свободном-падении">«Скорость и путь при свободном падении»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="paper">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка одновременно отпускает мяч и лист бумаги: мяч падает быстро, лист медленно опускается. Потом она отпускает мяч и скомканный лист, и они падают почти одновременно">
			<rect class="sv-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="sv-door" x="262" y="62" width="62" height="166" rx="2"></rect>
			<circle class="sv-knob" cx="270" cy="150" r="3"></circle>
			<rect class="sv-floor" x="0" y="228" width="360" height="12"></rect>
			<line class="sv-skirt" x1="0" x2="360" y1="226" y2="226"></line>
			<g data-girl2></g>
			<g data-sheet>
				<path class="sv-sheet" d="M-14 0 Q0 -2 14 0" data-sheetpath></path>
			</g>
			<g data-crumple opacity="0">
				<path class="sv-crumple" d="M-4.2 -0.5 L-2.6 -3.6 L0.6 -4.3 L3.6 -2.4 L4.1 1.2 L1.8 3.9 L-1.9 3.8 L-4 1.9 Z"></path>
				<path class="sv-crease" d="M-2.6 -3.6 L-0.5 0.2 L3.6 -2.4 M-0.5 0.2 L-1.9 3.8 M-0.5 0.2 L4.1 1.2"></path>
			</g>
			<g data-ball>
				<circle class="sv-ball" r="4.5"></circle>
				<path class="sv-seam" d="M-3.1 -3.3 Q0 0 -3.1 3.3 M3.1 -3.3 Q0 0 3.1 3.3"></path>
			</g>
			<text class="sv-label" x="190" y="30" data-cap>лист и мяч</text>
		</svg>
		<div class="intro__foot">
			<p>
				Лист бумаги долго кружится в воздухе, а такой же лист, смятый в комок, падает{' '}
				<More term="почти так же быстро, как мяч">
					Масса листа не изменилась — изменилось сопротивление воздуха: плоскому листу оно мешает гораздо сильнее, чем маленькому комку. Без воздуха лист, комок и мяч падали бы совершенно одинаково. Об этом — в разделе{' '}
					<a href="#свободное-падение">«Свободное падение»</a>. В сцене время замедлено втрое.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-svintro] .sv-wall {
		fill: color-mix(in oklab, var(--ig-v) 7%, var(--sl-color-gray-6));
	}
	[data-svintro] .sv-window {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
	}
	[data-svintro] .sv-frame {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	[data-svintro] .sv-sill,
	[data-svintro] .sv-shelf {
		fill: var(--sl-color-gray-4);
	}
	[data-svintro] .sv-book {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.6;
	}
	[data-svintro] .sv-book--a {
		fill: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-4));
	}
	[data-svintro] .sv-book--b {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-4));
	}
	[data-svintro] .sv-book--c {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
	}
	[data-svintro] .sv-ruler {
		fill: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-white));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.7;
	}
	[data-svintro] .sv-tick {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.5;
	}
	[data-svintro] .sv-fing-o {
		fill: none;
		stroke: var(--hm-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-svintro] .sv-fing {
		fill: none;
		stroke: var(--hm-skin);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-svintro] .sv-palm {
		fill: var(--hm-skin);
		stroke: var(--hm-line);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	[data-svintro] .sv-nail {
		fill: color-mix(in oklab, var(--hm-skin) 55%, white);
		stroke: var(--hm-line);
		stroke-width: 0.4;
	}
	[data-svintro] .sv-back {
		filter: brightness(0.82);
	}
	[data-svintro] .sv-bracket {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.6;
	}
	[data-svintro] .sv-label {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	[data-svintro] .sv-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-svintro] .sv-door {
		fill: color-mix(in oklab, var(--ig-v) 28%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	[data-svintro] .sv-knob {
		fill: var(--sl-color-gray-3);
	}
	[data-svintro] .sv-floor {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-svintro] .sv-skirt {
		stroke: var(--sl-color-gray-4);
		stroke-width: 4;
	}
	[data-svintro] .sv-sheet {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	[data-svintro] .sv-crumple {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	[data-svintro] .sv-crease {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.5;
	}
	[data-svintro] .sv-ball {
		fill: hsl(70, 80%, 55%);
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.6;
	}
	[data-svintro] .sv-seam {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 0.8;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { human, ANKLE, type HumanPose } from '../mehanicheskaya-rabota/people';

	const fmt2 = (v: number) => v.toFixed(2).replace('.', ',');
	const G = 9.8;

	for (const root of document.querySelectorAll<HTMLElement>('[data-svintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ruler"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 2; // px per см
			const FLOOR = 410; // the floor, 85 см below the frame
			const boyG = $<SVGGElement>('[data-boy]');
			const girlG = $<SVGGElement>('[data-girl]');
			const boy = human(boyG, { s: S, H: 172, shirt: 'hm-blue', hair: 'short' });
			const girl = human(girlG, { s: S, H: 162, shirt: 'hm-red', hair: 'pony', dir: -1 });
			// people.ts draws the near hand as the last element of the person; these scenes draw their own hands
			const hideHand = (g: SVGGElement) => {
				const last = g.firstElementChild?.lastElementChild as SVGElement | null;
				if (last) last.style.display = 'none';
			};
			const ruler = $<SVGGElement>('[data-ruler]');
			const mark = $<SVGGElement>('[data-mark]');
			const clock = $('[data-clock]');
			const RX = 180; // the ruler's axis
			const TOP = 120; // the ruler's top end before the drop
			const HAND = 180; // the girl's fingers, at the zero mark
			const stand = (H: number, x: number, dir: 1 | -1, hands: [{ x: number; y: number }, { x: number; y: number }], palms?: [number | null, number | null]): HumanPose => {
				const u = S * H;
				const a = ANKLE * S * Math.min(1, H / 172);
				return {
					hip: { x, y: FLOOR - 0.505 * u },
					lean: 0.04,
					ankles: [
						{ x: x + dir * 0.02 * u, y: FLOOR - a },
						{ x: x - dir * 0.04 * u, y: FLOOR - a },
					],
					feet: [0, 0],
					hands,
					palms,
				};
			};
			// Hands at 2 px per см, seen from the side: a palm, two fingers behind the ruler (darker), the thumb in front
			// of it. The boy pinches the top end between the thumb and the index finger, then opens them. The girl's open
			// hand waits with the fingers behind the ruler and the thumb short of it, then the thumb presses the ruler.
			const NS = 'http://www.w3.org/2000/svg';
			const mk = (parent: Element, tag: string, cls: string, w?: number) => {
				const e = document.createElementNS(NS, tag);
				e.setAttribute('class', cls);
				if (w) e.setAttribute('stroke-width', String(w));
				parent.append(e);
				return e;
			};
			const finger = (parent: Element, w: number) => {
				const o = mk(parent, 'path', 'sv-fing-o', w + 1.2);
				const p = mk(parent, 'path', 'sv-fing', w);
				return (d: string) => (o.setAttribute('d', d), p.setAttribute('d', d));
			};
			const back = $('[data-back]');
			const front = $('[data-front]');
			const bIndex = finger(back, 3.4);
			const bMiddle = finger(back, 3.4);
			const gIndex = finger(back, 3.2);
			const gMiddle = finger(back, 3.2);
			const bPalm = mk(front, 'path', 'sv-palm');
			const bThumb = finger(front, 3.8);
			const bNail = mk(front, 'ellipse', 'sv-nail');
			const gPalm = mk(front, 'path', 'sv-palm');
			const gThumb = finger(front, 3.6);
			const gNail = mk(front, 'ellipse', 'sv-nail');
			const P = (dx: number, dy: number, y0: number) => `${RX + dx} ${y0 + dy}`;
			const hands = (held: boolean, caught: boolean) => {
				const T = (dx: number, dy: number) => P(dx, dy, TOP);
				bPalm.setAttribute('d', `M${T(-17, 4)} L${T(-6, 0.5)} Q${T(-2.5, 6)} ${T(-6, 12.5)} L${T(-17, 14)} Z`);
				if (held) {
					bIndex(`M${T(-6, 2.5)} Q${T(5, 0.5)} ${T(6, 6)}`);
					bMiddle(`M${T(-6, 7)} Q${T(4, 6)} ${T(5, 10.5)}`);
					bThumb(`M${T(-12, 12)} Q${T(-5, 10.5)} ${T(2, 7)}`);
					bNail.setAttribute('cx', String(RX + 0.6));
					bNail.setAttribute('cy', String(TOP + 7.5));
				} else {
					bIndex(`M${T(-6, 2.5)} Q${T(1, -1)} ${T(7, -3)}`);
					bMiddle(`M${T(-6, 7)} Q${T(1, 5)} ${T(7, 4)}`);
					bThumb(`M${T(-12, 12)} Q${T(-6, 16)} ${T(-1, 18)}`);
					bNail.setAttribute('cx', String(RX - 2.2));
					bNail.setAttribute('cy', String(TOP + 17.4));
				}
				bNail.setAttribute('rx', '1.3');
				bNail.setAttribute('ry', '0.9');
				const Hh = (dx: number, dy: number) => P(dx, dy, HAND);
				gPalm.setAttribute('d', `M${Hh(18, -2)} L${Hh(7, -4.5)} Q${Hh(3.5, 2)} ${Hh(7, 8.5)} L${Hh(18, 9)} Z`);
				if (caught) {
					gIndex(`M${Hh(7, -2.5)} Q${Hh(-5, -4)} ${Hh(-6, 1)}`);
					gMiddle(`M${Hh(7, 1.5)} Q${Hh(-5, 1)} ${Hh(-6, 5.5)}`);
					gThumb(`M${Hh(12, 8)} Q${Hh(4, 6.5)} ${Hh(-2, 3)}`);
					gNail.setAttribute('cx', String(RX - 0.6));
					gNail.setAttribute('cy', String(HAND + 3.6));
				} else {
					gIndex(`M${Hh(7, -2.5)} Q${Hh(-3, -10)} ${Hh(-9, -7)}`);
					gMiddle(`M${Hh(7, 1.5)} Q${Hh(-2, -3)} ${Hh(-8, -1)}`);
					gThumb(`M${Hh(12, 8)} Q${Hh(8, 13)} ${Hh(5.5, 10.5)}`);
					gNail.setAttribute('cx', String(RX + 6.3));
					gNail.setAttribute('cy', String(HAND + 11));
				}
				gNail.setAttribute('rx', '1.2');
				gNail.setAttribute('ry', '0.9');
			};
			const REL = 1; // scene seconds before the boy lets go
			const SLOW = 10;
			const TR = 0.2; // the girl's reaction time, s
			scene(card, 4, (x) => {
				const ts = x * 4;
				const tr = Math.min(TR, Math.max(0, (ts - REL) / SLOW)); // real seconds of the fall
				const held = ts < REL;
				const caught = tr >= TR;
				const drop = (G * tr * tr) / 2; // м
				const y0 = TOP + drop * 100 * S;
				ruler.setAttribute('transform', `translate(${RX} ${y0.toFixed(1)})`);
				// the arms end at the wrists; the hands are drawn below (people.ts's own near hand is hidden)
				boy(stand(172, 82, 1, [{ x: RX - 15, y: TOP + 9 }, { x: 98, y: 236 }]));
				girl(stand(162, 282, -1, [{ x: RX + 16, y: HAND + 3 }, { x: 266, y: 236 }]));
				hideHand(boyG);
				hideHand(girlG);
				hands(held, caught);
				mark.setAttribute('opacity', caught ? '1' : '0');
				clock.textContent = `${fmt2(tr)} с`;
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="paper"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1.35;
			const H = 160;
			const u = S * H;
			const FLOOR = 228;
			const girl = human($<SVGGElement>('[data-girl2]'), { s: S, H, shirt: 'hm-green', hair: 'pony' });
			const sheet = $<SVGGElement>('[data-sheet]');
			const sheetPath = $<SVGPathElement>('[data-sheetpath]');
			const crumple = $<SVGGElement>('[data-crumple]');
			const ball = $<SVGGElement>('[data-ball]');
			const cap = $('[data-cap]');
			const H0 = 1.31; // м, the release height
			const Y0 = FLOOR - H0 * 100 * S;
			const BX = 160; // the ball
			const PX = 184; // the paper, held by its left edge
			// the crumpled sheet: m = 5 г, d = 6 см, C = 0,6, air 1,2 кг/м³ → terminal speed 6,9 м/с; a table of its fall
			const VT = Math.sqrt((2 * 0.005 * G) / (1.2 * 0.6 * Math.PI * 0.03 * 0.03));
			const crTab: number[] = [];
			{
				let y = 0;
				let v = 0;
				for (let i = 0; i <= 1000; i++) {
					crTab.push(y);
					for (let k = 0; k < 10; k++) {
						v += G * (1 - (v / VT) ** 2) * 1e-4;
						y += v * 1e-4;
					}
				}
			}
			const crFall = (t: number) => crTab[Math.min(1000, Math.floor(t * 1000))]; // м
			const freeFall = (t: number) => (G * t * t) / 2;
			const TS = 1.8; // the flat sheet lands
			// the flat sheet: sinks unevenly (faster on the swings), sways ±12 см and tilts
			const sheetAt = (t: number) => {
				const q = Math.min(1, t / TS);
				const fall = H0 * (q - 0.06 * Math.sin(2 * Math.PI * 2 * q));
				return { y: Math.min(H0, Math.max(0, fall)), x: 12 * Math.sin(2 * Math.PI * 1.25 * q) * (q < 1 ? 1 : 0), tilt: 22 * Math.cos(2 * Math.PI * 1.25 * q) * (q < 1 ? 1 : 0) };
			};
			const pose = (hold: boolean): HumanPose => {
				const hip = { x: 95, y: FLOOR - 0.505 * u };
				const a = ANKLE * S * (H / 172);
				return {
					hip,
					lean: 0.03,
					ankles: [
						{ x: 99, y: FLOOR - a },
						{ x: 87, y: FLOOR - a },
					],
					feet: [0, 0],
					hands: hold
						? [
								{ x: BX - 1, y: Y0 - 6 },
								{ x: PX - 15, y: Y0 - 2 },
							]
						: [
								{ x: BX - 6, y: Y0 - 4 },
								{ x: PX - 19, y: Y0 + 1 },
							],
					palms: hold ? undefined : [0.15, 0.15],
					head: 0.35,
				};
			};
			const SLOW = 3;
			const P1 = 0.7; // s of the scene before the first drop
			const P2 = 7.6; // the second drop
			scene(card, 10.2, (x) => {
				const ts = x * 10.2;
				const second = ts >= P2 - 0.9;
				const t = Math.max(0, ((second ? ts - P2 : ts - P1) / SLOW));
				const held = second ? ts < P2 : ts < P1;
				girl(pose(held));
				cap.textContent = second ? 'скомканный лист и мяч' : 'лист и мяч';
				const yb = Math.min(FLOOR - 4.5 - Y0, freeFall(t) * 100 * S);
				ball.setAttribute('transform', `translate(${BX + 1} ${(Y0 + yb).toFixed(1)})`);
				if (!second) {
					const s = sheetAt(t);
					sheet.setAttribute('opacity', '1');
					crumple.setAttribute('opacity', '0');
					sheet.setAttribute('transform', `translate(${(PX + s.x * S).toFixed(1)} ${Math.min(FLOOR - 1.5, Y0 + s.y * 100 * S).toFixed(1)}) rotate(${s.tilt.toFixed(1)})`);
					const bend = s.y > 0 && s.y < H0 ? 4 * Math.sin(2 * Math.PI * 2.5 * t) : -2;
					sheetPath.setAttribute('d', `M-14 0 Q0 ${bend.toFixed(1)} 14 0`);
				} else {
					sheet.setAttribute('opacity', '0');
					crumple.setAttribute('opacity', '1');
					const yc = Math.min(FLOOR - 4 - Y0, crFall(t) * 100 * S);
					crumple.setAttribute('transform', `translate(${PX - 12} ${(Y0 + yc).toFixed(1)})`);
				}
			});
		}
	}
</script>
