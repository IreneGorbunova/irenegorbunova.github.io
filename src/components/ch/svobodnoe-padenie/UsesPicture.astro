---
/**
 * Small pictures for «Где это встречается» of «Свободное падение» (static, school-style, not to scale):
 * a stone dropped into a well and the splash; a skydiver before the parachute opens and under it; the jet of the
 * fountain in Geneva (140 м, the water leaves the nozzle at about 200 км/ч); the drop tower in Bremen (a capsule
 * falls 110 м in a tube with the air pumped out, 4,74 с).
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic svuses not-content">
	<div class="g7__grid is-two">
		<div class="svuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Камень падает в колодец">
				<rect class="svuses__ground" x="0" y="34" width="160" height="86"></rect>
				<rect class="svuses__shaft" x="58" y="34" width="44" height="80"></rect>
				<path class="svuses__brick" d="M52 20 h56 v14 h-56 Z M52 27 h56 M66 20 v7 M80 27 v7 M94 20 v7"></path>
				<rect class="svuses__water" x="58" y="102" width="44" height="12"></rect>
				<path class="ln-dash" d="M80 14 V96"></path>
				{[0, 1, 2, 3].map((i) => <circle class="svuses__stone svuses__stone--ghost" cx="80" cy={14 + 82 * (i / 3) ** 2} r="3" />)}
				<circle class="svuses__stone" cx="80" cy="96" r="3.4"></circle>
				<path class="svuses__splash" d="M72 101 l-4 -6 M80 100 v-7 M88 101 l4 -6"></path>
				<text class="t-small" x="112" y="70">2&nbsp;с</text>
			</svg>
			<p>Глубина колодца</p>
		</div>
		<div class="svuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Парашютист падает, раскинув руки, а потом опускается на парашюте">
				<rect class="svuses__sky" x="0" y="0" width="160" height="120"></rect>
				<!-- belly to earth -->
				<g transform="translate(46 70)">
					<path class="svuses__suit" d="M-14 -2 L14 -2 L16 2 L-16 2 Z"></path>
					<path class="svuses__limb" d="M-12 -1 L-24 -10 M12 -1 L24 -10 M-6 2 L-14 14 M6 2 L14 14"></path>
					<circle class="svuses__head" cx="0" cy="-6" r="4.5"></circle>
				</g>
				<path class="arrow arrow--gold" d="M46 86 V104"></path>
				<path class="head--gold" d="M41.5 103 L46 111 L50.5 103 Z"></path>
				<text class="t-small" x="46" y="22" text-anchor="middle">≈ 200 км/ч</text>
				<!-- under the canopy -->
				<path class="svuses__canopy" d="M94 34 Q120 10 146 34 Q133 30 120 34 Q107 30 94 34 Z"></path>
				<path class="svuses__line" d="M94 34 L118 70 M146 34 L122 70 M107 32 L119 70 M133 32 L121 70"></path>
				<rect class="svuses__suit" x="116" y="70" width="8" height="16" rx="2"></rect>
				<circle class="svuses__head" cx="120" cy="66" r="4"></circle>
				<path class="svuses__limb" d="M117 86 L115 98 M123 86 L125 98"></path>
				<text class="t-small" x="120" y="114" text-anchor="middle">≈ 18 км/ч</text>
			</svg>
			<p>Прыжок с парашютом</p>
		</div>
		<div class="svuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Струя фонтана в Женеве бьёт вверх на сто сорок метров">
				<rect class="svuses__sky" x="0" y="0" width="160" height="120"></rect>
				<path class="svuses__hills" d="M0 92 Q30 74 60 88 Q95 70 130 86 Q148 80 160 84 V100 H0 Z"></path>
				<rect class="svuses__lake" x="0" y="96" width="160" height="24"></rect>
				<path class="svuses__jet" d="M78 98 L79.5 12 Q80 8 80.5 12 L82 98 Z"></path>
				<path class="svuses__spray" d="M80 12 Q90 14 96 30 Q100 50 104 72 M80 12 Q86 22 90 46"></path>
				<path class="ln" d="M24 98 V12 M20 12 h8 M20 98 h8"></path>
				<text class="t-small" x="30" y="58">140&nbsp;м</text>
			</svg>
			<p>Фонтан в Женеве</p>
		</div>
		<div class="svuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Башня невесомости: внутри трубы, из которой откачан воздух, падает капсула">
				<rect class="svuses__sky" x="0" y="0" width="160" height="120"></rect>
				<path class="svuses__tower" d="M66 112 L70 10 Q80 2 90 10 L94 112 Z"></path>
				<rect class="svuses__tube" x="75" y="16" width="10" height="92"></rect>
				<rect class="svuses__capsule" x="76.5" y="44" width="7" height="14" rx="3"></rect>
				<path class="ln-dash" d="M80 22 V42"></path>
				<rect class="svuses__ground" x="0" y="110" width="160" height="10"></rect>
				<path class="ln" d="M104 16 V108 M100 16 h8 M100 108 h8"></path>
				<text class="t-small" x="110" y="58">110&nbsp;м</text>
				<text class="t-small" x="110" y="72">4,74&nbsp;с</text>
			</svg>
			<p>Башня невесомости</p>
		</div>
	</div>
</figure>

<style is:global>
	.svuses__cell p {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.svuses__ground {
		fill: var(--g7-ground);
	}
	.svuses__shaft {
		fill: var(--g7-paper);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.svuses__brick {
		fill: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-4));
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.svuses__water,
	.svuses__lake {
		fill: var(--g7-water);
	}
	.svuses__stone {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.svuses__stone--ghost {
		opacity: 0.4;
	}
	.svuses__splash,
	.svuses__spray {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.svuses__sky {
		fill: var(--g7-sky);
	}
	.svuses__suit {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.svuses__limb {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 3.2;
		stroke-linecap: round;
	}
	.svuses__head {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.svuses__canopy {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.svuses__line {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.6;
	}
	.svuses__hills {
		fill: color-mix(in oklab, hsl(150, 40%, 40%) 50%, var(--sl-color-gray-5));
	}
	.svuses__jet {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-white));
	}
	.svuses__tower {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.svuses__tube {
		fill: var(--g7-paper);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.svuses__capsule {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
</style>
