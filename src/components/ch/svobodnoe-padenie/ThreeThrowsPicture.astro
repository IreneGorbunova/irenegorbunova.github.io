---
/**
 * Picture «Три броска с балкона»: the front of a house with a balcony; the top of its rail is 10 м above the ground
 * (y₀ = 10 м). Axis Oy vertical, up, its origin on the ground. Three balls leave three marked points of the rail at the
 * same moment: thrown up at 5 м/с (orange), dropped (white), thrown down at 5 м/с (pink). One law for all three:
 * υ_y = υ0y − g t, y = y0 + υ0y t − g t²/2, g = 9,8 м/с², no air. They reach the ground after 2,03; 1,43 and 1,01 с
 * (the first and the third with the same speed 14,9 м/с, the second with 14,0 м/с); the up-thrown ball first rises
 * 1,28 м in 0,51 с. These numbers are NOT printed: the questions of the chapter use them.
 * Scale 21 px per metre vertically. The three starting points are 1,4 м apart along the rail (more than the 0,6 м of a
 * real throw, so that the arrows do not overlap); the balls are drawn about twice their size. Faint copies every
 * 0,25 с (filled on the way up, rings on the way down). Blue arrows: the velocity, 3 px per м/с; red arrows: g, the
 * same length on every ball at every moment. Real time; the balls rest on the ground until the last has landed, the
 * picture holds 1,5 с and repeats.
 */
import G7Styles from '../g7/G7Styles.astro';

const GY = 268; // the ground
const PXM = 21;
const y = (m: number) => GY - m * PXM;
const XS = [146, 176, 206];
const floors = [0, 3, 6, 9];
---

<G7Styles />
<figure class="g7 thr not-content" data-thr>
	<div class="g7__grid">
	<svg class="g7__svg" viewBox="0 0 340 290" role="img" aria-label="Три мяча одновременно покидают перила балкона на высоте 10 метров: один брошен вверх, другой отпущен, третий брошен вниз. Все три падают с одним и тем же ускорением и приземляются в разное время" data-svg>
		<rect class="thr__sky" x="0" y="0" width="340" height={GY}></rect>
		<!-- the house: a facade 4 floors high, the balcony on the 4th floor -->
		<rect class="thr__wall" x="20" y={y(12.6)} width="236" height={12.6 * PXM}></rect>
		<rect class="thr__roof" x="14" y={y(12.9)} width="248" height="7"></rect>
		{floors.map((f) => [36, 214].map((x) => <rect class="thr__win" x={x} y={y(f + 2.3)} width="26" height={1.5 * PXM} rx="1" />))}
		{[3, 6].map((f) => [96, 150].map((x) => <rect class="thr__win" x={x} y={y(f + 2.3)} width="26" height={1.5 * PXM} rx="1" />))}
		<rect class="thr__door" x="118" y={y(2.2)} width="30" height={2.2 * PXM}></rect>
		<!-- the balcony door and window behind the rail -->
		<rect class="thr__door" x="98" y={y(11.3)} width="24" height={2.3 * PXM}></rect>
		<rect class="thr__win" x="150" y={y(11.3)} width="26" height={1.5 * PXM} rx="1"></rect>
		<!-- the balcony: slab at 9 м, rail 1 м high with bars, three marked points on its top -->
		<rect class="thr__slab" x="84" y={y(9) - 1} width="152" height="8"></rect>
		<path class="thr__bars" d={Array.from({ length: 18 }, (_, i) => `M${92 + i * 8} ${y(9) - 1} V${y(10)}`).join(' ')}></path>
		<rect class="thr__rail" x="88" y={y(10) - 1.5} width="144" height="3.5" rx="1"></rect>
		{XS.map((x) => <path class="thr__mark" d={`M${x - 4} ${y(10) - 1.5} L${x + 4} ${y(10) - 1.5}`} />)}
		<!-- a tree and the ground -->
		<rect class="thr__trunk" x="279" y={y(3.2)} width="6" height={3.2 * PXM}></rect>
		<circle class="thr__crown" cx="282" cy={y(4.4)} r="22"></circle>
		<circle class="thr__crown" cx="268" cy={y(3.4)} r="14"></circle>
		<rect class="thr__ground" x="0" y={GY} width="340" height="22"></rect>
		<!-- the axis Oy: origin on the ground, y₀ = 10 м marked -->
		<line class="ln" x1="318" x2="318" y1={GY} y2={y(12.6)}></line>
		<path class="head--ink" d={`M314 ${y(12.6) + 6} L318 ${y(12.6) - 2} L322 ${y(12.6) + 6} Z`}></path>
		<text class="thr__lab t-i" x="324" y={y(12.4)}>y</text>
		{[0, 5, 10].map((m) => (
			<>
				<line class="ln" x1="314" x2="322" y1={y(m)} y2={y(m)} />
				<text class="thr__lab thr__halo" x="310" y={y(m) + 4} text-anchor="end">{m}</text>
			</>
		))}
		<text class="thr__lab" x="324" y={GY + 15}>м</text>
		<line class="thr__y0" x1={XS[2] + 14} x2="314" y1={y(10)} y2={y(10)}></line>
		<text class="thr__lab thr__halo" x="266" y={y(10) + 15}><tspan class="t-i">y</tspan><tspan baseline-shift="sub" font-size="11.5">0</tspan></text>
		<!-- the strobe copies, the balls, their arrows -->
		{XS.map((_, i) => <g data-ghosts={i} />)}
		{XS.map((x, i) => (
			<g data-ball={i}>
				<line class="arrow arrow--blue" data-va={i} x1={x} x2={x} />
				<path class="head--blue" data-vh={i} />
				<line class="arrow arrow--red" x1={x + 9} x2={x + 9} y1="0" y2="15" data-ga={i} />
				<path class="head--red" data-gh={i} />
				<circle class={`thr__ball thr__ball--${i}`} cx={x} r="4.2" data-bc={i} />
			</g>
		))}
		<text class="thr__lab" x="8" y={GY + 16} data-clock></text>
	</svg>
	<ul class="thr__legend">
		<li><span class="thr__dot thr__ball--0"></span><span>брошен вверх: <i>υ</i><sub>0<i>y</i></sub>&nbsp;=&nbsp;+5&nbsp;м/с</span></li>
		<li><span class="thr__dot thr__ball--1"></span><span>отпущен: <i>υ</i><sub>0<i>y</i></sub>&nbsp;=&nbsp;0</span></li>
		<li><span class="thr__dot thr__ball--2"></span><span>брошен вниз: <i>υ</i><sub>0<i>y</i></sub>&nbsp;=&nbsp;−5&nbsp;м/с</span></li>
		<li class="thr__all"><span>у всех трёх <i>y</i><sub>0</sub>&nbsp;=&nbsp;10&nbsp;м и <i>g<sub>y</sub></i>&nbsp;=&nbsp;−9,8&nbsp;м/с²</span></li>
	</ul>
	</div>
	<figcaption class="g7__caption">
		Три мяча покидают перила одновременно. Синие стрелки — скорость, красные — ускорение <i>g</i>, одинаковое у всех мячей в любой момент; бледные копии — положения через каждые 0,25&nbsp;с. Высота в масштабе, мячи нарисованы крупнее и разнесены шире, чем на самом деле; время идёт как в жизни.
	</figcaption>
</figure>

<style is:global>
	.thr .g7__svg {
		max-width: 26rem;
		margin-inline: auto;
	}
	.thr__sky {
		fill: var(--g7-sky);
	}
	.thr__wall {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.thr__roof,
	.thr__slab {
		fill: var(--sl-color-gray-4);
	}
	.thr__win {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.thr__door {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.thr__bars {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.thr__rail {
		fill: var(--sl-color-gray-2);
	}
	.thr__mark {
		stroke: var(--g7-gold);
		stroke-width: 2.4;
	}
	.thr__trunk {
		fill: var(--g7-wood-dark);
	}
	.thr__crown {
		fill: hsl(130, 30%, 38%);
	}
	.thr__ground {
		fill: var(--g7-ground);
	}
	.thr__y0 {
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.thr .g7__svg .thr__lab {
		font-size: 12.5px;
		fill: var(--sl-color-gray-2);
	}
	.thr .g7__svg .thr__halo {
		paint-order: stroke;
		stroke: var(--g7-sky);
		stroke-width: 3px;
	}
	.thr__ball {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.thr__ball--0 {
		fill: hsl(28, 90%, 58%);
		background: hsl(28, 90%, 58%);
	}
	.thr__ball--1 {
		fill: hsl(0, 0%, 94%);
		background: hsl(0, 0%, 94%);
	}
	.thr__ball--2 {
		fill: hsl(330, 75%, 66%);
		background: hsl(330, 75%, 66%);
	}
	.thr__ghost {
		opacity: 0.4;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.7;
	}
	.thr__ghost--ring {
		fill: none !important;
		stroke-width: 1.3;
		opacity: 0.6;
	}
	.thr__ghost--ring.thr__ball--0 {
		stroke: hsl(28, 90%, 58%);
	}
	.thr__ghost--ring.thr__ball--1 {
		stroke: var(--sl-color-gray-2);
	}
	.thr__ghost--ring.thr__ball--2 {
		stroke: hsl(330, 75%, 66%);
	}
	.thr__legend {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
		align-self: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.thr__legend li {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.thr__legend .thr__all {
		margin-top: 0.3rem;
		color: var(--sl-color-gray-1);
	}
	.thr__dot {
		flex: none;
		display: inline-block;
		width: 0.8em;
		height: 0.8em;
		border-radius: 50%;
		border: 1px solid var(--sl-color-gray-1);
	}
</style>

<script>
	import { el, fmt, loop } from '../g7/kit';

	const G = 9.8;
	const GY = 268;
	const PXM = 21;
	const XS = [146, 176, 206];
	const V0 = [5, 0, -5];
	const Y0 = 10;
	const R = 4.2; // px, the ball as drawn
	const KV = 3; // px per м/с
	const GL = 18; // px, the g arrow
	const yOf = (m: number) => GY - m * PXM;
	// the ball's center reaches the ground line (y = 0): the landing times 2,03; 1,43; 1,01 с
	const land = V0.map((v) => (v + Math.sqrt(v * v + 2 * G * Y0)) / G);
	const END = Math.max(...land);
	const HOLD = 1.5;
	const head = (x: number, tip: number, dir: number, w = 3.3, l = 6) => `M${x - w} ${(tip - dir * l).toFixed(1)} L${x} ${tip.toFixed(1)} L${x + w} ${(tip - dir * l).toFixed(1)} Z`;
	for (const root of document.querySelectorAll<HTMLElement>('[data-thr]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let t = 0;
		const draw = () => {
			const tc = Math.min(t, END);
			for (let i = 0; i < 3; i++) {
				const s = Math.min(tc, land[i]);
				const down = s >= land[i];
				const ym = Y0 + V0[i] * s - (G * s * s) / 2;
				const vy = down ? 0 : V0[i] - G * s;
				// drawn bigger than to scale: the drawn ball rests on the ground with its center R px above it
				const cy = Math.min(yOf(ym), GY - R);
				$(`[data-bc="${i}"]`).setAttribute('cy', cy.toFixed(1));
				// the strobe copies every 0,25 с up to now
				const gh = $(`[data-ghosts="${i}"]`);
				gh.replaceChildren();
				for (let k = 0; k * 0.25 < s - 1e-6; k++) {
					const tk = k * 0.25;
					const yk = Y0 + V0[i] * tk - (G * tk * tk) / 2;
					const up = V0[i] - G * tk > 0;
					gh.append(el('circle', { class: `thr__ball thr__ball--${i} thr__ghost${up ? '' : ' thr__ghost--ring'}`, cx: XS[i], cy: Math.min(yOf(yk), GY - R).toFixed(1), r: R }));
				}
				// the velocity arrow along the ball's own vertical
				const L = Math.abs(vy) * KV;
				const va = $(`[data-va="${i}"]`);
				const vh = $(`[data-vh="${i}"]`);
				if (L > 4) {
					const dir = vy > 0 ? -1 : 1; // screen direction
					const y1 = cy + dir * R;
					const tip = y1 + dir * L;
					va.setAttribute('y1', y1.toFixed(1));
					va.setAttribute('y2', (tip - dir * 5).toFixed(1));
					va.setAttribute('opacity', '1');
					vh.setAttribute('d', head(XS[i], tip, dir));
				} else {
					va.setAttribute('opacity', '0');
					vh.setAttribute('d', '');
				}
				// g: the same arrow on every flying ball
				const ga = $(`[data-ga="${i}"]`);
				const gh2 = $(`[data-gh="${i}"]`);
				if (!down) {
					ga.setAttribute('y1', (cy - 2).toFixed(1));
					ga.setAttribute('y2', (cy - 2 + GL - 5).toFixed(1));
					ga.setAttribute('opacity', '1');
					gh2.setAttribute('d', head(XS[i] + 9, cy - 2 + GL, 1, 3, 5.5));
				} else {
					ga.setAttribute('opacity', '0');
					gh2.setAttribute('d', '');
				}
			}
			$('[data-clock]').textContent = `t = ${fmt(tc, 2)} с`;
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			if (t > END + HOLD) t = 0;
			draw();
			return true;
		});
	}
</script>
