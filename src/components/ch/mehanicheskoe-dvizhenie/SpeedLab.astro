---
/**
 * «Кто быстрее»: two movers go along a straight road 100 м long with speeds set by the sliders (1…10 м/с). The
 * clock of the model runs four times faster than a real one (so that a walker does not take a minute). The graph
 * shows the path of each against the time: a straight line, the steeper the faster. Road: 3,2 px per metre; graph:
 * 6,4 px per second and 1,2 px per metre.
 */
import G7Styles from '../g7/G7Styles.astro';

const X0 = 24;
const S = 3.2;
const GX = 34;
const GY = 318;
---

<G7Styles />
<figure class="g7 spd not-content" data-spd>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 370 340" role="img" aria-label="Два тела движутся по прямой дороге; ниже график зависимости пути от времени" data-svg>
			{[{ y: 52, k: 'a' }, { y: 100, k: 'b' }].map((r) => (
				<g>
					<line class="spd__lane" x1={X0} x2={X0 + 100 * S} y1={r.y} y2={r.y} />
					<line class={`spd__done spd__done--${r.k}`} data-done={r.k} x1={X0} x2={X0} y1={r.y} y2={r.y} />
					<circle class={`spd__mover spd__mover--${r.k}`} data-mover={r.k} cx={X0} cy={r.y} r="8" />
					<text class="t-strong t-num" x={X0 + 100 * S} y={r.y - 14} text-anchor="end" data-s={r.k}></text>
				</g>
			))}
			{Array.from({ length: 11 }, (_, i) => i * 10).map((m) => (
				<>
					<line class="ln" x1={X0 + m * S} x2={X0 + m * S} y1="112" y2="118" />
					<text class="t-small t-num" x={X0 + m * S} y="130" text-anchor="middle">{m}</text>
				</>
			))}
			<text class="t-small" x="364" y="142" text-anchor="end">путь, м</text>
			<text class="t-strong t-num" x={X0} y="24" data-clock>0,0 с</text>
			<!-- the graph of the path against the time -->
			<path class="ln" d={`M${GX} 190 V${GY} H${GX + 50 * 6.4}`}></path>
			{[0, 10, 20, 30, 40, 50].map((t) => <text class="t-small t-num" x={GX + t * 6.4} y={GY + 14} text-anchor="middle">{t}</text>)}
			{[0, 50, 100].map((m) => (
				<>
					<path class="ln-dash" d={`M${GX} ${GY - m * 1.2} H${GX + 320}`} />
					<text class="t-small t-num" x={GX - 4} y={GY - m * 1.2 + 4} text-anchor="end">{m}</text>
				</>
			))}
			<text class="t-small" x={GX + 4} y="186">путь, м</text>
			<text class="t-small" x="364" y={GY + 14} text-anchor="end">с</text>
			<polyline class="spd__line spd__line--a" data-line="a"></polyline>
			<polyline class="spd__line spd__line--b" data-line="b"></polyline>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Скорость первого тела</span>
				<output data-oa></output>
				<input type="range" min="1" max="10" step="0.5" value="2" data-va aria-label="Скорость первого тела, метры в секунду" />
			</label>
			<label class="g7__slider">
				<span>Скорость второго тела</span>
				<output data-ob></output>
				<input type="range" min="1" max="10" step="0.5" value="4" data-vb aria-label="Скорость второго тела, метры в секунду" />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Старт</button>
				<button type="button" class="g7__btn" data-pause aria-pressed="false">Пауза</button>
			</div>
			<ul class="g7__read" aria-live="off">
				<li class="spd__ra"><span>Первое тело: путь</span><b data-ra>0 м</b></li>
				<li class="spd__rb"><span>Второе тело: путь</span><b data-rb>0 м</b></li>
			</ul>
			<p class="g7__msg" data-msg>Задайте скорости и нажмите «Старт».</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Часы модели идут в четыре раза быстрее настоящих. Дорога длиной 100 м; тело, дошедшее до конца, останавливается.
	</figcaption>
</figure>

<style is:global>
	.spd__lane {
		stroke: var(--g7-faint);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.spd__done {
		stroke-width: 4;
		stroke-linecap: round;
	}
	.spd__done--a,
	.spd__line--a {
		stroke: var(--g7-blue);
	}
	.spd__done--b,
	.spd__line--b {
		stroke: var(--g7-gold);
	}
	.spd__mover--a {
		fill: var(--g7-blue);
	}
	.spd__mover--b {
		fill: var(--g7-gold);
	}
	.spd__line {
		fill: none;
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.spd .g7__read .spd__ra {
		box-shadow: inset 3px 0 0 var(--g7-blue);
	}
	.spd .g7__read .spd__rb {
		box-shadow: inset 3px 0 0 var(--g7-gold);
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';

	const X0 = 24;
	const S = 3.2;
	const GX = 34;
	const GY = 318;
	for (const root of document.querySelectorAll<HTMLElement>('[data-spd]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const v = { a: q<HTMLInputElement>('[data-va]'), b: q<HTMLInputElement>('[data-vb]') };
		const pause = q<HTMLButtonElement>('[data-pause]');
		const msg = q<HTMLElement>('[data-msg]');
		let t = -1;
		const labels = () => {
			q('[data-oa]').textContent = `${fmt(Number(v.a.value), 1)} м/с`;
			q('[data-ob]').textContent = `${fmt(Number(v.b.value), 1)} м/с`;
		};
		const show = (time: number) => {
			q('[data-clock]').textContent = `${fmt(time, 1)} с`;
			for (const k of ['a', 'b'] as const) {
				const speed = Number(v[k].value);
				const s = Math.min(100, speed * time);
				const x = X0 + s * S;
				q(`[data-mover="${k}"]`).setAttribute('cx', x.toFixed(1));
				q(`[data-done="${k}"]`).setAttribute('x2', x.toFixed(1));
				q(`[data-s="${k}"]`).textContent = `${fmt(s, 1)} м`;
				q(`[data-r${k}]`).textContent = `${fmt(s, 1)} м`;
				// the line of the graph: straight up to the finish, level after it
				const tf = 100 / speed;
				const pts = [`${GX},${GY}`, `${(GX + Math.min(time, tf, 50) * 6.4).toFixed(1)},${(GY - Math.min(100, speed * Math.min(time, 50)) * 1.2).toFixed(1)}`];
				if (time > tf && tf < 50) pts.push(`${(GX + Math.min(time, 50) * 6.4).toFixed(1)},${GY - 120}`);
				q(`[data-line="${k}"]`).setAttribute('points', pts.join(' '));
			}
		};
		const wake = loop(root, (dt) => {
			if (t < 0 || pause.getAttribute('aria-pressed') === 'true') return false;
			t += dt * 4;
			show(t);
			const ta = 100 / Number(v.a.value);
			const tb = 100 / Number(v.b.value);
			if (t >= Math.max(ta, tb)) {
				show(Math.max(ta, tb));
				t = -1;
				msg.textContent = `Первое тело прошло 100 м за ${fmt(ta, 1)} с, второе — за ${fmt(tb, 1)} с. ${ta === tb ? 'Скорости одинаковы.' : `Быстрее ${ta < tb ? 'первое' : 'второе'}: его линия на графике круче.`}`;
				return false;
			}
			return true;
		});
		q('[data-go]').addEventListener('click', () => {
			t = 0;
			pause.setAttribute('aria-pressed', 'false');
			pause.textContent = 'Пауза';
			msg.textContent = 'Тела движутся…';
			wake();
		});
		pause.addEventListener('click', () => {
			const on = pause.getAttribute('aria-pressed') !== 'true';
			pause.setAttribute('aria-pressed', String(on));
			pause.textContent = on ? 'Продолжить' : 'Пауза';
			if (!on) wake();
		});
		for (const k of ['a', 'b'] as const)
			v[k].addEventListener('input', () => {
				labels();
				t = -1;
				show(0);
				msg.textContent = 'Задайте скорости и нажмите «Старт».';
			});
		labels();
		show(0);
	}
</script>
