---
/**
 * «Движется или покоится»: a train carriage with a passenger and a suitcase rolls past a platform with a tree and a
 * station attendant. The reader chooses the body relative to which the motion is looked at: the platform (the
 * carriage rolls to the right, 4 м/с on the picture's scale of 12 px per metre) or the carriage (the platform, the
 * tree and the attendant go to the left at the same speed). The table says for each body whether it moves or is at
 * rest relative to the chosen one.
 */
import G7Styles from '../g7/G7Styles.astro';

const windows = [16, 62, 108];
const ROWS = [
	{ key: 'car', name: 'Вагон', onTrain: true },
	{ key: 'man', name: 'Пассажир', onTrain: true },
	{ key: 'bag', name: 'Чемодан на полке', onTrain: true },
	{ key: 'tree', name: 'Дерево', onTrain: false },
	{ key: 'guard', name: 'Дежурный по станции', onTrain: false },
];
---

<G7Styles />
<figure class="g7 rell not-content" data-rell>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 200" role="img" aria-label="Вагон с пассажиром едет мимо платформы с деревом и дежурным" data-svg>
			<rect class="rell__sky" x="0" y="0" width="360" height="150"></rect>
			<g data-ground>
				<g data-repeat>
					<rect class="rell__house" x="20" y="86" width="60" height="44"></rect>
					<path class="rell__roof" d="M14 86 L50 62 L86 86 Z"></path>
					<rect class="rell__door" x="42" y="104" width="16" height="26"></rect>
					<rect class="rell__trunk" x="147" y="96" width="6" height="34"></rect>
					<circle class="rell__crown" cx="150" cy="84" r="20"></circle>
					<circle class="rell__head" cx="236" cy="96" r="6"></circle>
					<path class="rell__guard" d="M228 130 V110 q0 -8 8 -8 q8 0 8 8 V130 Z"></path>
					<path class="rell__flag" d="M246 108 L258 98 M258 98 l10 4 l-10 4 z"></path>
				</g>
			</g>
			<rect class="rell__platform" x="0" y="130" width="360" height="10"></rect>
			<rect class="rell__bed" x="0" y="140" width="360" height="60"></rect>
			<line class="rell__rail" x1="0" x2="360" y1="186" y2="186"></line>
			<g data-train>
				<rect class="rell__car" x="0" y="118" width="152" height="56" rx="7"></rect>
				{windows.map((x) => <rect class="rell__win" x={x} y="126" width="30" height="24" rx="3" />)}
				<rect class="rell__bag" x="112" y="128" width="20" height="9" rx="2"></rect>
				<circle class="rell__head" cx="78" cy="136" r="6.5"></circle>
				<path class="rell__man" d="M69 150 q9 -9 18 0 z"></path>
				<circle class="rell__wheel" cx="30" cy="178" r="8"></circle>
				<circle class="rell__wheel" cx="122" cy="178" r="8"></circle>
			</g>
		</svg>
		<div class="g7__side">
			<p class="g7__label">Смотрим относительно</p>
			<div class="g7__seg" role="group" aria-label="Относительно какого тела рассматривать движение" data-view>
				<button type="button" class="g7__btn" aria-pressed="true" data-v="ground">платформы</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-v="train">вагона</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				{ROWS.map((r) => <li><span>{r.name}</span><b data-row={r.key} data-on={r.onTrain ? '1' : '0'} /></li>)}
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Одно и то же движение можно описать по-разному — смотря по тому, относительно какого тела за ним следить.
	</figcaption>
</figure>

<style is:global>
	.rell__sky {
		fill: var(--g7-sky);
	}
	.rell__house {
		fill: color-mix(in oklab, var(--ig-v) 34%, var(--sl-color-gray-5));
		stroke: var(--g7-line);
	}
	.rell__roof {
		fill: color-mix(in oklab, var(--ig-vy) 50%, var(--sl-color-gray-4));
	}
	.rell__door {
		fill: var(--g7-wood-dark);
	}
	.rell__trunk {
		fill: hsl(28, 40%, 36%);
	}
	.rell__crown {
		fill: hsl(120, 42%, 40%);
	}
	.rell__head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	.rell__guard {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-gray-4));
	}
	.rell__flag {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.rell__platform {
		fill: var(--sl-color-gray-4);
	}
	.rell__bed {
		fill: var(--g7-ground);
	}
	.rell__rail {
		stroke: var(--g7-ink);
		stroke-width: 3;
	}
	.rell__car {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.rell__win {
		fill: var(--g7-paper);
		stroke: var(--g7-line);
	}
	.rell__bag {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rell__man {
		fill: var(--g7-red);
	}
	.rell__wheel {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.rell [data-row].is-move {
		color: var(--g7-gold);
	}
</style>

<script>
	import { loop, segment } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-rell]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const ground = q<SVGGElement>('[data-ground]');
		const train = q<SVGGElement>('[data-train]');
		// the ground scenery repeats every 360 px, so that it can pass by endlessly
		const rep = q<SVGGElement>('[data-repeat]');
		for (const dx of [-360, 360]) {
			const c = rep.cloneNode(true) as SVGGElement;
			c.setAttribute('transform', `translate(${dx} 0)`);
			ground.append(c);
		}
		let view = 'ground';
		let s = 0; // how far the carriage has gone along the platform, px
		const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
		const table = () => {
			for (const r of rows) {
				const moves = (r.dataset.on === '1') !== (view === 'train');
				r.textContent = moves ? 'движется' : 'покоится';
				r.classList.toggle('is-move', moves);
			}
		};
		loop(root, (dt) => {
			s = (s + 48 * dt) % 23040; // 4 м/с at 12 px per metre; 23040 is a whole number of both periods below
			if (view === 'ground') {
				ground.setAttribute('transform', 'translate(0 0)');
				// the carriage leaves on the right and comes back from the left (a path of 512 px)
				train.setAttribute('transform', `translate(${(((s + 160) % 512) - 152).toFixed(1)} 0)`);
			} else {
				// the scenery repeats every 360 px and passes at the same speed the other way
				train.setAttribute('transform', 'translate(104 0)');
				ground.setAttribute('transform', `translate(${(-(s % 360)).toFixed(1)} 0)`);
			}
			return true;
		});
		segment(q('[data-view]'), (b) => {
			view = b.dataset.v!;
			table();
		});
		table();
	}
</script>
