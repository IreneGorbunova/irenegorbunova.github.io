---
/**
 * Two short looping opening scenes of «Механическое движение. Траектория. Путь. Перемещение. Скорость». No terms of the chapter in the pictures.
 * Train: the same seconds seen twice. Above, from the platform: the carriage with a passenger rolls to the right
 *   past a tree. Below, from the carriage: the passenger and the carriage stand still, and the tree goes to the left
 *   at the same speed. One motion, two descriptions.
 * Race: a pedestrian (1,4 м/с), a cyclist (5 м/с) and a car (15 м/с) start together and move for 4 real seconds
 *   along a ruler in metres (5,6 px per metre): 5,6 м, 20 м and 60 м.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const windows = [14, 54, 94];
---

<IntroFrame data-moveintro>
	<div class="intro__card" data-scene="train">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Сверху вид с платформы: вагон с пассажиром едет мимо дерева. Снизу вид из вагона: пассажир неподвижен, а дерево уезжает назад">
			<rect class="mv-sky" x="0" y="0" width="360" height="240"></rect>
			<text class="mv-label" x="10" y="16">с платформы: вагон едет</text>
			<rect class="mv-ground" x="0" y="96" width="360" height="14"></rect>
			<g data-tree1>
				<rect class="mv-trunk" x="-3" y="66" width="6" height="30"></rect>
				<circle class="mv-crown" cx="0" cy="56" r="17"></circle>
			</g>
			<g data-car1>
				<rect class="mv-car" x="0" y="42" width="134" height="46" rx="6"></rect>
				{windows.map((x) => <rect class="mv-win" x={x} y="50" width="28" height="20" rx="3" />)}
				<circle class="mv-head" cx="68" cy="58" r="6"></circle>
				<path class="mv-body" d="M60 70 q8 -8 16 0 v0 z"></path>
				<circle class="mv-wheel" cx="26" cy="90" r="7"></circle>
				<circle class="mv-wheel" cx="108" cy="90" r="7"></circle>
			</g>
			<line class="mv-sep" x1="0" y1="122" x2="360" y2="122"></line>
			<text class="mv-label" x="10" y="138">из вагона: дерево уезжает назад</text>
			<rect class="mv-ground" x="0" y="218" width="360" height="14"></rect>
			<g data-tree2>
				<rect class="mv-trunk" x="-3" y="188" width="6" height="30"></rect>
				<circle class="mv-crown" cx="0" cy="178" r="17"></circle>
			</g>
			<g transform="translate(113 122)">
				<rect class="mv-car" x="0" y="42" width="134" height="46" rx="6"></rect>
				{windows.map((x) => <rect class="mv-win" x={x} y="50" width="28" height="20" rx="3" />)}
				<circle class="mv-head" cx="68" cy="58" r="6"></circle>
				<path class="mv-body" d="M60 70 q8 -8 16 0 v0 z"></path>
				<circle class="mv-wheel" cx="26" cy="90" r="7"></circle>
				<circle class="mv-wheel" cx="108" cy="90" r="7"></circle>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Пассажир сидит в вагоне неподвижно — и в то же время едет мимо дерева.{' '}
				<More term="Всё зависит от того, относительно чего смотреть">
					Относительно вагона пассажир покоится, относительно дерева — движется. А если смотреть из вагона, движется дерево. Говоря о движении, всегда нужно сказать, относительно какого тела оно происходит. Об этом — в разделе{' '}
					<a href="#механическое-движение">«Механическое движение»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="race">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Пешеход, велосипедист и автомобиль стартуют одновременно. За четыре секунды пешеход проходит 5,6 метра, велосипедист 20 метров, автомобиль 60 метров">
			<rect class="mv-sky" x="0" y="0" width="360" height="240"></rect>
			{
				[
					{ y: 66, name: 'пешеход', key: 'a' },
					{ y: 116, name: 'велосипедист', key: 'b' },
					{ y: 166, name: 'автомобиль', key: 'c' },
				].map((r) => (
					<g>
						<line class="mv-lane" x1="12" x2="352" y1={r.y} y2={r.y} />
						<line class="mv-done" data-done={r.key} x1="12" x2="12" y1={r.y} y2={r.y} />
						<text class="mv-label" x="12" y={r.y - 26}>{r.name}</text>
						<text class="mv-num" x="352" y={r.y - 26} text-anchor="end" data-s={r.key}></text>
					</g>
				))
			}
			<g data-m="a"><circle class="mv-head" cx="0" cy="-16" r="4.5"></circle><path class="mv-stick" d="M0 -11 V-3 M0 -3 L-3 0 M0 -3 L3 0 M-3 -8 H3"></path></g>
			<g data-m="b"><circle class="mv-bwheel" cx="-7" cy="-5" r="5"></circle><circle class="mv-bwheel" cx="7" cy="-5" r="5"></circle><path class="mv-stick" d="M-7 -5 L0 -12 L7 -5 M0 -12 V-16"></path><circle class="mv-head" cx="0" cy="-19" r="3.6"></circle></g>
			<g data-m="c"><path class="mv-auto" d="M-16 -4 v-6 h7 l4 -6 h12 l4 6 h5 v6 Z"></path><circle class="mv-wheel" cx="-9" cy="-3" r="3.5"></circle><circle class="mv-wheel" cx="9" cy="-3" r="3.5"></circle></g>
			<!-- the ruler: 0…60 м -->
			<line class="mv-rule" x1="12" x2="348" y1="196" y2="196"></line>
			{Array.from({ length: 13 }, (_, i) => i * 5).map((m) => <line class="mv-rule" x1={12 + m * 5.6} x2={12 + m * 5.6} y1="196" y2={m % 10 === 0 ? 205 : 201} />)}
			{[0, 10, 20, 30, 40, 50, 60].map((m) => <text class="mv-small" x={12 + m * 5.6} y="217" text-anchor="middle">{m}</text>)}
			<text class="mv-small" x="352" y="231" text-anchor="end">метры</text>
			<text class="mv-clock" x="180" y="22" text-anchor="middle" data-clock>0,0 с</text>
		</svg>
		<div class="intro__foot">
			<p>
				Пешеход, велосипедист и автомобиль тронулись одновременно. За одни и те же четыре секунды они проходят{' '}
				<More term="разные пути">
					Пешеход — около 6&nbsp;м, велосипедист — 20&nbsp;м, автомобиль — 60&nbsp;м. Чтобы сравнивать, кто движется быстрее, смотрят, какой путь тело проходит за одну секунду. Эту величину называют скоростью. Об этом — в разделе{' '}
					<a href="#скорость">«Скорость»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-moveintro] .mv-sky {
		fill: var(--sl-color-bg);
	}
	[data-moveintro] .mv-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-moveintro] .mv-ground {
		fill: color-mix(in oklab, hsl(110, 30%, 42%) 60%, var(--sl-color-bg));
	}
	[data-moveintro] .mv-trunk {
		fill: hsl(28, 40%, 36%);
	}
	[data-moveintro] .mv-crown {
		fill: hsl(120, 42%, 40%);
	}
	[data-moveintro] .mv-car {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-moveintro] .mv-win {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-moveintro] .mv-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-moveintro] .mv-body {
		fill: var(--ig-vy);
	}
	[data-moveintro] .mv-wheel {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-moveintro] .mv-sep {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	[data-moveintro] .mv-lane {
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}
	[data-moveintro] .mv-done {
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-moveintro] .mv-num {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-moveintro] .mv-stick {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-moveintro] .mv-bwheel {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
	}
	[data-moveintro] .mv-auto {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	[data-moveintro] .mv-rule {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-moveintro] .mv-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-moveintro] .mv-clock {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ru = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
	for (const root of document.querySelectorAll<HTMLElement>('[data-moveintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="train"]')!;
			const car1 = card.querySelector<SVGGElement>('[data-car1]')!;
			const tree1 = card.querySelector<SVGGElement>('[data-tree1]')!;
			const tree2 = card.querySelector<SVGGElement>('[data-tree2]')!;
			scene(card, 6, (x) => {
				// from the platform the carriage goes from x = −20 to 246; from the carriage the tree goes the other way
				const cx = -20 + 266 * x;
				car1.setAttribute('transform', `translate(${cx.toFixed(1)} 0)`);
				tree1.setAttribute('transform', 'translate(290 0)');
				// the carriage of the lower picture stands at x = 113: the tree is where it is relative to the carriage
				tree2.setAttribute('transform', `translate(${(290 - cx + 113).toFixed(1)} 0)`);
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="race"]')!;
			const clock = card.querySelector<SVGTextElement>('[data-clock]')!;
			const movers = [
				{ key: 'a', v: 1.4, y: 66 },
				{ key: 'b', v: 5, y: 116 },
				{ key: 'c', v: 15, y: 166 },
			].map((m) => ({ ...m, g: card.querySelector<SVGGElement>(`[data-m="${m.key}"]`)!, s: card.querySelector<SVGTextElement>(`[data-s="${m.key}"]`)!, done: card.querySelector<SVGLineElement>(`[data-done="${m.key}"]`)! }));
			scene(card, 4, (x) => {
				const t = 4 * x;
				clock.textContent = `${ru(t)} с`;
				for (const m of movers) {
					const s = m.v * t;
					const px = 12 + s * 5.6;
					m.g.setAttribute('transform', `translate(${px.toFixed(1)} ${m.y})`);
					m.done.setAttribute('x2', px.toFixed(1));
					m.s.textContent = `${ru(s, s < 10 ? 1 : 0)} м`;
				}
			});
		}
	}
</script>
