---
/** Global styles of the engine drawing built by engine.ts (shared by EngineLab and StrokeQuiz). */
---

<style is:global>
	.td-eng {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.td-metal {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.td-jacket {
		fill: var(--ig-vx);
		opacity: 0.18;
	}
	.td-port {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		transition: fill 0.3s;
	}
	.td-port--in.is-open {
		fill: color-mix(in srgb, var(--ig-vx) 22%, var(--sl-color-gray-6));
	}
	.td-port--ex.is-open {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 30%, var(--sl-color-gray-6));
	}
	.td-pipe {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.td-gas-bg {
		fill: var(--sl-color-gray-4);
	}
	.td-gas-fresh {
		fill: var(--ig-vx);
	}
	.td-gas-hot {
		fill: var(--ig-vy);
	}
	.td-fl0 {
		stop-color: #fff6c8;
		stop-opacity: 1;
	}
	.td-fl1 {
		stop-color: var(--ig-v);
		stop-opacity: 0.9;
	}
	.td-fl2 {
		stop-color: var(--ig-vy);
		stop-opacity: 0;
	}
	.td-spray {
		fill: var(--ig-v);
	}
	.td-pt {
		transition: opacity 0.25s;
	}
	.td-pt--fresh {
		fill: var(--ig-vx);
	}
	.td-pt--burnt {
		fill: var(--sl-color-gray-2);
	}
	.td-stem {
		fill: var(--sl-color-gray-3);
	}
	.td-vhead {
		fill: var(--sl-color-gray-2);
	}
	.td-spring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.td-ceramic {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-4);
	}
	.td-electrode {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.td-spark {
		fill: #fffbe0;
		filter: drop-shadow(0 0 6px var(--ig-v)) drop-shadow(0 0 3px #fff);
		opacity: 0;
	}
	.td-rod {
		stroke: var(--sl-color-gray-3);
		stroke-width: 12;
		stroke-linecap: round;
	}
	.td-web {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.td-journal {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.td-piston {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.td-ring {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}
	.td-fly-rim {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 12;
	}
	.td-fly-in {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.td-fly-spoke {
		stroke: var(--sl-color-gray-5);
		stroke-width: 6;
		stroke-linecap: round;
	}
	.td-fly-mark {
		fill: var(--sl-color-accent);
	}
	.td-force {
		stroke: var(--ig-vy);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.td-ahead {
		fill: var(--ig-vy);
	}
	.td-flab {
		fill: var(--ig-vy);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 700;
		font-size: 15px;
	}
	.td-motion {
		stroke: var(--sl-color-accent);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.td-mhead {
		fill: var(--sl-color-accent);
	}
	.td-labels text {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
		font-family: var(--__sl-font);
	}
	.td-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	/* tappable parts (EngineLab): an invisible hit area and an outline that lights up */
	.td-hit {
		fill: transparent;
		stroke: transparent;
		pointer-events: all;
	}
	.td-part,
	.td-cap {
		cursor: pointer;
		outline: none;
	}
	.td-hl {
		fill: var(--sl-color-accent);
		fill-opacity: 0.3;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s;
	}
	.td-hl--ring {
		fill: none;
		stroke-width: 14;
		stroke-opacity: 0.5;
	}
	.td-hl--rod {
		stroke-width: 15;
		stroke-opacity: 0.5;
		stroke-linecap: round;
	}
	.td-part:hover .td-hl,
	.td-part:focus-visible .td-hl,
	.td-part[aria-expanded='true'] .td-hl,
	.td-part.is-hl .td-hl {
		opacity: 1;
	}
	.td-cap:hover text,
	.td-cap.is-hl text {
		fill: var(--sl-color-text-accent);
	}
	@media (prefers-reduced-motion: reduce) {
		.td-pt,
		.td-port {
			transition: none;
		}
	}
</style>
