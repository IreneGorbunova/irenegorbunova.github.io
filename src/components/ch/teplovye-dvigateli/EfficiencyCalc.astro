</style>

<script>
	import katex from 'katex';

	const comma = (s: string) => s.replace('.', '{,}');
	/** 2,76·10^7 style, three significant digits at most. */
	const sci = (v: number) => {
		const k = Math.floor(Math.log10(v) + 1e-9);
		const a = Number((v / 10 ** k).toPrecision(3));
		return `${comma(String(a))}\\cdot 10^{${k}}`;
	};
	const num = (v: number, maxDec = 1) => {
		const r = Number(v.toFixed(maxDec));
		return comma(String(r));
	};
	const txt = (v: number, maxDec = 1) => String(Number(v.toFixed(maxDec))).replace('.', ',').replace('-', '−');
	/** η as in the formula: whole percent from 10 % up, one decimal below; «≈» when rounded. */
	const etaParts = (eta: number) => {
		const dec = eta >= 10 ? 0 : 1;
		const r = Number(eta.toFixed(dec));
		return { sign: Math.abs(eta - r) > 1e-9 ? '≈' : '=', tex: num(eta, dec), text: txt(eta, dec) };
	};
	/** Cubic band edge with control points at the middle of its length: y(u) = y0 + (y1 − y0)·(3u² − 2u³). */
	const ease = (u: number) => 3 * u * u - 2 * u * u * u;
	const along = (u: number) => 1.5 * u * (1 - u) + u * u * u;
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-tdc]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const mIn = q<HTMLInputElement>('[data-m]');
		const aIn = q<HTMLInputElement>('[data-a]');
		const mOut = q<HTMLOutputElement>('[data-m-out]');
		const aOut = q<HTMLOutputElement>('[data-a-out]');
		const m1 = q<HTMLElement>('[data-math1]');
		const m2 = q<HTMLElement>('[data-math2]');
		const msg = q<HTMLElement>('[data-msg]');
		const line = q<HTMLElement>('[data-line]');
		const flow = q<HTMLElement>('[data-flow]');
		const el = (k: string) => flow.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
		const path = (k: string) => flow.querySelector<SVGPathElement>(`[data-p="${k}"]`)!;
		const fFuel = el('fuel');
		const fBurn = el('burn');
		const fQ = el('q');
		const fEta = el('eta');
		const fUse = el('use');
		const fLoss = el('loss');
		const pArrow = path('arrow');
		const pUse = path('use');
		const pLoss = path('loss');
		const pMiss = path('miss');
		const pCut = path('cut');
		const fuelBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-q]'));
		let fuel = fuelBtns[0];
		let st = { Q: 1, A: 0 };

		/** Lays the scheme out in px for the current width: horizontal from 560 px, vertical below. */
		const layout = () => {
			const W = flow.clientWidth;
			if (!W) return;
			const { Q, A } = st;
			const hor = W >= 560;
			flow.classList.toggle('is-v', !hor);
			const put = (e: HTMLElement, x: number, y: number, w?: number, h?: number) => {
				e.style.left = `${f1(x)}px`;
				e.style.top = `${f1(y)}px`;
				e.style.width = w === undefined ? '' : `${f1(w)}px`;
				e.style.height = h === undefined ? '' : `${f1(h)}px`;
			};
			// (s, t): s along the flow, t across it; horizontal: (x, y) = (s, t), vertical: (x, y) = (t, s).
			const P = (s: number, t: number) => (hor ? `${f1(s)} ${f1(t)}` : `${f1(t)} ${f1(s)}`);
			const band = (s0: number, a0: number, b0: number, s1: number, a1: number, b1: number) => {
				const sm = (s0 + s1) / 2;
				return `M${P(s0, a0)}C${P(sm, a0)} ${P(sm, a1)} ${P(s1, a1)}L${P(s1, b1)}C${P(sm, b1)} ${P(sm, b0)} ${P(s0, b0)}Z`;
			};
			const bad = A >= Q;
			let a0: number, a1: number; // the arrow «сгорает» runs from s = a0 to a1 at t = tAr
			let qs1: number, se: number, B: number, qt0: number, Hc: number, tAr: number;
			let gapHi: number; // the far side across the flow
			let tR = 0;
			let cut = false;
			// sizes
			if (hor) {
				const fw = 108;
				const lw = Math.min(230, Math.max(150, Math.round(W * 0.28)));
				a0 = fw + 6;
				a1 = fw + 60;
				const qs = fw + 66;
				const qw = 108;
				B = 124; // block height = Q_з
				qs1 = qs + qw;
				se = W - lw - 10;
				put(fUse, se + 10, 0, lw);
				put(fLoss, se + 10, 0, lw);
				const h1 = fUse.offsetHeight;
				const h2 = fLoss.offsetHeight;
				Hc = Math.max(B + 84, h1 + h2 + 16);
				qt0 = (Hc - B) / 2;
				tAr = Hc / 2;
				put(fFuel, 0, 0, fw);
				put(fFuel, 0, tAr - fFuel.offsetHeight / 2, fw);
				put(fBurn, a0, 0, a1 - a0);
				put(fBurn, a0, tAr - fBurn.offsetHeight - 5, a1 - a0);
				put(fQ, qs, qt0, qw, B);
				if (!bad) {
					const tA = (B * A) / Q;
					const tL = B - tA;
					fUse.style.top = `${f1(Math.min(Math.max(tA / 2 - h1 / 2, 0), Hc - h1 - h2 - 8))}px`;
					fLoss.style.top = `${f1(Math.max(Math.min(Hc - tL / 2 - h2 / 2, Hc - h2), h1 + 8))}px`;
				} else {
					tR = (B * (A - Q)) / Q;
					const tRmax = Hc - B - 30;
					if (tR > tRmax) [tR, cut] = [tRmax, true];
					fUse.style.top = `${f1(Math.max((tR + B) / 2 - h1 / 2, 0))}px`;
					fLoss.style.top = `${f1(Hc - h2)}px`;
				}
				gapHi = Hc;
			} else {
				const fw = Math.min(240, Math.round(W * 0.62));
				put(fFuel, (W - fw) / 2, 0, fw);
				const hf = fFuel.offsetHeight;
				a0 = hf + 5;
				a1 = hf + 41;
				tAr = W / 2;
				put(fBurn, W / 2 + 10, 0);
				put(fBurn, W / 2 + 10, (a0 + a1) / 2 - fBurn.offsetHeight / 2);
				const qs = hf + 46;
				const qh = 68;
				B = Math.round(W * 0.56); // block width = Q_з
				qt0 = (W - B) / 2;
				put(fQ, qt0, qs, B, qh);
				qs1 = qs + qh;
				se = qs1 + 100;
				const lw = W / 2 - 6;
				put(fUse, 0, se + 6, lw);
				put(fLoss, W / 2 + 6, se + 6, lw);
				Hc = se + 6 + Math.max(fUse.offsetHeight, fLoss.offsetHeight);
				if (bad) {
					tR = (B * (A - Q)) / Q;
					const tRmax = W - B - 90;
					if (tR > tRmax) [tR, cut] = [tRmax, true];
				}
				gapHi = W;
			}
			flow.style.height = `${f1(Hc)}px`;
			// arrow «сгорает»
			const hd = 7;
			pArrow.setAttribute('d', `M${P(a0, tAr)}L${P(a1, tAr)}M${P(a1 - hd, tAr - hd * 0.7)}L${P(a1, tAr)}L${P(a1 - hd, tAr + hd * 0.7)}`);
			// bands: the block's far edge spans t = qt0…qt1 (= Q_з); the ends lie at t = 0 (useful) and t = Hend (losses)
			const qt1 = qt0 + B;
			const Hend = hor ? Hc : gapHi;
			if (!bad) {
				const tA = (B * A) / Q;
				const tL = B - tA;
				pUse.setAttribute('d', tA > 0 ? band(qs1, qt0, qt0 + tA, se, 0, tA) : '');
				pLoss.setAttribute('d', tL > 0 ? band(qs1, qt0 + tA, qt1, se, Hend - tL, Hend) : '');
				pMiss.setAttribute('d', '');
				// η in the gap between the bands
				placeEta((sv) => [qt0 + tA + (tA - qt0 - tA) * sv, qt0 + tA + (Hend - tL - qt0 - tA) * sv]);
			} else {
				pUse.setAttribute('d', band(qs1, qt0, qt1, se, tR, tR + B));
				pLoss.setAttribute('d', '');
				pMiss.setAttribute('d', tR > 0 ? `M${P(qs1, qt0)}C${P((qs1 + se) / 2, qt0)} ${P((qs1 + se) / 2, 0)} ${P(se, 0)}L${P(se, tR)}C${P((qs1 + se) / 2, tR)} ${P((qs1 + se) / 2, qt0)} ${P(qs1, qt0)}Z` : '');
				// η beyond the useful band
				placeEta((sv) => [qt1 + (tR + B - qt1) * sv, Hend]);
			}
			// break marks across a capped wedge: it would be wider in scale
			if (cut) {
				const sc = se - 16;
				let d = `M${P(sc, -4)}`;
				for (let t = -4, k = 0; t < tR + 4; k++) {
					t = Math.min(t + 6, tR + 4);
					d += `L${P(sc + (k % 2 ? -4 : 4), t)}`;
				}
				pCut.setAttribute('d', d);
			} else pCut.setAttribute('d', '');

			/**
			 * Puts η where the free room between the bands is widest enough: gap(v) gives the t-range of that room
			 * at the band's eased fraction v; the label's whole extent along s is checked, from the split onwards.
			 */
			function placeEta(gap: (v: number) => [number, number]) {
				const w = fEta.offsetWidth;
				const h = fEta.offsetHeight;
				const ls = hor ? w : h; // extent along the flow
				const lt = hor ? h : w; // extent across it
				const L = se - qs1;
				const vAt = (s: number) => {
					const x = Math.min(Math.max((s - qs1) / L, 0), 1);
					let lo = 0;
					let hi = 1;
					for (let k = 0; k < 30; k++) {
						const mid = (lo + hi) / 2;
						if (along(mid) < x) lo = mid;
						else hi = mid;
					}
					return ease(lo);
				};
				let best: [number, number] = [qs1 + L - ls / 2, 0];
				let bestRoom = -Infinity;
				for (let sc = qs1 + ls / 2 + 4; sc <= se - ls / 2; sc += 2) {
					let lo = -Infinity;
					let hi = Infinity;
					for (let k = 0; k <= 8; k++) {
						const [a, b] = gap(vAt(sc - ls / 2 + (ls * k) / 8));
						lo = Math.max(lo, a);
						hi = Math.min(hi, b);
					}
					const room = hi - lo - lt;
					if (room >= 10) {
						best = [sc, (lo + hi) / 2];
						break;
					}
					if (room > bestRoom) [bestRoom, best] = [room, [sc, (lo + hi) / 2]];
				}
				const [sc, tc] = best;
				if (hor) put(fEta, sc - w / 2, tc - h / 2);
				else put(fEta, Math.min(Math.max(tc - w / 2, 0), W - w), sc - h / 2);
			}
		};

		const update = () => {
			const qv = Number(fuel.dataset.q);
			const m = Number(mIn.value);
			const A = Number(aIn.value); // MJ
			const Q = (qv * m) / 1e6; // MJ
			const eta = (100 * A) / Q;
			mOut.value = `${txt(m)} кг`;
			aOut.value = `${A} МДж`;
			const QJ = qv * m;
			katex.render(
				`\\begin{aligned}Q_\\text{з} &= qm = ${sci(qv)}~\\tfrac{\\text{Дж}}{\\text{кг}}\\cdot ${num(m)}~\\text{кг} \\\\ &= ${sci(QJ)}~\\text{Дж} = ${num(Q)}~\\text{МДж}\\end{aligned}`,
				m1,
				{ displayMode: true, throwOnError: false },
			);
			const e = etaParts(eta);
			// on a phone the second half goes to its own line, so the formula never scrolls
			const brk = root.clientWidth < 480 ? '\\\\ &' : '';
			katex.render(
				`\\begin{aligned}\\eta &= \\frac{A_\\text{п}}{Q_\\text{з}}\\cdot 100\\,\\% ${brk}= \\frac{${A}~\\text{МДж}}{${num(Q)}~\\text{МДж}}\\cdot 100\\,\\% ${e.sign === '≈' ? '\\approx' : '='} ${e.tex}\\,\\%\\end{aligned}`,
				m2,
				{ displayMode: true, throwOnError: false },
			);
			line.style.left = `${Math.min(100, eta)}%`;
			const bad = eta >= 100;
			msg.classList.toggle('is-bad', bad);
			if (bad)
				msg.textContent =
					'Так не бывает! Работа двигателя не может быть равна энергии сгоревшего топлива или больше неё: часть энергии обязательно уходит с выхлопом и на нагревание окружающих тел. КПД всегда меньше 100 %.';
			else if (eta > 65)
				msg.textContent = `Закон сохранения энергии такое позволяет, но таких тепловых двигателей пока нет: даже у лучших тепловых установок КПД около 60 %.`;
			else msg.textContent = `Полезная работа — ${txt(A)} МДж, а ${txt(Q - A)} МДж (${txt(100 - eta, 0)} %) уходит в окружающую среду, в основном в виде тепла.`;

			// the scheme
			q<HTMLElement>('[data-fname]').textContent = fuel.dataset.name!;
			q<HTMLElement>('[data-fm]').textContent = txt(m);
			q<HTMLElement>('[data-fq]').textContent = `${txt(Q)} МДж`;
			fEta.innerHTML = `<i>η</i> ${e.sign} ${e.text} %`;
			fEta.classList.toggle('is-bad', bad);
			const Ap = `<i>A</i><sub>п</sub>`;
			const Qp = `<i>Q</i><sub>пот</sub>`;
			fUse.innerHTML =
				`<span class="tdc__nw">${Ap} = <b>${A} МДж</b></span> — полезная работа` +
				(A > Q ? `<span class="tdc__bad">не хватает ${txt(A - Q)} МДж: взять неоткуда</span>` : '');
			fLoss.classList.toggle('is-bad', bad);
			fLoss.innerHTML =
				A > Q
					? `<span class="tdc__nw">${Qp} = <b>${txt(Q - A)} МДж</b></span><span class="tdc__bad">потери меньше нуля — так не бывает</span>`
					: A === Q
						? `<span class="tdc__nw">${Qp} = <b>0 МДж</b></span><span class="tdc__bad">без потерь — так не бывает</span>`
						: `<span class="tdc__nw">${Qp} = <b>${txt(Q - A)} МДж</b></span> — потери<small>выхлоп, охлаждение, трение</small>`;
			st = { Q, A };
			layout();
		};
		fuelBtns.forEach((b) =>
			b.addEventListener('click', () => {
				fuel = b;
				fuelBtns.forEach((x) => x.classList.toggle('is-on', x === b));
				update();
			}),
		);
		const tracks = root.querySelectorAll<HTMLElement>('.tdc__track');
		const fit = () => {
			const top = tracks[0].getBoundingClientRect().top;
			const axis = tracks[tracks.length - 1].getBoundingClientRect().top;
			line.style.height = `${axis - top + 4}px`;
		};
		new ResizeObserver(fit).observe(root);
		let lastW = 0;
		new ResizeObserver(() => {
			if (flow.clientWidth !== lastW) {
				lastW = flow.clientWidth;
				update();
			}
		}).observe(flow);
		document.fonts?.ready.then(layout);
		mIn.addEventListener('input', update);
		aIn.addEventListener('input', update);
		update();
	}
</script>
