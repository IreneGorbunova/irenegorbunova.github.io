---
/**
 * Live efficiency: choose a fuel, its mass and the useful work; Q = qm and η = A/Q·100 %
 * are recomputed as the sliders move, and η is compared with real engines.
 * The scheme under the sliders: fuel → «сгорает» → Q_з = qm → two bands, A_п (useful work) and
 * Q_пот (losses), their widths in scale (A_п + Q_пот = Q_з). A_п ≥ Q_з is impossible: the useful band
 * then takes the whole block, and the missing energy is a red dashed wedge «взять неоткуда».
 * Horizontal at ≥ 560 px, vertical below; laid out in px by the script (ResizeObserver).
 * q — rounded table values (Дж/кг), as in Пёрышкин's table.
 */
const fuels = [
	{ name: 'бензин', q: 4.6e7 },
	{ name: 'дизельное топливо', q: 4.2e7 },
	{ name: 'природный газ', q: 4.4e7 },
	{ name: 'каменный уголь', q: 2.7e7 },
	{ name: 'сухие дрова', q: 1.0e7 },
];
const engines = [
	{ name: 'паровоз', lo: 5, hi: 10 },
	{ name: 'бензиновый двигатель', lo: 20, hi: 40 },
	{ name: 'дизельный двигатель', lo: 30, hi: 50 },
	{ name: 'паровая турбина электростанции', lo: 35, hi: 45 },
];
---

<div class="tdc not-content" data-tdc>
	<div class="tdc__fuels" role="group" aria-label="Топливо">
		{fuels.map((f, i) => <button type="button" class={`tdc__fuel${i === 0 ? ' is-on' : ''}`} data-q={f.q} data-name={f.name}>{f.name}</button>)}
	</div>
	<div class="tdc__sliders">
		<label class="tdc__slider">
			<span>Масса сгоревшего топлива <i>m</i></span>
			<output data-m-out>2 кг</output>
			<input type="range" min="0.1" max="10" step="0.1" value="2" data-m />
		</label>
		<label class="tdc__slider">
			<span>Полезная работа двигателя <i>A</i><sub>п</sub></span>
			<output data-a-out>23 МДж</output>
			<input type="range" min="0" max="200" step="1" value="23" data-a />
		</label>
	</div>
	<div class="tdc__flow" data-flow>
		<svg class="tdc__fsvg" aria-hidden="true">
			<path class="tdc__farrow" data-p="arrow"></path>
			<path class="tdc__fband tdc__fband--loss" data-p="loss"></path>
			<path class="tdc__fband tdc__fband--use" data-p="use"></path>
			<path class="tdc__fband tdc__fband--miss" data-p="miss"></path>
			<path class="tdc__fcut" data-p="cut"></path>
		</svg>
		<div class="tdc__fbox tdc__fbox--fuel" data-f="fuel"><span data-fname>бензин</span><span class="tdc__nw"><i>m</i> = <b data-fm>2</b> кг</span></div>
		<div class="tdc__ftag" data-f="burn">сгорает</div>
		<div class="tdc__fbox tdc__fbox--q" data-f="q"><span class="tdc__nw"><i>Q</i><sub>з</sub> = <i>qm</i></span><b class="tdc__nw" data-fq>92 МДж</b></div>
		<div class="tdc__feta" data-f="eta"></div>
		<div class="tdc__flbl tdc__flbl--use" data-f="use"></div>
		<div class="tdc__flbl tdc__flbl--loss" data-f="loss"></div>
	</div>
	<div class="tdc__math" data-math1></div>
	<div class="tdc__math" data-math2></div>
	<p class="tdc__msg" data-msg aria-live="polite"></p>
	<div class="tdc__cmp">
		<p class="tdc__cmpt">КПД настоящих двигателей (примерно) и вашего — вертикальная линия:</p>
		{
			engines.map((e) => (
				<div class="tdc__row">
					<span class="tdc__ename">{e.name}</span>
					<span class="tdc__track">
						<span class="tdc__range" style={`left:${e.lo}%;width:${e.hi - e.lo}%`} />
					</span>
					<span class="tdc__eval">
						{e.lo}–{e.hi} %
					</span>
				</div>
			))
		}
		<div class="tdc__row tdc__row--axis">
			<span class="tdc__ename"></span>
			<span class="tdc__track tdc__track--axis">
				<span style="left:0">0</span>
				<span style="left:50%">50</span>
				<span style="left:100%">100 %</span>
				<span class="tdc__line" data-line></span>
			</span>
			<span class="tdc__eval"></span>
		</div>
	</div>
</div>

<style is:global>
