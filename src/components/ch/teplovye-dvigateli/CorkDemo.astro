---
/**
 * Textbook experiment: water boils in a corked test tube, the steam pushes the cork out.
 * The cork flies along a parabola (uniform gravity); the expanded steam cools and a small cloud
 * of droplets appears at the mouth.
 */
const TILT = 25; // degrees from the vertical
---

<figure class="cork not-content" data-cork>
	<svg class="cork__svg" viewBox="0 0 360 266" role="img" aria-label="Опыт: пар выталкивает пробку из пробирки">
		<!-- stand -->
		<path d="M 12 260 L 150 260 M 30 260 L 30 80 M 30 120 L 112 120" class="cork__stand"></path>
		<g transform={`rotate(${TILT} 112 120)`}>
			<!-- water and steam inside the tube (tube axis along x = 112, mouth at y = 46) -->
			<rect x="98" y="52" width="28" height="130" class="cork__steam" data-steam></rect>
			<path d="M 98 140 L 98 182 A 14 14 0 0 0 126 182 L 126 140 Z" class="cork__water" data-water></path>
			<g data-bubbles></g>
			<path d="M 96 44 L 96 182 A 16 16 0 0 0 128 182 L 128 44" class="cork__glass"></path>
			<rect x="90" y="117" width="44" height="7" rx="2" class="cork__clamp"></rect>
		</g>
		<!-- spirit lamp -->
		<g transform="translate(84 218)">
			<path d="M -22 42 L -16 14 L 16 14 L 22 42 Z" class="cork__lamp"></path>
			<rect x="-4" y="4" width="8" height="10" class="cork__wick"></rect>
			<path d="M 0 -26 C 8 -12 9 -2 0 4 C -9 -2 -8 -12 0 -26 Z" class="cork__flame" data-flame></path>
		</g>
		<g data-fog></g>
		<g data-cork-g>
			<path d="M -9 -10 L 9 -10 L 7 10 L -7 10 Z" class="cork__cork"></path>
		</g>
	</svg>
	<div class="cork__row">
		<div class="cork__btns">
			<button type="button" class="cork__btn cork__btn--primary" data-go>Зажечь спиртовку</button>
			<button type="button" class="cork__btn" data-reset>Сначала</button>
		</div>
		<dl class="cork__stats">
			<div><dt>Температура воды</dt><dd data-t>20 °C</dd></div>
			<div><dt>Давление пара в пробирке</dt><dd><span class="cork__bar"><span data-p></span></span></dd></div>
		</dl>
	</div>
	<p class="cork__live" data-live aria-live="polite">Пробирка с водой закрыта пробкой. Зажгите спиртовку.</p>
</figure>

<style is:global>
	.cork {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.cork__svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		margin-inline: auto;
		height: auto;
	}
	.cork__stand {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.cork__clamp {
		fill: var(--sl-color-gray-4);
	}
	.cork__glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.cork__water {
		fill: var(--ig-vx);
		opacity: 0.55;
	}
	.cork__steam {
		fill: var(--sl-color-white);
		opacity: 0;
	}
	.cork__bubble {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1;
		opacity: 0.8;
	}
	.cork__lamp {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
	}
	.cork__wick {
		fill: var(--sl-color-gray-3);
	}
	.cork__flame {
		fill: var(--ig-v);
		filter: drop-shadow(0 0 6px var(--ig-v));
		opacity: 0;
		transform-box: fill-box;
		transform-origin: 50% 100%;
	}
	.cork__cork {
		fill: hsl(30, 45%, 52%);
		stroke: hsl(30, 40%, 35%);
		stroke-width: 1.2;
	}
	.cork__fog {
		fill: var(--sl-color-gray-3);
	}
	.cork__lbl {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
		font-family: var(--__sl-font);
	}
	.cork__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		margin-top: 0.5rem;
	}
	.cork__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.cork__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.cork__btn:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.cork__btn:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.cork__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.cork__stats {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		flex: 1 1 15rem;
	}
	.cork__stats > div {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 0.35rem 0.7rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
	}
	.cork__stats dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.cork__stats dd {
		margin: 0;
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.cork__bar {
		display: block;
		width: 6rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		overflow: hidden;
	}
	.cork__bar span {
		display: block;
		height: 100%;
		width: 0;
		background: var(--ig-vy);
	}
	.cork__live {
		min-height: 3em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.cork__live b {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.cork {
			padding: 0.75rem;
		}
		.cork__lbl {
			font-size: 16px;
		}
	}
</style>

<script>
	const NS = 'http://www.w3.org/2000/svg';
	const TILT = (25 * Math.PI) / 180;
	// tube axis: point (112, y) of the unrotated tube, rotated about (112, 120)
	const world = (x: number, y: number) => {
		const dx = x - 112;
		const dy = y - 120;
		return { x: 112 + dx * Math.cos(TILT) - dy * Math.sin(TILT), y: 120 + dx * Math.sin(TILT) + dy * Math.cos(TILT) };
	};
	const MOUTH = world(112, 46);
	const G = 520; // px/s²
	const V0 = 330; // px/s along the tube axis

	for (const root of document.querySelectorAll<HTMLElement>('[data-cork]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const corkG = q<SVGGElement>('[data-cork-g]');
		const flame = q<SVGPathElement>('[data-flame]');
		const steamR = q<SVGRectElement>('[data-steam]');
		const bubbles = q<SVGGElement>('[data-bubbles]');
		const fog = q<SVGGElement>('[data-fog]');
		const tOut = q<HTMLElement>('[data-t]');
		const pBar = q<HTMLElement>('[data-p]');
		const live = q<HTMLElement>('[data-live]');
		const go = q<HTMLButtonElement>('[data-go]');
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

		let raf = 0;
		let t = 0; // s since the lamp was lit
		let phase: 'idle' | 'heat' | 'boil' | 'fly' | 'done' = 'idle';
		let tFly = 0;
		let p = 0; // 0…1 excess pressure
		let last = 0;
		const T_BOIL = 4; // s to reach 100 °C
		const T_POP = 2.6; // s of boiling before the cork goes

		const placeCork = (x: number, y: number, rot: number) =>
			corkG.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${rot.toFixed(1)})`);
		const corkStart = world(112, 50);

		const reset = () => {
			cancelAnimationFrame(raf);
			phase = 'idle';
			t = 0;
			p = 0;
			last = 0;
			placeCork(corkStart.x, corkStart.y, 25);
			flame.style.opacity = '0';
			steamR.style.opacity = '0';
			bubbles.replaceChildren();
			fog.replaceChildren();
			tOut.textContent = '20 °C';
			pBar.style.width = '0';
			go.disabled = false;
			live.textContent = 'Пробирка с водой закрыта пробкой. Зажгите спиртовку.';
		};

		const fogPuffs: { e: SVGCircleElement; x: number; y: number; vx: number; vy: number; age: number }[] = [];
		const frame = (now: number) => {
			const dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
			last = now;
			t += dt;
			flame.setAttribute('transform', `scale(${(0.92 + 0.08 * Math.sin(now / 90)).toFixed(3)} ${(0.95 + 0.07 * Math.sin(now / 70)).toFixed(3)})`);
			if (phase === 'heat') {
				const temp = 20 + (80 * Math.min(t, T_BOIL)) / T_BOIL;
				tOut.textContent = `${Math.round(temp)} °C`;
				if (t >= T_BOIL) {
					phase = 'boil';
					t = 0;
					live.innerHTML = 'Вода <b>кипит</b>. Пара в пробирке становится всё больше, его давление растёт.';
				}
			} else if (phase === 'boil') {
				p = Math.min(1, t / T_POP);
				pBar.style.width = `${p * 100}%`;
				steamR.style.opacity = String(0.08 + 0.12 * p);
				if (Math.random() < dt * 25) {
					const b = document.createElementNS(NS, 'circle');
					b.setAttribute('class', 'cork__bubble');
					b.setAttribute('cx', String(102 + Math.random() * 20));
					b.setAttribute('cy', '190');
					b.setAttribute('r', String(1.5 + Math.random() * 2));
					bubbles.append(b);
				}
				for (const b of Array.from(bubbles.children) as SVGCircleElement[]) {
					const y = Number(b.getAttribute('cy')) - 60 * dt;
					if (y < 142) b.remove();
					else b.setAttribute('cy', y.toFixed(1));
				}
				const wob = Math.sin(now / 30) * p * 0.6;
				placeCork(corkStart.x + wob, corkStart.y, 25);
				if (t >= T_POP) {
					phase = 'fly';
					tFly = 0;
					pBar.style.width = '0';
					steamR.style.opacity = '0.06';
					bubbles.replaceChildren();
					live.innerHTML =
						'<b>Пар вытолкнул пробку!</b> Расширяясь, пар совершил работу: часть его внутренней энергии перешла в кинетическую энергию пробки. Сам пар при этом <b>охладился</b>, и часть его сразу сконденсировалась — у отверстия пробирки появилось облачко из мелких капелек воды.';
					for (let i = 0; i < 14; i++) {
						const e = document.createElementNS(NS, 'circle');
						e.setAttribute('class', 'cork__fog');
						fog.append(e);
						const a = TILT + (Math.random() - 0.5) * 1.2;
						const s = 30 + Math.random() * 50;
						fogPuffs.push({ e, x: MOUTH.x, y: MOUTH.y, vx: s * Math.sin(a), vy: -s * Math.cos(a), age: 0 });
					}
				}
			} else if (phase === 'fly') {
				tFly += dt;
				const vx = V0 * Math.sin(TILT);
				const vy = -V0 * Math.cos(TILT);
				const x = corkStart.x + vx * tFly;
				const y = corkStart.y + vy * tFly + (G * tFly * tFly) / 2;
				placeCork(x, y, 25 + 400 * tFly);
				if (y > 300 || x > 400) phase = 'done';
			}
			for (let i = fogPuffs.length - 1; i >= 0; i--) {
				const f = fogPuffs[i];
				f.age += dt;
				f.x += f.vx * dt;
				f.y += f.vy * dt;
				f.vx *= 1 - 1.5 * dt;
				f.vy *= 1 - 1.5 * dt;
				f.e.setAttribute('cx', f.x.toFixed(1));
				f.e.setAttribute('cy', f.y.toFixed(1));
				f.e.setAttribute('r', (4 + f.age * 10).toFixed(1));
				const o = Math.max(0, 0.45 - f.age * 0.15);
				f.e.style.opacity = o.toFixed(2);
				if (o <= 0) {
					f.e.remove();
					fogPuffs.splice(i, 1);
				}
			}
			if (phase !== 'done' || fogPuffs.length) raf = requestAnimationFrame(frame);
		};

		go.addEventListener('click', () => {
			if (phase !== 'idle') return;
			go.disabled = true;
			flame.style.opacity = '1';
			live.textContent = 'Спиртовка нагревает воду: топливо горит, и энергия передаётся воде.';
			if (reduce) {
				// skip the animation: show the result
				phase = 'done';
				tOut.textContent = '100 °C';
				placeCork(330, 230, 115);
				live.innerHTML =
					'<b>Пар вытолкнул пробку!</b> Расширяясь, пар совершил работу: часть его внутренней энергии перешла в кинетическую энергию пробки. Сам пар при этом <b>охладился</b>.';
				return;
			}
			phase = 'heat';
			t = 0;
			last = 0;
			raf = requestAnimationFrame(frame);
		});
		q<HTMLButtonElement>('[data-reset]').addEventListener('click', reset);
		reset();
	}
</script>
