---
/**
 * «Куда уходит энергия топлива»: a side-view drawing of the chosen machine (car, tractor, steam locomotive, thermal
 * power station) with faint streams whose width is proportional to the share of the fuel's energy, from the fuel to
 * where that energy really leaves the machine. The fuel's energy is 100 cells, one cell = 1 J: they start as a 10 × 10
 * block at the fuel and, on «Пустить энергию» or when the pupil switches machines, travel along the streams, leave
 * through the real exits and settle in four piles under the picture (columns of 5, a little gap after every 10).
 * Below: a live sentence and η = A_п / Q_з · 100 %. Above it, a «guess first» question: which engine has the
 * smallest efficiency. Drawings and energy paths: flowMachines.ts.
 *
 * Shares (percent of the fuel's energy):
 * - petrol, diesel: SPECS[...].shares from engine.ts (the same as in EngineLab).
 * - steam locomotive: heat balance of properly worked US locomotives, University of Illinois Engineering
 *   Experiment Station, Bulletin vol. XVI no. 2 (1918), «The Economic Use of Coal in Railway Locomotives»,
 *   as given in Nature 103, 213 (1919): heat in stack gases 14, cinders 8, unburnt gases 4, ash pan 4
 *   (smoke and unburnt coal: 30); radiation 5, auxiliaries 6, rest 1 (other: 12); exhaust steam 52; drawbar 6.
 * - power-station steam turbine: IEA Coal Industry Advisory Board, «Power Generation from Coal» (2010), Fig. 2.3
 *   (after White, 1991), a typical 500 MW coal-fired unit: electrical output 39, condenser 52.5, boiler losses 5.5,
 *   steam range 0.5 + turbine-generator 1.5 + works auxiliaries 1.0 (other: 3); rounded to 39, 52, 6, 3.
 */
const engines = [
	{ id: 'loco', label: 'Паровоз' },
	{ id: 'petrol', label: 'Бензиновый' },
	{ id: 'diesel', label: 'Дизельный' },
	{ id: 'tes', label: 'Паровая турбина' },
];
---

<figure class="ef not-content" data-ef>
	<p class="ef__title">Куда уходит энергия топлива</p>
	<div class="ef__guess" data-guess>
		<p class="ef__q">Сначала угадайте: у какого двигателя в полезную работу идёт меньше всего энергии топлива?</p>
		<div class="ef__opts" role="group" aria-label="Варианты ответа">
			{
				engines.map((e) => (
					<button type="button" class="ef__opt" data-opt={e.id}>
						<span class="ef__mark" aria-hidden="true" />
						{e.label}
					</button>
				))
			}
		</div>
		<p class="ef__fb" aria-live="polite" data-fb></p>
	</div>
	<div class="ef__modes" role="group" aria-label="Двигатель">
		{
			engines.map((e) => (
				<button type="button" class="ef__mode" data-mode={e.id} aria-pressed="false">
					{e.label}
				</button>
			))
		}
	</div>
	<div class="ef__stage" data-stage>
		<svg class="ef__svg" viewBox="0 0 640 320" role="img" data-svg></svg>
		<div class="ef__piles" data-piles></div>
		<div class="ef__fly" aria-hidden="true" data-fly></div>
	</div>
	<div class="ef__ctl">
		<button type="button" class="ef__run" data-run>Пустить энергию</button>
		<span class="ef__unit"><span class="ef__unit-cell" aria-hidden="true"></span>одна клетка&nbsp;— 1&nbsp;Дж</span>
	</div>
	<div class="ef__calc">
		<p class="ef__line" aria-live="polite" data-line></p>
		<p class="ef__more" data-more></p>
		<div class="ef__math" data-math></div>
	</div>
	<figcaption class="ef__cap">
		Доли примерные, для типичных машин: у паровоза&nbsp;— по испытаниям американских паровозов начала XX&nbsp;века, у турбины&nbsp;— для
		угольной электростанции, где один энергоблок даёт 500&nbsp;МВт.
	</figcaption>
</figure>

<style is:global>
	.ef {
		--ef-c0: var(--ig-v);
		--ef-c1: var(--sl-color-gray-3);
		--ef-c2: var(--ig-vx);
		--ef-c3: var(--ig-vy);
		--ef-fuel: color-mix(in srgb, var(--ig-v) 62%, var(--ig-surface));
		--ef-steam: color-mix(in srgb, var(--sl-color-gray-1) 45%, transparent);
		--ef-smoke: color-mix(in srgb, var(--sl-color-gray-3) 40%, transparent);
		--ef-body: color-mix(in srgb, var(--sl-color-gray-5) 70%, var(--sl-color-gray-4));
		--ef-ink: var(--sl-color-gray-6);
		--ef-cell: 12px;
		--ef-gap: 3px;
		container-type: inline-size;
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .ef {
		--ef-steam: color-mix(in srgb, var(--sl-color-gray-4) 45%, transparent);
		--ef-smoke: color-mix(in srgb, var(--sl-color-gray-3) 45%, transparent);
		--ef-body: color-mix(in srgb, var(--sl-color-gray-5) 75%, var(--sl-color-gray-4));
		--ef-ink: var(--sl-color-gray-2);
	}
	.ef i {
		font-family: var(--ig-font-math);
	}
	.ef__title {
		margin: 0 0 0.5rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.ef__guess {
		margin-bottom: 0.6rem;
		padding: 0.6rem 0.75rem;
		border-radius: 0.75rem;
		border: 1px dashed var(--sl-color-gray-5);
	}
	.ef__q {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ef__opts,
	.ef__modes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.ef__opt {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.35rem 0.85rem 0.35rem 0.45rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
		transition:
			border-color 0.2s,
			background-color 0.2s;
	}
	.ef__opt:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.ef__opt:disabled {
		cursor: default;
	}
	.ef__mark {
		display: grid;
		place-items: center;
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 50%;
		border: 1.5px solid var(--sl-color-gray-3);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
	}
	.ef__opt.is-right {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.ef__opt.is-right .ef__mark {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.ef__opt.is-right .ef__mark::after {
		content: '✓';
	}
	.ef__opt.is-wrong {
		border-color: var(--ig-vy);
		opacity: 0.75;
		text-decoration: line-through;
		text-decoration-color: var(--ig-vy);
	}
	.ef__opt.is-wrong .ef__mark {
		border-color: var(--ig-vy);
		color: var(--ig-vy);
	}
	.ef__opt.is-wrong .ef__mark::after {
		content: '✗';
	}
	.ef__fb {
		margin: 0.45rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ef__fb:empty {
		display: none;
	}
	.ef__fb b {
		color: var(--sl-color-text-accent);
	}
	.ef__mode {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background-color 0.25s,
			color 0.25s,
			border-color 0.25s;
	}
	.ef__mode:hover {
		border-color: var(--sl-color-accent);
	}
	.ef__mode.is-on {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}

	/* ---------- the stage: drawing, piles and the flying cells */
	.ef__stage {
		position: relative;
		margin-top: 0.6rem;
		overflow-x: clip;
	}
	.ef__svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.ef__svg.is-in .ef-m,
	.ef__svg.is-in .ef-blk {
		animation: ef-in 0.4s ease-out;
	}
	@keyframes ef-in {
		from {
			opacity: 0;
		}
	}
	.ef__svg text {
		font-family: var(--__sl-font);
		font-size: var(--ef-fs, 13px);
		fill: var(--sl-color-gray-2);
	}
	.ef__svg .ef-tag {
		fill: var(--sl-color-gray-1);
		paint-order: stroke;
		stroke: var(--ig-surface);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	.ef__svg .ef-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ef.is-narrow .ef-minor {
		display: none;
	}
	.ef__svg .ef-blab {
		fill: var(--sl-color-gray-2);
	}
	.ef__svg .ef-bval {
		fill: var(--ef-c0);
		font-weight: 700;
	}
	.ef-cell {
		fill: var(--ef-fuel);
		transition: opacity 0.25s;
	}
	.ef-cell.is-gone {
		opacity: 0.13;
	}
	.ef-s {
		fill: none;
		stroke: var(--ef-col);
		stroke-opacity: 0.42;
		stroke-linejoin: round;
	}
	.ef-hop {
		fill: none;
		stroke: var(--ef-c0);
		stroke-opacity: 0.55;
		stroke-width: 1.2;
		stroke-dasharray: 3 4;
	}
	.ef-k0 {
		--ef-col: var(--ef-c0);
	}
	.ef-k1 {
		--ef-col: var(--ef-c1);
	}
	.ef-k2 {
		--ef-col: var(--ef-c2);
	}
	.ef-k3 {
		--ef-col: var(--ef-c3);
	}
	.ef-kf {
		--ef-col: var(--ef-fuel);
	}
	.ef-kf.ef-s {
		stroke-opacity: 0.45;
	}
	.ef-k1.ef-s {
		stroke-opacity: 0.55;
	}

	/* drawing parts */
	.efm-ground {
		fill: color-mix(in srgb, var(--ig-v) 8%, var(--sl-color-gray-5));
	}
	.efm-rail {
		fill: var(--sl-color-gray-3);
	}
	.efm-body {
		fill: var(--ef-body);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.efm-glass {
		fill: color-mix(in srgb, var(--ig-vx) 35%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.efm-line,
	.efm-thin {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-gray-2) 55%, transparent);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.efm-thin {
		stroke-width: 2;
	}
	.efm-lamp {
		fill: var(--ig-v);
	}
	.efm-tail {
		fill: var(--ig-vy);
	}
	.efm-dark {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, var(--ef-ink));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.efm-tyre {
		fill: var(--ef-ink);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.efm-lugs {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-gray-4) 80%, var(--ef-ink));
		stroke-width: 6;
	}
	.efm-rim {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.efm-spoke {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.efm-hub {
		fill: var(--sl-color-gray-2);
	}
	.efm-fender {
		fill: none;
		stroke: var(--ef-body);
		stroke-width: 10;
	}
	.efm-part {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 55%, var(--ig-surface));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-linejoin: round;
	}
	.efm-tank {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--ig-surface));
		stroke: var(--ig-v);
		stroke-width: 1.3;
	}
	.efm-rad,
	.efm-cond {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--ig-surface));
		stroke: var(--ig-vx);
		stroke-width: 1.2;
	}
	.efm-slats {
		stroke: var(--ig-vx);
		stroke-width: 1;
	}
	.efm-pipe {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linejoin: round;
	}
	.efm-pipe-end {
		fill: var(--sl-color-gray-3);
	}
	.efm-water-pipe {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-gray-3));
		stroke-width: 4;
	}
	.efm-smoke {
		fill: var(--ef-smoke);
	}
	.efm-steam {
		fill: var(--ef-steam);
	}
	.efm-air {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
	}
	.efm-glow {
		fill: var(--ig-vy);
		opacity: 0.16;
	}
	.efm-heat {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 1.6;
		stroke-linecap: round;
		opacity: 0.7;
	}
	.efm-turn {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.efm-coal {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 60%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	:root[data-theme='light'] .efm-coal {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 70%, var(--sl-color-gray-4));
	}
	.efm-fire-box {
		fill: color-mix(in srgb, var(--ig-vy) 18%, var(--ig-surface));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.efm-flame {
		fill: color-mix(in srgb, var(--ig-v) 70%, var(--ig-vy));
		opacity: 0.85;
	}
	.efm-rod,
	.efm-rod2 {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.efm-rod2 {
		stroke-width: 3;
	}
	.efm-room {
		fill: var(--ig-surface);
		opacity: 0.85;
	}
	.efm-tower {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 55%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.efm-tower-top {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 85%, var(--ig-surface));
	}
	.efm-shaft {
		fill: var(--sl-color-gray-3);
	}
	.efm-gen {
		fill: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.efm-pylon,
	.efm-wire {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.efm-wire {
		stroke-width: 1.3;
	}
	.efm-roof {
		fill: color-mix(in srgb, var(--ig-vy) 40%, var(--sl-color-gray-4));
	}
	.efm-home {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-4));
	}
	.efm-window {
		fill: var(--ig-v);
		opacity: 0.85;
	}

	/* piles */
	.ef__piles {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem 0.75rem;
		margin-top: 0.4rem;
	}
	.ef__pile {
		display: grid;
		grid-row: span 3;
		grid-template-rows: subgrid;
		row-gap: 0;
		min-width: 0;
	}
	.ef__cells {
		align-self: end;
		display: grid;
		grid-template-columns: repeat(5, var(--ef-cell));
		grid-auto-rows: auto;
		gap: var(--ef-gap);
		align-content: end;
	}
	.ef__cell {
		width: var(--ef-cell);
		height: var(--ef-cell);
		border-radius: 2px;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-gray-4) 70%, transparent);
	}
	.ef__cell.is-ten {
		margin-bottom: 4px;
	}
	.ef__cell.is-on {
		background: var(--ef-col);
		box-shadow: none;
	}
	.ef__pname {
		margin: 0.45rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.3;
		color: var(--sl-color-gray-2);
	}
	.ef__pval {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--ef-col);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.ef__pile.ef-k1 .ef__pval {
		color: var(--sl-color-gray-2);
	}
	.ef__fly {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.ef__fly span {
		position: absolute;
		left: 0;
		top: 0;
		width: var(--ef-cell);
		height: var(--ef-cell);
		border-radius: 2px;
		background: var(--ef-col);
		transition: background-color 0.15s;
		will-change: transform;
		visibility: hidden;
	}

	/* controls and text */
	.ef__ctl {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-top: 0.8rem;
	}
	.ef__run {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.4rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.ef__run:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.ef__unit {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ef__unit-cell {
		width: var(--ef-cell);
		height: var(--ef-cell);
		border-radius: 2px;
		background: var(--ef-fuel);
	}
	.ef__calc {
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ef__line,
	.ef__more {
		margin: 0 0 0.35rem;
	}
	.ef__line b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.ef__math {
		overflow-x: auto;
		overflow-y: hidden;
		color: var(--sl-color-white);
	}
	.ef__math .katex-display {
		margin: 0.4rem 0;
	}
	.ef__cap {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@container (max-width: 34rem) {
		.ef__piles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 40rem) {
		.ef {
			padding: 0.75rem;
			--ef-cell: 11px;
			--ef-gap: 2px;
		}
	}
</style>

<script>
	import katex from 'katex';
	import { SPECS } from './engine';
	import { MACHINES, FRAME_DY, CELL, PITCH, VIEW_W, type MachineId } from './flowMachines';

	type Id = MachineId;
	interface Engine {
		name: string; // in the live line
		work: string; // what the useful work does
		bands: [string, string, string, string];
		s: number[]; // percent of the fuel's energy: useful, then three losses
		more: (s: number[]) => string;
	}
	const pct = (a: readonly number[]) => a.map((x) => Math.round(x * 100));
	const ENG: Record<Id, Engine> = {
		loco: {
			name: 'Паровоз',
			work: 'тянет поезд',
			bands: ['Полезная работа', 'Дым и несгоревший уголь', 'Отработавший пар', 'Прочие потери'],
			s: [6, 30, 52, 12],
			more: (s) =>
				`Больше половины — ${s[2]} Дж — уносит отработавший пар: он вылетает в трубу вместе с дымом. Ещё ${s[1]} Дж уходят с горячим дымом, искрами и несгоревшим углём, ${s[3]} Дж — на нагревание воздуха вокруг котла, насосы и тормоза.`,
		},
		petrol: {
			name: 'Бензиновый двигатель автомобиля',
			work: 'вращает колёса',
			bands: ['Полезная работа', 'Выхлопные газы', 'Охлаждение двигателя', 'Трение'],
			s: pct(SPECS.petrol.shares),
			more: (s) =>
				`Больше всего — ${s[1]} Дж — уносят горячие выхлопные газы, ${s[2]} Дж нагревают охлаждающую воду и воздух, ${s[3]} Дж уходят на трение.`,
		},
		diesel: {
			name: 'Дизельный двигатель',
			work: 'вращает колёса',
			bands: ['Полезная работа', 'Выхлопные газы', 'Охлаждение двигателя', 'Трение'],
			s: pct(SPECS.diesel.shares),
			more: (s) =>
				`Воздух в дизеле сжимается сильнее, поэтому полезная работа больше, чем у бензинового двигателя. Выхлопные газы уносят ${s[1]} Дж, охлаждающая вода — ${s[2]} Дж, на трение уходят ${s[3]} Дж.`,
		},
		tes: {
			name: 'Паровая турбина электростанции',
			work: 'вращает генератор тока',
			bands: ['Полезная работа', 'Дым из трубы котла', 'Охлаждение в конденсаторе', 'Прочие потери'],
			s: [39, 6, 52, 3],
			more: (s) =>
				`Больше половины — ${s[2]} Дж — забирает холодная вода в конденсаторе: там пар, который вышел из турбины, снова превращается в воду. С дымом из трубы котла уходят ${s[1]} Дж, ${s[3]} Дж — на трение и нагревание воздуха.`,
		},
	};
	const ANSWER: Id = 'loco';
	const K = 0.26; // width of a stream per percent of the fuel's energy, viewBox units
	const LEAVE = 17; // ms between two cells leaving the block
	const FLIGHT = 2100; // ms: the longest flight
	const smooth = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
	const easeIO = (x: number) => (x < 0.5 ? 2 * x * x : 1 - 2 * (1 - x) * (1 - x));
	const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));

	/** Which band each cell goes to, in the order the cells leave: the four streams flow at the same time. */
	const dealBands = (s: number[]) => {
		const got = [0, 0, 0, 0];
		const out: number[] = [];
		for (let k = 0; k < 100; k++) {
			let best = -1;
			let need = -Infinity;
			for (let b = 0; b < 4; b++) {
				if (got[b] >= s[b]) continue;
				const d = (s[b] * (k + 1)) / 100 - got[b];
				if (d > need + 1e-9) {
					need = d;
					best = b;
				}
			}
			got[best]++;
			out.push(best);
		}
		return out;
	};

	interface Flier {
		el: HTMLSpanElement;
		band: number;
		slot: number;
		t0: number; // ms after the start
		dur: number;
		xs: Float32Array;
		ys: Float32Array;
		acc: Float32Array; // arc length to each point
		colorAt: number; // arc length where the cell takes the colour of its band
		growAt: number; // arc length where the cell leaves the machine
		s0: number; // scale inside the machine
		state: 0 | 1 | 2; // waiting, flying, landed
		colored: boolean;
		block: number; // index of its cell in the fuel block
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-ef]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const stage = q<HTMLElement>('[data-stage]');
		const pilesBox = q<HTMLElement>('[data-piles]');
		const fly = q<HTMLElement>('[data-fly]');
		const runBtn = q<HTMLButtonElement>('[data-run]');
		const line = q<HTMLElement>('[data-line]');
		const more = q<HTMLElement>('[data-more]');
		const math = q<HTMLElement>('[data-math]');
		const fb = q<HTMLElement>('[data-fb]');
		const modeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode]'));
		const optBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-opt]'));

		const flyEls = Array.from({ length: 100 }, () => {
			const e = document.createElement('span');
			fly.append(e);
			return e;
		});

		let cur: Id = 'petrol';
		let blockCells: SVGRectElement[] = [];
		let segEls: SVGPathElement[] = [];
		let hopEl: SVGPathElement | null = null;
		let frameEl: SVGGElement | null = null;
		let slots: HTMLElement[][] = [];
		let vals: HTMLElement[] = [];
		const counts = [0, 0, 0, 0];
		let fliers: Flier[] = [];
		let raf = 0;
		let tStart = 0;
		let pending = 0; // timer before an automatic run
		let running = false;

		// ---------- drawing
		const tagSvg = (m: (typeof MACHINES)[Id]) =>
			m.tags
				.map((t) => {
					const cls = t.minor ? ' ef-minor' : '';
					const lead = t.l ? `<line class="ef-lead${cls}" x1="${t.l[0]}" y1="${t.l[1]}" x2="${t.l[2]}" y2="${t.l[3]}"/>` : '';
					return `${lead}<text class="ef-tag${cls}" x="${t.x}" y="${t.y}" text-anchor="${t.a ?? 'middle'}">${t.t}</text>`;
				})
				.join('');

		const draw = (id: Id) => {
			const m = MACHINES[id];
			const s = ENG[id].s;
			const streams = m.segs
				.map((g, i) => {
					const w = Math.max(1.6, K * g.bands.reduce((a, b) => a + s[b], 0));
					const k = g.bands.length > 1 ? 'f' : String(g.bands[0]);
					return `<path class="ef-s ef-k${k}" data-seg="${i}" stroke-width="${w.toFixed(2)}" d="${g.d}"/>`;
				})
				.join('');
			const [bx, by] = m.block;
			let cells = '';
			for (let i = 0; i < 10; i++)
				for (let j = 0; j < 10; j++)
					cells += `<rect class="ef-cell" x="${bx + j * PITCH}" y="${by + i * PITCH}" width="${CELL}" height="${CELL}" rx="1.5"/>`;
			svg.innerHTML =
				`<g class="ef-m" transform="translate(0 ${FRAME_DY})">${m.art}${m.top ?? ''}` +
				`<path class="ef-hop" data-hop d="${m.hop}"/>${streams}${tagSvg(m)}</g>` +
				`<g class="ef-blk"><text class="ef-blab" x="${bx}" y="26">Энергия топлива</text>` +
				`<text class="ef-bval" x="${bx}" y="50">100 Дж</text>${cells}</g>`;
			svg.setAttribute('aria-label', m.label);
			svg.classList.remove('is-in');
			void svg.getBoundingClientRect();
			svg.classList.add('is-in');
			blockCells = Array.from(svg.querySelectorAll<SVGRectElement>('.ef-cell'));
			segEls = Array.from(svg.querySelectorAll<SVGPathElement>('[data-seg]'));
			hopEl = svg.querySelector<SVGPathElement>('[data-hop]');
			frameEl = svg.querySelector<SVGGElement>('.ef-m');
		};

		// ---------- piles under the picture
		const buildPiles = (id: Id) => {
			const e = ENG[id];
			pilesBox.innerHTML = '';
			slots = [];
			vals = [];
			e.s.forEach((n, b) => {
				const pile = document.createElement('div');
				pile.className = `ef__pile ef-k${b}`;
				const box = document.createElement('div');
				box.className = 'ef__cells';
				const rows = Math.ceil(n / 5);
				const mine: HTMLElement[] = [];
				for (let k = 0; k < n; k++) {
					const r = Math.floor(k / 5); // from the bottom
					const c = document.createElement('span');
					c.className = 'ef__cell';
					if (r % 2 === 0 && r > 0) c.classList.add('is-ten');
					c.style.gridRow = String(rows - r);
					c.style.gridColumn = String((k % 5) + 1);
					box.append(c);
					mine.push(c);
				}
				const name = document.createElement('p');
				name.className = 'ef__pname';
				name.textContent = e.bands[b];
				const val = document.createElement('p');
				val.className = 'ef__pval';
				pile.append(box, name, val);
				pilesBox.append(pile);
				slots.push(mine);
				vals.push(val);
			});
		};

		const showCount = (b: number) => {
			const n = counts[b];
			vals[b].textContent = n ? `${n} Дж · ${n} %` : ' ';
		};

		// ---------- states
		const stop = () => {
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
			running = false;
			if (pending) clearTimeout(pending);
			pending = 0;
			flyEls.forEach((el) => (el.style.visibility = 'hidden'));
			fliers = [];
			runBtn.disabled = false;
		};
		const fill = (full: boolean) => {
			blockCells.forEach((c) => c.classList.toggle('is-gone', full));
			slots.forEach((mine, b) => {
				mine.forEach((c) => c.classList.toggle('is-on', full));
				counts[b] = full ? mine.length : 0;
				showCount(b);
			});
		};
		const reset = () => {
			stop();
			fill(false);
			runBtn.textContent = 'Пустить энергию';
		};
		const finish = () => {
			stop();
			fill(true);
			runBtn.textContent = 'Ещё раз';
		};

		// ---------- routes of the cells in stage pixels
		const plan = () => {
			const m = MACHINES[cur];
			const s = ENG[cur].s;
			const st = stage.getBoundingClientRect();
			const M = frameEl!.getScreenCTM()!;
			const O = svg.getScreenCTM()!;
			const sc = Math.hypot(M.a, M.b);
			const toPx = (C: DOMMatrix, x: number, y: number): [number, number] => [C.a * x + C.c * y + C.e - st.left, C.b * x + C.d * y + C.f - st.top];
			const cellPx = slots[0][0].getBoundingClientRect().width || 12;

			// sampled hop (block → fuel)
			const hopL = hopEl!.getTotalLength();
			const nh = Math.max(8, Math.ceil(hopL / 4));
			const hop: [number, number][] = [];
			for (let j = 0; j <= nh; j++) {
				const p = hopEl!.getPointAtLength((j / nh) * hopL);
				hop.push(toPx(M, p.x, p.y));
			}
			// each band's route in the machine frame: points, unit normals, stream width, where it becomes one band
			const base = m.routes.map((route) => {
				const px: number[] = [];
				const py: number[] = [];
				const w: number[] = [];
				const fromSeg: number[] = []; // distance from the start of the segment
				let colorIdx = 0;
				route.forEach((si, n) => {
					const el = segEls[si];
					const L = el.getTotalLength();
					const ns = Math.max(4, Math.ceil(L / 3));
					const wid = Math.max(1.6, K * m.segs[si].bands.reduce((a, b) => a + s[b], 0));
					if (m.segs[si].bands.length === 1 && !colorIdx) colorIdx = px.length;
					for (let j = n ? 1 : 0; j <= ns; j++) {
						const p = el.getPointAtLength((j / ns) * L);
						px.push(p.x);
						py.push(p.y);
						w.push(wid);
						fromSeg.push((j / ns) * L);
					}
				});
				const nx: number[] = [];
				const ny: number[] = [];
				for (let i = 0; i < px.length; i++) {
					const a = Math.max(0, i - 1);
					const b = Math.min(px.length - 1, i + 1);
					const tx = px[b] - px[a];
					const ty = py[b] - py[a];
					const l = Math.hypot(tx, ty) || 1;
					nx.push(-ty / l);
					ny.push(tx / l);
				}
				// the width changes smoothly over the first 14 units of a new segment
				const ws = w.slice();
				for (let i = 1; i < w.length; i++) if (fromSeg[i] < 14 && w[i] !== w[i - 1]) ws[i] = ws[i - 1] + (w[i] - ws[i - 1]) * smooth(fromSeg[i] / 14);
				return { px, py, nx, ny, ws, colorIdx };
			});

			// the cells leave the block nearest to the hop first
			const [bx, by] = m.block;
			const h0 = hopEl!.getPointAtLength(0);
			const dist = (k: number) =>
				Math.hypot(bx + (k % 10) * PITCH + CELL / 2 - h0.x, by + Math.floor(k / 10) * PITCH + CELL / 2 - (h0.y + FRAME_DY));
			const order = Array.from({ length: 100 }, (_, i) => i).sort((i, j) => dist(i) - dist(j));
			const bands = dealBands(s);
			const taken = [0, 0, 0, 0];
			const out: Flier[] = [];
			let maxL = 0;
			bands.forEach((b, k) => {
				const cell = order[k];
				const [sx, sy] = toPx(O, bx + (cell % 10) * PITCH + CELL / 2, by + Math.floor(cell / 10) * PITCH + CELL / 2);
				const xs: number[] = [];
				const ys: number[] = [];
				// 1. from its place in the block onto the hop
				hop.forEach(([x, y], j) => {
					const u = 1 - smooth(j / nh);
					xs.push(x + (sx - hop[0][0]) * u);
					ys.push(y + (sy - hop[0][1]) * u);
				});
				// 2. along the streams, somewhere across their width
				const f = (((k * 0.618034) % 1) * 2 - 1) * 0.72;
				const r = base[b];
				for (let i = 1; i < r.px.length; i++) {
					const o = (f * r.ws[i]) / 2;
					const [x, y] = toPx(M, r.px[i] + r.nx[i] * o, r.py[i] + r.ny[i] * o);
					xs.push(x);
					ys.push(y);
				}
				const colorPt = hop.length + Math.max(0, r.colorIdx - 1);
				const exitPt = xs.length - 1;
				// 3. out of the machine and down onto the pile
				const slot = taken[b]++;
				const tr = slots[b][slot].getBoundingClientRect();
				const tx = tr.left + tr.width / 2 - st.left;
				const ty = tr.top + tr.height / 2 - st.top;
				const [dx0, dy0] = m.out[b];
				const dl = Math.hypot(dx0, dy0);
				const P = [xs[exitPt], ys[exitPt]];
				const reach = dy0 < 0 ? clamp(P[1] - 4, 16, 60) : 60;
				const c1 = [P[0] + (dx0 / dl) * reach, P[1] + (dy0 / dl) * reach];
				const c2 = [tx, ty - 70];
				for (let j = 1; j <= 36; j++) {
					const t = j / 36;
					const a = (1 - t) ** 3;
					const bb = 3 * (1 - t) ** 2 * t;
					const c = 3 * (1 - t) * t * t;
					const d = t ** 3;
					xs.push(a * P[0] + bb * c1[0] + c * c2[0] + d * tx);
					ys.push(a * P[1] + bb * c1[1] + c * c2[1] + d * ty);
				}
				const acc = new Float32Array(xs.length);
				for (let i = 1; i < xs.length; i++) acc[i] = acc[i - 1] + Math.hypot(xs[i] - xs[i - 1], ys[i] - ys[i - 1]);
				const L = acc[acc.length - 1];
				maxL = Math.max(maxL, L);
				out.push({
					el: flyEls[k],
					band: b,
					slot,
					t0: k * LEAVE,
					dur: L,
					xs: Float32Array.from(xs),
					ys: Float32Array.from(ys),
					acc,
					colorAt: acc[colorPt],
					growAt: acc[exitPt],
					s0: (CELL * sc) / cellPx,
					state: 0,
					colored: false,
					block: cell,
				});
			});
			const v = maxL / FLIGHT;
			out.forEach((fl) => (fl.dur = Math.max(900, fl.dur / v)));
			return out;
		};

		const place = (fl: Flier, d: number) => {
			const { xs, ys, acc } = fl;
			let lo = 0;
			let hi = acc.length - 1;
			while (hi - lo > 1) {
				const mid = (lo + hi) >> 1;
				if (acc[mid] <= d) lo = mid;
				else hi = mid;
			}
			const seg = acc[hi] - acc[lo] || 1;
			const u = clamp((d - acc[lo]) / seg, 0, 1);
			const x = xs[lo] + (xs[hi] - xs[lo]) * u;
			const y = ys[lo] + (ys[hi] - ys[lo]) * u;
			const L = acc[acc.length - 1];
			const g = smooth((d - fl.growAt) / Math.max(1, L - fl.growAt));
			const sc = fl.s0 + (1 - fl.s0) * g;
			const half = fl.el.offsetWidth / 2;
			fl.el.style.transform = `translate(${(x - half).toFixed(1)}px, ${(y - half).toFixed(1)}px) scale(${sc.toFixed(3)})`;
		};

		const frame = (now: number) => {
			const t = now - tStart;
			let left = 0;
			for (const fl of fliers) {
				if (fl.state === 2) continue;
				left++;
				const k = (t - fl.t0) / fl.dur;
				if (k < 0) continue;
				if (fl.state === 0) {
					fl.state = 1;
					fl.el.className = 'ef-kf';
					fl.el.style.visibility = 'visible';
					blockCells[fl.block].classList.add('is-gone');
				}
				if (k >= 1) {
					fl.state = 2;
					fl.el.style.visibility = 'hidden';
					slots[fl.band][fl.slot].classList.add('is-on');
					counts[fl.band]++;
					showCount(fl.band);
					continue;
				}
				const d = fl.acc[fl.acc.length - 1] * easeIO(k);
				if (!fl.colored && d >= fl.colorAt) {
					fl.colored = true;
					fl.el.className = `ef-k${fl.band}`;
				}
				place(fl, d);
			}
			if (left) raf = requestAnimationFrame(frame);
			else finish();
		};

		const run = () => {
			reset();
			if (!stage.offsetWidth) return finish();
			fliers = plan();
			running = true;
			runBtn.disabled = true;
			tStart = performance.now();
			raf = requestAnimationFrame(frame);
		};

		// ---------- texts
		const fmtEta = () => {
			const A = ENG[cur].s[0];
			const one = `\\eta = \\frac{A_\\text{п}}{Q_\\text{з}}\\cdot 100\\,\\% = \\frac{${A}~\\text{Дж}}{100~\\text{Дж}}\\cdot 100\\,\\% = ${A}\\,\\%`;
			const two = `\\begin{aligned}\\eta &= \\frac{A_\\text{п}}{Q_\\text{з}}\\cdot 100\\,\\% \\\\ &= \\frac{${A}~\\text{Дж}}{100~\\text{Дж}}\\cdot 100\\,\\% = ${A}\\,\\%\\end{aligned}`;
			katex.render(one, math, { displayMode: true, throwOnError: false });
			if (math.scrollWidth > math.clientWidth + 1) katex.render(two, math, { displayMode: true, throwOnError: false });
		};
		const texts = () => {
			const e = ENG[cur];
			const A = e.s[0];
			line.innerHTML = `<b>${e.name}.</b> Из каждых 100 Дж энергии топлива в полезную работу (${e.work}) идёт <b>${A} Дж</b>, а <b>${100 - A} Дж</b> теряются.`;
			more.textContent = e.more(e.s);
			fmtEta();
		};

		// text in the drawing keeps about the same size on the screen
		const fitText = () => {
			const w = svg.clientWidth || VIEW_W;
			const k = w / VIEW_W;
			svg.style.setProperty('--ef-fs', `${clamp(12 / k, 12, 24).toFixed(1)}px`);
			root.classList.toggle('is-narrow', k < 0.72);
		};

		const select = (id: Id, go: boolean) => {
			stop();
			cur = id;
			modeBtns.forEach((b) => {
				const on = b.dataset.mode === id;
				b.classList.toggle('is-on', on);
				b.setAttribute('aria-pressed', String(on));
			});
			draw(id);
			buildPiles(id);
			fitText();
			reset();
			texts();
			if (go) {
				runBtn.disabled = true;
				pending = window.setTimeout(() => {
					pending = 0;
					run();
				}, 450);
			}
		};
		modeBtns.forEach((b) => b.addEventListener('click', () => select(b.dataset.mode as Id, true)));
		runBtn.addEventListener('click', () => {
			if (!running) run();
		});

		// ---------- guess first
		optBtns.forEach((b) =>
			b.addEventListener('click', () => {
				const id = b.dataset.opt as Id;
				const right = id === ANSWER;
				optBtns.forEach((x) => (x.disabled = true));
				b.classList.add(right ? 'is-right' : 'is-wrong');
				if (!right) optBtns.find((x) => x.dataset.opt === ANSWER)!.classList.add('is-right');
				const a = ENG[ANSWER].s[0];
				fb.innerHTML = right
					? `<b>Верно!</b> У паровоза в полезную работу идёт всего ${a} Дж из каждых 100. Посмотрите на рисунке, куда уходит остальное.`
					: `Нет: у этого двигателя в работу идёт ${ENG[id].s[0]} Дж из 100. Меньше всего — у паровоза: всего ${a} Дж. Посмотрите на рисунке, куда уходит остальное.`;
				select(ANSWER, true);
			}),
		);

		let lastW = 0;
		new ResizeObserver(() => {
			const w = stage.clientWidth;
			if (Math.abs(w - lastW) < 1) return;
			lastW = w;
			fitText();
			if (running) finish();
			fmtEta();
		}).observe(stage);
		select('petrol', false);
	}
</script>
