---
/**
 * Model: the textbook experiment on weightlessness. A man (175 см, the people kit) holds in his far hand, stretched
 * forward 56 см, a clear plastic bottle of water (8 × 25 см, water 20 см deep) by its neck, and in his near hand,
 * 44 см in front of him, a spring dynamometer by its ring with a 0,5 кг weight on its hook (drawn in front of his far arm). The bottle has three small holes on its front side 15, 10 and 5 см above its
 * bottom, that is 5, 10 and 15 см below the water surface. A soft low basin (10 см) lies on the floor. 130 px per
 * metre on both axes; the man's hands are 24 px long and drawn with fingers.
 *
 * Physics (g = 9,8 м/с²; a_y is the acceleration of the bottle and the dynamometer, up positive):
 *   • the water leaves a hole at depth Δh with the speed √(2(g + a_y)Δh) relative to the bottle (held still:
 *     0,99; 1,40; 1,71 м/с), then flies freely; the lowest jet lands farthest (0,53; 0,74; 0,88 м from the bottle).
 *     The level in the bottle is kept at 20 см (it would sink by about 1 мм per second).
 *   • the dynamometer shows m(g + a_y): 4,9 Н held still; 0 when the hand has let go, as long as the bodies fly (the
 *     spring is taken to relax at once).
 *   • «Отпустить»: the fingers open in 0,1 с and the bodies fall 1,25 м from rest into the basin in 0,505 с.
 *   • «Подбросить»: the hands go down by 45 см in 0,7 с (smoothly, |a| ≤ 4,5 м/с²) and push up by 45 см at
 *     a = 10 м/с² (0,3 с, the dynamometer shows 9,9 Н, the jets get stronger), let go at the starting height with
 *     3,0 м/с upward and stop. The bodies rise 0,46 м in 0,31 с, fall back past the hands and on into the basin: 0,90 с
 *     from the release. During the whole flight, up and down, no new water leaves the holes (the water already outside
 *     flies on) and the dynamometer shows 0.
 * «Замедлить в 5 раз» (on by default) slows everything; the stopwatch counts real seconds from the release.
 * The inset shows the scale of the dynamometer four times larger (0…10 Н).
 */
import SptStyles from './SptStyles.astro';
---

<SptStyles />
<figure class="g7 g7--wide spt not-content" data-bottlelab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 340" role="img" aria-label="Человек держит бутылку с водой, из трёх отверстий в ней бьют струйки, и динамометр с грузом. Когда он отпускает или подбрасывает их, струйки перестают вытекать, а динамометр показывает ноль">
			<rect class="spt-room" x="0" y="0" width="360" height="330"></rect>
			<rect class="spt-floor" x="0" y="330" width="360" height="10"></rect>
			<!-- the soft basin -->
			<path class="spt-basin" d="M106 330 V318 Q106 314 112 314 H316 Q322 314 322 318 V330 Z"></path>
			<path class="spt-basin-in" d="M112 317 H316"></path>
			<g data-backf></g>
			<g data-water></g>
			<!-- the dynamometer: ring, body with a scale, hook, weight; origin at the grip on the ring -->
			<g data-dyn>
				<!-- the ring hangs on the curled fingers: its plane is across the picture, so it is seen edge-on, a thin loop
				     whose top wire (at the origin) runs toward the viewer inside the fingers -->
				<ellipse class="spt-dyn-ring" cx="0" cy="4.5" rx="1.3" ry="4.5"></ellipse>
				<rect class="spt-dyn-body" x="-2.2" y="8.6" width="4.4" height="18" rx="1.2"></rect>
				<line class="spt-dyn-tick" x1="-1.2" y1="12.6" x2="1.2" y2="12.6"></line>
				<line class="spt-dyn-tick" x1="-1.2" y1="18.6" x2="1.2" y2="18.6"></line>
				<line class="spt-dyn-tick" x1="-1.2" y1="24.6" x2="1.2" y2="24.6"></line>
				<rect class="spt-dyn-pointer" data-dynptr x="-2.6" y="11.6" width="5.2" height="1.2"></rect>
				<path class="spt-dyn-hook" d="M0 26.6 V30.6 Q0 33.1 -1.8 32.6 Q-3 32 -2.4 30.8"></path>
				<rect class="spt-weight" x="-2.8" y="32.8" width="5.6" height="6.8" rx="0.8"></rect>
			</g>
			<!-- the bottle; origin at the grip on the neck -->
			<g data-bottle>
				<!-- a narrow neck 13 px (10 см) long, the cap above the hand, the shoulders below it -->
				<path class="spt-bottle" d="M-1.9 -8.6 H1.9 V4.6 Q5.2 6.6 5.2 11 V31 Q5.2 32.6 3.6 32.6 H-3.6 Q-5.2 32.6 -5.2 31 V11 Q-5.2 6.6 -1.9 4.6 Z"></path>
				<path class="spt-bottle-water" d="M-2.9 6.6 H2.9 Q5 8.4 5 11 V31 Q5 32.4 3.6 32.4 H-3.6 Q-5 32.4 -5 31 V11 Q-5 8.4 -2.9 6.6 Z"></path>
				<rect class="spt-cap2" x="-2.3" y="-11.6" width="4.6" height="3.2" rx="0.6"></rect>
				<path class="spt-cap-ribs" d="M-1.4 -11.2 V-8.8 M0 -11.2 V-8.8 M1.4 -11.2 V-8.8"></path>
				<circle class="spt-hole" cx="5.1" cy="13.1" r="0.6"></circle>
				<circle class="spt-hole" cx="5.1" cy="19.6" r="0.6"></circle>
				<circle class="spt-hole" cx="5.1" cy="26.1" r="0.6"></circle>
			</g>
			<g data-man></g>
			<!-- the inset: the dynamometer's scale ×4 -->
			<g transform="translate(300 18)">
				<rect class="spt-inset" x="-30" y="-10" width="80" height="150" rx="6"></rect>
				<text class="t-small" x="10" y="4" text-anchor="middle">динамометр</text>
				<rect class="spt-dyn-body" x="-4" y="14" width="16" height="104" rx="3"></rect>
				<g data-iscale></g>
				<rect class="spt-dyn-pointer" data-iptr x="-8" y="0" width="24" height="2.4"></rect>
				<text class="t-strong t-num" x="10" y="134" text-anchor="middle" data-iread>4,9 Н</text>
			</g>
			<!-- the stopwatch -->
			<g transform="translate(206 34)">
				<circle class="spt-clock" r="17"></circle>
				<line class="ink" data-hand x1="0" y1="0" x2="0" y2="-13"></line>
				<circle class="ink" r="1.4"></circle>
				<text class="t-small t-num" x="0" y="31" text-anchor="middle" data-time>0,00 с</text>
			</g>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn is-on" data-act="hold">Держать</button>
				<button type="button" class="g7__btn g7__btn--go" data-act="drop">Отпустить</button>
				<button type="button" class="g7__btn g7__btn--go" data-act="throw">Подбросить</button>
			</div>
			<label class="spt-switch"><input type="checkbox" data-slow checked /> Замедлить в 5 раз</label>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Пока бутылку и динамометр держат, из отверстий бьют струйки, а динамометр показывает 4,9&nbsp;Н. В полёте — и вниз, и вверх — новая вода из отверстий не вытекает, а динамометр показывает ноль. Шкала динамометра справа показана в 4 раза крупнее. Секундомер показывает настоящее время и тогда, когда опыт замедлен.
	</figcaption>
</figure>

<style is:global>
	.spt .spt-room {
		fill: color-mix(in oklab, var(--ig-v) 5%, var(--g7-paper));
	}
	.spt .spt-floor {
		fill: var(--g7-wood);
	}
	.spt .spt-basin {
		fill: color-mix(in oklab, var(--ig-vy) 35%, var(--sl-color-gray-4));
	}
	.spt .spt-basin-in {
		stroke: color-mix(in oklab, var(--ig-vy) 25%, var(--sl-color-gray-5));
		stroke-width: 2;
	}
	.spt .spt-bottle {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 14%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.7;
	}
	.spt .spt-bottle-water,
	.spt .spt-drop {
		fill: color-mix(in srgb, var(--ig-vx) 60%, transparent);
	}
	.spt .spt-drop {
		fill: var(--g7-water-edge);
	}
	.spt .spt-cap2 {
		fill: var(--g7-blue);
	}
	.spt .spt-cap-ribs {
		stroke: color-mix(in oklab, var(--g7-blue) 60%, black);
		stroke-width: 0.4;
	}
	.spt .spt-hole {
		fill: var(--sl-color-gray-1);
	}
	.spt .spt-dyn-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.spt .spt-dyn-hook {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 1;
	}
	.spt .spt-dyn-body {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-steel);
		stroke-width: 0.8;
	}
	.spt .spt-dyn-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.5;
	}
	.spt .spt-dyn-pointer {
		fill: var(--g7-red);
	}
	.spt .spt-weight {
		fill: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-3));
		stroke: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
		stroke-width: 0.5;
	}
	.spt .spt-inset {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-4);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, f1, fmt, G } from './spt';
	import { figure } from '@components/people/body';
	import { ROLL } from '@components/people/hand';
	import { blendShape, handShape } from '@components/people/hand';
	import type { Pt } from '@components/people/core';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-bottlelab]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const K = 130; // px per metre
		const S = K / 100;
		const FLOOR = 330;
		const BASIN = 0.12; // the top of the soft basin, м above the floor
		const yPx = (m: number) => FLOOR - m * K;
		const MASS = 0.5;
		// the man
		const H = 175;
		const u = H * S;
		const MX = 64;
		const man = figure($<SVGGElement>('[data-man]'), { s: S, H, clothes: 'indoor', shirt: 'hm-green', hair: 'short', name: 'man' });
		man.backLayer(1, $<SVGGElement>('[data-backf]'));
		const HIP: Pt = { x: MX, y: FLOOR - 0.52 * u + 1 };
		const ANK = FLOOR - 0.045 * u;
		// the grips (м above the floor) when held still: the bottle's bottom and the weight's bottom 1,25 м above the basin
		const BOT0 = BASIN + 1.25;
		const NECK = 0.25; // the grip on the neck is 25 см (32,6 px) above the bottle's bottom: px 32,6 / 130
		const neckOff = 32.6 / K; // м from the grip to the bottom of the bottle
		const dynOff = 39.6 / K; // м from the grip on the ring to the bottom of the weight
		const BXp = MX + 0.56 * K; // the bottle's column (far hand, stretched forward)
		const DXp = MX + 0.44 * K; // the dynamometer's column (near hand, the arm nearly straight, so the dynamometer hangs clear of the forearm)
		void NECK;
		const bottle = $<SVGGElement>('[data-bottle]');
		const dyn = $<SVGGElement>('[data-dyn]');
		// the dynamometer goes into the man's drawing between his far arm (behind it) and the rest (in front of it),
		// with the back parts of his near hand behind it
		const root = $<SVGGElement>('[data-man]').firstElementChild!;
		const farGroup = root.firstElementChild!;
		const backN = el('g', {});
		farGroup.after(backN, dyn);
		man.backLayer(0, backN);
		// holes: px below the grip, depth below the water surface (м)
		const HOLES = [
			{ dy: 13.1, depth: 0.05 },
			{ dy: 19.6, depth: 0.1 },
			{ dy: 26.1, depth: 0.15 },
		];
		// the inset scale
		const isc = $<SVGGElement>('[data-iscale]');
		const IS0 = 20; // 0 Н
		const ISK = 9.4; // px per newton
		for (let n = 0; n <= 10; n++) {
			isc.append(el('line', { class: 'spt-dyn-tick', x1: n % 2 ? 2 : -1, y1: IS0 + n * ISK, x2: 9, y2: IS0 + n * ISK, 'stroke-width': 0.9 }));
			if (n % 2 === 0) {
				const t = el('text', { class: 't-small t-num', x: 22, y: f1(IS0 + n * ISK + 3.5) });
				t.textContent = String(n);
				isc.append(t);
			}
		}
		const iptr = $<SVGRectElement>('[data-iptr]');
		const iread = $<SVGTextElement>('[data-iread]');
		const dptr = $<SVGRectElement>('[data-dynptr]');
		const handS = $<SVGLineElement>('[data-hand]');
		const timeT = $<SVGTextElement>('[data-time]');
		const read = $<HTMLUListElement>('[data-read]');
		const slow = $<HTMLInputElement>('[data-slow]');
		const waterG = $<SVGGElement>('[data-water]');

		type Mode = 'hold' | 'drop' | 'throw';
		let mode: Mode = 'hold';
		let tau = 0; // physics seconds since the button
		const T_DIP = 0.7;
		const T_REL_THROW = T_DIP + 0.3; // the push: 0,45 м at 10 м/с²
		const V_REL = 3.0;
		const T_OPEN = 0.1;
		// the hands' offset (м, up positive) from the holding height, and its acceleration
		const handOff = (t: number): [number, number] => {
			if (mode !== 'throw') return [0, 0];
			if (t < T_DIP) {
				const w = Math.PI / T_DIP;
				return [-0.225 * (1 - Math.cos(w * t)), -0.225 * w * w * Math.cos(w * t)];
			}
			if (t < T_REL_THROW) {
				const s = t - T_DIP;
				return [-0.45 + 5 * s * s, 10];
			}
			const s = t - T_REL_THROW;
			const TS = (2 * 0.05) / V_REL;
			if (s < TS) return [V_REL * s - (0.5 * V_REL * s * s) / TS, -V_REL / TS];
			if (s < TS + 0.6) {
				const e = (s - TS) / 0.6;
				return [0.05 * (1 - e * e * (3 - 2 * e)), 0];
			}
			return [0, 0];
		};
		const tRel = () => (mode === 'drop' ? 0 : mode === 'throw' ? T_REL_THROW : Infinity);
		const vRel = () => (mode === 'throw' ? V_REL : 0);
		// a body's offset (м) from its holding height: with the hands, then flying freely, then resting in the basin
		const bodyOff = (t: number, fallTo: number): { off: number; a: number; flying: boolean; landed: boolean } => {
			const tr = tRel();
			if (t < tr) {
				const [o, a] = handOff(t);
				return { off: o, a, flying: false, landed: false };
			}
			const s = t - tr;
			const v = vRel();
			const off = v * s - 0.5 * G * s * s;
			if (off <= -fallTo) return { off: -fallTo, a: 0, flying: false, landed: true };
			return { off, a: -G, flying: true, landed: false };
		};
		const tLand = (fallTo: number) => tRel() + (vRel() + Math.sqrt(vRel() ** 2 + 2 * G * fallTo)) / G;
		// water drops: x, y (м, y up), vx, vy
		type Drop = { x: number; y: number; vx: number; vy: number; e: SVGCircleElement };
		const drops: Drop[] = [];
		let emitAcc = 0;
		const draw = () => {
			const bo = bodyOff(tau, 1.25);
			const dof = bodyOff(tau, 1.25);
			const [ho] = handOff(tau);
			// grips of the hands (px)
			const bGrip = { x: BXp, y: yPx(BOT0 + neckOff) };
			const dGrip = { x: DXp, y: yPx(BOT0 + dynOff) };
			const tr = tRel();
			const open = tau >= tr ? Math.min(1, (tau - tr) / T_OPEN) : 0; // the fingers open
			const handN = { x: bGrip.x, y: bGrip.y - ho * K };
			const handF = { x: dGrip.x, y: dGrip.y - ho * K };
			const holding = open < 1e-6;
			const gripN = handShape('grip', (3 * S) / (0.105 * u));
			const gripF = handShape('grip', (1 * S) / (0.105 * u)); // the ring's wire
			const opn = handShape('open');
			man.pose({
				hip: HIP,
				lean: -0.02,
				head: 0.25,
				ankles: [
					{ x: MX + 6, y: ANK },
					{ x: MX - 5, y: ANK },
				],
				feet: [0, 0],
				planted: [true, true],
				hands: [
					{ at: handF, pose: open < 0.5 ? 'grip' : 'open', d: 1, shape: blendShape(gripF, opn, open), dir: 0, roll: -0.5, contact: holding ? 'dynamometer-ring' : undefined },
					{ at: handN, pose: open < 0.5 ? 'grip' : 'open', d: 3, shape: blendShape(gripN, opn, open), dir: -0.05, roll: ROLL.backViewer, contact: holding ? 'bottle-neck' : undefined },
				],
			});
			bottle.setAttribute('transform', `translate(${f1(bGrip.x)} ${f1(bGrip.y - bo.off * K)})`);
			dyn.setAttribute('transform', `translate(${f1(dGrip.x)} ${f1(dGrip.y - dof.off * K)})`);
			// the reading: m(g + a) while held; 0 while flying and after landing
			const reading = bo.flying || bo.landed ? 0 : MASS * (G + bo.a);
			const shownR = Math.min(10.5, Math.max(0, reading));
			iptr.setAttribute('y', f1(IS0 + shownR * ISK - 1.2 + 0));
			iread.textContent = `${fmt(reading, 1)} Н`;
			dptr.setAttribute('y', f1(11.6 + (shownR / 10) * 12));
			// the stopwatch: real seconds from the release
			const tl = Math.max(tLand(1.25), 0);
			const tw = mode === 'hold' ? 0 : Math.max(0, Math.min(tau, tl) - tr);
			timeT.textContent = `${fmt(tw, 2)} с`;
			handS.setAttribute('x2', f1(13 * Math.sin(2 * Math.PI * tw)));
			handS.setAttribute('y2', f1(-13 * Math.cos(2 * Math.PI * tw)));
			const phase = mode === 'hold' ? 'держат' : bo.landed ? 'в тазу' : bo.flying ? (bo.off > 0 && tau - tr < V_REL / G ? 'летят вверх' : 'летят вниз') : mode === 'throw' ? 'рука разгоняет' : 'держат';
			read.innerHTML = [
				`<li class="is-key"><span>Показание динамометра</span><b>${fmt(reading, 1)} Н</b></li>`,
				`<li><span>Бутылка и динамометр</span><b>${phase}</b></li>`,
				`<li><span>Время полёта</span><b>${mode === 'hold' ? '—' : `${fmt(tw, 2)} с`}</b></li>`,
			].join('');
			// drops
			for (const d of drops) {
				d.e.setAttribute('cx', f1(d.x * K));
				d.e.setAttribute('cy', f1(yPx(d.y)));
			}
		};
		const step = (dtp: number) => {
			const t0 = tau;
			tau += dtp;
			// emit water from the holes while the bottle is not free: speed √(2(g + a)Δh) relative to the bottle
			const bo = bodyOff(tau, 1.25);
			const gEff = bo.flying || bo.landed ? 0 : G + bo.a;
			emitAcc += dtp;
			const EVERY = 0.012;
			while (emitAcc >= EVERY) {
				emitAcc -= EVERY;
				if (gEff <= 0) continue;
				// the bottle's own vertical speed (numerically)
				const b1 = bodyOff(tau, 1.25).off;
				const b0 = bodyOff(Math.max(0, tau - 0.002), 1.25).off;
				const vb = (b1 - b0) / 0.002;
				for (const h of HOLES) {
					const v = Math.sqrt(2 * gEff * h.depth);
					const yGrip = BOT0 + neckOff + bo.off;
					const e = el('circle', { class: 'spt-drop', r: 0.9 });
					waterG.append(e);
					drops.push({ x: (BXp + 5.6) / K, y: yGrip - h.dy / K, vx: v, vy: vb, e });
				}
			}
			void t0;
			// move the drops; remove them in the basin or on the floor
			for (let i = drops.length - 1; i >= 0; i--) {
				const d = drops[i];
				d.vy -= G * dtp;
				d.x += d.vx * dtp;
				d.y += d.vy * dtp;
				const inBasin = d.x * K > 108 && d.x * K < 320;
				if (d.y <= (inBasin ? BASIN : 0)) {
					d.e.remove();
					drops.splice(i, 1);
				}
			}
		};
		// let the jets fill in before the first view
		for (let i = 0; i < 80; i++) step(0.01);
		const wake = loop(fig, (dt) => {
			step(dt * (slow.checked ? 0.2 : 1));
			draw();
			return true;
		});
		for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-act]')) {
			b.addEventListener('click', () => {
				mode = b.dataset.act as Mode;
				tau = 0;
				fig.querySelectorAll('[data-act]').forEach((x) => x.classList.toggle('is-on', x === b));
				draw();
				wake();
			});
		}
		draw();
	}
</script>
