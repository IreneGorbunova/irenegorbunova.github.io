---
/**
 * Picture: an apple falls from a branch beside a vertical ruler 0…130 см; a flash every 0,1 с leaves a faint copy of
 * the apple (a strobe photograph). Scale 2 px per centimeter on both axes (the apple of 8 см is 16 px), so the copies
 * near the top overlap, as on a real photograph.
 * Physics: free fall from rest, g = 9,8 м/с²: the apple is 0; 4,9; 19,6; 44,1; 78,4; 122,5 см below its start at
 * t = 0; 0,1; …; 0,5 с, with speeds 0; 0,98; 1,96; 2,94; 3,92; 4,90 м/с (blue arrows, 10 px per м/с, beside each copy).
 * The gaps 4,9; 14,7; 24,5; 34,3; 44,1 см go as 1 : 3 : 5 : 7 : 9 (gold braces). One red arrow g of constant length
 * goes with the apple. The apple falls in real time (0,5 с); then the speeds and the gaps appear one by one, the
 * picture holds and repeats («Повторить» starts it again).
 */
import SptStyles from './SptStyles.astro';

const Y0 = 44; // the apple's center at t = 0 (ruler 0)
const PX = 2; // px per centimeter
const ticks = Array.from({ length: 14 }, (_, i) => i * 10);
---

<SptStyles />
<figure class="g7 g7--pic spt spt-small not-content" data-strobepic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 352" role="img" aria-label="Падающее яблоко, снятое при вспышках через каждые 0,1 секунды, рядом с линейкой. Промежутки между снимками растут как 1 : 3 : 5 : 7 : 9, синие стрелки скорости становятся всё длиннее, красная стрелка ускорения не меняется">
			<!-- the branch -->
			<path class="spt-branch" d="M300 14 Q240 16 196 24 Q176 28 160 26 Q154 25 150 27 L150.6 34 M214 21 Q222 10 238 8"></path>
			<path class="spt-leafy" d="M238 8 q10 -6 18 2 q-10 6 -18 -2 Z M172 26 q-6 -10 -18 -8 q6 10 18 8 Z M214 22 q4 -10 14 -10 q-2 10 -14 10 Z"></path>
			<!-- the ruler -->
			<rect class="spt-ruler" x="44" y={Y0 - 6} width="22" height={130 * PX + 12} rx="2"></rect>
			{ticks.map((c) => (
				<g>
					<line class="ln" x1="66" y1={Y0 + c * PX} x2={c % 20 === 0 ? 56 : 60} y2={Y0 + c * PX}></line>
					{c % 20 === 0 && <text class="t-small t-num" x="40" y={Y0 + c * PX + 3.5} text-anchor="end">{c}</text>}
				</g>
			))}
			{Array.from({ length: 130 }, (_, i) => i + 1).filter((c) => c % 10 !== 0 && c % 2 === 0).map((c) => <line class="ln spt-mm" x1="66" y1={Y0 + c * PX} x2="63" y2={Y0 + c * PX}></line>)}
			<text class="t-small" x="40" y={Y0 - 14} text-anchor="end">см</text>
			<g data-braces></g>
			<g data-copies></g>
			<g data-vel></g>
			<g data-apple>
				<path class="spt-apple" d="M0 -6.6 Q4.6 -9.8 7.6 -5.8 Q10.2 -1 7.6 4.4 Q4.4 9.4 0 7.6 Q-4.4 9.4 -7.6 4.4 Q-10.2 -1 -7.6 -5.8 Q-4.6 -9.8 0 -6.6 Z"></path>
				<path class="spt-stem" d="M0 -6.2 q0.4 -3 1.8 -4.6"></path>
				<ellipse class="spt-apple-hl" cx="-3.6" cy="-2.4" rx="1.6" ry="2.6"></ellipse>
			</g>
			<g data-g></g>
			<text class="t-small t-gold" x="8" y="332" data-ratio opacity="0"><tspan x="8">Промежутки:</tspan><tspan x="8" dy="13">1 : 3 : 5 : 7 : 9</tspan></text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Яблоко снято при вспышках через каждые 0,1&nbsp;с: бледные снимки показывают, где оно было в эти моменты. Синие стрелки — скорость яблока, красная — ускорение свободного падения <i>g</i>; оно одно и то же во всё время падения. Яблоко и линейка в одном масштабе, яблоко падает в настоящем времени.
		<button type="button" class="g7__btn g7__again" data-again>Повторить</button>
	</figcaption>
</figure>

<style is:global>
	.spt .spt-branch {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke-width: 3;
		stroke-linecap: round;
	}
	.spt .spt-leafy {
		fill: color-mix(in oklab, hsl(120, 45%, 40%) 70%, var(--sl-color-gray-5));
	}
	.spt .spt-ruler {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--g7-paper));
		stroke: var(--sl-color-gray-4);
	}
	.spt .spt-mm {
		opacity: 0.6;
	}
	.spt .spt-apple {
		fill: hsl(356, 72%, 52%);
		stroke: hsl(356, 60%, 32%);
		stroke-width: 0.8;
	}
	.spt .spt-stem {
		fill: none;
		stroke: hsl(25, 40%, 30%);
		stroke-width: 1.2;
	}
	.spt .spt-apple-hl {
		fill: hsl(0, 0%, 100%);
		opacity: 0.45;
	}
	.spt .spt-brace {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, f1, fmt, G, label, newArrow } from './spt';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-strobepic]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const Y0 = 44;
		const PX = 200; // px per metre
		const AX = 150; // the apple's column
		const VS = 10; // px per м/с
		const apple = $<SVGGElement>('[data-apple]');
		const yOf = (t: number) => Y0 + 0.5 * G * t * t * PX;
		// the copies at 0 … 0,5 с
		const copies = [0, 1, 2, 3, 4, 5].map((k) => {
			const c = apple.cloneNode(true) as SVGGElement;
			c.removeAttribute('data-apple');
			c.classList.add('spt-ghost');
			c.setAttribute('transform', `translate(${AX} ${f1(yOf(0.1 * k))})`);
			$('[data-copies]').append(c);
			return c;
		});
		// the speeds beside the copies: an arrow down from the copy's side and the number
		const velG = $<SVGGElement>('[data-vel]');
		const vels = [1, 2, 3, 4, 5].map((k) => {
			const g = el('g', { opacity: 0 });
			const y = yOf(0.1 * k);
			const v = G * 0.1 * k;
			newArrow(g, 'blue')(AX + 14, y, AX + 14, y + v * VS, 6, 3.5);
			const t = el('text', { class: 't-small t-num t-blue', x: AX + 22, y: f1(y + Math.max(4, (v * VS) / 2 + 3.5)) });
			t.textContent = `${fmt(v, 2)} м/с`;
			g.append(t);
			velG.append(g);
			return g;
		});
		// the zero speed at the start
		const v0 = el('text', { class: 't-small t-num t-blue', x: AX + 14, y: Y0 + 4, opacity: 0 });
		v0.textContent = '0 м/с';
		velG.append(v0);
		// the gaps: gold braces between the ruler and the apples
		const braceG = $<SVGGElement>('[data-braces]');
		const braces = [1, 2, 3, 4, 5].map((k) => {
			const g = el('g', { opacity: 0 });
			const a = yOf(0.1 * (k - 1));
			const b = yOf(0.1 * k);
			const x = 84;
			const m = (a + b) / 2;
			g.append(el('path', { class: 'spt-brace', d: `M${x + 4} ${f1(a + 1)} Q${x} ${f1(a + 1)} ${x} ${f1(Math.min(a + 5, m))} V${f1(m - 2)} L${x - 3} ${f1(m)} L${x} ${f1(m + 2)} V${f1(Math.max(b - 5, m))} Q${x} ${f1(b - 1)} ${x + 4} ${f1(b - 1)}` }));
			const gap = 0.5 * G * ((0.1 * k) ** 2 - (0.1 * (k - 1)) ** 2) * 100;
			const t = el('text', { class: 't-small t-num t-gold', x: x + 8, y: f1(m + 3.5) });
			t.textContent = `${fmt(gap, 1)}`;
			g.append(t);
			braceG.append(g);
			return g;
		});
		// the unit of the gaps next to the last one
		const unit = el('text', { class: 't-small t-gold', x: 92, y: f1((yOf(0.4) + yOf(0.5)) / 2 + 16), opacity: 0 });
		unit.textContent = 'см';
		braceG.append(unit);
		const gArrow = newArrow($<SVGGElement>('[data-g]'), 'red');
		const gText = label($<SVGGElement>('[data-g]'), 0, 0, [['g']], { class: 't-red' });
		const ratio = $<SVGTextElement>('[data-ratio]');
		const T_FALL = 0.5;
		const STEP = 0.45; // s between the labels that appear
		const CYCLE = 0.6 + T_FALL + 0.4 + 6 * STEP + 3.5;
		let t = 0;
		const draw = () => {
			const tf = Math.max(0, Math.min(T_FALL, t - 0.6));
			const y = yOf(tf);
			apple.setAttribute('transform', `translate(${AX} ${f1(y)})`);
			copies.forEach((c, k) => c.setAttribute('visibility', t - 0.6 >= 0.1 * k - 1e-6 ? 'visible' : 'hidden'));
			gArrow(AX - 14, y, AX - 14, y + 30, 6, 3.5);
			gText.setAttribute('x', f1(AX - 30));
			gText.setAttribute('y', f1(y + 24));
			const ta = t - 0.6 - T_FALL - 0.4; // after the fall
			v0.setAttribute('opacity', ta >= 0 ? '1' : '0');
			vels.forEach((g, i) => g.setAttribute('opacity', ta >= STEP * (i + 0.5) ? '1' : '0'));
			braces.forEach((g, i) => g.setAttribute('opacity', ta >= STEP * (i + 0.5) ? '1' : '0'));
			unit.setAttribute('opacity', ta >= STEP * 5 ? '1' : '0');
			ratio.setAttribute('opacity', ta >= STEP * 6 ? '1' : '0');
		};
		const wake = loop(fig, (dt) => {
			t += dt;
			if (t >= CYCLE) t = 0;
			draw();
			return true;
		});
		$('[data-again]').addEventListener('click', () => {
			t = 0;
			draw();
			wake();
		});
		draw();
	}
</script>
