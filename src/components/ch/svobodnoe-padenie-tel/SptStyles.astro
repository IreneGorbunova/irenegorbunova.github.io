---
/**
 * Styles shared by the pictures and models of «Свободное падение» (grade 9), scoped under `.spt` (every figure of the
 * chapter has it next to `g7`). Renders nothing. Arrow colors come from G7Styles (arrow--blue velocity, arrow--red the
 * acceleration g, arrow--gold displacement and heights).
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';
---

<G7Styles />
<KitStyles />
<style is:global>
	.spt-small .g7__grid {
		max-width: 22rem;
		margin-inline: auto;
	}
	.spt-small .g7__caption {
		max-width: 34rem;
		margin-inline: auto;
	}
	.spt .spt-grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.spt .spt-glass {
		fill: color-mix(in srgb, var(--ig-vx) 7%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.spt .spt-glass-hl {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		opacity: 0.35;
		stroke-linecap: round;
	}
	.spt .spt-cap {
		fill: var(--g7-steel);
		stroke: var(--g7-steel-dark);
		stroke-width: 1;
	}
	.spt .spt-air {
		fill: var(--sl-color-gray-3);
		opacity: 0.55;
	}
	.spt .spt-lead {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--ig-vx) 10%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.spt .spt-cork {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
		stroke-width: 0.6;
	}
	.spt .spt-feather {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.5;
	}
	.spt .spt-quill {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.spt .spt-hose {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.spt .spt-ref {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.spt .spt-ball {
		fill: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.spt .spt-ghost {
		opacity: 0.35;
	}
	.spt .spt-dot {
		fill: var(--g7-blue);
	}
	.spt .spt-dot--now {
		fill: var(--sl-color-white);
		stroke: var(--g7-blue);
		stroke-width: 2;
	}
	.spt .spt-curve {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.spt .spt-clock {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.spt .spt-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.spt .spt-switch input {
		width: 1.05rem;
		height: 1.05rem;
		accent-color: var(--sl-color-accent);
	}
</style>
