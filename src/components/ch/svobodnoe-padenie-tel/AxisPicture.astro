---
/**
 * Picture: the axis Oy for the two cases of the chapter, a small static scheme (no scale).
 *   mode="down" (a falling body): the start point O at the top, the axis Oy pointing DOWN from it; the ball at O with
 *     its initial velocity υ₀ (blue, down) and g (red, down); a later position of the ball lower down, its velocity υ
 *     longer; the distance fallen h (gold, from O to the ball). υ_y > 0 and g_y = g.
 *   mode="up" (a body thrown up): the point of the throw O at the bottom, the axis Oy pointing UP; at O the velocity υ₀
 *     up; higher up a shorter velocity; at the top point υ = 0; g (red, down) has the same length everywhere; the
 *     greatest height H (gold, from O to the top). g_y = −g.
 * The formulas stand in the text right after the picture (not repeated here). Colors of the chapter: velocity blue, g red, distances gold.
 * The labels of the vector arrows (υ⃗₀, υ⃗, g⃗) carry a small arrow over the letter (Irina, 28 Nov 2026), drawn as a short
 * path over the glyph as in sistema-otscheta/ProjAnglePicture; projections (υ_y, g_y) and distances (h, H) do not.
 */
import SptStyles from './SptStyles.astro';

interface Props {
	mode: 'down' | 'up';
}
const { mode } = Astro.props;
// arrows: [x1, y1, x2, y2, color]
type A = [number, number, number, number, 'blue' | 'red' | 'gold'];
const head = (x1: number, y1: number, x2: number, y2: number, hl = 7, hw = 4) => {
	const L = Math.hypot(x2 - x1, y2 - y1);
	const ux = (x2 - x1) / L;
	const uy = (y2 - y1) / L;
	const bx = x2 - ux * hl;
	const by = y2 - uy * hl;
	return { shaft: `M${x1} ${y1} L${(bx + ux * 0.5).toFixed(1)} ${(by + uy * 0.5).toFixed(1)}`, tip: `M${x2} ${y2} L${(bx - uy * hw).toFixed(1)} ${(by + ux * hw).toFixed(1)} L${(bx + uy * hw).toFixed(1)} ${(by - ux * hw).toFixed(1)} Z` };
};
const BX = 172; // the balls' column
const R = 8;
const G_LEN = 30; // the red arrow g: the same everywhere
let arrows: A[];
let balls: { y: number; faint?: boolean }[];
let axis: { y0: number; y1: number }; // from O to the arrow tip
let hMark: { y0: number; y1: number; name: string };
if (mode === 'down') {
	axis = { y0: 34, y1: 218 };
	balls = [{ y: 34 }, { y: 150, faint: true }];
	arrows = [
		[BX, 34 + R, BX, 34 + R + 22, 'blue'],
		[BX + 24, 34 - 6, BX + 24, 34 - 6 + G_LEN, 'red'],
		[BX, 150 + R, BX, 150 + R + 44, 'blue'],
		[BX + 24, 150 - 6, BX + 24, 150 - 6 + G_LEN, 'red'],
	];
	hMark = { y0: 34, y1: 150, name: 'h' };
} else {
	axis = { y0: 206, y1: 18 };
	balls = [{ y: 206 }, { y: 130, faint: true }, { y: 58, faint: true }];
	arrows = [
		[BX, 206 - R, BX, 206 - R - 48, 'blue'],
		[BX + 24, 206 - 12, BX + 24, 206 - 12 + G_LEN, 'red'],
		[BX, 130 - R, BX, 130 - R - 24, 'blue'],
		[BX + 24, 130 - 12, BX + 24, 130 - 12 + G_LEN, 'red'],
		[BX + 24, 58 - 12, BX + 24, 58 - 12 + G_LEN, 'red'],
	];
	hMark = { y0: 206, y1: 58, name: 'H' };
}
// a small arrow over a letter: from x0 to x1, about 10 px over the baseline of a 14 px letter
const vec = (x0: number, x1: number, yy: number) => {
	const y = yy + 2; // the letters (υ, g) have no ascenders: the arrow sits just over the x-height
	return `M${x0} ${y} H${x1} M${x1 - 2.5} ${y - 2.5} L${x1} ${y} L${x1 - 2.5} ${y + 2.5}`;
};
const paths = arrows.map(([x1, y1, x2, y2, c]) => ({ ...head(x1, y1, x2, y2), c }));
const hm = { a: head(58, (hMark.y0 + hMark.y1) / 2, 58, hMark.y0, 6, 3.5), b: head(58, (hMark.y0 + hMark.y1) / 2, 58, hMark.y1, 6, 3.5) };
const ax = head(104, axis.y0, 104, axis.y1, 9, 4.5);
const aria =
	mode === 'down'
		? 'Ось Oy направлена вниз от точки начала падения O. Скорость тела и ускорение свободного падения направлены вниз; скорость растёт; h — расстояние от O до тела'
		: 'Ось Oy направлена вверх от точки броска O. Скорость тела направлена вверх и уменьшается, в верхней точке она равна нулю; ускорение свободного падения всё время направлено вниз; H — наибольшая высота подъёма';
---

<SptStyles />
<figure class="g7 g7--pic spt spt-small not-content" data-axispic={mode}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 236" role="img" aria-label={aria}>
			<!-- the axis -->
			<path class="ink" d={ax.shaft}></path>
			<path class="head--ink" d={ax.tip}></path>
			<line class="ln" x1="98" y1={axis.y0} x2="110" y2={axis.y0}></line>
			<text class="t-i" x="94" y={axis.y0 + 5} text-anchor="end">O</text>
			<text class="t-i" x="114" y={axis.y1 + (mode === 'down' ? -2 : 10)}>y</text>
			<!-- the gold distance -->
			<line class="ln-dash" x1="58" y1={hMark.y1} x2={BX - R} y2={hMark.y1}></line>
			<line class="ln-dash" x1="58" y1={hMark.y0} x2="80" y2={hMark.y0}></line>
			<path class="arrow arrow--gold" d={hm.a.shaft}></path>
			<path class="head--gold" d={hm.a.tip}></path>
			<path class="arrow arrow--gold" d={hm.b.shaft}></path>
			<path class="head--gold" d={hm.b.tip}></path>
			<text class="t-i t-gold t-halo" x="50" y={(hMark.y0 + hMark.y1) / 2 + 5} text-anchor="end">{hMark.name}</text>
			<!-- the balls -->
			{balls.map((b) => <circle class={`spt-ball${b.faint ? ' spt-ghost' : ''}`} cx={BX} cy={b.y} r={R}></circle>)}
			{paths.map((p) => (
				<g>
					<path class={`arrow arrow--${p.c}`} d={p.shaft}></path>
					<path class={`head--${p.c}`} d={p.tip}></path>
				</g>
			))}
			{mode === 'down' ? (
				<g>
					<text class="t-blue" x={BX - 26} y="66"><tspan class="t-i">υ</tspan><tspan baseline-shift="sub" font-size="9">0</tspan></text>
					<path class="spt-vec spt-vec--blue" d={vec(BX - 25.5, BX - 17.5, 54)}></path>
					<text class="t-blue" x={BX - 21} y="196"><tspan class="t-i">υ</tspan></text>
					<path class="spt-vec spt-vec--blue" d={vec(BX - 20.5, BX - 12.5, 184)}></path>
					<text class="t-red" x={BX + 32} y="52"><tspan class="t-i">g</tspan></text>
					<path class="spt-vec spt-vec--red" d={vec(BX + 32.5, BX + 40, 40)}></path>
					<text class="t-red" x={BX + 32} y="168"><tspan class="t-i">g</tspan></text>
					<path class="spt-vec spt-vec--red" d={vec(BX + 32.5, BX + 40, 156)}></path>
					<text class="t-small" x={BX + 44} y="100"><tspan class="t-i">υ</tspan><tspan baseline-shift="sub" font-size="8">y</tspan> &gt; 0</text>
					<text class="t-small" x={BX + 44} y="118"><tspan class="t-i">g</tspan><tspan baseline-shift="sub" font-size="8">y</tspan> = <tspan class="t-i">g</tspan></text>
				</g>
			) : (
				<g>
					<text class="t-blue" x={BX - 26} y="176"><tspan class="t-i">υ</tspan><tspan baseline-shift="sub" font-size="9">0</tspan></text>
					<path class="spt-vec spt-vec--blue" d={vec(BX - 25.5, BX - 17.5, 164)}></path>
					<text class="t-blue" x={BX - 21} y="112"><tspan class="t-i">υ</tspan></text>
					<path class="spt-vec spt-vec--blue" d={vec(BX - 20.5, BX - 12.5, 100)}></path>
					<text class="t-small t-blue" x={BX - 12} y="44" text-anchor="end"><tspan class="t-i">υ</tspan> = 0</text>
					<text class="t-red" x={BX + 32} y="210"><tspan class="t-i">g</tspan></text>
					<path class="spt-vec spt-vec--red" d={vec(BX + 32.5, BX + 40, 198)}></path>
					<text class="t-red" x={BX + 32} y="134"><tspan class="t-i">g</tspan></text>
					<path class="spt-vec spt-vec--red" d={vec(BX + 32.5, BX + 40, 122)}></path>
					<text class="t-red" x={BX + 32} y="62"><tspan class="t-i">g</tspan></text>
					<path class="spt-vec spt-vec--red" d={vec(BX + 32.5, BX + 40, 50)}></path>
					<text class="t-small" x={BX + 44} y="96"><tspan class="t-i">g</tspan><tspan baseline-shift="sub" font-size="8">y</tspan> = −<tspan class="t-i">g</tspan></text>
				</g>
			)}
		</svg>
	</div>
	<figcaption class="g7__caption">
		{mode === 'down' ? 'Ось Oy направлена вниз, туда же, куда скорость и ускорение: их проекции положительны.' : 'Ось Oy направлена вверх: проекция скорости положительна, пока тело поднимается, а проекция ускорения отрицательна всё время.'}
	</figcaption>
</figure>

<style is:global>
	.spt .spt-vec {
		fill: none;
		stroke-width: 1.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.spt .spt-vec--blue {
		stroke: var(--g7-blue);
	}
	.spt .spt-vec--red {
		stroke: var(--g7-red);
	}
</style>
