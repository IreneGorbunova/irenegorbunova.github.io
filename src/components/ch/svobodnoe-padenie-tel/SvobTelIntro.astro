---
/**
 * Two short looping opening scenes of «Свободное падение» (grade 9). No terms of the chapter in the pictures or the
 * visible captions. People: the shared people kit (src/components/people/). The grade-10 chapter uses a caught ruler and
 * a sheet of paper against a ball, so these scenes use other subjects.
 *
 * Icicles (real time; the people walk for 12,2 с, the drops fall all the time, also while the end frame holds): early
 *   spring, a two-storey house seen from the front, 30 px per metre on both axes (0,30 px per centimeter for the
 *   people). From the tip of one long icicle, 6,0 м above a puddle on the sidewalk, a drop leaves every 0,25 с. Each
 *   falls freely, h = g t²/2 with g = 9,8 м/с²: it reaches the puddle after √(2·6,0/9,8) = 1,11 с at 10,8 м/с. When a
 *   new drop leaves the tip the earlier ones are 0,31; 1,23; 2,76 and 4,90 м below it: the gaps 0,31; 0,92; 1,53;
 *   2,14 м go as 1 : 3 : 5 : 7. Air drag on a drop of 4 мм at 10 м/с is about a tenth of its weight and is left out.
 *   Each landing sends a ring over the puddle. A mother (165 см) and her son (7 years, 122 см) walk along the sidewalk
 *   hand in hand at 1,2 м/с (steps of 62 and 46 см), in front of the drip line, across the whole frame in 12,2 с; the
 *   boy looks up at the icicles. Their
 *   hands are 5–6 px long, so the kit draws mittens (they wear them): holding hands reads at that size, a pointing
 *   finger would not, so nobody points.
 * Ball (real time, 3,2 с): a summer yard, 60 px per metre on both axes (0,60 px per centimeter for the people). A
 *   teenage boy (168 см) holds a volleyball (21 см) in both hands at his chest, bends his knees a little and pushes it
 *   straight up: his hands speed it up over 55 см (0,18 с) and let it go 1,6 м above the ground at 6,0 м/с. The ball
 *   rises H = υ₀²/(2g) = 1,84 м in 0,61 с, stops for an instant and comes back to his hands 1,22 с after leaving them,
 *   at 6,0 м/с; his hands give way by 40 см (0,13 с) and stop it. The motion is drawn without air drag (with it the ball
 *   of 270 г would rise about 6 % less: 1,72 м in 0,59 с, and fall back in 0,60 с). Faint balls mark where the ball was
 *   every 0,1 с on its way up: the gaps shrink 0,55; 0,45; 0,36; 0,26; 0,16; 0,06 м. A girl (158 см) sits on a bench
 *   and follows the ball with her head (within ±40°). The hands (about 10 px) are mittens of the kit, open, the fingers
 *   up along the ball: the near hand covers its lower front (the back of the hand to the viewer), the far hand is
 *   behind the ball.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

// ---- icicles: the puddle at y = 212, 30 px per metre
const K1 = 30;
const PY = 212;
const ICX = 232; // the long icicle
const TIP = PY - 6 * K1; // 32
const GUT = TIP - 0.35 * K1; // the gutter, 10,5 px above the tip
const yM = (m: number) => PY - m * K1;
// icicles along the gutter: x, length (px)
const icicles: [number, number][] = [
	[14, 5], [22, 8], [31, 4], [44, 7], [58, 11], [67, 5], [80, 3], [96, 9], [108, 6], [124, 4], [139, 8], [150, 12],
	[163, 5], [178, 7], [191, 4], [204, 9], [216, 6], [ICX, 10.5], [244, 7], [257, 4], [270, 9], [283, 5],
];
const icePath = icicles.map(([x, l]) => `M${x - 2.2} ${GUT} L${x} ${GUT + l} L${x + 2.2} ${GUT} Z`).join(' ');
const win = (x: number, sill: number, top: number, w: number) => {
	const y0 = yM(top);
	const y1 = yM(sill);
	return { x, y: y0, w, h: y1 - y0 };
};
const windows = [win(22, 0.9, 2.3, 30), win(106, 0.9, 2.3, 30), win(22, 3.9, 5.3, 30), win(106, 3.9, 5.3, 30), win(190, 3.9, 5.3, 30), win(262, 3.9, 5.3, 24)];
const bricks = Array.from({ length: 22 }, (_, i) => `M0 ${(GUT + 8 + i * 8.4).toFixed(1)} H300`).join(' ');

// ---- the yard: the ground at y = 232, 60 px per metre
const GY = 232;
const K2 = 60;
const boards = Array.from({ length: 24 }, (_, i) => `M${i * 15 + 2} ${GY - 0.95 * K2} V${GY - 6}`).join(' ');
---

<KitStyles />
<IntroFrame data-sptintro>
	<div class="intro__card" data-scene="drops">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ранняя весна. С длинной сосульки на краю крыши двухэтажного дома одна за другой срываются капли и падают в лужу на тротуаре. В воздухе сразу несколько капель, и чем ниже капля, тем больше расстояние до следующей. Мама с сыном идут по тротуару, держась за руки; мальчик смотрит на сосульки">
			<rect class="spt-sky" x="0" y="0" width="360" height="240"></rect>
			<circle class="spt-sun" cx="334" cy="28" r="13"></circle>
			<!-- a bare tree to the right of the house -->
			<path class="spt-branch" d="M336 206 L334 150 M334 168 L318 140 M335 158 L352 128 M334 150 L330 112 M330 126 L314 104 M331 120 L346 98 M318 140 L308 128 M352 128 L360 118"></path>
			<!-- the house: wall, plinth, roof with snow, gutter, drainpipe -->
			<rect class="spt-wall" x="0" y={GUT} width="300" height={206 - GUT}></rect>
			<path class="spt-brick" d={bricks}></path>
			<rect class="spt-plinth" x="0" y="196" width="300" height="10"></rect>
			<path class="spt-roof" d={`M0 0 H306 L306 ${GUT - 2} H0 Z`}></path>
			<path class="spt-roof-line" d={Array.from({ length: 21 }, (_, i) => `M${i * 15 + 4} 0 V${GUT - 3}`).join(' ')}></path>
			<path class="spt-roof-snow" d={`M0 ${GUT - 9} Q40 ${GUT - 13} 80 ${GUT - 9} Q130 ${GUT - 12} 170 ${GUT - 8} Q230 ${GUT - 12} 306 ${GUT - 9} L306 ${GUT - 3} H0 Z`}></path>
			<rect class="spt-gutter" x="0" y={GUT - 3} width="306" height="3.4" rx="1"></rect>
			<path class="spt-ice" d={icePath}></path>
			<path class="spt-pipe" d={`M300 ${GUT} V200 Q300 204 304 204 H310`}></path>
			{windows.map((w) => (
				<g>
					<rect class="spt-winframe" x={w.x - 2} y={w.y - 2} width={w.w + 4} height={w.h + 4} rx="1"></rect>
					<rect class="spt-glass" x={w.x} y={w.y} width={w.w} height={w.h}></rect>
					<path class="spt-winbar" d={`M${w.x + w.w / 2} ${w.y} V${w.y + w.h} M${w.x} ${w.y + w.h * 0.35} H${w.x + w.w}`}></path>
					<rect class="spt-sill" x={w.x - 4} y={w.y + w.h + 2} width={w.w + 8} height="2.4"></rect>
				</g>
			))}
			<path class="spt-curtain" d={`M106 ${windows[1].y} q6 10 0 ${windows[1].h} h4 q-3 -14 0 ${-windows[1].h} Z M190 ${windows[4].y} q6 10 0 ${windows[4].h} h4 q-3 -14 0 ${-windows[4].h} Z`}></path>
			<path class="spt-pot" d={`M30 ${windows[2].y + windows[2].h - 7} h7 l-1 7 h-5 Z`}></path>
			<path class="spt-leaf" d={`M33.5 ${windows[2].y + windows[2].h - 7} q-4 -5 -1 -9 q2 4 1 9 q2 -6 5 -7 q0 5 -5 7 Z`}></path>
			<!-- the door -->
			<rect class="spt-door" x="166" y={yM(2.2)} width="30" height={206 - yM(2.2)}></rect>
			<rect class="spt-door-win" x="172" y={yM(2.0)} width="18" height="14" rx="1"></rect>
			<circle class="spt-knob" cx="190" cy={yM(1.0)} r="1.4"></circle>
			<path class="spt-canopy" d={`M160 ${yM(2.35)} H202 L198 ${yM(2.2)} H164 Z`}></path>
			<!-- a bird on the gutter -->
			<g transform={`translate(122 ${GUT - 4})`}>
				<path class="spt-bird" d="M-5 0 Q-4 -5 1 -5 Q4 -7 6 -4 L8 -3.4 L6 -2.8 Q5 1 0 1 L-4 1 L-8 -1 Z"></path>
				<circle class="spt-bird-eye" cx="4.4" cy="-4.4" r="0.6"></circle>
				<path class="spt-bird-leg" d="M-0.5 1 V3 M1.5 1 V3"></path>
			</g>
			<!-- the sidewalk, melting snow banks, the puddle -->
			<rect class="spt-walk" x="0" y="206" width="360" height="34"></rect>
			<path class="spt-curb" d="M0 236 H360"></path>
			<path class="spt-snowbank" d="M0 206 Q14 196 34 200 Q52 194 70 206 Z M262 206 Q276 198 292 201 Q306 196 318 206 Z"></path>
			<path class="spt-wet" d="M0 206 Q35 210 70 206 M262 206 Q290 210 318 206"></path>
			<ellipse class="spt-puddle" cx={ICX} cy={PY} rx="26" ry="4.2"></ellipse>
			<g data-rings></g>
			<g data-drops></g>
			<circle class="spt-drop" data-forming cx={ICX} cy={TIP} r="0"></circle>
			<g data-mother></g>
			<g data-son></g>
		</svg>
		<div class="intro__foot">
			<p>
				С&nbsp;сосульки капли срываются через равные промежутки времени, но{' '}
				<More term={'в полёте расстояния между ними становятся всё больше'}>
					Каждая капля падает всё быстрее: за каждую секунду её скорость растёт на 9,8&nbsp;м/с. Капля, сорвавшаяся раньше, летит быстрее следующей и уходит от неё вперёд. Так падают тела, когда воздух им почти не мешает, — это{' '}
					<a href="#ускорение-свободного-падения">свободное падение</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="ball">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Летний двор. Мальчик подбрасывает волейбольный мяч двумя руками прямо вверх и ловит его. Бледные мячи показывают, где он был через каждую десятую долю секунды: у верхней точки они почти сливаются. Девочка на скамейке следит за мячом">
			<rect class="spt-sky2" x="0" y="0" width="360" height="240"></rect>
			<path class="spt-cloud" d="M196 36 q6 -9 15 -4 q8 -7 15 2 q7 0 6 7 h-38 q-4 -5 2 -5 Z M286 64 q5 -7 12 -3 q6 -6 12 2 q6 0 5 6 h-31 q-3 -5 2 -5 Z"></path>
			<!-- a block of flats far away, trees, the fence of the yard -->
			<rect class="spt-flats" x="210" y="88" width="150" height="100"></rect>
			<path class="spt-flats-win" d={Array.from({ length: 5 }, (_, r) => Array.from({ length: 10 }, (_, c) => `M${216 + c * 14.5} ${96 + r * 18} h7 v9 h-7 Z`).join(' ')).join(' ')}></path>
			<path class="spt-crown2" d="M-6 150 Q-8 108 26 104 Q40 78 70 92 Q98 84 104 116 Q122 136 100 156 Q60 168 20 160 Q-4 166 -6 150 Z"></path>
			<path class="spt-trunk2" d="M46 192 L48 150 L44 132 L50 132 L54 146 L60 128 L66 130 L56 152 L56 192 Z"></path>
			<!-- the basketball hoop far away -->
			<path class="spt-hoop-pole" d="M186 192 V122 H196"></path>
			<rect class="spt-board" x="194" y="112" width="4" height="20"></rect>
			<path class="spt-hoop" d="M198 128 H206"></path>
			<path class="spt-net" d="M198.5 128.5 L200 134 L204 134 L205.5 128.5 M200 131 H204"></path>
			<path class="spt-fence2" d={boards}></path>
			<path class="spt-fence2-bar" d={`M0 ${GY - 0.75 * K2} H360 M0 ${GY - 0.25 * K2} H360`}></path>
			<rect class="spt-ground" x="0" y={GY - 6} width="360" height={240 - GY + 6}></rect>
			<path class="spt-grass2" d={Array.from({ length: 24 }, (_, i) => `M${i * 15 + 4 + (i % 3)} ${GY - 5} l2 -5 l2 5`).join(' ')}></path>
			<!-- the bench -->
			<path class="spt-bench-leg" d={`M262 ${GY - 4} V${GY - 0.45 * K2} M314 ${GY - 4} V${GY - 0.45 * K2} M314 ${GY - 0.45 * K2} V${GY - 0.92 * K2}`}></path>
			<rect class="spt-bench" x="254" y={GY - 0.45 * K2 - 3} width="66" height="4" rx="1"></rect>
			<rect class="spt-bench" x="310" y={GY - 0.9 * K2} width="6" height={0.38 * K2} rx="1"></rect>
			<g data-marks></g>
			<g data-girl></g>
			<g data-ball>
				<circle class="spt-ball" r="6.3"></circle>
				<path class="spt-ball-seam" d="M-6 -1.6 Q0 -4.6 6 -1.6 M-3.6 5 Q-1 0 -2.6 -5.6 M2.4 5.6 Q4.6 1 3.4 -5.2"></path>
			</g>
			<g data-boy></g>
		</svg>
		<div class="intro__foot">
			<p>
				Подброшенный мяч поднимается всё медленнее,{' '}
				<More term={'на миг замирает наверху'}>
					В верхней точке скорость мяча равна нулю, но вниз он начинает разгоняться сразу: и вверх, и вниз мяч движется с одним и тем же ускорением 9,8&nbsp;м/с², направленным вниз. Поэтому подъём и спуск длятся одинаково — по 0,6&nbsp;с. Подробнее — раздел{' '}
					<a href="#движение-тела-брошенного-вертикально-вверх">«Движение тела, брошенного вертикально вверх»</a>.
				</More>, а&nbsp;вниз летит всё быстрее.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
