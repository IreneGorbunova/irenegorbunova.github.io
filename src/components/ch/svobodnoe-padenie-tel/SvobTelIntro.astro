	[data-sptintro] .spt-hoop-pole {
		fill: none;
		stroke: var(--spt-steel);
		stroke-width: 2;
	}
	[data-sptintro] .spt-board {
		fill: hsl(0, 0%, 92%);
	}
	[data-sptintro] .spt-hoop {
		stroke: hsl(14, 80%, 52%);
		stroke-width: 1.4;
	}
	[data-sptintro] .spt-net {
		fill: none;
		stroke: hsl(0, 0%, 90%);
		stroke-width: 0.6;
	}
	[data-sptintro] .spt-fence2 {
		stroke: var(--spt-fence2);
		stroke-width: 9;
	}
	[data-sptintro] .spt-fence2-bar {
		stroke: color-mix(in oklab, var(--spt-fence2) 75%, black);
		stroke-width: 2.4;
	}
	[data-sptintro] .spt-ground {
		fill: var(--spt-ground);
	}
	[data-sptintro] .spt-grass2 {
		fill: none;
		stroke: var(--spt-grass2);
		stroke-width: 1;
	}
	[data-sptintro] .spt-bench {
		fill: var(--spt-bench);
	}
	[data-sptintro] .spt-bench-leg {
		fill: none;
		stroke: var(--spt-steel);
		stroke-width: 2.4;
	}
	[data-sptintro] .spt-ball {
		fill: var(--spt-ball);
		stroke: color-mix(in oklab, var(--spt-ball) 55%, black);
		stroke-width: 0.8;
	}
	[data-sptintro] .spt-ball-seam {
		fill: none;
		stroke: var(--spt-ball-seam);
		stroke-width: 1.3;
	}
	[data-sptintro] .spt-mark {
		opacity: 0.35;
	}
</style>

<script>
	import { loop, scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { figure } from '@components/people/body';
	import { ease, walk } from '@components/people/motion';
	import { ANKLE_CM } from '@components/people/body';
	import type { Pt } from '@components/people/core';

	const f1 = (v: number) => v.toFixed(1);
	const g = 9.8;
	const clampH = (a: number) => Math.max(-0.66, Math.min(0.4, a)); // the head turns by at most about 38°

	for (const root of document.querySelectorAll<HTMLElement>('[data-sptintro]')) {
		// ---------------------------------------------------------------- the icicles
		{
			const card = root.querySelector<HTMLElement>('[data-scene="drops"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 30;
			const S = K / 100;
			const PY = 212;
			const ICX = 232;
			const TIP = PY - 6 * K;
			const DT = 0.25; // a drop every 0,25 с
			const TF = Math.sqrt((2 * 6.0) / g); // 1,11 с of fall
			const NMAX = Math.ceil(TF / DT) + 1;
			const dropG = $<SVGGElement>('[data-drops]');
			const drops = Array.from({ length: NMAX }, () => {
				const e = el('ellipse', { class: 'spt-drop spt-drop--fly', cx: ICX, rx: 1.3, ry: 2.5 });
				dropG.append(e);
				return e;
			});
			const ringG = $<SVGGElement>('[data-rings]');
			const RINGS = 5;
			const rings = Array.from({ length: RINGS }, () => {
				const e = el('ellipse', { class: 'spt-ring', cx: ICX, cy: PY });
				ringG.append(e);
				return e;
			});
			const forming = $<SVGCircleElement>('[data-forming]');
			// the drops run on their own clock, all the time
			let td = 0;
			const drawDrops = () => {
				const n = Math.floor(td / DT); // the last drop that has left
				const since = td - n * DT;
				drops.forEach((e, i) => {
					const age = since + i * DT; // the i-th latest drop
					const y = TIP + 1.5 + 0.5 * g * age * age * K;
					const on = age <= TF;
					e.setAttribute('visibility', on ? 'visible' : 'hidden');
					if (on) e.setAttribute('cy', f1(y));
				});
				// the next drop swells at the tip
				forming.setAttribute('r', f1(0.4 + 1.0 * (since / DT)));
				forming.setAttribute('cy', f1(TIP + 0.6 + 0.6 * (since / DT)));
				// rings of the drops that landed in the last 1,2 с
				rings.forEach((e, i) => {
					const ageR = since + i * DT - TF; // time since this drop landed
					const on = ageR >= 0 && ageR < 1.2;
					e.setAttribute('visibility', on ? 'visible' : 'hidden');
					if (on) {
						const r = 1.5 + ageR * 20;
						e.setAttribute('rx', f1(Math.min(r, 25)));
						e.setAttribute('ry', f1(Math.min(r, 25) * 0.16));
						e.setAttribute('opacity', f1(1 - ageR / 1.2));
					}
				});
			};
			drawDrops();
			loop(card, (dt) => {
				td += dt;
				drawDrops();
				return true;
			})();

			// the people walk to the right, hand in hand, in front of the drip line
			const FOOT = 230; // the soles, a little nearer than the puddle
			const V = 1.2 * K; // px per second
			const X_MOM = -40; // the mother enters from beyond the left edge and leaves beyond the right one
			const RUN = (400 - X_MOM) / V; // 12,2 с
			const mom = figure($<SVGGElement>('[data-mother]'), { s: S, H: 165, clothes: 'winter', shirt: 'hm-red', name: 'mother' });
			const son = figure($<SVGGElement>('[data-son]'), { s: S, H: 122, age: 'child', clothes: 'winter', shirt: 'hm-blue', name: 'son' });
			const ank = ANKLE_CM.boot * S;
			const person = (H: number, hipK: number, legK: number, stepM: number, x0: number) => {
				const u = H * S;
				const step = stepM * K;
				const leg = legK * u * 0.995;
				const hipY = FOOT - ank - Math.sqrt(leg * leg - (0.5 * step) ** 2) + 0.4;
				return (d: number) => {
					const w = walk(d, step, x0 + 0.5 * step, 0.05 * u);
					// feet: the walk cycle; the body: halfway between the feet's travel
					const hip = { x: x0 + d, y: hipY + w.bob };
					return { w, hip, u, step };
				};
			};
			const momAt = person(165, 0.52, 0.475, 0.62, X_MOM);
			const sonAt = person(122, 0.48, 0.435, 0.46, X_MOM + 10);
			// Outside the frame (before they enter and after they leave) the walkers are hidden and stand still in the air
			// under their hips (feet 2 px up, not planted), so the jump back to the start when the loop restarts, which
			// happens out of sight, is not read by the people checker as a sliding foot.
			const inFrame = (x: number) => x > -25 && x < 385;
			const momG = $<SVGGElement>('[data-mother]');
			const sonG = $<SVGGElement>('[data-son]');
			// the swing foot leaves the ground and comes down quickly (the square root of the kit's sine lift), so that it
			// is never dragged along the ground at the start or the end of a swing
			const up = (f: { swing: number; planted: boolean }, u: number) => (f.planted ? 0 : 0.05 * u * Math.sqrt(Math.sin(Math.PI * f.swing)));
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const d = V * t;
				// mother
				const m = momAt(d);
				const sn = sonAt(d);
				// the joined hands: between them, 0,68 м above the ground
				const hold: Pt = { x: (m.hip.x + sn.hip.x) / 2 + 1.5, y: FOOT - 0.68 * K };
				const mf = m.w.feet;
				momG.setAttribute('visibility', inFrame(m.hip.x) ? 'visible' : 'hidden');
				sonG.setAttribute('visibility', inFrame(sn.hip.x) ? 'visible' : 'hidden');
				mom.pose({
					hip: m.hip,
					lean: 0.05,
					head: 0.12,
					ankles: [
						inFrame(m.hip.x) ? { x: mf[0].x, y: FOOT - ank - up(mf[0], m.u) } : { x: m.hip.x + 2, y: FOOT - ank - 2 },
						inFrame(m.hip.x) ? { x: mf[1].x, y: FOOT - ank - up(mf[1], m.u) } : { x: m.hip.x - 2, y: FOOT - ank - 2 },
					],
					feet: [mf[0].toe, mf[1].toe],
					planted: [mf[0].planted && inFrame(m.hip.x), mf[1].planted && inFrame(m.hip.x)],
					hands: [
						{ at: hold, pose: 'grip', d: 4, contact: 'son-hand' },
						{ at: { x: m.hip.x - 0.1 * m.u * m.w.arm, y: m.hip.y + 0.09 * m.u }, pose: 'relaxed' },
					],
				});
				// the son looks up at the icicles as he comes near them
				const sf = sn.w.feet;
				const headC = { x: sn.hip.x + 2, y: sn.hip.y - 0.437 * sn.u };
				const look = Math.atan2(TIP + 20 - headC.y, Math.max(8, ICX - headC.x));
				const near = Math.max(0, Math.min(1, 1 - Math.abs(ICX - 30 - headC.x) / 110));
				son.pose({
					hip: sn.hip,
					lean: 0.04,
					head: clampH(0.1 + (look - 0.1) * ease(near)),
					ankles: [
						inFrame(sn.hip.x) ? { x: sf[0].x, y: FOOT - ank - up(sf[0], sn.u) } : { x: sn.hip.x + 2, y: FOOT - ank - 2 },
						inFrame(sn.hip.x) ? { x: sf[1].x, y: FOOT - ank - up(sf[1], sn.u) } : { x: sn.hip.x - 2, y: FOOT - ank - 2 },
					],
					feet: [sf[0].toe, sf[1].toe],
					planted: [sf[0].planted && inFrame(sn.hip.x), sf[1].planted && inFrame(sn.hip.x)],
					hands: [
						{ at: { x: sn.hip.x + 0.1 * sn.u * sn.w.arm, y: sn.hip.y + 0.05 * sn.u }, pose: 'relaxed' },
						{ at: hold, pose: 'grip', d: 4, contact: 'mother-hand' },
					],
				});
			});
		}

		// ---------------------------------------------------------------- the ball
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ball"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const GY = 232;
			const K = 60;
			const S = K / 100;
			const R = 0.105 * K; // the ball's radius, px
			const yPx = (m: number) => GY - m * K;
			const BX = 112; // the boy's hips
			const AX = BX + 0.24 * K; // the line of the throw, 24 см in front of him
			const V0 = 6.0;
			const C_HOLD = 1.25; // ball center at the chest, м
			const C_DIP = 1.15;
			const C_REL = 1.7; // the hands let it go 1,6 м above the ground (their contact below the center)
			const A_PUSH = (V0 * V0) / (2 * (C_REL - C_DIP)); // 32,7 м/с²
			const T_DIP = 0.5;
			const T_PUSH = 0.8;
			const T_REL = T_PUSH + V0 / A_PUSH;
			const T_FLY = (2 * V0) / g;
			const T_CATCH = T_REL + T_FLY;
			const GIVE = 0.4;
			const A_CATCH = (V0 * V0) / (2 * GIVE);
			const T_STOP = T_CATCH + V0 / A_CATCH;
			const RUN = T_STOP + 0.9;
			const TS = (2 * 0.1) / V0; // after the release the hands stop within 10 см
			// the hands' height (ball center they hold, м)
			const hands = (t: number) => {
				if (t < T_DIP) return C_HOLD;
				if (t < T_PUSH) return C_HOLD + (C_DIP - C_HOLD) * ease((t - T_DIP) / (T_PUSH - T_DIP));
				if (t < T_REL) return C_DIP + 0.5 * A_PUSH * (t - T_PUSH) ** 2;
				if (t < T_REL + TS) {
					const s = t - T_REL;
					return C_REL + V0 * s - (0.5 * V0 * s * s) / TS;
				}
				if (t < T_REL + TS + 0.5) return C_REL + 0.1 - 0.1 * ease((t - T_REL - TS) / 0.5);
				if (t < T_CATCH) return C_REL;
				if (t < T_STOP) {
					const s = t - T_CATCH;
					return C_REL - V0 * s + 0.5 * A_CATCH * s * s;
				}
				return C_REL - GIVE + (C_HOLD - C_REL + GIVE) * ease((t - T_STOP) / 0.5);
			};
			const ballC = (t: number) => {
				if (t < T_REL || t >= T_CATCH) return hands(t);
				const s = t - T_REL;
				return C_REL + V0 * s - 0.5 * g * s * s;
			};
			const ball = $<SVGGElement>('[data-ball]');
			const marks = $<SVGGElement>('[data-marks]');
			const markEls = [1, 2, 3, 4, 5, 6].map((k) => {
				const c = ball.cloneNode(true) as SVGGElement;
				c.removeAttribute('data-ball');
				c.classList.add('spt-mark');
				const s = 0.1 * k;
				c.setAttribute('transform', `translate(${f1(AX)} ${f1(yPx(C_REL + V0 * s - 0.5 * g * s * s))})`);
				marks.append(c);
				return c;
			});
			const H = 168;
			const u = H * S;
			const boyG = $<SVGGElement>('[data-boy]');
			const boy = figure(boyG, { s: S, H, age: 'teen', clothes: 'indoor', shirt: 'hm-blue', hair: 'short', shorts: true, name: 'boy' });
			// the ball goes between his far arm (behind it) and his body and near arm (in front of it)
			const bodyRoot = boyG.firstElementChild!;
			bodyRoot.insertBefore(ball, bodyRoot.children[1]);
			const ankY = GY - 0.045 * u;
			const HG = 158;
			const ug = HG * S;
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H: HG, age: 'teen', clothes: 'indoor', shirt: 'hm-red', hair: 'pony', dir: -1, name: 'girl' });
			const SEAT = GY - 0.45 * K - 3; // the top of the bench seat
			const GX = 296; // her hips
			const girlHip: Pt = { x: GX, y: SEAT - 0.05 * ug };
			const girlHead: Pt = { x: GX - 3, y: girlHip.y - 0.424 * ug };
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const held = t < T_REL || t >= T_CATCH;
				const hc = hands(t);
				const bc = ballC(t);
				const by = yPx(bc);
				ball.setAttribute('transform', `translate(${f1(AX)} ${f1(by)})`);
				markEls.forEach((c, i) => c.setAttribute('visibility', t >= T_REL + 0.1 * (i + 1) ? 'visible' : 'hidden'));
				// knees bend a little in the dip and straighten in the push
				const dip = t < T_DIP ? 0 : t < T_PUSH ? ease((t - T_DIP) / (T_PUSH - T_DIP)) : t < T_REL ? 1 - ease((t - T_PUSH) / (T_REL - T_PUSH)) : 0;
				const hip: Pt = { x: BX, y: GY - 0.505 * u + 1 + 0.05 * K * dip };
				const hy = yPx(hc);
				// in profile the near hand covers the lower front of the ball (its back to the viewer), the far hand is
				// behind the ball (its palm toward the viewer); both have the fingers up along the ball's sides
				const near: Pt = { x: AX + 0.15 * R, y: hy + 0.42 * R };
				const far: Pt = { x: AX - 0.2 * R, y: hy + 0.42 * R };
				const headC = { x: BX + 2, y: hip.y - 0.424 * u };
				boy.pose({
					hip,
					lean: -0.02 - 0.04 * Math.max(0, Math.min(1, (headC.y - by) / 60)),
					head: clampH(Math.atan2(by - headC.y, Math.max(6, AX - headC.x))),
					ankles: [
						{ x: BX + 5, y: ankY },
						{ x: BX - 5, y: ankY },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: near, pose: 'open', dir: -Math.PI / 2 + 0.25, roll: -Math.PI / 2, contact: held ? 'ball' : undefined },
						{ at: far, pose: 'open', dir: -Math.PI / 2 + 0.15, roll: Math.PI / 2, contact: held ? 'ball' : undefined },
					],
				});
				// the girl on the bench follows the ball with her head
				const gl = Math.atan2(by - girlHead.y, girlHead.x - AX);
				girl.pose({
					hip: girlHip,
					lean: -0.04,
					head: clampH(gl),
					ankles: [
						{ x: GX - 0.27 * ug, y: GY - 0.045 * ug },
						{ x: GX - 0.24 * ug, y: GY - 0.045 * ug },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: GX - 0.15 * ug, y: girlHip.y - 0.03 * ug }, pose: 'relaxed', contact: 'knee' },
						{ at: { x: GX - 0.12 * ug, y: girlHip.y - 0.03 * ug }, pose: 'relaxed' },
					],
				});
			});
		}
	}
</script>
