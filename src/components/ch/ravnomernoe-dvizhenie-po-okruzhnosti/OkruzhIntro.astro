<script>
	import { scene } from '@components/intro/scene';
	import { figure, type FigurePose } from '@components/people/body';
	import { ROLL } from '@components/people/hand';
	import { DEG } from '@components/people/core';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = (parent: Element, tag: string, attrs: Record<string, string | number> = {}) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent.append(e);
		return e as SVGElement;
	};
	const f1 = (v: number) => v.toFixed(1);
	const smooth = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const rnd = (i: number, k: number) => {
		const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
		return r - Math.floor(r);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-okruzhintro]')) {
		// ---------- Umbrella ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="umbrella"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const SLOW = 3;
			const RUN = 7.5; // screen seconds
			const K = 64; // px per metre across
			const TH = 28 * DEG;
			const KY = K * Math.cos(TH); // px per metre up
			const KZ = K * Math.sin(TH); // px per metre toward the viewer (down on the screen)
			const G0 = 160; // the boy's soles (Y = 0, Z = 0)
			const XB = 172; // the boy's hip joint, px
			const g = 9.8;
			const R = 0.5; // canopy radius, m
			const YR = 1.8; // rim height, m
			const HT = 0.28; // top above the rim, m
			const NU = 1.5; // turns per second at full speed
			const W0 = 2 * Math.PI * NU;
			const X0S = XB + 0.22 * K; // the shaft (X = 0) stands 0,22 м in front of the boy's hip joint
			const SX = (X: number) => X0S + X * K;
			const SY = (Y: number, Z: number) => G0 - Y * KY + Z * KZ;
			// the boy: teen, 152 см, s matches the vertical scale
			const S = KY / 100;
			const boy = figure($<SVGGElement>('[data-boy]'), { s: S, H: 152, age: 'teen', shirt: 'ou-coat', hair: 'short', name: 'boy with umbrella' });
			boy.backLayer(0, $<SVGGElement>('[data-hback]'));
			// the handle: the grip 1,28 м above the ground, the shaft straight above it
			const GRIP = { x: X0S, y: SY(1.28, 0) };
			const shaftX = GRIP.x;
			const ankleY = G0 - 7 * S;
			const boyPose: FigurePose = {
				hip: { x: XB, y: G0 - 0.505 * 152 * S },
				lean: 0.02,
				head: -0.12,
				ankles: [
					{ x: XB + 4, y: ankleY },
					{ x: XB - 3, y: ankleY - 1.5 },
				],
				feet: [0, 0],
				hands: [
					{ at: GRIP, pose: 'grip', d: 2.6, dir: 0, roll: ROLL.backViewer, contact: 'umbrella handle' },
					{ arm: [Math.PI / 2 + 0.1, 0.25], pose: 'relaxed' },
				],
				planted: [true, true],
			};
			boy.pose(boyPose);
			// the shaft runs straight up from the hand through the center of the canopy
			const top = SY(YR + HT, 0);
			$('[data-shaft]').setAttribute('d', `M${f1(shaftX)} ${f1(GRIP.y + 3)} V${f1(top)}`);
			// the crook of the handle below the hand
			$('[data-crook]').setAttribute('d', `M${f1(shaftX)} ${f1(GRIP.y - 3)} V${f1(GRIP.y + 6)} q0 4.5 -3.6 4.5 q-3.2 0 -3.2 -3`);
			// spin angle psi(τ) for the real time τ, integrated once
			const DT = 0.002;
			const TMAX = RUN / SLOW;
			const omega = (tau: number) => W0 * smooth((tau - 0.15) / 0.3) * (1 - smooth((tau - 1.55) / 0.35));
			const psiTab: number[] = [0];
			for (let i = 1; i * DT <= TMAX + DT; i++) psiTab.push(psiTab[i - 1] + omega((i - 0.5) * DT) * DT);
			const psi = (tau: number) => {
				const i = Math.min(psiTab.length - 1, Math.max(0, Math.floor(tau / DT)));
				return psiTab[i];
			};
			// rim point of angle φ: counterclockwise seen from above (from +X toward −Z, away from the viewer)
			const rimP = (phi: number) => ({ X: R * Math.cos(phi), Z: -R * Math.sin(phi) });
			const NR = 8;
			// drops: four per rib per second while the rim is faster than 2,5 м/с, slightly irregular
			type Drop = { te: number; phi: number; vx: number; vz: number; X: number; Z: number; tl: number };
			const drops: Drop[] = [];
			for (let i = 0; i < NR; i++) {
				for (let k = 0; k < 12; k++) {
					const te = 0.2 + k * 0.25 + (i / NR) * 0.25 + (rnd(i * 13 + k, 5) - 0.5) * 0.12;
					if (te > TMAX) continue;
					const w = omega(te);
					if (w * R < 2.5) continue;
					const phi = psi(te) + (i * 2 * Math.PI) / NR;
					const p = rimP(phi);
					// velocity along the tangent: d(rimP)/dφ · ω
					const vx = -R * Math.sin(phi) * w;
					const vz = -R * Math.cos(phi) * w;
					drops.push({ te, phi, vx, vz, X: p.X, Z: p.Z, tl: Math.sqrt((2 * YR) / g) });
				}
			}
			const back = $('[data-drops-back]');
			const front = $('[data-drops-front]');
			const splashG = $('[data-splash]');
			const wetG = $('[data-wet]');
			const dEls = drops.map((d) => {
				const layer = d.Z + d.vz * 0.1 < 0 ? back : front;
				const trail = mk(layer, 'path', { class: 'ou-trail' });
				const dot = mk(layer, 'circle', { class: 'ou-drop', r: 1.3 });
				const X1 = d.X + d.vx * d.tl;
				const Z1 = d.Z + d.vz * d.tl;
				const ring = mk(splashG, 'ellipse', { class: 'ou-ring', cx: f1(SX(X1)), cy: f1(SY(0, Z1)) });
				const wet = mk(wetG, 'ellipse', { class: 'ou-wetdot', cx: f1(SX(X1)), cy: f1(SY(0, Z1)), rx: 1.6, ry: 0.8 });
				return { trail, dot, ring, wet };
			});
			// the inset: top view, 32 px per metre, the shaft at (50; 40), Z toward the viewer = down
			const inset = $('[data-inset]');
			const IK = 32;
			const IC = { x: 50, y: 40 };
			const iTop = (X: number, Z: number) => ({ x: IC.x + X * IK, y: IC.y + Z * IK });
			const iCan = mk(inset, 'g');
			const iEls = drops.map(() => ({ trail: mk(inset, 'path', { class: 'ou-trail' }), dot: mk(inset, 'circle', { class: 'ou-drop', r: 1.2 }) }));
			const canopy = $('[data-canopy]');
			const scr = (X: number, Y: number, Z: number) => ({ x: SX(X), y: SY(Y, Z) });
			const apex = scr(0, YR + HT, 0);
			const draw = (q: number) => {
				const tau = q * TMAX;
				const ps = psi(tau);
				boy.pose(boyPose); // the same pose every frame (the hand twirls the handle with the fingers only)
				// canopy: eight panels from the top to the rim, the far ones first
				canopy.replaceChildren();
				const order = Array.from({ length: NR }, (_, i) => i).sort((a, b) => {
					const za = rimP(ps + ((a + 0.5) * 2 * Math.PI) / NR).Z;
					const zb = rimP(ps + ((b + 0.5) * 2 * Math.PI) / NR).Z;
					return za - zb;
				});
				for (const i of order) {
					const a0 = ps + (i * 2 * Math.PI) / NR;
					const a1 = a0 + (2 * Math.PI) / NR;
					let d = `M${f1(apex.x)} ${f1(apex.y)}`;
					for (let j = 0; j <= 6; j++) {
						const a = a0 + ((a1 - a0) * j) / 6;
						// the panel's rim sags a little between the ribs (scallop)
						const sag = 0.035 * Math.sin((Math.PI * j) / 6);
						const p = rimP(a);
						const s = scr(p.X * (1 - sag), YR + sag * 0.6, p.Z * (1 - sag));
						d += ` L${f1(s.x)} ${f1(s.y)}`;
					}
					mk(canopy, 'path', { class: i % 2 ? 'ou-pan-a' : 'ou-pan-b', d: `${d} Z` });
				}
				for (let i = 0; i < NR; i++) {
					const p = rimP(ps + (i * 2 * Math.PI) / NR);
					const s = scr(p.X, YR, p.Z);
					mk(canopy, 'circle', { class: 'ou-tipdot', cx: f1(s.x), cy: f1(s.y), r: 0.9 });
				}
				mk(canopy, 'circle', { class: 'ou-tipdot', cx: f1(apex.x), cy: f1(apex.y - 1.5), r: 1.1 });
				// the inset: eight panels and the drops from above
				iCan.replaceChildren();
				for (let i = 0; i < NR; i++) {
					const a0 = ps + (i * 2 * Math.PI) / NR;
					const a1 = a0 + (2 * Math.PI) / NR;
					const p0 = rimP(a0);
					const p1 = rimP(a1);
					const q0 = iTop(p0.X, p0.Z);
					const q1 = iTop(p1.X, p1.Z);
					mk(iCan, 'path', { class: i % 2 ? 'ou-pan-a' : 'ou-pan-b', d: `M${IC.x} ${IC.y} L${f1(q0.x)} ${f1(q0.y)} A${R * IK} ${R * IK} 0 0 0 ${f1(q1.x)} ${f1(q1.y)} Z` });
				}
				drops.forEach((d, i) => {
					const e = iEls[i];
					const t = tau - d.te;
					if (t < 0 || t > d.tl) {
						e.dot.setAttribute('opacity', '0');
						e.trail.setAttribute('d', '');
						return;
					}
					const p = iTop(d.X + d.vx * t, d.Z + d.vz * t);
					const t0 = Math.max(0, t - 0.22);
					const p0 = iTop(d.X + d.vx * t0, d.Z + d.vz * t0);
					e.dot.setAttribute('opacity', '1');
					e.dot.setAttribute('cx', f1(p.x));
					e.dot.setAttribute('cy', f1(p.y));
					e.trail.setAttribute('d', `M${f1(p0.x)} ${f1(p0.y)} L${f1(p.x)} ${f1(p.y)}`);
				});
				// drops
				drops.forEach((d, i) => {
					const e = dEls[i];
					const t = tau - d.te;
					if (t < 0 || t > d.tl) {
						e.dot.setAttribute('opacity', '0');
						e.trail.setAttribute('d', '');
					} else {
						const at = (u: number) => scr(d.X + d.vx * u, YR - (g * u * u) / 2, d.Z + d.vz * u);
						const p = at(t);
						e.dot.setAttribute('opacity', '1');
						e.dot.setAttribute('cx', f1(p.x));
						e.dot.setAttribute('cy', f1(p.y));
						let path = '';
						const t0 = Math.max(0, t - 0.22);
						for (let j = 0; j <= 6; j++) {
							const s = at(t0 + ((t - t0) * j) / 6);
							path += `${j ? 'L' : 'M'}${f1(s.x)} ${f1(s.y)}`;
						}
						e.trail.setAttribute('d', path);
					}
					// splash: a ring that grows and fades within 0,25 s, then a wet dot stays
					const ts = t - d.tl;
					if (ts >= 0 && ts < 0.25) {
						const r = 1 + 9 * (ts / 0.25);
						e.ring.setAttribute('rx', f1(r));
						e.ring.setAttribute('ry', f1(r * Math.sin(TH)));
						e.ring.setAttribute('opacity', f1(1 - ts / 0.25));
					} else e.ring.setAttribute('opacity', '0');
					e.wet.setAttribute('opacity', ts >= 0 ? '0.8' : '0');
				});
			};
			scene(card, RUN, draw);
		}

		// ---------- Chain swing ride ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="swings"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 20.5; // px per metre across
			const EL = 14 * DEG; // the view from above
			const KY = K * Math.cos(EL);
			const KZ = K * Math.sin(EL);
			const CX = 180;
			const GY = 205; // the ground at the axis
			const g = 9.8;
			const A = 4.5; // radius of the ring the chains hang from, m
			const LC = 5.0; // chain, m
			const YT = 5.9; // height of the ring, m
			const N = 12; // seats
			const TFULL = 6.0; // s per turn at full speed
			const W1 = (2 * Math.PI) / TFULL;
			const T_UP = [1, 10]; // spin-up
			const T_DN = [17, 26]; // slow-down
			const RUN = 27;
			const scr = (X: number, Y: number, Z: number) => ({ x: CX + X * K, y: GY - Y * KY + Z * KZ });
			const omega = (t: number) => W1 * smooth((t - T_UP[0]) / (T_UP[1] - T_UP[0])) * (1 - smooth((t - T_DN[0]) / (T_DN[1] - T_DN[0])));
			const DT = 0.01;
			const psiTab: number[] = [0];
			for (let i = 1; i * DT <= RUN + DT; i++) psiTab.push(psiTab[i - 1] + omega((i - 0.5) * DT) * DT);
			const psi = (t: number) => psiTab[Math.min(psiTab.length - 1, Math.max(0, Math.round(t / DT)))];
			/** The chain's angle from the vertical for the angular speed w (quasi-static): tg α = w²(A + LC sin α)/g. */
			const alphaOf = (w: number) => {
				let a = 0;
				for (let k = 0; k < 40; k++) a = Math.atan((w * w * (A + LC * Math.sin(a))) / g);
				return a;
			};
			// the riders: seat index, age, height, shirt
			const riders: Record<number, { age: 'teen' | 'child'; H: number; cls: string; hair: 'short' | 'pony'; shorts: boolean }> = {
				0: { age: 'teen', H: 158, cls: 'oc-t1', hair: 'pony', shorts: false },
				2: { age: 'child', H: 128, cls: 'oc-t2', hair: 'short', shorts: true },
				5: { age: 'teen', H: 162, cls: 'oc-t3', hair: 'short', shorts: false },
				7: { age: 'child', H: 132, cls: 'oc-t4', hair: 'pony', shorts: true },
				9: { age: 'teen', H: 155, cls: 'oc-t5', hair: 'short', shorts: true },
			};
			const S = 0.21; // px per см for the riders (≈ K/100)
			const far = $('[data-far]');
			const near = $('[data-near]');
			type Seat = { wrap: SVGGElement; chain: SVGElement; fig: ReturnType<typeof figure> | null; H: number; age: 'teen' | 'child' | null };
			const seats: Seat[] = Array.from({ length: N }, (_, i) => {
				const wrap = document.createElementNS(NS, 'g') as SVGGElement;
				const chain = document.createElementNS(NS, 'path') as SVGElement;
				chain.setAttribute('class', 'oc-chain');
				const inner = mk(wrap, 'g');
				// the seat: a small bucket seat with a back, under the rider's hips (local: the chain meets it at 0, 0)
				const r = riders[i];
				const fg = mk(inner, 'g') as SVGGElement;
				mk(inner, 'path', { class: 'oc-seat', d: 'M-6.5 0 H1.5 Q2.5 0 2.2 1.6 H-6 Z M-6.5 0 L-7.5 -6 L-6 -6 L-5 0 Z' });
				let fig = null;
				if (r) fig = figure(fg, { s: S, H: r.H, age: r.age, shirt: r.cls, hair: r.hair, shorts: r.shorts, name: `rider ${i}` });
				return { wrap, chain, fig, H: r?.H ?? 0, age: r?.age ?? null };
			});
			/** A rider sitting on the seat (local coordinates, facing right): hips on the seat, legs hanging, both hands on the chain. */
			const sit = (st: Seat) => {
				if (!st.fig) return;
				const u = st.H * S;
				const hip = { x: -2.6, y: -0.075 * u };
				st.fig.pose({
					hip,
					lean: -0.05,
					ankles: [hip, hip],
					legs: [
						[0.12, 1.45],
						[0.18, 1.3],
					],
					feet: [0.35, 0.35],
					hands: [
						{ at: { x: 0, y: -0.2 * u }, pose: 'grip', d: 1.2, dir: -0.2, roll: ROLL.backViewer, contact: 'chain' },
						{ at: { x: 0, y: -0.23 * u }, pose: 'grip', d: 1.2, dir: -0.2, roll: ROLL.palmViewer, contact: 'chain' },
					],
				});
			};
			// the canopy and the ring of lamps (redrawn: the stripes turn)
			const top = $('[data-top]');
			const RC = 5.2; // canopy radius, m
			const draw = (q: number) => {
				const t = q * RUN;
				const w = omega(t);
				parentFigs.forEach((p) => p.f.pose(p.pose));
				const al = alphaOf(w);
				const ps = psi(t);
				const r = A + LC * Math.sin(al);
				const ys = YT - LC * Math.cos(al);
				// canopy: a cone from the top of the column, 16 stripes, the far ones first, then the skirt with lamps
				top.replaceChildren();
				const apex = scr(0, YT + 1.6, 0);
				const NS16 = 16;
				const stripes = Array.from({ length: NS16 }, (_, i) => i).sort((a, b) => Math.sin(ps + ((a + 0.5) * 2 * Math.PI) / NS16) - Math.sin(ps + ((b + 0.5) * 2 * Math.PI) / NS16));
				for (const i of stripes) {
					const a0 = ps + (i * 2 * Math.PI) / NS16;
					const a1 = a0 + (2 * Math.PI) / NS16;
					const p0 = scr(RC * Math.cos(a0), YT + 0.3, RC * Math.sin(a0));
					const p1 = scr(RC * Math.cos(a1), YT + 0.3, RC * Math.sin(a1));
					mk(top, 'path', { class: i % 2 ? 'oc-can-a' : 'oc-can-b', d: `M${f1(apex.x)} ${f1(apex.y)} L${f1(p0.x)} ${f1(p0.y)} L${f1(p1.x)} ${f1(p1.y)} Z` });
				}
				// the skirt: the front half of the canopy's rim, 0,45 м deep
				let d = '';
				for (let j = 0; j <= 24; j++) {
					const a = (Math.PI * j) / 24;
					const p = scr(RC * Math.cos(a), YT + 0.3, RC * Math.sin(a));
					d += `${j ? 'L' : 'M'}${f1(p.x)} ${f1(p.y)}`;
				}
				for (let j = 24; j >= 0; j--) {
					const a = (Math.PI * j) / 24;
					const p = scr(RC * Math.cos(a), YT - 0.15, RC * Math.sin(a));
					d += ` L${f1(p.x)} ${f1(p.y)}`;
				}
				mk(top, 'path', { class: 'oc-skirt', d: `${d} Z` });
				for (let j = 0; j < 24; j++) {
					const a = ps + (j * 2 * Math.PI) / 24;
					if (Math.sin(a) < 0) continue;
					const p = scr(RC * Math.cos(a), YT + 0.07, RC * Math.sin(a));
					mk(top, 'circle', { class: 'oc-bulb', cx: f1(p.x), cy: f1(p.y), r: 1.1 });
				}
				// seats and chains, sorted far to near
				const order = seats.map((st, i) => ({ st, i, phi: ps + (i * 2 * Math.PI) / N })).sort((a, b) => Math.sin(a.phi) - Math.sin(b.phi));
				far.replaceChildren();
				near.replaceChildren();
				for (const { st, phi } of order) {
					// counterclockwise seen from above: the near side (Z > 0) moves to the left on the screen
					const hang = scr(A * Math.cos(phi), YT, A * Math.sin(phi));
					const seat = scr(r * Math.cos(phi), ys, r * Math.sin(phi));
					const layer = Math.sin(phi) < 0 ? far : near;
					st.chain.setAttribute('d', `M${f1(hang.x)} ${f1(hang.y)} L${f1(seat.x)} ${f1(seat.y)}`);
					// the rider faces along the motion; seen at an angle, the profile is narrowed (a turning figure)
					const vx = -Math.sin(phi); // screen x of the motion direction
					const sx = (vx >= 0 ? 1 : -1) * Math.max(0.32, Math.abs(vx));
					const gam = (Math.atan2(hang.x - seat.x, seat.y - hang.y) * 180) / Math.PI; // local up along the chain
					st.wrap.setAttribute('transform', `translate(${f1(seat.x)} ${f1(seat.y)}) rotate(${gam.toFixed(2)}) scale(${sx.toFixed(3)} 1)`);
					st.wrap.setAttribute('class', Math.sin(phi) < 0 ? 'oc-far-tone' : '');
					layer.append(st.chain, st.wrap);
					sit(st); // posed after its transform is set, so the debug boxes of the hands are current
				}
			};
			// two parents wait at the fence, bottom left (nearer than the ride: 0,29 px per см)
			const PS = 0.29;
			const parents = $<SVGGElement>('[data-parents]');
			const parentFigs: { f: ReturnType<typeof figure>; pose: FigurePose }[] = [];
			[
				{ x: 22, H: 168, cls: 'hm-blue', hair: 'pony' as const, name: 'mother', head: -0.25 },
				{ x: 52, H: 180, cls: 'hm-green', hair: 'short' as const, name: 'father', head: -0.2 },
			].forEach((p) => {
				const g = mk(parents, 'g') as SVGGElement;
				const f = figure(g, { s: PS, H: p.H, shirt: p.cls, hair: p.hair, name: p.name });
				const u = p.H * PS;
				const ank = 239 - 7 * PS;
				parentFigs.push({ f, pose: {
					hip: { x: p.x, y: 239 - 0.52 * u },
					lean: 0,
					head: p.head,
					ankles: [
						{ x: p.x + 2, y: ank },
						{ x: p.x - 2, y: ank - 0.8 },
					],
					feet: [0, 0],
					hands: [
						{ arm: [Math.PI / 2 - 0.08, 0.15], pose: 'relaxed' },
						{ arm: [Math.PI / 2 + 0.06, 0.12], pose: 'relaxed' },
					],
					planted: [true, true],
				} });
			});
			scene(card, RUN, draw);
		}
	}
</script>
