---
/**
 * Two short looping opening scenes of «Движение по окружности» (grade 9). No terms of the chapter in the pictures or
 * in the visible captions; each caption's popover names the notion and links to its section.
 *
 * Umbrella (a street right after rain, the sun out; seen from about 28° above the horizontal, an oblique view:
 *   64 px per metre across, 64·cos 28° = 56,5 px per metre up, 64·sin 28° = 30 px per metre in depth). A boy of 12
 *   (teen of the people kit, 152 см, 0,565 px per см, so his height matches the vertical scale) holds an open umbrella
 *   above his head by the handle (his near hand around it) and twirls it about the shaft with his fingers: the hand
 *   stays on the handle, the canopy turns. Canopy radius 0,5 м, rim 1,8 м above the ground, top 0,28 м above the rim;
 *   1,5 turns per second at full speed: the rim moves at 2π · 0,5 · 1,5 = 4,7 м/с. Drops gather at the tips of the
 *   eight ribs and leave them, about four per rib per second, while the rim moves faster than 2,5 м/с. A drop leaves
 *   horizontally along the tangent to the rim (not along the radius), keeps that horizontal direction and falls:
 *   0,61 с to the ground, up to 4,7 · 0,61 = 2,9 м sideways; it splashes and leaves a wet dot. The canopy turns
 *   counterclockwise seen from above, so the streaks form a pinwheel turned the same way. The whole scene is SLOWED
 *   3 times (2,5 s of real time in 7,5 s); the caption's popover says so. Timeline (real seconds): the twirl starts at
 *   0,15 с and reaches full speed at 0,45 с, holds until 1,55 с, stops at 1,9 с; the last drops land by 2,3 с.
 *   Drops behind the shaft's vertical plane are drawn behind the canopy and the boy, the others in front. In the
 *   oblique view the falling bends the streaks, so an inset «вид сверху» (32 px per metre, the same drops and the same
 *   clock) shows that each drop goes straight along the tangent to the rim, the streaks forming a pinwheel.
 * Chain swing ride (a summer park at sunset, side view from 14° above: 20,5 px per metre across, 19,9 px per metre up,
 *   5,0 px per metre in depth; real time, 27 s). Twelve seats hang on chains 5,0 м long from a ring of radius 4,5 м,
 *   5,9 м above the ground, under a striped canopy that turns with them; five riders (teens 155–162 см, children
 *   128–132 см, people kit at 0,21 px per см) sit holding the chain with both hands, seven seats are empty. The top
 *   stands for 1 с, spins up over 9 с to one turn in 6,0 с, keeps it for 7 с, slows down over 9 с and stops. At every
 *   moment all chains lean by the same quasi-static angle α from tg α = ω²(4,5 + 5,0 sin α)/g: 41,1° at full speed
 *   (seats on a circle of 7,78 м at 8,2 м/с), 29,9° at a turn in 7 с, 21,8° in 8 с, 12,7° in 10 с. The ride turns
 *   counterclockwise seen from above. A rider faces along the motion; the kit draws people in profile only, so a rider
 *   seen at an angle is drawn narrowed by |sin φ| (at least 0,32) and turned about the vertical like a card: at the
 *   left and right ends, where the riders move toward or away from the viewer, the figure is narrowest. Each seat
 *   hangs along its chain as projected on the picture, so the outward lean shows at the sides. Two parents wait at
 *   the fence (0,29 px per см, nearer than the ride).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const rnd = (i: number, k: number) => {
	const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
	return r - Math.floor(r);
};
// ---------- Umbrella scene: static street
const puddles = [
	{ x: 64, y: 196, rx: 34, ry: 8 },
	{ x: 290, y: 214, rx: 42, ry: 9 },
	{ x: 250, y: 108, rx: 24, ry: 5 },
	{ x: 40, y: 98, rx: 20, ry: 4 },
];
const glints = Array.from({ length: 40 }, (_, i) => ({ x: 4 + rnd(i, 1) * 352, y: 70 + rnd(i, 2) * 166, w: 3 + rnd(i, 3) * 9 }));
const tiles = Array.from({ length: 12 }, (_, i) => i * 32 - 6);
// ---------- Swings scene: static park
const trees = [
	{ x: 14, y: 132, r: 22 },
	{ x: 52, y: 140, r: 16 },
	{ x: 98, y: 136, r: 20 },
	{ x: 262, y: 134, r: 21 },
	{ x: 306, y: 128, r: 25 },
	{ x: 348, y: 138, r: 18 },
];
const lamps = Array.from({ length: 19 }, (_, i) => {
	const x = 4 + i * 19.6;
	return { x, y: 150 + (i % 2) * 3 };
});
const garland = lamps.map((l, i) => `${i ? 'L' : 'M'}${l.x.toFixed(1)} ${l.y.toFixed(1)}`).join(' ');
const posts = Array.from({ length: 13 }, (_, i) => 6 + i * 29);
---

<PeopleStyles />
<IntroFrame data-okruzhintro>
	<div class="intro__card" data-scene="umbrella">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик на мокрой улице раскручивает над головой зонт; капли слетают с краёв купола и разлетаются в стороны по прямым, закрученным в одну сторону">
			<defs>
				<linearGradient id="ou-glass" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="ou-glass-top"></stop>
					<stop offset="1" class="ou-glass-bot"></stop>
				</linearGradient>
			</defs>
			<!-- the shop front behind the pavement -->
			<rect class="ou-wall" x="0" y="0" width="360" height="54"></rect>
			<rect class="ou-window" x="14" y="0" width="150" height="40" fill="url(#ou-glass)"></rect>
			<rect class="ou-window" x="214" y="0" width="132" height="40" fill="url(#ou-glass)"></rect>
			<path class="ou-shine" d="M30 0 L52 0 L24 40 L8 40 Z M236 0 L250 0 L226 40 L216 40 Z"></path>
			<g class="ou-goods">
				<rect x="40" y="22" width="18" height="18" rx="2"></rect>
				<rect x="66" y="14" width="14" height="26" rx="2"></rect>
				<circle cx="102" cy="30" r="10"></circle>
				<rect x="122" y="20" width="26" height="20" rx="3"></rect>
				<rect x="236" y="18" width="20" height="22" rx="2"></rect>
				<circle cx="280" cy="29" r="11"></circle>
				<rect x="300" y="12" width="16" height="28" rx="2"></rect>
			</g>
			<rect class="ou-frame" x="14" y="0" width="150" height="40"></rect>
			<rect class="ou-frame" x="214" y="0" width="132" height="40"></rect>
			<rect class="ou-door" x="176" y="0" width="28" height="54"></rect>
			<rect class="ou-sill" x="0" y="40" width="360" height="5"></rect>
			<!-- the pavement (wet tiles) and the road beyond the curb is not seen: the view looks down -->
			<rect class="ou-ground" x="0" y="54" width="360" height="186"></rect>
			<rect class="ou-wallwet" x="0" y="54" width="360" height="5"></rect>
			{tiles.map((x) => <path class="ou-seam" d={`M${x} 59 L${x * 1.5 - 90} 240`}></path>)}
			<path class="ou-seam" d="M0 92 H360 M0 140 H360 M0 198 H360"></path>
			{puddles.map((p) => <ellipse class="ou-puddle" cx={p.x} cy={p.y} rx={p.rx} ry={p.ry}></ellipse>)}
			{puddles.map((p) => <ellipse class="ou-sun" cx={p.x - p.rx * 0.3} cy={p.y - p.ry * 0.2} rx={p.rx * 0.22} ry={p.ry * 0.3}></ellipse>)}
			{glints.map((g) => <path class="ou-glint" d={`M${g.x.toFixed(1)} ${g.y.toFixed(1)} h${g.w.toFixed(1)}`}></path>)}
			<g data-wet></g>
			<g data-splash></g>
			<ellipse class="ou-shadow" cx="186" cy="162" rx="40" ry="10"></ellipse>
			<g data-drops-back></g>
			<g data-hback></g>
			<path class="ou-shaft" data-shaft></path>
			<path class="ou-handle" data-crook></path>
			<g data-boy class="ou-boy"></g>
			<g data-canopy></g>
			<g data-drops-front></g>
			<!-- the same umbrella and drops seen from straight above -->
			<clipPath id="ou-inset-clip"><rect x="4" y="4" width="92" height="76" rx="6"></rect></clipPath>
			<g class="ou-inset">
				<rect class="ou-inset-bg" x="4" y="4" width="92" height="76" rx="6"></rect>
				<g clip-path="url(#ou-inset-clip)" data-inset></g>
				<text class="ou-inset-label" x="9" y="76">вид сверху</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Мальчик раскрутил мокрый зонт: капли слетают с краёв купола и <More term="летят прямо — не от середины зонта, а вдоль края">Капля движется вместе с краем зонта по окружности. Сорвавшись, она летит туда, куда двигалась в этот миг, — по касательной к окружности. Подробнее — раздел [«Криволинейное движение»](#криволинейное-движение). В сцене всё замедлено в 3 раза.</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
	<div class="intro__card" data-scene="swings">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Летний парк вечером: цепочная карусель раскручивается, и сиденья на цепях отлетают всё дальше от её середины, потом она замедляется и останавливается">
			<defs>
				<linearGradient id="oc-sky" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="oc-sky-top"></stop>
					<stop offset="1" class="oc-sky-bot"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill="url(#oc-sky)"></rect>
			<circle class="oc-sunset" cx="58" cy="128" r="16"></circle>
			{trees.map((t) => <ellipse class="oc-tree" cx={t.x} cy={t.y} rx={t.r} ry={t.r * 1.25}></ellipse>)}
			{trees.map((t) => <path class="oc-trunk" d={`M${t.x} ${t.y + t.r} V${t.y + t.r * 1.7}`}></path>)}
			<rect class="oc-ground" x="0" y="160" width="360" height="80"></rect>
			<ellipse class="oc-pad" cx="180" cy="205" rx="70" ry="17"></ellipse>
			<ellipse class="oc-pad-edge" cx="180" cy="205" rx="70" ry="17"></ellipse>
			{lamps.map((l) => <circle class="oc-garland" cx={l.x} cy={l.y} r="1.3"></circle>)}
			<path class="oc-wire" d={garland}></path>
			<g data-far></g>
			<g data-column>
				<rect class="oc-col" x="175" y="70" width="10" height="135"></rect>
				<rect class="oc-col-shine" x="177" y="70" width="2.2" height="135"></rect>
				<path class="oc-base" d="M164 206 L196 206 L190 194 L170 194 Z"></path>
			</g>
			<g data-top></g>
			<g data-near></g>
			<g class="oc-fence">
				<path class="oc-rail" d="M0 226 H360 M0 235 H360"></path>
				{posts.map((x) => <path class="oc-post" d={`M${x} 221 V240`}></path>)}
			</g>
			<g data-parents></g>
		</svg>
		<div class="intro__foot">
			<p>
				Карусель раскручивается — и <More term="сиденья на цепях отлетают всё дальше">Сиденье движется по окружности, только пока цепь тянет его к середине карусели. Наклонённая цепь тянет сиденье и вверх, и к оси. Чем быстрее вращение, тем сильнее нужно тянуть к оси, поэтому цепь наклоняется больше. Подробнее — раздел [«Сила и движение по окружности»](#сила-и-движение-по-окружности).</More> от её середины.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

