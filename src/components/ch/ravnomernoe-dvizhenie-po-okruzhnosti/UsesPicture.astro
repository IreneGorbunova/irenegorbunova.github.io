---
/**
 * Pictures for «Где это встречается» of «Движение по окружности» (grade 9): three panels, not to scale.
 *   Сушилка для зелени (top view, animated, SLOWED: a real basket makes several turns per second, here one turn in
 *     2,4 с): the basket with holes turns counterclockwise inside the bowl; the leaves are pressed to the basket's
 *     wall (the wall pushes them toward the center and carries them round); water drops leave the holes and fly in
 *     straight lines along the tangent (velocity of the hole), crossing the gap to the bowl's wall, 36,7 px for a
 *     basket of 50 px and a bowl of 62 px, where they leave wet marks.
 *   Поворот железной дороги (static cross-section, looking along the track into the bend): on a curve the outer rail is
 *     laid higher, the wagon is tilted toward the center of the bend, and the push of the rails on the wagon (green,
 *     perpendicular to the track) leans toward the center: its part toward the center keeps the wagon on the curve.
 *     The tilt is exaggerated (about 6°; real cant is up to 150 мм on 1520 мм, about 5,6°).
 *   Метание молота (static, side view, people kit): an athlete (186 см) turns holding the handle with both hands, arms
 *     straight in line with the wire, leaning back against its pull (before the release about 3000 Н: 7,26 кг at about 28 м/с
 *     on a circle of 1,9 м, 7,26 · 28² / 1,9 ≈ 3000 Н); the ball runs along a circle of radius about 2 м centered on him (the dashed
 *     ellipse, seen a little from above).
 *     At this moment the ball is at the far right of the circle; the wire pulls it toward the athlete (gold T⃗, «сила натяжения троса»).
 *     Its velocity points away from the viewer and is not drawn.
 */
import RdoStyles from './RdoStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
const holes = Array.from({ length: 16 }, (_, i) => (i * Math.PI) / 8);
---

<RdoStyles />
<PeopleStyles />
<figure class="g7 g7--pic rdo not-content" data-rdo-uses>
	<div class="g7__grid is-three">
		<svg class="g7__svg" viewBox="0 0 160 170" role="img" aria-label="Сушилка для зелени сверху: корзина вращается, капли вылетают из отверстий по касательной и попадают на стенку чаши">
			<circle class="rdo-bowl" cx="80" cy="76" r="64"></circle>
			<g data-basket>
				<circle class="rdo-basket" cx="0" cy="0" r="50"></circle>
				{holes.map((a) => <circle class="rdo-holes" cx={(50 * Math.cos(a)).toFixed(1)} cy={(50 * Math.sin(a)).toFixed(1)} r="1.3"></circle>)}
				<path class="rdo-leaf" d="M-46 -12 q6 -10 2 -22 q-10 8 -2 22 Z M30 -36 q10 4 16 -6 q-12 -6 -16 6 Z M38 28 q-2 10 6 14 q4 -10 -6 -14 Z M-22 42 q10 4 18 -2 q-10 -8 -18 2 Z"></path>
			</g>
			<g data-wet></g>
			<g data-drops></g>
			<text x="80" y="165" text-anchor="middle" font-weight="600">Сушилка для зелени</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 160 170" role="img" aria-label="Вагон на повороте железной дороги: наружный рельс выше, сила, с которой рельсы давят на вагон, наклонена к центру поворота">
			<g transform="rotate(6 80 120)">
				<path class="rdo-ballast" d="M20 128 L140 128 L150 140 L10 140 Z"></path>
				<rect class="rdo-sleeper" x="28" y="124" width="104" height="4"></rect>
				<rect class="rdo-wheel" x="38" y="118" width="10" height="6"></rect>
				<rect class="rdo-wheel" x="112" y="118" width="10" height="6"></rect>
				<rect class="rdo-wagon2" x="26" y="40" width="108" height="76" rx="8"></rect>
				<rect class="rdo-window" x="40" y="54" width="80" height="22" rx="3"></rect>
				<g data-n-arrow></g>
			</g>
			<path class="rdo-ballast" d="M0 150 L160 150 L160 155 L0 155 Z"></path>
			<path class="ink" d="M8 30 H40 M40 30 l-7 -3.5 v7 Z"></path>
			<text class="t-small" x="8" y="22">к центру поворота</text>
			<text x="80" y="165" text-anchor="middle" font-weight="600">Поворот железной дороги</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 160 170" role="img" aria-label="Метатель молота держит рукоять двумя руками; шар на тросе движется по окружности, трос тянет шар к спортсмену">
			<rect class="rdo-sand" x="0" y="146" width="160" height="10"></rect>
			<ellipse class="rdo-orbit" cx="50" cy="120" rx="96" ry="16" transform="rotate(-8 50 120)"></ellipse>
			<g data-hback></g>
			<line class="rdo-wire" data-wire></line>
			<g data-thrower></g>
			<circle class="rdo-hammer" r="5.5" data-ball></circle>
			<g data-f-arrow></g>
			<g data-flab><text class="t-i t-gold" x="0" y="0">T</text><path class="rdo-vec" d="M-0.5 -12 H7.5 M5 -14.5 L7.5 -12 L5 -9.5"></path></g>
			<text x="80" y="165" text-anchor="middle" font-weight="600">Метание молота</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Сушилка показана замедленно; наклон вагона преувеличен. Зелёная стрелка — сила, с которой рельсы давят на вагон;
		золотая — сила натяжения троса, которая тянет шар к спортсмену. Не в масштабе.
	</figcaption>
</figure>

<script>
	import { el, f1, loop, newArrow } from './rdo';
	import { figure } from '@components/people/body';
	import { ROLL } from '@components/people/hand';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-rdo-uses]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		// ---- railway: the push of the rails, perpendicular to the track (local up), drawn from the wagon's floor
		newArrow(q('[data-n-arrow]'), 'green')(80, 110, 80, 60, 8, 4.5);
		const nl = el('text', { class: 't-small t-green', x: 86, y: 70, 'font-weight': 600 });
		nl.textContent = 'рельсы';
		q('[data-n-arrow]').append(nl);
		// ---- hammer thrower: hands together on the handle in front of the hips, leaning back against the pull
		const S = 0.5;
		const H = 186;
		const u = H * S;
		const thrower = figure(q<SVGGElement>('[data-thrower]'), { s: S, H, shirt: 'hm-red', bare: true, shorts: true, name: 'hammer thrower' });
		thrower.backLayer(1, q<SVGGElement>('[data-hback]'));
		// he leans back against the pull (about 3000 Н), feet ahead of the hips,
		// knees a little bent; the circle of the ball is centered on him (the axis through his feet and hips)
		const LEAN = -0.32;
		const hip = { x: 47, y: 146 - 7 * S - 0.49 * u };
		// the ball at the right end of the dashed circle (center (50; 120), 96 × 16 px, turned by −8°)
		const BALL = { x: 50 + 96 * Math.cos((8 * Math.PI) / 180), y: 120 - 96 * Math.sin((8 * Math.PI) / 180) };
		// the grip: 93 % of the arm's reach from the near shoulder, straight toward the ball (arms in line with the wire)
		const sh = thrower.shoulders(hip, LEAN)[0];
		const reachPx = 0.93 * (thrower.bones.upper + thrower.bones.fore + 0.4 * thrower.bones.hand);
		const ul = Math.hypot(BALL.x - sh.x, BALL.y - sh.y);
		const GRIP = { x: sh.x + (reachPx * (BALL.x - sh.x)) / ul, y: sh.y + (reachPx * (BALL.y - sh.y)) / ul };
		const pose = {
			hip,
			lean: LEAN,
			head: 0.25,
			ankles: [
				{ x: hip.x + 15, y: 146 - 7 * S },
				{ x: hip.x + 4, y: 146 - 7 * S - 1 },
			] as [{ x: number; y: number }, { x: number; y: number }],
			feet: [0, 0] as [number, number],
			hands: [
				{ at: GRIP, pose: 'grip' as const, d: 3, dir: Math.atan2(BALL.y - sh.y, BALL.x - sh.x), roll: ROLL.backViewer, contact: 'hammer handle' },
				{ at: { x: GRIP.x - 1, y: GRIP.y + 1 }, pose: 'grip' as const, d: 3, dir: Math.atan2(BALL.y - sh.y, BALL.x - sh.x), roll: ROLL.palmViewer, contact: 'hammer handle' },
			] as [any, any],
			planted: [true, true] as [boolean, boolean],
		};
		const wire = q('[data-wire]');
		wire.setAttribute('x1', f1(GRIP.x));
		wire.setAttribute('y1', f1(GRIP.y));
		wire.setAttribute('x2', f1(BALL.x));
		wire.setAttribute('y2', f1(BALL.y));
		q('[data-ball]').setAttribute('cx', f1(BALL.x));
		q('[data-ball]').setAttribute('cy', f1(BALL.y));
		const dx = GRIP.x - BALL.x;
		const dy = GRIP.y - BALL.y;
		const l = Math.hypot(dx, dy);
		newArrow(q('[data-f-arrow]'), 'gold')(BALL.x + (dx / l) * 7, BALL.y + (dy / l) * 7, BALL.x + (dx / l) * 37, BALL.y + (dy / l) * 37, 7, 4);
		q('[data-flab]').setAttribute('transform', `translate(${f1(BALL.x - 26)} ${f1(BALL.y - 12)})`);
		// ---- salad spinner
		const C = { x: 80, y: 76 };
		const RB = 50;
		const RW = 64 - 2;
		const T = 2.4;
		const W = (2 * Math.PI) / T;
		const VP = W * RB; // px per s at the holes
		const FLY = Math.sqrt(RW * RW - RB * RB) / VP; // s from a hole to the bowl's wall
		const N = 10;
		const drops = Array.from({ length: N }, (_, i) => ({ dot: el('circle', { class: 'rdo-waterdrop', r: 1.5 }), off: (i / N) * T, hole: (i * 7) % 16 }));
		for (const d of drops) q('[data-drops]').append(d.dot);
		const wet = q('[data-wet]');
		let t = 0;
		let marks = 0;
		const draw = (dt: number) => {
			const ab = -W * t; // counterclockwise on the screen
			q('[data-basket]').setAttribute('transform', `translate(${C.x} ${C.y}) rotate(${((ab * 180) / Math.PI).toFixed(1)})`);
			for (const d of drops) {
				const cyc = FLY + 0.5;
				const tt = (t + d.off) % cyc;
				const t0 = t - tt; // the moment it left
				const a = -W * t0 + (d.hole * Math.PI) / 8;
				const p = { x: C.x + RB * Math.cos(a), y: C.y + RB * Math.sin(a) };
				const u = { x: Math.sin(a), y: -Math.cos(a) };
				if (tt < FLY) {
					d.dot.setAttribute('opacity', '1');
					d.dot.setAttribute('cx', f1(p.x + u.x * VP * tt));
					d.dot.setAttribute('cy', f1(p.y + u.y * VP * tt));
				} else {
					if (tt - dt < FLY && marks < 60) {
						const e = { x: p.x + u.x * VP * FLY, y: p.y + u.y * VP * FLY };
						wet.append(el('circle', { class: 'rdo-wetmark', cx: f1(e.x), cy: f1(e.y), r: 2 }));
						marks++;
					}
					d.dot.setAttribute('opacity', '0');
				}
			}
			thrower.pose(pose);
		};
		draw(0);
		loop(fig, (dt) => {
			t += dt;
			if (t > 60) {
				t = 0;
				wet.replaceChildren();
				marks = 0;
			}
			draw(dt);
			return true;
		});
	}
</script>
