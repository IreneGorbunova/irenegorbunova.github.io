---
/**
 * Styles shared by the pictures and models of «Движение по окружности» (grade 9), scoped under `.rdo` (every figure of
 * the chapter has it next to `g7`). Renders nothing. Colors of the chapter, one per quantity, as in «Прямолинейное
 * движение»: velocity blue (`arrow--blue`, --ig-vx), acceleration red (`arrow--red`, --ig-vy), the force that keeps a
 * body on the circle green (`arrow--green`, --g7-green); the path and arcs gold.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<style is:global>
	.rdo .rdo-path {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.4;
	}
	.rdo .rdo-arc {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3.5;
		stroke-linecap: round;
		opacity: 0.7;
	}
	.rdo .rdo-trail {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-2) 75%, transparent);
		stroke-width: 3.5;
		stroke-linecap: butt;
	}
	.rdo .rdo-radius {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.rdo .rdo-center {
		fill: var(--sl-color-gray-2);
	}
	.rdo .rdo-dot {
		fill: var(--sl-color-white);
		stroke: var(--g7-paper);
		stroke-width: 1.4;
	}
	.rdo .rdo-mark {
		fill: var(--sl-color-gray-3);
	}
	.rdo .rdo-ghost {
		opacity: 0.55;
	}
	.rdo .rdo-right {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.rdo .rdo-sector {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 16%, transparent);
	}
	.rdo .rdo-face {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.rdo .rdo-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.rdo .rdo-tick--s {
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.rdo .rdo-hand {
		stroke: var(--sl-color-gray-1);
		stroke-linecap: round;
	}
	.rdo .rdo-hand--s {
		stroke: var(--g7-red);
	}
	.rdo {
		/* one color per force, distinct in both themes: elastic force gold, friction orange */
		--rdo-gold: hsl(48, 95%, 60%);
		--rdo-orange: hsl(22, 95%, 58%);
		--rdo-violet: var(--g7-violet);
	}
	:root[data-theme='light'] .rdo {
		--rdo-gold: hsl(46, 100%, 38%);
		--rdo-orange: hsl(14, 85%, 47%);
	}
	.rdo .g7__svg .arrow--gold {
		stroke: var(--rdo-gold);
	}
	.rdo .g7__svg .head--gold {
		fill: var(--rdo-gold);
	}
	.rdo .g7__svg .t-gold {
		fill: var(--rdo-gold);
	}
	.rdo .g7__svg .arrow--orange {
		stroke: var(--rdo-orange);
	}
	.rdo .g7__svg .head--orange {
		fill: var(--rdo-orange);
	}
	.rdo .g7__svg .arrow--violet {
		stroke: var(--rdo-violet);
	}
	.rdo .g7__svg .head--violet {
		fill: var(--rdo-violet);
	}
	.rdo .t-orange {
		fill: var(--rdo-orange);
	}
	.rdo .t-violet {
		fill: var(--rdo-violet);
	}
	.rdo .rdo-ground {
		fill: var(--g7-ground);
	}
	.rdo .rdo-road {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-5) 80%, var(--ig-vx) 6%);
		stroke-linecap: butt;
	}
	.rdo .rdo-roadline {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 5 5;
	}
	.rdo .rdo-grass {
		fill: color-mix(in oklab, hsl(120, 40%, 45%) 28%, var(--g7-paper));
	}
	.rdo .rdo-car {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--ig-vx) 20%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-glass {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--g7-paper));
	}
	.rdo .rdo-ball {
		fill: var(--ig-vy);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-sep {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.rdo .rdo-check {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rdo .rdo-check input {
		accent-color: var(--sl-color-accent);
		width: 1.05rem;
		height: 1.05rem;
		margin: 0;
	}
	.rdo .rdo-ctrl {
		display: grid;
		gap: 0.6rem;
	}
	.rdo .rdo-table {
		fill: var(--g7-wood);
	}
	.rdo .rdo-table-rim {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 6;
	}
	.rdo .rdo-gutter {
		fill: none;
		stroke: var(--g7-steel);
		stroke-linecap: butt;
	}
	.rdo .rdo-gutter-in {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-linecap: butt;
	}
	.rdo .rdo-ghostpath {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.rdo .rdo-straight {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
	}
	.rdo .rdo-steelball {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-tape {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.rdo .rdo-core {
		fill: color-mix(in oklab, var(--g7-wood) 70%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-hole {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-paint {
		fill: var(--ig-vy);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.rdo .rdo-stand {
		fill: color-mix(in oklab, var(--sl-color-gray-4) 80%, var(--ig-vx) 10%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-floor {
		fill: var(--g7-faint);
	}
	.rdo .rdo-carpet {
		fill: color-mix(in oklab, var(--ig-vy) 18%, var(--g7-paper));
	}
	.rdo .rdo-carpet-pat {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 30%, var(--g7-paper));
		stroke-width: 1;
	}
	.rdo .rdo-sleeper {
		stroke: var(--g7-wood-dark);
		stroke-width: 2.4;
	}
	.rdo .rdo-rail {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 1.4;
	}
	.rdo .rdo-startline {
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
	}
	.rdo .rdo-loco {
		fill: var(--g7-green);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-wagon {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--ig-vy) 15%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-cab {
		fill: var(--g7-ink);
		opacity: 0.7;
	}
	.rdo .g7__svg .arrow.rdo-dashed {
		stroke-dasharray: 5 3.5;
		stroke-linecap: butt;
	}
	.rdo .rdo-faint {
		opacity: 0.45;
	}
	.rdo .rdo-ice {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--g7-paper));
	}
	.rdo .rdo-thread {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.rdo .rdo-peg {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-puck {
		fill: var(--g7-ink);
	}
	.rdo .rdo-earth {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-land {
		fill: color-mix(in oklab, hsl(120, 45%, 45%) 70%, var(--g7-paper));
	}
	.rdo .rdo-sat {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.rdo .rdo-panel {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 0.5;
	}
	.rdo .rdo-space {
		fill: hsl(230, 35%, 11%);
	}
	.rdo .rdo-star {
		fill: hsl(220, 20%, 70%);
	}
	.rdo .rdo-spacebox text {
		fill: hsl(220, 25%, 86%);
	}
	.rdo .rdo-spacebox .rdo-orbit {
		stroke: hsl(220, 15%, 60%);
	}
	.rdo .rdo-spacebox .rdo-lead {
		stroke: hsl(220, 15%, 50%);
	}
	.rdo .rdo-spacebox .rdo-blur {
		stroke: hsl(220, 25%, 90%);
	}
	.rdo .rdo-surf {
		fill: none;
		stroke-linecap: butt;
	}
	.rdo .rdo-surf--dry {
		stroke: color-mix(in oklab, var(--sl-color-gray-4) 85%, var(--ig-vx) 5%);
	}
	.rdo .rdo-surf--wet {
		stroke: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--ig-vx) 30%);
	}
	.rdo .rdo-surf--snow {
		stroke: color-mix(in oklab, white 75%, var(--sl-color-gray-4));
	}
	.rdo .rdo-surf--ice {
		stroke: color-mix(in oklab, hsl(195, 80%, 80%) 75%, var(--sl-color-gray-4));
	}
	.rdo .rdo-bar-need {
		fill: none;
		stroke: var(--rdo-orange);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.rdo .rdo-bar-max {
		fill: var(--rdo-orange);
		opacity: 0.8;
	}
	.rdo .rdo-skid {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-dasharray: 2 2;
		opacity: 0.6;
	}
	.rdo .rdo-orbit {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
		stroke-dasharray: 3 3;
	}
	.rdo .rdo-lead {
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.rdo .rdo-dish {
		fill: var(--ig-vy);
	}
	.rdo .rdo-sight {
		stroke: var(--ig-vy);
		stroke-width: 0.8;
		stroke-dasharray: 2 3;
		opacity: 0.7;
	}
	.rdo .rdo-blur {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0.5;
	}
	.rdo .rdo-bowl {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--g7-paper));
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.rdo .rdo-basket {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.rdo .rdo-holes {
		fill: var(--g7-paper);
	}
	.rdo .rdo-leaf {
		fill: hsl(120, 45%, 45%);
		stroke: hsl(120, 45%, 28%);
		stroke-width: 0.6;
	}
	.rdo .rdo-waterdrop {
		fill: hsl(200, 80%, 60%);
	}
	.rdo .rdo-wetmark {
		fill: hsl(200, 80%, 60%);
		opacity: 0.45;
	}
	.rdo .rdo-ballast {
		fill: color-mix(in oklab, var(--g7-wood) 40%, var(--sl-color-gray-4));
	}
	.rdo .rdo-wagon2 {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-window {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--g7-paper));
	}
	.rdo .rdo-wheel {
		fill: var(--g7-ink);
	}
	.rdo .rdo-hammer {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.rdo .rdo-wire {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.rdo .rdo-sand {
		fill: color-mix(in oklab, var(--g7-wood) 35%, var(--g7-paper));
	}
	.rdo .g7__svg .rdo-tlab {
		fill: hsl(25, 45%, 16%);
		font-weight: 600;
	}
	.rdo .rdo-tick-w {
		stroke: hsl(25, 45%, 16%);
		stroke-width: 1.2;
	}
	.rdo .t-green {
		fill: var(--g7-green);
	}
	.rdo .rdo-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
	}
</style>
