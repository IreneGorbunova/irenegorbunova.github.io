---
/**
 * Two short looping opening scenes of «Звёзды». No terms of the chapter in the pictures; the popovers explain.
 * Nail: an iron nail held in a gas flame. Its temperature rises from 20 to 1300 °C and it glows the way hot iron
 *   does: nothing below about 525 °C, then dark red, red, orange, yellow, almost white. (Colors of a heated body,
 *   set by eye for steps of 100 °C; the thermometer's numbers are the nail's temperature.)
 * Thumb: a thumb at arm's length (0,6 м) seen in turn by the left and the right eye (6,5 см apart) against houses
 *   50 м away. The thumb jumps by 6,2°, the far houses practically stay: the same scale in degrees for both.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const blur = `zi-blur-${uid}`;
// the far street: houses with windows, the same for both eyes
const houses = [
	[6, 96, 46, 62],
	[58, 78, 40, 80],
	[104, 104, 52, 54],
	[162, 86, 44, 72],
	[212, 98, 50, 60],
	[268, 74, 40, 84],
	[314, 100, 42, 58],
];
---

<IntroFrame data-zvintro>
	<div class="intro__card" data-scene="nail">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Гвоздь держат в пламени горелки. Он нагревается и начинает светиться: сначала тёмно-красным, потом оранжевым, потом почти белым">
			<defs>
				<filter id={blur} filterUnits="userSpaceOnUse" x="60" y="70" width="190" height="84">
					<feGaussianBlur stdDeviation="7"></feGaussianBlur>
				</filter>
			</defs>
			<rect class="zi-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="zi-table" x="0" y="204" width="360" height="36"></rect>
			<!-- the burner and its flame -->
			<rect class="zi-metal" x="112" y="176" width="36" height="28" rx="3"></rect>
			<rect class="zi-metal" x="124" y="150" width="12" height="28"></rect>
			<path class="zi-flame" d="M130 150 C112 128 122 108 130 84 C138 108 148 128 130 150 Z"></path>
			<path class="zi-flame zi-flame--in" d="M130 150 C122 136 126 124 130 110 C134 124 138 136 130 150 Z"></path>
			<!-- the nail in the flame, held by pliers -->
			<line class="zi-glow" data-glow x1="96" y1="112" x2="212" y2="112" filter={`url(#${blur})`}></line>
			<line class="zi-nail" data-nail x1="96" y1="112" x2="212" y2="112"></line>
			<rect class="zi-nailhead" data-head x="210" y="104" width="5" height="16" rx="1"></rect>
			<path class="zi-pliers" d="M214 106 L300 92 M214 118 L300 132 M300 92 L346 100 M300 132 L346 124"></path>
			<circle class="zi-pliers-dot" cx="300" cy="112" r="4"></circle>
			<!-- the thermometer of the nail -->
			<rect class="zi-read" x="14" y="16" width="118" height="34" rx="8"></rect>
			<text class="zi-small" x="24" y="30">температура гвоздя</text>
			<text class="zi-num" data-temp x="24" y="45">20 °C</text>
			<text class="zi-word" data-word x="154" y="38"></text>
		</svg>
		<div class="intro__foot">
			<p>
				Гвоздь в пламени сначала светится тёмно-красным, потом оранжевым, потом почти белым:{' '}
				<More term="чем горячее тело, тем белее его свет">
					У звёзд так же. Красноватая звезда Бетельгейзе холоднее Солнца: её поверхность нагрета примерно до 3300&nbsp;°C. Голубоватый Ригель намного горячее Солнца — около 12&nbsp;000&nbsp;°C. По цвету звезды узнают температуру её поверхности: об этом{' '}
					<a href="#светимость-температура-цвет">дальше в главе</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="thumb">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Палец вытянутой руки на фоне далёких домов. Если смотреть то левым, то правым глазом, палец перескакивает на фоне домов">
			<rect class="zi-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="zi-ground" x="0" y="158" width="360" height="82"></rect>
			{
				houses.map(([x, y, w, h]) => (
					<g>
						<rect class="zi-house" x={x} y={y} width={w} height={h} />
						{[0, 1].map((r) => [0, 1, 2].map((c) => <rect class="zi-win" x={x + 6 + c * ((w - 12) / 3) + 1} y={y + 10 + r * 20} width={(w - 12) / 3 - 4} height="9" />))}
					</g>
				))
			}
			<!-- the thumb and the hand, near and large -->
			<g data-hand>
				<path class="zi-hand" d="M-34 240 L-30 190 Q-28 172 -14 170 L-14 120 Q-14 104 0 104 Q14 104 14 120 L14 172 Q40 176 44 200 L46 240 Z"></path>
				<path class="zi-nailpl" d="M-8 112 Q0 106 8 112 L8 130 Q0 134 -8 130 Z"></path>
			</g>
			<rect class="zi-read" x="14" y="14" width="124" height="26" rx="8"></rect>
			<text class="zi-num" data-eye x="24" y="32">левый глаз</text>
		</svg>
		<div class="intro__foot">
			<p>
				Вытяните руку, поднимите палец и посмотрите на него то левым, то правым глазом. Палец{' '}
				<More term="перескакивает на фоне далёких домов">
					Чем дальше предмет, тем меньше такой скачок: дома на рисунке почти не сдвигаются. Так измеряют расстояния до звёзд. Вместо двух глаз — два положения Земли на орбите с разницей в полгода, вместо пальца — близкая звезда, а фоном служат очень далёкие звёзды. Об этом{' '}
					<a href="#как-далеко-до-звёзд">дальше в главе</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-zvintro] .zi-room {
		fill: hsl(230, 22%, 16%);
	}
	[data-zvintro] .zi-table {
		fill: hsl(28, 16%, 26%);
	}
	[data-zvintro] .zi-metal {
		fill: hsl(220, 10%, 46%);
	}
	[data-zvintro] .zi-flame {
		fill: hsl(210, 90%, 62%);
		opacity: 0.75;
	}
	[data-zvintro] .zi-flame--in {
		fill: hsl(195, 100%, 82%);
		opacity: 0.9;
	}
	[data-zvintro] .zi-nail {
		stroke: hsl(220, 8%, 42%);
		stroke-width: 6;
		stroke-linecap: round;
	}
	[data-zvintro] .zi-glow {
		stroke: hsl(20, 100%, 55%);
		stroke-width: 22;
		stroke-linecap: round;
		opacity: 0;
	}
	[data-zvintro] .zi-nailhead {
		fill: hsl(220, 8%, 42%);
	}
	[data-zvintro] .zi-pliers {
		fill: none;
		stroke: hsl(220, 10%, 60%);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-zvintro] .zi-pliers-dot {
		fill: hsl(220, 10%, 72%);
	}
	[data-zvintro] .zi-read {
		fill: hsl(232 45% 9% / 0.78);
	}
	[data-zvintro] .zi-small {
		font-size: 9px;
		fill: hsl(230, 20%, 76%);
	}
	[data-zvintro] .zi-num {
		font-size: 13px;
		font-weight: 700;
		fill: hsl(42, 90%, 72%);
	}
	[data-zvintro] .zi-word {
		font-size: 12px;
		fill: hsl(40, 30%, 92%);
	}
	[data-zvintro] .zi-sky {
		fill: hsl(205, 55%, 78%);
	}
	[data-zvintro] .zi-ground {
		fill: hsl(95, 22%, 46%);
	}
	[data-zvintro] .zi-house {
		fill: hsl(28, 24%, 62%);
		stroke: hsl(28, 20%, 40%);
		stroke-width: 1;
	}
	[data-zvintro] .zi-win {
		fill: hsl(210, 40%, 34%);
	}
	[data-zvintro] .zi-hand {
		fill: hsl(24, 52%, 70%);
		stroke: hsl(20, 40%, 42%);
		stroke-width: 1.5;
	}
	[data-zvintro] .zi-nailpl {
		fill: hsl(24, 60%, 84%);
		stroke: hsl(20, 40%, 52%);
		stroke-width: 1;
	}
	:root:not([data-theme='light']) [data-zvintro] .zi-sky {
		fill: hsl(215, 40%, 30%);
	}
	:root:not([data-theme='light']) [data-zvintro] .zi-ground {
		fill: hsl(100, 16%, 22%);
	}
	:root:not([data-theme='light']) [data-zvintro] .zi-house {
		fill: hsl(28, 14%, 36%);
		stroke: hsl(28, 12%, 22%);
	}
	:root:not([data-theme='light']) [data-zvintro] .zi-win {
		fill: hsl(45, 70%, 62%);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	// the color of iron at a temperature, °C: [temperature, color of the metal, strength of the glow around it]
	const HOT: [number, [number, number, number], number][] = [
		[20, [104, 108, 118], 0],
		[500, [104, 108, 118], 0],
		[600, [110, 34, 26], 0.15],
		[700, [150, 30, 18], 0.3],
		[800, [196, 44, 16], 0.45],
		[900, [232, 78, 20], 0.6],
		[1000, [248, 122, 32], 0.72],
		[1100, [255, 166, 62], 0.84],
		[1200, [255, 204, 112], 0.92],
		[1300, [255, 232, 170], 1],
	];
	const WORD: [number, string][] = [
		[525, 'не светится'],
		[750, 'тёмно-красный'],
		[950, 'красный'],
		[1100, 'оранжевый'],
		[1250, 'жёлтый'],
		[9999, 'почти белый'],
	];
	const colorAt = (T: number) => {
		let i = 0;
		while (i < HOT.length - 2 && T > HOT[i + 1][0]) i++;
		const [t0, c0, g0] = HOT[i];
		const [t1, c1, g1] = HOT[i + 1];
		const u = Math.min(1, Math.max(0, (T - t0) / (t1 - t0)));
		return { rgb: c0.map((v, k) => Math.round(v + (c1[k] - v) * u)), glow: g0 + (g1 - g0) * u };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-zvintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="nail"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const nail = $<SVGLineElement>('[data-nail]');
			const head = $<SVGRectElement>('[data-head]');
			const glow = $<SVGLineElement>('[data-glow]');
			const temp = $<SVGTextElement>('[data-temp]');
			const word = $<SVGTextElement>('[data-word]');
			scene(card, 7, (x) => {
				// the nail warms quickly at first, then ever more slowly, as it nears the flame's temperature
				const T = 20 + 1280 * (1 - Math.exp(-3.2 * x)) / (1 - Math.exp(-3.2));
				const { rgb, glow: g } = colorAt(T);
				const c = `rgb(${rgb.join(',')})`;
				nail.style.stroke = c;
				head.style.fill = c;
				glow.style.stroke = c;
				glow.style.opacity = String(g * 0.85);
				temp.textContent = `${Math.round(T / 10) * 10} °C`;
				word.textContent = WORD.find(([t]) => T < t)![1];
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="thumb"]')!;
			const hand = card.querySelector<SVGGElement>('[data-hand]')!;
			const eye = card.querySelector<SVGTextElement>('[data-eye]')!;
			// 6,5 см between the eyes, the thumb 0,6 м away: it jumps by 6,2°. The picture is 40° wide: 9 px per degree.
			const HALF = ((Math.atan(0.065 / 0.6) * 180) / Math.PI / 2) * 9;
			scene(card, 8, (x) => {
				// four looks: left, right, left, right; the switch takes a twentieth of the run
				const phase = x * 4;
				const k = Math.min(3, Math.floor(phase));
				const u = Math.min(1, (phase - k) / 0.2);
				const from = k % 2 === 0 ? -1 : 1; // where the previous look left the thumb (seen by the left eye it stands to the right)
				const side = k === 0 ? 1 : from + (-from - from) * (u * u * (3 - 2 * u));
				hand.setAttribute('transform', `translate(${(180 + side * HALF).toFixed(1)} 0)`);
				eye.textContent = k % 2 === 0 ? 'левый глаз' : 'правый глаз';
			});
		}
	}
</script>
