---
/**
 * Picture to the unit of force: a block of 1 кг on a smooth horizontal table (no friction) is pulled to the right by a
 * dynamometer that reads 1 Н the whole time; the dynamometer moves with the block. From rest, by the second law
 * a = F/m = 1 м/с², so x = t²/2 and υ = t: at t = 0, 1, 2, 3 с the block is at 0; 0,5; 2,0; 4,5 м and has
 * 0, 1, 2, 3 м/с. Real time: the run lasts 3 с, then the last frame holds for 2 с and the loop restarts.
 * Scale 50 px per metre along the table; the block (about 10 см) is drawn 26 px wide and the dynamometer and its thread
 * longer than to scale; the dynamometer's scale marks run along its top edge, clear of the reading «1 Н». A faded copy of the block stays at each whole second with its velocity arrow (--ig-v, 20 px per
 * м/с) and a label; the moving block carries the force arrow (--ig-vy, at the thread) and the acceleration arrow
 * (--ig-vx, 20 px for 1 м/с²), both constant. A scale under the table every 0,5 м from 0 to 4,5 м.
 */
import NzPicStyles from './NzPicStyles.astro';
import { arrow, over } from './pic';

const K = 50; // px per metre
const X0 = 10; // the block's left face at x = 0
const BW = 26; // block width, px
const TOP = 124; // table top
const BH = 22; // block height
const MID = TOP - BH / 2; // the height of the thread
const VK = 20; // px per м/с of a velocity arrow
const AK = 20; // px per м/с² of the acceleration arrow
const copies = [0, 1, 2, 3].map((t) => {
	const x = X0 + (t * t * K) / 2;
	const c = x + BW / 2;
	return { t, x, c, v: t, va: t > 0 ? arrow(c, 84, c + t * VK, 84, 8) : null, row: t === 1 ? 40 : 64 };
});
const ticks = Array.from({ length: 10 }, (_, k) => ({ x: X0 + k * 0.5 * K, label: k % 2 ? `${(k / 2).toFixed(1).replace('.', ',')}` : String(k / 2) }));
const fA = arrow(0, MID, 22, MID, 8); // drawn at the block's right face, along the thread
const aA = arrow(0, 90, AK, 90, 8); // from the block's center
---

<NzPicStyles />
<figure class="nz-pic nz-pic--one nu not-content" data-nupic data-k={K} data-x0={X0} data-bw={BW}>
	<div class="nz-pic__grid">
		<svg class="nz-pic__svg" viewBox="0 0 360 178" role="img" aria-label="Брусок массой 1 кг на гладком столе тянут динамометром, который всё время показывает 1 Н. Брусок разгоняется: через 1 с его скорость 1 м/с, через 2 с — 2 м/с, через 3 с — 3 м/с">
			<text class="nu-read" x="348" y="18" text-anchor="end" data-read>t = 0,0 с   υ = 0,0 м/с</text>
			<!-- the copies at whole seconds -->
			{
				copies.map((c) => (
					<g class="nu-copy" data-copy={c.t} opacity="0">
						<rect class="nu-block nu-block--ghost" x={c.x} y={TOP - BH} width={BW} height={BH} rx="2" />
						{c.va && <path class="nz-ar nz-ar--v" d={c.va.shaft} />}
						{c.va && <path class="nz-hd--v" d={c.va.head} />}
						<line class="nu-lead" x1={c.c} y1={c.row + 4} x2={c.c} y2={c.t > 0 ? 80 : TOP - BH - 2} />
						<text class="nu-time" x={c.c} y={c.row - 12} text-anchor="middle">{`t = ${c.t} с`}</text>
						<text class="nz-small nz-tv" x={c.c} y={c.row} text-anchor="middle">{c.t ? `υ = ${c.v} м/с` : 'υ = 0'}</text>
					</g>
				))
			}
			<!-- the table -->
			<rect class="nu-table" x="4" y={TOP} width="352" height="7" rx="1.5"></rect>
			<path class="nu-legs" d={`M 20 ${TOP + 7} V 146 M 340 ${TOP + 7} V 146`}></path>
			<g class="nu-scale">
				<line x1={X0} y1="152" x2={X0 + 4.5 * K} y2="152"></line>
				{ticks.map((t) => <line x1={t.x} y1="149" x2={t.x} y2="155" />)}
				{ticks.map((t, i) => <text x={t.x} y="167" text-anchor="middle">{t.label}</text>)}
				<text x={X0 + 4.5 * K + 10} y="167">м</text>
			</g>
			<!-- the moving block with the dynamometer -->
			<g data-mover>
				<rect class="nu-block" x="0" y={TOP - BH} width={BW} height={BH} rx="2"></rect>
				<text class="nu-kg" x={BW / 2} y={TOP - BH / 2 + 4} text-anchor="middle">1 кг</text>
				<line class="nu-thread" x1={BW} y1={MID} x2={BW + 38} y2={MID}></line>
				<g transform={`translate(${BW + 38} ${MID})`}>
					<rect class="nu-dyn" x="0" y="-8" width="44" height="16" rx="3"></rect>
					<path class="nu-dyn-ticks" d="M 6 -8 V -5.5 M 12 -8 V -6 M 18 -8 V -5.5 M 24 -8 V -6 M 30 -8 V -5.5 M 36 -8 V -6"></path>
					<text class="nu-dyn-read" x="22" y="5" text-anchor="middle">1 Н</text>
					<circle class="nu-ring" cx="49" cy="0" r="4.5"></circle>
				</g>
				<path class="nz-ar nz-ar--f" d={fA.shaft} transform={`translate(${BW} 0)`}></path>
				<path class="nz-hd--f" d={fA.head} transform={`translate(${BW} 0)`}></path>
				<text class="nz-sym nz-tf" x={BW + 24} y={MID + 5}>F</text>
				<path class="nz-over nz-over--f" d={over(BW + 24, MID + 5, 9)}></path>
				<g transform={`translate(${BW / 2} 0)`}>
					<path class="nz-ar nz-ar--a" d={aA.shaft}></path>
					<path class="nz-hd--a" d={aA.head}></path>
					<text class="nz-small nz-ta" x={AK + 4} y="94">a = 1 м/с²</text>
				</g>
			</g>
		</svg>
	</div>
	<div class="nz-pic__foot">
		<figcaption>Сила 1&nbsp;Н разгоняет тело массой 1&nbsp;кг так, что каждую секунду его скорость растёт на 1&nbsp;м/с. Трения нет.</figcaption>
		<button type="button" class="nz-pic__again" data-again>Повторить</button>
	</div>
</figure>

<style is:global>
	.nz-pic.nu .nz-small {
		font-size: 12px;
	}
	.nu-block {
		fill: hsl(28, 45%, 52%);
		stroke: hsl(28, 40%, 28%);
		stroke-width: 1;
	}
	.nu-block--ghost {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-dasharray: 3 2;
		opacity: 0.8;
	}
	.nz-pic .nu-kg {
		font-size: 10px;
		font-weight: 700;
		fill: white;
		stroke: none;
	}
	.nu-lead {
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	.nz-pic .nu-time {
		font-size: 11px;
		fill: var(--sl-color-gray-3);
	}
	.nz-pic .nu-read {
		font-size: 12px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
		font-variant-numeric: tabular-nums;
		white-space: pre;
	}
	.nu-table {
		fill: var(--nz-ground);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.nu-legs {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.nu-scale line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.nz-pic .nu-scale text {
		font-size: 10.5px;
		fill: var(--sl-color-gray-2);
	}
	.nu-thread {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.nu-dyn {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 60%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.nu-dyn-ticks,
	.nu-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.nz-pic .nu-dyn-read {
		font-size: 11px;
		font-weight: 700;
		fill: var(--sl-color-white);
		stroke: none;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const RUN = 3; // s
	const HOLD = 2; // s
	const fmt = (v: number) => v.toFixed(1).replace('.', ',');
	for (const root of document.querySelectorAll<HTMLElement>('[data-nupic]')) {
		const K = Number(root.dataset.k);
		const X0 = Number(root.dataset.x0);
		const mover = root.querySelector<SVGGElement>('[data-mover]')!;
		const read = root.querySelector<SVGTextElement>('[data-read]')!;
		const copies = Array.from(root.querySelectorAll<SVGGElement>('[data-copy]'));
		let t = 0;
		const draw = () => {
			const tt = Math.min(t, RUN);
			const x = (tt * tt) / 2; // a = 1 м/с²
			mover.setAttribute('transform', `translate(${(X0 + x * K).toFixed(2)} 0)`);
			read.textContent = `t = ${fmt(tt)} с   υ = ${fmt(tt)} м/с`;
			copies.forEach((c, i) => c.setAttribute('opacity', tt >= i - 1e-9 ? '1' : '0'));
		};
		const wake = loop(root, (dt) => {
			t += dt;
			if (t > RUN + HOLD) t = 0;
			draw();
			return true;
		});
		root.querySelector('[data-again]')!.addEventListener('click', () => {
			t = 0;
			draw();
			wake();
		});
		draw();
	}
</script>
