---
/**
 * Two short looping opening scenes of «Законы Ньютона». No terms of the chapter in the pictures; the captions'
 * popovers explain.
 * Puck: two pucks start at 8 m/s, one on ice, one on asphalt (top view, 30 m of lane, 10,23 px per metre, real time).
 *   Friction slows them with a = μg: μ = 0,05 on ice (a = 0,49 m/s²: the puck crosses the 30 m in 4,32 s and still
 *   has 5,9 m/s at the boards), μ = 0,5 on asphalt (a = 4,9 m/s²: it stops after 1,63 s and 6,5 m). Marks every
 *   0,25 s. The pucks are drawn larger than to scale.
 * Skaters: a father (80 kg) and his daughter (40 kg) stand on skates palm to palm and push each other apart with 50 N
 *   for 0,8 s (side view, 60 px per metre, real time). Equal and opposite forces: she gets 1,25 m/s², he 0,625 m/s²,
 *   so right after the push she has 1,0 m/s and he 0,5 m/s; then the skates' friction (μ = 0,005, a = 0,049 m/s²)
 *   slows both a little during the 2,4 s of gliding.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// Puck scene
const PK = 307 / 30; // px per metre
const PX0 = 24; // start of the pucks' centers
const ICE = { y0: 34, y1: 112 };
const ASPH = { y0: 140, y1: 218 };
const specks = Array.from({ length: 70 }, (_, i) => {
	const r = Math.sin(i * 12.9898) * 43758.5453;
	const q = Math.sin(i * 78.233) * 12345.6789;
	return { x: 6 + (r - Math.floor(r)) * 330, y: ASPH.y0 + 4 + (q - Math.floor(q)) * (ASPH.y1 - ASPH.y0 - 8) };
});

// Skaters scene
const FEET = 222;
/** A skater facing right, feet at (0, 0), height h px; arms are drawn by the script. */
const skater = (h: number, girl: boolean) => ({
	head: { cx: 1, cy: -0.9 * h, r: 0.075 * h },
	torso: `M 0 ${-0.47 * h} L 0.5 ${-0.79 * h}`,
	legs: `M -1 ${-0.47 * h} L -5 -9 M 1 ${-0.47 * h} L 5 -9`,
	tw: 0.15 * h,
	lw: 0.08 * h,
	boots: [-5, 5].map((x) => ({ x: x - 5, y: -10 })),
	blade: 'M -13 0 L 14 0',
	extra: girl
		? `M ${1 - 0.07 * h} ${-0.92 * h} q -7 2 -6 12`
		: `M ${1 - 0.08 * h} ${-0.92 * h} Q 1 ${-1.06 * h} ${1 + 0.08 * h} ${-0.92 * h} Z`,
});
const DAD = skater(108, false);
const GIRL = skater(84, true);
---

<IntroFrame data-nzintro data-pk={PK} data-px0={PX0} data-feet={FEET}>
	<div class="intro__card" data-scene="puck">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Две одинаковые шайбы пускают с одной и той же скоростью: одну по льду, другую по асфальту. Шайба на льду проскальзывает через всю площадку до бортика, а шайба на асфальте останавливается через несколько метров">
			<rect class="ni-ice" x="0" y={ICE.y0} width="360" height={ICE.y1 - ICE.y0}></rect>
			<rect class="ni-board" x="338" y={ICE.y0 - 4} width="10" height={ICE.y1 - ICE.y0 + 8} rx="2"></rect>
			<rect class="ni-asph" x="0" y={ASPH.y0} width="360" height={ASPH.y1 - ASPH.y0}></rect>
			{specks.map((s) => <circle class="ni-speck" cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r="1.1" />)}
			<text class="ni-tag" x="8" y={ICE.y0 - 8}>лёд</text>
			<text class="ni-tag" x="8" y={ASPH.y0 - 8}>асфальт</text>
			<text class="ni-read" x="330" y={ICE.y0 - 8} text-anchor="end" data-vice>8,0 м/с</text>
			<text class="ni-read" x="330" y={ASPH.y0 - 8} text-anchor="end" data-vasph>8,0 м/с</text>
			<g data-ghosts></g>
			<g data-puck="ice">
				<circle class="ni-puck" r="7" cy={(ICE.y0 + ICE.y1) / 2}></circle>
				<circle class="ni-puck-top" r="4" cy={(ICE.y0 + ICE.y1) / 2}></circle>
			</g>
			<g data-puck="asph">
				<circle class="ni-puck" r="7" cy={(ASPH.y0 + ASPH.y1) / 2}></circle>
				<circle class="ni-puck-top" r="4" cy={(ASPH.y0 + ASPH.y1) / 2}></circle>
			</g>
			<g class="ni-scale">
				<line x1={PX0} y1="232" x2={PX0 + 10 * PK} y2="232"></line>
				<line x1={PX0} y1="228" x2={PX0} y2="236"></line>
				<line x1={PX0 + 10 * PK} y1="228" x2={PX0 + 10 * PK} y2="236"></line>
				<text x={PX0 + 10 * PK + 6} y="236">10 м</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Шайба, пущенная по льду, проскальзывает через всю площадку, а пущенная с той же скоростью по асфальту останавливается через несколько метров. <More term="Шайбу останавливает трение">На льду трение очень мало, и шайба теряет скорость медленно. На асфальте трение примерно в 10 раз больше. Если бы трения не было совсем, шайба скользила бы, совсем не замедляясь. Подробнее — в разделе <a href="#первый-закон-ньютона">«Первый закон Ньютона»</a>.</More>, а не то, что её перестали толкать.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="skaters">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Папа и дочка на коньках стоят на льду ладонь к ладони и отталкиваются друг от друга. Оба разъезжаются в разные стороны, дочка вдвое быстрее папы">
			<rect class="ni-wall" x="0" y="0" width="360" height="150"></rect>
			<rect class="ni-boards" x="0" y="128" width="360" height="30"></rect>
			<line class="ni-boards-top" x1="0" y1="128" x2="360" y2="128"></line>
			<rect class="ni-ice" x="0" y="158" width="360" height="82"></rect>
			<line class="ni-ice-line" x1="0" y1="158" x2="360" y2="158"></line>
			<text class="ni-after" x="180" y="30" text-anchor="middle" data-after opacity="0">Сразу после толчка: дочка 1,0 м/с, папа 0,5 м/с</text>
			{
				[
					{ s: GIRL, key: 'girl', cls: 'ni-jacket-g' },
					{ s: DAD, key: 'dad', cls: 'ni-jacket-d' },
				].map(({ s, key, cls }) => (
					<g data-skater={key}>
						<g data-flip>
							<path class="ni-leg" d={s.legs} stroke-width={s.lw} />
							{s.boots.map((b) => (
								<rect class="ni-boot" x={b.x} y={b.y} width="11" height="9" rx="2" />
							))}
							<path class="ni-blade" d={s.blade} />
							<path class={`ni-torso ${cls}`} d={s.torso} stroke-width={s.tw} />
							<circle class="ni-skin" cx={s.head.cx} cy={s.head.cy} r={s.head.r} />
							<path class={key === 'girl' ? 'ni-hair' : `ni-hat`} d={s.extra} />
						</g>
					</g>
				))
			}
			<path class={`ni-arm ni-jacket-g`} data-arm="girl"></path>
			<path class={`ni-arm ni-jacket-d`} data-arm="dad"></path>
			<g data-forces opacity="0">
				<path class="ni-force" data-force="girl"></path>
				<path class="ni-force" data-force="dad"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Папа и дочка, которая вдвое легче его, оттолкнулись друг от друга на льду. Разъехались оба, причём дочка — вдвое быстрее: <More term="они толкнули друг друга с равными силами">Нельзя толкнуть другого и самому не получить толчок: тела всегда действуют друг на друга с равными по модулю силами. Но масса дочки вдвое меньше, и та же сила разгоняет её вдвое сильнее. Подробнее — в разделе <a href="#третий-закон-ньютона">«Третий закон Ньютона»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.ni-ice {
		fill: color-mix(in srgb, var(--ig-vx) 16%, var(--sl-color-bg));
	}
	.ni-ice-line {
		stroke: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-4));
		stroke-width: 1.2;
	}
	.ni-board {
		fill: var(--sl-color-gray-3);
	}
	.ni-asph {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 75%, var(--sl-color-bg));
	}
	.ni-speck {
		fill: var(--sl-color-gray-2);
		opacity: 0.45;
	}
	.intro .ni-tag {
		font-size: 13px;
		font-weight: 600;
		fill: var(--sl-color-gray-2);
	}
	.intro .ni-read {
		font-size: 13px;
		font-weight: 700;
		fill: var(--ig-v);
		font-variant-numeric: tabular-nums;
	}
	.ni-puck {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	:root[data-theme='light'] .ni-puck {
		fill: var(--sl-color-white);
	}
	.ni-puck-top {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ni-ghost {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		opacity: 0.55;
	}
	.ni-scale line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.intro .ni-scale text {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	/* skaters */
	.ni-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.ni-boards {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 80%, var(--sl-color-bg));
	}
	.ni-boards-top {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.ni-leg {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-linecap: round;
	}
	.ni-boot {
		fill: var(--sl-color-gray-1);
	}
	.ni-blade {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.ni-torso {
		fill: none;
		stroke-linecap: round;
	}
	.ni-arm {
		fill: none;
		stroke-width: 7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ni-jacket-g {
		stroke: color-mix(in srgb, var(--ig-v) 80%, var(--sl-color-gray-3));
	}
	.ni-jacket-d {
		stroke: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-gray-3));
	}
	.ni-skin {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-3));
	}
	.ni-hair {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-2));
		stroke-width: 3;
		stroke-linecap: round;
	}
	.ni-hat {
		fill: var(--ig-vy);
	}
	.ni-force {
		fill: var(--ig-vy);
		stroke: var(--sl-color-bg);
		stroke-width: 0.8;
	}
	.intro .ni-after {
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const G = 9.8;

	/** A filled arrow from (x1, y) to (x2, y). */
	const hArrow = (x1: number, x2: number, y: number) => {
		const s = Math.sign(x2 - x1);
		const hx = x2 - s * 9;
		return `M ${x1} ${y - 1.6} L ${hx} ${y - 1.6} L ${hx} ${y - 5} L ${x2} ${y} L ${hx} ${y + 5} L ${hx} ${y + 1.6} L ${x1} ${y + 1.6} Z`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-nzintro]')) {
		const PK = Number(root.dataset.pk);
		const PX0 = Number(root.dataset.px0);
		const FEET = Number(root.dataset.feet);

		// ---------- Puck: 4,4 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="puck"]')!;
			const V0 = 8;
			const lanes = [
				{ el: card.querySelector<SVGGElement>('[data-puck="ice"]')!, read: card.querySelector('[data-vice]')!, a: 0.05 * G, xMax: 30, y: 73 },
				{ el: card.querySelector<SVGGElement>('[data-puck="asph"]')!, read: card.querySelector('[data-vasph]')!, a: 0.5 * G, xMax: 30, y: 179 },
			];
			const ghosts = card.querySelector<SVGGElement>('[data-ghosts]')!;
			const RUN = 4.4;
			/** Position (m) and speed of a puck at time t: uniform deceleration a until it stops or reaches xMax. */
			const at = (a: number, xMax: number, t: number) => {
				const tStop = V0 / a;
				const tt = Math.min(t, tStop);
				let x = V0 * tt - (a * tt * tt) / 2;
				let v = V0 - a * tt;
				if (x >= xMax) {
					x = xMax;
					v = Math.sqrt(V0 * V0 - 2 * a * xMax);
				}
				return { x, v };
			};
			let shown = -1;
			scene(card, RUN, (q) => {
				const t = q * RUN;
				for (const l of lanes) {
					const { x, v } = at(l.a, l.xMax, t);
					l.el.setAttribute('transform', `translate(${(PX0 + x * PK).toFixed(2)} 0)`);
					l.read.textContent = `${v.toFixed(1).replace('.', ',')} м/с`;
				}
				const n = Math.floor(t / 0.25 + 1e-9);
				if (n !== shown) {
					ghosts.replaceChildren();
					for (let k = 1; k <= n; k++) {
						for (const l of lanes) {
							const { x } = at(l.a, l.xMax, k * 0.25);
							const prev = at(l.a, l.xMax, (k - 1) * 0.25).x;
							if (x - prev < 0.05) continue; // stopped: no new mark
							const c = document.createElementNS(NS, 'circle');
							c.setAttribute('class', 'ni-ghost');
							c.setAttribute('cx', (PX0 + x * PK).toFixed(2));
							c.setAttribute('cy', String(l.y));
							c.setAttribute('r', '7');
							ghosts.append(c);
						}
					}
					shown = n;
				}
			});
		}

		// ---------- Skaters: 3,2 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="skaters"]')!;
			const K = 60; // px per metre
			const F = 50; // N
			const TP = 0.8; // s of the push
			const AF = 0.005 * G; // friction of the skates
			const RUN = 3.2;
			const people = {
				girl: { m: 40, h: 84, x0: 186, dir: -1, armMin: 12, armMax: 28 },
				dad: { m: 80, h: 108, x0: 214, dir: 1 },
			};
			const els = {
				girl: card.querySelector<SVGGElement>('[data-skater="girl"]')!,
				dad: card.querySelector<SVGGElement>('[data-skater="dad"]')!,
			};
			// the father faces left
			els.dad.querySelector('[data-flip]')!.setAttribute('transform', 'scale(-1 1)');
			const arms = {
				girl: card.querySelector<SVGPathElement>('[data-arm="girl"]')!,
				dad: card.querySelector<SVGPathElement>('[data-arm="dad"]')!,
			};
			const forces = card.querySelector<SVGGElement>('[data-forces]')!;
			const fGirl = card.querySelector<SVGPathElement>('[data-force="girl"]')!;
			const fDad = card.querySelector<SVGPathElement>('[data-force="dad"]')!;
			const after = card.querySelector<SVGTextElement>('[data-after]')!;
			/** Distance (m) moved by a skater of mass m at time t: push with F for TP s, then gliding with friction. */
			const dist = (m: number, t: number) => {
				const a = F / m;
				if (t <= TP) return (a * t * t) / 2;
				const v = a * TP;
				const tg = Math.min(t - TP, v / AF);
				return (a * TP * TP) / 2 + v * tg - (AF * tg * tg) / 2;
			};
			const sepEnd = (dist(40, TP) + dist(80, TP)) * K;
			const ease = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
			scene(card, RUN, (q) => {
				const t = q * RUN;
				const pos = {
					girl: people.girl.x0 + people.girl.dir * dist(40, t) * K,
					dad: people.dad.x0 + people.dad.dir * dist(80, t) * K,
				};
				els.girl.setAttribute('transform', `translate(${pos.girl.toFixed(2)} ${FEET})`);
				els.dad.setAttribute('transform', `translate(${pos.dad.toFixed(2)} ${FEET})`);
				const sh = {
					girl: { x: pos.girl + 1.5, y: FEET - 0.77 * people.girl.h },
					dad: { x: pos.dad - 1.5, y: FEET - 0.77 * people.dad.h },
				};
				// during the push the palms stay together
				const frac = Math.min(1, ((dist(40, Math.min(t, TP)) + dist(80, Math.min(t, TP))) * K) / sepEnd);
				const armG = people.girl.armMin + (people.girl.armMax - people.girl.armMin) * frac;
				const cx = sh.girl.x + armG;
				const cy = (sh.girl.y + sh.dad.y) / 2;
				const relax = ease((t - TP) / 0.4);
				for (const key of ['girl', 'dad'] as const) {
					const s = sh[key];
					const d = key === 'girl' ? 1 : -1;
					const hx = cx + (s.x + d * 4 - cx) * relax;
					const hy = cy + (s.y + 0.3 * people[key].h - cy) * relax;
					const ex = (s.x + hx) / 2 - d * 2;
					const ey = Math.max(s.y, hy) + 5;
					arms[key].setAttribute('d', `M ${s.x.toFixed(1)} ${s.y.toFixed(1)} L ${ex.toFixed(1)} ${ey.toFixed(1)} L ${hx.toFixed(1)} ${hy.toFixed(1)}`);
				}
				const pushing = t > 0 && t < TP;
				forces.setAttribute('opacity', pushing ? '1' : '0');
				if (pushing) {
					fGirl.setAttribute('d', hArrow(cx - 1, cx - 44, cy - 18));
					fDad.setAttribute('d', hArrow(cx + 1, cx + 44, cy - 18));
				}
				after.setAttribute('opacity', t >= TP ? '1' : '0');
			});
		}
	}
</script>
