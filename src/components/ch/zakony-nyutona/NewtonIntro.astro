---
/**
 * Two short looping opening scenes of «Законы Ньютона». No terms of the chapter in the pictures; the captions'
 * popovers explain.
 *
 * Puck: a winter yard seen from above: a rink with boards and, beyond a snow bank, a cleared asphalt path. Two pucks
 *   start at 8 m/s, one on the ice, one on the asphalt (top view, 30 m of lane, 10,23 px per metre, real time).
 *   Friction slows them with a = μg: μ = 0,05 on ice (a = 0,49 m/s²: the puck crosses the 30 m in 4,32 s and still has
 *   5,9 m/s at the boards), μ = 0,5 on asphalt (a = 4,9 m/s²: it stops after 1,63 s and 6,5 m). Marks every 0,25 s.
 *   The pucks (7,6 см across) are drawn larger than to scale; ice markings, cracks and sand grains are decoration.
 *   The view stays a top view: only from above do both 30-m lanes fit with their marks, and at the 10 px per metre of
 *   a side view a person would be 16 px tall, too small for the people kit's detail, so no player is drawn.
 * Skaters: a father (180 см, 80 kg, adult of about 7½ heads) and his daughter (140 см, 40 kg, a child of about 6
 *   heads) stand on skates palm to palm and push each other apart with 100 N for 0,4 s (side view, 60 px per metre =
 *   0,6 px per см, real time; people of the shared kit, true scale). Equal and opposite forces: she gets 2,5 m/s², he
 *   1,25 m/s², so right after the push she has 1,0 m/s and he 0,5 m/s; during the push the gap between them grows by
 *   0,3 m (0,2 m + 0,1 m), which their arms cover as they straighten (bones of fixed length). (Until 21 Nov 2026 the
 *   push was 50 N for 0,8 s: the same speeds, but a stroke of 0,6 m, longer than the arms of the kit's people allow
 *   from a natural stance; the speeds and the caption are unchanged.) Then the skates'
 *   friction (μ = 0,005, a = 0,049 m/s²) slows both a little during the 2,8 s of gliding: in all she slides 2,81 m, he
 *   1,31 m. The blades leave scratches; the ice shows faint reflections. Two skaters far behind glide at about 2 m/s
 *   (drawn at 0,3 px per см: they are about twice as far from the viewer).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const rnd = (i: number, k: number) => {
	const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
	return r - Math.floor(r);
};
/** A bumpy snow bank between y0 (top of the lowest bumps) and y1, across the picture. */
const bank = (y0: number, y1: number, seed: number, up = true) => {
	let d = `M 0 ${up ? y1 : y0}`;
	for (let x = 0; x <= 360; x += 18) {
		const h = (y1 - y0) * (0.45 + 0.55 * rnd(x, seed));
		const y = up ? y1 - h : y0 + h;
		d += ` Q ${x + 9} ${y.toFixed(1)} ${x + 18} ${up ? y1 - h * 0.6 : y0 + h * 0.6}`;
	}
	return `${d} L 360 ${up ? y1 : y0} Z`;
};

// ---------- Puck scene
const PK = 307 / 30; // px per metre
const PX0 = 24; // start of the pucks' centers
const ICE = { y0: 34, y1: 112 };
const ASPH = { y0: 142, y1: 216 };
const specks = Array.from({ length: 110 }, (_, i) => ({
	x: 3 + rnd(i, 1) * 354,
	y: ASPH.y0 + 3 + rnd(i, 2) * (ASPH.y1 - ASPH.y0 - 6),
	r: 0.5 + rnd(i, 3) * 0.9,
	k: rnd(i, 4) > 0.82 ? 'ni-sand' : rnd(i, 4) > 0.45 ? 'ni-speck ni-speck--l' : 'ni-speck',
}));
const cracks = ['M 128 142 L 134 156 L 131 168 L 140 181 L 138 192', 'M 250 216 L 246 204 L 252 194 L 249 184', 'M 60 216 L 66 208 L 64 200', 'M 300 142 L 296 150 L 302 158'];
const scratches = ['M 40 50 Q 120 44 190 60', 'M 70 96 Q 150 104 240 90', 'M 150 80 Q 220 70 300 84', 'M 10 64 Q 60 70 100 62', 'M 200 46 Q 260 52 330 44'];

// ---------- Skaters scene
const FEET = 222; // the line where the near blades touch the ice
const seats = Array.from({ length: 4 }, (_, row) => Array.from({ length: 34 }, (_, i) => ({ x: 3 + i * 10.6 + (row % 2) * 5, y: 40 + row * 12, c: Math.floor(i / 9) % 2 }))).flat();
const posts = [0, 72, 144, 216, 288, 360];
---

<PeopleStyles />
<IntroFrame data-nzintro data-pk={PK} data-px0={PX0} data-feet={FEET}>
	<div class="intro__card" data-scene="puck">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимний двор сверху: каток и расчищенная асфальтовая дорожка. Две одинаковые шайбы пускают с одной и той же скоростью: одну по льду, другую по асфальту. Шайба на льду проскальзывает через всю площадку до бортика, а шайба на асфальте останавливается через несколько метров">
			<defs>
				<radialGradient id={`ni-glare-${uid}`}>
					<stop offset="0" class="ni-glare-in"></stop>
					<stop offset="1" class="ni-glare-out"></stop>
				</radialGradient>
				<clipPath id={`ni-iceclip-${uid}`}><rect x="0" y={ICE.y0} width="338" height={ICE.y1 - ICE.y0}></rect></clipPath>
			</defs>
			<rect class="ni-ground" x="0" y="0" width="360" height="240"></rect>
			<path class="ni-snow" d={bank(20, 28, 1)}></path>
			<path class="ni-snow" d={bank(118, 128, 2, false)}></path>
			<path class="ni-snow" d={bank(216, 225, 3, false)}></path>
			<!-- the rink: ice, markings, boards -->
			<rect class="ni-ice" x="0" y={ICE.y0} width="338" height={ICE.y1 - ICE.y0}></rect>
			<g clip-path={`url(#ni-iceclip-${uid})`}>
				<ellipse cx="96" cy="58" rx="60" ry="22" fill={`url(#ni-glare-${uid})`}></ellipse>
				<ellipse cx="250" cy="90" rx="70" ry="24" fill={`url(#ni-glare-${uid})`}></ellipse>
				<rect class="ni-line-red" x="126" y={ICE.y0} width="3" height={ICE.y1 - ICE.y0}></rect>
				<rect class="ni-line-blue" x="226" y={ICE.y0} width="3.2" height={ICE.y1 - ICE.y0}></rect>
				<circle class="ni-circle" cx="290" cy={ICE.y1 + 4} r="40"></circle>
				<circle class="ni-spot" cx="290" cy={ICE.y1 - 14} r="2.2"></circle>
				{scratches.map((d) => <path class="ni-scratch" d={d} />)}
			</g>
			<rect class="ni-board" x="0" y={ICE.y0 - 6} width="348" height="6"></rect>
			<rect class="ni-board" x="0" y={ICE.y1} width="348" height="6"></rect>
			<rect class="ni-board" x="338" y={ICE.y0 - 6} width="10" height={ICE.y1 - ICE.y0 + 12} rx="1.5"></rect>
			<rect class="ni-kick" x="0" y={ICE.y0 - 1.6} width="338" height="1.6"></rect>
			<rect class="ni-kick" x="0" y={ICE.y1} width="338" height="1.6"></rect>
			<rect class="ni-kick" x="336.4" y={ICE.y0} width="1.6" height={ICE.y1 - ICE.y0}></rect>
			<!-- the cleared path: asphalt with specks, sand grains and cracks -->
			<rect class="ni-asph" x="0" y={ASPH.y0} width="360" height={ASPH.y1 - ASPH.y0}></rect>
			{specks.map((s) => <circle class={s.k} cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} />)}
			{cracks.map((d) => <path class="ni-crack" d={d} />)}
			<text class="ni-tag" x="8" y="15">лёд</text>
			<text class="ni-tag" x="8" y={ASPH.y0 - 5}>асфальт</text>
			<text class="ni-read" x="330" y="15" text-anchor="end" data-vice>8,0 м/с</text>
			<text class="ni-read" x="330" y={ASPH.y0 - 5} text-anchor="end" data-vasph>8,0 м/с</text>
			<g data-ghosts></g>
			{
				[
					{ key: 'ice', y: (ICE.y0 + ICE.y1) / 2 },
					{ key: 'asph', y: (ASPH.y0 + ASPH.y1) / 2 },
				].map((p) => (
					<g data-puck={p.key}>
						<ellipse class="ni-shadow" cx="1.5" cy={p.y + 2} rx="7.6" ry="7"></ellipse>
						<circle class="ni-puck" r="7" cy={p.y}></circle>
						<circle class="ni-puck-top" r="4.2" cy={p.y}></circle>
						<path class="ni-puck-hi" d={`M -4.4 ${p.y - 3} A 5.4 5.4 0 0 1 1 ${p.y - 5.3}`}></path>
					</g>
				))
			}
			<g class="ni-scale">
				<line x1={PX0} y1="233" x2={PX0 + 10 * PK} y2="233"></line>
				<line x1={PX0} y1="229" x2={PX0} y2="237"></line>
				<line x1={PX0 + 10 * PK} y1="229" x2={PX0 + 10 * PK} y2="237"></line>
				<text x={PX0 + 10 * PK + 6} y="237">10 м</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Шайба, пущенная по льду, проскальзывает через всю площадку, а пущенная с той же скоростью по асфальту останавливается через несколько метров. <More term="Шайбу останавливает трение">На льду трение очень мало, и шайба теряет скорость медленно. На асфальте трение примерно в 10 раз больше. Если бы трения не было совсем, шайба скользила бы, совсем не замедляясь. Это явление называют инерцией. Подробнее — в разделе <a href="#первый-закон-ньютона">«Первый закон Ньютона»</a>.</More>, а не то, что её перестали толкать.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="skaters">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Папа и дочка на коньках стоят на льду крытого катка ладонь к ладони и отталкиваются друг от друга. Оба разъезжаются в разные стороны, дочка вдвое быстрее папы. Вдали катаются другие люди">
			<defs>
				<clipPath id={`ni-rinkclip-${uid}`}><rect x="0" y="158" width="360" height="82"></rect></clipPath>
				<linearGradient id={`ni-icegrad-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="ni-ice2-far"></stop>
					<stop offset="1" class="ni-ice2-near"></stop>
				</linearGradient>
			</defs>
			<!-- the hall: roof with lamps, stands with seats -->
			<rect class="ni-hall" x="0" y="0" width="360" height="160"></rect>
			{[45, 135, 225, 315].map((x) => <path class="ni-beam" d={`M${x - 10} 8 L${x - 34} 92 H${x + 34} L${x + 10} 8 Z`} />)}
			{[45, 135, 225, 315].map((x) => <rect class="ni-lamp" x={x - 14} y="3" width="28" height="5" rx="2" />)}
			<rect class="ni-stand" x="0" y="34" width="360" height="60"></rect>
			{seats.map((s) => <rect class={s.c ? 'ni-seat ni-seat--b' : 'ni-seat'} x={s.x.toFixed(1)} y={s.y} width="7" height="5" rx="1.5" />)}
			<!-- glass above the boards -->
			<rect class="ni-glass" x="0" y="94" width="360" height="34"></rect>
			{posts.map((x) => <rect class="ni-post" x={x - 1} y="94" width="2" height="34" />)}
			<!-- the boards with plain panels -->
			<rect class="ni-boards" x="0" y="128" width="360" height="30"></rect>
			<rect class="ni-panel ni-panel--a" x="14" y="133" width="78" height="15" rx="2"></rect>
			<path class="ni-panel-mark" d="M 30 140.5 h 10 M 35 135.5 v 10 M 31.5 137 l 7 7 M 38.5 137 l -7 7"></path>
			<rect class="ni-panel-bar" x="46" y="138" width="38" height="2.4" rx="1"></rect>
			<rect class="ni-panel-bar" x="46" y="142" width="26" height="2.4" rx="1"></rect>
			<rect class="ni-panel ni-panel--b" x="140" y="133" width="78" height="15" rx="2"></rect>
			<path class="ni-panel-wave" d="M 148 143 q 6 -6 12 0 t 12 0 t 12 0 t 12 0 t 12 0"></path>
			<rect class="ni-panel ni-panel--c" x="266" y="133" width="78" height="15" rx="2"></rect>
			<circle class="ni-panel-dot" cx="280" cy="140.5" r="4"></circle>
			<rect class="ni-panel-bar" x="290" y="138" width="44" height="2.4" rx="1"></rect>
			<rect class="ni-panel-bar" x="290" y="142" width="30" height="2.4" rx="1"></rect>
			<rect class="ni-kick2" x="0" y="152" width="360" height="6"></rect>
			<line class="ni-boards-top" x1="0" y1="128" x2="360" y2="128"></line>
			<!-- the ice: markings, scratches, reflections -->
			<rect fill={`url(#ni-icegrad-${uid})`} x="0" y="158" width="360" height="82"></rect>
			<path class="ni-blue-band" d="M 52 158 H 60 L 50 240 H 38 Z"></path>
			<ellipse class="ni-ring" cx="300" cy="206" rx="70" ry="20"></ellipse>
			<circle class="ni-ring-dot" cx="300" cy="206" r="2.4"></circle>
			<path class="ni-old-scr" d="M 0 176 Q 90 170 200 182 T 360 174 M 20 236 Q 140 226 260 236 M 90 196 Q 170 188 250 199"></path>
			<g class="ni-far-people">
				<g data-far="a" class="ni-far-a"></g>
				<g data-far="b" class="ni-far-b"></g>
			</g>
			<path class="ni-scr" data-scr="g0"></path>
			<path class="ni-scr" data-scr="g1"></path>
			<path class="ni-scr" data-scr="d0"></path>
			<path class="ni-scr" data-scr="d1"></path>
			<g clip-path={`url(#ni-rinkclip-${uid})`}>
				<use href={`#ni-people-${uid}`} class="ni-reflect" transform={`translate(0 ${2 * FEET}) scale(1 -1)`}></use>
			</g>
			<g id={`ni-people-${uid}`}>
				<g data-girl class="ni-girl"></g>
				<g data-dad class="ni-dad"></g>
			</g>
			<g data-after opacity="0">
				<rect class="ni-after-bg" x="34" y="15" width="292" height="22" rx="11"></rect>
				<text class="ni-after" x="180" y="30.5" text-anchor="middle">Сразу после толчка: дочка 1,0 м/с, папа 0,5 м/с</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Папа и дочка, которая вдвое легче его, оттолкнулись друг от друга на льду. Разъехались оба, причём дочка — вдвое быстрее: <More term="они толкнули друг друга с равными силами">Нельзя толкнуть другого и самому не получить толчок: тела всегда действуют друг на друга с равными по модулю силами. Но масса дочки вдвое меньше, и та же сила разгоняет её вдвое сильнее. Это третий закон Ньютона. Подробнее — в разделе <a href="#третий-закон-ньютона">«Третий закон Ньютона»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-nzintro] {
		--ni-ice: hsl(205, 45%, 86%);
		--ni-ice-far: hsl(205, 40%, 78%);
		--ni-ice-line: hsl(205, 35%, 68%);
		--ni-red: hsl(355, 70%, 58%);
		--ni-blue: hsl(212, 75%, 55%);
		--ni-board: hsl(210, 20%, 94%);
		--ni-kick: hsl(45, 85%, 55%);
		--ni-snow: hsl(212, 30%, 82%);
		--ni-snow-edge: hsl(212, 25%, 66%);
		--ni-asph: hsl(220, 8%, 34%);
		--ni-asph-d: hsl(220, 10%, 22%);
		--ni-asph-l: hsl(220, 6%, 50%);
		--ni-sand: hsl(32, 45%, 55%);
		--ni-mark: hsl(0, 0%, 96%);
		--ni-ground: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-bg));
		--ni-hall: hsl(222, 30%, 13%);
		--ni-beam: hsl(48, 90%, 85%);
		--ni-stand: hsl(222, 22%, 20%);
		--ni-seat: hsl(212, 55%, 42%);
		--ni-seat-b: hsl(355, 45%, 45%);
		--ni-glass: hsl(200, 40%, 80%);
		--ni-puck: hsl(220, 15%, 10%);
		--ni-ink: hsl(222, 35%, 14%);
	}
	:root[data-theme='light'] [data-nzintro] {
		--ni-ice: hsl(205, 55%, 93%);
		--ni-ice-far: hsl(205, 45%, 86%);
		--ni-snow: hsl(210, 45%, 97%);
		--ni-snow-edge: hsl(212, 30%, 80%);
		--ni-asph: hsl(220, 6%, 50%);
		--ni-asph-d: hsl(220, 8%, 34%);
		--ni-asph-l: hsl(220, 6%, 66%);
		--ni-hall: hsl(215, 30%, 86%);
		--ni-beam: hsl(48, 100%, 97%);
		--ni-stand: hsl(215, 22%, 76%);
		--ni-seat: hsl(212, 55%, 55%);
		--ni-seat-b: hsl(355, 55%, 62%);
		--ni-ink: hsl(222, 30%, 22%);
	}
	/* puck scene */
	.ni-ground {
		fill: var(--ni-ground);
	}
	.ni-snow {
		fill: var(--ni-snow);
		stroke: var(--ni-snow-edge);
		stroke-width: 0.8;
	}
	.ni-ice {
		fill: var(--ni-ice);
	}
	.ni-glare-in {
		stop-color: white;
		stop-opacity: 0.55;
	}
	.ni-glare-out {
		stop-color: white;
		stop-opacity: 0;
	}
	.ni-line-red,
	.ni-spot {
		fill: var(--ni-red);
		opacity: 0.75;
	}
	.ni-line-blue {
		fill: var(--ni-blue);
		opacity: 0.75;
	}
	.ni-circle {
		fill: none;
		stroke: var(--ni-red);
		stroke-width: 1.4;
		opacity: 0.6;
	}
	.ni-scratch {
		fill: none;
		stroke: var(--ni-ice-line);
		stroke-width: 0.6;
		opacity: 0.8;
	}
	.ni-board {
		fill: var(--ni-board);
		stroke: var(--ni-ink);
		stroke-width: 0.6;
	}
	.ni-kick {
		fill: var(--ni-kick);
	}
	.ni-asph {
		fill: var(--ni-asph);
	}
	.ni-speck {
		fill: var(--ni-asph-d);
	}
	.ni-speck--l {
		fill: var(--ni-asph-l);
	}
	.ni-sand {
		fill: var(--ni-sand);
	}
	.ni-crack {
		fill: none;
		stroke: var(--ni-asph-d);
		stroke-width: 1.1;
		stroke-linejoin: round;
	}
	.intro .ni-tag {
		font-size: 13px;
		font-weight: 600;
		fill: var(--sl-color-gray-2);
	}
	.intro .ni-read {
		font-size: 13px;
		font-weight: 700;
		fill: var(--ig-v);
		font-variant-numeric: tabular-nums;
	}
	.ni-shadow {
		fill: black;
		opacity: 0.25;
	}
	.ni-puck {
		fill: var(--ni-puck);
		stroke: hsl(220, 10%, 40%);
		stroke-width: 1.2;
	}
	.ni-puck-top {
		fill: none;
		stroke: hsl(220, 10%, 30%);
		stroke-width: 0.9;
	}
	.ni-puck-hi {
		fill: none;
		stroke: hsl(220, 10%, 70%);
		stroke-width: 0.9;
		stroke-linecap: round;
	}
	.ni-ghost {
		fill: none;
		stroke: var(--ni-ink);
		stroke-width: 1;
		opacity: 0.45;
	}
	.ni-ghost--a {
		stroke: var(--ni-mark);
		opacity: 0.65;
	}
	.ni-scale line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.intro .ni-scale text {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	/* skaters scene */
	.ni-hall {
		fill: var(--ni-hall);
	}
	.ni-beam {
		fill: var(--ni-beam);
		opacity: 0.12;
	}
	.ni-lamp {
		fill: var(--ni-beam);
	}
	.ni-stand {
		fill: var(--ni-stand);
	}
	.ni-seat {
		fill: var(--ni-seat);
	}
	.ni-seat--b {
		fill: var(--ni-seat-b);
	}
	.ni-glass {
		fill: var(--ni-glass);
		opacity: 0.22;
	}
	.ni-post {
		fill: var(--ni-glass);
		opacity: 0.55;
	}
	.ni-boards {
		fill: var(--ni-board);
	}
	.ni-boards-top {
		stroke: var(--ni-ink);
		stroke-width: 1.4;
	}
	.ni-kick2 {
		fill: var(--ni-kick);
	}
	.ni-panel--a {
		fill: hsl(205, 70%, 52%);
	}
	.ni-panel--b {
		fill: hsl(150, 45%, 45%);
	}
	.ni-panel--c {
		fill: hsl(15, 75%, 58%);
	}
	.ni-panel-mark,
	.ni-panel-wave {
		fill: none;
		stroke: white;
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.ni-panel-bar,
	.ni-panel-dot {
		fill: white;
		opacity: 0.9;
	}
	.ni-ice2-far {
		stop-color: var(--ni-ice-far);
	}
	.ni-ice2-near {
		stop-color: var(--ni-ice);
	}
	.ni-blue-band {
		fill: var(--ni-blue);
		opacity: 0.6;
	}
	.ni-ring {
		fill: none;
		stroke: var(--ni-red);
		stroke-width: 1.3;
		opacity: 0.55;
	}
	.ni-ring-dot {
		fill: var(--ni-red);
		opacity: 0.6;
	}
	.ni-old-scr {
		fill: none;
		stroke: var(--ni-ice-line);
		stroke-width: 0.6;
		opacity: 0.6;
	}
	.ni-scr {
		fill: none;
		stroke: hsl(205, 30%, 60%);
		stroke-width: 0.9;
		stroke-linecap: round;
	}
	.ni-reflect {
		opacity: 0.16;
	}
	.ni-far-people {
		opacity: 0.8;
	}
	.ni-dad {
		--hm-wool: hsl(212, 30%, 40%);
		--hm-scarf: hsl(45, 85%, 55%);
	}
	.ni-girl {
		--hm-scarf: hsl(330, 60%, 70%);
	}
	.ni-far-b {
		--hm-wool: hsl(355, 55%, 55%);
	}
	.pkw-coat.ni-coat-g,
	.pkw-sleeve.ni-coat-g {
		fill: hsl(285, 45%, 60%);
		stroke: hsl(285, 45%, 60%);
	}
	.pkw-coat.ni-coat-d,
	.pkw-sleeve.ni-coat-d {
		fill: hsl(150, 40%, 42%);
		stroke: hsl(150, 40%, 42%);
	}
	.pkw-coat.ni-coat-a,
	.pkw-sleeve.ni-coat-a {
		fill: hsl(25, 60%, 55%);
		stroke: hsl(25, 60%, 55%);
	}
	.pkw-coat.ni-coat-b,
	.pkw-sleeve.ni-coat-b {
		fill: hsl(195, 45%, 50%);
		stroke: hsl(195, 45%, 50%);
	}
	.pkw-coat:is(.ni-coat-g, .ni-coat-d, .ni-coat-a, .ni-coat-b) {
		stroke: var(--hm-line);
	}
	.pkw-sleeve:is(.ni-coat-g, .ni-coat-d, .ni-coat-a, .ni-coat-b) {
		fill: none;
	}
	.ni-after-bg {
		fill: var(--ig-surface);
		opacity: 0.9;
	}
	.intro .ni-after {
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, type FigurePose, type HandTarget } from '@components/people/body';
	import { reach } from '@components/people/motion';
	import { SKELETON, type Pt } from '@components/people/core';

	const NS = 'http://www.w3.org/2000/svg';
	const G = 9.8;
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-nzintro]')) {
		const PK = Number(root.dataset.pk);
		const PX0 = Number(root.dataset.px0);
		const FEET = Number(root.dataset.feet);

		// ---------- Puck: 4,4 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="puck"]')!;
			const V0 = 8;
			const lanes = [
				{ el: card.querySelector<SVGGElement>('[data-puck="ice"]')!, read: card.querySelector('[data-vice]')!, a: 0.05 * G, xMax: 30, y: 73, cls: 'ni-ghost' },
				{ el: card.querySelector<SVGGElement>('[data-puck="asph"]')!, read: card.querySelector('[data-vasph]')!, a: 0.5 * G, xMax: 30, y: 179, cls: 'ni-ghost ni-ghost--a' },
			];
			const ghosts = card.querySelector<SVGGElement>('[data-ghosts]')!;
			const RUN = 4.4;
			/** Position (m) and speed of a puck at time t: uniform deceleration a until it stops or reaches xMax. */
			const at = (a: number, xMax: number, t: number) => {
				const tStop = V0 / a;
				const tt = Math.min(t, tStop);
				let x = V0 * tt - (a * tt * tt) / 2;
				let v = V0 - a * tt;
				if (x >= xMax) {
					x = xMax;
					v = Math.sqrt(V0 * V0 - 2 * a * xMax);
				}
				return { x, v };
			};
			let shown = -1;
			scene(card, RUN, (q) => {
				const t = q * RUN;
				for (const l of lanes) {
					const { x, v } = at(l.a, l.xMax, t);
					l.el.setAttribute('transform', `translate(${(PX0 + x * PK).toFixed(2)} 0)`);
					l.read.textContent = `${v.toFixed(1).replace('.', ',')} м/с`;
				}
				const n = Math.floor(t / 0.25 + 1e-9);
				if (n !== shown) {
					ghosts.replaceChildren();
					for (let k = 1; k <= n; k++) {
						for (const l of lanes) {
							const { x } = at(l.a, l.xMax, k * 0.25);
							const prev = at(l.a, l.xMax, (k - 1) * 0.25).x;
							if (x - prev < 0.05) continue; // stopped: no new mark
							const c = document.createElementNS(NS, 'circle');
							c.setAttribute('class', l.cls);
							c.setAttribute('cx', (PX0 + x * PK).toFixed(2));
							c.setAttribute('cy', String(l.y));
							c.setAttribute('r', '7');
							ghosts.append(c);
						}
					}
					shown = n;
				}
			});
		}

		// ---------- Skaters: 3,2 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="skaters"]')!;
			const S = 0.6; // px per см
			const K = 60; // px per metre
			const F = 100; // N
			const TP = 0.4; // s of the push
			const AF = 0.005 * G; // friction of the skates
			const RUN = 3.2;
			const BLADE = 15.5 * S; // ankle above the bottom of the blade
			const DEPTH = 3; // the far blade stands this much higher on the picture (it is farther away)
			const girl = figure(card.querySelector<SVGGElement>('[data-girl]')!, { s: S, H: 140, age: 'child', girth: 0.95, clothes: 'winter', gear: 'skate', shirt: 'ni-coat-g', hair: 'pony', name: 'daughter' });
			const dad = figure(card.querySelector<SVGGElement>('[data-dad]')!, { s: S, H: 180, girth: 1.1, clothes: 'winter', gear: 'skate', shirt: 'ni-coat-d', dir: -1, name: 'father' });
			type Who = { fig: typeof girl; u: number; sk: (typeof SKELETON)['adult']; d: 1 | -1; s: number };
			const P: Record<'girl' | 'dad', Who> = {
				girl: { fig: girl, u: 140 * S, sk: SKELETON.child, d: 1, s: S },
				dad: { fig: dad, u: 180 * S, sk: SKELETON.adult, d: -1, s: S },
			};
			const LEAN = 0.17; // lean into the push
			/** Distance (m) moved by a skater of mass m at time t: push with F for TP s, then gliding with friction. */
			const dist = (m: number, t: number) => {
				const a = F / m;
				if (t <= TP) return (a * t * t) / 2;
				const v = a * TP;
				const tg = Math.min(t - TP, v / AF);
				return (a * TP * TP) / 2 + v * tg - (AF * tg * tg) / 2;
			};
			const hipAt = (p: Who, x: number, bend: number, feet = FEET): Pt => ({ x, y: feet - 15.5 * p.s - (p.sk.thigh + p.sk.shin) * p.u * bend });
			const ankles = (p: Who, x: number, feet = FEET): [Pt, Pt] => [
				{ x: x + p.d * 0.06 * p.u, y: feet - 15.5 * p.s },
				{ x: x - p.d * 0.07 * p.u, y: feet - 15.5 * p.s - DEPTH * (p.s / S) },
			];
			// reach of an arm to the middle of the flat palm
			const R = (p: Who) => p.fig.bones.upper + p.fig.bones.fore + 0.45 * p.fig.bones.hand;
			const Rg = R(P.girl);
			const Rd = R(P.dad);
			// the near shoulder joint relative to the hip joint while leaning into the push
			const off = (p: Who) => {
				const h = hipAt(p, 0, 0.965);
				const s = p.fig.shoulders(h, LEAN)[0];
				return { x: s.x - h.x, y: s.y - h.y, hy: h.y };
			};
			const offG = off(P.girl);
			const offD = off(P.dad);
			const dy = offD.hy + offD.y - (offG.hy + offG.y);
			// hip gap at the end of the push: the arms are 93,5 % straight; at the start it is 0,3 m (18 px) less
			const span1 = Math.sqrt(Math.max(0, (0.935 * (Rg + Rd)) ** 2 - dy * dy));
			const gap1 = span1 - (offD.x - offG.x);
			const gap0 = gap1 - (dist(40, TP) + dist(80, TP)) * K;
			const XG0 = 196;
			const XD0 = XG0 + gap0;
			/** Where the palms meet: shared in proportion to the arms' reach, at the height halfway between the shoulders. */
			const contact = (xg: number, xd: number): Pt => {
				const sg = { x: xg + offG.x, y: offG.hy + offG.y };
				const sd = { x: xd + offD.x, y: offD.hy + offD.y };
				const k = Rg / (Rg + Rd);
				return { x: sg.x + (sd.x - sg.x) * k, y: (sg.y + sd.y) / 2 + 2 };
			};
			// a flat palm, fingers up and tipped a little toward the other person
			// roll −0,8: the back of the mitten turned toward the viewer, so the two hands read as hands, palm to palm
			const flat = (p: Who, at: Pt, touch: boolean): HandTarget => ({ at, pose: 'flat', dir: -Math.PI / 2 + p.d * 0.3, roll: -0.8, contact: touch ? 'palm of the other' : undefined });
			const pushPose = (p: Who, x: number, c: Pt, touch: boolean): FigurePose => ({
				hip: hipAt(p, x, 0.965),
				lean: LEAN,
				ankles: ankles(p, x),
				feet: [0, 0],
				hands: [flat(p, { x: c.x - p.d * 1.6, y: c.y + 2 }, touch), flat(p, { x: c.x - p.d * 1.6, y: c.y - 2 }, touch)],
			});
			const glidePose = (p: Who, x: number): FigurePose => {
				const h = hipAt(p, x, 0.985);
				return {
					hip: h,
					lean: 0.03,
					ankles: ankles(p, x),
					feet: [0, 0],
					hands: [
						{ at: { x: x + p.d * 0.08 * p.u, y: h.y + 0.03 * p.u }, pose: 'relaxed' },
						{ at: { x: x - p.d * 0.05 * p.u, y: h.y + 0.04 * p.u }, pose: 'relaxed' },
					],
				};
			};
			const xg1 = XG0 - dist(40, TP) * K;
			const xd1 = XD0 + dist(80, TP) * K;
			const cEnd = contact(xg1, xd1);
			// the arms at the end of the push, by angles (upper arm screen angle, elbow bend), to ease them down from there
			const armsAt = (st: { shoulders: [Pt, Pt]; elbows: [Pt, Pt]; wrists: [Pt, Pt] }): [[number, number], [number, number]] =>
				[0, 1].map((i) => {
					const a = Math.atan2(st.elbows[i].y - st.shoulders[i].y, st.elbows[i].x - st.shoulders[i].x);
					const b = Math.atan2(st.wrists[i].y - st.elbows[i].y, st.wrists[i].x - st.elbows[i].x);
					return [a, Math.abs(Math.atan2(Math.sin(b - a), Math.cos(b - a)))];
				}) as [[number, number], [number, number]];
			const armsG = armsAt(girl.pose(pushPose(P.girl, xg1, cEnd, true)));
			const armsD = armsAt(dad.pose(pushPose(P.dad, xd1, cEnd, true)));
			/** The pose at the end of the push carried along to x, the arms given by their angles. */
			const carried = (p: Who, x: number, arms: [[number, number], [number, number]]): FigurePose => ({
				...pushPose(p, x, cEnd, false),
				hands: [
					{ arm: arms[0], pose: 'flat' },
					{ arm: arms[1], pose: 'flat' },
				],
			});
			/** Gliding: the arms hang a little away from the body, the near one slightly forward. */
			const glideArms = (p: Who, x: number): FigurePose => ({
				...glidePose(p, x),
				hands: [
					{ arm: [Math.PI / 2 - p.d * 0.22, 0.4], pose: 'relaxed' },
					{ arm: [Math.PI / 2 + p.d * 0.12, 0.3], pose: 'relaxed' },
				],
			});

			// two skaters far behind (about twice as far: 0,3 px per см), gliding with one foot behind
			const SF = 0.3;
			const FAR_FEET = 176;
			const far = [
				{ fig: figure(card.querySelector<SVGGElement>('[data-far="a"]')!, { s: SF, H: 172, clothes: 'winter', gear: 'skate', shirt: 'ni-coat-a', name: 'far skater a' }), x0: 40, v: 2.1, d: 1 as const, u: 172 * SF },
				{ fig: figure(card.querySelector<SVGGElement>('[data-far="b"]')!, { s: SF, H: 160, clothes: 'winter', gear: 'skate', shirt: 'ni-coat-b', hair: 'pony', dir: -1, name: 'far skater b' }), x0: 330, v: 1.8, d: -1 as const, u: 160 * SF },
			];
			const farPose = (f: (typeof far)[number], t: number): FigurePose => {
				const x = f.x0 + f.d * f.v * t * 30; // 30 px per metre at that distance
				const ank = FAR_FEET - 15.5 * SF;
				const legs = (SKELETON.adult.thigh + SKELETON.adult.shin) * f.u;
				const h = { x, y: ank - legs * 0.95 };
				return {
					hip: h,
					lean: 0.22,
					ankles: [
						{ x: x + f.d * 0.04 * f.u, y: ank },
						{ x: x - f.d * 0.3 * f.u, y: ank - 0.07 * f.u },
					],
					feet: [0, 0.25],
					hands: [
						{ at: { x: x + f.d * 0.1 * f.u, y: h.y + 0.02 * f.u }, pose: 'relaxed' },
						{ at: { x: x - f.d * 0.08 * f.u, y: h.y + 0.03 * f.u }, pose: 'relaxed' },
					],
				};
			};

			const after = card.querySelector<SVGGElement>('[data-after]')!;
			const scr = (k: string) => card.querySelector<SVGPathElement>(`[data-scr="${k}"]`)!;
			const scrs = { g0: scr('g0'), g1: scr('g1'), d0: scr('d0'), d1: scr('d1') };
			scene(card, RUN, (q) => {
				const t = q * RUN;
				for (const f of far) f.fig.pose(farPose(f, t));
				const xg = XG0 - dist(40, t) * K;
				const xd = XD0 + dist(80, t) * K;
				if (t < TP) {
					const c = contact(xg, xd);
					girl.pose(pushPose(P.girl, xg, c, true));
					dad.pose(pushPose(P.dad, xd, c, true));
				} else {
					// the palms part; the arms ease down within 0,5 s while the body straightens
					const e = (t - TP) / 0.5;
					girl.pose(reach(carried(P.girl, xg, armsG), glideArms(P.girl, xg), e));
					dad.pose(reach(carried(P.dad, xd, armsD), glideArms(P.dad, xd), e));
				}
				// scratches behind the blades
				const line = (k: keyof typeof scrs, x0: number, x: number, y: number) => scrs[k].setAttribute('d', Math.abs(x - x0) > 1 ? `M${f1(x0)} ${f1(y)} H${f1(x)}` : '');
				line('g0', XG0 + 0.06 * P.girl.u, xg + 0.06 * P.girl.u, FEET + 0.4);
				line('g1', XG0 - 0.07 * P.girl.u, xg - 0.07 * P.girl.u, FEET - DEPTH + 0.4);
				line('d0', XD0 - 0.06 * P.dad.u, xd - 0.06 * P.dad.u, FEET + 0.4);
				line('d1', XD0 + 0.07 * P.dad.u, xd + 0.07 * P.dad.u, FEET - DEPTH + 0.4);
				after.setAttribute('opacity', t >= TP ? '1' : '0');
			});
		}
	}
</script>
