---
/**
 * Small pictures to «Где это встречается»: the seat belt (the car brakes, the belt pulls the passenger back), an empty
 * and a loaded truck with the same resultant force (the loaded one, twice as heavy, gets half the acceleration), a step
 * (the foot pushes the ground back, the ground pushes the foot forward) and two boats pulled together by one rope
 * (equal forces on both boats). Text stays in the captions so that the pictures read at 390 px in two columns.
 * People by the shared kit (src/components/people/): a seated passenger (170 см at 0,75 px per см) leaning forward with
 * his palms on his thighs; a walker (170 см at 0,62 px per см) pushing off with the toe of the back foot; a man (175 см
 * at 0,48 px per см) standing on the bottom of the left boat (his feet hidden by its near side) and pulling the rope hand over hand (both fists round the rope, the rope
 * drawn through their grip points). The arrows of the step start where the toe touches the ground.
 */
import NzPicStyles from './NzPicStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import { arrow, over } from './pic';

// Seat belt
const beltF = arrow(107, 80, 68, 80, 9); // on the passenger: the tail at his chest, pointing back
const carV = arrow(40, 24, 96, 24, 9);
const carA = arrow(200, 24, 158, 24, 9);
// Trucks: the same resultant force, a and a/2
const truckF = [arrow(150, 44, 196, 44, 9), arrow(150, 112, 196, 112, 9)];
const truckA = [arrow(150, 22, 206, 22, 9), arrow(150, 90, 178, 90, 9)];
// Step: the back foot stands on its toe (foot turned 0,6 rad toe down); the toe's sole touches the ground here
const GROUND = 124;
const STEP = { s: 0.62, H: 170, back: 88, front: 144, hip: { x: 118, y: 76 }, toe: 0.6 };
const fs = STEP.s * Math.min(1, STEP.H / 172);
const backAnkleY = GROUND - (20 * Math.sin(STEP.toe) + 7 * Math.cos(STEP.toe)) * fs;
const toeX = STEP.back + (20 * Math.cos(STEP.toe) - 7 * Math.sin(STEP.toe)) * fs;
const onGround = arrow(toeX - 1, GROUND + 4, toeX - 37, GROUND + 4, 9);
const onFoot = arrow(toeX + 1, GROUND - 4, toeX + 37, GROUND - 4, 9);
// Boats: the rope runs from the bow ring of the right boat to the hands of the man in the left boat
const RING = { x: 162, y: 98 };
const boatL = arrow(98, 106, 127, 106, 9);
const boatR = arrow(162, 106, 133, 106, 9);
---

<NzPicStyles />
<PeopleStyles />
<figure class="nz-pic up-pic not-content" data-usespic data-ground={GROUND} data-step={JSON.stringify({ ...STEP, backAnkleY })} data-ring={JSON.stringify(RING)}>
	<div class="up-grid">
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Автомобиль тормозит. Пассажир наклоняется вперёд, и ремень безопасности тянет его назад">
				<rect class="nz-ground" x="0" y="136" width="240" height="14"></rect>
				<!-- the car inside: floor, dashboard, windshield -->
				<rect class="up-floor" x="20" y="132" width="200" height="4"></rect>
				<path class="up-dash" d="M 150 78 L 206 70 L 214 100 L 156 104 Q 146 92 150 78 Z"></path>
				<path class="up-glass-line" d="M 206 70 L 168 34"></path>
				<!-- the seat -->
				<path class="up-seat" d="M 64 132 L 64 110 Q 64 104 72 104 L 128 104 Q 134 104 134 110 L 134 120 L 70 122 Z"></path>
				<path class="up-seat" d="M 66 110 L 52 46 Q 50 38 58 37 L 66 36 Q 72 36 74 44 L 84 106 Z"></path>
				<path class="up-seat" d="M 50 30 Q 50 22 58 22 L 66 22 Q 72 22 72 30 L 72 36 L 52 37 Z"></path>
				<g data-person="passenger"></g>
				<path class="up-belt" data-belt></path>
				<path class="nz-ar nz-ar--f" d={beltF.shaft}></path>
				<path class="nz-hd--f" d={beltF.head}></path>
				<text class="nz-sym nz-tf" x="56" y="74">F</text>
				<path class="nz-over nz-over--f" d={over(56, 74, 10)}></path>
				<path class="nz-ar nz-ar--v" d={carV.shaft}></path>
				<path class="nz-hd--v" d={carV.head}></path>
				<text class="nz-sym nz-tv" x="102" y="30">υ</text>
				<path class="nz-over nz-over--v" d={over(102, 30, 9)}></path>
				<path class="nz-ar nz-ar--a" d={carA.shaft}></path>
				<path class="nz-hd--a" d={carA.head}></path>
				<text class="nz-sym nz-ta" x="206" y="30">a</text>
				<path class="nz-over nz-over--a" d={over(206, 30, 9)}></path>
			</svg>
			<figcaption>Автомобиль тормозит. Пассажир по инерции движется вперёд, ремень тянет его назад.</figcaption>
		</figure>

		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Пустой и гружёный грузовики. Равнодействующая сила одна и та же, а ускорение гружёного вдвое меньше">
				{
					[0, 1].map((k) => (
						<g transform={`translate(0 ${k * 68})`}>
							<line class="nz-gline" x1="0" y1="64" x2="240" y2="64" />
							<rect class="up-cargo" x="40" y="30" width="80" height="26" rx="2" />
							{k === 1 && <rect class="up-box" x="46" y="12" width="22" height="18" rx="1" />}
							{k === 1 && <rect class="up-box" x="70" y="12" width="22" height="18" rx="1" />}
							{k === 1 && <rect class="up-box" x="94" y="12" width="22" height="18" rx="1" />}
							<path class="up-cab" d="M 122 56 L 122 30 L 142 30 L 152 44 L 152 56 Z" />
							<path class="up-glass" d="M 128 34 L 140 34 L 147 44 L 128 44 Z" />
							<circle class="up-wheel" cx="60" cy="58" r="6" />
							<circle class="up-wheel" cx="136" cy="58" r="6" />
						</g>
					))
				}
				{
					[0, 1].map((k) => (
						<g>
							<path class="nz-ar nz-ar--f nz-ar--dash" d={truckF[k].shaft} />
							<path class="nz-hd--f" d={truckF[k].head} />
							<text class="nz-sym nz-tf" x="202" y={50 + k * 68}>F</text>
							<path class="nz-over nz-over--f" d={over(202, 50 + k * 68, 10)} />
							<path class="nz-ar nz-ar--a" d={truckA[k].shaft} />
							<path class="nz-hd--a" d={truckA[k].head} />
							<text class="nz-sym nz-ta" x={k ? 184 : 212} y={28 + k * 68}>a</text>
							<path class="nz-over nz-over--a" d={over(k ? 184 : 212, 28 + k * 68, 9)} />
						</g>
					))
				}
			</svg>
			<figcaption>Равнодействующая та же, а масса гружёного грузовика вдвое больше — и ускорение вдвое меньше.</figcaption>
		</figure>

		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Шаг. Нога отталкивается от земли назад, а земля толкает ногу вперёд с такой же по модулю силой">
				<rect class="nz-ground" x="0" y={GROUND} width="240" height={150 - GROUND}></rect>
				<line class="nz-gline" x1="0" y1={GROUND} x2="240" y2={GROUND}></line>
				<g data-person="walker"></g>
				<path class="nz-ar nz-ar--f" d={onGround.shaft}></path>
				<path class="nz-hd--f" d={onGround.head}></path>
				<text class="nz-sym nz-tf" x={toeX - 50} y="146">F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(toeX - 50, 146, 10)}></path>
				<path class="nz-ar nz-ar--f" d={onFoot.shaft}></path>
				<path class="nz-hd--f" d={onFoot.head}></path>
				<text class="nz-sym nz-tf" x={toeX + 44} y="104">F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(toeX + 44, 104, 10)}></path>
			</svg>
			<figcaption>Нога толкает землю назад (<i>F⃗</i><sub>1</sub>), земля толкает ногу вперёд (<i>F⃗</i><sub>2</sub>).</figcaption>
		</figure>

		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Две лодки. Человек в левой лодке тянет верёвку, привязанную к правой лодке. Верёвка тянет обе лодки навстречу друг другу с равными силами">
				<rect class="up-water" x="0" y="108" width="240" height="42"></rect>
				<path class="up-rope" data-rope-tail></path>
				<path class="up-boat-in" d="M 4 100 L 9 93 L 95 93 L 100 100 Z"></path>
				<path class="up-boat-in" d="M 160 100 L 165 93 L 231 93 L 236 100 Z"></path>
				<path class="up-rope" data-rope></path>
				<g data-person="boatman"></g>
				<path class="up-boat" d="M 4 100 L 100 100 L 88 122 L 16 122 Z"></path>
				<path class="up-boat-rim" d="M 4 100 L 100 100"></path>
				<path class="up-boat" d="M 160 100 L 236 100 L 224 122 L 172 122 Z"></path>
				<path class="up-boat-rim" d="M 160 100 L 236 100"></path>
				<circle class="up-ring" cx={RING.x} cy={RING.y} r="2.2"></circle>
				<path class="up-rope" data-rope-bow></path>
				<path class="up-wave" d="M 0 130 q 10 -4 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0"></path>
				<path class="nz-ar nz-ar--f" d={boatL.shaft}></path>
				<path class="nz-hd--f" d={boatL.head}></path>
				<path class="nz-ar nz-ar--f" d={boatR.shaft}></path>
				<path class="nz-hd--f" d={boatR.head}></path>
				<text class="nz-sym nz-tf" x="98" y="142">F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(98, 142, 10)}></path>
				<text class="nz-sym nz-tf" x="146" y="142">F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(146, 142, 10)}></path>
			</svg>
			<figcaption>Верёвка тянет обе лодки навстречу друг другу с равными силами.</figcaption>
		</figure>
	</div>
</figure>

<style is:global>
	.up-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@media (min-width: 64rem) {
		.up-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.up-pic .nz-pic__panel figcaption {
		font-size: var(--sl-text-xs);
	}
	.up-seat {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-floor {
		fill: var(--sl-color-gray-4);
	}
	.up-dash {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 70%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.up-glass-line {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-3));
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.up-belt {
		fill: none;
		stroke: hsl(222, 15%, 22%);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .up-belt {
		stroke: hsl(222, 15%, 30%);
	}
	.up-cargo {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.up-box {
		fill: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.up-cab {
		fill: var(--nz-body);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-glass {
		fill: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-bg));
	}
	.up-wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.up-water {
		fill: var(--nz-water);
	}
	.up-wave {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 45%, transparent);
		stroke-width: 1;
	}
	.up-boat {
		fill: hsl(25, 40%, 42%);
		stroke: hsl(25, 35%, 25%);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-boat-in {
		fill: hsl(25, 35%, 30%);
		stroke: hsl(25, 35%, 22%);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.up-boat-rim {
		stroke: hsl(30, 45%, 62%);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.up-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.up-rope {
		fill: none;
		stroke: hsl(40, 45%, 62%);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
</style>

<script>
	import { figure } from '@components/people/body';

	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-usespic]')) {
		const GROUND = Number(root.dataset.ground);
		const step = JSON.parse(root.dataset.step!);
		const ring = JSON.parse(root.dataset.ring!);
		const g = (k: string) => root.querySelector<SVGGElement>(`[data-person="${k}"]`)!;

		// passenger: seated, leaning forward, palms on the thighs
		{
			const s = 0.75;
			const u = 170 * s;
			const fig = figure(g('passenger'), { s, H: 170, clothes: 'indoor', shirt: 'hm-green', name: 'passenger' });
			const hip = { x: 84, y: 102 };
			const st = fig.pose({
				hip,
				lean: 0.38,
				head: 0.1,
				ankles: [
					{ x: 122, y: 132 - 7 * s },
					{ x: 116, y: 132 - 7 * s - 1.5 },
				],
				feet: [0, 0],
				planted: [true, true],
				hands: [
					{ at: { x: hip.x + 0.17 * u, y: hip.y - 0.05 * u }, pose: 'flat', dir: 0.15, roll: 0, contact: 'thigh' },
					{ at: { x: hip.x + 0.12 * u, y: hip.y - 0.055 * u }, pose: 'flat', dir: 0.15, roll: 0, contact: 'thigh' },
				],
			});
			// the belt: from the anchor behind the far shoulder across the chest to the buckle, then across the lap
			const sh = st.shoulders[1];
			root.querySelector('[data-belt]')!.setAttribute('d', `M${f1(sh.x - 6)} ${f1(sh.y - 3)} L${f1(sh.x + 2)} ${f1(sh.y + 1)} L${f1(hip.x + 3)} ${f1(hip.y - 1)} M${f1(hip.x - 5)} ${f1(hip.y - 2)} L${f1(hip.x + 0.12 * u)} ${f1(hip.y - 2)}`);
		}

		// walker: the back (near) foot pushes off with its toe, the front foot lands on its heel
		{
			const s = step.s;
			const u = step.H * s;
			const fig = figure(g('walker'), { s, H: step.H, clothes: 'indoor', shirt: 'hm-gold', hair: 'pony', name: 'walker' });
			const hip = step.hip;
			const fs = s * Math.min(1, step.H / 172);
			fig.pose({
				hip,
				lean: 0.08,
				ankles: [
					{ x: step.back, y: step.backAnkleY },
					{ x: step.front, y: GROUND - 8.04 * fs },
				],
				feet: [step.toe, -0.15],
				planted: [true, false],
				hands: [
					{ at: { x: hip.x + 0.13 * u, y: hip.y + 0.0 * u }, pose: 'relaxed' },
					{ at: { x: hip.x - 0.12 * u, y: hip.y + 0.03 * u }, pose: 'relaxed' },
				],
			});
		}

		// boatman: stands in the left boat, leans back and pulls the rope with both fists
		{
			const s = 0.48;
			const fig = figure(g('boatman'), { s, H: 175, clothes: 'indoor', shirt: 'hm-green', name: 'boatman' });
			const k = (ring.y - 74) / (ring.x - 55); // the rope's slope
			const onRope = (x: number) => ({ x, y: ring.y - (ring.x - x) * k });
			const near = onRope(55);
			const far = onRope(48);
			fig.pose({
				hip: { x: 40, y: 78 },
				lean: -0.25,
				ankles: [
					{ x: 50, y: 119 - 7 * s },
					{ x: 32, y: 119 - 7 * s - 1 },
				],
				feet: [0, 0],
				planted: [true, true],
				hands: [
					{ at: near, pose: 'grip', d: 2, contact: 'rope' },
					{ at: far, pose: 'grip', d: 2, contact: 'rope' },
				],
			});
			// the rope behind the person passes through both fists; a short piece in front of the right boat's rim
			root.querySelector('[data-rope]')!.setAttribute('d', `M${f1(ring.x)} ${f1(ring.y)} L${f1(far.x)} ${f1(far.y)}`);
			root.querySelector('[data-rope-bow]')!.setAttribute('d', `M${f1(ring.x)} ${f1(ring.y)} L${f1(ring.x - 8)} ${f1(ring.y - 8 * k)}`);
			root.querySelector('[data-rope-tail]')!.setAttribute('d', `M${f1(far.x)} ${f1(far.y)} Q ${f1(far.x - 10)} ${f1(far.y + 6)} ${f1(far.x - 4)} ${f1(far.y + 22)} T ${f1(far.x + 6)} 112`);
		}
	}
</script>
