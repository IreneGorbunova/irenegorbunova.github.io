---
/**
 * Small pictures to «Где это встречается»: the seat belt (the car brakes, the belt pulls the passenger back), an empty
 * and a loaded truck with the same resultant force (the loaded one, twice as heavy, gets half the acceleration), a step
 * (the foot pushes the ground back, the ground pushes the foot forward) and two boats pulled together by one rope
 * (equal forces on both boats). Text stays in the captions so that the pictures read at 390 px in two columns.
 */
import NzPicStyles from './NzPicStyles.astro';
import { arrow, over } from './pic';

// Seat belt
const beltF = arrow(150, 74, 108, 74, 9);
const carV = arrow(40, 24, 96, 24, 9);
const carA = arrow(200, 24, 158, 24, 9);
// Trucks: the same resultant force, a and a/2
const truckF = [arrow(150, 44, 196, 44, 9), arrow(150, 112, 196, 112, 9)];
const truckA = [arrow(150, 22, 206, 22, 9), arrow(150, 90, 178, 90, 9)];
// Step
const onGround = arrow(120, 120, 74, 120, 9);
const onFoot = arrow(124, 102, 170, 102, 9);
// Boats
const boatL = arrow(84, 82, 126, 82, 9);
const boatR = arrow(178, 82, 136, 82, 9);
---

<NzPicStyles />
<figure class="nz-pic up-pic not-content">
	<div class="up-grid">
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Автомобиль тормозит. Пассажир продолжает двигаться вперёд, и ремень безопасности тянет его назад">
				<rect class="nz-ground" x="0" y="136" width="240" height="14"></rect>
				<!-- the seat -->
				<path class="up-seat" d="M 70 132 L 70 108 L 132 108 L 136 132 Z"></path>
				<path class="up-seat" d="M 70 108 L 58 44 Q 56 36 64 36 L 72 36 Q 78 36 79 44 L 88 108 Z"></path>
				<!-- the passenger, leaning forward -->
				<circle class="up-skin" cx="112" cy="46" r="11"></circle>
				<path class="up-body" d="M 84 104 L 98 62 Q 102 56 110 60 L 118 66 L 104 106 Z"></path>
				<path class="up-body" d="M 92 104 L 140 104 L 144 132 L 134 132 L 130 112 L 94 112 Z"></path>
				<!-- the belt -->
				<path class="up-belt" d="M 86 56 L 118 100"></path>
				<path class="up-belt" d="M 84 104 L 126 104"></path>
				<path class="nz-ar nz-ar--f" d={beltF.shaft}></path>
				<path class="nz-hd--f" d={beltF.head}></path>
				<text class="nz-sym nz-tf" x="154" y="80">F</text>
				<path class="nz-over nz-over--f" d={over(154, 80, 10)}></path>
				<path class="nz-ar nz-ar--v" d={carV.shaft}></path>
				<path class="nz-hd--v" d={carV.head}></path>
				<text class="nz-sym nz-tv" x="102" y="30">υ</text>
				<path class="nz-over nz-over--v" d={over(102, 30, 9)}></path>
				<path class="nz-ar nz-ar--a" d={carA.shaft}></path>
				<path class="nz-hd--a" d={carA.head}></path>
				<text class="nz-sym nz-ta" x="206" y="30">a</text>
				<path class="nz-over nz-over--a" d={over(206, 30, 9)}></path>
			</svg>
			<figcaption>Автомобиль тормозит. Пассажир по инерции движется вперёд, ремень тянет его назад.</figcaption>
		</figure>

		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Пустой и гружёный грузовики. Равнодействующая сила одна и та же, а ускорение гружёного вдвое меньше">
				{
					[0, 1].map((k) => (
						<g transform={`translate(0 ${k * 68})`}>
							<line class="nz-gline" x1="0" y1="64" x2="240" y2="64" />
							<rect class="up-cargo" x="40" y="30" width="80" height="26" rx="2" />
							{k === 1 && <rect class="up-box" x="46" y="12" width="22" height="18" rx="1" />}
							{k === 1 && <rect class="up-box" x="70" y="12" width="22" height="18" rx="1" />}
							{k === 1 && <rect class="up-box" x="94" y="12" width="22" height="18" rx="1" />}
							<path class="up-cab" d="M 122 56 L 122 30 L 142 30 L 152 44 L 152 56 Z" />
							<path class="up-glass" d="M 128 34 L 140 34 L 147 44 L 128 44 Z" />
							<circle class="up-wheel" cx="60" cy="58" r="6" />
							<circle class="up-wheel" cx="136" cy="58" r="6" />
						</g>
					))
				}
				{
					[0, 1].map((k) => (
						<g>
							<path class="nz-ar nz-ar--f nz-ar--dash" d={truckF[k].shaft} />
							<path class="nz-hd--f" d={truckF[k].head} />
							<text class="nz-sym nz-tf" x="202" y={50 + k * 68}>F</text>
							<path class="nz-over nz-over--f" d={over(202, 50 + k * 68, 10)} />
							<path class="nz-ar nz-ar--a" d={truckA[k].shaft} />
							<path class="nz-hd--a" d={truckA[k].head} />
							<text class="nz-sym nz-ta" x={k ? 184 : 212} y={28 + k * 68}>a</text>
							<path class="nz-over nz-over--a" d={over(k ? 184 : 212, 28 + k * 68, 9)} />
						</g>
					))
				}
			</svg>
			<figcaption>Равнодействующая та же, а масса гружёного грузовика вдвое больше — и ускорение вдвое меньше.</figcaption>
		</figure>

		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Шаг. Нога отталкивается от земли назад, а земля толкает ногу вперёд с такой же по модулю силой">
				<rect class="nz-ground" x="0" y="120" width="240" height="30"></rect>
				<line class="nz-gline" x1="0" y1="120" x2="240" y2="120"></line>
				<!-- the leg and the shoe, pushing off -->
				<path class="up-body" d="M 64 20 L 86 20 L 128 98 L 112 104 Z"></path>
				<path class="up-shoe" d="M 106 100 Q 108 92 120 94 L 150 104 Q 166 110 164 118 Q 163 120 158 120 L 108 120 Q 102 118 104 110 Z"></path>
				<path class="nz-ar nz-ar--f" d={onGround.shaft}></path>
				<path class="nz-hd--f" d={onGround.head}></path>
				<text class="nz-sym nz-tf" x="40" y="142">F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(40, 142, 10)}></path>
				<path class="nz-ar nz-ar--f" d={onFoot.shaft}></path>
				<path class="nz-hd--f" d={onFoot.head}></path>
				<text class="nz-sym nz-tf" x="176" y="100">F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(176, 100, 10)}></path>
			</svg>
			<figcaption>Нога толкает землю назад (<i>F</i><sub>1</sub>), земля толкает ногу вперёд (<i>F</i><sub>2</sub>).</figcaption>
		</figure>

		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 240 150" role="img" aria-label="Две лодки. Человек в левой лодке тянет верёвку, привязанную к правой лодке. Верёвка тянет обе лодки навстречу друг другу с равными силами">
				<rect class="up-water" x="0" y="108" width="240" height="42"></rect>
				<path class="up-boat" d="M 14 100 L 118 100 L 106 122 L 26 122 Z"></path>
				<path class="up-boat" d="M 140 100 L 228 100 L 216 122 L 152 122 Z"></path>
				<!-- the man in the left boat -->
				<circle class="up-skin" cx="60" cy="46" r="10"></circle>
				<path class="up-body" d="M 52 58 L 70 58 L 74 100 L 48 100 Z"></path>
				<path class="up-arm" d="M 68 66 L 92 74"></path>
				<!-- the rope -->
				<path class="up-rope" d="M 92 74 Q 120 82 144 96"></path>
				<path class="nz-ar nz-ar--f" d={boatL.shaft}></path>
				<path class="nz-hd--f" d={boatL.head}></path>
				<path class="nz-ar nz-ar--f" d={boatR.shaft}></path>
				<path class="nz-hd--f" d={boatR.head}></path>
				<text class="nz-sym nz-tf" x="92" y="140">F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(92, 140, 10)}></path>
				<text class="nz-sym nz-tf" x="150" y="140">F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(150, 140, 10)}></path>
			</svg>
			<figcaption>Верёвка тянет обе лодки навстречу друг другу с равными силами.</figcaption>
		</figure>
	</div>
</figure>

<style is:global>
	.up-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@media (min-width: 64rem) {
		.up-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.up-pic .nz-pic__panel figcaption {
		font-size: var(--sl-text-xs);
	}
	.up-seat {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-skin {
		fill: var(--nz-skin);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.up-body {
		fill: var(--nz-body);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-arm {
		stroke: var(--nz-body);
		stroke-width: 7;
		stroke-linecap: round;
	}
	.up-belt {
		stroke: var(--sl-color-gray-1);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.up-cargo {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.up-box {
		fill: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.up-cab {
		fill: var(--nz-body);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-glass {
		fill: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-bg));
	}
	.up-wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.up-shoe {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 60%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-water {
		fill: var(--nz-water);
	}
	.up-boat {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-rope {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.8;
	}
</style>
