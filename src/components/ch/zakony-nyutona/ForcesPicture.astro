---
/**
 * Picture to the second law: the cart of the model, m = 20 kg, in two of its experiments.
 * Speeding up: F_pull = 30 N, F_fr = 10 N, the resultant 20 N forward, a = 20 / 20 = 1 m/s² forward.
 * Braking: no pull, F_fr = 10 N, the resultant 10 N backward, a = 0,5 m/s² backward while the velocity points forward.
 * Scales: 2,4 px per newton, 40 px per m/s², 14 px per m/s (the speed 3 m/s in both panels). Gravity and the road's
 * elastic force balance each other and are not drawn, as in the model.
 */
import NzPicStyles from './NzPicStyles.astro';
import { arrow, over } from './pic';

const KF = 2.4;
const KA = 40;
const KV = 14;
const C = { x: 150, y: 123 }; // the cart's center
const ROAD = 150;

const panels = [
	{
		title: 'Разгон',
		pull: 30,
		fr: 10,
		v: 3,
		aria: 'Тележка разгоняется. Вперёд её тянет сила тяги 30 ньютонов, назад действует сила трения 10 ньютонов. Равнодействующая 20 ньютонов и ускорение направлены вперёд, так же как скорость',
	},
	{
		title: 'Торможение',
		pull: 0,
		fr: 10,
		v: 3,
		aria: 'Тележка тормозит. На неё действует только сила трения 10 ньютонов, направленная назад. Равнодействующая и ускорение направлены назад, против скорости',
	},
].map((p) => {
	const net = p.pull - p.fr;
	const a = net / 20;
	return {
		...p,
		net,
		a,
		pullA: p.pull ? arrow(C.x, C.y, C.x + KF * p.pull, C.y) : null,
		frA: arrow(C.x, C.y, C.x - KF * p.fr, C.y, 8),
		netA: arrow(C.x, 182, C.x + KF * net, 182, 9),
		aA: arrow(C.x, 54, C.x + KA * a, 54, 9),
		vA: arrow(C.x, 84, C.x + KV * p.v, 84, 9),
	};
});
---

<NzPicStyles />
<figure class="nz-pic not-content">
	<div class="nz-pic__grid">
		{
			panels.map((p) => (
				<figure class="nz-pic__panel">
					<svg class="nz-pic__svg" viewBox="0 0 320 210" role="img" aria-label={p.aria}>
						<text class="nz-title" x="14" y="26">
							{p.title}
						</text>
						<rect class="nz-ground" x="0" y={ROAD} width="320" height="60" />
						<line class="nz-gline" x1="0" y1={ROAD} x2="320" y2={ROAD} />
						<line class="fp-guide" x1={C.x} y1="48" x2={C.x} y2="196" />
						{/* the cart */}
						<rect class="fp-bed" x={C.x - 50} y={C.y - 11} width="100" height="18" rx="3" />
						<circle class="fp-wheel" cx={C.x - 30} cy={ROAD - 10} r="10" />
						<circle class="fp-wheel" cx={C.x + 30} cy={ROAD - 10} r="10" />
						<circle class="fp-hub" cx={C.x - 30} cy={ROAD - 10} r="2.5" />
						<circle class="fp-hub" cx={C.x + 30} cy={ROAD - 10} r="2.5" />
						{/* velocity */}
						<path class="nz-ar nz-ar--v" d={p.vA.shaft} />
						<path class="nz-hd--v" d={p.vA.head} />
						<text class="nz-sym nz-tv" x={C.x + KV * p.v + 6} y="90">
							υ
						</text>
						<path class="nz-over nz-over--v" d={over(C.x + KV * p.v + 6, 90, 9)} />
						{/* acceleration */}
						<path class="nz-ar nz-ar--a" d={p.aA.shaft} />
						<path class="nz-hd--a" d={p.aA.head} />
						<text class="nz-sym nz-ta" x={p.a > 0 ? C.x + KA * p.a + 6 : C.x + KA * p.a - 16} y="60">
							a
						</text>
						<path class="nz-over nz-over--a" d={over(p.a > 0 ? C.x + KA * p.a + 6 : C.x + KA * p.a - 16, 60, 9)} />
						<text class="nz-small nz-ta" x={p.a > 0 ? C.x + KA * p.a + 20 : C.x + KA * p.a - 16 - 4} y="60" text-anchor={p.a > 0 ? 'start' : 'end'}>
							{p.a > 0 ? '1 м/с²' : '0,5 м/с²'}
						</text>
						{/* forces from the center of the cart */}
						{p.pullA && <path class="nz-ar nz-ar--f" d={p.pullA.shaft} />}
						{p.pullA && <path class="nz-hd--f" d={p.pullA.head} />}
						{p.pullA && (
							<text class="nz-sym nz-tf" x={C.x + KF * p.pull + 6} y={C.y + 6}>
								F<tspan class="nz-sub" dy="5">тяги</tspan>
							</text>
						)}
						{p.pullA && <path class="nz-over nz-over--f" d={over(C.x + KF * p.pull + 6, C.y + 6, 10)} />}
						<path class="nz-ar nz-ar--f" d={p.frA.shaft} />
						<path class="nz-hd--f" d={p.frA.head} />
						<text class="nz-sym nz-tf" x={C.x - KF * p.fr - 34} y={C.y - 16}>
							F<tspan class="nz-sub" dy="5">тр</tspan>
						</text>
						<path class="nz-over nz-over--f" d={over(C.x - KF * p.fr - 34, C.y - 16, 10)} />
						<circle class="nz-dot" cx={C.x} cy={C.y} r="3" />
						{/* the resultant */}
						<path class="nz-ar nz-ar--f nz-ar--dash" d={p.netA.shaft} />
						<path class="nz-hd--f" d={p.netA.head} />
						<text class="nz-sym nz-tf" x={p.net > 0 ? C.x + KF * p.net + 8 : C.x + KF * p.net - 18} y="188">
							F
						</text>
						<path class="nz-over nz-over--f" d={over(p.net > 0 ? C.x + KF * p.net + 8 : C.x + KF * p.net - 18, 188, 10)} />
						<text class="nz-small" x={p.net > 0 ? C.x + KF * p.net + 24 : C.x + 10} y="188">
							{p.net > 0 ? '20 Н' : '10 Н'}
						</text>
					</svg>
					<figcaption>
						{p.pull ? (
							<Fragment set:html="Тяга 30&nbsp;Н, трение 10&nbsp;Н, масса 20&nbsp;кг. Равнодействующая <i>F</i> = 20&nbsp;Н и ускорение <i>a</i> = 1&nbsp;м/с² направлены вперёд, как и скорость." />
						) : (
							<Fragment set:html="Тяги нет, трение 10&nbsp;Н, масса 20&nbsp;кг. Равнодействующая и ускорение 0,5&nbsp;м/с² направлены назад, против скорости: тележка тормозит." />
						)}
					</figcaption>
				</figure>
			))
		}
	</div>
	<div class="nz-pic__foot">
		<figcaption>Силы <i>F</i><sub>тяги</sub> и <i>F</i><sub>тр</sub> приложены к тележке, пунктиром показана их равнодействующая <i>F</i>; <i>υ</i> — скорость, <i>a</i> — ускорение. Сила тяжести и сила упругости дороги уравновешивают друг друга, их на рисунке нет.</figcaption>
	</div>
</figure>

<style is:global>
	.fp-guide {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 2 4;
	}
	.fp-bed {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.fp-wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.fp-hub {
		fill: var(--sl-color-gray-2);
	}
</style>
