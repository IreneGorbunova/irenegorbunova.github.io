---
/**
 * Picture to the third law: two pairs of forces, each pair applied to two different bodies.
 * Hand and wall: the wall pushes the hand (F₁, on the hand), the hand pushes the wall (F₂, on the wall).
 * Magnet and nail: the nail attracts the magnet (F₁, on the magnet), the magnet attracts the nail (F₂, on the nail).
 * In each pair the arrows have equal length and lie on one line; as in the models, F₁ acts on the first body.
 */
import NzPicStyles from './NzPicStyles.astro';
import { arrow, over } from './pic';

const L = 56; // the length of every force arrow
// Hand and wall: the contact at x = 200
const HY = 118;
const handF1 = arrow(198, HY, 198 - L, HY); // on the hand, to the left
const wallF2 = arrow(202, HY, 202 + L, HY); // on the wall, to the right
// Magnet and nail
const MY = 119;
const magF1 = arrow(92, MY, 92 + L, MY); // on the magnet, towards the nail
const nailF2 = arrow(238, MY, 238 - L, MY); // on the nail, towards the magnet
const hatch = Array.from({ length: 9 }, (_, i) => 40 + i * 18);
---

<NzPicStyles />
<figure class="nz-pic not-content">
	<div class="nz-pic__grid">
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Рука давит ладонью на стену, а стена давит на руку. Две силы равной длины направлены в противоположные стороны: одна приложена к стене, другая к руке">
				<text class="nz-title" x="14" y="26">Рука и стена</text>
				<rect class="pp-wall" x="200" y="34" width="44" height="166"></rect>
				{hatch.map((y) => <line class="pp-hatch" x1="244" y1={y} x2="262" y2={y - 14} />)}
				<line class="pp-wall-edge" x1="244" y1="34" x2="244" y2="200"></line>
				<!-- the arm and the palm -->
				<line class="pp-sleeve" x1="-6" y1="214" x2="78" y2="172"></line>
				<line class="pp-forearm" x1="70" y1="176" x2="178" y2="128"></line>
				<rect class="pp-palm" x="176" y="94" width="22" height="52" rx="8"></rect>
				<path class="nz-ar nz-ar--f" d={handF1.shaft}></path>
				<path class="nz-hd--f" d={handF1.head}></path>
				<path class="nz-ar nz-ar--f" d={wallF2.shaft}></path>
				<path class="nz-hd--f" d={wallF2.head}></path>
				<circle class="nz-dot" cx="200" cy={HY} r="3"></circle>
				<text class="nz-sym nz-tf" x="132" y={HY - 12}>F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(132, HY - 12, 10)}></path>
				<text class="nz-small nz-tf" x="104" y={HY + 4} text-anchor="end">на руку</text>
				<text class="nz-sym nz-tf" x="262" y={HY - 12}>F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(262, HY - 12, 10)}></path>
				<text class="nz-small nz-tf" x="266" y={HY + 22}>на стену</text>
			</svg>
			<figcaption>Стена давит на руку с силой <i>F</i><sub>1</sub>, рука давит на стену с силой <i>F</i><sub>2</sub>. Силы равны по модулю и приложены к разным телам.</figcaption>
		</figure>
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Магнит и железный гвоздь на столе притягивают друг друга. Две силы равной длины направлены навстречу друг другу: одна приложена к магниту, другая к гвоздю">
				<text class="nz-title" x="14" y="26">Магнит и гвоздь</text>
				<rect class="pp-table" x="10" y="126" width="300" height="8" rx="2"></rect>
				<!-- bar magnet: S on the left, N on the right -->
				<rect class="pp-s" x="36" y="100" width="56" height="26" rx="2"></rect>
				<rect class="pp-n" x="92" y="100" width="56" height="26" rx="2"></rect>
				<text class="pp-pole" x="64" y="113" text-anchor="middle">S</text>
				<text class="pp-pole" x="120" y="113" text-anchor="middle">N</text>
				<!-- iron nail: the tip towards the magnet -->
				<path class="pp-nail" d="M 196 120 L 210 115 L 272 115 L 272 123 L 210 123 Z"></path>
				<rect class="pp-nail" x="272" y="110" width="5" height="16" rx="1"></rect>
				<path class="nz-ar nz-ar--f" d={magF1.shaft}></path>
				<path class="nz-hd--f" d={magF1.head}></path>
				<path class="nz-ar nz-ar--f" d={nailF2.shaft}></path>
				<path class="nz-hd--f" d={nailF2.head}></path>
				<circle class="nz-dot" cx="92" cy={MY} r="3"></circle>
				<circle class="nz-dot" cx="238" cy={MY} r="3"></circle>
				<text class="nz-sym nz-tf" x="128" y="84">F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(128, 84, 10)}></path>
				<text class="nz-small nz-tf" x="92" y="156" text-anchor="middle">на магнит</text>
				<text class="nz-sym nz-tf" x="186" y="84">F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(186, 84, 10)}></path>
				<text class="nz-small nz-tf" x="238" y="156" text-anchor="middle">на гвоздь</text>
			</svg>
			<figcaption>Гвоздь притягивает магнит с силой <i>F</i><sub>1</sub>, магнит притягивает гвоздь с силой <i>F</i><sub>2</sub>. И здесь силы равны по модулю и направлены навстречу друг другу.</figcaption>
		</figure>
	</div>
</figure>

<style is:global>
	.pp-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 55%, transparent);
	}
	.pp-wall-edge,
	.pp-hatch {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.pp-skin {
		fill: var(--nz-skin);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.pp-sleeve {
		stroke: var(--nz-body);
		stroke-width: 30;
		stroke-linecap: round;
	}
	.pp-forearm {
		stroke: var(--nz-skin);
		stroke-width: 18;
		stroke-linecap: round;
	}
	.pp-palm {
		fill: var(--nz-skin);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.pp-table {
		fill: var(--nz-ground);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.pp-n {
		fill: color-mix(in srgb, var(--ig-vy) 70%, var(--sl-color-gray-5));
	}
	.pp-s {
		fill: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-gray-5));
	}
	.nz-pic .pp-pole {
		font-weight: 700;
		font-size: 15px;
		fill: var(--sl-color-white);
		stroke: none;
	}
	.pp-nail {
		fill: var(--nz-metal);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linejoin: round;
	}
</style>
