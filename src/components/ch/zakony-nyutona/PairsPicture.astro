---
/**
 * Picture to the third law: two pairs of forces, each pair applied to two different bodies.
 * Hand and wall: a person (people kit, 170 см at 0,9 px per см) leans into a wall and presses it with a flat palm;
 *   the wall pushes the hand (F₁, on the hand), the hand pushes the wall (F₂, on the wall). The arrows start at the
 *   point where the palm touches the wall.
 * Magnet and nail: the nail attracts the magnet (F₁, on the magnet), the magnet attracts the nail (F₂, on the nail).
 * In each pair the arrows have equal length and lie on one line; as in the models, F₁ acts on the first body.
 */
import NzPicStyles from './NzPicStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import { arrow, over } from './pic';

const L = 56; // the length of every force arrow
// Hand and wall: the contact at x = 200, at the height of the palm's middle (a little below the shoulder joint)
const FLOOR = 196;
const S = 0.9; // px per см
const H = 170; // см
const HY = 84;
const handF1 = arrow(198, HY, 198 - L, HY); // on the hand, to the left
const wallF2 = arrow(202, HY, 202 + L, HY); // on the wall, to the right
// Magnet and nail
const MY = 119;
const magF1 = arrow(92, MY, 92 + L, MY); // on the magnet, towards the nail
const nailF2 = arrow(238, MY, 238 - L, MY); // on the nail, towards the magnet
const hatch = Array.from({ length: 9 }, (_, i) => 40 + i * 18);
const clip = `nzp-clip-${Math.random().toString(36).slice(2, 8)}`;
---

<NzPicStyles />
<PeopleStyles />
<figure class="nz-pic not-content" data-pairspic data-floor={FLOOR} data-s={S} data-h={H} data-hy={HY}>
	<div class="nz-pic__grid">
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Человек давит ладонью на стену, а стена давит на руку. Две силы равной длины направлены в противоположные стороны: одна приложена к стене, другая к руке">
				<text class="nz-title" x="14" y="26">Рука и стена</text>
				<rect class="nzp-floor" x="0" y={FLOOR} width="200" height={200 - FLOOR}></rect>
				<rect class="nzp-wall" x="200" y="34" width="44" height="166"></rect>
				{hatch.map((y) => <line class="nzp-hatch" x1="244" y1={y} x2="262" y2={y - 14} />)}
				<line class="nzp-wall-edge" x1="244" y1="34" x2="244" y2="200"></line>
				<!-- nothing of the person passes the wall's face: the palm lies flat on it -->
				<clipPath id={clip}><rect x="-20" y="0" width="220" height="200"></rect></clipPath>
				<g clip-path={`url(#${clip})`}><g data-person></g></g>
				<path class="nz-ar nz-ar--f" d={handF1.shaft}></path>
				<path class="nz-hd--f" d={handF1.head}></path>
				<path class="nz-ar nz-ar--f" d={wallF2.shaft}></path>
				<path class="nz-hd--f" d={wallF2.head}></path>
				<circle class="nz-dot" cx="200" cy={HY} r="3"></circle>
				<text class="nz-sym nz-tf" x="100" y={HY - 9}>F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(100, HY - 9, 10)}></path>
				<text class="nz-small nz-tf" x="122" y={HY + 18} text-anchor="end">на руку</text>
				<text class="nz-sym nz-tf" x="262" y={HY - 12}>F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(262, HY - 12, 10)}></path>
				<text class="nz-small nz-tf" x="266" y={HY + 22}>на стену</text>
			</svg>
			<figcaption>Стена давит на руку с силой <i>F</i><sub>1</sub>, рука давит на стену с силой <i>F</i><sub>2</sub>. Силы равны по модулю и приложены к разным телам.</figcaption>
		</figure>
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Магнит и железный гвоздь на столе притягивают друг друга. Две силы равной длины направлены навстречу друг другу: одна приложена к магниту, другая к гвоздю">
				<text class="nz-title" x="14" y="26">Магнит и гвоздь</text>
				<rect class="nzp-table" x="10" y="126" width="300" height="8" rx="2"></rect>
				<!-- bar magnet: S on the left, N on the right (N blue, S red, as everywhere on the site) -->
				<rect class="nzp-s" x="36" y="100" width="56" height="26" rx="2"></rect>
				<rect class="nzp-n" x="92" y="100" width="56" height="26" rx="2"></rect>
				<text class="nzp-pole" x="64" y="117.5" text-anchor="middle">S</text>
				<text class="nzp-pole" x="120" y="117.5" text-anchor="middle">N</text>
				<!-- iron nail: the tip towards the magnet -->
				<path class="nzp-nail" d="M 196 120 L 210 115 L 272 115 L 272 123 L 210 123 Z"></path>
				<rect class="nzp-nail" x="272" y="110" width="5" height="16" rx="1"></rect>
				<path class="nz-ar nz-ar--f" d={magF1.shaft}></path>
				<path class="nz-hd--f" d={magF1.head}></path>
				<path class="nz-ar nz-ar--f" d={nailF2.shaft}></path>
				<path class="nz-hd--f" d={nailF2.head}></path>
				<circle class="nz-dot" cx="92" cy={MY} r="3"></circle>
				<circle class="nz-dot" cx="238" cy={MY} r="3"></circle>
				<text class="nz-sym nz-tf" x="128" y="84">F<tspan class="nz-sub" dy="5">1</tspan></text>
				<path class="nz-over nz-over--f" d={over(128, 84, 10)}></path>
				<text class="nz-small nz-tf" x="92" y="156" text-anchor="middle">на магнит</text>
				<text class="nz-sym nz-tf" x="186" y="84">F<tspan class="nz-sub" dy="5">2</tspan></text>
				<path class="nz-over nz-over--f" d={over(186, 84, 10)}></path>
				<text class="nz-small nz-tf" x="238" y="156" text-anchor="middle">на гвоздь</text>
			</svg>
			<figcaption>Гвоздь притягивает магнит с силой <i>F</i><sub>1</sub>, магнит притягивает гвоздь с силой <i>F</i><sub>2</sub>. И здесь силы равны по модулю и направлены навстречу друг другу.</figcaption>
		</figure>
	</div>
</figure>

<style is:global>
	.nzp-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 55%, transparent);
	}
	.nzp-floor {
		fill: var(--nz-ground);
	}
	.nzp-wall-edge,
	.nzp-hatch {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.nzp-table {
		fill: var(--nz-ground);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.nzp-n {
		fill: hsl(212, 70%, 50%);
	}
	.nzp-s {
		fill: hsl(355, 65%, 52%);
	}
	.nz-pic .nzp-pole {
		font-weight: 700;
		font-size: 15px;
		fill: white;
		stroke: none;
	}
	.nzp-nail {
		fill: var(--nz-metal);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linejoin: round;
	}
</style>

<script>
	import { figure } from '@components/people/body';

	for (const root of document.querySelectorAll<HTMLElement>('[data-pairspic]')) {
		const FLOOR = Number(root.dataset.floor);
		const S = Number(root.dataset.s);
		const H = Number(root.dataset.h);
		const HY = Number(root.dataset.hy);
		const u = S * H;
		const fig = figure(root.querySelector<SVGGElement>('[data-person]')!, { s: S, H, clothes: 'indoor', shirt: 'hm-green', name: 'wall pusher' });
		const lean = 0.15;
		const hipY = FLOOR - 7 * S - 0.475 * u * 0.99;
		// put the hip so that the shoulder is 88 % of the arm's reach from the palm's middle
		const sh0 = fig.shoulders({ x: 0, y: hipY }, lean)[0];
		const reach = fig.bones.upper + fig.bones.fore + 0.45 * fig.bones.hand;
		const dx = Math.sqrt(Math.max(0, (0.88 * reach) ** 2 - (HY - sh0.y) ** 2));
		const hipX = 199 - dx - sh0.x;
		fig.pose({
			hip: { x: hipX, y: hipY },
			lean,
			ankles: [
				{ x: hipX - 0.02 * u, y: FLOOR - 7 * S },
				{ x: hipX - 0.16 * u, y: FLOOR - 7 * S },
			],
			feet: [0, 0],
			planted: [true, true],
			hands: [
				// the palm flat on the wall: fingers straight up, the palm facing the wall
				{ at: { x: 199.5, y: HY }, pose: 'flat', dir: -Math.PI / 2, roll: -0.25, contact: 'wall' },
				{ at: { x: hipX - 0.03 * u, y: hipY + 0.02 * u }, pose: 'relaxed' },
			],
		});
	}
</script>
