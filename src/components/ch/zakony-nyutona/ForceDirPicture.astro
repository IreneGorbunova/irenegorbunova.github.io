---
/**
 * «Куда направлены силы» (section «Силы в механике»): four bodies at rest, every force on the body drawn from its
 * center, one scale per panel.
 *   1. A block on a horizontal table: mg down, N up, N = mg (60 px each). The weight P = N acts on the table: drawn from
 *      the contact surface, dashed and gray, «приложен к опоре».
 *   2. A block at rest on an incline of 30°: mg (60 px) down, N = mg cos 30° (52 px) perpendicular to the plane, static
 *      friction = mg sin 30° (30 px) up the plane. Nothing is labelled «вес» here: the block presses on the plane with a
 *      total force mg straight down, of which only the perpendicular part equals N (explained in a popover in the text).
 *   3. A block pressed to a wall by a hand: F of the hand (70 px) toward the wall, N from the wall (70 px), mg (35 px)
 *      down, static friction = mg (35 px) up; it holds when μ ≥ mg / F = 0,5. The hand is the people kit's (nzArm.ts).
 *   4. A weight on a thread: T up along the thread, mg down, T = mg (60 px).
 */
import NzPicStyles from './NzPicStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import { arrow, over } from './pic';

const D30 = Math.PI / 6;
const f = (v: number) => v.toFixed(1);

// 1. table
const T1 = { c: { x: 160, y: 148 }, top: 168 };
// 2. incline
const B = { x: 296, y: 206 };
const L = 270;
const d = { x: Math.cos(D30), y: Math.sin(D30) };
const n = { x: Math.sin(D30), y: -Math.cos(D30) };
const top = { x: B.x - L * d.x, y: B.y - L * d.y };
const base = { x: top.x + 150 * d.x, y: top.y + 150 * d.y };
const C2 = { x: base.x + 15 * n.x, y: base.y + 15 * n.y };
const mg2 = arrow(C2.x, C2.y, C2.x, C2.y + 60);
const N2 = arrow(C2.x, C2.y, C2.x + 60 * Math.cos(D30) * n.x, C2.y + 60 * Math.cos(D30) * n.y);
const fr2 = arrow(C2.x, C2.y, C2.x - 30 * d.x, C2.y - 30 * d.y, 9);
const arcR = 34;
const arc = `M ${f(B.x - arcR)} ${f(B.y)} A ${arcR} ${arcR} 0 0 1 ${f(B.x - arcR * d.x)} ${f(B.y - arcR * d.y)}`;
// 3. wall
const C3 = { x: 105, y: 128 };
// 4. thread
const C4 = { x: 160, y: 142 };

const pnl = {
	mg1: arrow(T1.c.x, T1.c.y, T1.c.x, T1.c.y + 60),
	N1: arrow(T1.c.x, T1.c.y, T1.c.x, T1.c.y - 60),
	P1: arrow(190, T1.top, 190, T1.top + 60),
	F3: arrow(C3.x, C3.y, C3.x - 70, C3.y),
	N3: arrow(C3.x, C3.y, C3.x + 70, C3.y),
	mg3: arrow(C3.x, C3.y, C3.x, C3.y + 35, 9),
	fr3: arrow(C3.x, C3.y, C3.x, C3.y - 35, 9),
	T4: arrow(C4.x, C4.y, C4.x, C4.y - 60),
	mg4: arrow(C4.x, C4.y, C4.x, C4.y + 60),
};
const hatch = (x0: number, y0: number, x1: number, y1: number, step = 9) => {
	let s = '';
	for (let k = x0 - (y1 - y0); k < x1; k += step) {
		const xa = Math.max(k, x0);
		const ya = y1 - (xa - k);
		const xb = Math.min(k + (y1 - y0), x1);
		const yb = y1 - (xb - k);
		s += `M ${f(xa)} ${f(ya)} L ${f(xb)} ${f(yb)} `;
	}
	return s;
};
---

<NzPicStyles />
<PeopleStyles />
<figure class="nz-pic fd not-content" data-fd>
	<div class="nz-pic__grid">
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 250" role="img" aria-label="Брусок на горизонтальном столе. Сила тяжести направлена вниз, сила реакции опоры вверх, они равны. Вес бруска приложен к столу и направлен вниз">
				<text class="nz-title" x="14" y="26">Горизонтальная опора</text>
				<rect class="nz-ground" x="20" y={T1.top} width="280" height="30"></rect>
				<line class="nz-gline" x1="20" y1={T1.top} x2="300" y2={T1.top}></line>
				<rect class="fd-block" x={T1.c.x - 42} y={T1.top - 40} width="84" height="40" rx="3"></rect>
				<path class="nz-ar nz-ar--f" d={pnl.N1.shaft}></path><path class="nz-hd--f" d={pnl.N1.head}></path>
				<path class="nz-ar nz-ar--f" d={pnl.mg1.shaft}></path><path class="nz-hd--f" d={pnl.mg1.head}></path>
				<path class="nz-ar fd-p" d={pnl.P1.shaft}></path><path class="fd-phd" d={pnl.P1.head}></path>
				<circle class="nz-dot" cx={T1.c.x} cy={T1.c.y} r="3"></circle>
				<text class="nz-sym nz-tf" x="168" y="96">N</text>
				<path class="nz-over nz-over--f" d={over(168, 96, 12)}></path>
				<text class="nz-sym nz-tf" x="152" y="214" text-anchor="end">mg</text>
				<path class="nz-over nz-over--f" d={over(130, 214, 22)}></path>
				<text class="nz-sym fd-tp" x="198" y="222">P</text>
				<path class="nz-over fd-over-p" d={over(198, 222, 11)}></path>
				<text class="nz-small fd-tp" x="200" y="242">приложен к опоре</text>
			</svg>
			<figcaption>Брусок покоится: <i>N</i> = <i>mg</i>. Вес <i>P⃗</i> приложен не к бруску, а к столу.</figcaption>
		</figure>
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 250" role="img" aria-label="Брусок покоится на наклонной плоскости с углом 30 градусов. Сила тяжести направлена вниз, сила реакции опоры перпендикулярна плоскости, сила трения покоя направлена вверх вдоль плоскости">
				<text class="nz-title" x="14" y="26">Наклонная плоскость</text>
				<path class="fd-wedge" d={`M ${f(top.x)} ${f(top.y)} L ${B.x} ${B.y} L ${f(top.x)} ${B.y} Z`}></path>
				<line class="nz-gline" x1="20" y1={B.y} x2="310" y2={B.y}></line>
				<path class="nz-line" d={arc}></path>
				<text class="nz-sym fd-angle" x="244" y="200">α</text>
				<rect class="fd-block" x={C2.x - 28} y={C2.y - 15} width="56" height="30" rx="3" transform={`rotate(30 ${f(C2.x)} ${f(C2.y)})`}></rect>
				<path class="nz-ar nz-ar--f" d={N2.shaft}></path><path class="nz-hd--f" d={N2.head}></path>
				<path class="nz-ar nz-ar--f" d={mg2.shaft}></path><path class="nz-hd--f" d={mg2.head}></path>
				<path class="nz-ar nz-ar--f" d={fr2.shaft}></path><path class="nz-hd--f" d={fr2.head}></path>
				<circle class="nz-dot" cx={f(C2.x)} cy={f(C2.y)} r="3"></circle>
				<text class="nz-sym nz-tf" x={f(C2.x + 34)} y={f(C2.y - 50)}>N</text>
				<path class="nz-over nz-over--f" d={over(C2.x + 34, C2.y - 50, 12)}></path>
				<text class="nz-sym nz-tf" x={f(C2.x - 30)} y={f(C2.y + 62)}>mg</text>
				<path class="nz-over nz-over--f" d={over(C2.x - 30, C2.y + 62, 22)}></path>
				<text class="nz-sym nz-tf" x={f(C2.x - 56)} y={f(C2.y - 22)}>F<tspan class="nz-sub" dy="5">тр</tspan></text>
				<path class="nz-over nz-over--f" d={over(C2.x - 56, C2.y - 22, 10)}></path>
			</svg>
			<figcaption>Сила <i>N⃗</i> перпендикулярна плоскости. Трение покоя направлено вверх вдоль плоскости: без него брусок соскользнул бы.</figcaption>
		</figure>
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 250" role="img" aria-label="Рука прижимает брусок к вертикальной стене. Сила руки направлена к стене, сила реакции стены от стены, сила тяжести вниз, сила трения покоя вверх">
				<text class="nz-title" x="14" y="26">Вертикальная стена</text>
				<rect class="nz-ground" x="34" y="44" width="46" height="196"></rect>
				<path class="fd-hatch" d={hatch(34, 44, 80, 240)}></path>
				<line class="nz-gline" x1="80" y1="44" x2="80" y2="240"></line>
				<rect class="fd-block" x={C3.x - 25} y={C3.y - 25} width="50" height="50" rx="3"></rect>
				<g data-fd-hand></g>
				<path class="nz-ar nz-ar--f" d={pnl.F3.shaft}></path><path class="nz-hd--f" d={pnl.F3.head}></path>
				<path class="nz-ar nz-ar--f" d={pnl.N3.shaft}></path><path class="nz-hd--f" d={pnl.N3.head}></path>
				<path class="nz-ar nz-ar--f" d={pnl.mg3.shaft}></path><path class="nz-hd--f" d={pnl.mg3.head}></path>
				<path class="nz-ar nz-ar--f" d={pnl.fr3.shaft}></path><path class="nz-hd--f" d={pnl.fr3.head}></path>
				<circle class="nz-dot" cx={C3.x} cy={C3.y} r="3"></circle>
				<text class="nz-sym nz-tf" x="30" y="118">F<tspan class="nz-sub" dy="5">руки</tspan></text>
				<path class="nz-over nz-over--f" d={over(30, 118, 10)}></path>
				<text class="nz-sym nz-tf" x="168" y="118">N</text>
				<path class="nz-over nz-over--f" d={over(168, 118, 12)}></path>
				<text class="nz-sym nz-tf" x="111" y="180">mg</text>
				<path class="nz-over nz-over--f" d={over(111, 180, 22)}></path>
				<text class="nz-sym nz-tf" x="111" y="90">F<tspan class="nz-sub" dy="5">тр</tspan></text>
				<path class="nz-over nz-over--f" d={over(111, 90, 10)}></path>
			</svg>
			<figcaption>Рука прижимает брусок к стене с силой <i>F⃗</i><sub>руки</sub>, стена действует на него с силой <i>N⃗</i>. Брусок не падает: его держит трение покоя.</figcaption>
		</figure>
		<figure class="nz-pic__panel">
			<svg class="nz-pic__svg" viewBox="0 0 320 250" role="img" aria-label="Груз висит на нити. Сила натяжения нити направлена вверх вдоль нити, сила тяжести вниз, они равны">
				<text class="nz-title" x="14" y="26">Нить</text>
				<rect class="nz-ground" x="100" y="36" width="120" height="12"></rect>
				<path class="fd-hatch" d={hatch(100, 36, 220, 48, 8)}></path>
				<line class="nz-gline" x1="100" y1="48" x2="220" y2="48"></line>
				<line class="fd-thread" x1={C4.x} y1="48" x2={C4.x} y2={C4.y - 22}></line>
				<rect class="fd-metal" x={C4.x - 22} y={C4.y - 22} width="44" height="44" rx="4"></rect>
				<path class="nz-ar nz-ar--f" d={pnl.T4.shaft}></path><path class="nz-hd--f" d={pnl.T4.head}></path>
				<path class="nz-ar nz-ar--f" d={pnl.mg4.shaft}></path><path class="nz-hd--f" d={pnl.mg4.head}></path>
				<circle class="nz-dot" cx={C4.x} cy={C4.y} r="3"></circle>
				<text class="nz-sym nz-tf" x={C4.x + 10} y={C4.y - 50}>T</text>
				<path class="nz-over nz-over--f" d={over(C4.x + 10, C4.y - 50, 10)}></path>
				<text class="nz-sym nz-tf" x={C4.x + 10} y={C4.y + 62}>mg</text>
				<path class="nz-over nz-over--f" d={over(C4.x + 10, C4.y + 62, 22)}></path>
			</svg>
			<figcaption>Сила натяжения нити <i>T⃗</i> направлена вдоль нити от груза. Груз покоится: <i>T</i> = <i>mg</i>.</figcaption>
		</figure>
	</div>
	<div class="nz-pic__foot">
		<figcaption>Силы, приложенные к телу, начинаются в его центре. Вес <i>P⃗</i> приложен к опоре, он показан пунктиром.</figcaption>
	</div>
</figure>

<style is:global>
	.fd .nz-sub,
	.fd .nz-small {
		font-size: 12.5px;
	}
	.fa-sleeve {
		stroke: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-4));
	}
	.fd-block {
		fill: hsl(30, 40%, 46%);
		stroke: hsl(28, 40%, 24%);
		stroke-width: 1.5;
	}
	:root[data-theme='light'] .fd-block {
		fill: hsl(32, 48%, 66%);
	}
	.fd-metal {
		fill: var(--nz-metal);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.fd-wedge {
		fill: var(--nz-ground);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.fd-hatch {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		fill: none;
	}
	.fd-thread {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
	}
	.fd-p {
		stroke: var(--sl-color-gray-2);
		stroke-dasharray: 5 4;
		stroke-linecap: butt;
	}
	.fd-phd {
		fill: var(--sl-color-gray-2);
	}
	.nz-pic .fd-tp {
		fill: var(--sl-color-gray-2);
	}
	.fd-over-p {
		stroke: var(--sl-color-gray-2);
	}
	.nz-pic .fd-angle {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
		font-weight: 400;
	}
</style>

<script>
	import { ROLL } from '@components/people/hand';
	import { nzArm } from './nzArm';

	// The hand presses the block's right face (x = 130) with a flat palm, fingers up; the forearm comes from the lower right.
	for (const root of document.querySelectorAll<HTMLElement>('[data-fd]')) {
		const g = root.querySelector<SVGGElement>('[data-fd-hand]');
		if (!g || g.childElementCount) continue;
		nzArm(g, { Lh: 46, side: 'L', sleeve: 'fa-sleeve', reach: 200 })({ at: { x: 130, y: 132 }, pose: 'flat', dir: -Math.PI / 2, roll: ROLL.palmCcw + 0.6, bend: -1.1 });
	}
</script>
