---
/**
 * Frame and shared marks of the explanatory pictures of «Законы Ньютона» (panels, captions, arrows). Renders nothing.
 * Colors as in the models of the chapter: forces --ig-vy, velocity --ig-v, acceleration --ig-vx.
 */
---

<style is:global>
	.nz-pic {
		--nz-f: var(--ig-vy);
		--nz-v: var(--ig-v);
		--nz-a: var(--ig-vx);
		--nz-ground: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
		--nz-metal: color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--ig-vx));
		--nz-body: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
		--nz-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--nz-water: color-mix(in srgb, var(--ig-vx) 24%, transparent);
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .nz-pic {
		--nz-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.nz-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.nz-pic--one .nz-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 36rem;
		margin-inline: auto;
	}
	.nz-pic__panel {
		margin: 0;
		display: flex;
		flex-direction: column;
	}
	.nz-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.nz-pic__panel figcaption,
	.nz-pic__foot figcaption {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.nz-pic figcaption i {
		font-family: var(--ig-font-math);
	}
	.nz-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.nz-pic__foot figcaption {
		margin: 0;
	}
	.nz-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.nz-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.nz-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.nz-pic .nz-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.nz-pic .nz-sym {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 17px;
		font-weight: 700;
	}
	.nz-pic .nz-sub {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 11px;
		font-weight: 600;
	}
	.nz-pic .nz-tf {
		fill: var(--nz-f);
	}
	.nz-pic .nz-tv {
		fill: var(--nz-v);
	}
	.nz-pic .nz-ta {
		fill: var(--nz-a);
	}
	.nz-pic .nz-small {
		font-size: 11.5px;
	}
	.nz-ar {
		stroke-width: 3.2;
		stroke-linecap: round;
		fill: none;
	}
	.nz-ar--f {
		stroke: var(--nz-f);
	}
	.nz-ar--v {
		stroke: var(--nz-v);
	}
	.nz-ar--a {
		stroke: var(--nz-a);
	}
	.nz-ar--dash {
		stroke-dasharray: 6 4;
		stroke-linecap: butt;
	}
	.nz-hd--f {
		fill: var(--nz-f);
	}
	.nz-hd--v {
		fill: var(--nz-v);
	}
	.nz-hd--a {
		fill: var(--nz-a);
	}
	.nz-over {
		stroke-width: 1.4;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.nz-over--f {
		stroke: var(--nz-f);
	}
	.nz-over--v {
		stroke: var(--nz-v);
	}
	.nz-over--a {
		stroke: var(--nz-a);
	}
	.nz-ground {
		fill: var(--nz-ground);
	}
	.nz-gline {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.nz-line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		fill: none;
	}
	.nz-dot {
		fill: var(--sl-color-gray-1);
	}
	@media (max-width: 40rem) {
		.nz-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
