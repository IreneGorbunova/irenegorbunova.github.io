---
/**
 * «Силы и оси» (section «Силы в механике. Второй закон Ньютона в проекциях»): the forces on a body in four cases, to one
 * scale per tab, and the second law in projections. g = 9,8 Н/кг; every body starts from rest.
 *   Горизонтальная плоскость: a block m on a table pulled horizontally with F_тяги. N = mg; static friction = F_тяги while
 *     F_тяги ≤ μN, otherwise kinetic friction μN and a = (F_тяги − μN)/m. Scale 2,5 px/Н; 1 m = 260 px.
 *   Наклонная плоскость: m = 2 кг, angle α. N = mg cos α; static friction = mg sin α while mg sin α ≤ μN (tg α ≤ μ),
 *     otherwise μN and a = g(sin α − μ cos α). x down the plane, y perpendicular, out of it. Scale 5 px/Н; 1 m = 225 px; the axes reach past the longest arrow.
 *   Вертикальная стена: m = 1 кг pressed to the wall by a hand with F_руки (perpendicular to the wall; friction between
 *     the palm and the block is not taken into account). N = F_руки; static friction = mg while mg ≤ μN, otherwise μN and
 *     a = g − μN/m, down. x down, y away from the wall. Scale 5 px/Н; 1 m = 200 px. The hand: people kit (nzArm.ts).
 *   Нить через блок: m₁ on the table, a light thread over a light pulley without friction to a hanging m₂; T is the same
 *     on both bodies. Moving when m₂g > μm₁g: a = (m₂ − μm₁)g/(m₁ + m₂), T = m₂(g − a); at rest T = m₂g and static
 *     friction = m₂g. Axes: body 1 x toward the pulley, y up; body 2 x down. Scale 5 px/Н; 1 m = 187,5 px.
 * A moving body slides 1 m (0,6 m on the incline and the pulley) in real time, waits 0,9 s and starts again.
 * Numbers: 3 significant figures (2 decimals below 10). Checked by review/nyut2/check_forces.py.
 */
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = `fa-${Math.random().toString(36).slice(2, 8)}`;
const tabs = ['Горизонтальная плоскость', 'Наклонная плоскость', 'Вертикальная стена', 'Нить через блок'];
const hatch = (x0: number, y0: number, x1: number, y1: number, step = 10) => {
	let s = '';
	for (let k = x0 - (y1 - y0); k < x1; k += step) {
		const xa = Math.max(k, x0);
		const xb = Math.min(k + (y1 - y0), x1);
		s += `M ${xa.toFixed(1)} ${(y1 - (xa - k)).toFixed(1)} L ${xb.toFixed(1)} ${(y1 - (xb - k)).toFixed(1)} `;
	}
	return s;
};
---

<PeopleStyles />
<figure class="fa not-content" data-fa>
	<div class="fa__tabs" role="tablist" aria-label="Где лежит тело">
		{
			tabs.map((t, i) => (
				<button type="button" role="tab" id={`${uid}-t${i}`} aria-controls={`${uid}-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'} data-tab={i}>
					{t}
				</button>
			))
		}
	</div>

	<div class="fa__panel" role="tabpanel" id={`${uid}-p0`} aria-labelledby={`${uid}-t0`} data-panel="0">
		<svg class="fa__svg" viewBox="0 0 480 420" role="img" aria-label="Брусок на горизонтальном столе, его тянут с силой тяги">
			<rect class="fa__ground" x="10" y="260" width="460" height="26"></rect>
			<line class="fa__gline" x1="10" y1="260" x2="470" y2="260"></line>
			<g data-scene></g>
		</svg>
		<div class="fa__controls">
			<label class="fa__slider"><span>Сила тяги <i>F</i><sub>тяги</sub></span><output data-out="F"></output><input type="range" min="0" max="30" step="1" value="10" data-in="F" /></label>
			<label class="fa__slider"><span>Масса бруска <i>m</i></span><output data-out="m"></output><input type="range" min="1" max="4" step="0.5" value="2" data-in="m" /></label>
			<label class="fa__slider"><span>Коэффициент трения <i>μ</i></span><output data-out="mu"></output><input type="range" min="0" max="0.6" step="0.05" value="0.3" data-in="mu" /></label>
		</div>
	</div>

	<div class="fa__panel" role="tabpanel" id={`${uid}-p1`} aria-labelledby={`${uid}-t1`} data-panel="1" hidden>
		<svg class="fa__svg" viewBox="0 0 480 400" role="img" aria-label="Брусок массой 2 килограмма на наклонной плоскости">
			<path class="fa__wedge" data-wedge></path>
			<line class="fa__gline" x1="10" y1="300" x2="470" y2="300"></line>
