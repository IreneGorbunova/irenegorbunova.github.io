			<g data-scene></g>
		</svg>
		<div class="fa__controls">
			<label class="fa__slider"><span>Угол наклона <i>α</i></span><output data-out="al"></output><input type="range" min="0" max="60" step="1" value="20" data-in="al" /></label>
			<label class="fa__slider"><span>Коэффициент трения <i>μ</i></span><output data-out="mu"></output><input type="range" min="0" max="1" step="0.05" value="0.5" data-in="mu" /></label>
		</div>
	</div>

	<div class="fa__panel" role="tabpanel" id={`${uid}-p2`} aria-labelledby={`${uid}-t2`} data-panel="2" hidden>
		<svg class="fa__svg" viewBox="0 0 480 420" role="img" aria-label="Рука прижимает брусок массой 1 килограмм к вертикальной стене">
			<rect class="fa__ground" x="120" y="0" width="50" height="420"></rect>
			<path class="fa__hatch" d={hatch(120, 0, 170, 420)}></path>
			<line class="fa__gline" x1="170" y1="0" x2="170" y2="420"></line>
			<g data-hand></g>
			<g data-scene></g>
		</svg>
		<div class="fa__controls">
			<label class="fa__slider"><span>Рука давит с силой <i>F</i><sub>руки</sub></span><output data-out="F"></output><input type="range" min="0" max="40" step="1" value="30" data-in="F" /></label>
			<label class="fa__slider"><span>Коэффициент трения <i>μ</i></span><output data-out="mu"></output><input type="range" min="0.1" max="1" step="0.05" value="0.4" data-in="mu" /></label>
		</div>
	</div>

	<div class="fa__panel" role="tabpanel" id={`${uid}-p3`} aria-labelledby={`${uid}-t3`} data-panel="3" hidden>
		<svg class="fa__svg" viewBox="0 0 480 460" role="img" aria-label="Брусок на столе связан нитью, перекинутой через блок, с висящим грузом">
			<rect class="fa__ground" x="10" y="170" width="370" height="24"></rect>
			<line class="fa__gline" x1="10" y1="170" x2="380" y2="170"></line>
			<line class="fa__gline" x1="380" y1="170" x2="380" y2="194"></line>
			<path class="fa__bracket" d="M 372 170 L 394 162 M 380 194 L 394 162"></path>
			<circle class="fa__pulley" cx="394" cy="162" r="14"></circle>
			<circle class="fa__hub" cx="394" cy="162" r="3"></circle>
			<path class="fa__thread" data-thread></path>
			<g data-scene></g>
		</svg>
		<div class="fa__controls">
			<label class="fa__slider"><span>Масса бруска на столе <i>m</i><sub>1</sub></span><output data-out="m1"></output><input type="range" min="0.5" max="2" step="0.5" value="1" data-in="m1" /></label>
			<label class="fa__slider"><span>Масса груза <i>m</i><sub>2</sub></span><output data-out="m2"></output><input type="range" min="0.1" max="2" step="0.1" value="0.5" data-in="m2" /></label>
			<label class="fa__slider"><span>Коэффициент трения <i>μ</i></span><output data-out="mu"></output><input type="range" min="0" max="0.6" step="0.05" value="0.2" data-in="mu" /></label>
		</div>
	</div>

	<div class="fa__bar">
		<button type="button" class="fa__btn" aria-pressed="false" data-axes>Оси</button>
		<span class="fa__hint">оси <i>x</i> и <i>y</i>, проекции сил и второй закон Ньютона в проекциях</span>
	</div>
	<p class="fa__live" aria-live="polite" data-live></p>
	<div class="fa__calc" data-calc hidden>
