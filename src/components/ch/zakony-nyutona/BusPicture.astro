---
/**
 * Picture to inertial frames: a bus seen from inside (the camera moves with the bus). A toy car with light wheels
 * stands on the floor. The bus goes at 8 m/s for 1 s, then brakes with 2,5 m/s² for 1,6 s down to 4 m/s. The toy car
 * rolls almost without friction, so relative to the road it keeps 8 m/s; relative to the bus it moves forward with
 * 2,5 m/s²: 1,25 t² = 3,2 m in 1,6 s, reaching 4 m/s. Scale 55 px per metre, real time; the posts outside are 3 m
 * apart and slide back at the bus's speed. Ghosts show the toy car every 0,2 s of the braking (relative to the bus).
 */
import NzPicStyles from './NzPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const clip = `bp-clip-${uid}`;
const K = 55; // px per metre
const FLOOR = 166;
const X0 = 30; // the toy car's rear at the start, px
const windows = [
	[18, 112],
	[124, 218],
	[230, 312],
];
---

<NzPicStyles />
<figure class="nz-pic nz-pic--one bp not-content" data-buspic data-k={K} data-floor={FLOOR} data-x0={X0}>
	<div class="nz-pic__grid">
		<svg class="nz-pic__svg" viewBox="0 0 360 200" role="img" aria-label="Автобус изнутри. Автобус тормозит, а игрушечная машинка на полу катится вперёд. Относительно дороги её скорость не меняется, относительно автобуса — растёт">
			<defs>
				<clipPath id={clip}>
					{windows.map(([a, b]) => <rect x={a} y="24" width={b - a} height="62" rx="5" />)}
					<rect x="318" y="24" width="30" height="132" rx="5"></rect>
				</clipPath>
			</defs>
			<!-- outside, seen through the windows -->
			<g clip-path={`url(#${clip})`}>
				<rect class="bp-sky" x="0" y="0" width="360" height="200"></rect>
				<rect class="bp-out-ground" x="0" y="74" width="360" height="90"></rect>
				<g data-posts>
					{
						[0, 1, 2, 3].map(() => (
							<g data-post>
								<line class="bp-post" x1="0" y1="28" x2="0" y2="80" />
								<path class="bp-lamp" d="M 0 30 q 8 -2 12 2" />
							</g>
						))
					}
				</g>
			</g>
			<!-- the bus body -->
			<path class="bp-shell" fill-rule="evenodd" d={`M 4 12 H 340 Q 356 12 356 28 V 190 H 4 Z ${windows.map(([a, b]) => `M ${a + 5} 24 H ${b - 5} Q ${b} 24 ${b} 29 V 81 Q ${b} 86 ${b - 5} 86 H ${a + 5} Q ${a} 86 ${a} 81 V 29 Q ${a} 24 ${a + 5} 24 Z`).join(' ')} M 323 24 H 343 Q 348 24 348 29 V 151 Q 348 156 343 156 H 323 Q 318 156 318 151 V 29 Q 318 24 323 24 Z`}></path>
			<line class="bp-rail" x1="10" y1="96" x2="310" y2="96"></line>
			<!-- seats along the far wall -->
			{
				[34, 120, 206].map((x) => (
					<g>
						<line class="bp-seat" x1={x + 24} y1="140" x2={x + 24} y2={FLOOR} />
						<rect class="bp-seat-back" x={x} y="132" width="50" height="9" rx="3" />
						<rect class="bp-seat-back" x={x + 42} y="100" width="9" height="40" rx="3" />
					</g>
				))
			}
			<rect class="bp-floor" x="4" y={FLOOR} width="352" height="24"></rect>
			<line class="bp-floor-line" x1="4" y1={FLOOR} x2="356" y2={FLOOR}></line>
			<text class="bp-dir" x="300" y="183" text-anchor="end">движение автобуса →</text>
			<g data-ghosts></g>
			<!-- the toy car (0,4 m long) -->
			<g data-toy>
				<rect class="bp-toy" x="0" y={FLOOR - 13} width="22" height="8" rx="2"></rect>
				<path class="bp-toy" d={`M 5 ${FLOOR - 13} L 8 ${FLOOR - 18} L 15 ${FLOOR - 18} L 18 ${FLOOR - 13} Z`}></path>
				<circle class="bp-toy-wheel" cx="5" cy={FLOOR - 3} r="3"></circle>
				<circle class="bp-toy-wheel" cx="17" cy={FLOOR - 3} r="3"></circle>
			</g>
			<!-- the bus brakes: its acceleration -->
			<g data-brake opacity="0">
				<path class="nz-ar nz-ar--a" d="M 210 112 L 152 112"></path>
				<path class="nz-hd--a" d="M 144 112 L 154 107.5 L 154 116.5 Z"></path>
				<text class="bp-alabel" x="214" y="116">автобус тормозит</text>
			</g>
		</svg>
	</div>
	<dl class="bp-read">
		<div><dt>Скорость автобуса</dt><dd data-vbus>8,0 м/с</dd></div>
		<div><dt>Машинка относительно дороги</dt><dd data-vroad>8,0 м/с</dd></div>
		<div><dt>Машинка относительно автобуса</dt><dd data-vrel>0,0 м/с</dd></div>
	</dl>
	<div class="nz-pic__foot">
		<figcaption>Автобус тормозит с ускорением 2,5&nbsp;м/с², колёса машинки катятся почти без трения. Относительно дороги машинка сохраняет скорость, а относительно автобуса разгоняется вперёд, хотя её никто не толкает.</figcaption>
		<button type="button" class="nz-pic__again" data-again>Повторить</button>
	</div>
</figure>

<style is:global>
	.bp-sky {
		fill: color-mix(in srgb, var(--ig-vx) 16%, var(--sl-color-bg));
	}
	.bp-out-ground {
		fill: color-mix(in srgb, var(--ig-v) 20%, var(--sl-color-gray-5));
	}
	.bp-post {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.bp-lamp {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.bp-shell {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 85%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.bp-rail {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.bp-seat {
		stroke: var(--sl-color-gray-4);
		stroke-width: 4;
	}
	.bp-seat-back {
		fill: var(--sl-color-gray-4);
	}
	.bp-floor {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 60%, var(--sl-color-bg));
	}
	.bp-floor-line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.nz-pic .bp-dir {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
		stroke: none;
	}
	.nz-pic .bp-alabel {
		font-size: 12px;
		fill: var(--nz-a);
		font-weight: 600;
	}
	.bp-toy {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.bp-ghost {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 1;
		opacity: 0.5;
	}
	.bp-toy-wheel {
		fill: var(--sl-color-gray-1);
	}
	.bp-read {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0.6rem 0 0;
	}
	.bp-read div {
		padding: 0.35rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
	}
	.bp-read dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		line-height: 1.3;
	}
	.bp-read dd {
		margin: 0;
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	@media (max-width: 40rem) {
		.bp-read {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.3rem;
		}
		.bp-read div {
			display: flex;
			justify-content: space-between;
			gap: 0.5rem;
			align-items: baseline;
		}
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const V0 = 8; // m/s
	const A = 2.5; // m/s², braking
	const T1 = 1; // s of steady motion before braking
	const TB = 1.6; // s of braking
	const STEP = 3; // m between the posts
	const fmt = (v: number) => v.toFixed(1).replace('.', ',');

	for (const root of document.querySelectorAll<HTMLElement>('[data-buspic]')) {
		const K = Number(root.dataset.k);
		const FLOOR = Number(root.dataset.floor);
		const X0 = Number(root.dataset.x0);
		const toy = root.querySelector<SVGGElement>('[data-toy]')!;
		const posts = Array.from(root.querySelectorAll<SVGGElement>('[data-post]'));
		const brake = root.querySelector<SVGGElement>('[data-brake]')!;
		const ghosts = root.querySelector<SVGGElement>('[data-ghosts]')!;
		const vBus = root.querySelector<HTMLElement>('[data-vbus]')!;
		const vRoad = root.querySelector<HTMLElement>('[data-vroad]')!;
		const vRel = root.querySelector<HTMLElement>('[data-vrel]')!;
		let shown = -1;

		const draw = (x: number) => {
			const t = x * (T1 + TB);
			const tb = Math.max(0, t - T1); // time of braking
			const vb = V0 - A * tb;
			const busPath = V0 * t - (A * tb * tb) / 2; // m along the road
			const rel = (A * tb * tb) / 2; // the toy car relative to the bus, m
			toy.setAttribute('transform', `translate(${(X0 + rel * K).toFixed(2)} 0)`);
			const off = ((busPath % STEP) + STEP) % STEP;
			posts.forEach((p, i) => p.setAttribute('transform', `translate(${(40 + (i * STEP - off) * K).toFixed(2)} 0)`));
			brake.setAttribute('opacity', tb > 0 ? '1' : '0');
			vBus.textContent = `${fmt(vb)} м/с`;
			vRoad.textContent = `${fmt(V0)} м/с`;
			vRel.textContent = `${fmt(A * tb)} м/с`;
			// ghosts every 0,2 s of braking
			const n = tb > 0 ? Math.floor(tb / 0.2 + 1e-9) : -1;
			if (n !== shown) {
				ghosts.replaceChildren();
				for (let k = 0; k <= n; k++) {
					const r = (A * (k * 0.2) ** 2) / 2;
					const g = document.createElementNS(NS, 'rect');
					g.setAttribute('class', 'bp-ghost');
					g.setAttribute('x', (X0 + r * K).toFixed(2));
					g.setAttribute('y', String(FLOOR - 13));
					g.setAttribute('width', '22');
					g.setAttribute('height', '8');
					g.setAttribute('rx', '2');
					ghosts.append(g);
				}
				shown = n;
			}
		};
		scene(root, T1 + TB, draw);
	}
</script>
