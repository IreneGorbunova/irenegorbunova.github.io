---
/**
 * Two looping opening scenes of «Силы в механике». No terms of the chapter in the pictures.
 *
 * Sled: a girl (130 см) on a plastic sled slides down a snow slope of 25°, 6 м long (2,5 м high), and then on level
 *   snow until she stops. Snow under the sled: μ = 0,1. On the slope a = g(sin 25° − μ cos 25°) = 3,25 м/с², so she
 *   reaches the bottom after 1,92 с at 6,25 м/с; on the level a = −μg = −0,98 м/с², she stops after 6,4 с more,
 *   19,9 м further. Real time, 8,3 с. 40 px per metre; the camera follows her, the slope and the trees stay in place.
 * Station: the Earth (R = 6371 км) drawn to scale, 150 px, and the orbit of the space station 420 км above it
 *   (1,066 R, 160 px): it goes round in 92,8 мин at 7,66 км/с. The clock of the picture runs 60 times faster than a
 *   real one (the station covers 50° in 13 с of the scene). In the window: a cosmonaut (175 см), an apple and a drop
 *   of water float in the cabin, drifting a few centimetres a second (real time there).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import WinterStyles from '../dinamika-zakony-nyutona/WinterStyles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const K = 40; // px per metre in the sled scene
const SL = 6; // slope, м
const AL = (25 * Math.PI) / 180;
const X1 = SL * Math.cos(AL); // м, the foot of the slope
const H1 = SL * Math.sin(AL);
const GROUND = 200; // px, the level snow
// the snow: a plateau 3 м long, the slope, the level; in world px (x from the top edge of the slope)
const snow = `M${-3 * K} ${GROUND - H1 * K} L0 ${(GROUND - H1 * K).toFixed(1)} L${(X1 * K).toFixed(1)} ${GROUND} L${(X1 + 30) * K} ${GROUND} L${(X1 + 30) * K} 260 L${-3 * K} 260 Z`;
const trees = [-2.2, 8.5, 13, 19.5, 25, 31].map((x, i) => ({ x: x * K, h: 46 + (i % 3) * 14 }));
const stars = Array.from({ length: 50 }, (_, i) => ({ x: (i * 71.3) % 360, y: (i * 37.9) % 150, r: i % 7 === 0 ? 1.1 : 0.6 }));
---

<WinterStyles />
<PeopleStyles />
<IntroFrame data-smintro>
	<div class="intro__card" data-scene="sled">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка на санках скатывается с горки, а внизу катится всё медленнее и останавливается">
			<rect class="sm-sky" x="0" y="0" width="360" height="240"></rect>
			<path class="sm-far" d="M0 150 Q60 112 130 134 T260 120 T360 128 V240 H0 Z"></path>
			<g data-world>
				{trees.map((t) => (
					<g transform={`translate(${t.x.toFixed(1)} ${GROUND + 2})`}>
						<rect class="sm-trunk" x="-2" y="-10" width="4" height="10" />
						<path class="sm-fir" d={`M0 ${-t.h} L${t.h * 0.3} ${-t.h * 0.45} H${t.h * 0.12} L${t.h * 0.38} -8 H${-t.h * 0.38} L${-t.h * 0.12} ${-t.h * 0.45} H${-t.h * 0.3} Z`} />
					</g>
				))}
				<path class="sm-snow" d={snow}></path>
				<path class="sm-track" data-track d=""></path>
				<g data-sled>
					<g class="dn-w"><g data-girl class="dn-hat2"></g></g>
					<path class="sm-sledge" d="M-20 0 H14 Q22 0 22 -7 L19 -7 Q19 -3 14 -3 H-20 Z"></path>
				</g>
			</g>
			<text class="sm-num" x="350" y="230" text-anchor="end" data-v></text>
		</svg>
		<div class="intro__foot">
			<p>
				Под горку санки сами разгоняются, а внизу, на ровном снегу,{' '}
				<More term="катятся всё медленнее и останавливаются">
					На склоне санки тянет вниз притяжение Земли, а снег тормозит их трением, но слабее: санки разгоняются с ускорением 3,25&nbsp;м/с² и внизу едут со скоростью 6,25&nbsp;м/с. На ровном месте остаётся только трение о снег, и через 20&nbsp;м санки стоят. Об этом — в разделе <a href="#сила-трения">«Сила трения»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="station">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Космическая станция летит вокруг Земли, а в её кабине плавают космонавт, яблоко и капля воды">
			<rect class="sm-space" x="0" y="0" width="360" height="240"></rect>
			{stars.map((s) => <circle class="sm-star" cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r} />)}
			<circle class="sm-glow" cx="130" cy="330" r="156"></circle>
			<circle class="sm-earth" cx="130" cy="330" r="150"></circle>
			<path class="sm-land" d="M10 260 Q40 215 90 222 T170 200 Q205 196 220 230 L250 250 Q230 270 200 262 T120 268 Q70 280 30 290 Z"></path>
			<circle class="sm-orbit" cx="130" cy="330" r="160"></circle>
			<g data-iss>
				<rect class="sm-panel" x="-11" y="-6" width="6" height="12"></rect>
				<rect class="sm-panel" x="5" y="-6" width="6" height="12"></rect>
				<rect class="sm-module" x="-5" y="-1.6" width="10" height="3.2" rx="1"></rect>
			</g>
			<text class="sm-small" x="12" y="20">420 км над Землёй</text>
			<!-- the cabin window -->
			<g transform="translate(206 14)">
				<rect class="sm-cabin" x="0" y="0" width="144" height="136" rx="10"></rect>
				<path class="sm-rail" d="M8 120 H136 M8 16 H136"></path>
				{[0, 1, 2, 3].map((i) => <rect class="sm-box" x={14 + i * 30} y="122" width="24" height="10" rx="2" />)}
				<g data-astro-g>
					<g data-astro></g>
				</g>
				<g data-apple>
					<circle class="sm-apple" r="5"></circle>
					<path class="sm-stem" d="M0 -5 L1 -8"></path>
					<path class="sm-leaf" d="M1 -7 Q5 -9 6 -6 Q3 -5 1 -7 Z"></path>
				</g>
				<circle class="sm-drop" data-drop r="4.5"></circle>
				<circle class="sm-drop-hi" data-drophi r="1.3"></circle>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Станция летит всего в 420&nbsp;км над Землёй, а{' '}
				<More term="космонавт, яблоко и капля воды плавают в кабине">
					Земля притягивает их там лишь на 12&nbsp;% слабее, чем у поверхности. Но станция и всё, что в ней, движутся вокруг Земли с одним и тем же ускорением — они непрерывно «падают» вместе, со скоростью 7,7&nbsp;км/с огибая Землю, и ничто ни на что не давит. Полёт станции на рисунке ускорен в 60 раз: на самом деле оборот занимает 93&nbsp;мин. Об этом — в разделах <a href="#первая-космическая-скорость">«Первая космическая скорость»</a> и <a href="#вес-тела-невесомость">«Вес тела. Невесомость»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-smintro] {
		--sm-sky: hsl(212, 45%, 30%);
		--sm-far: hsl(212, 25%, 55%);
		--sm-snow: hsl(205, 40%, 94%);
		--sm-space: hsl(232, 40%, 9%);
	}
	:root[data-theme='light'] [data-smintro] {
		--sm-sky: hsl(205, 70%, 84%);
		--sm-far: hsl(210, 25%, 74%);
		--sm-snow: hsl(205, 45%, 97%);
		--sm-space: hsl(232, 35%, 16%);
	}
	[data-smintro] .sm-sky { fill: var(--sm-sky); }
	[data-smintro] .sm-far { fill: var(--sm-far); }
	[data-smintro] .sm-snow { fill: var(--sm-snow); stroke: hsl(205, 30%, 72%); stroke-width: 1; }
	[data-smintro] .sm-track { fill: none; stroke: hsl(205, 30%, 75%); stroke-width: 1.4; }
	[data-smintro] .sm-trunk { fill: hsl(28, 35%, 30%); }
	[data-smintro] .sm-fir { fill: hsl(150, 35%, 28%); stroke: hsl(150, 30%, 18%); stroke-width: 0.6; }
	[data-smintro] .sm-sledge { fill: var(--ig-vy); stroke: hsl(222, 35%, 14%); stroke-width: 0.7; }
	[data-smintro] .sm-num { font-size: 13px; font-weight: 700; fill: hsl(222, 35%, 20%); }
	[data-smintro] .sm-space { fill: var(--sm-space); }
	[data-smintro] .sm-star { fill: white; opacity: 0.6; }
	[data-smintro] .sm-glow { fill: hsl(205, 80%, 60%); opacity: 0.25; }
	[data-smintro] .sm-earth { fill: hsl(210, 60%, 38%); }
	[data-smintro] .sm-land { fill: hsl(120, 25%, 40%); opacity: 0.9; }
	[data-smintro] .sm-orbit { fill: none; stroke: hsl(45, 80%, 70%); stroke-width: 0.8; stroke-dasharray: 3 4; opacity: 0.7; }
	[data-smintro] .sm-panel { fill: hsl(215, 60%, 45%); stroke: hsl(215, 40%, 80%); stroke-width: 0.5; }
	[data-smintro] .sm-module { fill: hsl(0, 0%, 88%); }
	[data-smintro] .sm-small { font-size: 12px; fill: hsl(220, 20%, 85%); }
	[data-smintro] .sm-cabin { fill: hsl(210, 15%, 86%); stroke: hsl(210, 10%, 60%); stroke-width: 2; }
	[data-smintro] .sm-rail { stroke: hsl(210, 10%, 66%); stroke-width: 2; }
	[data-smintro] .sm-box { fill: hsl(40, 40%, 70%); stroke: hsl(40, 25%, 50%); stroke-width: 0.7; }
	[data-smintro] .sm-apple { fill: hsl(2, 75%, 55%); stroke: hsl(2, 60%, 35%); stroke-width: 0.6; }
	[data-smintro] .sm-stem { stroke: hsl(28, 40%, 30%); stroke-width: 1; }
	[data-smintro] .sm-leaf { fill: hsl(120, 50%, 40%); }
	[data-smintro] .sm-drop { fill: hsl(200, 80%, 60%); opacity: 0.75; stroke: hsl(200, 70%, 40%); stroke-width: 0.6; }
	[data-smintro] .sm-drop-hi { fill: white; opacity: 0.8; }
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { person, ANKLE } from '../davlenie-zakon-paskalya/person';
	import { human } from '../mehanicheskaya-rabota/people';

	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-smintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="sled"]')!;
			const K = 40;
			const G = 9.8;
			const MU = 0.1;
			const AL = (25 * Math.PI) / 180;
			const SL = 6;
			const X1 = SL * Math.cos(AL);
			const H1 = SL * Math.sin(AL);
			const GROUND = 200;
			const a1 = G * (Math.sin(AL) - MU * Math.cos(AL));
			const t1 = Math.sqrt((2 * SL) / a1);
			const v1 = a1 * t1;
			const a2 = MU * G;
			const t2 = v1 / a2;
			const RUN = t1 + t2;
			const S = 0.4; // px per см
			const girl = person(card.querySelector<SVGGElement>('[data-girl]')!, { s: S, H: 130, girth: 0.95, gear: 'boot', coat: 'dn-coat--green' });
			const u = S * 130;
			// sitting on the sled, legs forward, the mittens hold the sides of the sled beside the knees, within reach of
			// the arms (sled frame: x along, y up negative)
			const seat = -3;
			girl({
				hip: { x: -10, y: seat - 0.04 * u },
				lean: -0.05,
				ankles: [
					{ x: 0.36 * u - 10, y: seat - ANKLE.boot * S - 1 },
					{ x: 0.33 * u - 10, y: seat - ANKLE.boot * S - 1 },
				],
				feet: [-0.2, -0.2],
				hands: [
					{ x: 3, y: -6 },
					{ x: 1, y: -6 },
				],
			});
			const world = card.querySelector<SVGGElement>('[data-world]')!;
			const sled = card.querySelector<SVGGElement>('[data-sled]')!;
			const track = card.querySelector('[data-track]')!;
			const vtext = card.querySelector('[data-v]')!;
			const top = GROUND - H1 * K;
			scene(card, RUN, (q) => {
				const t = q * RUN;
				let x: number;
				let y: number;
				let rot: number;
				let v: number;
				if (t < t1) {
					const s = 0.5 * a1 * t * t;
					x = s * Math.cos(AL) * K;
					y = top + s * Math.sin(AL) * K;
					v = a1 * t;
					rot = 25;
				} else {
					const tt = t - t1;
					const s = v1 * tt - 0.5 * a2 * tt * tt;
					x = (X1 + s) * K;
					y = GROUND;
					v = v1 - a2 * tt;
					rot = 25 * Math.max(0, 1 - tt / 0.15); // the sled levels out at the foot
				}
				sled.setAttribute('transform', `translate(${f1(x)} ${f1(y)}) rotate(${f1(rot)})`);
				const cam = Math.max(0, x - 120);
				world.setAttribute('transform', `translate(${f1(-cam + 40)} 0)`);
				track.setAttribute('d', `M0 ${f1(top)} ${t < t1 ? `L${f1(x)} ${f1(y)}` : `L${f1(X1 * K)} ${GROUND} L${f1(x)} ${GROUND}`}`);
				vtext.textContent = `${v.toFixed(1).replace('.', ',')} м/с`;
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="station"]')!;
			const iss = card.querySelector<SVGGElement>('[data-iss]')!;
			const astroG = card.querySelector<SVGGElement>('[data-astro-g]')!;
			const apple = card.querySelector<SVGGElement>('[data-apple]')!;
			const drop = card.querySelector('[data-drop]')!;
			const hi = card.querySelector('[data-drophi]')!;
			const S = 0.36; // px per см in the cabin
			const H = 175;
			const u = S * H;
			const astro = human(card.querySelector<SVGGElement>('[data-astro]')!, { s: S, H, shirt: 'hm-blue', hair: 'short' });
			// a relaxed floating pose: knees a little bent, arms half raised
			astro({
				hip: { x: 0, y: 0 },
				lean: 0,
				ankles: [
					{ x: 0.06 * u, y: 0.44 * u },
					{ x: -0.02 * u, y: 0.42 * u },
				],
				feet: [0.5, 0.4],
				hands: [
					{ x: 0.3 * u, y: -0.24 * u },
					{ x: 0.22 * u, y: -0.12 * u },
				],
			});
			const RUN = 13;
			scene(card, RUN, (q) => {
				const t = q * RUN; // s of the scene; the orbit runs 60 times faster
				const th = (-115 + (360 * (t * 60)) / (92.8 * 60)) * (Math.PI / 180);
				iss.setAttribute('transform', `translate(${f1(130 + 160 * Math.cos(th))} ${f1(330 + 160 * Math.sin(th))}) rotate(${f1((th * 180) / Math.PI + 90)})`);
				// the cabin: real time, slow drift
				astroG.setAttribute('transform', `translate(${f1(60 + 6 * Math.sin(t * 0.35))} ${f1(62 + 4 * Math.sin(t * 0.27 + 1))}) rotate(${f1(-28 + 10 * Math.sin(t * 0.22))})`);
				apple.setAttribute('transform', `translate(${f1(112 + 5 * Math.sin(t * 0.4 + 2))} ${f1(40 + 6 * Math.sin(t * 0.3))}) rotate(${f1(t * 12)})`);
				const dx = 116 + 4 * Math.sin(t * 0.33 + 4);
				const dy = 92 + 5 * Math.sin(t * 0.25 + 3);
				drop.setAttribute('cx', f1(dx));
				drop.setAttribute('cy', f1(dy));
				hi.setAttribute('cx', f1(dx - 1.5));
				hi.setAttribute('cy', f1(dy - 1.5));
			});
		}
	}
</script>
