---
/**
 * Two looping opening scenes of «Силы в механике» (redrawn 23 Nov 2026 with the shared people kit). No terms of the
 * chapter in the pictures; the captions' popovers explain.
 *
 * Sled: a winter park. A girl (130 см, the kit, a child) sits on a plastic sled 80 см long, her mittens on its side
 *   handle, and slides down a snow slope of 25°, 6 м long (2,5 м high), then on level snow until she stops. Snow
 *   under the sled: μ = 0,1. On the slope a = g(sin 25° − μ cos 25°) = 3,25 м/с², so she reaches the bottom after
 *   1,92 с at 6,25 м/с; on the level a = −μg = −0,98 м/с², she stops after 6,4 с more, 19,9 м further. Real time,
 *   8,3 с. 40 px per metre (0,4 px per см for the people); the camera follows her. Her father (175 см) stands at the
 *   top and waves. Depth: far hills with tiny firs and two children by a snowman (0,14 px per см) move by at a quarter
 *   of the camera's speed, a middle row of firs at 0,6 of it.
 * Station (redrawn 23 Nov 2026 at the reviewer's request; the grade-9 scene already has floating bodies): a cosmonaut
 *   (175 см, the kit, 1 px per см) measures his mass with a spring device, as on Soviet stations and the ISS. He sits on
 *   a carriage with a seat and a footrest that slides along a column between two springs (1400 Н/м in all), knees up,
 *   hands on the handles; he and the carriage (75 + 15 кг) swing with T = 2π√(90/1400) = 1,593 с, 10 см up and down,
 *   released from the top; after 5 swings the display shows k·T²/(4π²) − 15 кг = 75,0 кг. Real time, no damping drawn.
 *   A second cosmonaut (168 см) floats by the right wall, holding a handrail, and watches. Through the porthole the
 *   Earth goes by 60 times faster than in reality (3,9° a second).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

const K = 40; // px per metre in the sled scene
const SL = 6; // slope, м
const AL = (25 * Math.PI) / 180;
const X1 = SL * Math.cos(AL); // м, the foot of the slope
const H1 = SL * Math.sin(AL);
const GROUND = 200; // px, the level snow
const TOP = GROUND - H1 * K;
const snow = `M${-4 * K} ${TOP.toFixed(1)} L0 ${TOP.toFixed(1)} Q6 ${(TOP + 1).toFixed(1)} 9 ${(TOP + 4).toFixed(1)} L${(X1 * K - 9).toFixed(1)} ${GROUND - 4} Q${(X1 * K + 4).toFixed(1)} ${GROUND} ${(X1 * K + 16).toFixed(1)} ${GROUND} L${(X1 + 32) * K} ${GROUND} L${(X1 + 32) * K} 260 L${-4 * K} 260 Z`;
const fir = (h: number) => `M0 ${-h} L${h * 0.3} ${-h * 0.45} H${h * 0.12} L${h * 0.38} ${-h * 0.06} H${-h * 0.38} L${-h * 0.12} ${-h * 0.45} H${-h * 0.3} Z`;
const trees = [-3.4, 8.5, 13, 19.5, 29.5, 34].map((x, i) => ({ x: x * K, h: 46 + (i % 3) * 14 }));
const midTrees = Array.from({ length: 30 }, (_, i) => ({ x: -60 + i * 52 + ((i * 37) % 19), h: 22 + ((i * 13) % 11) }));
const farTrees = Array.from({ length: 30 }, (_, i) => ({ x: -40 + i * 21 + ((i * 29) % 9), y: 132 - 10 * Math.sin(i * 0.5) - (i % 3) * 2, h: 8 + (i % 4) * 2 }));
// the station module in one-point perspective: the far wall
const FW = { x0: 112, x1: 248, y0: 62, y1: 150 };
const PH = { x: 150, y: 100, r: 24 }; // the porthole in the far wall
const ring = (k: number) => ({ x0: FW.x0 * k, x1: 360 - (360 - FW.x1) * k, y0: FW.y0 * k, y1: 240 - (240 - FW.y1) * k });
---

<KitStyles />
<IntroFrame data-smintro>
	<div class="intro__card" data-scene="sled">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка на санках скатывается с горки, а внизу катится всё медленнее и останавливается; наверху стоит и машет ей папа">
			<rect class="sm-sky" x="0" y="0" width="360" height="240"></rect>
			<circle class="sm-sun" cx="300" cy="34" r="14"></circle>
			<g data-far>
				<path class="sm-far" d="M-80 150 Q0 112 90 128 T260 118 T440 126 T620 120 T800 130 V240 H-80 Z"></path>
				{farTrees.map((t) => <path class="sm-fir-far" transform={`translate(${t.x.toFixed(1)} ${t.y.toFixed(1)})`} d={fir(t.h)} />)}
				<g transform="translate(150 133)">
					<circle class="sm-snowman" cx="0" cy="-4" r="4.2"></circle>
					<circle class="sm-snowman" cx="0" cy="-10.5" r="3"></circle>
					<circle class="sm-snowman" cx="0" cy="-15.2" r="2.1"></circle>
				</g>
				<g data-kid1></g>
				<g data-kid2></g>
			</g>
			<g data-mid>
				<path class="sm-mid" d="M-80 168 Q40 150 140 160 T360 156 T600 162 T840 158 T1080 162 T1320 156 T1560 160 V240 H-80 Z"></path>
				{midTrees.map((t) => <path class="sm-fir-mid" transform={`translate(${t.x.toFixed(1)} ${(164 - (t.x % 7)).toFixed(1)})`} d={fir(t.h)} />)}
			</g>
			<g data-world>
				{trees.map((t) => (
					<g transform={`translate(${t.x.toFixed(1)} ${(t.x < 0 ? TOP + 2 : GROUND + 2).toFixed(1)})`}>
						<rect class="sm-trunk" x="-2" y="-8" width="4" height="8" />
						<path class="sm-fir" d={fir(t.h)} />
						<path class="sm-fir-snow" d={`M${-t.h * 0.2} ${-t.h * 0.5} Q0 ${-t.h * 0.56} ${t.h * 0.2} ${-t.h * 0.5} M${-t.h * 0.28} ${-t.h * 0.1} Q0 ${-t.h * 0.17} ${t.h * 0.28} ${-t.h * 0.1}`} />
					</g>
				))}
				<path class="sm-snow" d={snow}></path>
				<path class="sm-track" data-track d=""></path>
				<g data-dad></g>
				<g data-sled>
					<path class="sm-sledge" d="M-15 0 H13 Q19 0 20 -6 L17.5 -6.5 Q17 -3 12.5 -3 H-15 Q-17 -3 -17 -1.5 Q-17 0 -15 0 Z"></path>
					<path class="sm-handle" d="M-1 -3 v-2.6 h6 v2.6"></path>
					<g data-girl></g>
				</g>
			</g>
			<text class="sm-num" x="350" y="230" text-anchor="end" data-v></text>
		</svg>
		<div class="intro__foot">
			<p>
				Под горку санки сами разгоняются, а внизу, на ровном снегу,{' '}
				<More term="катятся всё медленнее и останавливаются">
					На склоне санки тянет вниз притяжение Земли, а снег тормозит их трением, но слабее: санки разгоняются с ускорением 3,25&nbsp;м/с² и внизу едут со скоростью 6,25&nbsp;м/с. На ровном месте остаётся только трение о снег, и через 20&nbsp;м санки стоят. Об этом — в разделе <a href="#сила-трения">«Сила трения»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="station">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="В модуле космической станции космонавт сидит на кресле, закреплённом на пружинах, и кресло вместе с ним ровно качается вверх-вниз; потом на табло появляется его масса; другой космонавт смотрит">
			<defs>
				<clipPath id="sm-ph-clip"><circle cx={PH.x} cy={PH.y} r={PH.r}></circle></clipPath>
			</defs>
			<!-- the module: ceiling, floor, side walls toward the far wall -->
			<path class="sm-m-ceil" d={`M0 0 H360 L${FW.x1} ${FW.y0} H${FW.x0} Z`}></path>
			<path class="sm-m-floor" d={`M0 240 H360 L${FW.x1} ${FW.y1} H${FW.x0} Z`}></path>
			<path class="sm-m-side" d={`M0 0 L${FW.x0} ${FW.y0} V${FW.y1} L0 240 Z`}></path>
			<path class="sm-m-side" d={`M360 0 L${FW.x1} ${FW.y0} V${FW.y1} L360 240 Z`}></path>
			<path class="sm-m-edge" d={`M0 0 L${FW.x0} ${FW.y0} M360 0 L${FW.x1} ${FW.y0} M0 240 L${FW.x0} ${FW.y1} M360 240 L${FW.x1} ${FW.y1}`}></path>
			{[0.3, 0.55, 0.78].map((k) => {
				const r = ring(k);
				return <path class="sm-m-seam" d={`M${r.x0.toFixed(1)} ${r.y0.toFixed(1)} H${r.x1.toFixed(1)} V${r.y1.toFixed(1)} H${r.x0.toFixed(1)} Z`} />;
			})}
			{[0.3, 0.55].map((k) => {
				const a = ring(k);
				const b = ring(k + 0.23);
				return (
					<>
						<path class="sm-m-locker" d={`M${(a.x0 + 3).toFixed(1)} ${(a.y0 + 40 * (1 - k)).toFixed(1)} L${(b.x0 - 3).toFixed(1)} ${(b.y0 + 40 * (1 - k - 0.23)).toFixed(1)} V${(b.y1 - 30 * (1 - k - 0.23)).toFixed(1)} L${(a.x0 + 3).toFixed(1)} ${(a.y1 - 30 * (1 - k)).toFixed(1)} Z`} />
						<path class="sm-m-locker" d={`M${(a.x1 - 3).toFixed(1)} ${(a.y0 + 40 * (1 - k)).toFixed(1)} L${(b.x1 + 3).toFixed(1)} ${(b.y0 + 40 * (1 - k - 0.23)).toFixed(1)} V${(b.y1 - 30 * (1 - k - 0.23)).toFixed(1)} L${(a.x1 - 3).toFixed(1)} ${(a.y1 - 30 * (1 - k)).toFixed(1)} Z`} />
					</>
				);
			})}
			<path class="sm-m-far" d={`M${FW.x0} ${FW.y0} H${FW.x1} V${FW.y1} H${FW.x0} Z`}></path>
			<!-- the porthole with the Earth below the station -->
			<circle class="sm-ph-space" cx={PH.x} cy={PH.y} r={PH.r}></circle>
			<g clip-path="url(#sm-ph-clip)">
				<g data-earth>
					<circle class="sm-ph-earth" cx="0" cy="0" r="120"></circle>
					{Array.from({ length: 12 }, (_, i) => i).map((i) => (
						<path class={i % 3 === 0 ? 'sm-ph-land' : 'sm-ph-cloud'} transform={`rotate(${i * 30 + (i % 2) * 9})`} d={i % 3 === 0 ? 'M-16 -119 Q-4 -127 12 -120 Q16 -112 4 -108 Q-9 -105 -16 -119 Z' : 'M-10 -116 Q-4 -121 6 -117 Q12 -114 6 -112 Q-6 -110 -10 -116 Z'} />
					))}
				</g>
				<circle class="sm-ph-glow" cx={PH.x} cy={PH.y + 128} r="121"></circle>
			</g>
			<circle class="sm-ph-ring" cx={PH.x} cy={PH.y} r={PH.r}></circle>
			<!-- a sleeping bag on the far wall, a laptop on the right wall, handrails -->
			<rect class="sm-m-bag" x="200" y="74" width="30" height="64" rx="9"></rect>
			<path class="sm-m-strap" d="M200 90 H230 M200 122 H230"></path>
			<path class="sm-m-laptop" d="M262 72 L282 67 L282 88 L262 92 Z"></path>
			<path class="sm-m-screen" d="M264.5 74.5 L279.5 70.5 L279.5 85.5 L264.5 89 Z"></path>
			<rect class="sm-m-rail" x="290" y="38" width="44" height="4" rx="2"></rect>
			<rect class="sm-m-rail" x="214" y="166" width="30" height="3" rx="1.5"></rect>
			<!-- the device: a column from the ceiling to the floor with two springs and a carriage between them -->
			<rect class="sm-dev-col" x="94" y="22" width="4" height="210"></rect>
			<rect class="sm-dev-col" x="110" y="22" width="4" height="210"></rect>
			<rect class="sm-dev-cap" x="90" y="18" width="28" height="8" rx="2"></rect>
			<rect class="sm-dev-cap" x="88" y="226" width="32" height="8" rx="2"></rect>
			<path class="sm-dev-spring" data-spring-up></path>
			<path class="sm-dev-spring" data-spring-down></path>
			<rect class="sm-dev-panel" x="120" y="24" width="64" height="22" rx="3"></rect>
			<path class="sm-dev-strut" d="M114 35 H120"></path>
			<text class="sm-dev-read" x="152" y="40" text-anchor="middle" data-read></text>
			<g data-seat>
				<rect class="sm-dev-carriage" x="90" y="-9" width="28" height="18" rx="2"></rect>
				<rect class="sm-dev-plate" x="116" y="-7" width="64" height="6" rx="2"></rect>
				<path class="sm-dev-strut" d="M178 -2 L186 22 M163 -7 V-18"></path>
				<rect class="sm-dev-plate" x="166" y="20" width="42" height="5" rx="2"></rect>
				<g data-astroa></g>
			</g>
			<g data-astrob></g>
		</svg>
		<div class="intro__foot">
			<p>
				На станции весы показывают ноль, поэтому массу космонавта измеряют иначе: он садится на кресло с пружинами, и оно{' '}
				<More term="ровно качается вверх-вниз">
					Пружины всё время тянут кресло к середине, и оно колеблется. Чем больше масса космонавта, тем медленнее колебания: масса находится по периоду колебаний на пружине — прибор измеряет период и сразу показывает массу. Обычные весы здесь бесполезны: станция и всё в ней «падают» вместе вокруг Земли, и никто ни на что не давит. Такие приборы были на советских станциях, есть они и на МКС. Земля в иллюминаторе проплывает в 60 раз быстрее, чем на самом деле. Об этом — в разделах <a href="#сила-упругости-закон-гука">«Сила упругости. Закон Гука»</a> и <a href="#вес-тела-невесомость">«Вес тела. Невесомость»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-smintro] {
		--sm-sky: hsl(212, 45%, 30%);
		--sm-far: hsl(212, 22%, 52%);
		--sm-mid: hsl(208, 22%, 66%);
		--sm-snow: hsl(205, 40%, 93%);
		--sm-fir: hsl(150, 35%, 28%);
		--sm-ink: hsl(222, 35%, 18%);
		--sm-wall: hsl(210, 12%, 66%);
		--sm-wall2: hsl(210, 10%, 56%);
		--sm-far-wall: hsl(210, 14%, 76%);
	}
	:root[data-theme='light'] [data-smintro] {
		--sm-sky: hsl(205, 70%, 84%);
		--sm-far: hsl(210, 25%, 74%);
		--sm-mid: hsl(207, 30%, 82%);
		--sm-snow: hsl(205, 45%, 97%);
		--sm-wall: hsl(210, 14%, 82%);
		--sm-wall2: hsl(210, 12%, 74%);
		--sm-far-wall: hsl(210, 16%, 90%);
	}
	[data-smintro] .sm-sky { fill: var(--sm-sky); }
	[data-smintro] .sm-sun { fill: hsl(48, 90%, 80%); opacity: 0.55; }
	[data-smintro] .sm-far { fill: var(--sm-far); }
	[data-smintro] .sm-mid { fill: var(--sm-mid); }
	[data-smintro] .sm-fir-far { fill: color-mix(in oklab, var(--sm-fir) 45%, var(--sm-far)); }
	[data-smintro] .sm-fir-mid { fill: color-mix(in oklab, var(--sm-fir) 65%, var(--sm-mid)); }
	[data-smintro] .sm-snowman { fill: var(--sm-snow); stroke: color-mix(in oklab, var(--sm-ink) 30%, var(--sm-far)); stroke-width: 0.4; }
	[data-smintro] .sm-snow { fill: var(--sm-snow); stroke: hsl(205, 30%, 72%); stroke-width: 1; }
	[data-smintro] .sm-track { fill: none; stroke: hsl(205, 30%, 75%); stroke-width: 1.4; }
	[data-smintro] .sm-trunk { fill: hsl(28, 35%, 30%); }
	[data-smintro] .sm-fir { fill: var(--sm-fir); stroke: hsl(150, 30%, 18%); stroke-width: 0.6; }
	[data-smintro] .sm-fir-snow { fill: none; stroke: var(--sm-snow); stroke-width: 2; stroke-linecap: round; }
	[data-smintro] .sm-sledge { fill: var(--ig-vy); stroke: var(--sm-ink); stroke-width: 0.7; }
	[data-smintro] .sm-handle { fill: none; stroke: var(--sm-ink); stroke-width: 1; stroke-linejoin: round; }
	[data-smintro] .sm-num { font-size: 13px; font-weight: 700; fill: var(--sm-ink); }
	[data-smintro] .sm-m-ceil { fill: var(--sm-wall2); }
	[data-smintro] .sm-m-floor { fill: var(--sm-wall2); }
	[data-smintro] .sm-m-side { fill: var(--sm-wall); }
	[data-smintro] .sm-m-edge { fill: none; stroke: color-mix(in oklab, var(--sm-ink) 35%, var(--sm-wall)); stroke-width: 0.8; }
	[data-smintro] .sm-m-far { fill: var(--sm-far-wall); stroke: color-mix(in oklab, var(--sm-ink) 30%, var(--sm-wall)); stroke-width: 0.8; }
	[data-smintro] .sm-m-seam { fill: none; stroke: color-mix(in oklab, var(--sm-ink) 25%, var(--sm-wall)); stroke-width: 0.7; }
	[data-smintro] .sm-m-locker { fill: color-mix(in oklab, var(--sm-ink) 8%, var(--sm-wall)); stroke: color-mix(in oklab, var(--sm-ink) 30%, var(--sm-wall)); stroke-width: 0.6; }
	[data-smintro] .sm-m-rail { fill: hsl(45, 70%, 60%); stroke: var(--sm-ink); stroke-width: 0.5; }
	[data-smintro] .sm-m-bag { fill: hsl(215, 40%, 48%); stroke: var(--sm-ink); stroke-width: 0.6; }
	[data-smintro] .sm-m-strap { fill: none; stroke: hsl(30, 20%, 35%); stroke-width: 1.4; }
	[data-smintro] .sm-m-laptop { fill: hsl(220, 8%, 35%); stroke: var(--sm-ink); stroke-width: 0.6; }
	[data-smintro] .sm-m-screen { fill: hsl(200, 60%, 55%); }
	[data-smintro] .sm-ph-space { fill: hsl(232, 40%, 8%); }
	[data-smintro] .sm-ph-earth { fill: hsl(210, 60%, 40%); }
	[data-smintro] .sm-ph-land { fill: hsl(110, 25%, 42%); }
	[data-smintro] .sm-ph-cloud { fill: white; opacity: 0.85; }
	[data-smintro] .sm-ph-glow { fill: none; stroke: hsl(200, 90%, 75%); stroke-width: 3; opacity: 0.55; }
	[data-smintro] .sm-ph-ring { fill: none; stroke: hsl(210, 8%, 45%); stroke-width: 4; }
	[data-smintro] .sm-dev-col { fill: hsl(210, 8%, 46%); }
	[data-smintro] .sm-dev-cap { fill: hsl(210, 8%, 38%); stroke: var(--sm-ink); stroke-width: 0.5; }
	[data-smintro] .sm-dev-spring { fill: none; stroke: hsl(40, 60%, 45%); stroke-width: 1.6; stroke-linejoin: round; }
	[data-smintro] .sm-dev-carriage { fill: hsl(210, 10%, 52%); stroke: var(--sm-ink); stroke-width: 0.6; }
	[data-smintro] .sm-dev-plate { fill: hsl(210, 12%, 40%); stroke: var(--sm-ink); stroke-width: 0.6; }
	[data-smintro] .sm-dev-strut { fill: none; stroke: hsl(210, 10%, 35%); stroke-width: 2; stroke-linecap: round; }
	[data-smintro] .sm-dev-panel { fill: hsl(220, 25%, 14%); stroke: var(--sm-ink); stroke-width: 0.6; }
	[data-smintro] .sm-dev-read { font-size: 13px; font-weight: 700; fill: hsl(140, 70%, 62%); font-variant-numeric: tabular-nums; }
	[data-smintro] .sm-pen-tip { fill: hsl(40, 20%, 80%); }
	[data-smintro] .sm-apple { fill: hsl(2, 75%, 55%); stroke: hsl(2, 60%, 35%); stroke-width: 0.6; }
	[data-smintro] .sm-stem { fill: none; stroke: hsl(28, 40%, 30%); stroke-width: 1; }
	[data-smintro] .sm-leaf { fill: hsl(120, 50%, 40%); }
	[data-smintro] .sm-drop { fill: hsl(200, 80%, 60%); opacity: 0.75; stroke: hsl(200, 70%, 40%); stroke-width: 0.6; }
	[data-smintro] .sm-drop-hi { fill: white; opacity: 0.8; }
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, ANKLE_CM, SKELETON, type Pt } from '@components/people';

	const f1 = (v: number) => v.toFixed(1);
	const cl = (x: number) => Math.min(1, Math.max(0, x));
	const sm = (x: number) => {
		const t = cl(x);
		return t * t * (3 - 2 * t);
	};
	const D = Math.PI / 180;
	for (const root of document.querySelectorAll<HTMLElement>('[data-smintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="sled"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 40;
			const G = 9.8;
			const MU = 0.1;
			const AL = (25 * Math.PI) / 180;
			const SL = 6;
			const X1 = SL * Math.cos(AL);
			const H1 = SL * Math.sin(AL);
			const GROUND = 200;
			const TOP = GROUND - H1 * K;
			const a1 = G * (Math.sin(AL) - MU * Math.cos(AL));
			const t1 = Math.sqrt((2 * SL) / a1);
			const v1 = a1 * t1;
			const a2 = MU * G;
			const t2 = v1 / a2;
			const RUN = t1 + t2;
			const S = 0.4; // px per см
			// the girl on the sled (sled frame: x along the sled, y down; the seat 3 px above its bottom)
			const HG = 130;
			const ug = S * HG;
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H: HG, age: 'child', girth: 0.95, clothes: 'winter', gear: 'boot', shirt: 'hm-green', hair: 'pony', name: 'girl on the sled' });
			const seatY = -3;
			const hipG: Pt = { x: -7, y: seatY - 0.045 * ug };
			const sit = (look: number) => ({
				hip: hipG,
				lean: -0.12,
				head: -0.05 - look,
				ankles: [
					{ x: hipG.x + 0.37 * ug, y: seatY - ANKLE_CM.boot * S },
					{ x: hipG.x + 0.35 * ug, y: seatY - ANKLE_CM.boot * S - 0.3 },
				] as [Pt, Pt],
				feet: [-0.35, -0.35] as [number, number],
				hands: [
					{ at: { x: 2.4, y: -5.2 }, pose: 'grip' as const, d: 2, dir: 0.2, contact: 'sled handle' },
					{ at: { x: 1.2, y: -5.4 }, pose: 'grip' as const, d: 2, dir: 0.2, contact: 'sled handle' },
				] as [{ at: Pt; pose: 'grip'; d: number; dir: number; contact: string }, { at: Pt; pose: 'grip'; d: number; dir: number; contact: string }],
			});
			// the father at the top of the slope, waving
			const HD = 175;
			const ud = S * HD;
			const dad = figure($<SVGGElement>('[data-dad]'), { s: S, H: HD, girth: 1.08, clothes: 'winter', gear: 'boot', shirt: 'hm-red', name: 'father' });
			const DX = -34;
			const ankD = ANKLE_CM.boot * S;
			const legD = (SKELETON.adult.thigh + SKELETON.adult.shin) * ud * 0.995;
			// two children far away by the snowman (0,14 px per см)
			const SF = 0.14;
			const kids = [
				{ g: $<SVGGElement>('[data-kid1]'), x: 141, H: 120, shirt: 'hm-blue', dir: 1 as const },
				{ g: $<SVGGElement>('[data-kid2]'), x: 160, H: 112, shirt: 'hm-gold', dir: -1 as const },
			].map((k) => ({ ...k, f: figure(k.g, { s: SF, H: k.H, age: 'child', clothes: 'winter', gear: 'boot', shirt: k.shirt, dir: k.dir, name: 'far child' }) }));
			const kidY = 133;
			const world = $<SVGGElement>('[data-world]');
			const mid = $<SVGGElement>('[data-mid]');
			const far = $<SVGGElement>('[data-far]');
			const sled = $<SVGGElement>('[data-sled]');
			const track = $('[data-track]');
			const vtext = $('[data-v]');
			scene(card, RUN, (q) => {
				const t = q * RUN;
				let x: number;
				let y: number;
				let rot: number;
				let v: number;
				if (t < t1) {
					const s = 0.5 * a1 * t * t;
					x = s * Math.cos(AL) * K;
					y = TOP + s * Math.sin(AL) * K;
					v = a1 * t;
					rot = 25 * sm(s / 0.3); // the sled tips over the edge in its first 30 см
				} else {
					const tt = t - t1;
					const s = v1 * tt - 0.5 * a2 * tt * tt;
					x = (X1 + s) * K;
					y = GROUND;
					v = v1 - a2 * tt;
					rot = 25 * (1 - sm(tt / 0.15)); // the sled levels out at the foot
				}
				sled.setAttribute('transform', `translate(${f1(x)} ${f1(y)}) rotate(${f1(rot)})`);
				girl.pose(sit(t > t1 + 2 ? 0.12 : 0));
				const cam = Math.max(0, x - 90);
				world.setAttribute('transform', `translate(${f1(-cam + 70)} 0)`);
				mid.setAttribute('transform', `translate(${f1(-0.6 * cam)} 0)`);
				far.setAttribute('transform', `translate(${f1(-0.25 * cam)} 0)`);
				track.setAttribute('d', `M0 ${f1(TOP)} ${t < t1 ? `L${f1(x)} ${f1(y)}` : `L${f1(X1 * K)} ${GROUND} L${f1(x)} ${GROUND}`}`);
				vtext.textContent = `${Math.max(0, v).toFixed(1).replace('.', ',')} м/с`;
				// the father: stands, raises his near hand after the start (0,7 с) and waves (one wave in 0,8 с)
				const raise = sm((t - 0.4) / 0.7);
				const wave = Math.sin((2 * Math.PI * Math.max(0, t - 1.1)) / 0.8) * sm((t - 1.1) / 0.3);
				const hipD = { x: DX, y: TOP - ankD - legD };
				dad.pose({
					hip: hipD,
					lean: 0.02,
					head: 0.1,
					ankles: [
						{ x: DX + 2, y: TOP - ankD },
						{ x: DX - 3, y: TOP - ankD },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ arm: [Math.PI / 2 - 0.12 - raise * 2.2, (12 + 68 * raise + 20 * wave * raise) * D], pose: raise > 0.5 ? 'open' : 'relaxed' },
						{ at: { x: DX - 2, y: hipD.y + 0.08 * ud }, pose: 'relaxed' },
					],
				});
				// the far children stand by the snowman
				for (const k of kids) {
					const u = SF * k.H;
					const ak = ANKLE_CM.boot * SF;
					const lg = (SKELETON.child.thigh + SKELETON.child.shin) * u * 0.995;
					k.f.pose({
						hip: { x: k.x, y: kidY - ak - lg },
						lean: 0.03,
						ankles: [
							{ x: k.x + k.dir * 0.4, y: kidY - ak },
							{ x: k.x - k.dir * 0.4, y: kidY - ak },
						],
						feet: [0, 0],
						planted: [true, true],
						hands: [
							{ at: { x: k.x + k.dir * 1.2, y: kidY - ak - lg + 0.06 * u }, pose: 'relaxed' },
							{ at: { x: k.x - k.dir * 0.6, y: kidY - ak - lg + 0.08 * u }, pose: 'relaxed' },
						],
					});
				}
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="station"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1; // px per см
			const H = 175;
			const u = S * H;
			const A = figure($<SVGGElement>('[data-astroa]'), { s: S, H, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'cosmonaut on the device' });
			const B = figure($<SVGGElement>('[data-astrob]'), { s: S, H: 168, clothes: 'indoor', shirt: 'hm-gold', hair: 'pony', dir: -1, name: 'cosmonaut watching' });
			const earth = $<SVGGElement>('[data-earth]');
			const seat = $<SVGGElement>('[data-seat]');
			const springUp = $<SVGPathElement>('[data-spring-up]');
			const springDown = $<SVGPathElement>('[data-spring-down]');
			const read = $('[data-read]');
			// the device: 75 кг on a carriage of 15 кг between springs of 1400 Н/м in all: T = 2π√(90/1400) = 1,593 с;
			// the carriage is released 10 см above its middle and swings 5 times; the display then shows k·T²/(4π²) − 15 кг
			const M = 75;
			const M0 = 15;
			const KS = 1400;
			const T = 2 * Math.PI * Math.sqrt((M + M0) / KS);
			const AMP = 10; // см = px
			const YC = 150; // the carriage's middle at rest
			const REL = 0.6;
			const RUN = REL + 5 * T + 0.05;
			const coil = (x: number, y0: number, y1: number) => {
				const n = 8;
				const L = y1 - y0 - 6;
				let d = `M${x} ${f1(y0)} v3`;
				for (let i = 0; i < n; i++) d += ` L${f1(x - 5)} ${f1(y0 + 3 + (L * (i + 0.25)) / n)} L${f1(x + 5)} ${f1(y0 + 3 + (L * (i + 0.75)) / n)}`;
				return `${d} L${x} ${f1(y1 - 3)} V${f1(y1)}`;
			};
			// his pose in the frame of the seat (the seat's top at y = −7): sitting, knees up, feet under the footrest's
			// edge, hands on the two handles at the front of the seat
			const hip: Pt = { x: 134, y: -7 - 0.045 * u };
			const poseA = () =>
				A.pose({
					hip,
					lean: 0.15,
					head: 0.05,
					ankles: [
						{ x: hip.x + 0.24 * u, y: 20 - 7 },
						{ x: hip.x + 0.22 * u, y: 20 - 7.5 },
					],
					feet: [0, 0],
					hands: [
						{ at: { x: 163, y: -13 }, pose: 'grip', d: 3, dir: 0, roll: -Math.PI / 2, contact: 'handle' },
						{ at: { x: 161, y: -14 }, pose: 'grip', d: 3, dir: 0, roll: -Math.PI / 2, contact: 'handle' },
					],
				});
			// the second cosmonaut floats by the right wall, holding a handrail, and watches
			const hipB: Pt = { x: 300, y: 142 };
			scene(card, RUN, (x) => {
				const t = x * RUN;
				earth.setAttribute('transform', `translate(${150} ${100 + 128}) rotate(${f1(-3.88 * t)})`);
				const d = t < REL ? -AMP : -AMP * Math.cos((2 * Math.PI * (t - REL)) / T); // px, up is negative
				const yc = YC + d;
				seat.setAttribute('transform', `translate(0 ${f1(yc)})`);
				springUp.setAttribute('d', coil(104, 26, yc - 9));
				springDown.setAttribute('d', coil(104, yc + 9, 226));
				poseA();
				const done = t >= REL + 5 * T;
				read.textContent = done ? `${((KS * T * T) / (4 * Math.PI * Math.PI) - M0).toFixed(1).replace('.', ',')} кг` : t < REL ? '— — —' : '· · ·';
				const b = Math.sin((2 * Math.PI * t) / RUN);
				B.pose({
					hip: hipB,
					lean: 0.12 + 0.02 * b,
					head: 0.1,
					ankles: [hipB, hipB],
					legs: [
						[Math.PI / 2 - 0.5 - 0.04 * b, 0.9 + 0.05 * b],
						[Math.PI / 2 - 0.35 + 0.04 * b, 1.05 - 0.05 * b],
					],
					feet: [0.35, 0.4],
					hands: [
						{ arm: [Math.PI / 2 + 0.35, 25 * D], pose: 'relaxed' },
						{ at: { x: 312, y: 40 }, pose: 'grip', d: 3, dir: -Math.PI / 2 + 0.2, roll: 0, contact: 'handrail' },
					],
				});
			});
		}
	}
</script>
