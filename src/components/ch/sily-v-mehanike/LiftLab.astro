---
/**
 * «Весы в лифте»: a girl of 50 кг (155 см) stands on bathroom scales in a lift cabin; the camera rides with the cabin,
 * so the floors of the shaft slide by (a mark every 3 м). Three rides, each played in real time and repeated:
 *   up:    1 м/с² up for 2 с (to 2 м/с), 4 с evenly, 1 м/с² down for 2 с (12 м in all);
 *   down:  the same mirrored;
 *   tower: a ride «Башня свободного падения»: 0,5 с at rest, 2 с of free fall (a = g down, 19,6 м, to 19,6 м/с),
 *          1 с of braking with 2g up (9,8 м), 0,5 с at rest.
 * The scales show N/g in kilograms (they are made for a support at rest): N = P = m(g + a_y), g = 9,8 м/с².
 * So 55,1 кг (540 Н), 50 кг (490 Н), 44,9 кг (440 Н), 0 in free fall and 150 кг (1470 Н) while braking.
 * Picture: 50 px per metre; arrows 0,06 px per newton (gravity violet, the support green); the acceleration is the
 * dashed arrow beside the cabin, of fixed length (direction only). Right: the reading of the scales against time.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const FL = 182; // the cabin floor, px
---

<G7Styles />
<PeopleStyles />
<figure class="g7 lft not-content" data-lft>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 240" role="img" aria-label="Девочка на весах в кабине лифта и график показаний весов" data-svg>
			<defs>
				{['violet', 'green', 'ink'].map((c) => <marker id={`lf-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`lft__h--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
				<clipPath id={`lf-c-${uid}`}><rect x="0" y="0" width="172" height="240" /></clipPath>
			</defs>
			<g clip-path={`url(#lf-c-${uid})`}>
				<rect class="lft__shaft" x="0" y="0" width="172" height="240" />
				<g data-floors></g>
				<rect class="lft__cabin" x="30" y={FL - 118} width="84" height="118" rx="3" />
				<rect class="lft__floor" x="30" y={FL} width="84" height="6" />
				<line class="lft__cable" x1="72" x2="72" y1="0" y2={FL - 118} />
				<rect class="lft__scales" x="60" y={FL - 4} width="22" height="4" rx="1" />
				<g data-girl></g>
								<line class="lft__arr lft__arr--violet" data-mg marker-end={`url(#lf-${uid}-violet)`} />
				<line class="lft__arr lft__arr--green" data-n marker-end={`url(#lf-${uid}-green)`} />
				<text class="t-i t-halo lft__lv" data-lmg>mg</text>
				<text class="t-i t-halo lft__lg" data-ln>N</text>
				<line class="lft__acc" data-a x1="146" x2="146" marker-end={`url(#lf-${uid}-ink)`} />
				<text class="t-i t-halo" data-la x="152">a</text>
			</g>
			<text class="t-strong t-num t-halo" x="6" y="18" data-kg></text>
			<!-- the graph -->
			<line class="ln" x1="196" x2="374" y1="216" y2="216" />
			<line class="ln" x1="196" x2="196" y1="20" y2="216" />
			{[0, 50, 100, 150].map((v) => <><line class="lft__grid" x1="196" x2="374" y1={216 - v * 1.2} y2={216 - v * 1.2} /><text class="t-small" x="191" y={220 - v * 1.2} text-anchor="end">{v}</text></>)}
			<text class="t-small" x="200" y="14">весы, кг</text>
			<text class="t-small" x="374" y="232" text-anchor="end" data-tax>t, с</text>
			<path class="lft__full" data-full />
			<path class="lft__now" data-now />
			<circle class="lft__pt" data-pt r="3.5" />
		</svg>
		<div class="g7__side lft__side">
			<div class="g7__seg" role="group" aria-label="Поездка" data-ride>
				<button type="button" class="g7__btn" aria-pressed="true" data-r="up">Поездка вверх</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-r="down">Поездка вниз</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-r="tower">Башня свободного падения</button>
			</div>
			<ul class="g7__read">
				<li>Время <b data-t></b></li>
				<li>Скорость кабины <b data-v></b></li>
				<li>Ускорение кабины <b data-acc></b></li>
				<li class="is-key"><span>Вес девочки <i>P</i>&nbsp;=&nbsp;<i>m</i>(<i>g</i>&nbsp;+&nbsp;<i>a<sub>y</sub></i>)</span> <b data-p></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Масса девочки 50&nbsp;кг. Весы показывают вес, делённый на 9,8&nbsp;м/с². Фиолетовая стрелка — сила тяжести, зелёная — сила реакции опоры (сила, с которой весы давят на девочку; по третьему закону она равна весу). Пунктирная стрелка показывает, куда направлено ускорение кабины (её длина не меняется). Время настоящее.
	</figcaption>
</figure>

<style is:global>
	.lft__shaft {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--g7-paper));
	}
	.lft__mark {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.lft__cabin {
		fill: color-mix(in oklab, var(--ig-v) 10%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.lft__floor {
		fill: var(--g7-ink);
	}
	.lft__cable {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.lft__scales {
		fill: var(--sl-color-gray-2);
	}
	.lft__arr {
		stroke-width: 3;
		stroke-linecap: round;
	}
	.lft__arr--violet {
		stroke: var(--g7-violet);
	}
	.lft__arr--green {
		stroke: var(--g7-green);
	}
	.lft__h--violet {
		fill: var(--g7-violet);
	}
	.lft__h--green {
		fill: var(--g7-green);
	}
	.lft__h--ink {
		fill: var(--g7-ink);
	}
	.lft .g7__svg .lft__lv {
		fill: var(--g7-violet);
	}
	.lft .g7__svg .lft__lg {
		fill: var(--g7-green);
	}
	.lft__acc {
		stroke: var(--g7-ink);
		stroke-width: 2;
		stroke-dasharray: 4 3;
	}
	.lft__grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.lft__full {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.4;
	}
	.lft__now {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.4;
	}
	.lft__pt {
		fill: var(--g7-gold);
	}
	.lft__side {
		grid-template-columns: minmax(0, 1fr);
	}
	.lft__side .g7__seg {
		justify-self: start;
	}
</style>

<script>
	import { fmt, loop, segment, el } from '../g7/kit';
	import { human, ANKLE } from '../mehanicheskaya-rabota/people';

	const FL = 182;
	const K = 50; // px per metre
	const G = 9.8;
	const M = 50;
	const KF = 0.06; // px per newton
	const HOLD = 1.5;
	const RIDES: Record<string, [number, number][]> = {
		up: [
			[2, 1],
			[4, 0],
			[2, -1],
		],
		down: [
			[2, -1],
			[4, 0],
			[2, 1],
		],
		tower: [
			[0.5, 0],
			[2, -G],
			[1, 2 * G],
			[0.5, 0],
		],
	};
	// the state at time t: acceleration, speed and height from the start
	const state = (ride: [number, number][], t: number) => {
		let v = 0;
		let y = 0;
		let left = t;
		let a = 0;
		for (const [d, ac] of ride) {
			const s = Math.min(d, Math.max(0, left));
			if (left > 0) a = ac;
			y += v * s + 0.5 * ac * s * s;
			v += ac * s;
			left -= d;
		}
		if (left > 0) a = 0;
		return { a, v: Math.abs(v) < 1e-9 ? 0 : v, y };
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-lft]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const S = K / 100;
		const H = 155;
		const u = S * H;
		const girl = human(q<SVGGElement>('[data-girl]'), { s: S, H, shirt: 'hm-red', hair: 'pony' });
		const top = FL - 4; // the top of the scales
		const A = ANKLE * S * (155 / 172);
		girl({
			hip: { x: 70, y: top - 0.505 * u },
			lean: 0,
			ankles: [
				{ x: 72, y: top - A },
				{ x: 68, y: top - A },
			],
			feet: [0, 0],
			hands: [
				{ x: 73, y: top - 0.43 * u },
				{ x: 69, y: top - 0.43 * u },
			],
		});
		const floors = q<SVGGElement>('[data-floors]');
		let ride = 'up';
		let t = 0;
		const total = () => RIDES[ride].reduce((s, [d]) => s + d, 0);
		const gx = (tt: number) => 196 + (tt / total()) * 176;
		const gy = (kg: number) => 216 - kg * 1.2;
		const reading = (a: number) => (M * (G + a)) / G;
		const graph = () => {
			let d = '';
			const T = total();
			for (let i = 0; i <= 400; i++) {
				const tt = (T * i) / 400;
				d += `${i ? 'L' : 'M'}${gx(tt).toFixed(1)} ${gy(reading(state(RIDES[ride], tt).a)).toFixed(1)}`;
			}
			q('[data-full]').setAttribute('d', d);
			q('[data-tax]').textContent = `t, с (всего ${fmt(T, 0)} с)`;
		};
		const arrow = (sel: string, x: number, y0: number, dy: number) => {
			const e = q<SVGLineElement>(sel);
			e.setAttribute('x1', String(x));
			e.setAttribute('x2', String(x));
			e.setAttribute('y1', y0.toFixed(1));
			e.setAttribute('y2', (y0 + dy - Math.sign(dy) * 4).toFixed(1));
			e.style.visibility = Math.abs(dy) > 4 ? 'visible' : 'hidden';
		};
		const draw = () => {
			const T = total();
			const tt = Math.min(t, T);
			const st = state(RIDES[ride], tt);
			const P = M * (G + st.a);
			// floors slide by: a mark every 3 м
			floors.replaceChildren();
			const off = (st.y * K) % (3 * K);
			for (let i = -1; i < 4; i++) {
				const y = FL + 6 + i * 3 * K + off;
				floors.append(el('line', { class: 'lft__mark', x1: 0, x2: 172, y1: y.toFixed(1), y2: y.toFixed(1) }));
			}
			const cm = top - 0.55 * u; // the center of mass
			arrow('[data-mg]', 52, cm, M * G * KF); // left of the girl
			arrow('[data-n]', 90, top, -P * KF); // right of the girl
			q('[data-lmg]').setAttribute('x', '31');
			q('[data-lmg]').setAttribute('y', (cm + M * G * KF - 2).toFixed(1));
			q('[data-ln]').setAttribute('x', '95');
			q('[data-ln]').setAttribute('y', (top - P * KF + 10).toFixed(1));
			q<SVGElement>('[data-ln]').style.visibility = P * KF > 4 ? 'visible' : 'hidden';
			// the direction of the acceleration only: an arrow of fixed length 40 px
			const ay = st.a === 0 ? 0 : Math.sign(st.a) * 40;
			const a = q<SVGLineElement>('[data-a]');
			a.setAttribute('y1', '120');
			a.setAttribute('y2', (120 - ay + Math.sign(ay) * 4).toFixed(1));
			a.style.visibility = ay ? 'visible' : 'hidden';
			q('[data-la]').setAttribute('y', (120 - ay / 2 + 4).toFixed(1));
			q<SVGElement>('[data-la]').style.visibility = a.style.visibility;
			const kg = reading(st.a);
			q('[data-kg]').textContent = `Весы: ${fmt(kg, 1)} кг`;
			q('[data-now]').setAttribute(
				'd',
				Array.from({ length: 201 }, (_, i) => {
					const s = (tt * i) / 200;
					return `${i ? 'L' : 'M'}${gx(s).toFixed(1)} ${gy(reading(state(RIDES[ride], s).a)).toFixed(1)}`;
				}).join(''),
			);
			q('[data-pt]').setAttribute('cx', gx(tt).toFixed(1));
			q('[data-pt]').setAttribute('cy', gy(kg).toFixed(1));
			q('[data-t]').textContent = `${fmt(tt, 1)} с`;
			q('[data-v]').textContent = st.v === 0 ? '0' : `${fmt(Math.abs(st.v), 1)} м/с ${st.v > 0 ? 'вверх' : 'вниз'}`;
			q('[data-acc]').textContent = st.a === 0 ? '0' : `${fmt(Math.abs(st.a), 1)} м/с² ${st.a > 0 ? 'вверх' : 'вниз'}`;
			q('[data-p]').textContent = `${fmt(P, 0)} Н`;
		};
		const wake = loop(root, (dt) => {
			t += dt;
			if (t > total() + HOLD) t = 0;
			draw();
			return true;
		});
		segment(q('[data-ride]'), (b) => {
			ride = b.dataset.r!;
			t = 0;
			graph();
			draw();
			wake();
		});
		graph();
		draw();
	}
</script>
