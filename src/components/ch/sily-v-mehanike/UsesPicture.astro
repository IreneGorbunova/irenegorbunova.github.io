---
/**
 * Small pictures for «Где это встречается» of «Силы в механике» (static, school-style, not to scale):
 *   1. Самолёт-лаборатория: the plane flies a parabola (dashed); while it does, the plane and everything in it move only
 *      under gravity, and the people float in the padded cabin for about 25 с (the cutaway below: two people of the
 *      kit, 175 см at 0,17 px per см, in loose floating poses).
 *   2. Подвеска автомобиля: a car body rests on four coil springs (two seen; side view): they act in parallel, so their
 *      stiffnesses add.
 *   3. Шипы и песок на льду: a studded tyre on ice with grains of sand: both raise μ, so the static friction of the
 *      road can speed up and brake the car harder.
 *   4. Велосипедист пригибается: two riders of the kit (175 см at 0,42 px per см) on the same bicycle (wheels of
 *      radius 35 см, axles 105 см apart): sitting upright with the hands on a high handlebar and tucked low with the
 *      hands on the drops. Lines of the air flow round them; the tucked rider meets the air with a smaller area.
 * The people are posed when the picture comes into view (the people checker reads the hands' places on the page).
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

const S = 0.42;
const R = 35;
const P = (x0: number, gy: number, p: { x: number; y: number }) => `${(x0 + p.x * S).toFixed(1)} ${(gy - p.y * S).toFixed(1)}`;
const bikes = [
	{ x0: 18, bar: 'high' },
	{ x0: 98, bar: 'drop' },
];
const GY = 112;
---

<G7Styles />
<KitStyles />
<figure class="g7 g7--pic smuses not-content" data-smuses>
	<div class="g7__grid smuses__grid">
		<div class="smuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Самолёт летит по параболе, а люди в мягкой кабине плавают в невесомости">
				<rect class="smuses__sky" x="0" y="0" width="160" height="120"></rect>
				<path class="smuses__path" d="M4 58 Q80 -30 156 58"></path>
				<g transform="translate(80 15)">
					<path class="smuses__plane" d="M-22 0 Q-24 -3 -18 -3.6 L14 -3.6 Q22 -3 24 0 Q22 3 14 3 L-18 3 Q-23 2.6 -22 0 Z" />
					<path class="smuses__plane" d="M-2 -3 L-10 -12 L-6 -12 L6 -3 Z M-18 -3 L-23 -10 L-20 -10 L-14 -3 Z" />
				</g>
				<rect class="smuses__cabin" x="18" y="52" width="124" height="62" rx="14"></rect>
				<path class="smuses__pad" d="M28 60 H132 M28 106 H132"></path>
				<g data-p1></g>
				<g data-p2></g>
			</svg>
			<p>Невесомость в самолёте</p>
		</div>
		<div class="smuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Кузов автомобиля опирается на колёса через пружины подвески">
				<rect class="smuses__ground" x="0" y="100" width="160" height="20"></rect>
				<path class="smuses__body" d="M14 66 V50 Q16 44 26 43 L50 41 L64 26 H102 L118 41 L140 44 Q148 46 148 54 V66 Z"></path>
				<path class="smuses__glass" d="M68 30 H84 V41 H56 Z M88 30 H100 L112 41 H88 Z"></path>
				{[42, 120].map((x) => (
					<>
						<circle class="smuses__tyre" cx={x} cy="88" r="12"></circle>
						<circle class="smuses__rim" cx={x} cy="88" r="5.5"></circle>
						<path class="smuses__coil" d={`M${x} 66 ${Array.from({ length: 6 }, (_, i) => `L${x + (i % 2 ? 5 : -5)} ${(68 + i * 2.6).toFixed(1)}`).join(' ')} L${x} 84`}></path>
					</>
				))}
				<path class="smuses__arch" d="M27 66 Q42 58 57 66 M105 66 Q120 58 135 66"></path>
			</svg>
			<p>Подвеска автомобиля</p>
		</div>
		<div class="smuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Шина с металлическими шипами на льду, посыпанном песком">
				<rect class="smuses__ice" x="0" y="92" width="160" height="28"></rect>
				<path class="smuses__scratch" d="M10 100 l18 2 M40 108 l22 -1 M110 104 l26 2 M124 112 l20 -2"></path>
				{Array.from({ length: 34 }, (_, i) => <circle class="smuses__sand" cx={((i * 37) % 156) + 2} cy={93 + ((i * 7) % 5)} r={0.9 + (i % 3) * 0.35} />)}
				<circle class="smuses__tyre" cx="80" cy="54" r="38"></circle>
				<circle class="smuses__rim" cx="80" cy="54" r="20"></circle>
				<circle class="smuses__hub" cx="80" cy="54" r="5"></circle>
				{Array.from({ length: 24 }, (_, i) => {
					const a = (i * Math.PI) / 12;
					return <rect class="smuses__stud" x="-1" y="-0.6" width="2" height="2" rx="0.6" transform={`translate(${(80 + 38 * Math.cos(a)).toFixed(1)} ${(54 + 38 * Math.sin(a)).toFixed(1)}) rotate(${((a * 180) / Math.PI + 90).toFixed(1)})`} />;
				})}
			</svg>
			<p>Шипы и песок на льду</p>
		</div>
		<div class="smuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Два велосипедиста: один сидит прямо, другой пригнулся к рулю; воздух обтекает их">
				<rect class="smuses__sky" x="0" y="0" width="160" height="120"></rect>
				<rect class="smuses__road" x="0" y={GY} width="160" height={120 - GY}></rect>
				{bikes.map((b) => (
					<g>
						{[0, 105].map((cx) => (
							<>
								<circle class="smuses__wheel" cx={(b.x0 + cx * S).toFixed(1)} cy={(GY - R * S).toFixed(1)} r={((R - 1.5) * S).toFixed(1)}></circle>
								<circle class="smuses__hubs" cx={(b.x0 + cx * S).toFixed(1)} cy={(GY - R * S).toFixed(1)} r="1"></circle>
							</>
						))}
						<path class="smuses__frame" d={`M${P(b.x0, GY, { x: 0, y: 35 })} L${P(b.x0, GY, { x: 42, y: 28 })} L${P(b.x0, GY, { x: 27, y: 82 })} Z M${P(b.x0, GY, { x: 27, y: 82 })} L${P(b.x0, GY, { x: 90, y: 80 })} L${P(b.x0, GY, { x: 94, y: 66 })} L${P(b.x0, GY, { x: 42, y: 28 })} M${P(b.x0, GY, { x: 90, y: 80 })} L${P(b.x0, GY, { x: 105, y: 35 })}`}></path>
						<path class="smuses__part" d={b.bar === 'high' ? `M${P(b.x0, GY, { x: 90, y: 80 })} L${P(b.x0, GY, { x: 88, y: 98 })} L${P(b.x0, GY, { x: 84, y: 100 })}` : `M${P(b.x0, GY, { x: 90, y: 80 })} L${P(b.x0, GY, { x: 93, y: 88 })} L${P(b.x0, GY, { x: 102, y: 87 })} Q${P(b.x0, GY, { x: 108, y: 80 })} ${P(b.x0, GY, { x: 101, y: 76 })}`}></path>
						<path class="smuses__part" d={`M${P(b.x0, GY, { x: 27, y: 82 })} L${P(b.x0, GY, { x: 25.5, y: 92 })}`}></path>
						<path class="smuses__saddle" d={`M${P(b.x0, GY, { x: 14, y: 94 })} L${P(b.x0, GY, { x: 34, y: 94 })} L${P(b.x0, GY, { x: 32, y: 91.5 })} L${P(b.x0, GY, { x: 15, y: 92 })} Z`}></path>
						<path class="smuses__part" d={`M${P(b.x0, GY, { x: 42 + 17, y: 28 })} L${P(b.x0, GY, { x: 42 - 17, y: 28 })}`}></path>
					</g>
				))}
				<g data-rider="high"></g>
				<g data-rider="drop"></g>
				<path class="smuses__air" d="M0 30 Q22 30 30 22 Q38 14 66 14 M0 46 Q8 46 12 44 M80 40 Q100 40 108 36 Q116 30 156 30 M80 56 Q90 56 94 54"></path>
			</svg>
			<p>Велосипедист пригибается</p>
		</div>
	</div>
</figure>

<style is:global>
	.g7--pic .g7__grid.smuses__grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@container (max-width: 36rem) {
		.g7--pic .g7__grid.smuses__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.smuses__cell p {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		text-align: center;
	}
	.smuses__sky {
		fill: var(--g7-sky);
	}
	.smuses__path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.smuses__plane {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.5;
	}
	.smuses__cabin {
		fill: color-mix(in oklab, var(--g7-wood) 35%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.smuses__pad {
		stroke: var(--g7-line);
		stroke-width: 0.6;
		stroke-dasharray: 6 3;
	}
	.smuses__ground,
	.smuses__road {
		fill: var(--g7-ground);
	}
	.smuses__body {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.smuses__glass {
		fill: var(--g7-paper);
		opacity: 0.85;
	}
	.smuses__tyre {
		fill: color-mix(in oklab, var(--g7-ink) 30%, black);
	}
	.smuses__rim {
		fill: var(--sl-color-gray-3);
	}
	.smuses__hub {
		fill: var(--sl-color-gray-4);
	}
	.smuses__coil {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.smuses__arch {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.smuses__ice {
		fill: color-mix(in oklab, var(--g7-blue) 30%, var(--g7-paper));
	}
	.smuses__scratch {
		stroke: white;
		stroke-width: 0.6;
		opacity: 0.7;
	}
	.smuses__sand {
		fill: hsl(35, 55%, 55%);
	}
	.smuses__stud {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.4;
	}
	.smuses__wheel {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.smuses__hubs {
		fill: var(--g7-ink);
	}
	.smuses__frame {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.3;
		stroke-linejoin: round;
	}
	.smuses__part {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linecap: round;
	}
	.smuses__saddle {
		fill: var(--g7-ink);
	}
	.smuses__air {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 0.8;
		stroke-dasharray: 5 3;
		opacity: 0.7;
	}
</style>

<script>
	import { figure } from '@components/people';

	const S = 0.42;
	const GY = 112;
	const D = Math.PI / 180;
	for (const root of document.querySelectorAll<HTMLElement>('[data-smuses]')) {
		const pose = () => {
			// two people floating in the cabin
			const sf = 0.17;
			const uf = sf * 175;
			const p1 = figure(root.querySelector<SVGGElement>('[data-p1]')!, { s: sf, H: 175, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'floating 1' });
			const p2 = figure(root.querySelector<SVGGElement>('[data-p2]')!, { s: sf, H: 168, clothes: 'indoor', shirt: 'hm-gold', hair: 'pony', dir: -1, name: 'floating 2' });
			const g1 = root.querySelector<SVGGElement>('[data-p1]')!;
			const g2 = root.querySelector<SVGGElement>('[data-p2]')!;
			g1.setAttribute('transform', 'translate(58 84) rotate(-35)');
			g2.setAttribute('transform', 'translate(104 80) rotate(20)');
			const float = (f: typeof p1, u: number, k: number) =>
				f.pose({
					hip: { x: 0, y: 0 },
					lean: 0.1,
					head: -0.1,
					ankles: [
						{ x: 0, y: 0 },
						{ x: 0, y: 0 },
					],
					legs: [
						[Math.PI / 2 - 0.6 * k, 0.8],
						[Math.PI / 2 - 0.2 * k, 1.0],
					],
					feet: [0.3, 0.35],
					hands: [
						{ arm: [-0.4 * k, 40 * D], pose: 'open' },
						{ arm: [0.5, 70 * D], pose: 'relaxed' },
					],
				});
			float(p1, uf, 1);
			float(p2, 0.17 * 168, 0.6);
			// the riders: the hips on the saddle, the hands on the bar, the feet on the pedals (cranks level)
			for (const [key, x0] of [
				['high', 18],
				['drop', 98],
			] as const) {
				const g = root.querySelector<SVGGElement>(`[data-rider="${key}"]`)!;
				const f = figure(g, { s: S, H: 175, clothes: 'indoor', shirt: key === 'high' ? 'hm-green' : 'hm-red', hair: 'short', name: `rider ${key}` });
				const P = (x: number, y: number) => ({ x: x0 + x * S, y: GY - y * S });
				const pn = { x: 42 + 17, y: 28 };
				const pf = { x: 42 - 17, y: 28 };
				const ank = (p: { x: number; y: number }) => P(p.x - 7, p.y + 8);
				const high = key === 'high';
				f.pose({
					hip: P(22, 98),
					lean: high ? 0.32 : 1.05,
					head: high ? 0.05 : 0,
					ankles: [ank(pn), ank(pf)],
					feet: [0.15, 0.1],
					hands: high
						? [
								{ at: P(84, 100), pose: 'grip', d: 3, contact: 'handlebar' },
								{ at: P(83, 99), pose: 'grip', d: 3, contact: 'handlebar' },
							]
						: [
								{ at: P(103, 82), pose: 'grip', d: 3, contact: 'drop bar' },
								{ at: P(102, 81), pose: 'grip', d: 3, contact: 'drop bar' },
							],
				});
			}
		};
		new IntersectionObserver((es) => {
			if (es.some((e) => e.isIntersecting)) pose();
		}).observe(root);
		pose();
	}
</script>
