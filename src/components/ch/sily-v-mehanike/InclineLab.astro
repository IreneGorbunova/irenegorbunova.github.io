---
/**
 * «Брусок на наклонной доске»: a wooden block of 1 кг on a board tilted by α (0…60°, step 1°). The board is covered
 * with ice (μ = 0,05), bare wood (μ = 0,3) or sandpaper (μ = 0,6); the same μ is used for the largest static friction
 * and for sliding friction (the school model). Forces on the block: gravity mg = 9,8 Н (violet), the support
 * N = mg cos α (green), friction (red) along the board: at rest it equals mg sin α, while tg α ≤ μ; otherwise the
 * block slides with sliding friction μN and a = g(sin α − μ cos α). It starts to slide at 3° (ice), 17° (wood),
 * 31° (sandpaper). The sliding is shown in real time over 0,85 м of the board, then the block is put back.
 * Scale: the board is 1,2 м = 240 px; arrows 6 px per newton.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
---

<G7Styles />
<figure class="g7 g7--wide inc not-content" data-inc>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 282" role="img" aria-label="Брусок на наклонной доске и действующие на него силы" data-svg>
			<defs>
				{['violet', 'green', 'red'].map((c) => <marker id={`in-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`inc__h--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<rect class="inc__table" x="0" y="232" width="380" height="50" />
			<line class="inc__prop" data-prop />
			<g data-board>
				<rect class="inc__board" x="0" y="0" width="240" height="10" />
				<rect class="inc__cover" data-cover x="0" y="-2.5" width="240" height="3" />
			</g>
			<path class="inc__arc" data-arc />
			<text class="t-i t-halo" data-alab>α</text>
			<g data-block>
				<rect class="inc__block" x="-24" y="-28" width="48" height="28" rx="2" />
				<path class="inc__grain" d="M-20 -20 Q0 -24 20 -19 M-20 -10 Q0 -14 20 -9" />
			</g>
			<line class="inc__arr" data-mg marker-end={`url(#in-${uid}-violet)`} />
			<line class="inc__arr" data-n marker-end={`url(#in-${uid}-green)`} />
			<line class="inc__arr" data-fr marker-end={`url(#in-${uid}-red)`} />
			<text class="t-i t-halo inc__lv" data-lmg>mg</text>
			<text class="t-i t-halo inc__lg" data-ln>N</text>
			<text class="t-i t-halo inc__lr" data-lfr>F<tspan class="inc__sub" dy="3">тр</tspan></text>
			<text class="t-strong t-halo" x="372" y="20" text-anchor="end" data-state></text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Наклон доски α</span>
				<output data-oa></output>
				<input type="range" min="0" max="60" step="1" value="10" data-a aria-label="Угол наклона доски, градусы" />
			</label>
			<div class="g7__seg" role="group" aria-label="Чем покрыта доска" data-mat>
				<button type="button" class="g7__btn" aria-pressed="false" data-mu="0.05">Лёд</button>
				<button type="button" class="g7__btn" aria-pressed="true" data-mu="0.3">Дерево</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-mu="0.6">Наждачная бумага</button>
			</div>
			<ul class="g7__read">
				<li><span>tg&nbsp;α и коэффициент трения μ</span> <b data-tg></b></li>
				<li><span>Тянет вниз вдоль доски <i>mg</i>&nbsp;sin&nbsp;α</span> <b data-pull></b></li>
				<li><span>Наибольшая сила трения <i>μmg</i>&nbsp;cos&nbsp;α</span> <b data-max></b></li>
				<li class="is-key">Сила трения <b data-f></b></li>
				<li class="is-key">Ускорение бруска <b data-acc></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Деревянный брусок массой 1&nbsp;кг. Фиолетовая стрелка — сила тяжести, зелёная — сила реакции опоры, красная — сила трения; масштаб 6&nbsp;px на ньютон. Скольжение показано в настоящем времени.
	</figcaption>
</figure>

<style is:global>
	.inc .g7__read li b {
		white-space: normal;
		text-align: right;
	}
	.inc__table {
		fill: var(--g7-ground);
	}
	.inc__prop {
		stroke: var(--g7-line);
		stroke-width: 3;
	}
	.inc__board {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.inc__cover {
		fill: var(--g7-wood);
	}
	.inc__cover.is-ice {
		fill: hsl(195, 70%, 80%);
	}
	.inc__cover.is-sand {
		fill: hsl(30, 15%, 45%);
	}
	.inc__block {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
	}
	.inc__grain {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.inc__arc {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.inc__arr {
		stroke-width: 3;
		stroke-linecap: round;
	}
	.inc__arr[data-mg] {
		stroke: var(--g7-violet);
	}
	.inc__arr[data-n] {
		stroke: var(--g7-green);
	}
	.inc__arr[data-fr] {
		stroke: var(--g7-red);
	}
	.inc__h--violet {
		fill: var(--g7-violet);
	}
	.inc__h--green {
		fill: var(--g7-green);
	}
	.inc__h--red {
		fill: var(--g7-red);
	}
	.inc .g7__svg .inc__lv {
		fill: var(--g7-violet);
	}
	.inc .g7__svg .inc__lg {
		fill: var(--g7-green);
	}
	.inc .g7__svg .inc__lr {
		fill: var(--g7-red);
	}
	.inc svg .inc__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>

<script>
	import { fmt, loop, segment } from '../g7/kit';

	const P0 = { x: 26, y: 222 }; // the hinge of the board (its top surface)
	const PXM = 200; // px per metre along the board
	const S0 = 1.0; // м, where the block starts (its middle)
	const S1 = 0.15; // м, where it stops (the end of the slide)
	const KF = 6;
	const G = 9.8;
	const M = 1;
	for (const root of document.querySelectorAll<HTMLElement>('[data-inc]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const sa = q<HTMLInputElement>('[data-a]');
		let mu = 0.3;
		let t = 0;
		const arrow = (sel: string, x: number, y: number, dx: number, dy: number) => {
			const e = q<SVGLineElement>(sel);
			const L = Math.hypot(dx, dy);
			const k = L > 5 ? (L - 4) / L : 0;
			e.setAttribute('x1', x.toFixed(1));
			e.setAttribute('y1', y.toFixed(1));
			e.setAttribute('x2', (x + dx * k).toFixed(1));
			e.setAttribute('y2', (y + dy * k).toFixed(1));
			e.style.visibility = L > 5 ? 'visible' : 'hidden';
			return L > 5;
		};
		const label = (sel: string, x: number, y: number, on: boolean) => {
			const e = q<SVGTextElement>(sel);
			e.setAttribute('x', x.toFixed(1));
			e.setAttribute('y', y.toFixed(1));
			e.style.visibility = on ? 'visible' : 'hidden';
		};
		const phys = () => {
			const al = (Number(sa.value) * Math.PI) / 180;
			const pull = M * G * Math.sin(al);
			const N = M * G * Math.cos(al);
			const max = mu * N;
			const slides = Math.tan(al) > mu + 1e-12;
			const F = slides ? max : pull;
			const a = slides ? (pull - max) / M : 0;
			return { al, pull, N, max, slides, F, a };
		};
		const draw = () => {
			const p = phys();
			const c = Math.cos(p.al);
			const s = Math.sin(p.al);
			const e = { x: c, y: -s }; // up the board
			const n = { x: -s, y: -c }; // out of the board
			q('[data-board]').setAttribute('transform', `translate(${P0.x} ${P0.y}) rotate(${(-p.al * 180) / Math.PI}) translate(0 0)`);
			// the prop under the far end
			const end = { x: P0.x + e.x * 220, y: P0.y + e.y * 220 + 10 * c };
			const prop = q('[data-prop]');
			prop.setAttribute('x1', end.x.toFixed(1));
			prop.setAttribute('y1', end.y.toFixed(1));
			prop.setAttribute('x2', end.x.toFixed(1));
			prop.setAttribute('y2', '232');
			// the block: along the board
			const travel = p.slides ? 0.5 * p.a * t * t : 0;
			const sm = Math.max(S1, S0 - travel);
			const cx = P0.x + e.x * sm * PXM;
			const cy = P0.y + e.y * sm * PXM;
			q('[data-block]').setAttribute('transform', `translate(${cx.toFixed(1)} ${cy.toFixed(1)}) rotate(${(-p.al * 180) / Math.PI})`);
			const mid = { x: cx + n.x * 14, y: cy + n.y * 14 };
			label('[data-lmg]', mid.x + 6, mid.y + p.pull * 0 + M * G * KF - 4, arrow('[data-mg]', mid.x, mid.y, 0, M * G * KF));
			label('[data-ln]', cx + n.x * p.N * KF - 14, cy + n.y * p.N * KF + 2, arrow('[data-n]', cx - e.x * 8, cy - e.y * 8, n.x * p.N * KF, n.y * p.N * KF));
			const fx = e.x * p.F * KF;
			const fy = e.y * p.F * KF;
			label('[data-lfr]', cx + e.x * 24 + fx + 4, cy + e.y * 24 + fy + 14, arrow('[data-fr]', cx + e.x * 24, cy + e.y * 24, fx, fy));
			// the angle
			const R = 40;
			q('[data-arc]').setAttribute('d', p.al > 0.01 ? `M${P0.x + R} ${P0.y} A${R} ${R} 0 0 0 ${(P0.x + R * c).toFixed(1)} ${(P0.y - R * s).toFixed(1)}` : '');
			label('[data-alab]', P0.x + 48 * Math.cos(p.al / 2), P0.y - 48 * Math.sin(p.al / 2) + 5, p.al > 0.05);
			q('[data-oa]').textContent = `${sa.value}°`;
			q('[data-tg]').textContent = `${fmt(Math.tan(p.al), 2)} и ${fmt(mu, mu < 0.1 ? 2 : 1)}`;
			q('[data-pull]').textContent = `${fmt(p.pull, 2)} Н`;
			q('[data-max]').textContent = `${fmt(p.max, 2)} Н`;
			q('[data-f]').textContent = p.slides ? `${fmt(p.F, 2)} Н (скольжения)` : p.F > 0.005 ? `${fmt(p.F, 2)} Н (покоя)` : '0';
			q('[data-acc]').textContent = p.slides ? `${fmt(p.a, 2)} м/с²` : '0';
			q('[data-state]').textContent = p.slides ? 'скользит' : 'лежит';
		};
		const wake = loop(root, (dt) => {
			const p = phys();
			if (!p.slides) {
				t = 0;
				draw();
				return false;
			}
			t += dt;
			const tEnd = Math.sqrt((2 * (S0 - S1)) / p.a);
			if (t > tEnd + 1) t = 0;
			draw();
			return true;
		});
		const change = () => {
			t = 0;
			draw();
			wake();
		};
		sa.addEventListener('input', change);
		segment(q('[data-mat]'), (b) => {
			mu = Number(b.dataset.mu);
			const cover = q('[data-cover]');
			cover.classList.toggle('is-ice', mu < 0.1);
			cover.classList.toggle('is-sand', mu > 0.5);
			change();
		});
		draw();
	}
</script>
