---
/**
 * «Падение в воздухе» (model), section «Сила сопротивления среды», before the statement about the terminal speed.
 * A body falls from rest; the air resists with F_сопр = βυ² (β, not k: k is the stiffness in this chapter; large
 * Reynolds numbers), g = 9,8 м/с²: m·a = mg − βυ², so υ(t) = υ_уст·th(gt/υ_уст), υ_уст = √(mg/β), a = g(1 − υ²/υ_уст²), F_сопр = mg·υ²/υ_уст².
 * (th is not used in the text; the pupils see the graph.) Bodies:
 *   капля дождя, 2 мм: m = 4,19 мг, β = 9,72·10⁻⁷ кг/м → υ_уст 6,5 м/с; 95 % of it after 1,21 с and 5,0 м;
 *   мячик для настольного тенниса: 2,7 г, 40 мм, β = 3,77·10⁻⁴ кг/м → 8,4 м/с; 95 % after 1,57 с, 8,3 м;
 *   парашютист, руки раскинуты: 80 кг, β = 0,259 кг/м → 55,0 м/с ≈ 200 км/ч; 95 % after 10,3 с, 359 м;
 *   парашютист под раскрытым куполом: 80 кг, β = 31,4 кг/м → 5,00 м/с; 95 % after 0,93 с, 3,0 м.
 * «Пауза» stops the clock so the readouts can be read. Left: the body (not to scale; the people from the kit, 0,32 px per см) with mg (violet, always 50 px) and F_сопр
 * (orange, 50·υ²/υ_уст² px: it grows to the length of mg); faint marks of the air rush past upward at a speed
 * proportional to υ. Right: the graph υ(t) drawn as time goes, with the dashed line of the final speed (its number at
 * the right) and, with «Без воздуха», the line υ = gt. The drop, the ball and the parachute are played 3 times slower
 * than real time, the free fall of the skydiver in real time; the clock shows real seconds.
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const GX0 = 186;
const GX1 = 368;
const GY0 = 214;
const GY1 = 30;
---

<G7Styles />
<KitStyles />
<figure class="g7 dfl not-content" data-dfl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 252" role="img" aria-label="Тело падает в воздухе: сила сопротивления растёт со скоростью, пока не сравняется с силой тяжести; справа график скорости от времени" data-svg>
			<defs>
				{['violet', 'orange'].map((c) => <marker id={`df-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`dfl__h--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
				<clipPath id={`df-c-${uid}`}><rect x="6" y="8" width="160" height="234" rx="8" /></clipPath>
			</defs>
			<rect class="dfl__sky" x="6" y="8" width="160" height="234" rx="8" />
			<g clip-path={`url(#df-c-${uid})`}>
				<g data-marks></g>
				<g data-body>
					<g data-drop>
						<path class="dfl__drop" d="M0 -12 Q9 2 7 6 Q4 11 0 11 Q-4 11 -7 6 Q-9 2 0 -12 Z" />
						<path class="dfl__glint" d="M-3 2 Q-3 6 0 7" />
					</g>
					<g data-ball>
						<circle class="dfl__ball" r="10" />
						<path class="dfl__seam" d="M-10 0 Q0 4 10 0" />
					</g>
					<g data-diver></g>
					<g data-chute>
						<path class="dfl__canopy" d="M-46 -54 Q0 -96 46 -54 Q34 -60 23 -54 Q12 -61 0 -54 Q-12 -61 -23 -54 Q-34 -60 -46 -54 Z" />
						<path class="dfl__line" d="M-46 -54 L-6 -9 M-23 -54 L-5 -9 M23 -54 L5 -9 M46 -54 L6 -9" data-lines />
					</g>
				</g>
			</g>
			<line class="dfl__arr dfl__arr--violet" data-mg marker-end={`url(#df-${uid}-violet)`} />
			<line class="dfl__arr dfl__arr--orange" data-fd marker-end={`url(#df-${uid}-orange)`} />
			<text class="t-i t-halo dfl__lv" data-lmg>mg</text>
			<text class="t-i t-halo dfl__lo" data-lfd>F<tspan class="dfl__sub" dy="3">сопр</tspan></text>
			<text class="t-small t-num" x="14" y="237" data-clock></text>

			<!-- the graph -->
			<line class="ln" x1={GX0} x2={GX0} y1={GY0} y2={GY1 - 6}></line>
			<line class="ln" x1={GX0} x2={GX1 + 4} y1={GY0} y2={GY0}></line>
			<text class="dfl__lab" x={GX0 + 5} y={GY1 - 10}><tspan class="t-i">υ</tspan>, м/с</text>
			<text class="dfl__lab" x={GX1 + 4} y={GY0 + 30} text-anchor="end"><tspan class="t-i">t</tspan>, с</text>
			<g data-ticks></g>
			<path class="dfl__free" data-free></path>
			<line class="dfl__term" data-term x1={GX0} x2={GX1}></line>
			<text class="dfl__lab dfl__termlab" data-termlab x={GX1} text-anchor="end"></text>
			<path class="dfl__ghost" data-ghost></path>
			<path class="dfl__curve" data-curve></path>
			<circle class="dfl__dot" r="3.4" data-dot></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Что падает" data-what>
				<button type="button" class="g7__btn" aria-pressed="true" data-b="drop">Капля дождя</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-b="ball">Мячик</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-b="diver">Парашютист</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-b="chute">Под куполом</button>
			</div>
			<div class="dfl__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Сначала</button>
				<button type="button" class="g7__btn" data-pause aria-pressed="false">Пауза</button>
				<label class="dfl__check"><input type="checkbox" data-free-on /> Без воздуха</label>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span><i>m</i> и <i>mg</i></span><b data-rm></b></li>
				<li class="is-key"><span>Скорость <i>υ</i></span><b data-rv></b></li>
				<li><span>Сопротивление <i>F</i><sub>сопр</sub></span><b data-rf></b></li>
				<li><span>Ускорение <i>a</i></span><b data-ra></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption" data-cap>
		Тело падает без начальной скорости. Фиолетовая стрелка — сила тяжести, оранжевая — сила сопротивления воздуха (у каждого тела свой масштаб; тела не в масштабе). Каплю, мячик и купол показываем в 3 раза медленнее, свободное падение парашютиста — как в жизни.
	</figcaption>
</figure>

<style is:global>
	.dfl {
		--dfl-orange: hsl(28, 95%, 60%);
	}
	:root[data-theme='light'] .dfl {
		--dfl-orange: hsl(24, 90%, 44%);
	}
	.dfl .g7__seg {
		flex-wrap: wrap;
	}
	.dfl__row {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		flex-wrap: wrap;
	}
	.dfl__check {
		display: inline-flex;
		gap: 0.4rem;
		align-items: center;
		font-size: 0.95rem;
	}
	.dfl__sky {
		fill: var(--g7-sky);
		stroke: var(--g7-faint);
	}
	.dfl__mark {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linecap: round;
		opacity: 0.55;
	}
	.dfl__drop {
		fill: color-mix(in oklab, var(--g7-blue) 55%, var(--g7-paper));
		stroke: var(--g7-blue);
		stroke-width: 1;
	}
	.dfl__glint {
		fill: none;
		stroke: white;
		stroke-width: 1.2;
		opacity: 0.8;
	}
	.dfl__ball {
		fill: hsl(36, 90%, 92%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.dfl__seam {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.7;
	}
	.dfl__canopy {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.dfl__line {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.5;
	}
	.dfl__arr {
		stroke-width: 2.8;
		stroke-linecap: round;
	}
	.dfl__arr--violet {
		stroke: var(--g7-violet);
	}
	.dfl__arr--orange {
		stroke: var(--dfl-orange);
	}
	.dfl__h--violet {
		fill: var(--g7-violet);
	}
	.dfl__h--orange {
		fill: var(--dfl-orange);
	}
	.dfl .g7__svg .dfl__lv {
		fill: var(--g7-violet);
	}
	.dfl .g7__svg .dfl__lo {
		fill: var(--dfl-orange);
	}
	.dfl svg .dfl__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
	.dfl .g7__svg .dfl__lab,
	.dfl .g7__svg .dfl__num {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.dfl__free {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.dfl__term {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.dfl__ghost {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.dfl__curve {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.4;
	}
	.dfl__dot {
		fill: var(--ig-v);
	}
</style>

<script>
	import { fmt, fmtTrim, loop, segment, el } from '../g7/kit';
	import { figure } from '@components/people';

	const G = 9.8;
	const GX0 = 186;
	const GX1 = 368;
	const GY0 = 214;
	const GY1 = 30;
	type Key = 'drop' | 'ball' | 'diver' | 'chute';
	// m (кг), k (кг/м), the graph's t and υ ranges and steps, the slow-down, how the mass is written
	const BODIES: Record<Key, { m: number; k: number; tMax: number; tStep: number; vMax: number; vStep: number; slow: number; mass: string }> = {
		drop: { m: 4.19e-6, k: 9.72e-7, tMax: 2, tStep: 0.5, vMax: 8, vStep: 2, slow: 3, mass: '4,19 мг' },
		ball: { m: 0.0027, k: 3.77e-4, tMax: 2.5, tStep: 0.5, vMax: 10, vStep: 2, slow: 3, mass: '2,7 г' },
		diver: { m: 80, k: 0.259, tMax: 15, tStep: 5, vMax: 60, vStep: 10, slow: 1, mass: '80 кг' },
		chute: { m: 80, k: 31.4, tMax: 1.5, tStep: 0.5, vMax: 6, vStep: 1, slow: 3, mass: '80 кг' },
	};
	const vT = (b: { m: number; k: number }) => Math.sqrt((b.m * G) / b.k);
	const speed = (b: { m: number; k: number }, t: number) => {
		const vt = vT(b);
		return vt * Math.tanh((G * t) / vt);
	};
	/** mg in the chosen unit: Н for the people, мН / мкН for the small bodies. */
	const force = (F: number) => (F >= 1 ? `${fmtTrim(F, 1)} Н` : F >= 1e-3 ? `${fmtTrim(F * 1000, 1)} мН` : `${fmtTrim(F * 1e6, 1)} мкН`);
	const BX = 86; // the body's center in the window
	const BY = 118;
	for (const root of document.querySelectorAll<HTMLElement>('[data-dfl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let key: Key = (new URLSearchParams(location.search).get('dfl') as Key) || 'drop'; // ?dfl=diver etc. only for checks
		let t = 0; // real seconds of the fall
		let scroll = 0; // px the air marks have moved
		const marks = Array.from({ length: 12 }, (_, i) => {
			const m = el('line', { class: 'dfl__mark' });
			q('[data-marks]').append(m);
			return { m, x: 14 + ((i * 53) % 146), y0: (i * 41) % 196, len: 8 + (i % 3) * 5 };
		});
		// the skydiver: the people kit, 0,32 px per см; free fall belly down (the figure turned by 90°), or hanging
		const diverG = q<SVGGElement>('[data-diver]');
		const holder = el('g');
		diverG.append(holder);
		const fig = figure(holder as SVGGElement, { s: 0.32, H: 178, clothes: 'indoor', shirt: 'hm-red', hair: 'short', name: 'skydiver' });
		const u = 0.32 * 178;
		const D = Math.PI / 180;
		const freePose = () => {
			holder.setAttribute('transform', 'rotate(90)');
			fig.pose({
				hip: { x: -0.1 * u, y: 0.12 * u },
				lean: 0,
				head: -0.4,
				ankles: [
					{ x: 0, y: 0 },
					{ x: 0, y: 0 },
				],
				legs: [
					[Math.PI / 2 + 0.35, 70 * D],
					[Math.PI / 2 + 0.25, 80 * D],
				],
				feet: [0.6, 0.6],
				hands: [
					{ arm: [-Math.PI / 2 - 0.5, 95 * D], pose: 'open' },
					{ arm: [-Math.PI / 2 - 0.35, 100 * D], pose: 'open' },
				],
			});
		};
		const hangPose = () => {
			holder.setAttribute('transform', 'translate(0 0)');
			const hip = { x: 0, y: 0.47 * u - 4 };
			fig.pose({
				hip,
				lean: 0.02,
				head: -0.1,
				ankles: [
					{ x: 0.05 * u, y: hip.y + 0.46 * u },
					{ x: -0.02 * u, y: hip.y + 0.455 * u },
				],
				feet: [0.25, 0.3],
				hands: [
					{ at: { x: 5.5, y: -9 }, pose: 'grip', d: 2, dir: -Math.PI / 2, roll: 0, contact: 'riser' },
					{ at: { x: -5.5, y: -9 }, pose: 'grip', d: 2, dir: -Math.PI / 2, roll: 0, contact: 'riser' },
				],
			});
		};
		const show = () => {
			const b = BODIES[key];
			(q('[data-drop]') as SVGElement).style.display = key === 'drop' ? '' : 'none';
			(q('[data-ball]') as SVGElement).style.display = key === 'ball' ? '' : 'none';
			(q('[data-chute]') as SVGElement).style.display = key === 'chute' ? '' : 'none';
			diverG.style.display = key === 'diver' || key === 'chute' ? '' : 'none';
			if (key === 'diver') freePose();
			if (key === 'chute') hangPose();
			// the graph's axes
			const ticks = q('[data-ticks]');
			ticks.replaceChildren();
			for (let tv = 0; tv <= b.tMax + 1e-9; tv += b.tStep) {
				const x = GX0 + ((GX1 - GX0) * tv) / b.tMax;
				ticks.append(el('line', { class: 'ln', x1: x.toFixed(1), x2: x.toFixed(1), y1: GY0, y2: GY0 + 4 }));
				ticks.append(el('text', { class: 'dfl__num', x: x.toFixed(1), y: GY0 + 16, 'text-anchor': 'middle' }, fmtTrim(tv, 1)));
			}
			for (let vv = 0; vv <= b.vMax + 1e-9; vv += b.vStep) {
				const y = GY0 - ((GY0 - GY1) * vv) / b.vMax;
				ticks.append(el('line', { class: 'ln', x1: GX0 - 4, x2: GX0, y1: y.toFixed(1), y2: y.toFixed(1) }));
				ticks.append(el('text', { class: 'dfl__num', x: GX0 - 6, y: (y + 4).toFixed(1), 'text-anchor': 'end' }, fmtTrim(vv, 1)));
			}
			const vt = vT(b);
			const yT = GY0 - ((GY0 - GY1) * vt) / b.vMax;
			q('[data-term]').setAttribute('y1', yT.toFixed(1));
			q('[data-term]').setAttribute('y2', yT.toFixed(1));
			const tl = q('[data-termlab]');
			tl.setAttribute('y', (yT - 5).toFixed(1));
			tl.textContent = `${fmt(vt, 1)} м/с`;
			let gh = '';
			for (let i = 0; i <= 120; i++) {
				const tv = (b.tMax * i) / 120;
				gh += `${i ? 'L' : 'M'}${(GX0 + ((GX1 - GX0) * i) / 120).toFixed(1)} ${(GY0 - ((GY0 - GY1) * speed(b, tv)) / b.vMax).toFixed(1)}`;
			}
			q('[data-ghost]').setAttribute('d', gh);
			// free fall υ = gt up to the top of the graph
			const tf = Math.min(b.tMax, b.vMax / G);
			q('[data-free]').setAttribute('d', `M${GX0} ${GY0} L${(GX0 + ((GX1 - GX0) * tf) / b.tMax).toFixed(1)} ${(GY0 - ((GY0 - GY1) * G * tf) / b.vMax).toFixed(1)}`);
			q('[data-rm]').textContent = `${b.mass}; ${force(b.m * G)}`;
		};
		const draw = () => {
			const b = BODIES[key];
			const vt = vT(b);
			const tt = Math.min(t, b.tMax);
			const v = speed(b, tt);
			const r = (v / vt) ** 2;
			const F = b.m * G * r;
			const a = G * (1 - r);
			// the body and its arrows; the chute's center is the person's hips
			q('[data-body]').setAttribute('transform', `translate(${BX} ${BY})`);
			const top = key === 'chute' ? BY - 50 : key === 'diver' ? BY - 20 : BY - 14;
			const bot = key === 'chute' ? BY + 40 : key === 'diver' ? BY + 14 : BY + 12;
			const ax = BX + (key === 'chute' ? 52 : key === 'diver' ? 54 : 34);
			const line = (sel: string, x: number, y1: number, y2: number) => {
				const e = q(sel);
				e.setAttribute('x1', x.toFixed(1));
				e.setAttribute('x2', x.toFixed(1));
				e.setAttribute('y1', y1.toFixed(1));
				e.setAttribute('y2', y2.toFixed(1));
				(e as SVGElement).style.visibility = Math.abs(y2 - y1) > 4 ? 'visible' : 'hidden';
			};
			line('[data-mg]', ax, bot - 10, bot - 10 + 46);
			const fl = 50 * r;
			line('[data-fd]', ax - 14, top + 10, top + 10 - Math.max(0, fl - 4));
			const lmg = q('[data-lmg]');
			lmg.setAttribute('x', String(ax + 5));
			lmg.setAttribute('y', (bot + 30).toFixed(1));
			const lfd = q('[data-lfd]');
			lfd.setAttribute('x', String(ax - 10));
			lfd.setAttribute('y', (top + 6 - fl).toFixed(1));
			(lfd as SVGElement).style.visibility = fl > 8 ? 'visible' : 'hidden';
			// the air rushes upward past the body
			for (const m of marks) {
				const y = ((((m.y0 - scroll) % 196) + 196) % 196) + 10; // above the clock
				m.m.setAttribute('x1', String(m.x));
				m.m.setAttribute('x2', String(m.x));
				m.m.setAttribute('y1', y.toFixed(1));
				m.m.setAttribute('y2', (y + Math.min(18, m.len * (0.2 + 1.6 * (v / vt)))).toFixed(1));
			}
			// the graph
			const n = Math.max(1, Math.round((120 * tt) / b.tMax));
			let d = '';
			for (let i = 0; i <= n; i++) {
				const tv = (tt * i) / n;
				d += `${i ? 'L' : 'M'}${(GX0 + ((GX1 - GX0) * tv) / b.tMax).toFixed(1)} ${(GY0 - ((GY0 - GY1) * speed(b, tv)) / b.vMax).toFixed(1)}`;
			}
			q('[data-curve]').setAttribute('d', d);
			q('[data-dot]').setAttribute('cx', (GX0 + ((GX1 - GX0) * tt) / b.tMax).toFixed(1));
			q('[data-dot]').setAttribute('cy', (GY0 - ((GY0 - GY1) * v) / b.vMax).toFixed(1));
			(q('[data-free]') as SVGElement).style.display = q<HTMLInputElement>('[data-free-on]').checked ? '' : 'none';
			q('[data-clock]').textContent = `t = ${fmt(tt, 2)} с`;
						q('[data-rv]').textContent = `${fmt(v, 2)} м/с`;
			q('[data-rf]').textContent = force(F);
			q('[data-ra]').textContent = `${fmt(a, 2)} м/с²`;
		};
		let paused = false;
		const pauseBtn = q<HTMLButtonElement>('[data-pause]');
		const wake = loop(root, (dt) => {
			if (paused) return false;
			const b = BODIES[key];
			t += dt / b.slow;
			const v = speed(b, Math.min(t, b.tMax));
			scroll += ((v / vT(b)) * 160 * dt) / 1; // the marks: 160 px a second at the final speed
			if (t > b.tMax + 1.5) {
				t = 0;
			}
			draw();
			return true;
		});
		const setPause = (on: boolean) => {
			paused = on;
			pauseBtn.setAttribute('aria-pressed', String(on));
			pauseBtn.textContent = on ? 'Дальше' : 'Пауза';
			if (!on) wake();
		};
		pauseBtn.addEventListener('click', () => setPause(!paused));
		const restart = () => {
			setPause(false);
			t = 0;
			draw();
			wake();
		};
		q('[data-what]').querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.b === key)));
		segment(q('[data-what]'), (btn) => {
			key = btn.dataset.b as Key;
			show();
			restart();
		});
		q('[data-go]').addEventListener('click', restart);
		q('[data-free-on]').addEventListener('change', draw);
		show();
		draw();
	}
</script>
