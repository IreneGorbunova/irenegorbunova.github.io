---
/**
 * «Ускорение свободного падения на высоте»: g = GM/(R + h)² with GM = 3,986·10¹⁴ м³/с², R = 6371 км (g₀ = 9,82 м/с²
 * at the surface). The height h goes from 0 to 40 000 км (step 10 км); buttons put the body at the height of a
 * plane (10 км), the space station (420 км), GPS satellites (20 200 км) and the geostationary orbit (35 786 км).
 * Top: the Earth and the body to scale (0,0065 px per км: the Earth is 41 px). Bottom: the graph g(h) with the point
 * of the chosen height. The arrow on the body is the force on 1 кг, F = g · 1 кг (violet: gravity in this chapter).
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const R = 6371;
const GM = 3.986e5; // км³/с² · 1000 → g in м/с² below
const g = (h: number) => (GM / (R + h) ** 2) * 1000;
// graph: x from 40 to 368 px for 0…40 000 км, y from 248 (0) to 140 (10 м/с²)
const gx = (h: number) => 40 + (h / 40000) * 328;
const gy = (v: number) => 248 - v * 10.8;
let curve = '';
for (let i = 0; i <= 200; i++) {
	const h = (40000 * i) / 200;
	curve += `${i ? 'L' : 'M'}${gx(h).toFixed(1)} ${gy(g(h)).toFixed(1)}`;
}
const KM = 300 / (R + 40000); // px per км, the top picture
---

<G7Styles />
<figure class="g7 g7--stack ghl not-content" data-ghl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 262" role="img" aria-label="Тело на разной высоте над Землёй и график ускорения свободного падения от высоты" data-svg>
			<defs>
				<marker id={`gh-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class="ghl__head" d="M0,0 L10,5 L0,10 z" /></marker>
			</defs>
			<rect class="ghl__space" x="0" y="0" width="380" height="118" />
			<circle class="ghl__earth" cx="46" cy="62" r={(R * KM).toFixed(1)} />
			<line class="ghl__ray" x1="46" y1="62" x2="376" y2="62" />
			{[420, 20200, 35786].map((h) => <line class="ghl__tick" x1={(46 + (R + h) * KM).toFixed(1)} x2={(46 + (R + h) * KM).toFixed(1)} y1="56" y2="68" />)}
			<line class="ghl__arrow" data-arr y1="62" y2="62" marker-end={`url(#gh-${uid})`} />
			<circle class="ghl__body" data-body cy="62" r="4" />
			<text class="t-small ghl__lab" x="8" y="112">Земля и тело в одном масштабе</text>
			<text class="t-strong t-num ghl__lab" data-top x="372" y="18" text-anchor="end"></text>
			<!-- the graph -->
			<line class="ln" x1="40" x2="370" y1="248" y2="248" />
			<line class="ln" x1="40" x2="40" y1="134" y2="248" />
			{[0, 2, 4, 6, 8, 10].map((v) => <><line class="ghl__grid" x1="40" x2="368" y1={gy(v)} y2={gy(v)} /><text class="t-small" x="34" y={gy(v) + 4} text-anchor="end">{v}</text></>)}
			{[0, 10000, 20000, 30000, 40000].map((h) => <text class="t-small" x={gx(h)} y="260" text-anchor="middle">{h / 1000}</text>)}
			<text class="t-small" x="44" y="132"><tspan class="t-i">g</tspan>, м/с²</text>
			<text class="t-small" x="368" y="242" text-anchor="end"><tspan class="t-i">h</tspan>, тыс. км</text>
			<path class="ghl__curve" d={curve} />
			<line class="ln-dash" data-gv y1="248" />
			<circle class="ghl__pt" data-pt r="4" />
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Высота над Землёй <i>h</i></span>
				<output data-oh></output>
				<input type="range" min="0" max="40000" step="10" value="0" data-h aria-label="Высота над Землёй, километры" />
			</label>
			<div class="g7__row" data-pre>
				<button type="button" class="g7__btn" data-v="0">У поверхности</button>
				<button type="button" class="g7__btn" data-v="10">Самолёт</button>
				<button type="button" class="g7__btn" data-v="420">Космическая станция</button>
				<button type="button" class="g7__btn" data-v="20200">Спутники GPS</button>
				<button type="button" class="g7__btn" data-v="35786">Геостационарная орбита</button>
			</div>
			<ul class="g7__lines" data-lines></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Радиус Земли 6371&nbsp;км. Фиолетовая стрелка — сила тяжести, действующая на тело массой 1&nbsp;кг; её длина пропорциональна <i>g</i>. Чёрточки на луче — орбиты станции, спутников GPS и геостационарных спутников.
	</figcaption>
</figure>

<style is:global>
	.ghl__space {
		fill: hsl(232, 40%, 10%);
	}
	.ghl__earth {
		fill: hsl(210, 60%, 42%);
		stroke: hsl(205, 80%, 70%);
		stroke-width: 1;
	}
	.ghl__ray {
		stroke: hsl(220, 20%, 60%);
		stroke-width: 0.6;
		stroke-dasharray: 2 3;
	}
	.ghl__tick {
		stroke: hsl(45, 80%, 70%);
		stroke-width: 1;
	}
	.ghl__body {
		fill: hsl(45, 90%, 65%);
	}
	.ghl__arrow {
		stroke: var(--g7-violet);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.ghl__head {
		fill: var(--g7-violet);
	}
	.ghl .g7__svg .ghl__lab {
		fill: hsl(220, 20%, 86%);
	}
	.ghl__grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.ghl__curve {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 2;
	}
	.ghl__pt {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
</style>

<script>
	import { fmt, fmtInt, k, tex } from '../g7/kit';

	const R = 6371;
	const GM = 3.986e5;
	const KM = 300 / (R + 40000);
	const g = (h: number) => (GM / (R + h) ** 2) * 1000;
	const gx = (h: number) => 40 + (h / 40000) * 328;
	const gy = (v: number) => 248 - v * 10.8;
	for (const root of document.querySelectorAll<HTMLElement>('[data-ghl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const sh = q<HTMLInputElement>('[data-h]');
		const draw = () => {
			const h = Number(sh.value);
			const v = g(h);
			const x = 46 + (R + h) * KM;
			q('[data-body]').setAttribute('cx', x.toFixed(1));
			const L = v * 5; // px for the force on 1 кг
			const a = q<SVGLineElement>('[data-arr]');
			a.setAttribute('x1', (x - 5).toFixed(1));
			a.setAttribute('x2', (x - 5 - Math.max(0, L - 3)).toFixed(1));
			a.style.visibility = L > 4 ? 'visible' : 'hidden';
			q('[data-pt]').setAttribute('cx', gx(h).toFixed(1));
			q('[data-pt]').setAttribute('cy', gy(v).toFixed(1));
			const gv = q('[data-gv]');
			gv.setAttribute('x1', gx(h).toFixed(1));
			gv.setAttribute('x2', gx(h).toFixed(1));
			gv.setAttribute('y2', gy(v).toFixed(1));
			const gs = fmt(v, v < 1 ? 3 : 2);
			q('[data-top]').textContent = `g = ${gs} м/с²`;
			q('[data-oh]').textContent = `${fmtInt(h)} км`;
			q('[data-lines]').innerHTML = [
				`<li>${k(`R + h = ${String(R + h).replace(/\B(?=(\d{3})+(?!\d))/g, '\\,')}~\\text{км}`)}</li>`,
				`<li class="is-key">${k(`g = G\\dfrac{M}{(R + h)^2} = ${tex(gs)}~\\text{м/с}^2`)}</li>`,
				`<li>${k(`\\dfrac{g}{g_0} = ${tex(fmt(v / g(0), 3))}`)}</li>`,
			].join('');
		};
		sh.addEventListener('input', draw);
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-pre] button'))
			b.addEventListener('click', () => {
				sh.value = b.dataset.v!;
				draw();
			});
		draw();
	}
</script>
