---
/**
 * Three schemes of elastic forces (static): (1) a spring fixed to a wall, free, stretched by x > 0 and compressed by
 * x < 0, with the elastic force on its free end against the deformation (blue), as F_упр x = −kx; (2) a book on a
 * board on two supports: the board sags (drawn many times larger than in life), pushes the book up with N (green)
 * and the book presses on the board with its weight P (gray), equal and opposite by the third law; (3) a lamp on a
 * cord: the stretched cord pulls the lamp up with F_упр (blue), gravity mg (violet) pulls down. Arrows of one panel
 * share one scale; deformations are exaggerated.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const spring = (x0: number, x1: number, y: number, n = 10, h = 7) => {
	const step = (x1 - x0 - 12) / n;
	let d = `M${x0} ${y} H${x0 + 6}`;
	for (let i = 0; i < n; i++) d += ` L${(x0 + 6 + step * (i + 0.25)).toFixed(1)} ${y - h} L${(x0 + 6 + step * (i + 0.75)).toFixed(1)} ${y + h}`;
	d += ` L${(x1 - 6).toFixed(1)} ${y} H${x1}`;
	return d;
};
const rows = [
	{ y: 34, end: 120, lab: 'не деформирована', F: 0 },
	{ y: 84, end: 150, lab: 'растянута: x > 0', F: -1 },
	{ y: 134, end: 92, lab: 'сжата: x < 0', F: 1 },
];
---

<G7Styles />
<figure class="g7 g7--pic elp not-content">
	<div class="g7__grid is-three">
		<svg class="g7__svg" viewBox="0 0 200 172" role="img" aria-label="Пружина: свободная, растянутая и сжатая; сила упругости направлена против деформации">
			<defs>
				{['blue', 'green', 'violet', 'ink'].map((c) => <marker id={`el-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c === 'violet' ? 'ink' : c} elp__h--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<rect class="elp__wall" x="8" y="10" width="10" height="148" />
			<line class="ln-dash" x1="120" x2="120" y1="14" y2="150" />
			<text class="t-title" x="192" y="16" text-anchor="end">Пружина</text>
			{rows.map((r) => (
				<g>
					<path class="elp__spring" d={spring(18, r.end, r.y)} />
					<rect class="elp__end" x={r.end} y={r.y - 9} width="8" height="18" rx="2" />
					{r.F !== 0 && <line class="arrow arrow--blue" x1={r.end + (r.F < 0 ? 0 : 8)} x2={r.end + (r.F < 0 ? -22 : 34)} y1={r.y - 14} y2={r.y - 14} marker-end={`url(#el-${uid}-blue)`} />}
					<text class="t-small" x="24" y={r.y + 22}>{r.lab}</text>
				</g>
			))}
			<text class="t-i t-blue t-halo" x="124" y="73" text-anchor="end">F<tspan class="elp__sub" dy="3">упр</tspan></text>
			<text class="t-i t-blue t-halo" x="132" y="124">F<tspan class="elp__sub" dy="3">упр</tspan></text>
			<line class="ln" x1="112" x2="190" y1="166" y2="166" marker-end={`url(#el-${uid}-ink)`} />
			<text class="t-i" x="184" y="160">x</text>
			<text class="t-small" x="116" y="160">0</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 172" role="img" aria-label="Книга на прогнувшейся доске: доска давит на книгу вверх, книга давит на доску вниз">
			<defs>
				{['green', 'ink'].map((c) => <marker id={`el2-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<rect class="elp__sup" x="22" y="118" width="14" height="44" />
			<rect class="elp__sup" x="164" y="118" width="14" height="44" />
			<path class="elp__board" d="M18 112 Q100 140 182 112 L182 120 Q100 148 18 120 Z" />
			<g transform="translate(100 125)">
				<rect class="elp__book" x="-26" y="-14" width="52" height="14" rx="2" />
				<rect class="elp__pages" x="-24" y="-11" width="48" height="8" />
			</g>
			<line class="elp__n" x1="92" y1="111" x2="92" y2="56" marker-end={`url(#el2-${uid}-green)`} />
			<text class="t-i t-green t-halo" x="76" y="66">N</text>
			<line class="elp__p" x1="108" y1="127" x2="108" y2="168" marker-end={`url(#el2-${uid}-ink)`} />
			<text class="t-i t-halo" x="114" y="160">P</text>
			<text class="t-title" x="8" y="20">Доска</text>
			<text class="t-small" x="8" y="34">(прогиб увеличен)</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 172" role="img" aria-label="Лампа на шнуре: шнур тянет лампу вверх, сила тяжести — вниз">
			<defs>
				{['blue', 'violet'].map((c) => <marker id={`el3-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`elp__h--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<rect class="elp__ceil" x="0" y="0" width="200" height="10" />
			<text class="t-title" x="8" y="30">Шнур</text>
			<line class="elp__cord" x1="100" y1="10" x2="100" y2="84" />
			<path class="elp__lamp" d="M86 84 H114 L128 106 H72 Z" />
			<circle class="elp__bulb" cx="100" cy="110" r="7" />
			<line class="elp__t" x1="100" y1="84" x2="100" y2="40" marker-end={`url(#el3-${uid}-blue)`} />
			<text class="t-i t-blue t-halo" x="106" y="52">F<tspan class="elp__sub" dy="3">упр</tspan></text>
			<line class="elp__mg" x1="100" y1="98" x2="100" y2="142" marker-end={`url(#el3-${uid}-violet)`} />
			<text class="t-i t-halo elp__lv" x="106" y="140">mg</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Пружина тянет назад, когда её растягивают, и толкает, когда сжимают. Прогнувшаяся доска давит на книгу вверх с силой <i>N</i>, а книга на доску — с силой <i>P</i>, её весом. Растянутый шнур держит лампу. Деформации на рисунке сильно увеличены.
	</figcaption>
</figure>

<style is:global>
	.elp__wall,
	.elp__ceil {
		fill: var(--sl-color-gray-4);
	}
	.elp__spring {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.elp__end {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.elp__sup {
		fill: var(--g7-wood-dark);
	}
	.elp__board {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.elp__book {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.elp__pages {
		fill: hsl(40, 40%, 92%);
	}
	.elp__n {
		stroke: var(--g7-green);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.elp__p {
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.elp__t {
		stroke: var(--g7-blue);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.elp__mg {
		stroke: var(--g7-violet);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.elp__h--blue {
		fill: var(--g7-blue);
	}
	.elp__h--violet {
		fill: var(--g7-violet);
	}
	.elp__h--green {
		fill: var(--g7-green);
	}
	.elp__h--ink {
		fill: var(--g7-ink);
	}
	.elp .g7__svg .elp__lv {
		fill: var(--g7-violet);
	}
	.elp__cord {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.elp__lamp {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.elp__bulb {
		fill: hsl(50, 90%, 85%);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.elp svg .elp__sub {
		font-size: 9px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>
