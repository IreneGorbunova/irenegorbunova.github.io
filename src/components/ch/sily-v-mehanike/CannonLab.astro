---
/**
 * «Пушка Ньютона»: a cannon on a mountain 100 км high fires a ball horizontally with the speed υ (1…12 км/с). No air,
 * the Earth does not turn; only gravity acts, F = GMm/r² (GM = 3,986·10¹⁴ м³/с², R = 6371 км). The path is computed
 * by steps of 5 с (velocity Verlet) until the ball lands, has gone round once, or leaves the picture. At this
 * height a circular orbit needs 7,85 км/с (86 мин a turn); escape needs 11,1 км/с. Results: 4 км/с lands about 700 км
 * away, 7 км/с 2300 км, 7,8 км/с 11 700 км (as this step computes them); 7,85 км/с — a near circle, 100…105 км
 * high, 86 мин; 9 км/с — an ellipse reaching 6051 км. Scale: the Earth is 70 px
 * (0,011 px per км), so the mountain is smaller than 2 px and is not drawn; the cannon marks its top. The flight is
 * played 2000 times faster than real time (at least 1,5 с, at most 8 с of the picture). The last paths stay, faded.
 */
import G7Styles from '../g7/G7Styles.astro';

const stars = Array.from({ length: 70 }, (_, i) => ({ x: (i * 83.7) % 380, y: (i * 47.3 + (i % 5) * 11) % 300, r: i % 9 === 0 ? 1.1 : 0.6 }));
---

<G7Styles />
<figure class="g7 cnl not-content" data-cnl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 300" role="img" aria-label="Пушка на вершине горы стреляет горизонтально; ядро падает на Землю или облетает её" data-svg>
			<rect class="cnl__space" x="0" y="0" width="380" height="300" />
			{stars.map((s) => <circle class="cnl__star" cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r} />)}
			<circle class="cnl__glow" cx="190" cy="160" r="73" />
			<circle class="cnl__earth" cx="190" cy="160" r="70" />
			<path class="cnl__land" d="M150 120 Q170 100 200 108 T240 140 Q230 165 205 160 T160 170 Q140 150 150 120 Z M200 200 Q215 190 230 205 Q220 225 205 222 Z" />
			<g data-old></g>
			<path class="cnl__path" data-path />
			<circle class="cnl__ball" data-ball r="3" />
			<g transform="translate(190 88.9)">
				<rect class="cnl__cannon" x="-3" y="-4" width="10" height="3.6" rx="1.2" />
				<circle class="cnl__wheel" cx="-1" cy="-1" r="1.8" />
			</g>
			<text class="t-strong t-num cnl__txt" x="8" y="20" data-time></text>
			<text class="t-small cnl__txt" x="8" y="292" data-res></text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Скорость ядра <i>υ</i></span>
				<output data-ov></output>
				<input type="range" min="1" max="12" step="0.05" value="4" data-v aria-label="Скорость ядра, километры в секунду" />
			</label>
			<div class="g7__row" data-pre>
				<button type="button" class="g7__btn" data-s="4">4</button>
				<button type="button" class="g7__btn" data-s="7">7</button>
				<button type="button" class="g7__btn" data-s="7.85">7,85</button>
				<button type="button" class="g7__btn" data-s="9">9</button>
				<button type="button" class="g7__btn" data-s="11.1">11,1</button>
				<span class="g7__label">км/с</span>
			</div>
			<button type="button" class="g7__btn g7__btn--go cnl__go" data-go>Выстрел</button>
			<ul class="g7__read">
				<li>Время полёта <b data-t></b></li>
				<li class="is-key">Итог <b data-what></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Пушка стоит на горе высотой 100&nbsp;км, выше воздуха (в масштабе рисунка гора меньше 2&nbsp;px). Сопротивления воздуха нет, вращение Земли не учитывается. Полёт показан в 2000 раз быстрее; бледные линии — предыдущие выстрелы.
	</figcaption>
</figure>

<style is:global>
	.cnl__space {
		fill: hsl(232, 40%, 9%);
	}
	.cnl__star {
		fill: white;
		opacity: 0.55;
	}
	.cnl__glow {
		fill: hsl(205, 80%, 60%);
		opacity: 0.25;
	}
	.cnl__earth {
		fill: hsl(210, 60%, 40%);
	}
	.cnl__land {
		fill: hsl(120, 25%, 40%);
	}
	.cnl__path {
		fill: none;
		stroke: hsl(45, 90%, 65%);
		stroke-width: 1.6;
	}
	.cnl__old {
		fill: none;
		stroke: hsl(45, 60%, 70%);
		stroke-width: 1;
		opacity: 0.35;
	}
	.cnl__ball {
		fill: hsl(45, 95%, 75%);
		stroke: hsl(30, 60%, 30%);
		stroke-width: 0.8;
	}
	.cnl__cannon {
		fill: hsl(220, 10%, 70%);
		stroke: hsl(220, 20%, 25%);
		stroke-width: 0.6;
	}
	.cnl__wheel {
		fill: hsl(28, 40%, 40%);
	}
	.cnl .g7__svg .cnl__txt {
		fill: hsl(220, 20%, 88%);
	}
	.cnl__go {
		justify-self: start;
	}
	.cnl .g7__read li b {
		white-space: normal;
		text-align: right;
	}
</style>

<script>
	import { fmt, fmtInt, fmtTrim, loop, el } from '../g7/kit';

	const GM = 3.986e14;
	const R = 6.371e6;
	const H = 1e5;
	const PX = 70 / R; // px per metre
	const C = { x: 190, y: 160 };
	const DT = 5;
	const SPEEDUP = 2000;
	type Res = { pts: { x: number; y: number; t: number }[]; kind: 'land' | 'orbit' | 'away'; T: number; far: number; range: number };
	const fly = (v: number): Res => {
		let x = 0;
		let y = R + H;
		let vx = v;
		let vy = 0;
		let t = 0;
		let turned = 0;
		let prev = Math.atan2(x, y);
		let far = H;
		const acc = (px: number, py: number) => {
			const r3 = Math.hypot(px, py) ** 3;
			return { ax: (-GM * px) / r3, ay: (-GM * py) / r3 };
		};
		let a = acc(x, y);
		const pts = [{ x, y, t }];
		while (t < 60000) {
			x += vx * DT + 0.5 * a.ax * DT * DT;
			y += vy * DT + 0.5 * a.ay * DT * DT;
			const b = acc(x, y);
			vx += 0.5 * (a.ax + b.ax) * DT;
			vy += 0.5 * (a.ay + b.ay) * DT;
			a = b;
			t += DT;
			const r = Math.hypot(x, y);
			far = Math.max(far, r - R);
			const ang = Math.atan2(x, y);
			let d = ang - prev;
			if (d < -Math.PI) d += 2 * Math.PI;
			if (d > Math.PI) d -= 2 * Math.PI;
			turned += d;
			prev = ang;
			pts.push({ x, y, t });
			if (r < R) return { pts, kind: 'land', T: t, far, range: turned * R };
			if (turned >= 2 * Math.PI) return { pts, kind: 'orbit', T: t, far, range: 0 };
			if (r > 4 * R) return { pts, kind: 'away', T: t, far, range: 0 };
		}
		return { pts, kind: 'away', T: t, far, range: 0 };
	};
	const scr = (p: { x: number; y: number }) => `${(C.x + p.x * PX).toFixed(1)} ${(C.y - p.y * PX).toFixed(1)}`;
	for (const root of document.querySelectorAll<HTMLElement>('[data-cnl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const sv = q<HTMLInputElement>('[data-v]');
		const old = q<SVGGElement>('[data-old]');
		const path = q('[data-path]');
		const ball = q('[data-ball]');
		let res = fly(Number(sv.value) * 1000);
		let tau = 0; // s of the picture
		let dur = 2;
		const what = (r: Res) =>
			r.kind === 'land'
				? `упало в ${fmtInt(Math.round(r.range / 1e5) * 100)} км от пушки`
				: r.kind === 'orbit'
					? `облетело Землю; наибольшая высота ${fmtInt(Math.round(r.far / 1e3))} км`
					: 'улетает от Земли';
		const draw = () => {
			const tf = Math.min(res.T, (tau / dur) * res.T);
			let d = '';
			let last = res.pts[0];
			for (const p of res.pts) {
				if (p.t > tf) break;
				d += `${d ? 'L' : 'M'}${scr(p)}`;
				last = p;
			}
			path.setAttribute('d', d);
			const [bx, by] = scr(last).split(' ');
			ball.setAttribute('cx', bx);
			ball.setAttribute('cy', by);
			q('[data-time]').textContent = `${fmt(tf / 60, 0)} мин`;
			q('[data-t]').textContent = `${fmt(tf / 60, 0)} мин`;
			const done = tf >= res.T;
			q('[data-what]').textContent = done ? what(res) : '…';
			q('[data-res]').textContent = done ? what(res) : '';
			q('[data-ov]').textContent = `${fmtTrim(Number(sv.value), 2)} км/с`;
		};
		const wake = loop(root, (dt) => {
			tau += dt;
			if (tau > dur + 2.5) tau = 0;
			draw();
			return true;
		});
		const shoot = () => {
			const prevD = path.getAttribute('d');
			if (prevD) {
				old.append(el('path', { class: 'cnl__old', d: prevD }));
				while (old.children.length > 4) old.firstElementChild!.remove();
			}
			res = fly(Number(sv.value) * 1000);
			dur = Math.min(8, Math.max(1.5, res.T / SPEEDUP));
			tau = 0;
			draw();
			wake();
		};
		sv.addEventListener('change', shoot);
		sv.addEventListener('input', () => (q('[data-ov]').textContent = `${fmtTrim(Number(sv.value), 2)} км/с`));
		q('[data-go]').addEventListener('click', shoot);
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-pre] button'))
			b.addEventListener('click', () => {
				sv.value = b.dataset.s!;
				shoot();
			});
		dur = Math.min(8, Math.max(1.5, res.T / SPEEDUP));
		draw();
	}
</script>
