---
/**
 * Colors of the people drawn by people.ts (the same palette as the person of «Давление. Закон Паскаля»). Renders
 * nothing; every picture of the chapter that draws a person includes it once.
 */
---

<style is:global>
	:root {
		--hm-skin: hsl(26, 55%, 72%);
		--hm-line: hsl(222, 35%, 14%);
		--hm-pants: hsl(225, 25%, 34%);
		--hm-shoe: hsl(210, 15%, 88%);
		--hm-hair: hsl(25, 40%, 28%);
		--hm-hair-b: hsl(38, 55%, 45%);
	}
	:root[data-theme='light'] {
		--hm-line: hsl(222, 30%, 22%);
		--hm-pants: hsl(225, 30%, 30%);
		--hm-shoe: hsl(210, 12%, 97%);
	}
	.hm-far {
		filter: brightness(0.8);
	}
	.hm-outline {
		fill: none;
		stroke: var(--hm-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.hm-limb,
	.hm-limb-skin {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.hm-limb-skin {
		stroke: var(--hm-skin);
	}
	.hm-limb.hm-pants {
		stroke: var(--hm-pants);
	}
	.hm-shirt {
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	.hm-seam {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.7;
		opacity: 0.55;
	}
	.hm-skin {
		fill: var(--hm-skin);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.hm-ear {
		stroke-width: 0.5;
	}
	.hm-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	.hm-eye {
		fill: var(--hm-line);
	}
	.hm-brow,
	.hm-mouth {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.7;
		stroke-linecap: round;
	}
	.hm-hair {
		fill: var(--hm-hair);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	.hm-blond .hm-hair {
		fill: var(--hm-hair-b);
	}
	.hm-tie {
		fill: var(--g7-red, var(--ig-vy));
	}
	.hm-shoe {
		fill: var(--hm-shoe);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.hm-sole {
		fill: var(--hm-line);
	}
	.hm-lace {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	/* shirt colors: the class goes on the torso and the sleeves */
	.hm-red {
		fill: var(--ig-vy);
		stroke: var(--ig-vy);
	}
	.hm-blue {
		fill: var(--ig-vx);
		stroke: var(--ig-vx);
	}
	.hm-green {
		fill: hsl(150, 50%, 50%);
		stroke: hsl(150, 50%, 50%);
	}
	.hm-gold {
		fill: var(--ig-v);
		stroke: var(--ig-v);
	}
	.hm-shirt.hm-red,
	.hm-shirt.hm-blue,
	.hm-shirt.hm-green,
	.hm-shirt.hm-gold {
		stroke: var(--hm-line);
	}
	.hm-limb.hm-red,
	.hm-limb.hm-blue,
	.hm-limb.hm-green,
	.hm-limb.hm-gold {
		fill: none;
	}
</style>
