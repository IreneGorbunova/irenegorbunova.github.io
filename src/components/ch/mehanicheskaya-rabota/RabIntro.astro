---
/**
 * Two short looping opening scenes of «Механическая работа и мощность». No terms of the chapter in the pictures.
 * Push: a man pushes a wall with all his might, and nothing moves; then he pushes a crate with 200 Н and moves it
 *   3 м (40 px per metre). The counter of «сделанное» stays at zero for the wall and grows to 600 for the crate
 *   (200 Н · 3 м = 600 Дж).
 * Floors: a girl of 40 кг goes up 9 м (three floors) by the stairs in 30 с and, another time, by the lift in 6 с.
 *   The clock of the picture runs four times faster than a real one; the heights are to scale (16 px per metre).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const person = 'M0 -30 V-12 M0 -12 L-6 0 M0 -12 L6 0 M0 -26 L12 -22';
---

<IntroFrame data-rabintro>
	<div class="intro__card" data-scene="push">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Человек изо всех сил толкает стену, и она не движется. Потом он толкает ящик и сдвигает его на три метра">
			<rect class="rb-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="rb-floor" x="0" y="200" width="360" height="40"></rect>
			<line class="rb-sep" x1="150" y1="20" x2="150" y2="196"></line>
			<rect class="rb-wall" x="96" y="90" width="26" height="110"></rect>
			<g transform="translate(74 200)">
				<circle class="rb-head" cx="0" cy="-37" r="7"></circle>
				<path class="rb-body" d={person}></path>
				<path class="rb-sweat" data-sweat d="M-12 -44 l-5 -6 M-14 -34 l-7 -1"></path>
			</g>
			<text class="rb-label" x="75" y="26" text-anchor="middle">толкает стену</text>
			<text class="rb-num" x="75" y="46" text-anchor="middle" data-a1>0 Дж</text>
			<g data-man>
				<circle class="rb-head" cx="0" cy="-37" r="7"></circle>
				<path class="rb-body" d={person}></path>
			</g>
			<g data-crate>
				<rect class="rb-crate" x="0" y="-36" width="36" height="36" rx="2"></rect>
			</g>
			<line class="rb-path" data-path x1="196" y1="208" x2="196" y2="208"></line>
			<text class="rb-label" x="255" y="26" text-anchor="middle">толкает ящик</text>
			<text class="rb-num" x="255" y="46" text-anchor="middle" data-a2>0 Дж</text>
		</svg>
		<div class="intro__foot">
			<p>
				Можно изо всех сил толкать стену и устать, а можно сдвинуть ящик. С точки зрения физики{' '}
				<More term="работа совершена только во втором случае">
					В физике работа совершается, только когда под действием силы тело проходит какой-то путь. Стена не сдвинулась — пути нет, и работа равна нулю, сколько бы сил ни было потрачено. Ящик проехал три метра под действием силы 200&nbsp;Н: работа равна 600&nbsp;Дж. Об этом — в разделе{' '}
					<a href="#механическая-работа">«Механическая работа»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="floors">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка поднимается на девять метров по лестнице за 30 секунд, а на лифте за 6 секунд">
			<rect class="rb-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="rb-floor" x="0" y="208" width="360" height="32"></rect>
			<rect class="rb-house" x="30" y="14" width="300" height="194"></rect>
			{[0, 1, 2].map((f) => <line class="rb-storey" x1="30" x2="330" y1={160 - f * 48} y2={160 - f * 48} />)}
			<!-- the stairs: three flights -->
			<path class="rb-stairs" d="M50 208 L130 160 L50 112 L130 64"></path>
			<circle class="rb-girl" data-g1 cx="50" cy="204" r="6"></circle>
			<!-- the lift -->
			<rect class="rb-shaft" x="236" y="18" width="44" height="190"></rect>
			<g data-cabin>
				<rect class="rb-cabin" x="238" y="-40" width="40" height="40" rx="2"></rect>
				<circle class="rb-girl" cx="258" cy="-12" r="6"></circle>
			</g>
			<path class="rb-axis" d="M306 208 V64 M302 208 h8 M302 64 h8"></path>
			<text class="rb-small" x="314" y="140">9 м</text>
			<text class="rb-label" x="50" y="229">по лестнице:</text>
			<text class="rb-num" x="126" y="230" data-c1>0 с</text>
			<text class="rb-label" x="216" y="229">на лифте:</text>
			<text class="rb-num" x="272" y="230" data-c2>0 с</text>
		</svg>
		<div class="intro__foot">
			<p>
				На четвёртый этаж можно подняться по лестнице за полминуты, а на лифте — за шесть секунд.{' '}
				<More term="Работа одна и та же, а время разное">
					И ноги, и мотор лифта поднимают девочку на одну и ту же высоту, то есть совершают одинаковую работу. Но мотор справляется в пять раз быстрее. Величину, которая показывает, как быстро совершается работа, называют мощностью. Об этом — в разделе{' '}
					<a href="#мощность">«Мощность»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-rabintro] .rb-sky {
		fill: var(--sl-color-bg);
	}
	[data-rabintro] .rb-floor {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-rabintro] .rb-sep {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	[data-rabintro] .rb-wall {
		fill: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-rabintro] .rb-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-rabintro] .rb-body {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-rabintro] .rb-sweat {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-rabintro] .rb-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-rabintro] .rb-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-rabintro] .rb-crate {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
		stroke: hsl(28, 50%, 26%);
		stroke-width: 1.5;
	}
	[data-rabintro] .rb-path {
		stroke: var(--ig-v);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-rabintro] .rb-house {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	[data-rabintro] .rb-storey {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	[data-rabintro] .rb-stairs {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	[data-rabintro] .rb-girl {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-rabintro] .rb-shaft {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-rabintro] .rb-cabin {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-rabintro] .rb-axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-rabintro] .rb-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-rabintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="push"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const man = $<SVGGElement>('[data-man]');
			const crate = $<SVGGElement>('[data-crate]');
			const path = $<SVGLineElement>('[data-path]');
			const a2 = $<SVGTextElement>('[data-a2]');
			const sweat = $<SVGPathElement>('[data-sweat]');
			scene(card, 6, (x) => {
				// the crate is pushed 3 м (120 px) evenly between 15 % and 85 % of the run
				const u = Math.min(1, Math.max(0, (x - 0.15) / 0.7));
				const dx = 120 * u;
				man.setAttribute('transform', `translate(${(180 + dx).toFixed(1)} 200)`);
				crate.setAttribute('transform', `translate(${(196 + dx).toFixed(1)} 200)`);
				path.setAttribute('x2', (196 + dx).toFixed(1));
				a2.textContent = `${Math.round(600 * u)} Дж`;
				sweat.style.opacity = String(0.4 + 0.6 * Math.abs(Math.sin(x * 20)));
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="floors"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const g1 = $<SVGCircleElement>('[data-g1]');
			const cabin = $<SVGGElement>('[data-cabin]');
			const c1 = $<SVGTextElement>('[data-c1]');
			const c2 = $<SVGTextElement>('[data-c2]');
			const RUN = 7.5;
			scene(card, RUN, (x) => {
				const t = x * RUN * 4; // seconds of the story: 30 с in all
				// the stairs: three flights of 3 м each, 10 с per flight
				const s = Math.min(3, t / 10);
				const f = Math.min(2, Math.floor(s));
				const u = s - f;
				const left = f % 2 === 0;
				g1.setAttribute('cx', (left ? 50 + 80 * u : 130 - 80 * u).toFixed(1));
				g1.setAttribute('cy', (204 - 48 * (f + u)).toFixed(1));
				c1.textContent = `${Math.round(Math.min(30, t))} с`;
				// the lift: 9 м in 6 с
				const v = Math.min(1, t / 6);
				cabin.setAttribute('transform', `translate(0 ${(208 - 144 * ease(v)).toFixed(1)})`);
				c2.textContent = `${Math.min(6, t).toFixed(t < 6 ? 1 : 0).replace('.', ',')} с`;
			});
		}
	}
</script>
