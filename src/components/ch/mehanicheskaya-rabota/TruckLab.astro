---
/**
 * «Грузовик на подъёме»: N = Fυ. A loaded truck of 20 т; the greatest power of its engine is 100 кВт (the power
 * that reaches the wheels). The gear sets the speed at full power: 1st — 5 м/с (18 км/ч), 2nd — 10 м/с (36 км/ч),
 * 3rd — 20 м/с (72 км/ч); so the pull is F = N/υ: 20, 10 and 5 кН. The road needs a pull to go evenly: on the level
 * 5 кН (rolling and air, taken the same at every speed), on a gentle rise 10 кН (5 кН more: g·m·h/l with a rise of
 * 2,55 м per 100 м), on a steep rise 20 кН (15 кН more: 7,65 м per 100 м).
 * The speed never jumps: a click changes the gear or the road, and the truck speeds up or slows down from the speed
 * it has, in real time (a = (F − need)/m):
 *   – at the speed of its gear, if the pull F = N/υ equals the need, the truck goes evenly, N = 100 кВт; if it is
 *     greater, the truck cannot go faster than its gear allows (the engine is at its top speed), the driver eases
 *     off: the pull equals the need and the power is need · υ, less than 100 кВт;
 *   – below the speed of its gear the engine at full throttle pulls with F = N/υ, but at most 1,5 times the pull at
 *     the gear's speed (its full power holds only over the upper third of the engine's speeds): 30, 15, 7,5 кН. If
 *     this is more than the need, the truck speeds up to the gear's speed; if less, it loses speed, and at 0 it
 *     stops and the brakes hold it (on the steep rise in the 3rd gear the speed falls by 0,6–0,75 м/с every second);
 *   – above the speed of its gear (after a shift down) the driver brakes, 1 м/с² (the pull is 0 meanwhile).
 * The picture: the camera goes with the truck, the road and the posts (every 20 м) slide back at the real speed,
 * 12 px per metre (the truck is 9 м long). The rises are drawn three times steeper than the real ones (1,5° and 4,4°
 * are drawn as 4,4° and 13°); the caption says so. Arrows: 2,5 px per кН; red — the pull of the engine, gray —
 * what holds the truck back (the need). Below, the chart of F against υ: the curve of F·υ = 100 кВт, the three gears
 * on it, and the current state as a point; the shaded rectangle F × υ is the power.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
// the chart: origin, px per м/с and per кН
const OX = 52;
const OY = 322;
const SX = 10.8;
const SY = 3.6;
const hyper = Array.from({ length: 43 }, (_, i) => {
	const v = 4 + (i * 21) / 42;
	return `${i ? 'L' : 'M'}${(OX + v * SX).toFixed(1)} ${(OY - (100 / v) * SY).toFixed(1)}`;
}).join(' ');
---

<G7Styles />
<figure class="g7 g7--wide trk not-content" data-trk>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 344" role="img" aria-label="Грузовик едет по дороге на одной из трёх передач; под ним график силы тяги от скорости" data-svg>
			<defs>
				<clipPath id={`trk-clip-${uid}`}><rect x="0" y="0" width="360" height="204" rx="8"></rect></clipPath>
				<marker id={`trk-r-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`trk-g-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="trk__gray-head" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<g clip-path={`url(#trk-clip-${uid})`}>
				<rect class="trk__sky" x="0" y="0" width="360" height="204"></rect>
				<path class="trk__hills" data-hills d=""></path>
				<g data-road>
					<rect class="trk__ground" x="-400" y="150" width="1200" height="400"></rect>
					<rect class="trk__asphalt" x="-400" y="150" width="1200" height="7"></rect>
					<line class="trk__dash" data-dash x1="-400" x2="800" y1="153.5" y2="153.5"></line>
					<path class="trk__post" data-posts d=""></path>
					<g transform="translate(180 150)">
						<g data-truck transform="scale(1.3333)">
							<rect class="trk__chassis" x="-41" y="-11" width="78" height="4" rx="1"></rect>
							<rect class="trk__box" x="-43" y="-34" width="56" height="23" rx="1.5"></rect>
							<path class="trk__rib" d="M-31 -34 V-11 M-19 -34 V-11 M-7 -34 V-11 M5 -34 V-11"></path>
							<path class="trk__cab" d="M15 -11 V-31 Q15 -33 17 -33 H30 Q31.5 -33 32.3 -31.6 L38 -21 V-11 Z"></path>
							<path class="trk__glass" d="M27 -30.5 H30.3 L35.4 -21.5 H27 Z"></path>
							<rect class="trk__lamp" x="36" y="-14" width="2.4" height="2.2"></rect>
							{[-31, -19.5, 27].map((x) => (
								<g data-wheel transform={`translate(${x} -5)`}>
									<circle class="trk__tyre" r="5.2"></circle>
									<circle class="trk__hub" r="2.4"></circle>
									<path class="trk__spoke" d="M0 -2.4 V2.4 M-2.4 0 H2.4"></path>
								</g>
							))}
						</g>
						<line class="arrow arrow--red" data-pull marker-end={`url(#trk-r-${uid})`}></line>
						<text class="t-small t-red t-halo trk__lab" data-pull-t></text>
						<line class="arrow trk__gray" data-need marker-end={`url(#trk-g-${uid})`}></line>
						<text class="t-small t-halo trk__lab" data-need-t></text>
					</g>
				</g>
			</g>
			<!-- the chart F(υ) -->
			<rect class="trk__power" data-rect x={OX} y={OY} width="0" height="0"></rect>
			<path class="ln" d={`M${OX} ${OY - 25 * SY - 6} V${OY} H${OX + 25 * SX + 6}`}></path>
			{[5, 10, 15, 20, 25].map((v) => (
				<>
					<line class="ln" x1={OX + v * SX} x2={OX + v * SX} y1={OY} y2={OY + 4} />
					<text class="t-small t-num" x={OX + v * SX} y={OY + 15} text-anchor="middle">{v}</text>
				</>
			))}
			{[5, 10, 15, 20].map((f) => (
				<>
					<line class="ln" x1={OX - 4} x2={OX} y1={OY - f * SY} y2={OY - f * SY} />
					<text class="t-small t-num" x={OX - 7} y={OY - f * SY + 4} text-anchor="end">{f}</text>
				</>
			))}
			<text class="t-small" x={OX + 25 * SX + 6} y={OY - 6} text-anchor="end"><tspan class="t-i">υ</tspan>, м/с</text>
			<text class="t-small" x={OX + 6} y={OY - 25 * SY - 2}><tspan class="t-i">F</tspan>, кН</text>
			<path class="trk__hyper" d={hyper}></path>
			<text class="t-small t-gold" x={OX + 9 * SX} y={OY - 17 * SY}><tspan class="t-i">Fυ</tspan> = 100&nbsp;кВт</text>
			{[{ v: 5, f: 20, n: '1' }, { v: 10, f: 10, n: '2' }, { v: 20, f: 5, n: '3' }].map((g) => (
				<>
					<circle class="trk__gear" cx={OX + g.v * SX} cy={OY - g.f * SY} r="3.2" />
					<text class="t-small" x={OX + g.v * SX + 6} y={OY - g.f * SY - 5}>{g.n}</text>
				</>
			))}
			<circle class="trk__now" data-now r="4.2"></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__label">Дорога</div>
			<div class="g7__seg" role="group" aria-label="Дорога" data-road-pick>
				<button type="button" class="g7__btn" aria-pressed="true" data-r="0">ровная</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-r="1">пологий подъём</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-r="2">крутой подъём</button>
			</div>
			<div class="g7__label">Передача</div>
			<div class="g7__seg" role="group" aria-label="Передача" data-gear-pick>
				<button type="button" class="g7__btn" aria-pressed="false" data-gr="0">1-я</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-gr="1">2-я</button>
				<button type="button" class="g7__btn" aria-pressed="true" data-gr="2">3-я</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Скорость <i>υ</i></span><b data-v></b></li>
				<li><span>Сила тяги <i>F</i></span><b data-f></b></li>
				<li class="is-key"><span>Мощность <i>N</i> = <i>Fυ</i></span><b data-n></b></li>
				<li><span>Нужна сила тяги</span><b data-needv></b></li>
			</ul>
			<p class="g7__msg" data-msg></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Наибольшая мощность двигателя грузовика массой 20&nbsp;т — 100&nbsp;кВт. Красная стрелка — сила тяги, серая — силы, которые мешают ехать. Подъёмы нарисованы втрое круче настоящих.
	</figcaption>
</figure>

<style is:global>
	.trk__sky {
		fill: var(--g7-sky);
	}
	.trk__hills {
		fill: color-mix(in oklab, var(--g7-green) 22%, var(--sl-color-gray-5));
	}
	.trk__ground {
		fill: color-mix(in oklab, var(--g7-green) 30%, var(--sl-color-gray-5));
	}
	.trk__asphalt {
		fill: var(--sl-color-gray-4);
	}
	.trk__dash {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-dasharray: 18 18;
	}
	.trk__post {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.trk__chassis {
		fill: var(--g7-ink);
	}
	.trk__box {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.trk__rib {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.6;
		opacity: 0.5;
	}
	.trk__cab {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.trk__glass {
		fill: color-mix(in oklab, var(--ig-vx) 60%, var(--sl-color-white));
	}
	.trk__lamp {
		fill: var(--g7-gold);
	}
	.trk__tyre {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.trk__hub {
		fill: var(--g7-steel);
	}
	.trk__spoke {
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.g7__svg .trk__gray {
		stroke: var(--g7-line);
	}
	.g7__svg .trk__gray-head {
		fill: var(--g7-line);
	}
	.g7__svg .trk__lab {
		font-weight: 700;
	}
	.trk__hyper {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
		stroke-dasharray: 5 3;
	}
	.trk__power {
		fill: color-mix(in oklab, var(--g7-gold) 22%, transparent);
		stroke: var(--g7-gold);
		stroke-width: 1;
	}
	.trk__gear {
		fill: var(--g7-paper);
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	.trk__now {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1.4;
	}
</style>

<script>
	import { fmt, fmtTrim, loop, segment } from '../g7/kit';

	const N = 100_000; // W
	const MASS = 20_000; // кг
	const GEAR_V = [5, 10, 20]; // м/с at full power
	const NEED = [5000, 10_000, 20_000]; // Н
	const ANGLE = [0, 4.4, 13]; // degrees as drawn (3 × the real 0, 1,46 and 4,38)
	const PXM = 12; // px per metre
	const KA = 2.5 / 1000; // px per newton
	const OX = 52;
	const OY = 322;
	const SX = 10.8;
	const SY = 3.6;
	for (const root of document.querySelectorAll<HTMLElement>('[data-trk]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const road = q<SVGGElement>('[data-road]');
		const dash = q<SVGLineElement>('[data-dash]');
		const posts = q<SVGPathElement>('[data-posts]');
		const hills = q<SVGPathElement>('[data-hills]');
		const wheels = [...root.querySelectorAll<SVGGElement>('[data-wheel]')];
		const wx = [-31, -19.5, 27];
		const pull = q<SVGLineElement>('[data-pull]');
		const pullT = q<SVGTextElement>('[data-pull-t]');
		const need = q<SVGLineElement>('[data-need]');
		const needT = q<SVGTextElement>('[data-need-t]');
		const rect = q<SVGRectElement>('[data-rect]');
		const now = q<SVGCircleElement>('[data-now]');
		let r = 0;
		let g = 2;
		let v = GEAR_V[g];
		let dist = 0; // м
		let turn = 0; // rad of the wheels
		const kmh = (x: number) => `${fmtTrim(x * 3.6, 0)} км/ч`;
		const state = () => {
			const vg = GEAR_V[g];
			const Fg = N / vg;
			const Fn = NEED[r];
			if (v > vg + 0.02) return { F: 0, kind: 'over' as const, a: -1 };
			if (v >= vg - 0.02) {
				if (Fg > Fn + 1) return { F: Fn, kind: 'more' as const, a: 0 };
				if (Fg < Fn - 1) return { F: Fg, kind: 'less' as const, a: (Fg - Fn) / MASS };
				return { F: Fn, kind: 'even' as const, a: 0 };
			}
			const Fmax = Math.min(v > 0.01 ? N / v : Infinity, 1.5 * Fg);
			if (Fmax > Fn + 1) return { F: Fmax, kind: 'up' as const, a: (Fmax - Fn) / MASS };
			if (Fmax < Fn - 1) return { F: Fmax, kind: v > 0 ? ('less' as const) : ('stop' as const), a: (Fmax - Fn) / MASS };
			return { F: Fn, kind: 'even' as const, a: 0 };
		};
		const draw = () => {
			const s = state();
			const P = s.F * v;
			road.setAttribute('transform', `rotate(${-ANGLE[r]} 180 150)`);
			const shift = (dist * PXM) % 36;
			dash.setAttribute('stroke-dashoffset', shift.toFixed(1));
			let d = '';
			const off = (dist * PXM) % 240;
			for (let k = -2; k <= 3; k++) {
				const x = k * 240 - off + 60;
				d += `M${x.toFixed(1)} 150 V136 M${(x - 3).toFixed(1)} 138 H${(x + 3).toFixed(1)} `;
			}
			posts.setAttribute('d', d);
			// far hills drift slowly
			const h0 = (dist * 0.6) % 240;
			let hd = 'M0 204 ';
			for (let x = -240; x <= 600; x += 6) {
				const X = x - h0;
				hd += `L${X.toFixed(0)} ${(118 - 18 * Math.sin(x / 38) - 10 * Math.sin(x / 17 + 1)).toFixed(1)} `;
			}
			hills.setAttribute('d', `${hd} L600 204 Z`);
			wheels.forEach((w, i) => w.setAttribute('transform', `translate(${wx[i]} -5) rotate(${((turn * 180) / Math.PI) % 360})`));
			// arrows: the pull from the cab forward, the need from the box backward
			const Lp = s.F * KA;
			pull.style.visibility = pullT.style.visibility = s.F > 1 ? 'visible' : 'hidden';
			const Ln = NEED[r] * KA;
			pull.setAttribute('x1', '53');
			pull.setAttribute('x2', (53 + Lp).toFixed(1));
			pull.setAttribute('y1', '-24');
			pull.setAttribute('y2', '-24');
			pullT.setAttribute('x', Math.max(53 + Lp + 8, 60).toFixed(1));
			pullT.setAttribute('y', '-52');
			pullT.setAttribute('text-anchor', 'end');
			pullT.textContent = `тянет ${fmtTrim(s.F / 1000, 1)} кН`;
			need.setAttribute('x1', '-60');
			need.setAttribute('x2', (-60 - Ln).toFixed(1));
			need.setAttribute('y1', '-24');
			need.setAttribute('y2', '-24');
			needT.setAttribute('x', Math.min(-60 - Ln - 8, -60).toFixed(1));
			needT.setAttribute('y', '-52');
			needT.textContent = `мешают ${fmtTrim(NEED[r] / 1000, 1)} кН`;
			// the chart
			const px = OX + v * SX;
			const py = OY - (s.F / 1000) * SY;
			now.setAttribute('cx', px.toFixed(1));
			now.setAttribute('cy', py.toFixed(1));
			rect.setAttribute('y', py.toFixed(1));
			rect.setAttribute('width', (px - OX).toFixed(1));
			rect.setAttribute('height', (OY - py).toFixed(1));
			// readouts
			q('[data-v]').textContent = `${fmt(v, 1)} м/с = ${kmh(v)}`;
			q('[data-f]').textContent = `${fmtTrim(s.F / 1000, 1)} кН`;
			q('[data-n]').textContent = `${fmtTrim(P / 1000, 0)} кВт`;
			q('[data-needv]').textContent = `${fmtTrim(NEED[r] / 1000, 1)} кН`;
			const msg = q('[data-msg]');
			msg.classList.toggle('is-right', s.kind === 'even');
			msg.textContent =
				s.kind === 'even'
					? 'Сила тяги равна той, что нужна: грузовик едет равномерно, двигатель работает на полную мощность.'
					: s.kind === 'more'
						? `Быстрее этой передачи не поехать, и водитель сбрасывает газ: двигатель отдаёт только ${fmtTrim(P / 1000, 0)} кВт из 100. Включите передачу повыше.`
						: s.kind === 'up'
							? 'Сила тяги больше той, что нужна: грузовик разгоняется.'
							: s.kind === 'over'
								? 'Для этой передачи скорость слишком большая: водитель притормаживает.'
								: s.kind === 'less'
									? `Сила тяги ${fmtTrim(s.F / 1000, 1)} кН меньше нужной: грузовик теряет скорость, мощность падает. Включите передачу пониже.`
									: 'Грузовик стоит: на этой передаче силы тяги не хватает. Включите передачу пониже.';
		};
		loop(root, (dt) => {
			const s = state();
			const vg = GEAR_V[g];
			if (s.kind === 'up') v = Math.min(vg, v + s.a * dt);
			else if (s.kind === 'over') v = Math.max(vg, v + s.a * dt);
			else if (s.kind === 'less') v = Math.max(0, v + s.a * dt);
			dist += v * dt;
			turn += (v * dt) / 0.55;
			draw();
			return true;
		})();
		segment(q('[data-road-pick]'), (b) => {
			r = Number(b.dataset.r);
			draw();
		});
		segment(q('[data-gear-pick]'), (b) => {
			g = Number(b.dataset.gr);
			draw();
		});
		draw();
	}
</script>
