---
/**
 * «Работа силы»: a crate is moved along a floor over a path s (0…10 м) while a force F (0…500 Н) acts on it.
 * Four cases: the force along the motion (A = F·s), the force of friction against the motion (A = −F·s), the
 * force of gravity at right angles to the motion (A = 0), and a man pushing a wall that does not move (s = 0, A = 0).
 *
 * The floor is to scale: 22 px per metre, the ruler above it shows the path. The crate is 1,2 × 1 м (in the case of
 * gravity it grows with its mass m = F/g as a crate of the same wood would, by the cube root of the mass: 5 кг —
 * 16 px, 51 кг — 36 px). In the three moving cases a man (176 см, people.ts, same scale) walks ahead of the crate
 * and pulls it with a level rope held behind his back, tied to the crate 85 см above the floor (lower on a small
 * crate); the rope is 2,7 м long, so even the longest arrow ends before his hands. Arrows: 0,1 px per newton for the shaft, the head (8 px) added beyond it, so 50 Н still has
 * a visible shaft; all start at the center of the crate. The red arrow is the force whose work is computed; in the
 * cases of friction and gravity a gray arrow shows the pull that moves the crate (equal to the friction, so the
 * motion is even; in the case of gravity its size is not to scale). The arrows never leave the picture: the
 * longest, 58 px, fits on either side of the crate at both ends of the path and below it.
 * The wall case is drawn larger (60 px per metre): a man of 176 см (people.ts) leans on a brick wall with both hands
 * flat on it; the red arrow is his force on the wall. «Пуск» shows him straining for the same 2,2 s; nothing moves.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from './PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const X0 = 62;
const M = 22;
const FL = 112;

const bricks = (x0: number, x1: number, y0: number, y1: number) => {
	let d = '';
	for (let y = y1 - 10, row = 0; y > y0; y -= 10, row++) {
		d += `M${x0} ${y} H${x1} `;
		for (let x = x0 + (row % 2 ? 11 : 0) + 11; x < x1; x += 22) d += `M${x} ${y} V${Math.min(y + 10, y1)} `;
	}
	return d;
};
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--stack wrk not-content" data-wrk>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 172" role="img" aria-label="Ящик движется по полу под действием силы" data-svg>
			<defs>
				<marker id={`wrk-r-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`wrk-g-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="wrk__gray-head" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="wrk__ground" x="0" y={FL} width="400" height={172 - FL}></rect>
			<line class="wrk__floor" x1="0" x2="400" y1={FL} y2={FL}></line>
			<!-- the ruler of the path -->
			<g data-ruler>
				<line class="ln" x1={X0} x2={X0 + 10 * M} y1="40" y2="40"></line>
				<line class="wrk__ruler-path" data-rpath x1={X0} x2={X0} y1="40" y2="40"></line>
				{Array.from({ length: 11 }, (_, i) => (
					<>
						<line class="ln" x1={X0 + i * M} x2={X0 + i * M} y1="36" y2="44" />
						<text class="t-small t-num" x={X0 + i * M} y="31" text-anchor="middle">{i}</text>
					</>
				))}
				<text class="t-small" x="8" y="44">путь, м</text>
				<line class="wrk__path" data-path x1={X0} y1={FL + 4} y2={FL + 4}></line>
				<g data-crate>
					<rect class="wrk__crate" data-box></rect>
					<path class="wrk__plank" data-planks></path>
					
				</g>
				<line class="wrk__rope" data-rope></line>
				<g data-puller></g>
				<line class="arrow wrk__gray" data-gray marker-end={`url(#wrk-g-${uid})`}></line>
				<text class="t-small" data-glabel>тяга</text>
				<text class="t-small t-num" data-mass text-anchor="middle"></text>
			</g>
			<!-- the wall case -->
			<g data-wallcase>
				<rect class="wrk__wall" x="300" y="0" width="100" height={FL}></rect>
				<path class="wrk__brick" d={bricks(300, 400, 0, FL)}></path>
				<line class="wrk__wall-edge" x1="300" y1="0" x2="300" y2={FL}></line>
				<g data-man></g>
				<text class="t-small" x="8" y={FL + 20}>Стена не сдвинулась: путь 0&nbsp;м</text>
			</g>
			<line class="arrow arrow--red" data-arrow marker-end={`url(#wrk-r-${uid})`}></line>
			<text class="t-i t-red t-halo" data-flabel>F</text>
			<text class="t-strong t-num" x="392" y="18" text-anchor="end" data-a style="font-size:15px"></text>
		</svg>
		<div class="g7__side wrk__side">
			<div class="g7__seg" role="group" aria-label="Какая сила" data-case>
				<button type="button" class="g7__btn" aria-pressed="true" data-c="pull">Сила тяги</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-c="fric">Сила трения</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-c="grav">Сила тяжести</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-c="wall">Толкаем стену</button>
			</div>
			<label class="g7__slider">
				<span data-fname>Сила тяги <i>F</i></span>
				<output data-of></output>
				<input type="range" min="0" max="500" step="50" value="200" data-f aria-label="Сила, ньютоны" />
			</label>
			<label class="g7__slider">
				<span>Путь <i>s</i></span>
				<output data-os></output>
				<input type="range" min="0" max="10" step="1" value="5" data-s aria-label="Путь, метры" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Пуск</button>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Пол и путь — в масштабе. Красная стрелка — сила, работу которой мы считаем, серая — сила, которая тянет ящик. Стена с человеком нарисована крупнее.
	</figcaption>
</figure>

<style is:global>
	.wrk__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.wrk__side .g7__seg,
	.wrk__side .g7__lines {
		grid-column: 1 / -1;
	}
	.wrk__floor {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.wrk__ground {
		fill: var(--g7-ground);
	}
	.wrk__path,
	.wrk__ruler-path {
		stroke: var(--g7-gold);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.wrk__rope {
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.wrk__crate {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.5;
	}
	.wrk__plank {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.g7__svg .wrk__gray {
		stroke: var(--g7-line);
		stroke-width: 2.4;
	}
	.g7__svg .wrk__gray-head {
		fill: var(--g7-line);
	}
	.wrk__wall {
		fill: color-mix(in oklab, var(--ig-vy) 38%, var(--sl-color-gray-4));
	}
	.wrk__brick {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 25%, var(--sl-color-gray-5));
		stroke-width: 1;
	}
	.wrk__wall-edge {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	@container (max-width: 30rem) {
		.wrk__side {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { fmtInt, k, loop, segment, tex } from '../g7/kit';
	import { gait, human } from './people';

	const X0 = 62;
	const M = 22;
	const FL = 112;
	const KF = 0.1; // px per newton
	const HEAD = 8; // px
	for (const root of document.querySelectorAll<HTMLElement>('[data-wrk]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const fIn = q<HTMLInputElement>('[data-f]');
		const sIn = q<HTMLInputElement>('[data-s]');
		const crate = q<SVGGElement>('[data-crate]');
		const box = q<SVGRectElement>('[data-box]');
		const planks = q<SVGPathElement>('[data-planks]');
		const mass = q<SVGTextElement>('[data-mass]');
		const arrow = q<SVGLineElement>('[data-arrow]');
		const label = q<SVGTextElement>('[data-flabel]');
		const gray = q<SVGLineElement>('[data-gray]');
		const glabel = q<SVGTextElement>('[data-glabel]');
		const ruler = q<SVGGElement>('[data-ruler]');
		const wallcase = q<SVGGElement>('[data-wallcase]');
		const fname = q('[data-fname]');
		// the man at the wall: 0,6 px per см, 176 см
		const S = 0.6;
		const u = S * 176;
		const man = human(q<SVGGElement>('[data-man]'), { s: S, H: 176, shirt: 'hm-green', hair: 'short' });
		// the man who pulls the crate: same scale as the floor
		const PS = M / 100;
		const puller = human(q<SVGGElement>('[data-puller]'), { s: PS, H: 176, shirt: 'hm-blue', hair: 'short' });
		const rope = q<SVGLineElement>('[data-rope]');
		const ankleUp = (a: number) => Math.max(20 * Math.sin(a) + 7 * Math.cos(a), -7.5 * Math.sin(a) + 7 * Math.cos(a)) * S;
		const handY = FL - 0.62 * u;
		const poseMan = (shake: number) => {
			const hip = { x: 300 - 0.47 * u + shake, y: FL - 0.445 * u };
			const back = 0.55;
			man({
				hip,
				lean: 0.8,
				ankles: [
					{ x: 300 - 0.77 * u, y: FL - ankleUp(back) },
					{ x: 300 - 0.45 * u, y: FL - ankleUp(0) },
				],
				feet: [back, 0],
				hands: [
					{ x: 300 - 0.9, y: handY },
					{ x: 300 - 0.9, y: handY + 3 },
				],
				palms: [-Math.PI / 2, -Math.PI / 2],
				head: -0.3,
			});
		};

		let kind = 'pull';
		let sKeep = Number(sIn.value);
		let u01 = 0; // the share of the path already covered (or of the push, for the wall)
		let running = false;
		const line = (e: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
			e.setAttribute('x1', x1.toFixed(1));
			e.setAttribute('y1', y1.toFixed(1));
			e.setAttribute('x2', x2.toFixed(1));
			e.setAttribute('y2', y2.toFixed(1));
		};
		const at = (e: SVGTextElement, x: number, y: number, anchor = 'start') => {
			e.setAttribute('x', x.toFixed(1));
			e.setAttribute('y', y.toFixed(1));
			e.setAttribute('text-anchor', anchor);
		};
		const draw = () => {
			const F = Number(fIn.value);
			const wall = kind === 'wall';
			const s = wall ? 0 : Number(sIn.value);
			ruler.style.display = wall ? 'none' : '';
			wallcase.style.display = wall ? '' : 'none';
			const L = KF * F; // the shaft; the head adds 8 px beyond it
			arrow.style.visibility = label.style.visibility = F > 0 ? 'visible' : 'hidden';
			if (wall) {
				poseMan(running ? 0.6 * Math.sin(u01 * 2.2 * 2 * Math.PI * 9) : 0);
				line(arrow, 300, handY + 1.5, 300 + L, handY + 1.5);
				at(label, 304 + L / 2, handY - 8, 'middle');
				label.textContent = 'F';
			} else {
				// the crate: 1,2 × 1 м, or of the size its mass needs in the case of gravity
				const side = kind === 'grav' ? 26 * Math.cbrt(Math.max(F, 10) / 9.8 / 20) : 0;
				const w = kind === 'grav' ? side : 26;
				const h = kind === 'grav' ? side : 22;
				box.setAttribute('x', String(-w / 2));
				box.setAttribute('y', String(-h));
				box.setAttribute('width', w.toFixed(1));
				box.setAttribute('height', h.toFixed(1));
				box.setAttribute('rx', '2');
				planks.setAttribute('d', `M${-w / 2} ${-h / 3} H${w / 2} M${-w / 2} ${(-2 * h) / 3} H${w / 2}`);
				const cx = X0 + s * M * u01;
				const cy = FL - h / 2;
				mass.style.display = kind === 'grav' && F > 0 ? '' : 'none';
				at(mass, cx, FL - h - 5, 'middle');
				mass.textContent = `${fmtInt(F / 9.8)} кг`;
				crate.setAttribute('transform', `translate(${cx.toFixed(1)} ${FL})`);
				q('[data-path]').setAttribute('x2', cx.toFixed(1));
				q('[data-rpath]').setAttribute('x2', cx.toFixed(1));
				gray.style.display = glabel.style.display = kind === 'fric' || kind === 'grav' ? '' : 'none';
				// the man ahead pulls the rope: it is level, tied to the front of the crate
				const yr = FL - Math.min(0.85 * M, h - 1.5);
				const hx = cx + w / 2 + 2.7 * M;
				rope.setAttribute('x1', (cx + w / 2).toFixed(1));
				rope.setAttribute('x2', hx.toFixed(1));
				rope.setAttribute('y1', yr.toFixed(1));
				rope.setAttribute('y2', yr.toFixed(1));
				const pu = PS * 176;
				const hip0 = { x: hx + 0.1 * pu, y: FL - 0.5 * pu };
				const walked = s * M * u01;
				const ft = gait(walked, 0.6 * M, hip0.x - walked + 0.3 * M, 2);
				puller({
					hip: hip0,
					lean: 0.3,
					ankles: [
						{ x: ft[0].x, y: FL - 6 * PS - ft[0].up },
						{ x: ft[1].x, y: FL - 6 * PS - ft[1].up },
					],
					feet: [0, 0],
					hands: [
						{ x: hx, y: yr },
						{ x: hx - 1, y: yr + 0.5 },
					],
					head: -0.15,
				});
				// labels stay clear of the crate even when the arrow is short
				const right = cx + w / 2;
				const left = cx - w / 2;
				if (kind === 'pull') {
					line(arrow, cx, cy, cx + L, cy);
					at(label, Math.max(cx + L + HEAD, right + 10), cy - 6, 'end');
					label.textContent = 'F';
				} else if (kind === 'fric') {
					line(arrow, cx, cy + 6, cx - L, cy + 6);
					at(label, Math.min(left - 3, Math.max(cx - L - HEAD + 24, 26)), cy - 2, 'end');
					label.innerHTML = 'F<tspan dy="3" font-size="10" font-style="normal">тр</tspan>';
					line(gray, cx, cy, cx + L, cy);
					at(glabel, Math.max(cx + L + HEAD, right + 26), cy - h / 2 - 4, 'end');
				} else {
					line(arrow, cx, cy, cx, cy + L);
					at(label, right + 3, Math.max(cy + L + HEAD, FL + 14), 'start');
					label.innerHTML = 'F<tspan dy="3" font-size="10" font-style="normal">тяж</tspan>';
					line(gray, cx, cy, cx + 26, cy);
					at(glabel, right + 2, cy - 6, 'start');
				}
			}
			q('[data-of]').textContent = `${F} Н`;
			q('[data-os]').textContent = `${s} м`;
			const A = kind === 'pull' ? F * s : kind === 'fric' ? -F * s : 0;
			at(q<SVGTextElement>('[data-a]'), wall ? 8 : 392, 18, wall ? 'start' : 'end');
			q('[data-a]').textContent = u01 >= 1 ? `A = ${fmtInt(A)} Дж` : '';
			const lines =
				kind === 'pull'
					? [`<li class="is-key">${k(`A = Fs = ${F} \\cdot ${s} = ${tex(fmtInt(F * s))}~\\text{Дж}`)}</li>`, '<li class="is-text">Сила направлена по движению: работа положительна.</li>']
					: kind === 'fric'
						? [`<li class="is-key">${k(`A = -F_{\\text{тр}}s = -${F} \\cdot ${s} = ${tex(fmtInt(-F * s))}~\\text{Дж}`)}</li>`, '<li class="is-text">Сила трения направлена против движения: её работа отрицательна.</li>']
						: kind === 'grav'
							? [`<li class="is-key">${k('A = 0~\\text{Дж}')}</li>`, '<li class="is-text">Сила тяжести направлена вниз, а ящик движется по горизонтали. Сила, перпендикулярная движению, работы не совершает.</li>']
							: [`<li class="is-key">${k(`A = Fs = ${F} \\cdot 0 = 0~\\text{Дж}`)}</li>`, '<li class="is-text">Стена не сдвинулась: пути нет — и работы нет, как бы сильно ни толкали.</li>'];
			q('[data-lines]').innerHTML = lines.join('');
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			u01 = Math.min(1, u01 + dt / 2.2);
			if (u01 >= 1) running = false;
			draw();
			return running;
		});
		const reset = () => {
			running = false;
			u01 = 0;
			draw();
		};
		q('[data-go]').addEventListener('click', () => {
			u01 = 0;
			running = true;
			wake();
		});
		fIn.addEventListener('input', reset);
		sIn.addEventListener('input', () => {
			sKeep = Number(sIn.value);
			reset();
		});
		const names: Record<string, string> = {
			pull: 'Сила тяги <i>F</i>',
			fric: 'Сила трения <i>F</i><sub>тр</sub>',
			grav: 'Сила тяжести <i>F</i><sub>тяж</sub>',
			wall: 'Сила рук <i>F</i>',
		};
		segment(q('[data-case]'), (b) => {
			kind = b.dataset.c!;
			fname.innerHTML = names[kind];
			// the wall does not move: the path is 0 and cannot be chosen
			sIn.disabled = kind === 'wall';
			sIn.value = String(kind === 'wall' ? 0 : sKeep);
			reset();
		});
		draw();
	}
</script>
