---
/**
 * «Лестница мощностей»: the six rows of the table of powers placed on one scale where every division is ten times
 * the one before (10 Вт … 10 000 МВт, 37 px per division). Positions: a person at long work 75 Вт (the table gives
 * 70–80 Вт), a horse 700 Вт, an electric kettle 2 кВт, a car engine 85 кВт (70–100 кВт), a diesel locomotive
 * 3000 кВт, the Sayano-Shushenskaya hydro power plant 6 400 000 кВт. The plant is about 85 million times as powerful
 * as the person (6,4·10⁹ / 75). The pictures are not to scale; only their places on the line are. Static.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from './PeopleStyles.astro';

const AX = 176; // the axis
const x = (w: number) => 24 + 37 * (Math.log10(w) - 1);
const items = [
	{ k: 'man', w: 75, name: 'человек', val: '75 Вт', row: 1 },
	{ k: 'horse', w: 700, name: 'лошадь', val: '700 Вт', row: 0 },
	{ k: 'kettle', w: 2000, name: 'чайник', val: '2 кВт', row: 1, dx: 8 },
	{ k: 'car', w: 85_000, name: 'автомобиль', val: '85 кВт', row: 1, dx: 16 },
	{ k: 'loco', w: 3_000_000, name: 'тепловоз', val: '3000 кВт', row: 0 },
	{ k: 'dam', w: 6.4e9, name: 'ГЭС', val: '6 400 000 кВт', row: 1 },
].map((it) => ({ dx: 0, ...it, x: x(it.w), base: it.row ? 158 : 70, ny: it.row ? 92 : 18 }));
const decades = [
	{ p: 1, t: '10 Вт' },
	{ p: 3, t: '1 кВт' },
	{ p: 5, t: '100 кВт' },
	{ p: 7, t: '10 МВт' },
	{ p: 9, t: '1000 МВт' },
];
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--pic pld not-content" data-pld>
	<svg class="g7__svg" viewBox="0 0 400 214" role="img" aria-label="Человек, лошадь, чайник, автомобиль, тепловоз и ГЭС на шкале мощностей, где каждое деление в десять раз больше предыдущего">
		<line class="pld__axis" x1="18" x2="366" y1={AX} y2={AX}></line>
		{Array.from({ length: 10 }, (_, i) => <line class="ln" x1={24 + 37 * i} x2={24 + 37 * i} y1={AX - 4} y2={AX + 4} />)}
		{decades.map((d) => (
			<text class="t-small t-num" x={24 + 37 * (d.p - 1)} y={AX + 18} text-anchor="middle">{d.t}</text>
		))}
		<text class="t-small" x="350" y={AX + 30} text-anchor="end">каждое деление — в 10 раз больше</text>
		{items.map((it) => (
			<g>
				<line class="pld__lead" x1={it.x} x2={it.x} y1={it.base + 2} y2={AX} />
				<circle class="pld__dot" cx={it.x} cy={AX} r="3" />
				<text class="t-small pld__name" x={it.x + it.dx} y={it.ny} text-anchor="middle">{it.name}</text>
				<text class="t-small t-num pld__val" x={it.x + it.dx} y={it.ny + 12} text-anchor="middle">{it.val}</text>
				<g transform={`translate(${it.x.toFixed(1)} ${it.base})`}>
					{it.k === 'man' && <g data-pld-man />}
					{it.k === 'horse' && (
						<g class="pld__horse" transform="scale(1.2)">
							<path class="pld__legs" d="M-13 -12 Q-11 -8 -13 -4.5 L-12.5 -0.6 M-9.5 -12 Q-8 -8 -9.8 -4.5 L-9.2 -0.6 M5 -12 L5.6 -6 L5 -0.6 M8.5 -12 L9.3 -6 L8.8 -0.6" />
							<path class="pld__hoof" d="M-14 -1.2 H-11.5 V0 H-14 Z M-10.7 -1.2 H-8.2 V0 H-10.7 Z M3.7 -1.2 H6.2 V0 H3.7 Z M7.5 -1.2 H10 V0 H7.5 Z" />
							<path class="pld__tail" d="M-15.8 -18.5 Q-20 -15 -18.6 -6" />
							<path d="M-14 -20 Q-6 -23 6 -21 Q9.5 -21.5 12 -25 L17 -30.5 Q18.5 -32 20 -30.5 L25 -24.5 Q25.5 -22.5 23.5 -22.7 L19 -25 Q16 -21 13.5 -15 Q12 -12 9 -11.5 L-12 -11.5 Q-16 -12 -16.5 -16 Q-16.5 -19.5 -14 -20 Z" />
							<path class="pld__mane" d="M11.5 -24.5 L16.6 -30.2" />
							<path class="pld__ear" d="M17.6 -31.2 L17.6 -33.4 L19 -31.6" />
							<circle class="pld__eye" cx="20.2" cy="-28.6" r="0.7" />
						</g>
					)}
					{it.k === 'kettle' && (
						<g>
							<rect class="pld__base" x="-9" y="-2.5" width="18" height="2.5" rx="1" />
							<path class="pld__kettle" d="M-7 -3 L-8 -19 Q0 -21 6 -19.5 L10 -23 L9 -17.5 L7 -3 Z" />
							<path class="pld__handle" d="M-8 -17 Q-14 -15 -12.5 -9 Q-11 -6 -7.5 -6" />
							<rect class="pld__lid" x="-5" y="-21.5" width="8" height="2" rx="1" />
						</g>
					)}
					{it.k === 'car' && (
						<g>
							<path class="pld__car" d="M-17 -4 L-17 -10 Q-16 -12 -12 -12.5 L-7 -18 Q-6 -19 -4 -19 L6 -19 Q8 -19 9 -17.5 L12 -12.5 Q17 -12 17.5 -9 L17.5 -4 Z" />
							<path class="pld__glass" d="M-6 -13 L-3.5 -17 L1 -17 L1 -13 Z M3 -13 L3 -17 L6.5 -17 L9 -13 Z" />
							<circle class="pld__wheel" cx="-10" cy="-4" r="3.6" />
							<circle class="pld__wheel" cx="10.5" cy="-4" r="3.6" />
						</g>
					)}
					{it.k === 'loco' && (
						<g>
							<rect class="pld__loco" x="-24" y="-20" width="48" height="14" rx="2" />
							<rect class="pld__loco-cab" x="12" y="-24" width="12" height="18" rx="1.5" />
							<rect class="pld__glass" x="15" y="-21.5" width="6" height="5" />
							<path class="pld__stripe" d="M-24 -11 H24" />
							<rect class="pld__frame" x="-22" y="-6" width="44" height="2" />
							{[-17, -11, 11, 17].map((w) => <circle class="pld__wheel" cx={w} cy="-2.6" r="2.6" />)}
							<path class="pld__rail" d="M-28 0 H28" />
						</g>
					)}
					{it.k === 'dam' && (
						<g>
							<path class="pld__water" d="M-22 -24 H-6 L-6 0 H-22 Z" />
							<path class="pld__dam" d="M-7 -28 H1 L10 0 H-7 Z" />
							<path class="pld__house" d="M10 -13 H23 V0 H10 Z" />
							<path class="pld__outflow" d="M23 -2 Q27 -2 29 0" />
							<path class="pld__bolt" d="M17.8 -12 L13.4 -5.8 H16.2 L14.6 -1 L19.6 -7.6 H16.8 L18.6 -12 Z" />
						</g>
					)}
				</g>
			</g>
		))}
	</svg>
	<figcaption class="g7__caption">
		Мощности из таблицы на одной шкале: каждое деление в 10 раз больше предыдущего. ГЭС мощнее человека примерно в 85 миллионов раз. Рисунки не в масштабе.
	</figcaption>
</figure>

<style is:global>
	.pld__axis {
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.pld__lead {
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.pld__dot {
		fill: var(--g7-gold);
	}
	.g7__svg .pld__name {
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .pld__val {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.pld__horse {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.pld__legs,
	.pld__tail {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.pld__tail {
		stroke-width: 1.8;
	}
	.pld__ear {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.pld__base,
	.pld__lid {
		fill: var(--g7-ink);
	}
	.pld__kettle {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.pld__handle {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.pld__car {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.pld__glass {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-white));
	}
	.pld__wheel {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pld__loco {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.pld__loco-cab {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.pld__stripe {
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	.pld__frame,
	.pld__rail {
		fill: var(--g7-ink);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pld__water {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-5));
	}
	.pld__dam {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.pld__house {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.pld__outflow {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.6;
	}
	.pld__hoof,
	.pld__eye {
		fill: var(--g7-ink);
	}
	.pld__mane {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.pld__bolt {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.5;
	}
	.pld__line {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
</style>

<script>
	import { human } from './people';

	// the person: 46 px tall, standing
	for (const root of document.querySelectorAll<HTMLElement>('[data-pld]')) {
		const g = root.querySelector<SVGGElement>('[data-pld-man]');
		if (!g) continue;
		const S = 46 / 175;
		const u = S * 175;
		human(g, { s: S, H: 175, shirt: 'hm-gold', hair: 'short' })({
			hip: { x: 0, y: -0.5 * u },
			lean: 0,
			ankles: [
				{ x: 0.05 * u, y: -7 * S },
				{ x: -0.05 * u, y: -7 * S },
			],
			feet: [0, 0],
			hands: [
				{ x: 0.06 * u, y: -0.44 * u },
				{ x: -0.04 * u, y: -0.44 * u },
			],
		});
	}
</script>
