---
/**
 * «Знак работы»: two looping panels, the people from people.ts. Scales: 45 px per metre for the ball, 75 px per
 * metre for the barbell.
 *
 * Ball: a girl (150 см) throws a volleyball (270 г, radius 11 см) straight up from her raised hands (palms on the ball
 *   from behind and below, as in a volleyball set), 1,72 м above the floor, at 7 м/с; it rises 2,5 м (υ²/2g) to 4,2 м
 *   and falls back into her hands. Slowed down three times: the flight takes 1,43 с, shown in 4,3 с. Blue arrow — the velocity (6 px per м/с, 42 px at the start), red — the
 *   force of gravity on the ball (2,65 Н, drawn 24 px, the same all the time). The counter shows the work of gravity
 *   in the current half of the flight: going up −m·g·Δh down to −6,6 Дж, falling +6,6 Дж.
 * Barbell: a weightlifter (172 см) seen from the front presses a barbell of 100 кг (a bar of 20 кг, 2,2 м long, and on
 *   each sleeve plates of 25 and 15 кг, 45 см across) from his shoulders, 1,42 м, to straight arms overhead, 2,00 м,
 *   in 1,2 с (real time): his hands do 100 · 9,8 · 0,58 = 568 Дж of work. Then he holds it still for 4,5 с: the work
 *   while holding is 0, the counter of the lift stays at 568 Дж. Arrows while holding: the force of gravity on the
 *   barbell (980 Н) and the push of his hands (980 Н), 0,04 px per newton, drawn at the two ends of the bar so they
 *   do not cross his head. The front view is drawn here (not people.ts, which draws people in profile), in the same
 *   style and proportions.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from './PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const GR = 282;
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--pic sgn not-content" data-sgn>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 220 300" role="img" aria-label="Девочка подбрасывает мяч вверх и ловит его. Стрелки показывают скорость мяча и силу тяжести" data-ball>
			<defs>
				<marker id={`sgn-r-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`sgn-b-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--blue" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`sgn-g-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--green" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="sgn__floor" x="0" y={GR} width="220" height={300 - GR}></rect>
			<line class="ln-dash" data-trace x1="0" x2="0" y1="0" y2="0"></line>
			<g data-girl></g>
			<g data-ball-g>
				<circle class="sgn__ball" r="5"></circle>
				<path class="sgn__seam" d="M-5 0 Q0 -3 5 0 M-1.5 -4.8 Q1.5 0 -1.5 4.8"></path>
			</g>
			<line class="arrow arrow--blue" data-v marker-end={`url(#sgn-b-${uid})`}></line>
			<text class="t-i t-blue t-halo" data-vt>υ</text>
			<line class="arrow arrow--red" data-fg marker-end={`url(#sgn-r-${uid})`}></line>
			<text class="t-i t-red t-halo" data-fgt>F<tspan dy="3" font-size="10" font-style="normal">тяж</tspan></text>
			<text class="t-title" x="10" y="20" data-head></text>
			<text class="t-small" x="10" y="36" data-sub></text>
			<text class="t-strong t-num" x="10" y="56" data-work style="font-size:14px"></text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 220 300" role="img" aria-label="Штангист поднимает штангу над головой и держит её неподвижно" data-bar>
			<rect class="sgn__floor" x="0" y={GR} width="220" height={300 - GR}></rect>
			<rect class="sgn__mat" x="30" y={GR - 4} width="170" height="4"></rect>
			<g data-lifter-back></g>
			<g data-barbell>
				<line class="sgn__sleeve" x1="-82.5" x2="82.5" y1="0" y2="0"></line>
				<line class="sgn__bar" x1="-49" x2="49" y1="0" y2="0"></line>
				{[-1, 1].map((d) => (
					<>
						<rect class="sgn__collar" x={d > 0 ? 47.5 : -49.5} y="-3.2" width="2" height="6.4" />
						<rect class="sgn__disc" x={d > 0 ? 49.5 : -54.4} y="-16.9" width="4.9" height="33.8" rx="1.2" />
						<rect class="sgn__disc sgn__disc--b" x={d > 0 ? 54.4 : -57.8} y="-16.9" width="3.4" height="33.8" rx="1.2" />
						<rect class="sgn__collar" x={d > 0 ? 57.8 : -59.3} y="-3.2" width="1.5" height="6.4" />
					</>
				))}
			</g>
			<g data-lifter-front></g>
			<line class="arrow arrow--green" data-up marker-end={`url(#sgn-g-${uid})`}></line>
			<text class="t-small t-green t-halo" data-upt>сила рук</text>
			<line class="arrow arrow--red" data-down marker-end={`url(#sgn-r-${uid})`}></line>
			<text class="t-i t-red t-halo" data-downt>F<tspan dy="3" font-size="10" font-style="normal">тяж</tspan></text>
			<text class="t-small" data-kg>100&nbsp;кг</text>
			<text class="t-title" x="10" y="20" data-head></text>
			<text class="t-small" x="10" y="36" data-sub></text>
			<text class="t-strong t-num" x="10" y="56" data-work style="font-size:14px"></text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Слева полёт мяча замедлен в три раза: синяя стрелка — скорость мяча, красная — сила тяжести. Справа штангист поднимает штангу и держит её неподвижно.
	</figcaption>
</figure>

<style is:global>
	.sgn__floor {
		fill: var(--g7-ground);
	}
	.sgn__mat {
		fill: var(--g7-wood);
	}
	.sgn__ball {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.sgn__seam {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.sgn__bar {
		stroke: var(--g7-steel);
		stroke-width: 2.2;
	}
	.sgn__sleeve {
		stroke: var(--g7-steel);
		stroke-width: 3.6;
	}
	.sgn__collar {
		fill: var(--g7-ink);
	}
	.sgn__disc--b {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--sl-color-gray-5));
	}
	.sgn__disc {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.sgn__shorts {
		fill: var(--hm-pants);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	.sgn__disc-in {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.6;
		opacity: 0.6;
	}
	.sgn__hub {
		fill: var(--g7-steel);
	}
</style>

<script>
	import { fmt, fmtInt, loop } from '../g7/kit';
	import { human, type HumanPose } from './people';
	import type { HandTarget } from '@components/people/body';
	import { joint } from '../davlenie-zakon-paskalya/person';

	const GR = 282;
	const g = 9.8;
	const ease = (x: number) => {
		const t = Math.min(1, Math.max(0, x));
		return t * t * (3 - 2 * t);
	};
	const setLine = (e: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
		e.setAttribute('x1', x1.toFixed(1));
		e.setAttribute('y1', y1.toFixed(1));
		e.setAttribute('x2', x2.toFixed(1));
		e.setAttribute('y2', y2.toFixed(1));
	};
	const place = (e: Element, x: number, y: number) => {
		e.setAttribute('x', x.toFixed(1));
		e.setAttribute('y', y.toFixed(1));
	};
	const stand = (S: number, x: number, u: number, hands: [{ x: number; y: number }, { x: number; y: number }]): HumanPose => ({
		hip: { x, y: GR - 0.5 * u },
		lean: 0,
		ankles: [
			{ x: x + 0.05 * u, y: GR - 7 * S * 0.95 },
			{ x: x - 0.06 * u, y: GR - 7 * S * 0.95 },
		],
		feet: [0, 0],
		hands,
	});

	for (const root of document.querySelectorAll<HTMLElement>('[data-sgn]')) {
		// ── the ball
		{
			const svg = root.querySelector<SVGSVGElement>('[data-ball]')!;
			const q = <T extends Element>(s: string) => svg.querySelector<T>(s)!;
			const PXM = 45; // px per metre
			const S = PXM / 100;
			const H = 150;
			const u = S * H;
			const girl = human(q<SVGGElement>('[data-girl]'), { s: S, H, shirt: 'hm-green', hair: 'pony' });
			const X = 84; // hip
			const Y0 = 1.72; // м, the ball's center in her hands, above her forehead
			const BX = X + 0.13 * u;
			// the hands hold the ball from behind and below, palms on the ball and the fingers up, as in a volleyball set
			const R = 11 * S; // the ball's radius, px
			const onBall = (a: number): HandTarget => ({
				at: { x: BX + R * Math.cos(a), y: GR - Y0 * PXM + R * Math.sin(a) },
				pose: 'flat',
				dir: a + Math.PI / 2, // the fingers along the ball, upward; the palm faces the ball's center
				contact: 'ball',
			});
			const st = stand(S, X, u, [{ x: 0, y: 0 }, { x: 0, y: 0 }]);
			// she stands straight (the hip joint 0,515 of her height above the floor), the arms raised
			girl({ ...st, hip: { x: X, y: GR - 0.515 * u }, head: -0.3, grips: [onBall(150 * (Math.PI / 180)), onBall(165 * (Math.PI / 180))], hands: [onBall(150 * (Math.PI / 180)).at!, onBall(165 * (Math.PI / 180)).at!] });
			const V0 = 7;
			const TF = (2 * V0) / g; // 1,43 s
			const SLOW = 3;
			const M = 0.27;
			const ball = q<SVGGElement>('[data-ball-g]');
			const trace = q<SVGLineElement>('[data-trace]');
			setLine(trace, BX, GR - Y0 * PXM, BX, GR - (Y0 + (V0 * V0) / (2 * g)) * PXM - 5);
			const va = q<SVGLineElement>('[data-v]');
			const vt = q<SVGTextElement>('[data-vt]');
			const fa = q<SVGLineElement>('[data-fg]');
			const ft = q<SVGTextElement>('[data-fgt]');
			const head = q('[data-head]');
			const sub = q('[data-sub]');
			const work = q('[data-work]');
			const CYCLE = 0.6 + TF * SLOW + 1.6;
			let t = 0;
			const draw = () => {
				const tf = Math.min(TF, Math.max(0, (t - 0.6) / SLOW)); // real seconds of flight
				const flying = t > 0.6 && t < 0.6 + TF * SLOW;
				const h = Y0 + V0 * tf - (g * tf * tf) / 2; // м
				const v = V0 - g * tf; // м/с, up positive
				const y = GR - h * PXM;
				ball.setAttribute('transform', `translate(${BX.toFixed(1)} ${y.toFixed(1)})`);
				// velocity on the left of the ball, gravity on the right
				const L = Math.abs(v) * 6;
				const show = flying && L > 3;
				va.style.display = vt.style.display = show ? '' : 'none';
				if (show) {
					const dir = v > 0 ? -1 : 1;
					setLine(va, BX - 8, y, BX - 8, y + dir * (L - 2));
					place(vt, BX - 22, y + dir * (L / 2) + 4);
				}
				setLine(fa, BX + 8, y, BX + 8, y + 22);
				place(ft, BX + 13, y + 22);
				const up = flying && v > 0;
				if (!flying) {
					head.textContent = t <= 0.6 ? 'Мяч в руках' : 'Мяч снова в руках';
					sub.textContent = t <= 0.6 ? 'Сейчас девочка подбросит его вверх' : 'Вверх A < 0, вниз A > 0';
				} else {
					head.textContent = up ? 'Мяч летит вверх' : 'Мяч падает';
					sub.textContent = up ? 'Сила тяжести против движения: A < 0' : 'Сила тяжести по движению: A > 0';
				}
				const top = Y0 + (V0 * V0) / (2 * g);
				const A = up || (!flying && t <= 0.6) ? -M * g * (h - Y0) : M * g * (top - h);
				work.textContent = `A = ${A > 0.04 ? '+' : ''}${Math.abs(A) < 0.05 ? '0' : fmt(A, 1)} Дж`;
				work.setAttribute('class', `t-strong t-num ${A < -0.04 ? 't-red' : A > 0.04 ? 't-green' : ''}`);
			};
			loop(svg, (dt) => {
				t = (t + dt) % CYCLE;
				draw();
				return true;
			})();
			draw();
		}
		// ── the barbell, the lifter seen from the front
		{
			const svg = root.querySelector<SVGSVGElement>('[data-bar]')!;
			const q = <T extends Element>(s: string) => svg.querySelector<T>(s)!;
			const PXM = 75; // px per metre
			const H = 1.72 * PXM; // px
			const X = 110;
			const NS = 'http://www.w3.org/2000/svg';
			const mk = (parent: Element, tag: string, attrs: Record<string, string | number>) => {
				const e = document.createElementNS(NS, tag);
				for (const [k2, v] of Object.entries(attrs)) e.setAttribute(k2, String(v));
				parent.append(e);
				return e;
			};
			const back = q<SVGGElement>('[data-lifter-back]');
			const front = q<SVGGElement>('[data-lifter-front]');
			const f1 = (v: number) => v.toFixed(1);
			// the body, which does not move: legs, shorts, trainers, torso in a singlet, neck and head
			const hipY = GR - 0.52 * H;
			const waistY = GR - 0.6 * H;
			const shY = GR - 0.81 * H;
			const SH = 0.125 * H; // half the distance between the shoulder joints
			for (const d of [-1, 1]) {
				const hx = X + d * 0.055 * H;
				const ax = X + d * 0.07 * H;
				mk(back, 'path', { class: 'hm-outline', d: `M${f1(hx)} ${f1(hipY)} L${f1(ax)} ${f1(GR - 6)}`, 'stroke-width': f1(0.078 * H + 1.4) });
				mk(back, 'path', { class: 'hm-limb-skin', d: `M${f1(hx)} ${f1(hipY)} L${f1(ax)} ${f1(GR - 6)}`, 'stroke-width': f1(0.078 * H) });
				// a trainer from the front
				mk(back, 'path', { class: 'hm-shoe', d: `M${f1(ax - 5.5)} ${GR} Q${f1(ax - 6)} ${GR - 7} ${f1(ax)} ${GR - 7.5} Q${f1(ax + 6)} ${GR - 7} ${f1(ax + 5.5)} ${GR} Z` });
				mk(back, 'rect', { class: 'hm-sole', x: f1(ax - 5.8), y: GR - 1.6, width: 11.6, height: 1.6 });
			}
			// shorts
			mk(back, 'path', { class: 'sgn__shorts', d: `M${f1(X - 0.105 * H)} ${f1(waistY)} H${f1(X + 0.105 * H)} L${f1(X + 0.13 * H)} ${f1(GR - 0.4 * H)} H${f1(X + 0.01 * H)} L${X} ${f1(GR - 0.47 * H)} L${f1(X - 0.01 * H)} ${f1(GR - 0.4 * H)} H${f1(X - 0.13 * H)} Z` });
			// shoulders and chest (skin), then the singlet over them
			mk(back, 'path', { class: 'hm-skin', d: `M${f1(X - SH - 4)} ${f1(shY + 6)} Q${f1(X - SH - 3)} ${f1(shY - 3)} ${f1(X - 0.05 * H)} ${f1(shY - 4)} H${f1(X + 0.05 * H)} Q${f1(X + SH + 3)} ${f1(shY - 3)} ${f1(X + SH + 4)} ${f1(shY + 6)} L${f1(X + 0.1 * H)} ${f1(waistY)} H${f1(X - 0.1 * H)} Z` });
			mk(back, 'path', { class: 'hm-shirt hm-red', d: `M${f1(X - 0.085 * H)} ${f1(shY - 3)} L${f1(X - 0.055 * H)} ${f1(shY - 3)} Q${X} ${f1(shY + 12)} ${f1(X + 0.055 * H)} ${f1(shY - 3)} L${f1(X + 0.085 * H)} ${f1(shY - 3)} L${f1(X + 0.1 * H)} ${f1(shY + 14)} L${f1(X + 0.108 * H)} ${f1(waistY + 2)} H${f1(X - 0.108 * H)} L${f1(X - 0.1 * H)} ${f1(shY + 14)} Z` });
			// neck and head
			const r = 0.064 * H;
			const hy = GR - 0.93 * H;
			mk(back, 'rect', { class: 'hm-skin', x: f1(X - 0.028 * H), y: f1(hy + r * 0.6), width: f1(0.056 * H), height: f1(shY - hy - r * 0.2) });
			for (const d of [-1, 1]) mk(back, 'ellipse', { class: 'hm-skin hm-ear', cx: f1(X + d * r * 0.98), cy: f1(hy + r * 0.1), rx: f1(r * 0.2), ry: f1(r * 0.3) });
			mk(back, 'ellipse', { class: 'hm-skin', cx: X, cy: f1(hy), rx: f1(r * 0.92), ry: f1(r) });
			mk(back, 'path', { class: 'hm-hair', d: `M${f1(X - r * 0.92)} ${f1(hy - r * 0.05)} Q${f1(X - r)} ${f1(hy - r * 1.15)} ${X} ${f1(hy - r * 1.08)} Q${f1(X + r)} ${f1(hy - r * 1.15)} ${f1(X + r * 0.92)} ${f1(hy - r * 0.05)} Q${f1(X + r * 0.6)} ${f1(hy - r * 0.6)} ${X} ${f1(hy - r * 0.55)} Q${f1(X - r * 0.6)} ${f1(hy - r * 0.6)} ${f1(X - r * 0.92)} ${f1(hy - r * 0.05)} Z` });
			for (const d of [-1, 1]) {
				mk(back, 'circle', { class: 'hm-eye', cx: f1(X + d * r * 0.36), cy: f1(hy - r * 0.02), r: f1(r * 0.11) });
				mk(back, 'path', { class: 'hm-brow', d: `M${f1(X + d * r * 0.2)} ${f1(hy - r * 0.26)} L${f1(X + d * r * 0.52)} ${f1(hy - r * 0.3)}` });
				mk(back, 'circle', { class: 'hm-cheek', cx: f1(X + d * r * 0.5), cy: f1(hy + r * 0.32), r: f1(r * 0.18) });
			}
			mk(back, 'path', { class: 'hm-mouth', d: `M${f1(X - r * 0.25)} ${f1(hy + r * 0.5)} L${f1(X + r * 0.25)} ${f1(hy + r * 0.5)}` });
			// the arms (they move), drawn over the bar so the hands grip it
			const arms = [-1, 1].map((d) => ({
				d,
				o: mk(front, 'path', { class: 'hm-outline', 'stroke-width': f1(0.064 * H + 1.4) }),
				l: mk(front, 'path', { class: 'hm-limb-skin', 'stroke-width': f1(0.064 * H) }),
				fist: mk(front, 'circle', { class: 'hm-skin', r: f1(0.036 * H) }),
			}));
			const bell = q<SVGGElement>('[data-barbell]');
			const LO = 1.42;
			const HI = 2.0;
			const MASS = 100;
			const up = q<SVGLineElement>('[data-up]');
			const upt = q<SVGTextElement>('[data-upt]');
			const down = q<SVGLineElement>('[data-down]');
			const downt = q<SVGTextElement>('[data-downt]');
			const kg = q<SVGTextElement>('[data-kg]');
			const head = q('[data-head]');
			const sub = q('[data-sub]');
			const work = q('[data-work]');
			const CYCLE = 6.5;
			let t = 0;
			const draw = () => {
				const k = ease((t - 0.8) / 1.2);
				const hm = LO + (HI - LO) * k; // м, the bar
				const tremble = k >= 1 ? 0.35 * Math.sin(t * 40) : 0;
				const by = GR - hm * PXM + tremble;
				bell.setAttribute('transform', `translate(${X} ${f1(by)})`);
				// the grip a little wider than the shoulders; at the shoulders the elbows fold down
				for (const a of arms) {
					const s0 = { x: X + a.d * SH, y: shY };
					const hand = { x: X + a.d * (0.16 + 0.04 * k) * H, y: by };
					const { j, end } = joint(s0, hand, 0.18 * H, 0.17 * H, a.d < 0 ? 1 : -1);
					const dd = `M${f1(s0.x)} ${f1(s0.y)} L${f1(j.x)} ${f1(j.y)} L${f1(end.x)} ${f1(end.y)}`;
					a.o.setAttribute('d', dd);
					a.l.setAttribute('d', dd);
					a.fist.setAttribute('cx', f1(end.x));
					a.fist.setAttribute('cy', f1(end.y));
				}
				place(kg, X + 70, by + 32);
				kg.setAttribute('text-anchor', 'middle');
				const hold = k >= 1;
				up.style.display = upt.style.display = down.style.display = downt.style.display = hold ? '' : 'none';
				if (hold) {
					// 980 Н each, 0,04 px per newton: 39 px with the head; at the two ends of the bar
					setLine(down, X - 70, by + 18, X - 70, by + 49);
					place(downt, X - 64, by + 56);
					setLine(up, X + 70, by - 18, X + 70, by - 49);
					place(upt, X + 70, by - 60);
					upt.setAttribute('text-anchor', 'middle');
				}
				const A = MASS * g * (hm - LO);
				if (t < 0.8) {
					head.textContent = 'Штанга на плечах';
					sub.textContent = 'Сейчас штангист поднимет её';
					work.textContent = 'A = 0 Дж';
				} else if (!hold) {
					head.textContent = 'Поднимает штангу';
					sub.textContent = 'Сила рук по движению: A > 0';
					work.textContent = `A = ${fmtInt(A)} Дж`;
				} else {
					head.textContent = `Держит: ${fmt(t - 2, 1)} с`;
					sub.textContent = 'Пока держит: A = 0 Дж';
					work.textContent = `За подъём: A = ${fmtInt(A)} Дж`;
				}
			};
			loop(svg, (dt) => {
				t = (t + dt) % CYCLE;
				draw();
				return true;
			})();
			draw();
		}
	}
</script>
