	import { scene } from '@components/intro/scene';
	import { winterScene, RUN as WINTER_RUN } from './winter';
	import { sirenScene, RUN as SIREN_RUN } from './siren';

	for (const root of document.querySelectorAll<HTMLElement>('[data-zgintro]')) {
