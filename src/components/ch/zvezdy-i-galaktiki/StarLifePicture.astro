---
/**
 * The life of a star as a branching chain of small looping animations (sizes NOT to scale, said in the caption):
 *   a cloud of gas and dust contracts → a young star inside the rest of the cloud → then by the mass:
 *   - a star like the Sun (5800 К, about 10 млрд лет on its long hydrogen stage) → a red giant (it swells to 80 % of
 *     the tile and cools to about 3200 К; drawn in a deeper red-orange than a 3200 К black body, as the sky of the
 *     opening scene saturates star colors) → a planetary nebula (the outer layers fly off as a glowing shell) → a white dwarf (a hot dot that
 *     slowly cools and dims);
 *   - a star of more than about 8 solar masses (25 000 К, blue; its hydrogen lasts tens of millions of years and less:
 *     about 40 млн лет at 8 M☉, about 10 млн лет at 20 M☉) → a red supergiant (3400 К, the same deep red-orange,
 *     larger than the tile) → a supernova explosion (a white-blue flash that fills the tile, then a colored shell of
 *     debris flying out) → a neutron star (a tiny ball turning
 *     with two beams) or, for the most massive ones, a black hole (a black disk; the light of the stars behind it is
 *     bent round it into a ring).
 * Borders by mass, known only roughly: below about 8 M☉ the end is a white dwarf, about 8–20 (25) M☉ a neutron star,
 * above about 20–25 M☉ a black hole. Colors from blackbody.ts. Each stage loops in 6 с; nothing goes at the real pace.
 * Laid out as a grid of tiles: three rows of four on a wide screen; the rows wrap into two columns on a phone.
 */
import ZgStyles from './ZgStyles.astro';
import { bbColor } from './blackbody';

// the giant and the supergiant: deep red-orange (saturated beyond the pale black-body color, as in sky.ts)
const C = { sun: bbColor(5800), hot: bbColor(25000), giant: 'rgb(238 96 44)', sg: 'rgb(226 78 38)', wd: bbColor(25000) };
const rnd = (i: number, k: number) => {
	const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
	return r - Math.floor(r);
};
const bg = Array.from({ length: 14 }, (_, i) => ({ x: (rnd(i, 1) * 100).toFixed(1), y: (rnd(i, 2) * 80).toFixed(1), r: (0.3 + rnd(i, 3) * 0.5).toFixed(2) }));
const cloud = Array.from({ length: 9 }, (_, i) => ({ dx: (rnd(i, 4) - 0.5) * 44, dy: (rnd(i, 5) - 0.5) * 30, r: 9 + rnd(i, 6) * 9 }));
const Tile = 'zg-life__tile';
---

<ZgStyles />
<figure class="zg zg-life not-content" data-zg-life>
	<div class="zg-life__row">
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Тёмное облако газа и пыли медленно сжимается">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<g data-cloud transform="translate(50 40)">
					{cloud.map((c) => <circle class="zg-life-cloud" cx={c.dx.toFixed(1)} cy={c.dy.toFixed(1)} r={c.r.toFixed(1)}></circle>)}
				</g>
			</svg>
			<p>Облако газа и пыли</p>
		</div>
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Внутри облака загорается молодая звезда">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<g data-rest transform="translate(50 40)">
					{cloud.map((c) => <circle class="zg-life-cloud" cx={(c.dx * 1.3).toFixed(1)} cy={(c.dy * 1.3).toFixed(1)} r={(c.r * 0.8).toFixed(1)}></circle>)}
				</g>
				<circle data-young cx="50" cy="40" r="4" fill={C.sun}></circle>
			</svg>
			<p>Молодая звезда</p>
		</div>
		<div class="zg-life__fork">
			<p>дальше — смотря по массе:</p>
			<p class="zg-life__b1">как Солнце ↓</p>
			<p class="zg-life__b2">больше 8 масс Солнца ↓↓</p>
		</div>
	</div>

	<p class="zg-life__head zg-life__b1">Звезда как Солнце</p>
	<div class="zg-life__row">
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Жёлтая звезда, как Солнце">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<circle cx="50" cy="40" r="14" fill={C.sun} opacity="0.25"></circle>
				<circle data-pulse cx="50" cy="40" r="9" fill={C.sun}></circle>
			</svg>
			<p>Звезда<br /><span>около 10 млрд лет</span></p>
		</div>
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Звезда раздувается и краснеет: красный гигант">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<circle data-giant cx="50" cy="40" r="9" fill={C.sun} data-c0={C.sun} data-c1={C.giant}></circle>
			</svg>
			<p>Красный гигант</p>
		</div>
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Наружные слои улетают светящейся оболочкой: планетарная туманность">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<circle class="zg-life-shell" data-shell cx="50" cy="40" r="10"></circle>
				<circle class="zg-life-shell zg-life-shell--in" data-shell2 cx="50" cy="40" r="6"></circle>
				<circle cx="50" cy="40" r="1.6" fill={C.wd}></circle>
			</svg>
			<p>Планетарная туманность</p>
		</div>
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Крошечная горячая звезда медленно остывает: белый карлик">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<circle data-wdglow cx="50" cy="40" r="6" fill={C.wd} opacity="0.3"></circle>
				<circle data-wd cx="50" cy="40" r="2" fill={C.wd}></circle>
			</svg>
			<p>Белый карлик</p>
		</div>
	</div>

	<p class="zg-life__head zg-life__b2">Звезда массой больше 8 масс Солнца</p>
	<div class="zg-life__row">
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Большая голубая звезда">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<circle cx="50" cy="40" r="18" fill={C.hot} opacity="0.25"></circle>
				<circle data-pulse cx="50" cy="40" r="12" fill={C.hot}></circle>
			</svg>
			<p>Звезда<br /><span>десятки миллионов лет и меньше</span></p>
		</div>
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Огромная красная звезда: красный сверхгигант">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<circle data-sg cx="50" cy="40" r="30" fill={C.sg}></circle>
			</svg>
			<p>Красный сверхгигант</p>
		</div>
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Звезда взрывается: яркая вспышка и разлетающиеся обломки">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<circle data-snstar cx="50" cy="40" r="12" fill={C.sg}></circle>
				<circle class="zg-life-shellsn" data-snshell cx="50" cy="40" r="6"></circle>
				<g data-debris transform="translate(50 40)">
					{Array.from({ length: 44 }, (_, i) => <circle class={`zg-life-debris zg-life-debris--${i % 3}`} data-a={((i / 44) * 2 * Math.PI + rnd(i, 7) * 0.25).toFixed(3)} data-v={(0.8 + rnd(i, 8) * 0.35).toFixed(2)} r={(1 + rnd(i, 9) * 0.9).toFixed(2)}></circle>)}
				</g>
				<circle class="zg-life-flash" data-flash cx="50" cy="40" r="6"></circle>
			</svg>
			<p>Взрыв сверхновой</p>
		</div>
		<div class={Tile}>
			<svg viewBox="0 0 100 80" role="img" aria-label="Слева нейтронная звезда, крошечный шарик с двумя вращающимися лучами; справа чёрная дыра, чёрный круг, вокруг которого изогнут свет звёзд">
				<rect class="zg-space" width="100" height="80" rx="6"></rect>
				{bg.map((s) => <circle class="zg-life-bg" cx={s.x} cy={s.y} r={s.r}></circle>)}
				<g data-beams transform="translate(26 40)">
					<path class="zg-life-beam" d="M0 0 L-4 -26 L4 -26 Z M0 0 L-4 26 L4 26 Z"></path>
				</g>
				<circle cx="26" cy="40" r="2.2" fill={C.wd}></circle>
				<path class="zg-life-split" d="M50 8 V72"></path>
				<circle class="zg-life-ring" cx="75" cy="40" r="11"></circle>
				<g data-lensed>
					{[0, 1, 2, 3].map((i) => <circle class="zg-life-bg zg-life-lensed" r="0.9" data-a={(i * 1.6).toFixed(2)}></circle>)}
				</g>
				<circle class="zg-life-hole" cx="75" cy="40" r="8"></circle>
			</svg>
			<p>Нейтронная звезда или чёрная дыра</p>
		</div>
	</div>
	<p class="zg__foot">Размеры не в масштабе: белый карлик размером с Землю, нейтронная звезда — около 20&nbsp;км в поперечнике, а красный сверхгигант больше орбиты Марса.</p>
</figure>

<style is:global>
	.zg-life__row {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem 0.9rem;
		max-width: 40rem;
		margin-inline: auto;
	}
	@media (max-width: 34rem) {
		.zg-life__row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.zg-life__tile {
		position: relative;
	}
	.zg-life__tile svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.4rem;
	}
	.zg-life__row .zg-life__tile + .zg-life__tile::before {
		content: '→';
		position: absolute;
		left: -0.85rem;
		top: 28%;
		font-size: 0.9rem;
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 34rem) {
		.zg-life__row .zg-life__tile:nth-child(odd)::before {
			content: none;
		}
	}
	.zg-life__tile p,
	.zg-life__fork p {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.25;
		color: var(--sl-color-gray-2);
		text-align: center;
	}
	.zg-life__tile p span {
		color: var(--sl-color-gray-3);
	}
	.zg-life__fork {
		grid-column: span 2;
		align-self: center;
	}
	.zg-life__fork p {
		text-align: start;
		font-size: var(--sl-text-sm);
	}
	.zg-life__head {
		max-width: 40rem;
		margin: 0.9rem auto 0.35rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.zg-life .zg-life__b1 {
		color: var(--ig-v);
	}
	.zg-life .zg-life__b2 {
		color: var(--ig-vx);
	}
	.zg-life-bg {
		fill: hsl(220, 30%, 85%);
		opacity: 0.6;
	}
	.zg-life-cloud {
		fill: hsl(20, 25%, 30%);
		opacity: 0.35;
	}
	.zg-life-shell {
		fill: none;
		stroke: hsl(170, 70%, 60%);
		stroke-width: 3;
	}
	.zg-life-shell--in {
		stroke: hsl(340, 70%, 65%);
		stroke-width: 2;
	}
	.zg-life-debris--0 {
		fill: hsl(25, 95%, 62%);
	}
	.zg-life-debris--1 {
		fill: hsl(355, 85%, 62%);
	}
	.zg-life-debris--2 {
		fill: hsl(175, 75%, 60%);
	}
	.zg-life-shellsn {
		fill: none;
		stroke: hsl(15, 90%, 60%);
		stroke-width: 5;
	}
	.zg-life-flash {
		fill: hsl(200, 100%, 94%);
	}
	.zg-life-beam {
		fill: hsl(200, 90%, 80%);
		opacity: 0.55;
	}
	.zg-life-split {
		stroke: hsl(220, 15%, 40%);
		stroke-width: 0.6;
		stroke-dasharray: 2 2;
	}
	.zg-life-ring {
		fill: none;
		stroke: hsl(40, 80%, 75%);
		stroke-width: 1.2;
		opacity: 0.7;
	}
	.zg-life-hole {
		fill: #000;
	}
</style>

<script>
	import { loop } from '@components/ch/g7/kit';

	const mix = (a: string, b: string, t: number) => {
		const pa = a.match(/\d+/g)!.map(Number);
		const pb = b.match(/\d+/g)!.map(Number);
		return `rgb(${pa.map((v, i) => Math.round(v + (pb[i] - v) * t)).join(' ')})`;
	};
	const sm = (x: number) => {
		const u = Math.min(1, Math.max(0, x));
		return u * u * (3 - 2 * u);
	};
	for (const fig of document.querySelectorAll<HTMLElement>('[data-zg-life]')) {
		const q = <E extends Element>(s: string) => fig.querySelector<E>(s)!;
		const qa = <E extends Element>(s: string) => [...fig.querySelectorAll<E>(s)];
		const cloud = q<SVGGElement>('[data-cloud]');
		const rest = q<SVGGElement>('[data-rest]');
		const young = q<SVGCircleElement>('[data-young]');
		const pulses = qa<SVGCircleElement>('[data-pulse]');
		const giant = q<SVGCircleElement>('[data-giant]');
		const shell = q<SVGCircleElement>('[data-shell]');
		const shell2 = q<SVGCircleElement>('[data-shell2]');
		const wd = q<SVGCircleElement>('[data-wd]');
		const wdg = q<SVGCircleElement>('[data-wdglow]');
		const sg = q<SVGCircleElement>('[data-sg]');
		const flash = q<SVGCircleElement>('[data-flash]');
		const snstar = q<SVGCircleElement>('[data-snstar]');
		const snshell = q<SVGCircleElement>('[data-snshell]');
		const debris = qa<SVGCircleElement>('[data-debris] circle');
		const beams = q<SVGGElement>('[data-beams]');
		const lensed = qa<SVGCircleElement>('[data-lensed] circle');
		let t = 0;
		const draw = () => {
			const u = (t % 6) / 6; // each stage loops in 6 s
			cloud.setAttribute('transform', `translate(50 40) scale(${(1 - 0.25 * sm(u / 0.9)).toFixed(3)})`);
			rest.setAttribute('transform', `translate(50 40) scale(${(1 + 0.4 * u).toFixed(3)})`);
			rest.setAttribute('opacity', (1 - 0.7 * u).toFixed(2));
			young.setAttribute('r', (1 + 3.5 * sm(u / 0.4)).toFixed(2));
			pulses.forEach((p, i) => p.setAttribute('r', ((i ? 12 : 9) + 0.5 * Math.sin(t * 2)).toFixed(2)));
			const gu = sm(u / 0.8);
			giant.setAttribute('r', (9 + 23 * gu).toFixed(2));
			giant.style.fill = mix(giant.dataset.c0!, giant.dataset.c1!, gu);
			shell.setAttribute('r', (6 + 28 * u).toFixed(1));
			shell.setAttribute('opacity', (1 - u).toFixed(2));
			shell2.setAttribute('r', (4 + 16 * u).toFixed(1));
			shell2.setAttribute('opacity', (1 - u).toFixed(2));
			wd.setAttribute('opacity', (1 - 0.55 * u).toFixed(2));
			wdg.setAttribute('opacity', (0.3 * (1 - u)).toFixed(2));
			sg.setAttribute('r', (47 + 1.5 * Math.sin(t * 1.2)).toFixed(2));
			// the supernova: the red star until 0,15; a white-blue flash fills the tile (0,15–0,25) and fades by 0,6; a
			// colored shell of debris flies out from 0,2
			snstar.setAttribute('opacity', u < 0.17 ? '1' : '0');
			const fu = (u - 0.15) / 0.1;
			const flr = u < 0.15 ? 0 : 6 + 60 * sm(fu);
			flash.setAttribute('r', flr.toFixed(1));
			flash.setAttribute('opacity', (u < 0.15 ? 0 : u < 0.27 ? 1 : Math.max(0, 1 - (u - 0.27) / 0.33)).toFixed(2));
			const su = Math.max(0, (u - 0.2) / 0.8);
			const sr = 6 + 40 * Math.sqrt(su);
			snshell.setAttribute('r', sr.toFixed(1));
			snshell.setAttribute('opacity', (u < 0.2 ? 0 : 0.75 * (1 - su * 0.7)).toFixed(2));
			snshell.setAttribute('stroke-width', (3 + 5 * su).toFixed(1));
			debris.forEach((d) => {
				const r = u < 0.2 ? 0 : sr * +d.dataset.v!;
				const a = +d.dataset.a!;
				d.setAttribute('cx', (r * Math.cos(a)).toFixed(1));
				d.setAttribute('cy', (r * Math.sin(a)).toFixed(1));
				d.setAttribute('opacity', u < 0.2 ? '0' : (1 - su * 0.6).toFixed(2));
			});
			beams.setAttribute('transform', `translate(26 40) rotate(${((t * 140) % 360).toFixed(1)})`);
			lensed.forEach((s) => {
				const a = +s.dataset.a! + t * 0.25;
				s.setAttribute('cx', (75 + 11 * Math.cos(a)).toFixed(1));
				s.setAttribute('cy', (40 + 11 * Math.sin(a)).toFixed(1));
			});
		};
		draw();
		loop(fig, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
