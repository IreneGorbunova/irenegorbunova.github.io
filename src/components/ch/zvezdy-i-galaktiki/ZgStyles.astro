---
/**
 * Frame, labels and buttons shared by the pictures and the model of the grade-9 chapter «Звёзды и галактики» (prefix
 * zg-). Renders nothing but a global stylesheet; theme variables only, so both themes work. Space is drawn dark in both
 * themes (it is dark), on a panel of the theme's own background color.
 */
---

<style is:global>
	.zg {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		--zg-space: hsl(230, 40%, 7%);
		--zg-ink: hsl(220, 25%, 88%);
		--zg-ink2: hsl(220, 15%, 66%);
	}
	.zg__svg {
		display: block;
		width: 100%;
		max-width: 34rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.6rem;
		user-select: none;
		-webkit-user-select: none;
	}
	.zg text {
		font-family: var(--__sl-font);
		font-size: 11px;
		fill: var(--zg-ink);
	}
	.zg .zg-small {
		font-size: 9.5px;
		fill: var(--zg-ink2);
	}
	.zg .zg-title {
		font-size: 12px;
		font-weight: 600;
	}
	.zg .zg-onpage {
		fill: var(--sl-color-gray-2);
	}
	.zg-space {
		fill: var(--zg-space);
	}
	.zg__foot {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.zg__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		justify-content: center;
		margin-top: 0.6rem;
	}
	.zg__btn {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.zg__btn:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.zg__btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.zg-lead {
		fill: none;
		stroke: var(--zg-ink2);
		stroke-width: 0.7;
	}
</style>
