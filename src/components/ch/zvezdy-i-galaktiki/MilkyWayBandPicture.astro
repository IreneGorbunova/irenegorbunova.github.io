---
/**
 * Why the Milky Way is a band (the point of the picture; grade 11's GalaxyPicture shows the structure instead): a line
 * of sight from the Sun turns a full circle in 12 с (6,7 times slower while it lies along the disk) in the plane of an
 * edge-on Galaxy: toward the center, up, away from the center, down. The stars of the drawing that the line passes (within 2 px) light up yellow: along the disk it
 * passes a crowd of them, across the disk a handful. The round window and the strip show what the eye gets from that
 * direction. (The yellow stars are the schematic dots of the drawing; the window and the strip use the model below.)
 *
 * The Galaxy, 3 px per 1000 св. лет: the disk 100 000 св. лет across (300 px), the Sun 26 000 св. лет from the center
 * (78 px), the bulge about 6000 × 3600 св. лет. The disk is really about 1000 св. лет thick (3 px); its stars and glow are
 * drawn about 3 times thicker (said in the caption).
 * «What is seen in this direction»: the number of stars along the line of sight, N(θ) = ∫ n(s) e^(−τ(s)) ds out to
 * 60 000 св. лет, for a model of the star density: a disk n ∝ exp(−R/8500 св. лет) · exp(−|z|/1000 св. лет) and a bulge
 * n ∝ 6 exp(−(r/3000 св. лет)²); dust in the disk dims the light, τ grows by 0,05 per 1000 св. лет in the plane and falls
 * off with height like the dust layer (300 св. лет). Relative to the largest value, N is 1 a few degrees off the plane
 * toward the center, 0,59 exactly in the plane (the dust lane: the Milky Way toward Sagittarius is split by dark
 * clouds), 0,012 away from the center and 0,002 straight up or down. Brightness and the number of dots follow √N (the
 * eye sees a range of brightness that large this way).
 * The round window shows 4 + 220·√N dots (stable random positions); the strip below collects the brightness of every
 * direction as the line turns: a cut across the sky, bright where the line lies along the disk.
 */
import ZgStyles from './ZgStyles.astro';

const GX = 180; // the center of the Galaxy
const GY = 96;
const K = 0.003; // px per св. год
const SUN = { x: GX + 26000 * K, y: GY };
const STRIP = { x0: 108, x1: 350, y0: 206, y1: 242 };
const rnd = (i: number, k: number) => {
	const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
	return r - Math.floor(r);
};
// the disk drawn as layers of stars (schematic texture; the brightness falls off from the center)
const diskStars = Array.from({ length: 700 }, (_, i) => {
	const u = rnd(i, 1);
	const R = -8500 * Math.log(1 - 0.995 * u) * (rnd(i, 2) < 0.5 ? -1 : 1);
	const z = (rnd(i, 3) - 0.5) * 2 * (Math.abs(R) < 4000 ? 2600 : 1500);
	return { x: GX + R * K, y: GY + z * K, r: 0.35 + rnd(i, 4) * 0.45 };
}).filter((s) => Math.abs(s.x - GX) < 150);
const win = Array.from({ length: 224 }, (_, i) => {
	const a = rnd(i, 5) * 2 * Math.PI;
	const r = 33 * Math.sqrt(rnd(i, 6));
	return { x: 60 + r * Math.cos(a), y: 224 + r * Math.sin(a), r: 0.4 + rnd(i, 7) * 0.6 };
});
const f1 = (v: number) => v.toFixed(1);
---

<ZgStyles />
<figure class="zg not-content" data-zg-band data-sun={JSON.stringify(SUN)} data-strip={JSON.stringify(STRIP)}>
	<svg class="zg__svg" viewBox="0 0 360 286" role="img" aria-label="Почему Млечный Путь — полоса на небе. Луч зрения от Солнца поворачивается по кругу; звёзды, мимо которых он проходит, загораются: вдоль диска Галактики их множество, поперёк — единицы. В окне видно, сколько звёзд в этом направлении; внизу полоса собирает яркость неба по всем направлениям">
		<defs>
			<radialGradient id="zg-band-disk" cx={GX} cy={GY} r="150" gradientUnits="userSpaceOnUse" gradientTransform={`translate(0 ${GY}) scale(1 0.06) translate(0 ${-GY})`}>
				<stop offset="0" stop-color="hsl(45, 80%, 85%)" stop-opacity="0.95"></stop>
				<stop offset="0.6" stop-color="hsl(215, 40%, 75%)" stop-opacity="0.45"></stop>
				<stop offset="1" stop-color="hsl(215, 40%, 75%)" stop-opacity="0.05"></stop>
			</radialGradient>
			<radialGradient id="zg-band-bulge">
				<stop offset="0" stop-color="hsl(45, 85%, 85%)" stop-opacity="0.95"></stop>
				<stop offset="1" stop-color="hsl(40, 70%, 70%)" stop-opacity="0"></stop>
			</radialGradient>
			<clipPath id="zg-band-top"><rect x="0" y="30" width="360" height="138"></rect></clipPath>
			<clipPath id="zg-band-win"><circle cx="60" cy="224" r="35"></circle></clipPath>
		</defs>
		<rect class="zg-space" x="0" y="0" width="360" height="286" rx="8"></rect>
		<text class="zg-title" x="12" y="20">Почему Млечный Путь — полоса</text>
		<text class="zg-small zg-band-note" x="20" y="128">вдоль диска луч проходит</text>
		<text class="zg-small zg-band-note" x="20" y="139">мимо множества звёзд</text>
		<text class="zg-small zg-band-note" x="262" y="44" text-anchor="end">поперёк —</text>
		<text class="zg-small zg-band-note" x="262" y="55" text-anchor="end">мимо немногих</text>
		<ellipse cx={GX} cy={GY} rx="150" ry="5.5" fill="url(#zg-band-disk)"></ellipse>
		<ellipse cx={GX} cy={GY} rx={3000 * K * 1.6} ry={1800 * K * 2} fill="url(#zg-band-bulge)"></ellipse>
		{diskStars.map((s) => <circle class="zg-band-star" data-ds cx={f1(s.x)} cy={f1(s.y)} r={s.r.toFixed(2)}></circle>)}
		<path class="zg-band-dust" d={`M${GX - 148} ${GY} H${GX + 148}`}></path>
		<path class="zg-band-ray" data-ray d="" clip-path="url(#zg-band-top)"></path>
		<circle class="zg-band-sun" cx={SUN.x} cy={SUN.y} r="3"></circle>
		<path class="zg-lead" d={`M${SUN.x} ${SUN.y + 4} L${SUN.x + 12} ${SUN.y + 26}`}></path>
		<text x={SUN.x + 6} y={SUN.y + 37}>Солнце</text>
		<path class="zg-lead" d={`M${GX} ${GY + 7} L${GX - 10} ${GY + 26}`}></path>
		<text x={GX - 10} y={GY + 37} text-anchor="middle">центр</text>
		<path class="zg-band-bar" d={`M262 14 h30 M262 10 v8 M292 10 v8`}></path>
		<text class="zg-small" x="298" y="17">10 000</text>
		<text class="zg-small" x="298" y="28">св. лет</text>
		<!-- what is seen in this direction -->
		<text class="zg-small" x="60" y="181" text-anchor="middle">видно вдоль луча</text>
		<circle class="zg-band-winbg" cx="60" cy="224" r="35"></circle>
		<circle class="zg-band-glow" data-glow cx="60" cy="224" r="35"></circle>
		<g clip-path="url(#zg-band-win)">
			{win.map((s, i) => <circle class="zg-band-wstar" data-w={i} cx={f1(s.x)} cy={f1(s.y)} r={s.r.toFixed(2)}></circle>)}
		</g>
		<circle class="zg-band-rim" cx="60" cy="224" r="35"></circle>
		<!-- the strip: the sky across, direction by direction -->
		<text class="zg-small" x={STRIP.x0} y={STRIP.y0 - 8}>яркость неба по кругу</text>
		<rect class="zg-band-winbg" x={STRIP.x0} y={STRIP.y0} width={STRIP.x1 - STRIP.x0} height={STRIP.y1 - STRIP.y0}></rect>
		<g data-strip-g></g>
		<rect class="zg-band-cursor" data-cursor x={STRIP.x0} y={STRIP.y0 - 2} width="1.6" height={STRIP.y1 - STRIP.y0 + 4}></rect>
		{
			['к центру', 'вверх', 'от центра', 'вниз', 'к центру'].map((s, i) => (
				<text class="zg-small" x={f1(STRIP.x0 + (i * (STRIP.x1 - STRIP.x0)) / 4)} y={STRIP.y1 + 13} text-anchor={i === 0 ? 'start' : i === 4 ? 'end' : 'middle'}>
					{s}
				</text>
			))
		}
	</svg>
	<p class="zg__foot">Мы смотрим на Галактику изнутри. Вдоль её диска луч зрения проходит мимо множества звёзд, их свет сливается — на небе это светлая полоса Млечного Пути. Поперёк диска звёзд на луче мало, и небо там тёмное. Толщина диска преувеличена в 3 раза.</p>
</figure>

<style is:global>
	.zg .zg-band-note {
		fill: hsl(48, 100%, 72%);
	}
	.zg-band-hit {
		fill: hsl(48, 100%, 65%) !important;
		opacity: 1 !important;
		r: 1.1px;
	}
	.zg-band-star {
		fill: hsl(220, 30%, 92%);
		opacity: 0.55;
	}
	.zg-band-dust {
		stroke: hsl(20, 30%, 12%);
		stroke-width: 1.4;
		opacity: 0.8;
	}
	.zg-band-sun {
		fill: hsl(48, 100%, 60%);
		stroke: hsl(230, 40%, 7%);
		stroke-width: 1;
	}
	.zg-band-ray {
		fill: none;
		stroke: hsl(48, 100%, 70%);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.zg-band-bar {
		fill: none;
		stroke: var(--zg-ink2);
		stroke-width: 1;
	}
	.zg-band-winbg {
		fill: hsl(232, 45%, 4%);
	}
	.zg-band-glow {
		fill: hsl(45, 60%, 80%);
	}
	.zg-band-wstar {
		fill: hsl(220, 30%, 94%);
	}
	.zg-band-rim {
		fill: none;
		stroke: var(--zg-ink2);
		stroke-width: 1.2;
	}
	.zg-band-col {
		fill: hsl(45, 55%, 85%);
	}
	.zg-band-cursor {
		fill: hsl(48, 100%, 70%);
	}
</style>

<script>
	import { loop, NS } from '@components/ch/g7/kit';

	// number of stars along a line of sight from the Sun (26 000 св. лет from the center, in the plane), direction θ in the
	// picture (0 toward the center, π/2 up); units of 1000 св. лет
	const count = (th: number) => {
		let n = 0;
		let tau = 0;
		const ds = 0.25;
		for (let s = ds / 2; s < 60; s += ds) {
			const x = 26 - s * Math.cos(th); // distance from the center along the plane of the picture
			const z = s * Math.sin(th);
			const R = Math.abs(x);
			const r = Math.hypot(x, z);
			const dens = Math.exp(-R / 8.5) * Math.exp(-Math.abs(z) / 1.0) + 6 * Math.exp(-((r / 3) ** 2));
			tau += 0.05 * Math.exp(-Math.abs(z) / 0.3) * ds;
			n += dens * Math.exp(-tau) * ds;
		}
		return n;
	};
	const NA = 180;
	const table = Array.from({ length: NA }, (_, i) => count((i / NA) * 2 * Math.PI));
	const nmax = Math.max(...table);
	const rel = table.map((v) => v / nmax);
	const relAt = (th: number) => {
		const u = (((th / (2 * Math.PI)) % 1) + 1) % 1;
		const i = u * NA;
		const i0 = Math.floor(i) % NA;
		const i1 = (i0 + 1) % NA;
		return rel[i0] + (rel[i1] - rel[i0]) * (i - Math.floor(i));
	};

	for (const fig of document.querySelectorAll<HTMLElement>('[data-zg-band]')) {
		const SUN = JSON.parse(fig.dataset.sun!) as { x: number; y: number };
		const ST = JSON.parse(fig.dataset.strip!) as { x0: number; x1: number; y0: number; y1: number };
		const ray = fig.querySelector<SVGPathElement>('[data-ray]')!;
		const glow = fig.querySelector<SVGCircleElement>('[data-glow]')!;
		const wst = [...fig.querySelectorAll<SVGCircleElement>('[data-w]')];
		const sg = fig.querySelector<SVGGElement>('[data-strip-g]')!;
		const cursor = fig.querySelector<SVGRectElement>('[data-cursor]')!;
		const NCOL = 120;
		const cols = Array.from({ length: NCOL }, (_, i) => {
			const r = document.createElementNS(NS, 'rect');
			const w = (ST.x1 - ST.x0) / NCOL;
			r.setAttribute('class', 'zg-band-col');
			r.setAttribute('x', (ST.x0 + i * w).toFixed(2));
			r.setAttribute('y', String(ST.y0));
			r.setAttribute('width', (w + 0.3).toFixed(2));
			r.setAttribute('height', String(ST.y1 - ST.y0));
			r.setAttribute('opacity', '0');
			sg.append(r);
			return r;
		});
		const dots = [...fig.querySelectorAll<SVGCircleElement>('[data-ds]')].map((c) => ({ c, x: +c.getAttribute('cx')!, y: +c.getAttribute('cy')!, hit: false }));
		const PER = 12;
		let t = 0;
		const draw = () => {
			const u = (t % (PER + 2)) / PER; // a turn in 12 s, then the full strip stays 2 s
			// the line slows down while it lies along the disk (θ = 0 and π), 6,7 times, so the lit stars can be seen
			const uu = Math.min(1, u);
			const th = 2 * Math.PI * uu - 0.425 * Math.sin(4 * Math.PI * uu);
			// the line: from the Sun in direction θ (0 = toward the center, i.e. to the left; π/2 = up)
			const L = 200;
			const ex = SUN.x - L * Math.cos(th);
			const ey = SUN.y - L * Math.sin(th);
			ray.setAttribute('d', `M${SUN.x} ${SUN.y} L${ex.toFixed(1)} ${ey.toFixed(1)}`);
			// the stars of the drawing that the line passes light up
			const ux = -Math.cos(th);
			const uy = -Math.sin(th);
			for (const d of dots) {
				const px = d.x - SUN.x;
				const py = d.y - SUN.y;
				const along = px * ux + py * uy;
				const hit = along > 0 && along < L && Math.abs(px * uy - py * ux) < 2;
				if (hit !== d.hit) {
					d.hit = hit;
					d.c.classList.toggle('zg-band-hit', hit);
				}
			}
			const v = relAt(th);
			const n = Math.round(4 + 220 * Math.sqrt(v));
			wst.forEach((c, i) => c.setAttribute('opacity', i < n ? '0.9' : '0'));
			glow.setAttribute('opacity', (0.6 * Math.sqrt(v)).toFixed(2));
			const done = Math.min(NCOL, Math.floor((th / (2 * Math.PI)) * NCOL + 0.5));
			cols.forEach((c, i) => c.setAttribute('opacity', i < done ? (0.92 * Math.sqrt(rel[Math.floor((i / NCOL) * NA)])).toFixed(2) : '0'));
			cursor.setAttribute('x', (ST.x0 + (th / (2 * Math.PI)) * (ST.x1 - ST.x0) - 0.8).toFixed(1));
			cursor.setAttribute('opacity', u < 1 ? '1' : '0');
		};
		draw();
		loop(fig, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
