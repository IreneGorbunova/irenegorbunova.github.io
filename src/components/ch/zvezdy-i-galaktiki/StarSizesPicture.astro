---
/**
 * Sizes of stars: four frames, each TO SCALE inside itself, each next one much wider; the previous frame is shown in
 * the next as a small dashed square. The frames change by themselves every 4 с; a button shows a frame and stops that.
 *   1) 32 000 км wide (0,0106 px per км): the Earth, diameter 12 742 км (135 px), and Sirius B, the faint companion of
 *      Sirius, 11 700 км (0,0084 R☉; 124 px);
 *   2) 2,2 млн км: the Sun, 1,392 млн км (215 px), the Earth a dot of 2 px (109 times smaller);
 *   3) 170 млн км: the Sun (2,8 px), Sirius A (1,71 R☉), Vega (2,5 R☉; it is a fast spinner, 2,4–2,8 R☉) and Rigel
 *      (79 R☉ = 110 млн км, 220 px);
 *   4) 1,6 млрд км: Betelgeuse, 750 R☉ = 3,5 а. е. in radius (222 px across), with the Sun a dot at its center and the
 *      orbits of the Earth (1 а. е.) and Mars (1,52 а. е.) inside it. The radius of Betelgeuse is known poorly
 *      (640–1000 R☉ in different measurements, and it pulsates); 750 R☉ is used.
 * Colors: black bodies at the surface temperatures (blackbody.ts), as in StarColorLab: the Sun 5800 К, Sirius A 9900,
 * Sirius B 25 000, Vega 9600, Rigel 12 000, Betelgeuse 3600 К. Dots smaller than 1,5 px are drawn 1,5 px.
 */
import ZgStyles from './ZgStyles.astro';
import { bbColor } from './blackbody';

const RS = 696000; // km
const AU = 1.496e8;
const W = 340; // drawing width, px
const c = { sun: bbColor(5800), sa: bbColor(9900), sb: bbColor(25000), vega: bbColor(9600), rigel: bbColor(12000), bet: bbColor(3600) };
const f1 = (v: number) => v.toFixed(1);
const dot = (d: number) => Math.max(0.75, d / 2);
// frame scales, px per km
const k = [W / 32000, W / 2.2e6, W / 170e6, W / 1.6e9];
const Y = 118;
const frames = [
	{
		title: 'Земля и Сириус B',
		bar: { km: 10000, label: '10 000 км' },
		bodies: [
			{ x: 95, r: (12742 * k[0]) / 2, cls: 'zg-sz-earth', name: 'Земля', note: 'в 109 раз меньше Солнца' },
			{ x: 262, r: (11700 * k[0]) / 2, fill: c.sb, name: 'Сириус B', note: 'в 119 раз меньше Солнца' },
		],
		prev: null as null | { x: number; s: number },
	},
	{
		title: 'Солнце',
		bar: { km: 1e6, label: '1 млн км' },
		bodies: [
			{ x: 160, r: (2 * RS * k[1]) / 2, fill: c.sun, name: 'Солнце', note: 'диаметр 1,4 млн км' },
			{ x: 318, r: dot(12742 * k[1]), cls: 'zg-sz-earth', name: 'Земля', note: '' },
		],
		prev: { x: 318, s: 32000 * k[1] },
	},
	{
		title: 'Сириус, Вега и Ригель',
		bar: { km: 50e6, label: '50 млн км' },
		bodies: [
			{ x: 30, r: dot(2 * RS * k[2]), fill: c.sun, name: 'Солнце', note: '' },
			{ x: 74, r: dot(2 * 1.71 * RS * k[2]), fill: c.sa, name: 'Сириус', note: 'в 1,7 раза больше Солнца', pos: 'above' },
			{ x: 112, r: dot(2 * 2.5 * RS * k[2]), fill: c.vega, name: 'Вега', note: 'в 2,5 раза' },
			{ x: 250, r: (2 * 79 * RS * k[2]) / 2, fill: c.rigel, name: 'Ригель', note: 'в 79 раз больше Солнца' },
		],
		prev: { x: 30, s: 2.2e6 * k[2] },
	},
	{
		title: 'Бетельгейзе',
		bar: { km: 500e6, label: '500 млн км' },
		bodies: [{ x: 180, r: (2 * 750 * RS * k[3]) / 2, fill: c.bet, name: 'Бетельгейзе', note: 'в 750 раз больше Солнца' }],
		prev: { x: 180, s: 170e6 * k[3] },
		orbits: [
			{ r: AU * k[3], name: 'орбита Земли' },
			{ r: 1.524 * AU * k[3], name: 'орбита Марса' },
		],
		sun: { x: 180, r: 0.75, fill: c.sun },
	},
];
---

<ZgStyles />
<figure class="zg not-content" data-zg-sizes>
	<svg class="zg__svg" viewBox="0 0 360 250" role="img" aria-label="Размеры звёзд в четырёх кадрах, каждый в своём масштабе: Земля и Сириус B почти одного размера; Солнце в 109 раз больше Земли; Ригель в 79 раз больше Солнца; Бетельгейзе так велика, что внутри неё поместились бы орбиты Земли и Марса">
		<rect class="zg-space" x="0" y="0" width="360" height="250" rx="8"></rect>
		{
			frames.map((f, i) => (
				<g data-frame={i} opacity={i === 0 ? 1 : 0}>
					<text class="zg-title" x="12" y="20">
						{`${i + 1}. ${f.title}`}
					</text>
					{f.orbits?.map((o) => <circle class="zg-sz-orbit" cx={f.bodies[0].x} cy={Y} r={f1(o.r)} />)}
					{f.bodies.map((b) =>
						b.cls ? <circle class={b.cls} cx={f1(b.x)} cy={Y} r={f1(b.r)} /> : <circle cx={f1(b.x)} cy={Y} r={f1(b.r)} fill={b.fill} />,
					)}
					{f.orbits?.map((o) => <circle class="zg-sz-orbit zg-sz-orbit--front" cx={f.bodies[0].x} cy={Y} r={f1(o.r)} />)}
					{f.sun && <circle cx={f.sun.x} cy={Y} r={f.sun.r} fill={f.sun.fill} />}
					{f.prev && <rect class="zg-sz-prev" x={f1(f.prev.x - f.prev.s / 2)} y={f1(Y - f.prev.s / 2)} width={f1(f.prev.s)} height={f1(f.prev.s)} />}
					{
						f.bodies.map((b, j) => {
							// a large body is labeled inside, a small one below (or above) with a leader
							const inside = b.r > 90;
							const above = (b as { pos?: string }).pos === 'above';
							const ly = inside ? Y + b.r * 0.5 : above ? Y - 40 : Y + Math.max(b.r + 16, 30);
							const anchor = inside ? 'middle' : b.x < 40 ? 'start' : b.x > 300 ? 'end' : 'middle';
							const cls = inside ? 'zg-sz-on' : '';
							return (
								<g>
									{!inside && <path class="zg-lead" d={above ? `M${f1(b.x)} ${f1(Y - b.r - 2)} V${ly + 16}` : `M${f1(b.x)} ${f1(Y + b.r + 2)} V${ly - 11}`} />}
									<text class={cls} x={f1(b.x)} y={ly} text-anchor={anchor}>
										{b.name}
									</text>
									{b.note && (
										<text class={`zg-small ${cls}`} x={f1(b.x)} y={ly + 12} text-anchor={anchor}>
											{b.note}
										</text>
									)}
								</g>
							);
						})
					}
					{f.orbits && (
						<g>
							<text class="zg-small zg-sz-on" x={f1(180 + f.orbits[0].r * 0.71 + 3)} y={f1(Y + f.orbits[0].r * 0.71 + 9)}>
								{f.orbits[0].name}
							</text>
							<text class="zg-small zg-sz-on" x={f1(180 + f.orbits[1].r * 0.71 + 3)} y={f1(Y - f.orbits[1].r * 0.71 - 3)}>
								{f.orbits[1].name}
							</text>
						</g>
					)}
					<path class="zg-sz-bar" d={`M12 238 h${f1(f.bar.km * k[i])} M12 234 v8 M${f1(12 + f.bar.km * k[i])} 234 v8`} />
					<text class="zg-small" x={f1(18 + f.bar.km * k[i])} y="241">
						{f.bar.label}
					</text>
					{f.prev && (
						<text class="zg-small" x="348" y="241" text-anchor="end">
							пунктир — кадр {i}
						</text>
					)}
				</g>
			))
		}
	</svg>
	<div class="zg__btns">
		{
			frames.map((f, i) => (
				<button type="button" class="zg__btn" data-go={i} aria-pressed={i === 0 ? 'true' : 'false'}>
					{`${i + 1}. ${f.title}`}
				</button>
			))
		}
	</div>
	<p class="zg__foot">Каждый кадр — в своём масштабе, следующий охватывает гораздо больше. Звёзды, которые меньше точки, нарисованы точками.</p>
</figure>

<style is:global>
	.zg-sz-earth {
		fill: hsl(205, 70%, 55%);
	}
	.zg-sz-orbit {
		fill: none;
		stroke: hsl(205, 60%, 75%);
		stroke-width: 1;
		stroke-dasharray: 3 2;
		opacity: 0.35;
	}
	.zg-sz-orbit--front {
		opacity: 0.85;
		stroke: hsl(220, 50%, 20%);
	}
	.zg .zg-sz-on {
		fill: hsl(220, 50%, 15%);
		font-weight: 600;
	}
	.zg-sz-prev {
		fill: none;
		stroke: var(--zg-ink);
		stroke-width: 0.8;
		stroke-dasharray: 2 1.5;
	}
	.zg-sz-bar {
		fill: none;
		stroke: var(--zg-ink2);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from '@components/ch/g7/kit';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-zg-sizes]')) {
		const fr = [...fig.querySelectorAll<SVGGElement>('[data-frame]')];
		const btns = [...fig.querySelectorAll<HTMLButtonElement>('[data-go]')];
		let cur = 0;
		let t = 0;
		let auto = true;
		const show = (i: number) => {
			cur = i;
			t = 0;
			btns.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
		};
		btns.forEach((b, j) =>
			b.addEventListener('click', () => {
				auto = false;
				show(j);
				wake();
			}),
		);
		const wake = loop(fig, (dt) => {
			t += dt;
			if (auto && t > 4) show((cur + 1) % fr.length);
			const a = Math.min(1, t / 0.6);
			fr.forEach((g, j) => g.setAttribute('opacity', j === cur ? a.toFixed(2) : '0'));
			return auto || a < 1;
		});
	}
</script>
