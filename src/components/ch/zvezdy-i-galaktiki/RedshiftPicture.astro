---
/**
 * Red shift, two parts.
 * (1) Light travels from a distant galaxy (left) to the Earth (right) while space expands: the marks of space move apart,
 *   the galaxy recedes, and every wave crest is carried along, so the light arrives stretched. The scale of space
 *   grows as a(t) = 1 + g·t; a crest moves through space at the speed of light, dχ/dt = c / (a·D₀). Then the wavelength
 *   of light that was sent when the scale was a(tₑ) is λ = λₑ·a(t)/a(tₑ): along the train the newest light (by the
 *   galaxy) is the bluest, the oldest (at the front) the reddest, and the light reaches the Earth when the scale has
 *   grown 1,4 times, so 470 нм (blue) arrives as 658 нм (red). A loop of 8 с (6,5 с of travel); the factor 1,4 is the
 *   red shift z = 0,4, light that has been on its way about 4,3 млрд лет (only the idea is drawn: the speeds and
 *   times are not to scale).
 *   Colors of the wavelengths: the usual piecewise map of 380–780 нм to sRGB.
 * (2) Three spectra with the same dark lines of hydrogen (Hα 656,3, Hβ 486,1, Hγ 434,0, Hδ 410,2 нм): in the laboratory,
 *   in a near galaxy and in a far one, the lines moved to the red by the factors 1; 1,05; 1,20. Exaggerated: real
 *   near galaxies have factors of 1,001–1,01 (said in the caption). The strips cover 380–800 нм.
 */
import ZgStyles from './ZgStyles.astro';

const SP = { x0: 92, x1: 350, l0: 380, l1: 800 };
const X = (l: number) => SP.x0 + ((l - SP.l0) / (SP.l1 - SP.l0)) * (SP.x1 - SP.x0);
const H = [656.3, 486.1, 434.0, 410.2];
const rows = [
	{ lines: ['в лаборатории'], k: 1, y: 196 },
	{ lines: ['близкая', 'галактика'], k: 1.05, y: 232 },
	{ lines: ['далёкая', 'галактика'], k: 1.2, y: 268 },
];
// a wavelength → sRGB (piecewise linear; dim near the ends of the visible range)
const wl = (l: number) => {
	let r = 0;
	let g = 0;
	let b = 0;
	if (l < 440) [r, g, b] = [-(l - 440) / 60, 0, 1];
	else if (l < 490) [r, g, b] = [0, (l - 440) / 50, 1];
	else if (l < 510) [r, g, b] = [0, 1, -(l - 510) / 20];
	else if (l < 580) [r, g, b] = [(l - 510) / 70, 1, 0];
	else if (l < 645) [r, g, b] = [1, -(l - 645) / 65, 0];
	else [r, g, b] = [1, 0, 0];
	const f = l < 420 ? 0.3 + (0.7 * (l - 380)) / 40 : l > 700 ? Math.max(0.15, 0.3 + (0.7 * (780 - l)) / 80) : 1;
	const c = (v: number) => Math.round(255 * Math.pow(Math.max(0, v) * f, 0.8));
	return `rgb(${c(r)} ${c(g)} ${c(b)})`;
};
const stops = Array.from({ length: 22 }, (_, i) => {
	const l = SP.l0 + (i * (SP.l1 - SP.l0)) / 21;
	return { o: (i / 21).toFixed(3), c: wl(l) };
});
const f1 = (v: number) => v.toFixed(1);
---

<ZgStyles />
<figure class="zg not-content" data-zg-red>
	<svg class="zg__svg" viewBox="0 0 360 290" role="img" aria-label="Свет идёт от далёкой галактики к Земле, а пространство тем временем растягивается: метки расходятся, волна растягивается и приходит красной. Ниже три спектра с одинаковым набором тёмных линий: в лаборатории, у близкой галактики линии чуть сдвинуты к красному концу, у далёкой — сильнее">
		<defs>
			<linearGradient id="zg-red-sp" x1={SP.x0} x2={SP.x1} y1="0" y2="0" gradientUnits="userSpaceOnUse">
				{stops.map((s) => <stop offset={s.o} stop-color={s.c}></stop>)}
			</linearGradient>
		</defs>
		<rect class="zg-space" x="0" y="0" width="360" height="290" rx="8"></rect>
		<!-- (1) the stretching wave -->
		<path class="zg-red-axis" d="M8 104 H352"></path>
		<g data-marks></g>
		<g data-galaxy>
			<ellipse class="zg-red-gal" cx="0" cy="62" rx="15" ry="6"></ellipse>
			<ellipse class="zg-red-galcore" cx="0" cy="62" rx="5" ry="2.6"></ellipse>
			<path class="zg-red-arm" d="M-13 60 Q-4 55 6 59 M13 64 Q4 69 -6 65"></path>
		</g>
		<text class="zg-small" data-galtext x="0" y="44" text-anchor="middle">галактика</text>
		<g transform="translate(336 62)">
			<circle class="zg-red-earth" r="9"></circle>
			<path class="zg-red-land" d="M-5 -4 q3 -2 5 0 q1 3 -2 5 q-3 0 -3 -5 Z M2 3 q3 -1 4 1 q-1 3 -4 2 Z"></path>
		</g>
		<text class="zg-small" x="336" y="44" text-anchor="middle">Земля</text>
		<g data-wavecol></g>
		<text class="zg-small" x="8" y="120">метки пространства расходятся, свет растягивается</text>
		<!-- (2) three spectra -->
		<text class="zg-small" x={X(380)} y="162">380 нм</text>
		<text class="zg-small" x={X(800)} y="162" text-anchor="end">800 нм</text>
		<text class="zg-small" x={(X(380) + X(800)) / 2} y="162" text-anchor="middle">← фиолетовый · красный →</text>
		{
			rows.map((r) => (
				<g>
					<text x="8" y={r.lines.length > 1 ? r.y - 2 : r.y + 4}>
						{r.lines[0]}
					</text>
					{r.lines[1] && (
						<text x="8" y={r.y + 10}>
							{r.lines[1]}
						</text>
					)}
					<rect x={SP.x0} y={r.y - 12} width={SP.x1 - SP.x0} height="22" fill="url(#zg-red-sp)" rx="2"></rect>
					{H.map((l) => (
						<rect class="zg-red-line" x={f1(X(l * r.k) - 1.2)} y={r.y - 12} width="2.4" height="22"></rect>
					))}
				</g>
			))
		}
		{H.map((l) => <path class="zg-red-link" d={`M${f1(X(l))} ${rows[0].y + 11} L${f1(X(l * rows[1].k))} ${rows[1].y - 13} M${f1(X(l * rows[1].k))} ${rows[1].y + 11} L${f1(X(l * rows[2].k))} ${rows[2].y - 13}`}></path>)}
	</svg>
	<p class="zg__foot">Вверху — только сама идея, скорости не в масштабе. Внизу сдвиг линий преувеличен: у близких галактик он в десятки раз меньше.</p>
</figure>

<style is:global>
	.zg-red-axis {
		stroke: var(--zg-ink2);
		stroke-width: 0.6;
		opacity: 0.5;
	}
	.zg-red-mark {
		stroke: var(--zg-ink2);
		stroke-width: 1.2;
	}
	.zg-red-gal {
		fill: hsl(220, 40%, 75%);
		opacity: 0.55;
	}
	.zg-red-galcore {
		fill: hsl(45, 80%, 85%);
	}
	.zg-red-arm {
		fill: none;
		stroke: hsl(220, 50%, 85%);
		stroke-width: 1;
		opacity: 0.8;
	}
	.zg-red-earth {
		fill: hsl(205, 70%, 50%);
	}
	.zg-red-land {
		fill: hsl(110, 45%, 45%);
	}
	.zg-red-seg {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
	}
	.zg-red-line {
		fill: hsl(230, 40%, 6%);
	}
	.zg-red-link {
		fill: none;
		stroke: var(--zg-ink2);
		stroke-width: 0.6;
		stroke-dasharray: 2 2;
	}
</style>

<script>
	import { loop, NS } from '@components/ch/g7/kit';

	const XE = 327; // where the light reaches the Earth (its left edge)
	const D0 = 210; // px, galaxy to Earth at the start
	const T = 6.5; // s of travel
	const Z1 = 1.4; // the scale grows 1,4 times while the light travels
	const g = (Z1 - 1) / T;
	const cOverD = g / Math.log(Z1); // c / D₀ in comoving units per second
	const LE = 470; // нм, sent
	const LPX = 13; // px, the wavelength when sent
	const dte = LPX / (cOverD * D0); // s between crests
	const Y = 62;
	const A = 7;
	const wl = (l: number) => {
		let r = 0;
		let gg = 0;
		let b = 0;
		if (l < 440) [r, gg, b] = [-(l - 440) / 60, 0, 1];
		else if (l < 490) [r, gg, b] = [0, (l - 440) / 50, 1];
		else if (l < 510) [r, gg, b] = [0, 1, -(l - 510) / 20];
		else if (l < 580) [r, gg, b] = [(l - 510) / 70, 1, 0];
		else if (l < 645) [r, gg, b] = [1, -(l - 645) / 65, 0];
		else [r, gg, b] = [1, 0, 0];
		const c = (v: number) => Math.round(255 * Math.pow(Math.max(0, v), 0.8));
		return `rgb(${c(r)} ${c(gg)} ${c(b)})`;
	};

	for (const fig of document.querySelectorAll<HTMLElement>('[data-zg-red]')) {
		const marksG = fig.querySelector<SVGGElement>('[data-marks]')!;
		const gal = fig.querySelector<SVGGElement>('[data-galaxy]')!;
		const galText = fig.querySelector<SVGTextElement>('[data-galtext]')!;
		const segG = fig.querySelector<SVGGElement>('[data-wavecol]')!;
		const marks = Array.from({ length: 9 }, () => {
			const l = document.createElementNS(NS, 'line');
			l.setAttribute('class', 'zg-red-mark');
			marksG.append(l);
			return l;
		});
		const NSEG = 70;
		const segs = Array.from({ length: NSEG }, () => {
			const p = document.createElementNS(NS, 'path');
			p.setAttribute('class', 'zg-red-seg');
			segG.append(p);
			return p;
		});
		let t = 0;
		const draw = () => {
			const tt = Math.min(T, t % 8);
			const a = 1 + g * tt;
			const xOf = (chi: number) => XE - a * (1 - chi) * D0; // χ = 0 the galaxy, 1 the Earth
			const xg = xOf(0);
			gal.setAttribute('transform', `translate(${xg.toFixed(1)} 0)`);
			galText.setAttribute('x', Math.max(26, xg).toFixed(1));
			marks.forEach((m, i) => {
				const x = xOf(i / 8);
				m.setAttribute('x1', x.toFixed(1));
				m.setAttribute('x2', x.toFixed(1));
				m.setAttribute('y1', '100');
				m.setAttribute('y2', '108');
			});
			// the front of the light sent at t = 0
			const chiF = Math.min(1, Math.log(a) / (g / cOverD));
			// the wave between the galaxy and the front: the crest at χ was sent when the scale was a·exp(−χ·g/(c/D₀))
			const k = g / cOverD; // = ln 1,4
			segs.forEach((p, i) => {
				const c0 = (i / NSEG) * chiF;
				const c1 = ((i + 1) / NSEG) * chiF;
				let d = '';
				for (let j = 0; j <= 4; j++) {
					const chi = c0 + ((c1 - c0) * j) / 4;
					const ae = a * Math.exp(-chi * k);
					const te = (ae - 1) / g;
					const y = Y + A * Math.sin((2 * Math.PI * te) / dte);
					d += `${j ? 'L' : 'M'}${xOf(chi).toFixed(1)} ${y.toFixed(1)} `;
				}
				p.setAttribute('d', d);
				const lam = LE * Math.exp(((c0 + c1) / 2) * k);
				p.style.stroke = wl(lam);
				p.setAttribute('opacity', chiF > 0 ? '1' : '0');
			});
		};
		draw();
		loop(fig, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
