---
/**
 * Live check of the lens formula: drag the object, the two pairs of similar triangles change,
 * but the ratios stay equal and 1/d + 1/f stays equal to 1/F. Converging lens, F = 10 cm,
 * real image only. Equal scales, 10 px per centimetre.
 */
import LzStyles from './LzStyles.astro';
import { makeView, X, Y } from './optics';

const V = makeView(-36, 40, -11.5, 9.5, 10);
const y0 = Y(V, 0);
const F = 10;
---

<LzStyles />
<figure class="lz lzp not-content" data-lens-proof>
	<svg class="lz__svg" viewBox={`0 0 ${V.w} ${V.h}`} role="group" aria-label="Две пары подобных треугольников при построении изображения">
		<line class="lz-axis" x1="0" y1={y0} x2={V.w} y2={y0}></line>
		<line class="lz-plane" x1={X(V, 0)} y1="0" x2={X(V, 0)} y2={V.h}></line>
		<path class="lz-lens" data-lens></path>
		<g class="lzp__tri lzp__tri--center" data-tri="center">
			<polygon></polygon>
			<polygon></polygon>
		</g>
		<g class="lzp__tri lzp__tri--focus" data-tri="focus">
			<polygon></polygon>
			<polygon></polygon>
		</g>
		<g class="lz-ray lz-ray--1" data-ray="1"><path class="lz-base"></path><path class="lz-flow"></path></g>
		<g class="lz-ray lz-ray--2" data-ray="2"><path class="lz-base"></path><path class="lz-flow"></path></g>
		<g class="lz-arrow lz-arrow--image is-real" data-image><line></line><polygon></polygon></g>
		{
			[-1, 1].map((k) => (
				<g>
					<circle class="lz-focus" cx={X(V, k * F)} cy={y0} r="4.5" />
				</g>
			))
		}
		<g class="lzp__labels">
			<text class="lz-t lz-t--math" data-l="A" text-anchor="end">A</text>
			<text class="lz-t lz-t--math" data-l="B" text-anchor="end">B</text>
			<text class="lz-t lz-t--math" x={X(V, 0) - 7} y={y0 + 20} text-anchor="end">O</text>
			<text class="lz-t lz-t--math" data-l="C">C</text>
			<text class="lz-t lz-t--math" x={X(V, F)} y={y0 - 10} text-anchor="middle">F</text>
			<text class="lz-t lz-t--math" data-l="A1">A<tspan class="lzf__sub" dy="5">1</tspan></text>
			<text class="lz-t lz-t--math" data-l="B1">B<tspan class="lzf__sub" dy="5">1</tspan></text>
		</g>
		<g class="lz-arrow lz-arrow--object lzp__object" data-object tabindex="0" role="slider" aria-valuemin="14" aria-valuemax="34" aria-label="Предмет. Стрелки влево и вправо — двигать">
			<line></line>
			<polygon></polygon>
			<line class="lzp__grab" data-grab></line>
		</g>
	</svg>

	<div class="lz-controls">
		<div class="lz-seg lzp__seg" role="group" aria-label="Какие треугольники показать">
			<button type="button" aria-pressed="true" data-pair="center">Треугольники у центра <i>O</i></button>
			<button type="button" aria-pressed="false" data-pair="focus">У фокуса <i>F</i></button>
		</div>
		<label class="lz-slider lzp__slider">
			<span>Расстояние от предмета до линзы <i>d</i></span>
			<output data-d-out>30 см</output>
			<input type="range" min="14" max="34" step="0.1" value="30" data-d />
		</label>
	</div>

	<div class="lzp__math">
		<div class="lzp__line" data-line="center"><span class="lzp__tag">через <i>O</i></span><div data-tex="center"></div></div>
		<div class="lzp__line" data-line="focus"><span class="lzp__tag">через <i>F</i></span><div data-tex="focus"></div></div>
		<div class="lzp__line lzp__line--sum"><span class="lzp__tag">итог</span><div data-tex="sum"></div></div>
	</div>
	<figcaption class="lz-legend">
		Собирающая линза, <i>F</i> = 10 см, то есть <i>D</i> = 10 дптр. Тяните стрелку <i>AB</i>: треугольники меняются, а
		отношения остаются равными.
	</figcaption>
</figure>

<style is:global>
	.lzp__tri polygon {
		stroke-width: 1.5;
		stroke-linejoin: round;
		transition:
			fill-opacity 0.4s,
			stroke-opacity 0.4s;
	}
	.lzp__tri--center polygon {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
		stroke: var(--ig-vx);
	}
	.lzp__tri--focus polygon {
		fill: color-mix(in srgb, var(--ig-v) 32%, transparent);
		stroke: var(--ig-v);
	}
	.lzp__tri.is-off polygon {
		fill-opacity: 0;
		stroke-opacity: 0;
	}
	.lzp__object {
		cursor: grab;
		outline: none;
	}
	.lzp__object:focus-visible line:first-child {
		stroke: var(--sl-color-accent);
	}
	.lzp__grab {
		stroke: transparent !important;
		stroke-width: 34 !important;
		touch-action: none;
	}
	.lzp__seg {
		align-self: end;
		justify-self: start;
	}
	.lzp__math {
		display: grid;
		gap: 0.35rem;
		margin-top: 0.9rem;
	}
	.lzp__line {
		display: grid;
		grid-template-columns: 5.2rem 1fr;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		border: 1.5px solid transparent;
		transition: border-color 0.3s;
		min-width: 0;
	}
	.lzp__line > div {
		min-width: 0;
		overflow-x: auto;
		color: var(--sl-color-white);
	}
	.lzp__line .katex-display {
		margin: 0.4rem 0;
		text-align: left;
	}
	.lzp__line .katex-display > .katex {
		text-align: left;
	}
	.lzp__line[data-line='center'].is-on {
		border-color: var(--ig-vx);
	}
	.lzp__line[data-line='focus'].is-on {
		border-color: var(--ig-v);
	}
	.lzp__line--sum {
		border-color: var(--sl-color-accent);
	}
	.lzp__tag {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.lzp__line {
			grid-template-columns: 1fr;
			gap: 0;
			padding-top: 0.35rem;
		}
		.lzp__grab {
			stroke-width: 60 !important;
		}
	}
</style>

<script>
	import katex from 'katex';
	import { makeView, X, Y, pathD, lensImage, exitPoint, lensOutline, closedPath, fmt, fmtSmart, type P } from './optics';

	const V = makeView(-36, 40, -11.5, 9.5, 10);
	const F = 10;
	const H_IMG_MAX = 10.5;
	const tex = (x: number, digits: number) => fmt(x, digits).replace('−', '-').replace(',', '{,}');

	for (const root of document.querySelectorAll<HTMLElement>('[data-lens-proof]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('svg');
		const triC = q<SVGGElement>('[data-tri="center"]');
		const triF = q<SVGGElement>('[data-tri="focus"]');
		const ray1 = Array.from(q('[data-ray="1"]').querySelectorAll('path'));
		const ray2 = Array.from(q('[data-ray="2"]').querySelectorAll('path'));
		const imageG = q<SVGGElement>('[data-image]');
		const objectG = q<SVGGElement>('[data-object]');
		const grab = q<SVGLineElement>('[data-grab]');
		const dIn = q<HTMLInputElement>('[data-d]');
		const dOut = q<HTMLOutputElement>('[data-d-out]');
		const pairBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pair]'));
		const lines = {
			center: q<HTMLElement>('[data-line="center"]'),
			focus: q<HTMLElement>('[data-line="focus"]'),
		};
		const out = {
			center: q<HTMLElement>('[data-tex="center"]'),
			focus: q<HTMLElement>('[data-tex="focus"]'),
			sum: q<HTMLElement>('[data-tex="sum"]'),
		};
		const L = (k: string) => q<SVGTextElement>(`[data-l="${k}"]`);
		q<SVGPathElement>('[data-lens]').setAttribute('d', closedPath(V, lensOutline(9, F, { maxSag: 1.1, edge: 0.35 })));

		const st = { d: 30, h: 5, pair: 'center' as 'center' | 'focus' };
		const cache: Record<string, string> = {};

		const setArrow = (g: SVGGElement, x: number, y: number) => {
			const [line, head] = [g.querySelector('line')!, g.querySelector('polygon')!];
			const px = X(V, x);
			const p0 = Y(V, 0);
			const p1 = Y(V, y);
			const dir = p1 < p0 ? 1 : -1;
			const hl = Math.min(13, Math.abs(p1 - p0) * 0.45);
			const hw = hl * 0.55;
			line.setAttribute('x1', String(px));
			line.setAttribute('y1', String(p0));
			line.setAttribute('x2', String(px));
			line.setAttribute('y2', String(p1 + dir * hl * 0.7));
			head.setAttribute('points', `${px},${p1} ${px - hw},${p1 + dir * hl} ${px + hw},${p1 + dir * hl}`);
		};
		const poly = (el: SVGPolygonElement, pts: P[]) =>
			el.setAttribute('points', pts.map(([x, y]) => `${X(V, x)},${Y(V, y)}`).join(' '));
		const put = (el: SVGTextElement, x: number, y: number) => {
			el.setAttribute('x', String(x));
			el.setAttribute('y', String(y));
		};
		const katexTo = (key: string, el: HTMLElement, s: string) => {
			if (cache[key] === s) return;
			cache[key] = s;
			katex.render(s, el, { displayMode: true, throwOnError: false });
		};

		const render = () => {
			const { d, h } = st;
			const im = lensImage(d, F);
			const f = im.f;
			const H = im.m * h;
			const A: P = [-d, h];
			const B: P = [-d, 0];
			const O: P = [0, 0];
			const C: P = [0, h];
			const Fp: P = [F, 0];
			const A1: P = [f, H];
			const B1: P = [f, 0];

			const r1 = pathD(V, [A, C, exitPoint(V, C, [1, -h / F])]);
			const r2 = pathD(V, [A, O, exitPoint(V, O, [1, -h / d])]);
			ray1.forEach((p) => p.setAttribute('d', r1));
			ray2.forEach((p) => p.setAttribute('d', r2));
			const [c1, c2] = Array.from(triC.querySelectorAll('polygon'));
			poly(c1, [A, B, O]);
			poly(c2, [A1, B1, O]);
			const [f1, f2] = Array.from(triF.querySelectorAll('polygon'));
			poly(f1, [O, C, Fp]);
			poly(f2, [B1, A1, Fp]);
			triC.classList.toggle('is-off', st.pair !== 'center');
			triF.classList.toggle('is-off', st.pair !== 'focus');
			lines.center.classList.toggle('is-on', st.pair === 'center');
			lines.focus.classList.toggle('is-on', st.pair === 'focus');

			setArrow(objectG, -d, h);
			setArrow(imageG, f, H);
			grab.setAttribute('x1', String(X(V, -d)));
			grab.setAttribute('x2', String(X(V, -d)));
			grab.setAttribute('y1', String(Y(V, 0)));
			grab.setAttribute('y2', String(Y(V, h)));
			objectG.setAttribute('aria-valuenow', String(d));
			objectG.setAttribute('aria-valuetext', `d = ${fmtSmart(d)} см`);

			put(L('A'), X(V, -d) - 8, Y(V, h) + 5);
			put(L('B'), X(V, -d) - 8, Y(V, 0) + 20);
			put(L('C'), X(V, 0) + 7, Y(V, h) - 6);
			put(L('A1'), X(V, f) + 8, Y(V, H) + 8);
			put(L('B1'), X(V, f) + 8, Y(V, 0) - 8);

			dIn.value = String(d);
			dOut.value = `${fmtSmart(d)} см`;

			// live formulas; d is a multiple of 0.1 cm, f is rounded to 0.1 cm
			const fr = Math.round(f * 10) / 10;
			const fExact = Math.abs(fr - f) < 1e-9;
			const eq = fExact ? '=' : '\\approx';
			const ratio = tex(f / d, 2);
			const close = (x: number, step: number) => Math.abs(Math.round(x / step) * step - x) < 1e-9;
			const req = close(f / d, 0.01) ? '=' : '\\approx';
			katexTo(
				'center',
				out.center,
				`\\dfrac{H}{h} = \\dfrac{f}{d} ${eq} \\dfrac{${tex(fr, 1)}~\\text{см}}{${tex(d, 1)}~\\text{см}} ${req} ${ratio}`,
			);
			katexTo(
				'focus',
				out.focus,
				`\\dfrac{H}{h} = \\dfrac{f - F}{F} ${eq} \\dfrac{${tex(fr, 1)}~\\text{см} - 10{,}0~\\text{см}}{10{,}0~\\text{см}} ${req} ${ratio}`,
			);
			// in metres: 1/d + 1/f = 1/F = 10 dioptres; the second term is shown as 10 − first,
			// which is also a correct rounding of 1/f, so the sum on screen adds up exactly
			const a = Math.round((100 / d) * 100) / 100;
			const b = 10 - a;
			const seq = close(100 / d, 0.01) && fExact ? '=' : '\\approx';
			katexTo(
				'sum',
				out.sum,
				`\\begin{aligned} \\dfrac{1}{d} + \\dfrac{1}{f} &= \\dfrac{1}{${tex(d / 100, 3)}~\\text{м}} + \\dfrac{1}{${tex(fr / 100, 3)}~\\text{м}} \\\\ &${seq} ${tex(a, 2)} + ${tex(b, 2)} = 10~\\text{дптр} = D \\end{aligned}`,
			);
		};

		const clampH = () => {
			const f = lensImage(st.d, F).f;
			st.h = Math.min(st.h, (H_IMG_MAX * st.d) / f, 8);
		};
		const setD = (d: number) => {
			st.d = Math.round(Math.min(34, Math.max(14, d)) * 10) / 10;
			clampH();
			render();
		};

		let dragging = false;
		let off = 0;
		const toX = (e: PointerEvent) => {
			const pt = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM()!.inverse());
			return V.xmin + pt.x / V.S;
		};
		objectG.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			dragging = true;
			off = -st.d - toX(e);
			svg.setPointerCapture(e.pointerId);
			e.preventDefault();
		});
		svg.addEventListener('pointermove', (e) => {
			if (dragging) setD(-(toX(e) + off));
		});
		svg.addEventListener('pointerup', () => (dragging = false));
		svg.addEventListener('pointercancel', () => (dragging = false));
		objectG.addEventListener('keydown', (e) => {
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			e.preventDefault();
			setD(st.d + (e.key === 'ArrowLeft' ? 1 : -1) * (e.shiftKey ? 0.1 : 0.5));
		});
		dIn.addEventListener('input', () => setD(Number(dIn.value)));
		pairBtns.forEach((b) =>
			b.addEventListener('click', () => {
				st.pair = b.dataset.pair as 'center' | 'focus';
				pairBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				render();
			}),
		);
		setD(st.d);
	}
</script>
