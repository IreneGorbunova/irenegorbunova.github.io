---
/**
 * Two short looping opening scenes of «Линзы». No numbers in the pictures; the captions' popovers explain.
 * Sun: a magnifier (glass 7 cm across, F = 10 cm) over a sheet of paper in the midday sun, seen a little from above
 *   (12 px per cm; a horizontal circle is drawn as an ellipse 0,35 as tall as wide). The sun is overhead, its rays
 *   vertical. A hand lifts the magnifier from 3 cm to 10 cm above the paper: the cone of light under the glass
 *   narrows, the bright spot shrinks from 2,5 cm to the image of the Sun (about 1 mm, r = 0,047 cm) and gets brighter
 *   (the light of the whole glass falls on it), the shadow of the glass around it stays. Then the paper chars and
 *   smokes.
 * Book: a magnifier over a page of a book, seen from the reader's eye 25 cm above the glass. The glass (F = 10 cm)
 *   rises from 1 cm to 8 cm above the page: the letters seen through it grow by M = F(L + d) / (FL − dL + dF),
 *   from 1,1 to 2,5 times (the virtual image F/(F − d) times larger, seen from farther away than the page itself).
 *   Its shadow moves away from it as it rises.
 * Plays only while visible.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = `lzi-${Math.random().toString(36).slice(2, 8)}`;
// the page of the book: A. S. Pushkin, «Зимнее утро» (1829), the first two and a half stanzas
const POEM = [
	'Мороз и солнце; день чудесный!',
	'Ещё ты дремлешь, друг прелестный —',
	'Пора, красавица, проснись:',
	'Открой сомкнуты негой взоры',
	'Навстречу северной Авроры,',
	'Звездою севера явись!',
	'',
	'Вечор, ты помнишь, вьюга злилась,',
	'На мутном небе мгла носилась;',
	'Луна, как бледное пятно,',
	'Сквозь тучи мрачные желтела,',
	'И ты печальная сидела —',
	'А нынче… погляди в окно:',
	'',
	'Под голубыми небесами',
	'Великолепными коврами,',
];
const LINE = 14;
// sun scene: paper plane at screen y = 200, lens axis at x = 180, 12 px per cm
const RAYS = [-3, -1.5, 0, 1.5, 3];
const AMBIENT = [36, 72, 108, 252, 288, 324];
---

<IntroFrame data-lzintro>
	<div class="intro__card" data-scene="sun">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Солнечный день. Рука поднимает лупу над листом бумаги. Солнечный свет, прошедший сквозь лупу, собирается в пятно, которое становится всё меньше и ярче, пока не превращается в крошечную яркую точку. Бумага в этой точке темнеет и начинает дымиться">
			<rect class="lzi-sky" x="0" y="0" width="360" height="124"></rect>
			<circle class="lzi-sun" cx="180" cy="-8" r="24"></circle>
			<rect class="lzi-table" x="0" y="124" width="360" height="116"></rect>
			<line class="lzi-tableedge" x1="0" y1="124" x2="360" y2="124"></line>
			<rect class="lzi-paper" x="40" y="164" width="280" height="71" rx="1.5"></rect>
			<!-- sunlight that misses the glass -->
			{AMBIENT.map((x) => <line class="lzi-amb" x1={x} y1="0" x2={x} y2={x > 40 && x < 320 ? 200 : 180} />)}
			<!-- shadows on the paper: the glass, the handle and the hand -->
			<ellipse class="lzi-shadow" cx="180" cy="200" rx="42" ry="14.7"></ellipse>
			<line class="lzi-hshadow" x1="222" y1="201" x2="300" y2="203"></line>
			<ellipse class="lzi-shadow" cx="310" cy="204" rx="16" ry="7"></ellipse>
			<!-- the bright spot, the burnt mark and the smoke -->
			<ellipse class="lzi-char" cx="180" cy="200" rx="0" ry="0" data-char></ellipse>
			<ellipse class="lzi-glow" cx="180" cy="200" rx="20" ry="7" data-glow></ellipse>
			<ellipse class="lzi-spot" cx="180" cy="200" rx="20" ry="7" data-spot></ellipse>
			<path class="lzi-cone" d="" data-cone></path>
			<g data-rays>
				{
					RAYS.map(() => (
						<g>
							<line class="lzi-ray" />
							<line class="lzi-ray" />
						</g>
					))
				}
			</g>
			<g class="lzi-smoke" data-smoke>
				<circle r="3"></circle>
				<circle r="3"></circle>
				<circle r="3"></circle>
			</g>
			<!-- the magnifier and the hand -->
			<g data-loupe>
				<line class="lzi-handle" x1="222" y1="0" x2="300" y2="6"></line>
				<ellipse class="lzi-glass" cx="180" cy="0" rx="42" ry="14.7"></ellipse>
				<path class="lzi-shine" d="M 150 -6 Q 162 -11 176 -12"></path>
				<ellipse class="lzi-rim" cx="180" cy="0" rx="42" ry="14.7"></ellipse>
				<path class="lzi-sleeve" d="M 322 -10 H 362 V 20 H 322 Z"></path>
				<rect class="lzi-fist" x="292" y="-6" width="34" height="22" rx="9"></rect>
				<path class="lzi-thumb" d="M 296 -4 Q 290 4 298 8"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>В солнечный день лупа <More term="собирает солнечный свет в крошечное пятнышко">Лучи Солнца, пройдя сквозь стекло лупы, сходятся почти в одну точку. Свет, упавший на всё стекло, попадает на пятнышко размером около миллиметра, и бумага там сильно нагревается. Вокруг пятнышка — тень лупы: этот свет и «собран» в середину. Точку, в которой сходятся лучи, называют фокусом — подробнее в разделе <a href="#фокус-линзы">«Фокус линзы»</a>. Никогда не смотрите сквозь лупу на Солнце!</More>, и бумага начинает дымиться.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="book">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Страница книги со стихами, сверху. Над строчками медленно поднимают лупу; буквы, видные сквозь неё, становятся всё крупнее">
			<defs>
				<clipPath id={`${uid}-clip`}>
					<circle cx="120" cy="100" r="44" data-clip></circle>
				</clipPath>
				<g id={`${uid}-page`}>
					<rect class="lzi-page" x="-200" y="-200" width="760" height="640"></rect>
					<rect class="lzi-gutter" x="0" y="0" width="14" height="240"></rect>
					<g class="lzi-poem">
						{POEM.map((s, i) => s && <text x="74" y={26 + i * LINE}>{s}</text>)}
					</g>
				</g>
			</defs>
			<use href={`#${uid}-page`}></use>
			<!-- the shadow of the magnifier on the page -->
			<g data-lshadow>
				<circle class="lzi-lshadow" cx="0" cy="0" r="46"></circle>
				<line class="lzi-lshadow-h" x1="33" y1="33" x2="86" y2="86"></line>
			</g>
			<!-- the page seen through the glass, magnified about its centre -->
			<g clip-path={`url(#${uid}-clip)`}>
				<g data-mag>
					<use href={`#${uid}-page`}></use>
				</g>
				<circle class="lzi-tint" cx="120" cy="100" r="44" data-tint></circle>
			</g>
			<g data-bloupe>
				<line class="lzi-bhandle" x1="33" y1="33" x2="96" y2="96"></line>
				<path class="lzi-sleeve" d="M 112 92 L 160 140 L 140 160 L 92 112 Z"></path>
				<rect class="lzi-fist" x="-13" y="-11" width="30" height="22" rx="9" transform="translate(96 96) rotate(45)"></rect>
				<circle class="lzi-brim" cx="0" cy="0" r="45"></circle>
				<path class="lzi-bshine" d="M -30 -22 A 37 37 0 0 1 -6 -36"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Лупа над книгой увеличивает буквы. Если медленно поднимать её, буквы становятся <More term="всё крупнее">Пока книга ближе к лупе, чем её фокус, лупа даёт увеличенное прямое изображение букв — его и видно сквозь стекло. Чем ближе книга к фокусу, тем крупнее изображение. Если поднять лупу ещё выше, буквы расплывутся, а потом окажутся перевёрнутыми. Подробнее — в разделе <a href="#изображение-даваемое-линзой">«Изображение, даваемое линзой»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-lzintro] {
		--lzi-sky: color-mix(in srgb, var(--ig-vx) 16%, var(--sl-color-gray-6, #17181c));
		--lzi-table: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--lzi-paper: color-mix(in oklab, var(--sl-color-gray-2) 80%, var(--ig-v));
		--lzi-book: color-mix(in oklab, var(--ig-v) 9%, var(--sl-color-gray-5));
		--lzi-ink: var(--sl-color-gray-1);
		--lzi-skin: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-2));
		--lzi-cloth: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-4));
	}
	:root[data-theme='light'] [data-lzintro] {
		--lzi-sky: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-7, #fff));
		--lzi-table: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-4));
		--lzi-paper: var(--sl-color-gray-7, #fff);
		--lzi-book: color-mix(in oklab, var(--ig-v) 8%, var(--sl-color-gray-7, #fff));
		--lzi-ink: var(--sl-color-gray-2);
		--lzi-skin: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
		--lzi-cloth: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-4));
	}
	.lzi-sky {
		fill: var(--lzi-sky);
	}
	.lzi-sun {
		fill: var(--ig-v);
		filter: drop-shadow(0 0 10px var(--ig-v));
	}
	.lzi-table {
		fill: var(--lzi-table);
	}
	.lzi-tableedge {
		stroke: color-mix(in oklab, var(--lzi-table) 70%, var(--sl-color-black));
		stroke-width: 2;
	}
	.lzi-paper {
		fill: var(--lzi-paper);
		stroke: color-mix(in oklab, var(--lzi-paper) 75%, var(--sl-color-black));
		stroke-width: 0.8;
	}
	.lzi-amb {
		stroke: var(--ig-v);
		stroke-width: 1.4;
		opacity: 0.35;
	}
	.lzi-ray {
		stroke: var(--ig-v);
		stroke-width: 1.6;
		stroke-linecap: round;
		opacity: 0.85;
	}
	.lzi-cone {
		fill: var(--ig-v);
		opacity: 0.16;
	}
	.lzi-shadow {
		fill: var(--sl-color-black);
		opacity: 0.22;
	}
	.lzi-hshadow {
		stroke: var(--sl-color-black);
		stroke-width: 6;
		stroke-linecap: round;
		opacity: 0.18;
	}
	.lzi-spot {
		fill: #fffbe8;
	}
	.lzi-glow {
		fill: var(--ig-v);
	}
	.lzi-char {
		fill: color-mix(in oklab, var(--ig-v) 30%, #2a1a0c);
	}
	.lzi-smoke circle {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--sl-color-gray-5));
	}
	.lzi-glass {
		fill: color-mix(in srgb, var(--ig-vx) 22%, transparent);
	}
	.lzi-shine,
	.lzi-bshine {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0.55;
	}
	.lzi-rim,
	.lzi-brim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3.5;
	}
	.lzi-handle,
	.lzi-bhandle {
		stroke: color-mix(in oklab, var(--ig-vy) 50%, var(--sl-color-gray-3));
		stroke-width: 7;
		stroke-linecap: round;
	}
	.lzi-fist {
		fill: var(--lzi-skin);
		stroke: color-mix(in oklab, var(--lzi-skin) 70%, var(--sl-color-black));
		stroke-width: 1;
	}
	.lzi-thumb {
		fill: none;
		stroke: color-mix(in oklab, var(--lzi-skin) 70%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.lzi-sleeve {
		fill: var(--lzi-cloth);
	}
	.lzi-page {
		fill: var(--lzi-book);
	}
	.lzi-gutter {
		fill: var(--sl-color-black);
		opacity: 0.18;
	}
	.lzi-poem text {
		fill: var(--lzi-ink);
		font-family: 'PT Serif', Georgia, 'Times New Roman', serif !important;
		font-size: 11px;
	}
	.lzi-lshadow {
		fill: var(--sl-color-black);
		fill-opacity: 0.06;
		stroke: var(--sl-color-black);
		stroke-width: 6;
	}
	.lzi-lshadow-h {
		stroke: var(--sl-color-black);
		stroke-width: 7;
		stroke-linecap: round;
	}
	.lzi-tint {
		fill: color-mix(in srgb, var(--ig-vx) 12%, transparent);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-lzintro]')) {
		// Sun: the glass rises from 3 cm to the focus (10 cm) over 0,05 → 0,5; the paper chars from 0,6 and smokes
		// from 0,68; 7 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="sun"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 12; // px per cm
			const Q = 0.35; // a horizontal circle: height / width
			const R = 3.5; // cm, radius of the glass
			const F = 10; // cm
			const RAYS = [-3, -1.5, 0, 1.5, 3];
			const loupe = $<SVGGElement>('[data-loupe]');
			const spot = $<SVGEllipseElement>('[data-spot]');
			const glow = $<SVGEllipseElement>('[data-glow]');
			const char = $<SVGEllipseElement>('[data-char]');
			const cone = $<SVGPathElement>('[data-cone]');
			const rays = [...card.querySelectorAll<SVGGElement>('[data-rays] > g')];
			const puffs = [...card.querySelectorAll<SVGCircleElement>('[data-smoke] circle')];
			scene(card, 7, (x) => {
				const h = 3 + 7 * smooth(0.05, 0.5, x); // cm above the paper
				const yl = 200 - K * h; // screen y of the glass
				loupe.setAttribute('transform', `translate(0 ${f1(yl)})`);
				// the image of the Sun at the focus: 0,93 mm across
				const r = Math.max(R * Math.abs(1 - h / F), 0.047);
				const rx = r * K;
				spot.setAttribute('rx', f1(Math.max(rx, 0.7)));
				spot.setAttribute('ry', f1(Math.max(rx * Q, 0.5)));
				// the light of the whole glass on the spot: the smaller the spot, the brighter
				const gain = clamp(1 - r / R);
				spot.style.opacity = (0.45 + 0.55 * gain).toFixed(2);
				glow.setAttribute('rx', f1(rx + 3 + 7 * gain));
				glow.setAttribute('ry', f1((rx + 3 + 7 * gain) * Q));
				glow.style.opacity = (0.15 + 0.45 * gain ** 2).toFixed(2);
				cone.setAttribute(
					'd',
					`M ${180 - R * K} ${f1(yl)} L ${f1(180 - rx)} 200 L ${f1(180 + rx)} 200 L ${180 + R * K} ${f1(yl)} Z`,
				);
				rays.forEach((g, i) => {
					const [above, below] = g.querySelectorAll('line');
					const xs = 180 + RAYS[i] * K;
					above.setAttribute('x1', f1(xs));
					above.setAttribute('x2', f1(xs));
					above.setAttribute('y1', '0');
					above.setAttribute('y2', f1(yl));
					below.setAttribute('x1', f1(xs));
					below.setAttribute('y1', f1(yl));
					below.setAttribute('x2', f1(180 + RAYS[i] * K * (1 - h / F)));
					below.setAttribute('y2', '200');
				});
				const burn = smooth(0.6, 0.8, x);
				char.setAttribute('rx', f1(5.5 * burn));
				char.setAttribute('ry', f1(2.2 * burn));
				const smoke = smooth(0.68, 0.76, x);
				const t = performance.now() / 1000;
				puffs.forEach((c, i) => {
					const ph = (t * 0.55 + i / 3) % 1;
					c.setAttribute('cx', f1(180 + 7 * Math.sin(ph * 5 + i * 2)));
					c.setAttribute('cy', f1(196 - 64 * ph));
					c.setAttribute('r', f1(2.5 + 7 * ph));
					c.style.opacity = (smoke * 0.75 * (1 - ph)).toFixed(2);
				});
			});
		}

		// Book: the glass rises from 1 cm to 8 cm over the page (0,1 → 0,75) and moves a little along the line; the
		// letters under it grow from 1,1 to 2,5 times; 7 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="book"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const clip = $<SVGCircleElement>('[data-clip]');
			const tint = $<SVGCircleElement>('[data-tint]');
			const mag = $<SVGGElement>('[data-mag]');
			const bl = $<SVGGElement>('[data-bloupe]');
			const sh = $<SVGGElement>('[data-lshadow]');
			const F = 10; // cm
			const L = 25; // cm from the eye to the glass
			// apparent magnification: the virtual image is F/(F − d) times larger and |f| = dF/(F − d) behind the
			// glass, the page itself is L + d from the eye
			const M = (d: number) => (F * (L + d)) / (F * L - d * L + d * F);
			scene(card, 7, (x) => {
				const u = smooth(0.1, 0.75, x);
				const d = 1 + 7 * u;
				const cx = 112 + 92 * u;
				const cy = 98 + 10 * u;
				for (const c of [clip, tint]) {
					c.setAttribute('cx', f1(cx));
					c.setAttribute('cy', f1(cy));
				}
				const m = M(d);
				mag.setAttribute(
					'transform',
					`translate(${f1(cx)} ${f1(cy)}) scale(${m.toFixed(3)}) translate(${f1(-cx)} ${f1(-cy)})`,
				);
				bl.setAttribute('transform', `translate(${f1(cx)} ${f1(cy)})`);
				// light from the upper left: the shadow slides away and fades as the glass rises
				sh.setAttribute('transform', `translate(${f1(cx + 2.2 * d)} ${f1(cy + 2.8 * d)})`);
				sh.style.opacity = (0.32 - 0.025 * d).toFixed(3);
			});
		}
	}
</script>
