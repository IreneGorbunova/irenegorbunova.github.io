---
/**
 * Labelled scheme: cross-sections of the six kinds of lenses. Top row: convex lenses (thicker in the middle than at
 * the edges), bottom row: concave ones (thinner in the middle). Each surface is an arc of a circle or a straight
 * line (a flat surface). Static, rendered at build time.
 */
import LzStyles from './LzStyles.astro';

const A = 40; // half the height of a lens, px
/** Radius of an arc with chord 2A and sag s. */
const rad = (s: number) => (A * A + s * s) / (2 * s);
/** One surface from the top (y0 − A) to the bottom (y0 + A) at x = xe of its rim: sag s > 0 bulges right. */
const surf = (xe: number, y0: number, s: number, down: boolean) => {
	const [ya, yb] = down ? [y0 - A, y0 + A] : [y0 + A, y0 - A];
	if (s === 0) return `L ${xe} ${yb}`;
	const r = rad(Math.abs(s)).toFixed(1);
	// going down, sweep 1 bulges right; going up, sweep 1 bulges left
	const sweep = (s > 0) === down ? 1 : 0;
	void ya;
	return `A ${r} ${r} 0 0 ${sweep} ${xe} ${yb}`;
};
/** A lens: left rim at xl, right rim at xr, sags of the left and right surfaces (> 0 bulges right). */
const lens = (xl: number, xr: number, y0: number, sl: number, sr: number) =>
	`M ${xl} ${y0 - A} L ${xr} ${y0 - A} ${surf(xr, y0, sr, true)} L ${xl} ${y0 + A} ${surf(xl, y0, sl, false)} Z`;

const COLS = [62, 170, 278];
const rows = [
	{
		y: 82,
		title: 'Выпуклые линзы — собирающие',
		items: [
			{ d: lens(COLS[0] - 2, COLS[0] + 2, 82, -13, 13), name: 'двояковыпуклая' },
			{ d: lens(COLS[1] - 10, COLS[1] - 6, 82, 0, 22), name: 'плосковыпуклая' },
			{ d: lens(COLS[2] - 8, COLS[2] - 4, 82, 8, 22), name: 'вогнуто-выпуклая' },
		],
	},
	{
		y: 222,
		title: 'Вогнутые линзы — рассеивающие',
		items: [
			{ d: lens(COLS[0] - 13, COLS[0] + 13, 222, 10, -10), name: 'двояковогнутая' },
			{ d: lens(COLS[1] - 10, COLS[1] + 10, 222, 0, -15), name: 'плосковогнутая' },
			{ d: lens(COLS[2] - 4, COLS[2] + 16, 222, -8, -22), name: 'выпукло-вогнутая' },
		],
	},
];
---

<LzStyles />
<figure class="lz lzd not-content">
	<svg class="lzd__svg lzd__svg--kinds" viewBox="0 0 340 292" role="img" aria-label="Шесть видов линз в разрезе. Выпуклые, собирающие: двояковыпуклая, плосковыпуклая, вогнуто-выпуклая — в середине толще, чем у краёв. Вогнутые, рассеивающие: двояковогнутая, плосковогнутая, выпукло-вогнутая — в середине тоньше, чем у краёв">
		{
			rows.map((row) => (
				<g>
					<text class="lzd-t lzd-t--head" x="170" y={row.y - 56} text-anchor="middle">
						{row.title}
					</text>
					{row.items.map((it, i) => (
						<g>
							<line class="lzd-mid" x1={COLS[i] - 34} y1={row.y} x2={COLS[i] + 34} y2={row.y} />
							<path class="lz-lens" d={it.d} />
							<text class="lzd-t" x={COLS[i]} y={row.y + 62} text-anchor="middle">
								{it.name}
							</text>
						</g>
					))}
				</g>
			))
		}
	</svg>
	<figcaption class="lz-legend lzd__cap">
		Линзы в разрезе. Тонкая линия — ось симметрии линзы: собирающие линзы на ней толще, чем у краёв, рассеивающие —
		тоньше.
	</figcaption>
</figure>
