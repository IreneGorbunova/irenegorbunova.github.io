---
/**
 * Scheme of a Kepler refractor: objective (F1 = 24 cm) and eyepiece (F2 = 6 cm), both converging, drawn as schematic
 * lenses, 30 cm apart, so that the focus of the objective coincides with the front focus of the eyepiece.
 * Light of two distant stars comes as two parallel beams (one along the principal axis, one at the slope 0,1 to it,
 * about 5,7°). The objective gathers each beam into a point in its focal plane (on the axis and 2,4 cm below it);
 * the eyepiece makes each beam parallel again, the second one now at the slope 2,4 / 6 = 0,4 (about 21,8°), i.e.
 * F1 / F2 = 4 times the slope it came with. Behind the eyepiece the beams cross at 7,5 cm from it, where the eye's
 * pupil is. Thin-lens optics, equal scales (6,6 px per cm). Light pulses run along the rays.
 */
import LzStyles from './LzStyles.astro';
import { makeView, X, Y, pathD, lensSymbol, type P } from './optics';

const F1 = 24;
const F2 = 6;
const XE = F1 + F2; // the eyepiece
const SLOPE = 0.1; // the second star's beam goes down by 0,1 cm per cm
const HEIGHTS = [3.6, 0, -3.6]; // where the rays of each beam meet the objective
const XS = -13.5; // where the drawn rays start
const XP = XE + (F2 * (F1 + F2)) / F1; // the crossing of the beams behind the eyepiece (exit pupil): 37,5
const V = makeView(-21.6, 42.4, -8.2, 6.6, 6.6);

/** The rays of a beam with the slope −s through the objective, the eyepiece and on to the eye. */
const beam = (s: number) =>
	HEIGHTS.map((y) => {
		const focal: P = [F1, -F1 * s]; // all the rays of the beam meet here
		const atE = focal[1] + ((focal[1] - y) / F1) * F2; // the ray at the eyepiece
		const out = -focal[1] / F2; // slope after the eyepiece: along the line from the focal point through its centre
		return pathD(V, [
			[XS, y + s * -XS],
			[0, y],
			[XE, atE],
			[XP, atE + out * (XP - XE)],
		]);
	});
const beams = [beam(0), beam(SLOPE)];
const star = (x: number, y: number) => {
	const r = 5;
	const k = 1.6;
	const [cx, cy] = [X(V, x), Y(V, y)];
	return `M${cx} ${cy - r} L${cx + k} ${cy - k} L${cx + r} ${cy} L${cx + k} ${cy + k} L${cx} ${cy + r} L${cx - k} ${cy + k} L${cx - r} ${cy} L${cx - k} ${cy - k} Z`;
};
const stars = [star(-15, 0), star(-15, 15 * SLOPE)];
const lenses = [0, XE].map((x) => ({
	d: lensSymbol(makeView(V.xmin - x, V.xmax - x, V.ymin, V.ymax, V.S), 4.6, 1, 1.3, 0.8),
	x: X(V, x),
}));
const images = [0, -F1 * SLOPE].map((y) => [X(V, F1), Y(V, y)]);
const y0 = Y(V, 0);
const yd = Y(V, -6.6);
const ex = X(V, XP);
---

<LzStyles />
<figure class="lz lzd lzt not-content">
	<svg class="lzd__svg lzt__svg" viewBox={`0 0 ${V.w} ${V.h}`} role="img" aria-label="Схема телескопа из двух собирающих линз. Свет от двух далёких звёзд приходит двумя параллельными пучками под небольшим углом друг к другу. Объектив собирает каждый пучок в точку — изображение звезды — на фокусном расстоянии от себя. В фокусе окуляра пучки снова становятся параллельными, но выходят под бо́льшим углом друг к другу и попадают в глаз">
		<line class="lz-axis" x1={X(V, XS)} y1={y0} x2={V.w} y2={y0}></line>
		{
			beams.map((rays, i) => (
				<g class={`lz-ray lz-ray--${i ? 3 : 1}`}>
					{rays.map((d) => (
						<>
							<path class="lz-base" d={d} />
							<path class="lz-flow" d={d} />
						</>
					))}
				</g>
			))
		}
		{lenses.map((l) => <path class="lz-sym" d={l.d} />)}
		{images.map(([x, y]) => <circle class="lzt-img" cx={x} cy={y} r="2.8" />)}
		{stars.map((d, i) => <path class={`lzt-star lzt-star--${i + 1}`} d={d} />)}
		<text class="lzd-t" x={lenses[0].x} y={Y(V, 4.6) - 6} text-anchor="middle">объектив</text>
		<text class="lzd-t" x={lenses[1].x} y={Y(V, 4.6) - 6} text-anchor="middle">окуляр</text>
		<text class="lzd-t" x="2" y={Y(V, 0.75) + 4}>звёзды</text>
		<!-- the eye, looking to the left into the eyepiece; its pupil where the beams cross -->
		<g class="lzd-eye" transform={`translate(${ex + 5} ${y0}) scale(1.25)`}>
			<path d="M -9 0 Q 6 -14 16 -2 Q 6 12 -9 0 Z"></path>
			<circle class="lzd-eye__iris" cx="-2" cy="0" r="5"></circle>
			<circle class="lzd-eye__pupil" cx="-4" cy="0" r="2.4"></circle>
		</g>
		<text class="lzd-t" x={ex + 9} y={y0 + 24} text-anchor="middle">глаз</text>
		<g class="lzd-dim">
			<path d={`M${X(V, 0)} ${yd - 4} V${yd + 4} M${X(V, 0)} ${yd} H${X(V, F1)} M${X(V, F1)} ${yd - 4} V${yd + 4} M${X(V, F1)} ${yd} H${X(V, XE)} M${X(V, XE)} ${yd - 4} V${yd + 4}`}></path>
		</g>
		<text class="lzd-t lzd-t--math" x={X(V, F1 / 2)} y={yd + 15} text-anchor="middle">F<tspan class="lzt-sub" dy="4">1</tspan></text>
		<text class="lzd-t lzd-t--math" x={X(V, F1 + F2 / 2)} y={yd + 15} text-anchor="middle">F<tspan class="lzt-sub" dy="4">2</tspan></text>
	</svg>
	<figcaption class="lz-legend lzd__cap">
		Объектив и окуляр — собирающие линзы. Свет далёкой звезды приходит параллельным пучком. Объектив собирает его в
		точку — изображение звезды — на расстоянии <i>F</i><sub>1</sub> от себя, в фокусе окуляра. После окуляра пучок
		снова параллельный, но пучки двух звёзд идут под бо́льшим углом друг к другу: звёзды кажутся дальше друг от друга.
		Изображение перевёрнутое. Здесь <i>F</i><sub>1</sub> в 4 раза больше <i>F</i><sub>2</sub>, у настоящих телескопов
		— в десятки раз.
	</figcaption>
</figure>

<style is:global>
	.lzt__svg {
		max-width: 36rem;
	}
	.lzt-img {
		fill: var(--sl-color-accent-high);
		stroke: var(--ig-surface);
		stroke-width: 1;
	}
	.lzt-star {
		stroke: var(--ig-surface);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.lzt-star--1 {
		fill: var(--ig-v);
	}
	.lzt-star--2 {
		fill: var(--ig-vy);
	}
	.lzt-sub {
		font-size: 10px;
		font-style: normal;
		font-family: KaTeX_Main, serif;
	}
</style>
