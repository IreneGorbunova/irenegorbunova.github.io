---
/**
 * How lenses are drawn on schemes: a glass lens in cross-section (left) and its schematic symbol (right), a segment
 * with arrowheads pointing outwards (converging lens) or inwards (diverging lens). Static, rendered at build time.
 */
import LzStyles from './LzStyles.astro';
import { makeView, lensOutline, closedPath, lensSymbol } from './optics';

// pixel coordinates: the glass lens is centred at (48, 0), the symbol at (132, 0), the axis is y = 0
const glass = (F: number) => closedPath(makeView(-48, 132, -54, 54, 1), lensOutline(40, F, { edge: 3, steps: 32 }));
const symbol = (t: number) => lensSymbol(makeView(-132, 48, -54, 54, 1), 40, t, 11, 7);
const panels = [
	{
		glass: glass(80),
		symbol: symbol(1),
		title: 'Собирающая линза',
		text: 'стрелки на концах отрезка направлены наружу.',
		aria: 'Собирающая линза: слева выпуклая линза в разрезе, справа её обозначение на схеме — отрезок со стрелками на концах, направленными наружу',
	},
	{
		glass: glass(-80),
		symbol: symbol(0),
		title: 'Рассеивающая линза',
		text: 'стрелки на концах отрезка направлены внутрь.',
		aria: 'Рассеивающая линза: слева вогнутая линза в разрезе, справа её обозначение на схеме — отрезок со стрелками на концах, направленными внутрь',
	},
];
---

<LzStyles />
<figure class="lz lzd not-content">
	<div class="lzd__grid">
		{
			panels.map((p) => (
				<div class="lzd__panel">
					<svg class="lzd__svg lzd__svg--sym" viewBox="0 0 180 108" role="img" aria-label={p.aria}>
						<line class="lzd-mid" x1="6" y1="54" x2="174" y2="54" />
						<path class="lz-lens" d={p.glass} />
						<path class="lzd-to" d="M 74 54 H 104 M 98 49 L 104 54 L 98 59" />
						<path class="lz-sym" d={p.symbol} />
					</svg>
					<p class="lzd__label">
						<b>{p.title}:</b> {p.text}
					</p>
				</div>
			))
		}
	</div>
	<figcaption class="lz-legend lzd__cap">
		Слева — линза в разрезе, справа — как её рисуют на схемах. Тонкая штриховая линия — главная оптическая ось.
	</figcaption>
</figure>

<style is:global>
	.lzd__svg--sym {
		max-width: 15rem;
	}
	.lzd-to {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
