---
/**
 * Labelled scheme of the focus. Left: a converging lens; rays parallel to the principal axis meet at the focus F
 * behind it. Right: a diverging lens; the same rays spread out as if they came from the focus F in front of it (their
 * dashed backward extensions meet there): the focus is virtual. Thin lenses, F = 10 cm, equal scales (10 px per cm).
 * Light pulses run along the rays.
 */
import LzStyles from './LzStyles.astro';
import { makeView, X, Y, pathD, exitPoint, lensOutline, closedPath, type P } from './optics';

const V = makeView(-14, 20, -8.6, 6.4, 10);
const HALF = 5.2;
const HEIGHTS = [-4.4, -2.4, 2.4, 4.4];
const y0 = Y(V, 0);

const panel = (F: number) => {
	const rays = HEIGHTS.map((y) => {
		const at: P = [0, y];
		// after the lens the ray lies on the line through the focus: through (F, 0) for a converging lens, away from
		// (F, 0) (F < 0, in front of the lens) for a diverging one
		const dir: P = F > 0 ? [F, -y] : [-F, y];
		const out = exitPoint(V, at, dir);
		return {
			d: pathD(V, [[V.xmin, y], at, out]),
			virt: F < 0 ? pathD(V, [at, [F, 0]]) : '',
		};
	});
	return { rays, lens: closedPath(V, lensOutline(HALF, F, { maxSag: 1, edge: 0.3 })) };
};
const conv = panel(10);
const div = panel(-10);
const fx = (x: number) => X(V, x);
---

<LzStyles />
<figure class="lz lzd not-content">
	<div class="lzd__grid">
		<div class="lzd__panel">
			<svg class="lzd__svg" viewBox={`0 0 ${V.w} ${V.h}`} role="img" aria-label="Собирающая линза: лучи, параллельные главной оптической оси, после линзы собираются в одной точке — в фокусе F за линзой. Отрезок от оптического центра O до фокуса — фокусное расстояние F">
				<line class="lz-axis" x1="0" y1={y0} x2={V.w} y2={y0}></line>
				{
					conv.rays.map((r) => (
						<g class="lz-ray">
							<path class="lz-base" d={r.d} />
							<path class="lz-flow" d={r.d} />
						</g>
					))
				}
				<path class="lz-lens" d={conv.lens}></path>
				<circle class="lzd-o" cx={fx(0)} cy={y0} r="3"></circle>
				<circle class="lz-focus" cx={fx(10)} cy={y0} r="4.5"></circle>
				<circle class="lz-focus" cx={fx(-10)} cy={y0} r="4.5"></circle>
				<text class="lzd-t lzd-t--math" x={fx(0) - 6} y={y0 + 15} text-anchor="end">O</text>
				<text class="lzd-t lzd-t--math" x={fx(10) + 3} y={y0 - 8}>F</text>
				<text class="lzd-t lzd-t--math" x={fx(-10)} y={y0 + 16} text-anchor="middle">F</text>
				<g class="lzd-dim">
					<path d={`M${fx(0)} ${Y(V, -6.2)} V${Y(V, -7.2)} M${fx(0)} ${Y(V, -6.7)} H${fx(10)} M${fx(10)} ${Y(V, -6.2)} V${Y(V, -7.2)}`}></path>
				</g>
				<text class="lzd-t" x={fx(5)} y={Y(V, -6.7) + 14} text-anchor="middle">фокусное расстояние <tspan class="lzd-t--math">F</tspan></text>
			</svg>
			<p class="lzd__label"><b>Собирающая линза.</b> Лучи, параллельные главной оптической оси, собираются в фокусе <i>F</i>.</p>
		</div>
		<div class="lzd__panel">
			<svg class="lzd__svg" viewBox={`0 0 ${V.w} ${V.h}`} role="img" aria-label="Рассеивающая линза: лучи, параллельные главной оптической оси, после линзы расходятся так, будто вышли из точки F перед линзой. Пунктиром показаны продолжения лучей назад, они сходятся в мнимом фокусе F">
				<line class="lz-axis" x1="0" y1={y0} x2={V.w} y2={y0}></line>
				{
					div.rays.map((r) => (
						<g class="lz-ray">
							<path class="lz-virt" d={r.virt} />
							<path class="lz-base" d={r.d} />
							<path class="lz-flow" d={r.d} />
						</g>
					))
				}
				<path class="lz-lens" d={div.lens}></path>
				<circle class="lzd-o" cx={fx(0)} cy={y0} r="3"></circle>
				<circle class="lz-focus" cx={fx(10)} cy={y0} r="4.5"></circle>
				<circle class="lz-focus" cx={fx(-10)} cy={y0} r="4.5"></circle>
				<text class="lzd-t lzd-t--math" x={fx(0) + 8} y={y0 + 15}>O</text>
				<text class="lzd-t lzd-t--math" x={fx(10)} y={y0 + 16} text-anchor="middle">F</text>
				<text class="lzd-t lzd-t--math" x={fx(-10) - 7} y={y0 - 7} text-anchor="end">F</text>
				<text class="lzd-t lzd-t--small" x={fx(-10)} y={y0 + 15} text-anchor="middle">мнимый фокус</text>
				<g class="lzd-dim">
					<path d={`M${fx(-10)} ${Y(V, -6.2)} V${Y(V, -7.2)} M${fx(-10)} ${Y(V, -6.7)} H${fx(0)} M${fx(0)} ${Y(V, -6.2)} V${Y(V, -7.2)}`}></path>
				</g>
				<text class="lzd-t" x={fx(-5)} y={Y(V, -6.7) + 14} text-anchor="middle">фокусное расстояние <tspan class="lzd-t--math">F</tspan></text>
			</svg>
			<p class="lzd__label"><b>Рассеивающая линза.</b> Те же лучи расходятся, будто вышли из мнимого фокуса <i>F</i> (пунктир — продолжения лучей).</p>
		</div>
	</div>
	<figcaption class="lz-legend lzd__cap">
		Горизонтальная линия — главная оптическая ось, <i>O</i> — оптический центр. Второй фокус каждой линзы — по другую
		сторону от неё на таком же расстоянии. Масштаб одинаковый по обеим осям.
	</figcaption>
</figure>
