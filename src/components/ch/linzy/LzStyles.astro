---
/** Styles shared by the lens widgets of the chapter «Линзы». Renders nothing. */
---

<style is:global>
	.lz {
		--lz-r1: var(--ig-v);
		--lz-r2: var(--ig-vx);
		--lz-r3: var(--ig-vy);
		--lz-ink: var(--sl-color-white);
		--lz-muted: var(--sl-color-gray-3);
		--lz-glass: color-mix(in srgb, var(--ig-vx) 22%, transparent);
		--lz-glass-edge: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-white));
		position: relative;
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
	}
	.lz i {
		font-family: var(--ig-font-math);
	}
	.lz__svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: hidden;
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-y;
	}
	.lz__svg text {
		font-family: var(--__sl-font);
	}
	.lz-t {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
	}
	.lz-t--math {
		font-family: var(--ig-font-math) !important;
		font-style: italic;
		font-size: 18px;
		fill: var(--sl-color-gray-1);
	}
	.lz-t__num {
		font-family: KaTeX_Main, 'Times New Roman', serif;
		font-style: normal;
	}
	.lz-t--small {
		font-size: 13px;
		fill: var(--lz-muted);
	}
	/* a halo in the panel colour keeps letters readable where a ray passes under them */
	.lz__svg .lz-t {
		paint-order: stroke fill;
		stroke: var(--ig-surface);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.lz-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.lz-ruler line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.lz-ruler line.is-major {
		stroke: var(--sl-color-gray-3);
	}
	.lz-plane {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 4 5;
	}
	.lz-lens {
		fill: var(--lz-glass);
		stroke: var(--lz-glass-edge);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	/* schematic lens: a segment with arrowheads (lensSymbol in optics.ts) */
	.lz-sym {
		fill: none;
		stroke: var(--lz-glass-edge);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lzd .lz-sym {
		stroke-width: 2.2;
	}
	.lz-focus {
		fill: var(--sl-color-gray-1);
		stroke: var(--ig-surface);
		stroke-width: 2;
	}
	.lz-focus--2 {
		fill: var(--sl-color-gray-3);
	}

	/* Rays: a calm solid line plus little pulses of light running along it. */
	.lz-ray {
		--c: var(--lz-r1);
	}
	.lz-ray--2 {
		--c: var(--lz-r2);
	}
	.lz-ray--3 {
		--c: var(--lz-r3);
	}
	.lz-ray path {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lz-ray .lz-base {
		stroke: var(--c);
		stroke-width: 2.2;
	}
	.lz-ray .lz-flow {
		stroke: color-mix(in srgb, var(--c) 35%, white);
		stroke-width: 3.6;
		stroke-dasharray: 2 22;
		animation: lz-flow 0.9s linear infinite;
	}
	.lz-ray .lz-virt {
		stroke: var(--c);
		stroke-width: 1.6;
		stroke-dasharray: 7 6;
		opacity: 0.85;
	}
	.lz-ray .lz-guide {
		stroke: var(--c);
		stroke-width: 1.2;
		stroke-dasharray: 2 5;
		opacity: 0.7;
	}
	:root:not([data-theme='light']) .lz-ray .lz-base {
		filter: drop-shadow(0 0 3px color-mix(in srgb, var(--c) 70%, transparent));
	}
	:root[data-theme='light'] .lz-ray .lz-flow {
		stroke: color-mix(in srgb, var(--c) 55%, white);
	}
	@keyframes lz-flow {
		to {
			stroke-dashoffset: -24;
		}
	}

	/* Object and image arrows. */
	.lz-arrow line {
		stroke: var(--lz-ink);
		stroke-width: 3.2;
		stroke-linecap: round;
	}
	.lz-arrow polygon {
		fill: var(--lz-ink);
		stroke: var(--lz-ink);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.lz-arrow--image line {
		stroke: var(--sl-color-accent-high);
	}
	.lz-arrow--image polygon {
		fill: var(--sl-color-accent-high);
		stroke: var(--sl-color-accent-high);
	}
	:root:not([data-theme='light']) .lz-arrow--image.is-real {
		filter: drop-shadow(0 0 6px color-mix(in srgb, var(--sl-color-accent) 80%, transparent));
	}
	.lz-arrow--image.is-virtual line {
		stroke-dasharray: 6 5;
		stroke-width: 2.6;
	}
	.lz-arrow--image.is-virtual polygon {
		fill: var(--ig-surface);
		stroke-width: 2;
	}
	.lz-dot {
		fill: var(--lz-ink);
	}

	/* Controls */
	.lz-controls {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem 1.5rem;
		margin-top: 0.75rem;
		align-items: end;
	}
	.lz-row {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.lz-row__label {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-right: 0.15rem;
	}
	.lz-seg {
		display: inline-flex;
		padding: 3px;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.lz-seg button {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.4rem 0.95rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background 0.25s,
			color 0.25s;
	}
	.lz-seg button[aria-pressed='true'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.lz-slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.lz-slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.lz-slider input {
		grid-column: 1 / -1;
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.lz-btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s,
			transform 0.15s;
	}
	.lz-btn:hover {
		border-color: var(--sl-color-accent);
	}
	.lz-btn:active {
		transform: scale(0.97);
	}
	.lz-btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.lz-btn--primary:hover {
		filter: brightness(1.08);
	}
	.lz-btn--small {
		padding: 0.3rem 0.8rem;
	}
	.lz-btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.lz-btn:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.lz :is(button, [tabindex]):focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	/* draggable SVG parts show their own focus mark (an accent outline of the shape) */
	.lz svg [tabindex]:focus-visible {
		outline: none;
	}

	.lz-stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.5rem;
		margin: 0.9rem 0 0;
	}
	.lz-stats > div {
		padding: 0.45rem 0.7rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		min-width: 0;
	}
	.lz-stats dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.lz-stats dd {
		margin: 0;
		font-size: var(--sl-text-lg);
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.lz-live {
		min-height: 3em;
		margin: 0.7rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.lz-live b {
		color: var(--sl-color-white);
	}
	.lz-legend {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.lz-key {
		display: inline-block;
		width: 1.2rem;
		height: 3px;
		margin: 0 0.3rem 0.2rem 0.5rem;
		vertical-align: middle;
		border-radius: 2px;
		background: var(--c);
	}
	.lz-key:first-child {
		margin-left: 0;
	}
	.lz-key--thick {
		height: 4px;
	}
	.lz-key--dash {
		height: 0;
		border-top: 2px dashed var(--c);
		background: none;
	}
	.lz-nowrap {
		white-space: nowrap;
	}

	/* Pictures next to definitions: one or two small panels drawn at about their natural size. */
	.lzd {
		margin-block: 1.25rem 1.5rem;
		padding: 0.75rem;
	}
	.lzd__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1rem;
	}
	.lzd__panel {
		min-width: 0;
	}
	.lzd__svg {
		display: block;
		width: 100%;
		max-width: 24rem;
		height: auto;
		margin-inline: auto;
		overflow: visible;
		user-select: none;
		-webkit-user-select: none;
	}
	.lzd__svg--kinds {
		max-width: 26rem;
	}
	.lzd__label {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		color: var(--sl-color-gray-2);
	}
	.lzd__label b {
		color: var(--sl-color-white);
	}
	.lzd__cap {
		margin-top: 0.6rem;
	}
	.lzd-t {
		fill: var(--sl-color-gray-2);
		font-family: var(--__sl-font);
		font-size: 11px;
		paint-order: stroke fill;
		stroke: var(--ig-surface);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	.lzd-t--head {
		fill: var(--sl-color-white);
		font-size: 13px;
		font-weight: 600;
	}
	.lzd-t--small {
		font-size: 10px;
		fill: var(--sl-color-gray-3);
	}
	.lzd-t--math {
		font-family: var(--ig-font-math) !important;
		font-style: italic;
		font-size: 15px;
		fill: var(--sl-color-gray-1);
	}
	tspan.lzd-t--math {
		font-size: 13px;
	}
	.lzd-mid {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.lzd-o {
		fill: var(--sl-color-gray-1);
	}
	.lzd-dim path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
	}
	.lzd .lz-ray .lz-base {
		stroke-width: 1.8;
	}
	.lzd .lz-ray .lz-flow {
		stroke-width: 3;
	}
	.lzd .lz-ray .lz-virt {
		stroke-width: 1.3;
		stroke-dasharray: 5 4;
	}
	.lzd-arrow line {
		stroke-width: 2.4;
	}
	.lzd-screen {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.lzd-eye path {
		fill: #f3f1ec;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.lzd-eye__iris {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-3));
	}
	.lzd-eye__pupil {
		fill: #111;
	}

	@media (max-width: 40rem) {
		.lzd__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.lz-lab .lz-sym,
		.lzq .lz-sym,
		.lzp .lz-sym,
		.lzf .lz-sym {
			stroke-width: 4;
		}
		.lz {
			padding: 0.75rem;
		}
		.lz-t {
			font-size: 25px;
		}
		.lz-t--math {
			font-size: 30px;
		}
		.lz-t--small {
			font-size: 22px;
		}
		.lz__svg .lz-t {
			stroke-width: 6px;
		}
		.lz-controls {
			grid-template-columns: 1fr;
		}
		.lz-stats {
			grid-template-columns: 1fr 1fr;
		}
		.lz-stats dd {
			font-size: var(--sl-text-base);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.lz-ray .lz-flow {
			animation: none;
			display: none;
		}
		.lz-btn,
		.lz-seg button {
			transition: none;
		}
	}
</style>
