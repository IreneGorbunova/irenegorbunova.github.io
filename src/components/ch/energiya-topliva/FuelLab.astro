---
/**
 * Main model: choose a fuel and its mass, burn it, and see the heat Q = qm it gives:
 * how much water it could bring from 20 °C to the boil, or how high it could lift a 1-tonne load
 * (if all of the energy went into that one job). Scales are linear and zoom to the result.
 */
const fuels = [
	{ id: 'wood', name: 'Дрова сухие', q: 1.0 },
	{ id: 'coal', name: 'Каменный уголь', q: 2.7 },
	{ id: 'spirit', name: 'Спирт', q: 2.7 },
	{ id: 'gas', name: 'Природный газ', q: 4.4 },
	{ id: 'petrol', name: 'Бензин', q: 4.6 },
	{ id: 'hydrogen', name: 'Водород', q: 12 },
];
const fmtQ = (q: number) => q.toLocaleString('ru-RU', { minimumFractionDigits: q < 10 ? 1 : 0 });
// Coal lumps: [x, y, r, sides, turn] around the grate centre (120, 262).
const lumps = [
	[96, 252, 11, 5, 0.3],
	[120, 254, 12, 6, 1.1],
	[144, 252, 11, 5, 2.0],
	[108, 236, 11, 5, 0.8],
	[133, 237, 12, 6, 2.6],
	[120, 220, 10, 5, 1.7],
	[84, 258, 7, 5, 0.5],
	[157, 258, 7, 5, 1.4],
];
const poly = ([x, y, r, n, t]: number[]) =>
	Array.from({ length: n }, (_, i) => {
		const a = t + (i * 2 * Math.PI) / n;
		const rr = r * (0.82 + 0.18 * Math.sin(i * 2.3 + t));
		return `${(x + rr * Math.cos(a)).toFixed(1)},${(y + rr * Math.sin(a)).toFixed(1)}`;
	}).join(' ');
---

<figure class="fuel not-content" data-fuel>
	<div class="fuel__pick" role="radiogroup" aria-label="Топливо и его удельная теплота сгорания">
		{
			fuels.map((f) => (
				<button
					type="button"
					class="fuel__opt"
					role="radio"
					aria-checked={f.id === 'petrol' ? 'true' : 'false'}
					data-id={f.id}
					data-q={f.q * 1e7}
					data-name={f.name}
				>
					<span class="fuel__opt-name">{f.name}</span>
					<span class="fuel__opt-bar">
						<span style={`width:${(f.q / 12) * 100}%`} />
					</span>
					<span class="fuel__opt-q">
						{fmtQ(f.q)}·10<sup>7</sup>
					</span>
				</button>
			))
		}
		<p class="fuel__pick-note">Полоски — удельная теплота сгорания <i>q</i>, Дж/кг</p>
	</div>

	<div class="fuel__controls">
		<label class="fuel__slider">
			<span>Масса топлива <i>m</i></span>
			<output data-out-m></output>
			<input type="range" min="0" max="9" step="1" value="3" data-in-m aria-label="Масса топлива" />
		</label>
		<button type="button" class="fuel__btn" data-burn>Сжечь</button>
	</div>

	<div class="fuel__stage">
		<div class="fuel__card fuel__card--fire">
			<p class="fuel__card-title" data-fuel-title>Бензин</p>
			<svg viewBox="0 0 240 300" role="img" aria-label="Сгорание топлива">
				<defs>
					<filter id="fuel-glow" x="-50%" y="-50%" width="200%" height="200%">
						<feGaussianBlur stdDeviation="2.2" />
					</filter>
					<clipPath id="fuel-lamp-clip">
						<path d="M84,262 h72 a10,10 0 0 0 10,-10 v-22 q0,-26 -34,-30 h-24 q-34,4 -34,30 v22 a10,10 0 0 0 10,10z" />
					</clipPath>
					<clipPath id="fuel-bowl-clip">
						<path d="M66,228 L174,228 L160,262 L80,262 Z" />
					</clipPath>
				</defs>
				<text class="fuel__count" x="120" y="22" text-anchor="middle" data-count></text>
				<text class="fuel__left" x="120" y="42" text-anchor="middle" data-left></text>
				<line class="fuel__ground" x1="10" y1="272" x2="230" y2="272" />

				<!-- wood -->
				<g data-kind="wood">
					<ellipse class="fuel__ash" cx="120" cy="264" rx="0" ry="0" data-ash />
					<g class="fuel__grate">
						<line x1="62" y1="264" x2="178" y2="264" />
						<line x1="70" y1="264" x2="66" y2="272" />
						<line x1="170" y1="264" x2="174" y2="272" />
					</g>
					<g data-pile>
						<rect class="fuel__log" x="70" y="238" width="100" height="20" rx="10" transform="rotate(-7 120 248)" />
						<rect class="fuel__log" x="70" y="238" width="100" height="20" rx="10" transform="rotate(7 120 248)" />
						<rect class="fuel__log fuel__log--top" x="80" y="222" width="80" height="17" rx="8.5" />
						<circle class="fuel__ring" cx="80" cy="230.5" r="6" />
						<circle class="fuel__ring" cx="160" cy="230.5" r="6" />
						<rect class="fuel__char" x="66" y="218" width="108" height="46" rx="12" data-char />
					</g>
				</g>
				<!-- coal -->
				<g data-kind="coal">
					<ellipse class="fuel__ash" cx="120" cy="264" rx="0" ry="0" data-ash />
					<g class="fuel__grate">
						<line x1="62" y1="264" x2="178" y2="264" />
						<line x1="70" y1="264" x2="66" y2="272" />
						<line x1="170" y1="264" x2="174" y2="272" />
					</g>
					<g data-pile>
						{lumps.map((l) => <polygon class="fuel__lump" points={poly(l)} />)}
						<g data-embers>{lumps.slice(0, 6).map((l) => <polygon class="fuel__ember" points={poly([l[0], l[1], l[2] * 0.55, l[3], l[4] + 0.4])} />)}</g>
					</g>
				</g>
				<!-- spirit lamp -->
				<g data-kind="spirit">
					<g clip-path="url(#fuel-lamp-clip)">
						<rect class="fuel__liquid fuel__liquid--spirit" x="60" y="200" width="120" height="70" data-liquid />
					</g>
					<path class="fuel__glass" d="M84,262 h72 a10,10 0 0 0 10,-10 v-22 q0,-26 -34,-30 h-24 q-34,4 -34,30 v22 a10,10 0 0 0 10,10z" />
					<rect class="fuel__metal" x="108" y="188" width="24" height="13" rx="2" />
					<line class="fuel__wick" x1="120" y1="188" x2="120" y2="178" />
				</g>
				<!-- petrol in a bowl -->
				<g data-kind="petrol">
					<g clip-path="url(#fuel-bowl-clip)">
						<rect class="fuel__liquid fuel__liquid--petrol" x="60" y="228" width="120" height="40" data-liquid />
					</g>
					<path class="fuel__bowl" d="M66,228 L174,228 L160,262 L80,262 Z" />
					<line class="fuel__metal-line" x1="80" y1="262" x2="76" y2="272" />
					<line class="fuel__metal-line" x1="160" y1="262" x2="164" y2="272" />
				</g>
				<!-- gas from a bag -->
				<g data-kind="bag">
					<path class="fuel__tube" d="" data-tube />
					<ellipse class="fuel__bag" cx="64" cy="150" rx="40" ry="44" data-bag />
					<rect class="fuel__metal" x="150" y="226" width="16" height="46" rx="3" />
					<rect class="fuel__metal" x="144" y="222" width="28" height="7" rx="2" />
				</g>

				<g data-smoke></g>
				<g data-flame filter="url(#fuel-glow)" opacity="0">
					<path data-f0 />
					<path data-f1 />
					<path data-f2 />
				</g>
				<g data-flame-sharp opacity="0">
					<path data-g0 />
					<path data-g1 />
					<path data-g2 />
				</g>
				<g data-sparks></g>
				<text class="fuel__hint" x="120" y="120" text-anchor="middle" data-hint></text>
			</svg>
		</div>

		<div class="fuel__card">
			<p class="fuel__card-title">Нагреть воду от 20 °C до кипения</p>
			<svg viewBox="0 0 210 300" role="img" aria-label="Сколько воды можно нагреть">
				<g data-wticks></g>
				<rect class="fuel__water" x="63" y="270" width="58" height="0" data-water />
				<path class="fuel__wave" d="" data-wave />
				<g data-wbubbles></g>
				<path class="fuel__tank" d="M62,26 V270 H122 V26" />
				<g data-wmarks></g>
				<line class="fuel__ground" x1="10" y1="272" x2="200" y2="272" />
			</svg>
			<p class="fuel__result"><span data-res-w></span></p>
		</div>

		<div class="fuel__card">
			<p class="fuel__card-title">Поднять груз массой 1&nbsp;т</p>
			<svg viewBox="0 0 210 300" role="img" aria-label="На какую высоту можно поднять груз">
				<g data-hticks></g>
				<line class="fuel__axis" x1="58" y1="272" x2="58" y2="24" />
				<g data-hmarks></g>
				<line class="fuel__hline" x1="83" y1="272" x2="83" y2="272" data-hline />
				<g data-load>
					<rect class="fuel__load" x="66" y="-24" width="34" height="24" rx="3" />
					<text class="fuel__load-t" x="83" y="-7" text-anchor="middle">1 т</text>
				</g>
				<line class="fuel__ground" x1="10" y1="272" x2="200" y2="272" />
			</svg>
			<p class="fuel__result"><span data-res-h></span></p>
		</div>
	</div>

	<div class="fuel__formula" data-formula aria-live="polite"></div>
	<figcaption class="fuel__caption">
		Считаем, что топливо сгорает полностью и вся выделившаяся энергия идёт на одно дело — либо на нагревание воды, либо на подъём груза. На самом деле часть энергии всегда уходит в окружающий воздух. Шкалы линейные и сами подстраиваются под результат.
	</figcaption>
</figure>

<style is:global>
	.fuel {
		--fire-1: hsl(14, 95%, 52%);
		--fire-2: hsl(34, 100%, 55%);
		--fire-3: hsl(50, 100%, 78%);
		margin-block: 1.5rem 2rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
	}
	.fuel i {
		font-family: var(--ig-font-math);
	}
	.fuel__pick {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.2rem;
		margin: 0 0 0.9rem;
	}
	.fuel__pick-note {
		grid-column: 1 / -1;
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.fuel__opt {
		display: grid;
		grid-template-columns: 8.2rem 1fr 4.6rem;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.2rem 0.55rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid transparent;
		border-radius: 0.6rem;
		cursor: pointer;
		transition:
			background 0.25s,
			border-color 0.25s,
			color 0.25s;
	}
	.fuel__opt:hover {
		border-color: var(--sl-color-gray-5);
	}
	.fuel__opt[aria-checked='true'] {
		color: var(--sl-color-white);
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
	}
	.fuel__opt-bar {
		height: 0.55rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		overflow: hidden;
	}
	.fuel__opt-bar > span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--sl-color-gray-4);
		transition: background 0.25s;
