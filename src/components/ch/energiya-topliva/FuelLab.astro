		fill: hsl(48, 80%, 60%);
		opacity: 0.75;
	}
	.fuel__metal {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.fuel__metal-line {
		stroke: var(--sl-color-gray-3);
