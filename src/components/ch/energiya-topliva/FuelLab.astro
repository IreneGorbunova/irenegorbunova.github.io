		margin: 0 0.3rem 0.2rem;
		min-height: 2.6em;
		font-size: var(--sl-text-sm);
		line-height: 1.3;
		font-weight: 600;
		color: var(--sl-color-white);
		text-align: center;
	}
	.fuel__result {
		margin: 0.2rem 0 0;
		text-align: center;
		font-size: var(--sl-text-base);
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.fuel__count {
		font-size: 17px;
		font-weight: 700;
		fill: var(--ig-vy);
		font-variant-numeric: tabular-nums;
	}
	.fuel__left,
	.fuel__hint {
		font-size: 13px;
		fill: var(--sl-color-gray-3);
	}
	.fuel__ground {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.fuel__grate line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.fuel__log {
		fill: hsl(26, 42%, 38%);
		stroke: hsl(24, 40%, 24%);
		stroke-width: 1.5;
	}
	.fuel__log--top {
		fill: hsl(28, 45%, 44%);
	}
	.fuel__ring {
		fill: hsl(34, 55%, 62%);
		stroke: hsl(26, 42%, 34%);
		stroke-width: 1.5;
	}
	.fuel__char {
		fill: hsl(20, 25%, 10%);
		opacity: 0;
		mix-blend-mode: multiply;
	}
