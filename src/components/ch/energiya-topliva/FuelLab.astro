		color: var(--sl-color-gray-2);
	}
	.fuel__slider output {
		font-weight: 700;
		color: var(--ig-v);
		font-variant-numeric: tabular-nums;
	}
	.fuel__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--ig-v);
	}
	.fuel__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		padding: 0.55rem 1.3rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		cursor: pointer;
		white-space: nowrap;
	}
	.fuel__btn:hover {
		filter: brightness(1.08);
	}
	.fuel__btn:disabled {
		opacity: 0.55;
		cursor: default;
	}
	.fuel__stage {
		display: grid;
		grid-template-columns: 1.15fr 1fr 1fr;
