		fill: hsl(30, 6%, 62%);
	}
	.fuel__lump {
		fill: hsl(220, 8%, 16%);
		stroke: hsl(220, 8%, 34%);
		stroke-width: 1.2;
	}
	.fuel__ember {
		fill: hsl(12, 95%, 52%);
		opacity: 0;
	}
	.fuel__glass {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
