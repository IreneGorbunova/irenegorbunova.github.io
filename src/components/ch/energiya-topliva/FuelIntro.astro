---
/**
 * Two short looping opening scenes of «Энергия топлива».
 * Fireplace: 18:00 → 22:00 in 7 s; the logs burn down to embers while the room warms from 15 to 22 °C (the warming
 * follows the heat released so far; illustrative numbers).
 * Rocket: the first 10 s of a Soyuz flight in 8 s, at a true scale (3 px per metre, 46 m tall). Data from the Soyuz
 * User's Manual (Arianespace, Issue 2.1, 2018, Fig. 1.5.1a): 4 boosters RD-107A 838,5 kN / 262 s and the core RD-108A
 * 792,5 kN / 255 s at sea level, so ṁ = F / (Isp·g₀) = 4·326 + 317 ≈ 1622 kg/s ≈ 1,6 т/с (the stage propellant
 * masses over the burn times give the same: 4·39 160/118 + 90 100/286 ≈ 1640 kg/s). Lift-off mass ≈ 310 т
 * (the three stages alone are 305 т). Height h(t) from the rocket equation with constant thrust and mass flow.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const flames = [
	[-26, 0.7],
	[-13, 0.95],
	[0, 1.15],
	[13, 1],
	[26, 0.75],
] as const;
const ft = (t: number) => 186 - 4.5 * t; // fireplace thermometer: y of t °C
---

<IntroFrame data-fuintro>
	<div class="intro__card" data-scene="fire">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Камин: вечером с 18 до 22 часов дрова сгорают до углей, а термометр в комнате поднимается с 15 до 22 °C">
			<defs>
				<marker id="fuintro-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
					<path class="fu__head" d="M 0 0 L 10 5 L 0 10 z" />
				</marker>
			</defs>
			<rect class="fu__wall" x="0" y="0" width="360" height="240" />
			<!-- window: evening turns into night -->
			<rect class="fu__glass" x="220" y="34" width="58" height="70" data-glass />
			<g class="fu__stars" data-stars>
				<circle cx="234" cy="50" r="1.3" />
				<circle cx="262" cy="44" r="1" />
				<circle cx="252" cy="70" r="1.2" />
			</g>
			<path class="fu__frame" d="M220 34 H278 V104 H220 Z M249 34 V104 M220 69 H278" />
			<rect class="fu__sill" x="214" y="104" width="70" height="5" rx="2" />
			<g class="fu__clock">
				<circle cx="22" cy="22" r="9" />
				<path d="M22 22 V28" data-hand />
				<text x="37" y="28" data-clock>18:00</text>
			</g>
			<!-- floor and fireplace -->
			<rect class="fu__floor" x="0" y="204" width="360" height="36" />
			<ellipse class="fu__glow" cx="110" cy="208" rx="80" ry="9" data-glow />
			<path class="fu__stone" d="M34 75 H186 V200 H34 Z" />
			<path class="fu__box" d="M60 200 V130 Q60 106 84 106 H136 Q160 106 160 130 V200 Z" data-box />
			<rect class="fu__mantel" x="22" y="66" width="176" height="10" rx="2" />
			<rect class="fu__hearth" x="26" y="198" width="168" height="7" rx="2" />
			<g data-logs>
				{[[66, 184, 88, 13], [72, 172, 76, 12], [82, 161, 56, 11]].map(([x, y, w, h]) => (
					<g>
						<rect class="fu__log" x={x} y={y} width={w} height={h} rx={h / 2} />
						<ellipse class="fu__end" cx={x + w - h / 2} cy={y + h / 2} rx={h / 2 - 1.5} ry={h / 2 - 1.5} />
						<path class="fu__bark" d={`M${x + 10} ${y + h / 2 - 1.5} h${w * 0.35} M${x + w * 0.45} ${y + h / 2 + 2} h${w * 0.3}`} />
					</g>
				))}
			</g>
			<g data-flames>
				<g class="fu__flames">
					{flames.map(([dx, k], j) => (
						<g transform={`translate(${dx} 0) scale(${0.85 + 0.15 * k} ${k})`}>
							<path class="fu__fl" style={`--d:${(j * 0.11).toFixed(2)}s`} d="M0 0 q -10 -16 0 -38 q 10 22 0 38 z" />
							<path class="fu__fl fu__fl--in" style={`--d:${(j * 0.11 + 0.05).toFixed(2)}s`} d="M0 0 q -5 -9 0 -21 q 5 12 0 21 z" />
						</g>
					))}
				</g>
			</g>
			<!-- heat goes into the room -->
			<g class="fu__heat" data-heat>
				{[132, 154, 176].map((y) => (
					<path d={`M168 ${y} q 8 -6 16 0 t 16 0 t 16 0 t 16 0 t 16 0`} marker-end="url(#fuintro-arrow)" />
				))}
			</g>
			<!-- room thermometer -->
			<g>
				<rect class="fu__tube" x="315" y="60" width="6" height="92" rx="3" />
				{[10, 15, 20, 25].map((t) => (
					<line class="fu__tick" x1="310" x2="315" y1={ft(t)} y2={ft(t)} />
				))}
				<rect class="fu__col" x="316.6" y={ft(15)} width="2.8" height={154 - ft(15)} data-col />
				<circle class="fu__col" cx="318" cy="154" r="5" />
				<rect class="fu__pill" x="288" y="168" width="60" height="24" rx="12" />
				<text class="fu__read" x="318" y="185" text-anchor="middle" data-read>15&nbsp;°C</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Вечером в камине горят дрова. Поленья становятся всё меньше, а в комнате теплеет: при горении <More term="выделяется энергия, запасённая в дровах">Дрова горят — соединяются с кислородом воздуха. Энергию, которая при этом выделяется, дерево запасло из солнечного света, пока росло. Пламя и раскалённые угли греют комнату, а горячие газы уходят в трубу и уносят часть тепла с собой. От поленьев остаётся лишь горстка золы: остальное вещество улетает в трубу углекислым газом и водяным паром.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="rocket">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Старт ракеты «Союз»: за первые 10 секунд полёта сгорает около 16 тонн керосина и жидкого кислорода, и ракета поднимается почти на 200 метров">
			<rect class="fu__sky" x="0" y="0" width="360" height="240" />
			<g data-clouds>
				{[[118, 90, 1], [300, 140, 0.85], [96, 190, 1.1]].map(([x, a, k]) => (
					<path class="fu__cloud" data-x={x} data-a={a} transform={`translate(${x} 0) scale(${k})`} d="M-26 0 a 10 10 0 0 1 9 -12 a 13 13 0 0 1 24 -4 a 10 10 0 0 1 19 16 z" />
				))}
			</g>
			<!-- the ground (moves down when the camera follows the rocket) -->
			<g data-world>
				<rect class="fu__ground" x="0" y="210" width="360" height="40" />
				<rect class="fu__pad" x="112" y="206" width="136" height="6" rx="1.5" />
				<g class="fu__smoke" data-padsmoke>
					{[-1, 1].flatMap((side) => [0, 1, 2].map((i) => <circle data-side={side} data-i={i} cx="180" cy="204" r="6" />))}
				</g>
			</g>
			<path class="fu__trail" data-trail d="" />
			<g data-arms>
				{[-1, 1].map((side) => (
					<g data-arm={side}>
						<path class="fu__arm" d={`M${180 + 26 * side} 208 L${180 + 7 * side} 155`} />
					</g>
				))}
			</g>
			<g data-rocket transform="translate(180 210)">
				<g class="fu__jets">
					{[-9.5, 9.5, 0].map((x, j) => (
						<g transform={`translate(${x} 3)`}>
							<path class="fu__jet" style={`--d:${(j * 0.07).toFixed(2)}s`} d="M -3.6 0 Q -5.5 15 0 36 Q 5.5 15 3.6 0 Z" />
							<path class="fu__jet fu__jet--in" style={`--d:${(j * 0.07 + 0.03).toFixed(2)}s`} d="M -2 0 Q -2.6 9 0 19 Q 2.6 9 2 0 Z" />
						</g>
					))}
				</g>
				<rect class="fu__nozzle" x="-12" y="0" width="5" height="3" />
				<rect class="fu__nozzle" x="7" y="0" width="5" height="3" />
				<rect class="fu__nozzle" x="-2.5" y="0" width="5" height="3" />
				<path class="fu__hull" d="M-3.2 0 H3.2 L4.5 -54 V-81 H-4.5 V-54 Z" />
				<path class="fu__hull" d="M-5 0 H-14.5 L-13.4 -15 L-4.6 -58 Z" />
				<path class="fu__hull" d="M5 0 H14.5 L13.4 -15 L4.6 -58 Z" />
				<path class="fu__hull fu__hull--front" d="M-4.4 0 H4.4 L4 -15 L0.9 -56 H-0.9 L-4 -15 Z" />
				<path class="fu__truss" d="M-3.6 -81 L3.6 -84 M3.6 -81 L-3.6 -84" />
				<rect class="fu__hull" x="-4" y="-104" width="8" height="20" />
				<path class="fu__hull fu__hull--fairing" d="M-4 -104 L-6.2 -108 V-130 Q-6.2 -136 0 -140 Q6.2 -136 6.2 -130 V-108 Z" />
			</g>
			<g class="fu__clock">
				<circle cx="22" cy="26" r="9" />
				<path d="M19 14 h6 M22 17 V26" />
				<path d="M22 26 V20" data-hand />
				<text x="37" y="32" data-clock>0:00</text>
			</g>
			<rect class="fu__pill" x="222" y="12" width="128" height="26" rx="13" />
			<text class="fu__read" x="286" y="30" text-anchor="middle" data-burnt>сгорело 0&nbsp;т</text>
		</svg>
		<div class="intro__foot">
			<p>На старте «Союз» каждую секунду сжигает около 1,6&nbsp;т топлива — керосина и жидкого кислорода. <More term="Энергия, запасённая в топливе, поднимает ракету вверх">Керосин горит, соединяясь с кислородом, и выделяет энергию. Раскалённые газы с огромной скоростью вырываются из сопел вниз и толкают ракету вверх. Кислород ракета везёт с собой: в космосе воздуха нет. На старте в «Союзе» около 270&nbsp;т топлива, больше двух третей из них — жидкий кислород, а масса всей ракеты — больше 300&nbsp;т.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-fuintro] {
		--fu-dark: var(--sl-color-black);
		--fu-hull: var(--sl-color-gray-2);
		--fu-cloud: color-mix(in srgb, var(--sl-color-gray-1) 30%, transparent);
		--fu-smoke: color-mix(in srgb, var(--sl-color-gray-2) 45%, transparent);
	}
	:root[data-theme='light'] [data-fuintro] {
		--fu-dark: var(--sl-color-gray-2);
		--fu-hull: var(--sl-color-black);
		--fu-cloud: color-mix(in srgb, var(--sl-color-black) 90%, transparent);
		--fu-smoke: color-mix(in srgb, var(--sl-color-gray-4) 45%, transparent);
	}
	.fu__clock circle,
	.fu__clock path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.fu__clock text {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.fu__tube {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 25%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.fu__tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.fu__col {
		fill: var(--sl-color-red);
	}
	.fu__pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.fu__read {
		font-size: 16px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	/* fireplace */
	.fu__wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.fu__frame {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.fu__sill {
		fill: var(--sl-color-gray-3);
	}
	.fu__stars circle {
		fill: var(--ig-v);
	}
	.fu__floor {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.fu__glow {
		fill: var(--ig-v);
	}
	.fu__stone {
		fill: color-mix(in srgb, var(--ig-vy) 18%, var(--sl-color-gray-4));
	}
	.fu__mantel,
	.fu__hearth {
		fill: var(--sl-color-gray-3);
	}
	.fu__log {
		stroke: color-mix(in srgb, var(--fu-dark) 60%, transparent);
		stroke-width: 1;
	}
	.fu__end {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-2));
		opacity: var(--grain, 1);
	}
	.fu__bark {
		stroke: color-mix(in srgb, var(--fu-dark) 45%, transparent);
		stroke-width: 1;
		stroke-linecap: round;
		opacity: var(--grain, 1);
	}
	.fu__fl {
		fill: var(--ig-vy);
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: fuintro-flame 0.5s ease-in-out infinite alternate;
		animation-delay: var(--d);
	}
	.fu__fl--in {
		fill: var(--ig-v);
	}
	@keyframes fuintro-flame {
		from { transform: scale(1.05, 0.82); }
		to { transform: scale(0.92, 1.1); }
	}
	.fu__heat path {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 6 5;
		animation: fuintro-flow 0.8s linear infinite;
	}
	.fu__head {
		fill: var(--ig-vy);
	}
	@keyframes fuintro-flow {
		to { stroke-dashoffset: -11; }
	}
	/* rocket */
	.fu__sky {
		fill: color-mix(in srgb, var(--ig-vx) 16%, transparent);
	}
	.fu__cloud {
		fill: var(--fu-cloud);
	}
	.fu__ground {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.fu__pad {
		fill: var(--sl-color-gray-3);
	}
	.fu__smoke circle,
	.fu__trail {
		fill: var(--fu-smoke);
	}
	.fu__arm {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.fu__hull {
		fill: var(--fu-hull);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.fu__hull--front {
		fill: color-mix(in srgb, var(--fu-hull) 88%, var(--sl-color-gray-4));
	}
	.fu__hull--fairing {
		fill: color-mix(in srgb, var(--fu-hull) 85%, var(--ig-vx));
	}
	.fu__truss {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.fu__nozzle {
		fill: var(--sl-color-gray-3);
	}
	.fu__jet {
		fill: var(--ig-v);
		transform-box: fill-box;
		transform-origin: 50% 0%;
		animation: fuintro-jet 0.18s ease-in-out infinite alternate;
		animation-delay: var(--d);
	}
	.fu__jet--in {
		fill: color-mix(in srgb, var(--ig-v) 35%, white);
	}
	@keyframes fuintro-jet {
		from { transform: scale(1, 0.9); }
		to { transform: scale(1.08, 1.06); }
	}
	@media (prefers-reduced-motion: reduce) {
		.fu__fl,
		.fu__heat path,
		.fu__jet {
			animation: none;
		}
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const ru = (v: number, d = 0) => v.toLocaleString('ru-RU', { maximumFractionDigits: d, minimumFractionDigits: d });

	for (const root of document.querySelectorAll<HTMLElement>('[data-fuintro]')) {
		// Fireplace: 18:00 → 22:00 in 7 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="fire"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const clock = $<SVGTextElement>('[data-clock]');
			const hand = $<SVGPathElement>('[data-hand]');
			const glass = $<SVGRectElement>('[data-glass]');
			const stars = $<SVGGElement>('[data-stars]');
			const box = $<SVGPathElement>('[data-box]');
			const glow = $<SVGEllipseElement>('[data-glow]');
			const logs = $<SVGGElement>('[data-logs]');
			const logRects = Array.from(logs.querySelectorAll<SVGRectElement>('.fu__log'));
			const fl = $<SVGGElement>('[data-flames]');
			const heat = $<SVGGElement>('[data-heat]');
			const col = $<SVGRectElement>('[data-col]');
			const read = $<SVGTextElement>('[data-read]');
			// strength of the fire: lit, burns, dies down to embers
			const fire = (x: number) => (0.25 + 0.75 * clamp(x / 0.08)) * (x < 0.45 ? 1 : Math.max(0.08, 1 - (x - 0.45) / 0.5));
			// heat released so far, as a fraction of the whole evening
			const N = 400;
			const burnt = new Float64Array(N + 1);
			for (let i = 1; i <= N; i++) burnt[i] = burnt[i - 1] + fire((i - 0.5) / N);
			for (let i = 1; i <= N; i++) burnt[i] /= burnt[N];
			const yT = (t: number) => 186 - 4.5 * t;
			scene(card, 7, (x) => {
				const f = fire(x);
				const b = burnt[Math.round(x * N)];
				const h = 18 + 4 * x;
				const hh = Math.floor(h);
				const mm = Math.floor((h - hh) * 60);
				clock.textContent = `${hh}:${String(mm).padStart(2, '0')}`;
				const ang = ((h % 12) / 12) * 2 * Math.PI;
				hand.setAttribute('d', `M22 22 L${(22 + 6 * Math.sin(ang)).toFixed(1)} ${(22 - 6 * Math.cos(ang)).toFixed(1)}`);
				// evening → night in the window
				glass.style.fill = `color-mix(in srgb, var(--ig-vx) ${Math.round(45 - 35 * x)}%, var(--fu-dark))`;
				stars.style.opacity = clamp((x - 0.3) / 0.4).toFixed(2);
				// logs shrink to a heap of embers
				const r = 1 - 0.9 * b;
				const sx = 0.3 + 0.7 * r;
				const sy = 0.25 + 0.75 * r;
				logs.setAttribute('transform', `translate(110 197) scale(${sx.toFixed(3)} ${sy.toFixed(3)}) translate(-110 -197)`);
				const wood = 'color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4))';
				logs.style.setProperty('--grain', (1 - b).toFixed(2));
				for (const l of logRects) l.style.fill = `color-mix(in srgb, var(--ig-vy) ${Math.round(70 * b)}%, ${wood})`;
				const top = 197 - 36 * sy;
				fl.setAttribute('transform', `translate(110 ${(top + 4).toFixed(1)}) scale(${(1.3 * (0.55 + 0.45 * f)).toFixed(3)} ${(1.3 * f).toFixed(3)})`);
				fl.style.opacity = clamp((f - 0.08) / 0.1).toFixed(2);
				box.style.fill = `color-mix(in srgb, var(--ig-vy) ${Math.round(8 + 30 * f)}%, var(--fu-dark))`;
				glow.style.opacity = (0.08 + 0.22 * f).toFixed(2);
				heat.style.opacity = (0.15 + 0.85 * f).toFixed(2);
				// the room warms with the heat released
				const t = 15 + 7 * b;
				col.setAttribute('y', yT(t).toFixed(1));
				col.setAttribute('height', (154 - yT(t)).toFixed(1));
				read.textContent = `${Math.round(t)} °C`;
			});
		}

		// Rocket: the first 10 s after lift-off in 8 s, 3 px per metre
		{
			const card = root.querySelector<HTMLElement>('[data-scene="rocket"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const clock = $<SVGTextElement>('[data-clock]');
			const hand = $<SVGPathElement>('[data-hand]');
			const burntText = $<SVGTextElement>('[data-burnt]');
			const rocket = $<SVGGElement>('[data-rocket]');
			const world = $<SVGGElement>('[data-world]');
			const trail = $<SVGPathElement>('[data-trail]');
			const arms = Array.from(card.querySelectorAll<SVGGElement>('[data-arm]'));
			const clouds = Array.from(card.querySelectorAll<SVGPathElement>('.fu__cloud'));
			const puffs = Array.from(card.querySelectorAll<SVGCircleElement>('[data-padsmoke] circle'));
			const F = 4 * 838.5e3 + 792.5e3; // N, thrust at sea level
			const MD = 1622; // kg/s, propellant burnt per second
			const M0 = 310e3; // kg at lift-off
			const G = 9.80665;
			const k = MD / M0;
			const height = (t: number) => {
				const u = 1 - k * t;
				return (F / MD / k) * (u * Math.log(u) - u + 1) - (G * t * t) / 2;
			};
			const S = 3; // px per metre
			const GROUND = 210;
			const FOLLOW = 60; // px the rocket rises before the camera follows it
			scene(card, 8, (x) => {
				const t = 10 * x;
				const hpx = S * height(t);
				const cam = Math.max(0, hpx - FOLLOW);
				const base = GROUND - hpx + cam;
				const ground = GROUND + cam;
				rocket.setAttribute('transform', `translate(180 ${base.toFixed(1)})`);
				world.setAttribute('transform', `translate(0 ${cam.toFixed(1)})`);
				for (const c of clouds) {
					const y = GROUND - S * Number(c.dataset.a) + cam;
					c.setAttribute('transform', `translate(${c.dataset.x} ${y.toFixed(1)})`);
				}
				// the support arms swing back
				const a = 50 * clamp(t / 1.6) ** 0.7;
				for (const g of arms) {
					const side = Number(g.dataset.arm);
					g.setAttribute('transform', `translate(0 ${cam.toFixed(1)}) rotate(${(side * a).toFixed(1)} ${180 + 26 * side} 208)`);
				}
				// smoke billows along the ground; the exhaust leaves a trail down to it
				const s = clamp(t / 6);
				for (const p of puffs) {
					const side = Number(p.dataset.side);
					const i = Number(p.dataset.i);
					p.setAttribute('cx', (180 + side * (14 + (30 + 22 * i) * s ** 0.6)).toFixed(1));
					p.setAttribute('r', ((5 + 2 * i) * (0.6 + 1.4 * s ** 0.5)).toFixed(1));
				}
				const y0 = base + 34;
				if (ground > y0 + 2) {
					const y1 = Math.min(ground, 260);
					const w1 = 11 + 0.12 * (y1 - y0);
					trail.setAttribute('d', `M171 ${y0.toFixed(1)} H189 L${(180 + w1).toFixed(1)} ${y1.toFixed(1)} H${(180 - w1).toFixed(1)} Z`);
				} else trail.setAttribute('d', '');
				const sec = Math.floor(t + 1e-6);
				clock.textContent = `0:${String(sec).padStart(2, '0')}`;
				const ang = (t / 60) * 2 * Math.PI;
				hand.setAttribute('d', `M22 26 L${(22 + 6 * Math.sin(ang)).toFixed(1)} ${(26 - 6 * Math.cos(ang)).toFixed(1)}`);
				burntText.textContent = `сгорело ${ru(Math.round((MD * t) / 1000))} т`;
			});
		}
	}
</script>
