		opacity: 0.45;
	}
	.jl__vessel {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.jl__lid {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.jl__drum {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.jl__drum-line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.jl__thermo {
		fill: color-mix(in srgb, var(--sl-color-white) 10%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.jl__bulb,
	.jl__col {
		fill: var(--ig-vy);
	}
	.jl__tscale line {
		stroke: var(--sl-color-gray-3);
	}
	.jl__tscale text {
		font-size: 13px;
		fill: var(--sl-color-gray-3);
	}
	.jl__readout rect {
		fill: var(--sl-color-gray-6);
		stroke: var(--ig-vy);
		stroke-width: 1.5;
	}
	.jl__readout text {
		font-size: 19px;
		font-weight: 700;
		fill: var(--ig-vy);
		font-variant-numeric: tabular-nums;
	}
	.jl__weight {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
	}
	.jl__wt {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-black);
	}
	.jl__ruler line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.jl__ruler text {
		font-size: 14px;
		fill: var(--sl-color-gray-2);
	}
	.jl__ruler .jl__math {
		font-style: italic;
		font-family: var(--ig-font-math);
	}
	.jl__note {
		font-size: 17px;
		fill: var(--sl-color-gray-2);
	}
	.jl__controls {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem 1.5rem;
		margin-top: 0.6rem;
	}
