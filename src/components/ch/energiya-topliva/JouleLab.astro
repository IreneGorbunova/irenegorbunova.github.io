		margin-block: 1.5rem 2rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.jl i {
		font-family: var(--ig-font-math);
	}
	.jl__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.jl__floor {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.jl__stand line,
	.jl__stand-thin {
		stroke: var(--sl-color-gray-4);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.jl__stand-thin {
		stroke-width: 4;
	}
	.jl__table {
		fill: var(--sl-color-gray-4);
	}
	.jl__cord {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.jl__pulley {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.jl__spoke {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.jl__axle-dot {
		fill: var(--sl-color-gray-2);
	}
	.jl__water {
		fill: var(--ig-vx);
		opacity: 0.32;
		transition: fill 0.4s;
	}
