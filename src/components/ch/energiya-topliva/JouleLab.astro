	}
	.jl__slider--m input {
		accent-color: var(--sl-color-gray-3);
	}
	.jl__slider--w output {
		color: var(--ig-vx);
	}
	.jl__slider--w input {
		accent-color: var(--ig-vx);
	}
	.jl__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.jl__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.jl__btn:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.jl__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.jl__btn:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.jl__formula {
		margin-top: 0.75rem;
		padding: 0.3rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.jl__formula .katex-display {
		margin: 0.45rem 0;
	}
	.jl .et-E {
		color: var(--ig-v);
	}
	.jl .et-Q {
		color: var(--ig-vy);
	}
	.jl__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.jl {
			padding: 0.75rem 0.6rem;
		}
		.jl__controls {
			grid-template-columns: 1fr;
		}
		.jl__btn {
			padding: 0.4rem 0.8rem;
		}
	}
</style>

<script>
	import { ru, fixed, tex, renderTex, c, reduceMotion, loop } from './et';

	const G = 9.8;
	const H = 1.5; // m
	const C = 4200;
	const H_PX = 150;
	const TOP = 150;
	const DRUM_R = 9; // px, radius of the drum the cords are wound on
	const FALL = 2.6; // s on screen
	const RISE = 1.1;
	const NS = 'http://www.w3.org/2000/svg';

	for (const root of document.querySelectorAll<HTMLElement>('[data-jl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const bigIn = $<HTMLInputElement>('[data-in-big]');
		const wIn = $<HTMLInputElement>('[data-in-w]');
		const dropB = $<HTMLButtonElement>('[data-drop]');
		const liftB = $<HTMLButtonElement>('[data-lift]');
		const autoB = $<HTMLButtonElement>('[data-auto]');
		const resetB = $<HTMLButtonElement>('[data-reset]');
		const paddles = $<SVGGElement>('[data-paddles]');
		const swirlG = $<SVGGElement>('[data-swirl]');
		const drumLines = $<SVGGElement>('[data-drum-lines]');
		const col = $<SVGRectElement>('[data-col]');
		const tempT = $<SVGTextElement>('[data-temp]');
		const note = $<SVGTextElement>('[data-note]');
		const formula = $<HTMLElement>('[data-formula]');
		const water = $<SVGRectElement>('[data-water]');
		const cordL = $<SVGPathElement>('[data-cord-l]');
		const cordR = $<SVGPathElement>('[data-cord-r]');
		const pulL = $<SVGGElement>('[data-pulley-l]');
		const pulR = $<SVGGElement>('[data-pulley-r]');
		const wL = $<SVGGElement>('[data-w-l]');
		const wR = $<SVGGElement>('[data-w-r]');

		let s = 0; // how far the weights are down, 0…1
		let phase: 'top' | 'fall' | 'bottom' | 'rise' = 'top';
		let n = 0; // completed falls
		let temp = 20; // °C
		let tStart = 20; // temperature at the start of the current fall
		let phi = 0; // paddle angle
		let omega = 0; // paddle angular speed (rad/s), the water swirls with it
		let swirlPhase = 0;
		let auto = 0; // falls left in the automatic run
		let tt = 0;

		const swirl = Array.from({ length: 26 }, (_, i) => {
			const el = document.createElementNS(NS, 'circle');
			el.setAttribute('class', 'jl__swirl');
			el.setAttribute('r', String(1.2 + (i % 3) * 0.4));
			swirlG.append(el);
			return { el, a: Math.random() * 6.28, rx: 12 + Math.random() * 40, y: 196 + Math.random() * 98, k: 0.6 + Math.random() * 0.6 };
		});
		for (let i = 0; i < 3; i++) {
			const l = document.createElementNS(NS, 'line');
			l.setAttribute('class', 'jl__drum-line');
			l.setAttribute('x1', '302');
			l.setAttribute('x2', '338');
			drumLines.append(l);
		}

		const M = () => Number(bigIn.value);
		const mw = () => Number(wIn.value);
		const dtDrop = () => (M() * G * H) / (C * mw());

		const writeFormula = () => {
			const big = M();
			const m = mw();
			const E = n * big * G * H;
			const dT = n * dtDrop();
			const narrow = root.clientWidth < 560;
			const br = narrow ? '\\\\ &' : '';
			const nb = `${n} \\cdot `;
			const lines = [
				`${c('E', 'E')} &= n\\,M g h = ${nb}${big}~\\text{кг}\\cdot 9{,}8~\\tfrac{\\text{Н}}{\\text{кг}} \\cdot 1{,}5~\\text{м} ${br}= ${c('E', tex(ru(E, 1)) + '~\\text{Дж}')}`,
				`t - t_0 &= \\dfrac{${c('Q', 'Q')}}{c\\,m} = \\dfrac{${c('E', tex(ru(E, 1)) + '~\\text{Дж}')}}{4200~\\tfrac{\\text{Дж}}{\\text{кг}\\cdot{}^\\circ\\text{C}}\\cdot ${tex(ru(m, 1))}~\\text{кг}} ${br}${n === 0 || Math.abs(dT - Math.round(dT * 100) / 100) < 1e-9 ? '=' : '\\approx'} ${c('Q', tex(fixed(dT, 2)) + '~{}^\\circ\\text{C}')}`,
			];
			renderTex(formula, `\\begin{aligned}${lines.join('\\\\[0.8em]')}\\end{aligned}`);
		};

		const buttons = () => {
			const busy = phase === 'fall' || phase === 'rise' || auto > 0;
			dropB.disabled = busy || phase !== 'top';
			liftB.disabled = busy || phase !== 'bottom';
			autoB.disabled = busy;
			bigIn.disabled = busy;
			wIn.disabled = busy;
		};

		const draw = (dt: number) => {
			const y = TOP + s * H_PX;
			wL.setAttribute('transform', `translate(0 ${s * H_PX})`);
			wR.setAttribute('transform', `translate(0 ${s * H_PX})`);
			cordL.setAttribute('d', `M302,98 H110 A16,16 0 0 0 94,120 V${y}`);
			cordR.setAttribute('d', `M338,98 H530 A16,16 0 0 1 546,120 V${y}`);
			const pa = (s * H_PX) / 16; // pulleys turn without slipping
			pulL.setAttribute('transform', `translate(110 120) rotate(${(-pa * 180) / Math.PI})`);
			pulR.setAttribute('transform', `translate(530 120) rotate(${(pa * 180) / Math.PI})`);
			drumLines.querySelectorAll('line').forEach((l, i) => {
				const yy = 105 + 7 * Math.sin(((s * H_PX) / DRUM_R) + (i * 2 * Math.PI) / 3);
				const front = Math.cos((s * H_PX) / DRUM_R + (i * 2 * Math.PI) / 3) > 0;
				l.setAttribute('y1', yy.toFixed(1));
				l.setAttribute('y2', yy.toFixed(1));
				l.style.opacity = front ? '1' : '0';
			});
			// paddle wheel: 4 blades on 3 levels, seen from the side
			let html = '';
			const back: string[] = [];
			const front: string[] = [];
			for (const ly of [212, 244, 276]) {
				for (let b = 0; b < 4; b++) {
					const a = phi + (b * Math.PI) / 2 + (ly === 244 ? Math.PI / 4 : 0);
					const x = 42 * Math.cos(a);
					const rect = `<rect class="jl__blade${Math.sin(a) < 0 ? ' jl__blade--back' : ''}" x="${(320 + Math.min(0, x)).toFixed(1)}" y="${ly - 7}" width="${Math.abs(x).toFixed(1)}" height="14" rx="1.5"/>`;
					(Math.sin(a) < 0 ? back : front).push(rect);
				}
			}
			html = back.join('') + front.join('');
			paddles.innerHTML = html;
			// swirling water
			swirlPhase += omega * dt * 0.5;
			for (const p of swirl) {
				const a = p.a + swirlPhase * p.k;
				const x = 320 + p.rx * Math.cos(a);
				const yy = p.y + 3 * Math.sin(a);
				p.el.setAttribute('cx', x.toFixed(1));
				p.el.setAttribute('cy', yy.toFixed(1));
				p.el.style.opacity = (0.25 + 0.35 * (Math.sin(a) > 0 ? 1 : 0.4)).toFixed(2);
			}
			// thermometer: 20…40 °C over 192 px
			const top = 266 - (Math.min(40, temp) - 20) * 9.6;
			col.setAttribute('y', top.toFixed(1));
			col.setAttribute('height', (286 - top).toFixed(1));
			tempT.textContent = `${fixed(temp, 2)} °C`;
			const warm = Math.min(1, (temp - 20) / 10);
			water.style.fill = `color-mix(in srgb, var(--ig-vy) ${Math.round(warm * 70)}%, var(--ig-vx))`;
		};

		const ease = (x: number) => (x < 0.1 ? (x * x) / 0.2 : x > 0.9 ? 0.9 - ((1 - x) * (1 - x)) / 0.2 : x - 0.05) / 0.9;
		const times = (k: number) =>
			`${k} ${k % 10 >= 2 && k % 10 <= 4 && (k % 100 < 12 || k % 100 > 14) ? 'раза' : 'раз'}`;

		let tPhase = 0;
		const frame = (dt: number) => {
			tt += dt;
			if (phase === 'fall') {
				tPhase += dt / (auto > 0 ? FALL * 0.6 : FALL);
				const prev = s;
				s = ease(Math.min(1, tPhase));
				const ds = s - prev;
				phi += (ds * H_PX) / DRUM_R;
				omega = dt > 0 ? (ds * H_PX) / DRUM_R / dt : omega;
				temp = tStart + dtDrop() * s;
				if (tPhase >= 1) {
					s = 1;
					phase = 'bottom';
					n += 1;
					temp = 20 + n * dtDrop();
					note.textContent = auto > 0 ? `Грузы опустились ${times(n)}` : `Грузы опустились ${times(n)}. Поднимите их снова`;
					writeFormula();
				}
			} else if (phase === 'rise') {
				tPhase += dt / (auto > 0 ? RISE * 0.6 : RISE);
				s = 1 - ease(Math.min(1, tPhase));
				omega *= Math.exp(-dt * 1.5);
				if (tPhase >= 1) {
					s = 0;
					phase = 'top';
					note.textContent = '';
				}
			} else {
				omega *= Math.exp(-dt * 1.5);
				if (Math.abs(omega) < 0.02) omega = 0;
			}
			if (auto > 0 && phase === 'bottom') startRise();
			else if (auto > 0 && phase === 'top') {
				auto -= 1;
				if (auto > 0) startFall();
			}
			draw(dt);
			buttons();
		};
		const wake = loop(root, frame, () => phase === 'fall' || phase === 'rise' || omega !== 0 || auto > 0);

		const startFall = () => {
			if (reduceMotion()) {
				n += 1;
				temp = 20 + n * dtDrop();
				s = 1;
				phase = 'bottom';
				writeFormula();
				note.textContent = `Грузы опустились ${times(n)}`;
				return;
			}
			phase = 'fall';
			tPhase = 0;
			tStart = temp;
			note.textContent = 'Грузы опускаются и вращают мешалку';
		};
		const startRise = () => {
			if (reduceMotion()) {
				s = 0;
				phase = 'top';
				return;
			}
			phase = 'rise';
			tPhase = 0;
			note.textContent = 'Мешалку отцепили, грузы поднимают — вода не нагревается';
		};

		dropB.addEventListener('click', () => {
			if (phase !== 'top') return;
			startFall();
			wake();
			frame(0);
		});
		liftB.addEventListener('click', () => {
			if (phase !== 'bottom') return;
			startRise();
			wake();
			frame(0);
		});
		autoB.addEventListener('click', () => {
			if (reduceMotion()) {
				if (phase === 'bottom') startRise();
				for (let i = 0; i < 10; i++) {
					startFall();
					startRise();
				}
				note.textContent = `Грузы опустились ${times(n)}`;
				frame(0);
				return;
			}
			auto = phase === 'bottom' ? 11 : 10;
			if (phase === 'top') startFall();
			else if (phase === 'bottom') startRise();
			wake();
		});
		resetB.addEventListener('click', () => {
			auto = 0;
			phase = 'top';
			s = 0;
			n = 0;
			temp = 20;
			omega = 0;
			note.textContent = '';
			writeFormula();
			frame(0);
		});
		const sliders = () => {
			if (n > 0 || phase !== 'top') resetB.click();
			const big = M();
			$<HTMLOutputElement>('[data-out-big]').value = `${big} кг`;
			$<HTMLOutputElement>('[data-out-w]').value = `${ru(mw(), 1)} кг`;
			$<SVGTextElement>('[data-wl-t]').textContent = `${ru(big / 2, 0)} кг`;
			$<SVGTextElement>('[data-wr-t]').textContent = `${ru(big / 2, 0)} кг`;
			writeFormula();
		};
		bigIn.addEventListener('input', sliders);
		wIn.addEventListener('input', sliders);
		let lastW = root.clientWidth;
		new ResizeObserver(() => {
			if (Math.abs(root.clientWidth - lastW) > 20) {
				lastW = root.clientWidth;
				writeFormula();
			}
		}).observe(root);
		sliders();
		frame(0);
		note.textContent = 'Нажмите «Отпустить грузы»';
	}
</script>
