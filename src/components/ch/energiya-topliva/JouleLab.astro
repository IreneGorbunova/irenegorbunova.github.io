		fill: var(--sl-color-white);
	}
	.jl__shaft {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.jl__blade {
		fill: var(--ig-v);
		stroke: color-mix(in srgb, var(--ig-v) 55%, black);
		stroke-width: 1;
	}
