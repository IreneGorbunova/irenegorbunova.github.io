		gap: 0.6rem 1.25rem;
		margin-top: 0.75rem;
	}
	.burn__buttons {
		display: flex;
		gap: 0.6rem;
	}
	.burn__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		padding: 0.5rem 1.2rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent);
