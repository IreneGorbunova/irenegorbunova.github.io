---
/**
 * Burning coal at the level of molecules (Пёрышкин, 8 класс): a carbon atom of the coal joins a molecule
 * of oxygen, and the new molecule of carbon dioxide flies off fast. In collisions it speeds up the other
 * molecules, so the gas gets hotter. 2D gas of hard discs with elastic collisions (masses 32 and 44);
 * the top is open: a molecule that leaves is replaced by a fresh cold O₂ from above. Temperature of the
 * gas ∝ mean kinetic energy of its molecules (20 °C at the start), smoothed over a few seconds.
 */
const W = 720;
const FY = 338; // floor line
const RC = 12; // carbon atom radius
const rowsN = [19, 16, 13, 10]; // a lump: every row 3 atoms shorter, hexagonal packing
const atoms = rowsN.flatMap((n, k) =>
	Array.from({ length: n }, (_, j) => ({ x: W / 2 - (n - 1) * 13 + 26 * j, y: FY - RC - 1 - k * 22.5, k })),
);
---

<figure class="burn not-content" data-burnlab>
	<p class="burn__eq">
		<span class="burn__sp">
			<svg viewBox="-13 -13 26 26" aria-hidden="true"><circle class="burn__c" r="11" /></svg><span>C</span>
		</span>
		<span class="burn__op">+</span>
		<span class="burn__sp">
			<svg viewBox="-20 -11 40 22" aria-hidden="true"><circle class="burn__o" cx="-6.5" r="9" /><circle class="burn__o" cx="6.5" r="9" /></svg><span>O<sub>2</sub></span>
		</span>
		<span class="burn__op">→</span>
		<span class="burn__sp">
			<svg viewBox="-27 -11 54 22" aria-hidden="true"
				><circle class="burn__o" cx="-15" r="9" /><circle class="burn__o" cx="15" r="9" /><circle class="burn__c" r="10" /></svg
			><span>CO<sub>2</sub></span>
		</span>
		<span class="burn__op">+</span>
		<b class="burn__en">энергия</b>
	</p>

	<div class="burn__stage">
		<svg viewBox={`0 0 ${W} 350`} class="burn__scene" role="img" aria-label="Модель: кусок угля из атомов углерода, над ним летают молекулы кислорода">
			<defs>
				<radialGradient id="burn-glow">
					<stop offset="0" stop-color="hsl(28, 100%, 55%)" stop-opacity="0.75" />
					<stop offset="0.55" stop-color="hsl(18, 100%, 50%)" stop-opacity="0.3" />
					<stop offset="1" stop-color="hsl(10, 100%, 45%)" stop-opacity="0" />
				</radialGradient>
				<radialGradient id="burn-flash">
					<stop offset="0" stop-color="hsl(50, 100%, 85%)" stop-opacity="1" />
					<stop offset="0.45" stop-color="hsl(35, 100%, 60%)" stop-opacity="0.75" />
					<stop offset="1" stop-color="hsl(20, 100%, 50%)" stop-opacity="0" />
				</radialGradient>
			</defs>
			<rect class="burn__heat" x="0" y="0" width={W} height={FY} data-heat />
			<ellipse class="burn__glow" cx={W / 2} cy={FY - 30} rx="310" ry="95" fill="url(#burn-glow)" data-glow />
			<g data-trails></g>
			<g data-coal>
				{
					atoms.map((a, i) => (
						<g class="burn__atom" data-i={i} data-x={a.x} data-y={a.y} data-k={a.k}>
							<circle class="burn__c" cx={a.x} cy={a.y} r={RC} />
							<text class="burn__letter" x={a.x} y={a.y + 4.5} text-anchor="middle">
								C
							</text>
						</g>
					))
				}
			</g>
			<line class="burn__floor" x1="0" y1={FY + 0.5} x2={W} y2={FY + 0.5} />
			<g class="burn__hatch">
				{Array.from({ length: 37 }, (_, i) => <line x1={i * 20 + 10} y1={FY + 2} x2={i * 20} y2={FY + 12} />)}
			</g>
			<g data-mols></g>
			<g data-flashes></g>
		</svg>
	</div>

	<div class="burn__bottom">
		<div class="burn__buttons">
			<button type="button" class="burn__btn" data-go>Поджечь</button>
			<button type="button" class="burn__btn burn__btn--ghost" data-reset>Сначала</button>
		</div>
		<div class="burn__read">
			<div class="burn__therm">
				<span>Температура газа</span>
				<span class="burn__bar" aria-hidden="true"><span data-bar></span></span>
				<output data-t hidden>20 °C</output>
			</div>
			<p class="burn__count">Образовалось молекул CO<sub>2</sub>: <output data-n>0</output></p>
		</div>
	</div>
	<p class="burn__live" aria-live="polite" data-live></p>
	<figcaption class="burn__cap">
		Это модель: атомы увеличены в миллионы раз, а их движение сильно замедлено. В настоящем угле есть ещё и водород, поэтому при горении образуется и вода.
	</figcaption>
</figure>

<style is:global>
	.burn {
		--burn-c: hsl(225, 9%, 50%);
		--burn-c-edge: hsl(225, 10%, 68%);
		--burn-ember: hsl(24, 95%, 56%);
		--burn-hot: hsl(22, 90%, 42%);
		margin-block: 1.5rem 2rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .burn {
		--burn-c: hsl(225, 10%, 27%);
		--burn-c-edge: hsl(225, 10%, 12%);
		--burn-ember: hsl(22, 95%, 50%);
		--burn-hot: hsl(16, 75%, 36%);
	}
	.burn__eq {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.2rem 0.6rem;
		margin: 0 0 0.6rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}
	.burn__sp {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		white-space: nowrap;
	}
	.burn__sp svg {
		height: 1.15em;
		width: auto;
		overflow: visible;
	}
	.burn__op {
		color: var(--sl-color-gray-3);
	}
	.burn__en {
		color: var(--ig-v);
	}
	.burn__stage {
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		overflow: hidden;
	}
	.burn__scene {
		display: block;
		width: 100%;
		height: auto;
	}
	.burn__c {
		fill: var(--burn-c);
		stroke: var(--burn-c-edge);
		stroke-width: 1.5;
	}
	.burn__o {
		fill: var(--ig-vy);
		stroke: color-mix(in srgb, var(--ig-vy) 60%, black);
		stroke-width: 1.5;
	}
	.burn__letter {
		font-size: 13px;
		font-weight: 700;
		fill: hsl(0, 0%, 100%);
		pointer-events: none;
	}
