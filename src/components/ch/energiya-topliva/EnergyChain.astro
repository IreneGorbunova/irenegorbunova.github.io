---
/**
 * Energy-flow diagram: choose a situation and watch energy flow from one form to the next.
 * Without JavaScript all situations are shown one under another.
 */
type Node = { t: string; d: string; k: 'p' | 'k' | 'u' | 'f' | 's' };
const scenes: { id: string; name: string; nodes: Node[]; note?: string }[] = [
	{
		id: 'fire',
		name: 'Костёр под котелком',
		nodes: [
			{ k: 'f', t: 'Энергия топлива', d: 'запасена в дровах и выделяется, когда они соединяются с кислородом воздуха' },
			{ k: 'u', t: 'Внутренняя энергия пламени', d: 'пламя — это очень горячие газы' },
			{ k: 'u', t: 'Внутренняя энергия котелка и воды', d: 'вода нагревается и закипает' },
		],
		note: 'Много энергии уходит и на нагревание воздуха вокруг: котелку достаётся только часть.',
	},
	{
		id: 'brake',
		name: 'Автомобиль тормозит',
		nodes: [
			{ k: 'k', t: 'Кинетическая энергия автомобиля', d: 'автомобиль едет' },
			{ k: 'u', t: 'Внутренняя энергия тормозов и шин', d: 'при трении тормозные колодки и диски сильно нагреваются' },
			{ k: 'u', t: 'Внутренняя энергия воздуха', d: 'горячие тормоза постепенно остывают, нагревая воздух' },
		],
	},
	{
		id: 'ball',
		name: 'Мяч падает на пол',
		nodes: [
			{ k: 'p', t: 'Потенциальная энергия мяча', d: 'мяч поднят над полом' },
			{ k: 'k', t: 'Кинетическая энергия мяча', d: 'при падении мяч разгоняется' },
			{ k: 'u', t: 'Внутренняя энергия мяча и пола', d: 'при ударе мяч и пол сжимаются и чуть-чуть нагреваются' },
		],
		note: 'Пока мяч прыгает, его энергия много раз переходит из потенциальной в кинетическую и обратно, и при каждом ударе часть её становится внутренней.',
	},
	{
		id: 'sun',
		name: 'От Солнца до печки',
		nodes: [
			{ k: 's', t: 'Энергия солнечного света', d: 'Солнце освещает и нагревает Землю' },
			{ k: 'f', t: 'Энергия каменного угля', d: 'древние растения на свету запасали энергию Солнца, а за миллионы лет их остатки превратились в уголь' },
			{ k: 'u', t: 'Внутренняя энергия печи и воздуха', d: 'уголь сгорает, и в доме становится тепло' },
		],
		note: 'Так что, сжигая дрова, уголь, нефть или газ, мы на самом деле используем энергию Солнца, запасённую очень давно.',
	},
	{
		id: 'meteor',
		name: 'Метеор',
		nodes: [
			{ k: 'k', t: 'Кинетическая энергия метеорного тела', d: 'камешек из космоса влетает в атмосферу со скоростью в десятки километров в секунду' },
			{ k: 'u', t: 'Внутренняя энергия тела и воздуха', d: 'тело тормозится о воздух, оно и воздух вокруг раскаляются и светятся — мы видим «падающую звезду»' },
		],
	},
];
const names: Record<Node['k'], string> = {
	p: 'потенциальная',
	k: 'кинетическая',
	u: 'внутренняя',
	f: '',
	s: '',
};
---

<figure class="ech not-content" data-ech>
	<div class="ech__chips" role="tablist" aria-label="Ситуация" hidden data-chips>
		{
			scenes.map((s, i) => (
				<button type="button" class="ech__chip" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-sc={s.id}>
					{s.name}
				</button>
			))
		}
	</div>
	{
		scenes.map((s) => (
			<div class="ech__scene" data-scene={s.id}>
				<p class="ech__name">{s.name}</p>
				<ol class="ech__flow">
					{s.nodes.map((n, i) => (
						<>
							{i > 0 && (
								<li class="ech__arrow" aria-hidden="true">
									<span />
								</li>
							)}
							<li class={`ech__node ech__node--${n.k}`} style={`--i:${i}`}>
								{names[n.k] && <span class="ech__kind">{names[n.k]}</span>}
								<span class="ech__t">{n.t}</span>
								<span class="ech__d">{n.d}</span>
							</li>
						</>
					))}
				</ol>
				{s.note && <p class="ech__note">{s.note}</p>}
			</div>
		))
	}
</figure>

<style is:global>
	.ech {
		margin-block: 1.5rem 2rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ech__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.9rem;
	}
	.ech__chips[hidden] {
		display: none;
	}
	.ech__chip {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.ech__chip[aria-selected='true'] {
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
		color: var(--sl-color-white);
	}
	.ech__scene + .ech__scene {
		margin-top: 1.2rem;
	}
	.ech.is-interactive .ech__scene {
		margin-top: 0;
	}
	.ech.is-interactive .ech__scene:not(.is-active) {
		display: none;
	}
	.ech.is-interactive .ech__name {
		display: none;
	}
	.ech__name {
		margin: 0 0 0.5rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.ech__flow {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: stretch;
		gap: 0;
	}
	.ech__node {
		--c: var(--ig-vy);
		flex: 1 1 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.6rem 0.7rem;
		border-radius: 0.75rem;
		border: 1.5px solid var(--c);
		background: color-mix(in srgb, var(--c) 12%, transparent);
	}
	.ech__node--p {
		--c: var(--ig-v);
	}
	.ech__node--k {
		--c: var(--ig-vx);
	}
	.ech__node--u {
		--c: var(--ig-vy);
	}
	.ech__node--f,
	.ech__node--s {
		--c: var(--sl-color-accent);
	}
	.ech__kind {
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--c);
		font-weight: 700;
	}
	.ech__t {
		font-weight: 700;
		color: var(--sl-color-white);
		line-height: 1.25;
	}
	.ech__d {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		line-height: 1.35;
	}
	.ech__arrow {
		flex: 0 0 2.6rem;
		margin: 0;
		display: grid;
		place-items: center;
	}
	.ech__arrow span {
		position: relative;
		display: block;
		width: 100%;
		height: 6px;
		background-image: radial-gradient(circle, var(--sl-color-gray-2) 2px, transparent 2.5px);
		background-size: 10px 6px;
		animation: ech-flow 0.8s linear infinite;
	}
	.ech__arrow span::after {
		content: '';
		position: absolute;
		right: -4px;
		top: 50%;
		transform: translateY(-50%);
		border: 7px solid transparent;
		border-left: 9px solid var(--sl-color-gray-2);
		border-right: 0;
	}
	@keyframes ech-flow {
		to {
			background-position: 10px 0;
		}
	}
	.ech.is-interactive .ech__scene.is-active .ech__node {
		animation: ech-in 0.5s ease-out both;
		animation-delay: calc(var(--i) * 0.35s);
	}
	@keyframes ech-in {
		from {
			opacity: 0;
			transform: translateY(0.4rem) scale(0.97);
		}
	}
	.ech__note {
		margin: 0.7rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	@media (max-width: 40rem) {
		.ech {
			padding: 0.75rem 0.6rem;
		}
		.ech__flow {
			flex-direction: column;
		}
		.ech__arrow {
			flex-basis: 2rem;
		}
		.ech__arrow span {
			width: 6px;
			height: 1.6rem;
			background-size: 6px 10px;
			animation-name: ech-flow-v;
		}
		.ech__arrow span::after {
			right: auto;
			left: 50%;
			top: auto;
			bottom: -6px;
			transform: translateX(-50%);
			border: 7px solid transparent;
			border-top: 9px solid var(--sl-color-gray-2);
			border-bottom: 0;
		}
	}
	@keyframes ech-flow-v {
		to {
			background-position: 0 10px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ech__arrow span,
		.ech.is-interactive .ech__scene.is-active .ech__node {
			animation: none;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-ech]')) {
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.ech__chip'));
		const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
		const show = (id: string) => {
			chips.forEach((c) => c.setAttribute('aria-selected', String(c.dataset.sc === id)));
			scenes.forEach((s) => s.classList.toggle('is-active', s.dataset.scene === id));
		};
		root.querySelector<HTMLElement>('[data-chips]')!.hidden = false;
		root.classList.add('is-interactive');
		chips.forEach((c) => c.addEventListener('click', () => show(c.dataset.sc!)));
		show(chips[0].dataset.sc!);
	}
</script>
