</style>

<script>
	import { WIRE, resistance } from './wire';
	import { ru, fixed, sig, tsig, rounded, renderTex, c, themeColours } from './et';

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const H = 200; // canvas height, CSS px
	const Q0 = 0.1; // charge of one dot, Кл
	const LAMBDA = 0.6; // dots per px of length for S = 1 mm² (∝ S)
	const VTH = 75; // speed of the chaotic motion, px/s (shown slowly on purpose)
	const AMP = 11; // how far an electron wanders from its «average» place, px
	const ION_GAP = 20; // lattice spacing, px
	const DEG = Math.PI / 180;
	const meterAngle = (v: number, max: number) => -50 + 100 * Math.min(Math.max(v / max, 0), 1.04);

	type El = { gx: number; fy: number; ox: number; oy: number; vx: number; vy: number; next: number; flash: number };
	type Ion = { x: number; y: number; ph: number; alt: boolean };

	for (const root of document.querySelectorAll<HTMLElement>('[data-wl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const canvas = $<HTMLCanvasElement>('[data-canvas]');
		const ctx = canvas.getContext('2d')!;
		const uIn = $<HTMLInputElement>('[data-u]');
		const lIn = $<HTMLInputElement>('[data-l]');
		const sIn = $<HTMLInputElement>('[data-s]');
		const formula = $<HTMLElement>('[data-formula]');
		const live = $<HTMLElement>('[data-live]');
		const keyBtn = $<HTMLButtonElement>('[data-key-btn]');
		const lever = $<SVGLineElement>('[data-lever]');
		const needleA = $<SVGLineElement>('[data-needle-a]');
		const needleV = $<SVGLineElement>('[data-needle-v]');
		const readI = $<SVGTextElement>('[data-read-i]');
		const readU = $<SVGTextElement>('[data-read-u]');
		const ct = $<HTMLElement>('[data-ct]');
		const cq = $<HTMLElement>('[data-cq]');
		const ci = $<HTMLElement>('[data-ci]');
		const mats = [...root.querySelectorAll<HTMLButtonElement>('[data-mat]')];

		let mat = WIRE.defaultMaterial;
		let closed = false;
		let W = 560;
		let hNow = 0; // drawn tube height, eases to the target
		let els: El[] = [];
		let ions: Ion[] = [];
		let count = 0;
		let tRun = 0;
		let col: Record<string, string> = {};
		const needle = { a: { ang: -50, w: 0 }, v: { ang: -50, w: 0 } };

		const state = () => {
			const U = Number(uIn.value);
			const l = Number(lIn.value);
			const S = Number(sIn.value);
			const rho = WIRE.materials[mat].rho;
			const R = resistance(rho, l, S);
			const Iwould = U / R;
			const over = closed && Iwould > WIRE.IMAX;
			const I = closed && !over ? Iwould : 0;
			return { U, l, S, rho, R, Iwould, over, I, Uv: closed && !over ? U : 0 };
		};

		const tubeH = (S: number) => 70 * Math.sqrt(S / 0.5);

		const buildIons = () => {
			const h = tubeH(Number(sIn.value));
			const rows = Math.max(1, Math.floor((h - 10) / ION_GAP));
			ions = [];
			let seed = 7;
			const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
			for (let x = ION_GAP / 2 - 20; x < W + 20; x += ION_GAP)
				for (let r = 0; r < rows; r++) ions.push({ x, y: (r - (rows - 1) / 2) * ION_GAP, ph: rnd() * 6.28, alt: rnd() < 0.4 });
		};

		const buildElectrons = () => {
			const S = Number(sIn.value);
			const span = W + 40;
			const n = Math.round(LAMBDA * S * span);
			els = Array.from({ length: n }, (_, k) => {
				const a = Math.random() * 6.283;
				return {
					gx: -20 + ((k + 0.2 + 0.6 * Math.random()) / n) * span,
					fy: Math.random() * 2 - 1,
					ox: (Math.random() * 2 - 1) * AMP,
					oy: (Math.random() * 2 - 1) * AMP,
					vx: VTH * Math.cos(a),
					vy: VTH * Math.sin(a),
					next: Math.random() * 0.3,
					flash: 0,
				};
			});
		};

		const resetCounter = () => {
			count = 0;
			tRun = 0;
			showCounter();
		};
		const showCounter = () => {
			ct.textContent = `${fixed(tRun, 1)} с`;
			cq.textContent = `${fixed(count * Q0, 1)} Кл`;
			ci.textContent = tRun >= 1 ? `${sig(count * Q0 / tRun, 3)} А` : '—';
		};

		const resize = () => {
			const w = Math.round(canvas.clientWidth);
			if (!w) return;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(w * dpr);
			canvas.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			if (w !== W || !els.length) {
				W = w;
				buildIons();
				buildElectrons();
			}
		};

		const update = (resetCount = true) => {
			const s = state();
			root.querySelector('[data-u-out]')!.textContent = `${ru(s.U, 1)} В`;
			root.querySelector('[data-l-out]')!.textContent = `${ru(s.l, 1)} м`;
			root.querySelector('[data-s-out]')!.innerHTML = `${ru(s.S, 1)} мм²`;
			root.classList.toggle('is-on', s.I > 0);
			root.classList.toggle('is-over', s.over);
			keyBtn.textContent = closed ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			lever.style.transform = closed ? '' : `rotate(-28deg)`;
			lever.style.transformOrigin = `${lever.x1.baseVal.value}px ${lever.y1.baseVal.value}px`;
			readI.textContent = s.over ? '0 А' : `${s.I === 0 ? '0' : sig(s.I, 3)} А`;
			readU.textContent = `${ru(s.Uv, 1)} В`;
			const rhoU = '\\text{Ом}\\cdot\\text{мм}^2/\\text{м}';
			const Rline = `${c('r', 'R')} &= \\frac{\\rho l}{S} = \\frac{${tsig(s.rho, 2)}~${rhoU}\\cdot ${tsig(s.l)}~\\text{м}}{${tsig(s.S)}~\\text{мм}^2} ${rounded(s.R) ? '\\approx' : '='} ${tsig(s.R)}~\\text{Ом}`;
			let Iline: string;
			if (!closed) Iline = `${c('i', 'I')} &= 0 \\quad \\text{(ключ разомкнут)}`;
			else if (s.over) Iline = `${c('i', 'I')} &= \\frac{${c('u', 'U')}}{${c('r', 'R')}} \\approx ${tsig(s.Iwould)}~\\text{А} > 3~\\text{А}\\ \\text{!}`;
			else
				Iline = `${c('i', 'I')} &= \\frac{${c('u', 'U')}}{${c('r', 'R')}} = \\frac{${tsig(s.U)}~\\text{В}}{${tsig(s.R)}~\\text{Ом}} ${rounded(s.U / s.R) || rounded(s.R) ? '\\approx' : '='} ${s.I === 0 ? '0' : tsig(s.I)}~\\text{А}`;
			renderTex(formula, `\\begin{aligned} ${Rline} \\\\ ${Iline} \\end{aligned}`);
			if (s.over)
				live.textContent = `Сработала защита источника! Сопротивление проволоки всего ${sig(s.R, 2)} Ом, и сила тока получилась бы около ${sig(s.Iwould, 2)} А — проволока и источник сильно нагрелись бы. Возьмите проволоку длиннее, тоньше или из другого вещества либо уменьшите напряжение.`;
			else if (!closed) live.textContent = 'Ключ разомкнут: тока нет, электроны движутся только беспорядочно.';
			else if (s.U === 0) live.textContent = 'Напряжение равно нулю: электрическое поле не действует на электроны, и тока нет.';
			else live.textContent = `Ток идёт. Электроны дрейфуют справа налево — навстречу направлению тока.`;
			if (resetCount) resetCounter();
		};

		const toggleKey = () => {
			closed = !closed;
			update();
			kick();
		};
		keyBtn.addEventListener('click', toggleKey);
		$('[data-key]').addEventListener('click', toggleKey);
		$('[data-reset]').addEventListener('click', () => resetCounter());
		uIn.addEventListener('input', () => (update(), kick()));
		lIn.addEventListener('input', () => (update(), kick()));
		sIn.addEventListener('input', () => {
			buildIons();
			buildElectrons();
			update();
			kick();
		});
		mats.forEach((b) =>
			b.addEventListener('click', () => {
				mat = Number(b.dataset.mat);
				mats.forEach((m) => m.setAttribute('aria-checked', String(m === b)));
				update();
				kick();
			}),
		);

		const step = (dt: number) => {
			const s = state();
			const S = s.S;
			const h = tubeH(S);
			hNow = hNow ? hNow + (h - hNow) * Math.min(1, dt / 0.15) : h;
			const drift = s.I / (Q0 * LAMBDA * S); // px/s: flux = λ S v = I / Q0
			const rho = s.rho;
			const tau = 0.06 + 0.25 / (1 + 4 * rho); // time between collisions: shorter in alloys
			const vth = reduceMotion.matches ? 0 : VTH;
			const xs = W / 2;
			const span = W + 40;
			for (const e of els) {
				const before = e.gx;
				e.gx -= drift * dt;
				if (before >= xs && e.gx < xs) {
					count += 1;
					e.flash = 0.45;
				}
				if (e.gx < -20) {
					e.gx += span;
					e.fy = Math.random() * 2 - 1;
				}
				e.flash = Math.max(0, e.flash - dt);
				if (!vth) continue;
				e.next -= dt;
				if (e.next <= 0) {
					const a = Math.random() * 6.283;
					e.vx = vth * Math.cos(a);
					e.vy = vth * Math.sin(a);
					e.next = tau * (0.4 + 1.2 * Math.random());
				}
				e.ox += e.vx * dt;
				e.oy += e.vy * dt;
				if (Math.abs(e.ox) > AMP) (e.ox = Math.sign(e.ox) * AMP), (e.vx = -e.vx);
				if (Math.abs(e.oy) > AMP) (e.oy = Math.sign(e.oy) * AMP), (e.vy = -e.vy);
			}
			if (s.I > 0) tRun += dt;
		};

		let frame = 0;
		const draw = (time: number) => {
			if (frame++ % 30 === 0)
				col = themeColours(root, ['--ig-vx', '--ig-vy', '--ig-v', '--sl-color-gray-2', '--sl-color-gray-3', '--sl-color-gray-5', '--sl-color-gray-6', '--sl-color-white', '--sl-color-black', '--sl-color-green-high', '--ig-font-math']);
			const s = state();
			const cy = H / 2 + 8;
			const h = hNow;
			const top = cy - h / 2;
			ctx.clearRect(0, 0, W, H);
			// tube
			const g = ctx.createLinearGradient(0, top, 0, top + h);
			g.addColorStop(0, col['--sl-color-gray-5']);
			g.addColorStop(0.35, col['--sl-color-gray-6']);
			g.addColorStop(1, col['--sl-color-gray-6']);
			ctx.globalAlpha = 0.9;
			ctx.fillStyle = g;
			ctx.fillRect(-2, top, W + 4, h);
			ctx.globalAlpha = 1;
			ctx.strokeStyle = col['--sl-color-gray-3'];
			ctx.lineWidth = 1.5;
			ctx.beginPath();
			ctx.moveTo(0, top);
			ctx.lineTo(W, top);
			ctx.moveTo(0, top + h);
			ctx.lineTo(W, top + h);
			ctx.stroke();
			// ions of the lattice: vibrate about their places
			const alloy = WIRE.materials[mat].alloy;
			const amp = reduceMotion.matches ? 0 : 1.2;
			const scaleY = (h - 10) / (tubeH(s.S) - 10 || 1);
			for (const ion of ions) {
				const y = cy + ion.y * scaleY;
				if (Math.abs(y - cy) > h / 2 - 5) continue;
				const x = ion.x + amp * Math.sin(time * 0.013 + ion.ph);
				const yy = y + amp * Math.cos(time * 0.011 + ion.ph * 1.7);
				const big = !(alloy && ion.alt);
				const r = big ? 5.2 : 3.8;
				ctx.beginPath();
				ctx.arc(x, yy, r, 0, 6.283);
				ctx.fillStyle = big ? col['--ig-vy'] : col['--ig-v'];
				ctx.globalAlpha = 0.28;
				ctx.fill();
				ctx.globalAlpha = 0.8;
				ctx.strokeStyle = big ? col['--ig-vy'] : col['--ig-v'];
				ctx.lineWidth = 1.2;
				ctx.stroke();
				if (big) {
					ctx.beginPath();
					ctx.moveTo(x - 2.4, yy);
					ctx.lineTo(x + 2.4, yy);
					ctx.moveTo(x, yy - 2.4);
					ctx.lineTo(x, yy + 2.4);
					ctx.lineWidth = 1.1;
					ctx.stroke();
				}
				ctx.globalAlpha = 1;
			}
			// the cross-section with the counter
			const xs = W / 2;
			ctx.beginPath();
			ctx.ellipse(xs, cy, Math.max(6, h * 0.16), h / 2 + 5, 0, 0, 6.283);
			ctx.fillStyle = col['--sl-color-green-high'];
			ctx.globalAlpha = 0.1;
			ctx.fill();
			ctx.globalAlpha = 0.85;
			ctx.strokeStyle = col['--sl-color-green-high'];
			ctx.lineWidth = 2;
			ctx.setLineDash([5, 4]);
			ctx.stroke();
			ctx.setLineDash([]);
			ctx.globalAlpha = 1;
			// electrons
			const lo = top + 3;
			const hi = top + h - 3;
			for (const e of els) {
				const x = e.gx + e.ox;
				let y = cy + e.fy * (h / 2 - 6) + e.oy;
				if (y < lo) y = 2 * lo - y;
				if (y > hi) y = 2 * hi - y;
				y = Math.min(Math.max(y, lo), hi);
				ctx.beginPath();
				if (e.flash > 0) {
					ctx.arc(x, y, 2.2 + 3 * e.flash, 0, 6.283);
					ctx.fillStyle = col['--sl-color-green-high'];
				} else {
					ctx.arc(x, y, 2.3, 0, 6.283);
					ctx.fillStyle = col['--ig-vx'];
				}
				ctx.fill();
			}
			// labels
			ctx.font = `600 13px ${getComputedStyle(root).fontFamily}`;
			ctx.textBaseline = 'alphabetic';
			ctx.fillStyle = col['--sl-color-white'];
			ctx.textAlign = 'left';
			ctx.fillText(WIRE.materials[mat].name, 10, 18);
			ctx.textAlign = 'center';
			ctx.fillStyle = col['--sl-color-green-high'];
			ctx.fillText('сечение', xs, Math.max(14, top - 10));
			if (s.I > 0) {
				// current direction (right) and electron drift (left)
				const yA = H - 8;
				ctx.strokeStyle = col['--ig-vx'];
				ctx.fillStyle = col['--ig-vx'];
				ctx.lineWidth = 2;
				ctx.textAlign = 'right';
				ctx.font = `13px ${getComputedStyle(root).fontFamily}`;
				const xr = W - 12;
				ctx.beginPath();
				ctx.moveTo(xr - 46, yA - 4);
				ctx.lineTo(xr, yA - 4);
				ctx.stroke();
				ctx.beginPath();
				ctx.moveTo(xr + 2, yA - 4);
				ctx.lineTo(xr - 7, yA - 9);
				ctx.lineTo(xr - 7, yA + 1);
				ctx.fill();
				ctx.font = `italic 17px ${col['--ig-font-math'] ?? 'KaTeX_Math, serif'}`;
				ctx.fillText('I', xr - 52, yA);
				ctx.textAlign = 'left';
				ctx.font = `13px ${getComputedStyle(root).fontFamily}`;
				ctx.beginPath();
				ctx.moveTo(14, yA - 4);
				ctx.lineTo(56, yA - 4);
				ctx.stroke();
				ctx.beginPath();
				ctx.moveTo(10, yA - 4);
				ctx.lineTo(19, yA - 9);
				ctx.lineTo(19, yA + 1);
				ctx.fill();
				ctx.fillText('дрейф электронов', 62, yA);
			}
		};

		const meters = (dt: number) => {
			const s = state();
			const goals = { a: meterAngle(s.I, WIRE.IMAX), v: meterAngle(s.Uv, WIRE.UMAX) };
			let moving = false;
			for (const k of ['a', 'v'] as const) {
				const n = needle[k];
				if (reduceMotion.matches) {
					n.ang = goals[k];
					n.w = 0;
				} else {
					const acc = 140 * (goals[k] - n.ang) - 16 * n.w; // damped like a real pointer meter
					n.w += acc * dt;
					n.ang += n.w * dt;
				}
				if (Math.abs(goals[k] - n.ang) > 0.05 || Math.abs(n.w) > 0.05) moving = true;
				const el = k === 'a' ? needleA : needleV;
				const x1 = el.x1.baseVal.value;
				const y1 = el.y1.baseVal.value;
				const len = Math.hypot(el.x2.baseVal.value - x1, el.y2.baseVal.value - y1);
				el.setAttribute('x2', String(x1 + len * Math.sin(n.ang * DEG)));
				el.setAttribute('y2', String(y1 - len * Math.cos(n.ang * DEG)));
			}
			return moving;
		};

		let visible = false;
		let raf = 0;
		let last = 0;
		let lastShown = -1;
		const loop = (time: number) => {
			const dt = Math.min(0.05, last ? (time - last) / 1000 : 0.016);
			last = time;
			step(dt);
			draw(time);
			meters(dt);
			if (Math.floor(tRun * 10) !== lastShown) {
				lastShown = Math.floor(tRun * 10);
				showCounter();
			}
			raf = visible ? requestAnimationFrame(loop) : 0;
		};
		const kick = () => {
			if (!raf && visible) {
				last = 0;
				raf = requestAnimationFrame(loop);
			}
		};

		new ResizeObserver(() => {
			resize();
			draw(performance.now());
		}).observe(canvas);
		new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting;
			kick();
		}).observe(root);
		resize();
		update();
		draw(0);
	}
</script>
