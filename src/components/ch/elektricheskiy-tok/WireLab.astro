		--wl-i: var(--ig-vx);
		--wl-u: var(--ig-vy);
		--wl-r: var(--ig-v);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
