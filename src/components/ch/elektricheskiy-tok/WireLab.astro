---
/**
 * Main model of the chapter: a wire «under a microscope» inside a simple circuit.
 * Top: the circuit diagram — a regulated source, a key, an ammeter in series and a voltmeter in parallel
 * with the wire. Bottom: the inside of the wire on a canvas — ions of the crystal lattice vibrate in place,
 * free electrons move chaotically and, when the key is closed, also drift against the current.
 * A charge counter at a cross-section counts the electrons (each dot stands for 0,1 Кл) and gives I = q/t.
 * Physics kept true: R = ρl/S, I = U/R; the number of dots per unit length is proportional to S, the drift
 * speed to I/S, so the dot flux through the section is exactly proportional to I.
 */
import { WIRE } from './wire';

const ang = (k: number, n: number) => ((-50 + (100 * k) / n) * Math.PI) / 180;
/** A meter dial: scale arc of ±50° above a pivot placed below the centre. */
const dial = (cx: number, cy: number, r: number, n: number, majorEvery: number) => {
	const py = cy + 0.42 * r;
	const ra = 0.95 * r;
	const ticks = Array.from({ length: n + 1 }, (_, k) => {
		const a = ang(k, n);
		const major = k % majorEvery === 0;
		const r1 = ra * (major ? 0.8 : 0.88);
		return { x1: cx + r1 * Math.sin(a), y1: py - r1 * Math.cos(a), x2: cx + ra * Math.sin(a), y2: py - ra * Math.cos(a), major };
	});
	const a0 = ang(0, n);
	const arc = `M ${cx + ra * Math.sin(a0)} ${py - ra * Math.cos(a0)} A ${ra} ${ra} 0 0 1 ${cx - ra * Math.sin(a0)} ${py - ra * Math.cos(a0)}`;
	return { cx, py, len: 0.9 * ra, ticks, arc };
};
const S = { XL: 30, XR: 530, YT: 104, YB: 186, XP: 100, XM: 112, XK1: 196, XK2: 246, XA: 404, RA: 27, XV: 280, YV: 42, RV: 27, XN1: 160, XN2: 404, X1: 206, X2: 354 };
const am = dial(S.XA, S.YB, S.RA, 12, 4);
const vm = dial(S.XV, S.YV, S.RV, 12, 2);
---

<figure class="wl not-content" data-wl>
	<svg class="wl__scheme" viewBox="0 0 560 222" role="img" aria-label="Схема цепи: источник, ключ, амперметр и проволока соединены последовательно, вольтметр подключён параллельно проволоке">
		<g class="wl__wires">
			<path d={`M ${S.XP} ${S.YB} H ${S.XL} V ${S.YT} H ${S.X1}`}></path>
			<path d={`M ${S.X2} ${S.YT} H ${S.XR} V ${S.YB} H ${S.XA + S.RA}`}></path>
			<path d={`M ${S.XA - S.RA} ${S.YB} H ${S.XK2}`}></path>
			<path d={`M ${S.XK1} ${S.YB} H ${S.XM}`}></path>
			<path d={`M ${S.XN1} ${S.YT} V ${S.YV} H ${S.XV - S.RV}`}></path>
			<path d={`M ${S.XV + S.RV} ${S.YV} H ${S.XN2} V ${S.YT}`}></path>
		</g>
		<path class="wl__flow" d={`M ${S.XP} ${S.YB} H ${S.XL} V ${S.YT} H ${S.XR} V ${S.YB} H ${S.XM}`} data-flow></path>
		<circle class="wl__node" cx={S.XN1} cy={S.YT} r="4.5"></circle>
		<circle class="wl__node" cx={S.XN2} cy={S.YT} r="4.5"></circle>

		<!-- the wire, drawn as a resistor -->
		<rect class="wl__res" x={S.X1} y={S.YT - 12} width={S.X2 - S.X1} height="24" rx="2"></rect>
		<g class="wl__lens" transform={`translate(${(S.X1 + S.X2) / 2} ${S.YT})`}>
			<circle r="7" cx="-3" cy="-1"></circle>
			<line x1="2" y1="4" x2="8" y2="10"></line>
		</g>
		<text class="wl__cap" x={(S.X1 + S.X2) / 2} y={S.YT + 30} text-anchor="middle">проволока</text>

		<!-- source -->
		<rect class="wl__bg" x={S.XP - 5} y={S.YB - 24} width={S.XM - S.XP + 10} height="48"></rect>
		<line class="wl__plate" x1={S.XP} y1={S.YB - 21} x2={S.XP} y2={S.YB + 21}></line>
		<line class="wl__plate wl__plate--minus" x1={S.XM} y1={S.YB - 10} x2={S.XM} y2={S.YB + 10}></line>
		<text class="wl__sign" x={S.XP - 11} y={S.YB - 26} text-anchor="middle">+</text>
		<text class="wl__sign" x={S.XM + 11} y={S.YB - 26} text-anchor="middle">−</text>
		<text class="wl__cap" x={(S.XP + S.XM) / 2} y={S.YB + 34} text-anchor="middle">источник</text>

		<!-- key -->
		<g class="wl__key" data-key>
			<rect class="wl__hit" x={S.XK1 - 12} y={S.YB - 42} width={S.XK2 - S.XK1 + 24} height="58"></rect>
			<line class="wl__lever" x1={S.XK1} y1={S.YB} x2={S.XK2} y2={S.YB} data-lever></line>
			<circle class="wl__contact" cx={S.XK1} cy={S.YB} r="4"></circle>
			<circle class="wl__contact" cx={S.XK2} cy={S.YB} r="4"></circle>
		</g>
		<text class="wl__cap" x={(S.XK1 + S.XK2) / 2} y={S.YB + 34} text-anchor="middle">ключ</text>

		<!-- ammeter -->
		<g class="wl__meter wl__meter--a">
			<circle class="wl__face" cx={S.XA} cy={S.YB} r={S.RA}></circle>
			<path class="wl__arc" d={am.arc}></path>
			{am.ticks.map((t) => <line class={t.major ? 'wl__tick wl__tick--major' : 'wl__tick'} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
			<line class="wl__needle" x1={S.XA} y1={am.py} x2={S.XA} y2={am.py - am.len} data-needle-a></line>
			<circle class="wl__pivot" cx={S.XA} cy={am.py} r="2.6"></circle>
			<text class="wl__letter" x={S.XA} y={S.YB + 20} text-anchor="middle">A</text>
			<text class="wl__pm" x={S.XA + S.RA + 7} y={S.YB - 9} text-anchor="middle">+</text>
			<text class="wl__pm" x={S.XA - S.RA - 7} y={S.YB - 9} text-anchor="middle">−</text>
		</g>
		<text class="wl__read wl__read--i" x={S.XA} y={S.YB - S.RA - 10} text-anchor="middle" data-read-i>0 А</text>

		<!-- voltmeter -->
		<g class="wl__meter wl__meter--v">
			<circle class="wl__face" cx={S.XV} cy={S.YV} r={S.RV}></circle>
			<path class="wl__arc" d={vm.arc}></path>
			{vm.ticks.map((t) => <line class={t.major ? 'wl__tick wl__tick--major' : 'wl__tick'} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
			<line class="wl__needle" x1={S.XV} y1={vm.py} x2={S.XV} y2={vm.py - vm.len} data-needle-v></line>
			<circle class="wl__pivot" cx={S.XV} cy={vm.py} r="2.6"></circle>
			<text class="wl__letter" x={S.XV} y={S.YV + 20} text-anchor="middle">V</text>
			<text class="wl__pm" x={S.XV - S.RV - 7} y={S.YV - 9} text-anchor="middle">+</text>
			<text class="wl__pm" x={S.XV + S.RV + 7} y={S.YV - 9} text-anchor="middle">−</text>
		</g>
		<text class="wl__read wl__read--u" x={S.XV - S.RV - 20} y={S.YV - 13} text-anchor="end" data-read-u>0 В</text>

		<!-- current direction -->
		<g class="wl__dir" data-dir>
			<line x1={S.XL + 14} y1={164} x2={S.XL + 14} y2={128}></line>
			<path d={`M ${S.XL + 8} ${133} L ${S.XL + 14} ${122} L ${S.XL + 20} ${133} z`}></path>
			<text x={S.XL + 24} y={152}>I</text>
		</g>
	</svg>

	<div class="wl__zoom">
		<canvas class="wl__canvas" data-canvas aria-label="Проволока изнутри: ионы кристаллической решётки и свободные электроны"></canvas>
		<div class="wl__counter" aria-live="off">
			<span class="wl__cnt-title">Счётчик у сечения</span>
			<span class="wl__cnt"><span class="wl__cnt-k">время <i>t</i></span><b data-ct>0,0 с</b></span>
			<span class="wl__cnt"><span class="wl__cnt-k">прошёл заряд <i>q</i></span><b class="et-q" data-cq>0,0 Кл</b></span>
			<span class="wl__cnt"><span class="wl__cnt-k"><i>q</i>&thinsp;/&thinsp;<i>t</i></span><b class="et-i" data-ci>—</b></span>
		</div>
	</div>

	<div class="wl__buttons">
		<button type="button" class="wl__btn wl__btn--primary" data-key-btn>Замкнуть ключ</button>
		<button type="button" class="wl__btn wl__btn--quiet" data-reset>Сбросить счётчик</button>
	</div>

	<div class="wl__mats" role="radiogroup" aria-label="Вещество проволоки" data-mats>
		{
			WIRE.materials.map((m, k) => (
				<button type="button" class="wl__mat" role="radio" aria-checked={k === WIRE.defaultMaterial ? 'true' : 'false'} data-mat={k}>
					{m.name}
				</button>
			))
		}
	</div>

	<div class="wl__controls">
		<label class="wl__slider wl__slider--u">
			<span>Напряжение источника <i>U</i></span>
			<output data-u-out></output>
			<input type="range" min="0" max={WIRE.UMAX} step="0.5" value={WIRE.U0} data-u />
		</label>
		<label class="wl__slider wl__slider--r">
			<span>Длина проволоки <i>l</i></span>
			<output data-l-out></output>
			<input type="range" min="0.5" max="10" step="0.5" value={WIRE.L0} data-l />
		</label>
		<label class="wl__slider wl__slider--r">
			<span>Площадь сечения <i>S</i></span>
			<output data-s-out></output>
			<input type="range" min="0.2" max="1.5" step="0.1" value={WIRE.S0} data-s />
		</label>
	</div>

	<div class="wl__formula" data-formula></div>
	<p class="wl__live" data-live aria-live="polite"></p>

	<figcaption class="wl__legend">
		Внизу — кусочек проволоки «под микроскопом». Кружки «+» — ионы кристаллической решётки (в сплавах — ионы двух разных металлов), точки — свободные
		электроны. Ток <i>I</i> направлен слева направо, электроны дрейфуют справа налево. Каждая точка изображает заряд
		0,1 Кл — огромное число электронов. Скорости показаны условно: на самом деле беспорядочное движение электронов
		в миллиарды раз быстрее их упорядоченного движения, которое составляет доли миллиметра в секунду. Ключ можно нажимать
		прямо на схеме.
	</figcaption>
</figure>

<style is:global>
