---
/**
 * «Металл изнутри»: a piece of metal with a regular crystal lattice of positive ions and as many free
 * electrons (each ion here has given away one electron, so the piece is neutral). The ions vibrate about
 * their places with an amplitude ∝ √T (T in kelvins; at 1000 °C the r.m.s. displacement is about 10 % of the
 * spacing, close to the melting point of copper); the electrons fly in straight lines and bounce off the ions
 * and off the surface of the crystal (a line through the outer ions), like gas molecules in a vessel. No field, no drift. One electron leaves a trail.
 */
---

<figure class="mlat not-content" data-mlat>
	<canvas class="mlat__canvas" data-canvas role="img" aria-label="Кусок металла изнутри: ионы в узлах кристаллической решётки и свободные электроны между ними"></canvas>
	<ul class="mlat__keys">
		<li><span class="mlat__sym mlat__sym--p">+</span> ион (+)</li>
		<li><span class="mlat__sym mlat__sym--n">−</span> свободный электрон (−)</li>
		<li>
			<svg class="mlat__grid" viewBox="0 0 20 20" aria-hidden="true"><path d="M 4 4 H 16 M 4 10 H 16 M 4 16 H 16 M 4 4 V 16 M 10 4 V 16 M 16 4 V 16"></path></svg>
			кристаллическая решётка
		</li>
	</ul>
	<label class="mlat__slider">
		<span>Температура</span>
		<output data-t-out>20 °C</output>
		<input type="range" min="-200" max="1000" step="10" value="20" data-t />
	</label>
	<div class="mlat__chips" aria-live="off">
		<span class="mlat__chip">ионов: <b class="mlat__p" data-n-ion>0</b></span>
		<span class="mlat__chip">свободных электронов: <b class="mlat__n" data-n-el>0</b></span>
		<span class="mlat__chip">заряд всего куска: <b>0</b></span>
	</div>
	<p class="mlat__live" data-live aria-live="polite"></p>
	<figcaption class="mlat__legend">
		Каждый ион здесь отдал один электрон, поэтому свободных электронов столько же, сколько ионов. Положительный заряд ионов
		и отрицательный заряд электронов равны, и кусок металла в целом не заряжен. Ионы колеблются около узлов решётки, а
		электроны летают между ними и отскакивают, как молекулы газа в сосуде. За одним электроном тянется след. Размеры и
		скорости показаны условно.
	</figcaption>
</figure>

<style is:global>
	.mlat {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.mlat__canvas {
		display: block;
		width: 100%;
		height: 250px;
		border-radius: 0.75rem;
		background: var(--sl-color-black);
	}
	.mlat__keys {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.1rem;
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.mlat__keys li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
	}
	.mlat__sym {
		display: inline-grid;
		place-items: center;
		border-radius: 50%;
		color: var(--sl-color-black);
		font-weight: 700;
		line-height: 1;
	}
	.mlat__sym--p {
		width: 1.25rem;
		height: 1.25rem;
		background: var(--ig-vy);
	}
	.mlat__sym--n {
		width: 0.95rem;
		height: 0.95rem;
		font-size: 0.8em;
		background: var(--ig-vx);
	}
	.mlat__grid {
		width: 1.25rem;
		height: 1.25rem;
	}
	.mlat__grid path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-dasharray: 2 2;
	}
	.mlat__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		max-width: 26rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.mlat__slider output {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--sl-color-orange-high);
	}
	.mlat__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--sl-color-orange);
	}
	.mlat__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.mlat__chip {
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		font-variant-numeric: tabular-nums;
	}
	.mlat__chip b {
		color: var(--sl-color-white);
	}
	.mlat__chip b.mlat__p {
		color: var(--ig-vy);
	}
	.mlat__chip b.mlat__n {
		color: var(--ig-vx);
	}
	.mlat__live {
		min-height: 1.5em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	.mlat__legend {
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		line-height: 1.55;
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.mlat {
			padding: 0.75rem;
		}
		.mlat__live {
			min-height: 3em;
		}
	}
</style>

<script>
	import { colours, drawCharge, fitCanvas, rng, runWhileVisible, type Colours } from './tokParticles';

	const H = 250; // canvas height, CSS px
	const PAD = 10; // the piece of metal is inset by PAD
	const G0 = 54; // smallest lattice spacing, px
	const M = 24; // from the wall to the centres of the outer ions (room for their vibration)
	const EOUT = 3; // electrons stay within the outer rows of ions, at most EOUT px beyond their centres
	const RI = 12; // ion radius
	const RE = 5.5; // electron radius
	const VE = 105; // electron speed, px/s (shown slowly; it does not depend on temperature here)
	const A20 = 0.052; // r.m.s. displacement of an ion along one axis at 20 °C, in lattice spacings
	const TRAIL = 2.5; // s

	type Ion = { x0: number; y0: number; f: number[]; ph: number[]; x: number; y: number };
	type El = { x: number; y: number; vx: number; vy: number };

	for (const root of document.querySelectorAll<HTMLElement>('[data-mlat]')) {
		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		const ctx = canvas.getContext('2d')!;
		const tIn = root.querySelector<HTMLInputElement>('[data-t]')!;
		const tOut = root.querySelector<HTMLElement>('[data-t-out]')!;
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const nIon = root.querySelector<HTMLElement>('[data-n-ion]')!;
		const nEl = root.querySelector<HTMLElement>('[data-n-el]')!;

		let W = 0;
		let ions: Ion[] = [];
		let els: El[] = [];
		let box = { x1: 0, y1: 0, x2: 0, y2: 0 };
		let G = G0; // lattice spacing, px
		let amp = 0; // current r.m.s. amplitude, px; eases to the target
		let clock = 0;
		let trail: { x: number; y: number; t: number }[] = [];
		let col: Colours = {};
		let frameNo = 0;

		const target = () => A20 * G * Math.sqrt((Number(tIn.value) + 273) / 293);

		const build = () => {
			const rand = rng(5);
			// a square lattice that fills the canvas as well as it can
			const fx = W - 2 * PAD - 2 * M;
			const fy = H - 2 * PAD - 2 * M;
			const cols = Math.max(3, Math.floor(fx / G0) + 1);
			const rows = Math.max(3, Math.floor(fy / G0) + 1);
			G = Math.min(fx / (cols - 1), fy / (rows - 1));
			const w = (cols - 1) * G + 2 * M;
			const h = (rows - 1) * G + 2 * M;
			box = { x1: (W - w) / 2, y1: (H - h) / 2, x2: (W + w) / 2, y2: (H + h) / 2 };
			if (!amp) amp = target();
			ions = [];
			for (let r = 0; r < rows; r++)
				for (let c = 0; c < cols; c++) {
					const x0 = box.x1 + M + c * G;
					const y0 = box.y1 + M + r * G;
					// two incommensurate frequencies per axis (rad/s): a restless, thermal-looking wobble
					ions.push({ x0, y0, f: [11 + 3 * rand(), 15 + 3 * rand(), 12 + 3 * rand(), 16 + 3 * rand()], ph: [0, 1, 2, 3].map(() => rand() * 6.283), x: x0, y: y0 });
				}
			// as many free electrons as ions, started at random places clear of the ions and of each other
			els = [];
			const a0 = rand() * 6.283;
			for (let k = 0, tries = 0; k < ions.length; tries++) {
				// inside the lattice, clear of the ions and of each other
				const x = box.x1 + M + rand() * (box.x2 - box.x1 - 2 * M);
				const y = box.y1 + M + rand() * (box.y2 - box.y1 - 2 * M);
				if (ions.some((i) => Math.hypot(i.x0 - x, i.y0 - y) < RI + RE + 4)) continue;
				if (tries < 10000 && els.some((e) => Math.hypot(e.x - x, e.y - y) < 4 * RE)) continue;
				const a = a0 + k * 2.399963; // golden angle: directions spread evenly
				els.push({ x, y, vx: VE * Math.cos(a), vy: VE * Math.sin(a) });
				k++;
			}
			nIon.textContent = String(ions.length);
			nEl.textContent = String(els.length);
			trail = [];
		};

		const resize = () => {
			const w = fitCanvas(canvas, ctx, H);
			if (w !== W) {
				W = w;
				build();
			}
		};

		const showState = () => {
			const T = Number(tIn.value);
			tOut.textContent = `${T < 0 ? '−' : ''}${Math.abs(T)} °C`;
			if (T <= -100) live.textContent = 'Металл сильно охлаждён: ионы колеблются слабо.';
			else if (T < 525) live.textContent = 'Ионы колеблются около своих мест. Чем выше температура, тем сильнее они колеблются.';
			else live.textContent = 'Металл раскалён и светится: ионы колеблются сильно, но остаются на своих местах.';
		};
		tIn.addEventListener('input', showState);

		const moveIons = () => {
			// each sinusoid of amplitude a has r.m.s. a/√2; two of them give r.m.s. a along the axis
			const a = amp;
			for (const ion of ions) {
				ion.x = ion.x0 + a * (Math.sin(ion.f[0] * clock + ion.ph[0]) + Math.sin(ion.f[1] * clock + ion.ph[1])) * 0.5 * Math.SQRT2;
				ion.y = ion.y0 + a * (Math.sin(ion.f[2] * clock + ion.ph[2]) + Math.sin(ion.f[3] * clock + ion.ph[3])) * 0.5 * Math.SQRT2;
			}
		};

		const step = (dt: number) => {
			amp += (target() - amp) * Math.min(1, dt / 0.6);
			clock += dt;
			moveIons();
			const n = Math.max(1, Math.ceil(dt / 0.01));
			const h = dt / n;
			const D = RI + RE;
			// the electrons' walls: the surface of the crystal, through the outer ions
			const ex1 = box.x1 + M - EOUT;
			const ex2 = box.x2 - M + EOUT;
			const ey1 = box.y1 + M - EOUT;
			const ey2 = box.y2 - M + EOUT;
			for (let s = 0; s < n; s++)
				for (const e of els) {
					e.x += e.vx * h;
					e.y += e.vy * h;
					for (const ion of ions) {
						const dx = e.x - ion.x;
						const dy = e.y - ion.y;
						if (Math.abs(dx) > D || Math.abs(dy) > D) continue;
						const d = Math.hypot(dx, dy);
						if (d >= D || d === 0) continue;
						const nx = dx / d;
						const ny = dy / d;
						const vn = e.vx * nx + e.vy * ny;
						if (vn < 0) {
							e.vx -= 2 * vn * nx;
							e.vy -= 2 * vn * ny;
						}
						e.x = ion.x + nx * D;
						e.y = ion.y + ny * D;
					}
					if (e.x < ex1) (e.x = ex1), (e.vx = Math.abs(e.vx));
					if (e.x > ex2) (e.x = ex2), (e.vx = -Math.abs(e.vx));
					if (e.y < ey1) (e.y = ey1), (e.vy = Math.abs(e.vy));
					if (e.y > ey2) (e.y = ey2), (e.vy = -Math.abs(e.vy));
				}
			if (dt > 0) {
				trail.push({ x: els[0].x, y: els[0].y, t: clock });
				while (trail.length && clock - trail[0].t > TRAIL) trail.shift();
			}
		};

		const draw = () => {
			if (frameNo++ % 20 === 0) col = colours(root);
			ctx.clearRect(0, 0, W, H);
			const T = Number(tIn.value);
			// the piece of metal
			const g = ctx.createLinearGradient(0, box.y1, 0, box.y2);
			g.addColorStop(0, col['--sl-color-gray-5']);
			g.addColorStop(0.3, col['--sl-color-gray-6']);
			g.addColorStop(1, col['--sl-color-gray-6']);
			ctx.fillStyle = g;
			ctx.beginPath();
			ctx.roundRect(box.x1, box.y1, box.x2 - box.x1, box.y2 - box.y1, 10);
			ctx.fill();
			// glow of a red-hot metal (it starts at about 525 °C)
			if (T > 525) {
				ctx.globalAlpha = 0.22 * Math.min(1, (T - 525) / 475);
				ctx.fillStyle = col['--sl-color-orange'];
				ctx.fill();
				ctx.globalAlpha = 1;
			}
			ctx.strokeStyle = col['--sl-color-gray-3'];
			ctx.lineWidth = 1.5;
			ctx.stroke();
			// the lattice: lines through the resting places of the ions
			ctx.save();
			ctx.setLineDash([3, 4]);
			ctx.strokeStyle = col['--sl-color-gray-3'];
			ctx.globalAlpha = 0.6;
			ctx.lineWidth = 1;
			ctx.beginPath();
			const xs = [...new Set(ions.map((i) => i.x0))];
			const ys = [...new Set(ions.map((i) => i.y0))];
			for (const x of xs) {
				ctx.moveTo(x, ys[0]);
				ctx.lineTo(x, ys[ys.length - 1]);
			}
			for (const y of ys) {
				ctx.moveTo(xs[0], y);
				ctx.lineTo(xs[xs.length - 1], y);
			}
			ctx.stroke();
			ctx.restore();
			// trail of one electron
			if (trail.length > 1) {
				ctx.lineWidth = 1.5;
				ctx.lineJoin = 'round';
				ctx.strokeStyle = col['--ig-vx'];
				for (let k = 1; k < trail.length; k++) {
					ctx.globalAlpha = 0.7 * (1 - (clock - trail[k].t) / TRAIL);
					ctx.beginPath();
					ctx.moveTo(trail[k - 1].x, trail[k - 1].y);
					ctx.lineTo(trail[k].x, trail[k].y);
					ctx.stroke();
				}
				ctx.globalAlpha = 1;
			}
			for (const ion of ions) drawCharge(ctx, col, ion.x, ion.y, RI, 1);
			for (const e of els) drawCharge(ctx, col, e.x, e.y, RE, -1);
			ctx.beginPath();
			ctx.arc(els[0].x, els[0].y, RE + 3.5, 0, 2 * Math.PI);
			ctx.strokeStyle = col['--sl-color-white'];
			ctx.lineWidth = 1.5;
			ctx.stroke();
		};

		runWhileVisible(
			root,
			canvas,
			(dt) => {
				step(dt);
				draw();
			},
			resize,
		);
		resize();
		showState();
	}
</script>
