---
/**
 * The three actions of current in one series circuit: a nichrome spiral heats up and glows (thermal action),
 * a magnetic needle under a wire turns (magnetic action), copper settles on the electrode connected
 * to «−» in a solution of copper sulphate (chemical action). Swapping the poles reverses the current:
 * the needle turns the other way, copper settles on the other electrode and leaves the first one.
 */
const spiral: string[] = [];
for (let k = 0; k <= 8; k++) spiral.push(`${60 + k * 12} ${k % 2 ? 66 : 94}`);
---

<figure class="ce not-content" data-ce>
	<svg class="ce__svg" viewBox="0 0 560 270" role="img" aria-label="Цепь с нагревательной спиралью, проводом над магнитной стрелкой и сосудом с раствором медного купороса">
		<!-- wires -->
		<g class="ce__wires">
			<path d="M 250 236 H 30 V 80 H 60"></path>
			<path d="M 156 80 H 204"></path>
			<path d="M 356 80 H 400 V 120"></path>
			<path d="M 490 120 V 80 H 530 V 236 H 330"></path>
			<path d="M 270 236 H 300"></path>
		</g>
		<path class="ce__flow" d="M 250 236 H 30 V 80 H 400 V 120" data-flow></path>
		<path class="ce__flow" d="M 490 120 V 80 H 530 V 236 H 270" data-flow></path>

		<!-- thermal: a nichrome spiral -->
		<g class="ce__heat-waves" data-waves>
			<path d="M 84 52 q -5 -8 0 -16 q 5 -8 0 -16"></path>
			<path d="M 108 52 q -5 -8 0 -16 q 5 -8 0 -16"></path>
			<path d="M 132 52 q -5 -8 0 -16 q 5 -8 0 -16"></path>
		</g>
		<polyline class="ce__spiral-glow" points={spiral.join(' ')}></polyline>
		<polyline class="ce__spiral" points={`60 80 ${spiral.join(' ')} 156 80`}></polyline>
		<text class="ce__cap" x="108" y="126" text-anchor="middle">тепловое</text>

		<!-- magnetic: a wire above a compass -->
		<g class="ce__compass">
			<circle class="ce__dial" cx="280" cy="80" r="34"></circle>
			<g class="ce__needle" data-needle style="transform-origin: 280px 80px">
				<path class="ce__n" d="M 280 80 L 274 80 L 280 54 L 286 80 Z" transform="rotate(90 280 80)"></path>
				<path class="ce__s" d="M 280 80 L 274 80 L 280 106 L 286 80 Z" transform="rotate(90 280 80)"></path>
			</g>
			<circle class="ce__pivot" cx="280" cy="80" r="3"></circle>
		</g>
		<path class="ce__over" d="M 204 80 H 356"></path>
		<text class="ce__nsew" x="303" y="70" text-anchor="middle">С</text>
		<text class="ce__cap" x="280" y="136" text-anchor="middle">магнитное</text>

		<!-- chemical: copper sulphate solution -->
		<path class="ce__liquid" d="M 382 148 H 508 V 196 Q 508 204 500 204 H 390 Q 382 204 382 196 Z"></path>
		<path class="ce__glass" d="M 378 108 V 198 Q 378 208 388 208 H 502 Q 512 208 512 198 V 108"></path>
		<rect class="ce__electrode" x="394" y="120" width="12" height="74" rx="2"></rect>
		<rect class="ce__electrode" x="484" y="120" width="12" height="74" rx="2"></rect>
		<rect class="ce__cu" x="391" y="148" width="18" height="46" rx="3" data-cu="0"></rect>
		<rect class="ce__cu" x="481" y="148" width="18" height="46" rx="3" data-cu="1"></rect>
		<text class="ce__cap" x="445" y="232" text-anchor="middle">химическое</text>

		<!-- source and key -->
		<rect class="ce__bg" x="246" y="214" width="28" height="44"></rect>
		<line class="ce__plate" data-plate-left x1="252" y1="216" x2="252" y2="256"></line>
		<line class="ce__plate" data-plate-right x1="268" y1="226" x2="268" y2="246"></line>
		<text class="ce__sign" x="240" y="214" text-anchor="middle" data-sign-left>+</text>
		<text class="ce__sign" x="280" y="214" text-anchor="middle" data-sign-right>−</text>
		<line class="ce__lever" x1="300" y1="236" x2="330" y2="236" data-lever></line>
		<circle class="ce__contact" cx="300" cy="236" r="3.5"></circle>
		<circle class="ce__contact" cx="330" cy="236" r="3.5"></circle>
	</svg>
	<div class="ce__buttons">
		<button type="button" class="ce__btn ce__btn--primary" data-on>Замкнуть ключ</button>
		<button type="button" class="ce__btn" data-swap>Поменять полюса источника</button>
	</div>
	<p class="ce__live" data-live aria-live="polite">Ключ разомкнут, тока нет.</p>
</figure>

<style is:global>
	.ce {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ce__svg {
		display: block;
		width: 100%;
		max-width: 600px;
		margin-inline: auto;
		height: auto;
	}
	.ce__wires path,
	.ce__over {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.ce__over {
		stroke-width: 3;
		opacity: 0.55;
	}
	.ce__flow {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2.5;
		stroke-dasharray: 3 15;
		stroke-linecap: round;
		opacity: 0;
		transition: opacity 0.3s;
	}
	.ce.is-on .ce__flow {
		opacity: 0.9;
		animation: ce-flow 1s linear infinite;
	}
	.ce.is-rev .ce__flow {
		animation-direction: reverse;
	}
	@keyframes ce-flow {
		to {
			stroke-dashoffset: -18;
		}
	}
	.ce__spiral {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linejoin: round;
		transition: stroke 2.5s;
	}
	.ce__spiral-glow {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 9;
		stroke-linejoin: round;
		opacity: 0;
		filter: blur(4px);
		transition: opacity 2.5s;
	}
	.ce.is-on .ce__spiral {
		stroke: var(--ig-v);
	}
	.ce.is-on .ce__spiral-glow {
		opacity: 0.75;
	}
	.ce__heat-waves path {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0;
	}
	.ce.is-on .ce__heat-waves path {
		animation: ce-rise 1.6s ease-in infinite;
		animation-delay: 1.2s;
	}
	.ce.is-on .ce__heat-waves path:nth-child(2) {
		animation-delay: 1.7s;
	}
	.ce.is-on .ce__heat-waves path:nth-child(3) {
		animation-delay: 2.2s;
	}
	@keyframes ce-rise {
		0% {
			opacity: 0;
			transform: translateY(6px);
		}
		40% {
			opacity: 0.8;
		}
		100% {
			opacity: 0;
			transform: translateY(-10px);
		}
	}
	.ce__dial {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.ce__nsew {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		font-family: var(--__sl-font);
	}
	.ce__needle {
		transition: transform 1.4s cubic-bezier(0.25, 1.6, 0.4, 1);
	}
	.ce__n {
		fill: var(--ig-vy);
	}
	.ce__s {
		fill: var(--ig-vx);
	}
	.ce__pivot {
		fill: var(--sl-color-gray-1);
	}
	.ce__liquid {
		fill: color-mix(in srgb, var(--ig-vx) 35%, transparent);
	}
	.ce__glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.ce__electrode {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
	}
	.ce__cu {
		fill: var(--ig-v);
		opacity: 0;
	}
	.ce__bg {
		fill: var(--ig-surface);
	}
	.ce__plate {
		stroke: var(--sl-color-white);
		stroke-width: 2.5;
	}
	.ce__plate.is-minus {
		stroke-width: 6;
	}
	.ce__sign {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.ce__lever {
		stroke: var(--sl-color-white);
		stroke-width: 3;
		stroke-linecap: round;
		transform-origin: 300px 236px;
		transform: rotate(-30deg);
		transition: transform 0.3s;
	}
	.ce.is-on .ce__lever {
		transform: none;
	}
	.ce__contact {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.ce__cap {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
		font-weight: 600;
		font-family: var(--__sl-font);
	}
	.ce__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.ce__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.ce__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.ce__live {
		min-height: 3em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	@media (prefers-reduced-motion: reduce) {
		.ce.is-on .ce__flow,
		.ce.is-on .ce__heat-waves path {
			animation: none;
		}
		.ce__needle,
		.ce__spiral,
		.ce__spiral-glow {
			transition: none;
		}
	}
</style>

<script>
	const RATE = 1 / 8; // the copper layer grows to full in 8 s

	for (const root of document.querySelectorAll<HTMLElement>('[data-ce]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const onBtn = $<HTMLButtonElement>('[data-on]');
		const live = $<HTMLElement>('[data-live]');
		const needle = $<SVGGElement>('[data-needle]');
		const cu = [...root.querySelectorAll<SVGRectElement>('[data-cu]')];
		const pl = $<SVGLineElement>('[data-plate-left]');
		const pr = $<SVGLineElement>('[data-plate-right]');
		const sl = $<SVGTextElement>('[data-sign-left]');
		const sr = $<SVGTextElement>('[data-sign-right]');
		let on = false;
		let rev = false; // false: «+» on the left, the current goes clockwise
		const layer = [0, 0]; // thickness of copper on the left and the right electrode, 0…1

		const show = () => {
			root.classList.toggle('is-on', on);
			root.classList.toggle('is-rev', rev);
			onBtn.textContent = on ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			// the long thin plate is «+», the short thick one is «−»
			const long = (l: SVGLineElement, yes: boolean) => {
				l.setAttribute('y1', yes ? '216' : '226');
				l.setAttribute('y2', yes ? '256' : '246');
				l.classList.toggle('is-minus', !yes);
			};
			long(pl, !rev);
			long(pr, rev);
			sl.textContent = rev ? '−' : '+';
			sr.textContent = rev ? '+' : '−';
			// the needle points north along the wire; a current turns it across, to one side or the other
			needle.style.transform = `rotate(${on ? (rev ? 65 : -65) : 0}deg)`;
			live.textContent = on
				? `Ток идёт ${rev ? 'против часовой стрелки' : 'по часовой стрелке'}. Спираль нагрелась и светится, магнитная стрелка повернулась, на электроде, соединённом с «−» источника, оседает медь.`
				: 'Ключ разомкнут, тока нет. Медь, которая уже осела, остаётся на электроде.';
		};

		let last = 0;
		let raf = 0;
		const tick = (time: number) => {
			const dt = last ? Math.min(0.05, (time - last) / 1000) : 0;
			last = time;
			// «+» on the left: the current goes clockwise, enters the solution at the left electrode and leaves it
			// at the right one, which is connected to «−»: copper settles there
			const cathode = rev ? 0 : 1;
			const anode = 1 - cathode;
			layer[cathode] = Math.min(1, layer[cathode] + RATE * dt);
			layer[anode] = Math.max(0, layer[anode] - RATE * dt);
			cu.forEach((r, k) => {
				r.style.opacity = String(0.9 * layer[k]);
				const w = 12 + 6 * layer[k];
				r.setAttribute('x', String((k ? 490 : 400) - w / 2));
				r.setAttribute('width', String(w));
			});
			raf = on ? requestAnimationFrame(tick) : 0;
		};
		const start = () => {
			if (!raf) {
				last = 0;
				raf = requestAnimationFrame(tick);
			}
		};

		onBtn.addEventListener('click', () => {
			on = !on;
			show();
			if (on) start();
		});
		$('[data-swap]').addEventListener('click', () => {
			rev = !rev;
			show();
		});
		show();
	}
</script>
