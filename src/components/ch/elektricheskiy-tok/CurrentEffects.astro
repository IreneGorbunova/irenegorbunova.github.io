---
/**
 * The three actions of current, one at a time, in one simple circuit (source, key, wires). Three buttons put
 * the middle element into the circuit:
 * - thermal: a nichrome spiral heats up (to about 800 °C, a thermometer column shows it) and glows red-hot;
 * - magnetic: a straight wire stretched over a magnetic needle along it (Oersted's experiment, seen from above
 *   and from the side); with current the needle turns across the wire, the other way when the poles are swapped;
 * - chemical: copper sulphate solution with two carbon electrodes; copper settles on the electrode connected to
 *   «−»; after a pole swap the copper leaves that electrode (now «+») and settles on the other one; a bare «+»
 *   electrode gives off gas bubbles (oxygen).
 * The key and the pole swap work in every mode; choosing another action opens the key and starts afresh.
 */

// a coil spring seen from the side: x = x0 + p t / 2π + c (1 − cos t), y = y0 − r sin t
const coil: string[] = [];
{
	const x0 = 112;
	const turns = 7;
	const p = (248 - x0) / turns;
	const n = 24 * turns;
	for (let k = 0; k <= n; k++) {
		const t = (2 * Math.PI * turns * k) / n;
		const x = x0 + (p * t) / (2 * Math.PI) + 6 * (1 - Math.cos(t));
		const y = 64 - 11 * Math.sin(t);
		coil.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
	}
}
const ticks = Array.from({ length: 11 }, (_, k) => k * 100);
---

<figure class="ce not-content" data-ce data-mode="heat">
	<div class="ce__modes" role="group" aria-label="Какое действие тока наблюдаем">
		<button type="button" class="ce__mode" data-pick="heat" aria-pressed="true">Тепловое действие</button>
		<button type="button" class="ce__mode" data-pick="mag" aria-pressed="false">Магнитное действие</button>
		<button type="button" class="ce__mode" data-pick="chem" aria-pressed="false">Химическое действие</button>
	</div>
	<svg class="ce__svg" viewBox="0 0 360 282" role="img" aria-label="Цепь: источник тока, ключ и нагревательная спираль" data-svg>
		<!-- the common circuit: source, key, wires to the two clamps -->
		<g class="ce__wires">
			<path d="M 150 252 H 24 V 64 H 96"></path>
			<path d="M 166 252 H 196"></path>
			<path d="M 226 252 H 336 V 64 H 264"></path>
		</g>
		<path class="ce__flow" d="M 150 252 H 24 V 64 H 96"></path>
		<path class="ce__flow" d="M 264 64 H 336 V 252 H 166"></path>

		<!-- thermal: a nichrome spiral and a thermometer column -->
		<g data-m="heat">
			<g class="ce__waves" data-waves>
				<path d="M 136 46 q -5 -8 0 -16 q 5 -8 0 -16"></path>
				<path d="M 180 46 q -5 -8 0 -16 q 5 -8 0 -16"></path>
				<path d="M 224 46 q -5 -8 0 -16 q 5 -8 0 -16"></path>
			</g>
			<g class="ce__wires">
				<path d="M 96 64 H 112"></path>
				<path d="M 248 64 H 264"></path>
			</g>
			<path class="ce__flow" d="M 96 64 H 112"></path>
			<path class="ce__flow" d="M 248 64 H 264"></path>
			<polyline class="ce__glow" points={coil.join(' ')} data-glow></polyline>
			<polyline class="ce__coil" points={coil.join(' ')} data-coil></polyline>
			<text class="ce__lbl" x="180" y="96" text-anchor="middle">спираль из нихрома</text>

			<text class="ce__lbl" x="166" y="122" text-anchor="end"><tspan class="ce__math">t</tspan>, °C</text>
			<rect class="ce__tube" x="174" y="104" width="12" height="104" rx="6"></rect>
			<rect class="ce__mercury" x="177" y="198" width="6" height="16" data-column></rect>
			<circle class="ce__bulb" cx="180" cy="214" r="9"></circle>
			{ticks.map((v) => <line class="ce__tick" x1="188" x2={v % 200 ? 192 : 195} y1={200 - v * 0.09} y2={200 - v * 0.09}></line>)}
			{ticks.filter((v) => v % 200 === 0).map((v) => <text class="ce__num" x="199" y={200 - v * 0.09 + 3.5}>{v}</text>)}
		</g>

		<!-- magnetic: a straight wire stretched over a magnetic needle, from above and from the side -->
		<g data-m="mag" style="display: none">
			<text class="ce__lbl" x="68" y="44" text-anchor="middle">вид сверху</text>
			<circle class="ce__dial" cx="180" cy="64" r="46"></circle>
			<text class="ce__nsew" x="214" y="54" text-anchor="middle">С</text>
			<text class="ce__nsew" x="146" y="54" text-anchor="middle">Ю</text>
			<g transform="rotate(0 180 64)" data-needle>
				<path class="ce__n" d="M 180 58 L 220 64 L 180 70 Z"></path>
				<path class="ce__s" d="M 180 58 L 140 64 L 180 70 Z"></path>
			</g>
			<circle class="ce__pivot" cx="180" cy="64" r="3"></circle>
			<line class="ce__shadow" x1="135" y1="71" x2="225" y2="71"></line>
			<path class="ce__over" d="M 96 64 H 264"></path>
			<path class="ce__flow" d="M 96 64 H 264"></path>

			<text class="ce__lbl" x="180" y="134" text-anchor="middle">вид сбоку</text>
			<rect class="ce__base" x="104" y="206" width="152" height="6" rx="2"></rect>
			<line class="ce__post" x1="112" y1="150" x2="112" y2="206"></line>
			<line class="ce__post" x1="248" y1="150" x2="248" y2="206"></line>
			<line class="ce__pin" x1="180" y1="178" x2="180" y2="206"></line>
			<path class="ce__n" d="M 180 172 L 218 176 L 180 180 Z" data-side-n></path>
			<path class="ce__s" d="M 180 172 L 142 176 L 180 180 Z" data-side-s></path>
			<path class="ce__over" d="M 112 150 H 248"></path>
			<path class="ce__flow" d="M 112 150 H 248"></path>
		</g>

		<!-- chemical: copper sulphate solution with two carbon electrodes -->
		<g data-m="chem" style="display: none">
			<path class="ce__liquid" d="M 106 122 H 254 V 204 Q 254 212 246 212 H 114 Q 106 212 106 204 Z"></path>
			<g class="ce__wires">
				<path d="M 96 64 H 140 V 78"></path>
				<path d="M 220 78 V 64 H 264"></path>
			</g>
			<path class="ce__flow" d="M 96 64 H 140 V 78"></path>
			<path class="ce__flow" d="M 220 78 V 64 H 264"></path>
			<rect class="ce__rod" x="134" y="78" width="12" height="118" rx="2"></rect>
			<rect class="ce__rod" x="214" y="78" width="12" height="118" rx="2"></rect>
			<rect class="ce__cu" x="134" y="123" width="12" height="73" rx="3" data-cu></rect>
			<rect class="ce__cu" x="214" y="123" width="12" height="73" rx="3" data-cu></rect>
			<g data-bubbles>
				{Array.from({ length: 10 }, () => <circle class="ce__bubble" cx="0" cy="0" r="2"></circle>)}
			</g>
			<path class="ce__glass" d="M 102 98 V 206 Q 102 216 112 216 H 248 Q 258 216 258 206 V 98"></path>
			<text class="ce__pole" x="121" y="114" text-anchor="middle" data-pole>+</text>
			<text class="ce__pole" x="239" y="114" text-anchor="middle" data-pole>−</text>
			<line class="ce__leader" x1="180" y1="50" x2="180" y2="134"></line>
			<text class="ce__lbl" x="180" y="44" text-anchor="middle">раствор медного купороса</text>
		</g>

		<!-- source, key, direction of the current -->
		<rect class="ce__bg" x="146" y="230" width="24" height="44"></rect>
		<line class="ce__plate" data-plate x1="150" y1="232" x2="150" y2="272"></line>
		<line class="ce__plate" data-plate x1="166" y1="242" x2="166" y2="262"></line>
		<text class="ce__sign" x="138" y="232" text-anchor="middle" data-sign>+</text>
		<text class="ce__sign" x="178" y="232" text-anchor="middle" data-sign>−</text>
		<line class="ce__lever" x1="196" y1="252" x2="226" y2="252"></line>
		<circle class="ce__contact" cx="196" cy="252" r="3.5"></circle>
		<circle class="ce__contact" cx="226" cy="252" r="3.5"></circle>
		<g class="ce__arrow" data-arrow transform="rotate(0 24 158)">
			<path d="M 24 148 L 30 162 L 18 162 Z"></path>
		</g>
		<text class="ce__arrow-lbl ce__math" x="38" y="163">I</text>
		<circle class="ce__clamp" cx="96" cy="64" r="3.5"></circle>
		<circle class="ce__clamp" cx="264" cy="64" r="3.5"></circle>
	</svg>
	<div class="ce__buttons">
		<button type="button" class="ce__btn ce__btn--primary" data-on>Замкнуть ключ</button>
		<button type="button" class="ce__btn" data-swap>Поменять полюсы</button>
	</div>
	<p class="ce__live" aria-live="polite"><b data-act>Тепловое действие.</b> <span data-what>Ключ разомкнут, тока нет. Спираль холодная.</span></p>
</figure>

<style is:global>
	.ce {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ce__modes {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.4rem;
		max-width: 560px;
		margin: 0 auto 0.75rem;
	}
	.ce__mode {
		margin: 0;
		padding: 0.45rem 0.5rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.25;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.6rem;
		cursor: pointer;
	}
	.ce__mode:hover {
		border-color: var(--sl-color-accent);
	}
	.ce__mode[aria-pressed='true'] {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.ce__svg {
		display: block;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
		height: auto;
	}
	.ce__wires path,
	.ce__over {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.ce__over {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.ce__flow {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2.5;
		stroke-dasharray: 3 15;
		stroke-linecap: round;
		opacity: 0;
		transition: opacity 0.3s;
	}
	.ce.is-on .ce__flow {
		opacity: 0.9;
	}
	.ce.is-on.is-vis .ce__flow {
		animation: ce-flow 1s linear infinite;
	}
	.ce.is-rev .ce__flow {
		animation-direction: reverse;
	}
	@keyframes ce-flow {
		to {
			stroke-dashoffset: -18;
		}
	}
	.ce__lbl {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
		font-family: var(--__sl-font);
	}
	.ce__math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	/* thermal */
	.ce__coil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.ce__glow {
		fill: none;
		stroke: var(--sl-color-orange);
		stroke-width: 8;
		stroke-linejoin: round;
		opacity: 0;
		filter: blur(4px);
	}
	.ce__waves path {
		fill: none;
		stroke: var(--sl-color-orange);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0;
	}
	.ce.is-vis .ce__waves.is-hot path {
		animation: ce-rise 1.6s ease-in infinite;
	}
	.ce.is-vis .ce__waves.is-hot path:nth-child(2) {
		animation-delay: 0.5s;
	}
	.ce.is-vis .ce__waves.is-hot path:nth-child(3) {
		animation-delay: 1s;
	}
	@keyframes ce-rise {
		0% {
			opacity: 0;
			transform: translateY(6px);
		}
		40% {
			opacity: 0.8;
		}
		100% {
			opacity: 0;
			transform: translateY(-10px);
		}
	}
	.ce__tube {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.ce__mercury,
	.ce__bulb {
		fill: var(--sl-color-red);
	}
	.ce__tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ce__num {
		fill: var(--sl-color-gray-2);
		font-size: 11px;
		font-family: var(--__sl-font);
		font-variant-numeric: tabular-nums;
	}
	/* magnetic */
	.ce__dial {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.ce__nsew {
		fill: var(--sl-color-gray-2);
		font-size: 12px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.ce__n {
		fill: var(--sl-color-red);
	}
	.ce__s {
		fill: var(--sl-color-gray-3);
	}
	.ce__pivot {
		fill: var(--sl-color-gray-1);
	}
	.ce__shadow {
		stroke: var(--sl-color-black);
		stroke-width: 3;
		opacity: 0.3;
	}
	.ce__base {
		fill: var(--sl-color-gray-5);
	}
	.ce__post {
		stroke: var(--sl-color-gray-4);
		stroke-width: 4;
	}
	.ce__pin {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	/* chemical */
	.ce__liquid {
		fill: color-mix(in srgb, var(--ig-vx) 38%, transparent);
	}
	.ce__glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.ce__rod {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
	}
	.ce__cu {
		fill: color-mix(in srgb, var(--sl-color-orange) 60%, var(--sl-color-red));
		opacity: 0;
	}
	.ce__bubble {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1;
		opacity: 0;
	}
	.ce__leader {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.ce__pole {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	/* source, key, arrow */
	.ce__bg {
		fill: var(--ig-surface);
	}
	.ce__plate {
		stroke: var(--sl-color-white);
		stroke-width: 2.5;
	}
	.ce__plate.is-minus {
		stroke-width: 6;
	}
	.ce__sign {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.ce__lever {
		stroke: var(--sl-color-white);
		stroke-width: 3;
		stroke-linecap: round;
		transform-origin: 196px 252px;
		transform: rotate(-30deg);
		transition: transform 0.3s;
	}
	.ce.is-on .ce__lever {
		transform: none;
	}
	.ce__contact,
	.ce__clamp {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.ce__arrow path {
		fill: var(--ig-vx);
	}
	.ce__arrow-lbl {
		fill: var(--ig-vx);
		font-size: 16px;
	}
	.ce__arrow,
	.ce__arrow-lbl {
		opacity: 0;
		transition: opacity 0.3s;
	}
	.ce.is-on .ce__arrow,
	.ce.is-on .ce__arrow-lbl {
		opacity: 1;
	}
	.ce__buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.ce__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.ce__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.ce__live {
		min-height: 4.5em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ce__live b {
		color: var(--sl-color-white);
	}
</style>

<script>
	type Mode = 'heat' | 'mag' | 'chem';
	const NAME: Record<Mode, string> = { heat: 'Тепловое действие.', mag: 'Магнитное действие.', chem: 'Химическое действие.' };
	const ARIA: Record<Mode, string> = {
		heat: 'Цепь: источник тока, ключ и нагревательная спираль',
		mag: 'Цепь: источник тока, ключ и провод, натянутый над магнитной стрелкой',
		chem: 'Цепь: источник тока, ключ и сосуд с раствором медного купороса и двумя электродами',
	};
	const T_ROOM = 20; // °C
	const T_HOT = 800; // °C, a nichrome spiral glowing cherry red
	const TAU_UP = 1.5; // s, heating
	const TAU_DOWN = 2.5; // s, cooling
	const ANGLE = 65; // degrees: the wire's field is about twice the Earth's horizontal field, tg 65° ≈ 2,1
	const OMEGA = (2 * Math.PI) / 1.6; // the needle's own swing, 1/s
	const DAMP = 2.2; // 1/s
	const RATE = 1 / 8; // the copper layer grows to full in 8 s
	const ROD = [140, 220]; // the electrodes' axes
	const clamp = (x: number) => Math.min(1, Math.max(0, x));

	for (const root of document.querySelectorAll<HTMLElement>('[data-ce]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const $$ = <T extends Element>(s: string) => [...root.querySelectorAll<T>(s)];
		const svg = $<SVGSVGElement>('[data-svg]');
		const picks = $$<HTMLButtonElement>('[data-pick]');
		const groups = $$<SVGGElement>('[data-m]');
		const onBtn = $<HTMLButtonElement>('[data-on]');
		const act = $<HTMLElement>('[data-act]');
		const what = $<HTMLElement>('[data-what]');
		const plates = $$<SVGLineElement>('[data-plate]');
		const signs = $$<SVGTextElement>('[data-sign]');
		const arrow = $<SVGGElement>('[data-arrow]');
		const coil = $<SVGPolylineElement>('[data-coil]');
		const glow = $<SVGPolylineElement>('[data-glow]');
		const waves = $<SVGGElement>('[data-waves]');
		const column = $<SVGRectElement>('[data-column]');
		const needle = $<SVGGElement>('[data-needle]');
		const sideN = $<SVGPathElement>('[data-side-n]');
		const sideS = $<SVGPathElement>('[data-side-s]');
		const cu = $$<SVGRectElement>('[data-cu]');
		const poles = $$<SVGTextElement>('[data-pole]');
		const bubbles = $$<SVGCircleElement>('[data-bubbles] circle').map((el) => ({ el, x: 0, y: 0, v: 0, live: false }));

		let mode: Mode = 'heat';
		let on = false;
		let rev = false; // false: «+» on the left, the current goes clockwise, along the wire over the needle to the right (north)
		let T = T_ROOM;
		let angle = 0; // degrees, the picture's clockwise; 0 = north end to the right, along the wire
		let spin = 0;
		const layer = [0, 0]; // copper on the left and the right electrode, 0…1
		let bubbleClock = 0;
		let visible = false;

		// the electrode connected to «−»: with «+» on the left the right one
		const cathode = () => (rev ? 0 : 1);
		const target = () => (on ? (rev ? ANGLE : -ANGLE) : 0);

		const say = () => {
			let s = '';
			if (mode === 'heat') {
				if (on) s = T < 550 ? 'Ток идёт по спирали, и она нагревается.' : 'Спираль раскалилась и светится, столбик показывает её температуру.';
				else s = T > 30 ? 'Ключ разомкнут, тока нет. Спираль остывает.' : 'Ключ разомкнут, тока нет. Спираль холодная.';
			} else if (mode === 'mag') {
				if (on) s = `По проводу идёт ток. Стрелка под ним повернулась поперёк провода, северным концом ${rev ? 'вниз' : 'вверх'} на рисунке.`;
				else s = 'Ключ разомкнут, тока нет. Стрелка показывает на север — вдоль провода.';
			} else if (on) {
				const a = 1 - cathode();
				s =
					'На электроде, соединённом с «−» источника, оседает медь. ' +
					(layer[a] > 0.02 ? 'С другого электрода медь уходит в раствор.' : 'У электрода, соединённого с «+», выделяются пузырьки газа.');
			} else {
				s = layer[0] + layer[1] > 0.02 ? 'Ключ разомкнут, тока нет. Осевшая медь осталась на электроде.' : 'Ключ разомкнут, тока нет. Электроды чистые.';
			}
			if (what.textContent !== s) what.textContent = s;
		};

		const drawPoles = () => {
			// the long thin plate is «+», the short thick one is «−»
			plates.forEach((l, k) => {
				const plus = (k === 0) !== rev;
				l.setAttribute('y1', plus ? '232' : '242');
				l.setAttribute('y2', plus ? '272' : '262');
				l.classList.toggle('is-minus', !plus);
			});
			signs.forEach((t, k) => (t.textContent = (k === 0) !== rev ? '+' : '−'));
			poles.forEach((t, k) => (t.textContent = k === cathode() ? '−' : '+'));
			arrow.setAttribute('transform', `rotate(${rev ? 180 : 0} 24 158)`);
		};

		const draw = () => {
			// thermal: dark below about 500 °C, then dark red, cherry red at 800 °C
			const red = clamp((T - 500) / 200);
			const orange = 0.55 * clamp((T - 650) / 150);
			coil.style.stroke =
				red > 0
					? `color-mix(in srgb, color-mix(in srgb, var(--sl-color-orange) ${(orange * 100).toFixed(0)}%, var(--sl-color-red)) ${(red * 100).toFixed(0)}%, var(--sl-color-gray-2))`
					: '';
			glow.style.opacity = (0.8 * clamp((T - 520) / 280)).toFixed(3);
			waves.classList.toggle('is-hot', T > 150);
			const h = 14 + (T * 0.09); // the column from the bulb (y = 214) up to y = 200 − 0,09 t
			column.setAttribute('y', (214 - h).toFixed(2));
			column.setAttribute('height', h.toFixed(2));
			// magnetic
			needle.setAttribute('transform', `rotate(${angle.toFixed(2)} 180 64)`);
			const L = 38 * Math.cos((angle * Math.PI) / 180);
			sideN.setAttribute('d', `M 180 172 L ${(180 + L).toFixed(2)} 176 L 180 180 Z`);
			sideS.setAttribute('d', `M 180 172 L ${(180 - L).toFixed(2)} 176 L 180 180 Z`);
			// chemical
			cu.forEach((r, k) => {
				r.style.opacity = (0.95 * clamp(layer[k] * 1.6)).toFixed(3);
				const w = 12 + 8 * layer[k];
				r.setAttribute('x', (ROD[k] - w / 2).toFixed(2));
				r.setAttribute('width', w.toFixed(2));
			});
			for (const b of bubbles) {
				b.el.style.opacity = b.live ? '0.8' : '0';
				if (b.live) {
					b.el.setAttribute('cx', b.x.toFixed(1));
					b.el.setAttribute('cy', b.y.toFixed(1));
				}
			}
		};

		const settled = () => {
			if (on) return false;
			if (mode === 'heat') return T - T_ROOM < 0.5;
			if (mode === 'mag') return Math.abs(angle) < 0.05 && Math.abs(spin) < 0.05;
			return !bubbles.some((b) => b.live);
		};

		const step = (dt: number) => {
			if (mode === 'heat') {
				const goal = on ? T_HOT : T_ROOM;
				T = goal + (T - goal) * Math.exp(-dt / (on ? TAU_UP : TAU_DOWN));
			} else if (mode === 'mag') {
				spin += (-OMEGA * OMEGA * (angle - target()) - DAMP * spin) * dt;
				angle += spin * dt;
				if (!on && Math.abs(angle) < 0.05 && Math.abs(spin) < 0.05) angle = spin = 0;
			} else {
				const c = cathode();
				const a = 1 - c;
				if (on) {
					layer[c] = Math.min(1, layer[c] + RATE * dt);
					layer[a] = Math.max(0, layer[a] - RATE * dt);
					// a bare «+» electrode gives off oxygen; a copper-coated one dissolves instead
					if (layer[a] === 0) {
						bubbleClock += dt;
						while (bubbleClock > 0.18) {
							bubbleClock -= 0.18;
							const b = bubbles.find((x) => !x.live);
							if (b) {
								b.live = true;
								b.x = ROD[a] + (Math.random() < 0.5 ? -8 : 8) + (Math.random() - 0.5) * 2;
								b.y = 150 + Math.random() * 42;
								b.v = 22 + Math.random() * 12;
								b.el.setAttribute('r', (1.4 + Math.random() * 1.2).toFixed(1));
							}
						}
					}
				}
				for (const b of bubbles) {
					if (!b.live) continue;
					b.y -= b.v * dt;
					if (b.y < 125) b.live = false;
				}
			}
		};

		let raf = 0;
		let last = 0;
		const loop = (time: number) => {
			const dt = last ? Math.min(0.05, (time - last) / 1000) : 0;
			last = time;
			step(dt);
			draw();
			say();
			raf = visible && !settled() ? requestAnimationFrame(loop) : 0;
		};
		const kick = () => {
			if (!raf && visible) {
				last = 0;
				raf = requestAnimationFrame(loop);
			}
		};

		const show = () => {
			root.dataset.mode = mode;
			root.classList.toggle('is-on', on);
			root.classList.toggle('is-rev', rev);
			onBtn.textContent = on ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === mode)));
			groups.forEach((g) => (g.style.display = g.dataset.m === mode ? '' : 'none'));
			svg.setAttribute('aria-label', ARIA[mode]);
			act.textContent = NAME[mode];
			drawPoles();
			draw();
			say();
			kick();
		};

		picks.forEach((b) =>
			b.addEventListener('click', () => {
				if (b.dataset.pick === mode) return;
				// another element goes into the circuit: the key is opened, the new element starts afresh
				mode = b.dataset.pick as Mode;
				on = false;
				T = T_ROOM;
				angle = spin = 0;
				layer[0] = layer[1] = 0;
				bubbles.forEach((x) => (x.live = false));
				show();
			}),
		);
		onBtn.addEventListener('click', () => {
			on = !on;
			show();
		});
		$('[data-swap]').addEventListener('click', () => {
			rev = !rev;
			show();
		});
		new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting;
			root.classList.toggle('is-vis', visible);
			kick();
		}).observe(root);
		show();
	}
</script>
