---
/**
 * How a meter is connected: a small circuit diagram where the reader chooses the place of the ammeter
 * (`kind="ammeter"`: before the lamp, after it, after the key, or — wrongly — in parallel with the lamp) or of the
 * voltmeter (`kind="voltmeter"`: across lamp 1, lamp 2, the source, or — wrongly — in series). The numbers and the
 * drawing come from meters.ts.
 */
import { drawMeter, OPTIONS, type MeterKind } from './meters';

interface Props {
	kind: MeterKind;
}
const { kind } = Astro.props;
const gid = `ms-glow-${Math.random().toString(36).slice(2, 8)}`;
const first = drawMeter(kind, 0, gid);
const title = kind === 'ammeter' ? 'Где включить амперметр' : 'Куда подключить вольтметр';
---

<figure class="ms not-content" data-ms data-kind={kind} data-gid={gid}>
	<svg class="ms__svg" viewBox="0 0 500 300" role="img" aria-label={kind === 'ammeter' ? 'Схема: батарея, ключ и лампа соединены последовательно, амперметр можно поставить в разные места цепи' : 'Схема: батарея, ключ и две лампы соединены последовательно, вольтметр можно подключить к разным участкам цепи'}>
		<defs>
			<radialGradient id={gid}>
				<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.9"></stop>
				<stop offset="0.4" stop-color="var(--ig-v)" stop-opacity="0.35"></stop>
				<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
			</radialGradient>
		</defs>
		<g data-draw set:html={first.svg} />
	</svg>
	<div class="ms__opts" role="radiogroup" aria-label={title}>
		<span class="ms__ask">{kind === 'ammeter' ? 'Амперметр:' : 'Вольтметр:'}</span>
		{
			OPTIONS[kind].map((o, k) => (
				<button type="button" class="ms__opt" role="radio" aria-checked={k === 0 ? 'true' : 'false'} data-pos={k}>
					{o}
				</button>
			))
		}
	</div>
	<p class="ms__live" data-live aria-live="polite">{first.msg}</p>
</figure>

<style is:global>
	.ms {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ms__svg {
		display: block;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.ms__w {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.ms.is-short .ms__w {
		stroke: var(--ig-vy);
	}
	.ms__bg {
		fill: var(--ig-surface);
	}
	.ms__flow {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2.5;
		stroke-dasharray: 3 15;
		stroke-linecap: round;
		opacity: 0.9;
		animation: ms-flow 0.9s linear infinite;
	}
	.ms.is-short .ms__flow {
		stroke: var(--ig-vy);
		animation-duration: 0.3s;
	}
	@keyframes ms-flow {
		to {
			stroke-dashoffset: -18;
		}
	}
	.ms .cb__w {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.ms .cb__plate {
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
	}
	.ms .cb__plate--minus {
		stroke-width: 5;
	}
	.ms .cb__dash {
		stroke: var(--sl-color-white);
		stroke-width: 1.5;
		stroke-dasharray: 3 3;
	}
	.ms .cb__pm,
	.ms .cb__letter {
		fill: var(--sl-color-white);
		font-size: 17px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.ms .cb__lever {
		stroke: var(--sl-color-white);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.ms .cb__contact {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.ms .cb__ring {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
	}
	.ms .cb__meter {
		fill: var(--ig-surface);
	}
	.ms .cb__glow {
		display: none;
	}
	.ms .cb__dot {
		fill: var(--sl-color-white);
	}
	.ms__glow {
		transition: opacity 0.4s;
	}
	.ms__cap {
		fill: var(--sl-color-gray-2);
		font-size: 18px;
		font-family: var(--__sl-font);
	}
	.ms__read {
		font-size: 20px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.ms__read--i {
		fill: var(--ig-vx);
	}
	.ms__read--u {
		fill: var(--ig-vy);
	}
	.ms__read--bad {
		fill: var(--ig-vy);
	}
	.ms__opts {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}
	.ms__ask {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ms__opt {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.25rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.ms__opt:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.ms__opt[aria-checked='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.ms__live {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		color: var(--sl-color-gray-2);
		text-align: center;
		min-height: 3em;
	}
</style>

<script>
	import { drawMeter, type MeterKind } from './meters';

	for (const root of document.querySelectorAll<HTMLElement>('[data-ms]')) {
		const kind = root.dataset.kind as MeterKind;
		const gid = root.dataset.gid!;
		const g = root.querySelector<SVGGElement>('[data-draw]')!;
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const opts = [...root.querySelectorAll<HTMLButtonElement>('[data-pos]')];
		opts.forEach((b) =>
			b.addEventListener('click', () => {
				const r = drawMeter(kind, Number(b.dataset.pos), gid);
				g.innerHTML = r.svg;
				live.textContent = r.msg;
				root.classList.toggle('is-short', r.short);
				opts.forEach((o) => o.setAttribute('aria-checked', String(o === b)));
			}),
		);
	}
</script>
