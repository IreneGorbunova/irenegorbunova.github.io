---
/**
 * A dry galvanic cell («батарейка») cut along its axis, with labelled parts: the zinc can (the «−» pole), the paste
 * with ammonium chloride, the mixture of manganese oxide with carbon powder around the carbon rod, the carbon rod
 * with a brass cap (the «+» pole) and the insulating seal on top. Proportions of a common AA cell (about
 * 14 × 50 mm), drawn wider for the labels.
 */
const X = 95; // the axis of the cell
const parts = [
	{ y: 26, px: X + 11, py: 25, t: ['латунный колпачок — «+»'] },
	{ y: 70, px: X + 40, py: 66, t: ['изолирующая прокладка'] },
	{ y: 112, px: X + 5, py: 112, t: ['угольный стержень'] },
	{ y: 158, px: X + 22, py: 160, t: ['смесь оксида марганца', 'с угольным порошком'] },
	{ y: 214, px: X + 40, py: 214, t: ['паста с раствором', 'нашатыря'] },
	{ y: 262, px: X + 53, py: 262, t: ['цинковый стаканчик — «−»'] },
];
const LX = 176; // where the labels start
---

<figure class="cell not-content">
	<svg class="cell__svg" viewBox="0 0 420 300" role="img" aria-label="Сухой гальванический элемент в разрезе: цинковый стаканчик — отрицательный полюс, внутри паста с раствором нашатыря, в середине угольный стержень с латунным колпачком — положительный полюс, вокруг стержня смесь оксида марганца с угольным порошком, сверху изолирующая прокладка">
		<!-- the outer jacket -->
		<rect class="cell__jacket" x={X - 60} y="40" width="120" height="240" rx="6"></rect>
		<!-- the zinc can -->
		<path class="cell__zinc" d={`M ${X - 53} 58 V 272 H ${X + 53} V 58 H ${X + 47} V 266 H ${X - 47} V 58 Z`}></path>
		<!-- the paste -->
		<rect class="cell__paste" x={X - 47} y="72" width="94" height="194"></rect>
		<!-- the mixture around the rod -->
		<rect class="cell__mix" x={X - 27} y="84" width="54" height="166" rx="8"></rect>
		<!-- the seal -->
		<rect class="cell__seal" x={X - 47} y="58" width="94" height="14"></rect>
		<!-- the carbon rod with its brass cap -->
		<rect class="cell__rod" x={X - 6} y="28" width="12" height="208" rx="3"></rect>
		<rect class="cell__cap" x={X - 11} y="18" width="22" height="14" rx="3"></rect>
		<text class="cell__sign" x={X} y="12" text-anchor="middle">+</text>
		<text class="cell__sign" x={X} y="298" text-anchor="middle">−</text>
		<!-- labels -->
		{
			parts.map((p) => (
				<g class="cell__label">
					<circle cx={p.px} cy={p.py} r="2.6" />
					<polyline points={`${p.px},${p.py} ${LX - 22},${p.py} ${LX - 6},${p.y}`} />
					<text x={LX} y={p.y + 5 - (p.t.length - 1) * 8}>
						{p.t.map((line, k) => (
							<tspan x={LX} dy={k ? 17 : 0}>
								{line}
							</tspan>
						))}
					</text>
				</g>
			))
		}
	</svg>
	<figcaption class="cell__cap-text">Сухой гальванический элемент — «батарейка» — в разрезе.</figcaption>
</figure>

<style is:global>
	.cell {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.cell__svg {
		display: block;
		width: 100%;
		max-width: 460px;
		margin-inline: auto;
		height: auto;
	}
	.cell__jacket {
		fill: color-mix(in srgb, var(--ig-vx) 18%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.cell__zinc {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.cell__paste {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-4));
	}
	.cell__mix {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 60%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	:root[data-theme='light'] .cell__mix {
		fill: var(--sl-color-gray-2);
	}
	.cell__seal {
		fill: color-mix(in srgb, var(--ig-vy) 35%, var(--sl-color-gray-4));
	}
	.cell__rod {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	:root[data-theme='light'] .cell__rod {
		fill: var(--sl-color-gray-1);
	}
	.cell__cap {
		fill: var(--ig-v);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.cell__sign {
		fill: var(--sl-color-white);
		font-size: 18px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.cell__label circle {
		fill: var(--sl-color-white);
	}
	.cell__label polyline {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	.cell__label text {
		fill: var(--sl-color-gray-1);
		font-size: 15px;
		font-family: var(--__sl-font);
	}
	.cell__cap-text {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
