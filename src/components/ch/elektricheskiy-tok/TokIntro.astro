---
/**
 * Two short looping opening scenes of «Электрический ток». No numbers and no signs: the scenes show only what one
 * sees; the captions' popovers explain.
 * Switch: an evening room. A hand reaches for the wall switch and presses it; in the same frame the lamp under the
 *   ceiling lights up and the wire hidden in the wall (dashed) carries the current along its whole length at once:
 *   the field spreads along the wires almost at the speed of light, a few metres take some hundredths of a
 *   microsecond. The hand goes away, the lamp keeps burning.
 * Toaster: a side view of a toaster with its wall cut away. The lever goes down with the bread; the thin heating
 *   wires on both sides of each slice warm up and glow red, the bread browns, then the bread pops up and the wires
 *   cool down. The cord to the socket stays grey all the time. A real toaster works a couple of minutes: shown fast.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const gid = `tk-glow-${Math.random().toString(36).slice(2, 8)}`;
// Toaster: three heating panels (zigzag wires), between them two slices of bread.
const COILS = [122, 170, 218].map((x) => {
	const pts: string[] = [];
	for (let k = 0; k <= 11; k++) pts.push(`${x + (k % 2 ? 4 : -4)},${108 + k * 6}`);
	return pts.join(' ');
});
const SLICES = [138, 186];
const SHIMMER = [146, 194];
---

<IntroFrame data-tkintro>
	<div class="intro__card" data-scene="switch">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер, комната. Рука нажимает выключатель на стене, и в тот же миг загорается лампа под потолком, хотя провод к ней идёт в стене через всю комнату">
			<defs>
				<radialGradient id={gid}>
					<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.9"></stop>
					<stop offset="0.35" stop-color="var(--ig-v)" stop-opacity="0.35"></stop>
					<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<rect class="tk-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="tk-ceiling" x="0" y="0" width="360" height="12"></rect>
			<rect class="tk-floor" x="0" y="204" width="360" height="36"></rect>
			<!-- the wire inside the wall: from the switch up to the ceiling and along it to the lamp -->
			<path class="tk-wire" d="M 70 104 V 22 H 250 V 12"></path>
			<path class="tk-wire tk-wire--live" d="M 70 104 V 22 H 250 V 12" data-live></path>
			<!-- the table -->
			<rect class="tk-table" x="196" y="164" width="112" height="8" rx="2"></rect>
			<rect class="tk-table" x="204" y="172" width="7" height="32"></rect>
			<rect class="tk-table" x="293" y="172" width="7" height="32"></rect>
			<rect class="tk-book" x="222" y="154" width="34" height="10" rx="1.5"></rect>
			<path class="tk-cup" d="M 270 146 h 16 v 13 q 0 5 -5 5 h -6 q -5 0 -5 -5 Z M 286 150 q 6 0 6 4 q 0 4 -6 4"></path>
			<!-- the lamp -->
			<line class="tk-cord" x1="250" y1="12" x2="250" y2="42"></line>
			<polygon class="tk-cone" points="232,58 268,58 330,204 170,204" data-cone></polygon>
			<circle cx="250" cy="62" r="46" fill={`url(#${gid})`} class="tk-halo" data-halo></circle>
			<circle class="tk-bulb" cx="250" cy="62" r="8" data-bulb></circle>
			<path class="tk-shade" d="M 238 42 H 262 L 274 60 H 226 Z"></path>
			<!-- the switch: a plate and a rocker; the lit half shows which side is pressed -->
			<rect class="tk-plate" x="54" y="104" width="32" height="38" rx="4"></rect>
			<rect class="tk-rocker" x="61" y="110" width="18" height="26" rx="2"></rect>
			<rect class="tk-rocker-half" x="61" y="110" width="18" height="13" rx="2" data-top></rect>
			<rect class="tk-rocker-half" x="61" y="123" width="18" height="13" rx="2" data-bottom></rect>
			<!-- the hand: the tip of the index finger at (0, 108) -->
			<g data-hand>
				<path class="tk-sleeve" d="M-108 86 L-240 76 V160 L-110 152 Z"></path>
				<rect class="tk-skin" x="-118" y="92" width="64" height="58" rx="18"></rect>
				<rect class="tk-skin" x="-84" y="88" width="34" height="13" rx="6.5"></rect>
				<rect class="tk-skin" x="-60" y="114" width="26" height="30" rx="9"></rect>
				<path class="tk-line" d="M-58 124 h 18 M-58 134 h 18"></path>
				<rect class="tk-skin" x="-62" y="101" width="62" height="14" rx="7"></rect>
				<rect class="tk-nail" x="-11" y="103.5" width="8" height="6" rx="2.5"></rect>
			</g>
			<!-- the darkness of an evening room -->
			<rect class="tk-dark" x="0" y="0" width="360" height="240" data-dark></rect>
		</svg>
		<div class="intro__foot">
			<p>Нажали выключатель — и лампа под потолком загорелась <More term="в тот же миг">Свободные электроны есть в проводах всегда, но, пока выключатель разомкнут, они движутся беспорядочно. Выключатель соединяет провода, и по ним почти со скоростью света — около 300 000 км/с — разносится <b>электрическое поле</b>. Оно сразу приводит в движение электроны во всём проводе, в том числе в лампе. А сами электроны движутся очень медленно: в цепи с батарейкой они продвигаются вдоль провода на доли миллиметра в секунду, а в домашней сети и вовсе лишь качаются туда-сюда. Подробнее — в разделе «Электрический ток в металлах».</More>, хотя провод к ней тянется через всю комнату.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="toaster">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Тостер в разрезе, сбоку. Хлеб опускается, тонкие проволочки между ломтиками раскаляются докрасна, хлеб подрумянивается и выскакивает. Шнур от тостера к розетке всё время остаётся холодным">
			<rect class="tk-wall tk-wall--kitchen" x="0" y="0" width="360" height="240"></rect>
			<rect class="tk-counter" x="0" y="184" width="360" height="56"></rect>
			<line class="tk-counter-edge" x1="0" y1="184" x2="360" y2="184"></line>
			<!-- the socket and the plug -->
			<rect class="tk-socket" x="296" y="96" width="38" height="38" rx="6"></rect>
			<circle class="tk-socket-ring" cx="315" cy="115" r="13"></circle>
			<rect class="tk-plug" x="306" y="106" width="18" height="18" rx="4"></rect>
			<!-- the cord: copper inside insulation; it stays cold -->
			<path class="tk-cordline" d="M 315 124 C 315 160 300 178 276 180 L 234 176"></path>
			<!-- the toaster, its near wall cut away -->
			<rect class="tk-foot" x="108" y="178" width="14" height="6" rx="2"></rect>
			<rect class="tk-foot" x="218" y="178" width="14" height="6" rx="2"></rect>
			<rect class="tk-body" x="100" y="94" width="140" height="86" rx="16"></rect>
			<rect class="tk-inner" x="108" y="100" width="124" height="74" rx="8"></rect>
			<g class="tk-coils">
				{COILS.map((p) => <polyline class="tk-coil" points={p} />)}
			</g>
			<g class="tk-hot" data-hot>
				{COILS.map((p) => <polyline class="tk-coil-glow" points={p} />)}
				{COILS.map((p) => <polyline class="tk-coil-red" points={p} />)}
			</g>
			<g data-bread>
				{
					SLICES.map((x) => (
						<g>
							<path class="tk-bread" d={`M ${x} 130 V 60 q 0 -8 8 -8 q 8 0 8 8 V 130 Z`} />
							<path class="tk-toast" d={`M ${x} 130 V 60 q 0 -8 8 -8 q 8 0 8 8 V 130 Z`} data-toast />
						</g>
					))
				}
			</g>
			<!-- the top of the toaster with the two slots, over the bread -->
			<path class="tk-top" d="M 104 104 Q 104 94 116 94 H 224 Q 236 94 236 104" ></path>
			<rect class="tk-slot" x="135" y="91" width="22" height="6" rx="3"></rect>
			<rect class="tk-slot" x="183" y="91" width="22" height="6" rx="3"></rect>
			<g data-shimmer>
				{SHIMMER.map((x) => <path class="tk-shimmer" d={`M ${x} 84 q -5 -7 0 -14 q 5 -7 0 -14`} />)}
			</g>
			<!-- the lever on the end of the toaster -->
			<rect class="tk-rail" x="242" y="108" width="4" height="58" rx="2"></rect>
			<rect class="tk-lever" x="240" y="108" width="20" height="9" rx="3" data-lever></rect>
			<text class="tk-ding" x="170" y="34" text-anchor="middle" data-ding>дзынь!</text>
		</svg>
		<div class="intro__foot">
			<p>Тостер включили в розетку. Тонкие проволочки внутри <More term="раскаляются докрасна">Это <b>тепловое действие тока</b>. По шнуру и по проволочкам идёт один и тот же ток. Но в шнуре толстые медные жилы, а проволочки тонкие и сделаны из нихрома — сплава, который препятствует току гораздо сильнее, чем медь. Чем сильнее проводник препятствует току, тем больше он нагревается. Подробнее — в разделе <a href="#действия-тока">«Действия тока»</a> и в главе <a href="../sila-toka-napryazhenie-soprotivlenie/#сопротивление">«Сила тока. Напряжение. Сопротивление»</a>.</More>, а шнур остаётся холодным, хотя ток идёт и по нему.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-tkintro] {
		--tk-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--tk-night: var(--sl-color-black);
		--tk-wall: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-5));
		--tk-bread: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-2));
		--tk-toast: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-red-low, #5a2a12));
		--tk-hot: color-mix(in oklab, var(--ig-vy) 70%, var(--ig-v));
		--tk-plate: var(--sl-color-gray-1);
		--tk-rocker: var(--sl-color-gray-3);
	}
	:root[data-theme='light'] [data-tkintro] {
		--tk-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--tk-night: var(--sl-color-white);
		--tk-wall: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-6));
		--tk-bread: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-6));
		--tk-toast: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-1));
		--tk-plate: var(--sl-color-gray-7, #fff);
		--tk-rocker: var(--sl-color-gray-5);
	}
	.tk-wall {
		fill: var(--tk-wall);
	}
	.tk-wall--kitchen {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.tk-ceiling {
		fill: var(--sl-color-gray-4);
	}
	.tk-floor {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.tk-wire {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		stroke-dasharray: 5 4;
	}
	.tk-wire--live {
		stroke: var(--ig-v);
		stroke-width: 2.6;
		stroke-dasharray: none;
		opacity: 0;
	}
	.tk-table {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.tk-book {
		fill: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-4));
	}
	.tk-cup {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.tk-cord {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.tk-shade {
		fill: color-mix(in srgb, var(--ig-vy) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tk-bulb {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tk-cone {
		fill: var(--ig-v);
		opacity: 0;
	}
	.tk-halo {
		opacity: 0;
	}
	.tk-dark {
		fill: var(--tk-night);
		opacity: 0.45;
		pointer-events: none;
	}
	.tk-plate {
		fill: var(--tk-plate);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tk-rocker {
		fill: var(--tk-rocker);
	}
	.tk-rocker-half {
		fill: var(--tk-plate);
		opacity: 0;
	}
	.tk-skin {
		fill: var(--tk-skin);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.tk-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	.tk-nail {
		fill: color-mix(in srgb, var(--sl-color-white) 25%, var(--tk-skin));
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.tk-sleeve {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	/* toaster */
	.tk-counter {
		fill: color-mix(in srgb, var(--ig-v) 20%, var(--sl-color-gray-5));
	}
	.tk-counter-edge {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.tk-socket {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tk-socket-ring {
		fill: var(--sl-color-gray-3);
	}
	.tk-plug {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tk-cordline {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.tk-foot {
		fill: var(--sl-color-gray-4);
	}
	.tk-body {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 30%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.tk-inner {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 85%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.tk-top {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.tk-slot {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tk-coil,
	.tk-coil-red,
	.tk-coil-glow {
		fill: none;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.tk-coil {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	.tk-coil-red {
		stroke: var(--tk-hot);
		stroke-width: 1.8;
	}
	.tk-coil-glow {
		stroke: var(--tk-hot);
		stroke-width: 7;
		opacity: 0.35;
	}
	.tk-hot {
		opacity: 0;
	}
	.tk-bread {
		fill: var(--tk-bread);
		stroke: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-3));
		stroke-width: 1.2;
	}
	.tk-toast {
		fill: var(--tk-toast);
		opacity: 0;
	}
	.tk-shimmer {
		fill: none;
		stroke: var(--tk-hot);
		stroke-width: 1.6;
		stroke-linecap: round;
		opacity: 0;
	}
	.tk-rail {
		fill: var(--sl-color-gray-4);
	}
	.tk-lever {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tk-ding {
		font-size: 17px;
		font-weight: 700;
		fill: var(--ig-v);
		opacity: 0;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-tkintro]')) {
		// Switch: the hand comes (→ 0,3), presses at 0,3: the lamp lights in the same frame; the hand leaves; 4 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="switch"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const hand = $<SVGGElement>('[data-hand]');
			const top = $<SVGRectElement>('[data-top]');
			const bottom = $<SVGRectElement>('[data-bottom]');
			const live = $<SVGPathElement>('[data-live]');
			const cone = $<SVGPolygonElement>('[data-cone]');
			const halo = $<SVGCircleElement>('[data-halo]');
			const bulb = $<SVGCircleElement>('[data-bulb]');
			const dark = $<SVGRectElement>('[data-dark]');
			const PRESS = 0.3;
			scene(card, 4, (x) => {
				const come = 1 - (1 - clamp(x / PRESS)) ** 3; // slows down near the switch
				const away = smooth(0.42, 0.7, x);
				const hx = lerp(lerp(-20, 64, come), -30, away);
				hand.setAttribute('transform', `translate(${f1(hx)} 8)`);
				const on = x >= PRESS;
				// the pressed half of the rocker goes in (dark), the other one sticks out (light)
				top.style.opacity = on ? '0' : '0.8';
				bottom.style.opacity = on ? '0.8' : '0';
				// the wire carries the current along its whole length at once; a short flash, then a steady glow
				const flash = on ? 0.45 + 0.55 * Math.exp(-(x - PRESS) / 0.04) : 0;
				live.style.opacity = f2(flash);
				cone.style.opacity = on ? '0.16' : '0';
				halo.style.opacity = on ? '1' : '0';
				bulb.style.fill = on ? 'var(--ig-v)' : '';
				dark.style.opacity = on ? '0.08' : '0.45';
			});
		}

		// Toaster: the lever down (→ 0,08), the wires glow (→ 0,45), the bread browns, pops up at 0,84; 6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="toaster"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const bread = $<SVGGElement>('[data-bread]');
			const toasts = [...card.querySelectorAll<SVGPathElement>('[data-toast]')];
			const hot = $<SVGGElement>('[data-hot]');
			const shimmer = $<SVGGElement>('[data-shimmer]');
			const lever = $<SVGRectElement>('[data-lever]');
			const ding = $<SVGTextElement>('[data-ding]');
			const POP = 0.84;
			scene(card, 6, (x) => {
				const down = smooth(0, 0.08, x);
				// the pop: a quick jump up with a little overshoot (ease-out-back)
				const p = clamp((x - POP) / 0.05);
				const up = 1 + 2.70158 * (p - 1) ** 3 + 1.70158 * (p - 1) ** 2;
				const sink = down * (1 - up);
				bread.setAttribute('transform', `translate(0 ${f1(46 * sink)})`);
				lever.setAttribute('y', f1(108 + 48 * down * (1 - clamp(p * 1.5))));
				const heat = smooth(0.08, 0.45, x) * (1 - smooth(POP, 1, x));
				hot.style.opacity = f2(heat);
				shimmer.style.opacity = f2(heat * (x < POP ? 1 : 0.5));
				const brown = 0.75 * smooth(0.25, POP, x);
				toasts.forEach((t) => (t.style.opacity = f2(brown)));
				ding.style.opacity = f2(smooth(POP, POP + 0.02, x) * (1 - smooth(0.95, 1, x)));
			});
		}
	}
</script>
