---
/**
 * The parts of a slide rheostat, labelled: the ceramic tube, the winding of nickeline wire, the metal bar, the slider
 * with its sliding contact and the clamps A (the end of the winding) and B (the end of the bar), as in RheostatLamp.
 */
const X0 = 66; // the winding
const X1 = 374;
const turns: number[] = [];
for (let x = X0 + 3; x <= X1 - 2; x += 6) turns.push(x);
const XS = 250; // the slider
---

<figure class="rhs not-content">
	<svg class="rhs__svg" viewBox="0 0 460 250" role="img" aria-label="Ползунковый реостат: на керамический цилиндр намотана никелиновая проволока, над обмоткой — металлический стержень, по которому скользит ползунок; его контакт прижат к виткам. Зажим A соединён с концом обмотки, зажим B — с концом стержня">
		<!-- the posts, the bar and the tube -->
		<rect class="rhs__post" x="40" y="70" width="12" height="110" rx="2"></rect>
		<rect class="rhs__post" x="388" y="70" width="12" height="110" rx="2"></rect>
		<rect class="rhs__tube" x={X0 - 10} y="108" width={X1 - X0 + 20} height="52" rx="12"></rect>
		<g class="rhs__turns">{turns.map((x) => <line x1={x - 3} y1="114" x2={x + 3} y2="154" />)}</g>
		<rect class="rhs__bar" x="44" y="74" width="352" height="8" rx="2"></rect>
		<!-- the clamps -->
		<path class="rhs__lead" d={`M 46 178 H ${X0} V 154`}></path>
		<circle class="rhs__clamp" cx="46" cy="178" r="6"></circle>
		<circle class="rhs__clamp" cx="402" cy="78" r="6"></circle>
		<text class="rhs__ab" x="24" y="184" text-anchor="middle">A</text>
		<text class="rhs__ab" x="420" y="72" text-anchor="middle">B</text>
		<!-- the slider -->
		<path class="rhs__spring" d={`M ${XS} 88 L ${XS - 5} 96 L ${XS + 5} 102 L ${XS - 5} 108 L ${XS} 115`}></path>
		<rect class="rhs__block" x={XS - 15} y="66" width="30" height="22" rx="4"></rect>
		<!-- labels -->
		<g class="rhs__label">
			<circle cx="120" cy="78" r="2.6"></circle>
			<polyline points="120,78 120,40"></polyline>
			<text x="120" y="32" text-anchor="middle">металлический стержень</text>
			<circle cx={XS} cy="66" r="2.6"></circle>
			<polyline points={`${XS},66 ${XS + 44},34 ${XS + 50},34`}></polyline>
			<text x={XS + 54} y="22" text-anchor="start">
				<tspan x={XS + 54} dy="0">ползунок</tspan>
				<tspan x={XS + 54} dy="17">со скользящим</tspan>
				<tspan x={XS + 54} dy="17">контактом</tspan>
			</text>
			<circle cx="150" cy="150" r="2.6"></circle>
			<polyline points="150,150 150,212 130,212"></polyline>
			<text x="126" y="208" text-anchor="end">
				<tspan x="126" dy="0">обмотка из</tspan>
				<tspan x="126" dy="17">никелиновой</tspan>
				<tspan x="126" dy="17">проволоки</tspan>
			</text>
			<circle cx="370" cy="158" r="2.6"></circle>
			<polyline points="370,158 370,212 350,212"></polyline>
			<text x="346" y="208" text-anchor="end">
				<tspan x="346" dy="0">керамический</tspan>
				<tspan x="346" dy="17">цилиндр</tspan>
			</text>
		</g>
	</svg>
	<figcaption class="rhs__cap">Ползунковый реостат. Ток идёт от зажима A по виткам обмотки до ползунка, а дальше по стержню к зажиму B.</figcaption>
</figure>

<style is:global>
	.rhs {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.rhs__svg {
		display: block;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
		height: auto;
	}
	.rhs__post {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rhs__tube {
		fill: color-mix(in srgb, var(--ig-v) 14%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.rhs__turns line {
		stroke: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-3));
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.rhs__bar {
		fill: var(--sl-color-gray-2);
	}
	.rhs__lead {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.rhs__clamp {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
	}
	.rhs__ab {
		fill: var(--sl-color-white);
		font-size: 16px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.rhs__spring {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.rhs__block {
		fill: var(--ig-vx);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.rhs__label circle {
		fill: var(--sl-color-white);
	}
	.rhs__label polyline {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	.rhs__label text {
		fill: var(--sl-color-gray-1);
		font-size: 15px;
		font-family: var(--__sl-font);
	}
	.rhs__cap {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
