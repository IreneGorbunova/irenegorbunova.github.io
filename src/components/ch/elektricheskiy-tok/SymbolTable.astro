---
/**
 * A table of circuit symbols: the parts of the builder plus a rheostat, a junction and a crossing of wires.
 * `kinds` picks and orders the symbols (all by default): builder kinds from symbols.ts and 'rheostat', 'junction',
 * 'crossing'; `caption` replaces the default caption.
 */
import { PARTS, icon } from './symbols';

interface Props {
	kinds?: string[];
	caption?: string;
}
const {
	kinds,
	caption = 'Условные обозначения на электрических схемах. У источника длинная тонкая черта — «+», короткая толстая — «−».',
} = Astro.props;
const extra = [
	{
		kind: 'rheostat',
		name: 'реостат',
		svg: '<line class="cb__w" x1="-45" y1="0" x2="-21" y2="0"/><line class="cb__w" x1="21" y1="0" x2="45" y2="0"/><rect class="cb__ring" x="-21" y="-8" width="42" height="16"/><line class="cb__w" x1="-14" y1="16" x2="12" y2="-14"/><path class="cb__tip" d="M 16 -19 L 6 -14 L 13 -8 Z"/>',
	},
	{
		kind: 'junction',
		name: 'соединение проводов',
		svg: '<line class="cb__w" x1="-45" y1="0" x2="45" y2="0"/><line class="cb__w" x1="0" y1="0" x2="0" y2="22"/><circle class="cb__dot" cx="0" cy="0" r="4"/>',
	},
	{
		kind: 'crossing',
		name: 'пересечение проводов без соединения',
		svg: '<line class="cb__w" x1="-45" y1="0" x2="45" y2="0"/><line class="cb__w" x1="0" y1="-22" x2="0" y2="22"/>',
	},
];
const all = [
	...PARTS.filter((p) => p.kind !== 'empty').map((p) => ({ kind: p.kind as string, name: p.name, html: icon(p.kind) })),
	...extra.map((e) => ({ kind: e.kind, name: e.name, html: `<svg class="cb__icon" viewBox="-48 -26 96 52" aria-hidden="true">${e.svg}</svg>` })),
];
const items = kinds ? kinds.map((k) => all.find((it) => it.kind === k)!).filter(Boolean) : all;
---

<figure class="symtab not-content">
	<ul class="symtab__list">
		{
			items.map((it) => (
				<li class="symtab__item">
					<Fragment set:html={it.html} />
					<span>{it.name}</span>
				</li>
			))
		}
	</ul>
	<figcaption class="symtab__cap">{caption}</figcaption>
</figure>

<style is:global>
	.symtab {
		margin-block: 1.5rem;
		padding: 0.8rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.symtab__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
		gap: 0.6rem;
	}
	.symtab__item {
		display: grid;
		justify-items: center;
		align-content: start;
		gap: 0.2rem;
		margin: 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		line-height: 1.25;
		color: var(--sl-color-gray-2);
	}
	.symtab .cb__icon {
		width: 5rem;
		height: auto;
	}
	.symtab .cb__w {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.symtab .cb__plate {
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
	}
	.symtab .cb__plate--minus {
		stroke-width: 5;
	}
	.symtab .cb__dash {
		stroke: var(--sl-color-white);
		stroke-width: 1.5;
		stroke-dasharray: 3 3;
	}
	.symtab .cb__pm,
	.symtab .cb__letter {
		fill: var(--sl-color-white);
		font-size: 15px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.symtab .cb__lever {
		stroke: var(--sl-color-white);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.symtab .cb__contact {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.symtab .cb__ring {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
	}
	.symtab .cb__glow {
		display: none;
	}
	.symtab .cb__tip,
	.symtab .cb__dot {
		fill: var(--sl-color-white);
	}
	.symtab__cap {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
