		stroke: var(--st-ink);
		stroke-width: 0.8;
	}
	.st-dc--dash {
		stroke-dasharray: 1.4 0.9;
	}
	.st-cable {
		fill: none;
		stroke: var(--st-plastic);
		stroke-width: 3;
		stroke-linecap: round;
	}
