		fill: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.st-phone {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.st-screen {
		fill: var(--st-screen-off);
	}
	.st-batt {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.st-batt-tip {
		fill: var(--sl-color-gray-2);
	}
	.st-batt-fill {
		fill: var(--sl-color-green, #3fb950);
	}
	.st-bolt {
		fill: var(--ig-v);
	}
	.st-plug {
		fill: var(--st-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.st-plug-tip {
		fill: var(--sl-color-gray-3);
	}
	.st-lens-glass {
		fill: none;
	}
	.st-lens-rim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3.5;
	}
	.st-lens-handle {
		stroke: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-3));
		stroke-width: 7;
		stroke-linecap: round;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-stintro]')) {
		// Bird: flies in (→ 0,42), lands on the upper wire, looks around, turns round with a hop at 0,8; 6 s
		{
			const RUN = 6;
			const X0 = 26;
			const X1 = 334;
			const Y = 64;
			const C = 118;
			const SIT = 196;
			const LAND = 0.42;
			const card = root.querySelector<HTMLElement>('[data-scene="bird"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const bird = $<SVGGElement>('[data-bird]');
			const flip = $<SVGGElement>('[data-flip]');
			const head = $<SVGGElement>('[data-head]');
			const open = $<SVGPathElement>('[data-open]');
			const folded = $<SVGPathElement>('[data-folded]');
			const legs = $<SVGPathElement>('[data-legs]');
			const tail = $<SVGPathElement>('[data-tail]');
			const at = (x: number, c: number) => {
				const t = (x - X0) / (X1 - X0);
				return { y: Y + 2 * t * (1 - t) * (c - Y), slope: (2 * (c - Y) * (1 - 2 * t)) / (X1 - X0) };
			};
			scene(card, RUN, (x) => {
				const c = C; // a sparrow is far too light to bend a heavy wire visibly
				const w = at(SIT, c);
				let bx: number;
				let by: number;
				let rot: number;
				if (x < LAND) {
					// glide in from the upper right, slowing down near the wire
					const u = clamp(x / LAND);
					const e = 1 - (1 - u) ** 2;
					bx = lerp(392, SIT, e);
					by = lerp(14, w.y, e) - 26 * Math.sin(Math.PI * e) * (1 - e);
					rot = lerp(-14, 0, e);
				} else {
					bx = SIT;
					by = w.y;
					rot = (Math.atan(w.slope) * 180) / Math.PI;
				}
				// a little hop when turning round at 0,8
				const hop = Math.sin(Math.PI * clamp((x - 0.78) / 0.05));
				bird.setAttribute('transform', `translate(${f1(bx)} ${f1(by - 6 * hop)}) rotate(${f1(rot)})`);
				const turned = x >= 0.805;
				flip.setAttribute('transform', turned ? 'scale(-1 1)' : '');
				// wings: flapping in flight, spread to brake before landing, folded when sitting
				const flying = x < LAND;
				const brake = x > LAND * 0.8;
				const flap = brake ? 0.95 : Math.cos(2 * Math.PI * 7 * x * RUN);
				open.style.display = flying ? '' : 'none';
				open.setAttribute('transform', `translate(0 -12) scale(1 ${f2(flap)}) translate(0 12)`);
				folded.style.display = flying ? 'none' : '';
				legs.style.display = x > LAND * 0.85 ? '' : 'none';
				// the head: looks up a little, then down at the ground, then straight
				const look = -14 * smooth(0.56, 0.6, x) * (1 - smooth(0.66, 0.7, x)) + 16 * smooth(0.88, 0.92, x) * (1 - smooth(0.96, 1, x));
				head.setAttribute('transform', `rotate(${f1(look)} -7 -12)`);
				// the other sparrow flicks its tail now and then
				const flick = 10 * Math.sin(Math.PI * clamp((x - 0.3) / 0.04)) + 10 * Math.sin(Math.PI * clamp((x - 0.7) / 0.04));
				tail.setAttribute('transform', `rotate(${f1(-flick)} 6 -6)`);
			});
		}

		// Charger: the plug goes in (→ 0,12), the screen lights up, the battery fills; the lens comes (0,3 → 0,55); 6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="charger"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const plug = $<SVGGElement>('[data-plug]');
			const cable = $<SVGPathElement>('[data-cable]');
			const screen = $<SVGRectElement>('[data-screen]');
			const battery = $<SVGGElement>('[data-battery]');
			const fill = $<SVGRectElement>('[data-fill]');
			const lens = $<SVGGElement>('[data-lens]');
			const clip = $<SVGCircleElement>('[data-clip]');
			const zoom = $<SVGGElement>('[data-zoom]');
			const K = 2.4; // the lens magnifies 2,4 times
			const LX = 82;
			const LY = 98;
			scene(card, 6, (x) => {
				const inn = smooth(0.02, 0.12, x);
				const d = 12 * (1 - inn); // the plug rises by 12 into the phone's port
				plug.setAttribute('transform', `translate(0 ${f1(d)})`);
				cable.setAttribute('d', `M 82 122 C 82 170 120 188 170 188 C 230 188 263 ${f1(196 + d)} 263 ${f1(176 + d)}`);
				const on = x >= 0.12;
				screen.style.fill = on ? 'var(--st-screen-on)' : '';
				battery.style.opacity = on ? '1' : '0';
				fill.setAttribute('width', f1(on ? lerp(3, 16, smooth(0.12, 1, x)) : 3));
				// the lens: from the upper right to over the charger's label
				const m = smooth(0.3, 0.55, x);
				const cx = lerp(214, LX, m);
				const cy = lerp(40, LY, m);
				lens.setAttribute('transform', `translate(${f1(cx)} ${f1(cy)})`);
				clip.setAttribute('cx', f1(cx));
				clip.setAttribute('cy', f1(cy));
				zoom.setAttribute('transform', `translate(${f1(cx)} ${f1(cy)}) scale(${K}) translate(${f1(-cx)} ${f1(-cy)})`);
			});
		}
	}
</script>
