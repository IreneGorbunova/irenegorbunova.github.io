---
/**
 * A slide rheostat in series with a lamp, a source 6 В and an ammeter.
 * The current enters the winding at the left clamp, goes through the turns up to the slider, then along the
 * metal bar to the right clamp: only the turns to the left of the slider are in the circuit.
 * Rheostat 0–30 Ом, lamp 12 Ом (taken constant), I = U / (R_lamp + R_rheostat): 0,14–0,5 А.
 */
const X0 = 100; // left end of the winding
const X1 = 420; // right end of the winding
const turns: number[] = [];
for (let x = X0 + 3; x <= X1 - 2; x += 6) turns.push(x);
const R0 = 10;
const xs0 = X0 + (R0 / 30) * (X1 - X0);
const gid = `rh-glow-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="rh not-content" data-rh>
	<svg class="rh__svg" viewBox="0 0 560 300" role="img" aria-label="Ползунковый реостат, лампа, амперметр и источник соединены последовательно">
		<defs>
			<radialGradient id={gid}>
				<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.95"></stop>
				<stop offset="0.35" stop-color="var(--ig-v)" stop-opacity="0.45"></stop>
				<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
			</radialGradient>
		</defs>
		<!-- wires -->
		<g class="rh__wires">
			<path d="M 84 176 H 40 V 254 H 136"></path>
			<path d="M 150 254 H 306"></path>
			<path d="M 354 254 H 446"></path>
			<path d="M 494 254 H 524 V 82 H 452"></path>
		</g>
		<path class="rh__flow" d="M 136 254 H 40 V 176 H 84" data-flow></path>
		<path class="rh__flow" d="M 452 82 H 524 V 254 H 150" data-flow></path>

		<!-- rheostat: posts, bar, ceramic tube with the winding -->
		<rect class="rh__post" x="80" y="74" width="10" height="100" rx="2"></rect>
		<rect class="rh__post" x="430" y="74" width="10" height="100" rx="2"></rect>
		<rect class="rh__tube" x={X0 - 8} y="118" width={X1 - X0 + 16} height="44" rx="10"></rect>
		<g class="rh__turns">{turns.map((x) => <line x1={x - 3} y1="120" x2={x + 3} y2="160" data-x={x} />)}</g>
		<rect class="rh__bar" x="84" y="78" width="356" height="8" rx="2"></rect>
		<circle class="rh__clamp" cx="84" cy="176" r="6"></circle>
		<circle class="rh__clamp" cx="446" cy="82" r="6"></circle>
		<text class="rh__cap" x="84" y="200" text-anchor="middle">A</text>
		<text class="rh__cap" x="460" y="70" text-anchor="middle">B</text>
		<path class="rh__lead" d={`M 84 176 H ${X0} V 160`}></path>

		<g class="rh__slider" transform={`translate(${xs0} 0)`} data-slider tabindex="0" role="slider" aria-label="Ползунок реостата" aria-valuemin="0" aria-valuemax="30" aria-valuenow={R0}>
			<rect class="rh__hit" x="-26" y="56" width="52" height="70"></rect>
			<path class="rh__spring" d="M 0 92 L -5 100 L 5 106 L -5 112 L 0 119"></path>
			<rect class="rh__block" x="-15" y="70" width="30" height="22" rx="4"></rect>
			<line class="rh__grip" x1="-6" y1="75" x2="-6" y2="87"></line>
			<line class="rh__grip" x1="0" y1="75" x2="0" y2="87"></line>
			<line class="rh__grip" x1="6" y1="75" x2="6" y2="87"></line>
		</g>
		<text class="rh__read rh__read--r" x={xs0} y="50" text-anchor="middle" data-read-r>R = 10 Ом</text>
		<text class="rh__cap" x="260" y="184" text-anchor="middle">реостат 30 Ом, 2 А</text>

		<!-- source -->
		<rect class="rh__bg" x="133" y="232" width="20" height="44"></rect>
		<line class="rh__plate" x1="137" y1="234" x2="137" y2="274"></line>
		<line class="rh__plate rh__plate--minus" x1="149" y1="244" x2="149" y2="264"></line>
		<text class="rh__sign" x="126" y="232" text-anchor="middle">+</text>
		<text class="rh__sign" x="160" y="232" text-anchor="middle">−</text>
		<text class="rh__cap" x="143" y="292" text-anchor="middle">6 В</text>

		<!-- lamp -->
		<circle class="rh__halo" cx="330" cy="254" r="70" fill={`url(#${gid})`} data-halo></circle>
		<circle class="rh__bulb" cx="330" cy="254" r="22"></circle>
		<path class="rh__fil" d="M 309 254 H 318 L 321 246 L 325 262 L 329 246 L 333 262 L 337 246 L 340 254 H 351" data-fil></path>
		<text class="rh__cap" x="330" y="292" text-anchor="middle">лампа</text>

		<!-- ammeter -->
		<circle class="rh__face" cx="470" cy="254" r="22"></circle>
		<text class="rh__letter" x="470" y="260" text-anchor="middle">A</text>
		<text class="rh__pm" x="500" y="242" text-anchor="middle">+</text>
		<text class="rh__pm" x="440" y="242" text-anchor="middle">−</text>
		<text class="rh__read rh__read--i" x="470" y="222" text-anchor="middle" data-read-i>0,27 А</text>
	</svg>
	<label class="rh__range">
		<span>Ползунок реостата: включено <output data-r-out>10 Ом</output></span>
		<input type="range" min="0" max="30" step="1" value={R0} data-r />
	</label>
	<figcaption class="rh__legend">
		Тяните ползунок прямо на рисунке. Ток идёт от зажима A по виткам проволоки до ползунка, а дальше по металлическому
		стержню к зажиму B. Работают только витки слева от ползунка — они подсвечены.
	</figcaption>
</figure>

<style is:global>
	.rh {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.rh__svg {
		display: block;
		width: 100%;
		max-width: 620px;
		margin-inline: auto;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-y;
	}
	.rh__wires path,
	.rh__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.rh__flow {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2.5;
		stroke-dasharray: 3 15;
		stroke-linecap: round;
		opacity: 0.9;
		animation: rh-flow var(--rh-period, 2s) linear infinite;
	}
	@keyframes rh-flow {
		to {
			stroke-dashoffset: -18;
		}
	}
	.rh__post {
		fill: var(--sl-color-gray-4);
	}
	.rh__tube {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 60%, var(--ig-surface));
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.rh__turns line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-linecap: round;
		transition: stroke 0.15s;
	}
	.rh__turns line.is-on {
		stroke: var(--ig-v);
	}
	.rh__bar {
		fill: var(--sl-color-gray-2);
	}
	.rh__clamp {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.rh__slider {
		cursor: grab;
		outline: none;
	}
	.rh__slider:focus-visible .rh__block {
		stroke: var(--sl-color-accent);
		stroke-width: 3;
	}
	.rh__hit {
		fill: transparent;
	}
	.rh__block {
		fill: var(--ig-v);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.rh__grip {
		stroke: var(--sl-color-black);
		stroke-width: 1.5;
		opacity: 0.6;
	}
	.rh__spring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.rh__bg {
		fill: var(--ig-surface);
	}
	.rh__plate {
		stroke: var(--sl-color-white);
		stroke-width: 2.5;
	}
	.rh__plate--minus {
		stroke-width: 6;
	}
	.rh__sign,
	.rh__pm {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.rh__cap {
		fill: var(--sl-color-gray-3);
		font-size: 15px;
		font-family: var(--__sl-font);
	}
	.rh__halo {
		opacity: 0;
		transition: opacity 0.2s;
		pointer-events: none;
	}
	.rh__bulb {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.rh__fil {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.rh__face {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.rh__letter {
		fill: var(--sl-color-white);
		font-size: 17px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.rh__read {
		font-size: 19px;
		font-weight: 700;
		font-family: var(--__sl-font);
		font-variant-numeric: tabular-nums;
	}
	.rh__read--r {
		fill: var(--ig-v);
	}
	.rh__read--i {
		fill: var(--ig-vx);
	}
	.rh__range {
		display: grid;
		gap: 0.25rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rh__range output {
		font-weight: 700;
		color: var(--ig-v);
	}
	.rh__range input {
		width: 100%;
		accent-color: var(--ig-v);
	}
	.rh__legend {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	@media (prefers-reduced-motion: reduce) {
		.rh__flow {
			animation: none;
		}
	}
</style>

<script>
	import { fixed } from './et';

	const X0 = 100;
	const X1 = 420;
	const U = 6;
	const RL = 12;
	for (const root of document.querySelectorAll<HTMLElement>('[data-rh]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = $<SVGSVGElement>('svg');
		const slider = $<SVGGElement>('[data-slider]');
		const input = $<HTMLInputElement>('[data-r]');
		const turns = [...root.querySelectorAll<SVGLineElement>('.rh__turns line')];
		const halo = $<SVGCircleElement>('[data-halo]');
		const fil = $<SVGPathElement>('[data-fil]');
		const readR = $<SVGTextElement>('[data-read-r]');
		const readI = $<SVGTextElement>('[data-read-i]');
		const out = $<HTMLOutputElement>('[data-r-out]');

		const set = (r: number) => {
			r = Math.round(Math.min(30, Math.max(0, r)));
			const x = X0 + (r / 30) * (X1 - X0);
			slider.setAttribute('transform', `translate(${x} 0)`);
			slider.setAttribute('aria-valuenow', String(r));
			slider.setAttribute('aria-valuetext', `${r} Ом`);
			readR.setAttribute('x', String(Math.min(Math.max(x, 70), 470)));
			readR.textContent = `R = ${r} Ом`;
			out.textContent = `${r} Ом`;
			input.value = String(r);
			turns.forEach((t) => t.classList.toggle('is-on', Number(t.dataset.x) < x));
			const I = U / (RL + r);
			readI.textContent = `${fixed(I, 2)} А`;
			const p = (I * I * RL) / ((U / RL) ** 2 * RL); // power of the lamp relative to the maximum (r = 0)
			halo.style.opacity = String(Math.pow(p, 0.8));
			fil.style.strokeWidth = String(1.6 + 1.4 * p);
			fil.style.filter = `brightness(${0.55 + 0.6 * p})`;
			root.style.setProperty('--rh-period', `${(0.36 / I).toFixed(2)}s`);
		};

		const toR = (e: PointerEvent) => {
			const pt = svg.createSVGPoint();
			pt.x = e.clientX;
			pt.y = e.clientY;
			const p = pt.matrixTransform(svg.getScreenCTM()!.inverse());
			return ((p.x - X0) / (X1 - X0)) * 30;
		};
		let drag = false;
		slider.addEventListener('pointerdown', (e) => {
			drag = true;
			slider.setPointerCapture(e.pointerId);
			e.preventDefault();
		});
		slider.addEventListener('pointermove', (e) => drag && set(toR(e)));
		slider.addEventListener('pointerup', () => (drag = false));
		slider.addEventListener('pointercancel', () => (drag = false));
		root.querySelector('.rh__tube')!.addEventListener('pointerdown', (e) => set(toR(e as PointerEvent)));
		slider.addEventListener('keydown', (e) => {
			const r = Number(input.value);
			if (e.key === 'ArrowRight' || e.key === 'ArrowUp') set(r + 1);
			else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') set(r - 1);
			else return;
			e.preventDefault();
		});
		input.addEventListener('input', () => set(Number(input.value)));
		set(Number(input.value));
	}
</script>
