---
/**
 * «Чтобы разделить ядро, нужна энергия»: a loop of 9 с in two halves, the deuteron (one proton + one neutron).
 *   0–4,5 с: the deuteron (two touching balls, 1,9 фм apart, drawn at 10 px per фм) is hit by a gold wave of energy
 *     coming from the left; the balls separate and drift apart; «нужно сообщить энергию связи».
 *   4,5–9 с: a free proton and a free neutron come together and stick; a gold wavy γ flies away to the right;
 *     «выделяется та же энергия».
 * No numbers in the picture (the deuteron's binding energy, 3,6·10⁻¹³ Дж, is the worked task of the section). Gold =
 * energy, as everywhere in the chapter.
 */
import G7Styles from '../g7/G7Styles.astro';
import NucStyles from './NucStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const gid = (s: string) => `bep-${s}-${uid}`;
---

<G7Styles />
<NucStyles />
<figure class="g7 g7--pic nucf bep not-content" data-bindpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 150" role="img" aria-label="Ядро дейтерия — протон и нейтрон. Чтобы разделить их, нужно сообщить энергию: волна энергии приходит, частицы расходятся. Когда протон и нейтрон соединяются, выделяется та же энергия — улетает гамма-излучение">
			<defs>
				<radialGradient id={gid('p')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-p0"></stop><stop offset="1" class="nuc-p1"></stop></radialGradient>
				<radialGradient id={gid('n')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-n0"></stop><stop offset="1" class="nuc-n1"></stop></radialGradient>
			</defs>
			<path class="bep-wave" data-wave d=""></path>
			<g data-p><circle r="9.5" fill={`url(#${gid('p')})`}></circle><path class="nuc-plus" d="M-4.3 0 H4.3 M0 -4.3 V4.3" stroke-width="1.6"></path></g>
			<g data-n><circle r="9.5" fill={`url(#${gid('n')})`}></circle></g>
			<text class="t-title" data-l1 x="200" y="30" text-anchor="middle">нужно сообщить энергию связи</text>
			<text class="t-title" data-l2 x="200" y="30" text-anchor="middle" opacity="0">выделяется та же энергия</text>
			<text class="t-small bep-k" x="16" y="136">энергия</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Золотая волна — энергия. Движение частиц замедлено; протон и нейтрон сильно увеличены.</figcaption>
</figure>

<style is:global>
	.bep .bep-wave {
		fill: none;
		stroke: var(--nuc-g);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.bep .bep-k {
		fill: var(--nuc-g);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const RUN = 9;
	const ease = (a: number, b: number, t: number) => {
		const x = Math.min(1, Math.max(0, (t - a) / (b - a)));
		return x * x * (3 - 2 * x);
	};
	/** a wave packet along x from x0 to x1 at height y */
	const wave = (x0: number, x1: number, y: number) => {
		let d = '';
		for (let x = x0; x <= x1; x += 2) d += `${d ? 'L' : 'M'}${x.toFixed(1)} ${(y + 6 * Math.sin((x - x0) * 0.35) * Math.sin((Math.PI * (x - x0)) / (x1 - x0))).toFixed(1)}`;
		return d;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-bindpic]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const p = $<SVGGElement>('[data-p]');
		const n = $<SVGGElement>('[data-n]');
		const w = $<SVGPathElement>('[data-wave]');
		const C = { x: 200, y: 82 };
		const D = 9.5; // half the distance of the touching balls
		let t = 0;
		const draw = () => {
			const u = t % RUN;
			let half = 0;
			let wd = '';
			if (u < 4.5) {
				// the wave comes in 0,3 … 1,5 с, the balls part 1,5 … 3,5 с
				const head = 20 + (C.x - 20) * ease(0.3, 1.5, u);
				if (u > 0.3 && u < 1.6) wd = wave(Math.max(10, head - 60), head, C.y);
				half = D + 120 * ease(1.5, 3.5, u);
			} else {
				// the balls come together 4,7 … 6,3 с, a γ wave leaves 6,3 … 8 с
				half = D + 120 * (1 - ease(4.7, 6.3, u));
				if (u > 6.3 && u < 8) {
					const head = C.x + 10 + 200 * ease(6.3, 8, u);
					wd = wave(Math.max(C.x + 10, head - 60), head, C.y);
				}
			}
			p.setAttribute('transform', `translate(${(C.x - half).toFixed(1)} ${C.y})`);
			n.setAttribute('transform', `translate(${(C.x + half).toFixed(1)} ${C.y})`);
			w.setAttribute('d', wd);
			$<SVGTextElement>('[data-l1]').setAttribute('opacity', String(u < 4.5 ? ease(0.2, 0.6, u) : 0));
			$<SVGTextElement>('[data-l2]').setAttribute('opacity', String(u >= 4.5 ? ease(6.2, 6.6, u) : 0));
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
