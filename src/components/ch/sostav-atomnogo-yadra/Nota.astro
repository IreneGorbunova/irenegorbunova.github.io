---
/**
 * The notation of a nucleus inside an SVG, ᴬ_Z X: the mass number A (accent color) above and the charge number Z (the
 * color of protons) below, both right-aligned before the symbol; the symbol in the text color. (x, y) is the baseline at
 * the left edge of the symbol; `size` the symbol's font size in px. Used by the pictures and models of this chapter.
 */
interface Props {
	x: number;
	y: number;
	A: number | string;
	Z: number | string;
	X: string;
	size?: number;
	[key: `data-${string}`]: string | number | undefined;
}
const { x, y, A, Z, X, size = 17, ...rest } = Astro.props;
const k = size * 0.62;
---

<g class="nota" {...rest}>
	<text class="nota-a" x={x - 1.5} y={y - size * 0.42} text-anchor="end" style={`font-size:${k}px`}>{A}</text>
	<text class="nota-z" x={x - 1.5} y={y + size * 0.22} text-anchor="end" style={`font-size:${k}px`}>{Z}</text>
	<text class="nota-x" x={x} y={y} style={`font-size:${size}px`}>{X}</text>
</g>
