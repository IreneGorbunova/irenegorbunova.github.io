---
/**
 * «Опыт Резерфорда 1919 года», a labelled school scheme, side view, to scale 25 px per см: a closed box 10 см long
 * filled with nitrogen (faint dots), an α source on a holder at the left, an opening in the right wall covered by a thin
 * silver foil, a zinc sulfide screen right behind it and a microscope looking at the screen.
 * Loop of 3 с: α particles leave the source (6 per second drawn, a cone of ±10°) and stop in the gas after about 7 см
 * (ranges 6,6–7,2 см; the real range of Rutherford's α particles in air was about 7 см), so none reaches the foil. Once
 * per loop one α particle hits a nitrogen nucleus 4 см from the source (a small flash) and a proton flies on (one red
 * ball, smaller than the α particle), passes the foil and makes a small green flash on the screen. The knocked-out
 * protons flew up to 28 см in air, far more than the box. A round magnified inset shows the hit in step: the α particle
 * (2 protons + 2 neutrons) joins the nitrogen nucleus (7 + 7) and one proton flies out (the rest is oxygen-17; not named
 * in the picture). The flight is slowed down: real α particles cross the box in about 5·10⁻⁹ с.
 */
import G7Styles from '../g7/G7Styles.astro';
import NucStyles from './NucStyles.astro';
import { pack } from './nucleus';

const N14 = pack(14, 7, 4);
const O17 = pack(17, 8, 4);
const GAS = Array.from({ length: 60 }, (_, k) => [34 + ((k * 61) % 244), 54 + ((k * 37) % 74)]);
const uid = Math.random().toString(36).slice(2, 8);
const gid = (s: string) => `pdp-${s}-${uid}`;
---

<G7Styles />
<NucStyles />
<figure class="g7 g7--pic nucf pdp not-content" data-protondisc data-n14={JSON.stringify(N14)} data-o17={JSON.stringify(O17)}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 214" role="img" aria-label="Схема опыта: закрытый ящик с азотом, слева источник альфа-частиц, справа окно, закрытое тонкой фольгой, за ним экран и микроскоп. Альфа-частицы останавливаются в газе, не долетая до фольги; изредка одна из них попадает в ядро азота, и из него вылетает протон, который проходит фольгу и даёт вспышку на экране">
			<defs>
				<radialGradient id={gid('p')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-p0"></stop><stop offset="1" class="nuc-p1"></stop></radialGradient>
				<radialGradient id={gid('n')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-n0"></stop><stop offset="1" class="nuc-n1"></stop></radialGradient>
				<clipPath id={gid('inset')}><circle cx="344" cy="44" r="36"></circle></clipPath>
			</defs>
			<!-- the box (inner 10 см × 3,2 см) with nitrogen -->
			<rect class="pdp-gas" x="30" y="50" width="250" height="80"></rect>
			{GAS.map(([x, y]) => <circle class="pdp-dot" cx={x} cy={y} r="1" />)}
			<path class="pdp-wall" d="M30 50 H280 V78 M280 102 V130 H30 V50"></path>
			<path class="pdp-foil" d="M281 78 V102"></path>
			<!-- the source on a holder -->
			<rect class="pdp-holder" x="34" y="86" width="10" height="44"></rect>
			<circle class="pdp-src" cx="44" cy="90" r="3.4"></circle>
			<!-- the screen and the microscope -->
			<rect class="pdp-screen" x="286" y="74" width="4" height="32" rx="1"></rect>
			<circle class="pdp-flash" data-flash cx="288" cy="90" r="5" opacity="0"></circle>
			<path class="pdp-scope" d="M296 84 H360 V96 H296 Z M360 81 H384 V99 H360 Z"></path>
			<rect class="pdp-lens" x="294" y="85" width="3" height="10"></rect>
			<!-- particles -->
			<g data-alphas></g>
			<circle class="pdp-hit" data-hit r="6" opacity="0"></circle>
			<path class="pdp-ptrack" data-ptrack d=""></path>
			<circle class="pdp-proton" data-proton r="2.2" opacity="0"></circle>
			<path class="pdp-stop" d="M219 54 V134"></path>
			<!-- labels -->
			<text class="t-small" x="36" y="44">азот</text>
			<text class="t-small" x="22" y="146">источник α-частиц</text>
			<text class="t-small" x="219" y="146" text-anchor="middle">α-частицы</text>
			<text class="t-small" x="219" y="158" text-anchor="middle">останавливаются</text>
			<text class="t-small t-red" data-plabel x="232" y="106" opacity="0">протон</text>
			<text class="t-small" x="262" y="44">фольга</text>
			<path class="pdp-lead" d="M276 48 L281 76"></path>
			<text class="t-small" x="270" y="176">экран</text>
			<path class="pdp-lead" d="M284 166 L288 108"></path>
			<text class="t-small" x="316" y="118">микроскоп</text>
			<text class="t-small t-green" x="300" y="136" data-flabel opacity="0">вспышка</text>
			<!-- the scale bar: 10 см -->
			<path class="pdp-bar" d="M30 182 V188 M30 185 H280 M280 182 V188"></path>
			<text class="t-small" x="155" y="201" text-anchor="middle">10 см</text>
			<!-- the inset: the hit, magnified -->
			<circle class="pdp-inset" cx="344" cy="44" r="36"></circle>
			<g clip-path={`url(#${gid('inset')})`}><g data-inset></g></g>
			<circle class="pdp-rim" cx="344" cy="44" r="36"></circle>
			<path class="pdp-lead" data-ilink d="M312 60 L170 88"></path>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Движение частиц сильно замедлено. В круге — увеличенное попадание: α-частица (2&nbsp;протона и 2&nbsp;нейтрона) налетает на ядро азота (7&nbsp;протонов и 7&nbsp;нейтронов), и из ядра вылетает протон. Если вместо азота в ящике кислород, вспышек на экране нет.
	</figcaption>
</figure>

<style is:global>
	.pdp .pdp-gas {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
	}
	.pdp .pdp-dot {
		fill: var(--sl-color-gray-4);
	}
	.pdp .pdp-wall {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.pdp .pdp-foil {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.pdp .pdp-holder {
		fill: var(--sl-color-gray-4);
	}
	.pdp .pdp-src,
	.pdp .pdp-an {
		fill: var(--nuc-n);
	}
	.pdp .pdp-a,
	.pdp .pdp-proton {
		fill: var(--nuc-p);
	}
	.pdp .pdp-screen {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 60%, var(--g7-green));
	}
	.pdp .pdp-flash {
		fill: var(--g7-green);
	}
	.pdp .t-green {
		fill: var(--g7-green);
	}
	.pdp .pdp-scope {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.pdp .pdp-lens {
		fill: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-gray-3));
	}
	.pdp .pdp-hit {
		fill: color-mix(in srgb, var(--ig-v) 70%, white);
	}
	.pdp .pdp-ptrack {
		fill: none;
		stroke: color-mix(in srgb, var(--nuc-p) 60%, transparent);
		stroke-width: 1.2;
		stroke-dasharray: 3 2;
	}
	.pdp .pdp-stop {
		stroke: color-mix(in srgb, var(--nuc-p) 45%, transparent);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.pdp .pdp-lead,
	.pdp .pdp-bar {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.pdp .pdp-inset {
		fill: var(--sl-color-bg);
	}
	.pdp .pdp-rim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
</style>

<script>
	import { loop, rng } from '../g7/kit';
	import { drawNucleus, type Nucleon } from './nucleus';

	const NS = 'http://www.w3.org/2000/svg';
	const CYCLE = 3;
	for (const root of document.querySelectorAll<HTMLElement>('[data-protondisc]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const grads = [...root.querySelectorAll('radialGradient')].map((g) => `url(#${g.id})`);
		const fills: [string, string] = [grads[1], grads[0]];
		const N14 = JSON.parse(root.dataset.n14!) as Nucleon[];
		const O17 = JSON.parse(root.dataset.o17!) as Nucleon[];
		const SRC = { x: 44, y: 90 };
		const PX = 25; // px per см
		// α particles: 18 per loop (6 per second), each flies 0,9 с to its range and fades
		const R = rng(7);
		const alphas = Array.from({ length: 18 }, (_, i) => ({ t0: (i * CYCLE) / 18, a: (R() * 2 - 1) * 0.17, range: (6.6 + 0.6 * R()) * PX }));
		const ag = $<SVGGElement>('[data-alphas]');
		// an α particle: 2 protons (red) + 2 neutrons (gray) stuck together, so it differs from the single red proton
		const mkAlpha = () => {
			const g = document.createElementNS(NS, 'g');
			g.innerHTML = '<circle class="pdp-a" cx="-1.4" cy="-1.4" r="1.7"></circle><circle class="pdp-an" cx="1.4" cy="-1.4" r="1.7"></circle><circle class="pdp-an" cx="-1.4" cy="1.4" r="1.7"></circle><circle class="pdp-a" cx="1.4" cy="1.4" r="1.7"></circle>';
			ag.append(g);
			return g;
		};
		const place = (g: SVGGElement, x: number, y: number) => g.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
		const dots = alphas.map(mkAlpha);
		// the special α: hits a nucleus 4 см away at t = 0,8 … 1,32 с of the loop
		const HIT = { x: SRC.x + 4 * PX, y: 84 };
		const T_HIT = 0.8 + (4 / 7) * 0.9;
		const sp = mkAlpha();
		const proton = $<SVGCircleElement>('[data-proton]');
		const ptrack = $<SVGPathElement>('[data-ptrack]');
		const hit = $<SVGCircleElement>('[data-hit]');
		const flash = $<SVGCircleElement>('[data-flash]');
		const SCREEN = { x: 288, y: 90 };
		const T_SCREEN = T_HIT + 0.5;
		const inset = $<SVGGElement>('[data-inset]');
		const nucG = document.createElementNS(NS, 'g');
		inset.append(nucG);
		let t = 0;
		const draw = () => {
			const u = t % CYCLE;
			alphas.forEach((a, i) => {
				const age = (u - a.t0 + CYCLE) % CYCLE;
				const d = Math.min(a.range, (age / 0.9) * 7 * PX);
				const op = age < 0.9 * (a.range / (7 * PX)) ? 1 : Math.max(0, 1 - (age - 0.9) / 0.3);
				place(dots[i], SRC.x + d * Math.cos(a.a), SRC.y + d * Math.sin(a.a));
				dots[i].setAttribute('opacity', op.toFixed(2));
			});
			// the special α and the proton
			const fa = Math.min(1, Math.max(0, (u - 0.8) / (T_HIT - 0.8)));
			place(sp, SRC.x + (HIT.x - SRC.x) * fa, SRC.y + (HIT.y - SRC.y) * fa);
			sp.setAttribute('opacity', u > 0.8 && u < T_HIT ? '1' : '0');
			const hf = u > T_HIT ? Math.max(0, 1 - (u - T_HIT) / 0.35) : 0;
			hit.setAttribute('cx', String(HIT.x));
			hit.setAttribute('cy', String(HIT.y));
			hit.setAttribute('opacity', hf.toFixed(2));
			const fp = Math.min(1, Math.max(0, (u - T_HIT) / (T_SCREEN - T_HIT)));
			const P = { x: HIT.x + (SCREEN.x - HIT.x) * fp, y: HIT.y + (SCREEN.y - HIT.y) * fp };
			proton.setAttribute('cx', P.x.toFixed(1));
			proton.setAttribute('cy', P.y.toFixed(1));
			proton.setAttribute('opacity', u > T_HIT && u < T_SCREEN ? '1' : '0');
			ptrack.setAttribute('d', u > T_HIT ? `M${HIT.x} ${HIT.y} L${P.x.toFixed(1)} ${P.y.toFixed(1)}` : '');
			ptrack.style.opacity = String(u > T_HIT ? Math.max(0, 1 - (u - T_SCREEN) / 0.8) : 0);
			$<SVGTextElement>('[data-plabel]').setAttribute('opacity', (u > T_HIT + 0.1 && u < T_SCREEN + 0.8 ? 1 : 0).toString());
			const ff = u > T_SCREEN ? Math.max(0, 1 - (u - T_SCREEN) / 0.5) : 0;
			flash.setAttribute('opacity', ff.toFixed(2));
			$<SVGTextElement>('[data-flabel]').setAttribute('opacity', String(u > T_SCREEN && u < T_SCREEN + 1 ? 1 : 0));
			// the inset (4,2 px per фм): nitrogen at the center, the α comes from the left, joins, a proton leaves
			const C = { x: 344, y: 46 };
			const k = 4.2;
			const join = Math.min(1, Math.max(0, (u - (T_HIT - 0.35)) / 0.35));
			let n: Nucleon[];
			if (u < T_HIT) {
				const ax = -14 + 10.5 * join;
				const al: Nucleon[] = [
					[ax, -0.7, 0.7, 1],
					[ax + 1.4, 0.7, 0.7, 1],
					[ax, 0.7, -0.7, 0],
					[ax + 1.4, -0.7, -0.7, 0],
				];
				n = [...N14, ...al];
				drawNucleus(nucG, n, { k, cx: C.x, cy: C.y, angle: 0, tilt: 0.2, fills });
			} else {
				// oxygen-17 and the proton leaving to the upper right
				const out = Math.min(1, (u - T_HIT) / 0.5) * 12;
				n = [...O17, [3 + out, -2 - out * 0.4, 1.5, 1]];
				drawNucleus(nucG, n, { k, cx: C.x, cy: C.y, angle: 0, tilt: 0.2, fills });
			}
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
