---
/**
 * Two looping opening scenes of «Состав атомного ядра. Ядерные силы» (grade 9). No terms of the chapter in the pictures
 * or the visible captions; the captions' popovers explain.
 *
 * Balloons: a birthday party in a park, side view at 50 px per м (0,5 px per см), real time. A girl (1,30 м) holds a
 *   bunch of three helium balloons in her far hand; her father (1,74 м, facing her) holds a fourth one and hands it over:
 *   his arm reaches out 0,2–1,2 с, her near hand reaches the string 1,0–1,9 с and grips it below his hand, his hand opens
 *   at 2,2 с and goes back. She holds the string; at 3,6 с her fingers open and at 3,95 с the string slips out (the hand
 *   is open before the string leaves it). The balloon (28 см across, string 1,1 м) rises: its speed grows to 1,5 м/с
 *   with a time constant of 0,25 с (a party balloon's steady rise), and the wind of 1 м/с carries it to the right; it
 *   leaves the frame in about 2,5 с. The girl reaches up after it (open hand) and waves (1,5 waves per second) until
 *   8 с, then lowers her arm. On a table: a cake and cups, two balloons tied to its leg, a gray helium cylinder (60 см) beside it. People: the kit; at this
 *   size their hands are mittens, so the poses are plain (holding a string, reaching, waving).
 *
 * Dacha morning: sunrise over a field and a forest at a dacha near Moscow (55,75° N) on 21 June, time sped up:
 *   1 hour of the Sun in 4 с of the loop (the run of 12 с = 3 hours). The Sun's altitude and azimuth are computed
 *   (declination 23,44°): from 2° above the horizon (azimuth 46°) to about 27° (azimuth 87°). Side view at 55 px per м;
 *   the ground is drawn in perspective (depth shortened to 0,35). The shadow of the apple tree (2,6 м) points away from
 *   the Sun with the length h/tg(altitude): at first far beyond the frame toward the viewer, then shorter and turned to
 *   the left. Dew sparkles on the grass and fades as the Sun climbs (gone above 14°); the mist over the field thins.
 *   A teenager (1,65 м) comes out of the house onto the porch (walk at 0,8 м/с, the planted foot does not slide),
 *   stretches with both arms up, lowers them, then lifts his head and looks at the Sun for about 4 с with the hands
 *   hanging, and goes back in. A cat lies on the warm boards of the porch and lifts its head. The Sun is drawn larger than its real
 *   angular size (0,5°) so that it is seen.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gid = (n: string) => `yai-${n}-${uid}`;
// park: tree crowns (x, y, r) and bunting between two trees
const PARK = [
	[20, 112, 34],
	[52, 96, 30],
	[300, 104, 36],
	[338, 120, 30],
	[176, 124, 22],
];
const FLAGS = Array.from({ length: 11 }, (_, k) => {
	const x = 62 + k * 21.5;
	const y = 72 + 14 * Math.sin((Math.PI * (k + 0.5)) / 11);
	return { x, y, c: ['hsl(350,75%,62%)', 'hsl(45,90%,58%)', 'hsl(200,70%,58%)', 'hsl(140,55%,52%)'][k % 4] };
});
// dacha: forest silhouette and dew points
const FOREST = (() => {
	let d = 'M0 150';
	for (let x = 0; x <= 360; x += 6) d += ` L${x} ${(138 - 8 * Math.abs(Math.sin(x * 0.11)) - 4 * Math.abs(Math.sin(x * 0.37))).toFixed(1)}`;
	return d + ' L360 150 Z';
})();
const DEW = Array.from({ length: 34 }, (_, k) => [((k * 89) % 340) + 10, 196 + ((k * 37) % 42)]);
---

