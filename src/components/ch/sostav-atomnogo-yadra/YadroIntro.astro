<script>
	import { scene, clamp } from '@components/intro/scene';
	import { figure, reach, walk, ANKLE_CM, ROLL, type FigurePose, type HandTarget, type Pt } from '@components/people';

	const NS = 'http://www.w3.org/2000/svg';
	const f1 = (v: number) => v.toFixed(1);
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerpP = (a: Pt, b: Pt, t: number): Pt => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });
	/**
	 * reach() between two poses, but each hand moves along an arc around its shoulder (the angle and the distance from the
	 * shoulder change smoothly), so a hand going from the hip to above the head swings forward instead of passing
	 * through the shoulder. For a person facing right (the angle passes through 0, the front).
	 */
	const arcReach = (A: FigurePose, B: FigurePose, t: number, sh: [Pt, Pt]): FigurePose => {
		const p = reach(A, B, t);
		const e = smooth(0, 1, t);
		([0, 1] as const).forEach((i) => {
			const a = (A.hands[i] as HandTarget).at;
			const b = (B.hands[i] as HandTarget).at;
			if (!a || !b) return;
			const ra = Math.hypot(a.x - sh[i].x, a.y - sh[i].y);
			const rb = Math.hypot(b.x - sh[i].x, b.y - sh[i].y);
			const aa = Math.atan2(a.y - sh[i].y, a.x - sh[i].x);
			const ab = Math.atan2(b.y - sh[i].y, b.x - sh[i].x);
			const ang = aa + (ab - aa) * e;
			const r = ra + (rb - ra) * e;
			(p.hands[i] as HandTarget).at = { x: sh[i].x + r * Math.cos(ang), y: sh[i].y + r * Math.sin(ang) };
		});
		return p;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-yadrointro]')) {
		// ---- balloons
		{
			const card = root.querySelector<HTMLElement>('[data-scene="balloons"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.5; // px per см
			const K = 50; // px per м
			const ANK = 214 - ANKLE_CM.trainer * S;
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H: 130, age: 'child', shirt: 'hm-red', hair: 'pony', clothes: 'indoor', name: 'girl' });
			const dad = figure($<SVGGElement>('[data-dad]'), { s: S, H: 174, shirt: 'hm-blue', hair: 'short', clothes: 'indoor', dir: -1, name: 'father' });
			const GX = 110;
			const DX = 150;
			const gu = 130 * S;
			const du = 174 * S;
			const GHIP: Pt = { x: GX, y: ANK - 0.43 * gu };
			const DHIP: Pt = { x: DX, y: ANK - 0.465 * du };
			// balloons: 28 см across, strings 1,1 м
			const L = 1.1 * K;
			const COLORS = ['hsl(350,75%,60%)', 'hsl(45,90%,58%)', 'hsl(200,75%,58%)', 'hsl(140,55%,50%)'];
			const strings = $<SVGGElement>('[data-strings]');
			const bg = $<SVGGElement>('[data-balloons]');
			const mkBalloon = (parent: SVGGElement, c: string) => {
				const g = document.createElementNS(NS, 'g');
				g.style.color = c;
				g.innerHTML = `<ellipse rx="7" ry="8" cy="-8" fill="${c}"></ellipse><path class="yai-knot" d="M-1.4 0.6 L1.4 0.6 L0 -1 Z"></path><ellipse class="yai-shine" rx="1.6" ry="2.6" cx="-2.6" cy="-11" transform="rotate(-20 -2.6 -11)"></ellipse>`;
				parent.append(g);
				return g;
			};
			const mkString = () => {
				const p = document.createElementNS(NS, 'path');
				p.setAttribute('class', 'yai-string');
				strings.append(p);
				return p;
			};
			const bunch = [0, 1, 2].map((k) => ({ b: mkBalloon(bg, COLORS[k]), s: mkString(), w: [-0.22, 0.02, 0.24][k], ph: k * 1.7 }));
			const fourth = { b: mkBalloon($<SVGGElement>('[data-free-balloon]'), COLORS[3]), s: $<SVGPathElement>('[data-free]') };
			// the hand-over point: the father's grip above, the girl's just below on the same string
			const PD: Pt = { x: 129, y: 156 };
			const PG: Pt = { x: 128.5, y: 164 };
			const HOLD_G: Pt = { x: 122, y: 162 };
			const RUN = 10;
			const T_OUT = 3.95; // the string leaves the girl's hand
			const rest = (hip: Pt, u: number, dir: 1 | -1): HandTarget => ({ at: { x: hip.x + dir * 0.02 * u, y: hip.y + 0.04 * u }, pose: 'relaxed' });
			const GSHS = girl.shoulders(GHIP, 0.03);
			const GSH = GSHS[0];
			const reachG = 0.27 * gu;
			const up = (a: number, open = true): HandTarget => ({ at: { x: GSH.x + reachG * Math.cos(a), y: GSH.y + reachG * Math.sin(a) }, pose: open ? 'open' : 'relaxed', dir: a, roll: ROLL.palmViewer });
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the father: near hand holds the string at his side, reaches out, opens, comes back
				const dRest: HandTarget = { at: { x: DX - 3, y: DHIP.y + 0.04 * du }, pose: 'grip', d: 0.6, contact: 'balloon string' };
				const dOut: HandTarget = { at: PD, pose: 'grip', d: 0.6, dir: Math.PI - 0.5, contact: 'balloon string' };
				const dOpen: HandTarget = { at: PD, pose: 'open', dir: Math.PI - 0.5 };
				const dBack = rest(DHIP, du, -1);
				const dpose = (h: HandTarget, lean: number): FigurePose => ({
					hip: DHIP,
					lean,
					head: 0.25,
					ankles: [
						{ x: DX - 3, y: ANK },
						{ x: DX + 3, y: ANK },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [h, rest(DHIP, du, -1)],
				});
				let dp: FigurePose;
				if (t < 0.2) dp = dpose(dRest, 0.05);
				else if (t < 1.2) dp = reach(dpose(dRest, 0.05), dpose(dOut, 0.22), (t - 0.2) / 1.0);
				else if (t < 2.1) dp = dpose(dOut, 0.22);
				else if (t < 2.4) dp = reach(dpose(dOut, 0.22), dpose(dOpen, 0.22), (t - 2.1) / 0.3);
				else if (t < 3.3) dp = reach(dpose(dOpen, 0.22), dpose(dBack, 0.05), (t - 2.4) / 0.9);
				else dp = dpose(dBack, 0.05);
				const ds = dad.pose(dp);
				// the girl: far hand holds the bunch in front of her; the near hand takes the string, holds it, lets it slip,
				// reaches up and waves
				const gFar: HandTarget = { at: { x: GX + 5, y: GHIP.y - 0.05 * gu }, pose: 'grip', d: 0.6, contact: 'bunch of strings' };
				const gRest = rest(GHIP, gu, 1);
				const gTake: HandTarget = { at: PG, pose: 'grip', d: 0.6, dir: -0.4, contact: 'balloon string' };
				const gHold: HandTarget = { at: HOLD_G, pose: 'grip', d: 0.6, dir: -0.6, contact: 'balloon string' };
				const gOpen: HandTarget = { at: { x: HOLD_G.x + 0.5, y: HOLD_G.y - 0.5 }, pose: 'open', dir: -0.6, roll: ROLL.palmViewer };
				const gpose = (h: HandTarget, head: number): FigurePose => ({
					hip: GHIP,
					lean: 0.03,
					head,
					ankles: [
						{ x: GX + 2, y: ANK },
						{ x: GX - 2, y: ANK },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [h, gFar],
				});
				const wave = Math.sin(2 * Math.PI * 1.5 * (t - 5.2));
				let gp: FigurePose;
				if (t < 1.0) gp = gpose(gRest, 0);
				else if (t < 1.9) gp = arcReach(gpose(gRest, 0), gpose(gTake, -0.25), (t - 1.0) / 0.9, GSHS);
				else if (t < 2.6) gp = gpose(gTake, -0.25);
				else if (t < 3.3) gp = reach(gpose(gTake, -0.25), gpose(gHold, -0.3), (t - 2.6) / 0.7);
				else if (t < 3.6) gp = gpose(gHold, -0.3);
				else if (t < 3.95) gp = reach(gpose(gHold, -0.3), gpose(gOpen, -0.35), (t - 3.6) / 0.35);
				else if (t < 4.0) gp = gpose(gOpen, -0.35);
				else if (t < 4.8) gp = arcReach(gpose(gOpen, -0.35), gpose(up(-1.25), -0.6), (t - 4.0) / 0.8, GSHS);
				else if (t < 5.2) gp = gpose(up(-1.25), -0.6);
				else if (t < 8) gp = gpose(up(-1.25 + 0.22 * wave * smooth(5.2, 5.5, t) * (1 - smooth(7.7, 8, t))), -0.6);
				else if (t < 8.9) gp = arcReach(gpose(up(-1.25), -0.6), gpose(gRest, 0), (t - 8) / 0.9, GSHS);
				else gp = gpose(gRest, 0);
				const gs = girl.pose(gp);
				// the bunch: strings from the far hand's grip, balloons swaying in the wind
				const gb = { x: gs.grips[1].x, y: gs.grips[1].y };
				bunch.forEach((q) => {
					const w = q.w + 0.12 + 0.05 * Math.sin(1.3 * t + q.ph);
					const top = { x: gb.x + L * Math.sin(w), y: gb.y - L * Math.cos(w) };
					q.s.setAttribute('d', `M${f1(gb.x)} ${f1(gb.y)} Q${f1((gb.x + top.x) / 2 + 2)} ${f1((gb.y + top.y) / 2)} ${f1(top.x)} ${f1(top.y)}`);
					q.b.setAttribute('transform', `translate(${f1(top.x)} ${f1(top.y)}) rotate(${f1((w * 180) / Math.PI)})`);
				});
				// the fourth balloon: held by the father, by both, by the girl, then free
				let end: Pt;
				if (t < 1.9) end = { x: ds.grips[0].x, y: ds.grips[0].y };
				else if (t < 2.2) end = { x: gs.grips[0].x, y: gs.grips[0].y };
				else if (t < T_OUT) end = { x: gs.grips[0].x, y: gs.grips[0].y };
				else {
					const u = t - T_OUT;
					const tau = 0.25;
					const rise = 1.5 * K * (u - tau * (1 - Math.exp(-u / tau)));
					end = { x: HOLD_G.x + 0.5 + 1 * K * u, y: HOLD_G.y - 0.5 - rise };
				}
				const w4 = 0.1 + 0.05 * Math.sin(1.1 * t) + (t > T_OUT ? -0.25 * smooth(T_OUT, T_OUT + 0.6, t) : 0);
				const top4 = { x: end.x + L * Math.sin(w4), y: end.y - L * Math.cos(w4) };
				fourth.s.setAttribute('d', `M${f1(end.x)} ${f1(end.y)} Q${f1((end.x + top4.x) / 2 - 2)} ${f1((end.y + top4.y) / 2)} ${f1(top4.x)} ${f1(top4.y)}`);
				fourth.b.setAttribute('transform', `translate(${f1(top4.x)} ${f1(top4.y)}) rotate(${f1((w4 * 180) / Math.PI)})`);
			});
		}

		// ---- dacha morning
		{
			const card = root.querySelector<HTMLElement>('[data-scene="dacha"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.55;
			const K = 55;
			const DEPTH = 0.35;
			const RUN = 12;
			const HOURS = 3; // of the Sun in the run (1 h = 4 s)
			// the Sun at 55,75° N on 21 June
			const D = Math.PI / 180;
			const phi = 55.75 * D;
			const dec = 23.44 * D;
			const altOf = (H: number) => Math.asin(Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H));
			const azOf = (H: number) => Math.PI + Math.atan2(Math.sin(H), Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi));
			// the hour angle when the Sun is 2° high in the morning (bisection)
			let lo = -Math.PI;
			let hi = 0;
			for (let k = 0; k < 50; k++) {
				const m = (lo + hi) / 2;
				if (altOf(m) < 2 * D) lo = m;
				else hi = m;
			}
			const H0 = hi;
			const sunAt = (t: number) => {
				const H = H0 + ((t / RUN) * HOURS * 15 * D);
				return { alt: altOf(H), az: azOf(H) };
			};
			// the view looks toward azimuth 30° (north-east); a direction on the ground: across (right) and away
			const VIEW = 30 * D;
			const sky0 = $<SVGStopElement>('[data-sky0]');
			const sky1 = $<SVGStopElement>('[data-sky1]');
			const sun = $<SVGCircleElement>('[data-sun]');
			const glow = $<SVGCircleElement>('[data-sunglow]');
			const mist = $<SVGRectElement>('[data-mist]');
			const tsh = $<SVGPathElement>('[data-tshadow]');
			const psh = $<SVGPathElement>('[data-pshadow]');
			const dew = [...card.querySelectorAll<SVGPathElement>('[data-dew] path')];
			const tail = $<SVGPathElement>('[data-tail]');
			const head = $<SVGGElement>('[data-head]');
			// the shadow of a vertical pole of height h (м) standing at (x, y): its far end on the screen
			const shadowEnd = (x: number, y: number, h: number, s: { alt: number; az: number }) => {
				const L = Math.min(200, h / Math.tan(s.alt));
				const rel = s.az + Math.PI - VIEW;
				return { x: x + Math.sin(rel) * L * K, y: y - Math.cos(rel) * L * K * DEPTH };
			};
			// the teenager: two figures (facing right to come out, facing left to go back in)
			const H = 165;
			const u = H * S;
			const out = figure($<SVGGElement>('[data-teen]'), { s: S, H, age: 'teen', shirt: 'hm-green', hair: 'short', clothes: 'indoor', shorts: true, name: 'teen' });
			const back = figure($<SVGGElement>('[data-teen-back]'), { s: S, H, age: 'teen', shirt: 'hm-green', hair: 'short', clothes: 'indoor', shorts: true, dir: -1, name: 'teen going back' });
			const DECK = 188;
			const ANK = DECK - ANKLE_CM.trainer * S;
			const LEG = 0.46 * u * 0.995;
			const STEP = 0.35 * u;
			const V = 0.8 * K;
			const X_OUT = 130;
			const X_IN = X_OUT - 2 * STEP; // two steps: the walk ends in the stance the standing pose keeps
			const T_WALK = (X_OUT - X_IN) / V; // 1,6 с
			const hipY = (step: number) => ANK - Math.sqrt(LEG * LEG - (0.5 * step) ** 2) + 0.4;
			const STAND: Pt = { x: X_OUT, y: hipY(STEP) };
			const relax = (hip: Pt, dir: 1 | -1): HandTarget => ({ at: { x: hip.x + dir * 0.02 * u, y: hip.y + 0.03 * u }, pose: 'relaxed' });
			const SH = out.shoulders(STAND, -0.06)[0];
			const SHF = out.shoulders(STAND, -0.06)[1];
			const SHS: [Pt, Pt] = [SH, SHF];
			const ARM = 0.27 * u;
			const standPose = (hands: [HandTarget, HandTarget], head: number, lean = 0.02): FigurePose => ({
				hip: STAND,
				lean,
				head,
				ankles: [
					{ x: X_OUT + 0.5 * STEP, y: ANK },
					{ x: X_OUT - 0.5 * STEP, y: ANK },
				],
				feet: [0, 0],
				planted: [true, true],
				hands,
			});
			const armsUp: [HandTarget, HandTarget] = [
				{ at: { x: SH.x + 3, y: SH.y - ARM }, pose: 'open', dir: -Math.PI / 2, roll: ROLL.palmViewer },
				{ at: { x: SHF.x + 1, y: SHF.y - ARM }, pose: 'open', dir: -Math.PI / 2, roll: ROLL.palmViewer },
			];
			const rest2: [HandTarget, HandTarget] = [relax(STAND, 1), relax(STAND, 1)];
			const walker = (fig: ReturnType<typeof figure>, d: number, x0: number, dir: 1 | -1) => {
				const w = walk(d, STEP, x0 + 0.5 * STEP, 0.05 * u);
				const fx = (f: number) => x0 + dir * (f - x0);
				const hip = { x: x0 + dir * d, y: hipY(STEP) + w.bob };
				fig.pose({
					hip,
					lean: 0.04,
					head: 0,
					ankles: [
						{ x: fx(w.feet[0].x), y: ANK - (w.feet[0].planted ? 0 : 0.05 * u * Math.sqrt(Math.sin(Math.PI * w.feet[0].swing))) },
						{ x: fx(w.feet[1].x), y: ANK - (w.feet[1].planted ? 0 : 0.05 * u * Math.sqrt(Math.sin(Math.PI * w.feet[1].swing))) },
					],
					feet: [w.feet[0].toe, w.feet[1].toe],
					planted: [w.feet[0].planted, w.feet[1].planted],
					hands: [
						{ at: { x: hip.x + dir * 0.08 * u * w.arm, y: hip.y + 0.02 * u }, pose: 'relaxed' },
						{ at: { x: hip.x - dir * 0.08 * u * w.arm, y: hip.y + 0.02 * u }, pose: 'relaxed' },
					],
				});
				return hip;
			};
			const outG = $<SVGGElement>('[data-teen]');
			const backG = $<SVGGElement>('[data-teen-back]');
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const s = sunAt(t);
				const altD = s.alt / D;
				// sky: warm low, bluer higher
				const warm = 1 - smooth(2, 18, altD);
				sky0.style.stopColor = `color-mix(in srgb, hsl(210, 60%, 62%) ${Math.round(100 - 45 * warm)}%, hsl(30, 60%, 40%))`;
				sky1.style.stopColor = `color-mix(in srgb, hsl(205, 55%, 78%) ${Math.round(100 - 75 * warm)}%, hsl(30, 95%, 70%))`;
				const sx = 206 + (s.az / D - 46) * 2;
				const sy = 150 - altD * 4.2;
				sun.setAttribute('cx', f1(sx));
				sun.setAttribute('cy', f1(sy));
				glow.setAttribute('cx', f1(sx));
				glow.setAttribute('cy', f1(sy));
				mist.style.opacity = (0.9 * (1 - smooth(3, 12, altD))).toFixed(2);
				// dew: twinkles, gone above 14°
				const dv = 1 - smooth(6, 14, altD);
				dew.forEach((p, k) => (p.style.opacity = (dv * (0.35 + 0.65 * Math.max(0, Math.sin(t * 5 + k * 1.9)))).toFixed(2)));
				// the apple tree's shadow: trunk to 1 м, crown from 1 м to 2,6 м (an ellipse along the shadow)
				const base = { x: 330, y: 204 };
				const e1 = shadowEnd(base.x, base.y, 1, s);
				const e2 = shadowEnd(base.x, base.y, 2.6, s);
				const ang = Math.atan2(e2.y - base.y, e2.x - base.x);
				const nx = -Math.sin(ang);
				const ny = Math.cos(ang);
				const wT = 2.5;
				const wC = 26;
				const mid = { x: (e1.x + e2.x) / 2, y: (e1.y + e2.y) / 2 };
				const half = Math.hypot(e2.x - e1.x, e2.y - e1.y) / 2;
				const crown = `M${f1(e1.x)} ${f1(e1.y)} Q${f1(mid.x - (e2.x - e1.x) / 2 + nx * wC * 1.3)} ${f1(mid.y - (e2.y - e1.y) / 2 + ny * wC * 0.5)} ${f1(mid.x + nx * wC)} ${f1(mid.y + ny * wC * 0.38)} Q${f1(e2.x + nx * wC * 0.6)} ${f1(e2.y + ny * wC * 0.2)} ${f1(e2.x)} ${f1(e2.y)} Q${f1(e2.x - nx * wC * 0.6)} ${f1(e2.y - ny * wC * 0.2)} ${f1(mid.x - nx * wC)} ${f1(mid.y - ny * wC * 0.38)} Q${f1(mid.x - (e2.x - e1.x) / 2 - nx * wC * 1.3)} ${f1(mid.y - (e2.y - e1.y) / 2 - ny * wC * 0.5)} ${f1(e1.x)} ${f1(e1.y)} Z`;
				void half;
				tsh.setAttribute('d', `M${f1(base.x - nx * wT)} ${f1(base.y - ny * wT * 0.4)} L${f1(e1.x - nx * wT)} ${f1(e1.y)} L${f1(e1.x + nx * wT)} ${f1(e1.y)} L${f1(base.x + nx * wT)} ${f1(base.y + ny * wT * 0.4)} Z ` + crown);
				// the teenager
				let hip: Pt | null = null;
				// a hidden walker stands unplanted where it will next appear, so the jump of the loop is not a sliding foot
				const park = (fig: ReturnType<typeof figure>, x0: number, dir: 1 | -1) =>
					fig.pose({
						hip: { x: x0, y: STAND.y },
						lean: 0.02,
						ankles: [
							{ x: x0 + dir * 0.5 * STEP, y: ANK - 1 },
							{ x: x0 - dir * 0.5 * STEP, y: ANK - 1 },
						],
						feet: [0, 0],
						planted: [false, false],
						hands: [relax({ x: x0, y: STAND.y }, dir), relax({ x: x0, y: STAND.y }, dir)],
					});
				if (t < 0.3 || t > 11.6) {
					outG.style.visibility = 'hidden';
					backG.style.visibility = 'hidden';
					park(out, X_IN, 1);
					park(back, X_OUT, -1);
				} else if (t < 0.3 + T_WALK) {
					outG.style.visibility = 'visible';
					backG.style.visibility = 'hidden';
					park(back, X_OUT, -1);
					hip = walker(out, (t - 0.3) * V, X_IN, 1);
				} else if (t < 10) {
					outG.style.visibility = 'visible';
					backG.style.visibility = 'hidden';
					let p: FigurePose;
					const t0 = 0.3 + T_WALK;
					if (t < t0 + 0.4) p = standPose(rest2, 0);
					else if (t < t0 + 1.2) p = arcReach(standPose(rest2, 0), standPose(armsUp, -0.25, -0.06), (t - t0 - 0.4) / 0.8, SHS);
					else if (t < t0 + 1.9) p = standPose(armsUp, -0.25, -0.06);
					else if (t < t0 + 2.6) p = arcReach(standPose(armsUp, -0.25, -0.06), standPose(rest2, 0), (t - t0 - 1.9) / 0.7, SHS);
					else if (t < t0 + 3.0) p = standPose(rest2, 0);
					// he lifts his head toward the Sun (the hands stay down) and looks at it, then lowers it
					else if (t < t0 + 3.7) p = reach(standPose(rest2, 0), standPose(rest2, -0.35), (t - t0 - 3.0) / 0.7);
					else if (t < 9.0) p = standPose(rest2, -0.35);
					else if (t < 9.7) p = reach(standPose(rest2, -0.35), standPose(rest2, 0), (t - 9.0) / 0.7);
					else p = standPose(rest2, 0);
					out.pose(p);
					park(back, X_OUT, -1);
					hip = STAND;
				} else {
					outG.style.visibility = 'hidden';
					backG.style.visibility = 'visible';
					park(out, X_IN, 1);
					hip = walker(back, (t - 10) * V, X_OUT, -1);
				}
				// his shadow on the boards (a soft strip toward the shadow direction, 1,65 м tall)
				if (hip) {
					const e = shadowEnd(hip.x, DECK, 1.65, s);
					const a = Math.atan2(e.y - DECK, e.x - hip.x);
					const len = Math.min(70, Math.hypot(e.x - hip.x, e.y - DECK));
					psh.setAttribute('d', `M${f1(hip.x - 3)} ${DECK} L${f1(hip.x + Math.cos(a) * len - 3)} ${f1(DECK + Math.sin(a) * len)} L${f1(hip.x + Math.cos(a) * len + 3)} ${f1(DECK + Math.sin(a) * len)} L${f1(hip.x + 3)} ${DECK} Z`);
				} else psh.setAttribute('d', '');
				// the cat: the tail twitches, the head lifts toward the Sun at about 6 с
				tail.setAttribute('d', `M-12 -1 Q-20 ${f1(-2 + Math.sin(t * 2.2))} ${f1(-21 + Math.sin(t * 1.3))} ${f1(-6 + 1.5 * Math.sin(t * 2.2))}`);
				const lift = smooth(5.5, 6.3, t) * (1 - smooth(10.5, 11.3, t));
				head.setAttribute('transform', `translate(7 ${f1(-4 - 2.5 * lift)}) rotate(${f1(-15 * lift)})`);
			});
		}
	}
</script>
