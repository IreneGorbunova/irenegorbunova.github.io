---
/**
 * «Опыт Чедвика», a labelled scheme from left to right (not to scale): a polonium source on a disc sends α particles
 * (red) to a beryllium plate; out of the beryllium comes radiation without charge, drawn as gray balls with dashed
 * tracks (neutrons); it passes a lead plate 2 см thick without slowing down (the button «Свинец» puts the plate in or
 * takes it out; the count does not change), hits a block of paraffin (a lattice of hydrogen, red, and carbon, dark) and
 * knocks protons out of it (red), which fly into a counter whose display adds 1 per proton. Three streams, 2 с per
 * stream, so 1,5 counts per second with or without lead. The motion is slowed down enormously.
 * Inset: a neutron hits a resting proton head-on; with equal masses in an elastic collision the neutron stops and the
 * proton flies on with the neutron's speed (like two billiard balls; momentum and energy kept). The real neutron is
 * 0,14 % heavier than the proton: it keeps about 0,07 % of its speed, which cannot be seen.
 * Physics not printed: polonium α particles 5,3 МэВ, neutrons from beryllium up to about 5,7 МэВ.
 */
import G7Styles from '../g7/G7Styles.astro';
import NucStyles from './NucStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const gid = (s: string) => `chd-${s}-${uid}`;
const LAT = Array.from({ length: 24 }, (_, k) => ({ x: 238 + (k % 4) * 7, y: 70 + Math.floor(k / 4) * 9, c: (k + Math.floor(k / 4)) % 3 === 0 }));
---

<G7Styles />
<NucStyles />
<figure class="g7 g7--pic nucf chd not-content" data-chadwickpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 236" role="img" aria-label="Схема опыта Чедвика: полоний испускает альфа-частицы на пластинку бериллия; из бериллия вылетают нейтроны, они проходят сквозь свинец, попадают в парафин и выбивают из него протоны, которые регистрирует счётчик">
			<defs>
				<radialGradient id={gid('p')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-p0"></stop><stop offset="1" class="nuc-p1"></stop></radialGradient>
				<radialGradient id={gid('n')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-n0"></stop><stop offset="1" class="nuc-n1"></stop></radialGradient>
				<clipPath id={gid('inset')}><circle cx="200" cy="180" r="38"></circle></clipPath>
			</defs>
			<!-- polonium on a disc, beryllium, lead, paraffin, counter -->
			<rect class="chd-disc" x="18" y="74" width="8" height="42" rx="2"></rect>
			<circle class="chd-po" cx="27" cy="95" r="4"></circle>
			<rect class="chd-be" x="60" y="70" width="8" height="50" rx="1"></rect>
			<rect class="chd-pb" data-lead x="140" y="62" width="20" height="66" rx="1"></rect>
			<rect class="chd-par" x="232" y="64" width="30" height="62" rx="2"></rect>
			{LAT.map((d) => <circle class={d.c ? 'chd-c' : 'chd-h'} cx={d.x} cy={d.y} r={d.c ? 2.2 : 1.5} />)}
			<rect class="chd-tube" x="318" y="84" width="54" height="22" rx="11"></rect>
			<rect class="chd-disp" x="330" y="120" width="40" height="20" rx="3"></rect>
			<text class="chd-num t-num" data-count x="350" y="135" text-anchor="middle">0</text>
			<path class="chd-wire" d="M350 106 V120"></path>
			<g data-parts></g>
			<!-- labels -->
			<text class="t-small" x="8" y="58">полоний</text>
			<text class="t-small" x="50" y="136">бериллий</text>
			<text class="t-small" x="100" y="48">нейтроны: заряда нет</text>
			<text class="t-small" data-lead-label x="150" y="144" text-anchor="middle">свинец 2 см</text>
			<text class="t-small" x="247" y="144" text-anchor="middle">парафин</text>
			<text class="t-small t-red" x="268" y="124">протоны</text>
			<text class="t-small" x="345" y="78" text-anchor="middle">счётчик</text>
			<!-- inset: a neutron hits a proton head-on -->
			<circle class="chd-inset" cx="200" cy="180" r="38"></circle>
			<g clip-path={`url(#${gid('inset')})`}>
				<path class="chd-itrack" data-itrack d=""></path>
				<circle data-in r="9" fill={`url(#${gid('n')})`}></circle>
				<g data-ip><circle r="9" fill={`url(#${gid('p')})`}></circle><path class="nuc-plus" d="M-4 0 H4 M0 -4 V4" stroke-width="1.6"></path></g>
			</g>
			<circle class="chd-rim" cx="200" cy="180" r="38"></circle>
		</svg>
	</div>
	<div class="g7__row chd__row">
		<button type="button" class="g7__btn" aria-pressed="true" data-leadbtn>Свинец</button>
	</div>
	<figcaption class="g7__caption">
		Движение сильно замедлено. В круге: нейтрон налетает на покоящийся протон; массы почти равны, поэтому нейтрон останавливается, а протон улетает с его скоростью — как бильярдные шары.
	</figcaption>
</figure>

<style is:global>
	.chd .chd-disc {
		fill: var(--sl-color-gray-4);
	}
	.chd .chd-po {
		fill: var(--nuc-p);
	}
	.chd .chd-be {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 70%, var(--ig-v));
	}
	.chd .chd-pb {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 80%, var(--ig-vx));
		transition: opacity 0.3s;
	}
	.chd .chd-par {
		fill: color-mix(in srgb, white 70%, var(--ig-v));
		opacity: 0.85;
	}
	.chd .chd-h {
		fill: var(--nuc-p);
	}
	.chd .chd-c {
		fill: hsl(220, 15%, 20%);
	}
	.chd .chd-tube {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
	}
	.chd .chd-disp {
		fill: hsl(220, 20%, 12%);
		stroke: var(--sl-color-gray-3);
	}
	.chd .chd-num {
		font-size: 13px;
		font-weight: 700;
		fill: hsl(140, 70%, 60%);
	}
	.chd .chd-wire {
		stroke: var(--sl-color-gray-3);
	}
	.chd .chd-a {
		fill: var(--nuc-p);
	}
	.chd .chd-ntrack {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.chd .chd-ptrack,
	.chd .chd-itrack {
		fill: none;
		stroke: color-mix(in srgb, var(--nuc-p) 70%, transparent);
		stroke-width: 1.2;
	}
	.chd .chd-inset {
		fill: var(--sl-color-bg);
	}
	.chd .chd-rim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.chd .chd__row {
		margin-top: 0.6rem;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const PER = 2; // s per stream
	const OFF = [0, 0.67, 1.33];
	const YS = [86, 95, 104];
	for (const root of document.querySelectorAll<HTMLElement>('[data-chadwickpic]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const grads = [...root.querySelectorAll('radialGradient')].map((g) => `url(#${g.id})`);
		const parts = $<SVGGElement>('[data-parts]');
		const mk = (tag: string, attrs: Record<string, string>) => {
			const e = document.createElementNS(NS, tag);
			for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
			parts.append(e);
			return e;
		};
		const streams = OFF.map(() => ({
			a: mk('circle', { class: 'chd-a', r: '3' }),
			nt: mk('path', { class: 'chd-ntrack', d: '' }),
			n: mk('circle', { r: '3.6', fill: grads[1] }),
			pt: mk('path', { class: 'chd-ptrack', d: '' }),
			p: mk('circle', { r: '2.6', fill: grads[0] }),
		}));
		let lead = true;
		const btn = $<HTMLButtonElement>('[data-leadbtn]');
		btn.addEventListener('click', () => {
			lead = !lead;
			btn.setAttribute('aria-pressed', String(lead));
			$<SVGRectElement>('[data-lead]').style.opacity = lead ? '1' : '0';
			$<SVGTextElement>('[data-lead-label]').style.opacity = lead ? '1' : '0';
		});
		let t = 0;
		let count = 0;
		const inN = $<SVGCircleElement>('[data-in]');
		const inP = $<SVGGElement>('[data-ip]');
		const itr = $<SVGPathElement>('[data-itrack]');
		const draw = (dt: number) => {
			streams.forEach((s, i) => {
				const u0 = (t - OFF[i] + 100 * PER) % PER;
				const y = YS[i];
				// α: source → beryllium, 0 … 0,3 с
				const fa = u0 / 0.3;
				s.a.setAttribute('cx', (30 + (60 - 30) * Math.min(1, fa)).toFixed(1));
				s.a.setAttribute('cy', (95 + (y - 95) * Math.min(1, fa)).toFixed(1));
				s.a.setAttribute('opacity', fa < 1 ? '1' : '0');
				// neutron: beryllium → paraffin, 0,3 … 1,1 с, straight through the lead
				const fn = (u0 - 0.3) / 0.8;
				const nx = 68 + (232 - 68) * Math.min(1, Math.max(0, fn));
				s.n.setAttribute('cx', nx.toFixed(1));
				s.n.setAttribute('cy', String(y));
				s.n.setAttribute('opacity', fn > 0 && fn < 1 ? '1' : '0');
				s.nt.setAttribute('d', fn > 0 ? `M68 ${y} H${nx.toFixed(1)}` : '');
				(s.nt as SVGElement).style.opacity = String(fn > 0 ? Math.max(0, 1 - (u0 - 1.1) / 0.5) : 0);
				// proton: paraffin → counter, 1,1 … 1,5 с
				const fp = (u0 - 1.1) / 0.4;
				const px = 262 + (330 - 262) * Math.min(1, Math.max(0, fp));
				const py = y + (95 - y) * Math.min(1, Math.max(0, fp));
				s.p.setAttribute('cx', px.toFixed(1));
				s.p.setAttribute('cy', py.toFixed(1));
				s.p.setAttribute('opacity', fp > 0 && fp < 1 ? '1' : '0');
				s.pt.setAttribute('d', fp > 0 ? `M262 ${y} L${px.toFixed(1)} ${py.toFixed(1)}` : '');
				(s.pt as SVGElement).style.opacity = String(fp > 0 ? Math.max(0, 1 - (u0 - 1.5) / 0.4) : 0);
				// a count when the proton reaches the counter
				const prev = (t - dt - OFF[i] + 100 * PER) % PER;
				if (dt > 0 && prev < 1.5 && u0 >= 1.5) count++;
			});
			$('[data-count]').textContent = String(count % 1000);
			// the inset: 2 с loop; the neutron comes from the left at 40 px/s, hits at 1 с, stops; the proton goes on
			const v = t % 2;
			const C = { x: 200, y: 180 };
			const xn = v < 1 ? C.x - 40 + 40 * v - 9 : C.x - 9;
			const xp = v < 1 ? C.x + 9 : C.x + 9 + 40 * (v - 1);
			inN.setAttribute('cx', xn.toFixed(1));
			inN.setAttribute('cy', String(C.y));
			inP.setAttribute('transform', `translate(${xp.toFixed(1)} ${C.y})`);
			itr.setAttribute('d', v > 1 ? `M${C.x + 9} ${C.y} H${xp.toFixed(1)}` : '');
		};
		draw(0);
		loop(root, (dt) => {
			t += dt;
			draw(dt);
			return true;
		});
	}
</script>
