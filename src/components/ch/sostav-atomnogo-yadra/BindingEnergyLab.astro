---
/**
 * «Весы для ядра»: a pan balance. Left pan: a nucleus (packed balls, nucleus.ts); right pan: the same protons and neutrons
 * apart (a heap; for iron and uranium the balls are small, with «26 + 30», «92 + 146»). The balls are the same size on
 * both pans (7 px; 4 px for iron, 2,2 px for uranium), so the picture does not suggest a wrong weight. The free nucleons are heavier by
 * the mass defect Δm, so the beam tilts toward them. THE TILT IS EXAGGERATED: the beam turns by 15·Δm/M radians
 * (Δm is 0,12–0,94 % of the mass: ²H 1,0°, ⁵⁶Fe 8,0°); a line under the scale says so. A pointer on the beam
 * shows the tilt over a small scale.
 * «Разделить ядро»: the nucleus on the left pan falls apart into its nucleons while a gold bar fills to the binding
 * energy E_св (the energy that must be given); the pans then weigh the same and the beam is level: the given energy has
 * mass Δm = E_св/c². «Собрать ядро» puts it back (the energy goes out again).
 * Readouts with the school constants m_p = 1,00728 а.е.м., m_n = 1,00866 а.е.м., 1 а.е.м. = 1,6605·10⁻²⁷ кг,
 * c = 3·10⁸ м/с; nuclear masses M_я from AME 2020 atomic masses minus the electrons:
 *   ²H 2,01355 · ³He 3,01493 · ⁴He 4,00151 · ⁷Li 7,01436 · ¹²C 11,99671 · ¹⁶O 15,99053 · ⁵⁶Fe 55,92067 · ²³⁸U 238,00032.
 * Δm = Z m_p + N m_n − M_я; E_св = Δm·1,6605·10⁻²⁷·9·10¹⁶ Дж: ²H 3,57·10⁻¹³, ⁴He 4,54·10⁻¹², ⁵⁶Fe 7,90·10⁻¹¹,
 * ²³⁸U 2,89·10⁻¹⁰; per nucleon the largest for iron, 1,41·10⁻¹² Дж.
 */
import G7Styles from '../g7/G7Styles.astro';
import NucStyles from './NucStyles.astro';
import { pack, outerRadius } from './nucleus';
import { nuc, tex } from './tex';

const LIST = [
	{ A: 2, Z: 1, X: 'H', M: 2.01355 },
	{ A: 3, Z: 2, X: 'He', M: 3.01493 },
	{ A: 4, Z: 2, X: 'He', M: 4.00151 },
	{ A: 7, Z: 3, X: 'Li', M: 7.01436 },
	{ A: 12, Z: 6, X: 'C', M: 11.99671 },
	{ A: 16, Z: 8, X: 'O', M: 15.99053 },
	{ A: 56, Z: 26, X: 'Fe', M: 55.92067 },
	{ A: 238, Z: 92, X: 'U', M: 238.00032 },
].map((e) => {
	const n = pack(e.A, e.Z, 6);
	return { ...e, n, R: outerRadius(n), html: tex(nuc(e.A, e.Z, e.X)) };
});
const uid = Math.random().toString(36).slice(2, 8);
const gid = (s: string) => `bel-${s}-${uid}`;
---

<G7Styles />
<NucStyles />
<figure class="g7 nucf bel not-content" data-bindlab data-list={JSON.stringify(LIST.map(({ html, ...e }) => e))}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 260" role="img" aria-label="Рычажные весы: на левой чаше ядро, на правой — те же протоны и нейтроны по отдельности. Правая чаша тяжелее, весы наклонены в её сторону">
			<defs>
				<radialGradient id={gid('p')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-p0"></stop><stop offset="1" class="nuc-p1"></stop></radialGradient>
				<radialGradient id={gid('n')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-n0"></stop><stop offset="1" class="nuc-n1"></stop></radialGradient>
			</defs>
			<!-- stand -->
			<path class="bel-stand" d="M200 70 V214 M160 222 H240"></path>
			<rect class="bel-base" x="150" y="214" width="100" height="10" rx="3"></rect>
			<!-- the pointer's scale -->
			<path class="bel-scale" data-scale d=""></path>
			<g data-beam>
				<path class="bel-beam" d="M70 70 H330"></path>
				<path class="bel-needle" d="M200 70 V176"></path>
			</g>
			<circle class="bel-pivot" cx="200" cy="70" r="5"></circle>
			<g data-lpan></g>
			<g data-rpan></g>
			<!-- the energy bar -->
			<text class="t-small bel-gold" x="12" y="20">энергия</text>
			<rect class="bel-bar0" x="12" y="26" width="120" height="8" rx="4"></rect>
			<rect class="bel-bar" data-bar x="12" y="26" width="0" height="8" rx="4"></rect>
			<text class="t-small bel-gold" data-et x="12" y="48"></text>
			<text class="t-small" data-lt x="70" y="250" text-anchor="middle">ядро</text>
			<text class="t-small" data-rt x="330" y="250" text-anchor="middle">протоны и нейтроны</text>
			<text class="t-small" x="388" y="20" text-anchor="end">наклон весов сильно преувеличен</text>
		</svg>
		<div class="g7__side">
			<div class="g7__row bel__pick" data-pick>
				{LIST.map((e, i) => <button type="button" class="g7__btn" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i} set:html={e.html} />)}
			</div>
			<button type="button" class="g7__btn g7__btn--go" data-split>Разделить ядро</button>
			<ul class="g7__read">
				<li><span><i>Z</i>·<i>m<sub>p</sub></i> + <i>N</i>·<i>m<sub>n</sub></i></span> <b data-r0></b></li>
				<li><span>Масса ядра <i>M</i><sub>я</sub></span> <b data-r1></b></li>
				<li class="is-key"><span>Дефект масс Δ<i>m</i></span> <b data-r2></b></li>
				<li class="is-warm"><span><i>E</i><sub>св</sub> = Δ<i>m</i>·<i>c</i>²</span> <b data-r3></b></li>
				<li><span>На один нуклон</span> <b data-r4></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Массы — в атомных единицах массы (а.е.м.): <i>m<sub>p</sub></i> = 1,00728&nbsp;а.е.м., <i>m<sub>n</sub></i> = 1,00866&nbsp;а.е.м., 1&nbsp;а.е.м. = 1,6605·10⁻²⁷&nbsp;кг, <i>c</i> = 3·10⁸&nbsp;м/с. Нуклоны ядер железа и урана нарисованы мельче, на обеих чашах одинаково.
	</figcaption>
</figure>

<style is:global>
	.bel .bel-stand {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.bel .bel-base {
		fill: var(--sl-color-gray-4);
	}
	.bel .bel-beam {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.bel .bel-needle {
		stroke: var(--nuc-p);
		stroke-width: 1.5;
	}
	.bel .bel-pivot {
		fill: var(--sl-color-gray-2);
	}
	.bel .bel-scale {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.bel .bel-pan {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, transparent);
		stroke: var(--sl-color-gray-3);
	}
	.bel .bel-string {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.bel .bel-bar0 {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	.bel .bel-bar {
		fill: var(--nuc-g);
	}
	.bel .bel-gold {
		fill: var(--nuc-g);
	}
	.bel .bel__pick {
		gap: 0.3rem;
	}
	.bel .bel__pick .g7__btn {
		padding: 0.3rem 0.5rem;
		font-weight: 400;
	}
	.bel .bel__pick .g7__btn[aria-pressed='true'] .nA,
	.bel .bel__pick .g7__btn[aria-pressed='true'] .nZ {
		color: var(--sl-color-black);
	}
</style>

<script>
	import { loop, fmt } from '../g7/kit';
	import { drawNucleus, type Nucleon } from './nucleus';

	const NS = 'http://www.w3.org/2000/svg';
	const MP = 1.00728;
	const MN = 1.00866;
	const U = 1.6605e-27;
	const C2 = 9e16;
	type Item = { A: number; Z: number; X: string; M: number; n: Nucleon[]; R: number };
	/** v·10ⁿ written the Russian way with 3 significant figures, e.g. 3,57·10⁻¹³ */
	const sci = (v: number) => {
		const e = Math.floor(Math.log10(v));
		const m = v / 10 ** e;
		const sup = String(e).replace('-', '⁻').replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d]);
		return `${fmt(m, 2)}·10${sup}`;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-bindlab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const LIST = JSON.parse(root.dataset.list!) as Item[];
		const grads = [...root.querySelectorAll('radialGradient')].map((g) => `url(#${g.id})`);
		const fills: [string, string] = [grads[1], grads[0]];
		const beam = $<SVGGElement>('[data-beam]');
		const lpan = $<SVGGElement>('[data-lpan]');
		const rpan = $<SVGGElement>('[data-rpan]');
		const PIV = { x: 200, y: 70 };
		const ARM = 130;
		const HANG = 70;
		// the pointer's scale: an arc of ±10° under the needle's tip
		{
			let d = '';
			for (let a = -10; a <= 10; a += 2.5) {
				const r = Math.abs(a) % 5 === 0 ? 8 : 4;
				const x = PIV.x + 106 * Math.sin((a * Math.PI) / 180);
				const y = PIV.y + 106 * Math.cos((a * Math.PI) / 180);
				d += `M${x.toFixed(1)} ${(y + 2).toFixed(1)} L${(x + r * Math.sin((a * Math.PI) / 180)).toFixed(1)} ${(y + 2 + r * Math.cos((a * Math.PI) / 180)).toFixed(1)} `;
			}
			$<SVGPathElement>('[data-scale]').setAttribute('d', d);
		}
		const mkPan = (g: SVGGElement) => {
			g.innerHTML = '<path class="bel-string" d=""></path><path class="bel-pan" d="M-46 0 Q0 16 46 0 Z"></path><g data-load></g>';
			return { str: g.firstElementChild as SVGPathElement, load: g.querySelector<SVGGElement>('[data-load]')! };
		};
		const L = mkPan(lpan);
		const Rp = mkPan(rpan);
		let cur = 0;
		let split = 0; // 0 = whole nucleus, 1 = split
		let target = 0;
		let angle = 0;
		/** a heap of balls (r px) on a pan, протоны first spread evenly */
		const heap = (A: number, Z: number, r: number, spread: number): Nucleon[] => {
			const out: Nucleon[] = [];
			const per = Math.max(1, Math.floor(spread / (2 * r)));
			let row = 0;
			let k = 0;
			while (k < A) {
				const inRow = Math.max(3, per - Math.floor(row / 2));
				for (let j = 0; j < inRow && k < A; j++, k++) {
					const x = (j - (inRow - 1) / 2) * 2 * r + (row % 2 ? r * 0 : 0);
					out.push([x, -r - row * 1.75 * r, 0, Math.floor(((k + 0.5) * Z) / A) !== Math.floor(((k - 0.5) * Z) / A) || (k === 0 && Z > 0) ? 1 : 0]);
				}
				row++;
			}
			// fix the number of protons exactly
			let zc = out.filter((q) => q[3]).length;
			for (let i = out.length - 1; i >= 0 && zc > Z; i--) if (out[i][3]) (out[i][3] = 0), zc--;
			for (let i = 0; i < out.length && zc < Z; i++) if (!out[i][3]) (out[i][3] = 1), zc++;
			return out;
		};
		const readouts = () => {
			const e = LIST[cur];
			const N = e.A - e.Z;
			const sum = e.Z * MP + N * MN;
			const dm = sum - e.M;
			const E = dm * U * C2;
			$('[data-r0]').textContent = `${fmt(sum, 5)} а.е.м.`;
			$('[data-r1]').textContent = `${fmt(e.M, 5)} а.е.м.`;
			$('[data-r2]').textContent = `${fmt(dm, 5)} а.е.м.`;
			$('[data-r3]').textContent = `${sci(E)} Дж`;
			$('[data-r4]').textContent = `${sci(E / e.A)} Дж`;
			$('[data-rt]').textContent = e.A > 20 ? `${e.Z} + ${N}` : 'протоны и нейтроны';
		};
		const draw = (dt: number) => {
			split += Math.sign(target - split) * Math.min(Math.abs(target - split), dt / 1.4);
			const e = LIST[cur];
			const sum = e.Z * 1.00728 + (e.A - e.Z) * 1.00866;
			const dm = sum - e.M;
			// the beam turns toward the heavier right pan; 1000 times exaggerated; level when split
			const want = ((15 * dm) / sum) * (180 / Math.PI) * (1 - split);
			angle += (want - angle) * Math.min(1, dt * 4);
			const a = (angle * Math.PI) / 180;
			beam.setAttribute('transform', `rotate(${(-angle).toFixed(2)} ${PIV.x} ${PIV.y})`);
			// pans hang from the beam's ends
			const ends = [-1, 1].map((s) => ({ x: PIV.x + s * ARM * Math.cos(a), y: PIV.y + s * ARM * Math.sin(a) }));
			[L, Rp].forEach((p, i) => {
				const E = ends[i];
				(i ? rpan : lpan).setAttribute('transform', `translate(${E.x.toFixed(1)} ${(E.y + HANG).toFixed(1)})`);
				p.str.setAttribute('d', `M0 ${-HANG} L-40 0 M0 ${-HANG} L40 0`);
			});
			// the left load: the nucleus, or its nucleons falling apart into a heap
			const big = e.A > 20;
			const rb = big ? (e.A > 100 ? 2.2 : 4) : 7;
			const H = heap(e.A, e.Z, rb, 88);
			const k = rb; // the nucleus is drawn with the same balls as the free nucleons
			// whole: the nucleus with centre at (0, −R·k − 2) in pan coordinates (k px per фм)
			const whole = e.n.map((q): Nucleon => [q[0] * k, q[1] * k - e.R * k - 2, q[2] * k, q[3]]);
			const proto = whole.filter((q) => q[3]);
			const neut = whole.filter((q) => !q[3]);
			const hp = H.filter((q) => q[3]);
			const hn = H.filter((q) => !q[3]);
			const s = split * split * (3 - 2 * split);
			const mix = (a: Nucleon[], b: Nucleon[]) => a.map((q, i): Nucleon => [q[0] + (b[i][0] - q[0]) * s, q[1] + (b[i][1] - q[1]) * s, q[2], q[3]]);
			const left = [...mix(proto, hp), ...mix(neut, hn)];
			const rk = rb + (k - rb) * (1 - s); // ball radius, px
			// drawNucleus scales by its k (= the ball radius): pass the px positions divided by it
			const scaled = (list: Nucleon[], r: number) => list.map((q): Nucleon => [q[0] / r, q[1] / r, q[2] / r, q[3]]);
			drawNucleus(L.load, scaled(left, rk), { k: rk, cx: 0, cy: 0, angle: 0, tilt: 0, fills, plus: rk >= 4 });
			drawNucleus(Rp.load, scaled(H, rb), { k: rb, cx: 0, cy: 0, angle: 0, tilt: 0, fills, plus: rb >= 4 });
			$<SVGRectElement>('[data-bar]').setAttribute('width', (120 * s).toFixed(1));
			const et = $<SVGTextElement>('[data-et]');
			et.textContent = s > 0.98 ? `сообщено ${sci(dm * U * C2)} Дж` : '';
		};
		const pick = [...root.querySelectorAll<HTMLButtonElement>('[data-i]')];
		const splitBtn = $<HTMLButtonElement>('[data-split]');
		pick.forEach((b) =>
			b.addEventListener('click', () => {
				cur = +b.dataset.i!;
				pick.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
				split = 0;
				target = 0;
				splitBtn.textContent = 'Разделить ядро';
				L.load.replaceChildren();
				Rp.load.replaceChildren();
				delete (L.load as unknown as { balls?: unknown }).balls;
				delete (Rp.load as unknown as { balls?: unknown }).balls;
				readouts();
			}),
		);
		splitBtn.addEventListener('click', () => {
			target = target ? 0 : 1;
			splitBtn.textContent = target ? 'Собрать ядро' : 'Разделить ядро';
		});
		readouts();
		draw(0);
		void NS;
		loop(root, (dt) => {
			draw(dt);
			return true;
		});
	}
</script>
