---
/**
 * «Два нуклона»: two nucleons on a line at a distance r = 0,6 … 6,0 фм (10⁻¹⁵ м), step 0,1, chosen by a slider; the pair
 * «протон — протон», «протон — нейтрон» or «нейтрон — нейтрон». On each ball: the electric force (orange, repulsion,
 * only for two protons) and the nuclear force (purple, toward the other ball when it attracts, away when it repels),
 * drawn from the ball's center (the left ball's above the line, the right ball's below it), on one common scale that adapts to the larger force at the current r (a scale bar with a round number of newtons).
 * Below: the graph F(r), repulsion up, attraction down, clipped to ±15 000 Н, a marker at the current r.
 * Physics:
 *   electric F = k e²/r², k = 9·10⁹ Н·м²/Кл² (8,99·10⁹ used), e = 1,6·10⁻¹⁹ Кл: 231 Н at 1 фм, 58 Н at 2, 9,2 Н at 5;
 *   nuclear F = −dV/dr of the Malfliet–Tjon potentials (Nucl. Phys. A 127, 161 (1969)), a standard benchmark:
 *   V(r) = (V_R e^(−μ_R r) − V_A e^(−μ_A r))/r (r in фм, V in МэВ), μ_R = 3,11 фм⁻¹, μ_A = 1,55 фм⁻¹, V_R = 1438,72 МэВ·фм,
 *   V_A = 570,316 МэВ·фм (MT-V, the spin-averaged potential), the SAME for p–p, p–n and n–n (nuclear forces do not
 *   depend on charge); 1 МэВ/фм = 160,2 Н. Nuclear force: +11 800 Н at 0,8 (repulsion), zero at 0,89, −7 200 at 1,0,
 *   −7 740 at 1,5, −3 390 at 2, −525 at 3, −13,7 at 5 (attraction). For p–p the attraction is 75 times the electric
 *   repulsion at 1,5 фм, 20 at 3, 1,5 at 5; the electric force wins beyond 5,29 фм (on the slider's 0,1 steps: at 5,3).
 * Arrows of a force that is not zero are at least 14 px long (the electric one would vanish below about 3 фм); the
 * graph cuts the repulsion above +15 000 Н and marks the cut with a zigzag and «↑ за краем».
 * The balls are drawn with the radius of a nucleon, 0,85 фм, at 40 px per фм; at the smallest distances they overlap.
 */
import G7Styles from '../g7/G7Styles.astro';
import NucStyles from './NucStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const gid = (s: string) => `nfl-${s}-${uid}`;
---

<G7Styles />
<NucStyles />
<figure class="g7 g7--stack nucf nfl not-content" data-nforcelab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 338" role="img" aria-label="Два нуклона на расстоянии r; стрелки показывают электрическую силу отталкивания и ядерную силу; ниже график сил в зависимости от расстояния">
			<defs>
				<radialGradient id={gid('p')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-p0"></stop><stop offset="1" class="nuc-p1"></stop></radialGradient>
				<radialGradient id={gid('n')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-n0"></stop><stop offset="1" class="nuc-n1"></stop></radialGradient>
				<marker id={gid('ho')} viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" class="nfl-ho"></path></marker>
				<marker id={gid('hp')} viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" class="nfl-hp"></path></marker>
			</defs>
			<!-- the two balls and their arrows -->
			<path class="nfl-axis" d="M10 80 H390"></path>
			<g data-balls></g>
			<path class="nfl-fe" data-fe0 d="" marker-end={`url(#${gid('ho')})`}></path>
			<path class="nfl-fe" data-fe1 d="" marker-end={`url(#${gid('ho')})`}></path>
			<path class="nfl-fn" data-fn0 d="" marker-end={`url(#${gid('hp')})`}></path>
			<path class="nfl-fn" data-fn1 d="" marker-end={`url(#${gid('hp')})`}></path>
			<path class="nfl-dim" data-dim d=""></path>
			<text class="t-small" data-dimt text-anchor="middle" x="200" y="134"></text>
			<path class="nfl-bar" data-bar d=""></path>
			<text class="t-small" data-bart x="0" y="24"></text>
			<text class="t-small" x="14" y="24">масштаб сил:</text>
			<!-- the graph -->
			<g transform="translate(0 150)">
				<rect class="nfl-plot" x="50" y="6" width="330" height="150" rx="4"></rect>
				<path class="nfl-zero" d="M50 81 H380"></path>
				<g data-grid></g>
				<path class="nfl-cn" data-cn d=""></path>
				<path class="nfl-ce" data-ce d=""></path>
				<path class="nfl-mark" data-mark d=""></path>
				<path class="nfl-break" data-break d=""></path>
				<text class="t-small" data-breakt x="0" y="18"></text>
				<text class="t-small" x="214" y="20">отталкивание</text>
				<text class="t-small" x="56" y="150">притяжение</text>
				<text class="t-small" x="380" y="184" text-anchor="end"><tspan class="t-i">r</tspan>, 10⁻¹⁵ м</text>
				<text class="t-small" x="8" y="12"><tspan class="t-i">F</tspan>, Н</text>
			</g>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Расстояние между центрами <i>r</i></span>
				<output data-rout>2,0·10⁻¹⁵ м</output>
				<input type="range" min="0.6" max="6" step="0.1" value="2" data-r />
			</label>
			<div class="g7__seg" data-pairs>
				<button type="button" class="g7__btn" aria-pressed="true" data-pair="pp">протон — протон</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-pair="pn">протон — нейтрон</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-pair="nn">нейтрон — нейтрон</button>
			</div>
			<ul class="g7__read">
				<li class="nfl-k-e"><span>Электрическая сила</span> <b data-re></b></li>
				<li class="nfl-k-n"><span>Ядерная сила</span> <b data-rn></b></li>
				<li class="is-warm" data-rr></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		<span class="nfl-k-e">Оранжевые</span> стрелки — электрическая сила, <span class="nfl-k-n">фиолетовые</span> — ядерная; у каждого шарика сила, с которой на него действует другой. Масштаб стрелок меняется вместе с расстоянием: смотрите на шкалу вверху; очень короткие стрелки нарисованы чуть длиннее, чтобы их было видно. На графике сила отталкивания отложена вверх, притяжения — вниз.
	</figcaption>
</figure>

<style is:global>
	.nfl {
		--nfl-e: var(--sl-color-orange);
		--nfl-n: var(--sl-color-purple);
	}
	.nfl .nfl-axis,
	.nfl .nfl-zero {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.nfl .nfl-plot {
		fill: none;
		stroke: var(--sl-color-gray-5);
	}
	.nfl .nfl-grid {
		stroke: var(--sl-color-gray-6);
		stroke-width: 1;
	}
	.nfl .nfl-fe,
	.nfl .nfl-ce {
		fill: none;
		stroke: var(--nfl-e);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.nfl .nfl-fn,
	.nfl .nfl-cn {
		fill: none;
		stroke: var(--nfl-n);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.nfl .nfl-ce,
	.nfl .nfl-cn {
		stroke-width: 2;
	}
	.nfl .nfl-ho {
		fill: var(--nfl-e);
	}
	.nfl .nfl-hp {
		fill: var(--nfl-n);
	}
	.nfl .nfl-break {
		fill: none;
		stroke: var(--nfl-n);
		stroke-width: 1.5;
	}
	.nfl .nfl-mark {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.nfl .nfl-dim,
	.nfl .nfl-bar {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.nfl .nfl-ball {
		opacity: 0.9;
	}
	.nfl .nfl-k-e {
		color: var(--nfl-e);
	}
	.nfl .nfl-k-n {
		color: var(--nfl-n);
	}
	.nfl li.nfl-k-e {
		box-shadow: inset 3px 0 0 var(--nfl-e);
	}
	.nfl li.nfl-k-n {
		box-shadow: inset 3px 0 0 var(--nfl-n);
	}
</style>

<script>
	import { fmt, segment } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const MU_R = 3.11;
	const MU_A = 1.55;
	const V_R = 1438.72;
	// one potential for every pair: nuclear forces do not depend on charge (MT-V, the spin-averaged Malfliet–Tjon)
	const V_A = { pp: 570.316, nn: 570.316, pn: 570.316 } as const;
	const MEV_FM = 160.2177; // Н per МэВ/фм
	/** The nuclear force, Н: positive = repulsion. */
	const fNuc = (r: number, pair: keyof typeof V_A) => {
		const a = V_A[pair];
		const V = (V_R * Math.exp(-MU_R * r) - a * Math.exp(-MU_A * r)) / r;
		const dV = (-V_R * MU_R * Math.exp(-MU_R * r) + a * MU_A * Math.exp(-MU_A * r)) / r - V / r;
		return -dV * MEV_FM;
	};
	const fEl = (r: number) => (8.9875e9 * 1.602e-19 ** 2) / (r * 1e-15) ** 2;
	/** 2–3 significant figures, Russian style. */
	const sig = (v: number) => {
		const a = Math.abs(v);
		if (a >= 1000) return fmt(Math.round(a / 10) * 10, 0).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
		if (a >= 100) return fmt(Math.round(a), 0);
		if (a >= 10) return fmt(a, 1).replace(/,0$/, '');
		if (a >= 1) return fmt(a, 2);
		return fmt(a, 3);
	};
	/** «в 63 раза», «в 18 раз», «в 1,3 раза» */
	const raz = (s: string) => {
		if (s.includes(',')) return 'раза';
		const n = +s.replace(/\s/g, '');
		const d = n % 10;
		const dd = n % 100;
		return d >= 2 && d <= 4 && (dd < 12 || dd > 14) ? 'раза' : 'раз';
	};
	const nice = (v: number) => {
		const p = 10 ** Math.floor(Math.log10(v));
		for (const m of [1, 2, 5, 10]) if (m * p >= v) return m * p;
		return 10 * p;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-nforcelab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const grads = [...root.querySelectorAll('radialGradient')].map((g) => `url(#${g.id})`);
		const slider = $<HTMLInputElement>('[data-r]');
		let pair: keyof typeof V_A = 'pp';
		const KX = 40; // px per фм for the balls
		const RB = 0.85 * KX;
		// the graph: r 0,6 … 6 → x 50 … 380; F ±15 000 Н → y 6 … 156 (zero at 81)
		const gx = (r: number) => 50 + ((r - 0.6) / 5.4) * 330;
		const FMAX = 15000;
		const gy = (f: number) => 81 - (Math.max(-FMAX, Math.min(FMAX, f)) / FMAX) * 75;
		const grid = $<SVGGElement>('[data-grid]');
		for (let r = 1; r <= 6; r++) {
			const l = document.createElementNS(NS, 'path');
			l.setAttribute('class', 'nfl-grid');
			l.setAttribute('d', `M${gx(r)} 6 V156`);
			grid.append(l);
			const t = document.createElementNS(NS, 'text');
			t.setAttribute('class', 't-small');
			t.setAttribute('x', String(gx(r)));
			t.setAttribute('y', '168');
			t.setAttribute('text-anchor', 'middle');
			t.textContent = String(r);
			grid.append(t);
		}
		for (const f of [-10000, 10000]) {
			const t = document.createElementNS(NS, 'text');
			t.setAttribute('class', 't-small');
			t.setAttribute('x', '46');
			t.setAttribute('y', String(gy(f) + 4));
			t.setAttribute('text-anchor', 'end');
			t.textContent = (f > 0 ? '' : '−') + '10 000';
			grid.append(t);
		}
		const curve = (f: (r: number) => number) => {
			let d = '';
			for (let r = 0.6; r <= 6.0001; r += 0.02) d += `${d ? 'L' : 'M'}${gx(r).toFixed(1)} ${gy(f(r)).toFixed(1)}`;
			return d;
		};
		const balls = $<SVGGElement>('[data-balls]');
		const draw = () => {
			const r = +slider.value;
			const kinds: [0 | 1, 0 | 1] = pair === 'pp' ? [1, 1] : pair === 'pn' ? [1, 0] : [0, 0];
			const fe = pair === 'pp' ? fEl(r) : 0;
			const fn = fNuc(r, pair);
			// balls
			const x0 = 200 - (r * KX) / 2;
			const x1 = 200 + (r * KX) / 2;
			balls.innerHTML = [x0, x1]
				.map((x, i) => `<g class="nfl-ball"><circle cx="${x}" cy="80" r="${RB}" fill="${grads[kinds[i] ? 0 : 1]}"></circle>${kinds[i] ? `<path class="nuc-plus" d="M${x - 11} 80 H${x + 11} M${x} 69 V91" stroke-width="4"></path>` : ''}</g>`)
				.join('');
			// arrows: one common scale, the larger force 100 px long (less when the balls are far apart, to stay in the picture); the left ball's arrows above the line, the right
			// ball's below it, so that arrows pointing toward each other do not cover each other
			const big = Math.max(fe, Math.abs(fn), 1e-9);
			const room = Math.min(100, x0 - 14); // the outward arrows must stay inside the picture
			const k = room / big;
			// an arrow of a force that is not zero is at least 14 px long, so the small electric force stays visible next to
			// the nuclear one (below about 3·10⁻¹⁵ м it would be shorter than its head); the readouts give the true values
			const MIN = 14;
			const arrow = (el: SVGPathElement, x: number, dirx: number, len: number, dy: number) => {
				const L = len > 0 ? Math.max(MIN, len) : 0;
				el.setAttribute('d', L > 0 ? `M${x.toFixed(1)} ${80 + dy} h${(dirx * (L - 3)).toFixed(1)}` : '');
			};
			// electric: outward (left ball to the left), drawn a little above the line; nuclear below it
			arrow($('[data-fe0]'), x0, -1, fe * k, -24);
			arrow($('[data-fe1]'), x1, 1, fe * k, 24);
			const out = fn > 0 ? 1 : -1;
			arrow($('[data-fn0]'), x0, -out, Math.abs(fn) * k, -12);
			arrow($('[data-fn1]'), x1, out, Math.abs(fn) * k, 12);
			$<SVGPathElement>('[data-dim]').setAttribute('d', `M${x0} 120 V126 M${x0} 123 H${x1} M${x1} 120 V126`);
			$<SVGTextElement>('[data-dimt]').textContent = `r = ${fmt(r, 1)}·10⁻¹⁵ м`;
			// the scale bar: a round number of newtons
			const nb = nice(big / 2);
			const bl = nb * k;
			$<SVGPathElement>('[data-bar]').setAttribute('d', `M96 16 V24 M96 20 H${(96 + bl).toFixed(1)} M${(96 + bl).toFixed(1)} 16 V24`);
			const bt = $<SVGTextElement>('[data-bart]');
			bt.setAttribute('x', (100 + bl).toFixed(1));
			bt.textContent = `${sig(nb)} Н`;
			// the graph
			$<SVGPathElement>('[data-cn]').setAttribute('d', curve((q) => fNuc(q, pair)));
			// the part of the curve above +15 000 Н is cut off: a zigzag on the top edge and «↑ за краем»
			let rc = 0.6;
			while (rc < 6 && fNuc(rc, pair) > FMAX) rc += 0.01;
			if (rc > 0.6) {
				let z = `M${gx(0.6).toFixed(1)} 6`;
				for (let x = gx(0.6), k2 = 0; x < gx(rc); x += 4, k2++) z += ` L${(x + 2).toFixed(1)} ${k2 % 2 ? 6 : 2}`;
				$<SVGPathElement>('[data-break]').setAttribute('d', z);
				const bt = $<SVGTextElement>('[data-breakt]');
				bt.setAttribute('x', (gx(rc) + 4).toFixed(1));
				bt.textContent = '↑ за краем';
			}
			$<SVGPathElement>('[data-ce]').setAttribute('d', pair === 'pp' ? curve(fEl) : `M50 81 H380`);
			$<SVGPathElement>('[data-mark]').setAttribute('d', `M${gx(r).toFixed(1)} 6 V156`);
			// readouts
			$<HTMLOutputElement>('[data-rout]').textContent = `${fmt(r, 1)}·10⁻¹⁵ м`;
			$('[data-re]').textContent = pair === 'pp' ? `${sig(fe)} Н (отталкивание)` : '0 (у нейтрона нет заряда)';
			$('[data-rn]').textContent = `${sig(Math.abs(fn))} Н (${fn > 0 ? 'отталкивание' : 'притяжение'})`;
			const rr = $('[data-rr]');
			if (pair !== 'pp') rr.innerHTML = '<span>Электрической силы нет</span>';
			else {
				const q = Math.abs(fn) / fe;
				const v = sig(q >= 1 ? q : 1 / q);
				rr.innerHTML = `<span>Ядерная ${q >= 1 ? 'сильнее' : 'слабее'} электрической</span> <b>в ${v} ${raz(v)}</b>`;
			}
		};
		slider.addEventListener('input', draw);
		segment($('[data-pairs]'), (b) => {
			pair = b.dataset.pair as keyof typeof V_A;
			draw();
		});
		draw();
	}
</script>
