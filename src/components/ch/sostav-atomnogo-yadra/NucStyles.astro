---
/**
 * Colors shared by the pictures and models of «Состав атомного ядра. Ядерные силы». Renders nothing.
 * The same colors as «Радиоактивность. Модели атома» and the grade 8 atom: protons and α particles --ig-vy (positive),
 * electrons and β particles --ig-vx (negative), neutrons gray, γ gold --ig-v; the nuclear force green.
 * The notation ᴬ_Z X: A in the accent color, Z in the color of protons (Nota.astro in SVG; .nA/.nZ in KaTeX).
 * Gradient stops: .nuc-p0/.nuc-p1 (proton), .nuc-n0/.nuc-n1 (neutron), .nuc-e0/.nuc-e1 (electron).
 */
---

<style is:global>
	.nucf {
		--nuc-p: var(--ig-vy);
		--nuc-n: var(--sl-color-gray-3);
		--nuc-e: var(--ig-vx);
		--nuc-g: var(--ig-v);
		--nuc-force: hsl(150, 60%, 58%);
	}
	:root[data-theme='light'] .nucf {
		--nuc-n: var(--sl-color-gray-4);
		--nuc-force: hsl(150, 70%, 30%);
	}
	.nucf .nuc-p0 {
		stop-color: color-mix(in srgb, var(--nuc-p) 55%, white);
	}
	.nucf .nuc-p1 {
		stop-color: color-mix(in srgb, var(--nuc-p) 80%, black);
	}
	.nucf .nuc-n0 {
		stop-color: color-mix(in srgb, var(--nuc-n) 55%, white);
	}
	.nucf .nuc-n1 {
		stop-color: color-mix(in srgb, var(--nuc-n) 75%, black);
	}
	.nucf .nuc-e0 {
		stop-color: color-mix(in srgb, var(--nuc-e) 55%, white);
	}
	.nucf .nuc-e1 {
		stop-color: color-mix(in srgb, var(--nuc-e) 85%, black);
	}
	.nucf .nuc-p circle,
	.nucf .nuc-n circle {
		stroke: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
		stroke-width: 0.5;
	}
	.nucf .nuc-plus {
		fill: none;
		stroke: white;
		stroke-linecap: round;
		opacity: 0.9;
	}
	.nucf .nuc-bar {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.nucf .nuc-e {
		fill: var(--nuc-e);
	}
	.nucf .nota-a,
	.nucf .nA {
		fill: var(--sl-color-accent);
		color: var(--sl-color-accent);
		font-variant-numeric: tabular-nums;
	}
	.nucf .nota-z,
	.nucf .nZ {
		fill: var(--nuc-p);
		color: var(--nuc-p);
		font-variant-numeric: tabular-nums;
	}
	.nucf .nota-x {
		font-weight: 600;
		fill: var(--sl-color-white);
	}
	.nucf .t-gray {
		fill: var(--sl-color-gray-3);
	}
</style>
