---
/**
 * «Изотопы водорода»: protium ¹₁H (1 proton), deuterium ²₁H (1 proton + 1 neutron), tritium ³₁H (1 proton + 2 neutrons),
 * each with ONE electron on the same orbit, which goes round at the same pace in all three (the same charge of the
 * nucleus holds the same electron: the chemistry is the same). Electrons orbit once in 4 s (really ~1,5·10⁻¹⁶ s).
 * NOT to scale: the nuclei are drawn at 7 px per фм, the orbit is 44 px; a real hydrogen atom (about 1·10⁻¹⁰ м) is about
 * 60 000 times larger than its nucleus (a proton about 1,7·10⁻¹⁵ м across). The caption says so.
 * Labels: the notation (Nota.astro), «1 протон», «+ 1 нейтрон» / «+ 2 нейтрона», and one common line «один протон, один
 * электрон — один и тот же химический элемент». The electron is not to scale either.
 * Colors as in NucStyles: protons --ig-vy, neutrons gray, the electron --ig-vx.
 */
import G7Styles from '../g7/G7Styles.astro';
import NucStyles from './NucStyles.astro';
import Nota from './Nota.astro';
import { pack } from './nucleus';

const items = [
	{ name: 'Протий', A: 1, x: 68, l1: '1 протон', l2: '' },
	{ name: 'Дейтерий', A: 2, x: 200, l1: '1 протон', l2: '+ 1 нейтрон' },
	{ name: 'Тритий', A: 3, x: 332, l1: '1 протон', l2: '+ 2 нейтрона' },
].map((it, i) => ({ ...it, n: pack(it.A, 1, 3 + i) }));
const CY = 70;
const RO = 44;
const uid = Math.random().toString(36).slice(2, 8);
const gid = (s: string) => `hiso-${s}-${uid}`;
---

<G7Styles />
<NucStyles />
<figure class="g7 g7--pic nucf not-content" data-hisopic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 238" role="img" aria-label="Три атома водорода: протий — ядро из одного протона, дейтерий — протон и нейтрон, тритий — протон и два нейтрона. Вокруг каждого ядра по одному электрону на одинаковой орбите">
			<defs>
				<radialGradient id={gid('p')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-p0"></stop><stop offset="1" class="nuc-p1"></stop></radialGradient>
				<radialGradient id={gid('n')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-n0"></stop><stop offset="1" class="nuc-n1"></stop></radialGradient>
				<radialGradient id={gid('e')} cx="0.35" cy="0.32" r="0.75"><stop offset="0" class="nuc-e0"></stop><stop offset="1" class="nuc-e1"></stop></radialGradient>
			</defs>
			{
				items.map((it) => (
					<g>
						<circle class="hiso-orbit" cx={it.x} cy={CY} r={RO} />
						<g data-nuc={JSON.stringify(it.n)} data-cx={it.x} data-cy={CY} />
						<g data-el={it.x}>
							<circle r="4.5" fill={`url(#${gid('e')})`} />
							<path class="nuc-plus" d="M-2 0 H2" stroke-width="1" />
						</g>
						<text class="t-title" x={it.x} y={CY + 72} text-anchor="middle">
							{it.name}
						</text>
						<Nota x={it.x - 5} y={CY + 104} A={it.A} Z={1} X="H" size={18} />
						<text x={it.x} y={CY + 126} text-anchor="middle" class="t-red">
							{it.l1}
						</text>
						<text x={it.x} y={CY + 141} text-anchor="middle">
							{it.l2}
						</text>
					</g>
				))
			}
			<text x="200" y="230" text-anchor="middle" class="t-small">один протон, один электрон — один и тот же химический элемент</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Ядра нарисованы огромными: на самом деле атом водорода примерно в 60&nbsp;000 раз больше своего ядра. Электрон нарисован не в масштабе; у всех трёх атомов он движется одинаково, потому что заряд ядра одинаковый.
	</figcaption>
</figure>

<style is:global>
	.nucf .hiso-orbit {
		fill: none;
		stroke: color-mix(in srgb, var(--nuc-e) 55%, transparent);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { drawNucleus, type Nucleon } from './nucleus';

	for (const root of document.querySelectorAll<HTMLElement>('[data-hisopic]')) {
		const grads = [...root.querySelectorAll('radialGradient')].map((g) => `url(#${g.id})`);
		const fills: [string, string] = [grads[1], grads[0]];
		const nuclei = [...root.querySelectorAll<SVGGElement>('[data-nuc]')].map((g) => ({ g, n: JSON.parse(g.dataset.nuc!) as Nucleon[], cx: +g.dataset.cx!, cy: +g.dataset.cy! }));
		const els = [...root.querySelectorAll<SVGGElement>('[data-el]')];
		let t = 0;
		const draw = () => {
			nuclei.forEach((u) => drawNucleus(u.g, u.n, { k: 7, cx: u.cx, cy: u.cy, angle: (2 * Math.PI * t) / 12, tilt: 0.35, fills }));
			// the same orbit and the same pace for all three electrons (one turn in 4 s)
			const a = (2 * Math.PI * t) / 4 - Math.PI / 2;
			els.forEach((e) => e.setAttribute('transform', `translate(${(+e.dataset.el! + 44 * Math.cos(a)).toFixed(2)} ${(70 + 44 * Math.sin(a)).toFixed(2)})`));
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
