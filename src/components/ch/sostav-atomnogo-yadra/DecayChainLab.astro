---
/**
 * «Ряд урана»: a chart with Z across (80 … 93, the symbols under the axis) and A up (204 … 240, gridlines every 4).
 * Start: ²³⁸₉₂U. At each step the model says what the current nucleus does («уран-238 испытывает α-распад») and offers
 * three products: the right one, one with Z shifted the wrong way, one with A changed wrongly (order shuffled). A right
 * choice draws the arrow on the chart (α red: 2 to the left, 4 down; β blue: 1 to the right, the same A) and writes the
 * equation into a list under the chart (inside a collapsed «Уравнения распадов», to save height); a wrong one shows «Подумайте ещё» and a hint. Counters of α and β decays; «Сброс» and «Показать весь ряд»
 * (one step per second). The end: ²⁰⁶₈₂Pb, a stable nucleus.
 * The real main branch of the uranium-238 series: ²³⁸U α → ²³⁴Th β → ²³⁴Pa β → ²³⁴U α → ²³⁰Th α → ²²⁶Ra α → ²²²Rn
 * α → ²¹⁸Po α → ²¹⁴Pb β → ²¹⁴Bi β → ²¹⁴Po α → ²¹⁰Pb β → ²¹⁰Bi β → ²¹⁰Po α → ²⁰⁶Pb: 8 α and 6 β;
 * 238 − 4·8 = 206, 92 − 2·8 + 6 = 82. (The small side branches, under 0,1 %, are left out.)
 */
import G7Styles from '../g7/G7Styles.astro';
import NucStyles from './NucStyles.astro';
---

<G7Styles />
<NucStyles />
<figure class="g7 nucf dcl not-content" data-chainlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 300" role="img" aria-label="Карта ядер: по горизонтали зарядовое число Z от 80 до 93, по вертикали массовое число A от 204 до 240. Стрелки показывают альфа- и бета-распады в ряду урана-238">
			<g data-grid></g>
			<g data-arrows></g>
			<g data-marks></g>
		</svg>
		<div class="g7__side">
			<p class="dcl__q" data-q></p>
			<div class="g7__row dcl__opts" data-opts></div>
			<p class="g7__msg" data-msg></p>
			<ul class="g7__read">
				<li><span>α-распадов</span> <b data-na>0</b></li>
				<li><span>β-распадов</span> <b data-nb>0</b></li>
			</ul>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-reset>Сброс</button>
				<button type="button" class="g7__btn" data-auto>Показать весь ряд</button>
			</div>
		</div>
	</div>
	<details class="dcl__box">
		<summary>Уравнения распадов (<span data-neq>0</span>)</summary>
		<ol class="dcl__eqs" data-eqs></ol>
	</details>
	<figcaption class="g7__caption">
		<span class="dcl-ka">Красные</span> стрелки — α-распад, <span class="dcl-kb">синие</span> — β-распад. Уравнения распадов записываются в список под картой; он раскрывается по нажатию.
	</figcaption>
</figure>

<style is:global>
	.dcl .dcl-grid {
		stroke: var(--sl-color-gray-6);
		stroke-width: 1;
	}
	.dcl .dcl-axis {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.dcl .dcl-a {
		fill: none;
		stroke: var(--nuc-p);
		stroke-width: 2;
	}
	.dcl .dcl-b {
		fill: none;
		stroke: var(--nuc-e);
		stroke-width: 2;
	}
	.dcl .dcl-ha {
		fill: var(--nuc-p);
	}
	.dcl .dcl-hb {
		fill: var(--nuc-e);
	}
	.dcl .dcl-dot {
		fill: var(--sl-color-gray-1);
	}
	.dcl .dcl-dot.is-cur {
		fill: var(--sl-color-accent);
	}
	.dcl .dcl-lab {
		font-size: 10px;
		fill: var(--sl-color-gray-1);
	}
	.dcl .dcl-ka {
		color: var(--nuc-p);
	}
	.dcl .dcl-kb {
		color: var(--nuc-e);
	}
	.dcl .dcl__q {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	.dcl .dcl__opts .g7__btn {
		flex: 1 1 4.5rem;
		font-size: 1.05rem;
		font-weight: 400;
	}
	.dcl .nt {
		white-space: nowrap;
	}
	.dcl .nt-i {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		font-size: 0.62em;
		line-height: 1.05;
		vertical-align: 0.42em;
		margin-right: 0.08em;
		font-variant-numeric: tabular-nums;
	}
	.dcl .nt-i .nA {
		color: var(--sl-color-accent);
	}
	.dcl .nt-i .nZ {
		color: var(--nuc-p);
	}
	.dcl .g7__btn[aria-pressed='true'] .nt-i span {
		color: inherit;
	}
	.dcl .dcl__box {
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.dcl .dcl__box summary {
		cursor: pointer;
	}
	.dcl .dcl__eqs {
		margin: 0.75rem 0 0;
		padding-left: 1.6rem;
		columns: 2 16rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.dcl .dcl__eqs li {
		margin: 0.1rem 0;
		break-inside: avoid;
	}
</style>

<script>
	const NS = 'http://www.w3.org/2000/svg';
	const SYM: Record<number, string> = { 78: 'Pt', 79: 'Au', 80: 'Hg', 81: 'Tl', 82: 'Pb', 83: 'Bi', 84: 'Po', 85: 'At', 86: 'Rn', 87: 'Fr', 88: 'Ra', 89: 'Ac', 90: 'Th', 91: 'Pa', 92: 'U', 93: 'Np', 94: 'Pu', 95: 'Am' };
	const NAME: Record<number, string> = { 82: 'свинец', 83: 'висмут', 84: 'полоний', 86: 'радон', 88: 'радий', 90: 'торий', 91: 'протактиний', 92: 'уран' };
	// the main branch: [A, Z, decay of this nucleus]
	const CHAIN: [number, number, 'a' | 'b' | ''][] = [
		[238, 92, 'a'], [234, 90, 'b'], [234, 91, 'b'], [234, 92, 'a'], [230, 90, 'a'], [226, 88, 'a'], [222, 86, 'a'], [218, 84, 'a'],
		[214, 82, 'b'], [214, 83, 'b'], [214, 84, 'a'], [210, 82, 'b'], [210, 83, 'b'], [210, 84, 'a'], [206, 82, ''],
	];
	const nt = (A: number, Z: number, X = SYM[Z]) => `<span class="nt"><span class="nt-i"><span class="nA">${A}</span><span class="nZ">${String(Z).replace('-', '−')}</span></span>${X}</span>`;
	const HE = nt(4, 2, 'He');
	const EL = `<span class="nt"><span class="nt-i"><span class="nA">0</span><span class="nZ">−1</span></span><i>e</i></span>`;
	// the chart: Z 80 … 93 → x 46 + 24·(Z − 80) (cell centers); A 204 … 240 → y 262 … 22
	const X = (Z: number) => 46 + 24 * (Z - 80) + 12;
	const Y = (A: number) => 262 - (A - 204) * (240 / 36);

	for (const root of document.querySelectorAll<HTMLElement>('[data-chainlab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const mk = (parent: Element, tag: string, a: Record<string, string | number>, text?: string) => {
			const e = document.createElementNS(NS, tag);
			for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
			if (text !== undefined) e.textContent = text;
			parent.append(e);
			return e;
		};
		const grid = $<SVGGElement>('[data-grid]');
		for (let A = 204; A <= 240; A += 4) {
			mk(grid, 'path', { class: 'dcl-grid', d: `M46 ${Y(A)} H382` });
			mk(grid, 'text', { class: 't-small', x: 40, y: Y(A) + 4, 'text-anchor': 'end' }, String(A));
		}
		for (let Z = 80; Z <= 93; Z++) {
			mk(grid, 'path', { class: 'dcl-grid', d: `M${X(Z)} 22 V262` });
			mk(grid, 'text', { class: 't-small', x: X(Z), y: 276, 'text-anchor': 'middle' }, String(Z));
			mk(grid, 'text', { class: 't-small', x: X(Z), y: 289, 'text-anchor': 'middle' }, SYM[Z]);
		}
		mk(grid, 'text', { class: 't-small', x: 8, y: 14 }, 'A');
		mk(grid, 'text', { class: 't-small', x: 392, y: 289, 'text-anchor': 'end' }, 'Z');
		const arrows = $<SVGGElement>('[data-arrows]');
		const marks = $<SVGGElement>('[data-marks]');
		let step = 0;
		let na = 0;
		let nb = 0;
		let auto = 0;
		const msg = $<HTMLParagraphElement>('[data-msg]');
		const opts = $<HTMLDivElement>('[data-opts]');
		const eqs = $<HTMLOListElement>('[data-eqs]');
		// the name goes away from the arrow that comes in: after α (from the upper right) to the lower left, otherwise
		// to the upper right
		const mark = (A: number, Z: number, after: 'a' | 'b' | '' = '') => {
			// only the current nucleus is named (the names of neighbors with the same A would overlap)
			marks.querySelectorAll('.is-cur').forEach((e) => e.classList.remove('is-cur'));
			marks.querySelectorAll('.dcl-lab').forEach((e) => e.remove());
			mk(marks, 'circle', { class: 'dcl-dot is-cur', cx: X(Z), cy: Y(A), r: 4.5 });
			mk(marks, 'text', after === 'a' ? { class: 'dcl-lab', x: X(Z) - 6, y: Y(A) + 13, 'text-anchor': 'end' } : { class: 'dcl-lab', x: X(Z) + 6, y: Y(A) - 5 }, `${SYM[Z]}-${A}`);
		};
		const arrow = (A: number, Z: number, a2: number, z2: number, kind: 'a' | 'b') => {
			const x1 = X(Z);
			const y1 = Y(A);
			const x2 = X(z2);
			const y2 = Y(a2);
			const l = Math.hypot(x2 - x1, y2 - y1);
			const ux = (x2 - x1) / l;
			const uy = (y2 - y1) / l;
			const ex = x2 - ux * 6;
			const ey = y2 - uy * 6;
			mk(arrows, 'path', { class: kind === 'a' ? 'dcl-a' : 'dcl-b', d: `M${(x1 + ux * 5).toFixed(1)} ${(y1 + uy * 5).toFixed(1)} L${(ex - ux * 4).toFixed(1)} ${(ey - uy * 4).toFixed(1)}` });
			mk(arrows, 'path', { class: kind === 'a' ? 'dcl-ha' : 'dcl-hb', d: `M${ex.toFixed(1)} ${ey.toFixed(1)} L${(ex - ux * 7 - uy * 3.5).toFixed(1)} ${(ey - uy * 7 + ux * 3.5).toFixed(1)} L${(ex - ux * 7 + uy * 3.5).toFixed(1)} ${(ey - uy * 7 - ux * 3.5).toFixed(1)} Z` });
		};
		const ask = () => {
			const [A, Z, d] = CHAIN[step];
			opts.replaceChildren();
			if (!d) {
				$('[data-q]').innerHTML = `${nt(A, Z)} — стабильное ядро. Ряд закончился.`;
				msg.textContent = `Всего ${na} α-распадов и ${nb} β-распадов.`;
				msg.classList.add('is-right');
				return;
			}
			$('[data-q]').innerHTML = `${NAME[Z]}-${A} испытывает ${d === 'a' ? 'α' : 'β'}-распад. Какое ядро получится?`;
			const right: [number, number] = d === 'a' ? [A - 4, Z - 2] : [A, Z + 1];
			const wrong: [number, number][] = d === 'a' ? [[A - 4, Z + 2], [A, Z - 2]] : [[A, Z - 1], [A - 1, Z + 1]];
			const all = [right, ...wrong];
			const rot = step % 3;
			const order = [...all.slice(rot), ...all.slice(0, rot)];
			for (const [a2, z2] of order) {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'g7__btn';
				b.innerHTML = nt(a2, z2);
				const ok = a2 === right[0] && z2 === right[1];
				b.addEventListener('click', () => (ok ? advance() : wrongPick()));
				opts.append(b);
			}
		};
		const wrongPick = () => {
			const d = CHAIN[step][2];
			msg.classList.remove('is-right');
			msg.textContent = d === 'a' ? 'Подумайте ещё: при α-распаде A уменьшается на 4, Z — на 2.' : 'Подумайте ещё: при β-распаде A не меняется, а Z увеличивается на 1.';
		};
		const advance = () => {
			const [A, Z, d] = CHAIN[step];
			const [a2, z2] = CHAIN[step + 1];
			arrow(A, Z, a2, z2, d as 'a' | 'b');
			mark(a2, z2, d as 'a' | 'b');
			if (d === 'a') na++;
			else nb++;
			$('[data-na]').textContent = String(na);
			$('[data-nb]').textContent = String(nb);
			const li = document.createElement('li');
			li.innerHTML = `${nt(A, Z)} → ${nt(a2, z2)} + ${d === 'a' ? HE : EL}`;
			eqs.append(li);
			$('[data-neq]').textContent = String(eqs.children.length);
			msg.classList.add('is-right');
			msg.textContent = 'Верно';
			step++;
			ask();
		};
		const reset = () => {
			step = 0;
			na = 0;
			nb = 0;
			arrows.replaceChildren();
			marks.replaceChildren();
			eqs.replaceChildren();
			$('[data-neq]').textContent = '0';
			$('[data-na]').textContent = '0';
			$('[data-nb]').textContent = '0';
			msg.textContent = '';
			msg.classList.remove('is-right');
			mark(238, 92);
			ask();
		};
		$('[data-reset]').addEventListener('click', () => {
			clearInterval(auto);
			reset();
		});
		$('[data-auto]').addEventListener('click', () => {
			clearInterval(auto);
			if (!CHAIN[step][2]) reset();
			auto = window.setInterval(() => {
				if (!CHAIN[step][2]) return clearInterval(auto);
				advance();
			}, 1000);
		});
		reset();
	}
</script>
