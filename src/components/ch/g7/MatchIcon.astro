---
/**
 * Small pictures of measuring instruments for the cards of Match.astro (56 × 44): a ruler, a tape measure, kitchen
 * scales, a stopwatch, a clock, a thermometer, a speedometer, a measuring cylinder. Lines take the card's text color.
 */
interface Props {
	name: 'ruler' | 'tape' | 'scales' | 'stopwatch' | 'clock' | 'thermometer' | 'speedometer' | 'cylinder';
}
const { name } = Astro.props;
const ticks = (n: number, f: (i: number) => string) => Array.from({ length: n }, (_, i) => f(i)).join(' ');
---

<svg class="mti" viewBox="0 0 56 44" aria-hidden="true">
	{
		name === 'ruler' && (
			<>
				<rect class="mti__wood" x="3" y="15" width="50" height="14" rx="1.5" />
				<path class="mti__line" d={ticks(12, (i) => `M${6 + i * 4} 15 v${i % 5 === 0 ? 7 : 4}`)} />
			</>
		)
	}
	{
		name === 'tape' && (
			<>
				<rect class="mti__tape" x="24" y="27" width="29" height="6" />
				<path class="mti__line" d={ticks(7, (i) => `M${27 + i * 4} 27 v3`) + ' M53 26 v8'} />
				<circle class="mti__case" cx="16" cy="24" r="13" />
				<circle class="mti__line" cx="16" cy="24" r="4" />
			</>
		)
	}
	{
		name === 'scales' && (
			<>
				<path class="mti__line" d="M6 9 H50 M28 9 V14" />
				<rect class="mti__case" x="9" y="14" width="38" height="27" rx="4" />
				<circle class="mti__dial" cx="28" cy="28" r="9" />
				<path class="mti__hand" d="M28 28 L33 22" />
			</>
		)
	}
	{
		name === 'stopwatch' && (
			<>
				<rect class="mti__case" x="25" y="2" width="6" height="5" rx="1" />
				<path class="mti__line" d="M37 9 l3 -3" />
				<circle class="mti__dial" cx="28" cy="25" r="16" />
				<path class="mti__line" d={ticks(12, (i) => { const a = (i * Math.PI) / 6; return `M${(28 + 13 * Math.sin(a)).toFixed(1)} ${(25 - 13 * Math.cos(a)).toFixed(1)} L${(28 + 15 * Math.sin(a)).toFixed(1)} ${(25 - 15 * Math.cos(a)).toFixed(1)}`; })} />
				<path class="mti__hand" d="M28 25 L35 15" />
			</>
		)
	}
	{
		name === 'clock' && (
			<>
				<circle class="mti__case" cx="28" cy="22" r="19" />
				<circle class="mti__dial" cx="28" cy="22" r="15" />
				<path class="mti__line" d={ticks(12, (i) => { const a = (i * Math.PI) / 6; return `M${(28 + 12 * Math.sin(a)).toFixed(1)} ${(22 - 12 * Math.cos(a)).toFixed(1)} L${(28 + 14.5 * Math.sin(a)).toFixed(1)} ${(22 - 14.5 * Math.cos(a)).toFixed(1)}`; })} />
				<path class="mti__hand" d="M28 22 V12 M28 22 L35 25" />
			</>
		)
	}
	{
		name === 'thermometer' && (
			<>
				<rect class="mti__dial" x="24" y="3" width="8" height="32" rx="4" />
				<rect class="mti__red" x="26.5" y="16" width="3" height="22" />
				<circle class="mti__red" cx="28" cy="37" r="5.5" />
				<path class="mti__line" d={ticks(6, (i) => `M34 ${8 + i * 4.4} h${i % 2 ? 3 : 5}`)} />
			</>
		)
	}
	{
		name === 'speedometer' && (
			<>
				<path class="mti__case" d="M6 36 A22 22 0 0 1 50 36 Z" />
				<path class="mti__line" d={ticks(9, (i) => { const a = Math.PI - (i * Math.PI) / 8; return `M${(28 + 16 * Math.cos(a)).toFixed(1)} ${(36 - 16 * Math.sin(a)).toFixed(1)} L${(28 + 20 * Math.cos(a)).toFixed(1)} ${(36 - 20 * Math.sin(a)).toFixed(1)}`; })} />
				<path class="mti__redline" d="M28 36 L40 22" />
				<circle class="mti__line" cx="28" cy="36" r="2" />
			</>
		)
	}
	{
		name === 'cylinder' && (
			<>
				<rect class="mti__water" x="21" y="20" width="14" height="19" />
				<path class="mti__glass" d="M21 3 V39 H35 V3 M18 42 H38" />
				<path class="mti__line" d={ticks(8, (i) => `M21 ${7 + i * 4.4} h${i % 2 ? 3 : 6}`)} />
			</>
		)
	}
</svg>

<style is:global>
	.mti {
		display: block;
		width: 3.4rem;
		height: auto;
		margin: 0 auto 0.15rem;
	}
	.mti__line,
	.mti__glass,
	.mti__hand,
	.mti__redline {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mti__hand {
		stroke-width: 2.2;
	}
	.mti__redline {
		stroke: var(--g7-red);
		stroke-width: 2.4;
	}
	.mti__wood {
		fill: var(--g7-wood);
		stroke: currentColor;
		stroke-width: 1;
	}
	.mti__case {
		fill: color-mix(in oklab, var(--g7-gold) 45%, transparent);
		stroke: currentColor;
		stroke-width: 1.4;
	}
	.mti__tape {
		fill: var(--g7-gold);
		stroke: currentColor;
		stroke-width: 1;
	}
	.mti__dial {
		fill: var(--g7-paper);
		stroke: currentColor;
		stroke-width: 1.4;
	}
	.mti__red {
		fill: var(--g7-red);
	}
	.mti__water {
		fill: var(--g7-water);
	}
</style>
