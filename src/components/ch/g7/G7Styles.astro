---
/**
 * The shared frame of the models and pictures of the grade 7 chapters written in November 2026. Renders nothing.
 *   <figure class="g7 not-content">            a model: a drawing, controls, readouts, a caption
 *     <div class="g7__grid"> <svg class="g7__svg"> … </svg> <div class="g7__side"> … </div> </div>
 *     <figcaption class="g7__caption"> … </figcaption>
 *   <figure class="g7 g7--pic not-content">     a picture: one or several panels, no controls (or «Повторить»)
 * Modifiers: g7--stack (the drawing above the controls), g7--wide (the drawing takes more of the width).
 * Colors: --g7-blue, --g7-red, --g7-gold, --g7-green, --g7-violet, and materials (--g7-wood, --g7-steel, --g7-water,
 * --g7-skin …), all from the theme variables, so both themes work.
 */
---

<style is:global>
	.g7 {
		--g7-blue: var(--ig-vx);
		--g7-red: var(--ig-vy);
		--g7-gold: var(--ig-v);
		--g7-green: hsl(150, 60%, 58%);
		--g7-violet: hsl(275, 75%, 76%);
		--g7-ink: var(--sl-color-gray-1);
		--g7-line: var(--sl-color-gray-3);
		--g7-faint: var(--sl-color-gray-5);
		--g7-paper: var(--sl-color-bg);
		--g7-water: color-mix(in srgb, var(--ig-vx) 26%, transparent);
		--g7-water-edge: color-mix(in srgb, var(--ig-vx) 80%, var(--sl-color-white));
		--g7-glass: color-mix(in oklab, var(--sl-color-gray-2) 70%, transparent);
		--g7-steel: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-gray-3));
		--g7-steel-dark: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-4));
		--g7-wood: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
		--g7-wood-dark: color-mix(in oklab, var(--ig-v) 34%, var(--sl-color-gray-5));
		--g7-skin: color-mix(in oklab, var(--ig-v) 34%, var(--sl-color-gray-3));
		--g7-ground: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-5));
		--g7-sky: color-mix(in oklab, var(--ig-vx) 16%, var(--sl-color-bg));
		container-type: inline-size;
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .g7 {
		--g7-green: hsl(150, 70%, 30%);
		--g7-violet: hsl(275, 55%, 46%);
		--g7-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-6));
		--g7-wood: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-5));
		--g7-wood-dark: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
	}
	.g7 i,
	.g7 .i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.g7__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 1rem 1.25rem;
		align-items: start;
	}
	.g7--wide .g7__grid {
		grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
	}
	.g7--stack .g7__grid,
	.g7--pic .g7__grid {
		grid-template-columns: minmax(0, 1fr);
	}
	.g7--pic {
		margin-block: 1.5rem;
		padding: 0.75rem;
	}
	.g7--pic .g7__grid.is-two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.g7--pic .g7__grid.is-three {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.g7--narrow .g7__grid {
		max-width: 34rem;
		margin-inline: auto;
	}
	.g7__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--g7-paper);
		user-select: none;
		-webkit-user-select: none;
	}
	.g7__canvas {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--g7-paper);
		touch-action: pan-y;
	}
	.g7__svg text {
		font-family: var(--__sl-font);
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .t-title {
		font-size: 13px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.g7__svg .t-strong {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.g7__svg .t-small {
		font-size: 10.5px;
		fill: var(--sl-color-gray-3);
	}
	.g7__svg .t-num {
		font-variant-numeric: tabular-nums;
	}
	.g7__svg .t-halo {
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.g7__svg .t-i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
	}
	.g7__svg .t-blue {
		fill: var(--g7-blue);
	}
	.g7__svg .t-red {
		fill: var(--g7-red);
	}
	.g7__svg .t-gold {
		fill: var(--g7-gold);
	}
	.g7__svg .t-green {
		fill: var(--g7-green);
	}
	.g7__svg .drag {
		cursor: grab;
		touch-action: none;
	}
	.g7__svg .drag:active {
		cursor: grabbing;
	}
	.g7__side {
		display: grid;
		gap: 0.6rem;
		align-content: start;
	}
	.g7__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.2rem 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.g7__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.g7__slider input {
		grid-column: 1 / -1;
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.g7__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
	}
	.g7__label {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.g7__seg {
		display: inline-flex;
		flex-wrap: wrap;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.7rem;
		overflow: hidden;
	}
	.g7__seg .g7__btn {
		border: 0;
		border-radius: 0;
		background: transparent;
		padding-inline: 0.65rem;
		flex: 1 1 auto;
	}
	.g7__seg .g7__btn + .g7__btn {
		border-left: 1px solid var(--sl-color-gray-4);
	}
	.g7__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.25;
		padding: 0.42rem 0.85rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.7rem;
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.g7__btn:hover:not(:disabled) {
		background: var(--sl-color-gray-6);
	}
	.g7__btn[aria-pressed='true'],
	.g7__btn.is-on {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.g7__btn--go {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.g7__btn--go:hover:not(:disabled) {
		background: var(--sl-color-accent-high);
		color: var(--sl-color-black);
	}
	.g7__btn:disabled {
		opacity: 0.4;
		cursor: default;
	}
	.g7__select {
		display: grid;
		gap: 0.2rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.g7__select select {
		font: inherit;
		font-weight: 600;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		max-width: 100%;
	}
	.g7__read {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.3rem;
	}
	.g7__read li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0;
		padding: 0.3rem 0.6rem;
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.g7__read li b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.g7__read li.is-key {
		box-shadow: inset 3px 0 0 var(--g7-blue);
		background: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-gray-6));
	}
	.g7__read li.is-warm {
		box-shadow: inset 3px 0 0 var(--g7-gold);
		background: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-6));
	}
	.g7__lines {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.3rem;
	}
	.g7__lines li {
		margin: 0;
		padding: 0.3rem 0.6rem;
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		overflow-x: auto;
		overflow-y: hidden;
	}
	.g7__lines li.is-key {
		box-shadow: inset 3px 0 0 var(--g7-blue);
		background: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-gray-6));
	}
	.g7__lines li.is-text {
		background: none;
		padding-inline: 0.2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.g7__lines .katex {
		font-size: 1em;
	}
	.g7__note {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.g7__msg {
		margin: 0;
		padding: 0.45rem 0.7rem;
		border-radius: 0.6rem;
		background: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-6));
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
		min-height: 2.6em;
	}
	.g7__caption {
		margin-top: 0.75rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.g7__again {
		justify-self: start;
	}
	/* shared marks of the drawings */
	.g7__svg .ln {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.g7__svg .ln-dash {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.g7__svg .ink {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.g7__svg .arrow {
		fill: none;
		stroke-width: 3;
		stroke-linecap: round;
	}
	.g7__svg .arrow--blue {
		stroke: var(--g7-blue);
	}
	.g7__svg .arrow--red {
		stroke: var(--g7-red);
	}
	.g7__svg .arrow--gold {
		stroke: var(--g7-gold);
	}
	.g7__svg .arrow--green {
		stroke: var(--g7-green);
	}
	.g7__svg .head--blue {
		fill: var(--g7-blue);
	}
	.g7__svg .head--red {
		fill: var(--g7-red);
	}
	.g7__svg .head--gold {
		fill: var(--g7-gold);
	}
	.g7__svg .head--green {
		fill: var(--g7-green);
	}
	.g7__svg .head--ink {
		fill: var(--g7-ink);
	}
	@container (max-width: 36rem) {
		.g7__grid,
		.g7--wide .g7__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.g7--pic .g7__grid.is-three {
			grid-template-columns: minmax(0, 1fr);
			max-width: 20rem;
			margin-inline: auto;
		}
	}
	@container (max-width: 26rem) {
		.g7--pic .g7__grid.is-two {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 40rem) {
		.g7 {
			padding: 0.75rem;
		}
		.g7__svg text {
			font-size: 13px;
		}
		.g7__svg .t-small {
			font-size: 11.5px;
		}
	}
</style>
