---
/**
 * A compact wrapper for the chapter's data tables, so they fit a phone screen without scrolling. Numbers stay on one
 * line; `wrap` lets words wrap in every cell (a table of words, such as «форма / объём» of the three states);
 * `center` centres the column headings (all but the first).
 */
interface Props {
	wrap?: boolean;
	center?: boolean;
}
const { wrap = false, center = false } = Astro.props;
---

<div class:list={['vtab', wrap && 'vtab--wrap', center && 'vtab--center']}><slot /></div>

<style is:global>
	.vtab table {
		width: 100%;
		font-variant-numeric: tabular-nums;
	}
	.vtab th,
	.vtab td {
		white-space: nowrap;
	}
	.vtab td:last-child,
	.vtab th:last-child,
	.vtab--wrap th,
	.vtab--wrap td {
		white-space: normal;
	}
	.vtab--center th:not(:first-child) {
		text-align: center;
	}
	@media (max-width: 40rem) {
		.vtab {
			font-size: var(--sl-text-xs);
		}
		.vtab th,
		.vtab td {
			padding: 0.3rem 0.35rem;
		}
		.vtab .katex {
			font-size: 1em;
		}
	}
</style>
