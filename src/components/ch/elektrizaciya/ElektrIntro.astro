</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-elzintro]')) {
		// Door: the hand comes (→ 0,4), the spark at 0,4, jerks back; touches again calmly (0,62 → 0,86); 5 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="door"]')!;
			const hand = card.querySelector<SVGGElement>('[data-hand]')!;
			const spark = card.querySelector<SVGGElement>('[data-spark]')!;
			const click = card.querySelector<SVGTextElement>('[data-click]')!;
			const ouch = card.querySelector<SVGGElement>('[data-ouch]')!;
			const TIP = 195; // 3 mm before the lever
			scene(card, 5, (x) => {
				const out = 1 - (1 - clamp(x / 0.4)) ** 3; // slows down near the handle
				const back = smooth(0.405, 0.45, x);
				const again = smooth(0.62, 0.86, x);
				const hx = lerp(lerp(30, TIP, out), 150, back) + (198 - 150) * again;
				const hy = -8 * back * (1 - again);
				hand.setAttribute('transform', `translate(${f1(hx)} ${f1(hy)})`);
				const s = x >= 0.4 && x < 0.43 ? 1 - (x - 0.4) / 0.03 : 0;
				spark.style.opacity = s.toFixed(2);
				click.style.opacity = (smooth(0.4, 0.41, x) * (1 - smooth(0.56, 0.62, x))).toFixed(2);
				ouch.style.opacity = (smooth(0.41, 0.43, x) * (1 - smooth(0.56, 0.62, x))).toFixed(2);
			});
		}

		// Storm: the stepped leader (0,08 → 0,42), the return stroke at 0,42, two more strokes, fade by 0,8; 4 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="storm"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const main = $<SVGPolylineElement>('[data-main]');
			const up = $<SVGPolylineElement>('[data-up]');
			const brs = [0, 1, 2].map((i) => $<SVGPolylineElement>(`[data-br="${i}"]`));
			const channel = $<SVGPolylineElement>('[data-channel]');
			const glow = $<SVGPolylineElement>('[data-glow]');
			const leader = $<SVGGElement>('[data-leader]');
			const flash = $<SVGRectElement>('[data-flash]');
			const live = $<SVGPathElement>('[data-live]');
			// a fixed zigzag from the cloud (232, 58) to the meeting point above the rod tip (268, 128)
			let seed = 7;
			const rnd = () => {
				seed = (seed * 16807) % 2147483647;
				return seed / 2147483647;
			};
			const N = 12;
			const MEET = { x: 268, y: 121 };
			const pts: [number, number][] = [];
			for (let i = 0; i <= N; i++) {
				const t = i / N;
				const jit = i === 0 || i === N ? 0 : (rnd() - 0.5) * 16;
				pts.push([lerp(226, MEET.x, t) + jit, lerp(46, MEET.y, t) + (i === 0 || i === N ? 0 : (rnd() - 0.5) * 3)]);
			}
			const branch = (from: number, dir: number) => {
				const [x0, y0] = pts[from];
				const b: [number, number][] = [[x0, y0]];
				for (let k = 1; k <= 3; k++) b.push([x0 + dir * (7 * k + rnd() * 4), y0 + 6 * k + rnd() * 3]);
				return b;
			};
			const BR = [branch(2, -1), branch(5, 1), branch(8, -1)];
			const str = (p: [number, number][]) => p.map(([a, b]) => `${f1(a)},${f1(b)}`).join(' ');
			const upPts: [number, number][] = [[268, 128], [268, MEET.y]];
			channel.setAttribute('points', str([...pts, [268, 128]]));
			const twigs = [0, 1, 2].map((i) => $<SVGPolylineElement>(`[data-twig="${i}"]`));
			glow.setAttribute('points', str([...pts, [268, 128]]));
			const partial = (p: [number, number][], k: number) => {
				// k steps of the leader, in whole steps (a stepped leader)
				const n = Math.min(p.length - 1, Math.floor(k));
				return str(p.slice(0, n + 1));
			};
			// the brightness of the channel: three strokes along one path
			const STROKES = [0.42, 0.52, 0.6];
			const bright = (x: number) =>
				Math.max(0, ...STROKES.map((t0, i) => (x >= t0 ? Math.exp(-(x - t0) / (i === 0 ? 0.035 : 0.025)) : 0)));
			scene(card, 4, (x) => {
				const steps = N * clamp((x - 0.08) / 0.34);
				const growing = x < 0.42;
				leader.style.opacity = growing && x > 0.08 ? '1' : '0';
				main.setAttribute('points', partial(pts, steps));
				BR.forEach((b, i) => {
					const start = [2, 5, 8][i];
					brs[i].setAttribute('points', steps > start ? partial(b, 3 * clamp((steps - start) / 2.5)) : '');
				});
				up.setAttribute('points', x > 0.385 ? str(upPts) : '');
				const b = x >= 0.42 ? bright(x) : 0;
				const fade = 1 - smooth(0.66, 0.8, x);
				channel.style.opacity = (x >= 0.42 ? (0.25 + 0.75 * b) * fade : 0).toFixed(2);
				glow.style.opacity = (0.55 * b * fade).toFixed(2);
				flash.style.opacity = (0.32 * b).toFixed(2);
				live.style.opacity = (b * fade).toFixed(2);
				twigs.forEach((t, i) => {
					t.setAttribute('points', str(BR[i]));
					t.style.opacity = (x >= 0.42 ? 0.8 * b * fade : 0).toFixed(2);
				});
			});
		}
	}
</script>
