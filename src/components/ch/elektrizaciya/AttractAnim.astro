---
/**
 * «Почему притягиваются незаряженные тела»: a looping animation. A charged rod slowly comes down over a
 * small piece of paper (drawn strongly magnified, five of its molecules drawn as ovals with a «+» and a
 * «−»). The rod's field shifts the charges inside every molecule: the near side of the piece gets the
 * sign opposite to the rod's. The rod attracts the near side and repels the far side, which is farther
 * away and so is pushed less; the sum pulls the piece to the rod. When it exceeds the weight, the piece
 * jumps up. Model: the rod is a long line charge, field ∝ 1/r; the shift of the charges grows with the
 * field and saturates; forces F = C·p/r on the two sides; C is chosen so that the sum equals the weight
 * 95 px below the rod's axis. All arrows share one scale.
 */
const W = 440;
const H = 350;
const TABLE = 290;
const VY = 50; // the strip above is empty: the rod comes from there
const PAPER = { x: 90, y: 230, w: 210, h: 60 };
const uid = `att-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="att not-content" data-att>
	<div class="att__pairs" role="radiogroup" aria-label="Какую палочку подносим">
		<button type="button" class="att__pair is-on" role="radio" aria-checked="true" data-kind="ebonite">эбонит (−)</button>
		<button type="button" class="att__pair" role="radio" aria-checked="false" data-kind="glass">стекло (+)</button>
	</div>

	<svg
		class="att__svg"
		viewBox={`0 ${VY} ${W} ${H - VY}`}
		role="img"
		aria-label="Заряженная палочка опускается к кусочку бумаги. В молекулах бумаги заряды сдвигаются, бумажку притягивает к палочке, и она подскакивает."
		data-svg
	>
		<defs>
			<linearGradient id={`${uid}-glass`} x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" class="att__glass-hi"></stop>
				<stop offset="0.5" class="att__glass-mid"></stop>
				<stop offset="1" class="att__glass-lo"></stop>
			</linearGradient>
		</defs>
		<rect class="att__table" x="0" y={TABLE} width={W} height={H - TABLE}></rect>
		<line class="att__table-top" x1="0" y1={TABLE} x2={W} y2={TABLE}></line>
		<g data-scene>
			<g data-paper>
				<rect class="att__paper" x={PAPER.x} y={PAPER.y} width={PAPER.w} height={PAPER.h} rx="4"></rect>
				<g data-mols></g>
			</g>
			<g class="att__forces" data-forces>
				<g class="att__arrow att__arrow--el" data-f="near"><line></line><path></path></g>
				<g class="att__arrow att__arrow--rep" data-f="far"><line></line><path></path></g>
				<g class="att__arrow att__arrow--net" data-f="net"><line></line><path></path></g>
				<g class="att__arrow att__arrow--g" data-f="g"><line></line><path></path></g>
				<circle class="att__cm" r="3" data-cm></circle>
				<line class="att__tie" data-tie></line>
				<text class="att__flbl att__flbl--el" text-anchor="end" data-l="near">притяжение</text>
				<text class="att__flbl att__flbl--rep" text-anchor="end" data-l="far">отталкивание</text>
				<text class="att__flbl att__flbl--net" data-l="net">в сумме</text>
				<text class="att__flbl att__flbl--g" data-l="g">сила тяжести</text>
			</g>
			<g data-rod></g>
		</g>
	</svg>

	<div class="att__row">
		<div class="att__chips" aria-live="off">
			<span class="att__chip">заряд бумажки: <b>0</b></span>
			<span class="att__chip">притяжение в сумме: <b data-ratio>0</b></span>
		</div>
		<button type="button" class="att__btn" data-again>Повторить</button>
	</div>
	<p class="att__live" data-live aria-live="polite"></p>

	<figcaption class="att__legend">
		Бумажка и её молекулы нарисованы во много раз увеличенными. Бумага — диэлектрик: заряды не покидают своих молекул, а только
		чуть сдвигаются внутри них, поэтому бумажка в целом остаётся незаряженной. В металле не так: там свободные электроны
		переходят по всему телу. Все стрелки нарисованы в одном масштабе.
	</figcaption>
</figure>

<style is:global>
	.att {
		--att-p: var(--ig-vy);
		--att-n: var(--ig-vx);
		--att-ebonite: var(--sl-color-gray-5);
		--att-paper: var(--sl-color-gray-1);
		--att-f: var(--ig-v);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .att {
		--att-ebonite: var(--sl-color-gray-2);
		--att-paper: var(--sl-color-white);
	}
	.att__pairs {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
	}
	.att__pair {
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.35rem 0.95rem;
		border-radius: 999px;
		border: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.att__pair.is-on {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.att__svg {
		display: block;
		width: 100%;
		max-width: 36rem;
		height: auto;
		margin: 0.6rem auto 0;
	}
	.att__table {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.att__table-top {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.att__paper {
		fill: color-mix(in srgb, var(--att-paper) 14%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.att__mol {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 18%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 3 2.5;
	}
	.att .chg circle {
		stroke-width: 1;
