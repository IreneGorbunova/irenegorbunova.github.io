</style>

<script>
	import { animator, chargeSymbol, el, fmt } from './util';

	const PAPER = { x: 90, y: 230, w: 210, h: 60 };
	const TOP = PAPER.y;
	const BOT = PAPER.y + PAPER.h;
	const MID = (TOP + BOT) / 2;
	const MOL_X = [111, 153, 195, 237, 279];
	const MOL_TURN = [62, -48, 30, -75, 18]; // degrees from the field when the charges are not shifted
	const MR = 8; // charge glyph in a molecule
	const ROD_R = 15; // half the rod's thickness
	const RN_JUMP = 95; // the sum of the forces equals the weight when the near side is this far from the rod's axis
	const RN_MIN = 88; // the rod stops here (gap to the paper 73 px)
	const YC0 = 20; // the rod's axis at the start (just out of sight)
	const YC1 = TOP - RN_MIN;
	const FW = 22; // px: the weight's arrow; all forces share this scale
	const G_PX = 900; // px/s²: free-fall acceleration in the picture
	const X_PAIR = 195; // arrows of the two sides
	const X_SUM = 322; // arrows of the sum and of the weight
	const T_REST = 1;
	const T_DOWN = 6.5;
	const T_HOLD = 2.6; // after the piece reaches the rod
	const T_FADE = 0.6;

	type Kind = 'ebonite' | 'glass';
	const ease = (k: number) => k * k * (3 - 2 * k);
	const easeOut = (k: number) => 1 - (1 - k) ** 2.2;
	const clamp = (v: number) => Math.min(1, Math.max(0, v));

	// polarization p: grows with the field E ∝ 1/r (r to the middle of the piece) and saturates; 0 at the start
	const E = (yc: number) => 1 / (MID - yc);
	const E_JUMP = E(TOP - RN_JUMP);
	const f = (e: number) => 1 - Math.exp(-1.2 * e * e);
	const F0 = f(E(YC0) / E_JUMP);
	const pol = (yc: number) => clamp((f(E(yc) / E_JUMP) - F0) / (1 - F0));
	/** Forces in units of the weight: on the near side (attraction) and the far side (repulsion). */
	const forces = (yc: number, lift: number) => {
		const p = pol(yc + lift); // the field at the middle of the piece, which has risen by lift
		const rn = TOP - lift - yc;
		const rf = BOT - lift - yc;
		return { p, near: (C * p) / rn, far: (C * p) / rf };
	};
	const C = 1 / (pol(TOP - RN_JUMP) * (1 / RN_JUMP - 1 / (RN_JUMP + PAPER.h)));

		for (const root of document.querySelectorAll<HTMLElement>('[data-att]')) {
		const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
		const gScene = root.querySelector<SVGGElement>('[data-scene]')!;
		const gPaper = root.querySelector<SVGGElement>('[data-paper]')!;
		const gMols = root.querySelector<SVGGElement>('[data-mols]')!;
		const gForces = root.querySelector<SVGGElement>('[data-forces]')!;
		const gRod = root.querySelector<SVGGElement>('[data-rod]')!;
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const ratioEl = root.querySelector<HTMLElement>('[data-ratio]')!;
		const again = root.querySelector<HTMLButtonElement>('[data-again]')!;
		const kindBtns = root.querySelectorAll<HTMLButtonElement>('[data-kind]');
		const arrows = Object.fromEntries(
			[...root.querySelectorAll<SVGGElement>('[data-f]')].map((a) => [a.dataset.f!, a]),
		) as Record<'near' | 'far' | 'net' | 'g', SVGGElement>;
		const labels = Object.fromEntries(
			[...root.querySelectorAll<SVGTextElement>('[data-l]')].map((a) => [a.dataset.l!, a]),
		) as Record<'near' | 'far' | 'net' | 'g', SVGTextElement>;
		const cm = root.querySelector<SVGCircleElement>('[data-cm]')!;
		const tie = root.querySelector<SVGLineElement>('[data-tie]')!;

		const glassFill = svg.querySelector('linearGradient')!.id;

		let kind: Kind = 'ebonite';
		let t = 0;
		let lift = 0; // how far the piece has risen
		let v = 0;
		let state: 'table' | 'fly' | 'stuck' = 'table';
		let stuckAt = 0;
		let fAlpha = 1; // opacity of the force arrows
		let said = '';

		const mols = MOL_X.map(() => ({
			oval: el('ellipse', { class: 'att__mol' }, gMols),
			p: null as unknown as SVGGElement,
			n: null as unknown as SVGGElement,
		}));
		mols.forEach((m) => {
			m.n = chargeSymbol(-1, MR, gMols);
			m.p = chargeSymbol(1, MR, gMols);
		});

		const drawRod = () => {
			gRod.replaceChildren();
			const glass = kind === 'glass';
			el(
				'rect',
				{
					class: `att__rod-body att__rod-body--${kind}`,
					x: -40,
					y: -ROD_R,
					width: 440,
					height: 2 * ROD_R,
					rx: ROD_R,
					...(glass ? { fill: `url(#${glassFill})` } : {}),
				},
				gRod,
			);
			el('rect', { class: 'att__grip', x: -40, y: -ROD_R, width: 90, height: 2 * ROD_R, rx: ROD_R }, gRod);
			for (let k = 0; k < 9; k++) {
				const c = chargeSymbol(glass ? 1 : -1, 6.5, gRod);
				c.setAttribute('transform', `translate(${80 + k * 38} 0)`);
			}
			const lbl = el('text', { class: 'att__lbl', x: 10, y: -ROD_R - 8 }, gRod);
			lbl.textContent = glass ? 'стекло' : 'эбонит';
		};

		const rodY = (t: number) => {
			if (t < T_REST) return YC0;
			return YC0 + (YC1 - YC0) * easeOut(clamp((t - T_REST) / T_DOWN));
		};

		/** A vertical arrow from (x, y0), len < 0 points up; the head is 9 px long. */
		const arrow = (a: SVGGElement, x: number, y0: number, len: number, lbl: SVGTextElement, lx: number, ly: number) => {
			const show = Math.abs(len) > 6;
			a.style.display = show ? '' : 'none';
			lbl.style.display = show ? '' : 'none';
			if (!show) return;
			const s = Math.sign(len);
			const y1 = y0 + len;
			const line = a.firstElementChild!;
			line.setAttribute('x1', String(x));
			line.setAttribute('x2', String(x));
			line.setAttribute('y1', y0.toFixed(1));
			line.setAttribute('y2', (y1 - s * 7).toFixed(1));
			a.lastElementChild!.setAttribute('d', `M ${x - 6} ${(y1 - s * 10).toFixed(1)} L ${x} ${y1.toFixed(1)} L ${x + 6} ${(y1 - s * 10).toFixed(1)} Z`);
			lbl.setAttribute('x', String(lx));
			lbl.setAttribute('y', ly.toFixed(1));
		};

		const texts = {
			ebonite: {
				rest: 'Бумажка не заряжена: в каждой её молекуле положительный и отрицательный заряды равны.',
				shift: 'Подносим отрицательно заряженную палочку. В каждой молекуле бумаги заряды чуть сдвигаются: «+» — ближе к палочке, «−» — дальше. Из молекул они не уходят.',
				pull: 'Ближнюю сторону бумажки палочка притягивает, дальнюю — отталкивает, но слабее: дальняя сторона дальше от палочки. В сумме бумажку тянет вверх, к палочке.',
				jump: 'Притяжение стало больше силы тяжести — и бумажка подскочила к палочке, хотя сама она не заряжена.',
			},
			glass: {
				rest: 'Бумажка не заряжена: в каждой её молекуле положительный и отрицательный заряды равны.',
				shift: 'Подносим положительно заряженную палочку. Теперь заряды в молекулах сдвигаются наоборот: «−» — ближе к палочке, «+» — дальше.',
				pull: 'Ближняя сторона опять заряжена противоположно палочке и притягивается сильнее, чем отталкивается дальняя. В сумме бумажку снова тянет к палочке.',
				jump: 'Притяжение стало больше силы тяжести — бумажка подскочила к палочке. Палочка с зарядом любого знака притягивает незаряженные тела.',
			},
		};
		const say = (key: 'rest' | 'shift' | 'pull' | 'jump') => {
			if (said === key) return;
			said = key;
			live.textContent = texts[kind][key];
		};

		const frame = (dt: number) => {
			t += dt;
			const yc = rodY(t);
			// the piece: stays while the pull is weaker than its weight, then flies up and sticks to the rod
			const F = forces(yc, lift);
			const sum = F.near - F.far;
			if (state === 'table' && sum > 1) state = 'fly';
			if (state === 'fly') {
				v += G_PX * (sum - 1) * dt;
				lift += v * dt;
				if (TOP - lift <= yc + ROD_R) {
					state = 'stuck';
					stuckAt = t;
				}
			}
			if (state === 'stuck') lift = TOP - yc - ROD_R;
			gRod.setAttribute('transform', `translate(0 ${yc.toFixed(1)})`);
			gPaper.setAttribute('transform', `translate(0 ${(-lift).toFixed(1)})`);

			// molecules: the «+» of each turns and shifts along the field (up to a negative rod, down from a positive one)
			const up = kind === 'ebonite' ? -Math.PI / 2 : Math.PI / 2;
			const p = F.p;
			const half = MR * (0.85 + 0.5 * p);
			mols.forEach((m, k) => {
				const a = up + (1 - p) * ((MOL_TURN[k] * Math.PI) / 180);
				const ux = Math.cos(a) * half;
				const uy = Math.sin(a) * half;
				const x = MOL_X[k];
				m.p.setAttribute('transform', `translate(${(x + ux).toFixed(2)} ${(MID + uy).toFixed(2)})`);
				m.n.setAttribute('transform', `translate(${(x - ux).toFixed(2)} ${(MID - uy).toFixed(2)})`);
				m.oval.setAttribute('rx', (half + MR + 3).toFixed(2));
				m.oval.setAttribute('ry', (MR + 4).toFixed(2));
				m.oval.setAttribute('transform', `translate(${x} ${MID}) rotate(${((a * 180) / Math.PI).toFixed(1)})`);
			});

			// force arrows (one scale: the weight is FW px); they fade once the piece leaves the table
			fAlpha = state === 'table' ? 1 : Math.max(0, fAlpha - dt / 0.3);
			gForces.setAttribute('opacity', fAlpha.toFixed(2));
			if (fAlpha > 0) {
				const top = TOP - lift;
				const bot = BOT - lift;
				const lN = FW * F.near;
				const lF = FW * F.far;
				const lS = FW * Math.max(0, sum);
				arrow(arrows.near, X_PAIR, top, -lN, labels.near, X_PAIR - 9, top - lN / 2 + 5);
				arrow(arrows.far, X_PAIR, bot, lF, labels.far, X_PAIR - 9, bot + Math.max(lF / 2, 14) + 5);
				arrow(arrows.net, X_SUM, MID - lift, -lS, labels.net, X_SUM + 9, MID - lift - Math.max(lS / 2, 10) + 5);
				arrow(arrows.g, X_SUM, MID - lift, FW, labels.g, X_SUM + 9, MID - lift + FW / 2 + 9);
				cm.setAttribute('cx', String(X_SUM));
				cm.setAttribute('cy', (MID - lift).toFixed(1));
				tie.setAttribute('x1', String(PAPER.x + PAPER.w));
				tie.setAttribute('x2', String(X_SUM - 4));
				tie.setAttribute('y1', (MID - lift).toFixed(1));
				tie.setAttribute('y2', (MID - lift).toFixed(1));
			}
			ratioEl.textContent = state === 'table' ? `${fmt(Math.max(0, sum), 1)} силы тяжести` : 'больше силы тяжести';

			if (state !== 'table') say('jump');
			else if (sum > 0.35) say('pull');
			else if (p > 0.05) say('shift');
			else say('rest');

			// after a pause at the rod: fade out and start again
			if (state === 'stuck') {
				const k = (t - stuckAt - T_HOLD) / T_FADE;
				gScene.setAttribute('opacity', (1 - clamp(k)).toFixed(2));
				if (k >= 1) start();
			} else if (t < T_FADE * 0.6) gScene.setAttribute('opacity', clamp(t / (T_FADE * 0.6)).toFixed(2));
			else gScene.setAttribute('opacity', '1');
		};
		const wake = animator(root, () => true, frame);

		function start() {
			t = 0;
			lift = 0;
			v = 0;
			state = 'table';
			fAlpha = 1;
			said = '';
		}
		const restart = () => {
			start();
			drawRod();
			frame(0);
			wake();
		};
		again.addEventListener('click', restart);
		kindBtns.forEach((b) =>
			b.addEventListener('click', () => {
				kind = b.dataset.kind as Kind;
				kindBtns.forEach((o) => {
					o.classList.toggle('is-on', o === b);
					o.setAttribute('aria-checked', String(o === b));
				});
				restart();
			}),
		);
		restart();
	}
</script>
