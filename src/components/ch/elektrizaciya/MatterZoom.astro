---
/**
 * «От вещества до ядра»: four linked pictures, each a magnified bit of the previous one, joined by
 * magnifier lines: water in a glass → water molecules (liquid: packed, jiggling) → one H₂O molecule
 * (bond angle 104,5°) → an oxygen atom (8 protons, 8 neutrons; electrons 2 near + 6 farther, the
 * school shell picture). The static scheme reads on its own; «Ближе» / «Дальше» walk through it:
 * each next picture flies out of the marked spot of the previous one. The last picture is not to
 * scale (the nucleus, about 5·10⁻¹⁵ m, is tens of thousands of times smaller than the atom).
 */
const uid = `mz-${Math.random().toString(36).slice(2, 8)}`;

// deterministic pseudo-random numbers, so every build draws the same liquid
let seed = 20261111;
const rnd = () => {
	seed = (seed + 0x6d2b79f5) | 0;
	let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
	t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
	return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const HALF = ((104.5 / 2) * Math.PI) / 180; // half of the H–O–H angle
const hPos = (d: number) => [
	{ x: -d * Math.sin(HALF), y: d * Math.cos(HALF) },
	{ x: d * Math.sin(HALF), y: d * Math.cos(HALF) },
];

// panel 2: liquid water, a jittered hexagonal packing of molecules (spacing ≈ one molecule)
const SM = { o: 9, h: 5.6, d: 10.5 };
const smallH = hPos(SM.d);
const MARK2 = { x: 134, y: 134 };
const mols: { x: number; y: number; a: number; k: number }[] = [];
for (let j = -4; j <= 4; j++) {
	for (let i = -4; i <= 4; i++) {
		const x = 100 + i * 36 + (j % 2 ? 18 : 0) + (rnd() - 0.5) * 7;
		const y = 100 + j * 31.5 + (rnd() - 0.5) * 7;
		const a = rnd() * 360;
		if (Math.hypot(x - 100, y - 100) < 106) mols.push({ x, y, a, k: 1 });
	}
}
let mi = 0;
mols.forEach((m, i) => {
	if (Math.hypot(m.x - MARK2.x, m.y - MARK2.y) < Math.hypot(mols[mi].x - MARK2.x, mols[mi].y - MARK2.y)) mi = i;
});
Object.assign(mols[mi], { x: MARK2.x, y: MARK2.y, a: 0, k: 0.25 }); // the marked one: upright, as in panel 3

// panel 3: one molecule
const BIG = { ox: 100, oy: 84, o: 34, h: 23, d: 52 };
const bigH = hPos(BIG.d).map((p) => ({ x: BIG.ox + p.x, y: BIG.oy + p.y }));
const bigHl = hPos(BIG.d + 6).map((p) => ({ x: BIG.ox + p.x, y: BIG.oy + p.y }));

// panel 4: oxygen atom, nucleus as a sunflower packing (protons and neutrons mixed evenly)
const NR = 6.3;
const nucleons: { x: number; y: number; p: boolean }[] = [];
let pp = 0;
for (let k = 0; k < 16; k++) {
	const wantP = Math.round(((k + 1) * 8) / 16);
	const p = wantP > pp;
	if (p) pp += 1;
	const r = k === 0 ? 0 : NR * 1.05 * Math.sqrt(k + 0.4);
	const a = k * 2.39996;
	nucleons.push({ x: 100 + r * Math.cos(a), y: 100 + r * Math.sin(a), p });
}
nucleons.reverse();
const ORB = [46, 79];
const electrons = [
	...[0, 1].map((k) => ({ r: ORB[0], a0: 90 + k * 180, w: 0.9 })),
	...[0, 1, 2, 3, 4, 5].map((k) => ({ r: ORB[1], a0: 15 + k * 60, w: 0.45 })),
];
const ePos = (e: { r: number; a0: number }) => ({
	x: 100 + e.r * Math.cos((e.a0 * Math.PI) / 180),
	y: 100 + e.r * Math.sin((e.a0 * Math.PI) / 180),
});

const caps = [
	{ t: 'Вода', s: 'кажется сплошной', z: 'стакан ≈ 10 см' },
	{ t: 'Молекулы воды', s: 'стоят вплотную и всё время движутся', z: 'каждая ≈ 0,3 нм' },
	{ t: 'Молекула воды H₂O', s: 'атом кислорода и два атома водорода', z: '≈ 0,3 нм = 3·10⁻¹⁰ м' },
	{ t: 'Атом кислорода', s: 'ядро и 8 электронов вокруг', z: 'атом ≈ 10⁻¹⁰ м' },
];
---

<figure class="mz not-content" data-mz>
	<div class="mz__panels" data-panels>
		<!-- panel 1: water in a glass -->
		<div class="mz__panel" data-panel="0">
			<div class="mz__pic" data-pic>
				<svg viewBox="0 0 200 200" role="img" aria-label="Стакан с водой">
					<ellipse class="mz__shadow" cx="100" cy="186" rx="46" ry="5"></ellipse>
					<path class="mz__water" d="M 54.1 62 L 145.9 62 L 138.6 172 L 61.4 172 Z"></path>
					<ellipse class="mz__surface" cx="100" cy="62" rx="45.9" ry="5"></ellipse>
					<path class="mz__glass" d="M 52 28 L 62 176 Q 62.5 182 68 182 L 132 182 Q 137.5 182 138 176 L 148 28"></path>
					<path class="mz__glass-bottom" d="M 61.6 172 L 138.4 172"></path>
					<ellipse class="mz__rim-top" cx="100" cy="28" rx="48" ry="5"></ellipse>
					<path class="mz__shine" d="M 61 44 L 68 150"></path>
					<circle class="mz__marker" data-marker cx="116" cy="140" r="12"></circle>
				</svg>
			</div>
			<div class="mz__cap"><b>{caps[0].t}</b><span>{caps[0].s}</span><span class="mz__size">{caps[0].z}</span></div>
		</div>

		<!-- panel 2: many molecules -->
		<div class="mz__panel" data-panel="1">
			<div class="mz__pic" data-pic>
				<svg viewBox="0 0 200 200" role="img" aria-label="Молекулы воды, сильно увеличенные">
					<defs>
						<clipPath id={`${uid}-c1`}><circle cx="100" cy="100" r="94"></circle></clipPath>
					</defs>
					<circle class="mz__lens mz__lens--water" cx="100" cy="100" r="94"></circle>
					<g clip-path={`url(#${uid}-c1)`}>
						{
							mols.map((m) => (
								<g
									class="mz__mol"
									data-mol
									data-x={m.x.toFixed(1)}
									data-y={m.y.toFixed(1)}
									data-a={m.a.toFixed(0)}
									data-k={m.k}
									transform={`translate(${m.x.toFixed(1)} ${m.y.toFixed(1)}) rotate(${m.a.toFixed(0)})`}
								>
									{smallH.map((h) => (
										<circle class="mz__h" cx={h.x.toFixed(2)} cy={h.y.toFixed(2)} r={SM.h} />
									))}
									<circle class="mz__o" r={SM.o} />
									<circle class="mz__gloss" cx="-3" cy="-3.2" r="2.6" />
								</g>
							))
						}
					</g>
					<circle class="mz__rim" data-lens cx="100" cy="100" r="94"></circle>
					<circle class="mz__marker" data-marker cx={MARK2.x} cy={MARK2.y} r="18"></circle>
				</svg>
			</div>
			<div class="mz__cap"><b>{caps[1].t}</b><span>{caps[1].s}</span><span class="mz__size">{caps[1].z}</span></div>
		</div>

		<!-- panel 3: one molecule -->
		<div class="mz__panel" data-panel="2">
			<div class="mz__pic" data-pic>
				<svg viewBox="0 0 200 200" role="img" aria-label="Молекула воды: атом кислорода и два атома водорода">
					<circle class="mz__lens mz__lens--water" cx="100" cy="100" r="94"></circle>
					{bigH.map((h) => <circle class="mz__h" cx={h.x.toFixed(2)} cy={h.y.toFixed(2)} r={BIG.h} />)}
					<circle class="mz__o" cx={BIG.ox} cy={BIG.oy} r={BIG.o}></circle>
					<ellipse class="mz__gloss" cx={BIG.ox - 11} cy={BIG.oy - 13} rx="9" ry="7"></ellipse>
					{bigH.map((h) => <ellipse class="mz__gloss" cx={(h.x - 6).toFixed(1)} cy={(h.y - 8).toFixed(1)} rx="5" ry="4" />)}
					<text class="mz__sym mz__sym--o" x={BIG.ox} y={BIG.oy + 8} text-anchor="middle">O</text>
					{
						bigHl.map((h) => (
							<text class="mz__sym mz__sym--h" x={h.x.toFixed(1)} y={(h.y + 6).toFixed(1)} text-anchor="middle">
								H
							</text>
						))
					}
					<text class="mz__lbl" x="100" y="33" text-anchor="middle">атом кислорода</text>
					<path class="mz__lead" d={`M 84 152 L ${(bigH[0].x + 6).toFixed(1)} ${(bigH[0].y + 20).toFixed(1)}`}></path>
					<path class="mz__lead" d={`M 116 152 L ${(bigH[1].x - 6).toFixed(1)} ${(bigH[1].y + 20).toFixed(1)}`}></path>
					<text class="mz__lbl" x="100" y="169" text-anchor="middle">атомы водорода</text>
					<circle class="mz__rim" data-lens cx="100" cy="100" r="94"></circle>
					<circle class="mz__marker" data-marker cx={BIG.ox} cy={BIG.oy} r={BIG.o + 4}></circle>
				</svg>
			</div>
			<div class="mz__cap"><b>{caps[2].t}</b><span>{caps[2].s}</span><span class="mz__size">{caps[2].z}</span></div>
		</div>

		<!-- panel 4: the oxygen atom -->
		<div class="mz__panel" data-panel="3">
			<div class="mz__pic" data-pic>
				<svg viewBox="0 0 200 200" role="img" aria-label="Атом кислорода: ядро из 8 протонов и 8 нейтронов и 8 электронов вокруг">
					<circle class="mz__lens" cx="100" cy="100" r="94"></circle>
					{ORB.map((r) => <circle class="mz__orbit" cx="100" cy="100" r={r} />)}
					{
						nucleons.map((n) => (
							<g transform={`translate(${n.x.toFixed(2)} ${n.y.toFixed(2)})`}>
								<circle class={n.p ? 'mz__p' : 'mz__n'} r={NR} />
								{n.p && <path class="mz__pmark" d="M -3.1 0 H 3.1 M 0 -3.1 V 3.1" />}
							</g>
						))
					}
					{
						electrons.map((e) => {
							const p = ePos(e);
							return (
								<g data-e data-r={e.r} data-a0={e.a0} data-w={e.w} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
									<circle class="mz__e" r="7.2" />
									<path class="mz__emark" d="M -3.6 0 H 3.6" />
								</g>
							);
						})
					}
					<circle class="mz__rim" data-lens cx="100" cy="100" r="94"></circle>
				</svg>
			</div>
			<div class="mz__cap"><b>{caps[3].t}</b><span>{caps[3].s}</span><span class="mz__size">{caps[3].z}</span></div>
		</div>
		<svg class="mz__lines" data-lines aria-hidden="true"></svg>
	</div>

	<div class="mz__controls">
		<button type="button" class="mz__btn" data-in>
			<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"></circle><path d="M 13 13 L 18 18 M 5.5 8.5 H 11.5 M 8.5 5.5 V 11.5"></path></svg>
			Ближе
		</button>
		<button type="button" class="mz__btn" data-out>
			<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6"></circle><path d="M 13 13 L 18 18 M 5.5 8.5 H 11.5"></path></svg>
			Дальше
		</button>
		<span class="mz__steps" data-steps aria-hidden="true"><i></i><i></i><i></i><i></i></span>
	</div>
	<p class="mz__live" data-live aria-live="polite"></p>

	<figcaption class="mz__legend">
		<span class="mz__dot mz__dot--o"></span> атом кислорода, <span class="mz__dot mz__dot--h"></span> атом водорода,{' '}
		<span class="mz__dot mz__dot--p">+</span> протон, <span class="mz__dot mz__dot--n"></span> нейтрон,{' '}
		<span class="mz__dot mz__dot--e">−</span> электрон. Последний рисунок не в масштабе: ядро в десятки тысяч раз
		меньше атома (у кислорода около 5·10<sup>−15</sup>&nbsp;м). Нарисованное в масштабе, оно было бы намного меньше
		одной точки экрана. И электроны не бегают по кругам: круги лишь показывают, что два электрона ближе к ядру, а
		шесть — дальше.
	</figcaption>
</figure>

<style is:global>
	.mz {
		--mz-o: var(--ig-v);
		--mz-h: var(--sl-color-gray-2);
		--mz-h-ink: var(--sl-color-black);
		--mz-p: var(--ig-vy);
		--mz-n: var(--sl-color-gray-3);
		--mz-e: var(--ig-vx);
		--mz-line: var(--sl-color-gray-2);
		container-type: inline-size;
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .mz {
		--mz-h: color-mix(in srgb, var(--sl-color-gray-5) 75%, var(--sl-color-gray-4));
		--mz-h-ink: var(--sl-color-white);
		--mz-n: var(--sl-color-gray-4);
		--mz-line: var(--sl-color-gray-3);
	}
	.mz__panels {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.6rem;
	}
	.mz__panel {
		display: grid;
		align-content: start;
		gap: 0.5rem;
	}
	.mz__pic {
		position: relative;
		z-index: 1;
		transform-origin: 50% 50%;
		transition: opacity 0.4s ease;
	}
	.mz__pic > svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		transition: filter 0.4s ease;
	}
	.mz__panel.is-active .mz__pic > svg {
		filter: drop-shadow(0 0 7px color-mix(in srgb, var(--sl-color-accent) 70%, transparent));
	}
	.mz__panel.is-off .mz__pic,
	.mz__panel.is-off .mz__cap {
		opacity: 0;
		pointer-events: none;
	}
	.mz__cap {
		display: grid;
		gap: 0.1rem;
		text-align: center;
		font-size: var(--sl-text-xs);
		line-height: 1.35;
		color: var(--sl-color-gray-3);
		transition: opacity 0.5s ease 0.25s;
	}
	.mz__cap b {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		transition: color 0.3s ease;
	}
	.mz__panel.is-active .mz__cap b {
		color: var(--sl-color-accent);
	}
	.mz__size {
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.mz__lines {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
		overflow: visible;
		pointer-events: none;
	}
	.mz__zl {
		stroke: var(--mz-line);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
		opacity: 0.75;
		transition: opacity 0.35s ease;
	}
	.mz__zl--in {
		opacity: 0.3;
	}
	.mz__zl.is-hidden {
		opacity: 0;
	}
	/* picture parts */
	.mz__lens {
		fill: var(--sl-color-gray-6);
	}
	.mz__lens--water {
		fill: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-6));
	}
	.mz__rim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.mz__marker {
		fill: color-mix(in srgb, var(--mz-line) 8%, transparent);
		stroke: var(--mz-line);
		stroke-width: 2;
		stroke-dasharray: 5 3;
	}
	.mz__panel.is-hint .mz__marker {
		animation: mz-pulse 1.6s ease-in-out infinite;
	}
	@keyframes mz-pulse {
		50% {
			stroke: var(--sl-color-accent);
			stroke-width: 3.2;
		}
	}
	.mz__water {
		fill: color-mix(in srgb, var(--ig-vx) 32%, var(--ig-surface));
	}
	.mz__surface {
		fill: color-mix(in srgb, var(--ig-vx) 50%, var(--ig-surface));
	}
	.mz__glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.mz__glass-bottom {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.mz__rim-top {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.mz__shine {
		stroke: color-mix(in srgb, var(--sl-color-white) 40%, transparent);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.mz__shadow {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 45%, transparent);
	}
	.mz__o {
		fill: var(--mz-o);
	}
	.mz__h {
		fill: var(--mz-h);
		stroke: color-mix(in srgb, var(--mz-h) 55%, var(--sl-color-gray-4));
		stroke-width: 1;
	}
	.mz__gloss {
		fill: color-mix(in srgb, white 38%, transparent);
	}
	.mz__sym {
		font-family: var(--__sl-font);
		font-weight: 700;
	}
	.mz__sym--o {
		font-size: 22px;
		fill: var(--sl-color-black);
	}
	.mz__sym--h {
		font-size: 17px;
		fill: var(--mz-h-ink);
	}
	.mz__lbl {
		font-family: var(--__sl-font);
		font-size: 14px;
		fill: var(--sl-color-white);
	}
	.mz__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.mz__orbit {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.3;
		stroke-dasharray: 4 5;
	}
	.mz__p {
		fill: var(--mz-p);
		stroke: var(--sl-color-gray-6);
		stroke-width: 1;
	}
	.mz__n {
		fill: var(--mz-n);
		stroke: var(--sl-color-gray-6);
		stroke-width: 1;
	}
	.mz__pmark,
	.mz__emark {
		stroke: var(--sl-color-black);
		stroke-width: 1.7;
		stroke-linecap: round;
	}
	.mz__e {
		fill: var(--mz-e);
		filter: drop-shadow(0 0 3px color-mix(in srgb, var(--mz-e) 70%, transparent));
	}
	/* controls and text */
	.mz__controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.mz__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 1.05rem 0.45rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.mz__btn:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.mz__btn:disabled {
		opacity: 0.4;
		cursor: default;
	}
	.mz__btn[data-in] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.mz__btn svg {
		width: 1.05rem;
		height: 1.05rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}
	.mz__steps {
		display: inline-flex;
		gap: 0.35rem;
		margin-left: auto;
	}
	.mz__steps i {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--sl-color-gray-5);
		transition: background 0.3s ease;
	}
	.mz__steps i.is-on {
		background: var(--sl-color-accent);
	}
	.mz__live {
		min-height: 4.5em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.mz__live b {
		color: var(--sl-color-white);
	}
	.mz__legend {
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.mz__dot {
		display: inline-grid;
		place-items: center;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		vertical-align: -0.12rem;
		font-weight: 700;
		line-height: 1;
		color: var(--sl-color-black);
	}
	.mz__dot--o {
		background: var(--mz-o);
	}
	.mz__dot--h {
		background: var(--mz-h);
	}
	.mz__dot--p {
		background: var(--mz-p);
	}
	.mz__dot--n {
		background: var(--mz-n);
	}
	.mz__dot--e {
		background: var(--mz-e);
	}
	/* a normal page column: a 2 × 2 «snake» (1 → 2 to the right, 2 → 3 down, 3 → 4 to the left); captions stay outside the cones */
	@container (max-width: 46rem) {
		.mz__panels {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-areas: 'c0 c1' 'p0 p1' 'p3 p2' 'c3 c2';
			gap: 0.35rem 1.3rem;
		}
		.mz__panel {
			display: contents;
		}
		.mz__pic {
			width: min(100%, 15rem);
			justify-self: center;
		}
		.mz__panel[data-panel='0'] .mz__pic {
			grid-area: p0;
		}
		.mz__panel[data-panel='1'] .mz__pic {
			grid-area: p1;
		}
		.mz__panel[data-panel='2'] .mz__pic {
			grid-area: p2;
			margin-top: 1.3rem;
		}
		.mz__panel[data-panel='3'] .mz__pic {
			grid-area: p3;
			margin-top: 1.3rem;
		}
		.mz__panel[data-panel='0'] .mz__cap {
			grid-area: c0;
			align-self: end;
		}
		.mz__panel[data-panel='1'] .mz__cap {
			grid-area: c1;
			align-self: end;
		}
		.mz__panel[data-panel='2'] .mz__cap {
			grid-area: c2;
		}
		.mz__panel[data-panel='3'] .mz__cap {
			grid-area: c3;
		}
	}
	@media (max-width: 40rem) {
		.mz {
			padding: 0.75rem;
		}
	}
</style>

<script>
	import { animator } from './util';

	const TEXT = [
		'Вода в стакане кажется сплошной: никаких частиц и промежутков не видно даже в микроскоп.',
		'Если бы стакан воды увеличили в сто миллионов раз, он стал бы почти с Землю, а каждая <b>молекула</b> — размером с грецкий орех. Молекулы воды стоят почти вплотную и всё время беспорядочно движутся.',
		'Одна молекула воды H₂O: <b>атом кислорода</b> (O) и два <b>атома водорода</b> (H), соединённые под углом около 104,5°. Размер молекулы — около 0,3 нм = 3·10⁻¹⁰ м.',
		'Атом кислорода. В центре — <b>ядро</b>: 8 протонов (заряд «+») и 8 нейтронов (без заряда). Вокруг движутся 8 <b>электронов</b> (заряд «−»). Протонов и электронов поровну, поэтому атом в целом не заряжен.',
	];
	const START =
		'Каждый следующий рисунок — сильно увеличенная часть предыдущего (она обведена). Нажимайте «Ближе» и пройдите путь от стакана воды до атома.';
	const SVG_NS = 'http://www.w3.org/2000/svg';

	/** The two outer tangents of circles (x1, y1, r1) and (x2, y2, r2): the edges of a magnifier cone. */
	const tangents = (a: { x: number; y: number; r: number }, b: { x: number; y: number; r: number }) => {
		const dx = b.x - a.x;
		const dy = b.y - a.y;
		const d = Math.hypot(dx, dy);
		if (d <= Math.abs(a.r - b.r) + 1) return null;
		const ux = dx / d;
		const uy = dy / d;
		const c = (a.r - b.r) / d;
		const s = Math.sqrt(1 - c * c);
		return [1, -1].map((k) => {
			const nx = ux * c - k * uy * s;
			const ny = uy * c + k * ux * s;
			return [a.x + a.r * nx, a.y + a.r * ny, b.x + b.r * nx, b.y + b.r * ny];
		});
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-mz]')) {
		const box = root.querySelector<HTMLElement>('[data-panels]')!;
		const linesSvg = root.querySelector<SVGSVGElement>('[data-lines]')!;
		const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
		const pics = panels.map((p) => p.querySelector<HTMLElement>('[data-pic]')!);
		const markers = panels.map((p) => p.querySelector<SVGCircleElement>('[data-marker]'));
		const lenses = panels.map((p) => p.querySelector<SVGCircleElement>('[data-lens]'));
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const bIn = root.querySelector<HTMLButtonElement>('[data-in]')!;
		const bOut = root.querySelector<HTMLButtonElement>('[data-out]')!;
		const dots = [...root.querySelectorAll<HTMLElement>('[data-steps] i')];

		// magnifier lines: pair j joins the marker in picture j with the lens of picture j + 1
		const pairs = [0, 1, 2].map(() =>
			[0, 1].map(() =>
				['mz__zl mz__zl--in', 'mz__zl'].map((cls) => {
					const l = document.createElementNS(SVG_NS, 'line');
					l.setAttribute('class', cls);
					linesSvg.appendChild(l);
					return l;
				}),
			),
		);
		const circ = (c: Element, base: DOMRect, pad = 0) => {
			const r = c.getBoundingClientRect();
			return { x: r.left + r.width / 2 - base.left, y: r.top + r.height / 2 - base.top, r: r.width / 2 + pad };
		};
		const put = (l: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
			l.setAttribute('x1', x1.toFixed(1));
			l.setAttribute('y1', y1.toFixed(1));
			l.setAttribute('x2', x2.toFixed(1));
			l.setAttribute('y2', y2.toFixed(1));
		};
		const drawLines = () => {
			const base = box.getBoundingClientRect();
			linesSvg.setAttribute('viewBox', `0 0 ${base.width} ${base.height}`);
			pairs.forEach((pair, j) => {
				const a = circ(markers[j]!, base, 1);
				const b = circ(lenses[j + 1]!, base, 1.5);
				const src = lenses[j] ? circ(lenses[j]!, base, 1.5) : null;
				const t = tangents(a, b);
				const off = panels[j + 1].classList.contains('is-off');
				pair.forEach(([lin, lout], k) => {
					if (!t) {
						lin.classList.add('is-hidden');
						lout.classList.add('is-hidden');
						return;
					}
					const [x1, y1, x2, y2] = t[k];
					// inside the source picture the line is faint, so it does not hide the labels
					let u = 0;
					if (src) {
						const dx = x2 - x1;
						const dy = y2 - y1;
						const fx = x1 - src.x;
						const fy = y1 - src.y;
						const A = dx * dx + dy * dy;
						const B = 2 * (fx * dx + fy * dy);
						const C = fx * fx + fy * fy - src.r * src.r;
						const disc = B * B - 4 * A * C;
						if (C < 0 && disc > 0) u = Math.min(1, (-B + Math.sqrt(disc)) / (2 * A));
					}
					const xm = x1 + (x2 - x1) * u;
					const ym = y1 + (y2 - y1) * u;
					put(lin, x1, y1, xm, ym);
					put(lout, xm, ym, x2, y2);
					lin.classList.toggle('is-hidden', off || u === 0);
					lout.classList.toggle('is-hidden', off);
				});
			});
		};
		let trackUntil = 0;
		let trackRaf = 0;
		const track = (ms: number) => {
			trackUntil = Math.max(trackUntil, performance.now() + ms);
			if (trackRaf) return;
			const loop = (now: number) => {
				drawLines();
				trackRaf = now < trackUntil ? requestAnimationFrame(loop) : 0;
			};
			trackRaf = requestAnimationFrame(loop);
		};
		new ResizeObserver(() => drawLines()).observe(box);
		document.fonts?.ready.then(drawLines);

		// step-by-step zoom: f = -1 is the whole scheme, 0…3 the current picture
		let f = -1;
		const timers: number[] = [];
		const toMarker = (j: number) => {
			// the transform that shrinks picture j onto the marker of picture j - 1
			const pic = pics[j];
			pic.style.transition = 'none';
			pic.style.transform = '';
			const t = pic.getBoundingClientRect();
			const m = markers[j - 1]!.getBoundingClientRect();
			const s = m.width / 2 / (t.width * 0.47);
			const dx = m.left + m.width / 2 - (t.left + t.width / 2);
			const dy = m.top + m.height / 2 - (t.top + t.height / 2);
			return `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) scale(${s.toFixed(4)})`;
		};
		const flyIn = (j: number) => {
			clearTimeout(timers[j]);
			const pic = pics[j];
			const tr = toMarker(j);
			panels[j].classList.remove('is-off');
			pic.style.transform = tr;
			pic.style.opacity = '0';
			void pic.offsetWidth;
			pic.style.transition = 'transform 0.95s cubic-bezier(0.3, 0.75, 0.25, 1), opacity 0.4s ease';
			pic.style.transform = '';
			pic.style.opacity = '';
			track(1100);
		};
		const flyOut = (j: number) => {
			clearTimeout(timers[j]);
			const pic = pics[j];
			const tr = toMarker(j);
			void pic.offsetWidth;
			pic.style.transition = 'transform 0.75s cubic-bezier(0.6, 0, 0.8, 0.4), opacity 0.6s ease 0.15s';
			pic.style.transform = tr;
			pic.style.opacity = '0';
			track(850);
			timers[j] = window.setTimeout(() => {
				panels[j].classList.add('is-off');
				pic.style.transition = 'none';
				pic.style.transform = '';
				pic.style.opacity = '';
				drawLines();
			}, 780);
		};
		const show = () => {
			panels.forEach((p, j) => {
				p.classList.toggle('is-active', j === f);
				p.classList.toggle('is-hint', f >= 0 && f < 3 && j === f);
			});
			dots.forEach((d, j) => d.classList.toggle('is-on', f >= 0 && j <= f));
			bIn.disabled = f === 3;
			bOut.disabled = f === 0;
			live.innerHTML = f < 0 ? START : TEXT[f];
			drawLines();
		};
		bIn.addEventListener('click', () => {
			if (f < 0) {
				f = 0;
				for (let j = 1; j < 4; j++) {
					clearTimeout(timers[j]);
					panels[j].classList.add('is-off');
				}
			} else if (f < 3) {
				f += 1;
				flyIn(f);
			}
			show();
		});
		bOut.addEventListener('click', () => {
			if (f < 0) f = 3;
			if (f > 0) {
				flyOut(f);
				f -= 1;
			}
			show();
		});
		show();

		// molecules jiggle (thermal motion), electrons go round; only while the figure is on screen
		const mols = [...root.querySelectorAll<SVGGElement>('[data-mol]')].map((g) => ({
			g,
			x: Number(g.dataset.x),
			y: Number(g.dataset.y),
			a: Number(g.dataset.a),
			k: Number(g.dataset.k),
			ph: [0, 1, 2, 3, 4].map(() => Math.random() * 6.283),
			w: [0, 1, 2].map(() => 1.4 + Math.random() * 1.4),
		}));
		const els = [...root.querySelectorAll<SVGGElement>('[data-e]')].map((g) => ({
			g,
			r: Number(g.dataset.r),
			a: (Number(g.dataset.a0) * Math.PI) / 180,
			w: Number(g.dataset.w),
		}));
		let time = 0;
		animator(
			root,
			() => true,
			(dt) => {
				time += dt;
				for (const m of mols) {
					const dx = 2.4 * m.k * (Math.sin(m.w[0] * time + m.ph[0]) + 0.5 * Math.sin(2.3 * m.w[1] * time + m.ph[1]));
					const dy = 2.4 * m.k * (Math.sin(m.w[1] * time + m.ph[2]) + 0.5 * Math.sin(2.1 * m.w[0] * time + m.ph[3]));
					const da = 16 * m.k * Math.sin(m.w[2] * time + m.ph[4]);
					m.g.setAttribute('transform', `translate(${(m.x + dx).toFixed(2)} ${(m.y + dy).toFixed(2)}) rotate(${(m.a + da).toFixed(1)})`);
				}
				for (const e of els) {
					const a = e.a + e.w * time;
					e.g.setAttribute('transform', `translate(${(100 + e.r * Math.cos(a)).toFixed(2)} ${(100 + e.r * Math.sin(a)).toFixed(2)})`);
				}
			},
		)();
	}
</script>
