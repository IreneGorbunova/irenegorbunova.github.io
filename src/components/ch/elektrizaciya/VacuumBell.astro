		background: color-mix(in srgb, var(--vb-n) 22%, transparent);
	}
	.vb__meter {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.6rem;
		margin-top: 0.7rem;
