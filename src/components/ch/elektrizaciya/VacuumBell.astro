---
/**
 * «Воздух для действия зарядов не нужен»: a charged electroscope under a glass bell on the plate of an
 * air pump. Dots are air molecules (each stands for a huge number of them). Every stroke of the pump
 * lets the air of the bell expand into the cylinder (isothermal: the share left is V_b / (V_b + V_c)
 * = 0.55 per stroke), then pushes the cylinder's air out; after 8 strokes less than 1 % is left. The
 * leaves stay apart: the charge does not need air. A negatively charged rod outside the bell pushes
 * the free electrons of the electroscope down to the leaves through the glass and the vacuum, so the
 * leaves diverge further, and fall back when the rod is taken away. Without air the leaves swing
 * longer: nothing damps them.
 */
const W = 640;
const H = 392;
const TABLE = 362;
const PLATE = { x: 150, y: 306, w: 340, h: 10 };
const BELL = { cx: 320, cy: 170, a: 134, b: 100, l: 186, r: 454 }; // outer surface: walls + half-ellipse dome
const CASE = { x: 262, y: 186, w: 116, h: 102 };
const BALL = { x: 320, y: 142, r: 17 };
const PIVOT = { x: 320, y: 220 };
const HOLE = { x: 410 };
const CYL = { x: 540, y: 196, w: 52, h: 148 };
const PIPE_Y = 336;
const uid = `vb-${Math.random().toString(36).slice(2, 8)}`;
const dome = `M ${BELL.l} ${PLATE.y} L ${BELL.l} ${BELL.cy} A ${BELL.a} ${BELL.b} 0 0 1 ${BELL.r} ${BELL.cy} L ${BELL.r} ${PLATE.y}`;
---

<figure class="vb not-content" data-vb>
	<svg
		class="vb__svg"
		viewBox={`0 0 ${W} ${H}`}
		role="img"
		aria-label="Заряженный электроскоп под стеклянным колоколом на тарелке воздушного насоса"
		data-svg
	>
		<defs>
			<radialGradient id={`${uid}-ball`} cx="0.35" cy="0.32" r="0.75">
				<stop offset="0" class="vb__metal-hi"></stop>
				<stop offset="1" class="vb__metal-lo"></stop>
			</radialGradient>
			<linearGradient id={`${uid}-glass`} x1="0" y1="0" x2="1" y2="0">
				<stop offset="0" class="vb__glass-edge"></stop>
				<stop offset="0.25" class="vb__glass-mid"></stop>
				<stop offset="0.75" class="vb__glass-mid"></stop>
				<stop offset="1" class="vb__glass-edge"></stop>
			</linearGradient>
		</defs>

		<line class="vb__table" x1="0" y1={TABLE} x2={W} y2={TABLE}></line>
		<text class="vb__cap" x={BELL.cx} y={TABLE + 24} text-anchor="middle">электроскоп</text>
		<text class="vb__cap" x={CYL.x + CYL.w / 2} y={TABLE + 24} text-anchor="middle">насос</text>
		<text class="vb__cap" x={BELL.l - 12} y="66" text-anchor="end">колокол</text>

		<!-- the pump: pipe from the hole in the plate to the cylinder, outlet, cylinder, piston -->
		<path class="vb__pipe" d={`M ${HOLE.x} ${PLATE.y + PLATE.h} V ${PIPE_Y} H ${CYL.x}`}></path>
		<path class="vb__pipe-in" d={`M ${HOLE.x} ${PLATE.y + PLATE.h - 2} V ${PIPE_Y} H ${CYL.x + 2}`}></path>
		<path class="vb__pipe" d={`M ${CYL.x + CYL.w} ${PIPE_Y} H ${CYL.x + CYL.w + 22}`}></path>
		<path class="vb__pipe-in" d={`M ${CYL.x + CYL.w - 2} ${PIPE_Y} H ${CYL.x + CYL.w + 23}`}></path>
		<rect class="vb__foot" x={CYL.x - 6} y={CYL.y + CYL.h} width={CYL.w + 12} height={TABLE - CYL.y - CYL.h}></rect>
		<rect class="vb__cyl" x={CYL.x} y={CYL.y} width={CYL.w} height={CYL.h} rx="5"></rect>
		<g data-cyl-dots></g>
		<g data-piston>
			<rect class="vb__prod" x={CYL.x + CYL.w / 2 - 3} y="-150" width="6" height="152"></rect>
			<rect class="vb__handle" x={CYL.x - 8} y="-160" width={CYL.w + 16} height="12" rx="6"></rect>
			<rect class="vb__piston" x={CYL.x + 3} y="0" width={CYL.w - 6} height="12" rx="2"></rect>
		</g>
		<rect class="vb__cylcap" x={CYL.x - 2} y={CYL.y - 4} width={CYL.w + 4} height="8" rx="3"></rect>

		<!-- the plate on its stand, the bell (back) -->
		<rect class="vb__foot" x={BELL.cx - 16} y={PLATE.y + PLATE.h} width="32" height={TABLE - PLATE.y - PLATE.h}></rect>
		<rect class="vb__foot" x={BELL.cx - 60} y={TABLE - 8} width="120" height="8" rx="3"></rect>
		<rect class="vb__plate" x={PLATE.x} y={PLATE.y} width={PLATE.w} height={PLATE.h} rx="3"></rect>
		<rect class="vb__hole" x={HOLE.x - 6} y={PLATE.y} width="12" height={PLATE.h}></rect>
		<path class="vb__bell-fill" d={dome + ' Z'} fill={`url(#${uid}-glass)`}></path>
		<g data-pipe-dots></g>
		<g data-dots></g>

		<!-- electroscope: case, feet, stem, leaves, ball -->
		<rect class="vb__case" x={CASE.x} y={CASE.y} width={CASE.w} height={CASE.h} rx="12"></rect>
		<rect class="vb__foot" x={CASE.x + 8} y={CASE.y + CASE.h} width="16" height={PLATE.y - CASE.y - CASE.h}></rect>
		<rect class="vb__foot" x={CASE.x + CASE.w - 24} y={CASE.y + CASE.h} width="16" height={PLATE.y - CASE.y - CASE.h}
		></rect>
		<rect class="vb__stem" x={BALL.x - 3} y={BALL.y + BALL.r - 2} width="6" height={PIVOT.y - BALL.y - BALL.r + 4} rx="2"
		></rect>
		<g data-leaves></g>
		<rect class="vb__plug" x={BALL.x - 13} y={CASE.y - 8} width="26" height="16" rx="4"></rect>
		<circle class="vb__ball" cx={BALL.x} cy={BALL.y} r={BALL.r} fill={`url(#${uid}-ball)`}></circle>
		<g data-ball-q></g>

		<!-- the bell (front): glass outline, rim, knob, shine -->
		<path class="vb__bell" d={dome}></path>
		<rect class="vb__rim" x={BELL.l - 5} y={PLATE.y - 6} width={BELL.r - BELL.l + 10} height="6" rx="2"></rect>
		<rect class="vb__knob" x={BELL.cx - 9} y={BELL.cy - BELL.b - 14} width="18" height="15" rx="5"></rect>
		<path class="vb__shine" d={`M ${BELL.l + 14} 270 L ${BELL.l + 14} 180 Q ${BELL.l + 16} 120 ${BELL.l + 52} 96`}></path>

		<!-- the rod outside the bell -->
		<g data-rod></g>
	</svg>

	<div class="vb__buttons">
		<button type="button" class="vb__btn vb__btn--primary" data-pump>Откачать воздух</button>
		<button type="button" class="vb__btn" data-rod-btn aria-pressed="false">Поднести палочку</button>
		<button type="button" class="vb__btn vb__btn--quiet" data-reset>Сначала</button>
	</div>
	<div class="vb__meter">
		<span>Воздуха под колоколом:</span>
		<span class="vb__gauge">
			<span class="vb__bar"><span data-bar></span></span>
			<b class="vb__val" data-val>100 %</b>
		</span>
	</div>
	<p class="vb__live" data-live aria-live="polite"></p>

	<figcaption class="vb__legend">
		Точки — молекулы воздуха (каждая изображает огромное их число). Когда воздуха под колоколом почти не осталось,
		листочки электроскопа всё так же разведены, а палочка действует на него через стекло и пустоту. Значит, заряженные
		тела действуют друг на друга через электрическое поле, и воздух для этого не нужен.
	</figcaption>
</figure>

<style is:global>
