		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.vb {
			padding: 0.75rem;
		}
		.vb__cap,
		.vb__lbl {
			font-size: 22px;
		}
	}
</style>

<script>
	import { animator, chargeSymbol, el, narrow } from './util';

	const TABLE = 362;
	const PLATE_Y = 306;
	const BELL = { cx: 320, cy: 170, a: 134, b: 100, l: 186, r: 454 };
	const BALL = { x: 320, y: 142, r: 17 };
	const PIVOT = { x: 320, y: 220 };
	const CYL = { x: 540, y: 196, w: 52, h: 148 };
	const PIPE_Y = 336;
	const HOLE = { x: 410, y: PLATE_Y - 3 };
	const PIPE: [number, number][] = [
		[HOLE.x, HOLE.y],
		[HOLE.x, PIPE_Y],
		[CYL.x + 8, PIPE_Y],
	];
	const OUTLET = { x: CYL.x + CYL.w + 4, y: PIPE_Y };
	void TABLE;

	const N0 = 72; // dots under the bell at the start
	const KEEP = 0.55; // share of the air left under the bell after one stroke
	const STROKES = 8; // 0.55^8 = 0.8 %: «почти нет»
	const T_IN = 0.7; // s, the piston goes up (air flows into the cylinder)
	const T_OUT = 0.5; // s, the piston goes down (air is pushed out through the outlet)
	const PIST_REST = 318; // y of the piston's top face
	const PIST_UP = 228;
	const ROD_L = 200;
	const ROD_T = 20;
	const GRIP = 52;
	const ROD_Y = BALL.y;
	const TIP_NEAR = 174; // the rod's tip next to the glass
	const TIP_FAR = -24; // the rod out of the picture
	const ROD_TIME = 0.9; // s
	const Q_E = -10; // charge of the electroscope, in drawn units (each «−» glyph: one unit)
	const I_MAX = 4; // units pushed down to the leaves by the rod next to the glass
	const LEAF_L = 58;
	const LEAF_MAX = 58; // degrees

	const smooth = (t: number) => t * t * (3 - 2 * t);
	const rnd = (a: number, b: number) => a + Math.random() * (b - a);

	type Dot = {
		x: number;
		y: number;
		vx: number;
		vy: number;
		st: 'bell' | 'go' | 'pipe' | 'cyl' | 'out' | 'gone';
		s: number;
		a: number;
		g: SVGCircleElement;
	};

	/** Keeps a dot inside the bell: walls, half-ellipse dome and plate; reflects its velocity. */
	const bounceBell = (d: Dot, rr: number) => {
		const a = BELL.a - 4 - rr;
		const b = BELL.b - 4 - rr;
		const xl = BELL.l + 4 + rr;
		const xr = BELL.r - 4 - rr;
		const yb = PLATE_Y - 6 - rr;
		if (d.y > yb) {
			d.y = yb;
			d.vy = -Math.abs(d.vy);
		}
		if (d.y >= BELL.cy) {
			if (d.x < xl) {
				d.x = xl;
				d.vx = Math.abs(d.vx);
			}
			if (d.x > xr) {
				d.x = xr;
				d.vx = -Math.abs(d.vx);
			}
		} else {
			const ux = (d.x - BELL.cx) / a;
			const uy = (d.y - BELL.cy) / b;
			const k = Math.hypot(ux, uy);
			if (k > 1) {
				d.x = BELL.cx + (ux / k) * a;
				d.y = BELL.cy + (uy / k) * b;
				let nx = ux / a;
				let ny = uy / b;
				const n = Math.hypot(nx, ny);
				nx /= n;
				ny /= n;
				const vn = d.vx * nx + d.vy * ny;
				if (vn > 0) {
					d.vx -= 2 * vn * nx;
					d.vy -= 2 * vn * ny;
				}
			}
		}
	};
	/** A random point inside the bell. */
	const randomInBell = () => {
		for (;;) {
			const x = rnd(BELL.l + 8, BELL.r - 8);
			const y = rnd(BELL.cy - BELL.b + 8, PLATE_Y - 10);
			if (y >= BELL.cy || ((x - BELL.cx) / (BELL.a - 8)) ** 2 + ((y - BELL.cy) / (BELL.b - 8)) ** 2 < 1) return { x, y };
		}
	};
	const pipeLen = PIPE.slice(1).reduce((s, p, i) => s + Math.hypot(p[0] - PIPE[i][0], p[1] - PIPE[i][1]), 0);
	const alongPipe = (s: number) => {
		for (let i = 1; i < PIPE.length; i++) {
			const L = Math.hypot(PIPE[i][0] - PIPE[i - 1][0], PIPE[i][1] - PIPE[i - 1][1]);
			if (s <= L) {
				const k = s / L;
				return { x: PIPE[i - 1][0] + (PIPE[i][0] - PIPE[i - 1][0]) * k, y: PIPE[i - 1][1] + (PIPE[i][1] - PIPE[i - 1][1]) * k };
			}
			s -= L;
		}
		return { x: PIPE[PIPE.length - 1][0], y: PIPE[PIPE.length - 1][1] };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-vb]')) {
		const gDots = root.querySelector<SVGGElement>('[data-dots]')!;
		const gPipeDots = root.querySelector<SVGGElement>('[data-pipe-dots]')!;
		const gCylDots = root.querySelector<SVGGElement>('[data-cyl-dots]')!;
		const gPiston = root.querySelector<SVGGElement>('[data-piston]')!;
		const gLeaves = root.querySelector<SVGGElement>('[data-leaves]')!;
		const gBallQ = root.querySelector<SVGGElement>('[data-ball-q]')!;
		const gRod = root.querySelector<SVGGElement>('[data-rod]')!;
		const pumpBtn = root.querySelector<HTMLButtonElement>('[data-pump]')!;
		const rodBtn = root.querySelector<HTMLButtonElement>('[data-rod-btn]')!;
		const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;
		const bar = root.querySelector<HTMLElement>('[data-bar]')!;
		const val = root.querySelector<HTMLElement>('[data-val]')!;
		const live = root.querySelector<HTMLElement>('[data-live]')!;

		let dotR = 2.6;
		let symR = 5;
		let dots: Dot[] = [];
		let air = 1; // share of the air left under the bell
		let strokes = 0;
		let pumping = false;
		let strokeT = 0;
		let airAtStroke = 1;
		let piston = PIST_REST;
		let refill = 0; // dots still to come back in through the hole
		let refillT = 0;
		let rodGoal = 0;
		let rodP = 0; // 0: away, 1: next to the glass (progress of the move)
		let theta = 0;
		let omega = 0;
		let ballKey = '';
		let leafKey = '';

		const say = (t: string) => {
			live.textContent = t;
		};

		// ---------- dots ----------
		const addDot = (x: number, y: number, vx?: number, vy?: number) => {
			const v = rnd(45, 100);
			const a = rnd(0, 2 * Math.PI);
			const g = el('circle', { class: 'vb__dot', r: dotR, cx: x, cy: y }, gDots);
			const d: Dot = { x, y, vx: vx ?? v * Math.cos(a), vy: vy ?? v * Math.sin(a), st: 'bell', s: 0, a: 1, g };
			dots.push(d);
			return d;
		};
		const inBell = () => dots.filter((d) => d.st === 'bell');
		const toLayer = (d: Dot, layer: SVGGElement) => {
			if (d.g.parentNode !== layer) layer.appendChild(d.g);
		};
		/** Sends the dots nearest to the hole out of the bell until round(N0·air) are left (at least one). */
		const release = () => {
			const target = Math.max(1, Math.round(N0 * air));
			const free = inBell().sort((p, q) => Math.hypot(p.x - HOLE.x, p.y - HOLE.y) - Math.hypot(q.x - HOLE.x, q.y - HOLE.y));
			for (let k = 0; k < free.length - target; k++) free[k].st = 'go';
		};
		const stepDots = (dt: number, exhausting: boolean) => {
			const cylTop = piston + 12 + dotR + 1;
			const cylBot = CYL.y + CYL.h - 3 - dotR;
			for (const d of dots) {
				if (d.st === 'bell') {
					// a molecule flies straight and now and then changes its direction (collisions)
					if (Math.random() < dt * 0.8) {
						const v = Math.hypot(d.vx, d.vy);
						const a = Math.atan2(d.vy, d.vx) + rnd(-1.2, 1.2);
						d.vx = v * Math.cos(a);
						d.vy = v * Math.sin(a);
					}
					d.x += d.vx * dt;
					d.y += d.vy * dt;
					bounceBell(d, dotR);
				} else if (d.st === 'go') {
					const dx = HOLE.x - d.x;
					const dy = HOLE.y - d.y;
					const r = Math.hypot(dx, dy);
					const v = 230;
					if (r < v * dt + 1) {
						d.st = 'pipe';
						d.s = 0;
						toLayer(d, gPipeDots);
					} else {
						d.x += (dx / r) * v * dt;
						d.y += (dy / r) * v * dt;
					}
				} else if (d.st === 'pipe') {
					d.s += 300 * dt;
					const p = alongPipe(d.s);
					d.x = p.x;
					d.y = p.y;
					if (d.s >= pipeLen) {
						toLayer(d, gCylDots);
						if (pumping && !exhausting) {
							d.st = 'cyl';
							d.vx = rnd(20, 80);
							d.vy = -rnd(40, 110);
						} else d.st = 'out';
					}
				} else if (d.st === 'cyl') {
					d.x += d.vx * dt;
					d.y += d.vy * dt;
					const xl = CYL.x + 3 + dotR;
					const xr = CYL.x + CYL.w - 3 - dotR;
					if (d.x < xl) {
						d.x = xl;
						d.vx = Math.abs(d.vx);
					}
					if (d.x > xr) {
						d.x = xr;
						d.vx = -Math.abs(d.vx);
					}
					if (d.y < cylTop) {
						d.y = cylTop;
						d.vy = Math.abs(d.vy);
					}
					if (d.y > cylBot) {
						d.y = cylBot;
						d.vy = -Math.abs(d.vy);
					}
				} else if (d.st === 'out') {
					if (d.x < OUTLET.x) {
						const dx = OUTLET.x - d.x;
						const dy = OUTLET.y - d.y;
						const r = Math.hypot(dx, dy);
						const v = 220;
						if (r < v * dt + 1) {
							d.x = OUTLET.x + 0.1;
							d.y = OUTLET.y;
						} else {
							d.x += (dx / r) * v * dt;
							d.y += (dy / r) * v * dt;
						}
					} else {
						// out into the room: it flies away and is lost among the room's air
						d.x += 110 * dt;
						d.y += rnd(-40, 30) * dt;
						d.a -= dt * 1.6;
						if (d.a <= 0) {
							d.st = 'gone';
							d.g.remove();
						}
					}
				}
				d.g.setAttribute('cx', d.x.toFixed(1));
				d.g.setAttribute('cy', d.y.toFixed(1));
				if (d.st === 'out') d.g.setAttribute('opacity', Math.max(0, d.a).toFixed(2));
			}
			dots = dots.filter((d) => d.st !== 'gone');
		};

		// ---------- the rod ----------
		const buildRod = () => {
			gRod.replaceChildren();
			el('rect', { class: 'vb__rod-body', x: -ROD_L, y: -ROD_T / 2, width: ROD_L, height: ROD_T, rx: ROD_T / 2 }, gRod);
			el('rect', { class: 'vb__grip', x: -ROD_L, y: -ROD_T / 2, width: GRIP, height: ROD_T, rx: ROD_T / 2 }, gRod);
			const lbl = el('text', { class: 'vb__lbl', x: -ROD_L / 2 - 10, y: -ROD_T / 2 - 9, 'text-anchor': 'middle' }, gRod);
			lbl.textContent = 'эбонит';
			for (let k = 0; k < 6; k++) {
				const c = chargeSymbol(-1, symR, gRod);
				c.setAttribute('transform', `translate(${-14 - k * 2.6 * symR} ${k % 2 ? 2 : -2})`);
			}
		};
		const tipX = () => TIP_FAR + (TIP_NEAR - TIP_FAR) * smooth(rodP);
		/** Share of the full influence of the rod: ∝ 1/d², zero when the rod is out of the picture. */
		const influence = () => {
			const d = BALL.x - tipX();
			const dn = BALL.x - TIP_NEAR;
			const df = BALL.x - TIP_FAR;
			const k = ((dn / d) ** 2 - (dn / df) ** 2) / (1 - (dn / df) ** 2);
			return Math.min(1, Math.max(0, k));
		};

		// ---------- electroscope ----------
		const leafG: SVGGElement[] = [];
		const leafQ: SVGGElement[] = [];
		for (let i = 0; i < 2; i++) {
			const g = el('g', {}, gLeaves);
			el('path', { class: 'vb__leaf', d: `M -2 0 L 2 0 L 7 ${LEAF_L} Q 0 ${LEAF_L + 6} -7 ${LEAF_L} Z` }, g);
			leafG.push(g);
			leafQ.push(el('g', {}, g));
		}
		const leafGoal = (qL: number) => LEAF_MAX * (1 - Math.exp(-Math.abs(qL) / 6));
		const charges = () => {
			const w = influence();
			const qL = 0.5 * Q_E - I_MAX * w; // the rod pushes electrons down to the leaves
			return { qL, qB: Q_E - qL, w };
		};
		const drawScope = () => {
			const { qL, qB, w } = charges();
			leafG[0].setAttribute('transform', `translate(${PIVOT.x} ${PIVOT.y}) rotate(${theta.toFixed(2)})`);
			leafG[1].setAttribute('transform', `translate(${PIVOT.x} ${PIVOT.y}) rotate(${(-theta).toFixed(2)})`);
			const nL = Math.round(Math.abs(qL));
			const lk = `${nL}|${symR}`;
			if (lk !== leafKey) {
				leafKey = lk;
				leafQ.forEach((g, i) => {
					g.replaceChildren();
					const mine = i === 0 ? Math.ceil(nL / 2) : Math.floor(nL / 2);
					for (let k = 0; k < mine; k++) {
						const c = chargeSymbol(-1, symR * 0.85, g);
						c.setAttribute('transform', `translate(0 ${LEAF_L - 9 - k * symR * 1.8})`);
					}
				});
			}
			// the ball's electrons: on top, pushed to the far side (from the rod) as the rod comes near
			const nB = Math.round(Math.abs(qB));
			const dir = -Math.PI / 2 + (Math.PI / 2.4) * w;
			const bk = `${nB}|${Math.round(dir * 10)}|${symR}`;
			if (bk !== ballKey) {
				ballKey = bk;
				gBallQ.replaceChildren();
				const step = (symR * 2.1) / (BALL.r + 1);
				for (let k = 0; k < nB; k++) {
					const a = dir + (k - (nB - 1) / 2) * step;
					const c = chargeSymbol(-1, symR * 0.85, gBallQ);
					c.setAttribute('transform', `translate(${(BALL.x + Math.cos(a) * (BALL.r - 1)).toFixed(1)} ${(BALL.y + Math.sin(a) * (BALL.r - 1)).toFixed(1)})`);
				}
			}
		};

		const showAir = () => {
			bar.style.width = `${(air * 100).toFixed(1)}%`;
			val.textContent = air < 0.01 ? 'почти нет' : `${Math.round(air * 100)} %`;
		};

		// ---------- the loop ----------
		const frame = (dt: number) => {
			let exhausting = false;
			if (pumping) {
				strokeT += dt;
				if (strokeT < T_IN) {
					const s = (1 - Math.cos((Math.PI * strokeT) / T_IN)) / 2;
					piston = PIST_REST + (PIST_UP - PIST_REST) * s;
					// the air of the bell expands into the cylinder: V_b / (V_b + V_c), V_c = (1/KEEP − 1)·V_b·s
					air = airAtStroke / (1 + (1 / KEEP - 1) * s);
					release();
				} else if (strokeT < T_IN + T_OUT) {
					// the valve to the bell is shut; the piston pushes the cylinder's air out
					if (air !== airAtStroke * KEEP) {
						air = airAtStroke * KEEP;
						release();
					}
					exhausting = true;
					for (const d of dots) if (d.st === 'cyl') d.st = 'out';
					const u = (strokeT - T_IN) / T_OUT;
					piston = PIST_UP + (PIST_REST - PIST_UP) * ((1 - Math.cos(Math.PI * u)) / 2);
				} else {
					piston = PIST_REST;
					strokes += 1;
					strokeT = 0;
					airAtStroke = air;
					if (strokes >= STROKES) {
						pumping = false;
						pumpBtn.textContent = 'Воздух откачан';
						say(
							rodGoal
								? 'Воздуха под колоколом почти не осталось, а палочка по-прежнему действует на электроскоп: листочки разведены сильнее, чем без неё.'
								: 'Воздуха под колоколом почти не осталось, а листочки разведены, как и прежде: чтобы заряд держался на электроскопе, воздух не нужен (в пустоте заряд даже медленнее «утекает»). Теперь поднесите палочку.',
						);
					}
				}
				showAir();
			}
			gPiston.setAttribute('transform', `translate(0 ${piston.toFixed(1)})`);
			// air coming back in through the hole
			if (refill > 0) {
				refillT += dt;
				while (refill > 0 && refillT > 0.008) {
					refillT -= 0.008;
					refill -= 1;
					addDot(HOLE.x + rnd(-4, 4), HOLE.y - 2, rnd(-140, 60), -rnd(90, 200));
				}
			}
			stepDots(dt, exhausting);
			// the rod
			if (rodP !== rodGoal) {
				rodP = rodGoal > rodP ? Math.min(rodGoal, rodP + dt / ROD_TIME) : Math.max(rodGoal, rodP - dt / ROD_TIME);
			}
			gRod.setAttribute('transform', `translate(${tipX().toFixed(1)} ${ROD_Y})`);
			gRod.style.display = tipX() < 0 ? 'none' : '';
			// the leaves: a damped swing; the air damps it, in vacuum it swings longer
			const goal = leafGoal(charges().qL);
			const damp = 2.2 + 7 * air;
			omega += (60 * (goal - theta) - damp * omega) * dt;
			theta = Math.max(0, theta + omega * dt);
			drawScope();
		};
		const wake = animator(root, () => true, frame);

		const reset = () => {
			for (const d of dots) d.g.remove();
			dots = [];
			pumping = false;
			strokes = 0;
			strokeT = 0;
			air = 1;
			airAtStroke = 1;
			piston = PIST_REST;
			refill = 0;
			dotR = narrow() ? 3.6 : 2.6;
			symR = narrow() ? 6.5 : 5;
			buildRod();
			leafKey = '';
			ballKey = '';
			pumpBtn.disabled = false;
			pumpBtn.textContent = 'Откачать воздух';
			rodBtn.textContent = 'Поднести палочку';
			rodBtn.setAttribute('aria-pressed', 'false');
			showAir();
		};

		pumpBtn.addEventListener('click', () => {
			if (pumping || strokes >= STROKES) return;
			pumping = true;
			strokeT = 0;
			airAtStroke = air;
			pumpBtn.disabled = true;
			pumpBtn.textContent = 'Насос работает…';
			say('Насос работает: с каждым ходом поршня часть воздуха уходит из-под колокола в насос, а оттуда — наружу.');
			wake();
		});
		rodBtn.addEventListener('click', () => {
			rodGoal = rodGoal ? 0 : 1;
			rodBtn.textContent = rodGoal ? 'Убрать палочку' : 'Поднести палочку';
			rodBtn.setAttribute('aria-pressed', String(Boolean(rodGoal)));
			if (rodGoal)
				say(
					air < 0.01
						? 'Палочка заряжена, как и электроскоп, отрицательно. Через стекло и пустоту она отталкивает его электроны вниз, на листочки, — и они расходятся сильнее. Без воздуха листочки дольше качаются: их ничто не тормозит.'
						: 'Палочка заряжена, как и электроскоп, отрицательно. Через стекло она отталкивает его электроны вниз, на листочки, — и они расходятся сильнее. Откачайте воздух и проверьте, нужен ли он для этого.',
				);
			else say('Палочку убрали: электроны вернулись на шар, и листочки сошлись до прежнего угла.');
			wake();
		});
		resetBtn.addEventListener('click', () => {
			const back = N0 - inBell().length;
			reset();
			for (let k = 0; k < N0 - back; k++) {
				const p = randomInBell();
				addDot(p.x, p.y);
			}
			refill = back;
			refillT = 0;
			rodGoal = 0;
			say(back > 0 ? 'Воздух вернулся под колокол. Электроскоп по-прежнему заряжен.' : 'Электроскоп заряжен отрицательно: его листочки разошлись. Под колоколом — воздух.');
			wake();
		});

		reset();
		for (let k = 0; k < N0; k++) {
			const p = randomInBell();
			addDot(p.x, p.y);
		}
		theta = leafGoal(charges().qL);
		say('Электроскоп заряжен отрицательно: его листочки разошлись. Под колоколом — воздух.');
		frame(0);
		wake();
	}
</script>
