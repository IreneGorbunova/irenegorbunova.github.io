		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-3);
		transition: all 0.3s ease;
	}
	.chd__chip + .chd__chip::before {
		content: '→';
		position: absolute;
		transform: translateX(-1.15rem);
		color: var(--sl-color-gray-4);
		font-size: var(--sl-text-xs);
	}
	.chd__chip {
		position: relative;
		margin-left: 0.55rem;
	}
