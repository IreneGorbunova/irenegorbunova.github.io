	}
	.chd__live b {
		color: var(--sl-color-white);
	}
	.chd__live i {
		font-family: var(--ig-font-math);
	}
	.chd__legend {
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		line-height: 1.55;
		color: var(--sl-color-gray-3);
	}
	.chd__sym {
		display: inline-grid;
		place-items: center;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 50%;
