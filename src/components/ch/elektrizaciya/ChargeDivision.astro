		cursor: pointer;
	}
	.chd__btn:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.chd__btn:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.chd__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
