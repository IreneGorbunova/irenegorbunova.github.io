		margin-top: 0.75rem;
	}
	.chd__chips {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
	}
	.chd__chip {
		display: inline-grid;
		place-items: center;
		min-width: 2rem;
		height: 2rem;
		padding-inline: 0.3rem;
