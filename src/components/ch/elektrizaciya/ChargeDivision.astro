---
/**
 * «Делим заряд пополам»: a thought experiment. A metal ball on an insulating stand carries 16 extra
 * electrons. An identical neutral ball touches it, the electrons share equally (identical balls),
 * the second ball is taken away and discharged by a hand (its electrons go through the body to the
 * ground). 16 → 8 → 4 → 2 → 1. The last electron cannot be split: on touching it ends up on one ball
 * or the other (chosen at random). In a conductor the extra electrons repel each other and sit evenly
 * on the surface; near the contact point of two touching balls the surface charge is small, so the
 * electrons keep away from it.
 */
const W = 400;
const H = 250;
const A = { x: 115, y: 118 }; // our ball
const R = 48;
const REST = 285; // the second ball when it stands aside
const TABLE = 238;
const TOP = 32; // the picture starts just above the charge labels
const uid = `chd-${Math.random().toString(36).slice(2, 8)}`;
const stand = (x: number) => ({ rod: { x: x - 5, y: A.y + R - 4, w: 10, h: TABLE - 8 - (A.y + R - 4) }, base: { x: x - 30, y: TABLE - 8, w: 60, h: 8 } });
const sA = stand(A.x);
const sB = stand(0);
const CHIPS = [16, 8, 4, 2, 1];
---

<figure class="chd not-content" data-chd>
	<svg class="chd__svg" viewBox={`0 ${TOP} ${W} ${H - TOP}`} role="img" aria-label="Два металлических шара на подставках из диэлектрика" data-svg>
		<defs>
			<radialGradient id={`${uid}-metal`} cx="0.36" cy="0.32" r="0.75">
				<stop offset="0" class="chd__metal-hi"></stop>
				<stop offset="1" class="chd__metal-lo"></stop>
			</radialGradient>
		</defs>
		<line class="chd__table" x1="0" y1={TABLE} x2={W} y2={TABLE}></line>

		<!-- our ball -->
		<rect class="chd__rod" x={sA.rod.x} y={sA.rod.y} width={sA.rod.w} height={sA.rod.h} rx="3"></rect>
		<rect class="chd__base" x={sA.base.x} y={sA.base.y} width={sA.base.w} height={sA.base.h} rx="3"></rect>
		<circle class="chd__ball" cx={A.x} cy={A.y} r={R} fill={`url(#${uid}-metal)`}></circle>
		<text class="chd__q" x={A.x} y={A.y - R - 14} text-anchor="middle" data-qa></text>

		<!-- the second ball moves as a whole -->
		<g data-b transform={`translate(${REST} 0)`}>
			<rect class="chd__rod" x={sB.rod.x} y={sB.rod.y} width={sB.rod.w} height={sB.rod.h} rx="3"></rect>
			<rect class="chd__base" x={sB.base.x} y={sB.base.y} width={sB.base.w} height={sB.base.h} rx="3"></rect>
			<circle class="chd__ball" cx="0" cy={A.y} r={R} fill={`url(#${uid}-metal)`}></circle>
			<text class="chd__q" x="0" y={A.y - R - 14} text-anchor="middle" data-qb></text>
		</g>

		<!-- a hand (finger) that discharges the second ball -->
		<g class="chd__finger" data-finger transform={`translate(${W + 30} ${A.y})`}>
			<path class="chd__skin" d="M 0 -11 H 130 V 11 H 0 a 11 11 0 0 1 0 -22 z"></path>
			<path class="chd__nail" d="M 2 -7 h 14 a 7 7 0 0 1 0 14 h -14 a 7 7 0 0 1 0 -14 z"></path>
		</g>
		<g class="chd__ground" data-ground>
			<text x={W - 32} y={A.y + 38} text-anchor="middle">в землю</text>
			<path d={`M ${W - 58} ${A.y + 48} H ${W - 8} m -7 -5 l 7 5 l -7 5`}></path>
		</g>
		<g data-electrons></g>
	</svg>

	<div class="chd__buttons">
		<button type="button" class="chd__btn chd__btn--primary" data-split>Разделить пополам</button>
		<button type="button" class="chd__btn" data-auto aria-pressed="false">Все шаги подряд</button>
		<button type="button" class="chd__btn chd__btn--quiet" data-reset>Сначала</button>
	</div>

	<div class="chd__read">
		<div class="chd__chips" aria-label="Число лишних электронов на шаре">
			{CHIPS.map((n, i) => <span class="chd__chip" data-chip={n}>{n}</span>)}
		</div>
		<div class="chd__formula" data-formula></div>
	</div>
	<p class="chd__live" data-live aria-live="polite"></p>

	<figcaption class="chd__legend">
		<span class="chd__sym">−</span> лишний электрон. Шары металлические: лишние электроны отталкиваются друг от друга и
		расходятся по поверхности шара. Подставки из диэлектрика, поэтому заряд с шаров никуда не уходит. Здесь всего 16
		лишних электронов, чтобы их можно было сосчитать, а на настоящем заряженном теле их миллиарды. Например, заряд
		1·10<sup>−9</sup>&nbsp;Кл — это 6,25·10<sup>9</sup> лишних электронов: чтобы дойти до одного электрона, такой заряд
		пришлось бы разделить пополам около 32 раз.
	</figcaption>
</figure>

<style is:global>
	.chd {
		--chd-n: var(--ig-vx);
		--chd-ins: var(--sl-color-gray-5);
		--chd-skin: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-2));
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .chd {
		--chd-ins: var(--sl-color-gray-2);
		--chd-skin: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-5));
	}
	.chd__svg {
		display: block;
		width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.chd__table {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.chd__rod {
		fill: var(--chd-ins);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.chd__base {
		fill: var(--chd-ins);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.chd__metal-hi {
		stop-color: var(--sl-color-gray-1);
	}
	.chd__metal-lo {
		stop-color: var(--sl-color-gray-4);
	}
	:root[data-theme='light'] .chd__metal-hi {
		stop-color: var(--sl-color-gray-6);
	}
	:root[data-theme='light'] .chd__metal-lo {
		stop-color: var(--sl-color-gray-4);
	}
	.chd__ball {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.chd__q {
		font-family: var(--__sl-font);
		font-size: 18px;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.chd__q .m {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.chd__q .neg {
		fill: var(--chd-n);
		font-weight: 700;
	}
	.chd__skin {
		fill: var(--chd-skin);
		stroke: color-mix(in srgb, var(--chd-skin) 70%, var(--sl-color-gray-3));
		stroke-width: 1.5;
	}
	.chd__nail {
		fill: color-mix(in srgb, var(--sl-color-white) 30%, var(--chd-skin));
	}
	.chd__ground {
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.chd__ground text {
		font-family: var(--__sl-font);
		font-size: 14px;
		fill: var(--sl-color-gray-2);
	}
	.chd__ground path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.chd__ground.is-on {
		opacity: 1;
	}
	.chd .chg circle {
		fill: var(--chd-n);
		stroke: color-mix(in srgb, var(--chd-n) 60%, var(--sl-color-white));
		stroke-width: 1;
	}
	.chd .chg line {
		stroke: var(--sl-color-black);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.chd__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.chd__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
