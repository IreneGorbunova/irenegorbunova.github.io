			font-size: 15px;
		}
		.chd__formula .katex {
			font-size: 0.98em;
		}
	}
</style>

<script>
	import { animator, chargeSymbol, tex } from './util';

	const W = 400;
	const AX = 115;
	const CY = 118;
	const R = 48;
	const RING = 40; // extra electrons sit just under the surface
	const REST = 285;
	const TOUCH = AX + 2 * R;
	const GAP = 0.5; // rad: near the contact point of two touching balls there is almost no charge
	const TAU = 2 * Math.PI;
	const VALUE: Record<number, string> = {
		16: '2{,}56 \\cdot 10^{-18}',
		8: '1{,}28 \\cdot 10^{-18}',
		4: '6{,}4 \\cdot 10^{-19}',
		2: '3{,}2 \\cdot 10^{-19}',
		1: '1{,}6 \\cdot 10^{-19}',
	};
	const smooth = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
	const clamp = (t: number) => Math.max(0, Math.min(1, t));
	const Q = '<i>q</i><sub>1</sub>';

	type Ball = 'A' | 'B';
	type El = { g: SVGGElement; ball: Ball | null; ang: number; x: number; y: number; op: number };
	type Phase = { dur: number; start?: () => void; step: (t: number) => void; end?: () => void };

	for (const root of document.querySelectorAll<HTMLElement>('[data-chd]')) {
		const gB = root.querySelector<SVGGElement>('[data-b]')!;
		const finger = root.querySelector<SVGGElement>('[data-finger]')!;
		const ground = root.querySelector<SVGGElement>('[data-ground]')!;
		const gEl = root.querySelector<SVGGElement>('[data-electrons]')!;
		const qa = root.querySelector<SVGTextElement>('[data-qa]')!;
		const qb = root.querySelector<SVGTextElement>('[data-qb]')!;
		const formula = root.querySelector<HTMLElement>('[data-formula]')!;
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const bSplit = root.querySelector<HTMLButtonElement>('[data-split]')!;
		const bAuto = root.querySelector<HTMLButtonElement>('[data-auto]')!;
		const bReset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
		const chips = [...root.querySelectorAll<HTMLElement>('[data-chip]')];

		let bx = REST;
		let fx = W + 30; // finger tip
		let n = 16; // extra electrons on our ball
		let done = false;
		let auto = false;
		let pause = 0;
		let els: El[] = [];
		let queue: Phase[] = [];
		let cur: Phase | null = null;
		let el = 0;

		const center = (b: Ball) => ({ x: b === 'A' ? AX : bx, y: CY });
		const ringPos = (b: Ball, ang: number) => {
			const c = center(b);
			return { x: c.x + RING * Math.cos(ang), y: c.y + RING * Math.sin(ang) };
		};
		const onBall = (b: Ball) => els.filter((e) => e.ball === b);
		/** m angles spread evenly over the ball, leaving out ±gap around the side facing the other ball. */
		const spread = (b: Ball, m: number, gap: number) => {
			const dir = b === 'A' ? 0 : Math.PI;
			return Array.from({ length: m }, (_, k) => dir + gap + ((k + 0.5) * (TAU - 2 * gap)) / m);
		};
		/** Angle of e measured from the side of its ball facing the other ball, in [0, 2π). */
		const rel = (e: El) => {
			const dir = e.ball === 'A' ? 0 : Math.PI;
			return (((e.ang - dir) % TAU) + TAU) % TAU;
		};
		/** Move the electrons of ball b along its surface to even positions (sorted, so none cross). */
		const slide = (b: Ball, gap: number): Phase['step'] => {
			const list = onBall(b).sort((p, q) => rel(p) - rel(q));
			const to = spread(b, list.length, gap);
			const from = list.map((e) => (b === 'A' ? 0 : Math.PI) + rel(e));
			return (t) => {
				const s = smooth(t);
				list.forEach((e, k) => {
					e.ang = from[k] + (to[k] - from[k]) * s;
					Object.assign(e, ringPos(b, e.ang));
				});
			};
		};
		const quad = (p0: { x: number; y: number }, c: { x: number; y: number }, p1: { x: number; y: number }, t: number) => ({
			x: (1 - t) ** 2 * p0.x + 2 * (1 - t) * t * c.x + t * t * p1.x,
			y: (1 - t) ** 2 * p0.y + 2 * (1 - t) * t * c.y + t * t * p1.y,
		});

		const qText = (node: SVGTextElement, sub: string, k: number) => {
			const v = k === 0 ? '0' : `<tspan class="neg">−${k === 1 ? '' : k}<tspan class="m">e</tspan></tspan>`;
			node.innerHTML = `<tspan class="m">q</tspan><tspan font-size="0.7em" dy="5">${sub}</tspan><tspan dy="-5"> = </tspan>${v}`;
		};
		const labels = (a: number, b: number) => {
			qText(qa, '1', a);
			qText(qb, '2', b);
			chips.forEach((c) => {
				const v = Number(c.dataset.chip);
				c.classList.toggle('is-now', v === a);
				c.classList.toggle('is-past', v > a);
			});
			tex(
				formula,
				a === 0
					? 'q_1 = 0'
					: `q_1 = \\htmlClass{el-n}{-${a === 1 ? '' : a}e} = -${VALUE[a]}~\\text{Кл}`,
			);
		};
		const render = () => {
			gB.setAttribute('transform', `translate(${bx.toFixed(2)} 0)`);
			finger.setAttribute('transform', `translate(${fx.toFixed(2)} ${CY})`);
			for (const e of els) {
				e.g.setAttribute('transform', `translate(${e.x.toFixed(2)} ${e.y.toFixed(2)})`);
				e.g.setAttribute('opacity', e.op.toFixed(2));
			}
		};
		const say = (html: string) => (live.innerHTML = html);
		const syncButtons = () => {
			const busy = !!cur || queue.length > 0;
			bSplit.disabled = busy || done;
			bAuto.disabled = done;
			bAuto.setAttribute('aria-pressed', String(auto));
		};

		const reset = () => {
			queue = [];
			cur = null;
			bx = REST;
			fx = W + 30;
			n = 16;
			done = false;
			auto = false;
			ground.classList.remove('is-on');
			gEl.replaceChildren();
			els = spread('A', 16, 0).map((ang) => {
				const g = chargeSymbol(-1, 6, gEl);
				return { g, ball: 'A' as Ball, ang, ...ringPos('A', ang), op: 1 };
			});
			labels(16, 0);
			say(`На металлическом шаре 16 лишних электронов, его заряд ${Q} = −16<i>e</i>. Попробуем делить этот заряд пополам.`);
			render();
			syncButtons();
		};

		const tween = (from: number, to: number, set: (v: number) => void, dur: number, also?: () => Phase['step']): Phase => {
			let extra: Phase['step'] | undefined;
			return {
				dur,
				start: () => (extra = also?.()),
				step: (t) => {
					set(from + (to - from) * smooth(t));
					extra?.(t);
				},
			};
		};
		const wait = (dur: number, start?: () => void): Phase => ({ dur, start, step: () => {} });

		/** One halving: touch, share, take away, discharge the second ball by hand. */
		const halve = () => {
			const half = n / 2;
			let movers: El[] = [];
			let paths: { p0: { x: number; y: number }; p1: { x: number; y: number }; to: number; d: number }[] = [];
			let stay: Phase['step'] = () => {};
			queue.push(
				tween(REST, TOUCH, (v) => (bx = v), 0.75, undefined),
				{
					dur: 1.3,
					start: () => {
						say(
							`Касаемся таким же незаряженным шаром. Электроны отталкиваются друг от друга и делятся поровну: ${half === 1 ? 'по одному' : `по ${half}`} на каждом шаре.`,
						);
						const sorted = onBall('A').sort((p, q) => Math.abs(Math.sin(rel(p) / 2)) - Math.abs(Math.sin(rel(q) / 2)));
						movers = sorted.slice(0, half);
						// keep the order along the surface: the upper movers go to the upper part of the second ball
						const signed = (e: El) => (rel(e) > Math.PI ? rel(e) - TAU : rel(e));
						movers.sort((p, q) => signed(p) - signed(q));
						const targets = spread('B', half, GAP);
						paths = movers.map((e, k) => ({ p0: { x: e.x, y: e.y }, p1: ringPos('B', targets[k]), to: targets[k], d: (k / half) * 0.3 }));
						movers.forEach((e) => (e.ball = null));
						stay = slide('A', GAP);
					},
					step: (t) => {
						const c = { x: AX + R, y: CY };
						movers.forEach((e, k) => {
							const p = paths[k];
							const s = smooth(clamp((t - p.d) / 0.7));
							Object.assign(e, quad(p.p0, c, p.p1, s));
						});
						stay(t);
					},
					end: () => {
						movers.forEach((e, k) => {
							e.ball = 'B';
							e.ang = paths[k].to;
						});
						labels(half, half);
					},
				},
				wait(0.35),
			);
			let slideA: Phase['step'] = () => {};
			let slideB: Phase['step'] = () => {};
			queue.push(
				{
					dur: 0.8,
					start: () => {
						say('Убираем второй шар. На каждом шаре электроны снова расходятся по всей поверхности.');
						slideA = slide('A', 0);
						slideB = slide('B', 0);
					},
					step: (t) => {
						bx = TOUCH + (REST - TOUCH) * smooth(t);
						slideA(t);
						slideB(t);
					},
				},
				{
					dur: 0.6,
					start: () => say('Касаемся второго шара рукой: его электроны уходят через тело человека в землю.'),
					step: (t) => (fx = W + 30 + (REST + R + 11 - (W + 30)) * smooth(t)),
				},
			);
			let drain: { e: El; p0: { x: number; y: number }; d: number }[] = [];
			queue.push(
				{
					dur: 1.4,
					start: () => {
						ground.classList.add('is-on');
						drain = onBall('B').map((e, k, all) => ({ e, p0: { x: e.x, y: e.y }, d: (k / all.length) * 0.35 }));
						drain.forEach((o) => (o.e.ball = null));
					},
					step: (t) => {
						const tip = { x: REST + R - 2, y: CY };
						for (const o of drain) {
							const s = clamp((t - o.d) / 0.65);
							if (s < 0.35) {
								const u = smooth(s / 0.35);
								o.e.x = o.p0.x + (tip.x - o.p0.x) * u;
								o.e.y = o.p0.y + (tip.y - o.p0.y) * u;
							} else {
								const u = (s - 0.35) / 0.65;
								o.e.x = tip.x + (W + 12 - tip.x) * u * u;
								o.e.y = tip.y;
							}
							o.e.op = s < 0.75 ? 1 : 1 - (s - 0.75) / 0.25;
						}
					},
					end: () => {
						drain.forEach((o) => o.e.g.remove());
						els = els.filter((e) => e.ball !== null);
						labels(half, 0);
					},
				},
				{
					dur: 0.55,
					start: () => ground.classList.remove('is-on'),
					step: (t) => (fx = REST + R + 11 + (W + 30 - (REST + R + 11)) * smooth(t)),
					end: () => {
						n = half;
						say(
							n > 1
								? `Заряд нашего шара уменьшился вдвое: ${Q} = −${n}<i>e</i>. Делим дальше.`
								: `На шаре остался один лишний электрон: ${Q} = −<i>e</i>. Можно ли разделить пополам и его?`,
						);
					},
				},
			);
		};

		/** The last electron: it cannot be split, so it ends up on one of the balls. */
		const lastTry = () => {
			const toB = Math.random() < 0.5;
			let e: El;
			let p0 = { x: 0, y: 0 };
			const near = { x: AX + R - 4, y: CY };
			queue.push(tween(REST, TOUCH, (v) => (bx = v), 0.75), {
				dur: 0.8,
				start: () => {
					say('Касаемся вторым шаром. Поделится ли электрон пополам?');
					e = els[0];
					p0 = { x: e.x, y: e.y };
					e.ball = null;
				},
				step: (t) => {
					const c = { x: AX + 10, y: CY - RING - 10 };
					Object.assign(e, quad(p0, c, near, smooth(t)));
				},
			});
			queue.push({
				dur: 0.9,
				step: (t) => {
					e.x = near.x + 7 * Math.sin(3 * TAU * t) * (1 - t);
					e.y = near.y;
				},
			});
			let to = 0;
			let dest = { x: 0, y: 0 };
			queue.push(
				{
					dur: 0.7,
					start: () => {
						to = toB ? Math.PI + 0.9 : 0.9;
						dest = ringPos(toB ? 'B' : 'A', to);
					},
					step: (t) => {
						const s = smooth(t);
						e.x = near.x + (dest.x - near.x) * s;
						e.y = near.y + (dest.y - near.y) * s;
					},
					end: () => {
						e.ball = toB ? 'B' : 'A';
						e.ang = to;
						labels(toB ? 0 : 1, toB ? 1 : 0);
					},
				},
				wait(0.3),
			);
			queue.push({
				dur: 0.8,
				step: (t) => {
					bx = TOUCH + (REST - TOUCH) * smooth(t);
					// a single electron settles on the top of its ball
					e.ang = to + ((toB ? 1.5 * Math.PI : -0.5 * Math.PI) - to) * smooth(t);
					Object.assign(e, ringPos(e.ball!, e.ang));
				},
				end: () => {
					done = true;
					auto = false;
					say(
						`Электрон нельзя разделить: он целиком ${toB ? 'перешёл на второй шар' : 'остался на нашем шаре'}. Дальше делить некуда: заряд электрона — наименьший заряд, который бывает у отдельной частицы. Это <b>элементарный заряд</b> <i>e</i> = 1,6·10<sup>−19</sup> Кл.`,
					);
				},
			});
		};

		const next = () => {
			if (cur || queue.length || done) return;
			if (n > 1) halve();
			else lastTry();
			syncButtons();
			wake();
		};

		const wake = animator(
			root,
			() => !!cur || queue.length > 0 || (auto && !done),
			(dt) => {
				if (!cur && queue.length) {
					cur = queue.shift()!;
					el = 0;
					cur.start?.();
				}
				if (cur) {
					el += dt;
					const t = Math.min(1, el / cur.dur);
					cur.step(t);
					if (t >= 1) {
						cur.end?.();
						cur = null;
						pause = 0;
						if (!queue.length) syncButtons();
					}
				} else if (auto && !done) {
					pause += dt;
					if (pause > 0.9) next();
				}
				render();
			},
		);

		bSplit.addEventListener('click', next);
		bAuto.addEventListener('click', () => {
			auto = !auto;
			pause = 0.9;
			syncButtons();
			wake();
		});
		bReset.addEventListener('click', reset);
		reset();
	}
</script>
