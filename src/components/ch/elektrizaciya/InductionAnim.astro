		stroke: color-mix(in srgb, var(--ind-n) 60%, var(--sl-color-white));
	}
	.ind__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.ind__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ind__chip {
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		font-variant-numeric: tabular-nums;
	}
