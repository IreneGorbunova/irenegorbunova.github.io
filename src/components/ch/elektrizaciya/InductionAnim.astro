	}
	:root[data-theme='light'] .ind {
		--ind-ebonite: var(--sl-color-gray-2);
	}
	.ind__pairs {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0.25rem;
