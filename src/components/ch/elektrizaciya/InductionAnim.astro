---
/**
 * «Электризация через влияние»: a looping animation. A charged rod slowly approaches the ball of a neutral
 * electroscope without touching it and then moves away. The metal has bound positive charges (pale «+»,
 * fixed) and as many free electrons («−»). An ebonite rod (−) pushes four free electrons from the ball
 * down the stem into the leaves; a glass rod (+) pulls four electrons from the leaves up into the ball.
 * The leaves get charges of one sign and diverge; where an electron is missing its «+» lights up. The
 * charge of the whole electroscope stays 0. The induced charge grows as the rod comes closer (∝ 1/d).
 */
const W = 440;
const H = 330;
const B = { x: 318, y: 70, r: 34 };
const CASE = { x: 248, y: 130, w: 140, h: 166 };
const PIVOT = { x: 318, y: 182 };
const TABLE = 316;
const VX = 50; // the picture shows x from VX and y from VY: the rest is empty
const VY = 26;
const uid = `ind-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="ind not-content" data-ind>
	<div class="ind__pairs" role="radiogroup" aria-label="Какую палочку подносим">
		<button type="button" class="ind__pair is-on" role="radio" aria-checked="true" data-rod="ebonite">эбонит (−)</button>
		<button type="button" class="ind__pair" role="radio" aria-checked="false" data-rod="glass">стекло (+)</button>
	</div>

	<svg
		class="ind__svg"
		viewBox={`${VX} ${VY} ${W - VX - 38} ${TABLE + 6 - VY}`}
		role="img"
		aria-label="Заряженную палочку подносят к шару незаряженного электроскопа, не касаясь его. Свободные электроны металла перемещаются, листочки расходятся. Палочку убирают — листочки опадают."
		data-svg
	>
		<defs>
			<radialGradient id={`${uid}-ball`} cx="0.35" cy="0.32" r="0.75">
				<stop offset="0" class="ind__metal-hi"></stop>
				<stop offset="1" class="ind__metal-lo"></stop>
			</radialGradient>
			<linearGradient id={`${uid}-glass`} x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" class="ind__glass-hi"></stop>
				<stop offset="0.5" class="ind__glass-mid"></stop>
				<stop offset="1" class="ind__glass-lo"></stop>
			</linearGradient>
		</defs>
		<line class="ind__table" x1={VX} y1={TABLE} x2={W} y2={TABLE}></line>
		<rect class="ind__case" x={CASE.x} y={CASE.y} width={CASE.w} height={CASE.h} rx="14"></rect>
		<rect class="ind__foot" x={CASE.x + 10} y={CASE.y + CASE.h} width="20" height={TABLE - CASE.y - CASE.h}></rect>
		<rect class="ind__foot" x={CASE.x + CASE.w - 30} y={CASE.y + CASE.h} width="20" height={TABLE - CASE.y - CASE.h}></rect>
		<rect class="ind__stem" x={B.x - 3} y={B.y + B.r - 3} width="6" height={PIVOT.y - B.y - B.r + 5} rx="2"></rect>
		<g data-leaves></g>
		<rect class="ind__plug" x={B.x - 15} y={CASE.y - 10} width="30" height="20" rx="4"></rect>
		<circle class="ind__ball" cx={B.x} cy={B.y} r={B.r} fill={`url(#${uid}-ball)`}></circle>
		<g data-ions></g>
		<g data-electrons></g>
		<path class="ind__shine" d={`M ${CASE.x + 14} ${CASE.y + 22} q -4 50 0 110`}></path>
		<g data-rodg></g>
	</svg>

	<div class="ind__row">
		<div class="ind__chips" aria-live="off">
			<span class="ind__chip">шар: <b data-q-ball>0</b></span>
			<span class="ind__chip">стержень и листочки: <b data-q-low>0</b></span>
			<span class="ind__chip">весь электроскоп: <b data-q-all>0</b></span>
		</div>
		<button type="button" class="ind__btn" data-again>Сначала</button>
	</div>
	<p class="ind__live" data-live aria-live="polite"></p>

	<figcaption class="ind__legend">
		<span class="ind__sym ind__sym--n">−</span> свободный электрон металла, он может перемещаться по всему электроскопу.
		Бледный <span class="ind__sym ind__sym--p ind__sym--pale">+</span> — положительный заряд, связанный с металлом: он остаётся
		на месте. Яркий <span class="ind__sym ind__sym--p">+</span> — здесь не хватает электрона. Электроны только переходят из одной части
		электроскопа в другую, поэтому его заряд всё время равен нулю. Это электризация через влияние.
	</figcaption>
</figure>

<style is:global>
	.ind {
		--ind-p: var(--ig-vy);
		--ind-n: var(--ig-vx);
		--ind-ebonite: var(--sl-color-gray-5);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
