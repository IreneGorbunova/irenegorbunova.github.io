---
/**
 * Pictures to the definitions of the coil with current and of the electromagnet, made of FieldPic (lines computed
 * at build time from the exact field of 20 circular turns).
 * kind="coil": the coil with current next to a bar magnet of the same size — the same lines outside.
 * kind="core": the coil without and with an iron core — the same shape, many more lines.
 */
import FieldPic from './FieldPic.astro';

interface Props {
	kind: 'coil' | 'core';
}
const { kind } = Astro.props;
const panels =
	kind === 'coil'
		? [
				{ k: 'coil', title: 'катушка с током', label: 'Магнитные линии катушки с током: выходят из правого конца (N) и входят в левый (S)' },
				{ k: 'magnet', title: 'полосовой магнит', label: 'Магнитные линии полосового магнита такой же формы: снаружи они идут так же, как у катушки' },
			]
		: [
				{ k: 'coil', title: 'катушка без сердечника', label: 'Магнитные линии катушки с током без сердечника' },
				{ k: 'core', title: 'с железным сердечником', label: 'Катушка с железным сердечником: линии той же формы, но их гораздо больше' },
			];
---

<figure class="cpic not-content">
	<div class="cpic__grid">
		{
			panels.map((p) => (
				<div class="cpic__cell">
					<FieldPic kind={p.k as 'coil' | 'magnet' | 'core'} label={p.label} />
					<p class="cpic__title">{p.title}</p>
				</div>
			))
		}
	</div>
	<figcaption class="cpic__legend">
		{
			kind === 'coil' ? (
				<>
					Вид сбоку, катушка разрезана вдоль. В верхних витках ток идёт к нам (точки), в нижних — от нас (крестики).
					Снаружи магнитные линии катушки идут так же, как у полосового магнита: выходят из северного полюса{' '}
					<b class="cpic__n">N</b> и входят в южный <b class="cpic__s">S</b>. Внутри катушки линии идут почти параллельно
					и густо.
				</>
			) : (
				<>
					Ток и число витков одинаковые. Железный сердечник намагничивается, и его поле складывается с полем катушки:
					линии той же формы, но идут гораздо гуще — поле во много раз сильнее.
				</>
			)
		}
	</figcaption>
</figure>

<style is:global>
	.cpic {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.cpic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.cpic__cell .fpic {
		margin: 0;
		max-width: none;
	}
	.cpic__title {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.cpic__legend {
		margin-top: 0.7rem;
		font-size: var(--sl-text-xs);
	}
	.cpic__n {
		color: var(--ig-vx);
	}
	.cpic__s {
		color: var(--ig-vy);
	}
	@media (max-width: 40rem) {
		.cpic {
			padding: 0.75rem;
		}
		.cpic__grid {
			gap: 0.5rem;
		}
		.cpic__title {
			font-size: var(--sl-text-xs);
		}
	}
</style>
