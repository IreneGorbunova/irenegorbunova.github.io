<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);

	/**
	 * A liquid-damped compass needle: θ'' = −w²·(B/B_E)·sin(θ − φ) − γ·θ'. `field(t)` gives the field in units of the
	 * Earth's horizontal field as [bx, by] (screen axes). The state follows the scene time; a jump back restarts it.
	 */
	const needle = (theta0: number, period: number, zeta: number, field: (t: number) => [number, number]) => {
		const w = (2 * Math.PI) / period;
		const gamma = 2 * zeta * w;
		const DT = 1 / 600;
		let th = theta0;
		let om = 0;
		let last = 0;
		return (t: number) => {
			if (t < last - 1e-9) {
				th = theta0;
				om = 0;
				last = 0;
			}
			while (last < t) {
				const h = Math.min(DT, t - last);
				const [bx, by] = field(last);
				const b = Math.hypot(bx, by);
				const phi = Math.atan2(by, bx);
				om += (-w * w * b * Math.sin(th - phi) - gamma * om) * h;
				th += om * h;
				last += h;
			}
			return th;
		};
	};

	// a small seeded random generator, so the sparks are the same in every run
	const rng = (seed: number) => () => {
		seed = (seed * 16807) % 2147483647;
		return (seed - 1) / 2147483646;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-fieldintro]')) {
		// Weld: two welds, 1,0–3,2 s and 4,4–6,0 s of an 8 s run; north is +x in the inset, east is +y (towards us)
		{
			const card = root.querySelector<HTMLElement>('[data-scene="weld"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const live = $<SVGPathElement>('[data-live]');
			const band = $<SVGRectElement>('[data-band]');
			const arc = $<SVGCircleElement>('[data-arc]');
			const flash = $<SVGCircleElement>('[data-flash]');
			const arm = $<SVGGElement>('[data-arm]');
			const sparksG = $<SVGGElement>('[data-sparks]');
			const ndl = $<SVGGElement>('[data-needle]');
			const RUN = 8;
			const WELDS: [number, number][] = [
				[1.0, 3.2],
				[4.4, 6.0],
			];
			const on = (t: number) => WELDS.some(([a, b]) => t >= a && t < b);
			const RATIO = 60;
			const theta = needle(0, 0.9, 0.45, (t) => [1, on(t) ? RATIO : 0]);
			// sparks: born during the welds at the arc, fly as projectiles, die on the ground (y = 196) or after 0,8 s
			const G = 9.8 * 62; // px/s²
			const R = rng(20261112);
			const sparks: { t0: number; vx: number; vy: number }[] = [];
			for (const [a, b] of WELDS) {
				for (let t0 = a + 0.02; t0 < b - 0.05; t0 += 0.045) {
					const ang = -Math.PI * (0.1 + 0.85 * R());
					const v = 60 + 130 * R();
					sparks.push({ t0, vx: v * Math.cos(ang) * (R() < 0.7 ? -1 : 1), vy: v * Math.sin(ang) });
				}
			}
			const lines = sparks.map(() => {
				const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
				sparksG.appendChild(l);
				return l;
			});
			const AX = 300;
			const AY = 115;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const isOn = on(t);
				live.style.opacity = isOn ? '1' : '0';
				band.style.opacity = isOn ? '1' : '0';
				// the electrode touches the joint during a weld and is lifted 5 px between welds
				const near = WELDS.reduce((m, [a, b]) => Math.max(m, smooth(a - 0.35, a, t) - smooth(b, b + 0.35, t)), 0);
				arm.setAttribute('transform', `translate(${f1(-3 * (1 - near))} ${f1(-5 * (1 - near))})`);
				const flick = isOn ? 0.75 + 0.25 * Math.sin(t * 53) * Math.sin(t * 31) : 0;
				arc.style.opacity = isOn ? '1' : '0';
				arc.setAttribute('r', f1(3 + 2 * flick));
				flash.style.opacity = isOn ? (0.18 + 0.1 * flick).toFixed(2) : '0';
				sparks.forEach((s, i) => {
					const a = t - s.t0;
					const l = lines[i];
					const y = AY + s.vy * a + 0.5 * G * a * a;
					if (a < 0 || a > 0.8 || y > 196) {
						l.style.display = 'none';
						return;
					}
					const px = AX + s.vx * a;
					const vyt = s.vy + G * a;
					const k = 0.025; // streak = the path of the last 25 ms
					l.style.display = '';
					l.setAttribute('x1', f1(px));
					l.setAttribute('y1', f1(y));
					l.setAttribute('x2', f1(px - s.vx * k));
					l.setAttribute('y2', f1(y - vyt * k));
				});
				ndl.setAttribute('transform', `rotate(${f1((theta(t) * 180) / Math.PI)})`);
			});
		}

		// Coil: north is −y; current on 0,8–2,8 s (needle to the coil, west), the battery turned over 3,4–4,4 s, on again
		// 5,0–7,0 s (east), turned back 7,6–8,6 s; a 9,5 s run
		{
			const card = root.querySelector<HTMLElement>('[data-scene="coil"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const turns = $<SVGGElement>('[data-turns]');
			const battery = $<SVGGElement>('[data-battery]');
			const face = $<SVGRectElement>('[data-face]');
			const signA = $<SVGTextElement>('[data-sign-a]');
			const signB = $<SVGTextElement>('[data-sign-b]');
			const leadA = $<SVGPathElement>('[data-lead-a]');
			const leadB = $<SVGPathElement>('[data-lead-b]');
			const ndl = $<SVGGElement>('[data-needle2]');
			const RUN = 9.5;
			const ON: [number, number, number][] = [
				[0.8, 2.8, -1],
				[5.0, 7.0, 1],
			];
			const sign = (t: number) => ON.reduce((s, [a, b, d]) => (t >= a && t < b ? d : s), 0);
			const RATIO = 3;
			// θ from north (up) towards east (clockwise on the screen); the field as [north, east] in units of the Earth's
			const theta = needle(0, 0.6, 0.45, (t) => [1, RATIO * sign(t)]);
			const CX = 180; // the battery turns over about its middle
			const lead = (x0: number, x1: number, y1: number) => `M ${x0} 126 C ${x0} 150 ${f1(x1)} ${f1(y1 - 22)} ${f1(x1)} ${f1(y1)}`;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the battery: scaleX 1 → −1 → 1
				const flip = smooth(3.4, 4.4, t) - smooth(7.6, 8.6, t);
				const sx = Math.cos(Math.PI * flip);
				battery.setAttribute('transform', `translate(${CX} 0) scale(${sx.toFixed(3)} 1) translate(${-CX} 0)`);
				face.classList.toggle('is-back', sx < 0);
				const back = sx < 0;
				// signs: «+» by the short tab, «−» by the long one, shown when the battery lies flat
				signA.textContent = back ? '−' : '+';
				signB.textContent = back ? '+' : '−';
				const so = Math.abs(sx) > 0.6 ? '1' : '0';
				signA.style.opacity = so;
				signB.style.opacity = so;
				// the leads: down on the tabs while the current flows, lifted 12 px otherwise
				const down = ON.reduce((m, [a, b]) => Math.max(m, smooth(a - 0.3, a, t) - smooth(b, b + 0.3, t)), 0);
				const lift = 12 * (1 - down);
				// tab tops: short tab 165, long tab 157; after turning over the long one is on the left
				const topL = back ? 157 : 165;
				const topR = back ? 165 : 157;
				leadA.setAttribute('d', lead(137, 163, topL - lift));
				leadB.setAttribute('d', lead(223, 197, topR - lift));
				const isOn = sign(t) !== 0;
				turns.classList.toggle('is-on', isOn);
				leadA.classList.toggle('is-on', isOn);
				leadB.classList.toggle('is-on', isOn);
				ndl.setAttribute('transform', `rotate(${f1((theta(t) * 180) / Math.PI)})`);
			});
		}
	}
</script>
