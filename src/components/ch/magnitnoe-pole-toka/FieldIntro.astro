---
/**
 * Two short looping opening scenes of «Магнитное поле тока». No terms in the captions: the scenes show what one
 * sees; the popovers explain.
 * Weld: a compass lies on the electrode cable of a DC welding machine (inverter, about 100 A). The cable runs from
 *   south to north (left to right); the magnified inset shows the compass from above, north to the right. While the
 *   arc burns, the field of the current (about 1,2 mT two centimetres above the cable, ~75 times the horizontal field
 *   of the Earth, ratio taken as 60) turns the needle across the cable (east, towards the viewer); when the welder
 *   lifts the electrode the current stops and the needle returns to north. Two welds. Sparks fly as projectiles with
 *   g = 9,8 m/s² at 62 px/m (the welder is ~1,75 m tall).
 * MRI: a hospital MRI room in side view, 60 px/m, floor at y = 214. Left, behind the wall, the corridor with the sign
 *   «Сильное магнитное поле» by the door and a cabinet with a tray. The scanner is a ring lying on its side (outer
 *   diameter 2,1 m, bore 0,73 m, length 1,5 m), its cover drawn half transparent so that the coil of superconducting
 *   wire inside is seen (no iron core: only turns of wire around the bore; the current in them is always on, so the
 *   turns always glow). A nurse puts her keys and watch into the tray, walks in, holds a steel paper clip on a thread
 *   near the bore: the clip is pulled into the bore and the thread tilts (a pendulum of 0,27 m with g = 9,8 m/s², the
 *   hand's accelerations and a pull growing as 1/d⁴ near the entrance, up to ~0,85 of the clip's weight, ~33° tilt);
 *   then the table slides the patient into the bore head first (1,3 m in 4 s).
 * Weld needle: a damped pendulum in the total field, θ'' = −ω²(B/B_E)·sin(θ − φ) − γθ' (liquid-filled compass),
 * integrated in steps of 1/600 s, so a strong field snaps the needle round fast and the Earth's field brings it back
 * slowly.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const TURNS = Array.from({ length: 13 }, (_, i) => 258 + i * 6);
const TICKS = Array.from({ length: 12 }, (_, i) => (i * Math.PI) / 6);
---

<IntroFrame data-fieldintro>
	<div class="intro__card" data-scene="weld">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Сварщик приваривает перекладину к столбу забора. На проводе сварочного аппарата лежит компас; в круге он показан крупно, сверху. Пока горит сварка, стрелка компаса смотрит поперёк провода, а когда сварка останавливается — снова на север">
			<rect class="fi-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="fi-ground" x="0" y="196" width="360" height="44"></rect>
			<rect class="fi-ground fi-ground--near" x="0" y="212" width="360" height="28"></rect>
			<!-- the light of the arc -->
			<circle class="fi-flash" cx="300" cy="114" r="70" data-flash></circle>
			<!-- the fence: two posts and the bar being welded to the right post -->
			<rect class="fi-steel" x="196" y="78" width="9" height="120"></rect>
			<rect class="fi-steel" x="300" y="64" width="10" height="134"></rect>
			<rect class="fi-steel" x="205" y="111" width="95" height="6"></rect>
			<!-- the welding machine and the cable to the clamp on the post -->
			<path class="fi-cable fi-cable--back" d="M 70 192 C 120 202 220 200 300 194"></path>
			<rect class="fi-clamp" x="297" y="187" width="16" height="7" rx="2"></rect>
			<rect class="fi-box" x="18" y="150" width="62" height="46" rx="4"></rect>
			<path class="fi-handle" d="M 32 150 V 142 H 66 V 150"></path>
			<circle class="fi-dial" cx="36" cy="170" r="7"></circle>
			<line class="fi-dial-hand" x1="36" y1="170" x2="40" y2="165"></line>
			<rect class="fi-slot" x="52" y="164" width="20" height="4" rx="1"></rect>
			<rect class="fi-slot" x="52" y="174" width="20" height="4" rx="1"></rect>
			<!-- the electrode cable: from the machine along the ground, under the compass, up to the holder -->
			<path class="fi-cable" d="M 78 188 C 96 204 104 222 130 222 L 236 222 C 268 222 280 200 284 136" data-cable></path>
			<path class="fi-cable fi-cable--live" d="M 78 188 C 96 204 104 222 130 222 L 236 222 C 268 222 280 200 284 136" data-live></path>
			<!-- the compass on the cable -->
			<ellipse class="fi-case" cx="160" cy="216" rx="14" ry="4.5"></ellipse>
			<rect class="fi-case" x="146" y="216" width="28" height="3"></rect>
			<!-- the welder -->
			<g class="fi-welder">
				<path class="fi-leg" d="M 238 168 L 232 214 M 250 168 L 258 214"></path>
				<path class="fi-boot" d="M 224 214 h 12 v -5 h -9 z M 254 214 h 13 l -2 -5 h -11 z"></path>
				<rect class="fi-jacket" x="230" y="118" width="28" height="54" rx="8"></rect>
				<rect class="fi-head" x="234" y="96" width="20" height="22" rx="7"></rect>
				<path class="fi-mask" d="M 248 94 h 10 q 4 0 4 4 v 20 q 0 4 -4 4 h -10 z"></path>
				<rect class="fi-visor" x="256" y="102" width="4" height="7" rx="1"></rect>
			</g>
			<!-- the arm with the holder; lifted a little between welds -->
			<g data-arm>
				<path class="fi-arm" d="M 250 128 Q 266 140 280 128"></path>
				<rect class="fi-glove" x="276" y="121" width="12" height="11" rx="4"></rect>
				<rect class="fi-holder" x="283" y="123" width="9" height="5" rx="2" transform="rotate(-30 287 125)"></rect>
				<line class="fi-electrode" x1="290" y1="122" x2="299" y2="116"></line>
			</g>
			<circle class="fi-arc" cx="300" cy="115" r="4" data-arc></circle>
			<g class="fi-sparks" data-sparks></g>
			<!-- the inset: the compass on the cable seen from above, north to the right -->
			<line class="fi-pointer" x1="96" y1="104" x2="152" y2="212"></line>
			<g transform="translate(64 66)">
				<circle class="fi-inset" r="46"></circle>
				<rect class="fi-band" x="-45" y="-7" width="90" height="14"></rect>
				<rect class="fi-band fi-band--live" x="-45" y="-7" width="90" height="14" data-band></rect>
				<circle class="fi-dialface" r="31"></circle>
				{TICKS.map((a) => <line class="fi-tick" x1={(27 * Math.cos(a)).toFixed(1)} y1={(27 * Math.sin(a)).toFixed(1)} x2={(30 * Math.cos(a)).toFixed(1)} y2={(30 * Math.sin(a)).toFixed(1)} />)}
				<text class="fi-letter" x="23.5" y="3.5">С</text>
				<g data-needle>
					<path class="fi-n" d="M 18 0 L 0 -4 L 0 4 Z"></path>
					<path class="fi-s" d="M -18 0 L 0 -4 L 0 4 Z"></path>
				</g>
				<circle class="fi-pin" r="2"></circle>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Компас положили прямо на провод сварочного аппарата. Пока сварщик варит, стрелка <More term="отворачивается от севера и встаёт поперёк провода">Сварочный аппарат (инвертор) пропускает по проводу ток около 100 А, и направление этого тока не меняется. Вокруг провода с током есть <b>магнитное поле</b>, и у самого провода оно в десятки раз сильнее магнитного поля Земли — оно и поворачивает стрелку. Сварщик отводит электрод, ток прекращается, и стрелку снова поворачивает к северу поле Земли. Подробно — в разделе <a href="#магнитное-поле-прямого-тока">«Магнитное поле прямого тока»</a>.</More>, а когда он останавливается, снова показывает на север.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="mri">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Больница, кабинет МРТ. У двери висит знак «Сильное магнитное поле». Медсестра оставляет ключи и часы в лотке за дверью, входит и подносит к аппарату скрепку на нитке — скрепка тянется внутрь аппарата. Аппарат — большое кольцо; сквозь кожух видны витки провода, по которым идёт ток. Стол с пациентом медленно въезжает в отверстие кольца">
			<!-- the corridor, the scanner room, the floor -->
			<rect class="mr-hall" x="0" y="0" width="86" height="240"></rect>
			<rect class="mr-room" x="86" y="0" width="274" height="240"></rect>
			<rect class="mr-floor" x="0" y="214" width="360" height="26"></rect>
			<line class="mr-floorline" x1="0" y1="214" x2="360" y2="214"></line>
			<!-- ceiling lights -->
			<rect class="mr-lamp" x="150" y="0" width="56" height="4"></rect>
			<rect class="mr-lamp" x="262" y="0" width="56" height="4"></rect>
			<!-- the window of the control room -->
			<rect class="mr-window" x="104" y="36" width="72" height="50" rx="2"></rect>
			<path class="mr-glare" d="M 114 78 L 136 44 M 126 80 L 144 52"></path>
			<!-- the wall between the corridor and the room, cut through above the doorway -->
			<rect class="mr-lintel" x="80" y="0" width="10" height="86"></rect>
			<path class="mr-jamb" d="M 80 86 V 214 M 90 86 V 214"></path>
			<!-- the sign by the door -->
			<g class="mr-sign">
				<rect class="mr-plate" x="20" y="20" width="54" height="68" rx="3"></rect>
				<path class="mr-tri" d="M 47 26 L 64 55 H 30 Z"></path>
				<path class="mr-magnet" d="M 43 39 V 45 A 4 4 0 0 0 51 45 V 39"></path>
				<path class="mr-pole" d="M 43 38 V 41.5"></path>
				<path class="mr-pole mr-pole--s" d="M 51 38 V 41.5"></path>
				<text x="47" y="66">СИЛЬНОЕ</text>
				<text x="47" y="75">МАГНИТНОЕ</text>
				<text x="47" y="84">ПОЛЕ</text>
			</g>
			<!-- the cabinet with the tray in the corridor -->
			<rect class="mr-cabinet" x="8" y="158" width="40" height="56" rx="2"></rect>
			<path class="mr-drawer" d="M 12 178 H 44 M 12 196 H 44 M 25 168 H 31 M 25 187 H 31 M 25 205 H 31"></path>
			<!-- the scanner, back part: the cover, the front face of the ring, the bore, the far halves of the turns -->
			<path class="mr-body" d="M 244 88 H 336 A 15 63 0 0 1 336 214 H 244 A 15 63 0 0 1 244 88 Z"></path>
			<ellipse class="mr-face" cx="244" cy="151" rx="15" ry="63"></ellipse>
			<path class="mr-tunnel" d="M 244 129 H 336 A 6 22 0 0 1 336 173 H 244 Z"></path>
			<ellipse class="mr-tunnel" cx="244" cy="151" rx="6" ry="22"></ellipse>
			<g class="mr-turns mr-turns--back">
				{TURNS.map((x) => <path d={`M ${x} 191 A 9.5 40 0 0 1 ${x} 111`} />)}
			</g>
			<!-- the nurse (local: x = 0 at her middle, facing +x; turned by the script) -->
			<g data-nurse>
				<g data-leg1>
					<path class="mr-pants" d="M 0 168 V 209"></path>
					<path class="mr-shoe" d="M -3 208 H 6 Q 9 208 9 211 V 213 H -3 Z"></path>
				</g>
				<rect class="mr-scrubs" x="-9" y="129" width="19" height="43" rx="7"></rect>
				<rect class="mr-skin" x="-7" y="114" width="15" height="18" rx="7"></rect>
				<path class="mr-scrubs" d="M -7.6 122 Q -8 113 0.5 112.5 Q 9 113 8.6 122 Z"></path>
				<circle class="mr-eye" cx="5" cy="125" r="0.9"></circle>
				<g data-leg2>
					<path class="mr-pants" d="M 0 168 V 209"></path>
					<path class="mr-shoe" d="M -3 208 H 6 Q 9 208 9 211 V 213 H -3 Z"></path>
				</g>
				<path class="mr-sleeve" d="" data-upper></path>
				<path class="mr-forearm" d="" data-fore></path>
				<circle class="mr-skin" r="2.8" data-hand></circle>
			</g>
			<!-- the steel paper clip on a thread -->
			<g data-clipset>
				<line class="mr-thread" data-thread></line>
				<g data-clip>
					<path class="mr-clip" d="M -1.7 0.6 V 7.4 A 1.7 1.7 0 0 0 1.7 7.4 V 1.6 A 1.2 1.2 0 0 0 -0.7 1.6 V 6.2"></path>
				</g>
			</g>
			<!-- the keys and the watch -->
			<path class="mr-tray" d="M 13 151 L 16 158 H 44 L 47 151"></path>
			<g data-keys>
				<circle class="mr-steel" r="2.2"></circle>
				<path class="mr-steel" d="M 2 0.4 H 8 M 6.5 0.4 V 2.4 M 4.8 0.4 V 2"></path>
			</g>
			<g data-watch>
				<rect class="mr-strap" x="-1.4" y="-4.6" width="2.8" height="9.2" rx="1"></rect>
				<circle class="mr-watchface" r="2.5"></circle>
			</g>
			<!-- the table: the stand stays, the couch with the patient slides -->
			<path class="mr-stand" d="M 142 172 L 208 172 L 202 209 L 148 209 Z"></path>
			<rect class="mr-stand" x="136" y="208" width="78" height="6" rx="2"></rect>
			<rect class="mr-rail" x="112" y="168" width="124" height="4" rx="1.5"></rect>
			<g data-couch>
				<rect class="mr-couch" x="104" y="162" width="132" height="6" rx="3"></rect>
				<ellipse class="mr-pillow" cx="216" cy="161" rx="10" ry="2.8"></ellipse>
				<path class="mr-blanket" d="M 118 162 C 118 152 122 148 127 149 C 131 150 132 155 138 156 C 160 156 170 153 184 151 C 196 150 204 151 207 155 L 207 162 Z"></path>
				<circle class="mr-skin" cx="215" cy="155.5" r="6.8"></circle>
				<path class="mr-hair" d="M 213.5 148.9 A 6.8 6.8 0 0 1 221.6 157.5 Q 219 151.5 213.5 148.9 Z"></path>
				<circle class="mr-eye" cx="213" cy="152" r="0.9"></circle>
			</g>
			<!-- the scanner, near part: the half-transparent cover and the near halves of the turns -->
			<path class="mr-cover" d="M 244 88 H 336 A 15 63 0 0 1 336 214 H 244 A 15 63 0 0 0 244 88 Z"></path>
			<path class="mr-cover mr-cover--face" fill-rule="evenodd" d="M 244 88 A 15 63 0 0 1 244 214 Z M 244 129 A 6 22 0 0 1 244 173 Z"></path>
			<g class="mr-turns mr-turns--glow">
				{TURNS.map((x) => <path d={`M ${x} 111 A 9.5 40 0 0 1 ${x} 191`} />)}
			</g>
			<g class="mr-turns">
				{TURNS.map((x) => <path d={`M ${x} 111 A 9.5 40 0 0 1 ${x} 191`} />)}
			</g>
			<path class="mr-outline" d="M 244 88 H 336 A 15 63 0 0 1 336 214 H 244"></path>
			<ellipse class="mr-outline" cx="244" cy="151" rx="15" ry="63"></ellipse>
			<ellipse class="mr-outline mr-outline--thin" cx="244" cy="151" rx="6" ry="22"></ellipse>
		</svg>
		<div class="intro__foot">
			<p>Аппарат МРТ в больнице — огромная катушка, по которой идёт ток. Ключи и часы оставляют за дверью: <More term="железо катушка притягивает с огромной силой">Внутри такой катушки очень сильное <b>магнитное поле</b> — в 30–60 тысяч раз сильнее магнитного поля Земли. Провод катушки — сверхпроводник: его охлаждают жидким гелием почти до −269 °C, и тогда ток идёт по нему, совсем не нагревая провод. Поэтому ток в катушке не выключают, и поле есть всегда, даже ночью. Железные вещи катушка втягивает внутрь, как снаряды: маленькая скрепка разгоняется до 65 км/ч. Подробнее — в разделе <a href="#магнитное-поле-катушки-с-током">«Магнитное поле катушки с током»</a>.</More>, даже скрепка на нитке тянется к ней.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-fieldintro] {
		--fi-sky: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-6));
		--fi-ground: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-5));
		--fi-steel: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
		--fi-jacket: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-4));
		--mr-hall: color-mix(in srgb, var(--ig-v) 9%, var(--sl-color-gray-5));
		--mr-room: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-6));
		--mr-floor: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-5));
		--mr-body: color-mix(in srgb, var(--sl-color-gray-2) 32%, var(--sl-color-gray-5));
		--mr-face: color-mix(in srgb, var(--sl-color-gray-2) 48%, var(--sl-color-gray-5));
		--mr-tunnel: color-mix(in srgb, var(--ig-v) 14%, var(--sl-color-gray-3));
		--mr-plate: var(--sl-color-gray-2);
		--mr-ink: var(--sl-color-black);
		--mr-scrubs: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-gray-4));
		--mr-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--mr-blanket: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-gray-3));
		--mr-lamp: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-2));
	}
	:root[data-theme='light'] [data-fieldintro] {
		--fi-sky: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-7, #fff));
		--fi-ground: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-6));
		--fi-steel: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-4));
		--fi-jacket: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-5));
		--mr-hall: color-mix(in srgb, var(--ig-v) 9%, var(--sl-color-gray-6));
		--mr-room: color-mix(in srgb, var(--ig-vx) 6%, var(--sl-color-gray-7, #fff));
		--mr-floor: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-5));
		--mr-body: var(--sl-color-gray-7, #fff);
		--mr-face: color-mix(in srgb, var(--sl-color-gray-5) 45%, var(--sl-color-gray-7, #fff));
		--mr-tunnel: color-mix(in srgb, var(--ig-v) 10%, var(--sl-color-gray-5));
		--mr-plate: var(--sl-color-gray-7, #fff);
		--mr-ink: var(--sl-color-gray-1);
		--mr-scrubs: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-gray-5));
		--mr-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--mr-blanket: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-gray-5));
		--mr-lamp: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-7, #fff));
	}
	.fi-sky {
		fill: var(--fi-sky);
	}
	.fi-ground {
		fill: var(--fi-ground);
	}
	.fi-ground--near {
		fill: color-mix(in srgb, var(--fi-ground) 80%, var(--sl-color-gray-4));
	}
	.fi-flash {
		fill: var(--ig-v);
		opacity: 0;
		filter: blur(18px);
	}
	.fi-steel {
		fill: var(--fi-steel);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.fi-box {
		fill: color-mix(in srgb, var(--ig-vy) 35%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.fi-handle {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.fi-dial {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.fi-dial-hand {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.fi-slot {
		fill: var(--sl-color-gray-2);
	}
	.fi-cable {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3.2;
		stroke-linecap: round;
	}
	.fi-cable--back {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.6;
	}
	.fi-cable--live {
		stroke: var(--ig-v);
		opacity: 0;
	}
	.fi-clamp {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.fi-case {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 60%, var(--ig-surface));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.fi-leg {
		fill: none;
		stroke: color-mix(in srgb, var(--fi-jacket) 70%, var(--sl-color-gray-3));
		stroke-width: 9;
		stroke-linecap: round;
	}
	.fi-boot {
		fill: var(--sl-color-gray-2);
	}
	.fi-jacket {
		fill: var(--fi-jacket);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.fi-head {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.fi-mask {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
