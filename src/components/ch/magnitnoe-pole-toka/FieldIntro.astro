</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);

	/**
	 * A liquid-damped compass needle: θ'' = −w²·(B/B_E)·sin(θ − φ) − γ·θ'. `field(t)` gives the field in units of the
	 * Earth's horizontal field as [bx, by] (screen axes). The state follows the scene time; a jump back restarts it.
	 */
	const needle = (theta0: number, period: number, zeta: number, field: (t: number) => [number, number]) => {
		const w = (2 * Math.PI) / period;
		const gamma = 2 * zeta * w;
		const DT = 1 / 600;
		let th = theta0;
		let om = 0;
		let last = 0;
		return (t: number) => {
			if (t < last - 1e-9) {
				th = theta0;
				om = 0;
				last = 0;
			}
			while (last < t) {
				const h = Math.min(DT, t - last);
				const [bx, by] = field(last);
				const b = Math.hypot(bx, by);
				const phi = Math.atan2(by, bx);
				om += (-w * w * b * Math.sin(th - phi) - gamma * om) * h;
				th += om * h;
				last += h;
			}
			return th;
		};
	};

	// a small seeded random generator, so the sparks are the same in every run
	const rng = (seed: number) => () => {
		seed = (seed * 16807) % 2147483647;
		return (seed - 1) / 2147483646;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-fieldintro]')) {
		// Weld: two welds, 1,0–3,2 s and 4,4–6,0 s of an 8 s run; north is +x in the inset, east is +y (towards us)
		{
			const card = root.querySelector<HTMLElement>('[data-scene="weld"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const live = $<SVGPathElement>('[data-live]');
			const band = $<SVGRectElement>('[data-band]');
			const arc = $<SVGCircleElement>('[data-arc]');
			const flash = $<SVGCircleElement>('[data-flash]');
			const arm = $<SVGGElement>('[data-arm]');
			const sparksG = $<SVGGElement>('[data-sparks]');
			const ndl = $<SVGGElement>('[data-needle]');
			const RUN = 8;
			const WELDS: [number, number][] = [
				[1.0, 3.2],
				[4.4, 6.0],
			];
			const on = (t: number) => WELDS.some(([a, b]) => t >= a && t < b);
			const RATIO = 60;
			const theta = needle(0, 0.9, 0.45, (t) => [1, on(t) ? RATIO : 0]);
			// sparks: born during the welds at the arc, fly as projectiles, die on the ground (y = 196) or after 0,8 s
			const G = 9.8 * 62; // px/s²
			const R = rng(20261112);
			const sparks: { t0: number; vx: number; vy: number }[] = [];
			for (const [a, b] of WELDS) {
				for (let t0 = a + 0.02; t0 < b - 0.05; t0 += 0.045) {
					const ang = -Math.PI * (0.1 + 0.85 * R());
					const v = 60 + 130 * R();
					sparks.push({ t0, vx: v * Math.cos(ang) * (R() < 0.7 ? -1 : 1), vy: v * Math.sin(ang) });
				}
			}
			const lines = sparks.map(() => {
				const l = document.createElementNS('http://www.w3.org/2000/svg', 'line');
				sparksG.appendChild(l);
				return l;
			});
			const AX = 300;
			const AY = 115;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const isOn = on(t);
				live.style.opacity = isOn ? '1' : '0';
				band.style.opacity = isOn ? '1' : '0';
				// the electrode touches the joint during a weld and is lifted 5 px between welds
				const near = WELDS.reduce((m, [a, b]) => Math.max(m, smooth(a - 0.35, a, t) - smooth(b, b + 0.35, t)), 0);
				arm.setAttribute('transform', `translate(${f1(-3 * (1 - near))} ${f1(-5 * (1 - near))})`);
				const flick = isOn ? 0.75 + 0.25 * Math.sin(t * 53) * Math.sin(t * 31) : 0;
				arc.style.opacity = isOn ? '1' : '0';
				arc.setAttribute('r', f1(3 + 2 * flick));
				flash.style.opacity = isOn ? (0.18 + 0.1 * flick).toFixed(2) : '0';
				sparks.forEach((s, i) => {
					const a = t - s.t0;
					const l = lines[i];
					const y = AY + s.vy * a + 0.5 * G * a * a;
					if (a < 0 || a > 0.8 || y > 196) {
						l.style.display = 'none';
						return;
					}
					const px = AX + s.vx * a;
					const vyt = s.vy + G * a;
					const k = 0.025; // streak = the path of the last 25 ms
					l.style.display = '';
					l.setAttribute('x1', f1(px));
					l.setAttribute('y1', f1(y));
					l.setAttribute('x2', f1(px - s.vx * k));
					l.setAttribute('y2', f1(y - vyt * k));
				});
				ndl.setAttribute('transform', `rotate(${f1((theta(t) * 180) / Math.PI)})`);
			});
		}

		// MRI: 60 px/m, floor y = 214. Keys and watch into the tray 0,5–2,4 s, turn 2,45–2,85 s, walk 2,9–5,5 s
		// (2,3 m), the clip near the bore 5,6–9,8 s, the table slides in 9,9–13,9 s; a 14,2 s run
		{
			const card = root.querySelector<HTMLElement>('[data-scene="mri"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const nurse = $<SVGGElement>('[data-nurse]');
			const leg1 = $<SVGGElement>('[data-leg1]');
			const leg2 = $<SVGGElement>('[data-leg2]');
			const upper = $<SVGPathElement>('[data-upper]');
			const fore = $<SVGPathElement>('[data-fore]');
			const hand = $<SVGCircleElement>('[data-hand]');
			const clipset = $<SVGGElement>('[data-clipset]');
			const thread = $<SVGLineElement>('[data-thread]');
			const clip = $<SVGGElement>('[data-clip]');
			const keys = $<SVGGElement>('[data-keys]');
			const watch = $<SVGGElement>('[data-watch]');
			const couch = $<SVGGElement>('[data-couch]');
			const RUN = 14.2;
			const G = 9.8 * 60; // px/s²
			type P2 = [number, number];
			const mix = (a: P2, b: P2, k: number): P2 => [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k];
			// a walk from t0 to t1 with speed-up and slow-down of r s: [share of the way, speed / top speed]
			const ramp = (t: number, t0: number, t1: number, r: number): P2 => {
				const T = t1 - t0;
				const v = 1 / (T - r);
				const u = t - t0;
				if (u <= 0) return [0, 0];
				if (u >= T) return [1, 0];
				if (u < r) return [(0.5 * v * u * u) / r, u / r];
				if (u < T - r) return [v * (u - r / 2), 1];
				return [1 - (0.5 * v * (T - u) * (T - u)) / r, (T - u) / r];
			};
			const X0 = 60;
			const X1 = 200;
			const GAIT = 110; // px per two steps
			const SHOULDER: P2 = [1, 136];
			const REST: P2 = [6, 165];
			const TRAY: P2 = [28, 150];
			const UP1: P2 = [22, 119];
			const UP2: P2 = [28, 119];
			const pose = (t: number) => {
				const [s, mv] = ramp(t, 2.9, 5.5, 0.5);
				const x = X0 + (X1 - X0) * s;
				const ph = (2 * Math.PI * (X1 - X0) * s) / GAIT;
				const sx = -Math.cos(Math.PI * smooth(2.45, 2.85, t));
				const bob = -1.4 * Math.cos(ph) ** 2 * mv;
				let h = mix(REST, TRAY, smooth(0.5, 1.3, t) - smooth(1.8, 2.4, t));
				const up = smooth(5.6, 6.3, t) - smooth(9.2, 9.8, t);
				if (up > 0) h = mix(REST, mix(UP1, UP2, smooth(6.5, 7.6, t) - smooth(8.6, 9.2, t)), up);
				h = [h[0] + 3.5 * Math.sin(ph) * mv, h[1]];
				return { x, sx, bob, leg: 0.38 * Math.sin(ph) * mv, h };
			};
			const handAt = (t: number): P2 => {
				const p = pose(t);
				return [p.x + p.sx * p.h[0], p.h[1] + p.bob];
			};
			// the clip: a pendulum of L = 16 px (0,27 m) on the moving hand; the pull of the magnet points into the bore
			// and grows as 1/d⁴ (d from where the clip would hang to the middle of the entrance), as a share of its weight
			const L = 16;
			const GAM = 2;
			const DT = 1 / 600;
			let th = 0;
			let om = 0;
			let last = 0;
			const swing = (t: number) => {
				if (t < last - 1e-9) {
					th = 0;
					om = 0;
					last = 0;
				}
				while (last < t) {
					const h = Math.min(DT, t - last);
					const [px, py] = handAt(last);
					const [x0, y0] = handAt(last - DT);
					const [x1, y1] = handAt(last + DT);
					const ax = (x1 - 2 * px + x0) / (DT * DT);
					const ay = (y1 - 2 * py + y0) / (DT * DT);
					const qy = py + L;
					const f = Math.min(1.5, (22.3 / Math.hypot(px - 244, qy - 151)) ** 4);
					const ux = 280 - px;
					const uy = 151 - qy;
					const un = Math.hypot(ux, uy);
					const gx = (f * G * ux) / un - ax;
					const gy = G + (f * G * uy) / un - ay;
					om += ((gx * Math.cos(th) - gy * Math.sin(th)) / L - GAM * om) * h;
					th += om * h;
					last += h;
				}
				return th;
			};
			// a two-part arm from the shoulder to the hand, the elbow bent down
			const arm = (hx: number, hy: number) => {
				const [sx0, sy0] = SHOULDER;
				const dx = hx - sx0;
				const dy = hy - sy0;
				const d = Math.min(Math.hypot(dx, dy), 33.6);
				let nx = -dy / d;
				let ny = dx / d;
				if (ny < 0 || (Math.abs(ny) < 1e-6 && nx > 0)) {
					nx = -nx;
					ny = -ny;
				}
				const k = Math.sqrt(Math.max(0, 17 * 17 - (d / 2) ** 2));
				const ex = sx0 + dx / 2 + nx * k;
				const ey = sy0 + dy / 2 + ny * k;
				upper.setAttribute('d', `M ${sx0} ${sy0} L ${f1(ex)} ${f1(ey)}`);
				fore.setAttribute('d', `M ${f1(ex)} ${f1(ey)} L ${f1(hx)} ${f1(hy)}`);
				hand.setAttribute('cx', f1(hx));
				hand.setAttribute('cy', f1(hy));
			};
			const DROP = 1.45;
			const item = (el: SVGGElement, dx: number, t: number) => {
				const [hx, hy] = handAt(Math.min(t, DROP));
				const a = Math.max(0, t - DROP);
				const y = Math.min(154.5, hy + 3 + 0.5 * G * a * a);
				el.setAttribute('transform', `translate(${f1(hx + dx)} ${f1(y)}) scale(1.25)`);
			};
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const p = pose(t);
				nurse.setAttribute('transform', `translate(${f1(p.x)} ${f1(p.bob)}) scale(${p.sx.toFixed(3)} 1)`);
				const deg = (p.leg * 180) / Math.PI;
				leg1.setAttribute('transform', `rotate(${f1(deg)} 0 168)`);
				leg2.setAttribute('transform', `rotate(${f1(-deg)} 0 168)`);
				arm(p.h[0], p.h[1]);
				item(keys, -4, t);
				item(watch, 4, t);
				// the clip comes out of the pocket when the hand rises and goes back after
				const [hx, hy] = handAt(t);
				const a = swing(t);
				const bx = hx + L * Math.sin(a);
				const by = hy + L * Math.cos(a);
				clipset.style.opacity = (smooth(5.55, 5.85, t) - smooth(9.75, 10.05, t)).toFixed(2);
				thread.setAttribute('x1', f1(hx));
				thread.setAttribute('y1', f1(hy));
				thread.setAttribute('x2', f1(bx));
				thread.setAttribute('y2', f1(by));
				clip.setAttribute('transform', `translate(${f1(bx)} ${f1(by)}) rotate(${f1((-a * 180) / Math.PI)})`);
				couch.setAttribute('transform', `translate(${f1(78 * smooth(9.9, 13.9, t))} 0)`);
			});
		}
	}
</script>
