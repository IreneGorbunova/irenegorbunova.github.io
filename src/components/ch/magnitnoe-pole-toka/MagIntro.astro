---
/**
 * Two short looping opening scenes of «Электромагниты и их применение». No numbers and no terms: the scenes
 * show what one sees; the captions' popovers explain.
 * Crane: a scrapyard gantry crane lowers a flat disc onto a crushed car; the current is switched on (the power
 *   cable along the rope lights up), the car rises with the disc, rides over the scrap heap and, when the current is
 *   switched off, falls onto the heap. The fall is in real time: 44 px at 18,6 px/m (the car is 78 px ≈ 4,2 m long)
 *   is 2,4 m, t = √(2h/g) ≈ 0,70 s. The other motions are calm, as a crane moves.
 * Door: the steel entrance door of a block of flats is held by an electromagnetic lock over it (the magnified inset
 *   shows the electromagnet on the frame and the steel plate on the door). A hand touches the intercom reader with a
 *   key fob: the light turns green and the current stops (the wire and the winding go dark); the hand pulls the
 *   handle and the door opens; the door closer brings it back, the plate meets the electromagnet, the current is on
 *   again and the light is red.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// the scrap heap (crane scene)
const HEAP = '196,204 210,186 222,174 236,167 250,165 288,164 302,169 316,180 328,192 336,204';
const SCRAP = [
	'M 214 186 L 246 176',
	'M 226 196 L 262 184',
	'M 300 176 L 326 194',
	'M 270 190 L 300 186',
	'M 240 172 L 236 160',
];
// the door: hinge at X0, width DW, from DT to DB
const X0 = 124;
const DW = 104;
const DT = 44;
const DB = 206;
---

<IntroFrame data-mgintro>
	<div class="intro__card" data-scene="crane">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Пункт приёма металлолома. Кран опускает плоский диск на разбитую машину, машина поднимается вместе с диском, а над грудой металлолома падает с него вниз">
			<rect class="mg-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="mg-ground" x="0" y="204" width="360" height="36"></rect>
			<!-- the scrap heap -->
			<polygon class="mg-heap" points={HEAP}></polygon>
			<g class="mg-scrap">
				{SCRAP.map((d) => <path d={d} />)}
				<circle cx="312" cy="190" r="7"></circle>
				<circle cx="312" cy="190" r="3"></circle>
				<rect x="256" y="168" width="22" height="7" rx="1" transform="rotate(-8 267 171)"></rect>
			</g>
			<!-- the gantry -->
			<rect class="mg-steel" x="6" y="30" width="10" height="174"></rect>
			<rect class="mg-steel" x="344" y="30" width="10" height="174"></rect>
			<rect class="mg-steel" x="0" y="20" width="360" height="10"></rect>
			<path class="mg-truss" d="M 6 30 L 30 20 M 354 30 L 330 20"></path>
			<!-- the car -->
			<g data-car>
				<path class="mg-car" d="M -39 -6 V -18 Q -39 -21 -36 -21 H 36 Q 39 -21 39 -18 V -6 Z"></path>
				<path class="mg-car mg-car--top" d="M -24 -21 L -15 -27 L 13 -27 Q 18 -27 21 -21 Z"></path>
				<path class="mg-dent" d="M -8 -19 L -2 -13 L 6 -18 M 22 -15 L 30 -10"></path>
				<circle class="mg-wheel" cx="-24" cy="-6" r="6"></circle>
				<circle class="mg-wheel" cx="24" cy="-6" r="6"></circle>
			</g>
			<!-- the trolley, the rope, the power cable and the disc -->
			<g data-trolley>
				<rect class="mg-steel mg-trolley" x="-16" y="30" width="32" height="9" rx="2"></rect>
				<line class="mg-rope" x1="-3" y1="39" x2="-3" y2="80" data-rope></line>
				<line class="mg-cable" x1="4" y1="39" x2="4" y2="80" data-cable></line>
				<line class="mg-cable mg-cable--live" x1="4" y1="39" x2="4" y2="80" data-cable-live></line>
				<g data-disc>
					<path class="mg-cap" d="M -12 -21 H 12 L 18 -12 H -18 Z"></path>
					<rect class="mg-disc" x="-37" y="-12" width="74" height="12" rx="3"></rect>
					<rect class="mg-glow" x="-35" y="-3" width="70" height="3" rx="1.5" data-glow></rect>
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Кран опускает на разбитую машину плоский диск, поднимает её без всяких крюков, а над грудой металлолома <More term="просто отпускает">Диск — подъёмный <b>электромагнит</b>: в его стальном корпусе спрятана большая катушка из провода. Пока по ней идёт ток, диск притягивает железо и сталь. Крановщик выключает ток — и груз падает. Обычный магнит так не умеет: его не выключишь. Подробно — в разделе <a href="#подъёмный-электромагнит">«Подъёмный электромагнит»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="door">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Железная дверь подъезда с домофоном. Рука прикладывает ключ к домофону, огонёк становится зелёным, и дверь открывается. Потом дверь закрывается сама, и огонёк снова красный. В круге крупно показан замок над дверью: электромагнит и стальная пластина">
			<rect class="mg-wall" x="0" y="0" width="360" height="240"></rect>
			<g class="mg-bricks">
				{[18, 54, 90, 126, 162, 198].map((y) => <path d={`M 0 ${y} H 360`} />)}
			</g>
			<rect class="mg-porch" x="0" y="206" width="360" height="34"></rect>
			<line class="mg-porch-edge" x1="0" y1="206" x2="360" y2="206"></line>
			<!-- the wire from the intercom to the lock, in the wall -->
			<path class="mg-wire" d="M 273 96 V 24 H 206 V 34"></path>
			<path class="mg-wire mg-wire--live" d="M 273 96 V 24 H 206 V 34" data-live></path>
			<!-- the door frame and the dark doorway -->
			<rect class="mg-frame" x="116" y="34" width="120" height="172"></rect>
			<rect class="mg-doorway" x={X0} y={DT} width={DW} height={DB - DT}></rect>
			<!-- the electromagnet on the frame -->
			<rect class="mg-magnet" x="186" y="35" width="40" height="9" rx="1.5"></rect>
			<!-- the door (redrawn by the script as it turns) -->
			<polygon class="mg-door" points={`${X0},${DT} ${X0 + DW},${DT} ${X0 + DW},${DB} ${X0},${DB}`} data-door></polygon>
			<polygon class="mg-door-panel" points="" data-panel></polygon>
			<polygon class="mg-plate" points="" data-plate></polygon>
			<rect class="mg-handle" x="0" y="0" width="5" height="22" rx="2" data-handle></rect>
			<!-- the intercom -->
			<rect class="mg-panel" x="256" y="96" width="34" height="64" rx="4"></rect>
			<g class="mg-keys">
				{[0, 1, 2, 3].flatMap((r) => [0, 1, 2].map((c) => <circle cx={265 + c * 8} cy={108 + r * 7} r="2" />))}
			</g>
			<circle class="mg-reader" cx="273" cy="147" r="6.5"></circle>
			<circle class="mg-led" cx="273" cy="101" r="2.4" data-led></circle>
			<!-- the inset: the lock magnified -->
			<line class="mg-pointer" x1="80" y1="58" x2="186" y2="42"></line>
			<g transform="translate(52 64)">
				<circle class="mg-inset" r="34"></circle>
				<rect class="mg-magnet" x="-24" y="-24" width="48" height="20" rx="2"></rect>
				<g class="mg-turns" data-turns>
					{[-14, -8, -2, 4, 10, 16].map((x) => <line x1={x} y1="-22" x2={x - 4} y2="-6" />)}
				</g>
				<rect class="mg-plate" x="-22" y="-3" width="44" height="7" rx="1.5" data-iplate></rect>
			</g>
			<!-- the hand: a fist at (0, 0) with a key fob held to the left of it -->
			<g data-hand>
				<rect class="mg-sleeve" x="9" y="-8" width="300" height="16" rx="3"></rect>
				<path class="mg-fob" d="M -9 -4.5 h -7 a 4.5 4.5 0 0 0 0 9 h 7 z"></path>
				<rect class="mg-skin" x="-10" y="-8" width="21" height="16" rx="5"></rect>
				<path class="mg-line" d="M -9 -3 h 7 M -9 2 h 7"></path>
				<rect class="mg-skin" x="-6" y="-11" width="12" height="6" rx="3"></rect>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Железную дверь подъезда не открыть даже вдвоём. Но стоит приложить ключ к домофону, и дверь <More term="открывается от лёгкого рывка">Над дверью стоит электромагнитный замок: на дверной раме — <b>электромагнит</b>, на двери — стальная пластина (в круге они показаны крупно). Пока по обмотке электромагнита идёт ток, он прижимает пластину с силой около 3000–5000 Н — это вес груза массой 300–500 кг. Ключ домофона выключает ток на несколько секунд, и дверь ничто не держит. Что такое электромагнит, рассказано в разделе <a href="#электромагниты">«Электромагниты»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-mgintro] {
		--mg-sky: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-6));
		--mg-ground: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-5));
		--mg-steel: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-4));
		--mg-car: color-mix(in srgb, var(--ig-vy) 45%, var(--sl-color-gray-4));
		--mg-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--mg-wall: color-mix(in srgb, var(--ig-vy) 14%, var(--sl-color-gray-5));
		--mg-door: color-mix(in srgb, var(--ig-vx) 22%, var(--sl-color-gray-4));
	}
	:root[data-theme='light'] [data-mgintro] {
		--mg-sky: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-7, #fff));
		--mg-ground: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-6));
		--mg-steel: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-4));
		--mg-car: color-mix(in srgb, var(--ig-vy) 45%, var(--sl-color-gray-5));
		--mg-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--mg-wall: color-mix(in srgb, var(--ig-vy) 12%, var(--sl-color-gray-6));
		--mg-door: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-gray-5));
	}
	.mg-sky {
		fill: var(--mg-sky);
	}
	.mg-ground {
		fill: var(--mg-ground);
	}
	.mg-heap {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 55%, var(--mg-ground));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mg-scrap path,
	.mg-scrap circle,
	.mg-scrap rect {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.mg-steel {
		fill: var(--mg-steel);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mg-truss {
		fill: none;
		stroke: var(--mg-steel);
		stroke-width: 4;
	}
	.mg-car {
		fill: var(--mg-car);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.mg-car--top {
		fill: color-mix(in srgb, var(--mg-car) 70%, var(--sl-color-gray-5));
	}
	.mg-dent {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linecap: round;
	}
	.mg-wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.mg-rope {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.mg-cable {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.mg-cable--live {
		stroke: var(--ig-v);
		stroke-width: 2.4;
		opacity: 0;
	}
	.mg-cap {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.mg-disc {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 60%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.mg-glow {
		fill: var(--ig-v);
		opacity: 0;
	}
	/* door scene */
	.mg-wall {
		fill: var(--mg-wall);
	}
	.mg-bricks path {
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 35%, transparent);
		stroke-width: 1;
	}
	.mg-porch {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, var(--mg-wall));
	}
	.mg-porch-edge {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.mg-wire {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-dasharray: 5 4;
	}
	.mg-wire--live {
		stroke: var(--ig-v);
		stroke-width: 2.2;
		stroke-dasharray: none;
	}
	.mg-frame {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mg-doorway {
		fill: var(--sl-color-black);
	}
	.mg-door {
		fill: var(--mg-door);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.mg-door-panel {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-gray-2) 50%, transparent);
		stroke-width: 1;
	}
	.mg-magnet {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mg-plate {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 50%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.mg-handle {
		fill: var(--sl-color-gray-2);
	}
	.mg-panel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mg-keys circle {
		fill: var(--sl-color-gray-3);
	}
	.mg-reader {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.mg-led {
		fill: var(--ig-vy);
	}
	.mg-led.is-open {
		fill: hsl(140, 60%, 45%);
	}
	.mg-pointer {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.mg-inset {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.mg-turns line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.mg-turns.is-on line {
		stroke: var(--ig-v);
	}
	.mg-skin {
		fill: var(--mg-skin);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.mg-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.9;
		stroke-linecap: round;
	}
	.mg-sleeve {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mg-fob {
		fill: var(--ig-vx);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-mgintro]')) {
		// Crane: lower (→ 0,16), current on at 0,17, lift (0,22–0,40), ride (0,42–0,64), current off at 0,68,
		// free fall 44 px with g = 182 px/s² (9,8 м/с² at 18,6 px/m) — 0,70 s of the 8 s, the trolley returns.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="crane"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const car = $<SVGGElement>('[data-car]');
			const trolley = $<SVGGElement>('[data-trolley]');
			const disc = $<SVGGElement>('[data-disc]');
			const rope = $<SVGLineElement>('[data-rope]');
			const cable = $<SVGLineElement>('[data-cable]');
			const live = $<SVGLineElement>('[data-cable-live]');
			const glow = $<SVGRectElement>('[data-glow]');
			const RUN = 8;
			const G = 9.8 * 18.6; // px/s²
			const ON = 0.17;
			const OFF = 0.68;
			const LIFT = 120; // the car bottom when lifted
			const HEAP = 164; // the car bottom on the heap
			const TFALL = Math.sqrt((2 * (HEAP - LIFT)) / G) / RUN; // fraction of the run
			scene(card, RUN, (x) => {
				const go = smooth(0.42, 0.64, x);
				const back = smooth(0.8, 1, x);
				const tx = lerp(lerp(100, 262, go), 100, back);
				let cx = 100;
				let cb = 204;
				if (x >= OFF) {
					// free fall from the disc onto the heap
					cx = 262;
					const t = Math.min(x - OFF, TFALL) * RUN;
					cb = LIFT + 0.5 * G * t * t;
				} else if (x >= 0.22) {
					cx = tx;
					cb = lerp(204, LIFT, smooth(0.22, 0.4, x));
				}
				// the bottom of the disc: down onto the roof (roof = car bottom − 27), then with the car, then back up
				let db: number;
				if (x < 0.22) db = lerp(108, 177, smooth(0, 0.16, x));
				else if (x < OFF) db = cb - 27;
				else db = lerp(LIFT - 27, 108, back);
				trolley.setAttribute('transform', `translate(${f1(tx)} 0)`);
				disc.setAttribute('transform', `translate(0 ${f1(db)})`);
				const top = f1(db - 21);
				rope.setAttribute('y2', top);
				cable.setAttribute('y2', top);
				live.setAttribute('y2', top);
				car.setAttribute('transform', `translate(${f1(cx)} ${f1(cb)})`);
				const on = x >= ON && x < OFF;
				live.style.opacity = on ? '1' : '0';
				glow.style.opacity = on ? '0.9' : '0';
			});
		}

		// Door: the hand comes (→ 0,20), the key at 0,22 (current off), to the handle (0,24–0,36), the door opens
		// (0,38–0,58), the hand leaves, the door closer shuts the door (0,66–0,90), the current is on again; 7 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="door"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const door = $<SVGPolygonElement>('[data-door]');
			const panel = $<SVGPolygonElement>('[data-panel]');
			const plate = $<SVGPolygonElement>('[data-plate]');
			const handle = $<SVGRectElement>('[data-handle]');
			const hand = $<SVGGElement>('[data-hand]');
			const led = $<SVGCircleElement>('[data-led]');
			const live = $<SVGPathElement>('[data-live]');
			const turns = $<SVGGElement>('[data-turns]');
			const iplate = $<SVGRectElement>('[data-iplate]');
			const X0 = 124;
			const DW = 104;
			const DT = 44;
			const DB = 206;
			const MID = (DT + DB) / 2;
			const GROW = 12; // the free edge comes nearer and looks taller
			// a point of the door: u — fraction of the width from the hinge, y — height on the closed door
			const pt = (u: number, y: number, c: number, s: number): [number, number] => [X0 + DW * u * c, y + ((y - MID) / (DB - MID)) * GROW * s * u];
			const poly = (q: [number, number][]) => q.map(([a, b]) => `${f1(a)},${f1(b)}`).join(' ');
			const HANDLE: [number, number] = [0.9, 128];
			const READER: [number, number] = [287, 147]; // the fist: the fob (14 px to its left) is then on the reader
			scene(card, 7, (x) => {
				const th = ((55 * Math.PI) / 180) * (smooth(0.38, 0.58, x) - smooth(0.66, 0.9, x));
				const c = Math.cos(th);
				const s = Math.sin(th);
				door.setAttribute('points', poly([pt(0, DT, c, s), pt(1, DT, c, s), pt(1, DB, c, s), pt(0, DB, c, s)]));
				panel.setAttribute('points', poly([pt(0.12, 60, c, s), pt(0.88, 60, c, s), pt(0.88, 192, c, s), pt(0.12, 192, c, s)]));
				plate.setAttribute('points', poly([pt(0.6, 45, c, s), pt(0.98, 45, c, s), pt(0.98, 51, c, s), pt(0.6, 51, c, s)]));
				const [hx, hy] = pt(HANDLE[0], HANDLE[1], c, s);
				handle.setAttribute('x', f1(hx - 2.5));
				handle.setAttribute('y', f1(hy - 11));
				// the hand: from the right to the reader, to the handle, follows the handle, leaves
				let px: number;
				let py: number;
				if (x < 0.24) {
					const k = 1 - (1 - clamp(x / 0.2)) ** 3;
					px = lerp(420, READER[0], k);
					py = READER[1];
				} else if (x < 0.38) {
					const k = smooth(0.24, 0.36, x);
					px = lerp(READER[0], hx, k);
					py = lerp(READER[1], hy, k);
				} else {
					const k = smooth(0.58, 0.68, x);
					px = lerp(hx, 420, k);
					py = lerp(hy, 150, k);
				}
				hand.setAttribute('transform', `translate(${f1(px)} ${f1(py)})`);
				const on = x < 0.22 || x >= 0.9;
				live.style.opacity = on ? '1' : '0';
				turns.classList.toggle('is-on', on);
				led.classList.toggle('is-open', !on);
				// the inset: the plate leaves the electromagnet as the door opens
				iplate.setAttribute('y', f2(-3 + 16 * Math.min(1, s / Math.sin((55 * Math.PI) / 180))));
			});
		}
	}
</script>
