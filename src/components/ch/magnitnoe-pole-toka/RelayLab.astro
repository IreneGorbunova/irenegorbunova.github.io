---
/**
 * Electromagnetic relay. A weak current in the control circuit magnetises the core; the core pulls the
 * iron armature down, its contact closes the working circuit with a lamp and its own source.
 * The armature: u = 0 at rest (held by the spring), u = 1 on the core. Motion is shown slowed down.
 */
const PIV = { x: 128, y: 165 }; // pivot of the armature
---

<figure class="rl not-content" data-rl>
	<svg class="rl__svg" viewBox="0 0 600 360" role="img" aria-label="Электромагнитное реле: цепь управления с кнопкой и электромагнитом и рабочая цепь с лампой">
		<defs>
			<radialGradient id="rl-glow">
				<stop offset="0" class="rl__glow-a"></stop>
				<stop offset="1" class="rl__glow-b"></stop>
			</radialGradient>
		</defs>

		<!-- areas -->
		<rect class="rl__zone rl__zone--c" x="8" y="8" width="250" height="344" rx="12"></rect>
		<rect class="rl__zone rl__zone--w" x="272" y="8" width="320" height="344" rx="12"></rect>
		<text x="20" y="32" class="rl__zone-name rl__zone-name--c">цепь управления — слабый ток</text>
		<text x="580" y="32" text-anchor="end" class="rl__zone-name rl__zone-name--w">рабочая цепь — сильный ток</text>

		<!-- control circuit wires -->
		<g class="rl__wires">
			<path d="M 40 218 V 70 H 90 V 100"></path>
			<path d="M 90 150 V 196 H 188"></path>
			<path d="M 188 256 H 160 V 316 H 40 V 242"></path>
		</g>
		<g class="rl__flow rl__flow--c" data-flow-c>
			<path d="M 40 218 V 70 H 90 V 100"></path>
			<path d="M 90 150 V 196 H 188"></path>
			<path d="M 188 256 H 160 V 316 H 40 V 242"></path>
		</g>
		<!-- small battery -->
		<g class="rl__cell">
			<rect x="22" y="218" width="36" height="24" class="rl__bg"></rect>
			<line x1="24" y1="222" x2="56" y2="222" class="rl__plate-p"></line>
			<line x1="32" y1="236" x2="48" y2="236" class="rl__plate-n"></line>
			<text x="62" y="236" class="rl__small">4,5 В</text>
		</g>
		<!-- push button -->
		<g class="rl__button" data-button tabindex="0" role="button" aria-label="Кнопка цепи управления">
			<rect class="rl__hit" x="62" y="88" width="62" height="74"></rect>
			<circle class="rl__contact" cx="90" cy="100" r="4"></circle>
			<circle class="rl__contact" cx="90" cy="150" r="4"></circle>
			<line class="rl__lever" x1="90" y1="150" x2="112" y2="108" data-lever></line>
			<text x="98" y="88" class="rl__small">кнопка</text>
		</g>

		<!-- electromagnet: yoke, core, coil -->
		<path class="rl__iron" d={`M ${PIV.x - 8} ${PIV.y + 6} V 282 H 236 V 270 H ${PIV.x + 6} V ${PIV.y + 6} Z`}></path>
		<rect class="rl__iron" x="200" y="172" width="28" height="100"></rect>
		<rect class="rl__coil" x="188" y="186" width="52" height="76" rx="4"></rect>
		<g class="rl__turns" data-turns>
			{Array.from({ length: 11 }, (_, k) => <line x1="188" x2="240" y1={190 + k * 6.6} y2={194 + k * 6.6} />)}
		</g>
		<text x="214" y="300" text-anchor="middle" class="rl__small" dy="18">электромагнит</text>

		<!-- spring -->
		<path class="rl__bracket" d="M 296 70 H 330 M 313 70 V 58"></path>
		<path class="rl__spring" data-spring></path>
		<text x="336" y="92" class="rl__small">пружина</text>

		<!-- working circuit -->
		<g class="rl__wires">
			<path d="M 356 178 V 300 H 428"></path>
			<path d="M 472 300 H 540 V 216"></path>
			<path d="M 540 196 V 110 H 450"></path>
		</g>
		<path class="rl__wires-flex" data-flex></path>
		<g class="rl__flow rl__flow--w" data-flow-w>
			<path d="M 540 196 V 110 H 450"></path>
			<path data-flex-flow></path>
			<path d="M 356 178 V 300 H 428"></path>
			<path d="M 472 300 H 540 V 216"></path>
		</g>
		<!-- fixed contact -->
		<rect class="rl__post" x="350" y="178" width="12" height="40" rx="2"></rect>
		<rect class="rl__pad" x="347" y="174" width="18" height="5" rx="1.5"></rect>
		<text x="372" y="214" class="rl__small">контакты</text>
		<!-- big battery -->
		<g class="rl__cell">
			<rect x="516" y="192" width="48" height="28" class="rl__bg"></rect>
			<line x1="518" y1="196" x2="562" y2="196" class="rl__plate-p"></line>
			<line x1="528" y1="214" x2="552" y2="214" class="rl__plate-n"></line>
			<text x="572" y="246" text-anchor="end" class="rl__small">12 В</text>
		</g>
		<!-- lamp -->
		<g class="rl__lamp" transform="translate(450 300)">
			<circle r="44" fill="url(#rl-glow)" class="rl__halo" data-halo></circle>
			<circle r="22" class="rl__bulb" data-bulb></circle>
			<path d="M -15.5 -15.5 L 15.5 15.5 M -15.5 15.5 L 15.5 -15.5" class="rl__filament" data-fil></path>
		</g>

		<!-- armature (rotates about the pivot) -->
		<g data-arm>
			<rect class="rl__iron rl__arm" x={PIV.x} y={PIV.y - 5} width="236" height="10" rx="3"></rect>
			<rect class="rl__pad" x="347" y={PIV.y + 5} width="18" height="4" rx="1.5"></rect>
			<circle class="rl__pivot" cx={PIV.x} cy={PIV.y} r="5"></circle>
		</g>
		<text x="250" y="140" class="rl__small" data-arm-cap>якорь</text>
	</svg>

	<div class="rl__buttons">
		<button type="button" class="rl__btn" data-press>Нажать кнопку</button>
	</div>
	<p class="rl__status" data-status aria-live="polite"></p>
	<figcaption class="rl__legend">
		Точки на проводах показывают ток: в цепи управления он слабый, в рабочей — сильный. Движение якоря показано замедленно: у настоящего реле оно занимает сотые доли секунды.
	</figcaption>
</figure>

<style is:global>
	.rl {
		--rl-c: var(--ig-vx);
		--rl-w: var(--ig-vy);
		--rl-cu: var(--ig-v);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.rl__svg {
		display: block;
		width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.rl__zone {
		fill: none;
		stroke-width: 1.5;
		stroke-dasharray: 5 5;
	}
	.rl__zone--c {
		stroke: color-mix(in srgb, var(--rl-c) 50%, transparent);
	}
	.rl__zone--w {
		stroke: color-mix(in srgb, var(--rl-w) 50%, transparent);
	}
	.rl__zone-name {
		font-size: 14px;
		font-weight: 600;
		font-family: var(--__sl-font);
	}
	.rl__zone-name--c {
		fill: var(--rl-c);
	}
	.rl__zone-name--w {
		fill: var(--rl-w);
	}
	.rl__wires path,
	.rl__wires-flex {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.rl__flow path {
		fill: none;
		stroke-linecap: round;
		opacity: 0;
		transition: opacity 0.25s;
	}
	.rl__flow--c path {
		stroke: var(--rl-c);
		stroke-width: 2.5;
		stroke-dasharray: 2.5 22;
	}
	.rl__flow--w path {
		stroke: var(--rl-w);
		stroke-width: 3;
		stroke-dasharray: 3 7;
	}
	.rl__flow.is-on path {
		opacity: 1;
	}
	.rl__bg {
		fill: var(--ig-surface);
	}
	.rl__plate-p {
		stroke: var(--sl-color-white);
		stroke-width: 3;
	}
	.rl__plate-n {
		stroke: var(--sl-color-white);
		stroke-width: 7;
	}
	.rl__small {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
		font-family: var(--__sl-font);
	}
	.rl__button {
		cursor: pointer;
		outline: none;
	}
	.rl__hit {
		fill: transparent;
	}
	.rl__contact {
		fill: var(--ig-surface);
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	.rl__lever {
		stroke: var(--sl-color-white);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.rl__button:hover .rl__lever,
	.rl__button:focus-visible .rl__lever {
		stroke: var(--sl-color-accent);
	}
	.rl__iron {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rl__arm {
		fill: var(--sl-color-gray-3);
	}
	.rl__coil {
		fill: color-mix(in srgb, var(--rl-cu) 12%, var(--ig-surface));
		stroke: var(--sl-color-gray-4);
	}
	.rl__turns line {
		stroke: var(--rl-cu);
		stroke-width: 2.5;
		stroke-linecap: round;
		transition: filter 0.25s;
	}
	.rl__turns.is-on line {
		filter: drop-shadow(0 0 3px var(--rl-cu));
	}
	.rl__pivot {
		fill: var(--sl-color-gray-1);
	}
	.rl__bracket {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		fill: none;
	}
	.rl__spring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.rl__post {
		fill: var(--sl-color-gray-5);
	}
	.rl__pad {
		fill: var(--rl-cu);
	}
	.rl__bulb {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 40%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		transition: fill 0.2s;
	}
	.rl__lamp-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
	}
	.rl__filament {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		transition: stroke 0.2s;
	}
	.rl__glow-a {
		stop-color: var(--rl-cu);
		stop-opacity: 0.85;
	}
	.rl__glow-b {
		stop-color: var(--rl-cu);
		stop-opacity: 0;
	}
	.rl__halo {
		opacity: 0;
		transition: opacity 0.2s;
	}
	.rl.is-lit .rl__halo {
		opacity: 1;
	}
	.rl.is-lit .rl__bulb {
		fill: color-mix(in srgb, var(--rl-cu) 55%, transparent);
	}
	.rl.is-lit .rl__filament {
		stroke: var(--sl-color-white);
	}
	.rl__buttons {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.rl__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		cursor: pointer;
	}
	.rl__status {
		min-height: 3em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	.rl__legend {
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const PIV = { x: 128, y: 165 };
	const REST = (-7 * Math.PI) / 180; // the armature at rest is lifted by 7°
	const SPRING_X = 313; // where the spring is attached to the armature
	// slowed-down dynamics of the armature, u from 0 (rest) to 1 (on the core)
	const MAG = 30;
	const K = 60;
	const C = 6;

	for (const root of document.querySelectorAll<HTMLElement>('[data-rl]')) {
		const arm = root.querySelector<SVGGElement>('[data-arm]')!;
		const spring = root.querySelector<SVGPathElement>('[data-spring]')!;
		const flex = root.querySelector<SVGPathElement>('[data-flex]')!;
		const flexFlow = root.querySelector<SVGPathElement>('[data-flex-flow]')!;
		const flowC = root.querySelector<SVGGElement>('[data-flow-c]')!;
		const flowW = root.querySelector<SVGGElement>('[data-flow-w]')!;
		const turns = root.querySelector<SVGGElement>('[data-turns]')!;
		const lever = root.querySelector<SVGLineElement>('[data-lever]')!;
		const button = root.querySelector<SVGGElement>('[data-button]')!;
		const press = root.querySelector<HTMLButtonElement>('[data-press]')!;
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const capArm = root.querySelector<SVGTextElement>('[data-arm-cap]')!;

		let pressed = false;
		let u = 0;
		let v = 0;
		let shiftC = 0;
		let shiftW = 0;
		let running = false;
		let visible = true;
		let last = 0;

		const angle = () => REST * (1 - u);
		const pt = (x: number, ang: number) => [PIV.x + (x - PIV.x) * Math.cos(ang), PIV.y + (x - PIV.x) * Math.sin(ang)];
		const draw = () => {
			const ang = angle();
			arm.setAttribute('transform', `rotate(${((ang * 180) / Math.PI).toFixed(2)} ${PIV.x} ${PIV.y})`);
			// spring from the bracket (313, 70) down to the armature
			const [sx, sy] = pt(SPRING_X, ang);
			const top = 70;
			const bot = sy - 5;
			const n = 10;
			let d = `M 313 ${top} V ${top + 8}`;
			for (let i = 0; i < n; i++) {
				const y = top + 8 + ((bot - 8 - top - 8) * (i + 0.5)) / n;
				d += ` L ${313 + (i % 2 ? -7 : 7)} ${y.toFixed(1)}`;
			}
			d += ` L 313 ${(bot - 8).toFixed(1)} L ${sx.toFixed(1)} ${bot.toFixed(1)}`;
			spring.setAttribute('d', d);
			// a flexible lead from the working circuit to the end of the armature
			const [ex, ey] = pt(356, ang);
			const fd = `M 450 110 C 400 110 ${ex.toFixed(1)} ${(ey - 50).toFixed(1)} ${ex.toFixed(1)} ${(ey - 5).toFixed(1)}`;
			flex.setAttribute('d', fd);
			flexFlow.setAttribute('d', fd);
			capArm.setAttribute('y', (pt(250, ang)[1] - 12).toFixed(1));
		};

		const closed = () => u > 0.995;
		const say = () => {
			if (pressed && closed())
				status.innerHTML = 'По обмотке идёт слабый ток, сердечник намагнитился и притянул якорь. Контакты замкнулись — по рабочей цепи пошёл сильный ток, и лампа горит.';
			else if (pressed) status.innerHTML = 'Ток в обмотке намагничивает сердечник — якорь притягивается…';
			else if (u > 0.01) status.innerHTML = 'Тока в обмотке нет, сердечник размагнитился, и пружина поднимает якорь — рабочая цепь разомкнута.';
			else status.innerHTML = 'Кнопка отпущена: тока в обмотке нет, пружина держит якорь поднятым, контакты разомкнуты, лампа не горит.';
		};

		const step = (dt: number) => {
			if (reduceMotion.matches) {
				u = pressed ? 1 : 0;
				v = 0;
			} else {
				const sub = 4;
				const h = dt / sub;
				for (let i = 0; i < sub; i++) {
					const gap = 1 - u;
					const a = (pressed ? MAG / ((gap + 0.25) * (gap + 0.25)) : 0) - K * u - C * v;
					v += a * h;
					u += v * h;
					if (u > 1) {
						u = 1;
						v = -0.15 * v; // the armature hits the core
						if (Math.abs(v) < 0.05) v = 0;
					}
					if (u < -0.08) {
						u = -0.08;
						v = 0;
					}
				}
			}
			const lit = closed();
			root.classList.toggle('is-lit', lit);
			flowC.classList.toggle('is-on', pressed);
			flowW.classList.toggle('is-on', lit);
			turns.classList.toggle('is-on', pressed);
			if (!reduceMotion.matches) {
				if (pressed) shiftC -= dt * 12;
				if (lit) shiftW -= dt * 70;
				flowC.querySelectorAll('path').forEach((p) => (p.style.strokeDashoffset = shiftC.toFixed(1)));
				flowW.querySelectorAll('path').forEach((p) => (p.style.strokeDashoffset = shiftW.toFixed(1)));
			}
			draw();
			say();
			const moving = Math.abs(v) > 0.002 || (pressed ? u < 1 : u > 0.002);
			return moving || pressed;
		};

		const frame = (now: number) => {
			const dt = Math.min(0.04, (now - last) / 1000);
			last = now;
			if (step(dt) && visible) requestAnimationFrame(frame);
			else running = false;
		};
		const kick = () => {
			if (running || !visible) return;
			running = true;
			last = performance.now();
			requestAnimationFrame(frame);
		};
		new IntersectionObserver((es) => {
			visible = es.some((e) => e.isIntersecting);
			if (visible) kick();
		}).observe(root);

		const toggle = () => {
			pressed = !pressed;
			lever.setAttribute('x2', pressed ? '90' : '112');
			lever.setAttribute('y2', pressed ? '100' : '108');
			press.textContent = pressed ? 'Отпустить кнопку' : 'Нажать кнопку';
			kick();
		};
		press.addEventListener('click', toggle);
		button.addEventListener('click', toggle);
		button.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				toggle();
			}
		});
		draw();
		say();
	}
</script>
