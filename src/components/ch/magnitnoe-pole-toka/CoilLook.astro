		stop-color: color-mix(in srgb, var(--clk-pl) 70%, var(--clk-paper));
	}
	.clk__pl-mid {
		stop-color: var(--clk-pl);
	}
	.clk__pl-lo {
		stop-color: color-mix(in srgb, var(--clk-pl) 55%, var(--clk-ink));
	}
