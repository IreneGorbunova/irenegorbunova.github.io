---
/**
 * Picture to the definition of a coil: what a school coil looks like, with no field lines.
 * A plastic former (a tube with two flanges) turns on a rod with a crank, and an enamelled copper wire from a reel
 * is laid on it turn by turn, the turns side by side. The wire is cut, the rod is taken out, the coil is put on a
 * stand, its two ends (the leads) go to two terminals; a source and a key are connected; the key closes and the
 * current goes along the wire, through all the turns one after another. An inset shows three neighbouring turns in
 * section: a copper core under a thin layer of varnish (the insulation), so the turns touch but do not conduct to
 * each other.
 * Geometry: the coil axis is horizontal; we look from the left and a little from the front (yaw, sin ψ = S), so a
 * circle of radius r in the plane X = x is drawn as an ellipse with half-axes r·S and r. A point of the wire at the
 * wire coordinate u (in turns, from 0 at the start to N at the end) lies at X = XA + D/2 + D·u and at the angle
 * θ = 2π(Φ − u) from the top towards us, where Φ is the number of turns the former has made; it is visible when
 * 0 ≤ θ mod 2π ≤ π (the front half). The pitch equals the wire diameter D, so the turns lie close.
 */
const W = 360;
const H = 222;
const CY = 88; // the coil axis
const R = 22; // outer radius of the tube
const D = 8; // diameter of the wire (and the pitch)
const RW = R + D / 2; // radius of the wire centre line
const S = 0.25; // sin of the yaw: circles are drawn as ellipses r·S × r
const N = 23; // turns
const XA = 84; // inner face of the left flange
const XB = XA + D * (N + 1); // inner face of the right flange
const TF = 6; // thickness of a flange
const RF = 36; // radius of a flange
const XL = XA - TF; // outer face of the left flange
const BOARD = CY + RF; // top of the stand
const TL = 46; // the terminals
const TR = 314;
const CLAMP = 112.5; // height of the clamp
const BY = 192; // the bottom wires
const uid = `clk-${Math.random().toString(36).slice(2, 8)}`;
const f1 = (v: number) => +v.toFixed(1);
const xTop = (j: number) => XA + D / 2 + D * (j + 0.5); // top of the j-th front half-turn in the final frame
const MX = 322; // the inset
const MY = 32;
const MR = 25;
---

<figure class="clk not-content" data-clk>
	<div class="clk__stage">
		<svg class="clk__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Как выглядит катушка. Пластмассовую трубку с бортиками — каркас — вращают, и медный провод с мотка ложится на неё витками вплотную друг к другу. Провод покрыт лаком — изоляцией. Концы провода — выводы катушки — закреплены на двух клеммах, к ним подключены источник тока и ключ. Когда ключ замыкают, ток идёт по проводу через все витки по очереди.">
			<defs>
				<linearGradient id={`${uid}-cu`} gradientUnits="userSpaceOnUse" x1="0" y1={CY - RW - D / 2} x2="0" y2={CY + RW + D / 2}>
					<stop offset="0" class="clk__cu-hi"></stop>
					<stop offset="0.3" class="clk__cu-mid"></stop>
					<stop offset="1" class="clk__cu-lo"></stop>
				</linearGradient>
				<linearGradient id={`${uid}-tube`} gradientUnits="userSpaceOnUse" x1="0" y1={CY - R} x2="0" y2={CY + R}>
					<stop offset="0" class="clk__pl-hi"></stop>
					<stop offset="0.35" class="clk__pl-mid"></stop>
					<stop offset="1" class="clk__pl-lo"></stop>
				</linearGradient>
				<clipPath id={`${uid}-mag`}><circle cx={MX} cy={MY} r={MR - 1}></circle></clipPath>
			</defs>

			<!-- the stand and the terminals (after the winding) -->
			<g data-stand>
				<rect class="clk__board" x="28" y={BOARD} width="304" height="12" rx="3"></rect>
				<rect class="clk__post" x={TL - 3.5} y={CLAMP - 4} width="7" height={BOARD - CLAMP + 4}></rect>
				<rect class="clk__post" x={TR - 3.5} y={CLAMP - 4} width="7" height={BOARD - CLAMP + 4}></rect>
			</g>

			<!-- the right flange: its rim and its inner face -->
			<path class="clk__rim" d={`M ${XB} ${CY - RF} H ${XB + TF} A ${RF * S} ${RF} 0 0 1 ${XB + TF} ${CY + RF} H ${XB} Z`}></path>
			<ellipse class="clk__face" cx={XB} cy={CY} rx={RF * S} ry={RF}></ellipse>
			<!-- the tube -->
			<path class="clk__tube" fill={`url(#${uid}-tube)`} d={`M ${XA - 2} ${CY - R} H ${XB} A ${R * S} ${R} 0 0 1 ${XB} ${CY + R} H ${XA - 2} Z`}></path>
			<!-- the turns (front halves), filled in by the script -->
			<g data-arcs></g>
			<!-- the wire from the reel to the former -->
			<g data-feed>
				<path class="clk__w-o" d=""></path>
				<path class="clk__w-b" stroke={`url(#${uid}-cu)`} d=""></path>
				<path class="clk__w-g" d=""></path>
			</g>
			<!-- the left flange: rim, outer face, the opening of the tube -->
			<path class="clk__rim" d={`M ${XL} ${CY - RF} H ${XA} A ${RF * S} ${RF} 0 0 1 ${XA} ${CY + RF} H ${XL} Z`}></path>
			<ellipse class="clk__face" cx={XL} cy={CY} rx={RF * S} ry={RF}></ellipse>
			<ellipse class="clk__hole" cx={XL} cy={CY} rx={(R - 2) * S} ry={R - 2}></ellipse>
			<!-- the rod the former turns on, with a crank -->
			<g data-rod>
				<line class="clk__rod" x1="38" y1={CY} x2={XL} y2={CY}></line>
				<line class="clk__crank" x1="38" y1={CY} x2="38" y2={CY - 16} data-crank></line>
				<circle class="clk__knob" cx="38" cy={CY - 16} r="3.2" data-knob></circle>
			</g>
			<!-- the start of the wire comes out through a small hole in the left flange -->
			<g data-stub>
				<path class="clk__w-o clk__w-o--thin" d=""></path>
				<path class="clk__w-b clk__w-b--thin" d=""></path>
			</g>
			<!-- the leads: from the hole to the left terminal, from the last turn to the right terminal -->
			<g data-lead>
				<path class="clk__w-o clk__w-o--thin" pathLength="1" d={`M 82.3 111.5 C 66 112, 58 114, ${TL} ${CLAMP}`} data-lead-s></path>
				<path class="clk__w-b clk__w-b--thin" pathLength="1" d={`M 82.3 111.5 C 66 112, 58 114, ${TL} ${CLAMP}`}></path>
				<path class="clk__w-o clk__w-o--thin" pathLength="1" d={`M ${XA + D / 2 + D * N} ${CY + RW} C 286 121, 300 119, ${TR} ${CLAMP}`} data-lead-e></path>
				<path class="clk__w-b clk__w-b--thin" pathLength="1" d={`M ${XA + D / 2 + D * N} ${CY + RW} C 286 121, 300 119, ${TR} ${CLAMP}`}></path>
			</g>

			<!-- the circuit: a source and a key -->
			<g data-circuit>
				<path class="clk__lead" d={`M 95 ${BY} H 16 V ${CLAMP} H ${TL - 4}`} data-wire="1"></path>
				<path class="clk__lead" d={`M ${TR + 4} ${CLAMP} H 344 V ${BY} H 245`} data-wire="1"></path>
				<path class="clk__lead" d={`M 205 ${BY} H 155`} data-wire="1"></path>
				<g data-live>
					<path class="clk__lead clk__lead--live" d={`M 95 ${BY} H 16 V ${CLAMP} H ${TL - 4}`}></path>
					<path class="clk__lead clk__lead--live" d={`M ${TR + 4} ${CLAMP} H 344 V ${BY} H 245`}></path>
					<path class="clk__lead clk__lead--live" d={`M 205 ${BY} H 155`}></path>
				</g>
				<g transform={`translate(125 ${BY})`}>
					<rect class="clk__cell" x="-30" y="-10" width="60" height="20" rx="4"></rect>
					<rect class="clk__nub" x="-35" y="-4" width="5" height="8" rx="1.5"></rect>
					<text class="clk__sign" x="-21" y="5" text-anchor="middle">+</text>
					<text class="clk__sign" x="21" y="5" text-anchor="middle">−</text>
				</g>
				<circle class="clk__contact" cx="205" cy={BY} r="3"></circle>
				<circle class="clk__contact" cx="245" cy={BY} r="3"></circle>
				<line class="clk__lever" x1="205" y1={BY} x2="245" y2={BY} data-lever></line>
				<text class="clk__lbl" x="125" y={BY + 23} text-anchor="middle">источник тока</text>
				<text class="clk__lbl" x="225" y={BY + 23} text-anchor="middle">ключ</text>
			</g>
			<!-- the nuts of the terminals hold the wires -->
			<g data-stand>
				<rect class="clk__nut" x={TL - 6.5} y={CLAMP - 6} width="13" height="5.5" rx="1.5"></rect>
				<rect class="clk__nut" x={TR - 6.5} y={CLAMP - 6} width="13" height="5.5" rx="1.5"></rect>
			</g>
			<!-- the current -->
			<g data-chev>
				<path class="clk__chev-halo" d=""></path>
				<path class="clk__chev" d=""></path>
			</g>

			<!-- the reel of wire -->
			<g data-reel transform="translate(318 26)">
				<circle class="clk__reel" r="18"></circle>
				<circle class="clk__reel-ring" r="14.5"></circle>
				<circle class="clk__reel-ring" r="11"></circle>
				<g data-reel-hub>
					<circle class="clk__face" r="7.5"></circle>
					<circle class="clk__hub-hole" r="2.4"></circle>
					<circle class="clk__hub-dot" cx="4.6" r="1.2"></circle>
					<circle class="clk__hub-dot" cx="-4.6" r="1.2"></circle>
				</g>
			</g>

			<!-- the inset: three neighbouring turns in section -->
			<g data-mag>
				<line class="clk__leader" x1={MX - MR * 0.7} y1={MY + MR * 0.7} x2={xTop(21) + 2} y2={CY - RW - D / 2 - 1}></line>
				<circle class="clk__mag" cx={MX} cy={MY} r={MR}></circle>
				<g clip-path={`url(#${uid}-mag)`}>
					<rect class="clk__former" x={MX - MR} y={MY + 8.5} width={2 * MR} height={MR}></rect>
					{
						[-17, 0, 17].map((dx) => (
							<g>
								<circle class="clk__varnish" cx={MX + dx} cy={MY} r="8.5"></circle>
								<circle class="clk__core" cx={MX + dx} cy={MY} r="6.4"></circle>
								<path class="clk__shine" d={`M ${MX + dx - 4.2} ${MY - 1.5} A 4.5 4.5 0 0 1 ${MX + dx - 0.8} ${MY - 4.4}`}></path>
							</g>
						))
					}
				</g>
				<circle class="clk__mag-rim" cx={MX} cy={MY} r={MR}></circle>
				<line class="clk__leader" x1="290" y1="14" x2={MX - 17 - 1.5} y2={MY - 3}></line>
				<line class="clk__leader" x1="290" y1="38" x2={f1(MX - 17 - 8.5 * 0.8)} y2={f1(MY + 8.5 * 0.6)}></line>
				<text class="clk__lbl" x="287" y="18" text-anchor="end">медь</text>
				<text class="clk__lbl" x="287" y="42" text-anchor="end">лак (изоляция)</text>
			</g>

			<!-- labels -->
			<g data-l="frame">
				<line class="clk__leader" x1="44" y1="27" x2={XL - 1} y2={CY - 12}></line>
				<circle class="clk__dot" cx={XL - 1} cy={CY - 12} r="1.8"></circle>
				<text class="clk__lbl" x="6" y="22">каркас (трубка)</text>
			</g>
			<g data-l="turns">
				{[5, 7, 9].map((j) => <line class="clk__leader" x1="148" y1="35" x2={xTop(j)} y2={CY - RW - D / 2 - 2}></line>)}
				<text class="clk__lbl" x="148" y="30" text-anchor="middle">витки</text>
			</g>
			<g data-l="reel">
				<text class="clk__lbl" x="294" y="14" text-anchor="end">моток провода</text>
			</g>
			<g data-l="ends">
				<line class="clk__leader" x1="132" y1="148" x2="65" y2="116"></line>
				<line class="clk__leader" x1="228" y1="148" x2="291" y2="121"></line>
				<text class="clk__lbl" x="180" y="153" text-anchor="middle">выводы катушки</text>
			</g>
		</svg>
	</div>
	<div class="clk__bar">
		<p class="clk__status" data-status aria-live="polite"></p>
		<button type="button" class="clk__again" data-again hidden>Повторить</button>
	</div>
	<figcaption class="clk__legend">
		Катушка — провод, намотанный витками на трубку (каркас). Провод покрыт изоляцией — тонким слоем лака, поэтому
		витки, хоть и касаются друг друга, ток из витка в виток не пропускают: ток идёт по всему проводу, виток за витком.
	</figcaption>
</figure>

<style is:global>
