	@media (max-width: 40rem) {
		.clk {
			padding: 0.75rem;
		}
		.clk__stage {
			padding: 0.2rem;
		}
		.clk__status {
			min-height: 6em;
		}
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const CY = 88;
	const R = 22;
	const D = 8;
	const RW = R + D / 2;
	const S = 0.25;
	const N = 23;
	const XA = 84;
	const XL = XA - 6;
	const RH = 29; // radius of the hole for the start of the wire on the left flange
	const PHI_END = N + 0.5; // the former stops when the end of the wire is at the bottom, in front
	const REEL = { x: 318, y: 26, r: 18 };
	// the timeline, s
	const PRE = 0.8;
	const TW = 8.6; // winding
	const T_OFF = PRE + TW; // the rod is taken out, the stand appears
	const T_LEAD = [9.8, 11.0];
	const T_MAG = [10.8, 11.4];
	const T_CIRC = [11.8, 12.6];
	const T_KEY = [13.4, 13.8];
	const T_END = 14.6;

	const clamp = (v: number) => Math.min(1, Math.max(0, v));
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);
	const TAU = 2 * Math.PI;

	// the number of turns made by the former: slow at first, faster, slow again at the end
	const DT = 1 / 240;
	const PHI: number[] = [0];
	{
		const v = (t: number) => (0.1 + 0.9 * smooth(0.6, 2.6, t)) * (1 - 0.9 * smooth(TW - 1.8, TW, t));
		let s = 0;
		for (let i = 1; i <= TW / DT; i++) {
			s += v((i - 0.5) * DT) * DT;
			PHI.push(s);
		}
		const k = PHI_END / s;
		for (let i = 0; i < PHI.length; i++) PHI[i] *= k;
	}
	const phiAt = (t: number) => {
		if (t <= 0) return 0;
		const i = t / DT;
		const j = Math.floor(i);
		if (j >= PHI.length - 1) return PHI_END;
		return PHI[j] + (PHI[j + 1] - PHI[j]) * (i - j);
	};
	// a point of the wire on the screen
	const X = (u: number) => XA + D / 2 + D * u;
	const pt = (u: number, phi: number) => {
		const th = TAU * (phi - u);
		return [X(u) + RW * S * Math.sin(th), CY - RW * Math.cos(th)];
	};
	const arcD = (u0: number, u1: number, phi: number) => {
		const n = Math.max(3, Math.ceil(((u1 - u0) / 0.5) * 18));
		let s = '';
		for (let i = 0; i <= n; i++) {
			const [x, y] = pt(u0 + ((u1 - u0) * i) / n, phi);
			s += `${i ? 'L' : 'M'} ${f1(x)} ${f1(y)} `;
		}
		return s;
	};
	const chevron = (x: number, y: number, tx: number, ty: number) => {
		const nx = -ty;
		const ny = tx;
		return `M ${f1(x - 2.6 * tx + 3.4 * nx)} ${f1(y - 2.6 * ty + 3.4 * ny)} L ${f1(x + 2.2 * tx)} ${f1(y + 2.2 * ty)} L ${f1(x - 2.6 * tx - 3.4 * nx)} ${f1(y - 2.6 * ty - 3.4 * ny)} `;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-clk]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const $$ = <T extends Element>(s: string) => [...root.querySelectorAll<T>(s)];
		const arcsG = $<SVGGElement>('[data-arcs]');
		const grad = root.querySelector('linearGradient')!.id;
		// a pool of front half-turns: the rightmost first, so the nearer (left) turns lie on top
		const pool: SVGPathElement[][] = [];
		for (let k = 0; k < N + 3; k++) {
			const g = document.createElementNS(NS, 'g');
			const ps = ['clk__w-o', 'clk__w-b', 'clk__w-g'].map((c) => {
				const p = document.createElementNS(NS, 'path');
				p.setAttribute('class', c);
				if (c === 'clk__w-b') p.setAttribute('stroke', `url(#${grad})`);
				if (c === 'clk__w-g') p.setAttribute('transform', 'translate(-1.3 0)');
				g.append(p);
				return p;
			});
			arcsG.append(g);
			pool.push(ps);
		}
		const feed = $$<SVGPathElement>('[data-feed] path');
		const feedG = $<SVGGElement>('[data-feed]');
		const stub = $$<SVGPathElement>('[data-stub] path');
		const leads = $$<SVGPathElement>('[data-lead] path');
		const leadS = $<SVGPathElement>('[data-lead-s]');
		const leadE = $<SVGPathElement>('[data-lead-e]');
		const rods = $$<SVGGElement>('[data-rod]');
		const crank = $<SVGLineElement>('[data-crank]');
		const knob = $<SVGCircleElement>('[data-knob]');
		const stands = $$<SVGGElement>('[data-stand]');
		const reel = $<SVGGElement>('[data-reel]');
		const hub = $<SVGGElement>('[data-reel-hub]');
		const mag = $<SVGGElement>('[data-mag]');
		const circuit = $<SVGGElement>('[data-circuit]');
		const live = $<SVGGElement>('[data-live]');
		const wires = $$<SVGPathElement>('[data-wire]');
		const lever = $<SVGLineElement>('[data-lever]');
		const chevs = $$<SVGPathElement>('[data-chev] path');
		const lbl = (k: string) => $<SVGGElement>(`[data-l="${k}"]`);
		const lReel = lbl('reel');
		const lTurns = lbl('turns');
		const lEnds = lbl('ends');
		const status = $<HTMLElement>('[data-status]');
		const again = $<HTMLButtonElement>('[data-again]');
		const op = (el: Element, v: number) => ((el as SVGElement).style.opacity = v.toFixed(3));
		let said = '';
		const say = (s: string) => {
			if (s !== said) status.innerHTML = said = s;
		};
		// the current along a drawn path: chevrons every 28 px, moving at 20 px/s (dir −1: against the drawing)
		const along = (p: SVGPathElement, dir: number, tc: number) => {
			const L = p.getTotalLength();
			let s = '';
			for (let l0 = 0; l0 < L; l0 += 28) {
				const l = (((l0 + 20 * tc * dir) % L) + L) % L;
				if (l < 5 || l > L - 5) continue;
				const a = p.getPointAtLength(l - 0.5);
				const b = p.getPointAtLength(l + 0.5);
				const h = Math.hypot(b.x - a.x, b.y - a.y) || 1;
				s += chevron((a.x + b.x) / 2, (a.y + b.y) / 2, (dir * (b.x - a.x)) / h, (dir * (b.y - a.y)) / h);
			}
			return s;
		};

		const draw = (t: number) => {
			const phi = phiAt(t - PRE);
			const laid = Math.min(phi, N);
			// the front halves of the turns
			for (let k = 0; k < pool.length; k++) {
				const u0 = Math.max(0, phi - k - 0.5);
				const u1 = Math.min(laid, phi - k);
				const d = u1 - u0 > 0.004 ? arcD(u0, u1, phi) : '';
				for (const p of pool[k]) p.setAttribute('d', d);
			}
			// the wire from the reel touches the former at the top
			const cut = phi >= N;
			if (!cut) {
				const cx = X(phi);
				const cy = CY - RW;
				const dx = cx - REEL.x;
				const dy = cy - REEL.y;
				const dist = Math.hypot(dx, dy);
				const a = Math.atan2(dy, dx) + Math.acos(REEL.r / dist);
				const b = Math.atan2(dy, dx) - Math.acos(REEL.r / dist);
				const ta = Math.sin(a) > Math.sin(b) ? a : b; // the lower tangent point: the reel turns clockwise
				const dd = `M ${f1(REEL.x + REEL.r * Math.cos(ta))} ${f1(REEL.y + REEL.r * Math.sin(ta))} L ${f1(cx)} ${f1(cy)}`;
				for (const p of feed) p.setAttribute('d', dd);
			}
			op(feedG, cut ? 0 : 1);
			// the former, the rod, the crank and the hole turn together
			const th = TAU * phi;
			const off = smooth(T_OFF, T_OFF + 0.4, t);
			for (const r of rods) op(r, 1 - off);
			const kx = 38 + 16 * S * Math.sin(th);
			const ky = CY - 16 * Math.cos(th);
			crank.setAttribute('x2', f1(kx));
			crank.setAttribute('y2', f1(ky));
			knob.setAttribute('cx', f1(kx));
			knob.setAttribute('cy', f1(ky));
			const hth = th - 0.2 * Math.PI;
			const hx = XL + RH * S * Math.sin(hth);
			const hy = CY - RH * Math.cos(hth);
			const sd = `M ${f1(hx)} ${f1(hy)} L ${f1(hx - 9)} ${f1(hy + 1.5)}`;
			for (const p of stub) p.setAttribute('d', sd);
			const g = smooth(T_LEAD[0], T_LEAD[1], t);
			op($('[data-stub]'), g > 0.02 ? 0 : 1);
			for (const p of leads) {
				p.style.strokeDasharray = `${g.toFixed(4)} 2`;
				p.style.opacity = g > 0.001 ? '1' : '0';
			}
			// the reel turns while the wire runs off it
			op(reel, 1 - smooth(T_OFF, T_OFF + 0.5, t));
			op(lReel, 1 - smooth(T_OFF, T_OFF + 0.5, t));
			hub.setAttribute('transform', `rotate(${f1(((360 * laid * RW) / REEL.r) % 360)})`);
			for (const s of stands) op(s, smooth(T_OFF, T_OFF + 0.5, t));
			op(lTurns, smooth(PRE + 3.2, PRE + 3.8, t));
			op(mag, smooth(T_MAG[0], T_MAG[1], t));
			op(lEnds, smooth(T_MAG[0], T_MAG[1], t));
			op(circuit, smooth(T_CIRC[0], T_CIRC[1], t));
			// the key
			const down = smooth(T_KEY[0], T_KEY[1], t);
			const ang = ((1 - down) * 30 * Math.PI) / 180;
			lever.setAttribute('x2', f1(205 + 40 * Math.cos(ang)));
			lever.setAttribute('y2', f1(192 - 40 * Math.sin(ang)));
			// the current
			const on = t >= T_KEY[1];
			op(live, on ? 0.9 : 0);
			if (on) {
				const tc = t - T_KEY[1];
				let s = '';
				// along the turns: a chevron every 0.8 turn of the wire; on the front halves the wire goes up
				const SP = 0.8;
				const w0 = (tc * 0.3) % SP;
				for (let k = 1; k <= N; k++) {
					const u0 = PHI_END - k - 0.5;
					for (let u = w0 + Math.ceil((u0 + 0.07 - w0) / SP) * SP; u < u0 + 0.43; u += SP) {
						const th2 = TAU * (PHI_END - u);
						const tx = D - TAU * RW * S * Math.cos(th2);
						const ty = -TAU * RW * Math.sin(th2);
						const h = Math.hypot(tx, ty);
						const [x, y] = pt(u, PHI_END);
						s += chevron(x, y, tx / h, ty / h);
					}
				}
				s += along(wires[0], 1, tc) + along(leadS, -1, tc) + along(leadE, 1, tc) + along(wires[1], 1, tc) + along(wires[2], 1, tc);
				for (const c of chevs) c.setAttribute('d', s);
			} else for (const c of chevs) c.setAttribute('d', '');
			// what is going on
			if (on) say('Ключ замкнули: ток идёт по проводу от одного вывода к другому, по всем виткам по очереди.');
			else if (t >= T_CIRC[0]) say('К клеммам подключают источник тока и ключ. Ключ разомкнут — тока нет.');
			else if (t >= T_MAG[0]) say('Провод покрыт тонким слоем <b>лака</b> — это изоляция. Соседние витки касаются друг друга лаком, а не медью.');
			else if (cut) say('Провод отрезали, катушку поставили на подставку. Концы провода — <b>выводы катушки</b> — закрепляют на клеммах.');
			else say('Каркас — трубку с бортиками — вращают, и медный провод с мотка ложится на неё <b>витками</b>, виток к витку.');
			again.hidden = t < T_END;
		};

		let t = 0;
		draw(0);
		const wake = loop(root, (dt) => {
			t += dt;
			draw(t);
			return true;
		});
		again.addEventListener('click', () => {
			t = 0;
			draw(0);
			wake();
		});
	}
</script>
