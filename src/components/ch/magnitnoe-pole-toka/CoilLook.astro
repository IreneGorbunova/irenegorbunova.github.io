		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.clk__nub {
		fill: var(--sl-color-gray-3);
	}
	.clk__sign {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.clk__contact {
		fill: var(--sl-color-gray-2);
	}
	.clk__lever {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.clk__chev,
	.clk__chev-halo {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.clk__chev {
		stroke: var(--ig-v);
		stroke-width: 1.8;
	}
	.clk__chev-halo {
		stroke: var(--clk-ink);
		stroke-width: 3.8;
		opacity: 0.7;
	}
	.clk__reel {
		fill: var(--clk-cu);
		stroke: color-mix(in srgb, var(--clk-cu) 45%, var(--clk-ink));
