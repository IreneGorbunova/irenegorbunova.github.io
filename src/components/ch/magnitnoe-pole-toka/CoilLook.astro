		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.clk__nut {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.clk__rod {
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.clk__crank {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.clk__knob {
		fill: var(--sl-color-gray-2);
	}
	.clk__rim {
		fill: color-mix(in srgb, var(--clk-pl) 70%, var(--clk-ink));
		stroke: color-mix(in srgb, var(--clk-pl) 45%, var(--clk-ink));
		stroke-width: 0.8;
	}
	.clk__face {
		fill: color-mix(in srgb, var(--clk-pl) 85%, var(--clk-paper));
		stroke: color-mix(in srgb, var(--clk-pl) 45%, var(--clk-ink));
