		--clk-ink: var(--sl-color-black);
		--clk-paper: var(--sl-color-white);
		--clk-cu: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		--clk-pl: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-5));
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	:root[data-theme='light'] .clk {
		--clk-ink: var(--sl-color-white);
		--clk-paper: var(--sl-color-black);
		--clk-pl: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-4));
	}
	.clk__stage {
		padding: 0.4rem;
		border-radius: 0.8rem;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-6);
	}
	.clk__svg {
		display: block;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
