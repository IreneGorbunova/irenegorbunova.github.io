---
/**
 * A small static picture of field lines for the step-by-step explanation, computed at build time
 * from the same exact fields as the main model. In every picture the current flows towards the viewer
 * in the upper wires (dots) and away in the lower ones (crosses).
 */
import { COIL, coilTurnsX, coilField, loopField, traceLine, thin, crossings, coilLines } from './field';

interface Props {
	kind: 'wire' | 'loop' | 'coil' | 'magnet' | 'core';
	label: string;
}
const { kind, label } = Astro.props;

const S = 17;
const W = 18 * S;
const H = 12 * S;
const X = (x: number) => W / 2 + x * S;
const Y = (y: number) => H / 2 - y * S;
const f1 = (v: number) => Math.round(v * 10) / 10;
const box = { x: 10, y: 7 };

type Line = { pts: [number, number][]; closed: boolean };
let lines: Line[] = [];
if (kind === 'wire') {
	for (let k = 1; k <= 6; k++) {
		const r = 0.55 * Math.pow(1.55, k);
		const pts: [number, number][] = [];
		for (let i = 0; i <= 96; i++) pts.push([r * Math.cos((i / 96) * 2 * Math.PI), r * Math.sin((i / 96) * 2 * Math.PI)]);
		lines.push({ pts, closed: true });
	}
} else if (kind === 'loop') {
	const f = (x: number, y: number) => loopField(COIL.a, 0, x, y);
	for (let i = 0; i < 4; i++) {
		const y = ((i + 0.5) / 4) * 0.85 * COIL.a;
		for (const sy of [1, -1]) {
			const l = traceLine(f, 0, sy * y, box, 0.05);
			lines.push({ pts: thin(l.pts, 0.15), closed: l.closed });
		}
	}
	const l = traceLine(f, 0, -(COIL.a + 0.55), box, 0.04);
	lines.push({ pts: thin(l.pts, 0.1), closed: l.closed });
	const l2 = traceLine(f, 0, COIL.a + 0.55, box, 0.04);
	lines.push({ pts: thin(l2.pts, 0.1), closed: l2.closed });
} else {
	lines = coilLines(kind === 'core' ? 7 : 4, kind === 'core' ? 0.9 : 0.8, box);
}
if (kind !== 'wire') lines.push({ pts: [[-10, 0], [10, 0]], closed: false });
void coilField;

const paths = lines.map((l) => 'M' + l.pts.map(([x, y]) => `${f1(X(x))} ${f1(Y(y))}`).join('L') + (l.closed ? 'Z' : ''));
const arrows: { x: number; y: number; deg: number }[] = [];
if (kind === 'wire') {
	lines.forEach((l, k) => {
		const r = Math.hypot(l.pts[0][0], l.pts[0][1]);
		const th = 0.9 + 0.7 * k;
		const ax = r * Math.cos(th);
		const ay = r * Math.sin(th);
		if (Math.abs(ax) < 8.6 && Math.abs(ay) < 5.6) arrows.push({ x: f1(X(ax)), y: f1(Y(ay)), deg: f1((-(th + Math.PI / 2) * 180) / Math.PI) });
	});
} else {
	for (const l of lines) {
		for (const c of crossings(l.pts, [0, -7, 7])) {
			if (Math.abs(c.y) > 5.6) continue;
			if (kind === 'magnet' && Math.abs(c.x) < 1 && Math.abs(c.y) < COIL.a + 0.3) continue;
			if (arrows.some((a) => Math.hypot(a.x - X(c.x), a.y - Y(c.y)) < 16)) continue;
			arrows.push({ x: f1(X(c.x)), y: f1(Y(c.y)), deg: f1((-c.ang * 180) / Math.PI) });
		}
	}
}
const turns = kind === 'loop' ? [0] : coilTurnsX();
const showTurns = kind === 'loop' || kind === 'coil' || kind === 'core';
const half = (COIL.len / 2) * S;
---

<div class="fpic not-content">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
		<defs>
			<clipPath id={`fpic-${kind}`}><rect width={W} height={H} rx="10"></rect></clipPath>
		</defs>
		<g clip-path={`url(#fpic-${kind})`}>
			<rect class="fpic__bg" width={W} height={H}></rect>
			{kind === 'core' && <rect class="fpic__core" x={X(0) - half - 4} y={Y(COIL.a) + 4} width={2 * half + 8} height={2 * COIL.a * S - 8} rx="3" />}
			<g class="fpic__lines">
				{paths.map((d) => <path d={d} />)}
				{arrows.map((a) => <path class="fpic__arrow" transform={`translate(${a.x} ${a.y}) rotate(${a.deg})`} d="M -5 -4 L 5 0 L -5 4 Z" />)}
			</g>
			{kind === 'magnet' && (
				<g class="fpic__magnet">
					<rect class="fpic__s" x={X(0) - half} y={Y(COIL.a)} width={half} height={2 * COIL.a * S} />
					<rect class="fpic__n" x={X(0)} y={Y(COIL.a)} width={half} height={2 * COIL.a * S} />
					<text x={X(-COIL.len / 4)} y={Y(0) + 7} text-anchor="middle">S</text>
					<text x={X(COIL.len / 4)} y={Y(0) + 7} text-anchor="middle">N</text>
				</g>
			)}
			{kind === 'wire' && (
				<g transform={`translate(${X(0)} ${Y(0)})`} class="fpic__wire">
					<circle r="8" />
					<circle class="fpic__dot" r="2.6" />
				</g>
			)}
			{showTurns &&
				turns.map((x) => (
					<g>
						<g transform={`translate(${f1(X(x))} ${Y(COIL.a)})`} class="fpic__wire fpic__wire--small">
							<circle r={kind === 'loop' ? 6 : 4} />
							<circle class="fpic__dot" r={kind === 'loop' ? 2 : 1.3} />
						</g>
						<g transform={`translate(${f1(X(x))} ${Y(-COIL.a)})`} class="fpic__wire fpic__wire--small">
							<circle r={kind === 'loop' ? 6 : 4} />
							<path d={kind === 'loop' ? 'M -3 -3 L 3 3 M -3 3 L 3 -3' : 'M -2 -2 L 2 2 M -2 2 L 2 -2'} />
						</g>
					</g>
				))}
			{(kind === 'coil' || kind === 'core') && (
				<g class="fpic__poles">
					<text class="fpic__pole-n" x={X(COIL.len / 2 + 1.1)} y={Y(0) - 8} text-anchor="middle">N</text>
					<text class="fpic__pole-s" x={X(-COIL.len / 2 - 1.1)} y={Y(0) - 8} text-anchor="middle">S</text>
				</g>
			)}
		</g>
	</svg>
</div>

<style is:global>
	.fpic {
		margin: 0.75rem auto;
		max-width: 26rem;
	}
	.fpic svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.fpic__bg {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 75%, var(--ig-surface));
	}
	.fpic__lines path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		opacity: 0.85;
	}
	.fpic__lines .fpic__arrow {
		fill: var(--sl-color-gray-2);
		stroke: none;
		opacity: 1;
	}
	.fpic__core {
		fill: var(--sl-color-gray-4);
		opacity: 0.55;
	}
	.fpic__wire circle {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.fpic__wire--small circle {
		stroke-width: 1.4;
	}
	.fpic__wire .fpic__dot {
		fill: var(--ig-v);
		stroke: none;
	}
	.fpic__wire path {
		stroke: var(--ig-v);
		stroke-width: 1.3;
	}
	.fpic__magnet rect {
		stroke: none;
	}
	.fpic__n {
		fill: var(--ig-vx);
	}
	.fpic__s {
		fill: var(--ig-vy);
	}
	.fpic__magnet text {
		fill: var(--sl-color-black);
		font-size: 20px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.fpic__poles text {
		font-size: 18px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.fpic__pole-n {
		fill: var(--ig-vx);
	}
	.fpic__pole-s {
		fill: var(--ig-vy);
	}
</style>
