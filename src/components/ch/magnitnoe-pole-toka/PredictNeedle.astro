---
/**
 * «Predict, then check»: a wire with current (towards us or away from us) and a compass beside it.
 * The pupil chooses where the north end of the needle will point; then the needle turns and the line appears.
 * Towards the viewer — lines counter-clockwise; away — clockwise. The Earth's field is neglected (strong current).
 */
---

<figure class="pn not-content" data-pn>
	<p class="pn__q" data-q></p>
	<div class="pn__body">
		<svg class="pn__svg" viewBox="0 0 300 240" role="img" aria-label="Провод с током, вид сверху, и магнитная стрелка рядом с ним">
			<rect class="pn__bg" x="0" y="0" width="300" height="240" rx="14"></rect>
			<circle class="pn__line" cx="150" cy="120" r="90" data-line></circle>
			<g data-line-arrows class="pn__arrows"></g>
			<g transform="translate(150 120)" class="pn__wire">
				<circle r="15"></circle>
				<circle class="pn__dot" r="4.5" data-dot></circle>
				<path class="pn__cross" d="M -7 -7 L 7 7 M -7 7 L 7 -7" data-cross></path>
			</g>
			<g class="pn__cmp" data-cmp>
				<circle class="pn__case" r="25"></circle>
				<g class="pn__needle" data-needle>
					<path class="pn__n" d="M 0 -20 L 5 0 L -5 0 Z"></path>
					<path class="pn__s" d="M 0 20 L 5 0 L -5 0 Z"></path>
					<circle r="2" class="pn__pin"></circle>
				</g>
				<text class="pn__qmark" y="8" text-anchor="middle" data-qmark>?</text>
			</g>
		</svg>
		<div class="pn__side">
			<p class="pn__hint">Куда повернётся северный конец стрелки?</p>
			<div class="pn__opts" role="group" aria-label="Направление северного конца стрелки">
				<button type="button" class="pn__opt" data-ans="0" aria-label="вверх">↑</button>
				<button type="button" class="pn__opt" data-ans="1" aria-label="вправо">→</button>
				<button type="button" class="pn__opt" data-ans="2" aria-label="вниз">↓</button>
				<button type="button" class="pn__opt" data-ans="3" aria-label="влево">←</button>
			</div>
			<p class="pn__fb" data-fb aria-live="polite"></p>
			<button type="button" class="pn__next" data-next hidden>Следующая задача</button>
			<p class="pn__score" data-score></p>
		</div>
	</div>
	<figcaption class="pn__legend">Вид сверху. Ток сильный, так что магнитное поле Земли можно не учитывать.</figcaption>
</figure>

<style is:global>
	.pn {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.pn__q {
		margin: 0 0 0.6rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.pn__body {
		display: grid;
		grid-template-columns: minmax(0, 18rem) 1fr;
		gap: 1rem;
		align-items: center;
	}
	@media (max-width: 34rem) {
		.pn__body {
			grid-template-columns: 1fr;
		}
	}
	.pn__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.pn__bg {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 75%, var(--ig-surface));
	}
	.pn__line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-dasharray: 566;
		stroke-dashoffset: 566;
		transition: stroke-dashoffset 0.9s ease-out;
	}
	.pn.is-shown .pn__line {
		stroke-dashoffset: 0;
	}
	.pn__arrows path {
		fill: var(--sl-color-gray-2);
		opacity: 0;
		transition: opacity 0.4s 0.6s;
	}
	.pn.is-shown .pn__arrows path {
		opacity: 1;
	}
	.pn__wire circle {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 3;
	}
	.pn__wire .pn__dot {
		fill: var(--ig-v);
		stroke: none;
	}
	.pn__cross {
		stroke: var(--ig-v);
		stroke-width: 2.6;
	}
	.pn__case {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.pn__needle {
		opacity: 0;
		transition:
			transform 0.9s cubic-bezier(0.3, 1.5, 0.5, 1),
			opacity 0.3s;
	}
	.pn.is-shown .pn__needle {
		opacity: 1;
	}
	.pn__n {
		fill: var(--ig-vx);
	}
	.pn__s {
		fill: var(--ig-vy);
	}
	.pn__pin {
		fill: var(--sl-color-gray-1);
	}
	.pn__qmark {
		fill: var(--sl-color-gray-2);
		font-size: 24px;
		font-weight: 700;
		font-family: var(--__sl-font);
		transition: opacity 0.3s;
	}
	.pn.is-shown .pn__qmark {
		opacity: 0;
	}
	.pn__hint {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pn__opts {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.pn__opt {
		font: inherit;
		font-size: 1.4rem;
		line-height: 1;
		width: 3rem;
		height: 3rem;
		border-radius: 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			background 0.25s,
			border-color 0.25s;
	}
	.pn__opt:hover {
		border-color: var(--sl-color-accent);
	}
	.pn__opt.is-right {
		border-color: var(--sl-color-green);
		background: color-mix(in srgb, var(--sl-color-green) 22%, transparent);
	}
	.pn__opt.is-wrong {
		border-color: var(--sl-color-red);
		background: color-mix(in srgb, var(--sl-color-red) 16%, transparent);
	}
	.pn__fb {
		min-height: 2.6em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pn__next {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		cursor: pointer;
	}
	.pn__score {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.pn__legend {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (prefers-reduced-motion: reduce) {
		.pn__line,
		.pn__needle,
		.pn__arrows path {
			transition: none;
		}
	}
</style>

<script>
	const NS = 'http://www.w3.org/2000/svg';
	// positions of the compass: right, top, left, bottom (maths angle of the position)
	const SPOTS = [0, 90, 180, 270];
	const WORDS = ['справа от провода', 'над проводом', 'слева от провода', 'под проводом'];
	const DIRS = ['вверх', 'вправо', 'вниз', 'влево'];

	for (const root of document.querySelectorAll<HTMLElement>('[data-pn]')) {
		const q = root.querySelector<HTMLElement>('[data-q]')!;
		const cmp = root.querySelector<SVGGElement>('[data-cmp]')!;
		const needle = root.querySelector<SVGGElement>('[data-needle]')!;
		const dot = root.querySelector<SVGCircleElement>('[data-dot]')!;
		const cross = root.querySelector<SVGPathElement>('[data-cross]')!;
		const arrowsG = root.querySelector<SVGGElement>('[data-line-arrows]')!;
		const line = root.querySelector<SVGCircleElement>('[data-line]')!;
		const opts = [...root.querySelectorAll<HTMLButtonElement>('[data-ans]')];
		const fb = root.querySelector<HTMLElement>('[data-fb]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const score = root.querySelector<HTMLElement>('[data-score]')!;

		let towards = true;
		let spot = 0;
		let answer = 0;
		let done = false;
		let tries = 0;
		let right = 0;
		let total = 0;
		let lastKey = '';

		const setup = () => {
			let key = '';
			do {
				towards = Math.random() < 0.5;
				spot = Math.floor(Math.random() * 4);
				key = `${towards}${spot}`;
			} while (key === lastKey);
			lastKey = key;
			// counter-clockwise (towards us): the tangent is the position angle + 90°
			const tangent = (SPOTS[spot] + (towards ? 90 : -90) + 360) % 360;
			answer = { 90: 0, 0: 1, 270: 2, 180: 3 }[tangent]!;
			const a = (SPOTS[spot] * Math.PI) / 180;
			cmp.setAttribute('transform', `translate(${150 + 90 * Math.cos(a)} ${120 - 90 * Math.sin(a)})`);
			dot.style.display = towards ? '' : 'none';
			cross.style.display = towards ? 'none' : '';
			q.innerHTML = `Ток идёт ${towards ? '<b>к нам</b> (точка)' : '<b>от нас</b> (крестик)'}. Стрелка стоит ${WORDS[spot]}.`;
			// arrows on the line, drawn later
			arrowsG.replaceChildren();
			for (const th of [45, 135, 225, 315]) {
				const r = (th * Math.PI) / 180;
				const p = document.createElementNS(NS, 'path');
				p.setAttribute('d', 'M -6 -5 L 6 0 L -6 5 Z');
				const deg = -(th + 90) + (towards ? 0 : 180);
				p.setAttribute('transform', `translate(${150 + 90 * Math.cos(r)} ${120 - 90 * Math.sin(r)}) rotate(${deg})`);
				arrowsG.append(p);
			}
			line.style.transform = towards ? 'scale(1,-1)' : '';
			line.style.transformOrigin = '150px 120px';
			needle.style.transform = 'rotate(0deg)';
			root.classList.remove('is-shown');
			opts.forEach((o) => o.classList.remove('is-right', 'is-wrong'));
			fb.textContent = '';
			next.hidden = true;
			done = false;
			tries = 0;
		};

		const reveal = () => {
			root.classList.add('is-shown');
			needle.style.transform = `rotate(${answer * 90}deg)`;
			next.hidden = false;
			done = true;
		};

		opts.forEach((b) =>
			b.addEventListener('click', () => {
				if (done) return;
				const i = Number(b.dataset.ans);
				tries += 1;
				if (i === answer) {
					b.classList.add('is-right');
					if (tries === 1) right += 1;
					total += 1;
					fb.innerHTML = `<b>Верно!</b> Магнитная линия — окружность вокруг провода. Ток идёт ${towards ? 'к нам — линии идут против часовой стрелки' : 'от нас — линии идут по часовой стрелке'}, и северный конец стрелки показывает ${DIRS[answer]}.`;
					reveal();
				} else {
					b.classList.add('is-wrong');
					if (tries >= 2) {
						total += 1;
						opts[answer].classList.add('is-right');
						fb.innerHTML = `Правильный ответ — ${DIRS[answer]}. Стрелка встаёт по касательной к окружности вокруг провода. Если ток идёт ${towards ? 'к нам, линии направлены против часовой стрелки' : 'от нас, линии направлены по часовой стрелке'}.`;
						reveal();
					} else {
						fb.innerHTML =
							i === (answer + 2) % 4
								? 'Направление угадано наполовину: стрелка встаёт вдоль этой линии, но смотрит в другую сторону. Попробуйте ещё раз.'
								: 'Нет. Стрелка встаёт не к проводу и не от него, а по окружности вокруг провода. Попробуйте ещё раз.';
					}
				}
				score.textContent = total ? `Верно с первой попытки: ${right} из ${total}` : '';
			}),
		);
		next.addEventListener('click', setup);
		setup();
	}
</script>
