---
/**
 * Picture to the definition of the magnetic field: Oersted's experiment, drawn in an oblique view of a table.
 * A wire is stretched along a compass needle, from south to north, 44 px above it on two posts; the leads go along the
 * table to a source and a key. Projection: a point (n — north, e — east, z — up) is drawn at (180 + n, 86 + e/2 − z):
 * we stand on the east side and look west, north is to the right, west is away from us (up the picture).
 * The loop: the key closes — the current flows north in the wire and the needle swings to the west (up); the key
 * opens — the needle swings back to the north; the source is turned round — the key closes again, the current flows
 * south and the needle swings to the east (down); the key opens, the source is turned back.
 * Physics: under a wire with the current to the north the field of the current points west (B = μ0I/(2πr), its
 * direction I × r̂ with r̂ pointing down). Together with the Earth's horizontal field B_E (to the north) the needle
 * sets along the sum: φ = arctg(B_I/B_E) from the north; here B_I = 2,5·B_E, φ ≈ 68°. The needle is a damped
 * pendulum: period 1,4 s in the Earth's field alone, its stiffness ∝ |B|, so it swings faster when the current is on.
 */
const CX = 180;
const CY = 86;
const ZW = 44; // height of the wire over the needle
const POST = 140; // the posts at n = ±140
const LEAD = 160; // the leads lie on the table at e = 160
const yl = CY + LEAD / 2;
---

<figure class="oep not-content" data-oep>
	<div class="oep__stage">
		<svg class="oep__svg" viewBox="0 0 360 198" role="img" aria-label="Опыт Эрстеда. Над магнитной стрелкой вдоль неё натянут провод. Когда ключ замыкают, стрелка поворачивается; когда размыкают, возвращается на север; когда ток пускают в обратную сторону, стрелка поворачивается в другую сторону">
			<rect class="oep__table" x="6" y="26" width="348" height="168" rx="10"></rect>
			<!-- north on the table -->
			<path class="oep__north" d={`M 270 ${CY + 38} H 312 M 305 ${CY + 33.5} L 313 ${CY + 38} L 305 ${CY + 42.5}`}></path>
			<text class="oep__lbl oep__lbl--quiet" x="291" y={CY + 30} text-anchor="middle">север</text>
			<!-- the leads on the table -->
			<path class="oep__lead" d={`M ${CX - POST} ${CY} V ${yl} H 90 M 150 ${yl} H 215 M 255 ${yl} H ${CX + POST} V ${CY}`}></path>
			<path class="oep__lead oep__lead--live" d={`M ${CX - POST} ${CY} V ${yl} H 90 M 150 ${yl} H 215 M 255 ${yl} H ${CX + POST} V ${CY}`} data-live-lead></path>
			<!-- the shadow of the wire on the table -->
			<line class="oep__shadow" x1={CX - POST} y1={CY} x2={CX + POST} y2={CY}></line>
			<!-- the compass -->
			<ellipse class="oep__case" cx={CX} cy={CY} rx="52" ry="26"></ellipse>
			<ellipse class="oep__dial" cx={CX} cy={CY} rx="46" ry="23"></ellipse>
			<g data-needle>
				<polygon class="oep__n" points="" data-n></polygon>
				<polygon class="oep__s" points="" data-s></polygon>
			</g>
			<circle class="oep__pin" cx={CX} cy={CY} r="2.4"></circle>
			<!-- the posts and the wire over the needle -->
			<rect class="oep__post" x={CX - POST - 3} y={CY - ZW - 2} width="6" height={ZW + 4} rx="2"></rect>
			<rect class="oep__post" x={CX + POST - 3} y={CY - ZW - 2} width="6" height={ZW + 4} rx="2"></rect>
			<line class="oep__wire" x1={CX - POST} y1={CY - ZW} x2={CX + POST} y2={CY - ZW}></line>
			<line class="oep__wire oep__wire--live" x1={CX - POST} y1={CY - ZW} x2={CX + POST} y2={CY - ZW} data-live></line>
			<g data-chevrons></g>
			<text class="oep__lbl" x={CX} y={CY - ZW - 10} text-anchor="middle">провод</text>
			<!-- the source: a cell lying on the table; the script turns it round -->
			<g transform={`translate(120 ${yl})`}>
				<g data-cell>
					<rect class="oep__cell" x="-30" y="-10" width="60" height="20" rx="4"></rect>
					<rect class="oep__nub" x="-35" y="-4" width="5" height="8" rx="1.5" data-nub></rect>
					<text class="oep__sign" x="-21" y="5" text-anchor="middle" data-plus>+</text>
					<text class="oep__sign" x="21" y="5" text-anchor="middle" data-minus>−</text>
				</g>
			</g>
			<text class="oep__lbl" x="120" y={yl + 22} text-anchor="middle">источник тока</text>
			<!-- the key -->
			<circle class="oep__contact" cx="215" cy={yl} r="3"></circle>
			<circle class="oep__contact" cx="255" cy={yl} r="3"></circle>
			<line class="oep__lever" x1="215" y1={yl} x2="255" y2={yl} data-lever></line>
			<text class="oep__lbl" x="235" y={yl + 22} text-anchor="middle">ключ</text>
			<text class="oep__lbl" x={CX} y={CY + 42} text-anchor="middle">магнитная стрелка</text>
		</svg>
	</div>
	<p class="oep__status" data-status aria-live="polite"></p>
	<figcaption class="oep__legend">
		<span class="oep__key oep__key--n"></span>северный конец стрелки, <span class="oep__key oep__key--s"></span>южный.
		Провод натянут над стрелкой вдоль неё, с юга на север. Совсем поперёк провода стрелка не встаёт: её по-прежнему
		поворачивает на север магнитное поле Земли.
	</figcaption>
</figure>

<style is:global>
	.oep {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.oep__stage {
		padding: 0.4rem;
		border-radius: 0.8rem;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-6);
	}
	.oep__svg {
		display: block;
		width: 100%;
		max-width: 500px;
		margin-inline: auto;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.oep__table {
		fill: color-mix(in srgb, var(--ig-v) 10%, var(--sl-color-gray-6));
	}
	.oep__north {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.oep__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.oep__lead--live,
	.oep__wire--live {
		stroke: var(--ig-v);
		opacity: 0;
	}
	.oep__shadow {
		stroke: var(--sl-color-gray-4);
		stroke-width: 4;
		opacity: 0.2;
	}
	.oep__case {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.oep__dial {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.oep__n {
		fill: var(--ig-vx);
	}
	.oep__s {
		fill: var(--ig-vy);
	}
	.oep__pin {
		fill: var(--sl-color-gray-2);
	}
	.oep__post {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.oep__wire {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.oep__wire--live {
		stroke-width: 3.4;
	}
	.oep__chev {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.oep__cell {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.oep__nub {
		fill: var(--sl-color-gray-3);
	}
	.oep__sign {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.oep__contact {
		fill: var(--sl-color-gray-2);
	}
	.oep__lever {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.oep__lbl {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		font-family: var(--__sl-font);
	}
	.oep__lbl--quiet {
		fill: var(--sl-color-gray-3);
	}
	.oep__status {
		margin: 0.7rem 0 0;
		min-height: 3em;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
	}
	.oep__legend {
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
	}
	.oep__key {
		display: inline-block;
		width: 0.9em;
		height: 0.45em;
		margin-inline: 0.1em 0.35em;
		border-radius: 0.2em;
		vertical-align: 0.1em;
	}
	.oep__key--n {
		background: var(--ig-vx);
	}
	.oep__key--s {
		background: var(--ig-vy);
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const CX = 180;
	const CY = 86;
	const ZW = 44;
	const POST = 140;
	const RUN = 14; // s
	const K = 2.5; // B of the current / B of the Earth at the needle
	const OMEGA = (2 * Math.PI) / 1.4; // the needle in the Earth's field alone
	const GAMMA = 3; // damping, 1/s
	const L = 42; // half-length of the needle
	const HW = 5; // half-width
	// the script of one run: [start, end] of each current (fractions of RUN) and its direction (+1 — to the north)
	const CURRENTS = [
		{ on: 0.07, off: 0.32, dir: 1 },
		{ on: 0.62, off: 0.82, dir: -1 },
	];
	const KEY = [
		[0.04, 0.07, 0.32, 0.35],
		[0.59, 0.62, 0.82, 0.85],
	]; // the lever goes down, stays, goes up
	const FLIPS = [
		[0.44, 0.54],
		[0.88, 0.98],
	]; // the cell is turned round
	const clamp = (v: number) => Math.min(1, Math.max(0, v));
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);

	const currentAt = (x: number) => {
		for (const c of CURRENTS) if (x >= c.on && x < c.off) return c.dir;
		return 0;
	};
	// the needle angle (from the north towards the west, radians) over one run, at 240 Hz
	const DT = 1 / 240;
	const PHI: number[] = [];
	{
		let a = 0;
		let w = 0;
		for (let i = 0; i <= RUN / DT; i++) {
			PHI.push(a);
			const d = currentAt((i * DT) / RUN);
			const target = d === 0 ? 0 : d * Math.atan(K);
			const b = d === 0 ? 1 : Math.hypot(1, K);
			for (let j = 0; j < 4; j++) {
				const h = DT / 4;
				w += (-OMEGA * OMEGA * b * Math.sin(a - target) - GAMMA * w) * h;
				a += w * h;
			}
		}
	}
	const phiAt = (t: number) => {
		const i = Math.min(PHI.length - 1, Math.max(0, Math.round(t / DT)));
		return PHI[i];
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-oep]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const nEl = $<SVGPolygonElement>('[data-n]');
		const sEl = $<SVGPolygonElement>('[data-s]');
		const live = $<SVGLineElement>('[data-live]');
		const liveLead = $<SVGPathElement>('[data-live-lead]');
		const chevG = $<SVGGElement>('[data-chevrons]');
		const cell = $<SVGGElement>('[data-cell]');
		const nub = $<SVGRectElement>('[data-nub]');
		const plus = $<SVGTextElement>('[data-plus]');
		const minus = $<SVGTextElement>('[data-minus]');
		const lever = $<SVGLineElement>('[data-lever]');
		const status = $<HTMLElement>('[data-status]');
		const chevs: SVGPathElement[] = [];
		for (let k = 0; k < 7; k++) {
			const p = document.createElementNS(NS, 'path');
			p.setAttribute('class', 'oep__chev');
			chevG.append(p);
			chevs.push(p);
		}
		// a point of the table plane (n, e) on the screen
		const P = (n: number, e: number) => `${f1(CX + n)},${f1(CY + e / 2)}`;
		let said = '';
		const say = (s: string) => {
			if (s !== said) status.innerHTML = said = s;
		};

		const draw = (t: number) => {
			const x = (t % RUN) / RUN;
			// the needle: N half and S half
			const a = phiAt(t % RUN);
			const dn = Math.cos(a);
			const de = -Math.sin(a); // the west is −e
			const pn = Math.sin(a);
			const pe = Math.cos(a);
			nEl.setAttribute('points', [P(L * dn, L * de), P(HW * pn, HW * pe), P(-HW * pn, -HW * pe)].join(' '));
			sEl.setAttribute('points', [P(-L * dn, -L * de), P(HW * pn, HW * pe), P(-HW * pn, -HW * pe)].join(' '));
			// the current
			const d = currentAt(x);
			live.style.opacity = d ? '1' : '0';
			liveLead.style.opacity = d ? '0.8' : '0';
			chevs.forEach((c, k) => {
				if (!d) {
					c.setAttribute('d', '');
					return;
				}
				const span = 2 * POST - 20;
				const s = (((k / chevs.length) * span + t * 40 * d) % span + span) % span;
				const cx = CX - POST + 10 + s;
				const y = CY - ZW;
				c.setAttribute('d', `M ${f1(cx - 4 * d)} ${y - 5} L ${f1(cx + 3 * d)} ${y} L ${f1(cx - 4 * d)} ${y + 5}`);
			});
			// the key: open — the lever up by 30°
			let down = 0;
			for (const [a0, a1, b0, b1] of KEY) down = Math.max(down, smooth(a0, a1, x) * (1 - smooth(b0, b1, x)));
			const ang = ((1 - down) * 30 * Math.PI) / 180;
			lever.setAttribute('x2', f1(215 + 40 * Math.cos(ang)));
			lever.setAttribute('y2', f1(CY + 80 - 40 * Math.sin(ang))); // the leads lie at CY + 80
			// the cell: its «+» on the left in the first half (the current goes up the left post and north along the wire)
			let turned = 0;
			for (const [a0, a1] of FLIPS) turned += smooth(a0, a1, x);
			const c = Math.cos(Math.PI * turned);
			const flip = c < 0;
			cell.setAttribute('transform', `scale(${Math.abs(c).toFixed(3)} 1)`);
			nub.setAttribute('x', flip ? '30' : '-35');
			plus.setAttribute('x', flip ? '21' : '-21');
			minus.setAttribute('x', flip ? '-21' : '21');
			// what is going on
			if (d > 0) say('Ключ замкнули: ток идёт по проводу <b>на север</b>, и стрелка под проводом повернулась.');
			else if (d < 0) say('Ток идёт в обратную сторону, <b>на юг</b>, и стрелка повернулась <b>в другую сторону</b>.');
			else if (x >= 0.44 && x < 0.62) say('Источник повернули другой стороной: теперь ток пойдёт по проводу в обратную сторону.');
			else if (x >= 0.32) say('Ключ разомкнули: тока нет, и стрелка вернулась на север.');
			else say('Ключ разомкнут, тока нет. Стрелка показывает на север, как компас.');
		};

		let t = 0;
		draw(0);
		loop(root, (dt) => {
			t += dt;
			draw(t);
			return true;
		});
	}
</script>
