---
/**
 * Picture to the definition of magnetic lines. A sheet seen from above; a long straight wire pierces it, the current
 * flows towards the viewer (a dot). A small compass is carried once round the wire at a constant distance; its
 * needle always lies along the circle, the north end counter-clockwise (the field of a current towards the viewer,
 * B = μ0I/(2πr) along the tangent). Every 30° it leaves a faint copy of the needle; after the full turn the
 * circle — the magnetic line — appears with arrows in the direction the north end points.
 * The current is strong: near the wire the Earth's field is neglected (said in the caption).
 */
const CX = 180;
const CY = 96;
const R = 66;
---

<figure class="lnp not-content" data-lnp>
	<div class="lnp__stage">
		<svg class="lnp__svg" viewBox="0 0 360 192" role="img" aria-label="Вокруг провода с током переносят маленькую магнитную стрелку. Её ось всё время направлена вдоль окружности с центром на проводе. Эта окружность — магнитная линия">
			<g class="lnp__line" data-line>
				<circle cx={CX} cy={CY} r={R}></circle>
				<path class="lnp__arrow" transform={`translate(${CX - R} ${CY}) rotate(90)`} d="M -7 -6 L 7 0 L -7 6 Z"></path>
				<path class="lnp__arrow" transform={`translate(${CX + R} ${CY}) rotate(-90)`} d="M -7 -6 L 7 0 L -7 6 Z"></path>
			</g>
			<g data-ghosts></g>
			<g class="lnp__wire" transform={`translate(${CX} ${CY})`}>
				<circle r="9"></circle>
				<circle class="lnp__dot" r="3"></circle>
			</g>
			<text class="lnp__lbl" x={CX} y={CY + 28} text-anchor="middle">ток к нам</text>
			<g data-cmp>
				<circle class="lnp__case" r="14"></circle>
				<g data-needle>
					<path class="lnp__n" d="M 11 0 L 0 -3.2 L 0 3.2 Z"></path>
					<path class="lnp__s" d="M -11 0 L 0 -3.2 L 0 3.2 Z"></path>
					<circle class="lnp__pin" r="1.4"></circle>
				</g>
			</g>
			<text class="lnp__lbl lnp__lbl--line" x={CX + R + 12} y={CY - 40} data-line-lbl>магнитная линия</text>
		</svg>
	</div>
	<figcaption class="lnp__legend">
		Вид сверху на лист картона. Сквозь него проходит провод, ток идёт к нам. Маленькую магнитную стрелку переносят
		вокруг провода: её ось всё время направлена вдоль одной и той же окружности — это и есть магнитная линия. Стрелка
		на линии показывает, куда указывает <span class="lnp__key"></span>северный конец. Ток сильный, и магнитное поле
		Земли рядом с проводом незаметно.
	</figcaption>
</figure>

<style is:global>
	.lnp {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.lnp__stage {
		padding: 0.4rem;
		border-radius: 0.8rem;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-6);
	}
	.lnp__svg {
		display: block;
		width: 100%;
		max-width: 440px;
		margin-inline: auto;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.lnp__line circle {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.lnp__line .lnp__arrow {
		fill: var(--sl-color-gray-2);
	}
	.lnp__wire circle {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.lnp__wire .lnp__dot {
		fill: var(--ig-v);
		stroke: none;
	}
	.lnp__case {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.lnp__n {
		fill: var(--ig-vx);
	}
	.lnp__s {
		fill: var(--ig-vy);
	}
	.lnp__pin {
		fill: var(--sl-color-gray-2);
	}
	.lnp__ghost .lnp__n,
	.lnp__ghost .lnp__s {
		opacity: 0.55;
	}
	.lnp__lbl {
		font-size: 12px;
		fill: var(--sl-color-gray-3);
		font-family: var(--__sl-font);
	}
	.lnp__lbl--line {
		fill: var(--sl-color-gray-2);
	}
	.lnp__legend {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
	}
	.lnp__key {
		display: inline-block;
		width: 0.9em;
		height: 0.45em;
		margin-inline: 0.1em 0.3em;
		border-radius: 0.2em;
		vertical-align: 0.1em;
		background: var(--ig-vx);
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const CX = 180;
	const CY = 96;
	const R = 66;
	const RUN = 9; // s
	const START = Math.PI / 2; // the compass starts above the wire
	const clamp = (v: number) => Math.min(1, Math.max(0, v));
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-lnp]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const line = $<SVGGElement>('[data-line]');
		const lineLbl = $<SVGTextElement>('[data-line-lbl]');
		const cmp = $<SVGGElement>('[data-cmp]');
		const needle = $<SVGGElement>('[data-needle]');
		const ghostsG = $<SVGGElement>('[data-ghosts]');
		const proto = needle.cloneNode(true) as SVGGElement;
		const ghosts: SVGGElement[] = [];
		for (let k = 0; k < 12; k++) {
			const g = document.createElementNS(NS, 'g');
			g.setAttribute('class', 'lnp__ghost');
			const th = START + (k * Math.PI) / 6;
			const deg = (-(th + Math.PI / 2) * 180) / Math.PI; // the tangent, counter-clockwise on the screen
			g.setAttribute('transform', `translate(${f1(CX + R * Math.cos(th))} ${f1(CY - R * Math.sin(th))}) rotate(${f1(deg)}) scale(0.75)`);
			g.append(proto.cloneNode(true));
			ghostsG.append(g);
			ghosts.push(g);
		}

		const draw = (t: number) => {
			const x = (t % RUN) / RUN;
			const p = smooth(0.08, 0.72, x); // the share of the turn done
			const fade = 1 - smooth(0.95, 1, x);
			const th = START + 2 * Math.PI * p;
			const deg = (-(th + Math.PI / 2) * 180) / Math.PI;
			cmp.setAttribute('transform', `translate(${f1(CX + R * Math.cos(th))} ${f1(CY - R * Math.sin(th))})`);
			needle.setAttribute('transform', `rotate(${f1(deg)})`);
			cmp.style.opacity = String(fade);
			ghosts.forEach((g, k) => {
				const passed = x > 0.08 && p * 12 >= k + 0.5;
				g.style.opacity = passed ? String(fade) : '0';
			});
			const show = smooth(0.74, 0.84, x) * fade;
			line.style.opacity = String(show);
			lineLbl.style.opacity = String(show);
		};

		let t = 0;
		draw(0);
		loop(root, (dt) => {
			t += dt;
			draw(t);
			return true;
		});
	}
</script>
