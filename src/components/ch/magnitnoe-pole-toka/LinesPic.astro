---
/**
 * Picture to the definition of magnetic lines: the field of a long straight wire, in four views (chips).
 * A small compass is carried once round the wire at a constant distance; its needle always lies along the circle,
 * the north end along B. Every 30° it leaves a faint copy of the needle; after the full turn the circle — the
 * magnetic line — appears with arrows in the direction the north end points.
 * Physics: B = μ0I/(2πr), its direction I × r̂. Axes: x to the right, y up the page, z towards the viewer.
 * In the plane of a line, a point is (u, v) = (r cos φ, r sin φ); then B ∝ s·(−sin φ, cos φ), where
 * - «к нам» (I along +z, end-on view, (u, v) = (x, y)): z × r̂ gives s = +1, counter-clockwise;
 * - «от нас» (I along −z): s = −1, clockwise;
 * - «вверх» (I along +y, side view, (u, v) = (x, z)): y × r̂ = (sin φ, −cos φ) in (x, z), s = −1: in front of the
 *   wire (φ = 90°) B points right, on the right (φ = 0) B = −z (⊗, away from us), on the left +z (⊙);
 * - «вниз» (I along −y): s = +1: in front B points left, on the right ⊙, on the left ⊗.
 * Side views look a little from above: a point (x, y, z) is drawn at (CX + x, Y − y + K·z), so a circle is an
 * ellipse, its front half (z > 0) the lower one; the back half is faint and passes behind the wire.
 * The current is strong: near the wire the Earth's field is neglected (said in the caption).
 */
const W = 360;
const H = 220;
const uid = `lnp-${Math.random().toString(36).slice(2, 8)}`;
const VIEWS = [
	{ v: 'to', t: 'к нам' },
	{ v: 'from', t: 'от нас' },
	{ v: 'up', t: 'вверх' },
	{ v: 'down', t: 'вниз' },
];
---

<figure class="lnp not-content" data-lnp>
	<div class="lnp__views" role="radiogroup" aria-label="Куда идёт ток">
		<span class="lnp__views-lbl">Ток:</span>
		{
			VIEWS.map(({ v, t }, k) => (
				<button type="button" class:list={['lnp__view', { 'is-on': k === 0 }]} role="radio" aria-checked={k === 0 ? 'true' : 'false'} data-view={v}>
					<svg class="lnp__ico" viewBox="0 0 16 16" aria-hidden="true">
						{v === 'to' && (
							<>
								<circle cx="8" cy="8" r="6.2" />
								<circle class="lnp__ico-fill" cx="8" cy="8" r="1.9" />
							</>
						)}
						{v === 'from' && (
							<>
								<circle cx="8" cy="8" r="6.2" />
								<path d="M 4.2 4.2 L 11.8 11.8 M 11.8 4.2 L 4.2 11.8" />
							</>
						)}
						{v === 'up' && <path d="M 8 14.5 V 2.5 M 3.8 6.6 L 8 2.2 L 12.2 6.6" />}
						{v === 'down' && <path d="M 8 1.5 V 13.5 M 3.8 9.4 L 8 13.8 L 12.2 9.4" />}
					</svg>
					{t}
				</button>
			))
		}
	</div>
	<div class="lnp__stage">
		<svg class="lnp__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="" data-svg>
			<defs>
				<clipPath id={`${uid}-wire`}><rect x="175" y="0" width="10" height={H}></rect></clipPath>
			</defs>
			<g data-back></g>
			<g data-wire></g>
			<g class="lnp__chev" clip-path={`url(#${uid}-wire)`} data-chev></g>
			<g data-front></g>
			<g data-cmp>
				<ellipse class="lnp__case" rx="14" ry="14" data-case></ellipse>
				<polygon class="lnp__n" points="" data-n></polygon>
				<polygon class="lnp__s" points="" data-s></polygon>
				<circle class="lnp__pin" r="1.4" data-pin></circle>
			</g>
			<g data-labels></g>
		</svg>
	</div>
	<figcaption class="lnp__legend">
		<span class="lnp__say" data-say aria-live="polite"></span>{' '}
		Стрелка на линии показывает, куда указывает <span class="lnp__key"></span>северный конец магнитной стрелки. Ток
		сильный, и магнитное поле Земли рядом с проводом незаметно.
	</figcaption>
</figure>

<style is:global>
	.lnp {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.lnp__views {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 0.6rem;
	}
	.lnp__views-lbl {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		margin-right: 0.1rem;
	}
	.lnp__view {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		line-height: 1.2;
		padding: 0.3rem 0.75rem 0.3rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.lnp__view.is-on {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.lnp__ico {
		width: 1em;
		height: 1em;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lnp__ico .lnp__ico-fill {
		fill: currentColor;
		stroke: none;
	}
	.lnp__stage {
		padding: 0.4rem;
		border-radius: 0.8rem;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-6);
	}
	.lnp__svg {
		display: block;
		width: 100%;
		max-width: 440px;
		margin-inline: auto;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.lnp__ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.lnp__ring--back {
		stroke-width: 1.4;
		stroke-dasharray: 4 4;
		opacity: 0.5;
	}
	.lnp__arrow {
		fill: var(--sl-color-gray-2);
	}
	.lnp__arrow--back {
		opacity: 0.5;
	}
	.lnp__mark {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.lnp__mark-dot {
		fill: var(--sl-color-gray-2);
	}
	.lnp__mark-x {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.lnp__wire-end {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.lnp__wire-dot {
		fill: var(--ig-v);
	}
	.lnp__wire-x {
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.lnp__wire-side {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 1.6;
	}
	.lnp__chev path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lnp__cur {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lnp__case {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.lnp__n {
		fill: var(--ig-vx);
	}
	.lnp__s {
		fill: var(--ig-vy);
	}
	.lnp__pin {
		fill: var(--sl-color-gray-2);
	}
	.lnp__ghost {
		opacity: 0;
	}
	.lnp__ghost polygon {
		opacity: 0.55;
	}
	.lnp__ghost--back polygon {
		opacity: 0.3;
	}
	.lnp__lbl {
		font-size: 12px;
		fill: var(--sl-color-gray-3);
		font-family: var(--__sl-font);
	}
	.lnp__lbl--line {
		fill: var(--sl-color-gray-2);
	}
	.lnp__lbl--cur {
		fill: var(--ig-v);
		font-weight: 600;
	}
	.lnp__legend {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
	}
	.lnp__say {
		color: var(--sl-color-gray-2);
	}
	.lnp__say b {
		color: var(--sl-color-white);
	}
	.lnp__sym {
		width: 1.05em;
		height: 1.05em;
		vertical-align: -0.17em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.lnp__sym circle + circle {
		fill: currentColor;
		stroke: none;
	}
	.lnp__key {
		display: inline-block;
		width: 0.9em;
		height: 0.45em;
		margin-inline: 0.1em 0.3em;
		border-radius: 0.2em;
		vertical-align: 0.1em;
		background: var(--ig-vx);
	}
	@media (max-width: 40rem) {
		.lnp {
			padding: 0.75rem;
		}
		.lnp__views {
			gap: 0.3rem;
		}
		.lnp__view {
			gap: 0.25rem;
			padding: 0.25rem 0.5rem 0.25rem 0.4rem;
			font-size: var(--sl-text-xs);
		}
		.lnp__views-lbl {
			font-size: var(--sl-text-xs);
		}
		.lnp__lbl {
			font-size: 13px;
		}
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const CX = 180;
	const R = 66; // radius of the magnetic line
	const CY_END = 108; // the wire end-on
	const RINGS = [62, 128, 194]; // side views: heights of the lines on the screen; the compass goes round the middle one
	const K = 0.4; // side views: foreshortening of a horizontal circle
	const RUN = 9; // s
	const L = 11; // half-length of a needle
	const HW = 3.2; // half-width
	const clamp = (v: number) => Math.min(1, Math.max(0, v));
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);
	type View = 'to' | 'from' | 'up' | 'down';
	const SYM = {
		dot: '<svg class="lnp__sym" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.3"/><circle cx="8" cy="8" r="1.9"/></svg>',
		cross: '<svg class="lnp__sym" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.3"/><path d="M 4.3 4.3 L 11.7 11.7 M 11.7 4.3 L 4.3 11.7"/></svg>',
	};
	const SAY: Record<View, string> = {
		to: `Вид сверху на лист картона, сквозь него проходит провод, <b>ток идёт к нам</b> ${SYM.dot}. Ось стрелки, которую переносят вокруг провода, всё время направлена вдоль окружности — магнитной линии; линия направлена <b>против часовой стрелки</b>.`,
		from: `То же, но <b>ток идёт от нас</b> ${SYM.cross}. Стрелка развернулась, и магнитная линия направлена <b>по часовой стрелке</b>.`,
		up: `Провод вертикальный, <b>ток идёт вверх</b>. Мы смотрим сбоку и немного сверху, поэтому окружности видны как овалы (их задняя половина — бледнее): перед проводом линии идут вправо, за ним — влево, справа от провода они уходят от нас ${SYM.cross}, слева идут к нам ${SYM.dot}.`,
		down: `<b>Ток идёт вниз</b>, и линии повернули в обратную сторону: перед проводом они идут влево, за ним — вправо, справа от провода линии идут к нам ${SYM.dot}, слева уходят от нас ${SYM.cross}.`,
	};
	const ARIA: Record<View, string> = {
		to: 'Провод виден сверху, ток идёт к нам. Вокруг провода переносят маленькую магнитную стрелку, её ось всё время направлена вдоль окружности с центром на проводе. Эта окружность — магнитная линия, она направлена против часовой стрелки.',
		from: 'Провод виден сверху, ток идёт от нас. Стрелку переносят вокруг провода; магнитная линия — окружность, направленная по часовой стрелке.',
		up: 'Вертикальный провод, ток идёт вверх. Магнитные линии — окружности вокруг провода, видны сбоку как овалы. Перед проводом они идут вправо; справа от провода уходят от нас, слева идут к нам.',
		down: 'Вертикальный провод, ток идёт вниз. Магнитные линии — окружности вокруг провода, видны сбоку как овалы. Перед проводом они идут влево; справа от провода идут к нам, слева уходят от нас.',
	};

	const el = (tag: string, attrs: Record<string, string | number>, parent?: Element) => {
		const e = document.createElementNS(NS, tag) as SVGElement;
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent?.append(e);
		return e;
	};

	/** The geometry of one view: where a point (u, v) of a line plane is drawn, and the sense of the lines. */
	const geom = (view: View) => {
		const side = view === 'up' || view === 'down';
		const s = view === 'to' || view === 'down' ? 1 : -1; // B ∝ s·(−sin φ, cos φ)
		// a point of the plane of the line: side views at the screen height y0, end-on round the wire
		const P = (u: number, v: number, y0 = RINGS[1]): [number, number] => (side ? [CX + u, y0 + K * v] : [CX + u, CY_END - v]);
		// an offset in that plane on the screen
		const D = (du: number, dv: number): [number, number] => (side ? [du, K * dv] : [du, -dv]);
		const B = (phi: number): [number, number] => [-s * Math.sin(phi), s * Math.cos(phi)];
		return { side, s, P, D, B };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-lnp]')) {
		const $ = <T extends Element>(q: string) => root.querySelector<T>(q)!;
		const svg = $<SVGSVGElement>('[data-svg]');
		const back = $<SVGGElement>('[data-back]');
		const wireG = $<SVGGElement>('[data-wire]');
		const chevG = $<SVGGElement>('[data-chev]');
		const front = $<SVGGElement>('[data-front]');
		const labels = $<SVGGElement>('[data-labels]');
		const cmp = $<SVGGElement>('[data-cmp]');
		const caseEl = $<SVGEllipseElement>('[data-case]');
		const pin = $<SVGCircleElement>('[data-pin]');
		const nEl = $<SVGPolygonElement>('[data-n]');
		const sEl = $<SVGPolygonElement>('[data-s]');
		const say = $<HTMLElement>('[data-say]');
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];

		let g = geom('to');
		const START = Math.PI / 2; // the compass starts above the wire (end-on) or in front of it (side)
		let lineEls: SVGElement[] = []; // appear after the turn
		let ghosts: { e: SVGElement; k: number }[] = [];
		let chevs: SVGElement[] = [];
		let curDir = 0; // side views: +1 the current goes up, −1 down

		// a needle (two triangles) at the angle φ of the compass circle, along B
		const needle = (phi: number, n: SVGElement, so: SVGElement, scale = 1) => {
			const [x, y] = g.P(R * Math.cos(phi), R * Math.sin(phi));
			const [bu, bv] = g.B(phi);
			const pt = (a: number, b: number) => {
				const [dx, dy] = g.D(a * bu - b * bv, a * bv + b * bu); // a along B, b across it
				return `${f1(x + scale * dx)},${f1(y + scale * dy)}`;
			};
			n.setAttribute('points', [pt(L, 0), pt(0, HW), pt(0, -HW)].join(' '));
			so.setAttribute('points', [pt(-L, 0), pt(0, HW), pt(0, -HW)].join(' '));
			return [x, y];
		};

		// an arrowhead on the line at the screen height y0, at the angle φ
		const arrow = (parent: Element, phi: number, y0: number, cls: string) => {
			const [x, y] = g.P(R * Math.cos(phi), R * Math.sin(phi), y0);
			const [dx, dy] = g.D(...g.B(phi));
			const deg = (Math.atan2(dy, dx) * 180) / Math.PI;
			return el('path', { class: cls, transform: `translate(${f1(x)} ${f1(y)}) rotate(${f1(deg)})`, d: 'M -7 -5.5 L 7 0 L -7 5.5 Z' }, parent);
		};

		// part of a line in a side view: φ from a to b
		const arc = (parent: Element, y0: number, a: number, b: number, cls: string) => {
			const pts: string[] = [];
			for (let k = 0; k <= 48; k++) {
				const phi = a + ((b - a) * k) / 48;
				const [x, y] = g.P(R * Math.cos(phi), R * Math.sin(phi), y0);
				pts.push(`${f1(x)},${f1(y)}`);
			}
			return el('polyline', { class: cls, points: pts.join(' ') }, parent);
		};

		// the point where a line pierces the plane of the page: ⊙ (towards us) or ⊗ (away)
		const mark = (parent: Element, x: number, y: number, towards: boolean) => {
			const m = el('g', { transform: `translate(${f1(x)} ${f1(y)})` }, parent);
			el('circle', { class: 'lnp__mark', r: 6.5 }, m);
			if (towards) el('circle', { class: 'lnp__mark-dot', r: 2 }, m);
			else el('path', { class: 'lnp__mark-x', d: 'M -3.6 -3.6 L 3.6 3.6 M 3.6 -3.6 L -3.6 3.6' }, m);
		};

		const build = (view: View) => {
			g = geom(view);
			for (const grp of [back, wireG, chevG, front, labels]) grp.replaceChildren();
			lineEls = [];
			ghosts = [];
			chevs = [];
			const label = (x: number, y: number, text: string, cls = 'lnp__lbl', anchor = 'start') => {
				const t = el('text', { class: cls, x, y, 'text-anchor': anchor }, labels);
				t.textContent = text;
				return t;
			};
			if (!g.side) {
				curDir = 0;
				// the line: a circle with two arrows
				const ring = el('g', {}, front);
				el('circle', { class: 'lnp__ring', cx: CX, cy: CY_END, r: R }, ring);
				arrow(ring, Math.PI, 0, 'lnp__arrow');
				arrow(ring, 0, 0, 'lnp__arrow');
				lineEls.push(ring);
				// the wire end-on: ⊙ or ⊗
				const w = el('g', { transform: `translate(${CX} ${CY_END})` }, wireG);
				el('circle', { class: 'lnp__wire-end', r: 9 }, w);
				if (view === 'to') el('circle', { class: 'lnp__wire-dot', r: 3 }, w);
				else el('path', { class: 'lnp__wire-x', d: 'M -4.6 -4.6 L 4.6 4.6 M 4.6 -4.6 L -4.6 4.6' }, w);
				label(CX, CY_END + 28, view === 'to' ? 'ток к нам' : 'ток от нас', 'lnp__lbl lnp__lbl--cur', 'middle');
				lineEls.push(label(CX + R + 12, CY_END - 46, 'магнитная', 'lnp__lbl lnp__lbl--line'));
				lineEls.push(label(CX + R + 12, CY_END - 31, 'линия', 'lnp__lbl lnp__lbl--line'));
				caseEl.setAttribute('ry', '14');
			} else {
				curDir = view === 'up' ? 1 : -1;
				// the wire in the plane of the page; chevrons move along it with the current
				el('rect', { class: 'lnp__wire-side', x: CX - 5, y: -4, width: 10, height: 228, rx: 2 }, wireG);
				for (let k = 0; k < 10; k++) chevs.push(el('path', { d: curDir > 0 ? 'M -3 2 L 0 -1.5 L 3 2' : 'M -3 -2 L 0 1.5 L 3 -2' }, chevG));
				// the current arrow next to the wire, at the top
				const ax = CX + 20;
				el('path', { class: 'lnp__cur', d: curDir > 0 ? `M ${ax} 33 V 9 M ${ax - 4.5} 15 L ${ax} 8 L ${ax + 4.5} 15` : `M ${ax} 8 V 32 M ${ax - 4.5} 26 L ${ax} 33 L ${ax + 4.5} 26` }, labels);
				label(ax + 9, 25, 'ток', 'lnp__lbl lnp__lbl--cur');
				// the lines: back halves behind the wire, front halves in front of it
				RINGS.forEach((y0, i) => {
					const b = el('g', {}, back);
					arc(b, y0, Math.PI, 2 * Math.PI, 'lnp__ring lnp__ring--back');
					arrow(b, 1.5 * Math.PI - 0.75, y0, 'lnp__arrow lnp__arrow--back');
					arrow(b, 1.5 * Math.PI + 0.75, y0, 'lnp__arrow lnp__arrow--back');
					const f = el('g', {}, front);
					arc(f, y0, 0, Math.PI, 'lnp__ring');
					arrow(f, Math.PI / 2 - 0.75, y0, 'lnp__arrow');
					arrow(f, Math.PI / 2 + 0.75, y0, 'lnp__arrow');
					// where the line pierces the page: on the right (φ = 0) B = s·(+z), on the left s·(−z)
					if (i !== 1) {
						mark(f, CX + R, y0, g.s > 0);
						mark(f, CX - R, y0, g.s < 0);
					}
					lineEls.push(b, f);
				});
				const yt = RINGS[0] + 4.5;
				lineEls.push(label(CX + R + 12, yt, g.s > 0 ? 'к нам' : 'от нас'));
				lineEls.push(label(CX - R - 12, yt, g.s > 0 ? 'от нас' : 'к нам', 'lnp__lbl', 'end'));
				lineEls.push(label(CX + R + 12, RINGS[1] - 4, 'магнитная', 'lnp__lbl lnp__lbl--line'));
				lineEls.push(label(CX + R + 12, RINGS[1] + 11, 'линия', 'lnp__lbl lnp__lbl--line'));
				caseEl.setAttribute('ry', f1(14 * K));
			}
			// faint copies of the needle every 30°, in the order the compass passes them (it goes along B)
			for (let k = 0; k < 12; k++) {
				const phi = START + (g.s * k * Math.PI) / 6;
				const behind = g.side && Math.sin(phi) < -0.01;
				const e = el('g', { class: `lnp__ghost${behind ? ' lnp__ghost--back' : ''}` }, behind ? back : front);
				needle(phi, el('polygon', { class: 'lnp__n' }, e), el('polygon', { class: 'lnp__s' }, e), 0.75);
				ghosts.push({ e, k });
			}
			svg.setAttribute('aria-label', ARIA[view]);
			say.innerHTML = SAY[view];
			buttons.forEach((b) => {
				const on = b.dataset.view === view;
				b.classList.toggle('is-on', on);
				b.setAttribute('aria-checked', String(on));
			});
		};

		const draw = (t: number) => {
			const x = (t % RUN) / RUN;
			const p = smooth(0.08, 0.72, x); // the share of the turn done
			const fade = 1 - smooth(0.95, 1, x);
			const phi = START + g.s * 2 * Math.PI * p;
			const [cx, cy] = needle(phi, nEl, sEl);
			caseEl.setAttribute('cx', f1(cx));
			caseEl.setAttribute('cy', f1(cy));
			pin.setAttribute('cx', f1(cx));
			pin.setAttribute('cy', f1(cy));
			// side views: behind the wire or in front of it
			const behind = g.side && Math.sin(phi) < 0;
			const after = behind ? back : front;
			if (cmp.previousElementSibling !== after) after.after(cmp);
			cmp.style.opacity = f1(fade * (behind ? 0.75 : 1));
			ghosts.forEach(({ e, k }) => {
				const passed = x > 0.08 && p * 12 >= k + 0.5;
				e.style.opacity = passed ? f1(fade) : '0';
			});
			const show = smooth(0.74, 0.84, x) * fade;
			for (const e of lineEls) e.style.opacity = f1(show);
			// the chevrons on the wire move along the current
			const gap = 24;
			const off = (((t * 22 * curDir) % gap) + gap) % gap;
			chevs.forEach((c, k) => c.setAttribute('transform', `translate(${CX} ${f1(k * gap + 4 - off)})`));
		};

		let t = 0;
		buttons.forEach((b) =>
			b.addEventListener('click', () => {
				build(b.dataset.view as View);
				t = 0;
				draw(t);
				wake();
			}),
		);
		build('to');
		draw(0);
		const wake = loop(root, (dt) => {
			t += dt;
			draw(t);
			return true;
		});
	}
</script>
