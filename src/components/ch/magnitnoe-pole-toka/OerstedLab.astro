---
/**
 * Main model: a horizontal sheet of cardboard seen from above, with small compasses on it.
 * Mode «Прямой провод»: a long straight wire pierces the sheet at its centre.
 * Mode «Катушка»: the sheet passes through the axis of a coil of 20 turns.
 * Every needle turns along the total field B = B(current) + B(Earth) and swings like a real needle
 * (a damped pendulum whose stiffness grows with |B|). Field lines: of the current only.
 * Wire lines are circles at radii with equal magnetic flux between them, so their density shows the
 * field strength and grows with the current. Coil lines are traced at build time from the exact field.
 * Iron filings (canvas) align only where the field of the current is strong and only when the sheet is tapped.
 * `mode` fixes the model to one case and hides the tabs (one experiment per section of the chapter).
 */
import { SHEET, COIL, WIRE_R, coilTurnsX, coilLines, coilField, wireField, crossings } from './field';

const S = 20; // px per cm
const W = SHEET.W * S;
const H = SHEET.H * S;
const X = (x: number) => W / 2 + x * S;
const Y = (y: number) => H / 2 - y * S;
const f1 = (v: number) => Math.round(v * 10) / 10;

// coil field lines (for dir = +1), drawn under the compasses
const raw = coilLines(4, 0.8, { x: 19, y: 15 });
raw.push({ pts: [[-19, 0], [19, 0]], closed: false });
const lines = raw.map((l) => ({
	d: 'M' + l.pts.map(([x, y]) => `${f1(X(x))} ${f1(Y(y))}`).join('L') + (l.closed ? 'Z' : ''),
	pts: l.pts,
}));
const arrows: { x: number; y: number; deg: number }[] = [];
for (const l of lines) {
	for (const c of crossings(l.pts, [0, -10.5, 10.5])) {
		if (Math.abs(c.x) < 1 && Math.abs(c.y) < 0.2) continue; // the axis: arrows at the sides only
		if (Math.abs(c.y) > SHEET.H / 2 - 0.6) continue;
		if (arrows.some((a) => Math.hypot(a.x - X(c.x), a.y - Y(c.y)) < 22)) continue;
		arrows.push({ x: f1(X(c.x)), y: f1(Y(c.y)), deg: f1((-c.ang * 180) / Math.PI) });
	}
}
for (const x of [-12.8, 12.8]) arrows.push({ x: f1(X(x)), y: Y(0), deg: 0 });

const turns = coilTurnsX();
const xsCols = Array.from({ length: 10 }, (_, i) => -14.4 + 3.2 * i);
const posWire = xsCols.flatMap((x) => [-9.6, -6.4, -3.2, 0, 3.2, 6.4, 9.6].map((y) => [x, y]));
const posCoil = xsCols.flatMap((x) => [-10.6, -7.4, -4.2, 0, 4.2, 7.4, 10.6].map((y) => [x, y]));
const r3 = (v: number) => Math.round(v * 1000) / 1000;
interface Props {
	mode?: 'wire' | 'coil';
}
const { mode } = Astro.props;
const clipId = `mpt-clip-${Math.random().toString(36).slice(2, 8)}`;
const data = {
	wire: posWire.map(([x, y]) => [x, y, ...wireField(x, y).map(r3)]),
	coil: posCoil.map(([x, y]) => [x, y, ...coilField(x, y).map(r3)]),
};
---

<figure class="mpt not-content" data-mpt data-fields={JSON.stringify(data)} data-fixed={mode}>
	<div class="mpt__head">
		{
			!mode && (
				<div class="mpt__tabs" role="tablist" aria-label="Что стоит на листе">
					<button type="button" role="tab" class="mpt__tab is-active" aria-selected="true" data-mode="wire">Прямой провод</button>
					<button type="button" role="tab" class="mpt__tab" aria-selected="false" data-mode="coil">Катушка</button>
				</div>
			)
		}
		<p class="mpt__north" aria-label="Верх листа направлен на север"><span aria-hidden="true">↑</span> север</p>
		<div class="mpt__setup" aria-hidden="true">
			<svg viewBox="0 0 170 100">
				<path class="mpt__sk-sheet" d="M 12 76 L 118 76 L 158 44 L 52 44 Z"></path>
				<g class="mpt__sk-wire" data-sk="wire" opacity={mode === 'coil' ? '0' : '1'}>
					<line class="mpt__sk-hidden" x1="85" y1="60" x2="85" y2="96"></line>
					<line x1="85" y1="6" x2="85" y2="60"></line>
					<path class="mpt__sk-arrow" d="M 79 30 L 85 18 L 91 30 Z" data-sk-arrow></path>
				</g>
				<g class="mpt__sk-coil" data-sk="coil" opacity={mode === 'coil' ? '1' : '0'}>
					{[0, 1, 2, 3, 4, 5, 6].map((k) => (
						<g transform={`translate(${58 + k * 9} 60)`}>
							<path d="M 0 -15 A 5 15 0 0 1 0 15" />
							<path class="mpt__sk-back" d="M 0 15 A 5 15 0 0 1 0 -15" />
						</g>
					))}
				</g>
				<text x="2" y="16" class="mpt__sk-text">вид сбоку</text>
			</svg>
		</div>
	</div>

	<div class="mpt__stage">
		<canvas class="mpt__filings" data-canvas aria-hidden="true"></canvas>
		<svg
			class="mpt__svg"
			viewBox={`0 0 ${W} ${H}`}
			role="img"
			aria-label="Лист картона с магнитными стрелками, вид сверху. Сквозь лист проходит провод с током или катушка с током."
		>
			<defs>
				<clipPath id={clipId}>
					<rect x="0" y="0" width={W} height={H} rx="14"></rect>
				</clipPath>
			</defs>
			<g clip-path={`url(#${clipId})`}>
				<!-- field lines of the wire -->
				<g class="mpt__lines mpt__lines--wire" data-wire-lines></g>

				<!-- field lines of the coil -->
				<g class="mpt__lines mpt__lines--coil" data-coil-lines opacity="0">
					{lines.map((l) => <path d={l.d} />)}
					<g class="mpt__arrows">
						{arrows.map((a) => (
							<g transform={`translate(${a.x} ${a.y}) rotate(${a.deg})`}>
								<path class="mpt__flip" d="M -6 -5 L 6 0 L -6 5 Z" />
							</g>
						))}
					</g>
				</g>

				<!-- the coil: the parts of the turns above the sheet and the cross-sections in it -->
				<g class="mpt__coil" data-coil opacity="0">
					<rect class="mpt__tube" x={X(-COIL.len / 2) - 4} y={Y(COIL.a) - 2} width={COIL.len * S + 8} height={2 * COIL.a * S + 4} rx="4"></rect>
					{turns.map((x) => (
						<line class="mpt__turn-top" x1={X(x)} y1={Y(COIL.a)} x2={X(x + COIL.len / COIL.turns / 2)} y2={Y(-COIL.a)} />
					))}
					{turns.map((x) => (
						<g class="mpt__xs" transform={`translate(${f1(X(x))} ${Y(COIL.a)})`}>
							<circle r={COIL.wire * S} />
							<g class="mpt__dot" data-top-dot><circle r="1.7" /></g>
							<g class="mpt__cross" data-top-cross><path d="M -2.6 -2.6 L 2.6 2.6 M -2.6 2.6 L 2.6 -2.6" /></g>
						</g>
					))}
					{turns.map((x) => (
						<g class="mpt__xs" transform={`translate(${f1(X(x))} ${Y(-COIL.a)})`}>
							<circle r={COIL.wire * S} />
							<g class="mpt__dot" data-bot-dot><circle r="1.7" /></g>
							<g class="mpt__cross" data-bot-cross><path d="M -2.6 -2.6 L 2.6 2.6 M -2.6 2.6 L 2.6 -2.6" /></g>
						</g>
					))}
					<g class="mpt__pole" data-pole-r transform={`translate(${X(6.4)} ${Y(0)})`}>
						<circle r="13"></circle>
						<text y="7" text-anchor="middle">N</text>
					</g>
					<g class="mpt__pole" data-pole-l transform={`translate(${X(-6.4)} ${Y(0)})`}>
						<circle r="13"></circle>
						<text y="7" text-anchor="middle">S</text>
					</g>
				</g>

				<!-- the wire -->
				<g class="mpt__wire" data-wire transform={`translate(${X(0)} ${Y(0)})`}>
					<circle class="mpt__glow" r={WIRE_R * S + 9} data-glow></circle>
					<circle class="mpt__wire-body" r={WIRE_R * S}></circle>
					<g class="mpt__dot" data-w-dot><circle r="3.4" /></g>
					<g class="mpt__cross" data-w-cross><path d="M -5 -5 L 5 5 M -5 5 L 5 -5" /></g>
				</g>

				<!-- compasses -->
				<g class="mpt__compasses" data-compasses>
					{posWire.map(([x, y]) => (
						<g class="mpt__cmp" transform={`translate(${X(x)} ${Y(y)})`}>
							<circle class="mpt__case" r="15" />
							<g class="mpt__needle">
								<path class="mpt__n" d="M 0 -12.5 L 3.4 0 L -3.4 0 Z" />
								<path class="mpt__s" d="M 0 12.5 L 3.4 0 L -3.4 0 Z" />
								<circle class="mpt__pin" r="1.6" />
							</g>
						</g>
					))}
				</g>
			</g>
		</svg>
	</div>

	<div class="mpt__controls">
		<div class="mpt__buttons">
			<button type="button" class="mpt__btn mpt__btn--primary" data-power>Включить ток</button>
			<button type="button" class="mpt__btn" data-dir>Сменить направление тока</button>
			<button type="button" class="mpt__btn" data-filings>Насыпать железные опилки</button>
			<button type="button" class="mpt__btn mpt__btn--quiet" data-clear hidden>Убрать опилки</button>
		</div>
		<label class="mpt__slider">
			<span>Сила тока <i>I</i></span>
			<output data-i-out>10 А</output>
			<input type="range" min="0.5" max="20" step="0.5" value="10" data-i />
		</label>
		<div class="mpt__checks">
			<label><input type="checkbox" checked data-earth /> магнитное поле Земли</label>
			<label><input type="checkbox" checked data-show-cmp /> магнитные стрелки</label>
		</div>
	</div>
	<p class="mpt__status" data-status aria-live="polite"></p>

	<figcaption class="mpt__legend">
		<span class="mpt__key mpt__key--n"></span>северный конец стрелки
		<span class="mpt__key mpt__key--line"></span>магнитные линии поля тока
		<span class="mpt__key mpt__key--sym">⊙</span>ток идёт к нам
		<span class="mpt__key mpt__key--sym">⊗</span>ток идёт от нас.
		Лист размером 32 × 24 см. Стрелки чувствуют и поле тока, и магнитное поле Земли: вдали от провода
		слабое поле тока не может развернуть их от направления на север.
	</figcaption>
</figure>

