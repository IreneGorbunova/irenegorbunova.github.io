</style>

<script>
	import { SHEET, WIRE_R, COIL, B_EARTH, coilTurnsX, coilField, wireField } from './field';

	const S = 20;
	const W = SHEET.W * S;
	const H = SHEET.H * S;
	const NS = 'http://www.w3.org/2000/svg';
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const OMEGA0 = (2 * Math.PI) / 1.4; // period of a needle in the Earth's field alone, 1/s
	const R_ANCHOR = 30; // cm: wire lines at r_k = R·exp(−k·C_LINES/|I|) — equal flux between neighbours
	const C_LINES = 6; // A
	const MAX_WIRE_LINES = 32;
	const B_FIL1 = 10; // μT: filings start to turn along the field of the current
	const B_FIL2 = 40; // μT: and line up well

	type Mode = 'wire' | 'coil';
	type Needle = { el: SVGGElement; x: number; y: number; px: number; py: number; a: number; w: number };
	type Filing = { x: number; y: number; a: number; a0: number; a1: number; dx: number; dy: number; born: number };

	const ru = (v: number, d = 1) => v.toFixed(d).replace('.', ',').replace(/,0$/, '');
	const wrapPi = (v: number) => Math.atan2(Math.sin(v), Math.cos(v));

	for (const root of document.querySelectorAll<HTMLElement>('[data-mpt]')) {
		const fields = JSON.parse(root.dataset.fields!) as Record<Mode, number[][]>;
		const svg = root.querySelector<SVGSVGElement>('.mpt__svg')!;
		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		const ctx = canvas.getContext('2d')!;
		const wireLines = root.querySelector<SVGGElement>('[data-wire-lines]')!;
		const coilLinesG = root.querySelector<SVGGElement>('[data-coil-lines]')!;
		const coilG = root.querySelector<SVGGElement>('[data-coil]')!;
		const wireG = root.querySelector<SVGGElement>('[data-wire]')!;
		const glow = root.querySelector<SVGCircleElement>('[data-glow]')!;
		const flips = [...root.querySelectorAll<SVGPathElement>('.mpt__flip')];
		const poleR = root.querySelector<SVGGElement>('[data-pole-r]')!;
		const poleL = root.querySelector<SVGGElement>('[data-pole-l]')!;
		const cmpG = root.querySelector<SVGGElement>('[data-compasses]')!;
		const powerBtn = root.querySelector<HTMLButtonElement>('[data-power]')!;
		const dirBtn = root.querySelector<HTMLButtonElement>('[data-dir]')!;
		const filBtn = root.querySelector<HTMLButtonElement>('[data-filings]')!;
		const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]')!;
		const iInput = root.querySelector<HTMLInputElement>('[data-i]')!;
		const iOut = root.querySelector<HTMLOutputElement>('[data-i-out]')!;
		const earthBox = root.querySelector<HTMLInputElement>('[data-earth]')!;
		const cmpBox = root.querySelector<HTMLInputElement>('[data-show-cmp]')!;
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
		const skWire = root.querySelector<SVGGElement>('[data-sk="wire"]')!;
		const skCoil = root.querySelector<SVGGElement>('[data-sk="coil"]')!;
		const skArrow = root.querySelector<SVGPathElement>('[data-sk-arrow]')!;

		let mode: Mode = (root.dataset.fixed as Mode | undefined) ?? 'wire';
		let on = false;
		let dir = 1; // +1: towards the viewer (wire) / north pole on the right (coil)
		let cur = 0; // the current as drawn, A, with sign; follows the goal smoothly
		let modeMix = mode === 'coil' ? 1 : 0; // 0 — wire, 1 — coil
		let earth = true;
		let filings: Filing[] = [];
		let tapStart = -1;
		let running = false;
		let visible = true;
		let last = 0;

		// ---- compasses
		const needles: Needle[] = [...cmpG.querySelectorAll<SVGGElement>('.mpt__cmp')].map((el, k) => {
			const [x, y] = fields.wire[k];
			return { el, x, y, px: x, py: y, a: 0, w: 0 };
		});
		const needleEls = needles.map((n) => n.el.querySelector<SVGGElement>('.mpt__needle')!);
		const unitField = (k: number, m: number): [number, number] => {
			const a = fields.wire[k];
			const b = fields.coil[k];
			return [a[2] * (1 - m) + b[2] * m, a[3] * (1 - m) + b[3] * m];
		};

		// ---- wire field lines: circles drawn in the direction of the field
		const wirePaths: SVGPathElement[] = [];
		const wireArrows: SVGGElement[] = [];
		for (let k = 0; k < MAX_WIRE_LINES; k++) {
			const p = document.createElementNS(NS, 'path');
			wireLines.append(p);
			wirePaths.push(p);
			for (let j = 0; j < 2; j++) {
				const g = document.createElementNS(NS, 'g');
				g.setAttribute('class', 'mpt__warrow');
				const a = document.createElementNS(NS, 'path');
				a.setAttribute('d', 'M -6 -5 L 6 0 L -6 5 Z');
				g.append(a);
				wireLines.append(g);
				wireArrows.push(g);
			}
		}
		const cx = W / 2;
		const cy = H / 2;
		const drawWireLines = () => {
			const amp = Math.abs(cur);
			const sweep = cur >= 0 ? 0 : 1; // towards the viewer: counter-clockwise on the screen
			for (let k = 0; k < MAX_WIRE_LINES; k++) {
				const r = amp > 0.01 ? R_ANCHOR * Math.exp((-(k + 1) * C_LINES) / amp) : 0;
				const p = wirePaths[k];
				const arrows = [wireArrows[2 * k], wireArrows[2 * k + 1]];
				if (r < WIRE_R + 0.15 || r > 21) {
					p.setAttribute('d', '');
					arrows.forEach((g) => g.setAttribute('display', 'none'));
					continue;
				}
				const R = r * S;
				p.setAttribute('d', `M ${cx + R} ${cy} A ${R} ${R} 0 1 ${sweep} ${cx - R} ${cy} A ${R} ${R} 0 1 ${sweep} ${cx + R} ${cy}`);
				// fade the line in as it comes out from under the wire
				p.style.opacity = String(Math.min(1, (r - WIRE_R - 0.15) / 0.8) * 0.8);
				arrows.forEach((g, j) => {
					const th = 0.62 * k + 0.4 + j * Math.PI; // maths angle of the arrow on the circle
					const ax = cx + R * Math.cos(th);
					const ay = cy - R * Math.sin(th);
					if (ax < 10 || ax > W - 10 || ay < 10 || ay > H - 10 || R < 26) {
						g.setAttribute('display', 'none');
						return;
					}
					g.removeAttribute('display');
					// tangent for counter-clockwise (maths) motion: angle th + 90°; on screen y is flipped
					const deg = (-(th + Math.PI / 2) * 180) / Math.PI + (cur >= 0 ? 0 : 180);
					g.setAttribute('transform', `translate(${ax.toFixed(1)} ${ay.toFixed(1)}) rotate(${deg.toFixed(1)})`);
				});
			}
		};

		// ---- iron filings
		let filingField: [number, number][] | null = null;
		let filingMode: Mode | null = null;
		const turnsX = coilTurnsX();
		const makeFilings = (now: number) => {
			const out: Filing[] = [];
			const step = 0.5;
			for (let x = -SHEET.W / 2 + 0.3; x < SHEET.W / 2 - 0.2; x += step) {
				for (let y = -SHEET.H / 2 + 0.3; y < SHEET.H / 2 - 0.2; y += step) {
					const fx = x + (Math.random() - 0.5) * step * 0.9;
					const fy = y + (Math.random() - 0.5) * step * 0.9;
					if (mode === 'wire' && Math.hypot(fx, fy) < WIRE_R + 0.2) continue;
					if (mode === 'coil' && turnsX.some((tx) => Math.hypot(fx - tx, Math.abs(fy) - COIL.a) < COIL.wire + 0.2)) continue;
					const a = Math.random() * Math.PI;
					out.push({ x: fx, y: fy, a, a0: a, a1: a, dx: 0, dy: 0, born: now + Math.random() * 600 });
				}
			}
			filingMode = mode;
			filingField = out.map((f) => (mode === 'wire' ? wireField(f.x, f.y) : coilField(f.x, f.y)));
			return out;
		};
		const tap = (now: number) => {
			if (!filingField) return;
			const amp = on ? Number(iInput.value) : 0;
			filings.forEach((f, k) => {
				const [bx, by] = filingField![k];
				const b = Math.hypot(bx, by) * amp;
				const s = Math.max(0, Math.min(1, (b - B_FIL1) / (B_FIL2 - B_FIL1)));
				const target = Math.atan2(by, bx);
				// a filing has no «north end»: it turns the shorter way, to the line or opposite to it
				let d = wrapPi(target - f.a);
				if (d > Math.PI / 2) d -= Math.PI;
				if (d < -Math.PI / 2) d += Math.PI;
				const jiggle = (Math.random() - 0.5) * (0.5 * (1 - s) + 0.1);
				f.a0 = f.a;
				f.a1 = f.a + d * Math.min(1, 1.6 * s) * (0.5 + 0.45 * s) + jiggle;
				f.dx = (Math.random() - 0.5) * 0.08;
				f.dy = (Math.random() - 0.5) * 0.08;
			});
			tapStart = now;
		};
		let colFiling = '#888';
		const readColours = () => {
			colFiling = getComputedStyle(root).getPropertyValue('--sl-color-gray-2').trim() || '#888';
		};
		readColours();
		new MutationObserver(() => {
			readColours();
			drawFilings(performance.now());
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		const sizeCanvas = () => {
			const r = svg.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(r.width * dpr);
			canvas.height = Math.round(r.height * dpr);
			ctx.setTransform((canvas.width / W), 0, 0, canvas.height / H, 0, 0);
		};
		new ResizeObserver(() => {
			sizeCanvas();
			drawFilings(performance.now());
		}).observe(svg);

		const drawFilings = (now: number) => {
			ctx.clearRect(0, 0, W, H);
			if (!filings.length) return false;
			let busy = false;
			const tp = tapStart < 0 ? 1 : Math.min(1, (now - tapStart) / 380);
			const e = reduceMotion.matches ? 1 : 1 - Math.pow(1 - tp, 3);
			if (tp < 1) busy = true;
			ctx.strokeStyle = colFiling;
			ctx.lineWidth = 1.5;
			ctx.lineCap = 'round';
			const L = 0.17 * S;
			for (const f of filings) {
				let fall = reduceMotion.matches ? 1 : Math.max(0, Math.min(1, (now - f.born) / 260));
				if (fall < 1) busy = true;
				if (fall <= 0) continue;
				f.a = f.a0 + (f.a1 - f.a0) * e;
				const shake = tp < 1 ? Math.sin(tp * Math.PI) : 0;
				const x = W / 2 + (f.x + f.dx * shake) * S;
				const y = H / 2 - (f.y + f.dy * shake) * S - (1 - fall) * 14;
				ctx.globalAlpha = 0.85 * fall;
				const c = Math.cos(f.a) * L;
				const s = Math.sin(f.a) * L;
				ctx.beginPath();
				ctx.moveTo(x - c, y + s);
				ctx.lineTo(x + c, y - s);
				ctx.stroke();
			}
			ctx.globalAlpha = 1;
			if (tp >= 1 && tapStart >= 0) {
				filings.forEach((f) => (f.a0 = f.a = f.a1));
				tapStart = -1;
			}
			return busy;
		};

		// ---- user interface
		const goal = () => (on ? dir * Number(iInput.value) : 0);
		const say = () => {
			const I = ru(Number(iInput.value));
			if (!on) {
				status.innerHTML =
					mode === 'wire'
						? 'Ток выключен. Все стрелки показывают на север: на них действует только магнитное поле Земли.'
						: 'Ток выключен. Стрелки повернулись на север — их разворачивает магнитное поле Земли.';
				if (!earth) status.innerHTML = 'Ток выключен, а поле Земли мы «выключили»: на стрелки ничего не действует, и каждая стоит так, как остановилась.';
				return;
			}
			if (mode === 'wire') {
				status.innerHTML =
					`Ток ${I} А идёт ${dir > 0 ? '<b>к нам</b> (точка — это острие стрелы)' : '<b>от нас</b> (крестик — это оперение стрелы)'}. ` +
					`Магнитные линии — окружности, направлены ${dir > 0 ? '<b>против часовой стрелки</b>' : '<b>по часовой стрелке</b>'}.`;
			} else {
				status.innerHTML =
					`Ток ${I} А в верхних витках идёт ${dir > 0 ? 'к нам' : 'от нас'}, в нижних — ${dir > 0 ? 'от нас' : 'к нам'}. ` +
					`Северный полюс <b>N</b> катушки — <b>${dir > 0 ? 'справа' : 'слева'}</b>: оттуда выходят магнитные линии.`;
			}
		};
		const setPower = (v: boolean) => {
			on = v;
			powerBtn.textContent = on ? 'Выключить ток' : 'Включить ток';
			say();
			kick();
		};
		powerBtn.addEventListener('click', () => setPower(!on));
		dirBtn.addEventListener('click', () => {
			dir = -dir;
			if (!on) setPower(true);
			say();
			kick();
		});
		iInput.addEventListener('input', () => {
			iOut.textContent = `${ru(Number(iInput.value))} А`;
			say();
			kick();
		});
		earthBox.addEventListener('change', () => {
			earth = earthBox.checked;
			say();
			kick();
		});
		cmpBox.addEventListener('change', () => cmpG.classList.toggle('is-hidden', !cmpBox.checked));
		filBtn.addEventListener('click', () => {
			const now = performance.now();
			if (!filings.length || filingMode !== mode) {
				filings = makeFilings(now);
				filBtn.textContent = 'Постучать по листу';
				clearBtn.hidden = false;
			} else tap(now);
			kick();
		});
		clearBtn.addEventListener('click', () => {
			filings = [];
			filingField = null;
			filBtn.textContent = 'Насыпать железные опилки';
			clearBtn.hidden = true;
			drawFilings(performance.now());
		});
		tabs.forEach((t) =>
			t.addEventListener('click', () => {
				const m = t.dataset.mode as Mode;
				if (m === mode) return;
				mode = m;
				tabs.forEach((b) => {
					b.classList.toggle('is-active', b === t);
					b.setAttribute('aria-selected', String(b === t));
				});
				filings = [];
				filingField = null;
				filBtn.textContent = 'Насыпать железные опилки';
				clearBtn.hidden = true;
				skWire.setAttribute('opacity', m === 'wire' ? '1' : '0');
				skCoil.setAttribute('opacity', m === 'coil' ? '1' : '0');
				say();
				kick();
			}),
		);

		// ---- animation
		const render = (now: number, dt: number) => {
			let busy = false;
			// mode cross-fade and the current
			const mGoal = mode === 'coil' ? 1 : 0;
			if (reduceMotion.matches) {
				modeMix = mGoal;
				cur = goal();
			} else {
				const dm = mGoal - modeMix;
				modeMix += Math.sign(dm) * Math.min(Math.abs(dm), dt / 0.6);
				const g = goal();
				// the current changes smoothly; when it is reversed it passes through zero
				cur += (g - cur) * Math.min(1, dt / 0.22);
				if (Math.abs(g - cur) < 0.01) cur = g;
			}
			if (modeMix !== mGoal || cur !== goal()) busy = true;
			const sm = modeMix * modeMix * (3 - 2 * modeMix);

			// the two scenes
			wireG.setAttribute('opacity', String(1 - sm));
			wireLines.setAttribute('opacity', String(1 - sm));
			coilG.setAttribute('opacity', String(sm));
			const amp = Math.abs(cur);
			const lineAlpha = Math.min(1, amp / 1.5) * (0.35 + 0.65 * Math.min(1, amp / 10));
			coilLinesG.setAttribute('opacity', String(sm * lineAlpha));
			glow.setAttribute('opacity', String(Math.min(1, amp / 20)));
			const sgn = cur > 0 ? 1 : cur < 0 ? -1 : dir;
			flips.forEach((f) => f.setAttribute('transform', sgn > 0 ? '' : 'scale(-1 1)'));
			drawWireLines();
			root.querySelectorAll<SVGGElement>('[data-w-dot],[data-top-dot]').forEach((g) => g.setAttribute('opacity', amp > 0.05 && sgn > 0 ? '1' : '0'));
			root.querySelectorAll<SVGGElement>('[data-w-cross],[data-top-cross]').forEach((g) => g.setAttribute('opacity', amp > 0.05 && sgn < 0 ? '1' : '0'));
			root.querySelectorAll<SVGGElement>('[data-bot-dot]').forEach((g) => g.setAttribute('opacity', amp > 0.05 && sgn < 0 ? '1' : '0'));
			root.querySelectorAll<SVGGElement>('[data-bot-cross]').forEach((g) => g.setAttribute('opacity', amp > 0.05 && sgn > 0 ? '1' : '0'));
			const poleA = Math.min(1, amp / 2);
			poleR.setAttribute('class', `mpt__pole ${sgn > 0 ? 'is-n' : 'is-s'}`);
			poleL.setAttribute('class', `mpt__pole ${sgn > 0 ? 'is-s' : 'is-n'}`);
			poleR.querySelector('text')!.textContent = sgn > 0 ? 'N' : 'S';
			poleL.querySelector('text')!.textContent = sgn > 0 ? 'S' : 'N';
			poleR.setAttribute('opacity', String(poleA));
			poleL.setAttribute('opacity', String(poleA));
			skArrow.classList.toggle('is-down', sgn < 0);

			// the needles: damped swings towards the total field
			const steps = Math.max(1, Math.ceil(dt / (1 / 240)));
			const h = dt / steps;
			needles.forEach((n, k) => {
				const wf = fields.wire[k];
				const cf = fields.coil[k];
				const tx = wf[0] + (cf[0] - wf[0]) * sm;
				const ty = wf[1] + (cf[1] - wf[1]) * sm;
				if (tx !== n.px || ty !== n.py) {
					n.px = tx;
					n.py = ty;
					n.el.setAttribute('transform', `translate(${(W / 2 + tx * S).toFixed(1)} ${(H / 2 - ty * S).toFixed(1)})`);
				}
				const [ux, uy] = unitField(k, sm);
				const bx = ux * cur;
				const by = uy * cur + (earth ? B_EARTH : 0);
				const b = Math.hypot(bx, by);
				if (b < 1e-6) {
					// no field: the needle slows down and stops where it is
					n.w *= Math.exp(-3 * dt);
					n.a += n.w * dt;
				} else {
					const target = Math.atan2(bx, by); // clockwise from north, as on the screen
					if (reduceMotion.matches) {
						n.a = target;
						n.w = 0;
					} else {
						// a needle pointing exactly against the field is in an unstable balance: a real one is never
						// exactly there, so a tiny push lets it turn round (one way or the other)
						if (Math.abs(wrapPi(n.a - target)) > Math.PI - 0.003 && Math.abs(n.w) < 0.05) n.a += k % 2 ? 0.01 : -0.01;
						const ratio = Math.min(b / B_EARTH, 25);
						const om = OMEGA0 * Math.sqrt(ratio);
						const gamma = 1.6 + 0.32 * om;
						for (let i = 0; i < steps; i++) {
							n.w += (-om * om * Math.sin(n.a - target) - gamma * n.w) * h;
							n.a += n.w * h;
						}
						n.a = wrapPi(n.a - target) + target;
					}
				}
				if (Math.abs(n.w) > 0.003 || (b > 1e-6 && Math.abs(wrapPi(n.a - Math.atan2(bx, by))) > 0.002)) busy = true;
				needleEls[k].setAttribute('transform', `rotate(${((n.a * 180) / Math.PI).toFixed(2)})`);
			});
			if (drawFilings(now)) busy = true;
			return busy;
		};

		const frame = (now: number) => {
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			const busy = render(now, dt);
			if (busy && visible) requestAnimationFrame(frame);
			else running = false;
		};
		function kick() {
			if (running || !visible) return;
			running = true;
			last = performance.now();
			requestAnimationFrame(frame);
		}
		new IntersectionObserver((entries) => {
			visible = entries.some((e) => e.isIntersecting);
			if (visible) kick();
		}).observe(root);

		// start: the needles point north, the current is off
		sizeCanvas();
		say();
		render(performance.now(), 0);
	}
</script>
