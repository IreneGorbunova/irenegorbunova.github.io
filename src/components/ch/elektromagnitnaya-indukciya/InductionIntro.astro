---
/**
 * Two short looping opening scenes of «Электромагнитная индукция». No numbers in the pictures; the captions' popovers
 * explain.
 * Bike: the front wheel of a bicycle at dusk, close up. A bottle dynamo presses on the tyre; an inset shows its inside:
 *   a magnet (N blue, S red) turning inside a fixed coil. The bike starts, rides and brakes to a stop: the road moves,
 *   the wheel and the magnet turn, and the headlamp shines the brighter the faster the bike goes; it goes out when the
 *   wheel stops. The frames before and after the run are the same: standing still, lamp off.
 * Card: a metro turnstile. Above the reader on its top the alternating magnetic field of the reader's coil (dashes
 *   moving to and fro). A hand brings a transport card over the reader: the antenna coil inside the card lights up, the
 *   indicator turns from a red cross to a green tick, the glass flaps slide away; the hand leaves.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gGlow = `ei-glow-${uid}`;
const gBeam = `ei-beam-${uid}`;
const cInset = `ei-inset-${uid}`;
// Bike: the hub of the front wheel and the 16 spokes
const C = { x: 118, y: 128 };
const SPOKES = Array.from({ length: 16 }, (_, k) => (k * Math.PI) / 8);
const STARS = [
	[22, 18],
	[58, 62],
	[176, 14],
	[300, 22],
	[338, 70],
	[196, 96],
	[30, 120],
];
// the fork leg: from the crown to the hub; the dynamo sits on it, its roller on the tyre's sidewall
const LEG = (Math.atan2(C.y - 34, C.x - 98) * 180) / Math.PI;
const I = { x: 238, y: 54, r: 40 }; // the inset
// Card: the reader's centre on the top of the turnstile and the field lines above it (left-right vertical plane)
const RD = { x: 268, y: 109 };
const LOOPS = [1, 2, 3].map((k) => {
	const a = 3 * k;
	const w = 8 + 16 * k;
	const h = 12 + 16 * k;
	return [1, -1].map(
		(s) => `M ${RD.x + s * a} ${RD.y} C ${RD.x + s * a} ${RD.y - h * 1.25} ${RD.x + s * (w + 6)} ${RD.y - h * 1.05} ${RD.x + s * w} ${RD.y}`,
	);
}).flat();
// Card: 56 × 35 in its plane, drawn parallel to the top of the turnstile (the depth goes up and to the right)
const card = (inset: number) => {
	const w = 56; // width, px
	const D = 35; // depth in the card's plane, px; drawn foreshortened as the vector (12, −9)
	const pt = (u: number, v: number) => `${(u + 12 * v).toFixed(1)} ${(-9 * v).toFixed(1)}`;
	const a = inset / D;
	return `M ${pt(inset, a)} L ${pt(w - inset, a)} L ${pt(w - inset, 1 - a)} L ${pt(inset, 1 - a)} Z`;
};
const TILES_X = Array.from({ length: 15 }, (_, k) => 24 * (k + 1));
const TILES_Y = [24, 48, 72, 96, 120, 144, 168, 192];
---

<IntroFrame data-eiintro>
	<div class="intro__card" data-scene="bike">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер. Переднее колесо велосипеда, к шине прижата маленькая динамо-машина; в круглой выноске видно, что внутри неё вращается магнит, а вокруг него — катушка из провода. Велосипед трогается, едет и тормозит: пока колесо крутится, фара светит, и тем ярче, чем быстрее едет велосипед. Колесо остановилось — фара погасла">
			<defs>
				<radialGradient id={gGlow}>
					<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.95"></stop>
					<stop offset="0.4" stop-color="var(--ig-v)" stop-opacity="0.35"></stop>
					<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
				</radialGradient>
				<linearGradient id={gBeam} x1="0" x2="1" y1="0" y2="0">
					<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.6"></stop>
					<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0.1"></stop>
				</linearGradient>
				<clipPath id={cInset}>
					<circle cx={I.x} cy={I.y} r={I.r}></circle>
				</clipPath>
			</defs>
			<rect class="ei-sky" x="0" y="0" width="360" height="196"></rect>
			{STARS.map(([x, y]) => <circle class="ei-star" cx={x} cy={y} r="1.2" />)}
			<rect class="ei-road" x="0" y="196" width="360" height="44"></rect>
			<line class="ei-road-edge" x1="0" y1="196" x2="360" y2="196"></line>
			<path class="ei-lane" d="M -60 222 H 420" data-lane></path>
			<!-- the beam of the headlamp and the lit road -->
			<polygon points="130,28 360,118 360,196 252,196 130,38" fill={`url(#${gBeam})`} class="ei-beam" data-beam></polygon>
			<ellipse class="ei-spot" cx="318" cy="200" rx="64" ry="5" data-spot></ellipse>
			<!-- the frame: head tube, down tube, top tube -->
			<line class="ei-tube" x1="-10" y1="96" x2="97" y2="30"></line>
			<line class="ei-tube" x1="-10" y1="30" x2="93" y2="14"></line>
			<line class="ei-tube ei-tube--head" x1="99" y1="38" x2="90" y2="-2"></line>
			<!-- the wheel -->
			<circle class="ei-tyre" cx={C.x} cy={C.y} r="64"></circle>
			<circle class="ei-rim" cx={C.x} cy={C.y} r="57"></circle>
			<g data-spokes>
				{SPOKES.map((a) => <line class="ei-spoke" x1={C.x + 6 * Math.cos(a)} y1={C.y + 6 * Math.sin(a)} x2={C.x + 56 * Math.cos(a)} y2={C.y + 56 * Math.sin(a)} />)}
				<rect class="ei-reflector" x={C.x + 30} y={C.y - 3} width="14" height="6" rx="2"></rect>
			</g>
			<circle class="ei-hub" cx={C.x} cy={C.y} r="5"></circle>
			<!-- the fork leg, the crown and the headlamp -->
			<line class="ei-fork" x1="98" y1="34" x2={C.x} y2={C.y}></line>
			<line class="ei-fork ei-fork--thin" x1="98" y1="33" x2="110" y2="33"></line>
			<rect class="ei-lamp" x="108" y="26" width="20" height="15" rx="4"></rect>
			<line class="ei-lens" x1="128" y1="27" x2="128" y2="40"></line>
			<circle cx="129" cy="33.5" r="24" fill={`url(#${gGlow})`} class="ei-glow" data-glow></circle>
			<!-- the bottle dynamo on the fork, its roller on the sidewall of the tyre; the wire to the lamp -->
			<path class="ei-wire" d="M 108 43 Q 104 38 112 41"></path>
			<line class="ei-fork ei-fork--thin" x1="101.5" y1="52" x2="107" y2="52"></line>
			<g transform={`translate(111 52) rotate(${LEG.toFixed(1)})`}>
				<rect class="ei-dynamo" x="-13" y="-5.5" width="25" height="11" rx="3"></rect>
				<g transform="translate(15 0)">
					<g data-roller>
						<circle class="ei-roller" r="3.6"></circle>
						<line class="ei-roller-mark" x1="-3.2" y1="0" x2="3.2" y2="0"></line>
					</g>
				</g>
			</g>
			<!-- the inset: inside the dynamo -->
			<circle class="ei-ring" cx="112" cy="54" r="14"></circle>
			<line class="ei-leader" x1="126" y1="54" x2={I.x - I.r} y2={I.y}></line>
			<circle class="ei-inset" cx={I.x} cy={I.y} r={I.r}></circle>
			<g clip-path={`url(#${cInset})`}>
				<path class="ei-lead" d={`M ${I.x - 17} ${I.y - 22} L ${I.x - 30} ${I.y - 44}`}></path>
				<path class="ei-lead" d={`M ${I.x + 17} ${I.y - 22} L ${I.x + 30} ${I.y - 44}`}></path>
				<circle class="ei-coil-core" cx={I.x} cy={I.y} r="28"></circle>
				<circle class="ei-coil" cx={I.x} cy={I.y} r="28"></circle>
				<g data-magnet>
					<rect class="ei-pole ei-pole--s" x={I.x - 19} y={I.y - 6.5} width="19" height="13" rx="2.5"></rect>
					<rect class="ei-pole ei-pole--n" x={I.x} y={I.y - 6.5} width="19" height="13" rx="2.5"></rect>
					<text class="ei-pole-label" x={I.x - 9.5} y={I.y + 4} text-anchor="middle">S</text>
					<text class="ei-pole-label" x={I.x + 9.5} y={I.y + 4} text-anchor="middle">N</text>
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Фара велосипеда светит без батареек, пока крутится колесо: <More term="ток в проводах фары идёт, только пока магнит в динамо вращается">Колесо вращает маленький генератор — динамо-машину. Внутри неё вращается магнит, а вокруг него неподвижна катушка из провода. Пока магнит вращается, магнитное поле в катушке всё время меняется, и в цепи фары идёт ток. Чем быстрее едет велосипед, тем быстрее меняется поле и тем ярче фара; колесо остановилось — фара гаснет. Подробнее — в разделе <a href="#электромагнитная-индукция">«Электромагнитная индукция»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="card">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Турникет в метро. Над считывателем на его крышке меняется магнитное поле. Рука подносит к считывателю транспортную карту: катушка внутри карты загорается, на турникете вместо красного крестика появляется зелёная галочка, и стеклянные створки уходят в стороны">
			<rect class="ei-wall" x="0" y="0" width="360" height="204"></rect>
			<g class="ei-grout">
				{TILES_X.map((x) => <line x1={x} y1="0" x2={x} y2="204" />)}
				{TILES_Y.map((y) => <line x1="0" y1={y} x2="360" y2={y} />)}
			</g>
			<rect class="ei-floor" x="0" y="204" width="360" height="36"></rect>
			<line class="ei-road-edge" x1="0" y1="204" x2="360" y2="204"></line>
			<!-- the left cabinet (partly out of the picture) -->
			<path class="ei-cab-top" d="M -20 118 H 40 L 62 100 H 2 Z"></path>
			<rect class="ei-cab" x="-20" y="118" width="60" height="86"></rect>
			<path class="ei-cab-side" d="M 40 118 L 62 100 V 186 L 40 204 Z"></path>
			<!-- the glass flaps: they slide into the cabinets -->
			<rect class="ei-flap" x="62" y="134" width="64" height="40" rx="8" data-flap-l></rect>
			<rect class="ei-flap" x="130" y="134" width="66" height="40" rx="8" data-flap-r></rect>
			<!-- the right cabinet with the reader on its top and the indicator on its front -->
			<path class="ei-cab-top" d="M 196 118 H 316 L 338 100 H 218 Z"></path>
			<rect class="ei-cab" x="196" y="118" width="120" height="86"></rect>
			<path class="ei-cab-side" d="M 316 118 L 338 100 V 186 L 316 204 Z"></path>
			<path class="ei-reader" d={`M ${RD.x - 32} ${RD.y + 5} H ${RD.x + 22} L ${RD.x + 32} ${RD.y - 5} H ${RD.x - 22} Z`}></path>
			<ellipse class="ei-reader-mark" cx={RD.x} cy={RD.y} rx="12" ry="3.2"></ellipse>
			<ellipse class="ei-reader-mark" cx={RD.x} cy={RD.y} rx="6" ry="1.6"></ellipse>
			<rect class="ei-ind" x="208" y="130" width="34" height="24" rx="5"></rect>
			<g data-no>
				<path class="ei-no" d="M 218 135 L 232 149 M 232 135 L 218 149"></path>
			</g>
			<g data-yes style="opacity: 0">
				<path class="ei-yes" d="M 216 142 L 222.5 148.5 L 234 136"></path>
			</g>
			<!-- the alternating field of the reader's coil -->
			<g class="ei-field" data-field>
				{LOOPS.map((d) => <path d={d} />)}
			</g>
			<!-- the card with its antenna coil and chip; the hand holding it -->
			<g data-card>
				<path class="ei-card" d={card(0)}></path>
				<g class="ei-antenna" data-antenna>
					<path d={card(2.4)}></path>
					<path d={card(4.2)}></path>
					<path d={card(6)}></path>
				</g>
				<rect class="ei-chip" x="34" y="-6.5" width="7" height="5" rx="1" data-chip></rect>
			</g>
			<g data-hand>
				<rect class="ei-sleeve" x="-600" y="-15" width="532" height="30" rx="6"></rect>
				<path class="ei-skin" d="M -72 -13 C -54 -16 -30 -13 -10 -7 Q 3 -3 1 2 Q -1 6 -9 6 L -36 7 C -50 9 -62 13 -72 13 Z"></path>
				<path class="ei-skin" d="M -58 6 Q -44 4 -32 9 Q -36 14 -46 13 Q -54 12 -58 6 Z"></path>
				<path class="ei-line" d="M -36 0 H -12 M -36 -5 H -16"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>В транспортной карте нет батарейки, но турникет её «читает»: <More term="энергию карте даёт меняющееся магнитное поле считывателя">В считывателе есть катушка с переменным током: он совершает 13,56 миллиона колебаний в секунду, и так же быстро меняется его магнитное поле. В карте спрятана плоская катушка — антенна из нескольких витков провода по краю карты. Меняющееся поле наводит в ней ток, которого хватает, чтобы питать микросхему карты, и турникет узнаёт номер карты. Поэтому карту нужно поднести близко: поле катушки быстро слабеет с расстоянием. Подробнее — в разделе <a href="#где-это-встречается">«Где это встречается»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-eiintro] {
		--ei-sky: color-mix(in srgb, var(--ig-vx) 16%, var(--sl-color-black));
		--ei-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--ei-tile: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-5));
		--ei-metal: var(--sl-color-gray-3);
		--ei-copper: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		--ei-dark: var(--sl-color-gray-6);
	}
	:root[data-theme='light'] [data-eiintro] {
		--ei-sky: color-mix(in srgb, var(--ig-vx) 28%, var(--sl-color-gray-2));
		--ei-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--ei-tile: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-6));
		--ei-metal: var(--sl-color-gray-4);
		--ei-dark: var(--sl-color-gray-2);
	}
	/* bike */
	.ei-sky {
		fill: var(--ei-sky);
	}
	.ei-star {
		fill: var(--sl-color-gray-3);
	}
	:root[data-theme='light'] .ei-star {
		fill: var(--sl-color-gray-5);
	}
	.ei-road {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, var(--ei-sky));
	}
	.ei-road-edge {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.ei-lane {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-dasharray: 26 34;
	}
	.ei-beam,
	.ei-glow {
		opacity: 0;
	}
	.ei-spot {
		fill: var(--ig-v);
		opacity: 0;
	}
	.ei-tube {
		stroke: color-mix(in srgb, var(--ig-vy) 55%, var(--sl-color-gray-3));
		stroke-width: 7;
		stroke-linecap: round;
	}
	.ei-tube--head {
		stroke-width: 9;
	}
	.ei-tyre {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 9;
	}
	:root[data-theme='light'] .ei-tyre {
		stroke: var(--sl-color-gray-1);
	}
	.ei-rim {
		fill: none;
		stroke: var(--ei-metal);
		stroke-width: 2.5;
	}
	.ei-spoke {
		stroke: var(--ei-metal);
		stroke-width: 1;
	}
	.ei-reflector {
		fill: color-mix(in srgb, var(--ig-v) 80%, var(--ig-vy));
	}
	.ei-hub {
		fill: var(--ei-metal);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.ei-fork {
		stroke: color-mix(in srgb, var(--ig-vy) 55%, var(--sl-color-gray-3));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.ei-fork--thin {
		stroke-width: 3;
	}
	.ei-lamp {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	:root[data-theme='light'] .ei-lamp {
		fill: var(--sl-color-gray-5);
	}
	.ei-lens {
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.ei-wire {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
	}
	:root[data-theme='light'] .ei-wire {
		stroke: var(--sl-color-gray-6);
	}
	.ei-dynamo {
		fill: var(--ei-metal);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.ei-roller {
		fill: var(--sl-color-gray-2);
	}
	.ei-roller-mark {
		stroke: var(--ei-metal);
		stroke-width: 1.2;
	}
	.ei-ring,
	.ei-leader {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	:root[data-theme='light'] .ei-ring,
	:root[data-theme='light'] .ei-leader {
		stroke: var(--sl-color-gray-6);
	}
	.ei-inset {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.ei-lead {
		fill: none;
		stroke: var(--ei-copper);
		stroke-width: 2;
	}
	.ei-coil-core {
		fill: none;
		stroke: color-mix(in srgb, var(--ei-copper) 45%, var(--ig-surface));
		stroke-width: 11;
	}
	.ei-coil {
		fill: none;
		stroke: var(--ei-copper);
		stroke-width: 10;
		stroke-dasharray: 1.6 1.6;
	}
	.ei-pole--n {
		fill: var(--ig-vx);
	}
	.ei-pole--s {
		fill: var(--ig-vy);
	}
	.ei-pole-label {
		fill: var(--sl-color-black);
		font-size: 10px;
		font-weight: 700;
	}
	:root[data-theme='light'] .ei-pole-label {
		fill: var(--sl-color-black);
	}
	/* card */
	.ei-wall {
		fill: var(--ei-tile);
	}
	.ei-grout line {
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 40%, transparent);
		stroke-width: 1;
	}
	.ei-floor {
		fill: color-mix(in srgb, var(--ig-v) 14%, var(--sl-color-gray-5));
	}
	.ei-cab {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.ei-cab-top {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.ei-cab-side {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .ei-cab {
		fill: var(--sl-color-gray-5);
	}
	:root[data-theme='light'] .ei-cab-top {
		fill: var(--sl-color-gray-6);
	}
	:root[data-theme='light'] .ei-cab-side {
		fill: var(--sl-color-gray-4);
	}
	.ei-flap {
		fill: color-mix(in srgb, var(--ig-vx) 22%, transparent);
		stroke: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-gray-2));
		stroke-width: 1.5;
	}
	.ei-reader {
		fill: var(--ei-dark);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.ei-reader-mark {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.ei-ind {
		fill: var(--ei-dark);
	}
	.ei-no {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.ei-yes {
		fill: none;
		stroke: var(--sl-color-green);
		stroke-width: 3.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ei-field path {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.6;
		stroke-dasharray: 5 4;
		opacity: 0.8;
	}
	.ei-card {
		fill: color-mix(in srgb, var(--ig-vy) 45%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.ei-antenna path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.1;
		stroke-dasharray: 4 3;
		opacity: 0.25;
	}
	.ei-chip {
		fill: var(--ig-v);
		opacity: 0.5;
	}
	.ei-skin {
		fill: var(--ei-skin);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.ei-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linecap: round;
		opacity: 0.6;
	}
	.ei-sleeve {
		fill: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-eiintro]')) {
		// Bike: standing (→ 0,04), speeding up (→ 0,3), riding (→ 0,58), braking (→ 0,88), standing; 8 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bike"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const spokes = $<SVGGElement>('[data-spokes]');
			const roller = $<SVGGElement>('[data-roller]');
			const magnet = $<SVGGElement>('[data-magnet]');
			const lane = $<SVGPathElement>('[data-lane]');
			const beam = $<SVGPolygonElement>('[data-beam]');
			const spot = $<SVGEllipseElement>('[data-spot]');
			const glow = $<SVGCircleElement>('[data-glow]');
			const RUN = 8;
			const R = 68; // px, outer radius of the tyre: the road moves R px per radian of the wheel
			const W = 1.6 * Math.PI; // rad/s of the wheel at full speed (0,8 turn per second)
			const speed = (x: number) => smooth(0.04, 0.3, x) * (1 - smooth(0.58, 0.88, x));
			// the turn of the wheel at x (rad): the integral of the speed, tabulated once
			const N = 400;
			const turn = new Float64Array(N + 1);
			for (let k = 1; k <= N; k++) turn[k] = turn[k - 1] + (W * RUN * (speed((k - 0.5) / N) * 1)) / N;
			const turnAt = (x: number) => {
				const u = clamp(x) * N;
				const k = Math.min(N - 1, Math.floor(u));
				return lerp(turn[k], turn[k + 1], u - k);
			};
			scene(card, RUN, (x) => {
				const v = speed(x);
				const th = turnAt(x);
				spokes.setAttribute('transform', `rotate(${f1((th * 180) / Math.PI)} 118 128)`);
				// the roller is ~19 times smaller than the wheel; drawn turning 5 times faster to stay visible
				roller.setAttribute('transform', `rotate(${f1((5 * th * 180) / Math.PI)})`);
				magnet.setAttribute('transform', `rotate(${f1((2.5 * th * 180) / Math.PI)} 238 54)`);
				lane.style.strokeDashoffset = f1((th * R) % 60);
				const b = Math.pow(v, 1.2);
				beam.style.opacity = f2(b);
				spot.style.opacity = f2(0.75 * b);
				glow.style.opacity = f2(b);
			});
		}

		// Card: the hand brings the card over the reader (0,06 → 0,38), holds it (→ 0,64), the turnstile opens
		// (0,5 → 0,62), the hand leaves (→ 0,86); 7 s. The field of the reader alternates all the time.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="card"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const hand = $<SVGGElement>('[data-hand]');
			const crd = $<SVGGElement>('[data-card]');
			const ant = [...card.querySelectorAll<SVGPathElement>('[data-antenna] path')];
			const chip = $<SVGRectElement>('[data-chip]');
			const field = [...card.querySelectorAll<SVGPathElement>('[data-field] path')];
			const no = $<SVGGElement>('[data-no]');
			const yes = $<SVGGElement>('[data-yes]');
			const flapL = $<SVGRectElement>('[data-flap-l]');
			const flapR = $<SVGRectElement>('[data-flap-r]');
			const RUN = 7;
			const SHOULDER = { x: -220, y: 320 };
			const AWAY = { x: 36, y: 64 }; // the card's left corner, far from the reader
			const OVER = { x: 236, y: 96 }; // the card's left corner when it hovers over the reader
			const path: [number, { x: number; y: number }][] = [
				[0, AWAY],
				[0.06, AWAY],
				[0.38, OVER],
				[0.64, OVER],
				[0.86, AWAY],
				[1, AWAY],
			];
			const at = (x: number) => {
				for (let k = 1; k < path.length; k++) {
					const [x0, p0] = path[k - 1];
					const [x1, p1] = path[k];
					if (x <= x1) {
						const t = smooth(x0, x1, x);
						// an arc: the card goes up a little on its way
						const lift = -24 * Math.sin(Math.PI * t) * (p0 === p1 ? 0 : 1);
						return { x: lerp(p0.x, p1.x, t), y: lerp(p0.y, p1.y, t) + lift };
					}
				}
				return AWAY;
			};
			scene(card, RUN, (x) => {
				const s = x * RUN;
				const p = at(x);
				crd.setAttribute('transform', `translate(${f1(p.x)} ${f1(p.y)})`);
				// the fingertips hold the card's left edge; the arm comes from a shoulder below the left edge
				const tip = { x: p.x + 8, y: p.y - 3 };
				const ang = (Math.atan2(tip.y - SHOULDER.y, tip.x - SHOULDER.x) * 180) / Math.PI;
				hand.setAttribute('transform', `translate(${f1(tip.x)} ${f1(tip.y)}) rotate(${f1(ang)}) scale(0.8)`);
				// the field alternates: the dashes run to and fro (much slower than in reality)
				const phase = Math.sin(2 * Math.PI * 1.2 * s);
				field.forEach((f) => (f.style.strokeDashoffset = f1(9 * phase)));
				// the antenna works only close to the reader: the field of a flat coil weakens fast with distance
				const d = Math.hypot(p.x - OVER.x, p.y - OVER.y);
				const c = clamp(1 - d / 70) ** 2;
				ant.forEach((a) => {
					a.style.opacity = f2(0.25 + 0.75 * c);
					a.style.strokeDashoffset = f1(-7 * phase * c);
				});
				chip.style.opacity = f2(0.5 + 0.5 * c);
				// the turnstile answers: green tick, the flaps slide into the cabinets
				const ok = smooth(0.5, 0.53, x);
				no.style.opacity = f2(1 - ok);
				yes.style.opacity = f2(ok);
				const open = smooth(0.52, 0.62, x);
				flapL.setAttribute('transform', `translate(62 0) scale(${f2(1 - 0.92 * open)} 1) translate(-62 0)`);
				flapR.setAttribute('transform', `translate(196 0) scale(${f2(1 - 0.92 * open)} 1) translate(-196 0)`);
			});
		}
	}
</script>
