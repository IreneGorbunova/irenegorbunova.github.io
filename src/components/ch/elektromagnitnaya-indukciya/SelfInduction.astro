---
/**
 * Self-induction, the school experiment drawn as a circuit diagram, looping. Two identical lamps in parallel
 * branches: Л1 with a rheostat, Л2 with a coil on an iron core; both branches have the same resistance. The key
 * closes: Л1 lights at once, the current in Л2 grows as I = I₀(1 − e^(−t/τ)). The key opens: the coil's current
 * cannot vanish at once, it goes on round the loop of both branches (through Л1 backwards) and dies away with τ/2
 * (the loop has twice the resistance). Brightness ∝ I². Small arrows show the direction of the current in each
 * branch. Plays only while visible.
 */
const uid = Math.random().toString(36).slice(2, 8);
const gGlow = `si-glow-${uid}`;
const HUMPS = [0, 1, 2, 3].map((k) => 222 + 13 * k);
---

<figure class="si not-content" data-si>
	<svg class="si__svg" viewBox="0 0 360 236" role="img" aria-label="Схема опыта: две одинаковые лампы подключены к источнику параллельно, первая через реостат, вторая через катушку с железным сердечником. Ключ замыкают: первая лампа загорается сразу, вторая — постепенно. Ключ размыкают: обе лампы гаснут не сразу, ток катушки ещё недолго идёт через обе лампы">
		<defs>
			<radialGradient id={gGlow}>
				<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.9"></stop>
				<stop offset="0.5" stop-color="var(--ig-v)" stop-opacity="0.35"></stop>
				<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
			</radialGradient>
		</defs>
		<!-- wires -->
		<path class="si__wire" d="M 36 118 V 56 H 60 M 92 56 H 159 M 181 56 H 228 M 268 56 H 320 V 196 H 36 V 130"></path>
		<path class="si__wire" d="M 110 56 V 150 H 159 M 181 150 H 222 M 274 150 H 320"></path>
		<circle class="si__node" cx="110" cy="56" r="3"></circle>
		<circle class="si__node" cx="320" cy="56" r="3"></circle>
		<circle class="si__node" cx="110" cy="150" r="3"></circle>
		<circle class="si__node" cx="320" cy="150" r="3"></circle>
		<!-- the source -->
		<line class="si__plate" x1="22" y1="118" x2="50" y2="118"></line>
		<line class="si__plate si__plate--short" x1="29" y1="130" x2="43" y2="130"></line>
		<text class="si__sign" x="56" y="116">+</text>
		<!-- the key -->
		<circle class="si__node" cx="60" cy="56" r="2.6"></circle>
		<circle class="si__node" cx="92" cy="56" r="2.6"></circle>
		<line class="si__lever" x1="60" y1="56" x2="92" y2="56" data-lever></line>
		<text class="si__lab" x="76" y="36" text-anchor="middle">К</text>
		<!-- lamp 1 and the rheostat -->
		<circle cx="170" cy="56" r="26" fill={`url(#${gGlow})`} class="si__glow" data-glow1></circle>
		<circle class="si__lamp" cx="170" cy="56" r="11"></circle>
		<circle class="si__lit" cx="170" cy="56" r="10" data-lit1></circle>
		<path class="si__cross" d="M 162.2 48.2 L 177.8 63.8 M 177.8 48.2 L 162.2 63.8"></path>
		<text class="si__lab" x="170" y="34" text-anchor="middle">Л1</text>
		<rect class="si__res" x="228" y="50" width="40" height="12"></rect>
		<path class="si__wire" d="M 236 74 L 260 40"></path>
		<path class="si__head" d="M 260 40 l -1.5 7 l 6.5 -4.5 z"></path>
		<text class="si__lab" x="248" y="34" text-anchor="middle">R</text>
		<!-- lamp 2 and the coil with an iron core -->
		<circle cx="170" cy="150" r="26" fill={`url(#${gGlow})`} class="si__glow" data-glow2></circle>
		<circle class="si__lamp" cx="170" cy="150" r="11"></circle>
		<circle class="si__lit" cx="170" cy="150" r="10" data-lit2></circle>
		<path class="si__cross" d="M 162.2 142.2 L 177.8 157.8 M 177.8 142.2 L 162.2 157.8"></path>
		<text class="si__lab" x="170" y="178" text-anchor="middle">Л2</text>
		<path class="si__coil" d={`M 222 150 ${HUMPS.map((x) => `A 6.5 6.5 0 0 1 ${x + 13} 150`).join(' ')}`}></path>
		<line class="si__core" x1="220" y1="136" x2="276" y2="136"></line>
		<text class="si__lab" x="248" y="127" text-anchor="middle">L</text>
		<!-- the direction of the current in each branch -->
		<path class="si__arrow" d="M -5 -4 L 3 0 L -5 4" data-a1></path>
		<path class="si__arrow" d="M -5 -4 L 3 0 L -5 4" data-a2></path>
		<text class="si__status" x="180" y="216" text-anchor="middle" data-status></text>
		<text class="si__status si__status--sub" x="180" y="231" text-anchor="middle" data-status2></text>
	</svg>
</figure>

<style>
	.si {
		margin: 1.25rem 0 1.5rem;
		padding: 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.si__svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin: 0 auto;
	}
	.si__svg text {
		font-family: var(--__sl-font);
	}
	.si__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.si__node {
		fill: var(--sl-color-gray-2);
	}
	.si__plate {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.si__plate--short {
		stroke-width: 5;
	}
	.si__sign {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
	}
	.si__lever {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.si__glow {
		opacity: 0;
	}
	.si__lamp {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.si__lit {
		fill: var(--ig-v);
		opacity: 0;
	}
	.si__cross {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.si__res {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.si__head {
		fill: var(--sl-color-gray-2);
	}
	.si__coil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.si__core {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
	}
	.si__lab {
		fill: var(--sl-color-gray-2);
		font-size: 12px;
	}
	.si__arrow {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.si__status {
		fill: var(--sl-color-white);
		font-size: 12px;
		font-weight: 600;
	}
	.si__status--sub {
		fill: var(--sl-color-gray-2);
		font-weight: 400;
	}
</style>

<script>
	import { loop, clamp } from '@components/intro/scene';

	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);
	const ON = 0.1; // the key closes (fraction of the cycle)
	const OFF = 0.63; // the key opens
	const TAU = 0.12; // time constant of the coil's branch (fraction of the cycle)
	/** Currents in the branches, in units of the steady current: [Л1 with the rheostat, Л2 with the coil]. */
	const currents = (x: number): [number, number] => {
		if (x < ON) return [0, 0];
		const grow = (u: number) => 1 - Math.exp(-(u - ON) / TAU);
		if (x < OFF) return [1, grow(x)];
		const i2 = grow(OFF) * Math.exp(-(x - OFF) / (TAU / 2));
		return [-i2, i2];
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-si]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const lever = $<SVGLineElement>('[data-lever]');
		const glow1 = $<SVGCircleElement>('[data-glow1]');
		const glow2 = $<SVGCircleElement>('[data-glow2]');
		const lit1 = $<SVGCircleElement>('[data-lit1]');
		const lit2 = $<SVGCircleElement>('[data-lit2]');
		const a1 = $<SVGPathElement>('[data-a1]');
		const a2 = $<SVGPathElement>('[data-a2]');
		const status = $<SVGTextElement>('[data-status]');
		const status2 = $<SVGTextElement>('[data-status2]');
		const RUN = 9;
		let t = 0;
		const draw = () => {
			const x = (t % RUN) / RUN;
			// the key: open (lever up 30°), closed between ON and OFF
			const closed = x >= ON && x < OFF;
			const a = closed ? 0 : (-30 * Math.PI) / 180;
			lever.setAttribute('x2', f1(60 + 32 * Math.cos(a)));
			lever.setAttribute('y2', f1(56 + 32 * Math.sin(a)));
			const [i1, i2] = currents(x);
			glow1.style.opacity = f2(i1 * i1);
			glow2.style.opacity = f2(i2 * i2);
			lit1.style.opacity = f2(0.85 * i1 * i1);
			lit2.style.opacity = f2(0.85 * i2 * i2);
			// arrows: in the top branch at x = 136, in the bottom branch at x = 136; + is from left to right
			a1.setAttribute('transform', `translate(136 56) scale(${i1 < 0 ? -1 : 1} 1)`);
			a2.setAttribute('transform', `translate(136 150) scale(${i2 < 0 ? -1 : 1} 1)`);
			a1.style.opacity = f2(clamp(Math.abs(i1) * 1.5));
			a2.style.opacity = f2(clamp(Math.abs(i2) * 1.5));
			if (x < ON) {
				status.textContent = 'Ключ разомкнут';
				status2.textContent = 'тока нет';
			} else if (x < OFF) {
				status.textContent = 'Ключ замкнули';
				status2.textContent = 'Л1 загорается сразу, Л2 — постепенно';
			} else {
				status.textContent = 'Ключ разомкнули';
				status2.textContent = Math.abs(i2) > 0.03 ? 'ток катушки ещё идёт через обе лампы' : 'обе лампы погасли не сразу';
			}
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
