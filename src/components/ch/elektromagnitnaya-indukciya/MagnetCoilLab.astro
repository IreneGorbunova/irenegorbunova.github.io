		/* coil pole badges: larger and moved a little away from the coil */
		.emi__cpole-in--l {
			transform: translate(-6px, 6px) scale(1.55);
		}
		.emi__cpole-in--r {
			transform: translate(6px, 6px) scale(1.55);
		}
