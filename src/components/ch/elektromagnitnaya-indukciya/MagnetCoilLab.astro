---
/**
 * Main model: Faraday's experiment. A bar magnet is dragged into and out of a coil connected to a
 * zero-centre galvanometer. Everything is drawn to scale (13 px per cm): coil 8 cm long, turn
 * radius 2.5 cm; magnet 10 cm × 2.4 cm. The flux, the EMF and the current are computed from the
 * field of the magnet (see physics.ts); the needle is a damped pointer, as in a real instrument.
 */
import katex from 'katex';
import { fieldLines, toPath, MAG_LEN, MAG_R, COIL_LEN, COIL_R } from './physics';

const uid = `emi-${Math.random().toString(36).slice(2, 8)}`;
const S = 13; // px per cm
const X0 = 360;
const Y0 = 112;
const ML = MAG_LEN * 100 * S; // magnet length, px
const MR = MAG_R * 100 * S;
const CL = COIL_LEN * 100 * S;
const CA = COIL_R * 100 * S;

const lines = fieldLines(10, { x: 52, y: 9.5 });
const box = { x: 52, y: 9.5 };
const toPx = (p: [number, number]): [number, number] => [p[0] * S, -p[1] * S];
const linePaths = lines.map((l) => toPath(l.pts, box, toPx, 2.5)).filter((d) => d.length > 0);
const arrowMarks = lines
	.flatMap((l) => l.arrows)
	.filter((a) => a.y < 8.4 && a.y > MAG_R * 100 + 0.3)
	.map((a) => ({ x: a.x * S, y: -a.y * S, deg: (-a.a * 180) / Math.PI }));

// Galvanometer: ±40 mA over ±55°.
const GX = X0;
const GY = 304;
const GR = 58;
const ticks = Array.from({ length: 17 }, (_, i) => -40 + 5 * i);
const tickPt = (mA: number, r: number) => {
	const a = ((mA / 40) * 55 * Math.PI) / 180;
	return [GX + r * Math.sin(a), GY - r * Math.cos(a)];
};

const xl = X0 - CL / 2;
const xr = X0 + CL / 2;
const wireL = `M${xl + 2} ${Y0 + CA} L${xl + 2} 228`;
const wireR = `M${xr - 2} 228 L${xr - 2} ${Y0 + CA}`;
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const texE = tex('\\mathcal{E}_i');
---

<figure class="emi not-content" data-emi-lab>
	<svg
		class="emi__scene"
		viewBox="0 0 720 340"
		role="group"
		aria-label="Опыт Фарадея: магнит, катушка и гальванометр"
		data-scene
	>
		<defs>
			<clipPath id={`${uid}-view`}>
				<rect x="0" y="0" width="720" height="216"></rect>
			</clipPath>
			<clipPath id={`${uid}-in`}>
				<rect x={xl} y={Y0 - CA} width={CL} height={2 * CA} data-coil-clip></rect>
			</clipPath>
			<g id={`${uid}-fl`}>
				{linePaths.map((d) => <path d={d} fill="none" />)}
				{arrowMarks.map((a) => <path d="M-4.5,-3.5 L3.5,0 L-4.5,3.5 z" stroke="none" transform={`translate(${a.x} ${a.y}) rotate(${a.deg})`} />)}
			</g>
			{
				['b', 'bi', 'f'].map((k) => (
					<marker id={`${uid}-${k}`} class={`emi__head emi__head--${k}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
						<path d="M0,0 L10,5 L0,10 z" />
					</marker>
				))
			}
		</defs>

		<!-- Back halves of the turns -->
		<g class="emi__coil-back" data-back></g>

		<!-- Field lines of the magnet; inside the coil they are drawn brighter -->
		<g clip-path={`url(#${uid}-view)`}>
			<g class="emi__fl" data-fl>
				<use href={`#${uid}-fl`}></use>
				<use href={`#${uid}-fl`} transform="scale(1,-1)"></use>
			</g>
		</g>
		<g clip-path={`url(#${uid}-in)`}>
			<g class="emi__fl emi__fl--in" data-fl-in>
				<use href={`#${uid}-fl`}></use>
				<use href={`#${uid}-fl`} transform="scale(1,-1)"></use>
			</g>
		</g>

		<!-- Magnet: drawn with the north pole to +x; a flip mirrors it -->
		<g class="emi__magnet" data-magnet tabindex="0" role="slider" aria-label="Магнит. Двигайте стрелками влево и вправо" aria-valuemin="-21" aria-valuemax="21" aria-valuenow="-18">
			<rect class="emi__hit" x={-ML / 2 - 14} y={-MR - 30} width={ML + 28} height={2 * MR + 60}></rect>
			<g data-magnet-body>
				<rect class="emi__pole emi__pole--s" x={-ML / 2} y={-MR} width={ML / 2} height={2 * MR} rx="3"></rect>
				<rect class="emi__pole emi__pole--n" x="0" y={-MR} width={ML / 2} height={2 * MR} rx="3"></rect>
				<rect class="emi__shine" x={-ML / 2 + 3} y={-MR + 3} width={ML - 6} height="4" rx="2"></rect>
			</g>
			<text class="emi__pole-label" x={-ML / 4} y="6" text-anchor="middle" data-label-s>S</text>
			<text class="emi__pole-label" x={ML / 4} y="6" text-anchor="middle" data-label-n>N</text>
		</g>

		<!-- Front halves of the turns and the current running along them -->
		<g class="emi__coil-front" data-front></g>
		<g class="emi__flow" data-flow></g>
		<ellipse class="emi__coil-end" cx={xr} cy={Y0} rx="6" ry={CA}></ellipse>

		<!-- Force on the magnet from the coil -->
		<g data-force>
			<line class="emi__vec emi__vec--f" marker-end={`url(#${uid}-f)`} data-force-line></line>
			<text class="emi__vlabel" data-force-label><tspan class="emi__m">F</tspan></text>
		</g>

		<!-- Field inside the coil: of the magnet (B) and of the induced current (B_инд) -->
		<g class="emi__inside">
			<line class="emi__vec emi__vec--b" marker-end={`url(#${uid}-b)`} data-b-line></line>
			<text class="emi__vlabel emi__vlabel--b" data-b-label><tspan class="emi__m">B</tspan><tspan class="emi__sub" dy="4">магн</tspan></text>
			<line class="emi__vec emi__vec--bi" marker-end={`url(#${uid}-bi)`} data-bi-line></line>
			<text class="emi__vlabel emi__vlabel--bi" data-bi-label><tspan class="emi__m">B</tspan><tspan class="emi__sub" dy="4">инд</tspan></text>
		</g>

		<!-- Poles of the coil itself (it is an electromagnet while the current flows) -->
		<g class="emi__cpole" data-cpole-l transform={`translate(${xl - 18} ${Y0 + CA + 16})`}>
			<g class="emi__cpole-in emi__cpole-in--l">
				<circle r="11"></circle>
				<text y="5" text-anchor="middle"></text>
			</g>
		</g>
		<g class="emi__cpole" data-cpole-r transform={`translate(${xr + 18} ${Y0 + CA + 16})`}>
			<g class="emi__cpole-in emi__cpole-in--r">
				<circle r="11"></circle>
				<text y="5" text-anchor="middle"></text>
			</g>
		</g>

		<!-- Circuit and galvanometer -->
		<path class="emi__wire" d={wireL} data-wire-l></path>
		<path class="emi__wire" d={wireR} data-wire-r></path>
		<g class="emi__chevrons" data-chev></g>

		<g class="emi__galv">
			<rect class="emi__case" x={GX - 76} y="226" width="152" height="104" rx="14"></rect>
			<rect class="emi__face" x={GX - 66} y="234" width="132" height="86" rx="9"></rect>
			{
				ticks.map((t) => {
					const [x1, y1] = tickPt(t, GR);
					const [x2, y2] = tickPt(t, t % 20 === 0 ? GR - 9 : GR - 5);
					return <line class={t === 0 ? 'emi__tick emi__tick--zero' : 'emi__tick'} x1={x1} y1={y1} x2={x2} y2={y2} />;
				})
			}
			{
				[-40, -20, 0, 20, 40].map((t) => {
					const [x, y] = tickPt(t, GR + 7);
					return (
						<text class="emi__glabel" x={x} y={y + 3} text-anchor="middle">
							{String(Math.abs(t))}
						</text>
					);
				})
			}
			<text class="emi__gunit" x={GX + 44} y={GY + 4} text-anchor="middle">мА</text>
			<line class="emi__needle" x1={GX} y1={GY} x2={GX} y2={GY - GR + 3} data-needle></line>
			<circle class="emi__pivot" cx={GX} cy={GY} r="5"></circle>
			<circle class="emi__terminal" cx={xl + 2} cy="228" r="4"></circle>
			<circle class="emi__terminal" cx={xr - 2} cy="228" r="4"></circle>
		</g>

		<g class="emi__hint" data-hint>
			<text x={X0 - 18 * S} y={Y0 + MR + 30} text-anchor="middle">⟵ тяните магнит ⟶</text>
		</g>
	</svg>

	<svg class="emi__chart" viewBox="0 0 720 282" role="img" aria-label="Графики магнитного потока и ЭДС индукции за последние 5 секунд" data-chart>
		<g class="emi__grid" data-grid></g>
		<line class="emi__zero" x1="64" y1="78" x2="704" y2="78"></line>
		<line class="emi__zero" x1="64" y1="210" x2="704" y2="210"></line>
		<text class="emi__clabel" x="56" y="22" text-anchor="end"><tspan class="emi__m">Φ</tspan>, мВб</text>
		<text class="emi__ctick" x="56" y="48" text-anchor="end" data-ptick>0,1</text>
		<text class="emi__ctick" x="56" y="82" text-anchor="end">0</text>
		<text class="emi__ctick" x="56" y="116" text-anchor="end">−0,1</text>
		<text class="emi__clabel" x="56" y="154" text-anchor="end"><tspan class="emi__m">ℰ</tspan>, мВ</text>
		<text class="emi__ctick" x="56" y="180" text-anchor="end" data-etop>200</text>
		<text class="emi__ctick" x="56" y="214" text-anchor="end">0</text>
		<text class="emi__ctick" x="56" y="248" text-anchor="end" data-ebot>−200</text>
		<clipPath id={`${uid}-phi`}><rect x="64" y="26" width="640" height="104"></rect></clipPath>
		<path class="emi__tangent" clip-path={`url(#${uid}-phi)`} data-tangent></path>
		<path class="emi__curve emi__curve--phi" data-cphi></path>
		<path class="emi__curve emi__curve--e" data-ce></path>
		<circle class="emi__dot emi__dot--phi" r="4" cx="704" cy="78" data-dphi></circle>
		<circle class="emi__dot emi__dot--e" r="4" cx="704" cy="210" data-de></circle>
		<text class="emi__ctick" x="704" y="278" text-anchor="end">сейчас</text>
		<text class="emi__ctick" x="64" y="278">5 с назад</text>
	</svg>

	<div class="emi__lenz" aria-live="polite" data-lenz>
		<span data-l1>Поток не меняется</span>
		<span class="emi__arrow">→</span>
		<span data-l2>тока нет</span>
		<span class="emi__arrow">→</span>
		<span data-l3>катушка на магнит не действует</span>
	</div>

	<dl class="emi__stats">
		<div><dt>Поток через виток <i>Φ</i></dt><dd data-o-phi>—</dd></div>
		<div><dt>ЭДС индукции <span set:html={texE} /> (за 0,1 с)</dt><dd data-o-e>—</dd></div>
		<div><dt>Сила тока <i>I</i> (за 0,1 с)</dt><dd data-o-i>—</dd></div>
	</dl>

	<div class="emi__formula" aria-hidden="true">
		<div data-f-e></div>
		<div data-f-i></div>
	</div>

	<div class="emi__controls">
		<label class="emi__slider">
			<span>Скорость магнита <i>υ</i></span>
			<output data-v-out>0,4 м/с</output>
			<input type="range" min="0.1" max="1" step="0.1" value="0.4" data-speed />
		</label>
		<fieldset class="emi__seg">
			<legend>Число витков <i>N</i></legend>
			<label><input type="radio" name={`${uid}-n`} value="100" />100</label>
			<label><input type="radio" name={`${uid}-n`} value="200" checked />200</label>
			<label><input type="radio" name={`${uid}-n`} value="400" />400</label>
		</fieldset>
		<div class="emi__buttons">
			<button type="button" class="emi__btn emi__btn--primary" data-act="in">Внести</button>
			<button type="button" class="emi__btn emi__btn--primary" data-act="out">Вынуть</button>
			<button type="button" class="emi__btn" data-act="through">Насквозь</button>
			<button type="button" class="emi__btn" data-act="flip">Перевернуть магнит</button>
		</div>
	</div>
	<p class="emi__live" data-live aria-live="polite"></p>

	<figcaption class="emi__legend">
		Масштаб настоящий: катушка длиной 8 см, магнит 10 см. <i>Φ</i> — магнитный поток через один виток
		(в среднем по виткам), <span set:html={texE} /> — ЭДС индукции всей катушки. Сопротивление
		цепи <span class="emi__nowrap"><i>R</i> = 10 Ом</span>. Линии магнитной индукции внутри катушки выделены
		ярче. Синий конец магнита — северный полюс <i>N</i>, красный — южный <i>S</i>.
	</figcaption>
</figure>

<style is:global>
	.emi {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.emi svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.emi__scene {
		user-select: none;
		-webkit-user-select: none;
	}
	.emi i,
	.emi__m {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	/* The lines live in <defs> and are shown through <use>: they inherit stroke and fill from here. */
	.emi__fl {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.3;
	}
	.emi__fl--in {
		fill: var(--ig-vx);
		stroke: var(--ig-vx);
		stroke-width: 2.2;
	}
	.emi__coil-back path {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 45%, var(--ig-surface));
		stroke-width: var(--emi-turn-back, 2.4);
	}
	.emi__coil-front path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: var(--emi-turn, 3);
		stroke-linecap: round;
	}
	.emi__coil-end {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 60%, var(--ig-surface));
		stroke-width: 1.5;
	}
	.emi__flow path {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-dasharray: 3 9;
	}
	.emi__magnet {
		cursor: grab;
		outline: none;
		touch-action: none;
	}
	.emi__magnet:active {
		cursor: grabbing;
	}
	.emi__magnet:focus-visible .emi__pole {
		stroke: var(--sl-color-accent);
		stroke-width: 3;
	}
	.emi__hit {
		fill: transparent;
	}
	.emi__pole--n {
		fill: var(--ig-vx);
	}
	.emi__pole--s {
		fill: var(--ig-vy);
	}
	.emi__shine {
		fill: rgb(255 255 255 / 0.25);
	}
	.emi__pole-label {
		fill: var(--sl-color-black);
		font: 700 17px var(--__sl-font);
	}
	.emi__vec {
		stroke-width: 3;
		stroke-linecap: round;
	}
	.emi__vec--b {
		stroke: var(--ig-vx);
	}
	.emi__vec--bi {
		stroke: var(--ig-v);
	}
	.emi__vec--f {
		stroke: var(--sl-color-gray-1);
	}
	.emi__head--b path {
		fill: var(--ig-vx);
	}
	.emi__head--bi path {
		fill: var(--ig-v);
	}
	.emi__head--f path {
		fill: var(--sl-color-gray-1);
	}
	.emi__vlabel {
		fill: var(--sl-color-gray-1);
		font-size: 17px;
		font-family: var(--__sl-font);
	}
	.emi__vlabel--b {
		fill: var(--ig-vx);
	}
	.emi__vlabel--bi {
		fill: var(--ig-v);
	}
	.emi__sub {
		font-size: 11px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
	.emi__cpole circle {
		stroke: none;
	}
	.emi__cpole text {
		fill: var(--sl-color-black);
		font: 700 14px var(--__sl-font);
	}
	.emi__cpole--n circle {
		fill: var(--ig-vx);
	}
	.emi__cpole--s circle {
		fill: var(--ig-vy);
	}
	.emi__wire {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-3));
		stroke-width: 2.5;
	}
	.emi__chevrons path {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.emi__case {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.emi__face {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-5);
	}
	.emi__tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.emi__tick--zero {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.emi__glabel,
	.emi__gunit {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		font-family: var(--__sl-font);
	}
	.emi__needle {
		stroke: var(--ig-vy);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.emi__pivot {
		fill: var(--sl-color-gray-2);
	}
	.emi__terminal {
		fill: var(--sl-color-gray-3);
	}
	.emi__hint text {
		fill: var(--sl-color-accent);
		font-size: 15px;
		font-family: var(--__sl-font);
	}
	.emi__hint {
		transition: opacity 0.6s;
	}

	.emi__chart {
		margin-top: 0.75rem;
	}
	.emi__grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.emi__zero {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.emi__clabel {
		fill: var(--sl-color-gray-2);
		font-size: 14px;
		font-family: var(--__sl-font);
	}
	.emi__ctick {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
		font-family: var(--__sl-font);
	}
	.emi__curve {
		fill: none;
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.emi__curve--phi {
		stroke: var(--ig-vx);
	}
	.emi__curve--e {
		stroke: var(--ig-v);
	}
	.emi__dot--phi {
		fill: var(--ig-vx);
	}
	.emi__dot--e {
		fill: var(--ig-v);
	}
	.emi__tangent {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}

	.emi__lenz {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.5rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.emi__lenz span:not(.emi__arrow) {
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		transition:
			border-color 0.3s,
			color 0.3s;
	}
	.emi__lenz.is-grow span:not(.emi__arrow),
	.emi__lenz.is-fall span:not(.emi__arrow) {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.emi__arrow {
		color: var(--sl-color-gray-4);
	}

	.emi__stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		margin: 0.75rem 0 0;
	}
	.emi__stats > div {
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
	}
	.emi__stats dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.emi__stats dd {
		margin: 0;
		font-size: var(--sl-text-xl);
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.emi__formula {
		margin-top: 0.6rem;
		padding: 0.4rem 0.75rem;
		border-radius: 0.6rem;
		border: 1px dashed var(--sl-color-gray-5);
		color: var(--sl-color-white);
		overflow-x: auto;
		min-height: 3.6rem;
	}
	.emi__formula .katex-display {
		margin: 0.25rem 0;
	}

	.emi__controls {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.75rem 1.5rem;
		margin-top: 0.9rem;
		align-items: end;
	}
	.emi__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
