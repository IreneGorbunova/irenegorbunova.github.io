	}
</style>

<script>
	import katex from 'katex';
	import { flux, dflux, FLUX_MAX, COIL_LEN, COIL_R, MAG_LEN, R_CIRCUIT } from './physics';

	const S = 1300; // px per metre
	const X0 = 360;
	const Y0 = 112;
	const CL = COIL_LEN * S;
	const CA = COIL_R * S;
	const XMIN = -0.21;
	const XMAX = 0.21;
	const X_OUT = -0.18;
	const ACC = 20; // m/s², start and stop of the automatic moves
	const OUTSIDE = (COIL_LEN + MAG_LEN) / 2 + 0.012; // magnet fully out of the coil
	const I_FULL = 0.04; // A, full scale of the galvanometer
	const NEEDLE_MAX = 55; // degrees at full scale
	const CHART_T = 5; // s shown on the chart
	const CX0 = 64;
	const CX1 = 704;
	const PHI_Y0 = 78;
	const PHI_K = 34 / 1e-4; // px per Wb (0,1 мВб → 34 px)
	const E_Y0 = 210;
	const E_HALF = 50; // px, half-height of the ℰ chart
	const E_TICKS = [0.2, 0.5, 1, 2]; // V, possible values of the labelled tick (drawn 34 px from zero)
	const SVG_NS = 'http://www.w3.org/2000/svg';
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

	const fmt = (v: number, d: number) => {
		const r = Math.round(v * 10 ** d) / 10 ** d;
		return (r === 0 ? 0 : r).toLocaleString('ru-RU', { minimumFractionDigits: d, maximumFractionDigits: d }).replace('-', '−');
	};
	const texNum = (v: number, d: number) => {
		const s = Math.abs(v).toFixed(d).replace('.', '{,}');
		return v < 0 && Number(s.replace('{,}', '.')) !== 0 ? `-${s}` : s;
	};
	const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

	type Auto = { x0: number; x1: number; v: number; t: number; T: number; kind: string; q: number; imax: number; sign: number[] };

	for (const root of document.querySelectorAll<HTMLElement>('[data-emi-lab]')) {
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const scene = q<SVGSVGElement>('[data-scene]');
		const magnet = q<SVGGElement>('[data-magnet]');
		const body = q<SVGGElement>('[data-magnet-body]');
		const labN = q<SVGTextElement>('[data-label-n]');
		const labS = q<SVGTextElement>('[data-label-s]');
		const fl = q<SVGGElement>('[data-fl]');
		const flIn = q<SVGGElement>('[data-fl-in]');
		const back = q<SVGGElement>('[data-back]');
		const front = q<SVGGElement>('[data-front]');
		const flow = q<SVGGElement>('[data-flow]');
		const chev = q<SVGGElement>('[data-chev]');
		const needle = q<SVGLineElement>('[data-needle]');
		const bLine = q<SVGLineElement>('[data-b-line]');
		const bLabel = q<SVGTextElement>('[data-b-label]');
		const biLine = q<SVGLineElement>('[data-bi-line]');
		const biLabel = q<SVGTextElement>('[data-bi-label]');
		const fLine = q<SVGLineElement>('[data-force-line]');
		const fLabel = q<SVGTextElement>('[data-force-label]');
		const cpL = q<SVGGElement>('[data-cpole-l]');
		const cpR = q<SVGGElement>('[data-cpole-r]');
		const hint = q<SVGGElement>('[data-hint]');
		const wireL = q<SVGPathElement>('[data-wire-l]');
		const wireR = q<SVGPathElement>('[data-wire-r]');
		const grid = q<SVGGElement>('[data-grid]');
		const cPhi = q<SVGPathElement>('[data-cphi]');
		const cE = q<SVGPathElement>('[data-ce]');
		const dPhi = q<SVGCircleElement>('[data-dphi]');
		const dE = q<SVGCircleElement>('[data-de]');
		const tangent = q<SVGPathElement>('[data-tangent]');
		const eTop = q<SVGTextElement>('[data-etop]');
		const eBot = q<SVGTextElement>('[data-ebot]');
		const lenz = q<HTMLElement>('[data-lenz]');
		const l1 = q<HTMLElement>('[data-l1]');
		const l2 = q<HTMLElement>('[data-l2]');
		const l3 = q<HTMLElement>('[data-l3]');
		const oPhi = q<HTMLElement>('[data-o-phi]');
		const oE = q<HTMLElement>('[data-o-e]');
		const oI = q<HTMLElement>('[data-o-i]');
		const fE = q<HTMLElement>('[data-f-e]');
		const fI = q<HTMLElement>('[data-f-i]');
		const speedIn = q<HTMLInputElement>('[data-speed]');
		const speedOut = q<HTMLOutputElement>('[data-v-out]');
		const live = q<HTMLElement>('[data-live]');

		// ---- state ----
		let x = X_OUT; // m
		let v = 0; // m/s
		let target = X_OUT;
		let mode: 'idle' | 'drag' | 'auto' = 'idle';
		let auto: Auto | null = null;
		let theta = 0; // magnet orientation: 0 — N to +x, π — N to −x
		let flip: { from: number; t: number } | null = null;
		let N = 200;
		let needleA = 0;
		let needleW = 0;
		let phase = 0; // phase of the current animation, px
		let simT = 0;
		let lastNow = 0;
		let running = false;
		let visible = true;
		let lenzState = 'none';
		let nextText = 0;
		let grabDX = 0;
		let eTick = E_TICKS[0]; // V, the labelled tick of the ℰ axis
		let eK = 34 / eTick; // px per V, eases towards 34 / eTick when the scale changes
		const hist: { t: number; phi: number; e: number }[] = [];

		// ---- coil drawing ----
		const drawCoil = () => {
			const n = N / 10;
			const step = CL / n;
			let b = '';
			let f = '';
			for (let k = 0; k < n; k++) {
				const xk = X0 - CL / 2 + (k + 0.5) * step;
				f += `<path d="M${xk} ${Y0 - CA} A6 ${CA} 0 0 1 ${xk} ${Y0 + CA}"/>`;
				b += `<path d="M${xk} ${Y0 + CA} A6 ${CA} 0 0 1 ${xk} ${Y0 - CA}"/>`;
			}
			back.innerHTML = b;
			front.innerHTML = f;
			flow.innerHTML = f;
			// one drawn turn stands for 10 real ones; thinner wire when the turns are dense
			root.style.setProperty('--emi-turn', Math.min(3, 0.5 * step).toFixed(2));
			root.style.setProperty('--emi-turn-back', Math.min(2.4, 0.42 * step).toFixed(2));
		};

		// ---- circuit: chevrons running along the wires ----
		const wires = [wireL, wireR];
		const wireLen = wires.map((w) => w.getTotalLength());
		const CH_GAP = 26;
		const chevs: SVGPathElement[] = [];
		const chevSlots: { w: number; s: number }[] = [];
		wires.forEach((_, w) => {
			for (let s = 0; s < wireLen[w]; s += CH_GAP) chevSlots.push({ w, s });
		});
		for (let i = 0; i < chevSlots.length; i++) {
			const p = document.createElementNS(SVG_NS, 'path');
			p.setAttribute('d', 'M-4,-4 L1,0 L-4,4');
			chev.append(p);
			chevs.push(p);
		}

		// ---- chart grid ----
		for (let s = 0; s <= CHART_T; s++) {
			const gx = CX0 + (s / CHART_T) * (CX1 - CX0);
			grid.insertAdjacentHTML('beforeend', `<line x1="${gx}" y1="30" x2="${gx}" y2="126"/><line x1="${gx}" y1="162" x2="${gx}" y2="258"/>`);
		}

		// ---- physics ----
		const orient = () => Math.cos(theta);
		const fluxNow = () => orient() * flux(x);

		const startAuto = (x1: number, kind: string) => {
			x1 = clamp(x1, XMIN, XMAX);
			const dist = Math.abs(x1 - x);
			if (dist < 0.002) return;
			const vmax = Number(speedIn.value);
			const acc = ACC; // short smooth start and stop
			const ta = vmax / acc;
			const T = dist < vmax * ta ? 2 * Math.sqrt(dist / acc) : dist / vmax + ta;
			auto = { x0: x, x1, v: vmax, t: 0, T, kind, q: 0, imax: 0, sign: [] };
			mode = 'auto';
			hint.style.opacity = '0';
			kick(true);
		};
		const autoPos = (a: Auto, t: number) => {
			const dist = Math.abs(a.x1 - a.x0);
			const dir = Math.sign(a.x1 - a.x0);
			const acc = ACC;
			let s: number;
			let sp: number;
			const ta = a.v / acc;
			if (dist < a.v * ta) {
				const th = a.T / 2;
				if (t < th) {
					s = (acc * t * t) / 2;
					sp = acc * t;
				} else {
					const u = a.T - t;
					s = dist - (acc * u * u) / 2;
					sp = acc * u;
				}
			} else if (t < ta) {
				s = (acc * t * t) / 2;
				sp = acc * t;
			} else if (t > a.T - ta) {
				const u = a.T - t;
				s = dist - (acc * u * u) / 2;
				sp = acc * u;
			} else {
				s = a.v * ta / 2 + a.v * (t - ta);
				sp = a.v;
			}
			return { x: a.x0 + dir * Math.min(s, dist), v: dir * Math.max(sp, 0) };
		};

		const step = (dt: number) => {
			simT += dt;
			const xPrev = x;
			const phiPrev = fluxNow();
			if (mode === 'auto' && auto) {
				auto.t = Math.min(auto.t + dt, auto.T);
				const p = autoPos(auto, auto.t);
				x = p.x;
				v = p.v;
			} else {
				// the magnet follows the hand (or the keyboard target) with a stiff, critically damped spring
				const w = 28;
				const sub = 4;
				const h = dt / sub;
				for (let i = 0; i < sub; i++) {
					const a = w * w * (target - x) - 2 * w * v;
					v += a * h;
					x += v * h;
				}
				if (x < XMIN || x > XMAX) {
					x = clamp(x, XMIN, XMAX);
					v = 0;
				}
				if (mode === 'idle' && Math.abs(target - x) < 1e-5 && Math.abs(v) < 1e-4) {
					x = target;
					v = 0;
				}
			}
			let dsdt = 0;
			if (flip) {
				flip.t = Math.min(flip.t + dt, 0.5);
				const u = flip.t / 0.5;
				const e = (1 - Math.cos(Math.PI * u)) / 2;
				const thNew = flip.from + Math.PI * e;
				dsdt = (Math.cos(thNew) - Math.cos(theta)) / dt;
				theta = thNew;
				if (flip.t >= 0.5) {
					theta = flip.from + Math.PI;
					flip = null;
				}
			}
			const s = orient();
			const dPhidt = s * dflux(x) * v + flux(x) * dsdt;
			const E = -N * dPhidt; // V
			const I = E / R_CIRCUIT; // A
			if (mode === 'auto' && auto) {
				// charge through the circuit in this step: I·Δt = −N·ΔΦ/R (exact, whatever the step)
				auto.q += (-N * (fluxNow() - phiPrev)) / R_CIRCUIT;
				auto.imax = Math.max(auto.imax, Math.abs(I));
				if (Math.abs(I) > 0.002) {
					const sg = Math.sign(I);
					if (auto.sign[auto.sign.length - 1] !== sg) auto.sign.push(sg);
				}
				if (auto.t >= auto.T) finishAuto();
			}
			// galvanometer needle: a damped pointer (right for I < 0, i.e. when the N pole enters)
			const aT = clamp((-I / I_FULL) * NEEDLE_MAX, -62, 62);
			const w0 = 15;
			const z = reduce.matches ? 1 : 0.55;
			needleW += (w0 * w0 * (aT - needleA) - 2 * z * w0 * needleW) * dt;
			needleA += needleW * dt;
			if (Math.abs(needleA) > 62) {
				needleA = Math.sign(needleA) * 62;
				needleW = 0;
			}
			phase += (I / I_FULL) * 90 * dt;
			hist.push({ t: simT, phi: s * flux(x), e: E });
			while (hist.length && hist[0].t < simT - CHART_T - 0.5) hist.shift();
			return { E, I, dPhidt, moved: x !== xPrev };
		};

		const finishAuto = () => {
			if (!auto) return;
			const a = auto;
			mode = 'idle';
			target = x;
			v = 0;
			auto = null;
			const dur = `${fmt(a.T, 2)} с`;
			const imax = `${fmt(a.imax * 1000, 1)} мА`;
			if (a.kind === 'through' && a.sign.length > 1) {
				live.textContent = `Магнит прошёл сквозь катушку за ${dur}. Стрелка качнулась сначала в одну сторону, потом в другую: пока магнит входит, поток растёт, а когда выходит — убывает.`;
			} else {
				const qq = `${fmt(Math.abs(a.q) * 1000, 2)} мКл`;
				const off = a.imax > I_FULL ? ' Ток был больше 40 мА — стрелка уходила за край шкалы, прибор «зашкаливал».' : '';
				live.textContent = `Магнит ${a.kind === 'in' ? 'внесли' : 'вынули'} за ${dur}. Наибольший ток ${imax}, через гальванометр прошёл заряд ${qq}.${off} Повторите с другой скоростью и сравните.`;
			}
		};

		// ---- drawing ----
		const setLine = (el: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
			el.setAttribute('x1', x1.toFixed(1));
			el.setAttribute('y1', y1.toFixed(1));
			el.setAttribute('x2', x2.toFixed(1));
			el.setAttribute('y2', y2.toFixed(1));
		};
		const setPole = (g: SVGGElement, letter: string, op: number) => {
			g.classList.toggle('emi__cpole--n', letter === 'N');
			g.classList.toggle('emi__cpole--s', letter === 'S');
			g.querySelector('text')!.textContent = letter;
			g.style.opacity = op.toFixed(2);
		};

		const draw = (st: { E: number; I: number; dPhidt: number }) => {
			const mx = X0 + x * S;
			const sc = Math.cos(theta);
			body.setAttribute('transform', `scale(${sc.toFixed(4)} 1)`);
			const ML4 = (MAG_LEN * S) / 4;
			labN.setAttribute('x', (sc * ML4).toFixed(1));
			labS.setAttribute('x', (-sc * ML4).toFixed(1));
			labN.style.opacity = labS.style.opacity = Math.max(0, (Math.abs(sc) - 0.4) / 0.6).toFixed(2);
			magnet.setAttribute('transform', `translate(${mx.toFixed(2)} ${Y0})`);
			const tr = `translate(${mx.toFixed(2)} ${Y0}) scale(${Math.sign(sc) || 1} 1)`;
			fl.setAttribute('transform', tr);
			flIn.setAttribute('transform', tr);
			const flOp = Math.abs(sc) ** 2;
			fl.style.opacity = flOp.toFixed(2);
			flIn.style.opacity = flOp.toFixed(2);
			magnet.setAttribute('aria-valuenow', String(Math.round(x * 100)));
			magnet.setAttribute(
				'aria-valuetext',
				Math.abs(x) < OUTSIDE - 0.012 ? 'магнит в катушке' : `${Math.round(Math.abs(x) * 100)} см ${x < 0 ? 'левее' : 'правее'} центра катушки`,
			);

			// field of the magnet inside the coil and of the induced current
			const phi = fluxNow();
			const yB = 40;
			const yBi = 16;
			const sB = Math.sign(phi) || 1;
			const lenB = 18 + 34 * Math.min(1, Math.abs(phi) / FLUX_MAX);
			setLine(bLine, X0 - (sB * lenB) / 2, yB, X0 + (sB * lenB) / 2, yB);
			bLine.style.opacity = clamp((Math.abs(phi) / FLUX_MAX - 0.04) / 0.12, 0, 1).toFixed(2);
			bLabel.setAttribute('x', String(X0 + 34));
			bLabel.setAttribute('y', String(yB + 6));
			bLabel.style.opacity = bLine.style.opacity;
			const I = st.I;
			const sI = Math.sign(I) || 1;
			const lenBi = 14 + 40 * Math.min(1, Math.abs(I) / 0.02);
			setLine(biLine, X0 - (sI * lenBi) / 2, yBi, X0 + (sI * lenBi) / 2, yBi);
			const opI = Math.min(1, Math.abs(I) / 0.002);
			biLine.style.opacity = opI.toFixed(2);
			biLabel.setAttribute('x', String(X0 + 34));
			biLabel.setAttribute('y', String(yBi + 6));
			biLabel.style.opacity = opI.toFixed(2);
			setPole(cpL, I > 0 ? 'S' : 'N', opI);
			setPole(cpR, I > 0 ? 'N' : 'S', opI);

			// force of the coil on the magnet: F = N·I·dΦ/dx, always against the motion
			const F = N * I * Math.cos(theta) * dflux(x);
			const lenF = Math.min(70, Math.abs(F) * 1000 * 6);
			const yF = Y0 - 46;
			if (lenF > 3) {
				setLine(fLine, mx, yF, mx + Math.sign(F) * lenF, yF);
				fLine.style.opacity = '1';
				fLabel.setAttribute('x', String(mx + Math.sign(F) * (lenF + 10)));
				fLabel.setAttribute('y', String(yF + 6));
				fLabel.setAttribute('text-anchor', F > 0 ? 'start' : 'end');
				fLabel.style.opacity = '1';
			} else {
				fLine.style.opacity = '0';
				fLabel.style.opacity = '0';
			}

			// current: dashes on the front strands move down for I > 0, chevrons run along the wires
			flow.style.opacity = opI.toFixed(2);
			flow.style.strokeDashoffset = reduce.matches ? '0' : String(-phase);
			const dirSign = sI;
			chevSlots.forEach((slot, i) => {
				const L = wireLen[slot.w];
				// I > 0: current leaves the coil through the right lead, goes down, through the meter, and up the left lead.
				// Paths: left wire is drawn downward from the coil, right wire upward to the coil.
				let s = slot.s + (reduce.matches ? 0 : -phase * 0.6);
				s = ((s % L) + L) % L;
				const p = wires[slot.w].getPointAtLength(s);
				const p2 = wires[slot.w].getPointAtLength(Math.min(L, s + 1));
				const p1 = wires[slot.w].getPointAtLength(Math.max(0, s - 1));
				let ang = (Math.atan2(p2.y - p1.y, p2.x - p1.x) * 180) / Math.PI;
				if (dirSign > 0) ang += 180;
				chevs[i].setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${ang.toFixed(0)})`);
				chevs[i].style.opacity = opI.toFixed(2);
			});

			needle.setAttribute('transform', `rotate(${needleA.toFixed(2)} 360 304)`);

			// chart. The ℰ axis rescales in steps (200, 500, 1000, 2000 мВ) so that no peak is cut off.
			const tx = (t: number) => CX1 - ((simT - t) / CHART_T) * (CX1 - CX0);
			let eMax = 0;
			for (const h of hist) if (h.t >= simT - CHART_T) eMax = Math.max(eMax, Math.abs(h.e));
			const need = E_TICKS.find((T) => eMax <= (T * E_HALF) / 34) ?? E_TICKS[E_TICKS.length - 1];
			if (need !== eTick) {
				eTick = need;
				const mv = Math.round(eTick * 1000);
				eTop.textContent = String(mv);
				eBot.textContent = `−${mv}`;
			}
			const eKgoal = 34 / eTick;
			eK = reduce.matches ? eKgoal : eK + (eKgoal - eK) * 0.18;
			if (Math.abs(eK - eKgoal) < 0.01 * eKgoal) eK = eKgoal;
			const tickY = eTick * eK;
			const tickOp = tickY <= E_HALF + 2 ? '1' : '0';
			eTop.setAttribute('y', (E_Y0 - tickY + 4).toFixed(1));
			eBot.setAttribute('y', (E_Y0 + tickY + 4).toFixed(1));
			eTop.style.opacity = eBot.style.opacity = tickOp;
			const ey = (e: number) => clamp(E_Y0 - e * eK, E_Y0 - E_HALF - 2, E_Y0 + E_HALF + 2).toFixed(1);
			let dp = '';
			let de = '';
			for (let i = 0; i < hist.length; i += 2) {
				const h = hist[i];
				if (h.t < simT - CHART_T) continue;
				const X = tx(h.t).toFixed(1);
				const yp = clamp(PHI_Y0 - h.phi * PHI_K, 26, 130).toFixed(1);
				dp += `${dp ? 'L' : 'M'}${X} ${yp}`;
				de += `${de ? 'L' : 'M'}${X} ${ey(h.e)}`;
			}
			const last = hist[hist.length - 1];
			if (last) {
				dp += `L${CX1} ${(PHI_Y0 - last.phi * PHI_K).toFixed(1)}`;
				de += `L${CX1} ${ey(last.e)}`;
			}
			cPhi.setAttribute('d', dp);
			cE.setAttribute('d', de);
			const yP = PHI_Y0 - phi * PHI_K;
			dPhi.setAttribute('cy', yP.toFixed(1));
			dE.setAttribute('cy', ey(st.E));
			// tangent to Φ(t) at "now": its slope is ΔΦ/Δt
			const slope = (st.dPhidt * PHI_K * CHART_T) / (CX1 - CX0); // px per px
			if (Math.abs(st.E) > 0.003) {
				const dx = 60;
				tangent.setAttribute('d', `M${CX1 - dx} ${(yP + slope * dx).toFixed(1)} L${CX1} ${yP.toFixed(1)}`);
			} else tangent.setAttribute('d', '');
		};

		// ---- text outputs, 10 times a second ----
		const sampleAgo = (dt: number) => {
			const t = simT - dt;
			for (let i = hist.length - 1; i > 0; i--) {
				if (hist[i - 1].t <= t) {
					const a = hist[i - 1];
					const b = hist[i];
					const u = b.t > a.t ? (t - a.t) / (b.t - a.t) : 0;
					return a.phi + (b.phi - a.phi) * u;
				}
			}
			return hist.length ? hist[0].phi : fluxNow();
		};
		const writeText = (st: { E: number; I: number }) => {
			const phi = fluxNow();
			oPhi.textContent = `${fmt(phi * 1000, 3)} мВб`;
			// ℰ over the last 0,1 s, computed from the rounded numbers that are on the screen
			const dphi = Math.round((phi - sampleAgo(0.1)) * 1e7) / 1e7; // Wb, to 0,0001 мВб
			const eRaw = (-N * dphi * 1000) / 0.1; // мВ
			const eShow = Math.round(eRaw);
			const eSign = Math.abs(eRaw - eShow) < 1e-6 ? '=' : '\\approx';
			const iShow = Math.round((Math.abs(eShow) / R_CIRCUIT) * 10) / 10; // мА
			const dTex = dphi < 0 ? `(${texNum(dphi * 1000, 4)})` : texNum(dphi * 1000, 4);
			oE.textContent = `${fmt(eShow, 0)} мВ`;
			oI.textContent = `${fmt(iShow, 1)} мА`;
			const br = root.clientWidth < 560 ? '\\\\ &' : '';
			katex.render(
				String.raw`\begin{aligned}\mathcal{E}_i &= -N\dfrac{\Delta\Phi}{\Delta t} ${br}= -${N}\cdot\dfrac{${dTex}~\text{мВб}}{0{,}1~\text{с}} ${eSign} ${texNum(eShow, 0)}~\text{мВ}\end{aligned}`,
				fE,
				{ displayMode: true, throwOnError: false },
			);
			katex.render(
				String.raw`I = \dfrac{|\mathcal{E}_i|}{R} = \dfrac{${texNum(Math.abs(eShow), 0)}~\text{мВ}}{10~\text{Ом}} = ${texNum(iShow, 1)}~\text{мА}`,
				fI,
				{ displayMode: true, throwOnError: false },
			);
			// Lenz chain
			const grow = Math.sign(phi) * (st.E === 0 ? 0 : -st.E) > 0; // |Φ| grows when −ℰ has the sign of Φ
			const big = Math.abs(st.E);
			let state = lenzState;
			if (big > 0.004) state = grow ? 'grow' : 'fall';
			else if (big < 0.002) state = 'none';
			if (state !== lenzState) {
				lenzState = state;
				lenz.classList.toggle('is-grow', state === 'grow');
				lenz.classList.toggle('is-fall', state === 'fall');
				if (state === 'grow') {
					l1.textContent = 'Поток через катушку растёт';
					l2.textContent = 'поле тока направлено против поля магнита';
					l3.textContent = 'катушка отталкивает магнит';
				} else if (state === 'fall') {
					l1.textContent = 'Поток через катушку убывает';
					l2.textContent = 'поле тока направлено как поле магнита';
					l3.textContent = 'катушка притягивает магнит';
				} else {
					l1.textContent = 'Поток не меняется';
					l2.textContent = 'тока нет';
					l3.textContent = 'катушка на магнит не действует';
				}
			}
		};

		// ---- loop ----
		let lastSt = { E: 0, I: 0, dPhidt: 0 };
		const frame = (now: number) => {
			if (!running) return;
			const dt = Math.min(0.05, Math.max(0.001, (now - lastNow) / 1000));
			lastNow = now;
			const sub = Math.ceil(dt / 0.01);
			for (let i = 0; i < sub; i++) lastSt = step(dt / sub);
			draw(lastSt);
			if (simT >= nextText) {
				nextText = simT + 0.1;
				writeText(lastSt);
			}
			requestAnimationFrame(frame);
		};
		/** Start the loop. `user` — the reader touched the model, so it is certainly on the screen. */
		const kick = (user = false) => {
			if (user) visible = true;
			if (running || !visible) return;
			running = true;
			lastNow = performance.now();
			requestAnimationFrame(frame);
		};
		new IntersectionObserver((entries) => {
			// several changes can arrive in one batch: the last one is the current state
			visible = entries[entries.length - 1].isIntersecting;
			if (!visible) running = false;
			else kick();
		}).observe(root);

		// ---- input ----
		const toSvgX = (clientX: number, clientY: number) => {
			const pt = scene.createSVGPoint();
			pt.x = clientX;
			pt.y = clientY;
			const m = scene.getScreenCTM();
			return m ? pt.matrixTransform(m.inverse()).x : 0;
		};
		// touch-action is ignored on SVG <g> in some browsers, so stop the page scroll here
		magnet.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });
		magnet.addEventListener('pointerdown', (e) => {
			e.preventDefault();
			magnet.setPointerCapture(e.pointerId);
			mode = 'drag';
			auto = null;
			grabDX = x - (toSvgX(e.clientX, e.clientY) - X0) / S;
			target = x;
			hint.style.opacity = '0';
			magnet.focus({ preventScroll: true });
			kick(true);
		});
		magnet.addEventListener('pointermove', (e) => {
			if (mode !== 'drag') return;
			target = clamp((toSvgX(e.clientX, e.clientY) - X0) / S + grabDX, XMIN, XMAX);
		});
		const release = () => {
			if (mode === 'drag') mode = 'idle';
		};
		magnet.addEventListener('pointerup', release);
		magnet.addEventListener('pointercancel', release);
		magnet.addEventListener('keydown', (e) => {
			const d = e.shiftKey ? 0.05 : 0.01;
			if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') target = clamp((mode === 'auto' ? x : target) - d, XMIN, XMAX);
			else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') target = clamp((mode === 'auto' ? x : target) + d, XMIN, XMAX);
			else return;
			e.preventDefault();
			mode = 'idle';
			auto = null;
			hint.style.opacity = '0';
			kick(true);
		});

		speedIn.addEventListener('input', () => {
			speedOut.value = `${fmt(Number(speedIn.value), 1)} м/с`;
		});
		for (const r of root.querySelectorAll<HTMLInputElement>('.emi__seg input')) {
			r.addEventListener('change', () => {
				N = Number(r.value);
				drawCoil();
				kick(true);
			});
		}
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-act]')) {
			b.addEventListener('click', () => {
				const act = b.dataset.act;
				if (act === 'in') startAuto(0, 'in');
				else if (act === 'out') startAuto(x > 0 ? -X_OUT : X_OUT, 'out');
				else if (act === 'through') startAuto(x > 0 ? XMIN + 0.03 : XMAX - 0.03, 'through');
				else if (act === 'flip') {
					if (Math.abs(x) < OUTSIDE) {
						live.textContent = 'Магнит длиннее, чем диаметр катушки: внутри неё его не перевернуть. Сначала выньте магнит.';
						return;
					}
					if (!flip) {
						flip = { from: theta, t: 0 };
						live.textContent = '';
						kick(true);
					}
				}
			});
		}

		drawCoil();
		for (let i = 0; i < 3; i++) hist.push({ t: -CHART_T + i, phi: fluxNow(), e: 0 });
		draw(lastSt);
		writeText(lastSt);
		kick();
	}
</script>
