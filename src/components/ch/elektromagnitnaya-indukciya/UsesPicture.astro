---
/**
 * Small pictures to «Где это встречается» (CSS loops): a generator (a coil turning between the poles N and S), wireless
 * charging (the field of the pad's coil passes through the coil of the phone), an induction hob (the field of the coil
 * under the glass heats the bottom of the pot), a metal detector (its field drives eddy currents in a coin under the
 * ground), an electric guitar (a steel string vibrates over a pickup: a magnet with a coil), and a magnet falling in a
 * copper tube slowly, next to one falling outside it fast. Blue dashed lines: lines of magnetic induction.
 */
const uid = Math.random().toString(36).slice(2, 8);
const mB = `eu-b-${uid}`;
---

<figure class="eu not-content">
	<div class="eu__grid">
		<svg class="eu__svg" viewBox="0 0 200 150" role="img" aria-label="Генератор: рамка из провода вращается между северным и южным полюсами магнита">
			<defs>
				<marker id={mB} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="eu__bhead" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<text class="eu__title" x="10" y="18">Генератор</text>
			<rect class="eu__n" x="14" y="40" width="40" height="76" rx="4"></rect>
			<rect class="eu__s" x="146" y="40" width="40" height="76" rx="4"></rect>
			<text class="eu__pole" x="34" y="83" text-anchor="middle">N</text>
			<text class="eu__pole" x="166" y="83" text-anchor="middle">S</text>
			{[54, 78, 102].map((y) => <line class="eu__b" x1="56" y1={y} x2="142" y2={y} marker-end={`url(#${mB})`} />)}
			<line class="eu__axis" x1="100" y1="34" x2="100" y2="134"></line>
			<rect class="eu__frame eu__spin" x="80" y="48" width="40" height="62" rx="2"></rect>
			<ellipse class="eu__slip" cx="100" cy="124" rx="9" ry="3"></ellipse>
			<ellipse class="eu__slip" cx="100" cy="132" rx="9" ry="3"></ellipse>
		</svg>

		<svg class="eu__svg" viewBox="0 0 200 150" role="img" aria-label="Беспроводная зарядка: магнитное поле катушки в зарядной площадке проходит сквозь катушку в телефоне">
			<text class="eu__title" x="10" y="18">Беспроводная зарядка</text>
			<ellipse class="eu__pad" cx="100" cy="118" rx="76" ry="18"></ellipse>
			<ellipse class="eu__copper-thin" cx="100" cy="116" rx="40" ry="8"></ellipse>
			<ellipse class="eu__copper-thin" cx="100" cy="116" rx="30" ry="6"></ellipse>
			<ellipse class="eu__copper-thin" cx="100" cy="116" rx="20" ry="4"></ellipse>
			<g class="eu__pulse">
				<path class="eu__b" d="M 86 112 C 84 60 40 54 44 112"></path>
				<path class="eu__b" d="M 114 112 C 116 60 160 54 156 112"></path>
				<path class="eu__b" d="M 94 112 C 94 40 30 36 30 112"></path>
				<path class="eu__b" d="M 106 112 C 106 40 170 36 170 112"></path>
			</g>
			<path class="eu__phone" d="M 50 86 L 140 86 L 152 76 L 62 76 Z"></path>
			<ellipse class="eu__copper-thin eu__glow" cx="101" cy="81" rx="26" ry="3.5"></ellipse>
			<ellipse class="eu__copper-thin eu__glow" cx="101" cy="81" rx="16" ry="2"></ellipse>
		</svg>

		<svg class="eu__svg" viewBox="0 0 200 150" role="img" aria-label="Индукционная плита: магнитное поле катушки под стеклом проходит через дно кастрюли и нагревает его; вода закипает">
			<text class="eu__title" x="10" y="18">Индукционная плита</text>
			<g class="eu__pulse">
				<path class="eu__b" d="M 76 116 C 70 80 40 80 40 116"></path>
				<path class="eu__b" d="M 124 116 C 130 80 160 80 160 116"></path>
			</g>
			<path class="eu__pot" d="M 52 58 H 148 V 98 Q 148 102 144 102 H 56 Q 52 102 52 98 Z"></path>
			<path class="eu__water" d="M 55 70 H 145 V 97 Q 145 99 143 99 H 57 Q 55 99 55 97 Z"></path>
			<line class="eu__handle" x1="40" y1="64" x2="52" y2="64"></line>
			<line class="eu__handle" x1="148" y1="64" x2="160" y2="64"></line>
			<line class="eu__hot" x1="56" y1="101" x2="144" y2="101"></line>
			<g class="eu__bubbles">
				<circle cx="78" cy="90" r="2"></circle>
				<circle cx="100" cy="94" r="2.4"></circle>
				<circle cx="122" cy="88" r="1.8"></circle>
			</g>
			<path class="eu__steam" d="M 84 52 q -5 -8 0 -16 q 5 -8 0 -16 M 112 52 q -5 -8 0 -16 q 5 -8 0 -16"></path>
			<rect class="eu__glass" x="16" y="104" width="168" height="6" rx="2"></rect>
			{[62, 76, 90, 110, 124, 138].map((x) => <circle class="eu__wire-dot" cx={x} cy="118" r="4" />)}
		</svg>

		<svg class="eu__svg" viewBox="0 0 200 150" role="img" aria-label="Металлоискатель: поле его катушки наводит вихревые токи в монете, спрятанной в земле, и прибор это замечает">
			<text class="eu__title" x="10" y="18">Металлоискатель</text>
			<rect class="eu__ground" x="0" y="100" width="200" height="50"></rect>
			<line class="eu__stick" x1="104" y1="86" x2="166" y2="28"></line>
			<rect class="eu__grip" x="158" y="24" width="22" height="9" rx="3" transform="rotate(-43 169 28)"></rect>
			<g class="eu__pulse">
				<path class="eu__b" d="M 76 92 C 70 126 130 126 124 92"></path>
				<path class="eu__b" d="M 66 92 C 56 142 144 142 134 92"></path>
			</g>
			<ellipse class="eu__coil" cx="100" cy="88" rx="40" ry="8"></ellipse>
			<ellipse class="eu__coin" cx="100" cy="130" rx="12" ry="3.5"></ellipse>
			<ellipse class="eu__eddy" cx="100" cy="130" rx="17" ry="6"></ellipse>
		</svg>

		<svg class="eu__svg" viewBox="0 0 200 150" role="img" aria-label="Электрогитара: стальная струна колеблется над звукоснимателем — магнитом с катушкой; в катушке возникает переменная ЭДС">
			<text class="eu__title" x="10" y="18">Электрогитара</text>
			<line class="eu__nut" x1="20" y1="38" x2="20" y2="62"></line>
			<line class="eu__nut" x1="180" y1="38" x2="180" y2="62"></line>
			<path class="eu__string" d="M 20 50 Q 100 38 180 50"></path>
			<rect class="eu__n" x="92" y="66" width="16" height="22" rx="2"></rect>
			<rect class="eu__s" x="92" y="88" width="16" height="22" rx="2"></rect>
			{[70, 77, 84, 91, 98, 105].map((y) => <ellipse class="eu__turn" cx="100" cy={y} rx="16" ry="2.6" />)}
			<text class="eu__side" x="122" y="81">N</text>
			<text class="eu__side" x="122" y="103">S</text>
			<path class="eu__lead" d="M 84 106 Q 70 132 40 130 M 116 106 Q 130 132 160 130"></path>
			<text class="eu__note" x="100" y="144" text-anchor="middle">к усилителю</text>
		</svg>

		<svg class="eu__svg" viewBox="0 0 200 150" role="img" aria-label="Два одинаковых магнита отпускают одновременно: снаружи магнит падает быстро, а внутри медной трубы — медленно">
			<text class="eu__title" x="10" y="18">Магнит в медной трубе</text>
			<rect class="eu__tube" x="44" y="28" width="9" height="104"></rect>
			<rect class="eu__tube" x="81" y="28" width="9" height="104"></rect>
			<rect class="eu__tube-in" x="53" y="28" width="28" height="104"></rect>
			<g class="eu__slow">
				<rect class="eu__n" x="58" y="30" width="18" height="10" rx="2"></rect>
				<rect class="eu__s" x="58" y="40" width="18" height="10" rx="2"></rect>
				<ellipse class="eu__eddy-ring" cx="67" cy="32" rx="16" ry="3"></ellipse>
				<ellipse class="eu__eddy-ring" cx="67" cy="49" rx="16" ry="3"></ellipse>
			</g>
			<g class="eu__fast">
				<rect class="eu__n" x="138" y="30" width="18" height="10" rx="2"></rect>
				<rect class="eu__s" x="138" y="40" width="18" height="10" rx="2"></rect>
			</g>
			<line class="eu__floor" x1="110" y1="133" x2="190" y2="133"></line>
			<text class="eu__note" x="67" y="146" text-anchor="middle">медленно</text>
			<text class="eu__note" x="147" y="146" text-anchor="middle">быстро</text>
		</svg>
	</div>
</figure>

<style>
	.eu {
		margin: 1.25rem 0 1.5rem;
	}
	.eu__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@media (max-width: 40rem) {
		.eu__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.eu__svg {
		display: block;
		width: 100%;
		height: auto;
		padding: 0.3rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.8rem;
		background: var(--ig-surface);
		box-sizing: border-box;
	}
	.eu__svg text {
		font-family: var(--__sl-font);
	}
	.eu__title {
		fill: var(--sl-color-white);
		font-size: 13px;
		font-weight: 600;
	}
	.eu__note {
		fill: var(--sl-color-gray-2);
		font-size: 11px;
	}
	.eu__n {
		fill: var(--ig-vx);
	}
	.eu__s {
		fill: var(--ig-vy);
	}
	.eu__pole {
		fill: var(--sl-color-black);
		font-size: 15px;
		font-weight: 700;
	}
	.eu__side {
		fill: var(--sl-color-gray-2);
		font-size: 11px;
		font-weight: 700;
	}
	.eu__b {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}
	.eu__bhead {
		fill: var(--ig-vx);
	}
	.eu__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.eu__frame {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		stroke-width: 4;
	}
	.eu__slip {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		stroke-width: 2;
	}
	.eu__spin {
		transform-box: fill-box;
		transform-origin: 50% 50%;
		animation: eu-spin 2.4s ease-in-out infinite alternate;
	}
	@keyframes eu-spin {
		from {
			transform: scaleX(1);
		}
		to {
			transform: scaleX(-1);
		}
	}
	.eu__pad {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.eu__copper-thin {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		stroke-width: 1.6;
	}
	.eu__phone {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 55%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.eu__pulse {
		animation: eu-pulse 1.4s ease-in-out infinite alternate;
	}
	@keyframes eu-pulse {
		from {
			opacity: 0.35;
		}
		to {
			opacity: 1;
		}
	}
	.eu__glow {
		stroke: var(--ig-v);
		animation: eu-pulse 1.4s ease-in-out infinite alternate;
	}
	.eu__pot {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.eu__water {
		fill: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-4));
	}
	.eu__handle {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.eu__hot {
		stroke: var(--ig-v);
		stroke-width: 3;
		animation: eu-pulse 1.4s ease-in-out infinite alternate;
	}
	.eu__bubbles circle {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1;
		animation: eu-rise 1.6s linear infinite;
	}
	.eu__bubbles circle:nth-child(2) {
		animation-delay: -0.6s;
	}
	.eu__bubbles circle:nth-child(3) {
		animation-delay: -1.1s;
	}
	@keyframes eu-rise {
		from {
			transform: translateY(0);
			opacity: 1;
		}
		to {
			transform: translateY(-20px);
			opacity: 0;
		}
	}
	.eu__steam {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		stroke-linecap: round;
		opacity: 0.7;
	}
	.eu__glass {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 70%, transparent);
	}
	:root[data-theme='light'] .eu__glass {
		fill: var(--sl-color-gray-2);
	}
	.eu__wire-dot {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		stroke-width: 2.4;
	}
	.eu__ground {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.eu__stick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.eu__grip {
		fill: var(--sl-color-gray-3);
	}
	.eu__coil {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 40%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.eu__coin {
		fill: var(--ig-v);
	}
	.eu__eddy {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
		animation: eu-pulse 0.7s ease-in-out infinite alternate;
	}
	.eu__nut {
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
	}
	.eu__string {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		transform-box: view-box;
		transform-origin: 100px 50px;
		animation: eu-string 0.16s ease-in-out infinite alternate;
	}
	@keyframes eu-string {
		from {
			transform: scaleY(1);
		}
		to {
			transform: scaleY(-1);
		}
	}
	.eu__turn {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		stroke-width: 1.8;
	}
	.eu__lead {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		stroke-width: 1.6;
	}
	.eu__tube {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
	}
	.eu__tube-in {
		fill: color-mix(in oklab, var(--ig-v) 20%, var(--ig-surface));
	}
	.eu__eddy-ring {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.4;
		stroke-dasharray: 3 2;
	}
	.eu__floor {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	/* both magnets start together: outside it falls in 0,5 s (free fall), in the tube it
	   sinks steadily, about 9 times slower */
	.eu__slow {
		animation: eu-slow 5s linear infinite;
	}
	.eu__fast {
		animation: eu-fast 5s infinite;
	}
	@keyframes eu-slow {
		0% {
			transform: translateY(0);
		}
		90% {
			transform: translateY(80px);
		}
		100% {
			transform: translateY(80px);
		}
	}
	@keyframes eu-fast {
		0% {
			transform: translateY(0);
			animation-timing-function: cubic-bezier(0.33, 0, 0.67, 0.33);
		}
		10% {
			transform: translateY(82px);
		}
		100% {
			transform: translateY(82px);
		}
	}
</style>
