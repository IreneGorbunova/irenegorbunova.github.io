---
/**
 * "Predict, then check" for Lenz's rule. A reference experiment fixes how the galvanometer is
 * connected (the north pole enters — the needle goes right); the reader predicts the needle in
 * six other cases, then watches the experiment. The needle is driven by the same physics as the
 * main model (physics.ts): I = −N·dΦ/dt / R.
 */
import { MAG_LEN, MAG_R, COIL_LEN, COIL_R } from './physics';

const S = 10; // px per cm
const CX = 300;
const CY = 72;
const ML = MAG_LEN * 100 * S;
const MR = MAG_R * 100 * S;
const CL = COIL_LEN * 100 * S;
const CA = COIL_R * 100 * S;
const turns = Array.from({ length: 16 }, (_, k) => CX - CL / 2 + (k + 0.5) * (CL / 16));
const GX = CX;
const GY = 214;
const GR = 52;
const tick = (deg: number, r: number) => [GX + r * Math.sin((deg * Math.PI) / 180), GY - r * Math.cos((deg * Math.PI) / 180)];
---

<div class="lq not-content" data-lq>
	<svg class="lq__scene" viewBox="0 0 600 240" role="img" aria-label="Магнит, катушка и гальванометр" data-scene>
		<g class="lq__back" data-coil>{turns.map((x) => <path d={`M${x} ${CY + CA} A5 ${CA} 0 0 1 ${x} ${CY - CA}`} />)}</g>
		<g class="lq__magnet" data-magnet>
			<rect class="lq__pole lq__pole--s" x={-ML / 2} y={-MR} width={ML / 2} height={2 * MR} rx="3" data-left></rect>
			<rect class="lq__pole lq__pole--n" x="0" y={-MR} width={ML / 2} height={2 * MR} rx="3" data-right></rect>
			<text class="lq__plabel" x={-ML / 4} y="5" text-anchor="middle" data-left-l>S</text>
			<text class="lq__plabel" x={ML / 4} y="5" text-anchor="middle" data-right-l>N</text>
		</g>
		<g data-coil>
			<g class="lq__front">{turns.map((x) => <path d={`M${x} ${CY - CA} A5 ${CA} 0 0 1 ${x} ${CY + CA}`} />)}</g>
			<path class="lq__wire" d={`M${CX - CL / 2 + 3} ${CY + CA} L${CX - CL / 2 + 3} 150`}></path>
			<path class="lq__wire" d={`M${CX + CL / 2 - 3} ${CY + CA} L${CX + CL / 2 - 3} 150`}></path>
			<rect class="lq__case" x={GX - 76} y="148" width="152" height="88" rx="14"></rect>
			{[-50, -25, 0, 25, 50].map((d) => {
				const [x1, y1] = tick(d, GR);
				const [x2, y2] = tick(d, d === 0 ? GR - 10 : GR - 6);
				return <line class={d === 0 ? 'lq__tick lq__tick--zero' : 'lq__tick'} x1={x1} y1={y1} x2={x2} y2={y2} />;
			})}
			<line class="lq__needle" x1={GX} y1={GY} x2={GX} y2={GY - GR + 4} data-needle></line>
			<circle class="lq__pivot" cx={GX} cy={GY} r="4"></circle>
		</g>
		<g class="lq__motion" data-motion>
			<line marker-end="" data-motion-line></line>
		</g>
	</svg>

	<div class="lq__panel">
		<p class="lq__q" data-q></p>
		<div class="lq__answers" data-answers>
			<button type="button" class="lq__btn" data-ans="L">← Влево</button>
			<button type="button" class="lq__btn" data-ans="0">Не отклонится</button>
			<button type="button" class="lq__btn" data-ans="R">Вправо →</button>
		</div>
		<p class="lq__fb" aria-live="polite" data-fb></p>
		<div class="lq__nav">
			<button type="button" class="lq__btn lq__btn--primary" data-start>Показать опыт</button>
			<button type="button" class="lq__btn" data-replay hidden>Повторить опыт</button>
			<button type="button" class="lq__btn lq__btn--primary" data-next hidden>Следующий случай</button>
		</div>
	</div>
</div>

<style is:global>
	.lq {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lq__scene {
		display: block;
		width: 100%;
		height: auto;
	}
	.lq__back path {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 45%, var(--ig-surface));
		stroke-width: 2.2;
	}
	.lq__front path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.8;
	}
	.lq__wire {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-3));
		stroke-width: 2.5;
	}
	.lq__case {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.lq__tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.lq__tick--zero {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
	}
	.lq__needle {
		stroke: var(--ig-vy);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.lq__pivot {
		fill: var(--sl-color-gray-2);
	}
	.lq__pole--n {
		fill: var(--ig-vx);
	}
	.lq__pole--s {
		fill: var(--ig-vy);
	}
	.lq__plabel {
		fill: var(--sl-color-black);
		font: 700 15px var(--__sl-font);
	}
	.lq__motion line {
		stroke: var(--sl-color-accent);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-dasharray: 2 7;
	}
	.lq__motion path {
		fill: var(--sl-color-accent);
	}
	.lq__panel {
		margin-top: 0.5rem;
	}
	.lq__q {
		margin: 0;
		color: var(--sl-color-text);
	}
	.lq__q strong {
		color: var(--sl-color-white);
	}
	.lq__answers,
	.lq__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.lq__answers[hidden],
	.lq__btn[hidden] {
		display: none;
	}
	.lq__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			background 0.2s,
			border-color 0.2s;
	}
	.lq__btn:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.lq__btn:disabled {
		cursor: default;
		opacity: 0.55;
	}
	.lq__btn.is-right {
		opacity: 1;
		border-color: var(--ig-vx);
		background: color-mix(in srgb, var(--ig-vx) 25%, transparent);
	}
	.lq__btn.is-wrong {
		opacity: 1;
		border-color: var(--ig-vy);
		background: color-mix(in srgb, var(--ig-vy) 22%, transparent);
	}
	.lq__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.lq__fb {
		min-height: 1.5em;
		margin: 0.75rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.lq__fb strong {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.lq {
			padding: 0.75rem;
		}
		.lq__plabel {
			font-size: 20px;
		}
	}
</style>

<script>
	import { dflux, R_CIRCUIT } from './physics';

	const S = 1000; // px per metre
	const CX = 300;
	const CY = 72;
	const N = 200;
	const I_FULL = 0.01; // A, full scale of this galvanometer
	const SPEED = 0.3; // m/s
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

	type Case = {
		text: string; // what happens
		s: 1 | -1; // 1: north pole looks to the right (towards the coil when the magnet is on the left)
		from: number; // magnet centre relative to the coil centre, m
		to: number;
		mover: 'magnet' | 'coil' | 'none';
		ans: 'L' | '0' | 'R';
		why: string;
	};
	const REF: Case = { text: 'Северный полюс магнита вносят в катушку.', s: 1, from: -0.22, to: 0, mover: 'magnet', ans: 'R', why: '' };
	const CASES: Case[] = [
		{
			text: 'Северный полюс вынимают из катушки.',
			s: 1, from: 0, to: -0.22, mover: 'magnet', ans: 'L',
			why: 'Магнит тот же, но поток через катушку теперь не растёт, а убывает. Ток идёт в обратную сторону.',
		},
		{
			text: 'Магнит перевернули: в катушку вносят южный полюс.',
			s: -1, from: -0.22, to: 0, mover: 'magnet', ans: 'L',
			why: 'Модуль потока растёт, как в опыте, но линии магнитной индукции внутри катушки теперь направлены в другую сторону. Поэтому и ток идёт в другую сторону.',
		},
		{
			text: 'Южный полюс вынимают из катушки.',
			s: -1, from: 0, to: -0.22, mover: 'magnet', ans: 'R',
			why: 'Здесь две перемены сразу: другой полюс, и модуль потока не растёт, а убывает. Они компенсируют друг друга — стрелка отклоняется так же, как в опыте.',
		},
		{
			text: 'Магнит лежит внутри катушки и не двигается.',
			s: 1, from: 0, to: 0, mover: 'none', ans: '0',
			why: 'Поток через катушку большой, но он не меняется. Нет изменения потока — нет и тока.',
		},
		{
			text: 'Магнит держат неподвижно, а катушку надевают на его северный полюс.',
			s: 1, from: -0.22, to: 0, mover: 'coil', ans: 'R',
			why: 'Важно только относительное движение: поток через катушку растёт точно так же, как при внесении магнита.',
		},
		{
			text: 'Магнит, лежавший в катушке, выталкивают через другой её конец — северным полюсом вперёд.',
			s: 1, from: 0, to: 0.22, mover: 'magnet', ans: 'L',
			why: 'Магнит выходит из катушки — поток убывает, хотя движется он в ту же сторону, что и в опыте. Направление тока зависит от того, растёт поток или убывает.',
		},
	];
	const WORD = { L: 'влево', '0': 'не отклонится', R: 'вправо' } as const;

	for (const root of document.querySelectorAll<HTMLElement>('[data-lq]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const magnet = q<SVGGElement>('[data-magnet]');
		const coilGs = Array.from(root.querySelectorAll<SVGGElement>('[data-coil]'));
		const moveCoil = (px: number) => coilGs.forEach((g) => g.setAttribute('transform', `translate(${px.toFixed(1)} 0)`));
		const needle = q<SVGLineElement>('[data-needle]');
		const left = q<SVGRectElement>('[data-left]');
		const right = q<SVGRectElement>('[data-right]');
		const leftL = q<SVGTextElement>('[data-left-l]');
		const rightL = q<SVGTextElement>('[data-right-l]');
		const motionLine = q<SVGLineElement>('[data-motion-line]');
		const qEl = q<HTMLElement>('[data-q]');
		const answers = q<HTMLElement>('[data-answers]');
		const fb = q<HTMLElement>('[data-fb]');
		const startBtn = q<HTMLButtonElement>('[data-start]');
		const replayBtn = q<HTMLButtonElement>('[data-replay]');
		const nextBtn = q<HTMLButtonElement>('[data-next]');
		const ansBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ans]'));

		let idx = -1; // −1: the reference experiment
		let score = 0;
		let raf = 0;

		// motion arrow head (scoped: no ids)
		const head = document.createElementNS('http://www.w3.org/2000/svg', 'path');
		q<SVGGElement>('[data-motion]').append(head);

		const place = (c: Case, xm: number, xc: number) => {
			// screen positions: the coil moves when c.mover === 'coil'
			moveCoil(xc * S);
			magnet.setAttribute('transform', `translate(${(CX + (xm + xc) * S).toFixed(1)} ${CY})`);
		};
		const paint = (c: Case) => {
			const nRight = c.s === 1;
			left.classList.toggle('lq__pole--s', nRight);
			left.classList.toggle('lq__pole--n', !nRight);
			right.classList.toggle('lq__pole--n', nRight);
			right.classList.toggle('lq__pole--s', !nRight);
			leftL.textContent = nRight ? 'S' : 'N';
			rightL.textContent = nRight ? 'N' : 'S';
		};
		const showMotion = (c: Case, on: boolean) => {
			if (!on || c.mover === 'none') {
				motionLine.style.opacity = '0';
				head.style.opacity = '0';
				return;
			}
			// an arrow above the thing that will move
			const dir = Math.sign(c.to - c.from) * (c.mover === 'coil' ? -1 : 1);
			const x0 = c.mover === 'coil' ? CX - c.from * S : CX + c.from * S;
			const y = CY - 44;
			const x1 = x0 + dir * 60;
			motionLine.setAttribute('x1', String(x0 - dir * 20));
			motionLine.setAttribute('y1', String(y));
			motionLine.setAttribute('x2', String(x1));
			motionLine.setAttribute('y2', String(y));
			head.setAttribute('d', `M${x1 + dir * 10} ${y} L${x1 - dir * 2} ${y - 7} L${x1 - dir * 2} ${y + 7} Z`);
			motionLine.style.opacity = '1';
			head.style.opacity = '1';
		};
		const setNeedle = (deg: number) => needle.setAttribute('transform', `rotate(${deg.toFixed(2)} ${CX} 214)`);

		const show = (c: Case) => {
			cancelAnimationFrame(raf);
			paint(c);
			place(c, c.from, 0);
			if (c.mover === 'coil') {
				// the magnet stays where it is on the screen; the coil starts to the right of it
				moveCoil(-c.from * S);
				magnet.setAttribute('transform', `translate(${CX} ${CY})`);
			}
			setNeedle(0);
			showMotion(c, true);
		};

		const run = (c: Case, done: () => void) => {
			cancelAnimationFrame(raf);
			show(c);
			showMotion(c, false);
			const dist = Math.abs(c.to - c.from);
			const T = c.mover === 'none' ? 1.6 : dist / SPEED + 0.25;
			let t = 0;
			let a = 0;
			let w = 0;
			let last = performance.now();
			const rel = (tt: number) => {
				// smooth start and stop: x = from + (to − from)·(1 − cos πu)/2
				const u = Math.min(1, tt / T);
				const k = (1 - Math.cos(Math.PI * u)) / 2;
				const dk = (Math.PI / (2 * T)) * Math.sin(Math.PI * u);
				return { x: c.from + (c.to - c.from) * k, v: u < 1 ? (c.to - c.from) * dk : 0 };
			};
			const frame = (now: number) => {
				const dt = Math.min(0.05, (now - last) / 1000);
				last = now;
				t += dt;
				const p = rel(t);
				if (c.mover === 'coil') {
					// the coil moves by −(x − from) on the screen, the magnet stays
					moveCoil(-p.x * S);
				} else place(c, p.x, 0);
				const I = (-N * c.s * dflux(p.x) * p.v) / R_CIRCUIT;
				const target = Math.max(-62, Math.min(62, (-I / I_FULL) * 55));
				const w0 = 14;
				const z = reduce.matches ? 1 : 0.5;
				w += (w0 * w0 * (target - a) - 2 * z * w0 * w) * dt;
				a += w * dt;
				setNeedle(a);
				if (t < T + 1.2) raf = requestAnimationFrame(frame);
				else {
					setNeedle(0);
					done();
				}
			};
			raf = requestAnimationFrame(frame);
		};

		const ask = () => {
			const c = CASES[idx];
			qEl.innerHTML = `Случай ${idx + 1} из ${CASES.length}. <strong>${c.text}</strong> Куда отклонится стрелка?`;
			answers.hidden = false;
			ansBtns.forEach((b) => {
				b.disabled = false;
				b.classList.remove('is-right', 'is-wrong');
			});
			fb.textContent = '';
			replayBtn.hidden = true;
			nextBtn.hidden = true;
			startBtn.hidden = true;
			show(c);
		};

		const intro = () => {
			idx = -1;
			score = 0;
			qEl.innerHTML = `<strong>Сначала опыт.</strong> ${REF.text} Посмотрите, куда отклонится стрелка, — по этому опыту вы предскажете остальные.`;
			answers.hidden = true;
			fb.textContent = '';
			startBtn.hidden = false;
			startBtn.textContent = 'Показать опыт';
			replayBtn.hidden = true;
			nextBtn.hidden = true;
			show(REF);
		};

		startBtn.addEventListener('click', () => {
			if (idx === -1) {
				startBtn.disabled = true;
				run(REF, () => {
					startBtn.disabled = false;
					startBtn.hidden = true;
					fb.innerHTML = '<strong>Стрелка отклонилась вправо.</strong> Запомните это и переходите к предсказаниям.';
					nextBtn.hidden = false;
					nextBtn.textContent = 'К первому случаю';
					replayBtn.hidden = false;
				});
			} else intro();
		});
		replayBtn.addEventListener('click', () => {
			const c = idx === -1 ? REF : CASES[idx];
			replayBtn.disabled = true;
			run(c, () => (replayBtn.disabled = false));
		});
		nextBtn.addEventListener('click', () => {
			idx += 1;
			if (idx < CASES.length) ask();
			else {
				qEl.innerHTML = `<strong>Готово: ${score} из ${CASES.length}.</strong> ${score === CASES.length ? 'Отлично — правило Ленца работает у вас в голове!' : 'Пересмотрите случаи, где ошиблись: смотрите, растёт поток или убывает и куда направлены линии магнита.'}`;
				answers.hidden = true;
				fb.textContent = '';
				nextBtn.hidden = true;
				replayBtn.hidden = true;
				startBtn.hidden = false;
				startBtn.textContent = 'Пройти ещё раз';
			}
		});
		for (const b of ansBtns) {
			b.addEventListener('click', () => {
				const c = CASES[idx];
				const ok = b.dataset.ans === c.ans;
				if (ok) score += 1;
				ansBtns.forEach((x) => {
					x.disabled = true;
					if (x.dataset.ans === c.ans) x.classList.add('is-right');
				});
				if (!ok) b.classList.add('is-wrong');
				fb.innerHTML = `${ok ? '<strong>Верно!</strong>' : `<strong>Не совсем: стрелка ${c.ans === '0' ? 'не отклонится' : `отклонится ${WORD[c.ans]}`}.</strong>`} Смотрите опыт.`;
				run(c, () => {
					fb.innerHTML = `${ok ? '<strong>Верно!</strong>' : `<strong>Правильный ответ: ${c.ans === '0' ? 'стрелка не отклонится' : WORD[c.ans]}.</strong>`} ${c.why}`;
					replayBtn.hidden = false;
					nextBtn.hidden = false;
					nextBtn.textContent = idx === CASES.length - 1 ? 'Итог' : 'Следующий случай';
				});
			});
		}
		intro();
	}
</script>
