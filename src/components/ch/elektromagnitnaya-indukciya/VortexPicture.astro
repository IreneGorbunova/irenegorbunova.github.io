---
/**
 * The vortex electric field, looping. Left: a round region where the magnetic field points towards us (⊙, blue);
 * its induction grows, stays, falls. Around it the closed lines of the vortex electric field (gold circles): their
 * dashes run clockwise while B grows, stop while B is constant, run anticlockwise while B falls (Lenz: the current
 * they drive makes a field against the change). A copper ring on one line: its free electrons (dots) move against
 * the field, the arrow I shows the direction of the current. Right: the graph of B(t) with the moment shown.
 * The dashes move by an amount proportional to B − B₀ (their speed ∝ |ΔB/Δt|). Plays only while visible.
 */
const C = { x: 104, y: 104 };
const RB = 34; // the region of the magnetic field
const LINES = [48, 76, 96];
const RING = 62;
const dots: [number, number][] = [];
for (let i = -3; i <= 3; i++) for (let j = -3; j <= 3; j++) if (Math.hypot(i * 11, j * 11) < RB - 4) dots.push([C.x + i * 11, C.y + j * 11]);
const circle = (r: number) => `M ${C.x + r} ${C.y} A ${r} ${r} 0 1 1 ${C.x - r} ${C.y} A ${r} ${r} 0 1 1 ${C.x + r} ${C.y}`;
const ELECTRONS = Array.from({ length: 10 }, (_, k) => (2 * Math.PI * k) / 10);
// graph
const G = { x0: 222, x1: 340, y0: 150, y1: 58 };
---

<figure class="vx not-content" data-vx>
	<svg class="vx__svg" viewBox="0 0 360 208" role="img" aria-label="Вихревое электрическое поле. В круглой области магнитное поле направлено к нам. Пока его индукция растёт, вокруг возникают замкнутые линии электрического поля, направленные по часовой стрелке; в медном кольце электроны движутся против часовой стрелки, а ток идёт по часовой. Когда индукция не меняется, поля и тока нет. Когда убывает — всё идёт в обратную сторону">
		<circle class="vx__region" cx={C.x} cy={C.y} r={RB}></circle>
		<g class="vx__lines" data-lines>
			{LINES.map((r) => <path d={circle(r)} pathLength="120" />)}
		</g>
		<circle class="vx__ring" cx={C.x} cy={C.y} r={RING}></circle>
		<g data-dots>
			{
				dots.map(([x, y]) => (
					<g transform={`translate(${x} ${y})`}>
						<circle class="vx__dot-ring" r="4" />
						<circle class="vx__dot" r="1.4" />
					</g>
				))
			}
		</g>
		<g data-electrons>{ELECTRONS.map(() => <circle class="vx__e" r="2.6" />)}</g>
		<g class="vx__iarrow" data-iarrow>
			<path d="M -7 -5 L 2 0 L -7 5" data-ihead></path>
			<text x="-2" y="-9" text-anchor="middle">I</text>
		</g>
		<text class="vx__lab vx__lab--b" x={C.x + 14} y={C.y - RB + 9}>B</text>
		<text class="vx__lab vx__lab--e" x={C.x + 72} y={C.y - 70}>E</text>
		<!-- graph of B(t) -->
		<line class="vx__axis" x1={G.x0} y1={G.y0} x2={G.x1} y2={G.y0}></line>
		<line class="vx__axis" x1={G.x0} y1={G.y0} x2={G.x0} y2={G.y1 - 12}></line>
		<text class="vx__lab vx__lab--b" x={G.x0 + 6} y={G.y1 - 6}>B</text>
		<text class="vx__lab" x={G.x1 - 2} y={G.y0 + 15} text-anchor="end">t</text>
		<path class="vx__curve" data-curve></path>
		<line class="vx__cursor" data-cursor></line>
		<circle class="vx__cdot" r="4" data-cdot></circle>
		<text class="vx__status" x={G.x0 + 59} y="180" text-anchor="middle" data-status></text>
		<text class="vx__status vx__status--sub" x={G.x0 + 59} y="197" text-anchor="middle" data-status2></text>
	</svg>
</figure>

<style>
	.vx {
		margin: 1.25rem 0 1.5rem;
		padding: 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vx__svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin: 0 auto;
	}
	.vx__svg text {
		font-family: var(--__sl-font);
	}
	.vx__region {
		fill: color-mix(in srgb, var(--ig-vx) 12%, transparent);
		stroke: color-mix(in srgb, var(--ig-vx) 50%, transparent);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.vx__dot-ring {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.3;
	}
	.vx__dot {
		fill: var(--ig-vx);
	}
	.vx__lines path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.8;
		stroke-dasharray: 4 4;
		stroke-linecap: round;
	}
	.vx__ring {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 50%, var(--ig-vy));
		stroke-width: 6;
		opacity: 0.55;
	}
	.vx__e {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.vx__iarrow path {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.vx__iarrow text {
		fill: var(--sl-color-white);
		font-size: 12px;
		font-style: italic;
		font-family: var(--ig-font-math);
	}
	.vx__lab {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
		font-style: italic;
		font-family: var(--ig-font-math) !important;
	}
	.vx__lab--b {
		fill: var(--ig-vx);
	}
	.vx__lab--e {
		fill: var(--ig-v);
	}
	.vx__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.vx__curve {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2.2;
	}
	.vx__cursor {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.vx__cdot {
		fill: var(--ig-vx);
	}
	.vx__status {
		fill: var(--sl-color-white);
		font-size: 12px;
		font-weight: 600;
	}
	.vx__status--sub {
		fill: var(--sl-color-gray-2);
		font-size: 11px;
		font-weight: 400;
	}
</style>

<script>
	import { loop, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);
	const C = { x: 104, y: 104 };
	const RING = 62;
	const G = { x0: 222, x1: 340, y0: 150, y1: 58 };
	const B0 = 0.2;
	/** Induction (0…1) at the moment x of the cycle: grows, stays, falls, stays. */
	const Bx = (x: number) => B0 + (1 - B0) * (smooth(0.06, 0.34, x) - smooth(0.56, 0.84, x));
	const dB = (x: number) => (Bx(Math.min(1, x + 0.002)) - Bx(Math.max(0, x - 0.002))) / 0.004;

	for (const root of document.querySelectorAll<HTMLElement>('[data-vx]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const lines = [...root.querySelectorAll<SVGPathElement>('[data-lines] path')];
		const dots = [...root.querySelectorAll<SVGGElement>('[data-dots] > g')];
		const es = [...root.querySelectorAll<SVGCircleElement>('[data-electrons] circle')];
		const iarrow = $<SVGGElement>('[data-iarrow]');
		const ihead = $<SVGPathElement>('[data-ihead]');
		const curve = $<SVGPathElement>('[data-curve]');
		const cursor = $<SVGLineElement>('[data-cursor]');
		const cdot = $<SVGCircleElement>('[data-cdot]');
		const status = $<SVGTextElement>('[data-status]');
		const status2 = $<SVGTextElement>('[data-status2]');
		const gx = (x: number) => G.x0 + 4 + x * (G.x1 - G.x0 - 8);
		const gy = (b: number) => G.y0 - b * (G.y0 - G.y1);
		curve.setAttribute('d', 'M ' + Array.from({ length: 101 }, (_, k) => `${f1(gx(k / 100))} ${f1(gy(Bx(k / 100)))}`).join(' L '));
		cursor.setAttribute('y1', f1(G.y0));
		cursor.setAttribute('y2', f1(G.y1 - 8));
		const RUN = 9;
		let t = 0;
		const draw = () => {
			const x = (t % RUN) / RUN;
			const b = Bx(x);
			const rate = dB(x); // > 0 while B grows
			const strength = clamp(Math.abs(rate) / 2.4);
			// the magnetic field: ⊙ marks grow with B
			dots.forEach((d) => (d.style.opacity = f2(0.25 + 0.75 * b)));
			// the vortex field: dashes advance clockwise by an amount ∝ B − B₀ (the screen's clockwise is +angle)
			lines.forEach((l) => {
				l.style.strokeDashoffset = f1(-60 * (b - B0));
				l.style.opacity = f2(0.15 + 0.85 * strength);
			});
			// the electrons in the ring move against the field: anticlockwise while B grows
			const shift = -2.2 * (b - B0);
			es.forEach((e, k) => {
				const a = (2 * Math.PI * k) / es.length + shift;
				e.setAttribute('cx', f1(C.x + RING * Math.cos(a)));
				e.setAttribute('cy', f1(C.y + RING * Math.sin(a)));
			});
			// the current: clockwise (along the field) while B grows; drawn at the top of the ring
			const s = rate >= 0 ? 1 : -1;
			iarrow.setAttribute('transform', `translate(${C.x} ${C.y - RING})`);
			ihead.setAttribute('transform', `scale(${s} 1)`);
			iarrow.style.opacity = f2(strength);
			const cx = gx(x);
			cursor.setAttribute('x1', f1(cx));
			cursor.setAttribute('x2', f1(cx));
			cdot.setAttribute('cx', f1(cx));
			cdot.setAttribute('cy', f1(gy(b)));
			if (strength < 0.08) {
				status.textContent = 'B не меняется';
				status2.textContent = 'вихревого поля нет';
			} else if (rate > 0) {
				status.textContent = 'B растёт';
				status2.textContent = 'линии E — по часовой';
			} else {
				status.textContent = 'B убывает';
				status2.textContent = 'линии E — против часовой';
			}
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
