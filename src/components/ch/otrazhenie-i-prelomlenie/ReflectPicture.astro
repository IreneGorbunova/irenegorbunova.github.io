---
/**
 * Pictures to the definitions of reflection.
 * panel="terms": a labelled scheme: a plane mirror, the incident ray from a laser pointer, the point of incidence O,
 *   the perpendicular to the mirror at O, the reflected ray, the angles α and β (α = β = 40°). Pulses run along the rays.
 * panel="law": two panels that play together. Left: the pointer swings from 15° to 70° and back; the reflected ray
 *   follows with β = α (live values). Right: a mirror lying flat, seen obliquely (orthographic projection, elevation
 *   22°); the plane that holds the perpendicular turns about it, and the incident and reflected rays (α = β = 45°)
 *   turn with it: they always lie in one plane with the perpendicular.
 */
import PicStyles from './PicStyles.astro';

interface Props {
	panel: 'terms' | 'law';
}
const { panel } = Astro.props;

const RAD = Math.PI / 180;
const f1 = (v: number) => v.toFixed(1);
const O = { x: 160, y: 180 };
const L = 140; // 5 pulse periods
const A0 = 40;
const S = { x: O.x - L * Math.sin(A0 * RAD), y: O.y - L * Math.cos(A0 * RAD) };
const R = { x: O.x + L * Math.sin(A0 * RAD), y: O.y - L * Math.cos(A0 * RAD) };
/** arc around O between angles measured from the upward perpendicular (positive to the right) */
const arc = (r: number, a: number, b: number) => {
	const p = (t: number) => `${f1(O.x + r * Math.sin(t * RAD))} ${f1(O.y - r * Math.cos(t * RAD))}`;
	return `M ${p(a)} A ${r} ${r} 0 0 ${b > a ? 1 : 0} ${p(b)}`;
};
const at = (r: number, t: number) => ({ x: O.x + r * Math.sin(t * RAD), y: O.y - r * Math.cos(t * RAD) });
const hatch = Array.from({ length: 23 }, (_, k) => 26 + 12 * k);
const inAng = (Math.atan2(O.y - S.y, O.x - S.x) * 180) / Math.PI;
const midIn = { x: (S.x + O.x) / 2 + 14 * Math.cos((inAng + 90) * RAD), y: (S.y + O.y) / 2 + 14 * Math.sin((inAng + 90) * RAD) };
const midOut = { x: (R.x + O.x) / 2 + 14 * Math.cos((90 - inAng) * RAD), y: (R.y + O.y) / 2 + 14 * Math.sin((90 - inAng) * RAD) };
const ray = (p: { x: number; y: number }, q: { x: number; y: number }) => `M ${f1(p.x)} ${f1(p.y)} L ${f1(q.x)} ${f1(q.y)}`;
---

<PicStyles />
{
	panel === 'terms' && (
		<figure class="op-pic op-pic--one not-content">
			<div class="op-pic__grid">
				<svg class="op-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Луч указки падает на плоское зеркало в точку падения O. Из точки O проведён перпендикуляр к зеркалу. Угол падения альфа — между падающим лучом и перпендикуляром, угол отражения бета — между отражённым лучом и перпендикуляром. Они равны">
					<line class="op-face" x1="20" y1={O.y} x2="300" y2={O.y} />
					{hatch.map((x) => <line class="op-back" x1={x} y1={O.y + 3} x2={x - 9} y2={O.y + 12} />)}
					<line class="op-normal" x1={O.x} y1={O.y} x2={O.x} y2="38" />
					<path class="op-arc op-arc--a" d={arc(46, -A0, 0)} />
					<path class="op-arc op-arc--b" d={arc(52, 0, A0)} />
					<g class="op-ray">
						<path class="op-ray__glow" d={`${ray(S, O)} ${ray(O, R)}`} />
						<path class="op-ray__core" d={`${ray(S, O)} ${ray(O, R)}`} />
						<path class="op-ray__flow" d={`M ${f1(S.x)} ${f1(S.y)} L ${O.x} ${O.y} L ${f1(R.x)} ${f1(R.y)}`} />
					</g>
					<g transform={`translate(${f1(S.x)} ${f1(S.y)}) rotate(${f1(inAng)})`}>
						<rect class="op-laser" x="-46" y="-6" width="44" height="12" rx="4" />
					</g>
					<circle class="op-dot" cx={O.x} cy={O.y} r="3.5" />
					<text class="op-math op-ta" x={f1(at(66, -A0 / 2).x)} y={f1(at(66, -A0 / 2).y + 6)} text-anchor="middle">α</text>
					<text class="op-math op-tb" x={f1(at(70, A0 / 2).x)} y={f1(at(70, A0 / 2).y + 6)} text-anchor="middle">β</text>
					<text x={O.x} y="30" text-anchor="middle">перпендикуляр</text>
					<text class="op-tr" x={f1(midIn.x)} y={f1(midIn.y)} text-anchor="middle" transform={`rotate(${f1(inAng)} ${f1(midIn.x)} ${f1(midIn.y)})`}>падающий луч</text>
					<text class="op-tr" x={f1(midOut.x)} y={f1(midOut.y)} text-anchor="middle" transform={`rotate(${f1(-inAng)} ${f1(midOut.x)} ${f1(midOut.y)})`}>отражённый луч</text>
					<text class="op-math" x={O.x - 22} y={O.y - 6}>O</text>
					<text x={O.x} y="214" text-anchor="middle">точка падения</text>
					<text x="24" y="214">зеркало</text>
				</svg>
			</div>
			<div class="op-pic__foot">
				<figcaption>Углы падения <i>α</i> и отражения <i>β</i> отсчитывают от перпендикуляра к зеркалу, проведённого в точке падения <i>O</i>, а не от самого зеркала.</figcaption>
			</div>
		</figure>
	)
}
{
	panel === 'law' && (
		<figure class="op-pic not-content" data-op-law>
			<div class="op-pic__grid">
				<svg class="op-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Указку поворачивают, угол падения меняется от 15 до 70 градусов. Отражённый луч поворачивается так, что угол отражения всё время равен углу падения">
					<text class="op-title" x="160" y="22" text-anchor="middle">Углы равны</text>
					<line class="op-face" x1="20" y1={O.y} x2="300" y2={O.y} />
					{hatch.map((x) => <line class="op-back" x1={x} y1={O.y + 3} x2={x - 9} y2={O.y + 12} />)}
					<line class="op-normal" x1={O.x} y1={O.y} x2={O.x} y2="44" />
					<path class="op-arc op-arc--a" d="" data-arc-a />
					<path class="op-arc op-arc--b" d="" data-arc-b />
					<g class="op-ray">
						<path class="op-ray__glow" d="" data-ray />
						<path class="op-ray__core" d="" data-ray />
						<path class="op-ray__flow" d="" data-ray />
					</g>
					<g data-laser>
						<rect class="op-laser" x="-46" y="-6" width="44" height="12" rx="4" />
					</g>
					<circle class="op-dot" cx={O.x} cy={O.y} r="3.5" />
					<text class="op-math op-ta" text-anchor="middle" data-la>α</text>
					<text class="op-math op-tb" text-anchor="middle" data-lb>β</text>
					<text class="op-ta" x="22" y="214" data-va />
					<text class="op-tb" x="298" y="214" text-anchor="end" data-vb />
				</svg>
				<svg class="op-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Зеркало лежит на столе. Плоскость, в которой лежит перпендикуляр к зеркалу, поворачивается вокруг него, и вместе с ней поворачиваются падающий и отражённый лучи: они всегда лежат в этой плоскости">
					<text class="op-title" x="160" y="22" text-anchor="middle">Одна плоскость</text>
					<path class="op-mirror3d" d="" data-mirror3d />
					<path class="op-plane" d="" data-plane />
					<path class="op-normal" d="" data-normal3d />
					<path class="op-arc op-arc--a" d="" data-arc3a />
					<path class="op-arc op-arc--b" d="" data-arc3b />
					<g class="op-ray">
						<path class="op-ray__glow" d="" data-ray3 />
						<path class="op-ray__core" d="" data-ray3 />
						<path class="op-ray__flow" d="" data-ray3 />
					</g>
					<circle class="op-dot" r="3.5" data-o3 />
					<text class="op-math op-ta" text-anchor="middle" data-l3a>α</text>
					<text class="op-math op-tb" text-anchor="middle" data-l3b>β</text>
					<text x="314" y="224" text-anchor="end">зеркало лежит на столе</text>
				</svg>
			</div>
			<div class="op-pic__foot">
				<figcaption>Как ни поворачивай указку, угол отражения <i>β</i> равен углу падения <i>α</i>. Падающий луч, отражённый луч и перпендикуляр к зеркалу всегда лежат в одной плоскости.</figcaption>
				<button type="button" class="op-pic__again" data-again>Повторить</button>
			</div>
		</figure>
	)
}

<style is:global>
	.op-laser {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.op-mirror3d {
		fill: color-mix(in srgb, var(--op-silver) 30%, transparent);
		stroke: var(--op-silver);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.op-plane {
		fill: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
		stroke: var(--sl-color-accent);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
		stroke-linejoin: round;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const RAD = Math.PI / 180;
	const f1 = (v: number) => v.toFixed(1);
	type P = { x: number; y: number };
	const seg = (ps: P[]) => ps.map((p, k) => `${k ? 'L' : 'M'} ${f1(p.x)} ${f1(p.y)}`).join(' ');

	for (const root of document.querySelectorAll<HTMLElement>('[data-op-law]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const $$ = <T extends Element>(s: string) => [...root.querySelectorAll<T>(s)];
		// left panel
		const O = { x: 160, y: 180 };
		const L = 140;
		const rays = $$<SVGPathElement>('[data-ray]');
		const arcA = $<SVGPathElement>('[data-arc-a]');
		const arcB = $<SVGPathElement>('[data-arc-b]');
		const laser = $<SVGGElement>('[data-laser]');
		const la = $<SVGTextElement>('[data-la]');
		const lb = $<SVGTextElement>('[data-lb]');
		const va = $<SVGTextElement>('[data-va]');
		const vb = $<SVGTextElement>('[data-vb]');
		const at = (r: number, t: number) => ({ x: O.x + r * Math.sin(t * RAD), y: O.y - r * Math.cos(t * RAD) });
		const arc = (r: number, a: number, b: number) => {
			const p = at(r, a);
			const q = at(r, b);
			return `M ${f1(p.x)} ${f1(p.y)} A ${r} ${r} 0 0 ${b > a ? 1 : 0} ${f1(q.x)} ${f1(q.y)}`;
		};
		// right panel: orthographic view, x right, y up, z away; azimuth 25°, elevation 22°, 62 px per unit
		const C = { x: 160, y: 156 };
		const K = 62;
		const PSI = 25 * RAD;
		const EL = 22 * RAD;
		const pr = (x: number, y: number, z: number): P => {
			const xr = x * Math.cos(PSI) + z * Math.sin(PSI);
			const dr = -x * Math.sin(PSI) + z * Math.cos(PSI);
			return { x: C.x + K * xr, y: C.y - K * (y * Math.cos(EL) + dr * Math.sin(EL)) };
		};
		const mirror3d = $<SVGPathElement>('[data-mirror3d]');
		const plane = $<SVGPathElement>('[data-plane]');
		const normal3d = $<SVGPathElement>('[data-normal3d]');
		const rays3 = $$<SVGPathElement>('[data-ray3]');
		const arc3a = $<SVGPathElement>('[data-arc3a]');
		const arc3b = $<SVGPathElement>('[data-arc3b]');
		const l3a = $<SVGTextElement>('[data-l3a]');
		const l3b = $<SVGTextElement>('[data-l3b]');
		const o3 = $<SVGCircleElement>('[data-o3]');
		const H = 1.55;
		mirror3d.setAttribute('d', `${seg([pr(-H, 0, -H), pr(H, 0, -H), pr(H, 0, H), pr(-H, 0, H)])} Z`);
		normal3d.setAttribute('d', seg([pr(0, 0, 0), pr(0, 1.95, 0)]));
		const o = pr(0, 0, 0);
		o3.setAttribute('cx', f1(o.x));
		o3.setAttribute('cy', f1(o.y));
		const A3 = 45 * RAD;
		const L3 = 1.65;

		scene(root, 9, (x) => {
			// left: α from 15° to 70° and back
			const a = 42.5 - 27.5 * Math.cos(2 * Math.PI * x);
			const s = at(L, -a);
			const r = at(L, a);
			const d = `M ${f1(s.x)} ${f1(s.y)} L ${O.x} ${O.y} L ${f1(r.x)} ${f1(r.y)}`;
			rays.forEach((p) => p.setAttribute('d', d));
			arcA.setAttribute('d', arc(44, -a, 0));
			arcB.setAttribute('d', arc(50, 0, a));
			const pa = at(64, -a / 2);
			const pb = at(68, a / 2);
			la.setAttribute('x', f1(pa.x));
			la.setAttribute('y', f1(pa.y + 6));
			lb.setAttribute('x', f1(pb.x));
			lb.setAttribute('y', f1(pb.y + 6));
			laser.setAttribute('transform', `translate(${f1(s.x)} ${f1(s.y)}) rotate(${f1(90 - a)})`);
			const deg = `${Math.round(a)}°`;
			va.textContent = `α = ${deg}`;
			vb.textContent = `β = ${deg}`;
			// right: the plane turns about the perpendicular from −50° to 50° and back
			const th = -50 * Math.cos(2 * Math.PI * x) * RAD;
			const h = { x: Math.cos(th), z: Math.sin(th) };
			const P3 = (u: number, y: number) => pr(u * h.x, y, u * h.z); // a point of the plane: u along it, y up
			plane.setAttribute('d', `${seg([P3(-1.45, 0), P3(1.45, 0), P3(1.45, 1.95), P3(-1.45, 1.95)])} Z`);
			const s3 = P3(-L3 * Math.sin(A3), L3 * Math.cos(A3));
			const r3 = P3(L3 * Math.sin(A3), L3 * Math.cos(A3));
			const d3 = `M ${f1(s3.x)} ${f1(s3.y)} L ${f1(o.x)} ${f1(o.y)} L ${f1(r3.x)} ${f1(r3.y)}`;
			rays3.forEach((p) => p.setAttribute('d', d3));
			const arc3 = (from: number, to: number, rr: number) =>
				seg(Array.from({ length: 13 }, (_, k) => {
					const t = from + ((to - from) * k) / 12;
					return P3(rr * Math.sin(t), rr * Math.cos(t));
				}));
			arc3a.setAttribute('d', arc3(-A3, 0, 0.5));
			arc3b.setAttribute('d', arc3(0, A3, 0.56));
			const qa = P3(0.74 * Math.sin(-A3 / 2), 0.74 * Math.cos(A3 / 2));
			const qb = P3(0.78 * Math.sin(A3 / 2), 0.78 * Math.cos(A3 / 2));
			l3a.setAttribute('x', f1(qa.x));
			l3a.setAttribute('y', f1(qa.y + 6));
			l3b.setAttribute('x', f1(qb.x));
			l3b.setAttribute('y', f1(qb.y + 6));
		});
	}
</script>
