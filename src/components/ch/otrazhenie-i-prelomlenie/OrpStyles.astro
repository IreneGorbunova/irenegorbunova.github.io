---
/** Styles shared by the widgets of the chapters «Отражение света. Плоское зеркало» and «Преломление света». Renders nothing. */
---

<style is:global>
	.orp {
		--orp-beam: var(--ig-vy);
		--orp-a: var(--ig-v);
		--orp-b: var(--ig-vx);
		--orp-g: var(--sl-color-accent-high);
		--orp-ink: var(--sl-color-white);
		--orp-muted: var(--sl-color-gray-3);
		--orp-water: color-mix(in srgb, var(--ig-vx) 20%, transparent);
		--orp-water-edge: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-white));
		--orp-glass: color-mix(in srgb, var(--sl-color-gray-2) 16%, transparent);
		--orp-diamond: color-mix(in srgb, var(--sl-color-white) 24%, transparent);
		--orp-silver: color-mix(in srgb, var(--sl-color-gray-2) 80%, var(--ig-vx));
		position: relative;
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
	}
	:root[data-theme='light'] .orp {
		--orp-g: hsl(150, 70%, 30%);
	}
	:root:not([data-theme='light']) .orp {
		--orp-g: hsl(150, 60%, 62%);
	}
	.orp i {
		font-family: var(--ig-font-math);
	}
	.orp__svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: hidden;
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-y;
	}
	.orp__svg text {
		font-family: var(--__sl-font);
	}
	.orp-t {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
		paint-order: stroke fill;
		stroke: var(--ig-surface);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.orp-t--small {
		font-size: 13px;
		fill: var(--orp-muted);
	}
	.orp-t--math {
		font-family: var(--ig-font-math) !important;
		font-style: italic;
		font-size: 19px;
		fill: var(--sl-color-gray-1);
	}
	.orp-t--a {
		fill: var(--orp-a);
		font-weight: 700;
	}
	.orp-t--b {
		fill: var(--orp-b);
		font-weight: 700;
	}
	.orp-t--g {
		fill: var(--orp-g);
		font-weight: 700;
	}
	.orp.is-narrow .orp-t {
		font-size: 20px;
		stroke-width: 5px;
	}
	.orp.is-narrow .orp-t--small {
		font-size: 17px;
	}
	.orp.is-narrow .orp-t--math {
		font-size: 24px;
	}

	/* a centimetre grid (MirrorLab, WaterLab, RescueLab) */
	.orp-mirror__grid line {
		stroke: color-mix(in srgb, var(--sl-color-gray-5) 70%, transparent);
		stroke-width: 1;
	}

	/* the perpendicular to the surface */
	.orp-normal {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-dasharray: 7 6;
	}
	/* angle arcs */
	.orp-arc {
		fill: none;
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.orp-arc--a {
		stroke: var(--orp-a);
	}
	.orp-arc--b {
		stroke: var(--orp-b);
	}
	.orp-arc--g {
		stroke: var(--orp-g);
	}
	.orp-sector {
		stroke: none;
	}
	.orp-sector--a {
		fill: color-mix(in srgb, var(--orp-a) 16%, transparent);
	}
	.orp-sector--b {
		fill: color-mix(in srgb, var(--orp-b) 16%, transparent);
	}
	.orp-sector--g {
		fill: color-mix(in srgb, var(--orp-g) 16%, transparent);
	}

	/* a light beam: a glow, a core line and running pulses */
	.orp-beam {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.orp-beam__glow {
		stroke: var(--orp-beam);
		stroke-width: 9;
		opacity: 0.18;
	}
	:root[data-theme='light'] .orp-beam__glow {
		opacity: 0.12;
	}
	.orp-beam__core {
		stroke: var(--orp-beam);
		stroke-width: 2.6;
	}
	.orp-beam__flow {
		stroke: color-mix(in srgb, var(--orp-beam) 30%, white);
		stroke-width: 3.6;
		stroke-dasharray: 2 26;
		animation: orp-flow 1s linear infinite;
	}
	:root[data-theme='light'] .orp-beam__flow {
		stroke: color-mix(in srgb, var(--orp-beam) 45%, white);
	}
	.orp-beam__virt {
		stroke: var(--orp-beam);
		stroke-width: 1.6;
		stroke-dasharray: 7 6;
		opacity: 0.85;
	}
	@keyframes orp-flow {
		to {
			stroke-dashoffset: -28;
		}
	}

	/* a plane mirror: a bright face and a hatched back */
	.orp-mirror__face {
		stroke: var(--orp-silver);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.orp-mirror__back {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	/* the laser pointer */
	.orp-laser rect {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.orp-laser .orp-laser__tip {
		fill: var(--orp-beam);
		stroke: none;
		filter: drop-shadow(0 0 4px var(--orp-beam));
	}
	.orp-laser .orp-laser__btn {
		fill: var(--orp-beam);
		stroke: none;
		opacity: 0.8;
	}
	.orp-grab {
		cursor: grab;
		touch-action: none;
		outline: none;
	}
	.orp-grab:active {
		cursor: grabbing;
	}
	.orp-grab__hit {
		fill: transparent;
		stroke: none;
	}
	.orp-grab:focus-visible .orp-grab__ring {
		stroke: var(--sl-color-accent);
		stroke-width: 2.5;
		opacity: 1;
	}
	.orp-grab__ring {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 1.5;
		stroke-dasharray: 3 4;
		opacity: 0.7;
	}
	.orp-hint {
		animation: orp-hint 1.6s ease-in-out infinite;
		transform-box: fill-box;
		transform-origin: center;
	}
	@keyframes orp-hint {
		50% {
			transform: scale(1.18);
			opacity: 0.35;
		}
	}

	/* Controls */
	.orp-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: 0.75rem 1.5rem;
		margin-top: 0.75rem;
	}
	.orp-controls > .orp-slider {
		flex: 1 1 14rem;
	}
	.orp-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	.orp-seg {
		display: inline-flex;
		flex-wrap: wrap;
		padding: 3px;
		border-radius: 1.2rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.orp-seg button {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.4rem 0.95rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background 0.25s,
			color 0.25s;
	}
	.orp-seg button[aria-pressed='true'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.orp-slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.orp-slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.orp-slider input {
		grid-column: 1 / -1;
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.orp-btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s,
			transform 0.15s;
	}
	.orp-btn:hover {
		border-color: var(--sl-color-accent);
	}
	.orp-btn:active {
		transform: scale(0.97);
	}
	.orp-btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.orp-btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.orp-btn:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.orp-check {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.orp-check input {
		accent-color: var(--sl-color-accent);
		width: 1.05rem;
		height: 1.05rem;
		margin: 0;
	}
	.orp :is(button, input, [tabindex]):focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.orp svg [tabindex]:focus-visible {
		outline: none;
	}
	.orp-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
		gap: 0.5rem;
		margin: 0.9rem 0 0;
	}
	.orp-stats > div {
		padding: 0.45rem 0.7rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		min-width: 0;
	}
	.orp-stats dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.orp-stats dd {
		margin: 0;
		font-size: var(--sl-text-lg);
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.orp-stats .is-a dd {
		color: var(--orp-a);
	}
	.orp-stats .is-b dd {
		color: var(--orp-b);
	}
	.orp-stats .is-g dd {
		color: var(--orp-g);
	}
	.orp-formula {
		min-height: 3.4rem;
		margin-top: 0.75rem;
		padding: 0.15rem 0.9rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.orp-formula .katex-display {
		margin: 0.45rem 0;
	}
	.orp-live {
		min-height: 3em;
		margin: 0.7rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.orp-live b {
		color: var(--sl-color-white);
	}
	.orp-legend {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.orp-key {
		display: inline-block;
		width: 1.2rem;
		height: 3px;
		margin: 0 0.3rem 0.2rem 0;
		vertical-align: middle;
		border-radius: 2px;
		background: var(--c);
	}
	.orp-key--dash {
		height: 0;
		border-top: 2px dashed var(--c);
		background: none;
	}
	.orp-nw {
		white-space: nowrap;
	}
	@media (max-width: 40rem) {
		.orp {
			padding: 0.75rem;
		}
		.orp-stats dd {
			font-size: var(--sl-text-base);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.orp-beam__flow,
		.orp-hint {
			animation: none;
		}
		.orp-beam__flow {
			display: none;
		}
		.orp-btn,
		.orp-seg button {
			transition: none;
		}
	}
</style>
