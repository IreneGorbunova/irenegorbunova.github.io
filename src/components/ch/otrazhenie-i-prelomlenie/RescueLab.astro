---
/**
 * Fermat's principle with a lifeguard. The lifeguard runs on sand (speed υ1) and swims in the sea
 * (speed υ2) to a swimmer. The point where he enters the water is dragged along the shore; the total
 * time is shown live and as a graph drawn under the beach on the same horizontal scale. At the fastest
 * point sin α / sin γ = υ1 / υ2 — the law of refraction. A race compares the straight path with the
 * chosen one in real proportion (sped up 4 times).
 */
import OrpStyles from './OrpStyles.astro';
---

<OrpStyles />
<figure class="orp orp-res not-content" data-orp-rescue>
	<svg class="orp__svg" data-main role="group" aria-label="Спасатель бежит по песку и плывёт к пловцу">
		<rect class="orp-res__sand" data-sand></rect>
		<rect class="orp-res__sea" data-sea></rect>
		<line class="orp-res__shore" data-shore></line>
		<text class="orp-t orp-t--small" data-sand-l>песок</text>
		<text class="orp-t orp-t--small" data-sea-l>море</text>
		<line class="orp-normal" data-normal></line>
		<path class="orp-res__straight" data-straight></path>
		<path class="orp-sector orp-sector--a" data-sec-a></path>
		<path class="orp-sector orp-sector--g" data-sec-g></path>
		<path class="orp-arc orp-arc--a" data-arc-a></path>
		<path class="orp-arc orp-arc--g" data-arc-g></path>
		<path class="orp-res__best" data-best></path>
		<path class="orp-res__path" data-path></path>
		<text class="orp-t orp-t--a" text-anchor="middle" dominant-baseline="central" data-lab-a>α</text>
		<text class="orp-t orp-t--g" text-anchor="middle" dominant-baseline="central" data-lab-g>γ</text>
		<circle class="orp-res__runner is-2" r="7" data-run2></circle>
		<circle class="orp-res__runner" r="7" data-run1></circle>
		<g class="orp-grab" data-a tabindex="0" role="group" aria-label="Спасатель. Тяните или нажимайте стрелки">
			<circle class="orp-grab__hit" r="22"></circle>
			<circle class="orp-res__pin is-a" r="8"></circle>
			<text class="orp-t" x="0" y="-16" text-anchor="middle">спасатель</text>
		</g>
		<g class="orp-grab" data-b tabindex="0" role="group" aria-label="Пловец. Тяните или нажимайте стрелки">
			<circle class="orp-grab__hit" r="22"></circle>
			<circle class="orp-res__pin is-b" r="8"></circle>
			<text class="orp-t" x="0" y="26" text-anchor="middle">пловец</text>
		</g>
		<g class="orp-grab" data-x tabindex="0" role="slider" aria-label="Где спасатель входит в воду. Тяните вдоль берега или нажимайте стрелки">
			<circle class="orp-grab__hit" r="24"></circle>
			<circle class="orp-grab__ring orp-hint" r="17" data-hint></circle>
			<circle class="orp-res__xdot" r="7"></circle>
		</g>
	</svg>
	<svg class="orp__svg orp-res__graph" data-graph role="img" aria-label="График: время в пути в зависимости от точки входа в воду">
		<path class="orp-res__axis" data-axes></path>
		<path class="orp-res__curve" data-curve></path>
		<line class="orp-res__minline" data-minline></line>
		<circle class="orp-res__gdot" r="6" data-gdot></circle>
		<text class="orp-t orp-t--small" data-glabel>время в пути, с</text>
		<text class="orp-t orp-t--small" text-anchor="middle" data-gmin>быстрее всего</text>
	</svg>
	<div class="orp-controls">
		<label class="orp-slider">
			<span>Скорость бега <i>υ</i><sub>1</sub></span>
			<output data-v1-out></output>
			<input type="range" min="3" max="8" step="0.5" value="5" data-v1 />
		</label>
		<label class="orp-slider">
			<span>Скорость плавания <i>υ</i><sub>2</sub></span>
			<output data-v2-out></output>
			<input type="range" min="1" max="3" step="0.5" value="2" data-v2 />
		</label>
	</div>
	<div class="orp-controls">
		<button type="button" class="orp-btn orp-btn--primary" data-find>Найти самый быстрый путь</button>
		<button type="button" class="orp-btn" data-race>Забег: по прямой против вашего пути</button>
	</div>
	<div class="orp-formula" data-formula aria-live="polite"></div>
	<p class="orp-live" data-live></p>
	<figcaption class="orp-legend">
		Клетка — <span class="orp-nw">5 м</span>. Тяните точку, где спасатель входит в воду (её можно и спасателя с пловцом). График под пляжем нарисован в том же масштабе по горизонтали: он показывает время в пути для каждой точки входа. <span class="orp-key orp-key--dash" style="--c: var(--sl-color-gray-3)"></span>прямой путь.
	</figcaption>
</figure>

<style is:global>
	.orp-res.is-narrow .orp-t {
		font-size: 28px;
		stroke-width: 6px;
	}
	.orp-res__sand {
		fill: color-mix(in srgb, var(--ig-v) 14%, transparent);
	}
	.orp-res__sea {
		fill: var(--orp-water);
	}
	.orp-res__shore {
		stroke: var(--orp-water-edge);
		stroke-width: 2;
	}
	.orp-res__path {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 3.2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.orp-res__best {
		fill: none;
		stroke: var(--orp-g);
		stroke-width: 2;
		stroke-dasharray: 2 6;
		stroke-linecap: round;
	}
	.orp-res__straight {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		stroke-dasharray: 7 6;
	}
	.orp-res__pin.is-a {
		fill: var(--ig-vy);
	}
	.orp-res__pin.is-b {
		fill: var(--ig-v);
	}
	.orp-res__xdot {
		fill: var(--sl-color-accent);
		stroke: var(--ig-surface);
		stroke-width: 2;
	}
	.orp-res__runner {
		fill: var(--sl-color-accent);
		stroke: var(--ig-surface);
		stroke-width: 2;
		display: none;
	}
	.orp-res__runner.is-2 {
		fill: var(--sl-color-gray-2);
	}
	.orp-res__graph {
		margin-top: 0.25rem;
		border-top: 1px dashed var(--sl-color-gray-5);
	}
	.orp-res__axis {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.orp-res__curve {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2.4;
	}
	.orp-res__minline {
		stroke: var(--orp-g);
		stroke-width: 1.4;
		stroke-dasharray: 3 4;
	}
	.orp-res__gdot {
		fill: var(--sl-color-accent);
		stroke: var(--ig-surface);
		stroke-width: 2;
	}
</style>

<script>
	import katex from 'katex';
	import { clamp, pt, add, sub, mul, ang, arcD, arcMid, lineD, setA, draggable, fmt, tex, reduceMotion, type P } from './orp';

	// world: metres, y up, the shore line is y = 0, sand above, sea below
	const XMIN = -5;
	const XMAX = 45;
	const YMIN = -17;
	const YMAX = 19;
	const S = 14;
	const W = (XMAX - XMIN) * S;
	const H = (YMAX - YMIN) * S;
	const GH = 172; // graph height
	const sx = (p: P) => pt((p.x - XMIN) * S, (YMAX - p.y) * S);
	const wx = (p: P) => pt(p.x / S + XMIN, YMAX - p.y / S);

	for (const root of document.querySelectorAll<HTMLElement>('[data-orp-rescue]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-main]');
		const gsvg = q<SVGSVGElement>('[data-graph]');
		svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
		gsvg.setAttribute('viewBox', `0 0 ${W} ${GH}`);
		const shoreY = sx(pt(0, 0)).y;
		setA(q('[data-sand]'), { x: 0, y: 0, width: W, height: shoreY });
		setA(q('[data-sea]'), { x: 0, y: shoreY, width: W, height: H - shoreY });
		setA(q('[data-shore]'), { x1: 0, y1: shoreY, x2: W, y2: shoreY });
		setA(q('[data-sand-l]'), { x: 8, y: shoreY - 10 });
		setA(q('[data-sea-l]'), { x: 8, y: shoreY + 22 });
		// a grid of 5 m
		{
			const NS = 'http://www.w3.org/2000/svg';
			const g = document.createElementNS(NS, 'g');
			g.setAttribute('class', 'orp-mirror__grid');
			for (let x = XMIN; x <= XMAX; x += 5) {
				const l = document.createElementNS(NS, 'line');
				setA(l, { x1: sx(pt(x, 0)).x, y1: 0, x2: sx(pt(x, 0)).x, y2: H });
				g.append(l);
			}
			for (let y = -15; y <= YMAX; y += 5) {
				const l = document.createElementNS(NS, 'line');
				setA(l, { x1: 0, y1: sx(pt(0, y)).y, x2: W, y2: sx(pt(0, y)).y });
				g.append(l);
			}
			svg.querySelector('[data-sea]')!.after(g);
		}

		const normal = q<SVGLineElement>('[data-normal]');
		const straight = q<SVGPathElement>('[data-straight]');
		const best = q<SVGPathElement>('[data-best]');
		const path = q<SVGPathElement>('[data-path]');
		const secA = q<SVGPathElement>('[data-sec-a]');
		const secG = q<SVGPathElement>('[data-sec-g]');
		const arcA = q<SVGPathElement>('[data-arc-a]');
		const arcG = q<SVGPathElement>('[data-arc-g]');
		const labA = q<SVGTextElement>('[data-lab-a]');
		const labG = q<SVGTextElement>('[data-lab-g]');
		const run1 = q<SVGCircleElement>('[data-run1]');
		const run2 = q<SVGCircleElement>('[data-run2]');
		const gA = q<SVGGElement>('[data-a]');
		const gB = q<SVGGElement>('[data-b]');
		const gX = q<SVGGElement>('[data-x]');
		const hint = q<SVGCircleElement>('[data-hint]');
		const axes = q<SVGPathElement>('[data-axes]');
		const curve = q<SVGPathElement>('[data-curve]');
		const minline = q<SVGLineElement>('[data-minline]');
		const gdot = q<SVGCircleElement>('[data-gdot]');
		const glabel = q<SVGTextElement>('[data-glabel]');
		const gmin = q<SVGTextElement>('[data-gmin]');
		const v1In = q<HTMLInputElement>('[data-v1]');
		const v2In = q<HTMLInputElement>('[data-v2]');
		const v1Out = q<HTMLOutputElement>('[data-v1-out]');
		const v2Out = q<HTMLOutputElement>('[data-v2-out]');
		const findBtn = q<HTMLButtonElement>('[data-find]');
		const raceBtn = q<HTMLButtonElement>('[data-race]');
		const formula = q<HTMLElement>('[data-formula]');
		const live = q<HTMLElement>('[data-live]');

		let A = pt(0, 14);
		let B = pt(38, -12);
		let x = 26;
		let lastTex = '';
		let anim = 0;
		const v1 = () => Number(v1In.value);
		const v2 = () => Number(v2In.value);
		const time = (xx: number) => Math.hypot(xx - A.x, A.y) / v1() + Math.hypot(B.x - xx, B.y) / v2();
		/** the fastest entry point: t(x) is convex, ternary search */
		const bestX = () => {
			let lo = Math.min(A.x, B.x);
			let hi = Math.max(A.x, B.x);
			for (let i = 0; i < 100; i++) {
				const m1 = lo + (hi - lo) / 3;
				const m2 = hi - (hi - lo) / 3;
				if (time(m1) < time(m2)) hi = m2;
				else lo = m1;
			}
			return (lo + hi) / 2;
		};
		const r1 = (v: number) => Math.round(v * 10) / 10;
		/** the time as the formula shows it: the sum of the two rounded parts */
		const tDisp = (xx: number) => r1(Math.hypot(xx - A.x, A.y) / v1()) + r1(Math.hypot(B.x - xx, B.y) / v2());
		const straightX = () => A.x + ((B.x - A.x) * A.y) / (A.y - B.y);

		const render = () => {
			v1Out.value = `${fmt(v1(), 1, true)} м/с`;
			v2Out.value = `${fmt(v2(), 1, true)} м/с`;
			const X = pt(x, 0);
			const xb = bestX();
			const sa = sx(A);
			const sb = sx(B);
			const sX = sx(X);
			gA.setAttribute('transform', `translate(${sa.x} ${sa.y})`);
			gB.setAttribute('transform', `translate(${sb.x} ${sb.y})`);
			gX.setAttribute('transform', `translate(${sX.x} ${sX.y})`);
			gX.setAttribute('aria-valuenow', fmt(x, 1));
			path.setAttribute('d', lineD([sa, sX, sb]));
			best.setAttribute('d', lineD([sa, sx(pt(xb, 0)), sb]));
			straight.setAttribute('d', lineD([sa, sb]));
			setA(normal, { x1: sX.x, y1: sX.y - 90, x2: sX.x, y2: sX.y + 90 });

			// angles from the perpendicular to the shore
			const thA = ang(sub(sa, sX));
			const thB = ang(sub(sb, sX));
			const aDeg = (Math.atan2(Math.abs(x - A.x), A.y) * 180) / Math.PI;
			const gDeg = (Math.atan2(Math.abs(B.x - x), -B.y) * 180) / Math.PI;
			const r = 40;
			arcA.setAttribute('d', arcD(sX, r, -90, thA));
			arcG.setAttribute('d', arcD(sX, r, 90, thB));
			secA.setAttribute('d', `M${sX.x} ${sX.y} ${arcD(sX, r, -90, thA).replace('M', 'L')} Z`);
			secG.setAttribute('d', `M${sX.x} ${sX.y} ${arcD(sX, r, 90, thB).replace('M', 'L')} Z`);
			const pa = aDeg > 20 ? arcMid(sX, r + 18, -90, thA) : add(sX, pt(x > A.x ? -14 : 14, -r - 16));
			const pg = gDeg > 20 ? arcMid(sX, r + 18, 90, thB) : add(sX, pt(x < B.x ? 14 : -14, r + 16));
			setA(labA, { x: pa.x, y: pa.y });
			setA(labG, { x: pg.x, y: pg.y });

			// graph on the same horizontal scale
			const xs: number[] = [];
			for (let xx = XMIN; xx <= XMAX + 1e-9; xx += 0.5) xs.push(xx);
			const ts = xs.map(time);
			const tmin = time(xb);
			const tmax = Math.max(...ts);
			const top = 22;
			const bot = GH - 30;
			const gy = (t: number) => bot - ((t - tmin) / (tmax - tmin || 1)) * (bot - top) * 0.92 - 6;
			axes.setAttribute('d', `M0 ${bot} H${W}`);
			curve.setAttribute('d', lineD(xs.map((xx, i) => pt(sx(pt(xx, 0)).x, gy(ts[i])))));
			const gbx = sx(pt(xb, 0)).x;
			setA(minline, { x1: gbx, y1: gy(tmin), x2: gbx, y2: bot });
			setA(gdot, { cx: sX.x, cy: gy(time(x)) });
			setA(glabel, { x: 8, y: 16 });
			setA(gmin, { x: clamp(gbx, 100, W - 100), y: bot + 18, 'dominant-baseline': 'central' });

			// formula and words
			const AX = Math.hypot(x - A.x, A.y);
			const XB = Math.hypot(B.x - x, B.y);
			const t1 = AX / v1();
			const t2 = XB / v2();
			const ratio = Math.sin((aDeg * Math.PI) / 180) / Math.sin((gDeg * Math.PI) / 180);
			const tt = `\\begin{aligned} t &= \\frac{AX}{\\upsilon_1} + \\frac{XB}{\\upsilon_2} \\\\ &= \\frac{${tex(AX, 1)}~\\text{м}}{${tex(v1(), 1, true)}~\\text{м/с}} + \\frac{${tex(XB, 1)}~\\text{м}}{${tex(v2(), 1, true)}~\\text{м/с}} \\\\ &= ${tex(t1, 1)}~\\text{с} + ${tex(t2, 1)}~\\text{с} = ${tex(r1(t1) + r1(t2), 1)}~\\text{с} \\end{aligned}`;
			if (tt !== lastTex) {
				lastTex = tt;
				katex.render(tt, formula, { displayMode: true, throwOnError: false });
			}
			const atBest = Math.abs(x - xb) < 0.26;
			const tS = tDisp(straightX());
			const tB = tDisp(xb);
			live.innerHTML = atBest
				? `<b>Это самый быстрый путь: ${fmt(tB, 1)} с.</b> По прямой вышло бы ${fmt(tS, 1)} с. Самый быстрый путь — ломаный: спасатель бежит по песку дальше, чем по прямой, зато меньше плывёт. И здесь <i>sin α</i> : <i>sin γ</i> = ${fmt(ratio, 2)} — ровно во столько раз бег быстрее плавания (<i>υ</i><sub>1</sub> : <i>υ</i><sub>2</sub> = ${fmt(v1() / v2(), 2)}). Это и есть закон преломления!`
				: `Время в пути ${fmt(r1(t1) + r1(t2), 1)} с, а самый быстрый путь займёт ${fmt(tB, 1)} с. Сейчас <i>sin α</i> : <i>sin γ</i> = ${fmt(ratio, 2)}, а <i>υ</i><sub>1</sub> : <i>υ</i><sub>2</sub> = ${fmt(v1() / v2(), 2)}. Двигайте точку входа и найдите дно графика.`;
		};

		const setX = (xx: number) => {
			x = clamp(Math.round(xx * 4) / 4, XMIN + 0.5, XMAX - 0.5);
			hint.classList.remove('orp-hint');
			render();
		};
		draggable(svg, gX, { onMove: (p) => setX(wx(p).x) });
		draggable(svg, gA, {
			anchor: () => sx(A),
			onMove: (p) => {
				const w = wx(p);
				A = pt(clamp(Math.round(w.x), XMIN + 1, XMAX - 1), clamp(Math.round(w.y), 4, YMAX - 2));
				render();
			},
		});
		draggable(svg, gB, {
			anchor: () => sx(B),
			onMove: (p) => {
				const w = wx(p);
				B = pt(clamp(Math.round(w.x), XMIN + 1, XMAX - 1), clamp(Math.round(w.y), YMIN + 2, -4));
				render();
			},
		});
		gX.addEventListener('keydown', (e) => {
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			e.preventDefault();
			setX(x + (e.key === 'ArrowRight' ? 1 : -1) * (e.shiftKey ? 2 : 0.5));
		});
		const keyMove = (which: 'A' | 'B') => (e: KeyboardEvent) => {
			const d = { ArrowLeft: pt(-1, 0), ArrowRight: pt(1, 0), ArrowUp: pt(0, 1), ArrowDown: pt(0, -1) }[e.key];
			if (!d) return;
			e.preventDefault();
			if (which === 'A') A = pt(clamp(A.x + d.x, XMIN + 1, XMAX - 1), clamp(A.y + d.y, 4, YMAX - 2));
			else B = pt(clamp(B.x + d.x, XMIN + 1, XMAX - 1), clamp(B.y + d.y, YMIN + 2, -4));
			render();
		};
		gA.addEventListener('keydown', keyMove('A'));
		gB.addEventListener('keydown', keyMove('B'));
		v1In.addEventListener('input', render);
		v2In.addEventListener('input', render);

		findBtn.addEventListener('click', () => {
			cancelAnimationFrame(anim);
			const from = x;
			const to = bestX();
			if (reduceMotion()) {
				x = to;
				render();
				return;
			}
			const t0 = performance.now();
			const frame = (now: number) => {
				const k = Math.min(1, (now - t0) / 900);
				x = from + (to - from) * (1 - (1 - k) ** 3);
				render();
				if (k < 1) anim = requestAnimationFrame(frame);
			};
			anim = requestAnimationFrame(frame);
		});

		// the race: positions at time t along a two-piece path, real proportions, 4× faster
		const posAt = (xx: number, t: number) => {
			const X = pt(xx, 0);
			const AX = Math.hypot(xx - A.x, A.y);
			const t1 = AX / v1();
			if (t <= t1) return add(A, mul(sub(X, A), t / t1));
			const XB = Math.hypot(B.x - xx, B.y);
			const s = Math.min(1, ((t - t1) * v2()) / XB);
			return add(X, mul(sub(B, X), s));
		};
		raceBtn.addEventListener('click', () => {
			cancelAnimationFrame(anim);
			const xs = straightX();
			const tEnd = Math.max(time(x), time(xs));
			run1.style.display = run2.style.display = 'block';
			const t0 = performance.now();
			const frame = (now: number) => {
				const t = reduceMotion() ? tEnd : Math.min(tEnd, ((now - t0) / 1000) * 4);
				const p1 = sx(posAt(x, t));
				const p2 = sx(posAt(xs, t));
				setA(run1, { cx: p1.x, cy: p1.y });
				setA(run2, { cx: p2.x, cy: p2.y });
				const d1 = time(x) <= t;
				const d2 = time(xs) <= t;
				live.innerHTML = `Секундомер: <b>${fmt(t, 1)} с</b>. Ваш путь: ${d1 ? `финиш за ${fmt(tDisp(x), 1)} с` : 'в пути'}; по прямой: ${d2 ? `финиш за ${fmt(tDisp(xs), 1)} с` : 'в пути'}.${d1 && d2 ? (time(x) < time(xs) - 0.05 ? ' <b>Ваш путь быстрее, хотя он длиннее!</b>' : time(x) > time(xs) + 0.05 ? ' Прямой путь оказался быстрее — поищите точку входа получше.' : ' Ничья.') : ''}`;
				if (t < tEnd) anim = requestAnimationFrame(frame);
			};
			anim = requestAnimationFrame(frame);
		});

		const fitNarrow = () => root.classList.toggle('is-narrow', root.clientWidth < 560);
		new ResizeObserver(fitNarrow).observe(root);
		render();
	}
</script>
