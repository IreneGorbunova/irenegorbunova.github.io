---
/**
 * The main model of the chapter. Tab 1 «Закон отражения»: a laser pointer is dragged around a
 * plane mirror with a protractor; live arcs show the angles of incidence and reflection; the
 * mirror can be turned (the reflected ray turns twice as far). Tab 2 «Изображение в зеркале»:
 * an object (the letter Р) and an eye are dragged in front of a mirror 12 cm long (grid = 1 cm);
 * the image is built with rays, step by step if wished, and the zone from which it is seen
 * is shaded.
 * `mode` shows one tab only, without the switch («law» or «img»): the chapter puts each tab in its own section.
 */
import OrpStyles from './OrpStyles.astro';

interface Props {
	mode?: 'law' | 'img';
}
const { mode } = Astro.props;
---

<OrpStyles />
<figure class="orp orp-mirror not-content" data-orp-mirror>
	{
		!mode && (
			<div class="orp-tabs">
				<div class="orp-seg" role="group" aria-label="Что показать">
					<button type="button" aria-pressed="true" data-tab="law">Закон отражения</button>
					<button type="button" aria-pressed="false" data-tab="img">Изображение в зеркале</button>
				</div>
			</div>
		)
	}

	<div data-panel="law" hidden={mode === 'img'}>
		<svg class="orp__svg" data-svg role="group" aria-label="Лазерная указка светит на плоское зеркало">
			<g data-frame>
				<path class="orp-mirror__prot" data-prot></path>
				<g class="orp-mirror__ticks" data-ticks></g>
				<line class="orp-normal" data-normal></line>
				<text class="orp-t orp-t--small" text-anchor="middle" data-normal-label>перпендикуляр</text>
				<g data-mirror></g>
			</g>
			<g data-arcs>
				<path class="orp-sector orp-sector--a" data-sec-a></path>
				<path class="orp-sector orp-sector--b" data-sec-b></path>
				<path class="orp-arc orp-arc--a" data-arc-a></path>
				<path class="orp-arc orp-arc--b" data-arc-b></path>
			</g>
			<g class="orp-beam">
				<path class="orp-beam__glow" data-beam></path>
				<path class="orp-beam__core" data-beam></path>
				<path class="orp-beam__flow" data-beam></path>
			</g>
			<circle class="orp-mirror__spot" r="4" data-spot></circle>
			<text class="orp-t orp-t--a" text-anchor="middle" dominant-baseline="central" data-lab-a></text>
			<text class="orp-t orp-t--b" text-anchor="middle" dominant-baseline="central" data-lab-b></text>
			<text class="orp-t orp-t--small" data-ray-in>падающий луч</text>
			<text class="orp-t orp-t--small" data-ray-out>отражённый луч</text>
			<g class="orp-laser orp-grab" data-laser tabindex="0" role="slider" aria-label="Лазерная указка. Тяните её или нажимайте стрелки" aria-valuemin="0" aria-valuemax="85">
				<circle class="orp-grab__hit" cx="34" r="38"></circle>
				<circle class="orp-grab__ring orp-hint" cx="34" r="30" data-hint></circle>
				<rect x="6" y="-8" width="62" height="16" rx="5"></rect>
				<rect class="orp-laser__btn" x="38" y="-11" width="10" height="4" rx="1.5"></rect>
				<circle class="orp-laser__tip" cx="5" r="3.5"></circle>
			</g>
		</svg>
		<div class="orp-controls">
			<label class="orp-slider">
				<span>Поверните зеркало</span>
				<output data-tilt-out>0°</output>
				<input type="range" min="-20" max="20" step="1" value="0" data-tilt />
			</label>
			<button type="button" class="orp-btn" data-perp>Луч перпендикулярно</button>
		</div>
		<dl class="orp-stats">
			<div class="is-a"><dt>Угол падения <i>α</i></dt><dd data-o-a></dd></div>
			<div class="is-b"><dt>Угол отражения <i>β</i></dt><dd data-o-b></dd></div>
			<div><dt>Между лучами</dt><dd data-o-ab></dd></div>
		</dl>
		<div class="orp-formula" data-formula aria-live="polite"></div>
		<p class="orp-live" data-live></p>
		<figcaption class="orp-legend">
			Тяните лазерную указку (или выберите её клавишей Tab и нажимайте стрелки). Углы отсчитывают от перпендикуляра к зеркалу, проведённого в точку падения луча. Шкала транспортира — через <span class="orp-nw">5°</span>.
		</figcaption>
	</div>

	<div data-panel="img" hidden={mode !== 'img'}>
		<svg class="orp__svg orp-mirror__img" data-svg role="group" aria-label="Построение изображения предмета в плоском зеркале">
			<g class="orp-mirror__grid" data-grid></g>
			<path class="orp-mirror__zone" data-zone></path>
			<g data-mirror></g>
			<line class="orp-mirror__perp" data-perp-line></line>
			<g data-st="2" class="orp-st">
				<g data-normals></g>
			</g>
			<g data-st="1" class="orp-st">
				<g class="orp-beam" data-r1></g>
			</g>
			<g data-st="2" class="orp-st">
				<g class="orp-beam" data-r2></g>
			</g>
			<g data-st="3" class="orp-st">
				<g class="orp-beam" data-r3></g>
				<circle class="orp-mirror__vdot" r="4.5" data-s2></circle>
				<text class="orp-t orp-t--math" data-s2-label>S′</text>
			</g>
			<g data-st="4" class="orp-st">
				<path class="orp-mirror__letter is-image" data-image-letter></path>
				<g class="orp-beam orp-mirror__eyeray" data-eyeray>
					<path class="orp-beam__glow" data-er></path>
					<path class="orp-beam__core" data-er></path>
					<path class="orp-beam__flow" data-er></path>
				</g>
				<path class="orp-mirror__sight" data-sight></path>
				<g data-dims>
					<text class="orp-t" text-anchor="middle" data-d1></text>
					<text class="orp-t" text-anchor="middle" data-d2></text>
				</g>
			</g>
			<g class="orp-grab" data-obj tabindex="0" role="group" aria-label="Предмет — буква Р. Тяните его или нажимайте стрелки">
				<rect class="orp-grab__hit" x="-18" y="-18" width="58" height="96"></rect>
				<path class="orp-mirror__letter" data-letter></path>
				<circle class="orp-mirror__sdot" r="5"></circle>
				<text class="orp-t orp-t--math" x="-10" y="-8" text-anchor="end">S</text>
			</g>
			<g class="orp-grab orp-mirror__eye" data-eye tabindex="0" role="group" aria-label="Глаз наблюдателя. Тяните его или нажимайте стрелки">
				<circle class="orp-grab__hit" r="28"></circle>
				<circle class="orp-grab__ring orp-hint" r="24"></circle>
				<g data-eye-rot>
					<path class="orp-mirror__eyeball" d="M-15 0 Q0 -13 15 0 Q0 13 -15 0Z"></path>
					<circle class="orp-mirror__iris" cx="5" r="5.5"></circle>
					<circle class="orp-mirror__pupil" cx="6" r="2.4"></circle>
				</g>
			</g>
		</svg>
		<div class="orp-controls">
			<button type="button" class="orp-btn orp-btn--primary" data-steps>Построить по шагам</button>
			<button type="button" class="orp-btn" data-all hidden>Показать всё</button>
			<label class="orp-check"><input type="checkbox" checked data-zone-on /> Откуда видно изображение</label>
		</div>
		<dl class="orp-stats">
			<div><dt>От предмета до зеркала</dt><dd data-o-d1></dd></div>
			<div><dt>От изображения до зеркала</dt><dd data-o-d2></dd></div>
			<div><dt>Высота предмета и изображения</dt><dd>3 см и 3 см</dd></div>
		</dl>
		<p class="orp-live" data-live></p>
		<figcaption class="orp-legend">
			Вид сверху, клетка — <span class="orp-nw">1 см</span>, длина зеркала <span class="orp-nw">12 см</span>. Тяните букву и глаз. <span class="orp-key" style="--c: var(--ig-v)"></span>лучи света, <span class="orp-key orp-key--dash" style="--c: var(--ig-v)"></span>продолжения лучей за зеркало: по ним свет не идёт.
		</figcaption>
	</div>
</figure>

<style is:global>
	.orp-mirror__prot {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 35%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.orp-mirror__ticks line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.orp-mirror__ticks line.is-major {
		stroke: var(--sl-color-gray-3);
	}
	.orp-mirror__ticks text {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		stroke: none;
	}
	.orp.is-narrow .orp-mirror__ticks text {
		font-size: 15px;
	}
	.orp-mirror__spot {
		fill: white;
		filter: drop-shadow(0 0 5px var(--orp-beam));
	}
	.orp-mirror__img {
		--orp-beam: var(--ig-v);
	}
	.orp-mirror__img .orp-beam__core {
		stroke-width: 2;
	}
	.orp-mirror__img .orp-beam__glow {
		stroke-width: 7;
	}
	.orp-mirror__zone {
		fill: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
		stroke: color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
		stroke-width: 1;
		stroke-dasharray: 3 5;
		transition: opacity 0.3s;
	}
	.orp-mirror__perp {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 2 5;
	}
	.orp-mirror__letter {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.orp-mirror__letter.is-image {
		stroke: var(--sl-color-gray-2);
		stroke-width: 5;
		stroke-dasharray: 0.1 8;
	}
	.orp-mirror__sdot {
		fill: var(--ig-v);
		filter: drop-shadow(0 0 6px var(--ig-v));
	}
	.orp-mirror__vdot {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 2.4;
	}
	.orp-mirror__eyeball {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	.orp-mirror__iris {
		fill: var(--ig-vx);
	}
	.orp-mirror__pupil {
		fill: var(--sl-color-black);
	}
	.orp-mirror__eyeray {
		--orp-beam: var(--sl-color-accent);
	}
	.orp-mirror__eyeray .orp-beam__core {
		stroke-width: 3.2;
	}
	.orp-mirror__sight {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		stroke-dasharray: 8 6;
	}
	.orp-mirror__sight.is-miss,
	.orp-mirror__eyeray.is-miss {
		opacity: 0.35;
	}
	.orp-mirror__nrm {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 4;
	}
	.orp-st {
		transition: opacity 0.6s ease;
	}
	.orp-st.is-off {
		opacity: 0;
		pointer-events: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.orp-st,
		.orp-mirror__zone {
			transition: none;
		}
	}
</style>

<script>
	import katex from 'katex';
	import {
		RAD,
		clamp,
		pt,
		add,
		sub,
		mul,
		dir,
		ang,
		arcD,
		arcMid,
		lineD,
		svgEl,
		setA,
		draggable,
		type P,
	} from './orp';

	const wrap = (a: number) => {
		while (a > 180) a -= 360;
		while (a < -180) a += 360;
		return a;
	};
	/** where a ray from p along unit d leaves the box [m, w−m]×[m, h−m] */
	const exitBox = (p: P, d: P, w: number, h: number, m = 2) => {
		let t = Infinity;
		if (d.x > 1e-9) t = Math.min(t, (w - m - p.x) / d.x);
		if (d.x < -1e-9) t = Math.min(t, (m - p.x) / d.x);
		if (d.y > 1e-9) t = Math.min(t, (h - m - p.y) / d.y);
		if (d.y < -1e-9) t = Math.min(t, (m - p.y) / d.y);
		return add(p, mul(d, Math.max(0, t)));
	};
	const deg = (a: number) => `${Math.round(a)}°`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-orp-mirror]')) {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
		let narrow = false;

		/* ---------------- Tab 1: the law of reflection ---------------- */
		const lawRoot = root.querySelector<HTMLElement>('[data-panel="law"]')!;
		const law = (() => {
			const q = <T extends Element>(s: string) => lawRoot.querySelector<T>(s)!;
			const svg = q<SVGSVGElement>('svg');
			const frame = q<SVGGElement>('[data-frame]');
			const prot = q<SVGPathElement>('[data-prot]');
			const ticks = q<SVGGElement>('[data-ticks]');
			const normal = q<SVGLineElement>('[data-normal]');
			const normalLabel = q<SVGTextElement>('[data-normal-label]');
			const mirror = q<SVGGElement>('[data-mirror]');
			const secA = q<SVGPathElement>('[data-sec-a]');
			const secB = q<SVGPathElement>('[data-sec-b]');
			const arcA = q<SVGPathElement>('[data-arc-a]');
			const arcB = q<SVGPathElement>('[data-arc-b]');
			const beams = Array.from(lawRoot.querySelectorAll<SVGPathElement>('[data-beam]'));
			const spot = q<SVGCircleElement>('[data-spot]');
			const labA = q<SVGTextElement>('[data-lab-a]');
			const labB = q<SVGTextElement>('[data-lab-b]');
			const rayIn = q<SVGTextElement>('[data-ray-in]');
			const rayOut = q<SVGTextElement>('[data-ray-out]');
			const laser = q<SVGGElement>('[data-laser]');
			const hint = q<SVGCircleElement>('[data-hint]');
			const tilt = q<HTMLInputElement>('[data-tilt]');
			const tiltOut = q<HTMLOutputElement>('[data-tilt-out]');
			const perp = q<HTMLButtonElement>('[data-perp]');
			const oA = q<HTMLElement>('[data-o-a]');
			const oB = q<HTMLElement>('[data-o-b]');
			const oAB = q<HTMLElement>('[data-o-ab]');
			const formula = q<HTMLElement>('[data-formula]');
			const live = q<HTMLElement>('[data-live]');

			let W = 760;
			let H = 400;
			let R = 250;
			let O = pt(380, 340);
			let phi = 0; // mirror tilt, degrees (screen, clockwise positive)
			let rel = -40; // laser angle from the normal, degrees (negative = left of it)
			let lastTex = '';

			const build = () => {
				W = narrow ? 480 : 760;
				H = narrow ? 340 : 400;
				R = narrow ? 168 : 250;
				O = pt(W / 2, H - (narrow ? 52 : 60));
				svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
				// protractor
				const p0 = add(O, pt(-R, 0));
				const p1 = add(O, pt(R, 0));
				prot.setAttribute('d', `M${p0.x} ${p0.y} A${R} ${R} 0 0 1 ${p1.x} ${p1.y} Z`);
				ticks.replaceChildren();
				for (let a = -90; a <= 90; a += 5) {
					const major = a % 10 === 0;
					const u = dir(-90 + a);
					const r0 = R - (major ? 12 : 7);
					const l = svgEl('line', {}, ticks);
					const pa = add(O, mul(u, r0));
					const pb = add(O, mul(u, R));
					setA(l, { x1: pa.x, y1: pa.y, x2: pb.x, y2: pb.y });
					if (major) l.setAttribute('class', 'is-major');
					const every = narrow ? 30 : 10;
					if (a % every === 0 && Math.abs(a) < 90) {
						const pc = add(O, mul(u, R - (narrow ? 28 : 24)));
						const t = svgEl('text', { x: pc.x, y: pc.y, 'text-anchor': 'middle', 'dominant-baseline': 'central' }, ticks);
						t.textContent = String(Math.abs(a));
					}
				}
				setA(normal, { x1: O.x, y1: O.y, x2: O.x, y2: O.y - R - (narrow ? 14 : 22) });
				setA(normalLabel, { x: O.x, y: O.y - R - (narrow ? 22 : 30) });
				// mirror: a bright face and a hatched back, longer than the protractor
				mirror.replaceChildren();
				const half = R + (narrow ? 40 : 70);
				svgEl('line', { class: 'orp-mirror__face', x1: O.x - half, y1: O.y, x2: O.x + half, y2: O.y }, mirror);
				for (let x = -half + 6; x <= half; x += 12) {
					svgEl('line', { class: 'orp-mirror__back', x1: O.x + x, y1: O.y + 3, x2: O.x + x - 9, y2: O.y + 13 }, mirror);
				}
				render();
			};

			const render = () => {
				const nA = -90 + phi; // screen angle of the normal
				const thL = nA + rel; // screen angle from O towards the laser
				const refl = nA - rel; // screen angle of the reflected ray
				const a = Math.abs(rel);
				frame.setAttribute('transform', `rotate(${phi} ${O.x} ${O.y})`);

				const Rl = R + 6;
				const L = add(O, mul(dir(thL), Rl));
				const E = exitBox(O, dir(refl), W, H);
				const d = lineD([L, O, E]);
				beams.forEach((b) => b.setAttribute('d', d));
				setA(spot, { cx: O.x, cy: O.y });
				laser.setAttribute('transform', `translate(${L.x.toFixed(1)} ${L.y.toFixed(1)}) rotate(${thL})`);

				// arcs and labels
				const ra = narrow ? 50 : 64;
				const show = a >= 0.5;
				[secA, secB, arcA, arcB, labA, labB].forEach((e) => (e.style.display = show ? '' : 'none'));
				if (show) {
					arcA.setAttribute('d', arcD(O, ra, nA, thL));
					arcB.setAttribute('d', arcD(O, ra, nA, refl));
					secA.setAttribute('d', `M${O.x} ${O.y} ${arcD(O, ra, nA, thL).replace('M', 'L')} Z`);
					secB.setAttribute('d', `M${O.x} ${O.y} ${arcD(O, ra, nA, refl).replace('M', 'L')} Z`);
					const rl = ra + (narrow ? 44 : 40);
					const s = Math.sign(rel);
					// wide angles: the label sits inside its arc; narrow ones: just outside the ray
					const lim = narrow ? 52 : 30;
					const pa = a >= lim ? arcMid(O, rl, nA, thL) : add(O, mul(dir(thL + s * (narrow ? 17 : 13)), rl));
					const pb = a >= lim ? arcMid(O, rl, nA, refl) : add(O, mul(dir(refl - s * (narrow ? 17 : 13)), rl));
					setA(labA, { x: pa.x, y: pa.y });
					setA(labB, { x: pb.x, y: pb.y });
					labA.textContent = `α = ${deg(a)}`;
					labB.textContent = `β = ${deg(a)}`;
				}
				// ray names along the rays, outside the protractor scale
				const nameAt = (el: SVGTextElement, th: number, r: number) => {
					const p = add(O, mul(dir(th), r));
					const left = Math.cos(th * RAD) < 0;
					let rot = th;
					if (left) rot = th + 180;
					setA(el, {
						x: p.x,
						y: p.y,
						'text-anchor': 'middle',
						transform: `rotate(${rot.toFixed(1)} ${p.x.toFixed(1)} ${p.y.toFixed(1)}) translate(0 -9)`,
					});
				};
				nameAt(rayIn, thL, R * 0.62);
				nameAt(rayOut, refl, R * 0.62);
				rayIn.style.display = rayOut.style.display = a >= 12 && !narrow ? '' : 'none';

				laser.setAttribute('aria-valuenow', String(Math.round(a)));
				laser.setAttribute('aria-valuetext', `угол падения ${Math.round(a)} градусов`);
				oA.textContent = deg(a);
				oB.textContent = deg(a);
				oAB.textContent = deg(2 * a);
				tiltOut.value = `${phi > 0 ? '+' : ''}${phi}°`.replace('-', '−');

				const t = `\\beta = \\alpha = ${Math.round(a)}^\\circ,\\qquad \\alpha + \\beta = ${Math.round(2 * a)}^\\circ`;
				if (t !== lastTex) {
					lastTex = t;
					katex.render(t, formula, { displayMode: true, throwOnError: false });
				}
				let msg =
					a < 0.5
						? '<b>Луч падает перпендикулярно зеркалу:</b> <i>α</i> = 0, и он отражается прямо назад, в указку.'
						: `<b>Угол отражения равен углу падения:</b> <i>β</i> = <i>α</i> = ${deg(a)}. Падающий луч, отражённый луч и перпендикуляр лежат в одной плоскости — в плоскости экрана.`;
				if (phi !== 0)
					msg += ` Зеркало повёрнуто на ${Math.abs(phi)}°, а отражённый луч повернулся на <b>${2 * Math.abs(phi)}°</b> — вдвое больше, хотя указка стоит на месте.`;
				live.innerHTML = msg;
			};

			const setRel = (r: number) => {
				rel = clamp(Math.round(r), -85, 85);
				hint.classList.remove('orp-hint');
				render();
			};
			const O_ = () => O;
			draggable(svg, laser, {
				onMove: (p) => {
					const th = ang(sub(p, O_()));
					let r = wrap(th - (-90 + phi));
					if (Math.abs(r) > 90) r = Math.sign(r) * 85;
					setRel(r);
				},
			});
			laser.addEventListener('keydown', (e) => {
				const step = e.shiftKey ? 5 : 1;
				if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') setRel(rel - step);
				else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') setRel(rel + step);
				else return;
				e.preventDefault();
			});
			tilt.addEventListener('input', () => {
				const thL = -90 + phi + rel; // the laser stays where it is
				phi = Number(tilt.value);
				rel = clamp(Math.round(wrap(thL - (-90 + phi))), -85, 85);
				render();
			});
			perp.addEventListener('click', () => setRel(0));
			return { build };
		})();

		/* ---------------- Tab 2: the image in a plane mirror ---------------- */
		const imgRoot = root.querySelector<HTMLElement>('[data-panel="img"]')!;
		const img = (() => {
			const q = <T extends Element>(s: string) => imgRoot.querySelector<T>(s)!;
			const svg = q<SVGSVGElement>('svg');
			const grid = q<SVGGElement>('[data-grid]');
			const zone = q<SVGPathElement>('[data-zone]');
			const mirror = q<SVGGElement>('[data-mirror]');
			const perpLine = q<SVGLineElement>('[data-perp-line]');
			const normals = q<SVGGElement>('[data-normals]');
			const r1 = q<SVGGElement>('[data-r1]');
			const r2 = q<SVGGElement>('[data-r2]');
			const r3 = q<SVGGElement>('[data-r3]');
			const s2 = q<SVGCircleElement>('[data-s2]');
			const s2l = q<SVGTextElement>('[data-s2-label]');
			const imgLetter = q<SVGPathElement>('[data-image-letter]');
			const eyeray = q<SVGGElement>('[data-eyeray]');
			const er = Array.from(imgRoot.querySelectorAll<SVGPathElement>('[data-er]'));
			const sight = q<SVGPathElement>('[data-sight]');
			const d1 = q<SVGTextElement>('[data-d1]');
			const d2 = q<SVGTextElement>('[data-d2]');
			const obj = q<SVGGElement>('[data-obj]');
			const letter = q<SVGPathElement>('[data-letter]');
			const eye = q<SVGGElement>('[data-eye]');
			const eyeRot = q<SVGGElement>('[data-eye-rot]');
			const stBtn = q<HTMLButtonElement>('[data-steps]');
			const allBtn = q<HTMLButtonElement>('[data-all]');
			const zoneOn = q<HTMLInputElement>('[data-zone-on]');
			const oD1 = q<HTMLElement>('[data-o-d1]');
			const oD2 = q<HTMLElement>('[data-o-d2]');
			const live = q<HTMLElement>('[data-live]');
			const stages = Array.from(imgRoot.querySelectorAll<SVGGElement>('[data-st]'));

			const C = 20; // px per centimetre (one grid cell)
			const LETTER = 'M0 0 V60 M0 0 H14 A17 17 0 0 1 14 34 H0';
			letter.setAttribute('d', LETTER);
			imgLetter.setAttribute('d', LETTER);
			let W = 760;
			let H = 400;
			let xm = 440;
			let yt = 80;
			let yb = 320;
			let S = pt(220, 160);
			let E = pt(120, 330);
			let stage = 4;

			const beam = (g: SVGGElement, paths: { d: string; virt?: boolean }[]) => {
				g.replaceChildren();
				for (const p of paths) {
					if (p.virt) svgEl('path', { class: 'orp-beam__virt', d: p.d }, g);
					else {
						svgEl('path', { class: 'orp-beam__glow', d: p.d }, g);
						svgEl('path', { class: 'orp-beam__core', d: p.d }, g);
						svgEl('path', { class: 'orp-beam__flow', d: p.d }, g);
					}
				}
			};

			const build = () => {
				W = narrow ? 480 : 760;
				H = narrow ? 440 : 400;
				xm = narrow ? 300 : 440;
				yt = narrow ? 100 : 80;
				yb = yt + 12 * C;
				svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
				grid.replaceChildren();
				for (let x = C; x < W; x += C) svgEl('line', { x1: x, y1: 0, x2: x, y2: H }, grid);
				for (let y = C; y < H; y += C) svgEl('line', { x1: 0, y1: y, x2: W, y2: y }, grid);
				mirror.replaceChildren();
				svgEl('line', { class: 'orp-mirror__face', x1: xm, y1: yt, x2: xm, y2: yb }, mirror);
				for (let y = yt + 4; y <= yb; y += 12) svgEl('line', { class: 'orp-mirror__back', x1: xm + 3, y1: y, x2: xm + 13, y2: y - 9 }, mirror);
				S = narrow ? pt(160, 180) : pt(260, 160);
				E = narrow ? pt(80, 400) : pt(120, 350);
				place(S, E);
			};

			// the object stays left of the mirror and its image stays inside the picture
			const place = (s: P, e: P) => {
				const xmin = Math.max(40, xm - (W - xm - 40));
				S = pt(clamp(Math.round(s.x / 10) * 10, xmin, xm - 40), clamp(Math.round(s.y / 10) * 10, 30, H - 80));
				E = pt(clamp(e.x, 24, xm - 40), clamp(e.y, 24, H - 24));
				render();
			};

			const render = () => {
				const S2 = pt(2 * xm - S.x, S.y);
				obj.setAttribute('transform', `translate(${S.x} ${S.y})`);
				imgLetter.setAttribute('transform', `translate(${S2.x} ${S2.y}) scale(-1 1)`);
				setA(s2, { cx: S2.x, cy: S2.y });
				setA(s2l, { x: S2.x + 10, y: S2.y - 8 });
				setA(perpLine, { x1: S.x, y1: S.y, x2: S2.x, y2: S2.y });

				// two rays from S to the mirror
				const span = yb - yt;
				let y1 = clamp(S.y - 0.3 * span, yt + 12, yb - 12);
				let y2 = clamp(S.y + 0.35 * span, yt + 12, yb - 12);
				if (y2 - y1 < 60) {
					if (y1 > yt + 72) y1 = y2 - 60;
					else y2 = y1 + 60;
				}
				const Ms = [pt(xm, y1), pt(xm, y2)];
				beam(
					r1,
					Ms.map((M) => ({ d: lineD([S, M]) })),
				);
				beam(
					r2,
					Ms.map((M) => {
						const u = sub(M, S);
						const out = exitBox(M, mul(pt(-u.x, u.y), 1 / Math.hypot(u.x, u.y)), W, H);
						return { d: lineD([M, out]) };
					}),
				);
				beam(
					r3,
					Ms.map((M) => ({ d: lineD([M, S2]), virt: true })),
				);
				// normals and equal angles at the points of incidence
				normals.replaceChildren();
				for (const M of Ms) {
					svgEl('line', { class: 'orp-mirror__nrm', x1: M.x - 46, y1: M.y, x2: M.x, y2: M.y }, normals);
					const aIn = ang(sub(S, M));
					// the reflected ray goes along (S − M) with its vertical part flipped: angle −aIn
					svgEl('path', { class: 'orp-arc orp-arc--a', d: arcD(M, 26, 180, aIn) }, normals);
					svgEl('path', { class: 'orp-arc orp-arc--b', d: arcD(M, 26, 180, -aIn) }, normals);
				}

				// the ray that reaches the eye
				const t = (xm - E.x) / (S2.x - E.x);
				const ye = E.y + (S2.y - E.y) * t;
				const Me = pt(xm, ye);
				const sees = ye >= yt && ye <= yb;
				er.forEach((p) => p.setAttribute('d', lineD([S, Me, E])));
				eyeray.classList.toggle('is-miss', !sees);
				eyeray.style.display = sees ? '' : 'none';
				sight.setAttribute('d', lineD([Me, S2]));
				sight.classList.toggle('is-miss', !sees);
				sight.style.display = sees ? '' : 'none';
				eye.setAttribute('transform', `translate(${E.x.toFixed(1)} ${E.y.toFixed(1)})`);
				eyeRot.setAttribute('transform', `rotate(${ang(sub(sees ? Me : pt(xm, (yt + yb) / 2), E)).toFixed(1)})`);

				// zone from which the image is seen: a wedge from S′ through the mirror ends
				const T = pt(xm, yt);
				const B = pt(xm, yb);
				const far = (P0: P) => add(P0, mul(sub(P0, S2), 40));
				zone.setAttribute('d', `${lineD([T, far(T), far(B), B])} Z`);
				zone.style.opacity = zoneOn.checked && stage >= 4 ? '1' : '0';

				// distances
				const dcm = (xm - S.x) / C;
				const yd = S.y + 76 < H - 10 ? S.y + 80 : S.y - 26;
				setA(d1, { x: (S.x + xm) / 2, y: yd });
				setA(d2, { x: (S2.x + xm) / 2, y: yd });
				d1.textContent = `${fmtC(dcm)} см`;
				d2.textContent = `${fmtC(dcm)} см`;
				oD1.textContent = `${fmtC(dcm)} см`;
				oD2.textContent = `${fmtC(dcm)} см`;

				stages.forEach((g) => g.classList.toggle('is-off', Number(g.dataset.st) > stage));
				live.innerHTML = message(sees);
			};
			const fmtC = (x: number) => (Math.round(x * 2) / 2).toFixed(1).replace('.0', '').replace('.', ',');

			const message = (sees: boolean) => {
				switch (stage) {
					case 0:
						return '<b>Шаг 0.</b> Найдём изображение точки <i>S</i> — верхнего конца буквы. Свет расходится от неё во все стороны. Нажмите «Следующий шаг».';
					case 1:
						return '<b>Шаг 1.</b> Проведём от точки <i>S</i> два любых луча до зеркала.';
					case 2:
						return '<b>Шаг 2.</b> Каждый луч отражается по закону отражения: угол отражения равен углу падения (дуги у зеркала). Отражённые лучи <b>расходятся</b> и нигде не пересекаются.';
					case 3:
						return '<b>Шаг 3.</b> Продолжим отражённые лучи назад, за зеркало (пунктир). Продолжения пересекаются в одной точке <i>S′</i>: глазу кажется, что свет идёт оттуда. Это и есть изображение точки <i>S</i>.';
					default:
						return sees
							? '<b>Изображение мнимое:</b> за зеркалом света нет, там сходятся лишь продолжения лучей. Оно стоит <b>так же далеко за зеркалом</b>, как предмет перед ним, и <b>такого же размера</b>. Но буква повёрнута в другую сторону: изображение <b>симметрично</b> предмету.'
							: '<b>Отсюда изображения не видно:</b> луч, который попал бы в глаз, должен был бы отразиться за краем зеркала. Изображение при этом никуда не делось — передвиньте глаз в закрашенную область.';
				}
			};

			draggable(svg, obj, { anchor: () => S, onMove: (p) => place(p, E) });
			draggable(svg, eye, {
				anchor: () => E,
				onMove: (p) => {
					eye.querySelector('.orp-hint')?.classList.remove('orp-hint');
					place(S, p);
				},
			});
			const keys = (which: 'S' | 'E') => (e: KeyboardEvent) => {
				const d = { ArrowLeft: pt(-10, 0), ArrowRight: pt(10, 0), ArrowUp: pt(0, -10), ArrowDown: pt(0, 10) }[e.key];
				if (!d) return;
				e.preventDefault();
				if (which === 'S') place(add(S, d), E);
				else place(S, add(E, d));
			};
			obj.addEventListener('keydown', keys('S'));
			eye.addEventListener('keydown', keys('E'));

			const setStage = (s: number) => {
				stage = s;
				allBtn.hidden = stage >= 4;
				stBtn.textContent = stage >= 4 ? 'Построить по шагам' : `Следующий шаг (${stage + 1} из 4)`;
				render();
			};
			stBtn.addEventListener('click', () => setStage(stage >= 4 ? 0 : stage + 1));
			allBtn.addEventListener('click', () => setStage(4));
			zoneOn.addEventListener('change', render);
			return { build };
		})();

		const setTab = (t: string) => {
			tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tab === t)));
			panels.forEach((p) => (p.hidden = p.dataset.panel !== t));
		};
		tabs.forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab!)));

		let built = false;
		new ResizeObserver(() => {
			const n = root.clientWidth < 560;
			if (built && n === narrow) return;
			built = true;
			narrow = n;
			root.classList.toggle('is-narrow', narrow);
			law.build();
			img.build();
		}).observe(root);
	}
</script>
