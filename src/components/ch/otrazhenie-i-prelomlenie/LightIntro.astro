		stop-color: color-mix(in srgb, var(--ig-vy) 22%, var(--sl-color-gray-5));
	}
	.li-sea1 {
		stop-color: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-6));
	}
