---
/**
 * The opening scenes of the two chapters «Отражение света. Плоское зеркало» (chapter="reflection": sunbeam, lake) and
 * «Преломление света» (chapter="refraction": coin, sunset). No numbers and no signs in the pictures; the captions'
 * popovers explain.
 * Sunbeam: a room in a cut-away side view. Sunlight falls through the window at 30° to the horizontal (parallel
 *   rays). A hand holds a small mirror above the table and tilts it by +8° and −6°; the reflected beam is traced
 *   exactly (law of reflection from both ends of the mirror) to the right wall or the ceiling, so the bright spot
 *   («солнечный зайчик») runs along them: the beam turns twice as far as the mirror. The table, the mirror and the
 *   cat cast the correct parallel shadows of the sunlight; the cat's head follows the spot.
 * Lake: the far shore (hills, two firs, a house, clouds) seen across still water. The reflection is the shore turned
 *   over about the water line: a point at a height h above the water is seen at the depth h below it, so the
 *   reflection is as large as the shore and upside down; the water itself mirrors the sky (lighter near the shore).
 *   A gust of wind (the firs sway) raises ripples: every thin strip of water is tilted its own way and shifts its
 *   piece of the reflection sideways, so the picture breaks into wavy pieces and glints; then the water calms down.
 * Coin: a cup in a cut-away side view, 10 px = 1 cm (inner width 10 cm, depth 7 cm). The eye looks over the rim: the
 *   line of sight grazing the rim meets the far wall above the bottom, so the coin is hidden. Water (n = 1,33) is
 *   poured to 6,2 cm. The ray from the coin's centre to the eye is found exactly with the law of refraction; from a
 *   level of about 4,4 cm it passes over the rim and the coin is seen. Its apparent place is where the backward
 *   extensions of two neighbouring rays reaching the eye meet: higher than the coin and nearer to the eye.
 * Sunset: the Sun sets into the sea, 60 px = 1° on both axes (the Sun 0,533° across), its path 35° to the horizon
 *   (latitude 55°, equinox), moving down and to the right. Every point of the Sun is lifted by the refraction of
 *   air for its true altitude h (Sæmundsson: R = 1,02′ / tg(h + 10,3/(h + 5,11)), h in degrees), so the Sun seen is
 *   higher and flattened. The scene ends when the Sun seen touches the sea with its lower edge: then its true lower
 *   edge is 0,57° (34′) below the horizon and its true upper edge 0,04° below it; the true place fades in dashed.
 * Plays only while visible; «Повторить» restarts.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

interface Props {
	chapter: 'reflection' | 'refraction';
}
const { chapter } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const mSun = `li-sun-${uid}`;
const gSpot = `li-spot-${uid}`;
const gShore = `li-shore-${uid}`;
const gSky = `li-sky-${uid}`;
const gSea = `li-sea-${uid}`;
const gSet = `li-set-${uid}`;
const cAir = `li-air-${uid}`;
/** strips of the lake reflection: y from 120 to 240 */
const STRIPS = Array.from({ length: 30 }, (_, i) => ({ id: `li-st-${uid}-${i}`, y: 120 + i * 4 }));
---

<IntroFrame data-lightintro>
	{chapter === 'reflection' && (
		<>
		<div class="intro__card" data-scene="sunbeam">
			<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Солнечный день, комната. Свет из окна падает на маленькое зеркальце в руке. Зеркальце чуть поворачивают — и солнечный зайчик быстро бежит по стене и потолку, а кошка следит за ним">
				<defs>
					<mask id={mSun} maskUnits="userSpaceOnUse" x="0" y="0" width="360" height="240">
						<rect x="0" y="0" width="360" height="240" fill="white"></rect>
						<!-- the shadow of the table top -->
						<polygon points="96,176 232,176 297.8,214 161.8,214" fill="black"></polygon>
					</mask>
					<radialGradient id={gSpot}>
						<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.9"></stop>
						<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
					</radialGradient>
				</defs>
				<rect class="li-wall" x="0" y="0" width="360" height="240"></rect>
				<rect class="li-ceil" x="0" y="0" width="360" height="12"></rect>
				<rect class="li-side" x="344" y="12" width="16" height="202"></rect>
				<rect class="li-floor" x="0" y="214" width="360" height="26"></rect>
				<!-- the window in the left wall -->
				<rect class="li-side" x="0" y="12" width="16" height="202"></rect>
				<rect class="li-glass" x="2" y="26" width="12" height="78"></rect>
				<line class="li-frame" x1="8" y1="26" x2="8" y2="104"></line>
				<!-- sunlight: a faint band through the air and bright patches where it falls -->
				<g mask={`url(#${mSun})`}>
					<polygon class="li-band" points="16,26 16,104 206.5,214 341.6,214"></polygon>
				</g>
				<line class="li-patch" x1="140.7" y1="176" x2="232" y2="176"></line>
				<line class="li-patch" x1="297.8" y1="214" x2="341.6" y2="214"></line>
				<line class="li-shade" x1="0" y1="176" x2="0" y2="176" data-mshade></line>
				<!-- the table -->
				<rect class="li-table" x="96" y="176" width="136" height="6" rx="1.5"></rect>
				<rect class="li-table" x="102" y="182" width="6" height="32"></rect>
				<rect class="li-table" x="220" y="182" width="6" height="32"></rect>
				<!-- the cat on the floor, in the sun -->
				<path class="li-cat" d="M 322 214 C 336 214 334 196 322 190 C 312 186 300 192 298 204 C 297 211 304 214 312 214 Z"></path>
				<path class="li-tail" d="M 330 211 C 346 208 348 196 340 190" data-tail></path>
				<g data-cathead>
					<circle class="li-cat" cx="0" cy="0" r="9.5"></circle>
					<path class="li-cat" d="M -8 -4 L -7 -15 L -1 -8 Z M 8 -4 L 7 -15 L 1 -8 Z"></path>
					<circle class="li-cateye" cx="-3.5" cy="-1" r="1.6" data-ceye></circle>
					<circle class="li-cateye" cx="3.5" cy="-1" r="1.6" data-ceye></circle>
				</g>
				<!-- the reflected beam and the sunbeam spot -->
				<polygon class="li-beam" points="" data-beam></polygon>
				<ellipse fill={`url(#${gSpot})`} rx="16" ry="16" data-glow></ellipse>
				<polyline class="li-spot" points="" data-spot></polyline>
				<!-- the arm and the hand with the mirror (turned about the mirror's centre) -->
				<path class="li-sleeve" d="" data-arm></path>
				<g data-mirror>
					<rect class="li-handle" x="-2.5" y="2" width="5" height="18" rx="2"></rect>
					<rect class="li-skin" x="-7" y="12" width="14" height="13" rx="5"></rect>
					<line class="li-mback" x1="-13" y1="1.6" x2="13" y2="1.6"></line>
					<line class="li-mface" x1="-13" y1="0" x2="13" y2="0"></line>
				</g>
			</svg>
			<div class="intro__foot">
				<p>Стоит чуть повернуть зеркальце, и солнечный зайчик убегает далеко по стене: <More term="свет от зеркальца поворачивается вдвое сильнее, чем само зеркальце">Зеркальце повернули на 8° — отражённый свет повернулся на 16°. Так получается потому, что угол отражения всегда равен углу падения. Подробно — в разделе <a href="#закон-отражения-света">«Закон отражения света»</a>.</More>.</p>
				<button type="button" class="intro__again" data-again>Повторить</button>
			</div>
		</div>

		<div class="intro__card" data-scene="lake">
			<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Тихое озеро. Дальний берег с елями, домиком и облаками отражается в воде вверх ногами. Налетает ветер, по воде бежит рябь, и отражение рассыпается на дрожащие кусочки и блики, а потом вода снова успокаивается">
				<defs>
					<linearGradient id={gSky} x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" class="li-sky0"></stop>
						<stop offset="1" class="li-sky1"></stop>
					</linearGradient>
					<g id={gShore}>
						<g class="li-cloud">
							<ellipse cx="150" cy="31" rx="24" ry="7"></ellipse>
							<ellipse cx="140" cy="27" rx="11" ry="7"></ellipse>
							<ellipse cx="158" cy="24" rx="12" ry="9"></ellipse>
							<ellipse cx="300" cy="50" rx="18" ry="5"></ellipse>
							<ellipse cx="306" cy="46" rx="9" ry="6"></ellipse>
						</g>
						<path class="li-hill" d="M -20 120 L -20 104 C 20 92 60 96 100 106 C 140 114 170 90 210 92 C 250 94 290 108 380 100 L 380 120 Z"></path>
						<g data-fir data-x="70">
							<rect class="li-trunk" x="67" y="114" width="6" height="6"></rect>
							<polygon class="li-fir" points="70,46 84,72 77,72 90,96 80,96 96,116 44,116 60,96 50,96 63,72 56,72"></polygon>
						</g>
						<g data-fir data-x="106">
							<g transform="translate(106 120) scale(0.72) translate(-70 -120)">
								<rect class="li-trunk" x="67" y="114" width="6" height="6"></rect>
								<polygon class="li-fir" points="70,46 84,72 77,72 90,96 80,96 96,116 44,116 60,96 50,96 63,72 56,72"></polygon>
							</g>
						</g>
						<rect class="li-chimney" x="252" y="82" width="5" height="10"></rect>
						<rect class="li-house" x="222" y="98" width="40" height="22"></rect>
						<polygon class="li-roof" points="215,99 242,80 269,99"></polygon>
						<rect class="li-window" x="236" y="104" width="11" height="9"></rect>
					</g>
					{STRIPS.map((st) => (
						<clipPath id={st.id} clipPathUnits="userSpaceOnUse">
							<rect x="-30" y={st.y} width="420" height="4.4"></rect>
						</clipPath>
					))}
				</defs>
				<rect x="0" y="0" width="360" height="120" fill={`url(#${gSky})`}></rect>
				<!-- the water mirrors the sky: lighter near the shore, deeper blue nearer to us -->
				<rect x="0" y="0" width="360" height="120" fill={`url(#${gSky})`} transform="matrix(1 0 0 -1 0 240)"></rect>
				<use href={`#${gShore}`}></use>
				<!-- the reflection: the shore turned over about the water line y = 120, cut into thin strips of water -->
				<g data-refl>
					{STRIPS.map((st) => (
						<g clip-path={`url(#${st.id})`}>
							<use href={`#${gShore}`} transform="matrix(1 0 0 -1 0 240)"></use>
						</g>
					))}
				</g>
				<rect class="li-lake" x="0" y="120" width="360" height="120" data-dim></rect>
				<g class="li-glint" data-glints></g>
				<line class="li-shoreline" x1="0" y1="120" x2="360" y2="120"></line>
			</svg>
			<div class="intro__foot">
				<p>Тихая вода отражает берег <More term="вверх ногами, как зеркало">Гладкая вода — плоское зеркало. Каждая точка берега видна в воде на такой же глубине под водой, на какой высоте она над водой. Поэтому верхушки елей в отражении внизу, а отражение такого же размера, как сам берег. Подробно — в разделе <a href="#плоское-зеркало">«Плоское зеркало»</a>.</More>. Подул ветер, и отражение <More term="рассыпалось на блики">Рябь — это множество маленьких участков воды, наклонённых каждый по-своему. Каждый отражает свет по закону отражения, но в свою сторону, и цельной картины не получается. Подробно — в разделе <a href="#зеркальное-и-рассеянное-отражение">«Зеркальное и рассеянное отражение»</a>.</More>.</p>
				<button type="button" class="intro__again" data-again>Повторить</button>
			</div>
		</div>
		</>
	)}
	{chapter === 'refraction' && (
		<>
		<div class="intro__card" data-scene="coin">
			<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Человек смотрит в чашку, монету на дне заслоняет край чашки. В чашку наливают воду — и монета становится видна, хотя её никто не трогал">
				<rect class="li-wall" x="0" y="0" width="360" height="240"></rect>
				<rect class="li-tabletop" x="0" y="202" width="360" height="38"></rect>
				<line class="li-edge" x1="0" y1="202" x2="360" y2="202"></line>
				<!-- the person: head in profile looking right and down -->
				<path class="li-shirt" d="M 14 240 C 16 150 46 112 64 112 C 90 112 104 160 106 240 Z"></path>
				<circle class="li-skin" cx="58" cy="80" r="22"></circle>
				<path class="li-hair" d="M 36 80 C 34 58 52 50 66 56 C 74 59 78 64 79 70 C 70 64 58 64 50 70 C 44 74 42 80 36 80 Z"></path>
				<path class="li-skin" d="M 79 78 L 85 86 L 79 88 Z"></path>
				<path class="li-eye" d="M 72 74 Q 76.5 70.5 80.5 74 Q 76.5 77 72 74 Z"></path>
				<circle class="li-pupil" cx="78" cy="74" r="1.7"></circle>
				<!-- the cup: inner 170–270, rim at 126, bottom at 196 -->
				<path class="li-water" d="" data-water></path>
				<line class="li-surface" x1="170" y1="196" x2="270" y2="196" data-surface></line>
				<g data-coin>
					<rect class="li-coin" x="242" y="193" width="20" height="3" rx="1"></rect>
				</g>
				<path class="li-cup" d="M 164 126 H 170 V 196 H 270 V 126 H 276 V 202 H 164 Z"></path>
				<!-- the line of sight grazing the rim (dry cup) -->
				<path class="li-sight" d="" data-sight></path>
				<!-- the ray from the coin to the eye, its extension and the coin as the eye sees it -->
				<path class="li-ext" d="" data-ext></path>
				<g data-ghost>
					<rect class="li-ghost" x="-10" y="-1.5" width="20" height="3" rx="1"></rect>
				</g>
				<g class="li-ray" data-ray>
					<path class="li-ray__glow" d=""></path>
					<path class="li-ray__core" d=""></path>
					<path class="li-ray__flow" d=""></path>
				</g>
				<!-- the jug, turned about its spout -->
				<path class="li-stream" d="" data-stream></path>
				<g data-jug>
					<path class="li-jug" d="M 0 0 L 10 -6 L 46 -6 Q 52 -6 52 2 L 50 44 Q 49 52 40 52 L 16 52 Q 8 52 7 44 L 5 10 Z"></path>
					<path class="li-jugh" d="M 51 6 C 66 6 68 32 50 36"></path>
				</g>
			</svg>
			<div class="intro__foot">
				<p>Монету на дне чашки заслоняет край. Нальём воды, и монета покажется, <More term="хотя её никто не сдвигал">Лучи от монеты, выходя из воды в воздух, меняют направление и проходят над краем чашки прямо в глаз. Глаз видит монету там, откуда луч как будто пришёл по прямой, — выше, чем она лежит. Это преломление света, подробно — в разделе <a href="#ложка-в-стакане-и-кажущаяся-глубина">«Ложка в стакане и кажущаяся глубина»</a>.</More>.</p>
				<button type="button" class="intro__again" data-again>Повторить</button>
			</div>
		</div>

		<div class="intro__card" data-scene="sunset">
			<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Закат над морем. Солнце опускается к горизонту и у самой воды становится сплюснутым. Когда оно касается моря нижним краем, пунктиром показано, где Солнце на самом деле: уже под горизонтом">
				<defs>
					<linearGradient id={gSet} x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" class="li-dusk0"></stop>
						<stop offset="0.7" class="li-dusk1"></stop>
						<stop offset="1" class="li-dusk2"></stop>
					</linearGradient>
					<linearGradient id={gSea} x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" class="li-sea0"></stop>
						<stop offset="1" class="li-sea1"></stop>
					</linearGradient>
					<radialGradient id={`${gSet}-glow`}>
						<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.55"></stop>
						<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
					</radialGradient>
					<clipPath id={cAir} clipPathUnits="userSpaceOnUse">
						<rect x="0" y="0" width="360" height="150"></rect>
					</clipPath>
				</defs>
				<rect x="0" y="0" width="360" height="150" fill={`url(#${gSet})`}></rect>
				<g clip-path={`url(#${cAir})`}>
					<ellipse fill={`url(#${gSet}-glow)`} rx="60" ry="44" data-glow></ellipse>
					<polygon class="li-sunset" points="" data-sun></polygon>
				</g>
				<rect x="0" y="150" width="360" height="90" fill={`url(#${gSea})`}></rect>
				<g class="li-sparkle" data-glitter></g>
				<path class="li-cape" d="M 0 150 L 0 137 C 18 133 30 136 44 142 C 52 146 60 148 70 150 Z"></path>
				<line class="li-horizon" x1="0" y1="150" x2="360" y2="150"></line>
				<circle class="li-true" r="16" cx="-40" cy="-40" data-true></circle>
			</svg>
			<div class="intro__foot">
				<p>Солнце коснулось моря нижним краем, а на самом деле оно уже <More term="скрылось за горизонтом">Воздух у Земли плотнее, чем выше, и свет в нём идёт чуть медленнее. Луч от Солнца, проходя сквозь воздух наискосок, понемногу меняет направление и изгибается к Земле. Глаз видит Солнце там, откуда луч приходит, — выше, чем оно есть. У горизонта Солнце поднято больше чем на полградуса — чуть больше своего поперечника. Пунктир на рисунке показывает, где оно на самом деле. Это преломление света, подробно — в разделе <a href="#преломление-света">«Преломление света»</a>.</More>. Поэтому же низкое Солнце <More term="кажется сплюснутым">Нижний край Солнца ближе к горизонту, и воздух поднимает его сильнее, чем верхний. Поэтому у самого горизонта Солнце видно примерно на шестую часть ниже, чем в ширину.</More>.</p>
				<button type="button" class="intro__again" data-again>Повторить</button>
			</div>
		</div>
		</>
	)}
</IntroFrame>

<style is:global>
	[data-lightintro] {
		--li-wall: color-mix(in srgb, var(--ig-v) 8%, var(--sl-color-gray-5));
		--li-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--li-wood: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
		--li-cat: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-3));
		--li-sky-top: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-6));
		--li-sky-low: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-gray-4));
		--li-green: color-mix(in oklab, color-mix(in oklch increasing hue, var(--ig-v), var(--ig-vx)) 65%, var(--sl-color-gray-5));
		--li-cloud: color-mix(in srgb, var(--sl-color-gray-2) 55%, var(--li-sky-low));
		--li-glint: var(--sl-color-gray-1);
		--li-dusk-low: color-mix(in srgb, var(--ig-v) 55%, var(--sl-color-gray-5));
		--li-sunfill: color-mix(in srgb, var(--ig-v) 80%, white);
		--li-cape: color-mix(in srgb, var(--ig-vx) 20%, var(--sl-color-gray-6));
	}
	:root[data-theme='light'] [data-lightintro] {
		--li-wall: color-mix(in srgb, var(--ig-v) 6%, var(--sl-color-gray-6));
		--li-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--li-wood: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-5));
		--li-cat: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
		--li-sky-top: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-gray-6));
		--li-sky-low: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-7, #fff));
		--li-green: color-mix(in oklab, color-mix(in oklch increasing hue, var(--ig-v), var(--ig-vx)) 80%, var(--sl-color-gray-3));
		--li-cloud: color-mix(in srgb, var(--sl-color-gray-7, #fff) 85%, var(--li-sky-low));
		--li-glint: var(--sl-color-gray-7, #fff);
		--li-dusk-low: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-7, #fff));
		--li-sunfill: var(--ig-v);
		--li-cape: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-3));
	}
	.li-wall {
		fill: var(--li-wall);
	}
	.li-ceil,
	.li-side {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, var(--li-wall));
	}
	.li-floor {
		fill: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-5));
	}
	.li-glass {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
	}
	.li-frame {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.li-band {
		fill: var(--ig-v);
		opacity: 0.13;
	}
