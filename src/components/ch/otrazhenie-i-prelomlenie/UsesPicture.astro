---
/**
 * Pictures to «Где это встречается» in «Преломление света».
 * Left, a mirage: near hot asphalt the air is hotter and light runs faster in it, so a ray from the sky bends upwards
 *   in the hot layer (a parabola: a refractive index that grows linearly with height bends a ray with a constant
 *   curvature) and reaches the eye from below; the eye sees the sky on the road, as a puddle. The slopes are
 *   exaggerated (in reality they are a fraction of a degree), the caption says so.
 * Right, a magnifier: parallel sunrays traced exactly through a biconvex glass lens (n = 1,5, both radii 140 px,
 *   Snell's law at each surface); they meet near the focus (f ≈ 140 px from the thin-lens formula).
 */
import PicStyles from './PicStyles.astro';

const f1 = (v: number) => v.toFixed(1);
type P = { x: number; y: number };
const uid = Math.random().toString(36).slice(2, 8);
const gHot = `op-hot-${uid}`;

/* ---------- the mirage (screen y down) ---------- */
const ROAD = 200;
const TOP = 160; // top of the hot layer
const VX = 170; // the lowest point of the ray
const VY = 190;
const HW = 90; // half-width of the arc in the hot layer
const s = (2 * (VY - TOP)) / HW; // slope of the straight parts
const EYE = { x: 28, y: TOP - s * (VX - HW - 28) };
const RIGHT = { x: 320, y: TOP - s * (320 - VX - HW) };
const parab = Array.from({ length: 41 }, (_, k) => {
	const x = VX - HW + (2 * HW * k) / 40;
	return { x, y: VY - (VY - TOP) * ((x - VX) / HW) ** 2 };
});
// the light runs from the sky (right) to the eye (left)
const mirageRay = [RIGHT, ...parab.slice().reverse(), EYE].map((p, k) => `${k ? 'L' : 'M'} ${f1(p.x)} ${f1(p.y)}`).join(' ');
const PUDDLE = { x: EYE.x + (ROAD - EYE.y) / s, y: ROAD };
const sight = `M ${f1(EYE.x)} ${f1(EYE.y)} L ${f1(PUDDLE.x)} ${f1(PUDDLE.y)}`;
const eyeRot = (Math.atan2(s, 1) * 180) / Math.PI;

/* ---------- the magnifier ---------- */
const N = 1.5;
const C = { x: 100, y: 120 }; // centre of the lens
const R = 140;
const H = 66; // half-height
const sag = R - Math.sqrt(R * R - H * H);
const T = 2 * sag + 4; // thickness on the axis
const V1 = C.x - T / 2; // left vertex
const V2 = C.x + T / 2;
const K1 = { x: V1 + R, y: C.y }; // centre of the left surface
const K2 = { x: V2 - R, y: C.y };
const xEdge1 = K1.x - Math.sqrt(R * R - H * H);
const xEdge2 = K2.x + Math.sqrt(R * R - H * H);
const arcL = `M ${f1(xEdge1)} ${f1(C.y - H)} A ${R} ${R} 0 0 0 ${f1(xEdge1)} ${f1(C.y + H)}`;
const lens = `${arcL} L ${f1(xEdge2)} ${f1(C.y + H)} A ${R} ${R} 0 0 0 ${f1(xEdge2)} ${f1(C.y - H)} Z`;
/** refract unit direction d at a surface with unit normal nrm (pointing against d), index ratio k = n1/n2 */
const refract = (d: P, nrm: P, k: number): P => {
	const ci = -(d.x * nrm.x + d.y * nrm.y);
	const st2 = k * k * (1 - ci * ci);
	const ct = Math.sqrt(1 - st2);
	return { x: k * d.x + (k * ci - ct) * nrm.x, y: k * d.y + (k * ci - ct) * nrm.y };
};
/** where the ray p + t·d meets the circle (centre k, radius R): the root on the given side of the centre */
const hit = (p: P, d: P, k: P, side: 1 | -1): P => {
	const ox = p.x - k.x;
	const oy = p.y - k.y;
	const b = ox * d.x + oy * d.y;
	const c = ox * ox + oy * oy - R * R;
	const q = Math.sqrt(b * b - c);
	const t1 = -b - q;
	const t2 = -b + q;
	const a = { x: p.x + t1 * d.x, y: p.y + t1 * d.y };
	const bb = { x: p.x + t2 * d.x, y: p.y + t2 * d.y };
	return Math.sign(a.x - k.x) === side ? a : bb;
};
const unit = (v: P): P => {
	const l = Math.hypot(v.x, v.y);
	return { x: v.x / l, y: v.y / l };
};
const X_END = 300;
const lensRays = [-52, -26, 0, 26, 52].map((h) => {
	const p0 = { x: 6, y: C.y + h };
	const d0 = { x: 1, y: 0 };
	const a = hit(p0, d0, K1, -1);
	const d1 = refract(d0, unit({ x: a.x - K1.x, y: a.y - K1.y }), 1 / N);
	const b = hit(a, d1, K2, 1);
	const n2 = unit({ x: K2.x - b.x, y: K2.y - b.y }); // against the ray
	const d2 = refract(d1, n2, N);
	const t = (X_END - b.x) / d2.x;
	const e = { x: b.x + t * d2.x, y: b.y + t * d2.y };
	return { p0, a, b, e };
});
const raysAir = lensRays.map((r) => `M ${f1(r.p0.x)} ${f1(r.p0.y)} L ${f1(r.a.x)} ${f1(r.a.y)} M ${f1(r.b.x)} ${f1(r.b.y)} L ${f1(r.e.x)} ${f1(r.e.y)}`).join(' ');
const raysGlass = lensRays.map((r) => `M ${f1(r.a.x)} ${f1(r.a.y)} L ${f1(r.b.x)} ${f1(r.b.y)}`).join(' ');
// the paraxial focus: where the axial neighbours (± 26 px) cross the axis
const r1 = lensRays[3];
const FX = r1.b.x + ((C.y - r1.b.y) * (r1.e.x - r1.b.x)) / (r1.e.y - r1.b.y);
---

<PicStyles />
<figure class="op-pic not-content">
	<div class="op-pic__grid">
		<svg class="op-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Мираж. У раскалённого асфальта воздух горячее. Луч от неба, опускаясь, в горячем воздухе изгибается вверх и попадает в глаз снизу. Глаз видит небо на дороге, как будто там лужа">
			<defs>
				<linearGradient id={gHot} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" style="stop-color: var(--ig-v); stop-opacity: 0" />
					<stop offset="1" style="stop-color: var(--ig-v); stop-opacity: 0.38" />
				</linearGradient>
			</defs>
			<text class="op-title" x="160" y="22" text-anchor="middle">Мираж</text>
			<rect x="0" y={TOP} width="320" height={ROAD - TOP} fill={`url(#${gHot})`} />
			<rect class="op-road" x="0" y={ROAD} width="320" height={230 - ROAD} />
			<ellipse class="op-puddle" cx={f1(PUDDLE.x)} cy={ROAD + 1} rx="34" ry="3.5" />
			<path class="op-virt" d={sight} />
			<g class="op-ray">
				<path class="op-ray__glow" d={mirageRay} />
				<path class="op-ray__core" d={mirageRay} />
				<path class="op-ray__flow" d={mirageRay} />
			</g>
			<g transform={`translate(${f1(EYE.x)} ${f1(EYE.y)}) rotate(${f1(eyeRot)})`}>
				<path class="op-eye" d="M-12 0 Q0 -10 12 0 Q0 10 -12 0Z" />
				<circle class="op-eye__iris" cx="4" r="4.2" />
				<circle class="op-eye__pupil" cx="5" r="1.9" />
			</g>
			<text x="314" y="100" text-anchor="end">свет от неба</text>
			<text x="160" y="62" text-anchor="middle">прохладный воздух</text>
			<text x="314" y={ROAD - 5} text-anchor="end">горячий воздух</text>
			<text x="314" y="222" text-anchor="end">раскалённый асфальт</text>
			<text class="op-tr" x={f1(PUDDLE.x)} y="222" text-anchor="middle">«лужа»</text>
		</svg>
		<svg class="op-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Лупа. Параллельные солнечные лучи преломляются, входя в стекло и выходя из него, и собираются почти в одной точке за лупой">
			<text class="op-title" x="160" y="22" text-anchor="middle">Лупа</text>
			<line class="op-axis" x1="0" y1={C.y} x2="320" y2={C.y} />
			<path class="op-glass" d={lens} />
			<g class="op-ray">
				<path class="op-ray__glow" d={raysAir} />
				<path class="op-ray__core" d={raysAir} />
			</g>
			<g class="op-ray">
				<path class="op-ray__core op-ray__core--glass" d={raysGlass} />
			</g>
			<circle class="op-spot" cx={f1(FX)} cy={C.y} r="5" />
			<text x="8" y="46">солнечные лучи</text>
			<text x={C.x} y={C.y + H + 22} text-anchor="middle">стекло</text>
			<text x={f1(FX)} y={C.y + 76} text-anchor="middle">лучи собираются</text>
		</svg>
	</div>
	<div class="op-pic__foot">
		<figcaption>
			Мираж: у раскалённого асфальта воздух горячее, и свет в нём идёт быстрее. Луч от неба изгибается вверх и приходит в глаз снизу — глаз видит небо на дороге, как в луже (наклон лучей сильно преувеличен). Лупа: солнечные лучи преломляются, когда входят в стекло и когда выходят из него, и собираются почти в одной точке.
		</figcaption>
	</div>
</figure>

<style is:global>
	.op-road {
		fill: var(--sl-color-gray-5);
	}
	.op-puddle {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
	}
	.op-eye {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-white);
		stroke-width: 1.6;
	}
	.op-eye__iris {
		fill: var(--ig-vx);
	}
	.op-eye__pupil {
		fill: var(--sl-color-black);
	}
	.op-axis {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		stroke-dasharray: 3 5;
	}
	.op-glass {
		fill: color-mix(in srgb, var(--ig-vx) 18%, transparent);
		stroke: var(--op-water-edge);
		stroke-width: 1.8;
	}
	.op-ray__core--glass {
		stroke-width: 2;
		opacity: 0.9;
	}
	.op-spot {
		fill: var(--op-ray);
		filter: drop-shadow(0 0 6px var(--op-ray));
	}
</style>
