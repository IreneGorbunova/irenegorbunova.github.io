---
/** Frame of the explanatory pictures of «Отражение света. Плоское зеркало» and «Преломление света» (panels, caption, «Повторить»). Renders nothing. */
---

<style is:global>
	.op-pic {
		--op-ray: var(--ig-vy);
		--op-a: var(--ig-v);
		--op-b: var(--ig-vx);
		--op-g: hsl(150, 60%, 62%);
		--op-water: color-mix(in srgb, var(--ig-vx) 20%, transparent);
		--op-water-edge: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-white));
		--op-silver: color-mix(in srgb, var(--sl-color-gray-2) 80%, var(--ig-vx));
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .op-pic {
		--op-g: hsl(150, 70%, 30%);
	}
	.op-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.op-pic--one .op-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 30rem;
		margin-inline: auto;
	}
	.op-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.op-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.op-pic .op-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.op-pic .op-math {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 18px;
		fill: var(--sl-color-gray-1);
	}
	.op-pic .op-ta {
		fill: var(--op-a);
		font-weight: 700;
	}
	.op-pic .op-tb {
		fill: var(--op-b);
		font-weight: 700;
	}
	.op-pic .op-tg {
		fill: var(--op-g);
		font-weight: 700;
	}
	.op-pic .op-tr {
		fill: var(--op-ray);
	}
	.op-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.op-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.op-pic__foot figcaption i {
		font-family: var(--ig-font-math);
	}
	.op-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.op-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	/* rays: a glow, a core line and pulses running with the light (period 28 px in air, 28/n in a substance) */
	.op-ray {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.op-ray__glow {
		stroke: var(--op-ray);
		stroke-width: 8;
		opacity: 0.16;
	}
	.op-ray__core {
		stroke: var(--op-ray);
		stroke-width: 2.4;
	}
	.op-ray__flow {
		stroke: color-mix(in srgb, var(--op-ray) 30%, white);
		stroke-width: 3.4;
		stroke-dasharray: 2 26;
		animation: op-flow 1s linear infinite;
	}
	.op-ray--water .op-ray__flow {
		stroke-dasharray: 1.5 19.55;
		animation-name: op-flow-water;
	}
	.op-ray--faint {
		opacity: 0.45;
	}
	@keyframes op-flow {
		to {
			stroke-dashoffset: -28;
		}
	}
	@keyframes op-flow-water {
		to {
			stroke-dashoffset: -21.05;
		}
	}
	.op-virt {
		fill: none;
		stroke: var(--op-ray);
		stroke-width: 1.6;
		stroke-dasharray: 6 5;
	}
	.op-normal {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-dasharray: 7 6;
	}
	.op-arc {
		fill: none;
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.op-arc--a {
		stroke: var(--op-a);
	}
	.op-arc--b {
		stroke: var(--op-b);
	}
	.op-arc--g {
		stroke: var(--op-g);
	}
	.op-face {
		stroke: var(--op-silver);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.op-back {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.op-dot {
		fill: var(--sl-color-gray-1);
	}
	.op-water {
		fill: var(--op-water);
	}
	.op-edge {
		stroke: var(--op-water-edge);
		stroke-width: 2;
	}
	@media (max-width: 40rem) {
		.op-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
