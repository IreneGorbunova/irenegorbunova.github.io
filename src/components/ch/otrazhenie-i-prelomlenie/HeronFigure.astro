---
/**
 * Static figures for the derivation of the law of reflection from the shortest path (Heron).
 * step 1: paths from A to B via different points of the mirror; 2: the point B′ symmetric to B,
 * MB = MB′; 3: the straight line AB′ meets the mirror at O; 4: equal angles at O.
 */
import OrpStyles from './OrpStyles.astro';

interface Props {
	step: 1 | 2 | 3 | 4;
	label: string;
}
const { step, label } = Astro.props;

const W = 520;
const H = 290;
const yM = 170;
const A = { x: 80, y: 50 };
const B = { x: 410, y: 85 };
const B2 = { x: B.x, y: 2 * yM - B.y };
const tO = (yM - A.y) / (B2.y - A.y);
const O = { x: A.x + (B2.x - A.x) * tO, y: yM };
const M = { x: 175, y: yM };
const cand = [140, 330, 380].map((x) => ({ x, y: yM }));
const P = (p: { x: number; y: number }) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
const L = (...pts: { x: number; y: number }[]) => pts.map((p, i) => `${i ? 'L' : 'M'}${P(p)}`).join(' ');
const deg = Math.PI / 180;
// angles of OA and OB from the upward normal at O
const angA = (Math.atan2(O.x - A.x, yM - A.y) * 180) / Math.PI;
const arc = (r: number, from: number, to: number) => {
	// angles measured from the upward normal, positive to the right
	const p0 = { x: O.x + r * Math.sin(from * deg), y: O.y - r * Math.cos(from * deg) };
	const p1 = { x: O.x + r * Math.sin(to * deg), y: O.y - r * Math.cos(to * deg) };
	return `M${P(p0)} A${r} ${r} 0 0 ${to > from ? 1 : 0} ${P(p1)}`;
};
// tick marks for the equal segments MB and MB′
const tick = (p: { x: number; y: number }, q: { x: number; y: number }) => {
	const mx = (p.x + q.x) / 2;
	const my = (p.y + q.y) / 2;
	const l = Math.hypot(q.x - p.x, q.y - p.y);
	const nx = -(q.y - p.y) / l;
	const ny = (q.x - p.x) / l;
	return `M${P({ x: mx - 7 * nx, y: my - 7 * ny })} L${P({ x: mx + 7 * nx, y: my + 7 * ny })}`;
};
const at = (r: number, a: number) => ({ x: O.x + r * Math.sin(a * deg), y: O.y - r * Math.cos(a * deg) });
const phiLabels = [at(50, (-90 - angA) / 2), at(50, (angA + 90) / 2), at(50, (270 - angA) / 2)];
const hatch = Array.from({ length: 40 }, (_, i) => 24 + i * 12).filter((x) => x < W - 20);
---

<OrpStyles />
<figure class="orp orp-heron not-content">
	<svg class="orp__svg" viewBox={`0 0 ${W} ${step === 1 ? 200 : H}`} role="img" aria-label={label}>
		<line class="orp-mirror__face" x1="20" y1={yM} x2={W - 20} y2={yM}></line>
		{hatch.map((x) => <line class="orp-mirror__back" x1={x} y1={yM + 3} x2={x - 9} y2={yM + 13} />)}
		<text class="orp-t orp-t--small" x={W - 22} y={yM - 8} text-anchor="end">зеркало</text>

		{step === 1 && cand.map((C) => <path class="orp-heron__cand" d={L(A, C, B)} />)}
		{step === 1 && <path class="orp-heron__path" d={L(A, O, B)} />}

		{step >= 2 && <line class="orp-mirror__perp" x1={B.x} y1={B.y} x2={B2.x} y2={B2.y} />}
		{step >= 2 && <circle class="orp-heron__v" cx={B2.x} cy={B2.y} r="5" />}
		{step >= 2 && <text class="orp-t orp-t--math" x={B2.x + 12} y={B2.y + 6}>B′</text>}

		{step === 2 && <path class="orp-heron__cand" d={L(A, M, B)} />}
		{step === 2 && <path class="orp-heron__virt" d={L(M, B2)} />}
		{step === 2 && <path class="orp-heron__tick" d={`${tick(M, B)} ${tick(M, B2)}`} />}
		{step === 2 && <circle class="orp-heron__dot" cx={M.x} cy={M.y} r="4.5" />}
		{step === 2 && <text class="orp-t orp-t--math" x={M.x - 6} y={M.y - 12} text-anchor="end">M</text>}

		{step >= 3 && <path class="orp-heron__virt" d={L(O, B2)} />}
		{step >= 3 && <path class="orp-heron__path" d={L(A, O, B)} />}
		{step === 3 && <path class="orp-heron__cand" d={L(A, M, B2)} />}
		{step === 3 && <circle class="orp-heron__dot" cx={M.x} cy={M.y} r="4.5" />}
		{step === 3 && <text class="orp-t orp-t--math" x={M.x - 6} y={M.y - 12} text-anchor="end">M</text>}

		{step === 4 && <line class="orp-normal" x1={O.x} y1={yM} x2={O.x} y2={yM - 125} />}
		{step === 4 && <path class="orp-arc orp-arc--a" d={arc(70, -angA, 0)} />}
		{step === 4 && <path class="orp-arc orp-arc--b" d={arc(70, 0, angA)} />}
		{step === 4 && <text class="orp-t orp-t--a" x={O.x - 22} y={yM - 84} text-anchor="middle">α</text>}
		{step === 4 && <text class="orp-t orp-t--b" x={O.x + 22} y={yM - 84} text-anchor="middle">β</text>}
		{step === 4 && <path class="orp-heron__phi" d={`${arc(34, -90, -angA)} ${arc(34, angA, 90)} ${arc(34, 90, 180 - angA)}`} />}
		{step === 4 && phiLabels.map((p) => <text class="orp-t orp-heron__phit" x={p.x} y={p.y} text-anchor="middle" dominant-baseline="central">φ</text>)}
		{step >= 3 && <circle class="orp-heron__dot" cx={O.x} cy={O.y} r="4.5" />}
		{step >= 3 && <text class="orp-t orp-t--math" x={O.x - 8} y={O.y + 26} text-anchor="end">O</text>}

		<circle class="orp-heron__a" cx={A.x} cy={A.y} r="6" />
		<text class="orp-t orp-t--math" x={A.x - 12} y={A.y - 8} text-anchor="end">A</text>
		<circle class="orp-heron__b" cx={B.x} cy={B.y} r="6" />
		<text class="orp-t orp-t--math" x={B.x + 12} y={B.y - 8}>B</text>
	</svg>
</figure>

<style is:global>
	.orp-heron {
		margin-block: 1rem;
		padding: 0.6rem;
	}
	.orp-heron__cand {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.8;
		stroke-dasharray: 6 5;
	}
	.orp-heron__path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.orp-heron__virt {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-dasharray: 7 6;
	}
	.orp-heron__tick {
		stroke: var(--sl-color-accent);
		stroke-width: 2.4;
	}
	.orp-heron__a {
		fill: var(--ig-vy);
	}
	.orp-heron__b {
		fill: var(--ig-v);
	}
	.orp-heron__v {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 2.4;
	}
	.orp-heron__phi {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2.2;
	}
	.orp-heron__phit {
		fill: var(--sl-color-text-accent);
		font-style: italic;
		font-family: var(--ig-font-math) !important;
	}
	.orp-heron__dot {
		fill: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.orp-heron .orp-t {
			font-size: 20px;
		}
		.orp-heron .orp-t--math {
			font-size: 26px;
		}
	}
</style>
