---
/**
 * Picture to the definitions of the plane mirror and the virtual image, side view. A candle stands in front of a
 * vertical mirror. Two rays from the flame S are reflected by the law of reflection (one of them reaches the eye);
 * the reflected rays diverge, but their backward extensions meet behind the mirror at S′, as far behind the mirror
 * as S is in front of it, on the perpendicular SS′. The image of the candle appears there (dashed): equal in size,
 * virtual. Built step by step; «Повторить» restarts.
 */
import PicStyles from './PicStyles.astro';

const f1 = (v: number) => v.toFixed(1);
const MX = 190; // the mirror's face
const S = { x: 110, y: 112 }; // the flame
const S2 = { x: 2 * MX - S.x, y: S.y }; // its image
const E = { x: 26, y: 46 }; // the eye
const yAt = (p: { x: number; y: number }, q: { x: number; y: number }) => p.y + ((q.y - p.y) * (MX - p.x)) / (q.x - p.x);
const O1 = { x: MX, y: yAt(S2, E) }; // where the ray to the eye is reflected
const O2 = { x: MX, y: 142 };
// the second reflected ray: from O2 away from S′ until x = 40
const END2 = { x: 40, y: O2.y + ((O2.y - S2.y) / (O2.x - S2.x)) * (40 - O2.x) };
const hatch = Array.from({ length: 15 }, (_, k) => 24 + 12 * k);
const eyeAng = (Math.atan2(O1.y - E.y, O1.x - E.x) * 180) / Math.PI;
const data = JSON.stringify({ S, S2, E, O1, O2, END2 });
---

<PicStyles />
<figure class="op-pic op-pic--one not-content" data-op-image data-geo={data}>
	<div class="op-pic__grid">
		<svg class="op-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Свеча стоит перед плоским зеркалом. Лучи от пламени S отражаются от зеркала и расходятся, один попадает в глаз. Продолжения отражённых лучей за зеркало сходятся в точке S штрих — там глаз видит пламя. Изображение свечи мнимое, такого же размера и находится за зеркалом так же далеко, как свеча перед ним">
			<line class="op-table" x1="0" y1="200" x2="320" y2="200"></line>
			<!-- the image of the candle (dashed) -->
			<g class="op-ghost" data-ghost>
				<rect x={S2.x - 7} y="128" width="14" height="72" rx="2"></rect>
				<path d={`M ${S2.x} ${S.y - 12} C ${S2.x + 7} ${S.y - 2} ${S2.x + 6} ${S.y + 9} ${S2.x} ${S.y + 10} C ${S2.x - 6} ${S.y + 9} ${S2.x - 7} ${S.y - 2} ${S2.x} ${S.y - 12} Z`}></path>
			</g>
			<!-- the mirror on its stand -->
			<line class="op-face" x1={MX} y1="16" x2={MX} y2="200"></line>
			{hatch.map((y) => <line class="op-back" x1={MX + 3} y1={y} x2={MX + 12} y2={y - 9} />)}
			<!-- the candle -->
			<rect class="op-candle" x={S.x - 7} y="128" width="14" height="72" rx="2"></rect>
			<line class="op-wick" x1={S.x} y1="128" x2={S.x} y2="122"></line>
			<path class="op-flame" d={`M ${S.x} ${S.y - 12} C ${S.x + 7} ${S.y - 2} ${S.x + 6} ${S.y + 9} ${S.x} ${S.y + 10} C ${S.x - 6} ${S.y + 9} ${S.x - 7} ${S.y - 2} ${S.x} ${S.y - 12} Z`} data-flame></path>
			<!-- the perpendicular SS′ with equal halves -->
			<g data-perp>
				<line class="op-perp" x1={S.x} y1={S.y} x2={S2.x} y2={S2.y}></line>
				<path class="op-tick" d={`M ${(S.x + MX) / 2 - 2} ${S.y - 6} v 12 M ${(S.x + MX) / 2 + 2} ${S.y - 6} v 12 M ${(S2.x + MX) / 2 - 2} ${S.y - 6} v 12 M ${(S2.x + MX) / 2 + 2} ${S.y - 6} v 12`}></path>
				<path class="op-tick" d={`M ${MX - 9} ${S.y} v -9 h 9`}></path>
			</g>
			<!-- the rays and their extensions behind the mirror -->
			<path class="op-virt" d="" data-ext></path>
			<g class="op-ray">
				<path class="op-ray__glow" d="" data-ray></path>
				<path class="op-ray__core" d="" data-ray></path>
				<path class="op-ray__flow" d="" data-ray></path>
			</g>
			<circle class="op-dot" cx={S.x} cy={S.y} r="3"></circle>
			<circle class="op-dot op-dot--v" cx={S2.x} cy={S2.y} r="3.5" data-s2></circle>
			<!-- the eye -->
			<g transform={`translate(${E.x} ${E.y}) rotate(${f1(eyeAng)})`}>
				<path class="op-eye" d="M -13 0 Q 0 -11 13 0 Q 0 11 -13 0 Z"></path>
				<circle class="op-iris" cx="5" r="4.5"></circle>
				<circle class="op-pupil" cx="6" r="2"></circle>
			</g>
			<text class="op-math" x={S.x - 12} y={S.y - 14} text-anchor="end">S</text>
			<text class="op-math" x={S2.x + 12} y={S.y - 14} data-s2l>S′</text>
			<text x={MX} y="12" text-anchor="middle">зеркало</text>
			<text x={S.x} y="218" text-anchor="middle">свеча</text>
			<text x="316" y="218" text-anchor="end" data-s2l>мнимое изображение</text>
		</svg>
	</div>
	<div class="op-pic__foot">
		<figcaption>Отражённые лучи расходятся, но их продолжения за зеркало сходятся в точке <i>S′</i>: там глаз и видит пламя. Изображение свечи мнимое, такого же размера, как свеча, и находится за зеркалом так же далеко, как свеча перед ним.</figcaption>
		<button type="button" class="op-pic__again" data-again>Повторить</button>
	</div>
</figure>

<style is:global>
	.op-table {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.op-candle {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 70%, var(--ig-v));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.op-wick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.op-flame {
		fill: var(--ig-v);
		filter: drop-shadow(0 0 4px var(--ig-v));
		transform-box: fill-box;
		transform-origin: 50% 100%;
	}
	.op-ghost rect,
	.op-ghost path {
		fill: color-mix(in srgb, var(--ig-v) 10%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.op-ghost path {
		stroke: var(--ig-v);
	}
	.op-perp {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 2 4;
	}
	.op-tick {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.op-dot--v {
		fill: var(--op-ray);
	}
	.op-eye {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	:root[data-theme='light'] .op-eye {
		fill: var(--sl-color-gray-7, #fff);
	}
	.op-iris {
		fill: var(--ig-vx);
	}
	.op-pupil {
		fill: var(--sl-color-black);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	type P = { x: number; y: number };
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);
	/** the first fraction t of a polyline */
	const part = (ps: P[], t: number) => {
		const ls = ps.slice(1).map((p, k) => Math.hypot(p.x - ps[k].x, p.y - ps[k].y));
		let left = clamp(t) * ls.reduce((a, b) => a + b, 0);
		let d = `M ${f1(ps[0].x)} ${f1(ps[0].y)}`;
		for (let k = 0; k < ls.length && left > 0; k++) {
			const u = Math.min(1, left / ls[k]);
			d += ` L ${f1(ps[k].x + (ps[k + 1].x - ps[k].x) * u)} ${f1(ps[k].y + (ps[k + 1].y - ps[k].y) * u)}`;
			left -= ls[k];
		}
		return d;
	};
	const span = (a: number, b: number, x: number) => clamp((x - a) / (b - a));

	for (const root of document.querySelectorAll<HTMLElement>('[data-op-image]')) {
		const g = JSON.parse(root.dataset.geo!) as Record<string, P>;
		const rays = [...root.querySelectorAll<SVGPathElement>('[data-ray]')];
		const ext = root.querySelector<SVGPathElement>('[data-ext]')!;
		const ghost = root.querySelector<SVGGElement>('[data-ghost]')!;
		const s2 = root.querySelector<SVGCircleElement>('[data-s2]')!;
		const s2l = [...root.querySelectorAll<SVGTextElement>('[data-s2l]')];
		const perp = root.querySelector<SVGGElement>('[data-perp]')!;
		const flame = root.querySelector<SVGPathElement>('[data-flame]')!;
		scene(root, 7, (x) => {
			const r1 = part([g.S, g.O1, g.E], span(0.02, 0.22, x));
			const r2 = part([g.S, g.O2, g.END2], span(0.24, 0.42, x));
			rays.forEach((p) => p.setAttribute('d', `${r1} ${r2}`));
			const e = span(0.46, 0.64, x);
			ext.setAttribute('d', e > 0 ? `${part([g.O1, g.S2], e)} ${part([g.O2, g.S2], e)}` : '');
			const v = span(0.64, 0.74, x);
			ghost.style.opacity = f2(v);
			s2.style.opacity = f2(v);
			s2l.forEach((t) => (t.style.opacity = f2(v)));
			perp.style.opacity = f2(span(0.78, 0.88, x));
			flame.style.transform = `scale(${f2(1 + 0.05 * Math.sin(x * 7 * 9))}, ${f2(1 + 0.08 * Math.sin(x * 7 * 13))})`;
		});
	}
</script>
