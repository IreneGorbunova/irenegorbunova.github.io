---
/**
 * Two classic effects of refraction at a water surface (n = 1,33), real centimetres.
 * «Ложка в стакане»: where the eye sees each point of the immersed part of a spoon. The apparent
 * point is where two neighbouring rays that reach the eye meet when continued back (exact ray
 * tracing with the law of refraction), so the spoon looks bent upwards at the surface.
 * «Монета в чашке»: the coin hidden by the rim of the cup becomes visible when water is poured in.
 * Each tab has two pictures: the side view and «Как видит глаз» — the perspective picture the eye gets
 * (a pinhole camera at the eye, aimed at the vessel). The scene is three-dimensional: the glass and the
 * cup are cylinders, the spoon also leans sideways (its side view is unchanged). A point under water is
 * seen in the direction of the point of the surface through which its refracted ray reaches the eye
 * (the law of refraction in the vertical plane through the point and the eye). Everything inside the
 * vessel is seen only through its opening: it is clipped by the picture of the rim.
 */
import OrpStyles from './OrpStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const clipS = `orp-ev-s-${uid}`;
const clipC = `orp-ev-c-${uid}`;
---

<OrpStyles />
<figure class="orp orp-water not-content" data-orp-water>
	<div class="orp-tabs">
		<div class="orp-seg" role="group" aria-label="Опыт">
			<button type="button" aria-pressed="true" data-tab="spoon">Ложка в стакане</button>
			<button type="button" aria-pressed="false" data-tab="coin">Монета в чашке</button>
		</div>
	</div>

	<div data-panel="spoon">
		<svg class="orp__svg" role="group" aria-label="Ложка в стакане с водой, вид сбоку">
			<rect class="orp-water__fill" data-fill></rect>
			<line class="orp-water__surface" data-surface></line>
			<path class="orp-water__glass" data-glass></path>
			<g data-true>
				<path class="orp-water__spoon is-true" data-true-handle></path>
				<path class="orp-water__bowl is-true" data-true-bowl></path>
			</g>
			<path class="orp-water__spoon" data-dry-handle></path>
			<path class="orp-water__spoon is-seen" data-seen-handle></path>
			<path class="orp-water__bowl is-seen" data-seen-bowl></path>
			<g class="orp-beam" data-ray>
				<path class="orp-beam__glow"></path><path class="orp-beam__core"></path><path class="orp-beam__flow"></path>
			</g>
			<path class="orp-beam__virt orp-water__sight" data-sight></path>
			<circle class="orp-water__tip" r="4" data-tip></circle>
			<circle class="orp-water__vtip" r="4.5" data-vtip></circle>
			<text class="orp-t orp-t--small" data-tip-label>на самом деле</text>
			<text class="orp-t orp-t--small orp-water__seen-label" data-vtip-label>так кажется</text>
			<g class="orp-grab" data-eye tabindex="0" role="group" aria-label="Глаз. Тяните его или нажимайте стрелки">
				<circle class="orp-grab__hit" r="28"></circle>
				<circle class="orp-grab__ring orp-hint" r="24"></circle>
				<g data-eye-rot>
					<path class="orp-mirror__eyeball" d="M-15 0 Q0 -13 15 0 Q0 13 -15 0Z"></path>
					<circle class="orp-mirror__iris" cx="5" r="5.5"></circle>
					<circle class="orp-mirror__pupil" cx="6" r="2.4"></circle>
				</g>
			</g>
		</svg>
		<div class="orp-ev">
			<svg class="orp__svg orp-ev__svg" viewBox="0 0 400 290" role="img" aria-label="Как видит глаз: стакан с ложкой. Погружённая часть ложки видна выше, чем она есть, и ложка кажется сломанной у поверхности воды" data-ev>
				<defs><clipPath id={clipS}><path data-ev-clip></path></clipPath></defs>
				<path class="orp-ev__body" data-ev-body></path>
				<g clip-path={`url(#${clipS})`}>
					<path class="orp-ev__inside" data-ev-inside></path>
					<path class="orp-ev__bottom" data-ev-bottom></path>
					<path class="orp-water__spoon orp-ev__spoon" data-ev-under></path>
					<path class="orp-water__bowl orp-ev__bowl" data-ev-bowl></path>
					<path class="orp-ev__water" data-ev-water></path>
					<path class="orp-water__spoon orp-ev__spoon" data-ev-mid></path>
				</g>
				<path class="orp-water__spoon is-true orp-ev__true" data-ev-true></path>
				<path class="orp-ev__rim" data-ev-rim></path>
				<path class="orp-water__spoon orp-ev__spoon" data-ev-top></path>
				<text class="orp-ev__title" x="10" y="24">Как видит глаз</text>
			</svg>
		</div>
		<div class="orp-controls">
			<label class="orp-check"><input type="checkbox" checked data-wet /> Вода в стакане</label>
			<label class="orp-check"><input type="checkbox" checked data-show-true /> Где ложка на самом деле</label>
		</div>
		<dl class="orp-stats">
			<div><dt>Глубина кончика ложки</dt><dd data-o-h></dd></div>
			<div class="is-a"><dt>Кажется глазу</dt><dd data-o-hv></dd></div>
		</dl>
		<p class="orp-live" data-live></p>
		<figcaption class="orp-legend">
			Вверху вид сбоку, клетка — <span class="orp-nw">1 см</span>. Тяните глаз. Кажущееся положение каждой точки ложки найдено по закону преломления: туда сходятся продолжения лучей, попавших в глаз от этой точки. Внизу — что видит глаз: ложка наклонена ещё и к нам, поэтому излом виден и ему. Пунктир — где ложка на самом деле.
		</figcaption>
	</div>

	<div data-panel="coin" hidden>
		<svg class="orp__svg" role="group" aria-label="Монета на дне чашки, вид сбоку">
			<rect class="orp-water__fill" data-fill></rect>
			<line class="orp-water__surface" data-surface></line>
			<path class="orp-water__cup" data-cup></path>
			<rect class="orp-water__coin" data-coin></rect>
			<path class="orp-water__coin-seen" data-coin-seen></path>
			<path class="orp-water__blocked" data-blocked></path>
			<path class="orp-water__cross" data-cross></path>
			<g class="orp-beam" data-ray>
				<path class="orp-beam__glow"></path><path class="orp-beam__core"></path><path class="orp-beam__flow"></path>
			</g>
			<path class="orp-beam__virt orp-water__sight" data-sight></path>
			<g class="orp-grab" data-eye tabindex="0" role="group" aria-label="Глаз. Тяните его или нажимайте стрелки">
				<circle class="orp-grab__hit" r="28"></circle>
				<g data-eye-rot>
					<path class="orp-mirror__eyeball" d="M-15 0 Q0 -13 15 0 Q0 13 -15 0Z"></path>
					<circle class="orp-mirror__iris" cx="5" r="5.5"></circle>
					<circle class="orp-mirror__pupil" cx="6" r="2.4"></circle>
				</g>
			</g>
		</svg>
		<div class="orp-ev">
			<svg class="orp__svg orp-ev__svg" viewBox="0 0 400 290" role="img" aria-label="Как видит глаз: чашка сверху и сбоку. Без воды монету заслоняет край чашки. Когда налита вода, дно с монетой кажется приподнятым, и монета становится видна" data-ev>
				<defs><clipPath id={clipC}><path data-ev-clip></path></clipPath></defs>
				<path class="orp-ev__body" data-ev-body></path>
				<g clip-path={`url(#${clipC})`}>
					<path class="orp-ev__inside" data-ev-inside></path>
					<path class="orp-ev__bottom" data-ev-bottom></path>
					<path class="orp-ev__coin" data-ev-coin></path>
					<path class="orp-ev__water" data-ev-water></path>
				</g>
				<path class="orp-ev__coin-true" data-ev-true></path>
				<path class="orp-ev__rim" data-ev-rim></path>
				<text class="orp-ev__title" x="10" y="24">Как видит глаз</text>
			</svg>
		</div>
		<div class="orp-controls">
			<button type="button" class="orp-btn orp-btn--primary" data-pour>Налить воду</button>
			<label class="orp-slider">
				<span>Уровень воды</span>
				<output data-h-out></output>
				<input type="range" min="0" max="5.6" step="0.05" value="0" data-h />
			</label>
		</div>
		<p class="orp-live" data-live></p>
		<figcaption class="orp-legend">
			Вверху вид сбоку, клетка — <span class="orp-nw">1 см</span>, глубина чашки <span class="orp-nw">6 см</span>; внизу то, что видит глаз, пунктир — где монета на самом деле. Сначала глаз не видит монету: её заслоняет край чашки. Предскажите, что будет, если налить воду, — и проверьте.
		</figcaption>
	</div>
</figure>

<style is:global>
	.orp-water {
		--orp-beam: var(--ig-v);
	}
	.orp-water .orp-beam__core {
		stroke-width: 2;
	}
	.orp-water .orp-beam__glow {
		stroke-width: 7;
	}
	.orp-water.is-narrow .orp-t {
		font-size: 27px;
		stroke-width: 6px;
	}
	.orp-water__fill {
		fill: var(--orp-water);
	}
	.orp-water__surface {
		stroke: var(--orp-water-edge);
		stroke-width: 1.8;
	}
	.orp-water__glass,
	.orp-water__cup {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.orp-water__cup {
		fill: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}
	.orp-water__spoon {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.orp-water__bowl {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.orp-water__spoon.is-true,
	.orp-water__bowl.is-true {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-dasharray: 5 5;
	}
	.orp-water__tip {
		fill: var(--sl-color-gray-3);
	}
	.orp-water__vtip {
		fill: var(--ig-surface);
		stroke: var(--ig-v);
		stroke-width: 2.4;
	}
	.orp-water__seen-label {
		fill: var(--ig-v);
	}
	.orp-water__coin {
		fill: var(--ig-v);
		stroke: color-mix(in srgb, var(--ig-v) 60%, black);
		stroke-width: 1;
	}
	.orp-water__coin-seen {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 6;
		stroke-linecap: round;
		opacity: 0.55;
	}
	.orp-water__blocked {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		stroke-dasharray: 4 5;
	}
	.orp-water__cross {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.orp-ev {
		max-width: 27rem;
		margin: 0.75rem auto 0;
	}
	.orp-ev__svg {
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-5);
	}
	.orp-ev__title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-2);
	}
	.orp-ev__body {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.orp-ev__inside {
		fill: var(--sl-color-gray-6);
	}
	.orp-ev__bottom {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 45%, var(--sl-color-gray-6));
	}
	.orp-ev__water {
		fill: var(--orp-water);
		stroke: var(--orp-water-edge);
		stroke-width: 1.5;
	}
	.orp-ev__rim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.orp-water .orp-ev__spoon {
		stroke-width: 7;
	}
	.orp-water .orp-ev__bowl {
		stroke-width: 1.5;
	}
	.orp-water .orp-ev__true {
		fill: none;
		stroke-width: 2;
	}
	.orp-ev__coin {
		fill: var(--ig-v);
		stroke: color-mix(in srgb, var(--ig-v) 60%, black);
		stroke-width: 1;
	}
	.orp-ev__coin-true {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-dasharray: 5 5;
	}
	.orp-water .orp-mirror__eyeball {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	.orp-water .orp-mirror__iris {
		fill: var(--ig-vx);
	}
	.orp-water .orp-mirror__pupil {
		fill: var(--sl-color-black);
	}
</style>

<script>
	import { clamp, pt, add, sub, mul, ang, lineD, setA, draggable, fmt, reduceMotion, ease, type P } from './orp';

	const N = 1.33;
	/**
	 * The point X = (x, h) of the water surface through which the ray from the underwater point p
	 * reaches the eye e: n·sin(angle in water) = sin(angle in air). Monotonic, so bisection.
	 */
	const surfX = (p: P, e: P, h: number) => {
		const d = h - p.y;
		const u = e.y - h;
		let lo = Math.min(p.x, e.x);
		let hi = Math.max(p.x, e.x);
		const f = (x: number) => (N * (x - p.x)) / Math.hypot(x - p.x, d) - (e.x - x) / Math.hypot(e.x - x, u);
		for (let i = 0; i < 70; i++) {
			const mid = (lo + hi) / 2;
			if (f(mid) > 0) hi = mid;
			else lo = mid;
		}
		return (lo + hi) / 2;
	};
	/** Apparent position of p seen from e: two neighbouring rays continued back until they meet. */
	const apparent = (p: P, e: P, h: number) => {
		const x1 = surfX(p, e, h);
		const v = sub(pt(x1, h), e);
		const l = Math.hypot(v.x, v.y);
		const w = pt(-v.y / l, v.x / l);
		const e2 = add(e, mul(w, 0.02));
		const x2 = surfX(p, e2, h);
		const d1 = sub(pt(x1, h), e);
		const d2 = sub(pt(x2, h), e2);
		const den = d1.x * d2.y - d1.y * d2.x;
		const t = ((e2.x - e.x) * d2.y - (e2.y - e.y) * d2.x) / den;
		return { X: pt(x1, h), P: add(e, mul(d1, t)) };
	};

	/* ---- three dimensions: x right, y up, z towards the reader of the side view ---- */
	type V = { x: number; y: number; z: number };
	const v3 = (x: number, y: number, z: number): V => ({ x, y, z });
	const sub3 = (a: V, b: V) => v3(a.x - b.x, a.y - b.y, a.z - b.z);
	const dot3 = (a: V, b: V) => a.x * b.x + a.y * b.y + a.z * b.z;
	const unit3 = (a: V) => {
		const l = Math.hypot(a.x, a.y, a.z) || 1;
		return v3(a.x / l, a.y / l, a.z / l);
	};
	/**
	 * Refraction seen from the eye E for a point Q under a water surface at height h: the ray from Q to E lies in the
	 * vertical plane through Q and E, so the plane problem is solved there. X — the surface point the ray leaves the
	 * water at (the eye sees Q in its direction); A — the apparent point (where neighbouring rays meet).
	 */
	const app3 = (Q: V, E: V, h: number) => {
		const dx = Q.x - E.x;
		const dz = Q.z - E.z;
		const rho = Math.hypot(dx, dz);
		const ux = rho > 1e-9 ? dx / rho : 1;
		const uz = rho > 1e-9 ? dz / rho : 0;
		const r = apparent(pt(rho, Q.y), pt(0, E.y), h);
		return { X: v3(E.x + r.X.x * ux, h, E.z + r.X.x * uz), A: v3(E.x + r.P.x * ux, r.P.y, E.z + r.P.x * uz) };
	};
	/** the way from X up to the eye E passes through the opening of a vessel (rim at height rim, radius R, axis at x = cx)? */
	const throughRim = (X: V, E: V, rim: number, R: number, cx: number) => {
		if (X.y >= rim) return true;
		const t = (rim - X.y) / (E.y - X.y);
		return Math.hypot(X.x + t * (E.x - X.x) - cx, X.z + t * (E.z - X.z)) <= R;
	};
	/** A pinhole camera at the eye E aimed at the point target (both in the plane z = 0): screen coordinates, y down. */
	const camera = (E: V, target: V) => {
		const f = unit3(sub3(target, E));
		const s = f.x < -1e-9 ? -1 : 1;
		const r = v3(0, 0, s);
		const up = v3(-s * f.y, s * f.x, 0);
		return (Q: V) => {
			const v = sub3(Q, E);
			const zc = Math.max(dot3(v, f), 0.05);
			return { p: pt(dot3(v, r) / zc, -dot3(v, up) / zc), front: dot3(v, f) > 0.3 };
		};
	};
	const circle3 = (cx: number, y: number, R: number, n = 64): V[] => Array.from({ length: n }, (_, k) => v3(cx + R * Math.cos((2 * Math.PI * k) / n), y, R * Math.sin((2 * Math.PI * k) / n)));
	/** convex hull (monotone chain) */
	const hull = (ps: P[]) => {
		const a = ps.slice().sort((p, q) => p.x - q.x || p.y - q.y);
		const cr = (o: P, p: P, q: P) => (p.x - o.x) * (q.y - o.y) - (p.y - o.y) * (q.x - o.x);
		const lo: P[] = [];
		for (const p of a) {
			while (lo.length >= 2 && cr(lo[lo.length - 2], lo[lo.length - 1], p) <= 0) lo.pop();
			lo.push(p);
		}
		const hi: P[] = [];
		for (const p of a.reverse()) {
			while (hi.length >= 2 && cr(hi[hi.length - 2], hi[hi.length - 1], p) <= 0) hi.pop();
			hi.push(p);
		}
		return lo.slice(0, -1).concat(hi.slice(0, -1));
	};
	/**
	 * The picture «Как видит глаз» of a cylindrical vessel (axis x = cx, z = 0; inner radius R, outer Ro; rim at yRim,
	 * inner bottom yBot, outer bottom yOut): fits the vessel into the 400 × 290 frame with equal scales on both axes.
	 */
	const eyeFrame = (E: V, cx: number, R: number, Ro: number, yRim: number, yBot: number, yOut: number) => {
		const cam = camera(E, v3(cx, (yRim + yBot) / 2, 0));
		const outer = [...circle3(cx, yRim, Ro), ...circle3(cx, yOut, Ro)].map((q) => cam(q).p);
		const xs = outer.map((p) => p.x);
		const ys = outer.map((p) => p.y);
		const x0 = Math.min(...xs);
		const x1 = Math.max(...xs);
		const y0 = Math.min(...ys);
		const y1 = Math.max(...ys);
		const k = Math.min(300 / (x1 - x0), 205 / (y1 - y0));
		const ox = 200 - (k * (x0 + x1)) / 2;
		const oy = 168 - (k * (y0 + y1)) / 2;
		const scr = (q: V) => {
			const c = cam(q);
			return { p: pt(ox + k * c.p.x, oy + k * c.p.y), front: c.front };
		};
		const S = (q: V) => scr(q).p;
		const poly = (qs: V[]) => (qs.length > 2 ? `${lineD(qs.map(S))} Z` : '');
		return {
			S,
			scr,
			poly,
			body: `${lineD(hull(outer.map((p) => pt(ox + k * p.x, oy + k * p.y))))} Z`,
			rim: poly(circle3(cx, yRim, R)),
			yBot,
		};
	};

	const eyeDrag = (svg: SVGSVGElement, eye: SVGGElement, get: () => P, set: (p: P) => void, toWorld: (p: P) => P, toScreen: (p: P) => P) => {
		draggable(svg, eye, {
			anchor: () => toScreen(get()),
			onMove: (p) => {
				eye.querySelector('.orp-hint')?.classList.remove('orp-hint');
				set(toWorld(p));
			},
		});
		eye.addEventListener('keydown', (e) => {
			const d = { ArrowLeft: pt(-0.5, 0), ArrowRight: pt(0.5, 0), ArrowUp: pt(0, 0.5), ArrowDown: pt(0, -0.5) }[e.key];
			if (!d) return;
			e.preventDefault();
			set(add(get(), d));
		});
	};

	const grid = (svg: SVGSVGElement, sx: (p: P) => P, x0: number, x1: number, y0: number, y1: number) => {
		const NS = 'http://www.w3.org/2000/svg';
		const g = document.createElementNS(NS, 'g');
		g.setAttribute('class', 'orp-mirror__grid');
		const add_ = (a: P, b: P) => {
			const l = document.createElementNS(NS, 'line');
			setA(l, { x1: a.x, y1: a.y, x2: b.x, y2: b.y });
			g.append(l);
		};
		for (let x = Math.ceil(x0); x <= x1; x++) add_(sx(pt(x, y0)), sx(pt(x, y1)));
		for (let y = Math.ceil(y0); y <= y1; y++) add_(sx(pt(x0, y)), sx(pt(x1, y)));
		svg.prepend(g);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-orp-water]')) {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
		tabs.forEach((b) =>
			b.addEventListener('click', () => {
				tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				panels.forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
			}),
		);

		new ResizeObserver(() => root.classList.toggle('is-narrow', root.clientWidth < 560)).observe(root);

		/* ---------------- the spoon ---------------- */
		{
			const P0 = root.querySelector<HTMLElement>('[data-panel="spoon"]')!;
			const q = <T extends Element>(s: string) => P0.querySelector<T>(s)!;
			const svg = q<SVGSVGElement>('svg');
			// world: centimetres, y up, the water surface at y = 0
			const XMIN = -15;
			const XMAX = 11;
			const YMIN = -10;
			const YMAX = 10;
			const S = 26;
			const W = (XMAX - XMIN) * S;
			const H = (YMAX - YMIN) * S;
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			const sx = (p: P) => pt((p.x - XMIN) * S, (YMAX - p.y) * S);
			const wx = (p: P) => pt(p.x / S + XMIN, YMAX - p.y / S);
			const D = (pts: P[]) => lineD(pts.map(sx));
			grid(svg, sx, XMIN, XMAX, YMIN, YMAX);

			const GX = 5; // inner radius of the glass
			const RIM = 2;
			const BOT = -9;
			// The spoon in space. Its tip lies in the vertical plane of the eye (z = 0), so the side view shows the tip
			// exactly; it stands in the far half of the glass, which the eye sees through the opening, and leans a little
			// to the left and much more sideways, towards the reader of the side view: a spoon lying in the plane of the
			// eye would look to the eye straight, only shorter under water.
			const TIP3 = v3(2.4, -8.5, 0);
			const dUp = unit3(v3(-0.1, 1, 0.42)); // along the spoon, upwards
			const wB = unit3(v3(dUp.y, dUp.z - dUp.x, -dUp.y)); // across the bowl: dUp × (1, 0, 1)
			const at3 = (s: number): V => v3(TIP3.x + dUp.x * s, TIP3.y + dUp.y * s, TIP3.z + dUp.z * s);
			const sAt = (y: number) => (y - TIP3.y) / dUp.y;
			const BC3 = at3(1.7); // bowl centre
			const bowl3: V[] = Array.from({ length: 28 }, (_, i) => {
				const t = (i / 28) * 2 * Math.PI;
				const a = 1.7 * Math.cos(t);
				const b = 1.05 * Math.sin(t);
				return v3(BC3.x + dUp.x * a + wB.x * b, BC3.y + dUp.y * a + wB.y * b, BC3.z + dUp.z * a + wB.z * b);
			});
			const line3 = (s0: number, s1: number, n: number) => Array.from({ length: n + 1 }, (_, i) => at3(s0 + ((s1 - s0) * i) / n));
			const handleUnder3 = line3(sAt(0), 3.2, 24); // from the surface down to the bowl
			const handleMid3 = line3(sAt(0), sAt(RIM), 6); // between the surface and the rim
			const handleTop3 = line3(sAt(RIM), sAt(6.5), 30); // above the rim, the top end at 6,5 cm
			const side = (Q: V) => pt(Q.x, Q.y); // the side view shows x and y
			const A = side(at3(sAt(6.5))); // top end of the handle
			const T = side(at3(3.2)); // where the handle meets the bowl
			const TIP = side(TIP3);
			const cross = side(at3(sAt(0))); // where the handle crosses the surface
			const bowl = bowl3.map(side);
			const handleUnder = handleUnder3.map(side);
			const bottom = circle3(0, BOT, GX);

			setA(q('[data-fill]'), { x: sx(pt(-GX, 0)).x, y: sx(pt(0, 0)).y, width: 2 * GX * S, height: -BOT * S });
			setA(q('[data-surface]'), { x1: sx(pt(-GX, 0)).x, y1: sx(pt(0, 0)).y, x2: sx(pt(GX, 0)).x, y2: sx(pt(0, 0)).y });
			q<SVGPathElement>('[data-glass]').setAttribute('d', D([pt(-GX, RIM), pt(-GX, BOT), pt(GX, BOT), pt(GX, RIM)]));
			q<SVGPathElement>('[data-true-handle]').setAttribute('d', D(handleUnder));
			q<SVGPathElement>('[data-true-bowl]').setAttribute('d', `${D(bowl)} Z`);

			const fill = q<SVGRectElement>('[data-fill]');
			const surface = q<SVGLineElement>('[data-surface]');
			const trueG = q<SVGGElement>('[data-true]');
			const dry = q<SVGPathElement>('[data-dry-handle]');
			const seenH = q<SVGPathElement>('[data-seen-handle]');
			const seenB = q<SVGPathElement>('[data-seen-bowl]');
			const ray = Array.from(q('[data-ray]').querySelectorAll('path'));
			const sight = q<SVGPathElement>('[data-sight]');
			const tip = q<SVGCircleElement>('[data-tip]');
			const vtip = q<SVGCircleElement>('[data-vtip]');
			const tipL = q<SVGTextElement>('[data-tip-label]');
			const vtipL = q<SVGTextElement>('[data-vtip-label]');
			const eye = q<SVGGElement>('[data-eye]');
			const eyeRot = q<SVGGElement>('[data-eye-rot]');
			const wet = q<HTMLInputElement>('[data-wet]');
			const showTrue = q<HTMLInputElement>('[data-show-true]');
			const oH = q<HTMLElement>('[data-o-h]');
			const oHv = q<HTMLElement>('[data-o-hv]');
			const live = q<HTMLElement>('[data-live]');
			const ev = q<SVGSVGElement>('[data-ev]');
			const e$ = (s: string) => ev.querySelector<SVGPathElement>(s)!;
			let E = pt(-9, 7);

			// the way from the surface point X to the eye goes through the opening of the glass
			const clear = (X: V) => Math.hypot(X.x, X.z) < GX && throughRim(X, v3(E.x, E.y, 0), RIM, GX, 0);

			const renderEye = (isWet: boolean) => {
				const E3 = v3(E.x, E.y, 0);
				const fr = eyeFrame(E3, 0, GX, GX + 0.25, RIM, BOT, BOT - 0.4);
				const seen = (Q: V) => (isWet && Q.y < 0 ? app3(Q, E3, 0).X : Q);
				const line = (qs: V[]) => lineD(qs.map((Q) => fr.S(seen(Q))));
				e$('[data-ev-clip]').setAttribute('d', fr.rim);
				e$('[data-ev-body]').setAttribute('d', fr.body);
				e$('[data-ev-inside]').setAttribute('d', fr.rim);
				e$('[data-ev-rim]').setAttribute('d', fr.rim);
				e$('[data-ev-bottom]').setAttribute('d', fr.poly(bottom.map(seen)));
				e$('[data-ev-water]').setAttribute('d', isWet ? fr.poly(circle3(0, 0, GX)) : '');
				e$('[data-ev-under]').setAttribute('d', line(handleUnder3));
				e$('[data-ev-bowl]').setAttribute('d', `${line(bowl3)} Z`);
				e$('[data-ev-mid]').setAttribute('d', line(handleMid3));
				const top = handleTop3.map((Q) => fr.scr(Q)).filter((c) => c.front);
				e$('[data-ev-top]').setAttribute('d', top.length > 1 ? lineD(top.map((c) => c.p)) : '');
				e$('[data-ev-true]').setAttribute('d', isWet && showTrue.checked ? `${lineD(handleUnder3.map(fr.S))} ${lineD(bowl3.map(fr.S))} Z` : '');
			};

			const render = () => {
				const isWet = wet.checked;
				fill.style.display = surface.style.display = isWet ? '' : 'none';
				trueG.style.display = isWet && showTrue.checked ? '' : 'none';
				const sTip = sx(TIP);
				setA(tip, { cx: sTip.x, cy: sTip.y });
				setA(tipL, { x: sTip.x - 12, y: sTip.y + 22, 'text-anchor': 'middle' });
				eye.setAttribute('transform', `translate(${sx(E).x.toFixed(1)} ${sx(E).y.toFixed(1)})`);
				oH.textContent = `${fmt(-TIP.y, 1)} см`;
				renderEye(isWet);
				if (!isWet) {
					dry.setAttribute('d', D([A, T]));
					seenH.setAttribute('d', '');
					seenB.setAttribute('d', `${D(bowl)} Z`);
					ray.forEach((p) => p.setAttribute('d', D([TIP, E])));
					sight.setAttribute('d', '');
					vtip.style.display = vtipL.style.display = tip.style.display = tipL.style.display = 'none';
					eyeRot.setAttribute('transform', `rotate(${ang(sub(sx(TIP), sx(E))).toFixed(1)})`);
					oHv.textContent = `${fmt(-TIP.y, 1)} см`;
					live.innerHTML = 'Без воды ложка прямая, и глаз видит её там, где она есть. Включите воду.';
					return;
				}
				tip.style.display = tipL.style.display = showTrue.checked ? '' : 'none';
				dry.setAttribute('d', D([A, cross]));
				const E3 = v3(E.x, E.y, 0);
				const map = (qs: V[]) => {
					const out: P[] = [];
					for (const Q of qs) {
						const r = app3(Q, E3, 0);
						if (clear(r.X)) out.push(pt(r.A.x, r.A.y));
					}
					return out;
				};
				const hs = map(handleUnder3);
				seenH.setAttribute('d', hs.length > 1 ? D(hs) : '');
				const bs = map(bowl3);
				seenB.setAttribute('d', bs.length > 2 ? `${D(bs)} Z` : '');
				const r = apparent(TIP, E, 0);
				const ok = clear(v3(r.X.x, 0, 0));
				vtip.style.display = vtipL.style.display = ok ? '' : 'none';
				if (ok) {
					ray.forEach((p) => p.setAttribute('d', D([TIP, r.X, E])));
					sight.setAttribute('d', D([r.X, r.P]));
					const sv = sx(r.P);
					setA(vtip, { cx: sv.x, cy: sv.y });
					setA(vtipL, { x: sv.x + 12, y: sv.y - 12, 'text-anchor': 'start' });
					eyeRot.setAttribute('transform', `rotate(${ang(sub(sx(r.X), sx(E))).toFixed(1)})`);
					oHv.textContent = `${fmt(-r.P.y, 1)} см`;
					const above = Math.abs(E.x - r.X.x) < 1.2;
					live.innerHTML = above
						? `Глаз смотрит почти сверху. Кончик ложки кажется на глубине ${fmt(-r.P.y, 1)} см, а на самом деле он на ${fmt(-TIP.y, 1)} см: примерно в <b>1,33 раза</b> мельче — во столько раз, каков показатель преломления воды.`
						: `Лучи от погружённой части ложки, выходя из воды, преломляются и <b>отклоняются от перпендикуляра</b>. Глаз продолжает их назад по прямой (пунктир) — и видит ложку <b>выше</b>, чем она есть: ложка как будто сломана у поверхности. Чем более косо смотрит глаз, тем сильнее «излом».`;
				} else {
					ray.forEach((p) => p.setAttribute('d', ''));
					sight.setAttribute('d', '');
					oHv.textContent = '—';
					live.innerHTML = 'Отсюда кончик ложки сквозь поверхность воды не виден: его заслоняет стенка стакана. Поднимите глаз повыше.';
				}
			};
			const setE = (p: P) => {
				E = pt(clamp(p.x, XMIN + 0.8, XMAX - 0.8), clamp(p.y, RIM + 1.2, YMAX - 0.8));
				render();
			};
			eyeDrag(svg, eye, () => E, setE, wx, sx);
			wet.addEventListener('change', render);
			showTrue.addEventListener('change', render);
			render();
		}

		/* ---------------- the coin ---------------- */
		{
			const P1 = root.querySelector<HTMLElement>('[data-panel="coin"]')!;
			const q = <T extends Element>(s: string) => P1.querySelector<T>(s)!;
			const svg = q<SVGSVGElement>('svg');
			const XMIN = -8.5;
			const XMAX = 10;
			const YMIN = -1.5;
			const YMAX = 12;
			const S = 36;
			const W = (XMAX - XMIN) * S;
			const H = (YMAX - YMIN) * S;
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			const sx = (p: P) => pt((p.x - XMIN) * S, (YMAX - p.y) * S);
			const wx = (p: P) => pt(p.x / S + XMIN, YMAX - p.y / S);
			const D = (pts: P[]) => lineD(pts.map(sx));
			grid(svg, sx, XMIN, XMAX, YMIN, YMAX);

			const CUP = 8; // inner width
			const RIM = 6; // inner height
			const WALL = 0.4;
			const C0 = 5.5;
			const C1 = 7.5; // the coin on the bottom
			const CY = 0.2; // its top face
			q<SVGPathElement>('[data-cup]').setAttribute(
				'd',
				`${D([pt(-WALL, RIM), pt(-WALL, -WALL), pt(CUP + WALL, -WALL), pt(CUP + WALL, RIM), pt(CUP, RIM), pt(CUP, 0), pt(0, 0), pt(0, RIM)])} Z`,
			);
			const sc0 = sx(pt(C0, CY));
			setA(q('[data-coin]'), { x: sc0.x, y: sc0.y, width: (C1 - C0) * S, height: CY * S, rx: 2 });
			// in space: the cup is a cylinder around x = 4, the coin a disc of radius 1 on its bottom
			const coinTop = circle3((C0 + C1) / 2, CY, (C1 - C0) / 2, 40);
			const bottom3 = circle3(CUP / 2, 0, CUP / 2);

			const fill = q<SVGRectElement>('[data-fill]');
			const surface = q<SVGLineElement>('[data-surface]');
			const seen = q<SVGPathElement>('[data-coin-seen]');
			const blocked = q<SVGPathElement>('[data-blocked]');
			const crossM = q<SVGPathElement>('[data-cross]');
			const ray = Array.from(q('[data-ray]').querySelectorAll('path'));
			const sight = q<SVGPathElement>('[data-sight]');
			const eye = q<SVGGElement>('[data-eye]');
			const eyeRot = q<SVGGElement>('[data-eye-rot]');
			const hIn = q<HTMLInputElement>('[data-h]');
			const hOut = q<HTMLOutputElement>('[data-h-out]');
			const pour = q<HTMLButtonElement>('[data-pour]');
			const live = q<HTMLElement>('[data-live]');
			const ev = q<SVGSVGElement>('[data-ev]');
			const e$ = (s: string) => ev.querySelector<SVGPathElement>(s)!;
			let E = pt(-6, 10);
			let h = 0;

			/** the way from a coin point to the eye: visible?, the path, where it is blocked */
			const trace = (c: P) => {
				if (h < CY + 0.02) {
					// no water over the coin: a straight line, blocked if it meets the near wall below the rim
					const y0 = c.y + ((E.y - c.y) * (0 - c.x)) / (E.x - c.x);
					return y0 >= RIM ? { ok: true, path: [c, E], X: null as P | null } : { ok: false, path: [c, pt(0, y0)], X: null };
				}
				const xs = surfX(c, E, h);
				const X = pt(xs, h);
				if (xs <= 0) {
					const y0 = c.y + ((h - c.y) * (0 - c.x)) / (xs - c.x);
					return { ok: false, path: [c, pt(0, y0)], X: null };
				}
				const y0 = h + ((E.y - h) * (0 - xs)) / (E.x - xs);
				return y0 >= RIM ? { ok: true, path: [c, X, E], X } : { ok: false, path: [c, X, pt(0, y0)], X };
			};

			const renderEye = () => {
				const E3 = v3(E.x, E.y, 0);
				const fr = eyeFrame(E3, CUP / 2, CUP / 2, CUP / 2 + WALL, RIM, 0, -WALL);
				const under = (Q: V) => (h > 0.02 && Q.y < h ? app3(Q, E3, h).X : Q);
				e$('[data-ev-clip]').setAttribute('d', fr.rim);
				e$('[data-ev-body]').setAttribute('d', fr.body);
				e$('[data-ev-inside]').setAttribute('d', fr.rim);
				e$('[data-ev-rim]').setAttribute('d', fr.rim);
				e$('[data-ev-bottom]').setAttribute('d', fr.poly(bottom3.map(under)));
				e$('[data-ev-coin]').setAttribute('d', fr.poly(coinTop.map(under)));
				e$('[data-ev-water]').setAttribute('d', h > 0.02 ? fr.poly(circle3(CUP / 2, h, CUP / 2)) : '');
				e$('[data-ev-true]').setAttribute('d', fr.poly(coinTop));
			};

			const render = () => {
				hOut.value = `${fmt(h, 1)} см`;
				hIn.value = String(h);
				setA(fill, { x: sx(pt(0, 0)).x, y: sx(pt(0, Math.max(0, h))).y, width: CUP * S, height: Math.max(0, h) * S });
				setA(surface, { x1: sx(pt(0, h)).x, y1: sx(pt(0, h)).y, x2: sx(pt(CUP, h)).x, y2: sx(pt(CUP, h)).y });
				surface.style.display = h > 0.02 ? '' : 'none';
				eye.setAttribute('transform', `translate(${sx(E).x.toFixed(1)} ${sx(E).y.toFixed(1)})`);
				renderEye();

				// which part of the coin is seen, and where it seems to be
				const pts: P[] = [];
				let nVis = 0;
				const K = 20;
				for (let i = 0; i <= K; i++) {
					const c = pt(C0 + ((C1 - C0) * i) / K, CY);
					const t = trace(c);
					if (!t.ok) continue;
					nVis++;
					pts.push(h < CY + 0.02 ? c : apparent(c, E, h).P);
				}
				seen.setAttribute('d', pts.length > 1 && h >= CY + 0.02 ? D(pts) : '');
				const centre = pt((C0 + C1) / 2, CY);
				const far = pt(C1, CY);
				let t = trace(centre);
				let who = centre;
				if (!t.ok && trace(far).ok) {
					t = trace(far);
					who = far;
				}
				if (t.ok) {
					ray.forEach((p) => p.setAttribute('d', D(t.path)));
					blocked.setAttribute('d', '');
					crossM.setAttribute('d', '');
					sight.setAttribute('d', t.X ? D([t.X, apparent(who, E, h).P]) : '');
					eyeRot.setAttribute('transform', `rotate(${ang(sub(sx(t.path[t.path.length - 2]), sx(E))).toFixed(1)})`);
				} else {
					ray.forEach((p) => p.setAttribute('d', ''));
					sight.setAttribute('d', '');
					blocked.setAttribute('d', D(t.path));
					const b = sx(t.path[t.path.length - 1]);
					crossM.setAttribute('d', `M${b.x - 7} ${b.y - 7} L${b.x + 7} ${b.y + 7} M${b.x + 7} ${b.y - 7} L${b.x - 7} ${b.y + 7}`);
					eyeRot.setAttribute('transform', `rotate(${ang(sub(sx(pt(0, RIM)), sx(E))).toFixed(1)})`);
				}
				const all = nVis === K + 1;
				live.innerHTML =
					nVis === 0
						? h < CY + 0.02
							? '<b>Монету не видно:</b> прямая от монеты к глазу упирается в стенку чашки. Что будет, если налить в чашку воду?'
							: '<b>Монету пока не видно:</b> лучи от неё упираются в стенку. Налейте ещё воды.'
						: `<b>${all ? 'Монета видна целиком!' : 'Показался край монеты!'}</b> Лучи от монеты, выходя из воды в воздух, преломляются — отклоняются от перпендикуляра — и проходят над краем чашки прямо в глаз. Глаз видит монету по продолжению лучей (пунктир) — <b>выше</b>, чем она лежит: дно чашки кажется приподнятым.`;
			};

			hIn.addEventListener('input', () => {
				h = Number(hIn.value);
				render();
			});
			let anim = 0;
			pour.addEventListener('click', () => {
				cancelAnimationFrame(anim);
				const from = h >= 5.5 ? 0 : h;
				const to = 5.5;
				if (reduceMotion()) {
					h = to;
					render();
					return;
				}
				const t0 = performance.now();
				const dur = 3000 * ((to - from) / 5.5);
				const frame = (now: number) => {
					const k = Math.min(1, (now - t0) / dur);
					h = from + (to - from) * ease(k);
					render();
					if (k < 1) anim = requestAnimationFrame(frame);
				};
				anim = requestAnimationFrame(frame);
			});
			const setE = (p: P) => {
				E = pt(clamp(p.x, XMIN + 0.8, -1), clamp(p.y, RIM + 0.6, YMAX - 0.8));
				render();
			};
			eyeDrag(svg, eye, () => E, setE, wx, sx);
			render();
		}
	}
</script>
