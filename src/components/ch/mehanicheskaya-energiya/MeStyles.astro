---
/**
 * Colors shared by the new pictures and models of «Работа и энергия» (grade 10), scoped under `.me` (each figure has it
 * next to `g7`). Renders nothing. One color per quantity in the chapter:
 *   energies: potential blue, kinetic gold (a darker gold in the light theme, as TrackLab), internal energy pink
 *   (not the red of the pulling force);
 *   forces as in «Силы в механике»: gravity mg violet, the support N green, friction brown, elasticity blue; the pulling
 *   force F red (as WorkAngleLab); velocity and displacement teal (not the gold of E_к); momentum gray-violet.
 * The work of a force is drawn in the color of that force.
 */
---

<style is:global>
	.me {
		--me-ep: var(--g7-blue);
		--me-ek: var(--g7-gold);
		--me-q: hsl(330, 75%, 70%);
		--me-mg: var(--g7-violet);
		--me-n: var(--g7-green);
		--me-fr: hsl(24, 62%, 56%);
		--me-f: var(--g7-red);
		--me-v: hsl(180, 60%, 52%);
		--me-p: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-3));
	}
	:root[data-theme='light'] .me {
		--me-ek: hsl(46, 92%, 44%);
		--me-fr: hsl(24, 70%, 38%);
		--me-q: hsl(330, 65%, 46%);
		--me-v: hsl(185, 75%, 30%);
	}
	.me .g7__svg .me-s-ep {
		fill: var(--me-ep);
		stroke: var(--me-ep);
	}
	.me .g7__svg .me-s-ek {
		fill: var(--me-ek);
		stroke: var(--me-ek);
	}
	.me .g7__svg .me-s-q {
		fill: var(--me-q);
		stroke: var(--me-q);
	}
	.me .g7__svg .me-s-mg {
		fill: var(--me-mg);
		stroke: var(--me-mg);
	}
	.me .g7__svg .me-s-n {
		fill: var(--me-n);
		stroke: var(--me-n);
	}
	.me .g7__svg .me-s-fr {
		fill: var(--me-fr);
		stroke: var(--me-fr);
	}
	.me .g7__svg .me-s-f {
		fill: var(--me-f);
		stroke: var(--me-f);
	}
	.me .g7__svg .me-s-v {
		fill: var(--me-v);
		stroke: var(--me-v);
	}
	.me .g7__svg .me-s-p {
		fill: var(--me-p);
		stroke: var(--me-p);
	}
	.me .g7__svg .me-s-ink {
		fill: var(--g7-ink);
		stroke: var(--g7-ink);
	}
	/* an arrow: a shaft (stroke) and a head (fill) in the class of its quantity */
	.me .g7__svg .me-shaft {
		fill: none !important;
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.me .g7__svg .me-head {
		stroke: none !important;
	}
	.me .g7__svg text.me-t {
		stroke: none;
		font-size: 13px;
	}
	.me .g7__svg text.me-t.i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 15px;
	}
	.me .g7__svg tspan.me-sub {
		font-style: normal;
		font-family: var(--__sl-font);
	}
	.me .g7__svg .me-halo {
		paint-order: stroke fill;
		stroke: var(--g7-paper) !important;
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.me .g7__read .me-key {
		display: inline-block;
		width: 0.7em;
		height: 0.7em;
		border-radius: 0.15em;
		margin-right: 0.35em;
		vertical-align: baseline;
	}
	.me .g7__svg .me-floor {
		fill: var(--g7-ground);
	}
	.me .g7__svg .me-wood {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.me .g7__svg .me-axis {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.me .g7__svg .me-grid {
		fill: none;
		stroke: var(--g7-faint);
		stroke-width: 0.8;
	}
</style>
