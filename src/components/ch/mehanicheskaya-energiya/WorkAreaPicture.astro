---
/**
 * Picture «Работа как площадь»: the graph of the projection of a force F_x against the coordinate x, 0…0,5 м, with three
 * buttons. The work is the area under the graph:
 *   «Постоянная сила» F = 20 Н: a rectangle, A = 20 · 0,5 = 10 Дж;
 *   «Сила, растягивающая пружину» F = kx, k = 200 Н/м (100 Н at 0,5 м): a triangle, A = 200 · 0,5² / 2 = 25 Дж (the
 *     spring's own force −kx does −25 Дж; the readout and the caption say so);
 *   «Любая сила» a rubber cord that grows stiffer, F = 100x + 400x³ (Н, x in м; 100 Н at 0,5 м): exact area
 *     50 · 0,5² + 100 · 0,5⁴ = 18,75 Дж. Strips of equal width appear, n = 1, 2, 4, 8, 16, 32 (one more step every
 *     1,2 с, then again), each a rectangle with the force at the middle of its strip; their sum is 15,63; 17,97; 18,55;
 *     18,70; 18,74; 18,75 Дж — it comes closer and closer to the area under the curve.
 * Scales: x 520 px per metre, F 1,6 px per newton (the axes are different quantities, so equal scales are not needed).
 */
import G7Styles from '../g7/G7Styles.astro';
import MeStyles from './MeStyles.astro';
---

<G7Styles />
<MeStyles />
<figure class="g7 me wa not-content" data-mewa>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 230" role="img" aria-label="График проекции силы от координаты; работа равна площади под графиком">
			<g data-grid></g>
			<path class="wa__area" data-area></path>
			<g data-strips></g>
			<path class="wa__curve" data-curve></path>
			<path class="me-axis" d="M50 196 H340 M50 196 V18"></path>
			<path class="me-head me-s-ink" d="M346 196 l-8 -3.5 v7 Z M50 12 l-3.5 8 h7 Z"></path>
			<g data-ticks></g>
			<text class="me-t" x="352" y="186" text-anchor="end"><tspan class="i" font-family="var(--ig-font-math)" font-style="italic">x</tspan>, м</text>
			<text class="me-t" x="58" y="16"><tspan font-family="var(--ig-font-math)" font-style="italic">F</tspan><tspan font-family="var(--ig-font-math)" font-style="italic" font-size="11" dy="3">x</tspan><tspan dy="-3">, Н</tspan></text>
			<text class="me-t wa__in me-halo" data-in text-anchor="middle"></text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Какая сила" data-mode>
				<button type="button" class="g7__btn" aria-pressed="true" data-m="0">Постоянная сила</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-m="1">Сила, растягивающая пружину</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-m="2">Любая сила</button>
			</div>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Работа силы на пути от 0 до 0,5&nbsp;м — площадь под графиком её проекции. Сила, растягивающая пружину, совершает работу +25&nbsp;Дж, а сила упругости самой пружины (−<i>kx</i>) — −25&nbsp;Дж. «Любая сила» — жгут, который жёстче при большем растяжении: площадь под кривой считают по полоскам.
	</figcaption>
</figure>

<style is:global>
	.wa .g7__svg .wa__area {
		fill: color-mix(in oklab, var(--me-f) 28%, transparent);
	}
	.wa .g7__svg .wa__curve {
		fill: none;
		stroke: var(--me-f);
		stroke-width: 2.6;
		stroke-linejoin: round;
	}
	.wa .g7__svg .wa__strip {
		fill: color-mix(in oklab, var(--me-ep) 30%, transparent);
		stroke: var(--me-ep);
		stroke-width: 1;
	}
	.wa .g7__svg .wa__in {
		font-size: 15px;
		font-weight: 700;
		fill: var(--g7-ink);
	}
	.wa .g7__svg text.me-t {
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { fmt, loop, segment } from '../g7/kit';
	import { el } from '../g7/kit';

	const X0 = 50;
	const Y0 = 196;
	const KX = 520;
	const KF = 1.6;
	const FORCES = [(x: number) => 20, (x: number) => 200 * x, (x: number) => 100 * x + 400 * x ** 3];
	const EXACT = [10, 25, 18.75];
	const NS = [1, 2, 4, 8, 16, 32];
	const STEP = 1.2; // s per n
	const px = (x: number) => X0 + x * KX;
	const py = (F: number) => Y0 - F * KF;
	for (const root of document.querySelectorAll<HTMLElement>('[data-mewa]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const strips = q<SVGGElement>('[data-strips]');
		const read = q<HTMLUListElement>('[data-read]');
		const label = q<SVGTextElement>('[data-in]');
		// grid and ticks
		const grid = q<SVGGElement>('[data-grid]');
		const ticks = q<SVGGElement>('[data-ticks]');
		for (let i = 1; i <= 5; i++) {
			grid.append(el('path', { class: 'me-grid', d: `M${px(i * 0.1)} ${Y0} V${py(105)}` }));
			ticks.append(el('text', { class: 'me-t t-num', x: px(i * 0.1), y: Y0 + 16, 'text-anchor': 'middle' }, fmt(i * 0.1, 1)));
		}
		for (let F = 20; F <= 100; F += 20) {
			grid.append(el('path', { class: 'me-grid', d: `M${X0} ${py(F)} H${px(0.5)}` }));
			ticks.append(el('text', { class: 'me-t t-num', x: X0 - 6, y: py(F) + 4, 'text-anchor': 'end' }, String(F)));
		}
		ticks.append(el('text', { class: 'me-t t-num', x: X0 - 6, y: Y0 + 4, 'text-anchor': 'end' }, '0'));
		let mode = 0;
		let t = 0;
		let shownN = -1;
		const draw = () => {
			const Fx = FORCES[mode];
			let curve = '';
			let area = `M${px(0)} ${Y0}`;
			for (let i = 0; i <= 100; i++) {
				const x = (0.5 * i) / 100;
				curve += `${i ? 'L' : 'M'}${px(x).toFixed(1)} ${py(Fx(x)).toFixed(1)} `;
				area += ` L${px(x).toFixed(1)} ${py(Fx(x)).toFixed(1)}`;
			}
			area += ` L${px(0.5)} ${Y0} Z`;
			q('[data-curve]').setAttribute('d', curve);
			const rows: [string, string, string?][] = [];
			if (mode < 2) {
				q('[data-area]').setAttribute('d', area);
				strips.replaceChildren();
				shownN = -1;
				label.setAttribute('x', String(mode === 0 ? px(0.25) : px(0.36)));
				label.setAttribute('y', String(mode === 0 ? py(10) + 5 : py(22)));
				label.textContent = `${fmt(EXACT[mode], 0)} Дж`;
				rows.push(mode === 0 ? ['сила', '<i>F</i> = 20 Н'] : ['сила', '<i>F</i> = <i>kx</i>, <i>k</i> = 200 Н/м']);
				if (mode === 1) rows.push(['работа силы упругости пружины', '−25 Дж']);
				rows.push([mode === 0 ? 'площадь прямоугольника' : 'площадь треугольника', `${fmt(EXACT[mode], 0)} Дж`, 'is-key']);
			} else {
				q('[data-area]').setAttribute('d', '');
				const k = Math.floor(t / STEP) % NS.length;
				const n = NS[k];
				const w = 0.5 / n;
				let sum = 0;
				if (n !== shownN) {
					strips.replaceChildren();
					for (let i = 0; i < n; i++) {
						const F = Fx((i + 0.5) * w);
						sum += F * w;
						strips.append(el('rect', { class: 'wa__strip', x: px(i * w).toFixed(2), y: py(F).toFixed(2), width: (w * KX).toFixed(2), height: (F * KF).toFixed(2) }));
					}
					shownN = n;
				} else for (let i = 0; i < n; i++) sum += Fx((i + 0.5) * w) * w;
				label.textContent = '';
				rows.push(['сила', '<i>F</i> = 100<i>x</i> + 400<i>x</i>³']);
				rows.push(['полосок', String(n)]);
				rows.push(['сумма площадей полосок', `${fmt(sum, 2)} Дж`, 'is-warm']);
				rows.push(['площадь под кривой', '18,75 Дж', 'is-key']);
			}
			read.innerHTML = rows.map(([a, b, c]) => `<li${c ? ` class="${c}"` : ''}><span>${a}</span><b>${b}</b></li>`).join('');
		};
		segment(q('[data-mode]'), (b) => {
			mode = Number(b.dataset.m);
			t = 0;
			draw();
			wake();
		});
		const wake = loop(root, (dt) => {
			if (mode !== 2) return false;
			const k0 = Math.floor(t / STEP);
			t = (t + dt) % (STEP * NS.length);
			if (Math.floor(t / STEP) !== k0) draw();
			return true;
		});
		draw();
	}
</script>
