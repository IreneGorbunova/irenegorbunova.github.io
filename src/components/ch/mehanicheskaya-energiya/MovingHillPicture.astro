---
/**
 * Picture «Горка, которая может уехать» (looping), side view, two lanes on the same scale; no friction anywhere. A puck
 * of 1 кг slides at 4 м/с onto a smooth hill whose face is y = 1,2 · (x/2)² м (x from its foot, 0…2 м), then flat at
 * 1,2 м; the puck never reaches the top.
 *   Lane 1, the hill is fixed: the puck rises to υ²/2g = 0,816 м and slides back at 4 м/с.
 *   Lane 2, the hill (3 кг) can slide on the ice: momentum 4 кг·м/с is conserved; at the highest point both move at
 *     u = 4/(1 + 3) = 1 м/с, the kinetic energy is (1 + 3) · 1² / 2 = 2 Дж of the 8 Дж, so the puck rises only to
 *     (8 − 2)/(1 · 9,8) = 0,612 м; after it slides down the hill moves on at 2 м/с and the puck back at 2 м/с
 *     (1 · 2² / 2 + 3 · 2² / 2 = 8 Дж).
 * The motion is computed exactly: with the puck's coordinate x along the hill and the hill's velocity
 * V = (P − m ẋ)/(m + M), the energy gives a motion along x with the mass m(1 + y′² − m/(m + M)) and the potential mgy
 * (lane 1: M → ∞); integrated by RK4 in steps of 1 мс. The bars: the potential energy of the puck (blue), its kinetic
 * energy (gold) and the kinetic energy of the hill (light gold); their sum is 8 Дж at every moment. The dashed line marks
 * the highest point reached. Scale 50 px per metre in both directions (the puck drawn 18 px); the motion is shown
 * 3 times slower than in reality.
 */
import G7Styles from '../g7/G7Styles.astro';
import MeStyles from './MeStyles.astro';

const LANES = [
	{ y: 88, title: 'Горка закреплена' },
	{ y: 184, title: 'Горка может скользить' },
];
---

<G7Styles />
<MeStyles />
<figure class="g7 g7--pic me mh not-content" data-memh>
	<svg class="g7__svg" viewBox="0 0 400 196" role="img" aria-label="Две дорожки на льду. Шайба въезжает на горку: на закреплённую она поднимается выше, на скользящую — ниже, а горка уезжает вперёд">
		{LANES.map((l, i) => (
			<g data-lane={i}>
				<rect class="mh__ice" x="0" y={l.y} width="400" height="10"></rect>
				<text class="me-t mh__title" x="8" y={l.y - 70}>{l.title}</text>
				<path class="mh__hill" data-hill></path>
				<path class="mh__max" data-max></path>
				<text class="me-t me-halo t-num mh__maxt" data-maxt x="8"></text>
				<g data-puck>
					<rect class="mh__puck" x="-9" y="-6" width="18" height="6" rx="2"></rect>
				</g>
				<rect class="mh__frame" x="228" y={l.y - 82} width="164" height="12" rx="2"></rect>
				<rect class="me-s-ep" data-b="p" y={l.y - 82} height="12"></rect>
				<rect class="me-s-ek" data-b="k" y={l.y - 82} height="12"></rect>
				<rect class="mh__hillk" data-b="h" y={l.y - 82} height="12"></rect>
			</g>
		))}
	</svg>
	<figcaption class="g7__caption">
		Шайба 1&nbsp;кг въезжает со скоростью 4&nbsp;м/с на гладкую горку: вверху — закреплённую, внизу — горку 3&nbsp;кг, которая может скользить. Трения нет. Полоски — энергия: <span class="mh__key mh__key--p"></span>потенциальная энергия шайбы, <span class="mh__key mh__key--k"></span>кинетическая энергия шайбы, <span class="mh__key mh__key--h"></span>кинетическая энергия горки; вся полоска — 8&nbsp;Дж. Масштаб 50&nbsp;px на метр, движение в 3 раза медленнее.
	</figcaption>
</figure>

<style is:global>
	.mh > .g7__svg {
		max-width: 34rem;
		margin-inline: auto;
	}
	.mh .g7__svg .mh__ice {
		fill: color-mix(in oklab, var(--g7-sky) 60%, var(--sl-color-gray-4));
	}
	.mh .g7__svg text.me-t {
		font-size: 14px;
	}
	.mh .g7__svg .mh__title {
		font-weight: 600;
		fill: var(--g7-ink);
	}
	.mh .g7__svg .mh__hill {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.mh .g7__svg .mh__puck {
		fill: var(--sl-color-gray-1);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.mh .g7__svg .mh__max {
		fill: none;
		stroke: var(--me-ep);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
	}
	.mh .g7__svg .mh__maxt {
		fill: var(--me-ep);
		font-weight: 700;
	}
	.mh .g7__svg .mh__frame {
		fill: none;
		stroke: var(--g7-line);
	}
	.mh .g7__svg .mh__hillk,
	.mh .mh__key--h {
		fill: color-mix(in oklab, var(--me-ek) 55%, var(--sl-color-gray-3));
		background: color-mix(in oklab, var(--me-ek) 55%, var(--sl-color-gray-3));
	}
	.mh .mh__key {
		display: inline-block;
		width: 0.75em;
		height: 0.75em;
		margin: 0 0.25em 0 0.1em;
		border-radius: 0.15em;
		vertical-align: -0.05em;
	}
	.mh .mh__key--p {
		background: var(--me-ep);
	}
	.mh .mh__key--k {
		background: var(--me-ek);
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';

	const g = 9.8;
	const m = 1;
	const H = 1.2;
	const W = 2;
	const END = 2.4; // the hill's length
	const V0 = 4;
	const E = (m * V0 * V0) / 2;
	const K = 50;
	const X0 = 12; // px of x = 0
	const SLOW = 3;
	const f = (x: number) => (x <= 0 ? 0 : x >= W ? H : H * (x / W) ** 2);
	const fp = (x: number) => (x <= 0 || x >= W ? 0 : (2 * H * x) / (W * W));
	const fpp = (x: number) => (x <= 0 || x >= W ? 0 : (2 * H) / (W * W));
	/** Precomputes a lane: the hill's position X and the puck's position x (from the hill's foot), every 1 мс. */
	const run = (Mh: number | null) => {
		const M = Mh === null ? Infinity : Mh + m;
		const r = m / M;
		const P = m * V0;
		const acc = (x: number, v: number) => {
			const me = m * (1 + fp(x) ** 2 - r);
			return -(m * fp(x) * fpp(x) * v * v + m * g * fp(x)) / me;
		};
		let x = -0.8;
		let v = V0;
		let X = 1.2;
		const dt = 1e-3;
		const out: { X: number; x: number; v: number; V: number }[] = [];
		let back = -1;
		for (let i = 0; i < 20000; i++) {
			const V = Mh === null ? 0 : (P - m * v) / M;
			out.push({ X, x, v, V });
			if (back < 0 && v < 0 && x < -0.05) back = i;
			if (back >= 0 && i > back + 500) break;
			const k1x = v, k1v = acc(x, v);
			const k2x = v + (dt / 2) * k1v, k2v = acc(x + (dt / 2) * k1x, v + (dt / 2) * k1v);
			const k3x = v + (dt / 2) * k2v, k3v = acc(x + (dt / 2) * k2x, v + (dt / 2) * k2v);
			const k4x = v + dt * k3v, k4v = acc(x + dt * k3x, v + dt * k3v);
			x += (dt / 6) * (k1x + 2 * k2x + 2 * k3x + k4x);
			v += (dt / 6) * (k1v + 2 * k2v + 2 * k3v + k4v);
			X += V * dt;
		}
		return { out, M, Mh };
	};
	const lanes = [run(null), run(3)];
	const N = Math.max(...lanes.map((l) => l.out.length));
	const T = (N / 1000) * SLOW + 1.5; // s on the screen, with a pause at the end
	const hillPath = (X: number, gy: number) => {
		let d = `M${(X0 + X * K).toFixed(1)} ${gy}`;
		for (let i = 0; i <= 30; i++) {
			const x = (W * i) / 30;
			d += ` L${(X0 + (X + x) * K).toFixed(1)} ${(gy - f(x) * K).toFixed(1)}`;
		}
		return d + ` L${(X0 + (X + END) * K).toFixed(1)} ${(gy - H * K).toFixed(1)} L${(X0 + (X + END) * K).toFixed(1)} ${gy} Z`;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-memh]')) {
		const L = [0, 1].map((i) => {
			const g0 = root.querySelector<SVGGElement>(`[data-lane="${i}"]`)!;
			const q = <T extends Element>(s: string) => g0.querySelector<T>(s)!;
			return { q, gy: i === 0 ? 88 : 184 };
		});
		const draw = (t: number) => {
			const i = Math.min(N - 1, Math.floor((t / SLOW) * 1000));
			lanes.forEach((ln, k) => {
				const { q, gy } = L[k];
				const s = ln.out[Math.min(ln.out.length - 1, i)];
				q('[data-hill]').setAttribute('d', hillPath(s.X, gy));
				const ang = Math.atan(fp(s.x));
				const px = X0 + (s.X + s.x) * K;
				const py = gy - f(s.x) * K;
				q('[data-puck]').setAttribute('transform', `translate(${px.toFixed(1)} ${py.toFixed(1)}) rotate(${((-ang * 180) / Math.PI).toFixed(1)})`);
				// the highest point so far
				let top = 0;
				let topX = 0;
				for (let j = 0; j <= Math.min(i, ln.out.length - 1); j += 5) {
					const y = f(ln.out[j].x);
					if (y > top) [top, topX] = [y, X0 + (ln.out[j].X + ln.out[j].x) * K];
				}
				const done = i > ln.out.findIndex((o) => o.v < 0) && ln.out.some((o) => o.v < 0);
				q('[data-max]').setAttribute('d', done ? `M58 ${(gy - top * K).toFixed(1)} H${topX.toFixed(1)}` : '');
				const mt = q<SVGTextElement>('[data-maxt]');
				mt.setAttribute('y', (gy - top * K + 4).toFixed(1));
				mt.textContent = done ? `${fmt(top, 2)} м` : '';
				// energies
				const Ep = m * g * f(s.x);
				const vpx = s.V + s.v; // the puck's velocity along x (absolute)
				const vpy = fp(s.x) * s.v;
				const Ek = (m * (vpx * vpx + vpy * vpy)) / 2;
				const Eh = ln.Mh === null ? 0 : (ln.Mh * s.V * s.V) / 2;
				const Wb = 164 / E;
				let x = 228;
				for (const [key, e] of [['p', Ep], ['k', Ek], ['h', Eh]] as [string, number][]) {
					const b = q(`[data-b="${key}"]`);
					b.setAttribute('x', x.toFixed(1));
					b.setAttribute('width', Math.max(0, e * Wb).toFixed(1));
					x += e * Wb;
				}
			});
		};
		let t = 0;
		const wake = loop(root, (dt) => {
			t = (t + dt) % T;
			draw(t);
			return true;
		});
		draw(0);
		wake();
	}
</script>
