---
/**
 * «Одна сила, разная мощность»: two equal sleds on level snow are pulled by equal forces F = 60 Н at α = 60° to the
 * motion; both move at constant speed, the upper one at 1 м/с, the lower one at 2 м/с. The projection of the force on
 * the motion is F·cos α = 30 Н, so the work grows as A = 30 Н · υ·t: after 5 с it is 150 Дж and 300 Дж. The power,
 * N = A/t = F·υ·cos α, stays 30 Вт and 60 Вт all the time: the faster sled gets the same work in half the time.
 *
 * Scales: the snow and the paths 30 px per metre (ticks every metre), the sleds 1 м long; the force 0,8 px per newton
 * (as in WorkAngleLab). Real time: 5 с of motion, then 1,5 с of rest at the end, and again. Who pulls the sleds does
 * not matter here, so only the forces are drawn.
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const K = 30;
const X0 = 40;
const lanes = [
	{ v: 1, base: 96, ty: 22 },
	{ v: 2, base: 184, ty: 124 },
];
---

<G7Styles />
<figure class="g7 g7--pic pwp not-content" data-pwp>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 198" role="img" aria-label="Двое одинаковых санок тянут одинаковыми силами под одним углом. Нижние едут вдвое быстрее, сила совершает работу вдвое быстрее, и её мощность вдвое больше: 60 ватт против 30" data-svg>
			<defs>
				<marker id={`pwp-r-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			{lanes.map((l, i) => (
				<>
					<rect class="pwp__snow" x="0" y={l.base} width="400" height="12" />
					<line class="ink" x1="0" x2="400" y1={l.base} y2={l.base} />
					{Array.from({ length: 12 }, (_, m) => <line class="ln" x1={X0 + m * K} x2={X0 + m * K} y1={l.base} y2={l.base + 5} />)}
					<g data-sled={i}>
						<path class="pwp__runner" d="M-15 13 H11.5 Q16.7 13 16.7 7.9 Q16.7 5.3 14 5.3"></path>
						<path class="pwp__runner" d="M-10.5 13 V4.4 M0 13 V4.4 M9.7 13 V4.4"></path>
						<rect class="pwp__slat" x="-15.8" y="1.8" width="27.3" height="3.5" rx="1"></rect>
						<rect class="pwp__bag" x="-12.3" y="-10.5" width="19.4" height="12.3" rx="3.5"></rect>
						<line class="arrow arrow--red" x1="14" y1="5.3" x2={(14 + 41 * 0.5).toFixed(1)} y2={(5.3 - 41 * 0.866).toFixed(1)} marker-end={`url(#pwp-r-${uid})`}></line>
						<text class="t-i t-red t-halo" x="38" y="-24">F</text>
					</g>
					<text class="pwp__t" x="8" y={l.ty}><tspan class="t-i">υ</tspan>&nbsp;=&nbsp;{l.v}&nbsp;м/с</text>
					<text class="pwp__t t-num" x="392" y={l.ty} text-anchor="end" data-a={i}></text>
				</>
			))}
			<text class="pwp__t t-num" x="8" y={lanes[0].ty + 18} data-t></text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Обе силы одинаковы: 60&nbsp;Н под углом 60° к движению. Нижние санки едут вдвое быстрее, и та же сила за то же время совершает вдвое большую работу. Пути — в масштабе (деления через 1&nbsp;м), время настоящее.
	</figcaption>
</figure>

<style is:global>
	.g7__svg .pwp__t {
		font-size: 14px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .pwp__snow {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-5));
	}
	.g7__svg .pwp__runner {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.g7__svg .pwp__slat {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
	}
	.g7__svg .pwp__bag {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
</style>

<script>
	import { fmt, fmtInt, loop } from '../g7/kit';

	const K = 30;
	const X0 = 40;
	const FC = 30; // F·cos α, Н
	const V = [1, 2];
	const BASE = [96, 184];
	const RUN = 5;
	const HOLD = 1.5;
	for (const root of document.querySelectorAll<HTMLElement>('[data-pwp]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const sleds = [0, 1].map((i) => q<SVGGElement>(`[data-sled="${i}"]`));
		const as = [0, 1].map((i) => q<SVGTextElement>(`[data-a="${i}"]`));
		const clock = q<SVGTextElement>('[data-t]');
		let t = 0;
		const draw = () => {
			const tt = Math.min(t, RUN);
			clock.textContent = `t = ${fmt(tt, 1)} с`;
			sleds.forEach((sl, i) => {
				const x = X0 + V[i] * tt * K;
				sl.setAttribute('transform', `translate(${x.toFixed(1)} ${BASE[i] - 13})`);
				const A = FC * V[i] * tt;
				as[i].textContent = `A = ${fmtInt(A)} Дж,  N = ${fmtInt(FC * V[i])} Вт`;
			});
		};
		loop(root, (dt) => {
			t += dt;
			if (t > RUN + HOLD) t = 0;
			draw();
			return true;
		});
		draw();
	}
</script>
