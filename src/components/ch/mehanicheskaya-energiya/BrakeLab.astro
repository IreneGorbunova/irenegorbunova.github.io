---
/**
 * «Тормозной путь»: a car of mass m (1000…2000 кг) going at υ (20…100 км/ч) brakes from a white line with locked
 * friction μmg (dry asphalt μ = 0,7, wet 0,4, packed snow 0,2; typical values for tyres). By the theorem of kinetic
 * energy the work of friction −μmg·s takes away all of mυ²/2, so s = υ²/(2μg); the mass cancels. The readouts
 * compute E_к, F_тр and s by these formulas.
 *
 * Above: the road to scale, 1,75 px per metre (0…200 м; the longest path, 100 км/ч on snow, is 196,8 м); the car is
 * drawn three times larger than the scale (4,4 м → 23 px) and its front stands at the point reached. Below: the graph
 * of the car's kinetic energy against the path, on the same horizontal scale; the vertical scale is 0…800 кДж
 * (the largest, 2000 кг at 100 км/ч, is 772 кДж). The line is straight: the friction force is constant, so equal
 * pieces of the path take equal portions of the energy. «Пуск» plays the braking with the clock twice as fast as a
 * real one (100 км/ч on snow takes 14,2 с, shown in 7,1 с).
 */
import G7Styles from '../g7/G7Styles.astro';
const X0 = 30;
const PX = 1.75;
const GY0 = 214; // the graph's zero
const GH = 104; // 800 кДж
---

<G7Styles />
<figure class="g7 g7--stack brk not-content" data-brk>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 240" role="img" aria-label="Машина тормозит; ниже график её кинетической энергии в зависимости от пройденного пути" data-svg>
			<rect class="brk__road" data-road x="0" y="22" width="400" height="44"></rect>
			<line class="brk__stop" x1={X0} x2={X0} y1="22" y2="66"></line>
			<line class="brk__gone" data-gone x1={X0} x2={X0} y1="60" y2="60"></line>
			<g data-car>
				<path class="brk__body" d="M0 -3 Q0 -6 -3 -6.5 L-8 -7 L-12 -11.5 Q-13 -12.4 -14.6 -12.4 L-23.6 -12.4 Q-25 -12.4 -26 -11.3 L-30 -7.4 Q-34 -7 -35 -5 L-35 -2 L0 -2 Z"></path>
				<path class="brk__glass" d="M-9 -7 L-12.6 -10.8 Q-13.3 -11.4 -14.4 -11.4 L-18.6 -11.4 L-18.6 -7 Z M-20 -7 L-20 -11.4 L-23.4 -11.4 Q-24.6 -11.4 -25.6 -10.4 L-28.8 -7 Z"></path>
				<circle class="brk__tyre" cx="-7" cy="-2" r="2.8"></circle>
				<circle class="brk__tyre" cx="-28" cy="-2" r="2.8"></circle>
				<rect class="brk__lamp" data-lamp x="-35.4" y="-6" width="1.4" height="1.8"></rect>
			</g>
			<text class="t-small" x={X0 + 4} y="16">0</text>
			{[50, 100, 150, 200].map((m) => (
				<>
					<line class="ln" x1={X0 + m * PX} x2={X0 + m * PX} y1="66" y2="72" />
					<text class="t-small t-num" x={X0 + m * PX} y="82" text-anchor="middle">{m} м</text>
				</>
			))}
			<!-- the graph -->
			<line class="ln" x1={X0} x2={X0 + 200 * PX} y1={GY0} y2={GY0}></line>
			<line class="ln" x1={X0} x2={X0} y1={GY0} y2={GY0 - GH - 6}></line>
			{[200, 400, 600, 800].map((e) => (
				<>
					<line class="ln-dash" x1={X0} x2={X0 + 200 * PX} y1={GY0 - (e / 800) * GH} y2={GY0 - (e / 800) * GH} />
					<text class="t-small t-num" x={X0 - 3} y={GY0 - (e / 800) * GH + 4} text-anchor="end">{e}</text>
				</>
			))}
			<text class="t-small" x={X0 + 4} y={GY0 - GH - 10}>кинетическая энергия, кДж</text>
			<text class="t-small" x={X0 + 200 * PX} y={GY0 + 14} text-anchor="end">путь, м</text>
			<line class="brk__line" data-line></line>
			<line class="brk__done" data-done></line>
			<circle class="brk__dot" data-dot r="4"></circle>
			<text class="t-strong t-num" data-elabel style="font-size:13px"></text>
		</svg>
		<div class="g7__side brk__side">
			<label class="g7__slider">
				<span>Скорость <i>υ</i></span>
				<output data-ov></output>
				<input type="range" min="20" max="100" step="10" value="60" data-v aria-label="Скорость, километры в час" />
			</label>
			<label class="g7__slider">
				<span>Масса <i>m</i></span>
				<output data-om></output>
				<input type="range" min="1000" max="2000" step="250" value="1500" data-m aria-label="Масса машины, килограммы" />
			</label>
			<div class="g7__seg" role="group" aria-label="Дорога" data-roadsel>
				<button type="button" class="g7__btn" aria-pressed="true" data-mu="0.7">Сухой асфальт</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-mu="0.4">Мокрый асфальт</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-mu="0.2">Снег</button>
			</div>
			<button type="button" class="g7__btn g7__btn--go" data-go>Тормозить</button>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Дорога и график — в одном масштабе по горизонтали; машина нарисована втрое крупнее. Коэффициенты трения шин о дорогу — примерные. Время торможения показано вдвое быстрее, чем на самом деле.
	</figcaption>
</figure>

<style is:global>
	.brk__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.brk__side .g7__seg,
	.brk__side .g7__lines {
		grid-column: 1 / -1;
	}
	.brk__side .g7__btn--go {
		grid-column: 1 / -1;
		justify-self: start;
	}
	.g7__svg .brk__road {
		fill: hsl(220, 8%, 34%);
	}
	.g7__svg .brk__road.is-wet {
		fill: hsl(215, 18%, 26%);
	}
	.g7__svg .brk__road.is-snow {
		fill: hsl(212, 30%, 80%);
	}
	:root[data-theme='light'] .g7__svg .brk__road {
		fill: hsl(220, 6%, 56%);
	}
	:root[data-theme='light'] .g7__svg .brk__road.is-wet {
		fill: hsl(215, 16%, 42%);
	}
	:root[data-theme='light'] .g7__svg .brk__road.is-snow {
		fill: hsl(210, 40%, 90%);
	}
	.g7__svg .brk__stop {
		stroke: hsl(0, 0%, 96%);
		stroke-width: 3;
	}
	.g7__svg .brk__gone {
		stroke: var(--g7-gold);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.g7__svg .brk__body {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.g7__svg .brk__glass {
		fill: hsl(205, 40%, 82%);
	}
	.g7__svg .brk__tyre {
		fill: hsl(220, 10%, 14%);
		stroke: hsl(210, 10%, 70%);
		stroke-width: 0.8;
	}
	.g7__svg .brk__lamp {
		fill: hsl(0, 40%, 40%);
	}
	.g7__svg .brk__lamp.is-on {
		fill: hsl(0, 100%, 58%);
	}
	.g7__svg .brk__line {
		stroke: var(--g7-gold);
		stroke-width: 1.5;
		stroke-dasharray: 4 3;
		opacity: 0.8;
	}
	.g7__svg .brk__done {
		stroke: var(--g7-gold);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.g7__svg .brk__dot {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
</style>

<script>
	import { fmt, fmtInt, k, loop, segment, tex } from '../g7/kit';

	const g = 9.8;
	const X0 = 30;
	const PX = 1.75;
	const GY0 = 214;
	const GH = 104;
	const ROADY = 52; // the car's wheels
	const set = (e: Element, a: Record<string, number>) => {
		for (const [n, v] of Object.entries(a)) e.setAttribute(n, v.toFixed(1));
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-brk]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const vIn = q<HTMLInputElement>('[data-v]');
		const mIn = q<HTMLInputElement>('[data-m]');
		const road = q<SVGRectElement>('[data-road]');
		const car = q<SVGGElement>('[data-car]');
		const lamp = q('[data-lamp]');
		const gone = q<SVGLineElement>('[data-gone]');
		const line = q<SVGLineElement>('[data-line]');
		const done = q<SVGLineElement>('[data-done]');
		const dot = q<SVGCircleElement>('[data-dot]');
		const elabel = q<SVGTextElement>('[data-elabel]');
		const lines = q<HTMLOListElement>('[data-lines]');
		let mu = 0.7;
		let x = 0; // м, the path covered
		let running = false;
		const draw = () => {
			const kmh = Number(vIn.value);
			const v = kmh / 3.6;
			const m = Number(mIn.value);
			q('[data-ov]').textContent = `${kmh} км/ч`;
			q('[data-om]').textContent = `${fmtInt(m)} кг`;
			road.classList.toggle('is-wet', mu === 0.4);
			road.classList.toggle('is-snow', mu === 0.2);
			const E0 = (m * v * v) / 2;
			const F = mu * m * g;
			const S = E0 / F;
			const E = Math.max(0, E0 - F * x);
			const front = X0 + x * PX;
			car.setAttribute('transform', `translate(${Math.max(front, 35 + 3).toFixed(1)} ${ROADY}) scale(${(3 * PX * 4.4) / 35})`);
			car.setAttribute('transform', `translate(${front.toFixed(1)} ${ROADY}) scale(${((3 * PX * 4.4) / 35).toFixed(3)})`);
			lamp.classList.toggle('is-on', running || x > 0);
			set(gone, { x2: front });
			const ey = (e: number) => GY0 - (e / 800000) * GH;
			set(line, { x1: X0, y1: ey(E0), x2: X0 + S * PX, y2: GY0 });
			set(done, { x1: X0, y1: ey(E0), x2: front, y2: ey(E) });
			set(dot, { cx: front, cy: ey(E) });
			elabel.textContent = `${fmtInt(E / 1000)} кДж`;
			set(elabel, { x: Math.min(front + 7, 330), y: ey(E) - 7 });
			const t = (s: string) => tex(s);
			lines.innerHTML = [
				k(`E_{\\text{к}} = \\dfrac{m\\upsilon^2}{2} = \\dfrac{${t(fmtInt(m))}\\cdot ${t(fmt(v, 1))}^2}{2} \\approx ${t(fmtInt(E0 / 1000))}~\\text{кДж}`),
				k(`F_{\\text{тр}} = \\mu mg \\approx ${t(fmt(F / 1000, 1))}~\\text{кН}`),
				k(`s = \\dfrac{E_{\\text{к}}}{F_{\\text{тр}}} \\approx ${t(fmt(S, 1))}~\\text{м}`),
			]
				.map((h, i) => `<li${i === 2 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
			return S;
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			const v0 = Number(vIn.value) / 3.6;
			const a = mu * g;
			const S = (v0 * v0) / (2 * a);
			// the time since the line, from the path: x = v0 t − a t²/2
			const tNow = (v0 - Math.sqrt(Math.max(0, v0 * v0 - 2 * a * x))) / a + 2 * dt;
			x = Math.min(S, v0 * tNow - (a * tNow * tNow) / 2);
			if (tNow >= v0 / a) {
				x = S;
				running = false;
			}
			draw();
			return running;
		});
		segment(q('[data-roadsel]'), (b) => {
			mu = Number(b.dataset.mu);
			running = false;
			x = 0;
			draw();
		});
		for (const inp of [vIn, mIn])
			inp.addEventListener('input', () => {
				running = false;
				x = 0;
				draw();
			});
		q('[data-go]').addEventListener('click', () => {
			x = 0;
			running = true;
			wake();
		});
		draw();
	}
</script>
