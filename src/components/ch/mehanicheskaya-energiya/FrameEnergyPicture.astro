---
/**
 * Picture «Энергия зависит от системы отсчёта» (looping): a passenger train passes a platform at 20 м/с (72 км/ч); a
 * suitcase of 20 кг lies on the luggage rack of a car. Relative to the car it is at rest: υ = 0, E_к = 0; relative to
 * the platform υ = 20 м/с, E_к = 20 · 20² / 2 = 4000 Дж = 4 кДж. Two buttons: «С перрона» (the platform stands, the
 * train moves to the right) and «Из вагона» (the car stands, the platform moves to the left). The readout of the
 * chosen system is lit.
 * Scale 20 px per metre (cars 24 м long with 1 м between them, windows every 2 м; lamp posts every 6 м on the
 * platform). The motion is shown 5 times slower than in reality (4 м/с on the screen), so it can be followed.
 */
import G7Styles from '../g7/G7Styles.astro';
import MeStyles from './MeStyles.astro';

const K = 20;
const CAR = 25 * K; // period of the cars, px
const wins = Array.from({ length: 11 }, (_, i) => 30 + i * 40);
// one car drawn from x = 0 to 480 (its own frame); a copy is drawn one period to the left and one to the right
const carPath = (o: number) => `M${o} 44 Q${o} 36 ${o + 8} 36 H${o + 472} Q${o + 480} 36 ${o + 480} 44 V140 H${o} Z`;
const winPath = (o: number) => wins.map((x) => `M${o + x} 56 h28 v32 h-28 Z`).join(' ');
---

<G7Styles />
<MeStyles />
<figure class="g7 me fe not-content" data-mefe>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 190" role="img" aria-label="Поезд проезжает мимо перрона; в вагоне на полке лежит чемодан">
			<rect class="fe__sky" x="0" y="0" width="360" height="150"></rect>
			<g data-train>
				{[-1, 0, 1].map((k) => (
					<g>
						<path class="fe__car" d={carPath(k * CAR)}></path>
						<path class="fe__stripe" d={`M${k * CAR} 100 h480 v5 h-480 Z`}></path>
						<path class="fe__win" d={winPath(k * CAR)}></path>
						<path class="fe__rack" d={wins.map((x) => `M${k * CAR + x} 66 h28`).join(' ')}></path>
						<path class="fe__door" d={`M${k * CAR + 6} 50 h16 v90 h-16 Z M${k * CAR + 458} 50 h16 v90 h-16 Z`}></path>
						<g transform={`translate(${k * CAR + 192} 66)`}>
							<rect class="fe__bag" x="2" y="-12" width="20" height="12" rx="2"></rect>
							<path class="fe__handle" d="M9 -12 v-2.5 h6 v2.5"></path>
						</g>
					</g>
				))}
			</g>
			<g data-plat>
				<rect class="fe__plat" x="-40" y="140" width="840" height="50"></rect>
				<path class="fe__edge" d="M-40 141 H800"></path>
				<g data-posts></g>
			</g>
			<path class="fe__lead" data-lead></path>
			<text class="me-t me-halo fe__tag" data-tag text-anchor="middle">чемодан 20 кг</text>
			<path class="me-shaft me-s-v" data-vs></path><path class="me-head me-s-v" data-vh></path>
			<text class="me-t me-halo me-s-v" data-vt text-anchor="middle"></text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Откуда смотреть" data-view>
				<button type="button" class="g7__btn" aria-pressed="true" data-v="plat">С перрона</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-v="car">Из вагона</button>
			</div>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Чемодан 20&nbsp;кг лежит на полке вагона, поезд идёт со скоростью 20&nbsp;м/с (72&nbsp;км/ч). Движение показано в 5 раз медленнее.
	</figcaption>
</figure>

<style is:global>
	.fe .g7__svg .fe__sky {
		fill: var(--g7-sky);
	}
	.fe .g7__svg .fe__car {
		fill: color-mix(in oklab, var(--g7-green) 55%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.fe .g7__svg .fe__stripe {
		fill: var(--g7-gold);
		opacity: 0.8;
	}
	.fe .g7__svg .fe__win {
		fill: color-mix(in oklab, var(--g7-sky) 60%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.fe .g7__svg .fe__rack {
		stroke: var(--g7-steel-dark);
		stroke-width: 2;
	}
	.fe .g7__svg .fe__door {
		fill: color-mix(in oklab, var(--g7-green) 40%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.fe .g7__svg .fe__bag {
		fill: var(--me-ek);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.fe .g7__svg .fe__handle {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.fe .g7__svg .fe__plat {
		fill: color-mix(in oklab, var(--g7-ground) 70%, var(--sl-color-gray-4));
	}
	.fe .g7__svg .fe__edge {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.fe .g7__svg .fe__post {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 3;
	}
	.fe .g7__svg .fe__lamp {
		fill: var(--g7-gold);
	}
	.fe .g7__svg .fe__bench {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.fe .g7__svg .fe__lead {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.fe .g7__svg .fe__tag {
		fill: var(--g7-ink);
		font-weight: 600;
	}
	.fe .g7__read li.is-off {
		opacity: 0.55;
	}
</style>

<script>
	import { loop, segment, el } from '../g7/kit';
	import { setArrow } from './me';

	const K = 20;
	const CAR = 25 * K;
	const VS = (20 * K) / 5; // px per s on the screen (5 times slower)
	const BAG = 192 + 12; // the suitcase's middle in its car, px
	for (const root of document.querySelectorAll<HTMLElement>('[data-mefe]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const train = q<SVGGElement>('[data-train]');
		const plat = q<SVGGElement>('[data-plat]');
		const posts = q<SVGGElement>('[data-posts]');
		// lamp posts every 6 м and a bench, drawn for 0…760 px (the pattern repeats every 360 px)
		for (let i = 0; i < 7; i++) {
			const x = 10 + i * 6 * K;
			posts.append(el('path', { class: 'fe__post', d: `M${x} 186 V112` }));
			posts.append(el('path', { class: 'fe__lamp', d: `M${x - 7} 112 h14 l-3 -5 h-8 Z` }));
		}
		for (const x of [70, 430]) posts.append(el('path', { class: 'fe__bench', d: `M${x} 168 h40 v4 h-40 Z M${x + 3} 172 h3 v10 h-3 Z M${x + 34} 172 h3 v10 h-3 Z M${x} 158 h40 v4 h-40 Z` }));
		let view = 'plat';
		let t = 0;
		const read = q<HTMLUListElement>('[data-read]');
		const rows = () => {
			read.innerHTML = [
				['plat', 'относительно перрона', '<i>υ</i> = 20 м/с, <i>E</i><sub>к</sub> = 4 кДж'],
				['car', 'относительно вагона', '<i>υ</i> = 0, <i>E</i><sub>к</sub> = 0'],
			]
				.map(([k, a, b]) => `<li class="${k === view ? 'is-key' : 'is-off'}"><span>${a}</span><b>${b}</b></li>`)
				.join('');
		};
		const draw = () => {
			let bagX: number;
			if (view === 'plat') {
				const o = ((VS * t) % CAR) - 180; // the train's shift
				train.setAttribute('transform', `translate(${o.toFixed(1)} 0)`);
				plat.setAttribute('transform', '');
				bagX = BAG + o > 380 ? BAG + o - CAR : BAG + o;
				setArrow(q('[data-vs]'), q('[data-vh]'), 150, 24, 210, 24);
				q('[data-vt]').setAttribute('x', '180');
			} else {
				train.setAttribute('transform', 'translate(-30 0)');
				const o = -((VS * t) % 360);
				plat.setAttribute('transform', `translate(${o.toFixed(1)} 0)`);
				bagX = BAG - 30;
				setArrow(q('[data-vs]'), q('[data-vh]'), 300, 152, 240, 152);
				q('[data-vt]').setAttribute('x', '270');
			}
			q('[data-vt]').setAttribute('y', view === 'plat' ? '16' : '172');
			q('[data-vt]').textContent = view === 'plat' ? 'поезд: 20 м/с' : 'перрон: 20 м/с';
			const tag = q<SVGTextElement>('[data-tag]');
			const on = bagX > 50 && bagX < 310;
			tag.setAttribute('x', bagX.toFixed(1));
			tag.setAttribute('y', '124');
			tag.style.visibility = on ? 'visible' : 'hidden';
			q('[data-lead]').setAttribute('d', on ? `M${bagX.toFixed(1)} 111 V70` : '');
		};
		segment(q('[data-view]'), (b) => {
			view = b.dataset.v!;
			t = 0;
			rows();
			draw();
		});
		const wake = loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		rows();
		draw();
		wake();
	}
</script>
