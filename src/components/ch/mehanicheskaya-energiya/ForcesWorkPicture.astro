---
/**
 * Picture «Работа нескольких сил» (looping): a box of 10 кг is pulled from rest along a level floor by a rope at 30° to
 * the floor with F = 50 Н; μ = 0,2. The support N = mg − F sin 30° = 98 − 25 = 73 Н, friction F_тр = μN = 14,6 Н,
 * a = (F cos 30° − F_тр)/m = (43,30 − 14,6)/10 = 2,870 м/с². Over s = 4 м (t = √(2s/a) = 1,67 с): A_F = Fs cos 30° =
 * 173,2 Дж, A_тр = −F_тр s = −58,4 Дж, A_mg = A_N = 0 (at right angles to the motion), the sum 114,8 Дж; the speed
 * √(2 · 114,8 / 10) = 4,79 м/с, E_к = 114,8 Дж = the sum of the works at every moment. The bars grow with the path.
 * Scales: the floor and the path 60 px per metre (the box 0,5 × 0,4 м, from 40 px), the forces 0,7 px per newton, the bars
 * 0,55 px per joule. Real time; 0,6 с at rest before and 2,5 с at the end.
 * Colors (MeStyles): F red, F_тр brown, mg violet, N green, the displacement teal; works in the color of the force,
 * the sum gray, E_к gold.
 */
import G7Styles from '../g7/G7Styles.astro';
import MeStyles from './MeStyles.astro';

const BARS = [
	{ k: 'f', a: 'F' },
	{ k: 'fr', a: 'тр' },
	{ k: 'mg', a: 'mg' },
	{ k: 'n', a: 'N' },
	{ k: 'ink', a: 'sum' },
	{ k: 'ek', a: 'ek' },
];
---

<G7Styles />
<MeStyles />
<figure class="g7 g7--pic me fw not-content" data-mefw>
	<div class="g7__grid fw__grid">
		<svg class="g7__svg" viewBox="0 0 350 200" role="img" aria-label="Ящик тянут за верёвку под углом 30 градусов к полу; на ящик действуют сила натяжения, сила тяжести, сила реакции опоры и сила трения">
			<rect class="me-floor" x="0" y="130" width="350" height="70"></rect>
			<path class="ln" d="M0 130 H350"></path>
			<path class="fw__rope" data-rope></path>
			<rect class="me-wood" data-box y="106" width="30" height="24" rx="1.5"></rect>
			<path class="ln-dash" data-hor></path>
			<path class="fw__arc" data-arc></path>
			<text class="me-t" data-deg>30°</text>
			<path class="me-shaft me-s-v" data-s="s"></path><path class="me-head me-s-v" data-h="s"></path>
			<path class="me-shaft me-s-n" data-s="n"></path><path class="me-head me-s-n" data-h="n"></path>
			<path class="me-shaft me-s-mg" data-s="mg"></path><path class="me-head me-s-mg" data-h="mg"></path>
			<path class="me-shaft me-s-fr" data-s="fr"></path><path class="me-head me-s-fr" data-h="fr"></path>
			<path class="me-shaft me-s-f" data-s="f"></path><path class="me-head me-s-f" data-h="f"></path>
			<text class="me-t i me-s-f" data-l="f">F</text>
			<text class="me-t i me-s-n" data-l="n">N</text>
			<text class="me-t i me-s-mg" data-l="mg">mg</text>
			<text class="me-t i me-s-fr" data-l="fr">F<tspan class="me-sub" font-size="11" dy="3">тр</tspan></text>
			<text class="me-t me-s-v t-num" data-l="s" text-anchor="middle"></text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 250 200" role="img" aria-label="Столбики работы каждой силы, их суммы и кинетической энергии ящика растут по мере движения">
			<path class="ln" d="M4 125 H246"></path>
			{BARS.map((b, i) => (
				<>
					<rect class={`me-s-${b.k}`} data-bar={i} x={25 + i * 40 - 12} width="24" y="125" height="0"></rect>
					<text class={`me-t t-num me-s-${b.k}`} data-val={i} x={25 + i * 40} text-anchor="middle"></text>
					<text class="me-t i" x={25 + i * 40} y="192" text-anchor="middle" fill="var(--g7-ink)">
						{b.a === 'sum' ? <><tspan font-style="normal">Σ</tspan>A</> : b.a === 'ek' ? <>E<tspan class="me-sub" font-size="11" dy="3">к</tspan></> : <>A<tspan class={b.a === 'тр' ? 'me-sub' : ''} font-size="11" dy="3">{b.a}</tspan></>}
					</text>
				</>
			))}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Ящик 10&nbsp;кг тянут с силой 50&nbsp;Н под углом 30° к полу, коэффициент трения 0,2. Столбики — работа каждой силы на пройденном пути (Дж), их сумма Σ<i>A</i> и кинетическая энергия ящика <i>E</i><sub>к</sub>. Всё в масштабе.
	</figcaption>
</figure>

<style is:global>
	.g7--pic .g7__grid.fw__grid {
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: 0.75rem;
		align-items: end;
	}
	@container (max-width: 36rem) {
		.g7--pic .g7__grid.fw__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.fw .g7__svg .fw__rope {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.fw .g7__svg .fw__arc {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.fw .g7__svg .me-s-ink {
		fill: var(--sl-color-gray-3);
		stroke: none;
	}
	.fw .g7__svg text.me-t {
		stroke: none;
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';
	import { setArrow } from './me';

	const m = 10;
	const g = 9.8;
	const F = 50;
	const AL = (30 * Math.PI) / 180;
	const N = m * g - F * Math.sin(AL);
	const FTR = 0.2 * N;
	const FX = F * Math.cos(AL);
	const A = (FX - FTR) / m;
	const S = 4;
	const T = Math.sqrt((2 * S) / A);
	const PRE = 0.6;
	const HOLD = 2.5;
	const K = 60; // px per м
	const KF = 0.7; // px per Н
	const KB = 0.55; // px per Дж
	const Y0 = 125; // the bars' baseline
	for (const root of document.querySelectorAll<HTMLElement>('[data-mefw]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const arrow = (k: string, x1: number, y1: number, x2: number, y2: number) => setArrow(q(`[data-s="${k}"]`), q(`[data-h="${k}"]`), x1, y1, x2, y2);
		const label = (k: string, x: number, y: number, anchor = 'start') => {
			const t = q<SVGTextElement>(`[data-l="${k}"]`);
			t.setAttribute('x', x.toFixed(1));
			t.setAttribute('y', y.toFixed(1));
			t.setAttribute('text-anchor', anchor);
		};
		const draw = (s: number) => {
			const x0 = 40 + s * K;
			const cx = x0 + 15;
			const cy = 118;
			q('[data-box]').setAttribute('x', x0.toFixed(1));
			const fx = F * KF * Math.cos(AL);
			const fy = F * KF * Math.sin(AL);
			q('[data-rope]').setAttribute('d', `M${(x0 + 30).toFixed(1)} ${(cy - 8.7).toFixed(1)} L${(x0 + 30 + 120 * Math.cos(AL)).toFixed(1)} ${(cy - 8.7 - 120 * Math.sin(AL)).toFixed(1)}`);
			arrow('f', cx, cy, cx + fx, cy - fy);
			arrow('n', cx, cy, cx, cy - N * KF);
			arrow('mg', cx, cy, cx, cy + m * g * KF);
			arrow('fr', cx, 130, cx - FTR * KF, 130);
			q('[data-hor]').setAttribute('d', `M${cx} ${cy} h26`);
			q('[data-arc]').setAttribute('d', `M${(cx + 15).toFixed(1)} ${cy} A15 15 0 0 0 ${(cx + 15 * Math.cos(AL)).toFixed(1)} ${(cy - 15 * Math.sin(AL)).toFixed(1)}`);
			const deg = q<SVGTextElement>('[data-deg]');
			deg.setAttribute('x', (cx + 29).toFixed(1));
			deg.setAttribute('y', (cy + 4).toFixed(1));
			label('f', cx + fx - 12, cy - fy - 6); // above the arrow, clear of the rope that continues it
			label('n', cx + 6, cy - N * KF + 10);
			label('mg', cx + 6, cy + m * g * KF - 2);
			label('fr', cx - 8, 150, 'end');
			if (s > 0.02) arrow('s', 55, 34, cx, 34);
			else arrow('s', 0, 0, 0, 0);
			label('s', (55 + cx) / 2, 24, 'middle');
			q('[data-l="s"]').textContent = `s = ${fmt(s, 1)} м`;
			const works = [FX * s, -FTR * s, 0, 0, (FX - FTR) * s, (FX - FTR) * s];
			works.forEach((w, i) => {
				const h = Math.abs(w) * KB;
				const bar = q(`[data-bar="${i}"]`);
				bar.setAttribute('y', (w >= 0 ? Y0 - h : Y0).toFixed(1));
				bar.setAttribute('height', Math.max(h, 0.01).toFixed(1));
				const v = q<SVGTextElement>(`[data-val="${i}"]`);
				v.setAttribute('y', (w >= 0 ? Y0 - h - 5 : Y0 + h + 15).toFixed(1));
				v.textContent = fmt(w, 0);
			});
		};
		let t = 0;
		const wake = loop(root, (dt) => {
			t = (t + dt) % (PRE + T + HOLD);
			const tt = Math.min(T, Math.max(0, t - PRE));
			draw((A * tt * tt) / 2);
			return true;
		});
		draw(0);
		wake();
	}
</script>
