---
/**
 * Picture «Два пути из A в B» (looping), a top view of a floor: a box of 20 кг is dragged at a constant speed of 1 м/с
 * from A to B, 3 м apart: (1) straight, 3 м; (2) round a bench (1,33 × 0,43 м) on its far side, 1 + 3 + 1 = 5 м. μ = 0,3, so F_тр = μmg =
 * 0,3 · 20 · 9,8 = 58,8 Н against the motion and the pull equals it. The work of friction grows with the path:
 * −58,8 · 3 = −176,4 Дж and −58,8 · 5 = −294,0 Дж. The work of gravity is 0 on both (the floor is level).
 * Scales: 60 px per metre (the box 0,5 м), forces 0,45 px per newton (26 px), the bars 0,2 px per joule. Real time:
 * route 1 in 3 с, a pause of 1 с, route 2 in 5 с, a pause of 2 с.
 * Colors (MeStyles): the pull red, friction brown, the work of friction brown.
 */
import G7Styles from '../g7/G7Styles.astro';
import MeStyles from './MeStyles.astro';
---

<G7Styles />
<MeStyles />
<figure class="g7 me fp not-content" data-mefp>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 200" role="img" aria-label="Вид сверху: ящик тащат из точки A в точку B сначала по прямой, потом в обход; столбики показывают работу силы трения на каждом пути">
			<rect class="me-floor" x="0" y="0" width="262" height="200" rx="6"></rect>
			<path class="fp__route" d="M50 150 H230"></path>
			<path class="fp__route fp__route--2" d="M50 150 V90 H230 V150"></path>
			<circle class="fp__pt" cx="50" cy="150" r="3"></circle>
			<circle class="fp__pt" cx="230" cy="150" r="3"></circle>
			<text class="me-t fp__name" x="50" y="188" text-anchor="middle">A</text>
			<text class="me-t fp__name" x="230" y="188" text-anchor="middle">B</text>
			<circle class="fp__num" cx="140" cy="176" r="9"></circle>
			<text class="me-t fp__numt" x="140" y="180.5" text-anchor="middle">1</text>
			<rect class="fp__bench" x="100" y="107" width="80" height="26" rx="2"></rect>
			<path class="fp__slat" d="M100 115.7 H180 M100 124.3 H180"></path>
			<circle class="fp__num" cx="76" cy="120" r="8.5"></circle>
			<text class="me-t fp__numt" x="76" y="124.5" text-anchor="middle">2</text>
			<rect class="me-wood" data-box width="30" height="30" rx="2"></rect>
			<path class="fp__x" data-x></path>
			<path class="me-shaft me-s-fr" data-s="fr"></path><path class="me-head me-s-fr" data-h="fr"></path>
			<path class="me-shaft me-s-f" data-s="f"></path><path class="me-head me-s-f" data-h="f"></path>
			<path class="ln" d="M272 40 H336"></path>
			<rect class="me-s-fr" data-bar="0" x="280" y="40" width="20" height="0"></rect>
			<rect class="me-s-fr" data-bar="1" x="310" y="40" width="20" height="0"></rect>
			<text class="me-t fp__numt" x="290" y="32" text-anchor="middle">1</text>
			<text class="me-t fp__numt" x="320" y="32" text-anchor="middle">2</text>
			<text class="me-t t-num me-s-fr" data-v="0" x="290" text-anchor="middle"></text>
			<text class="me-t t-num me-s-fr" data-v="1" x="320" text-anchor="middle"></text>
		</svg>
		<div class="g7__side">
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Вид сверху. Ящик 20&nbsp;кг равномерно тащат из A в B по прямой (путь 1, 3&nbsp;м) и в обход скамейки (путь 2, 5&nbsp;м), коэффициент трения 0,3. Красная стрелка — сила, с которой тянут ящик, коричневая — сила трения; столбики — работа силы трения (Дж). Масштаб 60&nbsp;px на метр.
	</figcaption>
</figure>

<style is:global>
	.fp .g7__svg .fp__route {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
		stroke-dasharray: 6 4;
		opacity: 0.8;
	}
	.fp .g7__svg .fp__pt {
		fill: var(--g7-ink);
	}
	.fp .g7__svg .fp__name {
		font-weight: 700;
		fill: var(--g7-ink);
	}
	.fp .g7__svg .fp__num {
		fill: var(--g7-paper);
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	.fp .g7__svg .fp__numt {
		font-weight: 700;
		fill: var(--g7-ink);
	}
	.fp .g7__svg .fp__bench {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.fp .g7__svg .fp__slat {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.fp .g7__svg .fp__x {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		opacity: 0.5;
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';
	import { setArrow } from './me';

	const K = 60;
	const FTR = 0.3 * 20 * 9.8; // 58,8 Н
	const KF = 0.45;
	const KB = 0.2;
	const R1: [number, number][] = [[50, 150], [230, 150]];
	const R2: [number, number][] = [[50, 150], [50, 90], [230, 90], [230, 150]];
	const T1 = 3;
	const T2 = 5;
	const CYCLE = T1 + 1 + T2 + 2;
	/** Where the box is after `d` м along a route, and the direction of motion. */
	const along = (r: [number, number][], d: number) => {
		let left = d * K;
		for (let i = 0; i < r.length - 1; i++) {
			const [x0, y0] = r[i];
			const [x1, y1] = r[i + 1];
			const L = Math.hypot(x1 - x0, y1 - y0);
			if (left <= L || i === r.length - 2) {
				const k = Math.min(1, left / L);
				return { x: x0 + (x1 - x0) * k, y: y0 + (y1 - y0) * k, ux: (x1 - x0) / L, uy: (y1 - y0) / L };
			}
			left -= L;
		}
		return { x: r[0][0], y: r[0][1], ux: 1, uy: 0 };
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-mefp]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const read = q<HTMLUListElement>('[data-read]');
		const draw = (t: number) => {
			const s1 = Math.min(T1, t);
			const s2 = Math.min(T2, Math.max(0, t - T1 - 1));
			const on2 = t > T1 + 1;
			const p = on2 ? along(R2, s2) : along(R1, s1);
			const moving = on2 ? s2 < T2 : s1 < T1;
			q('[data-box]').setAttribute('x', (p.x - 15).toFixed(1));
			q('[data-box]').setAttribute('y', (p.y - 15).toFixed(1));
			q('[data-x]').setAttribute('d', `M${p.x - 15} ${p.y - 15} l30 30 M${p.x + 15} ${p.y - 15} l-30 30`);
			const L = FTR * KF;
			if (moving && t > 0) {
				setArrow(q('[data-s="f"]'), q('[data-h="f"]'), p.x, p.y, p.x + p.ux * L, p.y + p.uy * L);
				setArrow(q('[data-s="fr"]'), q('[data-h="fr"]'), p.x, p.y, p.x - p.ux * L, p.y - p.uy * L);
			} else {
				setArrow(q('[data-s="f"]'), q('[data-h="f"]'), 0, 0, 0, 0);
				setArrow(q('[data-s="fr"]'), q('[data-h="fr"]'), 0, 0, 0, 0);
			}
			// no letters at the arrows: they would cross the routes or the bench; the caption names the two colors
			const works = [-FTR * s1, -FTR * s2];
			works.forEach((w, i) => {
				const h = -w * KB;
				q(`[data-bar="${i}"]`).setAttribute('height', h.toFixed(1));
				const v = q<SVGTextElement>(`[data-v="${i}"]`);
				v.setAttribute('y', (40 + h + 15).toFixed(1));
				v.textContent = i === 1 && !on2 ? '' : fmt(w, 0);
			});
			read.innerHTML = [
				['путь 1', `<i>s</i> = ${fmt(s1, 1)} м, <i>A</i><sub>тр</sub> = ${fmt(-FTR * s1, 1)} Дж`, on2 ? '' : 'is-key'],
				['путь 2', `<i>s</i> = ${fmt(s2, 1)} м, <i>A</i><sub>тр</sub> = ${fmt(-FTR * s2, 1)} Дж`, on2 ? 'is-key' : ''],
				['работа силы тяжести', '0 на обоих путях', ''],
			]
				.map(([a, b, c]) => `<li${c ? ` class="${c}"` : ''}><span>${a}</span><b>${b}</b></li>`)
				.join('');
		};
		let t = 0;
		let last = '';
		const wake = loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			const key = t.toFixed(2);
			if (key !== last) draw(t);
			last = key;
			return true;
		});
		draw(0);
		wake();
	}
</script>
