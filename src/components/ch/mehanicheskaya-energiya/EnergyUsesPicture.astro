---
/**
 * Small looping pictures for «Где это встречается» of «Работа и энергия» (school-style, not to scale; one clock):
 *   1. Аварийный съезд: a lorry runs down a mountain road, turns into a lane of loose gravel that goes uphill and
 *      stops in it: its kinetic energy goes into potential energy and into the work of friction in the gravel.
 *   2. Зона деформации: a car runs into a concrete barrier; its bonnet crumples by about 0,5 м (drawn to the car's
 *      scale, 4,4 м long) while the cabin stays whole: the longer the path of the braking force, the smaller the force
 *      for the same work.
 *   3. Рекуперация: an electric bus brakes at a stop with its motors working as generators: gold arrows run from the
 *      wheels to the battery and its charge grows.
 *   4. ГАЭС (a pumped-storage power plant): at night (the Moon) the pumps lift water from the lower reservoir into the
 *      upper one; by day (the Sun) it runs down through the turbines: the energy is stored as mgh.
 * Energy arrows are gold; water blue.
 */
import G7Styles from '../g7/G7Styles.astro';
import MeStyles from './MeStyles.astro';

const gravel = Array.from({ length: 40 }, (_, i) => ({ x: 120 + ((i * 37) % 78), y: 0, r: 0.8 + (i % 3) * 0.4, k: (i * 13) % 7 }));
const ramp = (x: number) => 76 - (x - 116) * 0.28; // the gravel lane
---

<G7Styles />
<MeStyles />
<figure class="g7 g7--pic me eu not-content" data-meeu>
	<div class="g7__grid eu__grid">
		<div class="eu__cell">
			<svg class="g7__svg" viewBox="0 0 200 100" role="img" aria-label="Грузовик съезжает с горной дороги на аварийную полосу с гравием, идущую в гору, и останавливается">
				<rect class="eu__sky" x="0" y="0" width="200" height="100"></rect>
				<path class="eu__mount" d="M0 40 L40 8 L80 34 L120 4 L170 30 L200 18 V100 H0 Z"></path>
				<path class="eu__road" d="M0 44 L116 76 L116 82 L0 50 Z"></path>
				<path class="eu__gravelLane" d={`M116 76 L200 ${ramp(200)} L200 ${ramp(200) + 6} L116 82 Z`}></path>
				{gravel.map((p) => <circle class="eu__stone" cx={p.x} cy={(ramp(p.x) + 1 + p.k * 0.7).toFixed(1)} r={p.r}></circle>)}
				<path class="eu__ground" d="M0 50 L116 82 L200 64 V100 H0 Z"></path>
				<g data-lorry>
					<path class="eu__lorry" d="M-30 -14 h20 v14 h-20 Z"></path>
					<path class="eu__cab" d="M-9 -12 h7 l3 5 v7 h-10 Z"></path>
					<path class="eu__glass" d="M-7 -10.5 h4 l2 3.5 h-6 Z"></path>
					<circle class="eu__wheel" cx="-24" cy="0" r="3"></circle>
					<circle class="eu__wheel" cx="-15" cy="0" r="3"></circle>
					<circle class="eu__wheel" cx="-4" cy="0" r="3"></circle>
				</g>
			</svg>
			<p>Аварийный съезд</p>
		</div>
		<div class="eu__cell">
			<svg class="g7__svg" viewBox="0 0 200 100" role="img" aria-label="Автомобиль врезается в бетонный барьер: капот сминается, а салон остаётся целым">
				<rect class="eu__sky" x="0" y="0" width="200" height="100"></rect>
				<rect class="eu__road2" x="0" y="78" width="200" height="22"></rect>
				<path class="eu__wall" d="M168 30 h22 v48 h-22 Z"></path>
				<path class="eu__wallline" d="M168 46 h22 M168 62 h22 M179 30 v16 M174 46 v16 M184 62 v16"></path>
				<g data-car2>
					<path class="eu__body" data-body></path>
					<path class="eu__glass" d="M-44 -26 l6 -9 h14 v9 Z M-22 -26 v-9 h8 l7 9 Z"></path>
					<circle class="eu__wheel" cx="-46" cy="-4" r="7"></circle>
					<circle class="eu__wheel" cx="-10" cy="-4" r="7"></circle>
				</g>
			</svg>
			<p>Зона деформации</p>
		</div>
		<div class="eu__cell">
			<svg class="g7__svg" viewBox="0 0 200 100" role="img" aria-label="Электробус тормозит у остановки; энергия от колёс идёт в аккумулятор">
				<rect class="eu__sky" x="0" y="0" width="200" height="100"></rect>
				<rect class="eu__road2" x="0" y="82" width="200" height="18"></rect>
				<path class="eu__stop" d="M176 82 V36 M168 26 h16 v12 h-16 Z"></path>
				<g data-bus>
					<path class="eu__bus" d="M-86 -6 v-38 q0 -6 6 -6 h70 q8 0 9 8 l1 36 Z"></path>
					<path class="eu__buswin" d="M-80 -42 h14 v14 h-14 Z M-62 -42 h14 v14 h-14 Z M-44 -42 h14 v14 h-14 Z M-26 -42 h17 l2 14 h-19 Z"></path>
					<rect class="eu__batt" x="-66" y="-20" width="34" height="9" rx="1.5"></rect>
					<rect class="eu__charge" data-charge x="-65" y="-19" height="7" width="10"></rect>
					<path class="eu__flow" data-flow></path>
					<circle class="eu__wheel" cx="-70" cy="-4" r="7"></circle>
					<circle class="eu__wheel" cx="-18" cy="-4" r="7"></circle>
				</g>
			</svg>
			<p>Рекуперация</p>
		</div>
		<div class="eu__cell">
			<svg class="g7__svg" viewBox="0 0 200 100" role="img" aria-label="Гидроаккумулирующая электростанция: ночью насосы качают воду в верхний бассейн, днём вода стекает вниз через турбины">
				<rect class="eu__skyd" data-skyd x="0" y="0" width="200" height="100"></rect>
				<circle class="eu__sun" data-sun cx="30" cy="20" r="8"></circle>
				<path class="eu__moon" data-moon d="M36 12 a9 9 0 1 0 6 15 a7 7 0 1 1 -6 -15 Z"></path>
				<path class="eu__hill" d="M60 100 L150 26 H200 V100 Z"></path>
				<path class="eu__basin" d="M146 26 v-12 h50 v12 Z"></path>
				<rect class="eu__water" data-up x="148" width="46"></rect>
				<path class="eu__lake" d="M0 84 h70 v16 h-70 Z"></path>
				<path class="eu__pipe" d="M150 24 L78 84"></path>
				<path class="eu__flowp" data-wflow d="M150 24 L78 84"></path>
				<path class="eu__house" d="M66 70 h24 v14 h-24 Z M64 70 l14 -8 l14 8 Z"></path>
			</svg>
			<p>Гидроаккумулирующая электростанция</p>
		</div>
	</div>
</figure>

<style is:global>
	.g7--pic .g7__grid.eu__grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.eu__cell p {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		text-align: center;
	}
	.eu .g7__svg .eu__sky {
		fill: var(--g7-sky);
	}
	.eu .g7__svg .eu__mount {
		fill: color-mix(in oklab, var(--g7-green) 35%, var(--sl-color-gray-4));
	}
	.eu .g7__svg .eu__road,
	.eu .g7__svg .eu__road2 {
		fill: var(--sl-color-gray-4);
	}
	.eu .g7__svg .eu__gravelLane {
		fill: color-mix(in oklab, var(--g7-wood) 60%, var(--sl-color-gray-4));
	}
	.eu .g7__svg .eu__stone {
		fill: var(--sl-color-gray-2);
	}
	.eu .g7__svg .eu__ground {
		fill: var(--g7-ground);
	}
	.eu .g7__svg .eu__lorry {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.eu .g7__svg .eu__cab,
	.eu .g7__svg .eu__body,
	.eu .g7__svg .eu__bus {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.eu .g7__svg .eu__bus {
		fill: var(--g7-green);
	}
	.eu .g7__svg .eu__glass,
	.eu .g7__svg .eu__buswin {
		fill: color-mix(in oklab, var(--g7-sky) 50%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 0.5;
	}
	.eu .g7__svg .eu__wheel {
		fill: hsl(220, 10%, 16%);
		stroke: hsl(220, 8%, 55%);
		stroke-width: 1;
	}
	.eu .g7__svg .eu__wall {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.eu .g7__svg .eu__wallline {
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.eu .g7__svg .eu__stop {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.eu .g7__svg .eu__stopt {
		font-size: 10px;
		font-weight: 700;
		fill: var(--g7-ink);
	}
	.eu .g7__svg .eu__batt {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.eu .g7__svg .eu__charge {
		fill: var(--me-ek);
	}
	.eu .g7__svg .eu__flow {
		fill: none;
		stroke: var(--me-ek);
		stroke-width: 2.6;
		stroke-dasharray: 3 3;
	}
	.eu .g7__svg .eu__skyd {
		fill: var(--g7-sky);
		transition: fill 0.6s;
	}
	.eu .g7__svg .eu__skyd.is-night {
		fill: color-mix(in oklab, var(--g7-sky) 30%, hsl(230, 40%, 12%));
	}
	.eu .g7__svg .eu__sun {
		fill: hsl(48, 95%, 58%);
	}
	.eu .g7__svg .eu__moon {
		fill: hsl(50, 40%, 88%);
	}
	.eu .g7__svg .eu__hill {
		fill: color-mix(in oklab, var(--g7-green) 40%, var(--sl-color-gray-4));
	}
	.eu .g7__svg .eu__basin {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.eu .g7__svg .eu__water,
	.eu .g7__svg .eu__lake {
		fill: color-mix(in oklab, var(--ig-vx) 60%, var(--g7-paper));
	}
	.eu .g7__svg .eu__pipe {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 5;
	}
	.eu .g7__svg .eu__flowp {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 70%, white);
		stroke-width: 2;
		stroke-dasharray: 4 4;
	}
	.eu .g7__svg .eu__house {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.eu .g7__svg .eu__tag {
		font-size: 9px;
		fill: var(--g7-ink);
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const T = 8; // s, one clock for the four pictures
	const ramp = (x: number) => 76 - (x - 116) * 0.28;
	for (const root of document.querySelectorAll<HTMLElement>('[data-meeu]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const lorry = q<SVGGElement>('[data-lorry]');
		const car = q<SVGGElement>('[data-car2]');
		const body = q<SVGPathElement>('[data-body]');
		const bus = q<SVGGElement>('[data-bus]');
		const charge = q<SVGRectElement>('[data-charge]');
		const flow = q<SVGPathElement>('[data-flow]');
		const draw = (t: number) => {
			// 1. the lorry: down the road at a steady speed, then into the gravel, slowing evenly to a stop
			{
				let x: number;
				if (t < 2.5) x = -10 + (t / 2.5) * 126;
				else {
					const u = Math.min(1, (t - 2.5) / 2.2);
					x = 116 + 55 * (2 * u - u * u); // the same speed at the entry, an even deceleration
				}
				const y = x <= 116 ? 44 + x * (32 / 116) : ramp(x);
				const ang = x <= 116 ? Math.atan(32 / 116) : -Math.atan(0.28);
				lorry.setAttribute('transform', `translate(${(x + 4).toFixed(1)} ${(y - 0.5).toFixed(1)}) rotate(${((ang * 180) / Math.PI).toFixed(1)})`);
			}
			// 2. the car: steady to the barrier, the bonnet crumples by 7 px (0,5 м at the car's scale)
			{
				const front = 168;
				let x: number;
				let crush = 0;
				if (t < 2) x = 40 + (t / 2) * (front - 40);
				else {
					crush = 7 * ease((t - 2) / 0.25);
					x = front;
				}
				// the car moves on by `crush` after its front stopped at the wall: the front points stay at the wall
				const fx = -crush;
				const k = crush / 7;
				const zig = `L${(fx - 3 * k).toFixed(1)} -21 L${fx.toFixed(1)} -18 L${(fx - 4 * k).toFixed(1)} -14 L${fx.toFixed(1)} -10`;
				body.setAttribute('d', `M-60 -6 V-22 q0 -4 6 -4 L-40 -38 h20 L-8 -26 L${(fx - 2).toFixed(1)} -24 ${zig} L${fx.toFixed(1)} -6 Z`);
				car.setAttribute('transform', `translate(${(x + crush).toFixed(1)} 78)`);
			}
			// 3. the bus: steady, then brakes evenly to the stop; energy arrows while braking
			{
				let x: number;
				let br = 0;
				// the front: 40 px/s, then an even braking over 60 px in 3 с, to stop by the sign
				if (t < 2) x = 32 + t * 40;
				else {
					const u = Math.min(1, (t - 2) / 3);
					x = 112 + 60 * (2 * u - u * u);
					br = u < 1 ? 1 : 0;
				}
				bus.setAttribute('transform', `translate(${x.toFixed(1)} 82)`);
				const c = Math.min(1, Math.max(0, (t - 2) / 3));
				charge.setAttribute('width', (6 + 26 * c).toFixed(1));
				flow.setAttribute('d', br ? 'M-70 -10 L-58 -14 M-18 -10 L-40 -14' : '');
				flow.style.strokeDashoffset = String(-t * 20);
			}
			// 4. the pumped-storage plant: night (pumping up), then day (flowing down)
			{
				const night = t < T / 2;
				const u = night ? t / (T / 2) : (t - T / 2) / (T / 2);
				const lvl = night ? 0.2 + 0.7 * u : 0.9 - 0.7 * u;
				const up = q<SVGRectElement>('[data-up]');
				up.setAttribute('y', (26 - 11 * lvl).toFixed(1));
				up.setAttribute('height', (11 * lvl).toFixed(1));
				q('[data-skyd]').classList.toggle('is-night', night);
				q<SVGElement>('[data-sun]').style.visibility = night ? 'hidden' : 'visible';
				q<SVGElement>('[data-moon]').style.visibility = night ? 'visible' : 'hidden';
				const wf = q<SVGPathElement>('[data-wflow]');
				wf.style.strokeDashoffset = String((night ? 1 : -1) * t * 24);
			}
		};
		let t = 0;
		const wake = loop(root, (dt) => {
			t = (t + dt) % T;
			draw(t);
			return true;
		});
		draw(0);
		wake();
	}
</script>
