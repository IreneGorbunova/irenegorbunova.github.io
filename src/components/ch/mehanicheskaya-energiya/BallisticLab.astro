---
/**
 * Model «Баллистический маятник»: a spring gun shoots a ball of m = 10, 20 or 40 г horizontally at υ = 4…10 м/с into a
 * box with plasticine of M = 100, 200 or 400 г that hangs on two threads L = 0,5 м long (a bifilar suspension: the box
 * stays level and moves along a circle); the ball sticks. The impact is short, so the momentum is conserved:
 * u = mυ/(m + M). Then the mechanical energy is conserved in the swing: h = u²/(2g), cos θ = 1 − h/L. A light pointer
 * at the pivot (a protractor with ticks every 10°, longer every 30°; no numbers, so the thread never crosses a label) is pushed by the thread and stays at the largest angle. Readouts: the momentum before (mυ) and after
 * ((m + M)u), the kinetic energy before (mυ²/2) and after ((m + M)u²/2), the energy turned into internal energy
 * (its share M/(m + M) does not depend on υ), h and θ.
 * Examples: m = 20 г, M = 200 г, υ = 8 м/с → u = 0,727 м/с, h = 2,70 см, θ = 18,9°, E_к 0,640 → 0,058 Дж, 90,9 % to
 * internal energy; 40 г, 100 г, 10 м/с → u = 2,857 м/с, h = 41,6 см, θ = 80,4° (the largest).
 * «Неизвестная скорость» hides the speed and everything that would give it away and picks a random speed 4…10 м/с
 * (step 0,5); pressing it again shows that speed.
 * Scales: the suspension and the box to scale, 300 px per metre (L = 150 px; a box of 100 г is a 6-см cube, heavier
 * ones larger as the cube root of the mass); the ball 2 см. The flight of the ball is shown 15 times slower than in
 * reality, the swing in real time (with a little air damping so that it settles, γ = 0,15 1/с; the readouts are for
 * the first swing, which is not damped).
 * Colors (MeStyles): the velocity gold, the thread and the pointer ink, the protractor gray.
 */
import G7Styles from '../g7/G7Styles.astro';
import MeStyles from './MeStyles.astro';

const P = { x: 210, y: 26 };
const R = 46; // the protractor
const ticks = Array.from({ length: 10 }, (_, i) => i * 10).map((a) => {
	const r = (a * Math.PI) / 180;
	const r1 = R;
	const r2 = a % 30 === 0 ? R + 8 : R + 5;
	return `M${(P.x + r1 * Math.sin(r)).toFixed(1)} ${(P.y + r1 * Math.cos(r)).toFixed(1)} L${(P.x + r2 * Math.sin(r)).toFixed(1)} ${(P.y + r2 * Math.cos(r)).toFixed(1)}`;
});
---

<G7Styles />
<MeStyles />
<figure class="g7 me bl not-content" data-mebl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 222" role="img" aria-label="Пружинный пистолет стреляет шариком в ящик с пластилином, подвешенный на двух нитях; ящик отклоняется, и стрелка на транспортире показывает наибольший угол">
			<rect class="bl__beam" x="144" y="14" width="150" height="10" rx="2"></rect>
			<path class="bl__prot" d={`M${P.x} ${P.y + R} A${R} ${R} 0 0 0 ${P.x + R} ${P.y}`}></path>
			<path class="bl__tick" d={ticks.join(' ')}></path>
			<path class="bl__needle" data-needle></path>
			<path class="bl__thread" data-threads></path>
			<g data-box>
				<rect class="me-wood" data-wood></rect>
				<rect class="bl__clay" data-clay></rect>
			</g>
			<circle class="bl__ball" data-ball r="3"></circle>
			<path class="me-shaft me-s-v" data-vs></path><path class="me-head me-s-v" data-vh></path>
			<g class="bl__gun">
				<rect x="16" y="0" width="62" height="16" rx="3" data-gunbody></rect>
				<path class="bl__spring" data-spring></path>
				<path class="bl__grip" data-grip></path>
			</g>
			<path class="bl__floor" d="M0 216 H380"></path>
			<path class="bl__hline" data-hline></path>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<span class="g7__label">Шарик <i>m</i></span>
				<div class="g7__seg" role="group" aria-label="Масса шарика" data-m>
					<button type="button" class="g7__btn" aria-pressed="false" data-v="0.01">10 г</button>
					<button type="button" class="g7__btn" aria-pressed="true" data-v="0.02">20 г</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-v="0.04">40 г</button>
				</div>
			</div>
			<div class="g7__row">
				<span class="g7__label">Ящик <i>M</i></span>
				<div class="g7__seg" role="group" aria-label="Масса ящика" data-mm>
					<button type="button" class="g7__btn" aria-pressed="false" data-v="0.1">100 г</button>
					<button type="button" class="g7__btn" aria-pressed="true" data-v="0.2">200 г</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-v="0.4">400 г</button>
				</div>
			</div>
			<label class="g7__slider">
				<span>Скорость шарика <i>υ</i></span>
				<output data-ov></output>
				<input type="range" min="4" max="10" step="0.5" value="8" data-vin aria-label="Скорость шарика, метры в секунду" />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Пуск</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-hide>Неизвестная скорость</button>
			</div>
		</div>
	</div>
	<ul class="g7__read bl__read" data-read aria-live="polite"></ul>
	<figcaption class="g7__caption">
		Нити 0,5&nbsp;м и ящик — в масштабе. Полёт шарика замедлен в 15 раз, качание — в настоящем времени. Деления транспортира — через 10°, красная стрелка остаётся на наибольшем угле; между синими пунктирами — высота подъёма <i>h</i>. <i>g</i>&nbsp;=&nbsp;9,8&nbsp;м/с².
	</figcaption>
</figure>

<style is:global>
	.bl .g7__svg .bl__beam {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.bl .g7__svg .bl__prot {
		fill: color-mix(in oklab, var(--g7-sky) 50%, transparent);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.bl .g7__svg .bl__tick {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.bl .g7__svg .bl__deg {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
	}
	.bl .g7__svg .bl__needle {
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.bl .g7__svg .bl__thread {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.bl .g7__svg .bl__clay {
		fill: color-mix(in oklab, var(--g7-green) 70%, var(--sl-color-gray-4));
	}
	.bl .g7__svg .bl__ball {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.bl .g7__svg .bl__gun rect {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.bl .g7__svg .bl__spring {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.2;
	}
	.bl .g7__svg .bl__grip {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.bl .g7__svg .bl__floor {
		stroke: var(--g7-line);
	}
	.bl .g7__svg .bl__hline {
		fill: none;
		stroke: var(--me-ep);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.bl .g7__svg .bl__ht {
		fill: var(--me-ep);
		font-size: 14px;
		font-weight: 700;
	}
	.bl .bl__read {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 0.75rem;
	}
	@container (max-width: 36rem) {
		.bl .bl__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.bl .g7__read li.is-dim b {
		color: var(--sl-color-gray-3);
	}
</style>

<script>
	import { fmt, loop, segment } from '../g7/kit';
	import { setArrow } from './me';

	const g = 9.8;
	const L = 0.5;
	const KP = 300; // px per м
	const P = { x: 210, y: 26 };
	const SLOW = 15;
	const GAMMA = 0.15;
	const GUN_TIP = 78;
	for (const root of document.querySelectorAll<HTMLElement>('[data-mebl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const vin = q<HTMLInputElement>('[data-vin]');
		const hideBtn = q<HTMLButtonElement>('[data-hide]');
		const read = q<HTMLUListElement>('[data-read]');
		let m = 0.02;
		let M = 0.2;
		let hidden = false;
		let secret = 8;
		// state: 'ready' | 'fly' | 'swing'
		let phase = 'ready';
		let tf = 0; // time of flight on the screen
		let th = 0;
		let om = 0;
		let thMax = 0;
		let first = true; // still in the first swing
		const v = () => (hidden ? secret : Number(vin.value));
		const side = () => 0.06 * Math.cbrt(M / 0.1) * KP; // px
		const rest = () => ({ x: P.x, y: P.y + L * KP }); // the threads' lower ends at rest
		const boxAt = (a: number) => ({ x: P.x + L * KP * Math.sin(a), y: P.y + L * KP * Math.cos(a) });
		const ballY = () => rest().y + side() / 2;
		const startX = () => rest().x - side() / 2; // the box's left face at rest
		const u = () => (m * v()) / (m + M);
		const h = () => (u() * u()) / (2 * g);
		const theta = () => Math.acos(1 - h() / L);
		const draw = () => {
			q('[data-ov]').textContent = hidden ? '?' : `${fmt(Number(vin.value), 1)} м/с`;
			const s = side();
			const b = boxAt(th);
			const wood = q('[data-wood]');
			wood.setAttribute('x', (b.x - s / 2).toFixed(1));
			wood.setAttribute('y', b.y.toFixed(1));
			wood.setAttribute('width', s.toFixed(1));
			wood.setAttribute('height', s.toFixed(1));
			const clay = q('[data-clay]');
			clay.setAttribute('x', (b.x - s / 2).toFixed(1));
			clay.setAttribute('y', (b.y + s * 0.2).toFixed(1));
			clay.setAttribute('width', (s * 0.3).toFixed(1));
			clay.setAttribute('height', (s * 0.6).toFixed(1));
			const d = 10;
			q('[data-threads]').setAttribute('d', `M${P.x - d} ${P.y} L${(b.x - d).toFixed(1)} ${b.y.toFixed(1)} M${P.x + d} ${P.y} L${(b.x + d).toFixed(1)} ${b.y.toFixed(1)}`);
			const nd = 56;
			q('[data-needle]').setAttribute('d', `M${P.x} ${P.y} L${(P.x + nd * Math.sin(thMax)).toFixed(1)} ${(P.y + nd * Math.cos(thMax)).toFixed(1)}`);
			// the gun at the height of the box's middle
			const gy = ballY();
			q('[data-gunbody]').setAttribute('y', (gy - 8).toFixed(1));
			const comp = phase === 'ready' ? 1 : 0;
			let coil = `M20 ${gy}`;
			const len = comp ? 24 : 50;
			for (let i = 1; i <= 10; i++) coil += ` L${(20 + (len * i) / 10).toFixed(1)} ${(gy + (i % 2 ? -4 : 4)).toFixed(1)}`;
			q('[data-spring]').setAttribute('d', coil);
			q('[data-grip]').setAttribute('d', `M30 ${gy + 8} l-6 22 h10 l6 -22 Z`);
			// the ball
			const ball = q('[data-ball]');
			let bx: number;
			if (phase === 'ready') bx = 20 + len + 4;
			else if (phase === 'fly') bx = Math.min(startX() - 3, GUN_TIP + (v() * KP * tf) / SLOW);
			else bx = b.x - s / 2 + 3;
			const by = phase === 'swing' ? b.y + s / 2 : gy;
			ball.setAttribute('cx', bx.toFixed(1));
			ball.setAttribute('cy', by.toFixed(1));
			// the velocity: of the ball in flight, of the box just after the impact (6 px per м/с)
			if (phase === 'fly') setArrow(q('[data-vs]'), q('[data-vh]'), bx + 5, gy - 14, bx + 5 + v() * 6, gy - 14);
			else if (phase === 'swing' && first && Math.abs(th) < 0.02 && om > 0) setArrow(q('[data-vs]'), q('[data-vh]'), b.x - s / 2, b.y - 8, b.x - s / 2 + u() * 6 + 7, b.y - 8);
			else setArrow(q('[data-vs]'), q('[data-vh]'), 0, 0, 0, 0);
			// the height reached
			const shown = phase === 'swing' && !first;
			const hy = rest().y + s;
			const ty = boxAt(thMax).y + s;
			q('[data-hline]').setAttribute('d', shown ? `M${P.x.toFixed(1)} ${hy.toFixed(1)} H${(P.x + 168).toFixed(1)} M${P.x.toFixed(1)} ${ty.toFixed(1)} H${(P.x + 168).toFixed(1)}` : '');
			// readouts
			const hit = phase === 'swing';
			const p0 = m * v();
			const e0 = (m * v() * v()) / 2;
			const e1 = ((m + M) * u() * u()) / 2;
			const hide = (s: string) => (hidden ? '?' : s);
			const rows: [string, string, string?][] = [
				['импульс до удара', hide(`${fmt(p0, 3)} кг·м/с`)],
				['импульс после удара', hit ? hide(`${fmt((m + M) * u(), 3)} кг·м/с`) : '—'],
				['<i>E</i><sub>к</sub> до удара', hide(`${fmt(e0, 3)} Дж`)],
				['<i>E</i><sub>к</sub> после удара', hit ? hide(`${fmt(e1, 3)} Дж`) : '—'],
				['во внутреннюю энергию', hit ? `${hidden ? '' : `${fmt(e0 - e1, 3)} Дж, `}${fmt((100 * M) / (m + M), 1)} %` : '—', 'is-warm'],
				['высота подъёма <i>h</i>', shown ? `${fmt(h() * 100, 2)} см` : '—'],
				['наибольший угол <i>θ</i>', shown ? `${fmt((theta() * 180) / Math.PI, 1)}°` : '—', 'is-key'],
			];
			read.innerHTML = rows.map(([a, bb, c]) => `<li${c ? ` class="${c}"` : ''}><span>${a}</span><b>${bb}</b></li>`).join('');
		};
		const reset = () => {
			phase = 'ready';
			th = 0;
			om = 0;
			thMax = 0;
			first = true;
			tf = 0;
			draw();
		};
		const wake = loop(root, (dt) => {
			if (phase === 'fly') {
				tf += dt;
				const x = GUN_TIP + (v() * KP * tf) / SLOW;
				if (x >= startX() - 3) {
					phase = 'swing';
					om = u() / L;
				}
			} else if (phase === 'swing') {
				const n = 8;
				for (let i = 0; i < n; i++) {
					const h1 = dt / n;
					const a = -(g / L) * Math.sin(th) - (first ? 0 : GAMMA * om); // no damping before the first turn
					const om1 = om + a * h1;
					if (first && om > 0 && om1 <= 0) {
						first = false;
						thMax = theta();
					}
					if (om > 0) thMax = Math.max(thMax, first ? th : thMax);
					om = om1;
					th += om * h1;
				}
				if (!first && Math.abs(om) < 0.01 && Math.abs(th) < 0.005) {
					th = 0;
					om = 0;
					draw();
					return false;
				}
			} else return false;
			draw();
			return true;
		});
		q('[data-go]').addEventListener('click', () => {
			reset();
			phase = 'fly';
			wake();
		});
		hideBtn.addEventListener('click', () => {
			hidden = !hidden;
			hideBtn.setAttribute('aria-pressed', String(hidden));
			if (hidden) {
				secret = 4 + 0.5 * Math.floor(Math.random() * 13);
				vin.disabled = true;
				vin.style.visibility = 'hidden'; // the thumb would give the speed away
				hideBtn.textContent = 'Показать скорость';
				reset();
			} else {
				vin.value = String(secret);
				vin.disabled = false;
				vin.style.visibility = '';
				hideBtn.textContent = 'Неизвестная скорость';
				draw();
			}
		});
		segment(q('[data-m]'), (b) => {
			m = Number(b.dataset.v);
			reset();
		});
		segment(q('[data-mm]'), (b) => {
			M = Number(b.dataset.v);
			reset();
		});
		vin.addEventListener('input', reset);
		reset();
	}
</script>
