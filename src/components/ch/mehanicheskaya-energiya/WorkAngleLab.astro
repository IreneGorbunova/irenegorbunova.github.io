---
/**
 * «Работа силы под углом»: a sled on level snow is moved to the right by a displacement s (1…6 м); a constant force F
 * (0…100 Н) acts on it at an angle α (0…180°) to the displacement. The work A = F·s·cos α is computed and written
 * line by line; its sign is said in words. The projection of the force on the direction of the displacement,
 * F·cos α, is drawn on the dashed line through the point where the force is applied, the dotted line from the tip
 * of the force falls perpendicularly on it.
 *
 * Scales: the snow and the displacement 34 px per metre; the force 0,8 px per newton (100 Н — 80 px). The sled is
 * 1 м long. «Пуск» moves the sled by s at 1 м/с (real time) and the work grows with the path covered. Who pulls the
 * sled does not matter here, so only the force is drawn. The force can also be set by dragging the end of its
 * arrow.
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
---

<G7Styles />
<figure class="g7 g7--stack wal not-content" data-wal>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 30 400 160" role="img" aria-label="Санки движутся по снегу, на них под углом к перемещению действует сила" data-svg>
			<defs>
				<marker id={`wal-r-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`wal-g-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="head--gold" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="wal__snow" x="0" y="150" width="400" height="40"></rect>
			<line class="ink" x1="0" x2="400" y1="150" y2="150"></line>
			<line class="arrow arrow--gold" data-sarrow y1="170" y2="170" marker-end={`url(#wal-g-${uid})`}></line>
			<text class="t-i t-gold t-halo" data-slabel y="166">s</text>
			<line class="ln-dash" data-axis y1="134" y2="134"></line>
			<g data-sled>
				<path class="wal__runner" d="M-17 15 H13 Q19 15 19 9 Q19 6 16 6"></path>
				<path class="wal__runner" d="M-12 15 V5 M0 15 V5 M11 15 V5"></path>
				<rect class="wal__slat" x="-18" y="2" width="31" height="4" rx="1"></rect>
				<rect class="wal__bag" x="-14" y="-12" width="22" height="14" rx="4"></rect>
			</g>
			<line class="wal__proj" data-proj y1="134" y2="134"></line>
			<line class="wal__drop" data-drop></line>
			<path class="wal__arc" data-arc></path>
			<text class="t-i t-halo" data-alabel>α</text>
			<line class="arrow arrow--red" data-arrow marker-end={`url(#wal-r-${uid})`}></line>
			<circle class="wal__grip drag" data-grip r="11"></circle>
			<text class="t-i t-red t-halo" data-flabel>F</text>
			<text class="t-small" data-plabel x="8" y="62"></text>
			<text class="t-strong t-num" x="392" y="48" text-anchor="end" data-a style="font-size:15px"></text>
			<text class="t-small" x="8" y="46" data-word></text>
		</svg>
		<div class="g7__side wal__side">
			<label class="g7__slider">
				<span>Сила <i>F</i></span>
				<output data-of></output>
				<input type="range" min="0" max="100" step="5" value="60" data-f aria-label="Сила, ньютоны" />
			</label>
			<label class="g7__slider">
				<span>Угол <i>α</i></span>
				<output data-oa></output>
				<input type="range" min="0" max="180" step="5" value="30" data-al aria-label="Угол между силой и перемещением, градусы" />
			</label>
			<label class="g7__slider">
				<span>Перемещение <i>s</i></span>
				<output data-os></output>
				<input type="range" min="1" max="6" step="1" value="5" data-s aria-label="Перемещение, метры" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Пуск</button>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Снег и перемещение — в масштабе (1&nbsp;м — длина санок), стрелка силы — 0,8&nbsp;px на ньютон. Конец красной стрелки можно тянуть. Светло-красный отрезок на пунктире — проекция силы на направление перемещения, <i>F</i>&nbsp;cos&nbsp;<i>α</i>.
	</figcaption>
</figure>

<style is:global>
	.wal__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.wal__side .g7__lines {
		grid-column: 1 / -1;
	}
	.wal__side .g7__btn--go {
		grid-column: 1 / -1;
		justify-self: start;
	}
	@container (max-width: 36rem) {
		.wal__side {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.g7__svg .wal__snow {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-5));
	}
	.g7__svg .wal__runner {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.g7__svg .wal__slat {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
	}
	.g7__svg .wal__bag {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
	.g7__svg .wal__proj {
		stroke: color-mix(in oklab, var(--g7-red) 55%, var(--sl-color-white));
		stroke-width: 6;
		stroke-linecap: round;
		opacity: 0.75;
	}
	.g7__svg .wal__drop {
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.g7__svg .wal__arc {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.g7__svg .wal__grip {
		fill: transparent;
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 2 2;
	}
</style>

<script>
	import { fmt, fmtInt, fmtTrim, k, loop, svgPoint, tex } from '../g7/kit';

	const M = 34; // px per metre
	const KF = 0.8; // px per newton
	const X0 = 70; // the sled's start (its center)
	const Y = 134; // the line of the force's point of application
	for (const root of document.querySelectorAll<HTMLElement>('[data-wal]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const fIn = q<HTMLInputElement>('[data-f]');
		const aIn = q<HTMLInputElement>('[data-al]');
		const sIn = q<HTMLInputElement>('[data-s]');
		const sled = q<SVGGElement>('[data-sled]');
		const arrow = q<SVGLineElement>('[data-arrow]');
		const grip = q<SVGCircleElement>('[data-grip]');
		const flabel = q<SVGTextElement>('[data-flabel]');
		const proj = q<SVGLineElement>('[data-proj]');
		const drop = q<SVGLineElement>('[data-drop]');
		const arc = q<SVGPathElement>('[data-arc]');
		const alabel = q<SVGTextElement>('[data-alabel]');
		const plabel = q<SVGTextElement>('[data-plabel]');
		const axis = q<SVGLineElement>('[data-axis]');
		const sarrow = q<SVGLineElement>('[data-sarrow]');
		const slabel = q<SVGTextElement>('[data-slabel]');
		const aOut = q<SVGTextElement>('[data-a]');
		const word = q<SVGTextElement>('[data-word]');
		const lines = q<HTMLOListElement>('[data-lines]');
		let u01 = 1; // the share of the displacement covered
		let running = false;
		const set = (e: Element, a: Record<string, number | string>) => {
			for (const [n, v] of Object.entries(a)) e.setAttribute(n, typeof v === 'number' ? v.toFixed(1) : v);
		};
		const draw = () => {
			const F = Number(fIn.value);
			const al = Number(aIn.value);
			const s = Number(sIn.value);
			const r = (al * Math.PI) / 180;
			const c = Math.abs(Math.cos(r)) < 1e-9 ? 0 : Math.cos(r);
			q('[data-of]').textContent = `${F} Н`;
			q('[data-oa]').textContent = `${al}°`;
			q('[data-os]').textContent = `${s} м`;
			const x = X0 + s * M * u01;
			sled.setAttribute('transform', `translate(${x.toFixed(1)} 135)`);
			set(axis, { x1: 0, x2: 400 });
			// the displacement arrow: from the start to the end of the path covered
			const sl = s * M * u01;
			sarrow.style.visibility = slabel.style.visibility = sl > 8 ? 'visible' : 'hidden';
			set(sarrow, { x1: X0, x2: X0 + Math.max(0, sl - 7) });
			set(slabel, { x: X0 + sl / 2 - 3 });
			// the force at the point (x, Y)
			const L = KF * F;
			const tx = x + L * c;
			const ty = Y - L * Math.sin(r);
			const shaft = Math.max(0, L - 7);
			arrow.style.visibility = flabel.style.visibility = F > 0 ? 'visible' : 'hidden';
			set(arrow, { x1: x, y1: Y, x2: x + shaft * c, y2: Y - shaft * Math.sin(r) });
			set(grip, { cx: tx, cy: ty });
			set(flabel, { x: tx + (c >= 0 ? 6 : -14), y: ty - 4 });
			// the projection and the perpendicular from the tip
			const px = x + L * c;
			proj.style.visibility = Math.abs(L * c) > 1 ? 'visible' : 'hidden';
			set(proj, { x1: x, x2: px });
			drop.style.visibility = F > 0 && Math.sin(r) > 0.02 ? 'visible' : 'hidden';
			set(drop, { x1: tx, y1: ty, x2: px, y2: Y });
			plabel.textContent = `проекция силы F cos α = ${fmt(F * c, 0)} Н`;
			// the angle arc, radius 22
			const R = 22;
			arc.setAttribute('d', al > 0 ? `M${(x + R).toFixed(1)} ${Y} A${R} ${R} 0 0 0 ${(x + R * c).toFixed(1)} ${(Y - R * Math.sin(r)).toFixed(1)}` : '');
			const mid = r / 2;
			set(alabel, { x: x + 30 * Math.cos(mid) - 4, y: Y - 30 * Math.sin(mid) + 4 });
			alabel.style.visibility = al >= 15 ? 'visible' : 'hidden';
			// the work
			const A = F * s * c;
			const Anow = A * u01;
			aOut.textContent = `A = ${fmtInt(Anow)} Дж`;
			word.textContent = Math.abs(A) < 1e-9 ? 'работа равна нулю' : A > 0 ? 'работа положительна' : 'работа отрицательна';
			const cs = fmtTrim(c, 3);
			const exact = [0, 60, 90, 120, 180].includes(al);
			const eq = exact && Number.isInteger(A) ? '=' : '\\approx';
			lines.innerHTML = [
				k(`\\cos\\alpha = \\cos ${al}^\\circ ${exact ? '=' : '\\approx'} ${tex(cs)}`),
				k(`A = Fs\\cos\\alpha = ${F}\\cdot${s}\\cdot ${c < 0 ? `(${tex(cs)})` : tex(cs)} ${eq} ${tex(fmtInt(A))}~\\text{Дж}`),
			]
				.map((h, i) => `<li${i === 1 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			const s = Number(sIn.value);
			u01 = Math.min(1, u01 + dt / s);
			if (u01 >= 1) running = false;
			draw();
			return running;
		});
		q('[data-go]').addEventListener('click', () => {
			u01 = 0;
			running = true;
			wake();
		});
		for (const inp of [fIn, aIn, sIn])
			inp.addEventListener('input', () => {
				running = false;
				u01 = 1;
				draw();
			});
		// dragging the tip of the force
		let dragging = false;
		grip.addEventListener('pointerdown', (e) => {
			dragging = true;
			grip.setPointerCapture(e.pointerId);
			running = false;
			u01 = 1;
			e.preventDefault();
		});
		grip.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const p = svgPoint(svg, e);
			const x = X0 + Number(sIn.value) * M;
			const dx = p.x - x;
			const dy = Math.max(0, Y - p.y);
			const F = Math.min(100, Math.round(Math.hypot(dx, dy) / KF / 5) * 5);
			const al = Math.round(((Math.atan2(dy, dx) * 180) / Math.PI) / 5) * 5;
			fIn.value = String(F);
			aIn.value = String(Math.min(180, Math.max(0, al)));
			draw();
		});
		const stop = () => (dragging = false);
		grip.addEventListener('pointerup', stop);
		grip.addEventListener('pointercancel', stop);
		draw();
	}
</script>
