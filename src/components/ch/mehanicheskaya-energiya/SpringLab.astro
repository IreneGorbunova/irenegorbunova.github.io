---
/**
 * «Энергия пружины»: a block on a smooth table is held by a spring of stiffness k (100…500 Н/м); the block is dragged
 * (or set by the slider) so that the spring is stretched or compressed by x (−10…10 см). The elastic force
 * F_упр = k|x| points back to the undeformed position. The graph on the right is F_упр against |x|: a straight line
 * through zero; the shaded triangle under it is the work needed to deform the spring, its area k x²/2 — the
 * potential energy of the spring, computed in the readouts.
 *
 * Scales: the spring and the block 5 px per сантиметр (undeformed length 20 см); the arrow 1 px per newton; the
 * graph 15 px per сантиметр and 2,8 px per newton (0…50 Н: the largest force is 500 Н/м · 0,1 м = 50 Н).
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const GX = 238;
const GY = 172;
---

<G7Styles />
<figure class="g7 g7--stack spr not-content" data-spr>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 196" role="img" aria-label="Пружина с бруском; справа график силы упругости в зависимости от деформации" data-svg>
			<defs>
				<marker id={`spr-g-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="head--green" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="spr__wall" x="8" y="64" width="12" height="76"></rect>
			<line class="ink" x1="8" x2="226" y1="140" y2="140"></line>
			<line class="ln-dash" x1="120" x2="120" y1="56" y2="150"></line>
			<text class="t-small" x="120" y="162" text-anchor="middle"><tspan class="t-i">x</tspan> = 0</text>
			<path class="spr__coil" data-coil></path>
			<g data-block class="drag">
				<rect class="spr__block" x="120" y="98" width="36" height="42" rx="3"></rect>
			</g>
			<line class="spr__x" data-xline y1="62" y2="62"></line>
			<text class="t-i t-gold t-halo" data-xlabel y="56" text-anchor="middle">x</text>
			<line class="arrow arrow--green" data-arrow y1="112" y2="112" marker-end={`url(#spr-g-${uid})`}></line>
			<text class="t-i t-green t-halo" data-flabel y="94" text-anchor="middle">F<tspan baseline-shift="sub" font-size="10">упр</tspan></text>
			<!-- the graph -->
			<line class="ln" x1={GX} x2={GX + 156} y1={GY} y2={GY}></line>
			<line class="ln" x1={GX} x2={GX} y1={GY} y2={GY - 150}></line>
			{[2, 4, 6, 8, 10].map((c) => <text class="t-small t-num" x={GX + c * 15} y={GY + 13} text-anchor="middle">{c}</text>)}
			{[10, 20, 30, 40, 50].map((n) => <text class="t-small t-num" x={GX - 3} y={GY - n * 2.8 + 4} text-anchor="end">{n}</text>)}
			<text class="t-small" x={GX + 156} y={GY - 6} text-anchor="end">|x|, см</text>
			<text class="t-small" x={GX + 4} y={GY - 146}>F<tspan baseline-shift="sub" font-size="8">упр</tspan>, Н</text>
			<path class="spr__area" data-area></path>
			<line class="spr__line" data-line></line>
			<circle class="spr__dot" data-dot r="3.5"></circle>
		</svg>
		<div class="g7__side spr__side">
			<label class="g7__slider">
				<span>Деформация <i>x</i></span>
				<output data-ox></output>
				<input type="range" min="-10" max="10" step="1" value="6" data-x aria-label="Деформация пружины, сантиметры" />
			</label>
			<label class="g7__slider">
				<span>Жёсткость <i>k</i></span>
				<output data-ok></output>
				<input type="range" min="100" max="500" step="100" value="300" data-k aria-label="Жёсткость пружины, ньютоны на метр" />
			</label>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Брусок можно тянуть мышью или пальцем. Пружина и брусок — 5&nbsp;px на сантиметр, стрелка силы — 1&nbsp;px на ньютон. Площадь закрашенного треугольника на графике — энергия деформированной пружины.
	</figcaption>
</figure>

<style is:global>
	.spr__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.spr__side .g7__lines {
		grid-column: 1 / -1;
	}
	.g7__svg .spr__wall {
		fill: var(--g7-line);
	}
	.g7__svg .spr__coil {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.g7__svg .spr__block {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.g7__svg .spr__x {
		stroke: var(--g7-gold);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.g7__svg .spr__area {
		fill: color-mix(in srgb, var(--g7-green) 35%, transparent);
	}
	.g7__svg .spr__line {
		stroke: var(--g7-green);
		stroke-width: 2;
	}
	.g7__svg .spr__dot {
		fill: var(--g7-green);
	}
</style>

<script>
	import { fmt, fmtTrim, k as kk, svgPoint, tex } from '../g7/kit';

	const PXC = 5; // px per см
	const X0 = 120; // the block's left face when x = 0
	const GX = 238;
	const GY = 172;
	for (const root of document.querySelectorAll<HTMLElement>('[data-spr]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const xIn = q<HTMLInputElement>('[data-x]');
		const kIn = q<HTMLInputElement>('[data-k]');
		const block = q<SVGGElement>('[data-block]');
		const coil = q<SVGPathElement>('[data-coil]');
		const xline = q<SVGLineElement>('[data-xline]');
		const xlabel = q<SVGTextElement>('[data-xlabel]');
		const arrow = q<SVGLineElement>('[data-arrow]');
		const flabel = q<SVGTextElement>('[data-flabel]');
		const area = q<SVGPathElement>('[data-area]');
		const line = q<SVGLineElement>('[data-line]');
		const dot = q<SVGCircleElement>('[data-dot]');
		const lines = q<HTMLOListElement>('[data-lines]');
		const draw = () => {
			const x = Number(xIn.value); // см
			const k = Number(kIn.value);
			q('[data-ox]').textContent = `${x > 0 ? '+' : ''}${fmtTrim(x)} см`.replace('-', '−');
			q('[data-ok]').textContent = `${k} Н/м`;
			const bx = X0 + x * PXC;
			block.setAttribute('transform', `translate(${(x * PXC).toFixed(1)} 0)`);
			// the spring: 12 turns from the wall (20) to the block
			let d = 'M20 118 L26 118';
			const n = 24;
			const len = bx - 6 - 26;
			for (let i = 1; i < n; i++) d += ` L${(26 + (len * i) / n).toFixed(1)} ${i % 2 ? 106 : 130}`;
			d += ` L${(bx - 6).toFixed(1)} 118 L${bx} 118`;
			coil.setAttribute('d', d);
			// the deformation x, gold, from x = 0 to the block's face
			xline.setAttribute('x1', String(X0));
			xline.setAttribute('x2', bx.toFixed(1));
			xline.style.visibility = xlabel.style.visibility = x !== 0 ? 'visible' : 'hidden';
			xlabel.setAttribute('x', ((X0 + bx) / 2).toFixed(1));
			// the elastic force on the block, back to x = 0, from the middle of the block's face
			const F = (k * Math.abs(x)) / 100;
			const sx = bx + 18;
			const dir = x > 0 ? -1 : 1;
			const shaft = Math.max(0, F - 7);
			arrow.style.visibility = flabel.style.visibility = F > 0.5 ? 'visible' : 'hidden';
			arrow.setAttribute('x1', sx.toFixed(1));
			arrow.setAttribute('x2', (sx + dir * shaft).toFixed(1));
			// the label stands above the arrowhead, clear of the coils (106…130) and of the block (top at 98)
			flabel.setAttribute('x', (sx + dir * F).toFixed(1));
			// the graph
			const kx = (c: number) => GX + c * 15;
			const ky = (f: number) => GY - f * 2.8;
			line.setAttribute('x1', String(GX));
			line.setAttribute('y1', String(GY));
			line.setAttribute('x2', kx(10).toFixed(1));
			line.setAttribute('y2', ky(k * 0.1).toFixed(1));
			const ax = Math.abs(x);
			area.setAttribute('d', ax > 0 ? `M${GX} ${GY} L${kx(ax).toFixed(1)} ${GY} L${kx(ax).toFixed(1)} ${ky(F).toFixed(1)} Z` : '');
			dot.setAttribute('cx', kx(ax).toFixed(1));
			dot.setAttribute('cy', ky(F).toFixed(1));
			const xm = ax / 100;
			const E = (k * xm * xm) / 2;
			lines.innerHTML = [
				kk(`F_{\\text{упр}} = k|x| = ${k}\\cdot ${tex(fmtTrim(xm, 2))} = ${tex(fmtTrim(F, 1))}~\\text{Н}`),
				kk(`E_{\\text{п}} = \\dfrac{kx^2}{2} = \\dfrac{${k}\\cdot ${tex(fmtTrim(xm, 2))}^2}{2} = ${tex(fmt(E, 3).replace(/0+$/, '').replace(/,$/, ''))}~\\text{Дж}`),
			]
				.map((h, i) => `<li${i === 1 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
		};
		for (const inp of [xIn, kIn]) inp.addEventListener('input', draw);
		let from: number | null = null;
		block.addEventListener('pointerdown', (e) => {
			from = svgPoint(svg, e).x - Number(xIn.value) * PXC;
			block.setPointerCapture(e.pointerId);
			e.preventDefault();
		});
		block.addEventListener('pointermove', (e) => {
			if (from === null) return;
			const x = Math.round((svgPoint(svg, e).x - from) / PXC);
			xIn.value = String(Math.max(-10, Math.min(10, x)));
			draw();
		});
		const end = () => (from = null);
		block.addEventListener('pointerup', end);
		block.addEventListener('pointercancel', end);
		draw();
	}
</script>
