<script>
	import { scene } from '@components/intro/scene';
	import { figure, ANKLE_CM, SKELETON, ease, type Pt, type HandTarget } from '@components/people';

	const f1 = (v: number) => v.toFixed(1);
	const g = 9.8;
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

	for (const root of document.querySelectorAll<HTMLElement>('[data-meintro]')) {
		// ------------------------------------------------------------------ bungee jump
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bungee"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 12; // px per м
			const Y0 = 70; // the deck at the top position of the camera
			const S = K / 100;
			const HJ = 175;
			const m = 70;
			const L = 20;
			const kR = 140;
			const C = 40;
			const PREP = 0.6; // s on the platform before he leaves it
			const RUN = 13;
			const AX = 182; // the anchor on the railing, px
			const XJ = 190; // where he falls, px
			// the motion: y = how far the ankles are below the anchor, every 10 мс; and the camera with a lag
			const ys: number[] = [];
			const cams: number[] = [];
			{
				let y = 0;
				let v = 0;
				let cam = 0;
				const dt = 1e-4;
				for (let i = 0; i <= RUN * 1e4; i++) {
					if (i % 100 === 0) {
						ys.push(y);
						const target = Math.max(0, y + 0.8 - (120 - Y0) / K); // keeps his middle (0,8 м below the ankles when he hangs) near 120 px
						cam += (target - cam) * (1 - Math.exp(-0.01 / 0.35));
						cams.push(cam);
					}
					let F = m * g;
					if (y > L) {
						const T = kR * (y - L) + C * v;
						if (T > 0) F -= T;
					}
					v += (F / m) * dt;
					y += v * dt;
				}
			}
			const at = (arr: number[], t: number) => {
				const i = Math.min(arr.length - 1, Math.max(0, t * 100));
				const i0 = Math.floor(i);
				const i1 = Math.min(arr.length - 1, i0 + 1);
				return arr[i0] + (arr[i1] - arr[i0]) * (i - i0);
			};
			const valley = $<SVGGElement>('[data-valley]');
			const far = $<SVGGElement>('[data-far]');
			const rope = $<SVGPathElement>('[data-rope]');
			const harness = $<SVGPathElement>('[data-harness]');
			const jumper = figure($<SVGGElement>('[data-jumper]'), { s: S, H: HJ, clothes: 'indoor', shirt: 'hm-red', hair: 'short', name: 'jumper' });
			const friend = figure($<SVGGElement>('[data-friend]'), { s: S, H: 170, clothes: 'home', shirt: 'hm-blue', dir: -1, name: 'friend' });
			const u = S * HJ;
			const sy = (yw: number) => Y0 + yw * K; // world (м below the deck) → px in the valley group
			const pose = (t: number) => {
				// t: s from the start of the scene; the free motion starts at PREP
				const tm = Math.max(0, t - PREP);
				const y = at(ys, tm);
				const cam = at(cams, tm);
				valley.setAttribute('transform', `translate(0 ${f1(-cam * K)})`);
				far.setAttribute('transform', `translate(0 ${f1(-cam * K * 0.15)})`);
				// the jumper, tied by the ankles: on the platform he tips forward as a whole about his feet, then dives
				// head first and turns head down; the body hangs below the ankles, the arms toward the water
				const e = ease(t / PREP);
				const lean = t < PREP ? 0.5 * e : lerp(0.5, Math.PI, ease(tm / 1.1));
				const ux = Math.sin(lean);
				const uy = -Math.cos(lean); // the spine's up direction on the screen
				const ank: Pt = t < PREP ? { x: XJ, y: Y0 - ANKLE_CM.trainer * S } : { x: XJ + 3 * ease(tm / 0.6), y: sy(y) - ANKLE_CM.trainer * S };
				const legL = (SKELETON.adult.thigh + SKELETON.adult.shin) * u * 0.985;
				const hip = { x: ank.x + ux * legL, y: ank.y + uy * legL };
				const sw = t < PREP ? 0 : 0.25 * Math.sin(tm * 3.1) * Math.exp(-tm / 6);
				const armA = lean - Math.PI / 2 + (t < PREP ? lerp(Math.PI, 0.5, e) : 0.35) + sw; // the upper arm: forward-up from the body
				jumper.pose({
					hip,
					lean,
					head: 0.6 * lean,
					ankles: [
						{ x: ank.x + 0.6, y: ank.y },
						{ x: ank.x - 0.6, y: ank.y },
					],
					feet: [lean, lean],
					planted: [t < PREP, t < PREP],
					hands: [
						{ arm: [armA, 0.2], pose: t < PREP && e < 0.4 ? 'relaxed' : 'open' },
						{ arm: [armA + 0.15, 0.25], pose: t < PREP && e < 0.4 ? 'relaxed' : 'open' },
					],
				});
				// the ankle strap, and the rope from the anchor to it: straight when stretched, a hanging loop when slack
				harness.setAttribute('d', `M${f1(ank.x - 3)} ${f1(ank.y + 0.5)} L${f1(ank.x + 3)} ${f1(ank.y + 0.5)}`);
				const A = { x: AX, y: Y0 };
				const knot = { x: ank.x, y: ank.y + 0.5 };
				const d = Math.hypot(knot.x - A.x, knot.y - A.y) / K;
				if (d >= L - 0.05) rope.setAttribute('d', `M${A.x} ${A.y} L${f1(knot.x)} ${f1(knot.y)}`);
				else {
					const bottom = (L * K + A.y + knot.y) / 2; // the two halves of the loop add up to L
					rope.setAttribute('d', `M${A.x} ${A.y} C${A.x} ${f1(bottom)} ${f1(knot.x + 7)} ${f1(bottom)} ${f1(knot.x)} ${f1(knot.y)}`);
				}
				// the friend at the railing: watches, then looks down
				const fx = 236;
				const fu = S * 170;
				const fhip = { x: fx, y: Y0 - 0.52 * fu };
				const fsh = friend.shoulders(fhip, 0.15);
				friend.pose({
					hip: fhip,
					lean: 0.15,
					head: t < PREP ? 0 : 0.4,
					ankles: [
						{ x: fx - 0.02 * fu, y: Y0 - ANKLE_CM.lowshoe * S },
						{ x: fx + 0.03 * fu, y: Y0 - ANKLE_CM.lowshoe * S },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: fsh[0].x - 0.12 * fu, y: Y0 - 13 }, pose: 'grip', d: 3, contact: 'railing' },
						{ at: { x: fsh[1].x - 0.08 * fu, y: Y0 - 13 }, pose: 'grip', d: 3, contact: 'railing' },
					],
				});
			};
			scene(card, PREP + RUN, (x) => pose(x * (PREP + RUN)));
		}
		// ------------------------------------------------------------------ the wind-up car
		{
			const card = root.querySelector<HTMLElement>('[data-scene="car"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 160; // px per м
			const FLOOR = 206; // the line where the girl lies and the car runs
			const S = K / 100;
			const room = $<SVGGElement>('[data-room]');
			const carG = $<SVGGElement>('[data-car]');
			const key = $<SVGEllipseElement>('[data-key]');
			const spokes = [...card.querySelectorAll<SVGPathElement>('[data-spoke]')];
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H: 125, age: 'child', clothes: 'indoor', shirt: 'hm-gold', hair: 'pony', name: 'girl' });
			// the car: 0,1 кг, the spring pushes 0,2 Н · (1 − x/1,5 м) on the first 1,5 м, resistance 0,06 Н
			const M = 0.1;
			const F0 = 0.2;
			const LS = 1.5;
			const FR = 0.06;
			const xs: number[] = [0];
			{
				let x = 0;
				let v = 0;
				const dt = 1 / 1000;
				for (let i = 0; i < 10000; i++) {
					v += (((x < LS ? F0 * (1 - x / LS) : 0) - FR) / M) * dt;
					if (v <= 0 && i > 10) break;
					x += v * dt;
					if (i % 10 === 9) xs.push(x);
				}
			}
			const T_RUN = (xs.length - 1) / 100; // 3,57 с
			const sAt = (t: number) => {
				const i = Math.min(xs.length - 1, Math.max(0, t * 100));
				const i0 = Math.floor(i);
				const i1 = Math.min(xs.length - 1, i0 + 1);
				return xs[i0] + (xs[i1] - xs[i0]) * (i - i0);
			};
			const CARW = 24; // the car's drawing is 24 units long: 15 см
			const SC = (0.15 * K) / CARW;
			const CAR0 = 1.27; // the car's middle at the start, м
			const T_REACH = 0.7;
			const TURNS = 3;
			const TWIST = 0.35; // s per half turn
			const T_WIND = T_REACH + 2 * TURNS * TWIST; // 2,8 с
			const T_LIFT = T_WIND + 0.5;
			const T_GO = T_LIFT + 0.4;
			const TOTAL = T_GO + T_RUN + 0.3;
			const hipX = 0.75;
			const LEAN = Math.PI / 2 - 0.6; // on her tummy, the chest raised on the elbows
			const sx = (x: number) => x * K;
			const sy = (y: number) => FLOOR - y * K;
			const kp: Pt = { x: sx(CAR0) - 6.4 * SC, y: FLOOR - 12.4 * SC }; // the key's wings
			const roof: Pt = { x: sx(CAR0) + 2.6 * SC, y: FLOOR - 13.8 * SC };
			const draw = (t: number) => {
				const s = t > T_GO ? sAt(t - T_GO) : 0;
				const cx = CAR0 + s;
				const cam = Math.min(2.35, Math.max(0, cx - 1.31));
				room.setAttribute('transform', `translate(${f1(-cam * K)} 0)`);
				carG.setAttribute('transform', `translate(${f1(sx(cx))} ${FLOOR}) scale(${SC.toFixed(3)})`);
				const wheelA = (s / 0.016) * (180 / Math.PI); // wheels of radius 1,6 см
				spokes.forEach((sp) => sp.setAttribute('transform', `rotate(${f1(wheelA)})`));
				// the key: wound by 3 turns; it turns back while the spring works (the first 1,5 м)
				let turn = 0;
				let twist = 0;
				let pinch = true;
				if (t >= T_REACH && t < T_WIND) {
					const k = (t - T_REACH) / TWIST;
					const n = Math.floor(k);
					const w = k - n;
					pinch = w < 0.7;
					twist = pinch ? ease(w / 0.7) : 1 - ease((w - 0.7) / 0.3);
					turn = 0.5 * n + 0.5 * (pinch ? ease(w / 0.7) : 1);
				} else if (t >= T_WIND) turn = TURNS - TURNS * Math.min(1, s / LS);
				key.setAttribute('rx', (0.4 + 2.2 * Math.abs(Math.cos(turn * 2 * Math.PI))).toFixed(2));
				// the girl
				const hip = { x: sx(hipX), y: sy(0.1) };
				const sh = girl.shoulders(hip, LEAN);
				const kick = Math.sin(t * 2.2);
				const ankles: [Pt, Pt] = [
					{ x: sx(hipX - 0.42 - 0.06 * kick), y: sy(0.27 + 0.06 * kick) },
					{ x: sx(hipX - 0.42 + 0.06 * kick), y: sy(0.27 - 0.06 * kick) },
				];
				const rest: Pt = { x: sh[0].x + 0.17 * K, y: sy(0.02) };
				let near: HandTarget;
				if (t < T_REACH) {
					const e = ease(t / T_REACH);
					near = { at: { x: lerp(rest.x, kp.x, e), y: lerp(rest.y, kp.y, e) }, pose: e < 0.6 ? 'relaxed' : 'pinch', d: 0.6, dir: lerp(0.4, 1.2, e), roll: -1.2 };
				} else if (t < T_WIND) near = { at: kp, pose: pinch ? 'pinch' : 'open', d: 0.6, dir: 1.2, roll: -1.2 + 0.8 * twist, contact: 'key' };
				else {
					const e = ease((t - T_WIND) / 0.5);
					near = { at: { x: lerp(kp.x, rest.x, e), y: lerp(kp.y, rest.y - 0.06 * K * Math.sin(Math.PI * e), e) }, pose: e < 0.25 ? 'pinch' : 'relaxed', dir: lerp(1.2, 0.4, e), roll: -1.2 };
				}
				let far: HandTarget;
				if (t < T_LIFT) far = { at: roof, pose: 'flat', dir: 0.15, contact: 'car' };
				else {
					const e = ease((t - T_LIFT) / 0.4);
					far = { at: { x: roof.x - 0.03 * K * e, y: roof.y - 0.05 * K * e }, pose: e < 0.4 ? 'flat' : 'open', dir: 0.15 - 0.3 * e };
				}
				const look = 0.6 * LEAN + (t > T_GO ? lerp(-0.45, -0.7, ease((t - T_GO) / 1.5)) : -0.45);
				girl.pose({ hip, lean: LEAN, head: look, ankles, feet: [1.2 + 0.3 * kick, 1.2 - 0.3 * kick], hands: [near, far] });
			};
			scene(card, TOTAL, (u) => draw(u * TOTAL));
		}
	}
</script>
