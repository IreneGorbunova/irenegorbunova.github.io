---
/**
 * Two short looping opening scenes of «Работа и энергия. Закон сохранения энергии». No terms of the chapter in the
 * pictures.
 *
 * Hill: 50 px per metre. A snow hill 2 м high, its slope a half cosine 4 м long (steepest 38°), then level snow. A
 *   child (125 см, winter clothes of davlenie-zakon-paskalya/person.ts) on a wooden sled 80 см long starts from rest
 *   0,3 м past the edge, where the slope is 10° (1,97 м above the level snow), and goes down and along the level
 *   snow until it stops. The motion is integrated along the profile: dυ/dt = g(sin θ − μ cos θ), μ = 0,12 (runners
 *   on packed snow); the extra pressure on the snow in the hollow is neglected. Then the friction work is
 *   μmg · (horizontal distance), so the sled stops 1,97 / 0,12 = 16,4 м (horizontally) from the start; the speed
 *   at the foot is about 5,7 м/с (20 км/ч). Real time, about 6,8 с. The camera follows the sled; the far forest moves
 *   at a third of the speed (parallax). The mother (165 см) stands at the top.
 * Brakes: 13,5 px per metre. Two equal cars (4,4 × 1,45 м) in two lanes reach a white line at the same moment, at
 *   30 км/ч and at 60 км/ч, and brake from it with the same deceleration μg = 0,7 · 9,8 = 6,86 м/с² (dry
 *   asphalt; the reaction time is left out). They stop 5,1 м and 20,2 м past the line, in 1,2 с and 2,4 с. The
 *   counters above the cars show their speed. The clock runs twice slower than a real one. The traffic light at the
 *   line shows yellow while the cars come and turns red when they reach the line. The drivers are seen in the windows.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// the hill (scene 1): world metres → px; the level snow at y = G
const K = 50;
const G = 206;
const H = 2;
const W = 4;
const hillY = (x: number) => (x < 0 ? H : x > W ? 0 : (H * (1 + Math.cos((Math.PI * x) / W))) / 2);
let hill = `M${-6 * K} 240 L${-6 * K} ${G - H * K}`;
for (let i = 0; i <= 40; i++) {
	const x = (W * i) / 40;
	hill += ` L${(x * K).toFixed(1)} ${(G - hillY(x) * K).toFixed(1)}`;
}
hill += ` L${24 * K} ${G} L${24 * K} 240 Z`;
const fir = (x: number, y: number, h: number) => {
	const w = h * 0.42;
	return `M${x} ${y - h} L${x + w * 0.55} ${y - h * 0.55} L${x + w * 0.3} ${y - h * 0.55} L${x + w} ${y - h * 0.08} L${x + 2} ${y - h * 0.08} L${x + 2} ${y} L${x - 2} ${y} L${x - 2} ${y - h * 0.08} L${x - w} ${y - h * 0.08} L${x - w * 0.3} ${y - h * 0.55} L${x - w * 0.55} ${y - h * 0.55} Z`;
};
const firs = [
	[-2.2, 2, 80],
	[-3.6, 2, 60],
	[6.5, 0, 64],
	[10.8, 0, 48],
	[14.2, 0, 72],
	[19.6, 0, 58],
].map(([x, h, s]) => fir(x * K, G - h * K, s));
const forest = Array.from({ length: 22 }, (_, i) => fir(i * 26 + (i % 3) * 7, 150, 26 + ((i * 7) % 5) * 5)).join(' ');

// the road (scene 2): 13,5 px per metre, the white line at x = 0 м
const R = 13.5;
const X0 = 67.5;
const LANE = [164, 212];
---

<IntroFrame data-meintro>
	<div class="intro__card" data-scene="hill">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ребёнок на санках скатывается со снежной горки, долго едет по ровному снегу и останавливается. Наверху горки стоит мама">
			<rect class="me-sky" x="0" y="0" width="360" height="240"></rect>
			<path class="me-forest" d={forest} data-forest></path>
			<rect class="me-snow-far" x="0" y="150" width="360" height="90"></rect>
			<g data-world>
				{firs.map((d) => <path class="me-fir" d={d} />)}
				<path class="me-snow" d={hill}></path>
				<path class="me-track" data-track></path>
				<g data-mom></g>
				<g data-sled>
					<g data-kid></g>
					<path class="me-rope" data-rope></path>
					<path class="me-runner" d="M-17 -1 H11 Q17 -1 17 -6 Q17 -9 14.5 -9"></path>
					<path class="me-runner" d="M-12 -1 V-7 M-3 -1 V-7 M6 -1 V-7"></path>
					<rect class="me-slat" x="-17" y="-10" width="28" height="3" rx="1"></rect>
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Санки разгоняются с горки, а потом едут по ровному снегу всё медленнее и{' '}
				<More term="останавливаются">
					Наверху у санок с ребёнком есть запас энергии, потому что они подняты над землёй. На спуске он превращается в энергию движения: внизу горки высотой 2&nbsp;м скорость около 20&nbsp;км/ч. А сила трения о снег всё время совершает отрицательную работу, и механическая энергия переходит во внутреннюю: полозья и снег чуть нагреваются. Поэтому санки проезжают около 16&nbsp;м и останавливаются. Об этом — в разделе{' '}
					<a href="#работа-силы-трения-и-механическая-энергия">«Работа силы трения и механическая энергия»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="brakes">
