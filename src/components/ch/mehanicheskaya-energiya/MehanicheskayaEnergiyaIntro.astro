---
/**
 * Two looping opening scenes of «Работа и энергия. Закон сохранения энергии» (grade 10; redrawn 23 Nov 2026 with new
 * subjects: the old sled repeated «Силы в механике», the old braking cars repeated grade 7; the pole vault that
 * replaced the sled repeated a grade-9 worked task and became a bungee jump). No terms of the chapter
 * in the pictures; the captions' popovers explain. People: the shared people kit (src/components/people/).
 *
 * Банджи (bungee jump), real time, 12 px per metre for everything (the people 0,12 px per см). A river valley with an
 *   arched road bridge; the deck is 38 м above the river. A young man (175 см, 70 кг, the kit) stands on a small
 *   platform outside the railing, his ankles tied to a rubber rope (unstretched length L = 20 м, stiffness
 *   k = 140 Н/м, with some internal friction: a damping force 40 Н·с/м while it is stretched) whose other end is tied at
 *   the platform. In 0,6 с he tips forward as a whole about his feet and dives; he turns head down in about 1 с. His
 *   ankles fall freely for 20 м (2,02 с, 19,8 м/с); then the rope stretches. The motion of the ankles is integrated
 *   (steps of 0,1 мс): m·a = mg − k(y − L) − 40·υ while y > L, only mg while the rope is slack (the body is taken as a
 *   point at the ankles for the physics). The lowest point is 34,6 м below the deck 3,3 с after the dive (without the
 *   damping it would be 39,7 м): his head is then 1,6 м lower, about 1,8 м above the water. Then he bounces up to
 *   19,6 м, down to 27,7, up to 23,5, … and settles at the equilibrium L + mg/k = 24,9 м. A slack rope hangs in a loop
 *   below him (its two halves add up to 20 м). The camera follows him down with a lag of 0,35 с, so the river comes
 *   into view near the lowest point. A friend watches from the railing. 13 с of the motion are shown.
 * Машинка (wind-up toy car), real time, 160 px per metre (the girl 1,6 px per см; the car, 15 см long, to scale). A
 *   girl of about 7 (125 см) lies on her tummy on the floor, propped on her elbows. Her left hand rests flat on the
 *   roof of a toy car (0,1 кг) and keeps it still; her right hand winds the key on its top: 3 turns in 2,1 с, half a
 *   turn per twist of the fingers (pinch, twist, open, back). She lets go: the spring drives the wheels over the first
 *   1,5 м with a force that falls evenly from 0,2 Н to 0 (the stored energy 0,2 · 1,5 / 2 = 0,15 Дж), and a constant
 *   resistance of 0,06 Н (wheels and gears) acts all the time. Integrated here (steps of 1 мс): the top speed
 *   1,21 м/с at 1,05 м, the car stops 2,50 м from the start after 3,57 с (0,06 Н · 2,50 м = 0,15 Дж), just before the
 *   rug. While the spring works (the first 1,5 м) the key turns back by the same 3 turns. The camera follows the car.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gSky = `me-sky-${uid}`;
const f = (v: number) => v.toFixed(1);
// the bungee scene: 12 px per metre, the deck at y = Y0 when the camera is at the top
const KB = 12;
const Y0 = 70;
const depth = (m: number) => Y0 + m * KB;
const cliffL = `M-10 ${depth(-1)} L52 ${depth(-1)} L48 ${depth(8)} L60 ${depth(16)} L44 ${depth(26)} L54 ${depth(36)} L40 ${depth(50)} L-10 ${depth(50)} Z`;
const cliffR = `M370 ${depth(-1)} L306 ${depth(-1)} L312 ${depth(9)} L298 ${depth(18)} L314 ${depth(28)} L302 ${depth(38)} L318 ${depth(50)} L370 ${depth(50)} Z`;
const cracks = `M20 ${depth(6)} l10 30 M30 ${depth(20)} l-6 40 M14 ${depth(32)} l12 50 M336 ${depth(5)} l-8 36 M330 ${depth(22)} l6 44 M346 ${depth(34)} l-10 40`;
const pine = (x: number, y: number, h: number) => `M${x} ${y - h} L${x + h * 0.28} ${y} L${x - h * 0.28} ${y} Z`;
const pines = [pine(10, depth(-1), 20), pine(30, depth(-1), 16), pine(326, depth(-1), 22), pine(350, depth(-1), 17), pine(22, depth(12), 14), pine(338, depth(16), 14)].join(' ');
// the arch: springs from the cliffs 18 м below the deck, its crown just under the deck
const archY = (x: number) => depth(0.9) + ((x - 180) / 126) ** 2 * 17.1 * KB;
let arch = `M${f(54)} ${f(archY(54))}`;
for (let x = 58; x <= 306; x += 4) arch += ` L${x} ${f(archY(x))}`;
let archIn = '';
for (let x = 306; x >= 54; x -= 4) archIn += ` L${x} ${f(archY(x) + 12 - Math.abs(x - 180) * 0.03)}`;
arch += archIn + ' Z';
const struts = Array.from({ length: 11 }, (_, i) => 70 + i * 22).map((x) => `M${x} ${f(depth(0.9))} V${f(archY(x))}`).join(' ');
const rail = `M-10 ${Y0 - 13} H370 M-10 ${Y0 - 7} H370 ` + Array.from({ length: 20 }, (_, i) => `M${i * 20 + 2} ${Y0} V${Y0 - 13}`).join(' ');
// the toy car scene: floorboards in perspective (the far edge of the floor at y = 150, the near edge at 240)
const boards = Array.from({ length: 7 }, (_, i) => 150 + (i * i * 90) / 36);
---

<PeopleStyles />
<IntroFrame data-meintro>
	<div class="intro__card" data-scene="bungee">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мост над рекой в ущелье. Человек, привязанный за ноги длинной резиновой верёвкой, прыгает с моста вниз головой: падает, верёвка натягивается и останавливает его над самой водой, он несколько раз подпрыгивает вверх и вниз и повисает">
			<defs>
				<linearGradient id={gSky} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="me-sky-top"></stop>
					<stop offset="1" class="me-sky-low"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${gSky})`}></rect>
			<g data-far>
				<path class="me-far-mount" d="M-20 150 L40 90 L90 130 L150 70 L210 120 L270 80 L330 125 L380 95 V900 H-20 Z"></path>
				<path class="me-far-forest" d="M-20 170 Q60 150 120 172 Q200 192 260 168 Q320 150 380 166 V900 H-20 Z"></path>
				<path class="me-far-river" d="M150 900 Q170 600 182 330 L190 330 Q196 600 230 900 Z"></path>
			</g>
			<g data-valley>
				<path class="me-river" d={`M0 ${f(Y0 + 38 * KB)} H360 V${f(Y0 + 60 * KB)} H0 Z`}></path>
				<path class="me-river-line" d={`M60 ${f(Y0 + 39 * KB)} h40 M150 ${f(Y0 + 41 * KB)} h50 M240 ${f(Y0 + 39.5 * KB)} h36`}></path>
				<path class="me-cliff" d={cliffL}></path>
				<path class="me-cliff" d={cliffR}></path>
				<path class="me-cliff-line" d={cracks}></path>
				<path class="me-pine" d={pines}></path>
				<path class="me-arch" d={arch}></path>
				<path class="me-strut" d={struts}></path>
				<rect class="me-deck" x="-10" y={Y0} width="380" height={f(0.9 * KB)}></rect>
				<path class="me-rail" d={rail}></path>
				<rect class="me-plank" x="176" y={Y0 - 2} width="26" height="3"></rect>
				<g data-friend></g>
				<path class="me-rope" data-rope></path>
				<g data-jumper></g>
				<path class="me-harness" data-harness></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				С моста прыгает человек, привязанный за ноги длинной резиновой верёвкой: он падает, верёвка растягивается,{' '}
				<More term="останавливает его">
					Пока верёвка не натянулась, человек свободно падает и разгоняется. Потом верёвка растягивается и тормозит его. В самой нижней точке он на мгновение останавливается: вся энергия, которую он набрал, опустившись, запасена в растянутой верёвке, <i>kx</i>²/2. Распрямляясь, верёвка подбрасывает его вверх. Об этом — в разделах{' '}
					<a href="#энергия-деформированной-пружины">«Энергия деформированной пружины»</a> и{' '}
					<a href="#закон-сохранения-механической-энергии">«Закон сохранения механической энергии»</a>.
				</More>{' '}над самой водой и подбрасывает обратно.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="car">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка лежит на полу и заводит ключиком игрушечную машинку, потом отпускает её. Машинка сама едет по полу, замедляется и останавливается у ковра перед диваном">
			<g data-room>
				<rect class="me-wall" x="-20" y="0" width="800" height="150"></rect>
				<rect class="me-window" x="96" y="22" width="70" height="86" rx="2"></rect>
				<path class="me-frame" d="M96 22 h70 v86 h-70 Z M131 22 V108 M96 62 H166"></path>
				<path class="me-sill" d="M90 108 h82 v5 h-82 Z"></path>
				<rect class="me-shelf" x="452" y="56" width="110" height="5"></rect>
				<path class="me-books" d="M462 56 v-20 h7 v20 Z M470 56 v-24 h6 v24 Z M477 56 v-17 h8 v17 Z M520 56 v-22 h9 v22 Z"></path>
				<rect class="me-picture" x="600" y="34" width="60" height="42" rx="2"></rect>
				<path class="me-picture-in" d="M606 70 l14 -18 l10 12 l8 -8 l16 14 Z"></path>
				<rect class="me-floor" x="-20" y="150" width="800" height="90"></rect>
				{boards.map((y) => <path class="me-board" d={`M-20 ${f(y)} H780`}></path>)}
				<rect class="me-skirting" x="-20" y="144" width="800" height="6"></rect>
				<path class="me-toybox" d="M-6 150 v-46 h58 v46 Z"></path>
				<path class="me-toybox-lid" d="M-9 104 h64 v-6 h-64 Z"></path>
				<g class="me-sofa">
					<path d="M700 150 v-62 q0 -10 10 -10 h110 v72 Z"></path>
					<path class="me-sofa-seat" d="M684 158 v-30 q0 -8 8 -8 h128 v38 Z"></path>
					<path class="me-sofa-arm" d="M676 166 v-50 q0 -10 10 -10 q10 0 10 10 v50 Z"></path>
				</g>
				<ellipse class="me-rug" cx="760" cy="212" rx="120" ry="18"></ellipse>
				<ellipse class="me-rug-in" cx="760" cy="212" rx="96" ry="12"></ellipse>
				<g data-girl></g>
				<g data-car>
					<path class="me-car-shadow" d="M-12 0.5 h24"></path>
					<path class="me-toycar" d="M-12 -3 Q-12.5 -7.5 -9 -8 L-5 -8.4 L-2.5 -12.6 Q-1.6 -13.8 0 -13.8 L5.2 -13.8 Q6.6 -13.8 7.4 -12.6 L9.4 -8.6 Q12 -8.2 12 -5.6 L12 -3 Z"></path>
					<path class="me-toycar-glass" d="M-1.6 -12.6 L0.4 -9 H4.2 V-12.6 Z M5.2 -12.6 V-9 H8.6 L6.8 -12.6 Z"></path>
					<g transform="translate(-6.4 -8.2)">
						<path class="me-key-shaft" d="M-0.4 0 V-3.2 H0.4 V0 Z"></path>
						<ellipse class="me-key" data-key cx="0" cy="-4.2" rx="2.6" ry="1.3"></ellipse>
					</g>
					{[-7.2, 7.2].map((x) => (
						<g transform={`translate(${x} -2.6)`}>
							<circle class="me-toywheel" r="2.6"></circle>
							<path class="me-toyspoke" data-spoke d="M-1.6 0 H1.6 M0 -1.6 V1.6"></path>
						</g>
					))}
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Ребёнок заводит ключиком игрушечную машинку и отпускает: она сама едет по полу и{' '}
				<More term="останавливается">
					Поворачивая ключик, ребёнок совершает работу и закручивает пружину внутри машинки. Раскручиваясь, пружина вращает колёса, и запасённая в ней энергия уходит на работу против трения в колёсах и шестерёнках. Когда энергия пружины кончается, машинка останавливается. Об этом — в разделах{' '}
					<a href="#энергия-деформированной-пружины">«Энергия деформированной пружины»</a> и{' '}
					<a href="#работа-силы-трения-и-механическая-энергия">«Работа силы трения и механическая энергия»</a>.
				</More>{' '}у ковра.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
