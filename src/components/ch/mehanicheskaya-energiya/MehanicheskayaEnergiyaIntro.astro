<script>
	import { scene } from '@components/intro/scene';
	import { person, ANKLE } from '../davlenie-zakon-paskalya/person';

	const g = 9.8;
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-meintro]')) {
		// ---- the hill ----
		{
			const card = root.querySelector<HTMLElement>('[data-scene="hill"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 50;
			const G = 206;
			const H = 2;
			const W = 4;
			const MU = 0.12;
			const y = (x: number) => (x < 0 ? H : x > W ? 0 : (H * (1 + Math.cos((Math.PI * x) / W))) / 2);
			const slope = (x: number) => (x < 0 || x > W ? 0 : (-H * Math.PI * Math.sin((Math.PI * x) / W)) / (2 * W)); // dy/dx
			// integrate the motion once: x(t) along the profile
			const X0 = 0.3;
			const DT = 1 / 240;
			const xs: number[] = [X0];
			let x = X0;
			let v = 0;
			for (let i = 0; i < 20000; i++) {
				const th = Math.atan(-slope(x)); // descending angle
				const a = g * (Math.sin(th) - MU * Math.cos(th));
				v += a * DT;
				if (v <= 0 && x > W) break;
				x += v * Math.cos(th) * DT;
				xs.push(x);
			}
			const T = (xs.length - 1) * DT;
			const worldG = $<SVGGElement>('[data-world]');
			const forest = $<SVGPathElement>('[data-forest]');
			const sled = $<SVGGElement>('[data-sled]');
			const track = $<SVGPathElement>('[data-track]');
			const rope = $<SVGPathElement>('[data-rope]');
			// the child sits on the sled: local units of 0,4 px per см (the group is scaled by K/40), runners at y = 0
			const S = 0.4;
			const kid = person($<SVGGElement>('[data-kid]'), { s: S, H: 125, girth: 1.05, gear: 'boot', coat: 'me-coat--a' });
			kid({
				hip: { x: -8, y: -13 },
				lean: -0.12,
				ankles: [
					{ x: 11, y: -12.5 },
					{ x: 9, y: -12 },
				],
				feet: [-0.25, -0.25],
				hands: [
					{ x: 5.5, y: -19.5 },
					{ x: 4.5, y: -20 },
				],
				head: 0.05,
			});
			rope.setAttribute('d', 'M5.5 -19.5 Q10 -13 15 -8.5');
			// the mother at the top, 165 см, standing a little back from the edge, one hand raised
			const Sm = K / 100;
			const mom = person($<SVGGElement>('[data-mom]'), { s: Sm, H: 165, girth: 1, gear: 'boot', coat: 'me-coat--b' });
			const um = Sm * 165;
			const top = G - H * K;
			const mx = -1.6 * K;
			const pathD = (xEnd: number) => {
				let d = '';
				const n = 60;
				for (let i = 0; i <= n; i++) {
					const xx = X0 + ((xEnd - X0) * i) / n;
					d += `${i ? 'L' : 'M'}${f1(xx * K)} ${f1(G - y(xx) * K + 0.6)} `;
				}
				return d;
			};
			scene(card, T, (u) => {
				const i = Math.min(xs.length - 1, Math.round(u * (xs.length - 1)));
				const xp = xs[i];
				const ang = (Math.atan(-slope(xp)) * 180) / Math.PI;
				sled.setAttribute('transform', `translate(${f1(xp * K)} ${f1(G - y(xp) * K)}) rotate(${ang.toFixed(1)}) scale(${K / 40})`);
				track.setAttribute('d', xp > X0 + 0.05 ? pathD(xp - 0.4) : '');
				const cam = Math.min(10.8, Math.max(-2.6, xp - 2.6));
				worldG.setAttribute('transform', `translate(${f1(-cam * K)} 0)`);
				forest.setAttribute('transform', `translate(${f1((-cam * K) / 3 - 20)} 0)`);
				// the mother waves while the sled goes
				const wave = Math.sin(u * T * 6) * 0.04 * um;
				mom({
					hip: { x: mx, y: top - 0.505 * um },
					lean: 0.02,
					ankles: [
						{ x: mx + 0.03 * um, y: top - ANKLE.boot * Sm },
						{ x: mx - 0.04 * um, y: top - ANKLE.boot * Sm },
					],
					feet: [0, 0],
					hands: [
						{ x: mx + 0.12 * um + wave * 0.5, y: top - 0.98 * um + wave },
						{ x: mx + 0.02 * um, y: top - 0.43 * um },
					],
					head: -0.05,
				});
			});
		}
		// ---- the brakes ----
		{
			const card = root.querySelector<HTMLElement>('[data-scene="brakes"]')!;
			const R = 13.5;
			const X0 = 67.5;
			const LANE = [164, 212];
			const A = 0.7 * g; // deceleration
			const V = [30 / 3.6, 60 / 3.6];
			const PRE = 0.3; // s of even motion before the line
			const tStop = V.map((v) => v / A);
			const sStop = V.map((v) => (v * v) / (2 * A));
			const TOT = PRE + Math.max(...tStop);
			const cars = [0, 1].map((i) => ({
				g: card.querySelector<SVGGElement>(`[data-car="${i}"]`)!,
				wheels: [...card.querySelectorAll<SVGGElement>(`[data-car="${i}"] [data-wheel]`)],
				light: card.querySelector<SVGRectElement>(`[data-car="${i}"] [data-brake]`)!,
				speed: card.querySelector<SVGTextElement>(`[data-car="${i}"] [data-speed]`)!,
				gone: card.querySelector<SVGLineElement>(`[data-gone="${i}"]`)!,
				dist: card.querySelector<SVGTextElement>(`[data-dist="${i}"]`)!,
			}));
			const red = card.querySelector('[data-red]')!;
			const yellow = card.querySelector('[data-yellow]')!;
			scene(card, 2 * TOT, (u) => {
				const t = u * TOT;
				cars.forEach((c, i) => {
					const v0 = V[i];
					let s: number; // position of the front, м from the line
					let v: number;
					if (t < PRE) {
						s = -v0 * (PRE - t);
						v = v0;
					} else {
						const tb = Math.min(t - PRE, tStop[i]);
						s = v0 * tb - (A * tb * tb) / 2;
						v = v0 - A * tb;
					}
					const px = X0 + s * R;
					c.g.setAttribute('transform', `translate(${f1(px)} ${LANE[i]})`);
					const rot = ((s + 10) / 0.32) * (180 / Math.PI);
					c.wheels.forEach((w) => w.setAttribute('transform', `rotate(${rot.toFixed(0)})`));
					c.light.classList.toggle('is-on', t >= PRE);
					c.speed.textContent = `${Math.round(v * 3.6)} км/ч`;
					c.gone.setAttribute('x2', f1(X0 + Math.max(0, s) * R));
					c.dist.setAttribute('x', f1(X0 + (Math.max(0, s) * R) / 2));
					c.dist.textContent = v < 0.01 && t > PRE ? `${Math.round(sStop[i])} м` : '';
				});
				red.classList.toggle('is-on', t >= PRE);
				yellow.classList.toggle('is-on', t < PRE);
			});
		}
	}
</script>
