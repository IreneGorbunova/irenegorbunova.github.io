	}
	[data-volnyintro] .vif-post {
		stroke: color-mix(in oklab, var(--ig-v) 30%, hsl(25, 35%, 28%));
	}
	[data-volnyintro] .vif-deck {
		fill: color-mix(in oklab, var(--ig-v) 40%, hsl(25, 35%, 38%));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-volnyintro] .vif-plank {
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-volnyintro] .vif-rod {
		fill: none;
		stroke: hsl(28, 40%, 30%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	:root[data-theme='dark'] [data-volnyintro] .vif-rod,
	:root:not([data-theme]) [data-volnyintro] .vif-rod {
		stroke: hsl(30, 35%, 62%);
	}
	[data-volnyintro] .vif-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.6;
	}
	[data-volnyintro] .vif-float-red {
		fill: var(--ig-vy);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-volnyintro] .vif-float-white {
		fill: hsl(0, 0%, 96%);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-volnyintro] .vif-duck {
		fill: hsl(32, 35%, 45%);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-volnyintro] .vif-beak {
		fill: hsl(40, 90%, 55%);
	}
	[data-volnyintro] .vif-eye {
		fill: var(--hm-line);
	}
	[data-volnyintro] .vif-wing {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	[data-volnyintro] .vif-boat {
		fill: hsl(0, 0%, 94%);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-volnyintro] .vif-boat-top {
		fill: hsl(205, 40%, 55%);
	}
	[data-volnyintro] .vif-wake {
		fill: none;
		stroke: hsl(0, 0%, 97%);
		stroke-width: 0.9;
		opacity: 0.75;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, type FigurePose } from '@components/people/body';
	import { ROLL } from '@components/people/hand';
	import { ease, reach } from '@components/people/motion';

	for (const root of document.querySelectorAll<HTMLElement>('[data-volnyintro]')) {
		// ---------- the stadium ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="stadium"]')!;
			const K = 34;
			const S = K / 100; // px per см
			const X0 = 30;
			const YF = 200;
			const DX = 13.5;
			const DY = -6.2;
			const RZ = 0.85 * K;
			const RY = 0.45 * K;
			const N = 24; // seats of the front row in the picture (the back rows have fewer)
			const SLOW = 2; // the scene is slowed 2 times
			const RATE = 20 / SLOW; // seats per second on screen
			const T0 = 0.75; // s on screen: the crest at seat 0
			const RISE = 0.35 * SLOW;
			const TOP = 0.05 * SLOW;
			const SIT = 0.4 * SLOW;
			const RUN = T0 + (N - 1) / RATE + 2 * 0.025 * SLOW + TOP + SIT + 0.3;
			const rnd = (i: number) => {
				const r = Math.sin(i * 78.233 + 12.9898) * 43758.5453;
				return r - Math.floor(r);
			};
			const shirts = ['hm-blue', 'vis-white', 'vis-navy', 'vis-teal', 'hm-green', 'vis-violet', 'vis-gray', 'vis-olive'];
			// people differ: hair color, skin tone, trousers (the kit's colors are CSS variables, inherited by the group)
			const HAIR = ['hsl(25, 40%, 28%)', 'hsl(20, 15%, 14%)', 'hsl(42, 60%, 58%)', 'hsl(15, 55%, 38%)', 'hsl(30, 10%, 62%)', 'hsl(28, 35%, 20%)'];
			const SKIN = ['hsl(26, 55%, 72%)', 'hsl(24, 45%, 60%)', 'hsl(28, 60%, 80%)', 'hsl(22, 40%, 46%)', 'hsl(30, 50%, 68%)'];
			const PANTS = ['hsl(225, 25%, 34%)', 'hsl(210, 10%, 25%)', 'hsl(35, 25%, 45%)', 'hsl(215, 35%, 45%)'];
			type Fan = { f: ReturnType<typeof figure>; sit: FigurePose; up: FigurePose; t: number; last: number };
			const fans: Fan[] = [];
			for (let r = 0; r < 3; r++)
				for (let n = 0; n < N; n++) {
					const i = r * N + n;
					const red = r === 0 && n === 7;
					if (!card.querySelector(`[data-fan="${r}-${n}"]`)) continue;
					const H = 160 + Math.round(rnd(i) * 26);
					const u = H * S;
					const g = card.querySelector<SVGGElement>(`[data-fan="${r}-${n}"]`)!;
					const pick = (k: number, m: number) => Math.floor(rnd(i * 13 + k) * m) % m;
					g.style.setProperty('--hm-hair', HAIR[pick(1, HAIR.length)]);
					g.style.setProperty('--hm-skin', SKIN[pick(2, SKIN.length)]);
					g.style.setProperty('--hm-pants', PANTS[pick(3, PANTS.length)]);
					const f = figure(g, { s: S, H, dir: -1, shirt: red ? 'vis-red' : shirts[(i * 3 + r * 2 + pick(4, 3)) % shirts.length], hair: pick(5, 10) < 4 ? 'pony' : 'short', name: red ? 'fan in red' : `fan ${r}-${n}` });
					// the seat's hip point (as in the frontmatter), the feet on the same tread in front of the seat
					const hip = { x: X0 + r * RZ + 0.62 * K + n * DX, y: YF - r * RY - 0.45 * K + n * DY };
					const ty = YF - r * RY + n * DY; // the tread at this seat
					const ank = { x: hip.x - 0.3 * u, y: ty - 7 * S };
					const ankles: [{ x: number; y: number }, { x: number; y: number }] = [ank, { x: ank.x + 0.03 * u, y: ank.y - 0.6 }];
					const sit: FigurePose = {
						hip,
						lean: 0.08,
						ankles,
						feet: [0, 0],
						planted: [true, true],
						// upper arms down and a little forward, forearms forward on the thighs
						hands: [
							{ arm: [Math.PI / 2 + 0.3, 1.25], pose: 'relaxed' },
							{ arm: [Math.PI / 2 + 0.22, 1.3], pose: 'relaxed' },
						],
						head: 0,
					};
					const up: FigurePose = {
						hip: { x: ank.x + 0.035 * u, y: ank.y - 0.475 * u * 0.995 },
						lean: 0.02,
						ankles,
						feet: [0, 0],
						planted: [true, true],
						// both arms straight up and a little forward, the hands open, palms toward the pitch
						hands: [
							{ arm: [(3 * Math.PI) / 2 - 0.16, 0.12], pose: 'open', roll: ROLL.palmCcw },
							{ arm: [(3 * Math.PI) / 2 - 0.08, 0.16], pose: 'open', roll: ROLL.palmCcw },
						],
						head: -0.12,
					};
					fans.push({ f, sit, up, t: T0 + n / RATE + r * 0.025 * SLOW + (rnd(i + 7) - 0.5) * 0.04 * SLOW, last: -1 });
				}
			// how far up a fan is at time τ from his own moment (0 seated … 1 up)
			const upness = (tau: number) => {
				if (tau < -RISE) return 0;
				if (tau < 0) return ease((tau + RISE) / RISE);
				if (tau < TOP) return 1;
				if (tau < TOP + SIT) return 1 - ease((tau - TOP) / SIT);
				return 0;
			};
			const draw = (x: number) => {
				const t = x * RUN;
				for (const fan of fans) {
					const p = upness(t - fan.t);
					if (p === fan.last) continue;
					fan.last = p;
					const q = reach(fan.sit, fan.up, p);
					// leaning forward while getting up and sitting down
					q.lean += 0.38 * Math.sin(Math.PI * p);
					fan.f.pose(q);
				}
			};
			scene(card, RUN, draw);
		}

		// ---------- the lake ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="float"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 55; // px per metre
			const YW = 156; // the still water line
			const XF = 64 + 3.3 * K; // the float
			const XD = XF + 1.4 * K; // the duck
			const RUN = 18;
			const g = 9.8;
			const T = 1.5;
			const lam = (g * T * T) / (2 * Math.PI); // 3,51 м
			const kk = (2 * Math.PI) / lam;
			const w = (2 * Math.PI) / T;
			const cg = lam / T / 2; // 1,17 м/с
			const SIG = 2.6;
			const A0 = 0.09;
			const TC = 11.5; // s: the middle of the group at the float
			// the swell runs to the left: η = a·cos(k·x + ω·t), x in metres from the float
			const env = (xm: number, t: number) => A0 * Math.exp(-0.5 * ((xm - cg * (TC - t)) / SIG) ** 2);
			const eta = (xm: number, t: number) => env(xm, t) * Math.cos(kk * xm + w * t);
			const xi = (xm: number, t: number) => -env(xm, t) * Math.sin(kk * xm + w * t);
			// the boy
			const S = 0.55;
			const boy = figure($<SVGGElement>('[data-boy]'), { s: S, H: 158, age: 'teen', shirt: 'hm-green', hair: 'short', shorts: true, name: 'boy with a rod' });
			const u = 158 * S;
			const hip = { x: 50, y: 123 - 0.045 * u };
			const ang = -0.62; // the rod rises to the right
			const ru = { x: Math.cos(ang), y: Math.sin(ang) };
			const g0 = { x: hip.x + 0.17 * u, y: hip.y - 0.11 * u }; // the back hand
			const g1 = { x: g0.x + 0.14 * u * ru.x, y: g0.y + 0.14 * u * ru.y }; // the front hand
			const fingers = ang + Math.PI / 2; // the fingers wrap the rod: across it
			boy.pose({
				hip,
				lean: 0.12,
				head: 0.1,
				ankles: [
					{ x: hip.x + 0.27 * u, y: hip.y + 0.25 * u },
					{ x: hip.x + 0.22 * u, y: hip.y + 0.27 * u },
				],
				feet: [-0.2, -0.1],
				hands: [
					{ at: g1, pose: 'grip', d: 2.2, dir: fingers, roll: -Math.PI / 2, contact: 'rod' },
					{ at: g0, pose: 'grip', d: 2.6, dir: fingers, roll: -Math.PI / 2, contact: 'rod' },
				],
			});
			const tip = { x: g0.x + 2.4 * K * ru.x, y: g0.y + 2.4 * K * ru.y };
			$('[data-rod]').setAttribute('d', `M${(g0.x - 0.2 * K * ru.x).toFixed(1)} ${(g0.y - 0.2 * K * ru.y).toFixed(1)} L${tip.x.toFixed(1)} ${tip.y.toFixed(1)}`);
			const water = $('[data-water]');
			const surface = $('[data-surface]');
			const line = $('[data-line]');
			const fl = $('[data-float]');
			const duck = $('[data-duck]');
			// the boat far away: a small hull with a cabin and a V-shaped wake trailing it
			const boatG = $('[data-boat]');
			const ns = 'http://www.w3.org/2000/svg';
			const mkp = (cls: string, d: string) => {
				const p = document.createElementNS(ns, 'path');
				p.setAttribute('class', cls);
				p.setAttribute('d', d);
				boatG.append(p);
				return p;
			};
			const wake = mkp('vif-wake', '');
			const boat = document.createElementNS(ns, 'g');
			boatG.append(boat);
			const hull = document.createElementNS(ns, 'path');
			hull.setAttribute('class', 'vif-boat');
			hull.setAttribute('d', 'M-9 -2 L8 -2 L11 -4.5 L10 0.6 Q9 1.8 -8 1.8 Z');
			const cab = document.createElementNS(ns, 'path');
			cab.setAttribute('class', 'vif-boat-top');
			cab.setAttribute('d', 'M-5 -2 L-4 -5 L1.5 -5 L3.5 -2 Z');
			boat.append(cab, hull);
			const draw = (x: number) => {
				const t = x * RUN;
				// boat: from beyond the right edge to beyond the left edge between 0 and 9 s (toward the pier's side), its
				// V-shaped wake trailing to the right; the swell it sends runs partly its way, so it comes in from the right
				const bx = 380 - (400 * Math.min(t, 9)) / 9;
				const by = 110;
				boat.setAttribute('transform', `translate(${bx.toFixed(1)} ${by}) scale(-1 1)`);
				const wl = Math.min(90, 380 - bx);
				wake.setAttribute('d', `M${(bx + 8).toFixed(1)} ${by + 1} L${(bx + 8 + wl).toFixed(1)} ${by - 4} M${(bx + 8).toFixed(1)} ${by + 1.5} L${(bx + 8 + wl).toFixed(1)} ${by + 7}`);
				boatG.setAttribute('opacity', t > 9 ? '0' : '1');
				// the near water surface
				let d = '';
				for (let px = 0; px <= 360; px += 3) {
					const xm = (px - XF) / K;
					d += `${px ? 'L' : 'M'}${px} ${(YW - eta(xm, t) * K).toFixed(2)}`;
				}
				surface.setAttribute('d', d);
				water.setAttribute('d', `${d} L360 240 L0 240 Z`);
				// the float and the duck on their small circles
				const place = (el: Element, x0: number) => {
					const xm = (x0 - XF) / K;
					const px = x0 + xi(xm, t) * K;
					const py = YW - eta(xm, t) * K;
					const slope = (eta(xm + 0.05, t) - eta(xm - 0.05, t)) / 0.1;
					el.setAttribute('transform', `translate(${px.toFixed(2)} ${py.toFixed(2)}) rotate(${((-Math.atan(slope) * 180) / Math.PI).toFixed(1)})`);
					return { x: px, y: py };
				};
				const fp = place(fl, XF);
				place(duck, XD);
				// the fishing line hangs a little slack from the rod tip to the float
				const top = { x: fp.x, y: fp.y - 12 };
				line.setAttribute('d', `M${tip.x.toFixed(1)} ${tip.y.toFixed(1)} Q${((tip.x + top.x) / 2 + 6).toFixed(1)} ${((tip.y + top.y) / 2 + 14).toFixed(1)} ${top.x.toFixed(1)} ${top.y.toFixed(1)}`);
			};
			scene(card, RUN, draw);
		}
	}
</script>
