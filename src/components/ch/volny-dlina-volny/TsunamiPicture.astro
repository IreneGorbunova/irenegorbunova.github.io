---
/**
 * «Цунами» (Irina, 28 Nov 2026: «надо сделать помасштабнее, а то на анимации не понятно»). Two looping panels of the
 * same wave, side by side on a wide screen and one above the other on a phone (each panel has its own title, so the
 * caption never says «слева/справа»).
 *
 * The wave: a train of two periods of a sine wave, period T = 750 с (12,5 мин; tsunami periods are 5–60 мин),
 * crest first, η = A·sin(2π·τ/T) for 0 < τ < 2T, where τ = t − θ(x) and θ(x) = ∫dx/c is the time the front needs to
 * reach x. Shallow-water speed c = √(g·h) (g = 9,81 м/с²), so the period stays the same and the local wavelength
 * λ = c·T shrinks with the depth; the height grows by Green's law A ∝ h^(−1/4) (energy flux kept, no losses).
 *
 * (1) «В открытом океане»: depth 4 км, c = 198 м/с = 713 км/ч, λ = 149 км, A = 0,6 м (under 1 м). 360 px = 300 км
 *     along (833 м/px); the depth 4 км = 100 px (40 м/px: 21 times exaggerated); the wave height 0,05 м/px (about
 *     17 000 times exaggerated). The ship stands at 150 км: it rises 0,6 м in T/4 ≈ 3 мин, which nobody on board
 *     feels. The train enters at the left edge at t = 0, reaches the ship at 12,6 мин and has left at 50,2 мин.
 * (2) «У берега»: the shelf from 200 м deep to the shoreline 30 км away (straight slope), 360 px = 36 км (100 м/px);
 *     200 м = 100 px (2 м/px: 50 times exaggerated); the wave height 0,08 м/px (1250 times exaggerated; on the
 *     open-ocean scale the 3-м wave would stand as a wall over the shore).
 *     At 200 м: c = 159 км/ч, λ = 33 км, A = 1,3 м; at 10 м: 36 км/ч, 7,4 км, 2,7 м. Green's law is capped at the
 *     depth 6 м (A = 3,0 м, c = 28 км/ч, λ = 5,8 км): there the wave breaks and runs up the bank, drawn as a thin
 *     sheet of water sloping down from the level of the shoreline column. A trough is drawn no deeper than
 *     85 % of the drawn depth (with the two vertical scales it would lay bare kilometres of the floor). The front reaches
 *     the shoreline at 20,6 мин, the train ends there at 45,6 мин. The readout is for the first crest (gold arrow):
 *     the depth under it, its speed, height and the local wavelength c·T; it stops at the 6-м cap.
 * Time: both clocks run from the moment the wave reaches the panel's left edge; 52 мин of the wave in a 13-с loop
 * (240 times faster); the sea is calm at both ends of the loop, so it restarts without a jump. The ship and the houses
 * are not to scale. All numbers recomputed in Python (28 Nov 2026).
 */
import VdvStyles from './VdvStyles.astro';
---

<VdvStyles />
<figure class="g7 g7--pic vdv not-content" data-vdv-tsunami>
	<div class="tsu__grid">
		<svg class="g7__svg" viewBox="0 0 360 230" role="img" aria-label="Цунами в открытом океане: глубина 4 км, волна длиной около 150 км и высотой 0,6 м бежит со скоростью около 710 км/ч; корабль поднимается на 0,6 м за 3 минуты и волны не замечает">
			<rect class="tsu-sky" x="0" y="0" width="360" height="230"></rect>
			<path class="tsu-sea" data-sea="1"></path>
			<path class="tsu-surf" data-line="1"></path>
			<path class="tsu-floor" d="M0 210 C60 207 110 212 180 209 C240 206 300 211 360 208 V230 H0 Z"></path>
			<path class="vdv-tick" d="M14 110 V209 M10 110 H18 M10 209 H18"></path>
			<text x="21" y="164">4 км</text>
			<g data-ship>
				<path class="tsu-ship" d="M-13 -1 L13 -1 L10 5 L-11 5 Z"></path>
				<path class="tsu-ship" d="M-6 -1 V-8 H4 V-1 Z"></path>
			</g>
			<text x="180" y="176" text-anchor="middle">корабль поднимается</text>
			<text x="180" y="192" text-anchor="middle">на 0,6 м за 3 мин</text>
			<path class="vdv-lambda" data-lam="1"></path>
			<text class="t-green t-i" text-anchor="middle" data-lamt="1">λ</text>
			<g data-arrow="1"></g>
			<text class="t-title" x="8" y="17">В открытом океане</text>
			<text class="t-num" x="352" y="17" text-anchor="end" data-clock="1"></text>
			<text class="t-num" x="8" y="38">глубина 4 км · скорость 710 км/ч</text>
			<text class="t-num" x="8" y="56">высота 0,6 м · длина волны 150 км</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 360 230" role="img" aria-label="Цунами у берега: глубина уменьшается, волна замедляется, становится короче и вырастает до 3 м, затем заливает берег">
			<rect class="tsu-sky" x="0" y="0" width="360" height="230"></rect>
			<path class="tsu-sea" data-sea="2"></path>
			<path class="tsu-surf" data-line="2"></path>
			<path class="tsu-floor" d="M0 220 L300 120 L336 50 H360 V230 H0 Z"></path>
			<g class="tsu-house">
				<path d="M338 50 V38 H349 V50 Z M336 39 L343.5 31.5 L351 39 Z"></path>
				<path d="M351.5 50 V42 H358.5 V50 Z M350.5 43 L355 38 L359.5 43 Z"></path>
			</g>
			<path class="vdv-tick" d="M14 120 V219 M10 120 H18 M10 219 H18"></path>
			<text x="21" y="190">200 м</text>
			<g data-arrow="2"></g>
			<text class="t-title" x="8" y="17">У берега</text>
			<text class="t-num" x="352" y="17" text-anchor="end" data-clock="2"></text>
			<text class="t-num" x="8" y="38" data-r1></text>
			<text class="t-num" x="8" y="56" data-r2></text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Одна и та же волна цунами в открытом океане и у берега. Масштаб по вертикали сильно увеличен: глубина — в 20 и
		в 50 раз, высота волны — в тысячи раз; корабль и дома крупнее, чем в масштабе. Золотая стрелка — первый гребень
		и направление, в котором бежит волна; числа вверху — для него. Часы показывают время от прихода волны к левому
		краю рисунка, анимация ускорена в 240 раз.
	</figcaption>
</figure>

<script>
	import { f1, fmt, cycleLoop, newArrow, TAU, bracketPath } from './vdv';

	const G = 9.81;
	const T = 750; // s, the period of the wave
	const LOOP = 13; // s of the loop
	const SPEED = 240; // s of the wave per s of the loop

	type Panel = {
		W: number; // m per px along
		Y: number; // the calm surface (px)
		depth: (x: number) => number; // m, under the point x (m); used for the speed and Green's law
		ground: (px: number) => number; // y of the sea floor or the land (px)
		A0: number; // m, the height at the left edge
		h0: number; // m, the depth at the left edge
		hCap: number; // m, the depth below which Green's law stops
		shore: number; // px, the shoreline (360: none)
		hk: number; // px per metre of the wave height
	};

	/** θ(x) on a grid of 1 px: the time the front needs from the left edge to every pixel column. */
	const arrival = (p: Panel) => {
		const th = [0];
		for (let i = 1; i <= 360; i++) {
			const x = (i - 0.5) * p.W;
			th.push(th[i - 1] + p.W / Math.sqrt(G * Math.max(p.hCap, p.depth(x))));
		}
		return th;
	};
	const amp = (p: Panel, x: number) => p.A0 * Math.pow(p.h0 / Math.max(p.hCap, p.depth(x)), 0.25);
	const eta = (p: Panel, th: number[], i: number, t: number) => {
		const tau = t - th[i];
		return tau > 0 && tau < 2 * T ? amp(p, i * p.W) * Math.sin((TAU * tau) / T) : 0;
	};
	/** x (px) of the first crest at time t (it left the edge at T/4), or −1. */
	const crestPx = (th: number[], t: number) => {
		const tc = t - T / 4;
		if (tc < 0) return -1;
		for (let i = 1; i <= 360; i++) if (th[i] >= tc) return i - 1 + (tc - th[i - 1]) / (th[i] - th[i - 1]);
		return 361;
	};

	for (const fig of document.querySelectorAll<HTMLElement>('[data-vdv-tsunami]')) {
		const q = <E extends Element>(s: string) => fig.querySelector<E>(s)!;
		const clock = (k: number, t: number) => (q(`[data-clock="${k}"]`).textContent = `прошло ${Math.floor(t / 60)} мин`);

		// (1) the open ocean
		const P1: Panel = { W: 300e3 / 360, Y: 110, depth: () => 4000, ground: () => 209, A0: 0.6, h0: 4000, hCap: 4000, shore: 360, hk: 20 };
		const th1 = arrival(P1);
		const arrow1 = newArrow(q('[data-arrow="1"]'), 'gold');
		// (2) the shelf and the shore: 200 m deep at the left edge, the shoreline at 30 km (px 300), land beyond
		const P2: Panel = {
			W: 36e3 / 360,
			Y: 120,
			depth: (x) => 200 * (1 - x / 30e3),
			ground: (px) => (px <= 300 ? 120 + (100 * (300 - px)) / 300 : Math.max(50, 120 - ((px - 300) * 70) / 36)),
			A0: 0.6,
			h0: 4000,
			hCap: 6,
			shore: 300,
			hk: 12.5,
		};
		const th2 = arrival(P2);
		const arrow2 = newArrow(q('[data-arrow="2"]'), 'gold');

		const surface = (k: number, p: Panel, th: number[], t: number) => {
			let sea = '';
			let line = '';
			let pen = false;
			for (let i = 0; i <= 360; i += 2) {
				const yg = p.ground(i);
				// beyond the shoreline the water runs up the bank as a thin sheet, sloping down from the level of the
				// last sea column
				let dy = p.hk * eta(p, th, Math.min(i, p.shore), t) - Math.max(0, i - p.shore) * 0.6;
				// a trough is drawn no deeper than 85 % of the drawn depth: with the two vertical scales it would
				// otherwise lay bare kilometres of the sea floor
				if (dy < 0) dy = -Math.min(-dy, 0.85 * Math.max(0, yg - p.Y));
				const yw = p.Y - dy;
				const y = Math.min(yw, yg);
				sea += `${i ? 'L' : 'M'}${i} ${f1(y)}`;
				if (yw < yg - 0.3) {
					line += `${pen ? 'L' : 'M'}${i} ${f1(yw)}`;
					pen = true;
				} else pen = false;
			}
			q(`[data-sea="${k}"]`).setAttribute('d', `${sea} L360 230 L0 230 Z`);
			q(`[data-line="${k}"]`).setAttribute('d', line);
		};
		const crestArrow = (set: ReturnType<typeof newArrow>, p: Panel, th: number[], t: number, lift: number, xMax: number) => {
			const xc = crestPx(th, t);
			if (xc < 0 || xc > xMax) {
				set(0, 0, 0, 0);
				return xc;
			}
			const y = p.Y - p.hk * eta(p, th, Math.round(xc), t) - lift;
			set(xc - 10, y, xc + 10, y, 6, 3.6);
			return xc;
		};

		cycleLoop(fig, LOOP, (s) => {
			const t = s * SPEED;
			// (1)
			surface(1, P1, th1, t);
			const yShip = P1.Y - P1.hk * eta(P1, th1, 180, t);
			q('[data-ship]').setAttribute('transform', `translate(180 ${f1(yShip - 3)})`);
			crestArrow(arrow1, P1, th1, t, 17, 350); // above the ship's cabin when the crest passes it
			// λ between the two crests, under the wave, while both are on the picture
			const c1 = crestPx(th1, t);
			const c2 = crestPx(th1, t - T);
			const lam = q('[data-lam="1"]');
			const lamT = q('[data-lamt="1"]');
			if (c2 >= 4 && c1 <= 356) {
				lam.setAttribute('d', bracketPath(c2, c1, 128, 4));
				lamT.setAttribute('x', f1((c1 + c2) / 2));
				lamT.setAttribute('y', '145');
				lamT.style.display = '';
			} else {
				lam.setAttribute('d', '');
				lamT.style.display = 'none';
			}
			clock(1, t);
			// (2)
			surface(2, P2, th2, t);
			const xc = crestArrow(arrow2, P2, th2, t, 9, 298); // hidden once the crest reaches the shoreline
			const r1 = q('[data-r1]');
			const r2 = q('[data-r2]');
			if (xc < 0) {
				r1.textContent = 'волна ещё не пришла';
				r2.textContent = '';
			} else {
				const x = Math.min(xc, 360) * P2.W;
				const h = Math.max(P2.hCap, P2.depth(x));
				const c = Math.sqrt(G * h);
				const lk = (c * T) / 1000;
				r1.textContent = `глубина ${Math.round(h)} м · скорость ${Math.round(c * 3.6)} км/ч`;
				r2.textContent = `высота ${fmt(amp(P2, x), 1)} м · длина волны ${lk < 10 ? fmt(lk, 1) : Math.round(lk)} км`;
			}
			clock(2, t);
		});
	}
</script>

<style is:global>
	.vdv .tsu__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@container (max-width: 44rem) {
		.vdv .tsu__grid {
			grid-template-columns: minmax(0, 1fr);
			max-width: 30rem;
			margin-inline: auto;
		}
	}
	.vdv .tsu-sky {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-bg));
	}
	.vdv .tsu-sea {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-bg));
	}
	.vdv .tsu-surf {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 75%, var(--sl-color-white));
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.vdv .tsu-floor {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.vdv .tsu-ship {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.vdv .tsu-house path {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.vdv .tsu-house path + path {
		fill: var(--sl-color-gray-2);
	}
</style>
