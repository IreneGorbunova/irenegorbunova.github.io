---
/**
 * Styles shared by the pictures and models of «Волны. Длина волны» (grade 9), scoped under `.vdv` (every figure of
 * the chapter has it next to `g7`). Renders nothing. One color per role in the whole chapter (OUTLINE): the medium
 * (cord, coils, particles) neutral gray; the one marked particle red (--ig-vy); the direction in which the wave runs
 * gold (arrow--gold, --ig-v); the direction in which the particles oscillate blue (arrow--blue, --ig-vx), a double
 * arrow; λ brackets green (--g7-green). No forces in this chapter.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<style is:global>
	.vdv .vdv-ctrl {
		display: grid;
		gap: 0.6rem;
	}
	.vdv .vdv-check {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.vdv .vdv-check input {
		accent-color: var(--sl-color-accent);
		width: 1.05rem;
		height: 1.05rem;
		margin: 0;
	}
	.vdv .vdv-rope {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-2));
		stroke-width: 3.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.vdv .vdv-rope-rest {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.vdv .vdv-bead {
		fill: var(--sl-color-gray-2);
	}
	.vdv .vdv-coil {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-2));
		stroke-width: 1.3;
	}
	.vdv .vdv-coil-back {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 20%, var(--sl-color-gray-4));
		stroke-width: 1.1;
	}
	.vdv .vdv-red {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.vdv .vdv-red-line {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.4;
	}
	.vdv .vdv-red-coil {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.4;
	}
	.vdv .vdv-swing {
		stroke: var(--g7-red);
		stroke-width: 1.2;
		stroke-dasharray: 2 2;
		opacity: 0.8;
	}
	.vdv .vdv-lambda {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.6;
	}
	.vdv .vdv-lambda-guide {
		stroke: var(--g7-green);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		opacity: 0.8;
	}
	.vdv .vdv-period {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.6;
	}
	.vdv .vdv-period-guide {
		stroke: var(--g7-green);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		opacity: 0.8;
	}
	.vdv .vdv-axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.vdv .vdv-grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.7;
	}
	.vdv .vdv-graph {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.vdv .vdv-tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.vdv .vdv-ruler {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.vdv .vdv-metal {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.vdv .vdv-metal-dark {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.vdv .vdv-pin {
		fill: var(--g7-ink);
	}
	.vdv .vdv-wall {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.vdv .vdv-fade {
		stop-color: var(--g7-paper);
	}
	.vdv .t-green {
		fill: var(--g7-green);
	}
	.vdv .vdv-faint {
		fill: var(--sl-color-gray-3);
	}
</style>
