---
/**
 * «Где встречаются волны» (three small looping panels; the fourth OUTLINE panel, a slinky between two children, is left
 * out as OUTLINE allows).
 * (a) «Волны на море»: swell on the open sea, deep water, T = 6 с, λ = gT²/2π = 56 м, crests at 9,4 м/с; 1,67 px per
 *     metre along, heights drawn 5 times larger (±1,2 м → ±10 px). A buoy rides on its small circle (up, forward,
 *     down, back) and stays in place. Real time.
 * (b) «Цунами»: not to scale (the caption says so). In the open ocean (4 км deep) the hump is long and under 1 м high
 *     and runs at √(gh) ≈ 200 м/с; a ship is barely lifted. Over the shelf it slows (at 40 м depth √(gh) ≈ 20 м/с)
 *     and grows; the panel shows the hump moving right, slowing and growing as the depth falls (height ∝ h^(−1/4),
 *     Green's law, then capped), its length shrinking with its speed. 9 с loop.
 * (c) «Землетрясение»: a seismograph drum turning; the pen writes calm, then the first arrival (the longitudinal
 *     wave: smaller, quicker swings) and some 20 с later the transverse one (larger swings); the marks «продольная» and
 *     «поперечная» appear at the arrivals. The drum is drawn speeded up: 1 с of the loop is 6 с of record.
 */
import VdvStyles from './VdvStyles.astro';
---

<VdvStyles />
<figure class="g7 g7--pic vdv not-content" data-vdv-examples>
	<div class="g7__grid is-three">
		<div>
			<svg class="g7__svg" viewBox="0 0 200 140" role="img" aria-label="Волны на море: буй качается на волнах и остаётся на месте">
				<rect class="vdv-sky" x="0" y="0" width="200" height="70"></rect>
				<path class="vdv-sea" data-sea></path>
				<path class="vdv-surf" data-sealine></path>
				<g data-buoy>
					<path class="vdv-buoy" d="M-5 0 L5 0 L3.5 -10 L-3.5 -10 Z"></path>
					<path class="vdv-buoy-top" d="M-0.8 -10 V-17 M-3 -17 H3"></path>
					<path class="vdv-buoy-band" d="M-4.4 -4 L4.4 -4 L4 -6.5 L-4 -6.5 Z"></path>
				</g>
			</svg>
			<p class="vdv-cap">Волны на море</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 200 140" role="img" aria-label="Цунами: в открытом океане длинная низкая волна, корабль её почти не замечает; у берега она замедляется и растёт">
				<rect class="vdv-sky" x="0" y="0" width="200" height="60"></rect>
				<path class="vdv-sea" data-tsea></path>
				<path class="vdv-surf" data-tline></path>
				<path class="vdv-floor" d="M0 132 L120 132 C150 130 160 100 176 80 L200 56 L200 140 L0 140 Z"></path>
				<g data-ship>
					<path class="vdv-ship" d="M-12 -1 L12 -1 L9 4 L-10 4 Z"></path>
					<path class="vdv-ship" d="M-5 -1 V-7 H3 V-1 Z"></path>
				</g>
				<text class="t-small vdv-faint" x="6" y="12">не в масштабе</text>
			</svg>
			<p class="vdv-cap">Цунами</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 200 140" role="img" aria-label="Запись сейсмографа: сначала приходит продольная волна, позже — поперечная с большими колебаниями">
				<rect class="vdv-paper" x="6" y="16" width="188" height="96" rx="3"></rect>
				<path class="vdv-grid" d="M6 40 H194 M6 64 H194 M6 88 H194"></path>
				<path class="vdv-trace-ink" data-trace></path>
				<g data-pmark><line class="vdv-tick" y1="22" y2="114"></line><text class="t-small" y="124" text-anchor="middle">продольная</text></g>
				<g data-smark><line class="vdv-tick" y1="22" y2="126"></line><text class="t-small" y="137" text-anchor="middle">поперечная</text></g>
				<circle class="vdv-pin" r="2.2" data-pen></circle>
			</svg>
			<p class="vdv-cap">Землетрясение</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		На море высота волн нарисована в 5 раз крупнее. Цунами нарисовано не в масштабе: в открытом океане его длина —
		сотни километров, а высота — меньше метра. Запись сейсмографа ускорена в 6 раз.
	</figcaption>
</figure>

<script>
	import { f1, cycleLoop, TAU } from './vdv';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-vdv-examples]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		// (a) the sea
		{
			const K = 1.67;
			const KY = 5 * K;
			const T = 6;
			const lam = (9.8 * T * T) / TAU;
			const kk = TAU / lam;
			const a = 1.2;
			const Y = 78;
			const XB = 100;
			const eta = (xm: number, t: number) => a * Math.cos(kk * xm - (TAU * t) / T);
			const xi = (xm: number, t: number) => -a * Math.sin(kk * xm - (TAU * t) / T);
			cycleLoop(fig, T, (t) => {
				let d = '';
				for (let x = 0; x <= 200; x += 4) d += `${x ? 'L' : 'M'}${x} ${f1(Y - KY * eta(x / K, t))}`;
				q('[data-sealine]').setAttribute('d', d);
				q('[data-sea]').setAttribute('d', `${d} L200 140 L0 140 Z`);
				const xm = XB / K;
				const slope = -KY * kk * a * -Math.sin(kk * xm - (TAU * t) / T) / K;
				q('[data-buoy]').setAttribute('transform', `translate(${f1(XB + KY * xi(xm, t))} ${f1(Y + 3 - KY * eta(xm, t))}) rotate(${f1((Math.atan(slope) * 180) / Math.PI * 0.6)})`);
			});
		}
		// (b) the tsunami: depth profile under the surface line (px), the hump runs right
		{
			const depthAt = (x: number) => (x < 120 ? 4000 : x < 176 ? 4000 - ((x - 120) / 56) * 3960 : Math.max(5, 40 - (x - 176) * 1.6)); // m
			const Y = 62;
			const RUN = 9;
			// position: integrate dx/dt ∝ √(g·h), scaled so the hump crosses the open ocean in about 4 s
			const pos: number[] = [];
			let x = -40;
			const dt = 1 / 60;
			for (let i = 0; i <= RUN * 60; i++) {
				pos.push(x);
				const h = depthAt(Math.max(0, x));
				x += Math.min(60, 0.9 * Math.sqrt(9.8 * h)) * dt * 0.3;
			}
			cycleLoop(fig, RUN, (t) => {
				const xc = pos[Math.min(pos.length - 1, Math.round(t * 60))];
				const h = depthAt(Math.max(0, Math.min(199, xc)));
				const amp = Math.min(22, 3 * Math.pow(4000 / h, 0.25)); // px
				const half = 26 * Math.sqrt(h / 4000) + 10; // the hump's half length shrinks with its speed
				let d = '';
				for (let px = 0; px <= 200; px += 2) {
					const u = (px - xc) / half;
					const y = Math.abs(u) < 1 ? amp * Math.cos((Math.PI * u) / 2) ** 2 : 0;
					d += `${px ? 'L' : 'M'}${px} ${f1(Y - y)}`;
				}
				q('[data-tline]').setAttribute('d', d);
				q('[data-tsea]').setAttribute('d', `${d} L200 140 L0 140 Z`);
				const us = (60 - xc) / half;
				const ys = Math.abs(us) < 1 ? amp * Math.cos((Math.PI * us) / 2) ** 2 : 0;
				q('[data-ship]').setAttribute('transform', `translate(60 ${f1(Y - ys - 2)})`);
			});
		}
		// (c) the seismograph: the trace is written from left to right
		{
			const RUN = 8;
			const X0 = 8;
			const X1 = 192;
			const Y = 64;
			const tP = 2.2; // s of the loop
			const tS = 4.6;
			const rec = (s: number) => {
				let y = 0.6 * Math.sin(s * 37) * Math.sin(s * 11); // a quiet line
				if (s > tP) y += 7 * Math.exp(-(s - tP) / 1.2) * Math.sin(TAU * 4 * (s - tP));
				if (s > tS) y += 26 * Math.exp(-(s - tS) / 1.4) * Math.sin(TAU * 1.6 * (s - tS)) * Math.min(1, (s - tS) / 0.3);
				return y;
			};
			const xOf = (s: number) => X0 + ((X1 - X0) * s) / (RUN - 1);
			cycleLoop(fig, RUN, (t) => {
				const s1 = Math.min(t, RUN - 1);
				let d = '';
				for (let s = 0; s <= s1; s += 0.01) d += `${s ? 'L' : 'M'}${f1(xOf(s))} ${f1(Y - rec(s))}`;
				q('[data-trace]').setAttribute('d', d);
				q('[data-pen]').setAttribute('cx', f1(xOf(s1)));
				q('[data-pen]').setAttribute('cy', f1(Y - rec(s1)));
				const pm = q<SVGGElement>('[data-pmark]');
				const sm = q<SVGGElement>('[data-smark]');
				pm.setAttribute('transform', `translate(${f1(xOf(tP))} 0)`);
				sm.setAttribute('transform', `translate(${f1(xOf(tS))} 0)`);
				pm.style.display = t > tP ? '' : 'none';
				sm.style.display = t > tS ? '' : 'none';
			});
		}
	}
</script>

<style is:global>
	.vdv .vdv-cap {
		margin: 0.35rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.vdv .vdv-sky {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-bg));
	}
	.vdv .vdv-sea {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-bg));
	}
	.vdv .vdv-floor {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.vdv .vdv-buoy {
		fill: hsl(40, 90%, 55%);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.vdv .vdv-buoy-band {
		fill: var(--sl-color-gray-1);
	}
	.vdv .vdv-buoy-top {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.vdv .vdv-ship {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.vdv .vdv-paper {
		fill: color-mix(in oklab, var(--sl-color-white) 8%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-4);
	}
	.vdv .vdv-trace-ink {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1;
	}
</style>
