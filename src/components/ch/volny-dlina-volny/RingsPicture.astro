---
/**
 * «Круги на воде» (picture, a looping animation). Top: still water seen from above; a stone falls at the point O and
 * a group of 5 circular crests spreads at a constant speed (60 px/s on screen), the crests λ = 30 px apart all the way
 * (the spreading of real ripples into longer and shorter ones is left out). A 30° sector from O is highlighted: the
 * part of the energy that runs inside it lies on an arc, and the arc at the distance 4r (r = 60 px, 4r = 240 px) is
 * 4 times longer than at r (31 px and 126 px). Bottom: the cross-section of the water along the middle of the sector,
 * the same crests at the same moment, drawn with crest height ∝ 1/√r (18 px at r, exactly 9 px at 4r; no losses);
 * the dashed lines are the heights of the crests at every distance. Loop: the stone at 0,3 с, the group leaves the
 * picture at about 8 с, 9 с in all.
 */
import VdvStyles from './VdvStyles.astro';
const OX = 40;
const R1 = 60;
const R4 = 240;
const H1 = 18;
const YA = 214; // the axis of the cross-section
const env = (sign: number) => {
	let d = '';
	for (let x = 22; x <= 340; x += 4) {
		const r = Math.max(x, 30);
		d += `${x === 22 ? 'M' : 'L'}${(OX + r).toFixed(1)} ${(YA - sign * H1 * Math.sqrt(R1 / r)).toFixed(1)}`;
	}
	return d;
};
const a15 = (15 * Math.PI) / 180;
const arc = (r: number) => `M${(OX + r * Math.cos(a15)).toFixed(1)} ${(80 - r * Math.sin(a15)).toFixed(1)} A${r} ${r} 0 0 1 ${(OX + r * Math.cos(a15)).toFixed(1)} ${(80 + r * Math.sin(a15)).toFixed(1)}`;
---

<VdvStyles />
<figure class="g7 g7--pic vdv not-content" data-vdv-rings>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Вид сверху: от брошенного камня по воде расходятся круги. Выделенный узкий сектор: дуга на расстоянии 4r в 4 раза длиннее дуги на расстоянии r. Внизу разрез воды: гребень на расстоянии 4r вдвое ниже, чем на расстоянии r">
			<clipPath id="vdv-rings-clip"><rect x="0" y="0" width="360" height="156" rx="6"></rect></clipPath>
			<rect class="vdv-pond" x="0" y="0" width="360" height="156" rx="6"></rect>
			<g clip-path="url(#vdv-rings-clip)">
				<path class="vdv-sector" d={`M${OX} 80 L${(OX + 400 * Math.cos(a15)).toFixed(1)} ${(80 - 400 * Math.sin(a15)).toFixed(1)} L${(OX + 400 * Math.cos(a15)).toFixed(1)} ${(80 + 400 * Math.sin(a15)).toFixed(1)} Z`}></path>
				<g data-rings></g>
				<path class="vdv-arc" d={arc(R1)}></path>
				<path class="vdv-arc" d={arc(R4)}></path>
				<circle class="vdv-splash" cx={OX} cy="80" r="3" data-splash></circle>
				<circle class="vdv-stone" cx={OX} cy="80" r="4" data-stone></circle>
			</g>
			<text class="t-small t-halo" x={OX + R1 + 8} y="104">дуга на расстоянии <tspan class="t-i">r</tspan></text>
			<text class="t-small t-halo" x={OX + R4 - 6} y="146" text-anchor="end">дуга на расстоянии 4<tspan class="t-i">r</tspan> — в 4 раза длиннее</text>
			<text class="t-small" x={OX - 6} y="96" text-anchor="end">O</text>
			<!-- the cross-section -->
			<text class="t-small vdv-faint" x="352" y="172" text-anchor="end">разрез вдоль сектора</text>
			<path class="vdv-env" d={env(1)}></path>
			<path class="vdv-water2" data-water></path>
			<path class="vdv-surf" data-surf></path>
			<line class="vdv-axis" x1={OX} y1={YA} x2="350" y2={YA} stroke-dasharray="2 3"></line>
			<line class="vdv-tick" x1={OX + R1} y1={YA - H1} x2={OX + R1} y2="238"></line>
			<line class="vdv-tick" x1={OX + R4} y1={YA - H1 / 2} x2={OX + R4} y2="238"></line>
			<text class="t-small" x={OX + R1 + 4} y="247"><tspan class="t-i">r</tspan></text>
			<text class="t-small" x={OX + R4 + 4} y="247">4<tspan class="t-i">r</tspan></text>
			<text class="t-small t-halo" x={OX + R1 + 6} y={YA - H1 - 16}>гребень высотой <tspan class="t-i">h</tspan></text>
			<text class="t-small t-halo" x={OX + R4 - 6} y={YA - H1 / 2 - 8} text-anchor="end">вдвое ниже: <tspan class="t-i">h</tspan>/2</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Вверху — вид сверху, внизу — разрез воды вдоль выделенного сектора. Энергия, которая бежит внутри сектора,
		распределяется по всё более длинной дуге, поэтому гребни становятся ниже. Потери энергии не показаны.
	</figcaption>
</figure>

<script>
	import { el, f1, cycleLoop, TAU } from './vdv';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-vdv-rings]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const OX = 40;
		const OY = 80;
		const V = 60; // px per s
		const LAM = 30;
		const NCR = 5; // crests in the group
		const R1 = 60;
		const H1 = 18;
		const YA = 214;
		const T0 = 0.3; // the stone hits the water
		const rings = Array.from({ length: NCR }, () => {
			const c = el('circle', { class: 'vdv-ring', cx: OX, cy: OY });
			q('[data-rings]').append(c);
			return c;
		});
		const surf = q('[data-surf]');
		const water = q('[data-water]');
		const stone = q('[data-stone]');
		const splash = q('[data-splash]');
		// the height of the water surface at the distance r (px) at time τ after the stone (s)
		const eta = (r: number, tau: number) => {
			const front = V * tau;
			const back = front - NCR * LAM;
			if (tau <= 0 || r > front || r < Math.max(back, 0)) return 0;
			const w = Math.sin((Math.PI * (front - r)) / (NCR * LAM)) ** 2; // a smooth group
			return H1 * Math.sqrt(R1 / Math.max(r, 30)) * w * Math.cos((TAU * (r - front)) / LAM + Math.PI); // crests at r = front − (n + ½)·λ
		};
		const draw = (t: number) => {
			const tau = t - T0;
			// the stone falls into O (shrinking: it goes away from the viewer, down into the water)
			stone.setAttribute('r', tau < 0 ? f1(4 + 10 * (-tau)) : '0');
			splash.setAttribute('r', tau > 0 && tau < 0.6 ? f1(3 + 14 * tau) : '0');
			splash.setAttribute('opacity', tau > 0 && tau < 0.6 ? f1(1 - tau / 0.6) : '0');
			rings.forEach((c, n) => {
				// the crests are where the phase is a whole number of turns: r = front − (n + 0,5)·λ
				const r = V * tau - (n + 0.5) * LAM;
				const h = r > 4 ? Math.abs(eta(r, tau)) / H1 : 0;
				c.setAttribute('r', f1(Math.max(0, r)));
				c.setAttribute('opacity', f1(Math.min(1, 0.25 + 1.2 * h)));
				c.setAttribute('stroke-width', f1(0.8 + 2.6 * h));
				c.style.display = r > 4 ? '' : 'none';
			});
			let d = '';
			for (let x = OX; x <= 356; x += 2) d += `${x === OX ? 'M' : 'L'}${x} ${f1(YA - eta(x - OX, tau))}`;
			surf.setAttribute('d', d);
			water.setAttribute('d', `${d} L356 238 L${OX} 238 Z`);
		};
		cycleLoop(fig, 9, draw);
	}
</script>

<style is:global>
	.vdv .vdv-pond {
		fill: color-mix(in oklab, var(--ig-vx) 22%, var(--sl-color-bg));
	}
	.vdv .vdv-sector {
		fill: color-mix(in oklab, var(--sl-color-white) 10%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
	}
	.vdv .vdv-ring {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-white));
	}
	.vdv .vdv-arc {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.vdv .vdv-stone {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.vdv .vdv-splash {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
	}
	.vdv .vdv-env {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.vdv .vdv-water2 {
		fill: color-mix(in oklab, var(--ig-vx) 28%, var(--sl-color-bg));
	}
	.vdv .vdv-surf {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-white));
		stroke-width: 1.6;
	}
</style>
