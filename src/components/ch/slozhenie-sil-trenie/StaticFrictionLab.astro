---
/**
 * «Брусок на наклонной доске»: a wooden block of 1 кг (with up to three weights of 1 кг on it) lies on a board that
 * the reader tilts. Part of the force of gravity pulls the block down along the board: m·g·sin α (the blue arrow; the
 * 7th grade knows no sines, so it is only drawn and given as a number). While it is not greater than the greatest
 * friction of rest μ₀·m·g·cos α, the friction of rest holds the block and is equal to it (the red arrow, equal and
 * opposite). The block slides when tan α > μ₀: wood on wood μ₀ = 0,40 → 21,8° (at 21° it holds: 3,51 Н against
 * at most 3,66 Н; at 22° it slides: 3,67 Н against at most 3,63 Н); a board covered with ice μ₀ = 0,05 → 2,86°
 * (2,5° holds, 3° slides: 0,51 Н against 0,49 Н). The angle does not depend on the load: all forces grow alike.
 * Sliding friction μ·m·g·cos α (μ = 0,30 and 0,035, the same surfaces as in FrictionLab); the block slides with
 * a = g·(sin α − μ·cos α), in real time.
 *
 * Scales: the board is 1 м (300 px), the block 17 cm (50 px). Both arrows use one scale, fitted to the surface and the
 * load: the pull at the end of the angle slider (45° for wood, 6° for ice) is 95 px; the bar in the corner shows the
 * scale (a tidy 1, 2 or 5 Н… of at most 60 px). The blue arrow starts at the block's face looking down the board, the
 * red one at its upper edge along the board. The red mark at the end of the dotted red line is the greatest friction
 * of rest. The block starts 0,73 м up the board and slides down to a stop 0,34 м from the lower end, so that no
 * arrow ever reaches past the board (the longest blue arrow, 95 px, fits between the stop and the lower end; the
 * longest red one, at most 54 px, fits above the block). Simplified: the board tilts about its lower end, on a post.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const PX = 12;
const PY = 258;
---

<G7Styles />
<figure class="g7 g7--wide sfr not-content" data-sfr>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 292" role="img" aria-label="Брусок на доске, которую наклоняют; сила трения покоя удерживает брусок, пока наклон не станет слишком большим" data-svg>
			<defs>
				{['blue', 'red'].map((c) => <marker id={`sfr-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<text class="t-strong sfr__state" x="8" y="22" data-state></text>
			<rect class="sfr__table" x="0" y={PY} width="360" height="14"></rect>
			<rect class="sfr__post" data-post width="8"></rect>
			<g data-bar>
				<path class="sfr__bar" data-barline></path>
				<text class="t-small t-num" text-anchor="end" data-barlabel></text>
			</g>
			<path class="ln" data-arc></path>
			<text class="t-small t-num" data-alabel></text>
			<g data-board>
				<g transform="translate(0 -8)">
					<rect class="sfr__board" x="0" y="0" width="300" height="8"></rect>
					<rect class="sfr__ice" data-ice x="0" y="-1" width="300" height="4"></rect>
					<rect class="sfr__stop" x="96" y="-7" width="6" height="7" rx="1"></rect>
					<g data-block>
						<rect class="sfr__block" x="-25" y="-28" width="50" height="28" rx="2"></rect>
						<g data-loads></g>
						<line class="sfr__track" data-track x1="25" y1="-4" y2="-4"></line>
						<line class="arrow arrow--blue" data-pull x1="-25" y1="-14" y2="-14" marker-end={`url(#sfr-${uid}-blue)`}></line>
						<line class="arrow arrow--red" data-fric x1="25" y1="-4" y2="-4" marker-end={`url(#sfr-${uid}-red)`}></line>
						<line class="sfr__limit" data-limit y1="-7" y2="2"></line>
						<text class="t-blue t-num t-halo sfr__val" x="-29" y="-20" text-anchor="end" data-lpull></text>
						<text class="t-red t-num t-halo sfr__val" x="29" y="-10" data-lfric></text>
					</g>
				</g>
			</g>
		</svg>
		<div class="g7__side">
			<label class="g7__select">
				Поверхность
				<select data-surf aria-label="Поверхность">
					<option value="wood">Дерево по дереву</option>
					<option value="ice">Доска покрыта льдом</option>
				</select>
			</label>
			<label class="g7__slider">
				<span>Грузов по 1 кг на бруске</span>
				<output data-on></output>
				<input type="range" min="0" max="3" step="1" value="0" data-n aria-label="Число грузов на бруске" />
			</label>
			<label class="g7__slider">
				<span>Наклон доски</span>
				<output data-oa></output>
				<input type="range" min="0" max="45" step="1" value="0" data-a aria-label="Угол наклона доски, градусы" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сила тяжести бруска</span><b data-weight></b></li>
				<li><span>Тянет брусок вниз вдоль доски</span><b data-down></b></li>
				<li class="is-key"><span data-ftname>Сила трения покоя</span><b data-ft></b></li>
				<li><span>Наибольшая сила трения покоя</span><b data-fmax></b></li>
			</ul>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-back>Вернуть брусок наверх</button>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Синяя стрелка — часть силы тяжести, которая тянет брусок вниз вдоль доски, красная — сила трения; масштаб стрелок показан отрезком в углу. Красная чёрточка показывает наибольшую силу трения покоя.
	</figcaption>
</figure>

<style is:global>
	.sfr__table {
		fill: var(--g7-ground);
	}
	.sfr__post {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.sfr__board {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.sfr__ice {
		fill: hsl(200, 70%, 80%);
	}
	.sfr__stop {
		fill: var(--g7-wood-dark);
	}
	.sfr__block {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.sfr__load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.sfr__track {
		stroke: var(--g7-red);
		stroke-width: 1.4;
		stroke-dasharray: 1.5 3.5;
		stroke-linecap: round;
	}
	.sfr__bar {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.sfr__limit {
		stroke: var(--g7-red);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.g7__svg .sfr__val {
		font-weight: 700;
	}
	.g7__svg .sfr__state {
		font-size: 14px;
	}
</style>

<script>
	import { el, fmt, fmtTrim, loop } from '../g7/kit';

	const PX = 12;
	const PY = 258;
	const H = 292; // the height of the picture
	const D0 = 220; // the block's centre on the board, px from the lower end
	const DLOW = 127; // the centre when the block lies against the stop (96…102 px)
	const PXM = 300; // px per metre
	const ARROW = 95; // px for the pull at the end of the angle slider
	const G = 9.8;
	const SURF: Record<string, { s: number; k: number; amax: number; step: number; top: number }> = {
		wood: { s: 0.4, k: 0.3, amax: 45, step: 1, top: 0 },
		ice: { s: 0.05, k: 0.035, amax: 6, step: 0.5, top: 130 },
	};
	const rad = (a: number) => (a * Math.PI) / 180;

	for (const root of document.querySelectorAll<HTMLElement>('[data-sfr]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const surf = q<HTMLSelectElement>('[data-surf]');
		const nIn = q<HTMLInputElement>('[data-n]');
		const aIn = q<HTMLInputElement>('[data-a]');
		const loads = q<SVGGElement>('[data-loads]');
		let d = D0; // px along the board
		let v = 0; // м/с down the board
		let px = 1; // px per newton
		const mass = () => 1 + Number(nIn.value);
		const state = () => {
			const S = SURF[surf.value];
			const a = rad(Number(aIn.value));
			const w = mass() * G;
			const down = w * Math.sin(a);
			const fmax = S.s * w * Math.cos(a);
			const fk = S.k * w * Math.cos(a);
			const low = d <= DLOW + 1e-6;
			const moving = !low && (v > 1e-4 || down > fmax + 1e-9);
			const ft = low ? 0 : moving ? fk : down;
			return { S, a, w, down, fmax, fk, ft, low, moving };
		};
		const draw = () => {
			const { a, w, down, fmax, ft, low, moving } = state();
			const deg = Number(aIn.value);
			const c = Math.cos(a);
			const s = Math.sin(a);
			q('[data-board]').setAttribute('transform', `translate(${PX} ${PY}) rotate(${-deg})`);
			// the post under the raised end
			const pa = 282;
			const top = PY - pa * s;
			const post = q<SVGRectElement>('[data-post]');
			post.setAttribute('x', (PX + pa * c - 4).toFixed(1));
			post.setAttribute('y', top.toFixed(1));
			post.setAttribute('height', Math.max(0, PY - top).toFixed(1));
			// the angle at the lower end
			const r = 46;
			q('[data-arc]').setAttribute('d', deg > 0 ? `M${PX + r} ${PY} A${r} ${r} 0 0 0 ${(PX + r * c).toFixed(1)} ${(PY - r * s).toFixed(1)}` : '');
			const al = q('[data-alabel]');
			al.textContent = `${fmtTrim(deg, 1)}°`;
			if (deg >= 14) {
				al.setAttribute('x', (PX + 60 * Math.cos(a / 2)).toFixed(1));
				al.setAttribute('y', (PY - 60 * Math.sin(a / 2) + 4).toFixed(1));
			} else {
				al.setAttribute('x', String(PX + r + 4));
				al.setAttribute('y', String(PY + 26));
			}
			// the block and the two forces along the board
			q('[data-block]').setAttribute('transform', `translate(${d.toFixed(1)} 0)`);
			const lp = down * px;
			const lf = ft * px;
			const pull = q<SVGLineElement>('[data-pull]');
			const fric = q<SVGLineElement>('[data-fric]');
			pull.setAttribute('x2', (-25 - Math.max(0.5, lp - 4)).toFixed(1));
			pull.style.visibility = !low && lp > 3 ? 'visible' : 'hidden';
			fric.setAttribute('x2', (25 + Math.max(0.5, lf - 4)).toFixed(1));
			fric.style.visibility = lf > 3 ? 'visible' : 'hidden';
			const lim = q<SVGLineElement>('[data-limit]');
			lim.setAttribute('x1', (25 + fmax * px).toFixed(1));
			lim.setAttribute('x2', (25 + fmax * px).toFixed(1));
			q('[data-track]').setAttribute('x2', (25 + fmax * px).toFixed(1));
			q<SVGLineElement>('[data-track]').style.visibility = !low && !moving && deg > 0 ? 'visible' : 'hidden';
			lim.style.visibility = !low && !moving && deg > 0 ? 'visible' : 'hidden';
			const lpull = q('[data-lpull]');
			lpull.textContent = !low && down > 0 ? `${fmt(down, 2)}\u00a0Н` : '';
			const lfric = q('[data-lfric]');
			lfric.textContent = ft > 0 ? `${fmt(ft, 2)}\u00a0Н` : '';
			// readouts
			q('[data-on]').textContent = nIn.value;
			q('[data-oa]').textContent = `${fmt(deg, SURF[surf.value].step < 1 ? 1 : 0)}°`;
			q('[data-weight]').textContent = `${fmtTrim(w, 1)}\u00a0Н`;
			q('[data-down]').textContent = `${fmt(down, 2)}\u00a0Н`;
			q('[data-ftname]').textContent = low ? 'Сила трения' : moving ? 'Сила трения скольжения' : 'Сила трения покоя';
			q('[data-ft]').textContent = low ? '—' : `${fmt(ft, 2)}\u00a0Н`;
			q('[data-fmax]').textContent = `${fmt(fmax, 2)}\u00a0Н`;
			q('[data-state]').textContent = low ? 'Брусок съехал до упора' : moving ? 'Брусок скользит вниз' : 'Брусок покоится';
		};
		const setup = () => {
			const S = SURF[surf.value];
			// a nearly flat board needs less height: the picture is cropped from above
			q('[data-svg]').setAttribute('viewBox', `0 ${S.top} 360 ${H - S.top}`);
			q('[data-state]').setAttribute('y', String(S.top + 22));
			aIn.max = String(S.amax);
			aIn.step = String(S.step);
			aIn.value = '0';
			px = ARROW / (mass() * G * Math.sin(rad(S.amax)));
			// the scale bar: the largest tidy force (1, 2, 5 × 10ⁿ Н) not longer than 60 px
			let bar = 0.01;
			for (const e of [-2, -1, 0, 1, 2]) for (const m of [1, 2, 5]) if (m * 10 ** e * px <= 60) bar = m * 10 ** e;
			const bl = bar * px;
			q('[data-barline]').setAttribute('d', `M${(350 - bl).toFixed(1)} ${S.top + 13} v6 H350 v-6`);
			q('[data-barlabel]').setAttribute('x', (344 - bl).toFixed(1));
			q('[data-barlabel]').setAttribute('y', String(S.top + 22));
			q('[data-barlabel]').textContent = `${fmtTrim(bar, 2)}\u00a0Н`;
			q<SVGRectElement>('[data-ice]').style.visibility = surf.value === 'ice' ? 'visible' : 'hidden';
			loads.replaceChildren();
			for (let i = 0; i < Number(nIn.value); i++) loads.append(el('rect', { class: 'sfr__load', x: -17, y: -40 - i * 13, width: 34, height: 12, rx: 2 }));
			d = D0;
			v = 0;
			draw();
		};
		const wake = loop(root, (dt) => {
			const { S, a, moving } = state();
			if (!moving) {
				v = 0;
				draw();
				return false;
			}
			// down the board: a = g·(sin α − μ·cos α); it may be negative if the board was lowered
			v = Math.max(0, v + G * (Math.sin(a) - S.k * Math.cos(a)) * dt);
			d = Math.max(DLOW, d - v * PXM * dt);
			if (d <= DLOW) v = 0;
			draw();
			return d > DLOW && (v > 0 || state().moving);
		});
		aIn.addEventListener('input', () => {
			draw();
			wake();
		});
		nIn.addEventListener('input', setup);
		surf.addEventListener('change', setup);
		q('[data-back]').addEventListener('click', () => {
			d = D0;
			v = 0;
			draw();
			wake();
		});
		setup();
	}
</script>
