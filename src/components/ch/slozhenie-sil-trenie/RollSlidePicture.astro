---
/**
 * Picture «Скольжение и качение» (Irina, 17 Nov 2026: «к трению качения и скольжения сделать пояснительные рисунки»).
 * Two panels, the same load of 20 кг pulled slowly and evenly through a dynamometer, so the dynamometer shows the
 * force of friction. The force pressing the load to the floor is 9,8 Н/кг · 20 кг = 196 Н.
 *   Скольжение — a wooden box dragged over a wooden floor: friction 0,30 of 196 Н = 58,8 ≈ 59 Н (wood on wood, as
 *   in the model FrictionLab above).
 *   Качение — the same box on a light trolley with small hard wheels (the trolley's mass is neglected): friction
 *   0,02 of 196 Н = 3,9 ≈ 4 Н (as the round pencils of FrictionLab), 15 times less.
 * The dynamometers are drawn in one scale, 0,6 px per newton; the pointer trembles a little (±1 Н when sliding).
 * The camera follows the load: the floor moves to the left at 18 px/s.
 * Below, the places of contact much magnified (the bumps and the dent of the road are exaggerated):
 *   sliding — the rough bottom of the box rests on the rough floor at its highest bumps (computed every frame), which
 *   catch and ride over each other along the whole bottom; the box bobs as they pass;
 *   rolling — a wheel of 52 px presses a dent of 3 px into the road; in front the road is being pressed, behind it
 *   springs back slowly, so the wheel touches it at a short patch. The wheel turns at ω = υ/r with no slipping: each of
 *   the four gold points of the rim comes down on a gold mark of the road (spaced by a quarter of the rim, 2π·52/4 px)
 *   and is lifted from the same mark.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 0.6; // px per newton on the dynamometers
const FL = 120; // the floor in the scene
const RW = 52; // the wheel in the magnifier
const SINK = 3;
const ROAD = 250;
const CX = 120;
const CY = ROAD + SINK - RW;
const f = (v: number) => v.toFixed(1);
const panels = [
	{ key: 'slide', title: 'Скольжение', sub: 'ящик тянут волоком', F: 58.8, read: '59 Н', note: 'выступы цепляются друг за друга' },
	{ key: 'roll', title: 'Качение', sub: 'тот же ящик на тележке', F: 3.9, read: '4 Н', note: 'колесо не скользит, а перекатывается' },
];
// the dynamometer: the plate 110…176, zero at 170, the pointer at 170 − K·F, the hook 66 px to the left of the pointer
const dyn = (F: number) => ({ p: 170 - K * F, h: 104 - K * F });
---

<G7Styles />
<figure class="g7 g7--pic rsl not-content" data-rollslide>
	<div class="g7__grid is-two">
		{
			panels.map((P) => {
				const d = dyn(P.F);
				return (
					<svg class="g7__svg" viewBox="0 0 240 300" role="img" data-panel={P.key} data-f={P.F} aria-label={P.key === 'slide' ? 'Ящик тянут волоком, динамометр показывает 59 ньютонов; под увеличением выступы днища цепляются за выступы пола' : 'Тот же ящик на тележке, динамометр показывает 4 ньютона; под увеличением колесо касается дороги маленьким пятном'}>
						<text class="t-title" x="120" y="18" text-anchor="middle">{P.title}</text>
						<text class="t-small" x="120" y="33" text-anchor="middle">{P.sub}</text>
						<!-- the floor, moving -->
						<rect class="rsl__floor" x="0" y={FL} width="240" height="9" />
						<g data-seams>
							{Array.from({ length: 8 }, (_, i) => (
								<line class="rsl__seam" x1={i * 40} x2={i * 40} y1={FL} y2={FL + 9} />
							))}
						</g>
						{P.key === 'slide' ? (
							<g>
								<rect class="rsl__box" x="14" y={FL - 36} width="48" height="36" rx="1.5" />
								<path class="rsl__boxline" d={`M14 ${FL - 18} H62 M38 ${FL - 36} V${FL}`} />
								<text class="t-small rsl__boxtext" x="38" y={FL - 21} text-anchor="middle">20 кг</text>
								<line class="rsl__rope" x1="62" y1={FL - 18} x2={f(d.h)} y2={FL - 18} data-rope />
							</g>
						) : (
							<g>
								<rect class="rsl__box" x="16" y={FL - 46} width="44" height="32" rx="1.5" />
								<path class="rsl__boxline" d={`M16 ${FL - 30} H60 M38 ${FL - 46} V${FL - 14}`} />
								<text class="t-small rsl__boxtext" x="38" y={FL - 33} text-anchor="middle">20 кг</text>
								<rect class="rsl__cart" x="11" y={FL - 15} width="54" height="5" rx="1" />
								{[22, 54].map((x) => (
									<g data-wheel={x}>
										<circle class="rsl__wheel" cx={x} cy={FL - 5} r="5" />
										<line class="rsl__spoke" x1={x - 4} x2={x + 4} y1={FL - 5} y2={FL - 5} />
									</g>
								))}
								<line class="rsl__rope" x1="65" y1={FL - 13} x2={f(d.h)} y2={FL - 18} data-rope />
							</g>
						)}
						<!-- the dynamometer -->
						<rect class="rsl__plate" x="110" y={FL - 26} width="66" height="16" rx="3" />
						{[0, 20, 40, 60].map((v) => (
							<g>
								<line class="rsl__tick" x1={170 - K * v} x2={170 - K * v} y1={FL - 26} y2={FL - 21} />
								<text class="rsl__ticknum" x={170 - K * v} y={FL - 29} text-anchor="middle">{v}</text>
							</g>
						))}
						<g data-pointer>
							<path class="rsl__spring" data-spring d="" />
							<line class="rsl__rod" x1={f(d.h)} x2={f(d.p)} y1={FL - 18} y2={FL - 18} data-rod />
							<path class="rsl__pointer" data-ptr d={`M${f(d.p)} ${FL - 25} V${FL - 11}`} />
						</g>
						<line class="rsl__rope" x1="176" y1={FL - 18} x2="208" y2={FL - 18} />
						<path class="rsl__arm" d={`M214 ${FL - 18} L240 ${FL - 40}`} />
						<circle class="rsl__fist" cx="212" cy={FL - 18} r="6.5" />
						<text class="t-strong t-num t-gold t-halo" x="143" y={FL - 52} text-anchor="middle">{P.read}</text>
						<text class="t-small" x="143" y={FL - 40} text-anchor="middle">динамометр</text>

						<!-- the magnifier -->
						<path class="ln-dash" d={P.key === 'slide' ? `M38 ${FL + 1} V148` : `M22 ${FL + 1} V148`} />
						<rect class="rsl__frame" x="8" y="148" width="224" height="128" rx="8" />
						<clipPath id={`rsl-clip-${P.key}`}><rect x="9" y="149" width="222" height="126" rx="7" /></clipPath>
						<g clip-path={`url(#rsl-clip-${P.key})`}>
							{P.key === 'slide' ? (
								<g>
									<path class="rsl__floor" data-flr d="" />
									<path class="rsl__boxbig" data-boxbig d="" />
									<g data-touch>
										{Array.from({ length: 8 }, () => (
											<circle class="rsl__touch" r="5" cx="-20" cy="-20" />
										))}
									</g>
								</g>
							) : (
								<g>
									<path class="rsl__road" data-road d="" />
									<g data-marks />
									<path class="rsl__contact" data-contact d="" />
									<g data-bigwheel>
										<circle class="rsl__tyre" cx={CX} cy={f(CY)} r={RW - 3} />
										<circle class="rsl__disc" cx={CX} cy={f(CY)} r={RW - 9} />
										{[0, 1, 2, 3, 4, 5].map((i) => (
											<line class="rsl__bigspoke" x1={CX} y1={f(CY)} x2={f(CX + (RW - 9) * Math.cos((i * Math.PI) / 3))} y2={f(CY + (RW - 9) * Math.sin((i * Math.PI) / 3))} />
										))}
										{[0, 1, 2, 3].map((i) => (
											<circle class="rsl__dot" cx={f(CX + (RW - 1.5) * Math.cos(Math.PI / 2 + (i * Math.PI) / 2))} cy={f(CY + (RW - 1.5) * Math.sin(Math.PI / 2 + (i * Math.PI) / 2))} r="3" />
										))}
									</g>
									<circle class="rsl__hub" cx={CX} cy={f(CY)} r="6" />
									<path class="rsl__lead" d={`M52 258 L${CX - 24} ${ROAD + 2}`} />
									<text class="t-small t-halo" x="14" y="267">распрямляется</text>
									<path class="rsl__lead" d={`M188 258 L${CX + 14} ${ROAD + 2}`} />
									<text class="t-small t-halo" x="226" y="267" text-anchor="end">вдавливается</text>
								</g>
							)}
						</g>
						<text class="t-small" x={P.key === 'slide' ? 46 : 30} y="143">под увеличением</text>
						<text class="t-small" x="120" y="292" text-anchor="middle">{P.note}</text>
					</svg>
				);
			})
		}
	</div>
	<figcaption class="g7__caption">
		Груз массой 20&nbsp;кг тянут медленно и равномерно, поэтому динамометр показывает силу трения: волоком — около 59&nbsp;Н, на колёсах — около 4&nbsp;Н, в 15&nbsp;раз меньше. Внизу места соприкосновения под сильным увеличением; выступы и вмятина пола преувеличены.
	</figcaption>
</figure>

<style is:global>
	.rsl__floor {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.rsl__seam {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.rsl__box {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.rsl__boxline {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.g7__svg .rsl__boxtext {
		fill: var(--sl-color-black);
		font-weight: 700;
	}
	:root[data-theme='light'] .g7__svg .rsl__boxtext {
		fill: var(--sl-color-white);
	}
	.rsl__boxbig {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.rsl__cart {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.rsl__wheel {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.rsl__spoke {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.rsl__rope {
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.rsl__plate {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.rsl__tick {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.g7__svg .rsl__ticknum {
		font-size: 8px;
		fill: var(--sl-color-gray-3);
	}
	.rsl__spring {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 1.2;
	}
	:root[data-theme='light'] .rsl__spring {
		stroke: var(--g7-line);
	}
	.rsl__rod {
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.rsl__pointer {
		stroke: var(--g7-red);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.rsl__arm {
		stroke: var(--g7-skin);
		stroke-width: 7;
		stroke-linecap: round;
	}
	.rsl__fist {
		fill: var(--g7-skin);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.rsl__frame {
		fill: var(--g7-paper);
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.rsl__touch {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.8;
	}
	.rsl__road {
		fill: var(--g7-ground);
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .rsl__road {
		fill: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-6));
	}
	.rsl__lead {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.rsl__contact {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.rsl__tyre {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 6;
	}
	:root[data-theme='light'] .rsl__tyre {
		stroke: var(--sl-color-gray-2);
	}
	.rsl__disc {
		fill: var(--g7-steel);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.rsl__bigspoke {
		stroke: var(--g7-steel-dark);
		stroke-width: 3;
	}
	.rsl__hub {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.rsl__dot,
	.rsl__mark {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
</style>

<script>
	import { el, loop, rng } from '../g7/kit';

	const K = 0.6;
	const FL = 120;
	const RW = 52;
	const SINK = 3;
	const ROAD = 250;
	const CX = 120;
	const CY = ROAD + SINK - RW;
	const V_SCENE = 18; // px/s, the floor in the scene
	const V_BIG = 22; // px/s, the road in the magnifier
	const PERIOD = 240; // px: the rough floor repeats itself

	// rough profiles (magnifier, sliding): teeth of about the same pitch (16 px) and uneven heights, so that the bumps
	// of the box sink between the bumps of the floor and have to ride over them
	const teeth = (seed: number, from: number, to: number, base: number, amp: number, dir: number) => {
		const r = rng(seed);
		const pts: [number, number][] = [];
		for (let x = from; x <= to; x += 16) {
			pts.push([x, base]);
			pts.push([x + 6 + 4 * r(), base + dir * amp * (0.55 + 0.45 * r())]);
		}
		return pts;
	};
	const floorPts = teeth(7, 0, PERIOD - 16, 220, 12, -1);
	const boxPts = teeth(31, 0, 240, 198, 12, 1);
	const interp = (pts: [number, number][], x: number) => {
		for (let i = 1; i < pts.length; i++)
			if (x <= pts[i][0]) {
				const [x0, y0] = pts[i - 1];
				const [x1, y1] = pts[i];
				return y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
			}
		return pts[pts.length - 1][1];
	};
	// the floor top at x when the floor has moved by s to the left (periodic, closed between the last and first point)
	const floorAt = (x: number, s: number) => {
		const p = [...floorPts, [PERIOD, floorPts[0][1]] as [number, number]];
		const xx = (((x + s) % PERIOD) + PERIOD) % PERIOD;
		return interp(p, xx);
	};
	// the road in the magnifier: flat, a dent that follows the wheel; in front the circle, behind a slow recovery
	const W_FRONT = Math.sqrt(RW * RW - (RW - SINK) ** 2); // ≈ 17,9 px
	const BACK_C = 8; // the contact ends 8 px behind the lowest point
	const yCircle = (x: number) => CY + Math.sqrt(Math.max(0, RW * RW - (x - CX) ** 2));
	const roadY = (x: number) => {
		if (x >= CX + W_FRONT) return ROAD;
		if (x >= CX - BACK_C) return yCircle(x);
		const x0 = CX - BACK_C;
		const x1 = CX - 44;
		if (x <= x1) return ROAD;
		const k = (x0 - x) / (x0 - x1); // 0 at the contact, 1 where the road is flat again
		const s = k * k * (3 - 2 * k);
		return yCircle(x0) + (ROAD - yCircle(x0)) * s;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-rollslide]')) {
		const panels = [...root.querySelectorAll<SVGSVGElement>('[data-panel]')].map((svg) => {
			const q = <T extends Element>(s: string) => svg.querySelector<T>(s);
			return {
				svg,
				key: svg.dataset.panel!,
				F: Number(svg.dataset.f),
				seams: q<SVGGElement>('[data-seams]')!,
				spring: q<SVGPathElement>('[data-spring]')!,
				rod: q<SVGLineElement>('[data-rod]')!,
				ptr: q<SVGPathElement>('[data-ptr]')!,
				rope: q<SVGLineElement>('[data-rope]')!,
				wheels: [...svg.querySelectorAll<SVGGElement>('[data-wheel]')],
				flr: q<SVGPathElement>('[data-flr]'),
				boxbig: q<SVGPathElement>('[data-boxbig]'),
				touch: q<SVGGElement>('[data-touch]'),
				road: q<SVGPathElement>('[data-road]'),
				marks: q<SVGGElement>('[data-marks]'),
				contact: q<SVGPathElement>('[data-contact]'),
				big: q<SVGGElement>('[data-bigwheel]'),
			};
		});
		// static parts of the rolling magnifier
		for (const p of panels) {
			if (p.key !== 'roll') continue;
			let d = `M0 ${ROAD}`;
			for (let x = 0; x <= 240; x += 1) d += ` L${x} ${roadY(x).toFixed(2)}`;
			p.road!.setAttribute('d', `${d} L240 290 L0 290 Z`);
			let c = '';
			for (let x = CX - BACK_C; x <= CX + W_FRONT; x += 1) c += `${c ? 'L' : 'M'}${x} ${roadY(x).toFixed(2)} `;
			p.contact!.setAttribute('d', c);
			for (let i = 0; i < 4; i++) p.marks!.append(el('rect', { class: 'rsl__mark', width: 3, height: 7, y: 0, x: -1.5 }));
		}
		let t = 0;
		const draw = () => {
			const s = V_SCENE * t;
			for (const p of panels) {
				p.seams.setAttribute('transform', `translate(${(-(s % 40)).toFixed(2)} 0)`);
				// the dynamometer: the pointer trembles a little while the load moves
				const jit = p.key === 'slide' ? 1.0 * Math.sin(t * 9.1) * Math.sin(t * 3.3) : 0.15 * Math.sin(t * 7);
				const F = p.F + jit;
				const px = 170 - K * F;
				const hx = 104 - K * F;
				p.ptr.setAttribute('d', `M${px.toFixed(2)} ${FL - 25} V${FL - 11}`);
				p.rod.setAttribute('x1', hx.toFixed(2));
				p.rod.setAttribute('x2', px.toFixed(2));
				p.rope.setAttribute('x2', hx.toFixed(2));
				let z = `M${(px + 1).toFixed(2)} ${FL - 18}`;
				const n = 8;
				const L = 172 - (px + 1);
				for (let i = 1; i <= n; i++) z += ` L${(px + 1 + (L * (i - 0.5)) / n).toFixed(2)} ${FL - 18 + (i % 2 ? -4 : 4)}`;
				z += ` L172 ${FL - 18}`;
				p.spring.setAttribute('d', z);
				for (const w of p.wheels) {
					const x = Number(w.dataset.wheel);
					w.setAttribute('transform', `rotate(${((s / 5) * 180) / Math.PI} ${x} ${FL - 5})`);
				}
				if (p.key === 'slide') {
					// the box rests on the highest bumps of the floor
					const sb = V_BIG * t;
					let h = Infinity;
					const gaps: number[] = [];
					for (let x = 0; x <= 240; x++) {
						const g = floorAt(x, sb) - interp(boxPts, x);
						gaps.push(g);
						if (x >= 9 && x <= 231 && g < h) h = g;
					}
					let fd = `M0 290 L0 ${floorAt(0, sb).toFixed(2)}`;
					for (let x = 2; x <= 240; x += 2) fd += ` L${x} ${floorAt(x, sb).toFixed(2)}`;
					p.flr!.setAttribute('d', `${fd} L240 290 Z`);
					let bd = 'M0 140';
					for (const [x, y] of boxPts) bd += ` L${x.toFixed(2)} ${(y + h).toFixed(2)}`;
					p.boxbig!.setAttribute('d', `${bd} L240 ${(boxPts[boxPts.length - 1][1] + h).toFixed(2)} L240 140 Z`);
					// mark the places where the bumps touch or nearly touch (within 1,5 px)
					const rings = [...p.touch!.children] as SVGCircleElement[];
					let k = 0;
					let last = -99;
					for (let x = 12; x <= 228; x++) {
						if (gaps[x] - h < 1.5 && x - last > 10 && k < rings.length) {
							rings[k].setAttribute('cx', String(x));
							rings[k].setAttribute('cy', (floorAt(x, sb) - 1).toFixed(2));
							k++;
							last = x;
						}
					}
					for (; k < rings.length; k++) rings[k].setAttribute('cx', '-20');
				} else {
					const sb = V_BIG * t;
					const ang = sb / RW; // rad, clockwise
					p.big!.setAttribute('transform', `rotate(${((ang * 180) / Math.PI).toFixed(3)} ${CX} ${CY.toFixed(2)})`);
					// the gold marks of the road: a quarter of the rim apart, one under the wheel at t = 0
					const step = (2 * Math.PI * RW) / 4;
					const marks = [...p.marks!.children] as SVGRectElement[];
					marks.forEach((m, i) => {
						let d = ((((i * step - sb) % (4 * step)) + 4 * step) % (4 * step));
						if (d >= 2 * step) d -= 4 * step;
						const x = CX + d;
						m.setAttribute('x', (x - 1.5).toFixed(2));
						m.setAttribute('y', (roadY(x) + 0.5).toFixed(2));
					});
				}
			}
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
