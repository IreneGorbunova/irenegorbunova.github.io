---
/**
 * Picture «Лебедь, Рак да Щука» (Irina, 17 Nov 2026: «в равнодействующую силу добавь ещё анимацию из басни»).
 * I. A. Krylov's fable (1814): «Поклажа бы для них казалась и легка: Да Лебедь рвётся в облака, Рак пятится назад,
 * а Щука тянет в воду. … Да только воз и ныне там».
 *
 * Left: the cart seen from the side. The swan pulls up and a little forward (75° above the road), the crayfish
 * backward along the road, the pike forward and down toward the river (35° below the road). Each pull is 100 Н
 * (the numbers are invented; the animals are not to scale). The force arrows start where the ropes are tied:
 * 0,4 px per newton.
 * Right: the same three forces added by drawing (each arrow from the end of the previous one), 0,75 px per newton:
 *   along the road  100·cos 75° − 100 + 100·cos 35° = 25,9 − 100 + 81,9 = 7,8 Н forward,
 *   up              100·sin 75° − 100·sin 35° = 96,6 − 57,4 = 39,2 Н,
 *   the resultant   √(7,8² + 39,2²) = 40,0 Н.
 * The cart with its load is 200 кг (weight 1960 Н); to start it along the road one has to pull along the road with
 * more than 150 Н (a resistance of rolling on a dirt road of about 0,08 of the weight). The resultant pushes it along
 * the road with 7,8 Н only, and lifts it with 39 Н, far less than its weight: the cart stays. If all three pulled
 * forward, 300 Н > 150 Н, the cart would go — «поклажа бы для них казалась и легка».
 * The animation: the animals strain (wings, legs, tail) and the cart rocks by ±0,6° (exaggerated); the arrows of the
 * right panel are drawn one after another in a cycle of 9 s.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const GY = 214; // the road
const D = Math.PI / 180;
const u = {
	swan: [Math.cos(75 * D), -Math.sin(75 * D)],
	crab: [-1, 0],
	pike: [Math.cos(35 * D), Math.sin(35 * D)],
};
// scene: where the ropes are tied and how long the arrows are (0,4 px/Н)
const KS = 0.4;
const tie = { swan: [192, 144], crab: [108, 188], pike: [226, 170] };
const swanAt = [tie.swan[0] + 100 * u.swan[0], tie.swan[1] + 100 * u.swan[1]];
const pikeAt = [tie.pike[0] + 120 * u.pike[0], tie.pike[1] + 120 * u.pike[1]];
const arrow = (k: keyof typeof u) => ({ x1: tie[k][0], y1: tie[k][1], x2: tie[k][0] + 100 * KS * u[k][0], y2: tie[k][1] + 100 * KS * u[k][1] });
// the swan's group: local (0,7) — the harness — at swanAt, turned by −30°
const sa = -30 * D;
const swanT = [swanAt[0] - (-7 * Math.sin(sa)), swanAt[1] - 7 * Math.cos(sa)];
// right panel: 0,75 px/Н
const KP = 0.75;
const O = [128, 134];
const A = [O[0] + 100 * KP * u.swan[0], O[1] + 100 * KP * u.swan[1]];
const B = [A[0] + 100 * KP * u.crab[0], A[1] + 100 * KP * u.crab[1]];
const C = [B[0] + 100 * KP * u.pike[0], B[1] + 100 * KP * u.pike[1]];
const R = Math.hypot(C[0] - O[0], C[1] - O[1]) / KP; // 40 Н
const L0 = 8; // the line of row 2
const LY = 224;
const f = (v: number) => v.toFixed(1);
const chain = [
	{ c: 'blue', p: [O, A] },
	{ c: 'gold', p: [A, B] },
	{ c: 'green', p: [B, C] },
	{ c: 'red', p: [O, C] },
	{ c: 'blue', p: [[L0, LY], [L0 + 75, LY]] },
	{ c: 'gold', p: [[L0 + 75, LY], [L0 + 150, LY]] },
	{ c: 'green', p: [[L0 + 150, LY], [L0 + 225, LY]] },
];
---

<G7Styles />
<figure class="g7 g7--pic fab not-content" data-fable>
	<div class="fab__grid">
		<svg class="g7__svg" viewBox="0 0 360 270" role="img" aria-label="Лебедь тянет воз вверх, рак — назад, щука — к реке. Воз стоит на месте">
			<defs>
				{['blue', 'gold', 'green', 'red'].map((c) => <marker id={`fab-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
				{['blue', 'gold', 'green', 'red'].map((c) => <marker id={`fabp-${uid}-${c}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="3.4" markerHeight="3.4" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<rect class="fab__sky" x="0" y="0" width="360" height={GY}></rect>
			<g class="fab__cloud">
				<path d="M268 40 a12 12 0 0 1 20 -10 a16 16 0 0 1 30 2 a11 11 0 0 1 8 18 H272 a9 9 0 0 1 -4 -10 Z"></path>
				<path d="M306 84 a8 8 0 0 1 13 -6 a11 11 0 0 1 20 2 a7 7 0 0 1 4 12 H309 a6 6 0 0 1 -3 -8 Z"></path>
			</g>
			<rect class="fab__water" x="248" y="224" width="112" height="46"></rect>
			<path class="fab__wave" d="M250 224 q6 -3 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0"></path>
			<path class="fab__ground" d={`M0 ${GY} H244 Q257 216 262 226 L270 270 H0 Z`}></path>
			<path class="fab__grass" d={`M0 ${GY} H244 Q257 216 262 226`}></path>
			<circle class="fab__ripple" cx="298" cy="224" r="4" data-ripple></circle>
			<g data-bubbles>
				<circle class="fab__bubble" cx="350" cy="250" r="1.8"></circle>
				<circle class="fab__bubble" cx="347" cy="258" r="1.3"></circle>
			</g>

			<!-- the ropes -->
			<line class="fab__rope" x1={tie.swan[0]} y1={tie.swan[1]} x2={f(swanAt[0])} y2={f(swanAt[1])}></line>
			<line class="fab__rope" x1={tie.crab[0]} y1={tie.crab[1]} x2="66" y2={tie.crab[1]}></line>
			<line class="fab__rope" x1={tie.pike[0]} y1={tie.pike[1]} x2={f(pikeAt[0])} y2={f(pikeAt[1])}></line>

			<!-- the cart -->
			<g data-cart>
				<line class="fab__shaft" x1="194" y1="178" x2="230" y2="170"></line>
				{[
					[126, 154, 19, 12],
					[180, 154, 18, 12],
					[153, 150, 19, 14],
					[154, 135, 16, 10],
				].map(([x, y, rx, ry]) => (
					<g>
						<ellipse class="fab__sack" cx={x} cy={y} rx={rx} ry={ry} />
						<path class="fab__tie" d={`M${x - 4} ${y - ry + 1} Q${x} ${y - ry - 2} ${x + 4} ${y - ry + 1} M${x} ${y - ry} l-3 -5 M${x} ${y - ry} l3 -5`} />
					</g>
				))}
				<path class="fab__body" d="M104 164 H200 L195 189 H109 Z"></path>
				<path class="fab__plank" d="M106 172 H198 M108 181 H196"></path>
				{[128, 178].map((cx) => (
					<g>
						<circle class="fab__wheel" cx={cx} cy={GY - 16} r="16" />
						<path class="fab__spoke" d={Array.from({ length: 4 }, (_, i) => `M${f(cx + 14 * Math.cos((i * 45 + 10) * D))} ${f(GY - 16 + 14 * Math.sin((i * 45 + 10) * D))} L${f(cx - 14 * Math.cos((i * 45 + 10) * D))} ${f(GY - 16 - 14 * Math.sin((i * 45 + 10) * D))}`).join(' ')} />
						<circle class="fab__hub" cx={cx} cy={GY - 16} r="3.5" />
					</g>
				))}
			</g>

			<!-- the swan, flying up -->
			<g transform={`translate(${f(swanT[0])} ${f(swanT[1])}) rotate(-30)`}>
				<path class="fab__swan" d="M-17 0 L-26 -4 L-24 3 Z"></path>
				<path class="fab__neck" d="M12 -2 C22 -4 30 -6 37 -9"></path>
				<ellipse class="fab__swan" cx="0" cy="0" rx="18" ry="7.5"></ellipse>
				<ellipse class="fab__swan" cx="39" cy="-9.5" rx="5" ry="3.8"></ellipse>
				<path class="fab__beak" d="M43 -11.5 L50 -9 L43 -7.5 Z"></path>
				<circle class="fab__eye" cx="40" cy="-10.5" r="0.9"></circle>
				<path class="fab__strap" d="M-1 -7 V7"></path>
				<g transform="translate(-4 -4)"><path class="fab__swan fab__wing" d="M0 0 C-6 -14 -2 -30 -12 -44 C6 -38 20 -22 18 0 Z" data-wing></path></g>
			</g>

			<!-- the crayfish: faces the cart and walks backward -->
			<g data-crab>
				<g class="fab__legs" data-crablegs>
					<path d="M26 206 L21 214 M31 207 L28 214 M36 207 L37 214 M41 206 L44 214"></path>
				</g>
				<path class="fab__crab" d="M9 206 L1 198 L-1 206 L1 214 Z" data-crabtail></path>
				<ellipse class="fab__crab" cx="11" cy="206" rx="5" ry="5.5"></ellipse>
				<ellipse class="fab__crab" cx="18" cy="205.5" rx="5" ry="6.5"></ellipse>
				<ellipse class="fab__crab" cx="34" cy="204" rx="13" ry="7.5"></ellipse>
				<path class="fab__crabarm" d="M44 200 Q47 195 50 192"></path>
				<path class="fab__crabarm" d="M43 203 Q49 200 52 198"></path>
				<path class="fab__crab" d="M49 193 C52 182 64 181 67 187 L58 188.5 L66 191 C63 197 53 198 49 193 Z"></path>
				<path class="fab__crab" d="M51 199 C55 192 64 192 66 196 L59 197.5 L65 200 C62 204 55 204 51 199 Z"></path>
				<path class="fab__antenna" d="M46 199 Q66 194 86 200 M46 201 Q64 204 80 211"></path>
				<circle class="fab__eye" cx="45" cy="199" r="1.1"></circle>
			</g>

			<!-- the pike, swimming away into the river -->
			<g transform={`translate(${f(pikeAt[0])} ${f(pikeAt[1])}) rotate(35)`}>
				<g data-pikefin><path class="fab__pike" d="M-25 0 L-36 -8 L-32 0 L-36 8 Z"></path></g>
				<path class="fab__pike" d="M-14 -5 L-8 -11 L-3 -6 Z"></path>
				<path class="fab__pike" d="M-26 0 C-18 -7 6 -8 22 -3 L28 -0.5 L22 2.5 C6 7 -18 6 -26 0 Z"></path>
				<path class="fab__spots" d="M-12 -1 h3 M-4 2 h3 M4 -2 h3 M-18 1 h2"></path>
				<path class="fab__strap" d="M6 -6.5 V6.5"></path>
				<circle class="fab__eye fab__eye--pike" cx="18" cy="-2" r="1.3"></circle>
				<path class="fab__mouth" d="M22 1 L27 0"></path>
			</g>

			<!-- the forces, from where the ropes are tied -->
			{(['swan', 'crab', 'pike'] as const).map((k, i) => {
				const a = arrow(k);
				const c = ['blue', 'gold', 'green'][i];
				return <line class={`arrow arrow--${c}`} x1={a.x1} y1={a.y1} x2={f(a.x2)} y2={f(a.y2)} marker-end={`url(#fab-${uid}-${c})`} />;
			})}

			<text class="t-strong t-blue t-halo" x="176" y="40" text-anchor="end">Лебедь рвётся</text>
			<text class="t-strong t-blue t-halo" x="176" y="55" text-anchor="end">в облака</text>
			<text class="t-strong t-gold t-halo" x="6" y="238">Рак пятится назад</text>
			<text class="t-strong t-green t-halo" x="316" y="264" text-anchor="end">Щука тянет в воду</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 240 270" role="img" aria-label={`Сложение трёх сил по 100 ньютонов: приставленные друг к другу стрелки почти возвращаются к началу, равнодействующая ${Math.round(R)} ньютонов направлена почти вверх, вдоль дороги меньше 8 ньютонов, а чтобы сдвинуть воз, нужно 150. Если бы все тянули в одну сторону, было бы 300 ньютонов`}>
			<text class="t-title" x="120" y="18" text-anchor="middle">Сложим силы</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">приставим стрелки друг к другу</text>
			<circle class="fab__origin" cx={O[0]} cy={O[1]} r="2.5"></circle>
			{chain.map((s, i) => (
				<line class={`arrow arrow--${s.c}`} x1={f(s.p[0][0])} y1={f(s.p[0][1])} x2={f(s.p[1][0])} y2={f(s.p[1][1])} marker-end={`url(#fabp-${uid}-${s.c})`} data-seg={i} data-x1={s.p[0][0]} data-y1={s.p[0][1]} data-x2={s.p[1][0]} data-y2={s.p[1][1]} />
			))}
			<g data-lab="0"><text class="t-small t-blue t-halo" x={f((O[0] + A[0]) / 2 + 7)} y={f((O[1] + A[1]) / 2 + 4)}>лебедь</text></g>
			<g data-lab="1"><text class="t-small t-gold t-halo" x={f((A[0] + B[0]) / 2)} y={f(A[1] - 7)} text-anchor="middle">рак</text></g>
			<g data-lab="2"><text class="t-small t-green t-halo" x={f((B[0] + C[0]) / 2 - 6)} y={f((B[1] + C[1]) / 2 + 12)} text-anchor="end">щука</text></g>
			<g data-lab="3">
				<text class="t-strong t-num t-halo" x="120" y="157" text-anchor="middle">равнодействующая {Math.round(R)}&nbsp;Н</text>
				<text class="t-small" x="120" y="172" text-anchor="middle">почти вверх; вдоль дороги — меньше 8 Н,</text>
				<text class="t-small" x="120" y="186" text-anchor="middle">а чтобы сдвинуть воз, нужно 150 Н</text>
			</g>
			<g data-lab="4">
				<text class="t-small" x="120" y="208" text-anchor="middle">если бы все тянули в одну сторону:</text>
				<line class="ln-dash" x1={L0 + 150 * KP} x2={L0 + 150 * KP} y1={LY - 9} y2={LY + 9}></line>
				<text class="t-small t-num" x={L0 + 150 * KP} y={LY + 21} text-anchor="middle">150 Н</text>
			</g>
			<g data-lab="6">
				<text class="t-strong t-num t-halo" x="120" y="262" text-anchor="middle">300 Н — воз поехал бы</text>
			</g>
		</svg>
	</div>
	<figcaption class="g7__caption">
		«Кто виноват из них, кто прав, — судить не нам; да только воз и ныне там» (И.&nbsp;А.&nbsp;Крылов). Пусть каждый тянет с силой 100&nbsp;Н (числа придуманы, звери не в масштабе): втроём в одну сторону они сдвинули бы воз, а в разные стороны их силы почти уравновешивают друг друга. Как складывать силы, направленные под углом, вы узнаете в старших классах.
	</figcaption>
</figure>

<style is:global>
	.fab__grid {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		gap: 0.75rem;
	}
	@container (max-width: 36rem) {
		.fab__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.fab__grid > svg + svg {
			max-width: 17rem;
			width: 100%;
			margin-inline: auto;
		}
	}
	.fab {
		--fab-white: var(--sl-color-gray-1);
	}
	:root[data-theme='light'] .fab {
		--fab-white: var(--sl-color-black);
	}
	.fab__sky {
		fill: var(--g7-sky);
	}
	.fab__cloud path {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 30%, var(--g7-sky));
	}
	:root[data-theme='light'] .fab__cloud path {
		fill: var(--g7-paper);
		stroke: color-mix(in oklab, var(--ig-vx) 25%, var(--g7-paper));
	}
	.fab__ground {
		fill: var(--g7-ground);
	}
	.fab__grass {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-green) 60%, var(--g7-ground));
		stroke-width: 3;
	}
	.fab__water {
		fill: var(--g7-water);
	}
	.fab__wave {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 1.2;
	}
	.fab__ripple {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 1;
	}
	.fab__bubble {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 0.8;
	}
	.fab__rope {
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.fab__body {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.fab__plank {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.fab__sack {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-3));
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	:root[data-theme='light'] .fab__sack {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.fab__tie {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.fab__shaft {
		stroke: var(--g7-wood-dark);
		stroke-width: 3.5;
		stroke-linecap: round;
	}
	.fab__wheel {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 3.5;
	}
	.fab__spoke {
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
	}
	.fab__hub {
		fill: var(--g7-wood-dark);
	}
	.fab__swan {
		fill: var(--fab-white);
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.fab__neck {
		fill: none;
		stroke: var(--fab-white);
		stroke-width: 4.5;
		stroke-linecap: round;
	}
	.fab__beak {
		fill: var(--g7-gold);
	}
	.fab__eye {
		fill: var(--sl-color-black);
	}
	:root[data-theme='light'] .fab__eye {
		fill: var(--sl-color-white);
	}
	.fab__eye--pike {
		fill: var(--g7-gold);
	}
	:root[data-theme='light'] .fab__eye--pike {
		fill: var(--g7-gold);
	}
	.fab__strap {
		stroke: var(--g7-wood-dark);
		stroke-width: 2;
	}
	.fab__crab {
		fill: color-mix(in oklab, var(--g7-wood-dark) 55%, var(--g7-green));
		stroke: var(--g7-ink);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	.fab__crabarm {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-wood-dark) 55%, var(--g7-green));
		stroke-width: 3;
		stroke-linecap: round;
	}
	.fab__legs path,
	.fab__antenna {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linecap: round;
	}
	.fab__antenna {
		stroke-width: 0.7;
	}
	.fab__pike {
		fill: color-mix(in oklab, var(--g7-green) 50%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .fab__pike {
		fill: color-mix(in oklab, var(--g7-green) 45%, var(--sl-color-gray-5));
	}
	.fab__spots {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linecap: round;
		opacity: 0.5;
	}
	.fab__mouth {
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.fab__origin {
		fill: var(--g7-ink);
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const CYCLE = 9; // s: the arrows of the right panel
	// when each arrow of the right panel is drawn: [start, end] in s
	const T: [number, number][] = [
		[0.4, 1.1],
		[1.3, 2.0],
		[2.2, 2.9],
		[3.3, 4.0],
		[4.8, 5.3],
		[5.4, 5.9],
		[6.0, 6.5],
	];
	for (const root of document.querySelectorAll<HTMLElement>('[data-fable]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const cart = q<SVGGElement>('[data-cart]');
		const wing = q<SVGPathElement>('[data-wing]');
		const legs = q<SVGGElement>('[data-crablegs]');
		const tail = q<SVGPathElement>('[data-crabtail]');
		const crab = q<SVGGElement>('[data-crab]');
		const fin = q<SVGGElement>('[data-pikefin]');
		const ripple = q<SVGCircleElement>('[data-ripple]');
		const bubbles = q<SVGGElement>('[data-bubbles]');
		const segs = [...root.querySelectorAll<SVGLineElement>('[data-seg]')];
		const labs = [...root.querySelectorAll<SVGGElement>('[data-lab]')];
		let t = 0;
		const draw = () => {
			const w = 2 * Math.PI;
			// the cart rocks a little about its rear wheel and stays where it is
			cart.setAttribute('transform', `rotate(${(0.6 * Math.sin((w * t) / 1.4)).toFixed(3)} 128 214)`);
			wing.setAttribute('transform', `scale(1 ${(0.25 + 0.75 * Math.sin((w * t) / 0.55)).toFixed(3)})`);
			legs.setAttribute('transform', `translate(${(1.2 * Math.sin((w * t) / 0.35)).toFixed(2)} 0)`);
			tail.setAttribute('transform', `rotate(${(10 * Math.sin((w * t) / 0.7)).toFixed(2)} 9 206)`);
			crab.setAttribute('transform', `translate(${(5 - 0.8 * (1 + Math.sin((w * t) / 0.7))).toFixed(2)} 0)`);
			fin.setAttribute('transform', `rotate(${(20 * Math.sin((w * t) / 0.45)).toFixed(2)} -25 0)`);
			const r = (t % 1.6) / 1.6;
			ripple.setAttribute('r', (3 + 14 * r).toFixed(1));
			ripple.setAttribute('opacity', (1 - r).toFixed(2));
			bubbles.setAttribute('transform', `translate(0 ${(-20 * ((t % 2) / 2)).toFixed(1)})`);
			bubbles.setAttribute('opacity', (1 - (t % 2) / 2).toFixed(2));
			// the right panel: the arrows grow one after another
			const c = t % CYCLE;
			segs.forEach((s, i) => {
				const k = ease((c - T[i][0]) / (T[i][1] - T[i][0]));
				const x1 = Number(s.dataset.x1);
				const y1 = Number(s.dataset.y1);
				const x2 = Number(s.dataset.x2);
				const y2 = Number(s.dataset.y2);
				s.setAttribute('x2', (x1 + (x2 - x1) * Math.max(k, 0.001)).toFixed(2));
				s.setAttribute('y2', (y1 + (y2 - y1) * Math.max(k, 0.001)).toFixed(2));
				s.style.visibility = k > 0.02 ? 'visible' : 'hidden';
			});
			for (const g of labs) {
				const i = Number(g.dataset.lab);
				g.setAttribute('opacity', c > T[i][1] - 0.2 ? '1' : '0');
			}
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
