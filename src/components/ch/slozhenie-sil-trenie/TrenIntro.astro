---
/**
 * Two short looping opening scenes of «Сложение сил. Сила трения». No terms of the chapter in the pictures.
 * Rope: two teams of two pull a rope in opposite directions equally hard: the mark on the rope stays over the
 *   line. Then a third player joins the team on the right, and the rope starts to move to the right, faster and
 *   faster.
 * Brakes: two cars moving at 40 км/ч (11,1 м/с) brake at the same moment, one on dry asphalt (it slows down by
 *   0,7·9,8 м/с² and stops in 9 м), the other on ice (0,1·9,8 м/с², 63 м). The road is to scale (4,6 px per metre);
 *   the motion is played 1,5 times faster than in life, the clock shows the real seconds.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const man = (x: number, side: number) => ({ x, side });
const team = [man(-124, -1), man(-84, -1), man(84, 1), man(124, 1)];
---

<IntroFrame data-trenintro>
	<div class="intro__card" data-scene="rope">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Две команды тянут канат в разные стороны с равной силой, и канат не движется. К правой команде присоединяется третий игрок, и канат начинает двигаться вправо">
			<rect class="tr-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="tr-ground" x="0" y="190" width="360" height="50"></rect>
			<line class="tr-line" x1="180" y1="150" x2="180" y2="200"></line>
			<g data-rope>
				<line class="tr-rope" x1="-280" y1="148" x2="200" y2="148"></line>
				<path class="tr-flag" d="M0 148 v-18 l12 5 l-12 5"></path>
				{team.map((m) => (
					<g transform={`translate(${m.x} 0)`}>
						<circle class="tr-head" cx={-m.side * 8} cy="118" r="7" />
						<path class={`tr-body tr-body--${m.side > 0 ? 'r' : 'l'}`} d={`M${-m.side * 6} 125 L${m.side * 4} 160 M${m.side * 4} 160 L${m.side * 14} 190 M${m.side * 4} 160 L${-m.side * 6} 190 M${-m.side * 4} 134 L${-m.side * 16} 148`} />
					</g>
				))}
				<g data-third>
					<circle class="tr-head" cx="156" cy="118" r="7"></circle>
					<path class="tr-body tr-body--r" d="M158 125 L168 160 M168 160 L178 190 M168 160 L158 190 M160 134 L148 148"></path>
				</g>
			</g>
			<text class="tr-note" x="180" y="30" text-anchor="middle" data-note></text>
		</svg>
		<div class="intro__foot">
			<p>
				Команды тянут канат в разные стороны одинаково сильно — и он стоит на месте. К одной команде подошёл ещё один игрок, и{' '}
				<More term="канат пополз в её сторону">
					Когда на тело действуют две равные силы, направленные в противоположные стороны, они уравновешивают друг друга, как будто сил нет вовсе. Если одна сила больше, тело ведёт себя так, как будто на него действует одна сила — их разность. Об этом — в разделе{' '}
					<a href="#равнодействующая-сила">«Равнодействующая сила»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="brakes">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Два автомобиля тормозят одновременно. На сухом асфальте автомобиль останавливается через 9 метров, на льду через 63 метра">
			<rect class="tr-sky" x="0" y="0" width="360" height="240"></rect>
			{
				[
					{ y: 64, key: 'dry', name: 'сухой асфальт', cls: 'tr-road' },
					{ y: 148, key: 'ice', name: 'лёд', cls: 'tr-road tr-road--ice' },
				].map((r) => (
					<g>
						<rect class={r.cls} x="0" y={r.y} width="360" height="34" />
						<text class="tr-label" x="10" y={r.y - 8}>{r.name}</text>
						<text class="tr-num" x="350" y={r.y - 8} text-anchor="end" data-s={r.key}></text>
						<line class="tr-skid" data-skid={r.key} x1="24" x2="24" y1={r.y + 26} y2={r.y + 26} />
						<g data-car={r.key}>
							<path class="tr-car" d={`M-22 ${r.y + 22} v-9 h9 l5 -9 h18 l6 9 h6 v9 Z`} />
							<circle class="tr-wheel" cx="-12" cy={r.y + 23} r="5" />
							<circle class="tr-wheel" cx="12" cy={r.y + 23} r="5" />
						</g>
					</g>
				))
			}
			<line class="tr-start" x1="24" y1="56" x2="24" y2="190"></line>
			<line class="tr-axis" x1="24" x2="346" y1="204" y2="204"></line>
			{[0, 10, 20, 30, 40, 50, 60, 70].map((m) => (
				<>
					<line class="tr-axis" x1={24 + m * 4.6} x2={24 + m * 4.6} y1="204" y2="210" />
					<text class="tr-small" x={24 + m * 4.6} y="222" text-anchor="middle">{m}</text>
				</>
			))}
			<text class="tr-small" x="350" y="236" text-anchor="end">путь после нажатия на тормоз, м</text>
			<text class="tr-clock" x="180" y="24" text-anchor="middle" data-clock>0,0 с</text>
		</svg>
		<div class="intro__foot">
			<p>
				Водители нажали на тормоз одновременно. На сухом асфальте автомобиль остановился через 9&nbsp;м, а на льду проехал 63&nbsp;м:{' '}
				<More term="лёд почти не тормозит колёса">
					Автомобиль останавливает сила, которая возникает между шинами и дорогой и направлена против движения. На льду она в несколько раз меньше, чем на сухом асфальте. Об этой силе — в разделе{' '}
					<a href="#сила-трения">«Сила трения»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-trenintro] .tr-sky {
		fill: var(--sl-color-bg);
	}
	[data-trenintro] .tr-ground {
		fill: color-mix(in oklab, hsl(110, 30%, 42%) 60%, var(--sl-color-bg));
	}
	[data-trenintro] .tr-line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}
	[data-trenintro] .tr-rope {
		stroke: hsl(36, 50%, 48%);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-trenintro] .tr-flag {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
	}
	[data-trenintro] .tr-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-trenintro] .tr-body {
		fill: none;
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-trenintro] .tr-body--l {
		stroke: var(--ig-vx);
	}
	[data-trenintro] .tr-body--r {
		stroke: var(--ig-v);
	}
	[data-trenintro] .tr-note {
		font-size: 13px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-trenintro] .tr-road {
		fill: var(--sl-color-gray-5);
	}
	[data-trenintro] .tr-road--ice {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-6));
	}
	[data-trenintro] .tr-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-trenintro] .tr-num {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-trenintro] .tr-skid {
		stroke: var(--sl-color-gray-1);
		stroke-width: 3;
		stroke-dasharray: 6 3;
		opacity: 0.55;
	}
	[data-trenintro] .tr-car {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	[data-trenintro] .tr-wheel {
		fill: var(--sl-color-gray-1);
	}
	[data-trenintro] .tr-start {
		stroke: var(--ig-vy);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	[data-trenintro] .tr-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-trenintro] .tr-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-trenintro] .tr-clock {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ru = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
	for (const root of document.querySelectorAll<HTMLElement>('[data-trenintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="rope"]')!;
			const rope = card.querySelector<SVGGElement>('[data-rope]')!;
			const third = card.querySelector<SVGGElement>('[data-third]')!;
			const note = card.querySelector<SVGTextElement>('[data-note]')!;
			scene(card, 7, (x) => {
				// the third player walks in (0,35…0,5), then the rope moves with a constant acceleration
				const come = Math.min(1, Math.max(0, (x - 0.35) / 0.15));
				const u = Math.max(0, (x - 0.5) / 0.5);
				const shift = 70 * u * u;
				// a little trembling while the forces are equal
				const tremble = x < 0.5 ? 1.5 * Math.sin(x * 90) : 0;
				rope.setAttribute('transform', `translate(${(180 + shift + tremble).toFixed(1)} 0)`);
				third.setAttribute('transform', `translate(${(60 * (1 - come)).toFixed(1)} 0)`);
				third.style.opacity = String(come);
				note.textContent = x < 0.35 ? 'двое против двоих: канат стоит' : x < 0.5 ? '' : 'трое против двоих: канат движется';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="brakes"]')!;
			const clock = card.querySelector<SVGTextElement>('[data-clock]')!;
			const V0 = 40 / 3.6;
			const cars = [
				{ key: 'dry', a: 0.7 * 9.8 },
				{ key: 'ice', a: 0.1 * 9.8 },
			].map((c) => ({ ...c, g: card.querySelector<SVGGElement>(`[data-car="${c.key}"]`)!, s: card.querySelector<SVGTextElement>(`[data-s="${c.key}"]`)!, skid: card.querySelector<SVGLineElement>(`[data-skid="${c.key}"]`)! }));
			const RUN = 7.8;
			scene(card, RUN, (x) => {
				const t = x * RUN * 1.5; // the real seconds
				clock.textContent = `${ru(Math.min(t, V0 / 0.98))}\u00a0с`;
				for (const c of cars) {
					const tt = Math.min(t, V0 / c.a);
					const s = V0 * tt - (c.a * tt * tt) / 2;
					const px = 24 + s * 4.6;
					c.g.setAttribute('transform', `translate(${px.toFixed(1)} 0)`);
					c.skid.setAttribute('x2', px.toFixed(1));
					c.s.textContent = `${ru(s, 0)} м${t >= V0 / c.a ? ': остановился' : ''}`;
				}
			});
		}
	}
</script>
