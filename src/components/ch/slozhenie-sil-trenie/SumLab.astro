---
/**
 * «Две силы и тележка»: a cart of 100 кг on a smooth floor (no friction) is pulled along one line by two forces,
 * each 0…500 Н and each directed to the left or to the right. The resultant is their sum when they point the same
 * way and their difference when they point opposite ways. «Отпустить» lets the cart go: it speeds up with
 * a = R/m in the direction of the resultant; with R = 0 it stays at rest, or, if it was pushed first, keeps its
 * speed of 0,5 м/с. Arrows: 0,22 px per newton; the floor: 40 px per metre.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
---

<G7Styles />
<figure class="g7 g7--stack sum not-content" data-sum>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 190" role="img" aria-label="Тележка, на которую действуют две силы вдоль одной прямой, и их равнодействующая" data-svg>
			<defs>
				{['blue', 'gold', 'red'].map((c) => <marker id={`sum-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<line class="sum__floor" x1="0" x2="380" y1="112" y2="112"></line>
			{Array.from({ length: 10 }, (_, i) => <line class="ln" x1={10 + i * 40} x2={10 + i * 40} y1="112" y2="118" />)}
			<g data-cart>
				<rect class="sum__cart" x="-30" y="-36" width="60" height="24" rx="4"></rect>
				<circle class="sum__wheel" cx="-17" cy="-7" r="7"></circle>
				<circle class="sum__wheel" cx="17" cy="-7" r="7"></circle>
				<line class="arrow arrow--blue" data-a1 y1="-30" y2="-30" marker-end={`url(#sum-${uid}-blue)`}></line>
				<line class="arrow arrow--gold" data-a2 y1="-18" y2="-18" marker-end={`url(#sum-${uid}-gold)`}></line>
				<text class="t-i t-blue t-halo" data-l1 y="-40">F<tspan class="sum__sub" dy="3">1</tspan></text>
				<text class="t-i t-gold t-halo" data-l2 y="-4">F<tspan class="sum__sub" dy="3">2</tspan></text>
			</g>
			<text class="t-small" x="190" y="142" text-anchor="middle">равнодействующая</text>
			<line class="arrow arrow--red" data-r x1="190" y1="160" y2="160" marker-end={`url(#sum-${uid}-red)`}></line>
			<circle class="sum__zero" cx="190" cy="160" r="4"></circle>
			<text class="t-strong t-num" x="190" y="184" text-anchor="middle" data-rtext></text>
			<text class="t-strong t-num" x="372" y="22" text-anchor="end" data-speed></text>
		</svg>
		<div class="g7__side sum__side">
			<div class="sum__force">
				<label class="g7__slider">
					<span>Сила <i>F</i><sub>1</sub></span>
					<output data-o1></output>
					<input type="range" min="0" max="500" step="50" value="200" data-f1 aria-label="Первая сила, ньютоны" />
				</label>
				<div class="g7__seg" role="group" aria-label="Направление первой силы" data-d1>
					<button type="button" class="g7__btn" aria-pressed="false" data-d="-1">←</button>
					<button type="button" class="g7__btn" aria-pressed="true" data-d="1">→</button>
				</div>
			</div>
			<div class="sum__force">
				<label class="g7__slider">
					<span>Сила <i>F</i><sub>2</sub></span>
					<output data-o2></output>
					<input type="range" min="0" max="500" step="50" value="300" data-f2 aria-label="Вторая сила, ньютоны" />
				</label>
				<div class="g7__seg" role="group" aria-label="Направление второй силы" data-d2>
					<button type="button" class="g7__btn" aria-pressed="false" data-d="-1">←</button>
					<button type="button" class="g7__btn" aria-pressed="true" data-d="1">→</button>
				</div>
			</div>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Отпустить тележку</button>
				<button type="button" class="g7__btn" data-push>Сначала толкнуть её</button>
				<button type="button" class="g7__btn" data-reset>На место</button>
			</div>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Пол гладкий: трения нет. Масса тележки 100 кг. Длина каждой стрелки показывает числовое значение силы, все стрелки нарисованы в одном масштабе.
	</figcaption>
</figure>

<style is:global>
	.sum__side {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
	}
	.sum__side .g7__row,
	.sum__side .g7__msg {
		grid-column: 1 / -1;
	}
	.sum__force {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.5rem;
		align-items: end;
	}
	.sum__floor {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.sum__cart {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.sum__wheel {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.sum__zero {
		fill: var(--g7-red);
	}
	.sum svg .sum__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
	@container (max-width: 34rem) {
		.sum__side {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { fmt, loop, segment } from '../g7/kit';

	const K = 0.22; // px per newton
	const MASS = 100;
	for (const root of document.querySelectorAll<HTMLElement>('[data-sum]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const f = [q<HTMLInputElement>('[data-f1]'), q<HTMLInputElement>('[data-f2]')];
		const dir = [1, 1];
		const cart = q<SVGGElement>('[data-cart]');
		const msg = q<HTMLElement>('[data-msg]');
		let x = 190;
		let v = 0;
		let running = false;
		const R = () => dir[0] * Number(f[0].value) + dir[1] * Number(f[1].value);
		const draw = () => {
			cart.setAttribute('transform', `translate(${x.toFixed(1)} 112)`);
			for (const i of [0, 1]) {
				const F = Number(f[i].value);
				const a = q<SVGLineElement>(`[data-a${i + 1}]`);
				const l = q<SVGTextElement>(`[data-l${i + 1}]`);
				// the arrow starts at the side of the cart toward which the force points
				const x0 = dir[i] * 30;
				a.setAttribute('x1', String(x0));
				a.setAttribute('x2', String(x0 + dir[i] * Math.max(0, F * K - 4)));
				a.style.visibility = l.style.visibility = F > 0 ? 'visible' : 'hidden';
				l.setAttribute('x', String(x0 + dir[i] * (F * K) / 2 - 5));
				q(`[data-o${i + 1}]`).textContent = `${F} Н ${dir[i] > 0 ? 'вправо' : 'влево'}`;
			}
			const r = R();
			const ra = q<SVGLineElement>('[data-r]');
			ra.setAttribute('x2', String(190 + Math.sign(r) * Math.max(0, Math.abs(r) * K - 4)));
			ra.style.visibility = r ? 'visible' : 'hidden';
			q('[data-rtext]').textContent = r ? `R = ${Math.abs(r)} Н ${r > 0 ? 'вправо' : 'влево'}` : 'R = 0';
			q('[data-speed]').textContent = running || v ? `скорость ${fmt(Math.abs(v), 2)} м/с` : '';
		};
		const say = () => {
			const r = R();
			const same = dir[0] === dir[1];
			const F1 = Number(f[0].value);
			const F2 = Number(f[1].value);
			msg.textContent = same
				? `Силы направлены в одну сторону: R = ${F1} Н + ${F2} Н = ${F1 + F2} Н.`
				: r === 0
					? `Силы равны и направлены в противоположные стороны: R = 0. Они уравновешивают друг друга.`
					: `Силы направлены в противоположные стороны: R = ${Math.max(F1, F2)} Н − ${Math.min(F1, F2)} Н = ${Math.abs(r)} Н, в сторону большей силы.`;
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			v += (R() / MASS) * dt;
			x += v * 40 * dt;
			if (x < 34 || x > 346) {
				x = Math.min(346, Math.max(34, x));
				running = false;
				v = 0;
			}
			draw();
			return running;
		});
		const reset = () => {
			running = false;
			x = 190;
			v = 0;
			draw();
			say();
		};
		q('[data-go]').addEventListener('click', () => {
			running = true;
			if (R() === 0 && v === 0) msg.textContent = 'Равнодействующая равна нулю: тележка остаётся в покое.';
			wake();
		});
		q('[data-push]').addEventListener('click', () => {
			x = 60;
			v = 0.5;
			running = true;
			msg.textContent = R() === 0 ? 'Тележку толкнули, и она едет. Равнодействующая равна нулю — скорость не меняется: 0,50 м/с.' : 'Тележку толкнули вправо. Равнодействующая не равна нулю — скорость меняется.';
			wake();
		});
		q('[data-reset]').addEventListener('click', reset);
		for (const i of [0, 1]) {
			f[i].addEventListener('input', reset);
			segment(q(`[data-d${i + 1}]`), (b) => {
				dir[i] = Number(b.dataset.d);
				reset();
			});
		}
		reset();
	}
</script>
