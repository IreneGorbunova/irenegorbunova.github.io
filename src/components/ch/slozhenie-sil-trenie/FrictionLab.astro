---
/**
 * «Брусок и динамометр»: a wooden block of 1 кг (with up to three weights of 1 кг on it) lies on a table and is
 * pulled horizontally through a dynamometer. While the pull is not greater than the greatest friction of rest
 * μ₀·N, the block stays where it is and the friction equals the pull. A greater pull sets the block sliding; the
 * friction is then μ·N, where N = g·m is the force of the table on the block («сила реакции опоры», Irina 18 Nov 2026), and it stays μ·N however strong
 * the pull. Surfaces (μ₀ / μ): wood on wood 0,40 / 0,30; sandpaper 0,70 / 0,60; ice 0,05 / 0,035; on round
 * pencils (rolling) 0,02 / 0,02. Wood, no weights: rest up to 3,92 Н, sliding friction 2,94 Н.
 *
 * Scales are fitted to the chosen case. The pull slider runs from 0 to about twice μ₀·N, rounded up to a tidy value
 * (wood, no weights: 0…8 Н in steps of 0,5 Н; ice: 0…1 Н in steps of 0,05 Н; three weights: 0…40 Н in steps of 2 Н),
 * the step being about a twentieth of the range. Both arrows use one scale: the end of the slider is 180 px, so the
 * greatest friction of rest is about 90 px. The graph has equal scales on both axes (the pull axis 0…max is 300 px,
 * the friction axis 0…max/2 is 150 px), so «friction = pull» is the 45° line.
 *
 * The block is 20 cm long (60 px, 3 px per cm). When it slides, the picture follows it: the table with marks every
 * 10 cm (long marks every 50 cm) and the «старт» mark move back. Simplified: the speed of the block is limited to
 * 1 м/с (a hand pulling the dynamometer does not run); the pencils are drawn thicker than real ones (8 px = 2,7 cm).
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const GX = 44;
const GY = 330;
const TY = 112;
---

<G7Styles />
<figure class="g7 fr not-content" data-fr>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 364" role="img" aria-label="Брусок на столе тянут динамометром; ниже график силы трения в зависимости от силы тяги" data-svg>
			<defs>
				{['blue', 'red'].map((c) => <marker id={`fr-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<text class="t-strong fr__state" x="8" y="22" data-state></text>
			<rect class="fr__table" data-table x="0" y={TY} width="360" height="14"></rect>
			<g data-marks>
				{Array.from({ length: 18 }, (_, i) => <line class="fr__mark" x1={i * 30} x2={i * 30} y1={TY} y2={TY + (i % 5 === 0 ? 10 : 5)} />)}
			</g>
			<g data-start>
				<line class="fr__startline" x1="0" x2="0" y1={TY - 2} y2={TY + 18}></line>
				<text class="t-small" x="0" y={TY + 30} text-anchor="middle">старт</text>
			</g>
			<g data-rollers></g>
			<g data-block>
				<rect class="fr__block" x="-30" y="-30" width="60" height="30" rx="2"></rect>
				<g data-loads></g>
				<path class="fr__rope" d="M30 -12 H80 M140 -12 H230"></path>
				<rect class="fr__dyn" x="80" y="-19" width="60" height="14" rx="4"></rect>
				<path class="fr__dynscale" d="M86 -9 H134"></path>
				<line class="fr__pointer" data-pointer y1="-17" y2="-7"></line>
				<line class="arrow arrow--blue" data-pull x1="30" y1="-27" y2="-27" marker-end={`url(#fr-${uid}-blue)`}></line>
				<line class="arrow arrow--red" data-fric x1="-30" y1="-4" y2="-4" marker-end={`url(#fr-${uid}-red)`}></line>
				<text class="t-blue t-num t-halo fr__val" x="34" y="-38" data-lpull></text>
				<text class="t-red t-num t-halo fr__val" x="-34" y="-13" text-anchor="end" data-lfric></text>
			</g>
			<!-- the graph: friction against the pull, equal scales on both axes -->
			<path class="ln" d={`M${GX} ${GY - 160} V${GY} H${GX + 306}`}></path>
			<g data-ticks></g>
			<text class="t-small" x={GX + 4} y={GY - 164}>сила трения, Н</text>
			<text class="t-small" x={GX + 300} y={GY + 30} text-anchor="end">сила тяги, Н</text>
			<path class="fr__ext" data-ext></path>
			<path class="fr__curve" data-curve></path>
			<text class="t-small t-red t-halo" text-anchor="end" data-lrest>покой</text>
			<text class="t-small t-red" text-anchor="middle" data-lslide>скольжение</text>
			<circle class="fr__dot" data-dot r="5"></circle>
		</svg>
		<div class="g7__side">
			<label class="g7__select">
				Поверхность
				<select data-surf aria-label="Поверхность">
					<option value="wood">Дерево по дереву</option>
					<option value="sand">Дерево по наждачной бумаге</option>
					<option value="ice">Дерево по льду</option>
					<option value="roll">Брусок на круглых карандашах</option>
				</select>
			</label>
			<label class="g7__slider">
				<span>Грузов по 1 кг на бруске</span>
				<output data-on></output>
				<input type="range" min="0" max="3" step="1" value="0" data-n aria-label="Число грузов на бруске" />
			</label>
			<label class="g7__slider">
				<span>Сила тяги</span>
				<output data-of></output>
				<input type="range" min="0" max="8" step="0.5" value="0" data-f aria-label="Сила тяги, ньютоны" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сила реакции опоры <i>N</i></span><b data-press></b></li>
				<li class="is-key"><span data-ftname>Сила трения покоя</span><b data-ft></b></li>
			</ul>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-back>Остановить брусок</button>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Синяя стрелка — сила тяги, красная — сила трения, обе в одном масштабе. Когда брусок скользит, рисунок едет вместе с ним: стол с метками через каждые 10&nbsp;см уходит назад.
	</figcaption>
</figure>

<style is:global>
	.fr__table {
		fill: var(--g7-wood);
	}
	.fr__mark {
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
	}
	.fr__startline {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.fr__block {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.fr__load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.fr__rope {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.fr__dyn {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.fr__dynscale {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.fr__pointer {
		stroke: var(--g7-blue);
		stroke-width: 2;
	}
	.fr__roller {
		fill: hsl(42, 85%, 58%);
		stroke: hsl(36, 70%, 34%);
		stroke-width: 1;
	}
	.g7__svg .fr__val {
		font-weight: 700;
	}
	.g7__svg .fr__state {
		font-size: 14px;
	}
	.fr__curve {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.fr__ext {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.2;
		stroke-dasharray: 1.5 3;
		stroke-linecap: round;
	}
	.fr__dot {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
</style>

<script>
	import { el, fmt, fmtTrim, loop } from '../g7/kit';

	const GX = 44;
	const GY = 330;
	const GW = 300; // the pull axis 0…max
	const TY = 112;
	const BX = 135; // the block stays here; the table moves under it
	const PXM = 300; // px per metre
	const ARROW = 180; // px for the end of the slider
	const VMAX = 1; // м/с
	const SURF: Record<string, { s: number; k: number; fill: string }> = {
		wood: { s: 0.4, k: 0.3, fill: '' },
		sand: { s: 0.7, k: 0.6, fill: 'hsl(30, 30%, 40%)' },
		ice: { s: 0.05, k: 0.035, fill: 'hsl(200, 70%, 80%)' },
		roll: { s: 0.02, k: 0.02, fill: '' },
	};
	const decade = (v: number) => 10 ** Math.floor(Math.log10(v) + 1e-9);
	/** the smallest of 1, 1,5, 2, 2,5, 3, 4, 5, 6, 8 (×10ⁿ) not below v */
	const niceCeil = (v: number) => {
		const d = decade(v);
		for (const m of [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10]) if (m * d >= v - 1e-9) return +(m * d).toPrecision(6);
		return 10 * d;
	};
	/** the nearest of 1, 2, 5 (×10ⁿ) on a log scale */
	const niceNear = (v: number) => {
		let best = 1;
		for (const e of [-3, -2, -1, 0, 1]) for (const m of [1, 2, 5]) {
			const c = m * 10 ** e;
			if (Math.abs(Math.log(c / v)) < Math.abs(Math.log(best / v))) best = c;
		}
		return +best.toPrecision(6);
	};
	/** the tick spacing of an axis 0…max: 4 to 8 ticks, 1-2-5 first, then 2,5 */
	const tickOf = (max: number) => {
		const whole = (q: number) => Math.abs(q - Math.round(q)) < 1e-6;
		for (const set of [[1, 2, 5], [2.5]])
			for (const e of [-3, -2, -1, 0, 1])
				for (const m of set) {
					const t = m * 10 ** e;
					const q = max / t;
					if (q >= 4 && q <= 8 && whole(q)) return t;
				}
		return max / 4;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-fr]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const surf = q<HTMLSelectElement>('[data-surf]');
		const nIn = q<HTMLInputElement>('[data-n]');
		const fIn = q<HTMLInputElement>('[data-f]');
		const block = q<SVGGElement>('[data-block]');
		const loads = q<SVGGElement>('[data-loads]');
		const rollers = q<SVGGElement>('[data-rollers]');
		const marks = q<SVGGElement>('[data-marks]');
		const start = q<SVGGElement>('[data-start]');
		const ticks = q<SVGGElement>('[data-ticks]');
		let s = 0; // the path, m
		let v = 0; // the speed, m/s
		let max = 8; // the end of the slider, Н
		let step = 0.5;
		let digits = 1;
		const N = () => 9.8 * (1 + Number(nIn.value));
		const X = (f: number) => GX + (f / max) * GW;
		const Y = (f: number) => GY - (f / max) * GW;
		const state = () => {
			const S = SURF[surf.value];
			const F = Number(fIn.value);
			const n = N();
			const moving = v > 1e-4 || F > S.s * n + 1e-9;
			const ft = moving ? S.k * n : F;
			return { F, n, ft, moving, S };
		};
		const draw = () => {
			const { F, n, ft, moving } = state();
			const px = ARROW / max;
			// the picture follows the block: the table, its marks, the start and the pencils move back
			const shift = s * PXM;
			marks.setAttribute('transform', `translate(${(-(shift % 150)).toFixed(1)} 0)`);
			start.setAttribute('transform', `translate(${(BX - 30 - shift).toFixed(1)} 0)`);
			rollers.setAttribute('transform', `translate(${(-((shift / 2) % 18)).toFixed(1)} 0)`);
			block.setAttribute('transform', `translate(${BX} ${surf.value === 'roll' ? TY - 8 : TY})`);
			const pull = q<SVGLineElement>('[data-pull]');
			const fric = q<SVGLineElement>('[data-fric]');
			const lp = F * px;
			const lf = ft * px;
			pull.setAttribute('x2', String(30 + Math.max(0.5, lp - 4)));
			pull.style.visibility = lp > 3 ? 'visible' : 'hidden';
			fric.setAttribute('x2', String(-30 - Math.max(0.5, lf - 4)));
			fric.style.visibility = lf > 3 ? 'visible' : 'hidden';
			q('[data-lpull]').textContent = F > 0 ? `${fmtTrim(F, 2)}\u00a0Н` : '';
			q('[data-lfric]').textContent = ft > 0 ? `${fmtTrim(ft, 2)}\u00a0Н` : '';
			q('[data-pointer]').setAttribute('x1', (86 + (48 * F) / max).toFixed(1));
			q('[data-pointer]').setAttribute('x2', (86 + (48 * F) / max).toFixed(1));
			q('[data-on]').textContent = nIn.value;
			q('[data-of]').textContent = `${fmt(F, digits)}\u00a0Н`;
			q('[data-press]').textContent = `${fmtTrim(n, 1)}\u00a0Н`;
			q('[data-ft]').textContent = `${fmtTrim(ft, 2)}\u00a0Н`;
			q('[data-ftname]').textContent = !moving ? 'Сила трения покоя' : surf.value === 'roll' ? 'Сила трения качения' : 'Сила трения скольжения';
			const go = surf.value === 'roll' ? 'едет' : 'скользит';
			q('[data-state]').textContent = !moving
				? 'Брусок покоится'
				: Math.abs(F - ft) < 0.55 * step
					? `Брусок ${go} почти равномерно`
					: F > ft
						? `Брусок ${go} и разгоняется`
						: `Брусок ${go} и тормозит`;
			q('[data-dot]').setAttribute('cx', X(F).toFixed(1));
			q('[data-dot]').setAttribute('cy', Y(ft).toFixed(1));
		};
		/** the slider, the graph's axes and the arrows' scale for the chosen surface and load */
		const scales = () => {
			const S = SURF[surf.value];
			const fs = S.s * N();
			const fk = S.k * N();
			max = niceCeil(2 * fs);
			step = niceNear(max / 20);
			digits = step >= 1 ? 0 : step >= 0.1 ? 1 : 2;
			fIn.max = String(max);
			fIn.step = String(step);
			fIn.value = '0';
			const t = tickOf(max);
			ticks.replaceChildren();
			for (let i = 0; i * t <= max + 1e-9; i++) {
				const f = +(i * t).toPrecision(6);
				ticks.append(el('text', { class: 't-small t-num', x: X(f).toFixed(1), y: GY + 15, 'text-anchor': 'middle' }, fmtTrim(f, 2)));
				if (f > 0 && f <= max / 2 + 1e-9) {
					// the zero of the friction axis is the zero under the pull axis (the dot of the state sits on it)
					ticks.append(el('text', { class: 't-small t-num', x: GX - 5, y: (Y(f) + 4).toFixed(1), 'text-anchor': 'end' }, fmtTrim(f, 2)));
					ticks.append(el('path', { class: 'ln-dash', d: `M${GX} ${Y(f).toFixed(1)} H${GX + GW}` }));
				}
			}
			// friction follows the pull up to μ₀N, then it is μN; the dashed line: sliding friction at any pull
			q('[data-curve]').setAttribute('d', `M${GX} ${GY} L${X(fs).toFixed(1)} ${Y(fs).toFixed(1)} L${X(fs).toFixed(1)} ${Y(fk).toFixed(1)} H${GX + GW}`);
			q('[data-ext]').setAttribute('d', `M${GX} ${Y(fk).toFixed(1)} H${X(fs).toFixed(1)}`);
			q('[data-lrest]').setAttribute('x', (X(0.55 * fs) - 8).toFixed(1));
			q('[data-lrest]').setAttribute('y', (Y(0.55 * fs) - 4).toFixed(1));
			q('[data-lslide]').setAttribute('x', ((X(fs) + X(max)) / 2).toFixed(1));
			q('[data-lslide]').setAttribute('y', (Y(fk) - 7).toFixed(1));
			q('[data-lslide]').textContent = surf.value === 'roll' ? 'качение' : 'скольжение';
		};
		const setup = () => {
			const S = SURF[surf.value];
			q<SVGRectElement>('[data-table]').style.fill = S.fill;
			loads.replaceChildren();
			for (let i = 0; i < Number(nIn.value); i++) loads.append(el('rect', { class: 'fr__load', x: -20, y: -42 - i * 13, width: 40, height: 12, rx: 2 }));
			rollers.replaceChildren();
			if (surf.value === 'roll') for (let i = 0; i < 22; i++) rollers.append(el('circle', { class: 'fr__roller', cx: 4 + i * 18, cy: TY - 4, r: 4 }));
			s = 0;
			v = 0;
			scales();
			draw();
		};
		const wake = loop(root, (dt) => {
			const { F, n, moving, S } = state();
			if (!moving) {
				v = 0;
				draw();
				return false;
			}
			const m = 1 + Number(nIn.value);
			v = Math.min(VMAX, Math.max(0, v + ((F - S.k * n) / m) * dt));
			s += v * dt;
			draw();
			return v > 0 || F > S.s * n;
		});
		fIn.addEventListener('input', () => {
			draw();
			wake();
		});
		nIn.addEventListener('input', setup);
		surf.addEventListener('change', setup);
		q('[data-back]').addEventListener('click', () => {
			s = 0;
			v = 0;
			draw();
			wake();
		});
		setup();
	}
</script>
