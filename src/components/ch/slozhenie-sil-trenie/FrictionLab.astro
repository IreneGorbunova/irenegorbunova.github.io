---
/**
 * «Брусок и динамометр»: a wooden block of 1 кг (with up to three weights of 1 кг on it) lies on a table and is
 * pulled horizontally through a dynamometer. While the pull is not greater than the greatest friction of rest
 * μ₀·N, the block stays where it is and the friction equals the pull. A greater pull sets the block sliding; the
 * friction is then μ·N, where N = g·m is the force pressing the block to the table. Surfaces (μ₀ / μ): wood on wood
 * 0,40 / 0,30; sandpaper 0,70 / 0,60; ice 0,05 / 0,035; on round pencils (rolling) 0,02 / 0,02. The graph shows the
 * friction against the pull: it follows the pull up to the greatest friction of rest, then drops to the sliding value.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const GX = 44;
const GY = 300;
---

<G7Styles />
<figure class="g7 fr not-content" data-fr>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 330" role="img" aria-label="Брусок на столе тянут динамометром; ниже график силы трения в зависимости от силы тяги" data-svg>
			<defs>
				{['blue', 'red'].map((c) => <marker id={`fr-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<rect class="fr__table" data-table x="0" y="112" width="360" height="12"></rect>
			<g data-rollers></g>
			<g data-block>
				<rect class="fr__block" x="-34" y="-30" width="68" height="30" rx="2"></rect>
				<g data-loads></g>
				<path class="fr__rope" d="M34 -15 H70"></path>
				<rect class="fr__dyn" x="70" y="-22" width="54" height="14" rx="4"></rect>
				<path class="fr__rope" d="M124 -15 H146"></path>
				<line class="arrow arrow--blue" data-pull x1="150" y1="-15" y2="-15" marker-end={`url(#fr-${uid}-blue)`}></line>
				<line class="arrow arrow--red" data-fric x1="-34" y1="-4" y2="-4" marker-end={`url(#fr-${uid}-red)`}></line>
			</g>
			<text class="t-strong" x="8" y="22" data-state></text>
			<!-- the graph: friction against the pull, 0…30 Н on both axes -->
			<path class="ln" d={`M${GX} 160 V${GY} H${GX + 300}`}></path>
			{[0, 10, 20, 30].map((v) => (
				<>
					<text class="t-small t-num" x={GX + v * 10} y={GY + 14} text-anchor="middle">{v}</text>
					<text class="t-small t-num" x={GX - 5} y={GY - v * 4.4 + 4} text-anchor="end">{v}</text>
					<path class="ln-dash" d={`M${GX} ${GY - v * 4.4} H${GX + 300}`} />
				</>
			))}
			<text class="t-small" x={GX + 4} y="156">сила трения, Н</text>
			<text class="t-small" x={GX + 300} y={GY + 28} text-anchor="end">сила тяги, Н</text>
			<path class="fr__curve" data-curve></path>
			<circle class="fr__dot" data-dot r="5"></circle>
		</svg>
		<div class="g7__side">
			<label class="g7__select">
				Поверхность
				<select data-surf aria-label="Поверхность">
					<option value="wood">Дерево по дереву</option>
					<option value="sand">Дерево по наждачной бумаге</option>
					<option value="ice">Дерево по льду</option>
					<option value="roll">Брусок на круглых карандашах</option>
				</select>
			</label>
			<label class="g7__slider">
				<span>Грузов по 1 кг на бруске</span>
				<output data-on></output>
				<input type="range" min="0" max="3" step="1" value="0" data-n aria-label="Число грузов на бруске" />
			</label>
			<label class="g7__slider">
				<span>Сила тяги</span>
				<output data-of></output>
				<input type="range" min="0" max="30" step="0.5" value="0" data-f aria-label="Сила тяги, ньютоны" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сила, прижимающая брусок к столу</span><b data-press></b></li>
				<li class="is-key"><span>Сила трения</span><b data-ft></b></li>
			</ul>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-back>Остановить брусок</button>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Синяя стрелка — сила тяги, красная — сила трения. Увеличивайте силу тяги понемногу и следите, когда брусок сдвинется. Стол длинный: дойдя до края рисунка, брусок появляется слева и продолжает движение. Точка на графике показывает силу трения при этой силе тяги.
	</figcaption>
</figure>

<style is:global>
	.fr__table {
		fill: var(--g7-wood);
	}
	.fr__block {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.fr__load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.fr__rope {
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.fr__dyn {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.fr__roller {
		fill: hsl(42, 85%, 58%);
		stroke: hsl(36, 70%, 34%);
		stroke-width: 1;
	}
	.fr__curve {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.fr__dot {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
</style>

<script>
	import { el, fmt, fmtTrim, loop } from '../g7/kit';

	const GX = 44;
	const GY = 300;
	const SURF: Record<string, { s: number; k: number; fill: string }> = {
		wood: { s: 0.4, k: 0.3, fill: '' },
		sand: { s: 0.7, k: 0.6, fill: 'hsl(30, 30%, 40%)' },
		ice: { s: 0.05, k: 0.035, fill: 'hsl(200, 70%, 80%)' },
		roll: { s: 0.02, k: 0.02, fill: '' },
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-fr]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const surf = q<HTMLSelectElement>('[data-surf]');
		const nIn = q<HTMLInputElement>('[data-n]');
		const fIn = q<HTMLInputElement>('[data-f]');
		const block = q<SVGGElement>('[data-block]');
		const loads = q<SVGGElement>('[data-loads]');
		const rollers = q<SVGGElement>('[data-rollers]');
		let x = 70;
		let v = 0;
		const N = () => 9.8 * (1 + Number(nIn.value));
		const state = () => {
			const S = SURF[surf.value];
			const F = Number(fIn.value);
			const n = N();
			const moving = v > 0.001 || F > S.s * n + 1e-9;
			const ft = moving ? S.k * n : F;
			return { F, n, ft, moving, S };
		};
		const draw = () => {
			const { F, n, ft, moving, S } = state();
			block.setAttribute('transform', `translate(${x.toFixed(1)} ${surf.value === 'roll' ? 104 : 112})`);
			q<SVGLineElement>('[data-pull]').setAttribute('x2', String(150 + Math.max(0, F * 2.2 - 4)));
			q<SVGLineElement>('[data-pull]').style.visibility = F > 0 ? 'visible' : 'hidden';
			q<SVGLineElement>('[data-fric]').setAttribute('x2', String(-34 - Math.max(0, ft * 2.2 - 4)));
			q<SVGLineElement>('[data-fric]').style.visibility = ft > 0.2 ? 'visible' : 'hidden';
			q('[data-on]').textContent = nIn.value;
			q('[data-of]').textContent = `${fmt(F, 1)} Н`;
			q('[data-press]').textContent = `${fmtTrim(n, 1)} Н`;
			q('[data-ft]').textContent = `${fmtTrim(ft, 2)} Н`;
			q('[data-state]').textContent = !moving ? 'Брусок покоится' : Math.abs(F - ft) < 0.26 ? 'Брусок движется почти равномерно' : F > ft ? 'Брусок разгоняется' : 'Брусок тормозит';
			// the graph: the friction follows the pull up to μ₀·N, then is μ·N
			const fs = S.s * n;
			const fk = S.k * n;
			q('[data-curve]').setAttribute('d', `M${GX} ${GY} L${(GX + fs * 10).toFixed(1)} ${(GY - fs * 4.4).toFixed(1)} L${(GX + fs * 10).toFixed(1)} ${(GY - fk * 4.4).toFixed(1)} H${GX + 300}`);
			q('[data-dot]').setAttribute('cx', (GX + F * 10).toFixed(1));
			q('[data-dot]').setAttribute('cy', (GY - ft * 4.4).toFixed(1));
		};
		const setup = () => {
			const S = SURF[surf.value];
			q<SVGRectElement>('[data-table]').style.fill = S.fill;
			loads.replaceChildren();
			for (let i = 0; i < Number(nIn.value); i++) loads.append(el('rect', { class: 'fr__load', x: -22, y: -42 - i * 13, width: 44, height: 12, rx: 2 }));
			rollers.replaceChildren();
			if (surf.value === 'roll') for (let i = 0; i < 20; i++) rollers.append(el('circle', { class: 'fr__roller', cx: 10 + i * 18, cy: 108, r: 4 }));
			x = 70;
			v = 0;
			draw();
		};
		const wake = loop(root, (dt) => {
			const { F, n, moving, S } = state();
			if (!moving) {
				v = 0;
				draw();
				return false;
			}
			const m = 1 + Number(nIn.value);
			v = Math.min(2.5, Math.max(0, v + ((F - S.k * n) / m) * dt));
			x += v * 60 * dt; // 60 px per metre
			// the table is long: when the block reaches the edge of the picture, it is shown from the start again
			if (x > 200) x = 40;
			draw();
			return v > 0 || F > S.s * n;
		});
		fIn.addEventListener('input', () => {
			draw();
			wake();
		});
		nIn.addEventListener('input', setup);
		surf.addEventListener('change', setup);
		q('[data-back]').addEventListener('click', () => {
			x = 70;
			v = 0;
			draw();
			wake();
		});
		setup();
	}
</script>
