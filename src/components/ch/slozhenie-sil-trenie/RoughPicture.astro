---
/**
 * Picture «Откуда берётся трение»: two surfaces that look smooth, seen much enlarged. Left: dry surfaces touch by
 * the tops of their bumps, which catch on each other. Right: a layer of oil keeps the surfaces apart, and the
 * layers of oil slide over each other. The same fixed profile in both panels. A static drawing.
 */
import G7Styles from '../g7/G7Styles.astro';

const top = 'M0 0 H240 V52 L226 60 L210 50 L196 62 L178 52 L160 64 L146 54 L128 62 L110 50 L94 62 L78 52 L60 64 L44 54 L26 62 L12 52 L0 58 Z';
const bottom = 'M0 150 H240 V96 L224 88 L208 98 L190 86 L172 96 L158 86 L140 98 L122 88 L104 98 L88 86 L70 96 L54 86 L36 98 L20 88 L0 94 Z';
---

<G7Styles />
<figure class="g7 g7--pic rgh not-content">
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 240 172" role="img" aria-label="Сухие поверхности под сильным увеличением: выступы одной цепляются за выступы другой">
			<g transform="translate(0 14)"><path class="rgh__a" d={top}></path></g>
			<path class="rgh__b" d={bottom}></path>
			<circle class="rgh__touch" cx="94" cy="82" r="8"></circle>
			<circle class="rgh__touch" cx="178" cy="76" r="8"></circle>
			<circle class="rgh__touch" cx="26" cy="82" r="8"></circle>
			<text class="t-small" x="120" y="166" text-anchor="middle">без смазки: выступы цепляются друг за друга</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 240 172" role="img" aria-label="Между поверхностями слой масла: выступы не касаются друг друга">
			<rect class="rgh__oil" x="0" y="40" width="240" height="70"></rect>
			<path class="rgh__a" d={top}></path>
			<g transform="translate(0 8)"><path class="rgh__b" d={bottom}></path></g>
			<text class="t-small t-gold" x="120" y="86" text-anchor="middle">слой масла</text>
			<text class="t-small" x="120" y="166" text-anchor="middle">со смазкой: поверхности не касаются</text>
		</svg>
	</div>
</figure>

<style is:global>
	.rgh__a {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.rgh__b {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.rgh__touch {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.6;
	}
	.rgh__oil {
		fill: color-mix(in oklab, var(--ig-v) 34%, transparent);
	}
</style>
