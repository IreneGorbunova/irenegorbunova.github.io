---
/**
 * «Предскажите, затем проверьте»: six bodies and liquids from the density tables. The pupil chooses
 * what will happen; then a hand lowers the cube until it is completely under the surface and lets
 * it go, and the cube moves with real dynamics (shown three times slower). 10 px per cm, cube 3 cm.
 */
---

<figure class="sfq not-content" data-sfq>
	<div class="sfq__head">
		<p class="sfq__title">Утонет или будет плавать?</p>
		<p class="sfq__progress" data-progress></p>
	</div>
	<div class="sfq__grid">
		<svg class="sfq__svg" viewBox="0 0 200 180" role="img" aria-label="Сосуд с жидкостью и кубик над ним" data-svg>
			<rect class="sfq__glass-back" x="48" y="44" width="104" height="122" />
			<g data-body>
				<rect class="sfq__cube" x="-15" y="0" width="30" height="30" rx="1.5" data-cube />
				<rect class="sfq__cube-sheen" x="-15" y="0" width="30" height="30" rx="1.5" />
			</g>
			<rect class="sfq__liq" x="50" width="100" data-liq />
			<rect class="sfq__ghost" x="-15" y="0" width="30" height="30" data-ghost />
			<line class="sfq__surface" x1="50" x2="150" data-surface />
			<path class="sfq__glass" d="M 48 40 V 164 q 0 4 4 4 H 148 q 4 0 4 -4 V 40" />
			<text class="sfq__tag" x="100" y="178" text-anchor="middle" data-tag></text>
		</svg>
		<div class="sfq__side">
			<p class="sfq__q" data-q></p>
			<div class="sfq__options" role="group" aria-label="Ваш ответ">
				<button type="button" class="sfq__opt" data-a="sink">Утонет</button>
				<button type="button" class="sfq__opt" data-a="inside">Будет плавать внутри жидкости</button>
				<button type="button" class="sfq__opt" data-a="float">Будет плавать на поверхности</button>
			</div>
			<p class="sfq__feedback" data-feedback aria-live="polite"></p>
			<button type="button" class="sfq__next" data-next hidden>Следующий вопрос →</button>
		</div>
	</div>
</figure>

<style is:global>
	.sfq {
		--sfq-ice: hsl(193 80% 88%);
		--sfq-paraffin: hsl(48 45% 88%);
		--sfq-iron: hsl(214 9% 50%);
		--sfq-plexi: hsl(190 40% 80%);
		--sfq-gold: hsl(45 90% 55%);
		--sfq-water: var(--ig-vx);
		--sfq-kerosene: hsl(54 55% 72%);
		--sfq-mercury: hsl(222 8% 72%);
		--sfq-oil: hsl(44 95% 55%);
		--sfq-brine: hsl(170 65% 50%);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .sfq {
		--sfq-ice: hsl(193 70% 80%);
		--sfq-paraffin: hsl(45 40% 78%);
		--sfq-plexi: hsl(190 35% 72%);
		--sfq-kerosene: hsl(50 60% 58%);
		--sfq-oil: hsl(42 95% 48%);
		--sfq-brine: hsl(170 70% 36%);
		--sfq-mercury: hsl(222 6% 60%);
	}
	.sfq i {
		font-family: var(--ig-font-math);
	}
	.sfq__head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.sfq__title {
		margin: 0;
		font-family: var(--ig-font-display);
		font-size: var(--sl-text-3xl);
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.sfq__progress {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.sfq__grid {
		display: grid;
		grid-template-columns: minmax(9rem, 13rem) minmax(0, 1fr);
		gap: 1rem 1.25rem;
		align-items: center;
		margin-top: 0.5rem;
	}
	.sfq__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.sfq__glass-back {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 22%, transparent);
	}
	.sfq__glass {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-2) 70%, transparent);
		stroke-width: 2.5;
	}
	.sfq__cube {
		fill: var(--cube, var(--sfq-ice));
		stroke: color-mix(in oklab, var(--cube, var(--sfq-ice)) 55%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.sfq__cube-sheen {
		fill: #fff;
		fill-opacity: 0.18;
		stroke: none;
		clip-path: polygon(0 0, 100% 0, 0 100%);
	}
	.sfq__liq {
		fill: var(--liq, var(--sfq-water));
		fill-opacity: 0.3;
	}
	.sfq[data-liq='mercury'] .sfq__liq {
		fill-opacity: 0.9;
	}
	.sfq__ghost {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
		visibility: hidden;
	}
	.sfq[data-liq='mercury'] .sfq__ghost {
		visibility: visible;
	}
	.sfq__surface {
		stroke: var(--liq, var(--sfq-water));
		stroke-width: 2;
	}
	.sfq__nw {
		white-space: nowrap;
	}
	.sfq[data-liq='kerosene'] .sfq__liq {
		fill-opacity: 0.2;
	}
	.sfq__tag {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		font-family: var(--__sl-font);
	}
	.sfq__q {
		margin: 0 0 0.6rem;
		color: var(--sl-color-text);
	}
	.sfq__options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.sfq__opt,
	.sfq__next {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 0.95rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			background-color 0.2s,
			border-color 0.2s;
	}
	.sfq__opt:hover:not(:disabled),
	.sfq__next:hover {
		border-color: var(--sl-color-accent);
	}
	.sfq__opt:disabled {
		cursor: default;
		opacity: 0.55;
	}
	.sfq__opt.is-right {
		opacity: 1;
		border-color: hsl(145 60% 45%);
		background: color-mix(in oklab, hsl(145 60% 45%) 25%, transparent);
	}
	.sfq__opt.is-wrong {
		opacity: 1;
		border-color: var(--ig-vy);
		background: color-mix(in oklab, var(--ig-vy) 22%, transparent);
	}
	.sfq__next {
		margin-top: 0.6rem;
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.sfq__next[hidden] {
		display: none;
	}
	.sfq__feedback {
		min-height: 1.5em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	@media (max-width: 40rem) {
		.sfq {
			padding: 0.75rem;
		}
		.sfq__grid {
			grid-template-columns: 1fr;
		}
		.sfq__svg {
			max-width: 14rem;
			margin-inline: auto;
		}
	}
</style>

<script>
	import { G, fmtInt, clamp, reducedMotion } from './physics';

	type Item = { body: string; b: string; rhoB: number; liq: string; l: string; inL: string; rhoL: number };
	const ITEMS: Item[] = [
		{ body: 'ice', b: 'Кубик льда', rhoB: 900, liq: 'water', l: 'вода', inL: 'в воду', rhoL: 1000 },
		{ body: 'ice', b: 'Кубик льда', rhoB: 900, liq: 'kerosene', l: 'керосин', inL: 'в керосин', rhoL: 800 },
		{ body: 'iron', b: 'Железный кубик', rhoB: 7800, liq: 'mercury', l: 'ртуть', inL: 'в ртуть', rhoL: 13600 },
		{ body: 'paraffin', b: 'Парафиновый кубик', rhoB: 900, liq: 'oil', l: 'подсолнечное масло', inL: 'в подсолнечное масло', rhoL: 930 },
		{ body: 'plexi', b: 'Кубик из оргстекла', rhoB: 1200, liq: 'brine', l: 'солёная вода', inL: 'в крепкий раствор соли', rhoL: 1200 },
		{ body: 'gold', b: 'Золотой кубик', rhoB: 19300, liq: 'mercury', l: 'ртуть', inL: 'в ртуть', rhoL: 13600 },
	];
	const S = 10; // px per cm
	const A = 3; // cm, cube
	const BOTTOM = 166; // px
	const H0 = 7.6; // cm of liquid
	const RISE = 9 / 100; // a² / glass cross-section (10 × 10 cm)
	const SLOW = 1 / 3;

	const answerOf = (it: Item) => (it.rhoB > it.rhoL ? 'sink' : it.rhoB < it.rhoL ? 'float' : 'inside');

	for (const root of document.querySelectorAll<HTMLElement>('[data-sfq]')) {
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const body = q<SVGGElement>('[data-body]');
		const ghost = q<SVGRectElement>('[data-ghost]');
		const liqRect = q<SVGRectElement>('[data-liq]');
		const surface = q<SVGLineElement>('[data-surface]');
		const tag = q<SVGTextElement>('[data-tag]');
		const qText = q<HTMLElement>('[data-q]');
		const feedback = q<HTMLElement>('[data-feedback]');
		const next = q<HTMLButtonElement>('[data-next]');
		const progress = q<HTMLElement>('[data-progress]');
		const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-a]'));

		let idx = 0;
		let score = 0;
		let z = 0; // cube bottom above the glass bottom, cm
		let v = 0;
		let raf = 0;
		let lastT = 0;
		let lowering = 0; // seconds of the hand lowering the cube; −1 when the cube is free
		const Z_START = H0 + 1.2;
		const zMid = () => (H0 + RISE * A - A) / 2;

		const depth = () => clamp((H0 - z) / (1 - RISE), 0, A);
		const draw = () => {
			const d = depth();
			const yS = BOTTOM - (H0 + RISE * d) * S;
			liqRect.setAttribute('y', String(yS));
			liqRect.setAttribute('height', String(BOTTOM - yS));
			surface.setAttribute('y1', String(yS));
			surface.setAttribute('y2', String(yS));
			body.setAttribute('transform', `translate(100 ${BOTTOM - (z + A) * S})`);
			ghost.setAttribute('transform', `translate(100 ${BOTTOM - (z + A) * S})`);
			const top = BOTTOM - (z + A) * S;
			ghost.setAttribute('y', String(Math.max(0, yS - top)));
			ghost.setAttribute('height', String(Math.max(0, A * S - Math.max(0, yS - top))));
		};

		const show = () => {
			const it = ITEMS[idx];
			root.dataset.liq = it.liq;
			root.style.setProperty('--cube', `var(--sfq-${it.body})`);
			root.style.setProperty('--liq', `var(--sfq-${it.liq})`);
			progress.textContent = `Вопрос ${idx + 1} из ${ITEMS.length}`;
			qText.innerHTML = `${it.b} (<span class="sfq__nw"><i>ρ</i> = ${fmtInt(it.rhoB)} кг/м³</span>) опускают ${it.inL} (<span class="sfq__nw"><i>ρ</i> = ${fmtInt(it.rhoL)} кг/м³</span>). Что будет?`;
			tag.textContent = `${it.l}, ${fmtInt(it.rhoL)} кг/м³`;
			opts.forEach((o) => {
				o.disabled = false;
				o.classList.remove('is-right', 'is-wrong');
			});
			feedback.textContent = '';
			next.hidden = true;
			z = Z_START;
			v = 0;
			lowering = -1;
			draw();
		};

		const loop = (now: number) => {
			const it = ITEMS[idx];
			const dtReal = lastT ? Math.min((now - lastT) / 1000, 0.05) : 0;
			const dt = dtReal * SLOW;
			lastT = now;
			const m = it.rhoB * 27e-6;
			if (lowering >= 0) {
				// the hand lowers the cube smoothly until it is completely under the surface
				lowering = Math.min(1, lowering + dtReal / 1.1);
				const e = lowering < 0.5 ? 2 * lowering * lowering : 1 - 2 * (1 - lowering) ** 2;
				z = Z_START + (zMid() - Z_START) * e;
				v = 0;
				if (lowering >= 1) lowering = -1;
				draw();
				raf = requestAnimationFrame(loop);
				return;
			}
			let t = dt;
			while (t > 1e-9) {
				const h = Math.min(t, 2e-4);
				t -= h;
				const d = depth() / 100;
				const fa = it.rhoL * G * 9e-4 * d;
				const mAdd = 0.5 * it.rhoL * 9e-4 * d;
				let f = fa - m * G - 0.5 * it.rhoL * 1.05 * 9e-4 * v * Math.abs(v) * (d / 0.03);
				if (d > 0 && d < 0.03) f -= 2 * 0.25 * Math.sqrt(((it.rhoL * G * 9e-4) / (1 - RISE)) * (m + mAdd)) * v;
				f -= 0.4 * (m + mAdd) * v * (d > 0 ? 1 : 0);
				v += (f / (m + mAdd)) * h;
				z += v * 100 * h;
				if (z <= 0) {
					z = 0;
					if (v < 0) v = 0;
				}
			}
			// stop only at rest (slow AND almost no net force), never at a turning point of a bob
			const fNet = it.rhoL * G * 9e-4 * (depth() / 100) - m * G;
			const resting = Math.abs(v) < 1e-4 && ((z <= 0 && fNet <= 0) || Math.abs(fNet) < 0.01 * m * G);
			if (resting && dt > 0) {
				z = finalZ(it);
				v = 0;
			}
			draw();
			if (!resting || dt === 0) raf = requestAnimationFrame(loop);
			else {
				raf = 0;
				lastT = 0;
			}
		};

		const finalZ = (it: Item) => {
			const a = answerOf(it);
			if (a === 'sink') return 0;
			if (a === 'float') {
				const df = (it.rhoB / it.rhoL) * A;
				return H0 + RISE * df - df;
			}
			return zMid();
		};

		const explain = (it: Item) => {
			const rb = `<span class="sfq__nw"><i>ρ</i><sub>т</sub> = ${fmtInt(it.rhoB)} кг/м³</span>`;
			const rl = `<span class="sfq__nw"><i>ρ</i><sub>ж</sub> = ${fmtInt(it.rhoL)} кг/м³</span>`;
			const a = answerOf(it);
			if (a === 'sink') return `${rb} больше, чем ${rl}: сила тяжести больше архимедовой силы, и тело тонет.`;
			if (a === 'inside')
				return `${rb} равна ${rl}: отпущенное внутри жидкости тело остаётся на месте — сила тяжести уравновешена архимедовой силой.`;
			const pct = Math.round((it.rhoB / it.rhoL) * 100);
			return `${rb} меньше, чем ${rl}: тело всплывает и плавает, погрузившись на ${fmtInt(it.rhoB)}/${fmtInt(it.rhoL)} ≈ ${pct} % объёма.`;
		};

		for (const o of opts) {
			o.addEventListener('click', () => {
				const it = ITEMS[idx];
				const right = answerOf(it);
				const ok = o.dataset.a === right;
				if (ok) score += 1;
				opts.forEach((x) => {
					x.disabled = true;
					if (x.dataset.a === right) x.classList.add('is-right');
				});
				if (!ok) o.classList.add('is-wrong');
				feedback.innerHTML = `${ok ? '<strong>Верно!</strong>' : '<strong>Не совсем.</strong>'} ${explain(it)}`;
				next.hidden = false;
				next.textContent = idx < ITEMS.length - 1 ? 'Следующий вопрос →' : 'Узнать результат';
				if (reducedMotion()) {
					z = finalZ(it);
					v = 0;
					draw();
				} else if (!raf) {
					lastT = 0;
					lowering = 0;
					raf = requestAnimationFrame(loop);
				}
			});
		}
		next.addEventListener('click', () => {
			cancelAnimationFrame(raf);
			raf = 0;
			lastT = 0;
			if (idx < ITEMS.length - 1) {
				idx += 1;
				show();
				opts[0].focus();
				return;
			}
			if (next.dataset.done) {
				delete next.dataset.done;
				idx = 0;
				score = 0;
				show();
				return;
			}
			progress.textContent = 'Готово';
			qText.innerHTML = `Правильных ответов: <strong>${score} из ${ITEMS.length}</strong>. ${
				score === ITEMS.length
					? 'Отлично: вы уверенно сравниваете плотности!'
					: 'Главное правило: сравните плотность тела и плотность жидкости.'
			}`;
			opts.forEach((x) => (x.disabled = true));
			feedback.textContent = '';
			next.textContent = 'Пройти ещё раз';
			next.dataset.done = '1';
		});
		show();
	}
</script>
