---
/**
 * Two short looping opening scenes of «Архимедова сила. Плавание тел». No numbers in the pictures; the captions'
 * popovers explain.
 * Ball: an inflatable ball (25 cm across, 150 g) is held by a hand 22 cm under the water surface (250 px per m). The
 *   hand lets go and moves away; the ball shoots up, jumps out of the water, falls back, bobs and comes to rest
 *   floating 2 cm deep. Vertical motion integrated in the script: the weight, the buoyant force of the submerged cap
 *   ρgV, the added mass of the water ½ρV, quadratic drag (C = 0,47) and a little wave damping. The ball leaves the
 *   water at about 2 m/s and its centre rises about 0,3 m above the surface; drops fly off on ballistic arcs.
 * Anchor: a small steel cargo ship (39 m long, draft 2,6 m, 7 px per m) lies in 12 m of water. Its steel admiralty
 *   anchor (2 m, about 1 t) drops from the bow: a free fall of 3 m in the air, then it sinks at about 3 m/s (the
 *   chain and the windlass brake hold it back) and lies on the bottom in a puff of sand. The ship keeps floating.
 * Plays only while visible.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gDeep = `ari-deep-${uid}`;
const gSea = `ari-sea-${uid}`;
const gBall = `ari-ball-${uid}`;
// Ball scene: the water surface at y = 150, the ball centre at x = 170, radius 31,25 px
const SURF = 150;
const BR = 31.25;
// Anchor scene: waterline y = 130, sea bottom y = 214, the anchor falls along x = 314
const WL = 130;
const BOTTOM = 214;
const CONTAINERS = [
	{ x: 112, c: 'a' },
	{ x: 147, c: 'b' },
	{ x: 182, c: 'c' },
	{ x: 217, c: 'a' },
];
const PEBBLES = [18, 52, 96, 140, 176, 228, 262, 300, 338];
---

<IntroFrame data-arintro>
	<div class="intro__card" data-scene="ball">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Рука держит надувной мяч под водой. Рука отпускает мяч — он стремительно поднимается, выскакивает из воды, падает обратно, покачивается и остаётся плавать на поверхности, почти не погрузившись">
			<defs>
				<linearGradient id={gDeep} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" style="stop-color: var(--ig-vx); stop-opacity: 0.22"></stop>
					<stop offset="1" style="stop-color: var(--ig-vx); stop-opacity: 0.48"></stop>
				</linearGradient>
				<clipPath id={gBall}>
					<circle cx="0" cy="0" r={BR}></circle>
				</clipPath>
			</defs>
			<rect class="ari-sky" x="0" y="0" width="360" height={SURF + 4}></rect>
			<!-- the far shore -->
			<path class="ari-shore" d={`M 0 ${SURF} L 0 ${SURF - 12} Q 40 ${SURF - 22} 92 ${SURF - 13} Q 122 ${SURF - 8} 150 ${SURF} Z`}></path>
			<path class="ari-shore" d={`M 246 ${SURF} Q 290 ${SURF - 17} 330 ${SURF - 15} Q 350 ${SURF - 14} 360 ${SURF - 18} L 360 ${SURF} Z`}></path>
			<!-- the arm, drawn about the centre of the ball: the hand lies on the top of the ball -->
			<g data-arm>
				<path class="ari-sleeve" d="M 150 -186 L 172 -168 L 240 -250 L 214 -270 Z"></path>
				<path class="ari-skin" d="M 13.7 -37.6 L 32.8 -22.9 L 166 -176 L 147 -191 Z"></path>
				<path class="ari-skin" d="M -36.3 -16.9 A 40 40 0 0 1 30.6 -25.7 L 23.7 -19.9 A 31 31 0 0 0 -28.1 -13.1 Q -34 -12 -36.3 -16.9 Z"></path>
				<path class="ari-finger" d="M -27 -18.5 L -33 -22 M -21 -24.5 L -26.6 -29.5 M -13.6 -28.6 L -17.4 -34.6"></path>
			</g>
			<!-- the ball -->
			<g data-ball>
				<g clip-path={`url(#${gBall})`}>
					<circle class="ari-ball" cx="0" cy="0" r={BR}></circle>
					<path class="ari-stripe ari-stripe--a" d="M -8 -40 Q -26 0 -8 40 L -26 40 Q -44 0 -26 -40 Z"></path>
					<path class="ari-stripe ari-stripe--b" d="M 8 -40 Q -8 0 8 40 L 30 40 Q 14 0 30 -40 Z"></path>
					<ellipse class="ari-ball-shade" cx="10" cy="12" rx="34" ry="30"></ellipse>
				</g>
				<circle class="ari-ball-rim" cx="0" cy="0" r={BR}></circle>
				<ellipse class="ari-ball-cap" cx="-11" cy="-15" rx="6" ry="4"></ellipse>
			</g>
			<!-- the water in front -->
			<path class="ari-water" fill={`url(#${gDeep})`} d="" data-water></path>
			<path class="ari-surface" d="" data-surface></path>
			<g class="ari-drops" data-drops>
				{Array.from({ length: 8 }, () => <circle r="2.2" />)}
			</g>
		</svg>
		<div class="intro__foot">
			<p>Надувной мяч не удержать под водой: стоит его отпустить, и он <More term="выскакивает наверх">Вода давит на мяч со всех сторон, но снизу сильнее, чем сверху: давление в воде растёт с глубиной. Поэтому вода толкает мяч вверх. У мяча диаметром 25 см и массой 150 г эта сила примерно в 55 раз больше силы тяжести. Подробнее — в разделе <a href="#выталкивающая-сила">«Выталкивающая сила»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="anchor">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Стальное грузовое судно стоит на воде. С его носа бросают стальной якорь: он падает в воду и быстро опускается на дно, а судно остаётся на плаву">
			<defs>
				<linearGradient id={gSea} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" style="stop-color: var(--ig-vx); stop-opacity: 0.24"></stop>
					<stop offset="1" style="stop-color: var(--ig-vx); stop-opacity: 0.5"></stop>
				</linearGradient>
			</defs>
			<rect class="ari-sky" x="0" y="0" width="360" height={WL + 4}></rect>
			<path class="ari-shore" d={`M 0 ${WL} L 0 ${WL - 14} Q 30 ${WL - 22} 62 ${WL - 12} Q 80 ${WL - 6} 96 ${WL} Z`}></path>
			<rect class="ari-seabed" x="0" y={BOTTOM} width="360" height={240 - BOTTOM}></rect>
			{PEBBLES.map((x, k) => <ellipse class="ari-pebble" cx={x} cy={BOTTOM + 8 + (k % 3) * 6} rx={3 + (k % 2)} ry="2" />)}
			<!-- the chain and the anchor -->
			<path class="ari-chain" d="" data-chain></path>
			<g data-anchor>
				<circle class="ari-anchor-ring" cx="0" cy="-1.5" r="1.6"></circle>
				<line class="ari-anchor" x1="-4.5" y1="1.2" x2="4.5" y2="1.2"></line>
				<line class="ari-anchor" x1="0" y1="0" x2="0" y2="14"></line>
				<path class="ari-anchor ari-anchor-arms" d="M -6 8.5 Q -5 14 0 14 Q 5 14 6 8.5"></path>
				<path class="ari-anchor-fluke" d="M -6 8.5 l -1.8 1.6 l 2.6 0.6 Z M 6 8.5 l 1.8 1.6 l -2.6 0.6 Z"></path>
			</g>
			<g class="ari-bubbles" data-bubbles>
				{Array.from({ length: 7 }, () => <circle r="1.6" />)}
			</g>
			<g class="ari-puff" data-puff>
				{Array.from({ length: 5 }, () => <circle r="3" />)}
			</g>
			<!-- the ship -->
			<g data-ship>
				<rect class="ari-mast" x="262" y="66" width="2.6" height="42"></rect>
				<line class="ari-stay" x1="263" y1="68" x2="306" y2="104"></line>
				<line class="ari-stay" x1="263" y1="68" x2="102" y2="80"></line>
				{
					CONTAINERS.map((b) => (
						<g>
							<rect class={`ari-box ari-box--${b.c}`} x={b.x} y="91" width="33" height="18" rx="1" />
							<path class="ari-box-ribs" d={`M ${b.x + 8} 93 V 107 M ${b.x + 16.5} 93 V 107 M ${b.x + 25} 93 V 107`} />
						</g>
					))
				}
				<rect class="ari-funnel" x="56" y="58" width="13" height="22" rx="1.5"></rect>
				<rect class="ari-funnel-band" x="56" y="62" width="13" height="5"></rect>
				<rect class="ari-house" x="44" y="78" width="56" height="32" rx="2"></rect>
				<rect class="ari-house" x="50" y="70" width="44" height="10" rx="1.5"></rect>
				{[54, 66, 78].map((x) => <rect class="ari-window" x={x} y="72.5" width="8" height="4.5" rx="1" />)}
				{[52, 64, 76, 88].map((x) => <circle class="ari-porthole" cx={x} cy="94" r="2" />)}
				<path class="ari-hull" d="M 32 108 L 308 102 L 302 126 Q 296 148 276 148 L 50 148 Q 38 148 36 136 Z"></path>
				<path class="ari-boot" d="M 35 129.5 L 302.4 124.6 L 301.2 129 L 35.7 134 Z"></path>
				<line class="ari-deckline" x1="32" y1="108" x2="308" y2="102"></line>
				<circle class="ari-hawse" cx="300" cy="108" r="2.2"></circle>
			</g>
			<path class="ari-water" fill={`url(#${gSea})`} d="" data-sea></path>
			<path class="ari-surface" d="" data-seasurf></path>
			<g class="ari-drops" data-splash>
				{Array.from({ length: 6 }, () => <circle r="1.8" />)}
			</g>
		</svg>
		<div class="intro__foot">
			<p>Стальной якорь сразу уходит на дно, а стальное судно, которое в сотни раз тяжелее якоря, <More term="держится на воде">Корпус судна внутри полый, в нём много воздуха. Погружаясь, судно вытесняет так много воды, что её вес сравнивается с весом судна, когда вода ещё далеко от палубы. Подробнее — в разделе <a href="#плавание-судов">«Плавание судов»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-arintro] {
		--ari-sky: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-6, #17181c));
		--ari-skin: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-2));
		--ari-cloth: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
		--ari-steel: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-3));
		--ari-hull: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
		--ari-house: color-mix(in oklab, var(--sl-color-gray-2) 85%, var(--ig-v));
		--ari-sand: color-mix(in oklab, var(--ig-v) 32%, var(--sl-color-gray-4));
		--ari-shore: color-mix(in oklab, hsl(120 40% 45%) 45%, var(--sl-color-gray-4));
		--ari-ball: #f4f1ea;
	}
	:root[data-theme='light'] [data-arintro] {
		--ari-sky: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-7, #fff));
		--ari-skin: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
		--ari-steel: color-mix(in oklab, var(--ig-vx) 20%, var(--sl-color-gray-3));
		--ari-hull: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-3));
		--ari-house: var(--sl-color-gray-7, #fff);
		--ari-sand: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-5));
		--ari-shore: color-mix(in oklab, hsl(120 40% 40%) 50%, var(--sl-color-gray-5));
		--ari-ball: #ffffff;
	}
	.ari-sky {
		fill: var(--ari-sky);
	}
	.ari-water {
		pointer-events: none;
	}
	.ari-surface {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 80%, var(--sl-color-white));
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.ari-drops circle {
		fill: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-white));
	}
	.ari-skin {
		fill: var(--ari-skin);
		stroke: color-mix(in oklab, var(--ari-skin) 70%, var(--sl-color-black));
		stroke-width: 1;
	}
	.ari-finger {
		fill: none;
		stroke: color-mix(in oklab, var(--ari-skin) 65%, var(--sl-color-black));
		stroke-width: 1;
		stroke-linecap: round;
	}
	.ari-sleeve {
		fill: var(--ari-cloth);
	}
	.ari-ball {
		fill: var(--ari-ball);
	}
	.ari-stripe--a {
		fill: var(--ig-vy);
	}
	.ari-stripe--b {
		fill: var(--ig-v);
	}
	.ari-ball-shade {
		fill: var(--sl-color-black);
		opacity: 0.12;
		transform: translate(14px, 14px);
	}
	.ari-ball-rim {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.ari-ball-cap {
		fill: var(--sl-color-white);
		opacity: 0.55;
	}
	.ari-shore {
		fill: var(--ari-shore);
	}
	.ari-seabed {
		fill: var(--ari-sand);
	}
	.ari-pebble {
		fill: color-mix(in oklab, var(--ari-sand) 70%, var(--sl-color-black));
	}
	.ari-hull {
		fill: var(--ari-hull);
		stroke: color-mix(in oklab, var(--ari-hull) 60%, var(--sl-color-black));
		stroke-width: 1;
	}
	.ari-boot {
		fill: color-mix(in oklab, var(--ig-vy) 60%, var(--sl-color-gray-4));
	}
	.ari-deckline {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.ari-house {
		fill: var(--ari-house);
		stroke: color-mix(in oklab, var(--ari-house) 70%, var(--sl-color-black));
		stroke-width: 0.8;
	}
	.ari-window,
	.ari-porthole {
		fill: color-mix(in srgb, var(--ig-vx) 60%, var(--sl-color-gray-5));
	}
	.ari-funnel {
		fill: var(--sl-color-gray-4);
	}
	.ari-funnel-band {
		fill: var(--ig-vy);
	}
	.ari-mast {
		fill: var(--sl-color-gray-3);
	}
	.ari-stay {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	.ari-box {
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 60%, var(--sl-color-black));
		stroke-width: 0.8;
	}
	.ari-box--a {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-gray-4));
	}
	.ari-box--b {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-4));
	}
	.ari-box--c {
		fill: color-mix(in oklab, var(--ig-v) 75%, var(--sl-color-gray-4));
	}
	.ari-box-ribs {
		stroke: var(--sl-color-black);
		stroke-width: 0.8;
		opacity: 0.25;
	}
	.ari-hawse {
		fill: var(--sl-color-gray-6, #17181c);
	}
	.ari-chain {
		fill: none;
		stroke: var(--ari-steel);
		stroke-width: 1.6;
		stroke-dasharray: 2 1;
	}
	.ari-anchor {
		fill: none;
		stroke: var(--ari-steel);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.ari-anchor-ring {
		fill: none;
		stroke: var(--ari-steel);
		stroke-width: 1.2;
	}
	.ari-anchor-fluke {
		fill: var(--ari-steel);
	}
	.ari-bubbles circle {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-white));
		stroke-width: 0.9;
	}
	.ari-puff circle {
		fill: var(--ari-sand);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const f1 = (v: number) => v.toFixed(1);
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const G = 9.8;
	const DT = 1 / 600;

	/** The ball, released at t = 0 from 0,22 m under the surface: [t, height of the centre above the surface (m), velocity]. */
	const ballTrack = () => {
		const R = 0.125;
		const m = 0.15;
		const rho = 1000;
		const V = (4 / 3) * Math.PI * R ** 3;
		const A = Math.PI * R * R;
		const vsub = (z: number) => {
			if (z <= -R) return V;
			if (z >= R) return 0;
			const h = R - z;
			return (Math.PI * h * h * (3 * R - h)) / 3;
		};
		let z = -0.22;
		let v = 0;
		const out: number[][] = [];
		for (let t = 0; t <= 5; t += DT) {
			out.push([t, z, v]);
			const vs = vsub(z);
			const f = vs / V;
			const F =
				rho * G * vs -
				m * G -
				0.5 * rho * 0.47 * A * f * v * Math.abs(v) -
				(4 * f + (vs > 0 ? 0.6 : 0)) * v -
				0.5 * 1.2 * 0.47 * A * v * Math.abs(v);
			v += (F / (m + 0.5 * rho * vs)) * DT;
			z += v * DT;
		}
		return out;
	};

	/** The anchor, released at t = 0 with its shackle three metres above the water: [t, depth of its shackle below the waterline (m)]. */
	const anchorTrack = (floor: number) => {
		let y = -3;
		let v = 0;
		const out: number[][] = [];
		for (let t = 0; t <= 8; t += DT) {
			out.push([t, y, v]);
			if (y >= floor) {
				v = 0;
				continue;
			}
			// in the water: net weight against drag, terminal speed 3 m/s (the chain and the brake hold it back)
			const a = y < 0 ? G : G * (1 - 1030 / 7800) * (1 - (v * Math.abs(v)) / 9);
			v += a * DT;
			y = Math.min(floor, y + v * DT);
		}
		return out;
	};
	const at = (track: number[][], t: number) => track[Math.max(0, Math.min(track.length - 1, Math.round(t / DT)))];

	for (const root of document.querySelectorAll<HTMLElement>('[data-arintro]')) {
		// Ball: the hand lets go at 0,25 s of the run and moves away; 4,5 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ball"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 250; // px per m
			const SURF = 150;
			const XC = 170;
			const RPX = 31.25;
			const ball = $<SVGGElement>('[data-ball]');
			const arm = $<SVGGElement>('[data-arm]');
			const water = $<SVGPathElement>('[data-water]');
			const surf = $<SVGPathElement>('[data-surface]');
			const drops = [...card.querySelectorAll<SVGCircleElement>('[data-drops] circle')];
			const track = ballTrack();
			// moments the ball crosses the surface going up fast: drops and a ring of waves
			const cross: { t: number; v: number }[] = [];
			for (let i = 1; i < track.length; i++) {
				const [t, z, v] = track[i];
				if (track[i - 1][1] < 0 && z >= 0) cross.push({ t, v });
				if (track[i - 1][1] > 0 && z <= 0) cross.push({ t, v });
			}
			const DROPS = drops.map((_, k) => ({ vx: (k % 2 ? 1 : -1) * (0.35 + 0.12 * (k >> 1)), vy: 0.55 + 0.1 * ((k * 3) % 4) }));
			const T0 = 0.25;
			const RUN = 4.5;
			scene(card, RUN, (x) => {
				const t = x * RUN - T0;
				const [, z] = t < 0 ? [0, -0.22] : at(track, t);
				const y = SURF - z * K;
				ball.setAttribute('transform', `translate(${XC} ${f1(y)})`);
				// the hand holds the ball, then lets go and moves up and away
				const away = smooth(0, 0.7, t);
				arm.setAttribute('transform', `translate(${f1(XC + 150 * away)} ${f1(y - 120 * away)})`);
				arm.style.opacity = (1 - smooth(0.4, 0.7, t)).toFixed(2);
				// the surface: rings of waves from each crossing, plus a gentle ripple
				const now = performance.now() / 1000;
				const pts: string[] = [];
				for (let px = 0; px <= 360; px += 6) {
					let h = 0.8 * Math.sin(px / 23 + now * 1.7);
					for (const c of cross) {
						const tau = t - c.t;
						if (tau <= 0) continue;
						const d = Math.max(0, Math.abs(px - XC) - 20);
						if (d > 70 * tau) continue;
						const amp = Math.min(5, 2.4 * Math.abs(c.v)) * Math.exp(-tau / 0.9) / (1 + d / 80);
						h += amp * Math.sin((2 * Math.PI * (d - 70 * tau)) / 26);
					}
					pts.push(`${px} ${f1(SURF + h)}`);
				}
				surf.setAttribute('d', `M ${pts.join(' L ')}`);
				water.setAttribute('d', `M ${pts.join(' L ')} L 360 240 L 0 240 Z`);
				// drops thrown up when the ball breaks out of the water
				const up = cross.find((c) => c.v > 1);
				drops.forEach((d, k) => {
					const tau = up ? t - up.t : -1;
					const p = DROPS[k];
					const vy = p.vy * (up ? up.v : 0);
					const hgt = vy * tau - (G * tau * tau) / 2;
					if (!up || tau <= 0 || hgt < 0) {
						d.style.opacity = '0';
						return;
					}
					d.style.opacity = '0.9';
					d.setAttribute('cx', f1(XC + (k % 2 ? 1 : -1) * 26 + p.vx * tau * K));
					d.setAttribute('cy', f1(SURF - hgt * K));
				});
			});
		}

		// Anchor: released at 0,4 s of the run, lies on the bottom about 4,7 s later; 6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="anchor"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 7; // px per m
			const WL = 130;
			const BOTTOM = 214;
			const AX = 314;
			const HAWSE = { x: 300, y: 108 };
			const FLOOR = (BOTTOM - 14 - WL) / K; // m: the anchor's crown touches the bottom
			const anchor = $<SVGGElement>('[data-anchor]');
			const chain = $<SVGPathElement>('[data-chain]');
			const ship = $<SVGGElement>('[data-ship]');
			const sea = $<SVGPathElement>('[data-sea]');
			const seasurf = $<SVGPathElement>('[data-seasurf]');
			const bubbles = [...card.querySelectorAll<SVGCircleElement>('[data-bubbles] circle')];
			const puffs = [...card.querySelectorAll<SVGCircleElement>('[data-puff] circle')];
			const splash = [...card.querySelectorAll<SVGCircleElement>('[data-splash] circle')];
			const track = anchorTrack(FLOOR);
			const tIn = track.find((p) => p[1] >= 0)![0];
			const vIn = track.find((p) => p[1] >= 0)![2];
			const tDown = track.find((p) => p[1] >= FLOOR)![0];
			const T0 = 0.4;
			const RUN = 6;
			scene(card, RUN, (x) => {
				const t = x * RUN - T0;
				const now = performance.now() / 1000;
				const bob = 0.6 * Math.sin(now * 1.3);
				ship.setAttribute('transform', `translate(0 ${f1(bob)})`);
				// the anchor hangs at the hawse until it is let go
				const [, d] = t < 0 ? [0, -3] : at(track, t);
				const ay = WL + d * K;
				anchor.setAttribute('transform', `translate(${AX} ${f1(ay)})`);
				// the chain: taut while the anchor falls, slack on the bottom afterwards
				const slack = t > tDown ? smooth(0, 1.2, t - tDown) : 0;
				const hy = HAWSE.y + bob;
				const cx = (HAWSE.x + AX) / 2 + 10 * slack;
				const cy = (hy + ay) / 2 + 40 * slack;
				chain.setAttribute('d', `M ${HAWSE.x} ${f1(hy)} Q ${f1(cx)} ${f1(cy)} ${AX} ${f1(ay - 2)}`);
				// the sea surface with a ring from the splash
				const pts: string[] = [];
				for (let px = 0; px <= 360; px += 6) {
					let h = 0.9 * Math.sin(px / 19 - now * 1.6);
					const tau = t - tIn;
					const dd = Math.abs(px - AX);
					if (tau > 0 && dd < 60 * tau) h += 2.4 * Math.exp(-tau / 1.1) * Math.sin((2 * Math.PI * (dd - 60 * tau)) / 18) / (1 + dd / 50);
					pts.push(`${px} ${f1(WL + h)}`);
				}
				seasurf.setAttribute('d', `M ${pts.join(' L ')}`);
				sea.setAttribute('d', `M ${pts.join(' L ')} L 360 ${BOTTOM} L 0 ${BOTTOM} Z`);
				// splash drops
				splash.forEach((c, k) => {
					const tau = t - tIn;
					const vy = vIn * (0.25 + 0.06 * k);
					const hgt = vy * tau - (G * tau * tau) / 2;
					if (tau <= 0 || hgt < 0) {
						c.style.opacity = '0';
						return;
					}
					c.style.opacity = '0.9';
					c.setAttribute('cx', f1(AX + (k % 2 ? 1 : -1) * (1.2 + 0.4 * k) * tau * K));
					c.setAttribute('cy', f1(WL - hgt * K));
				});
				// bubbles rise from where the anchor passed
				bubbles.forEach((c, k) => {
					const born = tIn + 0.35 * k;
					const tau = t - born;
					if (tau <= 0 || t > tDown + 3) {
						c.style.opacity = '0';
						return;
					}
					const [, y0] = at(track, born);
					const y = WL + y0 * K - 22 * tau;
					if (y < WL + 2) {
						c.style.opacity = '0';
						return;
					}
					c.style.opacity = (0.8 * (1 - smooth(2, 3, tau))).toFixed(2);
					c.setAttribute('cx', f1(AX + 2 * Math.sin(tau * 5 + k)));
					c.setAttribute('cy', f1(y));
					c.setAttribute('r', f1(1.2 + 0.25 * k));
				});
				// a puff of sand where it lands
				puffs.forEach((c, k) => {
					const tau = t - tDown;
					if (tau <= 0) {
						c.style.opacity = '0';
						return;
					}
					const s = (k - 2) / 2;
					c.style.opacity = (0.55 * (1 - smooth(0.2, 1.4, tau))).toFixed(2);
					c.setAttribute('cx', f1(AX + s * (6 + 16 * Math.sqrt(tau))));
					c.setAttribute('cy', f1(BOTTOM - 2 - 6 * Math.sqrt(tau) * (1 - Math.abs(s) * 0.5)));
					c.setAttribute('r', f1(2.5 + 4 * Math.sqrt(tau)));
				});
			});
		}
	}
</script>
