---
/** Frame of the explanatory pictures of «Архимедова сила. Плавание тел» (panels, caption, «Повторить»). Renders nothing. */
---

<style is:global>
	.ap-pic {
		--ap-fg: var(--ig-vy);
		--ap-fa: hsl(150, 60%, 58%);
		--ap-water: color-mix(in srgb, var(--ig-vx) 24%, transparent);
		--ap-water-edge: color-mix(in srgb, var(--ig-vx) 80%, var(--sl-color-white));
		--ap-glass: color-mix(in oklab, var(--sl-color-gray-2) 70%, transparent);
		--ap-steel: color-mix(in oklab, var(--ig-vx) 15%, var(--sl-color-gray-3));
		--ap-metal: color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--ig-vx));
		--ap-body: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-3));
		--ap-stone: color-mix(in oklab, var(--ig-v) 18%, var(--sl-color-gray-3));
		--ap-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .ap-pic {
		--ap-fa: hsl(150, 70%, 30%);
		--ap-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.ap-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.ap-pic--one .ap-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 32rem;
		margin-inline: auto;
	}
	.ap-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.ap-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.ap-pic .ap-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.ap-pic .ap-math {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 16px;
	}
	.ap-pic .ap-sub {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 11px;
	}
	.ap-pic .ap-tfg {
		fill: var(--ap-fg);
		font-weight: 700;
	}
	.ap-pic .ap-tfa {
		fill: var(--ap-fa);
		font-weight: 700;
	}
	.ap-pic .ap-small {
		font-size: 11.5px;
	}
	.ap-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.ap-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.ap-pic__foot figcaption i {
		font-family: var(--ig-font-math);
	}
	.ap-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.ap-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.ap-water {
		fill: var(--ap-water);
	}
	.ap-surface {
		stroke: var(--ap-water-edge);
		stroke-width: 2;
		fill: none;
	}
	.ap-glass {
		fill: none;
		stroke: var(--ap-glass);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.ap-stand {
		fill: var(--ap-metal);
	}
	.ap-line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		fill: none;
	}
	.ap-thread {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.ap-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
		fill: none;
	}
	.ap-arrow {
		stroke-width: 3.2;
		stroke-linecap: round;
		fill: none;
	}
	.ap-arrow--fg {
		stroke: var(--ap-fg);
	}
	.ap-arrow--fa {
		stroke: var(--ap-fa);
	}
	.ap-head--fg {
		fill: var(--ap-fg);
	}
	.ap-head--fa {
		fill: var(--ap-fa);
	}
	.ap-dim {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		fill: none;
	}
	@media (max-width: 40rem) {
		.ap-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
