---
/**
 * Pictures to «Где это встречается».
 * Submarine: a section with the pressure hull and the ballast tanks between it and the outer hull, the tanks half
 *   full of water (air above it).
 * Fish: the swim bladder inside the body.
 * Hydrometer: the same hydrometer in water (1000 kg/m³) and in salt water (1200 kg/m³). In the drawing the volume
 *   under the surface is kept as an area: the bulb with the shot takes 771 px², the stem is 8 px wide.
 *   In water 771 + 8 · 30 = 1011 px² are under the surface (30 px of the stem), in salt water 1011 / 1,2 = 842,5 px²
 *   (8,9 px of the stem): it floats 21 px higher.
 * Balloon: hot air inside the envelope; the Archimedes force is larger than the force of gravity on the balloon with
 *   its basket and the air inside, so it rises.
 */
import ArhPicStyles from './ArhPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
// hydrometer: the surface in both cylinders at y = 84; in water the stem goes 30 px under it
const HS = 84;
const hydro = (cx: number, stem: number) => {
	// stem: px of the stem under the surface; the stem bottom (top of the bulb) is at HS + stem
	const yb = HS + stem; // where the stem meets the bulb
	return { cx, yb };
};
const inWater = hydro(100, 30);
const inBrine = hydro(236, 8.9);
const SCALE = [0, 1, 2, 3, 4, 5, 6, 7, 8];
---

<ArhPicStyles />
<figure class="ap-pic not-content">
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Подводная лодка в разрезе. Между прочным корпусом и лёгким наружным корпусом — балластные цистерны. В них вода, над водой воздух">
			<defs>
				<clipPath id={`${uid}-tank`}>
					<path d="M 40 110 Q 40 76 100 74 L 236 74 Q 290 76 292 110 Q 290 144 236 146 L 100 146 Q 40 144 40 110 Z M 70 110 Q 70 90 108 88 L 228 88 Q 262 90 264 110 Q 262 130 228 132 L 108 132 Q 70 130 70 110 Z" clip-rule="evenodd" fill-rule="evenodd"></path>
				</clipPath>
			</defs>
			<rect class="ap-water" x="0" y="34" width="320" height="166"></rect>
			<line class="ap-surface" x1="0" x2="320" y1="34" y2="34"></line>
			<text class="ap-title" x="14" y="24">Подводная лодка</text>
			<path class="up-sail" d="M 136 74 L 142 50 H 186 L 190 74 Z"></path>
			<line class="up-mast" x1="172" x2="172" y1="50" y2="38"></line>
			<g clip-path={`url(#${uid}-tank)`}>
				<rect class="up-air" x="30" y="70" width="270" height="80"></rect>
				<rect class="up-tankwater" x="30" y="112" width="270" height="40"></rect>
			</g>
			<path class="up-outer" d="M 40 110 Q 40 76 100 74 L 236 74 Q 290 76 292 110 Q 290 144 236 146 L 100 146 Q 40 144 40 110 Z"></path>
			<path class="up-inner" d="M 70 110 Q 70 90 108 88 L 228 88 Q 262 90 264 110 Q 262 130 228 132 L 108 132 Q 70 130 70 110 Z"></path>
			<line class="up-tankwl" x1="44" x2="290" y1="112" y2="112"></line>
			<path class="up-screw" d="M 292 102 L 302 96 L 302 124 L 292 118 Z"></path>
			<text x="94" y="114">прочный корпус</text>
			<text x="14" y="178">балластная цистерна: вода</text>
			<path class="ap-lead" d="M 120 168 L 128 142"></path>
			<text x="196" y="178">и воздух</text>
			<path class="ap-lead" d="M 226 166 L 240 82"></path>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Ареометр в воде и в солёной воде. В солёной воде, которая плотнее, он плавает выше. Плотность читают по делению шкалы у поверхности жидкости">
			<text class="ap-title" x="14" y="24">Ареометр</text>
			{
				[
					{ h: inWater, label: 'вода', read: '1000 кг/м³' },
					{ h: inBrine, label: 'солёная вода', read: '1200 кг/м³' },
				].map(({ h, label, read }) => (
					<g>
						<rect class={label === 'вода' ? 'ap-water' : 'up-brine'} x={h.cx - 34} y={HS} width="68" height={170 - HS} />
						<line class="ap-surface" x1={h.cx - 34} x2={h.cx + 34} y1={HS} y2={HS} />
						<path class="ap-glass" d={`M ${h.cx - 36} 54 V 171 H ${h.cx + 36} V 54`} />
						<g transform={`translate(${h.cx} ${h.yb})`}>
							<rect class="up-hglass" x="-4" y="-104" width="8" height="104" rx="2" />
							{SCALE.map((k) => <line class="up-hscale" x1="-4" x2={k % 2 ? 0 : 2} y1={-8 - 10 * k} y2={-8 - 10 * k} />)}
							<path class="up-hglass" d="M -4 0 Q -12 2 -12 14 Q -12 30 -4 34 L -3 44 Q 0 48 3 44 L 4 34 Q 12 30 12 14 Q 12 2 4 0 Z" />
							<circle class="up-shot" cx="-1.5" cy="40" r="1.6" />
							<circle class="up-shot" cx="1.6" cy="41" r="1.6" />
							<circle class="up-shot" cx="0" cy="38" r="1.6" />
						</g>
						<text class="ap-small" x={h.cx} y="186" text-anchor="middle">{label}</text>
						<text class="ap-small" x={h.cx} y="199" text-anchor="middle">{read}</text>
					</g>
				))
			}
			<text class="ap-small" x="148" y="44">шкала</text>
			<path class="ap-lead" d={`M 146 42 L ${inWater.cx + 6} ${inWater.yb - 70}`}></path>
			<text class="ap-small" x="146" y="150">груз</text>
			<path class="ap-lead" d={`M 144 146 L ${inWater.cx + 5} ${inWater.yb + 40}`}></path>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Рыба. Внутри её тела — плавательный пузырь, наполненный газом">
			<rect class="ap-water" x="0" y="34" width="320" height="166"></rect>
			<line class="ap-surface" x1="0" x2="320" y1="34" y2="34"></line>
			<text class="ap-title" x="14" y="24">Рыба</text>
			<path class="up-fish" d="M 60 118 Q 110 70 190 82 Q 236 90 252 118 Q 236 146 190 152 Q 110 162 60 118 Z"></path>
			<path class="up-fish" d="M 250 118 L 292 90 Q 284 118 292 146 Z"></path>
			<path class="up-fin" d="M 140 80 Q 160 60 190 78 Z"></path>
			<path class="up-fin" d="M 150 152 Q 168 170 186 150 Z"></path>
			<circle class="up-eye" cx="88" cy="110" r="5"></circle>
			<path class="up-gill" d="M 106 98 Q 114 118 106 136"></path>
			<ellipse class="up-bladder" cx="168" cy="108" rx="44" ry="11"></ellipse>
			<text x="110" y="186">плавательный пузырь</text>
			<path class="ap-lead" d="M 176 172 L 172 120"></path>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 320 200" role="img" aria-label="Воздушный шар. Горелка нагревает воздух внутри оболочки. Архимедова сила больше силы тяжести, и шар поднимается">
			<defs>
				<marker id={`${uid}-fg`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto">
					<path class="ap-head--fg" d="M0,0 L10,5 L0,10 z"></path>
				</marker>
				<marker id={`${uid}-fa`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto">
					<path class="ap-head--fa" d="M0,0 L10,5 L0,10 z"></path>
				</marker>
			</defs>
			<text class="ap-title" x="14" y="24">Воздушный шар</text>
			<path class="up-envelope" d="M 200 34 C 250 34 266 76 252 108 Q 240 130 218 146 L 182 146 Q 160 130 148 108 C 134 76 150 34 200 34 Z"></path>
			<path class="up-gore" d="M 200 34 C 180 54 174 106 188 146 M 200 34 C 220 54 226 106 212 146"></path>
			<line class="ap-thread" x1="184" x2="188" y1="146" y2="164"></line>
			<line class="ap-thread" x1="216" x2="212" y1="146" y2="164"></line>
			<path class="up-flame" d="M 200 152 Q 194 142 200 130 Q 206 142 200 152 Z"></path>
			<rect class="up-basket" x="186" y="164" width="28" height="16" rx="2"></rect>
			<text x="262" y="70">горячий</text>
			<text x="262" y="86">воздух</text>
			<path class="ap-lead" d="M 260 80 L 236 88"></path>
			<line class="ap-arrow ap-arrow--fa" x1="200" x2="200" y1="96" y2="48" marker-end={`url(#${uid}-fa)`}></line>
			<text class="ap-tfa" x="192" y="66" text-anchor="end"><tspan class="ap-math">F</tspan><tspan class="ap-sub" dy="4">А</tspan></text>
			<line class="ap-arrow ap-arrow--fg" x1="200" x2="200" y1="172" y2="190" marker-end={`url(#${uid}-fg)`}></line>
			<text class="ap-tfg" x="218" y="194"><tspan class="ap-math">F</tspan><tspan class="ap-sub" dy="4">тяж</tspan></text>
			<text class="ap-small" x="236" y="150">горелка</text>
			<path class="ap-lead" d="M 234 146 L 206 142"></path>
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>Подводная лодка погружается, когда её балластные цистерны заполняют водой. Ареометр в более плотной жидкости плавает выше. Плавательный пузырь помогает рыбе держаться на нужной глубине. Шар с горячим воздухом поднимается: архимедова сила больше силы тяжести.</figcaption>
	</div>
</figure>

<style>
	.up-outer {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-3));
		stroke-width: 2.5;
	}
	.up-inner {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--sl-color-bg));
		stroke: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-2));
		stroke-width: 3;
	}
	.up-sail,
	.up-screw {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-3));
	}
	.up-mast {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.up-air {
		fill: var(--sl-color-bg);
	}
	.up-tankwater {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
	}
	.up-tankwl {
		stroke: var(--ap-water-edge);
		stroke-width: 1.4;
	}
	.up-brine {
		fill: color-mix(in srgb, hsl(170 65% 50%) 30%, transparent);
	}
	.up-hglass {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 40%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.up-hscale {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.up-shot {
		fill: var(--sl-color-gray-2);
	}
	.up-fish {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.up-fin {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-3));
	}
	.up-eye {
		fill: var(--sl-color-gray-6, #17181c);
	}
	.up-gill {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-black));
		stroke-width: 1.4;
	}
	.up-bladder {
		fill: color-mix(in oklab, var(--sl-color-white) 70%, var(--ig-vx));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.up-envelope {
		fill: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.up-gore {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-3));
		stroke-width: 6;
		opacity: 0.6;
	}
	.up-flame {
		fill: var(--ig-v);
	}
	.up-basket {
		fill: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-black));
		stroke-width: 1;
	}
</style>
