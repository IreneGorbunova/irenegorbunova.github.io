---
/** Colors of the swimmer (swimmer.ts): skin, outline, hair, trunks. Renders nothing; the same tones as the reference person. */
---

<style is:global>
	.sw-host {
		--sw-skin: hsl(26, 55%, 72%);
		--sw-line: hsl(222, 35%, 14%);
		--sw-hair: hsl(25, 40%, 28%);
	}
	:root[data-theme='light'] .sw-host {
		--sw-line: hsl(222, 30%, 22%);
	}
	.sw-host .sw-far {
		filter: brightness(0.8);
	}
	.sw-host .sw-outline {
		fill: none;
		stroke: var(--sw-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.sw-host .sw-limb {
		fill: none;
		stroke: var(--sw-skin);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.sw-host .sw-skin {
		fill: var(--sw-skin);
		stroke: var(--sw-line);
		stroke-width: 0.7;
	}
	.sw-host .sw-ear {
		stroke-width: 0.5;
	}
	.sw-host .sw-trunk {
		fill: none;
		stroke-linecap: butt;
	}
	.sw-host .sw-suit {
		stroke: var(--sw-line);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	.sw-host .sw-suit--red {
		fill: var(--ig-vy);
	}
	.sw-host .sw-trunk.sw-suit--red {
		stroke: var(--ig-vy);
	}
	.sw-host .sw-suit--blue {
		fill: hsl(205, 70%, 45%);
	}
	.sw-host .sw-trunk.sw-suit--blue {
		stroke: hsl(205, 70%, 45%);
	}
	.sw-host .sw-dot,
	.sw-host .sw-eye {
		fill: var(--sw-line);
	}
	.sw-host .sw-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	.sw-host .sw-brow,
	.sw-host .sw-mouth,
	.sw-host .sw-toes {
		fill: none;
		stroke: var(--sw-line);
		stroke-width: 0.7;
		stroke-linecap: round;
	}
	.sw-host .sw-hair {
		fill: var(--sw-hair);
	}
	.sw-host .sw-foot {
		stroke-width: 0.7;
	}
</style>
