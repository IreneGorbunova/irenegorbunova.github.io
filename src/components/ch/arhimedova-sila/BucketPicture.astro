---
/**
 * Picture to the law of Archimedes: the experiment with «Archimedes' bucket» as in the school textbook.
 * A spring holds a small bucket, and under it on a thread a body whose volume equals the inner volume of the bucket
 * (both 34 × 34 px in the drawing). The pointer of the spring stands at a mark.
 * 1. A lab jack raises a vessel filled to its spout: the body goes under water, the water it pushes out runs into
 *    a beaker, and the spring gets shorter (the pointer rises by 14 px when the body is fully under water).
 * 2. The water from the beaker is poured into the bucket: it fills the bucket exactly, and the pointer comes back to
 *    the mark. The buoyant force equals the weight of the water pushed out by the body.
 * The body stays under water the whole time (it rises with the spring by 14 px and has room for it). Volumes are
 * kept as areas in the drawing: the water in the beaker (40 px wide) rises by 34 · 34 / 40 = 28,9 px.
 */
import ArhPicStyles from './ArhPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const Y0 = 92; // the pointer at the mark
const RULER = Array.from({ length: 15 }, (_, k) => 64 + 4 * k);
---

<ArhPicStyles />
<figure class="ap-pic ap-pic--one not-content" data-bucket>
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 0 360 330" role="img" aria-label="Опыт с ведёрком Архимеда. На пружине висят ведёрко и под ним тело. Тело погружают в сосуд, полный воды: вытесненная вода выливается в стакан, пружина сжимается, указатель поднимается. Воду из стакана выливают в ведёрко — указатель возвращается к метке">
			<defs>
				<clipPath id={`${uid}-bk`}>
					<rect x="2.5" y="0" width="39" height="58"></rect>
				</clipPath>
			</defs>
			<line class="ap-line" x1="0" y1="322" x2="360" y2="322"></line>
			<!-- the stand -->
			<rect class="ap-stand" x="22" y="314" width="72" height="8" rx="2"></rect>
			<rect class="ap-stand" x="40" y="10" width="6" height="304"></rect>
			<rect class="ap-stand" x="40" y="10" width="160" height="6" rx="2"></rect>
			<!-- the ruler and the mark -->
			<rect class="bp-ruler" x="138" y="62" width="12" height="60" rx="1"></rect>
			{RULER.map((y, k) => <line class="bp-tick" x1={k % 5 ? 144 : 141} x2="150" y1={y} y2={y} />)}
			<path class="bp-mark" d={`M 130 ${Y0 - 4} L 137 ${Y0} L 130 ${Y0 + 4} Z`}></path>
			<text x="56" y="48">пружина</text>
			<path class="ap-lead" d="M 114 44 L 180 44"></path>
			<text x="56" y="124">метка</text>
			<path class="ap-lead" d={`M 96 119 L 129 ${Y0 + 2}`}></path>
			<!-- the spring, the pointer, the bucket and the body -->
			<path class="bp-spring" d="" data-spring></path>
			<g data-hang>
				<line class="bp-needle" x1="140" x2="190" y1="0" y2="0"></line>
				<circle class="bp-needle-tip" cx="140" cy="0" r="2"></circle>
				<line class="bp-rod" x1="190" x2="190" y1="0" y2="8"></line>
				<path class="bp-bail" d="M 171 12 Q 190 -2 209 12"></path>
				<path class="bp-bucket" d="M 171 10 V 46 H 209 V 10"></path>
				<rect class="bp-bwater" x="173" y="44" width="34" height="0" data-bwater></rect>
				<line class="ap-thread" x1="190" x2="190" y1="46" y2="90"></line>
				<rect class="bp-body" x="173" y="90" width="34" height="34" rx="2"></rect>
				<text x="216" y="32" data-lbucket>ведёрко</text>
				<text x="216" y="112" data-lbody>тело</text>
			</g>
			<text x="56" y="0" data-lpointer>указатель</text>
			<path class="ap-lead" d="" data-lpointer-lead></path>
			<!-- the overflow vessel on the lab jack -->
			<g data-vessel>
				<path class="bp-jack" d="M 150 72 L 230 90 M 230 72 L 150 90" data-jack></path>
				<rect class="ap-stand" x="134" y="72" width="112" height="6" rx="1.5"></rect>
				<rect class="ap-water" x="146" y="0" width="88" height="70"></rect>
				<path class="ap-water" d="M 234 0 L 252 9 L 252 13 L 234 4 Z"></path>
				<line class="ap-surface" x1="146" x2="234" y1="0" y2="0"></line>
				<path class="ap-glass" d="M 144 -10 V 71 H 236 V 2 L 254 11"></path>
				<path class="ap-glass" d="M 236 -10 V -2 L 254 7"></path>
				<text x="56" y="32">отливной</text>
				<text x="56" y="48">сосуд</text>
			</g>
			<path class="bp-stream" d="" data-stream1></path>
			<!-- the beaker -->
			<g data-beaker>
				<g clip-path={`url(#${uid}-bk)`}>
					<rect class="bp-bkwater" x="-80" y="58" width="200" height="120" data-bkwater></rect>
				</g>
				<path class="ap-glass" d="M 0 -2 L 1.5 60 H 42.5 L 44 -2"></path>
			</g>
			<text x="296" y="300" data-lbeaker>стакан</text>
			<path class="bp-stream" d="" data-stream2></path>
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>Опыт с ведёрком Архимеда. Тело погружают в сосуд, полный воды: вытесненная вода выливается в стакан, пружина сжимается. Когда эту воду переливают в ведёрко, указатель возвращается к метке: выталкивающая сила равна весу воды, вытесненной телом.</figcaption>
		<button type="button" class="ap-pic__again" data-again>Повторить</button>
	</div>
</figure>

<style>
	.bp-ruler {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-5));
	}
	.bp-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.bp-mark {
		fill: var(--ig-vy);
	}
	.bp-spring {
		fill: none;
		stroke: var(--ap-steel);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.bp-needle {
		stroke: var(--ig-vy);
		stroke-width: 2;
	}
	.bp-needle-tip {
		fill: var(--ig-vy);
	}
	.bp-rod,
	.bp-bail {
		stroke: var(--ap-steel);
		stroke-width: 1.6;
		fill: none;
	}
	.bp-bucket {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 50%, transparent);
		stroke: var(--ap-metal);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.bp-bwater,
	.bp-bkwater {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
	}
	.bp-body {
		fill: var(--ap-body);
		stroke: color-mix(in oklab, var(--ap-body) 60%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.bp-jack {
		stroke: var(--ap-metal);
		stroke-width: 3;
		fill: none;
	}
	.bp-stream {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-white));
		stroke-width: 2.5;
		stroke-linecap: round;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const f1 = (v: number) => v.toFixed(1);
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

	for (const root of document.querySelectorAll<HTMLElement>('[data-bucket]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const Y0 = 92;
		const D = 14; // px the pointer rises when the body is fully under water
		const S0 = 224; // water surface in the vessel at the start and at the end of the lift
		const S1 = 152;
		const TABLE = 322;
		const spring = $<SVGPathElement>('[data-spring]');
		const hang = $<SVGGElement>('[data-hang]');
		const bwater = $<SVGRectElement>('[data-bwater]');
		const vessel = $<SVGGElement>('[data-vessel]');
		const jack = $<SVGPathElement>('[data-jack]');
		const beaker = $<SVGGElement>('[data-beaker]');
		const bkwater = $<SVGRectElement>('[data-bkwater]');
		const s1 = $<SVGPathElement>('[data-stream1]');
		const s2 = $<SVGPathElement>('[data-stream2]');
		const lPointer = $<SVGTextElement>('[data-lpointer]');
		const lPointerLead = $<SVGPathElement>('[data-lpointer-lead]');
		const lBody = $<SVGTextElement>('[data-lbody]');
		const lBeaker = $<SVGTextElement>('[data-lbeaker]');
		// the beaker: its left lip at REST, then right, up, and over the bucket, tilted by 45° and then 80°
		const REST = { x: 248, y: 260 };
		const RIGHT = { x: 300, y: 260 };
		const UP = { x: 300, y: 40 };
		const POUR = { x: 200, y: 64 };
		const lerp2 = (p: { x: number; y: number }, q: { x: number; y: number }, t: number) => ({ x: lerp(p.x, q.x, t), y: lerp(p.y, q.y, t) });
		const beakerAt = (u: number) => {
			// u: 0 at rest → 1 over the bucket (three legs)
			if (u <= 1 / 3) return { ...lerp2(REST, RIGHT, u * 3), a: 0 };
			if (u <= 2 / 3) return { ...lerp2(RIGHT, UP, u * 3 - 1), a: 0 };
			return { ...lerp2(UP, POUR, u * 3 - 2), a: -45 * (u * 3 - 2) };
		};

		scene(root, 11, (x) => {
			const lift = smooth(0.05, 0.3, x);
			const s = lerp(S0, S1, lift); // water surface in the vessel
			const go = smooth(0.4, 0.55, x) - smooth(0.74, 0.86, x); // the beaker travels
			const pour = smooth(0.56, 0.72, x); // share of the water poured into the bucket
			// how deep the body is: bottom at Y0 + 124 − D·f, so f = (Y0 + 124 − s) / (34 + D), clamped
			const f = clamp((Y0 + 124 - s) / (34 + D));
			const yp = Y0 - D * f + D * pour;
			// the spring from the arm (y = 16) to the pointer
			const n = 10;
			let d = 'M 190 16 L 190 20';
			for (let k = 0; k < n; k++) d += ` L ${k % 2 ? 182 : 198} ${f1(20 + ((yp - 24) * (k + 0.5)) / n)}`;
			spring.setAttribute('d', `${d} L 190 ${f1(yp - 2)} L 190 ${f1(yp)}`);
			hang.setAttribute('transform', `translate(0 ${f1(yp)})`);
			const fill = 34 * pour;
			bwater.setAttribute('y', f1(44 - fill));
			bwater.setAttribute('height', f1(fill));
			lPointer.setAttribute('y', f1(yp + 4));
			lPointerLead.setAttribute('d', `M 126 ${f1(yp)} L 137 ${f1(yp)}`);
			lBody.style.opacity = (1 - smooth(0.06, 0.12, x)).toFixed(2);
			// the vessel and the scissors of the jack
			vessel.setAttribute('transform', `translate(0 ${f1(s)})`);
			const legs = TABLE - (s + 78);
			jack.setAttribute('d', `M 150 78 L 230 ${f1(78 + legs)} M 230 78 L 150 ${f1(78 + legs)}`);
			// the beaker: the water pushed out runs into it, then it is poured into the bucket
			const p = beakerAt(go);
			// over the bucket it tilts from 45° (the water reaches the lip) to 80° while the water runs out
			p.a -= 35 * pour * clamp(go * 3 - 2);
			beaker.setAttribute('transform', `translate(${f1(p.x)} ${f1(p.y)}) rotate(${f1(p.a)})`);
			const level = 28.9 * f * (1 - pour);
			// the water surface stays horizontal: a wide rect counter-rotated about the middle of the level
			bkwater.setAttribute('y', f1(58 - level));
			bkwater.setAttribute('transform', `rotate(${f1(-p.a)} 22 ${f1(58 - level)})`);
			bkwater.style.opacity = level > 0.3 ? '1' : '0';
			lBeaker.style.opacity = (1 - smooth(0.4, 0.43, x) + smooth(0.86, 0.9, x)).toFixed(2);
			lPointer.style.opacity = lBeaker.style.opacity;
			lPointerLead.style.opacity = lBeaker.style.opacity;
			// stream 1: from the spout into the beaker while the body goes under water
			const filling = x > 0.05 && x < 0.3 && f > 0 && f < 1;
			s1.setAttribute('d', filling ? `M 252 ${f1(s + 11)} Q 258 ${f1(s + 14)} 262 ${f1(TABLE - 2 - level)}` : '');
			// stream 2: from the lip of the tilted beaker into the bucket
			const pouring = pour > 0.02 && pour < 0.98;
			s2.setAttribute('d', pouring ? `M ${POUR.x} ${POUR.y} Q ${POUR.x - 6} ${POUR.y + 6} ${POUR.x - 8} ${f1(yp + 44 - fill)}` : '');
		});
	}
</script>
