		min-height: 3em;
		margin: 0.75rem 0 0;
		padding: 0.6rem 0.8rem;
		border-radius: 0.6rem;
		background: color-mix(in oklab, var(--sl-color-accent-low) 55%, transparent);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
