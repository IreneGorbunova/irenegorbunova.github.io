		white-space: nowrap;
	}

	@container (max-width: 36rem) {
		.arh__stage {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'pick' 'svg' 'side';
			grid-template-rows: auto;
		}
		.arh__svg {
			max-width: 22rem;
			width: 100%;
			margin-inline: auto;
