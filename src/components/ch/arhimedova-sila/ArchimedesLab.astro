		.arh {
			padding: 0.75rem;
		}
		.arh__chip {
			padding: 0.25rem 0.6rem 0.25rem 0.4rem;
		}
		.arh__grad text,
		.arh__dyn-scale text,
		.arh__dyn-unit,
		.arh__scale .arh__scale-cap {
			font-size: 13px;
		}
		.arh__dv text,
		.arh__scale text {
			font-size: 14px;
		}
		.arh__flabel {
			font-size: 19px;
		}
