---
/**
 * Main model of the chapter: a cube hangs on a spring dynamometer above a glass of liquid
 * standing on a lab jack. Raising the jack immerses the cube; the dynamometer shows the weight
 * of the body in the liquid, the liquid level shows the displaced volume. The thread can be cut:
 * the cube then sinks, floats or stays, with real dynamics (time can be slowed down).
 *
 * Real proportions: 11 px per centimetre for everything in the scene; cube 4 cm (64 cm³),
 * glass 8 × 8 cm inside (64 cm²) and 8 cm high, 320 cm³ of liquid. The dynamometer is chosen to suit the body
 * (0,2 … 20 N), all of them with the same 8-cm scale. The force arrows use one scale per dynamometer
 * (60 px = full range); a force too small for it gets a minimum-length arrow (and F_A its value printed).
 */
import { BODIES, LIQUIDS, fmtInt } from './physics';

const uid = `arh-${Math.random().toString(36).slice(2, 8)}`;
const XC = 222;
---

<figure class="arh not-content" data-arh>
	<div class="arh__stage">
	<div class="arh__pickers">
		<fieldset class="arh__pick">
			<legend>Тело — кубик 4 × 4 × 4 см</legend>
			<div class="arh__chips">
				{
					BODIES.map((b) => (
						<label class="arh__chip">
							<input type="radio" name={`${uid}-body`} value={b.id} checked={b.id === 'al'} data-body />
							<span class={`arh__sw arh__sw--${b.id}`} aria-hidden="true" />
							<span class="arh__chip-name">{b.name}</span>
							<span class="arh__chip-rho">{fmtInt(b.rho)}</span>
						</label>
					))
				}
			</div>
		</fieldset>
		<fieldset class="arh__pick">
			<legend>Жидкость</legend>
			<div class="arh__chips">
				{
					LIQUIDS.map((l) => (
						<label class="arh__chip">
							<input type="radio" name={`${uid}-liq`} value={l.id} checked={l.id === 'water'} data-liq />
							<span class={`arh__sw arh__sw--${l.id}`} aria-hidden="true" />
							<span class="arh__chip-name">{l.name}</span>
							<span class="arh__chip-rho">{fmtInt(l.rho)}</span>
						</label>
					))
				}
			</div>
		</fieldset>
		<p class="arh__units">Числа на кнопках — плотность в кг/м³.</p>
	</div>

		<svg
			class="arh__svg"
			viewBox="92 0 292 540"
			role="group"
			aria-label="Тело на динамометре над сосудом с жидкостью на подъёмном столике"
			data-svg
		>
			<defs>
				{
					['fg', 'fa', 'fs'].map((k) => (
						<marker
							id={`${uid}-${k}`}
							class={`arh__head arh__head--${k}`}
							viewBox="0 0 10 10"
							refX="6"
							refY="5"
							markerWidth="5"
							markerHeight="5"
							orient="auto"
						>
							<path d="M0,0 L10,5 L0,10 z" />
						</marker>
					))
				}
				<linearGradient id={`${uid}-sheen`} x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" stop-color="#fff" stop-opacity="0.45" />
					<stop offset="0.45" stop-color="#fff" stop-opacity="0.05" />
					<stop offset="1" stop-color="#000" stop-opacity="0.22" />
				</linearGradient>
				<linearGradient id={`${uid}-merc`} x1="0" y1="0" x2="1" y2="0">
					<stop offset="0" stop-color="#000" stop-opacity="0.25" />
					<stop offset="0.3" stop-color="#fff" stop-opacity="0.35" />
					<stop offset="0.55" stop-color="#fff" stop-opacity="0" />
					<stop offset="1" stop-color="#000" stop-opacity="0.3" />
				</linearGradient>
				<clipPath id={`${uid}-clip`}>
					<rect x="-22" y="0" width="44" height="44" />
				</clipPath>
			</defs>

			<!-- Table and stand -->
			<line class="arh__table" x1="96" y1="522" x2="380" y2="522" />
			<rect class="arh__metal" x="104" y="510" width="64" height="12" rx="3" />
			<rect class="arh__metal" x="136" y="14" width="8" height="498" rx="2" />
			<rect class="arh__metal" x="136" y="14" width={XC - 128} height="7" rx="2" />
			<rect class="arh__clamp" x="129" y="9" width="22" height="18" rx="3" />
			<circle class="arh__ring" cx={XC} cy="26" r="5" />

			<!-- Scale of the force arrows -->
			<g class="arh__scale" data-scale>
				<text class="arh__scale-cap" x="300" y="34">масштаб сил</text>
				<line x1="300" y1="48" x2="340" y2="48" data-scale-bar />
				<text x="346" y="52" data-scale-text>0,5 Н</text>
			</g>

			<!-- Lab jack -->
			<g class="arh__jack arh__drag" data-jack>
				<rect class="arh__metal" x={XC - 50} y="512" width="100" height="10" rx="3" />
				<g class="arh__bars" data-bars></g>
				<rect class="arh__metal" x={XC - 50} width="100" height="7" rx="3" data-jack-top />
			</g>

			<!-- Glass, back side -->
			<g class="arh__drag" data-tankg>
				<rect class="arh__glass-back" x={XC - 46} width="92" height="114" rx="4" data-glass-back />
			</g>

			<!-- Body -->
			<g class="arh__body" data-body-g>
				<circle class="arh__body-ring" cx="0" cy="-3" r="3" />
				<g clip-path={`url(#${uid}-clip)`}>
					<rect class="arh__body-fill" x="-22" y="0" width="44" height="44" data-body-fill />
					<g class="arh__decor" data-decor></g>
					<rect x="-22" y="0" width="44" height="44" fill={`url(#${uid}-sheen)`} />
				</g>
				<rect class="arh__body-edge" x="-22" y="0" width="44" height="44" rx="1.5" />
			</g>

			<!-- Liquid -->
			<g class="arh__liquid" data-liquid>
				<rect class="arh__liq-body" x={XC - 44} width="88" data-liq-rect />
				<rect class="arh__liq-sheen" x={XC - 44} width="88" fill={`url(#${uid}-merc)`} data-liq-sheen />
				<rect class="arh__liq-band" x={XC - 44} width="88" data-liq-band />
				<line class="arh__liq-surface" x1={XC - 44} x2={XC + 44} data-liq-surface />
				<line class="arh__liq-initial" x1={XC - 44} x2={XC + 44} data-liq-initial />
			</g>
			<rect class="arh__ghost" x="-22" y="0" width="44" height="44" data-ghost />

			<!-- Glass walls and graduations -->
			<g class="arh__drag" data-tank-front>
				<path class="arh__glass" data-glass />
				<g class="arh__grad" data-grad></g>
			</g>

			<!-- Displaced volume bracket -->
			<g class="arh__dv" data-dv>
				<path data-dv-path />
				<text x={XC + 92} data-dv-text></text>
			</g>

			<!-- Dynamometer -->
			<g class="arh__dyn">
				<rect class="arh__dyn-plate" x={XC - 20} y="30" width="40" height="178" rx="8" />
				<g class="arh__dyn-scale" data-dyn-scale></g>
				<text class="arh__dyn-unit" x={XC - 11} y="66" text-anchor="middle">Н</text>
				<rect class="arh__metal" x={XC - 1} y="36" width="14" height="4" rx="1" />
				<path class="arh__spring" data-spring />
				<line class="arh__rod" x1={XC} x2={XC} data-rod />
				<g data-pointer>
					<line class="arh__pointer" x1={XC - 15} y1="0" x2={XC + 13} y2="0" />
					<path class="arh__pointer-tip" d={`M ${XC - 19} 0 l 6 -4 v 8 z`} />
				</g>
				<circle class="arh__hook" cx={XC} r="4" data-hook />
				<g class="arh__bubble" data-bubble>
					<rect x={XC + 25} y="-12" width="66" height="24" rx="12" />
					<text x={XC + 58} y="5" text-anchor="middle" data-bubble-text></text>
				</g>
			</g>

			<path class="arh__thread" data-thread />

			<!-- Forces -->
			<g class="arh__forces" data-forces>
				<line class="arh__f arh__f--fg" marker-end={`url(#${uid}-fg)`} data-f="fg" />
				<line class="arh__f arh__f--fa" marker-end={`url(#${uid}-fa)`} data-f="fa" />
				<line class="arh__f arh__f--fs" marker-end={`url(#${uid}-fs)`} data-f="fs" />
				<text class="arh__flabel arh__flabel--fg" data-fl="fg"><tspan class="arh__fi">F</tspan><tspan class="arh__fsub" dy="4">тяж</tspan></text>
				<text class="arh__flabel arh__flabel--fa" text-anchor="end" data-fl="fa"><tspan class="arh__fi">F</tspan><tspan class="arh__fsub" dy="4">А</tspan><tspan class="arh__fval" dy="-4" data-fv="fa"></tspan></text>
				<text class="arh__flabel arh__flabel--fs" data-fl="fs"><tspan class="arh__fi">F</tspan><tspan class="arh__fsub" dy="4">упр</tspan></text>
			</g>

			<text class="arh__hint" x="300" y="490" data-hint>
				<tspan x="300">↑ поднимите</tspan>
				<tspan x="300" dy="16">сосуд</tspan>
			</text>
		</svg>

		<div class="arh__side">
			<label class="arh__slider">
				<span>Подъёмный столик</span>
				<output data-s-out>внизу</output>
				<input type="range" min="0" max="1000" step="1" value="0" data-s aria-label="Высота подъёмного столика" />
			</label>

			<div class="arh__buttons">
				<button type="button" class="arh__btn arh__btn--primary" data-release>Перерезать нить</button>
				<label class="arh__check"><input type="checkbox" checked data-slow /> замедлить в 4 раза</label>
			</div>

			<dl class="arh__stats">
				<div><dt>Вес тела в воздухе <i>P</i></dt><dd data-o-p>—</dd></div>
				<div><dt data-o-p1-label>Динамометр показывает <i>P</i><sub>1</sub></dt><dd data-o-p1>—</dd></div>
				<div class="arh__stats-key">
					<dt data-o-fa-label>Выталкивающая сила <i>F</i><sub>А</sub> = <i>P</i> − <i>P</i><sub>1</sub></dt>
					<dd data-o-fa>—</dd>
				</div>
				<div><dt>Объём погружённой части <i>V</i><sub>погр</sub></dt><dd data-o-v>—</dd></div>
			</dl>
			<div class="arh__formula" data-formula aria-hidden="true"></div>
		</div>
	</div>

	<p class="arh__live" data-live aria-live="polite"></p>

	<figcaption class="arh__legend">
		<span class="arh__key arh__key--fg"></span>сила тяжести
		<span class="arh__key arh__key--fa"></span>выталкивающая (архимедова) сила
		<span class="arh__key arh__key--fs"></span>сила упругости нити или дна.
		Сосуд можно поднимать мышкой или пальцем, а после того как нить перерезана, — двигать и само тело.{' '}
		<span class="arh__nowrap"><i>g</i> = 9,8 Н/кг</span>, 1 мл = 1 см³. Ртуть ядовита: опыты с ней — только в модели.
	</figcaption>
</figure>

<style is:global>
	.arh {
		--arh-cork: hsl(30 45% 58%);
		--arh-pine: hsl(37 62% 62%);
		--arh-ice: hsl(193 80% 88%);
		--arh-plexi: hsl(190 40% 80%);
		--arh-al: hsl(214 14% 78%);
		--arh-iron: hsl(214 9% 50%);
		--arh-lead: hsl(224 10% 40%);
		--arh-gold: hsl(45 90% 55%);
		--arh-kerosene: hsl(54 55% 72%);
		--arh-oil: hsl(44 95% 55%);
		--arh-water: var(--ig-vx);
		--arh-brine: hsl(170 65% 50%);
		--arh-mercury: hsl(222 8% 72%);
		--arh-fg: var(--ig-vy);
		--arh-fa: var(--ig-vx);
		--arh-fs: var(--ig-v);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .arh {
		--arh-ice: hsl(193 70% 80%);
		--arh-plexi: hsl(190 35% 72%);
		--arh-kerosene: hsl(50 60% 58%);
		--arh-oil: hsl(42 95% 48%);
		--arh-brine: hsl(170 70% 36%);
		--arh-mercury: hsl(222 6% 60%);
	}
	.arh i {
		font-family: var(--ig-font-math);
	}
	.arh__pickers {
		display: grid;
		gap: 0.6rem;
	}
	.arh__pick {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	.arh__pick legend {
		padding: 0;
		margin-bottom: 0.35rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.arh__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.arh__chip {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem 0.3rem 0.45rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			border-color 0.2s,
			background-color 0.2s,
			color 0.2s;
		user-select: none;
	}
	.arh__chip:hover {
		border-color: var(--sl-color-accent);
	}
	.arh__chip input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.arh__chip:has(input:checked) {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.arh__chip:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.arh__chip-rho {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
	}
	.arh__sw {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 0.25rem;
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.25);
	}
	.arh__sw--cork { background: var(--arh-cork); }
	.arh__sw--pine { background: var(--arh-pine); }
	.arh__sw--ice { background: var(--arh-ice); }
	.arh__sw--plexi { background: color-mix(in oklab, var(--arh-plexi) 55%, transparent); }
	.arh__sw--al { background: var(--arh-al); }
	.arh__sw--iron { background: var(--arh-iron); }
	.arh__sw--lead { background: var(--arh-lead); }
	.arh__sw--gold { background: var(--arh-gold); }
	.arh__sw--kerosene,
	.arh__sw--oil,
	.arh__sw--water,
	.arh__sw--brine,
	.arh__sw--mercury {
		border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
	}
	.arh__sw--kerosene { background: var(--arh-kerosene); }
	.arh__sw--oil { background: var(--arh-oil); }
	.arh__sw--water { background: var(--arh-water); }
	.arh__sw--brine { background: var(--arh-brine); }
	.arh__sw--mercury { background: var(--arh-mercury); }
	.arh__units {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.arh {
		container-type: inline-size;
	}
	.arh__stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-template-areas: 'svg pick' 'svg side';
		grid-template-rows: auto 1fr;
		gap: 0.9rem 1.25rem;
		align-items: start;
	}
	.arh__pickers {
		grid-area: pick;
	}
	.arh__svg {
		grid-area: svg;
	}
	.arh__side {
		grid-area: side;
	}
	.arh__svg {
		display: block;
		width: 100%;
		height: auto;
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.arh__drag {
		cursor: ns-resize;
	}
	.arh.is-free .arh__body {
		cursor: grab;
	}
	.arh.is-grabbing,
	.arh.is-grabbing * {
		cursor: grabbing !important;
	}
	.arh__table {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.arh__metal {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.arh__clamp {
		fill: var(--sl-color-gray-4);
	}
	.arh__ring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.arh__bars line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.arh__bars circle {
		fill: var(--sl-color-gray-3);
	}
	.arh__bars .arh__screw {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.arh__glass-back {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 22%, transparent);
	}
	.arh__glass {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-2) 70%, transparent);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.arh__grad line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.arh__grad text {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		font-family: var(--__sl-font);
		font-variant-numeric: tabular-nums;
	}
	.arh__body-ring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.arh__body {
		--body: var(--arh-al);
	}
	.arh__body-fill {
		fill: var(--body);
		transition: fill 0.35s;
	}
	.arh__body-edge {
		fill: none;
		stroke: color-mix(in oklab, var(--body) 55%, var(--sl-color-black));
		stroke-width: 1.5;
		transition: stroke 0.35s;
	}
	.arh__body[data-mat='ice'] .arh__body-fill,
	.arh__body[data-mat='plexi'] .arh__body-fill {
		fill-opacity: 0.55;
	}
	.arh__decor * {
		fill: none;
		stroke: color-mix(in oklab, var(--body) 60%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.arh__decor .arh__dot {
		fill: color-mix(in oklab, var(--body) 55%, var(--sl-color-black));
		stroke: none;
	}
	.arh__decor .arh__shine {
		stroke: #fff;
		stroke-opacity: 0.8;
		stroke-width: 2;
		stroke-linecap: round;
	}
	.arh__liquid {
		--liq: var(--arh-water);
		pointer-events: none;
	}
	.arh__liq-body {
		fill: var(--liq);
		fill-opacity: 0.26;
		transition:
			fill 0.4s,
			fill-opacity 0.4s;
	}
	.arh__liq-band {
		fill: var(--liq);
		fill-opacity: 0.22;
		transition: fill 0.4s;
	}
	.arh__liq-sheen {
		opacity: 0;
		transition: opacity 0.4s;
	}
	.arh__liq-surface {
		stroke: var(--liq);
		stroke-width: 2.5;
		transition: stroke 0.4s;
	}
	.arh__liq-initial {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.arh__liquid[data-liq='mercury'] .arh__liq-body {
		fill-opacity: 0.94;
	}
	.arh__liquid[data-liq='mercury'] .arh__liq-band {
		fill-opacity: 0;
	}
	.arh__liquid[data-liq='mercury'] .arh__liq-sheen {
		opacity: 1;
	}
	.arh__liquid[data-liq='oil'] .arh__liq-body {
		fill-opacity: 0.32;
	}
	.arh__ghost {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 1.5;
		stroke-dasharray: 4 3;
		pointer-events: none;
	}
	.arh__dv path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.arh__dv text {
		fill: var(--sl-color-gray-2);
		font-size: 12px;
		font-family: var(--__sl-font);
		font-variant-numeric: tabular-nums;
	}
	.arh__dyn-plate {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.arh__dyn-scale line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.arh__dyn-scale text,
	.arh__dyn-unit {
		fill: var(--sl-color-gray-2);
		font-size: 11px;
		font-family: var(--__sl-font);
		font-variant-numeric: tabular-nums;
	}
	.arh__spring {
