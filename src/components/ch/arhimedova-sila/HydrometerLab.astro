---
/**
 * «Ареометр»: one hydrometer floats in a tall cylinder; the buttons change the liquid (kerosene 800, sunflower oil
 * 930, water 1000, brine 1200 кг/м³, the chapter's table, physics.ts). The density is read off the scale at the
 * surface; a magnifier shows the stem there 6 times larger.
 *
 * The hydrometer (real size): mass 24 г; a bulb of 20,0 см³ (a lead-shot end 1,2 см across and 2 см long, a body
 * 2,2 см across and 4,5 см long, a short taper); a stem 0,8 см across (0,5 см²), its scale 20 см long. Floating,
 * it displaces V = m/ρ: 24 см³ of water, 30 of kerosene, 25,8 of oil, 20 of brine. So the mark of density ρ stands
 * (24 / ρ[г/см³] − 20) / 0,5 см above the bottom of the stem: 1200 → 0, 1100 → 3,6, 1000 → 8,0, 930 → 11,6,
 * 900 → 13,3, 800 → 20,0 см. The marks are every 20 кг/м³, closer together at the bottom (the larger densities):
 * a real hydrometer's scale is uneven too. Gravity on it, 0,024 · 9,8 = 0,24 Н, equals the Archimedes force.
 * The cylinder is 5 см across, 40 см high, with 560 см³ of liquid: the level stands at 28,5 см plus the displaced
 * volume / 19,6 см² (29,5…30,0 см).
 * When the liquid changes, the hydrometer is moved (0,9 с) to 1,5 см below its new depth, as a hand would put it in,
 * and let go: it bobs to rest under gravity, ρgV_погр, the added mass of the liquid (half the submerged volume) and
 * damping (ζ = 0,15); the period, about 1,4 с, is real (the stiffness ρgS of the stem: 0,49 Н/м in water).
 * The drawing: 6 px per см, the magnifier 36 px per см; at about 38 px per real centimeter of a screen (96 px per
 * inch) the hydrometer is about 6 times smaller than life and the magnified scale is about life size. The readouts
 * show «—» while the hydrometer moves and the settled values once it rests.
 */
import G7Styles from '../g7/G7Styles.astro';
import { LIQUIDS, fmtInt } from './physics';

const uid = Math.random().toString(36).slice(2, 8);
const LIQ = LIQUIDS.filter((l) => l.id !== 'mercury');
---

<G7Styles />
<figure class="g7 hyd not-content" data-hyd>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 330" role="img" aria-label="Ареометр плавает в высоком цилиндре с жидкостью. Лупа показывает шкалу ареометра у поверхности жидкости" data-svg>
			<defs>
				<clipPath id={`hyd-lens-${uid}`}>
					<circle cx="232" cy="160" r="86"></circle>
				</clipPath>
				<clipPath id={`hyd-cyl-${uid}`}>
					<rect x="55" y="0" width="30" height="318"></rect>
				</clipPath>
			</defs>
			<!-- the cylinder with the liquid -->
			<rect class="hyd__liq" x="55" width="30" data-liq></rect>
			<line class="hyd__surf" x1="55" x2="85" data-surf></line>
			<g data-meter></g>
			<path class="hyd__glass" d="M 53 78 V 318 H 87 V 78"></path>
			<rect class="hyd__foot" x="40" y="318" width="60" height="6" rx="2"></rect>
			<!-- the zoomed window and the magnifier -->
			<rect class="hyd__win" x="60" width="20" height="26" data-win></rect>
			<path class="hyd__ray" d="" data-rays></path>
			<circle class="hyd__lens-bg" cx="232" cy="160" r="86"></circle>
			<g clip-path={`url(#hyd-lens-${uid})`}>
				<rect class="hyd__liq" x="140" y="160" width="190" height="90" data-zliq></rect>
				<g data-zoom></g>
				<line class="hyd__surf" x1="140" x2="330" y1="160" y2="160"></line>
			</g>
			<circle class="hyd__lens" cx="232" cy="160" r="86"></circle>
			<text class="t-small" x="232" y="266" text-anchor="middle">шкала у поверхности, кг/м³</text>
			<text class="t-small" x="232" y="282" text-anchor="middle">(в 6 раз крупнее)</text>
		</svg>
		<div class="g7__side">
			<div class="g7__row hyd__btns" role="group" aria-label="Жидкость">
				{
					LIQ.map((l) => (
						<button type="button" class="g7__btn" data-liq-btn={l.id} aria-pressed={l.id === 'water' ? 'true' : 'false'}>
							{l.name} <span class="hyd__rho">{fmtInt(l.rho)}</span>
						</button>
					))
				}
			</div>
			<p class="g7__note">Числа на кнопках — плотность по таблице, кг/м³.</p>
			<ul class="g7__read" aria-live="polite">
				<li class="is-key"><span>Ареометр показывает</span><b data-o-read></b></li>
				<li><span>Объём погружённой части</span><b data-o-v></b></li>
				<li><span>Архимедова сила = сила тяжести</span><b>0,24&nbsp;Н</b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Ареометр погружается, пока архимедова сила не станет равна силе тяжести. Чем плотнее жидкость, тем меньше ему нужно её вытеснить и тем выше он плавает; ареометр уменьшен примерно в 6&nbsp;раз, в лупе шкала примерно в натуральную величину, колебания — в настоящем времени.
	</figcaption>
</figure>

<style is:global>
	.hyd {
		--hyd-liq: var(--ig-vx);
	}
	.hyd__liq {
		fill: var(--hyd-liq);
		fill-opacity: 0.3;
		transition: fill 0.5s;
	}
	.hyd__surf {
		stroke: var(--hyd-liq);
		stroke-width: 2;
		transition: stroke 0.5s;
	}
	.hyd__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.hyd__foot {
		fill: var(--g7-glass);
	}
	.hyd__meter-glass {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 35%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.hyd__paper {
		fill: color-mix(in oklab, var(--ig-v) 12%, var(--sl-color-gray-6));
	}
	.hyd__shot {
		fill: var(--sl-color-gray-3);
	}
	.hyd__tick {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.hyd__ztick {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.hyd svg .hyd__znum {
		font-size: 11px;
		fill: var(--sl-color-gray-1);
		font-variant-numeric: tabular-nums;
	}
	.hyd__win {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 1;
	}
	.hyd__ray {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
	}
	.hyd__lens-bg {
		fill: var(--g7-paper);
	}
	.hyd__lens {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 2;
	}
	.hyd__btns .g7__btn {
		flex: 1 1 auto;
	}
	.hyd__rho {
		font-weight: 400;
		font-size: var(--sl-text-xs);
		opacity: 0.8;
	}
	.hyd[data-liq='kerosene'] {
		--hyd-liq: var(--ig-v);
	}
	.hyd[data-liq='oil'] {
		--hyd-liq: hsl(44, 95%, 55%);
	}
	.hyd[data-liq='brine'] {
		--hyd-liq: hsl(170, 65%, 50%);
	}
	:root[data-theme='light'] .hyd[data-liq='brine'] {
		--hyd-liq: hsl(170, 70%, 36%);
	}
	:root[data-theme='light'] .hyd[data-liq='oil'] {
		--hyd-liq: hsl(42, 95%, 48%);
	}
</style>

<script>
	import { el, fmt, loop } from '../g7/kit';
	import { LIQUIDS, fmtInt } from './physics';

	const G = 9.8;
	const M = 0.024; // kg
	const S = 6; // px per cm
	const Z = 36; // px per cm in the magnifier
	const BOTTOM = 318; // y of the cylinder bottom
	const STEM0 = 7; // cm: the stem starts 7 cm above the bottom of the hydrometer
	const STEM_LEN = 22; // cm
	const A_STEM = 0.5; // cm²
	const CYL = 19.63; // cm², 5 cm across
	const LIQ_VOL = 560; // cm³
	const LX = 232;
	const LY = 160;
	const LR = 86;
	const CX = 70; // the cylinder axis

	/** Submerged volume (cm³) of the hydrometer immersed to depth d (cm) from its bottom. */
	const vsub = (d: number) => {
		const shot = Math.PI * 0.6 * 0.6; // 0–2 cm
		const body = Math.PI * 1.1 * 1.1; // 2–6,5 cm
		let v = 0;
		v += shot * Math.min(Math.max(d, 0), 2);
		v += body * Math.min(Math.max(d - 2, 0), 4.5);
		// the taper 6,5–7 cm, 0,64 см³ in all (the bulb is 20,0 см³)
		v += 0.64 * Math.min(Math.max(d - 6.5, 0), 0.5) / 0.5;
		v += A_STEM * Math.max(d - STEM0, 0);
		return v;
	};
	// the bulb's volume in this outline, scaled to 20,0 см³ exactly
	const BULB = vsub(STEM0);
	const vol = (d: number) => vsub(d) * (d <= STEM0 ? 20 / BULB : 1) + (d > STEM0 ? 20 - BULB : 0);
	/** Height of the mark of density rho (kg/m³) above the bottom of the stem, cm. */
	const mark = (rho: number) => (M * 1e6) / rho / A_STEM - 20 / A_STEM;

	for (const root of document.querySelectorAll<HTMLElement>('[data-hyd]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const meter = q<SVGGElement>('[data-meter]');
		const zoom = q<SVGGElement>('[data-zoom]');
		const liqR = q<SVGRectElement>('[data-liq]');
		const surf = q<SVGLineElement>('[data-surf]');
		const win = q<SVGRectElement>('[data-win]');
		const rays = q<SVGPathElement>('[data-rays]');
		const oRead = q<HTMLElement>('[data-o-read]');
		const oV = q<HTMLElement>('[data-o-v]');

		// the hydrometer, drawn with its bottom at (0, 0), up is −y, 6 px per cm
		const mk = (parent: Element, tag: keyof SVGElementTagNameMap, a: Record<string, string | number>, text?: string) => {
			const e = el(tag, a, text);
			parent.append(e);
			return e;
		};
		const body = `M -3.6 0 Q -3.6 ${-2 * S} -3.6 ${-2 * S} L ${-1.1 * S} ${-2.3 * S} L ${-1.1 * S} ${-6.3 * S} Q ${-1.1 * S} ${-6.8 * S} ${-0.4 * S} ${-7 * S} L ${-0.4 * S} ${-(STEM0 + STEM_LEN) * S + 2} Q 0 ${-(STEM0 + STEM_LEN) * S - 1} ${0.4 * S} ${-(STEM0 + STEM_LEN) * S + 2} L ${0.4 * S} ${-7 * S} Q ${1.1 * S} ${-6.8 * S} ${1.1 * S} ${-6.3 * S} L ${1.1 * S} ${-2.3 * S} L 3.6 ${-2 * S} Q 3.6 0 0 1.5 Q -3.6 0 -3.6 0 Z`;
		mk(meter, 'path', { class: 'hyd__meter-glass', d: body });
		mk(meter, 'rect', { class: 'hyd__paper', x: -1.6, y: -(STEM0 + 20.6) * S, width: 3.2, height: 21.2 * S });
		for (let k = 0; k < 6; k++) mk(meter, 'circle', { class: 'hyd__shot', cx: ((k % 3) - 1) * 1.3, cy: -2 - Math.floor(k / 3) * 2.4, r: 1.2 });
		for (let rho = 800; rho <= 1200; rho += 20) {
			const y = -(STEM0 + mark(rho)) * S;
			mk(meter, 'line', { class: 'hyd__tick', x1: -1.6, x2: rho % 100 ? 0 : 1.6, y1: y, y2: y });
		}
		// the magnified stem: drawn in cm units around the stem bottom, moved by the script
		const zstem = mk(zoom, 'g', {});
		mk(zstem, 'rect', { class: 'hyd__meter-glass', x: -0.4 * Z, y: -STEM_LEN * Z, width: 0.8 * Z, height: STEM_LEN * Z });
		mk(zstem, 'rect', { class: 'hyd__paper', x: -0.34 * Z, y: -20.6 * Z, width: 0.68 * Z, height: 21.2 * Z });
		for (let rho = 800; rho <= 1200; rho += 10) {
			const y = -mark(rho) * Z;
			const major = rho % 20 === 0;
			mk(zstem, 'line', { class: 'hyd__ztick', x1: -0.34 * Z, x2: -0.34 * Z + (major ? 10 : 5), y1: y, y2: y });
			if (major) mk(zstem, 'text', { class: 'hyd__znum', x: 0.4 * Z + 5, y: y + 4 }, fmtInt(rho));
		}
		mk(zstem, 'path', { class: 'hyd__meter-glass', d: `M ${-0.4 * Z} 0 Q ${-1.1 * Z} ${0.2 * Z} ${-1.1 * Z} ${0.7 * Z} V ${4 * Z} H ${1.1 * Z} V ${0.7 * Z} Q ${1.1 * Z} ${0.2 * Z} ${0.4 * Z} 0 Z` });

		let liq = LIQUIDS.find((l) => l.id === 'water')!;
		const eqDepth = (rho: number) => {
			const v = (M * 1e6) / rho;
			let lo = 0;
			let hi = STEM0 + STEM_LEN;
			for (let k = 0; k < 50; k++) {
				const mid = (lo + hi) / 2;
				if (vol(mid) < v) lo = mid;
				else hi = mid;
			}
			return lo;
		};
		let d = eqDepth(liq.rho); // cm, depth of the bottom under the surface
		let v = 0; // cm/s, down
		// moving to another cylinder: the hand lowers it to 1,5 см below its new depth and lets go
		let move: { from: number; to: number; t: number } | null = null;
		const MOVE = 0.9; // s

		const draw = () => {
			const vs = vol(d);
			const level = (LIQ_VOL + vs) / CYL; // cm
			const ys = BOTTOM - level * S;
			liqR.setAttribute('y', ys.toFixed(1));
			liqR.setAttribute('height', (BOTTOM - ys).toFixed(1));
			surf.setAttribute('y1', ys.toFixed(1));
			surf.setAttribute('y2', ys.toFixed(1));
			meter.setAttribute('transform', `translate(${CX} ${(ys + d * S).toFixed(1)})`);
			// the magnifier: the point of the stem at the surface goes to the lens center
			const h = d - STEM0; // cm of the stem under the surface
			zstem.setAttribute('transform', `translate(${LX} ${(LY + h * Z).toFixed(1)})`);
			const half = (LR / Z) * S;
			win.setAttribute('x', String(CX - 9));
			win.setAttribute('width', '18');
			win.setAttribute('y', (ys - half).toFixed(1));
			win.setAttribute('height', (2 * half).toFixed(1));
			rays.setAttribute('d', `M ${CX + 9} ${(ys - half).toFixed(1)} L ${LX - 10} ${LY - LR + 2} M ${CX + 9} ${(ys + half).toFixed(1)} L ${LX - 10} ${LY + LR - 2}`);
			// the reading: the density whose mark is at the surface, to 10 кг/м³
			const read = (M * 1e6) / vs;
			const still = !move && Math.abs(v) < 0.02 && Math.abs(d - eqDepth(liq.rho)) < 0.01;
			oRead.textContent = still ? `${fmtInt(Math.round(read / 10) * 10)} кг/м³` : '—';
			oV.textContent = still ? `${fmt(vs, 1)} см³` : '—';
		};

		const wake = loop(root, (dt) => {
			// bobbing: m·a = ρgV − mg − damping, with the added mass of half the submerged volume
			let left = dt;
			if (move) {
				move.t += dt;
				const u = Math.min(1, move.t / MOVE);
				d = move.from + (move.to - move.from) * (0.5 - 0.5 * Math.cos(Math.PI * u));
				v = 0;
				left = 0;
				if (u >= 1) move = null;
			}
			while (left > 1e-9) {
				const h = Math.min(0.004, left);
				left -= h;
				const vs = vol(d) * 1e-6; // m³
				const mAdd = 0.5 * liq.rho * vs;
				const k = liq.rho * G * A_STEM * 1e-4;
				const c = 2 * 0.15 * Math.sqrt(k * (M + mAdd));
				const F = M * G - liq.rho * G * vs - c * v * 0.01; // N, down; v in cm/s
				v += ((F / (M + mAdd)) * 100) * h;
				d += v * h;
			}
			draw();
			const done = !move && Math.abs(v) < 0.02 && Math.abs(d - eqDepth(liq.rho)) < 0.01;
			if (done) {
				d = eqDepth(liq.rho);
				v = 0;
				draw();
			}
			return !done;
		});

		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-liq-btn]')) {
			b.addEventListener('click', () => {
				liq = LIQUIDS.find((l) => l.id === b.dataset.liqBtn)!;
				root.dataset.liq = liq.id;
				root.querySelectorAll('[data-liq-btn]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				move = { from: d, to: eqDepth(liq.rho) + 1.5, t: 0 };
				wake();
			});
		}
		root.dataset.liq = liq.id;
		draw();
	}
</script>
