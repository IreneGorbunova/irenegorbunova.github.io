---
/**
 * Picture to the definition of the buoyant force: the same stone on a spring dynamometer in the air (5 N) and in
 * water (3 N). A stone of density 2500 kg/m³ weighing 5 N has a volume of 0,204 l, so the water pushes it up with
 * 1000 · 9,8 · 0,000204 = 2,0 N. The spring is shorter in water by the same 2 N (14 px per newton on the scale), so
 * the stone hangs higher.
 */
import ArhPicStyles from './ArhPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const ZERO = 34; // y of the zero mark
const K = 14; // px per newton
const TICKS = [0, 1, 2, 3, 4, 5];
const STONE = 'M -20 6 Q -22 -10 -8 -16 Q 6 -21 17 -12 Q 25 -3 21 12 Q 16 24 0 23 Q -18 22 -20 6 Z';

/** One panel: the dynamometer reads `f` newtons. */
const panel = (f: number) => {
	const yp = ZERO + K * f; // the pointer
	const hook = yp + 60;
	const stone = hook + 34; // centre of the stone
	const coils = Array.from({ length: 9 }, (_, k) => {
		const y = 22 + ((yp - 24) * (k + 0.5)) / 9;
		return `L ${k % 2 ? 152 : 168} ${y.toFixed(1)}`;
	}).join(' ');
	return { yp, hook, stone, spring: `M 160 18 L 160 22 ${coils} L 160 ${yp - 2}` };
};
const air = panel(5);
const water = panel(3);
const SURF = 140;
---

<ArhPicStyles />
<figure class="ap-pic not-content">
	<div class="ap-pic__grid">
		{
			[
				{ p: air, title: 'В воздухе', read: '5 Н', inWater: false },
				{ p: water, title: 'В воде', read: '3 Н', inWater: true },
			].map(({ p, title, read, inWater }) => (
				<svg class="ap-pic__svg" viewBox="0 0 320 250" role="img" aria-label={inWater ? 'Камень на динамометре опущен в воду. Динамометр показывает 3 ньютона: вода выталкивает камень вверх' : 'Камень висит на динамометре в воздухе. Динамометр показывает 5 ньютонов'}>
					{inWater && (
						<defs>
							<marker id={`${uid}-fa`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto">
								<path class="ap-head--fa" d="M0,0 L10,5 L0,10 z" />
							</marker>
						</defs>
					)}
					<text class="ap-title" x="20" y="26">{title}</text>
					<rect class="ap-stand" x="110" y="8" width="100" height="8" rx="2" />
					{inWater && (
<text x="232" y="200">вода</text>
					)}
					<!-- the dynamometer -->
					<rect class="wp-body" x="140" y="16" width="40" height="110" rx="4" />
					{TICKS.map((n) => (
						<g>
							<line class="wp-tick" x1="170" x2="178" y1={ZERO + K * n} y2={ZERO + K * n} />
							<text class="wp-num" x="190" y={ZERO + K * n + 4}>{n}</text>
						</g>
					))}
					{[0.5, 1.5, 2.5, 3.5, 4.5].map((n) => <line class="wp-tick" x1="174" x2="178" y1={ZERO + K * n} y2={ZERO + K * n} />)}
					<text class="wp-num" x="190" y={ZERO + K * 5 + 20}>Н</text>
					<path class="wp-spring" d={p.spring} />
					<line class="wp-rod" x1="160" x2="160" y1={p.yp} y2={p.hook - 4} />
					<path class="wp-pointer" d={`M 146 ${p.yp} L 176 ${p.yp} L 180 ${p.yp - 3} V ${p.yp + 3} Z`} />
					<path class="wp-hook" d={`M 160 ${p.hook - 4} V ${p.hook + 2} q 0 5 -5 5 q -4 0 -4 -4`} />
					<line class="ap-thread" x1="155" x2="160" y1={p.hook + 7} y2={p.stone - 16} />
					<path class="wp-stone" d={STONE} transform={`translate(160 ${p.stone})`} />
					{inWater && <rect class="ap-water" x="98" y={SURF} width="124" height={238 - SURF} />}
					{inWater && <line class="ap-surface" x1="98" x2="222" y1={SURF} y2={SURF} />}
					{inWater && (
						<g>
							<line class="ap-arrow ap-arrow--fa" x1="160" x2="160" y1={p.stone} y2={p.stone - 2 * K - 8} marker-end={`url(#${uid}-fa)`} />
							<text class="ap-tfa" x="214" y="66">выталкивающая</text>
							<text class="ap-tfa" x="214" y="82">сила</text>
							<path class="ap-lead" d={`M 228 88 Q 206 120 166 ${p.stone - 20}`} />
						</g>
					)}
					{inWater && <path class="ap-glass" d={`M 96 ${SURF - 22} V 238 H 224 V ${SURF - 22}`} />}
					<text class="wp-read" x="20" y={p.yp + 5}>показывает {read}</text>
					<path class="ap-lead" d={`M 124 ${p.yp} H 142`} />
				</svg>
			))
		}
	</div>
	<div class="ap-pic__foot">
		<figcaption>Камень на динамометре в воздухе и в воде. В воде пружина растянута меньше: вода выталкивает камень вверх с силой 5&nbsp;Н&nbsp;−&nbsp;3&nbsp;Н&nbsp;=&nbsp;2&nbsp;Н.</figcaption>
	</div>
</figure>

<style>
	.wp-body {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.wp-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.ap-pic .wp-num {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
		stroke-width: 0;
	}
	.wp-spring {
		fill: none;
		stroke: var(--ap-steel);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.wp-rod,
	.wp-hook {
		stroke: var(--ap-steel);
		stroke-width: 2;
		fill: none;
	}
	.wp-pointer {
		fill: var(--ig-vy);
	}
	.wp-stone {
		fill: var(--ap-stone);
		stroke: color-mix(in oklab, var(--ap-stone) 60%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.ap-pic .wp-read {
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
</style>
