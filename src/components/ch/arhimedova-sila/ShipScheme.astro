---
/**
 * Labelled scheme to the draught and the waterline: the same cargo ship without cargo and loaded to the waterline.
 * The hull is nearly box-shaped, so the draught grows in proportion to the weight of the ship with its cargo:
 * 16 px empty, 36 px loaded (the red line on the hull).
 */
import ArhPicStyles from './ArhPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const SURF = 126;
const MARK = 20; // the waterline, px below the deck
const KEEL = 56; // px below the deck
const HULL = 'M 0 0 L 240 -4 L 236 30 Q 228 56 206 56 L 18 56 Q 4 56 2 40 Z';
const panels = [
	{ title: 'Без груза', draft: 16, boxes: false },
	{ title: 'С грузом', draft: KEEL - MARK, boxes: true },
];
const BOXES = [
	{ x: 92, c: 'a' },
	{ x: 126, c: 'b' },
	{ x: 160, c: 'c' },
	{ x: 194, c: 'a' },
	{ x: 109, c: 'c', top: true },
	{ x: 143, c: 'a', top: true },
	{ x: 177, c: 'b', top: true },
];
---

<ArhPicStyles />
<figure class="ap-pic not-content">
	<div class="ap-pic__grid">
		{
			panels.map((p, k) => {
				const deck = SURF + p.draft - KEEL;
				return (
					<svg class="ap-pic__svg" viewBox="0 0 330 200" role="img" aria-label={p.boxes ? 'Судно с грузом погрузилось до ватерлинии — красной линии на корпусе. Осадка — глубина от поверхности воды до днища' : 'Судно без груза: вода намного ниже ватерлинии, осадка небольшая'}>
						{k === 0 && (
							<defs>
								<marker id={`${uid}-d`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
									<path d="M0,1 L9,5 L0,9" class="ss-dimhead" />
								</marker>
							</defs>
						)}
						<text class="ap-title" x="14" y="26">{p.title}</text>
						<g transform={`translate(50 ${deck})`}>
							{p.boxes &&
								BOXES.map((b) => (
									<rect class={`ss-box ss-box--${b.c}`} x={b.x} y={b.top ? -36 : -18} width="33" height="17" rx="1" />
								))}
							<rect class="ss-funnel" x="22" y="-48" width="11" height="18" rx="1.5" />
							<rect class="ss-house" x="10" y="-32" width="46" height="32" rx="2" />
							{[16, 28, 40].map((x) => <rect class="ss-window" x={x} y="-26" width="8" height="5" rx="1" />)}
							<path class="ss-hull" d={HULL} />
							<line class="ss-mark" x1="1.5" x2="237.5" y1={MARK} y2={MARK} />
						</g>
						<rect class="ap-water" x="0" y={SURF} width="330" height={200 - SURF} />
						<line class="ap-surface" x1="0" x2="330" y1={SURF} y2={SURF} />
						<!-- draught -->
						<line class="ss-ext" x1="276" x2="312" y1={SURF + p.draft} y2={SURF + p.draft} />
						<line class="ap-dim" x1="304" x2="304" y1={SURF + 1} y2={SURF + p.draft - 1} marker-start={`url(#${uid}-d)`} marker-end={`url(#${uid}-d)`} />
						<text x="300" y={SURF + p.draft + 18} text-anchor="middle">осадка</text>
						<!-- the waterline -->
						<text class="ss-tmark" x="200" y={deck - (p.boxes ? 46 : 14)}>ватерлиния</text>
						<path class="ap-lead" d={`M 262 ${deck - (p.boxes ? 42 : 10)} L 276 ${deck + MARK - 1}`} />
					</svg>
				);
			})
		}
	</div>
	<div class="ap-pic__foot">
		<figcaption>Одно и то же судно без груза и с грузом. Чем тяжелее судно с грузом, тем больше его осадка. Нагружать судно можно, пока вода не дойдёт до ватерлинии.</figcaption>
	</div>
</figure>

<style>
	.ss-hull {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-black));
		stroke-width: 1;
	}
	.ss-mark {
		stroke: var(--ig-vy);
		stroke-width: 2.6;
	}
	.ap-pic .ss-tmark {
		fill: var(--ig-vy);
		font-weight: 700;
	}
	.ss-house {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 85%, var(--ig-v));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	:root[data-theme='light'] .ss-house {
		fill: var(--sl-color-gray-7, #fff);
	}
	.ss-window {
		fill: color-mix(in srgb, var(--ig-vx) 60%, var(--sl-color-gray-5));
	}
	.ss-funnel {
		fill: var(--sl-color-gray-4);
	}
	.ss-box {
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 60%, var(--sl-color-black));
		stroke-width: 0.8;
	}
	.ss-box--a {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-gray-4));
	}
	.ss-box--b {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-4));
	}
	.ss-box--c {
		fill: color-mix(in oklab, var(--ig-v) 75%, var(--sl-color-gray-4));
	}
	.ss-ext {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.ss-dimhead {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
</style>
