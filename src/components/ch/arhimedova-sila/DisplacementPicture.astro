---
/**
 * Picture to «водоизмещение»: on the left a loaded cargo ship floats down to its waterline; on the right the ship is
 * taken away in thought and the same place under the surface is filled with water — «a piece of water» of the shape
 * of the ship's underwater part. Its weight is the displacement, and it equals the weight of the ship with its cargo
 * (Stevin's argument from the chapter). Example numbers: 5000 т of ship and cargo displace 5000 м³ of river water
 * (1000 кг/м³), which weigh 5000 т · 9,8 Н/кг = 49 МН. The hull is the one of ShipScheme.astro (240 × 56 px, the
 * waterline 20 px below the deck).
 */
import ArhPicStyles from './ArhPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const SURF = 104;
const MARK = 20;
const HULL = 'M 0 0 L 240 -4 L 236 30 Q 228 56 206 56 L 18 56 Q 4 56 2 40 Z';
const deck = SURF - MARK;
const BOXES = [
	{ x: 92, c: 'a' },
	{ x: 126, c: 'b' },
	{ x: 160, c: 'c' },
	{ x: 194, c: 'a' },
	{ x: 109, c: 'c', top: true },
	{ x: 143, c: 'a', top: true },
	{ x: 177, c: 'b', top: true },
];
---

<ArhPicStyles />
<figure class="ap-pic not-content" data-disp>
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 0 330 190" role="img" aria-label="Судно с грузом плавает, погрузившись до ватерлинии">
			<defs>
				<clipPath id={`dp-under-${uid}`}>
					<rect x="-10" y={MARK} width="260" height="60"></rect>
				</clipPath>
			</defs>
			<text class="ap-title" x="14" y="24">Судно с грузом</text>
			<g transform={`translate(45 ${deck})`}>
				{BOXES.map((b) => <rect class={`dp-box dp-box--${b.c}`} x={b.x} y={b.top ? -36 : -18} width="33" height="17" rx="1" />)}
				<rect class="dp-funnel" x="22" y="-48" width="11" height="18" rx="1.5" />
				<rect class="dp-house" x="10" y="-32" width="46" height="32" rx="2" />
				{[16, 28, 40].map((x) => <rect class="dp-window" x={x} y="-26" width="8" height="5" rx="1" />)}
				<path class="dp-hull" d={HULL} />
				<line class="dp-mark" x1="1.5" x2="237.5" y1={MARK} y2={MARK} />
			</g>
			<rect class="ap-water" x="0" y={SURF} width="330" height={190 - SURF} />
			<line class="ap-surface" x1="0" x2="330" y1={SURF} y2={SURF} />
			<text x="165" y="182" text-anchor="middle">масса 5000&nbsp;т</text>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 330 190" role="img" aria-label="Судно мысленно убрали, а его место под водой заполнили водой. Этот кусок воды весит столько же, сколько судно с грузом">
			<text class="ap-title" x="14" y="24">Вытесненная вода</text>
			<g transform={`translate(45 ${deck})`}>
				<path class="dp-ghost" d={HULL} />
			</g>
			<rect class="ap-water" x="0" y={SURF} width="330" height={190 - SURF} />
			<g transform={`translate(45 ${deck})`}>
				<path class="dp-piece" d={HULL} clip-path={`url(#dp-under-${uid})`} />
			</g>
			<line class="ap-surface" x1="0" x2="330" y1={SURF} y2={SURF} />
			<text x="165" y="182" text-anchor="middle">5000&nbsp;м³ воды, масса 5000&nbsp;т</text>
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>Уберём судно мысленно и заполним его место под водой водой. Этот «кусок воды» весит столько же, сколько судно с грузом: это и есть водоизмещение судна.</figcaption>
	</div>
</figure>

<style>
	.dp-hull {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-black));
		stroke-width: 1;
	}
	.dp-mark {
		stroke: var(--ig-vy);
		stroke-width: 2.6;
	}
	.dp-house {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 85%, var(--ig-v));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	:root[data-theme='light'] .dp-house {
		fill: var(--sl-color-gray-7, #fff);
	}
	.dp-window {
		fill: color-mix(in srgb, var(--ig-vx) 60%, var(--sl-color-gray-5));
	}
	.dp-funnel {
		fill: var(--sl-color-gray-4);
	}
	.dp-box {
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 60%, var(--sl-color-black));
		stroke-width: 0.8;
	}
	.dp-box--a {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-gray-4));
	}
	.dp-box--b {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-4));
	}
	.dp-box--c {
		fill: color-mix(in oklab, var(--ig-v) 75%, var(--sl-color-gray-4));
	}
	.dp-ghost {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.dp-piece {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
		stroke: color-mix(in srgb, var(--ig-vx) 80%, var(--sl-color-white));
		stroke-width: 1.6;
		stroke-dasharray: 5 3;
	}
</style>
