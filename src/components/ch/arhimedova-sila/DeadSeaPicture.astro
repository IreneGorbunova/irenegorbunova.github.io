---
/**
 * Picture to «В Мёртвом море»: the same person (170 см, the site's reference person in swimwear, swimmer.ts) lying on
 * fresh water and on the water of the Dead Sea.
 * The body with air in the lungs: about 990 кг/м³. Fresh water, 1000 кг/м³: 990 / 1000 = 0,99 of the body is under
 * water, only the face shows, and the legs sink a little lower. The Dead Sea, about 1240 кг/м³: 990 / 1240 = 0,80
 * under water, a fifth of the body above it, so one can lie on the water and read a newspaper.
 * The waterline is drawn with the body's cross-section taken as a circle of the depth of the trunk: a fifth of its area
 * is above the water when the surface is 0,27 of the depth below the top, one hundredth at 0,04 (the head, which is
 * higher than the chest, then just clears it). 1,35 px per см. The bodies rise and fall gently on the waves.
 */
import ArhPicStyles from './ArhPicStyles.astro';
import SwimmerStyles from './SwimmerStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const SURF = 128;
const panels = [
	{ id: 'fresh', title: 'Пресная вода', rho: '1000 кг/м³', share: 'над водой — только лицо' },
	{ id: 'dead', title: 'Мёртвое море', rho: 'около 1240 кг/м³', share: 'над водой — пятая часть тела' },
];
---

<ArhPicStyles />
<SwimmerStyles />
<figure class="ap-pic sw-host ds not-content" data-deadsea>
	<div class="ap-pic__grid">
		{
			panels.map((p) => (
				<svg class="ap-pic__svg" viewBox="0 0 320 200" role="img" data-panel={p.id} aria-label={p.id === 'dead' ? 'Человек лежит на воде Мёртвого моря и читает газету: над водой его живот, грудь, лицо, колени и ступни' : 'Тот же человек в пресной воде: он почти целиком под водой, над поверхностью только лицо'}>
					<defs>
						<linearGradient id={`ds-${p.id}-${uid}`} x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" class={`ds-stop-${p.id}`} style="stop-opacity: 0.35" />
							<stop offset="1" class={`ds-stop-${p.id}`} style="stop-opacity: 0.6" />
						</linearGradient>
					</defs>
					<rect class="ds-sky" x="0" y="0" width="320" height={SURF + 2} />
					{p.id === 'dead' ? (
						<>
							<circle class="ds-sun" cx="270" cy="34" r="13" />
							<path class="ds-hills" d={`M 0 ${SURF} L 0 84 L 40 72 L 78 80 L 120 64 L 168 76 L 214 66 L 262 78 L 320 70 L 320 ${SURF} Z`} />
							<path class="ds-salt" d={`M 0 ${SURF} L 0 ${SURF - 9} Q 30 ${SURF - 13} 64 ${SURF - 6} L 80 ${SURF} Z`} />
							<path class="ds-salt" d={`M 236 ${SURF} Q 270 ${SURF - 10} 320 ${SURF - 8} L 320 ${SURF} Z`} />
						</>
					) : (
						<>
							<path class="ds-shore" d={`M 0 ${SURF} L 0 ${SURF - 18} Q 40 ${SURF - 30} 96 ${SURF - 16} Q 130 ${SURF - 8} 150 ${SURF} Z`} />
							<path class="ds-shore" d={`M 214 ${SURF} Q 260 ${SURF - 22} 320 ${SURF - 20} L 320 ${SURF} Z`} />
						</>
					)}
					<g data-who />
					{p.id === 'dead' && (
						<g data-paper>
							<path class="ds-paper" d="M -17 -12 L 15 -15 L 17 9 L -15 12 Z" />
							<path class="ds-print" d="M -12 -7 L 10 -9 M -12 -3 L 11 -5 M -11 1 L 11 -1 M -11 5 L 3 4" />
						</g>
					)}
					<path class={`ds-water ds-water--${p.id}`} fill={`url(#ds-${p.id}-${uid})`} d="" data-water />
					<path class={`ds-surf ds-surf--${p.id}`} d="" data-surf />
					<text class="ap-title" x="12" y="22">{p.title}</text>
					<text class="ap-small" x="12" y="40">{p.rho}</text>
					<text class="ap-small" x="160" y="192" text-anchor="middle">{p.share}</text>
				</svg>
			))
		}
	</div>
	<div class="ap-pic__foot">
		<figcaption>Один и тот же человек в пресной воде и в Мёртвом море. Вода Мёртвого моря плотнее человеческого тела, поэтому над ней остаётся пятая часть тела и на воде можно лежать, читая газету.</figcaption>
	</div>
</figure>

<style>
	.ds {
		--ds-fresh: var(--ig-vx);
		--ds-dead: hsl(178, 55%, 48%);
	}
	.ds-sky {
		fill: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-bg));
	}
	.ds-sun {
		fill: var(--ig-v);
		opacity: 0.85;
	}
	.ds-hills {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-4));
		opacity: 0.7;
	}
	.ds-salt {
		fill: color-mix(in oklab, var(--sl-color-white) 70%, var(--sl-color-gray-3));
	}
	.ds-shore {
		fill: color-mix(in oklab, hsl(120 40% 45%) 45%, var(--sl-color-gray-4));
	}
	.ds-stop-fresh {
		stop-color: var(--ds-fresh);
	}
	.ds-stop-dead {
		stop-color: var(--ds-dead);
	}
	.ds-surf {
		fill: none;
		stroke-width: 2;
	}
	.ds-surf--fresh {
		stroke: color-mix(in srgb, var(--ds-fresh) 80%, var(--sl-color-white));
	}
	.ds-surf--dead {
		stroke: color-mix(in srgb, var(--ds-dead) 80%, var(--sl-color-white));
	}
	.ds-paper {
		fill: hsl(40, 25%, 92%);
		stroke: hsl(222, 35%, 14%);
		stroke-width: 0.7;
	}
	.ds-print {
		fill: none;
		stroke: hsl(222, 15%, 45%);
		stroke-width: 1.2;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { swimmer, type Pt } from './swimmer';

	const SURF = 128;
	const S = 1.35; // px per cm
	const H = 170;
	const u = S * H;
	const W = 0.17 * u; // depth of the trunk, px

	for (const root of document.querySelectorAll<HTMLElement>('[data-deadsea]')) {
		const scenes = [...root.querySelectorAll<SVGSVGElement>('[data-panel]')].map((svg) => {
			const dead = svg.dataset.panel === 'dead';
			const pose = swimmer(svg.querySelector<SVGGElement>('[data-who]')!, { s: S, H, girth: 1, suit: dead ? 'sw-suit--blue' : 'sw-suit--red' });
			return {
				dead,
				pose,
				water: svg.querySelector<SVGPathElement>('[data-water]')!,
				surf: svg.querySelector<SVGPathElement>('[data-surf]')!,
				paper: svg.querySelector<SVGGElement>('[data-paper]'),
			};
		});
		const draw = (now: number) => {
			for (const sc of scenes) {
				const bob = 1.4 * Math.sin(now * 1.3 + (sc.dead ? 0 : 1.7));
				const hipX = 150;
				let hip: Pt;
				if (sc.dead) {
					// the top of the trunk is 0,27 of its depth above the surface
					hip = { x: hipX, y: SURF + bob + W / 2 - 0.27 * W };
					const shoulderX = hipX - 0.27 * u;
					const paper = { x: shoulderX - 0.02 * u, y: hip.y - 0.27 * u };
					sc.pose({
						hip,
						lean: -Math.PI / 2 + 0.06,
						ankles: [{ x: hipX + 0.47 * u, y: hip.y - 0.05 * u }, { x: hipX + 0.45 * u, y: hip.y - 0.03 * u }],
						feet: [-1.25, -1.15],
						hands: [{ x: paper.x + 13, y: paper.y + 4 }, { x: paper.x - 13, y: paper.y + 6 }],
						head: -0.6 * (Math.PI / 2) + 0.5,
						knees: 1,
					});
					if (sc.paper) sc.paper.setAttribute('transform', `translate(${paper.x.toFixed(1)} ${paper.y.toFixed(1)}) rotate(${(-30 + 2 * Math.sin(now * 0.9)).toFixed(1)})`);
				} else {
					// almost all under water: the trunk 0,04 of its depth above, the legs sink a little
					hip = { x: hipX, y: SURF + bob + W / 2 - 0.04 * W + 4 };
					sc.pose({
						hip,
						lean: -Math.PI / 2 + 0.2,
						ankles: [{ x: hipX + 0.46 * u, y: hip.y + 0.12 * u }, { x: hipX + 0.44 * u, y: hip.y + 0.14 * u }],
						feet: [-1.0, -0.9],
						hands: [{ x: hipX + 0.03 * u, y: hip.y + 0.02 * u }, { x: hipX - 0.01 * u, y: hip.y + 0.05 * u }],
						head: -0.6 * (Math.PI / 2) - 0.25,
					});
				}
				const pts: string[] = [];
				for (let x = 0; x <= 320; x += 8) pts.push(`${x} ${(SURF + 1.2 * Math.sin(x / 19 + now * 1.3)).toFixed(1)}`);
				sc.surf.setAttribute('d', `M ${pts.join(' L ')}`);
				sc.water.setAttribute('d', `M ${pts.join(' L ')} L 320 200 L 0 200 Z`);
			}
		};
		loop(root, () => {
			draw(performance.now() / 1000);
			return true;
		});
		draw(0);
	}
</script>
