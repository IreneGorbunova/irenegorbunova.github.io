---
/**
 * Picture to the conditions of floating: three equal cubes (3 cm, 28 px) are let go in the middle of a glass of
 * water. Densities 1,5, 1 and 0,5 of the density of water: the first sinks to the bottom, the second stays where it
 * was let go, the third rises and floats half under water. Arrows from the centre of each cube: the force of gravity
 * (red, constant) and the Archimedes force (green, proportional to the volume under water), on one scale (30 px for the
 * weight of the water in the volume of the cube). Vertical motion integrated in the script (gravity, buoyancy, added
 * mass ½ρV, drag C = 1,05, a little wave damping); shown 8 times slower, as the caption says.
 */
import ArhPicStyles from './ArhPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const SURF = 60;
const FLOOR = 196;
const COLS = [
	{ c: 62, r: 1.5, l1: 'тонет', l2: '', rel: '>' },
	{ c: 180, r: 1, l1: 'плавает', l2: 'внутри жидкости', rel: '=' },
	{ c: 298, r: 0.5, l1: 'всплывает', l2: '', rel: '<' },
];
---

<ArhPicStyles />
<figure class="ap-pic ap-pic--wide not-content" data-float>
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 30 360 230" role="img" aria-label="Три одинаковых по размеру кубика отпустили в воде. Кубик, плотность которого больше плотности воды, тонет: сила тяжести больше архимедовой силы. Кубик той же плотности, что и вода, остаётся на месте: силы равны. Кубик, плотность которого меньше, всплывает и плавает, погрузившись наполовину: архимедова сила уменьшается, пока не станет равна силе тяжести">
			<defs>
				<marker id={`${uid}-fg`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto">
					<path class="ap-head--fg" d="M0,0 L10,5 L0,10 z"></path>
				</marker>
				<marker id={`${uid}-fa`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto">
					<path class="ap-head--fa" d="M0,0 L10,5 L0,10 z"></path>
				</marker>
			</defs>
			{
				COLS.map((col) => (
					<g data-col={col.r}>
						<g data-cube>
							<rect class={`fp-cube fp-cube--${col.rel === '>' ? 'heavy' : col.rel === '=' ? 'same' : 'light'}`} x="-14" y="-14" width="28" height="28" rx="2" />
						</g>
						<rect class="ap-water" x={col.c - 46} y={SURF} width="92" height={FLOOR - SURF} />
						<line class="ap-surface" x1={col.c - 46} x2={col.c + 46} y1={SURF} y2={SURF} />
						<path class="ap-glass" d={`M ${col.c - 48} ${SURF - 22} V ${FLOOR + 2} H ${col.c + 48} V ${SURF - 22}`} />
						<line class="ap-arrow ap-arrow--fg" x1={col.c} x2={col.c} y1="0" y2="0" marker-end={`url(#${uid}-fg)`} data-fg />
						<line class="ap-arrow ap-arrow--fa" x1={col.c} x2={col.c} y1="0" y2="0" marker-end={`url(#${uid}-fa)`} data-fa />
						<text class="ap-tfg" x={col.c + 6} y="0" data-lfg>
							<tspan class="ap-math">F</tspan>
							<tspan class="ap-sub" dy="4">тяж</tspan>
						</text>
						<text class="ap-tfa" x={col.c - 6} y="0" text-anchor="end" data-lfa>
							<tspan class="ap-math">F</tspan>
							<tspan class="ap-sub" dy="4">А</tspan>
						</text>
						<text class="fp-name" x={col.c} y={FLOOR + 22} text-anchor="middle">{col.l1}</text>
						{col.l2 && <text class="fp-name" x={col.c} y={FLOOR + 38} text-anchor="middle">{col.l2}</text>}
						<text x={col.c} y={col.l2 ? FLOOR + 58 : FLOOR + 42} text-anchor="middle">
							<tspan class="ap-math">ρ</tspan>
							<tspan class="ap-sub" dy="4">т</tspan>
							<tspan dy="-4">{` ${col.rel} `}</tspan>
							<tspan class="ap-math">ρ</tspan>
							<tspan class="ap-sub" dy="4">ж</tspan>
						</text>
					</g>
				))
			}
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>Три кубика одного размера отпустили в воде. Сила тяжести у них разная, а архимедова сила, пока кубик целиком под водой, одна и та же. Всплывший кубик плавает, погрузившись настолько, чтобы архимедова сила стала равна силе тяжести. Движение показано в 8&nbsp;раз медленнее.</figcaption>
		<button type="button" class="ap-pic__again" data-again>Повторить</button>
	</div>
</figure>

<style>
	.ap-pic--wide .ap-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 36rem;
		margin-inline: auto;
	}
	.fp-cube {
		stroke-width: 1.2;
	}
	.fp-cube--heavy {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--ig-vx));
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 50%, var(--sl-color-black));
	}
	.fp-cube--same {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-3));
		stroke: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-black));
	}
	.fp-cube--light {
		fill: hsl(37 62% 62%);
		stroke: hsl(37 45% 38%);
	}
	.ap-pic .fp-name {
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const f1 = (v: number) => v.toFixed(1);
	const G = 9.8;
	const DT = 1 / 2000;
	const SLOW = 8;
	const PX = 28 / 0.03; // px per m
	const SURF = 60;
	const FLOOR = 196;
	const A = 0.03; // m, the edge of a cube

	/** Depth of the centre (m) against real time for a cube of relative density r, let go at depth z0. */
	const track = (r: number, z0: number, zMax: number, T: number) => {
		const rho = 1000;
		const m = r * rho * A ** 3;
		let z = z0;
		let v = 0;
		const out: number[] = [];
		for (let t = 0; t <= T; t += DT) {
			out.push(z);
			const hs = Math.min(A, Math.max(0, z + A / 2)); // height under water
			const f = hs / A;
			const F =
				m * G - rho * G * A * A * hs - 0.5 * rho * 1.05 * A * A * f * v * Math.abs(v) - (hs > 0 ? 0.12 : 0) * v;
			v += (F / (m + 0.5 * rho * A * A * hs)) * DT;
			z += v * DT;
			if (z >= zMax) {
				z = zMax;
				v = 0;
			}
		}
		return out;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-float]')) {
		const RUN = 7; // s on screen = 7/8 s of real time
		const z0 = (128 - SURF) / PX;
		const zMax = (FLOOR - 14 - SURF) / PX;
		const cols = [...root.querySelectorAll<SVGGElement>('[data-col]')].map((g) => {
			const r = Number(g.dataset.col);
			const c = Number(g.querySelector('[data-fg]')!.getAttribute('x1'));
			return {
				r,
				c,
				cube: g.querySelector<SVGGElement>('[data-cube]')!,
				fg: g.querySelector<SVGLineElement>('[data-fg]')!,
				fa: g.querySelector<SVGLineElement>('[data-fa]')!,
				lfg: g.querySelector<SVGTextElement>('[data-lfg]')!,
				lfa: g.querySelector<SVGTextElement>('[data-lfa]')!,
				z: track(r, z0, zMax, RUN / SLOW + 0.01),
			};
		});
		scene(root, RUN, (x) => {
			const i = Math.round((x * RUN) / SLOW / DT);
			for (const col of cols) {
				const z = col.z[Math.min(col.z.length - 1, i)];
				const y = SURF + z * PX;
				col.cube.setAttribute('transform', `translate(${col.c} ${f1(y)})`);
				const sub = Math.min(1, Math.max(0, (z + A / 2) / A));
				const onFloor = z >= zMax - 1e-6;
				const lg = 30 * col.r; // px: the weight of the water in the volume of the cube is 30 px
				const la = 30 * sub;
				col.fg.setAttribute('y1', f1(y));
				col.fg.setAttribute('y2', f1(y + lg));
				col.fa.setAttribute('y1', f1(y));
				col.fa.setAttribute('y2', f1(y - la));
				col.lfg.setAttribute('y', f1(y + lg + 4));
				col.lfa.setAttribute('y', f1(y - la + 6));
				const show = onFloor ? '0' : '1';
				for (const el of [col.fg, col.fa, col.lfg, col.lfa]) el.style.opacity = show;
			}
		});
	}
</script>
