---
/**
 * Two short looping opening scenes of «Точность и погрешность измерений». No terms of the chapter in the pictures.
 * Letter: a letter of 18 г is put on bathroom scales (0–120 кг, a division is 1 кг: the pointer would turn by
 *   0,03°, which cannot be seen) and then on letter scales (0–100 г, a division is 2 г: the pointer turns by 32°).
 * Dial: a speedometer whose pointer stands at 60 км/ч, 8 мм above the dial. The view turns from straight to 40° from
 *   the side: the dial is foreshortened by cos 40°, and the pointer, being nearer, shifts across the dial by
 *   8 мм · tg 40°, so it covers the 55 км/ч mark. (Dial: 2° per км/ч, pointer 62 px = 40 мм long.)
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const polar = (cx: number, cy: number, r: number, deg: number) => {
	const a = ((deg - 90) * Math.PI) / 180;
	return [Math.round((cx + r * Math.cos(a)) * 10) / 10, Math.round((cy + r * Math.sin(a)) * 10) / 10];
};
// bathroom scales: 0–120 кг over 180° (−90°…+90°); letter scales: 0–100 г over 180°
const bath = Array.from({ length: 121 }, (_, i) => i);
const post = Array.from({ length: 51 }, (_, i) => i * 2);
// speedometer: 0–120 км/ч over 240° (−120°…+120°), 60 at the top
const speed = Array.from({ length: 25 }, (_, i) => i * 5);
---

<IntroFrame data-tochintro>
	<div class="intro__card" data-scene="letter">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Письмо кладут на напольные весы: стрелка остаётся на нуле. Потом на почтовые весы: стрелка показывает 18 граммов">
			<rect class="ti-room" x="0" y="0" width="360" height="240"></rect>
			<!-- bathroom scales -->
			<text class="ti-label" x="92" y="22" text-anchor="middle">напольные весы</text>
			<path class="ti-dial" d="M22 120 A70 70 0 0 1 162 120 Z"></path>
			{bath.map((v) => {
				const [x1, y1] = polar(92, 120, 68, -90 + v * 1.5);
				const [x2, y2] = polar(92, 120, v % 10 === 0 ? 56 : 63, -90 + v * 1.5);
				return <line class="ti-tick" x1={x1} y1={y1} x2={x2} y2={y2} />;
			})}
			{[0, 20, 40, 60, 80, 100, 120].map((v) => {
				const [x, y] = polar(92, 120, 46, -90 + v * 1.5);
				return <text class="ti-num" x={x} y={y + 3} text-anchor="middle">{v}</text>;
			})}
			<text class="ti-num" x="92" y="108" text-anchor="middle">кг</text>
			<line class="ti-needle" data-n1 x1="92" y1="120" x2="92" y2="56" transform="rotate(-90 92 120)"></line>
			<circle class="ti-hub" cx="92" cy="120" r="4"></circle>
			<rect class="ti-platform" x="16" y="150" width="152" height="14" rx="4"></rect>
			<rect class="ti-base" x="26" y="164" width="132" height="8" rx="2"></rect>
			<text class="ti-read" x="92" y="198" text-anchor="middle" data-r1>0 кг</text>
			<!-- letter scales -->
			<text class="ti-label" x="268" y="22" text-anchor="middle">почтовые весы</text>
			<path class="ti-dial" d="M198 120 A70 70 0 0 1 338 120 Z"></path>
			{post.map((v) => {
				const [x1, y1] = polar(268, 120, 68, -90 + v * 1.8);
				const [x2, y2] = polar(268, 120, v % 10 === 0 ? 56 : 62, -90 + v * 1.8);
				return <line class="ti-tick" x1={x1} y1={y1} x2={x2} y2={y2} />;
			})}
			{[0, 20, 40, 60, 80, 100].map((v) => {
				const [x, y] = polar(268, 120, 46, -90 + v * 1.8);
				return <text class="ti-num" x={x} y={y + 3} text-anchor="middle">{v}</text>;
			})}
			<text class="ti-num" x="268" y="108" text-anchor="middle">г</text>
			<line class="ti-needle" data-n2 x1="268" y1="120" x2="268" y2="56" transform="rotate(-90 268 120)"></line>
			<circle class="ti-hub" cx="268" cy="120" r="4"></circle>
			<rect class="ti-platform" x="228" y="150" width="80" height="10" rx="4"></rect>
			<rect class="ti-base" x="246" y="160" width="44" height="12" rx="2"></rect>
			<text class="ti-read" x="268" y="198" text-anchor="middle" data-r2></text>
			<!-- the letter -->
			<g data-letter>
				<rect class="ti-letter" x="-24" y="-7" width="48" height="14" rx="1.5"></rect>
				<path class="ti-letter-line" d="M-24 -7 L0 2 L24 -7"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Письмо положили на напольные весы — стрелка не сдвинулась. Почтовые весы показали 18&nbsp;граммов:{' '}
				<More term="у них цена деления намного меньше">
					Одно деление напольных весов — целый килограмм, и письмо в 18&nbsp;г для них всё равно что ничего. Одно деление почтовых весов — 2&nbsp;г. Чем меньше цена деления прибора, тем точнее им можно измерить. Об этом — в разделе{' '}
					<a href="#точность-измерений">«Точность измерений»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="dial">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Спидометр: если смотреть прямо, стрелка стоит на 60 километрах в час, а если смотреть сбоку, кажется, что на 55">
			<rect class="ti-dash" x="0" y="0" width="360" height="240"></rect>
			<g data-face>
				<circle class="ti-face" cx="0" cy="0" r="88"></circle>
				{speed.map((v) => {
					const [x1, y1] = polar(0, 0, 80, -120 + v * 2);
					const [x2, y2] = polar(0, 0, v % 10 === 0 ? 66 : 72, -120 + v * 2);
					return <line class={`ti-stick${v % 10 === 0 ? ' ti-stick--major' : ''}`} x1={x1} y1={y1} x2={x2} y2={y2} />;
				})}
				{[0, 20, 40, 60, 80, 100, 120].map((v) => {
					const [x, y] = polar(0, 0, 52, -120 + v * 2);
					return <text class="ti-snum" x={x} y={y + 4} text-anchor="middle">{v}</text>;
				})}
				<text class="ti-snum ti-snum--unit" x="0" y="44" text-anchor="middle">км/ч</text>
			</g>
			<g data-hand>
				<path class="ti-hand" d="M-3 10 L0 -64 L3 10 Z"></path>
				<circle class="ti-handhub" cx="0" cy="0" r="7"></circle>
			</g>
			<rect class="ti-pill" x="10" y="10" width="150" height="42" rx="9"></rect>
			<text class="ti-small" x="20" y="27" data-who>смотрит водитель: прямо</text>
			<text class="ti-read ti-read--dark" x="20" y="45" data-speed>60 км/ч</text>
		</svg>
		<div class="intro__foot">
			<p>
				Стрелка спидометра стоит на&nbsp;60. Пассажир смотрит на прибор сбоку и видит её{' '}
				<More term="у отметки 55">
					Стрелка приподнята над шкалой. Если смотреть сбоку, она заслоняет не тот штрих, против которого стоит. Поэтому на шкалу любого прибора смотрят прямо — так, чтобы луч зрения был перпендикулярен шкале. Об этом — в разделе{' '}
					<a href="#как-смотреть-на-шкалу">«Как смотреть на шкалу»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-tochintro] .ti-room {
		fill: var(--sl-color-bg);
	}
	[data-tochintro] .ti-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-tochintro] .ti-dial {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	[data-tochintro] .ti-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.7;
	}
	[data-tochintro] .ti-num {
		font-size: 9px;
		fill: var(--sl-color-gray-2);
	}
	[data-tochintro] .ti-needle {
		stroke: var(--ig-vy);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	[data-tochintro] .ti-hub {
		fill: var(--sl-color-gray-1);
	}
	[data-tochintro] .ti-platform {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-gray-3));
	}
	[data-tochintro] .ti-base {
		fill: var(--sl-color-gray-4);
	}
	[data-tochintro] .ti-read {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-tochintro] .ti-letter {
		fill: hsl(45, 60%, 92%);
		stroke: hsl(36, 30%, 50%);
		stroke-width: 1;
	}
	[data-tochintro] .ti-letter-line {
		fill: none;
		stroke: hsl(36, 30%, 50%);
		stroke-width: 1;
	}
	[data-tochintro] .ti-dash {
		fill: hsl(230, 18%, 14%);
	}
	[data-tochintro] .ti-face {
		fill: hsl(230, 22%, 7%);
		stroke: hsl(230, 12%, 46%);
		stroke-width: 3;
	}
	[data-tochintro] .ti-stick {
		stroke: hsl(0, 0%, 86%);
		stroke-width: 1.2;
	}
	[data-tochintro] .ti-stick--major {
		stroke-width: 2.4;
	}
	[data-tochintro] .ti-snum {
		font-size: 12px;
		font-weight: 600;
		fill: hsl(0, 0%, 92%);
	}
	[data-tochintro] .ti-snum--unit {
		font-size: 10px;
		font-weight: 400;
		fill: hsl(0, 0%, 70%);
	}
	[data-tochintro] .ti-hand {
		fill: hsl(8, 95%, 58%);
	}
	[data-tochintro] .ti-handhub {
		fill: hsl(230, 10%, 30%);
		stroke: hsl(230, 10%, 50%);
	}
	[data-tochintro] .ti-pill {
		fill: hsl(232 45% 20% / 0.9);
	}
	[data-tochintro] .ti-small {
		font-size: 10px;
		fill: hsl(230, 20%, 80%);
	}
	[data-tochintro] .ti-read--dark {
		fill: hsl(42, 90%, 72%);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-tochintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="letter"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const letter = $<SVGGElement>('[data-letter]');
			const n2 = $<SVGLineElement>('[data-n2]');
			const r2 = $<SVGTextElement>('[data-r2]');
			scene(card, 8, (x) => {
				// the letter comes down on the bathroom scales, lies there, then moves to the letter scales
				const a = ease(x / 0.14);
				const b = ease((x - 0.42) / 0.2);
				const lx = 92 + (268 - 92) * b;
				const ly = b > 0 ? 143 - 46 * Math.sin(Math.PI * b) : 60 + (143 - 60) * a;
				letter.setAttribute('transform', `translate(${lx.toFixed(1)} ${ly.toFixed(1)})`);
				// the pointer of the letter scales: 1,8° per gram, with a little swing
				const u = (x - 0.62) / 0.2;
				const g = u <= 0 ? 0 : 18 * (1 - Math.exp(-5 * u) * Math.cos(9 * u));
				n2.setAttribute('transform', `rotate(${(-90 + g * 1.8).toFixed(2)} 268 120)`);
				r2.textContent = u > 0 ? `${Math.round(g)} г` : '';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="dial"]')!;
			const face = card.querySelector<SVGGElement>('[data-face]')!;
			const hand = card.querySelector<SVGGElement>('[data-hand]')!;
			const who = card.querySelector<SVGTextElement>('[data-who]')!;
			const speed = card.querySelector<SVGTextElement>('[data-speed]')!;
			const CX = 190;
			const CY = 126;
			const D = 12.4; // px: the pointer is 8 мм above the dial (62 px = 40 мм)
			scene(card, 7, (x) => {
				const th = (40 * Math.PI) / 180 * ease((x - 0.2) / 0.5);
				const c = Math.cos(th);
				face.setAttribute('transform', `translate(${CX} ${CY}) scale(${c.toFixed(4)} 1)`);
				hand.setAttribute('transform', `translate(${(CX - D * Math.sin(th)).toFixed(2)} ${CY}) scale(${c.toFixed(4)} 1)`);
				// the mark the tip of the pointer covers: 62·sin φ·cos θ = D·sin θ, 2° per км/ч
				const phi = (Math.asin(Math.min(1, (D * Math.tan(th)) / 62)) * 180) / Math.PI;
				speed.textContent = `${Math.round(60 - phi / 2)} км/ч`;
				who.textContent = th < 0.02 ? 'смотрит водитель: прямо' : 'смотрит пассажир: сбоку';
			});
		}
	}
</script>
