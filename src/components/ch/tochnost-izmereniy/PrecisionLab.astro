---
/**
 * «Три линейки»: one bar is measured with three rulers whose divisions are 1 см, 5 мм and 1 мм. The reader drags the
 * end of the bar (its real length changes in steps of 0,1 мм). Each ruler gives the stroke nearest to the end of the
 * bar and an error of half a division; the band a ± Δa is drawn on each ruler. The real length (shown on request)
 * always lies inside every band. To scale: 26 px per centimeter.
 */
import G7Styles from '../g7/G7Styles.astro';

const X0 = 26;
const CM = 26;
const RULERS = [
	{ key: 'a', y: 74, div: 1, name: 'деление 1 см' },
	{ key: 'b', y: 134, div: 0.5, name: 'деление 5 мм' },
	{ key: 'c', y: 194, div: 0.1, name: 'деление 1 мм' },
];
---

<G7Styles />
<figure class="g7 g7--stack prl not-content" data-prl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 370 250" role="img" aria-label="Брусок и три линейки с разной ценой деления" data-svg>
			<rect class="prl__bar" x={X0} y="22" height="26" rx="2" data-bar></rect>
			<g class="drag" data-handle>
				<rect class="prl__grip" x="-9" y="16" width="18" height="38" rx="6"></rect>
				<path class="prl__gripmark" d="M-3 28 v14 M3 28 v14"></path>
			</g>
			<line class="prl__end" data-end y1="48" y2="236"></line>
			{
				RULERS.map((r) => (
					<g>
						<rect class="prl__band" data-band={r.key} y={r.y} height="30"></rect>
						<rect class="prl__ruler" x={X0 - 8} y={r.y} width={13 * CM + 16} height="30" rx="3"></rect>
						{Array.from({ length: Math.round(13 / r.div) + 1 }, (_, i) => {
							const v = i * r.div;
							const whole = Math.abs(v - Math.round(v)) < 1e-9;
							const half = Math.abs(v * 2 - Math.round(v * 2)) < 1e-9;
							return <line class="prl__tick" x1={X0 + v * CM} x2={X0 + v * CM} y1={r.y} y2={r.y + (whole ? 13 : half ? 9 : 6)} />;
						})}
						{Array.from({ length: 14 }, (_, i) => (
							<text class="prl__num" x={X0 + i * CM} y={r.y + 25} text-anchor="middle">
								{i}
							</text>
						))}
						<text class="t-small" x={X0 - 8} y={r.y - 5}>{r.name}</text>
						<text class="t-strong t-num" x={X0 + 13 * CM + 8} y={r.y - 5} text-anchor="end" data-read={r.key}></text>
					</g>
				))
			}
		</svg>
		<div class="g7__side prl__side">
			<label class="g7__slider">
				<span>Длина бруска (потяните его за правый конец)</span>
				<output data-out></output>
				<input type="range" min="2" max="12.5" step="0.01" value="9.83" data-len aria-label="Длина бруска, сантиметры" />
			</label>
			<label class="prl__check"><input type="checkbox" data-true /> Показать настоящую длину бруска</label>
		</div>
	</div>
	<figcaption class="g7__caption">
		Цветная полоса на каждой линейке — значения, которые может иметь длина бруска при таком показании: от <i>a</i> − Δ<i>a</i> до <i>a</i> + Δ<i>a</i>. Сантиметры на всех линейках одинаковые.
	</figcaption>
</figure>

<style is:global>
	.prl__bar {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.prl__grip {
		fill: var(--sl-color-accent);
		opacity: 0.9;
	}
	.prl__gripmark {
		stroke: var(--sl-color-black);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.prl__end {
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.prl__ruler {
		fill: color-mix(in oklab, var(--ig-v) 16%, var(--sl-color-gray-6));
		fill-opacity: 0.55;
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.prl__band {
		fill: color-mix(in oklab, var(--ig-vx) 55%, transparent);
	}
	.prl__tick {
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.prl svg .prl__num {
		font-size: 9.5px;
		fill: var(--sl-color-gray-1);
	}
	.prl__side {
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		align-items: center;
	}
	.prl__check {
		display: flex;
		gap: 0.4rem;
		align-items: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.prl__check input {
		accent-color: var(--sl-color-accent);
	}
	@container (max-width: 30rem) {
		.prl__side {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { drag, fmt, fmtTrim } from '../g7/kit';

	const X0 = 26;
	const CM = 26;
	const DIV: Record<string, number> = { a: 1, b: 0.5, c: 0.1 };
	for (const root of document.querySelectorAll<HTMLElement>('[data-prl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const len = q<HTMLInputElement>('[data-len]');
		const out = q<HTMLOutputElement>('[data-out]');
		const bar = q<SVGRectElement>('[data-bar]');
		const handle = q<SVGGElement>('[data-handle]');
		const end = q<SVGLineElement>('[data-end]');
		const showTrue = q<HTMLInputElement>('[data-true]');

		const draw = () => {
			const L = Number(len.value);
			const x = X0 + L * CM;
			bar.setAttribute('width', String(L * CM));
			handle.setAttribute('transform', `translate(${x} 0)`);
			end.setAttribute('x1', String(x));
			end.setAttribute('x2', String(x));
			out.value = showTrue.checked ? `${fmt(L, 2)} см` : '?';
			for (const [key, div] of Object.entries(DIV)) {
				const a = Math.round(L / div + 1e-9) * div; // the nearest stroke
				const d = div / 2;
				const band = q<SVGRectElement>(`[data-band="${key}"]`);
				band.setAttribute('x', String(X0 + (a - d) * CM));
				band.setAttribute('width', String(2 * d * CM));
				const digits = div === 1 ? 0 : div === 0.5 ? 1 : 1;
				q(`[data-read="${key}"]`).textContent = `${fmt(a, digits)} ± ${fmtTrim(d, 2)} см`;
			}
		};
		len.addEventListener('input', draw);
		showTrue.addEventListener('change', draw);
		drag(handle, svg, {
			move: (p) => {
				const L = Math.min(12.5, Math.max(2, (p.x - X0) / CM));
				len.value = (Math.round(L * 100) / 100).toFixed(2);
				draw();
			},
		});
		draw();
	}
</script>
