---
/**
 * Picture «Тормозной путь»: two equal cars (1000 кг) brake on the same dry road from 60 км/ч and from 120 км/ч,
 * starting at the same line, with the same steady deceleration of 7,7 м/с² (good tyres on dry asphalt). The braking
 * distance is υ²/(2·7,7): 16,7² / 15,4 = 18 м and 33,3² / 15,4 = 72 м — four times longer, as the kinetic energy that
 * the brakes must take away: 1000 · 16,7² / 2 = 139 кДж and 1000 · 33,3² / 2 = 556 кДж. Real time (the cars stop in
 * 2,2 с and 4,3 с); to scale, 4 px per metre, the cars 4,4 м long.
 */
import G7Styles from '../g7/G7Styles.astro';

const X0 = 26; // the line where the brakes are pressed
const PXM = 4;
const lanes = [
	{ key: 1, y: 44, v: '60 км/ч', e: '139 кДж', s: 18 },
	{ key: 2, y: 128, v: '120 км/ч', e: '556 кДж', s: 72 },
];
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow brk not-content" data-braking>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 200" role="img" aria-label="Два одинаковых автомобиля тормозят: со скорости 60 километров в час тормозной путь 18 метров, со скорости 120 километров в час — 72 метра, в четыре раза длиннее">
			{
				lanes.map((L) => (
					<g>
						<text class="t-strong t-num" x="8" y={L.y - 24}>
							{L.v}
						</text>
						<text class="t-small t-num" x="80" y={L.y - 24}>
							энергия {L.e}
						</text>
						<rect class="brk__road" x="0" y={L.y - 12} width="360" height="24" />
						<line class="brk__mid" x1="0" x2="360" y1={L.y + 12} y2={L.y + 12} />
						<line class="brk__line" x1={X0} x2={X0} y1={L.y - 12} y2={L.y + 12} />
						<g data-car={L.key}>
							<path class="brk__body" d="M-17.6 2 V-3 Q-17.6 -5.5 -14.5 -5.5 L-12 -5.5 L-9 -10 H-4 L-1.5 -5.5 Q0 -5.3 0 -3 V2 Z" />
							<path class="brk__glass" d="M-11.5 -6 L-8.7 -9.3 H-6.8 V-6 Z M-6 -6 V-9.3 H-4.3 L-2.3 -6 Z" />
							<rect class="brk__lamp" x="-18.3" y="-4" width="2" height="2.6" rx="0.6" data-lamp />
							<circle class="brk__wheel" cx="-14" cy="2" r="2.4" />
							<circle class="brk__wheel" cx="-3.6" cy="2" r="2.4" />
						</g>
						<g data-dim={L.key} style="opacity: 0">
							<path class={`brk__dim brk__dim--${L.key}`} d={`M${X0} ${L.y + 22} H${X0 + L.s * PXM} M${X0} ${L.y + 18} V${L.y + 26} M${X0 + L.s * PXM} ${L.y + 18} V${L.y + 26}`} />
							<text class={`t-strong t-num brk__t--${L.key}`} x={X0 + (L.s * PXM) / 2} y={L.y + 38} text-anchor="middle">
								{L.s} м
							</text>
						</g>
					</g>
				))
			}
			<text class="t-small" x={X0 + 3} y="190">на пунктире водитель нажал на тормоз</text>
			<text class="t-strong brk__t--2" x="352" y="166" text-anchor="end" data-x4 style="opacity: 0">в 4 раза длиннее</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Одинаковые автомобили массой 1000&nbsp;кг тормозят на сухой дороге. Скорость вдвое больше — кинетическая энергия и тормозной путь вчетверо больше.
	</figcaption>
</figure>

<style is:global>
	.brk__road {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--g7-paper));
	}
	.brk__mid {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.brk__line {
		stroke: var(--sl-color-white);
		stroke-width: 2;
		stroke-dasharray: 3 2;
	}
	.brk__body {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.brk__glass {
		fill: var(--g7-paper);
		opacity: 0.8;
	}
	.brk__wheel {
		fill: var(--sl-color-gray-1);
		stroke: var(--g7-paper);
		stroke-width: 0.8;
	}
	.brk__lamp {
		fill: var(--g7-faint);
	}
	.brk__lamp.is-on {
		fill: hsl(0, 95%, 58%);
	}
	.brk__dim {
		fill: none;
		stroke-width: 1.6;
	}
	.brk__dim--1 {
		stroke: var(--g7-blue);
	}
	.brk__dim--2 {
		stroke: var(--g7-red);
	}
	.g7__svg .brk__t--1 {
		fill: var(--g7-blue);
	}
	.g7__svg .brk__t--2 {
		fill: var(--g7-red);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const X0 = 26;
	const PXM = 4;
	const A = 7.7;
	const LEAD = 0.5; // с of driving before the line
	const HOLD = 2.5;
	for (const root of document.querySelectorAll<HTMLElement>('[data-braking]')) {
		const cars = [
			{ v: 60 / 3.6, g: root.querySelector<SVGGElement>('[data-car="1"]')!, dim: root.querySelector<SVGGElement>('[data-dim="1"]')!, y: 44 },
			{ v: 120 / 3.6, g: root.querySelector<SVGGElement>('[data-car="2"]')!, dim: root.querySelector<SVGGElement>('[data-dim="2"]')!, y: 128 },
		];
		const x4 = root.querySelector<SVGTextElement>('[data-x4]')!;
		const tEnd = LEAD + cars[1].v / A;
		let t = 0;
		const draw = () => {
			for (const c of cars) {
				const tb = t - LEAD;
				const tStop = c.v / A;
				// the position of the front bumper, metres past the line
				const x = tb < 0 ? c.v * tb : c.v * Math.min(tb, tStop) - (A * Math.min(tb, tStop) ** 2) / 2;
				c.g.setAttribute('transform', `translate(${(X0 + x * PXM).toFixed(1)} ${c.y + 6})`);
				c.g.querySelector('[data-lamp]')!.classList.toggle('is-on', tb >= 0);
				c.dim.style.opacity = tb >= tStop ? '1' : '0';
			}
			x4.style.opacity = t >= tEnd ? '1' : '0';
		};
		loop(root, (dt) => {
			t += dt;
			if (t > tEnd + HOLD) t = 0;
			draw();
			return true;
		});
		draw();
	}
</script>
