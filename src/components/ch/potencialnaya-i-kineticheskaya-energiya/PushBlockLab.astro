---
/**
 * «Тележка и брусок»: a cart (1…3 кг) rolls with a speed of 1…3 м/с into a light block and pushes it along the
 * table. The table brakes the block with a constant force of 5 Н, so the cart stops after the path
 * s = m·υ²/(2 · 5 Н) (0,1…2,7 м): all its kinetic energy goes into the work against friction (the mass of the block
 * is neglected). The motion is played in real time; 95 px per metre. The paths are collected in a table: masses in
 * the rows, speeds in the columns.
 */
import G7Styles from '../g7/G7Styles.astro';

const X0 = 110; // where the block stands
const M = 95;
---

<G7Styles />
<figure class="g7 g7--stack pbl not-content" data-pbl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 124" role="img" aria-label="Тележка налетает на брусок и толкает его по столу до остановки" data-svg>
			<line class="pbl__floor" x1="0" x2="400" y1="84" y2="84"></line>
			{[0, 0.5, 1, 1.5, 2, 2.5].map((m) => (
				<>
					<line class="ln" x1={X0 + m * M} x2={X0 + m * M} y1="84" y2="90" />
					<text class="t-small t-num" x={X0 + m * M} y="102" text-anchor="middle">{String(m).replace('.', ',')}</text>
				</>
			))}
			<text class="t-small" x="396" y="118" text-anchor="end">путь бруска, м</text>
			<line class="pbl__path" data-path x1={X0} y1="84" y2="84"></line>
			<g data-cart>
				<rect class="pbl__cart" x="-40" y="-26" width="40" height="14" rx="3"></rect>
				<circle class="pbl__wheel" cx="-31" cy="-6" r="6"></circle>
				<circle class="pbl__wheel" cx="-9" cy="-6" r="6"></circle>
				<g data-loads></g>
			</g>
			<rect class="pbl__block" data-block y="58" width="22" height="26" rx="2"></rect>
			<text class="t-strong t-num" x="396" y="22" text-anchor="end" data-s></text>
		</svg>
		<div class="g7__side pbl__side">
			<div class="g7__side">
				<label class="g7__slider">
					<span>Масса тележки</span>
					<output data-om></output>
					<input type="range" min="1" max="3" step="1" value="1" data-m aria-label="Масса тележки, килограммы" />
				</label>
				<label class="g7__slider">
					<span>Скорость тележки</span>
					<output data-ov></output>
					<input type="range" min="1" max="3" step="1" value="2" data-v aria-label="Скорость тележки, метры в секунду" />
				</label>
				<button type="button" class="g7__btn g7__btn--go" data-go>Пустить тележку</button>
			</div>
			<table class="pbl__table">
				<caption>Путь бруска до остановки, м</caption>
				<thead>
					<tr><th></th><th>1&nbsp;м/с</th><th>2&nbsp;м/с</th><th>3&nbsp;м/с</th></tr>
				</thead>
				<tbody>
					{[1, 2, 3].map((m) => (
						<tr>
							<th>{m}&nbsp;кг</th>
							{[1, 2, 3].map((v) => <td data-cell={`${m}-${v}`}>—</td>)}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
	<figcaption class="g7__caption">
		Стол тормозит брусок с постоянной силой 5&nbsp;Н. Чем длиннее путь бруска, тем большую работу совершила тележка, пока останавливалась. Пути записываются в таблицу.
	</figcaption>
</figure>

<style is:global>
	.pbl__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 1rem 1.5rem;
	}
	.pbl__table {
		margin: 0;
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
	}
	.pbl__table caption {
		caption-side: top;
		padding-bottom: 0.35rem;
		text-align: left;
		color: var(--sl-color-gray-2);
	}
	.pbl__table th,
	.pbl__table td {
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		text-align: center;
	}
	.pbl__table th {
		font-weight: 600;
		color: var(--sl-color-gray-2);
		background: var(--sl-color-gray-6);
	}
	.pbl__table td {
		color: var(--sl-color-gray-3);
	}
	.pbl__table td.is-set {
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.pbl__table td.is-now {
		box-shadow: inset 0 0 0 2px var(--g7-gold);
	}
	.pbl__floor {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.pbl__path {
		stroke: var(--g7-gold);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.pbl__cart {
		fill: var(--g7-blue);
	}
	.pbl__wheel {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pbl__w {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pbl__block {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	@container (max-width: 34rem) {
		.pbl__side {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { el, fmtTrim, loop } from '../g7/kit';

	const X0 = 110;
	const M = 95;
	const FR = 5; // Н
	const RUN = 0.6; // м: how far the cart rolls before it reaches the block
	for (const root of document.querySelectorAll<HTMLElement>('[data-pbl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const mIn = q<HTMLInputElement>('[data-m]');
		const vIn = q<HTMLInputElement>('[data-v]');
		const cart = q<SVGGElement>('[data-cart]');
		const block = q<SVGRectElement>('[data-block]');
		const loads = q<SVGGElement>('[data-loads]');
		let t = -1;
		/** `time` < 0: before the start; returns true when the cart has stopped. */
		const draw = (time: number) => {
			const m = Number(mIn.value);
			const v = Number(vIn.value);
			const tHit = RUN / v;
			const a = FR / m;
			let x = -RUN; // the front of the cart relative to the block, м
			let s = 0;
			if (time >= 0) {
				if (time < tHit) x = -RUN + v * time;
				else {
					const tt = Math.min(time - tHit, v / a);
					s = v * tt - (a * tt * tt) / 2;
					x = s;
				}
			}
			const done = time >= tHit + v / a;
			cart.setAttribute('transform', `translate(${(X0 + x * M).toFixed(1)} 84)`);
			block.setAttribute('x', (X0 + s * M).toFixed(1));
			q('[data-path]').setAttribute('x2', (X0 + s * M).toFixed(1));
			if (loads.childElementCount !== m - 1) {
				loads.replaceChildren();
				for (let i = 0; i < m - 1; i++) loads.append(el('rect', { class: 'pbl__w', x: -34, y: -38 - i * 12, width: 28, height: 11, rx: 2 }));
			}
			q('[data-om]').textContent = `${m} кг`;
			q('[data-ov]').textContent = `${v} м/с`;
			q('[data-s]').textContent = done ? `путь ${fmtTrim((m * v * v) / (2 * FR), 2)} м` : '';
			for (const td of root.querySelectorAll<HTMLElement>('[data-cell]')) td.classList.toggle('is-now', td.dataset.cell === `${m}-${v}`);
			return done;
		};
		const wake = loop(root, (dt) => {
			if (t < 0) return false;
			t += dt;
			if (draw(t)) {
				const m = Number(mIn.value);
				const v = Number(vIn.value);
				const td = q<HTMLElement>(`[data-cell="${m}-${v}"]`);
				td.textContent = fmtTrim((m * v * v) / (2 * FR), 2);
				td.classList.add('is-set');
				t = -1;
				return false;
			}
			return true;
		});
		q('[data-go]').addEventListener('click', () => {
			t = 0;
			draw(0);
			wake();
		});
		for (const i of [mIn, vIn])
			i.addEventListener('input', () => {
				t = -1;
				draw(-1);
			});
		draw(-1);
	}
</script>
