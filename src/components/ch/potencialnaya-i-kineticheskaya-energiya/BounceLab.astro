---
/**
 * Model «Мяч, упавший на пол» (was the picture BouncePicture; Irina, 21 Nov 2026, asked for a model where the internal
 * energy can be switched off): a basketball (0,6 кг, 24 см across) is let go with its bottom 1,5 м above the floor
 * and bounces three times. Beside it four bars show where its energy is at each moment, in one scale (the full bar
 * is 8,82 Дж = 9,8 Н/кг · 0,6 кг · 1,5 м, the energy it had at the start):
 *   potential energy g·m·h (h = the height of its bottom above the floor, the zero level),
 *   kinetic energy m·υ²/2,
 *   the energy of its elastic deformation k·x²/2 (x = how much it is squashed),
 *   and the energy that has gone into heating the ball and the floor (what is left of 8,82 Дж).
 * The flight is computed without air; at the floor the ball is a spring with damping: k = 44 100 Н/м, so that it is
 * squashed by 2 см at the first blow, and damping such that it keeps 70 % of its energy at each blow (a real
 * basketball: about 1,05 м after 1,5 м). The heights are 1,5 → 1,05 → 0,74 → 0,51 м. A blow lasts 0,012 с; gravity
 * is neglected during it (less than 1,5 % of the energy).
 * The switch «Без потерь» makes the blow perfectly elastic (no damping): the ball keeps all its energy, comes back to
 * 1,5 м every time and the bar of the internal energy stays at 0 (during a blow the elastic energy is then shown as
 * 8,82 Дж minus the kinetic one, so rounding of the steps never shows a stray 0,01 Дж). «Заново» lets the ball go again.
 * Slowed: the flight twice, the blow 40 times; the squash is drawn three times larger. 120 px per metre.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 120; // px per metre
const FLOOR = 232;
const BX = 96; // the ball's axis
const bars = [
	{ key: 'p', name: 'потенциальная', y: 44 },
	{ key: 'k', name: 'кинетическая', y: 94 },
	{ key: 'e', name: 'упругой деформации', y: 144 },
	{ key: 'q', name: 'внутренняя', y: 194 },
];
const BAR0 = 178;
const BARW = 174;
---

<G7Styles />
<figure class="g7 g7--stack g7--narrow bnc not-content" data-bounce>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 252" role="img" aria-label="Мяч падает на пол и подскакивает всё ниже; рядом полоски показывают его потенциальную, кинетическую энергию, энергию упругой деформации и энергию, ушедшую на нагревание">
			<rect class="bnc__floor" x="0" y={FLOOR} width="176" height={252 - FLOOR}></rect>
			<line class="ln" x1="0" x2="176" y1={FLOOR} y2={FLOOR}></line>
			{[0, 0.5, 1, 1.5].map((m) => (
				<>
					<line class="ln" x1="26" x2="34" y1={FLOOR - m * K} y2={FLOOR - m * K} />
					<text class="t-small t-num" x="22" y={FLOOR - m * K + 4} text-anchor="end">{String(m).replace('.', ',')}</text>
				</>
			))}
			<line class="ln" x1="34" x2="34" y1={FLOOR - 1.5 * K} y2={FLOOR}></line>
			<text class="t-small" x="22" y={FLOOR - 1.5 * K - 10} text-anchor="end">м</text>
			<line class="ln-dash" x1="40" x2="170" y1={FLOOR - 1.5 * K} y2={FLOOR - 1.5 * K}></line>
			<g data-peaks></g>
			<g data-ball>
				<ellipse class="bnc__ball" cx="0" cy="0" rx="14.4" ry="14.4" data-shape></ellipse>
				<path class="bnc__seam" data-seam></path>
			</g>
			{
				bars.map((b) => (
					<g>
						<text class="t-small" x={BAR0} y={b.y - 6}>
							{b.name}
						</text>
						<text class={`t-strong t-num bnc__v bnc__v--${b.key}`} x={BAR0 + BARW} y={b.y - 6} text-anchor="end" data-v={b.key} />
						<rect class="bnc__slot" x={BAR0} y={b.y} width={BARW} height="14" rx="3" />
						<rect class={`bnc__bar bnc__bar--${b.key}`} x={BAR0} y={b.y} width="0" height="14" rx="3" data-bar={b.key} />
					</g>
				))
			}
			<text class="t-small" x={BAR0} y="236">сумма всё время 8,82 Дж</text>
		</svg>
		<div class="g7__row">
			<div class="g7__seg" role="group" aria-label="Есть ли потери энергии при ударе" data-mode>
				<button type="button" class="g7__btn" aria-pressed="true" data-keep="0.7">С потерями</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-keep="1">Без потерь</button>
			</div>
			<button type="button" class="g7__btn g7__btn--go" data-again>Заново</button>
		</div>
	</div>
	<figcaption class="g7__caption">
		Мяч массой 0,6&nbsp;кг отпустили с высоты 1,5&nbsp;м; полоски показывают, где его энергия; «внутренняя» — та часть, что при ударах идёт на нагревание мяча и пола. «Без потерь» — так было бы, если бы мяч и пол совсем не нагревались. Полёт замедлен в 2 раза, удар о пол — в 40 раз, а сжатие мяча нарисовано втрое больше.
	</figcaption>
</figure>

<style is:global>
	.bnc__floor {
		fill: var(--g7-ground);
	}
	.bnc__ball {
		fill: color-mix(in oklab, var(--ig-v) 70%, hsl(20, 90%, 55%));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.bnc__seam {
		fill: none;
		stroke: hsl(20, 40%, 20%);
		stroke-width: 1;
	}
	.bnc__peak {
		stroke: var(--g7-blue);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.bnc__slot {
		fill: var(--g7-faint);
		opacity: 0.6;
	}
	.bnc__bar--p {
		fill: var(--g7-blue);
	}
	.bnc__bar--k {
		fill: var(--g7-red);
	}
	.bnc__bar--e {
		fill: var(--g7-green);
	}
	.bnc__bar--q {
		fill: var(--g7-violet);
	}
	.g7__svg .bnc__v--p {
		fill: var(--g7-blue);
	}
	.g7__svg .bnc__v--k {
		fill: var(--g7-red);
	}
	.g7__svg .bnc__v--e {
		fill: var(--g7-green);
	}
	.g7__svg .bnc__v--q {
		fill: var(--g7-violet);
	}
</style>

<script>
	import { el, fmt, loop, segment } from '../g7/kit';

	const K = 120;
	const FLOOR = 232;
	const BX = 96;
	const BARW = 174;
	const R = 0.12; // м, the radius
	const m = 0.6;
	const g = 9.8;
	const H0 = 1.5;
	const E0 = g * m * H0;
	const XMAX = 0.02; // м, the squash at the first blow
	const k = (2 * E0) / (XMAX * XMAX);
	/** The damping that keeps the share `keep` of the energy at a blow (keep = 1: none). */
	const damping = (keep: number) => {
		if (keep >= 1) return 0;
		const lnE = Math.log(Math.sqrt(keep));
		const zeta = -lnE / Math.sqrt(Math.PI * Math.PI + lnE * lnE);
		return 2 * zeta * Math.sqrt(k * m);
	};
	const SLOW_FLY = 2;
	const SLOW_HIT = 40;
	const SQUASH = 3;
	const BOUNCES = 3;
	const HOLD = 1.6; // с of the last frame
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-bounce]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const ball = q<SVGGElement>('[data-ball]');
		const shape = q<SVGEllipseElement>('[data-shape]');
		const seam = q<SVGPathElement>('[data-seam]');
		const peaks = q<SVGGElement>('[data-peaks]');
		const bars = { p: q('[data-bar="p"]'), k: q('[data-bar="k"]'), e: q('[data-bar="e"]'), q: q('[data-bar="q"]') };
		const vals = { p: q('[data-v="p"]'), k: q('[data-v="k"]'), e: q('[data-v="e"]'), q: q('[data-v="q"]') };

		// the state: the height of the bottom (м), the velocity (м/с, up +), the squash (м), the number of blows
		let y = H0;
		let v = 0;
		let x = 0;
		let hits = 0;
		let contact = false;
		let hold = -1;
		const spin = 0.5; // the seam is turned a little
		let lossless = false;
		let c = damping(0.7);

		const reset = () => {
			y = H0;
			v = 0;
			x = 0;
			hits = 0;
			contact = false;
			hold = -1;
			peaks.replaceChildren();
		};
		const markPeak = (h: number) => {
			const yy = FLOOR - h * K;
			peaks.append(el('line', { class: 'bnc__peak', x1: BX - 26, x2: BX + 26, y1: f1(yy), y2: f1(yy) }));
			peaks.append(el('text', { class: 't-small t-num t-halo', x: BX + 30, y: f1(yy + 4) }, `${fmt(h, 2)}\u00a0м`));
		};

		const draw = () => {
			const Ep = contact ? 0 : g * m * Math.max(0, y);
			const Ek = (m * v * v) / 2;
			const Ee = contact ? (lossless ? Math.max(0, E0 - Ek) : (k * x * x) / 2) : 0;
			const Eq = lossless ? 0 : Math.max(0, E0 - Ep - Ek - Ee);
			const E = { p: Ep, k: Ek, e: Ee, q: Eq };
			for (const key of ['p', 'k', 'e', 'q'] as const) {
				bars[key].setAttribute('width', f1((BARW * E[key]) / E0));
				vals[key].textContent = `${fmt(E[key], 2)}\u00a0Дж`;
			}
			const X = contact ? SQUASH * x * K : 0; // px
			const ry = R * K - X / 2;
			const rx = R * K + X / 4;
			const cy = contact ? FLOOR - ry : FLOOR - y * K - R * K;
			ball.setAttribute('transform', `translate(${BX} ${f1(cy)})`);
			shape.setAttribute('rx', f1(rx));
			shape.setAttribute('ry', f1(ry));
			const a = spin;
			const s = Math.sin(a);
			seam.setAttribute('d', `M${f1(-rx)} 0 H${f1(rx)} M${f1(s * rx * 0.5)} ${f1(-ry)} Q${f1(s * rx * 1.1)} 0 ${f1(s * rx * 0.5)} ${f1(ry)}`);
		};

		loop(root, (dt) => {
			if (hold >= 0) {
				hold += dt;
				if (hold > HOLD) reset();
				draw();
				return true;
			}
			if (!contact) {
				let rdt = dt / SLOW_FLY;
				const vBefore = v;
				const y1 = y + v * rdt - 4.9 * rdt * rdt;
				if (y1 <= 0 && v <= 0) {
					// time to the floor within this step
					const tt = (v + Math.sqrt(v * v + 2 * g * y)) / g;
					v = v - g * tt;
					y = 0;
					contact = true;
					x = 0;
				} else {
					y = y1;
					v = v - g * rdt;
					if (vBefore > 0 && v <= 0) {
						markPeak(y);
						if (hits >= BOUNCES) hold = 0;
					}
				}
			} else {
				// the squash x grows downward; the ball's velocity is v (up +): dx/dt = −v
				const steps = 40;
				const h = dt / SLOW_HIT / steps;
				for (let i = 0; i < steps && contact; i++) {
					const a = (k * x - c * v) / m; // acceleration of the ball, up +
					v += a * h;
					x -= v * h;
					if (x <= 0 && v > 0) {
						x = 0;
						if (lossless) v = Math.sqrt(2 * g * H0); // exactly the speed it hit with
						contact = false;
						y = 0;
						hits++;
					}
				}
			}
			draw();
			return true;
		});
		segment(q('[data-mode]'), (b) => {
			lossless = b.dataset.keep === '1';
			c = damping(Number(b.dataset.keep));
			reset();
			draw();
		});
		q('[data-again]').addEventListener('click', () => {
			reset();
			draw();
		});
		reset();
		draw();
	}
</script>
