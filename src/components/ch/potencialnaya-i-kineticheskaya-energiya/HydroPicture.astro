---
/**
 * Picture «Гидроэлектростанция»: a cross-section of a dam power station, as a school scheme (not to scale). The dam
 * holds the water of the reservoir high; the water goes down through the penstock by the height h between the two
 * water levels, gathers speed and turns the turbine; the turbine turns the generator on the same shaft, and the
 * current goes out along the power line. The water that has passed the turbine flows slowly into the river below.
 * Animated: the particles of water move faster the lower they are in the penstock and slowly after the turbine; the
 * blades of the turbine and the rotor of the generator turn about the vertical shaft; pulses run along the wires. The chain of energy is written underneath.
 */
import G7Styles from '../g7/G7Styles.astro';

const SURF = 62; // the reservoir
const TAIL = 200; // the river below the dam
const uid = `hyd${Math.random().toString(36).slice(2, 8)}`;
const chain = [
	{ x: 4, l1: 'потенциальная', l2: 'энергия воды', cls: 'p' },
	{ x: 126, l1: 'кинетическая', l2: 'энергия воды', cls: 'k' },
	{ x: 248, l1: 'электрическая', l2: 'энергия', cls: 'e' },
];
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow hyd not-content" data-hydro>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 292" role="img" aria-label="Разрез гидроэлектростанции: вода из водохранилища опускается по водоводу сквозь плотину, вращает турбину, турбина вращает генератор, ток уходит по проводам">
			<defs>
				<clipPath id={`${uid}r`}><rect x="231" y="194" width="38" height="12"></rect></clipPath>
				<clipPath id={`${uid}g`}><rect x="229" y="140" width="42" height="26"></rect></clipPath>
			</defs>
			<!-- the ground and the two waters -->
			<rect class="hyd__ground" x="0" y="214" width="360" height="12"></rect>
			<rect class="hyd__water" x="0" y={SURF} width="130" height={214 - SURF}></rect>
			<line class="hyd__surf" x1="0" x2="130" y1={SURF} y2={SURF}></line>
			<path class="hyd__ground" d="M290 214 V226 H0 V214 Z"></path>
			<rect class="hyd__water" x="290" y={TAIL} width="70" height="26"></rect>
			<line class="hyd__surf" x1="290" x2="360" y1={TAIL} y2={TAIL}></line>
			<!-- the dam -->
			<path class="hyd__dam" d="M128 40 H146 L212 214 H128 Z"></path>
			<!-- the penstock through the dam, and the draft tube to the river -->
			<path class="hyd__pipe" d="M128 140 L150 140 L226 196 L234 196"></path>
			<path class="hyd__pipe" d="M250 206 V214 Q250 220 262 220 H300"></path>
			<path class="hyd__pipein" d="M128 140 L150 140 L226 196 L234 196"></path>
			<path class="hyd__pipein" d="M250 206 V214 Q250 220 262 220 H300"></path>
			<path d="M60 128 L128 140 L150 140 L226 196 L250 200" fill="none" data-path1></path>
			<path d="M250 206 V214 Q250 220 262 220 H340" fill="none" data-path2></path>
			<!-- the power house -->
			<path class="hyd__house" d="M212 214 V122 H292 V214"></path>
			<path class="hyd__roof" d="M208 122 H296"></path>
			<rect class="hyd__gen" x="229" y="140" width="42" height="26" rx="3"></rect>
			<g clip-path={`url(#${uid}g)`} data-rotor></g>
			<line class="hyd__shaft" x1="250" x2="250" y1="166" y2="194"></line>
			<rect class="hyd__runner" x="231" y="194" width="38" height="12" rx="2"></rect>
			<g clip-path={`url(#${uid}r)`} data-blades></g>
			<g data-drops></g>
			<!-- the power line -->
			<path class="hyd__mast" d="M330 214 L322 96 M330 214 L338 96 M318 96 H342 M322 96 L330 70 L338 96 M324 150 H336"></path>
			<path class="hyd__wire" d="M262 140 V114 Q290 100 324 96 M336 96 Q348 92 360 94" data-wire></path>
			<g data-pulses></g>
			<!-- the two levels and the height between them -->
			<line class="ln-dash" x1="130" x2="300" y1={SURF} y2={SURF}></line>
			<line class="ln-dash" x1="0" x2="290" y1={TAIL} y2={TAIL}></line>
			<path class="hyd__dim" d={`M16 ${SURF + 2} V${TAIL - 2} M12 ${SURF + 8} L16 ${SURF + 2} L20 ${SURF + 8} M12 ${TAIL - 8} L16 ${TAIL - 2} L20 ${TAIL - 8}`}></path>
			<text class="t-i t-halo" x="22" y={(SURF + TAIL) / 2 + 5}>h</text>
			<!-- labels -->
			<text class="t-small t-halo" x="28" y={SURF + 18}>водохранилище</text>
			<text class="t-small t-halo" x="150" y="96" text-anchor="middle">плотина</text>
			<text class="t-small t-halo" x="176" y="182" text-anchor="end">водовод</text>
			<text class="t-small t-halo" x="226" y="134">генератор</text>
			<text class="t-small t-halo" x="272" y="192">турбина</text>
			<text class="t-small t-halo" x="350" y="62" text-anchor="end">ЛЭП</text>
			<text class="t-small t-halo" x="356" y="240" text-anchor="end">река</text>
			<!-- the chain of energy -->
			{
				chain.map((c, i) => (
					<g>
						<rect class={`hyd__pill hyd__pill--${c.cls}`} x={c.x} y="248" width="108" height="40" rx="9" />
						<text class="hyd__ptext" x={c.x + 54} y="265" text-anchor="middle">
							{c.l1}
						</text>
						<text class="hyd__ptext" x={c.x + 54} y="280" text-anchor="middle">
							{c.l2}
						</text>
						{i < 2 && <path class="hyd__arr" d={`M${c.x + 110} 268 h10 m-4 -4 l4 4 l-4 4`} />}
					</g>
				))
			}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Разрез гидроэлектростанции (не в масштабе). Вода опускается по водоводу на высоту <i>h</i>, разгоняется и вращает турбину, а турбина — генератор.
	</figcaption>
</figure>

<style is:global>
	.hyd__ground {
		fill: var(--g7-ground);
	}
	.hyd__water {
		fill: var(--g7-water);
	}
	.hyd__surf {
		stroke: var(--g7-water-edge);
		stroke-width: 1.4;
	}
	.hyd__dam {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.hyd__pipe {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 12;
		stroke-linejoin: round;
	}
	.hyd__pipein {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-bg));
		stroke-width: 9;
		stroke-linejoin: round;
	}
	.hyd__house {
		fill: var(--g7-faint);
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.hyd__roof {
		stroke: var(--g7-line);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.hyd__gen {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.hyd__coil {
		stroke: var(--g7-gold);
		stroke-width: 3;
	}
	.hyd__shaft {
		stroke: var(--g7-ink);
		stroke-width: 3;
	}
	.hyd__runner {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.hyd__blade {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.hyd__drop {
		fill: var(--g7-water-edge);
	}
	.hyd__mast {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.hyd__wire {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.hyd__pulse {
		fill: var(--g7-gold);
	}
	.hyd__dim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.hyd__pill {
		fill: var(--sl-color-gray-6);
		stroke-width: 1.6;
	}
	.hyd__pill--p {
		stroke: var(--g7-blue);
	}
	.hyd__pill--k {
		stroke: var(--g7-red);
	}
	.hyd__pill--e {
		stroke: var(--g7-gold);
	}
	.g7__svg .hyd__ptext {
		font-size: 11px;
		fill: var(--sl-color-white);
	}
	.hyd__arr {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>

<script>
	import { el, loop } from '../g7/kit';

	const SURF = 62;
	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-hydro]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const p1 = q<SVGPathElement>('[data-path1]');
		const p2 = q<SVGPathElement>('[data-path2]');
		const wire = q<SVGPathElement>('[data-wire]');
		const L1 = p1.getTotalLength();
		const L2 = p2.getTotalLength();
		const LW = wire.getTotalLength();
		const drops = q<SVGGElement>('[data-drops]');
		const blades = q<SVGGElement>('[data-blades]');
		const rotor = q<SVGGElement>('[data-rotor]');
		const pulses = q<SVGGElement>('[data-pulses]');
		// the blades and the coils, as lines on a cylinder about the vertical shaft
		const NB = 8;
		const bl = Array.from({ length: NB }, () => blades.appendChild(el('line', { class: 'hyd__blade', y1: 194, y2: 206 })));
		const co = Array.from({ length: 6 }, () => rotor.appendChild(el('line', { class: 'hyd__coil', y1: 142, y2: 164 })));
		// the water: particles in the penstock (s along it) and after the turbine
		const N1 = 16;
		const N2 = 6;
		const d1 = Array.from({ length: N1 }, (_, i) => ({ s: (i / N1) * L1, e: drops.appendChild(el('circle', { class: 'hyd__drop', r: 1.8 })) }));
		const d2 = Array.from({ length: N2 }, (_, i) => ({ s: (i / N2) * L2, e: drops.appendChild(el('circle', { class: 'hyd__drop', r: 1.8 })) }));
		const NP = 5;
		const pw = Array.from({ length: NP }, (_, i) => ({ s: (i / NP) * LW, e: pulses.appendChild(el('circle', { class: 'hyd__pulse', r: 2 })) }));
		let phi = 0;

		loop(root, (dt) => {
			for (const d of d1) {
				const p = p1.getPointAtLength(d.s);
				// the speed grows as the square root of the drop below the surface of the reservoir
				const v = 6 + 9 * Math.sqrt(Math.max(0, p.y - SURF - 60));
				d.s += v * dt;
				if (d.s > L1) d.s -= L1;
				const pp = p1.getPointAtLength(d.s);
				d.e.setAttribute('cx', f1(pp.x));
				d.e.setAttribute('cy', f1(pp.y));
			}
			for (const d of d2) {
				d.s += 12 * dt;
				if (d.s > L2) d.s -= L2;
				const pp = p2.getPointAtLength(d.s);
				d.e.setAttribute('cx', f1(pp.x));
				d.e.setAttribute('cy', f1(pp.y));
			}
			for (const d of pw) {
				d.s += 70 * dt;
				if (d.s > LW) d.s -= LW;
				const pp = wire.getPointAtLength(d.s);
				d.e.setAttribute('cx', f1(pp.x));
				d.e.setAttribute('cy', f1(pp.y));
			}
			phi += 3 * dt;
			bl.forEach((b, i) => {
				const a = phi + (i * 2 * Math.PI) / NB;
				const x = 250 + 19 * Math.sin(a);
				b.setAttribute('x1', f1(x));
				b.setAttribute('x2', f1(x + 4 * Math.cos(a)));
				b.style.opacity = Math.cos(a) > 0 ? '1' : '0.25';
			});
			co.forEach((b, i) => {
				const a = phi + (i * 2 * Math.PI) / co.length;
				const x = 250 + 21 * Math.sin(a);
				b.setAttribute('x1', f1(x));
				b.setAttribute('x2', f1(x));
				b.style.opacity = Math.cos(a) > 0 ? '1' : '0';
			});
			return true;
		});
	}
</script>
