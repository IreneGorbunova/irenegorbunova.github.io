---
/**
 * Picture «Энергия упругой деформации», two panels with energy bars (the colors of BouncePicture: green — elastic
 * deformation, red — kinetic, blue — potential).
 *   Сжатая пружина: a toy launcher. A spring of stiffness 400 Н/м is held squashed by 5 см by a catch: it stores
 *     400 · 0,05² / 2 = 0,50 Дж. The catch opens, the spring straightens and throws up a ball of 50 г; the ball rises
 *     0,50 Дж / (9,8 Н/кг · 0,05 кг) = 1,02 м above where it lay, falls back on the plate, squashes the spring by the
 *     same 5 см, and the catch closes. Friction and air are neglected, so the sum stays 0,50 Дж. 170 px per metre.
 *     The push of the spring (0,018 с) is slowed 20 times, the flight twice.
 *   Натянутый лук: the boy of the opening scene (1,25 м, 120 px per metre, twice the scale of the scene) draws the
 *     string of the same toy bow by 30 см. The bow is taken as a spring of 17,6 Н/м: it stores 17,6 · 0,3² / 2 =
 *     0,79 Дж, and gives an arrow of 20 г the speed √(2 · 0,79 / 0,02) = 8,9 м/с, as in the scene. The string comes
 *     back in 0,053 с; the release and the flight are slowed 10 times. The bars stop when the arrow has left the
 *     string (its slight fall in flight is computed but not counted in the bars).
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const sBars = [
	{ key: 'e', name: 'пружины', y: 52 },
	{ key: 'k', name: 'кинетическая', y: 86 },
	{ key: 'p', name: 'потенциальная', y: 120 },
];
const bBars = [
	{ key: 'e', name: 'лука', y: 52 },
	{ key: 'k', name: 'стрелы', y: 86 },
];
const BX = 96;
const BW = 136;
// the spring launcher
const FLOOR = 244;
const SX = 60;
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--pic ela not-content" data-elastic>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 240 260" role="img" aria-label="Сжатая пружина распрямляется и подбрасывает шарик на метр вверх; полоски показывают энергию пружины, кинетическую и потенциальную энергию шарика" data-spring>
			<text class="t-title" x="8" y="16">Сжатая пружина</text>
			<rect class="ela__floor" x="0" y={FLOOR} width="240" height={260 - FLOOR}></rect>
			<!-- the height above the place where the ball lay -->
			{[0, 0.5, 1].map((m) => (
				<>
					<line class="ln" x1="26" x2="32" y1={216 - m * 170} y2={216 - m * 170} />
					<text class="t-small t-num" x="23" y={216 - m * 170 + 4} text-anchor="end">{String(m).replace('.', ',')}</text>
				</>
			))}
			<line class="ln" x1="32" x2="32" y1={216 - 170} y2="216"></line>
			<text class="t-small" x="36" y={216 - 170 + 4}>м</text>
			<line class="ln-dash" x1="30" x2="88" y1={216 - 1.02 * 170} y2={216 - 1.02 * 170}></line>
			<!-- the launcher -->
			<rect class="ela__base" x={SX - 26} y={FLOOR - 8} width="52" height="8" rx="2"></rect>
			<rect class="ela__tube" x={SX - 12} y="176" width="24" height={FLOOR - 8 - 176}></rect>
			<path class="ela__spring" data-coil></path>
			<rect class="ela__plate" x={SX - 11} width="22" height="3" rx="1" data-plate></rect>
			<path class="ela__tubeedge" d={`M${SX - 12} 176 V${FLOOR - 8} M${SX + 12} 176 V${FLOOR - 8}`}></path>
			<path class="ela__catch" data-catch></path>
			<circle class="ela__ball" r="6.8" cx={SX} data-ball></circle>
			<text class="t-small" x={SX + 30} y="232" data-sq></text>
			{
				sBars.map((b) => (
					<g>
						<text class="t-small" x={BX} y={b.y - 5}>
							{b.name}
						</text>
						<rect class="ela__slot" x={BX} y={b.y} width={BW} height="11" rx="3" />
						<rect class={`ela__bar ela__bar--${b.key}`} x={BX} y={b.y} width="0" height="11" rx="3" data-bar={b.key} />
						<text class={`t-small t-num ela__v--${b.key}`} x={BX + BW} y={b.y - 5} text-anchor="end" data-v={b.key} />
					</g>
				))
			}
			<text class="t-small" x={BX} y="30">энергия:</text>
			<text class="t-small" x={BX} y="152">сумма 0,50 Дж</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 240 260" role="img" aria-label="Мальчик натягивает тетиву лука и отпускает её: лук разгоняет стрелу; полоски показывают энергию лука и энергию стрелы" data-bow>
			<text class="t-title" x="8" y="16">Натянутый лук</text>
			<rect class="ela__floor" x="0" y="240" width="240" height="20"></rect>
			<g data-boy></g>
			<path class="ela__bow" data-limbs></path>
			<path class="ela__string" data-string></path>
			<g data-arrow>
				<path class="ela__shaft" d="M-54 0 H0 M-54 0 l-8 -5 M-54 0 l-8 5 M-48 0 l-8 -5 M-48 0 l-8 5"></path>
				<path class="ela__tip" d="M4 0 L-9 -4.5 V4.5 Z"></path>
			</g>
			<text class="t-small" x={BX} y="30">энергия:</text>
			<text class="t-small" x="8" y="254" data-draw></text>
			{
				bBars.map((b) => (
					<g>
						<text class="t-small" x={BX} y={b.y - 5}>
							{b.name}
						</text>
						<rect class="ela__slot" x={BX} y={b.y} width={BW} height="11" rx="3" />
						<rect class={`ela__bar ela__bar--${b.key}`} x={BX} y={b.y} width="0" height="11" rx="3" data-bar={b.key} />
						<text class={`t-small t-num ela__v--${b.key}`} x={BX + BW} y={b.y - 5} text-anchor="end" data-v={b.key} />
					</g>
				))
			}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Распрямляясь, пружина и лук совершают работу: разгоняют шарик и стрелу. Толчок пружины замедлен в 20 раз, полёт шарика — в 2 раза, выстрел из лука — в 10 раз.
	</figcaption>
</figure>

<style is:global>
	.ela__floor {
		fill: var(--g7-ground);
	}
	.ela__base {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
	}
	.ela__tube {
		fill: var(--g7-glass);
		opacity: 0.35;
	}
	.ela__tubeedge {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.ela__spring {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.ela__plate {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.ela__catch {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ela__ball {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.ela__slot {
		fill: var(--g7-faint);
		opacity: 0.6;
	}
	.ela__bar--e {
		fill: var(--g7-green);
	}
	.ela__bar--k {
		fill: var(--g7-red);
	}
	.ela__bar--p {
		fill: var(--g7-blue);
	}
	.g7__svg .ela__v--e {
		fill: var(--g7-green);
	}
	.g7__svg .ela__v--k {
		fill: var(--g7-red);
	}
	.g7__svg .ela__v--p {
		fill: var(--g7-blue);
	}
	.ela__bow {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-3));
		stroke-width: 4.5;
		stroke-linecap: round;
	}
	.ela__string {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.ela__shaft {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.ela__tip {
		fill: var(--g7-red);
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';
	import { human } from '../mehanicheskaya-rabota/people';

	const f1 = (v: number) => v.toFixed(1);
	const g = 9.8;

	// —— the spring launcher ——
	for (const svg of document.querySelectorAll<SVGSVGElement>('[data-elastic] [data-spring]')) {
		const q = <T extends Element>(s: string) => svg.querySelector<T>(s)!;
		const SX = 60;
		const BASE = 236; // the bottom of the spring
		const K = 170; // px per metre
		const k = 400;
		const m = 0.05;
		const X0 = 0.05; // the squash
		const L0 = 0.15; // the free length of the spring
		const R = 0.04; // м: the ball, 4 см across
		const E0 = (k * X0 * X0) / 2;
		const bars = { e: q('[data-bar="e"]'), k: q('[data-bar="k"]'), p: q('[data-bar="p"]') };
		const vals = { e: q('[data-v="e"]'), k: q('[data-v="k"]'), p: q('[data-v="p"]') };
		// y: the height of the ball's bottom above where it lies on the squashed spring (м); v: up +
		let phase: 'hold' | 'push' | 'fly' | 'press' = 'hold';
		let t = 0;
		let y = 0;
		let v = 0;
		const draw = () => {
			const c = phase === 'fly' ? 0 : X0 - y; // the squash
			const top = BASE - (L0 - c) * K; // the top of the spring
			const n = 9;
			let d = `M${SX} ${BASE}`;
			for (let i = 1; i <= n; i++) d += ` L${SX + (i % 2 ? -8 : 8)} ${f1(BASE - ((L0 - c) * K * (i - 0.5)) / n)}`;
			d += ` L${SX} ${f1(top)}`;
			q('[data-coil]').setAttribute('d', d);
			q('[data-plate]').setAttribute('y', f1(top - 3));
			const ballY = BASE - L0 * K + X0 * K - 3 - y * K; // the ball's bottom
			q('[data-ball]').setAttribute('cy', f1(ballY - (R / 2) * K));
			// the catch: a hook over the plate's edge, swung away when open
			const open = phase === 'push' || phase === 'fly' ? 1 : 0;
			const py = BASE - (L0 - X0) * K - 3;
			q('[data-catch]').setAttribute('d', open ? `M${SX + 22} ${f1(py + 10)} L${SX + 22} ${f1(py - 6)} L${SX + 17} ${f1(py - 8)}` : `M${SX + 22} ${f1(py + 10)} L${SX + 22} ${f1(py - 2)} L${SX + 8} ${f1(py - 2)}`);
			q('[data-sq]').textContent = phase === 'hold' ? 'сжата на 5 см' : '';
			const Ee = (k * c * c) / 2;
			const Ek = (m * v * v) / 2;
			const Ep = m * g * y;
			const E = { e: Ee, k: Ek, p: Ep };
			for (const key of ['e', 'k', 'p'] as const) {
				bars[key].setAttribute('width', f1((136 * Math.max(0, E[key])) / E0));
				vals[key].textContent = `${fmt(Math.max(0, E[key]), 2)}\u00a0Дж`;
			}
		};
		const contact = (rdt: number) => {
			const steps = 20;
			const h = rdt / steps;
			for (let i = 0; i < steps; i++) {
				const a = (k * (X0 - y)) / m - g;
				v += a * h;
				y += v * h;
			}
		};
		loop(svg, (dt) => {
			t += dt;
			if (phase === 'hold') {
				if (t > 1.3) (phase = 'push'), (t = 0);
			} else if (phase === 'push') {
				contact(dt / 20);
				if (y >= X0) phase = 'fly';
			} else if (phase === 'fly') {
				const rdt = dt / 2;
				v -= g * rdt;
				y += v * rdt;
				if (y <= X0 && v < 0) phase = 'press';
			} else {
				contact(dt / 20);
				if (v >= 0) (y = 0), (v = 0), (phase = 'hold'), (t = 0);
			}
			draw();
			return true;
		});
		draw();
	}

	// —— the bow ——
	for (const svg of document.querySelectorAll<SVGSVGElement>('[data-elastic] [data-bow]')) {
		const q = <T extends Element>(s: string) => svg.querySelector<T>(s)!;
		const S = 1.2; // px per см
		const H = 125;
		const u = S * H;
		const GR = 240;
		const AY = GR - 100 * S; // the arrow, 1 м above the ground
		const GRIP = 99; // where the hand holds the bow
		const REST = 80; // the string at rest
		const kb = 17.6;
		const ma = 0.02;
		const D = 0.3;
		const E0 = (kb * D * D) / 2;
		const w = Math.sqrt(kb / ma);
		const boy = human(q<SVGGElement>('[data-boy]'), { s: S, H, shirt: 'hm-blue', hair: 'short', shorts: true });
		const ank = GR - 7 * (H / 172) * S;
		const bars = { e: q('[data-bar="e"]'), k: q('[data-bar="k"]') };
		const vals = { e: q('[data-v="e"]'), k: q('[data-v="k"]') };
		const arrow = q<SVGGElement>('[data-arrow]');
		let phase: 'rest' | 'draw' | 'aim' | 'shoot' | 'fly' = 'rest';
		let t = 0;
		let c = 0; // м, how far the string is drawn
		let ax = 0; // px, how far the arrow has flown past the string at rest
		let ay = 0;
		let va = 0;
		const draw = () => {
			const dpx = c * 100 * S; // the string's travel: 30 см → 36 px
			const tipX = REST - 0.25 * dpx;
			q('[data-limbs]').setAttribute('d', `M${f1(tipX)} ${f1(AY - 44)} Q${GRIP + 6} ${f1(AY - 22)} ${GRIP} ${AY} Q${GRIP + 6} ${f1(AY + 22)} ${f1(tipX)} ${f1(AY + 44)}`);
			q('[data-string]').setAttribute('d', `M${f1(tipX)} ${f1(AY - 44)} L${f1(REST - dpx)} ${AY} L${f1(tipX)} ${f1(AY + 44)}`);
			boy({
				hip: { x: 40, y: GR - 0.52 * u },
				lean: -0.04,
				ankles: [
					{ x: 60, y: ank },
					{ x: 24, y: ank },
				],
				feet: [0, 0],
				hands: [
					{ x: REST - dpx - 3, y: AY },
					{ x: GRIP + 1, y: AY },
				],
			});
			const flying = phase === 'fly';
			arrow.style.opacity = phase === 'rest' && t > 0.6 ? '0' : '1';
			arrow.setAttribute('transform', flying ? `translate(${f1(REST + 56 + ax)} ${f1(AY + ay)})` : `translate(${f1(REST + 56 - dpx)} ${AY})`);
			const Ee = (kb * c * c) / 2;
			const Ek = flying ? E0 : (ma * va * va) / 2;
			const E = { e: Ee, k: Ek };
			for (const key of ['e', 'k'] as const) {
				bars[key].setAttribute('width', f1((136 * E[key]) / E0));
				vals[key].textContent = `${fmt(E[key], 2)}\u00a0Дж`;
			}
			q('[data-draw]').textContent = c > 0.005 ? `тетива оттянута на ${Math.round(c * 100)}\u00a0см` : '';
		};
		loop(svg, (dt) => {
			t += dt;
			if (phase === 'rest') {
				if (t > 0.9) (phase = 'draw'), (t = 0), (va = 0), (ax = 0), (ay = 0);
			} else if (phase === 'draw') {
				c = D * Math.min(1, t / 1.4);
				if (t >= 1.4) (phase = 'aim'), (t = 0);
			} else if (phase === 'aim') {
				if (t > 0.8) (phase = 'shoot'), (t = 0);
			} else if (phase === 'shoot') {
				const rt = t / 10;
				c = Math.max(0, D * Math.cos(w * rt));
				va = w * D * Math.sin(Math.min(Math.PI / 2, w * rt));
				if (w * rt >= Math.PI / 2) (c = 0), (phase = 'fly'), (t = 0);
			} else {
				const rt = t / 10;
				ax = 8.9 * rt * 100 * S;
				ay = 4.9 * rt * rt * 100 * S;
				if (ax > 260) (phase = 'rest'), (t = 0);
			}
			draw();
			return true;
		});
		draw();
	}
</script>
