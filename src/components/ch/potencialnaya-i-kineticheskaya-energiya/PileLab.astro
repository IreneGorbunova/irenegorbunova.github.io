---
/**
 * «Копёр»: a weight (100…500 кг) is lifted to a height (0,5…3 м) above a pile and dropped. The ground resists the
 * pile with a constant force of 100 кН, so the pile goes down until the work against this force equals the work
 * spent on lifting the weight: depth = g·m·h / 100 000 Н (0,5…14,7 см). The extra descent of the weight together
 * with the pile adds less than 5 % and is neglected. The fall is played in real time; the picture is to scale,
 * 50 px per metre; the depth is also shown on a ruler in centimetres (12 px per centimetre).
 */
import G7Styles from '../g7/G7Styles.astro';

const G = 250; // the ground
const TOP = 200; // the top of the pile before the blow: 1 м above the ground
const M = 50;
const R0 = 60; // the ruler: where 0 см is
const CM = 12;
---

<G7Styles />
<figure class="g7 pil not-content" data-pil>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 320 320" role="img" aria-label="Груз копра падает на сваю и вбивает её в грунт; справа линейка показывает, на сколько сантиметров ушла свая" data-svg>
			<rect class="pil__ground" x="0" y={G} width="320" height="70"></rect>
			<path class="pil__frame" d={`M66 ${G} V8 H174 V${G}`}></path>
			<g data-pile>
				<rect class="pil__pile" x="109" y="0" width="22" height="130"></rect>
			</g>
			<line class="ln-dash" x1="92" x2="148" y1={TOP} y2={TOP}></line>
			<rect class="pil__weight" data-weight x="92" width="56" rx="3"></rect>
			{[0, 1, 2, 3].map((m) => (
				<>
					<line class="ln" x1="178" x2="186" y1={TOP - m * M} y2={TOP - m * M} />
					<text class="t-small t-num" x="190" y={TOP - m * M + 4}>{m} м</text>
				</>
			))}
			<text class="t-small" x="282" y="44" text-anchor="middle">глубина, см</text>
			<line class="ln" x1="270" x2="270" y1={R0} y2={R0 + 15 * CM}></line>
			{Array.from({ length: 16 }, (_, c) => (
				<>
					<line class="ln" x1={c % 5 === 0 ? 261 : 265} x2="270" y1={R0 + c * CM} y2={R0 + c * CM} />
					{c % 5 === 0 && <text class="t-small t-num" x="257" y={R0 + c * CM + 4} text-anchor="end">{c}</text>}
				</>
			))}
			<g data-ptr>
				<path class="pil__ptr" d="M272 0 l9 -5 v10 Z"></path>
				<text class="t-strong t-num" x="284" y="4" data-pv></text>
			</g>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Масса груза</span>
				<output data-om></output>
				<input type="range" min="100" max="500" step="100" value="200" data-m aria-label="Масса груза, килограммы" />
			</label>
			<label class="g7__slider">
				<span>Высота груза над сваей</span>
				<output data-oh></output>
				<input type="range" min="0.5" max="3" step="0.5" value="1.5" data-h aria-label="Высота груза над сваей, метры" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Отпустить груз</button>
			<ul class="g7__read" aria-live="polite">
				<li><span>Работа, затраченная на подъём груза</span><b data-a0></b></li>
				<li class="is-key"><span>Свая ушла в грунт на</span><b data-d></b></li>
				<li class="is-key"><span>Работа груза при ударе</span><b data-a1></b></li>
			</ul>
			<ul class="g7__read" data-log aria-label="Прошлые удары"></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Грунт сопротивляется свае с постоянной силой 100&nbsp;кН. Работа груза при ударе равна этой силе, умноженной на глубину, на которую ушла свая. Прошлые удары записываются в список.
	</figcaption>
</figure>

<style is:global>
	.pil__ground {
		fill: var(--g7-ground);
	}
	.pil__frame {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 3;
	}
	.pil__pile {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.pil__weight {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pil__ptr {
		fill: var(--g7-blue);
	}
</style>

<script>
	import { fmt, fmtInt, loop } from '../g7/kit';

	const TOP = 200;
	const M = 50;
	const R0 = 60;
	const CM = 12;
	const RES = 100000; // Н
	for (const root of document.querySelectorAll<HTMLElement>('[data-pil]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const mIn = q<HTMLInputElement>('[data-m]');
		const hIn = q<HTMLInputElement>('[data-h]');
		const weight = q<SVGRectElement>('[data-weight]');
		const pile = q<SVGGElement>('[data-pile]');
		const log = q<HTMLUListElement>('[data-log]');
		let t = -1;
		const params = () => {
			const m = Number(mIn.value);
			const h = Number(hIn.value);
			const E = 9.8 * m * h;
			return { m, h, E, depth: E / RES };
		};
		/** `time` < 0: before the blow; returns true when the pile has stopped. */
		const draw = (time: number) => {
			const { m, h, E, depth } = params();
			const size = 12 + m * 0.04; // px: how tall the weight is drawn
			const tFall = Math.sqrt((2 * h) / 9.8);
			let fallen = 0;
			let sunk = 0;
			if (time >= 0) {
				fallen = Math.min(h, 4.9 * time * time);
				// after the blow the pile and the weight go down together and stop within a quarter of a second
				if (time > tFall) sunk = depth * Math.min(1, (time - tFall) / 0.25);
			}
			const done = time >= tFall + 0.25;
			weight.setAttribute('height', size.toFixed(1));
			weight.setAttribute('y', (TOP - h * M - size + (fallen + sunk) * M).toFixed(1));
			pile.setAttribute('transform', `translate(0 ${(TOP + sunk * M).toFixed(1)})`);
			q('[data-ptr]').setAttribute('transform', `translate(0 ${(R0 + sunk * 100 * CM).toFixed(1)})`);
			q('[data-pv]').textContent = done ? fmt(depth * 100, 2) : '';
			q('[data-om]').textContent = `${m} кг`;
			q('[data-oh]').textContent = `${fmt(h, 1)} м`;
			q('[data-a0]').textContent = `${fmtInt(E)} Дж`;
			q('[data-d]').textContent = done ? `${fmt(depth * 100, 2)} см` : '—';
			q('[data-a1]').textContent = done ? `${fmtInt(E)} Дж` : '—';
			return time > tFall + 0.3;
		};
		const wake = loop(root, (dt) => {
			if (t < 0) return false;
			t += dt;
			if (draw(t)) {
				const { m, h, depth } = params();
				const key = `${m}-${h}`;
				if (!log.querySelector(`[data-key="${key}"]`)) {
					const li = document.createElement('li');
					li.dataset.key = key;
					li.innerHTML = `<span>${m} кг с высоты ${fmt(h, 1)} м</span><b>${fmt(depth * 100, 2)} см</b>`;
					log.prepend(li);
					while (log.children.length > 4) log.lastElementChild!.remove();
				}
				t = -1;
				return false;
			}
			return true;
		});
		q('[data-go]').addEventListener('click', () => {
			t = 0;
			draw(0);
			wake();
		});
		for (const i of [mIn, hIn])
			i.addEventListener('input', () => {
				t = -1;
				draw(-1);
			});
		draw(-1);
	}
</script>
