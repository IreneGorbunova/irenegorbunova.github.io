---
/**
 * Two short looping opening scenes of «Потенциальная и кинетическая энергия». No terms of the chapter in the
 * pictures.
 * Swing: a girl on a swing 2,5 м long that is let go 0,9 м above its lowest point (50 px per metre). The motion is
 *   that of a real pendulum, θ″ = −(g/L)·sin θ, in real time, two full swings (about 6,7 с). Two counters: the
 *   height above the lowest point and the speed (0,9 м ↔ 4,2 м/с).
 * Bow: a child shoots a toy bow level, 1 м above the ground (60 px per metre). The string is drawn by 15 см and the
 *   arrow leaves at 4,4 м/с; then by 30 см, and it leaves at 8,9 м/с (the bow as a spring: the energy grows as the
 *   draw squared, the speed as the draw). The arrows fly as thrown bodies and land 2 м and 4 м away. The clock of
 *   the flights runs twice slower than a real one.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-enintro>
	<div class="intro__card" data-scene="swing">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка качается на качелях. Счётчики показывают высоту качелей над нижней точкой и их скорость">
			<rect class="en-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="en-grass" x="0" y="183" width="360" height="57"></rect>
			<path class="en-frame" d="M180 28 L132 183 M180 28 L228 183"></path>
			<line class="en-level" x1="70" x2="318" y1="153" y2="153"></line>
			<line class="en-level" x1="70" x2="318" y1="108" y2="108"></line>
			<path class="en-dim" d="M306 110 V151 M302 116 L306 109 L310 116 M302 145 L306 152 L310 145"></path>
			<text class="en-small" x="314" y="134">0,9 м</text>
			<g data-swing>
				<line class="en-rope" x1="0" y1="0" x2="0" y2="125"></line>
				<rect class="en-seat" x="-13" y="123" width="26" height="4" rx="1.5"></rect>
				<path class="en-dress" d="M-7 122 L-4 100 L3 100 L9 122 Z"></path>
				<path class="en-limb" d="M2 121 L16 120 L19 135"></path>
				<path class="en-limb" d="M-1 103 L5 109 L0 106"></path>
				<circle class="en-head" cx="-1" cy="92" r="7"></circle>
				<path class="en-hair" d="M-8 92 a7 7 0 0 1 12 -5 l-5 1 q-6 2 -5 12 q-3 -3 -2 -8"></path>
			</g>
			<circle class="en-pivot" cx="180" cy="28" r="3.5"></circle>
			<rect class="en-pill" x="10" y="10" width="104" height="46" rx="10"></rect>
			<text class="en-small" x="20" y="27">высота</text>
			<text class="en-num" x="20" y="46" data-h>0,90 м</text>
			<rect class="en-pill" x="246" y="10" width="104" height="46" rx="10"></rect>
			<text class="en-small" x="256" y="27">скорость</text>
			<text class="en-num" x="256" y="46" data-v>0,0 м/с</text>
		</svg>
		<div class="intro__foot">
			<p>
				Качели то взлетают, то несутся вниз.{' '}
				<More term="Чем ниже они опускаются, тем быстрее летят">
					Опустившись на 0,9&nbsp;м, качели разгоняются до 4,2&nbsp;м/с, а поднимаясь, снова теряют скорость. Высота будто превращается в скорость, а скорость — снова в высоту. На самом деле друг в друга превращаются два вида энергии. Об этом — в разделе{' '}
					<a href="#превращения-энергии">«Превращения энергии»</a>.
				</More>, а чем выше поднимаются — тем медленнее.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="bow">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ребёнок стреляет из игрушечного лука: сначала тетива оттянута слабо, и стрела падает близко; потом вдвое сильнее, и стрела улетает вдвое дальше">
			<rect class="en-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="en-grass" x="0" y="205" width="360" height="35"></rect>
			{[0, 1, 2, 3, 4].map((m) => (
				<>
					<line class="en-tick" x1={77 + m * 60} x2={77 + m * 60} y1="205" y2="211" />
					<text class="en-small" x={77 + m * 60} y="224" text-anchor="middle">{m}{m === 4 ? ' м' : ''}</text>
				</>
			))}
			<!-- the child: 1,3 м tall -->
			<path class="en-limb" d="M34 172 L28 205 M34 172 L41 205"></path>
			<path class="en-shirt" d="M29 142 H39 L41 173 H27 Z"></path>
			<circle class="en-head" cx="34" cy="134" r="7"></circle>
			<path class="en-limb" data-arm1 d="M34 147 L58 145"></path>
			<path class="en-limb" data-arm2></path>
			<path class="en-bow" data-bow></path>
			<path class="en-string" data-string></path>
			<g data-arrow="1">
				<path class="en-arrow" d="M-27 0 H0 M-27 0 l-5 -3 M-27 0 l-5 3"></path>
				<path class="en-tip" d="M2 0 L-6 -3 V3 Z"></path>
			</g>
			<g data-arrow="2">
				<path class="en-arrow" d="M-27 0 H0 M-27 0 l-5 -3 M-27 0 l-5 3"></path>
				<path class="en-tip" d="M2 0 L-6 -3 V3 Z"></path>
			</g>
			<rect class="en-pill" x="186" y="10" width="164" height="84" rx="10"></rect>
			<text class="en-small" x="198" y="28">тетива оттянута на</text>
			<text class="en-num" x="198" y="46" data-d>0 см</text>
			<text class="en-small" x="198" y="66">стрела пролетела</text>
			<text class="en-num" x="198" y="84" data-r>0 м</text>
		</svg>
		<div class="intro__foot">
			<p>
				Натянутый лук неподвижен, но{' '}
				<More term="он уже может совершить работу">
					Когда тетиву отпускают, лук разгоняет стрелу — совершает работу. Про тело, которое может совершить работу, говорят, что оно обладает энергией. Чем сильнее натянута тетива, тем больше энергии запасено в луке и тем быстрее вылетает стрела. Об этом — в разделе{' '}
					<a href="#энергия">«Энергия»</a>.
				</More>: разогнать стрелу. Чем сильнее оттянута тетива, тем дальше летит стрела.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-enintro] .en-sky {
		fill: var(--sl-color-bg);
	}
	[data-enintro] .en-grass {
		fill: color-mix(in oklab, hsl(110, 45%, 45%) 30%, var(--sl-color-gray-5));
	}
	[data-enintro] .en-frame {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-enintro] .en-pivot {
		fill: var(--sl-color-gray-1);
	}
	[data-enintro] .en-level {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	[data-enintro] .en-dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-enintro] .en-rope {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
	}
	[data-enintro] .en-seat {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
		stroke: hsl(28, 50%, 26%);
		stroke-width: 0.8;
	}
	[data-enintro] .en-dress {
		fill: var(--ig-vy);
	}
	[data-enintro] .en-shirt {
		fill: var(--ig-vx);
	}
	[data-enintro] .en-limb {
		fill: none;
		stroke: hsl(26, 45%, 62%);
		stroke-width: 3.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-enintro] .en-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-enintro] .en-hair {
		fill: hsl(28, 50%, 26%);
	}
	[data-enintro] .en-pill {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-enintro] .en-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-enintro] .en-num {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	[data-enintro] .en-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-enintro] .en-bow {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-3));
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-enintro] .en-string {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-enintro] .en-arrow {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	[data-enintro] .en-tip {
		fill: var(--ig-vy);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	const comma = (v: number, d: number) => v.toFixed(d).replace('.', ',');
	for (const root of document.querySelectorAll<HTMLElement>('[data-enintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="swing"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const swing = $<SVGGElement>('[data-swing]');
			const hText = $<SVGTextElement>('[data-h]');
			const vText = $<SVGTextElement>('[data-v]');
			// the motion of a real pendulum, tabulated: θ″ = −(g/L)·sin θ, from rest 0,9 м above the lowest point
			const L = 2.5;
			const G = 9.8;
			const DT = 1 / 400;
			const acc = (a: number) => -(G / L) * Math.sin(a);
			const ths: number[] = [];
			const oms: number[] = [];
			let th = -Math.acos(1 - 0.9 / L);
			let om = 0;
			let turns = 0; // how many times the swing has stopped at the far point and at the start point
			while (turns < 4 && ths.length < 8000) {
				ths.push(th);
				oms.push(om);
				const k1a = om;
				const k1w = acc(th);
				const k2a = om + 0.5 * DT * k1w;
				const k2w = acc(th + 0.5 * DT * k1a);
				const k3a = om + 0.5 * DT * k2w;
				const k3w = acc(th + 0.5 * DT * k2a);
				const k4a = om + DT * k3w;
				const k4w = acc(th + DT * k3a);
				const before = om;
				th += (DT / 6) * (k1a + 2 * k2a + 2 * k3a + k4a);
				om += (DT / 6) * (k1w + 2 * k2w + 2 * k3w + k4w);
				if (before !== 0 && Math.sign(before) !== Math.sign(om)) turns++;
			}
			const run = (ths.length - 1) * DT; // two full swings
			scene(card, run, (x) => {
				const i = Math.min(ths.length - 1, Math.round((x * run) / DT));
				const a = ths[i];
				swing.setAttribute('transform', `translate(180 28) rotate(${((-a * 180) / Math.PI).toFixed(2)})`);
				hText.textContent = `${comma(L * (1 - Math.cos(a)), 2)} м`;
				vText.textContent = `${comma(L * Math.abs(oms[i]), 1)} м/с`;
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bow"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const arm2 = $<SVGPathElement>('[data-arm2]');
			const bow = $<SVGPathElement>('[data-bow]');
			const string = $<SVGPathElement>('[data-string]');
			const a1 = $<SVGGElement>('[data-arrow="1"]');
			const a2 = $<SVGGElement>('[data-arrow="2"]');
			const dText = $<SVGTextElement>('[data-d]');
			const rText = $<SVGTextElement>('[data-r]');
			const RUN = 6;
			const PX = 60;
			const TF = Math.sqrt((2 * 1) / 9.8); // с: the fall from 1 м
			// the two shots: when the drawing starts, when the string is let go (scene seconds), the draw (px), the speed
			const shots = [
				{ from: 0.3, go: 1.4, d: 9, v: 2 / TF },
				{ from: 2.9, go: 4.3, d: 18, v: 4 / TF },
			];
			/** Where the tip of the arrow is and how it is turned, `tau` real seconds after it left the string. */
			const flight = (v: number, tau: number) => {
				const t = Math.min(tau, TF);
				return { x: 77 + v * t * PX, y: 145 + 4.9 * t * t * PX, turn: (Math.atan2(9.8 * t, v) * 180) / Math.PI, r: v * t };
			};
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const now = t < 2.6 ? 0 : 1; // which shot is being made
				const s = shots[now];
				let d = 0; // how far the string is drawn now, px
				if (t >= s.from && t < s.go) d = s.d * clamp((t - s.from) / (s.go - s.from - 0.3));
				else if (t >= s.go) d = s.d * (1 - clamp((t - s.go) / 0.05));
				const tip = 50 - 0.25 * d;
				bow.setAttribute('d', `M${tip.toFixed(1)} 123 Q61 134 58 145 Q61 156 ${tip.toFixed(1)} 167`);
				string.setAttribute('d', `M${tip.toFixed(1)} 123 L${(50 - d).toFixed(1)} 145 L${tip.toFixed(1)} 167`);
				arm2.setAttribute('d', `M34 147 L${(38 - 0.7 * d).toFixed(1)} 153 L${(50 - d).toFixed(1)} 145`);
				const place = (g: SVGGElement, shot: (typeof shots)[number], shown: boolean) => {
					g.style.opacity = shown ? '1' : '0';
					if (t < shot.go + 0.05) {
						const dd = shot === s ? d : 0;
						g.setAttribute('transform', `translate(${(77 - dd).toFixed(1)} 145)`);
						return 0;
					}
					const f = flight(shot.v, (t - shot.go - 0.05) / 2);
					g.setAttribute('transform', `translate(${f.x.toFixed(1)} ${f.y.toFixed(1)}) rotate(${f.turn.toFixed(1)})`);
					return f.r;
				};
				const r1 = place(a1, shots[0], true);
				const r2 = place(a2, shots[1], t >= 2.6);
				dText.textContent = `${Math.round(((t >= s.go ? s.d : d) / PX) * 100)} см`;
				rText.textContent = `${comma(now ? r2 : r1, 1)} м`;
			});
		}
	}
</script>
