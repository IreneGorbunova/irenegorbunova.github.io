---
/**
 * Picture «Нулевой уровень»: a book of 0,5 кг lies on a shelf by the window of a room on the first floor above the
 * ground floor. The shelf is 1,5 м above the floor of the room, and the floor is 3 м above the ground outside, so the
 * book is 4,5 м above the ground. Its potential energy: counted from the floor 9,8 · 0,5 · 1,5 = 7,35 Дж; counted from
 * the ground below the window 9,8 · 0,5 · 4,5 = 22,05 Дж. Dotted lines show where it can fall. To scale, 46 px per
 * metre (the book and the window frame are drawn a little larger). Static.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 46;
const GROUND = 246;
const FLOOR = GROUND - 3 * K; // 108
const BOOK = FLOOR - 1.5 * K; // 39: the bottom of the book
const WALL = 198;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow zer not-content" data-zerolevel>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 262" role="img" aria-label="Книга лежит на полке у окна: она на 1,5 метра выше пола комнаты и на 4,5 метра выше земли под окном; относительно пола её потенциальная энергия 7,35 джоуля, относительно земли — 22,05 джоуля">
			<!-- the room and the ground floor below it -->
			<rect class="zer__room" x="0" y="0" width={WALL} height={FLOOR}></rect>
			<rect class="zer__below" x="0" y={FLOOR + 8} width={WALL} height={GROUND - FLOOR - 8}></rect>
			<rect class="zer__slab" x="0" y={FLOOR} width={WALL + 10} height="8"></rect>
			<rect class="zer__ground" x="0" y={GROUND} width="360" height={262 - GROUND}></rect>
			<!-- the wall with the window: the sill 0,9 м above the floor -->
			<rect class="zer__wall" x={WALL} y={FLOOR + 8} width="10" height={GROUND - FLOOR - 8}></rect>
			<rect class="zer__wall" x={WALL} y={FLOOR - 0.9 * K} width="10" height={0.9 * K}></rect>
			<rect class="zer__wall" x={WALL} y="0" width="10" height="4"></rect>
			<path class="zer__frame" d={`M${WALL} 4 H${WALL + 10} M${WALL - 3} ${FLOOR - 0.9 * K} H${WALL + 13}`}></path>
			<text class="t-small t-halo" x={WALL + 14} y="18">окно</text>
			<!-- the shelf and the book -->
			<rect class="zer__shelf" x="132" y={BOOK} width="62" height="4"></rect>
			<path class="zer__bracket" d={`M138 ${BOOK + 4} V${BOOK + 14} L148 ${BOOK + 4} M188 ${BOOK + 4} V${BOOK + 14} L178 ${BOOK + 4}`}></path>
			<rect class="zer__book" x="150" y={BOOK - 9} width="34" height="9" rx="1.5"></rect>
			<path class="zer__pages" d={`M152 ${BOOK - 3} H182 M152 ${BOOK - 6} H182`}></path>
			<text class="t-small t-halo" x="167" y={BOOK - 14} text-anchor="middle">0,5 кг</text>
			<!-- where it can fall -->
			<path class="zer__fall" d={`M150 ${BOOK + 4} V${FLOOR - 2}`}></path>
			<path class="zer__fall" d={`M184 ${BOOK - 4} Q230 ${BOOK - 6} 236 ${BOOK + 30} V${GROUND - 2}`}></path>
			<!-- the two zero levels -->
			<line class="zer__lvl zer__lvl--f" x1="0" x2={WALL} y1={FLOOR} y2={FLOOR}></line>
			<line class="zer__lvl zer__lvl--g" x1={WALL + 10} x2="360" y1={GROUND} y2={GROUND}></line>
			<line class="ln-dash" x1="120" x2="350" y1={BOOK} y2={BOOK}></line>
			<!-- the heights -->
			<path class="zer__dim zer__dim--f" d={`M116 ${BOOK + 1} V${FLOOR - 1} M112 ${BOOK + 7} L116 ${BOOK + 1} L120 ${BOOK + 7} M112 ${FLOOR - 7} L116 ${FLOOR - 1} L120 ${FLOOR - 7}`}></path>
			<text class="t-strong t-num zer__t--f" x="110" y={(BOOK + FLOOR) / 2 + 5} text-anchor="end">1,5 м</text>
			<path class="zer__dim zer__dim--g" d={`M300 ${BOOK + 1} V${GROUND - 1} M296 ${BOOK + 7} L300 ${BOOK + 1} L304 ${BOOK + 7} M296 ${GROUND - 7} L300 ${GROUND - 1} L304 ${GROUND - 7}`}></path>
			<text class="t-strong t-num zer__t--g" x="306" y={(BOOK + GROUND) / 2 - 4}>4,5 м</text>
			<!-- the answers -->
			<text class="t-small" x="8" y={FLOOR + 26}>нулевой уровень — пол:</text>
			<text class="t-strong t-num zer__t--f" x="8" y={FLOOR + 44}><tspan class="zer__e">E</tspan><tspan class="zer__sub" dy="3">п</tspan><tspan dy="-3"> = 7,35 Дж</tspan></text>
			<text class="t-small" x="8" y={FLOOR + 74}>нулевой уровень — земля:</text>
			<text class="t-strong t-num zer__t--g" x="8" y={FLOOR + 92}><tspan class="zer__e">E</tspan><tspan class="zer__sub" dy="3">п</tspan><tspan dy="-3"> = 22,05 Дж</tspan></text>
			<text class="t-small" x="244" y={GROUND - 8}>земля</text>
			<text class="t-small" x="8" y={FLOOR - 6}>пол</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Книга лежит на полке на высоте 1,5&nbsp;м над полом, а пол комнаты на 3&nbsp;м выше земли. Её потенциальная энергия зависит от того, какой уровень выбран нулевым.
	</figcaption>
</figure>

<style is:global>
	.zer__room {
		fill: color-mix(in oklab, var(--ig-v) 6%, var(--g7-paper));
	}
	.zer__below {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 40%, var(--g7-paper));
	}
	.zer__slab,
	.zer__wall {
		fill: var(--g7-steel);
	}
	.zer__ground {
		fill: var(--g7-ground);
	}
	.zer__frame {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.zer__shelf {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
	}
	.zer__bracket {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
	}
	.zer__book {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zer__pages {
		stroke: var(--g7-paper);
		stroke-width: 0.8;
	}
	.zer__fall {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-dasharray: 1.5 3.5;
		stroke-linecap: round;
	}
	.zer__lvl {
		stroke-width: 2;
		stroke-dasharray: 7 4;
	}
	.zer__lvl--f,
	.zer__dim--f {
		stroke: var(--g7-blue);
	}
	.zer__lvl--g,
	.zer__dim--g {
		stroke: var(--g7-gold);
	}
	.zer__dim {
		fill: none;
		stroke-width: 1.4;
	}
	.g7__svg .zer__e {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.g7__svg .zer__sub {
		font-size: 9px;
	}
	.g7__svg .zer__t--f {
		fill: var(--g7-blue);
	}
	.g7__svg .zer__t--g {
		fill: var(--g7-gold);
	}
</style>
