---
/**
 * Model «Когда вода закипает»: the pressure of saturated water vapour p_н(t) from 0 to 130 °C (psat.ts) and a
 * horizontal line of the outside pressure, set by a slider (25–250 кПа) or by the buttons: the top of Everest
 * (8849 м, about 34 кПа), the top of Elbrus (5642 м, about 50 кПа), the sea level (101 кПа), a pressure cooker
 * (about 200 кПа). Water boils where the line meets the curve: 72, 81, 100, 120 °C. A dashed line shows how the
 * pressure of the vapour would grow from 100 °C if it were heated in a closed vessel without water (p ∝ T): far slower.
 */
import G7Styles from '../g7/G7Styles.astro';
import { psat } from './psat';

const X0 = 46;
const X1 = 330;
const Y0 = 236;
const Y1 = 24;
const x = (t: number) => X0 + (t / 130) * (X1 - X0);
const y = (p: number) => Y0 - (p / 250) * (Y0 - Y1);
const curve: string[] = [];
for (let t = 0; t <= 130.001; t += 1) curve.push(`${x(t).toFixed(1)} ${y(psat(t)).toFixed(1)}`);
const p100 = psat(100);
---

<G7Styles />
<figure class="g7 not-content" data-psatlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 270" role="img" aria-label="График давления насыщенного водяного пара от температуры и линия внешнего давления; точка их пересечения — температура кипения">
			<path class="ln" d={`M${X0} ${Y1 - 6} V${Y0} H${X1 + 6}`}></path>
			{[50, 100, 150, 200, 250].map((p) => <g><path class="ln-dash" d={`M${X0} ${y(p)} H${X1}`} /><text class="t-small" x={X0 - 6} y={y(p) + 4} text-anchor="end">{p}</text></g>)}
			{[0, 20, 40, 60, 80, 100, 120].map((t) => <text class="t-small" x={x(t)} y={Y0 + 15} text-anchor="middle">{t}</text>)}
			<text class="t-small" x={X0 + 6} y={Y1 - 10}><tspan class="t-i">p</tspan>, кПа</text>
			<text class="t-small" x={X1 + 4} y={Y0 + 28} text-anchor="end"><tspan class="t-i">t</tspan>, °C</text>
			<path class="ps-ideal" d={`M${x(100)} ${y(p100)} L${x(130)} ${y((p100 * 403) / 373)}`}></path>
			<polyline class="ps-curve" points={curve.join(' ')}></polyline>
			<text class="t-small t-halo" x={x(104)} y={y(170)} text-anchor="end">давление насыщенного пара</text>
			<line class="ps-ext" data-ext x1={X0} x2={X1} y1="0" y2="0"></line>
			<line class="ps-drop" data-drop x1="0" x2="0" y1="0" y2={Y0}></line>
			<circle class="ps-pt" data-pt r="5"></circle>
			<text class="t-strong t-halo" data-lab x="0" y="0"></text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">Внешнее давление <output data-out-p>101 кПа</output><input type="range" min="25" max="250" step="1" value="101" data-p /></label>
			<div class="g7__row" data-places>
				<button type="button" class="g7__btn" data-pp="34">Эверест</button>
				<button type="button" class="g7__btn" data-pp="50">Эльбрус</button>
				<button type="button" class="g7__btn" data-pp="101">У моря</button>
				<button type="button" class="g7__btn" data-pp="200">Скороварка</button>
			</div>
			<ul class="g7__read">
				<li class="is-warm">Вода кипит при <b data-tb>—</b></li>
			</ul>
			<p class="g7__note">Пунктир — так росло бы давление пара, если бы его нагревали в закрытом сосуде без воды.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Давление насыщенного водяного пара при разных температурах (табличные данные). Жидкость кипит, когда давление её насыщенного пара равно внешнему.</figcaption>
</figure>

<style is:global>
	[data-psatlab] .ps-curve {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 3;
	}
	[data-psatlab] .ps-ideal {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.4;
		stroke-dasharray: 5 4;
	}
	[data-psatlab] .ps-ext {
		stroke: var(--g7-red);
		stroke-width: 2;
	}
	[data-psatlab] .ps-drop {
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	[data-psatlab] .ps-pt {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
</style>

<script>
	import { fmtInt } from '../g7/kit';
	import { tSat } from './psat';

	const X0 = 46;
	const X1 = 330;
	const Y0 = 236;
	const Y1 = 24;
	const x = (t: number) => X0 + (t / 130) * (X1 - X0);
	const y = (p: number) => Y0 - (p / 250) * (Y0 - Y1);
	for (const fig of document.querySelectorAll<HTMLElement>('[data-psatlab]')) {
		const inP = fig.querySelector<HTMLInputElement>('[data-p]')!;
		const out = fig.querySelector('[data-out-p]')!;
		const ext = fig.querySelector<SVGLineElement>('[data-ext]')!;
		const drop = fig.querySelector<SVGLineElement>('[data-drop]')!;
		const pt = fig.querySelector<SVGCircleElement>('[data-pt]')!;
		const lab = fig.querySelector<SVGTextElement>('[data-lab]')!;
		const tb = fig.querySelector('[data-tb]')!;
		const show = () => {
			const p = Number(inP.value);
			const t = tSat(p);
			out.textContent = `${p}\u00a0кПа`;
			ext.setAttribute('y1', y(p).toFixed(1));
			ext.setAttribute('y2', y(p).toFixed(1));
			drop.setAttribute('x1', x(t).toFixed(1));
			drop.setAttribute('x2', x(t).toFixed(1));
			drop.setAttribute('y1', y(p).toFixed(1));
			pt.setAttribute('cx', x(t).toFixed(1));
			pt.setAttribute('cy', y(p).toFixed(1));
			lab.setAttribute('x', (x(t) - 8).toFixed(1));
			lab.setAttribute('y', (y(p) - 9).toFixed(1));
			lab.setAttribute('text-anchor', 'end');
			lab.textContent = `${fmtInt(t)}\u00a0°C`;
			tb.textContent = `${fmtInt(t)}\u00a0°C`;
		};
		inP.addEventListener('input', show);
		for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-pp]'))
			b.addEventListener('click', () => {
				inP.value = b.dataset.pp!;
				show();
			});
		show();
	}
</script>
