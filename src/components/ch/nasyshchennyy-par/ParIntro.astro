---
/**
 * Two short looping opening scenes of «Насыщенный пар. Влажность воздуха» (grade 10). No terms of the chapter in the
 * pictures or the visible captions; each caption's popover names the notion and links to its section. People: the
 * shared people kit (src/components/people/). Grade 8 has a pot on a stove, a pot on Everest, a puddle drying, a
 * bottle from the fridge misting over and dew at dawn, so this chapter shows the breath on a frosty evening and the
 * geyser Strokkur.
 *
 * Breath (a winter evening; real time, 11 с; the near plane 0,8 px per см, the bus stop 0,42 px per см). −10 °C
 *   outside, +20 °C in the house. A man (176 см, winter clothes) stands in the lit doorway and breathes out at 0,9 с:
 *   nothing is seen. At 1,8 с he walks out, 2,0 м in 2,2 с in five steps of about 40 см (0,9 м/с on average, the stance foot planted,
 *   footprints left in the snow), and stops under the street lamp. He breathes out every 2,6 с (4,3; 6,9; 9,5 с; at
 *   rest a breath takes 3–5 с, after a few steps a little less); each breath out (about 0,5 л) makes a small cloud
 *   that moves forward, grows to about 40 см across and fades in 1,6 с. Far away a woman at the bus stop (165 см)
 *   breathes out clouds too (at 2,0; 4,6; 7,2; 9,8 с). Physics: breathed-out air is at about 34 °C and nearly
 *   saturated, ρ_н(34 °C) = 37,6 г/м³ (psat.ts); air at −10 °C holds at most 2,1 г/м³ over ice (2,4 г/м³ over
 *   supercooled water), so the mixture of the two goes below its dew point and the extra vapor condenses into
 *   droplets; indoors at 20 °C (17,3 г/м³ at most) the mixture stays below saturation. Snowflakes fall at about 1 м/с.
 * Geyser Strokkur (Haukadalur, Iceland; 12 с; the geyser at 10 px per м, the near tourists at 0,40 and 0,34 px per см,
 *   the far ones at 0,10 px per см). Strokkur erupts every 6–10 мин; here the wait is cut to 3 с. The pool, about 2 м
 *   across in a basin of sinter about 9 м wide, heaves gently; at 3,0 с a blue dome of water rises 1,8 м in 0,5 с and
 *   bursts; for 0,8 с water and steam leave the vent, the first at 19 м/с, then slower (19 → 8,5 м/с): the column
 *   rises to 18 м (h = υ²/2g; the usual height is 15–20 м) and each parcel of water flies as a thrown stone
 *   (g = 9,8 м/с², air drag left out) and falls back at most 3,9 с later. The steam drifts with a wind of 2 м/с, rises
 *   at about 1,5 м/с, swells and fades in 6 с. Physics (for the popover): the conduit is about 23 м deep; at 20 м
 *   down the pressure is 101 + 196 = 297 кПа and water boils only at 133 °C, so water heated below to more than
 *   100 °C does not boil; when the first steam lifts water out of the vent, the pressure below drops and the
 *   overheated water boils at once. Tourists watch from the path; when the column rises they look up, a child points
 *   at it, a man films it on a phone. Everything is a function of the scene time, and the last frame is the first.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// ---- breath scene
const G = 256; // the snow line where the man stands
const GF = 232; // the ground of the far plane (the bus stop)
const SF = 0.42;
const farWin: { x: number; y: number; lit: boolean }[] = [];
for (let c = 0; c < 9; c++) for (let r = 0; r < 4; r++) farWin.push({ x: 116 + c * 26, y: 100 + r * 26, lit: (c * 7 + r * 3) % 5 < 3 });
const stop = { x0: 262, x1: 350, top: GF - 240 * SF };
// ---- geyser scene
const P = { x: 118, y: 206 }; // the vent
const fence = Array.from({ length: 14 }, (_, i) => {
	const a = (i / 14) * 2 * Math.PI + 0.11;
	return { x: P.x + 96 * Math.cos(a), y: P.y + 20 * Math.sin(a), front: Math.sin(a) > 0 };
});
const ring = (front: boolean) => {
	let d = '';
	for (let i = 0; i <= 60; i++) {
		const a = front ? (i / 60) * Math.PI : Math.PI + (i / 60) * Math.PI;
		d += `${i ? 'L' : 'M'}${(P.x + 96 * Math.cos(a)).toFixed(1)} ${(P.y - 8 + 20 * Math.sin(a) + 1.5 * Math.abs(Math.sin(7 * (a - 0.11)))).toFixed(1)} `;
	}
	return d;
};
---

<PeopleStyles />
<IntroFrame data-parintro>
