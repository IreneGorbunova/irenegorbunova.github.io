			<rect class="pi-stopglass" x={stop.x0 + 30} y={stop.top + 8} width={stop.x1 - stop.x0 - 34} height={GF - stop.top - 22}></rect>
			<rect class="pi-stop" x={stop.x0 - 2} y={stop.top} width={stop.x1 - stop.x0 + 4} height="4" rx="1"></rect>
