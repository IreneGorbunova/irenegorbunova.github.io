			<g data-cloud1></g>
			<g data-flakes></g>
			<rect class="pi-pill" x="214" y="8" width="136" height="50" rx="10"></rect>
			<text class="pi-small" x="226" y="27">в доме</text>
			<text class="pi-num" x="226" y="46">+20&nbsp;°C</text>
			<text class="pi-small" x="290" y="27">на улице</text>
			<text class="pi-num" x="290" y="46">−10&nbsp;°C</text>
		</svg>
