</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, ANKLE_CM, SKELETON, ROLL, add, polar, mk, lerp, ease, attachAxis, type Pt, type FigurePose, type FigureOpts } from '@components/people';

	const f1 = (v: number) => v.toFixed(1);
	const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
	const smooth = (a: number, b: number, t: number) => ease((t - a) / (b - a));
	const rng = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
	/** The mouth of a person of the kit for a pose (adult, winter clothes): the head center as body.ts puts it. */
	const mouthOf = (q: FigurePose, u: number, dir: 1 | -1) => {
		const sk = SKELETON.adult;
		const W = 0.17 * u;
		const a = sk.headC * u + 0.005 * u;
		const b = 0.12 * W;
		const ax = Math.sin(q.lean);
		const ay = -Math.cos(q.lean);
		const hc = { x: q.hip.x + dir * (ax * a - ay * b), y: q.hip.y + ay * a + ax * b };
		const tilt = q.lean * 0.4 + (q.head ?? 0);
		const r = sk.headR * u;
		const m = { x: 0.92 * r, y: 0.55 * r };
		return { x: hc.x + dir * (m.x * Math.cos(tilt) - m.y * Math.sin(tilt)), y: hc.y + m.x * Math.sin(tilt) + m.y * Math.cos(tilt) };
	};
	/** One cloud of breath `age` s after the breath out: a few puffs ahead of the mouth; `k` scales it (1 at 0,8 px per см). */
	const breath = (g: SVGGElement, mouth: Pt, dir: 1 | -1, age: number, k: number, seed: number) => {
		g.replaceChildren();
		if (age < 0 || age > 1.6) return;
		const r = rng(seed);
		const fwd = 30 * (1 - Math.exp(-2.2 * age)) + 4 * age;
		const grow = 3 + 13 * Math.sqrt(age / 1.6);
		const op = 0.8 * smooth(0, 0.15, age) * (1 - age / 1.6) ** 1.4;
		for (let i = 0; i < 6; i++) {
			const ox = (r() - 0.3) * grow * 0.9;
			const oy = (r() - 0.5) * grow * 0.6;
			const rr = k * grow * (0.45 + 0.25 * r());
			const c = mk(g, 'circle', { class: 'pi-breath', cx: f1(mouth.x + dir * k * (fwd * (0.55 + 0.45 * (i / 5)) + ox + 2)), cy: f1(mouth.y - k * (5 * age + oy)), r: f1(rr) });
			c.setAttribute('opacity', (op * (0.55 + 0.45 * r())).toFixed(2));
		}
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-parintro]')) {
		// ------------------------------------------------------------------ breath
		{
			const card = root.querySelector<HTMLElement>('[data-scene="breath"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 256;
			const GF = 232;
			const S = 0.8;
			const H = 176;
			const u = S * H;
			const sk = SKELETON.adult;
			const man = figure($<SVGGElement>('[data-man]'), { s: S, H, clothes: 'winter', gear: 'boot', shirt: 'hm-blue', name: 'man' });
			const ankleY = G - ANKLE_CM.boot * S;
			const LEG = (sk.thigh + sk.shin) * u;
			const REACH = (sk.upper + sk.fore) * u * 0.97 + 0.04 * u;
			const X0 = 50; // the hip in the doorway
			const D = 160; // px walked (2,0 м)
			const TW = 1.8; // the walk starts
			const TS = 0.44; // s per step
			const NS = 5;
			const hipX = (t: number) => X0 + D * smooth(TW, TW + NS * TS, t);
			// the steps: the far foot first; each foot lands where the hip will be in the middle of the next step
			const steps = Array.from({ length: NS }, (_, k) => {
				const t1 = TW + (k + 1) * TS;
				const to = k === NS - 1 ? hipX(t1) + 4 : k === NS - 2 ? hipX(t1 + TS) - 4 : hipX(t1 + TS / 2);
				return { foot: (k % 2 === 0 ? 1 : 0) as 0 | 1, t0: TW + k * TS, t1, to };
			});
			const start: [number, number] = [X0 + 5, X0 - 4];
			const footAt = (i: 0 | 1, t: number) => {
				let x = start[i];
				for (const s of steps) {
					if (s.foot !== i) continue;
					if (t >= s.t1) x = s.to;
					else if (t > s.t0) {
						const sw = (t - s.t0) / (s.t1 - s.t0);
						return {
							x: x + (s.to - x) * ease(sw),
							up: 0.045 * u * Math.sin(Math.PI * sw),
							toe: 0.25 * Math.sin(Math.PI * sw) - 0.3 * Math.sin(Math.PI * Math.min(1, sw * 1.6)) * (1 - sw),
							planted: false,
						};
					}
				}
				return { x, up: 0, toe: 0, planted: true };
			};
			const BREATH = [0.9, 4.3, 6.9, 9.5];
			const BREATH_W = [2.0, 4.6, 7.2, 9.8];
			const chest = (t: number, list: number[]) => list.reduce((m, b) => Math.max(m, Math.exp(-(((t - b + 0.6) / 0.5) ** 2))), 0); // the chest lifts before a breath out
			const prints = $<SVGGElement>('[data-prints]');
			const printEls = steps
				.filter((s) => s.to > 96)
				.map((s) => ({ t: s.t1, el: mk(prints, 'ellipse', { class: 'pi-print', cx: f1(s.to + 4), cy: f1(G + 1.5 + (s.foot ? -1.2 : 1)), rx: '9', ry: '1.6', opacity: '0' }) }));
			const cloud1 = $<SVGGElement>('[data-cloud1]');
			const pose = (t: number): FigurePose => {
				const ph = clamp01((t - TW) / (NS * TS));
				const fN = footAt(0, t);
				const fF = footAt(1, t);
				const swing = Math.max(-1, Math.min(1, (fF.x - fN.x) / 36)); // the near arm swings forward with the far leg
				const b = chest(t, BREATH);
				const hx = hipX(t);
				// the hip as high as the stance legs allow (a foot on the ground behind or ahead lowers it)
				let hy = LEG * 0.995;
				for (const f of [fN, fF]) hy = Math.min(hy, Math.sqrt(Math.max(0, (LEG * 0.99) ** 2 - (hx - f.x) ** 2)) + f.up);
				const hip = { x: hx, y: ankleY - hy - 0.4 * b };
				const lean = 0.03 + 0.05 * Math.sin(Math.PI * ph);
				const sh = man.shoulders(hip, lean);
				return {
					hip,
					lean,
					head: -0.03 * b,
					ankles: [
						{ x: fN.x, y: ankleY - fN.up },
						{ x: fF.x, y: ankleY - fF.up },
					],
					feet: [fN.toe, fF.toe],
					hands: [
						{ at: add(sh[0], polar(REACH, Math.PI / 2 - 0.05 - 0.3 * swing)), pose: 'relaxed' },
						{ at: add(sh[1], polar(REACH, Math.PI / 2 + 0.02 + 0.3 * swing)), pose: 'relaxed' },
					],
					planted: [fN.planted, fF.planted],
				};
			};
			// the woman at the bus stop
			const SFw = 0.42;
			const HW = 165;
			const uw = SFw * HW;
			const woman = figure($<SVGGElement>('[data-woman]'), { s: SFw, H: HW, clothes: 'winter', gear: 'boot', shirt: 'hm-red', dir: -1, name: 'woman' });
			const cloud2 = $<SVGGElement>('[data-cloud2]');
			const WX = 300;
			const wAnkle = GF - ANKLE_CM.boot * SFw;
			const wPose = (t: number): FigurePose => {
				const b = chest(t, BREATH_W);
				const hip = { x: WX, y: wAnkle - (sk.thigh + sk.shin) * uw * 0.995 - 0.3 * b };
				const sh = woman.shoulders(hip, 0.02);
				const R = (sk.upper + sk.fore) * uw * 0.97 + 0.04 * uw;
				return {
					hip,
					lean: 0.02,
					head: -0.03 * b,
					ankles: [
						{ x: WX - 3, y: wAnkle },
						{ x: WX + 3, y: wAnkle },
					],
					feet: [0, 0],
					hands: [
						{ at: add(sh[0], polar(R, Math.PI / 2 + 0.06)), pose: 'relaxed' },
						{ at: add(sh[1], polar(R, Math.PI / 2 + 0.02)), pose: 'relaxed' },
					],
					planted: [true, true],
				};
			};
			// falling snow: about 1 м/с and a little sideways
			const flakesG = $<SVGGElement>('[data-flakes]');
			const r = rng(11);
			const flakes = Array.from({ length: 46 }, () => ({ x: r() * 380, y: r() * 280, rad: 0.7 + r() * 1.1, v: 20 + r() * 22, ph: r() * 6.3 }));
			const flakeEls = flakes.map((fl) => mk(flakesG, 'circle', { class: 'pi-flake', r: f1(fl.rad) }));
			const RUN = 11;
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const q = pose(t);
				man.pose(q);
				const m = mouthOf(q, u, 1);
				// a breath out is seen only outside, beyond the doorway
				let shown = false;
				BREATH.forEach((b, i) => {
					const age = t - b;
					if (age >= 0 && age <= 1.6 && m.x > 100) {
						breath(cloud1, m, 1, age, 1, 31 + i);
						shown = true;
					}
				});
				if (!shown) cloud1.replaceChildren();
				const qw = wPose(t);
				woman.pose(qw);
				const mw = mouthOf(qw, uw, -1);
				let shownW = false;
				BREATH_W.forEach((b, i) => {
					const age = t - b;
					if (age >= 0 && age <= 1.6) {
						breath(cloud2, mw, -1, age, SFw / S, 71 + i);
						shownW = true;
					}
				});
				if (!shownW) cloud2.replaceChildren();
				for (const p of printEls) p.el.setAttribute('opacity', t >= p.t ? '1' : '0');
				flakes.forEach((fl, i) => {
					const yy = (fl.y + fl.v * t) % 280;
					const xx = ((fl.x + 6 * Math.sin(fl.ph + t * 0.9) - 4 * t + 760) % 380) - 10;
					flakeEls[i].setAttribute('cx', f1(xx));
					flakeEls[i].setAttribute('cy', f1(yy));
				});
			});
		}

		// ------------------------------------------------------------------ geyser
		{
			const card = root.querySelector<HTMLElement>('[data-scene="geyser"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const P = { x: 118, y: 206 };
			const K = 10; // px per м at the geyser
			const g = 9.8;
			const T_DOME = 3.0;
			const T_BURST = 3.5;
			const T_JET = 0.8; // s of the outflow
			const RUN = 12;
			const WIND = 2.0; // м/с to the right
			// the jet: parcels of water launched during T_JET, 19 → 8,5 м/с, ±4° from the vertical
			const rj = rng(5);
			const NP = 150;
			const parcels = Array.from({ length: NP }, (_, i) => {
				const tau = (i / NP) * T_JET;
				const v = 19 - (10.5 * tau) / T_JET;
				const a = (rj() - 0.5) * 8 * (Math.PI / 180);
				return { tau, vx: v * Math.sin(a) + 0.15 * WIND, vy: v * Math.cos(a), r: 1.6 + rj() * 2.6, ox: (rj() - 0.5) * 1.6 };
			});
			// the steam: puffs left along the column, then carried by the wind
			const steamSrc = Array.from({ length: 70 }, (_, i) => ({ p: parcels[Math.floor((i / 70) * NP)], tl: 0.15 + rj() * 1.6, r0: 4 + rj() * 5, jitter: rj() }));
			const jet = $<SVGGElement>('[data-jet]');
			const dropEls = parcels.map((p) => mk(jet, 'circle', { class: 'pi-drop', r: f1(p.r), opacity: '0' }));
			const steamG = $<SVGGElement>('[data-steam]');
			const steamEls = steamSrc.map(() => mk(steamG, 'circle', { class: 'pi-steam', opacity: '0' }));
			const dome = $<SVGPathElement>('[data-dome]');
			const pool = $<SVGEllipseElement>('[data-gpool]');
			const wet = $<SVGEllipseElement>('[data-wet]');
			const vs = $<SVGGElement>('[data-ventsteam]');
			const ventPuffs = [262, 318, 30].flatMap((vx, j) => Array.from({ length: 4 }, (_, i) => ({ vx, vy: 170 - j * 0.5, ph: i / 4, s: j === 1 ? 0.7 : 1, el: mk(vs, 'circle', { class: 'pi-steam' }) })));
			// the near tourists on the path, facing the geyser (left)
			const tour = $<SVGGElement>('[data-tourists]');
			const S = 0.4;
			const GY = 270;
			type Tourist = { fig: ReturnType<typeof figure>; x: number; H: number; s: number; age: 'adult' | 'child'; gy: number; kind: 'stand' | 'phone' | 'point'; ankle: number };
			const mkT = (x: number, H: number, opts: Partial<FigureOpts>, kind: Tourist['kind'], s: number, gy: number, age: 'adult' | 'child', ankle: number): Tourist => ({
				fig: figure(mk(tour, 'g', {}) as SVGGElement, { s, H, age, dir: -1, ...opts } as FigureOpts),
				x,
				H,
				s,
				age,
				gy,
				kind,
				ankle,
			});
			const people: Tourist[] = [
				mkT(344, 176, { clothes: 'winter', gear: 'boot', shirt: 'hm-gold', name: 'tourist in a hat' }, 'stand', 0.34, 258, 'adult', ANKLE_CM.boot),
				mkT(234, 180, { clothes: 'indoor', shirt: 'hm-blue', name: 'man filming' }, 'phone', S, GY, 'adult', ANKLE_CM.trainer),
				mkT(274, 166, { clothes: 'indoor', shirt: 'hm-red', hair: 'pony', name: 'woman' }, 'stand', S, GY - 2, 'adult', ANKLE_CM.trainer),
				mkT(308, 125, { clothes: 'indoor', shirt: 'hm-green', name: 'child pointing' }, 'point', S, GY + 2, 'child', ANKLE_CM.trainer),
			];
			// far tourists at the fence on the far side of the basin
			const farG = $<SVGGElement>('[data-farpeople]');
			const far = [
				{ x: 66, H: 172, shirt: 'hm-red', dir: 1 as const },
				{ x: 76, H: 160, shirt: 'hm-gold', dir: 1 as const },
				{ x: 170, H: 178, shirt: 'hm-blue', dir: -1 as const },
			].map((f, i) => ({ ...f, fig: figure(mk(farG, 'g', {}) as SVGGElement, { s: 0.1, H: f.H, clothes: 'indoor', shirt: f.shirt, dir: f.dir, name: `far tourist ${i + 1}` }) }));
			const phone = $<SVGGElement>('[data-phone]');
			mk(phone, 'rect', { class: 'pi-phone', x: f1(-0.9 * S), y: f1(-10 * S), width: f1(1.8 * S), height: f1(15 * S), rx: '0.3' });
			const JET_TOP: Pt = { x: P.x + 4, y: P.y - 14 * K };
			const standPose = (p: Tourist, look: number, armT: number): FigurePose => {
				const sk = SKELETON[p.age];
				const u = p.s * p.H;
				const ankleY = p.gy - p.ankle * p.s;
				const hip = { x: p.x, y: ankleY - (sk.thigh + sk.shin) * u * 0.995 };
				const lean = 0.02;
				const sh = p.fig.shoulders(hip, lean);
				const R = (sk.upper + sk.fore) * u * 0.97 + 0.04 * u;
				const hang = (i: 0 | 1) => ({ at: add(sh[i], polar(R, Math.PI / 2 + 0.04 - 0.06 * i)), pose: 'relaxed' as const });
				let near: FigurePose['hands'][0] = hang(0);
				if (p.kind === 'phone') {
					// the phone in front of the face, the arm half stretched toward the geyser, raised a little more when he looks up
					const at = add(sh[0], polar(0.66 * (sk.upper + sk.fore) * u, Math.PI + 0.3 + 0.25 * look));
					near = { at, pose: 'grip', d: 1.2, dir: -Math.PI / 2 - 0.2, roll: ROLL.backViewer, contact: 'phone' };
				}
				if (p.kind === 'point') {
					const toward = Math.atan2(JET_TOP.y - sh[0].y, JET_TOP.x - sh[0].x);
					const e = ease(armT);
					const a = lerp(Math.PI / 2 + 0.04, toward, e);
					const at = add(sh[0], polar(lerp(R, (sk.upper + sk.fore + sk.hand) * u * 0.97, e), a));
					near = e > 0.5 ? { at, pose: 'point', dir: a } : { at, pose: 'relaxed' };
				}
				return {
					hip,
					lean,
					head: -0.38 * look,
					ankles: [
						{ x: p.x - 0.04 * u, y: ankleY },
						{ x: p.x + 0.035 * u, y: ankleY },
					],
					feet: [0, 0],
					hands: [near, hang(1)],
					planted: [true, true],
				};
			};
			scene(card, RUN, (x) => {
				const t = RUN * x;
				// the pool heaves, swells, the dome rises and bursts
				const heave = Math.sin((t * 2 * Math.PI * 3) / RUN) * 0.6 + Math.sin((t * 2 * Math.PI * 5) / RUN) * 0.3; // periodic in the loop
				const pre = smooth(1.6, T_DOME, t) * (1 - smooth(T_BURST, T_BURST + 0.3, t));
				pool.setAttribute('ry', f1(3.2 + 0.4 * pre));
				pool.setAttribute('rx', f1(12 + heave * 0.4 + 2 * pre));
				pool.setAttribute('cy', f1(P.y - 0.4 * heave - 1.2 * pre));
				const dh = t >= T_DOME && t < T_BURST ? 18 * ease((t - T_DOME) / (T_BURST - T_DOME)) : 0;
				if (dh > 0.5) {
					const w = 12 + 2 * pre;
					dome.setAttribute('d', `M${f1(P.x - w)} ${f1(P.y - 1)} C${f1(P.x - w)} ${f1(P.y - 1 - dh * 1.33)} ${f1(P.x + w)} ${f1(P.y - 1 - dh * 1.33)} ${f1(P.x + w)} ${f1(P.y - 1)} Z`);
				} else dome.setAttribute('d', '');
				// the parcels of water
				parcels.forEach((p, i) => {
					const tt = t - T_BURST - p.tau;
					const h = p.vy * tt - (g * tt * tt) / 2;
					const el = dropEls[i];
					if (tt < 0 || h < 0) {
						el.setAttribute('opacity', '0');
						return;
					}
					el.setAttribute('cx', f1(P.x + K * (p.vx * tt + p.ox)));
					el.setAttribute('cy', f1(P.y - 2 - K * h));
					el.setAttribute('opacity', '0.9');
				});
				// the steam: where its parcel was when the puff was born, then up and with the wind
				steamSrc.forEach((s, i) => {
					const el = steamEls[i];
					const age = t - (T_BURST + s.p.tau + s.tl);
					if (age < 0 || age > 6) {
						el.setAttribute('opacity', '0');
						return;
					}
					const tp = s.tl;
					const x0 = P.x + K * (s.p.vx * tp + s.p.ox);
					const y0 = P.y - K * Math.max(0, s.p.vy * tp - (g * tp * tp) / 2);
					el.setAttribute('cx', f1(x0 + K * WIND * age * (0.6 + 0.4 * s.jitter)));
					el.setAttribute('cy', f1(Math.max(4, y0 - K * 1.5 * age * (0.6 + 0.6 * s.jitter))));
					el.setAttribute('r', f1(s.r0 + 3.2 * age + 2 * Math.sqrt(age)));
					el.setAttribute('opacity', (0.75 * smooth(0, 0.3, age) * (1 - age / 6) ** 1.3).toFixed(2));
				});
				// the basin is wet after the water falls back, and dries
				wet.setAttribute('opacity', (0.55 * smooth(T_BURST + 1.5, T_BURST + 3.5, t) * (1 - smooth(9, RUN, t))).toFixed(2));
				ventPuffs.forEach((v) => {
					const ph = (t / 3 + v.ph) % 1;
					v.el.setAttribute('cx', f1(v.vx + 14 * ph));
					v.el.setAttribute('cy', f1(v.vy - 26 * ph * v.s));
					v.el.setAttribute('r', f1((2 + 7 * ph) * v.s));
					v.el.setAttribute('opacity', (0.5 * Math.sin(Math.PI * ph)).toFixed(2));
				});
				// the people look up while the column stands, the child points, and all come back to the start
				const look = smooth(T_BURST, T_BURST + 0.8, t) * (1 - smooth(8.4, 9.6, t));
				const armT = smooth(T_BURST + 0.1, T_BURST + 0.8, t) * (1 - smooth(8.0, 8.8, t));
				for (const p of people) {
					const st = p.fig.pose(standPose(p, p.s < S ? look * 0.7 : look, armT));
					if (p.kind === 'phone') attachAxis(phone, st.grips[0]);
				}
				const skA = SKELETON.adult;
				for (const f of far) {
					const u = 0.1 * f.H;
					const ay = P.y - 23 - ANKLE_CM.trainer * 0.1;
					const hip = { x: f.x, y: ay - (skA.thigh + skA.shin) * u * 0.995 };
					const sh = f.fig.shoulders(hip, 0);
					const R = (skA.upper + skA.fore) * u * 0.97 + 0.04 * u;
					f.fig.pose({
						hip,
						lean: 0,
						head: -0.3 * look,
						ankles: [
							{ x: f.x + f.dir * 0.03 * u, y: ay },
							{ x: f.x - f.dir * 0.03 * u, y: ay },
						],
						feet: [0, 0],
						hands: [
							{ at: add(sh[0], polar(R, Math.PI / 2)), pose: 'relaxed' },
							{ at: add(sh[1], polar(R, Math.PI / 2)), pose: 'relaxed' },
						],
						planted: [true, true],
					});
				}
			});
		}
	}
</script>
