	[data-parintro] .pi-flame {
		fill: hsl(215, 90%, 60%);
		opacity: 0.9;
	}
	[data-parintro] .pi-board {
		fill: hsl(32, 50%, 55%);
	}
	[data-parintro] .pi-potato {
		fill: hsl(38, 55%, 62%);
		stroke: hsl(30, 40%, 35%);
		stroke-width: 0.6;
	}
	[data-parintro] .pi-steel {
		fill: hsl(215, 12%, 72%);
		stroke: hsl(222, 25%, 22%);
		stroke-width: 0.8;
	}
	[data-parintro] .pi-cooker {
		fill: hsl(215, 10%, 62%);
	}
	[data-parintro] .pi-knob2,
	[data-parintro] .pi-valve {
		fill: hsl(222, 20%, 18%);
	}
	[data-parintro] .pi-handle,
	[data-parintro] .pi-handle2 {
		stroke: hsl(222, 20%, 18%);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-parintro] .pi-handle2 {
		stroke-width: 4;
	}
	[data-parintro] .pi-bubble {
		fill: none;
		stroke: hsl(200, 60%, 85%);
		stroke-width: 0.8;
	}
	[data-parintro] .pi-steam {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linecap: round;
		opacity: 0.7;
	}
	[data-parintro] .pi-spoon {
		fill: none;
		stroke: hsl(32, 50%, 50%);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { person, ANKLE } from '../davlenie-zakon-paskalya/person';
	import { human, gait } from '../mehanicheskaya-rabota/people';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = (tag: string, attrs: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		return e;
	};
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const fmt1 = (v: number) => v.toFixed(0);

	/** A breath cloud: a few round puffs, `age` from 0 to 1. */
	const cloud = (g: SVGGElement, x: number, y: number, age: number, k: number, dir = 1) => {
		g.replaceChildren();
		if (age <= 0 || age >= 1) return;
		const grow = Math.sqrt(age);
		const op = (age < 0.12 ? age / 0.12 : 1 - ((age - 0.12) / 0.88) ** 1.5) * 0.95;
		const cx = x + dir * 16 * k * grow;
		const cy = y - 6 * k * age;
		const puffs = [
			[0, 0, 7],
			[6, -2, 6],
			[-4, -3, 5],
			[3, 3, 5],
			[10, 1, 4],
		];
		for (const [dx, dy, r] of puffs) g.append(mk('circle', { class: 'pi-cloud', cx: (cx + dir * dx * k * grow).toFixed(1), cy: (cy + dy * k * grow).toFixed(1), r: (r * k * (0.35 + 0.65 * grow)).toFixed(1), opacity: op.toFixed(2) }));
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-parintro]')) {
		// ---------------- the breath
		{
			const card = root.querySelector<HTMLElement>('[data-scene="breath"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.9;
			const H = 176;
			const u = S * H;
			const G = 252;
			const man = person($<SVGGElement>('[data-man]'), { s: S, H, girth: 1, gear: 'boot', coat: 'pi-coat--a' });
			const S2 = 0.54;
			const woman = person($<SVGGElement>('[data-woman]'), { s: S2, H: 165, girth: 0.95, gear: 'boot', coat: 'pi-coat--b' });
			const c1 = $<SVGGElement>('[data-cloud1]');
			const c2 = $<SVGGElement>('[data-cloud2]');
			const flakes = [...card.querySelectorAll<SVGCircleElement>('[data-flakes] circle')];
			const fy0 = flakes.map((f) => Number(f.getAttribute('cy')));
			const ank = ANKLE.boot * S;
			const stand = (x: number, sway: number) => ({
				hip: { x, y: G - 0.52 * u + 1 },
				lean: 0.03,
				ankles: [
					{ x: x + 0.03 * u, y: G - ank },
					{ x: x - 0.04 * u, y: G - ank },
				] as [{ x: number; y: number }, { x: number; y: number }],
				feet: [0, 0] as [number, number],
				hands: [
					{ x: x + 0.05 * u, y: G - 0.44 * u + sway },
					{ x: x - 0.02 * u, y: G - 0.45 * u },
				] as [{ x: number; y: number }, { x: number; y: number }],
				head: -0.05,
			});
			const u2 = S2 * 165;
			woman({
				hip: { x: 334, y: 240 - 0.52 * u2 + 1 },
				lean: 0.02,
				ankles: [
					{ x: 334 - 0.03 * u2, y: 240 - ANKLE.boot * S2 },
					{ x: 334 + 0.04 * u2, y: 240 - ANKLE.boot * S2 },
				],
				feet: [0, 0],
				hands: [
					{ x: 334 - 0.05 * u2, y: 240 - 0.45 * u2 },
					{ x: 334 + 0.02 * u2, y: 240 - 0.45 * u2 },
				],
			});
			// the woman faces left: mirror her group about her own axis
			$<SVGGElement>('[data-woman]').setAttribute('transform', 'matrix(-1 0 0 1 668 0)');
			const RUN = 9;
			const X0 = 48;
			const X1 = 176;
			const WALK0 = 2.2; // s
			const STEP = 0.7 * 100 * S; // px
			const V = 1.2 * 100 * S; // px/s
			const WALK1 = WALK0 + (X1 - X0) / V;
			let wall = 0;
			let last = 0;
			scene(card, RUN, (x) => {
				const now = performance.now();
				wall += last ? Math.min(0.05, (now - last) / 1000) : 0;
				last = now;
				const t = x * RUN;
				let hx = X0;
				if (t < WALK0) {
					man(stand(X0, 0));
				} else if (t < WALK1) {
					const d = (t - WALK0) * V;
					hx = X0 + d;
					const ft = gait(d, STEP, X0 + 0.03 * u, 4);
					const sw = Math.sin((d / STEP) * Math.PI);
					man({
						hip: { x: hx, y: G - 0.52 * u + 1 - 1.2 * Math.abs(sw) },
						lean: 0.06,
						ankles: [
							{ x: ft[0].x, y: G - ank - ft[0].up },
							{ x: ft[1].x, y: G - ank - ft[1].up },
						],
						feet: [0, 0],
						hands: [
							{ x: hx + 0.08 * u * sw, y: G - 0.45 * u },
							{ x: hx - 0.08 * u * sw, y: G - 0.45 * u },
						],
						head: -0.05,
					});
				} else {
					hx = X1;
					man(stand(X1, 0));
				}
				// breathing out every 2,6 с; a cloud only outside the house
				const ph = (t % 2.6) / 1.6;
				const mouth = { x: hx + 0.085 * u, y: G - 0.865 * u };
				cloud(c1, mouth.x, mouth.y, hx > 100 ? ph : 0, 1.6);
				const ph2 = ((t + 1.1) % 2.6) / 1.6;
				cloud(c2, 334 - 0.08 * u2, 240 - 0.865 * u2, ph2, 0.95, -1);
				flakes.forEach((f, i) => f.setAttribute('cy', (((fy0[i] + wall * (10 + (i % 4) * 3)) % 250) + 0).toFixed(1)));
			});
		}
		// ---------------- the pressure cooker
		{
			const card = root.querySelector<HTMLElement>('[data-scene="cooker"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1.2;
			const FL = 272;
			const CT = 164;
			const cook = human($<SVGGElement>('[data-cook]'), { s: S, H: 168, shirt: 'hm-red', hair: 'pony' });
			const u = S * 168;
			const hip = { x: 132, y: FL - 0.505 * u };
			const hand = { x: 176, y: CT - 30 };
			cook({
				hip,
				lean: 0.12,
				ankles: [
					{ x: 140, y: FL - 7 * S * 0.98 },
					{ x: 124, y: FL - 7 * S * 0.98 },
				],
				feet: [0, 0],
				hands: [hand, { x: 150, y: CT + 2 }],
				head: 0.35,
			});
			$<SVGPathElement>('[data-spoon]').setAttribute('d', `M${hand.x - 4} ${hand.y + 6} L${hand.x + 14} ${hand.y - 4}`);
			const lid = $<SVGGElement>('[data-lid]');
			const valve = $<SVGRectElement>('[data-valve]');
			const bub = $<SVGGElement>('[data-bub]');
			const st1 = $<SVGPathElement>('[data-steam1]');
			const st2 = $<SVGPathElement>('[data-steam2]');
			const fl1 = $<SVGPathElement>('[data-fl1]');
			const fl2 = $<SVGPathElement>('[data-fl2]');
			const t1 = $('[data-t1]');
			const t2 = $('[data-t2]');
			const r1 = $('[data-r1]');
			const r2 = $('[data-r2]');
			const clock = $('[data-clock]');
			const flame = (x0: number, on: boolean, w: number) => {
				if (!on) return '';
				let d = '';
				for (let i = 0; i < 5; i++) {
					const x = x0 + i * 5;
					const h = 4 + 1.5 * Math.sin(w * 9 + i * 2);
					d += `M${x - 2} ${CT - 3} Q${x} ${CT - 3 - h} ${x + 2} ${CT - 3} Z `;
				}
				return d;
			};
			const RUN = 11;
			let wall = 0;
			let last = 0;
			scene(card, RUN, (x) => {
				const now = performance.now();
				wall += last ? Math.min(0.05, (now - last) / 1000) : 0;
				last = now;
				const m = x * 35; // minutes of the story
				const T1 = m < 8 ? 20 + 80 * ease(m / 8) : 100;
				const T2 = m < 10 ? 20 + 100 * ease(m / 10) : 120;
				const done1 = m >= 33;
				const done2 = m >= 20;
				t1.textContent = `${fmt1(T1)}\u00a0°C`;
				t2.textContent = `${fmt1(T2)}\u00a0°C`;
				// minutes of cooking, counted from the moment the water is at its temperature
				r1.textContent = done1 ? 'готова: 25\u00a0мин' : m >= 8 ? `варится ${Math.floor(m - 8)}\u00a0мин` : 'греется';
				r2.textContent = done2 ? 'готова: 10\u00a0мин' : m >= 10 ? `варится ${Math.floor(m - 10)}\u00a0мин` : 'греется';
				clock.textContent = `прошло ${Math.floor(m)}\u00a0мин`;
				fl1.setAttribute('d', flame(186, !done1, wall));
				fl2.setAttribute('d', flame(227, !done2, wall + 1));
				// the pot boils: bubbles under the rattling lid, steam from under it
				const boil1 = m >= 8 && !done1;
				lid.setAttribute('transform', boil1 ? `translate(0 ${(-1.2 * Math.abs(Math.sin(wall * 11))).toFixed(2)})` : '');
				bub.replaceChildren();
				if (boil1)
					for (let i = 0; i < 5; i++) {
						const y = CT - 6 - ((wall * 14 + i * 4) % 14);
						bub.append(mk('circle', { class: 'pi-bubble', cx: 187 + i * 4.5, cy: y.toFixed(1), r: 1.2 }));
					}
				const w = Math.sin(wall * 3) * 2;
				st1.setAttribute('d', boil1 ? `M190 ${CT - 30} q${(-3 + w).toFixed(1)} -8 0 -16 q3 -8 0 -16 M202 ${CT - 30} q${(3 - w).toFixed(1)} -7 0 -14` : '');
				// the cooker's valve lifts and hisses once it is at 120 °C
				const hiss = m >= 10 && !done2;
				valve.setAttribute('y', (CT - 39 - (hiss ? 1 + Math.abs(Math.sin(wall * 17)) : 0)).toFixed(1));
				st2.setAttribute('d', hiss ? `M236.5 ${CT - 42} q${(2 + w).toFixed(1)} -10 -1 -22 q-4 -10 1 -18` : '');
			});
		}
	}
</script>
