---
/**
 * Two short looping opening scenes of «Насыщенный пар. Влажность». No terms of the chapter in the pictures; the
 * captions' popovers name them.
 *
 * Breath: a winter evening, −10 °C outside, +20 °C in the house. A man (176 см, winter clothes of
 *   ../davlenie-zakon-paskalya/person.ts) breathes out in the lit doorway — nothing is seen — then walks out (1,2 м/с,
 *   steps of 70 см) and stops in the snow; each breath out (every 2,6 с, a bit quicker than at rest, 0,5 л) now makes
 *   a small cloud that grows to about 40 см, drifts and fades in 1,6 с. Far away a woman at the bus stop (drawn at 60 %
 *   of the scale, she is farther) breathes out clouds too. Physics: breathed-out air is at about 34 °C and nearly
 *   saturated with water vapour (≈ 37 г/м³); mixed with air at −10 °C, which holds at most ≈ 2,3 г/м³, it is cooled
 *   below its dew point and the extra vapour condenses into droplets; indoors at 20 °C (17 г/м³ at most) the mixture
 *   stays below saturation. Scale 0,9 px per см for the near man; real time.
 * Pressure cooker: a kitchen, scale 1,2 px per см. On a hob two pots of potatoes: an ordinary pot with a lid (water
 *   boils at 100 °C at 101 кПа) and a pressure cooker whose valve keeps about 200 кПа inside, so its water boils at
 *   120 °C (the pressure of saturated vapour is 198 кПа at 120 °C). Story clock: 35 мин in 11 с (about 190 times
 *   faster). The pot heats to 100 °C in 8 мин and the potatoes are done 25 мин later; the cooker heats to 120 °C in
 *   10 мин and they are done 10 мин later (typical cooking times of whole potatoes: 20–25 мин in boiling water,
 *   8–10 мин under pressure). The pills count the minutes of cooking from the moment each reaches its temperature,
 *   so the scene shows 25 against 10 мин: two and a half times faster, as the caption says (the whole times with the
 *   heating are 33 and 20 мин). The pot's lid rattles and lets out steam; the cooker's valve hisses once it is up to
 *   pressure; the heat under it is turned off when it is done. No word «кипит» in the picture: it is a term of the
 *   chapter.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
// ---- breath scene
const G = 252; // the snow line where the man stands
const flakes = Array.from({ length: 40 }, (_, i) => ({ x: (i * 47) % 360, y: (i * 71) % 250, r: 0.8 + (i % 3) * 0.4 }));
const farWin = [] as { x: number; y: number; lit: boolean }[];
for (let c = 0; c < 9; c++) for (let r = 0; r < 4; r++) farWin.push({ x: 118 + c * 26, y: 112 + r * 26, lit: (c * 7 + r * 3) % 5 < 3 });
// ---- kitchen scene, 1,2 px per см
const FL = 272;
const CT = 164; // counter top, 90 см
const tiles: string[] = [];
for (let y = CT - 60; y < CT; y += 12) tiles.push(`M0 ${y} H360`);
for (let x = 0; x < 360; x += 12) tiles.push(`M${x} ${CT - 60} V${CT}`);
---

<PeopleStyles />
<IntroFrame data-parintro>
	<div class="intro__card" data-scene="breath">
		<svg class="intro__svg" viewBox="0 0 360 280" role="img" aria-label="Зимний вечер. Мужчина выходит из тёплого подъезда на мороз. В подъезде его дыхания не видно, а на улице при каждом выдохе изо рта вылетает белое облачко. Вдали на остановке у женщины тоже идут облачка">
			<defs>
				<clipPath id={`pd-${uid}`}><rect x="22" y="80" width="56" height={G - 80}></rect></clipPath>
			</defs>
			<rect class="pi-sky" x="0" y="0" width="360" height="280"></rect>
			<circle class="pi-moon" cx="300" cy="34" r="10"></circle>
			<!-- far houses with windows -->
			<rect class="pi-far" x="108" y="100" width="240" height="140"></rect>
			{farWin.map((w) => <rect class={w.lit ? 'pi-lit' : 'pi-dark'} x={w.x} y={w.y} width="12" height="15" />)}
			<path class="pi-snowroof" d="M104 100 H352 V95 H104 Z"></path>
			<!-- a snowy fir and the bus stop -->
			<path class="pi-fir" d="M278 236 L292 196 L306 236 Z M282 214 L292 178 L302 214 Z M285 194 L292 164 L299 194 Z"></path>
			<path class="pi-firsnow" d="M286 196 L292 190 L298 196 M283 216 L292 206 L301 216"></path>
			<rect class="pi-stop" x="314" y="192" width="40" height="3"></rect>
			<path class="pi-stoppost" d="M318 195 V240 M350 195 V240"></path>
			<rect class="pi-stopglass" x="319" y="196" width="30" height="34"></rect>
			<g data-woman></g>
			<g data-cloud2></g>
			<!-- the street lamp -->
			<path class="pi-lamppost" d="M236 250 V150 Q236 140 246 140 H252"></path>
			<path class="pi-cone" d="M250 144 L222 250 H282 Z"></path>
			<rect class="pi-lamp" x="246" y="140" width="10" height="5" rx="2"></rect>
			<!-- the snow -->
			<path class="pi-snow" d="M0 240 Q60 232 120 240 T240 238 T360 240 V280 H0 Z"></path>
			<path class="pi-drift" d="M96 246 q20 -10 40 0 Z M300 248 q16 -8 34 0 Z"></path>
			<!-- the house: the wall, the open doorway with warm light, the thermometer -->
			<rect class="pi-wall" x="0" y="40" width="98" height={G - 40}></rect>
			<path class="pi-brick" d={Array.from({ length: 13 }, (_, i) => `M0 ${52 + i * 16} H98`).join(' ')}></path>
			<rect class="pi-warm" x="22" y="80" width="56" height={G - 80}></rect>
			<g clip-path={`url(#pd-${uid})`}>
				<path class="pi-stairs" d="M22 200 H40 V188 H54 V176 H68 V164 H78"></path>
			</g>
			<path class="pi-glow" d={`M78 ${G} L130 ${G + 18} L22 ${G + 18} L22 ${G} Z`}></path>
			<rect class="pi-door" x="78" y="80" width="10" height={G - 80}></rect>
			<rect class="pi-lintel" x="18" y="74" width="64" height="6"></rect>
			<rect class="pi-thermo" x="88" y="120" width="7" height="34" rx="3.5"></rect>
			<rect class="pi-thermo-col" x="90.5" y="140" width="2" height="12"></rect>
			<g data-man></g>
			<g data-cloud1></g>
			<g data-flakes>{flakes.map((f) => <circle class="pi-flake" cx={f.x} cy={f.y} r={f.r} />)}</g>
			<rect class="pi-pill" x="214" y="8" width="136" height="50" rx="10"></rect>
			<text class="pi-small" x="226" y="27">в доме</text>
			<text class="pi-num" x="226" y="45">+20&nbsp;°C</text>
			<text class="pi-small" x="290" y="27">на улице</text>
			<text class="pi-num" x="290" y="45">−10&nbsp;°C</text>
		</svg>
		<div class="intro__foot">
			<p>
				На морозе изо рта{' '}
				<More term="идёт «пар»">
					Выдыхаемый воздух тёплый, около 34&nbsp;°C, и в нём много водяного пара. На морозе он быстро остывает, пар становится насыщенным и конденсируется в крошечные капельки — получается облачко тумана. Сам пар невидим, видны только капельки. В тёплой комнате воздух может принять этот пар, и облачка нет. Об этом — в разделе{' '}
					<a href="#точка-росы">«Точка росы»</a>.
				</More>, а в тёплом доме дыхания не видно.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="cooker">
		<svg class="intro__svg" viewBox="0 0 360 280" role="img" aria-label="Кухня. На плите обычная кастрюля и скороварка с картошкой. Вода в кастрюле нагревается до 100 градусов, в скороварке — до 120. В скороварке картошка варится 10 минут, в кастрюле — 25">
			<rect class="pi-kwall" x="0" y="0" width="360" height={FL}></rect>
			<path class="pi-tiles" d={tiles.join(' ')}></path>
			<rect class="pi-kfloor" x="0" y={FL} width="360" height={280 - FL}></rect>
			<!-- the window with a plant, the wall cabinets, the hood -->
			<rect class="pi-kwin" x="282" y="18" width="66" height="78"></rect>
			<path class="pi-kframe" d="M282 18 H348 V96 H282 Z M315 18 V96"></path>
			<rect class="pi-sill" x="278" y="96" width="74" height="4"></rect>
			<path class="pi-pot" d="M292 96 L294 84 H306 L308 96 Z"></path>
			<path class="pi-leaf" d="M300 84 q-8 -12 -14 -10 q6 4 14 10 Z M300 84 q2 -16 10 -18 q-2 8 -10 18 Z M300 84 q10 -6 14 -2 q-6 2 -14 2 Z"></path>
			<rect class="pi-cab" x="0" y="14" width="74" height="70" rx="2"></rect>
			<rect class="pi-cab" x="78" y="14" width="74" height="70" rx="2"></rect>
			<path class="pi-knob" d="M66 70 v8 M86 70 v8"></path>
			<path class="pi-hood" d="M206 0 H236 V34 L262 54 H180 L206 34 Z"></path>
			<!-- the counter, the oven, the hob -->
			<rect class="pi-counter" x="0" y={CT} width="360" height="6"></rect>
			<rect class="pi-cabinet" x="0" y={CT + 6} width="360" height={FL - CT - 6}></rect>
			<path class="pi-seams" d={`M90 ${CT + 6} V${FL} M180 ${CT + 6} V${FL} M262 ${CT + 6} V${FL} M300 ${CT + 6} V${FL}`}></path>
			<rect class="pi-ovenwin" x="192" y={CT + 30} width="58" height="40" rx="4"></rect>
			<path class="pi-knob" d={`M196 ${CT + 16} h4 M212 ${CT + 16} h4 M228 ${CT + 16} h4 M244 ${CT + 16} h4`}></path>
			<rect class="pi-hob" x="184" y={CT - 3} width="74" height="3"></rect>
			<path class="pi-flame" data-fl1 d=""></path>
			<path class="pi-flame" data-fl2 d=""></path>
			<!-- the cutting board with potatoes -->
			<rect class="pi-board" x="268" y={CT - 4} width="44" height="4" rx="1"></rect>
			<ellipse class="pi-potato" cx="280" cy={CT - 8} rx="7" ry="5"></ellipse>
			<ellipse class="pi-potato" cx="296" cy={CT - 7} rx="6" ry="4.5"></ellipse>
			<!-- the ordinary pot: 22 см across, 15 см high -->
			<g data-pot>
				<rect class="pi-steel" x="183" y={CT - 3 - 18} width="26" height="18" rx="2"></rect>
				<path class="pi-handle" d={`M181 ${CT - 17} h-4 M211 ${CT - 17} h4`}></path>
			</g>
			<g data-lid>
				<path class="pi-steel" d={`M181 ${CT - 21} Q196 ${CT - 28} 211 ${CT - 21} Z`}></path>
				<circle class="pi-knob2" cx="196" cy={CT - 26} r="2"></circle>
			</g>
			<g data-bub></g>
			<path class="pi-steam" data-steam1 d=""></path>
			<!-- the pressure cooker: 22 см across, 20 см high, a long handle and a valve -->
			<rect class="pi-steel pi-cooker" x="223" y={CT - 3 - 24} width="27" height="24" rx="3"></rect>
			<path class="pi-steel pi-cooker" d={`M221 ${CT - 27} Q236 ${CT - 34} 252 ${CT - 27} Z`}></path>
			<path class="pi-handle2" d={`M250 ${CT - 29} h22`}></path>
			<rect class="pi-valve" data-valve x="234" y={CT - 39} width="5" height="6" rx="1"></rect>
			<path class="pi-steam" data-steam2 d=""></path>
			<g data-cook></g>
			<path class="pi-spoon" data-spoon d=""></path>
			<rect class="pi-pill" x="8" y="20" width="150" height="56" rx="9"></rect>
			<text class="pi-small" x="18" y="36">в кастрюле</text>
			<text class="pi-num2" x="18" y="54" data-t1>20&nbsp;°C</text>
			<text class="pi-small" x="18" y="70" data-r1></text>
			<rect class="pi-pill" x="270" y="104" width="86" height="48" rx="9"></rect>
			<text class="pi-small" x="278" y="118">в скороварке</text>
			<text class="pi-num2" x="278" y="134" data-t2>20&nbsp;°C</text>
			<text class="pi-small" x="278" y="148" data-r2></text>
			<text class="pi-small pi-halo" x="350" y="10" text-anchor="end" data-clock>0&nbsp;мин</text>
		</svg>
		<div class="intro__foot">
			<p>
				В скороварке картошка варится{' '}
				<More term="в два с половиной раза быстрее">
					Крышка скороварки закрыта плотно, и пар выходит через клапан, только когда давление внутри примерно вдвое больше атмосферного. При таком давлении вода закипает не при 100&nbsp;°C, а примерно при 120&nbsp;°C, и в более горячей воде картошка варится быстрее. Об этом — в разделе{' '}
					<a href="#кипение">«Кипение»</a>.
				</More>, чем в обычной кастрюле.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
