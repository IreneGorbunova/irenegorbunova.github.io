			<rect class="pi-warm" x="14" y={G - 168} width="72" height="168"></rect>
			<path class="pi-stairs" d={`M14 ${G - 40} H30 V${G - 54} H44 V${G - 68} H58 V${G - 82} H72 V${G - 96} H86`}></path>
			<path class="pi-rail" d={`M20 ${G - 70} L80 ${G - 126}`}></path>
			<rect class="pi-bulb" x="44" y={G - 166} width="10" height="4" rx="2"></rect>
			<path class="pi-glow" d={`M86 ${G} L150 ${G + 22} L40 ${G + 22} L14 ${G} Z`}></path>
			<rect class="pi-lintel" x="8" y={G - 174} width="84" height="6"></rect>
			<rect class="pi-jamb" x="86" y={G - 168} width="5" height="168"></rect>
