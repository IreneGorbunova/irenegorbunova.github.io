---
/**
 * The isotherm of water vapour at 20 °C: 0,05 г of water in a cylinder under a piston, no air. While some water is
 * left, the vapour is saturated and its pressure stays p_н = 2,33 кПа whatever the volume; all the water has turned
 * into vapour at V = m/ρ_н = 0,05 г / 17,2 г/м³ = 2,9 л, and beyond that the unsaturated vapour behaves almost as an
 * ideal gas: p = 2,33 кПа · 2,9 л / V (dashed on the left: what an ideal gas would do). Axes: V 0–8 л, p 0–4 кПа.
 */
import G7Styles from '../g7/G7Styles.astro';
import { psat, rhoSat } from './psat';

const X0 = 46;
const X1 = 340;
const Y0 = 200;
const Y1 = 24;
const x = (V: number) => X0 + (V / 8) * (X1 - X0);
const y = (p: number) => Y0 - (p / 4) * (Y0 - Y1);
const ps = psat(20);
const Vs = (0.05 / rhoSat(20)) * 1000; // л
const hyp: string[] = [];
for (let V = Vs; V <= 8.001; V += 0.1) hyp.push(`${x(V).toFixed(1)} ${y((ps * Vs) / V).toFixed(1)}`);
const ideal: string[] = [];
for (let V = (ps * Vs) / 4; V <= Vs + 0.001; V += 0.05) ideal.push(`${x(V).toFixed(1)} ${y((ps * Vs) / V).toFixed(1)}`);
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-isopic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 236" role="img" aria-label="График давления пара от объёма при 20 градусах: пока в сосуде есть вода, давление постоянно, 2,33 килопаскаля; когда вода вся испарилась, давление падает с ростом объёма">
			<path class="ln" d={`M${X0} ${Y1 - 6} V${Y0} H${X1 + 6}`}></path>
			{[1, 2, 3, 4].map((p) => <g><path class="ln-dash" d={`M${X0} ${y(p)} H${X1}`} /><text class="t-small" x={X0 - 6} y={y(p) + 4} text-anchor="end">{p}</text></g>)}
			{[2, 4, 6, 8].map((V) => <text class="t-small" x={x(V)} y={Y0 + 15} text-anchor="middle">{V}</text>)}
			<text class="t-small" x={X0 + 6} y={Y1 - 10}><tspan class="t-i">p</tspan>, кПа</text>
			<text class="t-small" x={X1 + 4} y={Y0 + 28} text-anchor="end"><tspan class="t-i">V</tspan>, л</text>
			<polyline class="ip-ideal" points={ideal.join(' ')}></polyline>
			<path class="ip-flat" d={`M${x(0.15)} ${y(ps)} H${x(Vs)}`}></path>
			<polyline class="ip-gas" points={hyp.join(' ')}></polyline>
			<circle class="ip-pt" cx={x(Vs)} cy={y(ps)} r="4"></circle>
			<text class="t-small t-halo" x={X0 + 8} y={y(ps) + 17}>вода и</text>
			<text class="t-small t-halo" x={X0 + 8} y={y(ps) + 30}>насыщенный пар</text>
			<text class="t-small t-halo" x={x(5.6)} y={y(1.1) - 8} text-anchor="middle">только ненасыщенный пар</text>
			<text class="t-small t-halo" x={x(1.3)} y={y(3.6)}>так вёл бы себя идеальный газ</text>
			<text class="t-strong t-halo" x={x(Vs) + 8} y={y(ps) - 8}>2,33 кПа</text>
		</svg>
	</div>
	<figcaption class="g7__caption">0,05&nbsp;г воды под поршнем при 20&nbsp;°C, воздуха нет. Пока вода не испарилась вся (до 2,9&nbsp;л), давление пара не зависит от объёма.</figcaption>
</figure>

<style is:global>
	[data-isopic] .ip-flat {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 3;
	}
	[data-isopic] .ip-gas {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 3;
	}
	[data-isopic] .ip-ideal {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.4;
		stroke-dasharray: 5 4;
	}
	[data-isopic] .ip-pt {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
</style>
