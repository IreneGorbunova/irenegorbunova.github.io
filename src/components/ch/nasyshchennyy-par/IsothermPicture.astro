---
/**
 * The isotherm of water vapor at 20 °C: 0,05 г of water in a cylinder under a piston, no air. While some water is
 * left, the vapor is saturated and its pressure stays p_н = 2,34 кПа (psat.ts, IAPWS-IF97) whatever the volume; all
 * the water has turned into vapor at V = m/ρ_н = 0,05 г / 17,3 г/м³ = 2,89 л, and beyond that the unsaturated vapor
 * behaves almost as an ideal gas: p = 2,34 кПа · 2,89 л / V (dashed on the left: what an ideal gas would do).
 * Axes: V 0–8 л, p 0–4 кПа. Three numbered states with a cylinder each, under the graph (heights ∝ V, 9 px per л):
 * 1 — 1 л: water at the bottom and saturated vapor (0,017 г of it), 2,34 кПа; 2 — 2,89 л: the last drop has just
 * evaporated, 2,34 кПа; 3 — 6 л: only unsaturated vapor, 2,34 · 2,89 / 6 = 1,13 кПа. The dots stand for the vapor,
 * one per 1/280 г (5, 14 and 14 dots); the water layer is drawn much thicker than 0,05 мм.
 */
import G7Styles from '../g7/G7Styles.astro';
import { psat, rhoSat } from './psat';

const X0 = 46;
const X1 = 290;
const Y0 = 200;
const Y1 = 24;
const x = (V: number) => X0 + (V / 8) * (X1 - X0);
const y = (p: number) => Y0 - (p / 4) * (Y0 - Y1);
const ps = psat(20);
const Vs = (0.05 / rhoSat(20)) * 1000; // л
const hyp: string[] = [];
for (let V = Vs; V <= 8.001; V += 0.1) hyp.push(`${x(V).toFixed(1)} ${y((ps * Vs) / V).toFixed(1)}`);
const ideal: string[] = [];
for (let V = (ps * Vs) / 4; V <= Vs + 0.001; V += 0.05) ideal.push(`${x(V).toFixed(1)} ${y((ps * Vs) / V).toFixed(1)}`);
const fmtc = (v: number, d = 2) => v.toFixed(d).replace('.', ',');
// the three states and their cylinders
let seed = 4;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const CB = 318; // the bottoms of the cylinders
const states = [
	{ n: 1, V: 1, cx: 56, water: 5, dots: Math.round((rhoSat(20) * 0.001 * 1) / (0.05 / 14)) },
	{ n: 2, V: Vs, cx: 148, water: 0.8, dots: 14 },
	{ n: 3, V: 6, cx: 240, water: 0, dots: 14 },
].map((s) => {
	const h = s.V * 9;
	const top = CB - h;
	const p = s.V <= Vs ? ps : (ps * Vs) / s.V;
	const dots = Array.from({ length: s.dots }, () => ({ x: s.cx - 14 + rnd() * 28, y: top + 3 + rnd() * (h - 6 - s.water) }));
	return { ...s, h, top, p, dots };
});
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-isopic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 330" role="img" aria-label={`График давления пара от объёма при 20 градусах: пока в сосуде есть вода, давление постоянно, ${fmtc(ps)} килопаскаля; когда вода вся испарилась, давление падает с ростом объёма. Под графиком три цилиндра: с водой и паром, с последней каплей, только с паром`}>
			<path class="ln" d={`M${X0} ${Y1 - 6} V${Y0} H${X1 + 6}`}></path>
			{[1, 2, 3, 4].map((p) => <g><path class="ln-dash" d={`M${X0} ${y(p)} H${X1}`} /><text class="t-small" x={X0 - 6} y={y(p) + 4} text-anchor="end">{p}</text></g>)}
			{[2, 4, 6, 8].map((V) => <text class="t-small" x={x(V)} y={Y0 + 15} text-anchor="middle">{V}</text>)}
			<text class="t-small" x={X0 + 6} y={Y1 - 10}><tspan class="t-i">p</tspan>, кПа</text>
			<text class="t-small" x={X1 + 4} y={Y0 + 28} text-anchor="end"><tspan class="t-i">V</tspan>, л</text>
			<polyline class="ip-ideal" points={ideal.join(' ')}></polyline>
			<path class="ip-flat" d={`M${x(0.15)} ${y(ps)} H${x(Vs)}`}></path>
			<polyline class="ip-gas" points={hyp.join(' ')}></polyline>
			<text class="t-small t-halo ip-blue" x={X0 + 8} y={y(ps) + 27}>вода и</text>
			<text class="t-small t-halo ip-blue" x={X0 + 8} y={y(ps) + 40}>насыщенный</text>
			<text class="t-small t-halo ip-blue" x={X0 + 8} y={y(ps) + 53}>пар</text>
			<text class="t-small t-halo ip-gold" x={x(5.4)} y={y(0.55)} text-anchor="middle">только ненасыщенный пар</text>
			<text class="t-small t-halo" x={x(2.25)} y={y(3.6)}>так вёл бы себя идеальный газ</text>
			<text class="t-strong t-halo" x={x(Vs) + 8} y={y(ps) - 8}>{fmtc(ps)}&nbsp;кПа</text>
			{
				states.map((s) => (
					<g>
						<circle class={s.n === 2 ? 'ip-pt' : 'ip-mark'} cx={x(s.V)} cy={y(s.p)} r="4"></circle>
						<circle class="ip-num" cx={x(s.V)} cy={s.n === 2 ? y(s.p) + 18 : y(s.p) - 14} r="7"></circle>
						<text class="ip-numt" x={x(s.V)} y={(s.n === 2 ? y(s.p) + 18 : y(s.p) - 14) + 4} text-anchor="middle">{s.n}</text>
						<!-- the cylinder -->
						<rect class="ip-vap" x={s.cx - 18} y={s.top} width="36" height={s.h}></rect>
						{s.water > 0 && <path class="ip-water" d={`M${s.cx - 18} ${CB - s.water} H${s.cx + 18} V${CB} H${s.cx - 18} Z`} />}
						{s.dots.map((d) => <circle class="ip-dot" cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="1.7" />)}
						<path class="ip-wall" d={`M${s.cx - 18} ${s.top - 12} V${CB} H${s.cx + 18} V${s.top - 12}`}></path>
						<rect class="ip-piston" x={s.cx - 17} y={s.top - 5} width="34" height="5" rx="1"></rect>
						<path class="ip-rod" d={`M${s.cx} ${s.top - 5} V${s.top - 14}`}></path>
						<circle class="ip-num" cx={s.cx - 30} cy={CB - 8} r="7"></circle>
						<text class="ip-numt" x={s.cx - 30} y={CB - 4.2} text-anchor="middle">{s.n}</text>
						<text class="t-small" x={s.cx + 24} y={CB - 3}>{s.n === 2 ? fmtc(s.V, 1) : s.V}&nbsp;л</text>
					</g>
				))
			}
		</svg>
	</div>
	<figcaption class="g7__caption">0,05&nbsp;г воды под поршнем при 20&nbsp;°C, воздуха нет. Пока вода не испарилась вся (до 2,9&nbsp;л), давление пара не зависит от объёма. Внизу — цилиндр в трёх отмеченных состояниях; слой воды нарисован толще, чем он есть.</figcaption>
</figure>

<style is:global>
	[data-isopic] .ip-flat { fill: none; stroke: var(--g7-blue); stroke-width: 3; }
	[data-isopic] .ip-gas { fill: none; stroke: var(--g7-gold); stroke-width: 3; }
	[data-isopic] .ip-ideal { fill: none; stroke: var(--g7-line); stroke-width: 1.4; stroke-dasharray: 5 4; }
	[data-isopic] .ip-pt { fill: var(--g7-paper); stroke: var(--g7-ink); stroke-width: 2; }
	[data-isopic] .ip-mark { fill: var(--g7-ink); }
	[data-isopic] .ip-num { fill: var(--g7-paper); stroke: var(--g7-line); stroke-width: 1; }
	[data-isopic] .ip-numt { font-size: 11.5px; font-weight: 700; fill: var(--g7-ink); }
	[data-isopic] .ip-blue { fill: var(--g7-blue); }
	[data-isopic] .ip-gold { fill: var(--g7-gold); }
	[data-isopic] .ip-vap { fill: color-mix(in oklab, var(--g7-glass) 20%, transparent); }
	[data-isopic] .ip-water { fill: var(--g7-water); stroke: var(--g7-water-edge); stroke-width: 1; }
	[data-isopic] .ip-dot { fill: var(--g7-blue); }
	[data-isopic] .ip-wall { fill: none; stroke: var(--g7-ink); stroke-width: 1.6; }
	[data-isopic] .ip-piston { fill: var(--g7-steel); stroke: var(--g7-ink); stroke-width: 1; }
	[data-isopic] .ip-rod { stroke: var(--g7-ink); stroke-width: 2; }
</style>
