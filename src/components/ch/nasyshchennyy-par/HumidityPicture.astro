---
/**
 * Picture «Парциальное давление и относительная влажность»: air at 20 °C with the relative humidity 40 %. Left: the
 * air, gray dots for nitrogen and oxygen, blue dots for water vapour, 101 кПа in all. Middle: the same blue dots alone,
 * the water vapour without the other gases: its partial pressure p = 0,4 · 2,34 = 0,94 кПа. Right: saturated vapour
 * at the same 20 °C, 2,5 times as many blue dots (8 and 20), p_н = 2,34 кПа (psat.ts, IAPWS-IF97). φ = 0,94 / 2,34 · 100 % = 40 %.
 * Not to scale in one way only: there should be (101,3 − 0,94) / 0,94 ≈ 107 times more gray dots than blue ones, here
 * there are 11 times more (the caption says so). Dot positions come from a fixed pseudo-random sequence.
 */
import G7Styles from '../g7/G7Styles.astro';

let seed = 7;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const BW = 104;
const BH = 96;
const BY = 30;
const xs = [6, 128, 250];
const pt = () => ({ x: 5 + rnd() * (BW - 10), y: 5 + rnd() * (BH - 10) });
const water = Array.from({ length: 8 }, pt);
const gas = Array.from({ length: 90 }, pt);
const sat = [...water, ...Array.from({ length: 12 }, pt)];
---

<G7Styles />
<figure class="g7 g7--pic not-content" data-humpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 236" role="img" aria-label="Слева воздух: серые молекулы азота и кислорода и синие молекулы водяного пара, давление 101 килопаскаль. В середине — только молекулы пара из этого воздуха: 0,94 килопаскаля. Справа — насыщенный пар при той же температуре: молекул в 2,5 раза больше, 2,34 килопаскаля. Относительная влажность 40 процентов">
			<text class="t-small" x={xs[0] + BW / 2} y="20" text-anchor="middle">воздух</text>
			<text class="t-small" x={xs[1] + BW / 2} y="20" text-anchor="middle">только пар из него</text>
			<text class="t-small" x={xs[2] + BW / 2} y="20" text-anchor="middle">насыщенный пар</text>
			{xs.map((x) => <rect class="hp-box" x={x} y={BY} width={BW} height={BH} rx="3"></rect>)}
			{gas.map((d) => <circle class="hp-gas" cx={xs[0] + d.x} cy={BY + d.y} r="1.8"></circle>)}
			{water.map((d) => <circle class="hp-h2o" cx={xs[0] + d.x} cy={BY + d.y} r="2.4"></circle>)}
			{water.map((d) => <circle class="hp-h2o" cx={xs[1] + d.x} cy={BY + d.y} r="2.4"></circle>)}
			{sat.map((d) => <circle class="hp-h2o" cx={xs[2] + d.x} cy={BY + d.y} r="2.4"></circle>)}
			<text class="t-strong" x={xs[0] + BW / 2} y={BY + BH + 18} text-anchor="middle">101&nbsp;кПа</text>
			<text class="t-strong" x={xs[1] + BW / 2} y={BY + BH + 18} text-anchor="middle"><tspan class="t-i">p</tspan> = 0,94&nbsp;кПа</text>
			<text class="t-strong" x={xs[2] + BW / 2} y={BY + BH + 18} text-anchor="middle"><tspan class="t-i">p</tspan><tspan class="hp-sub" dy="3">н</tspan><tspan dy="-3"> = 2,34&nbsp;кПа</tspan></text>
			<text class="t-small" x={xs[1] + BW / 2} y={BY + BH + 33} text-anchor="middle">парциальное</text>
			<text class="t-small" x={xs[1] + BW / 2} y={BY + BH + 47} text-anchor="middle">давление пара</text>
			<text class="t-small" x={xs[2] + BW / 2} y={BY + BH + 33} text-anchor="middle">при той же</text>
			<text class="t-small" x={xs[2] + BW / 2} y={BY + BH + 47} text-anchor="middle">температуре</text>
			<text class="t-strong" x="180" y={BY + BH + 72} text-anchor="middle"><tspan class="t-i">φ</tspan> = 0,94 / 2,34 · 100&nbsp;% = 40&nbsp;%</text>
			<circle class="hp-h2o" cx="56" cy="228" r="2.4"></circle>
			<text class="t-small" x="62" y="232">молекулы воды</text>
			<circle class="hp-gas" cx="196" cy="228" r="1.8"></circle>
			<text class="t-small" x="202" y="232">азот и кислород</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Воздух при 20&nbsp;°C с относительной влажностью 40&nbsp;%. На самом деле молекул азота и кислорода в таком воздухе примерно в 110&nbsp;раз больше, чем молекул воды.</figcaption>
</figure>

<style is:global>
	[data-humpic] .hp-box {
		fill: color-mix(in oklab, var(--g7-blue) 5%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	[data-humpic] .hp-gas {
		fill: var(--g7-line);
	}
	[data-humpic] .hp-h2o {
		fill: var(--g7-blue);
	}
	[data-humpic] .hp-sub {
		font-size: 0.75em;
	}
	@media (max-width: 40rem) {
		[data-humpic] .g7__svg .t-small {
			font-size: 12.5px;
		}
	}
</style>
