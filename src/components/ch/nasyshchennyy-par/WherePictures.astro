---
/**
 * Small pictures for «Где это встречается» of «Насыщенный пар. Влажность воздуха» (school-style schemes, not to scale;
 * two columns, one on a phone). The vapor and the curve color is blue (--g7-blue), heat red, as in the chapter.
 * 1. Autoclave: a horizontal steel chamber with a round door, trays of instruments inside, steam; the gauge points at
 *    about 205 кПа (absolute), where water boils at 121 °C (psat.ts: p_н(121 °C) = 205 кПа), the temperature at which
 *    instruments are sterilized (15–20 мин).
 * 2. Vacuum pan of a sugar factory: a closed boiling vessel with a heating coil; a pump draws off the vapor and keeps
 *    the pressure at about 20–25 кПа, so the syrup boils at about 65–70 °C (water itself boils at 60–65 °C there; the
 *    dissolved sugar raises it a little) and the sugar does not caramelize.
 * 3. Dehumidifier: a fan draws humid room air over a coil cooled below the dew point; the vapor condenses on it, the
 *    drops run into a tank, and drier air leaves (it is also warmed by the condenser).
 * 4. Contrail: the exhaust of a jet engine is hot and humid (burning kerosene gives about 1,25 кг of water per kilogram
 *    of fuel); mixed with air at −40…−50 °C at 10–11 км it cools below its dew point and the vapor turns into droplets
 *    that freeze at once into ice crystals: a white trail behind each engine.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic npw not-content" data-npwhere>
	<div class="g7__grid is-two">
		<div class="npw__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Автоклав: стальная камера с круглой дверцей, внутри на полках инструменты в горячем паре, манометр показывает около 205 килопаскалей">
				<rect class="npw__floor" x="0" y="104" width="160" height="16"></rect>
				<rect class="npw__steel" x="18" y="30" width="104" height="66" rx="30"></rect>
				<rect class="npw__inside" x="34" y="40" width="72" height="46" rx="20"></rect>
				<path class="npw__shelf" d="M40 56 H100 M40 74 H100"></path>
				<path class="npw__tool" d="M48 54 l10 -4 M52 54 l10 -4 M66 54 h14 M84 53 l8 -3 M48 72 h12 M66 72 l12 -4 M82 72 h14"></path>
				{[[46, 46], [62, 64], [80, 44], [92, 66], [56, 80], [86, 80]].map(([cx, cy]) => <circle class="npw__steam" cx={cx} cy={cy} r="4" />)}
				<path class="npw__steel-d" d="M28 96 L24 104 M112 96 L116 104"></path>
				<circle class="npw__gauge" cx="134" cy="38" r="13"></circle>
				<path class="npw__pipe" d="M122 46 H128 V51"></path>
				<path class="npw__scale" d="M124.8 47.2 A13 13 0 1 1 143.2 47.2"></path>
				<path class="npw__needle" d="M134 38 L142 30"></path>
				<circle class="npw__hub" cx="134" cy="38" r="1.6"></circle>
				<text class="t-small" x="142" y="72" text-anchor="middle">121&nbsp;°C</text>
			</svg>
			<p>Автоклав</p>
		</div>
		<div class="npw__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Вакуум-аппарат сахарного завода: в закрытом котле кипит сироп, насос откачивает пар, поэтому сироп кипит примерно при 65 градусах">
				<rect class="npw__floor" x="0" y="104" width="160" height="16"></rect>
				<path class="npw__steel" d="M26 40 Q26 14 62 14 Q98 14 98 40 V86 Q98 98 62 98 Q26 98 26 86 Z"></path>
				<path class="npw__syrup" d="M30 60 H94 V86 Q94 94 62 94 Q30 94 30 86 Z"></path>
				<path class="npw__coil" d="M36 84 Q40 78 44 84 T52 84 T60 84 T68 84 T76 84 T84 84 T92 84"></path>
				{[[42, 70, 2.5], [56, 66, 3], [70, 72, 2.2], [82, 67, 2.8], [50, 78, 1.8], [76, 80, 2]].map(([cx, cy, r]) => <circle class="npw__bubble" cx={cx} cy={cy} r={r} />)}
				{[[50, 48], [66, 40], [78, 50], [60, 30]].map(([cx, cy]) => <circle class="npw__steam" cx={cx} cy={cy} r="3.4" />)}
				<path class="npw__pipe-w" d="M62 14 V6 H122 V44"></path>
				<rect class="npw__pump" x="110" y="44" width="26" height="22" rx="4"></rect>
				<circle class="npw__fan" cx="123" cy="55" r="7"></circle>
				<path class="npw__arrow" d="M80 6 H100"></path>
				<path class="npw__head" d="M104 6 L98 3 V9 Z"></path>
				<path class="npw__steel-d" d="M34 96 L30 104 M90 96 L94 104"></path>
				<text class="t-small" x="124" y="84" text-anchor="middle">≈ 65&nbsp;°C</text>
			</svg>
			<p>Вакуум-аппарат сахарного завода</p>
		</div>
		<div class="npw__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Осушитель воздуха: влажный воздух проходит через холодный змеевик, пар конденсируется на нём, капли стекают в бак, выходит сухой воздух">
				<rect class="npw__floor" x="0" y="104" width="160" height="16"></rect>
				<rect class="npw__case" x="57" y="14" width="56" height="90" rx="6"></rect>
				<path class="npw__cold" d="M64 24 H104 Q110 27 104 30 H66 Q60 33 66 36 H104 Q110 39 104 42 H66 Q60 45 66 48 H104 Q110 51 104 54 H64"></path>
				{[[70, 58], [84, 61], [98, 58], [77, 67], [91, 70]].map(([cx, cy]) => <path class="npw__drop" d={`M${cx} ${cy - 3} q2.6 3.4 0 5 q-2.6 -1.6 0 -5 Z`} />)}
				<rect class="npw__tank" x="62" y="80" width="46" height="20" rx="3"></rect>
				<rect class="npw__tankw" x="64" y="90" width="42" height="8" rx="2"></rect>
				{[[8, 50], [17, 57], [27, 49], [11, 64], [32, 60]].map(([cx, cy]) => <circle class="npw__vap" cx={cx} cy={cy} r="1.8" />)}
				<path class="npw__arrow" d="M4 40 H46"></path>
				<path class="npw__head" d="M53 40 L46 36.5 V43.5 Z"></path>
				<path class="npw__arrow" d="M118 40 H150"></path>
				<path class="npw__head" d="M156 40 L149 36.5 V43.5 Z"></path>
				<circle class="npw__vap" cx="136" cy="52" r="1.8"></circle>
				<text class="t-small" x="137" y="30" text-anchor="middle">сухой</text>
				<text class="t-small" x="3" y="30">влажный</text>
			</svg>
			<p>Осушитель воздуха</p>
		</div>
		<div class="npw__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Самолёт на высоте 10 километров, где мороз минус 50 градусов; за двигателями тянутся белые полосы — конденсационные следы">
				<rect class="npw__sky" x="0" y="0" width="160" height="120"></rect>
				<path class="npw__trail" d="M4 82 Q54 74 100 68"></path>
				<path class="npw__trail npw__trail--2" d="M4 72 Q52 66 98 61"></path>
				<g transform="translate(96 58) rotate(-8)">
					<path class="npw__plane" d="M0 0 H44 Q54 0 56 4 Q54 8 44 8 H4 Q-2 8 -4 2 L-6 -10 H0 Z"></path>
					<path class="npw__wing" d="M18 4 L6 20 H12 L30 5 Z"></path>
					<rect class="npw__engine" x="4" y="9" width="10" height="4" rx="2"></rect>
					<path class="npw__win" d="M14 2.5 H44"></path>
				</g>
				<text class="t-small npw__ink" x="8" y="22">10&nbsp;км, −50&nbsp;°C</text>
			</svg>
			<p>Конденсационный след самолёта</p>
		</div>
	</div>
</figure>

<style is:global>
	.npw__cell p { margin: 0.3rem 0 0; text-align: center; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); }
	[data-npwhere] .npw__floor { fill: var(--g7-ground); }
	[data-npwhere] .npw__steel { fill: var(--g7-steel); stroke: var(--g7-ink); stroke-width: 1.2; }
	[data-npwhere] .npw__steel-d { stroke: var(--g7-ink); stroke-width: 2; fill: none; }
	[data-npwhere] .npw__inside { fill: color-mix(in oklab, var(--g7-red) 14%, var(--g7-paper)); stroke: var(--g7-ink); stroke-width: 1; }
	[data-npwhere] .npw__shelf { stroke: var(--g7-line); stroke-width: 1.4; }
	[data-npwhere] .npw__tool { stroke: var(--g7-ink); stroke-width: 1.3; stroke-linecap: round; }
	[data-npwhere] .npw__steam { fill: var(--g7-blue); opacity: 0.35; }
	[data-npwhere] .npw__gauge { fill: var(--g7-paper); stroke: var(--g7-ink); stroke-width: 1.2; }
	[data-npwhere] .npw__scale { fill: none; stroke: var(--g7-line); stroke-width: 1; stroke-dasharray: 1 2.2; }
	[data-npwhere] .npw__needle { stroke: var(--g7-red); stroke-width: 1.6; stroke-linecap: round; }
	[data-npwhere] .npw__hub { fill: var(--g7-ink); }
	[data-npwhere] .npw__pipe { fill: none; stroke: var(--g7-ink); stroke-width: 2; }
	[data-npwhere] .npw__pipe-w { fill: none; stroke: var(--g7-steel-dark); stroke-width: 4; stroke-linejoin: round; }
	[data-npwhere] .npw__syrup { fill: color-mix(in oklab, var(--g7-gold) 45%, var(--g7-paper)); }
	[data-npwhere] .npw__coil { fill: none; stroke: var(--g7-red); stroke-width: 1.6; }
	[data-npwhere] .npw__bubble { fill: var(--g7-paper); stroke: var(--g7-ink); stroke-width: 0.6; opacity: 0.8; }
	[data-npwhere] .npw__pump { fill: var(--g7-steel-dark); stroke: var(--g7-ink); stroke-width: 1; }
	[data-npwhere] .npw__fan { fill: none; stroke: var(--g7-ink); stroke-width: 1; stroke-dasharray: 3 2; }
	[data-npwhere] .npw__arrow { stroke: var(--g7-blue); stroke-width: 1.6; fill: none; }
	[data-npwhere] .npw__head { fill: var(--g7-blue); }
	[data-npwhere] .npw__case { fill: color-mix(in oklab, var(--g7-glass) 30%, var(--g7-paper)); stroke: var(--g7-ink); stroke-width: 1.2; }
	[data-npwhere] .npw__cold { fill: none; stroke: color-mix(in oklab, var(--g7-blue) 60%, var(--sl-color-white)); stroke-width: 2.4; stroke-linejoin: round; }
	[data-npwhere] .npw__drop { fill: var(--g7-blue); }
	[data-npwhere] .npw__tank { fill: var(--g7-paper); stroke: var(--g7-ink); stroke-width: 1; }
	[data-npwhere] .npw__tankw { fill: var(--g7-water); }
	[data-npwhere] .npw__vap { fill: var(--g7-blue); }
	[data-npwhere] .npw__sky { fill: var(--g7-sky); }
	[data-npwhere] .npw__trail { fill: none; stroke: var(--sl-color-white); stroke-width: 3; stroke-linecap: round; opacity: 0.85; }
	:root[data-theme='light'] [data-npwhere] .npw__trail { stroke: hsl(210, 20%, 98%); }
	:root[data-theme='light'] [data-npwhere] .npw__sky { fill: hsl(208, 60%, 72%); }
	[data-npwhere] .npw__trail--2 { opacity: 0.6; }
	[data-npwhere] .npw__plane { fill: var(--sl-color-gray-6); stroke: var(--g7-ink); stroke-width: 0.9; }
	:root[data-theme='light'] [data-npwhere] .npw__plane { fill: hsl(0, 0%, 98%); }
	[data-npwhere] .npw__wing { fill: var(--sl-color-gray-5); stroke: var(--g7-ink); stroke-width: 0.8; }
	[data-npwhere] .npw__engine { fill: var(--sl-color-gray-4); stroke: var(--g7-ink); stroke-width: 0.6; }
	[data-npwhere] .npw__win { stroke: var(--g7-blue); stroke-width: 1.2; stroke-dasharray: 1.4 1.6; }
	[data-npwhere] .npw__ink { fill: var(--g7-ink); }
</style>
