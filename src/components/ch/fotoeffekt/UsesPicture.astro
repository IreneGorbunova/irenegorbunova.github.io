---
/**
 * Small pictures for «Где это встречается»: a street lamp with a light sensor, the sound track of a film read by a
 * photocell, the electron avalanche in a photomultiplier (1 → 2 → 4 → 8 electrons, symbolic), a solar panel
 * lighting a lamp.
 */
import FeStyles from './FeStyles.astro';
import { lightColor } from './physics';
import { packet } from './draw';

const uid = Math.random().toString(36).slice(2, 8);
const mE = `fpu-e-${uid}`;
const ph = lightColor(450);
const sun = lightColor(580);
// the sound track: stripes of different transparency
const track = Array.from({ length: 11 }, (_, i) => ({ y: 8 + i * 10, o: (0.25 + 0.7 * Math.abs(Math.sin(i * 1.3))).toFixed(2) }));
// photomultiplier: dynodes alternate up and down, the number of electrons doubles
const dyn = [
	{ x: 50, y: 86 },
	{ x: 74, y: 46 },
	{ x: 98, y: 86 },
	{ x: 122, y: 46 },
];
const swarm = (x0: number, y0: number, x1: number, y1: number, n: number) =>
	Array.from({ length: n }, (_, k) => {
		const f = (k + 1) / (n + 1);
		const off = (k - (n - 1) / 2) * 4;
		return { x: (x0 + (x1 - x0) * f + off).toFixed(1), y: (y0 + (y1 - y0) * f - off * 0.6).toFixed(1) };
	});
const pmt = [
	...swarm(26, 66, 50, 82, 1),
	...swarm(50, 82, 74, 50, 2),
	...swarm(74, 50, 98, 82, 4),
	...swarm(98, 82, 122, 50, 8),
];
const items = [
	{ id: 'lamp', name: 'Фонарь с датчиком света' },
	{ id: 'film', name: 'Звуковая дорожка кино' },
	{ id: 'pmt', name: 'Фотоэлектронный умножитель' },
	{ id: 'solar', name: 'Солнечная батарея' },
];
---

<FeStyles />
<figure class="fp-pic fpu not-content" data-fe-uses>
	<div class="fpu__grid">
		{
			items.map((it) => (
				<div class="fpu__item">
					<svg class="fp-pic__svg" viewBox="0 0 160 120" role="img" aria-label={it.name}>
						{it.id === 'lamp' && (
							<g>
								<rect class="fpu-night" x="0" y="0" width="160" height="104" />
								<circle class="fpu-moon" cx="30" cy="24" r="9" />
								<rect class="fpu-ground" x="0" y="104" width="160" height="16" />
								<path class="fpu-glow" d="M96 30 L126 30 L150 106 L72 106 Z" />
								<line class="fpu-post" x1="80" y1="106" x2="80" y2="22" />
								<path class="fpu-post" d="M80 24 L104 24" />
								<path class="fpu-lamp" d="M96 20 L118 22 L126 30 L96 30 Z" />
								<rect class="fp-metal" x="73" y="52" width="14" height="10" rx="2" />
								<path class="fpu-eye" d="M75 52 A5 5 0 0 1 85 52 Z" />
								<path class="fp-photon" d={packet(58, 30, Math.atan2(20, 18), 22, 6, 2.5)} style={`stroke: ${ph}; opacity: 0.5`} />
							</g>
						)}
						{it.id === 'film' && (
							<g>
								<rect class="fpu-film" x="58" y="0" width="44" height="120" />
								{[6, 46, 86].map((y) => (
									<rect class="fpu-frame" x="62" y={y} width="26" height="30" rx="2" />
								))}
								{track.map((s) => (
									<rect class="fpu-track" x="92" y={s.y - 4} width="6" height="9" style={`opacity: ${s.o}`} />
								))}
								<circle class="fpu-bulb" cx="30" cy="60" r="11" />
								<path class="fpu-beam" d="M40 56 L95 58 L95 62 L40 64 Z" />
								<rect class="fp-metal" x="112" y="50" width="14" height="20" rx="3" />
								<path class="fp-wire" d="M126 60 L140 60 L140 84" />
								<path class="fpu-speaker" d="M134 84 L146 84 L152 100 L128 100 Z" />
							</g>
						)}
						{it.id === 'pmt' && (
							<g>
								<defs>
									<marker id={mE} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
										<path class="fpu-ehead" d="M0 0 L10 5 L0 10 z" />
									</marker>
								</defs>
								<rect class="fp-glass" x="4" y="22" width="152" height="80" rx="30" />
								<path class="fpu-path" d="M24 64 L50 86 L74 46 L98 86 L122 46 L136 58" />
								<line class="fpu-cathode" x1="22" y1="40" x2="22" y2="84" />
								<path class="fp-photon" d={packet(10, 62, 0, 18, 5, 2.5)} style={`stroke: ${ph}`} />
								{dyn.map((d) => (
									<line class="fpu-dynode" x1={d.x - 8} y1={d.y} x2={d.x + 8} y2={d.y} />
								))}
								<line class="fpu-anode" x1="138" y1="40" x2="138" y2="84" />
								{pmt.map((p) => (
									<circle class="fp-e" cx={p.x} cy={p.y} r="2.3" />
								))}
								<line class="fpu-earrow" x1="126" y1="50" x2="134" y2="56" marker-end={`url(#${mE})`} />
								<text class="fpu-n" x="38" y="112">1</text>
								<text class="fpu-n" x="62" y="16">2</text>
								<text class="fpu-n" x="86" y="112">4</text>
								<text class="fpu-n" x="110" y="16">8</text>
							</g>
						)}
						{it.id === 'solar' && (
							<g>
								<circle class="fpu-sun" cx="24" cy="22" r="11" />
								<path class="fp-photon" d={packet(52, 42, Math.atan2(26, 26), 24, 7, 2.5)} style={`stroke: ${sun}`} />
								<path class="fp-photon" d={packet(36, 62, Math.atan2(26, 26), 24, 7, 2.5)} style={`stroke: ${sun}`} />
								<path class="fpu-panel" d="M50 96 L84 60 L134 60 L100 96 Z" />
								<path class="fpu-grid" d="M67 78 L117 78 M75 69 L125 69 M58 87 L108 87 M67 96 L101 60 M84 96 L118 60" />
								<path class="fp-wire" d="M100 96 L100 108 L146 108 L146 88" />
								<circle class="fpu-on" cx="146" cy="80" r="8" />
							</g>
						)}
					</svg>
					<p class="fpu__name">{it.name}</p>
				</div>
			))
		}
	</div>
</figure>

<style is:global>
	.fpu__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.fpu__name {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.3;
		color: var(--sl-color-gray-2);
		text-align: center;
	}
	@media (max-width: 40rem) {
		.fpu__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.fpu-night {
		fill: color-mix(in srgb, var(--ig-vx) 12%, transparent);
	}
	:root[data-theme='light'] .fpu-night {
		fill: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-white));
	}
	.fpu-moon,
	.fpu-sun {
		fill: var(--ig-v);
	}
	.fpu-ground {
		fill: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-5));
	}
	.fpu-glow {
		fill: color-mix(in srgb, var(--ig-v) 30%, transparent);
	}
	.fpu-post {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
		fill: none;
	}
	.fpu-lamp {
		fill: var(--ig-v);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.fpu-eye {
		fill: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-gray-3));
	}
	.fpu-film {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.fpu-frame {
		fill: color-mix(in srgb, var(--ig-vx) 20%, var(--sl-color-gray-4));
	}
	.fpu-track {
		fill: var(--sl-color-gray-1);
	}
	.fpu-bulb {
		fill: var(--ig-v);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.fpu-beam {
		fill: color-mix(in srgb, var(--ig-v) 45%, transparent);
	}
	.fpu-speaker {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.fpu-cathode,
	.fpu-anode {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.fpu-dynode {
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.fpu-path {
		fill: none;
		stroke: color-mix(in srgb, var(--fp-e) 35%, transparent);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.fpu-earrow {
		stroke: var(--fp-e);
		stroke-width: 1.4;
	}
	.fpu-ehead {
		fill: var(--fp-e);
	}
	.fp-pic .fpu-n {
		font-size: 11px;
		fill: var(--fp-e);
		text-anchor: middle;
	}
	.fpu-panel {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.fpu-grid {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-gray-1) 50%, transparent);
		stroke-width: 0.8;
	}
	.fpu-on {
		fill: var(--ig-v);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
</style>
