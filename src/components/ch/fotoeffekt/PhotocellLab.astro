	const kd = (t: string, el: HTMLElement) =>
		katex.render(t, el, { throwOnError: false, displayMode: true, fleqn: true });

	type Photon = { el: SVGPathElement; x0: number; y0: number; x1: number; y1: number; t: number; T: number; ang: number; ok: boolean; xmm: number };
	type Electron = {
		g: SVGGElement;
		c: SVGCircleElement;
		tail: SVGLineElement;
		x: number;
		y: number;
		vx: number;
		vy: number;
		fade: number;
	};
	type Flash = { el: SVGCircleElement; t: number; T: number; r0: number; r1: number };
	type Saved = { nm: number; inten: number; metal: Metal; Ek: number };

	function packet(nm: number) {
		const lam = 4.5 + nm / 55; // visual wavelength in px (longer for red light)
		const amp = 4;
		const pts: string[] = [];
		const n = 30;
		for (let i = 0; i <= n; i++) {
			const x = -1.6 * lam + (3.2 * lam * i) / n;
			const env = Math.exp(-((x / (1.15 * lam)) ** 2));
			const y = amp * env * Math.sin((2 * Math.PI * x) / lam);
			pts.push(`${x.toFixed(1)} ${y.toFixed(2)}`);
		}
		return `M ${pts.join(' L ')}`;
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-fe-lab]')) {
		const table = JSON.parse(root.dataset.phi!) as PhiTable;
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;

		const svg = q<SVGSVGElement>('[data-scene]');
		const gPh = q<SVGGElement>('[data-photons]');
		const gFl = q<SVGGElement>('[data-flashes]');
		const gEl = q<SVGGElement>('[data-electrons]');
		const beam = q<SVGPolygonElement>('[data-beam]');
		const spot = q<SVGRectElement>('[data-spot]');
		const needle = q<SVGLineElement>('[data-needle]');
		const amText = q<SVGTextElement>('[data-am-text]');
		const vmText = q<SVGTextElement>('[data-vm-text]');
		const amPhone = q<HTMLElement>('[data-am-phone]');
		const vmPhone = q<HTMLElement>('[data-vm-phone]');
		const lampText = q<SVGTextElement>('[data-lamp-text]');
		const cathText = q<SVGTextElement>('[data-cathode-text]');
		const signA = q<SVGTextElement>('[data-sign-a]');
		const signC = q<SVGTextElement>('[data-sign-c]');
		const fieldL = q<SVGLineElement>('[data-field-l]');
		const fieldR = q<SVGLineElement>('[data-field-r]');
		const fieldLabel = q<SVGTextElement>('[data-field-label]');
		const batLong = q<SVGLineElement>('[data-bat-long]');
		const batShort = q<SVGLineElement>('[data-bat-short]');
		const batTop = q<SVGTextElement>('[data-bat-top]');
		const batBot = q<SVGTextElement>('[data-bat-bot]');

		const nmIn = q<HTMLInputElement>('[data-nm]');
		const intIn = q<HTMLInputElement>('[data-int]');
		const uIn = q<HTMLInputElement>('[data-u]');
		const nmOut = q<HTMLOutputElement>('[data-nm-out]');
		const intOut = q<HTMLOutputElement>('[data-int-out]');
		const uOut = q<HTMLOutputElement>('[data-u-out]');
		const kr = q<HTMLElement>('[data-kr]');
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-metal]'));
		const lightBtn = q<HTMLButtonElement>('[data-light]');
		const saveBtn = q<HTMLButtonElement>('[data-save]');
		const clearBtn = q<HTMLButtonElement>('[data-clear]');
		const pauseBtn = q<HTMLButtonElement>('[data-pause]');
		const playBtn = q<HTMLButtonElement>('[data-play]');

		const ivPlot = q<SVGSVGElement>('[data-iv]');
		const curve = q<SVGPathElement>('[data-curve]');
		const ghosts = q<SVGGElement>('[data-ghosts]');
		const legend = q<HTMLUListElement>('[data-legend]');
		const point = q<SVGCircleElement>('[data-point]');
		const drop = q<SVGLineElement>('[data-drop]');
		const uzLine = q<SVGLineElement>('[data-uz-line]');
		const uzText = q<SVGTextElement>('[data-uz-text]');
		const inLine = q<SVGLineElement>('[data-in-line]');
		const inText = q<SVGTextElement>('[data-in-text]');

		const segPhoton = q<HTMLElement>('[data-seg-photon]');
		const segShort = q<HTMLElement>('[data-seg-short]');
		const segWork = q<HTMLElement>('[data-seg-work]');
		const segKin = q<HTMLElement>('[data-seg-kin]');
		const segPhotonT = q<HTMLElement>('[data-seg-photon-t]');
		const segShortT = q<HTMLElement>('[data-seg-short-t]');
		const segWorkT = q<HTMLElement>('[data-seg-work-t]');
		const segKinT = q<HTMLElement>('[data-seg-kin-t]');
		const calc = [1, 2, 3, 4, 5].map((i) => q<HTMLElement>(`[data-calc-${i}]`));
		const live = q<HTMLElement>('[data-live]');

		// Lamp aperture and the lit spot (in SVG units), read from the drawn beam.
		const bp = beam.points;
		const aL = { x: bp.getItem(0).x, y: bp.getItem(0).y };
		const aR = { x: bp.getItem(1).x, y: bp.getItem(1).y };
		const sR = { x: bp.getItem(2).x, y: bp.getItem(2).y };
		const sL = { x: bp.getItem(3).x, y: bp.getItem(3).y };

		let metal = METALS[0];
		let lightOn = true;
		let running = !reduceMotion.matches;
		let visible = false;
		let raf = 0;
		let last = 0;
		let nextPhoton = 0;
		let shownI = 0;
		/** Photons are reaching the cathode (after "light on" the first ones are still on their way). */
		let cathodeLit = true;
		let packetD = packet(400);
		const saved: Saved[] = [];
		const photons: Photon[] = [];
		const electrons: Electron[] = [];
		const flashes: Flash[] = [];

		const state = () => {
			const nm = Number(nmIn.value);
			const inten = Number(intIn.value);
			const U = Number(uIn.value);
			const Eph = photonEV(nm);
			const Ek = Eph - metal.A;
			// current while photons reach the cathode, and the current the meter tends to now
			const Ilit = ((I_MAX * inten) / 100) * currentShare(table, U, Ek);
			const I = lightOn ? Ilit : 0;
			// what the equation shows: rounded hν minus A, so that the printed numbers add up exactly
			const EkShown = (Math.round(Eph * 100) - Math.round(metal.A * 100)) / 100;
			return { nm, inten, U, Eph, Ek, EkShown, I, Ilit };
		};

		/* ---------- static parts: readouts, graph, equation ---------- */
		const curvePath = (Ek: number, inten: number) => {
			const Is = (I_MAX * inten) / 100;
			if (Ek <= 0 || Is === 0) return `M ${pu(-5)} ${pi(0)} H ${pu(5)}`;
			const pts: string[] = [];
			const Ustart = Math.max(-5, -Ek);
			if (Ustart > -5) pts.push(`${pu(-5).toFixed(1)} ${pi(0).toFixed(1)}`);
			const n = 160;
			for (let i = 0; i <= n; i++) {
				// denser sampling near the stopping voltage
				const t = i / n;
				const U = Ustart + (5 - Ustart) * t * t;
				pts.push(`${pu(U).toFixed(1)} ${pi(Is * currentShare(table, U, Ek)).toFixed(1)}`);
			}
			return `M ${pts.join(' L ')}`;
		};

		const drawLegend = (s: ReturnType<typeof state>) => {
			legend.replaceChildren();
			const add = (nm: number, inten: number, m: Metal, now: boolean) => {
				const li = document.createElement('li');
				li.style.setProperty('--c', lightColor(nm));
				if (now) li.classList.add('is-now');
				li.textContent = `${now ? 'сейчас: ' : ''}${nm}\u00a0нм, ${m.name.toLowerCase()}, ${inten}\u00a0%`;
				legend.append(li);
			};
			saved.forEach((c) => add(c.nm, c.inten, c.metal, false));
			if (saved.length) add(s.nm, s.inten, metal, true);
		};

		const drawGhosts = () => {
			ghosts.replaceChildren();
			for (const c of saved) {
				const p = document.createElementNS(SVG_NS, 'path');
				p.classList.add('fe-lab__ghost');
				p.setAttribute('d', curvePath(c.Ek, c.inten));
				p.style.stroke = lightColor(c.nm);
				ghosts.append(p);
			}
			clearBtn.hidden = saved.length === 0;
		};

		/**
		 * One segment of an energy bar. A label that does not fit inside may go just to the
		 * right of the segment (outside = true) when the track has room there.
		 */
		const setSeg = (el: HTMLElement, t: HTMLElement, ev: number, label: string, outside = false, endEv = ev) => {
			const w = Math.max(ev, 0) / 6.5;
			el.style.width = `${(w * 100).toFixed(2)}%`;
			t.textContent = label;
			const track = el.parentElement?.clientWidth ?? 300;
			const need = label.length * 7 + 6;
			const fits = track * w > need;
			const roomRight = track * (1 - Math.max(endEv, 0) / 6.5) > need;
			const out = !fits && outside && ev > 0 && roomRight;
			el.classList.toggle('is-out', out);
			t.style.visibility = fits || out ? 'visible' : 'hidden';
		};

		const renderCalc = (s: ReturnType<typeof state>) => {
			const nu = freq(s.nm);
			const EJ = s.Eph * 1.6e-19;
			kd(
				`\\nu = \\dfrac{c}{\\lambda} = \\dfrac{3\\cdot10^{8}~\\text{м/с}}{${s.nm}\\cdot10^{-9}~\\text{м}} \\approx ${sci(nu)}~\\text{Гц}`,
				calc[0],
			);
			kd(
				`\\begin{aligned} h\\nu &= 6{,}63\\cdot10^{-34}~\\text{Дж·с}\\cdot ${sci(nu)}~\\text{Гц} \\\\ &\\approx ${sci(EJ)}~\\text{Дж} \\approx ${tex(s.Eph)}~\\text{эВ} \\end{aligned}`,
				calc[1],
			);
			calc[2].classList.toggle('is-key', true);
			if (s.Ek > 0) {
				kd(
					`\\underbrace{${tex(s.Eph)}~\\text{эВ}}_{h\\nu} = \\underbrace{${tex(metal.A)}~\\text{эВ}}_{A_{\\text{вых}}} + \\underbrace{${tex(s.EkShown)}~\\text{эВ}}_{E_{\\text{к}}}`,
					calc[2],
				);
				kd(
					`\\begin{aligned} \\upsilon_{\\max} &= \\sqrt{\\dfrac{2E_{\\text{к}}}{m}} = \\sqrt{\\dfrac{2\\cdot ${sci(s.Ek * 1.6e-19)}~\\text{Дж}}{9{,}1\\cdot10^{-31}~\\text{кг}}} \\\\ &\\approx ${Math.round(speedKmS(s.Ek))}~\\text{км/с} \\end{aligned}`,
					calc[3],
				);
				kd(`U_{\\text{з}} = \\dfrac{E_{\\text{к}}}{e} = ${tex(s.EkShown)}~\\text{В}`, calc[4]);
				calc[3].classList.remove('is-warn');
				calc[4].hidden = false;
			} else {
				kd(`h\\nu \\approx ${tex(s.Eph)}~\\text{эВ} < A_{\\text{вых}} = ${tex(metal.A)}~\\text{эВ}`, calc[2]);
				calc[3].classList.add('is-warn');
				calc[4].hidden = true;
				calc[3].innerHTML = '';
				const span = document.createElement('span');
				calc[3].append(
					`Энергии фотона не хватает, чтобы вырвать электрон из ${metal.gen}. Нужна длина волны меньше `,
					span,
					'.',
				);
				kx(`\\lambda_{\\text{кр}} = \\dfrac{hc}{A_{\\text{вых}}} = ${Math.round(redBoundary(metal.A))}~\\text{нм}`, span);
			}
		};

		const sayLive = (s: ReturnType<typeof state>) => {
			if (!lightOn) {
				live.textContent = 'Свет выключен: фотоны не падают на катод, и ток сразу прекращается.';
				return;
			}
			if (s.inten === 0) {
				live.textContent = 'Число фотонов равно нулю: на катод не падает свет.';
				return;
			}
			if (s.Ek <= 0) {
				live.textContent = `Каждый фотон несёт ${fmt(s.Eph)}\u00a0эВ, а работа выхода ${metal.gen} — ${fmt(metal.A, 1)}\u00a0эВ. Электроны не вылетают, сколько бы фотонов ни падало: фотоэффекта нет.`;
				return;
			}
			const share = currentShare(table, s.U, s.Ek);
			const v = Math.round(speedKmS(s.Ek));
			let tail: string;
			if (share < 0.0005) tail = `Поле тормозит электроны так сильно, что ни один не долетает до анода: <i>U</i> ≤ −<i>U</i><sub>з</sub>.`;
			else if (share > 0.995) tail = `До анода долетают все вылетевшие электроны — это ток насыщения.`;
			else tail = `До анода долетает ${Math.round(share * 100)}\u00a0% вылетевших электронов.`;
			live.innerHTML = `Электроны вылетают со скоростями до ${v}\u00a0км/с. ${tail}`;
		};

		const update = () => {
			const s = state();
			const col = lightColor(s.nm);
			root.style.setProperty('--fe-light', col);
			root.classList.toggle('is-dark', !lightOn || s.inten === 0);
			const op = lightOn ? 0.06 + 0.32 * (s.inten / 100) : 0;
			root.style.setProperty('--fe-beam-op', op.toFixed(3));
			beam.classList.toggle('is-uv', s.nm < 380);
			packetD = packet(s.nm);

			nmOut.value = `${s.nm} нм · ${colourName(s.nm)}`;
			intOut.value = `${s.inten} %`;
			uOut.value = `${sgn(s.U)} В`;
			lampText.textContent = s.nm < 380 ? `${s.nm} нм (невидимый)` : `${s.nm} нм`;
			cathText.textContent = `катод — ${metal.name.toLowerCase()}`;

			const lk = redBoundary(metal.A);
			const frac = Math.min(Math.max((lk - 200) / 560, 0), 1);
			kr.style.left = `calc(0.675rem + (100% - 1.35rem) * ${frac.toFixed(4)})`;
			const krText = kr.querySelector<HTMLElement>('[data-kr-text]')!;
			krText.innerHTML = `<i>λ</i><sub>кр</sub> = ${Math.round(lk)} нм`;
			krText.style.transform = `translateX(-${(8 + 84 * frac).toFixed(1)}%)`;

			// polarity, field
			signA.textContent = s.U > 0 ? '+' : s.U < 0 ? '−' : '';
			signC.textContent = s.U > 0 ? '−' : s.U < 0 ? '+' : '';
			const len = (Math.abs(s.U) / 5) * 100;
			const mid = (YA + YC) / 2;
			// E points from + to −: down when the anode is positive.
			const y1 = s.U >= 0 ? mid - len / 2 : mid + len / 2;
			const y2 = s.U >= 0 ? mid + len / 2 : mid - len / 2;
			for (const f of [fieldL, fieldR]) {
				f.setAttribute('y1', String(y1));
				f.setAttribute('y2', String(y2));
				f.style.visibility = len > 6 ? 'visible' : 'hidden';
			}
			fieldLabel.style.visibility = len > 6 ? 'visible' : 'hidden';
			const longY = s.U >= 0 ? 271 : 283;
			const shortY = s.U >= 0 ? 283 : 271;
			batLong.setAttribute('y1', String(longY));
			batLong.setAttribute('y2', String(longY));
			batShort.setAttribute('y1', String(shortY));
			batShort.setAttribute('y2', String(shortY));
			batTop.textContent = s.U >= 0 ? '+' : '−';
			batBot.textContent = s.U >= 0 ? '−' : '+';

			vmText.textContent = `${sgn(s.U)} В`;
			vmPhone.textContent = `${sgn(s.U)} В`;

			// graph
			curve.setAttribute('d', lightOn ? curvePath(s.Ek, s.inten) : curvePath(0, 0));
			const px = pu(s.U);
			const py = pi(s.I);
			point.setAttribute('cx', px.toFixed(1));
			point.setAttribute('cy', py.toFixed(1));
			drop.setAttribute('x1', px.toFixed(1));
			drop.setAttribute('x2', px.toFixed(1));
			drop.setAttribute('y1', py.toFixed(1));
			drop.setAttribute('y2', String(P.y1));
			const showMarks = lightOn && s.Ek > 0 && s.inten > 0;
			const ux = pu(-Math.min(s.Ek, 5));
			uzLine.setAttribute('x1', ux.toFixed(1));
			uzLine.setAttribute('x2', ux.toFixed(1));
			uzLine.setAttribute('y1', String(P.y1));
			uzLine.setAttribute('y2', String(P.y1 - 46));
			uzText.setAttribute('x', (ux - 4).toFixed(1));
			uzText.setAttribute('y', String(P.y1 - 32));
			const Is = (I_MAX * s.inten) / 100;
			inLine.setAttribute('x1', String(P.x0));
			inLine.setAttribute('x2', String(P.x1));
			inLine.setAttribute('y1', pi(Is).toFixed(1));
			inLine.setAttribute('y2', pi(Is).toFixed(1));
			inText.setAttribute('x', String(P.x0 + 22));
			inText.setAttribute('y', (pi(Is) - 6).toFixed(1));
			for (const el of [uzLine, uzText]) el.style.visibility = showMarks && s.Ek <= 5 ? 'visible' : 'hidden';
			for (const el of [inLine, inText]) el.style.visibility = showMarks ? 'visible' : 'hidden';
			drawLegend(s);

			// energy bars and the live equation
			setSeg(segPhoton, segPhotonT, s.Eph, `${fmt(s.Eph)} эВ`);
			setSeg(segShort, segShortT, Math.max(-s.Ek, 0), `не хватает ${fmt(-s.EkShown)}`);
			segShort.style.borderWidth = s.Ek < 0 ? '' : '0';
			setSeg(segWork, segWorkT, metal.A, `${fmt(metal.A)} эВ`);
			setSeg(segKin, segKinT, Math.max(s.Ek, 0), `${fmt(s.EkShown)} эВ`, true, s.Eph);
			segWork.style.borderRadius = s.Ek > 0 ? '' : '0.35rem';
			renderCalc(s);
			sayLive(s);

			if (!running || !visible) setMeter(s.I, true);
		};

		const setMeter = (I: number, instant: boolean, dt = 0) => {
			if (instant) shownI = I;
			else shownI += (I - shownI) * (1 - Math.exp(-dt / 0.25));
			const a = -55 + 11 * Math.min(Math.max(shownI, 0), 10.3);
			needle.setAttribute('transform', `rotate(${a.toFixed(2)} ${needle.getAttribute('x1')} ${needle.getAttribute('y1')})`);
			const txt = `${fmt(Math.max(shownI, 0))} мкА`;
			amText.textContent = txt;
			amPhone.textContent = txt;
		};

		/* ---------- particles ---------- */
		const spawnPhoton = (s: ReturnType<typeof state>) => {
			const f = Math.random();
			const x0 = aL.x + f * (aR.x - aL.x);
			const y0 = aL.y + f * (aR.y - aL.y);
			const x1 = sL.x + f * (sR.x - sL.x);
			const y1 = sL.y + f * (sR.y - sL.y);
			const el = document.createElementNS(SVG_NS, 'path');
			el.classList.add('fe-ph');
			el.setAttribute('d', packetD);
			el.style.stroke = lightColor(s.nm);
			gPh.append(el);
			const dist = Math.hypot(x1 - x0, y1 - y0);
			photons.push({
				el,
				x0,
				y0,
				x1,
				y1,
				t: 0,
				T: dist / 760,
				ang: (Math.atan2(y1 - y0, x1 - x0) * 180) / Math.PI,
				ok: s.Ek > 0,
				xmm: (x1 - CX) / K,
			});
		};

		const flash = (x: number, y: number, colour: string, r0: number, r1: number, T: number) => {
			const el = document.createElementNS(SVG_NS, 'circle');
			el.classList.add('fe-fl');
			el.setAttribute('cx', x.toFixed(1));
			el.setAttribute('cy', y.toFixed(1));
			el.style.stroke = colour;
			gFl.append(el);
			flashes.push({ el, t: 0, T, r0, r1 });
		};

		const emit = (xmm: number, Ek: number) => {
			// energy share ε ~ Beta(2, 2) (median of three uniforms), direction: density cos θ / 2
			const u3 = [Math.random(), Math.random(), Math.random()].sort((a, b) => a - b);
			const eps = u3[1];
			const sinT = 2 * Math.random() - 1;
			const cosT = Math.sqrt(1 - sinT * sinT);
			const v = speedMmNs(eps * Ek);
			const g = document.createElementNS(SVG_NS, 'g') as SVGGElement;
			g.classList.add('fe-el');
			const tail = document.createElementNS(SVG_NS, 'line') as SVGLineElement;
			const c = document.createElementNS(SVG_NS, 'circle') as SVGCircleElement;
			c.setAttribute('r', '3.6');
			g.append(tail, c);
			gEl.append(g);
			electrons.push({ g, c, tail, x: xmm, y: 0, vx: v * sinT, vy: v * cosT, fade: -1 });
		};

		const placeElectron = (e: Electron) => {
			const X = CX + e.x * K;
			const Y = YC - e.y * K;
			e.c.setAttribute('cx', X.toFixed(1));
			e.c.setAttribute('cy', Y.toFixed(1));
			// tail: where the electron was 0.12 s of animation time ago (straight-line estimate)
			const back = 0.12 / TS;
			e.tail.setAttribute('x1', (X - e.vx * back * K).toFixed(1));
			e.tail.setAttribute('y1', (Y + e.vy * back * K).toFixed(1));
			e.tail.setAttribute('x2', X.toFixed(1));
			e.tail.setAttribute('y2', Y.toFixed(1));
		};

		const step = (dt: number) => {
			const s = state();
			// photons arrive as a random (Poisson) stream: up to 40 per second at 100 %
			const rate = lightOn ? 0.4 * s.inten : 0;
			if (rate > 0) {
				nextPhoton -= dt;
				while (nextPhoton <= 0) {
					spawnPhoton(s);
					nextPhoton += -Math.log(1 - Math.random()) / rate;
				}
			} else nextPhoton = 0.05;

			for (let i = photons.length - 1; i >= 0; i--) {
				const p = photons[i];
				p.t += dt;
				const f = p.t / p.T;
				if (f >= 1) {
					p.el.remove();
					photons.splice(i, 1);
					const Ek = photonEV(Number(nmIn.value)) - metal.A;
					cathodeLit = true;
					flash(p.x1, p.y1 - 1, 'var(--fe-light)', 1.5, Ek > 0 ? 7 : 11, Ek > 0 ? 0.3 : 0.5);
					if (Ek > 0) emit(p.xmm, Ek);
					continue;
				}
				const x = p.x0 + (p.x1 - p.x0) * f;
				const y = p.y0 + (p.y1 - p.y0) * f;
				p.el.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${p.ang.toFixed(1)})`);
			}

			const dtNs = dt / TS;
			const a = ACC_PER_VOLT * s.U;
			for (let i = electrons.length - 1; i >= 0; i--) {
				const e = electrons[i];
				if (e.fade >= 0) {
					e.fade += dt;
					e.g.style.opacity = String(Math.max(0, 1 - e.fade / 0.35));
					if (e.fade > 0.35) {
						e.g.remove();
						electrons.splice(i, 1);
					}
					continue;
				}
				e.x += e.vx * dtNs;
				e.y += e.vy * dtNs + 0.5 * a * dtNs * dtNs;
				e.vy += a * dtNs;
				if (Math.abs(e.x) >= HALF_W) {
					e.x = Math.sign(e.x) * HALF_W;
					e.fade = 0; // hits the glass wall
				} else if (e.y >= GAP) {
					e.y = GAP;
					flash(CX + e.x * K, YA, 'var(--ig-vx)', 1.5, 7, 0.3);
					e.g.remove();
					electrons.splice(i, 1);
					continue;
				} else if (e.y <= 0 && e.vy < 0) {
					e.y = 0;
					e.fade = 0.15; // back into the cathode
				}
				placeElectron(e);
			}

			for (let i = flashes.length - 1; i >= 0; i--) {
				const f = flashes[i];
				f.t += dt;
				const k = f.t / f.T;
				if (k >= 1) {
					f.el.remove();
					flashes.splice(i, 1);
					continue;
				}
				f.el.setAttribute('r', (f.r0 + (f.r1 - f.r0) * k).toFixed(1));
				f.el.style.opacity = String(1 - k);
			}
			if (!lightOn && photons.length === 0) cathodeLit = false;
			setMeter(cathodeLit ? s.Ilit : 0, false, dt);
		};

		const clearParticles = () => {
			for (const p of photons) p.el.remove();
			for (const e of electrons) e.g.remove();
			for (const f of flashes) f.el.remove();
			photons.length = electrons.length = flashes.length = 0;
		};

		const frame = (now: number) => {
			const dt = Math.min((now - last) / 1000, 0.05);
			last = now;
			step(dt);
			raf = requestAnimationFrame(frame);
		};
		const sync = () => {
			cancelAnimationFrame(raf);
			if (running && visible) {
				last = performance.now();
				raf = requestAnimationFrame(frame);
			} else setMeter(state().I, true);
			pauseBtn.textContent = running ? 'Пауза' : 'Продолжить';
			playBtn.hidden = running;
		};

		/* ---------- controls ---------- */
		for (const el of [nmIn, intIn, uIn]) el.addEventListener('input', update);
		for (const chip of chips) {
			chip.addEventListener('click', () => {
				metal = METALS.find((m) => m.id === chip.dataset.metal)!;
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
				update();
			});
		}
		lightBtn.addEventListener('click', () => {
			lightOn = !lightOn;
			if (lightOn && !(running && visible)) cathodeLit = true;
			lightBtn.textContent = lightOn ? 'Выключить свет' : 'Включить свет';
			lightBtn.setAttribute('aria-pressed', String(lightOn));
			update();
		});
		saveBtn.addEventListener('click', () => {
			const s = state();
			saved.push({ nm: s.nm, inten: lightOn ? s.inten : 0, metal, Ek: s.Ek });
			while (saved.length > 4) saved.shift();
			drawGhosts();
			drawLegend(s);
		});
		clearBtn.addEventListener('click', () => {
			saved.length = 0;
			drawGhosts();
			drawLegend(state());
		});
		pauseBtn.addEventListener('click', () => {
			running = !running;
			sync();
		});
		playBtn.addEventListener('click', () => {
			running = true;
			sync();
		});

		// Dragging along the I–V curve sets the voltage.
		let dragging = false;
		const dragTo = (ev: PointerEvent) => {
			const m = ivPlot.getScreenCTM();
			if (!m) return;
			const pt = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
			const U = Math.min(5, Math.max(-5, ((pt.x - P.x0) / (P.x1 - P.x0)) * 10 - 5));
			const v = String(Math.round(U * 20) / 20);
			if (uIn.value !== v) {
				uIn.value = v;
				update();
			}
		};
		ivPlot.addEventListener('pointerdown', (ev) => {
			dragging = true;
			ivPlot.classList.add('is-dragging');
			ivPlot.setPointerCapture(ev.pointerId);
			dragTo(ev);
		});
		ivPlot.addEventListener('pointermove', (ev) => dragging && dragTo(ev));
		const endDrag = () => {
			dragging = false;
			ivPlot.classList.remove('is-dragging');
		};
		ivPlot.addEventListener('pointerup', endDrag);
		ivPlot.addEventListener('pointercancel', endDrag);

		// Questions elsewhere on the page can set the model: window.dispatchEvent(new CustomEvent('fe:set', …)).
		window.addEventListener('fe:set', (ev) => {
			const d = (ev as CustomEvent).detail ?? {};
			if (d.metal) {
				const m = METALS.find((x) => x.id === d.metal);
				if (m) {
					metal = m;
					chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.metal === m.id)));
				}
			}
			if (d.nm != null) nmIn.value = String(d.nm);
			if (d.inten != null) intIn.value = String(d.inten);
			if (d.U != null) uIn.value = String(d.U);
			if (d.light != null) {
				lightOn = !!d.light;
				lightBtn.textContent = lightOn ? 'Выключить свет' : 'Включить свет';
				lightBtn.setAttribute('aria-pressed', String(lightOn));
			}
			clearParticles();
			cathodeLit = lightOn;
			update();
			if (root === document.querySelector('[data-fe-lab]')) {
				root.scrollIntoView({ block: 'start', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
			}
		});

		// Narrow screens: zoom on the tube, the circuit becomes a line of readings.
		const narrow = () => {
			const isNarrow = root.clientWidth < 560;
			root.classList.toggle('is-narrow', isNarrow);
			svg.setAttribute('viewBox', isNarrow ? '34 4 432 360' : '0 0 720 400');
		};
		new ResizeObserver(narrow).observe(root);
		narrow();

		new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting;
			sync();
		}).observe(svg);

		document.addEventListener('visibilitychange', () => {
			if (document.hidden) cancelAnimationFrame(raf);
			else sync();
		});

		update();
		sync();
	}
</script>
