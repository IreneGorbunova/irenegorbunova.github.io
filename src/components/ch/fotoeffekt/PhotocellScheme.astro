---
/**
 * Picture to the definitions of the vacuum photocell, the saturation current and the stopping voltage.
 * Left: the circuit as on a school scheme: the photocell (a glass bulb with the cathode plate and the mesh
 *   anode, light falling through the mesh), a source of adjustable voltage, the ammeter in series and the
 *   voltmeter across the photocell.
 * Right: the current–voltage curve of the same photocell model as in PhotocellLab (I = I_н·Φ(U/U_з), physics.ts),
 *   drawn for U_з = 1 В: zero below −U_з, then growing, then the saturation current I_н.
 */
import FeStyles from './FeStyles.astro';
import { buildPhiTable, phiLookup, lightColor } from './physics';
import { packet } from './draw';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `fps-a-${uid}`;
const mE = `fps-e-${uid}`;

// the graph: U from −1,6 to 3,4 В, I from 0 to 1,2·I_н
const G = { x0: 34, x1: 300, y0: 40, y1: 196 };
const U0 = -1.6;
const U1 = 3.4;
const gx = (U: number) => G.x0 + ((U - U0) / (U1 - U0)) * (G.x1 - G.x0);
const gy = (I: number) => G.y1 - (I / 1.2) * (G.y1 - G.y0);
const table = buildPhiTable();
const pts: string[] = [];
for (let i = 0; i <= 200; i++) {
	const U = U0 + ((U1 - U0) * i) / 200;
	pts.push(`${i ? 'L' : 'M'}${gx(U).toFixed(1)} ${gy(phiLookup(table, U)).toFixed(1)}`);
}
const curve = pts.join(' ');
const xAxisY = gy(0);
const yAxisX = gx(0);

// photons through the mesh onto the cathode
const ph = [
	{ x: 64, y: 44 },
	{ x: 84, y: 62 },
].map(({ x, y }) => packet(x, y, Math.atan2(1, 0.62), 26, 6, 3));
---

<FeStyles />
<figure class="fp-pic not-content" data-fe-scheme>
	<div class="fp-pic__grid">
		<svg class="fp-pic__svg" viewBox="0 0 320 236" role="img" aria-label="Схема: вакуумный фотоэлемент — стеклянная колба с катодом и анодом-сеткой, свет падает на катод сквозь сетку. Последовательно с фотоэлементом включены амперметр и источник регулируемого напряжения, вольтметр подключён к аноду и катоду">
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="fps-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
				<marker id={mE} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="fps-head-e" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<text class="fp-title" x="160" y="22" text-anchor="middle">Фотоэлемент в цепи</text>
			<!-- wires -->
			<path class="fp-wire" d="M110 80 L110 46 L276 46 L276 106"></path>
			<path class="fp-wire" d="M276 116 L276 208 L110 208 L110 152"></path>
			<path class="fp-wire" d="M220 46 L220 108 M220 146 L220 208"></path>
			<circle class="fp-node" cx="220" cy="46" r="3"></circle>
			<circle class="fp-node" cx="220" cy="208" r="3"></circle>
			<!-- the photocell -->
			<circle class="fp-glass" cx="110" cy="116" r="46"></circle>
			<line class="fp-cathode" x1="80" y1="140" x2="140" y2="140"></line>
			<line class="fp-wire" x1="110" y1="140" x2="110" y2="152"></line>
			<line class="fp-mesh" x1="82" y1="88" x2="138" y2="88"></line>
			<line class="fp-wire" x1="110" y1="80" x2="110" y2="88"></line>
			{ph.map((d) => <path class="fp-photon" d={d} style={`stroke: ${lightColor(400)}`} />)}
			<circle class="fp-e" cx="102" cy="122" r="3.4"></circle>
			<line class="fp-e-arrow" x1="102" y1="117" x2="102" y2="104" marker-end={`url(#${mE})`}></line>
			<circle class="fp-e" cx="122" cy="110" r="3.4"></circle>
			<line class="fp-e-arrow" x1="122" y1="105" x2="122" y2="94" marker-end={`url(#${mE})`}></line>
			<text x="18" y="168">катод</text>
			<line class="fp-lead" x1="54" y1="162" x2="80" y2="142"></line>
			<text x="162" y="82">анод</text>
			<text x="162" y="96">(сетка)</text>
			<text x="40" y="74" text-anchor="end">свет</text>
			<!-- the ammeter -->
			<circle class="fp-meter" cx="166" cy="46" r="13"></circle>
			<text class="fp-meter-l" x="166" y="51" text-anchor="middle">A</text>
			<!-- the voltmeter -->
			<circle class="fp-meter" cx="220" cy="127" r="13"></circle>
			<text class="fp-meter-l" x="220" y="132" text-anchor="middle">V</text>
			<!-- the source of adjustable voltage -->
			<line class="fp-cell" x1="262" y1="106" x2="290" y2="106"></line>
			<line class="fp-cell fp-cell--short" x1="269" y1="116" x2="283" y2="116"></line>
			<line class="fp-var" x1="258" y1="128" x2="294" y2="96" marker-end={`url(#${mA})`}></line>
			<text x="300" y="160" text-anchor="end">источник</text>
		</svg>
		<svg class="fp-pic__svg" viewBox="0 0 320 236" role="img" aria-label="График зависимости силы фототока от напряжения между анодом и катодом. При напряжении меньше минус U з тока нет; дальше ток растёт и при большом напряжении перестаёт расти — это ток насыщения I н">
			<text class="fp-title" x="160" y="22" text-anchor="middle">Сила фототока</text>
			<line class="fp-axis" x1={G.x0} y1={xAxisY} x2={G.x1 + 8} y2={xAxisY} marker-end={`url(#${mA})`}></line>
			<line class="fp-axis" x1={yAxisX} y1={G.y1 + 4} x2={yAxisX} y2={G.y0 - 6} marker-end={`url(#${mA})`}></line>
			<line class="fp-dash" x1={G.x0} y1={gy(1)} x2={G.x1} y2={gy(1)}></line>
			<path class="fp-curve" d={curve}></path>
			<circle class="fp-mark" cx={gx(-1)} cy={xAxisY} r="4"></circle>
			<text class="fp-math" x={yAxisX - 8} y={G.y0 + 2} text-anchor="end">I</text>
			<text class="fp-math" x={G.x1 + 6} y={xAxisY + 18} text-anchor="end">U</text>
			<text x={yAxisX - 6} y={xAxisY + 16} text-anchor="end">0</text>
			<text class="fp-t-hl" x={gx(-1)} y={xAxisY + 18} text-anchor="middle">−U<tspan baseline-shift="sub" font-size="0.75em">з</tspan></text>
			<text class="fp-t-hl" x={G.x1} y={gy(1) - 8} text-anchor="end">I<tspan baseline-shift="sub" font-size="0.75em">н</tspan> — ток насыщения</text>
			<text x={gx(-1) - 4} y={gy(0.45)} text-anchor="middle">тока</text>
			<text x={gx(-1) - 4} y={gy(0.45) + 15} text-anchor="middle">нет</text>
			<text x={gx(1.7)} y={gy(0.62)} text-anchor="middle">поле</text>
			<text x={gx(1.7)} y={gy(0.62) + 15} text-anchor="middle">притягивает</text>
			<text x={gx(1.7)} y={gy(0.62) + 30} text-anchor="middle">электроны</text>
		</svg>
	</div>
	<div class="fp-pic__foot">
		<figcaption>
			Слева: свет падает на катод сквозь анод-сетку; амперметр показывает силу фототока, вольтметр — напряжение <i>U</i> между анодом и катодом. Справа: при большом <i>U</i> ток перестаёт расти (ток насыщения), а при <i>U</i> = −<i>U</i><sub>з</sub> исчезает.
		</figcaption>
	</div>
</figure>

<style is:global>
	.fp-node {
		fill: var(--sl-color-gray-2);
	}
	.fp-cathode {
		stroke: var(--sl-color-gray-2);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.fp-mesh {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-dasharray: 2 3;
	}
	.fp-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.fp-e-arrow {
		stroke: var(--fp-e);
		stroke-width: 1.6;
	}
	.fps-head {
		fill: var(--sl-color-gray-2);
	}
	.fps-head-e {
		fill: var(--fp-e);
	}
	.fp-meter {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.fp-pic .fp-meter-l {
		font-weight: 700;
		fill: var(--sl-color-gray-1);
		stroke: none;
	}
	.fp-cell {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.fp-cell--short {
		stroke-width: 5;
	}
	.fp-var {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.fp-axis {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.fp-curve {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.fp-mark {
		fill: var(--ig-v);
	}
</style>
