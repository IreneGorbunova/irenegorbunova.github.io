---
/**
 * Picture to the definition of light pressure: a photon with momentum h/λ falls on a black plate and is absorbed
 * (the plate gets h/λ), and on a mirror, from which it flies back (the mirror gets 2h/λ). Arrow lengths to scale.
 */
import FeStyles from './FeStyles.astro';
import { lightColor } from './physics';
import { packet } from './draw';

const uid = Math.random().toString(36).slice(2, 8);
const mP = `fpp-p-${uid}`;
const mM = `fpp-m-${uid}`;
const L = 34; // px for h/λ
const col = lightColor(530);
---

<FeStyles />
<figure class="fp-pic not-content" data-fe-pressure>
	<div class="fp-pic__grid">
		<svg class="fp-pic__svg" viewBox="0 0 320 170" role="img" aria-label="Фотон падает на чёрную пластину и поглощается. Пластина получает импульс фотона h делить на лямбда">
			<defs>
				<marker id={mP} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path d="M0 0 L10 5 L0 10 z" style={`fill: ${col}`}></path>
				</marker>
				<marker id={mM} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="fp-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<text class="fp-title" x="160" y="24" text-anchor="middle">Чёрная пластина поглощает</text>
			<path class="fp-photon" d={packet(110, 90, 0, 60, 12, 6)} style={`stroke: ${col}`}></path>
			<line class="fpp-p" style={`stroke: ${col}`} x1="70" y1="120" x2={70 + L} y2="120" marker-end={`url(#${mP})`}></line>
			<text class="fp-math" x={70 + L / 2} y="142" text-anchor="middle">h/λ</text>
			<rect class="fpp-black" x="170" y="50" width="14" height="84" rx="2"></rect>
			<line class="fp-arrow" x1="196" y1="92" x2={196 + L} y2="92" marker-end={`url(#${mM})`}></line>
			<text class="fp-t-hl" x={196 + L + 6} y="97"><tspan class="fp-math">h/λ</tspan></text>
			<text x="177" y="158" text-anchor="middle">пластина</text>
		</svg>
		<svg class="fp-pic__svg" viewBox="0 0 320 170" role="img" aria-label="Фотон падает на зеркало и отражается назад. Зеркало получает вдвое больший импульс: 2h делить на лямбда">
			<text class="fp-title" x="160" y="24" text-anchor="middle">Зеркало отражает</text>
			<path class="fp-photon" d={packet(110, 74, 0, 60, 12, 6)} style={`stroke: ${col}`}></path>
			<line class="fpp-p" style={`stroke: ${col}`} x1="70" y1="52" x2={70 + L} y2="52" marker-end={`url(#${mP})`}></line>
			<path class="fp-photon" d={packet(110, 114, Math.PI, 60, 12, 6)} style={`stroke: ${col}; opacity: 0.75`}></path>
			<line class="fpp-p" style={`stroke: ${col}`} x1={70 + L} y1="138" x2="70" y2="138" marker-end={`url(#${mP})`}></line>
			<text class="fp-math" x={70 + L + 8} y="57">h/λ</text>
			<text class="fp-math" x={70 + L + 8} y="143">h/λ</text>
			<rect class="fpp-mirror" x="170" y="50" width="10" height="84" rx="2"></rect>
			<line class="fpp-hatch" x1="180" y1="56" x2="188" y2="48"></line>
			<line class="fpp-hatch" x1="180" y1="76" x2="188" y2="68"></line>
			<line class="fpp-hatch" x1="180" y1="96" x2="188" y2="88"></line>
			<line class="fpp-hatch" x1="180" y1="116" x2="188" y2="108"></line>
			<line class="fp-arrow" x1="196" y1="92" x2={196 + 2 * L} y2="92" marker-end={`url(#${mM})`}></line>
			<text class="fp-t-hl" x={196 + 2 * L + 6} y="97"><tspan class="fp-math">2h/λ</tspan></text>
			<text x="175" y="158" text-anchor="middle">зеркало</text>
		</svg>
	</div>
	<div class="fp-pic__foot">
		<figcaption>
			Импульс фотона — <i>h</i>/<i>λ</i>. Поглощённый фотон отдаёт пластине весь свой импульс, а отражённый — вдвое больше: на зеркало свет давит вдвое сильнее.
		</figcaption>
	</div>
</figure>

<style is:global>
	.fpp-p {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.fpp-black {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	:root[data-theme='light'] .fpp-black {
		fill: var(--sl-color-white);
	}
	.fpp-mirror {
		fill: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.fpp-hatch {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
</style>
