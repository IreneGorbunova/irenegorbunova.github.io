---
/**
 * Picture to the definition of the work function and to Einstein's equation, as an energy diagram for caesium
 * (A_вых = 2,1 эВ; 1 эВ = 40 px upwards). Two electrons at the surface of the metal each absorb one photon.
 * Violet light, 400 нм: hν = 3,11 эВ > A_вых. The arrow of the photon's energy goes above the exit level; the
 *   electron rises to its tip and flies out with the rest, mυ²/2 = 1,01 эВ.
 * Red light, 700 нм: hν = 1,78 эВ < A_вых. The electron rises but does not reach the exit level and falls back:
 *   the energy stays in the metal and heats it.
 */
import FeStyles from './FeStyles.astro';
import { photonEV, lightColor } from './physics';

const uid = Math.random().toString(36).slice(2, 8);
const mV = `fpe-v-${uid}`;
const mR = `fpe-r-${uid}`;
const mG = `fpe-g-${uid}`;
const A = 2.1;
const S = 40;
const Y0 = 212;
const YA = Y0 - A * S;
const cols = [
	{ id: 'v', x: 196, nm: 400, name: 'фиолетовый, 400 нм', marker: mV },
	{ id: 'r', x: 346, nm: 700, name: 'красный, 700 нм', marker: mR },
].map((c) => {
	const ev = photonEV(c.nm);
	return { ...c, ev, top: Y0 - ev * S, evText: ev.toFixed(2).replace('.', ','), color: lightColor(c.nm), kin: (ev - A).toFixed(2).replace('.', ',') };
});
const [V, R] = cols;
---

<FeStyles />
<figure class="fp-pic fp-pic--one fp-pic--big not-content" data-fe-einstein data-y0={Y0} data-top-v={V.top} data-top-r={R.top}>
	<div class="fp-pic__grid">
		<svg class="fp-pic__svg" viewBox="0 0 440 250" role="img" aria-label={`Энергия электрона в цезии. Работа выхода 2,1 эВ. Фотон фиолетового света отдаёт электрону ${V.evText} эВ: 2,1 эВ уходит на выход из металла, с остальными ${V.kin} эВ электрон вылетает. Фотон красного света отдаёт только ${R.evText} эВ — электрон не может выйти и остаётся в металле`}>
			<defs>
				{
					cols.map((c) => (
						<marker id={c.marker} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
							<path d="M0 0 L10 5 L0 10 z" style={`fill: ${c.color}`} />
						</marker>
					))
				}
				<marker id={mG} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
					<path class="fpe-ghead" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<rect class="fpe-metal" x="0" y={YA} width="440" height={250 - YA}></rect>
			<line class="fp-dash" x1="0" y1={YA} x2="440" y2={YA}></line>
			<text x="8" y={YA - 8}>вне металла</text>
			<text x="8" y="242">в металле</text>
			<!-- the work function -->
			<line class="fpe-bracket" x1="48" y1={Y0 - 3} x2="48" y2={YA + 3} marker-start={`url(#${mG})`} marker-end={`url(#${mG})`}></line>
			<text class="fp-t-hl" x="56" y={(Y0 + YA) / 2 + 5}><tspan class="fp-math">A</tspan><tspan baseline-shift="sub" font-size="0.75em">вых</tspan> = 2,1 эВ</text>
			<line class="fpe-level" x1="40" y1={Y0} x2="400" y2={Y0}></line>
			{
				cols.map((c) => (
					<g data-col={c.id}>
						<text x={c.x} y="22" text-anchor="middle">
							{c.name}
						</text>
						<path class="fp-photon" data-ph style={`stroke: ${c.color}`} />
						<line class="fpe-up" x1={c.x} y1={Y0 - 6} x2={c.x} y2={Y0 - 6} style={`stroke: ${c.color}`} marker-end={`url(#${c.marker})`} data-up />
						<text x={c.x - 10} y={c.top + 12} text-anchor="end" data-hv style="opacity: 0">
							<tspan class="fp-math">hν</tspan> = {c.evText} эВ
						</text>
						<g data-e>
							<circle class="fp-e" r="5" />
							<line class="fp-e-minus" x1="-2.6" x2="2.6" y1="0" y2="0" />
						</g>
					</g>
				))
			}
			<g data-kin style="opacity: 0">
				<line class="fpe-kin" x1={V.x + 14} y1={YA} x2={V.x + 14} y2={V.top}></line>
				<text class="fp-t-hl" x={V.x + 22} y={(YA + V.top) / 2 - 2}><tspan class="fp-math">mυ</tspan><tspan baseline-shift="super" font-size="0.7em">2</tspan>/2 =</text>
				<text class="fp-t-hl" x={V.x + 22} y={(YA + V.top) / 2 + 14}>{V.kin} эВ</text>
			</g>
			<text class="fp-t-e" x={V.x + 96} y={V.top - 10} text-anchor="middle" data-out style="opacity: 0">вылетел</text>
			<text class="fp-t-e" x={R.x} y="236" text-anchor="middle" data-stay style="opacity: 0">не вылетел</text>
		</svg>
	</div>
	<div class="fp-pic__foot">
		<figcaption>
			Цезий, <i>A</i><sub>вых</sub> = 2,1&nbsp;эВ. Фотон фиолетового света отдаёт электрону {V.evText}&nbsp;эВ: 2,1&nbsp;эВ уходит на выход из металла, остальное электрон уносит. Энергии фотона красного света на выход не хватает.
		</figcaption>
		<button type="button" class="fp-pic__again" data-again>Повторить</button>
	</div>
</figure>

<style is:global>
	.fpe-metal {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 55%, transparent);
	}
	.fpe-level {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.fpe-bracket {
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.fpe-ghead {
		fill: var(--ig-v);
	}
	.fpe-up {
		stroke-width: 4;
		stroke-linecap: round;
	}
	.fpe-kin {
		stroke: var(--ig-v);
		stroke-width: 5;
		stroke-linecap: round;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { packet, ease, lerp } from './draw';

	const RUN = 4.5;
	for (const root of document.querySelectorAll<HTMLElement>('[data-fe-einstein]')) {
		const Y0 = Number(root.dataset.y0);
		const col = (id: string, top: number, wl: number) => {
			const g = root.querySelector<SVGGElement>(`[data-col="${id}"]`)!;
			const up = g.querySelector<SVGLineElement>('[data-up]')!;
			return {
				x: Number(up.getAttribute('x1')),
				top,
				wl,
				ph: g.querySelector<SVGPathElement>('[data-ph]')!,
				up,
				hv: g.querySelector<SVGTextElement>('[data-hv]')!,
				e: g.querySelector<SVGGElement>('[data-e]')!,
			};
		};
		const v = col('v', Number(root.dataset.topV), 8);
		const r = col('r', Number(root.dataset.topR), 14);
		const kin = root.querySelector<SVGGElement>('[data-kin]')!;
		const out = root.querySelector<SVGTextElement>('[data-out]')!;
		const stay = root.querySelector<SVGTextElement>('[data-stay]')!;
		// a photon flies to the electron during [0,2; 1,2] s, its energy arrow grows during [1,2; 1,5] s
		const photonAndArrow = (c: ReturnType<typeof col>, t: number) => {
			const s = (t - 0.2) / 1;
			if (s >= 0 && s < 1) {
				const x0 = c.x - 70;
				const y0 = 40;
				const ang = Math.atan2(Y0 - 8 - y0, 70);
				c.ph.setAttribute('d', packet(lerp(x0, c.x, s) - Math.cos(ang) * 14, lerp(y0, Y0 - 8, s) - Math.sin(ang) * 14, ang, 28, c.wl, 4));
				c.ph.style.opacity = '1';
			} else c.ph.style.opacity = '0';
			const a = ease((t - 1.2) / 0.3);
			c.up.setAttribute('y2', lerp(Y0 - 6, c.top + 4, a).toFixed(1));
			c.up.style.opacity = a > 0 ? '1' : '0';
			c.hv.style.opacity = a >= 1 ? '1' : '0';
		};
		scene(root, RUN, (x) => {
			const t = x * RUN;
			photonAndArrow(v, t);
			photonAndArrow(r, t);
			// violet: the electron rises to the tip and flies out to the right
			const riseV = ease((t - 1.6) / 0.7);
			const flyV = ease((t - 2.5) / 1.2);
			v.e.setAttribute('transform', `translate(${(v.x + 90 * flyV).toFixed(1)} ${lerp(Y0, v.top, riseV).toFixed(1)})`);
			kin.style.opacity = t > 2.4 ? '1' : '0';
			out.style.opacity = flyV > 0.6 ? '1' : '0';
			// red: the electron rises, cannot reach the exit level and falls back
			const riseR = ease((t - 1.6) / 0.7);
			const fallR = ease((t - 2.6) / 0.6);
			r.e.setAttribute('transform', `translate(${r.x} ${lerp(lerp(Y0, r.top, riseR), Y0, fallR).toFixed(1)})`);
			stay.style.opacity = fallR > 0.6 ? '1' : '0';
		});
	}
</script>
