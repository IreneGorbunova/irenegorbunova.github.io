---
/** Frame and shared parts of the explanatory pictures of «Фотоэффект» (panels, caption, «Повторить», photons, electrons). Renders nothing. */
---

<style is:global>
	.fp-pic {
		--fe-sat: 90%;
		--fe-lit: 62%;
		--fp-e: var(--ig-vx);
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .fp-pic {
		--fe-sat: 85%;
		--fe-lit: 45%;
	}
	.fp-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.fp-pic--one .fp-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 30rem;
		margin-inline: auto;
	}
	.fp-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.fp-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.fp-pic--big text {
		font-size: 15px;
	}
	.fp-pic .fp-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.fp-pic.fp-pic--big .fp-title {
		font-size: 17px;
	}
	.fp-pic .fp-math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.fp-pic .fp-t-hl {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.fp-pic .fp-t-e {
		fill: var(--fp-e);
	}
	.fp-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.fp-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.fp-pic__foot figcaption i {
		font-family: var(--ig-font-math);
	}
	.fp-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.fp-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	/* electrons, wires, metal */
	.fp-e {
		fill: var(--fp-e);
	}
	.fp-e-minus {
		stroke: var(--sl-color-bg);
		stroke-width: 1.4;
	}
	.fp-wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.fp-metal {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.fp-glass {
		fill: color-mix(in srgb, var(--sl-color-white) 5%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.fp-photon {
		fill: none;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.fp-arrow {
		stroke: var(--ig-v);
		stroke-width: 2.4;
		stroke-linecap: round;
		fill: none;
	}
	.fp-head {
		fill: var(--ig-v);
	}
	.fp-dash {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 4;
	}
	@media (max-width: 40rem) {
		.fp-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
