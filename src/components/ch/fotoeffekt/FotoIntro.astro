---
/**
 * Two short looping opening scenes of «Фотоэффект». No terms of the chapter in the pictures; the captions'
 * popovers explain.
 * Sun: left, an arm on the beach under the Sun. Short packets of visible light (yellow) and of ultraviolet (pale
 *   lavender, shorter wavelength) fly from the Sun to the arm; each absorbed ultraviolet packet makes the skin a
 *   little darker. Right, an arm held out to a hot stove: many long infrared packets (deep red) reach it; heat
 *   shimmer rises above the arm, the skin does not darken.
 * Lamp: a street at dusk. The Sun sets, the sky darkens, the stars come out. Light from the sky (packets) reaches
 *   a small light sensor on the lamp post; its current (the bar next to it) falls with the light, and when it drops
 *   below the mark the lamp switches on.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const clipL = `fi-cl-${uid}`;
const clipR = `fi-cr-${uid}`;
const clipS = `fi-cs-${uid}`;
// a fixed pseudo-random sequence for the stars
let seed = 3;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const stars = Array.from({ length: 22 }, () => [Math.round((8 + rnd() * 344) * 10) / 10, Math.round((8 + rnd() * 120) * 10) / 10, rnd() > 0.7 ? 1.4 : 0.9]);
---

<IntroFrame data-fotointro>
	<div class="intro__card" data-scene="sun">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Слева рука на пляже под солнцем: до неё долетают видимый свет и ультрафиолет, и кожа понемногу темнеет. Справа рука у жаркой печки: до неё долетает много инфракрасного излучения, над рукой дрожит горячий воздух, но кожа не темнеет">
			<defs>
				<clipPath id={clipL}><rect x="0" y="0" width="178" height="240"></rect></clipPath>
				<clipPath id={clipR}><rect x="182" y="0" width="178" height="240"></rect></clipPath>
			</defs>
			<!-- the beach -->
			<rect class="fi-sky" x="0" y="0" width="178" height="200"></rect>
			<rect class="fi-sand" x="0" y="200" width="178" height="40"></rect>
			<g class="fi-sun-rays">
				{Array.from({ length: 10 }, (_, k) => {
					const a = (k * Math.PI) / 5;
					return <line x1={34 + 20 * Math.cos(a)} y1={34 + 20 * Math.sin(a)} x2={34 + 27 * Math.cos(a)} y2={34 + 27 * Math.sin(a)} />;
				})}
			</g>
			<circle class="fi-sun" cx="34" cy="34" r="15"></circle>
			<g data-arm-l>
				<rect class="fi-skin" x="30" y="182" width="118" height="18" rx="9"></rect>
				<ellipse class="fi-skin" cx="152" cy="190" rx="13" ry="10"></ellipse>
			</g>
			<g clip-path={`url(#${clipL})`} data-ph-l></g>
			<!-- the room with the stove -->
			<rect class="fi-wall" x="182" y="0" width="178" height="200"></rect>
			<rect class="fi-floor" x="182" y="200" width="178" height="40"></rect>
			<rect class="fi-brick" x="300" y="34" width="26" height="40"></rect>
			<rect class="fi-brick" x="282" y="70" width="70" height="130" rx="3"></rect>
			<g class="fi-joints">
				{[92, 114, 136, 180].map((y) => <line x1="282" x2="352" y1={y} y2={y} />)}
				<line x1="300" x2="300" y1="70" y2="92" />
				<line x1="330" x2="330" y1="92" y2="114" />
				<line x1="310" x2="310" y1="114" y2="136" />
				<line x1="318" x2="318" y1="180" y2="200" />
			</g>
			<rect class="fi-door" x="292" y="140" width="44" height="34" rx="3"></rect>
			<rect class="fi-fire" x="295" y="143" width="38" height="28" rx="2" data-fire></rect>
			<path class="fi-flame" d="M302 171 Q306 156 310 165 Q314 150 319 164 Q323 154 327 171 Z" data-flame></path>
			<g data-arm-r>
				<rect class="fi-skin" x="190" y="150" width="74" height="16" rx="8"></rect>
				<ellipse class="fi-skin" cx="268" cy="158" rx="11" ry="9"></ellipse>
			</g>
			<g class="fi-heat" data-heat>
				{[204, 226, 248].map((x) => <path d={`M${x} 144 q -4 -6 0 -12 t 0 -12 t 0 -12`} />)}
			</g>
			<g clip-path={`url(#${clipR})`} data-ph-r></g>
			<line class="fi-split" x1="180" y1="0" x2="180" y2="240"></line>
		</svg>
		<div class="intro__foot">
			<p>Летом на солнце легко загореть, а у жаркой печки — нельзя, хотя от неё тоже жарко. <More term="Загар вызывает ультрафиолет Солнца">Ультрафиолет — невидимые лучи с длиной волны короче, чем у фиолетового света. Свет поглощается порциями, и каждая порция ультрафиолета несёт достаточно энергии, чтобы изменить молекулу в клетке кожи, — в ответ кожа темнеет. Порция инфракрасного излучения печки несёт во много раз меньше энергии: сколько таких порций ни поглоти, они только нагревают кожу. Подробнее — в разделе <a href="#световые-кванты">«Световые кванты»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="lamp">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечерняя улица. Солнце садится, небо темнеет, появляются звёзды. Свет неба попадает на маленький датчик на столбе фонаря; ток датчика уменьшается, и когда он становится меньше отметки, фонарь зажигается">
			<defs>
				<clipPath id={clipS}><rect x="0" y="0" width="360" height="196"></rect></clipPath>
			</defs>
			<rect class="fi-night" x="0" y="0" width="360" height="196"></rect>
			<rect class="fi-day" x="0" y="0" width="360" height="196" data-day></rect>
			<g data-stars>
				{stars.map(([x, y, r]) => <circle class="fi-star" cx={x} cy={y} r={r} />)}
			</g>
			<g clip-path={`url(#${clipS})`}>
				<circle class="fi-sun" cx="74" cy="120" r="16" data-sun></circle>
			</g>
			<path class="fi-glow" d="M280 70 L322 70 L360 210 L238 210 Z" data-glow></path>
			<rect class="fi-ground" x="0" y="196" width="360" height="44"></rect>
			<path class="fi-house" d="M20 196 L20 150 L52 126 L84 150 L84 196 Z M100 196 L100 160 L150 160 L150 196 Z"></path>
			<rect class="fi-win" x="44" y="164" width="14" height="14" data-win></rect>
			<rect class="fi-win" x="116" y="170" width="16" height="12" data-win></rect>
			<ellipse class="fi-pool" cx="300" cy="208" rx="54" ry="7" data-pool></ellipse>
			<!-- the lamp post -->
			<line class="fi-post" x1="250" y1="200" x2="250" y2="58"></line>
			<path class="fi-post" d="M250 60 Q252 46 270 50 L292 56" style="fill: none"></path>
			<path class="fi-lamp" d="M280 54 L306 58 L320 70 L282 70 Z"></path>
			<rect class="fi-bulb" x="288" y="68" width="22" height="4" rx="2" data-bulb></rect>
			<!-- the light sensor and its current -->
			<rect class="fi-box" x="240" y="104" width="20" height="14" rx="2"></rect>
			<path class="fi-eye" d="M243 104 A7 7 0 0 1 257 104 Z"></path>
			<rect class="fi-gauge" x="266" y="96" width="8" height="30" rx="2"></rect>
			<rect class="fi-gauge-fill" x="267" y="97" width="6" height="28" rx="1.5" data-gauge></rect>
			<line class="fi-mark" x1="263" y1="118" x2="277" y2="118"></line>
			<rect class="fi-pill" x="279" y="102" width="28" height="17" rx="8.5"></rect>
			<text class="fi-label" x="293" y="114.5" text-anchor="middle">ток</text>
			<rect class="fi-pill" x="160" y="121" width="78" height="17" rx="8.5"></rect>
			<text class="fi-label" x="199" y="133.5" text-anchor="middle">датчик света</text>
			<g clip-path={`url(#${clipS})`} data-ph-s></g>
		</svg>
		<div class="intro__foot">
			<p>Уличные фонари зажигаются сами, когда стемнеет: <More term="их включает датчик света">В датчике свет освобождает электроны, и через него идёт ток: чем светлее, тем ток сильнее. Когда к вечеру ток становится меньше заданного, автомат — фотореле — включает фонарь, а утром выключает. Подробнее — в разделе <a href="#где-это-встречается">«Где это встречается»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-fotointro] {
		--fe-sat: 90%;
		--fe-lit: 66%;
		--fi-skin: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-2));
		--fi-tan: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-5));
		--fi-night: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-black));
		--fi-day: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-5));
	}
	:root[data-theme='light'] [data-fotointro] {
		--fe-sat: 85%;
		--fe-lit: 48%;
		--fi-skin: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-6));
		--fi-tan: color-mix(in srgb, var(--ig-v) 60%, var(--sl-color-gray-3));
		--fi-night: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-white));
		--fi-day: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-black));
	}
	.fi-sky {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
	}
	.fi-sand {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.fi-sun {
		fill: var(--ig-v);
	}
	.fi-sun-rays line {
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.fi-skin {
		fill: var(--fi-skin);
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 70%, transparent);
		stroke-width: 1;
	}
	.fi-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.fi-floor {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.fi-brick {
		fill: color-mix(in srgb, var(--ig-vy) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.fi-joints line {
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 60%, transparent);
		stroke-width: 1;
	}
	.fi-door {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.fi-fire {
		fill: color-mix(in srgb, var(--ig-vy) 55%, var(--ig-v));
	}
	.fi-flame {
		fill: var(--ig-v);
	}
	.fi-heat path {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vy) 60%, transparent);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.fi-split {
		stroke: var(--sl-color-gray-5);
		stroke-width: 4;
	}
	.fi-ph {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* the lamp scene */
	.fi-night {
		fill: var(--fi-night);
	}
	.fi-day {
		fill: var(--fi-day);
	}
	.fi-star {
		fill: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-1));
	}
	:root[data-theme='light'] .fi-star {
		fill: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-black));
	}
	.fi-ground {
		fill: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-5));
	}
	.fi-house {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.fi-win {
		fill: var(--ig-v);
	}
	.fi-post {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.fi-lamp {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.fi-bulb {
		fill: var(--sl-color-gray-4);
	}
	.fi-bulb.is-on {
		fill: var(--ig-v);
	}
	.fi-glow {
		fill: color-mix(in srgb, var(--ig-v) 30%, transparent);
	}
	.fi-pool {
		fill: color-mix(in srgb, var(--ig-v) 40%, transparent);
	}
	.fi-box {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.fi-eye {
		fill: color-mix(in srgb, var(--ig-vx) 50%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.fi-gauge {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.fi-gauge-fill {
		fill: var(--ig-vx);
	}
	.fi-mark {
		stroke: var(--ig-vy);
		stroke-width: 1.6;
	}
	.fi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.fi-label {
		font-size: 11px;
		fill: var(--sl-color-gray-1);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { packet, ease, lerp } from './draw';
	import { lightColor } from './physics';

	const NS = 'http://www.w3.org/2000/svg';
	const rng = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
	const mkPath = (parent: Element, color: string) => {
		const p = document.createElementNS(NS, 'path');
		p.setAttribute('class', 'fi-ph');
		p.style.stroke = color;
		parent.append(p);
		return p;
	};

	type Flight = { el: SVGPathElement; t0: number; x0: number; y0: number; x1: number; y1: number; dur: number; len: number; wl: number; uv?: boolean };
	/** Draws a packet flying from (x0, y0) to (x1, y1) during [t0, t0 + dur]; hidden before and after. */
	const fly = (f: Flight, t: number) => {
		const s = (t - f.t0) / f.dur;
		if (s < 0 || s > 1) {
			f.el.style.opacity = '0';
			return;
		}
		const ang = Math.atan2(f.y1 - f.y0, f.x1 - f.x0);
		const x = lerp(f.x0, f.x1, s) - (Math.cos(ang) * f.len) / 2;
		const y = lerp(f.y0, f.y1, s) - (Math.sin(ang) * f.len) / 2;
		f.el.setAttribute('d', packet(x, y, ang, f.len, f.wl, 3));
		f.el.style.opacity = '1';
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-fotointro]')) {
		// ---------- Sun and stove: 7 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="sun"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const armL = Array.from(card.querySelectorAll<SVGElement>('[data-arm-l] .fi-skin'));
			const heat = $<SVGGElement>('[data-heat]');
			const fire = $<SVGRectElement>('[data-fire]');
			const flame = $<SVGPathElement>('[data-flame]');
			const r = rng(17);
			const RUN = 7;
			const sun: Flight[] = [];
			for (let k = 0; k < 26; k++) {
				const uv = k % 2 === 1;
				sun.push({
					el: mkPath($('[data-ph-l]'), uv ? lightColor(330) : lightColor(575)),
					t0: 0.1 + k * 0.22,
					x0: 40,
					y0: 40,
					x1: 40 + r() * 112,
					y1: 184,
					dur: 0.9,
					len: 22,
					wl: uv ? 4.2 : 8.5,
					uv,
				});
			}
			const nUV = sun.filter((f) => f.uv).length;
			const stove: Flight[] = [];
			for (let k = 0; k < 34; k++) {
				stove.push({
					el: mkPath($('[data-ph-r]'), lightColor(740, 0.85)),
					t0: 0.05 + k * 0.17,
					x0: 296,
					y0: 150 + r() * 16,
					x1: 200 + r() * 64,
					y1: 152 + r() * 12,
					dur: 0.7,
					len: 34,
					wl: 16,
				});
			}
			scene(card, RUN, (x) => {
				const t = x * RUN;
				let hits = 0;
				for (const f of sun) {
					fly(f, t);
					if (f.uv && t >= f.t0 + f.dur) hits++;
				}
				const k = Math.round((100 * hits) / nUV);
				for (const a of armL) a.style.fill = `color-mix(in srgb, var(--fi-tan) ${k}%, var(--fi-skin))`;
				for (const f of stove) fly(f, t);
				const now = performance.now() / 1000;
				heat.style.opacity = (0.25 + 0.75 * ease(t / 3)).toFixed(2);
				heat.setAttribute('transform', `translate(0 ${(-((now * 10) % 6)).toFixed(1)})`);
				fire.style.opacity = (0.8 + 0.2 * Math.sin(now * 9)).toFixed(2);
				flame.setAttribute('transform', `translate(0 ${(1.5 * Math.sin(now * 7)).toFixed(1)})`);
			});
		}

		// ---------- Street lamp at dusk: 8 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="lamp"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const day = $<SVGRectElement>('[data-day]');
			const starsG = $<SVGGElement>('[data-stars]');
			const sunC = $<SVGCircleElement>('[data-sun]');
			const glow = $<SVGPathElement>('[data-glow]');
			const pool = $<SVGEllipseElement>('[data-pool]');
			const bulb = $<SVGRectElement>('[data-bulb]');
			const gauge = $<SVGRectElement>('[data-gauge]');
			const wins = Array.from(card.querySelectorAll<SVGRectElement>('[data-win]'));
			const r = rng(29);
			const RUN = 8;
			const ON = 0.25; // the mark on the gauge: share of the daylight current
			// daylight share at time t (s): bright until 1 s, dark at 6 s
			const light = (t: number) => 1 - ease((t - 1) / 5);
			const flights: (Flight & { u: number })[] = [];
			for (let k = 0; k < 40; k++) {
				const x0 = 20 + r() * 200;
				flights.push({
					el: mkPath($('[data-ph-s]'), lightColor(470 + r() * 120)),
					t0: k * 0.18,
					x0,
					y0: 0,
					x1: 250,
					y1: 102,
					dur: 0.7,
					len: 20,
					wl: 7,
					u: r(),
				});
			}
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const L = light(t);
				day.style.opacity = L.toFixed(3);
				starsG.style.opacity = ease((0.45 - L) / 0.35).toFixed(3);
				sunC.setAttribute('cy', (120 + 100 * ease((t - 0.5) / 5)).toFixed(1));
				for (const f of flights) {
					// photons from the sky: as many as the daylight allows
					if (f.u < light(f.t0)) fly(f, t);
					else f.el.style.opacity = '0';
				}
				gauge.setAttribute('height', (28 * L).toFixed(1));
				gauge.setAttribute('y', (97 + 28 * (1 - L)).toFixed(1));
				const on = L < ON;
				bulb.classList.toggle('is-on', on);
				glow.style.opacity = on ? '1' : '0';
				pool.style.opacity = on ? '1' : '0';
				for (const w of wins) w.style.opacity = ease((0.6 - L) / 0.3).toFixed(2);
			});
		}
	}
</script>
