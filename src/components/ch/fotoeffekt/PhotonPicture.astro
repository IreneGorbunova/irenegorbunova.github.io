---
/**
 * Picture to the definition of the photon and its energy: photons of red, green, violet light and of ultraviolet,
 * each drawn as a wave packet with the wavelength to scale (1 нм = 0,04 px), and its energy E = hc/λ as a bar
 * (1 эВ = 36 px), computed with the school constants (physics.ts).
 */
import FeStyles from './FeStyles.astro';
import { photonEV, lightColor } from './physics';
import { packet } from './draw';

const BX = 198; // start of the bars
const S = 36; // px per эВ
const rows = [
	{ nm: 700, name: 'красный' },
	{ nm: 530, name: 'зелёный' },
	{ nm: 400, name: 'фиолетовый' },
	{ nm: 250, name: 'ультрафиолет' },
].map((r, i) => {
	const ev = photonEV(r.nm);
	return {
		...r,
		y: 54 + i * 40,
		d: packet(154, 54 + i * 40, 0, 80, r.nm * 0.04, 8),
		w: ev * S,
		ev: ev.toFixed(2).replace('.', ','),
		color: lightColor(r.nm),
		fill: lightColor(r.nm, 0.55),
	};
});
---

<FeStyles />
<figure class="fp-pic fp-pic--one fp-pic--big not-content" data-fe-photons>
	<div class="fp-pic__grid">
		<svg class="fp-pic__svg" viewBox="0 0 440 236" role="img" aria-label="Фотоны красного (700 нм), зелёного (530 нм), фиолетового (400 нм) света и ультрафиолета (250 нм). Чем короче длина волны, тем больше энергия фотона: 1,78; 2,35; 3,11 и 4,97 эВ">
			<text class="fp-title" x="154" y="24" text-anchor="middle">Длина волны</text>
			<text class="fp-title" x={BX + 110} y="24" text-anchor="middle">Энергия фотона</text>
			{
				rows.map((r) => (
					<g>
						<text x="8" y={r.y - 3}>
							{r.name}
						</text>
						<text x="8" y={r.y + 13}>
							{r.nm} нм
						</text>
						<path class="fp-photon" d={r.d} style={`stroke: ${r.color}`} />
						<rect x={BX} y={r.y - 9} width={r.w.toFixed(1)} height="18" rx="3" style={`fill: ${r.fill}; stroke: ${r.color}`} />
						<text x={(BX + r.w + 6).toFixed(1)} y={r.y + 5}>
							{r.ev} эВ
						</text>
					</g>
				))
			}
			<line class="fp-axis-e" x1={BX} y1="212" x2={BX + 5.2 * S} y2="212"></line>
			{
				[0, 1, 2, 3, 4, 5].map((v) => (
					<g>
						<line class="fp-axis-e" x1={BX + v * S} y1="208" x2={BX + v * S} y2="216" />
						<text x={BX + v * S} y="230" text-anchor="middle">
							{v}
						</text>
					</g>
				))
			}
			<text x={BX - 8} y="230" text-anchor="end">эВ</text>
		</svg>
	</div>
	<div class="fp-pic__foot">
		<figcaption>
			Длины волн нарисованы в одном масштабе. Чем короче длина волны (больше частота), тем больше энергия фотона <i>E</i> = <i>hc</i>/<i>λ</i>.
		</figcaption>
	</div>
</figure>

<style is:global>
	.fp-axis-e {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
</style>
