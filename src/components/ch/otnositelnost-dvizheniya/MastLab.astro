---
/**
 * «Камень с мачты» (Galileo's ship): a sailing ship goes to the right over a calm harbor at υ (0…6 м/с, step 0,5,
 * start 5 м/с). A stone hangs on a hook 1 м in front of the main mast, h = 20 м above the deck. «Отпустить камень»
 * plays: the ship sails 0,8 с with the stone, the hook opens, the stone falls (no air resistance) and lands on the deck
 * 1 м in front of the mast foot after t = √(2h/g) = √(40/9,8) = 2,02 с, and the picture stops.
 * Two views: «Смотрим с корабля» (the camera rides with the ship: the ship stands, the quay with its bollards and lamps
 * runs back at υ; the far town is too far to move) and «Смотрим с берега» (the camera stands, the ship sails). The
 * stone's trace (gold) in the current view: from the ship a vertical line along the mast; from the shore a half
 * parabola that ends υ·t ahead of the release point (0; 4,0; 8,1; 10,1; 12,1 м for υ = 0; 2; 4; 5; 6 м/с). Switching
 * the view redraws the trace in the new frame: relative to the ship x = 1 м (constant), relative to the shore
 * x = x₀ + υ·t, y = h − g·t²/2 in both. Changing υ resets the release.
 * Scale: 7 px per м (mast 20 м = 140 px; the ship 21 м long); the stone is drawn 3 times larger. The clock runs
 * 2 times slower than a real one (the caption says so).
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 7;
const WATER = 206; // the waterline, px
const DECK = WATER - 2.5 * K; // the deck, px
const TOP = DECK - 20 * K; // the stone's hook, 20 м above the deck
// the ship, drawn with the mast foot at (0, DECK); the bow to the right
const hull = `M-84 ${DECK - 14} L-60 ${DECK - 14} L-58 ${DECK} L58 ${DECK} Q74 ${DECK - 2} 82 ${DECK - 12} L86 ${DECK - 10} Q80 ${WATER + 4} 52 ${WATER + 8} L-66 ${WATER + 8} Q-80 ${WATER} -84 ${DECK - 14} Z`;
const ports = [-40, -24, -8, 8, 24, 40].map((x) => `M${x - 3} ${DECK + 5} h6 v4 h-6 Z`).join(' ');
const town = 'M0 158 V140 H14 V132 H30 V146 H44 V128 L52 116 L60 128 V150 H78 V136 H96 V158 Z';
---

<G7Styles />
<figure class="g7 g7--stack mst not-content" data-mst>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Парусный корабль идёт по гавани. С верхушки мачты отпускают камень; золотая линия показывает его путь" data-svg>
			<rect class="mst__sky" x="0" y="0" width="360" height={WATER}></rect>
			<path class="mst__hill" d={`M0 ${WATER - 30} Q60 ${WATER - 62} 130 ${WATER - 40} Q200 ${WATER - 70} 280 ${WATER - 44} Q330 ${WATER - 58} 360 ${WATER - 40} V${WATER} H0 Z`}></path>
			<path class="mst__town" d={town} transform={`translate(214 ${WATER - 166})`}></path>
			<path class="mst__town" d={town} transform={`translate(24 ${WATER - 160}) scale(0.8 1)`}></path>
			<rect class="mst__water" x="0" y={WATER - 2} width="360" height={250 - WATER}></rect>
			<!-- things that belong to the shore (they run back when we look from the ship) -->
			<g data-shore>
				<path class="mst__ripple" data-ripples></path>
				<g data-buoys></g>
			</g>
			<!-- the ship -->
			<g data-ship>
				<path class="mst__mast" d={`M44 ${DECK} V${DECK - 15 * K} M-50 ${DECK - 14} V${DECK - 12 * K}`}></path>
				<path class="mst__sail" d={`M30 ${DECK - 13.5 * K} Q46 ${DECK - 10 * K} 30 ${DECK - 5 * K} H58 Q74 ${DECK - 10 * K} 58 ${DECK - 13.5 * K} Z`}></path>
				<path class="mst__yard" d={`M26 ${DECK - 13.5 * K} H62 M26 ${DECK - 5 * K} H62`}></path>
				<path class="mst__flag" d={`M44 ${DECK - 15 * K} l14 3 l-14 3 Z`}></path>
				<path class="mst__flag" d={`M-50 ${DECK - 12 * K} l12 2.5 l-12 2.5 Z`}></path>
				<path class="mst__mast mst__main" d={`M0 ${DECK} V${TOP - 10}`}></path>
				<path class="mst__yard" d={`M-16 ${DECK - 12 * K} H16 M-12 ${DECK - 6 * K} H12`}></path>
				<path class="mst__furled" d={`M-15 ${DECK - 12 * K + 2} Q0 ${DECK - 12 * K + 7} 15 ${DECK - 12 * K + 2} M-11 ${DECK - 6 * K + 2} Q0 ${DECK - 6 * K + 6} 11 ${DECK - 6 * K + 2}`}></path>
				<path class="mst__nest" d={`M-5 ${TOP - 4} h10 l-1.5 6 h-7 Z`}></path>
				<path class="mst__hook" d={`M0 ${TOP - 3} H${K + 1} V${TOP - 1}`}></path>
				<path class="mst__rope" d={`M-50 ${DECK - 12 * K} L0 ${TOP - 6} L44 ${DECK - 15 * K} L86 ${DECK - 10}`}></path>
				<path class="mst__hull" d={hull}></path>
				<path class="mst__rail" d={`M-84 ${DECK - 14} H-60 M-58 ${DECK} H58`}></path>
				<path class="mst__port" d={ports}></path>
				<path class="mst__foot" d={`M${K - 4} ${DECK} h8`}></path>
			</g>
			<path class="mst__trace" data-trace></path>
			<circle class="mst__stone" r="3.5" data-stone></circle>
			<!-- the quay in front, with bollards and lamps -->
			<g data-quay>
				<rect class="mst__quay" x="0" y="226" width="360" height="24"></rect>
				<path class="mst__quay-edge" d="M0 226 H360"></path>
				<path class="mst__bollard" data-bollards></path>
				<path class="mst__lamp" data-lamps></path>
			</g>
			<text class="t-small mst__mark" x="8" y="18" data-viewname></text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Откуда смотрим" data-view>
				<button type="button" class="g7__btn" aria-pressed="true" data-v="ship">Смотрим с корабля</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-v="shore">Смотрим с берега</button>
			</div>
			<label class="g7__slider">
				<span>Скорость корабля <i>υ</i></span>
				<output data-ov></output>
				<input type="range" min="0" max="6" step="0.5" value="5" data-v-slider aria-label="Скорость корабля, метры в секунду" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Отпустить камень</button>
			<ul class="g7__read" aria-live="polite">
				<li><span>Высота падения</span><b>20&nbsp;м</b></li>
				<li><span>Время падения</span><b data-rt>—</b></li>
				<li><span>Сместился по горизонтали относительно корабля</span><b data-rship>—</b></li>
				<li class="is-key"><span>Сместился по горизонтали относительно берега</span><b data-rshore>—</b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Камень отпускают с верхушки мачты движущегося корабля; золотая линия — его траектория. Время замедлено в 2 раза, камень нарисован крупнее, сопротивление воздуха не учитываем.
	</figcaption>
</figure>

<style is:global>
	.mst {
		--mst-wood: hsl(28, 45%, 38%);
		--mst-wood-dark: hsl(24, 40%, 26%);
		--mst-sail: hsl(40, 40%, 88%);
	}
	:root[data-theme='light'] .mst {
		--mst-wood: hsl(28, 50%, 46%);
		--mst-wood-dark: hsl(24, 45%, 32%);
		--mst-sail: hsl(40, 45%, 96%);
	}
	.mst__sky {
		fill: var(--g7-sky);
	}
	.mst__hill {
		fill: color-mix(in oklab, var(--g7-green) 30%, var(--sl-color-gray-5));
	}
	.mst__town {
		fill: color-mix(in oklab, var(--g7-line) 55%, var(--g7-sky));
	}
	.mst__water {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
	}
	.mst__ripple {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 60%, var(--sl-color-white));
		stroke-width: 1;
		stroke-linecap: round;
		opacity: 0.55;
	}
	.mst__buoy {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.mst__hull {
		fill: var(--mst-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.mst__rail {
		fill: none;
		stroke: var(--mst-wood-dark);
		stroke-width: 2.2;
	}
	.mst__port {
		fill: var(--mst-wood-dark);
	}
	.mst__mast {
		fill: none;
		stroke: var(--mst-wood-dark);
		stroke-width: 3;
	}
	.mst__main {
		stroke-width: 3.6;
	}
	.mst__yard {
		fill: none;
		stroke: var(--mst-wood-dark);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.mst__sail {
		fill: var(--mst-sail);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.mst__furled {
		fill: none;
		stroke: var(--mst-sail);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.mst__flag {
		fill: var(--g7-red);
	}
	.mst__nest {
		fill: var(--mst-wood-dark);
	}
	.mst__hook {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.mst__rope {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.6;
	}
	.mst__foot {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.mst__trace {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.mst__stone {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.mst__quay {
		fill: color-mix(in oklab, var(--g7-line) 50%, var(--sl-color-gray-5));
	}
	.mst__quay-edge {
		stroke: var(--g7-line);
		stroke-width: 2;
	}
	.mst__bollard {
		fill: var(--g7-ink);
	}
	.mst__lamp {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.mst__mark {
		fill: var(--g7-ink);
	}
</style>

<script>
	import { fmt, loop, segment } from '../g7/kit';

	const K = 7;
	const WATER = 206;
	const DECK = WATER - 2.5 * K;
	const H = 20; // м
	const g = 9.8;
	const TF = Math.sqrt((2 * H) / g); // 2,02 с
	const PRE = 0.8; // с of sailing before the release
	const POST = 0.15; // с after the landing: the picture stops with the stone at the mast
	const SLOW = 2;
	const SHIP_X = 150; // the mast on the screen when we ride with the ship
	const SHORE_X = 104; // the mast at the release when we stand on the shore
	const NS = 'http://www.w3.org/2000/svg';

	for (const root of document.querySelectorAll<HTMLElement>('[data-mst]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const ship = $<SVGGElement>('[data-ship]');
		const stone = $<SVGCircleElement>('[data-stone]');
		const trace = $<SVGPathElement>('[data-trace]');
		const ripples = $<SVGPathElement>('[data-ripples]');
		const buoys = $<SVGGElement>('[data-buoys]');
		const bollards = $<SVGPathElement>('[data-bollards]');
		const lamps = $<SVGPathElement>('[data-lamps]');
		const slider = $<HTMLInputElement>('[data-v-slider]');
		const ov = $<HTMLOutputElement>('[data-ov]');
		const rt = $('[data-rt]');
		const rship = $('[data-rship]');
		const rshore = $('[data-rshore]');
		const viewName = $('[data-viewname]');
		let v = +slider.value;
		let view: 'ship' | 'shore' = 'ship';
		let tau = -PRE; // с of the experiment; −PRE = ready
		let running = false;
		const buoyEls = [0, 1, 2].map(() => {
			const b = document.createElementNS(NS, 'path');
			b.setAttribute('class', 'mst__buoy');
			b.setAttribute('d', 'M-4 0 Q-4 -9 0 -10 Q4 -9 4 0 Z M-0.6 -10 V-15 H0.6 V-10 Z');
			buoys.append(b);
			return b;
		});
		// shore things in world meters (x = 0: where the mast is at the release)
		const BOLLARD = 8;
		const LAMP = 24;
		const BUOY = 30;
		const wrap = (x: number, p: number, lo: number) => ((((x - lo) % p) + p) % p) + lo;

		const draw = () => {
			const shipX = v * tau; // м, the mast relative to the shore
			// screen x of a shore point at x м, and of the mast
			const sx = (x: number) => (view === 'shore' ? SHORE_X + x * K : SHIP_X + (x - shipX) * K);
			const mastX = sx(shipX);
			ship.setAttribute('transform', `translate(${mastX.toFixed(2)} 0)`);
			// the quay: bollards every 8 м, lamps every 24 м, ripples every 3 м, buoys every 30 м
			let d = '';
			for (let i = -30; i <= 40; i++) {
				const x = sx(i * BOLLARD);
				if (x > -10 && x < 370) d += `M${(x - 3).toFixed(1)} 226 v-5 q3 -3 6 0 v5 Z`;
			}
			bollards.setAttribute('d', d);
			d = '';
			for (let i = -12; i <= 14; i++) {
				const x = sx(i * LAMP + 4);
				if (x > -20 && x < 380) d += `M${x.toFixed(1)} 226 V188 q0 -5 6 -5 h4 M${(x + 8).toFixed(1)} 183 v3`;
			}
			lamps.setAttribute('d', d);
			d = '';
			for (let i = -100; i <= 140; i++) {
				const x = sx(i * 3);
				if (x < -10 || x > 370) continue;
				const y = WATER + 4 + ((i * 7) % 4) * 3.4;
				d += `M${(x - 3).toFixed(1)} ${y} q1.5 -1.4 3 0 q1.5 1.4 3 0`;
			}
			ripples.setAttribute('d', d);
			buoyEls.forEach((b, i) => {
				let x = sx((i - 1) * BUOY + 12);
				if (view === 'ship') x = wrap(x, 3 * BUOY * K, -40);
				b.setAttribute('transform', `translate(${x.toFixed(1)} ${WATER + 1})`);
			});
			// the stone: on the hook, falling, or lying on the deck; 1 м in front of the mast
			const tf = Math.min(Math.max(tau, 0), TF);
			const y = H - 0.5 * g * tf * tf; // м above the deck
			stone.setAttribute('cx', (mastX + K).toFixed(2));
			stone.setAttribute('cy', (DECK - y * K - 3.5).toFixed(2));
			// the trace in the current view
			if (tau > 0) {
				let p = '';
				const n = 40;
				for (let i = 0; i <= n; i++) {
					const ti = (tf * i) / n;
					const xs = view === 'shore' ? sx(v * ti + 1) : sx(shipX + 1);
					const ys = DECK - (H - 0.5 * g * ti * ti) * K - 3.5;
					p += `${i ? 'L' : 'M'}${xs.toFixed(1)} ${ys.toFixed(1)}`;
				}
				trace.setAttribute('d', p);
			} else trace.setAttribute('d', '');
			// readouts
			ov.textContent = `${fmt(v, 1)}\u00a0м/с`;
			viewName.textContent = view === 'ship' ? 'Смотрим с корабля' : 'Смотрим с берега';
			if (tau <= 0) {
				rt.textContent = '—';
				rship.textContent = '—';
				rshore.textContent = '—';
			} else {
				rt.textContent = `${fmt(tf, 1)}\u00a0с`;
				rship.textContent = '0\u00a0м';
				rshore.textContent = `${fmt(v * tf, 1)}\u00a0м`;
			}
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			tau += dt / SLOW;
			if (tau >= TF + POST) {
				tau = TF + POST;
				running = false;
			}
			draw();
			return running;
		});
		segment($('[data-view]'), (b) => {
			view = b.dataset.v as 'ship' | 'shore';
			draw();
		});
		slider.addEventListener('input', () => {
			v = +slider.value;
			tau = -PRE;
			running = false;
			draw();
		});
		$('[data-go]').addEventListener('click', () => {
			tau = -PRE;
			running = true;
			draw();
			wake();
		});
		draw();
	}
</script>
