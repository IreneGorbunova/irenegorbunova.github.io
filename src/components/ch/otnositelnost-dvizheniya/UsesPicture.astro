---
/**
 * Small pictures for «Где это встречается» (kind = harvester | refueling | docking): two bodies that move together
 * and are at rest relative to each other. The camera rides with them, so the surroundings run back.
 *   harvester: a combine harvester unloads grain through its spout into a truck driving alongside on the far side;
 *     both go at about 5 км/ч (1,4 м/с) over the field; the stubble rows run back at 1,4 м/с (8 px per м, 11 px/с);
 *     the grain falls from the spout straight into the truck's body (the stream does not lag: the truck keeps pace).
 *   refueling: a tanker plane trails a hose with a basket (drogue); a fighter behind it has its probe in the basket;
 *     both fly at about 600 км/ч. Clouds far below drift back slowly (they are kilometers away).
 *   docking: the space station and a Союз that approaches its docking port slowly, a few centimeters per second
 *     relative to the station (here 10 px in 8 s, looped), while both go round the Earth at about 7,7 км/с; the
 *     clouds on the Earth below run back.
 * Not to scale; no numbers in the pictures.
 */
interface Props {
	kind: 'harvester' | 'refueling' | 'docking';
}
const { kind } = Astro.props;
const label = {
	harvester: 'Комбайн ссыпает зерно в грузовик, который едет рядом с той же скоростью',
	refueling: 'Самолёт-заправщик и истребитель летят рядом с одинаковой скоростью; штанга истребителя вставлена в конус шланга',
	docking: 'Корабль «Союз» медленно подходит к космической станции; внизу Земля с облаками',
}[kind];
---

<svg class="usp not-content" data-usp={kind} viewBox="0 0 300 170" role="img" aria-label={label}>
	{kind === 'harvester' && (
		<g>
			<rect class="usp__sky" x="0" y="0" width="300" height="100"></rect>
			<rect class="usp__field" x="0" y="96" width="300" height="74"></rect>
			<path class="usp__rows" data-move="11" data-period="24"></path>
			<!-- the truck on the far side -->
			<g transform="translate(150 0)">
				<path class="usp__truck-body" d="M-40 66 H48 V98 H-40 Z"></path>
				<path class="usp__grain" d="M-38 70 Q4 54 46 70 V74 H-38 Z"></path>
				<path class="usp__truck-cab" d="M50 72 H72 Q80 72 82 84 V102 H50 Z"></path>
				<path class="usp__glass" d="M60 76 H72 Q77 77 78 86 H60 Z"></path>
				<circle class="usp__wheel" cx="-24" cy="104" r="8"></circle>
				<circle class="usp__wheel" cx="34" cy="104" r="8"></circle>
				<circle class="usp__wheel" cx="66" cy="104" r="8"></circle>
			</g>
			<!-- the combine in front -->
			<path class="usp__auger" d="M118 70 L150 36 L188 36 L192 44"></path>
			<path class="usp__grainfall" data-grain></path>
			<path class="usp__combine" d="M40 86 H150 V120 H40 Z M70 86 V62 H112 V86 Z"></path>
			<path class="usp__glass" d="M76 66 H108 V84 H76 Z"></path>
			<path class="usp__header" d="M150 118 H196 L200 132 H150 Z"></path>
			<path class="usp__reel" d="M158 108 h34" stroke-dasharray="3 3"></path>
			<circle class="usp__wheel" cx="66" cy="128" r="16"></circle>
			<circle class="usp__wheel" cx="132" cy="132" r="11"></circle>
		</g>
	)}
	{kind === 'refueling' && (
		<g>
			<rect class="usp__sky2" x="0" y="0" width="300" height="170"></rect>
			<path class="usp__cloud" data-move="6" data-period="300"></path>
			<!-- the tanker, flying to the right -->
			<path class="usp__plane" d="M150 40 H262 Q284 40 290 48 Q284 56 262 56 H150 Q140 56 136 48 Q140 40 150 40 Z"></path>
			<path class="usp__plane" d="M150 40 L138 20 H150 L170 40 Z"></path>
			<path class="usp__wing" d="M200 52 L178 74 H194 L232 52 Z"></path>
			<path class="usp__pod" d="M184 70 h16 v5 h-16 Z"></path>
			<path class="usp__glass" d="M272 43 q8 1 12 5 h-12 Z"></path>
			<path class="usp__hose" d="M184 73 Q150 92 108 98"></path>
			<path class="usp__drogue" d="M110 92 L96 88 L96 108 L110 104 Z"></path>
			<!-- the fighter behind and below, its probe in the basket -->
			<path class="usp__fighter" d="M20 112 H72 Q92 112 100 118 Q92 124 72 124 H20 Z"></path>
			<path class="usp__fighter" d="M34 112 L24 96 H34 L48 112 Z M44 120 L30 140 H44 L64 120 Z"></path>
			<path class="usp__glass" d="M72 112 q10 0 16 5 h-16 Z"></path>
			<path class="usp__probe" d="M80 113 L100 99"></path>
		</g>
	)}
	{kind === 'docking' && (
		<g>
			<rect class="usp__space" x="0" y="0" width="300" height="170"></rect>
			<path class="usp__earth" d="M-20 170 Q150 112 320 170 Z"></path>
			<path class="usp__ecloud" data-move="40" data-period="300"></path>
			<!-- the station on the right -->
			<path class="usp__truss" d="M150 70 H290 M220 40 V100"></path>
			<path class="usp__panel" d="M160 30 h24 v32 h-24 Z M256 30 h24 v32 h-24 Z M160 78 h24 v32 h-24 Z M256 78 h24 v32 h-24 Z"></path>
			<path class="usp__module" d="M190 62 h70 v16 h-70 Z M206 56 h20 v28 h-20 Z"></path>
			<path class="usp__port" d="M182 66 h8 v8 h-8 Z"></path>
			<!-- the Союз, moved by the script -->
			<g data-soyuz>
				<path class="usp__module2" d="M120 64 a8 8 0 0 1 8 6 a8 8 0 0 1 -8 6 Z M96 63 h24 v14 h-24 Z M84 65 h12 v10 h-12 Z"></path>
				<path class="usp__panel" d="M88 50 h6 v14 h-6 Z M88 76 h6 v14 h-6 Z"></path>
				<path class="usp__probe" d="M128 70 h6"></path>
			</g>
		</g>
	)}
</svg>

<style is:global>
	.usp {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
	}
	.usp__sky {
		fill: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-bg));
	}
	.usp__field {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
	}
	.usp__rows {
		stroke: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke-width: 1.2;
	}
	.usp__truck-body {
		fill: hsl(205, 45%, 45%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.usp__truck-cab {
		fill: hsl(205, 50%, 38%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.usp__grain,
	.usp__grainfall {
		fill: hsl(44, 80%, 60%);
	}
	.usp__grainfall {
		fill: none;
		stroke: hsl(44, 80%, 60%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.usp__combine {
		fill: hsl(140, 45%, 38%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.7;
		fill-rule: nonzero;
	}
	.usp__header {
		fill: hsl(48, 80%, 50%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.usp__reel {
		stroke: hsl(48, 80%, 50%);
		stroke-width: 6;
	}
	.usp__auger {
		fill: none;
		stroke: hsl(140, 40%, 32%);
		stroke-width: 6;
		stroke-linejoin: round;
	}
	.usp__wheel {
		fill: hsl(220, 10%, 14%);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.usp__glass {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-5));
	}
	.usp__sky2 {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
	}
	.usp__cloud,
	.usp__ecloud {
		fill: hsl(0, 0%, 100%);
		opacity: 0.45;
	}
	.usp__plane,
	.usp__wing,
	.usp__fighter {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.7;
	}
	.usp__fighter {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--ig-vx));
	}
	.usp__pod {
		fill: var(--sl-color-gray-4);
	}
	.usp__hose {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.usp__drogue {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.usp__probe {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.usp__space {
		fill: hsl(230, 40%, 10%);
	}
	.usp__earth {
		fill: hsl(210, 60%, 40%);
	}
	.usp__truss {
		stroke: hsl(0, 0%, 75%);
		stroke-width: 3;
	}
	.usp__panel {
		fill: hsl(215, 60%, 35%);
		stroke: hsl(45, 70%, 60%);
		stroke-width: 0.8;
	}
	.usp__module,
	.usp__module2 {
		fill: hsl(0, 0%, 85%);
		stroke: hsl(0, 0%, 50%);
		stroke-width: 0.6;
	}
	.usp__module2 {
		fill: hsl(90, 20%, 60%);
	}
	.usp__port {
		fill: hsl(0, 0%, 60%);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	for (const svg of document.querySelectorAll<SVGSVGElement>('[data-usp]')) {
		const kind = svg.dataset.usp;
		const mover = svg.querySelector<SVGPathElement>('[data-move]');
		const speed = mover ? +mover.dataset.move! : 0;
		const period = mover ? +mover.dataset.period! : 1;
		const grain = svg.querySelector<SVGPathElement>('[data-grain]');
		const soyuz = svg.querySelector<SVGGElement>('[data-soyuz]');
		let t = 0;
		const shape = (x: number) => {
			if (kind === 'harvester') return `M${x.toFixed(1)} 100 l-14 70`;
			if (kind === 'refueling') return `M${x.toFixed(1)} 150 q10 -12 24 -6 q10 -10 22 0 q14 -2 12 8 h-56 Z`;
			return `M${x.toFixed(1)} 150 q12 -8 26 -2 q12 -6 22 2 q10 0 8 6 h-54 Z`;
		};
		const draw = () => {
			if (mover) {
				let d = '';
				const step = kind === 'harvester' ? 24 : 100;
				const off = (((-speed * t) % period) + period) % period;
				for (let x = off - period; x < 320; x += step) d += shape(x);
				mover.setAttribute('d', d);
			}
			if (grain) {
				// grains fall from the spout at x ≈ 191 into the truck body below (they keep the vehicles' speed)
				let d = '';
				for (let i = 0; i < 8; i++) {
					const y = 46 + ((t * 60 + i * 3.5) % 26);
					d += `M${191 + (i % 3) - 1} ${y.toFixed(1)} v2.5`;
				}
				grain.setAttribute('d', d);
			}
			if (soyuz) soyuz.setAttribute('transform', `translate(${(30 + Math.min(10, ((t % 10) / 8) * 10)).toFixed(2)} 0)`);
		};
		loop(svg, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
