</style>

<script>
	import { scene } from '@components/intro/scene';
	import { DEG, ELBOW, SKELETON, add, fk, lerp, lerpPt, polar, type Pt } from '@components/people/core';
	import { figure, ANKLE_CM, type FigurePose, type HandTarget, type Figure } from '@components/people/body';
	import { ROLL, blendShape, handShape } from '@components/people/hand';
	import { ease } from '@components/people/motion';

	const clamp01 = (x: number) => Math.min(1, Math.max(0, x));

	for (const root of document.querySelectorAll<HTMLElement>('[data-otnintro]')) {
		// ---------------- scene 1: the neighboring train
		{
			const card = root.querySelector<HTMLElement>('[data-scene="train"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 10;
			const T0 = 0.8; // the neighbor starts
			const A = 0.3; // м/с²
			const KN = 35; // px per м at the neighbor
			const neighbor = $<SVGGElement>('[data-neighbor]');
			const steam = [0, 1].map((i) => $<SVGPathElement>(`[data-steam="${i}"]`));
			// the boy: teen, 164 см at 1,2 px per см, facing right; seat top at y = 182
			const S = 1.2;
			const boy = figure($<SVGGElement>('[data-boy]'), { s: S, H: 164, age: 'teen', shirt: 'hm-gold', hair: 'short', name: 'boy' });
			boy.backLayer(1, $<SVGGElement>('[data-glass-back]'));
			const ankleY = 236 - ANKLE_CM.trainer * S;
			const pose = (lean: number, head: number): FigurePose => ({
				hip: { x: 98, y: 176 },
				lean,
				head,
				ankles: [{ x: 148, y: ankleY }, { x: 142, y: ankleY }],
				feet: [0, 0],
				hands: [
					{ at: { x: 134, y: 141 }, pose: 'relaxed', dir: 4 * DEG, roll: ROLL.backViewer, contact: 'table' },
					{ at: { x: 155, y: 138 }, pose: 'grip', d: 8, dir: -5 * DEG, roll: ROLL.backViewer, contact: 'glass' },
				],
				planted: [true, true],
			});
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const s = t < T0 ? 0 : 0.5 * A * (t - T0) ** 2;
				neighbor.setAttribute('transform', `translate(${(-s * KN).toFixed(2)} 0)`);
				// the feeling that our car moves: he leans back a little and looks up at the window, then settles
				const k = ease((t - 1.3) / 1.0) * (1 - ease((t - 8.5) / 1.0));
				boy.pose(pose(0.12 - 0.06 * k, 0.05 - 0.17 * k));
				// steam rises straight up from the glass (still air: nothing moves in the compartment)
				steam.forEach((p, i) => {
					let d = '';
					const ph = t * 0.9 + i * 1.7;
					for (let j = 0; j <= 10; j++) {
						const y = 127 - j * 3.4;
						const xx = 155 + (i ? 1.5 : -1.5) + 2.2 * Math.sin(ph * 2 + j * 0.55) * (j / 10);
						d += `${j ? 'L' : 'M'}${xx.toFixed(1)} ${y.toFixed(1)}`;
					}
					p.setAttribute('d', d);
					p.style.opacity = (0.25 + 0.15 * Math.sin(ph + i)).toFixed(2);
				});
			});
		}

		// ---------------- scene 2: the relay
		{
			const card = root.querySelector<HTMLElement>('[data-scene="relay"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 6;
			const KW = 110; // px per м in the world
			const SR = KW / 100; // px per см
			const H = 165;
			const sk = SKELETON.teen;
			const u = SR * H;
			const ua = sk.upper * u;
			const fa = sk.fore * u;
			const T_S = 1.0; // the second runner starts
			const A2 = 3.5; // м/с², her acceleration
			const V = 8; // м/с
			const T_E = T_S + V / A2; // she reaches 8 м/с
			const T_HE = T_E + 1.0; // end of the side-by-side second
			const GAP = 0.94; // м between the hips at the handover
			const X2E = 0.5 * A2 * (T_E - T_S) ** 2;
			const X10 = X2E - GAP - V * T_E; // the first runner's start, м
			const vel = [
				(t: number) => (t < T_HE ? V : Math.max(0, V - 3 * (t - T_HE))),
				(t: number) => (t < T_S ? 0 : t < T_E ? A2 * (t - T_S) : t < T_HE ? V : V + 1.2 * (t - T_HE)),
			];
			const acc = [
				(t: number) => (t < T_HE ? 0 : -3),
				(t: number) => (t < T_S ? 0 : t < T_E ? A2 : t < T_HE ? 0 : 1.2),
			];
			const stepLen = (v: number) => 0.35 + 0.19 * v;
			const contact = (v: number) => 0.26 + 0.05 * v;
			// tabulated kinematics: hip x (м) and step phase, from a little before 0 to after RUN
			const DT = 1 / 480;
			const TA = -1;
			const TB = RUN + 1.5;
			const NT = Math.ceil((TB - TA) / DT) + 1;
			type Kin = { X: Float64Array; P: Float64Array; steps: number[]; start: number; nMin: number };
			const kin: Kin[] = [0, 1].map((r) => {
				const X = new Float64Array(NT);
				const P = new Float64Array(NT);
				let x = r === 0 ? X10 + V * TA : 0;
				// the first runner: phase 0 at t = 0, so start from its value at TA
				let p = r === 0 ? (TA * V) / stepLen(V) : 0;
				for (let i = 0; i < NT; i++) {
					const t = TA + i * DT;
					X[i] = x;
					P[i] = p;
					const v = vel[r](t);
					const vn = vel[r](t + DT);
					x += 0.5 * (v + vn) * DT;
					if (r === 0 || t >= T_S) p += (0.5 * (v + vn) * DT) / stepLen(0.5 * (v + vn) + 1e-9);
				}
				// times of touchdowns (integer phases)
				const steps: number[] = [];
				const nMin = r === 0 ? Math.ceil(P[0]) : 0;
				if (r === 1) steps[0] = T_S;
				for (let i = 1; i < NT; i++) {
					if (P[i] <= P[i - 1]) continue;
					for (let n = Math.max(nMin, Math.ceil(P[i - 1])); n <= P[i]; n++) steps[n - nMin] ??= TA + (i - 1 + (n - P[i - 1]) / (P[i] - P[i - 1])) * DT;
				}
				return { X, P, steps, start: r === 1 ? T_S : -Infinity, nMin };
			});
			const at = (arr: Float64Array, t: number) => {
				const q = Math.min(NT - 1.001, Math.max(0, (t - TA) / DT));
				const i = Math.floor(q);
				return arr[i] + (arr[i + 1] - arr[i]) * (q - i);
			};
			const tOf = (k: Kin, n: number) => k.steps[n - k.nMin];
			// the ankle (flat foot) of step n, м; the second runner's first two are her standing feet
			const ankleOf = (r: number, n: number) => {
				if (r === 1 && n === 0) return 0.15;
				if (r === 1 && n === -1) return -0.3;
				return at(kin[r].X, tOf(kin[r], n)) + 0.15;
			};
			// the time the hip reaches x (м) after time t0
			const timeAt = (r: number, x: number, t0: number) => {
				const X = kin[r].X;
				let i = Math.max(0, Math.floor((t0 - TA) / DT));
				while (i < NT - 1 && X[i + 1] < x) i++;
				return TA + (i + (x - X[i]) / Math.max(1e-9, X[i + 1] - X[i])) * DT;
			};
			const FOOT = { x: 15, y: 7 }; // ankle → ball of the foot, см
			const ALPHA = 0.9; // heel rise at toe-off, rad
			const toeAnkle = (toe: Pt, a: number): Pt => ({
				x: toe.x - (FOOT.x * Math.cos(a) - FOOT.y * Math.sin(a)) * SR,
				y: toe.y - (FOOT.x * Math.sin(a) + FOOT.y * Math.cos(a)) * SR,
			});
			const ground = [-8, 0]; // world px: the first runner is a little farther from us
			const ankleH = ANKLE_CM.trainer * SR;
			/** Ankle, foot angle and planted flag of foot i of runner r at time t. */
			const foot = (r: number, i: number, t: number) => {
				const k = kin[r];
				const g = ground[r];
				const X = at(k.X, t);
				const flat = (ax: number): Pt => ({ x: ax * KW, y: g - ankleH });
				if (t < k.start) return { a: flat(i === 0 ? 0.15 : -0.3), ang: 0, planted: true };
				// the latest touchdown of this foot
				let n = Math.floor(at(k.P, t));
				if ((((n - i) % 2) + 2) % 2) n -= 1;
				// the step index from the touchdown times themselves, so that the phase table and the step table never disagree
				const tAt = (q: number) => (r === 1 && q === -1 ? T_S - 1 : (tOf(k, q) ?? Infinity));
				while (n - 2 >= (r === 1 ? -1 : k.nMin) && tAt(n) > t) n -= 2;
				while (tAt(n + 2) <= t) n += 2;
				const tn = r === 1 && n === -1 ? T_S - 1 : tOf(k, n);
				const A0 = ankleOf(r, n);
				const v = vel[r](Math.max(tn, k.start));
				const D = contact(v);
				const p1 = 0.45 * D - 0.15;
				const p2 = D - 0.15;
				const toe = { x: A0 * KW + FOOT.x * SR, y: g };
				const tOff = r === 1 && n === -1 ? T_S : timeAt(r, A0 + p2, tn);
				if (t < tOff) {
					const q = clamp01((X - A0 - p1) / (p2 - p1));
					const a = ALPHA * q;
					return { a: toeAnkle(toe, a), ang: a, planted: q === 0 };
				}
				// swing to the touchdown two steps later
				const tE = tOf(k, n + 2);
				const S0 = r === 1 && n === -1 ? flat(-0.3) : toeAnkle(toe, ALPHA);
				const a0 = r === 1 && n === -1 ? 0 : ALPHA;
				const E = flat(ankleOf(r, n + 2));
				const w = clamp01((t - tOff) / (tE - tOff));
				const vv = vel[r](t);
				const lift = Math.min(0.5, 0.06 + 0.055 * vv) * KW;
				const g3 = w * w * (3 - 2 * w);
				// the swing is planned relative to the hip: the heel comes up behind the body, then the shin swings forward
				const sRel = S0.x - at(k.X, tOff) * KW;
				const eRel = E.x - at(k.X, tE) * KW;
				return {
					a: { x: X * KW + lerp(sRel, eRel, g3), y: lerp(S0.y, E.y, w) - lift * Math.sin(Math.PI * Math.pow(w, 0.6)) },
					ang: a0 * (1 - w) ** 2 - 0.25 * Math.sin(Math.PI * w) * w,
					planted: false,
				};
			};
			const leanOf = (r: number, t: number) => {
				const a = acc[r](t);
				const run = a >= 0 ? 0.16 + (0.26 * a) / A2 : 0.16 + (0.05 * a) / 3;
				return r === 1 ? lerp(0.36, run, ease((t - T_S) / 0.3)) : run;
			};
			const hipOf = (r: number, t: number): Pt => {
				const k = kin[r];
				const v = vel[r](t);
				const runH = sk.hip * (H / 100) * (0.97 - 0.006 * v);
				const h = r === 1 ? lerp(0.72, runH, ease((t - T_S) / 0.5)) : runH;
				const ph = at(k.P, t);
				const bob = -0.018 * Math.cos(2 * Math.PI * (ph - 0.2)) * Math.min(1, v / 3);
				return { x: at(k.X, t) * KW, y: ground[r] - (h + bob) * KW };
			};
			/** Pumping arms by angles: the hand's grip point and the forearm's direction. */
			const pump = (f: Figure, r: number, t: number, i: 0 | 1, hip: Pt, lean: number) => {
				const v = vel[r](t);
				const ph = at(kin[r].P, t);
				const amp = 0.2 + 0.065 * v;
				const c = Math.cos(Math.PI * (ph - 0.2));
				let th = Math.PI / 2 + (i === 0 ? -1 : 1) * amp * c;
				let bend = 1.45;
				if (r === 1 && t < T_S + 0.3) {
					// her ready stance: near arm forward and bent, far arm back
					const w = ease((t - T_S) / 0.3);
					th = lerp(i === 0 ? Math.PI / 2 - 0.45 : Math.PI / 2 + 0.5, th, w);
					bend = lerp(i === 0 ? 1.3 : 0.7, bend, w);
				}
				const sh = f.shoulders(hip, lean)[i];
				const arm = fk(sh, th, bend, ua, fa, ELBOW);
				const dir = Math.atan2(arm.end.y - arm.j.y, arm.end.x - arm.j.x);
				return { arm: [th, bend] as [number, number], dir };
			};

			const r1 = figure($<SVGGElement>('[data-runner1]'), { s: SR, H, age: 'teen', shirt: 'hm-blue', hair: 'short', bare: true, shorts: true, name: 'runner1' });
			const r2 = figure($<SVGGElement>('[data-runner2]'), { s: SR, H, age: 'teen', shirt: 'hm-blue', hair: 'pony', bare: true, shorts: true, name: 'runner2' });
			r1.backLayer(0, $<SVGGElement>('[data-runner1-back]'));
			r2.backLayer(1, $<SVGGElement>('[data-runner2-back]'));
			const world = $<SVGGElement>('[data-world]');
			const baton = $<SVGPathElement>('[data-baton]');
			const BAT = 30 * SR; // baton length, px
			const G1 = 8 * SR; // his grip from the bottom
			const G2 = 22 * SR; // her grip from the bottom
			/** A point between a and b on an arc around the shoulder (the hand swings below it, never through the body). */
			const arc = (sh: Pt, a: Pt, b: Pt, w: number): Pt => {
				const ang = (q: Pt) => {
					let v = Math.atan2(q.y - sh.y, q.x - sh.x);
					if (v < -Math.PI / 2) v += 2 * Math.PI;
					return v;
				};
				return add(sh, polar(lerp(Math.hypot(a.x - sh.x, a.y - sh.y), Math.hypot(b.x - sh.x, b.y - sh.y), w), lerp(ang(a), ang(b), w)));
			};
			let lastU: Pt = { x: 0, y: -1 };
			const upAxis = (ax: Pt): Pt => {
				const l = Math.hypot(ax.x, ax.y);
				if (l < 0.2) return lastU;
				const a = { x: ax.x / l, y: ax.y / l };
				return a.x * lastU.x + a.y * lastU.y >= 0 ? a : { x: -a.x, y: -a.y };
			};

			scene(card, RUN, (x) => {
				const t = RUN * x;
				if (t < 0.05) lastU = { x: 0, y: -1 };
				// camera: pans along the track and zooms; it changes no motion
				const x1 = at(kin[0].X, t);
				const x2 = at(kin[1].X, t);
				const zin = ease((t - 1.6) / 1.4);
				const zout = ease((t - 4.4) / 1.4);
				const z = lerp(lerp(0.25, 0.85, zin), 0.34, zout);
				const cx = lerp(x1 + 5.4, 0.5 * (x1 + x2) + 0.1, ease((t - 1.2) / 1.8));
				world.setAttribute('transform', `translate(180 ${(214 - 16 * zin * (1 - zout)).toFixed(1)}) scale(${z.toFixed(4)}) translate(${(-cx * KW).toFixed(2)} 0)`);

				const live = t < RUN - 0.02; // the held end frame is not «planted»: the loop restart is a jump, not a slide
				const feet = [0, 1].map((r) => [foot(r, 0, t), foot(r, 1, t)].map((f) => ({ ...f, planted: f.planted && live })));
				const hips = [hipOf(0, t), hipOf(1, t)];
				const leans = [leanOf(0, t), leanOf(1, t)];
				// her far (left) hand: pumping, then reaching back open, closing on the baton, then pumping with it (4 × 100: right hand to left hand)
				const wr = ease((t - 2.95) / 0.4) * (1 - ease((t - 4.15) / 0.45));
				const pr2 = pump(r2, 1, t, 1, hips[1], leans[1]);
				const sh2 = r2.shoulders(hips[1], leans[1])[1];
				const reach2 = add(sh2, polar(0.55 * KW, Math.PI - 0.15));
				const has2 = t >= 3.6; // she holds the baton
				const shape2 =
					t < 3.55 ? blendShape(handShape('relaxed'), handShape('open'), ease((t - 2.95) / 0.4)) : t < 4.15 ? blendShape(handShape('open'), handShape('grip', (4 * SR) / (sk.hand * u)), ease((t - 3.55) / 0.25)) : handShape('grip', (4 * SR) / (sk.hand * u));
				let st2;
				if (wr <= 0.001) {
					st2 = r2.pose({ hip: hips[1], lean: leans[1], ankles: [feet[1][0].a, feet[1][1].a], feet: [feet[1][0].ang, feet[1][1].ang], planted: [feet[1][0].planted, feet[1][1].planted], hands: [{ arm: pump(r2, 1, t, 0, hips[1], leans[1]).arm, pose: 'relaxed' }, { arm: pr2.arm, pose: has2 ? 'grip' : 'relaxed', d: 4, shape: shape2, roll: has2 ? ROLL.palmViewer : undefined, contact: has2 ? 'baton' : undefined }] });
				} else {
					const base = r2.pose({ hip: hips[1], lean: leans[1], ankles: [feet[1][0].a, feet[1][1].a], feet: [feet[1][0].ang, feet[1][1].ang], hands: [{ arm: [Math.PI / 2, 1.45], pose: 'relaxed' }, { arm: pr2.arm, pose: 'relaxed' }] }).grips[1];
					const target = arc(sh2, { x: base.x, y: base.y }, reach2, wr);
					st2 = r2.pose({
						hip: hips[1],
						lean: leans[1],
						ankles: [feet[1][0].a, feet[1][1].a],
						feet: [feet[1][0].ang, feet[1][1].ang],
						planted: [feet[1][0].planted, feet[1][1].planted],
						hands: [
							{ arm: pump(r2, 1, t, 0, hips[1], leans[1]).arm, pose: 'relaxed' },
							{ at: target, pose: t < 3.6 ? 'open' : 'grip', d: 4, shape: shape2, dir: lerp(base.angle, Math.PI - 0.2, wr), roll: ROLL.palmViewer, contact: has2 ? 'baton' : undefined },
						],
					});
				}
				// his near hand: pumping with the baton, then pushing it up into her hand, letting go, pumping empty
				const wp = ease((t - 3.05) / 0.4) * (1 - ease((t - 4.15) / 0.45));
				const has1 = t < 3.9;
				const shape1 = t < 3.9 ? handShape('grip', (4 * SR) / (sk.hand * u)) : t < 4.15 ? blendShape(handShape('grip', (4 * SR) / (sk.hand * u)), handShape('open'), ease((t - 3.9) / 0.2)) : blendShape(handShape('open'), handShape('relaxed'), ease((t - 4.15) / 0.4));
				const pr1 = pump(r1, 0, t, 0, hips[0], leans[0]);
				const legs1 = { hip: hips[0], lean: leans[0], ankles: [feet[0][0].a, feet[0][1].a] as [Pt, Pt], feet: [feet[0][0].ang, feet[0][1].ang] as [number, number], planted: [feet[0][0].planted, feet[0][1].planted] as [boolean, boolean] };
				const far1 = { arm: pump(r1, 0, t, 1, hips[0], leans[0]).arm, pose: 'relaxed' as const };
				let st1;
				if (wp <= 0.001) {
					st1 = r1.pose({ ...legs1, hands: [{ arm: pr1.arm, pose: has1 ? 'grip' : 'relaxed', d: 4, shape: shape1, roll: ROLL.backViewer, contact: has1 ? 'baton' : undefined }, far1] });
				} else {
					const base = r1.pose({ ...legs1, planted: undefined, hands: [{ arm: pr1.arm, pose: 'grip', d: 4, shape: shape1, roll: ROLL.backViewer }, far1] }).grips[0];
					// the baton's top part goes into her hand: his grip is G2 − G1 below her grip point, coming from behind and below
					const g2 = st2.grips[1];
					const come = 1 - ease((t - 3.2) / 0.35);
					const sh1 = r1.shoulders(hips[0], leans[0])[0];
					// after letting go his hand no longer follows hers
					let goal = lerpPt({ x: g2.x - 8 * come, y: g2.y + (G2 - G1) + 10 * come }, add(sh1, polar(0.5 * KW, 0.64)), ease((t - 3.95) / 0.15));
					// while her hand is still on its way back, his hand goes only as far as his arm allows
					const gd = Math.hypot(goal.x - sh1.x, goal.y - sh1.y);
					if (gd > 0.52 * KW) goal = add(sh1, polar(0.52 * KW, Math.atan2(goal.y - sh1.y, goal.x - sh1.x)));
					const target = arc(sh1, { x: base.x, y: base.y }, goal, wp);
					st1 = r1.pose({ ...legs1, hands: [{ at: target, pose: 'grip', d: 4, shape: shape1, dir: lerp(base.angle, 0.35, wp), roll: ROLL.backViewer, contact: has1 ? 'baton' : undefined }, far1] });
				}
				// the baton: in his hand, then (both hands on it) handed over, then in hers
				const f1 = st1.grips[0];
				const f2 = st2.grips[1];
				const u1 = upAxis(f1.axis);
				const bot1 = { x: f1.x - u1.x * G1, y: f1.y - u1.y * G1 };
				let bot = bot1;
				let uu = u1;
				const hand = ease((t - 3.85) / 0.2);
				if (hand > 0) {
					const u2 = upAxis(f2.axis);
					const bot2 = { x: f2.x - u2.x * G2, y: f2.y - u2.y * G2 };
					bot = lerpPt(bot1, bot2, hand);
					const ux = lerp(u1.x, u2.x, hand);
					const uy = lerp(u1.y, u2.y, hand);
					const l = Math.hypot(ux, uy) || 1;
					uu = { x: ux / l, y: uy / l };
				}
				lastU = uu;
				const ang = (Math.atan2(uu.y, uu.x) + Math.PI / 2) * (180 / Math.PI);
				baton.setAttribute('transform', `translate(${bot.x.toFixed(2)} ${bot.y.toFixed(2)}) rotate(${ang.toFixed(2)})`);
				void BAT;
			});
		}
	}
</script>
