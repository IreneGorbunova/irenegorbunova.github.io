---
/**
 * Two short looping opening scenes of «Относительность движения» (grade 9). No terms of the chapter in the pictures or
 * in the visible captions; each caption's popover names the notion and links to its section. Real time in both.
 *
 * Neighboring train (10 s): inside a compartment of a passenger car that stands at a station, the camera looks across
 *   the table at the window. Interior to scale, 1,2 px per см: a teenager (164 см) sits at the table, his far hand around a
 *   glass of tea in a holder, the near one resting on its edge on the table, fingers loosely bent. Through the window the last car of the neighboring train (25 м)
 *   is seen at 35 px per м (the window shows about 4 м of it). At 0,8 с it starts to the left with 0,3 м/с² and
 *   reaches 2,8 м/с by 10 с (12,7 м); its rear end enters the window at 6,5 с and leaves it at 8,6 с, opening the
 *   platform (lamp post with a clock, bench, station building), which never moves. Our car never moves either: the
 *   tea is level, the steam rises straight up, nothing in the compartment shifts. The boy leans back a little and looks
 *   up at the window while the neighbor slides past (the feeling that our car started), and settles when the platform
 *   shows.
 *
 * Relay (6 s): a 4 × 100 м handover on a school track, side view. The runners (teenagers, 165 см) and the track are
 *   drawn at one scale, 110 px per м, inside a camera that pans along the track and zooms (0,25 → 0,85 → 0,34) so that
 *   both runners stay in the frame; the camera does not change any motion. The first runner comes at 8 м/с with the
 *   baton. The second stands in the takeover zone and starts when the first passes the check mark 10 м behind her
 *   (t = 1 с), speeds up at 3,5 м/с² and reaches 8 м/с after 2,3 с and 9,1 м; the first is then 0,94 м behind her.
 *   For 1 s (3,3–4,3 с) both run at 8 м/с: the second reaches back with her left hand open (4 × 100: from his right hand into her left), the first pushes the baton
 *   (30 см) up into it, she closes her fingers (3,55–3,8 с), and only then he opens his (3,9–4,1 с). After that she
 *   speeds up at 1,2 м/с², he slows down at 3 м/с². Running: steps of 0,35 + 0,19·υ м (1,87 м at 8 м/с), ground
 *   contact 0,28 + 0,055·υ м of hip travel, the ankle planted for the first part of it, then the heel rises; arms pump
 *   opposite to the legs. The fence posts (every 2,5 м), boards, zone lines and the check mark move with the track.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// ---- scene 1: the compartment (1,2 px per см)
const WIN = { x: 120, y: 34, w: 146, h: 96 };
const rr = (x: number, y: number, w: number, h: number, r: number) =>
	`M${x + r} ${y}H${x + w - r}Q${x + w} ${y} ${x + w} ${y + r}V${y + h - r}Q${x + w} ${y + h} ${x + w - r} ${y + h}H${x + r}Q${x} ${y + h} ${x} ${y + h - r}V${y + r}Q${x} ${y} ${x + r} ${y}Z`;
const winD = rr(WIN.x, WIN.y, WIN.w, WIN.h, 12);
const wallD = `M0 0H360V240H0Z ${winD}`;
// the neighbor's last car at 35 px per м: rear end at x = 439 when it stands, 25 м long, drawn from its rear end
const KN = 35;
const REAR0 = 439;
const carLen = 25 * KN;
const nWins = Array.from({ length: 10 }, (_, i) => REAR0 - 78 - i * 76);
// the platform behind it (about 15 px per м) and the station (about 5 px per м)
const stWins = [130, 162, 194, 226, 258];

// ---- scene 2: the track, world px (110 px per м); y = 0 is the ground under the second runner
const KW = 110;
const X0 = -24 * KW;
const X1 = 40 * KW;
const posts = (() => {
	let d = '';
	for (let x = Math.ceil(X0 / 275) * 275; x < X1; x += 275) d += `M${x} -78 V-200 `;
	return d;
})();
const boards = (() => {
	const b: [number, number][] = [];
	for (let x = Math.ceil(X0 / 660) * 660, i = 0; x < X1; x += 660, i++) b.push([x, i % 3]);
	return b;
})();
const rows = Array.from({ length: 12 }, (_, i) => -230 - i * 42);
const zone = (x: number) => `M${x * KW + 12} -56 L${x * KW - 50} 190`;
const hurdleMarks = [3, 13, 21.5, 30, 38.5].map((x) => x * KW);
---

<PeopleStyles />
<IntroFrame data-otnintro>
	<div class="intro__card" data-scene="train">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Купе поезда, стоящего на вокзале. Мальчик сидит у столика со стаканом чая в подстаканнике. За окном стоит соседний поезд, потом он трогается и уходит влево, и кажется, что поехал наш вагон. Когда соседний поезд уходит, за окном видна неподвижная платформа с фонарём и часами">
			<!-- outside: sky, the station building, the platform (still) -->
			<rect class="ot-sky" x="0" y="0" width="360" height="140"></rect>
			<path class="ot-station" d="M96 112 V44 H284 V112 Z"></path>
			<path class="ot-roof" d="M90 46 L112 30 H268 L290 46 Z"></path>
			{stWins.map((x) => <path class="ot-st-win" d={`M${x} 98 V66 Q${x + 9} 56 ${x + 18} 66 V98 Z`} />)}
			<rect class="ot-platform" x="0" y="112" width="360" height="30"></rect>
			<path class="ot-edge-line" d="M0 120 H360"></path>
			<g class="ot-bench">
				<path d="M222 104 h30 v3 h-30 Z M222 99 h30 v2 h-30 Z"></path>
				<path class="ot-bench-leg" d="M225 107 v6 M249 107 v6"></path>
			</g>
			<rect class="ot-lamp-post" x="176" y="10" width="4" height="104"></rect>
			<path class="ot-lamp-post" d="M178 12 Q190 8 196 16 L192 18 Q188 13 178 15 Z"></path>
			<path class="ot-lamp-head" d="M188 17 h10 l-2 5 h-6 Z"></path>
			<path class="ot-lamp-post" d="M178 44 h-8"></path>
			<circle class="ot-clock" cx="164" cy="44" r="8"></circle>
			<path class="ot-clock-hands" d="M164 44 L164 38.5 M164 44 L168 46"></path>
			<!-- the neighboring train's last car, moved by the script -->
			<g data-neighbor>
				<rect class="ot-n-body" x={REAR0 - carLen} y="14" width={carLen} height="130" rx="4"></rect>
				<path class="ot-n-roof" d={`M${REAR0 - carLen} 14 H${REAR0} V22 H${REAR0 - carLen} Z`}></path>
				<rect class="ot-n-stripe" x={REAR0 - carLen} y="96" width={carLen} height="5"></rect>
				<rect class="ot-n-skirt" x={REAR0 - carLen} y="118" width={carLen} height="26"></rect>
				{nWins.map((x) => (
					<g>
						<rect class="ot-n-win" x={x - 22} y="48" width="44" height="36" rx="4"></rect>
						<path class="ot-n-curtain" d={`M${x - 20} 50 Q${x - 12} 66 ${x - 18} 82 H${x - 21} V50 Z M${x + 20} 50 Q${x + 12} 66 ${x + 18} 82 H${x + 21} V50 Z`}></path>
						<path class="ot-n-sheen" d={`M${x - 8} 82 L${x + 6} 50`}></path>
					</g>
				))}
				<path class="ot-n-door" d={`M${REAR0 - 36} 30 V118 M${REAR0 - 10} 30 V118 M${REAR0 - 36} 30 H${REAR0 - 10}`}></path>
				<rect class="ot-n-win" x={REAR0 - 31} y="44" width="16" height="30" rx="3"></rect>
				<path class="ot-n-bellows" d={`M${REAR0} 30 h8 v100 h-8 Z`}></path>
				<path class="ot-n-fold" d={`M${REAR0 + 2} 34 V126 M${REAR0 + 5} 34 V126`}></path>
				<circle class="ot-n-tail" cx={REAR0 - 4} cy="112" r="3.2"></circle>
				<circle class="ot-n-tail" cx={REAR0 - 4} cy="40" r="2.4"></circle>
			</g>
			<!-- the compartment: wall with the window, curtains, shelf, lamp -->
			<path class="ot-wall" fill-rule="evenodd" d={wallD}></path>
			<path class="ot-glass" d={winD}></path>
			<path class="ot-sheen" d={`M${WIN.x + 20} ${WIN.y + WIN.h} L${WIN.x + 70} ${WIN.y} M${WIN.x + 34} ${WIN.y + WIN.h} L${WIN.x + 80} ${WIN.y + 8}`}></path>
			<path class="ot-frame" fill="none" d={winD}></path>
			<path class="ot-frame-bar" d={`M${WIN.x + 2} ${WIN.y + 30} H${WIN.x + WIN.w - 2}`}></path>
			<path class="ot-curtain" d={`M${WIN.x - 14} 26 H${WIN.x + 10} Q${WIN.x + 2} 60 ${WIN.x + 8} 82 Q${WIN.x + 14} 108 ${WIN.x + 6} 134 H${WIN.x - 10} Q${WIN.x - 4} 100 ${WIN.x - 2} 82 Q${WIN.x - 16} 56 ${WIN.x - 14} 26 Z`}></path>
			<path class="ot-curtain" d={`M${WIN.x + WIN.w + 14} 26 H${WIN.x + WIN.w - 10} Q${WIN.x + WIN.w - 2} 60 ${WIN.x + WIN.w - 8} 82 Q${WIN.x + WIN.w - 14} 108 ${WIN.x + WIN.w - 6} 134 H${WIN.x + WIN.w + 10} Q${WIN.x + WIN.w + 4} 100 ${WIN.x + WIN.w + 2} 82 Q${WIN.x + WIN.w + 16} 56 ${WIN.x + WIN.w + 14} 26 Z`}></path>
			<path class="ot-fold" d={`M${WIN.x - 6} 30 Q${WIN.x - 2} 70 ${WIN.x} 130 M${WIN.x + WIN.w + 6} 30 Q${WIN.x + WIN.w + 2} 70 ${WIN.x + WIN.w} 130`}></path>
			<path class="ot-rod" d={`M${WIN.x - 20} 25 H${WIN.x + WIN.w + 20}`}></path>
			<path class="ot-shelf" d="M60 8 H340 V12 H60 Z"></path>
			<path class="ot-bag" d="M250 8 Q250 -6 270 -6 H300 Q318 -6 318 8 Z"></path>
			<path class="ot-lampw" d="M300 58 h18 v8 h-18 Z"></path>
			<path class="ot-lampw-light" d="M302 66 h14 l4 6 h-22 Z"></path>
			<!-- the berths -->
			<path class="ot-seat-back" d="M0 70 H16 Q22 70 22 78 V182 H0 Z"></path>
			<rect class="ot-seat" x="0" y="182" width="112" height="14" rx="5"></rect>
			<path class="ot-seat-base" d="M4 196 H108 V236 H4 Z"></path>
			<path class="ot-seat-back" d="M360 70 H346 Q340 70 340 78 V182 H360 Z"></path>
			<rect class="ot-seat" x="282" y="182" width="80" height="14" rx="5"></rect>
			<path class="ot-seat-base" d="M286 196 H360 V236 H286 Z"></path>
			<path class="ot-backpack" d="M300 182 Q298 148 316 144 Q334 148 332 182 Z M306 160 h20 v14 h-20 Z"></path>
			<rect class="ot-floor" x="0" y="236" width="360" height="4"></rect>
			<!-- the table, the glass in its holder, the boy -->
			<path class="ot-table-top" d="M128 140 H270 L274 146 H124 Z"></path>
			<rect class="ot-table-edge" x="124" y="146" width="150" height="5"></rect>
			<path class="ot-table-leg" d="M196 151 L190 236 M184 236 H198"></path>
			<path class="ot-napkin" d="M140 141 H170 L172 144 H138 Z"></path>
			<path class="ot-sugar" d="M218 140.5 h12 l1 3 h-14 Z"></path>
			<g data-glass-back></g>
			<g class="ot-tea-glass">
				<path class="ot-glass-cup" d="M150.5 128 L159.5 128 L159 144 L151 144 Z"></path>
				<path class="ot-tea" d="M150.8 131.5 L159.2 131.5 L159 144 L151 144 Z"></path>
				<path class="ot-tea-top" d="M150.8 131.5 H159.2"></path>
				<path class="ot-lemon" d="M152.5 133.5 a2.6 2.6 0 0 1 5 0 Z"></path>
				<path class="ot-spoon" d="M157.5 135 L162.5 123.5"></path>
				<path class="ot-holder" d="M150 135 H160 L160.6 144.8 H149.4 Z"></path>
				<path class="ot-holder-pattern" d="M151 138 h8 M151 141 h8"></path>
				<path class="ot-holder-handle" d="M150 136.5 Q144.8 136.5 145 140 Q145.2 143.4 150 143.2"></path>
			</g>
			<path class="ot-steam" data-steam="0"></path>
			<path class="ot-steam" data-steam="1"></path>
			<g data-boy></g>
		</svg>
		<div class="intro__foot">
			<p>
				Соседний поезд тронулся, а{' '}
				<More term="кажется, что поехал наш">
					О движении мы судим по телам, которые видим. Пока в окне виден только соседний поезд, глаз принимает его за неподвижное тело — и кажется, что движется наш вагон. Чай в стакане при этом не колышется: наш вагон стоит. Об этом — в разделе{' '}
					<a href="#относительность-движения">«Относительность движения»</a>.
				</More>. Только когда он уходит и открывается платформа, становится ясно, что мы стоим.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="relay">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Эстафета на школьном стадионе. Второй бегун заранее начинает разбег, первый догоняет его, и несколько шагов они бегут рядом: первый вкладывает эстафетную палочку в раскрытую ладонь второго. Потом второй убегает вперёд, а первый замедляется">
			<rect class="ot-sky2" x="0" y="0" width="360" height="240"></rect>
			<g data-world>
				<!-- stands, fence with boards, grass, the track with lanes and zone lines -->
				<rect class="ot-stand" x={X0} y="-760" width={X1 - X0} height="560"></rect>
				{rows.map((y) => <path class="ot-seats" d={`M${X0} ${y} H${X1}`} />)}
				{rows.map((y) => <path class="ot-step" d={`M${X0} ${y + 14} H${X1}`} />)}
				<rect class="ot-grass2" x={X0} y="-200" width={X1 - X0} height="140"></rect>
				{boards.map(([x, k]) => <rect class={`ot-board ot-board-${k}`} x={x + 20} y="-178" width="600" height="96" rx="6" />)}
				{boards.map(([x, k]) => <path class="ot-board-ink" d={`M${x + 70} -130 h${180 + 60 * k} M${x + 70} -110 h${120 + 40 * k}`} />)}
				<path class="ot-fence" d={posts}></path>
				<path class="ot-fence-rail" d={`M${X0} -200 H${X1} M${X0} -80 H${X1}`}></path>
				<rect class="ot-track" x={X0} y="-62" width={X1 - X0} height="500"></rect>
				<path class="ot-lane" d={`M${X0} -60 H${X1} M${X0} -40 H${X1} M${X0} -22 H${X1} M${X0} 14 H${X1} M${X0} 64 H${X1} M${X0} 130 H${X1}`}></path>
				<path class="ot-zone" d={`${zone(-1)} ${zone(29)}`}></path>
				<path class="ot-zone-tri" d={`M${-1 * KW - 8} 20 l12 0 l-6 10 Z M${29 * KW - 8} 20 l12 0 l-6 10 Z`}></path>
				{hurdleMarks.map((x, i) => <rect class={i % 2 ? 'ot-hmark-b' : 'ot-hmark-a'} x={x} y="16" width="14" height="5" />)}
				<rect class="ot-check" x={-10 * KW - 11} y="-14" width="22" height="5"></rect>
				<g data-runner1-back></g>
				<g data-runner2-back></g>
				<path class="ot-baton" data-baton d="M-2.2 0 H2.2 V-33 H-2.2 Z"></path>
				<g data-runner1></g>
				<g data-runner2></g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Эстафетную палочку передают на бегу. Второй бегун разгоняется заранее, чтобы в момент передачи{' '}
				<More term="бежать рядом с первым">
					В момент передачи бегуны почти не движутся друг относительно друга: рука встречает палочку, которая относительно неё почти покоится, хотя оба бегут по дорожке со скоростью около 8&nbsp;м/с. Об этом — в разделе{' '}
					<a href="#скорость-одного-тела-относительно-другого">«Скорость одного тела относительно другого»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-otnintro] {
		--ot-sky: hsl(208, 40%, 34%);
		--ot-station: hsl(32, 22%, 40%);
		--ot-roof: hsl(10, 25%, 30%);
		--ot-platform: hsl(220, 6%, 38%);
		--ot-n-body: hsl(152, 34%, 26%);
		--ot-n-skirt: hsl(152, 30%, 18%);
		--ot-wall: hsl(28, 30%, 34%);
		--ot-wall-light: hsl(28, 32%, 42%);
		--ot-curtain: hsl(4, 45%, 42%);
		--ot-seat: hsl(208, 30%, 32%);
		--ot-table: hsl(30, 35%, 46%);
		--ot-metal: hsl(40, 12%, 70%);
		--ot-tea: hsl(28, 75%, 36%);
		--ot-glass2: hsl(195, 40%, 62%);
		--ot-sky2: hsl(206, 45%, 30%);
		--ot-stand: hsl(220, 12%, 26%);
		--ot-seat-row: hsl(205, 55%, 45%);
		--ot-grass: hsl(110, 30%, 30%);
		--ot-trackc: hsl(8, 42%, 38%);
		--ot-mark: hsl(0, 0%, 92%);
	}
	:root[data-theme='light'] [data-otnintro] {
		--ot-sky: hsl(205, 60%, 78%);
		--ot-station: hsl(32, 30%, 70%);
		--ot-roof: hsl(10, 35%, 50%);
		--ot-platform: hsl(220, 6%, 64%);
		--ot-n-body: hsl(152, 36%, 34%);
		--ot-n-skirt: hsl(152, 32%, 24%);
		--ot-wall: hsl(30, 36%, 62%);
		--ot-wall-light: hsl(30, 40%, 70%);
		--ot-curtain: hsl(4, 55%, 55%);
		--ot-seat: hsl(208, 34%, 44%);
		--ot-table: hsl(30, 40%, 56%);
		--ot-metal: hsl(40, 14%, 76%);
		--ot-tea: hsl(28, 80%, 42%);
		--ot-glass2: hsl(195, 45%, 70%);
		--ot-sky2: hsl(203, 70%, 80%);
		--ot-stand: hsl(220, 10%, 62%);
		--ot-seat-row: hsl(205, 60%, 52%);
		--ot-grass: hsl(110, 38%, 48%);
		--ot-trackc: hsl(8, 52%, 50%);
		--ot-mark: hsl(0, 0%, 99%);
	}
	[data-otnintro] .ot-sky {
		fill: var(--ot-sky);
	}
	[data-otnintro] .ot-station {
		fill: var(--ot-station);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-otnintro] .ot-roof {
		fill: var(--ot-roof);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-otnintro] .ot-st-win {
		fill: hsl(44, 70%, 66%);
		opacity: 0.75;
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-otnintro] .ot-platform {
		fill: var(--ot-platform);
	}
	[data-otnintro] .ot-edge-line {
		stroke: hsl(50, 90%, 55%);
		stroke-width: 2;
	}
	[data-otnintro] .ot-bench path:first-child {
		fill: var(--ot-table);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-otnintro] .ot-bench-leg {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 1.2;
	}
	[data-otnintro] .ot-lamp-post {
		fill: hsl(220, 10%, 22%);
		stroke: hsl(220, 10%, 22%);
		stroke-width: 1.4;
	}
	[data-otnintro] .ot-lamp-head {
		fill: hsl(48, 90%, 75%);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-otnintro] .ot-clock {
		fill: hsl(0, 0%, 97%);
		stroke: hsl(220, 10%, 22%);
		stroke-width: 1.6;
	}
	[data-otnintro] .ot-clock-hands {
		fill: none;
		stroke: hsl(220, 10%, 15%);
		stroke-width: 1;
		stroke-linecap: round;
	}
	[data-otnintro] .ot-n-body {
		fill: var(--ot-n-body);
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	[data-otnintro] .ot-n-roof {
		fill: hsl(220, 6%, 55%);
	}
	[data-otnintro] .ot-n-stripe {
		fill: hsl(48, 85%, 55%);
	}
	[data-otnintro] .ot-n-skirt {
		fill: var(--ot-n-skirt);
	}
	[data-otnintro] .ot-n-win {
		fill: hsl(200, 25%, 18%);
		stroke: hsl(220, 10%, 70%);
		stroke-width: 1.2;
	}
	[data-otnintro] .ot-n-curtain {
		fill: hsl(0, 0%, 94%);
		opacity: 0.9;
	}
	[data-otnintro] .ot-n-sheen {
		stroke: hsl(0, 0%, 100%);
		stroke-width: 4;
		opacity: 0.12;
	}
	[data-otnintro] .ot-n-door {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.9;
	}
	[data-otnintro] .ot-n-bellows {
		fill: hsl(220, 8%, 16%);
	}
	[data-otnintro] .ot-n-fold {
		stroke: hsl(220, 8%, 34%);
		stroke-width: 0.8;
	}
	[data-otnintro] .ot-n-tail {
		fill: hsl(0, 85%, 52%);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-otnintro] .ot-wall {
		fill: var(--ot-wall);
	}
	[data-otnintro] .ot-glass {
		fill: color-mix(in oklab, var(--ot-glass2) 12%, transparent);
	}
	[data-otnintro] .ot-sheen {
		stroke: hsl(0, 0%, 100%);
		stroke-width: 6;
		opacity: 0.07;
	}
	[data-otnintro] .ot-frame {
