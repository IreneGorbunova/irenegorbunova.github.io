---
/**
 * «Лодка и плот» (top view): a straight river flows to the right at υ₂ = 1 м/с (axis Ox along the current, x = 0 at
 * the pier). At t = 0 a raft (it marks the water) and a motorboat leave the pier; the boat goes at υ₁ = 5 м/с
 * relative to the water, downstream or upstream (two buttons). In 20 с: the raft moves s₂ₓ = 20 м (green), the boat
 * relative to the raft s₁ₓ = +100 м or −100 м (blue, drawn tip to tail after s₂, a little lower so that the two never cover each other), the boat relative to the
 * shore sₓ = s₁ₓ + s₂ₓ = 120 м or −80 м (red, the line below). The ripples move with the water.
 * Scale: 1,5 px per м along the river; the boat (6 м) and the raft (4 м) are drawn 3 times larger. The clock runs
 * 4 times faster than a real one: 20 с take 5 s on the screen, then the end holds 2,5 s and the run repeats.
 */
import G7Styles from '../g7/G7Styles.astro';

const X0 = 150; // the pier, px
const K = 1.5;
const ticks = [-80, -40, 0, 40, 80, 120];
---

<G7Styles />

<figure class="g7 g7--pic rvp not-content" data-rvp>
	<div class="rvp__bar g7__seg" role="group" aria-label="Куда плывёт лодка" data-dir>
		<button type="button" class="g7__btn" aria-pressed="true" data-d="1">Вниз по течению</button>
		<button type="button" class="g7__btn" aria-pressed="false" data-d="-1">Вверх по течению</button>
	</div>
	<svg class="g7__svg" viewBox="0 0 360 214" role="img" aria-label="Река течёт вправо. От пристани отплывают плот и моторная лодка. Под рекой стрелками показаны перемещения плота, лодки относительно плота и лодки относительно берега">
		<defs>
			{['green', 'blue', 'red'].map((c) => (
				<marker id={`rvp-${c}`} class={`rvp__head rvp__head--${c}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="3" markerHeight="3" orient="auto-start-reverse">
					<path d="M0,0 L10,5 L0,10 z"></path>
				</marker>
			))}
		</defs>
		<rect class="rvp__grass" x="0" y="0" width="360" height="140"></rect>
		{[20, 70, 120, 190, 240, 300, 340].map((x, i) => <circle class="rvp__bush" cx={x} cy={16 + (i % 2) * 6} r={8 + (i % 3) * 2}></circle>)}
		<rect class="rvp__water" x="0" y="34" width="360" height="82"></rect>
		<path class="rvp__ripple" data-ripples></path>
		<path class="rvp__bank" d="M0 34 H360 M0 116 H360"></path>
		<!-- the pier on the lower bank -->
		<path class="rvp__pier" d={`M${X0 - 8} 116 V96 H${X0 + 8} V116 Z`}></path>
		<path class="rvp__plank" d={`M${X0 - 8} 100 H${X0 + 8} M${X0 - 8} 104 H${X0 + 8} M${X0 - 8} 108 H${X0 + 8} M${X0 - 8} 112 H${X0 + 8}`}></path>
		<g data-raft>
			<rect class="rvp__raft" x="-9" y="-6" width="18" height="12" rx="1.5"></rect>
			<path class="rvp__plank" d="M-9 -2 H9 M-9 2 H9"></path>
		</g>
		<g data-boat>
			<path class="rvp__boat" d="M-13 -5 H6 Q14 -5 15 0 Q14 5 6 5 H-13 Z"></path>
			<rect class="rvp__seat" x="-9" y="-3" width="4" height="6" rx="1"></rect>
			<rect class="rvp__motor" x="-16" y="-2" width="3.5" height="4"></rect>
		</g>
		<text class="t-small rvp__t" x={X0 - 12} y="131" text-anchor="end">пристань</text>
		<!-- the axis and the displacements -->
		<path class="rvp__axis" d="M10 196 H350"></path>
		<path class="rvp__axis-head" d="M350 192 L358 196 L350 200 Z"></path>
		<text class="t-i rvp__t" x="350" y="188">x</text>
		{ticks.map((x) => (
			<g>
				<path class="rvp__axis" d={`M${X0 + x * K} 193 V199`}></path>
				<text class="t-small rvp__t" x={X0 + x * K} y="211" text-anchor="middle">{x < 0 ? `−${-x}` : x}&nbsp;м</text>
			</g>
		))}
		<line class="rvp__arrow rvp__arrow--green" data-s2 y1="144" y2="144" marker-end="url(#rvp-green)"></line>
		<line class="rvp__arrow rvp__arrow--blue" data-s1 y1="156" y2="156" marker-end="url(#rvp-blue)"></line>
		<line class="rvp__arrow rvp__arrow--red" data-s y1="182" y2="182" marker-end="url(#rvp-red)"></line>
		<text class="t-i t-green rvp__lab" data-ls2>s<tspan baseline-shift="sub" font-size="8">2</tspan></text>
		<text class="t-i t-blue rvp__lab" data-ls1>s<tspan baseline-shift="sub" font-size="8">1</tspan></text>
		<text class="t-i t-red rvp__lab" data-ls>s</text>
		<path class="rvp__drop" d={`M${X0} 116 V200`}></path>
	</svg>
	<ul class="g7__read rvp__read" aria-live="polite">
		<li><span>время</span><b data-t></b></li>
		<li><span>плот: <i>s</i><sub>2<i>x</i></sub></span><b data-r2></b></li>
		<li><span>лодка относительно плота: <i>s</i><sub>1<i>x</i></sub></span><b data-r1></b></li>
		<li class="is-key"><span>лодка относительно берега: <i>s</i><sub><i>x</i></sub></span><b data-r></b></li>
	</ul>
	<figcaption class="g7__caption">
		Вид сверху. Река течёт вправо со скоростью 1&nbsp;м/с, лодка плывёт относительно воды со скоростью 5&nbsp;м/с. Время в модели идёт в 4 раза быстрее; лодка и плот нарисованы крупнее.
	</figcaption>
</figure>

<style is:global>
	.rvp__bar {
		margin-bottom: 0.6rem;
	}
	.rvp__read {
		margin-top: 0.6rem;
	}
	.rvp__grass {
		fill: color-mix(in oklab, var(--g7-green) 24%, var(--sl-color-bg));
	}
	.rvp__bush {
		fill: color-mix(in oklab, var(--g7-green) 55%, var(--sl-color-gray-5));
	}
	.rvp__water {
		fill: var(--g7-water);
	}
	.rvp__ripple {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 0.9;
		stroke-linecap: round;
		opacity: 0.6;
	}
	.rvp__bank {
		stroke: var(--g7-wood-dark);
		stroke-width: 2;
	}
	.rvp__pier,
	.rvp__raft {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.rvp__plank {
		stroke: var(--g7-wood-dark);
		stroke-width: 0.6;
	}
	.rvp__boat {
		fill: var(--sl-color-gray-1);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.rvp__seat,
	.rvp__motor {
		fill: var(--g7-line);
	}
	.rvp__axis {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.rvp__axis-head,
	.rvp__t {
		fill: var(--g7-ink);
	}
	.rvp__drop {
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-dasharray: 2 3;
	}
	.rvp__arrow {
		stroke-width: 3;
		stroke-linecap: round;
	}
	.rvp__arrow--green {
		stroke: var(--g7-green);
	}
	.rvp__arrow--blue {
		stroke: var(--g7-blue);
	}
	.rvp__arrow--red {
		stroke: var(--g7-red);
	}
	.rvp__head--green path {
		fill: var(--g7-green);
	}
	.rvp__head--blue path {
		fill: var(--g7-blue);
	}
	.rvp__head--red path {
		fill: var(--g7-red);
	}
	.rvp__lab {
		font-size: 12px;
	}
</style>

<script>
	import { fmtTrim, loop, segment } from '../g7/kit';

	const X0 = 150;
	const K = 1.5;
	const V1 = 5;
	const V2 = 1;
	const T = 20; // с of the experiment
	const FAST = 4;
	const HOLD = 2.5; // s on the screen
	const fmtS = (v: number) => `${v > 0 ? '+' : ''}${fmtTrim(v, 0)}\u00a0м`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-rvp]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const raft = $<SVGGElement>('[data-raft]');
		const boat = $<SVGGElement>('[data-boat]');
		const ripples = $<SVGPathElement>('[data-ripples]');
		const a2 = $<SVGLineElement>('[data-s2]');
		const a1 = $<SVGLineElement>('[data-s1]');
		const as = $<SVGLineElement>('[data-s]');
		let dir = 1;
		let clock = 0; // s on the screen
		const arrow = (el: SVGLineElement, x1: number, x2: number) => {
			const show = Math.abs(x2 - x1) > 3;
			el.setAttribute('visibility', show ? 'visible' : 'hidden');
			el.setAttribute('x1', x1.toFixed(1));
			el.setAttribute('x2', (x2 - Math.sign(x2 - x1) * 4).toFixed(1));
		};
		const label = (sel: string, x: number, y: number, show: boolean) => {
			const e = $<SVGTextElement>(sel);
			e.setAttribute('x', x.toFixed(1));
			e.setAttribute('y', String(y));
			e.setAttribute('visibility', show ? 'visible' : 'hidden');
		};
		const draw = () => {
			const t = Math.min(T, clock * FAST);
			const s2 = V2 * t;
			const s1 = dir * V1 * t;
			const s = s1 + s2;
			raft.setAttribute('transform', `translate(${(X0 + s2 * K).toFixed(1)} 58)`);
			boat.setAttribute('transform', `translate(${(X0 + s * K).toFixed(1)} 88)${dir < 0 ? ' scale(-1 1)' : ''}`);
			// ripples drift with the water: 1 м/с
			let d = '';
			const off = (clock * FAST * V2 * K) % 24;
			for (let row = 0; row < 4; row++)
				for (let x = -24 + off + (row % 2) * 12; x < 370; x += 24) {
					const y = 44 + row * 20;
					d += `M${x.toFixed(1)} ${y} q3 -2 6 0 q3 2 6 0`;
				}
			ripples.setAttribute('d', d);
			arrow(a2, X0, X0 + s2 * K);
			arrow(a1, X0 + s2 * K, X0 + s * K);
			arrow(as, X0, X0 + s * K);
			label('[data-ls2]', X0 + s2 * K + 3, 148, s2 * K > 8);
			label('[data-ls1]', X0 + (s2 + s1 / 2) * K - 4, 151, Math.abs(s1) * K > 8);
			label('[data-ls]', X0 + (s * K) / 2 - 3, 177, Math.abs(s) * K > 8);
			$('[data-t]').textContent = `${fmtTrim(t, 0)}\u00a0с`;
			$('[data-r2]').textContent = fmtS(s2);
			$('[data-r1]').textContent = fmtS(s1);
			$('[data-r]').textContent = fmtS(s);
		};
		loop(root, (dt) => {
			clock += dt;
			if (clock > T / FAST + HOLD) clock = 0;
			draw();
			return true;
		});
		segment($('[data-dir]'), (b) => {
			dir = +b.dataset.d!;
			clock = 0;
			draw();
		});
		draw();
	}
</script>
