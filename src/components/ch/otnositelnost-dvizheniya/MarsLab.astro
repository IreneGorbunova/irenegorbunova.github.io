---
/**
 * «Петли Марса»: the Earth and Mars on circular orbits in one plane around the Sun: the Earth 1 а. е., 365,25 сут;
 * Mars 1,524 а. е., 687 сут (both counterclockwise). Two views: «Солнце в центре» (the Sun at rest, both planets go
 * round on circles) and «Земля в центре» (the Earth at rest in the middle: the Sun goes round it once a year at 1 а. е.,
 * Mars moves along r_M − r_E and draws loops). Mars leaves a gold trace, the Earth (or the Sun in the second view) a
 * faint one; switching the view redraws the whole trace in the new frame from the stored times. A dashed line of
 * sight from the Earth through Mars to the stars shows Mars stop and go back among them.
 * Numbers (checked numerically for these circular orbits): oppositions every 1/(1/365,25 − 1/687) = 780 сут; Mars
 * moves backward among the stars for 73 сут around each opposition, the loop spans 16°; the nearest distance is
 * 0,524 а. е. = 78 млн км. Start: day 0, the first opposition on day 150 (backward motion from day 114 to day 186).
 * Scale: 60 px per а. е. in both views; the Sun and the planets are drawn far larger than to scale. Clock: one year in
 * about 6 s (61 сут per second).
 */
import G7Styles from '../g7/G7Styles.astro';

const R = (s: number) => () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
const rnd = R(7);
const stars = Array.from({ length: 70 }, () => [rnd() * 360, rnd() * 320, 0.4 + rnd() * 0.8] as const);
---

<G7Styles />
<figure class="g7 g7--stack mrs not-content" data-mrs>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 320" role="img" aria-label="Орбиты Земли и Марса вокруг Солнца. Можно смотреть из системы отсчёта, связанной с Солнцем или с Землёй; Марс оставляет след" data-svg>
			<rect class="mrs__space" x="0" y="0" width="360" height="320"></rect>
			{stars.map(([x, y, r]) => <circle class="mrs__star" cx={x.toFixed(1)} cy={y.toFixed(1)} r={r.toFixed(2)}></circle>)}
			<path class="mrs__orbit" data-orbits></path>
			<path class="mrs__faint" data-ftrace></path>
			<path class="mrs__trace" data-mtrace></path>
			<line class="mrs__sight" data-sight></line>
			<circle class="mrs__sun" r="9" data-sun></circle>
			<circle class="mrs__earth" r="5" data-earth></circle>
			<circle class="mrs__mars" r="4" data-mars></circle>
			<text class="t-small mrs__t" data-tsun>Солнце</text>
			<text class="t-small mrs__t" data-tearth>Земля</text>
			<text class="t-small mrs__t mrs__t--mars" data-tmars>Марс</text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Что в центре" data-view>
				<button type="button" class="g7__btn" aria-pressed="true" data-v="sun">Солнце в центре</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-v="earth">Земля в центре</button>
			</div>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-run>Пауза</button>
				<button type="button" class="g7__btn" data-erase>Стереть след</button>
				<button type="button" class="g7__btn" data-reset>Сначала</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Прошло</span><b data-day></b></li>
				<li class="is-key"><span>Марс среди звёзд</span><b data-dir></b></li>
				<li><span>Расстояние от Земли до Марса</span><b data-dist></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Орбиты считаем окружностями. Один год проходит примерно за 6 секунд; Солнце и планеты нарисованы намного крупнее, чем в масштабе.
	</figcaption>
</figure>

<style is:global>
	.mrs__space {
		fill: color-mix(in oklab, var(--sl-color-black) 70%, var(--ig-vx) 8%);
	}
	:root[data-theme='light'] .mrs__space {
		fill: hsl(228, 40%, 16%);
	}
	.mrs__star {
		fill: hsl(0, 0%, 92%);
		opacity: 0.7;
	}
	.mrs__orbit {
		fill: none;
		stroke: hsl(220, 15%, 60%);
		stroke-width: 0.7;
		stroke-dasharray: 2 3;
	}
	.mrs__trace {
		fill: none;
		stroke: hsl(42, 90%, 62%);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.mrs__faint {
		fill: none;
		stroke: hsl(205, 70%, 70%);
		stroke-width: 1;
		opacity: 0.45;
	}
	.mrs__sight {
		stroke: hsl(0, 0%, 85%);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
		opacity: 0.7;
	}
	.mrs__sun {
		fill: hsl(45, 95%, 60%);
		stroke: hsl(35, 90%, 50%);
		stroke-width: 1.5;
	}
	.mrs__earth {
		fill: hsl(205, 75%, 55%);
		stroke: hsl(140, 50%, 45%);
		stroke-width: 1.4;
	}
	.mrs__mars {
		fill: hsl(12, 75%, 52%);
	}
	.mrs__t {
		fill: hsl(0, 0%, 92%);
		stroke: hsl(228, 40%, 12%);
		stroke-width: 3px;
		paint-order: stroke;
	}
	.mrs__t--mars {
		fill: hsl(20, 85%, 70%);
	}
</style>

<script>
	import { fmtInt, loop, segment } from '../g7/kit';

	const TE = 365.25;
	const TM = 687;
	const AM = 1.524;
	const PX = 60; // px per а. е.
	const DAYS_PER_S = TE / 6;
	const PH = 2 * Math.PI * 150 * (1 / TE - 1 / TM); // opposition on day 150
	const AU_KM = 149.6; // млн км
	const C = { x: 180, y: 160 };
	const earth = (t: number) => ({ x: Math.cos((2 * Math.PI * t) / TE), y: Math.sin((2 * Math.PI * t) / TE) });
	const mars = (t: number) => ({ x: AM * Math.cos((2 * Math.PI * t) / TM + PH), y: AM * Math.sin((2 * Math.PI * t) / TM + PH) });

	for (const root of document.querySelectorAll<HTMLElement>('[data-mrs]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const sun = $<SVGCircleElement>('[data-sun]');
		const ea = $<SVGCircleElement>('[data-earth]');
		const ma = $<SVGCircleElement>('[data-mars]');
		const mtrace = $<SVGPathElement>('[data-mtrace]');
		const ftrace = $<SVGPathElement>('[data-ftrace]');
		const orbits = $<SVGPathElement>('[data-orbits]');
		const sight = $<SVGLineElement>('[data-sight]');
		const runBtn = $<HTMLButtonElement>('[data-run]');
		let view: 'sun' | 'earth' = 'sun';
		let t = 0; // сут
		let t0 = 0; // the trace starts here
		let running = true;
		// a point (in а. е., the Sun at the origin) on the screen in the current view; y up on the screen
		const scr = (p: { x: number; y: number }, tt: number) => {
			const o = view === 'sun' ? { x: 0, y: 0 } : earth(tt);
			return { x: C.x + (p.x - o.x) * PX, y: C.y - (p.y - o.y) * PX };
		};
		// a label beside its body, pushed away from the middle of the picture (where the traces are), on a halo
		const put = (c: SVGCircleElement, p: { x: number; y: number }, label: SVGTextElement, dx: number) => {
			c.setAttribute('cx', p.x.toFixed(1));
			c.setAttribute('cy', p.y.toFixed(1));
			const ox = p.x - C.x;
			const oy = p.y - C.y;
			const l = Math.hypot(ox, oy);
			if (l < 20) {
				label.setAttribute('x', (p.x + dx).toFixed(1));
				label.setAttribute('y', (p.y - 7).toFixed(1));
				label.setAttribute('text-anchor', 'start');
				return;
			}
			const r = dx + 10;
			label.setAttribute('x', (p.x + (ox / l) * r).toFixed(1));
			label.setAttribute('y', (p.y + (oy / l) * r + 3).toFixed(1));
			label.setAttribute('text-anchor', ox > 8 ? 'start' : ox < -8 ? 'end' : 'middle');
		};
		const draw = () => {
			const S = scr({ x: 0, y: 0 }, t);
			const E = scr(earth(t), t);
			const M = scr(mars(t), t);
			put(sun, S, $('[data-tsun]'), 10);
			put(ea, E, $('[data-tearth]'), 7);
			put(ma, M, $('[data-tmars]'), 6);
			orbits.setAttribute(
				'd',
				view === 'sun'
					? `M${C.x + PX} ${C.y} a${PX} ${PX} 0 1 0 ${-2 * PX} 0 a${PX} ${PX} 0 1 0 ${2 * PX} 0 M${C.x + AM * PX} ${C.y} a${AM * PX} ${AM * PX} 0 1 0 ${-2 * AM * PX} 0 a${AM * PX} ${AM * PX} 0 1 0 ${2 * AM * PX} 0`
					: '',
			);
			// traces from t0 to t, one point per day
			const from = Math.max(t0, t - 1600);
			let dm = '';
			let df = '';
			for (let s = from; s <= t; s += Math.max(1, (t - from) / 1200)) {
				const m = scr(mars(s), s);
				const f = view === 'sun' ? scr(earth(s), s) : scr({ x: 0, y: 0 }, s);
				dm += `${dm ? 'L' : 'M'}${m.x.toFixed(1)} ${m.y.toFixed(1)}`;
				df += `${df ? 'L' : 'M'}${f.x.toFixed(1)} ${f.y.toFixed(1)}`;
			}
			dm += `L${M.x.toFixed(1)} ${M.y.toFixed(1)}`;
			mtrace.setAttribute('d', dm);
			ftrace.setAttribute('d', df);
			// the line of sight Earth → Mars, to the edge of the picture
			const dx = M.x - E.x;
			const dy = M.y - E.y;
			const l = Math.hypot(dx, dy) || 1;
			sight.setAttribute('x1', E.x.toFixed(1));
			sight.setAttribute('y1', E.y.toFixed(1));
			sight.setAttribute('x2', (E.x + (dx / l) * 500).toFixed(1));
			sight.setAttribute('y2', (E.y + (dy / l) * 500).toFixed(1));
			// readouts: the direction of Mars among the stars changes forward (counterclockwise) or backward
			const ang = (s: number) => {
				const e = earth(s);
				const m = mars(s);
				return Math.atan2(m.y - e.y, m.x - e.x);
			};
			let w = ang(t + 0.5) - ang(t - 0.5);
			w = Math.atan2(Math.sin(w), Math.cos(w));
			$('[data-day]').textContent = `${fmtInt(t)}\u00a0сут`;
			$('[data-dir]').textContent = Math.abs(w) < 2e-4 ? 'почти стоит' : w > 0 ? 'движется вперёд' : 'движется назад';
			const e = earth(t);
			const m = mars(t);
			$('[data-dist]').textContent = `${fmtInt(Math.hypot(m.x - e.x, m.y - e.y) * AU_KM)}\u00a0млн\u00a0км`;
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			t += dt * DAYS_PER_S;
			draw();
			return true;
		});
		segment($('[data-view]'), (b) => {
			view = b.dataset.v as 'sun' | 'earth';
			draw();
		});
		runBtn.addEventListener('click', () => {
			running = !running;
			runBtn.textContent = running ? 'Пауза' : 'Пуск';
			if (running) wake();
		});
		$('[data-erase]').addEventListener('click', () => {
			t0 = t;
			draw();
		});
		$('[data-reset]').addEventListener('click', () => {
			t = 0;
			t0 = 0;
			running = true;
			runBtn.textContent = 'Пауза';
			draw();
			wake();
		});
		draw();
	}
</script>
