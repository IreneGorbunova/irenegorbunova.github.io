---
/**
 * Styles shared by the new pictures and models of «Механическое движение. Система отсчёта» (grade 10), scoped under
 * `.som` (every such figure has it next to `g7`). Renders nothing.
 *
 * One color per quantity in the whole chapter:
 *   displacement s⃗ — gold (--g7-gold); its projections s_x, s_y and the coordinates x, y on the axes — blue / red
 *     (--g7-blue = --ig-vx, --g7-red = --ig-vy), as in MapLab;
 *   radius-vector r⃗ — violet (--g7-violet: the accent color is gold in the dark theme and would merge with s⃗);
 *   trajectory — the body's gray trace (dashed where it is only planned);
 *   velocities: of the body relative to the moving frame υ⃗₁ — blue, of the moving frame υ⃗₂ — green, their sum υ⃗ — red
 *     (as TrainPicture and RiverLab).
 * --so-light is a color light in both themes (paper, a white hull, pitch lines), --so-dark dark in both (space).
 * Text: on a phone the figures are scaled to about 0,93, so labels are set to 12–12,5 px there (≥ 11 px on screen).
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />

<style is:global>
	/* a color that is light in both themes (white paper, a white hull, pitch lines) */
	.som {
		--so-light: var(--sl-color-white);
		--so-dark: var(--sl-color-black);
	}
	:root[data-theme='light'] .som {
		--so-light: var(--sl-color-black);
		--so-dark: var(--sl-color-white);
	}
	.som .som-axis {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		fill: none;
	}
	.som .som-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.8;
		fill: none;
	}
	.som .som-drop {
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		fill: none;
	}
	.som .som-trace {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.85;
	}
	.som .som-plan {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
		fill: none;
	}
	.som .arrow--violet {
		stroke: var(--g7-violet);
	}
	.som .head--violet {
		fill: var(--g7-violet);
	}
	.som .arrow--dash {
		stroke-dasharray: 5 3;
	}
	.som .som-px {
		stroke: var(--g7-blue);
		stroke-width: 5;
		stroke-linecap: round;
		opacity: 0.9;
	}
	.som .som-py {
		stroke: var(--g7-red);
		stroke-width: 5;
		stroke-linecap: round;
		opacity: 0.9;
	}
	.som .t-violet {
		fill: var(--g7-violet) !important;
	}
	.som .g7__svg .t-blue {
		fill: var(--g7-blue);
	}
	.som .g7__svg .t-red {
		fill: var(--g7-red);
	}
	.som .g7__svg .t-gold {
		fill: var(--g7-gold);
	}
	.som .g7__svg .t-green {
		fill: var(--g7-green);
	}
	.som .t-math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.som .som-read {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.1rem;
		margin: 0.4rem 0 0;
		padding: 0;
		list-style: none;
		font-variant-numeric: tabular-nums;
		font-size: 0.95rem;
	}
	.som .som-read li {
		margin: 0;
	}
	.som .som-read .is-blue {
		color: var(--g7-blue);
	}
	.som .som-read .is-red {
		color: var(--g7-red);
	}
	.som .som-read .is-gold {
		color: var(--g7-gold);
	}
	.som .som-read .is-violet {
		color: var(--g7-violet);
	}
	.som .som-read .is-green {
		color: var(--g7-green);
	}
	@media (max-width: 40rem) {
		.som .g7__svg text {
			font-size: 12.5px;
		}
		.som .g7__svg .t-small {
			font-size: 12px;
		}
	}
</style>
