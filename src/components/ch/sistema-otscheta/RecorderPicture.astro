---
/**
 * Picture for «Относительность движения»: a pen recorder (самописец). The pen moves only up and down,
 * y = 1,5 см · sin(2πt / 1 с) (period 1 с, 3 см from the top to the bottom), along a guide fixed to the recorder's
 * body; the paper tape runs to the left under it at 2,5 см/с. Relative to the body the pen moves along a vertical
 * segment 3 см long (the guide, lit); relative to the tape it draws a wave with a wavelength of
 * 2,5 см/с · 1 с = 2,5 см. The grid of the tape: thin lines every 0,5 см, thick every 2,5 см (one second of tape).
 * Toggle «Лента движется / Лента стоит»: with the tape stopped the pen goes over one vertical stroke again and again,
 * the wave drawn before stays on the paper. Scale 16 px per сантиметр (larger than life, the caption says so); real
 * time.
 */
import SoStyles from './SoStyles.astro';
const PX = 226; // the pen tip, px
const MID = 118; // the middle of the pen's stroke
const A = 24; // 1,5 см
const T0 = 52;
const T1 = 184; // the tape's edges
---

<SoStyles />
<figure class="g7 g7--pic g7--narrow som not-content" data-recorder>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 212" role="img" aria-label="Самописец: перо движется только вверх и вниз, под ним влево движется бумажная лента. На ленте перо чертит волну">
			<!-- the tape with its grid (the grid moves with the paper) -->
			<rect class="rc-paper" x="0" y={T0} width="300" height={T1 - T0}></rect>
			<g data-grid></g>
			<path class="rc-ink" data-ink d=""></path>
			<path class="rc-edge" d={`M0 ${T0} H300 M0 ${T1} H300`}></path>
			<!-- the body of the recorder: the tape goes in under it -->
			<rect class="rc-body" x="262" y="22" width="92" height="188" rx="8"></rect>
			<rect class="rc-roller" x="256" y={T0 - 6} width="12" height={T1 - T0 + 12} rx="6"></rect>
			<circle class="rc-knob" cx="320" cy="58" r="9"></circle>
			<rect class="rc-lamp" data-lamp x="300" y="176" width="34" height="12" rx="3"></rect>
			<!-- the guide of the pen, fixed to the body -->
			<path class="rc-bracket" d={`M262 ${MID - A - 14} H${PX - 6} V${MID - A - 8} M262 ${MID + A + 14} H${PX - 6} V${MID + A + 8}`}></path>
			<line class="rc-guide" x1={PX - 6} y1={MID - A - 8} x2={PX - 6} y2={MID + A + 8}></line>
			<line class="rc-track" x1={PX - 6} y1={MID - A} x2={PX - 6} y2={MID + A}></line>
			<g data-pen>
				<path class="rc-arm" d={`M${PX - 6} -3 H${PX + 4} V3 H${PX - 6} Z`}></path>
				<path class="rc-pen" d={`M${PX} 0 l-5 -16 h10 Z`}></path>
				<rect class="rc-pencap" x={PX - 5} y="-30" width="10" height="15" rx="2"></rect>
			</g>
			<!-- labels -->
			<path class="rc-call" d={`M${PX - 4} ${MID - A - 16} Q${PX + 6} 34 ${PX + 24} 18`}></path>
			<text class="t-small" x="360" y="13" text-anchor="end">относительно корпуса — отрезок 3&nbsp;см</text>
			<text class="t-small" x="8" y={T1 + 22}>относительно ленты — волна</text>
			<path class="rc-call" d={`M96 ${T1 + 10} Q104 ${T1 - 2} 112 ${MID + A + 6}`}></path>
			<g data-speedarrow>
				<path class="rc-speed" d={`M120 ${T0 - 14} H60`}></path>
				<path class="head--ink" d={`M54 ${T0 - 14} l9 -4 v8 Z`}></path>
			</g>
			<text class="t-small t-num" data-vtext x="128" y={T0 - 10}>2,5 см/с</text>
		</svg>
		<div class="g7__row">
			<span class="g7__seg" data-mode><button type="button" class="g7__btn" aria-pressed="true" data-m="1">Лента движется</button><button type="button" class="g7__btn" aria-pressed="false" data-m="0">Лента стоит</button></span>
		</div>
	</div>
	<figcaption class="g7__caption">
		Перо движется относительно корпуса самописца только вверх и вниз, а лента под ним едет влево со скоростью 2,5&nbsp;см/с. Нарисовано крупнее, чем на самом деле; время настоящее.
	</figcaption>
</figure>

<style is:global>
	[data-recorder] .rc-paper {
		fill: color-mix(in oklab, var(--g7-paper) 90%, var(--g7-gold));
	}
	[data-recorder] .rc-grid {
		stroke: color-mix(in oklab, var(--g7-red) 30%, transparent);
		stroke-width: 0.5;
	}
	[data-recorder] .rc-grid--major {
		stroke: color-mix(in oklab, var(--g7-red) 55%, transparent);
		stroke-width: 1;
	}
	[data-recorder] .rc-ink {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	[data-recorder] .rc-edge {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	[data-recorder] .rc-body {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	[data-recorder] .rc-roller {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	[data-recorder] .rc-knob {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	[data-recorder] .rc-lamp {
		fill: var(--g7-green);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	[data-recorder] .rc-lamp.is-off {
		fill: var(--g7-faint);
	}
	[data-recorder] .rc-bracket {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	[data-recorder] .rc-guide {
		stroke: var(--g7-ink);
		stroke-width: 2.4;
	}
	[data-recorder] .rc-track {
		stroke: var(--g7-gold);
		stroke-width: 4;
		stroke-linecap: round;
		opacity: 0.75;
	}
	[data-recorder] .rc-arm {
		fill: var(--g7-ink);
	}
	[data-recorder] .rc-pen {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	[data-recorder] .rc-pencap {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	[data-recorder] .rc-call {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	[data-recorder] .rc-speed {
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
</style>

<script>
	import { loop, el } from '../g7/kit';

	const PX = 226;
	const MID = 118;
	const A = 24;
	const T0 = 52;
	const T1 = 184;
	const K = 16; // px per см
	const V = 2.5 * K; // px per second

	for (const root of document.querySelectorAll<HTMLElement>('[data-recorder]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const grid = q<SVGGElement>('[data-grid]');
		const ink = q<SVGPathElement>('[data-ink]');
		const pen = q<SVGGElement>('[data-pen]');
		const lamp = q<SVGRectElement>('[data-lamp]');
		const vtext = q<SVGTextElement>('[data-vtext]');
		const arrowG = q<SVGGElement>('[data-speedarrow]');
		// grid lines every 0,5 см over 300 px plus one period of 2,5 см to wrap
		const lines: SVGLineElement[] = [];
		for (let i = 0; i <= Math.ceil(340 / 8); i++) {
			const l = el('line', { class: i % 5 ? 'rc-grid' : 'rc-grid rc-grid--major', y1: T0, y2: T1 });
			grid.append(l);
			lines.push(l);
		}
		for (let j = 1; j < 8; j++) grid.append(el('line', { class: j === 4 ? 'rc-grid rc-grid--major' : 'rc-grid', x1: 0, x2: 300, y1: T0 + (j * (T1 - T0)) / 8, y2: T0 + (j * (T1 - T0)) / 8 }));
		let t = 0;
		let off = 0; // how far the paper has moved, px
		let moving = true;
		let pts: [number, number][] = []; // ink in paper coordinates
		const draw = () => {
			const y = MID - A * Math.sin(2 * Math.PI * t);
			pen.setAttribute('transform', `translate(0 ${y.toFixed(2)})`);
			const g = off % 40;
			lines.forEach((l, i) => {
				const x = (i * 8 - g).toFixed(1);
				l.setAttribute('x1', x);
				l.setAttribute('x2', x);
			});
			pts = pts.filter(([u]) => u - off > -6);
			ink.setAttribute('d', pts.map(([u, v], i) => `${i ? 'L' : 'M'}${(u - off).toFixed(1)} ${v.toFixed(1)}`).join(' '));
		};
		loop(root, (dt) => {
			t += dt;
			if (moving) off += V * dt;
			const y = MID - A * Math.sin(2 * Math.PI * t);
			pts.push([PX + off, y]);
			if (pts.length > 1600) pts.splice(0, pts.length - 1600);
			draw();
			return true;
		});
		const mode = root.querySelector('[data-mode]')!;
		for (const b of mode.querySelectorAll<HTMLButtonElement>('button'))
			b.addEventListener('click', () => {
				for (const o of mode.querySelectorAll('button')) o.setAttribute('aria-pressed', String(o === b));
				moving = b.dataset.m === '1';
				lamp.classList.toggle('is-off', !moving);
				vtext.textContent = moving ? '2,5 см/с' : 'лента стоит';
				arrowG.style.visibility = moving ? '' : 'hidden';
			});
		draw();
	}
</script>
