---
/**
 * Picture for «Закон сложения скоростей»: a passenger (175 см) walks along a train car at υ₁ = 1,5 м/с relative to
 * the car; the train passes a station at υ₂ = 5 м/с (18 км/ч). The camera rides with the car, so the car stands still
 * on the screen and the platform with its lamp posts runs back at 5 м/с. Two buttons: the passenger walks along the
 * train (υ = 5 + 1,5 = 6,5 м/с relative to the ground) or against it (υ = 5 − 1,5 = 3,5 м/с, still forward).
 * Above, the vectors tip to tail: υ₂ (green), then υ₁ (blue), and their sum υ (red). Scales: 30 px per metre, real
 * time (the passenger walks 7,5 м in 5 s, then starts again); arrows 12 px per м/с. Steps of 70 см.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const FLOOR = 164;
const K = 30; // px per metre
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--pic g7--narrow not-content" data-trainpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 240" role="img" aria-label="Пассажир идёт по вагону поезда, который едет мимо платформы. Стрелки: скорость пассажира относительно вагона, скорость вагона относительно земли и их сумма — скорость пассажира относительно земли">
			<!-- the vectors -->
			<path class="arrow arrow--green" data-a2 d=""></path>
			<path class="head--green" data-h2 d=""></path>
			<path class="arrow arrow--blue" data-a1 d=""></path>
			<path class="head--blue" data-h1 d=""></path>
			<path class="arrow arrow--red" data-a d=""></path>
			<path class="head--red" data-h d=""></path>
			<text class="t-small t-strong t-num tp-green" data-l2></text>
			<text class="t-small t-strong t-num tp-blue" data-l1></text>
			<text class="t-small t-strong t-num tp-red" data-l></text>
			<!-- the car, cut open -->
			<rect class="tp-wall" x="-10" y={FLOOR - 2.3 * K} width="380" height={2.3 * K}></rect>
			{[0, 1, 2, 3, 4].map((i) => <rect class="tp-win" x={10 + i * 74} y={FLOOR - 1.9 * K} width="48" height={1 * K} rx="4" />)}
			<g data-man></g>
			<rect class="tp-roof" x="-10" y={FLOOR - 2.3 * K - 8} width="380" height="9" rx="3"></rect>
			<rect class="tp-floor" x="-10" y={FLOOR} width="380" height="8"></rect>
			<rect class="tp-under" x="-10" y={FLOOR + 8} width="380" height="6"></rect>
			{[30, 105, 255, 330].map((x) => <circle class="tp-wheel" cx={x} cy={FLOOR + 27} r="13" />)}
			<rect class="tp-rail" x="0" y={FLOOR + 40} width="360" height="3"></rect>
			<!-- the platform in front, running back -->
			<rect class="tp-platform" x="0" y={FLOOR + 46} width="360" height={240 - FLOOR - 46}></rect>
			<line class="tp-edge" x1="0" y1={FLOOR + 46} x2="360" y2={FLOOR + 46}></line>
			<g data-posts></g>
			<text class="t-small t-halo" x="352" y="234" text-anchor="end">платформа</text>
		</svg>
		<div class="g7__row tp-ctrl">
			<span class="g7__label">Пассажир идёт</span>
			<div class="g7__seg" role="group" aria-label="Куда идёт пассажир" data-dir>
				<button type="button" class="g7__btn" aria-pressed="true" data-d="1">по ходу поезда</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-d="-1">против хода</button>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Поезд проезжает станцию со скоростью <i>υ</i><sub>2</sub>&nbsp;=&nbsp;5&nbsp;м/с, пассажир идёт по вагону со скоростью{' '}
		<i>υ</i><sub>1</sub>&nbsp;=&nbsp;1,5&nbsp;м/с. Относительно платформы его скорость <i>υ</i> — сумма этих скоростей: 6,5&nbsp;м/с
		по ходу поезда и 3,5&nbsp;м/с, если он идёт против хода. Мы смотрим из вагона, поэтому платформа уезжает назад. Часы
		идут как настоящие, люди и вагон нарисованы в масштабе.
	</figcaption>
</figure>

<style is:global>
	[data-trainpic] .tp-wall {
		fill: color-mix(in oklab, var(--g7-green) 14%, var(--sl-color-gray-6));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	[data-trainpic] .tp-win {
		fill: color-mix(in oklab, var(--ig-vx) 22%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	[data-trainpic] .tp-roof,
	[data-trainpic] .tp-under {
		fill: var(--g7-steel-dark);
	}
	[data-trainpic] .tp-floor {
		fill: var(--g7-wood-dark);
	}
	[data-trainpic] .tp-wheel {
		fill: var(--g7-ink);
		stroke: var(--g7-line);
		stroke-width: 2;
	}
	[data-trainpic] .tp-rail {
		fill: var(--g7-line);
	}
	[data-trainpic] .tp-platform {
		fill: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-5));
	}
	[data-trainpic] .tp-edge {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	[data-trainpic] .tp-post {
		fill: var(--g7-line);
	}
	[data-trainpic] .g7__svg .tp-green {
		fill: var(--g7-green);
	}
	[data-trainpic] .g7__svg .tp-blue {
		fill: var(--g7-blue);
	}
	[data-trainpic] .g7__svg .tp-red {
		fill: var(--g7-red);
	}
	[data-trainpic] .tp-ctrl {
		margin-top: 0.4rem;
	}
</style>

<script>
	import { el, loop, segment } from '../g7/kit';
	import { gait, human, type HumanPose } from '../mehanicheskaya-rabota/people';

	const FLOOR = 164;
	const K = 30; // px per metre
	const S = K / 100;
	const V1 = 1.5;
	const V2 = 5;
	const VK = 12; // px per м/с
	const VX = 40;
	const VY = 22;
	const WALK = 5; // s for 7,5 м

	const arrow = (x0: number, y: number, len: number) => {
		const s = Math.sign(len);
		const x1 = x0 + len;
		return [`M${x0.toFixed(1)} ${y} H${(x1 - s * 7).toFixed(1)}`, `M${x1.toFixed(1)} ${y} l${(-s * 7).toFixed(1)} -4 v8 Z`];
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-trainpic]')) {
		const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const posts = q<SVGGElement>('[data-posts]');
		const postItems = Array.from({ length: 4 }, () => {
			const g = el('g', {});
			g.append(el('rect', { class: 'tp-post', x: -3, y: FLOOR + 52, width: 6, height: 8 }));
			g.append(el('rect', { class: 'tp-post', x: -1.5, y: FLOOR - 40, width: 3, height: 96 }));
			g.append(el('rect', { class: 'tp-post', x: -12, y: FLOOR - 45, width: 24, height: 5, rx: 2 }));
			posts.append(g);
			return g;
		});
		const manG = q<SVGGElement>('[data-man]');
		const gR = el('g', {});
		const gL = el('g', {});
		manG.append(gR, gL);
		const toR = human(gR, { s: S, H: 175, shirt: 'hm-gold', hair: 'short' });
		const toL = human(gL, { s: S, H: 175, shirt: 'hm-gold', hair: 'short', dir: -1 });
		let dir = 1;
		let t = 0;

		const pose = (x0: number, d: number, dr: number): HumanPose => {
			const u = S * 175;
			const step = 0.7 * K;
			const ft = gait(d, step, step * 0.5, 0.05 * u);
			const ph = Math.sin((d / step) * Math.PI);
			const hx = x0 + dr * d;
			const A = 7 * S;
			return {
				hip: { x: hx, y: FLOOR - 0.505 * u + 0.012 * u * Math.abs(ph) },
				lean: 0.05,
				ankles: [
					{ x: x0 + dr * ft[0].x, y: FLOOR - A - ft[0].up },
					{ x: x0 + dr * ft[1].x, y: FLOOR - A - ft[1].up },
				],
				feet: [0, 0],
				hands: [
					{ x: hx + dr * 0.09 * u * ph, y: FLOOR - 0.43 * u },
					{ x: hx - dr * 0.09 * u * ph, y: FLOOR - 0.43 * u },
				],
			};
		};

		const show = () => {
			const tw = t % (WALK + 1.5);
			const walked = Math.min(tw, WALK) * V1 * K; // px along the car
			const x0 = dir > 0 ? 66 : 294;
			gR.style.display = dir > 0 ? '' : 'none';
			gL.style.display = dir > 0 ? 'none' : '';
			(dir > 0 ? toR : toL)(pose(x0, walked, dir));
			// the platform runs back at υ₂; a lamp post every 6 м
			postItems.forEach((g, i) => {
				const x = ((((i * 6 * K - V2 * t * K) % (24 * K)) + 24 * K) % (24 * K)) - 30;
				g.setAttribute('transform', `translate(${x.toFixed(1)} 0)`);
			});
			// the vectors: υ₂, then υ₁ from its tip, and the sum υ below
			const v1 = dir * V1;
			const [a2, h2] = arrow(VX, VY, V2 * VK);
			const [a1, h1] = arrow(VX + V2 * VK, VY + 11, v1 * VK);
			const [a, h] = arrow(VX, VY + 26, (V2 + v1) * VK);
			q('[data-a2]').setAttribute('d', a2);
			q('[data-h2]').setAttribute('d', h2);
			q('[data-a1]').setAttribute('d', a1);
			q('[data-h1]').setAttribute('d', h1);
			q('[data-a]').setAttribute('d', a);
			q('[data-h]').setAttribute('d', h);
			const l2 = q('[data-l2]');
			l2.setAttribute('x', String(VX));
			l2.setAttribute('y', String(VY - 8));
			l2.innerHTML = 'υ<tspan baseline-shift="sub" font-size="8">2</tspan> = 5 м/с — вагон относительно земли';
			const l1 = q('[data-l1]');
			l1.setAttribute('x', String(VX + (V2 + Math.max(v1, 0)) * VK + 8));
			l1.setAttribute('y', String(VY + 15));
			l1.innerHTML = `υ<tspan baseline-shift="sub" font-size="8">1</tspan> = 1,5 м/с ${dir > 0 ? 'по ходу' : 'против хода'}`;
			const l = q('[data-l]');
			l.setAttribute('x', String(VX + (V2 + v1) * VK + 8));
			l.setAttribute('y', String(VY + 30));
			l.textContent = dir > 0 ? 'υ = 5 + 1,5 = 6,5 м/с' : 'υ = 5 − 1,5 = 3,5 м/с';
		};
		loop(root, (dt) => {
			t += dt;
			show();
			return true;
		});
		segment(q('[data-dir]'), (btn) => {
			dir = +btn.dataset.d!;
			t = 0;
			show();
		});
		show();
	}
</script>
