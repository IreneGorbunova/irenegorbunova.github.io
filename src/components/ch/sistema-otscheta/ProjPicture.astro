---
/**
 * Picture for «Проекция вектора на ось»: three displacements over an axis Ox (20 px per metre, 0…5 м), the dashed
 * perpendiculars from the start and the end, the projection as a thick segment on the axis.
 *   1) from x₀ = 1 м to x = 4 м: s_x = 4 − 1 = 3 м > 0;
 *   2) from x₀ = 4 м to x = 1 м: s_x = 1 − 4 = −3 м < 0;
 *   3) perpendicular to the axis, x₀ = x = 2,5 м: s_x = 0.
 * Static.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 20;
const AX = 112;
const cases = [
	{ x0: 1, y0: 34, x1: 4, y1: 74, label: 's_x = 4 − 1 = 3 м', cls: 'pos' },
	{ x0: 4, y0: 40, x1: 1, y1: 82, label: 's_x = 1 − 4 = −3 м', cls: 'neg' },
	{ x0: 2.5, y0: 84, x1: 2.5, y1: 32, label: 's_x = 0', cls: 'zero' },
];
const arrow = (x0: number, y0: number, x1: number, y1: number) => {
	const L = Math.hypot(x1 - x0, y1 - y0);
	const ux = (x1 - x0) / L;
	const uy = (y1 - y0) / L;
	const bx = x1 - ux * 9;
	const by = y1 - uy * 9;
	return {
		line: `M${x0} ${y0} L${bx.toFixed(1)} ${by.toFixed(1)}`,
		head: `M${x1} ${y1} L${(bx - uy * 4.5).toFixed(1)} ${(by + ux * 4.5).toFixed(1)} L${(bx + uy * 4.5).toFixed(1)} ${(by - ux * 4.5).toFixed(1)} Z`,
	};
};
---

<G7Styles />
<figure class="g7 g7--pic not-content" data-proj10>
	<div class="g7__grid is-three">
		{
			cases.map((c) => {
				const X = (m: number) => 10 + m * K;
				const a = arrow(X(c.x0), c.y0, X(c.x1), c.y1);
				const lo = Math.min(X(c.x0), X(c.x1));
				const hi = Math.max(X(c.x0), X(c.x1));
				return (
					<svg class="g7__svg" viewBox="0 0 125 150" role="img" aria-label={`Вектор перемещения и его проекция на ось Ox: ${c.label.replace('s_x', 'проекция')}`}>
						<path class="ln-dash" d={`M${X(c.x0)} ${c.y0} V${AX} M${X(c.x1)} ${c.y1} V${AX}`}></path>
						<path class="ink" d={`M4 ${AX} H116`}></path>
						<path class="head--ink" d={`M121 ${AX} l-7 -3.5 v7 Z`}></path>
						{[0, 1, 2, 3, 4, 5].map((m) => (
							<>
								<line class="ln" x1={X(m)} y1={AX - 3} x2={X(m)} y2={AX + 3}></line>
								<text class="t-small t-num" x={X(m)} y={AX + 15} text-anchor="middle">{m}</text>
							</>
						))}
						<text x="120" y={AX - 7} text-anchor="end"><tspan class="t-i">x</tspan>, м</text>
						{hi > lo && <line class="pj-proj" x1={lo} y1={AX} x2={hi} y2={AX}></line>}
						{hi === lo && <circle class="pj-dot" cx={lo} cy={AX} r="3.5" />}
						<path class="arrow arrow--gold" d={a.line}></path>
						<path class="head--gold" d={a.head}></path>
						<circle class="pj-start" cx={X(c.x0)} cy={c.y0} r="3"></circle>
						<text class="t-i pj-s" x={(X(c.x0) + X(c.x1)) / 2 + (c.cls === 'zero' ? 8 : 6)} y={(c.y0 + c.y1) / 2 - (c.cls === 'zero' ? 0 : 6)}>s⃗</text>
						<text class="t-small t-num" x="62" y="146" text-anchor="middle">
							<tspan class="t-i">s</tspan><tspan baseline-shift="sub" font-size="8">x</tspan>{c.label.replace('s_x', '')}
						</text>
					</svg>
				);
			})
		}
	</div>
	<figcaption class="g7__caption">
		Перпендикуляры из начала и конца вектора отсекают на оси отрезок. Его длина со знаком «+» или «−» и есть проекция:
		плюс — если вектор направлен по оси, минус — если против оси; вектор, перпендикулярный оси, даёт проекцию 0.
	</figcaption>
</figure>

<style is:global>
	[data-proj10] .pj-proj {
		stroke: var(--g7-gold);
		stroke-width: 5;
		stroke-linecap: round;
		opacity: 0.75;
	}
	[data-proj10] .pj-dot {
		fill: var(--g7-gold);
	}
	[data-proj10] .pj-start {
		fill: var(--g7-paper);
		stroke: var(--g7-gold);
		stroke-width: 1.5;
	}
	[data-proj10] .g7__svg .pj-s {
		fill: var(--g7-gold);
		font-weight: 700;
	}
</style>
