---
/**
 * Picture for «Материальная точка»: the same car in two problems.
 * Left: a trip of about 700 км by road (a schematic map: the route is 280 px long, so 0,4 px per километр; the scale bar of 100 км is 40 px). The car,
 *   4,5 × 1,8 м, would be 0,0018 px long at this scale: on the map it is a point that moves along the route.
 * Right: the same car parks between two others, a top view at 14 px per metre: the car 4,5 × 1,8 м (63 × 25 px), the
 *   gap between the bumpers of the parked cars 6 м (84 px). Here the size of the car decides everything.
 * The car on the map moves along the route (one trip per 8 s), the parking car slides into the gap (one parking per
 *   8 s): both are slowed or sped up for the picture, no clock is claimed.
 */
import G7Styles from '../g7/G7Styles.astro';

// the route on the map, a smooth road from the city in the lower left to the city in the upper right
const ROUTE = 'M26 152 C60 140 70 118 96 112 S140 96 150 80 S190 58 214 52 S250 30 270 24';
const K = 14; // px per metre, the parking
const car = (cls: string) =>
	`<g class="${cls}"><rect class="pp-body" x="${-2.25 * K}" y="${-0.9 * K}" width="${4.5 * K}" height="${1.8 * K}" rx="7"/>` +
	`<path class="pp-glass" d="M${1.0 * K} ${-0.72 * K} Q${1.45 * K} 0 ${1.0 * K} ${0.72 * K} L${0.45 * K} ${0.62 * K} Q${0.62 * K} 0 ${0.45 * K} ${-0.62 * K} Z"/>` +
	`<path class="pp-glass" d="M${-1.55 * K} ${-0.66 * K} Q${-1.85 * K} 0 ${-1.55 * K} ${0.66 * K} L${-1.2 * K} ${0.58 * K} Q${-1.32 * K} 0 ${-1.2 * K} ${-0.58 * K} Z"/>` +
	`<rect class="pp-roof" x="${-1.15 * K}" y="${-0.62 * K}" width="${1.55 * K}" height="${1.24 * K}" rx="3"/></g>`;
---

<G7Styles />
<figure class="g7 g7--pic not-content" data-mpoint>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 290 190" role="img" aria-label="Схема дороги длиной около 700 километров между двумя городами. Автомобиль на ней — движущаяся точка">
			<text class="t-title" x="12" y="20">Поездка за 700&nbsp;км</text>
			<path class="pp-land" d="M0 30 Q80 60 120 40 T290 60 V190 H0 Z"></path>
			<path class="pp-lake" d="M178 120 q20 -14 42 -4 q16 10 -2 22 q-24 10 -40 -4 q-8 -8 0 -14 Z"></path>
			<path class="pp-road" d={ROUTE}></path>
			<circle class="pp-city" cx="26" cy="152" r="6"></circle>
			<circle class="pp-city" cx="270" cy="24" r="6"></circle>
			<circle class="pp-dot" r="4" data-dot></circle>
			<path class="ln" d="M168 176 H208 M168 172 V180 M208 172 V180"></path>
			<text class="t-small" x="213" y="180">100&nbsp;км</text>
			<text class="t-small" x="40" y="174">автомобиль — точка</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 290 190" role="img" aria-label="Тот же автомобиль паркуется между двумя машинами, вид сверху. Промежуток 6 метров, длина автомобиля 4,5 метра">
			<text class="t-title" x="12" y="20">Парковка</text>
			<rect class="pp-asphalt" x="0" y="34" width="290" height="156"></rect>
			<line class="pp-curb" x1="0" y1="150" x2="290" y2="150"></line>
			<rect class="pp-walk" x="0" y="151" width="290" height="39"></rect>
			<path class="pp-lane" d="M0 92 H40 M70 92 H110 M140 92 H180 M210 92 H250 M270 92 H290"></path>
			<g transform={`translate(${28 + 0.75 * K} 128)`} set:html={car('pp-car pp-car--parked')} />
			<g transform={`translate(${28 + 9 * K + 2.25 * K} 128)`} set:html={car('pp-car pp-car--parked')} />
			<g data-park set:html={car('pp-car pp-car--me')} />
			<path class="ln" d={`M${28 + 3 * K} 172 H${28 + 9 * K} M${28 + 3 * K} 167 V177 M${28 + 9 * K} 167 V177`}></path>
			<text class="t-small t-num" x={28 + 6 * K} y="186" text-anchor="middle">6&nbsp;м</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Слева автомобиль в сотни тысяч раз короче дороги: на схеме он точка. Справа автомобилю длиной 4,5&nbsp;м нужно поместиться в промежуток 6&nbsp;м — здесь размеры важнее всего.
		Парковка нарисована в масштабе, автомобиль на схеме едет быстрее, чем в жизни.
	</figcaption>
</figure>

<style is:global>
	[data-mpoint] .pp-land {
		fill: color-mix(in oklab, var(--g7-green) 14%, var(--g7-paper));
	}
	[data-mpoint] .pp-lake {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 0.8;
	}
	[data-mpoint] .pp-road {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-mpoint] .pp-city {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	[data-mpoint] .pp-dot {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	[data-mpoint] .pp-asphalt {
		fill: var(--sl-color-gray-6);
	}
	[data-mpoint] .pp-walk {
		fill: color-mix(in oklab, var(--ig-v) 12%, var(--sl-color-gray-5));
	}
	[data-mpoint] .pp-curb {
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	[data-mpoint] .pp-lane {
		stroke: var(--g7-line);
		stroke-width: 1.5;
	}
	[data-mpoint] .pp-body {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	[data-mpoint] .pp-car--parked .pp-body {
		fill: var(--g7-steel);
	}
	[data-mpoint] .pp-car--me .pp-body {
		fill: var(--g7-gold);
	}
	[data-mpoint] .pp-glass {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-5));
	}
	[data-mpoint] .pp-roof {
		fill: color-mix(in oklab, var(--sl-color-white) 12%, transparent);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const K = 14;
	// the parking: from the lane, backwards along an S into the gap (the car's center and heading), then still
	const X1 = 28 + 3 * K + 0.75 * K + 2.25 * K; // the final center: 0,75 м from the rear car
	const Y1 = 128;
	const parkAt = (u: number) => {
		// 0…0,3: drives up along the lane; 0,3…0,4: stops; 0,4…0,9: reverses into the gap; then stands
		if (u < 0.3) {
			const v = u / 0.3;
			return { x: X1 + 5 * K - (1 - v) * 7 * K + 1.5 * K, y: 100, a: 0 };
		}
		if (u < 0.4) return { x: X1 + 6.5 * K, y: 100, a: 0 };
		if (u < 0.9) {
			const v = (u - 0.4) / 0.5;
			const e = v * v * (3 - 2 * v);
			const y = 100 + (Y1 - 100) * e;
			const x = X1 + 6.5 * K - 6.5 * K * e;
			const a = -Math.sin(Math.PI * e) * 0.38;
			return { x, y, a };
		}
		return { x: X1, y: Y1, a: 0 };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-mpoint]')) {
		const dot = root.querySelector<SVGCircleElement>('[data-dot]')!;
		const park = root.querySelector<SVGGElement>('[data-park]')!;
		const road = root.querySelector<SVGPathElement>('.pp-road')!;
		const L = road.getTotalLength();
		let t = 0;
		const show = () => {
			const u = (t % 8) / 8;
			const p = road.getPointAtLength(L * Math.min(1, u / 0.85));
			dot.setAttribute('cx', p.x.toFixed(1));
			dot.setAttribute('cy', p.y.toFixed(1));
			const c = parkAt(u);
			park.setAttribute('transform', `translate(${c.x.toFixed(1)} ${c.y.toFixed(1)}) rotate(${((c.a * 180) / Math.PI).toFixed(1)})`);
		};
		loop(root, (dt) => {
			t += dt;
			show();
			return true;
		});
		show();
	}
</script>
