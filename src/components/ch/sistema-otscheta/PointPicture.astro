---
/**
 * Picture for «Материальная точка»: the same airliner (A320: 37,6 м long, wingspan 35,8 м, fuselage 3,95 м wide) in
 * two problems.
 * Left «Рейс Москва — Сочи»: a dispatcher's map (0,1 px per километр; latitude 11,1 px per degree, longitude 7,15 px
 *   per degree, i.e. cos 50°; the coast of the Black Sea and the Sea of Azov from rough coordinates). The route is the
 *   great circle of 1360 км (computed: 1362 км between the city centers), 136 px; the plane would be 0,004 px long at
 *   this scale, so on the map it is a dot. One flight per 8 s (the real one takes about 2,5 h: sped up, the caption
 *   says so); the scale bar is 200 км.
 * Right «Посадка»: top view at 4,2 px per metre, to scale: the plane stands nose to the terminal; a jet bridge
 *   (телетрап) from a rotunda by the terminal telescopes out to the front left door (4,6 м behind the nose) in 2,5 s,
 *   stays docked 3,5 s and draws back in 1,5 s (one cycle per 8 s, a little faster than real). Here the size of the
 *   plane and the place of its door decide everything. A dimension line gives 37,6 м.
 */
import G7Styles from '../g7/G7Styles.astro';
const f = (v: number) => v.toFixed(1);
// the map: lon/lat → px
const MX = (lon: number) => 160 + (lon - 37.62) * 7.15;
const MY = (lat: number) => 38 + (55.76 - lat) * 11.12;
const poly = (pts: number[][]) => pts.map(([lo, la], i) => `${i ? 'L' : 'M'}${f(MX(lo))} ${f(MY(la))}`).join(' ') + ' Z';
const black = poly([
	[27.6, 42.5], [28.6, 44.0], [29.7, 45.3], [30.7, 46.5], [31.8, 46.6], [33.0, 46.0], [33.6, 45.2], [33.4, 44.6], [34.5, 44.4],
	[35.5, 45.0], [36.5, 45.2], [37.3, 44.9], [38.5, 44.3], [39.7, 43.6], [40.8, 43.0], [41.6, 42.0], [41.5, 40.5], [27.0, 40.5],
]);
const azov = poly([
	[35.1, 45.4], [36.2, 45.5], [36.7, 45.3], [37.8, 46.0], [38.6, 46.6], [39.3, 47.2], [38.2, 47.1], [37.0, 46.9], [35.8, 46.6], [35.0, 45.9],
]);
const msk = { x: MX(37.62), y: MY(55.76) };
const soc = { x: MX(39.72), y: MY(43.59) };
const route = `M${f(msk.x)} ${f(msk.y)} Q${f((msk.x + soc.x) / 2 + 6)} ${f((msk.y + soc.y) / 2)} ${f(soc.x)} ${f(soc.y)}`;
// the plane, top view, metres: x from the nose back, y to the left side of the plane (port)
const K = 4.2;
const NX = 98; // the nose, px
const CY = 112; // the axis of the plane, px
const P = (x: number, y: number) => `${f(NX + x * K)} ${f(CY + y * K)}`;
const hw = 1.975;
const fus = `M${P(0, 0)} Q${P(0.3, -hw)} ${P(3.5, -hw)} L${P(31, -hw)} Q${P(36, -0.8)} ${P(37.6, -0.3)} L${P(37.6, 0.3)} Q${P(36, 0.8)} ${P(31, hw)} L${P(3.5, hw)} Q${P(0.3, hw)} ${P(0, 0)} Z`;
const wing = (s: number) => `M${P(12.5, s * hw)} L${P(19.9, s * 17.9)} L${P(21.4, s * 17.9)} L${P(18.6, s * hw)} Z`;
const stab = (s: number) => `M${P(31.5, s * 1.2)} L${P(34.6, s * 6.2)} L${P(35.9, s * 6.2)} L${P(35.6, s * 1.2)} Z`;
const DOOR = { x: NX + 4.6 * K, y: CY + hw * K }; // front left door
const ROT = { x: 40, y: 168 }; // the rotunda of the jet bridge
---

<G7Styles />
<figure class="g7 g7--pic not-content" data-mpoint>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 290 196" role="img" aria-label="Карта диспетчера: маршрут самолёта из Москвы в Сочи длиной около 1360 километров. Самолёт на ней — движущаяся точка">
			<rect class="pp-land" x="0" y="0" width="290" height="196"></rect>
			<path class="pp-sea" d={black}></path>
			<path class="pp-sea" d={azov}></path>
			<text class="t-small pp-sealab" x={MX(33.2)} y={MY(42.6)} text-anchor="middle">Чёрное море</text>
			<path class="pp-route" d={route}></path>
			<circle class="pp-city" cx={f(msk.x)} cy={f(msk.y)} r="5"></circle>
			<circle class="pp-city" cx={f(soc.x)} cy={f(soc.y)} r="5"></circle>
			<text class="t-strong pp-name" x={f(msk.x + 10)} y={f(msk.y + 4)}>Москва</text>
			<text class="t-strong pp-name" x={f(soc.x + 9)} y={f(soc.y + 4)}>Сочи</text>
			{[[39.2, 51.67, 'Воронеж'], [39.7, 47.23, 'Ростов-на-Дону']].map(([lo, la, n]) => <><circle class="pp-town" cx={f(MX(lo as number))} cy={f(MY(la as number))} r="2.5" /><text class="t-small" x={f(MX(lo as number) + 7)} y={f(MY(la as number) + 4)}>{n}</text></>)}
			<circle class="pp-dot" r="4" data-dot></circle>
			<text class="t-small" x="50" y="112" text-anchor="middle">самолёт —</text>
			<text class="t-small" x="50" y="126" text-anchor="middle">точка</text>
			<path class="pp-call" data-call d=""></path>
			<path class="ln" d="M14 182 H34 M14 178 V186 M34 178 V186"></path>
			<text class="t-small t-num" x="40" y="186">200&nbsp;км</text>
			<text class="t-title" x="12" y="20">Рейс Москва — Сочи</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 290 196" role="img" aria-label="Тот же самолёт у терминала, вид сверху: к его передней левой двери выдвигается телетрап. Длина самолёта 37,6 метра">
			<rect class="pp-apron" x="0" y="0" width="290" height="196"></rect>
			<path class="pp-guide" d={`M${NX - 12} ${CY} H284`}></path>
			<rect class="pp-term" x="0" y="0" width="26" height="196"></rect>
			<path class="pp-termglass" d="M20 10 V186"></path>
			<path class="pp-wing" d={wing(1)}></path>
			<path class="pp-wing" d={wing(-1)}></path>
			<ellipse class="pp-eng" cx={NX + 14.5 * K} cy={CY + 5.75 * K} rx={2.2 * K} ry={1.05 * K}></ellipse>
			<ellipse class="pp-eng" cx={NX + 14.5 * K} cy={CY - 5.75 * K} rx={2.2 * K} ry={1.05 * K}></ellipse>
			<path class="pp-wing" d={stab(1)}></path>
			<path class="pp-wing" d={stab(-1)}></path>
			<path class="pp-fus" d={fus}></path>
			<path class="pp-fin" d={`M${P(29, 0)} L${P(37.4, 0)}`}></path>
			<path class="pp-cock" d={`M${P(1.4, -1.1)} Q${P(1, 0)} ${P(1.4, 1.1)} L${P(2.3, 1.2)} Q${P(1.9, 0)} ${P(2.3, -1.2)} Z`}></path>
			<rect class="pp-door" x={f(DOOR.x - 2)} y={f(DOOR.y - 1.5)} width="4" height="3"></rect>
			<!-- the jet bridge -->
			<path class="pp-stem" d={`M26 ${ROT.y} H${ROT.x}`}></path>
			<g data-bridge>
				<rect class="pp-tunnel pp-tunnel--1" data-t1 x="0" y="-4.5" width="10" height="9"></rect>
				<rect class="pp-tunnel" data-t2 x="0" y="-4" width="10" height="8"></rect>
				<rect class="pp-cab" data-cab x="0" y="-6" width="8" height="12" rx="1.5"></rect>
			</g>
			<circle class="pp-rot" cx={ROT.x} cy={ROT.y} r="7"></circle>
			<text class="t-small" x="34" y="132">дверь</text>
			<path class="pp-call" d={`M70 128 L${f(DOOR.x - 3)} ${f(DOOR.y + 1)}`}></path>
			<path class="ln" d={`M${NX} 30 H${f(NX + 37.6 * K)} M${NX} 25 V35 M${f(NX + 37.6 * K)} 25 V35`}></path>
			<text class="t-small t-num" x={f(NX + 18.8 * K)} y="22" text-anchor="middle">37,6&nbsp;м</text>
			<text class="t-title" x="34" y="190">Посадка</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		На карте диспетчера самолёт в 36&nbsp;000 раз короче маршрута — он точка. У телетрапа важны размеры самолёта: телетрап должен подойти точно к двери. Посадка нарисована в масштабе, полёт на карте ускорен.
	</figcaption>
</figure>

<style is:global>
	[data-mpoint] .pp-land {
		fill: color-mix(in oklab, var(--g7-green) 14%, var(--g7-paper));
	}
	[data-mpoint] .pp-sea {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 0.8;
	}
	[data-mpoint] .pp-sealab {
		fill: var(--g7-water-edge) !important;
	}
	[data-mpoint] .pp-route {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.6;
		stroke-dasharray: 5 4;
	}
	[data-mpoint] .pp-city {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	[data-mpoint] .pp-name {
		font-size: 12px;
	}
	[data-mpoint] .pp-town {
		fill: var(--g7-line);
	}
	[data-mpoint] .pp-dot {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	[data-mpoint] .pp-call {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	[data-mpoint] .pp-apron {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 60%, var(--g7-paper));
	}
	[data-mpoint] .pp-guide {
		stroke: var(--g7-gold);
		stroke-width: 1.2;
		opacity: 0.7;
	}
	[data-mpoint] .pp-term {
		fill: var(--g7-steel);
	}
	[data-mpoint] .pp-termglass {
		stroke: color-mix(in oklab, var(--ig-vx) 50%, var(--g7-paper));
		stroke-width: 4;
	}
	[data-mpoint] .pp-fus,
	[data-mpoint] .pp-wing {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	[data-mpoint] .pp-fus {
		fill: var(--sl-color-white);
	}
	:root[data-theme='light'] [data-mpoint] .pp-fus {
		fill: var(--sl-color-black);
	}
	:root[data-theme='light'] [data-mpoint] .pp-wing {
		fill: var(--sl-color-gray-6);
	}
	[data-mpoint] .pp-fin {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	[data-mpoint] .pp-eng {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	[data-mpoint] .pp-cock {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--g7-paper));
	}
	[data-mpoint] .pp-door {
		fill: var(--g7-gold);
	}
	[data-mpoint] .pp-stem {
		stroke: var(--g7-steel-dark);
		stroke-width: 7;
	}
	[data-mpoint] .pp-tunnel {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	[data-mpoint] .pp-tunnel--1 {
		fill: var(--g7-steel-dark);
	}
	[data-mpoint] .pp-cab {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	[data-mpoint] .pp-rot {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const K = 4.2;
	const NX = 98;
	const CY = 112;
	const DOOR = { x: NX + 4.6 * K, y: CY + 1.975 * K };
	const ROT = { x: 40, y: 168 };
	const CAB = 8; // the cabin's length along the bridge, px
	const f = (v: number) => v.toFixed(1);
	// the docked cabin touches the fuselage just below the door: its front end at the door
	const dx = DOOR.x - ROT.x;
	const dy = DOOR.y + 4.5 - ROT.y;
	const FULL = Math.hypot(dx, dy); // from the rotunda's center to the docked front of the cabin
	const ANG = (Math.atan2(dy, dx) * 180) / Math.PI;
	const SHORT = 0.55 * FULL;

	for (const root of document.querySelectorAll<HTMLElement>('[data-mpoint]')) {
		const dot = root.querySelector<SVGCircleElement>('[data-dot]')!;
		const call = root.querySelector<SVGPathElement>('[data-call]')!;
		const road = root.querySelector<SVGPathElement>('.pp-route')!;
		const bridge = root.querySelector<SVGGElement>('[data-bridge]')!;
		const t1 = root.querySelector<SVGRectElement>('[data-t1]')!;
		const t2 = root.querySelector<SVGRectElement>('[data-t2]')!;
		const cab = root.querySelector<SVGRectElement>('[data-cab]')!;
		const L = road.getTotalLength();
		let t = 0;
		const show = () => {
			const u = t % 8;
			const p = road.getPointAtLength(L * Math.min(1, u / 7));
			dot.setAttribute('cx', f(p.x));
			dot.setAttribute('cy', f(p.y));
			call.setAttribute('d', `M84 112 L${f(p.x - 5)} ${f(p.y)}`);
			// the bridge: out 0,5…3 s, docked till 6,5 s, back by 8 s
			const e = u < 0.5 ? 0 : u < 3 ? ease((u - 0.5) / 2.5) : u < 6.5 ? 1 : 1 - ease((u - 6.5) / 1.5);
			const len = SHORT + (FULL - SHORT) * e;
			bridge.setAttribute('transform', `translate(${ROT.x} ${ROT.y}) rotate(${ANG.toFixed(1)})`);
			const inner = len - CAB;
			t1.setAttribute('width', f(inner * 0.55));
			t2.setAttribute('x', f(inner * 0.45));
			t2.setAttribute('width', f(inner * 0.55));
			cab.setAttribute('x', f(inner));
		};
		loop(root, (dt) => {
			t += dt;
			show();
			return true;
		});
		show();
	}
</script>
