		stroke-width: 0.8;
	}
	[data-mdintro] .bk-spoke {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.45;
	}
	[data-mdintro] .bk-hub,
	[data-mdintro] .bk-ring {
		fill: var(--sl-color-gray-3);
	}
	[data-mdintro] .bk-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-mdintro] .bk-frame {
		fill: none;
		stroke: var(--ig-vx);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-mdintro] .bk-part {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-linecap: round;
	}
	[data-mdintro] .bk-saddle,
	[data-mdintro] .bk-pedal {
		fill: var(--sl-color-gray-2);
	}
	[data-mdintro] .bk-far {
		opacity: 0.7;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { gait, human, type HumanPose } from '../mehanicheskaya-rabota/people';
	import { bike, spokePoint } from './bike';

	type Foot = { x: number; up: number };

	for (const root of document.querySelectorAll<HTMLElement>('[data-mdintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="walkway"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 40; // px per metre
			const S = K / 100; // px per см
			const BELT = 134;
			const FLOOR = 234;
			const VB = 0.65; // м/с, the belt
			const VW = 1.3; // м/с, walking
			const X0 = 20; // the start line, px
			const woman = human($<SVGGElement>('[data-woman]'), { s: S, H: 165, shirt: 'hm-red', hair: 'pony' });
			const boy = human($<SVGGElement>('[data-boy]'), { s: S, H: 150, shirt: 'hm-gold', hair: 'short' });
			const man = human($<SVGGElement>('[data-man]'), { s: S, H: 178, shirt: 'hm-blue', hair: 'short' });
			const pallets = $<SVGPathElement>('[data-pallets]');
			const rail = $<SVGPathElement>('[data-rail]');
			const suitcase = $<SVGGElement>('[data-case]');
			// a walker whose body has gone `d` px relative to the surface, the surface itself shifted by `off` px
			const walk = (H: number, step: number, x0: number, d: number, off: number, floor: number): HumanPose => {
				const u = S * H;
				const A = 7 * S * Math.min(1, H / 172);
				const ft: Foot[] = gait(d, step, x0 + step * 0.5, 0.05 * u);
				const ph = Math.sin((d / step) * Math.PI);
				const hx = x0 + d + off;
				return {
					hip: { x: hx, y: floor - 0.505 * u + 0.012 * u * Math.abs(ph) },
					lean: 0.06,
					ankles: [
						{ x: ft[0].x + off, y: floor - A - ft[0].up },
						{ x: ft[1].x + off, y: floor - A - ft[1].up },
					],
					feet: [0, 0],
					hands: [
						{ x: hx + 0.09 * u * ph, y: floor - 0.43 * u },
						{ x: hx - 0.09 * u * ph, y: floor - 0.43 * u },
					],
				};
			};
			scene(card, 4, (x) => {
				const t = 4 * x;
				const belt = VB * t * K; // px the belt has moved
				// the pallets every 40 см and the marks on the handrail every 60 см move with the belt
				let d = '';
				for (let p = (belt % (0.4 * K)) - 0.4 * K; p < 362; p += 0.4 * K) d += `M${p.toFixed(1)} ${BELT + 1} V${BELT + 14} `;
				pallets.setAttribute('d', d);
				let r = '';
				for (let p = (belt % (0.6 * K)) - 0.6 * K; p < 362; p += 0.6 * K) r += `M${p.toFixed(1)} ${BELT - 41.5} H${(p + 5).toFixed(1)} `;
				rail.setAttribute('d', r);
				// the woman stands, the belt carries her and the suitcase
				const wu = S * 165;
				const wx = X0 + belt;
				woman({
					hip: { x: wx, y: BELT - 0.505 * wu },
					lean: 0,
					ankles: [
						{ x: wx + 0.02 * wu, y: BELT - 7 * S * (165 / 172) },
						{ x: wx - 0.03 * wu, y: BELT - 7 * S * (165 / 172) },
					],
					feet: [0, 0],
					hands: [
						{ x: wx + 0.14 * wu, y: BELT - 96 * S },
						{ x: wx - 0.01 * wu, y: BELT - 0.42 * wu },
					],
				});
				suitcase.setAttribute('transform', `translate(${(wx + 0.14 * wu).toFixed(1)} ${BELT})`);
				// the boy walks on the belt: 1,3 м/с relative to it, steps of 60 см
				boy(walk(150, 0.6 * K, X0, VW * t * K, belt, BELT));
				// the man walks on the floor: 1,3 м/с, steps of 70 см
				man(walk(178, 0.7 * K, X0, VW * t * K, 0, FLOOR));
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="reflector"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.45; // px per см
			const G = 196;
			const V = 200; // см/с
			const RUN = 3.2;
			const XS = -70; // the rear contact point at the start, px
			const RR = 28; // the reflector, см from the axle
			const pose = bike($<SVGGElement>('[data-bike]'), S, { shirt: 'hm-green', hair: 'short' });
			const trail = $<SVGPathElement>('[data-trail]');
			const trail2 = $<SVGPathElement>('[data-trail2]');
			const refl = $<SVGCircleElement>('[data-refl]');
			const intrail = $<SVGPathElement>('[data-intrail]');
			const inrefl = $<SVGCircleElement>('[data-inrefl]');
			const inspokes = $<SVGGElement>('[data-inspokes]');
			const RI = 30 * (RR / 35); // the reflector in the inset, px (the wheel drawn 30 px for 35 см)
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const dist = V * t; // см
				const bx = XS + dist * S;
				pose(bx, G, dist);
				// the trail from the start up to now, every 2 см of the road
				let d = '';
				for (let q = 0; q <= dist; q += 2) {
					const p = spokePoint(XS + q * S, G, S, q, RR);
					d += `${q ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)} `;
				}
				const p = spokePoint(bx, G, S, dist, RR);
				d += `L${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
				trail.setAttribute('d', d);
				trail2.setAttribute('d', d);
				refl.setAttribute('cx', p.x.toFixed(1));
				refl.setAttribute('cy', p.y.toFixed(1));
				// the inset: the same wheel seen from the frame; the reflector goes round, the trail closes into a circle
				const a = dist / 35;
				inspokes.setAttribute('transform', `rotate(${((a * 180) / Math.PI).toFixed(1)})`);
				const full = a >= 2 * Math.PI;
				const a1 = full ? 2 * Math.PI - 0.001 : a;
				const ex = RI * Math.cos(a1);
				const ey = RI * Math.sin(a1);
				intrail.setAttribute('d', a > 0.02 ? `M${RI} 0 A${RI.toFixed(2)} ${RI.toFixed(2)} 0 ${a1 > Math.PI ? 1 : 0} 1 ${ex.toFixed(2)} ${ey.toFixed(2)}${full ? ' Z' : ''}` : '');
				inrefl.setAttribute('cx', (RI * Math.cos(a)).toFixed(2));
				inrefl.setAttribute('cy', (RI * Math.sin(a)).toFixed(2));
			});
		}
	}
</script>
