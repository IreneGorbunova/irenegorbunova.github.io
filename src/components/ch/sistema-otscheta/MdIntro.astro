	}
	[data-mdintro] .md-sign-ink {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-mdintro] .md-sign-plane {
		fill: var(--sl-color-black);
	}
	[data-mdintro] .md-mullion {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	[data-mdintro] .md-walk-body {
		fill: var(--sl-color-gray-4);
	}
	[data-mdintro] .md-belt {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2.4;
	}
	[data-mdintro] .md-pallets {
