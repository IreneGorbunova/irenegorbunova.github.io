		stroke-width: 1.2;
	}
	[data-mdintro] .md-floor {
		fill: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-5));
	}
	[data-mdintro] .md-tile {
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	[data-mdintro] .md-floor-edge {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-mdintro] .md-seat {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
