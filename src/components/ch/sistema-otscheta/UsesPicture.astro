---
/**
 * Small pictures for «Где это встречается» of «Механическое движение. Система отсчёта» (kind = gps | drift | geo).
 *   gps: a phone with a map (1 px per metre: streets, a park, a pond); a blue dot moves 24 м north and 24 м east at
 *     4 м/с (12 s, then 2 s still, loop); beside the phone its three numbers: latitude and longitude with five decimals,
 *     recomputed from the dot (1 м north = 1/111 195°, 1 м east = 1/(111 195 · cos 55,75°) = 1/62 569°), and the
 *     height 145 м. Two satellites above send faint signals. The start 55,75390° N, 37,62080° E is a made-up point.
 *   drift: top view; a plane heads north at υ₁ = 200 км/ч relative to the air, the wind blows from the west at
 *     υ₂ = 50 км/ч; relative to the ground the plane moves at υ = √(200² + 50²) = 206 км/ч, 14,0° east of north
 *     (tg = 0,25). Arrows 0,3 px per км/ч: υ⃗₁ blue (60 px), υ⃗₂ green (15 px), υ⃗ red. The plane flies 80 px along its
 *     dashed track in 8 s (from y = 166 to 86 px, so the arrows never leave the picture) with its nose still north; clouds drift east at a quarter of its
 *     northward speed (as the wind does). Not to scale; the clock is not real.
 *   geo: the Earth seen from above the North Pole (radius 11,33 px) and a geostationary orbit at 42 164 км from its
 *     center, 6,62 Earth radii (75 px): the distances are to scale, the satellite and the dish are drawn far larger.
 *     The Earth turns once in 8 s instead of 24 h, counterclockwise, and the satellite goes round with it; a dish on
 *     the equator stays pointed at it. The stars stand still.
 */
interface Props {
	kind: 'gps' | 'drift' | 'geo';
}
const { kind } = Astro.props;
const label = {
	gps: 'Телефон с картой: синяя точка движется по улицам, рядом меняются широта и долгота, а высота остаётся 145 метров. Сверху два спутника',
	drift: 'Самолёт, вид сверху: нос смотрит на север, ветер дует с запада, и самолёт летит наискосок, на 14 градусов восточнее севера',
	geo: 'Земля, вид со стороны Северного полюса, и геостационарный спутник: Земля поворачивается, спутник обходит её вместе с ней, и антенна на экваторе всё время смотрит на него',
}[kind];
// gps map, px = m; the phone screen is 72 × 120 px at (24; 34)
const stars: [number, number][] = [
	[18, 20], [52, 150], [200, 22], [226, 140], [30, 92], [214, 86], [96, 12], [150, 164], [186, 56], [60, 54], [168, 118], [20, 160],
];
import SoStyles from './SoStyles.astro';
---

<SoStyles />
<div class="g7 som usp10-wrap not-content">
<svg class="g7__svg usp10" data-usp10={kind} viewBox="0 0 240 180" role="img" aria-label={label}>
	{kind === 'gps' && (
		<g>
			<rect class="u-sky" x="0" y="0" width="240" height="180"></rect>
			<!-- satellites -->
			<g transform="translate(150 22) rotate(-20)"><rect class="u-sat" x="-4" y="-4" width="8" height="8"></rect><rect class="u-panel" x="-17" y="-3" width="11" height="6"></rect><rect class="u-panel" x="6" y="-3" width="11" height="6"></rect></g>
			<g transform="translate(214 40) rotate(15)"><rect class="u-sat" x="-4" y="-4" width="8" height="8"></rect><rect class="u-panel" x="-17" y="-3" width="11" height="6"></rect><rect class="u-panel" x="6" y="-3" width="11" height="6"></rect></g>
			<path class="u-signal" d="M146 28 L78 90 M208 46 L80 92"></path>
			<!-- the phone -->
			<rect class="u-phone" x="16" y="24" width="88" height="150" rx="12"></rect>
			<svg x="24" y="36" width="72" height="124" viewBox="0 0 72 124">
				<rect class="u-map" x="0" y="0" width="72" height="124"></rect>
				<rect class="u-park" x="38" y="6" width="30" height="40" rx="3"></rect>
				<ellipse class="u-pond" cx="18" cy="104" rx="12" ry="8"></ellipse>
				<path class="u-street" d="M0 52 H72 M0 92 H72 M14 0 V124 M54 0 V124 M30 52 V124"></path>
				<path class="u-route" d="M14 92 V68 H38"></path>
				<circle class="u-halo" data-gpsdot cx="14" cy="92" r="6"></circle>
				<circle class="u-dot" data-gpsdot2 cx="14" cy="92" r="3.2"></circle>
			</svg>
			<rect class="u-cam" x="50" y="28" width="20" height="3" rx="1.5"></rect>
			<!-- the numbers -->
			<text class="u-num" x="112" y="100" data-lat>55,75390° с. ш.</text>
			<text class="u-num" x="112" y="124" data-lon>37,62080° в. д.</text>
			<text class="u-num" x="112" y="148">высота 145&nbsp;м</text>
		</g>
	)}
	{kind === 'drift' && (
		<g>
			<rect class="u-land" x="0" y="0" width="240" height="180"></rect>
			<path class="u-fields" d="M0 40 L240 52 M0 104 L240 96 M70 0 L62 180 M168 0 L176 180"></path>
			<path class="u-river" d="M0 150 Q60 128 110 150 T240 136"></path>
			<g data-clouds></g>
			<path class="som-plan" data-track d=""></path>
			<path class="u-heading" data-heading d=""></path>
			<g data-plane>
				<path class="u-plane" d="M0 -16 Q2 -14 2 -8 L2 -3 L16 4 L16 7 L2 4 L2 10 L6 14 L6 16 L0 15 L-6 16 L-6 14 L-2 10 L-2 4 L-16 7 L-16 4 L-2 -3 L-2 -8 Q-2 -14 0 -16 Z"></path>
			</g>
			<g data-vecs></g>
			<g transform="translate(222 22)">
				<path class="u-north" d="M0 -12 L4 2 L0 -1 L-4 2 Z"></path>
				<text class="u-small" x="0" y="15" text-anchor="middle">С</text>
			</g>
		</g>
	)}
	{kind === 'geo' && (
		<g>
			<rect class="u-space" x="0" y="0" width="240" height="180"></rect>
			{stars.map(([x, y]) => <circle class="u-star" cx={x} cy={y} r="1.1" />)}
			<circle class="u-orbit" cx="130" cy="90" r="75"></circle>
			<g data-spin>
				<circle class="u-earth" cx="130" cy="90" r="11.33"></circle>
				<path class="u-land2" d="M123 84 q4 -3 7 0 q2 4 -2 6 q-5 1 -5 -6 Z M134 92 q3 -1 4 2 q-2 3 -5 1 Z"></path>
				<g transform="translate(141.3 90)">
					<path class="u-dish" d="M0 0 L6 0 M6 -6 Q12 0 6 6"></path>
				</g>
				<path class="u-beam" d="M148 90 L196 90"></path>
				<g transform="translate(205 90) rotate(90)">
					<rect class="u-sat" x="-4" y="-4" width="8" height="8"></rect>
					<rect class="u-panel" x="-17" y="-3" width="11" height="6"></rect>
					<rect class="u-panel" x="6" y="-3" width="11" height="6"></rect>
				</g>
			</g>
			<circle class="u-pole" cx="130" cy="90" r="1.6"></circle>
			<text class="u-small" x="8" y="20">1 оборот</text>
			<text class="u-small" x="8" y="37">за сутки</text>
		</g>
	)}
</svg>
</div>

<style is:global>
	.usp10-wrap.g7 {
		margin: 0 0 0.6rem;
		padding: 0;
		border: 0;
		background: none;
	}
	.usp10 .u-num {
		font: 600 13px var(--__sl-font);
		font-variant-numeric: tabular-nums;
		fill: var(--sl-color-gray-1);
	}
	.usp10 .u-small {
		font: 13px var(--__sl-font);
		fill: var(--sl-color-gray-2);
	}
	.usp10 .u-lab {
		font: italic 700 15px var(--ig-font-math);
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 3.5px;
	}
	.usp10 .u-sky {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--g7-paper));
	}
	.usp10 .u-sat {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.usp10 .u-panel {
		fill: color-mix(in oklab, var(--ig-vx) 60%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.usp10 .u-signal {
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 2 4;
		opacity: 0.8;
	}
	.usp10 .u-phone {
		fill: var(--g7-ink);
	}
	.usp10 .u-cam {
		fill: var(--g7-paper);
	}
	.usp10 .u-map {
		fill: color-mix(in oklab, var(--so-light) 88%, var(--g7-gold));
	}
	.usp10 .u-park {
		fill: color-mix(in oklab, var(--g7-green) 45%, var(--so-light));
	}
	.usp10 .u-pond {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--so-light));
	}
	.usp10 .u-street {
		stroke: color-mix(in oklab, var(--so-light) 60%, var(--g7-line));
		stroke-width: 6;
		fill: none;
	}
	.usp10 .u-route {
		stroke: var(--g7-blue);
		stroke-width: 1.4;
		stroke-dasharray: 2 2;
		fill: none;
		opacity: 0.7;
	}
	.usp10 .u-dot {
		fill: var(--g7-blue);
		stroke: var(--so-light);
		stroke-width: 1.2;
	}
	.usp10 .u-halo {
		fill: color-mix(in oklab, var(--g7-blue) 30%, transparent);
	}
	.usp10 .u-land {
		fill: color-mix(in oklab, var(--g7-green) 26%, var(--g7-paper));
	}
	.usp10 .u-fields {
		stroke: color-mix(in oklab, var(--g7-green) 50%, var(--g7-paper));
		stroke-width: 1.2;
		fill: none;
	}
	.usp10 .u-river {
		stroke: color-mix(in oklab, var(--ig-vx) 60%, var(--g7-paper));
		stroke-width: 4;
		fill: none;
	}
	.usp10 .u-cloud {
		fill: color-mix(in oklab, var(--so-light) 75%, transparent);
	}
	.usp10 .u-heading {
		stroke: var(--g7-blue);
		stroke-width: 1;
		stroke-dasharray: 2 3;
		fill: none;
	}
	.usp10 .u-plane {
		fill: var(--so-light);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.usp10 .u-north {
		fill: var(--g7-ink);
	}
	.usp10 .u-space {
		fill: color-mix(in oklab, var(--so-dark) 85%, var(--ig-vx));
	}
	.usp10 .u-star {
		fill: var(--so-light);
		opacity: 0.8;
	}
	.usp10 .u-orbit {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-dasharray: 4 4;
		stroke-width: 1;
	}
	.usp10 .u-earth {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--so-dark));
		stroke: var(--so-light);
		stroke-width: 0.6;
	}
	.usp10 .u-land2 {
		fill: color-mix(in oklab, var(--g7-green) 80%, var(--so-dark));
	}
	.usp10 .u-dish {
		stroke: var(--so-light);
		stroke-width: 1.6;
		fill: none;
	}
	.usp10 .u-beam {
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.usp10 .u-pole {
		fill: var(--so-light);
	}
	[data-usp10='geo'] .u-small {
		fill: var(--so-light);
	}
</style>

<script>
	import { loop, el } from '../g7/kit';
	import { arrow } from './so';

	const f = (v: number) => v.toFixed(1);
	for (const svg of document.querySelectorAll<SVGSVGElement>('[data-usp10]')) {
		const kind = svg.dataset.usp10;
		const q = <T extends Element>(s: string) => svg.querySelector<T>(s)!;
		let t = 0;
		if (kind === 'gps') {
			const dot = q<SVGCircleElement>('[data-gpsdot]');
			const dot2 = q<SVGCircleElement>('[data-gpsdot2]');
			const lat = q<SVGTextElement>('[data-lat]');
			const lon = q<SVGTextElement>('[data-lon]');
			const RUN = 12;
			const deg = (v: number) => v.toFixed(5).replace('.', ',');
			loop(svg, (dt) => {
				t = (t + dt) % (RUN + 2);
				const d = 4 * Math.min(t, RUN); // м along the route
				const n = Math.min(d, 24);
				const e = Math.max(0, d - 24);
				for (const c of [dot, dot2]) {
					c.setAttribute('cx', f(14 + e));
					c.setAttribute('cy', f(92 - n));
				}
				dot.setAttribute('r', f(5 + 2 * Math.sin(t * 4)));
				lat.textContent = `${deg(55.7539 + n / 111195)}° с. ш.`;
				lon.textContent = `${deg(37.6208 + e / 62569)}° в. д.`;
				return true;
			});
		} else if (kind === 'drift') {
			const plane = q<SVGGElement>('[data-plane]');
			const track = q<SVGPathElement>('[data-track]');
			const heading = q<SVGPathElement>('[data-heading]');
			const vecs = q<SVGGElement>('[data-vecs]');
			const cloudsG = q<SVGGElement>('[data-clouds]');
			const KV = 0.3;
			const tg = 50 / 200;
			const RUN = 8;
			const y0 = 166;
			const y1 = 86;
			const x0 = 86;
			const vy = (y0 - y1) / RUN; // px per second northward
			track.setAttribute('d', `M${f(x0 - tg * (190 - y0))} 190 L${f(x0 + tg * y0)} 0`);
			const clouds = [
				[20, 30],
				[140, 70],
				[60, 120],
				[190, 150],
				[100, 10],
			].map(([x, y]) => {
				const c = el('path', { class: 'u-cloud', d: 'M-14 4 Q-16 -4 -8 -5 Q-6 -12 2 -10 Q8 -14 12 -6 Q18 -4 16 4 Z' });
				cloudsG.append(c);
				return { c, x, y };
			});
			const lab = (x: number, y: number, color: string, sub: string) => {
				const t = el('text', { class: `u-lab t-${color}`, x: f(x), y: f(y), 'text-anchor': 'middle' });
				t.append(el('tspan', {}, 'υ⃗'));
				if (sub) t.append(el('tspan', { dy: 4, 'font-size': '75%' }, sub));
				return t;
			};
			loop(svg, (dt) => {
				t = (t + dt) % (RUN + 1.5);
				// the plane and its arrows fade out at the end of the pause and in at the start: no jump back
				const op = String(t < 0.3 ? t / 0.3 : t > RUN + 1 ? Math.max(0, (RUN + 1.5 - t) / 0.5) : 1);
				plane.style.opacity = op;
				vecs.style.opacity = op;
				heading.style.opacity = op;
				const tt = Math.min(t, RUN);
				const py = y0 - vy * tt;
				const px = x0 + tg * vy * tt;
				plane.setAttribute('transform', `translate(${f(px)} ${f(py)})`);
				heading.setAttribute('d', `M${f(px)} ${f(py)} V${f(py - 200 * KV - 6)}`);
				for (const k of clouds) {
					const x = ((k.x + tg * vy * t + 20) % 280) - 20;
					k.c.setAttribute('transform', `translate(${f(x)} ${k.y})`);
				}
				vecs.replaceChildren();
				const a1 = arrow(px, py, px, py - 200 * KV, 8, 4);
				const a2 = arrow(px, py - 200 * KV, px + 50 * KV, py - 200 * KV, 6, 3.5);
				const a = arrow(px, py, px + 50 * KV, py - 200 * KV, 8, 4);
				for (const [ar, c] of [
					[a1, 'blue'],
					[a2, 'green'],
					[a, 'red'],
				] as const) {
					vecs.append(el('path', { class: `arrow arrow--${c}`, d: ar.line, style: 'stroke-width:2.2' }), el('path', { class: `head--${c}`, d: ar.head }));
				}
				vecs.append(lab(px - 14, py - 34, 'blue', '1'), lab(px + 8, py - 200 * KV - 10, 'green', '2'), lab(px + 22, py - 30, 'red', ''));
				return true;
			});
		} else if (kind === 'geo') {
			const spin = q<SVGGElement>('[data-spin]');
			loop(svg, (dt) => {
				t = (t + dt) % 8;
				spin.setAttribute('transform', `rotate(${f((-360 * t) / 8)} 130 90)`);
				return true;
			});
		}
	}
</script>
