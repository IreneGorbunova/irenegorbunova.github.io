---
/**
 * Picture for «Перемещение и его проекции»: the projections of a vector through its angle with the axis Ox.
 * A displacement s⃗ of 5 м (gold) starts at the origin O and turns counterclockwise through a full circle: one turn in
 * 24 s, it stands 1,5 s at every 30° and turns to the next angle in 0,5 s (eased). Shown: the angle α from Ox (arc),
 * the dashed drops from the tip to both axes, the projections s_x (blue, on Ox) and s_y (red, on Oy) as thick
 * segments, the circle of radius 5 м (dashed gray) and the signs of the projections in the four quarters, the current
 * quarter lit. Readouts under the picture: α, s_x = s cos α, s_y = s sin α with their signs (two decimals, trailing
 * zeros dropped): 0°: 5; 0 — 30°: 4,33; 2,5 — 60°: 2,5; 4,33 — 90°: 0; 5 — 120°: −2,5; 4,33 — 150°: −4,33; 2,5 —
 * 180°: −5; 0 — 210°: −4,33; −2,5 — 240°: −2,5; −4,33 — 270°: 0; −5 — 300°: 2,5; −4,33 — 330°: 4,33; −2,5.
 * Scale 22 px per metre on both axes. Nothing is exaggerated; the turning is slowed for the picture.
 */
import SoStyles from './SoStyles.astro';
const OX = 180;
const OY = 152;
const K = 22;
const ticks = [-6, -5, -4, -3, -2, -1, 1, 2, 3, 4, 5, 6];
const quads = [
	{ x: 300, y: 34, t: '(+; +)', q: 0 },
	{ x: 60, y: 34, t: '(−; +)', q: 1 },
	{ x: 60, y: 282, t: '(−; −)', q: 2 },
	{ x: 300, y: 282, t: '(+; −)', q: 3 },
];
---

<SoStyles />
<figure class="g7 g7--pic g7--narrow som not-content" data-projangle>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Вектор перемещения длиной 5 метров поворачивается вокруг начала координат. Его проекции на оси x и y меняют величину и знак">
			<circle class="som-plan" cx={OX} cy={OY} r={5 * K}></circle>
			{quads.map((q) => <text class="pa-quad t-num" data-q={q.q} x={q.x} y={q.y} text-anchor="middle">{q.t}</text>)}
			<path class="som-axis" d={`M${OX - 152} ${OY} H${OX + 150} M${OX} ${OY + 136} V${OY - 140}`}></path>
			<path class="head--ink" d={`M${OX + 156} ${OY} l-9 -4.5 v9 Z`}></path>
			<path class="head--ink" d={`M${OX} ${OY - 146} l-4.5 9 h9 Z`}></path>
			{ticks.map((m) => <path class="ln" d={`M${OX + m * K} ${OY - 3} V${OY + 3} M${OX - 3} ${OY - m * K} H${OX + 3}`} />)}
			<text class="t-small t-num" x={OX + 5 * K} y={OY + 15} text-anchor="middle">5</text>
			<text class="t-small t-num" x={OX - 5 * K} y={OY + 15} text-anchor="middle">−5</text>
			<text class="t-small t-num" x={OX - 7} y={OY - 5 * K + 4} text-anchor="end">5</text>
			<text class="t-small t-num" x={OX - 7} y={OY + 5 * K + 4} text-anchor="end">−5</text>
			<text class="t-small" x={OX - 7} y={OY + 15} text-anchor="end">O</text>
			<text x={OX + 152} y={OY + 18} text-anchor="end"><tspan class="t-math">x</tspan>, м</text>
			<text x={OX + 10} y={OY - 136}><tspan class="t-math">y</tspan>, м</text>
			<path class="som-drop" data-drops d=""></path>
			<line class="som-px" data-px x1={OX} y1={OY} x2={OX} y2={OY}></line>
			<line class="som-py" data-py x1={OX} y1={OY} x2={OX} y2={OY}></line>
			<path class="pa-arc" data-arc d=""></path>
			<text class="t-math pa-alpha" data-al x="0" y="0" text-anchor="middle">α</text>
			<path class="arrow arrow--gold" data-s d=""></path>
			<path class="head--gold" data-sh d=""></path>
			<g data-slab>
				<text class="t-math t-gold t-halo pa-big" x="0" y="0" text-anchor="middle">s</text>
				<path class="pa-vec" d="M-4 -13 H4 M1.5 -15.5 L4 -13 L1.5 -10.5"></path>
			</g>
			<text class="t-strong t-num t-halo t-blue" data-sxl x="0" y="0" text-anchor="middle"></text>
			<text class="t-strong t-num t-halo t-red" data-syl x="0" y="0"></text>
			<circle class="pa-o" cx={OX} cy={OY} r="3"></circle>
		</svg>
		<ul class="som-read" data-read>
			<li>α = <b data-ra>0°</b></li>
			<li class="is-blue"><i>s<sub>x</sub></i> = <i>s</i> cos α = <b data-rx>5 м</b></li>
			<li class="is-red"><i>s<sub>y</sub></i> = <i>s</i> sin α = <b data-ry>0</b></li>
		</ul>
	</div>
	<figcaption class="g7__caption">
		Перемещение <i>s</i> = 5&nbsp;м поворачивается вокруг начала координат и останавливается через каждые 30°. Синий отрезок — проекция на ось <i>Ox</i>, красный — на ось <i>Oy</i>; в углах написаны знаки проекций в каждой четверти. Поворот замедлен.
	</figcaption>
</figure>

<style is:global>
	[data-projangle] .pa-quad {
		font-size: 13px;
		font-weight: 600;
		fill: var(--g7-line);
		transition: fill 0.3s;
	}
	[data-projangle] .pa-quad.is-on {
		fill: var(--g7-gold);
	}
	[data-projangle] .pa-arc {
		fill: color-mix(in oklab, var(--g7-gold) 18%, transparent);
		stroke: var(--g7-gold);
		stroke-width: 1.2;
	}
	[data-projangle] .pa-alpha {
		font-size: 15px;
		fill: var(--g7-ink);
	}
	[data-projangle] .pa-big {
		font-size: 17px;
	}
	[data-projangle] .pa-vec {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-projangle] .pa-o {
		fill: var(--g7-ink);
	}
	@media (max-width: 40rem) {
		[data-projangle] .pa-quad {
			font-size: 13.5px;
		}
	}
</style>

<script>
	import { loop, ease, el } from '../g7/kit';
	import { arrow, ruTrim } from './so';

	const OX = 180;
	const OY = 152;
	const K = 22;
	const S = 5;
	const STOP = 1.5;
	const TURN = 0.5;
	const STEP = STOP + TURN;

	/** «s» with a subscript and the rest of the label, as tspans (empty `i` clears the label). */
	const sub = (t: SVGTextElement, i: string, rest: string) => {
		t.replaceChildren();
		if (!i) return;
		t.append(el('tspan', { class: 't-math' }, 's'), el('tspan', { class: 't-math', dy: 4, 'font-size': '75%' }, i), el('tspan', { dy: -4 }, rest));
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-projangle]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const drops = q<SVGPathElement>('[data-drops]');
		const px = q<SVGLineElement>('[data-px]');
		const py = q<SVGLineElement>('[data-py]');
		const arc = q<SVGPathElement>('[data-arc]');
		const al = q<SVGTextElement>('[data-al]');
		const s = q<SVGPathElement>('[data-s]');
		const sh = q<SVGPathElement>('[data-sh]');
		const slab = q<SVGGElement>('[data-slab]');
		const sxl = q<SVGTextElement>('[data-sxl]');
		const syl = q<SVGTextElement>('[data-syl]');
		const ra = q<HTMLElement>('[data-ra]');
		const rx = q<HTMLElement>('[data-rx]');
		const ry = q<HTMLElement>('[data-ry]');
		const quads = [...root.querySelectorAll<SVGTextElement>('[data-q]')];
		let time = 0;
		const draw = () => {
			const k = Math.floor(time / STEP);
			const u = time - k * STEP;
			const deg = 30 * k + (u < STOP ? 0 : 30 * ease((u - STOP) / TURN));
			const a = (deg * Math.PI) / 180;
			const sx = S * Math.cos(a);
			const sy = S * Math.sin(a);
			const tx = OX + sx * K;
			const ty = OY - sy * K;
			const ar = arrow(OX, OY, tx, ty, 11, 5.5);
			s.setAttribute('d', ar.line);
			sh.setAttribute('d', ar.head);
			drops.setAttribute('d', `M${tx.toFixed(1)} ${ty.toFixed(1)} V${OY} M${tx.toFixed(1)} ${ty.toFixed(1)} H${OX}`);
			px.setAttribute('x2', tx.toFixed(1));
			py.setAttribute('y2', ty.toFixed(1));
			// the arc of the angle
			const r = 24;
			const ex = OX + r * Math.cos(a);
			const ey = OY - r * Math.sin(a);
			arc.setAttribute('d', deg < 0.5 ? '' : `M${OX} ${OY} L${OX + r} ${OY} A${r} ${r} 0 ${deg > 180 ? 1 : 0} 0 ${ex.toFixed(1)} ${ey.toFixed(1)} Z`);
			const am = a / 2;
			al.setAttribute('x', (OX + 36 * Math.cos(am)).toFixed(1));
			al.setAttribute('y', (OY - 36 * Math.sin(am) + 5).toFixed(1));
			al.style.opacity = deg < 12 ? '0' : '1';
			// the label of s, beyond the tip
			slab.setAttribute('transform', `translate(${(OX + (S + 0.75) * K * Math.cos(a)).toFixed(1)} ${(OY - (S + 0.75) * K * Math.sin(a) + 6).toFixed(1)})`);
			// the labels of the projections: s_x under (or over) the axis, s_y beside the axis
			const shown = u < STOP;
			const vx = ruTrim(sx, 2);
			const vy = ruTrim(sy, 2);
			sub(sxl, shown ? 'x' : '', Math.abs(sx) < 0.005 ? ' = 0' : ` = ${vx} м`);
			sxl.setAttribute('x', (OX + (sx * K) / 2).toFixed(1));
			sxl.setAttribute('y', String(sy >= -0.01 ? OY + 20 : OY - 9));
			if (Math.abs(sx) < 0.01) sxl.setAttribute('x', String(OX + (sy > 0 ? 34 : 34)));
			sub(syl, shown ? 'y' : '', Math.abs(sy) < 0.005 ? ' = 0' : ` = ${vy} м`);
			const right = sx < -0.01;
			syl.setAttribute('text-anchor', right ? 'start' : 'end');
			syl.setAttribute('x', String(right ? OX + 8 : OX - 8));
			syl.setAttribute('y', (OY - (sy * K) / 2 + 4).toFixed(1));
			if (Math.abs(sy) < 0.01) syl.setAttribute('y', String(sx > 0 ? OY - 26 : OY - 26));
			// readouts
			ra.textContent = `${Math.round(deg)}°`;
			rx.textContent = Math.abs(sx) < 0.005 ? '0' : `${vx} м`;
			ry.textContent = Math.abs(sy) < 0.005 ? '0' : `${vy} м`;
			const quad = Math.abs(sx) < 0.01 || Math.abs(sy) < 0.01 ? -1 : sx > 0 ? (sy > 0 ? 0 : 3) : sy > 0 ? 1 : 2;
			quads.forEach((t, i) => t.classList.toggle('is-on', i === quad));
		};
		loop(root, (dt) => {
			time = (time + dt) % (12 * STEP);
			draw();
			return true;
		});
		draw();
	}
</script>
