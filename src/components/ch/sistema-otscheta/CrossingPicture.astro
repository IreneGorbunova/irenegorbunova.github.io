---
/**
 * Picture for «Скорость одного тела относительно другого»: two cars near a crossroads, top view, seen from the ground or
 * from car A (two buttons). Axes: x east, y north, the crossing at (0; 0).
 * Car A drives east at υ₂ = 20 м/с from (−120; 0) м; car B drives north at υ = 15 м/с from (0; −60) м. B passes the
 * crossing at t = 4 с, A at t = 6 с: they do not meet.
 * «С земли»: both move along their roads; A carries υ⃗₂ (green), B carries υ⃗ (red).
 * «Из машины A»: A stands in its place on the screen; the roads, the houses and the trees run west at 20 м/с. B moves
 * along a straight slanted line (dashed gray, drawn in advance) with υ⃗₁ = υ⃗ − υ⃗₂: the triangle at B shows υ⃗ (red),
 * −υ⃗₂ (green, dashed) and their sum υ⃗₁ (blue), |υ₁| = √(20² + 15²) = 25 м/с, 143° from the east (north-west).
 * B relative to A: (120 − 20t; −60 + 15t) м; the distance is least, 24 м, at t = 3300/625 = 5,28 с (relative
 * position (14,4; 19,2) м): from that moment a dashed segment from A to the line and the label «24 м» stay. The readout
 * gives t and the distance AB.
 * Scale 1,5 px per metre (the drawing holds both roads for the 8 с), arrows 2 px per м/с. The cars (4,5 м) are drawn
 * twice as large (the caption says so). Real time: 8 s of motion (B ends 60 м north of the crossing, 90 px under the
 * top edge, so its 30 px arrow and labels stay inside), then the end frame for 2 s.
 */
import SoStyles from './SoStyles.astro';
---

<SoStyles />
<figure class="g7 g7--pic g7--narrow som not-content" data-crossing>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Два автомобиля у перекрёстка, вид сверху. Автомобиль A едет на восток, автомобиль B — на север. Движение можно смотреть с земли или из автомобиля A">
			<rect class="cr-ground" x="0" y="0" width="360" height="250"></rect>
			<g data-world>
				<g data-blocks></g>
				<rect class="cr-road" data-roadx x="-10" y="0" width="380" height="16"></rect>
				<path class="cr-dash" data-dashx d=""></path>
				<rect class="cr-road" data-roady x="0" y="-10" width="16" height="270"></rect>
				<path class="cr-dash" data-dashy d=""></path>
			</g>
			<path class="som-plan" data-rel d=""></path>
			<path class="cr-min" data-min d=""></path>
			<text class="t-strong t-num t-halo" data-minlab text-anchor="middle"></text>
			<g data-cara><rect class="cr-car cr-car--a" x="-6.75" y="-3" width="13.5" height="6" rx="1.6"></rect><path class="cr-glass" d="M1.6 -2.2 H4 V2.2 H1.6 Z"></path></g>
			<g data-carb><rect class="cr-car cr-car--b" x="-6.75" y="-3" width="13.5" height="6" rx="1.6"></rect><path class="cr-glass" d="M1.6 -2.2 H4 V2.2 H1.6 Z"></path></g>
			<text class="t-strong t-halo" data-la>A</text>
			<text class="t-strong t-halo" data-lb>B</text>
			<g data-vecs></g>
			<g transform="translate(338 26)">
				<path class="cr-north" d="M0 -12 L4 2 L0 -1 L-4 2 Z"></path>
				<text class="t-small" x="0" y="15" text-anchor="middle">С</text>
			</g>
		</svg>
		<div class="g7__row">
			<span class="g7__seg" data-view><button type="button" class="g7__btn" aria-pressed="true" data-v="0">С земли</button><button type="button" class="g7__btn" aria-pressed="false" data-v="1">Из автомобиля A</button></span>
		</div>
		<ul class="som-read">
			<li><i>t</i> = <b data-rt>0,0 с</b></li>
			<li>расстояние AB = <b data-rd></b></li>
		</ul>
	</div>
	<figcaption class="g7__caption">
		Автомобиль A едет на восток со скоростью 20&nbsp;м/с, автомобиль B — на север со скоростью 15&nbsp;м/с. Из автомобиля A видно, что B движется по наклонной прямой. Дороги и перемещения в одном масштабе, автомобили нарисованы вдвое крупнее; время настоящее.
	</figcaption>
</figure>

<style is:global>
	[data-crossing] .cr-ground {
		fill: color-mix(in oklab, var(--g7-green) 16%, var(--g7-paper));
	}
	[data-crossing] .cr-road {
		fill: color-mix(in oklab, var(--sl-color-gray-4) 70%, var(--g7-paper));
	}
	[data-crossing] .cr-dash {
		fill: none;
		stroke: var(--so-light);
		stroke-width: 1;
		stroke-dasharray: 6 6;
		opacity: 0.8;
	}
	[data-crossing] .cr-house {
		fill: color-mix(in oklab, var(--g7-wood) 55%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	[data-crossing] .cr-roof {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.7;
	}
	[data-crossing] .cr-tree {
		fill: color-mix(in oklab, var(--g7-green) 55%, var(--g7-paper));
		stroke: color-mix(in oklab, var(--g7-green) 60%, var(--g7-ink));
		stroke-width: 0.7;
	}
	[data-crossing] .cr-car {
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	[data-crossing] .cr-car--a {
		fill: var(--g7-green);
	}
	[data-crossing] .cr-car--b {
		fill: var(--g7-red);
	}
	[data-crossing] .cr-glass {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--g7-paper));
	}
	[data-crossing] .cr-min {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		stroke-dasharray: 3 3;
		fill: none;
	}
	[data-crossing] .cr-north {
		fill: var(--g7-ink);
	}
</style>

<script>
	import { loop, el, segment } from '../g7/kit';
	import { arrow, ru } from './so';

	const K = 1.5; // px per metre
	const KV = 2; // px per м/с
	const RUN = 8;
	const HOLD = 2;
	const VA = 20;
	const VB = 15;
	const TMIN = 3300 / 625;
	const posA = (t: number) => ({ x: -120 + VA * t, y: 0 });
	const posB = (t: number) => ({ x: 0, y: -60 + VB * t });
	const f = (v: number) => v.toFixed(1);
	// houses and trees in the four corners, repeated every 60 м along the east–west road
	const BLOCKS: { x: number; y: number; w: number; h: number; tree?: boolean }[] = [];
	for (let i = -6; i <= 8; i++) {
		const x0 = i * 60;
		BLOCKS.push({ x: x0 + 12, y: 14, w: 26, h: 18 }, { x: x0 + 14, y: -40, w: 22, h: 16 }, { x: x0 + 46, y: 22, w: 0, h: 0, tree: true }, { x: x0 + 48, y: -20, w: 0, h: 0, tree: true });
		BLOCKS.push({ x: x0 + 10, y: 52, w: 30, h: 20 }, { x: x0 + 16, y: -80, w: 24, h: 18 }, { x: x0 + 44, y: 64, w: 0, h: 0, tree: true }, { x: x0 + 40, y: -64, w: 0, h: 0, tree: true });
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-crossing]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const blocks = q<SVGGElement>('[data-blocks]');
		const roadx = q<SVGRectElement>('[data-roadx]');
		const roady = q<SVGRectElement>('[data-roady]');
		const dashx = q<SVGPathElement>('[data-dashx]');
		const dashy = q<SVGPathElement>('[data-dashy]');
		const rel = q<SVGPathElement>('[data-rel]');
		const min = q<SVGPathElement>('[data-min]');
		const minlab = q<SVGTextElement>('[data-minlab]');
		const carA = q<SVGGElement>('[data-cara]');
		const carB = q<SVGGElement>('[data-carb]');
		const la = q<SVGTextElement>('[data-la]');
		const lb = q<SVGTextElement>('[data-lb]');
		const vecs = q<SVGGElement>('[data-vecs]');
		const rt = q<HTMLElement>('[data-rt]');
		const rd = q<HTMLElement>('[data-rd]');
		const houses = BLOCKS.map((b) => {
			const g = el('g');
			if (b.tree) g.append(el('circle', { class: 'cr-tree', r: 7 }));
			else {
				g.append(el('rect', { class: 'cr-house', x: 0, y: -b.h * K, width: b.w * K, height: b.h * K, rx: 1 }));
				g.append(el('path', { class: 'cr-roof', d: `M0 ${-b.h * K} L${(b.w * K) / 2} ${(-b.h * K) / 2} L${b.w * K} ${-b.h * K} M0 0 L${(b.w * K) / 2} ${(-b.h * K) / 2} L${b.w * K} 0` }));
			}
			blocks.append(g);
			return { g, b };
		});
		let view = 0;
		let run = 0;
		// a vector with its label (label: [main letter, subscript or '', prefix like '−'], color)
		const vec = (x0: number, y0: number, vx: number, vy: number, color: string, label: string[], dash = false, lx = 0, ly = 0) => {
			const a = arrow(x0, y0, x0 + vx * KV, y0 - vy * KV, 8, 4);
			vecs.append(el('path', { class: `arrow arrow--${color}${dash ? ' arrow--dash' : ''}`, d: a.line, style: 'stroke-width:2.4' }));
			vecs.append(el('path', { class: `head--${color}`, d: a.head }));
			const t = el('text', { class: `t-strong t-halo t-num t-${color}`, x: f(x0 + vx * KV + lx), y: f(y0 - vy * KV + ly), 'text-anchor': 'middle' });
			t.append(el('tspan', {}, label[2] ?? ''), el('tspan', { class: 't-math' }, label[0] + '\u20d7'));
			if (label[1]) t.append(el('tspan', { dy: 4, 'font-size': '75%' }, label[1]), el('tspan', { dy: -4 }, ''));
			vecs.append(t);
		};
		const draw = () => {
			const t = Math.min(run, RUN);
			const A = posA(t);
			const B = posB(t);
			// the screen point of a world point in the chosen view
			const C = view ? { x: 150 - K * A.x, y: 152 } : { x: 225, y: 140 };
			const S = (p: { x: number; y: number }) => ({ x: C.x + K * p.x, y: C.y - K * p.y });
			const o = S({ x: 0, y: 0 });
			roadx.setAttribute('y', f(o.y - 8));
			roady.setAttribute('x', f(o.x - 8));
			dashx.setAttribute('d', `M-20 ${f(o.y)} H380`);
			dashy.setAttribute('d', `M${f(o.x)} -20 V270`);
			for (const { g, b } of houses) {
				const p = S(b);
				g.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)})`);
			}
			const a = S(A);
			const bpt = S(B);
			carA.setAttribute('transform', `translate(${f(a.x)} ${f(a.y)})`);
			carB.setAttribute('transform', `translate(${f(bpt.x)} ${f(bpt.y)}) rotate(-90)`);
			la.setAttribute('x', f(a.x - 4));
			la.setAttribute('y', f(a.y + 20));
			lb.setAttribute('x', f(bpt.x + 9));
			lb.setAttribute('y', f(bpt.y + 4));
			vecs.replaceChildren();
			if (!view) {
				rel.setAttribute('d', '');
				min.setAttribute('d', '');
				minlab.textContent = '';
				vec(a.x + 8, a.y, VA, 0, 'green', ['υ', '2'], false, 2, -8);
				vec(bpt.x, bpt.y - 8, 0, VB, 'red', ['υ', ''], false, 10, 4);
			} else {
				const r0 = S({ x: A.x + 120, y: -60 });
				const r1 = S({ x: A.x - 40, y: 60 });
				rel.setAttribute('d', `M${f(r0.x)} ${f(r0.y)} L${f(r1.x)} ${f(r1.y)}`);
				if (t >= TMIN) {
					const m = S({ x: A.x + 14.4, y: 19.2 });
					min.setAttribute('d', `M${f(a.x)} ${f(a.y)} L${f(m.x)} ${f(m.y)}`);
					minlab.setAttribute('x', f((a.x + m.x) / 2 + 14));
					minlab.setAttribute('y', f((a.y + m.y) / 2 + 8));
					minlab.textContent = '24 м';
				} else {
					min.setAttribute('d', '');
					minlab.textContent = '';
				}
				vec(bpt.x, bpt.y, 0, VB, 'red', ['υ', ''], false, 9, 6);
				vec(bpt.x, bpt.y - VB * KV, -VA, 0, 'green', ['υ', '2', '−'], true, -4, -8);
				vec(bpt.x, bpt.y, -VA, VB, 'blue', ['υ', '1'], false, -14, 10);
			}
			rt.textContent = `${ru(t, 1)} с`;
			rd.textContent = `${Math.round(Math.hypot(B.x - A.x, B.y - A.y))} м`;
		};
		segment(q('[data-view]'), (b) => {
			view = +b.dataset.v!;
			run = 0;
			draw();
		});
		loop(root, (dt) => {
			run += dt;
			if (run > RUN + HOLD) run = 0;
			draw();
			return true;
		});
		draw();
	}
</script>
