---
/**
 * Picture for «Поступательное движение»: a Ferris wheel. The wheel (radius 90 px) turns; its eight cabins hang from
 * pivots on the rim and stay upright, so each cabin moves translationally: two marked points of the gold cabin (a
 * corner of the roof and a corner of the floor) run along two equal circles of the wheel's radius, shifted by the
 * distance between the points (dashed). One spoke is drawn in red: it turns with the wheel, so the wheel's motion is
 * not translational. A real wheel turns once in 5–30 minutes; here once in 20 s.
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 180;
const CY = 112;
const R = 90;
const N = 8;
// the cabin below its pivot (px): 24 × 20, hanging 5 px under the pivot
const CAB = { w: 24, h: 20, drop: 5 };
const P1 = { x: -CAB.w / 2 + 2, y: CAB.drop + 2 }; // the roof corner, relative to the pivot
const P2 = { x: CAB.w / 2 - 2, y: CAB.drop + CAB.h - 2 }; // the floor corner
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-fwheel>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Колесо обозрения вращается, а его кабины остаются вертикальными. Две точки одной кабины описывают одинаковые окружности">
			<rect class="fw-ground" x="0" y="232" width="360" height="18"></rect>
			<path class="fw-leg" d={`M${CX} ${CY} L${CX - 52} 232 M${CX} ${CY} L${CX + 52} 232`}></path>
			<circle class="fw-path" cx={CX + P1.x} cy={CY + P1.y} r={R}></circle>
			<circle class="fw-path" cx={CX + P2.x} cy={CY + P2.y} r={R}></circle>
			<g data-rot>
				<circle class="fw-rim" cx={CX} cy={CY} r={R}></circle>
				<circle class="fw-rim fw-rim--in" cx={CX} cy={CY} r={R - 8}></circle>
				{Array.from({ length: N }, (_, i) => {
					const a = (i * 2 * Math.PI) / N;
					return <line class={i === 0 ? 'fw-spoke fw-spoke--red' : 'fw-spoke'} x1={CX} y1={CY} x2={(CX + R * Math.cos(a)).toFixed(1)} y2={(CY + R * Math.sin(a)).toFixed(1)} />;
				})}
			</g>
			<circle class="fw-hub" cx={CX} cy={CY} r="6"></circle>
			{Array.from({ length: N }, (_, i) => (
				<g data-cab={i} class={i === 2 ? 'fw-cab fw-cab--gold' : 'fw-cab'}>
					<line class="fw-hang" x1="0" y1="0" x2="0" y2={CAB.drop}></line>
					<rect class="fw-box" x={-CAB.w / 2} y={CAB.drop} width={CAB.w} height={CAB.h} rx="4"></rect>
					<rect class="fw-win" x={-CAB.w / 2 + 3} y={CAB.drop + 3} width={CAB.w - 6} height="8" rx="1.5"></rect>
					{i === 2 && <circle class="fw-mark" cx={P1.x} cy={P1.y} r="2.6" />}
					{i === 2 && <circle class="fw-mark" cx={P2.x} cy={P2.y} r="2.6" />}
				</g>
			))}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Кабины колеса обозрения всё время остаются вертикальными: каждая движется поступательно, и две отмеченные точки
		кабины описывают одинаковые окружности (пунктир). Само колесо вращается: красная спица поворачивается вместе с ним.
		Настоящее колесо делает оборот за 5–30 минут, здесь — за 20 секунд.
	</figcaption>
</figure>

<style is:global>
	[data-fwheel] .fw-ground {
		fill: var(--g7-ground);
	}
	[data-fwheel] .fw-leg {
		stroke: var(--g7-line);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-fwheel] .fw-rim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	[data-fwheel] .fw-rim--in {
		stroke-width: 1;
		stroke: var(--g7-line);
	}
	[data-fwheel] .fw-spoke {
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	[data-fwheel] .fw-spoke--red {
		stroke: var(--g7-red);
		stroke-width: 3;
	}
	[data-fwheel] .fw-hub {
		fill: var(--g7-ink);
	}
	[data-fwheel] .fw-path {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.2;
		stroke-dasharray: 4 4;
	}
	[data-fwheel] .fw-hang {
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	[data-fwheel] .fw-box {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	[data-fwheel] .fw-cab--gold .fw-box {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-5));
	}
	[data-fwheel] .fw-win {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--g7-paper));
	}
	[data-fwheel] .fw-mark {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const CX = 180;
	const CY = 112;
	const R = 90;
	const N = 8;
	const PERIOD = 20; // s for one turn

	for (const root of document.querySelectorAll<HTMLElement>('[data-fwheel]')) {
		const rot = root.querySelector<SVGGElement>('[data-rot]')!;
		const cabs = [...root.querySelectorAll<SVGGElement>('[data-cab]')];
		let t = 0;
		const show = () => {
			const phi = (2 * Math.PI * t) / PERIOD; // clockwise on the screen
			rot.setAttribute('transform', `rotate(${((phi * 180) / Math.PI).toFixed(2)} ${CX} ${CY})`);
			cabs.forEach((c, i) => {
				const a = phi + (i * 2 * Math.PI) / N;
				c.setAttribute('transform', `translate(${(CX + R * Math.cos(a)).toFixed(2)} ${(CY + R * Math.sin(a)).toFixed(2)})`);
			});
		};
		loop(root, (dt) => {
			t = (t + dt) % PERIOD;
			show();
			return true;
		});
		show();
	}
</script>
