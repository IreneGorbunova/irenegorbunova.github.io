---
/**
 * Picture for «Система отсчёта»: a bus stop is the body of reference; the axis Ox goes along the road from the stop,
 * 8 px per metre, from −5 to 35 м; a stopwatch counts the time from the moment the car passes x = −5 м. The shelter
 * (3 × 2,4 м) and the pole with its sign (3 м) are drawn to the same scale. The car
 * (4,5 м long, 1,5 м high, drawn to scale: 36 × 12 px) drives at 8 м/с, in real time: 5 s from −5 м to 35 м, then the last frame
 * stays 2 s. The position of the car is the coordinate of its center (a dot dropped to the axis).
 */
import G7Styles from '../g7/G7Styles.astro';

const X0 = 56; // x = 0, px
const K = 8; // px per metre
const ROAD = 104;
const AX = 132;
const ticks = Array.from({ length: 9 }, (_, i) => -5 + i * 5);
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-frame10>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 170" role="img" aria-label="Остановка — тело отсчёта, от неё вдоль дороги направлена ось Ox, рядом часы. Автомобиль едет, его координата меняется">
			<rect class="fr-ground" x="0" y={ROAD} width="360" height="8"></rect>
			<!-- the bus stop: a pole with a sign and a shelter -->
			<path class="fr-shelter" d={`M${X0 - 28} ${ROAD} V${ROAD - 19} H${X0 - 4} V${ROAD}`}></path>
			<path class="fr-roof" d={`M${X0 - 30} ${ROAD - 20} H${X0 - 2}`}></path>
			<line class="fr-pole" x1={X0} y1={ROAD} x2={X0} y2={ROAD - 24}></line>
			<rect class="fr-sign" x={X0 - 3} y={ROAD - 29} width="6" height="6" rx="1"></rect>
			<path class="fr-callout" d={`M${X0 - 6} ${ROAD - 32} L${X0 - 14} ${ROAD - 48}`}></path>
			<text class="t-small" x={X0 - 40} y={ROAD - 53}>тело отсчёта</text>
			<!-- the car -->
			<g data-car>
				<path class="fr-car" d="M-18 -2.6 V-6.6 Q-17 -8.2 -12 -8.4 L-7 -12 H5.5 L11 -8.4 Q17.4 -8 18 -6 V-2.6 Z"></path>
				<path class="fr-win" d="M-6.2 -11.2 H-1 V-8.6 H-10 Z M1 -11.2 H5 L8.6 -8.6 H1 Z"></path>
				<circle class="fr-wheel" cx="-10.5" cy="-2.6" r="2.6"></circle>
				<circle class="fr-wheel" cx="10.5" cy="-2.6" r="2.6"></circle>
				<circle class="fr-center" cx="0" cy="-6" r="2"></circle>
			</g>
			<line class="fr-drop" data-drop x1="0" y1={ROAD - 6} x2="0" y2={AX}></line>
			<!-- the axis -->
			<path class="ink" d={`M12 ${AX} H346`}></path>
			<path class="head--ink" d={`M350 ${AX} l-8 -4 v8 Z`}></path>
			{ticks.map((m) => (
				<>
					<line class="ln" x1={X0 + m * K} y1={AX - 4} x2={X0 + m * K} y2={AX + 4}></line>
					<text class="t-small t-num" x={X0 + m * K} y={AX + 17} text-anchor="middle">{m < 0 ? `−${-m}` : m}</text>
				</>
			))}
			<text x="344" y={AX - 9} text-anchor="end"><tspan class="t-i">x</tspan>, м</text>
			<text class="t-small" x="12" y="164">ось координат: начало у остановки</text>
			<circle class="fr-dot" data-dot cx={X0} cy={AX} r="4"></circle>
			<text class="t-strong t-num t-halo" data-xlab x={X0} y={AX - 10} text-anchor="middle"></text>
			<!-- the stopwatch -->
			<g transform="translate(300 40)">
				<circle class="fr-watch" r="22"></circle>
				<rect class="fr-crown" x="-3" y="-30" width="6" height="6" rx="1"></rect>
				<line class="fr-hand" data-hand x1="0" y1="0" x2="0" y2="-17"></line>
				<circle class="fr-hub" r="2"></circle>
				<text class="t-strong t-num" data-tlab x="0" y="40" text-anchor="middle">0,0 с</text>
				<text class="t-small" x="-30" y="-14" text-anchor="end">часы</text>
			</g>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Остановка — тело отсчёта, ось <i>Ox</i> направлена от неё вдоль дороги, часы отсчитывают время. Автомобиль едет со
		скоростью 8&nbsp;м/с; часы идут как настоящие, дорога и автомобиль нарисованы в одном масштабе.
	</figcaption>
</figure>

<style is:global>
	[data-frame10] .fr-ground {
		fill: var(--g7-ground);
	}
	[data-frame10] .fr-shelter {
		fill: color-mix(in oklab, var(--ig-vx) 18%, transparent);
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	[data-frame10] .fr-roof {
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-frame10] .fr-callout {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	[data-frame10] .fr-pole {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	[data-frame10] .fr-sign {
		fill: var(--g7-blue);
	}
	[data-frame10] .fr-sign-text {
		font-size: 11px;
		font-weight: 700;
		fill: var(--g7-paper);
	}
	[data-frame10] .fr-car {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	[data-frame10] .fr-win {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--g7-paper));
	}
	[data-frame10] .fr-wheel {
		fill: var(--g7-ink);
	}
	[data-frame10] .fr-center {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 0.6;
	}
	[data-frame10] .fr-drop {
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	[data-frame10] .fr-dot {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	[data-frame10] .fr-watch {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	[data-frame10] .fr-crown,
	[data-frame10] .fr-hub {
		fill: var(--g7-ink);
	}
	[data-frame10] .fr-hand {
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linecap: round;
	}
</style>

<script>
	import { loop, fmt } from '../g7/kit';

	const X0 = 56;
	const K = 8;
	const ROAD = 104;
	const V = 8;
	const RUN = 5;
	const HOLD = 2;

	for (const root of document.querySelectorAll<HTMLElement>('[data-frame10]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const car = q<SVGGElement>('[data-car]');
		const drop = q<SVGLineElement>('[data-drop]');
		const dot = q<SVGCircleElement>('[data-dot]');
		const xlab = q<SVGTextElement>('[data-xlab]');
		const hand = q<SVGLineElement>('[data-hand]');
		const tlab = q<SVGTextElement>('[data-tlab]');
		let run = 0;
		const show = () => {
			const t = Math.min(run, RUN);
			const x = -5 + V * t;
			const px = X0 + x * K;
			car.setAttribute('transform', `translate(${px.toFixed(1)} ${ROAD})`);
			drop.setAttribute('x1', px.toFixed(1));
			drop.setAttribute('x2', px.toFixed(1));
			dot.setAttribute('cx', px.toFixed(1));
			xlab.setAttribute('x', px.toFixed(1));
			xlab.textContent = `x = ${fmt(Math.round(x), 0)} м`;
			hand.setAttribute('transform', `rotate(${((t / 10) * 360).toFixed(1)})`);
			tlab.textContent = `t = ${fmt(t, 1)} с`;
		};
		loop(root, (dt) => {
			run += dt;
			if (run > RUN + HOLD) run = 0;
			show();
			return true;
		});
		show();
	}
</script>
