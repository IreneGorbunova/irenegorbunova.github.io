---
/**
 * Small pictures for «Где это встречается» of «Движение по окружности» (static, school-style, not to scale): the
 * Earth turning (a point of the equator moves at about 465 м/с), the drum of a washing machine at 1200 об/мин,
 * a bicycle speedometer (a magnet on a spoke passes the sensor once a turn), the ISS on its orbit (about 420 км
 * high, one turn in about 93 мин, 7,7 км/с).
 */
import G7Styles from '../g7/G7Styles.astro';
const holes = Array.from({ length: 12 }, (_, i) => (i * Math.PI) / 6);
const spokes = Array.from({ length: 12 }, (_, i) => (i * Math.PI) / 6);
---

<G7Styles />
<figure class="g7 g7--pic okuses not-content">
	<div class="g7__grid is-two">
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Земля вращается, и точка на экваторе движется по окружности">
				<circle class="okuses__earth" cx="62" cy="62" r="44"></circle>
				<path class="okuses__land" d="M40 36 q14 -8 22 4 q8 12 -4 18 q-12 4 -18 -8 Z M70 64 q12 -4 16 8 q2 14 -10 16 q-10 -6 -6 -24 Z"></path>
				<ellipse class="okuses__eq" cx="62" cy="62" rx="44" ry="8"></ellipse>
				<path class="ln-dash" d="M62 6 V118"></path>
				<circle class="okuses__dot" cx="62" cy="70" r="3"></circle>
				<path class="arrow arrow--gold" d="M65 70 H106"></path>
				<path class="head--gold" d="M104 65.5 L112 70 L104 74.5 Z"></path>
				<text class="t-small" x="118" y="66">465</text>
				<text class="t-small" x="118" y="79">м/с</text>
			</svg>
			<p>Вращение Земли</p>
		</div>
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Барабан стиральной машины">
				<rect class="okuses__box" x="30" y="6" width="100" height="110" rx="6"></rect>
				<rect class="okuses__panel" x="36" y="12" width="88" height="14" rx="3"></rect>
				<circle class="okuses__knob" cx="112" cy="19" r="4"></circle>
				<circle class="okuses__door" cx="80" cy="70" r="36"></circle>
				<circle class="okuses__drum" cx="80" cy="70" r="28"></circle>
				{holes.map((a) => <circle class="okuses__hole" cx={80 + 20 * Math.cos(a)} cy={70 + 20 * Math.sin(a)} r="2" />)}
				<path class="okuses__turn" d="M80 46 A24 24 0 0 1 104 70"></path>
				<path class="okuses__turn-h" d="M100.5 66 L104 73 L107.5 66 Z"></path>
			</svg>
			<p>Отжим: 1200 оборотов в минуту</p>
		</div>
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Колесо велосипеда с магнитом на спице и датчиком на вилке">
				<g transform="translate(-14 0)">
					<circle class="okuses__tyre" cx="70" cy="62" r="48"></circle>
					{spokes.map((a) => <line class="okuses__spoke" x1="70" y1="62" x2={70 + 43 * Math.cos(a)} y2={62 + 43 * Math.sin(a)} />)}
					<path class="okuses__fork" d="M70 62 L96 4"></path>
					<rect class="okuses__sensor" x="83" y="26" width="8" height="10" rx="2" transform="rotate(24 87 31)"></rect>
					<rect class="okuses__magnet" x="76" y="34" width="6" height="6" rx="1"></rect>
				</g>
				<text class="t-small" x="110" y="22">датчик</text>
				<text class="t-small" x="110" y="96">магнит</text>
				<path class="ln" d="M108 20 L81 29 M108 92 L68 40"></path>
			</svg>
			<p>Велосипедный спидометр</p>
		</div>
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 160 120" role="img" aria-label="Космическая станция обращается вокруг Земли">
				<circle class="okuses__earth" cx="80" cy="60" r="34"></circle>
				<circle class="ln-dash" cx="80" cy="60" r="48"></circle>
				<g transform="translate(80 12)">
					<rect class="okuses__iss" x="-3" y="-2" width="6" height="4"></rect>
					<rect class="okuses__panel2" x="-14" y="-5" width="9" height="10"></rect>
					<rect class="okuses__panel2" x="5" y="-5" width="9" height="10"></rect>
				</g>
				<path class="arrow arrow--gold" d="M96 12 H116"></path>
				<path class="head--gold" d="M114 7.5 L122 12 L114 16.5 Z"></path>
				<path class="arrow arrow--green" d="M80 18 V36"></path>
				<path class="head--green" d="M75.5 34 L80 42 L84.5 34 Z"></path>
				<text class="t-small" x="126" y="16">7,7</text>
				<text class="t-small" x="122" y="28">км/с</text>
			</svg>
			<p>Полёт космической станции</p>
		</div>
	</div>
</figure>

<style is:global>
	.okuses__cell p {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.okuses__earth {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-5));
		stroke: var(--g7-line);
	}
	.okuses__land {
		fill: color-mix(in oklab, hsl(140, 45%, 42%) 70%, var(--sl-color-gray-4));
	}
	.okuses__eq {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		stroke-dasharray: 3 2;
	}
	.okuses__dot {
		fill: var(--g7-red);
	}
	.okuses__box {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-line);
	}
	.okuses__panel {
		fill: var(--sl-color-gray-6);
	}
	.okuses__knob {
		fill: var(--g7-steel);
	}
	.okuses__door {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.okuses__drum {
		fill: var(--g7-steel);
		stroke: var(--g7-line);
	}
	.okuses__hole {
		fill: var(--g7-paper);
	}
	.okuses__turn {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.okuses__turn-h {
		fill: var(--g7-gold);
	}
	.okuses__tyre {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 6;
	}
	.okuses__spoke {
		stroke: var(--g7-line);
		stroke-width: 0.7;
	}
	.okuses__fork {
		stroke: var(--g7-steel);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.okuses__sensor {
		fill: var(--sl-color-gray-2);
	}
	.okuses__magnet {
		fill: var(--g7-red);
	}
	.okuses__iss {
		fill: var(--sl-color-gray-2);
	}
	.okuses__panel2 {
		fill: color-mix(in oklab, var(--ig-vx) 60%, var(--sl-color-gray-4));
	}
</style>
