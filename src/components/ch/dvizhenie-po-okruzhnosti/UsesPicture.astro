---
/**
 * Small pictures for «Где это встречается» of «Движение по окружности» (grade 10): four static tiles, school-style,
 * not to scale (the caption says so). One row on a wide screen, 2 × 2 on a phone. Velocity gold, centripetal
 * acceleration green, as in the whole chapter.
 *   Вращение Земли: the Earth from the side, the axis, the equator and the parallel of Moscow (55,75° N). A point of the
 *     equator moves at 2π · 6400 км / 24 ч = 465 м/с, a point at Moscow's latitude at 465 · cos 55,75° = 262 ≈ 260 м/с,
 *     a pole stays (0); arrows 0,086 px per м/с.
 *   Велосипедный спидометр: the front wheel, a magnet on a spoke, the sensor on the fork and the display on the bar:
 *     it counts turns (ν) and computes υ = 2πRν.
 *   Виниловая пластинка: a record 30 см across (3,47 px per см) at 33⅓ об/мин, turning clockwise, with the tonearm;
 *     the needle at the outer groove (R = 14,6 см: υ = 2π · 0,146 · 0,556 = 0,51 м/с) and, dashed, at the last groove
 *     (R = 6 см: 0,21 м/с); arrows 50 px per м/с.
 *   Мёртвая петля: a roller-coaster loop drawn as a circle (real loops are not circles), the train at the top moving
 *     left at υ = 10 м/с on an arc of radius 10 м: a_ц = 10²/10 = 10 м/с² ≈ g, the green arrow down to the center.
 */
import G7Styles from '../g7/G7Styles.astro';
const spokes = Array.from({ length: 16 }, (_, i) => (i * Math.PI) / 8);
const grooves = [48, 44, 40, 36, 32, 28, 24];
// the record: center, the tonearm pivot and the needle at the outer and the last groove
const RC = { x: 66, y: 66 };
const needle = [
	{ x: 115.3, y: 77.2, v: 0.51 },
	{ x: 83.2, y: 54.4, v: 0.21 },
];
const tang = (p: { x: number; y: number; v: number }) => {
	const th = Math.atan2(p.y - RC.y, p.x - RC.x);
	const L = p.v * 50;
	return { x2: p.x - Math.sin(th) * L, y2: p.y + Math.cos(th) * L, th };
};
const head = (x1: number, y1: number, x2: number, y2: number, w = 3.6, h = 6) => {
	const L = Math.hypot(x2 - x1, y2 - y1);
	const ux = (x2 - x1) / L;
	const uy = (y2 - y1) / L;
	return {
		line: { x1, y1, x2: x2 - ux * h * 0.6, y2: y2 - uy * h * 0.6 },
		d: `M${(x2 - ux * h - uy * w).toFixed(1)} ${(y2 - uy * h + ux * w).toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)} L${(x2 - ux * h + uy * w).toFixed(1)} ${(y2 - uy * h - ux * w).toFixed(1)} Z`,
	};
};
const arrows = needle.map((p) => ({ p, ...tang(p) })).map((q) => ({ ...q, h: head(q.p.x, q.p.y, q.x2, q.y2) }));
// the Earth: R 46, center (62, 66); equator arrow 465 → 40 px, Moscow 262 → 22,5 px
const E = { x: 62, y: 66, r: 46 };
const lat = (55.75 * Math.PI) / 180;
const mosc = { x: E.x, y: E.y - E.r * Math.sin(lat), rx: E.r * Math.cos(lat) };
const eqA = head(E.x, E.y + 7, E.x + 40, E.y + 7);
const moA = head(E.x, mosc.y + 3.5, E.x + 22.5, mosc.y + 3.5);
const loopV = head(72, 29, 46, 29);
const loopA = head(86, 34, 86, 57);
---

<G7Styles />
<figure class="g7 g7--pic okuses not-content">
	<div class="okuses__grid">
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 170 132" role="img" aria-label="Земля вращается: точка на экваторе движется со скоростью 465 метров в секунду, на широте Москвы — 260, на полюсе стоит на месте">
				<line class="ln-dash" x1={E.x} y1="6" x2={E.x} y2="126"></line>
				<circle class="okuses__earth" cx={E.x} cy={E.y} r={E.r}></circle>
				<path class="okuses__land" d="M38 40 q14 -10 24 2 q8 12 -4 18 q-12 6 -20 -8 Z M70 70 q14 -6 18 8 q2 16 -12 18 q-10 -8 -6 -26 Z M44 84 q6 -2 8 6 q-2 8 -8 4 Z"></path>
				<ellipse class="okuses__eq" cx={E.x} cy={E.y} rx={E.r} ry="7"></ellipse>
				<ellipse class="okuses__eq" cx={E.x} cy={mosc.y} rx={mosc.rx} ry="3.5"></ellipse>
				<circle class="okuses__dot" cx={E.x} cy={E.y + 7} r="2.6"></circle>
				<circle class="okuses__dot" cx={E.x} cy={mosc.y + 3.5} r="2.2"></circle>
				<circle class="okuses__dot" cx={E.x} cy={E.y - E.r} r="2.2"></circle>
				<line class="arrow arrow--gold" stroke-width="2.4" {...eqA.line}></line>
				<path class="head--gold" d={eqA.d}></path>
				<line class="arrow arrow--gold" stroke-width="2.4" {...moA.line}></line>
				<path class="head--gold" d={moA.d}></path>
				<text class="okuses__t" x="109" y={E.y + 11}>465 м/с</text>
				<text class="okuses__t" x="93" y={mosc.y + 7}>260 м/с</text>
				<text class="okuses__t" x={E.x + 6} y="14">0</text>
			</svg>
			<p>Вращение Земли</p>
		</div>
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 170 132" role="img" aria-label="Колесо велосипеда с магнитом на спице, датчиком на вилке и экраном спидометра на руле">
				<circle class="okuses__tyre" cx="62" cy="78" r="46"></circle>
				{spokes.map((a) => <line class="okuses__spoke" x1="62" y1="78" x2={62 + 41 * Math.cos(a)} y2={78 + 41 * Math.sin(a)} />)}
				<circle class="okuses__hub" cx="62" cy="78" r="3.5"></circle>
				<path class="okuses__fork" d="M62 78 L92 14"></path>
				<path class="okuses__bar" d="M84 14 H118"></path>
				<rect class="okuses__screen" x="98" y="20" width="62" height="30" rx="4"></rect>
				<text class="okuses__t okuses__t--lcd" x="129" y="33" text-anchor="middle">24 км/ч</text>
				<text class="okuses__t okuses__t--s" x="129" y="45" text-anchor="middle">υ = 2πRν</text>
				<rect class="okuses__sensor" x="77" y="40" width="7" height="10" rx="2" transform="rotate(25 80.5 45)"></rect>
				<rect class="okuses__magnet" x="70" y="49" width="6" height="6" rx="1"></rect>
				<text class="okuses__t" x="114" y="74">датчик</text>
				<text class="okuses__t" x="114" y="104">магнит</text>
				<path class="ln" d="M112 70 L85 46 M112 100 L76 54"></path>
			</svg>
			<p>Велосипедный спидометр</p>
		</div>
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 170 132" role="img" aria-label="Виниловая пластинка с тонармом: у внешней дорожки скорость иглы относительно пластинки 0,51 метра в секунду, у последней — 0,21">
				<circle class="okuses__vinyl" cx={RC.x} cy={RC.y} r="52"></circle>
				{grooves.map((r) => <circle class="okuses__groove" cx={RC.x} cy={RC.y} r={r} />)}
				<circle class="okuses__label" cx={RC.x} cy={RC.y} r="16"></circle>
				<circle class="okuses__hub" cx={RC.x} cy={RC.y} r="2"></circle>
				<path class="okuses__turn" d={`M${RC.x - 30} ${RC.y - 22} A37 37 0 0 1 ${RC.x + 4} ${RC.y - 37}`}></path>
				<path class="okuses__turn-h" d={`M${RC.x + 2} ${RC.y - 41.5} L${RC.x + 9} ${RC.y - 37} L${RC.x + 2} ${RC.y - 32.5} Z`}></path>
				<line class="okuses__arm okuses__arm--dash" x1="140" y1="16" x2={needle[1].x} y2={needle[1].y}></line>
				<line class="okuses__arm" x1="140" y1="16" x2={needle[0].x} y2={needle[0].y}></line>
				<circle class="okuses__pivot" cx="140" cy="16" r="6"></circle>
				{arrows.map((a) => (
					<>
						<line class="arrow arrow--gold" stroke-width="2.4" {...a.h.line} />
						<path class="head--gold" d={a.h.d} />
					</>
				))}
				<circle class="okuses__needle" cx={needle[0].x} cy={needle[0].y} r="2"></circle>
				<circle class="okuses__needle" cx={needle[1].x} cy={needle[1].y} r="2"></circle>
				<text class="okuses__t" x="120" y="104">0,51 м/с</text>
				<text class="okuses__t okuses__t--on" x="79" y="49" text-anchor="end">0,21</text>
				<text class="okuses__t okuses__t--s" x="4" y="128">33⅓ об/мин</text>
			</svg>
			<p>Виниловая пластинка</p>
		</div>
		<div class="okuses__cell">
			<svg class="g7__svg" viewBox="0 0 170 132" role="img" aria-label="Мёртвая петля американских горок: вагончик в верхней точке, скорость 10 метров в секунду направлена по касательной, ускорение 10 метров в секунду в квадрате — вниз, к центру петли">
				<path class="okuses__post" d="M52 104 V60 M120 104 V60"></path>
				<path class="okuses__track" d="M4 104 H66 Q86 104 86 92 Q86 104 106 104 H166"></path>
				<circle class="okuses__track" cx="86" cy="58" r="34"></circle>
				<circle class="okuses__ctr" cx="86" cy="58" r="1.8"></circle>
				<line class="ln-dash" x1="86" y1="58" x2="120" y2="58"></line>
				<text class="okuses__t" x="100" y="74">R = 10 м</text>
				<g transform="translate(86 24)">
					<rect class="okuses__car" x="-13" y="1.5" width="12" height="8" rx="2"></rect>
					<rect class="okuses__car" x="1" y="1.5" width="12" height="8" rx="2"></rect>
				</g>
				<line class="arrow arrow--gold" stroke-width="2.4" {...loopV.line}></line>
				<path class="head--gold" d={loopV.d}></path>
				<line class="arrow arrow--green" stroke-width="2.4" {...loopA.line}></line>
				<path class="head--green" d={loopA.d}></path>
				<text class="okuses__t" x="8" y="20">υ = 10 м/с</text>
				<text class="okuses__t" x="95" y="47">a<tspan baseline-shift="sub" font-size="8">ц</tspan> ≈ g</text>
				<text class="okuses__t okuses__t--s" x="4" y="128">a<tspan baseline-shift="sub" font-size="7">ц</tspan> = υ²/R = 10 м/с²</text>
			</svg>
			<p>Мёртвая петля</p>
		</div>
	</div>
	<figcaption class="g7__caption">Рисунки не в масштабе. Золотые стрелки — скорости, зелёная — центростремительное ускорение.</figcaption>
</figure>

<style is:global>
	.okuses__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@container (max-width: 36rem) {
		.okuses__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.okuses__cell p {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.okuses svg text.okuses__t {
		font-size: 11.5px;
		fill: var(--sl-color-gray-1);
	}
	.okuses svg text.okuses__t--s {
		font-size: 11.5px;
		fill: var(--sl-color-gray-2);
	}
	.okuses svg text.okuses__t--lcd {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.okuses__earth {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-5));
		stroke: var(--g7-line);
	}
	.okuses__land {
		fill: color-mix(in oklab, hsl(140, 45%, 42%) 70%, var(--sl-color-gray-4));
	}
	.okuses__eq {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		stroke-dasharray: 3 2;
	}
	.okuses__dot {
		fill: var(--sl-color-white);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.okuses__tyre {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 6;
	}
	.okuses__spoke {
		stroke: var(--g7-line);
		stroke-width: 0.7;
	}
	.okuses__hub {
		fill: var(--g7-ink);
	}
	.okuses__fork,
	.okuses__bar {
		stroke: var(--g7-steel);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.okuses__screen {
		fill: color-mix(in oklab, var(--ig-vx) 20%, var(--sl-color-gray-6));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.okuses__sensor {
		fill: var(--sl-color-gray-2);
	}
	.okuses__magnet {
		fill: var(--g7-red);
	}
	.okuses__vinyl {
		fill: hsl(225, 12%, 15%);
		stroke: var(--g7-line);
	}
	.okuses__groove {
		fill: none;
		stroke: hsl(225, 10%, 32%);
		stroke-width: 0.5;
	}
	.okuses svg text.okuses__t--on {
		fill: hsl(0, 0%, 96%);
	}
	.okuses__label {
		fill: var(--ig-vy);
	}
	.okuses__turn {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.okuses__turn-h {
		fill: var(--sl-color-gray-2);
	}
	.okuses__arm {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.okuses__arm--dash {
		stroke-width: 1.6;
		stroke-dasharray: 4 3;
		opacity: 0.8;
	}
	.okuses__pivot {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
	}
	.okuses__needle {
		fill: var(--sl-color-white);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.okuses__track {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 3;
	}
	.okuses__post {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2.5;
	}
	.okuses__ctr {
		fill: var(--g7-ink);
	}
	.okuses__car {
		fill: var(--ig-vy);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
</style>
