---
/**
 * «Стробоскоп»: how the frequency of a fast motor is measured with a stroboscope (стробоскопический тахометр, a real
 * device). A disc on a motor shaft (drawn 88 px in radius, face on) with one white radial mark. Three motors with HIDDEN
 * frequencies: 15, 25 and 40 с⁻¹ (900, 1500 and 2400 об/мин); the model never prints them. Each motor turns at its ν all
 * the time on the model's clock (real time), starting from its own angle.
 *   «Обычный свет»: the disc turns too fast for the eye: the mark is seen as a blurred gray ring.
 *   «Стробоскоп»: the disc is lit only by flashes at f = 1…60 вспышек в секунду (step 1), at the moments t_k = k/f. The
 *     picture shows the disc as it was at the flashes: the mark's angle at a flash is 360° · frac(ν t_k). The eye keeps
 *     an image for a short while, so the marks of the flashes of the last 0,07 с are drawn: full brightness for
 *     0,025 с, then fading out quadratically (the last flash is always drawn). So at f = 50 for ν = 25 two marks stay
 *     (each position comes back every 0,04 с), while at f = ν ± 1 one mark creeps with a faint trace behind it. The screen does NOT flicker (no dark frames and no bright flashes: only the
 *     frozen image changes); a small lamp icon glows softly at each flash. The apparent motion is real aliasing: the
 *     mark turns at ν − f · round(ν/f) об/с. Examples: ν = 25: f = 25 → still; 24 → forward 1 об/с; 26 → backward
 *     1 об/с; 50 → two opposite marks; 5 → still. ν = 15: still at 15, 5, 3, 1; f = 30 → 2 marks, 45 → 3, 60 → 4.
 *     ν = 40: still at 40, 20, 10, 8, 5, 4, 2, 1. The largest f at which ONE mark stands still equals ν.
 * Readouts: the slider shows f; the time between flashes 1/f (0,040 с at 25). f ≤ 60, so every flash can be drawn at 60 frames per second.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 strobo not-content" data-strobo>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 260" role="img" aria-label="Диск на валу мотора с белой меткой, освещённый стробоскопом" data-svg>
			<rect class="strobo__room" x="0" y="0" width="300" height="260" data-room></rect>
			<!-- the motor behind the disc -->
			<rect class="strobo__motor" x="118" y="200" width="64" height="46" rx="6"></rect>
			<path class="strobo__fin" d="M126 206 V240 M134 206 V240 M142 206 V240 M158 206 V240 M166 206 V240 M174 206 V240"></path>
			<rect class="strobo__foot" x="104" y="244" width="92" height="8" rx="2"></rect>
			<g data-disc>
				<circle class="strobo__disc" cx="150" cy="122" r="88"></circle>
				<circle class="strobo__rim" cx="150" cy="122" r="82"></circle>
				<circle class="strobo__hub" cx="150" cy="122" r="12"></circle>
				<circle class="strobo__shaft" cx="150" cy="122" r="4"></circle>
			</g>
			<circle class="strobo__blur" cx="150" cy="122" r="58" data-blur></circle>
			<g data-marks></g>
			<!-- the stroboscope lamp, top right -->
			<g transform="translate(262 30)">
				<rect class="strobo__lamp" x="-22" y="-12" width="36" height="24" rx="4"></rect>
				<rect class="strobo__lens" x="-28" y="-9" width="7" height="18" rx="2" data-lens></rect>
				<circle class="strobo__glow" cx="-26" cy="0" r="9" data-glow></circle>
				<text class="t-small" x="-4" y="26" text-anchor="middle">лампа</text>
			</g>
			<text class="t-small t-num" x="10" y="20" data-mode-label></text>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<span class="g7__label">Мотор</span>
				<div class="g7__seg" role="group" aria-label="Мотор" data-motors>
					<button type="button" class="g7__btn" aria-pressed="true" data-nu="15">1</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-nu="25">2</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-nu="40">3</button>
				</div>
			</div>
			<div class="g7__seg" role="group" aria-label="Освещение" data-light>
				<button type="button" class="g7__btn" aria-pressed="true" data-l="day">Обычный свет</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-l="strobe">Стробоскоп</button>
			</div>
			<label class="g7__slider">
				<span>Частота вспышек <i>f</i></span>
				<output data-of></output>
				<input type="range" min="1" max="60" step="1" value="10" data-f aria-label="Частота вспышек, вспышек в секунду" />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-step="-1" aria-label="Уменьшить частоту вспышек на 1">− 1</button>
				<button type="button" class="g7__btn" data-step="1" aria-label="Увеличить частоту вспышек на 1">+ 1</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li class="is-key"><span>Время между вспышками</span><b data-rt></b></li>
			</ul>
			<p class="g7__note">Частота вращения мотора не показана: найдите её сами.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Диск на валу мотора, на диске белая метка. При обычном свете метка сливается в серое кольцо. Стробоскоп освещает диск короткими вспышками, и глаз видит диск таким, каким он был при последних вспышках. Модель не мигает: меняется только картинка диска.</figcaption>
</figure>

<style is:global>
	.strobo__room {
		fill: var(--g7-paper);
		transition: fill 0.3s;
	}
	.strobo.is-strobe .strobo__room {
		fill: color-mix(in oklab, hsl(230, 30%, 10%) 55%, var(--g7-paper));
	}
	.strobo__motor {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.strobo__fin {
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}
	.strobo__foot {
		fill: var(--sl-color-gray-4);
	}
	.strobo__disc {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-3));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.strobo__rim {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.strobo__hub {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.strobo__shaft {
		fill: var(--g7-ink);
	}
	.strobo__blur {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-white) 35%, transparent);
		stroke-width: 54;
	}
	:root[data-theme='light'] .strobo__blur {
		stroke: color-mix(in oklab, #fff 45%, transparent);
	}
	.strobo__mark {
		fill: #fff;
		stroke: var(--hm-line, #222);
		stroke-width: 0.8;
	}
	.strobo__lamp {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.strobo__lens {
		fill: var(--sl-color-gray-3);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.strobo__glow {
		fill: var(--ig-v);
		opacity: 0;
	}
</style>

<script>
	import { el, fmt, loop } from '../g7/kit';

	const CX = 150;
	const CY = 122;
	const KEEP = 0.07; // s, an older image is gone by then
	const HOLD = 0.025; // s, an image stays bright this long, then fades out by KEEP (quadratically)
	for (const root of document.querySelectorAll<HTMLElement>('[data-strobo]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const fIn = $<HTMLInputElement>('[data-f]');
		const marks = $('[data-marks]');
		const blur = $('[data-blur]');
		const glow = $('[data-glow]');
		const label = $('[data-mode-label]');
		const phase0: Record<string, number> = { '15': 0.13, '25': 0.61, '40': 0.37 };
		let nu = 15;
		let strobe = false;
		let t = 0;
		const markAt = (turns: number, op: number) => {
			const a = 2 * Math.PI * turns;
			// a radial stripe from r = 22 to r = 80, 9 px wide; the angle grows counterclockwise on the screen
			const g = el('g', { transform: `rotate(${((-a * 180) / Math.PI).toFixed(2)} ${CX} ${CY})`, opacity: op.toFixed(3) });
			g.append(el('rect', { class: 'strobo__mark', x: CX + 22, y: CY - 4.5, width: 58, height: 9, rx: 2 }));
			return g;
		};
		const readouts = () => {
			const f = Number(fIn.value);
			$('[data-of]').textContent = `${f} вспышек/с`;
			$('[data-rt]').textContent = `${fmt(1 / f, 3)} с`;
		};
		const draw = () => {
			const f = Number(fIn.value);
			marks.replaceChildren();
			blur.setAttribute('opacity', strobe ? '0' : '1');
			root.classList.toggle('is-strobe', strobe);
			label.textContent = strobe ? 'стробоскоп' : 'обычный свет';
			if (!strobe) {
				glow.setAttribute('opacity', '0');
				return;
			}
			const kLast = Math.floor(t * f + 1e-9);
			for (let k = kLast; k >= 0; k--) {
				const tk = k / f;
				const age = t - tk;
				if (age > KEEP && k !== kLast) break;
				const turns = phase0[String(nu)] + nu * tk;
				// full brightness for HOLD s, then fading to zero at KEEP s
				const op = k === kLast ? 1 : Math.min(1, Math.max(0, (KEEP - age) / (KEEP - HOLD))) ** 2;
				if (op < 0.05) break;
				marks.prepend(markAt(turns - Math.floor(turns), op));
			}
			// the lamp glows softly for a moment after each flash
			const since = t - kLast / f;
			glow.setAttribute('opacity', (0.15 + 0.55 * Math.exp(-since / 0.06)).toFixed(2));
		};
		const pick = (group: string, attr: string, onPick: (v: string) => void) => {
			const btns = [...root.querySelectorAll<HTMLButtonElement>(`${group} button`)];
			for (const b of btns)
				b.addEventListener('click', () => {
					for (const o of btns) o.setAttribute('aria-pressed', String(o === b));
					onPick(b.getAttribute(attr)!);
					draw();
				});
		};
		pick('[data-motors]', 'data-nu', (v) => (nu = Number(v)));
		pick('[data-light]', 'data-l', (v) => (strobe = v === 'strobe'));
		fIn.addEventListener('input', () => (readouts(), draw()));
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-step]'))
			b.addEventListener('click', () => {
				fIn.value = String(Math.min(60, Math.max(1, Number(fIn.value) + Number(b.dataset.step))));
				readouts();
				draw();
			});
		readouts();
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
