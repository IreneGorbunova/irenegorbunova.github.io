---
/**
 * «Цепная передача велосипеда», seen from the drive side (the bicycle faces right): the crank with a pedal, the chainring
 * (48 teeth, pitch radius 97 мм), the chain (pitch 12,7 мм), the rear sprocket (16 teeth, 32,3 мм, or 24 teeth,
 * 48,5 мм: the toggle) and the rear wheel (R = 0,35 м). Gears, chain and crank (170 мм) at one scale, 0,55 px per мм;
 * the distance between the axles is shortened (150 px = 273 мм instead of about 420 мм) and the wheel is drawn smaller
 * (88 px instead of 193 px); the caption says so. Everything turns clockwise.
 * Pedals: 1 об/с (60 об/мин). The chain links move at one speed around both sprockets: 2π · 0,097 · 1 = 0,61 м/с.
 * The rear sprocket and the wheel turn at ν₂ = 1 · 48/16 = 3 об/с (24 teeth: 48/24 = 2 об/с); bicycle speed
 * 2π · 0,35 · 3 = 6,6 м/с ≈ 24 км/ч (2 об/с: 4,4 м/с ≈ 16 км/ч). ω₁R₁ = ω₂R₂ = υ_цепи.
 * The motion is SLOWED 2 times (one pedal turn in 2 с of the screen), so that the teeth and the links do not seem to run
 * backward at 60 frames per second; the numbers are the real ones. The wheel's spokes are drawn faint (a blur) with a
 * red reflector that shows the turning.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--wide gear not-content" data-gear>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 384 250" role="img" aria-label="Велосипедная цепная передача: педаль, большая звёздочка, цепь, маленькая звёздочка и заднее колесо" data-svg>
			<g data-wheel></g>
			<g data-chainring></g>
			<g data-sprocket></g>
			<g data-chain></g>
			<g data-crank></g>
			<g data-labels></g>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<span class="g7__label">Задняя звёздочка</span>
				<div class="g7__seg" role="group" aria-label="Задняя звёздочка" data-teeth>
					<button type="button" class="g7__btn" aria-pressed="true" data-z="16">16 зубьев</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-z="24">24 зуба</button>
				</div>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Педали, <i>ν</i><sub>1</sub></span><b>1 об/с</b></li>
				<li><span>Скорость цепи</span><b>0,61 м/с</b></li>
				<li class="is-key"><span>Звёздочка и колесо, <i>ν</i><sub>2</sub></span><b data-nu2></b></li>
				<li class="is-warm"><span>Скорость велосипеда</span><b data-bike></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Вид велосипеда справа. Все звенья цепи движутся с одной скоростью, поэтому точки на краях обеих звёздочек тоже: <i>ω</i><sub>1</sub><i>R</i><sub>1</sub>&nbsp;=&nbsp;<i>ω</i><sub>2</sub><i>R</i><sub>2</sub>. Радиусы звёздочек пропорциональны числу зубьев: на каждый зуб приходится одно звено цепи. Задняя звёздочка на 16&nbsp;зубьев втрое меньше передней на 48, поэтому она и колесо делают 3&nbsp;оборота за один оборот педалей. Звёздочки и цепь нарисованы в одном масштабе, расстояние между осями укорочено, колесо нарисовано меньше; движение замедлено в 2&nbsp;раза.</figcaption>
</figure>

<style is:global>
	.gear__tire {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 7;
	}
	.gear__rimw {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2.5;
	}
	.gear__spoke {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.7;
		opacity: 0.45;
	}
	.gear__blur {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 18%, transparent);
	}
	.gear__refl {
		fill: var(--ig-vy);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.gear__hub {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.gear__teeth {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-3));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.gear__spider {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.gear__arm {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-2));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.gear__pedal {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.gear__plate {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 0.5;
	}
	.gear__plate--in {
		fill: var(--sl-color-gray-4);
	}
	.gear__stay {
		stroke: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
		stroke-width: 6;
		stroke-linecap: round;
		opacity: 0.55;
	}
	.gear .g7__svg .t-mark {
		fill: var(--sl-color-white);
		font-weight: 600;
		font-size: 15px;
	}
	.gear .g7__svg .t-small {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { el, fmt, loop } from '../g7/kit';

	const K = 0.55; // px per мм
	const P = 12.7; // chain pitch, мм
	const SLOW = 2;
	const C1 = { x: 266, y: 124 }; // the chainring's axle (bottom bracket); crank and pedal end at x ≤ 375
	const C2 = { x: 116, y: 124 }; // the rear axle
	const Z1 = 48;
	const R1 = ((Z1 * P) / (2 * Math.PI)) * K; // 97,0 мм
	const CRANK = 170 * K;
	const RW = 88; // the wheel, drawn smaller
	const V = (Z1 * P) / 1000; // м/с for 1 об/с of the pedals = 0,6096
	for (const root of document.querySelectorAll<HTMLElement>('[data-gear]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let z2 = 16;
		let t = 0;
		const gearPath = (z: number, r: number) => {
			// teeth as rounded bumps between the roller seats; seat k at angle 2πk/z
			let d = '';
			const n = z * 6;
			for (let i = 0; i <= n; i++) {
				const a = (2 * Math.PI * i) / n;
				const ph = (i % 6) / 6; // 0 at a seat, 0,5 at a tooth tip
				const rr = r - 2.2 + 5.2 * Math.sin(Math.PI * ph) ** 1.5;
				d += `${i ? 'L' : 'M'}${(rr * Math.cos(a)).toFixed(2)} ${(rr * Math.sin(a)).toFixed(2)} `;
			}
			return d + 'Z';
		};
		// the wheel: tire, rim, 32 faint spokes, a blur disc and a reflector
		const wheel = $('[data-wheel]');
		wheel.append(el('line', { class: 'gear__stay', x1: C2.x, y1: C2.y, x2: C1.x, y2: C1.y }));
		const wg = el('g');
		wheel.append(el('circle', { class: 'gear__blur', cx: C2.x, cy: C2.y, r: RW - 4 }));
		wheel.append(wg);
		wheel.append(el('circle', { class: 'gear__tire', cx: C2.x, cy: C2.y, r: RW }));
		wheel.append(el('circle', { class: 'gear__rimw', cx: C2.x, cy: C2.y, r: RW - 5 }));
		for (let i = 0; i < 32; i++) {
			const a = (2 * Math.PI * i) / 32;
			wg.append(el('line', { class: 'gear__spoke', x1: 0, y1: 0, x2: ((RW - 6) * Math.cos(a)).toFixed(1), y2: ((RW - 6) * Math.sin(a)).toFixed(1) }));
		}
		wg.append(el('rect', { class: 'gear__refl', x: 30, y: -3.5, width: 18, height: 7, rx: 2 }));
		const ring = $('[data-chainring]');
		const ringG = el('g');
		ring.append(ringG);
		ringG.append(el('path', { class: 'gear__teeth', d: gearPath(Z1, R1) }));
		ringG.append(el('path', { class: 'gear__spider', d: Array.from({ length: 5 }, (_, i) => { const a = (2 * Math.PI * i) / 5; return `M0 0 L${(R1 * 0.82 * Math.cos(a - 0.12)).toFixed(1)} ${(R1 * 0.82 * Math.sin(a - 0.12)).toFixed(1)} L${(R1 * 0.82 * Math.cos(a + 0.12)).toFixed(1)} ${(R1 * 0.82 * Math.sin(a + 0.12)).toFixed(1)} Z`; }).join(' ') }));
		ringG.append(el('circle', { class: 'gear__hub', cx: 0, cy: 0, r: 9 }));
		const spr = $('[data-sprocket]');
		const sprG = el('g');
		spr.append(sprG);
		const crank = $('[data-crank]');
		const arm = el('path', { class: 'gear__arm' });
		const pedal = el('rect', { class: 'gear__pedal', width: 30, height: 9, rx: 2 });
		crank.append(arm, pedal, el('circle', { class: 'gear__hub', cx: C1.x, cy: C1.y, r: 5 }));
		const chain = $('[data-chain]');
		const labels = $('[data-labels]');
		const text = (x: number, y: number, s: string, cls = 't-small', anchor = 'start') => {
			const tt = el('text', { class: cls, x, y, 'text-anchor': anchor });
			tt.innerHTML = s;
			return tt;
		};
		let path: { len: number; at: (s: number) => { x: number; y: number; a: number } } | null = null;
		let R2 = 0;
		const build = () => {
			R2 = ((z2 * P) / (2 * Math.PI)) * K;
			sprG.replaceChildren();
			sprG.append(el('path', { class: 'gear__teeth', d: gearPath(z2, R2) }));
			sprG.append(el('circle', { class: 'gear__hub', cx: 0, cy: 0, r: 6 }));
			sprG.append(el('circle', { class: 'gear__spider', cx: R2 * 0.55, cy: 0, r: 2.2 }));
			// the closed chain path along the pitch circles: the outer tangents of the two circles
			const D = C1.x - C2.x;
			const b = Math.asin((R1 - R2) / D); // the runs tilt by b
			// upper tangent points: angle (−π/2 − b) on both circles (screen angles, y down)
			const aU = -Math.PI / 2 - b;
			const aL = Math.PI / 2 + b;
			const p1u = { x: C1.x + R1 * Math.cos(aU), y: C1.y + R1 * Math.sin(aU) };
			const p2u = { x: C2.x + R2 * Math.cos(aU), y: C2.y + R2 * Math.sin(aU) };
			const p1l = { x: C1.x + R1 * Math.cos(aL), y: C1.y + R1 * Math.sin(aL) };
			const p2l = { x: C2.x + R2 * Math.cos(aL), y: C2.y + R2 * Math.sin(aL) };
			const run = Math.hypot(p1u.x - p2u.x, p1u.y - p2u.y);
			const wrap1 = aL - aU; // the chainring wraps on its right side, from aU (top) round to aL (bottom): π + 2b
			const wrap2 = 2 * Math.PI - (aL - aU); // the sprocket wraps on its left side, from aL round to aU: π − 2b
			const L1 = wrap1 * R1;
			const L2 = wrap2 * R2;
			// the direction of motion (clockwise): along the upper run from the sprocket to the chainring, round the
			// chainring (top → right → bottom), along the lower run back, round the sprocket (bottom → left → top)
			const len = run + L1 + run + L2;
			const at = (s0: number) => {
				let s = ((s0 % len) + len) % len;
				if (s < run) {
					const q = s / run;
					return { x: p2u.x + (p1u.x - p2u.x) * q, y: p2u.y + (p1u.y - p2u.y) * q, a: Math.atan2(p1u.y - p2u.y, p1u.x - p2u.x) };
				}
				s -= run;
				if (s < L1) {
					const a = aU + s / R1;
					return { x: C1.x + R1 * Math.cos(a), y: C1.y + R1 * Math.sin(a), a: a + Math.PI / 2 };
				}
				s -= L1;
				if (s < run) {
					const q = s / run;
					return { x: p1l.x + (p2l.x - p1l.x) * q, y: p1l.y + (p2l.y - p1l.y) * q, a: Math.atan2(p2l.y - p1l.y, p2l.x - p1l.x) };
				}
				s -= run;
				const a = aL + s / R2;
				return { x: C2.x + R2 * Math.cos(a), y: C2.y + R2 * Math.sin(a), a: a + Math.PI / 2 };
			};
			path = { len, at };
			// phases that put the rollers (the joints of the plates, at s = i·pitch + shift) into the seats of the teeth
			const pitchN = len / (2 * Math.round(len / (2 * P * K)));
			const md = (x: number, m: number) => ((x % m) + m) % m;
			d1 = md(aU - run / R1, pitchN / R1);
			d2 = md(aL - (2 * run + L1) / R2, pitchN / R2);
			const nu2 = Z1 / z2;
			$('[data-nu2]').textContent = `${fmt(nu2, 0)} об/с`;
			const vb = 2 * Math.PI * 0.35 * nu2;
			$('[data-bike]').textContent = `${fmt(vb, 1)} м/с ≈ ${fmt(vb * 3.6, 0)} км/ч`;
			labels.replaceChildren();
			labels.append(text(C1.x, 18, '<tspan class="t-i">ν</tspan><tspan baseline-shift="sub" font-size="9">1</tspan> = 1 об/с', 't-mark', 'middle'));
			labels.append(text(C2.x, 18, `<tspan class="t-i">ν</tspan><tspan baseline-shift="sub" font-size="9">2</tspan> = ${fmt(nu2, 0)} об/с`, 't-mark', 'middle'));
			labels.append(text(190, 42, 'цепь: 0,61 м/с', 't-small t-halo', 'middle'));
			labels.append(text(190, 238, 'цепь: 0,61 м/с', 't-small t-halo', 'middle'));
			labels.append(text(6, 244, '<tspan class="t-i">ω</tspan><tspan baseline-shift="sub" font-size="9">1</tspan><tspan class="t-i">R</tspan><tspan baseline-shift="sub" font-size="9">1</tspan> = <tspan class="t-i">ω</tspan><tspan baseline-shift="sub" font-size="9">2</tspan><tspan class="t-i">R</tspan><tspan baseline-shift="sub" font-size="9">2</tspan>', 't-mark'));
			// the links: 2·round(len / 2P) plates so the chain closes with whole links
			const pitch = P * K;
			nLinks = 2 * Math.round(len / (2 * pitch));
			chain.replaceChildren();
			plates = Array.from({ length: nLinks }, (_, i) => {
				const r = el('rect', { class: `gear__plate${i % 2 ? ' gear__plate--in' : ''}`, x: -pitch / 2 - 1, y: -2.6, width: pitch + 2, height: 5.2, rx: 2.4 });
				chain.append(r);
				return r;
			});
		};
		let nLinks = 0;
		let d1 = 0;
		let d2 = 0;
		let plates: SVGElement[] = [];
		const draw = () => {
			const turns = t / SLOW; // pedal turns
			const a1 = 2 * Math.PI * turns; // clockwise on the screen = growing screen angle
			ringG.setAttribute('transform', `translate(${C1.x} ${C1.y}) rotate(${(((a1 + d1) * 180) / Math.PI).toFixed(2)})`);
			const nu2 = Z1 / z2;
			const a2 = 2 * Math.PI * turns * nu2;
			sprG.setAttribute('transform', `translate(${C2.x} ${C2.y}) rotate(${(((a2 + d2) * 180) / Math.PI).toFixed(2)})`);
			wg.setAttribute('transform', `translate(${C2.x} ${C2.y}) rotate(${((a2 * 180) / Math.PI).toFixed(2)})`);
			// crank and pedal: the crank points down at the start
			const ca = Math.PI / 2 + a1;
			const px = C1.x + CRANK * Math.cos(ca);
			const py = C1.y + CRANK * Math.sin(ca);
			const nx = -Math.sin(ca) * 4.5;
			const ny = Math.cos(ca) * 4.5;
			arm.setAttribute('d', `M${(C1.x + nx * 1.3).toFixed(1)} ${(C1.y + ny * 1.3).toFixed(1)} L${(px + nx * 0.8).toFixed(1)} ${(py + ny * 0.8).toFixed(1)} L${(px - nx * 0.8).toFixed(1)} ${(py - ny * 0.8).toFixed(1)} L${(C1.x - nx * 1.3).toFixed(1)} ${(C1.y - ny * 1.3).toFixed(1)} Z`);
			pedal.setAttribute('x', (px - 15).toFixed(1));
			pedal.setAttribute('y', (py - 4.5).toFixed(1));
			// the links move along the path by the arc length of the chainring's turn
			const shift = a1 * R1;
			const pitch = path!.len / nLinks;
			plates.forEach((r, i) => {
				const q = path!.at(i * pitch + shift + pitch / 2);
				r.setAttribute('transform', `translate(${q.x.toFixed(2)} ${q.y.toFixed(2)}) rotate(${((q.a * 180) / Math.PI).toFixed(1)})`);
			});
		};
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-teeth] button'))
			b.addEventListener('click', () => {
				for (const o of root.querySelectorAll('[data-teeth] button')) o.setAttribute('aria-pressed', String(o === b));
				z2 = Number(b.dataset.z);
				build();
				draw();
			});
		build();
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
