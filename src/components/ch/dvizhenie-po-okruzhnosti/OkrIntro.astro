---
/**
 * Two short looping opening scenes of «Движение по окружности» (grade 10). No terms of the chapter in the pictures or
 * in the visible captions; each caption's popover names the notion and links to its section. People: the shared kit
 * (src/components/people/).
 *
 * Grinder (a workshop: back wall with a window, a shelf and a tool board, a floor of planks in perspective, a bench
 *   with a vise; 1,12 px per см at the worker's depth). A worker (adult, 178 см, goggles, work gloves) grinds the end of
 *   a steel bar clamped in the vise with an angle grinder. Both hands hold the grinder: the right (near) hand around the
 *   motor body, the left (far) hand on the side handle screwed into the top of the gear head. The disc stands in the
 *   picture plane (the spindle points at the viewer); it is 125 мм across (7 px radius) and turns at about
 *   11 000 об/мин, so its rim moves at π · 0,125 · 11 000 / 60 = 72 м/с. The lowest point of the disc touches the bar and
 *   moves to the right; the sparks leave it along the tangent: as one narrow fan to the right (±4°), slowing in air
 *   (time constant 0,35 с of the scene) and bending down; a spark that reaches the bench top goes out there. The sparks
 *   are drawn far SLOWER than real ones (the real ones fly several metres in a fraction of a second); their direction
 *   is the real one. The grinder and the hands shake slightly (vibration). 6 с.
 * Roundabout (a playground: trees, a fence, a slide and swings far behind, a bench with a parent, sand; seen from
 *   above at a slant: 80 px per metre across, depth squeezed by 0,25, far things up to 8 % smaller). The roundabout is
 *   3 м across and makes one turn in 4 с, real time (counterclockwise seen from above: the near side moves to the
 *   right). Two children (people kit, child proportions: the girl 132 см, the boy 124 см) stand on the deck at one
 *   radial handrail 80 см high, 25 см behind it (the rail is 25 см ahead of them along the tangent), holding it with
 *   both hands: the girl 1,4 м from the axis, the boy 0,5 м. Their feet stand on the deck and turn with it. Each child faces along the motion; the kit draws people in
 *   profile only, so a child seen at an angle is narrowed by |cos| of the heading (at least 0,32), as in the grade-9
 *   chain-swing scene. Both turn by the same angle, so both make a turn in 4 с; the girl covers 2π · 1,4 = 8,8 м
 *   (2,2 м/с), the boy 2π · 0,5 = 3,1 м (0,79 м/с). The arc each has covered since the start is drawn in their color.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// ---------- grinder: the floor planks converge to a vanishing point above the picture's middle
const VP = { x: 190, y: -40 };
const FLOOR_TOP = 150;
const planks = Array.from({ length: 15 }, (_, i) => -260 + i * 62);
const plankLine = (xb: number) => {
	const t = (FLOOR_TOP - VP.y) / (240 - VP.y);
	return `M${(VP.x + (xb - VP.x) * t).toFixed(1)} ${FLOOR_TOP} L${xb} 240`;
};
const pegs = Array.from({ length: 7 }, (_, i) => Array.from({ length: 4 }, (_, j) => ({ x: 248 + i * 14, y: 28 + j * 15 }))).flat();
// ---------- roundabout: static playground
const trees = [
	{ x: 14, y: 84, r: 20 },
	{ x: 46, y: 78, r: 24 },
	{ x: 128, y: 82, r: 18 },
	{ x: 232, y: 80, r: 22 },
	{ x: 262, y: 86, r: 15 },
	{ x: 346, y: 80, r: 22 },
];
const posts = Array.from({ length: 37 }, (_, i) => i * 10);
const rnd = (i: number, k: number) => {
	const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
	return r - Math.floor(r);
};
const pebbles = Array.from({ length: 34 }, (_, i) => ({ x: rnd(i, 1) * 360, y: 120 + rnd(i, 2) * 118, r: 0.6 + rnd(i, 3) * 0.9 }));
---

<PeopleStyles />
<IntroFrame data-okintro>
	<div class="intro__card" data-scene="grinder">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Рабочий в очках и перчатках держит болгарку двумя руками и шлифует конец стальной полосы в тисках; искры от диска летят одним узким пучком вправо">
			<rect class="ok-wall" x="0" y="0" width="360" height={FLOOR_TOP}></rect>
			<rect class="ok-skirting" x="0" y={FLOOR_TOP - 5} width="360" height="5"></rect>
			<!-- window -->
			<rect class="ok-winframe" x="14" y="16" width="74" height="78" rx="2"></rect>
			<rect class="ok-glass" x="19" y="21" width="30" height="68"></rect>
			<rect class="ok-glass" x="53" y="21" width="30" height="68"></rect>
			<path class="ok-tree-far" d="M19 89 V64 q8 -14 16 -4 q8 -12 14 2 V89 Z M53 89 V70 q10 -12 18 0 q6 -6 12 4 V89 Z"></path>
			<rect class="ok-sill" x="10" y="94" width="82" height="5" rx="1"></rect>
			<!-- the shelf with cans -->
			<rect class="ok-shelf" x="150" y="44" width="76" height="4"></rect>
			<rect class="ok-shelf" x="150" y="76" width="76" height="4"></rect>
			<path class="ok-bracket" d="M156 48 l6 6 M220 48 l-6 6 M156 80 l6 6 M220 80 l-6 6"></path>
			<rect class="ok-can ok-can--a" x="156" y="28" width="12" height="16" rx="1.5"></rect>
			<rect class="ok-can ok-can--b" x="172" y="32" width="10" height="12" rx="1.5"></rect>
			<rect class="ok-box" x="190" y="30" width="28" height="14" rx="1"></rect>
			<rect class="ok-can ok-can--c" x="158" y="62" width="16" height="14" rx="1.5"></rect>
			<rect class="ok-box" x="182" y="58" width="22" height="18" rx="1"></rect>
			<rect class="ok-can ok-can--a" x="208" y="64" width="10" height="12" rx="1.5"></rect>
			<!-- the tool board -->
			<rect class="ok-board" x="238" y="18" width="104" height="70" rx="3"></rect>
			{pegs.map((p) => <circle class="ok-peg" cx={p.x} cy={p.y} r="1" />)}
			<path class="ok-tool" d="M252 26 v40"></path>
			<rect class="ok-toolhead" x="245" y="23" width="14" height="7" rx="1.5"></rect>
			<path class="ok-tool" d="M276 26 v44"></path>
			<circle class="ok-ring" cx="276" cy="26" r="4.5"></circle>
			<circle class="ok-ring" cx="276" cy="72" r="3.5"></circle>
			<path class="ok-tool" d="M296 28 l-4 36 M300 28 l4 36"></path>
			<path class="ok-saw" d="M316 26 h20 v8 l-20 42 Z"></path>
			<!-- a lamp on its cord -->
			<path class="ok-cord" d="M110 0 V14"></path>
			<path class="ok-shade" d="M101 22 L104 14 H116 L119 22 Z"></path>
			<!-- the floor -->
			<rect class="ok-floor" x="0" y={FLOOR_TOP} width="360" height={240 - FLOOR_TOP}></rect>
			{planks.map((x) => <path class="ok-plank" d={plankLine(x)} />)}
			<!-- a bucket under the bench, farther back -->
			<path class="ok-bucket" d="M262 214 L265 194 H285 L288 214 Z"></path>
			<path class="ok-bucket-rim" d="M265 194 H285"></path>
			<!-- the bench: top in perspective, apron, legs -->
			<path class="ok-bench-top" d="M150 131 L156 124 H356 L352 131 Z"></path>
			<rect class="ok-bench" x="150" y="131" width="202" height="9"></rect>
			<rect class="ok-leg ok-leg--back" x="340" y="128" width="6" height="88"></rect>
			<rect class="ok-leg" x="156" y="140" width="8" height="92"></rect>
			<rect class="ok-leg" x="338" y="140" width="8" height="92"></rect>
			<rect class="ok-rail" x="164" y="200" width="174" height="5"></rect>
			<!-- the vise -->
			<rect class="ok-vise" x="152" y="121" width="38" height="5" rx="1"></rect>
			<rect class="ok-vise" x="170" y="108" width="14" height="14" rx="1"></rect>
			<rect class="ok-vise ok-vise--jaw" x="158" y="110" width="12" height="12" rx="1"></rect>
			<path class="ok-screw" d="M164 116 H142 M142 110 V122"></path>
			<circle class="ok-knob" cx="142" cy="110" r="1.6"></circle>
			<circle class="ok-knob" cx="142" cy="122" r="1.6"></circle>
			<!-- the steel bar in the jaws -->
			<rect class="ok-strip" x="162" y="111" width="44" height="5" rx="0.6"></rect>
			<g data-worker></g>
			<g data-sparks></g>
		</svg>
		<div class="intro__foot">
			<p>
				Искры срываются с края вращающегося диска и{' '}
				<More term="летят одним узким пучком">
					Каждая искра — раскалённая крупинка металла. Пока она на краю диска, она движется по окружности, а оторвавшись, летит дальше в ту сторону, куда двигалась в момент отрыва, — по касательной к окружности. Край диска болгарки движется со скоростью около 70&nbsp;м/с. Об этом — в разделе{' '}
					<a href="#скорость-при-движении-по-окружности">«Скорость при движении по окружности»</a>. Искры в сцене летят гораздо медленнее настоящих.
				</More>, а не во все стороны.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="roundabout">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик и девочка катаются на карусели на детской площадке: мальчик стоит у середины, девочка у края. Девочка за оборот проходит гораздо больший путь">
