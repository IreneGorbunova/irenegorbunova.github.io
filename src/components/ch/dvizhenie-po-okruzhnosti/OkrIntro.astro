---
/**
 * Two short looping opening scenes of «Движение по окружности». No terms of the chapter in the pictures.
 *
 * Grinder: a workshop seen from 60 to 190 см above the floor, 1,85 px per centimeter. A worker (178 см) grinds the
 *   top of a steel strip on a bench with an angle grinder; its disc is 125 мм across and turns at about
 *   11 000 об/мин, so its rim moves at about 70 м/с. The lower edge of the disc moves to the right, and the sparks
 *   leave it along the tangent: as one narrow fan to the right, spreading by a few degrees, slowing in air and
 *   bending down. The sparks are drawn far slower than real ones (the real ones fly ten metres in a fraction of a
 *   second); their direction is the real one.
 * Roundabout: a playground roundabout 3 м across (1 px per centimeter across, the far side squeezed by 0,25 for
 *   the view from above), one turn in 4 с, real time. Two children stand at one radial handrail: the girl at 1,4 м
 *   from the axis, the boy at 0,5 м. Both turn by the same angle, so both make a turn in 4 с; the girl covers
 *   2π · 1,4 = 8,8 м (2,2 м/с), the boy 3,1 м (0,79 м/с). The arc each has covered since the start is drawn in
 *   their color. Far things are drawn up to 8 % smaller.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const trees = [
	{ x: 30, y: 128, r: 26 },
	{ x: 72, y: 120, r: 20 },
	{ x: 300, y: 124, r: 24 },
	{ x: 340, y: 132, r: 18 },
];
---

<PeopleStyles />
<IntroFrame data-okintro>
	<div class="intro__card" data-scene="grinder">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Рабочий шлифует стальную полосу болгаркой, и искры от диска летят одним узким пучком вправо">
			<rect class="ok-wall" x="0" y="0" width="360" height="240"></rect>
			<!-- a tool board on the wall -->
			<rect class="ok-board" x="226" y="22" width="112" height="70" rx="3"></rect>
			{[0, 1, 2, 3, 4, 5].map((i) => [0, 1, 2].map((j) => <circle class="ok-peg" cx={236 + i * 19} cy={32 + j * 25} r="1.3" />))}
			<path class="ok-tool" d="M252 34 v42 M300 30 v44 M320 32 v40"></path>
			<rect class="ok-toolhead" x="244" y="28" width="16" height="8" rx="1.5"></rect>
			<circle class="ok-ring" cx="300" cy="30" r="5"></circle>
			<circle class="ok-ring" cx="300" cy="74" r="4"></circle>
			<path class="ok-toolhead" d="M314 72 h12 l-6 12 Z"></path>
			<!-- the bench -->
			<rect class="ok-bench" x="150" y="186" width="210" height="9" rx="1"></rect>
			<rect class="ok-leg" x="160" y="195" width="8" height="45"></rect>
			<rect class="ok-leg" x="338" y="195" width="8" height="45"></rect>
			<rect class="ok-strip" x="128" y="168" width="108" height="7" rx="1"></rect>
			<rect class="ok-block" x="140" y="175" width="18" height="11"></rect>
			<rect class="ok-block" x="206" y="175" width="18" height="11"></rect>
			<g data-worker></g>
			<!-- the grinder: the motor body, the head, the guard, the disc, the side handle -->
			<g data-grinder>
				<rect class="ok-motor" x="-62" y="-27" width="52" height="15" rx="6"></rect>
				<path class="ok-vent" d="M-54 -24 v9 M-49 -24 v9 M-44 -24 v9"></path>
				<rect class="ok-head" x="-14" y="-29" width="16" height="17" rx="3"></rect>
				<rect class="ok-handle" x="-8" y="-46" width="5" height="18" rx="2.5"></rect>
				<circle class="ok-disc" cx="0" cy="-11.6" r="11.6"></circle>
				<circle class="ok-blur" cx="0" cy="-11.6" r="8.6"></circle>
				<path class="ok-guard" d="M-13.5 -11.6 A13.5 13.5 0 0 1 13.5 -11.6 L11.6 -11.6 A11.6 11.6 0 0 0 -11.6 -11.6 Z"></path>
				<circle class="ok-nut" cx="0" cy="-11.6" r="2.4"></circle>
			</g>
			<g data-sparks></g>
		</svg>
		<div class="intro__foot">
			<p>
				Искры срываются с края вращающегося диска и{' '}
				<More term="летят одним узким пучком">
					Каждая искра — раскалённая крупинка металла. Пока она на краю диска, она движется по окружности, а оторвавшись, летит дальше в ту сторону, куда двигалась в момент отрыва, — по касательной к окружности. Край диска болгарки движется со скоростью около 70&nbsp;м/с. Об этом — в разделе{' '}
					<a href="#скорость-при-движении-по-окружности">«Скорость при движении по окружности»</a>. Искры в сцене летят гораздо медленнее настоящих.
				</More>, а не во все стороны.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="roundabout">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик и девочка катаются на карусели: мальчик стоит у середины, девочка у края. Девочка за оборот проходит гораздо больший путь">
			<rect class="ok-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="ok-grass" x="0" y="140" width="360" height="100"></rect>
			{trees.map((t) => (
				<>
					<rect class="ok-trunk" x={t.x - 3} y={t.y} width="6" height="22" />
					<circle class="ok-crown" cx={t.x} cy={t.y - t.r * 0.6} r={t.r} />
				</>
			))}
			<rect class="ok-bench2" x="96" y="132" width="44" height="5" rx="1"></rect>
			<path class="ok-bench2-leg" d="M100 137 v10 M136 137 v10"></path>
			<!-- the roundabout: a thick disc seen from above at a slant -->
			<ellipse class="ok-rim" cx="180" cy="203" rx="150" ry="37.5"></ellipse>
			<ellipse class="ok-deck" cx="180" cy="196" rx="150" ry="37.5"></ellipse>
			<path class="ok-trail ok-trail--b" data-trailb></path>
			<path class="ok-trail ok-trail--g" data-trailg></path>
			<g data-scene-items></g>
			<text class="ok-label" x="10" y="20">время: <tspan class="ok-num" data-clock>0,0&nbsp;с</tspan></text>
		</svg>
		<div class="intro__foot">
			<p>
				Мальчик и девочка делают круг за одно и то же время, но девочка у края{' '}
				<More term="мчится гораздо быстрее">
					За один оборот девочка, стоящая в 1,4&nbsp;м от оси, проходит окружность длиной 8,8&nbsp;м, а мальчик, стоящий в 0,5&nbsp;м от оси, — только 3,1&nbsp;м. Оборот длится 4&nbsp;с, поэтому скорость девочки 2,2&nbsp;м/с, а мальчика — 0,79&nbsp;м/с. Об этом — в разделе{' '}
					<a href="#линейная-и-угловая-скорость">«Линейная и угловая скорость»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-okintro] .ok-wall {
		fill: color-mix(in oklab, var(--ig-vx) 6%, var(--sl-color-gray-6));
	}
	[data-okintro] .ok-board {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-4);
	}
	[data-okintro] .ok-tool {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-okintro] .ok-bench {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-5);
	}
	[data-okintro] .ok-leg {
		fill: var(--sl-color-gray-4);
	}
	[data-okintro] .ok-strip {
		fill: color-mix(in oklab, var(--ig-vx) 15%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-okintro] .ok-block {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-5);
	}
	[data-okintro] .ok-motor,
	[data-okintro] .ok-head {
		fill: color-mix(in oklab, hsl(150, 60%, 40%) 70%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	[data-okintro] .ok-vent {
		stroke: var(--hm-line);
		stroke-width: 1;
	}
	[data-okintro] .ok-handle {
		fill: var(--hm-line);
	}
	[data-okintro] .ok-disc {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-okintro] .ok-blur {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-dasharray: 2 3;
		opacity: 0.7;
	}
	[data-okintro] .ok-guard {
		fill: var(--sl-color-gray-2);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-okintro] .ok-nut {
		fill: var(--sl-color-gray-1);
	}
	[data-okintro] .ok-peg {
		fill: var(--sl-color-gray-4);
	}
	[data-okintro] .ok-toolhead {
		fill: var(--sl-color-gray-2);
	}
	[data-okintro] .ok-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
	}
	[data-okintro] .ok-spark {
		stroke-linecap: round;
	}
	[data-okintro] .ok-sky {
		fill: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-bg));
	}
	[data-okintro] .ok-grass {
		fill: color-mix(in oklab, hsl(140, 45%, 42%) 45%, var(--sl-color-gray-5));
	}
	[data-okintro] .ok-trunk {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	[data-okintro] .ok-crown {
		fill: color-mix(in oklab, hsl(140, 45%, 38%) 70%, var(--sl-color-gray-4));
	}
	[data-okintro] .ok-bench2 {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-4));
	}
	[data-okintro] .ok-bench2-leg {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-okintro] .ok-rim {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 1;
	}
	[data-okintro] .ok-deck {
		fill: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-3));
		stroke: var(--hm-line);
		stroke-width: 1;
	}
	[data-okintro] .ok-trail {
		fill: none;
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	[data-okintro] .ok-trail--b {
		stroke: var(--ig-vx);
	}
	[data-okintro] .ok-trail--g {
		stroke: var(--ig-v);
	}
	[data-okintro] .ok-pole {
		fill: var(--sl-color-gray-3);
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	[data-okintro] .ok-rail {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-okintro] .ok-label {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	[data-okintro] .ok-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { human, ANKLE, type HumanPose } from '../mehanicheskaya-rabota/people';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = (tag: string, attrs: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		return e;
	};
	const light = () => document.documentElement.dataset.theme === 'light';
	const rnd = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);

	for (const root of document.querySelectorAll<HTMLElement>('[data-okintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="grinder"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1.85;
			const H = 178;
			const u = S * H;
			const FLOOR = 240 + 60 * S;
			const CX = 228; // the disc's lowest point touches the end of the strip at (CX, 168)
			const CY = 168;
			$('[data-grinder]').setAttribute('transform', `translate(${CX} ${CY})`);
			const worker = human($<SVGGElement>('[data-worker]'), { s: S, H, shirt: 'hm-blue', hair: 'short', girth: 1.1 });
			const a = ANKLE * S;
			const pose = (shake: number): HumanPose => ({
				hip: { x: 110 + shake, y: FLOOR - 0.49 * u },
				lean: 0.5,
				ankles: [
					{ x: 126, y: FLOOR - a },
					{ x: 92, y: FLOOR - a },
				],
				feet: [0, 0],
				hands: [
					{ x: CX - 58 + shake, y: CY - 20 },
					{ x: CX - 6 + shake, y: CY - 44 },
				],
				head: 0.45,
			});
			// sparks: born at the lowest point of the disc, flying to the right along the tangent (±4°), slowing in air
			// (time constant 0,35 с of the scene) and bending down; they cool from white-yellow to red and go out
			const sparks = $<SVGGElement>('[data-sparks]');
			const R = rnd(7);
			const list = Array.from({ length: 260 }, () => ({ born: R() * 6, life: 0.5 + 0.5 * R(), ang: (R() - 0.5) * 0.14, v: 520 + 260 * R() }));
			const lines = list.map(() => {
				const l = mk('line', { class: 'ok-spark' });
				sparks.append(l);
				return l;
			});
			const TAU = 0.35;
			const GR = 260;
			const at = (s: (typeof list)[0], t: number) => {
				const d = s.v * TAU * (1 - Math.exp(-t / TAU));
				return { x: CX + d * Math.cos(s.ang), y: CY - 1 + d * Math.sin(s.ang) + (GR * t * t) / 2 };
			};
			scene(card, 6, (x) => {
				const T = x * 6;
				worker(pose(T > 0 && T < 6 ? 0.3 * Math.sin(T * 90) : 0));
				list.forEach((s, i) => {
					const t = T - s.born;
					const l = lines[i];
					if (t <= 0 || t > s.life || T >= 6) {
						l.setAttribute('opacity', '0');
						return;
					}
					const p1 = at(s, t);
					const p0 = at(s, Math.max(0, t - 0.06));
					const q = t / s.life;
					l.setAttribute('x1', p0.x.toFixed(1));
					l.setAttribute('y1', p0.y.toFixed(1));
					l.setAttribute('x2', p1.x.toFixed(1));
					l.setAttribute('y2', p1.y.toFixed(1));
					l.setAttribute('stroke', `hsl(${(52 - 40 * q).toFixed(0)}, 100%, ${((light() ? 52 : 85) - (light() ? 12 : 30) * q).toFixed(0)}%)`);
					l.setAttribute('stroke-width', (2.2 - 0.9 * q).toFixed(2));
					l.setAttribute('opacity', (1 - q * q).toFixed(2));
				});
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="roundabout"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const CX = 180;
			const CY = 196;
			const PX = 100; // px per metre across
			const SQ = 0.25; // the squeeze of depth
			const T = 4;
			const items = $<SVGGElement>('[data-scene-items]');
			// a point of the deck at radius r (м), angle th, height h (см): x across, y down; depth = cos th (1 = near)
			const pt = (r: number, th: number, h = 0) => {
				const depth = Math.cos(th);
				const k = 1 + 0.08 * depth * (r / 1.5);
				return { x: CX + PX * r * Math.sin(th), y: CY + PX * SQ * r * depth - h * k, k, depth };
			};
			// the pole and four radial handrails at 80 см
			const pole = mk('g', {});
			pole.append(mk('rect', { class: 'ok-pole', x: CX - 3, y: CY - 92, width: 6, height: 92, rx: 2 }));
			pole.append(mk('ellipse', { class: 'ok-pole', cx: CX, cy: CY - 92, rx: 14, ry: 4 }));
			const rails = [0, 1, 2, 3].map(() => mk('path', { class: 'ok-rail' }));
			// the children: each is drawn twice (facing right and left) around its feet at (0, 0), 1 px per см
			const kid = (H: number, shirt: string, hair: 'short' | 'pony') => {
				const g = mk('g', {}) as SVGGElement;
				const gr = mk('g', {}) as SVGGElement;
				const gl = mk('g', {}) as SVGGElement;
				g.append(gr, gl);
				const right = human(gr, { s: 1, H, shirt, hair });
				const left = human(gl, { s: 1, H, shirt, hair, dir: -1 });
				return { g, gr, gl, right, left, H };
			};
			const girl = kid(132, 'hm-gold', 'pony');
			const boy = kid(124, 'hm-blue', 'short');
			const kids = [
				{ c: girl, r: 1.4, trail: $('[data-trailg]') },
				{ c: boy, r: 0.5, trail: $('[data-trailb]') },
			];
			const clock = $('[data-clock]');
			const TH0 = -1.1; // the rail of the children at the start
			const arc = (r: number, a0: number, a1: number) => {
				let d = '';
				const n = Math.max(2, Math.ceil(Math.abs(a1 - a0) / 0.05));
				for (let i = 0; i <= n; i++) {
					const p = pt(r, a0 + ((a1 - a0) * i) / n);
					d += `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)} `;
				}
				return d;
			};
			scene(card, T, (x) => {
				const th = TH0 + 2 * Math.PI * x;
				clock.textContent = `${(x * T).toFixed(1).replace('.', ',')} с`;
				const layers: { z: number; el: Element }[] = [{ z: 0, el: pole }];
				rails.forEach((rl, i) => {
					const a = th + (i * Math.PI) / 2;
					const p1 = pt(1.5, a, 80);
					const f = pt(1.5, a, 0);
					rl.setAttribute('d', `M${CX} ${CY - 80} L${p1.x.toFixed(1)} ${p1.y.toFixed(1)} L${f.x.toFixed(1)} ${f.y.toFixed(1)}`);
					layers.push({ z: Math.cos(a) * 1.5 - 0.01, el: rl });
				});
				for (const kd of kids) {
					kd.trail.setAttribute('d', x > 0 ? arc(kd.r, TH0, th) : '');
					// the child stands 25 см behind the rail (against the turning) and holds it with both hands
					const a = th - 0.25 / kd.r;
					const p = pt(kd.r, a);
					const hand = pt(kd.r, th, 74);
					const dir = Math.cos(a) >= 0 ? 1 : -1;
					const H = kd.c.H;
					const loc = { x: (hand.x - p.x) / p.k, y: (hand.y - p.y) / p.k };
					const pose: HumanPose = {
						hip: { x: -dir * 2, y: -0.505 * H },
						lean: 0.08,
						ankles: [
							{ x: dir * 4, y: -ANKLE * (H / 172) },
							{ x: -dir * 6, y: -ANKLE * (H / 172) },
						],
						feet: [0, 0],
						hands: [
							{ x: loc.x, y: loc.y },
							{ x: loc.x - dir * 3, y: loc.y + 2 },
						],
					};
					kd.c.gr.style.display = dir > 0 ? '' : 'none';
					kd.c.gl.style.display = dir > 0 ? 'none' : '';
					(dir > 0 ? kd.c.right : kd.c.left)(pose);
					kd.c.g.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) scale(${p.k.toFixed(3)})`);
					layers.push({ z: Math.cos(a) * kd.r, el: kd.c.g });
				}
				layers.sort((p, q) => p.z - q.z);
				for (const l of layers) items.append(l.el);
			});
		}
	}
</script>
