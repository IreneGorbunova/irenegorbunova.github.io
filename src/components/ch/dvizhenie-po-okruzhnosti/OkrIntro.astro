		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	[data-okintro] .ok-crown {
		fill: color-mix(in oklab, hsl(140, 45%, 36%) 70%, var(--sl-color-gray-4));
	}
	[data-okintro] .ok-crown--lit {
		fill: color-mix(in oklab, hsl(120, 45%, 50%) 55%, var(--sl-color-gray-4));
	}
	[data-okintro] .ok-fence {
		stroke: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-3));
		stroke-width: 1.2;
	}
	[data-okintro] .ok-slide-frame,
	[data-okintro] .ok-swing-frame {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-gray-3));
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-okintro] .ok-slide-top {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-gray-3));
	}
	[data-okintro] .ok-chute {
		fill: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-3));
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-okintro] .ok-chain {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.7;
	}
	[data-okintro] .ok-swing-seat {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
	}
	[data-okintro] .ok-bench2,
	[data-okintro] .ok-bench2-back {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.4;
	}
	[data-okintro] .ok-bench2-leg {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-okintro] .ok-shadow {
		fill: color-mix(in oklab, var(--sl-color-black) 30%, transparent);
	}
	[data-okintro] .ok-rim {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	[data-okintro] .ok-deck {
		fill: color-mix(in oklab, var(--ig-vy) 25%, var(--sl-color-gray-3));
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	[data-okintro] .ok-deckline {
		stroke: color-mix(in oklab, var(--ig-vy) 25%, var(--sl-color-gray-4));
		stroke-width: 0.8;
	}
	[data-okintro] .ok-trail {
		fill: none;
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	[data-okintro] .ok-trail--b {
		stroke: var(--ig-vx);
	}
	[data-okintro] .ok-trail--g {
		stroke: var(--ig-v);
	}
	[data-okintro] .ok-pole {
		fill: var(--sl-color-gray-3);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	[data-okintro] .ok-rail-r {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-okintro] .ok-clockbg {
		fill: color-mix(in oklab, var(--sl-color-bg) 70%, transparent);
	}
	[data-okintro] .ok-label {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	[data-okintro] .ok-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-okintro] .ok-far-tone {
		filter: brightness(0.92);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, ANKLE_CM, type FigurePose } from '@components/people/body';
	import { ROLL } from '@components/people/hand';
	import { DEG } from '@components/people/core';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = (parent: Element | null, tag: string, attrs: Record<string, string | number> = {}) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent?.append(e);
		return e as SVGElement;
	};
	const f1 = (v: number) => v.toFixed(1);
	const light = () => document.documentElement.dataset.theme === 'light';
	const rng = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);

	for (const root of document.querySelectorAll<HTMLElement>('[data-okintro]')) {
		// ---------- Grinder ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="grinder"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1.12; // px per см at the worker's depth
			const H = 178;
			const u = S * H;
			const SOLE = 232;
			const CX = 206; // disc center; its lowest point touches the bar's top at its right end
			const RD = 0.0625 * 100 * S; // disc radius, px (125 мм across)
			const BAR = 111; // top of the bar
			const CY = BAR - RD;
			const TILT = -20 * DEG; // the motor body rises toward the disc by 20°
			const g = $<SVGGElement>('[data-worker]');
			const person = mk(g, 'g') as SVGGElement;
			const worker = figure(person, { s: S, H, shirt: 'hm-blue', hair: 'short', girth: 1.05, covering: 'glove', name: 'worker with an angle grinder' });
			// layers inside the person's root group: the far parts of the near hand, then the grinder, then the near arm
			const proot = person.firstElementChild as SVGGElement;
			const nearArmFirst = proot.children[proot.children.length - 3];
			const handBack = mk(null, 'g') as SVGGElement;
			const tool = mk(null, 'g') as SVGGElement;
			proot.insertBefore(handBack, nearArmFirst);
			proot.insertBefore(tool, nearArmFirst);
			worker.backLayer(0, handBack);
			// the grinder in its own frame: origin at the disc center, the motor body along −x, the side handle along −y
			const gr = mk(tool, 'g');
			mk(gr, 'path', { class: 'ok-cable', d: 'M-38 0.5 Q-48 4 -52 18 Q-56 40 -70 52 Q-84 64 -96 70' });
			mk(gr, 'rect', { class: 'ok-motor', x: -38, y: -4.2, width: 31, height: 8.4, rx: 3.6 });
			mk(gr, 'path', { class: 'ok-vent', d: 'M-34 -2.4 v4.8 M-31.5 -2.4 v4.8 M-29 -2.4 v4.8' });
			mk(gr, 'rect', { class: 'ok-head', x: -8, y: -5.4, width: 11, height: 10.8, rx: 2.4 });
			mk(gr, 'rect', { class: 'ok-handle', x: -3.4, y: -19.5, width: 3.6, height: 14.5, rx: 1.8 });
			mk(gr, 'circle', { class: 'ok-disc', r: RD });
			const marks = mk(gr, 'g');
			mk(marks, 'circle', { class: 'ok-blur', r: RD * 0.62 });
			mk(gr, 'path', { class: 'ok-guard', d: `M${f1(-(RD + 1.6) * Math.cos(25 * DEG))} ${f1((RD + 1.6) * Math.sin(25 * DEG))} A${f1(RD + 1.6)} ${f1(RD + 1.6)} 0 0 1 ${f1((RD + 1.6) * Math.cos(25 * DEG))} ${f1(-(RD + 1.6) * Math.sin(25 * DEG))} L${f1(RD * Math.cos(25 * DEG))} ${f1(-RD * Math.sin(25 * DEG))} A${f1(RD)} ${f1(RD)} 0 0 0 ${f1(-RD * Math.cos(25 * DEG))} ${f1(RD * Math.sin(25 * DEG))} Z` });
			mk(gr, 'circle', { class: 'ok-nut', r: 1.6 });
			// grip points (in the picture) for a shake dx, dy
			const loc = (x: number, y: number, dx: number, dy: number) => ({ x: CX + dx + x * Math.cos(TILT) - y * Math.sin(TILT), y: CY + dy + x * Math.sin(TILT) + y * Math.cos(TILT) });
			// the goggles over the head: drawn on top of the figure, following the head
			const gog = mk(g, 'g');
			const W = 0.15 * u * 1.05;
			const hr = 0.064 * u;
			mk(gog, 'path', { class: 'ok-goggle-band', d: `M${f1(-0.98 * hr)} ${f1(-0.28 * hr)} Q${f1(-0.2 * hr)} ${f1(-0.5 * hr)} ${f1(0.5 * hr)} ${f1(-0.2 * hr)}` });
			mk(gog, 'path', { class: 'ok-goggle', d: `M${f1(0.36 * hr)} ${f1(-0.3 * hr)} H${f1(1.02 * hr)} Q${f1(1.12 * hr)} ${f1(0.02 * hr)} ${f1(0.98 * hr)} ${f1(0.24 * hr)} H${f1(0.38 * hr)} Q${f1(0.28 * hr)} ${f1(-0.04 * hr)} ${f1(0.36 * hr)} ${f1(-0.3 * hr)} Z` });
			const LEAN = 0.32;
			const HEAD = 0.32;
			const hipX = 117;
			const hipY = SOLE - 0.52 * u + 1.5; // the knees a little bent
			const ankleY = SOLE - ANKLE_CM.trainer * S;
			const pose = (dx: number, dy: number): FigurePose => ({
				hip: { x: hipX, y: hipY },
				lean: LEAN,
				head: HEAD,
				ankles: [
					{ x: hipX + 16, y: ankleY },
					{ x: hipX - 20, y: ankleY },
				],
				feet: [0, 0],
				hands: [
					{ at: loc(-27, 0, dx, dy), pose: 'grip', d: 7.5, dir: 70 * DEG, roll: ROLL.backViewer, contact: 'grinder body' },
					{ at: loc(-1.6, -14, dx, dy), pose: 'grip', d: 3.6, dir: TILT, roll: ROLL.palmViewer, contact: 'side handle' },
				],
				planted: [true, true],
			});
			const hipAt = (a: number, b: number) => ({ x: hipX + Math.sin(LEAN) * a + Math.cos(LEAN) * b, y: hipY - Math.cos(LEAN) * a + Math.sin(LEAN) * b });
			const hc = hipAt(0.4 * u, 0.1 * W);
			gog.setAttribute('transform', `translate(${f1(hc.x)} ${f1(hc.y)}) rotate(${f1((LEAN * 0.4 + HEAD) / DEG)})`);
			// sparks: born at the lowest point of the disc, flying to the right along the tangent (±4°), slowing in air
			// and bending down; they cool from white-yellow to red and go out, or go out on the bench top
			const sparks = $<SVGGElement>('[data-sparks]');
			const R = rng(7);
			const RUN = 6;
			const list = Array.from({ length: 240 }, () => ({ born: R() * RUN, life: 0.45 + 0.5 * R(), ang: (R() - 0.5) * 0.14, v: 430 + 260 * R() }));
			const lines = list.map(() => mk(sparks, 'line', { class: 'ok-spark' }));
			const TAU = 0.35;
			const GR = 240;
			const BENCH = 124; // the bench top (far edge) the sparks fly over
			const at = (s: (typeof list)[0], t: number, x0: number, y0: number) => {
				const d = s.v * TAU * (1 - Math.exp(-t / TAU));
				return { x: x0 + d * Math.cos(s.ang), y: y0 + d * Math.sin(s.ang) + (GR * t * t) / 2 };
			};
			const spin = mk(marks, 'path', { class: 'ok-blur', d: '' });
			scene(card, RUN, (x) => {
				const T = x * RUN;
				const on = T > 0 && T < RUN;
				const dx = on ? 0.35 * Math.sin(T * 97) : 0;
				const dy = on ? 0.3 * Math.sin(T * 131 + 1) : 0;
				gr.setAttribute('transform', `translate(${f1(CX + dx)} ${f1(CY + dy)}) rotate(${(TILT / DEG).toFixed(1)})`);
				// a short arc on the disc: a blur that turns (the real disc turns 180 times a second)
				const ph = -T * 9;
				const a0 = ph;
				const a1 = ph + 1.2;
				const rr = RD * 0.62;
				spin.setAttribute('d', `M${f1(rr * Math.cos(a0))} ${f1(rr * Math.sin(a0))} A${f1(rr)} ${f1(rr)} 0 0 1 ${f1(rr * Math.cos(a1))} ${f1(rr * Math.sin(a1))}`);
				worker.pose(pose(dx, dy));
				const x0 = CX + dx;
				const y0 = BAR - 0.5 + dy;
				list.forEach((s, i) => {
					const t = T - s.born;
					const l = lines[i];
					if (!on || t <= 0 || t > s.life) {
						l.setAttribute('opacity', '0');
						return;
					}
					let p1 = at(s, t, x0, y0);
					const p0 = at(s, Math.max(0, t - 0.05), x0, y0);
					if (p0.y > BENCH && p0.x < 356) {
						l.setAttribute('opacity', '0');
						return;
					}
					if (p1.y > BENCH && p1.x < 356) p1 = { x: p0.x + ((p1.x - p0.x) * (BENCH - p0.y)) / Math.max(0.01, p1.y - p0.y), y: BENCH };
					const q = t / s.life;
					l.setAttribute('x1', f1(p0.x));
					l.setAttribute('y1', f1(p0.y));
					l.setAttribute('x2', f1(p1.x));
					l.setAttribute('y2', f1(p1.y));
					l.setAttribute('stroke', `hsl(${(52 - 40 * q).toFixed(0)}, 100%, ${((light() ? 50 : 85) - (light() ? 10 : 30) * q).toFixed(0)}%)`);
					l.setAttribute('stroke-width', (1.8 - 0.8 * q).toFixed(2));
					l.setAttribute('opacity', (1 - q * q).toFixed(2));
				});
			});
		}
		// ---------- Roundabout ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="roundabout"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const CX = 180;
			const CY = 197;
			const PX = 80; // px per metre across
			const SQ = 0.25; // the squeeze of depth
			const T = 4;
			const RAIL = 80; // см, the handrail's height
			const items = $<SVGGElement>('[data-scene-items]');
			// a point of the deck at radius r (м), angle th, height h (см); depth = cos th (1 = near)
			const pt = (r: number, th: number, h = 0) => {
				const depth = Math.cos(th);
				const k = 1 + 0.08 * depth * (r / 1.5);
				return { x: CX + PX * r * Math.sin(th), y: CY + PX * SQ * r * depth - (h * PX * k) / 100, k, depth };
			};
			// lines of the deck boards (they turn with it)
			const deckLines = $<SVGGElement>('[data-deck-lines]');
			const boards = Array.from({ length: 8 }, () => mk(deckLines, 'path', { class: 'ok-deckline' }));
			// the pole and four radial handrails, each split at the children's radii for the depth order
			const pole = mk(items, 'g');
			mk(pole, 'rect', { class: 'ok-pole', x: CX - 2.5, y: CY - (RAIL + 4) * 0.8, width: 5, height: (RAIL + 4) * 0.8, rx: 2 });
			mk(pole, 'ellipse', { class: 'ok-pole', cx: CX, cy: CY - (RAIL + 4) * 0.8, rx: 9, ry: 2.6 });
			const CUTS = [0, Math.hypot(0.5, 0.25), Math.hypot(1.4, 0.25), 1.5];
			const rails = [0, 1, 2, 3].map(() => CUTS.slice(1).map(() => mk(items, 'path', { class: 'ok-rail-r' })));
			// the children (child proportions of the kit), 0,8 px per см before the perspective factor
			const SK = PX / 100;
			const kid = (H: number, shirt: string, hair: 'short' | 'pony', name: string) => {
				const wrap = mk(items, 'g') as SVGGElement;
				const inner = mk(wrap, 'g') as SVGGElement;
				const f = figure(inner, { s: SK, H, age: 'child', shirt, hair, shorts: hair === 'short', name });
				return { wrap, f, H };
			};
			const girl = kid(132, 'hm-gold', 'pony', 'girl on the roundabout');
			const boy = kid(124, 'hm-blue', 'short', 'boy on the roundabout');
			const kids = [
				{ c: girl, r: 1.4, trail: $('[data-trailg]') },
				{ c: boy, r: 0.5, trail: $('[data-trailb]') },
			];
			const clock = $('[data-clock]');
			const TH0 = -1.0; // the rail of the children at the start
			const arc = (r: number, a0: number, a1: number) => {
				let d = '';
				const n = Math.max(2, Math.ceil(Math.abs(a1 - a0) / 0.05));
				for (let i = 0; i <= n; i++) {
					const p = pt(r, a0 + ((a1 - a0) * i) / n);
					d += `${i ? 'L' : 'M'}${f1(p.x)} ${f1(p.y)} `;
				}
				return d;
			};
			// the parent on the bench (0,5 px per см: farther than the roundabout), sitting, hands on the knees
			const PS = 0.5;
			const parent = figure($<SVGGElement>('[data-parent]'), { s: PS, H: 168, shirt: 'hm-green', hair: 'pony', name: 'mother on the bench' });
			const pu = 168 * PS;
			const phip = { x: 26, y: 146 - 0.035 * pu };
			const thigh = 0.24 * pu;
			const knee = { x: phip.x + thigh * Math.cos(-0.04), y: phip.y + thigh * Math.sin(-0.04) };
			parent.pose({
				hip: phip,
				lean: -0.06,
				head: -0.1,
				ankles: [phip, phip],
				legs: [
					[-0.04, 1.5],
					[0.02, 1.42],
				],
				feet: [0, 0],
				hands: [
					{ at: { x: knee.x - 4, y: knee.y - 2.2 }, pose: 'flat', dir: 0.15, roll: 0, contact: 'knee' },
					{ at: { x: knee.x - 7, y: knee.y - 2.6 }, pose: 'flat', dir: 0.1, roll: 0, contact: 'knee' },
				],
			});
			const ank = ANKLE_CM.trainer;
			scene(card, T, (x) => {
				const th = TH0 + 2 * Math.PI * x;
				clock.textContent = `${(x * T).toFixed(1).replace('.', ',')} с`;
				boards.forEach((b, i) => {
					const a = th + (i * Math.PI) / 8;
					const p = pt(1.5, a);
					const q = pt(1.5, a + Math.PI);
					b.setAttribute('d', `M${f1(p.x)} ${f1(p.y)} L${f1(q.x)} ${f1(q.y)}`);
				});
				const layers: { z: number; el: Element }[] = [{ z: 0, el: pole }];
				rails.forEach((segs, i) => {
					const a = th + (i * Math.PI) / 2;
					segs.forEach((sg, j) => {
						const r0 = CUTS[j];
						const r1 = CUTS[j + 1];
						const p0 = r0 === 0 ? { x: CX, y: CY - RAIL * 0.8 } : pt(r0, a, RAIL);
						const p1 = pt(r1, a, RAIL);
						let d = `M${f1(p0.x)} ${f1(p0.y)} L${f1(p1.x)} ${f1(p1.y)}`;
						if (j === segs.length - 1) {
							const f = pt(1.5, a, 0);
							d += ` L${f1(f.x)} ${f1(f.y)}`;
						}
						sg.setAttribute('d', d);
						layers.push({ z: Math.cos(a) * (r0 + r1) * 0.5, el: sg });
					});
				});
				for (const kd of kids) {
					// the child stands on the deck at radius r and holds the rail 25 см ahead along the motion (along the
					// tangent), with both hands; the rail point is at radius √(r² + 0,25²) at the rail's angle th
					const a = th - Math.atan(0.25 / kd.r);
					kd.trail.setAttribute('d', x > 0 ? arc(kd.r, TH0 - Math.atan(0.25 / kd.r), a) : '');
					const p = pt(kd.r, a);
					const hand = pt(Math.hypot(kd.r, 0.25), th, RAIL - 2);
					const c = Math.cos(a);
					const sx = (c >= 0 ? 1 : -1) * Math.max(0.32, Math.abs(c));
					const H = kd.c.H;
					const loc = { x: (hand.x - p.x) / (p.k * sx), y: (hand.y - p.y) / p.k };
					const ankY = -ank * SK;
					const pose: FigurePose = {
						hip: { x: -1, y: -0.48 * H * SK + 0.8 },
						lean: 0.06,
						ankles: [
							{ x: 3, y: ankY },
							{ x: -4, y: ankY },
						],
						feet: [0, 0],
						hands: [
							{ at: { x: loc.x, y: loc.y }, pose: 'grip', d: 3.5, dir: -0.1, roll: ROLL.backViewer, contact: 'handrail' },
							{ at: { x: loc.x - 1.5, y: loc.y + 0.5 }, pose: 'grip', d: 3.5, dir: -0.1, roll: ROLL.palmViewer, contact: 'handrail' },
						],
					};
					kd.c.wrap.setAttribute('transform', `translate(${f1(p.x)} ${f1(p.y)}) scale(${(sx * p.k).toFixed(3)} ${p.k.toFixed(3)})`);
					kd.c.wrap.setAttribute('class', c < 0 ? 'ok-far-tone' : '');
					layers.push({ z: c * kd.r, el: kd.c.wrap });
					kd.c.f.pose(pose);
				}
				layers.sort((p, q) => p.z - q.z);
				for (const l of layers) items.append(l.el);
			});
		}
	}
</script>
