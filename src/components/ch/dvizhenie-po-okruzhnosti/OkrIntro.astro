				</>
			))}
			<rect class="ok-sand" x="0" y="106" width="360" height="134"></rect>
			<!-- the fence far behind -->
			<path class="ok-fence" d="M0 104 H360 M0 113 H360"></path>
			{posts.map((x) => <path class="ok-fence" d={`M${x} 100 V118`} />)}
			<!-- the slide, far left -->
			<path class="ok-slide-frame" d="M96 128 L100 96 M108 128 L112 96 M98 120 H110 M98.6 112 H110.6 M99.4 104 H111.4"></path>
			<rect class="ok-slide-top" x="98" y="92" width="18" height="5" rx="1"></rect>
			<path class="ok-chute" d="M116 94 Q130 96 138 116 Q142 126 152 128 L152 131 Q139 130 134 118 Q128 101 116 98 Z"></path>
			<!-- the swings, far right -->
			<path class="ok-swing-frame" d="M246 128 L256 90 L266 128 M304 128 L314 90 L324 128 M256 90 H314"></path>
			<path class="ok-chain" d="M270 90 V117 M282 90 V117 M292 90 V112 M302 90 V112"></path>
			<rect class="ok-swing-seat" x="268" y="117" width="16" height="3" rx="1"></rect>
			<rect class="ok-swing-seat" x="290" y="112" width="14" height="3" rx="1"></rect>
			{pebbles.map((p) => <circle class="ok-pebble" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={p.r.toFixed(1)} />)}
			<!-- the bench with a parent, left -->
			<path class="ok-bench2-back" d="M8 132 H60 V126 H8 Z M8 138 H60 V134 H8 Z"></path>
			<rect class="ok-bench2" x="6" y="146" width="56" height="5" rx="1"></rect>
			<path class="ok-bench2-leg" d="M10 151 V166 M58 151 V166 M10 132 V146 M58 132 V146"></path>
			<g data-parent></g>
			<!-- the roundabout: shadow, a thick disc seen from above at a slant -->
			<ellipse class="ok-shadow" cx="184" cy="211" rx="126" ry="32"></ellipse>
			<ellipse class="ok-rim" cx="180" cy="203" rx="120" ry="30"></ellipse>
			<ellipse class="ok-deck" cx="180" cy="197" rx="120" ry="30"></ellipse>
			<g data-deck-lines></g>
			<path class="ok-trail ok-trail--b" data-trailb></path>
			<path class="ok-trail ok-trail--g" data-trailg></path>
			<g data-scene-items></g>
			<rect class="ok-clockbg" x="6" y="6" width="104" height="22" rx="5"></rect>
			<text class="ok-label" x="13" y="22">время: <tspan class="ok-num" data-clock>0,0&nbsp;с</tspan></text>
		</svg>
		<div class="intro__foot">
			<p>
				Мальчик и девочка делают круг за одно и то же время, но девочка у края{' '}
				<More term="мчится гораздо быстрее">
					За один оборот девочка, стоящая в 1,4&nbsp;м от оси, проходит окружность длиной 8,8&nbsp;м, а мальчик, стоящий в 0,5&nbsp;м от оси, — только 3,1&nbsp;м. Оборот длится 4&nbsp;с, поэтому скорость девочки 2,2&nbsp;м/с, а мальчика — 0,79&nbsp;м/с. Об этом — в разделе{' '}
					<a href="#линейная-и-угловая-скорость">«Линейная и угловая скорость»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
