---
/**
 * «Равные дуги за равные промежутки времени»: a potter's wheel seen from above (wheel head R = 15 см drawn 70 px,
 * 4,67 px per см), a clay pot on it and a white mark on the rim. Two panels, real time, a flash-photo look: the mark's
 * positions every 1/8 с stay as dots, each with the velocity of the mark at that moment (gold, along the tangent,
 * 30 px per м/с). The wheel turns counterclockwise.
 *   «Равномерно»: one turn per second, φ = 2π t: eight equal arcs of 45°, every arrow 2π · 0,15 = 0,94 м/с (28 px).
 *   «Разгоняется»: from rest, φ = π t² (рад), so ω = 2π t and after 1 с the wheel makes 1 об/с: the arcs between the
 *     dots are (2k + 1) · 2,8° = 2,8°; 8,4°; 14,1°; 19,7°; 25,3°; 30,9°; 36,6°; 42,2° (1 : 3 : 5 : 7 …), the arrows
 *     grow as υ = 0,94 t м/с.
 * Loop: 1 с of motion, 2 с hold, restart (`loop` from g7/kit). Nothing is slowed. The two panels stand side by side
 * at every width (text in the drawing is 15–16 px, so about 11 px at 390 px).
 */
import G7Styles from '../g7/G7Styles.astro';
const panels = [
	{ key: 'even', title: 'Равномерно', note: 'дуги равны' },
	{ key: 'acc', title: 'Разгоняется', note: 'дуги растут' },
];
---

<G7Styles />
<figure class="g7 g7--pic arcs not-content" data-arcs>
	<div class="arcs__grid">
		{
			panels.map((p) => (
				<div class="arcs__cell">
					<svg class="g7__svg" viewBox="0 0 220 214" role="img" aria-label={p.key === 'even' ? 'Гончарный круг вращается равномерно: положения метки через равные промежутки времени отстоят на равные дуги, стрелки скорости одной длины' : 'Гончарный круг разгоняется: дуги между положениями метки растут, стрелки скорости удлиняются'} data-panel={p.key}>
						<text class="t-title" x="8" y="19">{p.title}</text>
						<circle class="arcs__base" cx="110" cy="114" r="76"></circle>
						<g data-wheel>
							<circle class="arcs__head" cx="0" cy="0" r="70"></circle>
							<circle class="arcs__ring" cx="0" cy="0" r="58"></circle>
							<circle class="arcs__pot" cx="0" cy="0" r="38"></circle>
							<circle class="arcs__potin" cx="0" cy="0" r="27"></circle>
							<path class="arcs__clay" d="M-20 -6 Q-10 -12 2 -8 M6 12 Q14 6 18 -4 M-14 14 Q-6 18 2 16"></path>
						</g>
						<g data-arcsegs></g>
						<g data-dots></g>
						<circle class="arcs__mark" r="4.2" data-mark></circle>
						<text class="t-small" x="6" y="208">{p.note}</text>
						<text class="t-small t-num" x="214" y="208" text-anchor="end" data-time></text>
					</svg>
				</div>
			))
		}
	</div>
	<figcaption class="g7__caption">Гончарный круг, вид сверху. Белая метка на краю круга «сфотографирована» через каждые 1/8&nbsp;с, золотые стрелки — её скорость в эти моменты. Слева круг вращается равномерно, делая 1&nbsp;оборот в секунду: за равные промежутки времени метка проходит равные дуги, стрелки одной длины (0,94&nbsp;м/с). Справа круг разгоняется из покоя: дуги растут, стрелки удлиняются.</figcaption>
</figure>

<style is:global>
	.arcs__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@container (max-width: 30rem) {
		.arcs__grid {
			gap: 0.4rem;
		}
	}
	/* larger text inside the drawing: at 390 px the two panels stand side by side, each about 165 px wide */
	.arcs .g7__svg .t-title {
		font-size: 16px;
	}
	.arcs .g7__svg .t-small {
		font-size: 15px;
	}
	.arcs__base {
		fill: var(--sl-color-gray-5);
	}
	.arcs__head {
		fill: color-mix(in oklab, var(--g7-steel) 70%, var(--sl-color-gray-5));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.arcs__ring {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.arcs__pot {
		fill: color-mix(in oklab, hsl(18, 55%, 50%) 65%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.arcs__potin {
		fill: color-mix(in oklab, hsl(18, 50%, 35%) 70%, var(--sl-color-gray-5));
	}
	.arcs__clay {
		fill: none;
		stroke: color-mix(in oklab, hsl(18, 50%, 30%) 60%, var(--sl-color-gray-5));
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.arcs__mark {
		fill: var(--sl-color-white);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	:root[data-theme='light'] .arcs__mark {
		fill: #fff;
	}
	.arcs__dot {
		fill: var(--sl-color-white);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	:root[data-theme='light'] .arcs__dot {
		fill: #fff;
	}
	.arcs__seg {
		fill: none;
		stroke-width: 3;
		stroke-linecap: butt;
	}
	.arcs__seg--a {
		stroke: var(--sl-color-gray-1);
	}
	.arcs__seg--b {
		stroke: var(--sl-color-gray-4);
	}
</style>

<script>
	import { el, loop } from '../g7/kit';

	const R = 70; // px, the rim (15 см)
	const CX = 110;
	const CY = 114;
	const RUN = 1;
	const HOLD = 2;
	const VS = 30; // px per м/с
	const RM = 0.15; // м
	const phiOf = (key: string, t: number) => (key === 'even' ? 2 * Math.PI * t : Math.PI * t * t);
	const omegaOf = (key: string, t: number) => (key === 'even' ? 2 * Math.PI : 2 * Math.PI * t);
	const PHI0 = -Math.PI / 2; // the mark starts at the bottom of the picture
	// a point of the rim at angle φ (counterclockwise on the screen)
	const at = (phi: number, r = R) => ({ x: CX + r * Math.cos(PHI0 + phi), y: CY - r * Math.sin(PHI0 + phi) });
	const arrow = (x1: number, y1: number, x2: number, y2: number, color: string, op: number) => {
		const out = el('g', { opacity: op.toFixed(2) });
		const L = Math.hypot(x2 - x1, y2 - y1);
		if (L < 2) return out;
		const ux = (x2 - x1) / L;
		const uy = (y2 - y1) / L;
		const h = Math.min(7, L * 0.6);
		out.append(el('line', { class: `arrow arrow--${color}`, 'stroke-width': 2.4, x1, y1, x2: x2 - ux * h * 0.6, y2: y2 - uy * h * 0.6 }));
		out.append(el('path', { class: `head--${color}`, d: `M${x2 - ux * h - uy * 3.8} ${y2 - uy * h + ux * 3.8} L${x2} ${y2} L${x2 - ux * h + uy * 3.8} ${y2 - uy * h - ux * 3.8} Z` }));
		return out;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-arcs]')) {
		const panels = [...root.querySelectorAll<SVGSVGElement>('[data-panel]')].map((svg) => ({
			key: svg.dataset.panel!,
			wheel: svg.querySelector('[data-wheel]')!,
			segs: svg.querySelector('[data-arcsegs]')!,
			dots: svg.querySelector('[data-dots]')!,
			mark: svg.querySelector('[data-mark]')!,
			time: svg.querySelector('[data-time]')!,
		}));
		let t = 0;
		const draw = () => {
			const tm = Math.min(t, RUN);
			for (const p of panels) {
				const phi = phiOf(p.key, tm);
				p.wheel.setAttribute('transform', `translate(${CX} ${CY}) rotate(${((-phi * 180) / Math.PI).toFixed(2)})`);
				const m = at(phi);
				p.mark.setAttribute('cx', m.x.toFixed(1));
				p.mark.setAttribute('cy', m.y.toFixed(1));
				p.segs.replaceChildren();
				p.dots.replaceChildren();
				const n = Math.floor(tm * 8 + 1e-6);
				for (let k = 0; k <= n && k <= 8; k++) {
					const tk = k / 8;
					const a = phiOf(p.key, tk);
					// the arc to the next flash position, alternating colors
					if (k < n) {
						const b = phiOf(p.key, (k + 1) / 8);
						const steps = Math.max(2, Math.ceil(((b - a) * 180) / Math.PI / 3));
						let d = '';
						for (let i = 0; i <= steps; i++) {
							const q = at(a + ((b - a) * i) / steps, R + 6);
							d += `${i ? 'L' : 'M'}${q.x.toFixed(1)} ${q.y.toFixed(1)} `;
						}
						p.segs.append(el('path', { class: `arcs__seg arcs__seg--${k % 2 ? 'b' : 'a'}`, d }));
					}
					if (k === 8) continue;
					const q = at(a);
					const v = omegaOf(p.key, tk) * RM; // м/с
					const tx = -Math.sin(PHI0 + a);
					const ty = -Math.cos(PHI0 + a);
					const op = 0.45 + 0.55 * (k + 1) / (n + 1);
					p.dots.append(arrow(q.x, q.y, q.x + tx * v * VS, q.y + ty * v * VS, 'gold', op));
					p.dots.append(el('circle', { class: 'arcs__dot', cx: q.x.toFixed(1), cy: q.y.toFixed(1), r: 2.6, opacity: op.toFixed(2) }));
				}
				p.time.textContent = `t = ${tm.toFixed(2).replace('.', ',')} с`;
			}
		};
		loop(root, (dt) => {
			t += dt;
			if (t > RUN + HOLD) t = 0;
			draw();
			return true;
		})();
		draw();
	}
</script>
