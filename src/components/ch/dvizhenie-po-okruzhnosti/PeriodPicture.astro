---
/**
 * «Считаем обороты»: a bicycle wheel (radius 0,35 м, drawn 70 px) turns evenly, one turn in 2 с, real time; a red
 * reflector on a spoke marks one point of it. The counters show the time t and the number of full turns N; after
 * 5 turns (10 с) the picture writes T = t/N = 2 с and ν = N/t = 0,5 с⁻¹.
 */
import G7Styles from '../g7/G7Styles.astro';

const spokes = Array.from({ length: 16 }, (_, i) => (i * Math.PI) / 8);
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow per not-content" data-per>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 190" role="img" aria-label="Колесо велосипеда делает пять оборотов за десять секунд">
			<g data-wheel>
				<circle class="per__tyre" cx="95" cy="95" r="72"></circle>
				<circle class="per__rim" cx="95" cy="95" r="64"></circle>
				{spokes.map((a) => <line class="per__spoke" x1="95" y1="95" x2={95 + 64 * Math.cos(a)} y2={95 + 64 * Math.sin(a)} />)}
				<rect class="per__refl" x="91" y="40" width="8" height="14" rx="2"></rect>
			</g>
			<circle class="per__hub" cx="95" cy="95" r="7"></circle>
			<text class="t-title" x="182" y="50">время <tspan class="t-num" data-t>0,0 с</tspan></text>
			<text class="t-title" x="182" y="78">оборотов <tspan class="t-num" data-n>0</tspan></text>
			<text class="t-strong" x="182" y="122" data-res1></text>
			<text class="t-strong" x="182" y="146" data-res2></text>
		</svg>
		<button type="button" class="g7__btn g7__again" data-again>Повторить</button>
	</div>
	<figcaption class="g7__caption">Колесо делает один оборот за 2 с; время идёт как в жизни. Красный катафот на спице помогает считать обороты.</figcaption>
</figure>

<style is:global>
	.per__tyre {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 9;
	}
	.per__rim {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 3;
	}
	.per__spoke {
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.per__hub {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
	}
	.per__refl {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.per .g7__grid {
		max-width: 26rem;
	}
	.per .g7__again {
		justify-self: center;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	for (const root of document.querySelectorAll<HTMLElement>('[data-per]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		scene(root, 10, (x) => {
			const t = x * 10;
			$('[data-wheel]').setAttribute('transform', `rotate(${((t / 2) * 360).toFixed(1)} 95 95)`);
			$('[data-t]').textContent = `${t.toFixed(1).replace('.', ',')} с`;
			$('[data-n]').textContent = String(Math.floor(t / 2 + 1e-6));
			$('[data-res1]').textContent = x >= 1 ? 'T = 10 с : 5 = 2 с' : '';
			$('[data-res2]').textContent = x >= 1 ? 'ν = 5 : 10 с = 0,5 с⁻¹' : '';
		});
	}
</script>
