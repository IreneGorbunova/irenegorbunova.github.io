---
/**
 * «Координаты точки на окружности»: axes Ox, Oy through the center O, a circle of radius R = 2 м (45 px per м, equal
 * scales, 90 px). A point moves counterclockwise with the period T = 8 с (ω = 2π/8 = π/4 ≈ 0,785 рад/с) from φ₀ = 30°,
 * real time; t runs 0…8 с and repeats. Shown: the radius-vector r⃗ from O (dark gray), the angle φ from Ox (an arc; after
 * a full turn a second, larger arc), the dashed drops to the axes, the projections x = R cos φ on Ox (--ig-vx) and
 * y = R sin φ on Oy (--ig-vy) as thick segments with their «shadow» dots running back and forth along the axes.
 * Readouts: t, φ = φ₀ + ωt (in degrees and radians, not reduced to one turn), x and y with one decimal:
 * t = 0: 30°, x 1,7 м, y 1,0 м; t = 2 с: 120°, −1,0; 1,7; t = 4 с: 210°, −1,7; −1,0; t = 6 с: 300°, 1,0; −1,7.
 * «Пауза» stops the clock (to read the numbers), «С начала» starts from t = 0.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 coord not-content" data-coord>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 280 260" role="img" aria-label="Точка движется по окружности; её радиус-вектор, угол поворота и проекции на оси координат" data-svg>
			<line class="coord__axis" x1="20" y1="130" x2="266" y2="130"></line>
			<line class="coord__axis" x1="140" y1="248" x2="140" y2="12"></line>
			<path class="coord__axhead" d="M270 130 L260 125.5 L260 134.5 Z M140 8 L135.5 18 L144.5 18 Z"></path>
			<text class="t-title" x="258" y="148">x</text>
			<text class="t-title" x="148" y="20">y</text>
			<text class="t-small" x="128" y="145">O</text>
			<circle class="coord__circle" cx="140" cy="130" r="90"></circle>
			<path class="coord__tick" d="M230 126 V134 M50 126 V134 M136 40 H144 M136 220 H144"></path>
			<text class="t-small" x="226" y="146">2</text>
			<text class="t-small" x="40" y="146">−2</text>
			<text class="t-small" x="148" y="44">2</text>
			<text class="t-small" x="148" y="224">−2</text>
			<text class="t-small" x="266" y="122" text-anchor="end">м</text>
			<g data-draw></g>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn" data-pause>Пауза</button>
				<button type="button" class="g7__btn" data-restart>С начала</button>
			</div>
			<ul class="g7__read" aria-live="off">
				<li><span>Время <i>t</i></span><b data-t></b></li>
				<li><span>Угол <i>φ</i></span><b data-phi></b></li>
				<li class="is-key"><span><i>x</i> = <i>R</i> cos <i>φ</i></span><b data-x></b></li>
				<li class="is-key"><span><i>y</i> = <i>R</i> sin <i>φ</i></span><b data-y></b></li>
			</ul>
			<p class="g7__note"><i>R</i> = 2 м, <i>T</i> = 8 с, <i>φ</i><sub>0</sub> = 30°</p>
		</div>
	</div>
	<figcaption class="g7__caption">Точка движется по окружности против часовой стрелки, оборот за 8&nbsp;с. Серая стрелка — радиус-вектор, проведённый из центра; синий отрезок — координата <i>x</i>, красный — координата <i>y</i>. Тени точки на осях бегают туда и обратно.</figcaption>
</figure>

<style is:global>
	.coord__axis {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.coord__axhead {
		fill: var(--g7-ink);
	}
	.coord__circle {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.coord__tick {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.coord__rv {
		stroke: color-mix(in oklab, var(--sl-color-gray-2) 80%, var(--sl-color-gray-4));
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.coord__rvhead {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 80%, var(--sl-color-gray-4));
	}
	.coord__vec {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.coord__drop {
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.coord__px {
		stroke: var(--ig-vx);
		stroke-width: 5;
		stroke-linecap: round;
		opacity: 0.85;
	}
	.coord__py {
		stroke: var(--ig-vy);
		stroke-width: 5;
		stroke-linecap: round;
		opacity: 0.85;
	}
	.coord__sx {
		fill: var(--ig-vx);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	.coord__sy {
		fill: var(--ig-vy);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	.coord__ang {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.3;
	}
	.coord__pt {
		fill: var(--sl-color-white);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	:root[data-theme='light'] .coord__pt {
		fill: #fff;
	}
</style>

<script>
	import { el, fmt, loop } from '../g7/kit';

	const CX = 140;
	const CY = 130;
	const K = 45; // px per м
	const R = 2;
	const T = 8;
	const W = (2 * Math.PI) / T;
	const PHI0 = Math.PI / 6;
	for (const root of document.querySelectorAll<HTMLElement>('[data-coord]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const g = $('[data-draw]');
		let t = 0;
		let run = true;
		const text = (x: number, y: number, s: string, cls = 't-small') => {
			const tt = el('text', { class: cls, x: x.toFixed(1), y: y.toFixed(1) });
			tt.innerHTML = s;
			return tt;
		};
		const draw = () => {
			const phi = PHI0 + W * t;
			const x = R * Math.cos(phi);
			const y = R * Math.sin(phi);
			const P = { x: CX + x * K, y: CY - y * K };
			g.replaceChildren();
			// the angle: one arc for the first turn, a larger second arc beyond 360°
			const arc = (a0: number, a1: number, r: number) => {
				const n = Math.max(2, Math.ceil((a1 - a0) / 0.05));
				let d = '';
				for (let i = 0; i <= n; i++) {
					const a = a0 + ((a1 - a0) * i) / n;
					d += `${i ? 'L' : 'M'}${(CX + r * Math.cos(a)).toFixed(1)} ${(CY - r * Math.sin(a)).toFixed(1)} `;
				}
				return d;
			};
			g.append(el('path', { class: 'coord__ang', d: arc(0, Math.min(phi, 2 * Math.PI), 18) }));
			if (phi > 2 * Math.PI) g.append(el('path', { class: 'coord__ang', d: arc(2 * Math.PI, phi, 25) }));
			const mid = Math.min(phi, 2 * Math.PI) / 2;
			g.append(text(CX + 30 * Math.cos(mid) - 4, CY - 30 * Math.sin(mid) + 4, '<tspan class="t-i">φ</tspan>'));
			// drops and projections
			g.append(el('line', { class: 'coord__drop', x1: P.x, y1: P.y, x2: P.x, y2: CY }));
			g.append(el('line', { class: 'coord__drop', x1: P.x, y1: P.y, x2: CX, y2: P.y }));
			g.append(el('line', { class: 'coord__px', x1: CX, y1: CY, x2: P.x, y2: CY }));
			g.append(el('line', { class: 'coord__py', x1: CX, y1: CY, x2: CX, y2: P.y }));
			// the radius-vector
			const L = R * K;
			const ux = (P.x - CX) / L;
			const uy = (P.y - CY) / L;
			g.append(el('line', { class: 'coord__rv', x1: CX, y1: CY, x2: P.x - ux * 8, y2: P.y - uy * 8 }));
			g.append(el('path', { class: 'coord__rvhead', d: `M${P.x - ux * 11 - uy * 4.5} ${P.y - uy * 11 + ux * 4.5} L${P.x - ux * 2.5} ${P.y - uy * 2.5} L${P.x - ux * 11 + uy * 4.5} ${P.y - uy * 11 - ux * 4.5} Z` }));
			const lx = CX + 0.55 * (P.x - CX) - uy * 10;
			const ly = CY + 0.55 * (P.y - CY) + ux * 10;
			g.append(text(lx - 4, ly + 4, '<tspan class="t-i">r</tspan>', 't-title'));
			g.append(el('path', { class: 'coord__vec', d: `M${(lx - 4).toFixed(1)} ${(ly - 8).toFixed(1)} h7 m-2.5 -2.2 l2.5 2.2 l-2.5 2.2` }));
			g.append(el('circle', { class: 'coord__sx', cx: P.x, cy: CY, r: 4.2 }));
			g.append(el('circle', { class: 'coord__sy', cx: CX, cy: P.y, r: 4.2 }));
			g.append(el('circle', { class: 'coord__pt', cx: P.x, cy: P.y, r: 5 }));
			$('[data-t]').textContent = `${fmt(t, 1)} с`;
			const deg = (phi * 180) / Math.PI;
			$('[data-phi]').textContent = `${fmt(deg, 0)}° = ${fmt(phi, 2)} рад`;
			const one = (v: number) => (Math.abs(v) < 0.05 ? '0,0' : fmt(v, 1));
			$('[data-x]').textContent = `${one(x)} м`;
			$('[data-y]').textContent = `${one(y)} м`;
		};
		const pauseBtn = $<HTMLButtonElement>('[data-pause]');
		pauseBtn.addEventListener('click', () => {
			run = !run;
			pauseBtn.textContent = run ? 'Пауза' : 'Пуск';
			pauseBtn.setAttribute('aria-pressed', String(!run));
			if (run) wake();
		});
		$('[data-restart]').addEventListener('click', () => {
			t = 0;
			draw();
			wake();
		});
		const wake = loop(root, (dt) => {
			if (run) {
				t += dt;
				if (t >= T) t -= T;
			}
			draw();
			return run;
		});
		draw();
	}
</script>
