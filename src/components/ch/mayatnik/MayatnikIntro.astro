---
/**
 * Two short looping opening scenes of «Колебательное движение. Маятник». No terms of the chapter in the pictures;
 * the captions' popovers explain.
 * Swings: two swings side by side, seen from the side, one scale (80 px per metre): ropes of 1 m and of 2,25 m, seats
 *   at the same height. Released together from 20°, they swing in real time with T = 2π√(l/g): 2,01 s and 3,01 s.
 *   The counters show how many times each has swung there and back; after 6,02 s the short one has done it 3 times,
 *   the long one 2 times, and they are in step again.
 * Branch: a sparrow (about 30 g) sits near the end of an elastic branch and bends it by 20 px (600 px per metre, so
 *   about 3,3 cm). The bird flies off, and the branch swings about its unloaded shape with f = 3 Hz and the
 *   damping ratio 0,06: w(t) = 20·e^(−ζωt)·cos(ω_d·t), so the swings shrink while each lasts the same time.
 *   The shape of the bent branch is the shape of a cantilever loaded at its end, ξ²(3 − ξ)/2.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const legs = (x: number, y: number, spread: number) => `M${x - spread} 226 L${x} ${y} L${x + spread} 226`;
---

<IntroFrame data-mp-intro>
	<div class="intro__card" data-scene="swings">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Двое качелей отпустили одновременно: у одних верёвки длиной 1 метр, у других — 2,25 метра. Короткие качаются чаще: пока они трижды качнулись туда и обратно, длинные — только дважды">
			<rect class="mi-sky" x="0" y="0" width="360" height="226"></rect>
			<rect class="mi-ground" x="0" y="226" width="360" height="14"></rect>
			<line class="mi-edge" x1="0" y1="226" x2="360" y2="226"></line>
			<path class="mi-frame" d={legs(100, 122, 42)}></path>
			<path class="mi-frame" d={legs(250, 22, 74)}></path>
			<g data-swing="0">
				<line class="mi-rope" x1="100" y1="122" x2="100" y2="202"></line>
				<g transform="translate(100 202)">
					<line class="mi-legs" x1="2" y1="-2" x2="14" y2="-2"></line>
					<line class="mi-legs" x1="14" y1="-2" x2="16" y2="12"></line>
					<line class="mi-body" x1="0" y1="-4" x2="-2" y2="-22"></line>
					<circle class="mi-head" cx="-2" cy="-30" r="7"></circle>
					<line class="mi-seat" x1="-11" y1="1" x2="11" y2="1"></line>
				</g>
			</g>
			<g data-swing="1">
				<line class="mi-rope" x1="250" y1="22" x2="250" y2="202"></line>
				<g transform="translate(250 202)">
					<line class="mi-legs" x1="2" y1="-2" x2="15" y2="-2"></line>
					<line class="mi-legs" x1="15" y1="-2" x2="17" y2="13"></line>
					<line class="mi-body" x1="0" y1="-4" x2="-2" y2="-25"></line>
					<circle class="mi-head" cx="-2" cy="-34" r="8"></circle>
					<line class="mi-seat" x1="-11" y1="1" x2="11" y2="1"></line>
				</g>
			</g>
			<circle class="mi-pivot" cx="100" cy="122" r="3"></circle>
			<circle class="mi-pivot" cx="250" cy="22" r="3"></circle>
			<text class="mi-label" x="12" y="150">1 м</text>
			<text class="mi-label" x="352" y="112" text-anchor="end">2,25 м</text>
			<rect class="mi-pill" x="58" y="84" width="84" height="24" rx="12"></rect>
			<text class="mi-read" x="100" y="101" text-anchor="middle" data-count="0">0 раз</text>
			<rect class="mi-pill" x="266" y="8" width="84" height="24" rx="12"></rect>
			<text class="mi-read" x="308" y="25" text-anchor="middle" data-count="1">0 раз</text>
		</svg>
		<div class="intro__foot">
			<p>Двое качелей отпустили одновременно. Пока короткие качели трижды качнулись туда и обратно, длинные — только дважды: <More term="чем длиннее верёвки, тем медленнее качаются качели">У коротких качелей верёвки длиной 1&nbsp;м, у длинных — 2,25&nbsp;м, в 2,25&nbsp;раза длиннее. А качание туда и обратно длится не в 2,25, а только в 1,5&nbsp;раза дольше: 3&nbsp;с вместо 2&nbsp;с. От того, лёгкий или тяжёлый человек сидит на качелях, это время почти не зависит. Подробнее — в разделе <a href="#от-чего-зависит-период-маятника">«От чего зависит период маятника»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="branch">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Птица сидит на конце ветки, и ветка прогнулась. Птица улетает, и ветка несколько раз качается вверх и вниз, всё слабее и слабее, пока не остановится">
			<rect class="mi-sky" x="0" y="0" width="360" height="240"></rect>
			<path class="mi-trunk" d="M0 0 L26 0 Q20 120 30 240 L0 240 Z"></path>
			<line class="mi-rest" x1="24" y1="124" x2="324" y2="124" data-rest></line>
			<path class="mi-branch" data-branch></path>
			<g data-leaves>
				{[0.3, 0.5, 0.68, 0.86].map((_, i) => (
					<path class="mi-leaf" d={i % 2 ? 'M0 0 Q8 10 0 24 Q-8 10 0 0 Z' : 'M0 0 Q8 -10 0 -24 Q-8 -10 0 0 Z'} />
				))}
			</g>
			<g data-bird>
				<path class="mi-tail" d="M-14 -8 L-30 -16 L-28 -6 Z"></path>
				<ellipse class="mi-bird" cx="0" cy="-10" rx="16" ry="10"></ellipse>
				<path class="mi-breast" d="M6 -16 Q16 -8 6 0 Q0 -8 6 -16 Z"></path>
				<circle class="mi-bird" cx="13" cy="-20" r="7.5"></circle>
				<circle class="mi-eye" cx="16" cy="-22" r="1.4"></circle>
				<path class="mi-beak" d="M20 -21 L27 -18 L20 -16 Z"></path>
				<path class="mi-wing" d="M-8 -12 Q2 -18 10 -10 Q0 -4 -8 -12 Z" data-wing></path>
				<line class="mi-foot" x1="-2" y1="-1" x2="-3" y2="3"></line>
				<line class="mi-foot" x1="4" y1="-1" x2="5" y2="3"></line>
			</g>
		</svg>
		<div class="intro__foot">
			<p>С ветки вспорхнула птица, и ветка ещё несколько раз качнулась вверх и вниз. <More term="Размах всё меньше, а каждое качание длится столько же">Ветка упругая, как пружина: согнутая, она тянется обратно, а разогнавшись, по инерции проскакивает своё прежнее положение. Размах уменьшается, потому что энергия понемногу уходит на трение — внутри самой ветки и о воздух. Подробнее — в разделах <a href="#колебательное-движение">«Колебательное движение»</a> и <a href="#затухающие-колебания-резонанс">«Затухающие колебания. Резонанс»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.mi-sky {
		fill: color-mix(in srgb, var(--ig-vx) 10%, transparent);
	}
	.mi-ground {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.mi-edge {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.mi-frame {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 5;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.mi-pivot {
		fill: var(--sl-color-gray-1);
	}
	.mi-rope {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.mi-seat {
		stroke: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-3));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.mi-body {
		stroke: var(--ig-vx);
		stroke-width: 9;
		stroke-linecap: round;
	}
	.mi-legs {
		stroke: color-mix(in srgb, var(--ig-vx) 55%, var(--sl-color-gray-3));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.mi-head {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-3));
	}
	[data-swing='1'] .mi-body {
		stroke: var(--ig-vy);
	}
	[data-swing='1'] .mi-legs {
		stroke: color-mix(in srgb, var(--ig-vy) 55%, var(--sl-color-gray-3));
	}
	.mi-label {
		font-size: 14px;
		font-weight: 600;
		fill: var(--sl-color-gray-2);
	}
	.mi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.mi-read {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	/* branch scene */
	.mi-trunk {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.mi-branch {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-4));
		stroke: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-3));
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mi-rest {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 4 4;
		opacity: 0;
	}
	.mi-leaf {
		fill: color-mix(in srgb, hsl(130, 45%, 45%) 70%, var(--sl-color-gray-4));
	}
	.mi-bird {
		fill: var(--sl-color-gray-3);
	}
	.mi-breast {
		fill: color-mix(in srgb, var(--ig-vy) 60%, var(--sl-color-gray-3));
	}
	.mi-tail,
	.mi-wing {
		fill: var(--sl-color-gray-2);
	}
	.mi-eye {
		fill: var(--sl-color-black);
	}
	.mi-beak {
		fill: var(--ig-v);
	}
	.mi-foot {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const f = (v: number) => v.toFixed(1);
	const times = (n: number) => `${n} ${n === 2 || n === 3 || n === 4 ? 'раза' : 'раз'}`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-mp-intro]')) {
		// ---------- Swings: 6,02 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="swings"]')!;
			const SW = [
				{ px: 100, py: 122, l: 1 },
				{ px: 250, py: 22, l: 2.25 },
			].map((s, i) => ({
				...s,
				T: 2 * Math.PI * Math.sqrt(s.l / 9.8),
				g: card.querySelector<SVGGElement>(`[data-swing="${i}"]`)!,
				count: card.querySelector<SVGTextElement>(`[data-count="${i}"]`)!,
			}));
			const RUN = 3 * SW[0].T; // = 2 · SW[1].T
			const TH0 = 20;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				for (const s of SW) {
					const th = TH0 * Math.cos((2 * Math.PI * t) / s.T);
					s.g.setAttribute('transform', `rotate(${f(-th)} ${s.px} ${s.py})`);
					const n = Math.floor(t / s.T + 1e-3);
					const txt = times(n);
					if (s.count.textContent !== txt) s.count.textContent = txt;
				}
			});
		}

		// ---------- Branch: 4,5 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="branch"]')!;
			const branch = card.querySelector<SVGPathElement>('[data-branch]')!;
			const leaves = Array.from(card.querySelectorAll<SVGPathElement>('[data-leaves] path'));
			const bird = card.querySelector<SVGGElement>('[data-bird]')!;
			const wing = card.querySelector<SVGPathElement>('[data-wing]')!;
			const LEAF = [0.3, 0.5, 0.68, 0.86];
			const X0 = 24;
			const LEN = 300;
			const Y0 = 128; // the branch rises a little towards its end: y0 = Y0 − 8ξ
			const SAG = 20; // px, the bend under the bird
			const W = 2 * Math.PI * 3; // 3 Hz
			const ZETA = 0.06;
			const WD = W * Math.sqrt(1 - ZETA * ZETA);
			const shape = (xi: number) => (xi * xi * (3 - xi)) / 2;
			const at = (xi: number, w: number) => ({ x: X0 + LEN * xi, y: Y0 - 8 * xi + w * shape(xi) });
			const slope = (xi: number, w: number) => (-8 + w * ((6 * xi - 3 * xi * xi) / 2)) / LEN; // dy/dx
			const BIRD_XI = 0.9;
			const OFF = 0.6; // s, when the bird flies off
			const RUN = 4.5;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const tt = t - OFF;
				const w = tt < 0 ? SAG : SAG * Math.exp(-ZETA * W * tt) * Math.cos(WD * tt);
				// the branch: a tapered strip around its centre line
				const top: string[] = [];
				const bot: string[] = [];
				for (let i = 0; i <= 24; i++) {
					const xi = i / 24;
					const p = at(xi, w);
					const k = slope(xi, w);
					const n = Math.hypot(1, k);
					const h = (9 - 7 * xi) / 2;
					top.push(`${f(p.x + (k * h) / n)} ${f(p.y - h / n)}`);
					bot.push(`${f(p.x - (k * h) / n)} ${f(p.y + h / n)}`);
				}
				branch.setAttribute('d', `M${top.join(' L')} L${bot.reverse().join(' L')} Z`);
				LEAF.forEach((xi, i) => {
					const p = at(xi, w);
					const a = (Math.atan(slope(xi, w)) * 180) / Math.PI + (i % 2 ? -25 : 25);
					leaves[i].setAttribute('transform', `translate(${f(p.x)} ${f(p.y)}) rotate(${f(a)})`);
				});
				// the bird: sits, then flies up and to the right, flapping
				const perch = at(BIRD_XI, w);
				if (tt < 0) {
					const a = (Math.atan(slope(BIRD_XI, w)) * 180) / Math.PI;
					bird.setAttribute('transform', `translate(${f(perch.x)} ${f(perch.y - 3)}) rotate(${f(a)}) scale(1.3)`);
					wing.setAttribute('transform', '');
					bird.style.opacity = '1';
				} else {
					const p0 = at(BIRD_XI, SAG);
					const bx = p0.x + 120 * tt + 60 * tt * tt;
					const by = p0.y - 3 - 110 * tt - 40 * tt * tt;
					bird.setAttribute('transform', `translate(${f(bx)} ${f(by)}) rotate(-18) scale(1.3)`);
					const flap = Math.sin(tt * 2 * Math.PI * 9);
					wing.setAttribute('transform', `translate(1 -12) scale(1 ${f(flap * 2.2)}) translate(-1 12)`);
					bird.style.opacity = bx > 400 || by < -40 ? '0' : '1';
				}
			});
		}
	}
</script>
