</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, type FigurePose } from '@components/people/body';
	import { ROLL } from '@components/people/hand';
	import { mk } from '@components/people/core';

	const f = (v: number) => v.toFixed(1);
	const times = (n: number) => `${n} ${n === 2 || n === 3 || n === 4 ? 'раза' : 'раз'}`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-mp-intro]')) {
		// ---------- Swings: 6,02 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="swings"]')!;
			const S = 0.72; // px per см (72 px per metre)
			const OFF = { x: 4, y: -3.5 };
			const SEAT = 196; // seat top, 0,5 м above the ground (y 232)
			const riders = [
				{ H: 116, age: 'child' as const, shirt: 'hm-red', hair: 'pony' as const, shorts: true, name: 'girl on the short swing', legs: [[0.05, 1.1], [0.12, 1.25]] as [number, number][], lean: -0.25 },
				{ H: 156, age: 'teen' as const, shirt: 'hm-blue', hair: 'short' as const, shorts: false, name: 'boy on the long swing', legs: [[0.1, 1.4], [0.16, 1.5]] as [number, number][], lean: -0.25 },
			];
			const SW = [
				{ px: 78, l: 1 },
				{ px: 250, l: 2.25 },
			].map((s, i) => {
				const g = card.querySelector<SVGGElement>(`[data-swing="${i}"]`)!;
				const r = riders[i];
				const fig = figure(g.querySelector<SVGGElement>('[data-rider]')!, { s: S, H: r.H, age: r.age, shirt: r.shirt, hair: r.hair, shorts: r.shorts, name: r.name });
				const L = (s.l + (0.12 * r.H) / 100) * 100 * S; // rope in px: to the center of mass plus 0,12 H
				return {
					...s,
					L,
					py: SEAT - L,
					T: 2 * Math.PI * Math.sqrt(s.l / 9.8),
					g,
					r,
					fig,
					ropeFar: g.querySelector<SVGPathElement>('[data-rope-far]')!,
					ropeHi: g.querySelector<SVGPathElement>('[data-rope-hi]')!,
					ropeLo: g.querySelector<SVGPathElement>('[data-rope-lo]')!,
					seat: g.querySelector<SVGPathElement>('[data-seat]')!,
					seatFar: g.querySelector<SVGPathElement>('[data-seat-far]')!,
					shadow: card.querySelector<SVGEllipseElement>(`[data-shadow="${i}"]`)!,
					label: card.querySelector<SVGGElement>(`[data-rope-label="${i}"]`)!,
					count: card.querySelector<SVGTextElement>(`[data-count="${i}"]`)!,
				};
			});
			// the mother on the path behind, farther away
			const MS = 0.42;
			const mom = figure(card.querySelector<SVGGElement>('[data-mother]')!, { s: MS, H: 168, shirt: 'hm-green', hair: 'pony', name: 'mother' });
			const mu = 168 * MS;
			const MX = 140;
			const MY = 201; // her soles
			const momPose: FigurePose = {
				hip: { x: MX, y: MY - 0.52 * mu },
				lean: 0,
				head: 0.1,
				ankles: [
					{ x: MX + 2, y: MY - 7 * MS },
					{ x: MX - 3, y: MY - 7 * MS - 0.6 },
				],
				feet: [0, 0],
				hands: [
					{ arm: [Math.PI / 2 - 0.1, 0.25], pose: 'relaxed' },
					{ arm: [Math.PI / 2 + 0.08, 0.2], pose: 'relaxed' },
				],
				planted: [true, true],
			};

			const RUN = 3 * SW[0].T; // = 2 · SW[1].T, 6,02 s
			const TH0 = (20 * Math.PI) / 180;
			const draw = (x: number) => {
				const t = x * RUN;
				mom.pose(momPose);
				for (const s of SW) {
					const th = TH0 * Math.cos((2 * Math.PI * t) / s.T);
					// the group turns by −θ (SVG degrees): θ > 0 swings the seat to the right
					s.g.setAttribute('transform', `translate(${s.px} ${f(s.py)}) rotate(${(-th * 180 / Math.PI).toFixed(2)})`);
					s.label.setAttribute('transform', s.g.getAttribute('transform')!);
					// the far side in the group's own coordinates: OFF turned back by θ
					const c = Math.cos(th);
					const sn = Math.sin(th);
					const o = { x: OFF.x * c + OFF.y * sn, y: -OFF.x * sn + OFF.y * c };
					const L = s.L;
					const u = s.r.H * S;
					const hip = { x: -0.04 * u + o.x / 2, y: L - 0.07 * u + o.y / 2 };
					const gy = hip.y - 0.2 * u; // where the hands hold the ropes, at the chest
					s.ropeFar.setAttribute('d', `M${f(o.x)} ${f(o.y)} L${f(o.x)} ${f(L + o.y)}`);
					const st = s.fig.pose({
						hip,
						lean: s.r.lean,
						ankles: [hip, hip],
						legs: s.r.legs as [[number, number], [number, number]],
						feet: [0.25, 0.3],
						hands: [
							{ at: { x: 0, y: gy }, pose: 'grip', d: 1.6, dir: -0.25, roll: ROLL.backViewer, contact: 'near rope' },
							{ at: { x: o.x, y: gy + o.y - 1 }, pose: 'grip', d: 1.6, dir: -0.25, roll: ROLL.palmViewer, contact: 'far rope' },
						],
					});
					// the near rope: above and below the near hand (the hand wraps around it)
					const gp = st.grips[0];
					const gap = 0.045 * u;
					s.ropeHi.setAttribute('d', `M0 0 L0 ${f(gp.y - gap)}`);
					s.ropeLo.setAttribute('d', `M0 ${f(gp.y + gap)} L0 ${f(L)}`);
					// the plank: its near edge and its top toward the far rope
					s.seat.setAttribute('d', `M-9 ${f(L)} H9 V${f(L + 3)} H-9 Z`);
					s.seatFar.setAttribute('d', `M-9 ${f(L)} H9 L${f(9 + o.x)} ${f(L + o.y)} H${f(-9 + o.x)} Z`);
					s.shadow.setAttribute('cx', f(s.px + (L + 2) * Math.sin(th)));
					const n = Math.floor(t / s.T + 1e-3);
					const txt = times(n);
					if (s.count.textContent !== txt) s.count.textContent = txt;
				}
			};
			scene(card, RUN, draw);
		}

		// ---------- Branch: 4,5 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="branch"]')!;
			const branch = card.querySelector<SVGPathElement>('[data-branch]')!;
			const twigG = card.querySelector<SVGGElement>('[data-twigs]')!;
			const leafG = card.querySelector<SVGGElement>('[data-leaves]')!;
			const bird = card.querySelector<SVGGElement>('[data-bird]')!;
			const wing = card.querySelector<SVGGElement>('[data-wing]')!;
			const wingFar = card.querySelector<SVGGElement>('[data-wing-far]')!;
			const legs = card.querySelector<SVGGElement>('[data-legs]')!;
			const X0 = 30; // the root of the branch, hidden in the trunk (its edge at x ≈ 33)
			const LEN = 300;
			const Y0 = 128; // the branch rises a little towards its end: y0 = Y0 − 8ξ
			const SAG = 20; // px, the bend under the bird
			const W = 2 * Math.PI * 3; // 3 Hz
			const ZETA = 0.06;
			const WD = W * Math.sqrt(1 - ZETA * ZETA);
			const shape = (xi: number) => (xi * xi * (3 - xi)) / 2;
			const at = (xi: number, w: number) => ({ x: X0 + LEN * xi, y: Y0 - 8 * xi + w * shape(xi) });
			const slope = (xi: number, w: number) => (-8 + w * ((6 * xi - 3 * xi * xi) / 2)) / LEN; // dy/dx
			const half = (xi: number) => (10 - 7.5 * xi) / 2; // half the thickness
			// twigs: where they grow (ξ), their angle to the branch (deg, negative = up), length
			const TWIGS = [
				{ xi: 0.2, a: -38, l: 26 },
				{ xi: 0.34, a: 32, l: 22 },
				{ xi: 0.5, a: -30, l: 28 },
				{ xi: 0.63, a: 36, l: 24 },
				{ xi: 0.74, a: -44, l: 22 },
				{ xi: 0.84, a: 34, l: 18 },
				{ xi: 1, a: 0, l: 12 },
			];
			const LEAF = 'M0 0 Q6 -6 15 -5 Q24 -3 28 0 Q24 3 15 5 Q6 6 0 0 Z';
			const VEIN = 'M1 0 H25 M8 0 L13 -3 M14 0 L19 -3 M8 0 L13 3 M14 0 L19 3';
			type Lf = { g: SVGGElement; twig: number; along: number; a: number; s: number };
			const twigPaths = TWIGS.map(() => mk(twigG, 'path', { class: 'mi-twig' }));
			const leaves: Lf[] = [];
			TWIGS.forEach((tw, i) => {
				const spots = tw.xi === 1 ? [{ along: 1, a: 0 }] : [{ along: 1, a: 0 }, { along: 0.55, a: 45 }, { along: 0.55, a: -45 }];
				spots.forEach((sp, j) => {
					const g = mk(leafG, 'g', {});
					mk(g, 'path', { class: (i + j) % 2 ? 'mi-leaf mi-leaf--2' : 'mi-leaf', d: LEAF });
					mk(g, 'path', { class: 'mi-vein', d: VEIN });
					leaves.push({ g, twig: i, along: sp.along, a: sp.a, s: 0.75 + (0.25 * ((i * 3 + j) % 3)) / 2 });
				});
			});
			const BIRD_XI = 0.9;
			const BS = 1.6; // the bird's drawing is 47 units from beak to tail: 75 px
			const OFF_T = 0.6; // s, when the bird flies off
			const RUN = 4.5;
			const deg = (r: number) => (r * 180) / Math.PI;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const tt = t - OFF_T;
				const w = tt < 0 ? SAG : SAG * Math.exp(-ZETA * W * tt) * Math.cos(WD * tt);
				// the branch: a tapered strip around its center line
				const top: string[] = [];
				const bot: string[] = [];
				for (let i = 0; i <= 30; i++) {
					const xi = i / 30;
					const p = at(xi, w);
					const k = slope(xi, w);
					const n = Math.hypot(1, k);
					const h = half(xi);
					top.push(`${f(p.x + (k * h) / n)} ${f(p.y - h / n)}`);
					bot.push(`${f(p.x - (k * h) / n)} ${f(p.y + h / n)}`);
				}
				const tip = at(1, w);
				branch.setAttribute('d', `M${top.join(' L')} Q${f(tip.x + 3)} ${f(tip.y)} ${bot.reverse().join(' L')} Z`);
				// twigs and leaves, carried by the local slope of the branch
				const ends = TWIGS.map((tw, i) => {
					const p = at(tw.xi, w);
					const a = Math.atan(slope(tw.xi, w)) + (tw.a * Math.PI) / 180;
					twigPaths[i].setAttribute('d', `M${f(p.x)} ${f(p.y)} L${f(p.x + tw.l * Math.cos(a))} ${f(p.y + tw.l * Math.sin(a))}`);
					return { p, a };
				});
				for (const lf of leaves) {
					const tw = TWIGS[lf.twig];
					const { p, a } = ends[lf.twig];
					const q = { x: p.x + tw.l * lf.along * Math.cos(a), y: p.y + tw.l * lf.along * Math.sin(a) };
					lf.g.setAttribute('transform', `translate(${f(q.x)} ${f(q.y)}) rotate(${f(deg(a) + lf.a)}) scale(${lf.s.toFixed(2)})`);
				}
				// the bird: sits on top of the branch, then flies up and to the right, flapping
				if (tt < 0) {
					const p = at(BIRD_XI, w);
					const k = slope(BIRD_XI, w);
					const n = Math.hypot(1, k);
					const h = half(BIRD_XI);
					bird.setAttribute('transform', `translate(${f(p.x + (k * h) / n)} ${f(p.y - h / n)}) rotate(${f(deg(Math.atan(k)))}) scale(${BS})`);
					wing.setAttribute('transform', '');
					wingFar.style.opacity = '0';
					legs.style.opacity = '1';
					bird.style.opacity = '1';
				} else {
					const p0 = at(BIRD_XI, SAG);
					const bx = p0.x + 120 * tt + 60 * tt * tt;
					const by = p0.y - half(BIRD_XI) - 110 * tt - 40 * tt * tt;
					bird.setAttribute('transform', `translate(${f(bx)} ${f(by)}) rotate(-18) scale(${BS})`);
					// the wings beat about the shoulder (2, −18), 9 times a second
					const flap = Math.sin(tt * 2 * Math.PI * 9);
					wing.setAttribute('transform', `translate(2 -18) scale(1 ${f(1.6 * flap)}) translate(-2 18)`);
					wingFar.setAttribute('transform', `translate(2 -18) scale(1 ${f(1.3 * flap)}) translate(-2 18)`);
					wingFar.style.opacity = '1';
					legs.style.opacity = tt < 0.08 ? '1' : '0';
					bird.style.opacity = bx > 420 || by < -60 ? '0' : '1';
				}
			});
		}
	}
</script>
