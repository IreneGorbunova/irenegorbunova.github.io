---
/**
 * Two short looping opening scenes of «Колебательное движение. Маятник». No terms of the chapter in the pictures or in
 * the visible captions; each caption's popover explains and links to its section.
 *
 * Swings (a playground in a park, side view, real time, 6,02 s). Two swings side by side at one scale, 72 px per metre,
 *   plank seats 0,5 м above the ground. Seen a little from the side, so each A-frame has a far twin 4 px right and
 *   3,5 px up, and every swing two ropes (the far ones darker). A girl of 7 (people kit, child, 116 см) sits on the short
 *   swing, a boy of 14 (teen, 156 см) on the long one; both hold the ropes with both hands (mittens at this scale: the
 *   hands are about 9 and 12 px long) and let their legs hang bent at the knee. The lengths 1 м and 2,25 м are taken
 *   from the pivot to the rider's center of mass, which sits about 0,12 H above the seat (14 and 19 см), so the ropes are
 *   drawn that much longer. Each swing is a simple pendulum released from 20°: θ(t) = 20°·cos(2πt/T), T = 2π√(l/g) =
 *   2,01 с and 3,01 с (the rider's own size would add about 3 % and 1 %, left out). The counters show how many times each
 *   swing has gone there and back: after 6,02 s the short one has done it 3 times, the long one 2 times, and they are in
 *   step again. A mother (adult, 168 см) watches from the path behind, farther away (0,42 px per см); she does not push.
 * Branch (a garden, 4,5 s, real time). A house sparrow (about 30 г, 15 см from beak to tail: drawn 75 px long at 1,6
 *   times its drawing) sits near the end of an elastic branch 0,5 м long (600 px per metre, so the branch is 300 px) and
 *   bends it by 20 px, about 3,3 см (stiffness at the tip k = mg/δ ≈ 9 Н/м). At 0,6 s the bird flies off, and the branch
 *   swings about its unloaded shape with f = 3 Hz (an effective mass at the tip of k/(2πf)² ≈ 25 г) and the damping
 *   ratio 0,06: w(t) = 20·e^(−ζωt)·cos(ω_d·t), so the swings shrink while each lasts the same time. The shape of the bent
 *   branch is that of a cantilever loaded at its end, ξ²(3 − ξ)/2; its twigs and leaves are carried along rigidly,
 *   turned by the local slope. The push of the bird's legs at take-off is left out.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const rnd = (i: number, k: number) => {
	const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
	return r - Math.floor(r);
};
const f1 = (v: number) => v.toFixed(1);
// ---------- swings: the static park
const GY = 232; // ground line under the near feet of the frames
const OFF = { x: 4, y: -3.5 }; // the far side of everything, seen a little from the side
// pivots: seat top at 196 (0,5 м up), rope (l + 0,12 H)·72 px above it
const FRAMES = [
	{ px: 78, py: 114, half: 58 },
	{ px: 250, py: 20.5, half: 102 },
];
type Fr = (typeof FRAMES)[number];
const aFrame = (f: Fr, o = { x: 0, y: 0 }) => `M${f1(f.px - f.half + o.x)} ${f1(GY + o.y)} L${f1(f.px + o.x)} ${f1(f.py - 3 + o.y)} L${f1(f.px + f.half + o.x)} ${f1(GY + o.y)}`;
const brace = (f: Fr, o = { x: 0, y: 0 }) => {
	const k = 0.74; // the cross bar at 74 % of the way down
	const y = f.py - 3 + (GY - f.py + 3) * k;
	return `M${f1(f.px - f.half * k + o.x)} ${f1(y + o.y)} L${f1(f.px + f.half * k + o.x)} ${f1(y + o.y)}`;
};
const trees = [
	{ x: 10, y: 150, r: 22 },
	{ x: 44, y: 156, r: 16 },
	{ x: 168, y: 152, r: 19 },
	{ x: 204, y: 157, r: 14 },
	{ x: 318, y: 148, r: 24 },
	{ x: 352, y: 156, r: 16 },
];
const flats = [
	{ x: 62, w: 54, h: 70 },
	{ x: 226, w: 70, h: 96 },
];
const windows = flats.flatMap((b, j) =>
	Array.from({ length: Math.floor((b.h - 8) / 12) * 4 }, (_, i) => ({
		x: b.x + 5 + (i % 4) * ((b.w - 10) / 4) + 1,
		y: 168 - b.h + 6 + Math.floor(i / 4) * 12,
		lit: rnd(i, j + 3) > 0.62,
	})),
);
const fencePosts = Array.from({ length: 31 }, (_, i) => 2 + i * 12);
const tufts = Array.from({ length: 46 }, (_, i) => ({ x: 4 + rnd(i, 7) * 352, y: 180 + rnd(i, 8) * 58 }));
// ---------- branch: the static garden
const bgLeaves = Array.from({ length: 26 }, (_, i) => ({
	x: 110 + rnd(i, 11) * 250,
	y: 4 + rnd(i, 12) * 40,
	a: -60 + rnd(i, 13) * 120,
	s: 0.7 + rnd(i, 14) * 0.4,
}));
const bark = Array.from({ length: 9 }, (_, i) => ({ x: 6 + (i % 3) * 9 + rnd(i, 21) * 4, y: rnd(i, 22) * 220, h: 14 + rnd(i, 23) * 18 }));
---

<PeopleStyles />
<IntroFrame data-mp-intro>
	<div class="intro__card" data-scene="swings">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Детская площадка в парке. Двое качелей отпустили одновременно: у одних верёвки длиной 1 метр, на них девочка, у других — 2,25 метра, на них мальчик. Короткие качаются чаще: пока они трижды качнулись туда и обратно, длинные — только дважды">
			<defs>
				<linearGradient id="mi-sky-g" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="mi-sky-top"></stop>
					<stop offset="1" class="mi-sky-bot"></stop>
				</linearGradient>
				<linearGradient id="mi-grass-g" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="mi-grass-far"></stop>
					<stop offset="1" class="mi-grass-near"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="170" fill="url(#mi-sky-g)"></rect>
			<circle class="mi-sun" cx="322" cy="70" r="14"></circle>
			<path class="mi-cloud" d="M14 52 q4 -12 16 -10 q6 -10 18 -4 q12 -2 12 10 q8 2 6 8 H14 q-6 -2 0 -4 Z"></path>
			<path class="mi-cloud" d="M140 30 q4 -10 14 -8 q6 -8 16 -2 q10 0 10 8 q6 2 4 6 H140 q-5 -2 0 -4 Z"></path>
			<!-- far blocks of flats and trees -->
			{flats.map((b) => <rect class="mi-flat" x={b.x} y={168 - b.h} width={b.w} height={b.h}></rect>)}
			{windows.map((w) => <rect class={w.lit ? 'mi-win mi-win--lit' : 'mi-win'} x={f1(w.x)} y={f1(w.y)} width="6" height="6"></rect>)}
			{trees.map((t) => <path class="mi-trunk-far" d={`M${t.x} ${t.y} V${t.y + t.r + 12}`}></path>)}
			{trees.map((t) => <ellipse class="mi-crown" cx={t.x} cy={t.y} rx={t.r} ry={t.r * 1.15}></ellipse>)}
			{trees.map((t) => <ellipse class="mi-crown-hi" cx={t.x - t.r * 0.3} cy={t.y - t.r * 0.35} rx={t.r * 0.45} ry={t.r * 0.4}></ellipse>)}
			<rect x="0" y="166" width="360" height="74" fill="url(#mi-grass-g)"></rect>
			<!-- the fence at the far edge of the playground -->
			<path class="mi-rail" d="M0 168 H360 M0 175 H360"></path>
			{fencePosts.map((x) => <path class="mi-post" d={`M${x} 164 V180`}></path>)}
			<!-- the path where the mother stands, the soft ground under the swings -->
			<path class="mi-path" d="M0 196 Q120 188 220 194 T360 192 V204 Q240 210 120 204 T0 208 Z"></path>
			{tufts.map((t) => <path class="mi-tuft" d={`M${f1(t.x)} ${f1(t.y)} l-2 -4 M${f1(t.x)} ${f1(t.y)} l1 -5 M${f1(t.x)} ${f1(t.y)} l3 -3`}></path>)}
			<ellipse class="mi-pad" cx="80" cy="234" rx="64" ry="7"></ellipse>
			<ellipse class="mi-pad" cx="252" cy="234" rx="106" ry="7"></ellipse>
			<g data-mother></g>
			<!-- far halves of the frames and the beams going into depth -->
			{FRAMES.map((fr) => <path class="mi-frame mi-frame--far" d={aFrame(fr, OFF)}></path>)}
			{FRAMES.map((fr) => <path class="mi-brace mi-frame--far" d={brace(fr, OFF)}></path>)}
			{FRAMES.map((fr) => <path class="mi-beam" d={`M${fr.px} ${f1(fr.py - 3)} L${f1(fr.px + OFF.x)} ${f1(fr.py - 3 + OFF.y)}`}></path>)}
			<!-- the swings: shadows on the ground, then each swing in its own group (turned about its pivot) -->
			<ellipse class="mi-shadow" data-shadow="0" cx="78" cy="234" rx="12" ry="2.6"></ellipse>
			<ellipse class="mi-shadow" data-shadow="1" cx="250" cy="234" rx="14" ry="2.8"></ellipse>
			{
				[0, 1].map((i) => (
					<g data-swing={i}>
						<path class="mi-rope mi-rope--far" data-rope-far />
						<path class="mi-seat-far" data-seat-far />
						<g data-rider />
						<path class="mi-seat" data-seat />
						<path class="mi-rope" data-rope-hi />
						<path class="mi-rope" data-rope-lo />
					</g>
				))
			}
			<!-- near halves of the frames, in front of the riders -->
			{FRAMES.map((fr) => <path class="mi-frame" d={aFrame(fr)}></path>)}
			{FRAMES.map((fr) => <path class="mi-brace" d={brace(fr)}></path>)}
			{FRAMES.map((fr) => <circle class="mi-pivot" cx={fr.px} cy={f1(fr.py - 1)} r="3.2"></circle>)}
			<!-- the lengths, written along the ropes and turning with them (in front of the frames) -->
			<g data-rope-label="0"><text class="mi-label mi-label--rope" transform="translate(6 24) rotate(90)">1 м</text></g>
			<g data-rope-label="1"><text class="mi-label mi-label--rope" transform="translate(6 48) rotate(90)">2,25 м</text></g>
			<rect class="mi-pill" x="36" y="78" width="84" height="24" rx="12"></rect>
			<text class="mi-read" x="78" y="95" text-anchor="middle" data-count="0">0 раз</text>
			<rect class="mi-pill" x="270" y="6" width="84" height="24" rx="12"></rect>
			<text class="mi-read" x="312" y="23" text-anchor="middle" data-count="1">0 раз</text>
		</svg>
		<div class="intro__foot">
			<p>Двое качелей отпустили одновременно. Пока короткие качели трижды качнулись туда и обратно, длинные — только дважды: <More term="чем длиннее верёвки, тем медленнее качаются качели">У коротких качелей верёвки длиной 1&nbsp;м, у длинных — 2,25&nbsp;м, в 2,25&nbsp;раза длиннее. А качание туда и обратно длится не в 2,25, а только в 1,5&nbsp;раза дольше: 3&nbsp;с вместо 2&nbsp;с. От того, лёгкий или тяжёлый человек сидит на качелях, это время почти не зависит. Подробнее — в разделе <a href="#от-чего-зависит-период-маятника">«От чего зависит период маятника»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="branch">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Воробей сидит на конце ветки, и ветка прогнулась. Воробей улетает, и ветка несколько раз качается вверх и вниз, всё слабее и слабее, пока не остановится">
			<defs>
				<linearGradient id="mi-bsky-g" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="mi-bsky-top"></stop>
					<stop offset="1" class="mi-bsky-bot"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill="url(#mi-bsky-g)"></rect>
			<!-- the garden below and behind: a house, a hedge -->
			<path class="mi-house" d="M196 240 L196 196 L262 160 L328 196 L328 240 Z"></path>
			<path class="mi-roof" d="M190 199 L262 158 L334 199 L328 202 L262 165 L196 202 Z"></path>
			<rect class="mi-gwin" x="246" y="200" width="30" height="24"></rect>
			<path class="mi-gwin-frame" d="M261 200 V224 M246 212 H276"></path>
			<path class="mi-hedge" d="M0 240 V214 Q20 200 44 210 Q70 196 96 210 Q124 198 150 212 Q170 204 196 214 V240 Z M328 240 V212 Q344 202 360 208 V240 Z"></path>
			<!-- a higher branch of the same tree, still -->
			<path class="mi-branch-far" d="M30 46 Q120 30 220 18 Q300 10 360 6 L360 12 Q300 18 222 26 Q124 40 32 58 Z"></path>
			{bgLeaves.map((l) => <path class="mi-leaf-far" transform={`translate(${f1(l.x)} ${f1(l.y)}) rotate(${f1(l.a)}) scale(${l.s.toFixed(2)})`} d="M0 0 Q7 9 0 22 Q-7 9 0 0 Z"></path>)}
			<line class="mi-rest" x1="30" y1="124" x2="330" y2="124" data-rest></line>
			<g data-twigs></g>
			<path class="mi-branch" data-branch></path>
			<g data-leaves></g>
			<!-- the trunk, over the root of the branch -->
			<path class="mi-trunk" d="M0 0 L36 0 Q30 70 34 120 Q30 180 40 240 L0 240 Z"></path>
			{bark.map((b) => <path class="mi-bark" d={`M${f1(b.x)} ${f1(b.y)} q2 ${f1(b.h / 2)} 0 ${f1(b.h)}`}></path>)}
			<path class="mi-knot" d="M30 112 Q38 118 30 132"></path>
			<g data-bird>
				<g data-wing-far>
					<path class="mi-b-wing mi-b-wing--far" d="M-6 -18 Q6 -30 20 -26 Q10 -18 -6 -18 Z"></path>
				</g>
				<path class="mi-b-tail" d="M-18 -13 L-40 -21 Q-42 -16 -39 -12 L-20 -6 Z"></path>
				<path class="mi-b-tail-line" d="M-22 -11 L-38 -17"></path>
				<g data-legs>
					<path class="mi-b-leg" d="M-4 -4 L-5 0 M-8 0.5 Q-5 -1.2 -2 0.5"></path>
					<path class="mi-b-leg" d="M3 -4 L3 0 M0 0.5 Q3 -1.2 6 0.5"></path>
				</g>
				<path class="mi-b-belly" d="M-20 -12 Q-14 -1 0 -2 Q14 -2 18 -14 Q4 -10 -20 -12 Z"></path>
				<path class="mi-b-back" d="M-22 -11 Q-14 -26 4 -25 Q16 -24 18 -16 Q4 -12 -22 -11 Z"></path>
				<circle class="mi-b-head" cx="15" cy="-24" r="8"></circle>
				<path class="mi-b-cap" d="M8 -26 Q12 -33 20 -31 Q16 -28 14 -26 Q11 -25 8 -26 Z"></path>
				<path class="mi-b-cap" d="M8 -26 Q8 -20 11 -19 Q12 -23 14 -26 Q11 -25 8 -26 Z"></path>
				<path class="mi-b-cheek" d="M14 -24 Q18 -24 21 -21 Q18 -18 13 -19 Z"></path>
				<path class="mi-b-bib" d="M17 -19 Q21 -19 22 -16 Q19 -12 15 -14 Z"></path>
				<path class="mi-b-beak" d="M21 -25 L28 -22.5 L21 -20.5 Z"></path>
				<circle class="mi-b-eye" cx="18" cy="-25" r="1.5"></circle>
				<circle class="mi-b-glint" cx="18.5" cy="-25.5" r="0.5"></circle>
				<g data-wing>
					<path class="mi-b-wing" d="M-14 -16 Q-2 -24 12 -20 Q8 -12 -6 -11 Q-12 -11 -14 -16 Z"></path>
					<path class="mi-b-bar" d="M-6 -16 Q2 -19 8 -18"></path>
					<path class="mi-b-streak" d="M-10 -14 L-2 -14 M-8 -12 L2 -12.5"></path>
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>С ветки вспорхнула птица, и ветка ещё несколько раз качнулась вверх и вниз. <More term="Размах всё меньше, а каждое качание длится столько же">Ветка упругая, как пружина: согнутая, она тянется обратно, а разогнавшись, по инерции проскакивает своё прежнее положение. Размах уменьшается, потому что энергия понемногу уходит на трение — внутри самой ветки и о воздух. Подробнее — в разделах <a href="#колебательное-движение">«Колебательное движение»</a> и <a href="#затухающие-колебания-резонанс">«Затухающие колебания. Резонанс»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-mp-intro] {
		--mi-sky-top: hsl(222, 42%, 24%);
		--mi-sky-bot: hsl(28, 55%, 46%);
		--mi-sun: hsl(40, 90%, 66%);
		--mi-cloud: hsl(25, 35%, 62%);
		--mi-flat: hsl(225, 18%, 30%);
		--mi-win: hsl(225, 18%, 22%);
		--mi-win-lit: hsl(45, 90%, 66%);
		--mi-crown: hsl(140, 26%, 22%);
		--mi-crown-hi: hsl(120, 24%, 30%);
		--mi-grass-far: hsl(105, 22%, 26%);
		--mi-grass-near: hsl(100, 26%, 20%);
		--mi-tuft: hsl(100, 30%, 34%);
		--mi-fence: hsl(28, 30%, 40%);
		--mi-path: hsl(35, 20%, 38%);
		--mi-pad: hsl(28, 25%, 32%);
		--mi-metal: hsl(205, 55%, 52%);
		--mi-metal-far: hsl(205, 40%, 38%);
		--mi-rope: hsl(38, 40%, 70%);
		--mi-rope-far: hsl(38, 25%, 50%);
		--mi-wood: hsl(28, 55%, 46%);
		--mi-wood-top: hsl(32, 55%, 58%);
		--mi-shadow: hsla(0, 0%, 0%, 0.35);
		--mi-label: hsl(220, 20%, 92%);
		--mi-label-halo: hsl(100, 26%, 20%);
		/* the branch scene */
		--mi-bsky-top: hsl(215, 40%, 26%);
		--mi-bsky-bot: hsl(200, 30%, 38%);
		--mi-roof: hsl(10, 35%, 36%);
		--mi-wall: hsl(30, 15%, 46%);
		--mi-hedge: hsl(135, 28%, 22%);
		--mi-bark: hsl(25, 28%, 30%);
		--mi-bark-line: hsl(25, 25%, 20%);
		--mi-wood-b: hsl(28, 32%, 38%);
		--mi-leaf: hsl(118, 42%, 40%);
		--mi-leaf-2: hsl(100, 46%, 34%);
		--mi-leaf-vein: hsl(100, 40%, 58%);
		--mi-leaf-far: hsl(130, 25%, 30%);
		--mi-b-back: hsl(28, 50%, 40%);
		--mi-b-wing: hsl(25, 45%, 32%);
		--mi-b-belly: hsl(35, 15%, 78%);
		--mi-b-head: hsl(210, 6%, 58%);
		--mi-b-cap: hsl(18, 55%, 36%);
		--mi-b-dark: hsl(20, 15%, 12%);
	}
	:root[data-theme='light'] [data-mp-intro] {
		--mi-sky-top: hsl(205, 70%, 72%);
		--mi-sky-bot: hsl(195, 60%, 90%);
		--mi-sun: hsl(48, 100%, 62%);
		--mi-cloud: hsl(0, 0%, 100%);
		--mi-flat: hsl(215, 20%, 76%);
		--mi-win: hsl(210, 30%, 88%);
		--mi-win-lit: hsl(210, 30%, 92%);
		--mi-crown: hsl(125, 32%, 44%);
		--mi-crown-hi: hsl(110, 36%, 54%);
		--mi-grass-far: hsl(95, 40%, 66%);
		--mi-grass-near: hsl(95, 38%, 56%);
		--mi-tuft: hsl(100, 38%, 40%);
		--mi-fence: hsl(28, 35%, 50%);
		--mi-path: hsl(38, 35%, 78%);
		--mi-pad: hsl(35, 40%, 72%);
		--mi-metal: hsl(205, 70%, 44%);
		--mi-metal-far: hsl(205, 45%, 60%);
		--mi-rope: hsl(35, 45%, 36%);
		--mi-rope-far: hsl(35, 25%, 56%);
		--mi-shadow: hsla(100, 30%, 15%, 0.25);
		--mi-label: hsl(222, 35%, 16%);
		--mi-label-halo: hsl(95, 40%, 70%);
		--mi-bsky-top: hsl(205, 70%, 76%);
		--mi-bsky-bot: hsl(190, 50%, 90%);
		--mi-roof: hsl(10, 50%, 52%);
		--mi-wall: hsl(35, 30%, 80%);
		--mi-hedge: hsl(125, 30%, 42%);
		--mi-bark: hsl(25, 30%, 42%);
		--mi-bark-line: hsl(25, 30%, 28%);
		--mi-wood-b: hsl(28, 35%, 46%);
		--mi-leaf: hsl(115, 45%, 42%);
		--mi-leaf-2: hsl(100, 50%, 34%);
		--mi-leaf-vein: hsl(95, 50%, 66%);
		--mi-leaf-far: hsl(125, 25%, 62%);
		--mi-b-belly: hsl(35, 20%, 86%);
		--mi-b-head: hsl(210, 6%, 52%);
	}
	[data-mp-intro] .mi-sky-top {
		stop-color: var(--mi-sky-top);
	}
	[data-mp-intro] .mi-sky-bot {
		stop-color: var(--mi-sky-bot);
	}
	[data-mp-intro] .mi-grass-far {
		stop-color: var(--mi-grass-far);
	}
	[data-mp-intro] .mi-grass-near {
		stop-color: var(--mi-grass-near);
	}
	[data-mp-intro] .mi-sun {
		fill: var(--mi-sun);
	}
	[data-mp-intro] .mi-cloud {
		fill: var(--mi-cloud);
		opacity: 0.8;
	}
	[data-mp-intro] .mi-flat {
		fill: var(--mi-flat);
	}
	[data-mp-intro] .mi-win {
		fill: var(--mi-win);
	}
	[data-mp-intro] .mi-win--lit {
		fill: var(--mi-win-lit);
	}
	[data-mp-intro] .mi-crown {
		fill: var(--mi-crown);
	}
	[data-mp-intro] .mi-crown-hi {
		fill: var(--mi-crown-hi);
