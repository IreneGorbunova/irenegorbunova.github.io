---
/**
 * Picture to the definitions of amplitude, period and phase.
 * Left (a scene of 5,6 s, as in the school experiment): a pendulum with a funnel of sand swings over a strip of paper
 *   that is pulled evenly towards the reader (drawn as moving down). The sand draws x(t) = A·cos(2πt/T): A = 40 px,
 *   T = 1,5 s, strip speed 40 px/s, so one period is 60 px of the strip. The funnel is held at the extreme point, then
 *   released. At the end the strip stops and A (from the middle line to a crest) and T (between two crests) appear.
 * Right: two equal pendulums (l = 120 px = 0,4 m, T ≈ 1,27 s) in the same phase or in opposite phases (buttons);
 *   the arrows show the velocities.
 */
import PicStyles from './PicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mD = `mpp-d-${uid}`;
const mV = `mpp-v-${uid}`;
const hatch = (x0: number, x1: number, y: number) =>
	Array.from({ length: Math.floor((x1 - x0) / 10) + 1 }, (_, i) => x0 + i * 10).map((x) => `M${x} ${y} l8 -8`).join(' ');
---

<PicStyles />
<figure class="mp-pic not-content" data-mp-period>
	<div class="mp-pic__grid">
		<div>
			<svg class="mp-pic__svg" viewBox="0 0 320 240" role="img" aria-label="Маятник с воронкой качается над лентой бумаги, которую равномерно тянут. Песок рисует на ленте волнистую линию — график колебаний. На графике отмечены амплитуда A и период T">
				<defs>
					<marker id={mD} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
						<path class="mp-head-dim" d="M0 1 L10 5 L0 9 z"></path>
					</marker>
				</defs>
				<path class="mp-hatch" d={hatch(132, 180, 10)}></path>
				<rect class="mp-ceiling" x="130" y="10" width="60" height="4" rx="1.5"></rect>
				<rect class="mpp-strip" x="84" y="118" width="152" height="118" rx="2"></rect>
				<line class="mp-eq" x1="160" y1="118" x2="160" y2="236"></line>
				<path class="mpp-trace" data-trace></path>
				<line class="mpp-sand" data-sand></line>
				<line class="mp-thread" x1="160" y1="14" data-thread></line>
				<circle class="mp-pivot" cx="160" cy="14" r="2.6"></circle>
				<path class="mpp-funnel" d="M-9 -6 L9 -6 L2 8 L-2 8 Z" data-funnel></path>
				<text x="246" y="140">лента</text>
				<text x="246" y="156">движется</text>
				<text x="246" y="172">вниз</text>
				<g data-marks>
					<line class="mp-dim" x1="160" x2="200" y1="162" y2="162" marker-start={`url(#${mD})`} marker-end={`url(#${mD})`}></line>
					<text class="mp-sym" x="180" y="156" text-anchor="middle">A</text>
					<line class="mp-dim" x1="216" x2="216" y1="162" y2="222" marker-start={`url(#${mD})`} marker-end={`url(#${mD})`}></line>
					<line class="mpp-tick" x1="200" x2="222" y1="162" y2="162"></line>
					<line class="mpp-tick" x1="200" x2="222" y1="222" y2="222"></line>
					<text class="mp-sym" x="224" y="198">T</text>
				</g>
			</svg>
			<div class="mp-pic__foot">
				<figcaption>
					Из воронки сыплется песок, и маятник рисует на ленте график своих колебаний. <i>A</i> — амплитуда, <i>T</i> — период: за это время лента сдвигается на одну «волну».
				</figcaption>
				<button type="button" class="mp-pic__again" data-again>Повторить</button>
			</div>
		</div>
		<div>
			<svg class="mp-pic__svg" viewBox="0 0 320 240" role="img" aria-label="Два одинаковых маятника качаются в одинаковых или в противоположных фазах">
				<defs>
					<marker id={mV} viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" orient="auto">
						<path class="mpp-head-v" d="M0 0 L10 5 L0 10 z"></path>
					</marker>
				</defs>
				<text class="mp-title" x="160" y="22" text-anchor="middle" data-ptitle>В одинаковых фазах</text>
				<path class="mp-hatch" d={hatch(52, 270, 42)}></path>
				<rect class="mp-ceiling" x="50" y="42" width="220" height="4" rx="1.5"></rect>
				{[100, 220].map((x) => (
					<>
						<line class="mp-eq" x1={x} y1="46" x2={x} y2="196"></line>
						<line class="mp-thread" x1={x} y1="46" data-pthread></line>
						<circle class="mp-pivot" cx={x} cy="46" r="2.6"></circle>
						<line class="mpp-v" marker-end={`url(#${mV})`} data-pv></line>
						<circle class="mp-ball" r="9" data-pball></circle>
					</>
				))}
				<text x="160" y="226" text-anchor="middle" data-pnote>движутся в одну сторону</text>
			</svg>
			<div class="mp-pic__btns" role="group" aria-label="Фазы">
				<button type="button" class="mp-pic__btn" aria-pressed="true" data-phase="0">в одинаковых фазах</button>
				<button type="button" class="mp-pic__btn" aria-pressed="false" data-phase="1">в противоположных фазах</button>
			</div>
			<div class="mp-pic__foot">
				<figcaption>Стрелки показывают, куда движутся шарики.</figcaption>
			</div>
		</div>
	</div>
</figure>

<style is:global>
	.mpp-strip {
		fill: color-mix(in srgb, var(--ig-v) 10%, var(--ig-surface));
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.mpp-trace {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-3));
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mpp-sand {
		stroke: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-3));
		stroke-width: 1.5;
		stroke-dasharray: 2 3;
	}
	.mpp-funnel {
		fill: var(--ig-vx);
		stroke: color-mix(in srgb, var(--ig-vx) 60%, var(--sl-color-white));
		stroke-width: 1;
	}
	.mpp-tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 2 2;
	}
	.mpp-v {
		stroke: var(--ig-vy);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.mpp-head-v {
		fill: var(--ig-vy);
	}
	[data-marks] {
		transition: opacity 0.4s ease;
	}
</style>

<script>
	import { loop, scene } from '@components/intro/scene';

	for (const root of document.querySelectorAll<HTMLElement>('[data-mp-period]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const $$ = <T extends Element>(s: string) => Array.from(root.querySelectorAll<T>(s));
		const f = (v: number) => v.toFixed(1);

		// ---------- the sand pendulum ----------
		{
			const card = root.querySelector<HTMLElement>('.mp-pic__grid > div')!;
			const thread = $<SVGLineElement>('[data-thread]');
			const funnel = $<SVGPathElement>('[data-funnel]');
			const sand = $<SVGLineElement>('[data-sand]');
			const trace = $<SVGPathElement>('[data-trace]');
			const marks = $<SVGGElement>('[data-marks]');
			const A = 40;
			const T = 1.5;
			const V = 40; // px/s
			const TOP = 118;
			const BOTTOM = 236;
			const L = 90;
			const RUN = 5.6;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const bx = 160 + A * Math.cos((2 * Math.PI * t) / T);
				const s = (bx - 160) / L;
				const by = 14 + L * Math.sqrt(1 - s * s);
				thread.setAttribute('x2', f(bx));
				thread.setAttribute('y2', f(by - 6));
				funnel.setAttribute('transform', `translate(${f(bx)} ${f(by)}) rotate(${f((-Math.asin(s) * 180) / Math.PI)})`);
				const pouring = x > 0 && x < 1;
				sand.style.visibility = pouring ? 'visible' : 'hidden';
				sand.setAttribute('x1', f(bx));
				sand.setAttribute('x2', f(bx));
				sand.setAttribute('y1', f(by + 9));
				sand.setAttribute('y2', String(TOP));
				// the trace: the point laid at time te is now V·(t − te) below the top of the strip
				const pts: string[] = [];
				for (let te = Math.max(0, t - (BOTTOM - TOP) / V); te <= t + 1e-9; te += 0.02) {
					pts.push(`${f(160 + A * Math.cos((2 * Math.PI * te) / T))} ${f(TOP + V * (t - te))}`);
				}
				trace.setAttribute('d', t > 0 && pts.length > 1 ? `M${pts.join(' L')}` : '');
				marks.style.opacity = x >= 1 ? '1' : '0';
			});
		}

		// ---------- two pendulums: phases ----------
		{
			const threads = $$<SVGLineElement>('[data-pthread]');
			const balls = $$<SVGCircleElement>('[data-pball]');
			const vels = $$<SVGLineElement>('[data-pv]');
			const title = $<SVGTextElement>('[data-ptitle]');
			const note = $<SVGTextElement>('[data-pnote]');
			const btns = $$<HTMLButtonElement>('[data-phase]');
			const L = 120;
			const T = 2 * Math.PI * Math.sqrt(L / 300 / 9.8);
			const TH0 = (16 * Math.PI) / 180;
			let opposite = false;
			let t = 0;
			const draw = () => {
				[100, 220].forEach((px, i) => {
					const ph = i === 1 && opposite ? Math.PI : 0;
					const w = (2 * Math.PI) / T;
					const th = TH0 * Math.cos(w * t + ph);
					const om = -TH0 * w * Math.sin(w * t + ph); // angular velocity
					const bx = px + L * Math.sin(th);
					const by = 46 + L * Math.cos(th);
					threads[i].setAttribute('x2', f(bx));
					threads[i].setAttribute('y2', f(by));
					balls[i].setAttribute('cx', f(bx));
					balls[i].setAttribute('cy', f(by));
					// velocity along the path, drawn under the ball
					const len = 18 * om; // px, signed
					const show = Math.abs(len) > 3;
					vels[i].style.visibility = show ? 'visible' : 'hidden';
					const c = Math.cos(th);
					const s = Math.sin(th);
					const sx = bx + Math.sign(len) * 12 * c;
					const sy = by - Math.sign(len) * 12 * s;
					vels[i].setAttribute('x1', f(sx));
					vels[i].setAttribute('y1', f(sy));
					vels[i].setAttribute('x2', f(sx + len * c));
					vels[i].setAttribute('y2', f(sy - len * s));
				});
			};
			const pick = (opp: boolean) => {
				opposite = opp;
				t = 0;
				btns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.phase === '1') === opp)));
				title.textContent = opp ? 'В противоположных фазах' : 'В одинаковых фазах';
				note.textContent = opp ? 'всё время движутся в противоположные стороны' : 'движутся в одну сторону';
				draw();
			};
			btns.forEach((b) => b.addEventListener('click', () => pick(b.dataset.phase === '1')));
			draw();
			const svg = root.querySelectorAll('svg')[1];
			loop(svg, (dt) => {
				t += dt;
				draw();
				return true;
			});
		}
	}
</script>
