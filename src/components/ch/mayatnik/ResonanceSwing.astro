		fill: var(--ig-v);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 20px;
		font-weight: 700;
	}

	.rs__strip {
		margin-top: 0.35rem;
		border-top: 1px dashed var(--sl-color-gray-5);
		padding-top: 0.25rem;
	}
	.rs__sgrid line,
	.rs__cgrid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.rs__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.3;
	}
	.rs__labels text,
	.rs__name {
		fill: var(--sl-color-gray-3);
		font-size: 13px;
		font-family: var(--__sl-font);
