---
/**
 * Swing pushed by hand or by pushes on a schedule. Shows why the push timing matters and builds
 * the resonance curve: the amplitude the swing settles to for each period of the pushes.
 * Side view, one scale (90 px per metre); the ropes are 2.5 m long, friction is small.
 * The curve is computed at build time with the same equations the live model uses.
 */
import { SWING, periodString, swingSteady } from './physics';

const uid = `rs-${Math.random().toString(36).slice(2, 8)}`;
const S = 90;
const PX = 360;
const PY = 30;
const GROUND = PY + (SWING.l + 0.45) * S;
const LEG = 1.45 * S;
const grass = Array.from({ length: 34 }, (_, i) => 40 + i * 19);

// Resonance chart.
const CX0 = 64;
const CX1 = 700;
const CY0 = 186;
const CY1 = 22;
const TMIN = 1.5;
const TMAX = 5;
const AMAX = 1;
const cx = (T: number) => CX0 + ((T - TMIN) / (TMAX - TMIN)) * (CX1 - CX0);
const cy = (A: number) => CY0 - (A / AMAX) * (CY0 - CY1);
const curve = Array.from({ length: 141 }, (_, i) => {
	const T = TMIN + (i * (TMAX - TMIN)) / 140;
	return `${i ? 'L' : 'M'}${cx(T).toFixed(1)} ${cy(swingSteady(T)).toFixed(1)}`;
}).join(' ');
const T0 = periodString(SWING.l, SWING.g);
const tTicks = [1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5];
const aTicks = [0.25, 0.5, 0.75, 1];
const num = (v: number) => String(v).replace('.', ',');
---

<figure class="rs not-content" data-rsw>
	<svg class="rs__scene" viewBox={`0 0 720 ${GROUND + 18}`} role="img" aria-label="Качели, которые раскачивают толчками">
		<defs>
			<marker id={`${uid}-push`} class="rs__head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
				<path d="M0,0 L10,5 L0,10 z" />
			</marker>
			<linearGradient id={`${uid}-seat`} x1="0" x2="0" y1="0" y2="1">
				<stop offset="0" class="rs__stop-hi" />
				<stop offset="1" class="rs__stop" />
			</linearGradient>
		</defs>
		<g class="rs__frame">
			<line x1={PX} y1={PY} x2={PX - LEG} y2={GROUND} />
			<line x1={PX} y1={PY} x2={PX + LEG} y2={GROUND} />
			<line class="rs__brace" x1={PX - LEG * 0.62} y1={PY + (GROUND - PY) * 0.62} x2={PX + LEG * 0.62} y2={PY + (GROUND - PY) * 0.62} />
		</g>
		<g class="rs__ground">
			<line x1="30" y1={GROUND} x2="690" y2={GROUND} />
			{grass.map((x) => <line class="rs__grass" x1={x} y1={GROUND + 1} x2={x - 7} y2={GROUND + 9} />)}
		</g>
		<line class="rs__eq" x1={PX} y1={PY} x2={PX} y2={GROUND - 4} />
		<path class="rs__arc" data-arc />
		<g data-swing>
			<line class="rs__rope" x1={PX} y1={PY} x2={PX} y2={PY + SWING.l * S} />
			<rect class="rs__seat" x={PX - 17} y={PY + SWING.l * S - 2} width="34" height="7" rx="3" fill={`url(#${uid}-seat)`} />
		</g>
		<g class="rs__push" data-push>
			<line marker-end={`url(#${uid}-push)`} data-push-line />
			<text class="rs__sym" data-push-text>F</text>
		</g>
		<circle class="rs__pivot" cx={PX} cy={PY} r="5" />
	</svg>

	<svg class="rs__strip" viewBox="0 0 720 132" role="img" aria-label="График смещения качелей от времени, отмечены толчки">
		<defs>
			<clipPath id={`${uid}-clip`}>
				<rect x="52" y="6" width="656" height="104" />
			</clipPath>
		</defs>
		<g class="rs__sgrid" data-sgrid></g>
		<line class="rs__axis" x1="52" y1="58" x2="708" y2="58" />
		<line class="rs__axis" x1="52" y1="6" x2="52" y2="110" />
		<g class="rs__labels" data-slabels></g>
		<text class="rs__name" x="60" y="18">x, м</text>
		<text class="rs__name" x="704" y="104" text-anchor="end">t, с</text>
		<g clip-path={`url(#${uid}-clip)`}>
			<g data-bands></g>
			<path class="rs__trace" data-trace />
		</g>
	</svg>

	<div class="rs__controls">
		<div class="rs__buttons">
			<button type="button" class="rs__btn rs__btn--primary" data-kick>Толкнуть</button>
			<button type="button" class="rs__btn" data-stop>Остановить качели</button>
			<label class="rs__check"><input type="checkbox" data-sched /> Толчки по расписанию</label>
			<label class="rs__check"><input type="checkbox" data-fast /> Время ×3</label>
		</div>
		<label class="rs__slider">
			<span>Период толчков <i>T</i><sub>толч</sub></span>
			<output data-tp-out></output>
			<input type="range" min={TMIN} max={TMAX} step="0.01" value="2" data-tp />
		</label>
	</div>

	<dl class="rs__stats">
		<div>
			<dt>Собственный период качелей</dt>
			<dd data-f-t0></dd>
		</div>
		<div>
			<dt>Амплитуда <i>A</i></dt>
			<dd data-amp>0 м</dd>
		</div>
	</dl>
	<p class="rs__status" aria-live="polite" data-status></p>

	<svg class="rs__chart" viewBox="0 0 720 244" role="img" aria-label="Резонансная кривая: амплитуда качелей в зависимости от периода толчков">
		<g class="rs__cgrid">
			{tTicks.map((T) => <line x1={cx(T)} y1={CY0} x2={cx(T)} y2={CY1} />)}
			{aTicks.map((A) => <line x1={CX0} y1={cy(A)} x2={CX1} y2={cy(A)} />)}
		</g>
		<line class="rs__axis" x1={CX0} y1={CY0} x2={CX1 + 6} y2={CY0} />
		<line class="rs__axis" x1={CX0} y1={CY0} x2={CX0} y2={CY1 - 8} />
		<g class="rs__labels">
			{
				tTicks.map((T) => (
					<text x={cx(T)} y={CY0 + 20} text-anchor="middle">
						{num(T)}
					</text>
				))
			}
			<text x={CX0 - 8} y={CY0 + 5} text-anchor="end">0</text>
			{
				aTicks.map((A) => (
					<text x={CX0 - 8} y={cy(A) + 5} text-anchor="end">
						{num(A)}
					</text>
				))
			}
		</g>
		<text class="rs__name" x={CX0 + 8} y={CY1 - 2}>A, м</text>
		<text class="rs__name rs__name--t" x={CX1} y={CY0 + 46} text-anchor="end">
			T<tspan class="rs__sub" dy="4">толч</tspan><tspan dy="-4">, с</tspan>
		</text>
		<line class="rs__t0" x1={cx(T0)} y1={CY0} x2={cx(T0)} y2={CY1} />
		<text class="rs__t0-text" x={cx(T0) + 6} y={CY1 + 12}>
			T<tspan class="rs__sub" dy="4">0</tspan>
		</text>
		<path class="rs__curve" d={curve} data-curve />
		<g class="rs__now" data-now>
			<line class="rs__now-line" y1={CY0} y2={CY1} data-now-line />
			<circle class="rs__now-dot" r="6" data-now-dot />
		</g>
	</svg>

	<figcaption class="rs__legend">
		Длина верёвок <i>l</i> = 2,5 м, <i>g</i> = 9,8 м/с². Каждый толчок длится 0,25 с и направлен вправо.
		На графике <i>x</i>(<i>t</i>) вертикальные полосы — толчки. Кривая внизу — амплитуда, которая устанавливается, если
		толкать качели с периодом <i>T</i><sub>толч</sub>; точка — амплитуда качелей сейчас.
	</figcaption>
</figure>

<style is:global>
