		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2.5;
		stroke-linejoin: round;
		stroke-linecap: round;
	}

	.rs__controls {
		display: grid;
		gap: 0.6rem;
		margin-top: 0.6rem;
	}
	.rs__buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
