---
/**
 * Read amplitude, period and frequency off a graph x(t) = A·sin(2πt/T), A = 3 cm, T = 0.4 s.
 * The reader types the numbers and gets feedback for each; a hint marks one period and the amplitude.
 */
const X0 = 64;
const X1 = 704;
const MID = 118;
const PXS = (X1 - X0) / 1.0; // px per second
const PXCM = 24; // px per cm
const A = 3;
const T = 0.4;
const pts = Array.from({ length: 401 }, (_, i) => {
	const t = i / 400;
	return `${(X0 + t * PXS).toFixed(1)} ${(MID - A * Math.sin((2 * Math.PI * t) / T) * PXCM).toFixed(1)}`;
});
const d = `M ${pts.join(' L ')}`;
const ts = Array.from({ length: 11 }, (_, i) => i / 10);
const xs = [-4, -3, -2, -1, 0, 1, 2, 3, 4];
const lab = (v: number) => String(v).replace('.', ',').replace('-', '−');
---

<div class="gr" data-gr>
	<svg class="gr__plot not-content" viewBox="0 0 720 250" role="img" aria-label="График зависимости смещения от времени">
		<g class="gr__grid">
			{ts.map((t) => <line x1={X0 + t * PXS} y1={MID - 4 * PXCM} x2={X0 + t * PXS} y2={MID + 4 * PXCM} />)}
			{xs.map((x) => <line x1={X0} y1={MID - x * PXCM} x2={X1} y2={MID - x * PXCM} />)}
		</g>
		<line class="gr__axis" x1={X0} y1={MID} x2={X1 + 8} y2={MID} />
		<line class="gr__axis" x1={X0} y1={MID + 4 * PXCM + 4} x2={X0} y2={MID - 4 * PXCM - 8} />
		<g class="gr__ticks">
			{
				ts.slice(1).map((t) => (
					<text x={X0 + t * PXS} y={MID + 4 * PXCM + 22} text-anchor="middle">
						{lab(t)}
					</text>
				))
			}
			{
				xs.map((x) => (
					<text x={X0 - 8} y={MID - x * PXCM + 5} text-anchor="end">
						{lab(x)}
					</text>
				))
			}
			<text class="gr__name" x={X0 + 8} y={MID - 4 * PXCM - 6}><tspan class="gr__sym">x</tspan>, см</text>
			<text class="gr__name" x={X1} y={MID + 20} text-anchor="end"><tspan class="gr__sym">t</tspan>, с</text>
		</g>
		<path class="gr__curve" d={d} />
		<g class="gr__hint" data-hint>
			<line class="gr__mark" x1={X0 + 0.1 * PXS} y1={MID - A * PXCM} x2={X0 + 0.1 * PXS} y2={MID - A * PXCM - 22} />
			<line class="gr__mark" x1={X0 + 0.5 * PXS} y1={MID - A * PXCM} x2={X0 + 0.5 * PXS} y2={MID - A * PXCM - 22} />
			<line class="gr__bracket" x1={X0 + 0.1 * PXS} y1={MID - A * PXCM - 16} x2={X0 + 0.5 * PXS} y2={MID - A * PXCM - 16} />
			<text class="gr__htext" x={X0 + 0.3 * PXS} y={MID - A * PXCM - 22} text-anchor="middle">одно полное колебание</text>
			<line class="gr__bracket" x1={X0 + 0.9 * PXS + 18} y1={MID} x2={X0 + 0.9 * PXS + 18} y2={MID - A * PXCM} />
			<text class="gr__htext" x={X0 + 0.9 * PXS + 26} y={MID - (A * PXCM) / 2 + 5}>A</text>
		</g>
	</svg>
	<div class="gr__form not-content">
		<label class="gr__field">
			<span>Амплитуда <i>A</i></span>
			<input type="text" inputmode="decimal" autocomplete="off" data-in="A" />
			<span class="gr__unit">см</span>
			<span class="gr__ok" data-ok="A"></span>
		</label>
		<label class="gr__field">
			<span>Период <i>T</i></span>
			<input type="text" inputmode="decimal" autocomplete="off" data-in="T" />
			<span class="gr__unit">с</span>
			<span class="gr__ok" data-ok="T"></span>
		</label>
		<label class="gr__field">
			<span>Частота <i>ν</i></span>
			<input type="text" inputmode="decimal" autocomplete="off" data-in="nu" />
			<span class="gr__unit">Гц</span>
			<span class="gr__ok" data-ok="nu"></span>
		</label>
		<div class="gr__buttons">
			<button type="button" class="gr__btn gr__btn--primary" data-check>Проверить</button>
			<button type="button" class="gr__btn" data-show-hint>Подсказка</button>
		</div>
		<p class="gr__fb" aria-live="polite" data-fb></p>
	</div>
</div>

<style is:global>
	.gr {
		margin-block: 1.25rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.gr i {
		font-family: var(--ig-font-math);
	}
	.gr__plot {
		display: block;
		width: 100%;
		height: auto;
	}
	.gr__grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.gr__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.gr__ticks text {
		fill: var(--sl-color-gray-3);
		font-size: 14px;
		font-family: var(--__sl-font);
	}
	.gr__sym {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.gr__curve {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.gr__hint {
		opacity: 0;
		transition: opacity 0.4s;
	}
	.gr__hint.is-on {
		opacity: 1;
	}
	.gr__mark,
	.gr__bracket {
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.5;
	}
	.gr__mark {
		stroke-dasharray: 3 3;
	}
	.gr__htext {
		fill: var(--sl-color-text-accent);
		font-size: 14px;
		font-family: var(--__sl-font);
	}
	.gr__hint text:last-of-type {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 18px;
	}
	.gr__form {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.25rem;
		align-items: center;
		margin-top: 0.5rem;
	}
	.gr__field {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.gr__field input {
		width: 4.5rem;
		padding: 0.35rem 0.5rem;
		font: inherit;
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.5rem;
		font-variant-numeric: tabular-nums;
	}
	.gr__field input:focus {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}
	.gr__field input.is-right {
		border-color: var(--sl-color-accent);
	}
	.gr__field input.is-wrong {
		border-color: var(--ig-vy);
	}
	.gr__ok {
		width: 1rem;
		font-weight: 700;
	}
	.gr__ok.is-right {
		color: var(--sl-color-text-accent);
	}
	.gr__ok.is-wrong {
		color: var(--ig-vy);
	}
	.gr__buttons {
		display: flex;
		gap: 0.5rem;
	}
	.gr__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.gr__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.gr__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.gr__fb {
		flex-basis: 100%;
		min-height: 1.4em;
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.gr__fb.is-right {
		color: var(--sl-color-text-accent);
		font-weight: 700;
	}
	@media (max-width: 40rem) {
		.gr {
			padding: 0.75rem;
		}
		.gr__ticks text,
		.gr__htext {
			font-size: 22px;
		}
		.gr__hint text:last-of-type {
			font-size: 28px;
		}
		.gr__field {
			flex: 1 1 100%;
		}
		.gr__field > span:first-child {
			min-width: 7.5rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.gr__hint {
			transition: none;
		}
	}
</style>

<script>
	const ANSWERS: Record<string, { value: number; tol: number; hint: string }> = {
		A: { value: 3, tol: 0.05, hint: 'Амплитуда — наибольшее смещение от нуля, высота «горба» графика.' },
		T: { value: 0.4, tol: 0.011, hint: 'Период — время одного полного колебания: от одного «горба» до следующего.' },
		nu: { value: 2.5, tol: 0.05, hint: 'Частота — число колебаний за секунду: ν = 1/T.' },
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-gr]')) {
		const fb = root.querySelector<HTMLElement>('[data-fb]')!;
		const hint = root.querySelector<SVGGElement>('[data-hint]')!;
		const check = () => {
			const wrongHints: string[] = [];
			let empty = 0;
			for (const [key, ans] of Object.entries(ANSWERS)) {
				const input = root.querySelector<HTMLInputElement>(`[data-in="${key}"]`)!;
				const ok = root.querySelector<HTMLElement>(`[data-ok="${key}"]`)!;
				const raw = input.value.trim().replace(',', '.').replace('−', '-');
				input.classList.remove('is-right', 'is-wrong');
				ok.classList.remove('is-right', 'is-wrong');
				ok.textContent = '';
				if (raw === '') {
					empty += 1;
					continue;
				}
				const v = Number(raw);
				const right = Number.isFinite(v) && Math.abs(v - ans.value) <= ans.tol;
				input.classList.add(right ? 'is-right' : 'is-wrong');
				ok.classList.add(right ? 'is-right' : 'is-wrong');
				ok.textContent = right ? '✓' : '✗';
				if (!right) wrongHints.push(ans.hint);
			}
			const allRight = wrongHints.length === 0 && empty === 0;
			fb.classList.toggle('is-right', allRight);
			fb.textContent = allRight
				? 'Всё верно! Тело совершает 2,5 колебания в секунду.'
				: wrongHints.length > 0
					? wrongHints.join(' ')
					: 'Заполните все три поля.';
		};
		root.querySelector('[data-check]')!.addEventListener('click', check);
		root.querySelectorAll<HTMLInputElement>('[data-in]').forEach((input) =>
			input.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') check();
			}),
		);
		root.querySelector('[data-show-hint]')!.addEventListener('click', () => hint.classList.toggle('is-on'));
	}
</script>
