---
/**
 * Main model of the chapter: a string pendulum and a spring pendulum side by side.
 * One scale for both, 300 px per metre, so lengths, stretches and swings are true to proportion.
 * The string pendulum is integrated exactly (θ'' = −(g/l)·sin θ), not in the small-angle form.
 */
import { PLANETS } from './physics';

const uid = `pl-${Math.random().toString(36).slice(2, 8)}`;
const S = 300;
const PY = 26;
const STR_X = 180;
const SPR_X = 540;
const RULER_X = 352;
const ticks = Array.from({ length: 25 }, (_, i) => i * 0.05);
const fmtM = (v: number) => v.toFixed(1).replace('.', ',');
const hatch = Array.from({ length: 33 }, (_, i) => 44 + i * 19.5);
---

<figure class="pl not-content" data-pl>
	<div class="pl__planets" role="group" aria-label="Где проводится опыт">
		{
			PLANETS.map((p, i) => (
				<button type="button" class={`pl__planet pl__planet--${p.id}`} data-planet={i} aria-pressed={i === 0 ? 'true' : 'false'}>
					<span class="pl__globe" aria-hidden="true" />
					<span class="pl__planet-name">{p.name}</span>
					<span class="pl__planet-g">
						<i>g</i> = {String(p.g).replace('.', ',')} м/с²
					</span>
				</button>
			))
		}
	</div>

	<div class="pl__sliders">
		<label class="pl__slider">
			<span>Длина нити <i>l</i></span>
			<output data-l-out></output>
			<input type="range" min="0" max="1000" step="1" data-l />
		</label>
		<label class="pl__slider">
			<span>Масса груза <i>m</i></span>
			<output data-m-out></output>
			<input type="range" min="0.05" max="0.5" step="0.01" value="0.4" data-m />
		</label>
		<label class="pl__slider">
			<span>Жёсткость <i>k</i></span>
			<output data-k-out></output>
			<input type="range" min="0" max="1000" step="1" data-k />
		</label>
	</div>

	<div class="pl__heads" aria-hidden="true">
		<span class="pl__head pl__head--str">Нитяной маятник</span>
		<span class="pl__head pl__head--spr">Пружинный маятник</span>
	</div>

	<svg class="pl__scene" viewBox="0 0 720 390" role="img" aria-label="Нитяной и пружинный маятники в одном масштабе">
		<defs>
			<radialGradient id={`${uid}-bob`} cx="35%" cy="30%" r="75%">
				<stop offset="0" class="pl__stop-hi" />
				<stop offset="0.45" class="pl__stop-str" />
				<stop offset="1" class="pl__stop-str-dark" />
			</radialGradient>
			<linearGradient id={`${uid}-wt`} x1="0" x2="1" y1="0" y2="0">
				<stop offset="0" class="pl__stop-spr-dark" />
				<stop offset="0.35" class="pl__stop-spr-hi" />
				<stop offset="0.6" class="pl__stop-spr" />
				<stop offset="1" class="pl__stop-spr-dark" />
			</linearGradient>
			<marker id={`${uid}-arr`} class="pl__arrowhead" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,1 L10,5 L0,9 z" />
			</marker>
		</defs>

		<!-- Ceiling beam -->
		<g class="pl__beam">
			{hatch.map((x) => <line x1={x} y1={16} x2={x + 9} y2={6} />)}
			<rect x="40" y="16" width="640" height="10" rx="2" />
		</g>

		<!-- Ruler, true scale -->
		<g class="pl__ruler" aria-hidden="true">
			<line x1={RULER_X} y1={PY} x2={RULER_X} y2={PY + 1.2 * S} />
			{
				ticks.map((v, i) => (
					<line class={i % 2 === 0 ? 'pl__tick-major' : ''} x1={RULER_X - (i % 2 === 0 ? 8 : 4)} y1={PY + v * S} x2={RULER_X} y2={PY + v * S} />
				))
			}
			{
				ticks
					.filter((_, i) => i > 0 && i % 4 === 0)
					.map((v) => (
						<text x={RULER_X + 6} y={PY + v * S + 4}>
							{fmtM(v)} м
						</text>
					))
			}
		</g>

		<!-- String pendulum -->
		<g class="pl__str">
			<line class="pl__eq" x1={STR_X} y1={PY} x2={STR_X} y2={PY} data-str-eq />
			<path class="pl__path" data-str-arc />
			<g class="pl__dim" data-str-dim>
				<line marker-start={`url(#${uid}-arr)`} marker-end={`url(#${uid}-arr)`} data-str-dim-line />
				<text class="pl__sym" data-str-dim-text>A</text>
			</g>
			<line class="pl__string" x1={STR_X} y1={PY} x2={STR_X} y2={PY + 150} data-str-line />
			<text class="pl__sym pl__sym--small" data-str-l>l</text>
			<circle class="pl__pivot" cx={STR_X} cy={PY} r="4" />
			<circle class="pl__bob" r="12" cx={STR_X} cy={PY + 150} fill={`url(#${uid}-bob)`} data-str-bob />
			<circle
				class="pl__hit"
				r="40"
				cx={STR_X}
				cy={PY + 150}
				tabindex="0"
				role="slider"
				aria-label="Отклонение шарика нитяного маятника. Стрелки меняют угол, Enter отпускает."
				aria-valuemin="-45"
				aria-valuemax="45"
				aria-valuenow="12"
				data-str-hit
			/>
		</g>

		<!-- Spring pendulum -->
		<g class="pl__spr">
			<line class="pl__eq" data-spr-eq />
			<g class="pl__dim pl__dim--dl" data-spr-dl>
				<line class="pl__natural" data-spr-nat />
				<line marker-start={`url(#${uid}-arr)`} marker-end={`url(#${uid}-arr)`} data-spr-dl-line />
				<text class="pl__sym pl__sym--small" text-anchor="end" data-spr-dl-text>Δl</text>
			</g>
			<g class="pl__dim" data-spr-dim>
				<line marker-start={`url(#${uid}-arr)`} marker-end={`url(#${uid}-arr)`} data-spr-dim-line />
				<text class="pl__sym" data-spr-dim-text>A</text>
			</g>
			<path class="pl__coil" data-spr-coil />
			<g data-spr-weight>
				<circle class="pl__hook" r="3.5" cx="0" cy="-2" />
				<rect class="pl__weight" fill={`url(#${uid}-wt)`} x="-16" y="3" width="32" height="28" rx="4" data-spr-body />
			</g>
			<circle
				class="pl__hit"
				r="40"
				cx={SPR_X}
				cy="150"
				tabindex="0"
				role="slider"
				aria-label="Смещение груза пружинного маятника. Стрелки меняют смещение, Enter отпускает."
				aria-valuemin="-10"
				aria-valuemax="10"
				aria-valuenow="6"
				data-spr-hit
			/>
		</g>
		<text class="pl__hint" x={STR_X} y="0" text-anchor="end" data-hint>потяните →</text>
	</svg>

	<svg class="pl__graph" viewBox="0 0 720 206" role="img" aria-label="График смещения от времени для обоих маятников">
		<defs>
			<clipPath id={`${uid}-clip`}>
				<rect x="52" y="8" width="656" height="166" />
			</clipPath>
		</defs>
		<g class="pl__ggrid" data-ggrid></g>
		<line class="pl__gaxis" x1="52" y1="91" x2="708" y2="91" />
		<line class="pl__gaxis" x1="52" y1="12" x2="52" y2="170" />
		<g class="pl__glabels" data-glabels></g>
		<text class="pl__gname" x="60" y="26">x, см</text>
		<text class="pl__gname" x="704" y="164" text-anchor="end">t, с</text>
		<g clip-path={`url(#${uid}-clip)`}>
			<path class="pl__trace pl__trace--str" data-trace-str />
			<path class="pl__trace pl__trace--spr" data-trace-spr />
			<circle class="pl__pen pl__pen--str" r="4.5" data-pen-str />
			<circle class="pl__pen pl__pen--spr" r="4.5" data-pen-spr />
		</g>
	</svg>

	<div class="pl__controls">
		<div class="pl__buttons">
			<button type="button" class="pl__btn pl__btn--primary" data-run>Пуск</button>
			<button type="button" class="pl__btn" data-restart>Отпустить заново</button>
			<label class="pl__check"><input type="checkbox" data-damp /> Затухание</label>
		</div>
	</div>
	<p class="pl__status" aria-live="polite" data-status></p>

	<div class="pl__cards">
		<section class="pl__card pl__card--str">
			<p class="pl__card-title"><span class="pl__key pl__key--str"></span>Нитяной маятник</p>
			<div class="pl__f" data-f-str-T></div>
			<div class="pl__f" data-f-str-nu></div>
			<p class="pl__amp">Амплитуда <i>A</i> = <b data-a-str></b></p>
			<div class="pl__energy" aria-hidden="true"><span class="pl__ep" data-ep-str></span><span class="pl__ek" data-ek-str></span></div>
			<p class="pl__note" data-note-str></p>
		</section>
		<section class="pl__card pl__card--spr">
			<p class="pl__card-title"><span class="pl__key pl__key--spr"></span>Пружинный маятник</p>
			<div class="pl__f" data-f-spr-T></div>
			<div class="pl__f" data-f-spr-nu></div>
			<p class="pl__amp">Амплитуда <i>A</i> = <b data-a-spr></b></p>
			<div class="pl__energy" aria-hidden="true"><span class="pl__ep" data-ep-spr></span><span class="pl__ek" data-ek-spr></span></div>
			<p class="pl__note" data-note-spr></p>
		</section>
	</div>
	<p class="pl__elegend">
		<span class="pl__swatch pl__swatch--ep"></span>потенциальная энергия
		<span class="pl__swatch pl__swatch--ek"></span>кинетическая энергия.
		Полоса во всю ширину — энергия в момент, когда маятник отпустили.
	</p>

	<div class="pl__sw">
		<div class="pl__sw-face">
			<span class="pl__sw-label">Секундомер</span>
			<output class="pl__sw-time" data-sw-time>0,00 с</output>
		</div>
		<div class="pl__sw-row">
			<button type="button" class="pl__btn pl__btn--primary" data-sw-go>Пуск</button>
			<button type="button" class="pl__btn" data-sw-reset>Сброс</button>
			<span class="pl__sw-n">
				<span>Число колебаний <i>N</i></span>
				<button type="button" class="pl__step" aria-label="Меньше колебаний" data-sw-dec>−</button>
				<output data-sw-n>10</output>
				<button type="button" class="pl__step" aria-label="Больше колебаний" data-sw-inc>+</button>
			</span>
		</div>
		<div class="pl__sw-res" aria-live="polite" data-sw-res></div>
	</div>

	<figcaption class="pl__legend">
		Шарик и груз можно тянуть мышью или пальцем. Масштаб у обоих маятников один и тот же, линейка — в метрах.
		На графике <span class="pl__key pl__key--str"></span>смещение шарика по горизонтали,
		<span class="pl__key pl__key--spr"></span>смещение груза по вертикали (вверх — плюс).
	</figcaption>
</figure>

<style is:global>
	.pl {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.pl i {
		font-family: var(--ig-font-math);
	}
	.pl__nowrap {
		white-space: nowrap;
	}

	/* Planet switch */
	.pl__planets {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.pl__planet {
		flex: 1 1 0;
		min-width: 6.5rem;
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 0.55rem;
		align-items: center;
		margin: 0;
		padding: 0.45rem 0.8rem;
		font: inherit;
		text-align: start;
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.8rem;
		cursor: pointer;
		transition:
			border-color 0.2s,
			background-color 0.2s;
	}
	.pl__planet:hover {
		border-color: var(--sl-color-accent);
	}
	.pl__planet[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.pl__globe {
		grid-row: 1 / 3;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		box-shadow: inset -0.3rem -0.25rem 0.5rem rgb(0 0 0 / 0.35);
	}
	.pl__planet--earth .pl__globe {
		background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--ig-vx) 55%, white), var(--ig-vx));
	}
	.pl__planet--moon .pl__globe {
		background: radial-gradient(circle at 35% 30%, var(--sl-color-gray-2), var(--sl-color-gray-4));
	}
	.pl__planet--mars .pl__globe {
		background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--ig-vy) 55%, white), var(--ig-vy));
	}
	.pl__planet-name {
		font-weight: 700;
		line-height: 1.2;
	}
	.pl__planet-g {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		white-space: nowrap;
	}

	/* Scene */
	.pl__heads {
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin-top: 0.9rem;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-gray-2);
		text-align: center;
	}
	.pl__head::before {
		content: '';
		display: inline-block;
		width: 0.7rem;
		height: 0.7rem;
		margin-right: 0.4rem;
		border-radius: 50%;
		vertical-align: -0.05rem;
	}
	.pl__head--str::before {
		background: var(--ig-vx);
	}
	.pl__head--spr::before {
		background: var(--ig-vy);
	}
	.pl__scene,
	.pl__graph {
		display: block;
		width: 100%;
		height: auto;
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.pl__beam line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.pl__beam rect {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
	}
	.pl__ruler line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.pl__ruler .pl__tick-major {
		stroke: var(--sl-color-gray-3);
	}
	.pl__ruler text,
	.pl__hint {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
		font-family: var(--__sl-font);
	}
	.pl__hint {
		font-size: 14px;
		fill: var(--sl-color-text-accent);
		transition: opacity 0.6s;
	}
	.pl__eq {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		stroke-dasharray: 5 5;
	}
	.pl__path {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
		stroke-dasharray: 2 5;
		stroke-linecap: round;
	}
	.pl__dim line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.pl__dim .pl__natural {
		stroke-dasharray: 3 3;
	}
	.pl__arrowhead path {
		fill: var(--sl-color-gray-3);
	}
	.pl__sym {
		fill: var(--sl-color-gray-2);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 17px;
	}
	.pl__sym--small {
		font-size: 15px;
		fill: var(--sl-color-gray-3);
	}
	.pl__string {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.pl__pivot {
		fill: var(--sl-color-gray-2);
	}
	.pl__stop-hi {
		stop-color: color-mix(in srgb, var(--ig-vx) 30%, white);
	}
	.pl__stop-str {
		stop-color: var(--ig-vx);
	}
	.pl__stop-str-dark {
		stop-color: color-mix(in srgb, var(--ig-vx) 60%, black);
	}
	.pl__stop-spr {
		stop-color: var(--ig-vy);
	}
	.pl__stop-spr-hi {
		stop-color: color-mix(in srgb, var(--ig-vy) 45%, white);
	}
	.pl__stop-spr-dark {
		stop-color: color-mix(in srgb, var(--ig-vy) 55%, black);
	}
	.pl__bob {
		filter: drop-shadow(0 0 6px color-mix(in srgb, var(--ig-vx) 60%, transparent));
	}
	.pl__coil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.pl__hook {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.pl__weight {
		filter: drop-shadow(0 0 6px color-mix(in srgb, var(--ig-vy) 45%, transparent));
	}
	.pl__hit {
		fill: transparent;
		cursor: grab;
		touch-action: none;
		outline: none;
	}
	.pl__hit:active {
		cursor: grabbing;
	}
	.pl__hit:focus-visible {
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		stroke-dasharray: 4 4;
	}

	/* Graph */
	.pl__graph {
		margin-top: 0.5rem;
		border-top: 1px dashed var(--sl-color-gray-5);
		padding-top: 0.25rem;
	}
	.pl__ggrid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.pl__gaxis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.3;
	}
	.pl__glabels text,
	.pl__gname {
		fill: var(--sl-color-gray-3);
		font-size: 13px;
		font-family: var(--__sl-font);
	}
	.pl__gname {
		font-style: italic;
	}
	.pl__trace {
		fill: none;
		stroke-width: 2.5;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.pl__trace--str,
	.pl__pen--str {
		stroke: var(--ig-vx);
		fill: var(--ig-vx);
	}
	.pl__trace--spr,
	.pl__pen--spr {
		stroke: var(--ig-vy);
		fill: var(--ig-vy);
	}
	.pl__trace--str,
	.pl__trace--spr {
		fill: none;
	}
	.pl__pen {
		stroke-width: 0;
		filter: drop-shadow(0 0 4px currentColor);
	}

	/* Controls */
	.pl__sliders {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem 1.25rem;
		margin-top: 0.9rem;
		align-items: end;
	}
	.pl__controls {
		margin-top: 0.6rem;
	}
	.pl__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pl__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.pl__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.pl__buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}
	.pl__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.pl__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.pl__btn--primary {
		min-width: 6.5rem;
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.pl__btn--primary:hover {
		filter: brightness(1.08);
	}
	.pl__check {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.pl__check input {
		width: 1.05rem;
		height: 1.05rem;
		accent-color: var(--sl-color-accent);
	}
	.pl__status {
		min-height: 1.5em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pl__status.is-match {
		color: var(--sl-color-text-accent);
		font-weight: 700;
	}

	/* Cards */
	.pl__cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem;
