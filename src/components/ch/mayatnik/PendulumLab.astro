</style>

<script>
	import { PLANETS, largeAngleFactor, periodSpring, periodString, rk4 } from './physics';
	import { animator, fmt, logScale, reduceMotion, svgPoint, tex, tnum } from './util';

	const S = 300; // px per metre in the scene
	const PY = 26;
	const STR_X = 180;
	const SPR_X = 540;
	const L0 = 0.15; // spring length without a load, m
	const SPR_AMAX = 0.1; // largest displacement of the spring weight, m
	const STR_DXMAX = 150; // largest sideways swing of the bob, px
	const DEG = Math.PI / 180;
	const H = 1 / 1000; // integration step, s
	const BETA = 0.08; // damping, 1/s (amplitude falls as e^(−βt))
	const W = 10; // graph window, s
	const GX0 = 52;
	const GX1 = 708;
	const GMID = 91;
	const GHALF = 74;
	const L_SCALE = logScale(0.1, 1);
	const K_SCALE = logScale(6, 60);
	const RANGES = [5, 10, 15, 20, 30, 40, 50, 60];
	const SVG_NS = 'http://www.w3.org/2000/svg';

	type Osc = {
		x: number; // θ for the string pendulum (rad), y for the spring weight (m, up is +)
		v: number;
		x0: number; // where it is released from
		held: boolean;
		amp: number; // amplitude of the last swing
		E0: number; // energy at release
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-pl]')) {
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const scene = q<SVGSVGElement>('.pl__scene');
		const el = {
			planets: Array.from(root.querySelectorAll<HTMLButtonElement>('[data-planet]')),
			lIn: q<HTMLInputElement>('[data-l]'),
			mIn: q<HTMLInputElement>('[data-m]'),
			kIn: q<HTMLInputElement>('[data-k]'),
			lOut: q<HTMLOutputElement>('[data-l-out]'),
			mOut: q<HTMLOutputElement>('[data-m-out]'),
			kOut: q<HTMLOutputElement>('[data-k-out]'),
			run: q<HTMLButtonElement>('[data-run]'),
			restart: q<HTMLButtonElement>('[data-restart]'),
			damp: q<HTMLInputElement>('[data-damp]'),
			status: q<HTMLElement>('[data-status]'),
			hint: q<SVGTextElement>('[data-hint]'),
			strEq: q<SVGLineElement>('[data-str-eq]'),
			strArc: q<SVGPathElement>('[data-str-arc]'),
			strDim: q<SVGGElement>('[data-str-dim]'),
			strDimLine: q<SVGLineElement>('[data-str-dim-line]'),
			strDimText: q<SVGTextElement>('[data-str-dim-text]'),
			strLine: q<SVGLineElement>('[data-str-line]'),
			strL: q<SVGTextElement>('[data-str-l]'),
			strBob: q<SVGCircleElement>('[data-str-bob]'),
			strHit: q<SVGCircleElement>('[data-str-hit]'),
			sprEq: q<SVGLineElement>('[data-spr-eq]'),
			sprDl: q<SVGGElement>('[data-spr-dl]'),
			sprNat: q<SVGLineElement>('[data-spr-nat]'),
			sprDlLine: q<SVGLineElement>('[data-spr-dl-line]'),
			sprDlText: q<SVGTextElement>('[data-spr-dl-text]'),
			sprDim: q<SVGGElement>('[data-spr-dim]'),
			sprDimLine: q<SVGLineElement>('[data-spr-dim-line]'),
			sprDimText: q<SVGTextElement>('[data-spr-dim-text]'),
			sprCoil: q<SVGPathElement>('[data-spr-coil]'),
			sprWeight: q<SVGGElement>('[data-spr-weight]'),
			sprBody: q<SVGRectElement>('[data-spr-body]'),
			sprHit: q<SVGCircleElement>('[data-spr-hit]'),
			ggrid: q<SVGGElement>('[data-ggrid]'),
			glabels: q<SVGGElement>('[data-glabels]'),
			traceStr: q<SVGPathElement>('[data-trace-str]'),
			traceSpr: q<SVGPathElement>('[data-trace-spr]'),
			penStr: q<SVGCircleElement>('[data-pen-str]'),
			penSpr: q<SVGCircleElement>('[data-pen-spr]'),
			fStrT: q<HTMLElement>('[data-f-str-T]'),
			fStrNu: q<HTMLElement>('[data-f-str-nu]'),
			fSprT: q<HTMLElement>('[data-f-spr-T]'),
			fSprNu: q<HTMLElement>('[data-f-spr-nu]'),
			aStr: q<HTMLElement>('[data-a-str]'),
			aSpr: q<HTMLElement>('[data-a-spr]'),
			epStr: q<HTMLElement>('[data-ep-str]'),
			ekStr: q<HTMLElement>('[data-ek-str]'),
			epSpr: q<HTMLElement>('[data-ep-spr]'),
			ekSpr: q<HTMLElement>('[data-ek-spr]'),
			noteStr: q<HTMLElement>('[data-note-str]'),
			noteSpr: q<HTMLElement>('[data-note-spr]'),
			sw: q<HTMLElement>('.pl__sw'),
			swTime: q<HTMLOutputElement>('[data-sw-time]'),
			swGo: q<HTMLButtonElement>('[data-sw-go]'),
			swReset: q<HTMLButtonElement>('[data-sw-reset]'),
			swDec: q<HTMLButtonElement>('[data-sw-dec]'),
			swInc: q<HTMLButtonElement>('[data-sw-inc]'),
			swN: q<HTMLOutputElement>('[data-sw-n]'),
			swRes: q<HTMLElement>('[data-sw-res]'),
		};

		// ---- State -------------------------------------------------------------------------------
		const p = { l: 0.5, m: 0.4, k: 20, planet: 0, damp: false };
		const g = () => PLANETS[p.planet].g;
		const str: Osc = { x: 12 * DEG, v: 0, x0: 12 * DEG, held: false, amp: 12 * DEG, E0: 0 };
		const spr: Osc = { x: 0.08, v: 0, x0: 0.08, held: false, amp: 0.08, E0: 0 };
		let t = 0;
		let running = false;
		let touched = false; // the reader has dragged a pendulum at least once
		let sliding = false; // a slider is being dragged: hold both pendulums at their start
		let dragging = false; // the bob or the weight is being dragged: time runs even on pause
		let sampleAcc = 0;
		const samples: { t: number; s: number; p: number }[] = [];
		const sw = { on: false, t: 0, n: 10, done: false };

		// ---- Physics -----------------------------------------------------------------------------
		const accStr = (th: number, w: number) => -(g() / p.l) * Math.sin(th) - (p.damp ? 2 * BETA * w : 0);
		const accSpr = (y: number, v: number) => -(p.k / p.m) * y - (p.damp ? 2 * BETA * v : 0);
		const energyStr = (o: Osc) => {
			const ep = p.m * g() * p.l * (1 - Math.cos(o.x));
			const ek = 0.5 * p.m * (p.l * o.v) ** 2;
			return { ep, ek };
		};
		const energySpr = (o: Osc) => ({ ep: 0.5 * p.k * o.x * o.x, ek: 0.5 * p.m * o.v * o.v });
		const thetaMax = () => Math.min(45 * DEG, p.l * S > STR_DXMAX ? Math.asin(STR_DXMAX / (p.l * S)) : 45 * DEG);
		const strDx = () => p.l * Math.sin(str.x); // horizontal displacement, m

		const release = (o: Osc, x0: number, energy: (o: Osc) => { ep: number }) => {
			o.x0 = x0;
			o.x = x0;
			o.v = 0;
			o.amp = Math.abs(x0);
			o.E0 = energy(o).ep;
		};
		const restartBoth = () => {
			release(str, Math.min(Math.abs(str.x0), thetaMax()), energyStr);
			release(spr, Math.min(Math.abs(spr.x0), SPR_AMAX), energySpr);
			t = 0;
			sampleAcc = 0;
			samples.length = 0;
			samples.push({ t: 0, s: strDx(), p: spr.x });
			resetStopwatch();
		};

		const step = (o: Osc, acc: (x: number, v: number) => number, h: number) => {
			if (o.held) return;
			const before = o.v;
			[o.x, o.v] = rk4(o.x, o.v, h, acc);
			if (before !== 0 && Math.sign(before) !== Math.sign(o.v)) o.amp = Math.abs(o.x);
		};
		const advance = (dt: number) => {
			let rest = dt;
			while (rest > 1e-9) {
				const h = Math.min(H, rest);
				step(str, accStr, h);
				step(spr, accSpr, h);
				t += h;
				rest -= h;
				sampleAcc += h;
				if (sampleAcc >= 0.01) {
					sampleAcc -= 0.01;
					samples.push({ t, s: strDx(), p: spr.x });
				}
			}
			if (sw.on) sw.t += dt;
			const keepFrom = t - W - 0.5;
			let cut = 0;
			while (cut < samples.length && samples[cut].t < keepFrom) cut++;
			if (cut > 200) samples.splice(0, cut);
		};

		// ---- Drawing helpers ---------------------------------------------------------------------
		const set = (node: Element, attrs: Record<string, number | string>) => {
			for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, typeof v === 'number' ? v.toFixed(2) : v);
		};
		const show = (node: SVGElement | HTMLElement, on: boolean) => {
			node.style.visibility = on ? 'visible' : 'hidden';
		};

		const bobR = () => 9 + 6 * Math.cbrt(p.m / 0.5);
		const weightSize = () => {
			const w = 20 + 16 * Math.cbrt(p.m / 0.5);
			return { w, h: w * 0.85 };
		};
		const sprEnd = (y: number) => PY + (L0 + (p.m * g()) / p.k - y) * S; // lower end of the spring, px
		const weightCentre = (y: number) => sprEnd(y) + 4 + weightSize().h / 2;

		const coilPath = (y1: number, y2: number) => {
			const lead = 5;
			const turns = 12;
			const a = y1 + lead;
			const b = y2 - lead;
			const n = turns * 2;
			let d = `M ${SPR_X} ${y1} L ${SPR_X} ${a.toFixed(2)}`;
			for (let i = 0; i < n; i++) {
				const y = a + ((i + 0.5) / n) * (b - a);
				d += ` L ${(SPR_X + (i % 2 ? -9 : 9)).toFixed(2)} ${y.toFixed(2)}`;
			}
			return `${d} L ${SPR_X} ${b.toFixed(2)} L ${SPR_X} ${y2.toFixed(2)}`;
		};

		// The scene keeps its scale and grows or shrinks to fit the pendulums.
		let viewH = 390;
		let tween = 0;
		const neededH = () => {
			const strBottom = PY + p.l * S + bobR() + 48;
			const sprBottom = weightCentre(-SPR_AMAX) + weightSize().h / 2 + 14;
			return Math.ceil(Math.max(220, strBottom, sprBottom) / 10) * 10;
		};
		const setViewH = (h: number) => {
			viewH = h;
			scene.setAttribute('viewBox', `0 0 720 ${h.toFixed(1)}`);
		};
		const fitHeight = (animate: boolean) => {
			const target = neededH();
			cancelAnimationFrame(tween);
			if (!animate || reduceMotion() || Math.abs(target - viewH) < 1) return setViewH(target);
			const from = viewH;
			const start = performance.now();
			const stepH = (now: number) => {
				const k = Math.min(1, (now - start) / 350);
				setViewH(from + (target - from) * (1 - (1 - k) ** 3));
				if (k < 1) tween = requestAnimationFrame(stepH);
			};
			tween = requestAnimationFrame(stepH);
		};

		const drawScene = () => {
			// String pendulum.
			const L = p.l * S;
			const bx = STR_X + L * Math.sin(str.x);
			const by = PY + L * Math.cos(str.x);
			const r = bobR();
			set(el.strLine, { x2: bx, y2: by });
			set(el.strBob, { cx: bx, cy: by, r });
			set(el.strHit, { cx: bx, cy: by });
			set(el.strEq, { y2: PY + L + r + 14 });
			set(el.strL, { x: STR_X + (L / 2) * Math.sin(str.x) + (str.x >= 0 ? -16 : 8), y: PY + (L / 2) * Math.cos(str.x) + 5 });
			const th = Math.abs(str.x0);
			const ax = L * Math.sin(th);
			const ay = PY + L * Math.cos(th);
			el.strArc.setAttribute(
				'd',
				`M ${(STR_X - ax).toFixed(2)} ${ay.toFixed(2)} A ${L.toFixed(2)} ${L.toFixed(2)} 0 0 0 ${(STR_X + ax).toFixed(2)} ${ay.toFixed(2)}`,
			);
			const dimY = ay + r + 12;
			set(el.strDimLine, { x1: STR_X, y1: dimY, x2: STR_X + ax, y2: dimY });
			set(el.strDimText, { x: STR_X + ax / 2 - 5, y: dimY + 19 });
			show(el.strDim, ax > 22);
			el.strHit.setAttribute('aria-valuenow', String(Math.round(str.x / DEG)));

			// Spring pendulum.
			const dl = (p.m * g()) / p.k;
			const end = sprEnd(spr.x);
			const { w, h } = weightSize();
			el.sprCoil.setAttribute('d', coilPath(PY, end));
			set(el.sprBody, { x: -w / 2, y: 4, width: w, height: h });
			el.sprWeight.setAttribute('transform', `translate(${SPR_X} ${end.toFixed(2)})`);
			const c = weightCentre(spr.x);
			set(el.sprHit, { cx: SPR_X, cy: c });
			const c0 = weightCentre(0);
			set(el.sprEq, { x1: SPR_X - 48, y1: c0, x2: SPR_X + 60, y2: c0 });
			const nat = PY + L0 * S;
			const eqEnd = sprEnd(0);
			set(el.sprNat, { x1: SPR_X - 54, y1: nat, x2: SPR_X - 22, y2: nat });
			set(el.sprDlLine, { x1: SPR_X - 44, y1: nat, x2: SPR_X - 44, y2: eqEnd });
			set(el.sprDlText, { x: SPR_X - 52, y: (nat + eqEnd) / 2 + 5 });
			show(el.sprDl, dl * S > 22);
			const a0 = Math.abs(spr.x0) * S;
			set(el.sprDimLine, { x1: SPR_X + 52, y1: c0, x2: SPR_X + 52, y2: c0 - a0 });
			set(el.sprDimText, { x: SPR_X + 60, y: c0 - a0 / 2 + 6 });
			show(el.sprDim, a0 > 20);
			el.sprHit.setAttribute('aria-valuenow', String(Math.round(spr.x * 100)));

			el.hint.setAttribute('y', String(by + 5));
			el.hint.setAttribute('x', String(STR_X - 12));
			el.hint.style.opacity = touched || running ? '0' : '1';
		};

		// Graph: a scrolling strip of the last W seconds.
		const gridLines = Array.from({ length: W + 2 }, () => el.ggrid.appendChild(document.createElementNS(SVG_NS, 'line')));
		const timeLabels = Array.from({ length: W + 2 }, () => el.glabels.appendChild(document.createElementNS(SVG_NS, 'text')));
		const yLines = Array.from({ length: 4 }, () => el.ggrid.appendChild(document.createElementNS(SVG_NS, 'line')));
		const yLabels = Array.from({ length: 5 }, () => el.glabels.appendChild(document.createElementNS(SVG_NS, 'text')));
		let range = 15; // half-height of the graph, cm

		const pickRange = () => {
			const a = Math.max(p.l * Math.sin(Math.abs(str.x0)), Math.abs(spr.x0), 0.01) * 100;
			range = RANGES.find((r) => r >= a * 1.08) ?? RANGES[RANGES.length - 1];
			const ys = [range, range / 2, 0, -range / 2, -range];
			ys.forEach((v, i) => {
				const y = GMID - (v / range) * GHALF;
				set(yLabels[i], { x: GX0 - 7, y: y + 4.5, 'text-anchor': 'end' });
				yLabels[i].textContent = fmt(v, Number.isInteger(v) ? 0 : 1);
			});
			[range, range / 2, -range / 2, -range].forEach((v, i) => {
				const y = GMID - (v / range) * GHALF;
				set(yLines[i], { x1: GX0, y1: y, x2: GX1, y2: y });
			});
		};
		const gx = (tt: number, t0: number) => GX0 + ((tt - t0) / W) * (GX1 - GX0);
		const gy = (x: number) => GMID - ((x * 100) / range) * GHALF;

		const drawGraph = () => {
			const t0 = Math.max(0, t - W);
			const first = Math.ceil(t0);
			gridLines.forEach((ln, i) => {
				const s = first + i;
				const x = gx(s, t0);
				const on = s <= t0 + W + 1e-9 && x >= GX0 - 0.5;
				show(ln, on);
				show(timeLabels[i], on && s > 0);
				if (!on) return;
				set(ln, { x1: x, y1: 12, x2: x, y2: 170 });
				set(timeLabels[i], { x, y: 194, 'text-anchor': 'middle' });
				timeLabels[i].textContent = String(s);
			});
			let ds = '';
			let dp = '';
			for (const smp of samples) {
				if (smp.t < t0 - 0.02) continue;
				const x = gx(smp.t, t0).toFixed(1);
				ds += `${ds ? 'L' : 'M'}${x} ${gy(smp.s).toFixed(1)}`;
				dp += `${dp ? 'L' : 'M'}${x} ${gy(smp.p).toFixed(1)}`;
			}
			el.traceStr.setAttribute('d', ds);
			el.traceSpr.setAttribute('d', dp);
			const xn = gx(t, t0);
			set(el.penStr, { cx: xn, cy: gy(strDx()) });
			set(el.penSpr, { cx: xn, cy: gy(spr.x) });
		};

		// ---- Numbers and formulas ----------------------------------------------------------------
		const Tstr = () => periodString(p.l, g());
		const Tspr = () => periodSpring(p.m, p.k);
		// The true period of the string pendulum grows with the swing, so compare that one.
		const ratio = () => (Tstr() * largeAngleFactor(str.amp)) / Tspr();
		const matched = () => Math.abs(ratio() - 1) < 0.01;

		const drawFormulas = () => {
			const gg = g();
			tex(
				el.fStrT,
				`T = 2\\pi\\sqrt{\\dfrac{l}{g}} = 2\\pi\\sqrt{\\dfrac{${tnum(p.l, 2)}~\\text{м}}{${tnum(gg, 1)}~\\text{м/с}^2}} \\approx ${tnum(Tstr(), 2)}~\\text{с}`,
			);
			tex(el.fStrNu, `\\nu = \\dfrac{1}{T} \\approx ${tnum(1 / Tstr(), 2)}~\\text{Гц}`);
			tex(
				el.fSprT,
				`T = 2\\pi\\sqrt{\\dfrac{m}{k}} = 2\\pi\\sqrt{\\dfrac{${tnum(p.m, 2)}~\\text{кг}}{${tnum(p.k, 1)}~\\text{Н/м}}} \\approx ${tnum(Tspr(), 2)}~\\text{с}`,
			);
			tex(el.fSprNu, `\\nu = \\dfrac{1}{T} \\approx ${tnum(1 / Tspr(), 2)}~\\text{Гц}`);
			const dl = (p.m * gg) / p.k;
			el.noteSpr.innerHTML = `Груз растягивает пружину на <i>Δl</i> = ${fmt(dl * 100, 1)} см.`;
		};

		const drawLive = () => {
			const es = energyStr(str);
			const ep = energySpr(spr);
			const bar = (eP: HTMLElement, eK: HTMLElement, e: { ep: number; ek: number }, e0: number) => {
				const k = e0 > 1e-9 ? 100 / e0 : 0;
				eP.style.width = `${Math.min(100, e.ep * k).toFixed(1)}%`;
				eK.style.width = `${Math.min(100 - Math.min(100, e.ep * k), e.ek * k).toFixed(1)}%`;
			};
			bar(el.epStr, el.ekStr, es, str.E0);
			bar(el.epSpr, el.ekSpr, ep, spr.E0);
			el.aStr.textContent = `${fmt(p.l * Math.sin(str.amp) * 100, 1)} см (угол ${fmt(str.amp / DEG, 0)}°)`;
			el.aSpr.textContent = `${fmt(spr.amp * 100, 1)} см`;
			const extra = (largeAngleFactor(str.amp) - 1) * 100;
			const note =
				extra >= 0.5
					? `Угол большой, и настоящий период на ${fmt(extra, 1)} % больше, чем по формуле: она верна для малых углов.`
					: '';
			if (el.noteStr.textContent !== note) el.noteStr.textContent = note;
			el.swTime.textContent = `${fmt(sw.t, 2)} с`;
		};

		const setStatus = () => {
			let msg = '';
			const isMatch = matched();
			if (str.held || spr.held) msg = 'Отпустите — и маятник начнёт качаться.';
			else if (isMatch) msg = 'Маятники качаются в такт: их периоды совпадают!';
			else if (!running) msg = 'Нажмите «Пуск» или потяните шарик либо груз и отпустите.';
			else if (Math.abs(ratio() - 1) < 0.05) msg = 'Почти в такт! Чуть-чуть подправьте длину или жёсткость.';
			if (el.status.textContent !== msg) el.status.textContent = msg;
			el.status.classList.toggle('is-match', isMatch && !str.held && !spr.held);
		};

		const drawAll = () => {
			drawScene();
			drawGraph();
			drawLive();
			setStatus();
		};

		// ---- Stopwatch ---------------------------------------------------------------------------
		const swTex = document.createElement('span');
		swTex.className = 'pl__sw-tex';
		const swCmp = document.createElement('span');
		swCmp.className = 'pl__sw-cmp';
		const showResult = () => {
			if (!sw.done || sw.t <= 0) {
				el.swRes.textContent = sw.on
					? `Считайте полные колебания. Нажмите «Стоп», когда их будет ${sw.n}.`
					: 'Запустите секундомер, когда шарик (или груз) в крайнем положении, и остановите через N полных колебаний.';
				return;
			}
			const T = sw.t / sw.n;
			el.swRes.replaceChildren(swTex, swCmp);
			tex(swTex, `T = \\dfrac{t}{N} = \\dfrac{${tnum(sw.t, 2)}~\\text{с}}{${sw.n}} \\approx ${tnum(T, 2)}~\\text{с}`);
			swCmp.textContent = `По формуле: нитяной — ${fmt(Tstr(), 2)} с, пружинный — ${fmt(Tspr(), 2)} с.`;
		};
		const resetStopwatch = () => {
			sw.on = false;
			sw.t = 0;
			sw.done = false;
			el.sw.classList.remove('is-running');
			el.swGo.textContent = 'Пуск';
			showResult();
		};
		el.swGo.addEventListener('click', () => {
			if (sw.on) {
				sw.on = false;
				sw.done = true;
			} else {
				if (sw.done) sw.t = 0;
				sw.on = true;
				sw.done = false;
				if (!running) setRunning(true);
			}
			el.sw.classList.toggle('is-running', sw.on);
			el.swGo.textContent = sw.on ? 'Стоп' : 'Пуск';
			showResult();
			drawLive();
		});
		el.swReset.addEventListener('click', () => {
			resetStopwatch();
			drawLive();
		});
		const setN = (n: number) => {
			sw.n = Math.max(1, Math.min(50, n));
			el.swN.textContent = String(sw.n);
			showResult();
		};
		el.swDec.addEventListener('click', () => setN(sw.n - 1));
		el.swInc.addEventListener('click', () => setN(sw.n + 1));

		// ---- Animation loop ----------------------------------------------------------------------
		const wake = animator(
			root,
			() => running || dragging,
			(dt) => {
				if (running || dragging) advance(dt);
				drawAll();
			},
		);
		const setRunning = (on: boolean) => {
			running = on;
			el.run.textContent = on ? 'Пауза' : 'Пуск';
			setStatus();
			drawScene();
			wake();
		};

		// ---- Controls ----------------------------------------------------------------------------
		const readSliders = () => {
			p.l = Math.round(L_SCALE.toValue(Number(el.lIn.value)) * 100) / 100;
			p.m = Number(el.mIn.value);
			p.k = Math.round(K_SCALE.toValue(Number(el.kIn.value)) * 10) / 10;
			el.lOut.textContent = `${fmt(p.l, 2)} м`;
			el.mOut.textContent = `${fmt(p.m, 2)} кг`;
			el.kOut.textContent = `${fmt(p.k, 1)} Н/м`;
		};
		const onParams = () => {
			readSliders();
			fitHeight(true);
			restartBoth();
			pickRange();
			drawFormulas();
			drawAll();
		};
		for (const input of [el.lIn, el.mIn, el.kIn]) {
			input.addEventListener('input', () => {
				sliding = true;
				str.held = spr.held = true;
				onParams();
			});
			input.addEventListener('change', () => {
				sliding = false;
				str.held = spr.held = false;
				drawAll();
				wake();
			});
		}
		el.planets.forEach((btn) =>
			btn.addEventListener('click', () => {
				p.planet = Number(btn.dataset.planet);
				el.planets.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
				onParams();
				wake();
			}),
		);
		el.run.addEventListener('click', () => setRunning(!running));
		el.restart.addEventListener('click', () => {
			restartBoth();
			drawAll();
			setRunning(true);
		});
		el.damp.addEventListener('change', () => {
			p.damp = el.damp.checked;
			restartBoth();
			drawAll();
			wake();
		});

		// ---- Dragging the bob and the weight -------------------------------------------------------
		const grab = (
			hit: SVGCircleElement,
			o: Osc,
			fromPoint: (pt: { x: number; y: number }, off: { x: number; y: number }) => number,
			energy: (o: Osc) => { ep: number },
		) => {
			let off = { x: 0, y: 0 };
			hit.addEventListener('pointerdown', (e) => {
				if (sliding) return;
				e.preventDefault();
				hit.setPointerCapture(e.pointerId);
				const pt = svgPoint(scene, e);
				off = { x: pt.x - Number(hit.getAttribute('cx')), y: pt.y - Number(hit.getAttribute('cy')) };
				o.held = true;
				dragging = true;
				touched = true;
				release(o, o.x, energy);
				wake();
			});
			hit.addEventListener('pointermove', (e) => {
				if (!dragging || !o.held || !hit.hasPointerCapture(e.pointerId)) return;
				release(o, fromPoint(svgPoint(scene, e), off), energy);
				pickRange();
				drawFormulas();
				if (!running) drawAll();
			});
			const letGo = (e: PointerEvent) => {
				if (!hit.hasPointerCapture(e.pointerId)) return;
				hit.releasePointerCapture(e.pointerId);
				o.held = false;
				dragging = false;
				if (!running) setRunning(true);
				drawAll();
			};
			hit.addEventListener('pointerup', letGo);
			hit.addEventListener('pointercancel', letGo);

			// Keyboard: arrows move, Enter or Space lets go.
			hit.addEventListener('keydown', (e) => {
				const d = { ArrowRight: 1, ArrowUp: 1, ArrowLeft: -1, ArrowDown: -1 }[e.key];
				if (d !== undefined) {
					e.preventDefault();
					o.held = true;
					touched = true;
					const stepSize = o === str ? 1 * DEG : 0.005;
					const lim = o === str ? thetaMax() : SPR_AMAX;
					release(o, Math.max(-lim, Math.min(lim, o.x + d * stepSize)), energy);
					pickRange();
					drawFormulas();
					drawAll();
				} else if ((e.key === 'Enter' || e.key === ' ') && o.held) {
					e.preventDefault();
					o.held = false;
					if (!running) setRunning(true);
					drawAll();
				}
			});
			hit.addEventListener('blur', () => {
				if (o.held && !dragging) {
					o.held = false;
					drawAll();
				}
			});
		};
		grab(
			el.strHit,
			str,
			(pt, off) => {
				const th = Math.atan2(pt.x - off.x - STR_X, Math.max(1, pt.y - off.y - PY));
				const lim = thetaMax();
				return Math.max(-lim, Math.min(lim, th));
			},
			energyStr,
		);
		grab(
			el.sprHit,
			spr,
			(pt, off) => {
				const y = (weightCentre(0) - (pt.y - off.y)) / S;
				return Math.max(-SPR_AMAX, Math.min(SPR_AMAX, y));
			},
			energySpr,
		);

		// ---- Start -------------------------------------------------------------------------------
		el.lIn.value = String(Math.round(L_SCALE.toPos(p.l)));
		el.kIn.value = String(Math.round(K_SCALE.toPos(p.k)));
		el.mIn.value = String(p.m);
		readSliders();
		fitHeight(false);
		restartBoth();
		pickRange();
		drawFormulas();
		drawAll();
		setN(10);
	}
</script>
