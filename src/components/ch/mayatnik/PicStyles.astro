---
/** Frame and shared parts of the explanatory pictures of «Колебательное движение. Маятник» (panels, caption, buttons, bobs, arrows). Renders nothing. */
---

<style is:global>
	.mp-pic {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.mp-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.mp-pic--one .mp-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 28rem;
		margin-inline: auto;
	}
	.mp-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.mp-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.mp-pic .mp-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.mp-pic .mp-sym {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 16px;
		fill: var(--sl-color-gray-1);
	}
	.mp-pic .mp-t-force {
		fill: var(--ig-v);
	}
	.mp-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.mp-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.mp-pic__foot i {
		font-family: var(--ig-font-math);
	}
	.mp-pic__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}
	.mp-pic__btn,
	.mp-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.mp-pic__btn:hover,
	.mp-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.mp-pic__btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
		color: var(--sl-color-white);
	}
	/* parts */
	.mp-ceiling {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.mp-hatch {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.mp-thread {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.mp-pivot {
		fill: var(--sl-color-gray-2);
	}
	.mp-ball {
		fill: var(--ig-vx);
		stroke: color-mix(in srgb, var(--ig-vx) 60%, var(--sl-color-white));
		stroke-width: 1.2;
	}
	.mp-weight {
		fill: var(--ig-vy);
		stroke: color-mix(in srgb, var(--ig-vy) 60%, var(--sl-color-white));
		stroke-width: 1.2;
	}
	.mp-spring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.mp-eq {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
	}
	.mp-dim {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
		fill: none;
	}
	.mp-force {
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linecap: round;
		fill: none;
	}
	.mp-head-force {
		fill: var(--ig-v);
	}
	.mp-head-dim {
		fill: var(--sl-color-gray-1);
	}
	@media (max-width: 40rem) {
		.mp-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
