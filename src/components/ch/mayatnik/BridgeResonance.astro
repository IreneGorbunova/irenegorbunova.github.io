	}
	.br__stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.5rem;
		margin: 0.7rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.br__stats div {
		display: flex;
		gap: 0.4rem;
	}
