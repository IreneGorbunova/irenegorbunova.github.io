		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.br__tower {
		fill: var(--sl-color-gray-3);
	}
	.br__cable {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
	}
	.br__hangers line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.br__deck {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 55%, var(--sl-color-gray-3));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.br__controls {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: 0.6rem 1.2rem;
		margin-top: 0.8rem;
	}
	.br__slider {
		flex: 1 1 18rem;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.2rem 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.br__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.br__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.br__seg,
	.br__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
