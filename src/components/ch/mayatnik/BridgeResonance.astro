	}
	.br__grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.br__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.br__labels text {
		font-family: var(--__sl-font);
		font-size: 14px;
		fill: var(--sl-color-gray-3);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
	}
	.br__labels .br__it {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.br__nu0 {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 4;
	}
	.br__curve {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.br__now {
		stroke: var(--sl-color-text-accent);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.br__dot {
		fill: var(--sl-color-text-accent);
		stroke: var(--sl-color-bg);
		stroke-width: 2;
	}
	.br__caption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.br {
			padding: 0.75rem;
		}
		.br__labels text {
			font-size: 24px;
		}
	}
</style>

<script>
	import { loop } from '@components/ch/g7/kit';
	import { figure, walk, ANKLE_CM, SKELETON, DEG, add, polar, mk, type Pt, type HandTarget, type Figure } from '@components/people';
	import { fmt } from './util';

	const f1 = (v: number) => v.toFixed(1);
	const X0 = 96;
	const SPAN = 528;
	const DECK = 196;
	const K = 30; // px per м
	const EXAG = 20;
	const S = 0.3; // px per см
	const HS = 175; // см
	const STEP = 0.75 * K; // px
	const GAP = 4 * STEP; // 3 м
	const NS = 10;
	const WRAP = NS * GAP; // 900 px, 40 steps
	const M = 8000;
	const ZETA = 0.02;
	const W0 = 2 * Math.PI * 2.0;
	const AG = 0.4 * 80 * 9.8; // Н
	const LM = SPAN / K; // м
	const F0 = AG * (1 / 3) * ((2 * LM) / Math.PI);
	const DEL = [0, 0.09, -0.07, 0.12, -0.11, 0.04, -0.03, 0.1, -0.06, 0.07];
	const PSI = [0, 0.37, 0.71, 0.13, 0.52, 0.89, 0.27, 0.64, 0.05, 0.81];
	// chart
	const CX0 = 72;
	const CX1 = 690;
	const CY0 = 196;
	const CY1 = 40;
	const NU0 = 1.2;
	const NU1 = 2.8;
	const AMAX = 3;
	const cx = (nu: number) => CX0 + ((nu - NU0) / (NU1 - NU0)) * (CX1 - CX0);
	const cy = (a: number) => CY0 - (Math.min(a, AMAX + 0.15) / AMAX) * (CY0 - CY1);
	const steady = (nu: number) => {
		const w = 2 * Math.PI * nu;
		return (100 * F0) / M / Math.sqrt((W0 * W0 - w * w) ** 2 + (2 * ZETA * W0 * w) ** 2); // см
	};
	const shape = (x: number) => (x > X0 && x < X0 + SPAN ? Math.sin((Math.PI * (x - X0)) / SPAN) : 0);

	/** A marching soldier: the hip at `hipX`, feet planted by the walk cycle of distance d, arms swinging. */
	const marcher = (p: Figure) => {
		const sk = SKELETON.adult;
		const u = S * HS;
		const ay = DECK - ANKLE_CM.lowshoe * S;
		const legL = (sk.thigh + sk.shin) * u;
		const len = (sk.upper + sk.fore) * u * 0.95 + 0.045 * u;
		return (d: number, step: number, base: number, plant: boolean) => {
			const w = walk(d, step, 0, Math.max(0.05 * u, 1.6));
			const hip = { x: base + d, y: ay - legL * 0.93 + w.bob };
			const sh = p.shoulders(hip, 0.03);
			const swing = (s: Pt, a: number): HandTarget => ({ at: add(s, polar(len, Math.PI / 2 - a)), pose: 'relaxed' });
			p.pose({
				hip,
				lean: 0.03,
				ankles: [
					{ x: base + w.feet[0].x + step * 0.5, y: ay - w.feet[0].up },
					{ x: base + w.feet[1].x + step * 0.5, y: ay - w.feet[1].up },
				],
				feet: [w.feet[0].toe, w.feet[1].toe],
				hands: [swing(sh[0], -24 * DEG * w.arm), swing(sh[1], 24 * DEG * w.arm)],
				planted: [plant && w.feet[0].planted, plant && w.feet[1].planted],
			});
			return hip.x;
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-bridge]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const nuIn = q<HTMLInputElement>('[data-nu]');
		const nuOut = q<HTMLOutputElement>('[data-nu-out]');
		const ampOut = q<HTMLElement>('[data-amp]');
		const deck = q<SVGPathElement>('[data-deck]');
		const cable = q<SVGPathElement>('[data-cable]');
		const hangers = Array.from(root.querySelectorAll<SVGLineElement>('[data-hx]'));
		const curve = q<SVGPathElement>('[data-curve]');
		const dot = q<SVGCircleElement>('[data-dot]');
		const nowLine = q<SVGLineElement>('[data-now-line]');
		const stepBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-step]'));
		const host = q<SVGGElement>('[data-soldiers]');

		const soldiers = Array.from({ length: NS }, (_, i) => {
			const g = mk(host, 'g', {});
			const inner = mk(g, 'g', {});
			const p = figure(inner, { s: S, H: HS, clothes: 'home', shirt: 'hm-green', name: `soldier-${i + 1}` });
			return { g, pose: marcher(p), lastD: -1 };
		});

		let nu = Number(nuIn.value);
		let inStep = true;
		let dist = 0; // px the column has gone
		let qd = 0; // m, sag of the middle of the deck
		let vd = 0;
		let changed = true; // a frame where feet may jump (start, mode switch)
		const seen = new Set<number>();
		const bin = (v: number) => Math.round(v * 20);

		const drawCurve = () => {
			const bins = [...seen].sort((a, b) => a - b);
			let d = '';
			let prev = -99;
			for (const b of bins) {
				const v = b / 20;
				const pt = `${f1(cx(v))} ${f1(cy(steady(v)))}`;
				if (b === prev + 1) {
					// fill the gap between two neighbouring bins with the smooth curve
					for (let k = 1; k <= 4; k++) {
						const vv = (prev + k / 4) / 20;
						d += ` L${f1(cx(vv))} ${f1(cy(steady(vv)))}`;
					}
				} else d += ` M${pt} L${pt}`;
				prev = b;
			}
			curve.setAttribute('d', d.trim());
		};
		const deckY = (x: number) => DECK + EXAG * K * qd * shape(x);
		/** The far cable: 88 at the towers, 80 px lower in the middle, moving with the deck (the hangers keep their length). */
		const cableY = (x: number) => 88 + 80 * (1 - 4 * ((x - X0) / SPAN - 0.5) ** 2) + (deckY(x) - DECK);

		/**
		 * Soldier i: D — how far along the wrap (0…900 px), the hip at D − 90; his walk distance d and step. Out of step
		 * the step is shorter or longer by the factor 1/(1 + δ), so his cadence is ν(1 + δ) at the same speed, and his
		 * phase is shifted by ψ steps. A foot lands whenever d/step is a whole number, so his push is cos(2π·d/step).
		 */
		const gait = (i: number) => {
			const D = (dist + i * GAP) % WRAP;
			const step = inStep ? STEP : STEP / (1 + DEL[i]);
			const d = inStep ? D : D + PSI[i] * step;
			return { D, d, step, hipX: D - 90 };
		};
		const force = () => {
			let F = 0;
			for (let i = 0; i < NS; i++) {
				const g = gait(i);
				F += AG * shape(g.hipX) * Math.cos((2 * Math.PI * g.d) / g.step);
			}
			return F;
		};

		const draw = () => {
			// deck and cable
			let dd = '';
			let cd = '';
			for (let i = 0; i <= 48; i++) {
				const x = X0 + (i * SPAN) / 48;
				const y = deckY(x);
				dd += `${i ? ' L' : 'M'}${f1(x)} ${f1(y + 3)}`;
				cd += `${i ? ' L' : 'M'}${f1(x)} ${f1(cableY(x))}`;
			}
			deck.setAttribute('d', dd);
			cable.setAttribute('d', cd);
			for (const h of hangers) {
				const x = Number(h.dataset.hx);
				h.setAttribute('y1', f1(cableY(x)));
				h.setAttribute('y2', f1(deckY(x)));
			}
			// soldiers
			soldiers.forEach((s, i) => {
				const g = gait(i);
				const wrapped = g.D < s.lastD;
				s.lastD = g.D;
				const hipX = s.pose(g.d, g.step, g.hipX - g.d, !(wrapped || changed));
				s.g.setAttribute('transform', `translate(0 ${f1(deckY(hipX) - DECK)})`);
			});
			changed = false;
			// readouts
			const amp = 100 * Math.sqrt(qd * qd + (vd / W0) ** 2);
			ampOut.textContent = `${fmt(amp, 1)} см`;
			dot.setAttribute('cx', f1(cx(nu)));
			dot.setAttribute('cy', f1(cy(amp)));
			nowLine.setAttribute('x1', f1(cx(nu)));
			nowLine.setAttribute('x2', f1(cx(nu)));
			nowLine.setAttribute('y2', f1(cy(amp)));
		};

		loop(root, (dt) => {
			const h = 0.002;
			let rest = dt;
			while (rest > 1e-9) {
				const k = Math.min(h, rest);
				const a = force() / M - 2 * ZETA * W0 * vd - W0 * W0 * qd;
				vd += a * k;
				qd += vd * k;
				dist += STEP * nu * k;
				rest -= k;
			}
			draw();
			return true;
		});

		const setNu = () => {
			nu = Number(nuIn.value);
			nuOut.textContent = `${fmt(nu, 2)} Гц`;
			if (inStep) seen.add(bin(nu));
			drawCurve();
		};
		nuIn.addEventListener('input', setNu);
		stepBtns.forEach((b) =>
			b.addEventListener('click', () => {
				inStep = b.dataset.step === '1';
				stepBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				changed = true;
				if (inStep) seen.add(bin(nu));
				drawCurve();
			}),
		);
		q<HTMLButtonElement>('[data-all]').addEventListener('click', () => {
			for (let b = bin(NU0); b <= bin(NU1); b++) seen.add(b);
			drawCurve();
		});
		q<HTMLButtonElement>('[data-clear]').addEventListener('click', () => {
			seen.clear();
			if (inStep) seen.add(bin(nu));
			drawCurve();
		});
		setNu();
		draw();
	}
</script>
