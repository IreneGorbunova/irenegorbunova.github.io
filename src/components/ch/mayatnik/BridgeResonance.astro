---
/**
 * Resonance on a footbridge: a column of soldiers marches over a light suspension footbridge (side view).
 * Scale: 30 px per м; the span 17,6 м (528 px); soldiers 175 см tall (people kit, 0,3 px per см), steps of 0,75 м,
 * 3 м apart (four steps, so that in step all of them put the same foot down at once), ten soldiers in an endless column.
 * The bridge is one oscillator, its first mode: the deck sags as q·sin(πx/L), q'' + 2ζω0q' + ω0²q = F(t)/M with the
 * own frequency ν0 = 2,0 Гц, ζ = 0,02, the modal mass M = 8 т (a light footbridge). Each soldier on the deck pushes it
 * with the varying part of the force of his steps, 0,4·mg = 314 Н for m = 80 кг (walking: about 40 % of the weight at
 * the step frequency), times sin(πx/L) at his place; its maximum comes when a foot lands. In step all the pushes add up;
 * out of step every soldier has his own cadence (±12 %) and phase, with the step length changed so that the column keeps
 * its speed. Real time; the sag of the deck is drawn 20 times larger (said in the caption).
 * Numbers (recomputed in Python with the same equations): in step at ν = 2,0 Гц the middle of the deck swings with an
 * amplitude of about 2,3 см, at 1,5 or 2,5 Гц about 0,2 см; out of step at 2,0 Гц about 0,4–0,9 см.
 * The curve A(ν) below is the amplitude the bridge settles to in step, F0/(M·√((ω0² − ω²)² + (2ζω0ω)²)) with the mean
 * force of the column F0 = 314 Н · (1/3 м) · 2L/π = 1,2 кН; it is drawn bin by bin (0,05 Гц) where the slider has been;
 * the dot is the amplitude now, √(q² + (q'/ω0)²), so it climbs to the curve in a few seconds.
 * People: kit figures in profile, walk cycle from motion.ts with the stance foot planted; each soldier's group moves up
 * and down with the deck under him, so the planted foot stays on the deck. Soldiers leaving on the right come back on the
 * left off the picture (no foot is declared planted in that frame).
 */
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = `br-${Math.random().toString(36).slice(2, 8)}`;
const X0 = 96;
const SPAN = 528;
const DECK = 196;
const hangers = Array.from({ length: 21 }, (_, i) => X0 + 12 + i * 24.2);
// curve chart
const CX0 = 72;
const CX1 = 690;
const CY0 = 196;
const CY1 = 40;
const NU0 = 1.2;
const NU1 = 2.8;
const AMAX = 3;
const cx = (nu: number) => CX0 + ((nu - NU0) / (NU1 - NU0)) * (CX1 - CX0);
const cy = (a: number) => CY0 - (a / AMAX) * (CY0 - CY1);
const nuTicks = [1.2, 1.4, 1.6, 1.8, 2, 2.2, 2.4, 2.6, 2.8];
const aTicks = [1, 2, 3];
const num = (v: number) => String(v).replace('.', ',');
---

<PeopleStyles />
<figure class="br not-content" data-bridge>
	<svg class="br__scene" viewBox="0 0 720 290" role="img" aria-label="Колонна солдат идёт по лёгкому висячему мосту; мост раскачивается">
		<rect class="br__water" x="0" y="246" width="720" height="44" />
		<path class="br__wave" d="M20 262 q10 -4 20 0 t20 0 M140 274 q10 -4 20 0 t20 0 M300 258 q10 -4 20 0 t20 0 M470 270 q10 -4 20 0 t20 0 M600 260 q10 -4 20 0 t20 0" />
		<path class="br__bank" d={`M0 ${DECK} H${X0} L${X0 - 20} 250 H0 Z`} />
		<path class="br__bank" d={`M720 ${DECK} H${X0 + SPAN} L${X0 + SPAN + 20} 250 H720 Z`} />
		<rect class="br__tower" x={X0 - 6} y="84" width="10" height={DECK - 84} />
		<rect class="br__tower" x={X0 + SPAN - 4} y="84" width="10" height={DECK - 84} />
		<path class="br__cable" data-cable />
		<g class="br__hangers">
			{hangers.map((x) => <line x1={x} x2={x} data-hx={x} />)}
		</g>
		<g data-soldiers></g>
		<path class="br__deck" data-deck />
		<line class="br__road" x1="0" x2={X0} y1={DECK} y2={DECK} />
		<line class="br__road" x1={X0 + SPAN} x2="720" y1={DECK} y2={DECK} />
	</svg>

	<div class="br__controls">
		<label class="br__slider">
			<span>Частота шагов <i>ν</i> (шагов в секунду)</span>
			<output data-nu-out></output>
			<input type="range" min={NU0} max={NU1} step="0.05" value="1.5" data-nu />
		</label>
		<div class="br__seg" role="group" aria-label="Как идут солдаты">
			<button type="button" class="br__btn" aria-pressed="true" data-step="1">В ногу</button>
			<button type="button" class="br__btn" aria-pressed="false" data-step="0">Не в ногу</button>
		</div>
	</div>
	<dl class="br__stats">
		<div><dt>Собственная частота моста</dt><dd><i>ν</i><sub>0</sub> = 2,0 Гц</dd></div>
		<div><dt>Амплитуда колебаний середины моста</dt><dd data-amp>0 см</dd></div>
	</dl>

	<svg class="br__chart" viewBox="0 0 720 236" role="img" aria-label="Резонансная кривая: амплитуда колебаний моста в зависимости от частоты шагов">
		<g class="br__grid">
			{nuTicks.map((n) => <line x1={cx(n)} x2={cx(n)} y1={CY0} y2={CY1} />)}
			{aTicks.map((a) => <line x1={CX0} x2={CX1} y1={cy(a)} y2={cy(a)} />)}
		</g>
		<line class="br__axis" x1={CX0} y1={CY0} x2={CX1 + 8} y2={CY0} />
		<line class="br__axis" x1={CX0} y1={CY0} x2={CX0} y2={CY1 - 10} />
		<g class="br__labels">
			{nuTicks.slice(0, -1).map((n) => <text x={cx(n)} y={CY0 + 22} text-anchor="middle">{num(n)}</text>)}
			<text x={CX0 - 8} y={CY0 + 6} text-anchor="end">0</text>
			{aTicks.map((a) => <text x={CX0 - 8} y={cy(a) + 6} text-anchor="end">{a}</text>)}
			<text x={CX0 + 10} y={CY1 - 16}><tspan class="br__it">A</tspan>, см</text>
			<text x={CX1 + 10} y={CY0 + 22} text-anchor="end" class="br__unit"><tspan class="br__it">ν</tspan>, Гц</text>
		</g>
		<line class="br__nu0" x1={cx(2)} x2={cx(2)} y1={CY0} y2={CY1} />
		<path class="br__curve" data-curve />
		<line class="br__now" y1={CY0} data-now-line />
		<circle class="br__dot" r="7" data-dot />
	</svg>
	<div class="br__buttons">
		<button type="button" class="br__btn" data-all>Показать всю кривую</button>
		<button type="button" class="br__btn" data-clear>Стереть кривую</button>
	</div>
	<figcaption class="br__caption">
		Время настоящее, а прогиб моста нарисован в 20 раз больше. Кривая — амплитуда, до которой раскачивается мост при
		ходьбе в ногу; она рисуется там, где вы уже поставили частоту шагов. Точка — амплитуда сейчас. Вертикальный
		пунктир — собственная частота моста.
	</figcaption>
</figure>

<style is:global>
	.br {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.br i {
		font-family: var(--ig-font-math);
	}
	.br__scene,
	.br__chart {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.br__chart {
		margin-top: 0.8rem;
	}
	.br__water {
		fill: color-mix(in srgb, var(--ig-vx) 22%, var(--sl-color-bg));
	}
	.br__wave {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-bg));
