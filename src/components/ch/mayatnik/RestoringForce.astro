---
/**
 * Why a string pendulum comes back: gravity split into a part along the thread and a part F
 * along the path. The force triangle is similar to the triangle (l, x), so F = mg·x/l.
 * The bob is held still at angle α (just before release), so the thread pulls with exactly mg·cos α.
 */
const uid = `rf-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="rf not-content" data-rf>
	<svg class="rf__scene" viewBox="0 0 720 396" role="img" aria-label="Силы, действующие на отклонённый шарик нитяного маятника">
		<defs>
			{
				['g', 'f', 't', 'r'].map((k) => (
					<marker id={`${uid}-${k}`} class={`rf__head rf__head--${k}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
						<path d="M0,0 L10,5 L0,10 z" />
					</marker>
				))
			}
		</defs>
		<rect class="rf__ceiling" x="250" y="12" width="140" height="8" rx="2" />
		<line class="rf__eq" x1="320" y1="20" x2="320" y2="300" />
		<path class="rf__path" data-path />
		<path class="rf__tri" data-tri />
		<path class="rf__angle" data-angle />
		<text class="rf__sym" data-alpha>α</text>
		<line class="rf__thread" x1="320" y1="20" data-thread />
		<text class="rf__sym" data-l>l</text>
		<line class="rf__dimx" data-dimx />
		<text class="rf__sym" data-x>x</text>
		<line class="rf__help" data-help1 />
		<line class="rf__help" data-help2 />
		<line class="rf__vec rf__vec--r" marker-end={`url(#${uid}-r)`} data-vr />
		<line class="rf__vec rf__vec--t" marker-end={`url(#${uid}-t)`} data-vt />
		<line class="rf__vec rf__vec--g" marker-end={`url(#${uid}-g)`} data-vg />
		<line class="rf__vec rf__vec--f" marker-end={`url(#${uid}-f)`} data-vf />
		<text class="rf__sym rf__sym--g" data-tg>F<tspan class="rf__sub" dy="5">тяж</tspan></text>
		<text class="rf__sym rf__sym--f" data-tf>F</text>
		<text class="rf__sym rf__sym--t" data-tt>F<tspan class="rf__sub" dy="5">упр</tspan></text>
		<circle class="rf__pivot" cx="320" cy="20" r="4" />
		<circle class="rf__bob" r="11" data-bob />
		<circle class="rf__hit" r="34" tabindex="-1" data-hit />
	</svg>
	<div class="rf__panel">
		<label class="rf__slider">
			<span>Угол отклонения <i>α</i></span>
			<output data-a-out></output>
			<input type="range" min="-40" max="40" step="1" value="20" data-a />
		</label>
		<div class="rf__f" data-f1></div>
		<div class="rf__f" data-f2></div>
		<p class="rf__note" data-note></p>
	</div>
	<figcaption class="rf__legend">
		Тяните шарик или двигайте ползунок. Шарик пока держат на месте, как в крайней точке.
		<span class="rf__key rf__key--g"></span>сила тяжести <span class="rf__nw"><i>F</i><sub>тяж</sub> = <i>mg</i></span>,
		<span class="rf__key rf__key--t"></span>сила упругости нити, <span class="rf__key rf__key--f"></span>сила <i>F</i>,
		которая возвращает шарик. Нить <i>l</i> = 1 м, шарик <i>m</i> = 0,2 кг.
	</figcaption>
</figure>

<style is:global>
	.rf {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.rf i {
		font-family: var(--ig-font-math);
	}
	.rf__scene {
		display: block;
		width: 100%;
		height: auto;
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.rf__ceiling {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
	}
	.rf__eq,
	.rf__help {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		stroke-dasharray: 5 5;
	}
	.rf__help {
		stroke-dasharray: 3 4;
	}
	.rf__path {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
		stroke-dasharray: 2 5;
		stroke-linecap: round;
	}
	.rf__tri {
		fill: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
		stroke: none;
	}
	.rf__angle {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.rf__thread {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.rf__dimx {
		stroke: var(--sl-color-text-accent);
		stroke-width: 2;
	}
	.rf__pivot {
		fill: var(--sl-color-gray-2);
	}
	.rf__bob {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.rf__hit {
		fill: transparent;
		cursor: grab;
		touch-action: none;
		outline: none;
	}
	.rf__vec {
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.rf__vec--g {
		stroke: var(--ig-vy);
	}
	.rf__vec--f {
		stroke: var(--ig-vx);
		stroke-width: 3.5;
	}
	.rf__vec--t {
		stroke: var(--sl-color-gray-2);
	}
	.rf__vec--r {
		stroke: var(--sl-color-gray-4);
		stroke-dasharray: 4 4;
	}
	.rf__head--g path {
		fill: var(--ig-vy);
	}
	.rf__head--f path {
		fill: var(--ig-vx);
	}
	.rf__head--t path {
		fill: var(--sl-color-gray-2);
	}
	.rf__head--r path {
		fill: var(--sl-color-gray-4);
	}
	.rf__sym {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 18px;
		fill: var(--sl-color-gray-2);
	}
	.rf__sym--g {
		fill: var(--ig-vy);
	}
	.rf__sym--f {
		fill: var(--ig-vx);
		font-weight: 700;
	}
	.rf__sub {
		font-size: 12px;
		font-style: normal;
	}
	.rf__panel {
		display: grid;
		gap: 0.35rem;
		margin-top: 0.5rem;
	}
	.rf__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		max-width: 26rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rf__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.rf__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.rf__f {
		padding: 0.35rem 0.7rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		overflow-x: auto;
		overflow-y: hidden;
	}
	.rf__note,
	.rf__legend {
		margin: 0.2rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rf__legend {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.rf__nw {
		white-space: nowrap;
	}
	.rf__key {
		display: inline-block;
		width: 1.1rem;
		height: 3px;
		margin: 0 0.3rem 0.2rem 0.3rem;
		vertical-align: middle;
		border-radius: 2px;
	}
	.rf__key--g {
		background: var(--ig-vy);
	}
	.rf__key--t {
		background: var(--sl-color-gray-2);
	}
	.rf__key--f {
		background: var(--ig-vx);
	}
	@media (max-width: 40rem) {
		.rf {
			padding: 0.75rem;
		}
		.rf__sym {
			font-size: 22px;
		}
		.rf__sub {
			font-size: 15px;
		}
	}
</style>

<script>
	import { fmt, svgPoint, tex, tnum } from './util';

	const PX = 320;
	const PY = 20;
	const L = 230; // px, stands for l = 1 m
	const G = 130; // px, length of the mg arrow
	const M = 0.2;
	const GACC = 9.8;
	const DEG = Math.PI / 180;

	for (const root of document.querySelectorAll<HTMLElement>('[data-rf]')) {
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const svg = q<SVGSVGElement>('.rf__scene');
		const input = q<HTMLInputElement>('[data-a]');
		const out = q<HTMLOutputElement>('[data-a-out]');
		const hit = q<SVGCircleElement>('[data-hit]');
		const set = (sel: string, attrs: Record<string, number | string>) => {
			const node = q(sel);
			for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, typeof v === 'number' ? v.toFixed(2) : v);
		};
		const line = (sel: string, x1: number, y1: number, x2: number, y2: number) => set(sel, { x1, y1, x2, y2 });

		const draw = (deg: number) => {
			const a = deg * DEG;
			const s = Math.sin(a);
			const c = Math.cos(a);
			const bx = PX + L * s;
			const by = PY + L * c;
			const side = Math.sign(s) || 1;

			line('[data-thread]', PX, PY, bx, by);
			set('[data-bob]', { cx: bx, cy: by });
			set('[data-hit]', { cx: bx, cy: by });
			const amax = 40 * DEG;
			set('[data-path]', {
				d: `M ${PX - L * Math.sin(amax)} ${PY + L * Math.cos(amax)} A ${L} ${L} 0 0 0 ${PX + L * Math.sin(amax)} ${PY + L * Math.cos(amax)}`,
			});
			// Triangle (l, x) and the angle.
			set('[data-tri]', { d: `M ${PX} ${PY} L ${PX} ${by} L ${bx} ${by} Z` });
			line('[data-dimx]', PX, by, bx, by);
			set('[data-x]', { x: (PX + bx) / 2 - 5, y: by - 9 });
			const r = 46;
			set('[data-angle]', {
				d: `M ${PX} ${PY + r} A ${r} ${r} 0 0 ${s > 0 ? 0 : 1} ${PX + r * s} ${PY + r * c}`,
			});
			set('[data-alpha]', { x: PX + (r + 12) * Math.sin(a / 2) - 5, y: PY + (r + 12) * Math.cos(a / 2) + 6 });
			set('[data-l]', { x: PX + (L * 0.55) * s + side * 10 - (side < 0 ? 8 : 0), y: PY + L * 0.55 * c });
			const visible = Math.abs(deg) >= 3;
			for (const sel of ['[data-angle]', '[data-alpha]', '[data-x]', '[data-dimx]', '[data-tri]']) q<SVGElement>(sel).style.visibility = visible ? 'visible' : 'hidden';

			// Forces. Gravity down; its parts along the thread (outwards) and along the path (to the middle).
			line('[data-vg]', bx, by, bx, by + G);
			const gr = G * c; // along the thread
			const gt = G * s; // along the path, signed
			const rx = bx + gr * s;
			const ry = by + gr * c;
			line('[data-vr]', bx, by, rx, ry);
			const fx = bx - gt * c;
			const fy = by + gt * s;
			line('[data-vf]', bx, by, fx, fy);
			line('[data-vt]', bx, by, bx - gr * s, by - gr * c);
			line('[data-help1]', rx, ry, bx, by + G);
			line('[data-help2]', fx, fy, bx, by + G);
			for (const sel of ['[data-vf]', '[data-tf]', '[data-vr]', '[data-help1]', '[data-help2]']) q<SVGElement>(sel).style.visibility = visible ? 'visible' : 'hidden';
			set('[data-tg]', { x: bx + 12, y: by + G + 2 });
			set('[data-tf]', { x: fx - side * c * 16 - 6, y: fy + s * side * 16 + 6 });
			set('[data-tt]', { x: bx - gr * s * 0.6 + (side > 0 ? 10 : -38), y: by - gr * c * 0.6 });

			out.value = `${deg < 0 ? '−' : ''}${Math.abs(deg)}°`;
			hit.setAttribute('aria-valuenow', String(deg));
			const xl = Math.abs(s);
			tex(
				q('[data-f1]'),
				`\\sin\\alpha = \\frac{x}{l} = \\frac{${tnum(xl, 2)}~\\text{м}}{1~\\text{м}} = ${tnum(xl, 2)}`,
			);
			tex(
				q('[data-f2]'),
				`F = mg\\sin\\alpha = mg\\cdot\\frac{x}{l} = 0{,}2~\\text{кг}\\cdot 9{,}8~\\tfrac{\\text{м}}{\\text{с}^2}\\cdot ${tnum(xl, 2)} \\approx ${tnum(M * GACC * xl, 2)}~\\text{Н}`,
			);
			const arc = Math.abs(a);
			const diff = arc > 0 ? ((arc - xl) / arc) * 100 : 0;
			q('[data-note]').innerHTML =
				Math.abs(deg) < 1
					? 'Шарик в положении равновесия: сила тяжести уравновешена силой упругости нити, возвращающей силы нет.'
					: `Шарик прошёл по дуге ${fmt(arc, 3)} м, а по горизонтали сместился на <i>x</i> = ${fmt(xl, 3)} м — разница ${fmt(diff, 1)} %.`;
		};

		// On a narrow screen show only the part of the scene where the pendulum and its forces live.
		const narrow = window.matchMedia('(max-width: 40rem)');
		const fit = () => svg.setAttribute('viewBox', narrow.matches ? '125 4 420 388' : '0 0 720 396');
		narrow.addEventListener('change', fit);
		fit();

		input.addEventListener('input', () => draw(Number(input.value)));
		let dragging = false;
		hit.addEventListener('pointerdown', (e) => {
			e.preventDefault();
			hit.setPointerCapture(e.pointerId);
			dragging = true;
		});
		hit.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const p = svgPoint(svg, e);
			const deg = Math.round(Math.atan2(p.x - PX, Math.max(1, p.y - PY)) / DEG);
			const clamped = Math.max(-40, Math.min(40, deg));
			input.value = String(clamped);
			draw(clamped);
		});
		const stop = () => (dragging = false);
		hit.addEventListener('pointerup', stop);
		hit.addEventListener('pointercancel', stop);
		draw(Number(input.value));
	}
</script>
