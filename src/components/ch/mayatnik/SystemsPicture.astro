---
/**
 * Picture to the definitions of oscillations, of the position of equilibrium and of an oscillating system.
 * Left: a ball on a thread, l = 140 px = 0,47 m at 300 px per metre, T = 2π√(l/g) ≈ 1,37 s, amplitude 15°.
 * Right: a weight on a spring, T = 0,9 s, amplitude 30 px = 10 cm.
 * Both move as harmonic oscillations in real time. The arrow is the force that pulls the body back to the position of
 * equilibrium: for the ball the part of gravity along its path, mg·sin α (drawn along the path); for the weight the
 * spring force minus gravity, k·x. Both grow with the displacement x and vanish at the position of equilibrium.
 */
import PicStyles from './PicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mF = `mps-f-${uid}`;
const mD = `mps-d-${uid}`;
const hatch = (x0: number, x1: number, y: number) =>
	Array.from({ length: Math.floor((x1 - x0) / 10) + 1 }, (_, i) => x0 + i * 10).map((x) => `M${x} ${y} l8 -8`).join(' ');
---

<PicStyles />
<figure class="mp-pic not-content" data-mp-systems>
	<div class="mp-pic__grid">
		<svg class="mp-pic__svg" viewBox="0 0 320 240" role="img" aria-label="Нитяной маятник: шарик на нити качается около положения равновесия, где нить вертикальна. Сила, которая возвращает шарик к положению равновесия, тем больше, чем больше его смещение">
			<defs>
				<marker id={mF} viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="mp-head-force" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
				<marker id={mD} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
					<path class="mp-head-dim" d="M0 1 L10 5 L0 9 z"></path>
				</marker>
			</defs>
			<text class="mp-title" x="160" y="20" text-anchor="middle">Нитяной маятник</text>
			<path class="mp-hatch" d={hatch(112, 200, 34)}></path>
			<rect class="mp-ceiling" x="110" y="34" width="100" height="5" rx="1.5"></rect>
			<line class="mp-eq" x1="160" y1="40" x2="160" y2="214"></line>
			<line class="mp-thread" x1="160" y1="40" data-s-thread></line>
			<circle class="mp-pivot" cx="160" cy="40" r="3"></circle>
			<text x="214" y="42">подвес</text>
			<text data-s-tlabel>нить</text>
			<line class="mp-force" marker-end={`url(#${mF})`} data-s-force></line>
			<circle class="mp-ball" r="10" data-s-ball></circle>
			<text data-s-blabel>шарик</text>
			<line class="mp-dim" marker-start={`url(#${mD})`} marker-end={`url(#${mD})`} data-s-dim></line>
			<text class="mp-sym" text-anchor="middle" data-s-x>x</text>
			<text x="160" y="234" text-anchor="middle">положение равновесия</text>
		</svg>
		<svg class="mp-pic__svg" viewBox="0 0 320 240" role="img" aria-label="Пружинный маятник: груз на пружине колеблется вверх и вниз около положения равновесия. Сила, которая возвращает груз к положению равновесия, тем больше, чем больше его смещение">
			<text class="mp-title" x="160" y="20" text-anchor="middle">Пружинный маятник</text>
			<path class="mp-hatch" d={hatch(72, 160, 34)}></path>
			<rect class="mp-ceiling" x="70" y="34" width="100" height="5" rx="1.5"></rect>
			<path class="mp-spring" data-p-spring></path>
			<text x="132" y="78">пружина</text>
			<line class="mp-eq" x1="40" y1="150" x2="300" y2="150"></line>
			<text x="300" y="168" text-anchor="end">положение</text>
			<text x="300" y="184" text-anchor="end">равновесия</text>
			<rect class="mp-weight" x="104" width="32" height="26" rx="3" data-p-weight></rect>
			<text x="98" text-anchor="end" data-p-wlabel>груз</text>
			<line class="mp-force" marker-end={`url(#${mF})`} data-p-force></line>
			<line class="mp-dim" marker-start={`url(#${mD})`} marker-end={`url(#${mD})`} data-p-dim></line>
			<text class="mp-sym" data-p-x>x</text>
		</svg>
	</div>
	<div class="mp-pic__foot">
		<figcaption>
			Шарик на нити и груз на пружине качаются около положения равновесия. <span class="mp-key"></span> — сила,
			которая тянет тело обратно к положению равновесия: чем больше смещение <i>x</i>, тем она больше. В положении
			равновесия она равна нулю, но тело по инерции проскакивает его.
		</figcaption>
	</div>
</figure>

<style is:global>
	.mp-key {
		display: inline-block;
		width: 1.4em;
		height: 0;
		border-top: 3px solid var(--ig-v);
		vertical-align: middle;
		border-radius: 2px;
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	for (const root of document.querySelectorAll<HTMLElement>('[data-mp-systems]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const set = (el: Element, attrs: Record<string, number | string>) => {
			for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, typeof v === 'number' ? v.toFixed(1) : v);
		};
		const sThread = $<SVGLineElement>('[data-s-thread]');
		const sBall = $<SVGCircleElement>('[data-s-ball]');
		const sForce = $<SVGLineElement>('[data-s-force]');
		const sDim = $<SVGLineElement>('[data-s-dim]');
		const sX = $<SVGTextElement>('[data-s-x]');
		const sT = $<SVGTextElement>('[data-s-tlabel]');
		const sB = $<SVGTextElement>('[data-s-blabel]');
		const pSpring = $<SVGPathElement>('[data-p-spring]');
		const pWeight = $<SVGRectElement>('[data-p-weight]');
		const pW = $<SVGTextElement>('[data-p-wlabel]');
		const pForce = $<SVGLineElement>('[data-p-force]');
		const pDim = $<SVGLineElement>('[data-p-dim]');
		const pX = $<SVGTextElement>('[data-p-x]');

		// string pendulum: l = 140 px = 0,4667 m (300 px per metre)
		const L = 140;
		const TS = 2 * Math.PI * Math.sqrt(L / 300 / 9.8);
		const TH0 = (15 * Math.PI) / 180;
		// spring pendulum
		const TP = 0.9;
		const AP = 30; // px
		const EQ = 150; // centre of the weight at the position of equilibrium
		const springPath = (bottom: number) => {
			const top = 40;
			const n = 12;
			const lead = 6;
			const h = (bottom - top - 2 * lead) / n;
			let d = `M120 ${top} L120 ${top + lead}`;
			for (let i = 0; i < n; i++) d += ` L${i % 2 ? 112 : 128} ${(top + lead + (i + 0.5) * h).toFixed(1)}`;
			return `${d} L120 ${bottom - lead} L120 ${bottom}`;
		};

		let t = 0;
		const draw = () => {
			// ball on the thread
			const th = TH0 * Math.cos((2 * Math.PI * t) / TS);
			const s = Math.sin(th);
			const c = Math.cos(th);
			const bx = 160 + L * s;
			const by = 40 + L * c;
			set(sThread, { x2: bx, y2: by });
			set(sBall, { cx: bx, cy: by });
			const side = s >= 0 ? 1 : -1;
			set(sT, { x: 160 + 0.5 * L * s - 10, y: 40 + 0.5 * L * c, 'text-anchor': 'end' });
			set(sB, { x: bx + side * 15, y: by + 5, 'text-anchor': side > 0 ? 'start' : 'end' });
			// the returning force along the path, towards the position of equilibrium: ∝ sin α
			const f = 150 * s; // px, signed
			const show = Math.abs(f) > 3;
			sForce.style.visibility = show ? 'visible' : 'hidden';
			if (show) set(sForce, { x1: bx - side * 11 * c, y1: by + side * 11 * s, x2: bx - side * 11 * c - f * c, y2: by + side * 11 * s + f * s });
			const dimShow = Math.abs(bx - 160) > 8;
			sDim.style.visibility = sX.style.visibility = dimShow ? 'visible' : 'hidden';
			set(sDim, { x1: 160, y1: 206, x2: bx, y2: 206 });
			set(sX, { x: (160 + bx) / 2, y: 200 });

			// weight on the spring: x down is positive
			const x = AP * Math.cos((2 * Math.PI * t) / TP);
			const wy = EQ + x;
			pSpring.setAttribute('d', springPath(wy - 13));
			set(pWeight, { y: wy - 13 });
			set(pW, { y: wy + 5 });
			const fp = -1.1 * x; // towards the position of equilibrium
			const pShow = Math.abs(fp) > 3;
			pForce.style.visibility = pShow ? 'visible' : 'hidden';
			if (pShow) set(pForce, { x1: 146, y1: wy, x2: 146, y2: wy + fp });
			const pdShow = Math.abs(x) > 8;
			pDim.style.visibility = pX.style.visibility = pdShow ? 'visible' : 'hidden';
			set(pDim, { x1: 166, y1: EQ, x2: 166, y2: wy });
			set(pX, { x: 172, y: EQ + x / 2 + 6 });
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
