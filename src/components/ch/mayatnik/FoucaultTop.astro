---
/**
 * Foucault's pendulum seen from above, as in the Panthéon (l = 67 m): the bob swings over a round
 * floor; a stylus under it cuts marks in a ring of sand. Relative to the floor the swing plane turns
 * at 15.04°·sin φ per hour (the Earth turns once in 23 h 56 min relative to the stars).
 * Two views: from the hall (the floor is still, the plane turns) and from space (the plane is still,
 * the floor turns under it). Time can be sped up; a fast swing is drawn as a blur, as a camera would see it.
 */
const R_FLOOR = 200;
const R_SAND = 150;
const C = 220;
const ticks = Array.from({ length: 72 }, (_, i) => {
	const a = (i * 5 * Math.PI) / 180;
	const long = i % 6 === 0;
	const r1 = R_FLOOR - (long ? 16 : 9);
	const r2 = R_FLOOR - 3;
	return { x1: C + r1 * Math.cos(a), y1: C - r1 * Math.sin(a), x2: C + r2 * Math.cos(a), y2: C - r2 * Math.sin(a), long };
});
const compass = [
	{ t: 'С', a: 90 },
	{ t: 'В', a: 0 },
	{ t: 'Ю', a: 270 },
	{ t: 'З', a: 180 },
].map((c) => {
	const r = R_FLOOR - 32;
	const a = (c.a * Math.PI) / 180;
	return { ...c, x: C + r * Math.cos(a), y: C - r * Math.sin(a) + 6 };
});
const PLACES = [
	{ name: 'Северный полюс', lat: 90 },
	{ name: 'Санкт-Петербург', lat: 59.9 },
	{ name: 'Париж', lat: 48.8 },
	{ name: 'Экватор', lat: 0 },
	{ name: 'Южный полюс', lat: -90 },
];
const SPEEDS = [
	{ k: 1, label: 'как в жизни' },
	{ k: 60, label: '1 с = 1 мин' },
	{ k: 600, label: '1 с = 10 мин' },
	{ k: 3600, label: '1 с = 1 ч' },
];
const uid = `ft-${Math.random().toString(36).slice(2, 8)}`;
// A long exposure of a swinging bob: the bob spends more time near the ends of its path, where it is slow.
// Brightness ∝ time spent ∝ 1/√(1 − u²), u = x/A.
const blur = [-1, -0.98, -0.93, -0.85, -0.7, -0.45, 0, 0.45, 0.7, 0.85, 0.93, 0.98, 1].map((u) => ({
	o: ((u + 1) / 2).toFixed(3),
	a: Math.min(0.95, 0.16 / Math.sqrt(Math.max(1e-6, 1 - u * u))).toFixed(3),
}));
// Globe.
const GX = 130;
const GY = 150;
const GR = 100;
---

<figure class="ft not-content" data-ft>
	<div class="ft__places" role="group" aria-label="Где висит маятник">
		{
			PLACES.map((p, i) => (
				<button type="button" class="ft__chip" data-place={p.lat} aria-pressed={i === 2 ? 'true' : 'false'}>
					{p.name}
				</button>
			))
		}
	</div>

	<div class="ft__main">
		<svg class="ft__floor" viewBox="0 0 440 440" role="img" aria-label="Маятник Фуко, вид сверху: пол, кольцо песка и шар маятника">
			<defs>
				<radialGradient id={`${uid}-stone`} cx="50%" cy="50%" r="50%">
					<stop offset="0" class="ft__stop-floor-in" />
					<stop offset="1" class="ft__stop-floor-out" />
				</radialGradient>
				<linearGradient id={`${uid}-blur`} gradientUnits="userSpaceOnUse" x1={C - R_SAND} y1={C} x2={C + R_SAND} y2={C}>
					{blur.map((b) => <stop offset={b.o} stop-opacity={b.a} class="ft__stop-blur" />)}
				</linearGradient>
				<radialGradient id={`${uid}-bob`} cx="38%" cy="32%" r="70%">
					<stop offset="0" class="ft__stop-bob-hi" />
					<stop offset="0.5" class="ft__stop-bob" />
					<stop offset="1" class="ft__stop-bob-dark" />
				</radialGradient>
			</defs>

			<g data-floor>
				<circle class="ft__disc" cx={C} cy={C} r={R_FLOOR} fill={`url(#${uid}-stone)`} />
				{ticks.map((t) => <line class={t.long ? 'ft__tick ft__tick--long' : 'ft__tick'} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
				{
					compass.map((c) => (
						<text class="ft__compass" x={c.x} y={c.y} text-anchor="middle" data-cx={c.x} data-cy={c.y - 6}>
							{c.t}
						</text>
					))
				}
				<circle class="ft__sand" cx={C} cy={C} r={R_SAND} />
				<g data-hours></g>
				<path class="ft__groove" data-groove1 />
				<path class="ft__groove" data-groove2 />
			</g>

			<g data-plane>
				<line class="ft__planeline" x1={C - R_SAND - 10} y1={C} x2={C + R_SAND + 10} y2={C} />
				<line class="ft__streak" x1={C - R_SAND} y1={C} x2={C + R_SAND} y2={C} stroke={`url(#${uid}-blur)`} />
				<line class="ft__wire" x1={C} y1={C} x2={C + R_SAND} y2={C} data-wire />
				<circle class="ft__bob" r="14" cx={C + R_SAND} cy={C} fill={`url(#${uid}-bob)`} data-bob />
			</g>
			<circle class="ft__pivot" cx={C} cy={C} r="4" />
		</svg>

		<div class="ft__side">
			<svg class="ft__globe" viewBox="0 0 260 290" role="img" aria-label="Где на Земле висит маятник" data-globe>
				<circle class="ft__earth" cx={GX} cy={GY} r={GR} />
				<line class="ft__axis" x1={GX} y1={GY - GR - 22} x2={GX} y2={GY + GR + 22} />
				<line class="ft__equator" x1={GX - GR} y1={GY} x2={GX + GR} y2={GY} />
				<path class="ft__spin" d={`M ${GX - 26} ${GY - GR - 12} A 26 8 0 0 0 ${GX + 22} ${GY - GR - 8}`} />
				<path class="ft__spin-head" d={`M ${GX + 30} ${GY - GR - 10} l -11 -5 l 1 9 z`} />
				<text class="ft__gtext" x={GX + 10} y={GY - GR - 22}>С</text>
				<text class="ft__gtext" x={GX + 10} y={GY + GR + 30}>Ю</text>
				<line class="ft__parallel" data-parallel />
				<line class="ft__radius" x1={GX} y1={GY} x2={GX + GR} y2={GY} />
				<line class="ft__radius" x1={GX} y1={GY} data-gradius />
				<path class="ft__gangle" data-gangle />
				<text class="ft__gsym" data-gphi>φ</text>
				<circle class="ft__here" r="7" data-here />
			</svg>
			<p class="ft__where" data-where></p>
			<dl class="ft__stats">
				<div><dt>Прошло времени</dt><dd data-time>0 с</dd></div>
				<div><dt>Поворот плоскости</dt><dd data-turn>0°</dd></div>
				<div><dt>Полный оборот</dt><dd data-full>—</dd></div>
			</dl>
		</div>
	</div>

	<div class="ft__f" data-f></div>

	<div class="ft__controls">
		<label class="ft__slider">
			<span>Широта <i>φ</i></span>
			<output data-lat-out></output>
			<input type="range" min="-90" max="90" step="0.1" value="48.8" data-lat />
		</label>
		<div class="ft__row">
			<span class="ft__row-label">Скорость времени:</span>
			<div class="ft__seg" role="group" aria-label="Скорость времени">
				{
					SPEEDS.map((s, i) => (
						<button type="button" class="ft__seg-btn" data-speed={s.k} aria-pressed={i === 3 ? 'true' : 'false'}>
							{s.label}
						</button>
					))
				}
			</div>
		</div>
		<div class="ft__row">
			<span class="ft__row-label">Смотреть:</span>
			<div class="ft__seg" role="group" aria-label="Откуда смотреть">
				<button type="button" class="ft__seg-btn" data-view="hall" aria-pressed="true">из зала</button>
				<button type="button" class="ft__seg-btn" data-view="space" aria-pressed="false">из космоса</button>
			</div>
		</div>
		<div class="ft__row">
			<button type="button" class="ft__btn ft__btn--primary" data-run>Пуск</button>
			<button type="button" class="ft__btn" data-restart>Запустить заново</button>
		</div>
	</div>
	<p class="ft__status" aria-live="polite" data-status></p>

	<figcaption class="ft__legend">
		Вид сверху. Маятник длиной 67 м, как в Пантеоне, качается с периодом 16,4 с. Острие под шаром чертит след
		в кольце из песка; тонкие линии — положение плоскости качаний через каждый час. Относительно звёзд Земля делает
		оборот за 23 ч 56 мин ≈ 23,93 ч, то есть поворачивается на 15,04° в час. Вид «из космоса» показывает только поворот
		пола вокруг вертикали.
	</figcaption>
</figure>

