</style>

<script>
	import { periodString } from './physics';
	import { SVG_NS, animator, fmt, reduceMotion, tex, tnum } from './util';

	const C = 220;
	const R_SAND = 150;
	const AMP = 150; // swing amplitude on the floor, px
	const DEG = Math.PI / 180;
	const DAY = 23.9345; // sidereal day, h
	const OMEGA = 360 / DAY; // degrees per hour
	const T = periodString(67, 9.8); // s
	const PSI0 = 90; // released along the north–south line
	const GX = 130;
	const GY = 150;
	const GR = 100;
	const MAX_HOURS = 60;

	for (const root of document.querySelectorAll<HTMLElement>('[data-ft]')) {
		const q = <E extends Element>(sel: string) => root.querySelector<E>(sel)!;
		const compass = Array.from(root.querySelectorAll<SVGTextElement>('.ft__compass'));
		const el = {
			floor: q<SVGGElement>('[data-floor]'),
			plane: q<SVGGElement>('[data-plane]'),
			hours: q<SVGGElement>('[data-hours]'),
			groove1: q<SVGPathElement>('[data-groove1]'),
			groove2: q<SVGPathElement>('[data-groove2]'),
			bob: q<SVGCircleElement>('[data-bob]'),
			wire: q<SVGLineElement>('[data-wire]'),
			parallel: q<SVGLineElement>('[data-parallel]'),
			gradius: q<SVGLineElement>('[data-gradius]'),
			gangle: q<SVGPathElement>('[data-gangle]'),
			gphi: q<SVGTextElement>('[data-gphi]'),
			here: q<SVGCircleElement>('[data-here]'),
			where: q<HTMLElement>('[data-where]'),
			time: q<HTMLElement>('[data-time]'),
			turn: q<HTMLElement>('[data-turn]'),
			full: q<HTMLElement>('[data-full]'),
			f: q<HTMLElement>('[data-f]'),
			lat: q<HTMLInputElement>('[data-lat]'),
			latOut: q<HTMLOutputElement>('[data-lat-out]'),
			run: q<HTMLButtonElement>('[data-run]'),
			restart: q<HTMLButtonElement>('[data-restart]'),
			status: q<HTMLElement>('[data-status]'),
			places: Array.from(root.querySelectorAll<HTMLButtonElement>('[data-place]')),
			speeds: Array.from(root.querySelectorAll<HTMLButtonElement>('[data-speed]')),
			views: Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]')),
		};

		// ---- State ----------------------------------------------------------------------------------
		let lat = Number(el.lat.value); // degrees, north is +
		let speed = 3600; // model seconds per screen second
		let t = 0; // model time since release, s
		let psi = PSI0; // swing direction relative to the floor, degrees counter-clockwise from east
		let nextHour = 3600;
		let running = false;
		let view: 'hall' | 'space' = 'hall';
		let blend = 0; // 0 — from the hall, 1 — from space (tweened)
		let tween = 0;

		const rate = () => OMEGA * Math.sin(lat * DEG); // degrees per hour, + means clockwise seen from above
		const sinLat = () => Math.sin(Math.abs(lat) * DEG);
		const still = () => Math.abs(lat) < 0.05;

		// ---- Formatting -----------------------------------------------------------------------------
		const latText = (v: number) =>
			Math.abs(v) < 0.05 ? '0°' : `${fmt(Math.abs(v), Number.isInteger(v) ? 0 : 1)}° ${v > 0 ? 'с. ш.' : 'ю. ш.'}`;
		const duration = (s: number) => {
			const total = Math.floor(s);
			const h = Math.floor(total / 3600);
			const m = Math.floor((total % 3600) / 60);
			const sec = total % 60;
			if (h > 0) return `${h} ч ${String(m).padStart(2, '0')} мин`;
			if (m > 0) return `${m} мин ${String(sec).padStart(2, '0')} с`;
			return `${sec} с`;
		};

		// ---- Drawing --------------------------------------------------------------------------------
		const set = (node: Element, attrs: Record<string, number | string>) => {
			for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, typeof v === 'number' ? v.toFixed(2) : v);
		};
		// A point on the floor at angle a (degrees, counter-clockwise from east) and radius r.
		const pt = (a: number, r: number) => [C + r * Math.cos(a * DEG), C - r * Math.sin(a * DEG)];
		const arc = (from: number, to: number) => {
			const sweep = to - from;
			if (Math.abs(sweep) < 0.05) return '';
			const [x1, y1] = pt(from, R_SAND);
			const [x2, y2] = pt(to, R_SAND);
			// SVG y runs down, so a counter-clockwise turn on the page is sweep-flag 0.
			return `M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${R_SAND} ${R_SAND} 0 0 ${sweep > 0 ? 0 : 1} ${x2.toFixed(2)} ${y2.toFixed(2)}`;
		};

		const drawGrooves = () => {
			const turned = psi - PSI0;
			if (Math.abs(turned) >= 180) {
				// Both ends of the swing have drawn half a ring each: the ring is complete.
				const full = `M ${C + R_SAND} ${C} A ${R_SAND} ${R_SAND} 0 1 0 ${C - R_SAND} ${C} A ${R_SAND} ${R_SAND} 0 1 0 ${C + R_SAND} ${C}`;
				el.groove1.setAttribute('d', full);
				el.groove2.setAttribute('d', '');
				return;
			}
			el.groove1.setAttribute('d', arc(PSI0, psi));
			el.groove2.setAttribute('d', arc(PSI0 + 180, psi + 180));
		};

		const addHourLine = () => {
			const line = document.createElementNS(SVG_NS, 'line');
			line.setAttribute('class', 'ft__hour');
			const [x1, y1] = pt(psi, R_SAND + 9);
			const [x2, y2] = pt(psi + 180, R_SAND + 9);
			set(line, { x1, y1, x2, y2 });
			el.hours.appendChild(line);
			while (el.hours.children.length > MAX_HOURS) el.hours.firstElementChild!.remove();
		};

		const drawScene = () => {
			// From space the swing plane keeps its direction PSI0 and the floor turns under it.
			const floorRot = blend * (PSI0 - psi);
			el.floor.setAttribute('transform', `rotate(${(-floorRot).toFixed(3)} ${C} ${C})`);
			// The letters ride on the floor but stay upright, so they can be read.
			for (const c of compass) c.setAttribute('transform', `rotate(${floorRot.toFixed(3)} ${c.dataset.cx} ${c.dataset.cy})`);
			el.plane.setAttribute('transform', `rotate(${(-(psi + floorRot)).toFixed(3)} ${C} ${C})`);
			const s = AMP * Math.cos((2 * Math.PI * t) / T);
			set(el.bob, { cx: C + s, cy: C });
			set(el.wire, { x2: C + s, y2: C });
			root.classList.toggle('is-blur', T / speed < 0.5 && running);
			drawGrooves();
		};

		const drawNumbers = () => {
			el.time.textContent = duration(t);
			const turned = Math.abs(psi - PSI0);
			const dir = psi < PSI0 ? 'по часовой' : 'против часовой';
			el.turn.textContent = turned < 0.05 ? '0°' : `${fmt(turned, 1)}° ${dir}`;
		};

		const drawGlobe = () => {
			const a = lat * DEG;
			const x = GX + GR * Math.cos(a);
			const y = GY - GR * Math.sin(a);
			set(el.here, { cx: x, cy: y });
			set(el.gradius, { x2: x, y2: y });
			set(el.parallel, { x1: GX - GR * Math.cos(a), y1: y, x2: x, y2: y });
			el.parallel.style.visibility = Math.abs(lat) > 1 && Math.abs(lat) < 89 ? 'visible' : 'hidden';
			const r = 34;
			const show = Math.abs(lat) >= 8;
			el.gangle.style.visibility = show ? 'visible' : 'hidden';
			el.gphi.style.visibility = show ? 'visible' : 'hidden';
			if (show) {
				const [ax, ay] = [GX + r * Math.cos(a), GY - r * Math.sin(a)];
				el.gangle.setAttribute('d', `M ${GX + r} ${GY} A ${r} ${r} 0 0 ${lat > 0 ? 0 : 1} ${ax.toFixed(2)} ${ay.toFixed(2)}`);
				set(el.gphi, { x: GX + (r + 10) * Math.cos(a / 2), y: GY - (r + 10) * Math.sin(a / 2) + 7 });
			}
		};

		const drawFormula = () => {
			const s = sinLat();
			const per = OMEGA * s;
			const phi = `${tnum(Math.abs(lat), Number.isInteger(lat) ? 0 : 1)}^\\circ`;
			tex(
				el.f,
				`\\text{за 1 ч:}\\quad 15{,}04^\\circ\\cdot\\sin\\varphi = 15{,}04^\\circ\\cdot\\sin ${phi} \\approx 15{,}04^\\circ\\cdot ${tnum(s, 3)} \\approx ${tnum(per, 1)}^\\circ`,
			);
			el.full.textContent = still() ? 'не поворачивается' : `за ${fmt(DAY / s, 1)} ч`;
			el.latOut.textContent = latText(lat);
			const place = el.places.find((b) => Math.abs(Number(b.dataset.place) - lat) < 0.05);
			el.places.forEach((b) => b.setAttribute('aria-pressed', String(b === place)));
			el.where.textContent = place ? `${place.textContent!.trim()} · ${latText(lat)}` : latText(lat);
		};

		const drawStatus = () => {
			let msg: string;
			const north = lat > 0;
			if (still()) {
				msg = 'На экваторе пол не поворачивается вокруг вертикали, и плоскость качаний относительно пола остаётся прежней.';
			} else if (speed === 1) {
				const perSwing = (Math.abs(rate()) * T) / 3600;
				msg = `В реальном времени поворот не заметен: за одно качание (${fmt(T, 1)} с) плоскость поворачивается всего на ${fmt(perSwing, 2)}°. Ускорьте время.`;
			} else if (view === 'hall') {
				msg = `Зрители в зале видят: плоскость качаний медленно поворачивается ${north ? 'по часовой стрелке' : 'против часовой стрелки'}.`;
			} else {
				msg = `Из космоса видно: маятник качается всё в той же плоскости, а пол поворачивается под ним ${north ? 'против часовой стрелки' : 'по часовой стрелке'}.`;
			}
			if (el.status.textContent !== msg) el.status.textContent = msg;
		};

		const drawAll = () => {
			drawScene();
			drawNumbers();
		};

		// ---- Loop -----------------------------------------------------------------------------------
		const wake = animator(
			root,
			() => running,
			(dt) => {
				const h = dt * speed;
				t += h;
				psi -= (rate() * h) / 3600;
				while (t >= nextHour) {
					addHourLine();
					nextHour += 3600;
				}
				drawAll();
			},
		);
		const setRunning = (on: boolean) => {
			running = on;
			el.run.textContent = on ? 'Пауза' : 'Пуск';
			drawScene();
			wake();
		};

		const tweenView = () => {
			cancelAnimationFrame(tween);
			const target = view === 'space' ? 1 : 0;
			if (reduceMotion()) {
				blend = target;
				drawScene();
				return;
			}
			const from = blend;
			const start = performance.now();
			const stepTween = (now: number) => {
				const k = Math.min(1, (now - start) / 700);
				blend = from + (target - from) * (k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2);
				drawScene();
				if (k < 1) tween = requestAnimationFrame(stepTween);
			};
			tween = requestAnimationFrame(stepTween);
		};

		// ---- Controls -------------------------------------------------------------------------------
		// Back to the moment of release: no time, no turn, only the first hour line.
		const reset = () => {
			t = 0;
			psi = PSI0;
			nextHour = 3600;
			el.hours.replaceChildren();
			addHourLine();
			drawAll();
		};
		// A new place is a new experiment: the old turn and hour lines belong to the old place.
		const moveTo = (v: number) => {
			setLat(v);
			reset();
		};
		const setLat = (v: number) => {
			lat = Math.max(-90, Math.min(90, Math.round(v * 10) / 10));
			el.lat.value = String(lat);
			drawGlobe();
			drawFormula();
			drawStatus();
		};
		el.lat.addEventListener('input', () => moveTo(Number(el.lat.value)));
		el.places.forEach((b) => b.addEventListener('click', () => moveTo(Number(b.dataset.place))));
		el.speeds.forEach((b) =>
			b.addEventListener('click', () => {
				speed = Number(b.dataset.speed);
				el.speeds.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				drawStatus();
				drawScene();
				if (!running) setRunning(true);
			}),
		);
		el.views.forEach((b) =>
			b.addEventListener('click', () => {
				view = b.dataset.view as 'hall' | 'space';
				el.views.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				drawStatus();
				tweenView();
			}),
		);
		el.run.addEventListener('click', () => setRunning(!running));
		el.restart.addEventListener('click', () => {
			reset();
			setRunning(true);
		});

		// ---- Start ----------------------------------------------------------------------------------
		setLat(lat);
		reset();
		setRunning(!reduceMotion());
	}
</script>
