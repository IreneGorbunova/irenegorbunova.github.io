	}

	@media (max-width: 40rem) {
		.ft {
			padding: 0.75rem;
		}
		.ft__main {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
		.ft__side {
			grid-template-columns: 7rem 1fr;
			align-items: start;
		}
		.ft__globe {
			grid-row: 1 / 3;
			align-self: center;
		}
		.ft__stats > div {
			display: block;
		}
