---
/**
 * Picture to the definition of damped oscillations: the graph x(t) = A₀·e^(−βt)·cos(2πt/T) with its envelope
 * ±A₀·e^(−βt) (dashed). One period is 60 px of the time axis; in five periods the amplitude falls to 15 %.
 * Two periods, at the start and later, are marked: they are equal, only the amplitude shrinks.
 */
import PicStyles from './PicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mD = `mpd-d-${uid}`;
const mAx = `mpd-a-${uid}`;
const X0 = 40;
const MID = 96;
const A0 = 62;
const TP = 60;
const BETA = -Math.log(0.15) / (5 * TP);
const N = 330;
const f = (v: number) => v.toFixed(1);
const curve = Array.from({ length: N + 1 }, (_, i) => {
	const u = i;
	return `${i ? 'L' : 'M'}${f(X0 + u)} ${f(MID - A0 * Math.exp(-BETA * u) * Math.cos((2 * Math.PI * u) / TP))}`;
}).join(' ');
const env = (sgn: number) =>
	Array.from({ length: N / 6 + 1 }, (_, i) => {
		const u = i * 6;
		return `${i ? 'L' : 'M'}${f(X0 + u)} ${f(MID - sgn * A0 * Math.exp(-BETA * u))}`;
	}).join(' ');
const crest = (k: number) => MID - A0 * Math.exp(-BETA * k * TP);
---

<PicStyles />
<figure class="mp-pic mp-pic--one not-content">
	<div class="mp-pic__grid">
		<svg class="mp-pic__svg" viewBox="0 0 380 190" role="img" aria-label="График затухающих колебаний: размах уменьшается, а период остаётся прежним">
			<defs>
				<marker id={mD} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
					<path class="mp-head-dim" d="M0 1 L10 5 L0 9 z"></path>
				</marker>
				<marker id={mAx} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
					<path class="mpd-axhead" d="M0 1 L10 5 L0 9 z"></path>
				</marker>
			</defs>
			<line class="mpd-axis" x1={X0} y1={MID} x2="372" y2={MID} marker-end={`url(#${mAx})`}></line>
			<line class="mpd-axis" x1={X0} y1="180" x2={X0} y2="14" marker-end={`url(#${mAx})`}></line>
			<text class="mp-sym" x="364" y={MID + 20}>t</text>
			<text class="mp-sym" x={X0 - 18} y="24">x</text>
			<path class="mpd-env" d={env(1)}></path>
			<path class="mpd-env" d={env(-1)}></path>
			<path class="mpd-curve" d={curve}></path>
			<line class="mp-dim" x1={X0} x2={X0 + TP} y1="22" y2="22" marker-start={`url(#${mD})`} marker-end={`url(#${mD})`}></line>
			<line class="mpd-tick" x1={X0 + TP} x2={X0 + TP} y1="16" y2={crest(1)}></line>
			<text class="mp-sym" x={X0 + TP / 2} y="16" text-anchor="middle">T</text>
			<line class="mp-dim" x1={X0 + 3 * TP} x2={X0 + 4 * TP} y1="22" y2="22" marker-start={`url(#${mD})`} marker-end={`url(#${mD})`}></line>
			<line class="mpd-tick" x1={X0 + 3 * TP} x2={X0 + 3 * TP} y1="16" y2={crest(3)}></line>
			<line class="mpd-tick" x1={X0 + 4 * TP} x2={X0 + 4 * TP} y1="16" y2={crest(4)}></line>
			<text class="mp-sym" x={X0 + 3.5 * TP} y="16" text-anchor="middle">T</text>
			<text x="250" y="176" text-anchor="middle">размах уменьшается</text>
		</svg>
	</div>
	<div class="mp-pic__foot">
		<figcaption>
			Затухающие колебания: размах становится всё меньше, а период почти не меняется. Пунктир показывает, как
			уменьшается амплитуда.
		</figcaption>
	</div>
</figure>

<style is:global>
	.mpd-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.mpd-axhead {
		fill: var(--sl-color-gray-3);
	}
	.mpd-env {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 4;
	}
	.mpd-curve {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2.6;
		stroke-linejoin: round;
	}
	.mpd-tick {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
</style>
