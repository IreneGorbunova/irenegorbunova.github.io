---
/**
 * «Плечо силы»: a door seen from above, 90 см wide, turning about its hinges (the axis, at the left). A force F
 * (0…40 Н) is applied at a distance r (10…90 см) from the axis at an angle β (0…180°) to the door. The line of action
 * of the force is drawn dashed through its point of application; the arm d = r·sin β is the perpendicular from the
 * axis to that line (gold). The moment M = F·d is computed; it turns the door counterclockwise (seen from above),
 * which is taken as positive. With β = 0 or 180° the force passes through the axis and does not turn the door.
 *
 * Scales: the door 250 px per metre; the force 2 px per newton. The force can also be set by dragging its end.
 * Colors: the hand's force F is teal, its own color in the chapter (red is the boy's weight P in PlankLab, blue the
 * force of gravity, green the tension, violet the forces of the supports).
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
---

<G7Styles />
<figure class="g7 g7--stack dor not-content" data-dor>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 240" role="img" aria-label="Дверь, вид сверху. К ней приложена сила; показаны линия действия силы и её плечо" data-svg>
			<defs>
				<marker id={`dor-r-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto"><path class="dor__fhead" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`dor-k-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path class="head--ink" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="dor__wall" x="0" y="103" width="40" height="14"></rect>
			<rect class="dor__wall" x="284" y="103" width="116" height="14"></rect>
			<text class="t-small" x="392" y="134" text-anchor="end">стена, вид сверху</text>
			<line class="ln-dash" data-act></line>
			<line class="dor__arm" data-arm></line>
			<path class="dor__right" data-right></path>
			<rect class="dor__door" x="46" y="105" width="225" height="10" rx="2"></rect>
			<circle class="dor__axis" cx="46" cy="110" r="6"></circle>
			<text class="t-small" x="40" y="97" text-anchor="middle">ось</text>
			<path class="dor__turn" data-turn marker-end={`url(#dor-k-${uid})`}></path>
			<line class="arrow dor__f" data-arrow marker-end={`url(#dor-r-${uid})`}></line>
			<circle class="dor__grip drag" data-grip r="11"></circle>
			<text class="t-i dor__ft t-halo" data-fl>F</text>
			<text class="t-i t-gold t-halo" data-dl>d</text>
			<path class="dor__r" data-rb></path>
			<text class="t-i t-halo" data-rl>r</text>
			<text class="t-strong t-num" x="392" y="22" text-anchor="end" data-m style="font-size:15px"></text>
		</svg>
		<div class="g7__side dor__side">
			<label class="g7__slider">
				<span>Сила <i>F</i></span>
				<output data-of></output>
				<input type="range" min="0" max="40" step="2" value="20" data-f aria-label="Сила, ньютоны" />
			</label>
			<label class="g7__slider">
				<span>Точка приложения <i>r</i></span>
				<output data-or></output>
				<input type="range" min="10" max="90" step="5" value="80" data-r aria-label="Расстояние от оси до точки приложения силы, сантиметры" />
			</label>
			<label class="g7__slider">
				<span>Угол <i>β</i></span>
				<output data-ob></output>
				<input type="range" min="0" max="180" step="5" value="90" data-b aria-label="Угол между силой и дверью, градусы" />
			</label>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Дверь — 250&nbsp;px на метр, сила — 2&nbsp;px на ньютон. Конец бирюзовой стрелки можно тянуть. Пунктир — линия действия силы, золотой отрезок — плечо силы.
	</figcaption>
</figure>

<style is:global>
	.dor__side {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: end;
	}
	.dor__side .g7__lines {
		grid-column: 1 / -1;
	}
	@container (max-width: 36rem) {
		.dor__side {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.g7__svg .dor__wall {
		fill: var(--g7-line);
	}
	.g7__svg .dor__door {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
	}
	.g7__svg .dor__axis {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.g7__svg .dor__arm {
		stroke: var(--g7-gold);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.g7__svg .dor__right,
	.g7__svg .dor__r {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .dor__turn {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.dor {
		--dor-f: hsl(178, 62%, 52%);
	}
	:root[data-theme='light'] .dor {
		--dor-f: hsl(178, 85%, 27%);
	}
	.g7__svg .dor__f {
		stroke: var(--dor-f);
	}
	.g7__svg .dor__fhead,
	.g7__svg .dor__ft {
		fill: var(--dor-f);
	}
	.g7__svg .dor__grip {
		fill: transparent;
		stroke: var(--dor-f);
		stroke-width: 1;
		stroke-dasharray: 2 2;
	}
</style>

<script>
	import { fmt, fmtTrim, k, svgPoint, tex } from '../g7/kit';

	const AX = 46;
	const AY = 110;
	const PXM = 250;
	const KF = 2;
	for (const root of document.querySelectorAll<HTMLElement>('[data-dor]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const fIn = q<HTMLInputElement>('[data-f]');
		const rIn = q<HTMLInputElement>('[data-r]');
		const bIn = q<HTMLInputElement>('[data-b]');
		const set = (e: Element, a: Record<string, number>) => {
			for (const [n, v] of Object.entries(a)) e.setAttribute(n, v.toFixed(1));
		};
		const draw = () => {
			const F = Number(fIn.value);
			const rc = Number(rIn.value);
			const b = Number(bIn.value);
			const br = (b * Math.PI) / 180;
			q('[data-of]').textContent = `${F} Н`;
			q('[data-or]').textContent = `${rc} см`;
			q('[data-ob]').textContent = `${b}°`;
			const px = AX + (rc / 100) * PXM;
			const py = AY;
			const ux = Math.cos(br);
			const uy = -Math.sin(br);
			const L = KF * F;
			const sh = Math.max(0, L - 7);
			set(q('[data-arrow]'), { x1: px, y1: py, x2: px + ux * sh, y2: py + uy * sh });
			q('[data-arrow]').style.visibility = q('[data-fl]').style.visibility = F > 0 ? 'visible' : 'hidden';
			set(q('[data-grip]'), { cx: px + ux * L, cy: py + uy * L });
			set(q('[data-fl]'), { x: px + ux * L + 6, y: py + uy * L - 2 });
			// the line of action, long both ways
			set(q('[data-act]'), { x1: px - ux * 500, y1: py - uy * 500, x2: px + ux * 500, y2: py + uy * 500 });
			// the foot of the perpendicular from the axis
			const t = (AX - px) * ux + (AY - py) * uy;
			const fx = px + ux * t;
			const fy = py + uy * t;
			const d = (rc / 100) * Math.sin(br); // м
			set(q('[data-arm]'), { x1: AX, y1: AY, x2: fx, y2: fy });
			q('[data-arm]').style.visibility = q('[data-dl]').style.visibility = d > 0.005 ? 'visible' : 'hidden';
			set(q('[data-dl]'), { x: (AX + fx) / 2 - 12, y: (AY + fy) / 2 - 4 });
			// the right angle at the foot
			const nx = (AX - fx) / (Math.hypot(AX - fx, AY - fy) || 1);
			const ny = (AY - fy) / (Math.hypot(AX - fx, AY - fy) || 1);
			const sq = 7;
			q('[data-right]').setAttribute('d', d > 0.03 ? `M${(fx + nx * sq).toFixed(1)} ${(fy + ny * sq).toFixed(1)} l${(ux * sq).toFixed(1)} ${(uy * sq).toFixed(1)} l${(-nx * sq).toFixed(1)} ${(-ny * sq).toFixed(1)}` : '');
			// r: a bracket under the door
			q('[data-rb]').setAttribute('d', `M${AX} 121 V127 H${px.toFixed(1)} V121`);
			set(q('[data-rl]'), { x: (AX + px) / 2 - 3, y: 139 });
			const M = F * d;
			q('[data-m]').textContent = `M = ${fmt(M, 1)} Н·м`;
			// a turning arrow round the axis when the moment is not zero
			q('[data-turn]').setAttribute('d', M > 0.05 ? `M${AX + 26} ${AY - 6} A26 26 0 0 0 ${AX + 4} ${AY - 26}` : '');
			const sinb = fmtTrim(Math.sin(br), 2);
			q('[data-lines]').innerHTML = [
				k(`d = r\\sin\\beta = ${tex(fmtTrim(rc / 100, 2))}\\cdot\\sin ${b}^\\circ \\approx ${tex(fmtTrim(d, 2))}~\\text{м}`),
				k(`M = Fd \\approx ${F}\\cdot ${tex(fmtTrim(d, 2))} \\approx ${tex(fmt(M, 1))}~\\text{Н}\\cdot\\text{м}`),
			]
				.map((h, i) => `<li${i === 1 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
			void sinb;
		};
		for (const inp of [fIn, rIn, bIn]) inp.addEventListener('input', draw);
		const grip = q<SVGCircleElement>('[data-grip]');
		let on = false;
		grip.addEventListener('pointerdown', (e) => {
			on = true;
			grip.setPointerCapture(e.pointerId);
			e.preventDefault();
		});
		grip.addEventListener('pointermove', (e) => {
			if (!on) return;
			const p = svgPoint(svg, e);
			const px = AX + (Number(rIn.value) / 100) * PXM;
			const dx = p.x - px;
			const dy = Math.max(0, AY - p.y);
			fIn.value = String(Math.min(40, Math.round(Math.hypot(dx, dy) / KF / 2) * 2));
			bIn.value = String(Math.min(180, Math.max(0, Math.round((Math.atan2(dy, dx) * 180) / Math.PI / 5) * 5)));
			draw();
		});
		const off = () => (on = false);
		grip.addEventListener('pointerup', off);
		grip.addEventListener('pointercancel', off);
		draw();
	}
</script>
