---
/**
 * «Две силы и дверь»: a door seen from above, 90 см wide, turning about its hinges (the axis, at the left). Two forces
 * of hands act on it (teal, the force of a hand in this chapter):
 *   F⃗₁ (0…40 Н) at a distance r₁ (10…90 см) from the axis at an angle β (0…180°) to the door; its arm d₁ = r₁·sin β is
 *     the perpendicular from the axis to its line of action (dashed); it turns the door counterclockwise (seen from
 *     above), so its moment M₁ = +F₁d₁;
 *   F⃗₂ (0…40 Н) at a distance r₂ (10…90 см), always at right angles to the door, from the other side: its arm d₂ = r₂,
 *     it turns the door clockwise, M₂ = −F₂d₂.
 * The arms are gold. The door is held still in the picture; the large curved arrow at the hinge shows where the sum
 * of the moments M₁ + M₂ would turn it (counterclockwise or clockwise); when |M₁ + M₂| < 0,05 Н·м the arrow goes and
 * the door is in equilibrium. Defaults F₁ = 20 Н, r₁ = 80 см, β = 90°, F₂ = 20 Н, r₂ = 40 см: M₁ = 16 Н·м,
 * M₂ = −8 Н·м, the door turns counterclockwise; r₂ = 80 см or F₂ = 40 Н balance it; β = 30° halves d₁ (0,4 м).
 *
 * Scales: the door 250 px per metre; the forces 2 px per newton. The end of F⃗₁ can also be dragged.
 */
import RtStyles from './RtStyles.astro';
---

<RtStyles />
<figure class="g7 g7--stack dor not-content" data-dor>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 226" role="img" aria-label="Дверь, вид сверху. К ней приложены две силы, поворачивающие её в разные стороны; показаны линии действия сил и их плечи" data-svg>
			<rect class="dor__wall" x="0" y="103" width="40" height="14"></rect>
			<rect class="dor__wall" x="284" y="103" width="116" height="14"></rect>
			<text class="rt-lab" x="392" y="134" text-anchor="end" data-lwall>стена, вид сверху</text>
			<path class="rt-dash rt-s--f" data-act1 opacity="0.7"></path>
			<path class="rt-dash rt-s--f" data-act2 opacity="0.7"></path>
			<rect class="dor__door" x="46" y="105" width="225" height="10" rx="2"></rect>
			<path class="rt-arm" data-arm1></path>
			<path class="dor__right" data-right></path>
			<path class="rt-arm" data-arm2></path>
			<path class="dor__tick" data-tick2></path>
			<circle class="dor__axis" cx="46" cy="110" r="6"></circle>
			<text class="rt-lab" x="22" y="97" text-anchor="middle" data-lax>ось</text>
			<path class="dor__turn" data-turn></path>
			<path class="rt-f--ink" data-turnh></path>
			<path class="rt-f--f" data-f1></path>
			<path class="rt-f--f" data-f2></path>
			<circle class="dor__grip drag" data-grip r="11"></circle>
			<text class="rt-sym rt-t--f" data-rtv="0" data-lf1>F<tspan class="rt-sub" dy="4">1</tspan></text>
			<text class="rt-sym rt-t--f" data-rtv="0" data-lf2>F<tspan class="rt-sub" dy="4">2</tspan></text>
			<text class="rt-sym rt-t--d" data-ld1>d<tspan class="rt-sub" dy="4">1</tspan></text>
			<text class="rt-sym rt-t--d" data-ld2>d<tspan class="rt-sub" dy="4">2</tspan></text>
		</svg>
		<div class="g7__side dor__side">
			<label class="g7__slider">
				<span>Сила <i>F</i><sub>1</sub></span>
				<output data-of1></output>
				<input type="range" min="0" max="40" step="2" value="20" data-f1in aria-label="Первая сила, ньютоны" />
			</label>
			<label class="g7__slider">
				<span>Точка приложения <i>r</i><sub>1</sub></span>
				<output data-or1></output>
				<input type="range" min="10" max="90" step="5" value="80" data-r1in aria-label="Расстояние от оси до точки приложения первой силы, сантиметры" />
			</label>
			<label class="g7__slider">
				<span>Угол <i>β</i></span>
				<output data-ob></output>
				<input type="range" min="0" max="180" step="5" value="90" data-bin aria-label="Угол между первой силой и дверью, градусы" />
			</label>
			<label class="g7__slider">
				<span>Сила <i>F</i><sub>2</sub></span>
				<output data-of2></output>
				<input type="range" min="0" max="40" step="2" value="20" data-f2in aria-label="Вторая сила, ньютоны" />
			</label>
			<label class="g7__slider">
				<span>Точка приложения <i>r</i><sub>2</sub></span>
				<output data-or2></output>
				<input type="range" min="10" max="90" step="5" value="40" data-r2in aria-label="Расстояние от оси до точки приложения второй силы, сантиметры" />
			</label>
			<p class="g7__msg" data-state aria-live="polite"></p>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Дверь — 250&nbsp;px на метр, силы — 2&nbsp;px на ньютон. Дверь удерживают на месте; изогнутая стрелка у петель показывает, куда она повернулась бы. Пунктир — линии действия сил, золотые отрезки — плечи. Конец стрелки <i>F</i><sub>1</sub> можно тянуть.
	</figcaption>
</figure>

<style is:global>
	.dor__side {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: end;
	}
	.dor__side .g7__lines,
	.dor__side .g7__msg {
		grid-column: 1 / -1;
	}
	@container (max-width: 36rem) {
		.dor__side {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
	.g7__svg .dor__wall {
		fill: var(--g7-line);
	}
	.g7__svg .dor__door {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
	}
	.g7__svg .dor__axis {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.g7__svg .dor__right {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .dor__tick {
		fill: none;
		stroke: var(--rt-d);
		stroke-width: 1.2;
	}
	.g7__svg .dor__turn {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.2;
	}
	.g7__svg .dor__grip {
		fill: transparent;
		stroke: var(--rt-f);
		stroke-width: 1;
		stroke-dasharray: 2 2;
	}
</style>

<script>
	import { fmt, fmtTrim, k, svgPoint, tex } from '../g7/kit';
	import { arrowPath, place, along, ring, rings, segOf, type Seg, type Box, type Cand } from './rt';

	const AX = 46;
	const AY = 110;
	const PXM = 250;
	const KF = 2;
	const VIEW: Box = { x0: 2, y0: 2, x1: 398, y1: 224 };
	for (const root of document.querySelectorAll<HTMLElement>('[data-dor]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const f1In = q<HTMLInputElement>('[data-f1in]');
		const r1In = q<HTMLInputElement>('[data-r1in]');
		const bIn = q<HTMLInputElement>('[data-bin]');
		const f2In = q<HTMLInputElement>('[data-f2in]');
		const r2In = q<HTMLInputElement>('[data-r2in]');
		const show = (e: Element, on: boolean) => ((e as SVGElement).style.visibility = on ? 'visible' : 'hidden');
		const draw = () => {
			const F1 = Number(f1In.value);
			const r1 = Number(r1In.value) / 100;
			const b = Number(bIn.value);
			const F2 = Number(f2In.value);
			const r2 = Number(r2In.value) / 100;
			const br = (b * Math.PI) / 180;
			q('[data-of1]').textContent = `${F1} Н`;
			q('[data-or1]').textContent = `${Math.round(r1 * 100)} см`;
			q('[data-ob]').textContent = `${b}°`;
			q('[data-of2]').textContent = `${F2} Н`;
			q('[data-or2]').textContent = `${Math.round(r2 * 100)} см`;
			const segs: Seg[] = [segOf(46, 110, 271, 110, 6), segOf(0, 110, 40, 110, 8), segOf(284, 110, 400, 110, 8)];
			const boxes: Box[] = [
				{ x0: 36, y0: 100, x1: 56, y1: 120 },
			];
			// F₁
			const p1 = { x: AX + r1 * PXM, y: AY };
			const ux = Math.cos(br);
			const uy = -Math.sin(br);
			const L1 = KF * F1;
			const e1 = { x: p1.x + ux * L1, y: p1.y + uy * L1 };
			q('[data-f1]').setAttribute('d', arrowPath(p1.x, p1.y, e1.x, e1.y, 3, 9));
			q('[data-grip]').setAttribute('cx', e1.x.toFixed(1));
			q('[data-grip]').setAttribute('cy', e1.y.toFixed(1));
			const far = 600;
			q('[data-act1]').setAttribute('d', F1 > 0 ? `M${(p1.x - ux * far).toFixed(1)} ${(p1.y - uy * far).toFixed(1)} L${(p1.x + ux * far).toFixed(1)} ${(p1.y + uy * far).toFixed(1)}` : '');
			// the foot of the perpendicular from the axis to the line of action of F₁
			const t = (AX - p1.x) * ux + (AY - p1.y) * uy;
			const fx = p1.x + ux * t;
			const fy = p1.y + uy * t;
			const d1 = r1 * Math.sin(br);
			const armOn = d1 > 0.005 && F1 > 0;
			q('[data-arm1]').setAttribute('d', armOn ? `M${AX} ${AY} L${fx.toFixed(1)} ${fy.toFixed(1)}` : '');
			const nl = Math.hypot(AX - fx, AY - fy) || 1;
			const nx = (AX - fx) / nl;
			const ny = (AY - fy) / nl;
			const sq = 7;
			q('[data-right]').setAttribute('d', armOn && d1 > 0.03 ? `M${(fx + nx * sq).toFixed(1)} ${(fy + ny * sq).toFixed(1)} l${(ux * sq).toFixed(1)} ${(uy * sq).toFixed(1)} l${(-nx * sq).toFixed(1)} ${(-ny * sq).toFixed(1)}` : '');
			// F₂: at right angles to the door, pointing down on the screen (it turns the door clockwise)
			const p2 = { x: AX + r2 * PXM, y: AY + 5 };
			const L2 = KF * F2;
			q('[data-f2]').setAttribute('d', arrowPath(p2.x, p2.y, p2.x, p2.y + L2, 3, 9));
			q('[data-act2]').setAttribute('d', F2 > 0 ? `M${p2.x.toFixed(1)} 0 V226` : '');
			// d₂ = r₂: a gold dimension line under the door
			const yd = AY + 18;
			q('[data-arm2]').setAttribute('d', F2 > 0 ? `M${AX} ${yd} H${p2.x.toFixed(1)}` : '');
			q('[data-tick2]').setAttribute('d', F2 > 0 ? `M${AX} ${yd - 5} V${yd + 5} M${p2.x.toFixed(1)} ${yd - 5} V${yd + 5}` : '');
			segs.push(segOf(AX, yd, p2.x, yd, 3));
			if (F1 > 0) segs.push(segOf(p1.x, p1.y, e1.x, e1.y, 4), segOf(p1.x - ux * far, p1.y - uy * far, p1.x + ux * far, p1.y + uy * far, 1));
			if (armOn) segs.push(segOf(AX, AY, fx, fy, 2));
			if (F2 > 0) segs.push(segOf(p2.x, p2.y, p2.x, p2.y + L2, 4), segOf(p2.x, 0, p2.x, 226, 1));
			place(q<SVGTextElement>('[data-lax]'), [
				{ x: 22, y: 97, anchor: 'middle' },
				{ x: 22, y: 134, anchor: 'middle' },
				{ x: 22, y: 80, anchor: 'middle' },
				{ x: 22, y: 150, anchor: 'middle' },
			], segs, boxes, VIEW);
			// the label of the wall: under it, or above it when a line of action crosses there
			place(q<SVGTextElement>('[data-lwall]'), [
				{ x: 392, y: 134, anchor: 'end' },
				{ x: 392, y: 97, anchor: 'end' },
				{ x: 392, y: 150, anchor: 'end' },
				{ x: 392, y: 80, anchor: 'end' },
			], segs, boxes, VIEW);
			// the moments and the sense of turning
			const M1 = F1 * d1;
			const M2 = -F2 * r2;
			const sum = M1 + M2;
			const R = 34;
			const turn = q('[data-turn]');
			const head = q('[data-turnh]');
			if (Math.abs(sum) < 0.05) {
				turn.setAttribute('d', '');
				head.setAttribute('d', '');
			} else {
				const sg = sum > 0 ? -1 : 1; // above the door (screen y < AY) when counterclockwise
				const a0 = 0.35;
				const a1 = 1.35;
				const P = (a: number) => ({ x: AX + R * Math.cos(a), y: AY + sg * R * Math.sin(a) });
				const s0 = P(a0);
				const s1 = P(a1);
				turn.setAttribute('d', `M${s0.x.toFixed(1)} ${s0.y.toFixed(1)} A${R} ${R} 0 0 ${sg < 0 ? 0 : 1} ${s1.x.toFixed(1)} ${s1.y.toFixed(1)}`);
				const tx = -Math.sin(a1);
				const ty = sg * Math.cos(a1);
				head.setAttribute('d', arrowPath(s1.x - tx * 2, s1.y - ty * 2, s1.x + tx * 8, s1.y + ty * 8, 2.2, 9));
				const pts = [0.35, 0.6, 0.85, 1.1, 1.35].map(P);
				for (let i = 0; i + 1 < pts.length; i++) segs.push(segOf(pts[i].x, pts[i].y, pts[i + 1].x, pts[i + 1].y, 3));
			}
			q('[data-state]').textContent =
				Math.abs(sum) < 0.05 ? 'Равновесие: дверь не поворачивается.' : sum > 0 ? 'Дверь повернётся против часовой стрелки.' : 'Дверь повернётся по часовой стрелке.';
			q('[data-state]').classList.toggle('is-right', Math.abs(sum) < 0.05);
			// labels
			const lf1 = q<SVGTextElement>('[data-lf1]');
			const lf2 = q<SVGTextElement>('[data-lf2]');
			const ld1 = q<SVGTextElement>('[data-ld1]');
			const ld2 = q<SVGTextElement>('[data-ld2]');
			show(lf1, F1 > 0);
			show(lf2, F2 > 0);
			show(ld1, armOn);
			show(ld2, F2 > 0);
			boxes.push({ x0: e1.x - 11, y0: e1.y - 11, x1: e1.x + 11, y1: e1.y + 11 }); // the grip
			if (F1 > 0) place(lf1, [...along(p1.x, p1.y, e1.x, e1.y, 15), ...rings(e1.x, e1.y, Math.atan2(uy, ux))], segs, boxes, VIEW);
			if (F2 > 0) place(lf2, [...along(p2.x, p2.y, p2.x, p2.y + L2, 15), ...rings(p2.x, p2.y + L2, Math.PI / 2)], segs, boxes, VIEW);
			if (armOn) {
				const mx = (AX + fx) / 2;
				const my = (AY + fy) / 2;
				const c: Cand[] = [...along(AX, AY, fx, fy, 12, [0.5, 0.35, 0.65, 0.2, 0.8]), ...ring(mx, my, 22, 0, 16), ...rings(mx, my, 0), ...ring(mx, my, 44, 0, 20), ...ring(mx, my, 54, 0, 24)];
				place(ld1, c, segs, boxes, VIEW);
			}
			if (F2 > 0) place(ld2, [{ x: (AX + p2.x) / 2, y: yd + 17, anchor: 'middle' }, { x: (AX + p2.x) / 2 + 20, y: yd + 17, anchor: 'middle' }, { x: (AX + p2.x) / 2 - 20, y: yd + 17, anchor: 'middle' }, { x: AX + 4, y: yd + 30, anchor: 'start' }, { x: AX - 4, y: yd + 5, anchor: 'end' }, { x: AX - 4, y: yd + 20, anchor: 'end' }, ...rings((AX + p2.x) / 2, yd + 4, Math.PI / 2)], segs, boxes, VIEW);
			const n = (v: number) => tex(fmt(v, 1));
			q('[data-lines]').innerHTML = [
				k(`d_1 = r_1\\sin\\beta = ${tex(fmtTrim(r1, 2))}\\cdot\\sin ${b}^\\circ \\approx ${tex(fmtTrim(d1, 2))}~\\text{м}`),
				k(`M_1 = F_1 d_1 \\approx ${n(M1)}~\\text{Н}\\cdot\\text{м}`),
				k(`M_2 = -F_2 d_2 = -${F2}\\cdot ${tex(fmtTrim(r2, 2))} = ${n(M2)}~\\text{Н}\\cdot\\text{м}`),
				k(`M_1 + M_2 \\approx ${n(sum)}~\\text{Н}\\cdot\\text{м}`),
			]
				.map((h, i) => `<li${i === 3 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
		};
		for (const inp of [f1In, r1In, bIn, f2In, r2In]) inp.addEventListener('input', draw);
		const grip = q<SVGCircleElement>('[data-grip]');
		let on = false;
		grip.addEventListener('pointerdown', (e) => {
			on = true;
			grip.setPointerCapture(e.pointerId);
			e.preventDefault();
		});
		grip.addEventListener('pointermove', (e) => {
			if (!on) return;
			const p = svgPoint(svg, e);
			const px = AX + (Number(r1In.value) / 100) * PXM;
			const dx = p.x - px;
			const dy = Math.max(0, AY - p.y);
			f1In.value = String(Math.min(40, Math.round(Math.hypot(dx, dy) / KF / 2) * 2));
			bIn.value = String(Math.min(180, Math.max(0, Math.round((Math.atan2(dy, dx) * 180) / Math.PI / 5) * 5)));
			draw();
		});
		const off = () => (on = false);
		grip.addEventListener('pointerup', off);
		grip.addEventListener('pointercancel', off);
		draw();
		document.fonts?.ready.then(draw);
	}
</script>
