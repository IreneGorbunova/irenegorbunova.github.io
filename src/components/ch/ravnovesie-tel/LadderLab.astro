---
/**
 * «Лестница у стены»: a ladder L = 4 м long, of mass m = 10 кг (its center of gravity at the middle), leans on a smooth
 * wall (no friction at the wall); the floor has friction with the coefficient μ (0,1…0,8). The angle with the floor α
 * (45…80°). A person of mass M = 70 кг (175 см, the people kit) stands on the rungs (every 0,25 м along the ladder) at the
 * distance s (0…4 м) along the ladder from its foot; «Подняться» makes him climb from the foot at 0,5 м/с (one foot
 * moves up by two rungs in 0,5 с while the other stands; s is the middle between his feet).
 * Forces on the ladder (one scale): m·g⃗ at the middle (blue), the weight of the person P⃗ = M·g⃗ at
 * his feet (red), at the foot the reaction of the floor N⃗₁ up and the friction of rest F⃗тр toward the wall (violet and
 * orange), at the top the reaction of the wall N⃗₂ away from the wall (violet).
 * Physics: N₁ = (m + M)g; the moments about the foot: N₂·L sin α = mg·(L/2) cos α + Mg·s cos α, so
 * N₂ = (mg/2 + Mg·s/L) / tg α; the first condition along the floor: F_тр = N₂ (the friction that is needed). The friction
 * of rest cannot exceed μN₁: while N₂ ≤ μN₁ the ladder stands. Climbing, the ladder starts to slip at
 * s* = L·(μ(m + M)·tg α − m/2) / M: the climb stops there, the foot slides 25 см away from the wall in 0,8 с (the top
 * slides down the wall, the person holds on and moves with the ladder; friction then is μN₁; the readouts and the
 * arrows stay frozen at the moment of the slip), and the model stops (in
 * reality the ladder would fall); «Сначала» resets. Set by the slider beyond s*, the ladder is drawn standing, the
 * friction arrow at its greatest value μN₁ and the needed one dashed, with the warning that it would slip.
 * Checked (g = 9,8): α 60°, μ 0,3: N₁ = 784 Н, μN₁ = 235,2 Н, N₂ = 28,3 Н at s = 0 and 424,4 Н at the top, slips at
 * s ≈ 2,09 м; α 75°: N₂ = 196,9 Н at the top — safe to the top; μ 0,5 at 60°: slips at s ≈ 3,67 м.
 * Near the top his hands cannot reach the rails, so they rest flat on the wall (their force is neglected).
 * Scale 50 px per metre (the ladder, the person, the room); the forces 0,14 px per newton. «Оси и плечи» draws the axes and the arms of m·g⃗, P⃗ and
 * N⃗₂ about the foot (gold): (L/2)·cos α, s·cos α, L·sin α.
 */
import RtStyles from './RtStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
---

<RtStyles />
<PeopleStyles />
<figure class="g7 g7--stack ldr not-content" data-ldr>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 400" role="img" aria-label="Лестница опирается на гладкую стену и на пол; на лестнице стоит человек. Показаны силы, действующие на лестницу" data-svg>
			<rect class="ldr__strip" x="0" y="296" width="300" height="8"></rect>
			<path class="rt-hatch" d={Array.from({ length: 25 }, (_, i) => `M${i * 12} 304 l8 -8`).join(' ')}></path>
			<path class="rt-gline" d="M0 296 H260"></path>
			<rect class="ldr__wall" x="260" y="0" width="40" height="296"></rect>
			<path class="rt-hatch" d={Array.from({ length: 24 }, (_, i) => `M272 ${i * 12 + 6} l-10 8`).join(' ')}></path>
			<path class="rt-gline" d="M260 0 V296"></path>
			<g data-axes class="ldr__axes">
				<path class="rt-axis" data-axx></path>
				<path class="rt-f--ink" data-axxh></path>
				<path class="rt-axis" data-axy></path>
				<path class="rt-f--ink" data-axyh></path>
				<text class="t-i t-halo" data-lx>x</text>
				<text class="t-i t-halo" data-ly>y</text>
				<path class="rt-dash rt-s--grav" data-lmgd></path>
				<path class="rt-dash rt-s--p" data-lpd></path>
				<path class="rt-dash rt-s--n" data-ln2d></path>
				<path class="rt-arm" data-a1></path>
				<path class="rt-arm" data-a2></path>
				<path class="rt-arm" data-a3></path>
				<text class="t-i rt-t--d t-halo ldr__al" data-la1>(L/2)·cos α</text>
				<text class="t-i rt-t--d t-halo ldr__al" data-la2>s·cos α</text>
				<text class="t-i rt-t--d t-halo ldr__al" data-la3>L·sin α</text>
			</g>
			<g data-ladder>
				<path class="ldr__rail ldr__rail--far" data-railf></path>
				<path class="ldr__rung" data-rungs></path>
				<path class="ldr__rail" data-rail></path>
				<path class="ldr__pad" data-pad></path>
			</g>
			<g data-man></g>
			<g data-cg></g>
			<path class="rt-f--n" data-n1></path>
			<path class="rt-f--fr" data-fr></path>
			<path class="rt-dash rt-s--fr" data-frneed></path>
			<path class="rt-f--n" data-n2></path>
			<path class="rt-f--grav" data-mg></path>
			<path class="rt-f--p" data-p></path>
			<text class="rt-sym rt-t--n" data-rtv="0" data-ln1>N<tspan class="rt-sub" dy="4">1</tspan></text>
			<text class="rt-sym rt-t--n" data-rtv="0" data-ln2>N<tspan class="rt-sub" dy="4">2</tspan></text>
			<text class="rt-sym rt-t--fr" data-rtv="0" data-lfr>F<tspan class="rt-sub" dy="4">тр</tspan></text>
			<text class="rt-sym rt-t--grav" data-rtv="1" data-lmg>mg</text>
			<text class="rt-sym rt-t--p" data-rtv="0" data-lp>P</text>
			<path class="ldr__alpha" data-arc></path>
			<text class="t-i t-halo" data-lal>α</text>
		</svg>
		<div class="g7__side ldr__side">
			<label class="g7__slider">
				<span>Угол с полом <i>α</i></span>
				<output data-oa></output>
				<input type="range" min="45" max="80" step="1" value="60" data-a aria-label="Угол лестницы с полом, градусы" />
			</label>
			<label class="g7__slider">
				<span>Коэффициент трения <i>μ</i></span>
				<output data-omu></output>
				<input type="range" min="0.1" max="0.8" step="0.05" value="0.3" data-mu aria-label="Коэффициент трения лестницы о пол" />
			</label>
			<label class="g7__slider">
				<span>Где стоит человек <i>s</i></span>
				<output data-os></output>
				<input type="range" min="0" max="4" step="0.25" value="1" data-s aria-label="Расстояние вдоль лестницы от её основания до ступенек, на которых стоит человек, метры" />
			</label>
			<div class="ldr__btns">
				<button type="button" class="g7__btn g7__btn--go" data-go>Подняться</button>
				<button type="button" class="g7__btn" data-reset>Сначала</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-arms>Оси и плечи</button>
			</div>
			<p class="g7__msg" data-state aria-live="polite"></p>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Лестница длиной 4&nbsp;м и массой 10&nbsp;кг, человек массой 70&nbsp;кг; стена гладкая, трение есть только о пол. Масштаб 50&nbsp;px на метр, силы — 0,14&nbsp;px на ньютон, <i>g</i>&nbsp;=&nbsp;9,8&nbsp;м/с². Пунктирная оранжевая стрелка — сила трения, которая нужна, чтобы лестница стояла, когда она больше наибольшей силы трения покоя.
	</figcaption>
</figure>

<style is:global>
	.ldr__side {
		grid-template-columns: minmax(0, 1fr);
	}
	.ldr .g7__svg {
		max-width: 30rem;
		margin-inline: auto;
	}
	.ldr__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.ldr .g7__msg.is-bad {
		background: color-mix(in oklab, var(--g7-red) 22%, var(--sl-color-gray-6));
	}
	.g7__svg .ldr__wall {
		fill: var(--g7-faint);
	}
	.g7__svg .ldr__strip {
		fill: var(--g7-ground);
	}
	.g7__svg .ldr__rail {
		fill: none;
		stroke: var(--g7-wood);
		stroke-width: 4.5;
		stroke-linecap: round;
	}
	.g7__svg .ldr__rail--far {
		stroke: var(--g7-wood-dark);
		stroke-width: 4;
	}
	.g7__svg .ldr__rung {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.g7__svg .ldr__pad {
		fill: var(--g7-ink);
	}
	.g7__svg .ldr__alpha {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .ldr__al {
		font-size: 12px;
	}
	.ldr__axes {
		display: none;
	}
	.ldr.is-arms .ldr__axes {
		display: inline;
	}
</style>

<script>
	import { fmt, fmtTrim, loop } from '../g7/kit';
	import { figure, blendShape, handShape, type Pt, type HandTarget } from '@components/people';
	import { arrowPath, place, along, ring, rings, segOf, cgMark, vecArrows, type Seg, type Box, type Cand } from './rt';

	const g = 9.8;
	const K = 50; // px per metre
	const FY = 296; // the floor
	const WX = 260; // the wall
	const L = 4;
	const m = 10;
	const M = 70;
	const KF = 0.14; // px per newton
	const RUNG = 0.25;
	const VIEW: Box = { x0: 2, y0: 2, x1: 258, y1: 398 };
	const VIEW2: Box = { x0: 2, y0: 2, x1: 298, y1: 398 };
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-ldr]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const aIn = q<HTMLInputElement>('[data-a]');
		const muIn = q<HTMLInputElement>('[data-mu]');
		const sIn = q<HTMLInputElement>('[data-s]');
		const S = K / 100; // px per см
		const H = 175;
		const u = S * H;
		const man = figure(q<SVGGElement>('[data-man]'), { s: S, H, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'climber' });
		const GRIP = handShape('grip', 0.22);
		const FLAT = handShape('flat');
		// the state of the feet (rung positions along the ladder, м) and of the climb
		let feet: [number, number] = [1, 1];
		let swing: { i: 0 | 1; from: number; to: number; t: number } | null = null;
		let climbing = false;
		let slide = 0; // 0…1 of the slip
		let slipped = false;
		let sSlip = 0; // where he stood when the ladder began to slip
		let showArms = false;
		const sNow = () => (feet[0] + feet[1]) / 2 + (swing ? ((swing.to - swing.from) * ease(swing.t)) / 2 : 0);
		const footAt = (i: 0 | 1) => (swing && swing.i === i ? swing.from + (swing.to - swing.from) * ease(swing.t) : feet[i]);
		const draw = () => {
			const a0 = (Number(aIn.value) * Math.PI) / 180;
			const mu = Number(muIn.value);
			// the slip: the foot moves 25 см away from the wall, the top slides down
			const dxs = 0.25 * ease(slide);
			const ca = Math.min(1, Math.cos(a0) + dxs / L);
			const al = Math.acos(ca);
			const foot = { x: WX - L * K * Math.cos(al), y: FY };
			const top = { x: WX, y: FY - L * K * Math.sin(al) };
			const e = { x: Math.cos(al), y: -Math.sin(al) };
			const n = { x: -Math.sin(al), y: -Math.cos(al) }; // away from the ladder, on the person's side
			const R = (sm: number, off = 0): Pt => ({ x: foot.x + e.x * sm * K + n.x * off, y: foot.y + e.y * sm * K + n.y * off });
			// the ladder
			const rail = `M${foot.x.toFixed(1)} ${foot.y} L${top.x.toFixed(1)} ${top.y.toFixed(1)}`;
			q('[data-rail]').setAttribute('d', rail);
			const fr = R(0, -2.5);
			const tr = R(L, -2.5);
			q('[data-railf]').setAttribute('d', `M${fr.x.toFixed(1)} ${fr.y.toFixed(1)} L${tr.x.toFixed(1)} ${tr.y.toFixed(1)}`);
			let rungs = '';
			for (let k = 1; k * RUNG <= L + 1e-6; k++) {
				const p = R(k * RUNG, 0.5);
				rungs += `M${(p.x + 2).toFixed(1)} ${p.y.toFixed(1)} a2 2 0 1 0 -4 0 a2 2 0 1 0 4 0 `;
			}
			q('[data-rungs]').setAttribute('d', rungs);
			q('[data-pad]').setAttribute('d', `M${(foot.x - 4).toFixed(1)} ${FY} h8 l-1 -2.5 h-6 Z`);
			// the person: ankles on the rungs, the hip above and behind them, the trunk leaning toward the ladder
			const s = Math.min(L, Math.max(0, sNow()));
			const fN = footAt(0);
			const fF = footAt(1);
			const liftN = swing && swing.i === 0 ? Math.sin(Math.PI * swing.t) * 0.06 * u : 0;
			const liftF = swing && swing.i === 1 ? Math.sin(Math.PI * swing.t) * 0.06 * u : 0;
			const ank = (sm: number, lift: number, dz: number) => {
				const p = R(sm, 0.043 * u + lift);
				return { x: p.x + dz, y: p.y };
			};
			const ankles: [Pt, Pt] = [ank(fN, liftN, 1), ank(fF, liftF, -1.5)];
			const hipS = s + (0.42 * u) / K;
			const hip = R(hipS, 0.21 * u);
			const lean = Math.max(0.02, (82 * Math.PI) / 180 - al);
			const sh = man.shoulders(hip, lean);
			// hands: on the rails a little above the shoulders, or flat on the wall when the rails end below them
			const alongOf = (p: Pt) => ((p.x - foot.x) * e.x + (p.y - foot.y) * e.y) / K;
			const hand = (i: 0 | 1): HandTarget => {
				const want = alongOf(sh[i]) + (0.11 * u) / K - i * 0.05;
				const onRail = R(Math.min(want, L - 0.06), 2.6);
				const reach = (0.315 * u) * 0.97 + 0.04 * u;
				const dRail = Math.hypot(onRail.x - sh[i].x, onRail.y - sh[i].y);
				const wall = { x: WX - 1, y: sh[i].y + 0.02 * u - i * 2 };
				const w = ease((dRail - (reach - 0.04 * u)) / (0.06 * u));
				if (w <= 0) return { at: onRail, pose: 'grip', d: 4, shape: GRIP, contact: 'rail of the ladder' };
				const at = { x: onRail.x + (wall.x - onRail.x) * w, y: onRail.y + (wall.y - onRail.y) * w };
				return { at, pose: w < 0.5 ? 'grip' : 'flat', shape: blendShape(GRIP, FLAT, w), dir: w > 0.5 ? -Math.PI / 2 : undefined, roll: w > 0.5 ? -0.25 : undefined, contact: w >= 1 ? 'wall' : undefined };
			};
			man.pose({
				hip,
				lean,
				ankles,
				feet: [0, 0],
				hands: [hand(0), hand(1)],
				head: 0.05,
				planted: [!slide && !(swing && swing.i === 0), !slide && !(swing && swing.i === 1)],
			});
			// the forces
			const mg = m * g;
			const P = M * g;
			const N1 = mg + P;
			// during the slip every force and readout stays as it was at the moment of the slip
			const sF = slide > 0 ? sSlip : s;
			const N2 = (mg / 2 + (P * sF) / L) / Math.tan(slide > 0 ? a0 : al);
			const Fmax = mu * N1;
			const ok = N2 <= Fmax + 1e-9;
			const Ffr = slide > 0 ? Fmax : Math.min(N2, Fmax);
			const mid = R(L / 2);
			const pP = R(s);
			const segs: Seg[] = [segOf(foot.x, foot.y, top.x, top.y, 4), segOf(0, FY, WX, FY, 1.5), segOf(WX, 0, WX, FY, 1.5)];
			const put = (sel: string, x1: number, y1: number, x2: number, y2: number) => {
				q(sel).setAttribute('d', arrowPath(x1, y1, x2, y2, 3, 9));
				segs.push(segOf(x1, y1, x2, y2, 4));
			};
			put('[data-n1]', foot.x, foot.y, foot.x, foot.y - KF * N1);
			put('[data-fr]', foot.x + 1, FY - 4, foot.x + 1 + KF * Ffr, FY - 4);
			const needOn = !ok && slide === 0;
			q('[data-frneed]').setAttribute('d', needOn ? `M${(foot.x + 1).toFixed(1)} ${FY - 4} H${(foot.x + 1 + KF * N2).toFixed(1)}` : '');
			if (needOn) segs.push(segOf(foot.x, FY - 4, foot.x + KF * N2, FY - 4, 3));
			put('[data-n2]', top.x - 1, top.y, top.x - 1 - KF * N2, top.y);
			put('[data-mg]', mid.x, mid.y, mid.x, mid.y + KF * mg);
			put('[data-p]', pP.x, pP.y, pP.x, pP.y + KF * P);
			q('[data-cg]').innerHTML = cgMark(mid.x, mid.y, 4);
			// the angle α at the foot
			const ra = 18;
			q('[data-arc]').setAttribute('d', `M${(foot.x + ra).toFixed(1)} ${FY} A${ra} ${ra} 0 0 0 ${(foot.x + ra * e.x).toFixed(1)} ${(FY + ra * e.y).toFixed(1)}`);
			for (let k = 0; k < 6; k++) segs.push(segOf(foot.x + ra * Math.cos((al * k) / 6), FY - ra * Math.sin((al * k) / 6), foot.x + ra * Math.cos((al * (k + 1)) / 6), FY - ra * Math.sin((al * (k + 1)) / 6), 1));
			// the person and the arc as obstacles
			const boxes: Box[] = [{ x0: 0, y0: FY - 1, x1: 300, y1: FY + 9 }];
			const pts = [hip, sh[0], ankles[0], ankles[1]];
			const xs = pts.map((p) => p.x);
			const ys = pts.map((p) => p.y);
			boxes.push({ x0: Math.min(...xs) - 0.09 * u, y0: Math.min(...ys) - 0.2 * u, x1: Math.max(...xs) + 0.09 * u, y1: Math.max(...ys) + 4 });
			const lal = q<SVGTextElement>('[data-lal]');
			// axes and arms
			root.classList.toggle('is-arms', showArms);
			if (showArms) {
				const ax = (sel: string, x1: number, y1: number, x2: number, y2: number) => {
					q(sel).setAttribute('d', `M${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)}`);
					segs.push(segOf(x1, y1, x2, y2, 1.5));
				};
				ax('[data-axx]', foot.x - 60, FY + 14, WX + 26, FY + 14);
				q('[data-axxh]').setAttribute('d', arrowPath(WX + 20, FY + 14, WX + 32, FY + 14, 1.5, 8));
				ax('[data-axy]', foot.x - 60, FY + 16, foot.x - 60, 26);
				q('[data-axyh]').setAttribute('d', arrowPath(foot.x - 60, 34, foot.x - 60, 22, 1.5, 8));
				const lx = q<SVGTextElement>('[data-lx]');
				lx.setAttribute('x', String(WX + 26));
				lx.setAttribute('y', String(FY + 30));
				const ly = q<SVGTextElement>('[data-ly]');
				ly.setAttribute('x', (foot.x - 74).toFixed(1));
				ly.setAttribute('y', '32');
				boxes.push({ x0: WX + 22, y0: FY + 18, x1: WX + 34, y1: FY + 33 }, { x0: foot.x - 78, y0: 20, x1: foot.x - 66, y1: 36 });
				// the lines of action and the arms about the foot
				ax('[data-lmgd]', mid.x, mid.y + KF * mg, mid.x, FY + 30);
				ax('[data-lpd]', pP.x, pP.y + KF * P, pP.x, FY + 50);
				ax('[data-ln2d]', top.x - KF * N2, top.y, foot.x - 14, top.y);
				ax('[data-a1]', foot.x, FY + 28, mid.x, FY + 28);
				ax('[data-a2]', foot.x, FY + 48, Math.max(foot.x + 0.5, pP.x), FY + 48);
				ax('[data-a3]', foot.x - 14, FY - 1, foot.x - 14, top.y);
				const sAr = s > 0.02;
				(q('[data-a2]') as SVGElement).style.visibility = sAr ? 'visible' : 'hidden';
				(q('[data-la2]') as SVGElement).style.visibility = sAr ? 'visible' : 'hidden';
				const view2: Box = VIEW2;
				const row = (x0: number, x1: number, y: number): Cand[] => {
					const out: Cand[] = [{ x: (x0 + x1) / 2, y: y - 4, anchor: 'middle' }, { x: (x0 + x1) / 2, y: y + 13, anchor: 'middle' }];
					for (let x = Math.min(x0, x1) - 40; x <= Math.max(x0, x1) + 40; x += 8) out.push({ x, y: y - 4, anchor: 'middle' }, { x, y: y + 13, anchor: 'middle' });
					return out;
				};
				place(q('[data-la1]'), row(foot.x, mid.x, FY + 28), segs, boxes, view2);
				if (sAr) place(q('[data-la2]'), row(foot.x, pP.x, FY + 48), segs, boxes, view2);
				const ym3 = (FY + top.y) / 2;
				place(q('[data-la3]'), [ym3, ym3 + 30, ym3 - 30, ym3 + 60, ym3 - 60].flatMap((y) => [{ x: foot.x - 19, y, anchor: 'end' as const }, { x: foot.x - 66, y, anchor: 'end' as const }]), segs, boxes, view2);
			}
			place(lal, [{ x: foot.x + ra + 10, y: FY - 6, anchor: 'start' }, { x: foot.x + ra + 6, y: FY - 14, anchor: 'start' }, { x: foot.x + ra + 16, y: FY - 12, anchor: 'start' }, ...[18, 24, 30].map((d) => ({ x: foot.x + ra + d, y: FY - 5, anchor: 'start' as const })), ...[0.2, 0.35, 0.5].flatMap((f) => [12, 20].map((d) => ({ x: foot.x + (ra + d) * Math.cos(al * f), y: FY - (ra + d) * Math.sin(al * f) + 5, anchor: 'middle' as const }))), ...[8, 14, 20, 28, 36, 44, 52, 60].flatMap((d) => [0.6, 0.75, 0.9, 0.1, 0.2, 0.3].map((f) => ({ x: foot.x + (ra + d) * Math.cos(al * f), y: FY - (ra + d) * Math.sin(al * f) + 5, anchor: 'middle' as const })))], segs, boxes, VIEW);
			// labels of the forces
			const side = (p: Pt, v: Pt, off: number): Cand[] => [...along(p.x, p.y, p.x + v.x, p.y + v.y, off), ...rings(p.x + v.x, p.y + v.y, Math.atan2(v.y, v.x)), ...rings(p.x + v.x / 2, p.y + v.y / 2, Math.atan2(v.y, v.x) + Math.PI / 2)];
			place(q('[data-ln1]'), side(foot, { x: 0, y: -KF * N1 }, 14), segs, boxes, VIEW);
			place(q('[data-lfr]'), [{ x: foot.x + KF * Math.max(Ffr, needOn ? N2 : 0) / 2 + 2, y: FY - 12, anchor: 'middle' }, { x: foot.x - 9, y: FY - 4, anchor: 'end' }, { x: foot.x - 9, y: FY - 18, anchor: 'end' }, ...[-4, -16, -28].flatMap((dy) => [20, 26].map((dx) => ({ x: foot.x - dx, y: FY + dy, anchor: 'end' as const }))), ...rings(foot.x + KF * Ffr, FY - 4, -Math.PI / 4), ...side({ x: foot.x, y: FY - 4 }, { x: KF * Math.max(Ffr, needOn ? N2 : 0), y: 0 }, 13)], segs, boxes, VIEW);
			place(q('[data-ln2]'), side(top, { x: -KF * N2, y: 0 }, 13), segs, boxes, VIEW);
			place(q('[data-lmg]'), [...side(mid, { x: 0, y: KF * mg }, 15), ...ring(mid.x, mid.y + (KF * mg) / 2, 44, 0, 16), ...ring(mid.x, mid.y + (KF * mg) / 2, 54, 0, 16)], segs, boxes, VIEW);
			// P⃗ may stand over the wall when the ladder is steep (closer to its arrow than any free place on the left)
			place(q('[data-lp]'), side(pP, { x: 0, y: KF * P }, 13), segs, boxes, VIEW2);
			// readouts
			const sStar = (L * (mu * (m + M) * Math.tan(a0) - m / 2)) / M;
			q('[data-oa]').textContent = `${Math.round((a0 * 180) / Math.PI)}°`;
			q('[data-omu]').textContent = fmtTrim(mu, 2);
			q('[data-os]').textContent = `${fmtTrim(Math.round(sF * 100) / 100, 2)} м`;
			const N = (v: number) => `${fmt(v, 1)} Н`;
			q('[data-read]').innerHTML = [
				['<i>N</i><sub>1</sub> = (<i>m</i> + <i>M</i>)<i>g</i>', N(N1)],
				['<i>N</i><sub>2</sub>', N(N2)],
				['нужная сила трения <i>F</i><sub>тр</sub> = <i>N</i><sub>2</sub>', N(N2)],
				['наибольшая сила трения покоя <i>μN</i><sub>1</sub>', N(Fmax)],
			]
				.map(([a, v], i) => `<li${i >= 2 ? ` class="${i === 2 ? 'is-key' : 'is-warm'}"` : ''}><span>${a}</span><b>${v}</b></li>`)
				.join('');
			const st = q('[data-state]');
			const where = sStar <= 0 ? 'даже без человека' : sStar >= L ? '' : `при <i>s</i> ≈ ${fmt(sStar, 2)}&nbsp;м`;
			st.innerHTML = slipped
				? `Лестница поехала: нужная сила трения дошла до наибольшей силы трения покоя. Это случилось ${where}. Нажмите «Сначала».`
				: ok
					? `Лестница стоит. ${sStar >= L ? 'Можно подняться до самого верха.' : `Она соскользнёт, если подняться выше: ${where}.`}`
					: `Так лестница стоять не может: нужная сила трения больше наибольшей. Она соскальзывает ${where}.`;
			st.classList.toggle('is-bad', !ok || slipped);
			st.classList.toggle('is-right', ok && !slipped && sStar >= L);
			sIn.value = String(s);
			return { ok, sStar };
		};
		// the climb: one swing of a foot takes 0,5 с; the first swing moves the near foot by one rung, the others by two
		let dir: 0 | 1 = 0;
		const wake = loop(root, (dt) => {
			if (slide > 0 && slide < 1) {
				slide = Math.min(1, slide + dt / 0.8);
				draw();
				return slide < 1;
			}
			if (!climbing) return false;
			if (!swing) {
				const other = feet[1 - dir];
				const to = feet[dir] === other ? feet[dir] + RUNG : other + RUNG;
				if (to > L + 1e-6) {
					// bring the lower foot up to the top rung, then stop
					if (feet[0] !== feet[1]) swing = { i: dir, from: feet[dir], to: Math.max(feet[0], feet[1]), t: 0 };
					else {
						climbing = false;
						draw();
						return false;
					}
				} else swing = { i: dir, from: feet[dir], to, t: 0 };
			}
			swing.t = Math.min(1, swing.t + dt / 0.5);
			const { ok, sStar } = draw();
			if (!ok) {
				// the ladder slips here: the climb stops, the foot slides out
				climbing = false;
				slipped = true;
				sSlip = Math.min(sNow(), Math.max(0, sStar));
				slide = 1e-3;
				return true;
			}
			if (swing.t >= 1) {
				feet[swing.i] = swing.to;
				swing = null;
				dir = (1 - dir) as 0 | 1;
			}
			return true;
		});
		const reset = (s0: number) => {
			climbing = false;
			swing = null;
			slide = 0;
			slipped = false;
			dir = 0;
			feet = [s0, s0];
			sIn.value = String(s0);
		};
		q('[data-go]').addEventListener('click', () => {
			reset(0);
			climbing = true;
			draw();
			wake();
		});
		q('[data-reset]').addEventListener('click', () => {
			reset(0);
			draw();
		});
		const armsBtn = q<HTMLButtonElement>('[data-arms]');
		armsBtn.addEventListener('click', () => {
			showArms = !showArms;
			armsBtn.setAttribute('aria-pressed', String(showArms));
			draw();
		});
		sIn.addEventListener('input', () => {
			reset(Number(sIn.value));
			draw();
		});
		for (const inp of [aIn, muIn])
			inp.addEventListener('input', () => {
				const s0 = Math.round(sNow() / RUNG) * RUNG;
				reset(s0);
				draw();
			});
		reset(Number(sIn.value));
		draw();
		document.fonts?.ready.then(() => {
			vecArrows(root);
			draw();
		});
	}
</script>
