---
/**
 * «Центр тяжести» (next to the definition). Three panels, the force of gravity blue, the center of gravity the quartered
 * disc of the chapter.
 *  (a) A uniform rod cut in the mind into 8 equal pieces; on each acts its own force of gravity m₁·g⃗ … m₈·g⃗ (12 px each).
 *      In 1,5 с the eight arrows slide to the middle of the rod and line up one after another: their sum is one arrow
 *      m·g⃗, 8 times longer, applied at the middle — the center of gravity appears there. Loop 6 с.
 *  (b) A ring (a bagel), outer radius 5 см, inner 3 см, 10 px per см: its center of gravity lies at the center, where
 *      there is no matter; m·g⃗ is drawn from there.
 *  (c) A hammer, 6 px per см: a wooden handle 32 см long of 0,15 кг (its own center at 16 см from the end) and a steel
 *      head of 0,6 кг whose center is at 30 см. The center of gravity: (0,15 · 16 + 0,6 · 30) / 0,75 = 27,2 см from the
 *      end of the handle, 2,8 см from the center of the head — near the heavy part.
 * The panels stack on a phone.
 */
import RtStyles from './RtStyles.astro';
import { arrowPath, cgMark } from './rt';

// (a)
const RX0 = 24;
const RW = 192;
const RY = 46;
const piece = RW / 8;
// (c)
const HK = 6; // px per см
const HX0 = 22;
const HY = 70;
const hcg = HX0 + 27.2 * HK;
---

<RtStyles />
<figure class="g7 g7--pic cgp not-content" data-cgp>
	<div class="g7__grid is-three">
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 240 190" role="img" aria-label="Однородный стержень мысленно разделён на восемь частей; на каждую действует своя сила тяжести. Восемь стрелок складываются в одну, приложенную в середине стержня" data-rod>
				<rect class="rt-wood" x={RX0} y={RY - 6} width={RW} height="12" rx="2"></rect>
				<path class="cgp-cut" d={Array.from({ length: 7 }, (_, i) => `M${RX0 + (i + 1) * piece} ${RY - 6} v12`).join(' ')}></path>
				{Array.from({ length: 8 }, (_, i) => <path class="rt-f--grav" data-small={i}></path>)}
				<path class="rt-f--grav" data-big></path>
				<g data-cg set:html={cgMark(RX0 + RW / 2, RY, 5)}></g>
				<text class="rt-sym rt-t--grav" data-rtv="2" data-ls1 x={RX0 + piece / 2 - 4} y={RY + 44} text-anchor="middle">m<tspan class="rt-sub" dy="4">1</tspan><tspan dy="-4">g</tspan></text>
				<text class="rt-sym rt-t--grav" data-rtv="2" data-ls8 x={RX0 + RW - piece / 2 + 4} y={RY + 44} text-anchor="middle">m<tspan class="rt-sub" dy="4">8</tspan><tspan dy="-4">g</tspan></text>
				<text class="rt-lab" data-dots x={RX0 + RW / 2} y={RY + 40} text-anchor="middle">…</text>
				<text class="rt-sym rt-t--grav" data-rtv="1" data-lbig x={RX0 + RW / 2 + 12} y={RY + 70}>mg</text>
			</svg>
			<figcaption>Силы тяжести всех частей стержня складываются в одну силу, приложенную в его середине.</figcaption>
		</figure>
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 240 190" role="img" aria-label="Кольцо. Его центр тяжести — в центре кольца, где вещества нет">
				<path class="cgp-ring" fill-rule="evenodd" d="M70 80 a50 50 0 1 0 100 0 a50 50 0 1 0 -100 0 Z M90 80 a30 30 0 1 0 60 0 a30 30 0 1 0 -60 0 Z"></path>
				<path class="rt-f--grav" d={arrowPath(120, 85, 120, 150, 3, 9)}></path>
				<Fragment set:html={cgMark(120, 80, 5)} />
				<text class="rt-sym rt-t--grav" data-rtv="1" x="128" y="162">mg</text>
				<path class="rt-lead" d="M126 76 L176 30"></path>
				<text class="rt-lab" x="178" y="26">центр</text>
				<text class="rt-lab" x="178" y="40">тяжести</text>
			</svg>
			<figcaption>Центр тяжести кольца — в его центре, где вещества нет.</figcaption>
		</figure>
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 240 190" role="img" aria-label="Молоток: лёгкая деревянная рукоятка и тяжёлый стальной боёк. Центр тяжести молотка — у бойка">
				<rect class="rt-wood" x={HX0} y={HY - 7} width={32 * HK} height="14" rx="5"></rect>
				<rect class="rt-metal" x={HX0 + 30 * HK - 8} y={HY - 30} width="16" height="60" rx="2"></rect>
				<path class="cgp-face" d={`M${HX0 + 30 * HK - 8} ${HY - 30} h16 v5 h-16 Z`}></path>
				<path class="rt-f--grav" d={arrowPath(hcg, HY + 5, hcg, HY + 70, 3, 9)}></path>
				<Fragment set:html={cgMark(hcg, HY, 5)} />
				<text class="rt-sym rt-t--grav" data-rtv="1" x={hcg - 36} y={HY + 66}>mg</text>
				<text class="rt-lab" x={HX0} y={HY - 16}>рукоятка 0,15 кг</text>
				<text class="rt-lab" x={HX0 + 30 * HK - 4} y={HY - 37} text-anchor="middle">боёк 0,6 кг</text>
			</svg>
			<figcaption>Центр тяжести молотка — у тяжёлого бойка.</figcaption>
		</figure>
	</div>
	<figcaption class="g7__caption">
		Синие стрелки — силы тяжести. Стержень, кольцо и молоток нарисованы в разных масштабах; у молотка рукоятка массой 0,15&nbsp;кг и боёк массой 0,6&nbsp;кг, центр тяжести — в 2,8&nbsp;см от середины бойка.
	</figcaption>
</figure>

<style is:global>
	.g7__svg .cgp-cut {
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
		stroke-dasharray: 2 2;
	}
	.g7__svg .cgp-ring {
		fill: hsl(32, 70%, 55%);
		stroke: hsl(28, 55%, 35%);
		stroke-width: 1.2;
	}
	.g7__svg .cgp-face {
		fill: var(--sl-color-gray-3);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { arrowPath, vecArrows } from './rt';

	const RX0 = 24;
	const RW = 192;
	const RY = 46;
	const piece = RW / 8;
	const A = 12; // px per small arrow
	const CYCLE = 6;
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-cgp]')) {
		const svg = root.querySelector<SVGSVGElement>('[data-rod]')!;
		const small = [...svg.querySelectorAll<SVGPathElement>('[data-small]')];
		const big = svg.querySelector<SVGPathElement>('[data-big]')!;
		const cg = svg.querySelector<SVGGElement>('[data-cg]')!;
		const fade = (sel: string, o: number) => {
			for (const e of svg.querySelectorAll<SVGElement>(sel)) e.setAttribute('opacity', o.toFixed(2));
		};
		let t = 0;
		const draw = () => {
			// 0–1,2 с eight arrows; 1,2–2,7 с they slide together; 2,7–3,0 с one arrow; hold; 5,6–6 с back
			const go = ease((t - 1.2) / 1.5);
			const one = ease((t - 2.7) / 0.3);
			const back = ease((t - 5.6) / 0.4);
			small.forEach((p, i) => {
				const x0 = RX0 + piece * (i + 0.5);
				const x = x0 + (RX0 + RW / 2 - x0) * go;
				const y0 = RY + 6;
				const y = y0 + i * A * go;
				p.setAttribute('d', arrowPath(x, y, x, y + A, 2.8, 7));
				p.setAttribute('opacity', ((1 - one) + back * one).toFixed(2));
			});
			big.setAttribute('d', arrowPath(RX0 + RW / 2, RY + 6, RX0 + RW / 2, RY + 6 + 8 * A, 3, 9));
			const ob = one * (1 - back);
			big.setAttribute('opacity', ob.toFixed(2));
			cg.setAttribute('opacity', ob.toFixed(2));
			fade('[data-lbig]', ob);
			const os = 1 - go;
			fade('[data-ls1]', os);
			fade('[data-ls8]', os);
			fade('[data-dots]', 1 - ease((t - 1.2) / 0.25));
			for (const o of svg.querySelectorAll<SVGElement>('[data-rtv-of]')) {
				const of = o.dataset.rtvOf;
				const txt = svg.querySelector<SVGTextElement>(`text[data-rtv-id="${of}"]`);
				if (txt) o.setAttribute('opacity', txt.getAttribute('opacity') ?? '1');
			}
		};
		vecArrows(root);
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		})();
		draw();
		document.fonts?.ready.then(() => {
			vecArrows(root);
			draw();
		});
	}
</script>
