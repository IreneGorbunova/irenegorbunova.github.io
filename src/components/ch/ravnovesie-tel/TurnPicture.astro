---
/**
 * «Сумма сил равна нулю, а тело поворачивается» (before the definitions of the arm and the moment). Two panels, a top
 * view of a board 1 м long and 2 кг lying on smooth ice (no friction). Two equal and opposite forces F⃗₁ and F⃗₂ of 1 Н
 * (teal, the force of a hand) act on it, so F⃗₁ + F⃗₂ = 0 in both panels.
 *  (a) the forces act at the two ends along the board, on one straight line (dashed): the board stays at rest;
 *  (b) the forces act at the two ends at right angles to the board, in opposite directions, on two parallel lines
 *      1 м apart: the board turns about its middle (its middle stays: the sum of the forces is zero). The forces turn
 *      with the board, staying at right angles to it. Their moment about the middle 2 · 1 Н · 0,5 м = 1 Н·м, the moment
 *      of inertia of the board m·L²/12 = 0,167 кг·м², so the angular acceleration is 6 рад/с² and the board turns by
 *      90° in 0,72 с; shown slowed down 4 times (2,9 с), then held for 1 с and restarted.
 * Scale: 140 px per metre, the forces 40 px per newton. Loop 5 с. The panels stack on a phone.
 */
import RtStyles from './RtStyles.astro';
import { arrowPath } from './rt';

const LB = 140; // the board, px
const FA = 40; // 1 Н, px
const C = { x: 120, y: 98 };
const ice = Array.from({ length: 7 }, (_, i) => `M${12 + i * 33} ${18 + ((i * 37) % 60)} l${14 + (i % 3) * 6} ${4 + (i % 2) * 3}`).join(' ');
---

<RtStyles />
<figure class="g7 g7--pic trp not-content" data-trp>
	<div class="g7__grid is-two">
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 240 202" role="img" aria-label="Доска на льду, вид сверху. Две равные противоположные силы приложены к её концам вдоль одной прямой; доска покоится">
				<rect class="trp-ice" x="0" y="0" width="240" height="202" rx="8"></rect>
				<path class="trp-scratch" d={ice}></path>
				<path class="rt-dash rt-s--f" d={`M2 ${C.y} H238`} opacity="0.55"></path>
				<rect class="rt-wood" x={C.x - LB / 2} y={C.y - 6} width={LB} height="12" rx="2"></rect>
				<circle class="rt-dot" cx={C.x} cy={C.y} r="2"></circle>
				<path class="rt-f--f" d={arrowPath(C.x - LB / 2, C.y, C.x - LB / 2 - FA, C.y, 3, 9)}></path>
				<path class="rt-f--f" d={arrowPath(C.x + LB / 2, C.y, C.x + LB / 2 + FA, C.y, 3, 9)}></path>
				<text class="rt-sym rt-t--f" data-rtv="0" x={C.x - LB / 2 - FA / 2} y={C.y - 12} text-anchor="middle">F<tspan class="rt-sub" dy="4">1</tspan></text>
				<text class="rt-sym rt-t--f" data-rtv="0" x={C.x + LB / 2 + FA / 2} y={C.y - 12} text-anchor="middle">F<tspan class="rt-sub" dy="4">2</tspan></text>
				<text class="rt-lab" x="8" y="194">вид сверху</text>
				<text class="rt-sym rt-t--ink" data-rtv="0,5" x="232" y="194" text-anchor="end">F<tspan class="rt-sub" dy="4">1</tspan><tspan dy="-4"> + </tspan>F<tspan class="rt-sub" dy="4">2</tspan><tspan dy="-4"> = 0</tspan></text>
			</svg>
			<figcaption>Силы действуют вдоль одной прямой: доска покоится.</figcaption>
		</figure>
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 240 202" role="img" aria-label="Та же доска; равные противоположные силы приложены к её концам перпендикулярно доске, на разных прямых; доска поворачивается вокруг середины" data-turn>
				<rect class="trp-ice" x="0" y="0" width="240" height="202" rx="8"></rect>
				<path class="trp-scratch" d={ice}></path>
				<g data-rot>
					<path class="rt-dash rt-s--f" d={`M${C.x - LB / 2 + 4} ${C.y - 36} V${C.y + 54} M${C.x + LB / 2 - 4} ${C.y - 54} V${C.y + 36}`} opacity="0.55"></path>
					<rect class="rt-wood" x={C.x - LB / 2} y={C.y - 6} width={LB} height="12" rx="2"></rect>
					<path class="rt-f--f" d={arrowPath(C.x - LB / 2 + 4, C.y + 6, C.x - LB / 2 + 4, C.y + 6 + FA, 3, 9)}></path>
					<path class="rt-f--f" d={arrowPath(C.x + LB / 2 - 4, C.y - 6, C.x + LB / 2 - 4, C.y - 6 - FA, 3, 9)}></path>
				</g>
				<circle class="rt-dot" cx={C.x} cy={C.y} r="2"></circle>
				<path class="trp-turn" data-turnarc></path>
				<path class="rt-f--ink" data-turnhead></path>
				<text class="rt-sym rt-t--f" data-rtv="0" data-l1>F<tspan class="rt-sub" dy="4">1</tspan></text>
				<text class="rt-sym rt-t--f" data-rtv="0" data-l2>F<tspan class="rt-sub" dy="4">2</tspan></text>
				<text class="rt-lab" x="8" y="194">вид сверху</text>
				<text class="rt-sym rt-t--ink" data-rtv="0,5" x="232" y="194" text-anchor="end">F<tspan class="rt-sub" dy="4">1</tspan><tspan dy="-4"> + </tspan>F<tspan class="rt-sub" dy="4">2</tspan><tspan dy="-4"> = 0</tspan></text>
			</svg>
			<figcaption>Силы действуют вдоль разных прямых: доска поворачивается вокруг середины.</figcaption>
		</figure>
	</div>
	<figcaption class="g7__caption">
		Доска длиной 1&nbsp;м и массой 2&nbsp;кг лежит на гладком льду; силы по 1&nbsp;Н. В обоих случаях сумма сил равна нулю и середина доски остаётся на месте, но во втором доска поворачивается. Поворот замедлен в 4&nbsp;раза.
	</figcaption>
</figure>

<style is:global>
	.g7__svg .trp-ice {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--g7-paper));
	}
	.g7__svg .trp-scratch {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 30%, var(--g7-paper));
		stroke-width: 1;
		stroke-linecap: round;
	}
	.g7__svg .trp-turn {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { vecArrows, vecArrow, arrowPath } from './rt';

	const LB = 140;
	const FA = 40;
	const C = { x: 120, y: 98 };
	const RUN = 2.9; // s, 90° (0,72 с slowed down 4 times)
	const CYCLE = 0.5 + RUN + 1.0 + 0.6;
	for (const root of document.querySelectorAll<HTMLElement>('[data-trp]')) {
		const svg = root.querySelector<SVGSVGElement>('[data-turn]')!;
		const rot = svg.querySelector<SVGGElement>('[data-rot]')!;
		const l1 = svg.querySelector<SVGTextElement>('[data-l1]')!;
		const l2 = svg.querySelector<SVGTextElement>('[data-l2]')!;
		const arc = svg.querySelector<SVGPathElement>('[data-turnarc]')!;
		const head = svg.querySelector<SVGPathElement>('[data-turnhead]')!;
		let t = 0;
		const draw = () => {
			const tt = Math.min(Math.max(0, t - 0.5), RUN);
			// constant moment: the angle grows as t² (counterclockwise on screen)
			const th = (Math.PI / 2) * (tt / RUN) ** 2;
			const fade = t > 0.5 + RUN + 1.0 ? 1 - (t - 0.5 - RUN - 1.0) / 0.6 : 1;
			rot.setAttribute('transform', `rotate(${((-th * 180) / Math.PI).toFixed(2)} ${C.x} ${C.y})`);
			rot.setAttribute('opacity', fade.toFixed(2));
			// the labels beside the middles of the arrows, on their outer side
			const c = Math.cos(th);
			const s = Math.sin(th);
			const P = (x: number, y: number) => ({ x: C.x + x * c + y * s, y: C.y - x * s + y * c });
			const a1 = P(-LB / 2 + 4 - 18, 6 + FA * 0.6);
			const a2 = P(LB / 2 - 4 + 18, -6 - FA * 0.6);
			l1.setAttribute('x', a1.x.toFixed(1));
			l1.setAttribute('y', (a1.y + 5).toFixed(1));
			l2.setAttribute('x', a2.x.toFixed(1));
			l2.setAttribute('y', (a2.y + 5).toFixed(1));
			for (const l of [l1, l2]) {
				l.setAttribute('text-anchor', 'middle');
				l.setAttribute('opacity', fade.toFixed(2));
				vecArrow(l);
			}
			// the sense of turning: a small arc round the middle
			const R = 30;
			// between the board and its turned position, so it never crosses the board
			const a0 = th + 0.35;
			const a1r = th + 1.25;
			arc.setAttribute('d', `M${(C.x + R * Math.cos(a0)).toFixed(1)} ${(C.y - R * Math.sin(a0)).toFixed(1)} A${R} ${R} 0 0 0 ${(C.x + R * Math.cos(a1r)).toFixed(1)} ${(C.y - R * Math.sin(a1r)).toFixed(1)}`);
			const hx = C.x + R * Math.cos(a1r);
			const hy = C.y - R * Math.sin(a1r);
			head.setAttribute('d', arrowPath(hx + 6 * Math.sin(a1r), hy + 6 * Math.cos(a1r), hx - 1 * Math.sin(a1r), hy - 1 * Math.cos(a1r), 1.5, 7));
			const on = t > 0.5 && fade > 0.3 ? '1' : '0';
			arc.setAttribute('opacity', on);
			head.setAttribute('opacity', on);
		};
		vecArrows(root);
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		})();
		draw();
		document.fonts?.ready.then(() => {
			vecArrows(root);
			draw();
		});
	}
</script>
