---
/**
 * «Мостик через канаву»: a plank 4 м long and of mass 20 кг lies across a ditch on two supports at its ends. A boy of
 * mass M (40…80 кг, drawn 165 см tall, people.ts) stands on it at a distance x (0,3…3,7 м) from the left support,
 * or walks across at 1 м/с (real time) with «Пройти» (the slider of x follows him). Forces on the plank: its weight mg at the middle (blue), the
 * boy's weight P = Mg at his feet (red), the forces of the supports N₁ and N₂ (violet). From the two conditions of
 * equilibrium: N₁ + N₂ = mg + Mg, and the moments about the left support N₂·L = mg·L/2 + Mg·x, so
 * N₂ = (mg/2 + Mg·x/L), N₁ = mg + Mg − N₂.
 *
 * Scales: 80 px per metre (the plank, the ditch, the boy); the forces 0,1 px per newton (Mg up to 784 Н — 78 px).
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const X0 = 40;
const PX = 80;
const Y = 152;
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--stack plk not-content" data-plk>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 262" role="img" aria-label="Мальчик стоит на доске, переброшенной через канаву. Показаны силы, действующие на доску" data-svg>
			<defs>
				{['b', 'r', 'v'].map((c) => (
					<marker id={`plk-${c}-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto">
						<path class={c === 'b' ? 'head--blue' : c === 'r' ? 'head--red' : 'plk__vhead'} d="M0,0 L10,5 L0,10 z"></path>
					</marker>
				))}
			</defs>
			<path class="plk__ground" d={`M0 ${Y + 6} H${X0 + 8} L${X0 + 30} 250 H${X0 + 4 * PX - 30} L${X0 + 4 * PX - 8} ${Y + 6} H400 V262 H0 Z`}></path>
			<path class="plk__water" d={`M${X0 + 22} 232 H${X0 + 4 * PX - 22} L${X0 + 4 * PX - 30} 250 H${X0 + 30} Z`}></path>
			<rect class="plk__plank" x={X0} y={Y} width={4 * PX} height="6" rx="1.5"></rect>
			<g data-boy></g>
			<line class="arrow plk__v" data-n1 marker-end={`url(#plk-v-${uid})`}></line>
			<line class="arrow plk__v" data-n2 marker-end={`url(#plk-v-${uid})`}></line>
			<line class="arrow arrow--blue" data-mg marker-end={`url(#plk-b-${uid})`}></line>
			<line class="arrow arrow--red" data-p marker-end={`url(#plk-r-${uid})`}></line>
			<text class="t-i t-halo plk__vt" data-ln1>N<tspan baseline-shift="sub" font-size="10">1</tspan></text>
			<text class="t-i t-halo plk__vt" data-ln2>N<tspan baseline-shift="sub" font-size="10">2</tspan></text>
			<text class="t-i t-blue t-halo" data-lmg>mg</text>
			<text class="t-i t-red t-halo" data-lp>P</text>
			<path class="ln" data-xdim></path>
			<text class="t-i t-halo" data-lx>x</text>
		</svg>
		<div class="g7__side plk__side">
			<label class="g7__slider">
				<span>Где стоит мальчик <i>x</i></span>
				<output data-ox></output>
				<input type="range" min="0.3" max="3.7" step="0.1" value="1" data-x aria-label="Расстояние от левой опоры, метры" />
			</label>
			<label class="g7__slider">
				<span>Масса мальчика <i>M</i></span>
				<output data-om></output>
				<input type="range" min="40" max="80" step="5" value="60" data-m aria-label="Масса мальчика, килограммы" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Пройти по доске</button>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Доска длиной 4&nbsp;м и массой 20&nbsp;кг. Всё в масштабе: 80&nbsp;px на метр, силы — 0,1&nbsp;px на ньютон, <i>g</i>&nbsp;=&nbsp;9,8&nbsp;м/с². Синяя стрелка — сила тяжести доски, красная — вес мальчика, фиолетовые — силы реакции опор.
	</figcaption>
</figure>

<style is:global>
	.plk__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.plk__side .g7__lines {
		grid-column: 1 / -1;
	}
	.plk__side .g7__btn--go {
		grid-column: 1 / -1;
		justify-self: start;
	}
	.g7__svg .plk__ground {
		fill: var(--g7-ground);
	}
	.g7__svg .plk__water {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 1;
	}
	.g7__svg .plk__plank {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
	}
	.g7__svg .plk__v {
		stroke: var(--g7-violet);
	}
	.g7__svg .plk__vhead {
		fill: var(--g7-violet);
	}
	.g7__svg .plk__vt {
		fill: var(--g7-violet);
	}
</style>

<script>
	import { fmtInt, fmtTrim, k, loop, tex } from '../g7/kit';
	import { gait, human } from '../mehanicheskaya-rabota/people';

	const g = 9.8;
	const X0 = 40;
	const PX = 80;
	const Y = 152;
	const KF = 0.1;
	const L = 4;
	const MP = 20; // the plank
	const HEAD = 7;
	for (const root of document.querySelectorAll<HTMLElement>('[data-plk]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const xIn = q<HTMLInputElement>('[data-x]');
		const mIn = q<HTMLInputElement>('[data-m]');
		const S = PX / 100;
		const H = 165;
		const u = S * H;
		const boy = human(q<SVGGElement>('[data-boy]'), { s: S, H, shirt: 'hm-green', hair: 'short', girth: 1 });
		const A = 7 * S;
		let walkX: number | null = null;
		const set = (e: Element, a: Record<string, number>) => {
			for (const [n, v] of Object.entries(a)) e.setAttribute(n, v.toFixed(1));
		};
		const up = (e: Element, x: number, yHead: number, len: number) => set(e, { x1: x, y1: yHead + len, x2: x, y2: yHead + Math.min(HEAD, len) * 0 + HEAD });
		const draw = () => {
			const x = walkX ?? Number(xIn.value);
			const M = Number(mIn.value);
			if (walkX !== null) xIn.value = (Math.round(x * 10) / 10).toFixed(1);
			q('[data-ox]').textContent = `${fmtTrim(Math.round(x * 10) / 10, 1)} м`;
			q('[data-om]').textContent = `${M} кг`;
			const px = X0 + x * PX;
			// the boy: standing, or walking when «Пройти» runs
			if (walkX !== null) {
				const ft = gait(x * PX, 0.32 * u, X0 + 0.3 * PX - 0.32 * u * 0.5, 0.03 * u);
				const sw = Math.sin(((x * PX) / (0.32 * u)) * (Math.PI / 2));
				boy({
					hip: { x: px, y: Y - 0.505 * u },
					lean: 0.04,
					ankles: [
						{ x: ft[0].x, y: Y - A - ft[0].up },
						{ x: ft[1].x, y: Y - A - ft[1].up },
					],
					feet: [0, 0],
					hands: [
						{ x: px + 0.07 * u * sw, y: Y - 0.43 * u },
						{ x: px - 0.07 * u * sw, y: Y - 0.43 * u },
					],
				});
			} else
				boy({
					hip: { x: px, y: Y - 0.505 * u },
					lean: 0,
					ankles: [
						{ x: px + 0.02 * u, y: Y - A },
						{ x: px - 0.04 * u, y: Y - A },
					],
					feet: [0, 0],
					hands: [
						{ x: px + 0.03 * u, y: Y - 0.43 * u },
						{ x: px - 0.02 * u, y: Y - 0.43 * u },
					],
				});
			const mg = MP * g;
			const P = M * g;
			const N2 = (mg * (L / 2) + P * x) / L;
			const N1 = mg + P - N2;
			// N: from below up to the plank's underside; weights: down from the plank's top
			up(q('[data-n1]'), X0 + 3, Y + 6, KF * N1);
			up(q('[data-n2]'), X0 + 4 * PX - 3, Y + 6, KF * N2);
			set(q('[data-mg]'), { x1: X0 + 2 * PX, y1: Y + 3, x2: X0 + 2 * PX, y2: Y + 3 + KF * mg - HEAD });
			set(q('[data-p]'), { x1: px, y1: Y + 3, x2: px, y2: Y + 3 + KF * P - HEAD });
			set(q('[data-ln1]'), { x: X0 + 8, y: Y + 6 + KF * N1 });
			set(q('[data-ln2]'), { x: X0 + 4 * PX - 26, y: Y + 6 + KF * N2 });
			set(q('[data-lmg]'), { x: X0 + 2 * PX + 5, y: Y + 3 + KF * mg + 2 });
			set(q('[data-lp]'), { x: px + 5, y: Y + 3 + KF * P });
			q('[data-xdim]').setAttribute('d', `M${X0} ${Y - 8} V${Y - 14} M${X0} ${Y - 11} H${px.toFixed(1)} M${px.toFixed(1)} ${Y - 8} V${Y - 14}`);
			set(q('[data-lx]'), { x: (X0 + px) / 2 - 3, y: Y - 15 });
			const t = (v: number) => tex(fmtInt(v));
			q('[data-lines]').innerHTML = [
				k(`N_1 + N_2 = mg + P = ${t(mg)} + ${t(P)} = ${t(mg + P)}~\\text{Н}`),
				k(`N_2 L = mg\\,\\tfrac{L}{2} + Px`),
				k(`N_1 \\approx ${t(N1)}~\\text{Н}, \\quad N_2 \\approx ${t(N2)}~\\text{Н}`),
			]
				.map((h, i) => `<li${i === 2 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
		};
		const wake = loop(root, (dt) => {
			if (walkX === null) return false;
			walkX += dt * 1;
			if (walkX >= 3.7) {
				xIn.value = '3.7';
				walkX = null;
			}
			draw();
			return walkX !== null;
		});
		q('[data-go]').addEventListener('click', () => {
			walkX = 0.3;
			wake();
		});
		for (const inp of [xIn, mIn])
			inp.addEventListener('input', () => {
				walkX = null;
				draw();
			});
		draw();
	}
</script>
