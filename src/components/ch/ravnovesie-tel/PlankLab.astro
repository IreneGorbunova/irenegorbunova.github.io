---
/**
 * «Мостик через канаву»: a plank 4 м long and of mass 20 кг lies across a ditch on two supports at its ends. A boy of
 * mass M (40…80 кг, drawn 165 см tall with the people kit) stands on it at a distance x (0,3…3,7 м) from the left
 * support, or walks across at 1 м/с (real time; steps of 0,35 of his height, the stance foot planted) with «Пройти по
 * доске» (the slider of x follows him). Forces on the plank: the force of gravity of the plank m·g⃗ at its middle
 * (blue), the boy's weight P⃗ = M·g⃗ at his feet (red), the forces of reaction of the supports N⃗₁ and N⃗₂ (violet). From the
 * two conditions of equilibrium: N₁ + N₂ = mg + Mg, and the moments about the left support N₂·L = mg·L/2 + Mg·x, so
 * N₂ = mg/2 + Mg·x/L, N₁ = mg + Mg − N₂. Checked: 60 кг at 1 м → N₁ 539 Н, N₂ 245 Н; at 2 м 392 / 392 Н; at 3,7 м
 * 142 / 642 Н; at 1 м 40 кг → N₂ 196 Н, 80 кг → 294 Н.
 *
 * Scales: 80 px per metre (the plank, the ditch, the boy); the forces 0,1 px per newton (Mg up to 784 Н — 78 px).
 */
import RtStyles from './RtStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
const X0 = 40;
const PX = 80;
const Y = 152;
---

<RtStyles />
<PeopleStyles />
<figure class="g7 g7--stack plk not-content" data-plk>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 262" role="img" aria-label="Мальчик стоит на доске, переброшенной через канаву. Показаны силы, действующие на доску" data-svg>
			<path class="plk__ground" d={`M0 ${Y + 6} H${X0 + 8} L${X0 + 30} 250 H${X0 + 4 * PX - 30} L${X0 + 4 * PX - 8} ${Y + 6} H400 V262 H0 Z`}></path>
			<path class="plk__water" d={`M${X0 + 22} 232 H${X0 + 4 * PX - 22} L${X0 + 4 * PX - 30} 250 H${X0 + 30} Z`}></path>
			<rect class="plk__plank" x={X0} y={Y} width={4 * PX} height="6" rx="1.5"></rect>
			<g data-boy></g>
			<path class="rt-f--n" data-n1></path>
			<path class="rt-f--n" data-n2></path>
			<path class="rt-f--grav" data-mg></path>
			<path class="rt-f--p" data-p></path>
			<text class="rt-sym rt-t--n" data-rtv="0" data-ln1>N<tspan class="rt-sub" dy="4">1</tspan></text>
			<text class="rt-sym rt-t--n" data-rtv="0" data-ln2>N<tspan class="rt-sub" dy="4">2</tspan></text>
			<text class="rt-sym rt-t--grav" data-rtv="1" data-lmg>mg</text>
			<text class="rt-sym rt-t--p" data-rtv="0" data-lp>P</text>
			<path class="ln" data-xdim></path>
			<text class="t-i t-halo" data-lx>x</text>
		</svg>
		<div class="g7__side plk__side">
			<label class="g7__slider">
				<span>Где стоит мальчик <i>x</i></span>
				<output data-ox></output>
				<input type="range" min="0.3" max="3.7" step="0.1" value="1" data-x aria-label="Расстояние от левой опоры, метры" />
			</label>
			<label class="g7__slider">
				<span>Масса мальчика <i>M</i></span>
				<output data-om></output>
				<input type="range" min="40" max="80" step="5" value="60" data-m aria-label="Масса мальчика, килограммы" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Пройти по доске</button>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Доска длиной 4&nbsp;м и массой 20&nbsp;кг. Всё в масштабе: 80&nbsp;px на метр, силы — 0,1&nbsp;px на ньютон, <i>g</i>&nbsp;=&nbsp;9,8&nbsp;м/с². Синяя стрелка — сила тяжести доски, красная — вес мальчика, фиолетовые — силы реакции опор.
	</figcaption>
</figure>

<style is:global>
	.plk__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.plk__side .g7__lines {
		grid-column: 1 / -1;
	}
	.plk__side .g7__btn--go {
		grid-column: 1 / -1;
		justify-self: start;
	}
	.g7__svg .plk__ground {
		fill: var(--g7-ground);
	}
	.g7__svg .plk__water {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 1;
	}
	.g7__svg .plk__plank {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
	}
</style>

<script>
	import { fmtInt, fmtTrim, k, loop, tex } from '../g7/kit';
	import { figure, walk, SKELETON, DEG, type Pt, type HandTarget } from '@components/people';
	import { arrowPath, place, along, rings, segOf, type Seg, type Box } from './rt';

	const g = 9.8;
	const X0 = 40;
	const PX = 80;
	const Y = 152;
	const KF = 0.1;
	const L = 4;
	const MP = 20; // the plank
	const VIEW: Box = { x0: 2, y0: 2, x1: 398, y1: 260 };
	for (const root of document.querySelectorAll<HTMLElement>('[data-plk]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const xIn = q<HTMLInputElement>('[data-x]');
		const mIn = q<HTMLInputElement>('[data-m]');
		const S = PX / 100;
		const H = 165;
		const u = S * H;
		const sk = SKELETON.teen;
		const legL = (sk.thigh + sk.shin) * u;
		const boy = figure(q<SVGGElement>('[data-boy]'), { s: S, H, age: 'teen', clothes: 'indoor', shirt: 'hm-green', hair: 'short', name: 'boy' });
		const AY = Y - 7 * S * (H / 172); // the ankles above the plank (trainers)
		const step = 0.35 * H * S;
		let walkX: number | null = null;
		// a hanging arm by angles (the kit's relaxed pose): the upper arm a little off the vertical, the elbow nearly straight
		const swing = (_s: Pt, a: number): HandTarget => ({ arm: [Math.PI / 2 - a, 6 * DEG + Math.max(0, a) * 0.6], pose: 'relaxed' });
		const draw = () => {
			const x = walkX ?? Number(xIn.value);
			const M = Number(mIn.value);
			if (walkX !== null) xIn.value = (Math.round(x * 10) / 10).toFixed(1);
			q('[data-ox]').textContent = `${fmtTrim(Math.round(x * 10) / 10, 1)} м`;
			q('[data-om]').textContent = `${M} кг`;
			const px = X0 + x * PX;
			// the boy: standing, or walking when «Пройти» runs
			if (walkX !== null) {
				const d = (x - 0.3) * PX;
				const w = walk(d, step, 0, 0.05 * u);
				const hip = { x: px, y: AY - legL * 0.93 + w.bob };
				const sh = boy.shoulders(hip, 0.04);
				boy.pose({
					hip,
					lean: 0.04,
					ankles: [
						{ x: X0 + 0.3 * PX + w.feet[0].x + step * 0.5, y: AY - w.feet[0].up },
						{ x: X0 + 0.3 * PX + w.feet[1].x + step * 0.5, y: AY - w.feet[1].up },
					],
					feet: [w.feet[0].toe, w.feet[1].toe],
					hands: [swing(sh[0], -18 * DEG * w.arm), swing(sh[1], 18 * DEG * w.arm)],
					planted: [w.feet[0].planted, w.feet[1].planted],
				});
			} else {
				const hip = { x: px, y: AY - Math.sqrt((0.997 * legL) ** 2 - (0.04 * u) ** 2) };
				const sh = boy.shoulders(hip, 0);
				boy.pose({
					hip,
					lean: 0,
					ankles: [
						{ x: px + 0.02 * u, y: AY },
						{ x: px - 0.04 * u, y: AY },
					],
					feet: [0, 0],
					hands: [swing(sh[0], -4 * DEG), swing(sh[1], 3 * DEG)],
					planted: [true, true],
				});
			}
			const mg = MP * g;
			const P = M * g;
			const N2 = (mg * (L / 2) + P * x) / L;
			const N1 = mg + P - N2;
			// N: from below up to the plank's underside; weights: down from the plank's top
			const xa = X0 + 4;
			const xb = X0 + 4 * PX - 4;
			const xm = X0 + 2 * PX;
			const yB = Y + 6;
			q('[data-n1]').setAttribute('d', arrowPath(xa, yB + KF * N1, xa, yB, 3, 9));
			q('[data-n2]').setAttribute('d', arrowPath(xb, yB + KF * N2, xb, yB, 3, 9));
			q('[data-mg]').setAttribute('d', arrowPath(xm, Y + 3, xm, Y + 3 + KF * mg, 3, 9));
			q('[data-p]').setAttribute('d', arrowPath(px, Y + 3, px, Y + 3 + KF * P, 3, 9));
			const segs: Seg[] = [
				segOf(xa, yB, xa, yB + KF * N1, 4),
				segOf(xb, yB, xb, yB + KF * N2, 4),
				segOf(xm, Y, xm, Y + 3 + KF * mg, 4),
				segOf(px, Y, px, Y + 3 + KF * P, 4),
				segOf(X0, Y + 3, X0 + 4 * PX, Y + 3, 4),
				segOf(X0 + 8, Y + 6, X0 + 30, 250, 1),
				segOf(X0 + 4 * PX - 8, Y + 6, X0 + 4 * PX - 30, 250, 1),
			];
			// the boy as a box, the dimension line x
			const boxes: Box[] = [{ x0: px - 0.12 * u, y0: Y - 1.02 * u, x1: px + 0.14 * u, y1: Y }];
			q('[data-xdim]').setAttribute('d', `M${X0} ${Y + 12} V${Y + 18} M${X0} ${Y + 15} H${px.toFixed(1)} M${px.toFixed(1)} ${Y + 12} V${Y + 18}`);
			segs.push(segOf(X0, Y + 15, px, Y + 15, 1.5));
			place(q('[data-lx]'), [
				{ x: (X0 + px) / 2 + 8, y: Y + 30, anchor: 'middle' },
				{ x: (X0 + px) / 2 - 10, y: Y + 30, anchor: 'middle' },
				{ x: (X0 + px) / 2 + 24, y: Y + 30, anchor: 'middle' },
				{ x: (X0 + px) / 2 - 26, y: Y + 30, anchor: 'middle' },
			], segs, boxes, VIEW);
			const sideOf = (x0: number, y0: number, len: number, dirs: number[]) =>
				dirs.flatMap((d) => [0.5, 0.75, 0.3, 0.95].map((f) => ({ x: x0 + d * 14, y: y0 + len * f + 5, anchor: 'middle' as const })));
			place(q('[data-ln1]'), [...sideOf(xa, yB, KF * N1, [1, -1]), ...rings(xa, yB + KF * N1, Math.PI / 2)], segs, boxes, VIEW);
			place(q('[data-ln2]'), [...sideOf(xb, yB, KF * N2, [-1, 1]), ...rings(xb, yB + KF * N2, Math.PI / 2)], segs, boxes, VIEW);
			place(q('[data-lmg]'), [...sideOf(xm, Y + 3, KF * mg, [1, -1]), ...rings(xm, Y + 3 + KF * mg, Math.PI / 2)], segs, boxes, VIEW);
			place(q('[data-lp]'), [...sideOf(px, Y + 3, KF * P, [1, -1]), ...along(px, Y + 3, px, Y + 3 + KF * P, 22), ...rings(px, Y + 3 + KF * P, Math.PI / 2)], segs, boxes, VIEW);
			const t = (v: number) => tex(fmtInt(v));
			q('[data-lines]').innerHTML = [
				k(`N_1 + N_2 = mg + P = ${t(mg)} + ${t(P)} = ${t(mg + P)}~\\text{Н}`),
				k(`N_2 L = mg\\,\\tfrac{L}{2} + Px`),
				k(`N_1 \\approx ${t(N1)}~\\text{Н}, \\quad N_2 \\approx ${t(N2)}~\\text{Н}`),
			]
				.map((h, i) => `<li${i === 2 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
		};
		const wake = loop(root, (dt) => {
			if (walkX === null) return false;
			walkX += dt * 1;
			if (walkX >= 3.7) {
				xIn.value = '3.7';
				walkX = null;
			}
			draw();
			return walkX !== null;
		});
		q('[data-go]').addEventListener('click', () => {
			walkX = 0.3;
			wake();
		});
		for (const inp of [xIn, mIn])
			inp.addEventListener('input', () => {
				walkX = null;
				draw();
			});
		draw();
		document.fonts?.ready.then(draw);
	}
</script>
