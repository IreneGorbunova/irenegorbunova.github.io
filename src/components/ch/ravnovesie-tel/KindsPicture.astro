---
/**
 * «Три вида равновесия»: a ball of radius 4 см rests at the bottom of a bowl (inner radius 34 см), on top of a dome
 * (radius 34 см) and on a level table. Every 5 с each ball gets the same small push, 0,25 м/с. The balls roll without
 * slipping: along an arc of radius R the center of the ball (on a circle of radius R ∓ r) moves as
 * θ'' = ∓ (5/7)·g·sin θ / (R ∓ r) — in the bowl the ball rocks and comes back to the bottom (a little rolling
 * resistance damps it), on the dome it rolls off faster and faster, on the table it rolls a little and stops in the
 * new place (rolling resistance 0,4 м/с² — exaggerated so that it stops in the frame).
 * Scale 2 px per сантиметр; real time. The dashed line is the path of the ball's center.
 */
import G7Styles from '../g7/G7Styles.astro';
const K = 2;
const R = 34 * K;
const r = 4 * K;
---

<G7Styles />
<figure class="g7 g7--pic knd not-content" data-knd>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 192" role="img" aria-label="Шарик в чаше возвращается на дно, шарик на куполе скатывается, шарик на столе остаётся на новом месте">
			<!-- the bowl: center of the arc at (70, 50) -->
			<path class="knd__solid" d={`M${70 - R} 50 A${R} ${R} 0 0 0 ${70 + R} 50 L${70 + R + 6} 50 L${70 + R + 6} 128 L${70 - R - 6} 128 L${70 - R - 6} 50 Z`}></path>
			<path class="ln-dash" d={`M${70 - (R - r) * Math.sin(0.6)} ${50 + (R - r) * Math.cos(0.6)} A${R - r} ${R - r} 0 0 0 ${70 + (R - r) * Math.sin(0.6)} ${50 + (R - r) * Math.cos(0.6)}`}></path>
			<!-- the dome: center at (200, 128) -->
			<path class="knd__solid" d={`M${200 - R} 128 A${R} ${R} 0 0 1 ${200 + R} 128 Z`}></path>
			<path class="ln-dash" d={`M${200 - (R + r) * Math.sin(0.6)} ${128 - (R + r) * Math.cos(0.6)} A${R + r} ${R + r} 0 0 1 ${200 + (R + r) * Math.sin(0.6)} ${128 - (R + r) * Math.cos(0.6)}`}></path>
			<!-- the table -->
			<rect class="knd__solid" x="282" y="110" width="110" height="18"></rect>
			<line class="ln-dash" x1="286" x2="388" y1={110 - r} y2={110 - r}></line>
			<line class="ink" x1="0" x2="400" y1="128" y2="128"></line>
			{[0, 1, 2].map((i) => <circle class="knd__ball" data-ball={i} r={r} />)}
			{[
				[70, 'устойчивое', 'шарик', 'возвращается'],
				[200, 'неустойчивое', 'шарик', 'скатывается'],
				[337, 'безразличное', 'остаётся', 'на новом месте'],
			].map(([x, a, b, c]) => (
				<>
					<text class="knd__title" x={x} y="152" text-anchor="middle">{a}</text>
					<text class="knd__note" x={x} y="170" text-anchor="middle">{b}</text>
					<text class="knd__note" x={x} y="186" text-anchor="middle">{c}</text>
				</>
			))}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Каждые 5&nbsp;секунд все три шарика получают одинаковый лёгкий толчок. Масштаб 2&nbsp;px на сантиметр, настоящее время; пунктир — путь центра шарика. На столе сопротивление качению преувеличено, чтобы шарик остановился в кадре.
	</figcaption>
</figure>

<style is:global>
	.g7__svg .knd__solid {
		fill: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-5));
		stroke: var(--g7-line);
	}
	.g7__svg .knd__title {
		fill: var(--g7-ink);
		font-size: 15px;
		font-weight: 600;
	}
	.g7__svg .knd__note {
		fill: var(--g7-ink);
		font-size: 13.5px;
	}
	.g7__svg .knd__ball {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const g = 9.8;
	const K = 2; // px per см
	const R = 0.34; // м
	const r = 0.04;
	const V0 = 0.25; // м/с, the push
	const C = 5 / 7; // rolling ball
	for (const root of document.querySelectorAll<HTMLElement>('[data-knd]')) {
		const balls = [0, 1, 2].map((i) => root.querySelector<SVGCircleElement>(`[data-ball="${i}"]`)!);
		let t = 0;
		let th1 = 0;
		let w1 = 0;
		let th2 = 0;
		let w2 = 0;
		let x3 = 0;
		let v3 = 0;
		let x3base = 0;
		const push = () => {
			w1 = V0 / (R - r);
			th2 = 0;
			w2 = V0 / (R + r);
			x3base = x3 > 0.3 ? 0 : x3;
			x3 = x3base;
			v3 = V0;
		};
		const place = () => {
			const px = (m: number) => m * 100 * K;
			balls[0].setAttribute('cx', (70 + px((R - r) * Math.sin(th1))).toFixed(1));
			balls[0].setAttribute('cy', (50 + px((R - r) * Math.cos(th1))).toFixed(1));
			// the dome: on it while θ < the angle where it leaves (≈ 54° for a rolling ball, cos θ = 10/17), then falls
			balls[1].setAttribute('cx', (200 + px((R + r) * Math.sin(th2))).toFixed(1));
			balls[1].setAttribute('cy', (128 - px((R + r) * Math.cos(th2))).toFixed(1));
			balls[1].style.visibility = th2 < 0.95 ? 'visible' : 'hidden';
			balls[2].setAttribute('cx', (300 + px(x3)).toFixed(1));
			balls[2].setAttribute('cy', String(110 - r * 100 * K));
		};
		loop(root, (dt) => {
			t += dt;
			if (t >= 5) t = 0;
			if (t < dt * 1.5 && t >= 0) {
				th1 = 0;
				th2 = 0;
				push();
			}
			const n = 10;
			for (let i = 0; i < n; i++) {
				const h = dt / n;
				w1 += (-(C * g * Math.sin(th1)) / (R - r) - 0.6 * w1) * h;
				th1 += w1 * h;
				if (th2 < 0.95) {
					w2 += ((C * g * Math.sin(th2)) / (R + r)) * h;
					th2 += w2 * h;
				}
				if (v3 > 0) {
					v3 = Math.max(0, v3 - 0.4 * h);
					x3 += v3 * h;
				}
			}
			place();
			return true;
		})();
		place();
	}
</script>
