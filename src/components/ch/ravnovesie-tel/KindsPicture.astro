---
/**
 * «Три вида равновесия»: three columns — stable, indifferent, unstable — in two rows; every 5 с every body gets the same
 * small push (at 0,5 с of the cycle). The center of gravity of every body is the quartered disc of the chapter.
 * Row 1 (2 px per см): a ball of radius 4 см at the bottom of a bowl (inner radius 34 см), on a level table and on top
 *   of a dome (radius 34 см); the push gives 0,25 м/с. The balls roll without slipping: along an arc of radius R the
 *   center of the ball (on a circle of radius R ∓ r) moves as θ'' = ∓ (5/7)·g·sin θ / (R ∓ r) — in the bowl the ball
 *   rocks and comes back to the bottom (a little rolling resistance damps it), on the table it rolls a little and stops
 *   in the new place (rolling resistance 0,4 м/с², exaggerated so that it stops in the frame; after 25 см it starts
 *   again from the left), on the dome it rolls off faster and faster and leaves the picture.
 * Row 2 (3,5 px per см): a ruler 30 см long on a nail through a hole: the hole 5 см above its center of gravity, at
 *   it, and 5 см below it (the ruler balanced upright). The push gives 1,5 рад/с. A physical pendulum:
 *   θ'' = −(g·a / (L²/12 + a²))·sin θ − c·θ' with a = 0,05 м, 0 and −0,05 м, c = 1,5 1/с (friction at the nail):
 *   with the hole above the center of gravity the ruler swings back (ω = 7 рад/с, a period of 0,9 с); with the hole at
 *   it the ruler turns by ω₀/c = 1 рад ≈ 57° and stays; with the hole below it the ruler falls, swings and comes to hang below
 *   the nail (stable again); it is set upright again at the start of the next cycle (a short fade).
 * Real time.
 */
import RtStyles from './RtStyles.astro';
const K = 2;
const R = 34 * K;
const r = 4 * K;
const COLS = [70, 200, 330];
const Y1 = 128; // the ground line of row 1
const PY = 220; // the nails of row 2
---

<RtStyles />
<figure class="g7 g7--pic knd not-content" data-knd>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 310" role="img" aria-label="Три вида равновесия. Шарик в чаше и линейка, подвешенная выше центра тяжести, возвращаются; шарик на столе и линейка, подвешенная за центр тяжести, остаются в новом положении; шарик на куполе скатывается, а линейка, поставленная над гвоздём, падает">
			{['устойчивое', 'безразличное', 'неустойчивое'].map((h, i) => <text class="rt-head" x={COLS[i]} y="18" text-anchor="middle">{h}</text>)}
			<!-- row 1: the bowl (center of the arc at (70, 50)) -->
			<path class="knd__solid" d={`M${70 - R} 50 A${R} ${R} 0 0 0 ${70 + R} 50 L${70 + R + 6} 50 L${70 + R + 6} ${Y1} L${70 - R - 6} ${Y1} L${70 - R - 6} 50 Z`}></path>
			<path class="ln-dash" d={`M${70 - (R - r) * Math.sin(0.6)} ${50 + (R - r) * Math.cos(0.6)} A${R - r} ${R - r} 0 0 0 ${70 + (R - r) * Math.sin(0.6)} ${50 + (R - r) * Math.cos(0.6)}`}></path>
			<!-- the table -->
			<rect class="knd__solid" x="145" y="110" width="110" height="18"></rect>
			<line class="ln-dash" x1="149" x2="251" y1={110 - r} y2={110 - r}></line>
			<!-- the dome: center at (330, 128) -->
			<path class="knd__solid" d={`M${330 - R} ${Y1} A${R} ${R} 0 0 1 ${330 + R} ${Y1} Z`}></path>
			<path class="ln-dash" d={`M${330 - (R + r) * Math.sin(0.6)} ${Y1 - (R + r) * Math.cos(0.6)} A${R + r} ${R + r} 0 0 1 ${330 + (R + r) * Math.sin(0.6)} ${Y1 - (R + r) * Math.cos(0.6)}`}></path>
			<line class="ink" x1="0" x2="400" y1={Y1} y2={Y1}></line>
			{[0, 1, 2].map((i) => (
				<g data-ball={i}>
					<circle class="knd__ball" r={r}></circle>
					<path class="rt-cg__d" d="M0 0 H3 A3 3 0 0 0 0 -3 Z M0 0 H-3 A3 3 0 0 0 0 3 Z"></path>
					<circle class="rt-cg__o" r="3"></circle>
				</g>
			))}
			<!-- row 2: rulers on nails -->
			<rect class="knd__board" x="8" y="140" width="384" height="164" rx="6"></rect>
			{[0, 1, 2].map((i) => (
				<g data-ruler={i}>
					<rect class="knd__ruler" data-body></rect>
					<path class="knd__ticks" data-ticks></path>
					<g data-cgm></g>
				</g>
			))}
			{COLS.map((x) => <circle class="knd__nail" cx={x} cy={PY} r="3.2"></circle>)}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Каждые 5&nbsp;секунд все тела получают одинаковый лёгкий толчок. Вверху шарики (2&nbsp;px на сантиметр), внизу линейки длиной 30&nbsp;см на гвозде (3,5&nbsp;px на сантиметр): гвоздь выше центра тяжести, в центре тяжести и ниже него. Настоящее время; пунктир — путь центра шарика. На столе сопротивление качению преувеличено, чтобы шарик остановился в кадре.
	</figcaption>
</figure>

<style is:global>
	.g7__svg .knd__solid {
		fill: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-5));
		stroke: var(--g7-line);
	}
	.g7__svg .knd__sep {
		stroke: var(--g7-faint);
		stroke-width: 1;
		stroke-dasharray: 2 4;
	}
	.g7__svg .knd__ball {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .knd__ball + .rt-cg__d {
		fill: var(--g7-ink);
	}
	.g7__svg .knd__board {
		fill: color-mix(in oklab, var(--ig-v) 10%, var(--g7-paper));
	}
	.g7__svg .knd__ruler {
		fill: hsl(48, 80%, 70%);
		stroke: hsl(40, 50%, 40%);
		stroke-width: 1;
	}
	.g7__svg .knd__ticks {
		stroke: hsl(40, 50%, 30%);
		stroke-width: 0.8;
	}
	.g7__svg .knd__nail {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { cgMark } from './rt';

	const g = 9.8;
	const K = 2; // px per см
	const R = 0.34; // м
	const r = 0.04;
	const V0 = 0.25; // м/с, the push
	const C = 5 / 7; // rolling ball
	const COLS = [70, 200, 330];
	const Y1 = 128;
	const PY = 220;
	const KR = 3.5; // px per см, the rulers
	const LR = 0.3; // м
	const WR = 3; // см
	const A = [0.05, 0, -0.05]; // the center of gravity below the nail, м
	const W0 = 1.5; // рад/с, the push
	const CF = 1.5; // 1/с, friction at the nail
	for (const root of document.querySelectorAll<HTMLElement>('[data-knd]')) {
		const balls = [0, 1, 2].map((i) => root.querySelector<SVGGElement>(`[data-ball="${i}"]`)!);
		const rulers = [0, 1, 2].map((i) => root.querySelector<SVGGElement>(`[data-ruler="${i}"]`)!);
		// the rulers' shapes in their own frame: the nail at (0, 0), the center of gravity at (0, a)
		rulers.forEach((gr, i) => {
			const a = A[i] * 100 * KR;
			const top = a - (LR * 100 * KR) / 2;
			const body = gr.querySelector('[data-body]')!;
			body.setAttribute('x', String((-WR * KR) / 2));
			body.setAttribute('y', top.toFixed(1));
			body.setAttribute('width', String(WR * KR));
			body.setAttribute('height', String(LR * 100 * KR));
			body.setAttribute('rx', '1.5');
			let ticks = '';
			for (let c = 1; c < 30; c++) ticks += `M${((-WR * KR) / 2).toFixed(1)} ${(top + c * KR).toFixed(1)} h${c % 5 ? 2.5 : 4.5} `;
			gr.querySelector('[data-ticks]')!.setAttribute('d', ticks);
			gr.querySelector('[data-cgm]')!.innerHTML = cgMark(0, a, 4);
		});
		let t = 0;
		let th1 = 0;
		let w1 = 0;
		let th3 = 0;
		let w3 = 0;
		let x2 = 0;
		let v2 = 0;
		const rt = [0, 0, 0];
		const rw = [0, 0, 0];
		let pushed = false;
		const push = () => {
			w1 = V0 / (R - r);
			th3 = 0;
			w3 = V0 / (R + r);
			if (x2 > 0.25) x2 = 0;
			v2 = V0;
			for (let i = 0; i < 3; i++) rw[i] = W0;
		};
		const show = () => {
			const px = (m: number) => m * 100 * K;
			const at = (gEl: SVGGElement, x: number, y: number) => gEl.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
			at(balls[0], COLS[0] + px((R - r) * Math.sin(th1)), 50 + px((R - r) * Math.cos(th1)));
			at(balls[1], 170 + px(x2), 110 - r * 100 * K);
			// the dome: on it while θ < 0,95 rad, then gone
			at(balls[2], COLS[2] + px((R + r) * Math.sin(th3)), Y1 - px((R + r) * Math.cos(th3)));
			balls[2].style.visibility = th3 < 0.95 ? 'visible' : 'hidden';
			rulers.forEach((gr, i) => {
				gr.setAttribute('transform', `translate(${COLS[i]} ${PY}) rotate(${((rt[i] * 180) / Math.PI).toFixed(2)})`);
			});
			// the upright ruler fades out at the end of the cycle and in at its start
			const op = t > 4.7 ? Math.max(0, (5 - t) / 0.3) : t < 0.3 ? t / 0.3 : 1;
			rulers[2].setAttribute('opacity', op.toFixed(2));
		};
		loop(root, (dt) => {
			t += dt;
			if (t >= 5) {
				t -= 5;
				pushed = false;
				th1 = 0;
				w1 = 0;
				rt[0] = 0;
				rw[0] = 0;
				rt[2] = 0;
				rw[2] = 0;
			}
			if (!pushed && t >= 0.5) {
				pushed = true;
				push();
			}
			const n = 10;
			for (let k = 0; k < n; k++) {
				const h = dt / n;
				w1 += (-(C * g * Math.sin(th1)) / (R - r) - 0.6 * w1) * h;
				th1 += w1 * h;
				if (pushed && th3 < 0.95) {
					w3 += ((C * g * Math.sin(th3)) / (R + r)) * h;
					th3 += w3 * h;
				}
				if (v2 > 0) {
					v2 = Math.max(0, v2 - 0.4 * h);
					x2 += v2 * h;
				}
				for (let i = 0; i < 3; i++) {
					const a = A[i];
					const w2 = (g * a) / (LR * LR / 12 + a * a);
					rw[i] += (-w2 * Math.sin(rt[i]) - CF * rw[i]) * h;
					rt[i] += rw[i] * h;
				}
			}
			show();
			return true;
		})();
		show();
	}
</script>
