---
/**
 * «Центр тяжести фанерной фигуры»: an L-shaped plate of plywood (60 × 55 см: a leg 30 × 55 см and a foot 30 × 15 см)
 * with three small holes is hung on a nail by one of them. It swings and comes to rest so that its center of gravity
 * is right below the nail (the line through the nail and the center of gravity is vertical): the angle of rest is
 * computed from the plate's center of gravity, (21,4; 31,8) см from the top left corner (the two rectangles'
 * centers weighted by their areas, 1650 and 450 см²). The swing is shown as a damped oscillation about this angle
 * (period about 1,6 с, simplified). A plumb line hangs from the nail; when the plate is at rest the line is drawn on
 * the plate in pencil and stays on it. Two lines cross at the center of gravity; the third goes through the same
 * point. Scale 2,2 px per сантиметр. A faint grid of 5 см squares is drawn on the plate (every 10 см a little
 * darker) so that the place of the center of gravity can be read off: when two lines have crossed, the message also
 * gives it, 21 см from the left edge and 32 см from the top. The pencil lines are clipped to the plate.
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const K = 2.2;
const PLATE = 'M0 0 H66 V88 H132 V121 H0 Z';
// grid lines every 5 см: { d, ten } with ten = true on the lines at 10, 20, … см
const grid = [
	...Array.from({ length: 11 }, (_, i) => ({ d: `M${(5 * (i + 1) * K).toFixed(1)} 0 V${(55 * K).toFixed(1)}`, ten: i % 2 === 1 })),
	...Array.from({ length: 10 }, (_, i) => ({ d: `M0 ${(5 * (i + 1) * K).toFixed(1)} H${(60 * K).toFixed(1)}`, ten: i % 2 === 1 })),
];
---

<G7Styles />
<figure class="g7 g7--stack hng not-content" data-hng>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 230" role="img" aria-label="Фанерная фигура висит на гвозде; отвес показывает вертикаль через точку подвеса" data-svg>
			<rect class="hng__board" x="150" y="0" width="100" height="18"></rect>
			<defs>
				<clipPath id={`hng-clip-${uid}`}><path d={PLATE}></path></clipPath>
			</defs>
			<g data-plate>
				<path class="hng__plate" d={PLATE}></path>
				<g clip-path={`url(#hng-clip-${uid})`}>
					{grid.map((l) => <path class={l.ten ? 'hng__grid hng__grid--ten' : 'hng__grid'} d={l.d}></path>)}
					<g data-lines></g>
				</g>
				<circle class="hng__cg" data-cg r="4"></circle>
				{[0, 1, 2].map((i) => <circle class="hng__hole" data-hole={i} r="3.2" />)}
				{[0, 1, 2].map((i) => <text class="t-small hng__num" data-hnum={i} text-anchor="middle">{i + 1}</text>)}
			</g>
			<line class="hng__thread" data-thread></line>
			<circle class="hng__bob" data-bob r="4"></circle>
			<circle class="hng__nail" cx="200" cy="22" r="3"></circle>
		</svg>
		<div class="g7__side hng__side">
			<div class="g7__seg" role="group" aria-label="За какое отверстие подвесить" data-pick>
				<button type="button" class="g7__btn" aria-pressed="true" data-h="0">Отверстие 1</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-h="1">Отверстие 2</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-h="2">Отверстие 3</button>
			</div>
			<button type="button" class="g7__btn" data-reset>Стереть линии</button>
			<p class="g7__msg hng__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Фигура из фанеры 60&nbsp;×&nbsp;55&nbsp;см, масштаб 2,2&nbsp;px на сантиметр, клетки на фигуре — по 5&nbsp;см. Нить с грузиком — отвес. Качания упрощены и замедлены.
	</figcaption>
</figure>

<style is:global>
	.hng__side {
		grid-template-columns: auto auto;
		justify-content: start;
		align-items: center;
	}
	.hng__msg {
		grid-column: 1 / -1;
	}
	.g7__svg .hng__board {
		fill: var(--g7-wood-dark);
	}
	.g7__svg .hng__plate {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.g7__svg .hng__hole {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.g7__svg .hng__num {
		fill: var(--g7-ink);
		font-weight: 700;
	}
	.g7__svg .hng__grid {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.5;
		opacity: 0.18;
	}
	.g7__svg .hng__grid--ten {
		opacity: 0.38;
	}
	.g7__svg .hng__pencil {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-dasharray: 5 3;
	}
	.g7__svg .hng__cg {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	.g7__svg .hng__thread {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .hng__bob {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
	}
	.g7__svg .hng__nail {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
	}
</style>

<script>
	import { el, loop, segment } from '../g7/kit';

	const K = 2.2; // px per см
	const NX = 200;
	const NY = 22;
	// the plate in см: the leg 30 × 55, the foot 30 × 15 at the bottom right; its center of gravity
	const CG = { x: (1650 * 15 + 450 * 45) / 2100, y: (1650 * 27.5 + 450 * 47.5) / 2100 };
	const HOLES = [
		{ x: 4, y: 4 },
		{ x: 56, y: 44 },
		{ x: 26, y: 4 },
	];
	for (const root of document.querySelectorAll<HTMLElement>('[data-hng]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const plate = q<SVGGElement>('[data-plate]');
		const lines = q<SVGGElement>('[data-lines]');
		const cg = q<SVGCircleElement>('[data-cg]');
		const thread = q<SVGLineElement>('[data-thread]');
		const bob = q<SVGCircleElement>('[data-bob]');
		const msg = q<HTMLParagraphElement>('[data-msg]');
		HOLES.forEach((h, i) => {
			const c = q(`[data-hole="${i}"]`);
			c.setAttribute('cx', String(h.x * K));
			c.setAttribute('cy', String(h.y * K));
			const t = q(`[data-hnum="${i}"]`);
			t.setAttribute('x', String(h.x * K + (h.x > 30 ? -9 : 9)));
			t.setAttribute('y', String(h.y * K + 12));
		});
		cg.setAttribute('cx', String(CG.x * K));
		cg.setAttribute('cy', String(CG.y * K));
		let hole = 0;
		let phi = 0; // rad, the plate's turn (clockwise on screen)
		let from = 0;
		let target = 0;
		let t = 0;
		let drawn = new Set<number>();
		const rest = (i: number) => {
			// turn the plate so that the vector hole → CG points straight down
			const dx = CG.x - HOLES[i].x;
			const dy = CG.y - HOLES[i].y;
			return Math.atan2(dx, dy); // clockwise turn that brings (dx, dy) to (0, +)
		};
		const place = () => {
			const h = HOLES[hole];
			const deg = (phi * 180) / Math.PI;
			plate.setAttribute('transform', `translate(${NX} ${NY}) rotate(${deg.toFixed(2)}) translate(${-h.x * K} ${-h.y * K})`);
			// the plumb line from the nail, 150 px
			thread.setAttribute('x1', String(NX));
			thread.setAttribute('y1', String(NY));
			thread.setAttribute('x2', String(NX));
			thread.setAttribute('y2', String(NY + 186));
			bob.setAttribute('cx', String(NX));
			bob.setAttribute('cy', String(NY + 190));
			cg.style.visibility = drawn.size >= 2 ? 'visible' : 'hidden';
			msg.textContent = drawn.size >= 2 ? `Линии пересеклись в центре тяжести (красная точка): ${Math.round(CG.x)}\u00a0см от левого края, ${Math.round(CG.y)}\u00a0см от верхнего.` : drawn.size === 1 ? 'Линия отвеса проведена. Подвесьте фигуру за другое отверстие.' : 'Фигура качается и успокаивается.';
		};
		const pencil = (i: number) => {
			if (drawn.has(i)) return;
			drawn.add(i);
			const h = HOLES[i];
			const dx = CG.x - h.x;
			const dy = CG.y - h.y;
			const d = Math.hypot(dx, dy);
			const L = 90; // см, long enough to cross the plate
			lines.append(el('line', { class: 'hng__pencil', x1: h.x * K, y1: h.y * K, x2: (h.x + (dx / d) * L) * K, y2: (h.y + (dy / d) * L) * K }));
		};
		const wake = loop(root, (dt) => {
			t += dt;
			phi = target + (from - target) * Math.exp(-t / 0.9) * Math.cos((2 * Math.PI * t) / 1.6);
			const done = t > 5;
			if (done) {
				phi = target;
				pencil(hole);
			}
			place();
			return !done;
		});
		const hang = (i: number) => {
			// keep the plate where it is on screen: it is taken off the nail and hung again by another hole
			hole = i;
			target = rest(i);
			from = target + (i === 0 ? 0.9 : -0.9);
			phi = from;
			t = 0;
			place();
			wake();
		};
		segment(q('[data-pick]'), (b) => hang(Number(b.dataset.h)));
		q('[data-reset]').addEventListener('click', () => {
			lines.replaceChildren();
			drawn = new Set();
			hang(hole);
		});
		hang(0);
	}
</script>
