---
/**
 * Two short looping opening scenes of «Равновесие тел». No terms of the chapter in the pictures.
 *
 * Chair: 80 px per metre. A man (175 см, people.ts) sits on a chair (seat 45 см high, 42 см deep). To stand up he
 *   first leans forward (the body from 0,05 to 0,8 rad in 1,2 с), so that his upper body comes over his feet, and only
 *   then rises; standing, his hips are right above his ankles. His feet do not move. Real time, 5,5 с.
 * Toy: 100 px per metre. A girl (110 см) stands at a low table (50 см) with a roly-poly toy 30 см tall: a heavy
 *   hemisphere of radius 12 см below, a lighter head above. Its center of gravity is 3 см below the center of the
 *   hemisphere, so when tilted it rolls back. The girl tips it by 35° with her finger and lets go; the toy rolls on
 *   the table without slipping (its center moves by Rθ) and rocks as θ = 35°·e^(−t/1,3 с)·cos(ωt), ω = 7,7 рад/с: a
 *   period of 0,8 с, as for a toy of this size (ω² = mga/I, a = 3 см, I about the point of contact ≈ m·0,005 м²); the
 *   damping time 1,3 с is chosen to look like a real toy. Real time, 5 с.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';
---

<PeopleStyles />
<IntroFrame data-rtintro>
	<div class="intro__card" data-scene="chair">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мужчина сидит на стуле. Чтобы встать, он сначала наклоняется вперёд, а потом поднимается">
			<rect class="rt-wall" x="0" y="0" width="360" height="222"></rect>
			<rect class="rt-window" x="232" y="34" width="86" height="104" rx="3"></rect>
			<path class="rt-frame" d="M275 34 V138 M232 86 H318"></path>
			<rect class="rt-sill" x="226" y="138" width="98" height="6" rx="2"></rect>
			<rect class="rt-floor" x="0" y="222" width="360" height="18"></rect>
			<rect class="rt-skirt" x="0" y="216" width="360" height="6"></rect>
			<!-- a picture on the wall -->
			<rect class="rt-pic" x="40" y="44" width="56" height="40" rx="2"></rect>
			<path class="rt-pic-art" d="M44 80 L60 62 L70 72 L80 58 L92 80 Z"></path>
			<g data-chair>
				<!-- the chair: seat 45 см high, 42 см deep, back to 90 см; 80 px per metre -->
				<rect class="rt-chair" x="82" y={222 - 0.45 * 80 - 3} width={0.42 * 80} height="5" rx="1.5"></rect>
				<rect class="rt-chair" x="80" y={222 - 0.9 * 80} width="4" height={0.9 * 80}></rect>
				<rect class="rt-chair" x={82 + 0.42 * 80 - 4} y={222 - 0.45 * 80} width="3.5" height={0.45 * 80}></rect>
				<rect class="rt-chair" x="80" y={222 - 0.9 * 80 + 4} width="12" height="18" rx="2"></rect>
			</g>
			<g data-man></g>
		</svg>
		<div class="intro__foot">
			<p>
				Чтобы встать со стула, мы сначала{' '}
				<More term="наклоняемся вперёд">
					Пока человек сидит, его вес приходится на сиденье. Чтобы встать, нужно, чтобы вертикаль, проведённая через центр тяжести тела, прошла через ступни — иначе человек опрокинется обратно на стул. Попробуйте встать, держа спину прямо и не подвигая ноги под стул: не получится. Об этом — в разделе{' '}
					<a href="#устойчивость-тел-на-опоре">«Устойчивость тел на опоре»</a>.
				</More>{' '}и только потом поднимаемся.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="toy">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка наклоняет пальцем игрушку-неваляшку и отпускает. Неваляшка качается и встаёт прямо">
			<rect class="rt-wall" x="0" y="0" width="360" height="222"></rect>
			<rect class="rt-floor" x="0" y="222" width="360" height="18"></rect>
			<rect class="rt-skirt" x="0" y="216" width="360" height="6"></rect>
			<!-- a shelf with books -->
			<rect class="rt-shelf" x="236" y="64" width="104" height="5"></rect>
			<g class="rt-books">
				<rect x="242" y="38" width="9" height="26"></rect>
				<rect x="252" y="42" width="7" height="22"></rect>
				<rect x="260" y="36" width="10" height="28"></rect>
				<rect x="272" y="44" width="8" height="20"></rect>
				<rect x="300" y="40" width="22" height="24" rx="11"></rect>
			</g>
			<!-- the low table: 50 см, 100 px per metre -->
			<rect class="rt-table" x="150" y="172" width="150" height="6" rx="2"></rect>
			<rect class="rt-table" x="158" y="178" width="6" height="44"></rect>
			<rect class="rt-table" x="286" y="178" width="6" height="44"></rect>
			<g data-toy>
				<!-- local: the center of the lower hemisphere at (0, 0), 1 px per см; R = 12 -->
				<path class="rt-toy" d="M-12 0 A12 12 0 0 0 12 0 C12 -8 8 -12 6 -14 L-6 -14 C-8 -12 -12 -8 -12 0 Z"></path>
				<circle class="rt-toy" cx="0" cy="-20" r="8"></circle>
				<circle class="rt-face" cx="0" cy="-19.5" r="5.6"></circle>
				<circle class="rt-eye" cx="-2" cy="-20.5" r="0.8"></circle>
				<circle class="rt-eye" cx="2" cy="-20.5" r="0.8"></circle>
				<circle class="rt-blush" cx="-3.2" cy="-18" r="1.2"></circle>
				<circle class="rt-blush" cx="3.2" cy="-18" r="1.2"></circle>
				<path class="rt-mouth" d="M-1.4 -17.2 Q0 -16.2 1.4 -17.2"></path>
				<path class="rt-flower" d="M-4 -4 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 M3 1 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0"></path>
			</g>
			<g data-girl></g>
		</svg>
		<div class="intro__foot">
			<p>
				Неваляшку можно наклонить, но,{' '}
				<More term="если её отпустить, она снова встанет">
					Внизу у неваляшки тяжёлый груз, поэтому её центр тяжести лежит очень низко. Когда игрушку наклоняют, центр тяжести поднимается, и сила тяжести возвращает её обратно — так устроено устойчивое равновесие. Об этом — в разделе{' '}
					<a href="#виды-равновесия">«Виды равновесия»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-rtintro] .rt-wall {
		fill: color-mix(in oklab, var(--ig-v) 8%, var(--sl-color-bg));
	}
	[data-rtintro] .rt-floor {
		fill: color-mix(in oklab, var(--ig-v) 34%, var(--sl-color-gray-5));
	}
	[data-rtintro] .rt-skirt {
		fill: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-gray-4));
	}
	[data-rtintro] .rt-window {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	[data-rtintro] .rt-frame {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-rtintro] .rt-sill {
		fill: var(--sl-color-gray-3);
	}
	[data-rtintro] .rt-pic {
		fill: var(--sl-color-gray-6);
		stroke: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-3));
		stroke-width: 3;
	}
	[data-rtintro] .rt-pic-art {
		fill: hsl(150, 35%, 42%);
	}
	[data-rtintro] .rt-chair {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-rtintro] .rt-table,
	[data-rtintro] .rt-shelf {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-rtintro] .rt-books rect:nth-child(odd) {
		fill: var(--ig-vx);
	}
	[data-rtintro] .rt-books rect:nth-child(even) {
		fill: hsl(150, 40%, 45%);
	}
	[data-rtintro] .rt-books rect:last-child {
		fill: var(--ig-v);
	}
	[data-rtintro] .rt-toy {
		fill: hsl(355, 75%, 55%);
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	[data-rtintro] .rt-face {
		fill: hsl(30, 60%, 88%);
	}
	[data-rtintro] .rt-eye {
		fill: var(--hm-line);
	}
	[data-rtintro] .rt-blush {
		fill: hsl(355, 80%, 70%);
	}
	[data-rtintro] .rt-mouth {
		fill: none;
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-rtintro] .rt-flower {
		fill: hsl(50, 95%, 70%);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { human, type HumanPose } from '../mehanicheskaya-rabota/people';
	import { blendShape, handShape } from '@components/people';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const mix = (a: number, b: number, u: number) => a + (b - a) * u;

	for (const root of document.querySelectorAll<HTMLElement>('[data-rtintro]')) {
		// ---- standing up from a chair ----
		{
			const card = root.querySelector<HTMLElement>('[data-scene="chair"]')!;
			const K = 80; // px per metre
			const FL = 222;
			const S = K / 100;
			const H = 175;
			const u = S * H;
			const man = human(card.querySelector<SVGGElement>('[data-man]')!, { s: S, H, shirt: 'hm-blue', hair: 'short' });
			const A = 7 * S; // the ankle above the floor
			const XS = 82 + 0.2 * K; // the hip joint above the middle of the seat
			const XF = XS + 0.46 * K; // the ankles
			const seatHip = FL - 0.45 * K - 0.08 * K;
			scene(card, 5.5, (x) => {
				const t = x * 5.5;
				// 0–1 с sitting, 1–2,2 с leaning forward, 2,2–3,6 с rising, then standing
				const lean1 = ease((t - 1) / 1.2);
				const rise = ease((t - 2.2) / 1.4);
				const lean = mix(mix(0.05, 0.8, lean1), 0.03, rise);
				const hip = { x: mix(XS, XF - 0.02 * K, rise), y: mix(seatHip, FL - 0.505 * u, rise) };
				// the hands rest on the thighs, then hang down
				const knee = { x: XF - 0.02 * K, y: FL - 0.5 * K };
				const handSit = { x: mix(hip.x, knee.x, 0.6), y: mix(hip.y, knee.y, 0.6) - 0.04 * K };
				const handStand = { x: hip.x + 0.02 * u, y: FL - 0.43 * u };
				const hand = { x: mix(handSit.x, handStand.x, rise), y: mix(handSit.y, handStand.y, rise) };
				const pose: HumanPose = {
					hip,
					lean,
					ankles: [
						{ x: XF, y: FL - A },
						{ x: XF - 0.06 * K, y: FL - A },
					],
					feet: [0, 0],
					hands: [hand, { x: hand.x - 0.03 * K, y: hand.y }],
					head: mix(0, -0.15, lean1) * (1 - rise),
				};
				man(pose);
			});
		}
		// ---- the roly-poly toy ----
		{
			const card = root.querySelector<HTMLElement>('[data-scene="toy"]')!;
			const K = 100;
			const FL = 222;
			const S = K / 100;
			const H = 110;
			const u = S * H;
			const TOP = 172; // the table top
			const R = 12;
			const X0 = 205; // the toy's center when upright
			const toy = card.querySelector<SVGGElement>('[data-toy]')!;
			const girl = human(card.querySelector<SVGGElement>('[data-girl]')!, { s: S, H, shirt: 'hm-gold', hair: 'pony' });
			const A = 7 * S * (110 / 172);
			const GX = 168; // the girl's hips
			const TH0 = (35 * Math.PI) / 180;
			const RELAXED = handShape('relaxed');
			const POINT = handShape('point');
			const W = 7.7;
			const TAU = 1.3;
			// the point of the head where the finger touches, for a tilt th (the toy leans to the right, away from her)
			const headLeft = (th: number) => {
				const cx = X0 + R * th;
				const cy = TOP - R;
				const lx = -8;
				const ly = -20;
				return { x: cx + lx * Math.cos(th) - ly * Math.sin(th), y: cy + lx * Math.sin(th) + ly * Math.cos(th) };
			};
			scene(card, 5, (x) => {
				const t = x * 5;
				// 0–0,6 с the hand reaches, 0,6–1,2 с it tips the toy to 35°, then lets go
				let th = 0;
				if (t > 0.6 && t <= 1.2) th = TH0 * ease((t - 0.6) / 0.6);
				else if (t > 1.2) {
					const tt = t - 1.2;
					th = TH0 * Math.exp(-tt / TAU) * Math.cos(W * tt);
				}
				toy.setAttribute('transform', `translate(${(X0 + R * th).toFixed(2)} ${TOP - R}) rotate(${((th * 180) / Math.PI).toFixed(1)})`);
				// the finger: on the head while pushing, then drawn back
				const rest = { x: GX + 0.06 * u, y: FL - 0.43 * u };
				let hand = rest;
				const touch = headLeft(th);
				if (t <= 0.6) {
					const p = headLeft(0);
					const e = ease(t / 0.6);
					hand = { x: mix(rest.x, p.x - 2, e), y: mix(rest.y, p.y, e) };
				} else if (t <= 1.2) hand = { x: touch.x - 2, y: touch.y };
				else {
					const e = ease((t - 1.2) / 0.6);
					const p = headLeft(TH0);
					hand = { x: mix(p.x - 2, rest.x, e), y: mix(p.y, rest.y, e) };
				}
				girl({
					hip: { x: GX, y: FL - 0.505 * u },
					lean: 0.2,
					ankles: [
						{ x: GX + 0.03 * u, y: FL - A },
						{ x: GX - 0.04 * u, y: FL - A },
					],
					feet: [0, 0],
					hands: [hand, { x: GX - 0.02 * u, y: FL - 0.44 * u }],
					// the index finger comes out on the way to the toy and curls back on the way home (the tip is the target)
					grips: [{ pose: 'point', shape: blendShape(RELAXED, POINT, ease(t / 0.4) * (1 - ease((t - 1.3) / 0.5))) }, null],
					head: 0.25,
				});
			});
		}
	}
</script>
