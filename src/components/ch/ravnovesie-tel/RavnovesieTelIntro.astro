		fill: hsl(48, 90%, 62%);
	}
	[data-rtintro] .rt-face {
		fill: hsl(30, 60%, 88%);
	}
	[data-rtintro] .rt-eye {
		fill: var(--hm-line);
	}
	[data-rtintro] .rt-blush {
		fill: hsl(355, 80%, 70%);
	}
	[data-rtintro] .rt-mouth {
		fill: none;
