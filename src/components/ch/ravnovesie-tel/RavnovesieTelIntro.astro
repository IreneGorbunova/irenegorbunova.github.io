		fill: hsl(50, 95%, 70%);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, ik, blendShape, handShape, KNEE, SKELETON, type Pt, type HandTarget } from '@components/people';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const mix = (a: number, b: number, u: number) => a + (b - a) * u;
	const mixPt = (a: Pt, b: Pt, u: number): Pt => ({ x: mix(a.x, b.x, u), y: mix(a.y, b.y, u) });

	for (const root of document.querySelectorAll<HTMLElement>('[data-rtintro]')) {
		// ---- standing up from a chair ----
		{
			const card = root.querySelector<HTMLElement>('[data-scene="chair"]')!;
			const K = 80; // px per metre
			const FL = 226;
			const S = K / 100; // px per см
			const H = 175;
			const u = S * H;
			const sk = SKELETON.adult;
			const man = figure(card.querySelector<SVGGElement>('[data-man]')!, { s: S, H, clothes: 'home', shirt: 'hm-blue', hair: 'short', name: 'man' });
			const AY = FL - 7.5 * S; // the ankles (low shoes)
			const XS = 80 + 0.2 * K; // the hip joint above the middle of the seat
			const XF = XS + 0.46 * K; // the ankles
			const seatHip = FL - 0.45 * K - 0.09 * K;
			const legs = (sk.thigh + sk.shin) * u;
			const standHip = { x: XF - 1.5, y: AY - Math.sqrt((legs * 0.999) ** 2 - 1.5 ** 2) };
			const FLAT = handShape('flat');
			const RELAX = handShape('relaxed');
			// a point on the top of the thigh: a fraction f from the hip to the knee, raised by the thigh's half-width
			const onThigh = (hip: Pt, ankle: Pt, f: number, lift: number) => {
				const k = ik(hip, ankle, sk.thigh * u, sk.shin * u, KNEE).j;
				const dx = k.x - hip.x;
				const dy = k.y - hip.y;
				const L = Math.hypot(dx, dy);
				return { p: { x: hip.x + dx * f + (dy / L) * lift, y: hip.y + dy * f - (dx / L) * lift }, dir: Math.atan2(dy, dx) };
			};
			scene(card, 5.5, (x) => {
				const t = x * 5.5;
				// 0–0,8 с sitting, 0,8–2,0 с leaning forward, 2,0–3,6 с rising, then standing
				const lean1 = ease((t - 0.8) / 1.2);
				const r = Math.min(1, Math.max(0, (t - 2.0) / 1.6));
				const hip = { x: mix(XS, standHip.x, ease(r / 0.7)), y: mix(seatHip, standHip.y, ease((r - 0.12) / 0.88)) };
				const lean = mix(mix(0.1, 0.85, lean1), 0.05, ease((r - 0.2) / 0.8));
				const ankles: [Pt, Pt] = [
					{ x: XF, y: AY },
					{ x: XF - 0.05 * K, y: AY },
				];
				// the palms lie on the thighs and push off them during the first half of the rise, then the arms hang
				const off = ease((r - 0.45) / 0.45);
				const hands = ([0, 1] as const).map((i) => {
					const th = onThigh({ x: hip.x - i * 1.2, y: hip.y }, ankles[i], mix(0.55, 0.72, lean1) - i * 0.06, 0.042 * u);
					const hang = { x: hip.x + 0.025 * u - i * 2, y: hip.y + 0.07 * u };
					const h: HandTarget = {
						at: mixPt(th.p, hang, off),
						pose: off < 0.5 ? 'flat' : 'relaxed',
						shape: blendShape(FLAT, RELAX, off),
						dir: mix(th.dir, Math.PI / 2 - 0.1, off),
						roll: 0,
						contact: off === 0 ? 'thigh' : undefined,
					};
					return h;
				}) as [HandTarget, HandTarget];
				man.pose({
					hip,
					lean,
					ankles,
					feet: [0, 0],
					planted: [true, true],
					hands,
					head: mix(0, -0.2, lean1) * (1 - ease(r)) + 0.05,
				});
			});
		}
		// ---- the roly-poly toy ----
		{
			const card = root.querySelector<HTMLElement>('[data-scene="toy"]')!;
			const K = 100;
			const FL = 226;
			const S = K / 100;
			const H = 122;
			const u = S * H;
			const TOP = 176; // the table top
			const R = 12;
			const X0 = 222; // the toy's center when upright
			const toy = card.querySelector<SVGGElement>('[data-toy]')!;
			const girl = figure(card.querySelector<SVGGElement>('[data-girl]')!, { s: S, H, age: 'child', clothes: 'indoor', shirt: 'hm-gold', hair: 'pony', name: 'girl' });
			const AY = FL - 7 * S * (H / 172);
			const GX = 180; // the girl's hips
			const LEGS = (SKELETON.child.thigh + SKELETON.child.shin) * u;
			const TH0 = (30 * Math.PI) / 180;
			const RELAXED = handShape('relaxed');
			const POINT = handShape('point');
			const W = 7.7;
			const TAU = 1.3;
			// the point on the head where the finger touches, for a tilt th (the toy leans right, away from her)
			const headLeft = (th: number) => {
				const cx = X0 + R * th;
				const cy = TOP - R;
				const lx = -6; // the top left of the head
				const ly = -26;
				return { x: cx + lx * Math.cos(th) - ly * Math.sin(th), y: cy + lx * Math.sin(th) + ly * Math.cos(th) };
			};
			const HIPY = AY - Math.sqrt((0.997 * LEGS) ** 2 - (0.04 * u) ** 2);
			const up = { x: X0 - 4, y: 124 }; // above the head, at arm's length
			scene(card, 5, (x) => {
				const t = x * 5;
				// 0–0,6 с the hand comes down to the head, 0,6–1,2 с it tips the toy to 30°, 1,2–1,6 с the finger goes back up
				let th = 0;
				if (t > 0.6 && t <= 1.2) th = TH0 * ease((t - 0.6) / 0.6);
				else if (t > 1.2) {
					const tt = t - 1.2;
					th = TH0 * Math.exp(-tt / TAU) * Math.cos(W * tt);
				}
				toy.setAttribute('transform', `translate(${(X0 + R * th).toFixed(2)} ${TOP - R}) rotate(${((th * 180) / Math.PI).toFixed(1)})`);
				let at: Pt;
				let contact: string | undefined;
				const p0 = headLeft(0);
				// the hand waits above the toy, comes down to its head, tips it, goes back up and waits there: the loop
				// starts and ends with the same pose
				if (t <= 0.6) {
					const e = ease(t / 0.6);
					at = mixPt(up, p0, e); // straight down onto the top left of the head
				} else if (t <= 1.2) {
					at = headLeft(th);
					contact = 'head of the toy';
				} else if (t <= 1.6) at = mixPt(headLeft(TH0), up, ease((t - 1.2) / 0.4));
				else at = up;
				// free motion: the finger points along the line from the shoulder (a straight wrist); in touch it lies on the
				// head; the two blend over 0,15 с before the touch and after it
				// she leans in only while she pushes, so that the hand never comes too close to her shoulder
				const lean = 0.22 + 0.16 * ease((t - 0.6) / 0.6) - 0.16 * ease((t - 1.2) / 0.5);
				const hip = { x: GX, y: HIPY };
				const sh = girl.shoulders(hip, lean)[0];
				const aim = Math.atan2(at.y - sh.y, at.x - sh.x);
				const w = t <= 0.6 ? ease((t - 0.45) / 0.15) : t <= 1.2 ? 1 : 1 - ease((t - 1.2) / 0.15);
				const dir = mix(aim, 0.05 + Math.min(th, TH0) * 0.4 * (t <= 1.2 ? 1 : 0) + (t > 1.2 ? TH0 * 0.4 : 0), w);
				const pointing = 1;
				girl.pose({
					hip,
					lean,
					ankles: [
						{ x: GX + 0.03 * u, y: AY },
						{ x: GX - 0.04 * u, y: AY },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at, pose: 'point', shape: blendShape(RELAXED, POINT, pointing), dir, roll: -0.6, contact },
						{ at: { x: GX - 0.02 * u, y: HIPY + 0.06 * u }, pose: 'relaxed' },
					],
					head: 0.3,
				});
			});
		}
	}
</script>
