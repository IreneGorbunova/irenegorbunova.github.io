---
/**
 * Two short looping opening scenes of «Равновесие тел» (grade 10). No terms of the chapter in the pictures; the
 * captions' popovers explain. People: the shared people kit (src/components/people/).
 *
 * Chair (real time, 5,5 с): a living room seen from the side, with depth: the back wall with a window (sky, a hill, a
 *   tree and a house outside), curtains, a picture and a bookcase; the floor with a rug; a floor lamp and a low coffee
 *   table with a cup and a book a little farther back. Near objects 80 px per metre (0,8 px per см). A man (175 см,
 *   home clothes) sits on a chair (seat 45 см high, 42 см deep, back 90 см). His feet stay planted 46 см in front of
 *   his hip joint, his palms lie flat on his thighs. To stand up he first leans the trunk forward (0,1 → 0,85 rad in
 *   1,2 с), so that his upper body comes over his feet, then rises in 1,6 с: the hips go forward over the feet and up,
 *   he pushes off his thighs with his palms (they stay on the thighs for the first half of the rise), then the arms
 *   hang. Standing, his hip joints are right above his ankles. No marks, lines or terms in the picture.
 * Roly-poly toy (real time, 5 с): a children's room (a window, a shelf with toys, a poster, a rug), 100 px per metre.
 *   A girl of about 7 (122 см) stands at a low table (50 см) with a roly-poly toy 30 см tall: a heavy hemisphere of
 *   radius 12 см below, a lighter head above. Its center of gravity is 3 см below the center of the hemisphere, so when
 *   tilted it rolls back. Her hand waits above the toy with the index finger out; she brings the finger down to the
 *   toy's head (0,6 с), tips the toy by 30° (0,6 с) and lifts the finger back up (0,4 с), where it waits; the toy rolls on the table without slipping (its center moves by Rθ) and rocks as
 *   θ = 30°·e^(−t/1,3 с)·cos(ωt), ω = 7,7 рад/с: a period of 0,8 с, as for a toy of this size (ω² = mga/I, a = 3 см,
 *   I about the point of contact ≈ m·0,005 м²); the damping time 1,3 с is chosen to look like a real toy.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
// chair scene: the floor line of the near objects and of the back wall
const FL = 226;
const WALL = 186;
const K = 80; // px per metre (near)
const planks = Array.from({ length: 13 }, (_, i) => {
	const x0 = -40 + i * 34;
	return `M${x0} ${WALL + 1} L${(x0 + (x0 - 180) * 0.35).toFixed(1)} 240`;
}).join(' ');
const books = [
	[24, 10, 30, 'b1'], [35, 8, 27, 'b2'], [44, 11, 31, 'b3'], [56, 7, 24, 'b1'], [64, 9, 29, 'b4'], [75, 10, 26, 'b2'],
].map(([x, w, h, c]) => ({ x: x as number, w: w as number, h: h as number, c: c as string }));
const books2 = [
	[24, 8, 22, 'b4'], [33, 10, 27, 'b3'], [44, 9, 25, 'b1'], [58, 14, 10, 'b2'], [74, 9, 27, 'b3'],
].map(([x, w, h, c]) => ({ x: x as number, w: w as number, h: h as number, c: c as string }));
// toy scene
const FL2 = 226;
const TOP = 176; // the table top: 50 см at 100 px per metre
---

<PeopleStyles />
<IntroFrame data-rtintro>
	<div class="intro__card" data-scene="chair">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Гостиная. Мужчина сидит на стуле, положив ладони на бёдра. Чтобы встать, он сначала наклоняется вперёд, а потом, оттолкнувшись ладонями от бёдер, поднимается">
			<defs>
				<linearGradient id={`rt-sky-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="rt-sky1"></stop>
					<stop offset="1" class="rt-sky2"></stop>
				</linearGradient>
				<clipPath id={`rt-win-${uid}`}><rect x="196" y="28" width="92" height="102"></rect></clipPath>
			</defs>
			<rect class="rt-wall" x="0" y="0" width="360" height={WALL}></rect>
			<path class="rt-wall-stripe" d={Array.from({ length: 18 }, (_, i) => `M${10 + i * 20} 0 V${WALL - 6}`).join(' ')}></path>
			<!-- the window and the view -->
			<g clip-path={`url(#rt-win-${uid})`}>
				<rect x="196" y="28" width="92" height="102" fill={`url(#rt-sky-${uid})`}></rect>
				<circle class="rt-cloud" cx="222" cy="48" r="7"></circle>
				<circle class="rt-cloud" cx="231" cy="45" r="9"></circle>
				<circle class="rt-cloud" cx="241" cy="49" r="6"></circle>
				<path class="rt-hill" d="M190 112 Q230 92 262 104 T300 98 V140 H190 Z"></path>
				<path class="rt-house" d="M256 96 h18 v14 h-18 Z"></path>
				<path class="rt-roof" d="M253 97 l12 -9 l12 9 Z"></path>
				<rect class="rt-hwin" x="261" y="100" width="4" height="4"></rect>
				<path class="rt-trunk" d="M212 118 V100"></path>
				<circle class="rt-tree" cx="212" cy="96" r="9"></circle>
				<circle class="rt-tree" cx="219" cy="102" r="6"></circle>
			</g>
			<rect class="rt-frame" x="196" y="28" width="92" height="102" rx="2"></rect>
			<path class="rt-frame-in" d="M242 28 V130 M196 76 H288"></path>
			<rect class="rt-sill" x="190" y="130" width="104" height="5" rx="1.5"></rect>
			<path class="rt-curtain" d="M184 22 H200 Q197 70 204 136 H186 Q182 80 184 22 Z"></path>
			<path class="rt-curtain" d="M300 22 H284 Q287 70 280 136 H298 Q302 80 300 22 Z"></path>
			<rect class="rt-rod" x="178" y="19" width="128" height="3.5" rx="1.5"></rect>
			<!-- a picture and a bookcase -->
			<rect class="rt-pic" x="112" y="40" width="50" height="36" rx="1.5"></rect>
			<path class="rt-pic-sky" d="M116 44 H158 V72 H116 Z"></path>
			<path class="rt-pic-art" d="M116 72 L128 56 L136 64 L146 52 L158 72 Z"></path>
			<rect class="rt-case" x="18" y="86" width="74" height={WALL - 86 + 2}></rect>
			<path class="rt-case-shelf" d={`M18 120 H92 M18 154 H92`}></path>
			{books.map((b) => <rect class={`rt-book rt-${b.c}`} x={b.x} y={120 - b.h} width={b.w} height={b.h}></rect>)}
			{books2.map((b) => <rect class={`rt-book rt-${b.c}`} x={b.x} y={154 - b.h} width={b.w} height={b.h}></rect>)}
			<path class="rt-vase" d="M84 120 q-4 -9 1 -16 h4 q5 7 1 16 Z"></path>
			<!-- floor -->
			<rect class="rt-skirt" x="0" y={WALL - 4} width="360" height="5"></rect>
			<rect class="rt-floor" x="0" y={WALL + 1} width="360" height={240 - WALL - 1}></rect>
			<path class="rt-plank" d={planks}></path>
			<ellipse class="rt-rug" cx="150" cy={FL + 1} rx="118" ry="9"></ellipse>
			<ellipse class="rt-rug-in" cx="150" cy={FL + 1} rx="104" ry="6.5"></ellipse>
			<!-- a floor lamp and a coffee table, a little farther back -->
			<ellipse class="rt-lamp-base" cx="334" cy="201" rx="9" ry="2.4"></ellipse>
			<path class="rt-lamp-pole" d="M334 200 V64"></path>
			<path class="rt-lamp-glow" d="M323 66 L345 66 L352 92 L316 92 Z"></path>
			<path class="rt-lamp-shade" d="M322 64 L346 64 L341 44 L327 44 Z"></path>
			<rect class="rt-ctable" x="248" y="190" width="74" height="4" rx="1.5"></rect>
			<path class="rt-ctable-leg" d="M254 194 V214 M316 194 V214 M262 194 V209 M308 194 V209"></path>
			<path class="rt-cup" d="M296 181 h9 v6 q0 3 -3 3 h-3 q-3 0 -3 -3 Z M305 183 q4 0 4 2.5 q0 2.5 -4 2.5"></path>
			<rect class="rt-book rt-b3" x="262" y="186" width="20" height="4" rx="0.8"></rect>
			<rect class="rt-book rt-b1" x="264" y="183" width="16" height="3" rx="0.8"></rect>
			<!-- the chair: seat 45 см high and 42 см deep, the back up to 90 см; 80 px per metre -->
			<g class="rt-chair-far">
				<rect class="rt-chair" x="83" y={FL - 0.45 * K} width="3" height={0.45 * K}></rect>
				<rect class="rt-chair" x={80 + 0.42 * K - 6} y={FL - 0.45 * K} width="3" height={0.45 * K}></rect>
			</g>
			<rect class="rt-chair" x="78.5" y={FL - 0.9 * K} width="4.5" height={0.9 * K}></rect>
			<rect class="rt-chair" x="78.5" y={FL - 0.9 * K + 3} width="13" height="20" rx="2.5"></rect>
			<g data-man></g>
			<rect class="rt-chair" x="79" y={FL - 0.45 * K - 3.5} width={0.42 * K + 2} height="5" rx="1.5"></rect>
			<rect class="rt-chair" x={80 + 0.42 * K - 3} y={FL - 0.45 * K} width="3.5" height={0.45 * K}></rect>
		</svg>
		<div class="intro__foot">
			<p>
				Чтобы встать со стула, мы сначала{' '}
				<More term="наклоняемся вперёд">
					Пока человек сидит, его вес приходится на сиденье. Встать можно, только когда вертикаль, проведённая через центр тяжести тела, проходит через ступни. Попробуйте встать, держа спину прямо и не подвигая ноги под стул: не получится. Об этом — в разделе{' '}
					<a href="#устойчивость-тел-на-опоре">«Устойчивость тел на опоре»</a>.
				</More>{' '}и только потом поднимаемся.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="toy">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Детская комната. Девочка наклоняет пальцем игрушку-неваляшку на столике и убирает руку. Неваляшка качается и встаёт прямо">
			<defs>
				<linearGradient id={`rt-sky2-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="rt-sky1"></stop>
					<stop offset="1" class="rt-sky2"></stop>
				</linearGradient>
			</defs>
			<rect class="rt-wall2" x="0" y="0" width="360" height="188"></rect>
			<path class="rt-dots" d={Array.from({ length: 9 }, (_, j) => Array.from({ length: 18 }, (_, i) => `M${10 + i * 20 + (j % 2) * 10} ${12 + j * 20} h0.01`).join(' ')).join(' ')}></path>
			<!-- the window -->
			<rect x="24" y="26" width="76" height="92" fill={`url(#rt-sky2-${uid})`}></rect>
			<circle class="rt-sun" cx="80" cy="46" r="9"></circle>
			<path class="rt-hill" d="M24 100 Q50 86 74 94 T100 90 V118 H24 Z"></path>
			<rect class="rt-frame" x="24" y="26" width="76" height="92" rx="2"></rect>
			<path class="rt-frame-in" d="M62 26 V118 M24 70 H100"></path>
			<rect class="rt-sill" x="18" y="118" width="88" height="5" rx="1.5"></rect>
			<path class="rt-plant" d="M44 110 q-6 -14 -2 -22 M48 110 q2 -16 8 -20 M46 110 q-1 -12 -10 -16"></path>
			<path class="rt-pot" d="M39 118 h14 l-2 -9 h-10 Z"></path>
			<!-- a poster with a planet -->
			<rect class="rt-poster" x="122" y="34" width="44" height="56" rx="2"></rect>
			<circle class="rt-planet" cx="144" cy="64" r="10"></circle>
			<ellipse class="rt-ring" cx="144" cy="64" rx="17" ry="4"></ellipse>
			<path class="rt-star" d="M130 44 h0.01 M158 48 h0.01 M132 82 h0.01 M159 80 h0.01 M150 40 h0.01"></path>
			<!-- a shelf with toys -->
			<rect class="rt-shelf" x="236" y="86" width="108" height="5" rx="1"></rect>
			<path class="rt-bracket" d="M246 91 v10 l6 -10 M332 91 v10 l-6 -10"></path>
			<g class="rt-teddy">
				<circle cx="249" cy="55" r="3.5"></circle>
				<circle cx="263" cy="55" r="3.5"></circle>
				<ellipse cx="256" cy="77" rx="11" ry="9"></ellipse>
				<circle cx="256" cy="62" r="9"></circle>
				<circle class="rt-teddy-snout" cx="256" cy="65" r="3.5"></circle>
			</g>
			<circle class="rt-eye2" cx="252.5" cy="60" r="1"></circle>
			<circle class="rt-eye2" cx="259.5" cy="60" r="1"></circle>
			<rect class="rt-cube rt-b1" x="276" y="72" width="14" height="14"></rect>
			<rect class="rt-cube rt-b3" x="290" y="72" width="14" height="14"></rect>
			<rect class="rt-cube rt-b4" x="283" y="58" width="14" height="14"></rect>
			<path class="rt-pyr-rod" d="M327 70 V62"></path>
			<path class="rt-pyr" d="M318 86 h18 l-3 -6 h-12 Z M320 80 h14 l-2 -5 h-10 Z M322 75 h10 l-2 -5 h-6 Z"></path>
			<!-- the floor -->
			<rect class="rt-skirt" x="0" y="184" width="360" height="5"></rect>
			<rect class="rt-floor2" x="0" y="189" width="360" height="51"></rect>
			<ellipse class="rt-rug2" cx="200" cy={FL2 + 2} rx="130" ry="9"></ellipse>
			<path class="rt-rug2-band" d="M84 228 Q200 236 316 228"></path>
			<!-- a ball on the floor, a little farther back -->
			<circle class="rt-ball" cx="330" cy="198" r="9"></circle>
			<path class="rt-ball-band" d="M321.5 195 Q330 200 338.5 195"></path>
			<!-- the low table: 50 см, 100 px per metre -->
			<rect class="rt-table rt-table--far" x="198" y={TOP + 6} width="5" height={FL2 - TOP - 12}></rect>
			<rect class="rt-table rt-table--far" x="295" y={TOP + 6} width="5" height={FL2 - TOP - 12}></rect>
			<rect class="rt-table" x="186" y={TOP} width="128" height="6" rx="2"></rect>
			<rect class="rt-table" x="191" y={TOP + 6} width="6" height={FL2 - TOP - 6}></rect>
			<rect class="rt-table" x="302" y={TOP + 6} width="6" height={FL2 - TOP - 6}></rect>
			<g data-toy>
				<!-- local: the center of the lower hemisphere at (0, 0), 1 px per см; R = 12 -->
				<path class="rt-toy" d="M-12 0 A12 12 0 0 0 12 0 C12 -8 8 -12 6 -14 L-6 -14 C-8 -12 -12 -8 -12 0 Z"></path>
				<circle class="rt-toy" cx="0" cy="-20" r="8"></circle>
				<path class="rt-scarf" d="M-8 -21 Q0 -31 8 -21 Q0 -27 -8 -21 Z"></path>
				<circle class="rt-face" cx="0" cy="-19" r="5.4"></circle>
				<circle class="rt-eye" cx="-2" cy="-20" r="0.8"></circle>
				<circle class="rt-eye" cx="2" cy="-20" r="0.8"></circle>
				<circle class="rt-blush" cx="-3.2" cy="-17.6" r="1.1"></circle>
				<circle class="rt-blush" cx="3.2" cy="-17.6" r="1.1"></circle>
				<path class="rt-mouth" d="M-1.4 -16.8 Q0 -15.8 1.4 -16.8"></path>
				<path class="rt-flower" d="M-4 -4 a2.5 2.5 0 1 0 5 0 a2.5 2.5 0 1 0 -5 0 M3 1 a2 2 0 1 0 4 0 a2 2 0 1 0 -4 0"></path>
			</g>
			<g data-girl></g>
		</svg>
		<div class="intro__foot">
			<p>
				Неваляшку можно наклонить, но,{' '}
				<More term="если её отпустить, она снова встанет">
					Внизу у неваляшки тяжёлый груз, поэтому её центр тяжести лежит очень низко. Когда игрушку наклоняют, центр тяжести поднимается, и сила тяжести возвращает её обратно — так устроено устойчивое равновесие. Об этом — в разделе{' '}
					<a href="#виды-равновесия">«Виды равновесия»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-rtintro] .rt-wall {
		fill: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-bg));
	}
	[data-rtintro] .rt-wall-stripe {
		stroke: color-mix(in oklab, var(--ig-v) 16%, var(--sl-color-bg));
		stroke-width: 6;
	}
	[data-rtintro] .rt-wall2 {
		fill: color-mix(in oklab, hsl(150, 40%, 50%) 12%, var(--sl-color-bg));
	}
	[data-rtintro] .rt-dots {
		stroke: color-mix(in oklab, hsl(150, 40%, 50%) 30%, var(--sl-color-bg));
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-rtintro] .rt-sky1 {
		stop-color: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-bg));
	}
	[data-rtintro] .rt-sky2 {
		stop-color: color-mix(in oklab, var(--ig-vx) 22%, var(--sl-color-bg));
	}
	[data-rtintro] .rt-cloud {
		fill: hsl(210, 35%, 94%);
		opacity: 0.9;
	}
	[data-rtintro] .rt-sun {
		fill: hsl(48, 95%, 66%);
	}
	[data-rtintro] .rt-hill {
		fill: hsl(130, 32%, 42%);
	}
	[data-rtintro] .rt-house {
		fill: hsl(35, 40%, 75%);
	}
	[data-rtintro] .rt-roof {
		fill: hsl(5, 55%, 48%);
	}
	[data-rtintro] .rt-hwin {
		fill: hsl(205, 50%, 45%);
	}
	[data-rtintro] .rt-trunk {
		stroke: hsl(25, 35%, 32%);
		stroke-width: 2.5;
	}
	[data-rtintro] .rt-tree {
		fill: hsl(130, 38%, 34%);
	}
	[data-rtintro] .rt-frame {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3.5;
	}
	[data-rtintro] .rt-frame-in {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-rtintro] .rt-sill,
	[data-rtintro] .rt-rod {
		fill: var(--sl-color-gray-3);
	}
	[data-rtintro] .rt-curtain {
		fill: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-rtintro] .rt-pic {
		fill: var(--sl-color-gray-6);
		stroke: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-3));
		stroke-width: 3;
	}
	[data-rtintro] .rt-pic-sky {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
	}
	[data-rtintro] .rt-pic-art {
		fill: hsl(150, 35%, 42%);
	}
	[data-rtintro] .rt-case {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	[data-rtintro] .rt-case-shelf {
		stroke: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		stroke-width: 3;
	}
	[data-rtintro] .rt-book {
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-rtintro] .rt-b1 {
		fill: var(--ig-vx);
	}
	[data-rtintro] .rt-b2 {
		fill: hsl(150, 40%, 45%);
	}
	[data-rtintro] .rt-b3 {
		fill: var(--ig-vy);
	}
	[data-rtintro] .rt-b4 {
		fill: var(--ig-v);
	}
	[data-rtintro] .rt-vase {
		fill: hsl(195, 45%, 55%);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-rtintro] .rt-skirt {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-4));
	}
	[data-rtintro] .rt-floor {
		fill: color-mix(in oklab, var(--ig-v) 38%, var(--sl-color-gray-5));
	}
	[data-rtintro] .rt-floor2 {
		fill: color-mix(in oklab, var(--ig-v) 28%, var(--sl-color-gray-5));
	}
	[data-rtintro] .rt-plank {
		stroke: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
		stroke-width: 0.8;
	}
	[data-rtintro] .rt-rug {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-5));
	}
	[data-rtintro] .rt-rug-in {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke-width: 1.2;
		stroke-dasharray: 5 3;
	}
	[data-rtintro] .rt-rug2 {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-5));
	}
	[data-rtintro] .rt-rug2-band {
		fill: none;
		stroke: hsl(205, 60%, 85%);
		stroke-width: 1.5;
	}
	[data-rtintro] .rt-lamp-base,
	[data-rtintro] .rt-lamp-pole {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-rtintro] .rt-lamp-shade {
		fill: hsl(42, 70%, 80%);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-rtintro] .rt-lamp-glow {
		fill: hsl(48, 95%, 70%);
		opacity: 0.18;
	}
	[data-rtintro] .rt-ctable,
	[data-rtintro] .rt-chair,
	[data-rtintro] .rt-table,
	[data-rtintro] .rt-shelf {
		fill: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
