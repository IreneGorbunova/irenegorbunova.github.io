---
/**
 * «Наклоняем шкаф»: a uniform box (a wardrobe) of width b (0,3…1 м) and height h (0,5…2 м) stands on the floor; it is
 * tilted about its right bottom edge by θ (0…60°). Its center of gravity is at the middle; the vertical through it is
 * drawn dashed. While the vertical passes through the area of support (left of the edge), the force of gravity turns
 * the box back; when it passes beyond the edge, the box falls over. The critical angle is tg θ_кр = b / h.
 * «Отпустить» lets the box go: it turns about the edge as I·θ'' = mg·ρ·sin(θ_кр − θ), I = m(b² + h²)/3 = (4/3)·m·ρ²,
 * ρ = half the diagonal, so θ'' = (3g / 4ρ)·sin(θ_кр − θ); back on its base it stops (no bounce), past the critical
 * angle it falls on its side. The slider moves in steps of 1°, and the critical angle is rarely a whole number
 * (18,4° for the default 0,6 × 1,8 м), so «Критический угол» sets the box exactly at it: the vertical then passes
 * through the edge, the moment of gravity about the edge is zero, and the box stays balanced on the edge (unstable
 * equilibrium; a real box falls from the slightest push). Scale 80 px per metre; real time.
 * The arm of the force of gravity about the edge (gold, along the floor) is the horizontal distance d from the edge to
 * the vertical through the center of gravity; the message says whether its moment turns the box back, tips it over or
 * is zero. Upright, the base (the area of support seen from the side) is shaded violet; tilted, the box touches the
 * floor only along its edge. Checked: 0,6 × 1,8 м → 18,4°; 0,3 × 2 м → 8,5°; 1 × 0,5 м → 63,4°.
 */
import RtStyles from './RtStyles.astro';
---

<RtStyles />
<figure class="g7 g7--stack tlt not-content" data-tlt>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 234" role="img" aria-label="Шкаф наклонён на ребро; через его центр тяжести проведена вертикаль" data-svg>
			<rect class="tlt__floor" x="0" y="200" width="400" height="34"></rect>
			<line class="ink" x1="0" x2="400" y1="200" y2="200"></line>
			<rect class="tlt__base" data-base y="196" height="4"></rect>
			<path class="rt-arm" data-arm></path>
			<path class="tlt__tick" data-armt></path>
			<g data-box>
				<rect class="tlt__box" data-rect></rect>
				<path class="tlt__doors" data-doors></path>
			</g>
			<line class="tlt__vert" data-vert></line>
			<path class="rt-f--grav" data-mg></path>
			<g data-cg></g>
			<circle class="tlt__edge" cx="170" cy="200" r="3"></circle>
			<text class="rt-sym rt-t--grav" data-rtv="1" data-lmg>mg</text>
			<text class="rt-sym rt-t--d" data-ld>d</text>
		</svg>
		<div class="g7__side tlt__side">
			<label class="g7__slider">
				<span>Ширина <i>b</i></span>
				<output data-ob></output>
				<input type="range" min="0.3" max="1" step="0.1" value="0.6" data-b aria-label="Ширина шкафа, метры" />
			</label>
			<label class="g7__slider">
				<span>Высота <i>h</i></span>
				<output data-oh></output>
				<input type="range" min="0.5" max="2" step="0.1" value="1.8" data-h aria-label="Высота шкафа, метры" />
			</label>
			<label class="g7__slider">
				<span>Наклон <i>θ</i></span>
				<output data-ot></output>
				<input type="range" min="0" max="60" step="1" value="10" data-t aria-label="Угол наклона, градусы" />
			</label>
			<div class="tlt__btns">
				<button type="button" class="g7__btn" data-crit>Критический угол</button>
				<button type="button" class="g7__btn g7__btn--go" data-go>Отпустить</button>
			</div>
			<p class="g7__msg" data-state aria-live="polite"></p>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Шкаф наклоняют, поворачивая вокруг правого нижнего ребра. Масштаб 80&nbsp;px на метр, настоящее время. Фиолетовая полоска — площадь опоры (вид сбоку), пунктир — вертикаль через центр тяжести, золотой отрезок <i>d</i> — плечо силы тяжести относительно ребра.
	</figcaption>
</figure>

<style is:global>
	.tlt__side {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: end;
	}
	.tlt__side .g7__msg {
		grid-column: 1 / -1;
	}
	.tlt__side .g7__read {
		grid-column: 1 / -1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.tlt__btns {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	@container (max-width: 36rem) {
		.tlt__side {
			grid-template-columns: minmax(0, 1fr);
		}
		.tlt__side .g7__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.g7__svg .tlt__floor {
		fill: var(--g7-ground);
	}
	.g7__svg .tlt__base {
		fill: color-mix(in oklab, var(--rt-n) 60%, transparent);
		stroke: var(--rt-n);
		stroke-width: 1;
	}
	.g7__svg .tlt__tick {
		fill: none;
		stroke: var(--rt-d);
		stroke-width: 1.2;
	}
	.g7__svg .tlt__box {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.5;
	}
	.g7__svg .tlt__doors {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.g7__svg .tlt__vert {
		stroke: var(--g7-blue);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
	}
	.g7__svg .tlt__edge {
		fill: var(--g7-ink);
	}
</style>

<script>
	import { fmt, fmtTrim, loop } from '../g7/kit';
	import { arrowPath, cgMark, place, rings, segOf, type Box, type Seg } from './rt';

	const g = 9.8;
	const PX = 80;
	const EX = 170; // the edge
	const EY = 200;
	const VIEW: Box = { x0: 2, y0: 2, x1: 398, y1: 232 };
	for (const root of document.querySelectorAll<HTMLElement>('[data-tlt]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const bIn = q<HTMLInputElement>('[data-b]');
		const hIn = q<HTMLInputElement>('[data-h]');
		const tIn = q<HTMLInputElement>('[data-t]');
		let th = Number(tIn.value) * (Math.PI / 180);
		let w = 0;
		let running = false;
		let atCrit = false; // the box stands exactly at the critical angle
		const set = (e: Element, a: Record<string, number>) => {
			for (const [n, v] of Object.entries(a)) e.setAttribute(n, v.toFixed(1));
		};
		const draw = () => {
			const b = Number(bIn.value);
			const h = Number(hIn.value);
			q('[data-ob]').textContent = `${fmtTrim(b, 1)} м`;
			q('[data-oh]').textContent = `${fmtTrim(h, 1)} м`;
			const deg = (th * 180) / Math.PI;
			q('[data-ot]').textContent = atCrit ? `${fmt(deg, 1)}°` : `${Math.round(deg)}°`;
			const bw = b * PX;
			const hh = h * PX;
			// the box in its own frame: the edge at (0, 0), the box to the left and up; turned clockwise by th
			q('[data-rect]').setAttribute('x', String(-bw));
			q('[data-rect]').setAttribute('y', String(-hh));
			q('[data-rect]').setAttribute('width', String(bw));
			q('[data-rect]').setAttribute('height', String(hh));
			q('[data-doors]').setAttribute('d', `M${-bw / 2} ${-hh + 4} V-4 M${-bw / 2 - 5} ${-hh / 2} v8 M${-bw / 2 + 5} ${-hh / 2} v8`);
			q('[data-box]').setAttribute('transform', `translate(${EX} ${EY}) rotate(${((th * 180) / Math.PI).toFixed(2)})`);
			// the center of gravity: (−b/2, −h/2) turned by th
			const cx = EX + (-bw / 2) * Math.cos(th) - (-hh / 2) * Math.sin(th);
			const cy = EY + (-bw / 2) * Math.sin(th) + (-hh / 2) * Math.cos(th);
			q('[data-cg]').innerHTML = cgMark(cx, cy, 4.5);
			set(q('[data-vert]'), { x1: cx, y1: cy, x2: cx, y2: EY });
			q('[data-mg]').setAttribute('d', arrowPath(cx, cy + 4, cx, cy + 40, 3, 9));
			// the arm of gravity about the edge: along the floor, from the edge to the vertical
			const dpx = EX - cx; // > 0: the vertical is over the base
			const armOn = Math.abs(dpx) > 0.5;
			q('[data-arm]').setAttribute('d', armOn ? `M${EX} ${EY + 7} H${cx.toFixed(1)}` : '');
			q('[data-armt]').setAttribute('d', armOn ? `M${EX} ${EY + 3} v8 M${cx.toFixed(1)} ${EY + 3} v8` : '');
			const ld = q<SVGTextElement>('[data-ld]');
			ld.style.visibility = armOn ? 'visible' : 'hidden';
			// the box's edges as obstacles for the labels
			const corner = (x: number, y: number) => ({ x: EX + x * Math.cos(th) - y * Math.sin(th), y: EY + x * Math.sin(th) + y * Math.cos(th) });
			const cs = [corner(0, 0), corner(-bw, 0), corner(-bw, -hh), corner(0, -hh)];
			const segs: Seg[] = [segOf(cx, cy, cx, cy + 40, 4), segOf(cx, cy, cx, EY, 1.5), segOf(0, EY, 400, EY, 1.5), segOf(EX, EY + 7, cx, EY + 7, 2)];
			for (let i = 0; i < 4; i++) segs.push(segOf(cs[i].x, cs[i].y, cs[(i + 1) % 4].x, cs[(i + 1) % 4].y, 2));
			const doors = [corner(-bw / 2, -hh + 4), corner(-bw / 2, -4)];
			segs.push(segOf(doors[0].x, doors[0].y, doors[1].x, doors[1].y, 1.5));
			const boxes: Box[] = [{ x0: cx - 6, y0: cy - 6, x1: cx + 6, y1: cy + 6 }];
			// the label of m·g⃗ may lie on the box (it has a halo) but not on its edges or the doors' line
			place(q<SVGTextElement>('[data-lmg]'), [
				{ x: cx + 8, y: cy + 34, anchor: 'start' },
				{ x: cx - 8, y: cy + 34, anchor: 'end' },
				{ x: cx + 8, y: cy + 20, anchor: 'start' },
				{ x: cx - 8, y: cy + 20, anchor: 'end' },
				{ x: cx + 8, y: cy + 50, anchor: 'start' },
				{ x: cx - 8, y: cy + 50, anchor: 'end' },
				{ x: cx, y: cy + 56, anchor: 'middle' },
				{ x: cx, y: cy - 9, anchor: 'middle' },
				...[20, 34, 6].flatMap((dy) => [
					{ x: Math.max(...cs.map((c) => c.x)) + 6, y: cy + dy, anchor: 'start' as const },
					{ x: Math.min(...cs.map((c) => c.x)) - 6, y: cy + dy, anchor: 'end' as const },
				]),
				...rings(cx, cy + 20, 0),
			], segs, boxes, VIEW);
			if (armOn)
				place(ld, [
					{ x: (EX + cx) / 2, y: EY + 26, anchor: 'middle' },
					{ x: Math.min(EX, cx) - 8, y: EY + 24, anchor: 'end' },
					{ x: Math.max(EX, cx) + 8, y: EY + 24, anchor: 'start' },
					{ x: (EX + cx) / 2, y: EY + 28, anchor: 'middle' },
				], segs, boxes, VIEW);
			// the area of support: where the box touches the floor (the whole base upright, the edge only when tilted)
			const base = q('[data-base]');
			base.setAttribute('x', String(th < 1e-3 ? EX - bw : EX - 2));
			base.setAttribute('width', String(th < 1e-3 ? bw : 4));
			base.setAttribute('y', String(th < 1e-3 ? EY - 4 : EY - 2));
			const crit = Math.atan(b / h);
			const onEdge = Math.abs(th - crit) < 1e-6;
			const fall = th > crit + 1e-6;
			const st = q('[data-state]');
			st.textContent =
				th < 1e-3
					? 'Шкаф стоит: вертикаль через центр тяжести проходит через площадь опоры.'
					: onEdge
						? 'Вертикаль проходит через ребро: плечо и момент силы тяжести равны нулю. Неустойчивое равновесие.'
						: fall
							? 'Вертикаль за ребром: момент силы тяжести опрокидывает шкаф.'
							: 'Вертикаль над опорой: момент силы тяжести возвращает шкаф.';
			st.classList.toggle('is-right', !fall && !onEdge);
			q('[data-read]').innerHTML = [
				['плечо силы тяжести <i>d</i>', `${fmt(Math.abs(dpx) / PX, 2)} м`],
				['критический угол', `${fmt((crit * 180) / Math.PI, 1)}°`],
				['tg <i>θ</i><sub>кр</sub> = <i>b</i>/<i>h</i>', fmt(b / h, 2)],
			]
				.map(([a, v], i) => `<li${i === 1 ? ' class="is-key"' : ''}><span>${a}</span><b>${v}</b></li>`)
				.join('');
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			const b = Number(bIn.value);
			const h = Number(hIn.value);
			const rho = Math.hypot(b, h) / 2;
			const crit = Math.atan(b / h);
			const n = 20;
			for (let i = 0; i < n; i++) {
				const s = dt / n;
				w += ((3 * g) / (4 * rho)) * Math.sin(crit - th) * -1 * s;
				th += w * s;
				if (th <= 0) {
					th = 0;
					w = 0;
					running = false;
					break;
				}
				if (th >= Math.PI / 2) {
					th = Math.PI / 2;
					w = 0;
					running = false;
					break;
				}
			}
			draw();
			return running;
		});
		const crit = () => Math.atan(Number(bIn.value) / Number(hIn.value));
		q('[data-go]').addEventListener('click', () => {
			th = atCrit ? crit() : Number(tIn.value) * (Math.PI / 180);
			w = 0;
			// exactly on the edge the moment of gravity is zero: the box stays
			running = th > 0 && !atCrit;
			draw();
			wake();
		});
		q('[data-crit]').addEventListener('click', () => {
			running = false;
			atCrit = true;
			th = crit();
			tIn.value = String(Math.round((th * 180) / Math.PI));
			draw();
		});
		for (const inp of [bIn, hIn])
			inp.addEventListener('input', () => {
				running = false;
				th = atCrit ? crit() : Number(tIn.value) * (Math.PI / 180);
				if (atCrit) tIn.value = String(Math.round((th * 180) / Math.PI));
				draw();
			});
		tIn.addEventListener('input', () => {
			running = false;
			atCrit = false;
			th = Number(tIn.value) * (Math.PI / 180);
			draw();
		});
		draw();
		document.fonts?.ready.then(draw);
	}
</script>
