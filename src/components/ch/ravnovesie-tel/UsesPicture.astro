---
/**
 * Small pictures to «Где это встречается» (two columns on a phone, four on a wide screen). The center of gravity is the
 * quartered disc of the chapter, the vertical through it dashed blue, the area of support violet.
 *  1. A tower crane (not to scale): the counterweight on the short arm balances the moment of the load on the long jib.
 *     The trolley runs out from 2,5 to 6 units of length from the mast and back (4 с each way, smoothly); the load it
 *     carries is drawn as a stack of crates whose number is inversely proportional to the reach (12 crates at the
 *     nearest point, 5 at the farthest: the moment of the load stays the same).
 *  2. The Leaning Tower of Pisa, 1,96 px per metre: about 56 м high and 15,5 м across at the base, tilted by 4°. Its
 *     center of gravity (at about half the height) is 1,9 м off the axis of the base; the vertical through it falls well
 *     inside the base. A still picture.
 *  3. A balancing toy bird on the tip of a stand, about 2 px per мм: the bird stands on its beak; weights in the tips of
 *     its wings put its center of gravity below the beak, so it rocks and comes back: θ = 15°·e^(−t/2 с)·cos(2πt / 1,2 с).
 *  4. A double-decker bus on a tilt platform, seen from behind, 17 px per metre: 2,55 м wide, 4,4 м high, the wheels
 *     2,1 м apart, the center of gravity 1,5 м above the road. The platform tilts to 28° in 3 с, holds for 1 с and comes
 *     back; the vertical through the center of gravity stays between the wheels (it would leave them at
 *     tg θ = 1,05 / 1,5, θ ≈ 35°).
 */
import RtStyles from './RtStyles.astro';
import { cgMark } from './rt';

const f = (v: number) => v.toFixed(1);
// 2: Pisa, 1,96 px per metre, the base center at (100, 140), tilted 4° to the right
const PK = 1.96;
const tilt = (4 * Math.PI) / 180;
const PW = 15.5 * PK;
const PH = 56 * PK;
const PB = { x: 100, y: 140 };
// a point x across and y up the tower, turned clockwise by the tilt about the middle of the base
const tp = (x: number, y: number) => ({ x: PB.x + x * Math.cos(tilt) + y * Math.sin(tilt), y: PB.y + x * Math.sin(tilt) - y * Math.cos(tilt) });
const tier = Array.from({ length: 7 }, (_, i) => (i + 1) * (PH / 8));
const pisaBody = [tp(-PW / 2, 0), tp(PW / 2, 0), tp(PW / 2 - 1, PH), tp(-PW / 2 + 1, PH)];
const pisaTop = [tp(-PW / 2 + 3, PH), tp(PW / 2 - 3, PH), tp(PW / 2 - 4, PH + 9), tp(-PW / 2 + 4, PH + 9)];
const pcg = tp(0, PH / 2);
---

<RtStyles />
<figure class="g7 g7--pic rtu not-content" data-rtu>
	<div class="g7__grid is-two">
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 200 150" role="img" aria-label="Башенный кран: противовес на короткой стреле уравновешивает груз на длинной; чем дальше от башни тележка, тем меньше груз" data-crane>
				<rect class="rt-ground" x="0" y="142" width="200" height="8"></rect>
				<path class="rtu-lattice" d="M64 142 V30 M76 142 V30 M64 142 L76 128 L64 114 L76 100 L64 86 L76 72 L64 58 L76 44 L64 30"></path>
				<path class="rtu-lattice" d="M70 30 L70 14 M70 14 L20 32 M70 14 L192 32"></path>
				<rect class="rtu-jib" x="20" y="30" width="172" height="5"></rect>
				<rect class="rtu-cab" x="76" y="36" width="12" height="10" rx="1.5"></rect>
				<rect class="rtu-weight" x="20" y="35" width="22" height="20" rx="1"></rect>
				<g data-trolley>
					<rect class="rtu-trolley" x="-6" y="35" width="12" height="4"></rect>
					<path class="rtu-cable" data-cable></path>
					<path class="rtu-hook" data-hook></path>
					<g data-crates></g>
				</g>
			</svg>
			<figcaption><b>Башенный кран.</b> Противовес на короткой стреле уравновешивает груз на длинной. Чем дальше от башни тележка, тем меньший груз ей можно поднять.</figcaption>
		</figure>
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 200 150" role="img" aria-label="Пизанская башня наклонена, но вертикаль через её центр тяжести проходит через основание">
				<rect class="rt-ground" x="0" y="140" width="200" height="10"></rect>
				<path class="rt-gline" d="M0 140 H200"></path>
				<path class="rtu-marble" d={`M${pisaBody.map((q) => `${f(q.x)} ${f(q.y)}`).join(' L')} Z`}></path>
				{tier.map((y) => {
					const a = tp(-PW / 2 + 0.5, y);
					const b = tp(PW / 2 - 0.5, y);
					return <path class="rtu-tier" d={`M${f(a.x)} ${f(a.y)} L${f(b.x)} ${f(b.y)}`}></path>;
				})}
				<path class="rtu-marble" d={`M${pisaTop.map((q) => `${f(q.x)} ${f(q.y)}`).join(' L')} Z`}></path>
				<rect class="rtu-base" x={PB.x - PW / 2} y="139" width={PW} height="3"></rect>
				<path class="rt-dash rt-s--grav" d={`M${f(pcg.x)} ${f(pcg.y)} V140`}></path>
				<Fragment set:html={cgMark(pcg.x, pcg.y, 3.5)} />
			</svg>
			<figcaption><b>Пизанская башня.</b> Высота около 56&nbsp;м, наклон около 4°. Вертикаль через центр тяжести проходит через основание, поэтому башня стоит.</figcaption>
		</figure>
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 200 150" role="img" aria-label="Игрушка-балансир: птичка стоит на клюве на острие подставки и качается, не падая; грузики в концах крыльев ниже клюва">
				<rect class="rt-ground" x="0" y="142" width="200" height="8"></rect>
				<path class="rtu-stand" d="M100 52 L96 66 L96 136 L80 136 L80 142 L120 142 L120 136 L104 136 L104 66 Z"></path>
				<g data-bird>
					<!-- local: the beak's tip at (0, 0) -->
					<path class="rtu-wing" d="M-6 -26 C-30 -24 -58 4 -66 30 C-50 16 -28 0 -4 -12 Z"></path>
					<path class="rtu-wing" d="M6 -26 C30 -24 58 4 66 30 C50 16 28 0 4 -12 Z"></path>
					<circle class="rtu-tipw" cx="-64" cy="29" r="5"></circle>
					<circle class="rtu-tipw" cx="64" cy="29" r="5"></circle>
					<!-- seen from the front: the body behind and above the head, the head just above the beak -->
					<ellipse class="rtu-body" cx="0" cy="-24" rx="10" ry="15"></ellipse>
					<path class="rtu-tail" d="M-5 -38 L0 -50 L5 -38 Z"></path>
					<circle class="rtu-head" cx="0" cy="-10" r="7"></circle>
					<path class="rtu-beak" d="M-2.6 -5 L0 0 L2.6 -5 Z"></path>
					<circle class="rtu-eye" cx="-2.6" cy="-12" r="1.1"></circle>
					<circle class="rtu-eye" cx="2.6" cy="-12" r="1.1"></circle>
					<g set:html={cgMark(0, 20, 3.5)}></g>
				</g>
			</svg>
			<figcaption><b>Птичка-балансир.</b> Грузики в концах крыльев опускают центр тяжести ниже клюва. Птичка качается и возвращается: равновесие устойчивое.</figcaption>
		</figure>
		<figure class="rt-panel">
			<svg class="g7__svg" viewBox="0 0 200 150" role="img" aria-label="Двухэтажный автобус на наклонной платформе, вид сзади: вертикаль через центр тяжести проходит между колёсами" data-bus>
				<rect class="rt-ground" x="0" y="140" width="200" height="10"></rect>
				<path class="rtu-pivot" d="M150 140 l-5 -8 h10 Z"></path>
				<g data-tilt>
					<rect class="rtu-platform" x="40" y="128" width="114" height="5"></rect>
					<rect class="rtu-bus" x={97 - 21.7} y={128 - 8 - 74.8} width="43.4" height="74.8" rx="4"></rect>
					<rect class="rtu-win" x={97 - 18} y={128 - 8 - 66} width="36" height="16" rx="2"></rect>
					<rect class="rtu-win" x={97 - 18} y={128 - 8 - 38} width="36" height="16" rx="2"></rect>
					<rect class="rtu-light" x={97 - 19} y={128 - 8 - 12} width="6" height="3"></rect>
					<rect class="rtu-light" x={97 + 13} y={128 - 8 - 12} width="6" height="3"></rect>
					<rect class="rtu-wheel" x={97 - 17.9 - 4} y="118" width="8" height="10" rx="2"></rect>
					<rect class="rtu-wheel" x={97 + 17.9 - 4} y="118" width="8" height="10" rx="2"></rect>
					<rect class="rtu-track" x={97 - 17.9} y="126.5" width="35.8" height="2.5"></rect>
				</g>
				<path class="rt-dash rt-s--grav" data-vert></path>
				<g data-cg></g>
			</svg>
			<figcaption><b>Двухэтажный автобус.</b> Его проверяют на наклонной платформе: вертикаль через центр тяжести должна проходить между колёсами.</figcaption>
		</figure>
	</div>
</figure>

<style is:global>
	.rtu .g7__grid.is-two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@container (min-width: 36rem) {
		.rtu .g7__grid.is-two {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.rtu-lattice { fill: none; stroke: hsl(45, 85%, 55%); stroke-width: 1.4; }
	.rtu-jib { fill: hsl(45, 85%, 55%); }
	.rtu-cab { fill: var(--sl-color-gray-4); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-weight { fill: var(--sl-color-gray-3); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-trolley { fill: var(--sl-color-gray-3); }
	.rtu-cable { fill: none; stroke: var(--g7-ink); stroke-width: 0.9; }
	.rtu-hook { fill: none; stroke: var(--g7-ink); stroke-width: 1.4; }
	.rtu-crate { fill: var(--g7-wood); stroke: var(--g7-wood-dark); stroke-width: 0.8; }
	.rtu-marble { fill: hsl(40, 30%, 86%); stroke: hsl(35, 15%, 45%); stroke-width: 0.9; }
	:root[data-theme='light'] .rtu-marble { fill: hsl(40, 30%, 92%); }
	.rtu-tier { stroke: hsl(35, 15%, 55%); stroke-width: 0.8; }
	.rtu-base { fill: var(--rt-n); }
	.rtu-stand { fill: var(--sl-color-gray-4); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-wing { fill: hsl(200, 70%, 55%); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-tipw { fill: var(--sl-color-gray-3); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-body { fill: hsl(200, 75%, 45%); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-head { fill: hsl(200, 80%, 60%); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-tail { fill: hsl(200, 70%, 40%); }
	.rtu-beak { fill: hsl(35, 90%, 55%); stroke: var(--g7-ink); stroke-width: 0.5; }
	.rtu-eye { fill: var(--g7-paper); }
	.rtu-pivot { fill: var(--sl-color-gray-3); }
	.rtu-platform { fill: var(--sl-color-gray-3); stroke: var(--g7-ink); stroke-width: 0.8; }
	.rtu-bus { fill: hsl(0, 70%, 48%); stroke: var(--g7-ink); stroke-width: 0.9; }
	.rtu-win { fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-6)); stroke: var(--g7-ink); stroke-width: 0.6; }
	.rtu-light { fill: hsl(45, 95%, 65%); }
	.rtu-wheel { fill: var(--g7-ink); }
	.rtu-track { fill: var(--rt-n); }
</style>

<script>
	import { loop } from '../g7/kit';
	import { cgMark } from './rt';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-rtu]')) {
		const crane = root.querySelector<SVGSVGElement>('[data-crane]')!;
		const trolley = crane.querySelector<SVGGElement>('[data-trolley]')!;
		const cable = crane.querySelector<SVGPathElement>('[data-cable]')!;
		const hook = crane.querySelector<SVGPathElement>('[data-hook]')!;
		const crates = crane.querySelector<SVGGElement>('[data-crates]')!;
		const bird = root.querySelector<SVGGElement>('[data-bird]')!;
		const bus = root.querySelector<SVGSVGElement>('[data-bus]')!;
		const tiltG = bus.querySelector<SVGGElement>('[data-tilt]')!;
		const vert = bus.querySelector<SVGPathElement>('[data-vert]')!;
		const busCg = bus.querySelector<SVGGElement>('[data-cg]')!;
		let t = 0;
		const draw = () => {
			// 1. the crane: the reach from 2,5 to 6 units (one unit = 17 px from the mast's axis at x = 70), 4 с each way
			const ph = (t % 8) / 4;
			const reach = 2.5 + 3.5 * ease(ph <= 1 ? ph : 2 - ph);
			const x = 70 + reach * 17;
			trolley.setAttribute('transform', `translate(${x.toFixed(1)} 0)`);
			const n = Math.round(30 / reach); // the moment of the load stays the same
			const rows = Math.ceil(n / 3);
			const yTop = 120 - rows * 7; // the crates hang with their bottom 120 px down
			cable.setAttribute('d', `M0 39 V${(yTop - 8).toFixed(1)}`);
			const half = (Math.min(3, n) * 7) / 2;
			hook.setAttribute('d', `M0 ${(yTop - 8).toFixed(1)} q3 0 3 3 q0 3 -3 3 M${-half} ${yTop} L0 ${(yTop - 5).toFixed(1)} L${half} ${yTop}`);
			let h = '';
			for (let i = 0; i < n; i++) {
				const r = Math.floor(i / 3);
				const c = i % 3;
				h += `<rect class="rtu-crate" x="${(-((Math.min(3, n - r * 3) * 7) / 2) + c * 7).toFixed(1)}" y="${(120 - (r + 1) * 7).toFixed(1)}" width="7" height="7"></rect>`;
			}
			crates.innerHTML = h;
			// 3. the bird rocks about its beak (the tip of the stand at (100, 52))
			const tb = t % 6;
			const th = 15 * Math.exp(-tb / 2) * Math.cos((2 * Math.PI * tb) / 1.2);
			bird.setAttribute('transform', `translate(100 52) rotate(${th.toFixed(2)})`);
			// 4. the bus: tilts about the platform's right end to 28° in 3 с, holds 1 с, back in 3 с, rests 1 с
			const tt = t % 8;
			const a = ((28 * Math.PI) / 180) * (tt < 3 ? ease(tt / 3) : tt < 4 ? 1 : tt < 7 ? 1 - ease((tt - 4) / 3) : 0);
			const P = { x: 150, y: 132 };
			tiltG.setAttribute('transform', `rotate(${((a * 180) / Math.PI).toFixed(2)} ${P.x} ${P.y})`);
			// the center of gravity: 1,5 м = 25,5 px above the road at the bus's middle (x = 97, road y = 128)
			const lx = 97 - P.x;
			const ly = 128 - 25.5 - P.y;
			// turned clockwise about P: the left side of the platform rises
			const cx = P.x + lx * Math.cos(a) - ly * Math.sin(a);
			const cy = P.y + lx * Math.sin(a) + ly * Math.cos(a);
			busCg.innerHTML = cgMark(cx, cy, 3.5);
			// the vertical down to the road plane (the platform)
			const Q = { x: P.x + 4 * Math.sin(a), y: P.y - 4 * Math.cos(a) }; // the platform's top at the pivot
			const ry = Q.y + (cx - Q.x) * Math.tan(a);
			vert.setAttribute('d', `M${cx.toFixed(1)} ${cy.toFixed(1)} V${ry.toFixed(1)}`);
		};
		loop(root, (dt) => {
			t = (t + dt) % 24;
			draw();
			return true;
		})();
		draw();
	}
</script>
