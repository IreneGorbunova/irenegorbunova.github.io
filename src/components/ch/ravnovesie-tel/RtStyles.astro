---
/**
 * Colors and marks of the pictures and models of «Равновесие тел» (grade 10), on top of the grade-7 frame (G7Styles).
 * Renders nothing. One color per quantity in the whole chapter: the force of gravity blue, the weight of a person red,
 * the tension of a thread, cable or rope green, the reactions of supports, floor and wall violet, the force of a hand
 * teal, friction orange, the arm of a force gold, the resultant ink. Classes: .rt-f--<c> fills an arrow path, .rt-s--<c>
 * strokes a line, .rt-t--<c> colors a text; c = grav, p, t, n, f, fr, d, ink. The center of gravity: .rt-cg (cgMark in
 * rt.ts). Vector arrows over letters: .rt-ov (vecArrow in rt.ts).
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<style is:global>
	.g7 {
		--rt-grav: var(--g7-blue);
		--rt-p: var(--g7-red);
		--rt-t: var(--g7-green);
		--rt-n: var(--g7-violet);
		--rt-f: hsl(178, 62%, 52%);
		--rt-fr: hsl(20, 95%, 60%);
		--rt-d: var(--g7-gold);
		--rt-ink: var(--g7-ink);
	}
	:root[data-theme='light'] .g7 {
		--rt-f: hsl(178, 85%, 27%);
		--rt-fr: hsl(16, 90%, 42%);
	}
	.rt-f--grav { fill: var(--rt-grav); }
	.rt-f--p { fill: var(--rt-p); }
	.rt-f--t { fill: var(--rt-t); }
	.rt-f--n { fill: var(--rt-n); }
	.rt-f--f { fill: var(--rt-f); }
	.rt-f--fr { fill: var(--rt-fr); }
	.rt-f--d { fill: var(--rt-d); }
	.rt-f--ink { fill: var(--rt-ink); }
	.rt-s--grav { stroke: var(--rt-grav); }
	.rt-s--p { stroke: var(--rt-p); }
	.rt-s--t { stroke: var(--rt-t); }
	.rt-s--n { stroke: var(--rt-n); }
	.rt-s--f { stroke: var(--rt-f); }
	.rt-s--fr { stroke: var(--rt-fr); }
	.rt-s--d { stroke: var(--rt-d); }
	.rt-s--ink { stroke: var(--rt-ink); }
	.g7__svg .rt-t--grav { fill: var(--rt-grav); }
	.g7__svg .rt-t--p { fill: var(--rt-p); }
	.g7__svg .rt-t--t { fill: var(--rt-t); }
	.g7__svg .rt-t--n { fill: var(--rt-n); }
	.g7__svg .rt-t--f { fill: var(--rt-f); }
	.g7__svg .rt-t--fr { fill: var(--rt-fr); }
	.g7__svg .rt-t--d { fill: var(--rt-d); }
	.g7__svg .rt-t--ink { fill: var(--rt-ink); }
	.g7__svg .rt-sym {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 15px;
		font-weight: 700;
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.g7__svg .rt-sub {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 10.5px;
		font-weight: 600;
	}
	.g7__svg .rt-ov {
		fill: none;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.g7__svg .rt-ov--halo {
		stroke: var(--g7-paper);
		stroke-width: 4;
	}
	.g7__svg .rt-lab {
		font-size: 11.5px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.g7__svg .rt-head {
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.rt-cg__l {
		fill: var(--g7-paper);
	}
	.rt-cg__d {
		fill: var(--g7-ink);
	}
	.rt-cg__o {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.1;
	}
	.rt-dash {
		fill: none;
		stroke-width: 1.3;
		stroke-dasharray: 4 3;
	}
	.rt-arm {
		fill: none;
		stroke: var(--rt-d);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.rt-lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
	}
	.rt-axis {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.rt-wood {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.rt-metal {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.rt-ground {
		fill: var(--g7-ground);
	}
	.rt-gline {
		stroke: var(--g7-line);
		stroke-width: 1.4;
		fill: none;
	}
	.rt-hatch {
		stroke: var(--g7-line);
		stroke-width: 0.9;
		fill: none;
	}
	.rt-thread {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.3;
		fill: none;
	}
	.rt-dot {
		fill: var(--g7-ink);
	}
	.rt-area {
		fill: color-mix(in oklab, var(--rt-n) 30%, transparent);
		stroke: var(--rt-n);
		stroke-width: 1.2;
	}
	.rt-panel {
		margin: 0;
		display: flex;
		flex-direction: column;
	}
	.rt-panel figcaption {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.rt-panel figcaption i,
	.g7__caption i {
		font-family: var(--ig-font-math);
	}
	.g7__lines .rt-k {
		font-weight: 600;
	}
</style>
