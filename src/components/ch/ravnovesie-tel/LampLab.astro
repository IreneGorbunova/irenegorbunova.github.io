---
/**
 * «Фонарь на тросе»: a street lamp of mass m (10…30 кг) hangs in the middle of a cable stretched between two poles 11 м
 * apart; each half of the cable makes an angle α (10…50°) with the horizontal. Three forces act on the hook: the force
 * of gravity m·g⃗ down (blue) and the two forces of tension of the cable T⃗₁ and T⃗₂ along its halves (green). They are
 * in equilibrium when their vector sum is zero; in projections on the vertical 2T·sin α = mg, so T = mg / (2 sin α).
 * The dashed parallelogram adds the two forces of the cable: their sum (dashed ink) is equal to mg and opposite to m·g⃗.
 * «Сложить цепочкой» moves the three arrows (0,8 с, the same lengths and directions) tip to tail into a closed
 * triangle under the lamp (or to its right when the lamp hangs low): m·g⃗ down, T⃗₂ up and to the right, T⃗₁ up and to the left, ending at the tail of m·g⃗.
 *
 * Scales: the street 20 px per metre (the sag of the cable is to scale: 5,5 м · tg α); the forces 0,12 px per newton
 * (the largest, 30 кг at 10°, 847 Н — 102 px, shorter than half the cable). Checked: 20 кг, 30° → T = 196 Н;
 * 10° → 564 Н; 50° → 128 Н.
 */
import RtStyles from './RtStyles.astro';
---

<RtStyles />
<figure class="g7 g7--stack lmp not-content" data-lmp>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 236" role="img" aria-label="Фонарь висит на тросе между двумя столбами; показаны сила тяжести и силы натяжения троса" data-svg>
			<g class="lmp__houses">
				<rect x="40" y="150" width="60" height="70"></rect>
				<rect x="150" y="166" width="90" height="54"></rect>
				<rect x="290" y="140" width="70" height="80"></rect>
			</g>
			<rect class="lmp__road" x="0" y="220" width="400" height="16"></rect>
			<rect class="lmp__pole" x="84" y="34" width="6" height="186"></rect>
			<rect class="lmp__pole" x="310" y="34" width="6" height="186"></rect>
			<path class="lmp__cable" data-cable></path>
			<g data-lamp>
				<path class="lmp__lamp" d="M-14 10 Q0 0 14 10 Z"></path>
				<rect class="lmp__lamp" x="-2" y="0" width="4" height="4"></rect>
				<path class="lmp__glow" d="M-12 10 Q0 18 12 10 Z"></path>
			</g>
			<path class="lmp__para" data-para></path>
			<path class="rt-dash rt-s--ink" data-sum></path>
			<path class="rt-f--ink" data-sumh></path>
			<path class="rt-f--t" data-t1></path>
			<path class="rt-f--t" data-t2></path>
			<path class="rt-f--grav" data-mg></path>
			<circle class="rt-dot" r="2.2" data-hook></circle>
			<path class="lmp__arc" data-arc></path>
			<path class="lmp__hor" data-hor></path>
			<text class="t-i t-halo" data-la>α</text>
			<text class="rt-sym rt-t--t" data-rtv="0" data-l1>T<tspan class="rt-sub" dy="4">1</tspan></text>
			<text class="rt-sym rt-t--t" data-rtv="0" data-l2>T<tspan class="rt-sub" dy="4">2</tspan></text>
			<text class="rt-sym rt-t--grav" data-rtv="1" data-lm>mg</text>
		</svg>
		<div class="g7__side lmp__side">
			<label class="g7__slider">
				<span>Масса фонаря <i>m</i></span>
				<output data-om></output>
				<input type="range" min="10" max="30" step="5" value="20" data-m aria-label="Масса фонаря, килограммы" />
			</label>
			<label class="g7__slider">
				<span>Угол троса <i>α</i></span>
				<output data-oa></output>
				<input type="range" min="10" max="50" step="5" value="30" data-a aria-label="Угол троса с горизонталью, градусы" />
			</label>
			<button type="button" class="g7__btn lmp__chain" aria-pressed="false" data-chain>Сложить цепочкой</button>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Улица и провисание троса — в масштабе, силы — 0,12&nbsp;px на ньютон, <i>g</i>&nbsp;=&nbsp;9,8&nbsp;м/с². Зелёные стрелки — силы натяжения троса, синяя — сила тяжести. Пунктиром сложены две силы натяжения: их сумма равна <i>mg</i> и направлена вверх. «Сложить цепочкой» ставит те же три стрелки одну за другой.
	</figcaption>
</figure>

<style is:global>
	.lmp__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.lmp__side .g7__lines {
		grid-column: 1 / -1;
	}
	.lmp__side .lmp__chain {
		grid-column: 1 / -1;
		justify-self: start;
	}
	.g7__svg .lmp__houses rect {
		fill: var(--g7-faint);
	}
	.g7__svg .lmp__road {
		fill: var(--g7-line);
	}
	.g7__svg .lmp__pole {
		fill: var(--g7-steel);
	}
	.g7__svg .lmp__cable {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.g7__svg .lmp__lamp {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.g7__svg .lmp__glow {
		fill: hsl(50, 95%, 72%);
	}
	.g7__svg .lmp__para {
		fill: none;
		stroke: var(--rt-t);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.g7__svg .lmp__hor {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
	}
	.g7__svg .lmp__arc {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
</style>

<script>
	import { fmtInt, k, tex, loop } from '../g7/kit';
	import { arrowPath, place, along, rings, segOf, type Seg, type Box } from './rt';

	const g = 9.8;
	const KF = 0.12; // px per newton
	const XL = 90;
	const XR = 310;
	const YT = 40;
	const VIEW: Box = { x0: 2, y0: 2, x1: 398, y1: 234 };
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	type P = { x: number; y: number };
	for (const root of document.querySelectorAll<HTMLElement>('[data-lmp]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const mIn = q<HTMLInputElement>('[data-m]');
		const aIn = q<HTMLInputElement>('[data-a]');
		const chainBtn = q<HTMLButtonElement>('[data-chain]');
		let chain = 0; // 0 = at the hook, 1 = in a chain
		let target = 0;
		const draw = () => {
			const m = Number(mIn.value);
			const al = Number(aIn.value);
			const r = (al * Math.PI) / 180;
			q('[data-om]').textContent = `${m} кг`;
			q('[data-oa]').textContent = `${al}°`;
			const half = (XR - XL) / 2; // 110 px = 5,5 м
			const xm = (XL + XR) / 2;
			const ym = YT + half * Math.tan(r);
			q('[data-cable]').setAttribute('d', `M${XL} ${YT} L${xm} ${ym.toFixed(1)} L${XR} ${YT}`);
			q('[data-lamp]').setAttribute('transform', `translate(${xm} ${ym.toFixed(1)})`);
			q('[data-hook]').setAttribute('cx', String(xm));
			q('[data-hook]').setAttribute('cy', ym.toFixed(1));
			const mg = m * g;
			const T = mg / (2 * Math.sin(r));
			const lt = KF * T;
			const lm = KF * mg;
			const c = Math.cos(r);
			const s = Math.sin(r);
			const e = ease(chain);
			// tails at the hook and in the chain (C: the tail of m·g⃗ in the chain, beside the lamp)
			// under the lamp when there is room above the road, otherwise to the right of the lamp
			const below = ym + 22 + lm < 214;
			const C = below ? { x: xm - (lt * c) / 2, y: ym + 22 } : { x: xm + 22, y: ym - lm / 2 + 9 };
			const mix = (a: P, b: P): P => ({ x: a.x + (b.x - a.x) * e, y: a.y + (b.y - a.y) * e });
			const tMg = mix({ x: xm, y: ym + 14 }, C);
			const tT2 = mix({ x: xm, y: ym }, { x: C.x, y: C.y + lm });
			const tT1 = mix({ x: xm, y: ym }, { x: C.x + lt * c, y: C.y + lm - lt * s });
			const v1 = { x: -lt * c, y: -lt * s };
			const v2 = { x: lt * c, y: -lt * s };
			const vm = { x: 0, y: lm };
			const segs: Seg[] = [];
			const put = (sel: string, t: P, v: P) => {
				q(sel).setAttribute('d', arrowPath(t.x, t.y, t.x + v.x, t.y + v.y, 3, 9));
				segs.push(segOf(t.x, t.y, t.x + v.x, t.y + v.y, 4));
			};
			put('[data-t1]', tT1, v1);
			put('[data-t2]', tT2, v2);
			put('[data-mg]', tMg, vm);
			// the parallelogram and the sum fade out on the way to the chain
			const op = String(Math.max(0, 1 - 2 * e));
			q('[data-para]').setAttribute('d', `M${(xm - lt * c).toFixed(1)} ${(ym - lt * s).toFixed(1)} L${xm} ${(ym - 2 * lt * s).toFixed(1)} L${(xm + lt * c).toFixed(1)} ${(ym - lt * s).toFixed(1)}`);
			q('[data-sum]').setAttribute('d', `M${xm} ${ym} V${(ym - 2 * lt * s + 9).toFixed(1)}`);
			q('[data-sumh]').setAttribute('d', arrowPath(xm, ym - 2 * lt * s + 10, xm, ym - 2 * lt * s, 2, 9));
			for (const sel of ['[data-para]', '[data-sum]', '[data-sumh]']) q(sel).setAttribute('opacity', op);
			if (e < 0.5) {
				segs.push(segOf(xm, ym, xm, ym - 2 * lt * s, 3));
				segs.push(segOf(xm - lt * c, ym - lt * s, xm, ym - 2 * lt * s, 1.5), segOf(xm + lt * c, ym - lt * s, xm, ym - 2 * lt * s, 1.5));
			}
			// the cable, the poles and the lamp as obstacles
			segs.push(segOf(XL, YT, xm, ym, 1.5), segOf(xm, ym, XR, YT, 1.5), segOf(87, 34, 87, 220, 4), segOf(313, 34, 313, 220, 4));
			const boxes: Box[] = [{ x0: xm - 15, y0: ym - 1, x1: xm + 15, y1: ym + 19 }];
			// the angle at the right pole
			const R = 26;
			q('[data-arc]').setAttribute('d', `M${XR - R} ${YT} A${R} ${R} 0 0 0 ${(XR - R * c).toFixed(1)} ${(YT + R * s).toFixed(1)}`);
			q('[data-hor]').setAttribute('d', `M${XR} ${YT} H${XR - R - 10}`);
			segs.push(segOf(XR, YT, XR - R - 10, YT, 1));
			const bis = r / 2;
			place(q<SVGTextElement>('[data-la]'), [
				{ x: XR - (R + 11) * Math.cos(bis), y: YT + (R + 11) * Math.sin(bis) + 5, anchor: 'middle' },
				{ x: XR - R - 14, y: YT - 4, anchor: 'end' },
				{ x: XR - R + 2, y: YT - 5, anchor: 'middle' },
				{ x: XR - (R + 20) * Math.cos(bis), y: YT + (R + 20) * Math.sin(bis) + 5, anchor: 'middle' },
				{ x: XR - R - 26, y: YT - 4, anchor: 'end' },
				{ x: XR - 18, y: YT + 22, anchor: 'middle' },
				{ x: XR - 8, y: YT + 26, anchor: 'middle' },
			], segs, boxes, VIEW);
			const mid = (t: P, v: P) => ({ x: t.x + v.x / 2, y: t.y + v.y / 2 });
			place(q('[data-lm]'), [...along(tMg.x, tMg.y, tMg.x + vm.x, tMg.y + vm.y, 16), ...rings(mid(tMg, vm).x, mid(tMg, vm).y, 0)], segs, boxes, VIEW);
			place(q('[data-l1]'), [...along(tT1.x, tT1.y, tT1.x + v1.x, tT1.y + v1.y, 14), ...rings(tT1.x + v1.x, tT1.y + v1.y, Math.PI)], segs, boxes, VIEW);
			place(q('[data-l2]'), [...along(tT2.x, tT2.y, tT2.x + v2.x, tT2.y + v2.y, 14), ...rings(tT2.x + v2.x, tT2.y + v2.y, 0)], segs, boxes, VIEW);
			const lines = [
				k(`mg = ${m}\\cdot 9{,}8 = ${tex(fmtInt(mg))}~\\text{Н}`),
				k(`2T\\sin\\alpha = mg`),
				k(`T = \\dfrac{mg}{2\\sin\\alpha} = \\dfrac{${tex(fmtInt(mg))}}{2\\sin ${al}^\\circ} \\approx ${tex(fmtInt(T))}~\\text{Н}`),
			];
			if (target) lines.push(k(`\\vec T_1 + \\vec T_2 + m\\vec g = 0`));
			q('[data-lines]').innerHTML = lines.map((h, i) => `<li${i === 2 ? ' class="is-key"' : ''}>${h}</li>`).join('');
		};
		const wake = loop(root, (dt) => {
			const d = target - chain;
			if (Math.abs(d) < 1e-3) {
				chain = target;
				draw();
				return false;
			}
			chain += Math.sign(d) * Math.min(Math.abs(d), dt / 0.8);
			draw();
			return true;
		});
		chainBtn.addEventListener('click', () => {
			target = target ? 0 : 1;
			chainBtn.setAttribute('aria-pressed', String(!!target));
			wake();
		});
		for (const inp of [mIn, aIn]) inp.addEventListener('input', draw);
		draw();
		// the fonts load late: measure the labels again
		document.fonts?.ready.then(draw);
	}
</script>
