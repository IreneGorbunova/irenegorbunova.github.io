---
/**
 * «Фонарь на тросе»: a street lamp of mass m (10…30 кг) hangs in the middle of a cable stretched between two poles 11 м
 * apart; each half of the cable makes an angle α (10…50°) with the horizontal. Three forces act on the hook: the force
 * of gravity mg down and the two forces of the cable T along its halves. They are in equilibrium when their vector
 * sum is zero: 2T·sin α = mg, so T = mg / (2 sin α). The dashed parallelogram adds the two forces of the cable: their
 * sum (dashed gold) is equal to mg and opposite to it.
 *
 * Scales: the street 20 px per metre (the sag of the cable is to scale: 5,5 м · tg α); the forces 0,12 px per newton
 * (the largest, 30 кг at 10°, 847 Н — 102 px, shorter than half the cable).
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
---

<G7Styles />
<figure class="g7 g7--stack lmp not-content" data-lmp>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 236" role="img" aria-label="Фонарь висит на тросе между двумя столбами; показаны сила тяжести и силы натяжения троса" data-svg>
			<defs>
				{['g', 'b', 'o'].map((c) => (
					<marker id={`lmp-${c}-${uid}`} viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.7" markerHeight="2.7" orient="auto">
						<path class={c === 'g' ? 'head--green' : c === 'b' ? 'head--blue' : 'head--gold'} d="M0,0 L10,5 L0,10 z"></path>
					</marker>
				))}
			</defs>
			<g class="lmp__houses">
				<rect x="40" y="150" width="60" height="70"></rect>
				<rect x="150" y="166" width="90" height="54"></rect>
				<rect x="290" y="140" width="70" height="80"></rect>
			</g>
			<rect class="lmp__road" x="0" y="220" width="400" height="16"></rect>
			<rect class="lmp__pole" x="84" y="34" width="6" height="186"></rect>
			<rect class="lmp__pole" x="310" y="34" width="6" height="186"></rect>
			<path class="lmp__cable" data-cable></path>
			<g data-lamp>
				<path class="lmp__lamp" d="M-14 10 Q0 0 14 10 Z"></path>
				<rect class="lmp__lamp" x="-2" y="0" width="4" height="4"></rect>
				<path class="lmp__glow" d="M-12 10 Q0 18 12 10 Z"></path>
			</g>
			<path class="lmp__para" data-para></path>
			<line class="arrow arrow--gold lmp__sum" data-sum marker-end={`url(#lmp-o-${uid})`}></line>
			<line class="arrow arrow--green" data-t1 marker-end={`url(#lmp-g-${uid})`}></line>
			<line class="arrow arrow--green" data-t2 marker-end={`url(#lmp-g-${uid})`}></line>
			<line class="arrow arrow--blue" data-mg marker-end={`url(#lmp-b-${uid})`}></line>
			<text class="t-i t-green t-halo" data-l1>T</text>
			<text class="t-i t-green t-halo" data-l2>T</text>
			<text class="t-i t-blue t-halo" data-lm>mg</text>
			<path class="lmp__arc" data-arc></path>
			<text class="t-i t-halo" data-la>α</text>
		</svg>
		<div class="g7__side lmp__side">
			<label class="g7__slider">
				<span>Масса фонаря <i>m</i></span>
				<output data-om></output>
				<input type="range" min="10" max="30" step="5" value="20" data-m aria-label="Масса фонаря, килограммы" />
			</label>
			<label class="g7__slider">
				<span>Угол троса <i>α</i></span>
				<output data-oa></output>
				<input type="range" min="10" max="50" step="5" value="30" data-a aria-label="Угол троса с горизонталью, градусы" />
			</label>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Улица и провисание троса — в масштабе, силы — 0,12&nbsp;px на ньютон, <i>g</i>&nbsp;=&nbsp;9,8&nbsp;м/с². Зелёные стрелки — силы, с которыми трос тянет крюк фонаря, синяя — сила тяжести. Пунктиром сложены две силы троса: их сумма равна <i>mg</i> и направлена вверх.
	</figcaption>
</figure>

<style is:global>
	.lmp__side {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: end;
	}
	.lmp__side .g7__lines {
		grid-column: 1 / -1;
	}
	.g7__svg .lmp__houses rect {
		fill: var(--g7-faint);
	}
	.g7__svg .lmp__road {
		fill: var(--g7-line);
	}
	.g7__svg .lmp__pole {
		fill: var(--g7-steel);
	}
	.g7__svg .lmp__cable {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.g7__svg .lmp__lamp {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.g7__svg .lmp__glow {
		fill: hsl(50, 95%, 72%);
	}
	.g7__svg .lmp__para {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.g7__svg .lmp__sum {
		stroke-dasharray: 5 4;
		stroke-width: 2;
	}
	.g7__svg .lmp__arc {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
</style>

<script>
	import { fmt, fmtInt, k, tex } from '../g7/kit';

	const g = 9.8;
	const PX = 20; // px per metre
	const KF = 0.12; // px per newton
	const XL = 90;
	const XR = 310;
	const YT = 40;
	const HEAD = 7;
	for (const root of document.querySelectorAll<HTMLElement>('[data-lmp]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const mIn = q<HTMLInputElement>('[data-m]');
		const aIn = q<HTMLInputElement>('[data-a]');
		const set = (e: Element, a: Record<string, number>) => {
			for (const [n, v] of Object.entries(a)) e.setAttribute(n, v.toFixed(1));
		};
		const arrow = (e: Element, x: number, y: number, dx: number, dy: number) => {
			const L = Math.hypot(dx, dy);
			const f = L > HEAD ? (L - HEAD) / L : 0.01;
			set(e, { x1: x, y1: y, x2: x + dx * f, y2: y + dy * f });
		};
		const draw = () => {
			const m = Number(mIn.value);
			const al = Number(aIn.value);
			const r = (al * Math.PI) / 180;
			q('[data-om]').textContent = `${m} кг`;
			q('[data-oa]').textContent = `${al}°`;
			const half = (XR - XL) / 2; // 110 px = 5,5 м
			const xm = (XL + XR) / 2;
			const ym = YT + half * Math.tan(r);
			q('[data-cable]').setAttribute('d', `M${XL} ${YT} L${xm} ${ym.toFixed(1)} L${XR} ${YT}`);
			q('[data-lamp]').setAttribute('transform', `translate(${xm} ${ym.toFixed(1)})`);
			const mg = m * g;
			const T = mg / (2 * Math.sin(r));
			const lt = KF * T;
			const lm = KF * mg;
			const c = Math.cos(r);
			const s = Math.sin(r);
			arrow(q('[data-t1]'), xm, ym, -lt * c, -lt * s);
			arrow(q('[data-t2]'), xm, ym, lt * c, -lt * s);
			arrow(q('[data-mg]'), xm, ym + 14, 0, lm);
			arrow(q('[data-sum]'), xm, ym, 0, -2 * lt * s);
			q('[data-para]').setAttribute('d', `M${(xm - lt * c).toFixed(1)} ${(ym - lt * s).toFixed(1)} L${xm} ${(ym - 2 * lt * s).toFixed(1)} L${(xm + lt * c).toFixed(1)} ${(ym - lt * s).toFixed(1)}`);
			set(q('[data-l1]'), { x: xm - lt * c - 4, y: ym - lt * s - 8 });
			set(q('[data-l2]'), { x: xm + lt * c - 4, y: ym - lt * s - 8 });
			set(q('[data-lm]'), { x: xm + 8, y: ym + 14 + lm / 2 + 8 });
			// the angle at the right pole
			const R = 26;
			q('[data-arc]').setAttribute('d', `M${XR - R} ${YT} A${R} ${R} 0 0 0 ${(XR - R * c).toFixed(1)} ${(YT + R * s).toFixed(1)}`);
			set(q('[data-la]'), { x: XR - R - 14, y: YT + 12 + R * s * 0.3 });
			q('[data-lines]').innerHTML = [
				k(`mg = ${m}\\cdot 9{,}8 = ${tex(fmtInt(mg))}~\\text{Н}`),
				k(`2T\\sin\\alpha = mg`),
				k(`T = \\dfrac{mg}{2\\sin\\alpha} = \\dfrac{${tex(fmtInt(mg))}}{2\\sin ${al}^\\circ} \\approx ${tex(fmtInt(T))}~\\text{Н}`),
			]
				.map((h, i) => `<li${i === 2 ? ' class="is-key"' : ''}>${h}</li>`)
				.join('');
			void fmt;
		};
		for (const inp of [mIn, aIn]) inp.addEventListener('input', draw);
		draw();
	}
</script>
