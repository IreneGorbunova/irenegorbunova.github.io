---
/**
 * Picture to the definitions of the solar and the lunar eclipse: two panels, side view, not to scale (the true
 * distances would not fit). In both the Moon crosses the line Sun — Earth from top to bottom.
 * Left, solar eclipse: Sun — Moon — Earth. The Moon's shadow is the cone bounded by the outer common tangents of the
 *   Sun and the Moon (its tip just pierces the Earth's surface: a small dark spot), the penumbra lies between the
 *   inner tangents. While the Moon passes, its shadow and penumbra sweep across the Earth.
 * Right, lunar eclipse: Sun — Earth — Moon. The Earth's shadow cone (the Moon's place in it is 2,8 Moon diameters
 *   wide here, 2,6 in reality) and penumbra are fixed; the Moon passes through them and darkens to a dull red in the
 *   shadow, slightly in the penumbra.
 * Plays while visible, «Повторить» restarts.
 */
import PicFrame from './PicFrame.astro';

const uid = Math.random().toString(36).slice(2, 8);
const id = (n: string) => `ep-${n}-${uid}`;
---

<PicFrame data-eclipsepic>
	<div class="svp__panel">
		<svg class="svp__svg" viewBox="0 0 330 220" role="img" aria-label="Солнечное затмение: Луна проходит между Солнцем и Землёй, её тень и полутень падают на Землю. Рисунок не в масштабе" data-solar>
			<defs>
				<clipPath id={id('earth')}><circle cx="352" cy="110" r="72"></circle></clipPath>
			</defs>
			<text class="svp-t svp-t--title" x="10" y="20">Солнечное затмение</text>
			<circle class="ep-sun" cx="20" cy="110" r="40"></circle>
			<polygon class="ep-pen" points="" data-pen></polygon>
			<polygon class="ep-umb" points="" data-umb></polygon>
			<circle class="ep-earth" cx="352" cy="110" r="72"></circle>
			<g clip-path={`url(#${id('earth')})`}>
				<polygon class="ep-pen ep-on" points="" data-pen2></polygon>
				<polygon class="ep-umb ep-on" points="" data-umb2></polygon>
			</g>
			<circle class="ep-moon" cx="230" cy="110" r="9" data-moon></circle>
			<text class="svp-t svp-t--small" x="8" y="168">Солнце</text>
			<text class="svp-t svp-t--small" x="230" y="110" text-anchor="middle" data-lmoon>Луна</text>
			<text class="svp-t svp-t--small" x="322" y="204" text-anchor="end">Земля</text>
			<text class="svp-t svp-t--small" x="10" y="212">не в масштабе</text>
		</svg>
	</div>
	<div class="svp__panel">
		<svg class="svp__svg" viewBox="0 0 330 220" role="img" aria-label="Лунное затмение: Земля между Солнцем и Луной. Луна проходит сквозь тень Земли и становится тёмно-красной. Рисунок не в масштабе" data-lunar>
			<text class="svp-t svp-t--title" x="10" y="20">Лунное затмение</text>
			<circle class="ep-sun" cx="20" cy="110" r="40"></circle>
			<polygon class="ep-pen" points="165,84 330,8.9 330,211.1 165,136"></polygon>
			<polygon class="ep-umb" points="165,84 330,99.9 330,120.1 165,136"></polygon>
			<circle class="ep-earth" cx="165" cy="110" r="26"></circle>
			<circle class="ep-moon" cx="290" cy="110" r="5" data-moon></circle>
			<text class="svp-t svp-t--small" x="8" y="168">Солнце</text>
			<text class="svp-t svp-t--small" x="165" y="154" text-anchor="middle">Земля</text>
			<text class="svp-t svp-t--small" x="290" y="110" text-anchor="middle" data-lmoon>Луна</text>
			<text class="svp-t svp-t--small" x="270" y="146" text-anchor="middle">тень Земли</text>
			<path class="ep-lead" d="M 270 134 L 270 120"></path>
			<text class="svp-t svp-t--small" x="10" y="212">не в масштабе</text>
		</svg>
	</div>
	<Fragment slot="cap">Солнечное затмение: Луна проходит между Солнцем и Землёй, и её тень падает на Землю. Лунное затмение: Земля оказывается между Солнцем и Луной, и Луна проходит сквозь тень Земли.</Fragment>
</PicFrame>

<style is:global>
	.ep-sun {
		fill: color-mix(in srgb, var(--ig-v) 70%, white);
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.ep-earth {
		fill: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-gray-5));
	}
	.ep-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ep-moon {
		fill: var(--sl-color-gray-2);
	}
	.ep-pen {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 22%, transparent);
	}
	.ep-umb {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 50%, transparent);
	}
	.ep-pen.ep-on {
		fill: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
	}
	.ep-umb.ep-on {
		fill: var(--sl-color-black);
	}
	:root[data-theme='light'] .ep-pen {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 30%, transparent);
	}
	:root[data-theme='light'] .ep-umb {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 55%, transparent);
	}
	:root[data-theme='light'] .ep-pen.ep-on {
		fill: color-mix(in srgb, var(--sl-color-white) 30%, transparent);
	}
	:root[data-theme='light'] .ep-umb.ep-on {
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);
	/** Share of a disc (centre offset e from the middle of a band of half-width w, radius r) inside the band. */
	const inBand = (e: number, r: number, w: number) => {
		// area of the disc below the line y = h (h measured from the centre): segment area
		const below = (h: number) => {
			if (h <= -r) return 0;
			if (h >= r) return Math.PI * r * r;
			return r * r * Math.acos(-h / r) + h * Math.sqrt(r * r - h * h);
		};
		return (below(w - e) - below(-w - e)) / (Math.PI * r * r);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-eclipsepic]')) {
		const solar = root.querySelector<SVGSVGElement>('[data-solar]')!;
		const lunar = root.querySelector<SVGSVGElement>('[data-lunar]')!;
		const q = <T extends Element>(svg: SVGSVGElement, s: string) => svg.querySelector<T>(s)!;
		const sMoon = q<SVGCircleElement>(solar, '[data-moon]');
		const sLabel = q<SVGTextElement>(solar, '[data-lmoon]');
		const polys = ['[data-pen]', '[data-umb]', '[data-pen2]', '[data-umb2]'].map((s) => q<SVGPolygonElement>(solar, s));
		const lMoon = q<SVGCircleElement>(lunar, '[data-moon]');
		const lLabel = q<SVGTextElement>(lunar, '[data-lmoon]');
		const S = { x: 20, y: 110, r: 40 };
		scene(root, 6, (x) => {
			const y = 64 + 92 * smooth(0.05, 0.95, x); // the Moon from above the line to below it
			// solar: cones from the Sun (S) and the Moon (M)
			const M = { x: 230, y, r: 9 };
			const dx = M.x - S.x;
			const dy = M.y - S.y;
			const D = Math.hypot(dx, dy);
			const ux = dx / D;
			const uy = dy / D;
			const nx = -uy;
			const ny = ux;
			const top = [M.x + nx * M.r, M.y + ny * M.r];
			const bot = [M.x - nx * M.r, M.y - ny * M.r];
			const L = (D * M.r) / (S.r - M.r); // the shadow's length beyond the Moon
			const T = [M.x + ux * L, M.y + uy * L];
			const X = D * (S.r / (S.r + M.r)); // the inner tangents cross here (from the Sun)
			const k = (D + 150 - X) / (D - X); // the penumbra's edges, carried on 150 px past the Moon
			const C = [S.x + ux * X, S.y + uy * X];
			const pt = (p: number[]) => `${f1(p[0])},${f1(p[1])}`;
			const far = (p: number[]) => [C[0] + (p[0] - C[0]) * k, C[1] + (p[1] - C[1]) * k];
			const umb = `${pt(top)} ${pt(T)} ${pt(bot)}`;
			const pen = `${pt(top)} ${pt(far(bot))} ${pt(far(top))} ${pt(bot)}`;
			polys[0].setAttribute('points', pen);
			polys[1].setAttribute('points', umb);
			polys[2].setAttribute('points', pen);
			polys[3].setAttribute('points', umb);
			sMoon.setAttribute('cy', f1(y));
			sLabel.setAttribute('y', f1(y - 14));
			// lunar: the Moon through the Earth's shadow (half-width 13,9 at x = 290) and penumbra (82,9)
			const ly = 30 + 160 * smooth(0.05, 0.95, x);
			const e = ly - 110;
			const sh = inBand(e, 5, 13.9);
			const pe = inBand(e, 5, 82.9) - sh;
			lMoon.setAttribute('cy', f1(ly));
			lMoon.style.fill = `color-mix(in srgb, color-mix(in srgb, var(--ig-vy) 45%, var(--sl-color-gray-5)) ${Math.round(100 * sh)}%, color-mix(in srgb, var(--sl-color-gray-2) ${Math.round(100 - 25 * pe)}%, var(--sl-color-gray-4)))`;
			lLabel.setAttribute('y', f1(ly - 10));
		});
	}
</script>
