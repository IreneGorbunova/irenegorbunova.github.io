---
/**
 * «Где сейчас Луна?» — the reverse of MoonPhases: the Moon as seen from the Earth (Northern
 * hemisphere) is shown, and the reader taps its place on the orbit (8 positions, 45° apart, top view
 * as in the model). The right position gets .is-right, a wrong one .is-wrong and shows how the Moon
 * would look from there. «Другая фаза» picks another phase.
 */
import SvStyles from './SvStyles.astro';

const CX = 150;
const CY = 118;
const RO = 88;
const RM = 11;
const RE = 20;
const positions = Array.from({ length: 8 }, (_, k) => {
	const e = (k * Math.PI) / 4;
	return { k, x: CX - RO * Math.cos(e), y: CY + RO * Math.sin(e) };
});
const rays = [22, 50, 78, 106, 134, 162, 190, 218];
---

<SvStyles />
<div class="sv-pick not-content" data-phasepick>
	<p class="sv-pick__q">Так Луна выглядит сейчас. Где она на орбите? Нажмите на её место.</p>
	<div class="sv-pick__grid">
		<div class="sv-pick__look">
			<canvas class="sv-pick__canvas" data-target role="img" aria-label="Луна, как её видно с Земли"></canvas>
			<span class="sv-pick__cap">вид с Земли</span>
		</div>
		<svg class="sv-pick__svg" viewBox="0 0 260 236" role="group" aria-label="Восемь мест Луны на орбите, вид сверху">
			{
				rays.map((y) => (
					<g class="sv-ray">
						<path class="sv-base" d={`M4 ${y} H34`} />
						<path class="sv-pick__head" d={`M30 ${y - 3} L37 ${y} L30 ${y + 3} Z`} />
					</g>
				))
			}
			<circle class="sv-pick__orbit" cx={CX} cy={CY} r={RO}></circle>
			<circle class="sv-mp__night" cx={CX} cy={CY} r={RE}></circle>
			<path class="sv-mp__day" d={`M${CX} ${CY - RE} A${RE} ${RE} 0 0 0 ${CX} ${CY + RE} Z`}></path>
			{
				positions.map((p) => (
					<g class="sv-pick__pos" data-k={p.k} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`} tabindex="0" role="button" aria-label={`Место ${p.k + 1}`}>
						<circle class="sv-pick__hit" r="19" />
						<circle class="sv-pick__ring" r={RM + 5} />
						<circle class="sv-mp__mnight" r={RM} />
						<path class="sv-mp__mday" d={`M0 ${-RM} A${RM} ${RM} 0 0 0 0 ${RM} Z`} />
					</g>
				))
			}
		</svg>
	</div>
	<div class="sv-pick__fb" aria-live="polite">
		<canvas class="sv-pick__mini" data-mini hidden aria-hidden="true"></canvas>
		<p data-fb>Свет Солнца идёт слева. Луна движется против часовой стрелки.</p>
	</div>
	<button type="button" class="sv-btn" data-next>Другая фаза</button>
</div>

<style is:global>
	.sv-pick {
		--mp-lit: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-white));
		--mp-dark: color-mix(in srgb, var(--sl-color-gray-4) 45%, var(--sl-color-black));
		--mp-day: var(--ig-vx);
		--mp-night: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-black));
	}
	:root[data-theme='light'] .sv-pick {
		--mp-lit: color-mix(in srgb, var(--ig-v) 30%, var(--ig-surface));
		--mp-dark: color-mix(in srgb, var(--sl-color-gray-2) 75%, var(--ig-surface));
		--mp-day: color-mix(in srgb, var(--ig-vx) 45%, var(--ig-surface));
		--mp-night: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-1));
	}
	.sv-pick .sv-mp__night {
		fill: var(--mp-night);
		stroke: color-mix(in srgb, var(--ig-vx) 60%, transparent);
		stroke-width: 1;
	}
	.sv-pick .sv-mp__day {
		fill: var(--mp-day);
	}
	.sv-pick .sv-mp__mnight {
		fill: var(--mp-dark);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.sv-pick .sv-mp__mday {
		fill: var(--mp-lit);
	}
	.sv-pick {
		margin-block: 1.25rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		--sv-light: var(--ig-v);
	}
	.sv-pick__q {
		margin: 0 0 0.6rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.sv-pick__grid {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 17rem);
		gap: 1rem;
		align-items: center;
	}
	.sv-pick__look {
		display: grid;
		justify-items: center;
		gap: 0.25rem;
	}
	.sv-pick__canvas {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 0.6rem;
	}
	.sv-pick__cap {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.sv-pick__svg {
		display: block;
		width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.sv-pick__head {
		fill: var(--ig-v);
		opacity: 0.85;
	}
	.sv-pick__orbit {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		stroke-dasharray: 2 5;
	}
	.sv-pick__pos {
		cursor: pointer;
		outline: none;
	}
	.sv-pick__hit {
		fill: transparent;
	}
	.sv-pick__ring {
		fill: none;
		stroke: transparent;
		stroke-width: 2.5;
		transition: stroke 0.2s;
	}
	.sv-pick__pos:hover .sv-pick__ring,
	.sv-pick__pos:focus-visible .sv-pick__ring {
		stroke: var(--sl-color-accent);
	}
	.sv-pick__pos.is-right .sv-pick__ring {
		stroke: var(--sl-color-green);
		fill: color-mix(in srgb, var(--sl-color-green) 25%, transparent);
	}
	.sv-pick__pos.is-wrong .sv-pick__ring {
		stroke: var(--sl-color-red);
		fill: color-mix(in srgb, var(--sl-color-red) 18%, transparent);
	}
	.sv-pick__fb {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 3.5rem;
		margin: 0.6rem 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.sv-pick__fb p {
		margin: 0;
	}
	.sv-pick__fb b {
		color: var(--sl-color-white);
	}
	.sv-pick__mini {
		flex: none;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 0.5rem;
	}
	.sv-pick__mini[hidden] {
		display: none;
	}
	@media (max-width: 40rem) {
		.sv-pick__grid {
			grid-template-columns: 6.5rem minmax(0, 1fr);
			gap: 0.6rem;
		}
	}
</style>

<script>
	import { drawMoonView, phaseName, dayOf } from './mp';

	const lower = (s: string) => s[0].toLowerCase() + s.slice(1);

	const WHY: Record<number, string> = {
		1: 'Прошло около 3,7 суток после новолуния: к нам повёрнут лишь краешек освещённой половины.',
		2: 'Луна прошла четверть пути: с Земли видна ровно половина освещённой стороны.',
		3: 'Луна прошла больше четверти пути: к нам повёрнута бо́льшая часть освещённой половины.',
		4: 'Луна напротив Солнца: к Земле повёрнута вся освещённая половина.',
		5: 'После полнолуния освещённая часть убывает и теперь видна слева.',
		6: 'Луна прошла три четверти пути: освещена левая половина диска.',
		7: 'До новолуния около 3,7 суток: Луна снова почти между Землёй и Солнцем.',
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-phasepick]')) {
		const target = root.querySelector<HTMLCanvasElement>('[data-target]')!;
		const mini = root.querySelector<HTMLCanvasElement>('[data-mini]')!;
		const fb = root.querySelector<HTMLElement>('[data-fb]')!;
		const pos = [...root.querySelectorAll<SVGGElement>('.sv-pick__pos')];
		const E = (k: number) => (k * Math.PI) / 4;
		const order = [7, 2, 3, 5, 1, 6, 4];
		let round = 0;
		let answer = order[0];
		let solved = false;

		function show() {
			solved = false;
			for (const p of pos) p.classList.remove('is-right', 'is-wrong');
			mini.hidden = true;
			fb.textContent = 'Свет Солнца идёт слева. Луна движется против часовой стрелки.';
			drawMoonView(target, E(answer));
		}
		function pick(k: number) {
			if (solved) return;
			const el = pos[k];
			for (const p of pos) p.classList.remove('is-wrong');
			void (el as unknown as HTMLElement).getBoundingClientRect();
			if (k === answer) {
				solved = true;
				el.classList.add('is-right');
				mini.hidden = true;
				fb.innerHTML = `<b>Верно! Это ${lower(phaseName(dayOf(E(k))))}.</b> ${WHY[k]}`;
			} else {
				el.classList.add('is-wrong');
				mini.hidden = false;
				drawMoonView(mini, E(k), { stars: false, radius: 0.42 });
				fb.innerHTML = k === 0 ? 'Нет: отсюда к нам повёрнута тёмная сторона Луны — её не видно. Освещена всегда сторона, обращённая к Солнцу.' : `Нет: с этого места Луна выглядела бы так (${lower(phaseName(dayOf(E(k))))}). Подумайте, какая часть освещённой половины повёрнута к Земле.`;
			}
		}
		pos.forEach((p, k) => {
			p.addEventListener('click', () => pick(k));
			p.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					pick(k);
				}
			});
		});
		root.querySelector('[data-next]')!.addEventListener('click', () => {
			round += 1;
			answer = order[round % order.length];
			show();
		});
		new ResizeObserver(() => {
			drawMoonView(target, E(answer));
		}).observe(target);
		show();
	}
</script>
