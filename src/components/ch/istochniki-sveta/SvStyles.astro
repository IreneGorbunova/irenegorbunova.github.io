---
/** Styles shared by the widgets of the chapter «Источники света. Распространение света». Renders nothing. */
---

<style is:global>
	.sv {
		/* the screen in the shadow models: lit paper and the darkest shadow */
		--sv-lit: color-mix(in srgb, var(--ig-v) 55%, var(--sl-color-white));
		--sv-dark: var(--sl-color-black);
		--sv-light: var(--ig-v);
		--sv-ink: var(--sl-color-white);
		--sv-muted: var(--sl-color-gray-3);
		position: relative;
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
	}
	:root[data-theme='light'] .sv {
		--sv-lit: color-mix(in srgb, var(--ig-v) 22%, var(--ig-surface));
		--sv-dark: var(--sl-color-gray-2);
	}
	.sv i {
		font-family: var(--ig-font-math);
	}
	.sv__svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: hidden;
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-y;
	}
	.sv__svg text {
		font-family: var(--__sl-font);
	}
	.sv-t {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
	}
	.sv-t--math {
		font-family: var(--ig-font-math) !important;
		font-style: italic;
		font-size: 18px;
		fill: var(--sl-color-gray-1);
	}
	.sv-t--small {
		font-size: 13px;
		fill: var(--sv-muted);
	}
	.sv__svg .sv-t {
		paint-order: stroke fill;
		stroke: var(--ig-surface);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.sv-cap {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}

	/* rays with light pulses running along them */
	.sv-ray {
		--c: var(--sv-light);
		fill: none;
		stroke-linecap: round;
	}
	.sv-ray .sv-base {
		stroke: var(--c);
		stroke-width: 1.4;
		opacity: 0.75;
	}
	.sv-ray .sv-flow {
		stroke: color-mix(in srgb, var(--c) 40%, white);
		stroke-width: 3;
		stroke-dasharray: 2 26;
		animation: sv-flow 1.1s linear infinite;
	}
	:root[data-theme='light'] .sv-ray .sv-flow {
		stroke: color-mix(in srgb, var(--c) 70%, white);
	}
	@keyframes sv-flow {
		to {
			stroke-dashoffset: -28;
		}
	}

	/* Controls */
	.sv-controls {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem 1.5rem;
		margin-top: 0.75rem;
		align-items: end;
	}
	.sv-row {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.sv-seg {
		display: inline-flex;
		flex-wrap: wrap;
		padding: 3px;
		border-radius: 1.2rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.sv-seg button {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.4rem 0.95rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background 0.25s,
			color 0.25s;
	}
	.sv-seg button[aria-pressed='true'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.sv-slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.sv-slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.sv-slider input {
		grid-column: 1 / -1;
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.sv-btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		margin: 0;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s,
			transform 0.15s;
	}
	.sv-btn:hover {
		border-color: var(--sl-color-accent);
	}
	.sv-btn:active {
		transform: scale(0.97);
	}
	.sv-btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.sv-btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.sv :is(button, [tabindex]):focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.sv svg [tabindex]:focus-visible {
		outline: none;
	}
	.sv svg [tabindex]:focus-visible .sv-focus {
		stroke: var(--sl-color-accent);
		stroke-width: 2.5;
	}

	.sv-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		margin: 0.9rem 0 0;
	}
	.sv-stats > div {
		padding: 0.45rem 0.7rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		min-width: 0;
	}
	.sv-stats dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.sv-stats dd {
		margin: 0;
		font-size: var(--sl-text-lg);
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.sv-live {
		min-height: 3em;
		margin: 0.7rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.sv-live b {
		color: var(--sl-color-white);
	}
	.sv-formula {
		margin-top: 0.75rem;
		min-height: 3.4rem;
		padding: 0.2rem 0.9rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.sv-formula .katex-display {
		margin: 0.45rem 0;
	}
	.sv-legend {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		line-height: 1.6;
		color: var(--sl-color-gray-3);
	}
	.sv-key {
		display: inline-block;
		width: 1.1rem;
		height: 0.7rem;
		margin: 0 0.3rem 0.1rem 0.6rem;
		vertical-align: middle;
		border-radius: 3px;
		background: var(--c);
		box-shadow: inset 0 0 0 1px var(--sl-color-gray-4);
	}
	.sv-key:first-child {
		margin-left: 0;
	}
	.sv-key--line {
		height: 0;
		border-top: 2px solid var(--c);
		background: none;
		border-radius: 0;
		box-shadow: none;
	}
	.sv-key--dash {
		height: 0;
		border-top: 2px dashed var(--c);
		background: none;
		border-radius: 0;
		box-shadow: none;
	}

	@media (max-width: 40rem) {
		.sv {
			padding: 0.75rem;
		}
		.sv-controls {
			grid-template-columns: 1fr;
		}
		.sv-stats {
			grid-template-columns: 1fr 1fr;
		}
		.sv-stats dd {
			font-size: var(--sl-text-base);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sv-ray .sv-flow {
			animation: none;
			display: none;
		}
		.sv-btn,
		.sv-seg button {
			transition: none;
		}
	}
</style>
