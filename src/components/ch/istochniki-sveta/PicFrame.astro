---
/**
 * Frame of the chapter's pictures to the definitions: one or two panels (two columns on wide screens, one on
 * phones), a caption and, for animated pictures, «Повторить». Each panel:
 *   <div class="svp__panel"><svg class="svp__svg" viewBox="…" role="img" aria-label="…">…</svg></div>
 * The picture's own script animates it with `scene()` from @components/intro/scene (it needs the [data-again] button).
 */
interface Props {
	cols?: 1 | 2 | 4;
	again?: boolean;
	[key: `data-${string}`]: string | boolean | undefined;
}
const { cols = 2, again = true, ...rest } = Astro.props;
---

<figure class={`svp svp--${cols} not-content`} {...rest}>
	<div class="svp__grid">
		<slot />
	</div>
	<div class="svp__foot">
		<figcaption><slot name="cap" /></figcaption>
		{again && <button type="button" class="svp__again" data-again>Повторить</button>}
	</div>
</figure>

<style is:global>
	.svp {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.svp__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.svp--1 .svp__grid {
		grid-template-columns: minmax(0, 1fr);
	}
	.svp--4 .svp__grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.svp--1 .svp__svg {
		max-width: 36rem;
		margin-inline: auto;
	}
	.svp__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.svp text {
		font-family: var(--__sl-font);
	}
	.svp__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.svp__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.svp__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.svp__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	/* labels inside the pictures */
	.svp-t {
		font-size: 15px;
		fill: var(--sl-color-gray-2);
	}
	.svp-t--title {
		font-size: 16px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.svp-t--small {
		font-size: 13px;
		fill: var(--sl-color-gray-3);
	}
	.svp-t--hl {
		fill: var(--sl-color-accent-high);
		font-weight: 600;
	}
	.svp-t,
	.svp-t--title {
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3.5px;
		stroke-linejoin: round;
	}
	@media (max-width: 40rem) {
		.svp__grid,
		.svp--4 .svp__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.svp--4 .svp__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
