---
/**
 * Static figures for the derivation and the camera obscura.
 * kind = 'point'   — shadow of a card from a point source, similar triangles SAB and SA1B1;
 *        'penumbra'— shadow and penumbra from a large source;
 *        'moon'    — the cone of the Moon's full shadow (not to scale);
 *        'camera'  — camera obscura, similar triangles with the vertex in the hole.
 */
interface Props {
	kind: 'point' | 'penumbra' | 'moon' | 'camera';
	label: string;
}
const { kind, label } = Astro.props;
const uid = `svf-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="svf not-content" aria-label={label}>
	<svg viewBox={kind === 'moon' ? '0 0 560 250' : '0 0 560 270'} role="img" aria-label={label}>
		<defs>
			<marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,1 L10,5 L0,9" class="svf__head"></path>
			</marker>
		</defs>
		{
			kind === 'point' && (
				<g>
					<polygon class="svf__tri svf__tri--big" points="40,130 500,40.6 500,219.4" />
					<polygon class="svf__tri svf__tri--small" points="40,130 220,95 220,165" />
					<line class="svf__ray" x1="40" y1="130" x2="500" y2="40.6" />
					<line class="svf__ray" x1="40" y1="130" x2="500" y2="219.4" />
					<line class="svf__card" x1="220" y1="95" x2="220" y2="165" />
					<line class="svf__screen" x1="503" y1="18" x2="503" y2="242" />
					<line class="svf__shadow" x1="500" y1="40.6" x2="500" y2="219.4" />
					<line class="svf__axis" x1="40" y1="130" x2="500" y2="130" />
					<circle class="svf__src" cx="40" cy="130" r="6" />
					<text class="svf__t svf__t--m" x="30" y="118" text-anchor="end">S</text>
					<text class="svf__t svf__t--m" x="214" y="90" text-anchor="end">A</text>
					<text class="svf__t svf__t--m" x="214" y="184" text-anchor="end">B</text>
					<text class="svf__t svf__t--m" x="512" y="44">A<tspan class="svf__sub" dy="5">1</tspan></text>
					<text class="svf__t svf__t--m" x="512" y="226">B<tspan class="svf__sub" dy="5">1</tspan></text>
					<text class="svf__t svf__t--m svf__t--hl" x="230" y="122">d</text>
					<text class="svf__t svf__t--m svf__t--hl" x="470" y="98">D</text>
					<path class="svf__dim" d="M40,250 V262 M220,175 V262 M40,256 H220" />
					<text class="svf__t svf__t--m" x="130" y="250" text-anchor="middle">a</text>
					<path class="svf__dim" d="M40,262 V268 H500 V246" />
					<text class="svf__t svf__t--m" x="360" y="262" text-anchor="middle">b</text>
					<text class="svf__t svf__t--s" x="225" y="210">кружок</text>
					<text class="svf__t svf__t--s" x="445" y="250" text-anchor="end">экран</text>
				</g>
			)
		}
		{
			kind === 'penumbra' && (
				<g>
					<polygon class="svf__pen" points="220,100 500,22.2 500,237.8 220,160" />
					<polygon class="svf__umb" points="220,100 500,84.4 500,175.6 220,160" />
					<line class="svf__ray" x1="40" y1="110" x2="500" y2="84.4" />
					<line class="svf__ray" x1="40" y1="150" x2="500" y2="175.6" />
					<line class="svf__ray svf__ray--pen" x1="40" y1="150" x2="500" y2="22.2" />
					<line class="svf__ray svf__ray--pen" x1="40" y1="110" x2="500" y2="237.8" />
					<rect class="svf__lamp" x="34" y="110" width="12" height="40" rx="6" />
					<line class="svf__card" x1="220" y1="100" x2="220" y2="160" />
					<line class="svf__screen" x1="503" y1="12" x2="503" y2="248" />
					<text class="svf__t" x="440" y="135" text-anchor="end">тень</text>
					<text class="svf__t" x="488" y="70" text-anchor="end">полутень</text>
					<text class="svf__t" x="488" y="202" text-anchor="end">полутень</text>
					<text class="svf__t svf__t--s" x="14" y="178">источник</text>
					<text class="svf__t svf__t--s" x="226" y="185">кружок</text>
					<text class="svf__t svf__t--s" x="510" y="264" text-anchor="end">экран</text>
				</g>
			)
		}
		{
			kind === 'moon' && (
				<g>
					<polygon class="svf__umb" points="330,115 397.5,125 330,135" />
					<circle class="svf__sun" cx="60" cy="125" r="50" />
					<circle class="svf__moon" cx="330" cy="125" r="10" />
					<line class="svf__ray" x1="60" y1="75" x2="397.5" y2="125" />
					<line class="svf__ray" x1="60" y1="175" x2="397.5" y2="125" />
					<circle class="svf__dot" cx="397.5" cy="125" r="3.5" />
					<path class="svf__earth" d="M470,40 A 140 140 0 0 0 470,210" />
					<line class="svf__axis" x1="60" y1="125" x2="400" y2="125" />
					<text class="svf__t svf__t--m" x="403" y="113">T</text>
					<text class="svf__t svf__t--m svf__t--hl" x="68" y="108">D<tspan class="svf__sub svf__sub--up" dy="5">С</tspan></text>
					<line class="svf__dimline" x1="60" y1="77" x2="60" y2="173" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`} />
					<text class="svf__t svf__t--m svf__t--hl" x="338" y="104">d<tspan class="svf__sub svf__sub--up" dy="5">Л</tspan></text>
					<path class="svf__dim" d="M60,200 V226 M330,140 V226 M397.5,132 V226" />
					<line class="svf__dimline" x1="62" y1="218" x2="328" y2="218" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`} />
					<line class="svf__dimline" x1="332" y1="218" x2="395.5" y2="218" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`} />
					<text class="svf__t svf__t--m" x="195" y="211" text-anchor="middle">R</text>
					<text class="svf__t svf__t--m" x="364" y="211" text-anchor="middle">L</text>
					<text class="svf__t svf__t--s" x="60" y="30" text-anchor="middle">Солнце</text>
					<text class="svf__t svf__t--s" x="330" y="160" text-anchor="middle">Луна</text>
					<text class="svf__t svf__t--s" x="500" y="128">Земля</text>
					<text class="svf__t svf__t--s" x="550" y="244" text-anchor="end">рисунок не в масштабе</text>
				</g>
			)
		}
		{
			kind === 'camera' && (
				<g>
					<rect class="svf__box" x="300" y="40" width="200" height="190" />
					<polygon class="svf__tri svf__tri--small" points="60,70 300,135 60,200" />
					<polygon class="svf__tri svf__tri--big" points="300,135 500,189.2 500,80.8" />
					<line class="svf__ray" x1="60" y1="70" x2="500" y2="189.2" />
					<line class="svf__ray svf__ray--2" x1="60" y1="200" x2="500" y2="80.8" />
					<line class="svf__arrow" x1="60" y1="200" x2="60" y2="74" marker-end={`url(#${uid}-a)`} />
					<line class="svf__arrow svf__arrow--img" x1="497" y1="80.8" x2="497" y2="185" marker-end={`url(#${uid}-a)`} />
					<line class="svf__wall" x1="300" y1="40" x2="300" y2="131" />
					<line class="svf__wall" x1="300" y1="139" x2="300" y2="230" />
					<line class="svf__axis" x1="60" y1="135" x2="500" y2="135" />
					<text class="svf__t svf__t--m svf__t--hl" x="42" y="140" text-anchor="end">h</text>
					<text class="svf__t svf__t--m svf__t--hl" x="512" y="140">H</text>
					<text class="svf__t svf__t--s" x="300" y="30" text-anchor="middle">отверстие</text>
					<path class="svf__dim" d="M60,212 V258 M300,235 V258 M500,235 V258" />
					<line class="svf__dimline" x1="62" y1="250" x2="298" y2="250" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`} />
					<line class="svf__dimline" x1="302" y1="250" x2="498" y2="250" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`} />
					<text class="svf__t svf__t--m" x="180" y="243" text-anchor="middle">d</text>
					<text class="svf__t svf__t--m" x="400" y="243" text-anchor="middle">f</text>
				</g>
			)
		}
	</svg>
</figure>

<style is:global>
	.svf {
		margin: 1rem 0;
		padding: 0.5rem;
		border-radius: 0.75rem;
		background: var(--ig-surface);
		border: 1px solid var(--sl-color-gray-5);
	}
	.svf svg {
		display: block;
		width: 100%;
		max-width: 34rem;
		height: auto;
		margin-inline: auto;
	}
	.svf__t {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
		font-family: var(--__sl-font);
		paint-order: stroke fill;
		stroke: var(--ig-surface);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.svf__t--m {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 21px;
		fill: var(--sl-color-gray-1);
	}
	.svf__t--hl {
		fill: var(--sl-color-accent-high);
		font-weight: 700;
	}
	.svf__t--s {
		font-size: 14px;
		fill: var(--sl-color-gray-3);
	}
	.svf__sub {
		font-size: 14px;
	}
	.svf__sub--up {
		font-style: normal;
	}
	.svf__ray {
		stroke: var(--ig-v);
		stroke-width: 1.8;
	}
	.svf__ray--2 {
		stroke: var(--ig-vx);
	}
	.svf__ray--pen {
		stroke: var(--ig-vx);
		stroke-dasharray: 7 5;
	}
	.svf__tri--small {
		fill: color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
	}
	.svf__tri--big {
		fill: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
	}
	.svf__card {
		stroke: var(--sl-color-gray-1);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.svf__screen {
		stroke: var(--sl-color-gray-3);
		stroke-width: 5;
	}
	.svf__shadow {
		stroke: var(--sl-color-black);
		stroke-width: 6;
	}
	:root[data-theme='light'] .svf__shadow {
		stroke: var(--sl-color-gray-2);
	}
	.svf__axis {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.svf__src,
	.svf__lamp {
		fill: color-mix(in srgb, var(--ig-v) 50%, white);
		stroke: var(--ig-v);
		stroke-width: 1.5;
	}
	.svf__pen {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 25%, transparent);
	}
	.svf__umb {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 55%, transparent);
	}
	.svf__sun {
		fill: color-mix(in srgb, var(--ig-v) 70%, white);
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.svf__moon {
		fill: var(--sl-color-gray-2);
	}
	.svf__earth {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 3;
	}
	.svf__dot {
		fill: var(--ig-vy);
	}
	.svf__dim {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.svf__dimline {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.svf__head {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.svf__box {
		fill: color-mix(in srgb, var(--sl-color-black) 70%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.svf__wall {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
	}
	.svf__arrow {
		stroke: var(--sl-color-gray-1);
		stroke-width: 3.5;
	}
	.svf__arrow--img {
		stroke: var(--sl-color-accent-high);
	}
	@media (max-width: 40rem) {
		.svf__t {
			font-size: 22px;
		}
		.svf__t--m {
			font-size: 26px;
		}
		.svf__t--s {
			font-size: 19px;
		}
	}
</style>
