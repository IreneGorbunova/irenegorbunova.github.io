---
/**
 * Picture to the definition of a light source: a 2 × 2 table. Columns: thermal sources (they glow because they are
 * hot) and luminescent ones (they glow while cold); rows: natural and man-made. The Sun, a firefly, a candle flame
 * and an LED lamp; the candle flickers, the firefly blinks (CSS only).
 */
import PicFrame from './PicFrame.astro';

const uid = Math.random().toString(36).slice(2, 8);
const g = (n: string) => `sp-${n}-${uid}`;
// cells: column x0 (thermal 80, luminescent 290), row y0 (natural 46, man-made 182); 200 × 128 each
const C = [80, 290];
const R = [46, 182];
const RAYS = Array.from({ length: 12 }, (_, k) => (k * Math.PI) / 6);
---

<PicFrame cols={1} again={false} data-sources>
	<div class="svp__panel">
		<svg class="svp__svg" viewBox="0 0 500 330" role="img" aria-label="Таблица источников света. Тепловые: Солнце (естественный) и пламя свечи (искусственный). Люминесцентные: светлячок (естественный) и светодиодная лампа (искусственный)">
			<defs>
				<radialGradient id={g('sun')}>
					<stop offset="0" stop-color="#fffdf0"></stop>
					<stop offset="0.65" stop-color="#ffe9a0"></stop>
					<stop offset="1" stop-color="#ffb84d"></stop>
				</radialGradient>
				<radialGradient id={g('glow')}>
					<stop offset="0" stop-color="#ffe9a0" stop-opacity="0.9"></stop>
					<stop offset="1" stop-color="#ffe9a0" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id={g('cold')}>
					<stop offset="0" stop-color="#e9fbff" stop-opacity="0.95"></stop>
					<stop offset="0.4" stop-color="#bff0c8" stop-opacity="0.5"></stop>
					<stop offset="1" stop-color="#bff0c8" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<!-- the table -->
			{C.map((x) => R.map((y) => <rect class="sp-cell" x={x} y={y} width="200" height="128" rx="10" />))}
			<text class="svp-t svp-t--title sp-big" x={C[0] + 100} y="22" text-anchor="middle">тепловые</text>
			<text class="svp-t svp-t--small sp-mid" x={C[0] + 100} y="39" text-anchor="middle">светятся, потому что горячие</text>
			<text class="svp-t svp-t--title sp-big" x={C[1] + 100} y="22" text-anchor="middle">люминесцентные</text>
			<text class="svp-t svp-t--small sp-mid" x={C[1] + 100} y="39" text-anchor="middle">светятся холодными</text>
			<text class="svp-t svp-t--title sp-row" transform={`translate(30 ${R[0] + 64}) rotate(-90)`} text-anchor="middle">естественные</text>
			<text class="svp-t svp-t--title sp-row" transform={`translate(30 ${R[1] + 64}) rotate(-90)`} text-anchor="middle">искусственные</text>
			<!-- the Sun -->
			<g transform={`translate(${C[0] + 100} ${R[0] + 54})`}>
				<circle r="44" fill={`url(#${g('glow')})`}></circle>
				<g class="sp-rays">{RAYS.map((a) => <line x1={30 * Math.cos(a)} y1={30 * Math.sin(a)} x2={40 * Math.cos(a)} y2={40 * Math.sin(a)} />)}</g>
				<circle r="24" fill={`url(#${g('sun')})`}></circle>
			</g>
			<text class="svp-t sp-name" x={C[0] + 100} y={R[0] + 118} text-anchor="middle">Солнце</text>
			<!-- the firefly: a beetle seen from above, its tail glows -->
			<g transform={`translate(${C[1] + 100} ${R[0] + 56}) rotate(-20)`}>
				<circle class="sp-blink" cx="0" cy="22" r="26" fill={`url(#${g('cold')})`}></circle>
				<ellipse class="sp-wing" cx="-7" cy="-2" rx="7" ry="17" transform="rotate(8 -7 -2)"></ellipse>
				<ellipse class="sp-wing" cx="7" cy="-2" rx="7" ry="17" transform="rotate(-8 7 -2)"></ellipse>
				<ellipse class="sp-tail sp-blink" cx="0" cy="18" rx="8" ry="9"></ellipse>
				<ellipse class="sp-bug" cx="0" cy="-20" rx="7" ry="6"></ellipse>
				<path class="sp-leg" d="M -6 -22 Q -12 -32 -10 -40 M 6 -22 Q 12 -32 10 -40 M -12 -6 L -20 -2 M 12 -6 L 20 -2 M -12 4 L -19 10 M 12 4 L 19 10"></path>
			</g>
			<text class="svp-t sp-name" x={C[1] + 100} y={R[0] + 118} text-anchor="middle">светлячок</text>
			<!-- the candle -->
			<g transform={`translate(${C[0] + 100} ${R[1] + 100})`}>
				<circle cx="0" cy="-58" r="30" fill={`url(#${g('glow')})`} class="sp-flicker"></circle>
				<rect class="sp-candle" x="-10" y="-40" width="20" height="44" rx="2"></rect>
				<path class="sp-wick" d="M 0 -40 V -46"></path>
				<path class="sp-flame sp-flicker" d="M 0 -72 Q 9 -56 6 -49 Q 3 -43 0 -43 Q -3 -43 -6 -49 Q -9 -56 0 -72 Z"></path>
				<path class="sp-core" d="M 0 -56 Q 3 -50 2 -47 Q 0 -45 -2 -47 Q -3 -50 0 -56 Z"></path>
			</g>
			<text class="svp-t sp-name" x={C[0] + 100} y={R[1] + 118} text-anchor="middle">пламя свечи</text>
			<!-- the LED lamp -->
			<g transform={`translate(${C[1] + 100} ${R[1] + 54})`}>
				<circle r="36" fill={`url(#${g('cold')})`}></circle>
				<path class="sp-bulb" d="M -20 4 A 22 22 0 1 1 20 4 Q 14 14 12 22 H -12 Q -14 14 -20 4 Z"></path>
				<rect class="sp-chip" x="-9" y="-6" width="18" height="6" rx="1"></rect>
				<g class="sp-dots">{[-6, -2, 2, 6].map((x) => <rect x={x - 1.2} y="-7.2" width="2.4" height="2.4" />)}</g>
				<rect class="sp-base" x="-12" y="22" width="24" height="10" rx="2"></rect>
				<path class="sp-thread" d="M -12 26 H 12 M -11 30 H 11"></path>
				<path class="sp-base" d="M -8 32 H 8 L 4 38 H -4 Z"></path>
			</g>
			<text class="svp-t sp-name" x={C[1] + 100} y={R[1] + 118} text-anchor="middle">светодиодная лампа</text>
		</svg>
	</div>
	<Fragment slot="cap">Тепловые источники светятся, потому что сильно нагреты. Люминесцентные получают энергию для свечения от химической реакции, как светлячок, или от электрического тока, как светодиод, и остаются при этом холодными.</Fragment>
</PicFrame>

<style is:global>
	.svp .sp-big {
		font-size: 21px;
	}
	.svp .sp-row {
		font-size: 17px;
	}
	.svp .sp-mid {
		font-size: 15px;
	}
	.svp .sp-name {
		font-size: 18px;
	}
	.sp-cell {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.sp-rays line {
		stroke: #ffc65c;
		stroke-width: 3;
		stroke-linecap: round;
	}
	.sp-wing {
		fill: color-mix(in srgb, var(--ig-vy) 30%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.sp-bug {
		fill: color-mix(in srgb, var(--ig-vy) 55%, var(--sl-color-gray-3));
	}
	.sp-leg {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	.sp-tail {
		fill: #d9ff9e;
	}
	.sp-blink {
		animation: sp-blink 2.6s ease-in-out infinite;
	}
	@keyframes sp-blink {
		0%,
		100% {
			opacity: 0.25;
		}
		40%,
		60% {
			opacity: 1;
		}
	}
	.sp-candle {
		fill: color-mix(in srgb, var(--sl-color-white) 80%, var(--ig-v));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	:root[data-theme='light'] .sp-candle {
		fill: color-mix(in srgb, var(--sl-color-black) 85%, var(--ig-v));
	}
	.sp-wick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.sp-flame {
		fill: #ffc65c;
		transform-box: fill-box;
		transform-origin: 50% 100%;
	}
	.sp-core {
		fill: #fffbe8;
	}
	.sp-flicker {
		animation: sp-flicker 0.9s ease-in-out infinite alternate;
		transform-box: fill-box;
		transform-origin: 50% 100%;
	}
	@keyframes sp-flicker {
		0% {
			transform: scale(1, 1) skewX(0deg);
		}
		35% {
			transform: scale(0.95, 1.06) skewX(3deg);
		}
		70% {
			transform: scale(1.04, 0.95) skewX(-2deg);
		}
		100% {
			transform: scale(0.98, 1.03) skewX(1deg);
		}
	}
	.sp-bulb {
		fill: color-mix(in srgb, #e9fbff 55%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.sp-chip {
		fill: var(--sl-color-gray-4);
	}
	.sp-dots rect {
		fill: #f4fdff;
	}
	.sp-base {
		fill: var(--sl-color-gray-3);
	}
	.sp-thread {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.2;
	}
</style>
