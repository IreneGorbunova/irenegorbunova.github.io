---
/**
 * «Разложите по полочкам»: for each body choose — a thermal source, a luminescent source or not a
 * source of light at all. Instant feedback with a short explanation; the right choice gets .is-right.
 */
type Kind = 'heat' | 'lum' | 'none';
const items: { name: string; kind: Kind; nat?: boolean; why: string }[] = [
	{ name: 'Солнце', kind: 'heat', nat: true, why: 'Раскалённый газ: температура поверхности Солнца около 5500 °C.' },
	{ name: 'Пламя свечи', kind: 'heat', nat: false, why: 'Светятся раскалённые крошечные частички сажи в пламени.' },
	{ name: 'Лампа накаливания', kind: 'heat', nat: false, why: 'Ток раскаляет тонкую вольфрамовую нить больше чем до 2000 °C.' },
	{ name: 'Светлячок', kind: 'lum', nat: true, why: 'Свет даёт химическая реакция в его теле. Светлячок при этом холодный.' },
	{ name: 'Луна', kind: 'none', why: 'Луна сама не светится — она отражает солнечный свет.' },
	{ name: 'Светодиодная лампа', kind: 'lum', nat: false, why: 'Светится кристалл светодиода, по которому идёт ток. Он не раскалён.' },
	{ name: 'Полярное сияние', kind: 'lum', nat: true, why: 'Светятся газы высоко в атмосфере, в которые врезаются быстрые частицы, прилетевшие от Солнца.' },
	{ name: 'Солнечный зайчик', kind: 'none', why: 'Это свет Солнца, отражённый зеркалом. Само зеркало не светится.' },
	{ name: 'Лампа дневного света', kind: 'lum', nat: false, why: 'В трубке светится газ, а покрытие стенок превращает его невидимое излучение в видимый свет.' },
	{ name: 'Раскалённое железо в кузнице', kind: 'heat', nat: false, why: 'Железо, нагретое до 800–1000 °C, светится само — красным, а потом оранжевым светом.' },
];
const labels: [Kind, string][] = [
	['heat', 'тепловой'],
	['lum', 'люминесцентный'],
	['none', 'не источник'],
];
---

<figure class="sv-sort not-content" data-sort>
	<p class="sv-sort__head">
		Для каждого тела выберите: <b>тепловой</b> источник света, <b>люминесцентный</b> или вообще <b>не источник</b>.
		<span class="sv-sort__score" data-score aria-live="polite"></span>
	</p>
	<ul class="sv-sort__list">
		{
			items.map((it) => (
				<li class="sv-sort__item" data-kind={it.kind} data-nat={it.nat === undefined ? '' : it.nat ? 'естественный' : 'искусственный'}>
					<span class="sv-sort__name">{it.name}</span>
					<span class="sv-sort__opts" role="group" aria-label={`${it.name}: что это?`}>
						{labels.map(([k, l]) => (
							<button type="button" class="sv-sort__opt" data-k={k}>
								{l}
							</button>
						))}
					</span>
					<span class="sv-sort__why" data-why aria-live="polite" hidden>
						{it.why}
					</span>
				</li>
			))
		}
	</ul>
</figure>

<style is:global>
	.sv-sort {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.sv-sort__head {
		margin: 0 0 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.sv-sort__head b {
		color: var(--sl-color-white);
	}
	.sv-sort__score {
		display: inline-block;
		margin-left: 0.4rem;
		font-weight: 700;
		color: var(--sl-color-accent-high);
	}
	.sv-sort__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
	.sv-sort__item {
		display: grid;
		grid-template-columns: minmax(9rem, 1fr) auto;
		gap: 0.35rem 0.8rem;
		align-items: center;
		margin: 0;
		padding: 0.5rem 0.7rem;
		border-radius: 0.7rem;
		background: var(--sl-color-gray-6);
	}
	.sv-sort__name {
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.sv-sort__opts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.sv-sort__opt {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-1);
		cursor: pointer;
		transition:
			background 0.25s,
			border-color 0.25s;
	}
	.sv-sort__opt:hover {
		border-color: var(--sl-color-accent);
	}
	.sv-sort__opt:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.sv-sort__opt.is-right {
		border-color: var(--sl-color-green);
		background: color-mix(in srgb, var(--sl-color-green) 25%, transparent);
		color: var(--sl-color-white);
	}
	.sv-sort__opt.is-wrong {
		border-color: var(--sl-color-red);
		background: color-mix(in srgb, var(--sl-color-red) 16%, transparent);
		animation: sv-sort-shake 0.4s;
	}
	.sv-sort__why {
		grid-column: 1 / -1;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		animation: sv-sort-in 0.4s ease-out;
	}
	.sv-sort__why i {
		font-style: normal;
		color: var(--sl-color-accent-high);
	}
	@keyframes sv-sort-shake {
		25% {
			transform: translateX(-3px);
		}
		75% {
			transform: translateX(3px);
		}
	}
	@keyframes sv-sort-in {
		from {
			opacity: 0;
			transform: translateY(-0.25rem);
		}
	}
	@media (max-width: 40rem) {
		.sv-sort__item {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sv-sort__opt.is-wrong,
		.sv-sort__why {
			animation: none;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-sort]')) {
		const items = [...root.querySelectorAll<HTMLElement>('.sv-sort__item')];
		const score = root.querySelector<HTMLElement>('[data-score]')!;
		const done = new Set<HTMLElement>();
		let firstTry = 0;
		const update = () => {
			score.textContent = done.size ? `Разобрано ${done.size} из ${items.length}, с первой попытки — ${firstTry}.` : '';
		};
		for (const it of items) {
			let tries = 0;
			const why = it.querySelector<HTMLElement>('[data-why]')!;
			const nat = it.dataset.nat;
			if (nat) why.insertAdjacentHTML('afterbegin', `<i>${nat[0].toUpperCase() + nat.slice(1)} источник.</i> `);
			for (const b of it.querySelectorAll<HTMLButtonElement>('.sv-sort__opt')) {
				b.addEventListener('click', () => {
					if (done.has(it)) return;
					tries += 1;
					it.querySelectorAll('.sv-sort__opt').forEach((o) => o.classList.remove('is-wrong'));
					void b.offsetWidth;
					if (b.dataset.k === it.dataset.kind) {
						b.classList.add('is-right');
						done.add(it);
						if (tries === 1) firstTry += 1;
						why.hidden = false;
					} else {
						b.classList.add('is-wrong');
						if (tries >= 2) {
							why.hidden = false;
						}
					}
					update();
				});
			}
		}
	}
</script>
