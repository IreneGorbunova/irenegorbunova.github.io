---
/**
 * Camera obscura: a candle (h = 12 cm from the base to the tip of the flame) in front of a box
 * with a small hole; the image appears on the tracing paper at the back of the box.
 * Side view: 4,5 px per cm, equal scales (the hole is drawn at least 3 px wide).
 * Back wall: the true image, built as light really builds it — every point of the hole gives
 * its own sharp inverted picture shifted by s·(1 + f/d); the sum of these pictures is what we
 * see. Brightness of the image is proportional to (a/f)². Diffraction is not modelled.
 */
import SvStyles from './SvStyles.astro';

const S = 4.5;
const XH = 470; // svg x of the hole
const AY = 100; // svg y of the axis
---

<SvStyles />
<figure class="sv sv-cam not-content" data-pinhole data-s={S} data-xh={XH} data-ay={AY}>
		<svg class="sv__svg" viewBox="0 0 720 232" role="img" aria-label="Камера-обскура сбоку: свеча, отверстие и изображение на задней стенке">
			<defs>
				<radialGradient data-flame-grad cx="0.5" cy="0.62" r="0.6">
					<stop offset="0" stop-color="#fffbe6"></stop>
					<stop offset="0.45" stop-color="#ffd25a"></stop>
					<stop offset="1" stop-color="#ff8a1e" stop-opacity="0.85"></stop>
				</radialGradient>
			</defs>
			<g data-candle class="sv-cam__candle">
				<circle class="sv-cam__glow" data-glow r="40"></circle>
				<rect class="sv-cam__wax" data-wax rx="2"></rect>
				<path class="sv-cam__flame" data-flame></path>
			</g>
			<rect class="sv-cam__box" data-box></rect>
			<rect class="sv-cam__paper" data-paper></rect>
			<g data-rays></g>
			<line class="sv-cam__image" data-image></line>
			<circle class="sv-cam__imgflame" data-img-flame r="3"></circle>
			<rect class="sv-cam__wall" data-wall-top></rect>
			<rect class="sv-cam__wall" data-wall-bot></rect>
			<g class="sv-cam__dims">
				<path data-dim-d></path>
				<path data-dim-f></path>
				<text class="sv-t" data-dim-d-t text-anchor="middle"></text>
				<text class="sv-t" data-dim-f-t text-anchor="middle"></text>
			</g>
			<text class="sv-t sv-t--small" data-hole-t text-anchor="middle">отверстие</text>
			<text class="sv-t sv-t--small" data-paper-t text-anchor="middle">калька</text>
		</svg>

	<div class="sv-controls">
		<label class="sv-slider">
			<span>Расстояние до свечи <i>d</i></span>
			<output data-d-out></output>
			<input type="range" min="20" max="100" step="1" value="40" data-d />
		</label>
		<label class="sv-slider">
			<span>Длина камеры <i>f</i></span>
			<output data-f-out></output>
			<input type="range" min="10" max="40" step="1" value="30" data-f />
		</label>
		<label class="sv-slider">
			<span>Диаметр отверстия</span>
			<output data-a-out></output>
			<input type="range" min="0.5" max="10" step="0.5" value="1" data-a />
		</label>
		<div class="sv-row">
			<span class="sv-legend">Отверстие:</span>
			<div class="sv-seg" role="group" aria-label="Форма отверстия">
				<button type="button" aria-pressed="true" data-shape="circle">круглое</button>
				<button type="button" aria-pressed="false" data-shape="tri">треугольное</button>
			</div>
		</div>
	</div>

	<div class="sv-cam__below">
		<div class="sv-cam__front">
			<canvas data-wall role="img" aria-label="Изображение свечи на задней стенке камеры"></canvas>
			<p class="sv-cap">Задняя стенка изнутри</p>
		</div>
		<div>
		<dl class="sv-stats">
			<div><dt>Высота изображения <i>H</i></dt><dd data-st-h></dd></div>
			<div><dt>Пятно от одной точки свечи</dt><dd data-st-b></dd></div>
			<div><dt>Яркость (1 мм и 20 см — ×1)</dt><dd data-st-l></dd></div>
		</dl>
		<div class="sv-formula" data-formula aria-live="polite"></div>
		<p class="sv-live" data-live aria-live="polite"></p>
		</div>
	</div>
</figure>

<style is:global>
	.sv-cam__below {
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		margin-top: 0.9rem;
	}
	.sv-cam__below .sv-stats {
		margin-top: 0;
	}
	.sv-cam__front canvas {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 0.4rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.sv-cam__wax {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 70%, var(--ig-v));
	}
	.sv-cam__flame {
		stroke: none;
	}
	.sv-cam__glow {
		fill: var(--ig-v);
		opacity: 0.16;
		filter: blur(10px);
	}
	.sv-cam__box {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.sv-cam__wall {
		fill: var(--sl-color-gray-4);
	}
	.sv-cam__paper {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 60%, var(--ig-v));
		opacity: 0.85;
	}
	.sv-cam__image {
		stroke: color-mix(in srgb, var(--sl-color-gray-1) 50%, var(--ig-v));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.sv-cam__imgflame {
		fill: #ffd25a;
	}
	.sv-cam__dims path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.sv-cam .sv-t {
		font-size: 16px;
	}
	.sv-cam .sv-t--small {
		font-size: 14px;
	}
	@media (max-width: 40rem) {
		.sv-cam__below {
			grid-template-columns: 1fr;
		}
		.sv-cam__front {
			width: min(12rem, 60%);
			margin-inline: auto;
		}
		.sv-cam .sv-t {
			font-size: 24px;
		}
		.sv-cam .sv-t--small {
			font-size: 21px;
		}
	}
</style>

<script>
	import katex from 'katex';
	import { fmt, tfmt } from './sv';

	const H_OBJ = 12; // cm, the candle with its flame
	const BOX = 14; // half height of the box, cm
	const NS = 'http://www.w3.org/2000/svg';

	for (const root of document.querySelectorAll<HTMLElement>('[data-pinhole]')) {
		const S = Number(root.dataset.s);
		const XH = Number(root.dataset.xh);
		const AY = Number(root.dataset.ay);
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const uid = Math.random().toString(36).slice(2, 8);
		const fg = q<SVGRadialGradientElement>('[data-flame-grad]');
		fg.id = `sv-flame-${uid}`;
		q('[data-flame]').setAttribute('fill', `url(#${fg.id})`);
		const st = { d: 40, f: 30, a: 1, shape: 'circle' as 'circle' | 'tri' };
		const X = (x: number) => XH + x * S; // x in cm from the hole (candle at −d)
		const Y = (y: number) => AY - y * S;
		const formula = q<HTMLElement>('[data-formula]');
		let lastTex = '';

		// the candle drawn upright on its own canvas: flame (light source) and the wax lit by it
		const base = document.createElement('canvas');
		const bctx = base.getContext('2d', { willReadFrequently: true })!;
		function drawCandle(px: number) {
			// px — pixels per cm on the wall; the candle spans y from −6 to +6 cm
			const w = Math.max(4, Math.ceil(5 * px));
			const h = Math.max(4, Math.ceil((H_OBJ + 1) * px));
			base.width = w;
			base.height = h;
			bctx.clearRect(0, 0, w, h);
			const cx = w / 2;
			const Yc = (y: number) => h - (y + 6.5) * px; // y in cm, −6 … +6
			// wax: 2,6 cm wide, from −6 to +2,2 cm, faintly lit
			const g = bctx.createLinearGradient(0, Yc(2.2), 0, Yc(-6));
			g.addColorStop(0, 'rgba(255,200,140,0.2)');
			g.addColorStop(1, 'rgba(255,200,140,0.05)');
			bctx.fillStyle = g;
			bctx.fillRect(cx - 1.3 * px, Yc(2.2), 2.6 * px, 8.2 * px);
			// flame: from +2,6 to +6 cm
			const fy = Yc(3.6);
			const fl = bctx.createRadialGradient(cx, fy, 0, cx, fy, 2.4 * px);
			fl.addColorStop(0, 'rgba(255,255,240,1)');
			fl.addColorStop(0.4, 'rgba(255,215,90,1)');
			fl.addColorStop(1, 'rgba(255,120,20,0)');
			bctx.fillStyle = fl;
			bctx.beginPath();
			bctx.moveTo(cx, Yc(6));
			bctx.bezierCurveTo(cx + 1.3 * px, Yc(4.2), cx + 1.1 * px, Yc(2.6), cx, Yc(2.6));
			bctx.bezierCurveTo(cx - 1.1 * px, Yc(2.6), cx - 1.3 * px, Yc(4.2), cx, Yc(6));
			bctx.fill();
		}

		/** Points of the hole (cm), spread evenly over a circle or a triangle of size a. */
		function holePoints(): [number, number][] {
			const a = st.a / 10; // mm → cm
			const out: [number, number][] = [];
			if (st.shape === 'circle') {
				const n = 64;
				for (let i = 0; i < n; i++) {
					const r = (a / 2) * Math.sqrt((i + 0.5) / n);
					const t = i * 2.39996;
					out.push([r * Math.cos(t), r * Math.sin(t)]);
				}
			} else {
				// equilateral triangle with side a, pointing up, centred at the hole
				const m = 11;
				const hgt = (a * Math.sqrt(3)) / 2;
				for (let i = 0; i < m; i++)
					for (let j = 0; j <= i; j++) {
						const yy = hgt * (2 / 3 - (i + 0.5) / m);
						const half = (a * (i + 0.5)) / m / 2;
						const xx = i === 0 ? 0 : -half + (2 * half * j) / i;
						out.push([xx, yy]);
					}
			}
			return out;
		}

		const wall = q<HTMLCanvasElement>('[data-wall]');
		const wctx = wall.getContext('2d')!;
		let acc = new Float32Array(0);
		let out: ImageData | null = null;
		function drawWall() {
			const w = Math.max(2, Math.round(wall.clientWidth * devicePixelRatio));
			if (wall.width !== w) wall.width = wall.height = w;
			const k = st.f / st.d; // magnification
			// the view zooms to the image (a scale bar shows the size): the image and its blur fill most of it
			const Hc = H_OBJ * k;
			const blurCm = (st.a / 10) * (1 + k);
			const span = Math.min(2 * BOX, Math.max(2, 1.7 * (Hc + blurCm)));
			const px = w / span; // px per cm
			drawCandle(px * k);
			const bw = base.width;
			const bh = base.height;
			const bd = bctx.getImageData(0, 0, bw, bh).data;
			// the lit pixels of the upright candle, premultiplied by their opacity
			const lit: number[] = [];
			for (let j = 0; j < bh; j++)
				for (let i = 0; i < bw; i++) {
					const p = (j * bw + i) * 4;
					const al = bd[p + 3] / 255;
					if (al > 0.004) lit.push(i, j, bd[p] * al, bd[p + 1] * al, bd[p + 2] * al);
				}
			if (acc.length !== w * w * 3) acc = new Float32Array(w * w * 3);
			else acc.fill(0);
			const pts = holePoints();
			const shift = 1 + k;
			const c0x = Math.round(w / 2 + bw / 2);
			const c0y = Math.round(w / 2 + bh / 2);
			for (const [sx, sy] of pts) {
				// the hole point (sx, sy) gives a sharp picture, upside down and left–right, shifted by s·(1 + f/d)
				const ox = c0x + Math.round(sx * shift * px);
				const oy = c0y + Math.round(-sy * shift * px);
				for (let n = 0; n < lit.length; n += 5) {
					const x = ox - lit[n] - 1;
					const y = oy - lit[n + 1] - 1;
					if (x < 0 || y < 0 || x >= w || y >= w) continue;
					const q2 = (y * w + x) * 3;
					acc[q2] += lit[n + 2];
					acc[q2 + 1] += lit[n + 3];
					acc[q2 + 2] += lit[n + 4];
				}
			}
			// brightness of the image ∝ (a/f)² (the hole area over the square of the camera length).
			// The picture is shown as the eye sees it after getting used to the light: the exposure grows
			// more slowly than the brightness (as its 0,4 power), so very bright images are not just white.
			const gain = (2.6 * (st.a ** 2 * (20 / st.f) ** 2) ** 0.4) / pts.length;
			if (!out || out.width !== w) out = wctx.createImageData(w, w);
			const o = out.data;
			// a soft exposure curve (like a camera or the eye): very bright parts become white smoothly
			const tone = (v: number) => 255 * (1 - Math.exp((-1.8 * v * gain) / 255));
			for (let i = 0, j = 0; i < w * w; i++, j += 3) {
				o[i * 4] = Math.min(255, 22 + tone(acc[j]));
				o[i * 4 + 1] = Math.min(255, 18 + tone(acc[j + 1]));
				o[i * 4 + 2] = Math.min(255, 14 + tone(acc[j + 2]));
				o[i * 4 + 3] = 255;
			}
			wctx.putImageData(out, 0, 0);
			// scale bar
			const nice = [0.2, 0.5, 1, 2, 5, 10].find((v) => v * px >= w * 0.18) ?? 10;
			const L = nice * px;
			const m = 10 * devicePixelRatio;
			wctx.fillStyle = 'rgba(255,255,255,0.75)';
			wctx.fillRect(m, w - m - 3 * devicePixelRatio, L, 3 * devicePixelRatio);
			wctx.font = `${12 * devicePixelRatio}px sans-serif`;
			wctx.textBaseline = 'bottom';
			wctx.fillText(`${fmt(nice * 10)} мм`, m, w - m - 6 * devicePixelRatio);
		}

		const el = (tag: string, attrs: Record<string, string | number>) => {
			const e = document.createElementNS(NS, tag);
			for (const [kk, v] of Object.entries(attrs)) e.setAttribute(kk, String(v));
			return e;
		};

		function draw() {
			const { d, f, a } = st;
			const xc = -d;
			// candle
			q('[data-wax]').setAttribute('x', String(X(xc) - 1.3 * S));
			q('[data-wax]').setAttribute('y', String(Y(2.2)));
			q('[data-wax]').setAttribute('width', String(2.6 * S));
			q('[data-wax]').setAttribute('height', String(8.2 * S));
			const cx = X(xc);
			q('[data-flame]').setAttribute(
				'd',
				`M${cx},${Y(6)} C${cx + 1.3 * S},${Y(4.2)} ${cx + 1.1 * S},${Y(2.6)} ${cx},${Y(2.6)} C${cx - 1.1 * S},${Y(2.6)} ${cx - 1.3 * S},${Y(4.2)} ${cx},${Y(6)} Z`,
			);
			q('[data-glow]').setAttribute('cx', String(cx));
			q('[data-glow]').setAttribute('cy', String(Y(3.8)));
			// box with the hole
			const gap = Math.max(3, (a / 10) * S);
			q('[data-box]').setAttribute('x', String(X(0)));
			q('[data-box]').setAttribute('y', String(Y(BOX)));
			q('[data-box]').setAttribute('width', String(f * S));
			q('[data-box]').setAttribute('height', String(2 * BOX * S));
			q('[data-wall-top]').setAttribute('x', String(X(0) - 2));
			q('[data-wall-top]').setAttribute('y', String(Y(BOX)));
			q('[data-wall-top]').setAttribute('width', '4');
			q('[data-wall-top]').setAttribute('height', String(BOX * S - gap / 2));
			q('[data-wall-bot]').setAttribute('x', String(X(0) - 2));
			q('[data-wall-bot]').setAttribute('y', String(AY + gap / 2));
			q('[data-wall-bot]').setAttribute('width', '4');
			q('[data-wall-bot]').setAttribute('height', String(BOX * S - gap / 2));
			q('[data-paper]').setAttribute('x', String(X(f) - 3));
			q('[data-paper]').setAttribute('y', String(Y(BOX)));
			q('[data-paper]').setAttribute('width', '4');
			q('[data-paper]').setAttribute('height', String(2 * BOX * S));
			const ht = q<SVGTextElement>('[data-hole-t]');
			ht.setAttribute('x', String(X(0)));
			ht.setAttribute('y', String(Y(BOX) - 8));
			const pt = q<SVGTextElement>('[data-paper-t]');
			pt.setAttribute('x', String(X(f)));
			pt.setAttribute('y', String(Y(-BOX) + 20));

			// rays: from the tip of the flame and from the base of the candle through the hole
			const H = (H_OBJ * f) / d;
			const rays = q<SVGGElement>('[data-rays]');
			rays.replaceChildren();
			for (const [y0, c] of [
				[6, 'var(--ig-v)'],
				[-6, 'var(--ig-vx)'],
			] as [number, string][]) {
				const y1 = (-y0 * f) / d;
				const dd = `M${X(xc)},${Y(y0)} L${X(0)},${AY} L${X(f)},${Y(y1)}`;
				const g = el('g', { class: 'sv-ray', style: `--c: ${c}` });
				g.append(el('path', { class: 'sv-base', d: dd }), el('path', { class: 'sv-flow', d: dd }));
				rays.append(g);
			}
			const im = q('[data-image]');
			im.setAttribute('x1', String(X(f) - 6));
			im.setAttribute('x2', String(X(f) - 6));
			im.setAttribute('y1', String(Y(H / 2)));
			im.setAttribute('y2', String(Y((-H / 2) * (2.6 / 6))));
			q('[data-img-flame]').setAttribute('cx', String(X(f) - 6));
			q('[data-img-flame]').setAttribute('cy', String(Y((-H / 2) * (4.2 / 6))));
			q('[data-img-flame]').setAttribute('r', String(Math.max(2, (H / 12) * 1.1 * S)));

			// dimensions
			const yd = Y(-BOX) + 6;
			q('[data-dim-d]').setAttribute('d', `M${X(xc)},${yd - 8} V${yd} H${X(0)} V${yd - 8}`);
			q('[data-dim-f]').setAttribute('d', `M${X(0)},${yd + 30} V${yd + 38} H${X(f)} V${yd + 30}`);
			const dt = q<SVGTextElement>('[data-dim-d-t]');
			dt.setAttribute('x', String((X(xc) + X(0)) / 2));
			dt.setAttribute('y', String(yd + 18));
			dt.innerHTML = `<tspan class="sv-t--math">d</tspan> = ${fmt(d)} см`;
			const ft = q<SVGTextElement>('[data-dim-f-t]');
			ft.setAttribute('x', String((X(0) + X(f)) / 2));
			ft.setAttribute('y', String(yd + 56));
			ft.innerHTML = `<tspan class="sv-t--math">f</tspan> = ${fmt(f)} см`;

			drawWall();

			// numbers
			const blur = (a * (d + f)) / d; // mm
			const bright = (a / 1) ** 2 * (20 / f) ** 2;
			q('[data-d-out]').textContent = `${fmt(d)} см`;
			q('[data-f-out]').textContent = `${fmt(f)} см`;
			q('[data-a-out]').textContent = `${fmt(a, a % 1 ? 1 : 0)} мм`;
			q('[data-st-h]').textContent = `${fmt(H, 1)} см`;
			q('[data-st-b]').textContent = `${fmt(blur, 1)} мм`;
			q('[data-st-l]').textContent = bright >= 10 ? `×${fmt(bright)}` : `×${fmt(bright, bright < 1 ? 2 : 1)}`;
			const tex = `H = h\\,\\frac{f}{d} = ${tfmt(H_OBJ)}~\\text{см}\\cdot\\frac{${tfmt(f)}~\\text{см}}{${tfmt(d)}~\\text{см}} = ${tfmt(H, 1)}~\\text{см}`;
			if (tex !== lastTex) {
				katex.render(tex, formula, { displayMode: true, throwOnError: false });
				lastTex = tex;
			}
			const sharp = blur < 0.06 * H * 10;
			q('[data-live]').innerHTML = sharp
				? `Изображение <b>перевёрнутое</b> и чёткое: пятнышко от каждой точки свечи (${fmt(blur, 1)} мм) намного меньше самого изображения.`
				: `Изображение <b>размытое</b>: каждая точка свечи даёт пятно размером ${fmt(blur, 1)} мм${st.shape === 'tri' ? ' — и это пятно треугольное, как отверстие' : ''}. Зато оно ярче.`;
			q('[data-d]').setAttribute('aria-valuetext', `${fmt(d)} см`);
		}

		const bind = (sel: string, key: 'd' | 'f' | 'a') => {
			const inp = q<HTMLInputElement>(sel);
			inp.addEventListener('input', () => {
				st[key] = Number(inp.value);
				draw();
			});
		};
		bind('[data-d]', 'd');
		bind('[data-f]', 'f');
		bind('[data-a]', 'a');
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-shape]'))
			b.addEventListener('click', () => {
				st.shape = b.dataset.shape as 'circle' | 'tri';
				for (const o of root.querySelectorAll<HTMLButtonElement>('[data-shape]')) o.setAttribute('aria-pressed', String(o === b));
				draw();
			});
		draw();
		new ResizeObserver(() => drawWall()).observe(wall);
	}
</script>
