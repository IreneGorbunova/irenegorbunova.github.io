---
/**
 * Two short looping opening scenes of «Источники света. Распространение света». No numbers in the pictures; the
 * captions' popovers explain.
 * Street: a street at night, side view at 30 px/m. A lamp hangs 5 m above the pavement; a man 1,7 m tall walks away
 *   from the post at about 1,1 m/s, from 1 m to 6 m. His shadow on the pavement runs from his feet to the point
 *   where the straight line from the lamp over the top of his head meets the ground: its length is 1,7·x/(5 − 1,7),
 *   so it grows in proportion to his distance from the post (0,5 m → 3,1 m). At the end the line lamp — head — tip
 *   of the shadow is shown dashed.
 * Eclipse: a landscape at midday; the Moon (dark side towards us, unseen against the blue sky) slides over the Sun
 *   from right to left (as it does in the Northern hemisphere). The visible part of the Sun is the exact area outside
 *   the overlap of the two discs (the Moon's disc is 5 % larger: a total eclipse). The daylight follows the visible
 *   part with a perceptual curve (the eye adapts: at half the Sun the day still looks bright); during totality the
 *   sky is dark, bright stars and a planet show, the corona glows round the black Moon, the horizon glows orange all
 *   round (outside the Moon's shadow it is still lit) and a street lamp switches on. The partial phases (more than an
 *   hour each in reality) are shown much faster than the totality (a few minutes).
 * Plays only while visible; «Повторить» restarts.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const g = (n: string) => `li-${n}-${uid}`;
// Street: the lamp at (70, 66), the pavement line (feet) at y = 216: 150 px = 5 m above it.
const STARS1 = [
	[22, 18, 0.8],
	[104, 30, 0.6],
	[150, 12, 0.9],
	[196, 40, 0.5],
	[236, 20, 0.7],
	[290, 34, 0.9],
	[332, 14, 0.6],
	[262, 58, 0.5],
	[128, 52, 0.4],
];
const HOUSES = [
	{ x: 120, w: 70, h: 92 },
	{ x: 196, w: 56, h: 120 },
	{ x: 258, w: 100, h: 78 },
];
const WINDOWS = [
	[132, 128],
	[164, 112],
	[208, 98],
	[230, 130],
	[276, 146],
	[318, 140],
];
// Eclipse: the Sun at (238, 74)
const SX = 238;
const SY = 74;
const RS = 19;
const RM = 20;
const STARS2 = [
	[60, 30, 0.9],
	[112, 58, 0.6],
	[170, 20, 0.7],
	[318, 34, 0.8],
	[300, 118, 0.5],
	[34, 96, 0.5],
	[140, 110, 0.4],
];
const STREAMERS = [
	[0.3, 2.3],
	[1.2, 1.7],
	[2.0, 2.6],
	[3.3, 1.9],
	[4.2, 2.4],
	[5.3, 1.8],
].map(([a, l]) => {
	const w = 0.3;
	const p = (r: number, t: number) => `${(SX + r * Math.cos(t)).toFixed(1)} ${(SY + r * Math.sin(t)).toFixed(1)}`;
	return `M ${p(RS, a - w)} Q ${p(RS * (1 + l * 0.55), a)} ${p(RS * (1 + l), a)} Q ${p(RS * (1 + l * 0.55), a)} ${p(RS, a + w)} Z`;
});
---

<IntroFrame data-lightintro>
	<div class="intro__card" data-scene="street">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ночная улица. Под фонарём на столбе идёт человек, он удаляется от столба. Его тень на тротуаре становится всё длиннее">
			<defs>
				<linearGradient id={g('night')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="#070b1c"></stop>
					<stop offset="1" stop-color="#18203a"></stop>
				</linearGradient>
				<radialGradient id={g('pool')} cx="0.5" cy="0.5" r="0.5">
					<!-- the pavement is lit as cos³ of the angle from the vertical (lamp 5 m up, 330 px = 11 m) -->
					<stop offset="0" stop-color="#ffd890" stop-opacity="0.7"></stop>
					<stop offset="0.23" stop-color="#ffd890" stop-opacity="0.5"></stop>
					<stop offset="0.45" stop-color="#ffd890" stop-opacity="0.25"></stop>
					<stop offset="0.68" stop-color="#ffd890" stop-opacity="0.12"></stop>
					<stop offset="0.91" stop-color="#ffd890" stop-opacity="0.06"></stop>
					<stop offset="1" stop-color="#ffd890" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id={g('glow')}>
					<stop offset="0" stop-color="#fff4d6" stop-opacity="1"></stop>
					<stop offset="0.3" stop-color="#ffd890" stop-opacity="0.55"></stop>
					<stop offset="1" stop-color="#ffd890" stop-opacity="0"></stop>
				</radialGradient>
				<linearGradient id={g('cone')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="#ffd890" stop-opacity="0.16"></stop>
					<stop offset="1" stop-color="#ffd890" stop-opacity="0.03"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${g('night')})`}></rect>
			{STARS1.map(([x, y, m]) => <circle class="li-star" cx={x} cy={y} r={0.6 + m} style={`opacity:${m}`} />)}
			{HOUSES.map((h) => <rect class="li-house" x={h.x} y={204 - h.h} width={h.w} height={h.h} />)}
			{WINDOWS.map(([x, y]) => <rect class="li-win" x={x} y={y} width="9" height="11" rx="1" />)}
			<!-- the pavement: the far edge, the surface, the kerb -->
			<rect class="li-pave" x="0" y="204" width="360" height="36"></rect>
			<line class="li-kerb" x1="0" y1="204" x2="360" y2="204"></line>
			<!-- the lamp's light: a faint cone in the air and the pool on the pavement -->
			<polygon points="64,70 76,70 420,216 -280,216" fill={`url(#${g('cone')})`}></polygon>
			<ellipse cx="70" cy="218" rx="330" ry="24" fill={`url(#${g('pool')})`}></ellipse>
			<!-- the shadow on the pavement: from the feet to the tip -->
			<path class="li-shadow" d="" data-shadow></path>
			<!-- the post and the lamp -->
			<rect class="li-post" x="42" y="62" width="6" height="156" rx="2"></rect>
			<path class="li-arm" d="M 45 64 Q 45 54 56 54 H 70 V 60"></path>
			<path class="li-head" d="M 62 60 H 78 L 75 66 H 65 Z"></path>
			<circle cx="70" cy="67" r="26" fill={`url(#${g('glow')})`}></circle>
			<circle class="li-bulb" cx="70" cy="67" r="2.6"></circle>
			<!-- the straight line from the lamp over the head to the tip of the shadow -->
			<line class="li-ray" x1="70" y1="67" x2="70" y2="216" data-ray></line>
			<!-- the man (local: feet at 0, 0, facing +x; 51 px = 1,7 m) -->
			<g data-man>
				<g data-leg2><path class="li-leg li-back" d="M 0 -25 V -2"></path><path class="li-shoe li-back" d="M -2 -3 H 4 Q 6 -3 6 -1 V 0 H -2 Z"></path></g>
				<g data-arm2><path class="li-armm li-back" d="M 0 -40 V -24"></path></g>
				<rect class="li-coat" x="-5.5" y="-43" width="11" height="21" rx="4"></rect>
				<circle class="li-face" cx="0.8" cy="-46.6" r="4.4"></circle>
				<path class="li-hair" d="M -3.6 -47 Q -4 -51.4 0.8 -51.2 Q 5 -51 5 -48.4 Q 1 -49.6 -3.6 -47 Z"></path>
				<g data-leg1><path class="li-leg" d="M 0 -25 V -2"></path><path class="li-shoe" d="M -2 -3 H 4 Q 6 -3 6 -1 V 0 H -2 Z"></path></g>
				<g data-arm1><path class="li-armm" d="M 0 -40 V -24"></path></g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Человек уходит от фонаря, и его тень на тротуаре становится всё длиннее, ведь <More term="свет фонаря идёт по прямым линиям">Тень кончается там, куда падает луч, прошедший над самой макушкой. Фонарь висит на высоте 5 м, человек ростом 1,7 м. В 2 м от столба его тень около 1 м, в 6 м — уже около 3 м: во сколько раз дальше от столба, во столько раз длиннее тень. Подробнее — в разделе <a href="#тень-и-полутень">«Тень и полутень»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="eclipse">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Полдень, поле и холмы. Луна наползает на Солнце и закрывает его целиком: темнеет, видны звёзды и сияние вокруг чёрного диска, на горизонте светлая полоса, зажигается фонарь. Потом Луна уходит, и снова светлый день">
			<defs>
				<linearGradient id={g('sky')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" data-sky0></stop>
					<stop offset="1" data-sky1></stop>
				</linearGradient>
				<linearGradient id={g('dusk')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="#e88a4a" stop-opacity="0"></stop>
					<stop offset="1" stop-color="#e88a4a" stop-opacity="0.85"></stop>
				</linearGradient>
				<radialGradient id={g('sun')}>
					<stop offset="0" stop-color="#fffdf3"></stop>
					<stop offset="0.7" stop-color="#fff3c8"></stop>
					<stop offset="1" stop-color="#ffc46b"></stop>
				</radialGradient>
				<radialGradient id={g('glare')}>
					<stop offset="0.35" stop-color="#fffae1" stop-opacity="0.9"></stop>
					<stop offset="1" stop-color="#fffae1" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id={g('corona')}>
					<stop offset="0.3" stop-color="#fffffa" stop-opacity="0.95"></stop>
					<stop offset="0.36" stop-color="#ebf0ff" stop-opacity="0.55"></stop>
					<stop offset="0.6" stop-color="#c8d7ff" stop-opacity="0.15"></stop>
					<stop offset="1" stop-color="#c8d7ff" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id={g('streamer')} cx={SX} cy={SY} r={RS * 3.6} gradientUnits="userSpaceOnUse">
					<stop offset="0.27" stop-color="#f0f4ff" stop-opacity="0.3"></stop>
					<stop offset="1" stop-color="#f0f4ff" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id={g('lamp')}>
					<stop offset="0" stop-color="#fff1c8" stop-opacity="0.9"></stop>
					<stop offset="1" stop-color="#ffd890" stop-opacity="0"></stop>
				</radialGradient>
				<clipPath id={g('clip')}><circle cx={SX} cy={SY} r={RS}></circle></clipPath>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${g('sky')})`}></rect>
			<rect x="0" y="120" width="360" height="62" fill={`url(#${g('dusk')})`} data-dusk></rect>
			<g data-stars>
				{STARS2.map(([x, y, m]) => <circle class="li-star" cx={x} cy={y} r={0.6 + m} style={`opacity:${m}`} />)}
				<circle class="li-star" cx="196" cy="102" r="2.1"></circle>
			</g>
			<g data-corona>
				<circle cx={SX} cy={SY} r={RS * 3.3} fill={`url(#${g('corona')})`}></circle>
				{STREAMERS.map((d) => <path d={d} fill={`url(#${g('streamer')})`} />)}
			</g>
			<circle cx={SX} cy={SY} r={RS * 2.8} fill={`url(#${g('glare')})`} data-glare></circle>
			<circle cx={SX} cy={SY} r={RS} fill={`url(#${g('sun')})`} data-sun></circle>
			<g clip-path={`url(#${g('clip')})`}><circle class="li-moon" r={RM} data-moon1></circle></g>
			<circle class="li-moon li-moon--edge" r={RM} data-moon2></circle>
			<!-- the land: far hills, a house with a street lamp, a tree, the field -->
			<path d="M 0 178 Q 40 160 90 168 Q 140 176 180 162 Q 236 146 290 164 Q 330 176 360 166 V 240 H 0 Z" data-hills></path>
			<path d="M 0 192 Q 120 184 220 190 Q 300 194 360 186 V 240 H 0 Z" data-field></path>
			<g data-house>
				<rect x="40" y="168" width="40" height="28"></rect>
				<path d="M 36 170 L 60 152 L 84 170 Z"></path>
				<rect x="96" y="156" width="2.4" height="40"></rect>
				<path d="M 97 157 H 103 V 159"></path>
			</g>
			<rect class="li-win2" x="50" y="176" width="8" height="8" data-win></rect>
			<circle cx="103" cy="161" r="14" fill={`url(#${g('lamp')})`} data-lamp></circle>
			<g data-tree>
				<rect x="300" y="166" width="4" height="26"></rect>
				<ellipse cx="302" cy="160" rx="16" ry="18"></ellipse>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Днём Луна закрывает Солнце: на несколько минут темнеет, как вечером, и загораются звёзды. Это <More term="мы оказались в тени Луны">Луна в 400 раз меньше Солнца, но и почти в 400 раз ближе к нам, поэтому на небе они почти одного размера. Тень Луны ложится на Землю пятном не шире 270 км, и это пятно бежит по Земле. Поэтому в одном месте полное затмение длится лишь несколько минут. Подробнее — в разделе <a href="#солнечные-и-лунные-затмения">«Солнечные и лунные затмения»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.li-star {
		fill: #f4f6ff;
	}
	.li-house {
		fill: #121830;
	}
	.li-win {
		fill: #f3c76a;
		opacity: 0.55;
	}
	.li-pave {
		fill: #262b3c;
	}
	.li-kerb {
		stroke: #3c4258;
		stroke-width: 1.5;
	}
	.li-shadow {
		fill: #1b1f2d;
	}
	.li-post,
	.li-arm,
	.li-head {
		fill: #3b4157;
	}
	.li-arm {
		fill: none;
		stroke: #3b4157;
		stroke-width: 3;
	}
	.li-bulb {
		fill: #fffaf0;
	}
	.li-ray {
		stroke: #ffd890;
		stroke-width: 1.3;
		stroke-dasharray: 5 4;
		opacity: 0;
	}
	.li-leg,
	.li-armm {
		fill: none;
		stroke: #3d4660;
		stroke-width: 4.6;
		stroke-linecap: round;
	}
	.li-armm {
		stroke: #6a5546;
		stroke-width: 3.6;
	}
	.li-shoe {
		fill: #20263a;
	}
	.li-back {
		filter: brightness(0.75);
	}
	.li-coat {
		fill: #7a604b;
	}
	.li-face {
		fill: #c99a7a;
	}
	.li-hair {
		fill: #2b2420;
	}
	.li-moon {
		fill: #2a3046;
	}
	.li-moon--edge {
		fill: #05060c;
		opacity: 0;
	}
	.li-win2 {
		fill: #f3c76a;
		opacity: 0;
	}
	[data-lightintro] [data-house],
	[data-lightintro] [data-tree] {
		fill: currentColor;
		stroke: currentColor;
		stroke-width: 0.8;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';
	import { visibleFraction } from './sv';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);
	type RGB = [number, number, number];
	const mix = (a: RGB, b: RGB, t: number) => `rgb(${a.map((v, i) => Math.round(b[i] + (v - b[i]) * t)).join(',')})`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-lightintro]')) {
		// Street: he walks from 1 m to 6 m from the post (0,08 → 0,8), stops; the dashed line shows at the end; 6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="street"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const man = $<SVGGElement>('[data-man]');
			const legs = [$<SVGGElement>('[data-leg1]'), $<SVGGElement>('[data-leg2]')];
			const arms = [$<SVGGElement>('[data-arm1]'), $<SVGGElement>('[data-arm2]')];
			const shadow = $<SVGPathElement>('[data-shadow]');
			const ray = $<SVGLineElement>('[data-ray]');
			const LX = 70; // the lamp: x, height above the pavement (px; 30 px = 1 m)
			const LY = 67;
			const GY = 216;
			const H = GY - LY; // 149 px ≈ 5 m
			const h = 51; // 1,7 m
			const X0 = LX + 30; // 1 m from the post
			const X1 = LX + 180; // 6 m
			const STRIDE = 22; // px per step (0,73 m)
			scene(card, 6, (x) => {
				const s = smooth(0.08, 0.8, x);
				const px = X0 + (X1 - X0) * s;
				const ph = (Math.PI * (px - X0)) / STRIDE;
				const moving = x > 0.08 && x < 0.8 ? 1 : 0;
				const sw = 0.42 * Math.sin(ph) * (moving ? 1 : 0);
				const bob = -1.2 * Math.abs(Math.sin(ph)) * moving;
				man.setAttribute('transform', `translate(${f1(px)} ${f1(GY + bob)})`);
				const deg = (sw * 180) / Math.PI;
				legs[0].setAttribute('transform', `rotate(${f1(deg)} 0 -25)`);
				legs[1].setAttribute('transform', `rotate(${f1(-deg)} 0 -25)`);
				arms[0].setAttribute('transform', `rotate(${f1(-0.8 * deg)} 0 -40)`);
				arms[1].setAttribute('transform', `rotate(${f1(0.8 * deg)} 0 -40)`);
				// the tip of the shadow: where the line from the lamp over the top of the head meets the pavement
				const top = h - bob;
				const tip = LX + ((px + 0.8 - LX) * H) / (H - top);
				shadow.setAttribute(
					'd',
					`M ${f1(px - 4)} ${GY - 1.5} L ${f1(tip - 2)} ${GY - 0.6} Q ${f1(tip + 1)} ${GY + 0.6} ${f1(tip - 2)} ${GY + 1.8} L ${f1(px - 4)} ${GY + 3} Z`,
				);
				ray.setAttribute('x2', f1(tip));
				ray.setAttribute('y2', f1(GY));
				ray.style.opacity = f2(0.9 * smooth(0.82, 0.88, x));
			});
		}

		// Eclipse: the Moon from the right of the Sun to its left (0,04 → 0,96), slowest at the middle; 10 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="eclipse"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const SX = 238;
			const SY = 74;
			const RS = 19;
			const RM = 20;
			const sky0 = $<SVGStopElement>('[data-sky0]');
			const sky1 = $<SVGStopElement>('[data-sky1]');
			const dusk = $<SVGRectElement>('[data-dusk]');
			const stars = $<SVGGElement>('[data-stars]');
			const corona = $<SVGGElement>('[data-corona]');
			const glare = $<SVGCircleElement>('[data-glare]');
			const moon1 = $<SVGCircleElement>('[data-moon1]');
			const moon2 = $<SVGCircleElement>('[data-moon2]');
			const hills = $<SVGPathElement>('[data-hills]');
			const field = $<SVGPathElement>('[data-field]');
			const house = $<SVGGElement>('[data-house]');
			const tree = $<SVGGElement>('[data-tree]');
			const win = $<SVGRectElement>('[data-win]');
			const lamp = $<SVGCircleElement>('[data-lamp]');
			scene(card, 10, (x) => {
				// the Moon's offset along its path: t from 1 to −1, slow near the middle (totality ≈ 1,5 s)
				const t = 1 - 2 * smooth(0.04, 0.96, x);
				const u = 2.6 * RS * Math.sign(t) * Math.abs(t) ** 2.2;
				const mx = SX + u;
				const my = SY + 0.3 * u;
				for (const m of [moon1, moon2]) {
					m.setAttribute('cx', f1(mx));
					m.setAttribute('cy', f1(my));
				}
				const f = visibleFraction(RS, RM, Math.hypot(mx - SX, my - SY));
				const L = Math.pow(f, 0.33); // daylight as the eye sees it
				const cor = clamp(1 - f / 0.004);
				sky0.setAttribute('stop-color', mix([72, 132, 206], [6, 9, 24], L));
				sky1.setAttribute('stop-color', mix([150, 196, 236], [30, 34, 62], L));
				dusk.style.opacity = f2(cor * 0.9);
				stars.style.opacity = f2(clamp((0.3 - L) / 0.25));
				corona.style.opacity = f2(cor);
				glare.style.opacity = f2(0.6 * f);
				moon2.style.opacity = f2(cor);
				const amb = Math.max(L, 0.12 * cor); // the land: lit by the sky, a little by the bright horizon in totality
				hills.style.fill = mix([86, 128, 92], [16, 22, 26], amb);
				field.style.fill = mix([112, 156, 84], [18, 24, 22], amb);
				house.style.color = mix([120, 96, 84], [14, 16, 22], amb);
				tree.style.color = mix([52, 96, 60], [10, 14, 16], amb);
				win.style.opacity = f2(cor * 0.95);
				lamp.style.opacity = f2(cor);
			});
		}
	}
</script>
