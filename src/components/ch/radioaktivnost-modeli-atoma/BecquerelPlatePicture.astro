---
/**
 * «Опыт Беккереля» (Paris, 26 February – 1 March 1896): three steps, a 9-s loop, 3 s per step; the active step is
 * marked by its dot and plays, the others show their last frame.
 *   1. A photographic plate wrapped in black paper; a thin copper Maltese cross is laid on it, then a few pale
 *      yellow-green crystals of a uranium salt (potassium uranyl sulfate) on top, in two heaps, one over the cross.
 *   2. The package goes into a desk drawer and the drawer is closed; outside the window cloudy Paris (the Eiffel tower
 *      stood since 1889); the calendar turns 26, 27, 28, 29 февраля (1896 was a leap year) → 1 марта.
 *   3. The plate developed: dark smudges under the two heaps (the radiation went through the black paper without any
 *      light); inside one of them the lighter silhouette of the cross (the copper stopped part of the radiation).
 * Not to scale; the plate was about 9 × 12 см.
 */
import RaStyles from './RaStyles.astro';

const STEPS = ['Пластинка в чёрной бумаге, сверху — соль урана', 'Несколько дней в тёмном ящике', 'Пластинка потемнела'];
// the Maltese cross (outline) centered at (0, 0), about 34 px across
const cross = 'M0 -3 L-6 -17 H6 Z M3 0 L17 -6 V6 Z M0 3 L6 17 H-6 Z M-3 0 L-17 6 V-6 Z';
const HEAPS = [
	{ x: 70, y: 74 },
	{ x: 132, y: 74 },
];
const crystals = (cx: number, cy: number) =>
	[
		[-12, -8],
		[-2, -12],
		[9, -7],
		[-8, 2],
		[4, 1],
		[13, 4],
		[-3, 11],
		[8, 12],
	].map(([dx, dy], i) => ({ x: cx + dx, y: cy + dy, r: (i * 37) % 60 }));
---

<RaStyles />
<figure class="ra bpp not-content" data-bpp>
	<div class="bpp-grid">
		<div class="bpp-step" data-step="0">
			<svg viewBox="0 0 200 150" role="img" aria-label="Фотопластинка завёрнута в чёрную бумагу, на неё положен медный крестик, а сверху насыпаны кристаллы соли урана">
				<rect class="bpp-table" x="0" y="118" width="200" height="32"></rect>
				<rect class="bpp-pack" x="22" y="34" width="156" height="82" rx="3"></rect>
				<path class="bpp-fold" d="M22 34 L60 60 M178 34 L140 60"></path>
				<g data-cross transform="translate(70 74)"><path class="bpp-cu" d={cross}></path></g>
				{
					HEAPS.map((h, j) => (
						<g data-heap={j}>
							{crystals(h.x, h.y).map((c) => (
								<rect class="bpp-cr" x={c.x - 3.5} y={c.y - 3.5} width="7" height="7" rx="1" transform={`rotate(${c.r} ${c.x} ${c.y})`} />
							))}
						</g>
					))
				}
			</svg>
			<p class="bpp-txt"><span class="bpp-dot" data-dot></span>{STEPS[0]}</p>
		</div>
		<div class="bpp-step" data-step="1">
			<svg viewBox="0 0 200 150" role="img" aria-label="Пакет с пластинкой лежит в закрытом ящике стола. За окном пасмурный Париж, листки календаря сменяются с 26 февраля на 1 марта 1896 года">
				<rect class="bpp-wall" x="0" y="0" width="200" height="150"></rect>
				<rect class="bpp-winf" x="12" y="10" width="72" height="56" rx="2"></rect>
				<rect class="bpp-sky" x="16" y="14" width="64" height="48"></rect>
				<path class="bpp-tower" d="M48 62 L52 30 L53 22 L54 30 L58 62 Z M50 46 H56"></path>
				<path class="bpp-roofs" d="M16 62 V52 h10 l4 -4 l4 4 h6 V54 h22 V50 h8 V56 h10 V62 Z"></path>
				<g data-clouds>
					<path class="bpp-cloud" d="M14 26 q4 -7 12 -4 q6 -6 13 1 q8 -1 7 6 h-34 q-4 -2 2 -3 Z"></path>
					<path class="bpp-cloud" d="M54 40 q4 -6 10 -3 q5 -5 11 1 q7 -1 6 5 h-29 q-3 -2 2 -3 Z"></path>
				</g>
				<path class="bpp-bar" d="M48 14 V62 M16 38 H80"></path>
				<!-- the calendar -->
				<rect class="bpp-cal" x="120" y="14" width="56" height="50" rx="3"></rect>
				<rect class="bpp-calt" x="120" y="14" width="56" height="12" rx="3"></rect>
				<text class="bpp-caly" x="148" y="23.5" text-anchor="middle">1896</text>
				<text class="bpp-cald" x="148" y="47" text-anchor="middle" data-day>26</text>
				<text class="bpp-calm" x="148" y="58" text-anchor="middle" data-month>февраля</text>
				<!-- the desk and the drawer -->
				<rect class="bpp-desk" x="10" y="80" width="180" height="10"></rect>
				<rect class="bpp-deskb" x="18" y="90" width="164" height="50"></rect>
				<rect class="bpp-inside" x="40" y="96" width="120" height="30"></rect>
				<rect class="bpp-pack" x="56" y="100" width="74" height="20" rx="2" data-pk></rect>
				<g data-drawer>
					<rect class="bpp-drawer" x="38" y="94" width="124" height="34" rx="2"></rect>
					<rect class="bpp-knob" x="92" y="108" width="16" height="5" rx="2"></rect>
				</g>
			</svg>
			<p class="bpp-txt"><span class="bpp-dot" data-dot></span>{STEPS[1]}</p>
		</div>
		<div class="bpp-step" data-step="2">
			<svg viewBox="0 0 200 150" role="img" aria-label="Проявленная пластинка: под кристаллами соли урана тёмные пятна, а в одном из них светлый силуэт крестика">
				<defs>
					<filter id="bpp-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="5"></feGaussianBlur></filter>
					<filter id="bpp-blur2" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="1.2"></feGaussianBlur></filter>
				</defs>
				<rect class="bpp-table" x="0" y="118" width="200" height="32"></rect>
				<rect class="bpp-plate" x="22" y="34" width="156" height="82" rx="2"></rect>
				<g data-dev>
					{HEAPS.map((h) => <ellipse class="bpp-dark" cx={h.x} cy={h.y} rx="26" ry="22" filter="url(#bpp-blur)" />)}
					<g transform="translate(70 74)" filter="url(#bpp-blur2)"><path class="bpp-light" d={cross}></path></g>
				</g>
			</svg>
			<p class="bpp-txt"><span class="bpp-dot" data-dot></span>{STEPS[2]}</p>
		</div>
	</div>
</figure>

<script>
	import { loop } from '@components/ch/g7/kit';

	const DAYS = [
		['26', 'февраля'],
		['27', 'февраля'],
		['28', 'февраля'],
		['29', 'февраля'],
		['1', 'марта'],
	];
	const c01 = (x: number) => Math.min(1, Math.max(0, x));
	const ease = (x: number) => 0.5 - 0.5 * Math.cos(Math.PI * c01(x));
	document.querySelectorAll<HTMLElement>('[data-bpp]').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
		const crossG = q<SVGGElement>('[data-cross]');
		const heaps = [...root.querySelectorAll<SVGGElement>('[data-heap]')];
		const drawer = q<SVGGElement>('[data-drawer]');
		const pk = q<SVGRectElement>('[data-pk]');
		const day = q<SVGTextElement>('[data-day]');
		const month = q<SVGTextElement>('[data-month]');
		const clouds = q<SVGGElement>('[data-clouds]');
		const dev = q<SVGGElement>('[data-dev]');
		let t = 0;
		const draw = () => {
			const s = t % 9;
			const k = Math.floor(s / 3);
			const u = (s % 3) / 3; // progress within the active step
			steps.forEach((e, i) => e.classList.toggle('is-on', i === k));
			// step 1: the cross comes down, then the crystals
			const p1 = k === 0 ? u : 1;
			crossG.setAttribute('transform', `translate(70 ${(74 - 40 * (1 - ease(p1 / 0.35))).toFixed(1)})`);
			crossG.style.opacity = c01(p1 / 0.1).toFixed(2);
			heaps.forEach((h, j) => {
				const a = c01((p1 - 0.4 - 0.2 * j) / 0.25);
				h.style.opacity = a.toFixed(2);
				h.setAttribute('transform', `translate(0 ${(-10 * (1 - ease(a))).toFixed(1)})`);
			});
			// step 2: the package goes in, the drawer closes, the days pass
			const p2 = k === 1 ? u : 1;
			// the package comes down into the open drawer (seen from above the front), then the drawer closes
			pk.setAttribute('y', (100 - 34 * (1 - ease(p2 / 0.2))).toFixed(1));
			const open = 1 - ease((p2 - 0.2) / 0.2);
			drawer.setAttribute('transform', `translate(0 ${(open * 24).toFixed(1)})`);
			const di = Math.min(4, Math.floor(c01((p2 - 0.42) / 0.5) * 5));
			day.textContent = DAYS[di][0];
			month.textContent = DAYS[di][1];
			clouds.setAttribute('transform', `translate(${(((t * 4) % 40) - 10).toFixed(1)} 0)`);
			// step 3: the plate darkens
			const p3 = k === 2 ? u : 1;
			dev.style.opacity = ease(p3 / 0.6).toFixed(2);
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	});
</script>

<style is:global>
	.bpp-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@media (max-width: 40rem) {
		.bpp-grid {
			grid-template-columns: 1fr;
		}
		.bpp-step svg {
			max-width: 18rem;
		}
	}
	.bpp-step {
		opacity: 0.55;
		transition: opacity 0.3s;
	}
	.bpp-step.is-on {
		opacity: 1;
	}
	.bpp-txt {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		text-align: center;
		line-height: 1.35;
	}
	.bpp-dot {
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		margin-right: 0.35rem;
		border-radius: 50%;
		border: 1px solid var(--sl-color-gray-3);
		vertical-align: 0.05rem;
	}
	.bpp-step.is-on .bpp-dot {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
	}
	.bpp-table {
		fill: hsl(28, 35%, 35%);
	}
	.bpp-pack {
		fill: hsl(230, 10%, 10%);
		stroke: hsl(230, 10%, 30%);
	}
	.bpp-fold {
		stroke: hsl(230, 10%, 25%);
		stroke-width: 0.8;
	}
	.bpp-cu {
		fill: hsl(22, 65%, 52%);
		stroke: hsl(22, 60%, 35%);
		stroke-width: 0.8;
	}
	.bpp-cr {
		fill: hsl(70, 70%, 72%);
		stroke: hsl(70, 40%, 45%);
		stroke-width: 0.5;
	}
	.bpp-wall {
		fill: color-mix(in srgb, var(--ig-v) 12%, var(--sl-color-gray-6));
	}
	.bpp-winf {
		fill: var(--sl-color-gray-4);
	}
	.bpp-sky {
		fill: hsl(210, 15%, 72%);
	}
	.bpp-tower {
		fill: hsl(215, 15%, 45%);
		stroke: hsl(215, 15%, 45%);
		stroke-width: 0.6;
	}
	.bpp-roofs {
		fill: hsl(215, 15%, 50%);
	}
	.bpp-cloud {
		fill: hsl(210, 10%, 88%);
	}
	.bpp-bar {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2.5;
	}
	.bpp-cal {
		fill: hsl(0, 0%, 96%);
		stroke: hsl(0, 0%, 70%);
	}
	.bpp-calt {
		fill: hsl(0, 60%, 50%);
	}
	.bpp-caly {
		fill: white;
		font-size: 8px;
	}
	.bpp-cald {
		fill: hsl(220, 20%, 15%);
		font-size: 20px;
		font-weight: 700;
	}
	.bpp-calm {
		fill: hsl(220, 20%, 25%);
		font-size: 8px;
	}
	.bpp-desk {
		fill: hsl(28, 40%, 38%);
	}
	.bpp-deskb {
		fill: hsl(28, 35%, 30%);
	}
	.bpp-inside {
		fill: hsl(28, 30%, 18%);
	}
	.bpp-drawer {
		fill: hsl(28, 38%, 40%);
		stroke: hsl(28, 35%, 25%);
	}
	.bpp-knob {
		fill: hsl(40, 40%, 60%);
	}
	.bpp-plate {
		fill: hsl(45, 15%, 82%);
		stroke: hsl(45, 10%, 60%);
	}
	.bpp-dark {
		fill: hsl(220, 15%, 12%);
		opacity: 0.85;
	}
	.bpp-light {
		fill: hsl(45, 15%, 70%);
	}
</style>
