---
/**
 * «Где это встречается»: four small looping tiles, one per line of the list. Colors as in RaStyles: α red-pink
 * (--ig-vy), β and electrons blue (--ig-vx), γ gold (--ig-v). All tiles are schematic, not to scale; the clocks are slowed.
 *   Датчик дыма (α, 10-s loop): a cross-section of an ionization smoke detector on the ceiling. A speck of americium-241
 *     on the lower plate sends α tracks up across the gap; each track leaves ion pairs: positive ions (red-pink) drift
 *     to the «−» plate, electrons (blue) to the «+» plate, and the meter «ток» shows the arrivals (a moving average).
 *     Smoke rises, comes in through the side slits, and its particles catch ions (an ion stops and fades with the
 *     smoke); the current drops, and below the alarm threshold the beeper sounds «пи-пи». The real source is about
 *     30–40 кБк; α particles go a few centimeters in air and stay inside the case.
 *   Толщиномер (β, 11-s loop): a sheet runs from the rollers to the right at a steady speed. β particles from the source
 *     above go down through the sheet to the counter below; each one passes with probability exp(−0,15·h), h the
 *     sheet's thickness in drawing units, the others stop in the sheet. The rollers drift apart for a moment; the thick
 *     part reaches the gauge, the count falls, the control line lights up and the upper roller goes back down. The
 *     thickness at x is the gap the rollers had when that part of the sheet passed them, so the loop has no jump.
 *   Просвечивание шва (γ, 9-s loop): a steel pipe with a weld ring; a crack in the weld. The source (iridium-192) is
 *     pushed out of its heavy container, a fan of γ rays passes the pipe and exposes the film below; the film darkens,
 *     less under the thicker weld and more under the crack (less steel there), so the crack shows as a dark line.
 *     Then the source goes back, the label «трещина» appears, and the next film starts.
 *   Стерилизация (γ, 20-s loop): sealed packages with syringes ride a conveyor under a cobalt-60 source behind
 *     concrete; γ rays go out of the source through the packages; the microbes inside (green) die (turn gray and
 *     vanish) while the package passes under the source. The state of a package depends only on its position, so the
 *     loop has no jump.
 */
import G7Styles from '../g7/G7Styles.astro';

const VENTS = [14, 26, 38, 50, 62];
---

<G7Styles />
<figure class="g7 g7--pic rwu not-content" data-raduses>
	<div class="g7__grid rwu__grid">
		<div>
			<svg class="g7__svg" viewBox="0 0 240 150" role="img" aria-label="Пожарный датчик дыма в разрезе: крупинка америция-241 на нижней пластине испускает α-частицы, они выбивают электроны из атомов воздуха, и между пластинами идёт ток. Дым попадает внутрь, захватывает ионы, ток падает, и датчик пищит">
				<rect class="rwu-ceil" x="0" y="0" width="240" height="8"></rect>
				<path class="rwu-case" d="M28 8 V70 Q28 92 50 92 H190 Q212 92 212 70 V8 Z"></path>
				<path class="rwu-case-l" d="M28 70 Q28 92 50 92 H190 Q212 92 212 70"></path>
				{VENTS.map((y) => <path class="rwu-case-l" d={`M28 ${y - 6} V${y} M212 ${y - 6} V${y}`} />)}
				<rect class="rwu-plate" x="66" y="24" width="96" height="3"></rect>
				<rect class="rwu-plate" x="66" y="66" width="96" height="3"></rect>
				<text class="rwu-pm" x="60" y="29" text-anchor="end">+</text>
				<text class="rwu-pm" x="60" y="72" text-anchor="end">−</text>
				<path class="rwu-wire" d="M162 25.5 H186 V30 M162 67.5 H186 V66"></path>
				<rect class="rwu-meter" x="180" y="30" width="12" height="36" rx="2"></rect>
				<rect class="rwu-cur" data-cur x="182" y="32" width="8" height="32"></rect>
				<text class="rwu-s" x="186" y="20" text-anchor="middle">ток</text>
				<g data-smoke></g>
				<g data-tracks></g>
				<g data-ions></g>
				<rect class="rwu-am" x="108" y="63" width="14" height="3" rx="1"></rect>
				<circle class="rwu-led" data-led cx="70" cy="85" r="3"></circle>
				<g data-beep opacity="0">
					<path class="rwu-arc" d="M176 98 q6 5 0 10 M182 96 q9 7 0 14"></path>
					<text class="rwu-s rwu-beep t-halo" x="192" y="108">пи-пи!</text>
				</g>
				<path class="rwu-lead" d="M110 66 L72 112"></path>
				<text class="rwu-s t-halo" x="72" y="122" text-anchor="middle">америций-241</text>
				<text class="rwu-s t-halo" data-smoke-l x="176" y="140" text-anchor="middle" opacity="0">дым</text>
			</svg>
			<p class="rwu__t"><span class="rwu-ka">α</span> Пожарный датчик дыма</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 240 150" role="img" aria-label="Толщиномер: лист выходит из валков; β-частицы от источника над листом проходят сквозь него к счётчику. Когда лист становится толще, до счётчика долетает меньше частиц, и машина сдвигает валки">
				<path class="rwu-ctl" data-ctl d="M212 100 V14 H46 V44"></path>
				<path class="rwu-ctl-a" data-ctl-a d="M42 40 L46 47 L50 40"></path>
				<path class="rwu-sheet" data-sheet d=""></path>
				<g data-ticks></g>
				<g data-roll-t><circle class="rwu-roll" r="16"></circle><path class="rwu-spoke" d="M-12 0 H12 M0 -12 V12"></path></g>
				<g transform="translate(46 106)"><g data-roll-b><circle class="rwu-roll" r="16"></circle><path class="rwu-spoke" d="M-12 0 H12 M0 -12 V12"></path></g></g>
				<rect class="rwu-src" x="148" y="30" width="24" height="16" rx="2"></rect>
				<text class="rwu-k rwu-kb" x="160" y="42.5" text-anchor="middle">β</text>
				<g data-beta></g>
				<rect class="rwu-det" data-det x="146" y="104" width="28" height="12" rx="2"></rect>
				<path class="rwu-wire" d="M174 110 H196"></path>
				<rect class="rwu-meter" x="196" y="100" width="32" height="20" rx="2"></rect>
				<rect class="rwu-rate" data-rate x="199" y="106" width="26" height="8"></rect>
				<text class="rwu-s" x="160" y="132" text-anchor="middle">счётчик</text>
				<text class="rwu-s" x="46" y="140" text-anchor="middle">валки</text>
			</svg>
			<p class="rwu__t"><span class="rwu-kb">β</span> Толщиномер на заводе</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 240 150" role="img" aria-label="Просвечивание сварного шва: источник γ-излучения выдвигается из контейнера над стальной трубой, излучение проходит сквозь трубу и засвечивает плёнку под ней; на плёнке трещина в шве видна тёмной линией">
				<defs>
					<linearGradient id="rwu-pipe-g" x1="0" y1="0" x2="0" y2="1">
						<stop class="rwu-pg0" offset="0"></stop>
						<stop class="rwu-pg1" offset="0.35"></stop>
						<stop class="rwu-pg2" offset="1"></stop>
					</linearGradient>
				</defs>
				<rect class="rwu-pipe" x="12" y="48" width="216" height="40" fill="url(#rwu-pipe-g)"></rect>
				<ellipse class="rwu-pipe-end" cx="12" cy="68" rx="6" ry="20"></ellipse>
				<ellipse class="rwu-pipe-in" cx="12" cy="68" rx="3.6" ry="16"></ellipse>
				<rect class="rwu-weld" x="113" y="46" width="14" height="44" rx="3"></rect>
				<path class="rwu-crack" d="M119 56 L121.5 60 L118.5 64 L121.5 69 L119 73"></path>
				<circle class="rwu-gsrc" data-gsrc cx="120" cy="18" r="3"></circle>
				<rect class="rwu-cont" x="100" y="6" width="40" height="20" rx="3"></rect>
				<text class="rwu-s" x="146" y="20">иридий-192</text>
				<g data-grays></g>
				<rect class="rwu-film" x="60" y="100" width="120" height="12" rx="1"></rect>
				<rect class="rwu-expo" data-expo x="60" y="100" width="120" height="12" rx="1"></rect>
				<rect class="rwu-expo-w" data-expo-w x="113" y="100" width="14" height="12"></rect>
				<path class="rwu-expo-c" data-expo-c d="M119 100 L121.5 103 L118.5 106 L121.5 109 L119 112"></path>
				<path class="rwu-lead" d="M130 50 L142 42"></path>
				<text class="rwu-s t-halo" x="144" y="42">шов</text>
				<text class="rwu-s" x="186" y="109">плёнка</text>
				<g data-crack-l opacity="0">
					<path class="rwu-lead" d="M120 113 V126"></path>
					<text class="rwu-s" x="120" y="136" text-anchor="middle">трещина</text>
				</g>
			</svg>
			<p class="rwu__t"><span class="rwu-kg">γ</span> Просвечивание сварных швов</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 240 150" role="img" aria-label="Стерилизация: запечатанные упаковки со шприцами едут по конвейеру под источником кобальта-60 за бетонными стенами; γ-излучение проходит сквозь упаковки, и микробы внутри погибают">
				<rect class="rwu-conc" x="0" y="0" width="240" height="10"></rect>
				<rect class="rwu-conc" x="0" y="0" width="12" height="84"></rect>
				<rect class="rwu-conc" x="228" y="0" width="12" height="84"></rect>
				<circle class="rwu-glow" data-glow cx="120" cy="40" r="16"></circle>
				<rect class="rwu-rod" x="116" y="20" width="8" height="40" rx="2"></rect>
				<text class="rwu-s t-halo" x="130" y="30">кобальт-60</text>
				<g data-packs></g>
				<g data-srays></g>
				<rect class="rwu-belt" x="0" y="120" width="240" height="4"></rect>
				<g data-wheels></g>
			</svg>
			<p class="rwu__t"><span class="rwu-kg">γ</span> Стерилизация</p>
		</div>
	</div>
	<figcaption class="g7__caption">Рисунки схематичные, не в масштабе.</figcaption>
</figure>

<style is:global>
	.rwu {
		--rwu-a: var(--ig-vy);
		--rwu-b: var(--ig-vx);
		--rwu-g: var(--ig-v);
		--rwu-smoke: var(--sl-color-gray-3);
		--rwu-concrete: color-mix(in oklab, var(--ig-v) 8%, var(--sl-color-gray-5));
		--rwu-film: hsl(200, 10%, 82%);
		--rwu-film-dark: hsl(220, 12%, 16%);
	}
	:root[data-theme='light'] .rwu {
		--rwu-smoke: var(--sl-color-gray-4);
		--rwu-concrete: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-5));
	}
	.rwu .rwu__grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@media (max-width: 40rem) {
		.rwu .rwu__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.rwu .rwu__t {
		margin: 0.35rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rwu .rwu-ka,
	.rwu .rwu-kb,
	.rwu .rwu-kg {
		font-weight: 700;
	}
	.rwu .rwu-ka {
		color: var(--rwu-a);
		fill: var(--rwu-a);
	}
	.rwu .rwu-kb {
		color: var(--rwu-b);
		fill: var(--rwu-b);
	}
	.rwu .rwu-kg {
		color: var(--rwu-g);
		fill: var(--rwu-g);
	}
	/* text in drawing units: a tile is about 1,4 px per unit on a computer and on a 390-px phone */
	.rwu .g7__svg text {
		font-size: 10px;
	}
	.rwu .g7__svg .rwu-s {
		font-size: 9.5px;
		fill: var(--sl-color-gray-2);
	}
	.rwu .g7__svg .rwu-k {
		font-size: 12px;
	}
	.rwu .g7__svg .rwu-pm {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-gray-2);
	}
	.rwu .rwu-ceil,
	.rwu .rwu-conc {
		fill: var(--rwu-concrete);
	}
	.rwu .rwu-case {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.rwu .rwu-case-l {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.rwu .rwu-plate {
		fill: var(--g7-steel);
	}
	.rwu .rwu-wire,
	.rwu .rwu-lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.rwu .rwu-lead {
		stroke-dasharray: 2 2;
	}
	.rwu .rwu-meter {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-3);
	}
	.rwu .rwu-cur,
	.rwu .rwu-rate {
		fill: var(--sl-color-accent);
	}
	.rwu .rwu-am {
		fill: var(--rwu-a);
	}
	.rwu .rwu-trk {
		stroke: var(--rwu-a);
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	.rwu .rwu-ip {
		fill: var(--rwu-a);
	}
	.rwu .rwu-ie {
		fill: var(--rwu-b);
	}
	.rwu .rwu-smk {
		fill: var(--rwu-smoke);
	}
	.rwu .rwu-led {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.rwu .rwu-led.is-on {
		fill: hsl(0, 85%, 58%);
	}
	.rwu .rwu-arc {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
		stroke-linecap: round;
	}
	.rwu .rwu-beep {
		font-weight: 700;
	}
	.rwu .rwu-sheet {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-3));
	}
	.rwu .rwu-tick {
		stroke: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-4));
		stroke-width: 0.8;
	}
	.rwu .rwu-roll {
		fill: var(--g7-steel);
		stroke: var(--g7-steel-dark);
		stroke-width: 1.2;
	}
	.rwu .rwu-spoke {
		stroke: var(--g7-steel-dark);
		stroke-width: 1.2;
	}
	.rwu .rwu-src,
	.rwu .rwu-det,
	.rwu .rwu-cont {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
	}
	.rwu .rwu-det.is-hit {
		fill: color-mix(in srgb, var(--rwu-b) 35%, var(--sl-color-gray-5));
	}
	.rwu .rwu-beta {
		fill: var(--rwu-b);
	}
	.rwu .rwu-ctl {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 2;
	}
	.rwu .rwu-ctl-a {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.rwu .rwu-ctl.is-on,
	.rwu .rwu-ctl-a.is-on {
		stroke: var(--sl-color-accent);
	}
	.rwu .rwu-pg0 {
		stop-color: color-mix(in oklab, var(--g7-steel) 60%, white);
	}
	.rwu .rwu-pg1 {
		stop-color: var(--g7-steel);
	}
	.rwu .rwu-pg2 {
		stop-color: var(--g7-steel-dark);
	}
	.rwu .rwu-pipe-end {
		fill: var(--g7-steel);
		stroke: var(--g7-steel-dark);
	}
	.rwu .rwu-pipe-in {
		fill: color-mix(in oklab, var(--g7-steel-dark) 50%, black);
	}
	.rwu .rwu-weld {
		fill: color-mix(in oklab, var(--g7-steel-dark) 80%, var(--ig-v));
		stroke: var(--g7-steel-dark);
	}
	.rwu .rwu-crack {
		fill: none;
		stroke: hsl(220, 20%, 10%);
		stroke-width: 1.3;
		stroke-linejoin: round;
	}
	.rwu .rwu-gsrc {
		fill: var(--rwu-g);
	}
	.rwu .rwu-cont {
		fill: hsl(220, 8%, 40%);
	}
	.rwu .rwu-gam {
		fill: none;
		stroke: var(--rwu-g);
		stroke-width: 1.1;
	}
	.rwu .rwu-film {
		fill: var(--rwu-film);
	}
	.rwu .rwu-expo,
	.rwu .rwu-expo-w {
		fill: var(--rwu-film-dark);
	}
	.rwu .rwu-expo-w {
		fill: var(--rwu-film);
	}
	.rwu .rwu-expo-c {
		fill: none;
		stroke: black;
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.rwu .rwu-rod {
		fill: color-mix(in oklab, var(--rwu-g) 55%, var(--sl-color-gray-3));
		stroke: var(--rwu-g);
	}
	.rwu .rwu-glow {
		fill: color-mix(in srgb, var(--rwu-g) 22%, transparent);
	}
	.rwu .rwu-pack {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 55%, transparent);
		stroke: var(--sl-color-gray-3);
	}
	.rwu .rwu-seal {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.rwu .rwu-syr {
		fill: color-mix(in srgb, var(--sl-color-white) 30%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.rwu .rwu-mic {
		fill: var(--g7-green);
	}
	.rwu .rwu-mic.is-dead {
		fill: var(--sl-color-gray-3);
	}
	.rwu .rwu-belt {
		fill: var(--sl-color-gray-4);
	}
	.rwu .rwu-wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	// microbes in a package (drawing units from its corner)
	const MICROBES = [
		[9, 7],
		[22, 18],
		[29, 6],
	];
	const mk = (parent: Element, tag: string, attrs: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent.append(e);
		return e;
	};
	const sm = (a: number, b: number, x: number) => {
		const f = Math.min(1, Math.max(0, (x - a) / (b - a)));
		return f * f * (3 - 2 * f);
	};
	// a short wavy γ segment from (x, y) along the unit direction (ux, uy)
	const wave = (x: number, y: number, ux: number, uy: number, len = 10) => {
		let d = '';
		for (let k = 0; k <= 20; k++) {
			const s = (k / 20) * len;
			const w = 1.3 * Math.sin((2 * Math.PI * s) / 4) * Math.sin((Math.PI * k) / 20);
			d += `${k ? 'L' : 'M'}${(x + ux * s - uy * w).toFixed(1)} ${(y + uy * s + ux * w).toFixed(1)}`;
		}
		return d;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-raduses]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let seed = 12345;
		const rnd = () => {
			seed = (seed * 1664525 + 1013904223) >>> 0;
			return seed / 4294967296;
		};

		// ---- tile 1: smoke detector ----
		const C1 = 10;
		const smokeG = $<SVGGElement>('[data-smoke]');
		const tracksG = $<SVGGElement>('[data-tracks]');
		const ionsG = $<SVGGElement>('[data-ions]');
		const cur = $<SVGRectElement>('[data-cur]');
		const led = $<SVGCircleElement>('[data-led]');
		const beep = $<SVGGElement>('[data-beep]');
		const smokeL = $<SVGTextElement>('[data-smoke-l]');
		// smoke particles: outside ones rise from the floor, inside ones wander between the plates
		const smoke = Array.from({ length: 34 }, (_, k) => {
			const inside = k < 14;
			return {
				inside,
				x: inside ? 34 + rnd() * 172 : 4 + rnd() * 232,
				y: inside ? 12 + rnd() * 76 : 96 + rnd() * 54,
				r: 1.4 + rnd() * 2.2,
				ph: rnd() * 6.28,
				el: mk(smokeG, 'circle', { class: 'rwu-smk', r: 0 }) as SVGCircleElement,
			};
		});
		type Trk = { x2: number; y2: number; age: number; el: SVGLineElement };
		type Ion = { x: number; y: number; pos: boolean; stuck: number; el: SVGCircleElement };
		const tracks: Trk[] = [];
		const ions: Ion[] = [];
		const SX = 115;
		const SY = 63;
		let spawn = 0;
		let rate = 48; // arrivals per second, moving average; 48 without smoke (8 tracks × 3 pairs × 2 kinds)
		const smokeLevel = (a: number) => sm(2.4, 4, a) * (1 - sm(7, 8.6, a));

		// ---- tile 2: thickness gauge ----
		const C2 = 11;
		const V2 = 40; // drawing units per second
		const XR = 46; // rollers' nip
		const Y2 = 90; // the sheet lies on the lower roller
		const gap = (tau: number) => {
			const a = ((tau % C2) + C2) % C2;
			return 4 + 4 * sm(1, 1.6, a) * (1 - sm(4.65, 5.25, a));
		};
		const sheet = $<SVGPathElement>('[data-sheet]');
		const ticksG = $<SVGGElement>('[data-ticks]');
		const ticks = Array.from({ length: 12 }, () => mk(ticksG, 'path', { class: 'rwu-tick' }));
		const rollT = $<SVGGElement>('[data-roll-t]');
		const rollB = $<SVGGElement>('[data-roll-b]');
		const betaG = $<SVGGElement>('[data-beta]');
		const det = $<SVGRectElement>('[data-det]');
		const rateBar = $<SVGRectElement>('[data-rate]');
		const ctl = $<SVGPathElement>('[data-ctl]');
		const ctlA = $<SVGPathElement>('[data-ctl-a]');
		type Beta = { x: number; y: number; vx: number; stop: number; dead: number; el: SVGCircleElement };
		const betas: Beta[] = [];
		let bspawn = 0;
		const P4 = Math.exp(-0.15 * 4);
		let brate = 14 * P4;
		let hit = 0;

		// ---- tile 3: weld radiography ----
		const C3 = 9;
		const gsrc = $<SVGCircleElement>('[data-gsrc]');
		const graysG = $<SVGGElement>('[data-grays]');
		const grays = Array.from({ length: 9 }, () => mk(graysG, 'path', { class: 'rwu-gam' }));
		const expo = $<SVGRectElement>('[data-expo]');
		const expoW = $<SVGRectElement>('[data-expo-w]');
		const expoC = $<SVGPathElement>('[data-expo-c]');
		const crackL = $<SVGGElement>('[data-crack-l]');

		// ---- tile 4: sterilization ----
		const V4 = 14;
		const SP = 70;
		const packsG = $<SVGGElement>('[data-packs]');
		const sraysG = $<SVGGElement>('[data-srays]');
		const glow = $<SVGCircleElement>('[data-glow]');
		const packs = [0, 1, 2, 3].map((k) => {
			const g = mk(packsG, 'g', {}) as SVGGElement;
			mk(g, 'rect', { class: 'rwu-pack', x: 0, y: 0, width: 36, height: 24, rx: 3 });
			mk(g, 'path', { class: 'rwu-seal', d: 'M3 2 V22 M33 2 V22' });
			mk(g, 'rect', { class: 'rwu-syr', x: 7, y: 10, width: 16, height: 5, rx: 1 });
			mk(g, 'path', { class: 'rwu-seal', d: 'M4 12.5 H7 M4 10.5 V14.5 M23 12.5 H30' });
			const mics = MICROBES.map(([mx, my], i) => ({
				i,
				el: mk(g, 'ellipse', { class: 'rwu-mic', cx: mx, cy: my, rx: 2.2, ry: 1.2 }) as SVGEllipseElement,
				mx,
				my,
			}));
			return { g, mics, x0: k * SP };
		});
		const srays = Array.from({ length: 10 }, (_, k) => ({
			ang: (Math.PI * (0.12 + 0.76 * ((k * 7) % 10) / 9)),
			ph: k / 10,
			el: mk(sraysG, 'path', { class: 'rwu-gam' }),
		}));
		const wheelsG = $<SVGGElement>('[data-wheels]');
		const wheels = [24, 72, 120, 168, 216].map((x) => {
			const g = mk(wheelsG, 'g', { transform: `translate(${x} 130)` });
			mk(g, 'circle', { class: 'rwu-wheel', r: 5 });
			return mk(g, 'path', { class: 'rwu-seal', d: 'M-4 0 H4' });
		});
		const MAX = MICROBES.length;

		let t = 0;
		const step = (dt: number) => {
			t += dt;
			// tile 1
			const a1 = t % C1;
			const s = smokeLevel(a1);
			const sIn = smokeLevel(a1 - 0.7);
			for (const p of smoke) {
				const lvl = p.inside ? sIn : s;
				const yy = p.inside ? p.y + 2 * Math.sin(t * 0.7 + p.ph) : 150 - ((150 - p.y + t * 9) % 54);
				p.el.setAttribute('cx', (p.x + 3 * Math.sin(t * 0.5 + p.ph)).toFixed(1));
				p.el.setAttribute('cy', yy.toFixed(1));
				p.el.setAttribute('r', p.r.toFixed(1));
				p.el.style.opacity = (0.75 * lvl).toFixed(2);
			}
			smokeL.setAttribute('opacity', s.toFixed(2));
			spawn += dt * 8;
			while (spawn >= 1) {
				spawn -= 1;
				const th = -Math.PI * (0.15 + 0.7 * rnd());
				const L = Math.min(40, (SY - 28) / -Math.sin(th));
				const el = mk(tracksG, 'line', { class: 'rwu-trk', x1: SX, y1: SY }) as SVGLineElement;
				const x2 = SX + L * Math.cos(th);
				const y2 = SY + L * Math.sin(th);
				tracks.push({ x2, y2, age: 0, el });
				for (const f of [0.3, 0.6, 0.9]) {
					const x = SX + f * (x2 - SX);
					const y = SY + f * (y2 - SY);
					for (const pos of [true, false])
						ions.push({ x, y, pos, stuck: -1, el: mk(ionsG, 'circle', { class: pos ? 'rwu-ip' : 'rwu-ie', r: pos ? 1.5 : 1.1 }) as SVGCircleElement });
				}
			}
			for (let i = tracks.length - 1; i >= 0; i--) {
				const k = tracks[i];
				k.age += dt;
				const g = Math.min(1, k.age / 0.12);
				k.el.setAttribute('x2', (SX + g * (k.x2 - SX)).toFixed(1));
				k.el.setAttribute('y2', (SY + g * (k.y2 - SY)).toFixed(1));
				k.el.style.opacity = String(Math.max(0, 1 - Math.max(0, k.age - 0.15) / 0.35));
				if (k.age > 0.5) {
					k.el.remove();
					tracks.splice(i, 1);
				}
			}
			let arrived = 0;
			for (let i = ions.length - 1; i >= 0; i--) {
				const n = ions[i];
				if (n.stuck < 0) {
					n.y += (n.pos ? 18 : -28) * dt;
					if (rnd() < 1.6 * sIn * dt) n.stuck = 0;
					if ((n.pos && n.y >= 66) || (!n.pos && n.y <= 27)) {
						arrived++;
						n.el.remove();
						ions.splice(i, 1);
						continue;
					}
				} else {
					n.stuck += dt;
					n.x += 3 * dt;
					if (n.stuck > 0.8) {
						n.el.remove();
						ions.splice(i, 1);
						continue;
					}
				}
				n.el.setAttribute('cx', n.x.toFixed(1));
				n.el.setAttribute('cy', n.y.toFixed(1));
				n.el.style.opacity = n.stuck < 0 ? '1' : String(1 - n.stuck / 0.8);
			}
			rate += (arrived / Math.max(dt, 1e-3) - rate) * Math.min(1, dt / 0.6);
			const I = Math.min(1, Math.max(0.03, rate / 48));
			cur.setAttribute('y', (32 + 32 * (1 - I)).toFixed(1));
			cur.setAttribute('height', (32 * I).toFixed(1));
			const alarm = I < 0.55;
			const blink = alarm && t % 0.5 < 0.25;
			led.classList.toggle('is-on', blink);
			beep.setAttribute('opacity', blink ? '1' : '0');

			// tile 2
			const roll = (gap(t) - 4);
			rollT.setAttribute('transform', `translate(${XR} ${(Y2 - 4 - roll - 16).toFixed(1)}) rotate(${((-t * V2) / 16 * 57.3) % 360})`);
			rollB.setAttribute('transform', `rotate(${((t * V2) / 16 * 57.3) % 360})`);
			let top = `M0 ${Y2 - 9} L30 ${Y2 - 9} L${XR} ${(Y2 - gap(t)).toFixed(1)}`;
			for (let x = XR + 2; x <= 240; x += 2) top += ` L${x} ${(Y2 - gap(t - (x - XR) / V2)).toFixed(1)}`;
			sheet.setAttribute('d', `${top} L240 ${Y2} L0 ${Y2} Z`);
			ticks.forEach((e, k) => {
				const x = XR + ((k * 18 + t * V2) % 216);
				e.setAttribute('d', `M${x.toFixed(1)} ${Y2 - 1} V${Y2 - 2.2}`);
				e.style.opacity = x < 236 ? '1' : '0';
			});
			const a2 = t % C2;
			const on = a2 > 4.3 && a2 < 5.5;
			ctl.classList.toggle('is-on', on);
			ctlA.classList.toggle('is-on', on);
			ctlA.setAttribute('transform', `translate(0 ${(-roll).toFixed(1)})`);
			ctl.setAttribute('d', `M212 100 V14 H46 V${(44 - roll).toFixed(1)}`);
			bspawn += dt * 14;
			while (bspawn >= 1) {
				bspawn -= 1;
				betas.push({ x: 154 + 12 * rnd(), y: 47, vx: (rnd() - 0.5) * 6, stop: -1, dead: -1, el: mk(betaG, 'circle', { class: 'rwu-beta', r: 1.4 }) as SVGCircleElement });
			}
			let bh = 0;
			for (let i = betas.length - 1; i >= 0; i--) {
				const b = betas[i];
				if (b.dead >= 0) {
					b.dead += dt;
					b.x += V2 * dt;
					if (b.dead > 0.4) {
						b.el.remove();
						betas.splice(i, 1);
						continue;
					}
				} else {
					const h = gap(t - (b.x - XR) / V2);
					const y0 = b.y;
					b.y += 60 * dt;
					b.x += b.vx * dt;
					if (y0 < Y2 - h && b.y >= Y2 - h) b.stop = rnd() < Math.exp(-0.15 * h) ? 0 : Y2 - h * rnd();
					if (b.stop > 0 && b.y >= b.stop) {
						b.y = b.stop;
						b.dead = 0;
					}
					if (b.y >= 105) {
						bh++;
						b.el.remove();
						betas.splice(i, 1);
						continue;
					}
				}
				b.el.setAttribute('cx', b.x.toFixed(1));
				b.el.setAttribute('cy', b.y.toFixed(1));
				b.el.style.opacity = b.dead < 0 ? '1' : String(1 - b.dead / 0.4);
			}
			if (bh) hit = 0.12;
			hit -= dt;
			det.classList.toggle('is-hit', hit > 0);
			brate += (bh / Math.max(dt, 1e-3) - brate) * Math.min(1, dt / 0.8);
			rateBar.setAttribute('width', (26 * Math.min(1, brate / (14 * P4) / 1.25)).toFixed(1));

			// tile 3
			const a3 = t % C3;
			const out = sm(0.6, 1.2, a3) * (1 - sm(5.2, 5.8, a3));
			gsrc.setAttribute('cy', (18 + 18 * out).toFixed(1));
			const E = sm(1.2, 5.2, a3) * (1 - sm(8.4, 9, a3));
			expo.style.opacity = (0.75 * E).toFixed(2);
			expoW.style.opacity = (0.75 * E * 0.45).toFixed(2);
			expoC.style.opacity = (0.95 * E).toFixed(2);
			crackL.setAttribute('opacity', (sm(5.8, 6.3, a3) * (1 - sm(8.4, 9, a3))).toFixed(2));
			grays.forEach((e, k) => {
				const tx = 64 + (k * 112) / 8;
				const dx = tx - 120;
				const dy = 100 - 36;
				const L = Math.hypot(dx, dy);
				const f = (t * 0.9 + (k * 5) % 9 / 9) % 1;
				const x = 120 + dx * f * (1 - 10 / L);
				const y = 36 + dy * f * (1 - 10 / L);
				e.setAttribute('d', wave(x, y, dx / L, dy / L));
				e.style.opacity = (a3 > 1.1 && a3 < 5.4 ? Math.sin(Math.PI * f) : 0).toFixed(2);
			});

			// tile 4
			glow.style.opacity = (0.7 + 0.3 * Math.sin(t * 2)).toFixed(2);
			for (const p of packs) {
				const x = ((p.x0 + V4 * t) % (4 * SP)) - 40;
				p.g.setAttribute('transform', `translate(${x.toFixed(1)} 96)`);
				for (const m of p.mics) {
					// a microbe dies while its package passes under the source (x of the microbe from 96 to 140)
					const kill = 96 + (m.i * 44) / MAX;
					const xm = x + m.mx;
					const d = sm(kill, kill + 10, xm);
					m.el.classList.toggle('is-dead', d > 0.3);
					m.el.style.opacity = (1 - sm(kill + 8, kill + 18, xm)).toFixed(2);
					const wig = d > 0.3 ? 0 : 0.8 * Math.sin(t * 5 + m.mx);
					m.el.setAttribute('cx', (m.mx + wig).toFixed(1));
				}
			}
			for (const r of srays) {
				const f = (t * 0.6 + r.ph) % 1;
				const ux = Math.cos(r.ang);
				const uy = Math.sin(r.ang);
				const d0 = 8 + f * 80;
				r.el.setAttribute('d', wave(120 + ux * d0, 40 + uy * d0, ux, uy, 9));
				r.el.style.opacity = Math.sin(Math.PI * f).toFixed(2);
			}
			wheels.forEach((w) => w.setAttribute('transform', `rotate(${((t * V4) / 5) * 57.3 % 360})`));
			return true;
		};
		step(0);
		loop(root, (dt) => step(dt));
	}
</script>
