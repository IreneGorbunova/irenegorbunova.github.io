---
/**
 * The scheme of Rutherford's experiment (Geiger and Marsden, Manchester, 1909–1913), a top view as on a school scheme.
 * A radioactive source in a lead block sends a narrow beam of α particles (red, the chapter's α color) at a thin gold
 * foil (about 0,4 мкм, a couple of thousand atoms thick). Around the foil stands a round screen coated with zinc
 * sulfide: where an α particle hits it, a tiny flash appears, and the observer counted the flashes through a
 * microscope that could be turned round the foil (dashed arc with arrows, −60°…+20°, so that the label «микроскоп»
 * sits clear of the ring, the tube and the arc between 20° and 50°). The whole set stands in a chamber from
 * which the air is pumped out (α particles fly only a few centimeters in air).
 *
 * The picture does NOT show the result of the experiment (the model RutherfordLab after it does): the particles fly
 * straight through the foil to the screen, where each makes a short green flash (the real flashes of zinc sulfide
 * are greenish), and the microscope looks at that spot. One particle every 0,6 с, the motion slowed enormously (real
 * α particles fly at about 15 000 км/с); the caption says so. Not to scale: the real screen was a few centimeters
 * from the foil.
 */
import RaStyles from './RaStyles.astro';

const W = 420;
const H = 300;
const C = { x: 232, y: 150 }; // the foil
const R = 96; // radius of the screen
const GAP = 16; // half of the opening of the screen round 180°, degrees
const pt = (r: number, a: number) => ({ x: C.x + r * Math.cos((a * Math.PI) / 180), y: C.y - r * Math.sin((a * Math.PI) / 180) });
const P = (p: { x: number; y: number }) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
// the ring from 180+GAP round through 0 to 180−GAP (the long way, clockwise on the screen)
const ring = (r: number) => `M${P(pt(r, 180 + GAP))} A${r} ${r} 0 1 0 ${P(pt(r, 180 - GAP))}`;
// the microscope looks at the spot where the straight beam hits the screen (0°): it stands outside the ring
const MIC = { x: C.x + R + 4, y: C.y };
// the dashed arc of its possible positions with arrows at both ends
const RA = R + 40;
const arcD = `M${P(pt(RA, -60))} A${RA} ${RA} 0 0 0 ${P(pt(RA, 20))}`;
const head = (a: number, s: number) => {
	const p = pt(RA, a);
	const t = { x: -Math.sin((a * Math.PI) / 180) * s, y: -Math.cos((a * Math.PI) / 180) * s }; // tangent toward growing angle on screen
	const n = { x: Math.cos((a * Math.PI) / 180), y: -Math.sin((a * Math.PI) / 180) };
	return `M${P({ x: p.x + t.x * 7, y: p.y + t.y * 7 })} L${P({ x: p.x + n.x * 4, y: p.y + n.y * 4 })} L${P({ x: p.x - n.x * 4, y: p.y - n.y * 4 })} Z`;
};
---

<RaStyles />
<figure class="ra rsp not-content" data-rsp>
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Схема опыта Резерфорда, вид сверху. Из свинцового блока с источником узкий пучок альфа-частиц летит на тонкую золотую фольгу. Вокруг фольги стоит круглый экран: там, куда попадает частица, вспыхивает маленькая точка. Её видно в микроскоп, который можно поворачивать вокруг фольги. Всё это находится в камере, из которой откачан воздух" style="max-width: 38rem">
		<rect class="rsp-cham" x="8" y="22" width={W - 16} height={H - 44} rx="10"></rect>
		<text class="ra-lbl-s" x="18" y="40">вакуум: из камеры откачан воздух</text>
		<!-- the screen -->
		<path class="rsp-screen" d={ring(R)}></path>
		<path class="rsp-zns" d={ring(R - 2.6)}></path>
		<text class="ra-lbl" x={C.x - 10} y={C.y + R + 22} text-anchor="middle">экран</text>
		<!-- the microscope and its arc -->
		<path class="rsp-arc" d={arcD}></path>
		<path class="rsp-arch" d={head(20, 1)}></path>
		<path class="rsp-arch" d={head(-60, -1)}></path>
		<g transform={`translate(${MIC.x} ${MIC.y})`}>
			<rect class="rsp-mic" x="0" y="-5" width="34" height="10" rx="2"></rect>
			<rect class="rsp-mic2" x="34" y="-7.5" width="12" height="15" rx="2"></rect>
			<rect class="rsp-mic" x="-3" y="-3.5" width="4" height="7" rx="1"></rect>
		</g>
		<text class="ra-lbl" x="363" y="82" text-anchor="middle" data-miclbl>микроскоп</text>
		<!-- the lead block and the source -->
		<rect class="rsp-lead" x="26" y={C.y - 26} width="56" height="52" rx="3"></rect>
		<rect class="rsp-chan" x="52" y={C.y - 2.5} width="30" height="5"></rect>
		<circle class="rsp-src" cx="50" cy={C.y} r="5"></circle>
		<text class="ra-lbl" x="54" y={C.y - 46} text-anchor="middle">свинцовый</text>
		<text class="ra-lbl" x="54" y={C.y - 32} text-anchor="middle">блок</text>
		<text class="ra-lbl" x="54" y={C.y + 44} text-anchor="middle">источник</text>
		<text class="ra-lbl" x="54" y={C.y + 58} text-anchor="middle"><tspan class="ra-sym rsp-al">α</tspan>-частиц</text>
		<path class="rsp-beam" d={`M82 ${C.y} H${C.x + R - 3}`}></path>
		<!-- the foil -->
		<rect class="rsp-foil" x={C.x - 1.2} y={C.y - 28} width="2.4" height="56"></rect>
		<text class="ra-lbl" x={C.x} y={C.y - 36} text-anchor="middle">золотая фольга</text>
		<!-- the flash and the particles -->
		<circle class="rsp-flash" cx={C.x + R - 3} cy={C.y} r="7" data-flash></circle>
		<text class="ra-lbl-s rsp-fl" x={C.x + R - 40} y={C.y + 22} text-anchor="middle" data-fl>вспышка</text>
		<g data-parts></g>
	</svg>
	<figcaption class="ra-cap">Вид сверху, не в масштабе. Движение частиц сильно замедлено.</figcaption>
</figure>

<script>
	import { el, loop } from '@components/ch/g7/kit';

	const C = { x: 232, y: 150 };
	const R = 96;
	const X0 = 52;
	const XEND = C.x + R - 3;
	const V = 150; // px per second
	const DT = 0.6; // s between particles
	const N = 4;
	const T_FLY = (XEND - X0) / V;
	const CYCLE = N * DT >= T_FLY ? N * DT : Math.ceil(T_FLY / DT) * DT;

	document.querySelectorAll<HTMLElement>('[data-rsp]').forEach((root) => {
		const svg = root.querySelector('svg')!;
		const g = svg.querySelector<SVGGElement>('[data-parts]')!;
		const flash = svg.querySelector<SVGCircleElement>('[data-flash]')!;
		const fl = svg.querySelector<SVGTextElement>('[data-fl]')!;
		const n = Math.round(CYCLE / DT);
		const dots = Array.from({ length: n }, () => el('circle', { class: 'rsp-a', r: 2.6, cy: C.y }));
		dots.forEach((d) => g.append(d));
		let t = 0;
		const draw = () => {
			let since = 99;
			dots.forEach((d, i) => {
				let s = (t - i * DT) % CYCLE;
				if (s < 0) s += CYCLE;
				const x = X0 + s * V;
				if (x < XEND) {
					d.setAttribute('cx', x.toFixed(1));
					d.style.opacity = x < 82 ? '0' : '1';
				} else {
					d.style.opacity = '0';
					since = Math.min(since, (x - XEND) / V);
				}
			});
			const k = Math.max(0, 1 - since / 0.35);
			flash.style.opacity = k.toFixed(2);
			fl.style.opacity = (0.35 + 0.65 * k).toFixed(2);
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	});
</script>

<style is:global>
	.rsp-cham {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 40%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 5 4;
	}
	.rsp-screen {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 5;
	}
	.rsp-zns {
		fill: none;
		stroke: color-mix(in srgb, hsl(120, 70%, 60%) 30%, var(--sl-color-gray-3));
		stroke-width: 1.6;
	}
	.rsp-arc {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.rsp-arch {
		fill: var(--sl-color-gray-3);
	}
	.rsp-mic {
		fill: var(--sl-color-gray-3);
	}
	.rsp-mic2 {
		fill: var(--sl-color-gray-4);
	}
	.rsp-lead {
		fill: var(--ra-lead);
		stroke: color-mix(in srgb, var(--ra-lead) 60%, black);
	}
	.rsp-chan {
		fill: var(--ig-surface);
	}
	.rsp-src {
		fill: color-mix(in srgb, var(--ra-a) 70%, white);
	}
	.rsp-al {
		fill: var(--ra-a);
	}
	.rsp-beam {
		stroke: var(--ra-a);
		stroke-width: 1;
		stroke-dasharray: 2 3;
		opacity: 0.5;
	}
	.rsp-foil {
		fill: var(--ra-gold);
	}
	.rsp-a {
		fill: var(--ra-a);
	}
	.rsp-flash {
		fill: hsl(120, 90%, 70%);
		opacity: 0;
		filter: blur(1.5px);
	}
	.rsp-fl {
		fill: hsl(120, 60%, 55%);
	}
	:root[data-theme='light'] .rsp-fl {
		fill: hsl(120, 60%, 30%);
	}
</style>
