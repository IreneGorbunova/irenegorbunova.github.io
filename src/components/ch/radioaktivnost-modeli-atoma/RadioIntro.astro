---
/**
 * Two short looping opening scenes of «Радиоактивность. Модели атома». No terms of the chapter in the pictures or the
 * visible captions; the captions' popovers explain. People: the people kit, in profile; at these sizes the hands are
 * drawn as mittens (hand length about 15 px), so the poses are chosen to read from the arm: a press from above, a grip
 * on a hanging towel, a straight reach.
 *
 * Smoke («Дым на кухне»): a kitchen in the morning, 0,85 px per см (the room is 2,5 м high, the counter 90 см, the
 *   girl 165 см, a teen). She presses the lever of the toaster (0,8-s reach, eased) and lowers her arm. From 3 s the
 *   toast burns: gray smoke rises from the slots at about 0,35 м/с (warm smoke) and reaches the round detector on the
 *   ceiling in about 4 s; it spreads under the ceiling. At 7 s the detector beeps (red light blinking, sound arcs) and
 *   the toast pops up, dark. She looks up, takes the towel from the bar on the cabinet (grip), raises it and waves it
 *   under the detector for 2,3 s (1,5 swings per second); the smoke thins out and the detector stops; she hangs the
 *   towel back (the hand opens before it lets go) and lowers her arm. Real time (13,6 s). The press on the lever is a
 *   flat hand, palm down, turned a little toward the viewer so the palm and thumb show. The towel in the hand is a chain
 *   of four segments of 6,5 px hanging under gravity (9,8 м/с² = 833 px/с² at this scale, damped), so it lags and flexes
 *   when she waves it and hangs straight, as on the bar, when she holds it still.
 * Night («Часы в темноте»): a bedroom at night seen from the door, 0,9 px per см (the room is 2,4 м high, the bed
 *   2,1 м long). A teen (165 см) lies in bed under a blanket (the body under the blanket is clipped away, the near arm
 *   lies on top); a reading lamp on the bedside table lights the room and the glow-in-the-dark stars on the ceiling.
 *   The teen reaches to the lamp's button (0,8 s), presses it with a flat palm (the lamp goes off at the press) and
 *   lowers the arm. From then the wall clock runs fast: 23:00 → 06:00 in 8,7 s (1 hour in 1,24 s); the watch in the inset
 *   shows the same time. The stars glow brightly and fade:
 *   brightness 0,85·e^(−h/0,35) + 0,15·e^(−h/2,5) after h hours (a typical phosphorescent sticker: bright for a few
 *   minutes, faint within an hour, barely visible after four). The watch on the table (shown enlarged in a round inset)
 *   keeps the same green glow of its hands and hour marks all night: tritium tubes glow for more than ten years.
 *   Dawn lightens the window from 05:00 to 06:00.
 * Plays only while visible (scene() from intro/scene.ts).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// the stars on the bedroom ceiling
const STARS = [
	{ x: 120, y: 26, r: 5 },
	{ x: 158, y: 20, r: 4 },
	{ x: 196, y: 30, r: 5.5 },
	{ x: 236, y: 22, r: 4.2 },
	{ x: 272, y: 32, r: 4.8 },
	{ x: 176, y: 40, r: 3.4 },
];
const star = (x: number, y: number, r: number) => {
	let d = '';
	for (let i = 0; i < 10; i++) {
		const a = -Math.PI / 2 + (i * Math.PI) / 5;
		const rr = i % 2 ? r * 0.45 : r;
		d += `${i ? 'L' : 'M'}${(x + rr * Math.cos(a)).toFixed(1)} ${(y + rr * Math.sin(a)).toFixed(1)}`;
	}
	return d + 'Z';
};
// the watch face of the inset: 12 hour marks
const IC = { x: 30, y: 116 };
const MARKS = Array.from({ length: 12 }, (_, i) => {
	const a = (i * Math.PI) / 6;
	const r0 = i % 3 ? 12.5 : 10.5;
	return `M${(IC.x + r0 * Math.sin(a)).toFixed(1)} ${(IC.y - r0 * Math.cos(a)).toFixed(1)}L${(IC.x + 15 * Math.sin(a)).toFixed(1)} ${(IC.y - 15 * Math.cos(a)).toFixed(1)}`;
});
const WALL_TICKS = Array.from({ length: 12 }, (_, i) => {
	const a = (i * Math.PI) / 6;
	return `M${(52 + 10 * Math.sin(a)).toFixed(1)} ${(66 - 10 * Math.cos(a)).toFixed(1)}L${(52 + 12 * Math.sin(a)).toFixed(1)} ${(66 - 12 * Math.cos(a)).toFixed(1)}`;
});
---

<PeopleStyles />
