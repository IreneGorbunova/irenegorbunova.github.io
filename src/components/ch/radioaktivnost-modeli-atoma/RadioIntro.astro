			<!-- the teen; the blanket is drawn first and the body under it is clipped away -->
			<path class="ran-blanket" d="M140 178 q-4 -22 10 -24 q62 -4 120 4 q12 3 12 16 v12 h-142 Z"></path>
			<path class="ran-blanket-l" d="M154 162 q50 -4 112 2 M144 183 h138"></path>
			<clipPath id="ran-clip" data-armclip><rect x="0" y="0" width="143" height="240"></rect></clipPath>
			<g clip-path="url(#ran-clip)"><g data-teen></g></g>
			<!-- the bedside table, the lamp, the watch -->
