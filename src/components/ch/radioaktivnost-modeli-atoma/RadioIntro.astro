			<path class="ran-stem" d="M71 173 V136"></path>
			<path class="ran-shade" d="M59 136 L64 120 H78 L83 136 Z" data-shade></path>
			<rect class="ran-watch-strap" x="40" y="176" width="14" height="2" rx="1"></rect>
