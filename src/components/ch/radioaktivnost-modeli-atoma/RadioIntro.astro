		</svg>
		<div class="intro__foot">
			<p>Звёздочки на потолке к утру гаснут, а стрелки этих часов светятся{' '}<More term="всю ночь — и так много лет">Звёздочки светятся, пока не отдадут свет, накопленный днём. А в стрелки часов впаяны крошечные стеклянные трубочки с тритием — разновидностью водорода, атомы которого сами испускают электроны. Электроны ударяют в светящийся слой, и он горит без всякой подзарядки больше десяти лет. Стекло трубочек задерживает все электроны. Свечение без внешней подзарядки когда-то и привело к <a href="#открытие-радиоактивности">открытию радиоактивности</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<script>
	import { scene } from '@components/intro/scene';
	import { DEG, SKELETON, add, polar, type Pt } from '@components/people/core';
	import { figure, ANKLE_CM, type FigurePose, type HandTarget } from '@components/people/body';
	import { ease, reach } from '@components/people/motion';

	const f = (v: number) => v.toFixed(1);
	const c01 = (x: number) => Math.min(1, Math.max(0, x));
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const NS = 'http://www.w3.org/2000/svg';
	const mkEl = (tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		return e;
	};

	document.querySelectorAll<HTMLElement>('[data-raintro]').forEach((root) => {
		// ---------------- scene 1: smoke in the kitchen
		{
			const card = root.querySelector<HTMLElement>('[data-scene="smoke"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 13.6;
			const S = 0.85;
			const H = 165;
			const FLOOR = 228;
			const sk = SKELETON.teen;
			const u = S * H;
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H, age: 'teen', shirt: 'hm-green', hair: 'pony', name: 'smoke-girl' });
			girl.backLayer(0, $<SVGGElement>('[data-towel-back]'));
			const ankleY = FLOOR - ANKLE_CM.trainer * S;
			const hip: Pt = { x: 163, y: ankleY - 0.995 * (sk.thigh + sk.shin) * u };
			const ankles: [Pt, Pt] = [{ x: hip.x + 6, y: ankleY }, { x: hip.x - 6, y: ankleY }];
			const sh = girl.shoulders(hip, 0.03);
			const hangN = add(sh[0], polar(0.36 * u, Math.PI / 2 - 4 * DEG));
			const hangF = add(sh[1], polar(0.36 * u, Math.PI / 2 + 4 * DEG));
			const lever = $<SVGRectElement>('[data-lever]');
			const bread = $<SVGRectElement>('[data-bread]');
			const tglow = $<SVGRectElement>('[data-tglow]');
			const led = $<SVGCircleElement>('[data-led]');
			const sound = $<SVGGElement>('[data-sound]');
			const smokeG = $<SVGGElement>('[data-smoke]');
			const towelBar = $<SVGPathElement>('[data-towel-bar]');
			const towelBarS = $<SVGPathElement>('[data-towel-bar-s]');
			const towelHeld = $<SVGGElement>('[data-towel-held]');
			const towelPath = $<SVGPathElement>('[data-towel-path]');
			const BAR: Pt = { x: 192, y: 161 }; // where the hand grips the towel on the bar
			const WAVE_A: Pt = { x: 176, y: 76 };
			const WAVE_B: Pt = { x: 194, y: 80 };
			// the smoke puffs (deterministic)
			let sd = 5;
			const rnd = () => {
				sd = (sd * 16807) % 2147483647;
				return sd / 2147483647;
			};
			const puffs = Array.from({ length: 44 }, (_, i) => ({ tb: 3.1 + i * 0.1, x0: 203 + (rnd() - 0.5) * 10, v: 26 + 8 * rnd(), top: 20 + rnd() * 12, side: rnd() < 0.5 ? -1 : 1, sp: 6 + 10 * rnd(), node: mkEl('circle', { class: 'rai-puff' }) as SVGCircleElement }));
			puffs.forEach((p) => smokeG.append(p.node));

			// key poses of the girl
			const base = (hands: [HandTarget, HandTarget], head = 0.1, lean = 0.03): FigurePose => ({ hip, lean, head, ankles, feet: [0, 0], hands, planted: [true, true] });
			const FAR: HandTarget = { at: hangF, pose: 'relaxed' };
			const HANG: HandTarget = { at: hangN, pose: 'relaxed' };
			// a flat hand, palm down on the lever knob, turned a little so its palm and thumb show (roll 0 would be edge-on)
			const PRESS_ROLL = -1.15;
			const press = (k: number): HandTarget => ({ at: { x: 187.5, y: lerp(134.6, 141.6, k) }, pose: 'flat', dir: 20 * DEG, roll: PRESS_ROLL, contact: 'toaster-lever' });
			const gripBar: HandTarget = { at: BAR, pose: 'grip', d: 2, dir: 95 * DEG, roll: -Math.PI / 2 + 0.2, contact: 'towel' };
			const openBar: HandTarget = { at: { x: BAR.x - 1, y: BAR.y - 1 }, pose: 'open', dir: 95 * DEG, roll: -Math.PI / 2 + 0.2 };
			const wave = (s: number): HandTarget => ({ at: { x: lerp(WAVE_A.x, WAVE_B.x, s), y: lerp(WAVE_A.y, WAVE_B.y, s) }, pose: 'grip', d: 2, dir: lerp(-110, -70, s) * DEG, roll: -Math.PI / 2 + 0.2, contact: 'towel' });
			const P_HANG = base([HANG, FAR]);
			const P_PRESS0 = base([press(0), FAR], 0.35, 0.06);
			const P_PRESS1 = base([press(1), FAR], 0.4, 0.07);
			const P_LOOK = base([HANG, FAR], -0.45);
			const P_GRIP = base([gripBar, FAR], 0.3, 0.09);
			const P_OPEN = base([openBar, FAR], 0.3, 0.09);
			const P_WAVE = (s: number) => base([wave(s), FAR], -0.5, 0.01);

			// the towel in the hand: a chain of 4 segments under gravity (Verlet, damped), the top node in the hand
			const SEG = 6.5;
			const GRAV = 833; // px/s², 9,8 м/с² at 0,85 px per см
			let chain: Pt[] = [];
			let prev: Pt[] = [];
			let lastT = -1;
			const hangFrom = (g: Pt) => {
				chain = Array.from({ length: 5 }, (_, i) => ({ x: g.x, y: g.y + i * SEG }));
				prev = chain.map((q) => ({ ...q }));
			};
			const stepChain = (g: Pt, dt: number) => {
				const n = Math.max(1, Math.ceil(dt / 0.008));
				const h = dt / n;
				const g0 = chain[0];
				for (let s = 1; s <= n; s++) {
					chain[0] = { x: g0.x + ((g.x - g0.x) * s) / n, y: g0.y + ((g.y - g0.y) * s) / n };
					for (let i = 1; i < chain.length; i++) {
						const c = chain[i];
						const vx = (c.x - prev[i].x) * 0.985;
						const vy = (c.y - prev[i].y) * 0.985;
						prev[i] = { ...c };
						chain[i] = { x: c.x + vx, y: c.y + vy + GRAV * h * h };
					}
					for (let it = 0; it < 6; it++)
						for (let i = 1; i < chain.length; i++) {
							const a = chain[i - 1];
							const b = chain[i];
							const L = Math.hypot(b.x - a.x, b.y - a.y) || 1e-6;
							const k = (L - SEG) / L;
							if (i === 1) chain[i] = { x: b.x - (b.x - a.x) * k, y: b.y - (b.y - a.y) * k };
							else {
								chain[i - 1] = { x: a.x + (b.x - a.x) * k * 0.5, y: a.y + (b.y - a.y) * k * 0.5 };
								chain[i] = { x: b.x - (b.x - a.x) * k * 0.5, y: b.y - (b.y - a.y) * k * 0.5 };
							}
						}
				}
			};
			const chainShape = () => {
				// a strip 12 px wide along the chain; the top edge stays across the grip
				const L: Pt[] = [];
				const R: Pt[] = [];
				chain.forEach((q, i) => {
					const a = chain[Math.max(0, i - 1)];
					const b = chain[Math.min(chain.length - 1, i + 1)];
					const len = Math.hypot(b.x - a.x, b.y - a.y) || 1;
					const nx = (b.y - a.y) / len;
					const ny = -(b.x - a.x) / len;
					const w = 6 + 0.15 * i;
					L.push({ x: q.x - nx * w, y: q.y - ny * w });
					R.push({ x: q.x + nx * w, y: q.y + ny * w });
				});
				const pts = [...L, ...R.reverse()];
				return 'M' + pts.map((q) => `${f(q.x)} ${f(q.y)}`).join('L') + 'Z';
			};

			scene(card, RUN, (x) => {
				const t = RUN * x;
				// ---- the girl
				let p: FigurePose;
				let held = false;
				if (t < 0.5) p = P_HANG;
				else if (t < 1.3) p = reach(P_HANG, P_PRESS0, (t - 0.5) / 0.8);
				else if (t < 1.6) p = reach(P_PRESS0, P_PRESS1, (t - 1.3) / 0.3);
				else if (t < 2.4) p = reach(P_PRESS1, P_HANG, (t - 1.6) / 0.8);
				else if (t < 7.0) p = P_HANG;
				else if (t < 7.6) p = reach(P_HANG, P_LOOK, (t - 7.0) / 0.6);
				else if (t < 8.4) p = reach(P_LOOK, P_GRIP, (t - 7.6) / 0.8);
				else if (t < 8.6) {
					p = P_GRIP;
					held = true;
				} else if (t < 9.3) {
					p = reach(P_GRIP, P_WAVE(0), (t - 8.6) / 0.7);
					held = true;
				} else if (t < 11.6) {
					const ph = (t - 9.3) * 1.5 * 2 * Math.PI;
					const s = 0.5 - 0.5 * Math.cos(ph);
					p = P_WAVE(s);
					held = true;
				} else if (t < 12.4) {
					p = reach(P_WAVE(0), P_GRIP, (t - 11.6) / 0.8);
					held = true;
				} else if (t < 12.7) p = reach(P_GRIP, P_OPEN, (t - 12.4) / 0.3);
				else p = reach(P_OPEN, P_HANG, (t - 12.7) / 0.8);
				const st = girl.pose(p);
				// ---- the towel: on the bar, or hanging from the grip
				towelBar.style.opacity = held ? '0' : '1';
				towelBarS.style.opacity = held ? '0' : '1';
				towelHeld.style.opacity = held ? '1' : '0';
				if (held) {
					const g = { x: st.grips[0].x, y: st.grips[0].y };
					// the chain starts hanging straight at the grip on the bar; time going back (a new loop) resets it
					if (lastT < 0 || t < lastT || t - lastT > 0.5 || chain.length === 0) hangFrom(g);
					else stepChain(g, t - lastT);
					lastT = t;
					towelPath.setAttribute('d', chainShape());
				} else lastT = -1;
				// ---- the toaster
				const down = t >= 1.45 && t < 7.0;
				const lk = t < 1.3 ? 0 : t < 1.6 ? ease((t - 1.3) / 0.3) : down ? 1 : 0;
				lever.setAttribute('y', f(135 + 7 * lk));
				const by = t < 1.3 ? 127 : t < 1.6 ? lerp(127, 135, ease((t - 1.3) / 0.3)) : down ? 135 : t < 7.15 ? lerp(135, 125, ease((t - 7.0) / 0.15)) : 127;
				bread.setAttribute('y', f(by));
				const burn = c01((t - 2.6) / 4.2);
				bread.style.setProperty('--burn', f(burn * 100) + '%');
				bread.classList.toggle('is-burnt', t >= 2.6);
				tglow.style.opacity = down ? f(0.5 + 0.5 * c01((t - 1.6) / 1)) : '0';
				// ---- the smoke
				for (const q of puffs) {
					const age = t - q.tb;
					if (age <= 0) {
						q.node.style.opacity = '0';
						continue;
					}
					const yRise = 132 - q.v * age;
					const tTop = (132 - q.top) / q.v;
					const y = Math.max(q.top, yRise);
					const xs = age > tTop ? q.side * Math.min(80, q.sp * (age - tTop)) : 3 * Math.sin(age * 2 + q.x0);
					// waving pushes the smoke away: from 9,3 s every puff thins out within about a second
					const clear = t > 9.3 ? Math.exp(-(t - 9.3) / 0.8) : 1;
					const pushed = t > 9.3 ? q.side * 30 * (1 - Math.exp(-(t - 9.3) / 1.2)) : 0;
					q.node.setAttribute('cx', f(q.x0 + xs + pushed));
					q.node.setAttribute('cy', f(y));
					q.node.setAttribute('r', f(Math.min(11, 3 + 2 * age)));
					q.node.style.opacity = f(0.3 * c01(age / 0.6) * clear);
				}
				// ---- the detector
				const alarm = t >= 7.0 && t < 11.6;
				const blink = alarm && Math.floor(t * 4) % 2 === 0;
				led.classList.toggle('is-on', blink);
				sound.style.opacity = alarm ? (Math.floor(t * 4) % 2 === 0 ? '1' : '0.35') : '0';
			});
		}

		// ---------------- scene 2: the night
		{
			const card = root.querySelector<HTMLElement>('[data-scene="night"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 12;
			const S = 0.9;
			const H = 165;
			const sk = SKELETON.teen;
			const u = S * H;
			const teenG = $<SVGGElement>('[data-teen]');
			// the teen is built standing in a local frame and turned −90° about O: head to the left, face up
			const O: Pt = { x: 175, y: 166 }; // the hip joint on the picture
			teenG.setAttribute('transform', `translate(${O.x} ${O.y}) rotate(-90)`);
			const toLocal = (p: Pt): Pt => ({ x: -(p.y - O.y), y: p.x - O.x });
			const teen = figure(teenG, { s: S, H, age: 'teen', shirt: 'hm-blue', hair: 'short', name: 'night-teen' });
			const hipL: Pt = { x: 0, y: 0 };
			const legL = 0.995 * (sk.thigh + sk.shin) * u;
			const ankles: [Pt, Pt] = [{ x: 0, y: legL }, { x: -1, y: legL }];
			const shL = teen.shoulders(hipL, 0);
			// the far arm lies along the body under the blanket, the near one on the blanket
			const farRest: HandTarget = { at: add(shL[1], polar(0.34 * u, Math.PI / 2)), pose: 'relaxed' };
			const blanketHand = toLocal({ x: 176, y: 161 });
			const rest: HandTarget = { at: blanketHand, pose: 'relaxed' };
			const btnL = (k: number) => toLocal({ x: 79, y: lerp(170.8, 171.6, k) }); // the top of the button, pressed 0,8 px
			// a flat palm on the button: fingers to the left on the picture (screen 180° is local 270°), palm down (roll π)
			const press = (k: number): HandTarget => ({ at: btnL(k), pose: 'flat', dir: 270 * DEG, roll: Math.PI, contact: 'lamp-button' });
			const base = (hands: [HandTarget, HandTarget], head = 0): FigurePose => ({ hip: hipL, lean: 0, head, ankles, feet: [0, 0], hands, planted: [false, false] });
			const P_REST = base([rest, farRest]);
			const P_P0 = base([press(0), farRest], 0.15);
			const P_P1 = base([press(1), farRest], 0.15);
			// the hand goes over the chest, not through the shoulder
			const P_MID = base([{ at: toLocal({ x: 116, y: 142 }), pose: 'relaxed' }, farRest], 0.1);
			const armClip = $<SVGClipPathElement>('[data-armclip]');
			const capsule = mkEl('path', {});
			armClip.append(capsule);
			const toScreen = (p: Pt): Pt => ({ x: O.x + p.y, y: O.y - p.x });
			const lampLight = $<SVGPathElement>('[data-lamplight]');
			const halo = $<SVGCircleElement>('[data-halo]');
			const shade = $<SVGPathElement>('[data-shade]');
			const wall = $<SVGRectElement>('[data-nwall]');
			const btnR = $<SVGRectElement>('[data-btn]');
			const stars = [...card.querySelectorAll<SVGPathElement>('[data-star]')];
			const hh = $<SVGPathElement>('[data-hh]');
			const mh = $<SVGPathElement>('[data-mh]');
			const dawn = $<SVGRectElement>('[data-dawn]');
			const IC = { x: 30, y: 116 }; // the watch inset (as in the markup)
			const wh = $<SVGPathElement>('[data-wh]');
			const wm = $<SVGPathElement>('[data-wm]');
			const moon = $<SVGCircleElement>('[data-moon]');
			const T_OFF = 1.55; // the moment the button is pressed down
			const T0 = 2.3;
			const T1 = 11.0;
			scene(card, RUN, (x) => {
				const t = RUN * x;
				let p: FigurePose;
				if (t < 0.6) p = P_REST;
				else if (t < 1.0) p = reach(P_REST, P_MID, (t - 0.6) / 0.4);
				else if (t < 1.4) p = reach(P_MID, P_P0, (t - 1.0) / 0.4);
				else if (t < 1.55) p = reach(P_P0, P_P1, (t - 1.4) / 0.15);
				else if (t < 1.7) p = P_P1;
				else if (t < 2.0) p = reach(P_P1, P_MID, (t - 1.7) / 0.3);
				else if (t < 2.5) p = reach(P_MID, P_REST, (t - 2.0) / 0.5);
				else p = P_REST;
				const st = teen.pose(p);
				// the arm stays visible above the blanket: a band round shoulder → elbow → wrist → hand
				const pts = [st.shoulders[0], st.elbows[0], st.wrists[0], st.grips[0]].map((q) => toScreen(q));
				const end = pts[3];
				const w = pts[2];
				const tip = { x: end.x + (end.x - w.x) * 0.9, y: end.y + (end.y - w.y) * 0.9 };
				const all = [...pts.slice(0, 3), tip];
				let d = '';
				for (let i = 0; i < 3; i++) {
					const a = all[i];
					const b = all[i + 1];
					const L = Math.hypot(b.x - a.x, b.y - a.y) || 1;
					const nx = (-(b.y - a.y) / L) * 7;
					const ny = ((b.x - a.x) / L) * 7;
					d += `M${f(a.x + nx)} ${f(a.y + ny)}L${f(b.x + nx)} ${f(b.y + ny)}L${f(b.x - nx)} ${f(b.y - ny)}L${f(a.x - nx)} ${f(a.y - ny)}Z`;
					d += `M${f(b.x - 7)} ${f(b.y)}a7 7 0 1 0 14 0a7 7 0 1 0 -14 0Z`;
				}
				capsule.setAttribute('d', d);
				// the lamp
				const lampOn = t < T_OFF;
				const pk = t < 1.4 ? 0 : t < 1.55 ? (t - 1.4) / 0.15 : t < 1.7 ? 1 : 0;
				btnR.setAttribute('y', f(170.8 + 0.8 * pk));
				btnR.setAttribute('height', f(2.2 - 0.8 * pk));
				lampLight.style.opacity = lampOn ? '1' : '0';
				halo.style.opacity = lampOn ? '1' : '0';
				shade.classList.toggle('is-on', lampOn);
				wall.classList.toggle('is-lit', lampOn);
				// the clock: 23:00 → 06:00 between T0 and T1
				const hours = t < T0 ? 0 : t < T1 ? (7 * (t - T0)) / (T1 - T0) : 7;
				const clock = 23 + hours;
				hh.setAttribute('transform', `rotate(${f(((clock % 12) / 12) * 360)} 52 66)`);
				mh.setAttribute('transform', `rotate(${f((clock % 1) * 360)} 52 66)`);
				wh.setAttribute('transform', `rotate(${f(((clock % 12) / 12) * 360)} ${IC.x} ${IC.y})`);
				wm.setAttribute('transform', `rotate(${f((clock % 1) * 360)} ${IC.x} ${IC.y})`);
				// the stars: lit by the lamp, then glowing and fading
				const hOff = t < T_OFF ? -1 : t < T0 ? ((t - T_OFF) / (T0 - T_OFF)) * 0.05 : 0.05 + hours;
				stars.forEach((s) => {
					if (hOff < 0) {
						s.style.opacity = '0.75';
						s.classList.remove('is-glow');
					} else {
						const b = 0.85 * Math.exp(-hOff / 0.35) + 0.15 * Math.exp(-hOff / 2.5);
						s.style.opacity = f(0.04 + 0.96 * b);
						s.classList.add('is-glow');
					}
				});
				// dawn between 05:00 and 06:00
				const dk = c01((hours - 6) / 1);
				dawn.style.opacity = f(dk);
				moon.style.opacity = f(1 - dk);
			});
		}
	});
</script>

