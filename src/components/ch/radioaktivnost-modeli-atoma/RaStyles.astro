---
/**
 * Shared colors of the pictures and models of «Радиоактивность. Модели атома» (grade 9). Renders nothing; each
 * component includes it (identical style blocks are merged by the build). The same colors in every figure:
 *   α radiation  red-pink (--ra-a = --ig-vy): positive, the color of protons and nuclei on the site;
 *   β radiation  blue (--ra-b = --ig-vx): β particles are electrons, the site's electron color;
 *   γ radiation  gold (--ra-g = --ig-v), drawn as a short wavy line;
 *   electrons in atoms blue, nuclei and Thomson's positive sphere red-pink (as in grade 8 «Электризация тел»);
 *   magnetic induction B purple (--sl-color-purple), as in the grade-9 electromagnetism chapters (no magnets are
 *     drawn; they would be N blue, S red); force arrows green (--sl-color-green).
 */
---

<style is:global>
	.ra {
		--ra-a: var(--ig-vy);
		--ra-b: var(--ig-vx);
		--ra-g: var(--ig-v);
		--ra-f: var(--sl-color-green);
		--ra-e: var(--ig-vx);
		--ra-p: var(--ig-vy);
		--ra-n: var(--sl-color-gray-3);
		--ra-bf: var(--sl-color-purple);
		--ra-gold: var(--ig-v);
		--ra-lead: hsl(220, 8%, 46%);
		--ra-al: hsl(210, 12%, 72%);
		--ra-paper: hsl(45, 30%, 92%);
		--ra-ink: var(--sl-color-white);
		--ra-dim: var(--sl-color-gray-3);
		--ra-line: var(--sl-color-gray-4);
	}
	:root[data-theme='light'] .ra {
		--ra-lead: hsl(220, 8%, 52%);
		--ra-al: hsl(210, 10%, 66%);
		--ra-paper: hsl(45, 40%, 97%);
	}
	.ra {
		margin: 1.25rem 0 1.75rem;
		padding: 0.8rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ra svg {
		display: block;
		width: 100%;
		height: auto;
		margin-inline: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.ra svg text {
		font-family: var(--__sl-font);
		font-variant-numeric: lining-nums;
	}
	/* lining figures everywhere in these figures: old-style digits made «+83e» read like «8з» */
	.ra,
	.ra .ra-cap,
	.ra button,
	.ra label {
		font-variant-numeric: lining-nums;
	}
	.ra .ra-lbl {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
	}
	.ra .ra-lbl-s {
		fill: var(--sl-color-gray-2);
		font-size: 11.5px;
	}
	.ra .ra-sym {
		font-family: var(--ig-font-math) !important;
		font-style: italic;
		font-weight: 600;
	}
	.ra .ra-cap {
		margin: 0.5rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		line-height: 1.45;
	}
	.ra .ra-ctl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
		margin-top: 0.5rem;
	}
	.ra .ra-btn {
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.ra .ra-btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.ra .ra-btn:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.ra .ra-a {
		color: var(--ra-a);
	}
	.ra .ra-b {
		color: var(--ra-b);
	}
	.ra .ra-g {
		color: var(--ra-g);
	}
	.ra i {
		font-family: var(--ig-font-math);
	}
</style>
