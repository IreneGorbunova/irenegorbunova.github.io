---
/**
 * «Атом Томсона» (J. J. Thomson, 1904): a positively charged sphere of radius about 10⁻¹⁰ м (translucent red, «+»
 * signs spread all over it: the positive charge fills the whole sphere evenly) with electrons (blue) sitting inside,
 * each trembling slightly about its place (amplitude 1,5 px, a few times a second; the real vibrations are far faster).
 * The example has six electrons: the sphere carries +6e, the electrons −6e together, the atom is neutral. The scale
 * bar is the radius, 10⁻¹⁰ м. Beside it, small, a slice of raisin cake, the everyday picture behind the model's
 * English nickname «plum pudding»: raisins in the dough as electrons in the sphere (the caption says it).
 */
import RaStyles from './RaStyles.astro';

const C = { x: 130, y: 104 };
const R = 78;
const EL = [
	{ x: -36, y: -30 },
	{ x: 22, y: -44 },
	{ x: 44, y: 8 },
	{ x: -10, y: 4 },
	{ x: -44, y: 32 },
	{ x: 16, y: 44 },
];
const PLUS: { x: number; y: number }[] = [];
for (let y = -66; y <= 66; y += 22) for (let x = -66; x <= 66; x += 22) {
	const sx = x + ((y / 22) % 2 ? 11 : 0);
	if (sx * sx + y * y < 66 * 66 && !EL.some((e) => (e.x - sx) ** 2 + (e.y - y) ** 2 < 14 * 14)) PLUS.push({ x: sx, y });
}
const RAISIN = [
	{ x: 322, y: 92 },
	{ x: 350, y: 110 },
	{ x: 334, y: 128 },
	{ x: 368, y: 136 },
	{ x: 312, y: 146 },
	{ x: 382, y: 104 },
	{ x: 352, y: 152 },
];
---

<RaStyles />
<figure class="ra tmp not-content" data-tmp>
	<svg viewBox="0 0 420 236" role="img" aria-label="Модель атома Томсона: положительно заряженный шар, по которому равномерно распределён положительный заряд, а внутри шара сидят электроны. Справа для сравнения — кусок кекса с изюмом" style="max-width: 40rem">
		<circle class="tmp-ball" cx={C.x} cy={C.y} r={R}></circle>
		{PLUS.map((p) => <text class="tmp-plus" x={C.x + p.x} y={C.y + p.y + 3.5} text-anchor="middle">+</text>)}
		<g data-els>
			{
				EL.map((e) => (
					<g transform={`translate(${C.x + e.x} ${C.y + e.y})`}>
						<g data-e>
							<circle class="tmp-e" r="6" />
							<path class="tmp-minus" d="M-3 0 H3" />
						</g>
					</g>
				))
			}
		</g>
		<!-- labels -->
		<path class="tmp-ptr" d={`M${C.x + 52} ${C.y - 58} L${C.x + 82} ${C.y - 84}`}></path>
		<text class="ra-lbl-s" x={C.x + 84} y={C.y - 92}>положительный заряд</text>
		<text class="ra-lbl-s" x={C.x + 84} y={C.y - 80}>распределён по всему шару</text>
		<path class="tmp-ptr" d={`M${C.x + 50} ${C.y + 10} L${C.x + 96} ${C.y + 30}`}></path>
		<text class="ra-lbl-s" x={C.x + 98} y={C.y + 34}>электроны</text>
		<!-- the scale bar: the radius -->
		<path class="tmp-bar" d={`M${C.x} ${C.y + R + 12} H${C.x + R} M${C.x} ${C.y + R + 8} v8 M${C.x + R} ${C.y + R + 8} v8`}></path>
		<text class="ra-lbl-s" x={C.x + R / 2} y={C.y + R + 26} text-anchor="middle">10⁻¹⁰ м</text>
		<text class="ra-lbl tmp-sum" x="210" y="232" text-anchor="middle">заряд шара +6<tspan class="ra-sym">e</tspan>, шесть электронов −6<tspan class="ra-sym">e</tspan>: атом нейтрален</text>
		<!-- a slice of raisin cake -->
		<path class="tmp-cake" d="M300 160 L300 92 Q300 78 316 76 L390 72 Q398 72 398 84 L398 160 Z"></path>
		<path class="tmp-crust" d="M300 92 Q300 78 316 76 L390 72 Q398 72 398 84 L398 90 Q360 86 300 98 Z"></path>
		{RAISIN.map((r) => <ellipse class="tmp-raisin" cx={r.x} cy={r.y} rx="4.2" ry="3" transform={`rotate(${(r.x * 7) % 60 - 30} ${r.x} ${r.y})`} />)}
		<text class="ra-lbl-s" x="349" y="178" text-anchor="middle">кекс с изюмом</text>
	</svg>
	<figcaption class="ra-cap">Справа для сравнения — кекс с изюмом: изюминки сидят в тесте, как электроны в шаре Томсона.</figcaption>
</figure>

<script>
	import { loop } from '@components/ch/g7/kit';

	document.querySelectorAll<HTMLElement>('[data-tmp]').forEach((root) => {
		const es = [...root.querySelectorAll<SVGGElement>('[data-e]')];
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			es.forEach((e, i) => {
				const x = 1.5 * Math.sin(t * (5 + i * 0.7) + i);
				const y = 1.5 * Math.cos(t * (4.3 + i * 0.9) + 2 * i);
				e.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
			});
			return true;
		});
	});
</script>

<style is:global>
	.tmp-ball {
		fill: color-mix(in srgb, var(--ra-p) 22%, transparent);
		stroke: color-mix(in srgb, var(--ra-p) 55%, transparent);
		stroke-width: 1.4;
	}
	.tmp-plus {
		fill: color-mix(in srgb, var(--ra-p) 75%, var(--sl-color-white));
		font-size: 12px;
		font-weight: 700;
	}
	.tmp-e {
		fill: var(--ra-e);
	}
	.tmp-minus {
		stroke: white;
		stroke-width: 1.6;
	}
	.tmp-ptr,
	.tmp-bar {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
		fill: none;
	}
	.tmp-sum {
		font-size: 12px;
	}
	.tmp-cake {
		fill: hsl(42, 70%, 76%);
		stroke: hsl(35, 50%, 50%);
		stroke-width: 0.8;
	}
	.tmp-crust {
		fill: hsl(28, 55%, 45%);
	}
	.tmp-raisin {
		fill: hsl(285, 35%, 22%);
	}
</style>
