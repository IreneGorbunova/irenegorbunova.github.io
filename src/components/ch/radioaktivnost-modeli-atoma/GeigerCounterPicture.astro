---
/**
 * «Счётчик Гейгера»: a labelled school scheme with a short animation (a 4-s loop).
 * A tube filled with gas at low pressure (usually argon with a little alcohol or halogen vapour); a thin wire along its
 * axis; a thin window at one end that lets particles in. A voltage source of about 400 В: «+» to the wire, «−» to the
 * metal wall of the tube, through a resistor of several megaohms; the counter reads the voltage pulse on the resistor.
 * Animation: a β particle (blue, the chapter's β color) flies in through the window and knocks electrons out of gas
 * atoms along its path (tiny blue electrons, red positive ions). The electrons are pulled to the wire; near the thin
 * wire the field is so strong that they knock out more electrons: an avalanche, a short discharge along the wire (the
 * flash). A current pulse passes the resistor, the counter adds one and the loudspeaker clicks. The discharge dies
 * out (the vapour quenches it), the ions drift slowly to the wall, and the counter is ready for the next particle.
 * The whole process takes less than a thousandth of a second; here it is slowed to about 2 s. The tube is drawn
 * about its real size on a phone screen (a few centimeters across, 10–20 см long); the gas atoms are not drawn.
 */
import RaStyles from './RaStyles.astro';

const Y = 94; // the wire
const ION = [
	{ x: 82, y: 82 },
	{ x: 116, y: 85 },
	{ x: 150, y: 88 },
	{ x: 186, y: 92 },
	{ x: 222, y: 96 },
	{ x: 256, y: 100 },
];
---

<RaStyles />
<figure class="ra gcp not-content" data-gcp>
	<svg viewBox="0 0 420 236" role="img" aria-label="Схема счётчика Гейгера: трубка с газом, вдоль её оси натянута тонкая нить, на торце тонкое окошко. Источник напряжения около 400 вольт подключён плюсом к нити и минусом к стенке трубки через резистор. Частица влетает в окошко и выбивает электроны из атомов газа, электроны летят к нити, вдоль нити вспыхивает разряд, счётчик прибавляет единицу и щёлкает" style="max-width: 40rem">
		<!-- the tube -->
		<rect class="gcp-tube" x="40" y="62" width="252" height="64" rx="12"></rect>
		<rect class="gcp-gas" x="44" y="66" width="244" height="56" rx="9"></rect>
		<rect class="gcp-win" x="38" y="68" width="5" height="52" rx="2"></rect>
		<rect class="gcp-plug" x="288" y="86" width="14" height="16" rx="2"></rect>
		<path class="gcp-wire" d={`M52 ${Y} H330`}></path>
		<rect class="gcp-glow" x="52" y={Y - 4} width="240" height="8" rx="4" data-glow></rect>
		<text class="ra-lbl" x="166" y="52" text-anchor="middle">трубка с газом</text>
		<text class="ra-lbl" x="40" y="146" text-anchor="middle">окошко</text>
		<path class="gcp-ptr" d="M40 136 V122"></path>
		<text class="ra-lbl" x="214" y="146" text-anchor="middle">нить</text>
		<path class="gcp-ptr" d={`M214 136 L206 ${Y + 2}`}></path>
		<!-- the circuit: wire → resistor → source (+) ; source (−) → wall -->
		<path class="gcp-cir" d={`M330 ${Y} H346 V108 M346 140 V206 H262 M240 206 H170 V126`}></path>
		<path class="gcp-res" d="M346 108 l6 3 l-12 6 l12 6 l-12 6 l12 6 l-6 3 V140"></path>
		<path class="gcp-bat-l" d="M262 194 V218"></path>
		<path class="gcp-bat-s" d="M252 199 V213"></path>
		<path class="gcp-bat-l" d="M246 194 V218"></path>
		<path class="gcp-bat-s" d="M240 199 V213"></path>
		<text class="gcp-pm" x="268" y="196">+</text>
		<text class="gcp-pm" x="228" y="196">−</text>
		<text class="gcp-pm" x="318" y={Y - 6}>+</text>
		<text class="gcp-pm" x="160" y="140">−</text>
		<text class="ra-lbl" x="251" y="234" text-anchor="middle">источник напряжения ≈ 400 В</text>
		<!-- the counter across the resistor -->
		<path class="gcp-cir" d="M346 112 H362 M346 136 H362"></path>
		<rect class="gcp-disp" x="362" y="100" width="52" height="48" rx="5"></rect>
		<text class="gcp-num" x="408" y="128" text-anchor="end" data-num>41</text>
		<circle class="gcp-spk" cx="376" cy="139" r="4"></circle>
		<text class="ra-lbl" x="388" y="166" text-anchor="middle">счётчик</text>
		<text class="gcp-click" x="388" y="90" text-anchor="middle" data-click>щёлк!</text>
		<!-- the particle, the ion pairs, the avalanche -->
		<path class="gcp-trail" d="" data-trail></path>
		<circle class="gcp-beta" r="2.6" data-beta></circle>
		<g data-ions>
			{
				ION.map((p) => (
					<g data-pair>
						<g class="gcp-ion" data-ion>
							<circle cx={p.x} cy={p.y} r="2.6" />
							<path d={`M${p.x - 1.4} ${p.y}h2.8M${p.x} ${p.y - 1.4}v2.8`} />
						</g>
						<circle class="gcp-e" cx={p.x} cy={p.y} r="1.5" data-e data-x={p.x} data-y={p.y} />
					</g>
				))
			}
		</g>
		<g data-aval></g>
	</svg>
	<figcaption class="ra-cap">Весь процесс длится меньше тысячной доли секунды; здесь он сильно замедлен.</figcaption>
</figure>

<script>
	import { el, loop } from '@components/ch/g7/kit';

	const Y = 94;
	const CYCLE = 4;
	const A = { x: 6, y: 78 };
	const B = { x: 300, y: 103 };
	document.querySelectorAll<HTMLElement>('[data-gcp]').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const beta = q<SVGCircleElement>('[data-beta]');
		const trail = q<SVGPathElement>('[data-trail]');
		const glow = q<SVGRectElement>('[data-glow]');
		const num = q<SVGTextElement>('[data-num]');
		const click = q<SVGTextElement>('[data-click]');
		const pairs = [...root.querySelectorAll<SVGGElement>('[data-pair]')];
		const aval = q<SVGGElement>('[data-aval]');
		// the avalanche: tiny electrons near the wire
		const av = Array.from({ length: 40 }, (_, i) => {
			const c = el('circle', { class: 'gcp-e', r: 1, cx: (60 + (i * 229) / 39).toFixed(1), cy: (Y + (i % 2 ? -1 : 1) * (2 + (i % 5))).toFixed(1) });
			aval.append(c);
			return c;
		});
		let t = 0;
		let n = 41;
		const draw = () => {
			const s = t % CYCLE;
			const flight = Math.min(1, s / 0.8);
			const bx = A.x + (B.x - A.x) * flight;
			const by = A.y + (B.y - A.y) * flight;
			beta.setAttribute('cx', bx.toFixed(1));
			beta.setAttribute('cy', by.toFixed(1));
			beta.style.opacity = s < 0.8 ? '1' : '0';
			trail.setAttribute('d', s < 1.2 ? `M${A.x} ${A.y}L${bx.toFixed(1)} ${by.toFixed(1)}` : '');
			trail.style.opacity = s < 0.8 ? '0.5' : (0.5 * Math.max(0, 1 - (s - 0.8) / 0.4)).toFixed(2);
			pairs.forEach((g) => {
				const e = g.querySelector<SVGCircleElement>('[data-e]')!;
				const ion = g.querySelector<SVGGElement>('[data-ion]')!;
				const x = +e.dataset.x!;
				const y = +e.dataset.y!;
				const born = ((x - A.x) / (B.x - A.x)) * 0.8;
				const on = s >= born;
				// the electron drifts to the wire between born and 1,3 s, then vanishes into the discharge
				const k = Math.min(1, Math.max(0, (s - Math.max(born, 0.5)) / (1.3 - Math.max(born, 0.5))));
				e.setAttribute('cy', (y + (Y - y) * k).toFixed(1));
				e.setAttribute('cx', (x + (k > 0 ? 4 * k : 0)).toFixed(1));
				e.style.opacity = on && s < 1.35 ? '1' : '0';
				// the ion drifts slowly to the wall and fades by 2,8 s
				const away = y < Y ? -1 : 1;
				const ki = Math.max(0, s - born);
				ion.setAttribute('transform', `translate(0 ${(away * Math.min(16, ki * 6)).toFixed(1)})`);
				ion.style.opacity = on ? Math.max(0, 1 - Math.max(0, s - 2.2) / 0.6).toFixed(2) : '0';
			});
			// the avalanche and the discharge between 1,3 and 1,9 s
			const g = s < 1.3 ? 0 : s < 1.45 ? (s - 1.3) / 0.15 : Math.max(0, 1 - (s - 1.45) / 0.5);
			glow.style.opacity = g.toFixed(2);
			av.forEach((c) => (c.style.opacity = s > 1.25 && s < 1.6 ? '1' : '0'));
			click.style.opacity = s > 1.45 && s < 2.2 ? '1' : '0';
			num.textContent = String(n + (s > 1.45 ? 1 : 0));
		};
		draw();
		loop(root, (dt) => {
			const before = Math.floor(t / CYCLE);
			t += dt;
			if (Math.floor(t / CYCLE) > before) n = n >= 98 ? 41 : n + 1;
			draw();
			return true;
		});
	});
</script>

<style is:global>
	.gcp-tube {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.gcp-gas {
		fill: color-mix(in srgb, var(--ig-surface) 70%, var(--ra-bf));
	}
	.gcp-win {
		fill: var(--sl-color-gray-2);
	}
	.gcp-plug {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
	}
	.gcp-wire {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.gcp-glow {
		fill: hsl(275, 90%, 80%);
		opacity: 0;
		filter: blur(2px);
	}
	.gcp-ptr {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.gcp-cir {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.gcp-res {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-linejoin: round;
	}
	.gcp-bat-l {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.gcp-bat-s {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3.5;
	}
	.gcp-pm {
		fill: var(--sl-color-white);
		font-size: 13px;
		font-weight: 700;
	}
	.gcp-disp {
		fill: hsl(150, 30%, 12%);
		stroke: var(--sl-color-gray-3);
	}
	.gcp-num {
		fill: hsl(140, 80%, 65%);
		font-size: 17px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.gcp-spk {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
	}
	.gcp-click {
		fill: var(--sl-color-white);
		font-size: 11px;
		font-style: italic;
		opacity: 0;
	}
	.gcp-trail {
		stroke: var(--ra-b);
		stroke-width: 1;
		stroke-dasharray: 2 2;
		fill: none;
	}
	.gcp-beta {
		fill: var(--ra-b);
	}
	.gcp-ion circle {
		fill: var(--ra-p);
	}
	.gcp-ion path {
		stroke: white;
		stroke-width: 0.8;
	}
	.gcp-e {
		fill: var(--ra-e);
		filter: drop-shadow(0 0 1px var(--ra-e));
	}
</style>
