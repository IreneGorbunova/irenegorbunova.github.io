---
/**
 * «Излучение в магнитном поле»: the radiation of radium in a magnetic field, drawn TO SCALE (2,5 px per мм).
 * A vacuum chamber 12 см wide and 10 см high; a grain of radium at the bottom of a narrow channel in a lead block under
 * the middle of the floor, so the radiation leaves the floor as a thin beam going straight up. A photographic plate
 * lines the top, the side walls and the floor: every particle that lands leaves a dot (the plate darkens).
 *
 * Physics: a charged particle moving across a uniform field moves on a circle of radius r = mυ/(qB) (for the fast
 * electrons r = p/(eB) with the relativistic momentum p).
 *   α (radium, 4,78 МэВ, υ = 1,5·10⁷ м/с, q = +2e, p = 1,009·10⁻¹⁹ кг·м/с): r = 0,315 м / B[Тл], so 6,30; 3,15; 1,57;
 *     0,63; 0,315 м at B = 0,05; 0,1; 0,2; 0,5; 1 Тл. After the 10-см path to the top plate the α spot is shifted by
 *     r − √(r² − (10 см)²) = 0,79; 1,59; 3,18; 7,98; 16,3 мм. The readout under the picture shows this number; the
 *     round inset shows the middle of the top plate enlarged 3 times (7,5 px per мм, ±4,7 мм: the spots of 0,8; 1,6 and
 *     3,2 мм are inside) so the small shift can be seen.
 *   β (electrons of radium's decay products; energies spread continuously, 0,5–2,3 МэВ are drawn, uniform in energy):
 *     r = 2,9 мм (0,5 МэВ), 4,7 мм (1 МэВ), 9,2 мм (2,3 МэВ) at 1 Тл, inversely proportional to B. A circle narrower
 *     than the chamber brings the electron back to the floor (at 2r from the channel); a wider one ends on the side
 *     wall; only circles with r > 10 см whose top crossing lies within 6 см reach the top plate (at 0,05 Тл, the
 *     fastest electrons, far to the side).
 *   γ: no charge, straight up to the middle of the top plate.
 *   Directions (v up): field away from the reader (⊗): the force q·v×B points left on a positive charge, so α turn left
 *   and β turn right; field toward the reader (⊙): the other way round. No field: one spot in the middle.
 * The beam is drawn as separate dots (one dot stands for very many particles); the motion is slowed enormously (α are
 * drawn slower than β and γ, as they are). The force arrows (green) show the direction only, the same length for
 * α and β (the force on a β electron is in fact about 9 times larger: e·2,8·10⁸ against 2e·1,5·10⁷).
 * Controls: «Пауза / Пуск»; field «Нет / От нас ⊗ / К нам ⊙»; B 0,05–1 Тл (five steps); which radiation is let in;
 * «Показать силу». Every change clears the plate.
 */
import RaStyles from './RaStyles.astro';

const K = 2.5; // px per мм
const X0 = 170; // the channel, px
const XL = 20;
const XR = XL + 120 * K;
const YT = 34;
const YF = YT + 100 * K; // the floor
const marks: { x: number; y: number }[] = [];
for (let y = YT + 20; y < YF - 8; y += 30) for (let x = XL + 18; x < XR; x += 30) marks.push({ x, y });
const IC = { x: 374, y: 84 };
const IR = 38;
---

<RaStyles />
<figure class="ra rfl not-content" data-rfl>
	<svg viewBox="0 0 420 346" role="img" aria-label="Модель: вакуумная камера 12 на 10 сантиметров в масштабе. Из свинцового блока внизу вверх выходит пучок излучения радия. Можно включить магнитное поле от нас или к нам и выбрать его индукцию. Фотопластинка на стенках темнеет там, куда попадают частицы">
		<defs>
			<clipPath id="rfl-ic"><circle cx={IC.x} cy={IC.y} r={IR - 2}></circle></clipPath>
		</defs>
		<!-- the chamber -->
		<rect class="rfl-ch" x={XL} y={YT} width={XR - XL} height={YF - YT}></rect>
		<g class="rfl-marks" data-marks>
			{
				marks.map((m) => (
					<g transform={`translate(${m.x} ${m.y})`}>
						<circle r="5" />
						<path class="rfl-x" d="M-3 -3 L3 3 M3 -3 L-3 3" />
						<circle class="rfl-o" r="1.4" />
					</g>
				))
			}
		</g>
		<text class="ra-sym rfl-b" x={XL + 6} y={YF - 8} data-bl>B</text>
		<!-- the plate on the walls -->
		<path class="rfl-plate" d={`M${XL + 1.5} ${YF} V${YT + 1.5} H${XR - 1.5} V${YF} M${XL} ${YF - 1.5} H${X0 - 3} M${X0 + 3} ${YF - 1.5} H${XR}`}></path>
		<text class="ra-lbl-s" x={XR - 4} y={YT - 6} text-anchor="end">фотопластинка</text>
		<g data-hits></g>
		<g data-parts></g>
		<g data-force></g>
		<!-- the lead block under the floor and the radium -->
		<path class="rfl-lead" d={`M${X0 - 26} ${YF} H${X0 - 2.5} V${YF + 26} H${X0 + 2.5} V${YF} H${X0 + 26} V${YF + 34} H${X0 - 26} Z`}></path>
		<circle class="rfl-ra" cx={X0} cy={YF + 27} r="2.4"></circle>
		<text class="ra-lbl-s" x={X0 + 32} y={YF + 22}>свинец</text>
		<text class="ra-lbl-s" x={X0 - 32} y={YF + 30} text-anchor="end">радий</text>
		<!-- rulers: 12 см along the floor, 10 см up the left wall -->
		<g class="rfl-ruler">
			{Array.from({ length: 13 }, (_, i) => <path d={`M${XL + i * 10 * K} ${YF + 38} v${i % 2 ? 4 : 7}`} />)}
			<path d={`M${XL} ${YF + 38} H${XR}`} />
		</g>
		{[0, 2, 4, 6, 8, 10, 12].map((c) => <text class="ra-lbl-s" x={XL + c * 10 * K} y={YF + 54} text-anchor="middle">{c === 12 ? '12 см' : c}</text>)}
		<!-- the inset: the middle of the top plate enlarged 3 times (±4,7 мм) -->
		<path class="rfl-zoom" d={`M${X0 - 12} ${YT + 2} L${IC.x - IR * 0.7} ${IC.y - IR * 0.7} M${X0 + 12} ${YT + 2} L${IC.x - IR * 0.7} ${IC.y + IR * 0.7}`}></path>
		<rect class="rfl-zbox" x={X0 - 12} y={YT - 3} width="24" height="10"></rect>
		<circle class="rfl-inset" cx={IC.x} cy={IC.y} r={IR}></circle>
		<g clip-path="url(#rfl-ic)">
			<rect class="rfl-iplate" x={IC.x - IR} y={IC.y - 7} width={IR * 2} height="14"></rect>
			{Array.from({ length: 9 }, (_, i) => <path class="rfl-itick" d={`M${IC.x + (i - 4) * 7.5} ${IC.y + 7} v${i === 4 ? 8 : 5}`} />)}
			<g data-ihits></g>
		</g>
		<text class="ra-lbl-s" x={IC.x} y={IC.y - 16} text-anchor="middle">1 мм</text>
		<path class="rfl-itick" d={`M${IC.x - 3.75} ${IC.y - 12} h7.5 M${IC.x - 3.75} ${IC.y - 14} v4 M${IC.x + 3.75} ${IC.y - 14} v4`}></path>
		<text class="ra-lbl-s" x={IC.x} y={IC.y + IR + 14} text-anchor="middle">×3</text>
	</svg>
	<p class="rfl-read" data-read></p>
	<div class="ra-ctl">
		<button type="button" class="ra-btn" data-run aria-pressed="false">Пауза</button>
		<span class="rfl-lab">Поле:</span>
		<button type="button" class="ra-btn" data-dir="0" aria-pressed="false">Нет</button>
		<button type="button" class="ra-btn" data-dir="1" aria-pressed="true">От нас ⊗</button>
		<button type="button" class="ra-btn" data-dir="-1" aria-pressed="false">К нам ⊙</button>
	</div>
	<div class="ra-ctl">
		<label class="rfl-lab rfl-slider"><span><i>B</i> = <b data-bv>0,1</b> Тл</span><input type="range" min="0" max="4" step="1" value="1" data-b /></label>
	</div>
	<div class="ra-ctl">
		<label class="rfl-chk ra-a"><input type="checkbox" checked data-k="a" /><span class="rfl-kn">α-частицы</span></label>
		<label class="rfl-chk ra-b"><input type="checkbox" checked data-k="b" /><span class="rfl-kn">β-частицы</span></label>
		<label class="rfl-chk ra-g"><input type="checkbox" checked data-k="g" /><span class="rfl-kn">γ-излучение</span></label>
		<label class="rfl-chk rfl-fchk"><input type="checkbox" data-force-on /> Показать силу</label>
	</div>
</figure>

<script>
	import { el, loop, fmt } from '@components/ch/g7/kit';

	const K = 2.5;
	const X0 = 170;
	const YT = 34;
	const YF = YT + 100 * K;
	const IC = { x: 374, y: 84 };
	const BS = [0.05, 0.1, 0.2, 0.5, 1];
	const RA1 = 315; // α radius at 1 Тл, мм
	const ME = 0.511;
	const rBeta1 = (T: number) => Math.sqrt(T * T + 2 * T * ME) / 0.299792458; // мм at 1 Тл (p in МэВ/c: r[мм] = p/(0,2998·B))
	const SPEED = { a: 70, b: 230, g: 280 }; // px per second
	type Kind = 'a' | 'b' | 'g';
	type Part = { k: Kind; s: number; R: number; side: number; end: number; node: SVGElement };

	/** Where a track of radius R (мм; 0 = straight) bending to `side` (+1 right, −1 left) ends: arc length (мм). */
	const endOf = (R: number) => {
		if (!R) return 100;
		const cand: number[] = [Math.PI * R]; // back on the floor
		if (R >= 100) {
			const ph = Math.asin(100 / R);
			if (R * (1 - Math.cos(ph)) <= 60) cand.push(ph * R);
		}
		if (R >= 30) cand.push(Math.acos(1 - 60 / R) * R);
		return Math.min(...cand);
	};
	/** Position (px) and direction at arc length s (мм). */
	const at = (s: number, R: number, side: number) => {
		if (!R || !side) return { x: X0, y: YF - s * K, a: -Math.PI / 2 };
		const ph = s / R;
		return { x: X0 + side * R * (1 - Math.cos(ph)) * K, y: YF - R * Math.sin(ph) * K, a: -Math.PI / 2 + side * ph };
	};
	const shiftA = (B: number) => {
		const r = RA1 / B;
		return r - Math.sqrt(r * r - 100 * 100);
	};

	document.querySelectorAll<HTMLElement>('[data-rfl]').forEach((root) => {
		const svg = root.querySelector('svg')!;
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const parts = q<SVGGElement>('[data-parts]');
		const hits = q<SVGGElement>('[data-hits]');
		const ihits = q<SVGGElement>('[data-ihits]');
		const forceG = q<SVGGElement>('[data-force]');
		const marksG = q<SVGGElement>('[data-marks]');
		const bl = q<SVGTextElement>('[data-bl]');
		const read = q<HTMLElement>('[data-read]');
		const bIn = q<HTMLInputElement>('[data-b]');
		const bv = q<HTMLElement>('[data-bv]');
		const runBtn = q<HTMLButtonElement>('[data-run]');
		const dirBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-dir]')];
		const kinds = [...root.querySelectorAll<HTMLInputElement>('[data-k]')];
		const fOn = q<HTMLInputElement>('[data-force-on]');
		let dir = 1; // 1: away from the reader (⊗), −1: toward (⊙), 0: no field
		let B = BS[1];
		let running = true;
		let live: Part[] = [];
		const next = { a: 0, b: 0.1, g: 0.2 };
		let seed = 3;
		const rnd = () => {
			seed = (seed * 16807) % 2147483647;
			return seed / 2147483647;
		};
		const on = (k: Kind) => kinds.find((c) => c.dataset.k === k)!.checked;
		// side of the turn: positive charge turns left for ⊗ (dir 1)
		const sideOf = (k: Kind) => (k === 'g' || !dir ? 0 : (k === 'a' ? -1 : 1) * dir);

		const spawn = (k: Kind) => {
			let R = 0;
			if (dir && k === 'a') R = RA1 / B;
			if (dir && k === 'b') R = rBeta1(0.5 + 1.8 * rnd()) / B;
			const node = k === 'g' ? el('path', { class: 'rfl-pg', d: 'M-6 0 q1.5 -3 3 0 t3 0 t3 0 t3 0' }) : el('circle', { class: k === 'a' ? 'rfl-pa' : 'rfl-pb', r: k === 'a' ? 3 : 1.9 });
			parts.append(node);
			live.push({ k, s: 0, R, side: sideOf(k), end: endOf(R), node });
		};
		const hit = (p: Part) => {
			const e = at(p.end, p.R, p.side);
			const jit = (rnd() - 0.5) * 2;
			// the dot sits on the plate: shifted along the wall a little, inside the chamber
			const x = Math.abs(e.y - YT) < 0.5 ? e.x + jit : e.x;
			const y = Math.abs(e.y - YT) < 0.5 ? YT + 2 + rnd() * 2 : e.y + (Math.abs(e.y - YF) < 0.5 ? -2 - rnd() * 2 : jit);
			hits.append(el('circle', { class: `rfl-h rfl-h${p.k}`, cx: x.toFixed(1), cy: y.toFixed(1), r: 1.5 }));
			while (hits.childElementCount > 260) hits.firstElementChild!.remove();
			// the inset: hits on the top plate within ±4 мм of the middle, 4 times larger
			if (Math.abs(e.y - YT) < 0.5) {
				const xm = (e.x - X0) / K;
				if (Math.abs(xm) < 4.7) {
					ihits.append(el('circle', { class: `rfl-h rfl-h${p.k}`, cx: (IC.x + xm * 7.5 + jit * 0.5).toFixed(1), cy: (IC.y + (rnd() - 0.5) * 9).toFixed(1), r: 2 }));
					while (ihits.childElementCount > 120) ihits.firstElementChild!.remove();
				}
			}
		};
		const arrow = (p: Part) => {
			if (!p.side) return;
			const e = at(p.s, p.R, p.side);
			// toward the center of the circle: perpendicular to the velocity, to the side of the turn
			const ux = Math.cos(e.a + p.side * (Math.PI / 2));
			const uy = Math.sin(e.a + p.side * (Math.PI / 2));
			const L = 22;
			const tip = { x: e.x + ux * L, y: e.y + uy * L };
			forceG.append(
				el('path', { class: 'rfl-f', d: `M${e.x.toFixed(1)} ${e.y.toFixed(1)}L${(tip.x - ux * 5).toFixed(1)} ${(tip.y - uy * 5).toFixed(1)}` }),
				el('path', { class: 'rfl-fh', d: `M${tip.x.toFixed(1)} ${tip.y.toFixed(1)}L${(tip.x - ux * 7 - uy * 3.5).toFixed(1)} ${(tip.y - uy * 7 + ux * 3.5).toFixed(1)}L${(tip.x - ux * 7 + uy * 3.5).toFixed(1)} ${(tip.y - uy * 7 - ux * 3.5).toFixed(1)}Z` }),
			);
		};
		const draw = () => {
			forceG.replaceChildren();
			for (const p of live) {
				const e = at(p.s, p.R, p.side);
				p.node.setAttribute('transform', `translate(${e.x.toFixed(1)} ${e.y.toFixed(1)}) rotate(${((e.a * 180) / Math.PI).toFixed(1)})`);
			}
			if (fOn.checked && dir) {
				const fa = live.find((p) => p.k === 'a' && p.s > 10 && p.s < 85);
				const fb = live.find((p) => p.k === 'b' && p.s > 2 && p.s < p.end * 0.8);
				if (fa) arrow(fa);
				if (fb) arrow(fb);
			}
		};
		const step = (dt: number) => {
			if (!running) return false;
			(['a', 'b', 'g'] as Kind[]).forEach((k) => {
				next[k] -= dt;
				if (next[k] <= 0) {
					if (on(k)) spawn(k);
					next[k] = (k === 'a' ? 0.35 : k === 'b' ? 0.18 : 0.4) * (0.6 + 0.8 * rnd());
				}
			});
			live = live.filter((p) => {
				p.s += (SPEED[p.k] / K) * dt;
				if (p.s >= p.end) {
					hit(p);
					p.node.remove();
					return false;
				}
				return true;
			});
			draw();
			return true;
		};
		const wake = loop(root, step);
		const reset = () => {
			live.forEach((p) => p.node.remove());
			live = [];
			hits.replaceChildren();
			ihits.replaceChildren();
			forceG.replaceChildren();
			marksG.classList.toggle('is-off', !dir);
			marksG.classList.toggle('is-in', dir === 1);
			marksG.classList.toggle('is-out', dir === -1);
			bl.style.opacity = dir ? '1' : '0';
			bv.textContent = fmt(B, B < 0.1 ? 2 : 1).replace(/,0$/, '');
			bIn.disabled = !dir;
			const sh = dir && on('a') ? shiftA(B) : 0;
			read.innerHTML = !on('a') ? '' : dir ? `Смещение пятна <i>α</i>-частиц на верхней пластинке: <b>${fmt(sh, 1)} мм</b> ${dir === 1 ? 'влево' : 'вправо'}` : 'Смещение пятна <i>α</i>-частиц: <b>0 мм</b>';
			wake();
		};
		bIn.addEventListener('input', () => {
			B = BS[+bIn.value];
			reset();
		});
		dirBtns.forEach((b) =>
			b.addEventListener('click', () => {
				dir = +b.dataset.dir!;
				dirBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				reset();
			}),
		);
		kinds.forEach((c) => c.addEventListener('change', reset));
		fOn.addEventListener('change', draw);
		runBtn.addEventListener('click', () => {
			running = !running;
			runBtn.textContent = running ? 'Пауза' : 'Пуск';
			wake();
		});
		reset();
		// start with a plate that has been exposed for a few seconds
		for (let i = 0; i < 240; i++) step(1 / 30);
	});
</script>

<style is:global>
	.rfl-ch {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 50%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.rfl-marks circle:not(.rfl-o) {
		fill: none;
		stroke: color-mix(in srgb, var(--ra-bf) 45%, transparent);
		stroke-width: 1;
	}
	.rfl-marks .rfl-x {
		stroke: color-mix(in srgb, var(--ra-bf) 45%, transparent);
		stroke-width: 1.1;
	}
	.rfl-marks .rfl-o {
		fill: color-mix(in srgb, var(--ra-bf) 60%, transparent);
	}
	.rfl-marks.is-in .rfl-o,
	.rfl-marks.is-out .rfl-x,
	.rfl-marks.is-off {
		display: none;
	}
	.rfl-b {
		fill: var(--ra-bf);
		font-size: 15px;
	}
	.rfl-plate {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-gray-4) 60%, var(--ra-paper));
		stroke-width: 3;
	}
	.rfl-h {
		opacity: 0.8;
	}
	.rfl-ha {
		fill: var(--ra-a);
	}
	.rfl-hb {
		fill: var(--ra-b);
	}
	.rfl-hg {
		fill: var(--ra-g);
	}
	.rfl-pa {
		fill: var(--ra-a);
	}
	.rfl-pb {
		fill: var(--ra-b);
	}
	.rfl-pg {
		fill: none;
		stroke: var(--ra-g);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.rfl-f {
		stroke: var(--ra-f);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.rfl-fh {
		fill: var(--ra-f);
	}
	.rfl-lead {
		fill: var(--ra-lead);
		stroke: color-mix(in srgb, var(--ra-lead) 60%, black);
	}
	.rfl-ra {
		fill: hsl(160, 80%, 70%);
	}
	.rfl-ruler path {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rfl-zoom {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.7;
		stroke-dasharray: 2 2;
	}
	.rfl-zbox {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.rfl-inset {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.rfl-iplate {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 60%, var(--ra-paper));
	}
	.rfl-itick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.rfl-read {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		min-height: 1.4em;
	}
	.rfl-read i,
	.rfl-lab i,
	.rfl-chk i {
		font-family: var(--ig-font-math);
	}
	.rfl-lab {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rfl-slider {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.rfl-slider input {
		width: 12rem;
		max-width: 60vw;
		accent-color: var(--sl-color-purple);
	}
	.rfl-chk {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: var(--sl-text-sm);
		margin-right: 0.6rem;
	}
	.rfl-kn {
		white-space: nowrap;
	}
	.rfl-fchk {
		color: var(--sl-color-gray-2);
	}
	.rfl-chk input {
		accent-color: currentColor;
	}
</style>
