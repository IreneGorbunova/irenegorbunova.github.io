---
/** Frame and shared parts of the explanatory pictures of «Атмосферное давление» (panels, caption, «Повторить», air, arrows, mercury) and the colors of the people and hands of people.ts (the palette of the person in «Давление. Закон Паскаля»). Renders nothing. */
---

<style is:global>
	.ap-pic {
		--ap-air: var(--ig-vx);
		--ap-hg-edge: var(--sl-color-gray-3);
		--ap-hg-mid: var(--sl-color-gray-1);
		--ap-water: color-mix(in srgb, var(--ig-vx) 35%, transparent);
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .ap-pic {
		--ap-hg-mid: var(--sl-color-gray-5);
	}
	.ap-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.ap-pic--one .ap-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 26rem;
		margin-inline: auto;
	}
	.ap-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.ap-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.ap-pic .ap-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.ap-pic .ap-t-air {
		fill: var(--ap-air);
	}
	.ap-pic .ap-t-hl {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.ap-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.ap-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.ap-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.ap-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	/* air molecules and the arrows of air pressure */
	.ap-dot {
		fill: var(--sl-color-gray-3);
	}
	.ap-arrow {
		stroke: var(--ap-air);
		stroke-width: 2.4;
		stroke-linecap: round;
		fill: none;
	}
	.ap-head {
		fill: var(--ap-air);
	}
	.ap-glass {
		fill: color-mix(in srgb, var(--sl-color-white) 5%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.ap-metal {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.ap-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.ap-earth {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-5));
	}
	.ap-water {
		fill: var(--ap-water);
	}
	.ap-hg-edge {
		stop-color: var(--ap-hg-edge);
	}
	.ap-hg-mid {
		stop-color: var(--ap-hg-mid);
	}
	.ap-vacuum {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
	}
	.ap-dim {
		stroke: var(--ig-v);
		stroke-width: 1.6;
		fill: none;
	}
	.ap-dimhead {
		fill: var(--ig-v);
	}
	.ap-scale {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ap-pic .ap-scale-num {
		font-size: 11px;
		fill: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
	}
	/* people and hands (people.ts) */
	:root {
		--ah-skin: hsl(26, 55%, 72%);
		--ah-skin-dark: hsl(22, 45%, 60%);
		--ah-line: hsl(222, 35%, 14%);
		--ah-hair: hsl(25, 40%, 28%);
		--ah-shirt: hsl(150, 45%, 42%);
		--ah-shirt-b: hsl(352, 62%, 62%);
		--ah-pants: hsl(225, 25%, 34%);
	}
	:root[data-theme='light'] {
		--ah-line: hsl(222, 30%, 22%);
	}
	.ah-outline {
		fill: none;
		stroke: var(--ah-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ah-skin-s,
	.ah-sleeve-s,
	.ah-sleeve-b-s {
		fill: none;
		stroke: var(--ah-skin);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ah-sleeve-s {
		stroke: var(--ah-shirt);
	}
	.ah-sleeve-b-s {
		stroke: var(--ah-shirt-b);
	}
	.ah-skin {
		fill: var(--ah-skin);
		stroke: var(--ah-line);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.ah-skin-dark {
		fill: var(--ah-skin-dark);
		stroke: var(--ah-line);
		stroke-width: 1;
	}
	.ah-ear {
		stroke-width: 0.8;
	}
	.ah-ear-in {
		fill: none;
		stroke: var(--ah-line);
		stroke-width: 0.8;
		opacity: 0.6;
	}
	.ah-hair {
		fill: var(--ah-hair);
		stroke: var(--ah-line);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.ah-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	.ah-eye {
		fill: var(--ah-line);
	}
	.ah-brow,
	.ah-mouth {
		fill: none;
		stroke: var(--ah-line);
		stroke-width: 1.1;
		stroke-linecap: round;
	}
	.ah-mouth-open {
		fill: hsl(350, 45%, 30%);
		stroke: var(--ah-line);
		stroke-width: 0.8;
	}
	.ah-lips {
		fill: hsl(355, 55%, 62%);
		stroke: var(--ah-line);
		stroke-width: 0.8;
	}
	.ah-nail {
		fill: hsl(15, 60%, 88%);
		stroke: var(--ah-line);
		stroke-width: 0.6;
	}
	.ah-pants-s {
		fill: none;
		stroke: var(--ah-pants);
		stroke-linecap: round;
	}
	.ah-pants {
		fill: var(--ah-pants);
	}
	.ah-shoe {
		fill: hsl(24, 38%, 30%);
		stroke: var(--ah-line);
		stroke-width: 0.6;
	}
	.ah-shirt {
		fill: var(--ah-shirt);
		stroke: var(--ah-line);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.ah-shirt-b {
		fill: var(--ah-shirt-b);
		stroke: var(--ah-line);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.ah-crease {
		fill: none;
		stroke: var(--ah-line);
		stroke-width: 0.8;
		stroke-linecap: round;
		opacity: 0.5;
	}
	@media (max-width: 40rem) {
		.ap-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
