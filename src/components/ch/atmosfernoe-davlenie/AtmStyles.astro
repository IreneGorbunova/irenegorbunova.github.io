---
/** Frame and shared parts of the explanatory pictures of «Атмосферное давление» (panels, caption, «Повторить», air, arrows, mercury). Renders nothing. */
---

<style is:global>
	.ap-pic {
		--ap-air: var(--ig-vx);
		--ap-hg-edge: var(--sl-color-gray-3);
		--ap-hg-mid: var(--sl-color-gray-1);
		--ap-water: color-mix(in srgb, var(--ig-vx) 35%, transparent);
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .ap-pic {
		--ap-hg-mid: var(--sl-color-gray-5);
	}
	.ap-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.ap-pic--one .ap-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 26rem;
		margin-inline: auto;
	}
	.ap-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.ap-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.ap-pic .ap-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.ap-pic .ap-t-air {
		fill: var(--ap-air);
	}
	.ap-pic .ap-t-hl {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.ap-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.ap-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.ap-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.ap-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	/* air molecules and the arrows of air pressure */
	.ap-dot {
		fill: var(--sl-color-gray-3);
	}
	.ap-arrow {
		stroke: var(--ap-air);
		stroke-width: 2.4;
		stroke-linecap: round;
		fill: none;
	}
	.ap-head {
		fill: var(--ap-air);
	}
	.ap-glass {
		fill: color-mix(in srgb, var(--sl-color-white) 5%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.ap-metal {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.ap-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.ap-earth {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-5));
	}
	.ap-water {
		fill: var(--ap-water);
	}
	.ap-hg-edge {
		stop-color: var(--ap-hg-edge);
	}
	.ap-hg-mid {
		stop-color: var(--ap-hg-mid);
	}
	.ap-vacuum {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
	}
	.ap-dim {
		stroke: var(--ig-v);
		stroke-width: 1.6;
		fill: none;
	}
	.ap-dimhead {
		fill: var(--ig-v);
	}
	.ap-scale {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ap-pic .ap-scale-num {
		font-size: 11px;
		fill: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
	}
	@media (max-width: 40rem) {
		.ap-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
