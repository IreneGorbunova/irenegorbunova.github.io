---
/**
 * Small pictures to «Где это встречается», in the order of the list: a syringe (the piston goes up, the liquid
 * follows it: CSS loop), a dropper (fingers squeeze the rubber bulb, air bubbles out of the tip; the fingers let go,
 * the bulb takes its shape back, and the air pushes the liquid up the glass tube), a suction cup on a wall (almost no
 * air under it), a glass of water covered with a sheet of paper and turned over with the palm on the paper (the hand
 * is taken away, the water stays; the arrows of the air under the paper appear), a bird drinker (a bottle upside
 * down in a dish; an air bubble goes up when the water no longer covers the neck: CSS loop), and the ears in a
 * climbing airliner (a passenger and an enlarged section of the ear: the ear canal, the eardrum, the middle ear and
 * the tube to the throat). In the airliner the pressure in the cabin falls from 760 to about 570 мм рт. ст. (cabins are
 * kept at the pressure of 1800–2400 м); the air in the middle ear stays at 760 and bows the eardrum out into the ear
 * canal (the bow greatly enlarged). The passenger swallows, the tube to the throat opens, some air of the middle ear
 * goes out, the pressures become equal and the eardrum is flat again. Blue arrows: the air presses. Times are not
 * real: the climb (about 20 min) takes 5 s. The hands and the passenger are drawn with the shared people kit (kitArm.ts
 * for a forearm with a kit hand; the passenger is a grown-up of 1,7 м, of whom the head and the shoulders show).
 */
import AtmStyles from './AtmStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `apu-${uid}`;
let seed = 3;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
// air dots around the suction cup (outside only)
const cupDots: [number, number][] = [];
while (cupDots.length < 26) {
	const x = 36 + rnd() * 158;
	const y = 30 + rnd() * 134;
	const inCup = ((x - 30) / 40) ** 2 + ((y - 92) / 36) ** 2 < 1;
	const nearArrows = ((Math.abs(y - 72) < 7 || Math.abs(y - 112) < 7) && x < 130) || (y > 144 && x < 136);
	if (inCup || nearArrows || (x > 60 && x < 90 && Math.abs(y - 92) < 8)) continue;
	cupDots.push([Math.round(x), Math.round(y)]);
}
const cupX = (y: number) => 30 + 34 * Math.sqrt(Math.max(0, 1 - ((y - 92) / 30) ** 2));
---

<AtmStyles />
<figure class="ap-pic ap-pic--four not-content" data-atmuses>
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Шприц: поршень поднимают, и жидкость из стакана поднимается в шприц вслед за поршнем. Воздух давит на жидкость в стакане">
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="ap-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<text class="ap-title" x="190" y="22" text-anchor="end">Шприц</text>
			<!-- beaker -->
			<rect class="ap-water" x="42" y="128" width="88" height="31"></rect>
			<path class="ap-glass" d="M40 104 V158 q0 3 3 3 H129 q3 0 3 -3 V104"></path>
			<!-- syringe -->
			<line class="ap-needle" x1="86" y1="120" x2="86" y2="150"></line>
			<rect class="ap-water ap-syr-liq" x="78" y="71" width="16" height="49"></rect>
			<rect class="ap-glass" x="76" y="56" width="20" height="66" rx="2"></rect>
			<line class="ap-line" x1="70" y1="58" x2="102" y2="58" style="stroke-width: 3"></line>
			<g class="ap-syr-piston">
				<rect class="ap-metal" x="78" y="66" width="16" height="5"></rect>
				<line class="ap-line" x1="86" y1="66" x2="86" y2="32" style="stroke-width: 3"></line>
				<line class="ap-line" x1="76" y1="32" x2="96" y2="32" style="stroke-width: 4"></line>
			</g>
			{[54, 116].map((x) => <line class="ap-arrow" x1={x} y1="96" x2={x} y2="124" marker-end={`url(#${mA})`} />)}
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Пипетка: пальцы сжимают резиновый баллончик, и из кончика пипетки выходят пузырьки воздуха. Пальцы отпускают баллончик, и воздух вталкивает жидкость в пипетку" data-pip>
			<text class="ap-title" x="190" y="22" text-anchor="end">Пипетка</text>
			<!-- beaker and liquid -->
			<rect class="ap-water" x="42" y="128" width="88" height="31"></rect>
			<path class="ap-glass" d="M40 104 V158 q0 3 3 3 H129 q3 0 3 -3 V104"></path>
			<g data-bubbles></g>
			<!-- the dropper: liquid inside, glass, rubber bulb -->
			<path class="ap-water" data-pipliq></path>
			<path class="ap-glass" d="M80 66 V126 L84 146 H88 L92 126 V66"></path>
			<path class="ap-bulb" data-bulb></path>
			<!-- the hand round the bulb (the shared people kit) -->
			<g data-fingers></g>
			{[54, 116].map((x) => <line class="ap-arrow" x1={x} y1="96" x2={x} y2="124" marker-end={`url(#${mA})`} />)}
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Присоска на гладкой стене. Под присоской воздуха почти нет, а воздух снаружи прижимает её к стене">
			<text class="ap-title" x="190" y="22" text-anchor="end">Присоска</text>
			<rect class="ap-wall" x="0" y="0" width="30" height="170"></rect>
			{[28, 56, 84, 112, 140].map((y) => <line class="ap-tile" x1="0" y1={y} x2="30" y2={y} />)}
			{cupDots.map(([x, y]) => <circle class="ap-dot" cx={x} cy={y} r="1.5" />)}
			<circle class="ap-dot" cx="38" cy="86" r="1.5"></circle>
			<path class="ap-cup" d="M30 60 Q70 62 64 92 Q70 122 30 124"></path>
			<line class="ap-line" x1="64" y1="92" x2="80" y2="92" style="stroke-width: 4"></line>
			<path class="ap-line" d="M80 92 q8 0 8 9 q0 7 -6 7" style="stroke-width: 2.4"></path>
			{[72, 112].map((y) => <line class="ap-arrow" x1="128" y1={y} x2={(cupX(y) + 6).toFixed(1)} y2={y} marker-end={`url(#${mA})`} />)}
			<text x="36" y="158">гладкая стена</text>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Стакан, полный воды, накрывают листом бумаги, прижимают лист ладонью и переворачивают. Руку убирают, а вода не выливается: воздух давит на бумагу снизу" data-glass>
			<text class="ap-title" x="190" y="22" text-anchor="end">Стакан и лист бумаги</text>
			<g data-gturn>
				<path class="ap-water" d="M74 54 L126 54 L120 132 L80 132 Z"></path>
				<path class="ap-glass" d="M70 50 L78 132 Q79 135 82 135 L118 135 Q121 135 122 132 L130 50"></path>
				<rect class="ap-paper" x="62" y="47" width="76" height="3" rx="1" data-paper></rect>
				<!-- the hand (the shared people kit) lies flat on the paper, the wrist to the right -->
				<g data-ghand></g>
			</g>
			<g data-garrows>
				{[80, 100, 120].map((x) => <line class="ap-arrow" x1={x} y1="166" x2={x} y2="142" marker-end={`url(#${mA})`} />)}
			</g>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Автопоилка: бутылка с водой перевёрнута горлышком в блюдце. Воздух давит на воду в блюдце, и вода из бутылки не выливается. Когда уровень опускается ниже горлышка, в бутылку проходит пузырёк воздуха">
			<text class="ap-title" x="190" y="22" text-anchor="end">Автопоилка</text>
			<!-- water in the bottle (an air pocket at the top) and in the dish -->
			<path class="ap-water" d="M80 46 L120 46 L120 94 Q120 100 112 104 L104 108 L104 146 L96 146 L96 108 L88 104 Q80 100 80 94 Z"></path>
			<rect class="ap-water" x="42" y="134" width="116" height="20"></rect>
			<path class="ap-glass" d="M106 148 L106 109 L112 106 Q122 102 122 94 L122 40 Q122 32 114 32 L86 32 Q78 32 78 40 L78 94 Q78 102 88 106 L94 109 L94 148"></path>
			<path class="ap-glass" d="M38 124 V152 q0 4 4 4 H158 q4 0 4 -4 V124"></path>
			<circle class="ap-bubble-s" cx="100" cy="146" r="3"></circle>
			{[56, 144].map((x) => <line class="ap-arrow" x1={x} y1="100" x2={x} y2="130" marker-end={`url(#${mA})`} />)}
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Уши в самолёте. Самолёт набирает высоту, давление в салоне падает, а воздух в среднем ухе выгибает барабанную перепонку наружу. Человек сглатывает, часть воздуха выходит из среднего уха через слуховую трубу, давления выравниваются, и перепонка снова плоская" data-ears>
			<defs>
				<clipPath id={`apec-${uid}`}><circle cx="132" cy="96" r="54"></circle></clipPath>
			</defs>
			<text class="ap-title" x="190" y="22" text-anchor="end">Уши в самолёте</text>
			<text class="ap-small" x="8" y="40">в салоне <tspan class="ap-t-hl" data-cabin>760 мм рт. ст.</tspan></text>
			<text class="ap-small" x="8" y="55" data-step>на земле</text>
			<!-- the passenger in a seat -->
			<rect class="ap-seat" x="6" y="92" width="14" height="80" rx="5"></rect>
			<g data-passenger></g>
			<line class="ap-callout" x1="38" y1="99" x2="88" y2="64"></line>
			<line class="ap-callout" x1="38" y1="111" x2="88" y2="128"></line>
			<!-- the enlarged section of the ear -->
			<circle class="ap-inset" cx="132" cy="96" r="54"></circle>
			<g clip-path={`url(#apec-${uid})`}>
				<path class="ap-tissue" d="M70 30 H200 V170 H70 Z M70 84 H128 V108 H70 Z M131 70 Q156 66 162 84 Q166 104 152 114 L131 110 Z" fill-rule="evenodd"></path>
				<g data-canal></g>
				<g data-mid></g>
				<path class="ap-drum" data-drum></path>
				<path class="ap-tube" data-etube></path>
				<g data-earrows></g>
			</g>
			<circle class="ap-inset-ring" cx="132" cy="96" r="54"></circle>
			<text class="ap-small" x="132" y="166" text-anchor="middle">перепонка</text>
			<line class="ap-callout" x1="130" y1="156" x2="130" y2="112"></line>
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>
			Синие стрелки — давление воздуха: он вталкивает жидкость в шприц и в пипетку, прижимает присоску к стене, держит воду в перевёрнутом стакане и в бутылке автопоилки. В самолёте давление в салоне падает, и воздух в среднем ухе выгибает перепонку, пока, сглотнув, мы не выровняем давления (изгиб перепонки сильно увеличен).
		</figcaption>
	</div>
</figure>

<style is:global>
	@media (max-width: 40rem) {
		.ap-pic--four .ap-pic__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.5rem;
		}
	}
	.ap-needle {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.ap-syr-piston {
		animation: ap-piston 4.5s ease-in-out infinite;
	}
	.ap-syr-liq {
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: ap-syrliq 4.5s ease-in-out infinite;
	}
	@keyframes ap-piston {
		0%,
		12% {
			transform: translateY(46px);
		}
		62%,
		90% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(46px);
		}
	}
	@keyframes ap-syrliq {
		0%,
		12% {
			transform: scaleY(0.061);
		}
		62%,
		90% {
			transform: scaleY(1);
		}
		100% {
			transform: scaleY(0.061);
		}
	}
	.ap-bubble {
		fill: color-mix(in srgb, var(--sl-color-white) 30%, transparent);
		stroke: var(--sl-color-white);
		stroke-width: 1;
	}
	.ap-bulb {
		fill: hsl(355, 60%, 55%);
		stroke: var(--ah-line);
		stroke-width: 1;
	}
	.ap-pic .ap-small {
		font-size: 11px;
	}
	.ap-seat {
		fill: var(--sl-color-gray-4);
	}
	.ap-callout {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.ap-inset {
		fill: var(--ig-surface);
	}
	.ap-inset-ring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	.ap-tissue {
		fill: color-mix(in oklab, hsl(10, 55%, 62%) 55%, var(--sl-color-gray-5));
	}
	.ap-drum {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.ap-tube {
		fill: none;
		stroke: var(--ig-surface);
		stroke-linecap: round;
	}
	.ap-tube-line {
		stroke: var(--ah-line);
	}
	.ap-wall {
		fill: var(--sl-color-gray-5);
	}
	.ap-tile {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ap-cup {
		fill: color-mix(in srgb, var(--ig-vy) 30%, transparent);
		stroke: var(--ig-vy);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.ap-paper {
		fill: var(--sl-color-gray-1);
	}
	.ap-bubble-s {
		fill: color-mix(in srgb, var(--sl-color-white) 30%, transparent);
		stroke: var(--sl-color-white);
		stroke-width: 1;
		animation: ap-bubble 3.5s ease-in infinite;
	}
	@keyframes ap-bubble {
		0%,
		55% {
			transform: translateY(0);
			opacity: 0;
		}
		60% {
			opacity: 1;
		}
		92% {
			transform: translateY(-96px);
			opacity: 1;
		}
		100% {
			transform: translateY(-100px);
			opacity: 0;
		}
	}
</style>

<script>
	import { loop } from '@components/intro/scene';
	import { ROLL } from '@components/people/hand';
	import { kitArm } from './kitArm';
	import { figure } from '@components/people/body';
	import { SKELETON } from '@components/people/core';

	const NS = 'http://www.w3.org/2000/svg';
	const ease = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
	const seg = (t: number, a: number, b: number) => ease((t - a) / (b - a));
	const mk = <K extends keyof SVGElementTagNameMap>(parent: Element, tag: K, attrs: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent.append(e);
		return e;
	};
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-atmuses]')) {
		const marker = root.querySelector('marker')!.id;

		// ---------- the dropper: 5 s ----------
		const pip = root.querySelector<SVGSVGElement>('[data-pip]')!;
		const bulb = pip.querySelector<SVGPathElement>('[data-bulb]')!;
		const liq = pip.querySelector<SVGPathElement>('[data-pipliq]')!;
		const fingers = pip.querySelector<SVGGElement>('[data-fingers]')!;
		const bubG = pip.querySelector<SVGGElement>('[data-bubbles]')!;
		// the hand (the shared people kit, 8 см long, drawn large like the dropper) holds the bulb in its fingers and
		// squeezes it: the grip closes with the bulb, the forearm goes down to the right
		const LH = 44;
		const hold = kitArm(fingers, { Lh: LH, side: 'R', sleeve: 'ah-kit-red' });
		const bubbles = Array.from({ length: 4 }, () => mk(bubG, 'circle', { class: 'ap-bubble', r: 2 }));
		const PX = 86;
		const hw = (y: number) => (y <= 126 ? 6 : 6 - (4 * (y - 126)) / 20); // inner half-width of the dropper
		const drawPip = (t: number) => {
			// s: squeeze (1 = pressed flat), L: share of the liquid drawn up
			let s = 1;
			let L = 0;
			if (t < 1.5) {
				s = 1 - seg(t, 0, 1.5);
				L = seg(t, 0.1, 1.5);
			} else if (t < 3) {
				s = 0;
				L = 1;
			} else if (t < 4) {
				s = seg(t, 3, 4);
				L = 1 - seg(t, 3, 3.75);
			}
			const bw = 11 - 6 * s;
			bulb.setAttribute('d', `M${PX - 6} 66 C${f1(PX - bw - 2)} 62 ${f1(PX - bw)} 40 ${PX} 34 C${f1(PX + bw)} 40 ${f1(PX + bw + 2)} 62 ${PX + 6} 66 Z`);
			const ly = 146 - 50 * L;
			if (L > 0.01) {
				const w = hw(ly);
				liq.setAttribute('d', `M${f1(PX - w)} ${f1(ly)} H${f1(PX + w)} ${ly < 126 ? `V126 L${PX + 2} 146 H${PX - 2} L${PX - 6} 126 Z` : `L${PX + 2} 146 H${PX - 2} Z`}`);
			} else liq.setAttribute('d', '');
			hold({ at: { x: PX, y: 52 }, pose: 'grip', d: (2 * bw + 1) / LH, dir: Math.PI, roll: ROLL.backViewer, bend: 0.3 });
			// air bubbles leave the tip while the bulb is pressed on an empty dropper
			bubbles.forEach((b, i) => {
				const tb = t - 3.75 - i * 0.22;
				const on = tb > 0 && tb < 0.9;
				b.style.opacity = on ? '1' : '0';
				if (on) {
					b.setAttribute('cx', f1(PX + Math.sin(tb * 9 + i) * 1.5));
					b.setAttribute('cy', f1(146 - 18 * Math.min(1, tb / 0.9)));
				}
			});
		};

		// ---------- the glass and the paper: 8 s ----------
		const glass = root.querySelector<SVGSVGElement>('[data-glass]')!;
		const turn = glass.querySelector<SVGGElement>('[data-gturn]')!;
		const paper = glass.querySelector<SVGRectElement>('[data-paper]')!;
		const ghand = glass.querySelector<SVGGElement>('[data-ghand]')!;
		// the passenger: a grown-up of 1,7 м seated facing right, the head (radius 21 px) at (40, 104); the rest of the
		// body is below the picture, the hands rest in the lap
		{
			const pg = root.querySelector<SVGGElement>('[data-ears] [data-passenger]')!;
			const sk = SKELETON.adult;
			const s = 21 / (sk.headR * 170);
			const u = s * 170;
			const fig = figure(pg, { s, H: 170, clothes: 'indoor', shirt: 'ah-kit-green', hair: 'short', name: 'passenger' });
			const hip = { x: 40 - 0.1 * sk.depth * u, y: 104 + sk.headC * u };
			fig.pose({
				hip,
				lean: 0,
				ankles: [
					{ x: hip.x + 0.24 * u, y: hip.y + 0.235 * u },
					{ x: hip.x + 0.22 * u, y: hip.y + 0.235 * u },
				],
				feet: [0, 0],
				hands: [
					{ arm: [1.75, 0.9], pose: 'relaxed' },
					{ arm: [1.8, 0.9], pose: 'relaxed' },
				],
			});
			// a straight mouth: the ears hurt
			pg.querySelector('.hm-mouth')?.setAttribute('d', `M${(0.62 * sk.headR * u).toFixed(1)} ${(0.62 * sk.headR * u).toFixed(1)} L${(0.86 * sk.headR * u).toFixed(1)} ${(0.6 * sk.headR * u).toFixed(1)}`);
		}
		// a hand 11 см long (60 px), the middle of the palm on the paper (its top at y = 47)
		kitArm(ghand, { Lh: 60, side: 'R', sleeve: 'ah-kit-red' })({ at: { x: 107, y: 47 }, pose: 'flat', dir: Math.PI, roll: ROLL.palmCcw + 0.35 });
		const garrows = glass.querySelector<SVGGElement>('[data-garrows]')!;
		const drawGlass = (t: number) => {
			const pIn = seg(t, 0, 0.8);
			paper.setAttribute('transform', `translate(0 ${f1(-18 * (1 - pIn))})`);
			paper.style.opacity = String(pIn);
			const hIn = seg(t, 0.8, 1.5);
			const hOut = seg(t, 3.4, 4.2);
			ghand.setAttribute('transform', `translate(0 ${f1(-30 * (1 - hIn) - 30 * hOut)})`);
			ghand.style.opacity = String(hIn * (1 - hOut));
			turn.setAttribute('transform', `rotate(${f1(180 * seg(t, 1.6, 3.2))} 100 92)`);
			garrows.style.opacity = String(seg(t, 4.2, 4.8));
		};

		// ---------- the ears in a climbing airliner: 10 s ----------
		const ears = root.querySelector<SVGSVGElement>('[data-ears]')!;
		const cabin = ears.querySelector<SVGTSpanElement>('[data-cabin]')!;
		const step = ears.querySelector<SVGTextElement>('[data-step]')!;
		const drum = ears.querySelector<SVGPathElement>('[data-drum]')!;
		const etube = ears.querySelector<SVGPathElement>('[data-etube]')!;
		const canalG = ears.querySelector<SVGGElement>('[data-canal]')!;
		const midG = ears.querySelector<SVGGElement>('[data-mid]')!;
		const arG = ears.querySelector<SVGGElement>('[data-earrows]')!;
		const tubeLine = mk(ears.querySelector('g[clip-path]')!, 'path', { class: 'ap-tube-line', d: 'M144 114 L120 154', 'stroke-width': 1.2 });
		ears.querySelector('g[clip-path]')!.insertBefore(tubeLine, etube);
		let seed = 9;
		const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
		const canalDots = Array.from({ length: 14 }, () => ({ c: mk(canalG, 'circle', { class: 'ap-dot', r: 1.4 }), x: 82 + rnd() * 40, y: 88 + rnd() * 16, ph: rnd() * 6 }));
		const midDots = Array.from({ length: 10 }, () => {
			const a = rnd() * 6.28;
			const r = Math.sqrt(rnd()) * 12;
			return { c: mk(midG, 'circle', { class: 'ap-dot', r: 1.4 }), x: 148 + r * Math.cos(a), y: 91 + r * Math.sin(a), ph: rnd() * 6 };
		});
		const arC = mk(arG, 'line', { class: 'ap-arrow', 'marker-end': `url(#${marker})` });
		const arM = mk(arG, 'line', { class: 'ap-arrow', 'marker-end': `url(#${marker})` });
		const STEPS = ['на земле', 'взлетаем', 'уши заложило', 'сглотнули', 'давления равны'];
		const drawEars = (t: number) => {
			const pc = 760 - 190 * seg(t, 0.8, 5);
			const open = t > 5.6 && t < 7 ? Math.sin((Math.PI * (t - 5.6)) / 1.4) : 0;
			const pm = t < 5.6 ? 760 : 570 + 190 * Math.exp(-6 * Math.max(0, t - 5.6));
			const b = (9 * (pm - pc)) / 190; // the bow of the eardrum into the ear canal, px (greatly enlarged)
			drum.setAttribute('d', `M130 84 Q${f1(130 - 2 * b)} 96 130 108`);
			etube.setAttribute('stroke-width', f1(5 * open));
			etube.setAttribute('d', 'M144 114 L120 154');
			const nC = Math.round((14 * pc) / 760);
			canalDots.forEach((d, i) => {
				d.c.style.opacity = i < nC ? '1' : '0';
				d.c.setAttribute('cx', f1(Math.min(d.x + Math.sin(t * 2 + d.ph), 126 - b - 2)));
				d.c.setAttribute('cy', f1(d.y + Math.cos(t * 1.7 + d.ph)));
			});
			const nM = Math.round((10 * pm) / 760);
			midDots.forEach((d, i) => {
				d.c.style.opacity = i < nM ? '1' : '0';
				d.c.setAttribute('cx', f1(d.x + Math.sin(t * 2.2 + d.ph)));
				d.c.setAttribute('cy', f1(d.y + Math.cos(t * 1.9 + d.ph)));
			});
			const lc = 6 + (14 * pc) / 760;
			arC.setAttribute('x1', f1(126 - b - 3 - lc));
			arC.setAttribute('x2', f1(126 - b - 3));
			arC.setAttribute('y1', '96');
			arC.setAttribute('y2', '96');
			const lm = 6 + (14 * pm) / 760;
			arM.setAttribute('x1', f1(135 - b * 0.5 + lm));
			arM.setAttribute('x2', f1(135 - b * 0.5));
			arM.setAttribute('y1', '102');
			arM.setAttribute('y2', '102');
			cabin.textContent = `${Math.round(pc)}\u00a0мм рт. ст.`;
			const k = t < 0.8 ? 0 : t < 5 ? 1 : t < 5.6 ? 2 : t < 7 ? 3 : 4;
			if (step.textContent !== STEPS[k]) step.textContent = STEPS[k];
		};

		let t = 0;
		const draw = () => {
			drawPip(t % 5);
			drawGlass(t % 8);
			drawEars(t % 10);
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
