---
/**
 * Small pictures to «Где это встречается»: a syringe (the piston goes up, the liquid follows it: CSS loop), a suction
 * cup on a wall (almost no air under it), a glass of water turned over on a sheet of paper, a bird drinker (a bottle
 * upside down in a dish; an air bubble goes up when the water no longer covers the neck: CSS loop). Blue arrows: the
 * air presses.
 */
import AtmStyles from './AtmStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `apu-${uid}`;
let seed = 3;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
// air dots around the suction cup (outside only)
const cupDots: [number, number][] = [];
while (cupDots.length < 26) {
	const x = 36 + rnd() * 158;
	const y = 30 + rnd() * 134;
	const inCup = ((x - 30) / 40) ** 2 + ((y - 92) / 36) ** 2 < 1;
	const nearArrows = ((Math.abs(y - 72) < 7 || Math.abs(y - 112) < 7) && x < 130) || (y > 144 && x < 136);
	if (inCup || nearArrows || (x > 60 && x < 90 && Math.abs(y - 92) < 8)) continue;
	cupDots.push([Math.round(x), Math.round(y)]);
}
const cupX = (y: number) => 30 + 34 * Math.sqrt(Math.max(0, 1 - ((y - 92) / 30) ** 2));
---

<AtmStyles />
<figure class="ap-pic ap-pic--four not-content">
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Шприц: поршень поднимают, и жидкость из стакана поднимается в шприц вслед за поршнем. Воздух давит на жидкость в стакане">
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="ap-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<text class="ap-title" x="190" y="22" text-anchor="end">Шприц</text>
			<!-- beaker -->
			<rect class="ap-water" x="42" y="128" width="88" height="31"></rect>
			<path class="ap-glass" d="M40 104 V158 q0 3 3 3 H129 q3 0 3 -3 V104"></path>
			<!-- syringe -->
			<line class="ap-needle" x1="86" y1="120" x2="86" y2="150"></line>
			<rect class="ap-water ap-syr-liq" x="78" y="71" width="16" height="49"></rect>
			<rect class="ap-glass" x="76" y="56" width="20" height="66" rx="2"></rect>
			<line class="ap-line" x1="70" y1="58" x2="102" y2="58" style="stroke-width: 3"></line>
			<g class="ap-syr-piston">
				<rect class="ap-metal" x="78" y="66" width="16" height="5"></rect>
				<line class="ap-line" x1="86" y1="66" x2="86" y2="32" style="stroke-width: 3"></line>
				<line class="ap-line" x1="76" y1="32" x2="96" y2="32" style="stroke-width: 4"></line>
			</g>
			{[54, 116].map((x) => <line class="ap-arrow" x1={x} y1="96" x2={x} y2="124" marker-end={`url(#${mA})`} />)}
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Присоска на гладкой стене. Под присоской воздуха почти нет, а воздух снаружи прижимает её к стене">
			<text class="ap-title" x="190" y="22" text-anchor="end">Присоска</text>
			<rect class="ap-wall" x="0" y="0" width="30" height="170"></rect>
			{[28, 56, 84, 112, 140].map((y) => <line class="ap-tile" x1="0" y1={y} x2="30" y2={y} />)}
			{cupDots.map(([x, y]) => <circle class="ap-dot" cx={x} cy={y} r="1.5" />)}
			<circle class="ap-dot" cx="38" cy="86" r="1.5"></circle>
			<path class="ap-cup" d="M30 60 Q70 62 64 92 Q70 122 30 124"></path>
			<line class="ap-line" x1="64" y1="92" x2="80" y2="92" style="stroke-width: 4"></line>
			<path class="ap-line" d="M80 92 q8 0 8 9 q0 7 -6 7" style="stroke-width: 2.4"></path>
			{[72, 112].map((y) => <line class="ap-arrow" x1="128" y1={y} x2={(cupX(y) + 6).toFixed(1)} y2={y} marker-end={`url(#${mA})`} />)}
			<text x="36" y="158">гладкая стена</text>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Перевёрнутый стакан с водой, накрытый листом бумаги. Воздух давит на бумагу снизу и удерживает воду">
			<text class="ap-title" x="190" y="22" text-anchor="end">Стакан и лист бумаги</text>
			<path class="ap-water" d="M74 34 L126 34 L134 116 L66 116 Z"></path>
			<path class="ap-glass" d="M64 118 L72 32 Q73 30 76 30 L124 30 Q127 30 128 32 L136 118"></path>
			<rect class="ap-paper" x="54" y="117" width="92" height="4" rx="1"></rect>
			{[76, 100, 124].map((x) => <line class="ap-arrow" x1={x} y1="160" x2={x} y2="128" marker-end={`url(#${mA})`} />)}
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 200 170" role="img" aria-label="Автопоилка: бутылка с водой перевёрнута горлышком в блюдце. Воздух давит на воду в блюдце, и вода из бутылки не выливается. Когда уровень опускается ниже горлышка, в бутылку проходит пузырёк воздуха">
			<text class="ap-title" x="190" y="22" text-anchor="end">Автопоилка</text>
			<!-- water in the bottle (an air pocket at the top) and in the dish -->
			<path class="ap-water" d="M80 46 L120 46 L120 94 Q120 100 112 104 L104 108 L104 146 L96 146 L96 108 L88 104 Q80 100 80 94 Z"></path>
			<rect class="ap-water" x="42" y="134" width="116" height="20"></rect>
			<path class="ap-glass" d="M106 148 L106 109 L112 106 Q122 102 122 94 L122 40 Q122 32 114 32 L86 32 Q78 32 78 40 L78 94 Q78 102 88 106 L94 109 L94 148"></path>
			<path class="ap-glass" d="M38 124 V152 q0 4 4 4 H158 q4 0 4 -4 V124"></path>
			<circle class="ap-bubble-s" cx="100" cy="146" r="3"></circle>
			{[56, 144].map((x) => <line class="ap-arrow" x1={x} y1="100" x2={x} y2="130" marker-end={`url(#${mA})`} />)}
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>
			Синие стрелки — давление воздуха. Поршень шприца поднимают, и жидкость вталкивает в шприц воздух, давящий на жидкость в стакане. Под присоской воздуха почти нет. Давление воздуха на бумагу снизу удерживает воду в стакане. Из автопоилки вода вытекает, только когда её уровень в блюдце опустится ниже горлышка.
		</figcaption>
	</div>
</figure>

<style is:global>
	@media (max-width: 40rem) {
		.ap-pic--four .ap-pic__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.5rem;
		}
	}
	.ap-needle {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.ap-syr-piston {
		animation: ap-piston 4.5s ease-in-out infinite;
	}
	.ap-syr-liq {
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: ap-syrliq 4.5s ease-in-out infinite;
	}
	@keyframes ap-piston {
		0%,
		12% {
			transform: translateY(46px);
		}
		62%,
		90% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(46px);
		}
	}
	@keyframes ap-syrliq {
		0%,
		12% {
			transform: scaleY(0.061);
		}
		62%,
		90% {
			transform: scaleY(1);
		}
		100% {
			transform: scaleY(0.061);
		}
	}
	.ap-wall {
		fill: var(--sl-color-gray-5);
	}
	.ap-tile {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ap-cup {
		fill: color-mix(in srgb, var(--ig-vy) 30%, transparent);
		stroke: var(--ig-vy);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.ap-paper {
		fill: var(--sl-color-gray-1);
	}
	.ap-bubble-s {
		fill: color-mix(in srgb, var(--sl-color-white) 30%, transparent);
		stroke: var(--sl-color-white);
		stroke-width: 1;
		animation: ap-bubble 3.5s ease-in infinite;
	}
	@keyframes ap-bubble {
		0%,
		55% {
			transform: translateY(0);
			opacity: 0;
		}
		60% {
			opacity: 1;
		}
		92% {
			transform: translateY(-96px);
			opacity: 1;
		}
		100% {
			transform: translateY(-100px);
			opacity: 0;
		}
	}
</style>
