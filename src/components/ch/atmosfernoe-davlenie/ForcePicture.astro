---
/**
 * Picture to «Сила атмосферного давления», two panels.
 * Left: the air presses on every square meter with about 101 300 Н (normal pressure). Next to the square meter under
 *   the air, the same square meter carries an iron block 1 × 1 × 1,3 м: m = 7800 кг/м³ · 1,3 м³ = 10 140 кг ≈ 10 т,
 *   weight ≈ 99 400 Н, about the force of the air (101 300 Н / 9,8 Н/кг ≈ 10 300 кг); hence «≈» between them. Oblique drawing, 60 px per
 *   meter for the plates and the block; the air column is drawn only up to the top of the panel (the atmosphere is
 *   many kilometers high). The air dots move.
 * Right: a hand held flat, seen from the side. The air presses on it from above and from below with the same force;
 *   inside the hand the pressure is the same. The arrows above and below are equal; the dots of the air move. No
 *   numbers here: the force on the palm is task 6 of «Проверьте себя».
 */
import AtmStyles from './AtmStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `afa-${uid}`;
// oblique plates: front edge W, the depth goes up and right by (DX, DY)
const W = 60;
const DX = 26;
const DY = -14;
const plate = (x: number, y: number) =>
	`M${x} ${y} H${x + W} L${x + W + DX} ${y + DY} H${x + DX} Z M${x} ${y} V${y + 5} H${x + W} L${x + W + DX} ${y + DY + 5} V${y + DY}`;
const P1 = { x: 22, y: 196 };
const P2 = { x: 136, y: 196 };
const HB = 78; // 1,3 м
const block = {
	front: `M${P2.x} ${P2.y} V${P2.y - HB} H${P2.x + W} V${P2.y} Z`,
	top: `M${P2.x} ${P2.y - HB} L${P2.x + DX} ${P2.y - HB + DY} H${P2.x + W + DX} L${P2.x + W} ${P2.y - HB} Z`,
	side: `M${P2.x + W} ${P2.y} V${P2.y - HB} L${P2.x + W + DX} ${P2.y - HB + DY} V${P2.y + DY} Z`,
};
const handDots: [number, number][] = [];
let seed = 5;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
while (handDots.length < 40) {
	const x = 10 + rnd() * 220;
	const y = 30 + rnd() * 190;
	if (x > 60 && x < 230 && y > 96 && y < 150) continue;
	if (x > 66 && x < 176 && (y < 96 && y > 52 || y > 150 && y < 196)) continue;
	handDots.push([Math.round(x), Math.round(y)]);
}
const colDots: [number, number][] = [];
while (colDots.length < 26) colDots.push([P1.x + 4 + rnd() * (W + DX - 8), 36 + rnd() * 140]);
const arrowsX = [92, 116, 140];
---

<AtmStyles />
<figure class="ap-pic not-content" data-atmforce>
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 0 240 230" role="img" aria-label="Слева квадратный метр, на который давит весь столб воздуха над ним, с силой около 101 300 ньютонов. Справа такой же квадратный метр, на котором стоит железный брусок 1 на 1 на 1,3 метра массой около 10 тонн: он давит почти с такой же силой">
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto">
					<path class="ap-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<rect class="ap-earth" x="0" y="200" width="240" height="30"></rect>
			<!-- the air column above the first square meter -->
			<path class="af-col" d={`M${P1.x} ${P1.y} V20 M${P1.x + W} ${P1.y} V20 M${P1.x + W + DX} ${P1.y + DY} V20`}></path>
			<g data-coldots>{colDots.map(([x, y]) => <circle class="ap-dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r="1.5" />)}</g>
			<path class="af-plate" d={plate(P1.x, P1.y)}></path>
			<line class="af-big" x1={P1.x + 20} y1="60" x2={P1.x + 20} y2={P1.y - 12} marker-end={`url(#${mA})`}></line>
			<text class="ap-t-air" x={P1.x + 4} y="16">воздух</text>
			<!-- the iron block on the second square meter -->
			<path class="af-plate" d={plate(P2.x, P2.y)}></path>
			<path class="af-iron" d={block.side}></path>
			<path class="af-iron af-iron--top" d={block.top}></path>
			<path class="af-iron af-iron--front" d={block.front}></path>
			<text class="af-on" x={P2.x + W / 2} y={P2.y - HB / 2 + 5} text-anchor="middle">≈ 10 т</text>
			<text x={P2.x + 2} y={P2.y - HB - 36}>железо</text>
			<text class="af-dim" x={P2.x + 2} y={P2.y - HB - 22}>1 × 1 × 1,3 м</text>
			<text class="af-dim" x={P2.x + W / 2} y="222" text-anchor="middle">1 м²</text>
			<text class="af-dim" x={P1.x + W / 2} y="222" text-anchor="middle">1 м²</text>
			<text class="ap-t-hl af-eq" x="122" y="140" text-anchor="middle">≈</text>
			<text class="af-f" x={P1.x + 28} y="112" text-anchor="start">101 300 Н</text>
		</svg>
		<svg class="ap-pic__svg" viewBox="0 0 240 230" role="img" aria-label="Ладонь, вид сбоку. Воздух давит на неё сверху и снизу с одинаковой силой, а внутри руки давление такое же">
			<g data-handdots>{handDots.map(([x, y]) => <circle class="ap-dot" cx={x} cy={y} r="1.5" />)}</g>
			<!-- the hand (the shared people kit), held flat, palm down, the fingers to the left -->
			<g data-flathand></g>
			{arrowsX.map((x) => <line class="ap-arrow" x1={x} y1="62" x2={x} y2="104" marker-end={`url(#${mA})`} />)}
			{arrowsX.map((x) => <line class="ap-arrow" x1={x + 6} y1="182" x2={x + 6} y2="142" marker-end={`url(#${mA})`} />)}
			<text class="ap-t-air" x="120" y="44" text-anchor="middle">воздух давит сверху</text>
			<text class="ap-t-air" x="124" y="206" text-anchor="middle">и так же снизу</text>
			<text class="af-small" x="234" y="160" text-anchor="end">внутри руки</text>
			<text class="af-small" x="234" y="174" text-anchor="end">давление</text>
			<text class="af-small" x="234" y="188" text-anchor="end">такое же</text>
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>
			Слева: на каждый квадратный метр воздух давит с силой около 101&nbsp;300&nbsp;Н — примерно столько весит железный брусок 1&nbsp;×&nbsp;1&nbsp;×&nbsp;1,3&nbsp;м массой около 10&nbsp;т. Справа: на ладонь воздух давит сверху и снизу с одинаковой силой, а внутри руки давление такое же, поэтому мы этого не чувствуем.
		</figcaption>
	</div>
</figure>

<style is:global>
	.af-col {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
		opacity: 0.8;
	}
	.af-plate {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 60%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.af-big {
		stroke: var(--ig-vx);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.ap-pic .af-eq {
		font-size: 24px;
	}
	.af-iron {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.af-iron--top {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-3));
	}
	.af-iron--front {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-5));
	}
	.ap-pic .af-on {
		font-weight: 700;
		fill: var(--sl-color-white);
		stroke: none;
	}
	.ap-pic .af-dim {
		font-size: 11px;
		fill: var(--sl-color-gray-1);
		stroke: none;
	}
	.ap-pic .af-f {
		font-size: 12px;
		font-weight: 700;
		fill: var(--ig-vx);
	}
	.ap-pic .af-small {
		font-size: 11.5px;
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { loop } from '@components/intro/scene';
	import { ROLL } from '@components/people/hand';
	import { kitArm } from './kitArm';

	// the flat hand: 18 см long (97 px), the middle of the palm at (131, 120)
	for (const g of document.querySelectorAll<SVGGElement>('[data-atmforce] [data-flathand]')) {
		kitArm(g, { Lh: 97, side: 'R', sleeve: 'ah-kit-green' })({ at: { x: 131, y: 120 }, pose: 'flat', dir: Math.PI, roll: ROLL.palmCcw + 0.35 });
	}

	// the dots of the air jiggle around their places
	for (const root of document.querySelectorAll<HTMLElement>('[data-atmforce]')) {
		const dots = Array.from(root.querySelectorAll<SVGCircleElement>('circle.ap-dot')).map((c, i) => ({
			c,
			x: Number(c.getAttribute('cx')),
			y: Number(c.getAttribute('cy')),
			ph: i * 1.37,
		}));
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			for (const d of dots) {
				d.c.setAttribute('cx', (d.x + 1.6 * Math.sin(t * 2.1 + d.ph)).toFixed(1));
				d.c.setAttribute('cy', (d.y + 1.6 * Math.cos(t * 1.7 + d.ph * 1.3)).toFixed(1));
			}
			return true;
		});
	}
</script>
