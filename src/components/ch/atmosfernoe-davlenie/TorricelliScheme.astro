---
/**
 * Scheme of Torricelli's tube for the derivation. When it stands inside a <Derivation>,
 * its parts light up together with the steps (step n shows the parts with data-from ≤ n).
 * Without JavaScript everything is visible.
 */
const uid = `tsc-${Math.random().toString(36).slice(2, 8)}`;
const surf = 236;
const top = 46;
const col = 92;
const arrows = [60, 92, 268, 300];
---

<figure class="tsc not-content" data-tsc>
	<svg viewBox="0 0 360 290" role="img" aria-label="Трубка Торричелли: точки A и B на одном уровне, высота столба h">
		<defs>
			<linearGradient id={`${uid}-hg`} x1="0" x2="1">
				<stop offset="0" class="tsc__hg-edge"></stop>
				<stop offset="0.45" class="tsc__hg-mid"></stop>
				<stop offset="1" class="tsc__hg-edge"></stop>
			</linearGradient>
			<marker id={`${uid}-ar`} class="tsc__head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
				<path d="M0,0 L10,5 L0,10 z"></path>
			</marker>
			<marker id={`${uid}-dim`} class="tsc__dimhead" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M0,1 L10,5 L0,9 z"></path>
			</marker>
		</defs>

		<!-- dish -->
		<path class="tsc__liquid" style={`fill:url(#${uid}-hg)`} d={`M42 ${surf}V270q0 8 8 8H310q8 0 8 -8V${surf}Z`}></path>
		<path class="tsc__glass" d={`M42 214V270q0 8 8 8H310q8 0 8 -8V214`}></path>

		<!-- tube -->
		<rect class="tsc__vacuum" x="171" y={top} width="18" height={col - top} data-from="1"></rect>
		<rect class="tsc__liquid" style={`fill:url(#${uid}-hg)`} x="171" y={col} width="18" height={surf - col + 22}></rect>
		<path class="tsc__glass" d={`M168 ${surf + 22}V${top + 3}a12 12 0 0 1 24 0V${surf + 22}`}></path>
		<text class="tsc__label tsc__label--it" x="200" y={top + 26} data-from="1">пустота</text>

		<!-- atmospheric pressure on the mercury in the dish -->
		<g class="tsc__air" data-from="3">
			{arrows.map((x) => <line x1={x} y1={surf - 54} x2={x} y2={surf - 6} marker-end={`url(#${uid}-ar)`}></line>)}
			<text class="tsc__label tsc__label--air" x="76" y={surf - 62} text-anchor="middle">
				<tspan class="tsc__it">p</tspan><tspan class="tsc__sub" dy="4">атм</tspan>
			</text>
			<text class="tsc__label tsc__label--air" x="284" y={surf - 62} text-anchor="middle">
				<tspan class="tsc__it">p</tspan><tspan class="tsc__sub" dy="4">атм</tspan>
			</text>
		</g>

		<!-- one level: A inside the tube, B outside -->
		<g data-from="2">
			<line class="tsc__level" x1="110" y1={surf} x2="250" y2={surf}></line>
			<circle class="tsc__point" cx="180" cy={surf} r="5"></circle>
			<circle class="tsc__point" cx="236" cy={surf} r="5"></circle>
			<text class="tsc__label tsc__label--pt" x="160" y={surf + 20}>A</text>
			<text class="tsc__label tsc__label--pt" x="240" y={surf + 20}>B</text>
		</g>

		<!-- column height -->
		<g class="tsc__dim" data-from="4">
			<line x1="150" y1={col} x2="150" y2={surf} marker-start={`url(#${uid}-dim)`} marker-end={`url(#${uid}-dim)`}></line>
			<line class="tsc__ext" x1="144" y1={col} x2="170" y2={col}></line>
			<text class="tsc__label tsc__it tsc__label--h" x="132" y={(col + surf) / 2 + 6} text-anchor="middle">h</text>
		</g>
	</svg>
</figure>

<style is:global>
	.tsc {
		--tsc-hg-edge: var(--sl-color-gray-3);
		--tsc-hg-mid: var(--sl-color-gray-1);
		margin: 0.75rem auto;
		max-width: 24rem;
	}
	:root[data-theme='light'] .tsc {
		--tsc-hg-mid: var(--sl-color-gray-5);
	}
	.tsc svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.tsc__hg-edge {
		stop-color: var(--tsc-hg-edge);
	}
	.tsc__hg-mid {
		stop-color: var(--tsc-hg-mid);
	}
	.tsc__glass {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.tsc__vacuum {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
	}
	.tsc__label {
		fill: var(--sl-color-gray-2);
		font-family: var(--__sl-font);
		font-size: 15px;
	}
	.tsc__label--it,
	.tsc__it {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.tsc__label--it {
		font-family: var(--__sl-font);
	}
	.tsc__label--pt {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 19px;
		fill: var(--sl-color-white);
	}
	.tsc__label--h {
		font-size: 22px;
		fill: var(--ig-v);
	}
	.tsc__label--air {
		fill: var(--ig-vx);
		font-size: 19px;
	}
	.tsc__sub {
		font-size: 12px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
	.tsc__air line {
		stroke: var(--ig-vx);
		stroke-width: 2.5;
	}
	.tsc__head path {
		fill: var(--ig-vx);
	}
	.tsc__level {
		stroke: var(--sl-color-white);
		stroke-width: 1.3;
		stroke-dasharray: 5 4;
	}
	.tsc__point {
		fill: var(--ig-vy);
		stroke: var(--ig-surface);
		stroke-width: 2;
	}
	.tsc__dim line {
		stroke: var(--ig-v);
		stroke-width: 1.8;
	}
	.tsc__dim .tsc__ext {
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.tsc__dimhead path {
		fill: var(--ig-v);
	}
	.tsc [data-from] {
		transition: opacity 0.6s ease;
	}
	.tsc [data-from].is-off {
		opacity: 0;
	}
	.tsc [data-from].is-new {
		animation: tsc-glow 1.4s ease-out;
	}
	@keyframes tsc-glow {
		0%,
		40% {
			filter: drop-shadow(0 0 6px var(--ig-v));
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tsc [data-from] {
			transition: none;
		}
		.tsc [data-from].is-new {
			animation: none;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-tsc]')) {
		const der = root.closest<HTMLElement>('[data-derivation]');
		if (!der) continue;
		const parts = Array.from(root.querySelectorAll<SVGElement>('[data-from]'));
		let stage = -1;
		const update = () => {
			const steps = Array.from(der.querySelectorAll('.step'));
			const interactive = der.classList.contains('is-interactive');
			const shown = interactive ? steps.filter((s) => s.classList.contains('is-shown')).length : steps.length;
			if (shown === stage) return;
			const first = stage < 0;
			stage = shown;
			for (const p of parts) {
				const from = Number(p.dataset.from);
				const on = from <= shown;
				const wasOff = p.classList.contains('is-off');
				p.classList.toggle('is-off', !on);
				if (on && wasOff && !first) {
					p.classList.remove('is-new');
					void p.getBoundingClientRect();
					p.classList.add('is-new');
				}
			}
		};
		new MutationObserver(update).observe(der, { subtree: true, attributes: true, attributeFilter: ['class'] });
		update();
	}
</script>
