---
/**
 * Two short looping opening scenes of «Атмосферное давление». No terms of the chapter in the pictures; the captions'
 * popovers explain.
 * Straw: a glass of juice on a table and a bendy straw in it; a head in profile holds the straw in the lips. The air
 *   of the room (dots) presses on the juice in the glass (arrows). The mouth draws the air out of the straw (its dots
 *   rise and vanish, fewer stay inside), the juice rises up the straw to the mouth and flows; the level in the glass
 *   goes down. The pressure in the straw is lowered, the air of the room pushes the juice up.
 * Bottle: a mountain road from a pass at 3000 m down to the sea; a car descends. The inset shows the empty plastic
 *   bottle closed at the pass: outside air dots get denser as the car goes down (density ∝ pressure, standard
 *   atmosphere), the arrows of the outside air grow, and the soft walls give way until the air inside is as dense as
 *   outside: V/V₀ = p(3000 м)/p(h), 0,69 at sea level. The same 10 dots stay inside the bottle, so they get denser too.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mArrow = `ai-ar-${uid}`;
const clipIn = `ai-clip-${uid}`;

// Straw scene: the glass (trapezoid) and the bendy straw.
const GT = 96; // top of the glass
const GB = 198; // inner bottom
const glassX = (y: number) => [140 + (8 * (y - GT)) / (GB - GT), 226 - (8 * (y - GT)) / (GB - GT)];
const [gl0, gr0] = glassX(GT);
const [gl1, gr1] = glassX(GB);
const STRAW = 'M200 194 L200 84 L244 46';

// Bottle scene: the mountain, the road and the inset.
const ROAD: [number, number][] = [
	[98, 46],
	[124, 80],
	[100, 100],
	[150, 128],
	[120, 150],
	[186, 184],
	[232, 214],
];
const roadD = ROAD.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
const IC = { x: 288, y: 104, r: 66 };
---

<IntroFrame data-atmintro>
	<div class="intro__card" data-scene="straw">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Стакан с соком и соломинка. Воздух комнаты давит на сок в стакане. Рот втягивает воздух из соломинки, и сок поднимается по ней ко рту, а уровень сока в стакане опускается">
			<defs>
				<marker id={mArrow} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="ai-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<rect class="ai-wall" x="0" y="0" width="360" height="200"></rect>
			<rect class="ai-table" x="0" y="200" width="360" height="40"></rect>
			<line class="ai-edge" x1="0" y1="200" x2="360" y2="200"></line>
			<g data-room></g>
			<!-- juice in the glass -->
			<path class="ai-juice" data-juice></path>
			<!-- the straw: the tube, the juice inside, the remaining air -->
			<path class="ai-straw" d={STRAW}></path>
			<path class="ai-straw-in" d={STRAW}></path>
			<path class="ai-straw-juice" d={STRAW} data-sjuice></path>
			<path class="ai-straw-flow" d={STRAW} data-sflow></path>
			<g data-sdots></g>
			<!-- the glass -->
			<path class="ai-glass" d={`M${gl0 - 3} ${GT} L${gl1 - 1} ${GB + 2} Q${gl1} ${GB + 4} ${gl1 + 3} ${GB + 4} L${gr1 - 3} ${GB + 4} Q${gr1} ${GB + 4} ${gr1 + 1} ${GB + 2} L${gr0 + 3} ${GT}`}></path>
			<!-- the air of the room presses on the juice -->
			<g class="ai-arrows" data-arrows>
				{[158, 180, 214].map((x) => (
					<line x1={x} x2={x} y1="80" y2="110" marker-end={`url(#${mArrow})`} />
				))}
			</g>
			<!-- the head in profile, lips on the straw -->
			<path class="ai-head-skin" d="M360 -4 L300 -4 Q270 -2 262 10 Q258 16 259 22 L248 33 Q246 36 250 37 L254 38 Q250 40 249 42 L250 44 Q246 46 249 49 Q252 52 256 51 Q256 58 262 64 Q270 74 284 78 L286 102 Q300 114 360 120 Z"></path>
			<path class="ai-lip" d="M249 42 Q251 46 249 49"></path>
			<circle class="ai-eye" cx="270" cy="20" r="2.4"></circle>
			<path class="ai-brow" d="M264 13 Q270 10 276 13"></path>
		</svg>
		<div class="intro__foot">
			<p>Кажется, что сок по соломинке тянет рот. На самом деле <More term="сок вталкивает в соломинку воздух">Втягивая воздух ртом, мы уменьшаем его давление в соломинке. А на сок в стакане по-прежнему давит воздух комнаты — сильнее, чем оставшийся в соломинке воздух. Он и вталкивает сок вверх, ко рту. Подробнее — в разделе <a href="#где-это-встречается">«Где это встречается»</a>.</More>, который давит на сок в стакане.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="bottle">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Горная дорога. Пустую пластиковую бутылку закрыли на перевале, и машина спускается к морю. Внизу воздух давит на бутылку сильнее, и её стенки сминаются">
			<defs>
				<clipPath id={clipIn}>
					<circle cx={IC.x} cy={IC.y} r={IC.r - 2}></circle>
				</clipPath>
				<marker id={`${mArrow}b`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="ai-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<rect class="ai-sky" x="0" y="0" width="360" height="214"></rect>
			<path class="ai-mount" d="M-10 214 L40 120 L62 128 L96 40 L130 92 L146 86 L236 214 Z"></path>
			<path class="ai-snow" d="M96 40 L84 70 L92 66 L98 74 L104 64 L111 66 Z"></path>
			<path class="ai-road" d={roadD}></path>
			<rect class="ai-ground" x="0" y="214" width="250" height="26"></rect>
			<path class="ai-sea" d="M236 214 Q244 218 250 214 L360 214 L360 240 L232 240 Z"></path>
			<path class="ai-wave" d="M262 226 q 8 -4 16 0 t 16 0 t 16 0 t 16 0 t 16 0"></path>
			<line class="ai-call" data-call x1="98" y1="46" x2={IC.x - IC.r} y2={IC.y}></line>
			<!-- the car -->
			<g data-car>
				<rect class="ai-car" x="-11" y="-11" width="22" height="8" rx="3"></rect>
				<path class="ai-car" d="M-6 -11 L-3 -16 L5 -16 L8 -11 Z"></path>
				<circle class="ai-wheel" cx="-6" cy="-2" r="2.6"></circle>
				<circle class="ai-wheel" cx="6" cy="-2" r="2.6"></circle>
			</g>
			<!-- the altitude -->
			<rect class="ai-pill" x="8" y="8" width="88" height="24" rx="12"></rect>
			<text class="ai-read" x="52" y="25" text-anchor="middle" data-alt>3000 м</text>
			<!-- the inset with the bottle -->
			<circle class="ai-inset" cx={IC.x} cy={IC.y} r={IC.r}></circle>
			<g clip-path={`url(#${clipIn})`}>
				<g data-out></g>
				<path class="ai-bottle" data-bottle></path>
				<g data-in></g>
				<path class="ai-crease" data-crease></path>
				<rect class="ai-cap" x={IC.x - 7} y="46" width="14" height="9" rx="2"></rect>
				<g class="ai-barrows" data-barrows></g>
			</g>
			<circle class="ai-inset-ring" cx={IC.x} cy={IC.y} r={IC.r}></circle>
		</svg>
		<div class="intro__foot">
			<p>Пустую пластиковую бутылку плотно закрыли на перевале высоко в горах. Пока машина спускалась к морю, бутылку смяло: <More term="внизу воздух давит сильнее">Чем ниже, тем больше воздуха над нами и тем сильнее он давит. На высоте 3000 м давление воздуха примерно на 30 % меньше, чем у моря. В бутылке остался воздух с перевала, а внизу наружный воздух давит сильнее и сжимает бутылку, пока воздух в ней не станет таким же плотным, как снаружи. Подробнее — в разделе <a href="#давление-и-высота">«Давление и высота»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.ai-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.ai-table {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.ai-edge {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.ai-dot {
		fill: var(--sl-color-gray-3);
	}
	.ai-juice {
		fill: color-mix(in srgb, var(--ig-vy) 65%, var(--ig-v));
		opacity: 0.85;
	}
	.ai-glass {
		fill: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.ai-straw,
	.ai-straw-in,
	.ai-straw-juice,
	.ai-straw-flow {
		fill: none;
		stroke-linejoin: round;
	}
	.ai-straw {
		stroke: var(--sl-color-gray-2);
		stroke-width: 8;
	}
	.ai-straw-in {
		stroke: color-mix(in srgb, var(--ig-surface) 85%, var(--sl-color-gray-5));
		stroke-width: 5;
	}
	.ai-straw-juice {
		stroke: color-mix(in srgb, var(--ig-vy) 65%, var(--ig-v));
		stroke-width: 5;
	}
	.ai-straw-flow {
		stroke: color-mix(in srgb, var(--sl-color-white) 70%, transparent);
		stroke-width: 1.6;
		stroke-dasharray: 3 9;
	}
	.ai-sdot {
		fill: var(--sl-color-gray-2);
	}
	.ai-arrows line,
	.ai-barrows line {
		stroke: var(--ig-vx);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.ai-head {
		fill: var(--ig-vx);
	}
	.ai-head-skin {
		fill: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.ai-lip {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vy) 60%, var(--sl-color-gray-3));
		stroke-width: 2;
		stroke-linecap: round;
	}
	.ai-eye {
		fill: var(--sl-color-gray-1);
	}
	.ai-brow {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	/* bottle scene */
	.ai-sky {
		fill: color-mix(in srgb, var(--ig-vx) 12%, transparent);
	}
	.ai-mount {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.ai-snow {
		fill: color-mix(in srgb, var(--sl-color-white) 80%, transparent);
	}
	:root[data-theme='light'] .ai-snow {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ai-road {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.4;
		stroke-dasharray: 5 4;
		stroke-linejoin: round;
	}
	.ai-ground {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-5));
	}
	.ai-sea {
		fill: color-mix(in srgb, var(--ig-vx) 45%, transparent);
	}
	.ai-wave {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-white) 50%, transparent);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.ai-call {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.ai-car {
		fill: var(--ig-vy);
		stroke: var(--ig-surface);
		stroke-width: 0.8;
	}
	.ai-wheel {
		fill: var(--sl-color-gray-1);
	}
	.ai-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ai-read {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.ai-inset {
		fill: var(--ig-surface);
	}
	.ai-inset-ring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.ai-bottle {
		fill: color-mix(in srgb, var(--ig-vx) 14%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.ai-crease {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.ai-cap {
		fill: var(--ig-vx);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const ease = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
	const mk = (parent: Element, cls: string, r: number) => {
		const c = document.createElementNS(NS, 'circle');
		c.setAttribute('class', cls);
		c.setAttribute('r', String(r));
		parent.append(c);
		return c;
	};
	// a fixed pseudo-random sequence, the same on every load
	const rng = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);

	// standard atmosphere, as in physics.ts
	const pAt = (h: number) => Math.pow(1 - (0.0065 * h) / 288.15, 5.2558);

	for (const root of document.querySelectorAll<HTMLElement>('[data-atmintro]')) {
		// ---------- Straw: 7 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="straw"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const juice = $<SVGPathElement>('[data-juice]');
			const sJuice = $<SVGPathElement>('[data-sjuice]');
			const sFlow = $<SVGPathElement>('[data-sflow]');
			const arrows = Array.from(card.querySelectorAll<SVGLineElement>('[data-arrows] line'));
			const room = $<SVGGElement>('[data-room]');
			const sdotsG = $<SVGGElement>('[data-sdots]');
			const GT = 96;
			const GB = 198;
			const gx = (y: number) => [140 + (8 * (y - GT)) / (GB - GT), 226 - (8 * (y - GT)) / (GB - GT)];
			// the straw: P0 (200,194) → P1 (200,84) → P2 (244,46)
			const L1 = 110;
			const L2 = Math.hypot(44, 38);
			const L = L1 + L2;
			const at = (d: number) => {
				if (d <= L1) return [200, 194 - d];
				const f = (d - L1) / L2;
				return [200 + 44 * f, 84 - 38 * f];
			};
			sJuice.style.strokeDasharray = `0 ${L + 10}`;
			// air of the room: dots outside the glass, the straw and the head
			const r1 = rng(7);
			const roomDots: { c: SVGCircleElement; x: number; y: number; ph: number }[] = [];
			while (roomDots.length < 46) {
				const x = 6 + r1() * 348;
				const y = 6 + r1() * 188;
				const inGlass = x > 132 && x < 234 && y > 84;
				const nearStraw = x > 190 && x < 252 && y > 38 && y < 96;
				const inHead = x > 240 && y < 126 && (x > 280 || y < 84);
				if (inGlass || nearStraw || inHead) continue;
				roomDots.push({ c: mk(room, 'ai-dot', 1.5), x, y, ph: r1() * 6.3 });
			}
			// air in the straw above the juice: 10 dots, 7 of them are drawn into the mouth
			const sdots = Array.from({ length: 10 }, (_, i) => ({ c: mk(sdotsG, 'ai-sdot', 1.2), k: i, ph: i * 1.7 }));
			const Y0 = 118; // juice level in the glass at the start
			const Y1 = 128; // after the sip
			scene(card, 7, (x) => {
				const now = performance.now() / 1000;
				for (const d of roomDots) {
					d.c.setAttribute('cx', (d.x + 1.6 * Math.sin(now * 2.1 + d.ph)).toFixed(1));
					d.c.setAttribute('cy', (d.y + 1.6 * Math.cos(now * 1.7 + d.ph * 1.3)).toFixed(1));
				}
				const rise = ease((x - 0.1) / 0.45); // the juice climbs the straw
				const sip = ease((x - 0.55) / 0.35); // drinking
				const yl = Y0 + (Y1 - Y0) * sip;
				const [a, b] = gx(yl);
				const [c, dd] = gx(GB);
				juice.setAttribute('d', `M${a.toFixed(1)} ${yl.toFixed(1)} L${b.toFixed(1)} ${yl.toFixed(1)} L${dd} ${GB} L${c} ${GB} Z`);
				arrows.forEach((ln) => {
					ln.setAttribute('y1', (yl - 34).toFixed(1));
					ln.setAttribute('y2', (yl - 5).toFixed(1));
				});
				// juice in the straw: up to the level in the glass, then up to the mouth
				const top = (194 - yl) + (L - (194 - yl)) * rise;
				sJuice.style.strokeDasharray = `${top.toFixed(1)} ${L + 10}`;
				const flowing = x > 0.52 && x < 0.92;
				sFlow.style.opacity = flowing ? '1' : '0';
				sFlow.style.strokeDashoffset = String(-((now * 26) % 12));
				// air dots above the juice: fewer and fewer stay
				const left = 10 - 7 * ease((x - 0.06) / 0.4);
				const free = L - top;
				for (const s of sdots) {
					const gone = s.k >= left;
					const frac = (s.k + 0.5) / 10;
					let dpos = top + free * frac + Math.sin(now * 3 + s.ph) * 2;
					if (gone) dpos = L + 6 + (s.k - left) * 4;
					const visible = !gone && free > 4 && dpos < L - 1;
					const [px, py] = at(Math.min(dpos, L));
					s.c.setAttribute('cx', px.toFixed(1));
					s.c.setAttribute('cy', py.toFixed(1));
					s.c.style.opacity = visible ? '1' : '0';
				}
			});
		}

		// ---------- Bottle: 8 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bottle"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const car = $<SVGGElement>('[data-car]');
			const call = $<SVGLineElement>('[data-call]');
			const alt = $<SVGTextElement>('[data-alt]');
			const outG = $<SVGGElement>('[data-out]');
			const inG = $<SVGGElement>('[data-in]');
			const bottle = $<SVGPathElement>('[data-bottle]');
			const crease = $<SVGPathElement>('[data-crease]');
			const barrowsG = $<SVGGElement>('[data-barrows]');
			const road: [number, number][] = [
				[98, 46],
				[124, 80],
				[100, 100],
				[150, 128],
				[120, 150],
				[186, 184],
				[232, 214],
			];
			const segs = road.slice(1).map((p, i) => Math.hypot(p[0] - road[i][0], p[1] - road[i][1]));
			const total = segs.reduce((s, v) => s + v, 0);
			const pointAt = (f: number) => {
				let d = f * total;
				for (let i = 0; i < segs.length; i++) {
					if (d <= segs[i] || i === segs.length - 1) {
						const t = Math.min(1, d / segs[i]);
						const [x0, y0] = road[i];
						const [x1, y1] = road[i + 1];
						return { x: x0 + (x1 - x0) * t, y: y0 + (y1 - y0) * t, dir: Math.sign(x1 - x0) || 1 };
					}
					d -= segs[i];
				}
				return { x: 232, y: 214, dir: 1 };
			};
			const CX = 288;
			const CY = 104;
			const R = 66;
			// bottle body: half-width 20 from y = 74 to 152, shoulders up to the neck (half-width 4) at y = 55
			const HW = 20;
			const YT = 74;
			const YB = 152;
			const A0 = 2 * HW * (YB - YT);
			const shape = (dm: number) => {
				const l = CX - HW;
				const r = CX + HW;
				const ym = (YT + YB) / 2;
				// a quadratic dent: the middle of each side moves in by dm (control point by 2·dm), slightly uneven
				return (
					`M${CX - 4} 55 L${CX - 4} 60 Q${l} 64 ${l} ${YT}` +
					` Q${(l + 2 * dm).toFixed(1)} ${(ym - 6).toFixed(1)} ${l} ${YB - 6}` +
					` Q${l} ${YB} ${l + 6} ${YB} L${r - 6} ${YB} Q${r} ${YB} ${r} ${YB - 6}` +
					` Q${(r - 2 * dm).toFixed(1)} ${(ym + 5).toFixed(1)} ${r} ${YT}` +
					` Q${r} 64 ${CX + 4} 60 L${CX + 4} 55 Z`
				);
			};
			// half-width of the dented body at height y (for placing the dots inside)
			const halfAt = (y: number, dm: number) => {
				const span = YB - 6 - YT;
				const t = Math.min(1, Math.max(0, (y - YT) / span));
				return HW - 2 * dm * 2 * t * (1 - t);
			};
			const r2 = rng(11);
			const outDots: { c: SVGCircleElement; x: number; y: number; ph: number }[] = [];
			while (outDots.length < 46) {
				const a = r2() * Math.PI * 2;
				const rr = Math.sqrt(r2()) * (R - 4);
				const x = CX + rr * Math.cos(a);
				const y = CY + rr * Math.sin(a);
				if (x > CX - HW - 6 && x < CX + HW + 6 && y > 42 && y < YB + 6) continue;
				outDots.push({ c: mk(outG, 'ai-dot', 1.5), x, y, ph: r2() * 6.3 });
			}
			const inDots = Array.from({ length: 10 }, () => ({ c: mk(inG, 'ai-dot', 1.5), u: r2() * 1.6 - 0.8, v: YT + 4 + r2() * (YB - YT - 12), ph: r2() * 6.3 }));
			// arrows of the outside air, pointing at the walls
			const arrows = [YT + 18, YB - 22].flatMap((y) =>
				[-1, 1].map((s) => {
					const ln = document.createElementNS(NS, 'line');
					ln.setAttribute('marker-end', `url(#${card.querySelector('marker')!.id})`);
					barrowsG.append(ln);
					return { ln, y, s };
				}),
			);
			const H0 = 3000;
			const pTop = pAt(H0);
			scene(card, 8, (x) => {
				const now = performance.now() / 1000;
				const f = ease(x);
				const p = pointAt(f);
				car.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) scale(${p.dir} 1)`);
				call.setAttribute('x1', p.x.toFixed(1));
				call.setAttribute('y1', (p.y - 12).toFixed(1));
				const h = Math.max(0, (H0 * (214 - p.y)) / (214 - 46));
				alt.textContent = `${Math.round(h / 10) * 10} м`;
				const pr = pAt(h); // outside pressure / sea level
				const v = pTop / pr; // volume share of the soft bottle
				const loss = (1 - v) * A0; // area lost, two dents of (2/3)·span·dm each
				const dm = (loss / 2) * (3 / 2) / (YB - 6 - YT);
				bottle.setAttribute('d', shape(dm));
				const ym = (YT + YB) / 2;
				crease.setAttribute(
					'd',
					dm > 2
						? `M${(CX - HW + dm * 0.9).toFixed(1)} ${ym - 14} l${(dm * 0.5).toFixed(1)} 9 M${(CX + HW - dm * 0.9).toFixed(1)} ${ym + 12} l${(-dm * 0.5).toFixed(1)} -8 M${CX - 6} ${(ym + 2).toFixed(1)} l6 ${(dm * 0.4).toFixed(1)}`
						: '',
				);
				// outside air: the number of dots is proportional to the pressure
				const nOut = Math.round(outDots.length * pr);
				outDots.forEach((d, i) => {
					d.c.setAttribute('cx', (d.x + 1.5 * Math.sin(now * 2 + d.ph)).toFixed(1));
					d.c.setAttribute('cy', (d.y + 1.5 * Math.cos(now * 1.6 + d.ph)).toFixed(1));
					d.c.style.opacity = i < nOut ? '1' : '0';
				});
				for (const d of inDots) {
					const y = d.v + 1.2 * Math.sin(now * 1.8 + d.ph);
					const hw = halfAt(y, dm) - 3;
					d.c.setAttribute('cx', (CX + d.u * hw * 0.9 + 1.2 * Math.cos(now * 2.3 + d.ph)).toFixed(1));
					d.c.setAttribute('cy', y.toFixed(1));
				}
				const len = 8 + 12 * pr;
				for (const a of arrows) {
					const edge = CX + a.s * (halfAt(a.y, dm) + 3);
					a.ln.setAttribute('x1', (edge + a.s * len).toFixed(1));
					a.ln.setAttribute('x2', edge.toFixed(1));
					a.ln.setAttribute('y1', String(a.y));
					a.ln.setAttribute('y2', String(a.y));
				}
			});
		}
	}
</script>
