---
/**
 * Picture to «Опыт Торричелли»: the experiment step by step, in a loop. A glass tube 1 m long, sealed at one end and
 * full of mercury, is closed with a finger, turned over, lowered into a dish of mercury, and the finger is taken away:
 * the column sinks (with a few damped swings) to 760 mm above the mercury in the dish, with emptiness above it. To
 * scale: 0,2 px per mm (the tube 200 px, the column 152 px). Arrows: the air presses on the mercury in the dish.
 */
import AtmStyles from './AtmStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gHg = `aph-${uid}`;
const mA = `apt-${uid}`;
const mD = `apd-${uid}`;
const SURF = 232; // mercury in the dish
const K = 0.2; // px per mm
const ticks = Array.from({ length: 10 }, (_, k) => k * 100);
---

<AtmStyles />
<figure class="ap-pic ap-pic--one not-content" data-torpic>
	<div class="ap-pic__grid">
		<svg class="ap-pic__svg" viewBox="0 0 360 300" role="img" aria-label="Опыт Торричелли. Трубку, полную ртути, закрывают пальцем, переворачивают и опускают в чашку с ртутью. Палец убирают: ртуть опускается до высоты 760 мм над уровнем ртути в чашке, а над ней остаётся пустота">
			<defs>
				<linearGradient id={gHg} x1="0" x2="1">
					<stop offset="0" class="ap-hg-edge"></stop>
					<stop offset="0.45" class="ap-hg-mid"></stop>
					<stop offset="1" class="ap-hg-edge"></stop>
				</linearGradient>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="ap-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
				<marker id={mD} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
					<path class="ap-dimhead" d="M0 1 L10 5 L0 9 z"></path>
				</marker>
			</defs>
			<rect class="ap-step-bg" x="8" y="268" width="344" height="26" rx="13"></rect>
			<text class="ap-step" x="180" y="286" text-anchor="middle" data-step>Трубку наполняют ртутью</text>
			<!-- the ruler (shown at the end) -->
			<g class="ap-fade" data-late>
				<line class="ap-scale" x1="214" y1={SURF} x2="214" y2={SURF - 900 * K}></line>
				{ticks.map((mm) => (
					<line class="ap-scale" x1="214" x2={mm % 200 ? 219 : 222} y1={SURF - mm * K} y2={SURF - mm * K} />
				))}
				{ticks.filter((mm) => mm % 200 === 0).map((mm) => (
					<text class="ap-scale-num" x="226" y={SURF - mm * K + 4}>{mm}</text>
				))}
				<text class="ap-scale-num" x="226" y={SURF - 900 * K - 8}>мм</text>
				<line class="ap-dim" x1="150" y1={SURF - 760 * K} x2="150" y2={SURF} marker-start={`url(#${mD})`} marker-end={`url(#${mD})`}></line>
				<line class="ap-ext" x1="144" y1={SURF - 760 * K} x2="172" y2={SURF - 760 * K}></line>
				<text class="ap-t-hl" x="144" y={SURF - 380 * K + 5} text-anchor="end">760 мм</text>
				<text x="166" y={SURF - 760 * K - 28} text-anchor="end">пустота</text>
			</g>
			<!-- the dish -->
			<rect x="112" y={SURF} width="136" height="24" fill={`url(#${gHg})`}></rect>
			<!-- the tube with its mercury and the finger (moved by the script) -->
			<g data-tube>
				<rect class="ap-vacuum" x="-5" y="2" width="10" height="198"></rect>
				<rect x="-5" y="0" width="10" height="200" fill={`url(#${gHg})`} data-hg></rect>
				<path class="ap-glass ap-tube" d="M-7 200 V7 a7 7 0 0 1 14 0 V200"></path>
				<g data-finger>
					<rect class="ap-finger" x="-10" y="199" width="20" height="16" rx="7"></rect>
					<path class="ap-nail" d="M-5 211 Q0 214 5 211"></path>
				</g>
			</g>
			<path class="ap-glass" d={`M110 216 V252 q0 6 6 6 H244 q6 0 6 -6 V216`}></path>
			<!-- the air presses on the mercury in the dish -->
			{[126, 236].map((x) => (
				<line class="ap-arrow" x1={x} y1={SURF - 36} x2={x} y2={SURF - 5} marker-end={`url(#${mA})`} />
			))}
			<text class="ap-t-air" x="92" y={SURF - 22} text-anchor="end">воздух</text>
			<text x="104" y="252" text-anchor="end">ртуть</text>
		</svg>
	</div>
	<div class="ap-pic__foot">
		<figcaption>
			Опыт Торричелли в масштабе: трубка длиной 1&nbsp;м, столб ртути — 760&nbsp;мм над уровнем ртути в чашке. Воздух давит на ртуть в чашке и не даёт ртути вылиться из трубки.
		</figcaption>
		<button type="button" class="ap-pic__again" data-again>Повторить</button>
	</div>
</figure>

<style is:global>
	.ap-pic .ap-step {
		font-size: 13.5px;
		fill: var(--sl-color-white);
		stroke: none;
	}
	.ap-step-bg {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-5);
	}
	.ap-finger {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.ap-nail {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.ap-ext {
		stroke: var(--ig-v);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.ap-fade {
		transition: opacity 0.5s ease;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
	const STEPS = [
		'Трубку, полную ртути, закрывают пальцем',
		'Трубку переворачивают',
		'Опускают открытым концом в чашку с ртутью',
		'Убирают палец — ртуть опускается',
		'Столб ртути высотой 760 мм, над ним пустота',
	];
	for (const root of document.querySelectorAll<HTMLElement>('[data-torpic]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const tube = $<SVGGElement>('[data-tube]');
		const hg = $<SVGRectElement>('[data-hg]');
		const finger = $<SVGGElement>('[data-finger]');
		const late = $<SVGGElement>('[data-late]');
		const step = $<SVGTextElement>('[data-step]');
		const EQ = 36; // the column top settles 36 px (180 mm) below the closed end: 940 − 760 mm
		scene(root, 8, (x) => {
			const rot = 180 * (1 - ease((x - 0.1) / 0.25));
			const ty = 20 + 24 * ease((x - 0.36) / 0.12);
			tube.setAttribute('transform', `translate(180 ${ty.toFixed(1)}) rotate(${rot.toFixed(1)} 0 100)`);
			// the finger comes onto the open end, stays while the tube is turned, then slides away
			const on = ease(x / 0.08);
			const offF = ease((x - 0.49) / 0.07);
			finger.setAttribute('transform', `translate(${(36 * offF).toFixed(1)} ${(26 * (1 - on)).toFixed(1)})`);
			finger.style.opacity = String(Math.min(on * 1.5, 1) * (1 - offF));
			// the column: damped swings about the level of 760 mm
			const t = Math.max(0, (x - 0.56) / 0.24);
			let top = 0;
			if (t > 0) {
				const swing = Math.exp(-3.2 * t) * Math.cos(2 * Math.PI * 1.15 * t);
				top = t >= 1 ? EQ : EQ * (1 - swing * (1 - ease((t - 0.7) / 0.3)));
			}
			hg.setAttribute('y', top.toFixed(1));
			hg.setAttribute('height', (200 - top).toFixed(1));
			late.style.opacity = x > 0.82 ? '1' : '0';
			const k = x < 0.1 ? 0 : x < 0.36 ? 1 : x < 0.49 ? 2 : x < 0.82 ? 3 : 4;
			if (step.textContent !== STEPS[k]) step.textContent = STEPS[k];
		});
	}
</script>
