		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		cursor: pointer;
	}
	.anr__parts button:hover,
	.anr__parts button:focus-visible,
	.anr__parts button[aria-pressed='true'] {
