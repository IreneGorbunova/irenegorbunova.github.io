		margin-top: 0.3rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.anr {
			padding: 0.75rem;
		}
		.anr__stage {
			grid-template-columns: 1fr;
		}
		.anr__dial {
			max-width: 13rem;
		}
		.anr__controls {
			grid-template-columns: 1fr;
		}
		.anr__btn {
			justify-self: start;
		}
		.anr__num {
			font-size: 17px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.anr [data-part] {
			transition: none;
		}
	}
</style>

<script>
	import { approach, fmt, reducedMotion, MMHG } from './physics';

	const NS = 'http://www.w3.org/2000/svg';
	const P_MIN = 600;
	const P_MAX = 800;
	const P_REF = 700;
	// geometry of the mechanism, px
	const BASE = 236; // top of the base plate
	const BOX_L = 50;
	const BOX_R = 190;
	const BOX_CX = 120;
	const LID = 198; // lid at P_REF
	const STUD = 24; // from the lid to the end of the spring
	const PIV = { x: 160, y: 74 }; // lever pivot
	const SHORT = 40;
	const LONG = 120;
	const PUL = { x: 280, y: 34, r: 10 }; // axle of the needle
	const CLAMP = { x: 262, y: 168 };
	// the needle turns by 270° over 200 мм рт. ст.; the chain unwinds r·Δθ;
	// the long arm moves 3 times more than the short one, the short one as much as the lid
	const RAD_PER_MM = ((270 / 200) * Math.PI) / 180;
	const LID_PER_MM = (PUL.r * RAD_PER_MM * SHORT) / LONG; // ≈ 0,079 px per мм рт. ст.

	const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>, parent: Element) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent.append(e);
		return e;
	};
	const r1 = (v: number) => Math.round(v * 100) / 100;

	for (const root of document.querySelectorAll<HTMLElement>('[data-anr]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const stat = q<SVGGElement>('[data-static]');
		const dyn = q<SVGGElement>('[data-dyn]');
		const needle = q<SVGGElement>('[data-needle]');
		const input = q<HTMLInputElement>('[data-p]');
		const out = q<HTMLOutputElement>('[data-out]');
		const live = q<HTMLElement>('[data-live]');
		const play = q<HTMLButtonElement>('[data-play]');
		const uid = `anr${Math.random().toString(36).slice(2, 8)}`;
		const motionOff = reducedMotion();

		// ----- static parts -----
		const defs = el('defs', {}, stat);
		const mk = el('marker', { id: `${uid}-a`, viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 5, markerHeight: 5, orient: 'auto' }, defs);
		el('path', { d: 'M0,0 L10,5 L0,10 z', class: 'anr__arrowhead' }, mk);
		// air around
		let dots = '';
		let seed = 7;
		const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
		for (let i = 0; i < 70; i++) {
			const x = 14 + rnd() * 352;
			const y = 8 + rnd() * 222;
			const inBox = x > BOX_L - 4 && x < BOX_R + 4 && y > LID - 14;
			const nearMech = (x > 100 && x < 300 && y < 110) || (x > 110 && x < 270 && y > 150 && y < 186);
			if (!inBox && !nearMech) dots += `M${r1(x - 1.3)} ${r1(y)}a1.3 1.3 0 1 0 2.6 0a1.3 1.3 0 1 0 -2.6 0`;
		}
		el('path', { d: dots, class: 'anr__air' }, stat);
		// frame: base, posts, top bar
		el('rect', { class: 'anr__frame', x: 18, y: BASE, width: 344, height: 12, rx: 3 }, stat);
		el('rect', { class: 'anr__frame', x: CLAMP.x - 3, y: CLAMP.y - 6, width: 12, height: BASE - CLAMP.y + 6 }, stat);
		el('rect', { class: 'anr__frame', x: 348, y: 10, width: 10, height: BASE - 10 }, stat);
		el('rect', { class: 'anr__frame', x: 140, y: 10, width: 218, height: 8, rx: 2 }, stat);
		el('rect', { class: 'anr__frame', x: PIV.x - 3, y: 18, width: 6, height: PIV.y - 18 }, stat);
		el('rect', { class: 'anr__frame', x: PUL.x - 2, y: 18, width: 4, height: PUL.y - 18 }, stat);
		const airLabel = el('text', { class: 'anr__text anr__text--air', x: 22, y: 150 }, stat);
		airLabel.textContent = 'воздух давит';
		const boxText = el('text', { class: 'anr__text', x: BOX_CX, y: BASE - 10, 'text-anchor': 'middle' }, stat);
		boxText.textContent = 'воздуха почти нет';

		// ----- moving parts -----
		const gBox = el('g', { 'data-part': 1 }, dyn);
		const boxFill = el('path', { class: 'anr__box' }, gBox);
		const boxMetal = el('path', { class: 'anr__metal' }, gBox);
		const arrows = [70, 95, 145, 170].map((x) =>
			el('line', { class: 'anr__arrow', x1: x, x2: x, 'marker-end': `url(#${uid}-a)` }, dyn),
		);
		const gSpring = el('g', { 'data-part': 2 }, dyn);
		const spring = el('path', { class: 'anr__spring' }, gSpring);
		const stud = el('line', { class: 'anr__rod', x1: BOX_CX, x2: BOX_CX }, gSpring);
		const gLever = el('g', { 'data-part': 3 }, dyn);
		const rod = el('line', { class: 'anr__rod' }, gLever);
		const lever = el('line', { class: 'anr__lever' }, gLever);
		el('circle', { class: 'anr__pivot', cx: PIV.x, cy: PIV.y, r: 4.5 }, gLever);
		const gChain = el('g', { 'data-part': 4 }, dyn);
		const chain = el('line', { class: 'anr__chain' }, gChain);
		const gAxle = el('g', { 'data-part': 5 }, dyn);
		el('circle', { class: 'anr__pulley', cx: PUL.x, cy: PUL.y, r: PUL.r }, gAxle);
		const spoke = el('line', { class: 'anr__spoke' }, gAxle);
		el('circle', { class: 'anr__pivot', cx: PUL.x, cy: PUL.y, r: 3 }, gAxle);
		// number badges
		const badge = (n: number, x: number, y: number) => {
			const g = el('g', { class: 'anr__num-badge', 'data-part': n }, dyn);
			el('circle', { cx: x, cy: y, r: 9 }, g);
			const t = el('text', { x, y: y + 4, 'text-anchor': 'middle' }, g);
			t.textContent = String(n);
		};
		badge(1, BOX_L - 16, LID + 18);
		badge(2, 220, 150);
		badge(3, 240, 96);
		badge(4, PUL.x + 22, 66);
		badge(5, PUL.x + 24, PUL.y);

		let p = 760;
		let shown = 760;
		let raf = 0;
		let last = 0;
		let playT = -1;

		const lidPath = (delta: number, close: boolean) => {
			// the lid bows in the middle; its edges are fixed to the walls
			let d = `M${BOX_L} ${BASE}V${LID + 6}`;
			const n = 56;
			for (let i = 0; i <= n; i++) {
				const x = BOX_L + ((BOX_R - BOX_L) * i) / n;
				const u = (x - BOX_CX) / ((BOX_R - BOX_L) / 2);
				const bow = delta * (1 - u * u);
				const wave = 2.6 * Math.sin((i / n) * Math.PI * 14);
				d += `L${r1(x)} ${r1(LID + bow + wave)}`;
			}
			d += `L${BOX_R} ${LID + 6}V${BASE}`;
			return close ? d + 'Z' : d;
		};

		const draw = (pmm: number) => {
			const delta = (pmm - P_REF) * LID_PER_MM; // px, down when the pressure grows
			boxFill.setAttribute('d', lidPath(delta, true));
			boxMetal.setAttribute('d', lidPath(delta, false));
			const lidC = LID + delta;
			// pressure arrows, their length grows with p
			const len = 12 + ((pmm - P_MIN) / (P_MAX - P_MIN)) * 18;
			for (const a of arrows) {
				const x = Number(a.getAttribute('x1'));
				const u = (x - BOX_CX) / ((BOX_R - BOX_L) / 2);
				const yLid = LID + delta * (1 - u * u) - 6;
				a.setAttribute('y1', String(r1(yLid - len)));
				a.setAttribute('y2', String(r1(yLid)));
			}
			// spring from the clamp to the end above the lid
			const tipY = lidC - STUD;
			spring.setAttribute(
				'd',
				`M${CLAMP.x} ${CLAMP.y}C${CLAMP.x - 60} ${CLAMP.y} ${BOX_CX + 50} ${r1(tipY)} ${BOX_CX} ${r1(tipY)}`,
			);
			stud.setAttribute('y1', String(r1(lidC - 3)));
			stud.setAttribute('y2', String(r1(tipY)));
			// lever turns so that its short arm follows the end of the spring
			const phi = Math.asin(Math.max(-0.9, Math.min(0.9, delta / SHORT)));
			const sx = PIV.x - SHORT * Math.cos(phi);
			const sy = PIV.y + SHORT * Math.sin(phi);
			const ex = PIV.x + LONG * Math.cos(phi);
			const ey = PIV.y - LONG * Math.sin(phi);
			rod.setAttribute('x1', String(r1(BOX_CX)));
			rod.setAttribute('y1', String(r1(tipY)));
			rod.setAttribute('x2', String(r1(sx)));
			rod.setAttribute('y2', String(r1(sy)));
			lever.setAttribute('x1', String(r1(sx)));
			lever.setAttribute('y1', String(r1(sy)));
			lever.setAttribute('x2', String(r1(ex)));
			lever.setAttribute('y2', String(r1(ey)));
			chain.setAttribute('x1', String(r1(ex)));
			chain.setAttribute('y1', String(r1(ey)));
			chain.setAttribute('x2', String(PUL.x - PUL.r));
			chain.setAttribute('y2', String(PUL.y));
			// axle and needle turn together
			const deg = -135 + ((pmm - P_MIN) / (P_MAX - P_MIN)) * 270;
			const a = (deg * Math.PI) / 180;
			spoke.setAttribute('x1', String(r1(PUL.x - PUL.r * 0.8 * Math.sin(a))));
			spoke.setAttribute('y1', String(r1(PUL.y + PUL.r * 0.8 * Math.cos(a))));
			spoke.setAttribute('x2', String(r1(PUL.x + PUL.r * 0.8 * Math.sin(a))));
			spoke.setAttribute('y2', String(r1(PUL.y - PUL.r * 0.8 * Math.cos(a))));
			needle.setAttribute('transform', `rotate(${deg.toFixed(2)} 110 110)`);
		};

		const label = (pmm: number) => {
			const mm = Math.round(pmm);
			return `${fmt(mm)} мм рт. ст. ≈ ${fmt((mm * MMHG) / 1000, 1)} кПа`;
		};
		const describe = (pmm: number) => {
			const d = Math.round(pmm) - 760;
			if (d === 0) return 'Нормальное атмосферное давление: 760 мм рт. ст.';
			return d > 0
				? `Давление на ${d} мм рт. ст. выше нормального: воздух сильнее прижимает крышку, пружина сильнее изгибается, рычаг поворачивает стрелку вправо.`
				: `Давление на ${-d} мм рт. ст. ниже нормального: пружина отжимает крышку вверх, рычаг поворачивает стрелку влево.`;
		};

		const frame = (now: number) => {
			const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
			last = now;
			if (playT >= 0) {
				playT += dt;
				// up to 800, down to 600 and back to 760, smoothly
				const T = 7;
				const t = Math.min(playT / T, 1);
				p = 700 + 100 * Math.sin(2 * Math.PI * t + Math.asin(0.6));
				if (t >= 1) {
					playT = -1;
					p = 760;
				}
				input.value = String(Math.round(p));
			}
			shown = motionOff ? p : approach(shown, p, dt, 0.18);
			draw(shown);
			out.value = label(shown);
			if (Math.abs(shown - p) > 0.05 || playT >= 0) raf = requestAnimationFrame(frame);
			else {
				raf = 0;
				live.textContent = describe(p);
			}
		};
		const kick = () => {
			if (!raf) {
				last = performance.now();
				raf = requestAnimationFrame(frame);
			}
		};
		input.addEventListener('input', () => {
			playT = -1;
			p = Number(input.value);
			kick();
		});
		play.addEventListener('click', () => {
			playT = 0;
			kick();
		});

		// highlight a part from the list
		const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hl]'));
		let pinned = '';
		const setHl = (n: string) => {
			if (n) root.dataset.hl = n;
			else delete root.dataset.hl;
		};
		for (const b of btns) {
			b.addEventListener('pointerenter', () => setHl(b.dataset.hl!));
			b.addEventListener('pointerleave', () => setHl(pinned));
			b.addEventListener('focus', () => setHl(b.dataset.hl!));
			b.addEventListener('blur', () => setHl(pinned));
			b.addEventListener('click', () => {
				pinned = pinned === b.dataset.hl ? '' : b.dataset.hl!;
				btns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.hl === pinned)));
				setHl(pinned);
			});
		}

		draw(p);
		out.value = label(p);
		live.textContent = describe(p);
	}
</script>
