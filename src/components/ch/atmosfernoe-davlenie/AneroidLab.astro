---
/**
 * How an aneroid barometer works: a corrugated box with almost no air inside, a spring that holds
 * its lid, a lever, a chain and the axle of the needle. The pressure slider moves the whole chain.
 * The motion of the lid is shown greatly enlarged; the needle turns in proportion to the pressure.
 */
const C = 110;
const P_MIN = 600;
const P_MAX = 800;
const ang = (mm: number) => -135 + ((mm - P_MIN) / (P_MAX - P_MIN)) * 270;
const pt = (deg: number, r: number) => {
	const a = (deg * Math.PI) / 180;
	return [C + r * Math.sin(a), C - r * Math.cos(a)].map((v) => Math.round(v * 100) / 100);
};
const tick = (deg: number, r1: number, r2: number) => {
	const [x1, y1] = pt(deg, r1);
	const [x2, y2] = pt(deg, r2);
	return `M${x1} ${y1}L${x2} ${y2}`;
};
let minor = '';
let major = '';
for (let mm = P_MIN; mm <= P_MAX; mm += 5) {
	if (mm % 50 === 0) major += tick(ang(mm), 91, 77);
	else if (mm % 10 === 0) minor += tick(ang(mm), 91, 83);
	else minor += tick(ang(mm), 91, 87);
}
const labels = [600, 650, 700, 750, 800].map((mm) => {
	const [x, y] = pt(ang(mm), 64);
	return { mm, x, y: y + 5 };
});
// inner scale in kPa: 1 мм рт. ст. = 133,28 Па
const MMHG = 13600 * 9.8 * 0.001;
let kpaTicks = '';
const kpaLabels: { k: number; x: number; y: number }[] = [];
for (let k = 80; k <= 106; k++) {
	const deg = ang((k * 1000) / MMHG);
	kpaTicks += tick(deg, 52, k % 5 === 0 ? 44 : 48);
	if (k % 5 === 0) {
		const [x, y] = pt(deg, 35);
		kpaLabels.push({ k, x, y: y + 4 });
	}
}
const kpaArc = (() => {
	const a1 = ang(80000 / MMHG);
	const a2 = ang(106000 / MMHG);
	const [x1, y1] = pt(a1, 52);
	const [x2, y2] = pt(a2, 52);
	return `M${x1} ${y1}A52 52 0 1 1 ${x2} ${y2}`;
})();
const arc = (() => {
	const [x1, y1] = pt(ang(P_MIN), 91);
	const [x2, y2] = pt(ang(P_MAX), 91);
	return `M${x1} ${y1}A91 91 0 1 1 ${x2} ${y2}`;
})();
const parts = [
	{ n: 1, text: 'коробочка с волнистой (гофрированной) крышкой, из которой откачан воздух' },
	{ n: 2, text: 'пружина: не даёт воздуху раздавить коробочку' },
	{ n: 3, text: 'тяга и рычаг: увеличивают малое движение крышки' },
	{ n: 4, text: 'цепочка: поворачивает ось стрелки' },
	{ n: 5, text: 'стрелка на оси показывает давление по шкале' },
];
---

<figure class="anr not-content" data-anr>
	<div class="anr__stage">
		<svg class="anr__mech" viewBox="0 0 380 270" role="img" aria-label="Устройство барометра-анероида в разрезе">
			<g data-static></g>
			<g data-dyn></g>
		</svg>
		<svg class="anr__dial" viewBox="0 0 220 220" role="img" aria-label="Шкала барометра-анероида">
			<circle class="anr__bezel" cx={C} cy={C} r="105"></circle>
			<circle class="anr__face" cx={C} cy={C} r="97"></circle>
			<path class="anr__scale" d={arc + minor}></path>
			<path class="anr__scale anr__scale--major" d={major}></path>
			{
				labels.map((l) => (
					<text class="anr__num" x={l.x} y={l.y} text-anchor="middle">
						{l.mm}
					</text>
				))
			}
			<path class="anr__kpa" d={kpaArc + kpaTicks}></path>
			{
				kpaLabels.map((l) => (
					<text class="anr__kpanum" x={l.x} y={l.y} text-anchor="middle">
						{l.k}
					</text>
				))
			}
			<text class="anr__unit" x={C} y="166" text-anchor="middle">мм рт. ст.</text>
			<text class="anr__unit anr__unit--kpa" x={C} y="184" text-anchor="middle">кПа</text>
			<g data-needle data-part="5">
				<path class="anr__needle" d={`M${C} ${C - 86}L${C + 3.6} ${C}L${C} ${C + 22}L${C - 3.6} ${C}Z`}></path>
			</g>
			<circle class="anr__cap" cx={C} cy={C} r="6.5"></circle>
		</svg>
	</div>

	<div class="anr__controls">
		<label class="anr__slider">
			<span>Давление воздуха <i>p</i></span>
			<output data-out>760 мм рт. ст.</output>
			<input type="range" min={P_MIN} max={P_MAX} step="1" value="760" data-p />
		</label>
		<button type="button" class="anr__btn" data-play>Покачать давление</button>
	</div>

	<ol class="anr__parts">
		{
			parts.map((p) => (
				<li>
					<button type="button" data-hl={p.n}>
						<span class="anr__badge">{p.n}</span>
						{p.text}
					</button>
				</li>
			))
		}
	</ol>
	<p class="anr__live" data-live aria-live="polite"></p>
	<figcaption class="anr__legend">
		Наведите на название детали или нажмите на него — деталь подсветится. Движение крышки на рисунке
		сильно увеличено: в настоящем приборе оно составляет доли миллиметра.
	</figcaption>
</figure>

<style is:global>
	.anr {
