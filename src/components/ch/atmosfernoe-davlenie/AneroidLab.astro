		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.anr i {
		font-family: var(--ig-font-math);
	}
	.anr__stage {
		display: grid;
		grid-template-columns: 1.75fr 1fr;
		gap: 1rem;
		align-items: center;
	}
	.anr__mech,
	.anr__dial {
		display: block;
		width: 100%;
		height: auto;
	}
	.anr__dial {
		max-width: 15rem;
		margin-inline: auto;
	}
	.anr__frame {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.anr__box {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
	}
	.anr__metal {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.anr__spring {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.anr__rod {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.anr__lever {
		stroke: var(--sl-color-gray-1);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.anr__chain {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-dasharray: 3 2;
	}
	.anr__pivot {
		fill: var(--sl-color-gray-3);
		stroke: var(--ig-surface);
		stroke-width: 1.5;
	}
	.anr__pulley {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.anr__spoke {
		stroke: var(--ig-vy);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.anr__arrow {
		stroke: var(--ig-vx);
		stroke-width: 2.2;
	}
	.anr__arrowhead {
		fill: var(--ig-vx);
	}
	.anr__air {
		fill: var(--sl-color-gray-3);
		opacity: 0.7;
	}
	.anr__text {
		fill: var(--sl-color-gray-2);
		font-family: var(--__sl-font);
		font-size: 12px;
	}
	.anr__text--air {
		fill: var(--ig-vx);
	}
	.anr__num-badge circle {
		fill: var(--sl-color-accent);
	}
	.anr__num-badge text {
		fill: var(--sl-color-black);
		font-family: var(--__sl-font);
		font-weight: 700;
		font-size: 12px;
	}
	.anr [data-part] {
		transition:
			opacity 0.25s,
			filter 0.25s;
	}
	.anr[data-hl] [data-part] {
		opacity: 0.25;
	}
	.anr[data-hl='1'] [data-part='1'],
	.anr[data-hl='2'] [data-part='2'],
	.anr[data-hl='3'] [data-part='3'],
	.anr[data-hl='4'] [data-part='4'],
	.anr[data-hl='5'] [data-part='5'] {
		opacity: 1;
		filter: drop-shadow(0 0 5px var(--sl-color-accent));
	}

	.anr__bezel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.anr__face {
		fill: var(--ig-surface);
	}
	.anr__scale {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.anr__scale--major {
		stroke-width: 2;
	}
	.anr__num {
		fill: var(--sl-color-gray-1);
		font-family: var(--__sl-font);
		font-size: 15px;
	}
	.anr__kpa {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.4;
	}
	.anr__kpanum {
		fill: var(--ig-vx);
		font-family: var(--__sl-font);
		font-size: 12px;
	}
