---
/**
 * Model to «Сила атмосферного давления»: a slightly inflated balloon under a glass bell on the plate of a hand pump.
 * Every stroke of the pump takes air from under the bell, the pressure outside the balloon falls, and the air inside
 * the balloon pushes the rubber out: the balloon grows. «Впустить воздух» opens the tap, the air comes back and the
 * balloon shrinks to its first size.
 *
 * Physics (slow, so the temperature stays the same):
 *   - the air in the balloon keeps its amount: p_вн·V = const (Boyle);
 *   - the rubber squeezes the air a little: p_вн = p_нар + 3 кПа at every size (the rubber's own pressure is small and
 *     taken constant, a simplification of a real balloon);
 *   - at the start p_нар = 101,3 кПа, the balloon is 5 см across: V₀ = 65 см³, p_вн·V = 104,3 · 65,4 ≈ 6830 кПа·см³;
 *   - the bell holds 3,56 л (inside 17 см wide: a cylinder 10 см high and a half-sphere on top); one stroke lets the air
 *     under the bell spread into the pump's 1 л cylinder (the balloon grows during the same stroke; solved by bisection
 *     from p'·(V_колокола − V(p') + 1 л) = p·(V_колокола − V(p))), then the pump pushes that air out into the room;
 *   - the pump cannot go below 1 кПа (as in MagdeburgLab). Numbers: after 5 strokes 29,3 кПа outside, 212 см³ (3,2 times
 *     more); after 10 strokes 8,3 кПа, 604 см³; the limit, 1 кПа, after 18 strokes: 1707 см³ (26 times more), 14,8 см
 *     across, still inside the bell.
 * Scale: the bell, the plate and the balloon 1 px = 1 мм; the pump, the tap and the stand are drawn without scale.
 * Arrows: the pressure of the air on the rubber from outside and from inside, 0,16 px per кПа (one scale for both).
 * Dots: the air; their number per area is proportional to the pressure (one dot per about 180 мм² at 101 кПа), so
 * they show how rarefied the air is, not single molecules. A stroke takes 0,8 с (slowed), the tap lets the air in
 * within about 2 с.
 */
import G7Styles from '../g7/G7Styles.astro';

const BX = 140; // the axis of the bell
const PLATE = 232; // the top of the plate
const PX = 296; // the axis of the pump
---

<G7Styles />
<figure class="g7 bal not-content" data-balloon>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 292" role="img" aria-label="Воздушный шарик под стеклянным колоколом на тарелке насоса. При откачивании воздуха из-под колокола шарик раздувается" data-svg>
			<defs data-defs></defs>
			<!-- the table and the stand -->
			<line class="bal__table" x1="0" y1="272" x2="340" y2="272"></line>
			<rect class="bal__metal-dark" x={BX - 18} y={PLATE + 8} width="36" height="32"></rect>
			<rect class="bal__metal-dark" x={BX - 34} y="266" width="68" height="6" rx="2"></rect>
			<!-- the hose from the plate to the pump with the tap -->
			<path class="bal__hose" d={`M${BX + 18} 254 H280`}></path>
			<path class="bal__metal-dark" d="M259 258 h6 v9 h-6 z" ></path>
			<circle class="bal__metal" cx="262" cy="254" r="6"></circle>
			<line class="bal__lever" x1="262" y1="254" x2="262" y2="240" data-lever></line>
			<text class="t-small" x="256" y="285" text-anchor="end">кран</text>
			<g data-inflow></g>
			<!-- the air under the bell -->
			<path class="bal__inside" d={`M${BX - 85} ${PLATE} V132 A85 85 0 0 1 ${BX + 85} 132 V${PLATE} Z`}></path>
			<g data-air></g>
			<!-- the balloon -->
			<g data-balloon-g>
				<path class="bal__under" data-under></path>
				<path class="bal__rubber" data-rubber></path>
				<g data-air-in></g>
				<ellipse class="bal__shine" data-shine></ellipse>
			</g>
			<g data-arrows></g>
			<!-- the plate and the bell -->
			<rect class="bal__metal" x={BX - 105} y={PLATE} width="210" height="8" rx="2"></rect>
			<rect class="bal__hole" x={BX - 4} y={PLATE} width="8" height="3"></rect>
			<path class="bal__glass" d={`M${BX - 87} ${PLATE} V132 A87 87 0 0 1 ${BX + 87} 132 V${PLATE}`}></path>
			<path class="bal__glass-rim" d={`M${BX - 93} ${PLATE} V${PLATE - 5} H${BX - 85} M${BX + 93} ${PLATE} V${PLATE - 5} H${BX + 85}`}></path>
			<path class="bal__glass-shine" d={`M${BX - 74} 200 V138 A74 74 0 0 1 ${BX - 40} 75`}></path>
			<rect class="bal__glass-knob" x={BX - 9} y="33" width="18" height="11" rx="5"></rect>
			<text class="t-small" x={BX + 66} y="44">колокол</text>
			<!-- the pump -->
			<path class="bal__metal" d={`M${PX - 24} 266 h48 v6 h-48 z`}></path>
			<rect class="bal__metal" x={PX - 16} y="150" width="32" height="116" rx="3"></rect>
			<rect class="bal__metal-dark" x={PX - 18} y="145" width="36" height="7" rx="2"></rect>
			<path class="bal__metal-dark" d={`M${PX + 16} 160 h9 v6 h-9 z`}></path>
			<g data-puffs></g>
			<line class="bal__rod" x1={PX} x2={PX} y2="146" data-rod></line>
			<rect class="bal__handle" x={PX - 21} width="42" height="8" rx="4" data-handle></rect>
			<text class="t-small" x={PX} y="285" text-anchor="middle">насос</text>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-pump>Качнуть насос</button>
				<button type="button" class="g7__btn" data-pump5>Качнуть 5 раз</button>
				<button type="button" class="g7__btn" data-let>Впустить воздух</button>
			</div>
			<ul class="g7__read">
				<li><span>Ходов насоса</span><b data-n>0</b></li>
				<li class="is-key"><span>Давление воздуха под колоколом</span><b data-pout></b></li>
				<li><span>Давление воздуха в шарике</span><b data-pin></b></li>
				<li class="is-key"><span>Объём шарика</span><b data-v></b></li>
			</ul>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Колокол, тарелка и шарик нарисованы в масштабе, насос и кран — условно; один ход насоса замедлен. Синие стрелки —
		давление воздуха на резину снаружи и изнутри (в одном масштабе), точки — воздух: чем их гуще, тем больше
		давление. Резина немного сжимает воздух в шарике, поэтому давление в нём на 3&nbsp;кПа больше, чем снаружи.
	</figcaption>
</figure>

<style is:global>
	.bal__table {
		stroke: var(--g7-line);
		stroke-width: 1.6;
	}
	.bal__metal {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.bal__metal-dark {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.bal__hole {
		fill: var(--ig-surface);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.bal__hose {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 6;
	}
	.bal__lever {
		stroke: var(--g7-red);
		stroke-width: 3.2;
		stroke-linecap: round;
		transition: transform 0.3s ease;
		transform-origin: 262px 254px;
	}
	.bal[data-open] .bal__lever {
		transform: rotate(-90deg);
	}
	.bal__inside {
		fill: color-mix(in srgb, var(--g7-blue) 5%, transparent);
	}
	.bal__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 4;
	}
	.bal__glass-rim {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
	}
	.bal__glass-shine {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.5;
		stroke-linecap: round;
		opacity: 0.22;
	}
	.bal__glass-knob {
		fill: color-mix(in srgb, var(--g7-glass) 60%, transparent);
		stroke: var(--g7-glass);
		stroke-width: 1.5;
	}
	.bal__air {
		fill: var(--sl-color-gray-3);
	}
	.bal__air-in {
		fill: var(--sl-color-white);
		opacity: 0.85;
	}
	.bal__under {
		fill: var(--ig-surface);
	}
	.bal__rubber {
		fill: var(--g7-violet);
		stroke: color-mix(in oklab, var(--g7-violet) 70%, var(--sl-color-black));
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.bal__shine {
		fill: var(--sl-color-white);
		opacity: 0.28;
	}
	:root[data-theme='light'] .bal__shine,
	:root[data-theme='light'] .bal__glass-shine {
		stroke: var(--sl-color-black);
		fill: var(--sl-color-black);
		opacity: 0.6;
	}
	:root[data-theme='light'] .bal__glass-shine {
		fill: none;
	}
	.bal__p {
		stroke: var(--g7-blue);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.bal__rod {
		stroke: var(--g7-ink);
		stroke-width: 3;
	}
	.bal__handle {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.bal__puff {
		fill: var(--sl-color-gray-3);
	}
</style>

<script>
	import { el, fmt, fmtInt, loop, ease, rng } from '../g7/kit';

	const BX = 140;
	const PLATE = 232;
	const PX = 296;
	const P0 = 101.3; // кПа
	const DP = 3; // кПа, the rubber's own pressure
	const D0 = 5; // см, the balloon at the start
	const V0 = (Math.PI / 6) * D0 ** 3; // см³
	const C = (P0 + DP) * V0; // p_вн·V, кПа·см³
	const V_BELL = Math.PI * 8.5 ** 2 * 10 + (2 / 3) * Math.PI * 8.5 ** 3; // см³
	const V_PUMP = 1000; // см³
	const P_LOW = 1; // кПа, the best the pump can do
	const STROKE = 0.8; // с
	const ARROW = 0.16; // px per кПа
	const DENS = 160 / 28350; // dots per px² at P0 (160 dots under the bell)

	const vol = (p: number) => C / (p + DP); // см³
	const radius = (p: number) => 10 * Math.cbrt((3 * vol(p)) / (4 * Math.PI)); // px (1 px = 1 мм)
	// one stroke: the air under the bell spreads into the pump's cylinder, and the balloon grows at the same time
	const afterStroke = (p: number) => {
		const n = p * (V_BELL - vol(p));
		let lo = 0;
		let hi = p;
		for (let i = 0; i < 50; i++) {
			const m = (lo + hi) / 2;
			if (m * (V_BELL - vol(m) + V_PUMP) > n) hi = m;
			else lo = m;
		}
		return Math.max(P_LOW, (lo + hi) / 2);
	};
	const kPa = (p: number) => `${fmt(p, 1)} кПа`;
	const times = (x: number) => `${fmt(x, 1)} раза`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-balloon]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const uid = Math.random().toString(36).slice(2, 8);
		const defs = q<SVGDefsElement>('[data-defs]');
		const head = el('marker', { id: `bal-h-${uid}`, viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 3.6, markerHeight: 3.6, orient: 'auto' });
		head.append(el('path', { class: 'head--blue', d: 'M0 0 L10 5 L0 10 z' }));
		defs.append(head);
		const btnPump = q<HTMLButtonElement>('[data-pump]');
		const btnPump5 = q<HTMLButtonElement>('[data-pump5]');
		const btnLet = q<HTMLButtonElement>('[data-let]');
		const under = q<SVGPathElement>('[data-under]');
		const rubber = q<SVGPathElement>('[data-rubber]');
		const shine = q<SVGEllipseElement>('[data-shine]');
		const rod = q<SVGLineElement>('[data-rod]');
		const handle = q<SVGRectElement>('[data-handle]');
		const msg = q<HTMLElement>('[data-msg]');

		// the air under the bell: fixed places, each with its rank; the first N·p/P0 are shown
		const rnd = rng(7);
		const outDots: SVGCircleElement[] = [];
		const outPos: { x: number; y: number }[] = [];
		while (outPos.length < 160) {
			const x = BX - 81 + 162 * rnd();
			const y = 51 + (PLATE - 54) * rnd();
			if (y < 132 && (x - BX) ** 2 + (y - 132) ** 2 > 81 ** 2) continue;
			outPos.push({ x, y });
			outDots.push(q('[data-air]').appendChild(el('circle', { class: 'bal__air', cx: x.toFixed(1), cy: y.toFixed(1), r: 1.7 })));
		}
		// the air in the balloon: places in a unit circle, scaled with the balloon
		const inPos: { x: number; y: number }[] = [];
		const inDots: SVGCircleElement[] = [];
		while (inPos.length < 60) {
			const x = 2 * rnd() - 1;
			const y = 2 * rnd() - 1;
			if (x * x + y * y > 0.8 * 0.8) continue;
			inPos.push({ x, y });
			inDots.push(q('[data-air-in]').appendChild(el('circle', { class: 'bal__air-in', r: 1.7 })));
		}
		// pressure arrows: from outside toward the rubber and from inside toward it, at three angles
		const ANG = [180, 270, 0].map((a) => (a * Math.PI) / 180);
		const arrows = q('[data-arrows]');
		const outArr = ANG.map(() => arrows.appendChild(el('line', { class: 'bal__p', 'marker-end': `url(#bal-h-${uid})` })));
		const inArr = ANG.map(() => arrows.appendChild(el('line', { class: 'bal__p bal__p--in', 'marker-end': `url(#bal-h-${uid})` })));
		// air puffs leaving the pump and entering through the tap
		const puffs = [0, 1, 2].map(() => q('[data-puffs]').appendChild(el('circle', { class: 'bal__puff', r: 2 })));
		const inflow = [0, 1, 2].map(() => q('[data-inflow]').appendChild(el('circle', { class: 'bal__puff', r: 2 })));

		let p = P0; // кПа under the bell
		let strokes = 0;
		let queue = 0;
		let st = -1; // the phase of the current stroke, 0…1, or −1
		let from = P0;
		let to = P0;
		let open = false;
		let clock = 0;
		let lastMsg = '';

		const say = (s: string) => {
			if (s !== lastMsg) msg.textContent = lastMsg = s;
		};

		const draw = () => {
			const r = radius(p);
			const cy = PLATE - r;
			// the balloon and its knot (on the lower right, 40° below the horizontal)
			const a = (40 * Math.PI) / 180;
			const kx = BX + r * Math.cos(a);
			const ky = cy + r * Math.sin(a);
			const da = 5 / r;
			const p1 = { x: BX + r * Math.cos(a - da), y: cy + r * Math.sin(a - da) };
			const p2 = { x: BX + r * Math.cos(a + da), y: cy + r * Math.sin(a + da) };
			const tip = { x: kx + 6 * Math.cos(a), y: ky + 6 * Math.sin(a) };
			const d =
				`M${p2.x.toFixed(1)} ${p2.y.toFixed(1)} A${r.toFixed(2)} ${r.toFixed(2)} 0 1 1 ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} ` +
				`L${tip.x.toFixed(1)} ${(tip.y - 2).toFixed(1)} L${(tip.x - 1).toFixed(1)} ${(tip.y + 2).toFixed(1)} Z`;
			under.setAttribute('d', d);
			rubber.setAttribute('d', d);
			// the rubber gets thinner and lighter as it stretches
			rubber.style.fillOpacity = String(Math.max(0.42, 0.9 - 0.15 * Math.log(r / 25) * 1.6));
			shine.setAttribute('cx', (BX - 0.42 * r).toFixed(1));
			shine.setAttribute('cy', (cy - 0.45 * r).toFixed(1));
			shine.setAttribute('rx', (0.2 * r).toFixed(1));
			shine.setAttribute('ry', (0.12 * r).toFixed(1));
			shine.setAttribute('transform', `rotate(-40 ${(BX - 0.42 * r).toFixed(1)} ${(cy - 0.45 * r).toFixed(1)})`);
			// the air: dots per area proportional to the pressure
			const nOut = Math.round((outPos.length * p) / P0);
			outDots.forEach((c, i) => (c.style.display = i < nOut ? '' : 'none'));
			const pin = p + DP;
			const nIn = Math.min(inPos.length, Math.round(DENS * (pin / P0) * Math.PI * (0.8 * r) ** 2));
			inDots.forEach((c, i) => {
				c.style.display = i < nIn ? '' : 'none';
				if (i < nIn) {
					c.setAttribute('cx', (BX + inPos[i].x * r).toFixed(1));
					c.setAttribute('cy', (cy + inPos[i].y * r).toFixed(1));
				}
			});
			// pressure arrows
			const lo = ARROW * p;
			const li = ARROW * pin;
			ANG.forEach((t, i) => {
				const ux = Math.cos(t);
				const uy = Math.sin(t);
				const o = outArr[i];
				o.style.display = lo > 3 ? '' : 'none';
				o.setAttribute('x1', (BX + ux * (r + 3 + lo)).toFixed(1));
				o.setAttribute('y1', (cy + uy * (r + 3 + lo)).toFixed(1));
				o.setAttribute('x2', (BX + ux * (r + 3)).toFixed(1));
				o.setAttribute('y2', (cy + uy * (r + 3)).toFixed(1));
				const n = inArr[i];
				n.style.display = li > 3 ? '' : 'none';
				n.setAttribute('x1', (BX + ux * (r - 3 - li)).toFixed(1));
				n.setAttribute('y1', (cy + uy * (r - 3 - li)).toFixed(1));
				n.setAttribute('x2', (BX + ux * (r - 3)).toFixed(1));
				n.setAttribute('y2', (cy + uy * (r - 3)).toFixed(1));
			});
			// the pump: up in the first half of a stroke, down in the second
			const lift = st < 0 ? 0 : st < 0.5 ? ease(st / 0.5) : 1 - ease((st - 0.5) / 0.5);
			const hy = 136 - 66 * lift;
			handle.setAttribute('y', hy.toFixed(1));
			rod.setAttribute('y1', (hy + 4).toFixed(1));
			puffs.forEach((c, i) => {
				const s = st >= 0.5 ? (st - 0.5) / 0.5 - i * 0.18 : -1;
				const on = s > 0 && s < 1;
				c.style.display = on ? '' : 'none';
				if (on) {
					c.setAttribute('cx', (PX + 27 + 22 * s).toFixed(1));
					c.setAttribute('cy', (163 - 6 * s).toFixed(1));
					c.style.opacity = String(1 - s);
				}
			});
			inflow.forEach((c, i) => {
				const s = ((clock * 1.6 + i / 3) % 1);
				const on = open;
				c.style.display = on ? '' : 'none';
				if (on) {
					c.setAttribute('cx', (240 + 22 * s).toFixed(1));
					c.setAttribute('cy', (269 - 2 * s).toFixed(1));
					c.style.opacity = String(Math.min(1, (1 - s) * 2) * Math.min(1, (P0 - p) / 5));
				}
			});
			// readouts
			const V = vol(p);
			q('[data-n]').textContent = String(strokes);
			q('[data-pout]').textContent = kPa(p);
			q('[data-pin]').textContent = kPa(pin);
			q('[data-v]').textContent = `${fmtInt(V)} см³`;
			const busy = st >= 0 || queue > 0 || open;
			btnPump.disabled = btnPump5.disabled = busy || p <= P_LOW + 1e-6;
			btnLet.disabled = busy || p >= P0 - 1e-6;
			const k = V / V0;
			if (open) say('Кран открыт: воздух входит под колокол, давление снаружи растёт, и шарик сжимается.');
			else if (st >= 0 || queue > 0) say(`Насос откачивает воздух. Давление в шарике меньше начального в ${times((P0 + DP) / pin)}, а объём больше в ${times(k)}.`);
			else if (strokes === 0) say('Под колоколом и в шарике воздух при атмосферном давлении. Качните насос.');
			else if (p <= P_LOW + 1e-6)
				say(`Насос больше не может откачать воздух: под колоколом ${kPa(p)}. Давление в шарике меньше начального в ${times((P0 + DP) / pin)}, а объём больше в ${times(k)}.`);
			else say(`Давление в шарике меньше начального в ${times((P0 + DP) / pin)}, а объём больше в ${times(k)}.`);
		};

		const wake = loop(root, (dt) => {
			clock += dt;
			if (st < 0 && queue > 0 && p > P_LOW + 1e-6) {
				queue -= 1;
				st = 0;
				from = p;
				to = afterStroke(p);
			} else if (st < 0) queue = 0;
			if (st >= 0) {
				st += dt / STROKE;
				// the pressure falls while the piston goes up
				p = from + (to - from) * ease(Math.min(st, 0.5) / 0.5);
				if (st >= 1) {
					st = -1;
					p = to;
					strokes += 1;
				}
			}
			if (open) {
				p = P0 - (P0 - p) * Math.exp(-dt / 0.45);
				if (P0 - p < 0.05) {
					p = P0;
					open = false;
					strokes = 0;
					delete root.dataset.open;
				}
			}
			draw();
			return st >= 0 || queue > 0 || open;
		});

		btnPump.addEventListener('click', () => {
			queue += 1;
			draw();
			wake();
		});
		btnPump5.addEventListener('click', () => {
			queue += 5;
			draw();
			wake();
		});
		btnLet.addEventListener('click', () => {
			open = true;
			root.dataset.open = '';
			draw();
			wake();
		});
		draw();
	}
</script>
