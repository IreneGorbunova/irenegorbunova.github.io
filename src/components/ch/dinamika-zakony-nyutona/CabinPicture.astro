---
/**
 * «Каюта Галилея» (after the Galileo principle): a ship's cabin cut open, as in Galileo's «Dialogue» (1632). A flask
 * hangs under the ceiling and lets a drop fall into a bowl on the floor; its spout is 1,0 м above the rim of the bowl,
 * so the drop falls for t = √(2 · 1,0 / 9,8) = 0,452 с. A fishbowl stands on a small table, a butterfly flutters.
 * Two toggles: the ship «Стоит» / «Плывёт равномерно» (5 м/с), and we look «Из каюты» / «С берега».
 *   From the cabin everything looks the same in both cases: the drop falls straight down into the bowl; only the far
 *   shore above the deck slides back when the ship moves.
 *   From the shore the moving cabin goes right at 5 м/с; the drop keeps the ship's horizontal speed, so its path is a
 *   half-parabola, x = 5 м/с · τ, y = gτ²/2, 5 · 0,452 = 2,26 м long horizontally, and it still lands in the bowl,
 *   which has moved the same 2,26 м.
 * Scale 50 px per metre on both axes (the cabin is 3,2 м wide and 2,2 м high). The motion is slowed down 3 times: 0,7 с
 * of real time (the drop leaves at 0,1 с) plays in 2,1 с, then the last frame holds for 1,2 с. A trail marks the drop
 * every 0,05 с of real time. The butterfly's flight (a small figure of eight, 1,2 с) is the same relative to the
 * cabin in every case.
 */
import DzStyles from './DzStyles.astro';

const K = 50; // px per м
const CW = 160; // cabin width
const FLOOR = 168;
const CEIL = FLOOR - 110;
// cabin-local x of the things (px from the cabin's left wall)
const FX = 42; // flask and bowl
const SPOUT = FLOOR - 15 - K * 1.0; // the spout is 1,0 м above the rim (the bowl is 15 px = 0,3 м high)
const hills = 'M0 46 Q30 30 60 40 Q95 24 130 38 Q160 30 190 42 Q220 26 260 36 Q300 28 330 40 Q355 32 380 38 V52 H0 Z';
---

<DzStyles />
<figure class="g7 cab not-content" data-cab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 214" role="img" aria-label="Каюта корабля в разрезе. С потолка капает вода в миску на полу, в аквариуме плавает рыбка, летает бабочка. Когда корабль плывёт равномерно, в каюте всё происходит так же, как на стоящем корабле">
			<rect class="cab-sky" x="0" y="0" width="380" height="190"></rect>
			<g data-bg>
				{[0, 380].map((dx) => <path class="cab-hills" d={hills} transform={`translate(${dx} 0)`} />)}
				{[0, 380].map((dx) => (
					<g transform={`translate(${dx} 0)`}>
						<path class="cab-house" d="M70 42 v-8 l5 -4 l5 4 v8 Z M250 40 v-9 l6 -5 l6 5 v9 Z" />
						<path class="cab-tower" d="M168 44 v-22 h4 v22 Z M166 22 h8 l-4 -6 Z" />
					</g>
				))}
			</g>
			<rect class="cab-sea" x="0" y="184" width="380" height="30"></rect>
			<g data-ship>
				<path class="cab-hull" d={`M-420 52 H${CW + 420} V${FLOOR + 6} Q${CW + 420} 190 ${CW + 400} 192 H-400 Q-420 190 -420 ${FLOOR + 6} Z`}></path>
				<path class="cab-rail" d={`M-420 44 H${CW + 420} ${Array.from({ length: 50 }, (_, i) => `M${-420 + i * 20} 44 V52`).join(' ')}`}></path>
				<rect class="cab-room" x="0" y={CEIL} width={CW} height={FLOOR - CEIL}></rect>
				<rect class="cab-floor" x="0" y={FLOOR} width={CW} height="6"></rect>
				{[100, 136].map((x) => (
					<g>
						<circle class="cab-port-rim" cx={x} cy={CEIL + 30} r="12" />
						<circle class="cab-port" cx={x} cy={CEIL + 30} r="9" />
						<path class="cab-port-glint" d={`M${x - 5} ${CEIL + 26} q3 -4 7 -4`} />
					</g>
				))}
				<path class="dz-thread" d={`M${FX} ${CEIL} V${CEIL + 14}`}></path>
				<path class="cab-flask" d={`M${FX - 3} ${CEIL + 14} h6 v6 q9 4 9 13 q0 10 -12 10 q-12 0 -12 -10 q0 -9 9 -13 Z`}></path>
				<path class="cab-water" d={`M${FX - 8} ${CEIL + 34} q0 7 8 7 q8 0 8 -7 Z`}></path>
				<path class="cab-flask" d={`M${FX - 1.2} ${CEIL + 43} h2.4 v${SPOUT - CEIL - 43} h-2.4 Z`}></path>
				<path class="cab-bowl" d={`M${FX - 16} ${FLOOR - 15} h32 q-2 15 -16 15 q-14 0 -16 -15 Z`}></path>
				<path class="cab-water" d={`M${FX - 14} ${FLOOR - 11} h28 q-2 10 -14 10 q-12 0 -14 -10 Z`}></path>
				<path class="cab-table" d={`M112 ${FLOOR - 30} h40 v3 h-40 Z M116 ${FLOOR - 27} v27 h3 v-27 Z M145 ${FLOOR - 27} v27 h3 v-27 Z`}></path>
				<path class="cab-glass" d={`M120 ${FLOOR - 30} q-4 -10 2 -20 h16 q6 10 2 20 Z`}></path>
				<path class="cab-water" d={`M119.5 ${FLOOR - 32} q-2.5 -8 1.5 -14 h18 q4 6 1.5 14 Z`}></path>
				<path class="cab-fish" data-fish d="M0 0 q4 -3 8 0 q-4 3 -8 0 Z M8 0 l3 -2.5 v5 Z"></path>
				<g data-fly>
					<path class="cab-wing" d="M0 0 q-5 -6 -8 -1 q2 4 8 1 Z M0 0 q5 -6 8 -1 q-2 4 -8 1 Z"></path>
					<path class="cab-wing cab-wing--b" d="M0 0 q-4 5 -6 2 Z M0 0 q4 5 6 2 Z"></path>
					<path class="cab-body" d="M0 -3 v6"></path>
				</g>
			</g>
			<g data-buoys>
				{[60, 250].map((x) => (
					<g transform={`translate(${x} 0)`}>
						<path class="cab-buoy" d="M-5 190 L5 190 L3 178 L-3 178 Z" />
						<path class="cab-buoy-top" d="M-1 178 V170 M-3 170 h6" />
					</g>
				))}
			</g>
			<g data-trail></g>
			<circle class="cab-drop" r="2.6" data-drop></circle>
		</svg>
		<div class="g7__side">
			<span class="g7__label">Корабль</span>
			<div class="g7__seg" role="group" aria-label="Как движется корабль" data-mode>
				<button type="button" class="g7__btn" aria-pressed="true" data-v="0">Стоит</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-v="5">Плывёт равномерно</button>
			</div>
			<span class="g7__label">Смотрим</span>
			<div class="g7__seg" role="group" aria-label="Откуда смотрим" data-view>
				<button type="button" class="g7__btn" aria-pressed="true" data-w="cabin">Из каюты</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-w="shore">С берега</button>
			</div>
			<ul class="g7__read">
				<li>Капля падает <b>0,45&nbsp;с</b></li>
				<li class="is-key">Сдвиг капли вдоль пола <b data-rx></b></li>
			</ul>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Каюта корабля в разрезе, высота падения капли 1,0&nbsp;м. Точки — где была капля через каждые 0,05&nbsp;с. Масштаб одинаковый по обеим осям, движение замедлено в 3 раза.
	</figcaption>
</figure>

<style is:global>
	.cab {
		--cab-sky: color-mix(in oklab, var(--ig-vx) 18%, var(--g7-paper));
		--cab-sea: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-5));
		--cab-hull: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-4));
		--cab-room: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-6));
	}
	:root[data-theme='light'] .cab {
		--cab-hull: color-mix(in oklab, var(--ig-vy) 35%, var(--sl-color-gray-5));
		--cab-room: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-7, #fff));
	}
	.cab-sky { fill: var(--cab-sky); }
	.cab-hills { fill: color-mix(in oklab, hsl(130, 30%, 45%) 60%, var(--cab-sky)); }
	.cab-house { fill: var(--sl-color-gray-3); }
	.cab-tower { fill: var(--sl-color-gray-2); }
	.cab-sea { fill: var(--cab-sea); }
	.cab-buoy { fill: var(--g7-red); }
	.cab-buoy-top { stroke: var(--g7-ink); stroke-width: 1.2; fill: none; }
	.cab-hull { fill: var(--cab-hull); stroke: var(--sl-color-gray-3); stroke-width: 1; }
	.cab-rail { stroke: var(--sl-color-gray-3); stroke-width: 1.2; fill: none; }
	.cab-room { fill: var(--cab-room); stroke: var(--g7-wood-dark); stroke-width: 2; }
	.cab-floor { fill: var(--g7-wood); }
	.cab-port-rim { fill: var(--g7-gold); opacity: 0.85; }
	.cab-port { fill: var(--cab-sea); }
	.cab-port-glint { stroke: var(--sl-color-white); stroke-width: 1.2; fill: none; opacity: 0.7; }
	.cab-flask { fill: var(--g7-glass); stroke: var(--sl-color-gray-2); stroke-width: 0.9; }
	.cab-water { fill: var(--g7-water); }
	.cab-bowl { fill: var(--g7-steel); stroke: var(--sl-color-gray-2); stroke-width: 1; }
	.cab-table { fill: var(--g7-wood); stroke: var(--g7-wood-dark); stroke-width: 0.8; }
	.cab-glass { fill: none; stroke: var(--sl-color-gray-2); stroke-width: 1; }
	.cab-fish { fill: hsl(28, 95%, 58%); }
	.cab-wing { fill: var(--g7-violet); }
	.cab-wing--b { opacity: 0.75; }
	.cab-body { stroke: var(--g7-ink); stroke-width: 1.4; stroke-linecap: round; }
	.cab-drop { fill: var(--g7-blue); stroke: var(--sl-color-white); stroke-width: 0.6; }
	.cab-dot { fill: var(--g7-blue); opacity: 0.75; }
</style>

<script>
	import { loop, segment, el, fmt } from '../g7/kit';

	const K = 50;
	const CW = 160;
	const FLOOR = 168;
	const FX = 42;
	const SPOUT = FLOOR - 15 - K * 1.0;
	const G = 9.8;
	const TF = Math.sqrt((2 * 1.0) / G); // 0,452 с
	const SLOW = 3;
	const RUN = 0.7; // s of real time
	const REL = 0.1; // the drop leaves the spout
	const HOLD = 1.2; // s of screen time
	const CENTER = 110; // where the cabin stands when it does not move on the screen
	const START = 18; // the cabin's left wall at the start when it moves on the screen

	for (const root of document.querySelectorAll<HTMLElement>('[data-cab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const ship = $<SVGGElement>('[data-ship]');
		const bg = $<SVGGElement>('[data-bg]');
		const buoys = $<SVGGElement>('[data-buoys]');
		const trail = $<SVGGElement>('[data-trail]');
		const drop = $<SVGCircleElement>('[data-drop]');
		const fish = $<SVGPathElement>('[data-fish]');
		const fly = $<SVGGElement>('[data-fly]');
		const msg = $('[data-msg]');
		let v = 0;
		let view = 'cabin';
		let t = 0; // screen time in the cycle
		const cabinX = (tr: number) => (view === 'shore' && v > 0 ? START + v * K * tr : CENTER);
		const draw = () => {
			const tr = Math.min(t / SLOW, RUN); // real time
			const cx = cabinX(tr);
			ship.setAttribute('transform', `translate(${cx.toFixed(1)} 0)`);
			// the far shore and the buoys: still from the shore, sliding back from the moving cabin
			const shift = view === 'cabin' ? -((v * K * tr * 0.25) % 380) : 0;
			bg.setAttribute('transform', `translate(${shift.toFixed(1)} 0)`);
			buoys.setAttribute('transform', `translate(${(view === 'cabin' ? -v * K * tr : 0).toFixed(1)} 0)`);
			// the fish and the butterfly, the same relative to the cabin in every case (screen time / 3 = real time)
			const ph = (2 * Math.PI * tr) / 1.2;
			fish.setAttribute('transform', `translate(${(124 + 8 * Math.sin(ph * 0.7)).toFixed(1)} ${FLOOR - 42}) scale(${Math.cos(ph * 0.7) >= 0 ? 1 : -1} 1)`);
			fly.setAttribute('transform', `translate(${(82 + 9 * Math.sin(ph)).toFixed(1)} ${(FLOOR - 70 + 5 * Math.sin(2 * ph)).toFixed(1)}) scale(${(0.7 + 0.3 * Math.abs(Math.cos(ph * 6))).toFixed(2)} 1)`);
			// the drop
			const tau = Math.min(Math.max(tr - REL, 0), TF);
			const at = (s: number) => ({ x: cabinX(REL + s) + FX, y: SPOUT + 0.5 * G * s * s * K });
			const p = at(tau);
			drop.setAttribute('cx', p.x.toFixed(1));
			drop.setAttribute('cy', p.y.toFixed(1));
			drop.style.opacity = tr < REL || tau >= TF ? '0' : '1';
			trail.replaceChildren();
			for (let s = 0.05; s <= tau + 1e-9; s += 0.05) {
				const q = at(s);
				trail.append(el('circle', { class: 'cab-dot', cx: q.x.toFixed(1), cy: q.y.toFixed(1), r: 1.6 }));
			}
			if (tau >= TF) {
				const q = at(TF);
				trail.append(el('circle', { class: 'cab-dot', cx: q.x.toFixed(1), cy: q.y.toFixed(1), r: 1.6 }));
			}
		};
		const texts = () => {
			const dx = view === 'shore' ? v * TF : 0;
			$('[data-rx]').textContent = dx ? `${fmt(dx, 2)} м` : '0';
			msg.textContent =
				view === 'cabin'
					? 'Из каюты капля падает отвесно в миску — стоит корабль или плывёт равномерно.'
					: v
						? 'С берега капля летит по дуге: пока она падает, корабль проходит 2,26\u00a0м, и капля вместе с ним. Она попадает в миску.'
						: 'Корабль стоит: и с берега капля падает отвесно.';
		};
		const restart = () => {
			t = 0;
			texts();
			draw();
			wake();
		};
		const wake = loop(root, (dt) => {
			t += dt;
			if (t > RUN * SLOW + HOLD) t = 0;
			draw();
			return true;
		});
		segment($('[data-mode]'), (b) => {
			v = Number(b.dataset.v);
			restart();
		});
		segment($('[data-view]'), (b) => {
			view = b.dataset.w!;
			restart();
		});
		restart();
	}
</script>
