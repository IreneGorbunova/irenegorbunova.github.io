---
/**
 * Two looping opening scenes of «Законы Ньютона» (grade 10). No terms of the chapter in the pictures.
 *
 * Skate: 45 px per metre (0,45 px per см). A father (180 см, 80 кг) and his daughter (140 см, 40 кг) stand on skates
 *   palm to palm and push each other with 160 Н for 0,5 с: she gets 4 м/с², he 2 м/с², so she leaves at 2 м/с and
 *   he at 1 м/с (their hands part when the arms are straight, a little before the end of the push). Then they glide;
 *   the ice slows both by 0,1 м/с² (μ ≈ 0,01). Real time, 2,2 с: she slides 3,8 м, he 1,9 м. The scratches on the
 *   ice show the two paths.
 * Light: 12 px per metre (the vehicles are drawn in a 9 px/m frame and scaled by 12/9). At the green light a car (4,5 м, 1,3 т) starts with 3 м/с² and a loaded truck (10 м, 20 т)
 *   with 0,8 м/с² (traction 3,9 кН and 16 кН). Real time, 3,2 с: the car goes 15,4 м, the truck 4,1 м. Wheels
 *   turn by the distance rolled.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import WinterStyles from './WinterStyles.astro';

// the town behind the street: houses with windows
const houses = [
	{ x: -4, w: 62, h: 92 },
	{ x: 62, w: 48, h: 120 },
	{ x: 114, w: 70, h: 78 },
	{ x: 190, w: 54, h: 108 },
	{ x: 250, w: 66, h: 86 },
	{ x: 320, w: 46, h: 126 },
];
const SKY = 150;
const windows = houses.flatMap((h, i) => {
	const out: { x: number; y: number; lit: boolean }[] = [];
	for (let y = SKY - h.h + 8; y < SKY - 14; y += 14)
		for (let x = h.x + 7; x < h.x + h.w - 9; x += 12) out.push({ x, y, lit: (x * 7 + y * 3 + i) % 5 === 0 });
	return out;
});
const zebra = Array.from({ length: 6 }, (_, i) => 162 + i * 10);
---

<WinterStyles />
<IntroFrame data-dnintro>
	<div class="intro__card" data-scene="skate">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Папа и дочка на коньках отталкиваются ладонями и разъезжаются; дочка уезжает вдвое дальше папы">
			<rect class="dn-hall" x="0" y="0" width="360" height="240"></rect>
			{[40, 120, 200, 280].map((x) => <ellipse class="dn-lamp" cx={x} cy="14" rx="18" ry="4" />)}
			{[40, 120, 200, 280].map((x) => <path class="dn-beam" d={`M${x - 14} 16 L${x - 40} 120 H${x + 40} L${x + 14} 16 Z`} />)}
			<rect class="dn-ice" x="0" y="150" width="360" height="90"></rect>
			<rect class="dn-board" x="0" y="112" width="360" height="40"></rect>
			<rect class="dn-board-line" x="0" y="140" width="360" height="5"></rect>
			<rect class="dn-board-top" x="0" y="110" width="360" height="4"></rect>
			{[30, 110, 190, 270, 350].map((x) => <line class="dn-board-seam" x1={x} y1="114" x2={x} y2="150" />)}
			<path class="dn-ice-line" d="M0 228 H360"></path>
			<path class="dn-scratch" data-tr1 d=""></path>
			<path class="dn-scratch" data-tr2 d=""></path>
			<g class="dn-w">
				<g data-girl class="dn-hat2"></g>
				<g transform="scale(-1 1)"><g data-dad></g></g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Папа и дочка на коньках оттолкнулись друг от друга ладонями — и{' '}
				<More term="дочка покатилась вдвое быстрее папы">
					Они толкали друг друга с одинаковыми силами, около 160&nbsp;Н: при взаимодействии тел так бывает всегда. Но масса дочки, 40&nbsp;кг, вдвое меньше массы папы, 80&nbsp;кг, и та же сила сообщила ей вдвое большее ускорение. За полсекунды толчка она разогналась до 2&nbsp;м/с, а папа — только до 1&nbsp;м/с. Об этом — в разделе <a href="#третий-закон-ньютона">«Третий закон Ньютона»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="light">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="На зелёный свет легковой автомобиль быстро уезжает вперёд, а гружёный грузовик медленно трогается">
			<rect class="dn-sky" x="0" y="0" width="360" height="160"></rect>
			{houses.map((h) => <rect class="dn-house" x={h.x} y={SKY - h.h} width={h.w} height={h.h + 4} />)}
			{windows.map((w) => <rect class={w.lit ? 'dn-win dn-win--lit' : 'dn-win'} x={w.x} y={w.y} width="6" height="8" />)}
			{[30, 230, 330].map((x) => (
				<g>
					<rect class="dn-trunk" x={x - 1.5} y="128" width="3" height="24" />
					<circle class="dn-crown" cx={x} cy="122" r="13" />
					<circle class="dn-crown" cx={x + 8} cy="130" r="9" />
				</g>
			))}
			<rect class="dn-walk" x="0" y="150" width="360" height="12"></rect>
			<rect class="dn-road" x="0" y="162" width="360" height="60"></rect>
			{zebra.map((y) => <rect class="dn-zebra" x="152" y={y} width="30" height="5" />)}
			<rect class="dn-stop" x="148" y="162" width="3" height="60"></rect>
			<path class="dn-lane" d="M0 192 H360"></path>
			<!-- the traffic light on the far sidewalk -->
			<rect class="dn-pole" x="190" y="66" width="3" height="90"></rect>
			<rect class="dn-tl" x="183" y="40" width="17" height="44" rx="4"></rect>
			<circle class="dn-lampoff" data-red cx="191.5" cy="50" r="5"></circle>
			<circle class="dn-lampoff" cx="191.5" cy="62" r="5"></circle>
			<circle class="dn-lampoff" data-green cx="191.5" cy="74" r="5"></circle>
			<!-- the car: far lane, 4,5 м × 1,45 м -->
			<g data-car>
				<path class="dn-car" d="M-40.5 -4 L-40.5 -8 Q-40 -10.8 -36 -11 L-27 -11.3 L-20 -17.6 Q-18.5 -18.6 -15 -18.6 L-7 -18.6 Q-4.5 -18.6 -3 -16.4 L-1.2 -11.3 Q0 -10.8 0 -9 L0 -4 Z"></path>
				<path class="dn-glass" d="M-25.5 -11.6 L-19.5 -17.2 L-13 -17.2 L-13 -11.6 Z M-11.5 -11.6 L-11.5 -17.2 L-7.2 -17.2 Q-5 -17 -4 -15.4 L-2.6 -11.6 Z"></path>
				<circle class="dn-head" cx="-8" cy="-14" r="2.2"></circle>
				<rect class="dn-light-f" x="-1.6" y="-9.6" width="1.6" height="1.6"></rect>
				<g data-w transform="translate(-32 -3)"><circle class="dn-tyre" r="3.4"></circle><path class="dn-rim" d="M-2 0 H2 M0 -2 V2"></path></g>
				<g data-w transform="translate(-7 -3)"><circle class="dn-tyre" r="3.4"></circle><path class="dn-rim" d="M-2 0 H2 M0 -2 V2"></path></g>
			</g>
			<!-- the truck: near lane, 10 м × 3,4 м, a flatbed with crates -->
			<g data-truck>
				<rect class="dn-chassis" x="-90" y="-10" width="90" height="4"></rect>
				<path class="dn-cab" d="M-18 -6 L-18 -29 L-6 -29 Q-2 -29 -1 -25 L0 -15 L0 -6 Z"></path>
				<path class="dn-glass" d="M-15 -26.5 L-6.5 -26.5 Q-4 -26.5 -3.4 -23.5 L-2.6 -17 L-15 -17 Z"></path>
				<circle class="dn-head" cx="-9" cy="-21" r="2.4"></circle>
				<rect class="dn-bed" x="-90" y="-13" width="70" height="3"></rect>
				{[0, 1, 2, 3, 4].map((i) => <rect class="dn-crate" x={-89 + i * 13.6} y="-24" width="13" height="11" />)}
				{[0, 1, 2, 3].map((i) => <rect class="dn-crate dn-crate--b" x={-82 + i * 13.6} y="-34" width="13" height="10" />)}
				{[-80, -66, -11].map((x) => (
					<g data-w transform={`translate(${x} -4.5)`}><circle class="dn-tyre" r="4.5" /><path class="dn-rim" d="M-2.6 0 H2.6 M0 -2.6 V2.6" /></g>
				))}
			</g>
			<rect class="dn-walk" x="0" y="222" width="360" height="18"></rect>
			<rect class="dn-curb" x="0" y="221" width="360" height="3"></rect>
		</svg>
		<div class="intro__foot">
			<p>
				Загорелся зелёный: легковой автомобиль сразу уходит вперёд, а гружёный грузовик{' '}
				<More term="разгоняется медленно, хотя его мотор тянет сильнее">
					Ускорение тела прямо пропорционально силе и обратно пропорционально массе. Автомобиль массой 1,3&nbsp;т разгоняет сила около 3,9&nbsp;кН, и его ускорение 3&nbsp;м/с². Грузовик с грузом, 20&nbsp;т, разгоняет сила 16&nbsp;кН — вчетверо больше, но масса больше в 15 раз, и ускорение всего 0,8&nbsp;м/с². Об этом — в разделе <a href="#второй-закон-ньютона">«Второй закон Ньютона»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-dnintro] {
		--dn-hall: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-bg));
		--dn-ice: hsl(198, 45%, 82%);
		--dn-sky: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-bg));
		--dn-house: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-5));
		--dn-road: hsl(220, 8%, 30%);
		--dn-walk: hsl(30, 8%, 52%);
	}
	:root[data-theme='light'] [data-dnintro] {
		--dn-ice: hsl(198, 55%, 90%);
		--dn-house: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-6));
		--dn-road: hsl(220, 8%, 48%);
		--dn-walk: hsl(30, 10%, 74%);
	}
	[data-dnintro] .dn-hall { fill: var(--dn-hall); }
	[data-dnintro] .dn-lamp { fill: hsl(48, 90%, 85%); }
	[data-dnintro] .dn-beam { fill: hsl(48, 90%, 80%); opacity: 0.08; }
	[data-dnintro] .dn-ice { fill: var(--dn-ice); }
	[data-dnintro] .dn-ice-line { stroke: hsl(198, 40%, 70%); stroke-width: 1; stroke-dasharray: 2 8; }
	[data-dnintro] .dn-board { fill: hsl(0, 0%, 96%); }
	[data-dnintro] .dn-board-top { fill: hsl(210, 10%, 55%); }
	[data-dnintro] .dn-board-line { fill: var(--ig-vx); }
	[data-dnintro] .dn-board-seam { stroke: hsl(210, 10%, 78%); stroke-width: 1; }
	[data-dnintro] .dn-scratch { fill: none; stroke: hsl(200, 30%, 55%); stroke-width: 1; opacity: 0.8; }
	[data-dnintro] .dn-sky { fill: var(--dn-sky); }
	[data-dnintro] .dn-house { fill: var(--dn-house); stroke: var(--sl-color-gray-4); stroke-width: 0.6; }
	[data-dnintro] .dn-win { fill: var(--sl-color-gray-4); }
	[data-dnintro] .dn-win--lit { fill: hsl(45, 80%, 70%); }
	[data-dnintro] .dn-trunk { fill: hsl(28, 35%, 32%); }
	[data-dnintro] .dn-crown { fill: hsl(140, 35%, 38%); }
	[data-dnintro] .dn-walk { fill: var(--dn-walk); }
	[data-dnintro] .dn-curb { fill: hsl(0, 0%, 80%); }
	[data-dnintro] .dn-road { fill: var(--dn-road); }
	[data-dnintro] .dn-zebra,
	[data-dnintro] .dn-stop { fill: hsl(0, 0%, 92%); opacity: 0.9; }
	[data-dnintro] .dn-lane { stroke: hsl(0, 0%, 92%); stroke-width: 1.5; stroke-dasharray: 14 10; }
	[data-dnintro] .dn-pole { fill: hsl(210, 8%, 45%); }
	[data-dnintro] .dn-tl { fill: hsl(220, 10%, 18%); stroke: hsl(220, 10%, 40%); stroke-width: 0.8; }
	[data-dnintro] .dn-lampoff { fill: hsl(220, 8%, 32%); }
	[data-dnintro] .dn-lampoff.is-red { fill: hsl(2, 85%, 58%); }
	[data-dnintro] .dn-lampoff.is-green { fill: hsl(140, 75%, 50%); }
	[data-dnintro] .dn-car { fill: var(--ig-vy); stroke: hsl(222, 35%, 14%); stroke-width: 0.6; stroke-linejoin: round; }
	[data-dnintro] .dn-glass { fill: hsl(200, 40%, 78%); stroke: hsl(222, 35%, 14%); stroke-width: 0.4; }
	[data-dnintro] .dn-head { fill: hsl(25, 40%, 28%); }
	[data-dnintro] .dn-light-f { fill: hsl(48, 90%, 75%); }
	[data-dnintro] .dn-tyre { fill: hsl(220, 10%, 14%); stroke: hsl(220, 8%, 40%); stroke-width: 0.6; }
	[data-dnintro] .dn-rim { stroke: hsl(210, 10%, 72%); stroke-width: 0.9; }
	[data-dnintro] .dn-chassis { fill: hsl(220, 10%, 22%); }
	[data-dnintro] .dn-cab { fill: var(--ig-vx); stroke: hsl(222, 35%, 14%); stroke-width: 0.6; stroke-linejoin: round; }
	[data-dnintro] .dn-bed { fill: hsl(28, 30%, 35%); }
	[data-dnintro] .dn-crate { fill: color-mix(in oklab, var(--ig-v) 50%, hsl(28, 40%, 40%)); stroke: hsl(28, 40%, 24%); stroke-width: 0.7; }
	[data-dnintro] .dn-crate--b { fill: color-mix(in oklab, var(--ig-v) 35%, hsl(28, 40%, 34%)); }
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { person, ANKLE, type Pose } from '../davlenie-zakon-paskalya/person';

	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-dnintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="skate"]')!;
			const S = 0.45; // px per см
			const K = 45; // px per м
			const FLOOR = 212;
			const girl = person(card.querySelector<SVGGElement>('[data-girl]')!, { s: S, H: 140, girth: 0.92, gear: 'skate', coat: 'dn-coat--red' });
			const dad = person(card.querySelector<SVGGElement>('[data-dad]')!, { s: S, H: 180, girth: 1.12, gear: 'skate', coat: 'dn-coat--blue' });
			const ug = S * 140;
			const ud = S * 180;
			const tr1 = card.querySelector('[data-tr1]')!;
			const tr2 = card.querySelector('[data-tr2]')!;
			const C0 = 222; // where the palms meet at the start
			const gap0 = 0.3 * (ug + ud); // hip to hip at the start: arms bent, palms together
			const xg0 = C0 - gap0 * (ug / (ug + ud));
			const xd0 = C0 + gap0 * (ud / (ug + ud));
			// the path in metres from the start: push (0,5 с) with a, then a glide slowed by 0,1 м/с²
			const path = (t: number, a: number) => {
				const tp = Math.min(t, 0.5);
				let s = 0.5 * a * tp * tp;
				if (t > 0.5) {
					const v = a * 0.5;
					const tg = Math.min(t - 0.5, v / 0.1);
					s += v * tg - 0.05 * tg * tg;
				}
				return s;
			};
			// a person on skates, facing +x in its own frame (the father is drawn mirrored)
			const pose = (x: number, u: number, H: number, hands: [number, number] | null, glide: number): Pose => {
				const ank = FLOOR - ANKLE.skate * S;
				const hipY = ank - 0.455 * u;
				const hy = hipY - 0.26 * u;
				const free: [number, number][] = [
					[x + 0.16 * u, hipY - 0.06 * u],
					[x - 0.12 * u, hipY - 0.02 * u],
				];
				const h = hands
					? [
							{ x: hands[0], y: hy },
							{ x: hands[1], y: hy + 1 },
						]
					: free.map(([a, b]) => ({ x: a, y: b }));
				return {
					hip: { x, y: hipY },
					lean: hands ? 0.12 : -0.04 + 0.02 * glide,
					ankles: [
						{ x: x + 0.05 * u, y: ank },
						{ x: x - 0.06 * u, y: ank },
					],
					feet: [0, 0],
					hands: [h[0], h[1]],
				};
			};
			scene(card, 2.2, (q) => {
				const t = q * 2.2;
				const sg = path(t, 4) * K;
				const sd = path(t, 2) * K;
				const xg = xg0 - sg; // the girl goes left, facing right (her back first)
				const xd = xd0 + sd;
				const gap = xd - xg;
				const touch = gap <= 0.42 * (ug + ud) && t < 0.5;
				const c = xg + gap * (ug / (ug + ud));
				girl(pose(xg, ug, 140, touch ? [c - 0.5, c - 1.5] : null, Math.min(1, t)));
				// the father in the mirrored frame: x → −x
				dad(pose(-xd, ud, 180, touch ? [-c - 0.5, -c - 1.5] : null, Math.min(1, t)));
				const y1 = FLOOR + 1;
				tr1.setAttribute('d', sg > 1 ? `M${f1(xg0)} ${y1} H${f1(xg)}` : '');
				tr2.setAttribute('d', sd > 1 ? `M${f1(xd0)} ${y1 + 3} H${f1(xd)}` : '');
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="light"]')!;
			const K = 12; // px per м
			const car = card.querySelector<SVGGElement>('[data-car]')!;
			const truck = card.querySelector<SVGGElement>('[data-truck]')!;
			const red = card.querySelector('[data-red]')!;
			const green = card.querySelector('[data-green]')!;
			const wheels = (g: SVGGElement, s: number, r: number) => {
				for (const w of g.querySelectorAll<SVGGElement>('[data-w]')) {
					const base = w.getAttribute('transform')!.replace(/ rotate\(.*\)$/, '');
					w.setAttribute('transform', `${base} rotate(${f1(((s / r) * 180) / Math.PI)})`);
				}
			};
			scene(card, 3.2, (q) => {
				const t = q * 3.2;
				const go = q > 0;
				red.classList.toggle('is-red', !go);
				green.classList.toggle('is-green', go);
				const sc = 0.5 * 3 * t * t * K;
				const st = 0.5 * 0.8 * t * t * K;
				car.setAttribute('transform', `translate(${f1(146 + sc)} 188) scale(${K / 9})`);
				truck.setAttribute('transform', `translate(${f1(146 + st)} 220) scale(${K / 9})`);
				wheels(car, sc, 3.4 * (K / 9));
				wheels(truck, st, 4.5 * (K / 9));
			});
		}
	}
</script>
