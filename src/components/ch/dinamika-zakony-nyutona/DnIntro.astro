---
/**
 * Two looping opening scenes of «Законы Ньютона» (grade 10). No terms of the chapter in the pictures; the captions'
 * popovers explain. People: the shared people kit (src/components/people/).
 *
 * Sleds (real time, 4 с): a snowy park. A father (180 см, winter clothes) walks to the right and pulls a «train» of three
 *   wooden sleds tied one behind another; on each sits a child (about 7 years, 112–122 см) holding the side rail.
 *   Physics: each sled with its child 30 кг, μ = 0,05 on snow (friction 3 · 30 · 0,05 · 9,8 = 44 Н in all). From rest
 *   he starts them with a = 0,5 м/с² for 2 с (the front rope pulls with 3 · 30 · (0,5 + 0,49) ≈ 89 Н), reaching 1 м/с,
 *   then walks steadily at 1 м/с for 2 с (44 Н): 1 м + 2 м = 3 м in all. Scale 0,34 px per см (34 px per metre) for the
 *   people, the sleds and the path; the ropes are taut and 1,2 м long (the first one from his hand, 92 см above the
 *   snow, to the front of the first sled); the sleds are 90 см long, seat 25 см high. His steps are 63 см (0,35 H); the
 *   stance foot stays planted; while he speeds up he leans forward more. Runner tracks stay in the snow. Behind, about
 *   three times farther away (0,12 px per см), two people walk along a park path at about 1,1–1,2 м/с; snow falls at
 *   about 1 м/с. No force arrows or numbers in the picture.
 * Light (real time, 3,2 с): a street seen from the side, in perspective: the near lane at 14 px per metre, the far lane
 *   at 11 px per metre (about 1,3 times farther), the near sidewalk at 20 px per metre. At the green light a car
 *   (4,5 м, 1,3 т, near lane) starts with 3 м/с² and a city bus with passengers (12 м, about 15 т, far lane) with
 *   1,0 м/с² (traction about 3,9 кН and 15 кН, resistance neglected). (Until the review of 23 Nov 2026 it was a loaded
 *   truck; grade 9 already compares an empty and a loaded truck.) In 3,2 с the car goes 15,4 м, the bus 5,1 м. Wheels turn by the distance
 *   rolled. On the near sidewalk a mother (166 см) and her son (118 см) wait hand in hand at the crossing (the
 *   pedestrian light is red), and a man walks by at 1,3 м/с on his own clock: he walks off one edge and comes back in
 *   at the other (out of the picture), so the restart of the scene does not make him jump.
 *   The two far walkers of the park scene walk the same way, on the clock of the falling snow.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gSky = `dn-sky-${uid}`;
const gSky2 = `dn-sky2-${uid}`;
const f = (v: number) => v.toFixed(1);

// ---- park: far trees on a hill line, firs, lamps, a bench
let seed = 11;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const farTrees = Array.from({ length: 26 }, (_, i) => ({ x: i * 14 + rnd() * 8 - 4, h: 14 + rnd() * 12 }));
const fir = (x: number, y: number, h: number) => {
	const w = h * 0.42;
	const tiers = [0, 0.3, 0.58].map((k, i) => {
		const top = y - h + k * h;
		const ww = w * (0.55 + 0.22 * i);
		const bot = top + h * 0.42;
		return { tree: `M${f(x)} ${f(top)} L${f(x + ww)} ${f(bot)} L${f(x - ww)} ${f(bot)} Z`, snow: `M${f(x)} ${f(top)} L${f(x + ww * 0.45)} ${f(top + h * 0.17)} Q${f(x)} ${f(top + h * 0.12)} ${f(x - ww * 0.45)} ${f(top + h * 0.17)} Z` };
	});
	return { tree: tiers.map((t) => t.tree).join(' ') + ` M${f(x - 1.5)} ${f(y - h * 0.02)} h3 v${f(h * 0.1)} h-3 Z`, snow: tiers.map((t) => t.snow).join(' ') };
};
const firs = [fir(24, 160, 46), fir(58, 154, 34), fir(300, 158, 42), fir(338, 162, 52), fir(200, 150, 26)];
const lamps = [118, 262];

// ---- street: two rows of houses (the far ones paler and smaller)
const farHouses = [
	{ x: -6, w: 44, h: 70 },
	{ x: 40, w: 36, h: 84 },
	{ x: 80, w: 52, h: 62 },
	{ x: 136, w: 40, h: 90 },
	{ x: 180, w: 56, h: 74 },
	{ x: 240, w: 38, h: 96 },
	{ x: 282, w: 50, h: 68 },
	{ x: 334, w: 40, h: 86 },
];
const BASE = 126; // bottom of the near houses (the far sidewalk)
const nearHouses = [
	{ x: -4, w: 70, h: 64 },
	{ x: 70, w: 54, h: 80 },
	{ x: 186, w: 76, h: 58 },
	{ x: 268, w: 58, h: 74 },
	{ x: 330, w: 40, h: 62 },
];
const nearWin = nearHouses.flatMap((h, i) => {
	const out: { x: number; y: number; lit: boolean }[] = [];
	for (let y = BASE - h.h + 8; y < BASE - 16; y += 13)
		for (let x = h.x + 7; x < h.x + h.w - 9; x += 11) out.push({ x, y, lit: (x * 7 + y * 3 + i) % 5 === 0 });
	return out;
});
const trees = [140, 176, 326];
---

<PeopleStyles />
<IntroFrame data-dnintro>
	<div class="intro__card" data-scene="sleds">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимний парк. Папа идёт и тянет за верёвку трое санок, привязанных одни за другими; на каждых сидит ребёнок. Санки трогаются с места, разгоняются и едут за папой">
			<defs>
				<linearGradient id={gSky} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="dn-sky-top"></stop>
					<stop offset="1" class="dn-sky-low"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${gSky})`}></rect>
			<path class="dn-hill" d="M0 132 Q70 112 150 124 Q230 108 300 120 Q336 114 360 118 V240 H0 Z"></path>
			<path class="dn-far-tree" d={farTrees.map((t) => `M${f(t.x)} ${f(130 - t.h)} L${f(t.x + 4.5)} 131 L${f(t.x - 4.5)} 131 Z`).join(' ')}></path>
			<rect class="dn-snow" x="0" y="140" width="360" height="100"></rect>
			<path class="dn-path" d="M0 148 H360 V156 H0 Z"></path>
			<g data-far></g>
			{lamps.map((x) => (
				<g>
					<rect class="dn-lamp-post" x={x - 1} y="100" width="2" height="48"></rect>
					<path class="dn-lamp-head" d={`M${x - 5} 100 h10 l-2 -5 h-6 Z`}></path>
				</g>
			))}
			<path class="dn-bench" d="M236 150 h28 v2.5 h-28 Z M238 152 v6 h2 v-6 Z M260 152 v6 h2 v-6 Z M236 141 h28 v2.5 h-28 Z M238 143 v7 h2 v-7 Z M260 143 v7 h2 v-7 Z"></path>
			<path class="dn-bench-snow" d="M236 141 q14 -2.5 28 0 Z M236 150 q14 -2 28 0 Z"></path>
			<path class="dn-fir" d={firs.map((p) => p.tree).join(' ')}></path>
			<path class="dn-fir-snow" d={firs.map((p) => p.snow).join(' ')}></path>
			<path class="dn-drift" d="M0 200 Q40 194 90 199 Q160 192 230 198 Q300 193 360 197 V206 H0 Z"></path>
			<path class="dn-track" data-track d=""></path>
			<path class="dn-rope" data-ropes d=""></path>
			<g data-train></g>
			<g data-dad></g>
			<g data-flakes></g>
		</svg>
		<div class="intro__foot">
			<p>
				Папа катит детей{' '}
				<More term="«паровозиком» из трёх санок">
					Передняя верёвка тянет все трое санок, вторая — двое, последняя — только одни. Поэтому сильнее всех натянута передняя верёвка: пока папа разгоняет санки, около 89&nbsp;Н, а когда он идёт равномерно, — около 44&nbsp;Н. Об этом — в разделе <a href="#связанные-тела">«Связанные тела»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="light">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Улица у светофора. На зелёный свет легковой автомобиль быстро уезжает вперёд, а городской автобус медленно трогается. На тротуаре мама с сыном ждут у перехода, мимо идёт прохожий">
			<defs>
				<linearGradient id={gSky2} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="dn-sky2-top"></stop>
					<stop offset="1" class="dn-sky2-low"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="140" fill={`url(#${gSky2})`}></rect>
			{farHouses.map((h) => <rect class="dn-house-far" x={h.x} y={BASE - 6 - h.h} width={h.w} height={h.h + 6} />)}
			{nearHouses.map((h) => <rect class="dn-house" x={h.x} y={BASE - h.h} width={h.w} height={h.h} />)}
			{nearHouses.map((h) => <rect class="dn-cornice" x={h.x - 1} y={BASE - h.h} width={h.w + 2} height="3" />)}
			{nearWin.map((w) => <rect class={w.lit ? 'dn-win dn-win--lit' : 'dn-win'} x={w.x} y={w.y} width="6" height="8" />)}
			<rect class="dn-shop" x="130" y="98" width="50" height="28"></rect>
			<rect class="dn-shop-glass" x="134" y="104" width="42" height="18"></rect>
			<rect class="dn-awning" x="128" y="94" width="54" height="6"></rect>
			{trees.map((x) => (
				<g>
					<rect class="dn-trunk" x={x - 1.5} y="104" width="3" height="26" />
					<circle class="dn-crown" cx={x} cy="98" r="12" />
					<circle class="dn-crown dn-crown--b" cx={x + 7} cy="105" r="8" />
				</g>
			))}
			<rect class="dn-walk-far" x="0" y="126" width="360" height="12"></rect>
			<rect class="dn-curb" x="0" y="137" width="360" height="2"></rect>
			<rect class="dn-road" x="0" y="139" width="360" height="70"></rect>
			{Array.from({ length: 7 }, (_, i) => <rect class="dn-zebra" x={f(136 - i * 0.6)} y={141 + i * 10} width={f(26 + i * 1.2)} height="5" />)}
			<path class="dn-stop" d="M126 139 L122 209 L125 209 L129 139 Z"></path>
			<path class="dn-lane" d="M0 172 H360"></path>
			<rect class="dn-pole" x="117" y="80" width="2.4" height="50"></rect>
			<rect class="dn-tl" x="112" y="58" width="12.4" height="32" rx="3"></rect>
			<circle class="dn-lampoff" data-red cx="118.2" cy="65" r="3.6"></circle>
			<circle class="dn-lampoff" cx="118.2" cy="74" r="3.6"></circle>
			<circle class="dn-lampoff" data-green cx="118.2" cy="83" r="3.6"></circle>
			<g data-truck>
				<path class="dn-bus" d="M-108 -3 V-27 Q-108 -29 -106 -29 H-5 Q-1 -29 -0.5 -25 L0 -6 Q0 -3 -3 -3 Z"></path>
				<path class="dn-bus-stripe" d="M-108 -9 H0 V-7.5 H-108 Z"></path>
				{[0, 1, 2, 3, 4, 5, 6].map((i) => <rect class="dn-glass" x={-104 + i * 12.4} y="-25" width="10.4" height="10" rx="1" />)}
				<path class="dn-glass" d="M-10 -25 H-3.5 Q-1.8 -25 -1.6 -22.5 L-1.4 -14 H-10 Z"></path>
				{[-98.2, -85.8, -73.4, -61, -48.6, -36.2, -23.8].map((x, i) => <circle class="dn-head" cx={x + (i % 2 ? 1 : 0)} cy="-18" r="2" />)}
				<path class="dn-door" d="M-60 -24 V-4 M-56 -24 V-4 M-18 -24 V-4 M-14 -24 V-4"></path>
				<rect class="dn-sign" x="-30" y="-28.4" width="18" height="2.6" rx="0.6"></rect>
				{[-88, -20].map((x) => (
					<g data-w transform={`translate(${x} -4.5)`}><circle class="dn-tyre" r="4.5" /><path class="dn-rim" d="M-2.6 0 H2.6 M0 -2.6 V2.6" /></g>
				))}
			</g>
			<g data-car>
				<path class="dn-car" d="M-40.5 -4 L-40.5 -8 Q-40 -10.8 -36 -11 L-27 -11.3 L-20 -17.6 Q-18.5 -18.6 -15 -18.6 L-7 -18.6 Q-4.5 -18.6 -3 -16.4 L-1.2 -11.3 Q0 -10.8 0 -9 L0 -4 Z"></path>
				<path class="dn-glass" d="M-25.5 -11.6 L-19.5 -17.2 L-13 -17.2 L-13 -11.6 Z M-11.5 -11.6 L-11.5 -17.2 L-7.2 -17.2 Q-5 -17 -4 -15.4 L-2.6 -11.6 Z"></path>
				<circle class="dn-head" cx="-8" cy="-14" r="2.2"></circle>
				<rect class="dn-light-f" x="-1.6" y="-9.6" width="1.6" height="1.6"></rect>
				<g data-w transform="translate(-32 -3)"><circle class="dn-tyre" r="3.4"></circle><path class="dn-rim" d="M-2 0 H2 M0 -2 V2"></path></g>
				<g data-w transform="translate(-7 -3)"><circle class="dn-tyre" r="3.4"></circle><path class="dn-rim" d="M-2 0 H2 M0 -2 V2"></path></g>
			</g>
			<rect class="dn-curb" x="0" y="208" width="360" height="3"></rect>
			<rect class="dn-walk" x="0" y="211" width="360" height="29"></rect>
			<path class="dn-tiles" d={Array.from({ length: 19 }, (_, i) => `M${i * 20 + 4} 211 L${i * 20 - 6} 240`).join(' ') + ' M0 224 H360'}></path>
			<rect class="dn-pole" x="155" y="168" width="2.6" height="66"></rect>
			<rect class="dn-tl" x="150" y="158" width="12.6" height="20" rx="2.5"></rect>
			<path class="dn-walker-red" d="M156.3 161.2 a1.4 1.4 0 1 1 0.01 0 Z M154.4 164 h3.8 v5.2 h-1.1 v4 h-1.6 v-4 h-1.1 Z"></path>
			<g data-mom></g>
			<g data-son></g>
			<g data-man></g>
		</svg>
		<div class="intro__foot">
			<p>
				Загорелся зелёный: легковой автомобиль сразу уходит вперёд, а городской автобус{' '}
				<More term="разгоняется медленно, хотя его мотор тянет сильнее">
					Ускорение тела прямо пропорционально силе и обратно пропорционально массе. Автомобиль массой 1,3&nbsp;т разгоняет сила около 3,9&nbsp;кН, и его ускорение 3&nbsp;м/с². Автобус с пассажирами, около 15&nbsp;т, разгоняет сила около 15&nbsp;кН — почти вчетверо больше, но масса больше в 11,5 раза, и ускорение всего 1&nbsp;м/с². Об этом — в разделе <a href="#второй-закон-ньютона">«Второй закон Ньютона»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-dnintro] {
		--dn-sky-top: hsl(212, 40%, 26%);
		--dn-sky-low: hsl(210, 30%, 42%);
		--dn-snow: hsl(210, 30%, 86%);
		--dn-snow-shade: hsl(212, 30%, 74%);
		--dn-hill: hsl(212, 25%, 62%);
		--dn-far-tree: hsl(200, 18%, 36%);
		--dn-fir: hsl(150, 32%, 26%);
		--dn-path: hsl(212, 18%, 70%);
		--dn-sky2-top: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
		--dn-sky2-low: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-bg));
		--dn-house: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-5));
		--dn-house-far: color-mix(in oklab, var(--ig-vx) 22%, var(--sl-color-gray-5));
		--dn-road: hsl(220, 8%, 30%);
		--dn-walk: hsl(30, 8%, 52%);
		--dn-walk-far: hsl(30, 6%, 44%);
	}
	:root[data-theme='light'] [data-dnintro] {
		--dn-sky-top: hsl(208, 55%, 78%);
		--dn-sky-low: hsl(205, 45%, 90%);
		--dn-snow: hsl(205, 40%, 96%);
		--dn-snow-shade: hsl(210, 35%, 84%);
		--dn-hill: hsl(210, 30%, 84%);
		--dn-far-tree: hsl(200, 18%, 58%);
		--dn-fir: hsl(150, 35%, 30%);
		--dn-path: hsl(210, 20%, 86%);
		--dn-house: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-6));
		--dn-house-far: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-6));
		--dn-road: hsl(220, 8%, 48%);
		--dn-walk: hsl(30, 10%, 74%);
		--dn-walk-far: hsl(30, 8%, 66%);
	}
	[data-dnintro] .dn-sky-top { stop-color: var(--dn-sky-top); }
	[data-dnintro] .dn-sky-low { stop-color: var(--dn-sky-low); }
	[data-dnintro] .dn-sky2-top { stop-color: var(--dn-sky2-top); }
	[data-dnintro] .dn-sky2-low { stop-color: var(--dn-sky2-low); }
	[data-dnintro] .dn-hill { fill: var(--dn-hill); }
	[data-dnintro] .dn-far-tree { fill: var(--dn-far-tree); }
	[data-dnintro] .dn-snow { fill: var(--dn-snow); }
	[data-dnintro] .dn-drift { fill: var(--dn-snow-shade); opacity: 0.55; }
	[data-dnintro] .dn-path { fill: var(--dn-path); }
	[data-dnintro] .dn-fir { fill: var(--dn-fir); }
	[data-dnintro] .dn-fir-snow { fill: var(--dn-snow); opacity: 0.9; }
	[data-dnintro] .dn-lamp-post,
	[data-dnintro] .dn-lamp-head { fill: hsl(215, 12%, 30%); }
	[data-dnintro] .dn-bench { fill: hsl(28, 35%, 36%); }
	[data-dnintro] .dn-bench-snow { fill: var(--dn-snow); }
	[data-dnintro] .dn-track { fill: none; stroke: var(--dn-snow-shade); stroke-width: 1.3; }
	[data-dnintro] .dn-rope { fill: none; stroke: hsl(32, 40%, 38%); stroke-width: 1.1; stroke-linecap: round; }
	:root[data-theme='light'] [data-dnintro] .dn-rope { stroke: hsl(30, 45%, 30%); }
	[data-dnintro] .dn-runner { fill: none; stroke: hsl(355, 60%, 42%); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
	[data-dnintro] .dn-runner--far { stroke: hsl(355, 45%, 30%); }
	[data-dnintro] .dn-slat { fill: hsl(32, 50%, 58%); stroke: hsl(28, 40%, 30%); stroke-width: 0.6; }
	[data-dnintro] .dn-post { stroke: hsl(355, 50%, 36%); stroke-width: 1.6; }
	[data-dnintro] .dn-flake { fill: hsl(0, 0%, 100%); opacity: 0.85; }
	:root[data-theme='light'] [data-dnintro] .dn-flake { fill: hsl(210, 30%, 70%); }
	[data-dnintro] .dn-house { fill: var(--dn-house); stroke: var(--sl-color-gray-4); stroke-width: 0.6; }
	[data-dnintro] .dn-house-far { fill: var(--dn-house-far); opacity: 0.75; }
	[data-dnintro] .dn-cornice { fill: var(--sl-color-gray-4); }
	[data-dnintro] .dn-win { fill: var(--sl-color-gray-4); }
	[data-dnintro] .dn-win--lit { fill: hsl(45, 80%, 70%); }
	[data-dnintro] .dn-shop { fill: hsl(28, 30%, 40%); }
	[data-dnintro] .dn-shop-glass { fill: hsl(200, 40%, 70%); opacity: 0.8; }
	[data-dnintro] .dn-awning { fill: var(--ig-vy); }
	[data-dnintro] .dn-trunk { fill: hsl(28, 35%, 32%); }
	[data-dnintro] .dn-crown { fill: hsl(140, 35%, 38%); }
	[data-dnintro] .dn-crown--b { fill: hsl(140, 32%, 32%); }
	[data-dnintro] .dn-walk { fill: var(--dn-walk); }
	[data-dnintro] .dn-walk-far { fill: var(--dn-walk-far); }
	[data-dnintro] .dn-tiles { stroke: color-mix(in oklab, var(--dn-walk) 70%, black); stroke-width: 0.6; opacity: 0.6; }
	[data-dnintro] .dn-curb { fill: hsl(0, 0%, 78%); }
	[data-dnintro] .dn-road { fill: var(--dn-road); }
	[data-dnintro] .dn-zebra,
	[data-dnintro] .dn-stop { fill: hsl(0, 0%, 92%); opacity: 0.9; }
	[data-dnintro] .dn-lane { stroke: hsl(0, 0%, 92%); stroke-width: 1.3; stroke-dasharray: 12 10; }
	[data-dnintro] .dn-pole { fill: hsl(210, 8%, 45%); }
	[data-dnintro] .dn-tl { fill: hsl(220, 10%, 18%); stroke: hsl(220, 10%, 40%); stroke-width: 0.8; }
	[data-dnintro] .dn-lampoff { fill: hsl(220, 8%, 32%); }
	[data-dnintro] .dn-lampoff.is-red { fill: hsl(2, 85%, 58%); }
	[data-dnintro] .dn-lampoff.is-green { fill: hsl(140, 75%, 50%); }
	[data-dnintro] .dn-walker-red { fill: hsl(2, 85%, 58%); }
	[data-dnintro] .dn-car { fill: var(--ig-vy); stroke: hsl(222, 35%, 14%); stroke-width: 0.6; stroke-linejoin: round; }
	[data-dnintro] .dn-glass { fill: hsl(200, 40%, 78%); stroke: hsl(222, 35%, 14%); stroke-width: 0.4; }
	[data-dnintro] .dn-head { fill: hsl(25, 40%, 28%); }
	[data-dnintro] .dn-light-f { fill: hsl(48, 90%, 75%); }
	[data-dnintro] .dn-tyre { fill: hsl(220, 10%, 14%); stroke: hsl(220, 8%, 40%); stroke-width: 0.6; }
	[data-dnintro] .dn-rim { stroke: hsl(210, 10%, 72%); stroke-width: 0.9; }
	[data-dnintro] .dn-chassis { fill: hsl(220, 10%, 22%); }
	[data-dnintro] .dn-bus { fill: var(--ig-v); stroke: hsl(222, 35%, 14%); stroke-width: 0.6; stroke-linejoin: round; }
	[data-dnintro] .dn-bus-stripe { fill: var(--ig-vx); }
	[data-dnintro] .dn-door { stroke: hsl(222, 35%, 14%); stroke-width: 0.5; }
	[data-dnintro] .dn-sign { fill: hsl(30, 90%, 60%); }
	[data-dnintro] .dn-cab { fill: var(--ig-vx); stroke: hsl(222, 35%, 14%); stroke-width: 0.6; stroke-linejoin: round; }
	[data-dnintro] .dn-bed { fill: hsl(28, 30%, 35%); }
	[data-dnintro] .dn-crate { fill: color-mix(in oklab, var(--ig-v) 50%, hsl(28, 40%, 40%)); stroke: hsl(28, 40%, 24%); stroke-width: 0.7; }
	[data-dnintro] .dn-crate--b { fill: color-mix(in oklab, var(--ig-v) 35%, hsl(28, 40%, 34%)); }
</style>

<script>
	import { scene, loop } from '@components/intro/scene';
	import { figure, walk, ANKLE_CM, SKELETON, DEG, add, polar, mk, type Pt, type HandTarget, type Figure } from '@components/people';

	const f1 = (v: number) => v.toFixed(1);
	const rnd0 = (s: number) => () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);

	/**
	 * A walking person: the hip moves by `d` px from `base` (to the right for dir 1, to the left for −1), the feet are
	 * planted by the walk cycle, the arms swing; the near hand may instead go to a given target. `plant` false marks no
	 * foot as planted (the still start frame, so that the restart of the loop is not taken for a sliding foot).
	 */
	const walker = (p: Figure, H: number, S: number, ground: number, gear: number) => {
		const sk = SKELETON.adult;
		const u = S * H;
		const step = 0.35 * H * S;
		const ay = ground - gear * S;
		const legL = (sk.thigh + sk.shin) * u;
		const len = (sk.upper + sk.fore) * u * 0.95 + 0.045 * u;
		return (d: number, base: number, dir: 1 | -1, lean: number, near?: HandTarget, plant = true) => {
			const w = walk(d, step, 0, Math.max(0.05 * u, 1.6)); // tiny far people: a lift of at least 1,6 px
			const X = (x: number) => base + dir * x;
			const hip = { x: X(d), y: ay - legL * 0.93 + w.bob }; // this low the stance foot stays within reach (no sliding)
			const sh = p.shoulders(hip, lean);
			const swing = (s: Pt, a: number): HandTarget => ({ at: add(s, polar(len, Math.PI / 2 - dir * a)), pose: 'relaxed' });
			return p.pose({
				hip,
				lean,
				ankles: [
					{ x: X(w.feet[0].x + step * 0.5), y: ay - w.feet[0].up },
					{ x: X(w.feet[1].x + step * 0.5), y: ay - w.feet[1].up },
				],
				feet: [w.feet[0].toe, w.feet[1].toe],
				hands: [near ?? swing(sh[0], -20 * DEG * w.arm), swing(sh[1], 20 * DEG * w.arm)],
				planted: [plant && w.feet[0].planted, plant && w.feet[1].planted],
			});
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-dnintro]')) {
		// ------------------------------------------------------------------ sleds
		{
			const card = root.querySelector<HTMLElement>('[data-scene="sleds"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.34; // px per см
			const K = 34; // px per м
			const GROUND = 214;
			const RUN = 4;
			const ACC = 0.5;
			const T1 = 2; // s of speeding up
			const path = (t: number) => (t < T1 ? 0.5 * ACC * t * t : 0.5 * ACC * T1 * T1 + ACC * T1 * (t - T1)); // м
			// the father
			const HD = 180;
			const dad = figure($<SVGGElement>('[data-dad]'), { s: S, H: HD, clothes: 'winter', shirt: 'hm-blue', gear: 'boot', name: 'father' });
			const dadWalk = walker(dad, HD, S, GROUND, ANKLE_CM.boot);
			const XD0 = 228; // his hip at the start
			const handOff = { x: -25 * S, y: -92 * S }; // the rope hand: 25 см behind the hip, 92 см above the snow
			// the sleds, in local см: the back end of the runners at (0, 0), the front at x = 90
			const train = $<SVGGElement>('[data-train]');
			const ROPE = 120;
			const TIE = 15; // ropes tied 15 см above the snow
			const front1 = XD0 + handOff.x - Math.sqrt(ROPE * ROPE - (92 - TIE) * (92 - TIE)) * S; // the front of the first sled
			const kids = [
				{ H: 118, shirt: 'hm-red' },
				{ H: 122, shirt: 'hm-green' },
				{ H: 112, shirt: 'hm-gold' },
			];
			const cm = (x: number, y: number): Pt => ({ x: x * S, y: -y * S });
			const runner = (g: Element, cls: string, dy: number) =>
				mk(g, 'path', {
					class: cls,
					d: `M${f1(-2 * S)} ${f1(-(2 + dy) * S)} L${f1(76 * S)} ${f1(-(1 + dy) * S)} Q${f1(92 * S)} ${f1(-(1 + dy) * S)} ${f1(92 * S)} ${f1(-(12 + dy) * S)} Q${f1(92 * S)} ${f1(-(20 + dy) * S)} ${f1(82 * S)} ${f1(-(21 + dy) * S)}`,
				});
			const sleds = kids.map((k, i) => {
				const g = mk(train, 'g', {});
				// the far runner and the posts behind the child; the seat and the near runner in front
				runner(g, 'dn-runner dn-runner--far', 2.5);
				for (const x of [12, 64]) mk(g, 'path', { class: 'dn-post', d: `M${f1(x * S)} ${f1(-3 * S)} V${f1(-24 * S)}` });
				const kid = figure(mk(g, 'g', {}), { s: S, H: k.H, age: 'child', clothes: 'winter', shirt: k.shirt, gear: 'boot', name: `child-${i + 1}` });
				mk(g, 'path', { class: 'dn-slat', d: `M${f1(6 * S)} ${f1(-23 * S)} H${f1(80 * S)} V${f1(-27 * S)} H${f1(6 * S)} Z` });
				runner(g, 'dn-runner', 0);
				return { g, kid, x0: front1 - (90 + i * (90 + ROPE)) * S };
			});
			// the child on the sled (local frame), holding the side rail with both mittens, feet on the curled front
			const sit = (kid: Figure, H: number, look: number) =>
				kid.pose({
					hip: cm(30, 25 + 0.04 * H),
					lean: 0.12,
					head: look,
					ankles: [cm(64, 22), cm(61, 23)],
					feet: [-0.45, -0.45],
					hands: [
						{ at: cm(44, 26), pose: 'grip', d: 2.5, contact: 'sled-rail' },
						{ at: cm(46, 26.5), pose: 'grip', d: 2.5, contact: 'sled-rail' },
					],
				});
			const ropes = $<SVGPathElement>('[data-ropes]');
			const track = $<SVGPathElement>('[data-track]');
			// far walkers on the park path (0,12 px per см), one each way
			const FS = 0.12;
			const farG = $<SVGGElement>('[data-far]');
			const farPeople = [
				{ H: 170, shirt: 'hm-red', x0: 300, dir: -1 as const, v: 1.2 },
				{ H: 160, shirt: 'hm-gold', x0: 90, dir: 1 as const, v: 1.1 },
			].map((o, i) => {
				const p = figure(mk(farG, 'g', {}), { s: FS, H: o.H, clothes: 'winter', shirt: o.shirt, gear: 'boot', dir: o.dir, name: `far-${i + 1}` });
				return { ...o, w: walker(p, o.H, FS, 153, ANKLE_CM.boot) };
			});
			const draw = (t: number, plant: boolean) => {
				const s = path(t) * K; // px moved
				// while he speeds the sleds up he leans forward more
				const lean = 0.12 + 0.1 * (t < T1 ? 1 : Math.max(0, 1 - (t - T1) / 0.6));
				const hand: Pt = { x: XD0 + s + handOff.x, y: GROUND + handOff.y };
				dadWalk(s, XD0, 1, lean, { at: hand, pose: 'grip', d: 2, contact: 'rope' }, plant);
				// the sleds follow with the same displacement (taut ropes)
				let d = `M${f1(hand.x)} ${f1(hand.y)}`;
				sleds.forEach((sl, i) => {
					const x = sl.x0 + s;
					sl.g.setAttribute('transform', `translate(${f1(x)} ${GROUND})`);
					sit(sl.kid, kids[i].H, i === 1 ? -0.08 : 0.05);
					d += ` L${f1(x + 88 * S)} ${f1(GROUND - TIE * S)}`;
					if (i < 2) d += ` M${f1(x)} ${f1(GROUND - TIE * S)}`;
				});
				ropes.setAttribute('d', d);
				const back3 = sleds[2].x0;
				const front = sleds[0].x0 + s + 90 * S;
				track.setAttribute('d', `M${f1(back3)} ${GROUND + 0.6} H${f1(front)} M${f1(back3)} ${GROUND + 2.4} H${f1(front)}`);
			};
			scene(card, RUN, (x) => draw(x * RUN, x > 0));
			// falling snow, all the time
			const flakesG = $<SVGGElement>('[data-flakes]');
			const r = rnd0(7);
			const flakes = Array.from({ length: 34 }, () => ({ x: r() * 360, y: r() * 240, rad: 0.6 + r() * 0.9, v: 20 + r() * 14, ph: r() * 6.3 }));
			const els = flakes.map((fl) => mk(flakesG, 'circle', { class: 'dn-flake', r: f1(fl.rad) }));
			let tf = 0;
			const snow = () =>
				flakes.forEach((fl, i) => {
					els[i].setAttribute('cx', f1(fl.x + 4 * Math.sin(fl.ph + tf * 1.3)));
					els[i].setAttribute('cy', f1((((fl.y + fl.v * tf) % 250) + 250) % 250 - 5));
				});
			// the far walkers: off one edge, back in at the other (out of the picture), 400 px of path
			const prevD = farPeople.map(() => -1);
			const walkers = () =>
				farPeople.forEach((fp, i) => {
					const d = (fp.v * 100 * FS * tf + (fp.dir < 0 ? 380 - fp.x0 : fp.x0 + 20)) % 400;
					const wrapped = d < prevD[i];
					prevD[i] = d;
					fp.w(d, fp.dir < 0 ? 380 : -20, fp.dir, 0.05, undefined, !wrapped);
				});
			snow();
			walkers();
			loop(card, (dt) => {
				tf += dt;
				snow();
				walkers();
				return true;
			});
		}
		// ------------------------------------------------------------------ light
		{
			const card = root.querySelector<HTMLElement>('[data-scene="light"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const KN = 14; // px per м, near lane
			const KF = 11; // px per м, far lane
			const X0 = 121; // both fronts at the stop line
			const car = $<SVGGElement>('[data-car]');
			const truck = $<SVGGElement>('[data-truck]');
			const red = $('[data-red]');
			const green = $('[data-green]');
			const wheels = (g: SVGGElement, s: number, r: number) => {
				for (const w of g.querySelectorAll<SVGGElement>('[data-w]')) {
					const base = w.getAttribute('transform')!.replace(/ rotate\(.*\)$/, '');
					w.setAttribute('transform', `${base} rotate(${f1(((s / r) * 180) / Math.PI)})`);
				}
			};
			// people on the near sidewalk, 0,2 px per см
			const S = 0.2;
			const FEET = 233;
			const mom = figure($<SVGGElement>('[data-mom]'), { s: S, H: 166, clothes: 'home', shirt: 'hm-red', hair: 'pony', dir: -1, name: 'mother' });
			const son = figure($<SVGGElement>('[data-son]'), { s: S, H: 118, age: 'child', clothes: 'indoor', shirt: 'hm-gold', hair: 'short', dir: -1, name: 'son' });
			const man = figure($<SVGGElement>('[data-man]'), { s: S, H: 178, clothes: 'home', shirt: 'hm-green', name: 'passer-by' });
			const manWalk = walker(man, 178, S, FEET + 2, ANKLE_CM.lowshoe);
			const MX = 178; // the mother's hip
			const BX = 168; // the son's hip, nearer the crossing
			const hold: Pt = { x: 174, y: FEET - 0.47 * 166 * S };
			const stand = (look: number) => {
				const uM = 166 * S;
				const uB = 118 * S;
				mom.pose({
					hip: { x: MX, y: FEET - 0.52 * uM },
					lean: 0,
					head: look,
					ankles: [
						{ x: MX - 2, y: FEET - 0.045 * uM },
						{ x: MX + 2.5, y: FEET - 0.045 * uM },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: hold, pose: 'grip', d: 4, contact: 'son-hand' },
						{ at: { x: MX + 2, y: FEET - 0.43 * uM }, pose: 'relaxed' },
					],
				});
				son.pose({
					hip: { x: BX, y: FEET - 0.48 * uB },
					lean: 0.02,
					head: look - 0.12,
					ankles: [
						{ x: BX - 1.5, y: FEET - 0.045 * uB },
						{ x: BX + 2, y: FEET - 0.045 * uB },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: hold, pose: 'grip', d: 4, contact: 'mother-hand' },
						{ at: { x: BX - 1, y: FEET - 0.42 * uB }, pose: 'relaxed' },
					],
				});
			};
			// the passer-by walks on his own clock: 420 px of path from x = −30, off the picture at both ends
			let tm = 0;
			let prevM = -1;
			const walkMan = () => {
				const d = (130 * S * tm + 48) % 420;
				const wrapped = d < prevM;
				prevM = d;
				manWalk(d, -30, 1, 0.05, undefined, !wrapped);
			};
			walkMan();
			loop(card, (dt) => {
				tm += dt;
				walkMan();
				return true;
			});
			scene(card, 3.2, (q) => {
				const t = q * 3.2;
				const go = q > 0;
				red.classList.toggle('is-red', !go);
				green.classList.toggle('is-green', go);
				const sc = 0.5 * 3 * t * t * KN;
				const st = 0.5 * 1.0 * t * t * KF;
				car.setAttribute('transform', `translate(${f1(X0 + sc)} 205) scale(${KN / 9})`);
				truck.setAttribute('transform', `translate(${f1(X0 + st)} 167) scale(${KF / 9})`);
				wheels(car, sc, 3.4 * (KN / 9));
				wheels(truck, st, 4.5 * (KF / 9));
				stand(0.1);
			});
		}
	}
</script>
