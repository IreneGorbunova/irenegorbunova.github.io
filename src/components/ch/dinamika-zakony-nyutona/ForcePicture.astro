---
/**
 * «Сила — вектор» (after the definition of force): a crate on the floor pulled by a rope tied to a ring on its top.
 * The force of the rope F = 40 Н (blue, elastic force) starts at the ring — the point of application — and points along
 * the rope; its length is the modulus, 3 px per newton (a scale bar of 10 Н = 30 px). Axes x (along the floor) and y
 * (up) start at the ring; dashed lines drop the projections F_x = F cos α and F_y = F sin α onto them, drawn as wide
 * translucent strips. The angle α eases 0° → 60° (3 с), holds 1 с, eases back to 0° (3 с) and holds 1 с; the numbers
 * beside the picture follow: at 30° F_x ≈ 34,6 Н, F_y = 20,0 Н; at 60° 20,0 Н and 34,6 Н; at 0° 40,0 Н and 0. The crate
 * does not move: the picture shows only one force (the others are not drawn). Someone out of the picture pulls the rope.
 */
import DzStyles from './DzStyles.astro';

const O = { x: 110, y: 120 };
const hatch = Array.from({ length: 40 }, (_, i) => `M${i * 10} 214 L${i * 10 + 12} 182`).join(' ');
---

<DzStyles />
<figure class="g7 fpic not-content" data-fpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 214" role="img" aria-label="Ящик тянут за верёвку, привязанную к кольцу на его крышке. Стрелка силы начинается в точке приложения и направлена вдоль верёвки, её длина — модуль силы. Пунктиром показаны проекции силы на оси x и y; угол верёвки к полу меняется от 0 до 60 градусов">
			<rect class="dz-ground" x="0" y="180" width="380" height="34"></rect>
			<path class="dz-hatch" d={hatch}></path>
			<path class="dz-gline" d="M0 180 H380"></path>
			<rect class="dz-wood" x="30" y="124" width="100" height="56" rx="2"></rect>
			<path class="fpic-plank" d="M30 142 H130 M30 162 H130 M36 176 L124 128"></path>
			<path class="fpic-ring" d={`M${O.x - 4} 124 a4 4 0 0 1 8 0`}></path>
			<path class="fpic-rope" data-rope></path>
			<!-- axes -->
			<path class="dz-axis" d={`M${O.x} ${O.y} H360 M${O.x} ${O.y} V14`}></path>
			<path class="dz-axhd" d={`M366 ${O.y} l-8 -3.5 v7 Z M${O.x} 8 l-3.5 8 h7 Z`}></path>
			<text class="t-i" x="358" y={O.y + 18}>x</text>
			<text class="t-i" x={O.x - 14} y="18">y</text>
			<!-- projections -->
			<path class="fpic-strip" data-px></path>
			<path class="fpic-strip" data-py></path>
			<path class="dz-dash dz-s--el" data-dx></path>
			<path class="dz-dash dz-s--el" data-dy></path>
			<path class="ln" data-arc></path>
			<text class="t-i dz-lab" data-alab>α</text>
			<path class="dz-f--el" data-arrow></path>
			<circle class="dz-dot" cx={O.x} cy={O.y} r="3"></circle>
			<g data-flab><text class="dz-sym dz-t--el" data-fl>F</text><path class="dz-over dz-s--el" data-flo></path></g>
			<text class="dz-sym dz-t--el" data-fxl>F<tspan class="dz-sub" dy="4">x</tspan></text>
			<text class="dz-sym dz-t--el" data-fyl>F<tspan class="dz-sub" dy="4">y</tspan></text>
			<text class="dz-lab" x="8" y="50">направление</text>
			<path class="dz-lead" data-dirl></path>
			<!-- the other two properties: the point of application and the modulus with its scale -->
			<text class="dz-lab" x="8" y="92">точка</text>
			<text class="dz-lab" x="8" y="106">приложения</text>
			<path class="dz-lead" d={`M72 104 L${O.x - 4} ${O.y - 3}`}></path>
			<text class="dz-lab" x="236" y="158">модуль — длина стрелки</text>
			<path class="dz-f--el" d="M236 166.5 h30 v3 h-30 Z"></path>
			<path class="ln" d="M236 163 v10 M266 163 v10"></path>
			<text class="dz-lab" x="274" y="172">10 Н</text>
		</svg>
		<div class="g7__side">
			<ul class="g7__read">
				<li>Угол верёвки к полу <b data-ra></b></li>
				<li>Модуль силы <b>40 Н</b></li>
				<li class="is-key"><span><i>F<sub>x</sub></i> = <i>F</i> cos α</span> <b data-rx></b></li>
				<li class="is-key"><span><i>F<sub>y</sub></i> = <i>F</i> sin α</span> <b data-ry></b></li>
			</ul>
			<p class="g7__note">Чем круче поднята верёвка, тем меньше проекция силы на ось <i>x</i> и тем больше — на ось <i>y</i>. Модуль силы не меняется.</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Сила верёвки 40&nbsp;Н; отрезок «10&nbsp;Н» внизу показывает масштаб. Пунктир опускает проекции силы на оси. Остальные силы, действующие на ящик, не показаны.
	</figcaption>
</figure>

<style is:global>
	.fpic-plank {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.fpic-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.fpic-rope {
		fill: none;
		stroke: hsl(32, 40%, 50%);
		stroke-width: 1.6;
	}
	:root[data-theme='light'] .fpic-rope {
		stroke: hsl(30, 45%, 34%);
	}
	.fpic-strip {
		fill: none;
		stroke: var(--dz-el);
		stroke-width: 7;
		opacity: 0.3;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';
	import { arrowPath, over, fmt } from './dz';

	const O = { x: 110, y: 120 };
	const KF = 3; // px per newton
	const F = 40;
	const f1 = (v: number) => v.toFixed(1);
	const angle = (t: number) => {
		const u = t % 8;
		if (u < 3) return 60 * ease(u / 3);
		if (u < 4) return 60;
		if (u < 7) return 60 * (1 - ease((u - 4) / 3));
		return 0;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-fpic]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const set = (s: string, a: Record<string, string>) => {
			const e = $(s);
			for (const k in a) e.setAttribute(k, a[k]);
		};
		let t = 0;
		const draw = () => {
			const deg = angle(t);
			const a = (deg * Math.PI) / 180;
			const c = Math.cos(a);
			const s = Math.sin(a);
			const L = F * KF;
			const tip = { x: O.x + L * c, y: O.y - L * s };
			// the rope goes on out of the picture
			const far = 400;
			set('[data-rope]', { d: `M${O.x} ${O.y - 1} L${f1(O.x + far * c)} ${f1(O.y - far * s)}` });
			set('[data-arrow]', { d: arrowPath(O.x, O.y, tip.x, tip.y, 3.2, 12) });
			const fx = L * c;
			const fy = L * s;
			set('[data-px]', { d: fx > 1 ? `M${O.x} ${O.y} H${f1(tip.x)}` : '' });
			set('[data-py]', { d: fy > 1 ? `M${O.x} ${O.y} V${f1(tip.y)}` : '' });
			set('[data-dx]', { d: fy > 3 ? `M${f1(tip.x)} ${f1(tip.y)} V${O.y}` : '' });
			set('[data-dy]', { d: fy > 3 && fx > 3 ? `M${f1(tip.x)} ${f1(tip.y)} H${O.x}` : '' });
			// the angle and its letter (only when there is room)
			const r = 30;
			set('[data-arc]', { d: deg > 2 ? `M${O.x + r} ${O.y} A${r} ${r} 0 0 0 ${f1(O.x + r * c)} ${f1(O.y - r * s)}` : '' });
			const am = a / 2;
			set('[data-alab]', { x: f1(O.x + 40 * Math.cos(am) - 3), y: f1(O.y - 40 * Math.sin(am) + 5), opacity: deg > 14 ? '1' : '0' });
			// F beside the tip: above it for gentle angles, to the right below it for steep ones (the rope goes on up)
			const fl = deg <= 40 ? { x: tip.x + 4 * c - 14 * s - 4, y: tip.y - 4 * s - 14 * c + 4 } : { x: tip.x + 8, y: tip.y + 14 };
			set('[data-fl]', { x: f1(fl.x), y: f1(fl.y) });
			set('[data-flo]', { d: over(fl.x, fl.y, 10) });
			// F_x under the axis at the end of its strip; F_y right of the y axis, under the dashed line
			set('[data-fxl]', { x: f1(O.x + fx - 22), y: f1(O.y + 18) });
			set('[data-fyl]', { x: f1(O.x + 5), y: f1(tip.y + 16), opacity: fy > 36 ? '1' : '0' });
			// the leader from «направление» to the middle of the shaft
			set('[data-dirl]', { d: `M84 47 L${f1(O.x + 0.55 * L * c)} ${f1(O.y - 0.55 * L * s)}` });
			$('[data-ra]').textContent = `${Math.round(deg)}°`;
			$('[data-rx]').textContent = `${fmt(F * c, 1)} Н`;
			$('[data-ry]').textContent = `${fmt(F * s, 1)} Н`;
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		})();
		draw();
	}
</script>
