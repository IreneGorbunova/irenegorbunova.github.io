---
/**
 * «Вагон и платформа»: one motion seen from two frames of reference. A wagon 8 м long (drawn cut open) has a
 * smooth shelf along its whole length (no friction) with a puck in the middle, and a plumb line 1,5 м long under the
 * ceiling. Four cases, each played for 2,5 с in real time and repeated: the wagon stands; goes evenly at 1,5 м/с;
 * starts from rest with 1,2 м/с²; brakes from 3 м/с with 1,2 м/с² (it stops at 2,5 с). Nothing acts on the puck
 * along the shelf, so relative to the platform it keeps its speed (the speed of the wagon at the start); relative to
 * the wagon it moves with −a, 3,75 м in 2,5 с. The plumb settles at tg θ = a/g (7,0° for 1,2 м/с²) within about
 * 0,3 с (a damped swing, simplified to an easing). Scale: 20 px per metre in both rows; the plumb line is to scale,
 * so its 7° is small — the readout gives the angle.
 * Top row: the camera stands on the platform. Bottom row: the camera rides in the wagon, the platform moves.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const K = 20;
const row = (y0: number) => y0;
---

<G7Styles />
<figure class="g7 g7--stack frm not-content" data-frm>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 262" role="img" aria-label="Вагон с шайбой на гладкой полке и отвесом: вид с платформы и вид из вагона" data-svg>
			<defs>
				<marker id={`frm-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class="head--gold" d="M0,0 L10,5 L0,10 z" /></marker>
				<clipPath id={`frm-c1-${uid}`}><rect x="0" y="0" width="380" height="128" /></clipPath>
				<clipPath id={`frm-c2-${uid}`}><rect x="0" y="132" width="380" height="130" /></clipPath>
			</defs>
			{[0, 132].map((y0, r) => (
				<g clip-path={`url(#frm-c${r + 1}-${uid})`} data-row={r}>
					<rect class="frm__sky" x="0" y={row(y0)} width="380" height="128" />
					<g data-ground>
						{Array.from({ length: 24 }, (_, i) => (
							<g>
								<rect class="frm__post" x={i * 2 * K - 2} y={y0 + 42} width="4" height="62" />
								<rect class="frm__lamp" x={i * 2 * K - 7} y={y0 + 38} width="14" height="5" rx="2" />
								<text class="t-small" x={i * 2 * K} y={y0 + 124} text-anchor="middle">{i * 2}</text>
							</g>
						))}
						<rect class="frm__platform" x="-400" y={y0 + 104} width="1400" height="10" />
					</g>
					<g data-wagon>
						<rect class="frm__body" x="0" y={y0 + 46} width="160" height="52" rx="4" />
						<rect class="frm__inside" x="5" y={y0 + 51} width="150" height="42" rx="2" />
						<rect class="frm__shelf" x="5" y={y0 + 80} width="150" height="4" />
						<line class="frm__vert" x1="120" x2="120" y1={y0 + 51} y2={y0 + 84} />
						<line class="frm__thread" data-thread x1="120" y1={y0 + 51} x2="120" y2={y0 + 81} />
						<circle class="frm__bob" data-bob cx="120" cy={y0 + 81} r="3" />
						<g data-wheels>
							{[18, 40, 120, 142].map((x) => <g data-w data-x={x} transform={`translate(${x} ${y0 + 99})`}><circle class="frm__wheel" r="5" /><path class="frm__spoke" d="M-4 0 H4 M0 -4 V4" /></g>)}
						</g>
					</g>
					<g data-puck>
						<rect class="frm__puck" x="-6" y={y0 + 76} width="12" height="4" rx="1.5" />
						<line class="arrow arrow--gold" data-arr y1={y0 + 70} y2={y0 + 70} marker-end={`url(#frm-${uid})`} />
					</g>
					<text class="t-title t-halo" x="8" y={y0 + 16}>{r === 0 ? 'Смотрим с платформы' : 'Смотрим из вагона'}</text>
					<text class="t-strong t-num t-halo" x="372" y={y0 + 16} text-anchor="end" data-pv></text>
					<text class="t-small t-halo" x="372" y={y0 + 31} text-anchor="end" data-pa></text>
				</g>
			))}
			<line class="frm__split" x1="0" x2="380" y1="130" y2="130" />
		</svg>
		<div class="g7__side frm__side">
			<div class="g7__seg" role="group" aria-label="Как движется вагон" data-mode>
				<button type="button" class="g7__btn" aria-pressed="true" data-m="stand">Вагон стоит</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-m="even">Едет равномерно</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-m="go">Разгоняется</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-m="brake">Тормозит</button>
			</div>
			<ul class="g7__read">
				<li>Время <b data-t></b></li>
				<li>Вагон относительно платформы <b data-wv></b></li>
				<li class="is-warm">Шайба относительно платформы <b data-p1></b></li>
				<li class="is-key">Шайба относительно вагона <b data-p2></b></li>
				<li>Отвес отклонён от вертикали <b data-th></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Полка в вагоне гладкая: трения нет, вдоль полки на шайбу ничего не действует. Золотая стрелка — скорость шайбы в той системе отсчёта, откуда мы смотрим. Числа под платформой — метры. Масштаб 20&nbsp;px на метр, время настоящее; каждый случай длится 2,5&nbsp;с и повторяется.
	</figcaption>
</figure>

<style is:global>
	.frm__side .g7__seg {
		justify-self: start;
	}
	.frm__side {
		grid-template-columns: minmax(0, 1fr);
	}
	.frm__sky {
		fill: var(--g7-sky);
	}
	.frm__platform {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 60%, var(--g7-paper));
	}
	.frm__post {
		fill: var(--sl-color-gray-4);
	}
	.frm__lamp {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
	}
	.frm__body {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.frm__inside {
		fill: var(--g7-paper);
		opacity: 0.92;
	}
	.frm__shelf {
		fill: var(--g7-wood);
	}
	.frm__vert {
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-dasharray: 2 3;
	}
	.frm__thread {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.frm__bob {
		fill: var(--g7-red);
	}
	.frm__puck {
		fill: var(--g7-ink);
	}
	.frm__wheel {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.frm__spoke {
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.frm__split {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
</style>

<script>
	import { fmt, loop, segment } from '../g7/kit';

	const K = 20; // px per metre
	const G = 9.8;
	const T = 2.5; // s of one run
	const CASES: Record<string, { v0: number; a: number }> = {
		stand: { v0: 0, a: 0 },
		even: { v0: 1.5, a: 0 },
		go: { v0: 0, a: 1.2 },
		brake: { v0: 3, a: -1.2 },
	};
	const X0 = 2; // м, the left end of the wagon at the start (top row)
	const XC = 5.5; // м, the left end of the wagon in the bottom row
	for (const root of document.querySelectorAll<HTMLElement>('[data-frm]')) {
		const q = <T extends Element>(s: string, r: Element = root) => r.querySelector<T>(s)!;
		const rows = [...root.querySelectorAll<SVGGElement>('[data-row]')];
		let mode = 'stand';
		let t = 0;
		const sign = (v: number, d = 1) => (Math.abs(v) < 0.005 ? `0` : `${fmt(Math.abs(v), d)}`);
		const dirWord = (v: number) => (Math.abs(v) < 0.005 ? '' : v > 0 ? ' вперёд' : ' назад');
		const draw = () => {
			const { v0, a } = CASES[mode];
			const xw = v0 * t + 0.5 * a * t * t; // м, the wagon relative to the platform
			const vw = v0 + a * t;
			const xp = 4 + v0 * t; // м, the puck relative to the platform, from the wagon's start
			const rel = xp - 4 - xw; // м, the puck relative to the wagon's middle
			const vrel = -a * t;
			const th = Math.atan(a / G) * Math.min(1, t / 0.3);
			rows.forEach((g, r) => {
				const y0 = r === 0 ? 0 : 132;
				const shift = r === 0 ? 0 : -xw; // the platform shifts in the bottom row
				const left = r === 0 ? X0 + xw : XC; // м, the wagon's left end on the screen
				q<SVGGElement>('[data-ground]', g).setAttribute('transform', `translate(${(shift * K + (r === 0 ? 0 : (XC - X0) * K)).toFixed(1)} 0)`);
				q<SVGGElement>('[data-wagon]', g).setAttribute('transform', `translate(${(left * K).toFixed(1)} 0)`);
				for (const w of g.querySelectorAll<SVGGElement>('[data-w]')) w.setAttribute('transform', `translate(${w.dataset.x} ${y0 + 99}) rotate(${((xw / 0.25) * 57.3).toFixed(1)})`);
				const px = (left + 4 + rel) * K;
				q<SVGGElement>('[data-puck]', g).setAttribute('transform', `translate(${px.toFixed(1)} 0)`);
				const v = r === 0 ? v0 : vrel;
				const arr = q<SVGLineElement>('[data-arr]', g);
				arr.setAttribute('x1', '0');
				arr.setAttribute('x2', (Math.sign(v) * Math.max(0, Math.abs(v) * 14 - 3)).toFixed(1));
				arr.style.visibility = Math.abs(v) > 0.05 ? 'visible' : 'hidden';
				const L = 30;
				const bx = 120 - L * Math.sin(th);
				const by = y0 + 51 + L * Math.cos(th);
				q('[data-thread]', g).setAttribute('x2', bx.toFixed(2));
				q('[data-thread]', g).setAttribute('y2', by.toFixed(2));
				q('[data-bob]', g).setAttribute('cx', bx.toFixed(2));
				q('[data-bob]', g).setAttribute('cy', by.toFixed(2));
				q('[data-pv]', g).textContent = `шайба: ${sign(v, 1)} м/с${dirWord(v)}`;
				q('[data-pa]', g).textContent = r === 0 ? 'ускорение шайбы 0' : `ускорение шайбы ${sign(-a, 1)} м/с²${dirWord(-a)}`;
			});
			q('[data-t]').textContent = `${fmt(t, 1)} с`;
			q('[data-wv]').textContent = `${fmt(vw, 1)} м/с, ускорение ${sign(a)} м/с²`;
			q('[data-p1]').textContent = `${fmt(v0, 1)} м/с, ускорение 0`;
			q('[data-p2]').textContent = `${sign(vrel)} м/с${dirWord(vrel)}, ускорение ${sign(-a)}${a ? ' м/с²' : ''}${dirWord(-a)}`;
			q('[data-th]').textContent = Math.abs(a) < 0.01 ? '0°' : `${fmt((Math.atan(Math.abs(a) / G) * 180) / Math.PI, 0)}°${a > 0 ? ' назад' : ' вперёд'}`;
		};
		const wake = loop(root, (dt) => {
			t += dt;
			if (t > T + 1) t = 0;
			const keep = t;
			t = Math.min(t, T);
			draw();
			t = keep;
			return true;
		});
		segment(q('[data-mode]'), (b) => {
			mode = b.dataset.m!;
			t = 0;
			draw();
			wake();
		});
		draw();
	}
</script>
