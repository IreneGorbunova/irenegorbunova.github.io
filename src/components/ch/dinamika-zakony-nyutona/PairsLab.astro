---
/**
 * «Пары сил»: a man (176 см) walks at 0,8 м/с and pulls a crate of 40 кг on a rope across a wooden floor; the camera
 * follows him (the floor boards slide by). The crate goes evenly, so the rope pulls it with the friction of the floor:
 * μ = 0,4, F = 0,4 · 40 кг · 9,8 м/с² ≈ 157 Н (the rope is light and horizontal: it is tied to the crate at the height of the man's hands, 84 см). Four pairs of forces of the
 * third law, one at a time: the rope on the crate and on the man (157 Н, elastic, blue); the floor on the soles of the
 * man and the soles on the floor (static friction 157 Н, red); the floor on the crate and the crate on the floor
 * (sliding friction 157 Н, red); the Earth on the crate and the crate on the Earth (392 Н, gravitation, violet).
 * Scale: 0,5 px per см for the picture, 0,15 px per newton for the arrows. Real time.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const FLOOR = 168;
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--stack prs3 not-content" data-prs3>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 64 380 172" role="img" aria-label="Человек тянет ящик на верёвке; стрелками показаны две силы одной пары, приложенные к разным телам" data-svg>
			<defs>
				{['blue', 'red', 'violet'].map((c) => <marker id={`p3-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`prs3__h--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<rect class="prs3__wall" x="0" y="0" width="380" height={FLOOR} />
			<rect class="prs3__skirt" x="0" y={FLOOR - 6} width="380" height="6" />
			<rect class="prs3__floor" x="0" y={FLOOR} width="380" height="30" />
			<g data-seams></g>
			<rect class="prs3__earth" x="0" y={FLOOR + 30} width="380" height={236 - FLOOR - 30} />
			<text class="t-small prs3__earthlab" x="8" y="230">Земля</text>
			<path class="prs3__rope" data-rope />
			<g data-crate>
				<rect class="prs3__crate" x="-30" y="-44" width="30" height="44" rx="1.5" />
				<path class="prs3__plank" d="M-30 -30 H0 M-30 -15 H0 M-27 -3 L-3 -41" />
			</g>
			<g data-man></g>
			<g data-arrows>
				<line class="prs3__arr" data-a1 />
				<line class="prs3__arr" data-a2 />
				<circle class="prs3__dot" data-d1 r="2.5" />
				<circle class="prs3__dot" data-d2 r="2.5" />
				<text class="t-small t-halo prs3__lab" data-l1></text>
				<text class="t-small t-halo prs3__lab" data-l2></text>
			</g>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Какую пару сил показать" data-pair>
				<button type="button" class="g7__btn" aria-pressed="true" data-p="rope">Верёвка: человек и ящик</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="feet">Подошвы и пол</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="box">Ящик и пол</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="earth">Земля и ящик</button>
			</div>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Ящик массой 40&nbsp;кг едет по полу равномерно, коэффициент трения 0,4; верёвка горизонтальна. Точка у начала стрелки — место, где сила приложена. Все стрелки в одном масштабе. Время настоящее.
	</figcaption>
</figure>

<style is:global>
	.prs3 {
		--prs3-violet: var(--g7-violet);
	}
	.prs3__wall {
		fill: color-mix(in oklab, var(--ig-v) 8%, var(--g7-paper));
	}
	.prs3__skirt {
		fill: var(--g7-wood-dark);
	}
	.prs3__floor {
		fill: var(--g7-wood);
	}
	.prs3__seam {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.prs3__earth {
		fill: var(--g7-ground);
	}
	.prs3__crate {
		fill: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
	}
	.prs3__plank {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.prs3__rope {
		fill: none;
		stroke: hsl(36, 45%, 55%);
		stroke-width: 1.6;
	}
	.prs3__arr {
		stroke-width: 3;
		stroke-linecap: round;
	}
	.prs3__arr.is-blue {
		stroke: var(--g7-blue);
	}
	.prs3__arr.is-red {
		stroke: var(--g7-red);
	}
	.prs3__arr.is-violet {
		stroke: var(--prs3-violet);
	}
	.prs3__h--blue {
		fill: var(--g7-blue);
	}
	.prs3__h--red {
		fill: var(--g7-red);
	}
	.prs3__h--violet {
		fill: var(--g7-violet);
	}
	.prs3__dot {
		fill: var(--g7-ink);
	}
	.prs3 .g7__svg .prs3__lab {
		font-size: 11.5px;
		font-weight: 600;
		fill: var(--g7-ink);
	}
</style>

<script>
	import { loop, segment, el } from '../g7/kit';
	import { human, gait, ANKLE, type HumanPose } from '../mehanicheskaya-rabota/people';

	const FLOOR = 168;
	const S = 0.5; // px per см
	const H = 176;
	const u = S * H;
	const KF = 0.15; // px per newton
	const V = 40; // px per second (0,8 м/с)
	const STEP = 30; // px, a step of 60 см
	const SCREEN = 250; // where the man's hip stays on the screen
	type Pair = { c: 'blue' | 'red' | 'violet'; F: number; text: string };
	const PAIRS: Record<string, Pair> = {
		rope: { c: 'blue', F: 157, text: 'Верёвка тянет ящик вперёд с силой 157 Н, а человека — назад с силой 157 Н. Силы равны по модулю, противоположны по направлению, приложены к разным телам; обе — силы упругости верёвки.' },
		feet: { c: 'red', F: 157, text: 'Подошва отталкивается от пола назад, а пол толкает человека вперёд: две силы трения покоя по 157 Н. Именно сила пола движет человека вперёд.' },
		box: { c: 'red', F: 157, text: 'Пол тормозит ящик силой трения скольжения 157 Н, а ящик тянет пол вперёд с такой же силой 157 Н.' },
		earth: { c: 'violet', F: 392, text: 'Земля притягивает ящик с силой 392 Н, и ящик притягивает Землю с той же силой 392 Н. Это силы тяготения. Ускорение Земли от этой силы ничтожно: её масса огромна.' },
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-prs3]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const uid = q('marker')!.id.replace(/-blue$/, '');
		const man = human(q<SVGGElement>('[data-man]'), { s: S, H, shirt: 'hm-green', hair: 'short' });
		const seams = q<SVGGElement>('[data-seams]');
		const crate = q<SVGGElement>('[data-crate]');
		const rope = q('[data-rope]');
		const msg = q('[data-msg]');
		let pair = 'rope';
		let d = 0;
		const A = ANKLE * S;
		const arrow = (i: 1 | 2, x: number, y: number, dx: number, dy: number, lab: string, lx: number, ly: number, c: string) => {
			const a = q<SVGLineElement>(`[data-a${i}]`);
			const L = Math.hypot(dx, dy);
			const k = (L - 4) / L;
			a.setAttribute('x1', x.toFixed(1));
			a.setAttribute('y1', y.toFixed(1));
			a.setAttribute('x2', (x + dx * k).toFixed(1));
			a.setAttribute('y2', (y + dy * k).toFixed(1));
			a.setAttribute('class', `prs3__arr is-${c}`);
			a.setAttribute('marker-end', `url(#${uid}-${c})`);
			const dot = q(`[data-d${i}]`);
			dot.setAttribute('cx', x.toFixed(1));
			dot.setAttribute('cy', y.toFixed(1));
			const t = q<SVGTextElement>(`[data-l${i}]`);
			t.setAttribute('x', lx.toFixed(1));
			t.setAttribute('y', ly.toFixed(1));
			t.setAttribute('text-anchor', 'middle');
			t.textContent = lab;
		};
		const draw = () => {
			const cam = d; // the hip's walked distance; screen x = world x − cam + SCREEN
			// floor boards
			seams.replaceChildren();
			for (let i = 0; i < 12; i++) {
				const x = (((i * 40 - cam) % 480) + 480) % 480 - 40;
				seams.append(el('line', { class: 'prs3__seam', x1: x.toFixed(1), x2: x.toFixed(1), y1: FLOOR, y2: FLOOR + 30 }));
			}
			// the man: the hip at SCREEN, feet by the gait (in screen coordinates)
			const hip = { x: SCREEN, y: FLOOR - 0.505 * u };
			const ft = gait(d, STEP, SCREEN + 6, 3).map((f) => ({ x: f.x - d, up: f.up }));
			const pose: HumanPose = {
				hip,
				lean: 0.28,
				ankles: [
					{ x: ft[0].x, y: FLOOR - A - ft[0].up },
					{ x: ft[1].x, y: FLOOR - A - ft[1].up },
				],
				feet: [0, 0],
				hands: [
					{ x: hip.x - 0.1 * u, y: hip.y + 0.03 * u },
					{ x: hip.x - 0.08 * u, y: hip.y + 0.02 * u },
				],
				head: -0.15,
			};
			man(pose);
			const hand = { x: hip.x - 0.1 * u, y: hip.y + 0.03 * u };
			const cx = SCREEN - 85; // the front of the crate
			crate.setAttribute('transform', `translate(${cx} ${FLOOR})`);
			const knot = { x: cx, y: hand.y }; // tied at the height of the hands: the rope is horizontal
			rope.setAttribute('d', `M${knot.x} ${knot.y.toFixed(1)} H${hand.x.toFixed(1)}`);
			// the pair; the standing foot is the one that does not swing
			const P = PAIRS[pair];
			const L = P.F * KF;
			const ux = hand.x - knot.x;
			const uy = hand.y - knot.y;
			const n = Math.hypot(ux, uy);
			const stand = ft[0].up < ft[1].up ? ft[0] : ft[1];
			if (pair === 'rope') {
				arrow(1, knot.x, knot.y, (ux / n) * L, (uy / n) * L, 'на ящик', knot.x + 12, knot.y - 12, P.c);
				arrow(2, hand.x, hand.y, (-ux / n) * L, (-uy / n) * L, 'на человека', hand.x + 6, hand.y - 18, P.c);
			} else if (pair === 'feet') {
				arrow(1, stand.x + 3, FLOOR - 1, L, 0, 'на человека', stand.x + 44, FLOOR - 8, P.c);
				arrow(2, stand.x + 3, FLOOR + 10, -L, 0, 'на пол', stand.x - 10, FLOOR + 25, P.c);
			} else if (pair === 'box') {
				arrow(1, cx - 15, FLOOR - 1, -L, 0, 'на ящик', cx - 52, FLOOR - 10, P.c);
				arrow(2, cx - 15, FLOOR + 10, L, 0, 'на пол', cx + 22, FLOOR + 25, P.c);
			} else {
				arrow(1, cx - 15, FLOOR - 22, 0, L, 'на ящик', cx - 52, FLOOR + 20, P.c);
				arrow(2, cx - 15, 228, 0, -L, 'на Землю', cx + 22, 222, P.c);
			}
		};
		loop(root, (dt) => {
			d += V * dt;
			draw();
			return true;
		})();
		segment(q('[data-pair]'), (b) => {
			pair = b.dataset.p!;
			msg.textContent = PAIRS[pair].text;
			draw();
		});
		msg.textContent = PAIRS[pair].text;
		draw();
	}
</script>
