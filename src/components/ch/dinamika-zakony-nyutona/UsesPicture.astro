---
/**
 * Small pictures to «Где это встречается» (two columns down to 390 px):
 *  1. The accelerometer of a phone: the phone moves back and forth, x = A sin ωt (period 2 с); a magnified view of the
 *     chip shows a small mass on two springs in a frame. The springs give the mass the acceleration of the phone, so the
 *     mass lags behind the frame by a shift proportional to the acceleration, −a·m/k (drawn as up to 6 px when the
 *     phone turns back). Not to scale.
 *  2. A lift with a counterweight: the cabin and the counterweight hang on one rope over the drive sheave of the motor
 *     (an Atwood machine); the cabin rises and the counterweight goes down by the same distance, 2 с each way, smoothly.
 *  3. Two climbers on one rope on a glacier (people kit, 175–178 см at 0,18 px per см, winter clothes, mittens): one
 *     has slipped into a crevasse and hangs on the rope, holding it above his harness; the other lies face down on the
 *     snow, head away from the crevasse, both hands on his ice axe dug into the snow before his head. The rope pulls both
 *     with the same force (two blue arrows of equal length, 16 px: on the holder's harness toward the crevasse, on the
 *     hanging climber up); the friction of the snow and the axe holds the pair. A still picture.
 *  4. A helicopter hovers: the rotor throws air down (streaks moving down), the air pushes the rotor up (blue arrow).
 */
import DzStyles from './DzStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import { arrowPath } from './dz';

---

<DzStyles />
<PeopleStyles />
<figure class="g7 g7--pic usp not-content" data-usp>
	<div class="g7__grid is-two">
		<figure class="dz-panel">
			<svg class="g7__svg" viewBox="0 14 200 112" role="img" aria-label="Телефон движется туда и обратно. Внутри микросхемы маленький грузик на пружинках отстаёт от рамки, когда телефон разгоняется">
				<g data-phone>
					<rect class="usp-phone" x="18" y="30" width="44" height="84" rx="7"></rect>
					<rect class="usp-screen" x="22" y="38" width="36" height="66" rx="2"></rect>
					<rect class="usp-chip" x="32" y="64" width="16" height="12" rx="1.5"></rect>
				</g>
				<path class="dz-lead" data-zoomline d=""></path>
				<circle class="usp-lens" cx="138" cy="70" r="50"></circle>
				<g data-frame>
					<rect class="usp-frame" x="104" y="52" width="68" height="36" rx="3"></rect>
					<path class="usp-spring" data-sp1 d=""></path>
					<path class="usp-spring" data-sp2 d=""></path>
					<rect class="usp-mass" data-mass x="-10" y="60" width="20" height="20" rx="2"></rect>
				</g>
			</svg>
			<figcaption><b>Акселерометр в телефоне.</b> В микросхеме грузик на упругих перемычках. Даже в покое они прогибаются под его весом — так телефон узнаёт, где низ, и поворачивает изображение; при толчках прогиб меняется.</figcaption>
		</figure>
		<figure class="dz-panel">
			<svg class="g7__svg" viewBox="0 0 200 140" role="img" aria-label="Лифт: кабина и противовес висят на одном тросе, перекинутом через шкив двигателя; кабина поднимается, противовес опускается">
				<rect class="usp-shaft" x="40" y="10" width="120" height="130"></rect>
				<rect class="usp-motor" x="88" y="2" width="24" height="10" rx="2"></rect>
				<circle class="usp-sheave" cx="100" cy="22" r="18"></circle>
				<circle class="dz-dot" cx="100" cy="22" r="2"></circle>
				<path class="dz-thread" data-ropes d=""></path>
				<g data-cabin>
					<rect class="usp-cabin" x="65" y="0" width="34" height="44" rx="2"></rect>
					<path class="usp-door" d="M82 6 V44 M69 6 h26"></path>
				</g>
				<rect class="usp-cw" data-cw x="112" y="0" width="12" height="30" rx="1.5"></rect>
			</svg>
			<figcaption><b>Лифт с противовесом.</b> Кабина и противовес висят на одном тросе через блок, как в машине Атвуда; двигатель добавляет только разницу сил.</figcaption>
		</figure>
		<figure class="dz-panel">
			<svg class="g7__svg" viewBox="0 0 200 140" role="img" aria-label="Ледник. Один альпинист сорвался в трещину и висит на верёвке, другой лежит на снегу и держится за вбитый в снег ледоруб">
				<rect class="usp-sky" x="0" y="0" width="200" height="70"></rect>
				<path class="usp-peak" d="M0 52 L30 22 L52 40 L84 8 L120 44 L150 26 L200 50 V70 H0 Z"></path>
				<path class="usp-peak-snow" d="M84 8 L74 20 L80 18 L86 24 L92 16 Z M30 22 L24 28 L32 27 Z M150 26 L144 32 L152 31 Z"></path>
				<path class="usp-ice" d="M0 70 H140 L144 140 H0 Z M165 70 H200 V140 H160 Z"></path>
				<path class="usp-crevasse" d="M140 70 L144 140 H160 L165 70 Z"></path>
				<path class="usp-axe" data-axe d=""></path>
				<path class="dz-thread" data-crope d=""></path>
				<g data-holder></g>
				<g data-faller></g>
				<path class="dz-f--el" data-ct1 d=""></path>
				<path class="dz-f--el" data-ct2 d=""></path>
			</svg>
			<figcaption><b>Связка альпинистов.</b> Верёвка тянет обоих с одинаковой силой. Напарник лёг на снег и вбил ледоруб: трение удерживает обоих.</figcaption>
		</figure>
		<figure class="dz-panel">
			<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Вертолёт висит в воздухе: винт отбрасывает воздух вниз, воздух толкает винт вверх">
				<g data-air></g>
				<path class="usp-heli" d="M70 58 Q70 44 92 44 H118 Q132 44 134 56 L136 64 Q136 72 124 72 H80 Q70 72 70 58 Z M134 56 L184 54 L186 60 L136 64 Z M180 46 l8 0 l-2 14 h-6 Z"></path>
				<path class="usp-win" d="M76 52 Q78 47 90 47 V58 H74 Z"></path>
				<path class="usp-skid" d="M82 72 v6 M120 72 v6 M74 78 H128"></path>
				<path class="usp-mast" d="M102 44 v-6"></path>
				<path class="usp-rotor" data-rotor d="M42 37 H162"></path>
				<path class="dz-f--el" d={arrowPath(102, 37, 102, 6, 3, 9)}></path>
			</svg>
			<figcaption><b>Вертолёт.</b> Винт отбрасывает воздух вниз, а воздух по третьему закону толкает винт вверх (синяя стрелка).</figcaption>
		</figure>
	</div>
</figure>

<style is:global>
	.usp .g7__grid.is-two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@container (min-width: 36rem) {
		.usp .g7__grid.is-two {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.usp-phone { fill: var(--sl-color-gray-5); stroke: var(--g7-ink); stroke-width: 1.2; }
	.usp-screen { fill: color-mix(in oklab, var(--ig-vx) 30%, var(--g7-paper)); }
	.usp-chip { fill: var(--g7-ink); opacity: 0.8; }
	.usp-lens { fill: var(--g7-paper); stroke: var(--sl-color-gray-3); stroke-width: 1.4; }
	.usp-frame { fill: none; stroke: var(--sl-color-gray-2); stroke-width: 1.6; }
	.usp-spring { fill: none; stroke: var(--dz-el); stroke-width: 1.4; }
	.usp-mass { fill: var(--g7-steel); stroke: var(--sl-color-gray-2); stroke-width: 1; }
	.usp-shaft { fill: color-mix(in oklab, var(--sl-color-gray-5) 60%, var(--g7-paper)); }
	.usp-motor { fill: var(--sl-color-gray-3); }
	.usp-sheave { fill: var(--g7-steel); stroke: var(--sl-color-gray-2); stroke-width: 1.2; }
	.usp-cabin { fill: var(--g7-steel); stroke: var(--sl-color-gray-2); stroke-width: 1.2; }
	.usp-door { stroke: var(--sl-color-gray-2); stroke-width: 1; fill: none; }
	.usp-cw { fill: var(--sl-color-gray-3); stroke: var(--g7-ink); stroke-width: 0.8; }
	.usp-peak { fill: color-mix(in oklab, var(--ig-vx) 20%, var(--sl-color-gray-4)); }
	.usp-peak-snow { fill: var(--sl-color-white); opacity: 0.85; }
	.usp-ice { fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-6)); stroke: var(--sl-color-gray-3); stroke-width: 0.8; }
	.usp-crevasse { fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-5)); }
	.usp-axe { stroke: var(--g7-ink); stroke-width: 1.6; fill: none; stroke-linecap: round; }
	.usp-sky { fill: color-mix(in oklab, var(--ig-vx) 14%, var(--g7-paper)); }
	.usp-shore { fill: color-mix(in oklab, hsl(130, 30%, 45%) 50%, var(--g7-paper)); }
	.usp-water { fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-5)); }
	.usp-wave { fill: none; stroke: var(--sl-color-white); stroke-width: 1; opacity: 0.5; }
	.usp-barge { fill: color-mix(in oklab, var(--ig-vy) 25%, var(--sl-color-gray-4)); stroke: var(--g7-ink); stroke-width: 0.9; }
	.usp-cargo { fill: var(--g7-wood); stroke: var(--g7-wood-dark); stroke-width: 0.8; }
	.usp-tug { fill: var(--ig-vy); stroke: var(--g7-ink); stroke-width: 0.9; }
	.usp-cab { fill: var(--sl-color-gray-5); stroke: var(--g7-ink); stroke-width: 0.8; }
	.usp-win { fill: hsl(200, 40%, 75%); }
	.usp-heli { fill: var(--g7-green); stroke: var(--g7-ink); stroke-width: 1; }
	.usp-skid, .usp-mast { stroke: var(--g7-ink); stroke-width: 1.6; fill: none; }
	.usp-rotor { stroke: var(--g7-ink); stroke-width: 2.4; stroke-linecap: round; }
	.usp-airline { stroke: var(--sl-color-gray-3); stroke-width: 1.2; stroke-linecap: round; }
</style>

<script>
	import { loop, el } from '../g7/kit';
	import { figure } from '@components/people';
	import { arrowPath } from './dz';

	const spring = (x0: number, x1: number, y: number, n = 5, a = 4) => {
		let d = `M${x0.toFixed(1)} ${y}`;
		for (let i = 1; i < 2 * n; i++) d += ` L${(x0 + ((x1 - x0) * i) / (2 * n)).toFixed(1)} ${y + (i % 2 ? -a : a)}`;
		return d + ` L${x1.toFixed(1)} ${y}`;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-usp]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const phone = $<SVGGElement>('[data-phone]');
		const mass = $<SVGRectElement>('[data-mass]');
		const sp1 = $('[data-sp1]');
		const sp2 = $('[data-sp2]');
		const zl = $('[data-zoomline]');
		const ropes = $('[data-ropes]');
		const cabin = $<SVGGElement>('[data-cabin]');
		const cw = $<SVGRectElement>('[data-cw]');
		const air = $<SVGGElement>('[data-air]');
		const rotor = $('[data-rotor]');
		const streaks = Array.from({ length: 22 }, (_, i) => {
			const ln = el('path', { class: 'usp-airline' });
			air.append(ln);
			return { ln, x: 46 + ((i * 47) % 112), ph: (i * 0.618) % 1 };
		});
		// 3. the climbers (still): the holder lies on the snow, the other hangs in the crevasse facing its wall
		{
			const S = 0.18;
			const GS = 70; // the snow surface
			const holder = figure($<SVGGElement>('[data-holder]'), { s: S, H: 178, clothes: 'winter', shirt: 'hm-red', gear: 'boot', dir: -1, name: 'holder' });
			const faller = figure($<SVGGElement>('[data-faller]'), { s: S, H: 175, clothes: 'winter', shirt: 'hm-blue', gear: 'boot', dir: -1, name: 'climber' });
			const uA = S * 178;
			const uB = S * 175;
			// the holder lies face down, head away from the crevasse, the ice axe dug in before his head
			const hipA = { x: 102, y: GS - 0.07 * uA };
			const pick = { x: 80, y: GS + 1 };
			const top = { x: 87, y: GS - 9 };
			const along = (k: number) => ({ x: pick.x + (top.x - pick.x) * k, y: pick.y + (top.y - pick.y) * k });
			const h1 = along(0.55);
			const h2 = along(0.85);
			holder.pose({
				hip: hipA,
				lean: 1.42,
				head: 0.3, // he looks ahead: the head turned up by about 32° against the body
				ankles: [
					{ x: hipA.x + 0.46 * uA, y: GS - 0.035 * uA },
					{ x: hipA.x + 0.45 * uA, y: GS - 0.03 * uA },
				],
				feet: [1.2, 1.2],
				hands: [
					{ at: h1, pose: 'grip', d: 2.5, contact: 'ice-axe' },
					{ at: h2, pose: 'grip', d: 2.5, contact: 'ice-axe' },
				],
				planted: [true, true],
			});
			$('[data-axe]').setAttribute('d', `M${pick.x} ${pick.y} L${top.x} ${top.y} M${top.x - 3} ${top.y - 1.5} l6 3`);
			const hipB = { x: 153, y: 110 };
			const r1 = { x: 151, y: hipB.y - 0.4 * uB };
			const r2 = { x: 152, y: hipB.y - 0.36 * uB };
			faller.pose({
				hip: hipB,
				lean: 0.05,
				head: -0.15,
				ankles: [
					{ x: hipB.x - 1, y: hipB.y + 0.47 * uB },
					{ x: hipB.x + 1.5, y: hipB.y + 0.46 * uB },
				],
				feet: [0.3, 0.3],
				hands: [
					{ at: r1, pose: 'grip', d: 2, contact: 'rope' },
					{ at: r2, pose: 'grip', d: 2, contact: 'rope' },
				],
			});
			const lip = { x: 141, y: GS };
			$('[data-crope]').setAttribute('d', `M${hipA.x} ${hipA.y.toFixed(1)} L${lip.x} ${lip.y} Q${r1.x - 4} ${lip.y + 4} ${r1.x} ${r1.y.toFixed(1)} L${r2.x} ${r2.y.toFixed(1)} L${hipB.x} ${(hipB.y - 2).toFixed(1)}`);
			$('[data-ct1]').setAttribute('d', arrowPath(hipA.x, hipA.y - 5, hipA.x + 16, hipA.y - 5, 2.4, 7));
			$('[data-ct2]').setAttribute('d', arrowPath(hipB.x + 6, hipB.y, hipB.x + 6, hipB.y - 16, 2.4, 7));
		}
		let t = 0;
		const draw = () => {
			// 1. the phone moves by ±8 px with a period of 2 с; the mass lags by the acceleration
			const w = Math.PI;
			const px = 8 * Math.sin(w * t);
			const acc = -8 * w * w * Math.sin(w * t); // px/s²
			phone.setAttribute('transform', `translate(${px.toFixed(1)} 0)`);
			zl.setAttribute('d', `M${(48 + px).toFixed(1)} 70 L88 70`);
			const shift = (-acc / (8 * w * w)) * 6; // up to 6 px, against the acceleration
			const mx = 138 + shift;
			mass.setAttribute('x', (mx - 10).toFixed(1));
			sp1.setAttribute('d', spring(104, mx - 10, 70));
			sp2.setAttribute('d', spring(mx + 10, 172, 70));
			// 2. the lift: the cabin from y 92 up to 56 and back, the counterweight the other way
			const u = 0.5 - 0.5 * Math.cos((Math.PI * t) / 2);
			const yc = 92 - 36 * u;
			const yw = 48 + 36 * u;
			cabin.setAttribute('transform', `translate(0 ${yc.toFixed(1)})`);
			cw.setAttribute('y', yw.toFixed(1));
			ropes.setAttribute('d', `M82 ${yc.toFixed(1)} V22 A18 18 0 0 1 118 22 V${yw.toFixed(1)}`);
			// 4. the rotor spins (its length shrinks and grows in the side view), the air streams down
			const c = Math.abs(Math.cos(t * 14));
			rotor.setAttribute('d', `M${(102 - 60 * c).toFixed(1)} 37 H${(102 + 60 * c).toFixed(1)}`);
			for (const s of streaks) {
				const q = (s.ph + t * 0.9) % 1;
				const y = 86 + q * 46;
				s.ln.setAttribute('d', `M${s.x} ${y.toFixed(1)} v7`);
				s.ln.setAttribute('opacity', (0.9 * (1 - q)).toFixed(2));
			}
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		})();
		draw();
	}
</script>
