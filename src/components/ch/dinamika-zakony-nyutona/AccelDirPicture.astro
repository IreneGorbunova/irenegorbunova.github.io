---
/**
 * «Ускорение — по силе» (after «Ускорение направлено так же, как равнодействующая»): three bodies whose velocity is
 * not along the resultant. Colors of the chapter: velocity gold, gravitation violet, elastic force blue, friction red,
 * the resultant ink, acceleration green. Every panel is drawn to its own scale; acceleration arrows are 3 px per м/с².
 *  1. A ball thrown with υ₀x = 6 м/с, υ₀y = 8 м/с (no air): 20 px per metre for the path (range 9,8 м, top 3,27 м after
 *     0,816 с); shown at τ = 0,3 с (υ = (6; 5,06) м/с), at the top (6; 0) and at 1,35 с (6; −5,23); velocity 5 px per
 *     м/с. The only force is mg (down), so the resultant is mg and a = g = 9,8 м/с² (29 px) down everywhere.
 *  2. A car on a level circular bend, top view: the road's friction points to the center of the bend and is the
 *     resultant (gravity and the road's support balance and are not drawn); a points to the center, υ along the road.
 *  3. A child on a swing at its extreme position, 35° from the vertical (people kit, 120 см at 0,5 px per см, facing the way
 *     she swings): υ = 0. The dashed arc is the path of the middle of the girl with the seat (a dot), where the forces act;
 *     the forces themselves are drawn apart from one point (a free-body diagram) so that they cover neither her nor the ropes.
 *     T = mg cos 35° along the ropes (49 px for mg = 60 px), mg down; their resultant mg sin 35° (34 px) is along the
 *     tangent to the arc, toward the lowest point, and so is a = g sin 35° = 5,6 м/с² (4 px per м/с² here, 22 px).
 */
import DzStyles from './DzStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import { arrowPath, over, f1 } from './dz';

// 1. the ball
const K1 = 20;
const V1 = 5;
const A = 3;
const G = 9.8;
const B0 = { x: 22, y: 176 };
const ball = (t: number) => ({ x: B0.x + 6 * t * K1, y: B0.y - (8 * t - 0.5 * G * t * t) * K1, vx: 6, vy: 8 - G * t });
const pathPts = Array.from({ length: 41 }, (_, i) => ball((1.6327 * i) / 40));
const path1 = 'M' + pathPts.map((p) => `${f1(p.x)} ${f1(p.y)}`).join(' L');
const shots = [0.3, 8 / G, 1.35].map(ball);

// 2. the bend: center C, radius R; the car at angle φ (from the +x axis, counterclockwise on screen)
const C = { x: 120, y: 178 };
const R = 120;
const phi = (62 * Math.PI) / 180;
const car = { x: C.x + R * Math.cos(phi), y: C.y - R * Math.sin(phi) };
const tng = { x: -Math.sin(phi), y: -Math.cos(phi) }; // direction of motion (counterclockwise)
const inw = { x: -Math.cos(phi), y: Math.sin(phi) }; // toward the center
const carDeg = (-Math.atan2(-tng.y, tng.x) * 180) / Math.PI;
const road = (r: number) => `M${f1(C.x + r)} ${C.y} A${r} ${r} 0 0 0 ${f1(C.x - r)} ${C.y}`;
const side = { x: -inw.y, y: inw.x }; // across the inward arrows
const frA = { x: car.x + side.x * 7, y: car.y + side.y * 7 };
const aA = { x: car.x - side.x * 7, y: car.y - side.y * 7 };
const FR = 62; // px
const AA = 50; // px
const frT = { x: frA.x + inw.x * FR, y: frA.y + inw.y * FR };
const aT = { x: aA.x + inw.x * AA, y: aA.y + inw.y * AA };

// 3. the swing
const P = { x: 56, y: 8 };
const L = 118; // the pivot to the seat
const th = (35 * Math.PI) / 180;
const seat = { x: P.x + L * Math.sin(th), y: P.y + L * Math.cos(th) };
const LC = L - 12; // the pivot to the middle of the girl with the seat, where the forces act
const O3 = { x: P.x + LC * Math.sin(th), y: P.y + LC * Math.cos(th) };
const arc3 = `M${f1(P.x - LC * Math.sin(th))} ${f1(P.y + LC * Math.cos(th))} A${LC} ${LC} 0 0 0 ${f1(O3.x)} ${f1(O3.y)}`;
// the forces are drawn apart, from one point Q, so that they cover neither the girl nor the ropes
const Q = { x: 192, y: 72 };
const M = 60; // mg, px
const Tv = { x: -Math.sin(th) * M * Math.cos(th), y: -Math.cos(th) * M * Math.cos(th) };
const Rv = { x: -Math.cos(th) * M * Math.sin(th), y: Math.sin(th) * M * Math.sin(th) };
const A3 = 4; // px per м/с² in this panel
const av = { x: -Math.cos(th) * G * Math.sin(th) * A3, y: Math.sin(th) * G * Math.sin(th) * A3 };
const nrm = { x: Math.sin(th), y: Math.cos(th) }; // across the tangent, down and away from the pivot
const aS = { x: Q.x + nrm.x * 8, y: Q.y + nrm.y * 8 };
---

<DzStyles />
<PeopleStyles />
<figure class="g7 g7--pic adp not-content" data-adp>
	<div class="g7__grid is-three">
		<figure class="dz-panel">
			<svg class="g7__svg" viewBox="0 0 240 200" role="img" aria-label="Мяч летит по дуге. В трёх точках скорость направлена по касательной к траектории, а сила тяжести и ускорение — всегда вниз">
				<path class="dz-gline" d="M8 176 H232"></path>
				<path class="ln-dash" d={path1}></path>
				{shots.map((p) => (
					<g>
						<path class="dz-f--v" d={arrowPath(p.x, p.y, p.x + p.vx * V1, p.y - p.vy * V1, 2.6, 9)} />
						<path class="dz-f--grav" d={arrowPath(p.x, p.y, p.x, p.y + G * A, 2.6, 9)} />
						<path class="dz-f--a" d={arrowPath(p.x + 7, p.y, p.x + 7, p.y + G * A, 2.6, 9)} />
						<circle class="adp-ball" cx={f1(p.x)} cy={f1(p.y)} r="5" />
					</g>
				))}
				<text class="dz-sym dz-t--v" x={f1(shots[0].x + 8)} y={f1(shots[0].y - 30)}>υ</text>
				<path class="dz-over dz-s--v" d={over(shots[0].x + 8, shots[0].y - 30, 8)}></path>
				<text class="dz-sym dz-t--grav" x={f1(shots[0].x - 30)} y={f1(shots[0].y + 30)}>mg</text>
				<path class="dz-over dz-s--grav" d={over(shots[0].x - 30, shots[0].y + 30, 20)}></path>
				<text class="dz-sym dz-t--a" x={f1(shots[0].x + 13)} y={f1(shots[0].y + 32)}>a</text>
				<path class="dz-over dz-s--a" d={over(shots[0].x + 13, shots[0].y + 32, 8)}></path>
			</svg>
			<figcaption>Брошенный мяч: на него действует только сила тяжести. Скорость направлена по траектории, ускорение — всегда вниз.</figcaption>
		</figure>
		<figure class="dz-panel">
			<svg class="g7__svg" viewBox="0 0 240 200" role="img" aria-label="Вид сверху: автомобиль на повороте дороги. Скорость направлена вдоль дороги, сила трения и ускорение — к центру поворота">
				<path class="adp-road" d={road(R)}></path>
				<path class="adp-edge" d={road(R - 16)}></path>
				<path class="adp-edge" d={road(R + 16)}></path>
				<path class="adp-mid" d={road(R)}></path>
				<circle class="dz-dot" cx={C.x} cy={C.y} r="2.5"></circle>
				<path class="dz-lead" d={`M${C.x} ${C.y} L${f1(car.x + inw.x * 64)} ${f1(car.y + inw.y * 64)}`} stroke-dasharray="3 3"></path>
				<text class="dz-lab" x={C.x + 6} y={C.y - 6}>центр поворота</text>
				<g transform={`translate(${f1(car.x)} ${f1(car.y)}) rotate(${f1(carDeg)})`}>
					<rect class="adp-car" x="-11" y="-6" width="22" height="12" rx="3"></rect>
					<rect class="adp-glass" x="1" y="-4.5" width="5" height="9" rx="1"></rect>
				</g>
				<path class="dz-f--v" d={arrowPath(car.x + tng.x * 12, car.y + tng.y * 12, car.x + tng.x * 60, car.y + tng.y * 60, 2.8, 10)}></path>
				<path class="dz-f--fr" d={arrowPath(frA.x, frA.y, frT.x, frT.y, 2.8, 10)}></path>
				<path class="dz-f--a" d={arrowPath(aA.x, aA.y, aT.x, aT.y, 2.8, 10)}></path>
				<text class="dz-sym dz-t--v" x={f1(car.x + tng.x * 60 - 4)} y={f1(car.y + tng.y * 60 - 8)}>υ</text>
				<path class="dz-over dz-s--v" d={over(car.x + tng.x * 60 - 4, car.y + tng.y * 60 - 8, 8)}></path>
				<text class="dz-sym dz-t--fr" x={f1(frT.x - 30)} y={f1(frT.y + 4)}>F<tspan class="dz-sub" dy="4">тр</tspan></text>
				<path class="dz-over dz-s--fr" d={over(frT.x - 30, frT.y + 4, 9)}></path>
				<text class="dz-sym dz-t--a" x={f1(aT.x + 9)} y={f1(aT.y + 6)}>a</text>
				<path class="dz-over dz-s--a" d={over(aT.x + 9, aT.y + 6, 8)}></path>
			</svg>
			<figcaption>Автомобиль на повороте, вид сверху. Равнодействующая — сила трения дороги — направлена к центру поворота, туда же и ускорение.</figcaption>
		</figure>
		<figure class="dz-panel">
			<svg class="g7__svg" viewBox="0 0 240 200" role="img" aria-label="Качели в крайнем положении. Скорость равна нулю. Сила натяжения верёвок направлена к точке подвеса, сила тяжести вниз, их равнодействующая и ускорение — по касательной к дуге, к нижней точке">
				<path class="adp-beam" d={`M${P.x - 30} ${P.y - 4} H${P.x + 30} V${P.y + 2} H${P.x - 30} Z`}></path>
				<path class="ln-dash" d={arc3}></path>
				<path class="dz-thread" d={`M${P.x} ${P.y} L${f1(seat.x)} ${f1(seat.y)}`}></path>
				<g transform={`translate(${f1(seat.x)} ${f1(seat.y)}) rotate(${f1((-th * 180) / Math.PI)})`}>
					<g data-kid></g>
					<rect class="adp-seat" x="-11" y="0" width="22" height="3.5" rx="1"></rect>
				</g>
				<circle class="adp-cm" cx={f1(O3.x)} cy={f1(O3.y)} r="2"></circle>
				<path class="dz-dash dz-s--grav" d={`M${f1(Q.x)} ${f1(Q.y + M)} L${f1(Q.x + Rv.x)} ${f1(Q.y + Rv.y)}`}></path>
				<path class="dz-dash dz-s--el" d={`M${f1(Q.x + Tv.x)} ${f1(Q.y + Tv.y)} L${f1(Q.x + Rv.x)} ${f1(Q.y + Rv.y)}`}></path>
				<path class="dz-f--el" d={arrowPath(Q.x, Q.y, Q.x + Tv.x, Q.y + Tv.y, 2.8, 10)}></path>
				<path class="dz-f--grav" d={arrowPath(Q.x, Q.y, Q.x, Q.y + M, 2.8, 10)}></path>
				<path class="dz-f--res" d={arrowPath(Q.x, Q.y, Q.x + Rv.x, Q.y + Rv.y, 3, 10)}></path>
				<path class="dz-f--a" d={arrowPath(aS.x, aS.y, aS.x + av.x, aS.y + av.y, 2.6, 8)}></path>
				<circle class="dz-dot" cx={Q.x} cy={Q.y} r="2.2"></circle>
				<text class="dz-sym dz-t--el" x={f1(Q.x + 0.6 * Tv.x + 12 * Math.cos(th) - 2)} y={f1(Q.y + 0.6 * Tv.y - 12 * Math.sin(th) + 4)}>T</text>
				<path class="dz-over dz-s--el" d={over(Q.x + 0.6 * Tv.x + 12 * Math.cos(th) - 2, Q.y + 0.6 * Tv.y - 12 * Math.sin(th) + 4, 8)}></path>
				<text class="dz-sym dz-t--grav" x={Q.x + 6} y={Q.y + M - 2}>mg</text>
				<path class="dz-over dz-s--grav" d={over(Q.x + 6, Q.y + M - 2, 20)}></path>
				<text class="dz-sym dz-t--res" x={f1(Q.x + Rv.x - 18)} y={f1(Q.y + Rv.y + 6)}>F</text>
				<path class="dz-over dz-s--res" d={over(Q.x + Rv.x - 18, Q.y + Rv.y + 6, 9)}></path>
				<text class="dz-sym dz-t--a" x={f1(aS.x + av.x / 2 + nrm.x * 12 + 4)} y={f1(aS.y + av.y / 2 + nrm.y * 12 + 4)}>a</text>
				<path class="dz-over dz-s--a" d={over(aS.x + av.x / 2 + nrm.x * 12 + 4, aS.y + av.y / 2 + nrm.y * 12 + 4, 8)}></path>
				<text class="dz-lab" x="8" y="192">υ = 0</text>
			</svg>
			<figcaption>Качели в крайнем положении: скорость равна нулю, а ускорение — нет. Силы, действующие на девочку с сиденьем, нарисованы отдельно, из одной точки: ускорение направлено так же, как их равнодействующая <i>F</i>.</figcaption>
		</figure>
	</div>
	<figcaption class="g7__caption">
		Золотые стрелки — скорость, зелёные — ускорение. Сила тяжести — фиолетовая, сила натяжения — синяя, сила трения — красная; <i>F</i> — равнодействующая. У каждой картинки свой масштаб.
	</figcaption>
</figure>

<style is:global>
	.adp-ball {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.adp-road {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 32;
	}
	.adp-edge {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.adp-mid {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 8 7;
	}
	.adp-car {
		fill: var(--ig-vy);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.adp-glass {
		fill: hsl(200, 40%, 78%);
	}
	.adp-beam {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.adp-cm {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.adp-seat {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
</style>

<script>
	import { figure } from '@components/people';

	// the child on the swing, in the swing's frame: the seat at (0, 0), the rope straight up along x = 0; she faces right
	for (const root of document.querySelectorAll<HTMLElement>('[data-adp]')) {
		const g = root.querySelector<SVGGElement>('[data-kid]');
		if (!g || g.childElementCount) continue;
		const S = 0.5;
		const H = 120;
		const kid = figure(g, { s: S, H, age: 'child', clothes: 'indoor', shirt: 'hm-red', hair: 'pony', name: 'swing-child' });
		const cm = (x: number, y: number) => ({ x: x * S, y: -y * S });
		kid.pose({
			hip: cm(-3, 6),
			lean: -0.05,
			ankles: [cm(20, -24), cm(17, -24)],
			feet: [0.2, 0.2],
			hands: [
				{ at: cm(0, 50), pose: 'grip', d: 2.5, contact: 'rope' },
				{ at: cm(0, 55), pose: 'grip', d: 2.5, contact: 'rope' },
			],
		});
	}
</script>
