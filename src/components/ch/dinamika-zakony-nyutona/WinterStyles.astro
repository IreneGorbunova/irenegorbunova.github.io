---
/**
 * Colors of the people in winter clothes drawn by davlenie-zakon-paskalya/person.ts, for the pictures of the grade 10
 * dynamics chapters. Renders nothing; a picture puts the class `dn-w` on an element around its people and the jacket
 * classes `dn-coat--red`, `--blue`, `--green`, `--gold` on them.
 */
---

<style is:global>
	.dn-w {
		--pp-skin: hsl(26, 55%, 72%);
		--pp-line: hsl(222, 35%, 14%);
		--pp-pants: hsl(225, 25%, 34%);
		--pp-boot: hsl(24, 38%, 34%);
		--pp-fur: hsl(36, 40%, 84%);
		--pp-hat: var(--ig-v);
		--pp-scarf: hsl(150, 50%, 50%);
	}
	:root[data-theme='light'] .dn-w {
		--pp-line: hsl(222, 30%, 22%);
		--pp-pants: hsl(225, 30%, 30%);
	}
	.dn-w .pp-far {
		filter: brightness(0.8);
	}
	.dn-w .pp-outline {
		fill: none;
		stroke: var(--pp-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.dn-w .pp-pants,
	.dn-w .pp-sleeve {
		fill: none;
		stroke: var(--pp-pants);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.dn-w .pp-sleeve.dn-coat--red { stroke: var(--ig-vy); }
	.dn-w .pp-sleeve.dn-coat--blue { stroke: var(--ig-vx); }
	.dn-w .pp-sleeve.dn-coat--green { stroke: hsl(150, 45%, 48%); }
	.dn-w .pp-sleeve.dn-coat--gold { stroke: var(--ig-v); }
	.dn-w .pp-coat {
		stroke: var(--pp-line);
		stroke-width: 0.8;
	}
	.dn-w .pp-coat.dn-coat--red { fill: var(--ig-vy); }
	.dn-w .pp-coat.dn-coat--blue { fill: var(--ig-vx); }
	.dn-w .pp-coat.dn-coat--green { fill: hsl(150, 45%, 48%); }
	.dn-w .pp-coat.dn-coat--gold { fill: var(--ig-v); }
	.dn-w .pp-zip {
		fill: none;
		stroke: var(--pp-line);
		stroke-width: 0.7;
		opacity: 0.6;
	}
	.dn-w .pp-skin {
		fill: var(--pp-skin);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	.dn-w .pp-ear { stroke-width: 0.5; }
	.dn-w .pp-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	.dn-w .pp-eye { fill: var(--pp-line); }
	.dn-w .pp-mouth {
		fill: none;
		stroke: var(--pp-line);
		stroke-width: 0.7;
		stroke-linecap: round;
	}
	.dn-w .pp-hair { fill: hsl(25, 40%, 28%); }
	.dn-w .pp-hat,
	.dn-w .pp-pompom,
	.dn-w .pp-mitten {
		fill: var(--pp-hat);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	.dn-w .dn-hat2 .pp-hat,
	.dn-w .dn-hat2 .pp-pompom,
	.dn-w .dn-hat2 .pp-mitten {
		fill: hsl(330, 55%, 62%);
	}
	.dn-w .pp-hat-band {
		fill: color-mix(in oklab, var(--pp-hat) 70%, var(--pp-line));
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	.dn-w .pp-scarf {
		fill: var(--pp-scarf);
		stroke: var(--pp-line);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	.dn-w .pp-boot {
		fill: var(--pp-boot);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	.dn-w .pp-sole,
	.dn-w .pp-bind,
	.dn-w .pp-strap {
		fill: var(--pp-line);
	}
	.dn-w .pp-cuff { fill: var(--pp-fur); }
	.dn-w .pp-blade {
		fill: hsl(210, 12%, 82%);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	.dn-w .pp-holder { fill: hsl(210, 10%, 60%); }
	.dn-w .pp-lace {
		fill: none;
		stroke: var(--pp-fur);
		stroke-width: 0.8;
	}
	.dn-w .pp-ski {
		fill: var(--ig-vy);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
</style>
