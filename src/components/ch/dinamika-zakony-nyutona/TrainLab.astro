---
/**
 * «Связанные тела» (model, section «Связанные тела»). g = 9,8 м/с²; light threads that do not stretch, a light pulley
 * without friction. The bodies start from rest and move 1 м in real time (or stay put), the last frame holds 1 с, and
 * it repeats; any change restarts it. Three tabs:
 *  1. «Поезд из брусков»: 2 or 3 blocks on a table joined by threads; the front block (1) is pulled horizontally with F.
 *     m₁, m₂, m₃ 0,5…3 кг (step 0,5), F 0…30 Н (step 1), μ 0…0,5 (step 0,05). They move when F > μMg (M = the sum of
 *     the masses): a = (F − μMg)/M; the thread behind block k pulls with T = F · (the mass behind it)/M, whatever μ is.
 *     At rest (F ≤ μMg) the panel says so and shows no tensions.
 *  2. «Машина Атвуда»: m₁, m₂ 0,10…2,00 кг (step 0,05) on a thread over a pulley: a = |m₂ − m₁|g/(m₁ + m₂),
 *     T = 2m₁m₂g/(m₁ + m₂); equal masses stay at rest. The time to travel 1 м is t = √(2 · 1 м / a).
 *  3. «Бруски толкают»: F pushes block 1, which pushes block 2; the contact force N₁₂ = F · m₂/(m₁ + m₂); m₁, m₂, F, μ as
 *     in tab 1.
 * «Система целиком»: a dashed outline around all the bodies, the internal forces (threads, contact) fade, the external
 * ones stay, and the equation becomes M·a = the sum of the external forces, with numbers.
 * In «Машина Атвуда» the forces are drawn at 4 px per newton (the loads are light). Scale: 100 px per metre for the motion (blocks 0,3 м long, threads 0,44 м), 3 px per newton for the forces,
 * 6 px per м/с² for the acceleration (its arrow starts at the left edge). In tabs 1 and 3 gravity and the support of the table balance and are not drawn.
 * Block heights grow with the mass. Numbers: 3 significant figures.
 */
import DzStyles from './DzStyles.astro';
---

<DzStyles />
<figure class="g7 g7--wide trl not-content" data-trl data-tab="train">
	<div class="g7__grid">
		<div class="trl__left">
			<div class="g7__seg trl__tabs" role="group" aria-label="Опыт" data-tabs>
				<button type="button" class="g7__btn" aria-pressed="true" data-t="train">Поезд из брусков</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-t="atwood">Машина Атвуда</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-t="push">Бруски толкают</button>
			</div>
			<svg class="g7__svg" viewBox="0 0 380 160" role="img" aria-label="Связанные тела: бруски на столе, соединённые нитями, грузы на нити через блок или бруски, которые толкают друг друга; стрелками показаны силы" data-svg>
				<g data-scene></g>
			</svg>
			<ul class="g7__lines trl__eqs" data-eqs></ul>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
		<div class="g7__side">
			<div class="g7__row trl__count" data-countrow>
				<span class="g7__label">Брусков:</span>
				<div class="g7__seg" role="group" aria-label="Число брусков" data-count>
					<button type="button" class="g7__btn" aria-pressed="false" data-n="2">2</button>
					<button type="button" class="g7__btn" aria-pressed="true" data-n="3">3</button>
				</div>
			</div>
			<label class="g7__slider" data-row="m1"><span>Масса <i>m</i><sub>1</sub></span><output data-o="m1"></output><input type="range" data-s="m1" aria-label="Масса первого тела, килограммы" /></label>
			<label class="g7__slider" data-row="m2"><span>Масса <i>m</i><sub>2</sub></span><output data-o="m2"></output><input type="range" data-s="m2" aria-label="Масса второго тела, килограммы" /></label>
			<label class="g7__slider" data-row="m3"><span>Масса <i>m</i><sub>3</sub></span><output data-o="m3"></output><input type="range" data-s="m3" aria-label="Масса третьего тела, килограммы" /></label>
			<label class="g7__slider" data-row="F"><span>Сила <i>F</i></span><output data-o="F"></output><input type="range" min="0" max="30" step="1" data-s="F" aria-label="Сила, ньютоны" /></label>
			<label class="g7__slider" data-row="mu"><span>Коэффициент трения μ</span><output data-o="mu"></output><input type="range" min="0" max="0.5" step="0.05" data-s="mu" aria-label="Коэффициент трения" /></label>
			<button type="button" class="g7__btn" aria-pressed="false" data-sys>Система целиком</button>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		<span class="trl-cap-blocks">Нити лёгкие и нерастяжимые; <i>g</i> = 9,8&nbsp;м/с². Бруски трогаются с места и проходят 1&nbsp;м в настоящем времени. Стрелки сил в одном масштабе, только слабое трение нарисовано длиннее; сила тяжести и сила реакции стола уравновешены и не показаны. Красные стрелки — силы трения.</span>
		<span class="trl-cap-atwood">Нить лёгкая и нерастяжимая, блок лёгкий, без трения; <i>g</i> = 9,8&nbsp;м/с². Грузы трогаются с места и проходят 1&nbsp;м в настоящем времени. Стрелки сил в одном масштабе.</span>
	</figcaption>
</figure>

<style is:global>
	.trl-cap-atwood,
	[data-tab='atwood'] .trl-cap-blocks {
		display: none;
	}
	[data-tab='atwood'] .trl-cap-atwood {
		display: inline;
	}
	.trl [hidden] {
		display: none !important;
	}
	.trl__left {
		display: grid;
		gap: 0.6rem;
		min-width: 0;
	}
	.trl__eqs li {
		font-size: var(--sl-text-sm);
	}
	.trl .g7__seg.trl__tabs .g7__btn {
		padding-inline: 0.5rem;
	}
	.trl-table {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.trl-mark {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.trl-block {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.trl-out {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 1.6;
		stroke-dasharray: 6 4;
	}
	.trl-int {
		transition: opacity 0.3s;
	}
	[data-sys='1'] .trl-int {
		opacity: 0.15;
	}
	.trl-pulley {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.trl-mount {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.trl .g7__svg .trl-in {
		font-size: 11px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
</style>

<script>
	import { loop, segment, el, k as kx } from '../g7/kit';
	import { arrowPath, sig3, fmt } from './dz';

	const G = 9.8;
	const K = 100; // px per м
	const KF = 3; // px per Н
	const KA = 6; // px per м/с²
	const BW = 30; // block length, px (0,3 м)
	const GAP = 44; // thread, px (0,44 м)
	const TOP = 112; // table top
	const HOLD = 1;
	type Tab = 'train' | 'atwood' | 'push';
	const RANGES = {
		blocks: { min: 0.5, max: 3, step: 0.5 },
		atwood: { min: 0.1, max: 2, step: 0.05 },
	};
	const tex = (v: number) => sig3(v).replace(',', '{,}').replace('−', '-');
	const nb = (s: string) => s.replace(/ (?=[НкмгсN])/g, ' ');
	const SUB = ['₁', '₂', '₃'];

	for (const root of document.querySelectorAll<HTMLElement>('[data-trl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = $<SVGSVGElement>('[data-svg]');
		const sc = $<SVGGElement>('[data-scene]');
		const read = $('[data-read]');
		const msg = $('[data-msg]');
		const eqs = $('[data-eqs]');
		const sl = (n: string) => $<HTMLInputElement>(`[data-s="${n}"]`);
		const state: Record<Tab, Record<string, number>> = {
			train: { n: 3, m1: 1, m2: 1, m3: 1, F: 12, mu: 0.2 },
			atwood: { m1: 0.5, m2: 0.55 },
			push: { m1: 1, m2: 3, F: 8, mu: 0 },
		};
		let tab: Tab = 'train';
		let sys = false;
		let t = 0;

		/** The physics of the current tab. */
		const solve = () => {
			const s = state[tab];
			if (tab === 'atwood') {
				const M = s.m1 + s.m2;
				const a = (Math.abs(s.m2 - s.m1) * G) / M;
				return { M, a, moving: a > 1e-9, T: [(2 * s.m1 * s.m2 * G) / M], heavy: s.m2 >= s.m1 ? 2 : 1 };
			}
			const ms = tab === 'train' ? [s.m1, s.m2, s.m3].slice(0, s.n) : [s.m1, s.m2];
			const M = ms.reduce((x, y) => x + y, 0);
			const moving = s.F > s.mu * M * G + 1e-9;
			const a = moving ? (s.F - s.mu * M * G) / M : 0;
			// the thread (or the contact) behind body k carries F · (mass behind it) / M
			const T = ms.slice(0, -1).map((_, i) => (s.F * ms.slice(i + 1).reduce((x, y) => x + y, 0)) / M);
			return { M, a, moving, T, ms, heavy: 0 };
		};

		const label = (x: number, y: number, html: string, cls: string, anchor = 'middle') => {
			const tx = el('text', { class: `dz-sym ${cls}`, x: x.toFixed(1), y: y.toFixed(1), 'text-anchor': anchor });
			tx.innerHTML = html;
			return tx;
		};
		const arrow = (x1: number, y1: number, x2: number, y2: number, cls: string, internal = false) => {
			const p = el('path', { class: `${cls}${internal ? ' trl-int' : ''}`, d: arrowPath(x1, y1, x2, y2, 2.6, 8, 1.5) });
			sc.append(p);
			return p;
		};
		const sub = (s: string) => `<tspan class="dz-sub" dy="4">${s}</tspan>`;

		const draw = () => {
			const s = state[tab];
			const r = solve();
			const tr = Math.min(t, r.moving ? Math.sqrt(2 / r.a) : 0);
			const d = r.moving ? 0.5 * r.a * tr * tr : 0; // м
			const dx = d * K;
			sc.replaceChildren();
			if (tab === 'atwood') {
				svg.setAttribute('viewBox', '0 0 380 312');
				const PC = { x: 190, y: 30 };
				const PR = 22;
				const h = (m: number) => 10 + 10 * m;
				const y0 = (i: 1 | 2) => (!r.moving ? 150 : r.heavy === i ? 100 : 200);
				const yTop = (i: 1 | 2) => y0(i) + (r.moving ? (r.heavy === i ? dx : -dx) : 0);
				const X = { 1: PC.x - PR, 2: PC.x + PR };
				sc.append(el('path', { class: 'dz-hatch', d: Array.from({ length: 8 }, (_, i) => `M${162 + i * 8} 8 l7 -8`).join(' ') }));
				sc.append(el('path', { class: 'dz-gline', d: 'M158 8 H222' }));
				sc.append(el('path', { class: 'trl-mount', d: `M${PC.x} 8 V${PC.y}` }));
				sc.append(el('path', { class: 'dz-thread', d: `M${X[1]} ${yTop(1).toFixed(1)} V${PC.y} A${PR} ${PR} 0 0 1 ${X[2]} ${PC.y} V${yTop(2).toFixed(1)}` }));
				sc.append(el('circle', { class: 'trl-pulley', cx: PC.x, cy: PC.y, r: PR - 1.5 }));
				sc.append(el('circle', { class: 'dz-dot', cx: PC.x, cy: PC.y, r: 2.4 }));
				// a scale of metres beside the right load
				for (let i = 0; i <= 4; i++) {
					const y = 100 + i * 25;
					sc.append(el('path', { class: 'ln', d: `M300 ${y} h8` }));
					sc.append(el('text', { class: 'dz-lab', x: 312, y: y + 4 }, `${fmt(i * 0.25, 2)} м`));
				}
				sc.append(el('path', { class: 'ln', d: 'M304 100 V200' }));
				const KFA = 4; // px per Н for the light loads of this tab
				const Tpx = r.T[0] * KFA;
				([1, 2] as const).forEach((i) => {
					const m = i === 1 ? s.m1 : s.m2;
					const y = yTop(i);
					const x = X[i];
					const out = i === 1 ? -1 : 1; // labels on the outer side
					sc.append(el('rect', { class: 'trl-block', x: x - 13, y: y.toFixed(1), width: 26, height: h(m), rx: 2 }));
					const tm = el('text', { class: 'trl-in', x, y: (y + h(m) / 2 + 4).toFixed(1), 'text-anchor': 'middle' });
					tm.textContent = `m${SUB[i - 1]}`;
					sc.append(tm);
					arrow(x, y, x, y - Tpx, 'dz-f--el', true);
					sc.append(label(x + out * 28, y - Tpx / 2 + 5, 'T', 'dz-t--el trl-int'));
					const yb = y + h(m);
					arrow(x, yb, x, yb + m * G * KFA, 'dz-f--grav');
					sc.append(label(x + out * 20, Math.max(yb + m * G * KFA - 2, yb + 16), `m${sub(String(i))}<tspan dy="-4">g</tspan>`, 'dz-t--grav', out < 0 ? 'end' : 'start'));
					if (r.moving) {
						const dir = r.heavy === i ? 1 : -1;
						const ax = x + out * 54;
						const ay = y + h(m) / 2;
						arrow(ax, ay - (dir * r.a * KA) / 2, ax, ay + (dir * r.a * KA) / 2, 'dz-f--a');
						sc.append(label(ax + out * 11, ay + 5, 'a', 'dz-t--a'));
					}
				});
				if (sys) {
					const ys = [yTop(1), yTop(2)];
					sc.append(el('rect', { class: 'trl-out', x: 150, y: 2, width: 80, height: Math.max(...ys) + 36, rx: 10 }));
				}
			} else {
				svg.setAttribute('viewBox', '0 36 380 108');
				const ms = r.ms!;
				const n = ms.length;
				const hgt = (m: number) => 12 + 8 * m;
				// the table and marks every 0,25 м
				sc.append(el('rect', { class: 'trl-table', x: 0, y: TOP, width: 380, height: 15 }));
				for (let x = 10; x < 380; x += 30) sc.append(el('path', { class: 'trl-mark', d: `M${x} ${TOP} v4` }));
				// left faces of the bodies, from the back one; body 1 is the front (right) one
				const x0 = tab === 'train' ? 10 : 96;
				const step = tab === 'train' ? BW + GAP : BW;
				// train: m₁ is the front (right) block; push: m₁ is the back (left) block that F pushes
				const left = (i: number) => x0 + (tab === 'train' ? n - 1 - i : i) * step + dx;
				const yThread = TOP - 9;
				for (let i = 0; i < n; i++) {
					const m = ms[i];
					const x = left(i);
					sc.append(el('rect', { class: 'trl-block', x: x.toFixed(1), y: TOP - hgt(m), width: BW, height: hgt(m), rx: 2 }));
					const tm = el('text', { class: 'trl-in', x: (x + BW / 2).toFixed(1), y: TOP + 12.5, 'text-anchor': 'middle' });
					tm.textContent = `m${SUB[i]}`;
					sc.append(tm);
					// friction, backward, along the table, while moving or about to
					const fr = r.moving ? s.mu * m * G : 0;
					// a weak friction is drawn at least 12 px long (out of scale), or at 390 px it would vanish under its head
					if (fr > 0.05) arrow(x + BW / 2, TOP - 1, x + BW / 2 - Math.max(fr * KF, 12), TOP - 1, 'dz-f--fr');
				}
				if (tab === 'train') {
					for (let i = 0; i < n - 1; i++) {
						const xa = left(i + 1) + BW; // front face of the body behind
						const xb = left(i); // back face of the body in front
						sc.append(el('path', { class: 'dz-thread', d: `M${xa.toFixed(1)} ${yThread} H${xb.toFixed(1)}` }));
						if (r.moving) {
							const Tp = r.T[i] * KF;
							arrow(xb, yThread - 4, xb - Tp, yThread - 4, 'dz-f--el', true);
							arrow(xa, yThread + 4, xa + Tp, yThread + 4, 'dz-f--el', true);
							sc.append(label((xa + xb) / 2, yThread - 12, `T${sub(String(i + 1))}`, 'dz-t--el trl-int'));
						}
					}
					// F pulls the front block by a short thread
					const xf = left(0) + BW;
					sc.append(el('path', { class: 'dz-thread', d: `M${xf.toFixed(1)} ${yThread} h${Math.max(10, s.F * KF + 4).toFixed(1)}` }));
					if (s.F > 0) {
						arrow(xf, yThread - 4, xf + s.F * KF, yThread - 4, 'dz-f--el');
						sc.append(label(xf + (s.F * KF) / 2, yThread - 13, 'F', 'dz-t--el'));
					}
				} else {
					// the push: F on the back face of body 1, the contact pair between the bodies
					const xb = left(0);
					if (s.F > 0) {
						arrow(xb - s.F * KF, TOP - 16, xb, TOP - 16, 'dz-f--el');
						sc.append(label(xb - (s.F * KF) / 2, TOP - 24, 'F', 'dz-t--el'));
					}
					if (r.moving) {
						const xc = left(1); // the contact: the back face of m₂
						const Np = r.T[0] * KF;
						arrow(xc, TOP - 26, xc + Np, TOP - 26, 'dz-f--el', true);
						arrow(xc, TOP - 6, xc - Np, TOP - 6, 'dz-f--el', true);
						sc.append(label(Math.min(xc + Np / 2 + 2, left(1) + BW - 6), Math.min(TOP - 34, TOP - Math.max(...ms.map(hgt)) - 6), `N${sub('12')}`, 'dz-t--el trl-int'));
					}
				}
				if (r.moving) {
					// the acceleration, the same for all
					const ya = 44;
					arrow(10, ya, 10 + r.a * KA, ya, 'dz-f--a');
					sc.append(label(16 + r.a * KA, ya + 5, 'a', 'dz-t--a', 'start'));
				}
				if (sys) {
					const xl = Math.min(left(0), left(n - 1)) - 8;
					const xr = Math.max(left(0), left(n - 1)) + BW + 8;
					sc.append(el('rect', { class: 'trl-out', x: xl.toFixed(1), y: TOP - 60, width: (xr - xl).toFixed(1), height: 77, rx: 8 }));
				}
			}
		};

		const texts = () => {
			const s = state[tab];
			const r = solve();
			const item = (name: string, v: string, key = false) => `<li${key ? ' class="is-key"' : ''}><span>${name}</span> <b>${nb(v)}</b></li>`;
			let html = '';
			let lines: string[] = [];
			if (tab === 'atwood') {
				html += item('Ускорение <i>a</i>', `${sig3(r.a)} м/с²`, true);
				html += item('Натяжение <i>T</i>', `${sig3(r.T[0])} Н`, true);
				html += item('Время пути 1 м', r.moving ? `${sig3(Math.sqrt(2 / r.a))} с` : '—');
				const [h, l] = r.heavy === 2 ? ['2', '1'] : ['1', '2'];
				if (!r.moving) msg.textContent = 'Массы равны: грузы покоятся, T = mg.';
				else msg.innerHTML = `Груз <i>m</i><sub>${h}</sub> тяжелее: он опускается, а <i>m</i><sub>${l}</sub> поднимается. Сила натяжения нити меньше <i>m</i><sub>${h}</sub><i>g</i> и больше <i>m</i><sub>${l}</sub><i>g</i>.`;
				if (sys) {
					const mh = r.heavy === 2 ? s.m2 : s.m1;
					const ml = r.heavy === 2 ? s.m1 : s.m2;
					lines = [`(m_1 + m_2)\\,a = m_${h}g - m_${l}g`, `${tex(s.m1 + s.m2)}~\\text{кг}\\cdot ${tex(r.a)}~\\text{м/с}^2 = ${tex(mh * G)}~\\text{Н} - ${tex(ml * G)}~\\text{Н}`];
				} else if (r.moving) lines = [`m_${h}a = m_${h}g - T`, `m_${l}a = T - m_${l}g`];
				else lines = ['0 = T - m_1g = T - m_2g'];
			} else {
				const n = r.ms!.length;
				html += item('Ускорение <i>a</i>', `${sig3(r.a)} м/с²`, true);
				if (tab === 'train') r.T.forEach((T, i) => (html += item(`Натяжение <i>T</i><sub>${i + 1}</sub>`, r.moving ? `${sig3(T)} Н` : '—', true)));
				else html += item('Брусок давит на брусок, <i>N</i><sub>12</sub>', r.moving ? `${sig3(r.T[0])} Н` : '—', true);
				const Mtex = r.ms!.map((_, i) => `m_${i + 1}`).join(' + ');
				if (!r.moving) {
					msg.innerHTML = `Бруски не сдвинулись: <i>F</i> ≤ μ(${r.ms!.map((_, i) => `<i>m</i><sub>${i + 1}</sub>`).join(' + ')})<i>g</i> = ${nb(sig3(s.mu * r.M * G))} Н.`;
					lines = [];
				} else {
					msg.textContent = tab === 'train' ? 'Передняя нить тянет все бруски позади себя, поэтому она натянута сильнее задней.' : 'Брусок 1 толкает брусок 2 и разгоняет только его.';
					const fr = (i: number) => (s.mu > 0 ? ` - \\mu m_${i}g` : '');
					if (sys) lines = [`(${Mtex})\\,a = F${s.mu > 0 ? ` - \\mu(${Mtex})g` : ''}`, `${tex(r.M)}~\\text{кг}\\cdot ${tex(r.a)}~\\text{м/с}^2 = ${tex(s.F)}~\\text{Н}${s.mu > 0 ? ` - ${tex(s.mu * r.M * G)}~\\text{Н}` : ''}`];
					else if (tab === 'train')
						lines = Array.from({ length: n }, (_, i) => {
							const fwd = i === 0 ? 'F' : `T_${i}`;
							const back = i < n - 1 ? ` - T_${i + 1}` : '';
							return `m_${i + 1}a = ${fwd}${back}${fr(i + 1)}`;
						});
					else lines = [`m_1a = F - N_{12}${fr(1)}`, `m_2a = N_{12}${fr(2)}`];
				}
			}
			read.innerHTML = html;
			eqs.innerHTML = lines.map((l) => `<li class="is-key">${kx(l)}</li>`).join('');
		};

		const outputs = () => {
			const s = state[tab];
			const unit: Record<string, string> = { m1: 'кг', m2: 'кг', m3: 'кг', F: 'Н', mu: '' };
			for (const n of ['m1', 'm2', 'm3', 'F', 'mu']) {
				if (s[n] === undefined) continue;
				const digits = n === 'F' ? 0 : 2;
				$(`[data-o="${n}"]`).textContent = `${fmt(s[n], digits)}${unit[n] ? ` ${unit[n]}` : ''}`;
			}
		};
		const restart = () => {
			t = 0;
			outputs();
			texts();
			draw();
			wake();
		};
		const setTab = (tb: Tab) => {
			tab = tb;
			root.dataset.tab = tb;
			const s = state[tb];
			const rg = tb === 'atwood' ? RANGES.atwood : RANGES.blocks;
			for (const n of ['m1', 'm2', 'm3']) {
				const i = sl(n);
				i.min = String(rg.min);
				i.max = String(rg.max);
				i.step = String(rg.step);
			}
			for (const n of ['m1', 'm2', 'm3', 'F', 'mu']) if (s[n] !== undefined) sl(n).value = String(s[n]);
			const show = (n: string, on: boolean) => ($<HTMLElement>(`[data-row="${n}"]`).hidden = !on);
			show('m3', tb === 'train' && s.n === 3);
			show('F', tb !== 'atwood');
			show('mu', tb !== 'atwood');
			$<HTMLElement>('[data-countrow]').hidden = tb !== 'train';
			restart();
		};
		for (const n of ['m1', 'm2', 'm3', 'F', 'mu'])
			sl(n).addEventListener('input', () => {
				state[tab][n] = Number(sl(n).value);
				restart();
			});
		segment($('[data-count]'), (b) => {
			state.train.n = Number(b.dataset.n);
			$<HTMLElement>('[data-row="m3"]').hidden = state.train.n !== 3;
			restart();
		});
		segment($('[data-tabs]'), (b) => setTab(b.dataset.t as Tab));
		const sysBtn = $<HTMLButtonElement>('[data-sys]');
		sysBtn.addEventListener('click', () => {
			sys = !sys;
			sysBtn.setAttribute('aria-pressed', String(sys));
			root.dataset.sys = sys ? '1' : '0';
			restart();
		});
		const wake = loop(root, (dt) => {
			const r = solve();
			const T = r.moving ? Math.sqrt(2 / r.a) : 0;
			t += dt;
			if (t > T + HOLD) t = 0;
			draw();
			return true;
		});
		setTab('train');
	}
</script>
