---
/**
 * Colors and marks of the pictures and models of «Законы Ньютона» (grade 10), on top of the grade-7 frame (G7Styles).
 * Renders nothing. One color per quantity in the whole chapter: gravitation (mg) violet, elastic forces (N, T, a rope,
 * a hand) blue, friction red, velocity gold, acceleration green, the resultant ink, a second force (F₂) teal.
 * Classes: .dz-f--<c> fills an arrow path, .dz-s--<c> strokes a line, .dz-t--<c> colors a text; c = grav, el, fr, v,
 * a, res, f2.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<style is:global>
	.g7 {
		--dz-grav: var(--g7-violet);
		--dz-el: var(--g7-blue);
		--dz-fr: var(--g7-red);
		--dz-v: var(--g7-gold);
		--dz-a: var(--g7-green);
		--dz-res: var(--g7-ink);
		--dz-f2: hsl(178, 62%, 52%);
		--dz-wood: var(--g7-wood);
		--dz-wood-dark: var(--g7-wood-dark);
	}
	:root[data-theme='light'] .g7 {
		--dz-f2: hsl(180, 75%, 28%);
	}
	.dz-f--grav { fill: var(--dz-grav); }
	.dz-f--el { fill: var(--dz-el); }
	.dz-f--fr { fill: var(--dz-fr); }
	.dz-f--v { fill: var(--dz-v); }
	.dz-f--a { fill: var(--dz-a); }
	.dz-f--res { fill: var(--dz-res); }
	.dz-f--f2 { fill: var(--dz-f2); }
	.dz-s--grav { stroke: var(--dz-grav); }
	.dz-s--el { stroke: var(--dz-el); }
	.dz-s--fr { stroke: var(--dz-fr); }
	.dz-s--v { stroke: var(--dz-v); }
	.dz-s--a { stroke: var(--dz-a); }
	.dz-s--res { stroke: var(--dz-res); }
	.dz-s--f2 { stroke: var(--dz-f2); }
	.g7__svg .dz-t--grav { fill: var(--dz-grav); }
	.g7__svg .dz-t--el { fill: var(--dz-el); }
	.g7__svg .dz-t--fr { fill: var(--dz-fr); }
	.g7__svg .dz-t--v { fill: var(--dz-v); }
	.g7__svg .dz-t--a { fill: var(--dz-a); }
	.g7__svg .dz-t--res { fill: var(--dz-res); }
	.g7__svg .dz-t--f2 { fill: var(--dz-f2); }
	.g7__svg .dz-sym {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 15px;
		font-weight: 700;
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.g7__svg .dz-sub {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 10.5px;
		font-weight: 600;
	}
	.dz-over {
		fill: none;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.g7__svg .dz-lab {
		font-size: 11.5px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.dz-lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
	}
	.dz-dash {
		fill: none;
		stroke-width: 1.3;
		stroke-dasharray: 4 3;
	}
	.dz-axis {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.dz-axhd {
		fill: var(--g7-line);
	}
	.dz-wood {
		fill: var(--dz-wood);
		stroke: var(--dz-wood-dark);
		stroke-width: 1.2;
	}
	.dz-metal {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.dz-ground {
		fill: var(--g7-ground);
	}
	.dz-gline {
		stroke: var(--g7-line);
		stroke-width: 1.4;
		fill: none;
	}
	.dz-thread {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.3;
		fill: none;
	}
	.dz-hatch {
		stroke: var(--g7-line);
		stroke-width: 0.9;
		fill: none;
	}
	.dz-dot {
		fill: var(--g7-ink);
	}
	.dz-faint {
		opacity: 0.28;
	}
	/* panel titles inside the picture frame (two or three panels side by side) */
	.dz-panel {
		margin: 0;
		display: flex;
		flex-direction: column;
	}
	.dz-panel figcaption {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.dz-panel figcaption i,
	.g7__caption i {
		font-family: var(--ig-font-math);
	}
</style>
