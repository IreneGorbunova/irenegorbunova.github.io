---
/**
 * «Сложение сил под углом»: two forces applied to one point (a ring pulled by two ropes). F₁ (0…60 Н) lies along the
 * x axis, F₂ (0…60 Н) makes the angle α (0…180°, step 15°) with it. The resultant F is the diagonal of the
 * parallelogram built on them (dashed sides); its projections are the sums of the projections of the forces:
 * Fx = F₁ + F₂ cos α, Fy = F₂ sin α, F = √(Fx² + Fy²). Scale: 2 px per newton, grid 10 Н. Colors of the chapter:
 * F₁ blue, F₂ teal (green is the acceleration in this chapter), the resultant in the ink color (red is friction).
 */
import DzStyles from './DzStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const O = { x: 130, y: 150 };
const S = 2;
---

<DzStyles />
<figure class="g7 vsum not-content" data-vsum>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 176" role="img" aria-label="Две силы, приложенные к кольцу, и их равнодействующая — диагональ параллелограмма" data-svg>
			<defs>
				{['blue', 'teal', 'ink'].map((c) => <marker id={`vs-${uid}-${c}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${c}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			{Array.from({ length: 37 }, (_, i) => <line class="vsum__grid" x1={O.x + (i - 13) * 10 * S} x2={O.x + (i - 13) * 10 * S} y1="0" y2="176" />).filter((_, i) => O.x + (i - 13) * 20 >= 0 && O.x + (i - 13) * 20 <= 380)}
			{Array.from({ length: 9 }, (_, i) => <line class="vsum__grid" x1="0" x2="380" y1={O.y - (i - 1) * 10 * S} y2={O.y - (i - 1) * 10 * S} />)}
			<line class="vsum__axis" x1="4" x2="376" y1={O.y} y2={O.y} />
			<line class="vsum__axis" x1={O.x} x2={O.x} y1="172" y2="6" />
			<text class="t-i" x="368" y={O.y - 6}>x</text>
			<text class="t-i" x={O.x + 6} y="16">y</text>
						<text class="t-small" x={O.x + 60 * S} y={O.y + 14} text-anchor="middle">60 Н</text>
			<line class="ln-dash" data-p1 />
			<line class="ln-dash" data-p2 />
			<line class="vsum__proj" data-rx y1={O.y} y2={O.y} x1={O.x} />
			<line class="vsum__proj" data-ry x1={O.x} x2={O.x} y1={O.y} />
			<line class="ln-dash vsum__drop" data-dx />
			<line class="ln-dash vsum__drop" data-dy />
			<line class="arrow arrow--blue" data-f1 x1={O.x} y1={O.y} marker-end={`url(#vs-${uid}-blue)`} />
			<line class="arrow vsum__f2" data-f2 x1={O.x} y1={O.y} marker-end={`url(#vs-${uid}-teal)`} />
			<line class="arrow vsum__res" data-r x1={O.x} y1={O.y} marker-end={`url(#vs-${uid}-ink)`} />
			<path class="vsum__arc" data-arc />
			<text class="t-small t-halo" data-alab></text>
			<circle class="vsum__ring" cx={O.x} cy={O.y} r="5" />
			<text class="t-i t-blue t-halo" data-l1>F<tspan class="vsum__sub" dy="3">1</tspan></text>
			<text class="t-i vsum__tf2 t-halo" data-l2>F<tspan class="vsum__sub" dy="3">2</tspan></text>
			<text class="t-i t-halo vsum__lr" data-lr>F</text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Сила <i>F</i><sub>1</sub> (вдоль оси <i>x</i>)</span>
				<output data-o1></output>
				<input type="range" min="0" max="60" step="5" value="30" data-s1 aria-label="Первая сила, ньютоны" />
			</label>
			<label class="g7__slider">
				<span>Сила <i>F</i><sub>2</sub></span>
				<output data-o2></output>
				<input type="range" min="0" max="60" step="5" value="40" data-s2 aria-label="Вторая сила, ньютоны" />
			</label>
			<label class="g7__slider">
				<span>Угол между силами α</span>
				<output data-oa></output>
				<input type="range" min="0" max="180" step="15" value="90" data-sa aria-label="Угол между силами, градусы" />
			</label>
			<ul class="g7__lines" data-lines></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Кольцо тянут за две верёвки. Масштаб: одна клетка — 10&nbsp;Н. Пунктир — стороны параллелограмма. Толстая стрелка <i>F</i> — равнодействующая, широкие полупрозрачные полоски на осях — её проекции.
	</figcaption>
</figure>

<style is:global>
	.vsum__grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.vsum__axis {
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.vsum__proj {
		stroke: var(--g7-ink);
		stroke-width: 5;
		opacity: 0.45;
		stroke-linecap: butt;
	}
	.vsum .g7__svg .head--teal {
		fill: var(--dz-f2);
	}
	.vsum__f2 {
		stroke: var(--dz-f2);
	}
	.vsum .g7__svg .vsum__tf2 {
		fill: var(--dz-f2);
	}
	.vsum__drop {
		opacity: 0.6;
	}
	.vsum__res {
		stroke: var(--g7-ink);
		stroke-width: 3.6;
	}
	.vsum .g7__svg .vsum__lr {
		fill: var(--g7-ink);
		font-weight: 700;
	}
	.vsum__arc {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.vsum__ring {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.vsum svg .vsum__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>

<script>
	import { fmt, fmtTrim, k, tex } from '../g7/kit';
	import { place, ring, segOf, type Seg, type Box } from './place';

	const O = { x: 130, y: 150 };
	const S = 2;
	for (const root of document.querySelectorAll<HTMLElement>('[data-vsum]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const s1 = q<HTMLInputElement>('[data-s1]');
		const s2 = q<HTMLInputElement>('[data-s2]');
		const sa = q<HTMLInputElement>('[data-sa]');
		const set = (sel: string, a: Record<string, number | string>) => {
			const e = q(sel);
			for (const [n, v] of Object.entries(a)) e.setAttribute(n, typeof v === 'number' ? v.toFixed(1) : v);
		};
		// an arrow from the origin to a point, 4 px shorter so the head ends at the point
		const arrow = (sel: string, x: number, y: number) => {
			const L = Math.hypot(x, y);
			const c = L > 4 ? (L - 4) / L : 0;
			set(sel, { x2: O.x + x * c, y2: O.y - y * c });
			q<SVGElement>(sel).style.visibility = L > 1 ? 'visible' : 'hidden';
		};
		const draw = () => {
			const F1 = Number(s1.value);
			const F2 = Number(s2.value);
			const al = Number(sa.value);
			const r = (al * Math.PI) / 180;
			const f2x = F2 * Math.cos(r);
			const f2y = F2 * Math.sin(r);
			const Fx = F1 + f2x;
			const Fy = f2y;
			const F = Math.hypot(Fx, Fy);
			arrow('[data-f1]', F1 * S, 0);
			arrow('[data-f2]', f2x * S, f2y * S);
			arrow('[data-r]', Fx * S, Fy * S);
			// the parallelogram's other two sides
			set('[data-p1]', { x1: O.x + F1 * S, y1: O.y, x2: O.x + Fx * S, y2: O.y - Fy * S });
			set('[data-p2]', { x1: O.x + f2x * S, y1: O.y - f2y * S, x2: O.x + Fx * S, y2: O.y - Fy * S });
			set('[data-rx]', { x2: O.x + Fx * S });
			set('[data-ry]', { y2: O.y - Fy * S });
			set('[data-dx]', { x1: O.x + Fx * S, y1: O.y - Fy * S, x2: O.x + Fx * S, y2: O.y });
			set('[data-dy]', { x1: O.x + Fx * S, y1: O.y - Fy * S, x2: O.x, y2: O.y - Fy * S });
			// the angle between the forces
			const R = 18;
			q('[data-arc]').setAttribute('d', al > 0 && F1 > 0 && F2 > 0 ? `M${O.x + R} ${O.y} A${R} ${R} 0 0 0 ${(O.x + R * Math.cos(r)).toFixed(1)} ${(O.y - R * Math.sin(r)).toFixed(1)}` : '');
			const lab = q<SVGTextElement>('[data-alab]');
			// labels: each takes the first free place around its arrow (place.ts); the resultant first
			lab.textContent = al > 0 && F1 > 0 && F2 > 0 ? `${al}°` : '';
			const P = (x: number, y: number) => ({ x: O.x + x * S, y: O.y - y * S });
			const t1 = P(F1, 0);
			const t2 = P(f2x, f2y);
			const tr = P(Fx, Fy);
			const segs: Seg[] = [segOf(O.x, O.y, t1.x, t1.y), segOf(O.x, O.y, t2.x, t2.y), segOf(O.x, O.y, tr.x, tr.y, 3.5), segOf(O.x, O.y, tr.x, O.y, 3), segOf(O.x, O.y, O.x, tr.y, 3)];
			for (let i = 0; i < 8 && al > 0; i++) {
				const a1 = (r * i) / 8;
				const a2 = (r * (i + 1)) / 8;
				segs.push(segOf(O.x + R * Math.cos(a1), O.y - R * Math.sin(a1), O.x + R * Math.cos(a2), O.y - R * Math.sin(a2), 1));
			}
			const boxes: Box[] = [{ x0: O.x - 7, y0: O.y - 7, x1: O.x + 7, y1: O.y + 7 }, { x0: O.x + 60 * S - 16, y0: O.y + 4, x1: O.x + 60 * S + 16, y1: O.y + 17 }, { x0: O.x + 4, y0: 4, x1: O.x + 16, y1: 20 }, { x0: 364, y0: O.y - 18, x1: 378, y1: O.y - 2 }];
			const view: Box = { x0: 2, y0: 2, x1: 378, y1: 174 };
			const dirOf = (x: number, y: number) => Math.atan2(-y, x);
			const show = (sel: string, on: boolean) => (q<SVGElement>(sel).style.visibility = on ? 'visible' : 'hidden');
			show('[data-lr]', F > 0.5);
			show('[data-l2]', F2 > 0);
			show('[data-l1]', F1 > 0);
			if (F > 0.5) place(q('[data-lr]'), [...ring(tr.x, tr.y, 13, dirOf(Fx, Fy), 16), ...ring(tr.x, tr.y, 22, dirOf(Fx, Fy), 16)], segs, boxes, view);
			const mid = (t: { x: number; y: number }, k: number) => ({ x: O.x + (t.x - O.x) * k, y: O.y + (t.y - O.y) * k });
			if (F2 > 0) {
				const d2 = dirOf(f2x, f2y);
				const c2 = [0.55, 0.8, 0.3].flatMap((k) => ring(mid(t2, k).x, mid(t2, k).y, 13, d2 - Math.PI / 2, 8));
				place(q('[data-l2]'), [...c2, ...ring(t2.x, t2.y, 14, d2, 12), ...ring(t2.x, t2.y, 24, d2, 16), ...ring(O.x, O.y, 34, d2, 16)], segs, boxes, view);
			}
			const placeAngle = () => {
				if (!lab.textContent) return;
				const beta = Math.atan2(Fy, Fx);
				const la = beta > r / 2 ? beta / 2 : (beta + r) / 2;
				const ca = [30, 38, 46, 56].flatMap((rr) => [la, r * 0.25, r * 0.75, r * 0.5, -0.3, r + 0.3].map((a) => ({ x: O.x + rr * Math.cos(a), y: O.y - rr * Math.sin(a) + 4, anchor: 'middle' as const })));
				place(lab, ca, segs, boxes, view);
			};
			placeAngle();
			if (F1 > 0) place(q('[data-l1]'), [...[0.5, 0.75, 0.3].flatMap((k) => ring(mid(t1, k).x, mid(t1, k).y, 13, Math.PI / 2, 8)), ...ring(t1.x, t1.y, 16, Math.PI / 2, 12), ...ring(O.x, O.y, 26, Math.PI / 2, 16), ...ring(O.x, O.y, 40, Math.PI / 2, 16)], segs, boxes, view);
			q('[data-o1]').textContent = `${F1} Н`;
			q('[data-o2]').textContent = `${F2} Н`;
			q('[data-oa]').textContent = `${al}°`;
			const n = (v: number) => tex(fmtTrim(v, 1));
			const plus = (v: number) => (v < -0.05 ? `(${n(v)})` : n(v));
			q('[data-lines]').innerHTML = [
				`<li>${k(`F_{1x} = ${F1}~\\text{Н},\\quad F_{2x} = ${n(f2x)}~\\text{Н}`)}</li>`,
				`<li class="is-key">${k(`F_x = ${F1} + ${plus(f2x)} = ${n(Fx)}~\\text{Н}`)}</li>`,
				`<li class="is-key">${k(`F_y = 0 + ${n(f2y)} = ${n(Fy)}~\\text{Н}`)}</li>`,
				`<li class="is-key">${k(`F = \\sqrt{F_x^2 + F_y^2} = ${tex(fmtTrim(F, 1))}~\\text{Н}`)}</li>`,
			].join('');
		};
		for (const s of [s1, s2, sa]) s.addEventListener('input', draw);
		draw();
	}
</script>
