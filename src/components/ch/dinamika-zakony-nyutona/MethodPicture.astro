---
/**
 * «Четыре шага» (section «Как применять второй закон Ньютона»): the method on one sled pulled by a rope at the angle α
 * to the horizontal over snow; the rope goes on out of the picture. Buttons «1 Тело», «2 Силы», «3 Оси»,
 * «4 Уравнения» and «Далее»; the steps add up.
 *   1. The body: the sled with its load is outlined, everything else is faded.
 *   2. The forces, all from the bodies that act on the sled, drawn from its center: mg (the Earth, violet) down, N (the
 *      snow, blue) up, F (the rope, blue) along the rope, F_тр (the snow, red) back.
 *   3. The axes: x along the road, in the direction of the acceleration a (green), y up; drawn apart, in a corner.
 *   4. The equations: dashed projections of F (F cos α along x, F sin α along y) and ma_x = F_x, ma_y = F_y in
 *      projections: x: ma = F cos α − F_тр; y: 0 = N + F sin α − mg.
 * Letters only, no numbers (the worked task under the picture has them). The lengths agree with one another:
 * mg 70 px, F 56 px at α = 30° (F sin α = 28 px, F cos α = 48,5 px), N = mg − F sin α = 42 px, F_тр 26 px, so the
 * resultant 22,5 px points forward along x, as a does.
 */
import katex from 'katex';
import DzStyles from './DzStyles.astro';
import { arrowPath, over, f1 } from './dz';

const C = { x: 150, y: 104 }; // the center of the sled with its load
const GROUND = 134;
const al = Math.PI / 6;
const Fv = { x: 56 * Math.cos(al), y: -56 * Math.sin(al) };
const tip = { x: C.x + Fv.x, y: C.y + Fv.y };
const tie = { x: 191, y: 127 }; // the rope is tied low at the front of the sled, so it passes under «F sin α»
const ropeEnd = { x: tie.x + 260 * Math.cos(al), y: tie.y - 260 * Math.sin(al) };
const hatch = Array.from({ length: 40 }, (_, i) => `M${i * 10} 200 L${i * 10 + 14} ${GROUND + 2}`).join(' ');
const eq = (s: string) => katex.renderToString(s, { throwOnError: false });
const eqs = [eq('x\\colon\\; ma = F\\cos\\alpha - F_{\\text{тр}}'), eq('y\\colon\\; 0 = N + F\\sin\\alpha - mg')];
const flakes = [
	[30, 30],
	[70, 60],
	[120, 22],
	[250, 40],
	[300, 70],
	[340, 26],
	[220, 82],
	[40, 96],
];
---

<DzStyles />
<figure class="g7 mth not-content" data-mth data-step="1">
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="40 40 300 166" role="img" aria-label="Санки с грузом тянут за верёвку под углом к горизонту. По шагам: выбрано тело, нарисованы силы, выбраны оси, записаны уравнения в проекциях">
			<g class="mth-world">
				<rect class="mth-snow" x="0" y={GROUND} width="380" height={200 - GROUND}></rect>
				<path class="dz-hatch" d={hatch}></path>
				<path class="dz-gline" d={`M0 ${GROUND} H380`}></path>
				{flakes.map(([x, y]) => <circle class="mth-flake" cx={x} cy={y} r="1.6" />)}
				<path class="mth-rope" d={`M${tie.x} ${tie.y} L${f1(ropeEnd.x)} ${f1(ropeEnd.y)}`}></path>
			</g>
			<g class="mth-body">
				<path class="mth-runner" d={`M104 ${GROUND - 1} H186 q8 0 8 -8 q0 -6 -6 -7`}></path>
				<path class="mth-post" d={`M114 ${GROUND - 1} v-10 M178 ${GROUND - 1} v-10`}></path>
				<rect class="dz-wood" x="106" y={GROUND - 15} width="82" height="6" rx="1.5"></rect>
				<rect class="mth-load" x="118" y="82" width="58" height="38" rx="3"></rect>
				<path class="mth-log" d="M122 92 h50 M122 102 h50 M122 112 h50"></path>
			</g>
			<rect class="mth-outline" x="98" y="76" width="102" height={GROUND - 72} rx="8"></rect>
			<!-- step 2: the forces -->
			<g class="mth-s2">
				<path class="dz-f--grav" d={arrowPath(C.x, C.y, C.x, C.y + 70, 3, 11)}></path>
				<path class="dz-f--el" d={arrowPath(C.x, C.y, C.x, C.y - 42, 3, 11)}></path>
				<path class="dz-f--el" d={arrowPath(C.x, C.y, tip.x, tip.y, 3, 11)}></path>
				<path class="dz-f--fr" d={arrowPath(C.x, C.y, C.x - 26, C.y, 3, 10)}></path>
				<circle class="dz-dot" cx={C.x} cy={C.y} r="2.6"></circle>
				<text class="dz-sym dz-t--grav" x={C.x + 6} y={C.y + 70}>mg</text>
				<path class="dz-over dz-s--grav" d={over(C.x + 6, C.y + 70, 20)}></path>
				<text class="dz-sym dz-t--el" x={C.x - 23} y={C.y - 30}>N</text>
				<path class="dz-over dz-s--el" d={over(C.x - 23, C.y - 30, 11)}></path>
				<text class="dz-sym dz-t--el" x={f1(tip.x + 6)} y={f1(tip.y - 4)}>F</text>
				<path class="dz-over dz-s--el" d={over(tip.x + 6, tip.y - 4, 9)}></path>
				<text class="dz-sym dz-t--fr" x={C.x - 56} y={C.y - 6}>F<tspan class="dz-sub" dy="4">тр</tspan></text>
				<path class="dz-over dz-s--fr" d={over(C.x - 56, C.y - 6, 9)}></path>
			</g>
			<!-- step 3: the axes and the acceleration -->
			<g class="mth-s3">
				<path class="dz-axis" d="M52 192 H106 M52 192 V150"></path>
				<path class="dz-axhd" d="M112 192 l-8 -3.5 v7 Z M52 144 l-3.5 8 h7 Z"></path>
				<text class="t-i dz-lab" x="108" y="184">x</text>
				<text class="t-i dz-lab" x="60" y="152">y</text>
				<path class="dz-f--a" d={arrowPath(232, 190, 270, 190, 3, 10)}></path>
				<text class="dz-sym dz-t--a" x="276" y="194">a</text>
				<path class="dz-over dz-s--a" d={over(276, 194, 8)}></path>
			</g>
			<!-- step 4: the projections of F -->
			<g class="mth-s4">
				<path class="dz-dash dz-s--el" d={`M${f1(tip.x)} ${f1(tip.y)} V${C.y} M${f1(tip.x)} ${f1(tip.y)} H${C.x}`}></path>
				<text class="dz-lab mth-proj" x={f1(C.x + Fv.x * 0.62)} y={f1(tip.y - 6)} text-anchor="middle"><tspan class="mth-it">F</tspan> cos <tspan class="mth-it">α</tspan></text>
				<text class="dz-lab mth-proj" x={f1(tip.x + 5)} y={f1(C.y - 17)}><tspan class="mth-it">F</tspan> sin <tspan class="mth-it">α</tspan></text>
			</g>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Шаг" data-steps>
				<button type="button" class="g7__btn" aria-pressed="true" data-s="1">1 Тело</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-s="2">2 Силы</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-s="3">3 Оси</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-s="4">4 Уравнения</button>
			</div>
			<p class="g7__msg" data-msg aria-live="polite"></p>
			<ul class="g7__lines mth-eqs">
				{eqs.map((e) => <li class="is-key" set:html={e} />)}
			</ul>
			<button type="button" class="g7__btn g7__btn--go" data-next>Далее</button>
		</div>
	</div>
	<figcaption class="g7__caption">
		Санки с грузом тянут за верёвку под углом α к горизонту. Все силы нарисованы из центра санок, их длины согласованы друг с другом.
	</figcaption>
</figure>

<style is:global>
	.mth-snow {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-6));
	}
	.mth-flake {
		fill: var(--sl-color-gray-3);
	}
	.mth-rope {
		fill: none;
		stroke: hsl(32, 40%, 50%);
		stroke-width: 1.6;
	}
	:root[data-theme='light'] .mth-rope {
		stroke: hsl(30, 45%, 34%);
	}
	.mth-runner,
	.mth-post {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.mth-load {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.mth-log {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		fill: none;
	}
	.mth-outline {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		stroke-dasharray: 6 4;
		opacity: 0;
	}
	.mth .g7__svg .mth-it {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.mth .g7__svg .mth-proj {
		font-family: KaTeX_Main, 'Times New Roman', serif;
		font-style: normal;
		font-size: 12.5px;
		fill: var(--dz-el);
	}
	.mth-s2,
	.mth-s3,
	.mth-s4,
	.mth-eqs {
		display: none;
	}
	[data-step='1'] .mth-outline {
		opacity: 1;
	}
	[data-step='1'] .mth-world {
		opacity: 0.35;
	}
	[data-step='2'] .mth-s2,
	[data-step='3'] .mth-s2,
	[data-step='3'] .mth-s3,
	[data-step='4'] .mth-s2,
	[data-step='4'] .mth-s3,
	[data-step='4'] .mth-s4 {
		display: inline;
	}
	[data-step='4'] .mth-eqs {
		display: grid;
	}
	[data-step='2'] .mth-body,
	[data-step='3'] .mth-body,
	[data-step='4'] .mth-body {
		opacity: 0.55;
	}
</style>

<script>
	const MSG: Record<string, string> = {
		'1': '1. Выберите тело, движение которого изучаете: санки с грузом. Всё остальное — тела, которые на него действуют.',
		'2': '2. Нарисуйте все силы, приложенные к санкам. У каждой силы есть тело, которое её создаёт: Земля (mg), снег (N и Fтр), верёвка (F).',
		'3': '3. Выберите оси: x — вдоль дороги, по ускорению a; y — вверх. Вдоль оси y санки не движутся, поэтому ay = 0.',
		'4': '4. Спроецируйте силы на оси и запишите второй закон Ньютона для каждой оси.',
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-mth]')) {
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-steps] button')];
		const msg = root.querySelector('[data-msg]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const go = (s: string) => {
			root.dataset.step = s;
			for (const b of btns) b.setAttribute('aria-pressed', String(b.dataset.s === s));
			msg.innerHTML = MSG[s].replace('Fтр', '<i>F</i><sub>тр</sub>').replace('(mg)', '(<i>mg</i>)').replace('(F)', '(<i>F</i>)').replace(' N ', ' <i>N</i> ').replace('ay = 0', '<i>a<sub>y</sub></i> = 0').replace('ускорению a', 'ускорению <i>a</i>');
			next.textContent = s === '4' ? 'Сначала' : 'Далее';
		};
		for (const b of btns) b.addEventListener('click', () => go(b.dataset.s!));
		next.addEventListener('click', () => go(root.dataset.step === '4' ? '1' : String(Number(root.dataset.step) + 1)));
		go('1');
	}
</script>
