---
/**
 * Model «Опыт Штерна», seen from above. A silvered platinum wire on the axis, an inner cylinder of radius r = 1 см with
 * a slit, an outer cylinder of radius R = 8 см; the whole device turns with n revolutions per second (0–50), the air
 * pumped out. Silver atoms (M = 0,108 кг/моль) leave the hot wire (900–1500 °C); the atoms in a beam come out with the
 * speeds of an effusive beam: the flux distribution ∝ υ³·exp(−υ²/2a²), a² = RT/M (sampled exactly as υ = a·√(2x),
 * x = −ln(u₁u₂)). An atom flies the gap R − r in (R − r)/υ, while the outer cylinder turns by ω(R − r)/υ, so it lands
 * s = ωR(R − r)/υ behind the point opposite the slit. The strip below (magnified, 40 px per мм) shows where the atoms
 * land; its middle s̄ gives υ = ωR(R − r)/s̄ = 1/⟨1/υ⟩ = a⁄0,6267 ≈ 1,60a, which is exactly the mean speed of the gas
 * √(8RT/πM) = √(8/π)·a, about 8 % below the mean square speed √(3kT/m₀) = 1,73a (at 1200 °C: 537 and 583 м/с).
 * At 50 об/с and 1200 °C the middle is 3,3 мм from the zero.
 * The top view: 13 px per см; the rotation and the flight are slowed down about 9000 times, together, so the angle
 * turned during a flight is true (2,3° at 50 об/с — too small to see here, hence the magnified strip).
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 150;
const CY = 124;
const RO = 104; // 8 см
const RI = 13; // 1 см
const SX0 = 24; // the strip: 0 мм at SX0, 40 px per мм
const SK = 40;
---

<G7Styles />
<figure class="g7 not-content" data-sternlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 306" role="img" aria-label="Прибор Штерна сверху: в центре раскалённая проволока, вокруг внутренний цилиндр со щелью и внешний цилиндр. Атомы серебра летят через щель к внешнему цилиндру. Внизу — увеличенная полоска осевшего серебра со шкалой в миллиметрах">
			<circle class="st-vac" cx={CX} cy={CY} r={RO + 6}></circle>
			<g data-rot>
				<circle class="st-outer" cx={CX} cy={CY} r={RO}></circle>
				<path class="st-inner" d={`M${CX + RI * Math.sin(0.25)} ${CY - RI * Math.cos(0.25)} A${RI} ${RI} 0 1 1 ${CX - RI * Math.sin(0.25)} ${CY - RI * Math.cos(0.25)}`}></path>
				<path class="st-zero" d={`M${CX} ${CY - RO - 7} V${CY - RO + 7}`}></path>
				<g data-dep></g>
				<path class="st-arrow" d={`M${CX + 76} ${CY + 76} A107 107 0 0 0 ${CX + 104} ${CY + 24}`}></path>
			</g>
			<path class="st-arrowhead" data-head d={`M${CX + 104} ${CY + 24} l-6 4 l9 2 Z`}></path>
			<g data-atoms></g>
			<circle class="st-wire" cx={CX} cy={CY} r="3.5"></circle>
			<text class="t-small" x={CX + 8} y={CY + 18}>проволока</text>
			<text class="t-small" x="6" y="16">внешний цилиндр</text>
			<!-- the magnified strip -->
			<text class="t-small" x={SX0} y="256">полоска серебра (увеличено)</text>
			<rect class="st-strip" x={SX0} y="262" width={6.5 * SK} height="16"></rect>
			<g data-bins></g>
			<path class="st-mean" data-mean d=""></path>
			{[0, 1, 2, 3, 4, 5, 6].map((m) => <g><path class="ln" d={`M${SX0 + m * SK} 278 v5`} /><text class="t-small" x={SX0 + m * SK} y="296" text-anchor="middle">{m === 6 ? '6 мм' : m}</text></g>)}
			
		</svg>
		<div class="g7__side">
			<label class="g7__slider">Частота вращения <output data-out-n>50 об/с</output><input type="range" min="0" max="50" step="5" value="50" data-n /></label>
			<label class="g7__slider">Температура проволоки <output data-out-t>1200 °C</output><input type="range" min="900" max="1500" step="100" value="1200" data-t /></label>
			<ul class="g7__read">
				<li><span>Смещение середины полоски <i>s</i></span> <b data-s>—</b></li>
				<li class="is-warm">Скорость по смещению <b data-v1>—</b></li>
				<li class="is-key"><span>По формуле √<span class="st-nw">(3<i>kT</i>/<i>m</i>₀)</span></span> <b data-v2>—</b></li>
			</ul>
			<p class="g7__note"><i>υ</i> = <i>ωR</i>(<i>R</i> − <i>r</i>)/<i>s</i>, <i>R</i> = 8&nbsp;см, <i>r</i> = 1&nbsp;см, <i>ω</i> = 2π<i>n</i>.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Вид сверху: радиус внешнего цилиндра 8&nbsp;см. Вращение и полёт атомов замедлены примерно в 9000&nbsp;раз; за время полёта цилиндр поворачивается всего на 2–3°, поэтому смещение видно только на увеличенной полоске.</figcaption>
</figure>

<style is:global>
	[data-sternlab] .st-vac {
		fill: color-mix(in oklab, var(--g7-blue) 5%, var(--g7-paper));
		stroke: var(--g7-faint);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	[data-sternlab] .st-outer {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 6;
	}
	[data-sternlab] .st-inner {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 4;
	}
	[data-sternlab] .st-zero {
		stroke: var(--g7-green);
		stroke-width: 2;
	}
	[data-sternlab] .st-wire {
		fill: var(--g7-gold);
		stroke: var(--g7-red);
		stroke-width: 1.5;
	}
	[data-sternlab] .st-atom {
		fill: var(--sl-color-gray-1);
	}
	[data-sternlab] .st-dep {
		fill: var(--sl-color-gray-1);
		opacity: 0.35;
	}
	[data-sternlab] .st-arrow {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	[data-sternlab] .st-arrowhead {
		fill: var(--g7-line);
	}
	[data-sternlab] .st-nw {
		white-space: nowrap;
	}
	[data-sternlab] .st-strip {
		fill: var(--g7-steel);
	}
	[data-sternlab] .st-bin {
		fill: var(--sl-color-gray-1);
	}
	[data-sternlab] .st-mean {
		stroke: var(--g7-gold);
		stroke-width: 2.5;
	}
</style>

<script>
	import { loop, fmt, fmtInt } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const CX = 150;
	const CY = 124;
	const RO = 104;
	const RI = 13;
	const SX0 = 24;
	const SK = 40;
	const R = 0.08;
	const r = 0.01;
	const SLOW = 9000;
	const BIN = 0.1; // мм
	const NB = 65;

	for (const fig of document.querySelectorAll<HTMLElement>('[data-sternlab]')) {
		const rot = fig.querySelector<SVGGElement>('[data-rot]')!;
		const head = fig.querySelector<SVGPathElement>('[data-head]')!;
		const atomsG = fig.querySelector<SVGGElement>('[data-atoms]')!;
		const depG = fig.querySelector<SVGGElement>('[data-dep]')!;
		const binsG = fig.querySelector<SVGGElement>('[data-bins]')!;
		const meanP = fig.querySelector<SVGPathElement>('[data-mean]')!;
		const inN = fig.querySelector<HTMLInputElement>('[data-n]')!;
		const inT = fig.querySelector<HTMLInputElement>('[data-t]')!;
		const outN = fig.querySelector('[data-out-n]')!;
		const outT = fig.querySelector('[data-out-t]')!;
		const sOut = fig.querySelector('[data-s]')!;
		const v1 = fig.querySelector('[data-v1]')!;
		const v2 = fig.querySelector('[data-v2]')!;
		const bins = Array.from({ length: NB }, (_, i) => {
			const e = document.createElementNS(NS, 'rect');
			e.setAttribute('class', 'st-bin');
			e.setAttribute('x', (SX0 + i * BIN * SK).toFixed(1));
			e.setAttribute('y', '262');
			e.setAttribute('width', (BIN * SK + 0.3).toFixed(1));
			e.setAttribute('height', '16');
			e.setAttribute('opacity', '0');
			binsG.append(e);
			return e;
		});
		let counts = new Array(NB).fill(0);
		let sum = 0;
		let total = 0;
		let phi = 0; // the angle of the device, rad (on the screen)
		let flying: { e: SVGCircleElement; ang: number; rad: number; v: number }[] = [];
		let emit = 0;
		const omega = () => 2 * Math.PI * Number(inN.value);
		const aSpeed = () => Math.sqrt((8.31 * (Number(inT.value) + 273)) / 0.108);
		const sample = () => aSpeed() * Math.sqrt(-2 * Math.log(Math.random() * Math.random() || 1e-12));
		const reset = () => {
			counts = new Array(NB).fill(0);
			sum = 0;
			total = 0;
			depG.replaceChildren();
			for (const f of flying) f.e.remove();
			flying = [];
			outN.textContent = `${inN.value}\u00a0об/с`;
			outT.textContent = `${inT.value}\u00a0°C`;
			v2.textContent = `${fmtInt(Math.sqrt(3) * aSpeed())}\u00a0м/с`;
		};
		inN.addEventListener('input', reset);
		inT.addEventListener('input', reset);
		reset();
		const land = (v: number) => {
			const s = (omega() * R * (R - r)) / v * 1000; // мм
			const i = Math.floor(s / BIN);
			if (i < NB) counts[i]++;
			sum += s;
			total++;
		};
		loop(fig, (dt) => {
			const w = omega() / SLOW; // rad per second on the screen
			phi += w * dt;
			const deg = (-phi * 180) / Math.PI; // counterclockwise on the screen
			rot.setAttribute('transform', `rotate(${deg.toFixed(3)} ${CX} ${CY})`);
			head.style.display = Number(inN.value) > 0 ? '' : 'none';
			rot.querySelector<SVGPathElement>('.st-arrow')!.style.display = Number(inN.value) > 0 ? '' : 'none';
			// new atoms leave through the slit, which points up in the device's frame
			emit += dt;
			while (emit > 0.07) {
				emit -= 0.07;
				const e = document.createElementNS(NS, 'circle');
				e.setAttribute('r', '1.8');
				e.setAttribute('class', 'st-atom');
				atomsG.append(e);
				flying.push({ e, ang: -Math.PI / 2 - phi, rad: RI, v: sample() });
				// many more atoms land unseen and fill the strip
				for (let k = 0; k < 12; k++) land(sample());
			}
			const pxPerM = RO / R;
			for (let i = flying.length - 1; i >= 0; i--) {
				const f = flying[i];
				f.rad += (f.v * pxPerM * dt) / SLOW;
				if (f.rad >= RO - 3) {
					land(f.v);
					// a speck of silver on the outer cylinder, in the device's frame
					const local = f.ang + phi; // the angle relative to the device
					const d = document.createElementNS(NS, 'circle');
					d.setAttribute('class', 'st-dep');
					d.setAttribute('r', '1.6');
					d.setAttribute('cx', (CX + (RO - 4) * Math.cos(local)).toFixed(2));
					d.setAttribute('cy', (CY + (RO - 4) * Math.sin(local)).toFixed(2));
					depG.append(d);
					if (depG.childElementCount > 60) depG.firstElementChild!.remove();
					f.e.remove();
					flying.splice(i, 1);
					continue;
				}
				f.e.setAttribute('cx', (CX + f.rad * Math.cos(f.ang)).toFixed(1));
				f.e.setAttribute('cy', (CY + f.rad * Math.sin(f.ang)).toFixed(1));
			}
			const top = Math.max(1, ...counts);
			counts.forEach((c, i) => bins[i].setAttribute('opacity', (0.9 * Math.min(1, c / top)).toFixed(2)));
			if (total > 50) {
				const sm = sum / total;
				const x = SX0 + Math.min(6.5, sm) * SK;
				meanP.setAttribute('d', `M${x.toFixed(1)} 258 V282`);
				sOut.textContent = `${fmt(sm, 1)}\u00a0мм`;
				v1.textContent = sm > 0.05 ? `${fmtInt((omega() * R * (R - r)) / (sm / 1000))}\u00a0м/с` : 'не видно';
			}
			return true;
		});
	}
</script>
