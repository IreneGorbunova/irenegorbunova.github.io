---
/**
 * Three panels for the three statements of the molecular-kinetic theory (the section «Основные положения МКТ»).
 * 1. A drop of water and a magnified part of it: water molecules (one oxygen, two hydrogens; the bond angle 104,5°)
 *    lie close together and tremble. Not to scale: the drop is millimetres, the molecules 3·10⁻¹⁰ м.
 * 2. Gas in a box: 26 hard disks collide elastically with each other and with the walls; one of them is gold and
 *    leaves a trail, so its zigzag path after every collision is seen. Speeds are slowed down about 10⁷ times.
 * 3. Two molecules oscillate about the distance r₀ where attraction and repulsion balance. Farther than r₀ they
 *    attract (arrows towards each other), closer they repel (arrows apart); the force is drawn steeper on the
 *    repulsive side, as for real molecules. The motion is that of a particle in such a well, slowed down.
 */
import G7Styles from '../g7/G7Styles.astro';

const mols = [] as { x: number; y: number; a: number }[];
for (let r = 0; r < 5; r++)
	for (let c = 0; c < 5; c++) {
		const x = 118 + c * 19 + (r % 2) * 9.5;
		const y = 62 + r * 18;
		if (Math.hypot(x - 156, y - 98) < 50) mols.push({ x, y, a: (r * 47 + c * 83) % 360 });
	}
---

<G7Styles />
<figure class="g7 g7--pic not-content" data-mktpic>
	<div class="g7__grid is-three">
		<svg class="g7__svg" viewBox="0 0 220 170" role="img" aria-label="Капля воды и её увеличенная часть: молекулы воды лежат вплотную и дрожат">
			<text class="t-title" x="10" y="20">Вещество — из частиц</text>
			<path class="mp-drop" d="M40 70 Q52 92 52 104 A12 12 0 0 1 28 104 Q28 92 40 70 Z"></path>
			<path class="mp-zoom" d="M52 98 L108 64 M52 108 L110 134"></path>
			<circle class="mp-lens" cx="156" cy="98" r="52"></circle>
			<g data-water>
				{
					mols.map((m) => (
						<g transform={`translate(${m.x} ${m.y}) rotate(${m.a})`}>
							<circle class="mp-h" cx="-5.3" cy="4" r="3.3" />
							<circle class="mp-h" cx="5.3" cy="4" r="3.3" />
							<circle class="mp-o" r="5.6" />
						</g>
					))
				}
			</g>
			<text class="t-small" x="18" y="160">капля воды</text>
			<text class="t-small" x="128" y="164">молекулы H₂O</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 220 170" role="img" aria-label="Молекулы газа в сосуде летают и сталкиваются; путь одной из них — ломаная линия">
			<text class="t-title" x="10" y="20">Частицы движутся</text>
			<rect class="mp-box" x="10" y="30" width="200" height="130" rx="4"></rect>
			<path class="mp-trail" data-trail></path>
			<g data-gas></g>
		</svg>
		<svg class="g7__svg" viewBox="0 0 220 170" role="img" aria-label="Две молекулы колеблются: на большом расстоянии притягиваются, на малом отталкиваются">
			<text class="t-title" x="10" y="20">Частицы взаимодействуют</text>
			<line class="ln-dash" x1="110" y1="44" x2="110" y2="128"></line>
			<line class="ln-dash" x1="148" y1="44" x2="148" y2="128"></line>
			<text class="t-small" x="129" y="140" text-anchor="middle"><tspan class="t-i">r</tspan>₀</text>
			<circle class="mp-m" data-a cx="110" cy="86" r="15"></circle>
			<circle class="mp-m" data-b cx="148" cy="86" r="15"></circle>
			<path class="arrow arrow--blue" data-fa></path>
			<path class="arrow arrow--blue" data-fb></path>
			<path class="head--blue" data-ha></path>
			<path class="head--blue" data-hb></path>
			<text class="t-small" x="110" y="160" text-anchor="middle" data-lab></text>
		</svg>
	</div>
	<figcaption class="g7__caption">Три положения молекулярно-кинетической теории. Размеры молекул сильно увеличены, их движение замедлено в миллионы раз.</figcaption>
</figure>

<style is:global>
	[data-mktpic] .mp-drop {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 1.2;
	}
	[data-mktpic] .mp-zoom {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
	}
	[data-mktpic] .mp-lens {
		fill: var(--g7-water);
		stroke: var(--g7-line);
		stroke-width: 1.6;
	}
	[data-mktpic] .mp-o {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 0.6;
	}
	[data-mktpic] .mp-h {
		fill: var(--sl-color-gray-1);
		stroke: var(--g7-paper);
		stroke-width: 0.6;
	}
	[data-mktpic] .mp-box {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.6;
	}
	[data-mktpic] .mp-dot {
		fill: var(--g7-blue);
	}
	[data-mktpic] .mp-dot--gold {
		fill: var(--g7-gold);
	}
	[data-mktpic] .mp-trail {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.2;
		opacity: 0.7;
	}
	[data-mktpic] .mp-m {
		fill: color-mix(in oklab, var(--g7-blue) 35%, var(--g7-paper));
		stroke: var(--g7-blue);
		stroke-width: 1.4;
	}
</style>

<script>
	import { loop, rng } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	for (const fig of document.querySelectorAll<HTMLElement>('[data-mktpic]')) {
		const rand = rng(7);
		// panel 1: the molecules tremble about their places
		const water = [...fig.querySelectorAll<SVGGElement>('[data-water] > g')].map((g) => ({ g, base: g.getAttribute('transform')!, ph: rand() * 6.28, f: 5 + rand() * 4 }));
		// panel 2: hard disks in a box
		const gasG = fig.querySelector<SVGGElement>('[data-gas]')!;
		const trail = fig.querySelector<SVGPathElement>('[data-trail]')!;
		const N = 26;
		const R = 4;
		const P = Array.from({ length: N }, (_, i) => {
			const a = rand() * 6.28;
			const e = document.createElementNS(NS, 'circle');
			e.setAttribute('r', String(R));
			e.setAttribute('class', i === 0 ? 'mp-dot mp-dot--gold' : 'mp-dot');
			gasG.append(e);
			return { x: 20 + (i % 7) * 27, y: 42 + Math.floor(i / 7) * 30, vx: 45 * Math.cos(a), vy: 45 * Math.sin(a), e };
		});
		const path: string[] = [];
		// panel 3: two molecules in a well
		const A = fig.querySelector<SVGCircleElement>('[data-a]')!;
		const B = fig.querySelector<SVGCircleElement>('[data-b]')!;
		const fa = fig.querySelector<SVGPathElement>('[data-fa]')!;
		const fb = fig.querySelector<SVGPathElement>('[data-fb]')!;
		const ha = fig.querySelector<SVGPathElement>('[data-ha]')!;
		const hb = fig.querySelector<SVGPathElement>('[data-hb]')!;
		const lab = fig.querySelector<SVGTextElement>('[data-lab]')!;
		const R0 = 38;
		let d = 52;
		let vd = 0;
		// force along the line (positive = repulsion): steep when closer than r0, gentle when farther
		const force = (x: number) => (x < R0 ? 9 * (R0 - x) : -2.2 * (x - R0));
		let t = 0;
		loop(fig, (dt) => {
			t += dt;
			for (const w of water) w.g.setAttribute('transform', `${w.base} translate(${(0.8 * Math.sin(t * w.f + w.ph)).toFixed(2)} ${(0.8 * Math.cos(t * w.f * 1.3 + w.ph)).toFixed(2)})`);
			// gas: small steps, wall bounces, elastic collisions of equal disks
			const n = 3;
			for (let s = 0; s < n; s++) {
				const h = dt / n;
				for (const p of P) {
					p.x += p.vx * h;
					p.y += p.vy * h;
					if (p.x < 10 + R) (p.x = 10 + R), (p.vx = Math.abs(p.vx));
					if (p.x > 210 - R) (p.x = 210 - R), (p.vx = -Math.abs(p.vx));
					if (p.y < 30 + R) (p.y = 30 + R), (p.vy = Math.abs(p.vy));
					if (p.y > 160 - R) (p.y = 160 - R), (p.vy = -Math.abs(p.vy));
				}
				for (let i = 0; i < N; i++)
					for (let j = i + 1; j < N; j++) {
						const a = P[i];
						const b = P[j];
						const dx = b.x - a.x;
						const dy = b.y - a.y;
						const r = Math.hypot(dx, dy);
						if (r < 2 * R && r > 0) {
							const nx = dx / r;
							const ny = dy / r;
							const rel = (a.vx - b.vx) * nx + (a.vy - b.vy) * ny;
							if (rel > 0) {
								a.vx -= rel * nx;
								a.vy -= rel * ny;
								b.vx += rel * nx;
								b.vy += rel * ny;
							}
						}
					}
			}
			for (const p of P) {
				p.e.setAttribute('cx', p.x.toFixed(1));
				p.e.setAttribute('cy', p.y.toFixed(1));
			}
			path.push(`${P[0].x.toFixed(1)} ${P[0].y.toFixed(1)}`);
			if (path.length > 160) path.shift();
			trail.setAttribute('d', `M${path.join(' L')}`);
			// the pair: both move symmetrically about x = 129
			const h = Math.min(dt, 1 / 30) / 4;
			for (let s = 0; s < 4; s++) {
				vd += force(d) * h * 6;
				d += vd * h * 6;
			}
			const xa = 129 - d / 2;
			const xb = 129 + d / 2;
			A.setAttribute('cx', xa.toFixed(1));
			B.setAttribute('cx', xb.toFixed(1));
			const f = force(d);
			const len = Math.min(40, Math.abs(f) * 1.2);
			const sgn = f > 0 ? -1 : 1; // the arrow on A points left when repelled
			const y = 86;
			if (len > 3) {
				const a0 = xa + sgn * 0;
				const b0 = xb;
				fa.setAttribute('d', `M${a0.toFixed(1)} ${y} h${(sgn * len).toFixed(1)}`);
				fb.setAttribute('d', `M${b0.toFixed(1)} ${y} h${(-sgn * len).toFixed(1)}`);
				const tipA = a0 + sgn * (len + 6);
				const tipB = b0 - sgn * (len + 6);
				ha.setAttribute('d', `M${tipA.toFixed(1)} ${y} l${(-sgn * 7).toFixed(1)} -4 v8 Z`);
				hb.setAttribute('d', `M${tipB.toFixed(1)} ${y} l${(sgn * 7).toFixed(1)} -4 v8 Z`);
				lab.textContent = f > 0 ? 'отталкиваются' : 'притягиваются';
			} else {
				fa.setAttribute('d', '');
				fb.setAttribute('d', '');
				ha.setAttribute('d', '');
				hb.setAttribute('d', '');
				lab.textContent = '';
			}
			return true;
		});
	}
</script>
