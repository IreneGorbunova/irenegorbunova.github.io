---
/**
 * Small pictures to «Где это встречается» (static, not to scale), four panels: two in a row on a wide screen, one on a
 * phone; each has a one-line label under it.
 * Everest: a climber (people kit, 175 см) with an oxygen mask on the summit ridge; two windows with the same area show
 *   the molecules of the air at sea level (101 кПа, 15 °C: n = p/(kT) = 2,55·10²⁵ м⁻³) and on the summit (about
 *   34 кПа, −20 °C: 9,7·10²⁴ м⁻³), 2,6 times fewer: 26 and 10 dots (positions from a fixed seed).
 * Balloons: a helium balloon and an air balloon tied to a chair, in the evening and next morning. Helium atoms are
 *   29/4 ≈ 7 times lighter than the mean molecule of air and fly √7,25 ≈ 2,7 times faster; small and fast, they leak
 *   through the rubber much sooner, so by the morning the helium balloon has shrunk (drawn at 0,7 of its diameter) and
 *   sinks, while the air balloon is still round.
 * Liquid nitrogen: a Dewar flask in a cut-away (double walls with the vacuum gap, the liquid inside, a loose cap lifted
 *   a little); white mist (droplets of water from the cooled air) creeps out of the neck and down. Beside it 1 л of the
 *   liquid and the gas it gives at 20 °C and 101 кПа: 0,808 кг = 28,9 моль, V = νRT/p = 0,69 м³, almost 700 л; drawn as
 *   two squares with edges 4 and 4·∛700 ≈ 35,5 px, so the molecules of the gas are about 9 times farther apart.
 * Lamps: two LED bulbs, warm and cold white, with their boxes marked «2700 К» and «6500 К»: the color temperature, the
 *   temperature of a hot body that glows with the same color, is written in kelvins.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// fixed pseudo-random dots in a window
const seeded = (seed: number) => () => {
	seed = (seed * 16807) % 2147483647;
	return (seed - 1) / 2147483646;
};
const dots = (n: number, x0: number, y0: number, w: number, h: number, seed: number) => {
	const r = seeded(seed);
	const out: { x: number; y: number }[] = [];
	let tries = 0;
	while (out.length < n && tries++ < 5000) {
		const p = { x: x0 + 5 + r() * (w - 10), y: y0 + 5 + r() * (h - 10) };
		if (out.every((q) => Math.hypot(q.x - p.x, q.y - p.y) > 9)) out.push(p);
	}
	return out;
};
const WIN = { x: 150, w: 80, h: 42 };
const sea = dots(26, WIN.x, 26, WIN.w, WIN.h, 7);
const top = dots(10, WIN.x, 108, WIN.w, WIN.h, 29);
const balloon = (cx: number, cy: number, r: number) => `M${cx} ${cy + r - 0.5}l-2.6 3.6h5.2Z`; // the knot
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--pic not-content" data-mktuses>
	<div class="mu-grid">
		<div class="mu-cell">
			<svg class="g7__svg" viewBox="0 0 240 170" role="img" aria-label="Альпинист в кислородной маске на вершине Эвереста. Два окошка одинаковой площади: в воздухе у моря 26 молекул, на вершине 10">
				<rect class="mu-sky" x="0" y="0" width="240" height="170"></rect>
				<path class="mu-far" d="M0 128 L30 96 L52 112 L84 70 L112 104 L140 84 L170 120 L240 100 V170 H0 Z"></path>
				<path class="mu-rock" d="M0 170 L0 150 L40 140 L76 124 L96 122 L130 140 L150 170 Z"></path>
				<path class="mu-snow" d="M40 140 L76 124 L96 122 L104 127 L84 128 L60 136 Z"></path>
				<g data-climber></g>
				<rect class="mu-win" x={WIN.x} y="26" width={WIN.w} height={WIN.h} rx="4"></rect>
				{sea.map((p) => <circle class="mu-dot" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.6" />)}
				<rect class="mu-win" x={WIN.x} y="108" width={WIN.w} height={WIN.h} rx="4"></rect>
				{top.map((p) => <circle class="mu-dot" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.6" />)}
				<text class="mu-lab mu-halo" x={WIN.x + WIN.w / 2} y="19" text-anchor="middle">у моря</text>
				<text class="mu-lab mu-halo" x={WIN.x + WIN.w / 2} y="101" text-anchor="middle">на вершине</text>
				<text class="mu-small mu-halo" x={WIN.x + WIN.w / 2} y="82" text-anchor="middle">101&nbsp;кПа, 15&nbsp;°C</text>
				<text class="mu-small mu-halo" x={WIN.x + WIN.w / 2} y="164" text-anchor="middle">34&nbsp;кПа, −20&nbsp;°C</text>
			</svg>
			<p class="mu-cap">На вершине Эвереста</p>
		</div>
		<div class="mu-cell">
			<svg class="g7__svg" viewBox="0 0 240 170" role="img" aria-label="Два воздушных шарика привязаны к стулу. Вечером оба круглые, шарик с гелием держится вверху. Утром шарик с гелием сморщился и опустился, а шарик с воздухом остался круглым">
				<rect class="mu-wall" x="0" y="0" width="240" height="170"></rect>
				<rect class="mu-floor" x="0" y="150" width="240" height="20"></rect>
				<path class="mu-divider" d="M120 10V160"></path>
				<text class="mu-lab" x="60" y="18" text-anchor="middle">вечером</text>
				<text class="mu-lab" x="180" y="18" text-anchor="middle">утром</text>
				{
					[0, 120].map((ox) => (
						<g transform={`translate(${ox} 0)`}>
							<path class="mu-chair" d="M22 150 V100 M22 112 H62 V150 M58 112 V150 M26 112 V150 M22 100 V58 M22 62 h6 v40" />
							<rect class="mu-seat" x="20" y="108" width="44" height="6" rx="2" />
						</g>
					))
				}
				<!-- evening: helium up on its string, air resting on the floor -->
				<path class="mu-string" d="M24 64 Q34 66 44 58"></path>
				<circle class="mu-he" cx="44" cy="42" r="13"></circle>
				<path class="mu-he" d={balloon(44, 42, 13)}></path>
				<path class="mu-string" d="M60 110 Q72 124 84 132"></path>
				<circle class="mu-air" cx="88" cy="136" r="13"></circle>
				<text class="mu-small mu-halo" x="62" y="46">гелий</text>
				<text class="mu-small mu-halo" x="76" y="114">воздух</text>
				<!-- morning: the helium balloon smaller and down -->
				<path class="mu-string" d="M144 64 Q150 84 156 100 Q160 112 166 118"></path>
				<circle class="mu-he mu-he--old" cx="170" cy="126" r="9"></circle>
				<path class="mu-wrinkle" d="M164 122 q3 2 6 0 M167 130 q3 -2 6 0"></path>
				<path class="mu-string" d="M180 110 Q192 124 204 132"></path>
				<circle class="mu-air" cx="208" cy="136" r="13"></circle>
			</svg>
			<p class="mu-cap">Шарик с гелием сдувается быстрее</p>
		</div>
		<div class="mu-cell">
			<svg class="g7__svg" viewBox="0 0 240 170" role="img" aria-label="Сосуд Дьюара с двойными стенками, внутри жидкий азот, из горлышка выползает белый туман. Справа: кубик объёмом 1 литр жидкости и кубик объёмом 700 литров газа, в который она превращается; ребро большого кубика в 9 раз больше">
				<rect class="mu-wall" x="0" y="0" width="240" height="170"></rect>
				<rect class="mu-table" x="0" y="140" width="240" height="30"></rect>
				<!-- the Dewar flask in a cut-away: outer and inner walls, the vacuum gap between them, the liquid inside -->
				<path class="mu-dewar" d="M22 58 Q22 44 36 44 H50 V30 H64 V44 H78 Q92 44 92 58 V132 Q92 140 84 140 H30 Q22 140 22 132 Z"></path>
				<path class="mu-dewar-gap" d="M28 60 Q28 50 38 50 H54 V36 H60 V50 H76 Q86 50 86 60 V128 Q86 134 80 134 H34 Q28 134 28 128 Z"></path>
				<path class="mu-dewar-in" d="M32 62 Q32 54 40 54 H55.5 V36 H58.5 V54 H74 Q82 54 82 62 V126 Q82 130 78 130 H36 Q32 130 32 126 Z"></path>
				<path class="mu-ln2-fill" d="M33 84 H81 V126 Q81 129 78 129 H36 Q33 129 33 126 Z"></path>
				<!-- a loose cap, lifted a little: the gas must get out -->
				<rect class="mu-dewar-neck" x="46" y="22" width="22" height="6" rx="2" transform="rotate(-8 57 25)"></rect>
				<g class="mu-mist" data-mist>
					<ellipse cx="64" cy="30" rx="7" ry="4"></ellipse>
					<ellipse cx="72" cy="36" rx="9" ry="4.5"></ellipse>
					<ellipse cx="84" cy="46" rx="10" ry="5"></ellipse>
					<ellipse cx="94" cy="62" rx="9" ry="5"></ellipse>
					<ellipse cx="98" cy="84" rx="9" ry="5"></ellipse>
					<ellipse cx="100" cy="110" rx="12" ry="5"></ellipse>
					<ellipse cx="108" cy="134" rx="16" ry="5"></ellipse>
				</g>
				<!-- 1 л of the liquid and the 700 л of gas it gives at 20 °C: cubes with edges 4 and 4·∛700 ≈ 35,5 px -->
				<text class="mu-lab" x="232" y="34" text-anchor="end">1&nbsp;л жидкости</text>
				<text class="mu-lab" x="232" y="50" text-anchor="end">→ почти 700&nbsp;л газа</text>
				<rect class="mu-cube" x="132" y="104" width="4" height="4"></rect>
				<path class="mu-arrow" d="M142 106 H160 M155 102.5 L160 106 L155 109.5"></path>
				<rect class="mu-cube mu-cube--gas" x="168" y="72.5" width="35.5" height="35.5"></rect>
				<text class="mu-small" x="134" y="124" text-anchor="middle">1&nbsp;л</text>
				<text class="mu-small" x="185.75" y="124" text-anchor="middle">700&nbsp;л</text>
			</svg>
			<p class="mu-cap">Жидкий азот</p>
		</div>
		<div class="mu-cell">
			<svg class="g7__svg" viewBox="0 0 240 170" role="img" aria-label="Две светодиодные лампы: тёплого света и холодного белого света, на их коробках написано 2700 К и 6500 К">
				<rect class="mu-wall" x="0" y="0" width="240" height="170"></rect>
				<rect class="mu-table" x="0" y="146" width="240" height="24"></rect>
				<defs>
					<radialGradient id="mu-warm-glow"><stop offset="0" stop-color="hsl(36, 100%, 70%)" stop-opacity="0.75"></stop><stop offset="1" stop-color="hsl(36, 100%, 70%)" stop-opacity="0"></stop></radialGradient>
					<radialGradient id="mu-cold-glow"><stop offset="0" stop-color="hsl(205, 90%, 88%)" stop-opacity="0.75"></stop><stop offset="1" stop-color="hsl(205, 90%, 88%)" stop-opacity="0"></stop></radialGradient>
				</defs>
				{
					[
						{ x: 64, glow: 'url(#mu-warm-glow)', bulb: 'mu-bulb--warm', t: '2700 К' },
						{ x: 176, glow: 'url(#mu-cold-glow)', bulb: 'mu-bulb--cold', t: '6500 К' },
					].map((b) => (
						<g>
							<path class="mu-cord" d={`M${b.x} 0V16`} />
							<circle cx={b.x} cy="44" r="40" fill={b.glow} />
							<rect class="mu-base" x={b.x - 7} y="16" width="14" height="14" rx="2" />
							<path class={`mu-bulb ${b.bulb}`} d={`M${b.x - 7} 30 C${b.x - 7} 36 ${b.x - 18} 40 ${b.x - 18} 52 A18 18 0 0 0 ${b.x + 18} 52 C${b.x + 18} 40 ${b.x + 7} 36 ${b.x + 7} 30 Z`} />
							<rect class="mu-box" x={b.x - 30} y="102" width="60" height="44" rx="3" />
							<path class={`mu-box-band ${b.bulb}`} d={`M${b.x - 30} 112h60`} />
							<text class="mu-boxtext" x={b.x} y="136" text-anchor="middle">{b.t}</text>
						</g>
					))
				}
			</svg>
			<p class="mu-cap">Лампы «2700&nbsp;К» и «6500&nbsp;К»</p>
		</div>
	</div>
</figure>

<style>
	.mu-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem 0.75rem;
	}
	@container (max-width: 520px) {
		.mu-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.mu-cap {
		margin: 0.35rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.g7__svg .mu-lab {
		font-size: 12px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.g7__svg .mu-small {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .mu-halo {
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 3.5px;
		stroke-linejoin: round;
	}
	.g7__svg .mu-boxtext {
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--sl-color-gray-1);
	}
	.mu-sky {
		fill: color-mix(in oklab, var(--ig-vx) 16%, var(--sl-color-bg));
	}
	.mu-far {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-5));
	}
	.mu-rock {
		fill: var(--sl-color-gray-4);
	}
	.mu-snow {
		fill: var(--sl-color-gray-1);
	}
	.mu-win {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.mu-dot {
		fill: var(--ig-vx);
	}
	.mu-wall {
		fill: color-mix(in oklab, var(--ig-v) 6%, var(--sl-color-bg));
	}
	.mu-floor,
	.mu-table {
		fill: var(--g7-wood-dark);
	}
	.mu-divider {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.mu-chair {
		fill: none;
		stroke: var(--g7-wood);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.mu-seat {
		fill: var(--g7-wood);
	}
	.mu-string {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.9;
	}
	.mu-he {
		fill: hsl(330, 70%, 62%);
	}
	.mu-he--old {
		fill: hsl(330, 45%, 52%);
	}
	.mu-air {
		fill: hsl(150, 50%, 50%);
	}
	.mu-wrinkle {
		fill: none;
		stroke: hsl(330, 40%, 35%);
		stroke-width: 0.8;
	}
	.mu-dewar {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.mu-dewar-gap {
		fill: var(--g7-steel-dark);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.mu-dewar-in {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.mu-cube {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.mu-cube--gas {
		fill: color-mix(in oklab, var(--ig-vx) 12%, transparent);
		stroke-dasharray: 3 2;
	}
	.mu-arrow {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mu-dewar-neck {
		fill: var(--g7-steel-dark);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.mu-ln2-fill {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-5));
	}
	.mu-mist ellipse {
		fill: var(--sl-color-white);
		fill-opacity: 0.32;
	}
	:global(:root[data-theme='light']) .mu-mist ellipse {
		fill: var(--sl-color-gray-4);
		fill-opacity: 0.4;
	}
	.mu-cord {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.mu-base {
		fill: var(--sl-color-gray-3);
	}
	.mu-bulb--warm {
		fill: hsl(40, 100%, 78%);
		stroke: hsl(36, 90%, 55%);
	}
	.mu-bulb--cold {
		fill: hsl(205, 70%, 96%);
		stroke: hsl(205, 60%, 70%);
	}
	.mu-bulb {
		stroke-width: 1;
	}
	.mu-box {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mu-box-band {
		stroke-width: 4;
		fill: none;
	}
	.mu-box-band.mu-bulb--warm {
		stroke: hsl(36, 90%, 55%);
	}
	.mu-box-band.mu-bulb--cold {
		stroke: hsl(205, 60%, 62%);
	}
	:global(.mu-mask) {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
	}
	:global(.mu-tube) {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	:global(.mu-pack) {
		fill: hsl(15, 70%, 50%);
	}
	:global(.mu-axe) {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
</style>

<script>
	import { figure } from '@components/people';
	import { loop } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-mktuses]')) {
		// the climber: 175 см at 0,5 px per см, facing right, on the ridge; the near hand (a mitten) holds an ice axe planted in the snow
		{
			const s = 0.5;
			const H = 175;
			const u = s * H;
			const G = 124; // the ridge under the feet
			const hipX = 84;
			const g = root.querySelector<SVGGElement>('[data-climber]')!;
			const back = mk(g, 'g', {});
			const person = mk(g, 'g', {}) as SVGGElement;
			const front = mk(g, 'g', {});
			const axeTop = { x: hipX + 15, y: G - 0.5 * u };
			const st = figure(person, { s, H, clothes: 'winter', shirt: 'hm-red', gear: 'boot', name: 'climber' }).pose({
				hip: { x: hipX, y: G - 0.52 * u - 1 },
				lean: 0.05,
				head: -0.15,
				ankles: [
					{ x: hipX + 4, y: G - 4 },
					{ x: hipX - 5, y: G - 2.5 },
				],
				feet: [0, 0],
				planted: [true, true],
				hands: [
					{ at: axeTop, pose: 'grip', d: 3, dir: 0, roll: -Math.PI / 2, contact: 'ice-axe' },
					{ at: { x: hipX - 3, y: G - 0.45 * u }, pose: 'relaxed' },
				],
			});
			// the ice axe from its head just above the near hand down to the snow, behind the hand that wraps it
			const ax = st.grips[0].x; // the shaft passes through the middle of the grip
			mk(back, 'path', { class: 'mu-axe', d: `M${ax.toFixed(1)} ${(axeTop.y - 5).toFixed(1)}V${G + 1} M${(ax - 5).toFixed(1)} ${(axeTop.y - 5).toFixed(1)}h9` });
			// the backpack with the oxygen bottle behind, the mask on the face and the tube between them
			const sh = st.shoulders[0];
			mk(back, 'rect', { class: 'mu-pack', x: (sh.x - 13).toFixed(1), y: (sh.y - 2).toFixed(1), width: 9, height: 22, rx: 2 });
			const face = { x: sh.x + 0.045 * u, y: sh.y - 0.11 * u };
			mk(front, 'path', { class: 'mu-tube', d: `M${(sh.x - 6).toFixed(1)} ${(sh.y + 2).toFixed(1)} Q${(sh.x - 2).toFixed(1)} ${(sh.y + 10).toFixed(1)} ${(face.x + 1).toFixed(1)} ${(face.y + 4).toFixed(1)}` });
			mk(front, 'ellipse', { class: 'mu-mask', cx: (face.x + 0.8).toFixed(1), cy: (face.y + 1.5).toFixed(1), rx: 2.6, ry: 3.2 });
		}
		// the mist out of the neck creeps slowly down the flask
		{
			const mist = [...root.querySelectorAll<SVGEllipseElement>('[data-mist] ellipse')];
			const base = mist.map((e) => ({ x: +e.getAttribute('cx')!, y: +e.getAttribute('cy')! }));
			let t = 0;
			loop(root, (dt) => {
				t += dt;
				mist.forEach((e, i) => {
					const ph = (t * 0.25 + i * 0.21) % 1;
					e.setAttribute('cx', (base[i].x + 8 * ph).toFixed(1));
					e.setAttribute('cy', (base[i].y + 4 * ph).toFixed(1));
					e.setAttribute('opacity', (Math.sin(Math.PI * ph) * 0.9).toFixed(2));
				});
				return true;
			});
		}
	}
</script>
