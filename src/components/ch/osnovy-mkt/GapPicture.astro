---
/**
 * «Вода и пар при 100 °C» (section «Давление газа. Основное уравнение МКТ»): two panels drawn to ONE scale, 32 px per нм,
 * the same in both (both panels have the same viewBox width, 300, so they keep one scale on a wide screen, side by side,
 * and on a phone, one under the other).
 *   Water at 100 °C: ρ = 958 кг/м³, n = ρN_А/M = 958 · 6,02·10²³ / 0,018 = 3,2·10²⁸ м⁻³, the spacing n^(−1/3) = 0,31 нм
 *   (9,9 px). A cube with the edge 3,7 нм seen in oblique projection; its front layer holds 12 × 12 molecules that
 *   tremble about their places (the molecules of a liquid also change places, which is not shown).
 *   Water vapour at 100 °C and 101 кПа: n = p/(kT) = 101 325 / (1,38·10⁻²³ · 373) = 2,0·10²⁵ м⁻³, one molecule per cube
 *   with the edge n^(−1/3) = 3,7 нм (118 px). Four such cubes (2 × 2 × 1) with one molecule each, flying slowly inside
 *   its cube in 3D (projected the same oblique way). In the real vapour each molecule flies through many cubes; one per
 *   cube shows only how many there are.
 * The vapour has 3,2·10²⁸ / 2,0·10²⁵ ≈ 1630 times fewer molecules per м³, so in the water cube there are about 1600 of
 * them and the distances in the vapour are 1630^(1/3) ≈ 12 times larger. A water molecule (O–H 0,096 нм, angle 104,5°,
 * O drawn with radius 0,11 нм, H 0,07 нм) is about 0,3 нм across. The motion is slowed down enormously.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 32; // px per нм
const A = 3.7 * K; // the cube edge, 118,4 px
const OB = 0.38; // oblique depth factor
const DX = A * OB * Math.cos(Math.PI / 4);
const DY = -A * OB * Math.sin(Math.PI / 4);
const cubePath = (x: number, y: number) => {
	// x, y: the lower left corner of the front face
	const f = `M${x} ${y}h${A}v${-A}h${-A}Z`;
	const t = `M${x} ${y - A}l${DX} ${DY}h${A}l${-DX} ${-DY}`;
	const s = `M${x + A} ${y}l${DX} ${DY}v${-A}`;
	return f + t + s;
};
// water panel: the cube in the middle
const WX = (300 - A - DX) / 2;
const WY = 206;
const SP = 0.31 * K; // 9,9 px
const water = [] as { x: number; y: number; a: number }[];
for (let r = 0; r < 12; r++)
	for (let c = 0; c < 12; c++) water.push({ x: WX + (c + 0.5) * SP + (A - 12 * SP) / 2, y: WY - A + (r + 0.5) * SP + (A - 12 * SP) / 2, a: (r * 71 + c * 137) % 360 });
// vapour panel: 2 × 2 front cubes
const VX = (300 - 2 * A - DX) / 2 + 2;
const VY = 296;
const cubes = [
	[VX, VY - A],
	[VX + A, VY - A],
	[VX, VY],
	[VX + A, VY],
];
const ro = 0.11 * K;
const rh = 0.07 * K;
const oh = 0.096 * K;
const hx = oh * Math.sin((104.5 / 2) * (Math.PI / 180));
const hy = oh * Math.cos((104.5 / 2) * (Math.PI / 180));
---

<G7Styles />
<figure class="g7 g7--pic not-content" data-gappic>
	<div class="gp-grid">
		<svg class="g7__svg" viewBox="0 0 300 300" role="img" aria-label="Вода при 100 градусах: молекулы лежат вплотную, расстояние между ними около 0,3 нанометра; в кубике с ребром 3,7 нанометра их около 1600">
			<text class="gp-title" x="150" y="22" text-anchor="middle">вода, 100&nbsp;°C</text>
			<path class="gp-cube-back" d={`M${WX} ${WY - A}l${DX} ${DY}h${A}v${A}l${-DX} ${-DY}Z`}></path>
			<rect class="gp-liquid" x={WX} y={WY - A} width={A} height={A}></rect>
			<g data-water>
				{
					water.map((m) => (
						<g transform={`translate(${m.x.toFixed(1)} ${m.y.toFixed(1)}) rotate(${m.a})`}>
							<circle class="gp-h" cx={-hx} cy={hy} r={rh} />
							<circle class="gp-h" cx={hx} cy={hy} r={rh} />
							<circle class="gp-o" r={ro} />
						</g>
					))
				}
			</g>
			<path class="gp-cube" d={cubePath(WX, WY)}></path>
			<path class="gp-dim" d={`M${WX} ${WY + 10}h${A} M${WX} ${WY + 5}v10 M${WX + A} ${WY + 5}v10`}></path>
			<text class="gp-lab" x={WX + A / 2} y={WY + 27} text-anchor="middle">3,7&nbsp;нм</text>
			<text class="gp-lab" x="150" y="274" text-anchor="middle">в кубике около 1600 молекул,</text>
			<text class="gp-lab" x="150" y="292" text-anchor="middle">соседи в ≈&nbsp;0,3&nbsp;нм друг от друга</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 300 352" role="img" aria-label="Водяной пар при 100 градусах и нормальном давлении: на каждый кубик с ребром 3,7 нанометра приходится одна молекула">
			<text class="gp-title" x="150" y="22" text-anchor="middle">пар, 100&nbsp;°C, 101&nbsp;кПа</text>
			{cubes.map(([x, y]) => <path class="gp-cube gp-cube--thin" d={cubePath(x, y)} />)}
			<g data-vapour></g>
			<path class="gp-dim" d={`M${VX} ${VY + 10}h${A} M${VX} ${VY + 5}v10 M${VX + A} ${VY + 5}v10`}></path>
			<text class="gp-lab" x={VX + A / 2} y={VY + 27} text-anchor="middle">3,7&nbsp;нм</text>
			<text class="gp-lab" x="150" y="344" text-anchor="middle">в каждом кубике одна молекула</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Одно и то же вещество в одном масштабе: 1&nbsp;нм&nbsp;=&nbsp;10⁻⁹&nbsp;м. В паре молекул в 1630&nbsp;раз меньше в каждом кубическом метре, и они примерно в 12&nbsp;раз дальше друг от друга, чем в воде, — почти всё время они летят свободно. Движение сильно замедлено.
	</figcaption>
</figure>

<style>
	.gp-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@container (max-width: 560px) {
		.gp-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.g7__svg .gp-title {
		font-size: 13px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.g7__svg .gp-lab {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.gp-liquid {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-bg));
	}
	.gp-cube-back {
		fill: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-bg));
	}
	.gp-cube {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.gp-cube--thin {
		stroke: var(--sl-color-gray-4);
		stroke-dasharray: 4 3;
	}
	.gp-dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
	}
	:global(.gp-o) {
		fill: hsl(355, 72%, 60%);
		stroke: var(--sl-color-bg);
		stroke-width: 0.5;
	}
	:global(.gp-h) {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.4;
	}
	:global(:root[data-theme='light'] .gp-h) {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const K = 32;
	const A = 3.7 * K;
	const OB = 0.38;
	const DX = A * OB * Math.cos(Math.PI / 4);
	const DY = -A * OB * Math.sin(Math.PI / 4);
	const VX = (300 - 2 * A - DX) / 2 + 2;
	const VY = 296;
	const ro = 0.11 * K;
	const rh = 0.07 * K;
	const oh = 0.096 * K;
	const hx = oh * Math.sin((104.5 / 2) * (Math.PI / 180));
	const hy = oh * Math.cos((104.5 / 2) * (Math.PI / 180));
	const NS = 'http://www.w3.org/2000/svg';
	const mk = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	// lower-left corners of the front faces of the four vapour cubes, back to front for drawing
	const corners = [
		[VX, VY - A],
		[VX + A, VY - A],
		[VX, VY],
		[VX + A, VY],
	];
	const M = ro + 1; // a molecule keeps this far from the walls of its cube (px)

	for (const root of document.querySelectorAll<HTMLElement>('[data-gappic]')) {
		// water: every molecule trembles about its place
		const wg = [...root.querySelectorAll<SVGGElement>('[data-water] > g')];
		const base = wg.map((g) => {
			const m = /translate\(([-\d.]+) ([-\d.]+)\) rotate\(([-\d.]+)\)/.exec(g.getAttribute('transform')!)!;
			return { x: +m[1], y: +m[2], a: +m[3], ph: Math.random() * 6.28, f: 1.6 + Math.random() * 1.4 };
		});
		// vapour: one molecule in each cube, in 3D: u across, v up, w into the picture (0 … A)
		const vg = root.querySelector<SVGGElement>('[data-vapour]')!;
		const mols = corners.map(([x, y]) => {
			const g = mk(vg, 'g', {}) as SVGGElement;
			mk(g, 'circle', { class: 'gp-h', cx: -hx, cy: hy, r: rh });
			mk(g, 'circle', { class: 'gp-h', cx: hx, cy: hy, r: rh });
			mk(g, 'circle', { class: 'gp-o', r: ro });
			const dir = [Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5];
			const L = Math.hypot(...dir);
			const sp = 16; // px/s
			return {
				g,
				x0: x,
				y0: y,
				p: [M + Math.random() * (A - 2 * M), M + Math.random() * (A - 2 * M), M + Math.random() * (A - 2 * M)],
				v: dir.map((d) => (d / L) * sp),
				a: Math.random() * 360,
				spin: (Math.random() - 0.5) * 60,
			};
		});
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			wg.forEach((g, i) => {
				const b = base[i];
				const dx = 0.9 * Math.sin(b.f * t * 2 + b.ph);
				const dy = 0.9 * Math.cos(b.f * t * 1.7 + b.ph * 1.3);
				g.setAttribute('transform', `translate(${(b.x + dx).toFixed(2)} ${(b.y + dy).toFixed(2)}) rotate(${(b.a + 8 * Math.sin(t * b.f + b.ph)).toFixed(1)})`);
			});
			for (const m of mols) {
				for (let k = 0; k < 3; k++) {
					m.p[k] += m.v[k] * dt;
					if (m.p[k] < M) {
						m.p[k] = M;
						m.v[k] = Math.abs(m.v[k]);
					} else if (m.p[k] > A - M) {
						m.p[k] = A - M;
						m.v[k] = -Math.abs(m.v[k]);
					}
				}
				m.a += m.spin * dt;
				// oblique projection: w goes up and to the right
				const sx = m.x0 + m.p[0] + (m.p[2] / A) * DX;
				const sy = m.y0 - m.p[1] + (m.p[2] / A) * DY;
				m.g.setAttribute('transform', `translate(${sx.toFixed(1)} ${sy.toFixed(1)}) rotate(${m.a.toFixed(0)})`);
			}
			return true;
		});
	}
</script>
