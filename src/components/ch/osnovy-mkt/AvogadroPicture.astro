---
/**
 * «Закон Авогадро» (section «Температура и тепловое равновесие», after p = nkT): three equal vessels at the same
 * p = 101 кПа and T = 293 К hold helium He, nitrogen N₂ and argon Ar. By p = nkT each holds the same number of molecules
 * per м³, n = p/(kT) = 101 000 / (1,38·10⁻²³ · 293) = 2,5·10²⁵ м⁻³, and every molecule has the same mean kinetic energy
 * Ē = 3/2 kT = 6,1·10⁻²¹ Дж (the table names them «одинаковы у всех» without values: the tasks ask for n and Ē). So each vessel has the same 12 dots; their speeds are in the true ratio of the mean square
 * speeds υ = √(3RT/M): He (M = 0,004 кг/моль, m₀ = 6,6·10⁻²⁷ кг) 1350 м/с, N₂ (0,028, 4,6·10⁻²⁶ кг) 510 м/с,
 * Ar (0,040, 6,6·10⁻²⁶ кг) 430 м/с. On the screen 510 м/с is 34 px/s: only the ratio of the speeds is true, the motion
 * itself is slowed down enormously; the molecules are drawn huge and few, He small and Ar large, not to scale. Each vessel's speeds are drawn
 * from a two-dimensional Maxwell distribution and scaled so that their mean square is exactly the vessel's υ²; the
 * molecules fly through each other (a rare gas: collisions are left out) and bounce off the walls; every blow flashes.
 * The light helium hits the walls 2,7 times more often than nitrogen, but each blow is softer: the pressure is the same.
 */
import G7Styles from '../g7/G7Styles.astro';

const gases = [
	{ key: 'he', name: 'гелий', f: 'He', m0: '6,6·10⁻²⁷', v: '1350' },
	{ key: 'n2', name: 'азот', f: 'N₂', m0: '4,6·10⁻²⁶', v: '510' },
	{ key: 'ar', name: 'аргон', f: 'Ar', m0: '6,6·10⁻²⁶', v: '430' },
];
const W = 100;
const HH = 132;
const X = [14, 130, 246];
const Y0 = 34;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-avogadropic>
	<div class="g7__grid">
		<svg class="g7__svg av-svg" viewBox="0 0 360 180" role="img" aria-label="Три одинаковых сосуда при одинаковых давлении и температуре: гелий, азот и аргон. В каждом одинаковое число молекул; лёгкие молекулы гелия летают быстрее всех">
			{
				gases.map((g, i) => (
					<g>
						<text class="av-name" x={X[i] + W / 2} y="22" text-anchor="middle">
							{g.name} {g.f}
						</text>
						<rect class="av-gas" x={X[i]} y={Y0} width={W} height={HH} rx="4" />
						<g data-dots={i} class={`av-dots av-dots--${g.key}`} />
						<rect class="av-wall" x={X[i]} y={Y0} width={W} height={HH} rx="4" />
						<g data-hits={i} />
					</g>
				))
			}
		</svg>
		<table class="av-table">
			<thead>
				<tr><th></th>{gases.map((g) => <th>{g.f}</th>)}</tr>
			</thead>
			<tbody>
				<tr><td>масса молекулы <i>m</i><sub>0</sub>, кг</td>{gases.map((g) => <td>{g.m0}</td>)}</tr>
				<tr><td>средняя квадратичная скорость <i>υ</i>, м/с</td>{gases.map((g) => <td>{g.v}</td>)}</tr>
				<tr class="is-same"><td>число молекул, средняя кинетическая энергия <i>Ē</i></td><td colspan="3">одинаковы у всех</td></tr>
			</tbody>
		</table>
	</div>
	<figcaption class="g7__caption">
		Давление 101&nbsp;кПа, температура 20&nbsp;°C в каждом сосуде. Скорости молекул на рисунке — в верном отношении, но движение замедлено, а молекулы нарисованы огромными. Лёгкие атомы гелия ударяют о стенки чаще, но слабее.
	</figcaption>
</figure>

<style>
	.g7__svg .av-name {
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.av-gas {
		fill: color-mix(in oklab, var(--ig-vx) 7%, var(--sl-color-bg));
	}
	.av-wall {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	:global(.av-dots--he circle) {
		fill: hsl(190, 75%, 60%);
	}
	:global(.av-dots--n2 circle) {
		fill: var(--ig-vx);
	}
	:global(.av-dots--ar circle) {
		fill: hsl(275, 60%, 70%);
	}
	:global(:root[data-theme='light'] .av-dots--he circle) {
		fill: hsl(190, 80%, 36%);
	}
	:global(:root[data-theme='light'] .av-dots--ar circle) {
		fill: hsl(275, 50%, 50%);
	}
	:global(.av-hit) {
		stroke: var(--sl-color-white);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.av-table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.av-table th,
	.av-table td {
		padding: 0.3rem 0.45rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		text-align: center;
	}
	.av-table td:first-child {
		text-align: left;
	}
	.av-table th {
		color: var(--sl-color-white);
	}
	.av-table td:not(:first-child) {
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.av-table tr.is-same td {
		background: color-mix(in oklab, var(--ig-v) 10%, transparent);
	}
	@container (max-width: 420px) {
		.av-table {
			font-size: var(--sl-text-xs);
		}
		.av-table th,
		.av-table td {
			padding-inline: 0.25rem;
		}
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const W = 100;
	const HH = 132;
	const X = [14, 130, 246];
	const Y0 = 34;
	const N = 12;
	const PX = 34 / 510; // px/s per м/с
	const V = [1350, 510, 430];
	const RAD = [3, 4.2, 5.2];
	const NS = 'http://www.w3.org/2000/svg';
	const mk = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-avogadropic]')) {
		type M = { x: number; y: number; vx: number; vy: number; e: SVGElement };
		const boxes = V.map((v, i) => {
			const g = root.querySelector<SVGGElement>(`[data-dots="${i}"]`)!;
			const hits = root.querySelector<SVGGElement>(`[data-hits="${i}"]`)!;
			const r = RAD[i];
			// speeds: a 2D Maxwell distribution (Rayleigh), then scaled to the exact mean square
			const raw = Array.from({ length: N }, () => {
				const s = Math.sqrt(-2 * Math.log(1 - Math.random()));
				const a = Math.random() * 2 * Math.PI;
				return [s * Math.cos(a), s * Math.sin(a)];
			});
			const ms = raw.reduce((q, [a, b]) => q + a * a + b * b, 0) / N;
			const k = (v * PX) / Math.sqrt(ms);
			const mols: M[] = raw.map(([a, b], j) => {
				const c = (j % 3) + 0.5;
				const rr = Math.floor(j / 3) + 0.5;
				const x = X[i] + r + 2 + ((W - 2 * r - 4) * c) / 3 + (Math.random() - 0.5) * 8;
				const y = Y0 + r + 2 + ((HH - 2 * r - 4) * rr) / 4 + (Math.random() - 0.5) * 8;
				const e = mk(g, 'circle', { r, cx: x, cy: y }) as SVGElement;
				return { x, y, vx: a * k, vy: b * k, e };
			});
			return { mols, hits, r, i };
		});
		const flashes: { e: SVGElement; t: number }[] = [];
		const flash = (p: Element, d: string) => flashes.push({ e: mk(p, 'path', { class: 'av-hit', d }) as SVGElement, t: 0 });
		loop(root, (dt) => {
			for (const b of boxes) {
				const x0 = X[b.i] + b.r + 1;
				const x1 = X[b.i] + W - b.r - 1;
				const y0 = Y0 + b.r + 1;
				const y1 = Y0 + HH - b.r - 1;
				for (const m of b.mols) {
					m.x += m.vx * dt;
					m.y += m.vy * dt;
					if (m.x < x0 && m.vx < 0) {
						m.x = 2 * x0 - m.x;
						m.vx = -m.vx;
						flash(b.hits, `M${X[b.i] + 1} ${(m.y - 3).toFixed(1)}v6`);
					} else if (m.x > x1 && m.vx > 0) {
						m.x = 2 * x1 - m.x;
						m.vx = -m.vx;
						flash(b.hits, `M${X[b.i] + W - 1} ${(m.y - 3).toFixed(1)}v6`);
					}
					if (m.y < y0 && m.vy < 0) {
						m.y = 2 * y0 - m.y;
						m.vy = -m.vy;
						flash(b.hits, `M${(m.x - 3).toFixed(1)} ${Y0 + 1}h6`);
					} else if (m.y > y1 && m.vy > 0) {
						m.y = 2 * y1 - m.y;
						m.vy = -m.vy;
						flash(b.hits, `M${(m.x - 3).toFixed(1)} ${Y0 + HH - 1}h6`);
					}
					m.e.setAttribute('cx', m.x.toFixed(1));
					m.e.setAttribute('cy', m.y.toFixed(1));
				}
			}
			for (let j = flashes.length - 1; j >= 0; j--) {
				const f = flashes[j];
				f.t += dt;
				if (f.t > 0.25) {
					f.e.remove();
					flashes.splice(j, 1);
				} else f.e.setAttribute('opacity', (1 - f.t / 0.25).toFixed(2));
			}
			return true;
		});
	}
</script>
