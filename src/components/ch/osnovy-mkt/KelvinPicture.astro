---
/**
 * Two scales side by side: Celsius and Kelvin, one degree equal to one kelvin, the zero of the Kelvin scale at
 * −273 °C (more exactly −273,15 °C; the school course rounds to 273). Marks: absolute zero, liquid nitrogen boils
 * (−196 °C = 77 К), ice melts (0 °C = 273 К), the human body (36,6 °C ≈ 310 К), water boils (100 °C = 373 К).
 * Scale 0,66 px per degree.
 */
import G7Styles from '../g7/G7Styles.astro';

const Y0 = 278; // −273 °C
const k = 0.66;
const y = (t: number) => Y0 - (t + 273) * k;
const marks = [
	{ t: -273, T: '0', name: 'абсолютный нуль' },
	{ t: -196, T: '77', name: 'кипит жидкий азот' },
	{ t: 0, T: '273', name: 'тает лёд' },
	{ t: 36.6, T: '310', name: 'тело человека', c: '36,6' },
	{ t: 100, T: '373', name: 'кипит вода' },
];
const CX = 70;
const KX = 290;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-kelvinpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Шкалы Цельсия и Кельвина рядом: абсолютный нуль −273 градуса Цельсия равен 0 кельвинов, лёд тает при 0 градусов Цельсия, то есть 273 кельвинах, вода кипит при 100 градусах Цельсия, или 373 кельвинах">
			<text class="t-title" x={CX} y="16" text-anchor="middle">Цельсий, °C</text>
			<text class="t-title" x={KX} y="16" text-anchor="middle">Кельвин, К</text>
			<rect class="kv-tube" x={CX - 5} y={y(100) - 8} width="10" height={Y0 - y(100) + 12} rx="5"></rect>
			<rect class="kv-tube" x={KX - 5} y={y(100) - 8} width="10" height={Y0 - y(100) + 12} rx="5"></rect>
			<rect class="kv-fill" x={CX - 2.5} y={y(36.6)} width="5" height={Y0 - y(36.6) + 4}></rect>
			<rect class="kv-fill" x={KX - 2.5} y={y(36.6)} width="5" height={Y0 - y(36.6) + 4}></rect>
			{
				marks.map((m) => (
					<g>
						<path class="ln-dash" d={`M${CX + 8} ${y(m.t)} H${KX - 8}`} />
						<path class="kv-tick" d={`M${CX - 9} ${y(m.t)} h18 M${KX - 9} ${y(m.t)} h18`} />
						<text class="t-strong t-num" x={CX - 14} y={y(m.t) + 4} text-anchor="end">{m.c ?? String(m.t).replace('-', '−')}</text>
						<text class="t-strong t-num" x={KX + 14} y={y(m.t) + 4}>{m.T}</text>
						<text class="t-small t-halo" x="180" y={y(m.t) - 4} text-anchor="middle">{m.name}</text>
					</g>
				))
			}
		</svg>
	</div>
	<figcaption class="g7__caption">Шкалы Цельсия и Кельвина: деления одинаковые, а нули разные. От абсолютного нуля до таяния льда — 273 градуса.</figcaption>
</figure>

<style is:global>
	/* labels at least 11 px on a phone (the viewBox is 360 wide) */
	[data-kelvinpic] .g7__svg .t-small {
		font-size: 12px;
	}
	[data-kelvinpic] .kv-tube {
		fill: var(--g7-paper);
		stroke: var(--g7-glass);
		stroke-width: 1.4;
	}
	[data-kelvinpic] .kv-fill {
		fill: var(--g7-red);
	}
	[data-kelvinpic] .kv-tick {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
</style>
