<script>
	import { scene } from '@components/intro/scene';
	import { human, type HumanPose } from '../mehanicheskaya-rabota/people';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const fmt1 = (v: number) => v.toFixed(1).replace('.', ',');
	const NS = 'http://www.w3.org/2000/svg';
	const mk = (tag: string, attrs: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		return e;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-mktintro]')) {
		// ---------------- the pump
		{
			const card = root.querySelector<HTMLElement>('[data-scene="pump"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.9;
			const H = 172;
			const u = S * H;
			const G = 246;
			const PX = 140;
			const boy = human($<SVGGElement>('[data-boy]'), { s: S, H, shirt: 'hm-green', hair: 'short' });
			const rod = $<SVGRectElement>('[data-rod]');
			const handle = $<SVGRectElement>('[data-handle]');
			const needle = $<SVGLineElement>('[data-needle]');
			const nOut = $('[data-n]');
			const pOut = $('[data-p]');
			const PER = 0.85; // s per stroke
			const STROKES = 12;
			const RUN = PER * STROKES + 0.4;
			// handle height above the ground (см) during a stroke: down in the first 55 %, up in the rest
			const handleCm = (ph: number) => (ph < 0.55 ? 101 - 45 * ease(ph / 0.55) : 56 + 45 * ease((ph - 0.55) / 0.45));
			const pose = (hy: number): HumanPose => {
				const k = (101 - hy) / 45; // 0 up … 1 down
				const hip = { x: 100 - 4 * k, y: G - (0.505 * u - 9 * k) };
				return {
					hip,
					lean: 0.35 + 0.6 * k,
					ankles: [
						{ x: 120, y: G - 4 - 6.3 },
						{ x: 90, y: G - 6.3 },
					],
					feet: [0, 0.05],
					hands: [
						{ x: PX - 2, y: G - hy * S + 1 },
						{ x: PX + 3, y: G - hy * S + 1 },
					],
					head: 0.25 + 0.15 * k,
				};
			};
			// the lens: dots inside the tyre (density ∝ pressure in it) and outside (1 атм)
			const LX = 286;
			const LY = 76;
			const LR = 56;
			const bandY = (x: number, b: number) => b - 6 + 12 * (1 - ((x - LX) / (LR + 2)) ** 2); // the quadratic edge
			const TOP = LY - 4;
			const BOT = LY + 7;
			const RD = 2.4;
			// the labels «в шине» and «снаружи» keep their boxes free of dots, so the dots never cover them
			const tags = [
				{ x0: LX - 20, x1: LX + 20, y0: LY - 52, y1: LY - 38 },
				{ x0: LX - 26, x1: LX + 26, y0: LY + 40, y1: LY + 54 },
			];
			const inTag = (x: number, y: number) => tags.find((b) => x > b.x0 - RD && x < b.x1 + RD && y > b.y0 - RD && y < b.y1 + RD);
			const inside = (x: number, y: number) => Math.hypot(x - LX, y - LY) < LR - RD && y < bandY(x, TOP) - RD && !inTag(x, y);
			const outside = (x: number, y: number) => Math.hypot(x - LX, y - LY) < LR - RD && y > bandY(x, BOT) + RD && !inTag(x, y);
			// areas of the two parts, counted on a grid, give the dots per атм
			let aIn = 0;
			let aOut = 0;
			for (let x = LX - LR; x <= LX + LR; x += 1)
				for (let y = LY - LR; y <= LY + LR; y += 1) {
					if (inside(x, y)) aIn++;
					if (outside(x, y)) aOut++;
				}
			const perAtm = 44 / (4 * aIn); // 44 dots inside at 4,0 атм
			const nOutDots = Math.round(perAtm * aOut);
			const dotsG = $<SVGGElement>('[data-dots]');
			const hitsG = $<SVGGElement>('[data-hits]');
			type Dot = { x: number; y: number; vx: number; vy: number; inT: boolean; e: SVGCircleElement; age: number };
			const dots: Dot[] = [];
			const SPEED = 38; // px/s
			const spawn = (inT: boolean) => {
				let x = 0;
				let y = 0;
				do {
					x = LX - LR + Math.random() * 2 * LR;
					y = LY - LR + Math.random() * 2 * LR;
				} while (!(inT ? inside(x, y) : outside(x, y)));
				const a = Math.random() * 2 * Math.PI;
				const e = mk('circle', { r: RD, class: inT ? 'mk-dot' : 'mk-dot mk-dot--out' }) as SVGCircleElement;
				dotsG.append(e);
				dots.push({ x, y, vx: SPEED * Math.cos(a), vy: SPEED * Math.sin(a), inT, e, age: 0 });
			};
			for (let i = 0; i < nOutDots; i++) spawn(false);
			const hits: { e: SVGPathElement; t: number }[] = [];
			const flash = (x: number, y: number) => {
				const e = mk('path', { class: 'mk-hit', d: `M${(x - 3).toFixed(1)} ${y.toFixed(1)} h6` }) as SVGPathElement;
				hitsG.append(e);
				hits.push({ e, t: 0 });
			};
			let last = 0;
			const step = (dt: number) => {
				for (const d of dots) {
					d.age += dt;
					const px = d.x;
					const py = d.y;
					d.x += d.vx * dt;
					d.y += d.vy * dt;
					const ok = d.inT ? inside : outside;
					if (!ok(d.x, d.y)) {
						// step back, then bounce off the wall of the tyre (a blow, flashed) or off the rim of the lens
						const by = d.inT ? bandY(d.x, TOP) - RD : bandY(d.x, BOT) + RD;
						const hitBand = d.inT ? d.y >= by : d.y <= by;
						const tag = inTag(d.x, d.y);
						d.x = px;
						d.y = py;
						if (tag && !hitBand) {
							// bounce off the label's box: off its side when the dot came from the side, else off its top or bottom
							if (px <= tag.x0 - RD || px >= tag.x1 + RD) d.vx = -d.vx;
							else d.vy = -d.vy;
						} else if (hitBand) {
							d.vy = d.inT ? -Math.abs(d.vy) : Math.abs(d.vy);
							flash(d.x, d.inT ? by + RD + 0.6 : by - RD - 0.6);
						} else {
							const r = Math.hypot(d.x - LX, d.y - LY) || 1;
							const nx = (d.x - LX) / r;
							const ny = (d.y - LY) / r;
							const dot = d.vx * nx + d.vy * ny;
							if (dot > 0) {
								d.vx -= 2 * dot * nx;
								d.vy -= 2 * dot * ny;
							}
						}
					}
					d.e.setAttribute('cx', d.x.toFixed(1));
					d.e.setAttribute('cy', d.y.toFixed(1));
					d.e.setAttribute('opacity', Math.min(1, d.age / 0.35).toFixed(2));
				}
				for (let i = hits.length - 1; i >= 0; i--) {
					hits[i].t += dt;
					if (hits[i].t > 0.3) {
						hits[i].e.remove();
						hits.splice(i, 1);
					} else hits[i].e.setAttribute('opacity', (1 - hits[i].t / 0.3).toFixed(2));
				}
			};
			const nIn = () => dots.filter((d) => d.inT).length;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const k = Math.min(STROKES, Math.floor(t / PER));
				const ph = k >= STROKES ? 0 : (t - k * PER) / PER;
				const hy = k >= STROKES ? 101 : handleCm(ph);
				// the air goes in during the second half of the push
				const part = k >= STROKES ? 0 : Math.min(1, Math.max(0, (ph - 0.25) / 0.3));
				const pg = 0.6 + 0.2 * (k + part);
				boy(pose(hy));
				const yH = G - hy * S;
				handle.setAttribute('y', (yH - 2).toFixed(1));
				rod.setAttribute('y', (yH + 1).toFixed(1));
				rod.setAttribute('height', Math.max(0, G - 45 - yH - 1).toFixed(1));
				const a = ((-210 + (pg / 4) * 240) * Math.PI) / 180;
				needle.setAttribute('x2', (PX + 13 + 5.2 * Math.cos(a)).toFixed(2));
				needle.setAttribute('y2', (G - 12 + 5.2 * Math.sin(a)).toFixed(2));
				nOut.textContent = String(k + (part >= 1 ? 1 : 0) > STROKES ? STROKES : Math.min(STROKES, k + (ph > 0.55 ? 1 : 0)));
				pOut.textContent = `${fmt1(pg)}\u00a0атм`;
				// dots inside follow the pressure in the tyre
				const want = Math.round(perAtm * aIn * (1 + pg));
				if (x === 0) {
					for (let i = dots.length - 1; i >= 0; i--)
						if (dots[i].inT) {
							dots[i].e.remove();
							dots.splice(i, 1);
						}
				}
				while (nIn() < want) spawn(true);
				while (nIn() > want) {
					const i = dots.findIndex((d) => d.inT);
					dots[i].e.remove();
					dots.splice(i, 1);
				}
				const now = performance.now();
				const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
				last = now;
				step(dt);
			});
		}
		// ---------------- the thermometer
		{
			const card = root.querySelector<HTMLElement>('[data-scene="thermo"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.9;
			const FL = 250;
			const girl = human($<SVGGElement>('[data-girl]'), { s: S, H: 158, shirt: 'hm-gold', hair: 'pony' });
			const mom = human($<SVGGElement>('[data-mom]'), { s: S, H: 168, shirt: 'hm-blue', hair: 'pony', dir: -1 });
			const ug = S * 158;
			const um = S * 168;
			const lean = -0.16;
			const hip = { x: 138, y: 206 };
			girl({
				hip,
				lean,
				ankles: [
					{ x: 178, y: FL - 5.8 },
					{ x: 172, y: FL - 5.8 },
				],
				feet: [0, 0],
				hands: [
					{ x: 160, y: 200 },
					{ x: 164, y: 203 },
				],
				head: 0.12,
			});
			// the armpit: near the shoulder, a little down and in front
			const L = 0.3 * ug;
			const sh = { x: hip.x + Math.sin(lean) * (L - 0.05 * ug) + Math.cos(lean) * 0.03 * ug, y: hip.y - Math.cos(lean) * (L - 0.05 * ug) };
			const t0 = { x: sh.x + 1, y: sh.y + 4 };
			const t1 = { x: t0.x + 9, y: t0.y + 7 };
			$<SVGPathElement>('[data-therm]').setAttribute('d', `M${t0.x.toFixed(1)} ${(t0.y - 1.2).toFixed(1)} L${t1.x.toFixed(1)} ${(t1.y - 1.2).toFixed(1)} Q${(t1.x + 1.4).toFixed(1)} ${t1.y.toFixed(1)} ${t1.x.toFixed(1)} ${(t1.y + 1.2).toFixed(1)} L${t0.x.toFixed(1)} ${(t0.y + 1.2).toFixed(1)} Z`);
			$<SVGPathElement>('[data-tleader]').setAttribute('d', `M${(196 - 52 * 0.8).toFixed(1)} ${(104 + 52 * 0.6).toFixed(1)} L${(t1.x + 1).toFixed(1)} ${(t1.y + 0.5).toFixed(1)}`);
			// the mother holds a cup out in front of her
			const mh = { x: 292, y: FL - 0.505 * um };
			const cup = { x: 262, y: mh.y - 0.06 * um };
			mom({
				hip: mh,
				lean: 0.06,
				ankles: [
					{ x: 287, y: FL - 6.3 },
					{ x: 298, y: FL - 6.3 },
				],
				feet: [0, 0],
				hands: [
					{ x: cup.x + 4, y: cup.y + 2 },
					{ x: 300, y: mh.y + 6 },
				],
				head: 0.2,
			});
			$<SVGPathElement>('[data-mcup]').setAttribute('d', `M${cup.x - 6} ${cup.y - 9} H${cup.x + 5} L${cup.x + 4} ${cup.y + 1} Q${cup.x} ${cup.y + 3} ${cup.x - 5} ${cup.y + 1} Z M${cup.x - 10} ${cup.y + 2} H${cup.x + 9}`);
			const steam2 = $<SVGPathElement>('[data-steam2]');
			const steam1 = $<SVGPathElement>('[data-steam1]');
			const heat = $<SVGPathElement>('[data-heat]');
			const col = $<SVGRectElement>('[data-col]');
			const tval = $('[data-tval]');
			const tmin = $('[data-tmin]');
			const minH = $<SVGLineElement>('[data-min]');
			const secH = $<SVGLineElement>('[data-sec]');
			const flakes = [...card.querySelectorAll<SVGCircleElement>('[data-flakes] circle')];
			const fy0 = flakes.map((f) => Number(f.getAttribute('cy')));
			const tx = (t: number) => 196 - 44 + (t - 34) * 11;
			const RUN = 9;
			const TAU = 1.5; // мин
			let wall = 0;
			let last = 0;
			scene(card, RUN, (x) => {
				const now = performance.now();
				wall += last ? Math.min(0.05, (now - last) / 1000) : 0;
				last = now;
				const m = x * 10; // minutes of the story
				const T = 36.6 - 11.6 * Math.exp(-m / TAU);
				const shown = Math.max(33, T);
				col.setAttribute('width', (tx(shown) - tx(33) + 4).toFixed(1));
				tval.textContent = T >= 34 ? `${fmt1(Math.floor(T * 10 + 1e-6) / 10)} °C` : '';
				tmin.textContent = `прошло ${Math.floor(m + 1e-6)}\u00a0мин`;
				const am = (m / 60) * 2 * Math.PI;
				minH.setAttribute('x2', (322 + 15 * Math.sin(am)).toFixed(1));
				minH.setAttribute('y2', (44 - 15 * Math.cos(am)).toFixed(1));
				const as = m * 2 * Math.PI;
				secH.setAttribute('x2', (322 + 16 * Math.sin(as)).toFixed(1));
				secH.setAttribute('y2', (44 - 16 * Math.cos(as)).toFixed(1));
				// snow, steam and warm air move in real time
				flakes.forEach((f, i) => {
					const y = 42 + ((fy0[i] - 42 + wall * (8 + (i % 4) * 2)) % 128);
					f.setAttribute('cy', y.toFixed(1));
					f.setAttribute('cx', (Number(f.getAttribute('cx')) + Math.sin(wall + i) * 0.02).toFixed(2));
				});
				const w = Math.sin(wall * 2.2) * 1.5;
				steam1.setAttribute('transform', `translate(${w.toFixed(2)} 0)`);
				steam2.setAttribute('d', `M${cup.x - 3} ${(cup.y - 11).toFixed(1)} q${(-3 + w).toFixed(1)} -6 0 -12 q3 -6 0 -12 M${cup.x + 1} ${(cup.y - 12).toFixed(1)} q${(3 - w).toFixed(1)} -5 0 -10`);
				heat.setAttribute('transform', `translate(${(-w * 0.6).toFixed(2)} 0)`);
			});
		}
	}
</script>
