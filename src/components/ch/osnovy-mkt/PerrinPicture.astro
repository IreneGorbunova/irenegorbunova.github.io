---
/**
 * «Как Перрен следил за броуновской частицей» (section «Основные положения МКТ»): the field of a microscope with a square
 * grid, and the track of one Brownian grain built point by point, as in Perrin's figure in «Les Atomes» (1913): mastic
 * grains of radius 0,53 мкм in water, the position marked every 30 с and the marks joined by straight segments; the
 * side of a square of his grid is 3,2 мкм (the caption of his figure).
 *
 * Physics: a random walk. The diffusion coefficient of such a grain in water at 20 °C is
 * D = kT/(6πηr) = 1,38·10⁻²³ · 293 / (6π · 1,0·10⁻³ Па·с · 0,53·10⁻⁶ м) = 4,0·10⁻¹³ м²/с, so a displacement over a time
 * τ is normal with the spread √(2Dτ) along each axis: 4,9 мкм for τ = 30 с (about 1,5 cells), 1,56 мкм for τ = 3 с.
 * The walk is generated in 3-с steps (500 of them, 25 минут), and the 30-с track takes every tenth point of it, so the two
 * views show the same path; the zigzag of the 3-с view inside each 30-с segment is real, not drawn for effect. A walk
 * that would leave the field is drawn again with another seed (the field is 80 × 80 мкм; the track spans about
 * √50 · 4,9 ≈ 35 мкм).
 * Scale: 4 px per мкм; the grain is drawn to scale (radius 2,1 px). Time: the 50 marks of 25 минут are drawn in 12,5 с
 * (120 times faster), 4 marks per second (40 per second in the 3-с view); then the track holds 3 с and a new grain
 * starts. Colors: the track and the grain gold (the grain is the body that moves).
 */
import G7Styles from '../g7/G7Styles.astro';

const S = 4; // px per мкм
const F = 80 * S; // the field, 320 px
const X0 = 20;
const Y0 = 34;
const cell = 3.2 * S;
const lines: string[] = [];
for (let i = 0; i * cell <= F + 0.01; i++) {
	const v = i * cell;
	lines.push(`M${X0 + v} ${Y0}V${Y0 + F}`, `M${X0} ${Y0 + v}H${X0 + F}`);
}
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-perrinpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 392" role="img" aria-label="Поле зрения микроскопа с квадратной сеткой. Положение броуновской крупинки отмечается точками через равные промежутки времени, и точки соединяются отрезками; при более частых отметках каждый отрезок сам превращается в ломаную">
			<text class="pp-head" x={X0} y="22" data-mode-text>отметки каждые 30&nbsp;с</text>
			<text class="pp-head t-num" x={X0 + F} y="22" text-anchor="end" data-time>прошло 0&nbsp;мин</text>
			<defs>
				<clipPath id="pp-clip"><rect x={X0} y={Y0} width={F} height={F} rx="6"></rect></clipPath>
			</defs>
			<rect class="pp-field" x={X0} y={Y0} width={F} height={F} rx="6"></rect>
			<path class="pp-grid" d={lines.join('')} clip-path="url(#pp-clip)"></path>
			<g clip-path="url(#pp-clip)">
				<path class="pp-track" data-track></path>
				<g data-marks></g>
				<circle class="pp-grain" r={0.53 * S} data-grain></circle>
				<circle class="pp-start" r="4.5" data-start></circle>
			</g>
			<rect class="pp-rim" x={X0} y={Y0} width={F} height={F} rx="6"></rect>
			<path class="pp-bar" d={`M${X0} ${Y0 + F + 16}h${10 * S} M${X0} ${Y0 + F + 11}v10 M${X0 + 10 * S} ${Y0 + F + 11}v10`}></path>
			<text class="pp-lab" x={X0 + 10 * S + 8} y={Y0 + F + 20}>10&nbsp;мкм</text>
			<text class="pp-lab" x={X0 + F} y={Y0 + F + 20} text-anchor="end">клетка 3,2&nbsp;мкм</text>
		</svg>
		<div class="g7__row pp-controls">
			<span class="g7__label">Отмечать положение</span>
			<div class="g7__seg" role="group" aria-label="Как часто отмечать положение крупинки">
				<button type="button" class="g7__btn" aria-pressed="true" data-step="10">каждые 30&nbsp;с</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-step="1">каждые 3&nbsp;с</button>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Крупинка смолы радиусом 0,53&nbsp;мкм в воде, сетка и путь — по рисунку Перрена; размеры в масштабе. 25&nbsp;минут наблюдения показаны за 12,5&nbsp;с. Как часто ни отмечай положение, путь между двумя отметками — не отрезок, а такая же ломаная.
	</figcaption>
</figure>

<style>
	.pp-controls {
		justify-content: center;
	}
	.g7__svg .pp-head {
		font-size: 12.5px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .pp-lab {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.pp-field {
		fill: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-bg));
	}
	.pp-rim {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.pp-grid {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.6;
	}
	.pp-track {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.3;
		stroke-linejoin: round;
	}
	:global(.pp-mark) {
		fill: var(--ig-v);
	}
	.pp-grain {
		fill: var(--ig-v);
		stroke: var(--sl-color-white);
		stroke-width: 0.8;
	}
	.pp-start {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 2 2;
	}
	.pp-bar {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const S = 4;
	const F = 320;
	const X0 = 20;
	const Y0 = 34;
	const N3 = 500; // 3-с steps
	const SIG3 = 1.5587 * S; // px: √(2Dτ) for τ = 3 с
	const NS = 'http://www.w3.org/2000/svg';
	// a small seeded generator, so a track can be drawn again in the other view
	const rng = (seed: number) => () => {
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
	const walk = () => {
		for (;;) {
			const r = rng((Math.random() * 2 ** 31) | 0);
			const gauss = () => Math.sqrt(-2 * Math.log(1 - r())) * Math.cos(2 * Math.PI * r());
			const pts = [{ x: 0, y: 0 }];
			for (let i = 0; i < N3; i++) pts.push({ x: pts[i].x + SIG3 * gauss(), y: pts[i].y + SIG3 * gauss() });
			const xs = pts.map((p) => p.x);
			const ys = pts.map((p) => p.y);
			const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
			if (x1 - x0 > F - 24 || y1 - y0 > F - 24) continue;
			// center the track in the field
			const cx = X0 + F / 2 - (x0 + x1) / 2;
			const cy = Y0 + F / 2 - (y0 + y1) / 2;
			return pts.map((p) => ({ x: p.x + cx, y: p.y + cy }));
		}
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-perrinpic]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const track = q<SVGPathElement>('[data-track]');
		const marks = q<SVGGElement>('[data-marks]');
		const grain = q<SVGCircleElement>('[data-grain]');
		const start = q<SVGCircleElement>('[data-start]');
		const timeOut = q('[data-time]');
		const modeText = q('[data-mode-text]');
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
		let pts = walk();
		let every = 10; // 3-с steps between two marks
		let t = 0; // s of the animation
		const RUN = 12.5;
		const HOLD = 3;
		let shown = -1;
		const draw = (k: number) => {
			// k: marks shown (0 … 50 in units of 30 с), fractional
			const n = Math.min(N3 / every, Math.floor(k * (10 / every) + 1e-9));
			if (n === shown) return;
			shown = n;
			const sel = pts.filter((_, i) => i % every === 0).slice(0, n + 1);
			track.setAttribute('d', sel.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(''));
			marks.replaceChildren(
				...sel.map((p) => {
					const c = document.createElementNS(NS, 'circle');
					c.setAttribute('class', 'pp-mark');
					c.setAttribute('cx', p.x.toFixed(1));
					c.setAttribute('cy', p.y.toFixed(1));
					c.setAttribute('r', every === 10 ? '2.2' : '1.1');
					return c;
				}),
			);
			const last = sel[sel.length - 1];
			grain.setAttribute('cx', last.x.toFixed(1));
			grain.setAttribute('cy', last.y.toFixed(1));
			const min = (n * every * 3) / 60;
			timeOut.textContent = `прошло ${min.toFixed(1).replace('.', ',').replace(',0', '')} мин`;
		};
		const restart = (fresh: boolean) => {
			if (fresh) pts = walk();
			start.setAttribute('cx', pts[0].x.toFixed(1));
			start.setAttribute('cy', pts[0].y.toFixed(1));
			t = 0;
			shown = -1;
			draw(0);
		};
		restart(false);
		for (const b of btns)
			b.addEventListener('click', () => {
				every = Number(b.dataset.step);
				for (const o of btns) o.setAttribute('aria-pressed', String(o === b));
				modeText.textContent = every === 10 ? 'отметки каждые 30 с' : 'отметки каждые 3 с';
				restart(false);
				wake();
			});
		const wake = loop(root, (dt) => {
			t += dt;
			if (t > RUN + HOLD) restart(true);
			draw(Math.min(50, (t / RUN) * 50));
			return true;
		});
	}
</script>
