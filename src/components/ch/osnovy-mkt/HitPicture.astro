---
/**
 * «Удар молекулы о стенку» (section «Давление газа. Основное уравнение МКТ»), a small looping picture. A nitrogen molecule
 * (m₀ = 4,65·10⁻²⁶ кг) flies to the wall at υ = 500 м/с, 30° to the normal: υx = 433 м/с, υy = 250 м/с, and bounces
 * elastically: υy stays, υx changes its sign (the angle of reflection equals the angle of incidence). Two places of the
 * molecule are drawn still, before and after the blow, with the velocity υ⃗ and υ⃗′ (70 px for 500 м/с) and their
 * x-projections υx and −υx (dashed); a third molecule flies along the path (slowed down: the 300 px of the path take
 * 2,4 с) and the wall flashes at the blow. After the blow the change of the molecule's momentum Δp⃗ appears, along the
 * normal, away from the wall (Δpx = −2m₀υx = −4,0·10⁻²³ кг·м/с), and the wall gets the momentum 2m₀υx into it.
 * The molecule is drawn huge; the arrows show directions, Δp⃗ (purple) is not to the scale of the velocities.
 * Colors: velocity gold (--ig-v), its x-projections blue (--ig-vx), the momentum change purple (--sl-color-purple), so it
 * never looks like the velocity in the dark theme. «Δpx = −2m₀υx» stands just below the Δp⃗ label, next to its arrow.
 */
import G7Styles from '../g7/G7Styles.astro';

const XW = 250; // the face of the wall
const R = 8; // the molecule
const H = { x: XW - R, y: 124 }; // the molecule's center at the blow
const c30 = Math.cos(Math.PI / 6);
const s30 = 0.5;
const at = (d: number, out: boolean) => ({ x: H.x - d * c30, y: H.y + (out ? -d : d) * s30 });
const LP = 150; // path length on each side
const P0 = at(LP, false);
const P3 = at(LP, true);
const L = 70; // 500 м/с
const B = at(112, false); // before
const Aa = at(100, true); // after
const tipB = { x: B.x + L * c30, y: B.y - L * s30 };
const tipA = { x: Aa.x - L * c30, y: Aa.y - L * s30 };
const head = (x: number, y: number, ang: number, s = 7) => {
	const a1 = ang + Math.PI - 0.42;
	const a2 = ang + Math.PI + 0.42;
	return `M${x} ${y}L${(x + s * Math.cos(a1)).toFixed(1)} ${(y + s * Math.sin(a1)).toFixed(1)}L${(x + s * Math.cos(a2)).toFixed(1)} ${(y + s * Math.sin(a2)).toFixed(1)}Z`;
};
const arr = (x0: number, y0: number, x1: number, y1: number, s = 7) => {
	const ang = Math.atan2(y1 - y0, x1 - x0);
	const xe = x1 - (s - 1) * Math.cos(ang);
	const ye = y1 - (s - 1) * Math.sin(ang);
	return { line: `M${x0.toFixed(1)} ${y0.toFixed(1)}L${xe.toFixed(1)} ${ye.toFixed(1)}`, head: head(+x1.toFixed(1), +y1.toFixed(1), ang, s) };
};
const vB = arr(B.x, B.y, tipB.x, tipB.y);
const vA = arr(Aa.x, Aa.y, tipA.x, tipA.y);
const xB = arr(B.x, B.y + 0, tipB.x, B.y, 6);
const xA = arr(Aa.x, Aa.y, tipA.x, Aa.y, 6);
const dP = arr(H.x - R - 2, H.y, H.x - R - 56, H.y, 8);
const wP = arr(XW + 18, H.y, XW + 58, H.y, 8);
// a small arrow over a letter: from x to x + w, at the height y (the letter's baseline minus the glyph height)
const over = (x: number, y: number, w: number) => `M${x} ${y}h${w}M${x + w - 3} ${y - 2.4}l3 2.4l-3 2.4`;
const hatch = Array.from({ length: 22 }, (_, i) => `M${XW} ${26 + i * 9}l14 -9`).join('');
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-hitpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 252" role="img" aria-label="Молекула подлетает к стенке под углом и упруго отскакивает: проекция скорости вдоль стенки не меняется, проекция на ось x меняет знак. Импульс молекулы изменяется на величину два m нулевое υx, направленную от стенки, а стенка получает такой же импульс, направленный в неё">
			<rect class="hp-wall" x={XW} y="18" width="14" height="210"></rect>
			<path class="hp-hatch" d={hatch}></path>
			<path class="hp-wall-face" d={`M${XW} 18V228`}></path>
			<text class="hp-lab" x={XW + 20} y="34">стенка</text>
			<path class="hp-path" d={`M${P0.x.toFixed(1)} ${P0.y.toFixed(1)}L${H.x} ${H.y}L${P3.x.toFixed(1)} ${P3.y.toFixed(1)}`}></path>
			<path class="hp-normal" d={`M${H.x + R - 40} ${H.y}H${XW}`}></path>
			<!-- before -->
			<circle class="hp-ghost" cx={B.x} cy={B.y} r={R}></circle>
			<path class="hp-vx" d={xB.line}></path>
			<path class="hp-vx-h" d={xB.head}></path>
			<path class="hp-v" d={vB.line}></path>
			<path class="hp-v-h" d={vB.head}></path>
			<text class="hp-sym hp-sym--v" x={B.x + 16} y={B.y - 28}>υ</text>
			<path class="hp-over hp-over--v" d={over(B.x + 16.5, B.y - 43, 9)}></path>
			<text class="hp-sym hp-sym--x" x={(B.x + tipB.x) / 2 - 8} y={B.y + 22}>υ<tspan class="hp-sub" dy="4">x</tspan></text>
			<!-- after -->
			<g data-after>
				<circle class="hp-ghost" cx={Aa.x} cy={Aa.y} r={R}></circle>
				<path class="hp-vx" d={xA.line}></path>
				<path class="hp-vx-h" d={xA.head}></path>
				<path class="hp-v" d={vA.line}></path>
				<path class="hp-v-h" d={vA.head}></path>
				<text class="hp-sym hp-sym--v" x={tipA.x + 2} y={tipA.y - 6}>υ′</text>
				<path class="hp-over hp-over--v" d={over(tipA.x + 2.5, tipA.y - 21, 9)}></path>
				<text class="hp-sym hp-sym--x" x={(Aa.x + tipA.x) / 2 - 12} y={Aa.y + 22}>−υ<tspan class="hp-sub" dy="4">x</tspan></text>
				<path class="hp-dp" d={dP.line}></path>
				<path class="hp-dp-h" d={dP.head}></path>
				<text class="hp-sym hp-sym--p" x={H.x - R - 92} y={H.y + 6}>Δp</text>
				<path class="hp-over hp-over--p" d={over(H.x - R - 91, H.y - 10, 20)}></path>
				<path class="hp-dp" d={wP.line}></path>
				<path class="hp-dp-h" d={wP.head}></path>
				<text class="hp-lab" x={XW + 20} y={H.y + 24}>стенка</text>
				<text class="hp-lab" x={XW + 20} y={H.y + 40}>получает</text>
				<text class="hp-lab" x={XW + 20} y={H.y + 56}>импульс</text>
				<text class="hp-lab" x={XW + 20} y={H.y + 74}><tspan class="hp-i">2m</tspan><tspan class="hp-sub" dy="4">0</tspan><tspan class="hp-i" dy="-4">υ</tspan><tspan class="hp-sub" dy="4">x</tspan></text>
				<text class="hp-lab hp-lab--p" x={H.x - R - 88} y={H.y + 27} text-anchor="end"><tspan class="hp-i">Δp</tspan><tspan class="hp-sub" dy="4">x</tspan><tspan dy="-4"> = −2</tspan><tspan class="hp-i">m</tspan><tspan class="hp-sub" dy="4">0</tspan><tspan class="hp-i" dy="-4">υ</tspan><tspan class="hp-sub" dy="4">x</tspan></text>
			</g>
			<g data-flash opacity="0">
				<path class="hp-flash" d={`M${XW} ${H.y - 14}V${H.y + 14}`}></path>
			</g>
			<circle class="hp-mol" r={R} data-mol></circle>
			<!-- the x axis -->
			<path class="hp-axis" d="M20 238H226"></path>
			<path class="hp-axis-h" d={head(232, 238, 0, 7)}></path>
			<text class="hp-sym" x="214" y="232">x</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Молекула азота подлетает к стенке со скоростью 500&nbsp;м/с и отскакивает упруго. Проекция скорости вдоль стенки не меняется, проекция на ось <i>x</i> меняет знак. Молекула нарисована огромной, полёт замедлен.
	</figcaption>
</figure>

<style>
	.g7__svg .hp-lab {
		font-size: 12.5px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .hp-sym {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 17px;
		fill: var(--sl-color-gray-1);
	}
	.g7__svg .hp-sym--v {
		fill: var(--ig-v);
	}
	.g7__svg .hp-sym--x {
		fill: var(--ig-vx);
		font-size: 15px;
	}
	.g7__svg .hp-sym--p {
		fill: var(--sl-color-purple);
	}
	.g7__svg .hp-i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
	}
	.g7__svg .hp-sub {
		font-size: 11.5px;
		font-style: italic;
		font-family: var(--ig-font-math);
	}
	.hp-over {
		fill: none;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.hp-over--v {
		stroke: var(--ig-v);
	}
	.hp-over--p {
		stroke: var(--sl-color-purple);
	}
	.hp-wall {
		fill: var(--sl-color-gray-5);
	}
	.hp-hatch {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.hp-wall-face {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.hp-path {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		stroke-dasharray: 3 4;
	}
	.hp-normal {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.hp-ghost {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-bg));
		stroke: var(--ig-vx);
		stroke-width: 1;
		stroke-dasharray: 2 2;
	}
	.hp-mol {
		fill: var(--ig-vx);
		stroke: var(--sl-color-white);
		stroke-width: 1;
	}
	.hp-v {
		stroke: var(--ig-v);
		stroke-width: 2.6;
		fill: none;
	}
	.hp-v-h {
		fill: var(--ig-v);
	}
	.hp-vx {
		stroke: var(--ig-vx);
		stroke-width: 1.8;
		stroke-dasharray: 4 3;
		fill: none;
	}
	.hp-vx-h {
		fill: var(--ig-vx);
	}
	.hp-dp {
		stroke: var(--sl-color-purple);
		stroke-width: 3;
		fill: none;
	}
	.hp-dp-h {
		fill: var(--sl-color-purple);
	}
	.hp-flash {
		stroke: var(--sl-color-white);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.hp-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.hp-axis-h {
		fill: var(--sl-color-gray-3);
	}
	[data-after] {
		transition: opacity 0.35s;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const XW = 250;
	const R = 8;
	const H = { x: XW - R, y: 124 };
	const c30 = Math.cos(Math.PI / 6);
	const LP = 150;
	const SPEED = 125; // px/s on the screen (500 м/с slowed down)
	const T1 = LP / SPEED; // 1,2 с to the wall
	const RUN = 2 * T1 + 0.2;
	const CYCLE = RUN + 2.6; // the end frame holds
	for (const root of document.querySelectorAll<HTMLElement>('[data-hitpic]')) {
		const mol = root.querySelector<SVGCircleElement>('[data-mol]')!;
		const after = root.querySelector<SVGGElement>('[data-after]')!;
		const flash = root.querySelector<SVGGElement>('[data-flash]')!;
		let t = 0;
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			const s = Math.min(t, RUN - 0.2);
			// distance from the hit point, signed: before the blow on the lower branch, after it on the upper one
			const d = (T1 - s) * SPEED;
			const out = d < 0;
			const dd = Math.abs(d);
			const x = H.x - dd * c30;
			const y = H.y + (out ? -dd : dd) * 0.5;
			mol.setAttribute('cx', x.toFixed(1));
			mol.setAttribute('cy', y.toFixed(1));
			mol.setAttribute('opacity', t > RUN ? '0' : '1');
			after.style.opacity = s >= T1 ? '1' : '0';
			const f = t - T1;
			flash.setAttribute('opacity', f >= 0 && f < 0.4 ? (1 - f / 0.4).toFixed(2) : '0');
			return true;
		});
	}
</script>
