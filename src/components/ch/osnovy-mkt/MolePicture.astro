---
/**
 * «По одному молю»: one mole of five substances drawn to one scale, 0,75 px per мм. Each holds 6,02·10²³ particles.
 *   water 18 г = 18 мл: in a glass vial 20 мм across inside, the water column 57 мм high;
 *   aluminium 27 г, ρ = 2,70 г/см³: a cube of 10,0 см³, edge 21,5 мм;
 *   iron 56 г, ρ = 7,87 г/см³: 7,12 см³, edge 19,2 мм;
 *   gold 197 г, ρ = 19,3 г/см³: 10,2 см³, edge 21,7 мм;
 *   air 29 г at 0 °C and 101 325 Па: 22,4 л, a cube with the edge 28,2 см (drawn in oblique projection).
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 0.75; // px per мм
const cube = (x: number, yb: number, a: number, cls: string) => {
	const s = a * K;
	const o = s * 0.35;
	return {
		front: `M${x} ${yb} h${s} v${-s} h${-s} Z`,
		top: `M${x} ${yb - s} l${o} ${-o} h${s} l${-o} ${o} Z`,
		side: `M${x + s} ${yb} l${o} ${-o} v${-s} l${-o} ${o} Z`,
		cls,
	};
};
const rows = [
	{ y: 128, c: cube(20, 128, 21.5, 'ml-al'), name: 'алюминий', m: '27\u00a0г' },
	{ y: 178, c: cube(20, 178, 19.2, 'ml-fe'), name: 'железо', m: '56\u00a0г' },
	{ y: 228, c: cube(20, 228, 21.7, 'ml-au'), name: 'золото', m: '197\u00a0г' },
];
const A = 282 * K; // the air cube, 211,5 px
const AX = 120;
const AB = 262;
const AO = 22;
const VW = 20 * K; // the vial, 15 px inside
const VH = 57 * K;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow not-content" data-molepic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 286" role="img" aria-label="По одному молю пяти веществ в одном масштабе: 18 граммов воды в пробирке, кубики алюминия, железа и золота размером около двух сантиметров и куб воздуха с ребром 28 сантиметров">
			<!-- water in a vial -->
			<path class="ml-glass" d={`M18 ${78 - VH - 8} V78 a${VW / 2 + 1} ${VW / 2 + 1} 0 0 0 ${VW + 2} 0 V${78 - VH - 8}`}></path>
			<path class="ml-water" d={`M19 ${78 - VH} V78 a${VW / 2} ${VW / 2} 0 0 0 ${VW} 0 V${78 - VH} Z`}></path>
			<text class="t-small" x="44" y="56">вода</text>
			<text class="t-strong" x="44" y="72">18&nbsp;г</text>
			{
				rows.map((r) => (
					<g>
						<path class={`ml-face ${r.c.cls}`} d={r.c.side} />
						<path class={`ml-face ml-top ${r.c.cls}`} d={r.c.top} />
						<path class={`ml-face ${r.c.cls}`} d={r.c.front} />
						<text class="t-small" x="50" y={r.y - 14}>{r.name}</text>
						<text class="t-strong" x="50" y={r.y + 2}>{r.m}</text>
					</g>
				))
			}
			<!-- air: 22,4 л -->
			<path class="ml-air" d={`M${AX} ${AB} h${A} v${-A} h${-A} Z M${AX} ${AB - A} l${AO} ${-AO} h${A} l${-AO} ${AO} M${AX + A} ${AB} l${AO} ${-AO} v${-A}`}></path>
			{Array.from({ length: 34 }, (_, i) => <circle class="ml-dot" cx={AX + 12 + ((i * 61) % 190)} cy={AB - 14 - ((i * 37) % 180)} r="1.6" />)}
			<text class="t-small" x={AX + A / 2} y={AB - A / 2 - 26} text-anchor="middle">воздух при 0&nbsp;°C</text>
			<text class="t-small" x={AX + A / 2} y={AB - A / 2 - 12} text-anchor="middle">и нормальном давлении</text>
			<text class="t-strong" x={AX + A / 2} y={AB - A / 2 + 6} text-anchor="middle">29&nbsp;г = 22,4&nbsp;л</text>
			<path class="ml-dim" d={`M${AX} ${AB + 10} h${A} M${AX} ${AB + 6} v8 M${AX + A} ${AB + 6} v8`}></path>
			<text class="t-small" x={AX + A / 2} y={AB + 22} text-anchor="middle">28,2&nbsp;см</text>
			<path class="ml-dim" d={`M14 ${AB + 10} h${100 * K} M14 ${AB + 6} v8 M${14 + 100 * K} ${AB + 6} v8`}></path>
			<text class="t-small" x={14 + 50 * K} y={AB + 22} text-anchor="middle">10&nbsp;см</text>
		</svg>
	</div>
	<figcaption class="g7__caption">По одному молю пяти веществ в одном масштабе. В каждом — 6,02·10²³ частиц: молекул воды и воздуха, атомов металлов.</figcaption>
</figure>

<style is:global>
	[data-molepic] .ml-glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 1.4;
	}
	[data-molepic] .ml-water {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 0.8;
	}
	[data-molepic] .ml-face {
		stroke: var(--g7-ink);
		stroke-width: 0.6;
		stroke-linejoin: round;
	}
	[data-molepic] .ml-top {
		filter: brightness(1.18);
	}
	[data-molepic] .ml-al {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 80%, var(--g7-blue));
	}
	[data-molepic] .ml-fe {
		fill: color-mix(in oklab, var(--sl-color-gray-4) 85%, var(--g7-blue));
	}
	[data-molepic] .ml-au {
		fill: var(--g7-gold);
	}
	[data-molepic] .ml-air {
		fill: color-mix(in oklab, var(--g7-blue) 8%, transparent);
		stroke: var(--g7-blue);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
	}
	[data-molepic] .ml-dot {
		fill: var(--g7-blue);
		opacity: 0.55;
	}
	[data-molepic] .ml-dim {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
	}
</style>
