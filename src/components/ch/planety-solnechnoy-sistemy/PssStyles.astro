---
/**
 * Frame, labels and the colors of the bodies shared by the pictures and models of the grade-9 chapter «Солнечная
 * система» (prefix pss-). Renders nothing but a global stylesheet; theme variables only, so both themes work.
 * Planet colors are mixes of the three accent hues (--ig-v gold, --ig-vx blue, --ig-vy red) with grays.
 */
---

<style is:global>
	.pss {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.pss__svg {
		display: block;
		width: 100%;
		max-width: 34rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.pss text {
		font-family: var(--__sl-font);
		font-size: 11px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	.pss .pss-title {
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.pss .pss-small {
		font-size: 9.5px;
		fill: var(--sl-color-gray-3);
	}
	.pss .pss-sun-t {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.pss__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.pss__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.pss__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		justify-content: center;
		margin-top: 0.6rem;
	}
	.pss__btn {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.pss__btn:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.pss__btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	/* lines */
	.pss-line {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.pss-faint {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.pss-lead {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.pss-zoom {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 40%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	/* bodies */
	.pss-sun {
		fill: var(--ig-v);
	}
	.pss-glow {
		fill: color-mix(in srgb, var(--ig-v) 25%, transparent);
	}
	.pss-mercury {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 85%, var(--ig-v));
	}
	.pss-venus {
		fill: color-mix(in srgb, var(--ig-v) 55%, var(--sl-color-gray-2));
	}
	.pss-earth {
		fill: var(--ig-vx);
	}
	.pss-land {
		fill: color-mix(in srgb, hsl(130, 45%, 45%) 70%, var(--ig-vx));
	}
	.pss-mars {
		fill: var(--ig-vy);
	}
	.pss-jupiter {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-3));
	}
	.pss-band {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vy) 40%, var(--sl-color-gray-3));
		stroke-linecap: round;
		opacity: 0.75;
	}
	.pss-spot {
		fill: color-mix(in srgb, var(--ig-vy) 70%, var(--sl-color-gray-3));
	}
	.pss-saturn {
		fill: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-2));
	}
	.pss-ring {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-3));
		opacity: 0.85;
	}
	.pss-uranus {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-2));
	}
	.pss-neptune {
		fill: color-mix(in srgb, var(--ig-vx) 80%, var(--sl-color-gray-4));
	}
	.pss-rock {
		fill: var(--sl-color-gray-3);
	}
	.pss-ice {
		fill: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-gray-2));
	}
	.pss-shade {
		fill: #000;
		opacity: 0.28;
	}
	[data-theme='light'] .pss-shade {
		opacity: 0.18;
	}
</style>
