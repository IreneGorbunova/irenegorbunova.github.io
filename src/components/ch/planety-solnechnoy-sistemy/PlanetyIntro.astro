<script>
	import { scene } from '@components/intro/scene';
	import { figure, type FigurePose, type HandTarget } from '@components/people/body';
	import { blendShape, handShape } from '@components/people/hand';
	import { ease } from '@components/people/motion';
	import type { Pt } from '@components/people/core';

	const f = (v: number) => v.toFixed(1);
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const seg = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
	// a hand target pulled in to the reach of the arm (the bones never stretch, the contact stays honest)
	const within = (o: Pt, p: Pt, r: number): Pt => {
		const d = Math.hypot(p.x - o.x, p.y - o.y);
		return d <= r ? p : { x: o.x + ((p.x - o.x) * r) / d, y: o.y + ((p.y - o.y) * r) / d };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-pi-intro]')) {
		// ---------- «Звездопад»: 9,5 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="meteors"]')!;
			const RAD = { x: 330, y: 158 }; // the radiant, low over the trees in the north-east
			// start time, duration (s), screen angle of the ray (deg), start distance from the radiant, length (px)
			const M = [
				{ t0: 0.6, dur: 0.5, a: -150, d0: 120, len: 46 },
				{ t0: 2.4, dur: 0.4, a: -118, d0: 78, len: 34 },
				{ t0: 3.6, dur: 0.35, a: -138, d0: 170, len: 30 },
				{ t0: 4.6, dur: 0.9, a: -164, d0: 128, len: 96 },
				{ t0: 7.6, dur: 0.45, a: -104, d0: 100, len: 38 },
			].map((m, i) => {
				const g = card.querySelector<SVGGElement>(`[data-meteor="${i}"]`)!;
				const u = { x: Math.cos((m.a * Math.PI) / 180), y: Math.sin((m.a * Math.PI) / 180) };
				return {
					...m,
					u,
					p0: { x: RAD.x + u.x * m.d0, y: RAD.y + u.y * m.d0 },
					g,
					grad: card.querySelector<SVGLinearGradientElement>(`[data-mgrad="${i}"]`)!,
					streak: g.querySelector<SVGLineElement>('[data-streak]')!,
					head: g.querySelector<SVGCircleElement>('[data-head]')!,
					train: g.querySelector<SVGLineElement>('[data-train]')!,
				};
			});
			const twinkle = [...card.querySelectorAll<SVGCircleElement>('[data-tw]')].filter((s) => Number(s.dataset.tw) >= 0);

			// the two people lie on their backs: lean −90° turns the body back, the head to the left
			const LEAN = -Math.PI / 2;
			const HEAD = 0.6 * LEAN - 0.12; // the head in line with the body, the chin a little up
			const TS = 0.5;
			const AS = 0.55;
			const teen = figure(card.querySelector<SVGGElement>('[data-teen]')!, { s: TS, H: 162, age: 'teen', shirt: 'hm-gold', hair: 'short', name: 'teen lying on the blanket' });
			const adult = figure(card.querySelector<SVGGElement>('[data-adult]')!, { s: AS, H: 170, shirt: 'hm-blue', hair: 'pony', name: 'grown-up lying on the blanket' });
			const tu = 162 * TS;
			const au = 170 * AS;
			const tHip: Pt = { x: 168, y: 205 - 0.07 * tu };
			const aHip: Pt = { x: 206, y: 221 - 0.075 * au };
			const [tSh] = teen.shoulders(tHip, LEAN);
			const bright = M[3];
			// the teen points at the middle of the bright streak
			const aim = { x: bright.p0.x + bright.u.x * bright.len * 0.6, y: bright.p0.y + bright.u.y * bright.len * 0.6 };
			const aimAng = Math.atan2(aim.y - tSh.y, aim.x - tSh.x);
			const restAng = 0.28; // the arm lies along the body
			const reachR = 0.37 * tu;
			const relaxed = handShape('relaxed');
			const point = handShape('point');
			const adultPose: FigurePose = {
				hip: aHip,
				lean: LEAN,
				head: HEAD,
				ankles: [aHip, aHip],
				legs: [
					[-0.62, 1.15],
					[0.06, 0.08],
				],
				feet: [-1.25, -1.45],
				hands: [
					{ at: { x: aHip.x - 0.1 * au, y: aHip.y - 0.085 * au }, pose: 'relaxed', dir: 0.15, contact: 'own belly' },
					{ arm: [0.12, 0.25], pose: 'relaxed' },
				],
			};
			const draw = (x: number) => {
				const t = x * 9.5;
				for (const m of M) {
					const k = (t - m.t0) / m.dur;
					if (k < 0 || k > 1 + (m === bright ? 1.2 : 0)) {
						m.g.setAttribute('opacity', '0');
						continue;
					}
					const kk = Math.min(1, k);
					const head = { x: m.p0.x + m.u.x * m.len * kk, y: m.p0.y + m.u.y * m.len * kk };
					const tailLen = m.len * Math.min(0.65, kk * 1.2);
					const tail = { x: head.x - m.u.x * tailLen, y: head.y - m.u.y * tailLen };
					const a = k <= 1 ? Math.min(1, kk * 5) * (kk > 0.7 ? (1 - kk) / 0.3 + 0.05 : 1) : 0;
					m.g.setAttribute('opacity', '1');
					m.streak.setAttribute('opacity', a.toFixed(2));
					m.head.setAttribute('opacity', a.toFixed(2));
					for (const e of [m.streak, m.grad]) {
						e.setAttribute('x1', f(tail.x));
						e.setAttribute('y1', f(tail.y));
						e.setAttribute('x2', f(head.x));
						e.setAttribute('y2', f(head.y));
					}
					m.head.setAttribute('cx', f(head.x));
					m.head.setAttribute('cy', f(head.y));
					if (m === bright) {
						// the faint trail stays along the path and fades within about a second
						const tr = k < 0.3 ? 0 : k <= 1 ? 0.35 * (k - 0.3) / 0.7 : 0.35 * (1 - (k - 1) / 1.2);
						m.train.setAttribute('x1', f(m.p0.x + m.u.x * m.len * 0.15));
						m.train.setAttribute('y1', f(m.p0.y + m.u.y * m.len * 0.15));
						m.train.setAttribute('x2', f(m.p0.x + m.u.x * m.len * Math.min(kk, 0.95)));
						m.train.setAttribute('y2', f(m.p0.y + m.u.y * m.len * Math.min(kk, 0.95)));
						m.train.setAttribute('opacity', tr.toFixed(2));
					}
				}
				for (const s of twinkle) s.setAttribute('opacity', (0.65 + 0.35 * Math.sin(t * 5 + Number(s.dataset.tw))).toFixed(2));
				// the teen: the arm goes up during the bright streak (0,9 s), stays, and lies back down
				const up = ease(seg(t, 4.9, 5.8)) * (1 - ease(seg(t, 8.2, 9.1)));
				const ang = lerp(restAng, aimAng, up);
				const hand: HandTarget = {
					at: { x: tSh.x + Math.cos(ang) * reachR * lerp(0.86, 1, up), y: tSh.y + Math.sin(ang) * reachR * lerp(0.86, 1, up) + (1 - up) * 0.02 * tu },
					pose: up > 0.5 ? 'point' : 'relaxed',
					shape: blendShape(relaxed, point, up),
					dir: ang,
					contact: up > 0.95 ? 'pointing at the streak' : undefined,
				};
				teen.pose({
					hip: tHip,
					lean: LEAN,
					head: HEAD - 0.15 * up,
					ankles: [tHip, tHip],
					legs: [
						[0.05, 0.12],
						[-0.35, 0.75],
					],
					feet: [-1.4, -1.2],
					hands: [hand, { arm: [0.2, 0.3], pose: 'relaxed' }],
				});
				adult.pose(adultPose);
			};
			scene(card, 9.5, draw);
		}

		// ---------- «Кольцо»: 9 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ring"]')!;
			const GROUND = 228;
			const CS = 0.75;
			const child = figure(card.querySelector<SVGGElement>('[data-child]')!, { s: CS, H: 132, age: 'child', shirt: 'hm-red', hair: 'pony', dir: -1, name: 'child at the eyepiece' });
			const grown = figure(card.querySelector<SVGGElement>('[data-grownup]')!, { s: CS, H: 176, shirt: 'hm-green', hair: 'short', dir: -1, name: 'grown-up showing the star' });
			const cu = 132 * CS;
			const gu = 176 * CS;
			// the child: standing, then bent to the eyepiece (the feet stay; the hips go back a little)
			const CF = 226; // the child's feet
			const hipUp: Pt = { x: CF, y: GROUND - 0.48 * cu };
			const BEND = 0.52;
			const hipBent: Pt = { x: CF + 5, y: GROUND - 0.475 * cu };
			const ankles: [Pt, Pt] = [
				{ x: CF - 2, y: GROUND - 0.045 * cu },
				{ x: CF + 3, y: GROUND - 0.045 * cu - 0.6 },
			];
			// where the child's eye is when bent: the head center plus a little to the front
			const sp = 0.437 * cu;
			const headBent = { x: hipBent.x - Math.sin(BEND) * sp, y: hipBent.y - Math.cos(BEND) * sp };
			const eye = { x: headBent.x - 0.075 * cu, y: headBent.y + 0.01 * cu };
			// the tube: from the eyepiece toward the bright «star» at (40, 64)
			const STAR = { x: 40, y: 64 };
			const back = { x: eye.x - 1.5, y: eye.y }; // the end of the eyepiece, just in front of the eye
			const dirv = { x: STAR.x - back.x, y: STAR.y - back.y };
			const dl = Math.hypot(dirv.x, dirv.y);
			const u = { x: dirv.x / dl, y: dirv.y / dl };
			const n = { x: -u.y, y: u.x };
			const P = (s: number, w: number) => `${f(back.x + u.x * s + n.x * w)} ${f(back.y + u.y * s + n.y * w)}`;
			const tubeLen = 100 * CS; // about 1 м at 0,75 px/см
			card.querySelector('[data-eyepiece]')!.setAttribute('d', `M${P(-1, -2.2)} L${P(7, -2.2)} L${P(7, 2.2)} L${P(-1, 2.2)} Z`);
			card.querySelector('[data-focuser]')!.setAttribute('d', `M${P(7, -3)} L${P(16, -3)} L${P(16, 3)} L${P(7, 3)} Z`);
			card.querySelector('[data-tube-body]')!.setAttribute('d', `M${P(16, -4.4)} L${P(tubeLen, -4.4)} L${P(tubeLen, 4.4)} L${P(16, 4.4)} Z`);
			card.querySelector('[data-dew]')!.setAttribute('d', `M${P(tubeLen - 14, -5.4)} L${P(tubeLen + 2, -5.4)} L${P(tubeLen + 2, 5.4)} L${P(tubeLen - 14, 5.4)} Z`);
			// the mount under the tube's middle; legs set in the markup are shifted to it
			const mid = { x: back.x + u.x * (tubeLen * 0.55) + n.x * 7, y: back.y + u.y * (tubeLen * 0.55) + n.y * 7 };
			const legs = { far: [mid.x + 1, mid.y + 4, mid.x + 6, GROUND - 6], l: [mid.x - 3, mid.y + 6, mid.x - 26, GROUND], r: [mid.x + 3, mid.y + 6, mid.x + 24, GROUND] };
			for (const [k, [x1, y1, x2, y2]] of Object.entries(legs)) card.querySelector(`[data-leg="${k}"]`)!.setAttribute('d', `M${f(x1)} ${f(y1)} L${f(x2)} ${f(y2)}`);
			card.querySelector('[data-mount]')!.setAttribute('d', `M${f(mid.x - 6)} ${f(mid.y - 3)} h12 v10 h-12 Z`);
			const ty = mid.y + 6 + 0.5 * (GROUND - mid.y - 6);
			card.querySelector('[data-tray]')!.setAttribute('d', `M${f(mid.x - 3 - 23 * 0.5)} ${f(ty)} L${f(mid.x + 3 + 21 * 0.5)} ${f(ty)}`);
			// the slow-motion cable hangs from the mount; its knob is where the child's hand rests
			const knob = { x: hipBent.x - 0.33 * cu, y: hipBent.y - 0.12 * cu };
			card.querySelector('[data-cable]')!.setAttribute('d', `M${f(mid.x + 3)} ${f(mid.y + 4)} Q${f(mid.x + 4)} ${f(knob.y + 6)} ${f(knob.x - 0.5)} ${f(knob.y - 2.4)}`);
			const knobG = card.querySelector<SVGGElement>('[data-knob]')!;
			// the eyepiece view
			const view = card.querySelector<SVGGElement>('[data-view]')!;
			card.querySelector('[data-view-line]')!.setAttribute('d', `M${f(back.x + 2)} ${f(back.y - 4)} L${f(300 - 40 * 0.75)} ${f(50 + 40 * 0.66)}`);
			const field = card.querySelector<SVGGElement>('[data-field]')!;
			const sat = card.querySelector<SVGGElement>('[data-saturn]')!;
			const S0 = { x: -6, y: 2 };

			// the grown-up stands behind, pointing at the «star» and then letting the arm down
			const GX = 300;
			const gHip: Pt = { x: GX, y: GROUND - 0.52 * gu };
			const [gSh] = grown.shoulders(gHip, 0);
			const starAng = Math.atan2(STAR.y - gSh.y, STAR.x - gSh.x);
			const hangAng = Math.PI / 2 + 0.06;
			const gR = 0.39 * gu;
			const relaxed = handShape('relaxed');
			const point = handShape('point');
			const grip = handShape('grip', 0.2);

			const draw = (x: number) => {
				const t = x * 9;
				// grown-up: arm up 0,2–1,0 s, down 3,0–3,9 s
				const up = ease(seg(t, 0.2, 1.0)) * (1 - ease(seg(t, 3.0, 3.9)));
				const ga = lerp(hangAng, starAng, up);
				grown.pose({
					hip: gHip,
					lean: 0,
					head: -0.25 * up,
					ankles: [
						{ x: GX - 3, y: GROUND - 0.045 * gu },
						{ x: GX + 4, y: GROUND - 0.045 * gu - 0.6 },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: gSh.x + Math.cos(ga) * gR * lerp(0.9, 1, up), y: gSh.y + Math.sin(ga) * gR * lerp(0.9, 1, up) }, pose: up > 0.5 ? 'point' : 'relaxed', shape: blendShape(relaxed, point, up), dir: ga, contact: up > 0.95 ? 'pointing at the star' : undefined },
						{ arm: [Math.PI / 2 - 0.05, 0.2], pose: 'relaxed' },
					],
				});
				// child: bends 1,2–2,2 s; the near hand goes to the knob 1,6–2,4 s
				const b = ease(seg(t, 1.2, 2.2));
				const h = ease(seg(t, 1.6, 2.4));
				const hip = { x: lerp(hipUp.x, hipBent.x, b), y: lerp(hipUp.y, hipBent.y, b) };
				const [cSh] = child.shoulders(hip, BEND * b);
				const hang = { x: cSh.x + 0.01 * cu, y: cSh.y + 0.31 * cu };
				child.pose({
					hip,
					lean: BEND * b,
					head: 0.2 * b,
					ankles,
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: within(cSh, { x: lerp(hang.x, knob.x, h), y: lerp(hang.y, knob.y, h) }, 0.33 * cu), pose: h > 0.5 ? 'grip' : 'relaxed', d: 1.4, shape: blendShape(relaxed, grip, h), contact: h > 0.999 ? 'knob' : undefined },
						{ arm: [Math.PI / 2 + 0.05 + 0.35 * b, 0.2], pose: 'relaxed' },
					],
				});
				// the view: appears 2,3–2,7 s; the sky drifts 2,7–6,2 s; the knob brings it back 6,2–7,8 s
				const vis = seg(t, 2.3, 2.7);
				view.setAttribute('opacity', vis.toFixed(2));
				const drift = 7 * Math.max(0, Math.min(t, 7.8) - 2.7); // px/s, the sky keeps turning
				const fix = 7 * 5.1 * ease(seg(t, 6.2, 7.8)); // the correction cancels the drift by 7,8 s
				const dx = drift - fix;
				field.setAttribute('transform', `translate(${f(dx)} ${f(dx * 0.18)})`);
				sat.setAttribute('transform', `translate(${f(300 + S0.x)} ${f(50 + S0.y)}) rotate(-12)`);
				const turn = seg(t, 6.2, 7.8) * 540;
				knobG.setAttribute('transform', `translate(${f(knob.x)} ${f(knob.y)}) rotate(${f(turn)})`);
			};
			scene(card, 9, draw);
		}
	}
</script>
