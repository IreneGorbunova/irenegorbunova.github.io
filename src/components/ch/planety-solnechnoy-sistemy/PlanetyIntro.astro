---
/**
 * The two opening scenes of the grade-9 chapter «Солнечная система». No terms of the chapter in the pictures or the
 * visible captions; the popovers name them and link to the sections.
 *
 * «Звездопад»: an August night at a dacha. A teenager and a grown-up lie on their backs on a blanket; five «falling
 *   stars» flash in 9,5 s, each 0,35–0,9 s long (real meteors last 0,1–1 s), and every streak lies on a line coming
 *   from one point low in the north-east (the radiant of the Perseids, in Perseus; it is on the right, about 7° above
 *   the trees). The fourth is a bright one with a greenish head and a faint trail that stays for a moment; the
 *   teenager raises an arm (0,9 s, eased, within the joint limits) and points where it flew. The rate is compressed:
 *   at the peak a dark sky gives about one meteor a minute to an observer, here one every two seconds. The Milky Way
 *   passes through Perseus, so the faint band runs down to the radiant.
 * «Кольцо»: a yard at dusk. A small refractor (an 80-mm tube about 1 m long) on a tripod points at a bright steady
 *   yellowish «star» low in the sky; a grown-up shows it, a child of about 9 bends to the eyepiece. The round inset is
 *   the view in the eyepiece at 50×: a field of 1° with Saturn. The sky turns by 15″ a second, so at 50× Saturn
 *   drifts from the middle to the edge of the field in about two minutes; here in 3,5 s (about 35 times faster).
 *   Saturn is drawn about ten times larger than it looks at 50× (the rings 41″ across would cover only 1/90 of the
 *   field). The child turns the knob of the slow-motion cable and brings it back.
 * People: the shared kit (src/components/people/); at this size the hands are mitten shapes with a thumb.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const blur = `pi-blur-${uid}`;
const blur2 = `pi-blur2-${uid}`;
const clipEye = `pi-eye-${uid}`;
let seed = 7;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const r1 = (v: number) => Math.round(v * 10) / 10;
// night sky stars (scene 1): brighter ones fewer
const stars = Array.from({ length: 90 }, () => {
	const b = rnd();
	return { x: r1(rnd() * 360), y: r1(rnd() * 168), r: b > 0.93 ? 1.3 : b > 0.7 ? 0.9 : 0.55, tw: rnd() < 0.25 ? r1(rnd() * 6.28) : -1 };
});
// the Milky Way: many faint dots along a band from the top to the radiant
const milky = Array.from({ length: 160 }, () => {
	const t = rnd();
	const w = (rnd() - 0.5) * (46 - 20 * t) + (rnd() - 0.5) * 12;
	const cx = 130 + 190 * t;
	const cy = -10 + 168 * t;
	// across the band: the normal of the direction (190, 178)
	return { x: r1(cx - 0.68 * w), y: r1(cy + 0.73 * w), r: r1(0.3 + rnd() * 0.35) };
});
// birch trees at the left edge of the meadow
const birches = [
	{ x: 18, top: 92, w: 4.2 },
	{ x: 36, top: 104, w: 3.4 },
	{ x: 52, top: 118, w: 2.8 },
];
const marks = birches.flatMap((b) =>
	Array.from({ length: 7 }, (_, i) => ({ x: b.x - b.w / 2, y: r1(b.top + 18 + i * ((176 - b.top - 18) / 7) + rnd() * 4), w: r1(b.w * (0.4 + rnd() * 0.5)) })),
);
const fencePosts = Array.from({ length: 13 }, (_, i) => 150 + i * 16);
// dusk sky stars (scene 2): only a few of the brightest are out
const duskStars = [
	[96, 22, 0.8],
	[150, 12, 0.6],
	[214, 30, 0.7],
	[248, 14, 0.6],
	[182, 48, 0.5],
	[28, 20, 0.6],
	[118, 40, 0.5],
];
const fieldStars = [
	[-22, -14, 0.7],
	[14, -24, 0.5],
	[-30, 12, 0.6],
	[24, 18, 0.5],
	[-6, 28, 0.4],
	[34, -6, 0.4],
];
const grassTufts = Array.from({ length: 26 }, () => ({ x: r1(rnd() * 360), y: r1(200 + rnd() * 38) }));
---

<PeopleStyles />
<IntroFrame data-pi-intro>
	<div class="intro__card" data-scene="meteors">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Августовская ночь за городом. Подросток и взрослый лежат на покрывале на лугу и смотрят в звёздное небо. Одна за другой вспыхивают короткие светящиеся черты — «падающие звёзды»; все они летят как будто из одной точки низко над деревьями справа. Самую яркую подросток показывает рукой">
			<defs>
				<linearGradient id={`pi-night-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="pi-night-top"></stop>
					<stop offset="1" class="pi-night-bot"></stop>
				</linearGradient>
				<filter id={blur} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter>
				<filter id={blur2} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="1.2"></feGaussianBlur></filter>
				{
					[0, 1, 2, 3, 4].map((i) => (
						<linearGradient id={`pi-mg-${i}-${uid}`} gradientUnits="userSpaceOnUse" data-mgrad={i}>
							<stop offset="0" class="pi-meteor-tail" />
							<stop offset="0.75" class="pi-meteor-mid" />
							<stop offset="1" class={i === 3 ? 'pi-meteor-head pi-meteor-head--green' : 'pi-meteor-head'} />
						</linearGradient>
					))
				}
			</defs>
			<rect x="0" y="0" width="360" height="180" fill={`url(#pi-night-${uid})`}></rect>
			<!-- the Milky Way: a soft glow and grainy dots -->
			<path class="pi-milky" d="M100 -10 L170 -10 L352 172 L300 176 Z" filter={`url(#${blur})`}></path>
			{milky.map((s) => <circle class="pi-milky-dot" cx={s.x} cy={s.y} r={s.r} />)}
			{stars.map((s) => <circle class="pi-star" cx={s.x} cy={s.y} r={s.r} data-tw={s.tw} />)}
			<!-- the meteors (drawn by the script) -->
			<g data-meteors>
				{
					[0, 1, 2, 3, 4].map((i) => (
						<g data-meteor={i} opacity="0">
							<line class="pi-train" data-train opacity="0" x1="0" y1="0" x2="0" y2="0" filter={`url(#${blur2})`} />
							<line stroke={`url(#pi-mg-${i}-${uid})`} stroke-width={i === 3 ? 2.2 : 1.3} stroke-linecap="round" data-streak x1="0" y1="0" x2="0" y2="0" />
							<circle class={i === 3 ? 'pi-head pi-head--green' : 'pi-head'} r={i === 3 ? 2.2 : 1.1} data-head />
						</g>
					))
				}
			</g>
			<!-- the far tree line, a dacha house with one lit window, the fence -->
			<path class="pi-treeline" d="M0 178 L0 166 Q14 150 26 160 Q40 146 58 158 Q74 150 88 162 L110 164 Q130 156 146 166 L230 168 Q250 158 268 166 Q290 156 306 168 L360 166 L360 182 Z"></path>
			<path class="pi-house" d="M262 176 V156 L280 144 L298 156 V176 Z"></path>
			<path class="pi-roof" d="M258 158 L280 141 L302 158 L298 159 L280 145 L262 159 Z"></path>
			<rect class="pi-window" x="270" y="160" width="7" height="7"></rect>
			<rect class="pi-window-glow" x="266" y="156" width="15" height="15" rx="6" filter={`url(#${blur2})`}></rect>
			<rect class="pi-house-win-dark" x="285" y="160" width="7" height="7"></rect>
			<rect class="pi-meadow" x="0" y="176" width="360" height="64"></rect>
			<path class="pi-rail" d="M140 181 H360 M140 187 H360"></path>
			{fencePosts.map((x) => <path class="pi-post" d={`M${x} 177 V192`} />)}
			<!-- birches -->
			{birches.map((b) => <path class="pi-birch-crown" d={`M${b.x} ${b.top - 6} q-${b.w * 5} 20 -${b.w * 3} 52 q${b.w * 3} 10 ${b.w * 6} 0 q${b.w * 2} -32 -${b.w * 3} -52 Z`} />)}
			{birches.map((b) => <path class="pi-birch" d={`M${b.x - b.w / 2} 192 L${b.x - b.w / 3} ${b.top} H${b.x + b.w / 3} L${b.x + b.w / 2} 192 Z`} />)}
			{marks.map((m) => <path class="pi-birch-mark" d={`M${m.x} ${m.y} h${m.w}`} />)}
			{grassTufts.map((t) => <path class="pi-tuft" d={`M${t.x} ${t.y} l-2 -4 M${t.x} ${t.y} l1 -5 M${t.x} ${t.y} l3 -3`} />)}
			<!-- the blanket and the two people -->
			<path class="pi-blanket" d="M96 200 L268 200 L282 226 L80 226 Z"></path>
			<path class="pi-blanket-check" d="M139 200 L134 226 M182 200 L181 226 M225 200 L228 226 M90 209 H272 M86 217 H277"></path>
			<path class="pi-blanket-edge" d="M80 226 L282 226 L282 229 L80 229 Z"></path>
			<g data-teen></g>
			<g data-adult></g>
		</svg>
		<div class="intro__foot">
			<p>В середине августа за городом за час можно увидеть несколько десятков <More term="«падающих звёзд»">Это не звёзды, а пылинки и крупинки, которые оставила на своём пути комета. Каждый август Земля проходит сквозь их рой. Крупинки влетают в воздух со скоростью около 60&nbsp;км/с и сгорают на высоте около 100&nbsp;км. Летят они параллельно друг другу, поэтому издали кажется, что все черты разбегаются из одной точки неба. Подробнее — в разделе <a href="#карликовые-планеты-и-малые-тела">«Карликовые планеты и малые тела»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="ring">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер во дворе. На треноге стоит небольшой телескоп и смотрит на яркую ровную «звезду» низко над домами. Взрослый показывает на неё рукой, ребёнок наклоняется к окуляру. В кружке — то, что он видит: маленький шарик с тонким кольцом медленно уплывает к краю, и ребёнок ручкой на телескопе возвращает его на середину">
			<defs>
				<linearGradient id={`pi-dusk-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="pi-dusk-top"></stop>
					<stop offset="0.7" class="pi-dusk-mid"></stop>
					<stop offset="1" class="pi-dusk-bot"></stop>
				</linearGradient>
				<radialGradient id={`pi-glint-${uid}`}>
					<stop offset="0" class="pi-glint-in"></stop>
					<stop offset="1" class="pi-glint-out"></stop>
				</radialGradient>
				<clipPath id={clipEye}>
					<circle cx="300" cy="50" r="38"></circle>
				</clipPath>
			</defs>
			<rect x="0" y="0" width="360" height="200" fill={`url(#pi-dusk-${uid})`}></rect>
			{duskStars.map(([x, y, r]) => <circle class="pi-star" cx={x} cy={y} r={r} />)}
			<!-- the bright steady «star» -->
			<circle cx="40" cy="64" r="7" fill={`url(#pi-glint-${uid})`}></circle>
			<circle class="pi-saturn-dot" cx="40" cy="64" r="1.9"></circle>
			<!-- roofs and trees on the horizon -->
			<path class="pi-skyline" d="M0 200 V176 H22 V164 L40 152 L58 164 V176 H76 Q86 160 98 170 Q110 156 124 172 H150 V158 H176 V150 H196 V170 H240 Q252 154 266 166 Q280 152 296 168 H316 V160 L336 148 L360 160 V200 Z"></path>
			<rect class="pi-skyline-win" x="160" y="164" width="5" height="6"></rect>
			<rect class="pi-skyline-win" x="182" y="158" width="5" height="6"></rect>
			<rect class="pi-skyline-win" x="30" y="170" width="5" height="6"></rect>
			<rect class="pi-yard" x="0" y="196" width="360" height="44"></rect>
			<path class="pi-path" d="M0 222 Q120 214 240 220 T360 218 V240 H0 Z"></path>
			{grassTufts.slice(0, 14).map((t) => <path class="pi-tuft" d={`M${t.x} ${t.y} l-2 -4 M${t.x} ${t.y} l1 -5 M${t.x} ${t.y} l3 -3`} />)}
			<!-- the telescope: far tripod leg, tube, mount, near legs, slow-motion cable -->
			<g data-scope>
				<path class="pi-leg pi-leg--far" data-leg="far"></path>
				<g data-tube>
					<path class="pi-tube" data-tube-body></path>
					<path class="pi-dew" data-dew></path>
					<path class="pi-focuser" data-focuser></path>
					<path class="pi-eyepiece" data-eyepiece></path>
				</g>
				<path class="pi-mount" data-mount></path>
				<path class="pi-leg" data-leg="l"></path>
				<path class="pi-leg" data-leg="r"></path>
				<path class="pi-tray" data-tray></path>
				<path class="pi-cable" data-cable></path>
				<g data-knob>
					<circle class="pi-knob" r="2.6"></circle>
					<path class="pi-knob-tick" d="M0 0 L0 -2.4"></path>
				</g>
			</g>
			<g data-child></g>
			<g data-grownup></g>
			<!-- the view in the eyepiece -->
			<g data-view opacity="0">
				<path class="pi-view-line" data-view-line></path>
				<circle class="pi-view-rim" cx="300" cy="50" r="40"></circle>
				<circle class="pi-view-field" cx="300" cy="50" r="38"></circle>
				<g clip-path={`url(#${clipEye})`}>
					<g data-field>
						{fieldStars.map(([x, y, r]) => <circle class="pi-star" cx={300 + x} cy={50 + y} r={r} />)}
						<g data-saturn>
							<path class="pi-ring-back" d="M-12 0 A12 3.6 0 0 1 12 0 L8 0 A8 2.3 0 0 0 -8 0 Z"></path>
							<circle class="pi-globe" r="4.8"></circle>
							<path class="pi-globe-shade" d="M0 -4.8 A4.8 4.8 0 0 1 0 4.8 A2.6 4.8 0 0 0 0 -4.8 Z"></path>
							<path class="pi-ring-front" d="M-12 0 A12 3.6 0 0 0 12 0 L8 0 A8 2.3 0 0 1 -8 0 Z"></path>
						</g>
					</g>
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>В небольшой телескоп одна из ярких «звёзд» оказывается <More term="шариком с тонким кольцом">Это планета Сатурн. Она светит отражённым светом Солнца, а её кольца состоят из множества ледяных глыб и пылинок. Небо медленно поворачивается, и Сатурн уплывает к краю поля зрения — его возвращают ручкой на телескопе. Подробнее — в разделе <a href="#планеты">«Планеты»</a> и на странице <a href="/uchebnik/teleskop/">«Посмотри в телескоп»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
