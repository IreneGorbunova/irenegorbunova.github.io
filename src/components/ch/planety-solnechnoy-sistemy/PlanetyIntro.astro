		--pi-night-top: hsl(228, 55%, 7%);
		--pi-night-bot: hsl(222, 45%, 16%);
		--pi-dusk-top: hsl(226, 50%, 18%);
		--pi-dusk-mid: hsl(250, 30%, 38%);
		--pi-dusk-bot: hsl(22, 60%, 58%);
		--pi-meadow: hsl(140, 25%, 11%);
		--pi-tree: hsl(150, 25%, 7%);
		--pi-yard: hsl(110, 22%, 20%);
