		--pi-night-top: hsl(228, 50%, 12%);
		--pi-night-bot: hsl(222, 42%, 24%);
		--pi-dusk-top: hsl(222, 48%, 30%);
		--pi-dusk-mid: hsl(255, 28%, 52%);
		--pi-dusk-bot: hsl(24, 70%, 68%);
		--pi-meadow: hsl(140, 22%, 15%);
		--pi-tree: hsl(150, 22%, 10%);
