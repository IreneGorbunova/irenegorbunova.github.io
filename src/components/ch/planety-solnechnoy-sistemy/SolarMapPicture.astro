---
/**
 * The Solar System seen from above (from the north), in two panels drawn the same way; distances to scale inside each
 * panel, the Sun and the bodies are dots, NOT to scale (said in the caption).
 * «Вся система»: 1,84 px per а. е.; the orbits of the eight planets as circles with radii 0,39; 0,72; 1,00; 1,52;
 *   5,20; 9,58; 19,2; 30,1 а. е.; the Kuiper belt as dots between 30 and 50 а. е.; Pluto on an ellipse with the Sun at a
 *   focus (a = 39,5 а. е., e = 0,25: perihelion 29,6, aphelion 49,4 а. е.; longitude of perihelion 224°; its 17° tilt
 *   is not shown, it would shorten the drawing by only 4 %). The inner part (up to 6 а. е.) is a small square.
 * «Внутренняя часть»: 16,2 px per а. е.: Mercury, Venus, the Earth, Mars, the asteroid belt (dots between 2,1 and
 *   3,3 а. е.), Ceres (a = 2,77 а. е.) and the orbit of Jupiter at the edge.
 * Motion: counterclockwise as seen from the north, uniform on the circles (true periods 0,241; 0,615; 1,000; 1,881;
 *   11,86; 29,46; 84,0; 164,8 years; Ceres 4,60), Pluto by Kepler's equation (248 years). Clock: one Earth year = 5 s.
 *   Start: the mean longitudes of 1 January 2000 (Ceres: an arbitrary start). The counter shows the years passed.
 *   No speeds are printed (the worked task finds Ceres' speed).
 */
import PssStyles from './PssStyles.astro';

const BODIES = [
	{ id: 'mercury', name: 'Меркурий', a: 0.387, T: 0.241, L: 252.25, inner: true },
	{ id: 'venus', name: 'Венера', a: 0.723, T: 0.615, L: 181.98, inner: true },
	{ id: 'earth', name: 'Земля', a: 1.0, T: 1.0, L: 100.46, inner: true },
	{ id: 'mars', name: 'Марс', a: 1.524, T: 1.881, L: 355.45, inner: true },
	{ id: 'jupiter', name: 'Юпитер', a: 5.203, T: 11.86, L: 34.4, inner: true },
	{ id: 'saturn', name: 'Сатурн', a: 9.58, T: 29.46, L: 49.94, inner: false },
	{ id: 'uranus', name: 'Уран', a: 19.2, T: 84.0, L: 313.23, inner: false },
	{ id: 'neptune', name: 'Нептун', a: 30.1, T: 164.8, L: 304.88, inner: false },
	{ id: 'ceres', name: 'Церера', a: 2.77, T: 4.6, L: 150, inner: true, dwarf: true },
	{ id: 'pluto', name: 'Плутон', a: 39.5, T: 248, L: 238.93, e: 0.25, peri: 224.07, inner: false, dwarf: true },
];
const C = 100; // panel center
const K = { all: 1.84, inner: 16.2 };
const DY = 14; // the center is 14 px lower than wide: (100, 114)
const r1 = (v: number) => Math.round(v * 10) / 10;
let seed = 11;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const dots = (n: number, a0: number, a1: number, k: number) =>
	Array.from({ length: n }, () => {
		const r = (a0 + (a1 - a0) * rnd()) * k;
		const f = rnd() * 2 * Math.PI;
		return { x: r1(C + r * Math.cos(f)), y: r1(C - r * Math.sin(f)) };
	});
const kuiper = dots(170, 30, 50, K.all);
const belt = dots(150, 2.1, 3.3, K.inner);
// Pluto's ellipse, the Sun at a focus: r(ν) = a(1 − e²)/(1 + e cos ν), angle ν + ϖ (counterclockwise, y up)
const pluto = BODIES.find((b) => b.id === 'pluto')!;
const plutoPath =
	Array.from({ length: 121 }, (_, i) => {
		const nu = (i / 120) * 2 * Math.PI;
		const r = (pluto.a * (1 - 0.25 ** 2)) / (1 + 0.25 * Math.cos(nu)) * K.all;
		const ang = nu + (pluto.peri! * Math.PI) / 180;
		return `${i ? 'L' : 'M'}${r1(C + r * Math.cos(ang))} ${r1(C - r * Math.sin(ang))}`;
	}).join(' ') + ' Z';
const SQ = 6 * K.all; // half side of the «inner part» square
const panels = [
	{ id: 'all', title: 'Вся система', k: K.all, ids: ['mercury', 'venus', 'earth', 'mars', 'jupiter', 'saturn', 'uranus', 'neptune', 'pluto'], named: ['jupiter', 'saturn', 'uranus', 'neptune', 'pluto'] },
	{ id: 'inner', title: 'Внутренняя часть', k: K.inner, ids: ['mercury', 'venus', 'earth', 'mars', 'ceres', 'jupiter'], named: ['mercury', 'venus', 'earth', 'mars', 'ceres', 'jupiter'] },
];
const data = BODIES.map(({ id, name, a, T, L, e, peri }) => ({ id, name, a, T, L, e: e ?? 0, peri: peri ?? 0 }));
---

<PssStyles />
<figure class="pss pss-map not-content" data-pss-map data-bodies={JSON.stringify(data)}>
	<div class="pss-map__grid">
		{
			panels.map((p) => (
				<svg class="pss__svg" viewBox="0 0 200 222" role="img" aria-label={p.id === 'all' ? 'Вид сверху на всю Солнечную систему: орбиты восьми планет, пояс Койпера и вытянутая орбита Плутона. Четыре ближние орбиты помещаются в маленьком квадрате у Солнца' : 'Вид сверху на внутреннюю часть Солнечной системы: орбиты Меркурия, Венеры, Земли и Марса, пояс астероидов с Церерой и орбита Юпитера у края'} data-panel={p.id}>
					<text class="pss-title" x="100" y="14" text-anchor="middle">
						{p.title}
					</text>
					{p.id === 'all' && kuiper.map((d) => <circle class="pss-ice pss-map__belt" cx={d.x} cy={d.y + DY} r="0.7" />)}
					{p.id === 'inner' && belt.map((d) => <circle class="pss-rock pss-map__belt" cx={d.x} cy={d.y + DY} r="0.75" />)}
					{p.ids
						.filter((id) => id !== 'pluto' && id !== 'ceres')
						.map((id) => {
							const b = BODIES.find((q) => q.id === id)!;
							return <circle class="pss-map__orbit" cx={C} cy={C + DY} r={r1(b.a * p.k)} />;
						})}
					{p.id === 'all' && <path class="pss-map__orbit pss-map__orbit--dwarf" d={plutoPath} transform={`translate(0 ${DY})`} />}
					{p.id === 'inner' && <circle class="pss-map__orbit pss-map__orbit--dwarf" cx={C} cy={C + DY} r={r1(2.77 * p.k)} />}
					{p.id === 'all' && <rect class="pss-map__sq" x={r1(C - SQ)} y={r1(C + DY - SQ)} width={r1(2 * SQ)} height={r1(2 * SQ)} />}
					<circle class="pss-glow" cx={C} cy={C + DY} r={p.id === 'all' ? 3.5 : 4.5} />
					<circle class="pss-sun" cx={C} cy={C + DY} r={p.id === 'all' ? 1.8 : 2.6} />
					{p.ids.map((id) => (
						<g data-body={id}>
							<circle class={`pss-${id === 'ceres' ? 'rock' : id === 'pluto' ? 'ice' : id} pss-map__dot`} r={id === 'jupiter' || id === 'saturn' ? 2.8 : id === 'ceres' || id === 'pluto' ? 1.7 : p.id === 'inner' ? 2.4 : 1.4} />
							{id === 'saturn' && <path class="pss-map__ringline" d="M-4.4 0 H4.4" />}
						</g>
					))}
					{p.named.map((id) => (
						<text class="pss-map__name" data-name={id}>
							{BODIES.find((q) => q.id === id)!.name}
						</text>
					))}
					{p.id === 'all' && (
						<>
							<path class="pss-lead" d={`M${r1(C - SQ)} ${r1(C + DY - SQ)} L36 40`} />
							<text class="pss-small" x="4" y="36">
								внутренняя часть
							</text>
							<text class="pss-small" x="4" y="216">
								пояс Койпера
							</text>
							<path class="pss-lead" d="M30 209 L52 186" />
							<text class="pss-map__years" x="196" y="216" text-anchor="end" data-years>
								прошло 0,0 года
							</text>
						</>
					)}
					{p.id === 'inner' && (
						<text class="pss-small" x="4" y="216">
							пояс астероидов
						</text>
					)}
					{p.id === 'inner' && <path class="pss-lead" d="M36 209 L72 149" />}
				</svg>
			))
		}
	</div>
	<div class="pss__btns">
		<button type="button" class="pss__btn" data-pause aria-pressed="false">Пауза</button>
	</div>
	<div class="pss__foot">
		<figcaption>
			Вид сверху, с севера. Расстояния в каждой части — в масштабе, а Солнце, планеты и Церера с Плутоном нарисованы точками, не в масштабе. Время ускорено: один земной год проходит за 5&nbsp;с. Пунктир — орбиты карликовых планет.
		</figcaption>
	</div>
</figure>

<style is:global>
	.pss-map__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.pss-map__orbit {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.7;
	}
	.pss-map__orbit--dwarf {
		stroke-dasharray: 2.5 2;
	}
	.pss-map__sq {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.7;
	}
	.pss-map__ringline {
		stroke: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-2));
		stroke-width: 0.9;
	}
	.pss-map .pss-map__name {
		font-size: 9.5px;
	}
	.pss-map .pss-map__years {
		font-size: 10px;
		fill: var(--sl-color-gray-1);
	}
	.pss-map .pss-title {
		font-size: 11.5px;
	}
	.pss-map .pss-small {
		font-size: 9px;
	}
	@media (max-width: 40rem) {
		.pss-map__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { loop } from '@components/ch/g7/kit';

	type B = { id: string; name: string; a: number; T: number; L: number; e: number; peri: number };
	const YEAR = 5; // s per Earth year
	const C = 100;
	const CY = 114;
	const K: Record<string, number> = { all: 1.84, inner: 16.2 };
	const years = (n: number) => {
		const m10 = n % 10;
		const m100 = n % 100;
		const w = m10 === 1 && m100 !== 11 ? 'год' : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? 'года' : 'лет';
		return `прошло ${n} ${w}`;
	};
	// position in а. е., x to the right, y up
	const pos = (b: B, t: number) => {
		const D = Math.PI / 180;
		if (!b.e) {
			const f = b.L * D + (2 * Math.PI * t) / b.T;
			return { x: b.a * Math.cos(f), y: b.a * Math.sin(f) };
		}
		// Kepler's equation M = E − e sin E
		const M = (b.L - b.peri) * D + (2 * Math.PI * t) / b.T;
		let E = M;
		for (let i = 0; i < 6; i++) E = E - (E - b.e * Math.sin(E) - M) / (1 - b.e * Math.cos(E));
		const xp = b.a * (Math.cos(E) - b.e);
		const yp = b.a * Math.sqrt(1 - b.e * b.e) * Math.sin(E);
		const w = b.peri * D;
		return { x: xp * Math.cos(w) - yp * Math.sin(w), y: xp * Math.sin(w) + yp * Math.cos(w) };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-pss-map]')) {
		const bodies = JSON.parse(root.dataset.bodies!) as B[];
		const byId = Object.fromEntries(bodies.map((b) => [b.id, b]));
		const panels = [...root.querySelectorAll<SVGSVGElement>('[data-panel]')].map((svg) => ({
			k: K[svg.dataset.panel!],
			dots: [...svg.querySelectorAll<SVGGElement>('[data-body]')].map((g) => ({ g, b: byId[g.dataset.body!] })),
			names: [...svg.querySelectorAll<SVGTextElement>('[data-name]')].map((t) => ({ t, b: byId[t.dataset.name!], w: 0 })),
			// fixed things a name must not cover: the Sun, the legends at the bottom, «внутренняя часть» and its square
			fixed:
				svg.dataset.panel === 'all'
					? [[C - 4, CY - 4, C + 4, CY + 4], [2, 27, 76, 39], [C - 11.5, CY - 11.5, C + 11.5, CY + 11.5], [2, 207, 64, 219], [120, 205, 198, 219]]
					: [[C - 5, CY - 5, C + 5, CY + 5], [2, 207, 82, 219]],
		}));
		const measure = () => {
			for (const p of panels) for (const n of p.names) n.w = (n.t.getComputedTextLength() || n.b.name.length * 5.4) + 1;
		};
		const counter = root.querySelector<SVGTextElement>('[data-years]')!;
		const btn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
		let t = 0; // years
		let paused = false;
		const draw = () => {
			for (const p of panels) {
				for (const { g, b } of p.dots) {
					const q = pos(b, t);
					g.setAttribute('transform', `translate(${(C + q.x * p.k).toFixed(1)} ${(CY - q.y * p.k).toFixed(1)})`);
				}
				// Names beside their dots. Candidates: outward along the radius, then turned around the dot, nearer and
				// farther; the first one that covers no body, no other name and no fixed label wins.
				const obst: number[][] = [...p.fixed];
				for (const { g, b } of p.dots) {
					const q = pos(b, t);
					const x = C + q.x * p.k;
					const y = CY - q.y * p.k;
					const rr = (b.id === 'jupiter' || b.id === 'saturn' ? 2.8 : 2.4) + 1.2;
					obst.push(b.id === 'saturn' ? [x - 5.6, y - rr, x + 5.6, y + rr] : [x - rr, y - rr, x + rr, y + rr]);
				}
				for (const n of p.names) {
					const q = pos(n.b, t);
					const d = Math.hypot(q.x, q.y);
					const px = C + q.x * p.k;
					const py = CY - q.y * p.k;
					const base = Math.atan2(-q.y, q.x); // screen angle of the outward radius
					const w = n.w;
					// the candidate that covers the least (zero: nothing); boxes padded by 1 px
					let best: { x: number; y: number; anchor: string; box: number[] } | null = null;
					let bestCost = Infinity;
					const over = (a: number[], o: number[]) => Math.max(0, Math.min(a[2], o[2]) - Math.max(a[0], o[0]) + 2) * Math.max(0, Math.min(a[3], o[3]) - Math.max(a[1], o[1]) + 2);
					search: for (const off of [6, 10, 15, 21, 28]) {
						for (let j = 0; j < 16; j++) {
							const da = j === 0 ? 0 : (j % 2 ? 1 : -1) * Math.ceil(j / 2) * (Math.PI / 8);
							const a = base + da;
							const cx = px + Math.cos(a) * off;
							const cy = py + Math.sin(a) * off;
							const anchor = Math.cos(a) > 0.4 ? 'start' : Math.cos(a) < -0.4 ? 'end' : 'middle';
							// the box hangs from the anchor point: left/right of it, or centered; above or below the dot
							let x0 = anchor === 'start' ? cx : anchor === 'end' ? cx - w : cx - w / 2;
							const yb = Math.sin(a) > 0.4 ? cy + 8 : Math.sin(a) < -0.4 ? cy : cy + 3.5;
							const shift = Math.min(0, 198 - (x0 + w)) + Math.max(0, 2 - x0);
							x0 += shift;
							const box = [x0, yb - 8.5, x0 + w, yb + 2.5];
							const cand = { x: anchor === 'start' ? x0 : anchor === 'end' ? x0 + w : x0 + w / 2, y: yb, anchor, box };
							let cost = (box[1] < 19 ? 1e4 : 0) + (box[3] > 220 ? 1e4 : 0) + off * 0.01;
							for (const o of obst) cost += over(box, o);
							if (cost < bestCost) {
								bestCost = cost;
								best = cand;
							}
							if (cost < 1) break search;
						}
					}
					const c = best!;
					obst.push(c.box);
					n.t.setAttribute('x', c.x.toFixed(1));
					n.t.setAttribute('y', c.y.toFixed(1));
					n.t.setAttribute('text-anchor', c.anchor);
					void d;
				}
			}
			const s = t < 10 ? `прошло ${(Math.floor(t * 10) / 10).toFixed(1).replace('.', ',')} года` : years(Math.floor(t));
			if (counter.textContent !== s) counter.textContent = s;
		};
		btn.addEventListener('click', () => {
			paused = !paused;
			btn.setAttribute('aria-pressed', String(paused));
			btn.textContent = paused ? 'Дальше' : 'Пауза';
			if (!paused) wake();
		});
		// for the label check script: jump to a moment (years)
		(root as unknown as { __pssT: (v: number) => void }).__pssT = (v: number) => {
			t = v;
			draw();
		};
		const wake = loop(root, (dt) => {
			if (paused) return false;
			t += dt / YEAR;
			if (t > 248) t = 0; // after one revolution of Pluto, start again
			draw();
			return true;
		});
		measure();
		draw();
		document.fonts?.ready.then(() => {
			measure();
			draw();
		});
	}
</script>
