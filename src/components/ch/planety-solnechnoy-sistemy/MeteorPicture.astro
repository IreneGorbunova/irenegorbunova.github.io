---
/**
 * Picture to the definitions of a meteoroid, a meteor and a meteorite: three panels joined by arrows; a 9-s loop
 * lights them one after another (3 s each); each panel keeps its end state while the others play.
 * 1 «Метеорное тело»: a small stone tumbling in space toward the Earth (the limb with its thin blue air on the right).
 * 2 «Метеор»: night over the countryside; the stone enters the air at 11–72 км/с and flashes as a short streak at a
 *   height of about 100 км (slowed: 1,4 s instead of 0,1–1 s; a faint trail stays until the next streak) (most meteoroids burn out between 120 and 80 км). The height bar is not to scale with the
 *   trees and houses (said in the caption).
 * 3 «Метеорит»: only bodies larger than about a fist survive; the air slows them to a few hundred metres per second,
 *   they stop glowing well above the ground and fall dark. The stone drops into the snow (a puff), lies in a small
 *   pit with its dark melted crust; it is cold inside when it lands.
 * Colors of the scenes are fixed (night and daylight pictures look the same in both themes).
 */
import PssStyles from './PssStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
let seed = 3;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const stars1 = Array.from({ length: 34 }, () => ({ x: Math.round(rnd() * 1600) / 10, y: Math.round(rnd() * 1400) / 10, r: rnd() < 0.2 ? 0.8 : 0.45 }));
const stars2 = Array.from({ length: 30 }, () => ({ x: Math.round(rnd() * 1600) / 10, y: Math.round(rnd() * 1000) / 10, r: rnd() < 0.2 ? 0.8 : 0.45 }));
const stone = 'M-5 -2 L-2 -5 L3 -4.5 L5.5 -1 L4.5 3.5 L0 5 L-4 3.5 Z';
---

<PssStyles />
<figure class="pss pmt not-content" data-pmt>
	<div class="pmt__row">
		<div class="pmt__cell" data-cell="0">
			<svg class="pmt__svg" viewBox="0 0 160 140" role="img" aria-label="Метеорное тело: маленький камень летит в космосе к Земле">
				<rect class="pmt-space" width="160" height="140"></rect>
				{stars1.map((s) => <circle class="pmt-star" cx={s.x} cy={s.y} r={s.r} />)}
				<circle class="pmt-air" cx="230" cy="190" r="128"></circle>
				<circle class="pmt-earth" cx="230" cy="190" r="122"></circle>
				<ellipse class="pmt-cloud" cx="134" cy="104" rx="11" ry="3"></ellipse>
				<ellipse class="pmt-cloud" cx="146" cy="121" rx="8" ry="2.5"></ellipse>
				<g data-stone1><path class="pmt-rock" d={stone}></path><path class="pmt-rock-hi" d="M-3 -3 L1 -4 L-1 -1 Z"></path></g>
				<text class="pmt-title" x="8" y="16">Метеорное тело</text>
				<text class="pmt-t" x="8" y="132">Земля и её воздух →</text>
			</svg>
		</div>
		<div class="pmt__arrow" aria-hidden="true"><span class="pmt__h">→</span><span class="pmt__v">↓</span></div>
		<div class="pmt__cell" data-cell="1">
			<svg class="pmt__svg" viewBox="0 0 160 140" role="img" aria-label="Метеор: ночью над сельской местностью на высоте около ста километров вспыхивает короткая светящаяся черта">
				<defs>
					<linearGradient id={`pmt-night-${uid}`} x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" class="pmt-night-top"></stop>
						<stop offset="1" class="pmt-night-bot"></stop>
					</linearGradient>
					<linearGradient id={`pmt-streak-${uid}`} gradientUnits="userSpaceOnUse" data-sgrad>
						<stop offset="0" class="pmt-streak-tail"></stop>
						<stop offset="1" class="pmt-streak-head"></stop>
					</linearGradient>
				</defs>
				<rect width="160" height="140" fill={`url(#pmt-night-${uid})`}></rect>
				{stars2.map((s) => <circle class="pmt-star" cx={s.x} cy={s.y} r={s.r} />)}
				<line class="pmt-train" x1="150" y1="22" x2="78" y2="40" opacity="0" data-train></line>
				<line stroke={`url(#pmt-streak-${uid})`} stroke-width="1.6" stroke-linecap="round" data-streak></line>
				<circle class="pmt-head" r="1.4" data-shead></circle>
				<path class="pmt-ground" d="M0 140 V114 Q30 104 60 112 Q96 102 124 110 Q144 106 160 110 V140 Z"></path>
				<path class="pmt-tree" d="M70 112 l5 -16 l5 16 Z M80 110 l4 -12 l4 12 Z M118 110 l4 -13 l4 13 Z"></path>
				<path class="pmt-house" d="M98 110 V102 L104 97 L110 102 V110 Z"></path>
				<rect class="pmt-win" x="102" y="104" width="3" height="3"></rect>
				<path class="pmt-bar" d="M14 112 V34 M10 34 H18 M10 112 H18"></path>
				<text class="pmt-t" x="21" y="37">около 100 км</text>
				<text class="pmt-t" x="21" y="110">0</text>
				<text class="pmt-title" x="8" y="16">Метеор</text>
			</svg>
		</div>
		<div class="pmt__arrow" aria-hidden="true"><span class="pmt__h">→</span><span class="pmt__v">↓</span></div>
		<div class="pmt__cell" data-cell="2">
			<svg class="pmt__svg" viewBox="0 0 160 140" role="img" aria-label="Метеорит: тёмный камень с оплавленной коркой упал в снег и лежит в маленькой ямке">
				<rect class="pmt-day" width="160" height="140"></rect>
				<path class="pmt-forest" d="M0 82 l6 -14 l6 14 l5 -18 l6 18 l6 -12 l5 12 l7 -20 l6 20 l5 -14 l6 14 h100 l5 -16 l5 16 l6 -12 l5 12 V92 H0 Z"></path>
				<path class="pmt-snow" d="M0 140 V86 Q60 80 160 86 V140 Z"></path>
				<ellipse class="pmt-pit" cx="84" cy="114" rx="20" ry="5.5" data-landed></ellipse>
				<g data-stone3><path class="pmt-crust" d="M-9 2 L-7 -6 L-1 -9 L6 -7 L10 -1 L8 5 L0 7 L-6 6 Z"></path><path class="pmt-crust-hi" d="M-6 -4 L-1 -7 L3 -6 L-2 -4 Z"></path></g>
				<g data-puff opacity="0">
					<circle class="pmt-puff" cx="76" cy="108" r="4"></circle>
					<circle class="pmt-puff" cx="92" cy="107" r="3.5"></circle>
					<circle class="pmt-puff" cx="84" cy="104" r="4.5"></circle>
				</g>
				<g data-landed><path class="pmt-lead" d="M84 98 V102.5"></path>
				<text class="pmt-t pmt-t--dark" x="84" y="95" text-anchor="middle">оплавленная корка</text></g>
				<text class="pmt-title pmt-title--dark" x="8" y="16">Метеорит</text>
			</svg>
		</div>
	</div>
	<div class="pss__foot">
		<figcaption>Шкала высоты в средней картинке не в масштабе с деревьями и домами: 100&nbsp;км — это в десять раз выше самолётов.</figcaption>
	</div>
</figure>

<style is:global>
	.pmt__row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 0.3rem;
	}
	.pmt__cell {
		border: 2px solid transparent;
		border-radius: 0.7rem;
		transition: border-color 0.3s;
	}
	.pmt__cell.is-on {
		border-color: var(--sl-color-accent);
	}
	.pmt__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.55rem;
	}
	.pmt__arrow {
		color: var(--sl-color-gray-3);
		font-size: 1.3rem;
		text-align: center;
	}
	.pmt__v {
		display: none;
	}
	@media (max-width: 40rem) {
		.pmt__row {
			grid-template-columns: minmax(0, 1fr);
			max-width: 17rem;
			margin-inline: auto;
		}
		.pmt__h {
			display: none;
		}
		.pmt__v {
			display: inline;
		}
	}
	.pmt-space {
		fill: hsl(230, 40%, 6%);
	}
	.pmt-star {
		fill: hsl(220, 30%, 90%);
		opacity: 0.8;
	}
	.pmt-air {
		fill: hsl(205, 90%, 70%);
		opacity: 0.35;
	}
	.pmt-earth {
		fill: hsl(210, 60%, 38%);
	}
	.pmt-cloud {
		fill: hsl(0, 0%, 95%);
		opacity: 0.55;
	}
	.pmt-rock {
		fill: hsl(25, 10%, 45%);
		stroke: hsl(25, 10%, 65%);
		stroke-width: 0.5;
	}
	.pmt-rock-hi {
		fill: hsl(30, 15%, 65%);
	}
	.pmt-night-top {
		stop-color: hsl(228, 50%, 8%);
	}
	.pmt-night-bot {
		stop-color: hsl(222, 40%, 20%);
	}
	.pmt-streak-tail {
		stop-color: hsl(200, 80%, 92%);
		stop-opacity: 0;
	}
	.pmt-streak-head {
		stop-color: #fff;
		stop-opacity: 1;
	}
	.pmt-head {
		fill: #fff;
	}
	.pmt-ground {
		fill: hsl(140, 20%, 9%);
	}
	.pmt-tree {
		fill: hsl(150, 25%, 6%);
	}
	.pmt-house {
		fill: hsl(25, 15%, 12%);
	}
	.pmt-win {
		fill: hsl(45, 95%, 65%);
	}
	.pmt-bar {
		stroke: hsl(45, 90%, 70%);
		stroke-width: 1;
		fill: none;
	}
	.pmt-day {
		fill: hsl(205, 70%, 82%);
	}
	.pmt-forest {
		fill: hsl(160, 25%, 28%);
	}
	.pmt-snow {
		fill: hsl(210, 40%, 96%);
	}
	.pmt-pit {
		fill: hsl(210, 25%, 80%);
	}
	.pmt-crust {
		fill: hsl(20, 10%, 12%);
		stroke: hsl(20, 10%, 30%);
		stroke-width: 0.6;
	}
	.pmt-crust-hi {
		fill: hsl(20, 10%, 40%);
	}
	.pmt-puff {
		fill: hsl(210, 40%, 98%);
		stroke: hsl(210, 25%, 82%);
		stroke-width: 0.6;
	}
	.pmt-train {
		stroke: hsl(170, 60%, 78%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.pmt-lead {
		stroke: hsl(220, 20%, 30%);
		stroke-width: 0.7;
		fill: none;
	}
	.pmt text {
		font-family: var(--__sl-font);
		paint-order: stroke fill;
		stroke-linejoin: round;
	}
	.pmt .pmt-title {
		font-size: 12px;
		font-weight: 700;
		fill: hsl(220, 25%, 94%);
		stroke: hsl(230, 40%, 8%);
		stroke-width: 2.5px;
	}
	.pmt .pmt-t {
		font-size: 9.5px;
		fill: hsl(220, 25%, 90%);
		stroke: hsl(230, 40%, 8%);
		stroke-width: 2.5px;
	}
	.pmt .pmt-title--dark,
	.pmt .pmt-t--dark {
		fill: hsl(222, 35%, 16%);
		stroke: hsl(205, 70%, 92%);
	}
</style>

<script>
	import { loop } from '@components/ch/g7/kit';

	const f = (v: number) => v.toFixed(1);
	const seg = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
	for (const root of document.querySelectorAll<HTMLElement>('[data-pmt]')) {
		const cells = [...root.querySelectorAll<HTMLElement>('[data-cell]')];
		const stone1 = root.querySelector<SVGGElement>('[data-stone1]')!;
		const streak = root.querySelector<SVGLineElement>('[data-streak]')!;
		const sgrad = root.querySelector<SVGLinearGradientElement>('[data-sgrad]')!;
		const shead = root.querySelector<SVGCircleElement>('[data-shead]')!;
		const stone3 = root.querySelector<SVGGElement>('[data-stone3]')!;
		const puff = root.querySelector<SVGGElement>('[data-puff]')!;
		const landed = [...root.querySelectorAll<SVGElement>('[data-landed]')];
		const train = root.querySelector<SVGLineElement>('[data-train]')!;
		let t = 0;
		// Each panel plays in its own 3 s and then keeps its end state while the others play.
		const draw = () => {
			const T = t % 9;
			cells.forEach((c, i) => c.classList.toggle('is-on', Math.floor(T / 3) === i));
			// 1: 0–3 s the stone drifts toward the Earth, tumbling; then it waits near the air
			const u1 = Math.min(T, 3) / 3;
			stone1.setAttribute('transform', `translate(${f(18 + 80 * u1)} ${f(40 + 46 * u1)}) rotate(${f(Math.min(T, 3) * 70)})`);
			// 2: 3,2–4,6 s the streak (slowed: a real one lasts 0,1–1 s), then a faint trail stays along the path
			const k = seg(T, 3.2, 4.6);
			const on = k > 0 && k < 1;
			const p0 = { x: 150, y: 22 };
			const p1 = { x: 78, y: 40 };
			const hx = p0.x + (p1.x - p0.x) * k;
			const hy = p0.y + (p1.y - p0.y) * k;
			const tl = Math.min(0.5, k);
			const tx = hx - (p1.x - p0.x) * tl;
			const ty = hy - (p1.y - p0.y) * tl;
			const a = on ? Math.min(1, k * 6) * (k > 0.8 ? (1 - k) / 0.2 : 1) : 0;
			for (const e of [streak, sgrad]) {
				e.setAttribute('x1', f(tx));
				e.setAttribute('y1', f(ty));
				e.setAttribute('x2', f(hx));
				e.setAttribute('y2', f(hy));
			}
			streak.setAttribute('opacity', a.toFixed(2));
			shead.setAttribute('cx', f(hx));
			shead.setAttribute('cy', f(hy));
			shead.setAttribute('opacity', a.toFixed(2));
			// the trail: grows behind the head, glows, fades to a faint line kept until the next streak (gone by 3,2 s)
			const tr = T < 3.0 ? 0.25 : T < 3.2 ? 0.25 * (1 - (T - 3.0) / 0.2) : T < 4.6 ? 0.55 * k : 0.55 - 0.3 * seg(T, 4.6, 6);
			train.setAttribute('x2', f(T >= 3.2 && T < 4.6 ? hx : p1.x));
			train.setAttribute('y2', f(T >= 3.2 && T < 4.6 ? hy : p1.y));
			train.setAttribute('opacity', tr.toFixed(2));
			// 3: the meteorite lies in its pit all the time, except 6–6,7 s: it fades out (0,25 s), a new one falls
			// in 6,3–6,6 s, a puff of snow, and it lies again
			const out = seg(T, 6.0, 6.25);
			const falling = T >= 6.25 && T < 6.6;
			const d = seg(T, 6.3, 6.6);
			const lying = !(T >= 6.0 && T < 6.6);
			stone3.setAttribute('opacity', T >= 6.0 && T < 6.25 ? (1 - out).toFixed(2) : falling && T < 6.3 ? '0' : '1');
			for (const e of landed) e.setAttribute('opacity', lying ? '1' : T < 6.25 ? (1 - out).toFixed(2) : '0');
			const y = lying || T < 6.25 ? 110 : -10 + 120 * d;
			stone3.setAttribute('transform', `translate(84 ${f(y)}) rotate(${lying || T < 6.25 ? -8 : f(-8 + 200 * (1 - d))})`);
			const pf = seg(T, 6.6, 7.8);
			puff.setAttribute('opacity', (T >= 6.6 && pf < 1 ? 1 - pf : 0).toFixed(2));
			puff.setAttribute('transform', `translate(84 108) scale(${f(1 + pf)}) translate(-84 -108)`);
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
