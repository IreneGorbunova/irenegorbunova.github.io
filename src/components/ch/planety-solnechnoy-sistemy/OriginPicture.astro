---
/**
 * The origin of the Solar System in four stages side by side (2 × 2 on a phone), each a small looping animation; the
 * stages are not to time scale and the sizes are not to scale (said in the caption).
 * 1 «Облако»: a cold irregular cloud of gas and dust about 4,6 млрд лет назад, turning slowly (one turn in 40 s).
 * 2 «Диск»: the cloud has contracted (in some 10⁵ years), turns faster and has flattened into a disk, seen a little from
 *   above (the disk squeezed to 0,32 of its width); a warm glow in the middle — the future Sun.
 * 3 «Зародыши планет»: the young Sun shines; dust grains stick into clumps. Inside the snow line (today between Mars
 *   and Jupiter, about 3 а. е.) it is too warm for ice: the grains are rock and metal (brown-gray); outside they are
 *   also ice (white-blue). The gas disk lives a few million years.
 * 4 «Планеты» (seen a little more from above, squeeze 0,42): four small rocky planets inside; four giants outside, which gathered gas around their icy-rocky cores;
 *   the leftovers: the asteroid belt and small bodies far out. The rocky planets grew in tens of millions of years.
 * Everything turns the same way: counterclockwise seen from the north (the near side of each disk moves to the right).
 * Angular speeds grow inward as r^(−3/2) (Kepler), slowed down enormously.
 */
import PssStyles from './PssStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);

const stages = [
	{ n: 1, title: 'Облако', aria: 'Холодное клочковатое облако газа и пыли медленно вращается' },
	{ n: 2, title: 'Диск', aria: 'Облако сжалось в плоский вращающийся диск, в середине тёплое свечение' },
	{ n: 3, title: 'Зародыши планет', aria: 'Молодое Солнце светит; в диске пылинки слипаются в комки; внутри снеговой линии они каменные, снаружи — ещё и ледяные' },
	{ n: 4, title: 'Планеты', aria: 'Вокруг Солнца в одну сторону обращаются четыре маленькие каменные планеты и четыре гиганта, между ними пояс мелких тел' },
];
---

<PssStyles />
<figure class="pss por not-content" data-por>
	<div class="por__grid">
		{
			stages.map((s) => (
				<svg class="por__svg" viewBox="0 0 160 150" role="img" aria-label={`${s.n}. ${s.title}. ${s.aria}`} data-stage={s.n}>
					<defs>
						<filter id={`por-blur-${uid}-${s.n}`} x="-30%" y="-30%" width="160%" height="160%">
							<feGaussianBlur stdDeviation="5" />
						</filter>
					</defs>
					<rect class="por-space" width="160" height="150" />
					<g data-gas filter={`url(#por-blur-${uid}-${s.n})`} />
					<g data-back />
					<g data-sun />
					<g data-front />
					<g data-labels />
					<text class="por-title" x="8" y="16">
						{s.n}. {s.title}
					</text>
				</svg>
			))
		}
	</div>
	<div class="pss__foot">
		<figcaption>Стадии не в масштабе времени: облако сжалось в диск за сотни тысяч лет, газ в диске продержался несколько миллионов лет, а каменные планеты росли десятки миллионов лет. Размеры тел тоже не в масштабе.</figcaption>
	</div>
</figure>

<style is:global>
	.por__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
	}
	@media (max-width: 50rem) {
		.por__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.por__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.55rem;
	}
	.por-space {
		fill: hsl(230, 40%, 6%);
	}
	.por text {
		font-family: var(--__sl-font);
		paint-order: stroke fill;
		stroke: hsl(230, 40%, 6%);
		stroke-width: 2.5px;
		stroke-linejoin: round;
	}
	.por .por-title {
		font-size: 12px;
		font-weight: 700;
		fill: hsl(220, 25%, 94%);
	}
	.por .por-t {
		font-size: 9.5px;
		fill: hsl(220, 25%, 88%);
	}
	.por-gas {
		fill: hsl(225, 35%, 62%);
		opacity: 0.22;
	}
	.por-dust {
		fill: hsl(25, 25%, 55%);
	}
	.por-rock {
		fill: hsl(25, 30%, 52%);
	}
	.por-ice {
		fill: hsl(200, 60%, 85%);
	}
	.por-snowline {
		fill: none;
		stroke: hsl(200, 70%, 80%);
		stroke-width: 0.8;
		stroke-dasharray: 3 2;
	}
	.por-orbit {
		fill: none;
		stroke: hsl(220, 20%, 40%);
		stroke-width: 0.6;
	}
	.por-arrow {
		fill: hsl(220, 20%, 70%);
	}
	.por-lead {
		stroke: hsl(220, 20%, 70%);
		stroke-width: 0.6;
		fill: none;
	}
	.por-proto {
		fill: hsl(25, 90%, 55%);
	}
	.por-sun {
		fill: hsl(48, 100%, 70%);
	}
	.por-glow {
		fill: hsl(45, 100%, 60%);
	}
	.por-earthlike {
		fill: hsl(205, 60%, 60%);
	}
	.por-mars {
		fill: hsl(10, 60%, 55%);
	}
	.por-jup {
		fill: hsl(35, 45%, 68%);
	}
	.por-sat {
		fill: hsl(45, 50%, 72%);
	}
	.por-ura {
		fill: hsl(185, 40%, 70%);
	}
	.por-nep {
		fill: hsl(215, 60%, 60%);
	}
</style>

<script>
	import { loop, rng } from '@components/ch/g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e as SVGElement;
	};
	const f = (v: number) => v.toFixed(1);
	const CX = 80;
	const CY = 84;
	const FL = 0.32; // the disk seen a little from above
	// angular speed (rad/s) at radius r (px): Kepler, ω ∝ r^(−3/2), slowed so that r = 40 px turns in 16 s
	const om = (r: number) => ((2 * Math.PI) / 16) * Math.pow(40 / r, 1.5);

	type Body = { r: number; a: number; w: number; e: SVGElement; size: number; depth?: boolean };
	for (const root of document.querySelectorAll<HTMLElement>('[data-por]')) {
		const R = rng(42);
		const svgs = [...root.querySelectorAll<SVGSVGElement>('[data-stage]')];
		const parts = svgs.map((s) => ({
			back: s.querySelector<SVGGElement>('[data-back]')!,
			sun: s.querySelector<SVGGElement>('[data-sun]')!,
			front: s.querySelector<SVGGElement>('[data-front]')!,
			labels: s.querySelector<SVGGElement>('[data-labels]')!,
			gas: s.querySelector<SVGGElement>('[data-gas]')!,
		}));

		// ---- 1: the cloud, clumpy, turning as a whole
		const cloud = mk(parts[0].back, 'g', {});
		const cloudGas = mk(parts[0].gas, 'g', {});
		const lumps = [
			[0, 0, 34],
			[-22, -10, 18],
			[20, 12, 20],
			[8, -20, 14],
			[-12, 20, 16],
		];
		for (const [x, y, s] of lumps) mk(cloudGas, 'ellipse', { class: 'por-gas', cx: CX + x, cy: CY - 4 + y, rx: s * 1.4, ry: s * 1.1 });
		for (let i = 0; i < 260; i++) {
			const l = lumps[Math.floor(R() * lumps.length)];
			const g = () => (R() + R() + R() - 1.5) / 1.5;
			mk(cloud, 'circle', { class: 'por-dust', cx: f(CX + l[0] + g() * l[2] * 1.6), cy: f(CY - 4 + l[1] + g() * l[2] * 1.3), r: f(0.4 + R() * 0.5), opacity: f(0.35 + R() * 0.5) });
		}

		// ---- disks: dots on circles, projected
		const disk = (k: number, n: number, r0: number, r1: number, cls: (r: number) => string, size: () => number, depth = false) => {
			const out: Body[] = [];
			for (let i = 0; i < n; i++) {
				const r = r0 + (r1 - r0) * Math.sqrt(R());
				const s = size();
				const e = mk(parts[k].back, 'circle', { class: cls(r), r: f(s), opacity: f(0.5 + R() * 0.5) });
				out.push({ r, a: R() * 2 * Math.PI, w: om(r), e, size: s, depth });
			}
			return out;
		};
		// 2: the disk around the warm center
		const d2 = disk(1, 300, 8, 64, () => 'por-dust', () => 0.4 + R() * 0.5);
		mk(parts[1].gas, 'ellipse', { class: 'por-gas', cx: CX, cy: CY, rx: 66, ry: 66 * FL + 2 });
		const glow2 = mk(parts[1].sun, 'circle', { class: 'por-glow', cx: CX, cy: CY, r: 12, opacity: 0.25 });
		mk(parts[1].sun, 'circle', { class: 'por-proto', cx: CX, cy: CY, r: 4.5 });
		// 3: rock inside the snow line, ice outside, with clumps
		const SNOW = 30;
		const d3 = [
			...disk(2, 230, 9, 66, (r) => (r < SNOW ? 'por-rock' : 'por-ice'), () => 0.4 + R() * 0.45),
			...disk(2, 14, 12, 64, (r) => (r < SNOW ? 'por-rock' : 'por-ice'), () => 1.2 + R() * 1.2, true),
		];
		mk(parts[2].gas, 'ellipse', { class: 'por-gas', cx: CX, cy: CY, rx: 66, ry: 66 * FL + 2 });
		mk(parts[2].back, 'ellipse', { class: 'por-snowline', cx: CX, cy: CY, rx: SNOW, ry: SNOW * FL });
		mk(parts[2].sun, 'circle', { class: 'por-glow', cx: CX, cy: CY, r: 13, opacity: 0.3 });
		mk(parts[2].sun, 'circle', { class: 'por-sun', cx: CX, cy: CY, r: 5 });
		mk(parts[2].labels, 'path', { class: 'por-lead', d: `M${f(CX + SNOW * 0.7)} ${f(CY - SNOW * FL * 0.72)} L${CX + 30} ${CY - 36}` });
		mk(parts[2].labels, 'text', { class: 'por-t', x: 154, y: CY - 39, 'text-anchor': 'end' }).textContent = 'снеговая линия';
		mk(parts[2].labels, 'path', { class: 'por-lead', d: `M${CX - 20} ${CY + 4} L${CX - 40} ${CY + 42}` });
		mk(parts[2].labels, 'text', { class: 'por-t', x: 6, y: CY + 52 }).textContent = 'камень';
		mk(parts[2].labels, 'path', { class: 'por-lead', d: `M${CX + 50} ${CY + 9} L${CX + 52} ${CY + 42}` });
		mk(parts[2].labels, 'text', { class: 'por-t', x: 154, y: CY + 52, 'text-anchor': 'end' }).textContent = 'камень и лёд';
		// 4: the planets
		const P4: [number, number, string][] = [
			[12, 1.3, 'por-rock'],
			[17, 1.7, 'por-earthlike'],
			[22, 1.8, 'por-earthlike'],
			[27, 1.4, 'por-mars'],
			[42, 4.2, 'por-jup'],
			[52, 3.6, 'por-sat'],
			[61, 2.6, 'por-ura'],
			[70, 2.5, 'por-nep'],
		];
		const FL4 = 0.42; // panel 4 is seen a little more from above, so the inner orbits clear the Sun
		for (const [r] of P4) mk(parts[3].back, 'ellipse', { class: 'por-orbit', cx: CX, cy: CY, rx: r, ry: f(r * FL4) });
		// arrows on the near side of the outer orbit: counterclockwise from the north = to the right in front
		for (const r of [27, 70]) mk(parts[3].back, 'path', { class: 'por-arrow', d: `M${f(CX + 3)} ${f(CY + r * FL4 - 2.2)} L${f(CX + 7)} ${f(CY + r * FL4)} L${f(CX + 3)} ${f(CY + r * FL4 + 2.2)} Z` });
		const d4belt = disk(3, 60, 32, 37, () => 'por-rock', () => 0.4 + R() * 0.3);
		const d4far = disk(3, 40, 74, 90, () => 'por-ice', () => 0.4 + R() * 0.3);
		const d4: Body[] = P4.map(([r, s, cls]) => ({ r, a: R() * 2 * Math.PI, w: om(r), size: s, depth: true, e: mk(parts[3].back, 'circle', { class: cls, r: s }) }));
		const sat = d4[5];
		const satRing = mk(parts[3].back, 'ellipse', { class: 'por-sat', rx: 6.5, ry: 1.6, opacity: 0.7, fill: 'none', stroke: 'hsl(45, 50%, 72%)', 'stroke-width': 0.8 });
		mk(parts[3].sun, 'circle', { class: 'por-glow', cx: CX, cy: CY, r: 6, opacity: 0.3 });
		mk(parts[3].sun, 'circle', { class: 'por-sun', cx: CX, cy: CY, r: 3.4 });
		// leaders to the orbits: the inner ones (Mars's orbit, lower left) and the outer ones (Neptune's, upper right)
		const onOrbit = (r: number, deg: number) => ({ x: CX + r * Math.cos((deg * Math.PI) / 180), y: CY - r * FL4 * Math.sin((deg * Math.PI) / 180) });
		const pIn = onOrbit(27, 235);
		const pOut = onOrbit(70, 40);
		mk(parts[3].labels, 'path', { class: 'por-lead', d: `M${f(pIn.x)} ${f(pIn.y)} L40 129` });
		mk(parts[3].labels, 'text', { class: 'por-t', x: 6, y: 138 }).textContent = 'каменные — внутри';
		mk(parts[3].labels, 'path', { class: 'por-lead', d: `M${f(pOut.x)} ${f(pOut.y)} L132 47` });
		mk(parts[3].labels, 'text', { class: 'por-t', x: 154, y: 44, 'text-anchor': 'end' }).textContent = 'гиганты — снаружи';

		let t = 0;
		const place = (k: number, list: Body[], fl = FL) => {
			for (const b of list) {
				const a = b.a + b.w * t;
				const x = CX + b.r * Math.cos(a);
				const y = CY - b.r * fl * Math.sin(a);
				b.e.setAttribute('cx', f(x));
				b.e.setAttribute('cy', f(y));
				if (b.depth) {
					const g = Math.sin(a) > 0 ? parts[k].back : parts[k].front;
					if (b.e.parentNode !== g) g.append(b.e);
				}
			}
		};
		const draw = () => {
			cloud.setAttribute('transform', `rotate(${f((-t * 360) / 40)} ${CX} ${CY - 4})`);
			cloudGas.setAttribute('transform', `rotate(${f((-t * 360) / 40)} ${CX} ${CY - 4})`);
			place(1, d2);
			glow2.setAttribute('opacity', f(0.22 + 0.06 * Math.sin(t * 1.3)));
			place(2, d3);
			place(3, [...d4belt, ...d4far, ...d4], FL4);
			satRing.setAttribute('cx', sat.e.getAttribute('cx')!);
			satRing.setAttribute('cy', sat.e.getAttribute('cy')!);
			if (satRing.parentNode !== sat.e.parentNode) sat.e.parentNode!.append(satRing);
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
