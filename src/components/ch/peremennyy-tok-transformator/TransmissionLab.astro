---
/**
 * «Линия электропередачи»: left, a power station (its generator gives 10 кВ) and a step-up transformer; in the middle a
 * line of two wires on pylons with a scale bar of its length; right, a step-down transformer and a small town.
 * Fixed: the station sends P = 10 МВт into the line. The wires: aluminium, 0,12 Ом per 1 км of each wire, two wires,
 * so R = 0,24 Ом·L (L in км).
 * Controls: «Напряжение в линии» 10 кВ (no step-up: the transformer is grayed out, «напряжение генератора») / 35 /
 * 110 / 220 / 500 кВ; «Длина линии» 10–200 км, step 10 (default 100 км).
 * Physics: I = P/U, P_пот = I²R, losses in % = P_пот/P, delivered P − P_пот. When I·R ≥ U the whole voltage would be
 * lost in the wires (losses ≥ 100 %): «Такую мощность по этой линии передать нельзя: провода сгорят», nothing is
 * delivered. Losses over 50 %: an orange note. Check values (100 км, R = 24 Ом): 10 кВ — 1000 А, impossible; 35 кВ —
 * 285,7 А, 1,96 МВт (19,6 %); 110 кВ — 90,9 А, 198 кВт (1,98 %); 220 кВ — 45,5 А, 49,6 кВт (0,50 %); 500 кВ — 20,0 А,
 * 9,6 кВт (0,10 %). 10 км at 10 кВ: R = 2,4 Ом, 1000 А, 2,4 МВт (24 %).
 * Visual: the wires glow orange by the heat per meter ∝ I² on a log scale (none at 20 А, dull at 90 А, bright at
 * 290 А, white-hot at 1000 А); the green dots of the current move at a speed ∝ I (120 px/с at 1000 А); the town's
 * windows are as bright as the delivered power allows (dark when nothing arrives).
 */
import G7Styles from '../g7/G7Styles.astro';

const pylons = [146, 220, 294];
const pyl = (x: number) => `M${x - 7} 150 L${x - 2} 92 L${x + 2} 92 L${x + 7} 150 M${x - 6} 138 L${x + 5} 124 L${x - 4} 110 L${x + 3} 98 M${x + 6} 138 L${x - 5} 124 L${x + 4} 110 L${x - 3} 98 M${x - 14} 96 H${x + 14} M${x - 10} 96 L${x - 2} 104 M${x + 10} 96 L${x + 2} 104`;
---

<G7Styles />
<figure class="g7 g7--stack tml not-content" data-tml>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 440 200" role="img" aria-label="Электростанция, повышающий трансформатор, линия из двух проводов на опорах, понижающий трансформатор и город. Чем больше сила тока в проводах, тем сильнее они нагреваются и тем меньше энергии доходит до города">
			<rect class="tml__ground" x="0" y="150" width="440" height="50"></rect>
			<!-- the station -->
			<rect class="tml__bld" x="8" y="104" width="54" height="46"></rect>
			<rect class="tml__bld2" x="40" y="80" width="10" height="24"></rect>
			<g data-smoke></g>
			<circle class="tml__gen" cx="24" cy="128" r="10"></circle>
			<path class="tml__tilde" d="M18 128.5 q3 -6 6 0 t6 0"></path>
			<text class="t-small tml__in" x="35" y="147" text-anchor="middle">станция</text>
			<text class="tml__u" x="35" y="184" text-anchor="middle">10 кВ</text>
			<!-- the step-up transformer -->
			<g data-up>
				<rect class="tml__box" x="70" y="118" width="24" height="32" rx="2"></rect>
				<path class="tml__sym" d="M76 98 a3.5 3.5 0 0 1 0 7 a3.5 3.5 0 0 1 0 7 M88 98 a3.5 3.5 0 0 0 0 7 a3.5 3.5 0 0 0 0 7 M81 97 V113 M83 97 V113"></path>
				<text class="t-small" x="84" y="166" text-anchor="middle" data-uplbl>повышающий</text>
			</g>
			<!-- the line -->
			{pylons.map((x) => <path class="tml__pyl" d={pyl(x)}></path>)}
			<path class="tml__hot" d="" data-hot1></path>
			<path class="tml__hot" d="" data-hot2></path>
			<path class="tml__wire" d="" data-w1></path>
			<path class="tml__wire" d="" data-w2></path>
			<g data-dots></g>
			<text class="tml__u" x="220" y="80" text-anchor="middle" data-ul></text>
			<path class="tml__bar" d="M100 180 H340 M100 175 V185 M340 175 V185"></path>
			<text class="t-small tml__barl" x="220" y="196" text-anchor="middle" data-len></text>
			<!-- the step-down transformer and the town -->
			<rect class="tml__box" x="346" y="118" width="24" height="32" rx="2"></rect>
			<path class="tml__sym" d="M352 98 a3.5 3.5 0 0 1 0 7 a3.5 3.5 0 0 1 0 7 M364 98 a3.5 3.5 0 0 0 0 7 a3.5 3.5 0 0 0 0 7 M357 97 V113 M359 97 V113"></path>
			<text class="t-small" x="350" y="166" text-anchor="middle">понижающий</text>
			<path class="tml__house" d="M378 150 V124 L392 112 L406 124 V150 Z M404 150 V132 L418 120 L432 132 V150 Z"></path>
			<g data-wins>
				<rect class="tml__win" x="384" y="128" width="6" height="6"></rect>
				<rect class="tml__win" x="394" y="128" width="6" height="6"></rect>
				<rect class="tml__win" x="384" y="139" width="6" height="6"></rect>
				<rect class="tml__win" x="410" y="136" width="6" height="6"></rect>
				<rect class="tml__win" x="420" y="136" width="6" height="6"></rect>
			</g>
			<text class="t-small" x="414" y="166" text-anchor="middle">город</text>
		</svg>
		<div class="tml__ctrl">
			<div class="g7__row">
				<span class="g7__label">Напряжение в линии</span>
				<div class="g7__seg" data-seg>
					{[10, 35, 110, 220, 500].map((u) => <button type="button" class="g7__btn" aria-pressed={u === 110 ? 'true' : 'false'} data-u={u}>{u}&nbsp;кВ</button>)}
				</div>
			</div>
			<label class="g7__slider">Длина линии <output data-lo>100 км</output><input type="range" min="10" max="200" step="10" value="100" data-l /></label>
			<ul class="g7__read tml__read">
				<li>Передаваемая мощность <b>10 МВт</b></li>
				<li><span>Сопротивление проводов <i>R</i></span> <b data-r="R"></b></li>
				<li><span>Сила тока <i>I</i>&nbsp;=&nbsp;<i>P</i>/<i>U</i></span> <b data-r="I"></b></li>
				<li class="is-warm"><span>Потери <i>P</i><sub>пот</sub>&nbsp;=&nbsp;<i>I</i>²<i>R</i></span> <b data-r="P"></b></li>
				<li>Потери <b data-r="pc"></b></li>
				<li class="is-key">До города доходит <b data-r="D"></b></li>
			</ul>
			<p class="g7__msg tml__msg" data-msg hidden></p>
		</div>
	</div>
	<figcaption class="g7__caption">Провода алюминиевые: 0,12&nbsp;Ом на 1&nbsp;км каждого провода, проводов два.</figcaption>
</figure>

<script>
	import { loop, el } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	const P = 10e6; // Вт
	const X0 = 100;
	const X1 = 340;
	const PYL = [146, 220, 294];
	const nf = (v: number, d: number) => v.toFixed(d).replace('.', ',');
	const sig3 = (v0: number) => {
		if (v0 === 0) return '0';
		const v = Number(v0.toPrecision(3)); // round first: 9,995 must become 10,0
		const d = Math.max(0, 2 - Math.floor(Math.log10(Math.abs(v))));
		return nf(v, d);
	};
	const power = (w: number) => (w >= 1e6 ? `${sig3(w / 1e6)} МВт` : w >= 1e3 ? `${sig3(w / 1e3)} кВт` : `${sig3(w)} Вт`);
	// a wire: from x 100 through the pylons' arm ends to x 340, sagging between the supports
	const wirePath = (dy: number) => {
		const pts = [{ x: X0, y: 122 + dy }, ...PYL.map((x) => ({ x: x + (dy ? 12 : -12), y: 100 + dy })), { x: X1, y: 122 + dy }];
		let d = `M${pts[0].x} ${pts[0].y}`;
		for (let k = 1; k < pts.length; k++) {
			const a = pts[k - 1];
			const b = pts[k];
			d += `Q${f((a.x + b.x) / 2)} ${f((a.y + b.y) / 2 + 9)} ${b.x} ${b.y}`;
		}
		return d;
	};

	document.querySelectorAll<HTMLElement>('[data-tml]').forEach((root) => {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const w1 = $<SVGPathElement>('[data-w1]');
		const w2 = $<SVGPathElement>('[data-w2]');
		const h1 = $<SVGPathElement>('[data-hot1]');
		const h2 = $<SVGPathElement>('[data-hot2]');
		const dotsG = $<SVGGElement>('[data-dots]');
		const ul = $<SVGTextElement>('[data-ul]');
		const lenT = $<SVGTextElement>('[data-len]');
		const up = $<SVGGElement>('[data-up]');
		const upLbl = $<SVGTextElement>('[data-uplbl]');
		const wins = [...root.querySelectorAll<SVGRectElement>('[data-wins] rect')];
		const smoke = $<SVGGElement>('[data-smoke]');
		const msg = $<HTMLElement>('[data-msg]');
		const lIn = $<HTMLInputElement>('[data-l]');
		const lOut = $<HTMLOutputElement>('[data-lo]');
		const R_ = (k: string) => $<HTMLElement>(`[data-r="${k}"]`);
		// the upper wire is a little in front of the pylons (dy = 0), the lower one 8 px lower (dy = 8)
		const d1 = wirePath(0);
		const d2 = wirePath(8);
		for (const [w, h, d] of [
			[w1, h1, d1],
			[w2, h2, d2],
		] as const) {
			w.setAttribute('d', d);
			h.setAttribute('d', d);
		}
		const L1 = w1.getTotalLength();
		const L2 = w2.getTotalLength();
		const N = 16;
		const dots = Array.from({ length: 2 * N }, (_, k) => ({ c: dotsG.appendChild(el('circle', { class: 'tml__dot', r: 2.2 })), wire: k < N ? 0 : 1, s0: ((k % N) + 0.5) / N }));
		const puffs = Array.from({ length: 3 }, () => smoke.appendChild(el('circle', { class: 'tml__puff' })));
		let U = 110e3;
		let L = 100;
		let I = 0;
		let ok = true;
		let deliveredK = 0;
		let s = 0; // px travelled by the dots
		let t = 0;
		const update = () => {
			const R = 0.24 * L;
			I = P / U;
			ok = I * R < U;
			const Pl = I * I * R;
			const pc = (100 * Pl) / P;
			R_('R').textContent = `${sig3(R)} Ом`;
			R_('I').textContent = `${sig3(I)} А`;
			R_('P').textContent = ok ? power(Pl) : '—';
			R_('pc').textContent = ok ? `${pc < 0.1 ? nf(pc, 3) : pc < 1 ? nf(pc, 2) : sig3(pc)} %` : '—';
			R_('D').textContent = ok ? power(P - Pl) : '0';
			deliveredK = ok ? (P - Pl) / P : 0;
			msg.hidden = ok && pc <= 50;
			msg.classList.toggle('is-warn', !msg.hidden);
			msg.textContent = !ok ? 'Такую мощность по этой линии передать нельзя: провода сгорят.' : pc > 50 ? 'Больше половины энергии уходит на нагрев проводов.' : '';
			// the glow: log scale of I² between 5000 and 10⁶ А²
			const g = Math.min(1, Math.max(0, (Math.log10(I * I) - Math.log10(5000)) / (6 - Math.log10(5000))));
			for (const h of [h1, h2]) {
				h.style.opacity = f(g);
				h.style.setProperty('--tml-g', `${Math.round(g * 100)}%`);
			}
			wins.forEach((w) => (w.style.opacity = (0.15 + 0.85 * deliveredK).toFixed(2)));
			ul.textContent = `${U / 1000} кВ`;
			lenT.textContent = `L = ${L} км`;
			lOut.textContent = `${L} км`;
			up.classList.toggle('is-off', U === 10e3);
			upLbl.textContent = U === 10e3 ? 'не нужен' : 'повышающий';
		};
		const draw = () => {
			for (const d of dots) {
				const len = d.wire ? L2 : L1;
				// the current goes to the town along the upper wire and back along the lower one
				let q = (d.s0 + (d.wire ? -1 : 1) * (s / len)) % 1;
				if (q < 0) q += 1;
				const p = (d.wire ? w2 : w1).getPointAtLength(q * len);
				d.c.setAttribute('cx', f(p.x));
				d.c.setAttribute('cy', f(p.y));
			}
			puffs.forEach((c, k) => {
				const q = (t * 0.25 + k / 3) % 1;
				c.setAttribute('cx', f(45 + 10 * q));
				c.setAttribute('cy', f(78 - 30 * q));
				c.setAttribute('r', f(3 + 6 * q));
				c.style.opacity = f(0.5 * (1 - q));
			});
		};
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-u]')];
		for (const b of btns)
			b.addEventListener('click', () => {
				for (const o of btns) o.setAttribute('aria-pressed', String(o === b));
				U = Number(b.dataset.u) * 1000;
				update();
			});
		lIn.addEventListener('input', () => {
			L = Number(lIn.value);
			update();
		});
		update();
		loop(root, (dt) => {
			t += dt;
			if (ok) s += (dt * 120 * I) / 1000;
			draw();
			return true;
		});
		draw();
	});
</script>

<style is:global>
	.tml .g7__svg {
		max-width: 40rem;
		margin-inline: auto;
	}
	.tml__ctrl {
		display: grid;
		gap: 0.6rem;
		margin-top: 0.4rem;
	}
	.tml__read {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.tml__read i {
		font-family: var(--ig-font-math);
	}
	@media (max-width: 30rem) {
		.tml__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.tml__msg.is-warn {
		background: color-mix(in oklab, var(--sl-color-orange) 22%, var(--sl-color-gray-6));
	}
	.tml__ground {
		fill: color-mix(in oklab, hsl(100, 35%, 45%) 30%, var(--sl-color-gray-6));
	}
	.tml__bld {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-4));
	}
	.tml__bld2 {
		fill: var(--sl-color-gray-4);
	}
	.tml__puff {
		fill: var(--sl-color-gray-3);
	}
	.tml__gen {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
	}
	.tml__tilde {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
	}
	.tml__box {
		fill: color-mix(in oklab, hsl(140, 15%, 50%) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
	.tml__sym {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
	}
	[data-up].is-off {
		opacity: 0.3;
	}
	.tml__pyl {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.tml__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.tml__hot {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-orange) calc(100% - var(--tml-g, 0%) * 0.6), hsl(50, 100%, 92%));
		stroke-width: 6;
		stroke-linecap: round;
		filter: blur(1.5px);
	}
	.tml__dot {
		fill: var(--sl-color-green);
	}
	.tml .g7__svg .tml__u {
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.tml__bar {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tml .g7__svg .tml__barl {
		paint-order: stroke fill;
		stroke: var(--g7-paper);
		stroke-width: 5px;
	}
	.tml .g7__svg .tml__in {
		fill: var(--sl-color-gray-1);
	}
	.tml__house {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-4));
	}
	.tml__win {
		fill: hsl(45, 95%, 65%);
	}
</style>
