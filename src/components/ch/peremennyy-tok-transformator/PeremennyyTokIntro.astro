<script>
	import { scene } from '@components/intro/scene';
	import { DEG, SKELETON, add, polar, type Pt } from '@components/people/core';
	import { figure, ANKLE_CM, type HandTarget } from '@components/people/body';
	import { attachAxis, ease } from '@components/people/motion';

	const f = (v: number) => v.toFixed(1);
	const c01 = (x: number) => Math.min(1, Math.max(0, x));
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const lerpP = (a: Pt, b: Pt, t: number): Pt => ({ x: lerp(a.x, b.x, t), y: lerp(a.y, b.y, t) });

	document.querySelectorAll<HTMLElement>('[data-ptintro]').forEach((root) => {
		// ---------------- scene 1: slow motion
		{
			const card = root.querySelector<HTMLElement>('[data-scene="slowmo"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 6.6;
			const S = 1.15;
			const H = 160;
			const FLOOR = 226;
			const sk = SKELETON.teen;
			const u = S * H;
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H, age: 'teen', shirt: 'hm-red', hair: 'pony', name: 'slowmo-girl' });
			girl.backLayer(0, $<SVGGElement>('[data-phone-back]'));
			const phone = $<SVGGElement>('[data-phone]');
			const pscr = $<SVGRectElement>('[data-pscr]');
			const inset = $<SVGGElement>('[data-inset]');
			const zoom = $<SVGPathElement>('[data-zoom]');
			const shalo = $<SVGCircleElement>('[data-shalo]');
			const sbulb = $<SVGEllipseElement>('[data-sbulb]');
			const rec = $<SVGCircleElement>('[data-rec]');
			const rect = $<SVGTextElement>('[data-rect]');
			const steam = $<SVGPathElement>('[data-steam]');
			const ankleY = FLOOR - ANKLE_CM.trainer * S;
			const hip: Pt = { x: 112, y: ankleY - 0.995 * (sk.thigh + sk.shin) * u };
			const LEAN = 0.03;
			const sh = girl.shoulders(hip, LEAN);
			const hangFar = add(sh[1], polar(0.37 * u, Math.PI / 2 + 3 * DEG));
			const low: Pt = { x: hip.x + 27, y: hip.y - 36 };
			const high: Pt = { x: hip.x + 50, y: hip.y - 64 };
			const UP0 = 0.4;
			const UP1 = 1.2;
			const DN0 = 5.4;
			const DN1 = 6.2;
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const k = ease(c01((t - UP0) / (UP1 - UP0))) * (1 - ease(c01((t - DN0) / (DN1 - DN0))));
				const near: HandTarget = { at: lerpP(low, high, k), pose: 'grip', d: 3, dir: lerp(32, -3, k) * DEG, roll: -Math.PI / 2 + 0.15, contact: 'phone' };
				const st = girl.pose({ hip, lean: LEAN, head: lerp(0.42, -0.04, k), ankles: [{ x: hip.x + 7, y: ankleY }, { x: hip.x - 6, y: ankleY }], feet: [0, 0], hands: [near, { at: hangFar, pose: 'relaxed' }], planted: [true, true] });
				const g = st.grips[0];
				attachAxis(phone, g);
				// recording in slow motion while the phone is up
				const recording = t > UP1 + 0.3 && t < DN0 - 0.1;
				pscr.classList.toggle('is-on', true);
				inset.style.opacity = f(c01(k * 1.4 - 0.2));
				// the zoom lines from the phone to the inset
				const top: Pt = { x: g.x + g.axis.x * 10 * S, y: g.y + g.axis.y * 10 * S };
				zoom.setAttribute('d', `M${f(top.x)} ${f(top.y)}L276 22M${f(g.x)} ${f(g.y)}L276 124`);
				const tau = t - (UP1 + 0.3);
				const b = recording ? 0.1 + 0.9 * Math.cos(2 * Math.PI * tau) ** 2 : 1;
				shalo.style.opacity = f(b);
				sbulb.style.opacity = f(0.25 + 0.75 * b);
				const blink = recording && Math.floor(t * 2) % 2 === 0;
				rec.style.opacity = blink ? '1' : recording ? '0.25' : '0';
				rect.style.opacity = recording ? '1' : '0';
				steam.style.transform = `translateY(${f(-((t * 3) % 3))}px)`;
			});
		}

		// ---------------- scene 2: two lines
		{
			const card = root.querySelector<HTMLElement>('[data-scene="lines"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 8;
			const S = 0.4;
			const FLOOR = 232;
			const dad = figure($<SVGGElement>('[data-dad]'), { s: S, H: 178, age: 'adult', shirt: 'hm-blue', hair: 'short', name: 'lines-dad' });
			const son = figure($<SVGGElement>('[data-son]'), { s: S, H: 138, age: 'child', shirt: 'hm-gold', hair: 'short', shorts: true, name: 'lines-son' });
			const aY = FLOOR - ANKLE_CM.trainer * S;
			const hipOf = (H: number, age: 'adult' | 'child') => aY - 0.995 * (SKELETON[age].thigh + SKELETON[age].shin) * S * H;
			const dHip: Pt = { x: 92, y: hipOf(178, 'adult') };
			const sHip: Pt = { x: 128, y: hipOf(138, 'child') + 3 };
			const sAY = aY + 3;
			const dsh = dad.shoulders(dHip, 0.02);
			const dHang = [add(dsh[0], polar(0.37 * S * 178, Math.PI / 2 - 3 * DEG)), add(dsh[1], polar(0.37 * S * 178, Math.PI / 2 + 3 * DEG))];
			const ssh = son.shoulders(sHip, 0.02);
			const sHangFar = add(ssh[1], polar(0.36 * S * 138, Math.PI / 2 + 3 * DEG));
			// pointing angles of the boy's near arm (screen angles of the upper arm)
			const shp = ssh[0];
			const aPylon = Math.atan2(62 - shp.y, 160 - shp.x);
			const aPole = Math.atan2(140 - shp.y, 318 - shp.x);
			const aHang = Math.PI / 2 - 4 * DEG;
			const clouds = $<SVGGElement>('[data-clouds]');
			const wins = [...card.querySelectorAll<SVGRectElement>('[data-win]')];
			const birds = [...card.querySelectorAll<SVGPathElement>('.pts-bird')];
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const up = ease(c01((t - 1.0) / 0.9));
				const move = ease(c01((t - 3.4) / 0.8));
				const down = ease(c01((t - 5.6) / 0.8));
				const aim = lerp(aPylon, aPole, move);
				const ang = down > 0 ? lerp(aim, aHang, down) : lerp(aHang, aim, up);
				const raised = Math.max(0, Math.min(up, 1 - down));
				const near: HandTarget = raised > 0.05 ? { arm: [ang, 8 * DEG * (1 - raised) + 4 * DEG], pose: 'point', dir: ang } : { arm: [aHang, 8 * DEG], pose: 'relaxed' };
				const look = lerp(-0.55, -0.12, move);
				const sHead = lerp(0.1, look, raised);
				son.pose({ hip: sHip, lean: 0.02, head: sHead, ankles: [{ x: sHip.x + 4, y: sAY }, { x: sHip.x - 3, y: sAY }], feet: [0, 0], hands: [near, { at: sHangFar, pose: 'relaxed' }], planted: [true, true] });
				const dLook = lerp(0.05, lerp(-0.4, -0.08, ease(c01((t - 3.7) / 0.8))), ease(c01((t - 1.4) / 0.8)) * (1 - ease(c01((t - 6.0) / 0.8))));
				dad.pose({ hip: dHip, lean: 0.02, head: dLook, ankles: [{ x: dHip.x + 5, y: aY }, { x: dHip.x - 5, y: aY }], feet: [0, 0], hands: [{ at: dHang[0], pose: 'relaxed' }, { at: dHang[1], pose: 'relaxed' }], planted: [true, true] });
				clouds.setAttribute('transform', `translate(${f(6 * x)} 0)`);
				wins.forEach((w, i) => w.classList.toggle('is-on', t > 1.5 + 1.3 * i));
				birds.forEach((b, i) => {
					const ph = (t - 1.2 - 1.7 * i) % 4;
					const hop = ph > 0 && ph < 0.3 ? Math.sin((Math.PI * ph) / 0.3) * 2.2 : 0;
					b.setAttribute('transform', `translate(${f(ph > 0.3 && ph < 2 && i % 2 ? 0.8 : 0)} ${f(-hop)})`);
				});
			});
		}
	});
</script>

