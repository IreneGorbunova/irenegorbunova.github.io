---
/**
 * Two short looping opening scenes of «Переменный ток. Трансформатор». No terms of the chapter in the pictures or the
 * visible captions; the captions' popovers explain. People: the people kit, in profile.
 *
 * Slow motion («Замедленная съёмка»): an evening kitchen, 1,15 px per см (the girl is 160 см, a teen). A pendant lamp
 *   with an LED bulb hangs over the table at 150 см from the floor (75 см above a table of 75 см, as such lamps hang).
 *   The girl holds her phone in the near (right) hand in a power grip, the thumb on top, and raises it from chest level
 *   to eye level at nearly arm's length in 0,8 s (eased), points its camera at the lamp, records for 4 s and lowers it again. The round-cornered
 *   inset is the phone's screen enlarged: before and after the recording it shows the lamp shining steadily (a normal
 *   video, 30 frames per second, cannot catch the flicker); while it records in slow motion (red dot) the lamp on the
 *   screen pulses bright → dim → bright, 2 pulses per second.
 *   Physics: the brightness of a lamp fed from the 50-Гц mains pulses 100 times per second (it is greatest twice per
 *   period of 0,02 с, whatever the direction of the current). A slow-motion video of 240 кадров/с played at 30 кадров/с
 *   is 8 times slower: 12,5 pulses per second, too fast to draw; the inset is slowed a further 6,25 times (2 pulses per
 *   second). The real lamp in the kitchen shines steadily: the eye does not notice 100 pulses per second.
 * Two lines («Две линии»): a summer evening, a dirt road through the fields to a village. The middle distance is drawn
 *   at 4 px per м: a steel lattice pylon of the wine-glass type 30 м high (33 м with the peaks of the ground wires) with
 *   three insulator strings of 3,5 м (20 discs each) holding three heavy wires; two more pylons farther away (2,4 and
 *   1,5 px per м). The line comes down to a substation by the village (a gantry of 12 м, two transformers with ribbed
 *   radiators and tall bushings, a fence of 2 м); from there poles of 10 м with short insulators carry thinner wires
 *   along the street to the houses (6 м). So the pylon is 3 times as tall as a pole, as in reality (30–40 м against
 *   9–10 м). The father (178 см) and the son (about 10, 138 см) stand on the road in the foreground, 0,4 px per см:
 *   they are much closer to us than the pylon (in real size a person is about a fifth of a pole and a twentieth of the
 *   pylon). The boy points with his near arm at the big pylon (a 0,9-s reach, eased), holds it, moves to a low pole,
 *   holds, and drops the arm; his head and the father's head follow. At this size the hands are drawn as mittens, so
 *   the pointing reads from the straight arm. Clouds drift, birds on the low wires hop, the windows light one by one.
 * Plays only while visible (scene() from intro/scene.ts).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// ---- scene 2: the landscape, built here
type P = { x: number; y: number };
const r1 = (v: number) => Math.round(v * 10) / 10;
/** A wine-glass pylon at base point (x, y), k px per м: the lattice, the crossbeam, three insulator strings. */
const pylon = (x: number, y: number, k: number) => {
	const X = (m: number) => r1(x + m * k);
	const Y = (m: number) => r1(y - m * k);
	const half = (h: number) => (h <= 20 ? 4 - (2.5 * h) / 20 : 1.5); // half-width of the legs at height h
	let d = '';
	// legs up to the waist (20 м)
	d += `M${X(-4)} ${Y(0)}L${X(-1.5)} ${Y(20)}M${X(4)} ${Y(0)}L${X(1.5)} ${Y(20)}`;
	// cross bracing every 4 м
	for (let h = 0; h < 20; h += 4) {
		const a = half(h);
		const b = half(h + 4);
		d += `M${X(-a)} ${Y(h)}L${X(b)} ${Y(h + 4)}M${X(a)} ${Y(h)}L${X(-b)} ${Y(h + 4)}M${X(-b)} ${Y(h + 4)}L${X(b)} ${Y(h + 4)}`;
	}
	// the V arms (outer and inner chords) up to the crossbeam at 30 м
	d += `M${X(-1.5)} ${Y(20)}L${X(-7)} ${Y(30)}M${X(1.5)} ${Y(20)}L${X(7)} ${Y(30)}`;
	d += `M${X(-1.5)} ${Y(20)}L${X(-5)} ${Y(30)}M${X(1.5)} ${Y(20)}L${X(5)} ${Y(30)}`;
	for (let h = 22; h < 30; h += 2.5) {
		const o = 1.5 + ((7 - 1.5) * (h - 20)) / 10;
		const i = 1.5 + ((5 - 1.5) * (h - 20)) / 10;
		d += `M${X(-o)} ${Y(h)}L${X(-i)} ${Y(h + 2.5)}M${X(o)} ${Y(h)}L${X(i)} ${Y(h + 2.5)}`;
	}
	// the crossbeam (two chords and a zigzag) and the peaks for the ground wires
	d += `M${X(-10)} ${Y(30)}L${X(10)} ${Y(30)}M${X(-10)} ${Y(29)}L${X(10)} ${Y(29)}`;
	for (let m = -10; m < 10; m += 2) d += `M${X(m)} ${Y(29)}L${X(m + 1)} ${Y(30)}L${X(m + 2)} ${Y(29)}`;
	d += `M${X(-7)} ${Y(30)}L${X(-6.5)} ${Y(33)}L${X(-6)} ${Y(30)}M${X(7)} ${Y(30)}L${X(6.5)} ${Y(33)}L${X(6)} ${Y(30)}`;
	// insulator strings: 20 discs over 3,5 м
	const strings = [-8, 0, 8].map((m) => {
		const discs = Array.from({ length: 20 }, (_, j) => ({ cx: X(m), cy: r1(y - (29 - 0.15 - (3.4 * j) / 19) * k), rx: r1(Math.max(0.6, 0.14 * k)) }));
		return { line: `M${X(m)} ${Y(29)}L${X(m)} ${Y(25.5)}`, discs, end: { x: X(m), y: Y(25.5) } as P };
	});
	return { d, strings, peaks: [{ x: X(-6.5), y: Y(33) }, { x: X(6.5), y: Y(33) }] as P[], w: r1(Math.max(0.5, 0.11 * k)) };
};
const sag = (a: P, b: P, s: number) => `M${a.x} ${a.y}Q${r1((a.x + b.x) / 2)} ${r1((a.y + b.y) / 2 + 2 * s)} ${b.x} ${b.y}`;
const PY = [pylon(14, 150, 1.5), pylon(74, 158, 2.4), pylon(158, 170, 4)];
// the gantry of the substation: 12 м, k = 4, at x 236, ground 174
const GX = 236;
const GG = 174;
const gant = [-1.5, 0, 1.5].map((m) => ({ x: r1(GX + m * 4 * 2.2), y: r1(GG - 11 * 4) }));
const lineWires: string[] = [];
for (let j = 0; j < 3; j++) {
	lineWires.push(sag({ x: -10, y: r1(PY[0].strings[j].end.y + 6) }, PY[0].strings[j].end, 2));
	lineWires.push(sag(PY[0].strings[j].end, PY[1].strings[j].end, 3));
	lineWires.push(sag(PY[1].strings[j].end, PY[2].strings[j].end, 5));
	lineWires.push(sag(PY[2].strings[j].end, gant[j], 6));
}
const earth = [sag({ x: -10, y: PY[0].peaks[1].y + 5 }, PY[0].peaks[1], 2), sag(PY[0].peaks[1], PY[1].peaks[1], 3), sag(PY[1].peaks[1], PY[2].peaks[1], 4), sag(PY[0].peaks[0], PY[1].peaks[0], 3), sag(PY[1].peaks[0], PY[2].peaks[0], 4)];
// low poles: 10 м at k = 4, insulators on a short crossarm, two wires
const poles = [
	{ x: 284, g: 178 },
	{ x: 318, g: 180 },
	{ x: 352, g: 182 },
].map((p) => ({ ...p, top: p.g - 40, a: { x: p.x - 4, y: p.g - 38.5 }, b: { x: p.x + 4, y: p.g - 38.5 } }));
const lowWires: string[] = [];
const from = [
	{ x: 262, y: 150 },
	{ x: 266, y: 150 },
];
lowWires.push(sag(from[0], poles[0].a, 1.5), sag(from[1], poles[0].b, 1.5));
for (let j = 0; j < 2; j++) {
	lowWires.push(sag(poles[j].a, poles[j + 1].a, 2.5));
	lowWires.push(sag(poles[j].b, poles[j + 1].b, 2.5));
}
// house drops
lowWires.push(sag(poles[1].b, { x: 330, y: 160 }, 1), sag(poles[2].b, { x: 364, y: 164 }, 1));
// the birds sit on the near wire between poles 1 and 2 (the quadratic's points)
const qpt = (a: P, b: P, s: number, t: number): P => {
	const c = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 + 2 * s };
	const u = 1 - t;
	return { x: r1(u * u * a.x + 2 * u * t * c.x + t * t * b.x), y: r1(u * u * a.y + 2 * u * t * c.y + t * t * b.y) };
};
const birds = [0.28, 0.4, 0.62, 0.74].map((t) => qpt(poles[1].b, poles[2].b, 2.5, t));
