---
/**
 * «Ток в сети»: the graph of the current i(t) in a lamp plugged into a socket, over two periods (0–40 мс), and two tiny
 * circuits (socket → lamp) that show which way the current goes.
 * Physics: i = I·sin(2πt/T), T = 20 мс (ν = 50 Гц). The current axis has no numbers («+», «0», «−»): only the shape,
 * the sign and the period matter here. The grid is 5 мс per cell. The period is marked between two neighboring crests
 * (t = 5 мс and 25 мс). Dashed lines at every zero (t = 10, 20, 30 мс; also t = 0 and 40 мс on the frame) are the
 * moments when the current changes its direction: twice per period, 100 times a second.
 * The positive half: the current goes clockwise in the little circuit (to the right along its top wire); the negative
 * half: counterclockwise. The icon of the half the dot is on lights up (the frame, the arrow and the lamp), its arrow's
 * length follows |i|.
 * Slowed (the caption says it): time runs 100 times slower, one period in 2 с, the whole graph in 4 с.
 */
import G7Styles from '../g7/G7Styles.astro';

const W = 440;
const X0 = 44; // t = 0
const PX = 8.8; // px per мс
const Y0 = 128; // i = 0
const A = 58; // px, the largest current
const T = 20;
const x = (t: number) => X0 + PX * t;
const curve = Array.from({ length: 161 }, (_, k) => {
	const t = (k / 160) * 40;
	return `${k ? 'L' : 'M'}${x(t).toFixed(1)} ${(Y0 - A * Math.sin((2 * Math.PI * t) / T)).toFixed(1)}`;
}).join('');
const yTop = Y0 - A;
const yBot = Y0 + A;
const ym = yTop - 15; // the period marker
const zeros = [10, 20, 30];
// the two icons: a source «~» on the left, a lamp on the right, a loop of wire
const icons = [
	{ x0: 52, sign: 1, label: '+' },
	{ x0: 252, sign: -1, label: '−' },
].map((c) => ({ ...c, x1: c.x0 + 136, y0: 238, y1: 282 }));
---

<G7Styles />
<figure class="g7 g7--pic acg not-content" data-acg>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox={`0 0 ${W} 296`} role="img" aria-label="График силы тока в лампе, включённой в розетку: синусоида за два периода, от 0 до 40 мс. Период T = 20 мс отмечен между двумя соседними максимумами. Выше оси ток идёт в одну сторону, ниже — в обратную; в моменты 10, 20 и 30 мс ток меняет направление. Под графиком две маленькие цепи со стрелками тока по часовой и против часовой стрелки">
			<!-- grid, 5 мс per cell -->
			{Array.from({ length: 8 }, (_, k) => <line class="acg__grid" x1={x(5 * (k + 1))} x2={x(5 * (k + 1))} y1={yTop} y2={yBot}></line>)}
			<line class="acg__grid" x1={x(0)} x2={x(40)} y1={yTop} y2={yTop}></line>
			<line class="acg__grid" x1={x(0)} x2={x(40)} y1={yBot} y2={yBot}></line>
			<line class="acg__grid" x1={x(0)} x2={x(40)} y1={Y0 - A / 2} y2={Y0 - A / 2}></line>
			<line class="acg__grid" x1={x(0)} x2={x(40)} y1={Y0 + A / 2} y2={Y0 + A / 2}></line>
			<!-- the moments when the current changes direction -->
			{zeros.map((t) => <line class="acg__zero" x1={x(t)} x2={x(t)} y1={yTop} y2={yBot + 4}></line>)}
			<!-- axes -->
			<path class="acg__axis" d={`M${X0} ${yBot + 6} V${yTop - 30} M${X0 - 4} ${yTop - 22} L${X0} ${yTop - 30} L${X0 + 4} ${yTop - 22}`}></path>
			<path class="acg__axis" d={`M${X0} ${Y0} H${x(40) + 16} M${x(40) + 8} ${Y0 - 4} L${x(40) + 16} ${Y0} L${x(40) + 8} ${Y0 + 4}`}></path>
			<text class="t-i" x={X0 - 8} y={yTop - 22} text-anchor="end">i</text>
			<text class="t-i" x={W - 4} y={Y0 - 8} text-anchor="end">t<tspan class="acg__unit">, мс</tspan></text>
			<text class="acg__sign" x={X0 - 8} y={yTop + 6} text-anchor="end">+</text>
			<text class="t-num" x={X0 - 8} y={Y0 + 4} text-anchor="end">0</text>
			<text class="acg__sign" x={X0 - 8} y={yBot + 5} text-anchor="end">−</text>
			{[10, 20, 30, 40].map((t) => <text class="t-num" x={x(t)} y={yBot + 15} text-anchor="middle">{t}</text>)}
			<path class="acg__curve" d={curve}></path>
			<!-- the period between two neighboring crests -->
			<line class="acg__per-l" x1={x(5)} x2={x(5)} y1={ym - 4} y2={yTop - 2}></line>
			<line class="acg__per-l" x1={x(25)} x2={x(25)} y1={ym - 4} y2={yTop - 2}></line>
			<path class="acg__per" d={`M${x(5) + 1} ${ym} H${x(25) - 1}`}></path>
			<path class="acg__per-h" d={`M${x(5)} ${ym} l7 -3.5 v7 Z M${x(25)} ${ym} l-7 -3.5 v7 Z`}></path>
			<text class="acg__per-t" x={x(15)} y={ym - 6} text-anchor="middle"><tspan class="acg__it">T</tspan><tspan dx="4">{'= 20 мс'}</tspan></text>
			<!-- the halves -->
			<text class="acg__half" x={x(35)} y={yTop - 10} text-anchor="middle">ток идёт в одну сторону</text>
			<text class="acg__half" x={x(12)} y={yBot + 32} text-anchor="middle">ток идёт в обратную сторону</text>
			<path class="acg__zero" d={`M262 ${yBot + 28} h14`}></path>
			<text class="acg__half" x="282" y={yBot + 32}>ток меняет направление</text>
			<!-- the cursor -->
			<line class="acg__cur" x1={X0} x2={X0} y1={yTop - 2} y2={yBot + 2} data-cur></line>
			<circle class="acg__dot" cx={X0} cy={Y0} r="5" data-dot></circle>
			<!-- the two circuits -->
			{
				icons.map((c, i) => (
					<g class="acg__icon" data-icon={i}>
						<rect class="acg__ibox" x={c.x0 - 18} y={c.y0 - 12} width={c.x1 - c.x0 + 36} height={c.y1 - c.y0 + 22} rx="9"></rect>
						<text class="acg__isign" x={c.x0 - 9} y={c.y0 + 4} text-anchor="middle">{c.label}</text>
						<path class="acg__iwire" d={`M${c.x0} ${c.y0} H${c.x1} V${c.y1} H${c.x0} Z`}></path>
						<circle class="acg__isrc" cx={c.x0} cy={(c.y0 + c.y1) / 2} r="10"></circle>
						<path class="acg__itilde" d={`M${c.x0 - 5.5} ${(c.y0 + c.y1) / 2 + 0.5} q2.75 -5.5 5.5 0 t5.5 0`}></path>
						<circle class="acg__iglow" cx={c.x1} cy={(c.y0 + c.y1) / 2} r="15"></circle>
						<circle class="acg__ibulb" cx={c.x1} cy={(c.y0 + c.y1) / 2} r="8"></circle>
						<path class="acg__ifil" d={`M${c.x1 - 3} ${(c.y0 + c.y1) / 2 + 5} L${c.x1 - 1.5} ${(c.y0 + c.y1) / 2 - 3} l1.5 3 l1.5 -3 L${c.x1 + 3} ${(c.y0 + c.y1) / 2 + 5}`}></path>
						<path class="acg__iarr" d="" data-ia></path>
						<path class="acg__iarrh" d="" data-ih></path>
						<path class="acg__iarr" d="" data-ia2></path>
						<path class="acg__iarrh" d="" data-ih2></path>
					</g>
				))
			}
		</svg>
	</div>
	<figcaption class="acg__cap">Время замедлено в 100 раз: один период длится 2 с.</figcaption>
</figure>

<script>
	import { loop } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	const X0 = 44;
	const PX = 8.8;
	const Y0 = 128;
	const A = 58;
	const T = 20; // мс
	const SLOW = 100;
	const ICONS = [52, 252].map((x0) => ({ x0, x1: x0 + 136, y0: 238, y1: 282 }));

	document.querySelectorAll<HTMLElement>('[data-acg]').forEach((root) => {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const cur = $<SVGLineElement>('[data-cur]');
		const dot = $<SVGCircleElement>('[data-dot]');
		const icons = [...root.querySelectorAll<SVGGElement>('[data-icon]')].map((g) => ({
			g,
			a: g.querySelector<SVGPathElement>('[data-ia]')!,
			h: g.querySelector<SVGPathElement>('[data-ih]')!,
			a2: g.querySelector<SVGPathElement>('[data-ia2]')!,
			h2: g.querySelector<SVGPathElement>('[data-ih2]')!,
		}));
		const arrow = (sh: SVGPathElement, hd: SVGPathElement, xc: number, y: number, len: number) => {
			if (Math.abs(len) < 4) {
				sh.setAttribute('d', '');
				hd.setAttribute('d', '');
				return;
			}
			const d = Math.sign(len);
			const x2 = xc + len / 2;
			sh.setAttribute('d', `M${f(xc - len / 2)} ${y}H${f(x2 - d * 5)}`);
			hd.setAttribute('d', `M${f(x2 + d)} ${y}L${f(x2 - d * 7)} ${y - 4.5}L${f(x2 - d * 7)} ${y + 4.5}Z`);
		};
		let t = 0;
		const draw = () => {
			const s = Math.sin((2 * Math.PI * t) / T);
			const xx = X0 + PX * t;
			cur.setAttribute('x1', f(xx));
			cur.setAttribute('x2', f(xx));
			dot.setAttribute('cx', f(xx));
			dot.setAttribute('cy', f(Y0 - A * s));
			icons.forEach((ic, i) => {
				const on = i === 0 ? s > 0.02 : s < -0.02;
				ic.g.classList.toggle('is-on', on);
				const c = ICONS[i];
				const xc = (c.x0 + c.x1) / 2;
				const len = on ? 56 * Math.abs(s) : 0;
				// clockwise: right along the top wire, left along the bottom one
				const dir = i === 0 ? 1 : -1;
				arrow(ic.a, ic.h, xc, c.y0 + 9, dir * len);
				arrow(ic.a2, ic.h2, xc, c.y1 - 9, -dir * len);
				ic.g.style.setProperty('--acg-k', on ? (s * s).toFixed(2) : '0');
			});
		};
		loop(root, (dt) => {
			t = (t + (dt * 1000) / SLOW) % 40;
			draw();
			return true;
		});
		draw();
	});
</script>

<style is:global>
	.acg .g7__svg {
		max-width: 38rem;
		margin-inline: auto;
	}
	.acg__grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.acg__zero {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.acg__axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.acg .acg__unit {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 12px;
	}
	.acg .g7__svg .acg__sign {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-gray-2);
	}
	.acg__curve {
		fill: none;
		stroke: var(--sl-color-green);
		stroke-width: 2.6;
	}
	.acg__per-l {
		stroke: var(--sl-color-gray-3);
		stroke-dasharray: 3 3;
	}
	.acg__per {
		stroke: var(--sl-color-white);
		stroke-width: 1.6;
	}
	.acg__per-h {
		fill: var(--sl-color-white);
	}
	.acg .g7__svg .acg__per-t {
		font-weight: 700;
		font-size: 13px;
		fill: var(--sl-color-white);
	}
	.acg__it {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
	}
	.acg .g7__svg .acg__half {
		font-size: 11.5px;
		fill: var(--sl-color-gray-2);
	}
	.acg__cur {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.acg__dot {
		fill: var(--sl-color-green);
		stroke: var(--sl-color-bg);
		stroke-width: 1.5;
	}
	.acg__ibox {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.2;
	}
	.acg__icon.is-on .acg__ibox {
		stroke: var(--sl-color-green);
	}
	.acg .g7__svg .acg__isign {
		font-size: 16px;
		font-weight: 700;
		fill: var(--sl-color-gray-3);
	}
	.acg .g7__svg .is-on .acg__isign {
		fill: var(--sl-color-green);
	}
	.acg__iwire {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.8;
	}
	.acg__isrc,
	.acg__ibulb {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.acg__itilde,
	.acg__ifil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.acg__iglow {
		fill: color-mix(in srgb, var(--ig-v) 60%, transparent);
		opacity: var(--acg-k, 0);
	}
	.acg__iarr {
		stroke: var(--sl-color-green);
		stroke-width: 2.6;
		stroke-linecap: round;
		fill: none;
	}
	.acg__iarrh {
		fill: var(--sl-color-green);
	}
	.acg__cap {
		margin-top: 0.5rem;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
