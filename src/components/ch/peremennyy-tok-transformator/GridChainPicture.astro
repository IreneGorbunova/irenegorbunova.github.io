---
/**
 * «От электростанции до розетки»: the chain station (generator 10–20 кВ) → step-up transformer → line 110–750 кВ on
 * tall pylons → substation by the town (→ 10 кВ) → transformer kiosk in a yard (→ 0,4 кВ, i.e. 380/220 В) → a house
 * with a socket of 220 В. Each transformer is its schematic symbol over a small building, «повышающий» or
 * «понижающий» under it. Two halves (station … line, substation … house) side by side on a wide screen, one above the
 * other on a phone; the line leaves the first half at its right edge and enters the second at its left edge.
 * The green dots of the current: the same power flows through all parts, so where the voltage is high the current is
 * small: the dots there are sparse and slow; in the low-voltage parts dense and fast (spacing 36 / 18 / 9 px and speed
 * 5 / 12 / 26 px/с in the parts of the line, of 10–20 кВ and of 0,4 кВ). Only the order matters: the real currents
 * differ by much more (a 500-кВ line carries 1250 times less current than 0,4 кВ for the same power).
 */
import G7Styles from '../g7/G7Styles.astro';

const sym = (x: number, y: number) => `M${x - 6} ${y} a3.5 3.5 0 0 1 0 7 a3.5 3.5 0 0 1 0 7 a3.5 3.5 0 0 1 0 7 M${x + 6} ${y} a3.5 3.5 0 0 0 0 7 a3.5 3.5 0 0 0 0 7 a3.5 3.5 0 0 0 0 7 M${x - 1} ${y - 1} V${y + 22} M${x + 1} ${y - 1} V${y + 22}`;
const tower = (x: number, g: number, h: number) => `M${x - h * 0.18} ${g} L${x - h * 0.05} ${g - h * 0.7} L${x - h * 0.2} ${g - h} M${x + h * 0.18} ${g} L${x + h * 0.05} ${g - h * 0.7} L${x + h * 0.2} ${g - h} M${x - h * 0.32} ${g - h} H${x + h * 0.32} M${x - h * 0.14} ${g - h * 0.25} L${x + h * 0.12} ${g - h * 0.45} M${x + h * 0.14} ${g - h * 0.25} L${x - h * 0.12} ${g - h * 0.45} M${x - h * 0.08} ${g - h * 0.55} L${x + h * 0.06} ${g - h * 0.7}`;
// segments for the dots (path, kind): kind 0 = 10–20 кВ, 1 = line, 2 = 0,4 кВ
const A = [
	{ d: 'M60 112 H94', k: 0 },
	{ d: 'M126 112 V60 Q180 74 220 52 Q262 74 316 60', k: 1 },
];
const B = [
	{ d: 'M4 60 Q30 70 52 92 V112', k: 1 },
	{ d: 'M86 112 H104 Q132 104 150 112 H176', k: 0 },
	{ d: 'M208 112 H220 Q244 104 264 112 H286', k: 2 },
];
---

<G7Styles />
<figure class="g7 g7--pic gcp not-content" data-gcp>
	<div class="gcp__wrap">
		<svg class="g7__svg gcp__svg" viewBox="0 0 320 170" role="img" aria-label="Электростанция с генератором на 10–20 кВ, повышающий трансформатор и линия электропередачи на 110–750 кВ на высоких опорах">
			<rect class="gcp__ground" x="0" y="132" width="320" height="38"></rect>
			<path class="gcp__bld" d="M8 132 V92 H58 V132 Z M38 92 V64 H50 V92"></path>
			<circle class="gcp__gen" cx="24" cy="112" r="9"></circle>
			<path class="gcp__tl" d="M18.5 112.5 q2.75 -5.5 5.5 0 t5.5 0"></path>
			<text class="gcp__name" x="46" y="148" text-anchor="middle">Электростанция</text>
			<text class="gcp__u" x="46" y="162" text-anchor="middle">10–20 кВ</text>
			<rect class="gcp__box" x="96" y="104" width="30" height="28" rx="2"></rect>
			<path class="gcp__sym" d={sym(111, 70)}></path>
			<text class="gcp__name" x="122" y="62" text-anchor="end">повышающий</text>
			<path class="gcp__tower" d={tower(150, 132, 74)}></path>
			<path class="gcp__tower" d={tower(250, 132, 74)}></path>
			<path class="gcp__tower" d={tower(316, 132, 74)}></path>
			{A.map((s) => <path class="gcp__wire" d={s.d} data-seg={s.k}></path>)}
			<text class="gcp__name" x="226" y="148" text-anchor="middle">Линия электропередачи</text>
			<text class="gcp__u" x="226" y="162" text-anchor="middle">110–750 кВ</text>
			<g data-dots></g>
		</svg>
		<svg class="g7__svg gcp__svg" viewBox="0 0 320 170" role="img" aria-label="Подстанция у города понижает напряжение до 10 кВ, трансформаторная будка во дворе — до 0,4 кВ, в доме в розетке 220 В">
			<rect class="gcp__ground" x="0" y="132" width="320" height="38"></rect>
			<path class="gcp__tower" d={tower(4, 132, 74)}></path>
			<path class="gcp__fence" d="M40 132 V120 H84 V132 M40 126 H84"></path>
			<rect class="gcp__box" x="54" y="104" width="30" height="28" rx="2"></rect>
			<path class="gcp__sym" d={sym(69, 70)}></path>
			<text class="gcp__name" x="69" y="62" text-anchor="middle">понижающий</text>
			<text class="gcp__name" x="66" y="148" text-anchor="middle">Подстанция</text>
			<text class="gcp__u" x="66" y="162" text-anchor="middle">→ 10 кВ</text>
			<path class="gcp__pole" d="M150 132 V100 M144 102 H156"></path>
			<rect class="gcp__box" x="176" y="104" width="32" height="28" rx="2"></rect>
			<path class="gcp__bolt" d="M193 110 l-4 8 h4 l-3 8 l7 -10 h-4 l3 -6 Z"></path>
			<path class="gcp__sym" d={sym(192, 70)}></path>
			<text class="gcp__name" x="192" y="62" text-anchor="middle">понижающий</text>
			<text class="gcp__name" x="190" y="148" text-anchor="middle">Будка во дворе</text>
			<text class="gcp__u" x="190" y="162" text-anchor="middle">→ 0,4 кВ</text>
			<path class="gcp__house" d="M268 132 V100 L290 82 L312 100 V132 Z"></path>
			<rect class="gcp__winl" x="276" y="106" width="10" height="10"></rect>
			<rect class="gcp__sock" x="294" y="112" width="12" height="14" rx="2"></rect>
			<circle class="gcp__hole" cx="300" cy="116.5" r="1.3"></circle>
			<circle class="gcp__hole" cx="300" cy="121.5" r="1.3"></circle>
			{B.map((s) => <path class="gcp__wire" d={s.d} data-seg={s.k}></path>)}
			<text class="gcp__name" x="290" y="148" text-anchor="middle">Дом</text>
			<text class="gcp__u" x="290" y="162" text-anchor="middle">220 В</text>
			<g data-dots></g>
		</svg>
	</div>
	<figcaption class="gcp__cap">Чем выше напряжение, тем меньше сила тока: в линии зелёные точки тока редкие и медленные, у дома — частые и быстрые.</figcaption>
</figure>

<script>
	import { loop, el } from '../g7/kit';

	const SP = [18, 36, 9]; // spacing, px
	const V = [12, 5, 26]; // speed, px/с
	document.querySelectorAll<HTMLElement>('[data-gcp]').forEach((root) => {
		const parts = [...root.querySelectorAll<SVGSVGElement>('svg')].map((svg) => {
			const g = svg.querySelector<SVGGElement>('[data-dots]')!;
			const segs = [...svg.querySelectorAll<SVGPathElement>('[data-seg]')].map((p) => {
				const k = Number(p.dataset.seg);
				const L = p.getTotalLength();
				const n = Math.max(1, Math.floor(L / SP[k]));
				const dots = Array.from({ length: n }, (_, j) => ({ c: g.appendChild(el('circle', { class: 'gcp__dot', r: 2 })), s0: (j * L) / n }));
				return { p, k, L, dots };
			});
			return segs;
		});
		let t = 0;
		const draw = () => {
			for (const segs of parts)
				for (const s of segs)
					for (const d of s.dots) {
						const q = (d.s0 + V[s.k] * t) % s.L;
						const pt = s.p.getPointAtLength(q);
						d.c.setAttribute('cx', pt.x.toFixed(1));
						d.c.setAttribute('cy', pt.y.toFixed(1));
					}
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	});
</script>

<style is:global>
	.gcp__wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.gcp__svg {
		flex: 1 1 18rem;
		min-width: 0;
	}
	.gcp__ground {
		fill: color-mix(in oklab, hsl(100, 35%, 45%) 25%, var(--sl-color-gray-6));
	}
	.gcp__bld,
	.gcp__house {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-4));
	}
	.gcp__house {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-4));
	}
	.gcp__water {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2;
	}
	.gcp__gen,
	.gcp__sock {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.gcp__tl {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.gcp__hole {
		fill: var(--sl-color-gray-2);
	}
	.gcp__winl {
		fill: hsl(45, 95%, 65%);
	}
	.gcp__box {
		fill: color-mix(in oklab, hsl(140, 15%, 50%) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
	.gcp__bolt {
		fill: var(--ig-v);
	}
	.gcp__sym {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.3;
	}
	.gcp__tower,
	.gcp__fence {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	.gcp__pole {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-3));
		stroke-width: 2;
	}
	.gcp__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.gcp__dot {
		fill: var(--sl-color-green);
	}
	.gcp .g7__svg .gcp__name {
		font-size: 10.5px;
		fill: var(--sl-color-gray-1);
	}
	.gcp .g7__svg .gcp__u {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.gcp__cap {
		margin-top: 0.5rem;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
