---
/**
 * «Генератор электростанции»: a labelled scheme. Left, in side view: steam drives a turbine (rows of blades on a
 * horizontal shaft), the shaft goes into the generator. Right: the generator seen end-on (a cut across the shaft): the
 * stator — a steel ring with copper conductors in 24 slots — and inside it the rotor, an electromagnet with 2, 4 or 8
 * poles, N blue and S red alternating. One coil of the stator is drawn in color: its two sides lie in two slots one pole
 * pitch apart (180°/p for p pairs of poles), joined by an end turn on the near face; its leads go out «в сеть».
 * Buttons «1 пара полюсов» / «2 пары» / «4 пары». For 50 Гц the rotor must turn ν/p times a second: 50, 25, 12,5 об/с,
 * i.e. 3000, 1500, 750 об/мин (the readout). Slowed 200 times: one turn of the rotor takes 4, 8, 16 с on the screen, so
 * one period of the current always lasts 4 с.
 * The current in the colored coil: the flux through it ∝ cos(p·Δ), Δ the angle of the N pole 0 from the coil's axis
 * (straight up), largest when a pole stands in front of the coil; the induced current ∝ sin(p·Δ), zero there and
 * largest between the poles. The two coil sides show it end-on, ⊙ (toward us) and ⊗ (away), in green, their size
 * ∝ |i|; they swap each time a pole passes the coil; a green arrow on the lead shows the direction in the wire. The
 * trace at the bottom left shows i over the last turn of the rotor: 1, 2 or 4 periods per turn.
 * The steam arrows and the blade pattern of the turbine move with the shaft (exaggerated: the drawn blade pattern turns
 * at the rotor's slowed speed).
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 300;
const CY = 140;
const RO = 96; // stator outside
const RI = 70; // stator inside (bore)
const slots = Array.from({ length: 24 }, (_, k) => {
	const a = (k / 24) * 2 * Math.PI;
	const c = Math.cos(a);
	const s = Math.sin(a);
	return { x: CX + (RI + 7) * c, y: CY + (RI + 7) * s, deg: (a * 180) / Math.PI };
});
---

<G7Styles />
<figure class="g7 g7--pic pgp not-content" data-pgp>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 440 296" role="img" aria-label="Схема генератора электростанции. Слева пар вращает турбину, её вал входит в генератор. Справа генератор с торца: неподвижный статор с обмотками и вращающийся внутри ротор-электромагнит с полюсами N и S. Ток в обмотке статора меняет направление каждый раз, когда мимо неё проходит полюс">
			<!-- side view -->
			<text class="pgp__lbl" x="56" y="66" text-anchor="middle">Турбина</text>
			<g data-steam></g>
			<path class="pgp__case" d="M22 92 L92 76 V164 L22 148 Z"></path>
			<clipPath id="pgp-clip"><path d="M24 94 L90 79 V161 L24 146 Z"></path></clipPath>
			<g clip-path="url(#pgp-clip)" data-blades></g>
			<rect class="pgp__shaft" x="92" y="116" width="40" height="8"></rect>
			<text class="pgp__lbl" x="112" y="140" text-anchor="middle">Вал</text>
			<rect class="pgp__house" x="132" y="96" width="44" height="48" rx="6"></rect>
			<path class="pgp__zoom" d={`M176 96 L${CX} ${CY - RO} M176 144 L${CX} ${CY + RO}`}></path>
			<text class="t-small" x="154" y="160" text-anchor="middle">генератор</text>
			<!-- end view: stator -->
			<text class="t-small" x="288" y="18" text-anchor="end">генератор с торца</text>
			<circle class="pgp__stator" cx={CX} cy={CY} r={(RO + RI) / 2} stroke-width={RO - RI}></circle>
			{slots.map((s) => <rect class="pgp__slot" x={s.x - 4} y={s.y - 3} width="8" height="6" transform={`rotate(${s.deg.toFixed(1)} ${s.x.toFixed(1)} ${s.y.toFixed(1)})`}></rect>)}
			<g data-coil></g>
			<!-- rotor -->
			<g data-rotor></g>
			<!-- leads -->
			<path class="pgp__lead" d={`M${CX - 3} ${CY - RO + 4} V10 H428 M${CX + 3} ${CY - RO + 4} V16 H428`}></path>
			<path class="pgp__arr" d="" data-la></path>
			<path class="pgp__arrh" d="" data-lh></path>
			<text class="pgp__lbl" x="428" y="32" text-anchor="end">в сеть</text>
			<!-- labels with leaders -->
			<path class="pgp__leader" d={`M198 214 L${CX - 30} ${CY + 30}`}></path>
			<text class="pgp__lbl" x="196" y="222" text-anchor="end">Ротор (электромагнит)</text>
			<path class="pgp__leader" d={`M330 254 L${CX + 40} ${CY + 76}`}></path>
			<text class="pgp__lbl" x="300" y="266" text-anchor="middle">Статор с обмотками</text>
			<!-- the trace -->
			<text class="t-small" x="18" y="246">ток в обмотке за один оборот ротора</text>
			<path class="pgp__axis" d="M18 256 V292 M18 274 H196"></path>
			<path class="pgp__trace" d="" data-trace></path>
		</svg>
		<div class="g7__row pgp__row">
			<div class="g7__seg" data-seg>
				<button type="button" class="g7__btn" aria-pressed="true" data-p="1">1 пара полюсов</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="2">2 пары</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="4">4 пары</button>
			</div>
		</div>
		<p class="pgp__read" data-read></p>
	</div>
	<figcaption class="pgp__cap">Вращение замедлено в 200 раз.</figcaption>
</figure>

<script>
	import { loop, el, set } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	const CX = 300;
	const CY = 140;
	const RI = 70;
	const RR = 64; // rotor radius (pole faces)

	document.querySelectorAll<HTMLElement>('[data-pgp]').forEach((root) => {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const rotorG = $<SVGGElement>('[data-rotor]');
		const coilG = $<SVGGElement>('[data-coil]');
		const blades = $<SVGGElement>('[data-blades]');
		const steam = $<SVGGElement>('[data-steam]');
		const trace = $<SVGPathElement>('[data-trace]');
		const la = $<SVGPathElement>('[data-la]');
		const lh = $<SVGPathElement>('[data-lh]');
		const read = $<HTMLElement>('[data-read]');
		let p = 1;
		let t = 0; // s on the screen
		let rotor: SVGGElement;
		let sides: { g: SVGGElement; x: number; y: number }[] = [];
		// turbine blades: 4 rows, each a stripe pattern that moves with the turning
		const rows = [30, 44, 58, 72].map((x, k) => {
			const h = 26 + 8 * k;
			const g = el('g');
			blades.append(g);
			return { x, h, g };
		});
		const steamArrows = Array.from({ length: 3 }, (_, k) => {
			const pth = el('path', { class: 'pgp__steam' });
			steam.append(pth);
			return { pth, y: 106 + 14 * k };
		});
		const build = () => {
			rotorG.replaceChildren();
			coilG.replaceChildren();
			rotor = el('g');
			rotorG.append(rotor);
			const n = 2 * p;
			// the rotor body
			rotor.append(el('circle', { class: 'pgp__rcore', cx: 0, cy: 0, r: RR - 14 }));
			for (let k = 0; k < n; k++) {
				const a = (k / n) * 2 * Math.PI;
				const half = Math.min(0.5, (Math.PI / n) * 0.62);
				const r0 = RR - 18;
				const pts = [
					[r0, -half * 0.55],
					[RR, -half],
					[RR, half],
					[r0, half * 0.55],
				];
				const d =
					`M${f(pts[0][0] * Math.cos(a + pts[0][1]))} ${f(pts[0][0] * Math.sin(a + pts[0][1]))}` +
					`L${f(RR * Math.cos(a - half))} ${f(RR * Math.sin(a - half))}` +
					`A${RR} ${RR} 0 0 1 ${f(RR * Math.cos(a + half))} ${f(RR * Math.sin(a + half))}` +
					`L${f(pts[3][0] * Math.cos(a + pts[3][1]))} ${f(pts[3][0] * Math.sin(a + pts[3][1]))}Z`;
				const g = el('g');
				g.append(el('path', { class: k % 2 ? 'pgp__s' : 'pgp__n', d }));
				const lx = (RR - 9) * Math.cos(a);
				const ly = (RR - 9) * Math.sin(a);
				g.append(el('text', { class: 'pgp__pl', x: f(lx), y: f(ly + 4), 'text-anchor': 'middle', 'data-deg': ((a * 180) / Math.PI).toFixed(1) }, k % 2 ? 'S' : 'N'));
				rotor.append(g);
			}
			rotor.append(el('circle', { class: 'pgp__hub', cx: 0, cy: 0, r: 9 }));
			// the colored coil: sides at −90° ± 90°/p
			const pitch = Math.PI / p;
			const a1 = -Math.PI / 2 - pitch / 2;
			const a2 = -Math.PI / 2 + pitch / 2;
			const rs = RI + 7;
			const re = 90; // the end turn runs on the outer part of the stator's face
			const end = el('path', {
				class: 'pgp__end',
				d: `M${f(CX + rs * Math.cos(a1))} ${f(CY + rs * Math.sin(a1))}L${f(CX + re * Math.cos(a1))} ${f(CY + re * Math.sin(a1))}A${re} ${re} 0 0 1 ${f(CX + re * Math.cos(a2))} ${f(CY + re * Math.sin(a2))}L${f(CX + rs * Math.cos(a2))} ${f(CY + rs * Math.sin(a2))}`,
			});
			coilG.append(end);
			sides = [a1, a2].map((a) => {
				const g = el('g');
				coilG.append(g);
				return { g, x: CX + rs * Math.cos(a), y: CY + rs * Math.sin(a) };
			});
			read.innerHTML = `Чтобы частота была 50&nbsp;Гц, ротор делает <b>${3000 / p}&nbsp;об/мин</b> (${50 / p === 12.5 ? '12,5' : 50 / p}&nbsp;об/с).`;
		};
		const mark = (g: SVGGElement, x: number, y: number, s: number) => {
			// s > 0: ⊙ (toward us), s < 0: ⊗ (away); size ∝ |s|
			g.replaceChildren();
			const r = 2 + 4 * Math.abs(s);
			g.append(el('circle', { class: 'pgp__cur', cx: f(x), cy: f(y), r: f(r) }));
			if (s > 0.05) g.append(el('circle', { class: 'pgp__curdot', cx: f(x), cy: f(y), r: f(Math.max(1, r * 0.3)) }));
			else if (s < -0.05) {
				const q = r * 0.62;
				g.append(el('path', { class: 'pgp__curx', d: `M${f(x - q)} ${f(y - q)}L${f(x + q)} ${f(y + q)}M${f(x + q)} ${f(y - q)}L${f(x - q)} ${f(y + q)}` }));
			}
		};
		const TT = 4; // с per period of the current on the screen
		const iAt = (tt: number) => Math.sin((2 * Math.PI * tt) / TT);
		const draw = () => {
			const Trot = TT * p;
			const th = (2 * Math.PI * t) / Trot; // rotor angle (clockwise on the screen)
			// pole 0 (N) starts at the top: Δ = th
			rotor.setAttribute('transform', `translate(${CX} ${CY}) rotate(${f((th * 180) / Math.PI - 90)})`);
			// keep the pole letters upright
			rotor.querySelectorAll<SVGTextElement>('text').forEach((tx) => {
				const x = Number(tx.getAttribute('x'));
				const y = Number(tx.getAttribute('y')) - 4;
				tx.setAttribute('transform', `rotate(${f(-((th * 180) / Math.PI - 90))} ${f(x)} ${f(y)})`);
			});
			const i = iAt(t); // ∝ sin(p·Δ)
			mark(sides[0].g, sides[0].x, sides[0].y, i);
			mark(sides[1].g, sides[1].x, sides[1].y, -i);
			// the lead arrow: on the upper lead, to the right when i > 0
			const L = 30 * Math.abs(i);
			if (L > 3) {
				const d = Math.sign(i);
				const x2 = 380 + (d * L) / 2;
				la.setAttribute('d', `M${f(380 - (d * L) / 2)} 10H${f(x2 - d * 5)}`);
				lh.setAttribute('d', `M${f(x2 + d)} 10L${f(x2 - d * 7)} 5.5L${f(x2 - d * 7)} 14.5Z`);
			} else {
				la.setAttribute('d', '');
				lh.setAttribute('d', '');
			}
			// the trace: the last turn of the rotor
			let dd = '';
			const t0 = t - Trot;
			for (let k = 0; k <= 160; k++) {
				const tt = t0 + (Trot * k) / 160;
				const y = tt < 0 ? 0 : iAt(tt);
				dd += `${k ? 'L' : 'M'}${f(18 + (178 * k) / 160)} ${f(274 - 15 * y)}`;
			}
			trace.setAttribute('d', dd);
			// turbine: the blade stripes move with the turn; the steam flows in
			rows.forEach((r, k) => {
				r.g.replaceChildren();
				const pitch = 7;
				const off = ((th * 30) % pitch + pitch) % pitch;
				for (let y = 120 - r.h / 2 - pitch + off; y < 120 + r.h / 2; y += pitch) {
					if (y < 120 - r.h / 2) continue;
					r.g.append(el('path', { class: 'pgp__blade', d: `M${r.x - 3} ${f(y)}L${r.x + 3} ${f(y + 3)}` }));
				}
				r.g.append(el('path', { class: 'pgp__disc', d: `M${r.x} ${120 - r.h / 2}V${120 + r.h / 2}` }));
				void k;
			});
			steamArrows.forEach((s, k) => {
				const q = ((t * 0.5 + k / 3) % 1 + 1) % 1;
				const x = 2 + 18 * q;
				s.pth.setAttribute('d', `M${f(x - 10)} ${s.y}H${f(x)}M${f(x - 4)} ${s.y - 3.5}L${f(x + 1)} ${s.y}L${f(x - 4)} ${s.y + 3.5}`);
				s.pth.style.opacity = f(Math.sin(Math.PI * q));
			});
		};
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-p]')];
		for (const b of btns)
			b.addEventListener('click', () => {
				for (const o of btns) o.setAttribute('aria-pressed', String(o === b));
				p = Number(b.dataset.p);
				t = 0;
				build();
				draw();
			});
		build();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
		void set;
	});
</script>

<style is:global>
	.pgp .g7__svg {
		max-width: 38rem;
		margin-inline: auto;
	}
	.pgp .g7__svg .pgp__lbl {
		font-size: 12.5px;
		fill: var(--sl-color-gray-1);
	}
	.pgp__case {
		fill: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.pgp__blade {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.pgp__disc {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.pgp__steam {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.pgp__shaft {
		fill: var(--sl-color-gray-3);
	}
	.pgp__house {
		fill: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.pgp__zoom {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-dasharray: 3 3;
	}
	.pgp__stator {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-5));
	}
	.pgp__slot {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-4));
	}
	.pgp__end {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 62%, var(--sl-color-gray-3));
		stroke-width: 4;
		stroke-linecap: round;
	}
	.pgp__cur {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-green);
		stroke-width: 1.6;
	}
	.pgp__curdot {
		fill: var(--sl-color-green);
	}
	.pgp__curx {
		stroke: var(--sl-color-green);
		stroke-width: 1.6;
	}
	.pgp__rcore {
		fill: var(--sl-color-gray-4);
	}
	.pgp__n {
		fill: var(--ig-vx);
	}
	.pgp__s {
		fill: var(--ig-vy);
	}
	.pgp .g7__svg .pgp__pl {
		fill: white;
		font-weight: 700;
		font-size: 12px;
	}
	.pgp__hub {
		fill: var(--sl-color-gray-3);
	}
	.pgp__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	.pgp__arr {
		stroke: var(--sl-color-green);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.pgp__arrh {
		fill: var(--sl-color-green);
	}
	.pgp__leader {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.pgp__axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.pgp__trace {
		fill: none;
		stroke: var(--sl-color-green);
		stroke-width: 2;
	}
	.pgp__row {
		justify-content: center;
	}
	.pgp__read {
		margin: 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pgp__read b {
		color: var(--sl-color-white);
	}
	.pgp__cap {
		margin-top: 0.5rem;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
