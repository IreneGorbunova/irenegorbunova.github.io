---
/**
 * «Где это встречается»: four small tiles with a light looping animation each (2 × 2 on a wide screen, one column at
 * 390 px).
 *  1. «Трансформатор во дворе»: a brick kiosk with a door and a lightning sign, three wires on insulators on its roof;
 *     faint arcs of its hum pulse (the hum is 100 Гц: the steel plates of the core shrink and stretch twice per period;
 *     the arcs pulse slower, it is a sign, not the frequency).
 *  2. «Электровоз»: an electric locomotive under the contact wire with its pantograph pressed up to it; the catenary
 *     masts run past (the train goes right), a small spark at the pantograph now and then.
 *  3. «Сварочный аппарат»: the welding transformer (a box with a dial), one cable to a clamp on the steel plate, the
 *     other to the electrode holder, whose handle leaves the tile at the top (the welder is outside the picture); the arc
 *     flickers white-blue, sparks fly in ballistic arcs (g is not to scale), the seam behind the arc glows and cools.
 *  4. «Зарядное устройство»: a phone charger cut open: the plug's pins, a small board, on it a ferrite transformer (an
 *     E-shaped dark core with copper windings) about 1 см across (a scale bar «1 см»); green dots of the current run
 *     in the cable to the phone.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic usp not-content" data-usp>
	<div class="usp__grid">
		<div class="usp__tile">
			<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Кирпичная трансформаторная будка во дворе со знаком молнии на двери, сверху к ней подходят три провода">
				<rect class="usp__sky" x="0" y="0" width="200" height="112"></rect>
				<rect class="usp__grass" x="0" y="112" width="200" height="18"></rect>
				<path class="usp__wire" d="M0 26 Q40 34 74 40 M0 32 Q40 40 100 40 M0 38 Q60 44 126 40"></path>
				<path class="usp__brick" d="M60 112 V52 H140 V112 Z"></path>
				<path class="usp__mortar" d="M60 62 H140 M60 72 H140 M60 82 H140 M60 92 H140 M60 102 H140 M70 52 V62 M90 52 V62 M110 52 V62 M130 52 V62 M80 62 V72 M100 62 V72 M120 62 V72 M70 72 V82 M130 72 V82 M70 92 V102 M130 92 V102 M80 102 V112 M120 102 V112"></path>
				<path class="usp__roof" d="M54 52 H146 L140 46 H60 Z"></path>
				<path class="usp__ins" d="M74 46 V40 M100 46 V40 M126 46 V40"></path>
				<rect class="usp__door" x="84" y="74" width="32" height="38" rx="1"></rect>
				<path class="usp__sign" d="M94 80 h12 v12 h-12 Z"></path>
				<path class="usp__bolt" d="M101 81 l-3.5 5.5 h3 l-2.5 5 l5.5 -6.5 h-3 l2.5 -4 Z"></path>
				<g data-hum><path class="usp__hum" d="M148 70 q6 10 0 20 M156 66 q9 14 0 28 M164 62 q12 18 0 36"></path></g>
			</svg>
			<p>Трансформатор во дворе</p>
		</div>
		<div class="usp__tile">
			<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Электровоз под контактным проводом, токоприёмник прижат к проводу">
				<rect class="usp__sky" x="0" y="0" width="200" height="104"></rect>
				<rect class="usp__grass" x="0" y="104" width="200" height="26"></rect>
				<g data-masts></g>
				<path class="usp__cat" d="M0 22 H200 M0 14 Q50 22 100 14 Q150 22 200 14"></path>
				<path class="usp__rail" d="M0 106 H200 M0 110 H200"></path>
				<path class="usp__panto" d="M86 52 L100 34 L114 52 M94 26 L100 34 L106 26 M90 23 H110"></path>
				<path class="usp__loco" d="M44 98 V60 Q46 52 56 52 H150 Q162 52 168 64 L172 98 Z"></path>
				<path class="usp__win" d="M154 58 H162 Q166 62 168 70 H154 Z M60 62 h14 v10 h-14 Z M82 62 h14 v10 h-14 Z M104 62 h14 v10 h-14 Z M126 62 h14 v10 h-14 Z"></path>
				<path class="usp__stripe" d="M44 82 H171"></path>
				<circle class="usp__wheel" cx="64" cy="100" r="6"></circle>
				<circle class="usp__wheel" cx="84" cy="100" r="6"></circle>
				<circle class="usp__wheel" cx="132" cy="100" r="6"></circle>
				<circle class="usp__wheel" cx="152" cy="100" r="6"></circle>
				<circle class="usp__spark" cx="100" cy="22" r="3" data-pspark></circle>
			</svg>
			<p>Электровоз</p>
		</div>
		<div class="usp__tile">
			<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Сварочный аппарат: от сварочного трансформатора идут два кабеля — к зажиму на стальной пластине и к держателю электрода; на шве горит дуга и летят искры">
				<rect class="usp__wall" x="0" y="0" width="200" height="98"></rect>
				<rect class="usp__table" x="0" y="98" width="200" height="32"></rect>
				<rect class="usp__box" x="10" y="54" width="52" height="44" rx="3"></rect>
				<circle class="usp__dial" cx="36" cy="72" r="9"></circle>
				<path class="usp__needle" d="M36 72 L41 66"></path>
				<rect class="usp__steel" x="92" y="90" width="98" height="8"></rect>
				<path class="usp__seam" d="M110 90 H150" data-seam></path>
				<path class="usp__cable" d="M54 92 Q70 112 96 96 M58 60 Q100 20 168 18"></path>
				<rect class="usp__clamp" x="94" y="86" width="8" height="6" rx="1"></rect>
				<path class="usp__holder" d="M200 6 L168 18 L158 30"></path>
				<path class="usp__electrode" d="M158 30 L152 88"></path>
				<circle class="usp__arc" cx="152" cy="89" r="10" data-arc></circle>
				<g data-sparks></g>
			</svg>
			<p>Сварочный аппарат</p>
		</div>
		<div class="usp__tile">
			<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Зарядное устройство телефона в разрезе: на маленькой плате стоит крошечный трансформатор размером около сантиметра">
				<rect class="usp__wall" x="0" y="0" width="200" height="130"></rect>
				<path class="usp__pin" d="M14 52 H34 M14 78 H34"></path>
				<rect class="usp__case" x="34" y="30" width="92" height="70" rx="8"></rect>
				<rect class="usp__board" x="42" y="40" width="76" height="50" rx="2"></rect>
				<!-- the ferrite transformer: an E core with windings, 1 см = 24 px -->
				<path class="usp__ferrite" d="M60 50 h24 v30 h-24 Z"></path>
				<rect class="usp__coil" x="63" y="56" width="18" height="18" rx="2"></rect>
				<path class="usp__coilw" d="M63 59 H81 M63 62 H81 M63 65 H81 M63 68 H81 M63 71 H81"></path>
				<rect class="usp__cap" x="92" y="48" width="9" height="14" rx="2"></rect>
				<rect class="usp__chip" x="92" y="68" width="16" height="12" rx="1"></rect>
				<path class="usp__scale" d="M60 94 H84 M60 91 V97 M84 91 V97"></path>
				<text class="usp__sct" x="72" y="111" text-anchor="middle">1 см</text>
				<path class="usp__usb" d="M126 66 H140 Q160 66 170 80 Q178 92 192 92" data-cable></path>
				<g data-cdots></g>
			</svg>
			<p>Зарядное устройство</p>
		</div>
	</div>
</figure>

<script>
	import { loop, el } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	const rnd = (k: number) => {
		const s = Math.sin(k * 127.1 + 311.7) * 43758.5453;
		return s - Math.floor(s);
	};
	document.querySelectorAll<HTMLElement>('[data-usp]').forEach((root) => {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const hum = $<SVGGElement>('[data-hum]');
		const masts = $<SVGGElement>('[data-masts]');
		const mastEls = [0, 1].map(() => masts.appendChild(el('path', { class: 'usp__mast' })));
		const pspark = $<SVGCircleElement>('[data-pspark]');
		const arc = $<SVGCircleElement>('[data-arc]');
		const seam = $<SVGPathElement>('[data-seam]');
		const sparksG = $<SVGGElement>('[data-sparks]');
		const sparks = Array.from({ length: 8 }, () => sparksG.appendChild(el('circle', { class: 'usp__sp', r: 1.1 })));
		const cable = $<SVGPathElement>('[data-cable]');
		const CL = cable.getTotalLength();
		const cdG = $<SVGGElement>('[data-cdots]');
		const cdots = Array.from({ length: 6 }, (_, k) => ({ c: cdG.appendChild(el('circle', { class: 'usp__dot', r: 1.8 })), s0: (k * CL) / 6 }));
		let t = 0;
		const draw = () => {
			hum.style.opacity = f(0.25 + 0.6 * Math.abs(Math.sin(Math.PI * t * 1.5)));
			// masts run left (the train goes right) at 40 px/с, 120 px apart
			mastEls.forEach((m, k) => {
				const x = ((((k * 120 - t * 40) % 240) + 240) % 240) - 20;
				m.setAttribute('d', `M${f(x)} 104 V8 M${f(x)} 12 H${f(x + 14)} M${f(x)} 20 H${f(x + 10)}`);
			});
			pspark.style.opacity = rnd(Math.floor(t * 8)) > 0.85 ? '1' : '0';
			// the arc flickers; sparks fly from it
			arc.style.opacity = f(0.55 + 0.45 * rnd(Math.floor(t * 20)));
			seam.style.opacity = f(0.6 + 0.3 * rnd(Math.floor(t * 6) + 50));
			sparks.forEach((s, k) => {
				const life = 0.6;
				const ph = (t + k * 0.13) % life;
				const n = Math.floor((t + k * 0.13) / life);
				const vx = (rnd(n * 11 + k) - 0.5) * 90;
				const vy = -40 - 50 * rnd(n * 7 + k);
				s.setAttribute('cx', f(152 + vx * ph));
				s.setAttribute('cy', f(88 + vy * ph + 0.5 * 260 * ph * ph));
				s.style.opacity = f(1 - ph / life);
			});
			for (const d of cdots) {
				const p = cable.getPointAtLength((d.s0 + t * 22) % CL);
				d.c.setAttribute('cx', f(p.x));
				d.c.setAttribute('cy', f(p.y));
			}
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	});
</script>

<style is:global>
	.usp__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@media (max-width: 34rem) {
		.usp__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.usp__tile p {
		margin: 0.35rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.usp__sky {
		fill: color-mix(in srgb, var(--ig-vx) 22%, var(--sl-color-gray-6));
	}
	.usp__grass {
		fill: color-mix(in oklab, hsl(100, 40%, 42%) 45%, var(--sl-color-gray-5));
	}
	.usp__wall {
		fill: color-mix(in srgb, var(--ig-v) 8%, var(--sl-color-gray-6));
	}
	.usp__table {
		fill: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-4));
	}
	.usp__wire,
	.usp__cat {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.usp__brick {
		fill: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-4));
	}
	.usp__mortar {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 20%, var(--sl-color-gray-3));
		stroke-width: 0.6;
	}
	.usp__roof {
		fill: var(--sl-color-gray-4);
	}
	.usp__ins {
		stroke: hsl(190, 40%, 72%);
		stroke-width: 2.4;
		stroke-dasharray: 1.2 0.8;
	}
	.usp__door {
		fill: color-mix(in oklab, var(--ig-vx) 20%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
	.usp__sign {
		fill: var(--ig-v);
	}
	.usp__bolt {
		fill: hsl(0, 0%, 10%);
	}
	.usp__hum {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.usp__mast {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.usp__rail {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.usp__panto {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.usp__loco {
		fill: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
	.usp__win {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-5));
	}
	.usp__stripe {
		stroke: var(--ig-v);
		stroke-width: 3;
	}
	.usp__wheel {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
	}
	.usp__spark {
		fill: hsl(200, 100%, 85%);
	}
	.usp__box {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
	.usp__dial {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
	}
	.usp__needle {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
	}
	.usp__steel {
		fill: var(--sl-color-gray-3);
	}
	.usp__seam {
		stroke: hsl(25, 100%, 60%);
		stroke-width: 2.4;
	}
	.usp__cable {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 3;
	}
	:root[data-theme='light'] .usp__cable {
		stroke: var(--sl-color-gray-2);
	}
	.usp__clamp {
		fill: hsl(0, 70%, 45%);
	}
	.usp__holder {
		fill: none;
		stroke: hsl(220, 15%, 25%);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.usp__electrode {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.usp__arc {
		fill: hsl(200, 100%, 92%);
		filter: blur(2px);
	}
	.usp__sp {
		fill: hsl(45, 100%, 70%);
	}
	.usp__pin {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.usp__case {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 70%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
	}
	.usp__board {
		fill: hsl(150, 45%, 28%);
	}
	.usp__ferrite {
		fill: hsl(220, 8%, 22%);
	}
	.usp__coil {
		fill: color-mix(in oklab, var(--ig-v) 70%, hsl(25, 60%, 40%));
	}
	.usp__coilw {
		stroke: hsl(25, 60%, 30%);
		stroke-width: 0.6;
	}
	.usp__cap {
		fill: hsl(220, 30%, 30%);
	}
	.usp__chip {
		fill: hsl(0, 0%, 12%);
	}
	.usp__scale {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.usp .g7__svg .usp__sct {
		font-size: 11px;
		fill: var(--sl-color-gray-1);
	}
	.usp__usb {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.usp__dot {
		fill: var(--sl-color-green);
	}
</style>
