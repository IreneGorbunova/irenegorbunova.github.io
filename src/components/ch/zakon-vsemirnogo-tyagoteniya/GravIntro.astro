<script>
	import { scene } from '@components/intro/scene';
	import { figure } from '@components/people/body';
	import { suited } from './suit';

	const fmt1 = (v: number) => v.toFixed(1).replace('.', ',');
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};

	/**
	 * One jumper: crouch (0,5 с, hips 25 см down), push (hips up with constant acceleration until they move at V0),
	 * `hops` flights of 2·V0/g each with springy contacts of `C` с between them, a landing that stops the hips within
	 * 20 см and a rise back to standing. Returns, at time t, the height of the soles (м), the dip of the hips below
	 * standing (м, ≤ 0), the arm swing (−1 back … 0 hanging … 1,4 up and forward), the jumps done and the time spent in the air.
	 */
	const V0 = 2.2;
	const D = 0.25;
	const TC = 0.5;
	const AP = (V0 * V0) / (2 * D);
	const TP = (2 * D) / V0;
	const C = 0.2;
	const DL = 0.2;
	const TL = (Math.PI * DL) / (2 * V0);
	const TR = 0.6;
	type St = { feet: number; z: number; s: number; air: number; n: number; ground: boolean; toe: number };
	const jumper = (g: number, hops: number) => {
		const T = (2 * V0) / g;
		const total = TC + TP + hops * T + (hops - 1) * C + TL + TR;
		const at = (t: number): St => {
			if (t < TC) {
				const k = ease(t / TC);
				return { feet: 0, z: -D * k, s: -k, air: 0, n: 0, ground: true, toe: 0 };
			}
			let u = t - TC;
			if (u < TP) return { feet: 0, z: -D + 0.5 * AP * u * u, s: -1 + 2.4 * ease(u / TP), air: 0, n: 0, ground: true, toe: 0 };
			u -= TP;
			let first = true;
			for (let i = 0; i < hops; i++) {
				if (u < T) {
					const f = u / T;
					// the arms swing up in flight (held up after the first push) and come forward for the landing
					const up = first && f < 0.5 ? 1 : Math.pow(Math.sin(Math.PI * f), 0.7);
					return { feet: V0 * u - (g * u * u) / 2, z: 0, s: 0.35 + 1.05 * up, air: i * T + u, n: i, ground: false, toe: 0.22 * Math.sin(Math.PI * f) };
				}
				u -= T;
				if (i < hops - 1) {
					if (u < C) {
						const f = u / C;
						return { feet: 0, z: -((V0 * C) / Math.PI) * Math.sin(Math.PI * f), s: 0.35 - 0.6 * Math.sin(Math.PI * f), air: (i + 1) * T, n: i + 1, ground: true, toe: 0 };
					}
					u -= C;
					first = false;
				}
			}
			const air = hops * T;
			if (u < TL) {
				const f = u / TL;
				return { feet: 0, z: -DL * Math.sin((Math.PI / 2) * f), s: 0.35 + 0.1 * Math.sin((Math.PI / 2) * f), air, n: hops, ground: true, toe: 0 };
			}
			const k = ease((u - TL) / TR);
			return { feet: 0, z: -DL * (1 - k), s: 0.45 * (1 - k), air, n: hops, ground: true, toe: 0 };
		};
		return { at, total };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-gravintro]')) {
		// ---------- Jump: real time ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="jump"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const GND = 200;
			const PXM = 50;
			const s = PXM / 100; // px per см
			const H = 175;
			const u = s * H;
			const earth = figure($<SVGGElement>('[data-pe]'), { s, H, clothes: 'indoor', shorts: true, shirt: 'hm-red', hair: 'short', name: 'earth-jumper' });
			const moon = suited($<SVGGElement>('[data-pm]'), { s, H, dir: -1, name: 'moon-jumper' });
			const legE = (earth.bones.thigh + earth.bones.shin) * 0.995;
			const legM = (moon.bones.thigh + moon.bones.shin) * 0.995;
			const shE = $<SVGEllipseElement>('[data-she]');
			const shM = $<SVGEllipseElement>('[data-shm]');
			const ce = $<SVGTextElement>('[data-ce]');
			const cm = $<SVGTextElement>('[data-cm]');
			const ae = $<SVGTextElement>('[data-ae]');
			const am = $<SVGTextElement>('[data-am]');
			const jE = jumper(9.8, 6);
			const jM = jumper(1.62, 1);
			const RUN = Math.max(jE.total, jM.total); // 5,16 с
			// upper-arm angle (right-facing, screen radians) and elbow bend for an arm swing s
			const armOf = (sw: number, dir: 1 | -1, far: boolean): [number, number] => {
				const a = (sw < 0 ? 1.62 - sw * 0.63 : 1.62 - sw * 1.97) + (far ? 0.12 : 0);
				const bend = (sw < 0 ? 12 + 2 * sw : 12 + 13 * sw) * (Math.PI / 180) + (far ? 0.1 : 0);
				return [dir > 0 ? a : Math.PI - a, bend];
			};
			type Fig = { pose: (q: Parameters<typeof earth.pose>[0]) => unknown };
			const place = (fig: Fig, x0: number, dir: 1 | -1, st: St, ankleCm: number, leg: number, sh: SVGEllipseElement) => {
				const k = Math.min(1, Math.max(0, -st.z / D));
				const ankleY = GND - ankleCm * s - st.feet * PXM;
				const hipY = GND - ankleCm * s - leg - st.feet * PXM - st.z * PXM;
				const lean = 0.06 + 0.42 * k;
				fig.pose({
					hip: { x: x0 - dir * 0.07 * u * k, y: hipY },
					lean,
					head: -0.45 * lean,
					ankles: [
						{ x: x0 + dir * 2.5, y: ankleY },
						{ x: x0 - dir * 2.5, y: ankleY },
					],
					feet: [st.toe, st.toe * 1.1],
					planted: [st.ground, st.ground],
					hands: [
						{ arm: armOf(st.s, dir, false), pose: 'relaxed' },
						{ arm: armOf(st.s * 0.9, dir, true), pose: 'relaxed' },
					],
				});
				const q = 1 - 0.45 * Math.min(1, st.feet / 1.5);
				sh.setAttribute('rx', (11 * q).toFixed(2));
				sh.setAttribute('opacity', (0.3 * q).toFixed(2));
			};
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const e = jE.at(t);
				const m = jM.at(t);
				place(earth, 88, 1, e, 7, legE, shE);
				place(moon, 268, -1, m, 8, legM, shM);
				ce.textContent = `прыжков: ${e.n}`;
				cm.textContent = `прыжков: ${m.n}`;
				ae.textContent = `в воздухе: ${fmt1(e.air)} с`;
				am.textContent = `в воздухе: ${fmt1(m.air)} с`;
			});
		}

		// ---------- Station: one revolution, 93 мин in 9 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="station"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const st = $<SVGGElement>('[data-st]');
			const land = $<SVGGElement>('[data-land]');
			const trail = $<SVGPathElement>('[data-trail]');
			const tan = $<SVGLineElement>('[data-tan]');
			const pull = $<SVGLineElement>('[data-pull]');
			const call = $<SVGLineElement>('[data-call]');
			const astro = $<SVGGElement>('[data-astro]');
			const apple = $<SVGGElement>('[data-apple]');
			const drop = $<SVGGElement>('[data-drop]');
			const dropBody = $<SVGEllipseElement>('[data-drop-body]');
			const mins = $<SVGTextElement>('[data-min]');
			const E = { x: 106, y: 126, r: 86 };
			const RO = (E.r * (6371 + 420)) / 6371;
			const IN = { x: 292, y: 78, r: 60 };
			const PERIOD = 93; // мин
			const DAY = 1436; // мин, one turn of the Earth
			const PHI0 = 100; // degrees, the start: near the top
			const rad = Math.PI / 180;
			const pos = (deg: number) => [E.x + RO * Math.cos(deg * rad), E.y - RO * Math.sin(deg * rad)];
			// the astronaut: 1,75 м at 0,3 px per см, the hip joint at the origin of his group
			const man = figure($<SVGGElement>('[data-astro-fig]'), { s: 0.3, H: 175, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'astronaut' });
			const floatPose = (b: number) =>
				man.pose({
					hip: { x: 0, y: 0 },
					lean: 0.12,
					head: -0.12,
					ankles: [
						{ x: 0, y: 20 },
						{ x: 0, y: 20 },
					],
					legs: [
						[Math.PI / 2 - 0.8 - 0.04 * b, 0.95 + 0.05 * b],
						[Math.PI / 2 - 0.7 + 0.04 * b, 1.1 - 0.05 * b],
					],
					feet: [0.35, 0.4],
					hands: [
						{ arm: [0.95 - 0.08 * b, (72 + 6 * b) * rad], pose: 'relaxed' },
						{ arm: [0.8 + 0.08 * b, (80 - 6 * b) * rad], pose: 'relaxed' },
					],
				});
			scene(card, 9, (x) => {
				const phi = PHI0 + 360 * x; // counterclockwise
				const [sx, sy] = pos(phi);
				// the direction of motion (counterclockwise, screen y down)
				const tx = -Math.sin(phi * rad);
				const ty = -Math.cos(phi * rad);
				const ang = Math.atan2(ty, tx) / rad;
				st.setAttribute('transform', `translate(${sx.toFixed(2)} ${sy.toFixed(2)}) rotate(${ang.toFixed(1)})`);
				land.setAttribute('transform', `rotate(${(-(360 * PERIOD * x) / DAY).toFixed(2)} ${E.x} ${E.y})`);
				// the path already flown
				const steps = Math.max(1, Math.round(72 * x));
				let d = '';
				for (let k = 0; k <= steps; k++) {
					const [px, py] = pos(PHI0 + (360 * x * k) / steps);
					d += `${k ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)} `;
				}
				trail.setAttribute('d', x > 0.002 ? d : '');
				// without the pull: straight on; the pull: towards the center of the Earth
				tan.setAttribute('x1', sx.toFixed(1));
				tan.setAttribute('y1', sy.toFixed(1));
				tan.setAttribute('x2', (sx + 64 * tx).toFixed(1));
				tan.setAttribute('y2', (sy + 64 * ty).toFixed(1));
				const ux = (E.x - sx) / RO;
				const uy = (E.y - sy) / RO;
				pull.setAttribute('x1', (sx + 8 * ux).toFixed(1));
				pull.setAttribute('y1', (sy + 8 * uy).toFixed(1));
				pull.setAttribute('x2', (sx + 32 * ux).toFixed(1));
				pull.setAttribute('y2', (sy + 32 * uy).toFixed(1));
				// the callout to the inset
				const cx = IN.x - sx;
				const cy = IN.y - sy;
				const cl = Math.hypot(cx, cy);
				call.setAttribute('x1', (sx + (11 * cx) / cl).toFixed(1));
				call.setAttribute('y1', (sy + (11 * cy) / cl).toFixed(1));
				call.setAttribute('x2', (IN.x - (IN.r * cx) / cl).toFixed(1));
				call.setAttribute('y2', (IN.y - (IN.r * cy) / cl).toFixed(1));
				// inside: everything floats and drifts slowly; the arms and legs sway a little
				floatPose(Math.sin(2 * Math.PI * x));
				// drifts that come back to where they began, so the loop closes without a jerk
				const sw = Math.sin(Math.PI * x);
				astro.setAttribute('transform', `translate(${(IN.x - 14 + 5 * sw).toFixed(2)} ${(IN.y + 10 - 4 * sw).toFixed(2)}) rotate(${(-16 + 26 * sw).toFixed(1)})`);
				apple.setAttribute('transform', `translate(${(IN.x + 25 - 3 * sw).toFixed(2)} ${(IN.y - 2 + 5 * sw).toFixed(2)}) rotate(${(360 * x).toFixed(1)})`);
				drop.setAttribute('transform', `translate(${(IN.x + 38 + 3 * sw).toFixed(2)} ${(IN.y + 24 - 5 * sw).toFixed(2)})`);
				const w = 0.07 * Math.sin(2 * Math.PI * 3 * x);
				dropBody.setAttribute('rx', (3.6 * (1 + w)).toFixed(2));
				dropBody.setAttribute('ry', (3.6 * (1 - w)).toFixed(2));
				mins.textContent = `${Math.round(PERIOD * x)} мин`;
			});
		}
	}
</script>
