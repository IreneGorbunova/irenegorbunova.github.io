---
/**
 * Two short looping opening scenes of «Закон всемирного тяготения». No terms of the chapter in the pictures; the
 * captions' popovers explain.
 * Jump: two people push off the ground with the same speed, 2,2 м/с: on the Earth (g = 9,8 м/с²) and on the Moon
 *   (g = 1,62 м/с²). Real time and one scale (50 px per metre): on the Earth the jump is 25 см high and lasts
 *   0,45 с, on the Moon 1,5 м and 2,7 с, so the Earth jumper makes 6 jumps while the Moon jumper makes one.
 * Station: the Earth and the station's path to scale (radius 6371 км, height 420 км: the path runs 6 px above the
 *   ground). One revolution takes 93 мин (shown in 9 s); the Earth turns 23° in that time. The arrow shows the pull
 *   of the Earth, the dashed line where the station would fly without it. The inset: inside the station the
 *   astronaut, an apple and a drop of water float.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mArrow = `gi-ar-${uid}`;
const clipIn = `gi-clip-${uid}`;

// Jump scene
const GND = 214; // ground line, y
const PXM = 50; // px per metre
const V0 = 2.2; // м/с, the same push-off speed
const hE = (V0 * V0) / (2 * 9.8); // 0,247 м
const hM = (V0 * V0) / (2 * 1.62); // 1,49 м
const craters: [number, number, number][] = [
	[214, 226, 9],
	[262, 232, 6],
	[318, 224, 11],
	[346, 234, 5],
];

// Station scene: the Earth to scale with the station's path
const E = { x: 106, y: 126, r: 86 };
const RO = (E.r * (6371 + 420)) / 6371; // 91,7 px
const IN = { x: 292, y: 76, r: 58 }; // the inset
const stars: [number, number, number][] = [
	[14, 16, 0.8], [52, 30, 0.6], [196, 20, 0.9], [222, 156, 0.6], [214, 214, 0.8], [348, 162, 0.7], [250, 226, 0.6],
	[20, 226, 0.7], [338, 214, 0.9], [170, 228, 0.5], [236, 116, 0.5],
];
---

<IntroFrame data-gravintro>
	<div class="intro__card" data-scene="jump">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Два человека подпрыгивают, оттолкнувшись с одинаковой скоростью: слева на Земле, справа на Луне. На Земле прыжок высотой 25 сантиметров, на Луне — полтора метра. Пока человек на Луне прыгает один раз, человек на Земле успевает прыгнуть шесть раз">
			<rect class="gi-sky-e" x="0" y="0" width="179" height={GND}></rect>
			<rect class="gi-sky-m" x="181" y="0" width="179" height={GND}></rect>
			<circle class="gi-earth-small" cx="334" cy="62" r="10"></circle>
			<path class="gi-earth-small-shade" d="M334 52 A10 10 0 0 1 334 72 A6 10 0 0 0 334 52 Z"></path>
			<rect class="gi-ground-e" x="0" y={GND} width="179" height={240 - GND}></rect>
			<rect class="gi-ground-m" x="181" y={GND} width="179" height={240 - GND}></rect>
			{craters.map(([x, y, r]) => <ellipse class="gi-crater" cx={x} cy={y} rx={r} ry={r * 0.35} />)}
			<line class="gi-divide" x1="180" y1="0" x2="180" y2="240"></line>
			<text class="gi-title" x="10" y="24">Земля</text>
			<text class="gi-title" x="191" y="24">Луна</text>
			<text class="gi-count" x="10" y="44" data-ce>прыжков: 0</text>
			<text class="gi-count" x="191" y="44" data-cm>прыжков: 0</text>
			<!-- the highest point of the feet -->
			<line class="gi-top" x1="60" x2="124" y1={GND - hE * PXM} y2={GND - hE * PXM}></line>
			<text class="gi-mark" x="128" y={GND - hE * PXM + 4}>25 см</text>
			<line class="gi-top" x1="240" x2="304" y1={GND - hM * PXM} y2={GND - hM * PXM}></line>
			<text class="gi-mark" x="308" y={GND - hM * PXM + 4}>1,5 м</text>
			<!-- the Earth jumper: feet at (0, 0), 1,7 м = 85 px tall -->
			<g data-pe>
				<g class="gi-person">
					<circle cx="0" cy="-76" r="9"></circle>
					<path d="M0 -67 L0 -36 M0 -36 L-8 0 M0 -36 L8 0 M0 -60 L-14 -42 M0 -60 L14 -42"></path>
				</g>
			</g>
			<!-- the Moon jumper in a spacesuit -->
			<g data-pm>
				<g class="gi-suit">
					<rect class="gi-pack" x="-14" y="-64" width="9" height="24" rx="2"></rect>
					<path d="M0 -64 L0 -36 M0 -36 L-8 0 M0 -36 L8 0 M0 -58 L-14 -42 M0 -58 L14 -42"></path>
					<circle class="gi-helmet" cx="0" cy="-75" r="11"></circle>
					<path class="gi-visor" d="M2 -81 Q10 -79 9 -72 Q7 -67 2 -68 Z"></path>
				</g>
			</g>
			<rect class="gi-pill" x="150" y="52" width="60" height="22" rx="11"></rect>
			<text class="gi-read" x="180" y="68" text-anchor="middle" data-clock>0,0 с</text>
		</svg>
		<div class="intro__foot">
			<p>Оттолкнувшись с той же скоростью, на Луне человек подпрыгнет в 6 раз выше, чем на Земле, и пробудет в воздухе в 6 раз дольше: Луна <More term="притягивает тела в 6 раз слабее">Масса Луны в 81 раз меньше массы Земли, а радиус — в 3,7 раза меньше. Поэтому у поверхности Луны тело притягивается к ней примерно в 6 раз слабее, чем к Земле, и падает с ускорением 1,6&nbsp;м/с² вместо 9,8&nbsp;м/с². Подробнее — в разделе <a href="#ускорение-свободного-падения-на-земле-и-других-небесных-телах">«Ускорение свободного падения на Земле и других небесных телах»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="station">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Земля и космическая станция в масштабе: станция летит совсем низко над Землёй и облетает её за 93 минуты. Стрелка показывает, что Земля притягивает станцию, пунктир — куда станция улетела бы без притяжения. В увеличенном круге — космонавт, яблоко и капля воды парят внутри станции">
			<defs>
				<marker id={mArrow} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="gi-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
				<clipPath id={clipIn}>
					<circle cx={IN.x} cy={IN.y} r={IN.r - 2}></circle>
				</clipPath>
			</defs>
			<rect class="gi-space" x="0" y="0" width="360" height="240"></rect>
			<g class="gi-stars">
				{stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
			</g>
			<circle class="gi-earth" cx={E.x} cy={E.y} r={E.r}></circle>
			<g data-land>
				<path class="gi-land" d={`M${E.x - 30} ${E.y - 70} q 24 -12 44 2 q 10 16 -6 26 q -18 6 -22 22 q -14 6 -20 -10 q -8 -22 4 -40 z`}></path>
				<path class="gi-land" d={`M${E.x + 22} ${E.y + 4} q 26 -10 44 8 q 4 22 -12 38 q -20 14 -30 -4 q -10 -20 -2 -42 z`}></path>
				<path class="gi-land" d={`M${E.x - 62} ${E.y + 20} q 14 -6 22 6 q 2 14 -10 20 q -14 0 -12 -26 z`}></path>
			</g>
			<circle class="gi-path" cx={E.x} cy={E.y} r={RO}></circle>
			<path class="gi-trail" data-trail></path>
			<line class="gi-tangent" data-tan></line>
			<line class="gi-pull" data-pull marker-end={`url(#${mArrow})`}></line>
			<g data-st>
				<g class="gi-station">
					<rect class="gi-panel" x="-11" y="-6" width="6" height="12" rx="1"></rect>
					<rect class="gi-panel" x="5" y="-6" width="6" height="12" rx="1"></rect>
					<rect class="gi-body" x="-5" y="-2.5" width="10" height="5" rx="1.5"></rect>
				</g>
			</g>
			<line class="gi-call" data-call></line>
			<!-- the inset: inside the station -->
			<circle class="gi-inset" cx={IN.x} cy={IN.y} r={IN.r}></circle>
			<g clip-path={`url(#${clipIn})`}>
				<rect class="gi-cabin" x={IN.x - IN.r} y={IN.y - IN.r} width={2 * IN.r} height={2 * IN.r}></rect>
				<rect class="gi-wall" x={IN.x - IN.r} y={IN.y + 38} width={2 * IN.r} height="22"></rect>
				<rect class="gi-wall" x={IN.x - IN.r} y={IN.y - 60} width={2 * IN.r} height="22"></rect>
				{[-36, -12, 12, 36].map((dx) => <rect class="gi-rail" x={IN.x + dx - 5} y={IN.y + 36} width="10" height="3" rx="1.5" />)}
				<g data-astro>
					<g class="gi-floater">
						<rect class="gi-pack" x="-3" y="-17" width="7" height="14" rx="2"></rect>
						<path d="M0 -14 L0 4 M0 4 L-9 18 M0 4 L7 19 M0 -10 L-12 -18 M0 -10 L12 -4"></path>
						<circle cx="0" cy="-21" r="6"></circle>
					</g>
				</g>
				<g data-apple>
					<circle class="gi-apple" cx="0" cy="0" r="5"></circle>
					<path class="gi-leaf" d="M0 -5 q3 -5 7 -4 q-3 4 -7 4 z"></path>
				</g>
				<circle class="gi-drop" r="3.4" data-drop></circle>
			</g>
			<circle class="gi-inset-ring" cx={IN.x} cy={IN.y} r={IN.r}></circle>
			<rect class="gi-pill" x="252" y="178" width="80" height="40" rx="12"></rect>
			<text class="gi-small" x="292" y="194" text-anchor="middle">прошло</text>
			<text class="gi-read" x="292" y="211" text-anchor="middle" data-min>0 мин</text>
		</svg>
		<div class="intro__foot">
			<p>Космонавты на станции парят, хотя Земля притягивает их лишь примерно на десятую часть слабее, чем нас. Станция вместе с ними <More term="всё время падает на Землю и всё время пролетает мимо">Станция летит на высоте около 400&nbsp;км со скоростью почти 8&nbsp;км/с и облетает Землю за полтора часа. Без притяжения она улетела бы по прямой (пунктир). Притяжение Земли (стрелка) всё время загибает её путь к Земле, но станция успевает сдвинуться вбок, и Земля «уходит» из-под неё. Космонавты и вещи падают вместе со станцией, поэтому и парят в ней. Так же «падает» Луна — подробнее в разделе <a href="#ньютон-и-луна">«Ньютон и Луна»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	/* jump scene */
	.gi-sky-e {
		fill: color-mix(in srgb, var(--ig-vx) 14%, transparent);
	}
	.gi-sky-m {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
	}
	.gi-ground-e {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-5));
	}
	.gi-ground-m {
		fill: var(--sl-color-gray-4);
	}
	.gi-crater {
		fill: var(--sl-color-gray-5);
	}
	.gi-earth-small {
		fill: var(--ig-vx);
	}
	.gi-earth-small-shade {
		fill: var(--sl-color-gray-6);
		opacity: 0.6;
	}
	.gi-divide {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.gi-title {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.gi-count,
	.gi-mark,
	.gi-small {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.gi-mark {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.gi-top {
		stroke: var(--ig-v);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.gi-person {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-1);
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.gi-person path {
		fill: none;
	}
	.gi-suit path {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 7;
		stroke-linecap: round;
	}
	.gi-helmet {
		fill: var(--sl-color-gray-1);
	}
	.gi-visor {
		fill: var(--ig-v);
		opacity: 0.85;
	}
	.gi-pack {
		fill: var(--sl-color-gray-3);
	}
	.gi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.gi-read {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	/* station scene */
	.gi-space {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
	}
	.gi-stars circle {
		fill: var(--sl-color-gray-3);
	}
	.gi-earth {
		fill: color-mix(in srgb, var(--ig-vx) 55%, var(--ig-surface));
	}
	.gi-land {
		fill: color-mix(in srgb, var(--ig-v) 45%, color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-gray-4)));
	}
	.gi-path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.gi-trail {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
		stroke-linecap: round;
		opacity: 0.7;
	}
	.gi-tangent {
		stroke: var(--sl-color-accent-high);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}
	.gi-pull {
		stroke: var(--ig-v);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.gi-head {
		fill: var(--ig-v);
	}
	.gi-body {
		fill: var(--sl-color-gray-1);
	}
	.gi-panel {
		fill: var(--ig-vx);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.gi-call {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.gi-inset {
		fill: var(--ig-surface);
	}
	.gi-inset-ring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.gi-cabin {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 60%, var(--ig-surface));
	}
	.gi-wall {
		fill: var(--sl-color-gray-4);
	}
	.gi-rail {
		fill: var(--sl-color-gray-2);
	}
	.gi-floater path {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.gi-floater circle {
		fill: var(--sl-color-gray-1);
	}
	.gi-apple {
		fill: var(--ig-vy);
	}
	.gi-leaf {
		fill: color-mix(in srgb, var(--ig-v) 50%, var(--ig-vx));
	}
	.gi-drop {
		fill: var(--ig-vx);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const fmt1 = (v: number) => v.toFixed(1).replace('.', ',');

	for (const root of document.querySelectorAll<HTMLElement>('[data-gravintro]')) {
		// ---------- Jump: real time, the Moon jump lasts 2·2,2/1,62 = 2,72 с ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="jump"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const pe = $<SVGGElement>('[data-pe]');
			const pm = $<SVGGElement>('[data-pm]');
			const ce = $<SVGTextElement>('[data-ce]');
			const cm = $<SVGTextElement>('[data-cm]');
			const clock = $<SVGTextElement>('[data-clock]');
			const GND = 214;
			const PXM = 50;
			const V0 = 2.2;
			const gE = 9.8;
			const gM = 1.62;
			const TE = (2 * V0) / gE; // 0,449 с
			const TM = (2 * V0) / gM; // 2,716 с
			const NE = Math.floor(TM / TE); // 6 jumps on the Earth
			scene(card, TM, (x) => {
				const t = x * TM;
				// the Earth: NE jumps one after another, then stands
				const n = Math.min(Math.floor(t / TE), NE);
				const tau = n >= NE ? 0 : t - n * TE;
				const yE = V0 * tau - (gE * tau * tau) / 2;
				pe.setAttribute('transform', `translate(90 ${(GND - yE * PXM).toFixed(2)})`);
				ce.textContent = `прыжков: ${n}`;
				// the Moon: one jump
				const yM = x >= 1 ? 0 : V0 * t - (gM * t * t) / 2;
				pm.setAttribute('transform', `translate(270 ${(GND - yM * PXM).toFixed(2)})`);
				cm.textContent = `прыжков: ${x >= 1 ? 1 : 0}`;
				clock.textContent = `${fmt1(t)} с`;
			});
		}

		// ---------- Station: one revolution, 93 мин in 9 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="station"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const st = $<SVGGElement>('[data-st]');
			const land = $<SVGGElement>('[data-land]');
			const trail = $<SVGPathElement>('[data-trail]');
			const tan = $<SVGLineElement>('[data-tan]');
			const pull = $<SVGLineElement>('[data-pull]');
			const call = $<SVGLineElement>('[data-call]');
			const astro = $<SVGGElement>('[data-astro]');
			const apple = $<SVGGElement>('[data-apple]');
			const drop = $<SVGCircleElement>('[data-drop]');
			const mins = $<SVGTextElement>('[data-min]');
			const E = { x: 106, y: 126, r: 86 };
			const RO = (E.r * (6371 + 420)) / 6371;
			const IN = { x: 292, y: 76, r: 58 };
			const PERIOD = 93; // мин
			const DAY = 1436; // мин, one turn of the Earth
			const PHI0 = 100; // degrees, the start: near the top
			const rad = Math.PI / 180;
			const pos = (deg: number) => [E.x + RO * Math.cos(deg * rad), E.y - RO * Math.sin(deg * rad)];
			scene(card, 9, (x) => {
				const phi = PHI0 + 360 * x; // counterclockwise
				const [sx, sy] = pos(phi);
				// the direction of motion (counterclockwise, screen y down)
				const tx = -Math.sin(phi * rad);
				const ty = -Math.cos(phi * rad);
				const ang = Math.atan2(ty, tx) / rad;
				st.setAttribute('transform', `translate(${sx.toFixed(2)} ${sy.toFixed(2)}) rotate(${ang.toFixed(1)})`);
				land.setAttribute('transform', `rotate(${(-(360 * PERIOD * x) / DAY).toFixed(2)} ${E.x} ${E.y})`);
				// the path already flown
				const steps = Math.max(1, Math.round(72 * x));
				let d = '';
				for (let k = 0; k <= steps; k++) {
					const [px, py] = pos(PHI0 + (360 * x * k) / steps);
					d += `${k ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)} `;
				}
				trail.setAttribute('d', x > 0.002 ? d : '');
				// without the pull: straight on; the pull: towards the centre of the Earth
				tan.setAttribute('x1', sx.toFixed(1));
				tan.setAttribute('y1', sy.toFixed(1));
				tan.setAttribute('x2', (sx + 64 * tx).toFixed(1));
				tan.setAttribute('y2', (sy + 64 * ty).toFixed(1));
				const ux = (E.x - sx) / RO;
				const uy = (E.y - sy) / RO;
				pull.setAttribute('x1', (sx + 6 * ux).toFixed(1));
				pull.setAttribute('y1', (sy + 6 * uy).toFixed(1));
				pull.setAttribute('x2', (sx + 30 * ux).toFixed(1));
				pull.setAttribute('y2', (sy + 30 * uy).toFixed(1));
				// the callout to the inset
				const cx = IN.x - sx;
				const cy = IN.y - sy;
				const cl = Math.hypot(cx, cy);
				call.setAttribute('x1', (sx + (10 * cx) / cl).toFixed(1));
				call.setAttribute('y1', (sy + (10 * cy) / cl).toFixed(1));
				call.setAttribute('x2', (IN.x - (IN.r * cx) / cl).toFixed(1));
				call.setAttribute('y2', (IN.y - (IN.r * cy) / cl).toFixed(1));
				// inside: everything floats and drifts slowly
				astro.setAttribute('transform', `translate(${(IN.x - 10 + 6 * x).toFixed(2)} ${(IN.y + 4 - 4 * x).toFixed(2)}) rotate(${(-25 + 50 * x).toFixed(1)})`);
				apple.setAttribute('transform', `translate(${(IN.x + 26 - 4 * x).toFixed(2)} ${(IN.y - 18 + 6 * x).toFixed(2)}) rotate(${(140 * x).toFixed(1)})`);
				drop.setAttribute('cx', (IN.x + 22 + 3 * x).toFixed(2));
				drop.setAttribute('cy', (IN.y + 20 - 5 * x).toFixed(2));
				mins.textContent = `${Math.round(PERIOD * x)} мин`;
			});
		}
	}
</script>
