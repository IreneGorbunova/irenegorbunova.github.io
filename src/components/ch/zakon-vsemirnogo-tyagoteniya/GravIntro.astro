---
/**
 * Two short looping opening scenes of «Закон всемирного тяготения». No terms of the chapter in the pictures; the
 * captions' popovers explain.
 * Jump: two grown-ups of 1,75 м (the shared people kit; on the Moon in a spacesuit, suit.ts) crouch by 25 см and push
 *   off the ground with the same speed, 2,2 м/с: on the Earth (g = 9,8 м/с²) and on the Moon (g = 1,62 м/с²). Real
 *   time and one scale (50 px per metre, the people too). In the air the body keeps its shape and the soles follow
 *   h = 2,2·t − g·t²/2: on the Earth a jump is 25 см high and lasts 0,449 с, on the Moon 1,49 м and 2,716 с. The Earth
 *   jumper hops 6 times (each landing is a springy 0,2 с contact in which the hips dip by v·0,2/π = 14 см and come back
 *   up with the same 2,2 м/с), the Moon jumper once; the readouts count the jumps and the time spent in the air
 *   (6 · 0,449 = 2,69 ≈ 2,7 с against 2,72 ≈ 2,7 с). The push: the hips rise 25 см with constant acceleration
 *   v²/(2·0,25) = 9,7 м/с², 0,23 с; a landing stops the hips within 20 см (0,14 с) and they rise back in 0,6 с.
 * Station: the Earth seen from above the North Pole and the station's path to scale (radius 6371 км, height 420 км:
 *   the path runs 6 px above the ground); the station itself is drawn far larger. One revolution takes 93 мин (shown
 *   in 9 s); the Earth turns 23° in that time, both counterclockwise. The Sun is to the left (the right half is in
 *   night). The arrow shows the pull of the Earth, the dashed line where the station would fly without it. The inset:
 *   inside the station the astronaut (the kit, 1,75 м, in the relaxed posture of weightlessness: hips and knees bent,
 *   arms floating forward), an apple and a drop of water (a sphere that wobbles) float and drift slowly.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';
import SuitStyles from './SuitStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mArrow = `gi-ar-${uid}`;
const clipIn = `gi-clip-${uid}`;
const clipE = `gi-ce-${uid}`;
const clipM = `gi-cm-${uid}`;
const clipEarth = `gi-cearth-${uid}`;
const gSkyE = `gi-gse-${uid}`;
const gGrM = `gi-ggm-${uid}`;
const gOcean = `gi-goc-${uid}`;
const gNight = `gi-gn-${uid}`;
const f1 = (v: number) => v.toFixed(1);

// ---------- Jump scene ----------
const GND = 200; // where the soles stand, y
const HZ = 168; // the horizon
const PXM = 50; // px per metre
const V0 = 2.2; // м/с, the same push-off speed
const hE = (V0 * V0) / (2 * 9.8); // 0,247 м
const hM = (V0 * V0) / (2 * 1.62); // 1,49 м
const starsM: [number, number, number][] = [
	[196, 34, 0.7], [214, 62, 0.5], [236, 22, 0.8], [252, 48, 0.5], [292, 16, 0.6], [306, 58, 0.7], [318, 86, 0.5],
	[352, 74, 0.6], [228, 104, 0.5], [262, 128, 0.6], [342, 126, 0.5], [200, 140, 0.6], [286, 96, 0.4], [348, 150, 0.5],
	[222, 152, 0.4], [326, 160, 0.5],
];
const craters: [number, number, number][] = [
	[206, 214, 10], [318, 206, 8], [342, 226, 12], [238, 232, 6], [300, 186, 5], [214, 182, 4],
];
const tufts = [12, 34, 58, 118, 140, 162, 24, 150];

// ---------- Station scene ----------
const E = { x: 106, y: 126, r: 86 };
const RO = (E.r * (6371 + 420)) / 6371; // 91,7 px
const IN = { x: 292, y: 78, r: 60 }; // the inset
const stars: [number, number, number][] = [
	[14, 16, 0.8], [52, 26, 0.6], [206, 18, 0.9], [222, 156, 0.6], [214, 214, 0.8], [348, 162, 0.7], [250, 228, 0.6],
	[12, 226, 0.7], [338, 214, 0.9], [196, 232, 0.5], [234, 120, 0.5], [176, 10, 0.6], [12, 120, 0.5], [354, 196, 0.5],
	[230, 66, 0.4], [6, 70, 0.6], [200, 92, 0.5],
];
// Land seen from above the North Pole (azimuthal: the radius grows with the distance from the pole, the equator at
// the rim). Each mass spans longitudes a0…a1 between radii r0…r1 (parts of the Earth's radius), with wavy coasts.
const wob = (a: number, s: number) => Math.sin(3 * a + s) + 0.5 * Math.sin(7 * a + 2 * s) + 0.3 * Math.sin(13 * a + 3 * s);
const landPath = (a0: number, a1: number, r0: number, r1: number, s: number) => {
	const rad = Math.PI / 180;
	const n = 28;
	const out: string[] = [];
	const pt = (lon: number, rr: number) => `${f1(E.x + rr * E.r * Math.cos(lon * rad))} ${f1(E.y - rr * E.r * Math.sin(lon * rad))}`;
	for (let k = 0; k <= n; k++) {
		const f = k / n;
		const lon = a0 + (a1 - a0) * f;
		const h = ((r1 - r0) / 2) * Math.pow(Math.sin(Math.PI * f), 0.45) * (1 + 0.12 * wob(lon * rad, s));
		out.push(pt(lon, (r0 + r1) / 2 + h));
	}
	for (let k = n; k >= 0; k--) {
		const f = k / n;
		const lon = a0 + (a1 - a0) * f;
		const h = ((r1 - r0) / 2) * Math.pow(Math.sin(Math.PI * f), 0.45) * (1 + 0.12 * wob(lon * rad, s + 1.7));
		out.push(pt(lon, (r0 + r1) / 2 - h));
	}
	return `M${out.join(' L')} Z`;
};
const lands = [
	landPath(-168, -58, 0.24, 0.8, 0.4), // North America
	landPath(-58, -22, 0.08, 0.36, 1.3), // Greenland
	landPath(-12, 178, 0.18, 0.62, 2.1), // Europe and Asia
	landPath(-16, 48, 0.6, 1.02, 0.9), // the north of Africa
	landPath(68, 122, 0.58, 0.86, 3.1), // India and the south-east of Asia
];
const ice = (() => {
	const pts: string[] = [];
	for (let k = 0; k < 36; k++) {
		const a = (k / 36) * 2 * Math.PI;
		const rr = E.r * (0.17 + 0.025 * wob(a, 0.7));
		pts.push(`${f1(E.x + rr * Math.cos(a))} ${f1(E.y - rr * Math.sin(a))}`);
	}
	return `M${pts.join(' L')} Z`;
})();
const clouds = [
	[30, 0.45, 26], [150, 0.7, 30], [-100, 0.55, 22], [-30, 0.86, 34], [95, 0.95, 24], [210, 0.88, 28],
].map(([lon, rr, span]) => {
	const rad = Math.PI / 180;
	const p = (l: number) => `${f1(E.x + rr * E.r * Math.cos(l * rad))} ${f1(E.y - rr * E.r * Math.sin(l * rad))}`;
	return `M${p(lon - span / 2)} A${f1(rr * E.r)} ${f1(rr * E.r)} 0 0 0 ${p(lon + span / 2)}`;
});
---

<KitStyles />
<SuitStyles />
<IntroFrame data-gravintro>
	<div class="intro__card" data-scene="jump">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Два человека приседают и подпрыгивают, оттолкнувшись с одинаковой скоростью: слева на Земле, справа на Луне, в скафандре. На Земле прыжок высотой 25 сантиметров, на Луне — полтора метра. Человек на Луне прыгает один раз, человек на Земле — шесть раз подряд; в воздухе каждый из них проводит в сумме около 2,7 секунды">
			<defs>
				<clipPath id={clipE}><rect x="0" y="0" width="179.5" height="240"></rect></clipPath>
				<clipPath id={clipM}><rect x="180.5" y="0" width="179.5" height="240"></rect></clipPath>
				<linearGradient id={gSkyE} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="gi-skyE-top"></stop>
					<stop offset="1" class="gi-skyE-low"></stop>
				</linearGradient>
				<linearGradient id={gGrM} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="gi-grM-far"></stop>
					<stop offset="1" class="gi-grM-near"></stop>
				</linearGradient>
			</defs>
			<!-- the Earth: a summer yard -->
			<g clip-path={`url(#${clipE})`}>
				<rect x="0" y="0" width="180" height={HZ + 2} fill={`url(#${gSkyE})`}></rect>
				<circle class="gi-sun-glow" cx="150" cy="30" r="15"></circle>
				<circle class="gi-sun" cx="150" cy="30" r="8"></circle>
				<path class="gi-cloud" d="M70 46 q4 -10 14 -6 q6 -9 16 -3 q10 -2 10 7 q6 2 3 7 h-44 q-6 -3 1 -5 z"></path>
				<path class="gi-cloud" d="M18 78 q3 -7 10 -4 q5 -6 11 -1 q7 0 6 6 h-28 q-3 -1 1 -1 z"></path>
				<path class="gi-hill-far" d={`M0 ${HZ - 18} Q30 ${HZ - 34} 70 ${HZ - 20} Q110 ${HZ - 8} 140 ${HZ - 22} Q164 ${HZ - 30} 180 ${HZ - 20} V${HZ + 2} H0 Z`}></path>
				<path class="gi-hill" d={`M0 ${HZ - 4} Q50 ${HZ - 16} 100 ${HZ - 6} Q140 ${HZ + 1} 180 ${HZ - 8} V${HZ + 4} H0 Z`}></path>
				<!-- trees and a fence far behind -->
				<g class="gi-tree">
					<rect class="gi-trunk" x="17" y={HZ - 24} width="4" height="22"></rect>
					<circle class="gi-crown" cx="19" cy={HZ - 34} r="13"></circle>
					<circle class="gi-crown" cx="11" cy={HZ - 26} r="9"></circle>
					<circle class="gi-crown" cx="28" cy={HZ - 27} r="9"></circle>
					<rect class="gi-trunk" x="161" y={HZ - 18} width="3" height="16"></rect>
					<circle class="gi-crown" cx="162.5" cy={HZ - 26} r="10"></circle>
					<circle class="gi-crown" cx="155" cy={HZ - 20} r="7"></circle>
				</g>
				<path class="gi-fence" d={`M38 ${HZ - 8} H138 ${Array.from({ length: 11 }, (_, k) => `M${42 + k * 9.5} ${HZ - 2} V${HZ - 14}`).join(' ')}`}></path>
				<rect class="gi-ground-e" x="0" y={HZ} width="180" height={240 - HZ}></rect>
				<path class="gi-ground-e2" d={`M0 ${GND + 6} Q90 ${GND - 4} 180 ${GND + 8} V240 H0 Z`}></path>
				<path class="gi-tuft" d={tufts.map((x, k) => `M${x} ${k < 6 ? 236 : 186} l-2 -5 M${x} ${k < 6 ? 236 : 186} l0 -6 M${x} ${k < 6 ? 236 : 186} l2 -5`).join(' ')}></path>
				<ellipse class="gi-shadow" data-she cx="88" cy={GND + 1} rx="11" ry="2.2"></ellipse>
				<!-- the highest point of the soles -->
				<line class="gi-top" x1="58" x2="124" y1={GND - hE * PXM} y2={GND - hE * PXM}></line>
				<text class="gi-mark" x="128" y={GND - hE * PXM + 4}>25 см</text>
				<g data-pe></g>
			</g>
			<!-- the Moon -->
			<g clip-path={`url(#${clipM})`}>
				<rect class="gi-sky-m" x="180" y="0" width="180" height={HZ + 2}></rect>
				<g class="gi-mstars">
					{starsM.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
				</g>
				<!-- the Earth in the lunar sky, lit from the left -->
				<circle class="gi-earth-sky" cx="338" cy="30" r="11"></circle>
				<path class="gi-earth-sky-land" d="M332 22 q5 -3 8 1 q1 4 -3 6 q-4 1 -4 5 q-3 0 -3 -4 q-1 -5 2 -8 z M341 34 q4 -1 5 3 q-1 3 -4 3 z"></path>
				<path class="gi-earth-sky-night" d="M338 19 A11 11 0 0 1 338 41 A6 11 0 0 0 338 19 Z"></path>
				<path class="gi-mountain" d={`M180 ${HZ + 2} L196 ${HZ - 10} L210 ${HZ - 4} L232 ${HZ - 22} L256 ${HZ - 6} L270 ${HZ - 12} L300 ${HZ + 2} Z M286 ${HZ + 2} L318 ${HZ - 16} L334 ${HZ - 8} L360 ${HZ - 20} V${HZ + 2} Z`}></path>
				<rect x="180" y={HZ} width="180" height={240 - HZ} fill={`url(#${gGrM})`}></rect>
				<!-- the lander far away -->
				<g class="gi-lander" transform={`translate(214 ${HZ + 9})`}>
					<path class="gi-lm-leg" d="M-7 -3 L-11 2 M7 -3 L11 2 M-3 -3 L-4 2 M3 -3 L4 2"></path>
					<rect class="gi-lm-base" x="-7" y="-7" width="14" height="5"></rect>
					<path class="gi-lm-top" d="M-5 -7 L-5 -12 L-2 -15 L4 -15 L6 -11 L6 -7 Z"></path>
				</g>
				{craters.map(([x, y, r]) => (
					<>
						<ellipse class="gi-crater" cx={x} cy={y} rx={r} ry={r * 0.32} />
						<path class="gi-crater-rim" d={`M${x - r} ${y} A${r} ${r * 0.32} 0 0 0 ${x + r} ${y}`} />
					</>
				))}
				<path class="gi-step" d="M238 212 l5 -1 l1 2 l-5 1 z M250 216 l5 -1 l1 2 l-5 1 z M224 208 l5 -1 l1 2 l-5 1 z"></path>
				<ellipse class="gi-shadow" data-shm cx="268" cy={GND + 1} rx="11" ry="2.2"></ellipse>
				<line class="gi-top" x1="236" x2="304" y1={GND - hM * PXM} y2={GND - hM * PXM}></line>
				<text class="gi-mark" x="308" y={GND - hM * PXM + 4}>1,5 м</text>
				<g data-pm></g>
			</g>
			<line class="gi-divide" x1="180" y1="0" x2="180" y2="240"></line>
			<text class="gi-title" x="10" y="21">Земля</text>
			<text class="gi-title gi-title-m" x="190" y="21">Луна</text>
			<rect class="gi-pill" x="6" y="205" width="118" height="31" rx="9"></rect>
			<text class="gi-count" x="14" y="218" data-ce>прыжков: 0</text>
			<text class="gi-count" x="14" y="231" data-ae>в воздухе: 0,0 с</text>
			<rect class="gi-pill" x="186" y="205" width="118" height="31" rx="9"></rect>
			<text class="gi-count" x="194" y="218" data-cm>прыжков: 0</text>
			<text class="gi-count" x="194" y="231" data-am>в воздухе: 0,0 с</text>
		</svg>
		<div class="intro__foot">
			<p>Оттолкнувшись с той же скоростью, на Луне человек подпрыгнет в 6 раз выше, чем на Земле, и пробудет в воздухе в 6 раз дольше: Луна <More term="притягивает тела в 6 раз слабее">Масса Луны в 81 раз меньше массы Земли, а радиус — в 3,7 раза меньше. Поэтому у поверхности Луны тело притягивается к ней примерно в 6 раз слабее, чем к Земле, и падает с ускорением 1,6&nbsp;м/с² вместо 9,8&nbsp;м/с². Подробнее — в разделе <a href="#ускорение-свободного-падения-на-земле-и-других-небесных-телах">«Ускорение свободного падения на Земле и других небесных телах»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="station">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Земля, видимая со стороны Северного полюса, и путь космической станции в масштабе: станция летит совсем низко над Землёй и облетает её за 93 минуты. Стрелка показывает, что Земля притягивает станцию, пунктир — куда станция улетела бы без притяжения. В увеличенном круге — космонавт, яблоко и капля воды парят внутри станции">
			<defs>
				<marker id={mArrow} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="gi-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
				<clipPath id={clipIn}>
					<circle cx={IN.x} cy={IN.y} r={IN.r - 2}></circle>
				</clipPath>
				<clipPath id={clipEarth}>
					<circle cx={E.x} cy={E.y} r={E.r}></circle>
				</clipPath>
				<radialGradient id={gOcean} cx="0.4" cy="0.45" r="0.65">
					<stop offset="0" class="gi-ocean-c"></stop>
					<stop offset="1" class="gi-ocean-e"></stop>
				</radialGradient>
				<linearGradient id={gNight} x1="0" y1="0" x2="1" y2="0">
					<stop offset="0.48" class="gi-night-0"></stop>
					<stop offset="0.62" class="gi-night-1"></stop>
				</linearGradient>
			</defs>
			<rect class="gi-space" x="0" y="0" width="360" height="240"></rect>
			<g class="gi-stars">
				{stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
			</g>
			<circle class="gi-glow" cx={E.x} cy={E.y} r={E.r + 2.5}></circle>
			<g clip-path={`url(#${clipEarth})`}>
				<circle cx={E.x} cy={E.y} r={E.r} fill={`url(#${gOcean})`}></circle>
				<g data-land>
					{lands.map((d) => <path class="gi-land" d={d} />)}
					<path class="gi-ice" d={ice}></path>
					{clouds.map((d) => <path class="gi-cloud-arc" d={d} />)}
				</g>
				<rect x={E.x - E.r} y={E.y - E.r} width={2 * E.r} height={2 * E.r} fill={`url(#${gNight})`}></rect>
			</g>
			<circle class="gi-path" cx={E.x} cy={E.y} r={RO}></circle>
			<path class="gi-trail" data-trail></path>
			<line class="gi-tangent" data-tan></line>
			<line class="gi-pull" data-pull marker-end={`url(#${mArrow})`}></line>
			<g data-st>
				<g class="gi-station">
					<path class="gi-truss" d="M0 -8.5 V8.5"></path>
					<rect class="gi-panel" x="-4.6" y="-9" width="3.2" height="6.4" rx="0.5"></rect>
					<rect class="gi-panel" x="-4.6" y="2.6" width="3.2" height="6.4" rx="0.5"></rect>
					<rect class="gi-panel" x="1.4" y="-9" width="3.2" height="6.4" rx="0.5"></rect>
					<rect class="gi-panel" x="1.4" y="2.6" width="3.2" height="6.4" rx="0.5"></rect>
					<rect class="gi-body" x="-7" y="-1.7" width="14" height="3.4" rx="1.4"></rect>
				</g>
			</g>
			<line class="gi-call" data-call></line>
			<!-- the inset: inside the station -->
			<circle class="gi-inset" cx={IN.x} cy={IN.y} r={IN.r}></circle>
			<g clip-path={`url(#${clipIn})`}>
				<rect class="gi-cabin" x={IN.x - IN.r} y={IN.y - IN.r} width={2 * IN.r} height={2 * IN.r}></rect>
				<path class="gi-seam" d={[-40, -20, 0, 20, 40].map((dx) => `M${IN.x + dx} ${IN.y - 44} V${IN.y + 44}`).join(' ') + ` M${IN.x - IN.r} ${IN.y - 12} H${IN.x + IN.r} M${IN.x - IN.r} ${IN.y + 16} H${IN.x + IN.r}`}></path>
				<!-- a window on the back wall: the Earth below -->
				<circle class="gi-window-rim" cx={IN.x + 30} cy={IN.y - 22} r="11"></circle>
				<circle class="gi-window" cx={IN.x + 30} cy={IN.y - 22} r="8.5"></circle>
				<path class="gi-window-earth" d={`M${IN.x + 21.5} ${IN.y - 18} Q${IN.x + 30} ${IN.y - 25} ${IN.x + 38.5} ${IN.y - 18} A8.5 8.5 0 0 1 ${IN.x + 21.5} ${IN.y - 18} Z`}></path>
				<path class="gi-window-cloud" d={`M${IN.x + 25} ${IN.y - 17} h5 M${IN.x + 31} ${IN.y - 15.5} h4`}></path>
				<!-- the walls with their lockers and handrails -->
				<rect class="gi-wall" x={IN.x - IN.r} y={IN.y + 44} width={2 * IN.r} height="18"></rect>
				<rect class="gi-wall" x={IN.x - IN.r} y={IN.y - 62} width={2 * IN.r} height="18"></rect>
				{[-48, -24, 0, 24].map((dx) => (
					<>
						<rect class="gi-locker" x={IN.x + dx + 2} y={IN.y + 47} width="20" height="12" rx="1.5" />
						<rect class="gi-locker" x={IN.x + dx + 2} y={IN.y - 59} width="20" height="12" rx="1.5" />
					</>
				))}
				{[-36, 0, 36].map((dx) => (
					<>
						<rect class="gi-rail" x={IN.x + dx - 6} y={IN.y + 41} width="12" height="2.4" rx="1.2" />
						<rect class="gi-rail" x={IN.x + dx - 6} y={IN.y - 43.4} width="12" height="2.4" rx="1.2" />
					</>
				))}
				<rect class="gi-laptop" x={IN.x - 46} y={IN.y - 30} width="16" height="10" rx="1"></rect>
				<path class="gi-cable" d={`M${IN.x - 60} ${IN.y + 30} Q${IN.x - 44} ${IN.y + 24} ${IN.x - 38} ${IN.y + 40}`}></path>
				<g data-astro><g data-astro-fig></g></g>
				<g data-apple>
					<circle class="gi-apple" cx="0" cy="0" r="4.6"></circle>
					<path class="gi-stem" d="M0 -4.4 q0.6 -2 1.6 -2.8"></path>
					<path class="gi-leaf" d="M0.8 -5.6 q3.4 -3.6 6.4 -2.2 q-3 3.2 -6.4 2.2 z"></path>
				</g>
				<g data-drop>
					<ellipse class="gi-drop" rx="3.6" ry="3.6" data-drop-body></ellipse>
					<circle class="gi-drop-glint" cx="-1.1" cy="-1.2" r="0.9"></circle>
				</g>
			</g>
			<circle class="gi-inset-ring" cx={IN.x} cy={IN.y} r={IN.r}></circle>
			<rect class="gi-pill" x="252" y="178" width="80" height="40" rx="12"></rect>
			<text class="gi-small" x="292" y="194" text-anchor="middle">прошло</text>
			<text class="gi-read" x="292" y="211" text-anchor="middle" data-min>0 мин</text>
		</svg>
		<div class="intro__foot">
			<p>Космонавты на станции парят, хотя Земля притягивает их лишь примерно на десятую часть слабее, чем нас. Станция вместе с ними <More term="всё время падает на Землю и всё время пролетает мимо">Станция летит на высоте около 400&nbsp;км со скоростью почти 8&nbsp;км/с и облетает Землю за полтора часа. Без притяжения она улетела бы по прямой (пунктир). Притяжение Земли (стрелка) всё время загибает её путь к Земле, но станция успевает сдвинуться вбок, и Земля «уходит» из-под неё. Космонавты и вещи падают вместе со станцией, поэтому и парят в ней. Так же «падает» Луна — подробнее в разделе <a href="#ньютон-и-луна">«Ньютон и Луна»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
