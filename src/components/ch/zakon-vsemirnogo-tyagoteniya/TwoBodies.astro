---
/**
 * Two lead balls attract each other: F = G·m₁m₂/r². Sliders for the masses (1–10 т) and the distance between
 * the centres (1,5–6 м). Balls are drawn to scale (lead, ρ = 11 340 кг/м³; 95 px per metre); the force arrows
 * share one fixed scale, so doubling r makes them four times shorter. The buttons «r × 2» and «r : 2» keep the
 * previous picture as a faded outline for comparison. The live formula uses G = 6,67·10⁻¹¹ Н·м²/кг².
 */
const uid = `tb-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="tb not-content" data-tb>
	<div class="tb__sliders">
		<label class="tb__slider">
			<span>Масса первого шара <i>m</i><sub>1</sub> = <b data-m1-out></b></span>
			<input type="range" min="1" max="10" step="0.5" value="10" data-m1 />
		</label>
		<label class="tb__slider">
			<span>Масса второго шара <i>m</i><sub>2</sub> = <b data-m2-out></b></span>
			<input type="range" min="1" max="10" step="0.5" value="4" data-m2 />
		</label>
		<label class="tb__slider">
			<span>Расстояние между центрами <i>r</i> = <b data-r-out></b></span>
			<input type="range" min="1.5" max="6" step="0.05" value="1.5" data-r />
		</label>
	</div>

	<svg class="tb__svg" viewBox="0 0 720 210" role="img" aria-label="Два свинцовых шара и силы, с которыми они притягивают друг друга">
		<defs>
			<radialGradient id={`${uid}-ball`} cx="35%" cy="30%" r="75%">
				<stop offset="0" class="tb__stop-hi" />
				<stop offset="1" class="tb__stop-lo" />
			</radialGradient>
		</defs>
		<g class="tb__was" data-was>
			<circle class="tb__was-ball" data-was-b1 />
			<circle class="tb__was-ball" data-was-b2 />
			<path class="tb__was-arrow" data-was-a1 />
			<path class="tb__was-arrow" data-was-a2 />
			<text class="tb__was-text" data-was-text>было</text>
		</g>
		<line class="tb__axis" data-axis />
		<g class="tb__dim">
			<line data-dim />
			<line data-dim-l />
			<line data-dim-r />
			<text data-dim-text text-anchor="middle"></text>
		</g>
		<circle class="tb__ball" fill={`url(#${uid}-ball)`} data-b1 />
		<circle class="tb__ball" fill={`url(#${uid}-ball)`} data-b2 />
		<text class="tb__name" data-n1 text-anchor="middle"></text>
		<text class="tb__name" data-n2 text-anchor="middle"></text>
		<path class="tb__arrow" data-a1 />
		<path class="tb__arrow" data-a2 />
		<text class="tb__flabel" data-f1>F</text>
		<text class="tb__flabel" data-f2>F</text>
	</svg>

	<div class="tb__btns">
		<button type="button" class="tb__btn" data-x2>Увеличить <i>r</i> в 2 раза</button>
		<button type="button" class="tb__btn" data-d2>Уменьшить <i>r</i> в 2 раза</button>
	</div>
	<div class="tb__f" data-formula></div>
	<p class="tb__note" data-out aria-live="polite"></p>
</figure>

<style>
	.tb {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.tb i {
		font-family: var(--ig-font-math);
	}
	.tb__sliders {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.4rem 1rem;
	}
	.tb__slider {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.tb__slider b {
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.tb__slider input {
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.tb__svg {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 0.4rem;
	}
	.tb__stop-hi {
		stop-color: var(--sl-color-gray-2);
	}
	.tb__stop-lo {
		stop-color: var(--sl-color-gray-5);
	}
	.tb__ball {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.tb__axis {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.tb__arrow {
		fill: var(--ig-v);
		stroke: var(--sl-color-black);
		stroke-width: 1;
		paint-order: stroke;
	}
	.tb__flabel {
		fill: var(--ig-v);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 22px;
	}
	.tb__flabel tspan {
		font-style: normal;
		font-size: 14px;
	}
	.tb__name {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
	}
	.tb__dim line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tb__dim text {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
	}
	.tb__was {
		opacity: 0;
		transition: opacity 0.3s;
	}
	.tb__was.is-on {
		opacity: 1;
	}
	.tb__was-ball {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.tb__was-arrow {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
		opacity: 0.8;
	}
	.tb__was-text {
		fill: var(--sl-color-gray-3);
		font-size: 14px;
	}
	.tb__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.4rem;
	}
	.tb__btn {
		padding: 0.35rem 0.9rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.tb__btn:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.tb__btn:disabled {
		opacity: 0.45;
		cursor: default;
	}
	.tb__f {
		color: var(--sl-color-white);
		overflow-x: auto;
		overflow-y: hidden;
	}
	.tb__f :global(.katex-display) {
		margin: 0.6rem 0 0.2rem;
	}
	.tb__note {
		min-height: 1.4em;
		margin: 0.2rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.tb__note :global(b) {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.tb {
			padding: 0.75rem;
		}
		.tb__name,
		.tb__dim text,
		.tb__was-text {
			font-size: 26px;
		}
		.tb__flabel {
			font-size: 36px;
		}
		.tb__flabel tspan {
			font-size: 22px;
		}
		.tb__sliders {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { G_SCHOOL, arrowPath, fmt, hsci, renderTex, tnum, tsci } from './util';

	const trim = (v: number) => fmt(v, 2).replace(/,?0+$/, '');

	const PX = 95; // px per metre
	const CX = 360;
	const CY = 112;
	const RHO = 11340; // lead, кг/м³
	const F_MAX = (G_SCHOOL * 1e4 * 1e4) / 1.5 ** 2;
	const K = (0.5 * 1.5 * PX - 8) / F_MAX; // px per newton, one scale for every state
	const radius = (m: number) => Math.cbrt((3 * m) / (4 * Math.PI * RHO)); // m

	for (const root of document.querySelectorAll<HTMLElement>('[data-tb]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const m1In = q<HTMLInputElement>('[data-m1]');
		const m2In = q<HTMLInputElement>('[data-m2]');
		const rIn = q<HTMLInputElement>('[data-r]');
		const x2 = q<HTMLButtonElement>('[data-x2]');
		const d2 = q<HTMLButtonElement>('[data-d2]');
		const formula = q<HTMLElement>('[data-formula]');
		const note = q<HTMLElement>("[data-out]");
		const was = q<SVGGElement>('[data-was]');

		let r = Number(rIn.value);
		let tween = 0;
		let before: { F: number; r: number } | null = null;

		const geom = (m1: number, m2: number, rr: number) => {
			const F = (G_SCHOOL * m1 * m2) / (rr * rr);
			const x1 = CX - (rr * PX) / 2;
			const x2p = CX + (rr * PX) / 2;
			const L = F * K;
			return { F, x1, x2: x2p, L, R1: radius(m1) * PX, R2: radius(m2) * PX };
		};

		const draw = () => {
			const m1 = Number(m1In.value) * 1000;
			const m2 = Number(m2In.value) * 1000;
			q('[data-m1-out]').textContent = `${fmt(m1 / 1000, 1).replace(',0', '')} т`;
			q('[data-m2-out]').textContent = `${fmt(m2 / 1000, 1).replace(',0', '')} т`;
			q('[data-r-out]').textContent = `${trim(r)} м`;
			const g = geom(m1, m2, r);
			const set = (sel: string, attrs: Record<string, string | number>) => {
				const el = q<SVGElement>(sel);
				for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, typeof v === 'number' ? v.toFixed(2) : v);
			};
			set('[data-b1]', { cx: g.x1, cy: CY, r: g.R1 });
			set('[data-b2]', { cx: g.x2, cy: CY, r: g.R2 });
			set('[data-axis]', { x1: g.x1, y1: CY, x2: g.x2, y2: CY });
			set('[data-n1]', { x: g.x1, y: CY + 60 + 24 });
			set('[data-n2]', { x: g.x2, y: CY + 60 + 24 });
			q('[data-n1]').innerHTML = '<tspan font-style="italic" font-family="var(--ig-font-math)">m</tspan><tspan font-size="0.7em" dy="0.25em">1</tspan>';
			q('[data-n2]').innerHTML = '<tspan font-style="italic" font-family="var(--ig-font-math)">m</tspan><tspan font-size="0.7em" dy="0.25em">2</tspan>';
			// dimension line above the balls
			const dy = 30;
			set('[data-dim]', { x1: g.x1, y1: dy, x2: g.x2, y2: dy });
			set('[data-dim-l]', { x1: g.x1, y1: dy - 6, x2: g.x1, y2: CY - g.R1 - 4 });
			set('[data-dim-r]', { x1: g.x2, y1: dy - 6, x2: g.x2, y2: CY - g.R2 - 4 });
			set('[data-dim-text]', { x: CX, y: dy - 7 });
			q('[data-dim-text]').innerHTML = `<tspan font-style="italic" font-family="var(--ig-font-math)">r</tspan> = ${trim(r)} м`;
			// force arrows from the centres towards each other
			const narrowSvg = root.clientWidth < 560;
			const aw = narrowSvg ? 8 : 5;
			const ah = narrowSvg ? 20 : 14;
			q('[data-a1]').setAttribute('d', arrowPath(g.x1, CY, g.x1 + g.L, CY, aw, ah));
			q('[data-a2]').setAttribute('d', arrowPath(g.x2, CY, g.x2 - g.L, CY, aw, ah));
			const lab = (el: string, x: number, anchor: string, n: string) => {
				const t = q<SVGTextElement>(el);
				t.setAttribute('x', x.toFixed(1));
				t.setAttribute('y', String(CY - (narrowSvg ? 20 : 14)));
				t.setAttribute('text-anchor', anchor);
				t.innerHTML = `F<tspan dy="5">${n}</tspan>`;
			};
			lab('[data-f1]', g.x1 + Math.max(g.L, 10) / 2 + 2, 'middle', '1');
			lab('[data-f2]', g.x2 - Math.max(g.L, 10) / 2 - 2, 'middle', '2');

			x2.disabled = r * 2 > 6 + 1e-9 || tween !== 0;
			d2.disabled = r / 2 < 1.5 - 1e-9 || tween !== 0;

			const narrow = root.clientWidth < 560;
			const body = `\\dfrac{${tnum(6.67, 2)}\\cdot 10^{-11}\\cdot ${tnum(m1, 0, true)}\\cdot ${tnum(m2, 0, true)}}{${trim(r).replace(',', '{,}')}^2}~\\text{Н}`;
			const res = `${tsci(g.F, 2)}~\\text{Н}`;
			renderTex(
				formula,
				narrow
					? `\\begin{aligned}F &= G\\,\\dfrac{m_1 m_2}{r^2} \\\\ &= ${body} \\\\ &\\approx ${res}\\end{aligned}`
					: `F = G\\,\\dfrac{m_1 m_2}{r^2} = ${body} \\approx ${res}`,
			);
			if (before) {
				const k = before.F / g.F;
				const kr = r / before.r;
				const times = (x: number) => fmt(x, x >= 10 ? 0 : 1).replace(',0', '');
				const rTxt = kr > 1 ? `Расстояние стало в <b>${times(kr)}</b> раза больше` : `Расстояние стало в <b>${times(1 / kr)}</b> раза меньше`;
				const fTxt = k > 1 ? `сила — в <b>${times(k)}</b> раза меньше` : `сила — в <b>${times(1 / k)}</b> раза больше`;
				note.innerHTML = `${rTxt}, а ${fTxt}: было ${hsci(before.F, 2)} Н, стало ${hsci(g.F, 2)} Н.`;
			} else {
				note.innerHTML = `Шары действуют друг на друга с равными силами: <i>F</i><sub>1</sub> = <i>F</i><sub>2</sub> = ${hsci(g.F, 2)} Н, даже если массы разные.`;
			}
		};

		const remember = () => {
			const m1 = Number(m1In.value) * 1000;
			const m2 = Number(m2In.value) * 1000;
			const g = geom(m1, m2, r);
			before = { F: g.F, r };
			const set = (sel: string, attrs: Record<string, string | number>) => {
				const el = q<SVGElement>(sel);
				for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, typeof v === 'number' ? v.toFixed(2) : v);
			};
			set('[data-was-b1]', { cx: g.x1, cy: CY, r: g.R1 });
			set('[data-was-b2]', { cx: g.x2, cy: CY, r: g.R2 });
			const narrowSvg = root.clientWidth < 560;
			const aw = narrowSvg ? 8 : 5;
			const ah = narrowSvg ? 20 : 14;
			q('[data-was-a1]').setAttribute('d', arrowPath(g.x1, CY, g.x1 + g.L, CY, aw, ah));
			q('[data-was-a2]').setAttribute('d', arrowPath(g.x2, CY, g.x2 - g.L, CY, aw, ah));
			set('[data-was-text]', { x: g.x1, y: CY - Math.max(g.R1, 20) - 8 });
			q('[data-was-text]').setAttribute('text-anchor', 'middle');
			was.classList.add('is-on');
		};

		const forget = () => {
			before = null;
			was.classList.remove('is-on');
		};

		const animateTo = (target: number) => {
			remember();
			const from = r;
			const t0 = performance.now();
			const dur = 700;
			const step = (now: number) => {
				const k = Math.min((now - t0) / dur, 1);
				const e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
				r = from + (target - from) * e;
				if (k < 1) tween = requestAnimationFrame(step);
				else {
					r = target;
					tween = 0;
					rIn.value = String(target);
				}
				draw();
			};
			tween = requestAnimationFrame(step);
		};

		x2.addEventListener('click', () => animateTo(Math.round(r * 2 * 100) / 100));
		d2.addEventListener('click', () => animateTo(Math.round((r / 2) * 100) / 100));
		for (const inp of [m1In, m2In, rIn])
			inp.addEventListener('input', () => {
				if (tween) return;
				r = Number(rIn.value);
				forget();
				draw();
			});
		let lastW = root.clientWidth;
		new ResizeObserver(() => {
			if (Math.abs(root.clientWidth - lastW) > 4) {
				lastW = root.clientWidth;
				draw();
			}
		}).observe(root);
		draw();
	}
</script>
