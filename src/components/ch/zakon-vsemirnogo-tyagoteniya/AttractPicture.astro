---
/**
 * Picture to the definition of «всемирное тяготение»: four pairs of bodies (the Earth and an apple, the Earth and
 * the Moon, the Sun and the Earth, two people), each body with the force with which the other one attracts it.
 * In every pair the two arrows are equal and opposite; every pair has its own scale.
 */
import PicStyles from './PicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `gpa-${uid}`;
const person = (x: number) =>
	`M${x} 76 L${x} 104 M${x} 104 L${x - 7} 132 M${x} 104 L${x + 7} 132 M${x} 82 L${x - 10} 98 M${x} 82 L${x + 10} 98`;
---

<PicStyles />
<figure class="gp-pic not-content">
	<div class="gp-pic__grid">
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Земля притягивает яблоко, а яблоко — Землю: две равные стрелки навстречу друг другу">
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="gp-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<circle class="gp-earth" cx="90" cy="340" r="236"></circle>
			<path class="gp-land" d="M0 116 Q40 106 70 108 Q96 110 120 106 L180 112 L180 150 L0 150 Z"></path>
			<line class="gp-line" x1="52" y1="108" x2="52" y2="70" style="stroke-width: 5"></line>
			<circle class="gp-leaf" cx="50" cy="54" r="24"></circle>
			<circle class="gp-apple" cx="120" cy="50" r="6"></circle>
			<path class="gp-leaf" d="M120 44 q3 -5 7 -4 q-3 4 -7 4 z"></path>
			<line class="gp-force" x1="120" y1="50" x2="120" y2="80" marker-end={`url(#${mA})`}></line>
			<line class="gp-force" x1="120" y1="138" x2="120" y2="108" marker-end={`url(#${mA})`}></line>
			<text class="gp-title" x="172" y="20" text-anchor="end">Земля и яблоко</text>
		</svg>
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Земля притягивает Луну, а Луна — Землю: две равные стрелки навстречу друг другу">
			<circle class="gp-earth" cx="46" cy="85" r="26"></circle>
			<path class="gp-land" d="M34 68 q12 -6 20 2 q4 10 -4 14 q-10 2 -12 10 q-8 2 -10 -6 q-2 -12 6 -20 z"></path>
			<circle class="gp-moon" cx="146" cy="85" r="8"></circle>
			<circle class="gp-crater" cx="143" cy="82" r="2"></circle>
			<line class="gp-force" x1="72" y1="85" x2="100" y2="85" marker-end={`url(#${mA})`}></line>
			<line class="gp-force" x1="138" y1="85" x2="110" y2="85" marker-end={`url(#${mA})`}></line>
			<text class="gp-title" x="172" y="20" text-anchor="end">Земля и Луна</text>
		</svg>
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Солнце притягивает Землю, а Земля — Солнце: две равные стрелки навстречу друг другу">
			<circle class="gp-sun" cx="34" cy="85" r="28"></circle>
			<circle class="gp-earth" cx="150" cy="85" r="6"></circle>
			<line class="gp-force" x1="62" y1="85" x2="92" y2="85" marker-end={`url(#${mA})`}></line>
			<line class="gp-force" x1="144" y1="85" x2="114" y2="85" marker-end={`url(#${mA})`}></line>
			<text class="gp-title" x="172" y="20" text-anchor="end">Солнце и Земля</text>
		</svg>
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Два человека притягивают друг друга: две равные стрелки навстречу друг другу">
			<line class="gp-dash" x1="10" y1="133" x2="170" y2="133"></line>
			<circle class="gp-person-head" cx="44" cy="67" r="7"></circle>
			<path class="gp-person" d={person(44)}></path>
			<circle class="gp-person-head" cx="136" cy="67" r="7"></circle>
			<path class="gp-person" d={person(136)}></path>
			<line class="gp-force" x1="44" y1="94" x2="78" y2="94" marker-end={`url(#${mA})`}></line>
			<line class="gp-force" x1="136" y1="94" x2="102" y2="94" marker-end={`url(#${mA})`}></line>
			<text class="gp-title" x="172" y="20" text-anchor="end">Два человека</text>
		</svg>
	</div>
	<figcaption>
		Каждое из двух тел притягивает другое. Стрелки — силы притяжения: в каждой паре они равны по модулю и направлены навстречу друг другу. Масштаб у каждой пары свой: притяжение двух людей на самом деле ничтожно, а Солнца и Земли — огромно.
	</figcaption>
</figure>
