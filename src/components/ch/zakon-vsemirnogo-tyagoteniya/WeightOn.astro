---
/**
 * «Сколько вы весите на …»: g = GM/R² for the Earth, the Moon, Mars, Venus, Jupiter and the Sun, and the
 * reader's weight P = mg. Masses and volumetric mean radii from the NASA NSSDC fact sheets
 * (nssdc.gsfc.nasa.gov/planetary/factsheet), rounded to three significant digits; g is computed from the
 * rounded values shown in the formula, so every line can be checked by hand. G = 6,67·10⁻¹¹ Н·м²/кг².
 */
const BODIES = [
	{ id: 'earth', name: 'Земля', on: 'на Земле', M: 5.97e24, R: 6.37e6, note: 'Взят средний радиус Земли. На полюсах <i>g</i> немного больше, на экваторе — немного меньше.' },
	{ id: 'moon', name: 'Луна', on: 'на Луне', M: 7.35e22, R: 1.74e6, note: 'Масса Луны в 81 раз меньше земной, радиус — в 3,7 раза меньше.' },
	{ id: 'mars', name: 'Марс', on: 'на Марсе', M: 6.42e23, R: 3.39e6, note: 'Масса Марса в 9 раз меньше земной, а радиус — почти в 2 раза меньше.' },
	{ id: 'venus', name: 'Венера', on: 'на Венере', M: 4.87e24, R: 6.05e6, note: 'Венера почти такая же, как Земля, по массе и размеру, поэтому и <i>g</i> почти такое же.' },
	{ id: 'jupiter', name: 'Юпитер', on: 'на Юпитере', M: 1.9e27, R: 6.99e7, note: 'Твёрдой поверхности у Юпитера нет. Здесь — уровень облаков, где давление такое же, как у поверхности Земли.' },
	{ id: 'sun', name: 'Солнце', on: 'на Солнце', M: 1.99e30, R: 6.96e8, note: 'У видимой поверхности Солнца. Стоять там нельзя — её температура около 5500 °C.' },
];
---

<figure class="wo not-content" data-wo>
	<div class="wo__bodies" role="radiogroup" aria-label="Небесное тело">
		{
			BODIES.map((b, i) => (
				<button
					type="button"
					role="radio"
					class={`wo__body wo__body--${b.id}`}
					aria-checked={i === 1 ? 'true' : 'false'}
					data-body={b.id}
					data-name={b.name}
					data-on={b.on}
					data-m={b.M}
					data-r={b.R}
					data-info={b.note}
				>
					<span class="wo__globe" aria-hidden="true" />
					{b.name}
				</button>
			))
		}
	</div>

	<label class="wo__slider">
		<span>Ваша масса <i>m</i> = <b data-m-out></b></span>
		<input type="range" min="20" max="120" step="1" value="50" data-mass />
	</label>

	<div class="wo__main">
		<svg class="wo__svg" viewBox="0 0 220 190" role="img" aria-label="Человек на напольных весах">
			<path class="wo__ground" data-ground d="M -10 176 Q 110 160 230 176 L 230 200 L -10 200 Z" />
			<g class="wo__person">
				<circle cx="110" cy="40" r="13" />
				<path d="M 110 54 L 110 104 M 110 66 L 90 90 M 110 66 L 130 90 M 110 104 L 98 140 M 110 104 L 122 140" />
			</g>
			<rect class="wo__scale" x="46" y="141" width="128" height="26" rx="6" />
			<rect class="wo__screen" x="66" y="145" width="88" height="18" rx="3" />
			<text class="wo__screen-text" x="110" y="159" text-anchor="middle" data-screen></text>
		</svg>
		<div class="wo__calc">
			<div class="wo__f" data-f1></div>
			<div class="wo__f" data-f2></div>
		</div>
	</div>
	<p class="wo__note" data-out aria-live="polite"></p>
</figure>

<style>
	.wo {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		--wo-c: var(--sl-color-gray-3);
	}
	.wo i {
		font-family: var(--ig-font-math);
	}
	.wo__bodies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.wo__body {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.3rem 0.8rem 0.3rem 0.4rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		cursor: pointer;
	}
	.wo__body:hover {
		border-color: var(--sl-color-gray-3);
	}
	.wo__body[aria-checked='true'] {
		color: var(--sl-color-white);
		font-weight: 700;
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
	}
	.wo__globe {
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--wo-g) 55%, white), var(--wo-g) 60%, color-mix(in srgb, var(--wo-g) 60%, black));
	}
	.wo__body--earth {
		--wo-g: var(--ig-vx);
	}
	.wo__body--moon {
		--wo-g: var(--sl-color-gray-3);
	}
	.wo__body--mars {
		--wo-g: var(--ig-vy);
	}
	.wo__body--venus {
		--wo-g: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-2));
	}
	.wo__body--jupiter {
		--wo-g: color-mix(in srgb, var(--ig-v) 55%, var(--ig-vy));
	}
	.wo__body--sun {
		--wo-g: var(--ig-v);
	}
	.wo__slider {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		margin-top: 0.7rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.wo__slider b {
		color: var(--sl-color-white);
	}
	.wo__slider input {
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.wo__main {
		display: grid;
		grid-template-columns: 11rem 1fr;
		align-items: center;
		gap: 1rem;
		margin-top: 0.4rem;
	}
	.wo__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.wo__ground {
		fill: var(--wo-c);
		opacity: 0.55;
		transition: fill 0.3s;
	}
	.wo__person circle {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.wo__person path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.wo__scale {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
	}
	.wo__screen {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-accent);
		stroke-width: 1.5;
	}
	.wo__screen-text {
		fill: var(--sl-color-text-accent);
		font-size: 13px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.wo__calc {
		min-width: 0;
		color: var(--sl-color-white);
	}
	.wo__f {
		overflow-x: auto;
		overflow-y: hidden;
	}
	.wo__f :global(.katex-display) {
		margin: 0.4rem 0;
	}
	.wo__note {
		margin: 0.3rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.wo__note :global(b) {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.wo {
			padding: 0.75rem;
		}
		.wo__main {
			grid-template-columns: 1fr;
		}
		.wo__svg {
			max-width: 11rem;
			margin-inline: auto;
		}
	}
</style>

<script>
	import { G_SCHOOL, fmt, renderTex, tsci } from './util';

	const G_EARTH = 9.8;
	/** g with 3 significant digits (2 decimals below 10). */
	const roundG = (g: number) => Number(g.toPrecision(3));
	const gDigits = (g: number) => (g < 10 ? 2 : g < 100 ? 1 : 0);

	for (const root of document.querySelectorAll<HTMLElement>('[data-wo]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-body]'));
		const mIn = q<HTMLInputElement>('[data-mass]');
		let cur = btns.find((b) => b.getAttribute('aria-checked') === 'true')!;

		const draw = () => {
			const m = Number(mIn.value);
			q('[data-m-out]').textContent = `${m} кг`;
			const M = Number(cur.dataset.m);
			const R = Number(cur.dataset.r);
			const g = roundG((G_SCHOOL * M) / (R * R));
			const d = gDigits(g);
			const P = Math.round(m * g);
			root.style.setProperty('--wo-c', getComputedStyle(cur).getPropertyValue('--wo-g'));
			q('[data-screen]').textContent = `${fmt(P, 0, true)} Н`;
			const narrow = root.clientWidth < 560;
			const frac = `\\dfrac{6{,}67\\cdot 10^{-11}\\cdot ${tsci(M, 3)}}{\\left(${tsci(R, 3)}\\right)^2}~\\dfrac{\\text{м}}{\\text{с}^2}`;
			const gTex = `${fmt(g, d).replace(',', '{,}')}~\\dfrac{\\text{м}}{\\text{с}^2}`;
			renderTex(
				q('[data-f1]'),
				narrow ? `\\begin{aligned}g &= G\\,\\dfrac{M}{R^2} \\\\ &= ${frac} \\\\ &\\approx ${gTex}\\end{aligned}` : `g = G\\,\\dfrac{M}{R^2} = ${frac} \\approx ${gTex}`,
			);
			renderTex(q('[data-f2]'), `P = mg = ${m}~\\text{кг}\\cdot ${fmt(g, d).replace(',', '{,}')}~\\dfrac{\\text{м}}{\\text{с}^2} \\approx ${fmt(P, 0, true).replace(/ /g, '\\,')}~\\text{Н}`);
			const ratio = g / G_EARTH;
			const kg = cur.dataset.body === 'earth' ? m : (m * g) / G_EARTH;
			const cmp =
				cur.dataset.body === 'earth'
					? ''
					: ratio < 1
						? ` Это в <b>${fmt(1 / ratio, 1)}</b> раза меньше, чем на Земле.`
						: ` Это в <b>${fmt(ratio, 1)}</b> раза больше, чем на Земле.`;
			q("[data-out]").innerHTML =
				`${cur.dataset.info}${cmp} Обычные напольные весы, сделанные для Земли, показали бы ${cur.dataset.on} <b>${fmt(kg, kg < 100 ? 1 : 0, true)} кг</b>: они измеряют силу, с которой вы на них давите, и делят её на 9,8 Н/кг.`;
		};

		btns.forEach((b) =>
			b.addEventListener('click', () => {
				cur = b;
				btns.forEach((o) => o.setAttribute('aria-checked', String(o === b)));
				draw();
			}),
		);
		mIn.addEventListener('input', draw);
		let lastW = root.clientWidth;
		new ResizeObserver(() => {
			if (Math.abs(root.clientWidth - lastW) > 4) {
				lastW = root.clientWidth;
				draw();
			}
		}).observe(root);
		draw();
	}
</script>
