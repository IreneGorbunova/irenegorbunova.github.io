---
/**
 * Scheme of Cavendish's torsion balance (1797–1798), seen from above: a rod 1,8 м long on a thin wire, small lead
 * balls (0,73 кг) at its ends, big lead balls (158 кг) next to them on opposite sides, so both pulls turn the rod the
 * same way. Arrows: the forces on the small balls; curved arrows: the rod turns and twists the wire. Gaps between
 * the balls are drawn larger than in reality so that the arrows are visible.
 */
import PicStyles from './PicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `gpc-${uid}`;
const mT = `gpct-${uid}`;
---

<PicStyles />
<figure class="gp-pic gp-pic--one not-content">
	<div class="gp-pic__grid">
		<svg class="gp-pic__svg" viewBox="0 0 360 214" role="img" aria-label="Крутильные весы Кавендиша, вид сверху. Коромысло длиной 1,8 метра висит на тонкой проволоке, на его концах маленькие свинцовые шары. Рядом с ними, с разных сторон, большие свинцовые шары. Большие шары притягивают маленькие, и коромысло поворачивается, закручивая проволоку">
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="gp-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
				<marker id={mT} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
					<path class="gpc-turn-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<text class="gp-title" x="10" y="22">Крутильные весы Кавендиша, вид сверху</text>
			<!-- the rod, the wire (a point from above), the small balls -->
			<line class="gpc-rod" x1="60" y1="112" x2="300" y2="112"></line>
			<circle class="gpc-wire" cx="180" cy="112" r="4"></circle>
			<circle class="gp-lead" cx="60" cy="112" r="6"></circle>
			<circle class="gp-lead" cx="300" cy="112" r="6"></circle>
			<!-- the big balls -->
			<circle class="gp-lead gpc-big" cx="300" cy="64" r="20"></circle>
			<circle class="gp-lead gpc-big" cx="60" cy="160" r="20"></circle>
			<!-- the forces on the small balls -->
			<line class="gp-force" x1="300" y1="112" x2="300" y2="90" marker-end={`url(#${mA})`}></line>
			<line class="gp-force" x1="60" y1="112" x2="60" y2="134" marker-end={`url(#${mA})`}></line>
			<text class="gp-t-f" x="309" y="99"><tspan font-style="italic">F</tspan></text>
			<text class="gp-t-f" x="44" y="132"><tspan font-style="italic">F</tspan></text>
			<!-- the rod turns -->
			<path class="gpc-turn" d="M207.2 124.7 A30 30 0 0 0 204.6 94.8" marker-end={`url(#${mT})`}></path>
			<path class="gpc-turn" d="M152.8 99.3 A30 30 0 0 0 155.4 129.2" marker-end={`url(#${mT})`}></path>
			<!-- labels -->
			<text x="102" y="104" text-anchor="middle">коромысло, 1,8 м</text>
			<text x="272" y="52" text-anchor="end">большой шар, 158 кг</text>
			<text x="308" y="140" text-anchor="end">маленький шар, 0,73 кг</text>
			<line class="gp-dash" x1="180" y1="118" x2="180" y2="156"></line>
			<text x="180" y="170" text-anchor="middle">тонкая проволока</text>
			<text x="88" y="196">большой шар</text>
		</svg>
	</div>
	<figcaption>
		Коромысло с маленькими свинцовыми шарами висит на тонкой проволоке. Большие шары притягивают маленькие (стрелки), коромысло чуть поворачивается и закручивает проволоку. По углу поворота находят силу притяжения. Промежутки между шарами нарисованы больше настоящих.
	</figcaption>
</figure>

<style is:global>
	.gpc-rod {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.gpc-wire {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
	}
	.gpc-big {
		fill: var(--sl-color-gray-3);
	}
	.gpc-turn {
		fill: none;
		stroke: var(--sl-color-accent-high);
		stroke-width: 2;
	}
	.gpc-turn-head {
		fill: var(--sl-color-accent-high);
	}
</style>
