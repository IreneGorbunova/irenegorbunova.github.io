---
/**
 * Cavendish's torsion balance (1797–1798), seen from above, as an animation with a button (section «Гравитационная
 * постоянная»). Real apparatus (H. Cavendish, Phil. Trans. 88, 469, 1798): a wooden rod 1,8 м long hangs on a thin
 * wire; small lead balls 0,73 кг (5 см) at its ends; big lead balls 158 кг (30 см) hang from a frame that turns about
 * the same vertical axis, so they can be swung from a position across the rod («убраны», no turning pull: both balls
 * pull the rod equally both ways) to positions next to the small balls on opposite sides, about 23 см from center to
 * center. Then each pull is F = G·158·0,73/0,225² ≈ 1,5·10⁻⁷ Н, both turn the rod the same way, it twists the wire
 * and swings about a new rest position. With the stiffer wire Cavendish's «time of one vibration» (one swing, from one
 * extreme to the other) was about 7 мин, so the full period is about 14 мин; the rest position then moves by
 * θ = F·T²/(4π²·m·L) = 1,52·10⁻⁷ · 840² / (4π² · 0,73 · 0,9) ≈ 4,1·10⁻³ рад ≈ 0,24°, the ends of the rod by
 * θ·0,9 м ≈ 3,7 мм («about 4 мм»; the rod's own mass and the pull of each big ball on the far small ball, 0,2 %, are
 * neglected). Cavendish watched ivory scales at the ends of the rod through telescopes from outside the room; the
 * school version puts a small mirror on the wire and sends a light beam from it to a scale on the wall: the beam
 * turns by twice the angle of the rod. Both are said in the caption; the picture draws the school mirror.
 * What is changed: time sped up 120 times (1 с — 2 мин; one swing 3,5 с); the turn of the rod drawn 6° instead of
 * 0,24° (25 times larger); the swings die out faster than in the real experiment (damping ratio 0,2, chosen for the
 * picture: the rod settles in about three periods, 20 с); the gaps between the balls are drawn larger.
 * Geometry (px): axis at (180, 150), rod half-length 120, small balls r = 6, big balls r = 20 on a circle of 125
 * around the axis, at 90° from the rod («убраны») or 28° («поднесены»), swung in 3 с (eased). The rest angle follows
 * the turning pull of the big balls on the small ones computed with 1/d² in the drawing's geometry, normalized to 6°
 * at 28°; the rod obeys θ'' = −ω²(θ − θ₀) − 2ζωθ' with ω = 2π/7 с⁻¹, ζ = 0,2 (largest turn about 9°).
 * Readouts: minutes since the last change (real time of the experiment) and the shift of the ends of the rod in real
 * mm (3,7 мм at the new rest). Arrows: the pulls of the big balls on the small ones (--ig-v as every force of the
 * chapter), length ∝ 1/d², hidden when shorter than 6 px. The picture swaps the balls by itself 22 с after the last
 * change (and 1,5 с after it is first seen), so it keeps moving without a click.
 */
import G7Styles from '../g7/G7Styles.astro';

const C = { x: 180, y: 150 };
const ticks = Array.from({ length: 13 }, (_, i) => 146 + i * 9);
---

<G7Styles />
<figure class="g7 not-content" data-gr-cav>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Крутильные весы Кавендиша, вид сверху. Коромысло с маленькими свинцовыми шарами висит на тонкой проволоке. Когда к маленьким шарам подносят большие, коромысло поворачивается к ним, качается и останавливается, а луч света от зеркальца на проволоке сдвигается по шкале">
			<text class="gc-title" x="10" y="22">Вид сверху</text>
			<!-- the light: lamp → mirror → scale -->
			<line class="gc-beam" x1="296" y1="279" x2={C.x} y2={C.y}></line>
			<line class="gc-beam" data-ray x1={C.x} y1={C.y}></line>
			<line class="gc-scale" x1="352" y1="140" x2="352" y2="258"></line>
			{ticks.map((y) => <line class="gc-tick" x1="346" y1={y} x2="352" y2={y}></line>)}
			<circle class="gc-spot" r="3.5" cx="352" data-spot></circle>
			<g transform="translate(296 279) rotate(-131.4)">
				<rect class="gc-lamp" x="-14" y="-6" width="14" height="12" rx="2"></rect>
				<rect class="gc-lens" x="0" y="-5" width="3" height="10" rx="1"></rect>
			</g>
			<text class="gc-lab" x="278" y="290" text-anchor="end">лампа</text>
			<text class="gc-lab" x="356" y="276" text-anchor="end">шкала</text>
			<!-- the rod, the small balls and their labels turn together -->
			<g data-rod>
				<line class="gc-rod" x1="-120" y1="0" x2="120" y2="0"></line>
				<circle class="gc-lead" cx="-120" cy="0" r="6"></circle>
				<circle class="gc-lead" cx="120" cy="0" r="6"></circle>
				<text class="gc-lab" x="-112" y="-11">коромысло, 1,8 м</text>
				<text class="gc-lab" x="-126" y="-10" text-anchor="end">0,73 кг</text>
			</g>
			<line class="gc-mirror" x1="0" y1="-7" x2="0" y2="7" data-mirror></line>
			<circle class="gc-wire" cx={C.x} cy={C.y} r="3"></circle>
			<path class="gc-leader" d="M156 66 L179.5 145"></path>
			<text class="gc-lab" x="156" y="62" text-anchor="end">проволока с зеркальцем</text>
			<!-- the big balls -->
			<circle class="gc-lead gc-big" r="20" data-big="0"></circle>
			<circle class="gc-lead gc-big" r="20" data-big="1"></circle>
			<text class="gc-lab" data-biglab>158 кг</text>
			<!-- the pulls -->
			<path class="gc-force" data-f="0"></path>
			<path class="gc-head" data-fh="0"></path>
			<path class="gc-force" data-f="1"></path>
			<path class="gc-head" data-fh="1"></path>
			<g data-flab="0" opacity="0"><text class="gc-f" x="0" y="0">F</text><path class="gc-vec" d="M-0.5 -13 H7.5 M5 -15.5 L7.5 -13 L5 -10.5"></path></g>
			<g data-flab="1" opacity="0"><text class="gc-f" x="0" y="0">F</text><path class="gc-vec" d="M-0.5 -13 H7.5 M5 -15.5 L7.5 -13 L5 -10.5"></path></g>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Поднести шары</button>
			</div>
			<ul class="g7__read">
				<li>Прошло <b data-min>0 мин</b></li>
				<li class="is-warm">Концы коромысла сдвинулись на <b data-mm>0,0 мм</b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Коромысло длиной 1,8&nbsp;м с маленькими свинцовыми шарами (0,73&nbsp;кг) висит на тонкой проволоке. Большие шары
		(158&nbsp;кг) притягивают маленькие (стрелки), коромысло поворачивается, закручивает проволоку и, покачавшись,
		останавливается. В опыте Кавендиша один размах длился около 7&nbsp;минут, а концы коромысла сдвигались примерно на
		4&nbsp;мм; он следил за ними в подзорные трубы. В школьном опыте сдвиг показывает луч света от зеркальца на
		проволоке. Время ускорено в 120 раз, поворот коромысла увеличен в 25 раз, качания затухают быстрее, чем в опыте;
		промежутки между шарами нарисованы больше настоящих.
	</figcaption>
</figure>

<style is:global>
	[data-gr-cav] .g7__svg .gc-title {
		font-size: 13px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	[data-gr-cav] .g7__svg .gc-lab {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	[data-gr-cav] .gc-rod {
		stroke: var(--g7-wood);
		stroke-width: 3.5;
		stroke-linecap: round;
	}
	[data-gr-cav] .gc-lead {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-gr-cav] .gc-big {
		fill: var(--sl-color-gray-3);
	}
	[data-gr-cav] .gc-wire {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
	}
	[data-gr-cav] .gc-mirror {
		stroke: var(--ig-vx);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	[data-gr-cav] .gc-beam {
		stroke: var(--sl-color-accent-high);
		stroke-width: 1.4;
		opacity: 0.85;
	}
	[data-gr-cav] .gc-spot {
		fill: var(--sl-color-accent-high);
	}
	[data-gr-cav] .gc-scale,
	[data-gr-cav] .gc-tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-gr-cav] .gc-scale {
		stroke-width: 2;
	}
	[data-gr-cav] .gc-lamp {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-gr-cav] .gc-lens {
		fill: var(--sl-color-accent-high);
	}
	[data-gr-cav] .gc-leader {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
	}
	[data-gr-cav] .gc-force {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-gr-cav] .gc-head {
		fill: var(--ig-v);
	}
	[data-gr-cav] .g7__svg .gc-f {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 700;
		font-size: 15px;
		fill: var(--ig-v);
	}
	[data-gr-cav] .gc-vec {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const D2R = Math.PI / 180;
	for (const fig of document.querySelectorAll<HTMLElement>('[data-gr-cav]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const C = { x: 180, y: 150 };
		const RS = 120; // small balls from the axis, px
		const RB = 125; // big balls from the axis, px
		const AWAY = 90 * D2R;
		const NEAR = 28 * D2R;
		const TH_EQ = 6 * D2R; // drawn rest turn with the big balls near (real 0,24°)
		const MM_EQ = 3.7; // real shift of the ends at the new rest, mm
		const W = (2 * Math.PI) / 7; // full period 7 s here = 14 min
		const ZETA = 0.2;
		const SWING = 3; // s to swing the big balls
		const AUTO = 22; // s
		const MIN_PER_S = 2;
		// screen point at angle a (counterclockwise on screen) and distance r from the axis
		const at = (r: number, a: number) => ({ x: C.x + r * Math.cos(a), y: C.y - r * Math.sin(a) });
		// the turning pull (torque) of both big balls at angle phi on the rod at rest at 0, 1/d² in the drawing
		const torque = (phi: number) => {
			let s = 0;
			for (const k of [0, 1]) {
				const b = at(RB, phi + k * Math.PI);
				for (const j of [0, 1]) {
					const a = j * Math.PI;
					const p = at(RS, a);
					const dx = b.x - p.x;
					const dy = b.y - p.y;
					const d = Math.hypot(dx, dy);
					// counterclockwise tangent on screen at angle a: (−sin a, −cos a)
					s += (dx * -Math.sin(a) + dy * -Math.cos(a)) / d ** 3;
				}
			}
			return s;
		};
		const T_NEAR = torque(NEAR);
		const ease = (u: number) => (u <= 0 ? 0 : u >= 1 ? 1 : u * u * (3 - 2 * u));
		// the mirror: the beam comes from the lamp and goes to the scale at x = 352
		const L = { x: 296, y: 279 };
		const aL = Math.atan2(-(L.y - C.y), L.x - C.x); // direction to the lamp (math angle)
		const aR0 = -22 * D2R; // reflected direction at θ = 0
		const n0 = (aL + aR0) / 2; // the mirror's normal at θ = 0

		let near = false;
		let phiFrom = AWAY;
		let phiTo = AWAY;
		let ts = 1e9; // s since the last change (1e9: nothing happened yet)
		let th = 0;
		let om = 0;
		const btn = q<HTMLButtonElement>('[data-go]');
		const phiNow = () => (ts > 1e8 ? phiTo : phiFrom + (phiTo - phiFrom) * ease(ts / SWING));
		const toggle = () => {
			phiFrom = phiNow();
			near = !near;
			phiTo = near ? NEAR : AWAY;
			ts = 0;
			btn.textContent = near ? 'Убрать шары' : 'Поднести шары';
		};
		const arrow = (i: number, p: { x: number; y: number }, b: { x: number; y: number }, len: number) => {
			const f = q(`[data-f="${i}"]`);
			const h = q(`[data-fh="${i}"]`);
			const lab = q(`[data-flab="${i}"]`);
			if (len < 6) {
				f.setAttribute('d', '');
				h.setAttribute('d', '');
				lab.setAttribute('opacity', '0');
				return;
			}
			const dx = b.x - p.x;
			const dy = b.y - p.y;
			const d = Math.hypot(dx, dy);
			const ux = dx / d;
			const uy = dy / d;
			const s = { x: p.x + ux * 7, y: p.y + uy * 7 };
			const e = { x: s.x + ux * len, y: s.y + uy * len };
			const base = { x: e.x - ux * 7, y: e.y - uy * 7 };
			f.setAttribute('d', `M${s.x.toFixed(1)} ${s.y.toFixed(1)} L${base.x.toFixed(1)} ${base.y.toFixed(1)}`);
			h.setAttribute('d', `M${e.x.toFixed(1)} ${e.y.toFixed(1)} L${(base.x - uy * 4.5).toFixed(1)} ${(base.y + ux * 4.5).toFixed(1)} L${(base.x + uy * 4.5).toFixed(1)} ${(base.y - ux * 4.5).toFixed(1)} Z`);
			// the letter next to the small ball: above right of the right one, below left of the left one
			lab.setAttribute('transform', i === 0 ? `translate(${(p.x + 9).toFixed(1)} ${(p.y - 6).toFixed(1)})` : `translate(${(p.x - 19).toFixed(1)} ${(p.y + 16).toFixed(1)})`);
			lab.setAttribute('opacity', '1');
		};
		const dNear = Math.hypot(at(RB, NEAR).x - at(RS, TH_EQ).x, at(RB, NEAR).y - at(RS, TH_EQ).y);
		const draw = () => {
			const phi = phiNow();
			q('[data-rod]').setAttribute('transform', `translate(${C.x} ${C.y}) rotate(${(-th / D2R).toFixed(2)})`);
			q('[data-mirror]').setAttribute('transform', `translate(${C.x} ${C.y}) rotate(${(-(n0 + th) / D2R).toFixed(2)})`);
			const bigs = [at(RB, phi), at(RB, phi + Math.PI)];
			bigs.forEach((b, i) => {
				const c = q(`[data-big="${i}"]`);
				c.setAttribute('cx', b.x.toFixed(1));
				c.setAttribute('cy', b.y.toFixed(1));
			});
			const bl = q('[data-biglab]');
			bl.setAttribute('x', (bigs[0].x + 24).toFixed(1));
			bl.setAttribute('y', (bigs[0].y + 4).toFixed(1));
			// pulls on the small balls, 22 px at the nearest drawn distance
			const smalls = [at(RS, th), at(RS, th + Math.PI)];
			smalls.forEach((p, i) => {
				const b = bigs[i];
				const d = Math.hypot(b.x - p.x, b.y - p.y);
				arrow(i, p, b, 22 * (dNear / d) ** 2);
			});
			// the reflected ray turns by twice the rod's angle
			const aR = 2 * (n0 + th) - aL;
			const y = C.y - (352 - C.x) * Math.tan(aR);
			const ray = q('[data-ray]');
			ray.setAttribute('x2', '352');
			ray.setAttribute('y2', y.toFixed(1));
			q('[data-spot]').setAttribute('cy', y.toFixed(1));
			const min = ts > 1e8 ? 0 : Math.floor(ts * MIN_PER_S);
			q('[data-min]').textContent = `${min} мин`;
			const mm = (MM_EQ * th) / TH_EQ;
			q('[data-mm]').textContent = `${(Math.abs(mm) < 0.05 ? 0 : mm).toFixed(1).replace('.', ',').replace('-', '−')} мм`;
		};
		let idle = 1.5; // the first swing starts by itself soon after the picture is seen
		const wake = loop(fig, (dt) => {
			if (ts > 1e8) {
				idle -= dt;
				if (idle <= 0) toggle();
			} else {
				ts += dt;
				if (ts > AUTO) toggle();
			}
			const target = (TH_EQ * torque(phiNow())) / T_NEAR;
			const n = 8;
			const h = dt / n;
			for (let i = 0; i < n; i++) {
				const acc = -W * W * (th - target) - 2 * ZETA * W * om;
				om += acc * h;
				th += om * h;
			}
			draw();
			return true;
		});
		btn.addEventListener('click', () => {
			toggle();
			wake();
		});
		draw();
	}
</script>
