---
/**
 * Small pictures to «Где это встречается»: the tides (the Moon pulls the near side of the Earth more than its
 * centre, and the centre more than the far side: water bulges on both sides), a jump on the Moon, a satellite (its
 * velocity along the path, the pull towards the Earth) and the planets around the Sun. Not to scale.
 */
import PicStyles from './PicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `gpu-${uid}`;
const mV = `gpuv-${uid}`;
const rad = Math.PI / 180;
// satellite: Earth (80, 88), path radius 54, at 40°
const sat = [80 + 54 * Math.cos(40 * rad), 88 - 54 * Math.sin(40 * rad)];
const vel = [-Math.sin(40 * rad), -Math.cos(40 * rad)];
const toC = [-Math.cos(40 * rad), Math.sin(40 * rad)];
// planets: the Sun (30, 84)
const ORBITS = [34, 56, 80, 108, 136];
const PLANETS: [number, number, number][] = [
	[34, 60, 2.5],
	[56, -35, 3.5],
	[80, 18, 3.8],
	[108, -12, 3],
	[136, 22, 6],
];
const pl = (r: number, a: number) => [30 + r * Math.cos(a * rad), 84 - r * Math.sin(a * rad)];
const f = (v: number) => v.toFixed(1);
---

<PicStyles />
<figure class="gp-pic not-content">
	<div class="gp-pic__grid">
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Приливы: Луна притягивает ближнюю к ней сторону Земли сильнее, центр Земли слабее, а дальнюю сторону ещё слабее. Вода поднимается горбами с двух сторон">
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="gp-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
				<marker id={mV} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="gpu-vhead" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<ellipse class="gp-water" cx="72" cy="86" rx="46" ry="33"></ellipse>
			<circle class="gp-land" cx="72" cy="86" r="30"></circle>
			<circle class="gp-moon" cx="162" cy="86" r="8"></circle>
			<line class="gp-force" x1="30" y1="86" x2="44" y2="86" marker-end={`url(#${mA})`}></line>
			<line class="gp-force" x1="72" y1="86" x2="93" y2="86" marker-end={`url(#${mA})`}></line>
			<line class="gp-force" x1="106" y1="86" x2="136" y2="86" marker-end={`url(#${mA})`}></line>
			<text class="gp-title" x="172" y="20" text-anchor="end">Приливы</text>
			<text x="162" y="112" text-anchor="middle">Луна</text>
		</svg>
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Прыжок на Луне: человек в скафандре летит по высокой дуге">
			<rect class="gpu-mground" x="0" y="126" width="180" height="24"></rect>
			<ellipse class="gp-crater" cx="30" cy="138" rx="10" ry="3.5"></ellipse>
			<ellipse class="gp-crater" cx="140" cy="140" rx="14" ry="4"></ellipse>
			<circle class="gp-earth" cx="26" cy="30" r="9"></circle>
			<path class="gp-dash" d="M40 126 Q95 -40 150 126"></path>
			<g transform="translate(67.5 64)">
				<path class="gp-person" d="M0 -22 L0 -10 M0 -10 L-5 0 M0 -10 L5 0 M0 -19 L-8 -12 M0 -19 L8 -14" style="stroke-width: 4.5"></path>
				<circle class="gp-person-head" cx="0" cy="-27" r="6.5"></circle>
			</g>
			<text class="gp-title" x="172" y="20" text-anchor="end">Прыжок на Луне</text>
		</svg>
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Спутник летит вокруг Земли. Его скорость направлена по касательной к пути, а Земля притягивает его к своему центру">
			<circle class="gp-earth" cx="80" cy="88" r="34"></circle>
			<path class="gp-land" d="M68 66 q12 -6 20 2 q4 10 -4 14 q-10 2 -12 10 q-8 2 -10 -6 q-2 -12 6 -20 z"></path>
			<circle class="gp-dash" cx="80" cy="88" r="54"></circle>
			<line class="gpu-vel" x1={f(sat[0])} y1={f(sat[1])} x2={f(sat[0] + 32 * vel[0])} y2={f(sat[1] + 32 * vel[1])} marker-end={`url(#${mV})`}></line>
			<line class="gp-force" x1={f(sat[0])} y1={f(sat[1])} x2={f(sat[0] + 17 * toC[0])} y2={f(sat[1] + 17 * toC[1])} marker-end={`url(#${mA})`}></line>
			<rect class="gpu-sat" x={f(sat[0] - 4)} y={f(sat[1] - 3)} width="8" height="6" rx="1.5"></rect>
			<text class="gp-title" x="172" y="20" text-anchor="end">Спутник</text>
		</svg>
		<svg class="gp-pic__svg" viewBox="0 0 180 150" role="img" aria-label="Планеты обращаются вокруг Солнца; Солнце притягивает каждую из них">
			{ORBITS.map((r) => <circle class="gp-dash" cx="30" cy="84" r={r} />)}
			<circle class="gp-sun" cx="30" cy="84" r="14"></circle>
			{PLANETS.map(([r, a, s]) => {
				const [x, y] = pl(r, a);
				return <circle class={r === 80 ? 'gp-earth' : 'gpu-planet'} cx={f(x)} cy={f(y)} r={s} />;
			})}
			<line class="gp-force" x1={f(pl(80, 18)[0])} y1={f(pl(80, 18)[1])} x2={f(pl(58, 18)[0])} y2={f(pl(58, 18)[1])} marker-end={`url(#${mA})`}></line>
			<text class="gp-title" x="172" y="20" text-anchor="end">Солнце и планеты</text>
		</svg>
	</div>
	<figcaption>
		Луна притягивает ближнюю к ней сторону Земли сильнее, чем центр Земли, а центр — сильнее, чем дальнюю сторону (длина стрелок), и вода поднимается горбами с двух сторон. Спутник летит вбок (синяя стрелка), а Земля притягивает его к своему центру; так же Солнце притягивает планеты. Размеры и расстояния не в масштабе, горбы воды и разница в длине стрелок сильно преувеличены.
	</figcaption>
</figure>

<style is:global>
	.gpu-mground {
		fill: var(--sl-color-gray-4);
	}
	.gpu-vel {
		stroke: var(--ig-vx);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.gpu-vhead {
		fill: var(--ig-vx);
	}
	.gpu-sat {
		fill: var(--sl-color-gray-1);
	}
	.gpu-planet {
		fill: var(--sl-color-gray-2);
	}
</style>
