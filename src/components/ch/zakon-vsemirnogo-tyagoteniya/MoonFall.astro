---
/**
 * «Ньютон и Луна» — the main model of the chapter: Newton's test of the inverse-square law.
 * Left: the Moon on its orbit, distances to scale (orbit radius 384 400 км ↔ 136 px; the Earth and the Moon
 * themselves are drawn SIZE times larger). A "ghost" Moon flies on along the tangent — where the Moon would be
 * without gravity; the segment from it to the real Moon is how far gravity has pulled the Moon towards the Earth.
 * Right: the first second, one vertical scale for both: an apple falls g·t²/2 (4,9 м); the Moon falls a·t²/2
 * below its tangent (1,36 мм), drawn MAG = 3600 times larger. a = 4π²r/T² with r = 384 400 км, T = 27,32 сут.
 */
const R_ORBIT = 136; // px for 384 400 km
const SIZE = 4; // the bodies are drawn 4 times larger than to scale
const rEarth = (6371 / 384400) * R_ORBIT * SIZE;
const rMoon = (1737.4 / 384400) * R_ORBIT * SIZE;
const C = 180;
// Right panel: one vertical scale for the apple and the magnified Moon
const PX_M = 56; // px per metre
const Y0 = 50;
const GROUND = Y0 + 4.9 * PX_M;
const AX = 112; // apple column
const MX = 266; // Moon column
const rulerTicks = [0, 1, 2, 3, 4];
const strobe = [0.25, 0.5, 0.75, 1];
const stars = [
	[22, 30, 1], [70, 18, 0.7], [320, 40, 1.1], [340, 120, 0.7], [28, 300, 0.9], [300, 330, 1], [110, 340, 0.6],
	[200, 22, 0.6], [16, 190, 0.7], [348, 250, 0.8], [250, 300, 0.5], [90, 95, 0.5], [270, 70, 0.6],
];
---

<figure class="mf not-content" data-mf>
	<div class="mf__panels">
		<div class="mf__panel">
			<p class="mf__head">Луна на орбите</p>
			<svg class="mf__svg mf__svg--orbit" viewBox="0 0 360 360" role="img" aria-label="Луна обращается вокруг Земли. Пунктиром — путь по касательной, по которому Луна летела бы без тяготения.">
				<g class="mf__stars" aria-hidden="true">
					{stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
				</g>
				<circle class="mf__orbit" cx={C} cy={C} r={R_ORBIT} />
				<path class="mf__done" data-done />
				<line class="mf__tangent" data-tan />
				<line class="mf__fall" data-fall />
				<text class="mf__fall-label" data-fall-label>падение</text>
				<circle class="mf__ghost" r={rMoon + 3} data-ghost />
				<circle class="mf__earth" cx={C} cy={C} r={rEarth} />
				<path class="mf__earth-shade" d={`M ${C} ${C - rEarth} A ${rEarth} ${rEarth} 0 0 1 ${C} ${C + rEarth} A ${rEarth * 0.45} ${rEarth} 0 0 0 ${C} ${C - rEarth} Z`} />
				<text class="mf__lbl" x={C} y={C + rEarth + 15} text-anchor="middle">Земля</text>
				<circle class="mf__moon" r={rMoon} data-moon />
				<text class="mf__lbl" data-moon-label>Луна</text>
			</svg>
			<p class="mf__read" data-orbit-read aria-live="off"></p>
		</div>

		<div class="mf__panel">
			<p class="mf__head">Первая секунда падения</p>
			<svg class="mf__svg" viewBox="0 0 360 360" role="img" aria-label="Яблоко и Луна за первую секунду: яблоко падает на 4,9 метра, Луна — на 1,36 миллиметра, на рисунке это падение увеличено в 3600 раз.">
				<!-- ruler of the fall, metres -->
				<g class="mf__ruler" aria-hidden="true">
					<line x1="34" y1={Y0} x2="34" y2={GROUND} />
					{rulerTicks.map((v) => <line x1="28" y1={Y0 + v * PX_M} x2="34" y2={Y0 + v * PX_M} />)}
					{rulerTicks.map((v) => <text x="24" y={Y0 + v * PX_M + 4} text-anchor="end">{v}</text>)}
					<text x="24" y={Y0 - 12} text-anchor="end">м</text>
				</g>
				<!-- the apple tree branch and the ground -->
				<path class="mf__branch" d={`M 40 ${Y0 - 34} C 70 ${Y0 - 30}, 92 ${Y0 - 22}, ${AX + 22} ${Y0 - 26}`} />
				<path class="mf__branch mf__branch--twig" d={`M ${AX - 4} ${Y0 - 25} L ${AX} ${Y0 - 10}`} />
				<ellipse class="mf__leaf" cx={AX + 30} cy={Y0 - 30} rx="11" ry="5.5" transform={`rotate(-18 ${AX + 30} ${Y0 - 30})`} />
				<ellipse class="mf__leaf" cx="78" cy={Y0 - 38} rx="10" ry="5" transform={`rotate(24 78 ${Y0 - 38})`} />
				<ellipse class="mf__leaf" cx={AX + 12} cy={Y0 - 38} rx="9" ry="4.5" transform={`rotate(-40 ${AX + 12} ${Y0 - 38})`} />
				<line class="mf__ground" x1="40" y1={GROUND} x2="180" y2={GROUND} />

				<!-- the Moon's tangent -->
				<line class="mf__tangent" x1="196" y1={Y0} x2="350" y2={Y0} />
				<text class="mf__lbl mf__lbl--small" x="352" y={Y0 - 18} text-anchor="end">касательная</text>
				<circle class="mf__ghost" cx={MX} cy={Y0} r="13" />

				<!-- strobe marks: where each body is after 0,25; 0,5; 0,75; 1 s -->
				<g class="mf__strobe" data-strobe>
					{
						strobe.map((t) => (
							<g data-st={t} class="mf__st">
								<line x1={AX + 16} y1={Y0 + 4.9 * t * t * PX_M} x2={MX - 18} y2={Y0 + 4.9 * t * t * PX_M} />
								<text x={(AX + MX) / 2} y={Y0 + 4.9 * t * t * PX_M - 4} text-anchor="middle">
									{String(t).replace('.', ',')} с
								</text>
							</g>
						))
					}
				</g>

				<g data-apple>
					<circle class="mf__apple" cx={AX} cy={Y0} r="9" />
					<path class="mf__apple-leaf" d={`M ${AX} ${Y0 - 8} q 5 -7 10 -5 q -4 6 -10 5 z`} />
				</g>
				<g data-moon2>
					<circle class="mf__moon mf__moon--big" cx={MX} cy={Y0} r="13" />
					<circle class="mf__mare" cx={MX - 4} cy={Y0 - 4} r="3.6" />
					<circle class="mf__mare" cx={MX + 4} cy={Y0 + 3} r="2.6" />
					<circle class="mf__mare" cx={MX - 2} cy={Y0 + 6} r="1.6" />
				</g>
				<text class="mf__lbl" x={AX} y={GROUND + 17} text-anchor="middle">яблоко</text>
				<text class="mf__lbl" x={MX} y={GROUND + 17} text-anchor="middle">Луна</text>
				<text class="mf__lbl mf__lbl--mag" x={MX} y={GROUND + 32} text-anchor="middle">увеличено в 3600 раз</text>
			</svg>
			<p class="mf__read" data-sec-read aria-live="off"></p>
		</div>
	</div>

	<div class="mf__bar">
		<button type="button" class="mf__btn" data-pause aria-pressed="false">Пауза</button>
		<p class="mf__note">
			Расстояния на орбите — в масштабе, Земля и Луна нарисованы в {SIZE} раза крупнее. Справа время замедлено в 2,5 раза, а падение Луны увеличено в 3600 раз.
		</p>
	</div>
</figure>

<style>
	.mf {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.mf__panels {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.mf__panel {
		min-width: 0;
	}
	.mf__head {
		margin: 0 0 0.3rem;
		font-weight: 700;
		color: var(--sl-color-white);
		text-align: center;
	}
	.mf__svg {
		display: block;
		width: 100%;
		max-width: 26rem;
		height: auto;
		margin-inline: auto;
		overflow: visible;
	}
	.mf__svg--orbit {
		overflow: hidden;
	}
	.mf__read {
		min-height: 3.9em;
		margin: 0.3rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.mf__read :global(b) {
		color: var(--sl-color-white);
	}
	.mf__read :global(i) {
		font-family: var(--ig-font-math);
	}
	.mf__stars circle {
		fill: var(--sl-color-gray-3);
		opacity: 0.5;
	}
	.mf__orbit {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 2 4;
	}
	.mf__done {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.mf__tangent {
		stroke: var(--sl-color-accent-high);
		stroke-width: 1.5;
		stroke-dasharray: 6 4;
	}
	.mf__fall {
		stroke: var(--ig-vy);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.mf__fall-label {
		fill: var(--ig-vy);
		font-size: 14px;
		font-weight: 700;
	}
	.mf__ghost {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 3 2;
	}
	.mf__earth {
		fill: var(--ig-vx);
	}
	.mf__earth-shade {
		fill: var(--sl-color-black);
		opacity: 0.35;
	}
	.mf__moon {
		fill: var(--sl-color-gray-2);
	}
	.mf__moon--big {
		fill: var(--sl-color-gray-3);
	}
	.mf__mare {
		fill: var(--sl-color-gray-5);
		opacity: 0.7;
	}
	.mf__lbl {
		fill: var(--sl-color-gray-2);
		font-size: 15px;
	}
	.mf__lbl--small {
		font-size: 13.5px;
		fill: var(--sl-color-gray-3);
	}
	.mf__lbl--mag {
		font-size: 13.5px;
		font-weight: 700;
		fill: var(--sl-color-text-accent);
	}
	.mf__ruler line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mf__ruler text {
		fill: var(--sl-color-gray-3);
		font-size: 13px;
	}
	.mf__branch {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.mf__branch--twig {
		stroke-width: 1.5;
	}
	.mf__leaf,
	.mf__apple-leaf {
		fill: color-mix(in srgb, var(--ig-vx) 45%, var(--ig-v));
		opacity: 0.85;
	}
	.mf__ground {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.mf__apple {
		fill: var(--ig-vy);
	}
	.mf__st {
		opacity: 0;
		transition: opacity 0.25s;
	}
	.mf__st.is-on {
		opacity: 1;
	}
	.mf__st line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.mf__st text {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
	}
	.mf__bar {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-top: 0.6rem;
	}
	.mf__btn {
		flex: none;
		padding: 0.35rem 0.9rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.mf__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.mf__note {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 44rem) {
		.mf {
			padding: 0.75rem;
		}
		.mf__panels {
			grid-template-columns: 1fr;
		}
		.mf__svg--orbit {
		overflow: hidden;
	}
	.mf__read {
			min-height: 0;
		}
	}
</style>

<script>
	import { animator, fmt } from './util';

	const R_ORBIT = 136;
	const C = 180;
	const R_KM = 384400;
	const T_DAYS = 27.32;
	const T_S = T_DAYS * 86400;
	const A_MOON = (4 * Math.PI ** 2 * R_KM * 1000) / T_S ** 2; // 2,72·10⁻³ м/с²
	const G_EARTH = 9.8;
	const MAG = 3600;
	const PX_M = 56;
	const Y0 = 50;
	const MX = 266;
	const AX = 112;
	// Orbit view timing (real seconds): one revolution in REV s; the ghost flies FLY s, then everything holds HOLD s.
	const REV = 24;
	const FLY = 2.5;
	const HOLD = 1.8;
	// First-second view: 1 s of physics in SLOW real seconds, then a hold.
	const SLOW = 2.5;
	const HOLD2 = 1.4;
	const rMoon = (1737.4 / 384400) * R_ORBIT * 4;

	for (const root of document.querySelectorAll<HTMLElement>('[data-mf]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const moon = q<SVGCircleElement>('[data-moon]');
		const moonLabel = q<SVGTextElement>('[data-moon-label]');
		const ghost = q<SVGCircleElement>('[data-ghost]');
		const tan = q<SVGLineElement>('[data-tan]');
		const fall = q<SVGLineElement>('[data-fall]');
		const fallLabel = q<SVGTextElement>('[data-fall-label]');
		const done = q<SVGPathElement>('[data-done]');
		const orbitRead = q<HTMLElement>('[data-orbit-read]');
		const secRead = q<HTMLElement>('[data-sec-read]');
		const apple = q<SVGGElement>('[data-apple]');
		const moon2 = q<SVGGElement>('[data-moon2]');
		const strobes = Array.from(root.querySelectorAll<SVGGElement>('[data-st]'));
		const pauseBtn = q<HTMLButtonElement>('[data-pause]');

		let paused = false;
		// orbit state
		let th = 2.2; // current angle of the Moon (radians, counter-clockwise, y up)
		let th0 = th; // angle at the release of the ghost
		let phase: 'fly' | 'hold' = 'fly';
		let tPhase = 0;
		// first-second state
		let t2 = 0;

		const pt = (a: number, r = R_ORBIT) => ({ x: C + r * Math.cos(a), y: C - r * Math.sin(a) });

		const drawOrbit = () => {
			const m = pt(th);
			moon.setAttribute('cx', m.x.toFixed(2));
			moon.setAttribute('cy', m.y.toFixed(2));
			// the Moon's name inside the orbit, towards the Earth
			const lp = pt(th, R_ORBIT - 14);
			moonLabel.setAttribute('x', lp.x.toFixed(1));
			moonLabel.setAttribute('y', (lp.y + 4).toFixed(1));
			moonLabel.setAttribute('text-anchor', Math.cos(th) > 0.3 ? 'end' : Math.cos(th) < -0.3 ? 'start' : 'middle');

			const dth = th - th0;
			const p0 = pt(th0);
			// velocity direction for counter-clockwise motion (screen y down)
			const ux = -Math.sin(th0);
			const uy = -Math.cos(th0);
			const L = R_ORBIT * dth; // the ghost moves with the Moon's speed: path = arc length
			const gx = p0.x + ux * L;
			const gy = p0.y + uy * L;
			const far = R_ORBIT * 1.05;
			tan.setAttribute('x1', (p0.x - ux * 14).toFixed(2));
			tan.setAttribute('y1', (p0.y - uy * 14).toFixed(2));
			tan.setAttribute('x2', (p0.x + ux * far).toFixed(2));
			tan.setAttribute('y2', (p0.y + uy * far).toFixed(2));
			ghost.setAttribute('cx', gx.toFixed(2));
			ghost.setAttribute('cy', gy.toFixed(2));
			fall.setAttribute('x1', gx.toFixed(2));
			fall.setAttribute('y1', gy.toFixed(2));
			fall.setAttribute('x2', m.x.toFixed(2));
			fall.setAttribute('y2', m.y.toFixed(2));
			const dPx = Math.hypot(gx - m.x, gy - m.y);
			fall.style.opacity = dPx > rMoon + 2 ? '1' : '0';
			fallLabel.style.opacity = dPx > 14 ? '1' : '0';
			// label next to the segment, on the side where the Moon is heading (that side is empty)
			const mx = (gx + m.x) / 2;
			const my = (gy + m.y) / 2;
			const vx = -Math.sin(th);
			const vy = -Math.cos(th);
			fallLabel.setAttribute('x', (mx + vx * 10).toFixed(1));
			fallLabel.setAttribute('y', (my + vy * 10 + 4).toFixed(1));
			fallLabel.setAttribute('text-anchor', vx > 0.4 ? 'start' : vx < -0.4 ? 'end' : 'middle');
			// the arc travelled since the release
			const large = dth > Math.PI ? 1 : 0;
			done.setAttribute('d', dth > 0.002 ? `M ${p0.x.toFixed(2)} ${p0.y.toFixed(2)} A ${R_ORBIT} ${R_ORBIT} 0 ${large} 0 ${m.x.toFixed(2)} ${m.y.toFixed(2)}` : '');

			const days = (dth / (2 * Math.PI)) * T_DAYS;
			const devKm = (dPx / R_ORBIT) * R_KM;
			const devTxt = devKm < 1000 ? `${fmt(devKm, 0)} км` : `${fmt(Math.round(devKm / 100) * 100, 0, true)} км`;
			orbitRead.innerHTML = `Прошло <b>${fmt(days, 1)} сут</b>. Без тяготения Луна была бы на касательной (пунктирный кружок), а тяготение притянуло её к Земле на <b>${devTxt}</b>.`;
		};

		const drawSecond = () => {
			const t = Math.min(t2, 1);
			const sA = (G_EARTH * t * t) / 2; // m
			const sM = (A_MOON * t * t) / 2; // m
			apple.setAttribute('transform', `translate(0 ${(sA * PX_M).toFixed(2)})`);
			moon2.setAttribute('transform', `translate(0 ${(sM * MAG * PX_M).toFixed(2)})`);
			strobes.forEach((s) => s.classList.toggle('is-on', t >= Number(s.dataset.st) - 1e-9));
			secRead.innerHTML =
				`<i>t</i> = <b>${fmt(t, 2)} с</b>. Яблоко упало на <b>${fmt(sA, 2)} м</b>, ` +
				`Луна — на <b>${fmt(sM * 1000, 2)} мм</b>. За 1 с: 4,9 м и 1,36 мм — в 3600 раз меньше.`;
		};

		const frame = (dt: number) => {
			if (paused) return;
			// orbit
			tPhase += dt;
			if (phase === 'fly') {
				th += (2 * Math.PI * dt) / REV;
				if (tPhase >= FLY) {
					th = th0 + (2 * Math.PI * FLY) / REV;
					phase = 'hold';
					tPhase = 0;
				}
			} else if (tPhase >= HOLD) {
				phase = 'fly';
				tPhase = 0;
				th0 = th;
			}
			if (th > 2 * Math.PI * 4) {
				th -= 2 * Math.PI * 4;
				th0 -= 2 * Math.PI * 4;
			}
			drawOrbit();
			// first second
			t2 += dt / SLOW;
			if (t2 > 1 + HOLD2 / SLOW) t2 = 0;
			drawSecond();
		};

		const wake = animator(root, () => !paused, frame);
		pauseBtn.addEventListener('click', () => {
			paused = !paused;
			pauseBtn.textContent = paused ? 'Пуск' : 'Пауза';
			pauseBtn.setAttribute('aria-pressed', String(paused));
			wake();
		});
		drawOrbit();
		drawSecond();
		wake();
	}
</script>
