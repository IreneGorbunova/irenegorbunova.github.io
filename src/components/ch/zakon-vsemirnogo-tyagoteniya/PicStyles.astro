---
/** Frame and shared parts of the explanatory pictures of «Закон всемирного тяготения» (panels, caption, arrows, bodies). Renders nothing. */
---

<style is:global>
	.gp-pic {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.gp-pic__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@media (max-width: 40rem) {
		.gp-pic__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.gp-pic--one .gp-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 32rem;
		margin-inline: auto;
	}
	.gp-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.gp-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.gp-pic .gp-title {
		font-size: 14px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.gp-pic .gp-t-f {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.gp-pic figcaption {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.gp-force {
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.gp-head {
		fill: var(--ig-v);
	}
	.gp-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.gp-dash {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.gp-earth {
		fill: color-mix(in srgb, var(--ig-vx) 55%, var(--ig-surface));
	}
	.gp-land {
		fill: color-mix(in srgb, var(--ig-v) 45%, color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-gray-4)));
	}
	.gp-moon {
		fill: var(--sl-color-gray-3);
	}
	.gp-crater {
		fill: var(--sl-color-gray-4);
	}
	.gp-sun {
		fill: var(--ig-v);
	}
	.gp-lead {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.gp-person {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.gp-person-head {
		fill: var(--sl-color-gray-1);
	}
	.gp-apple {
		fill: var(--ig-vy);
	}
	.gp-leaf {
		fill: color-mix(in srgb, var(--ig-v) 50%, var(--ig-vx));
	}
	.gp-water {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
		stroke: var(--ig-vx);
		stroke-width: 1.2;
	}
</style>
