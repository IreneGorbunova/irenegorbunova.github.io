---
/**
 * Colors of the spacesuit (suit.ts) over the people kit's winter figure: white suit, light gray boots and gloves, a
 * white helmet with a gold visor. Renders nothing; include it once on a page, after the kit's PeopleStyles.
 */
---

<style is:global>
	:root {
		--zs-suit: hsl(40, 20%, 94%);
		--zs-shade: hsl(220, 10%, 78%);
		--zs-visor: hsl(40, 85%, 55%);
	}
	.zs-suit .pkw-coat {
		fill: var(--zs-suit);
	}
	.zs-suit .pkw-sleeve,
	.zs-suit .pkw-pants {
		stroke: var(--zs-suit);
	}
	.zs-suit .pkw-boot,
	.zs-suit .pkw-glove,
	.zs-suit .pkw-mitten {
		fill: var(--zs-shade);
	}
	.zs-suit .pkw-cuff {
		fill: var(--zs-suit);
	}
	.zs-suit .pkw-zip {
		opacity: 0.3;
	}
	.zs-suit :is(.pkw-hat, .pkw-hat-band, .pkw-pompom, .pkw-scarf) {
		display: none;
	}
	.zs-helmet,
	.zs-pack {
		fill: var(--zs-suit);
		stroke: var(--hm-line);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	.zs-pack {
		fill: var(--zs-shade);
	}
	.zs-visor {
		fill: var(--zs-visor);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	.zs-glint {
		fill: none;
		stroke: white;
		stroke-width: 0.8;
		stroke-linecap: round;
		opacity: 0.8;
	}
	.zs-ring {
		fill: none;
		stroke: var(--zs-shade);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.zs-box {
		fill: var(--zs-shade);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
</style>
