</style>

<script>
	import { C, RANGE, G, gx, gy, dial, sliderX } from './geometry';
	import { ru, fixed, isRounded, tex, q, renderTex, sig, sigDigits } from './ohm';

	const SVG_NS = 'http://www.w3.org/2000/svg';
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const DOT_GAP = 16; // distance between neighbouring free electrons, px
	const SPEED = 40; // drift of the dots, px/s per ampere
	const JITTER = 1.1; // amplitude of the chaotic motion, px
	const ANGLE = 55; // half-span of the meter scales, degrees
	const MAX_SERIES = 3;
	const AUTO_U = [0, 2, 4, 6, 8, 10, 12];

	type Pt = [number, number];
	type Dot = { el: SVGCircleElement; f1: number; f2: number; p1: number; p2: number };
	type Series = { r: number; slot: number; us: number[]; g: SVGGElement; line: SVGLineElement | null; label: SVGTextElement };

	/** A polyline with lookup of the point at a given distance from its start. */
	const polyline = (pts: Pt[]) => {
		const lens = pts.slice(1).map((p, k) => Math.hypot(p[0] - pts[k][0], p[1] - pts[k][1]));
		const total = lens.reduce((a, b) => a + b, 0);
		const at = (s: number): { x: number; y: number; seg: number } => {
			let rest = ((s % total) + total) % total;
			for (let k = 0; k < lens.length; k++) {
				if (rest <= lens[k] || k === lens.length - 1) {
					const t = lens[k] ? Math.min(rest / lens[k], 1) : 0;
					return {
						x: pts[k][0] + (pts[k + 1][0] - pts[k][0]) * t,
						y: pts[k][1] + (pts[k + 1][1] - pts[k][1]) * t,
						seg: k,
					};
				}
				rest -= lens[k];
			}
			return { x: pts[0][0], y: pts[0][1], seg: 0 };
		};
		return { total, at, segments: lens.length };
	};

	/** The closed path of the electrons, in the direction they move: from «−» through the circuit to «+». */
	const loop = (xs: number) =>
		polyline([
			[C.XBN, C.YB],
			[C.XR, C.YB],
			[C.XR, C.YS],
			[xs, C.YS],
			[xs, C.YT],
			[C.XA, C.YT],
			[C.XL, C.YT],
			[C.XL, C.YB],
			[C.XBP, C.YB],
			[C.XBN, C.YB], // inside the source: hidden
		]);

	for (const root of document.querySelectorAll<HTMLElement>('[data-ohm]')) {
		const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const uIn = $<HTMLInputElement>('[data-u]');
		const rIn = $<HTMLInputElement>('[data-r]');
		const uOut = $<HTMLOutputElement>('[data-u-out]');
		const rOut = $<HTMLOutputElement>('[data-r-out]');
		const svg = $<SVGSVGElement>('.ohm__circuit');
		const sliderWire = $<SVGPathElement>('[data-slider-wire]');
		const rheoOn = $<SVGRectElement>('[data-rheo-on]');
		const rheoBody = $<SVGRectElement>('.ohm__rheo-body');
		const stem = $<SVGLineElement>('[data-stem]');
		const knob = $<SVGGElement>('[data-knob]');
		const readR = $<SVGTextElement>('[data-read-r]');
		const readI = $<SVGTextElement>('[data-read-i]');
		const readU = $<SVGTextElement>('[data-read-u]');
		const lever = $<SVGLineElement>('[data-lever]');
		const keyG = $<SVGGElement>('[data-key]');
		const curArrow = $<SVGLineElement>('[data-current]');
		const curName = $<SVGTextElement>('[data-current-name]');
		const needleA = $<SVGLineElement>('[data-needle-a]');
		const needleV = $<SVGLineElement>('[data-needle-v]');
		const dotsG = $<SVGGElement>('[data-dots]');
		const restG = $<SVGGElement>('[data-dots-rest]');
		const formula = $<HTMLElement>('[data-formula]');
		const live = $<HTMLElement>('[data-live]');
		const recordBtn = $<HTMLButtonElement>('[data-record]');
		const autoBtn = $<HTMLButtonElement>('[data-auto]');
		const keyBtn = $<HTMLButtonElement>('[data-key-btn]');
		const clearBtn = $<HTMLButtonElement>('[data-clear]');
		const seriesG = $<SVGGElement>('[data-series]');
		const probe = $<SVGGElement>('[data-probe]');
		const ring = $<SVGCircleElement>('[data-ring]');
		const projX = $<SVGLineElement>('[data-proj-x]');
		const projY = $<SVGLineElement>('[data-proj-y]');
		const empty = $<SVGTextElement>('[data-empty]');
		const tableWrap = $<HTMLElement>('[data-table-wrap]');
		const rows = $<HTMLElement>('[data-rows]');

		const am = dial(C.XAM, C.YB, C.RAM, 12, 4);
		const vm = dial(C.XV, C.YV, C.RV, 12, 3);

		// ---------- state ----------
		let closed = true;
		const U = () => Number(uIn.value);
		const R = () => Number(rIn.value);
		const I = () => (closed ? U() / R() : 0);
		const Uv = () => (closed ? U() : 0); // the voltmeter is connected across the rheostat

		// ---------- free electrons ----------
		const makeDot = (parent: SVGGElement): Dot => {
			const el = document.createElementNS(SVG_NS, 'circle');
			el.setAttribute('r', '3.2');
			parent.append(el);
			return {
				el,
				f1: 8 + Math.random() * 6,
				f2: 8 + Math.random() * 6,
				p1: Math.random() * 6.3,
				p2: Math.random() * 6.3,
			};
		};
		let path = loop(sliderX(R()));
		const nDots = Math.round(path.total / DOT_GAP);
		const gap = path.total / nDots;
		const dots: Dot[] = Array.from({ length: nDots }, () => makeDot(dotsG));
		let shift = 0; // how far the electrons have drifted along the loop
		let drift = 0; // current drift speed, px/s (follows the current almost at once)

		// Electrons at rest: in the voltmeter branch and in the part of the rheostat that is not in use.
		type Rest = { dot: Dot; x: number; y: number };
		const placeAlong = (pts: Pt[], from: number, to: number) => {
			const p = polyline(pts);
			const out: Pt[] = [];
			for (let s = from; s <= p.total - to + 0.01; s += DOT_GAP) {
				const a = p.at(Math.min(s, p.total - 0.001));
				out.push([a.x, a.y]);
			}
			return out;
		};
		const branchPts: Pt[] = [
			...placeAlong(
				[
					[C.XN1, C.YT],
					[C.XN1, C.YV],
					[C.XV - C.RV, C.YV],
				],
				DOT_GAP,
				6,
			),
			...placeAlong(
				[
					[C.XV + C.RV, C.YV],
					[C.XN2, C.YV],
					[C.XN2, C.YS],
				],
				6,
				DOT_GAP,
			),
		];
		let rest: Rest[] = [];
		const layoutRest = (xs: number) => {
			const pts = [...branchPts];
			for (let x = xs + DOT_GAP; x <= C.XE - 4; x += DOT_GAP) pts.push([x, C.YT]);
			while (rest.length < pts.length) rest.push({ dot: makeDot(restG), x: 0, y: 0 });
			while (rest.length > pts.length) rest.pop()!.dot.el.remove();
			pts.forEach((p, k) => {
				rest[k].x = p[0];
				rest[k].y = p[1];
			});
		};

		const drawDots = (t: number) => {
			const j = reduceMotion.matches ? 0 : JITTER;
			for (let k = 0; k < dots.length; k++) {
				const d = dots[k];
				const a = path.at(k * gap + shift);
				// hidden inside the source, and in the gap of an open key (there is no metal there)
				const inside =
					a.seg === path.segments - 1 || (!closed && a.y === C.YB && a.x > C.XK1 + 5 && a.x < C.XK2 - 5);
				d.el.setAttribute('cx', (a.x + j * Math.sin(d.f1 * t + d.p1)).toFixed(2));
				d.el.setAttribute('cy', (a.y + j * Math.sin(d.f2 * t + d.p2)).toFixed(2));
				d.el.setAttribute('opacity', inside ? '0' : '1');
			}
			for (const r of rest) {
				const d = r.dot;
				d.el.setAttribute('cx', (r.x + j * Math.sin(d.f1 * t + d.p1)).toFixed(2));
				d.el.setAttribute('cy', (r.y + j * Math.sin(d.f2 * t + d.p2)).toFixed(2));
			}
		};

		// ---------- meters: a damped needle ----------
		const OMEGA = 13; // rad/s
		const ZETA = 0.6;
		const STOP = ANGLE + 2; // stop pins, degrees
		const needles = [
			{ el: needleA, d: am, full: RANGE.IMAX, value: I, a: 0, w: 0 },
			{ el: needleV, d: vm, full: RANGE.UMAX, value: Uv, a: 0, w: 0 },
		];
		const target = (n: (typeof needles)[number]) => -ANGLE + (2 * ANGLE * Math.min(n.value(), n.full)) / n.full;
		const placeNeedle = (n: (typeof needles)[number]) =>
			n.el.setAttribute('transform', `rotate(${n.a.toFixed(2)} ${n.d.px} ${n.d.py})`);
		needles.forEach((n) => {
			n.a = target(n);
			placeNeedle(n);
		});
		const stepNeedles = (dt: number) => {
			let moving = false;
			for (const n of needles) {
				const goal = target(n);
				if (reduceMotion.matches) {
					n.a = goal;
					n.w = 0;
				} else {
					const h = 1 / 240;
					for (let t = 0; t < dt; t += h) {
						n.w += (OMEGA * OMEGA * (goal - n.a) - 2 * ZETA * OMEGA * n.w) * h;
						n.a += n.w * h;
						// stop pins just outside the scale, as in a real meter: the needle bounces off them
						if (Math.abs(n.a) > STOP) {
							n.a = Math.sign(n.a) * STOP;
							n.w = -0.3 * n.w;
						}
					}
				}
				if (Math.abs(goal - n.a) > 0.02 || Math.abs(n.w) > 0.05) moving = true;
				placeNeedle(n);
			}
			return moving;
		};

		// ---------- key ----------
		let leverAngle = 0; // degrees, 0 = closed
		const placeLever = () => {
			const a = (leverAngle * Math.PI) / 180;
			const len = C.XK2 - C.XK1;
			lever.setAttribute('x2', String(C.XK1 + len * Math.cos(a)));
			lever.setAttribute('y2', String(C.YB - len * Math.sin(a)));
		};

		// ---------- rheostat ----------
		const placeSlider = () => {
			const xs = sliderX(R());
			path = loop(xs);
			sliderWire.setAttribute('d', `M ${xs} ${C.YS} H ${C.XR}`);
			rheoOn.setAttribute('width', String(xs - C.XA));
			stem.setAttribute('x1', String(xs));
			stem.setAttribute('x2', String(xs));
			knob.setAttribute('transform', `translate(${xs} ${C.YS})`);
			readR.setAttribute('x', String(xs));
			layoutRest(xs);
		};

		// ---------- text and formula ----------
		const showReadings = () => {
			uOut.value = `${ru(U(), 1)} В`;
			rOut.value = `${R()} Ом`;
			readR.textContent = `R = ${R()} Ом`;
			readI.textContent = `${fixed(sig(I()), I() > 0 ? sigDigits(I()) : 2)} А`; // 3 significant digits, so U/I checks out
			readU.textContent = `${fixed(Uv(), 1)} В`;
			const on = I() > 0;
			curArrow.style.opacity = on ? '1' : '0';
			curName.style.opacity = on ? '1' : '0';
			keyBtn.textContent = closed ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			if (!closed) {
				formula.innerHTML =
					'<p class="ohm__formula-note">Ключ разомкнут — цепь разорвана, тока нет. Поэтому и напряжение на реостате равно нулю: <span class="ohm__nowrap"><i>U</i> = <i>IR</i> = 0</span>.</p>';
				return;
			}
			const i = U() / R();
			renderTex(
				formula,
				`${q('i', 'I')} = \\dfrac{${q('u', 'U')}}{${q('r', 'R')}} = \\dfrac{${q('u', `${tex(U(), 1)}~\\text{В}`)}}{${q('r', `${R()}~\\text{Ом}`)}} ${isRounded(i, sigDigits(i)) ? '\\approx' : '='} ${q('i', `${tex(i, sigDigits(i))}~\\text{А}`)}`,
			);
		};

		// ---------- graph ----------
		const series: Series[] = [];
		const setLine = (el: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
			el.setAttribute('x1', String(x1));
			el.setAttribute('y1', String(y1));
			el.setAttribute('x2', String(x2));
			el.setAttribute('y2', String(y2));
		};
		const placeProbe = () => {
			const on = closed;
			probe.style.opacity = on ? '1' : '0';
			const x = gx(U());
			const y = gy(I());
			ring.setAttribute('cx', String(x));
			ring.setAttribute('cy', String(y));
			setLine(projX, x, G.Y0, x, y);
			setLine(projY, G.X0, y, x, y);
		};
		const placeLabels = () => {
			const withLine = series.filter((s) => s.line);
			const items = withLine
				.map((s) => ({ s, y: gy(RANGE.UMAX / s.r) - 9 }))
				.sort((a, b) => a.y - b.y);
			const h = (items[0]?.s.label.getBBox().height || 18) * 0.95;
			for (let k = 1; k < items.length; k++) items[k].y = Math.max(items[k].y, items[k - 1].y + h);
			for (const { s, y } of items) {
				s.label.setAttribute('x', String(G.X0 + G.PW - 18)); // clear of the probe ring at U = 12 В
				s.label.setAttribute('y', String(y));
				s.label.style.opacity = '1';
			}
		};
		const freeSlot = () => {
			for (let k = 0; k < MAX_SERIES; k++) if (!series.some((s) => s.slot === k)) return k;
			return -1;
		};
		const rowsOf = (s: Series) => rows.querySelectorAll(`[data-series-r="${s.r}"]`);
		const dropSeries = (s: Series) => {
			s.g.remove();
			rowsOf(s).forEach((row) => row.remove());
			series.splice(series.indexOf(s), 1);
		};
		const syncEmpty = () => {
			const anything = series.length > 0;
			empty.style.display = anything ? 'none' : '';
			tableWrap.hidden = !anything;
		};

		const record = (quiet = false) => {
			if (!closed) {
				live.textContent = 'Ключ разомкнут: тока нет. Замкните ключ, чтобы измерять.';
				return;
			}
			const u = U();
			const r = R();
			let s = series.find((x) => x.r === r);
			if (s && s.us.includes(u)) {
				if (!quiet) live.textContent = `Точка при U = ${ru(u, 1)} В для R = ${r} Ом уже записана — измените напряжение.`;
				return;
			}
			if (!s) {
				if (series.length >= MAX_SERIES) dropSeries(series[0]);
				const g = document.createElementNS(SVG_NS, 'g');
				const slot = freeSlot();
				g.classList.add(`ohm__s${slot}`);
				const label = document.createElementNS(SVG_NS, 'text');
				label.classList.add('ohm__s-label');
				label.setAttribute('text-anchor', 'end');
				label.style.opacity = '0';
				label.textContent = `R = ${r} Ом`;
				g.append(label);
				seriesG.append(g);
				s = { r, slot, us: [], g, line: null, label };
				series.push(s);
			}
			s.us.push(u);
			const i = u / r;
			const iShown = sig(i); // 3 significant digits: U/I from the shown numbers rounds to R for every slider setting
			const dot = document.createElementNS(SVG_NS, 'circle');
			dot.classList.add('ohm__s-pt');
			dot.setAttribute('r', '5.5');
			dot.setAttribute('cx', String(gx(u)));
			dot.setAttribute('cy', String(gy(i)));
			s.g.append(dot);
			if (!s.line && s.us.filter((v) => v > 0).length >= 2) {
				const line = document.createElementNS(SVG_NS, 'line');
				line.classList.add('ohm__s-line');
				setLine(line, gx(0), gy(0), gx(RANGE.UMAX), gy(RANGE.UMAX / r));
				const len = Math.hypot(gx(RANGE.UMAX) - gx(0), gy(0) - gy(RANGE.UMAX / r));
				line.style.strokeDasharray = String(len);
				line.style.strokeDashoffset = String(len);
				s.g.prepend(line);
				s.line = line;
				line.getBoundingClientRect();
				requestAnimationFrame(() => (line.style.strokeDashoffset = '0'));
				placeLabels();
			}
			// table row
			rows.querySelectorAll('.is-new').forEach((row) => row.classList.remove('is-new'));
			const tr = document.createElement('tr');
			tr.dataset.seriesR = String(r);
			tr.className = `ohm__s${s.slot} is-new`;
			tr.innerHTML = `<td><span class="ohm__swatch"></span>${r}</td><td>${ru(u, 1)}</td><td>${ru(iShown, sigDigits(i))}</td><td>${u > 0 ? ru(u / iShown, 0) : '—'}</td>`;
			rows.append(tr);
			syncEmpty();
			tableWrap.scrollTop = tableWrap.scrollHeight;
			if (!quiet)
				live.textContent = `Записано: U = ${ru(u, 1)} В, I = ${ru(iShown, sigDigits(i))} А${isRounded(i, sigDigits(i)) ? ' (округлённо)' : ''} при R = ${r} Ом.`;
		};

		const clearGraph = () => {
			stopAuto();
			while (series.length) dropSeries(series[0]);
			syncEmpty();
			live.textContent = 'График очищен.';
		};

		// ---------- automatic experiment ----------
		let auto: { stop: boolean } | null = null;
		const sleep = (ms: number) => new Promise((ok) => setTimeout(ok, ms));
		const stopAuto = () => {
			if (auto) auto.stop = true;
			auto = null;
			autoBtn.textContent = 'Провести опыт';
			autoBtn.classList.remove('is-running');
		};
		const tweenU = async (to: number, token: { stop: boolean }) => {
			const from = U();
			if (reduceMotion.matches || from === to) {
				uIn.value = String(to);
				update();
				return;
			}
			const steps = Math.round(Math.abs(to - from) / 0.5);
			for (let k = 1; k <= steps && !token.stop; k++) {
				uIn.value = String(from + Math.sign(to - from) * 0.5 * k);
				update();
				await sleep(320 / steps);
			}
		};
		const runAuto = async () => {
			if (auto) {
				stopAuto();
				live.textContent = 'Опыт остановлен.';
				return;
			}
			const token = { stop: false };
			auto = token;
			autoBtn.textContent = 'Остановить';
			autoBtn.classList.add('is-running');
			if (!closed) setClosed(true);
			live.textContent = `Опыт: R = ${R()} Ом, напряжение увеличиваем от 0 до 12 В.`;
			for (const u of AUTO_U) {
				await tweenU(u, token);
				if (token.stop) return;
				await sleep(reduceMotion.matches ? 300 : 700);
				if (token.stop) return;
				record(true);
			}
			stopAuto();
			live.textContent = `Готово: при R = ${R()} Ом все точки легли на одну прямую. Попробуйте другое сопротивление.`;
		};

		// ---------- updates ----------
		const update = () => {
			placeSlider();
			showReadings();
			placeProbe();
			wake();
		};
		const setClosed = (v: boolean) => {
			closed = v;
			showReadings();
			placeProbe();
			wake();
		};

		uIn.addEventListener('input', () => {
			stopAuto();
			update();
		});
		rIn.addEventListener('input', () => {
			stopAuto();
			update();
		});
		recordBtn.addEventListener('click', () => {
			stopAuto();
			record();
		});
		autoBtn.addEventListener('click', runAuto);
		clearBtn.addEventListener('click', clearGraph);
		const toggleKey = () => {
			stopAuto();
			setClosed(!closed);
			live.textContent = closed ? 'Ключ замкнут — по цепи идёт ток.' : 'Ключ разомкнут — тока нет, приборы показывают ноль.';
		};
		keyBtn.addEventListener('click', toggleKey);
		keyG.addEventListener('click', toggleKey);

		// Drag the slider of the rheostat on the drawing.
		const toSvgX = (e: PointerEvent) => {
			const m = svg.getScreenCTM();
			if (!m) return 0;
			const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
			return p.x;
		};
		const dragTo = (e: PointerEvent) => {
			const r = Math.round((RANGE.RMAX * (toSvgX(e) - C.XA)) / (C.XE - C.XA));
			const clamped = Math.min(RANGE.RMAX, Math.max(RANGE.RMIN, r));
			if (clamped !== R()) {
				rIn.value = String(clamped);
				update();
			}
		};
		let dragging = false;
		for (const el of [knob, rheoBody, rheoOn]) {
			el.addEventListener('pointerdown', (e) => {
				e.preventDefault();
				stopAuto();
				dragging = true;
				knob.classList.add('is-dragging');
				svg.setPointerCapture(e.pointerId);
				dragTo(e);
			});
		}
		svg.addEventListener('pointermove', (e) => dragging && dragTo(e));
		const endDrag = () => {
			dragging = false;
			knob.classList.remove('is-dragging');
		};
		svg.addEventListener('pointerup', endDrag);
		svg.addEventListener('pointercancel', endDrag);

		// ---------- animation loop (runs only while the model is on screen) ----------
		let raf = 0;
		let last = 0;
		let visible = true;
		const frame = (now: number) => {
			const dt = Math.min((now - (last || now)) / 1000, 1 / 20);
			last = now;
			const t = now / 1000;
			const goalDrift = SPEED * I();
			drift += (goalDrift - drift) * Math.min(1, dt / 0.08);
			if (!reduceMotion.matches) shift += drift * dt;
			const goalLever = closed ? 0 : 30;
			leverAngle += (goalLever - leverAngle) * Math.min(1, reduceMotion.matches ? 1 : dt / 0.07);
			placeLever();
			const moving = stepNeedles(dt);
			drawDots(t);
			const idle = reduceMotion.matches && !moving && Math.abs(goalLever - leverAngle) < 0.01;
			if (visible && !idle) raf = requestAnimationFrame(frame);
			else raf = 0;
		};
		const wake = () => {
			if (!raf && visible) {
				last = 0;
				raf = requestAnimationFrame(frame);
			}
		};
		new IntersectionObserver((entries) => {
			visible = entries.some((e) => e.isIntersecting);
			if (visible) wake();
		}).observe(root);

		placeSlider();
		showReadings();
		placeProbe();
		syncEmpty();
		drawDots(0);
		live.textContent = 'Меняйте напряжение и сопротивление, записывайте точки — или нажмите «Провести опыт».';
		wake();
	}
</script>
