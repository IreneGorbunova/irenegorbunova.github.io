---
/**
 * Main model of the chapter: a circuit with a source, a key, an ammeter, a rheostat and a voltmeter.
 * Free electrons (dots) drift against the current with a speed proportional to the current;
 * the needles of the meters swing like those of real pointer meters (a damped oscillator).
 * The graph I(U) is built point by point; every series of points is one setting of the rheostat.
 * Ideal meters and wires: the voltmeter reads the source voltage while the key is closed.
 */
import { C, RANGE, G, gx, gy, dial, sliderX } from './geometry';

const uid = `ohm-${Math.random().toString(36).slice(2, 8)}`;
const U0 = 6;
const R0 = 12;
const xs0 = sliderX(R0);
const am = dial(C.XAM, C.YB, C.RAM, 12, 4); // 0–3 А: a division is 0,25 А
const vm = dial(C.XV, C.YV, C.RV, 12, 3); // 0–12 В: a division is 1 В
const coil: number[] = [];
for (let x = C.XA + 6; x <= C.XE - 4; x += 8) coil.push(x);
const uTicks = [0, 2, 4, 6, 8, 10, 12];
const iTicks = [0.5, 1, 1.5, 2, 2.5, 3];
const fmtTick = (v: number) => String(v).replace('.', ',');
const arcPath = (d: ReturnType<typeof dial>) =>
	`M ${d.arcStart.x} ${d.arcStart.y} A ${d.ra} ${d.ra} 0 0 1 ${d.arcEnd.x} ${d.arcEnd.y}`;
---

<figure class="ohm not-content" data-ohm>
	<svg
		class="ohm__circuit"
		viewBox={`0 0 ${C.W} ${C.H}`}
		role="img"
		aria-label="Электрическая цепь: источник тока, ключ, амперметр и реостат соединены последовательно, вольтметр подключён параллельно реостату"
	>
		<defs>
			<marker
				id={`${uid}-tip`}
				class="ohm__tip"
				viewBox="0 0 10 10"
				refX="8"
				refY="5"
				markerWidth="5"
				markerHeight="5"
				orient="auto"
			>
				<path d="M0,0 L10,5 L0,10 z"></path>
			</marker>
			<marker
				id={`${uid}-cur`}
				class="ohm__curtip"
				viewBox="0 0 10 10"
				refX="7"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto"
			>
				<path d="M0,0 L10,5 L0,10 z"></path>
			</marker>
		</defs>

		<!-- wires -->
		<g class="ohm__wires">
			<path d={`M ${C.XBP} ${C.YB} H ${C.XL} V ${C.YT} H ${C.XA}`}></path>
			<path d={`M ${C.XBN} ${C.YB} H ${C.XK1}`}></path>
			<path d={`M ${C.XK2} ${C.YB} H ${C.XAM - C.RAM}`}></path>
			<path d={`M ${C.XAM + C.RAM} ${C.YB} H ${C.XR} V ${C.YS}`}></path>
			<path d={`M ${xs0} ${C.YS} H ${C.XR}`} data-slider-wire></path>
			<path d={`M ${C.XN1} ${C.YT} V ${C.YV} H ${C.XV - C.RV}`}></path>
			<path d={`M ${C.XV + C.RV} ${C.YV} H ${C.XN2} V ${C.YS}`}></path>
		</g>
		<circle class="ohm__node" cx={C.XN1} cy={C.YT} r="4.5"></circle>
		<circle class="ohm__node" cx={C.XN2} cy={C.YS} r="4.5"></circle>

		<!-- rheostat -->
		<g class="ohm__rheo" data-rheo>
			<rect class="ohm__rheo-body" x={C.XA} y={C.YT - 12} width={C.XE - C.XA} height="24" rx="3"></rect>
			<g class="ohm__coil">
				{coil.map((x) => <line x1={x - 3} y1={C.YT - 11} x2={x + 3} y2={C.YT + 11} />)}
			</g>
			<rect
				class="ohm__rheo-on"
				x={C.XA}
				y={C.YT - 12}
				width={xs0 - C.XA}
				height="24"
				rx="3"
				data-rheo-on></rect>
			<circle class="ohm__clamp" cx={C.XA} cy={C.YT} r="4"></circle>
			<circle class="ohm__clamp ohm__clamp--free" cx={C.XE} cy={C.YT} r="4"></circle>
		</g>
		<line
			class="ohm__stem"
			x1={xs0}
			y1={C.YS}
			x2={xs0}
			y2={C.YT - 13}
			marker-end={`url(#${uid}-tip)`}
			data-stem></line>

		<!-- free electrons -->
		<g class="ohm__dots" data-dots></g>
		<g class="ohm__dots ohm__dots--rest" data-dots-rest></g>

		<!-- direction of the current -->
		<line
			class="ohm__current"
			x1={C.XL + 15}
			y1={212}
			x2={C.XL + 15}
			y2={162}
			marker-end={`url(#${uid}-cur)`}
			data-current></line>
		<text class="ohm__current-name" x={C.XL + 26} y={194} data-current-name>I</text>

		<!-- source -->
		<g class="ohm__source">
			<rect x={C.XBP - 6} y={C.YB - 26} width={C.XBN - C.XBP + 12} height="52" class="ohm__source-bg"></rect>
			<line class="ohm__plate ohm__plate--plus" x1={C.XBP} y1={C.YB - 22} x2={C.XBP} y2={C.YB + 22}></line>
			<line class="ohm__plate ohm__plate--minus" x1={C.XBN} y1={C.YB - 11} x2={C.XBN} y2={C.YB + 11}></line>
			<text class="ohm__sign" x={C.XBP - 13} y={C.YB - 28} text-anchor="middle">+</text>
			<text class="ohm__sign" x={C.XBN + 13} y={C.YB - 28} text-anchor="middle">−</text>
		</g>

		<!-- key -->
		<g class="ohm__key" data-key>
			<rect class="ohm__hit" x={C.XK1 - 14} y={C.YB - 40} width={C.XK2 - C.XK1 + 28} height="56"></rect>
			<line class="ohm__lever" x1={C.XK1} y1={C.YB} x2={C.XK2} y2={C.YB} data-lever></line>
			<circle class="ohm__contact" cx={C.XK1} cy={C.YB} r="4.5"></circle>
			<circle class="ohm__contact" cx={C.XK2} cy={C.YB} r="4.5"></circle>
		</g>

		<!-- ammeter -->
		<g class="ohm__meter ohm__meter--a">
			<circle class="ohm__face" cx={C.XAM} cy={C.YB} r={C.RAM}></circle>
			<path class="ohm__scale" d={arcPath(am)}></path>
			{
				am.ticks.map((t) => (
					<line class={t.major ? 'ohm__tick ohm__tick--major' : 'ohm__tick'} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
				))
			}
			<line class="ohm__needle" x1={am.px} y1={am.py} x2={am.px} y2={am.py - am.len} data-needle-a></line>
			<circle class="ohm__pivot" cx={am.px} cy={am.py} r="3"></circle>
			<text class="ohm__letter" x={C.XAM} y={C.YB + C.RAM * 0.84} text-anchor="middle">A</text>
		</g>
		<text class="ohm__reading ohm__reading--i" x={C.XAM} y={C.YB + C.RAM + 27} text-anchor="middle" data-read-i
			>0,50 А</text
		>

		<!-- voltmeter -->
		<g class="ohm__meter ohm__meter--v">
			<circle class="ohm__face" cx={C.XV} cy={C.YV} r={C.RV}></circle>
			<path class="ohm__scale" d={arcPath(vm)}></path>
			{
				vm.ticks.map((t) => (
					<line class={t.major ? 'ohm__tick ohm__tick--major' : 'ohm__tick'} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
				))
			}
			<line class="ohm__needle" x1={vm.px} y1={vm.py} x2={vm.px} y2={vm.py - vm.len} data-needle-v></line>
			<circle class="ohm__pivot" cx={vm.px} cy={vm.py} r="3"></circle>
			<text class="ohm__letter" x={C.XV} y={C.YV + C.RV * 0.84} text-anchor="middle">V</text>
		</g>
		<text class="ohm__reading ohm__reading--u" x={C.XV} y={C.YV + C.RV + 27} text-anchor="middle" data-read-u
			>6,0 В</text
		>

		<!-- rheostat slider (drawn above the electrons) -->
		<g class="ohm__knob" transform={`translate(${xs0} ${C.YS})`} data-knob>
			<circle class="ohm__hit" r="26"></circle>
			<rect x="-14" y="-10" width="28" height="20" rx="5"></rect>
			<line x1="-5" y1="-5" x2="-5" y2="5"></line>
			<line x1="0" y1="-5" x2="0" y2="5"></line>
			<line x1="5" y1="-5" x2="5" y2="5"></line>
		</g>
		<text class="ohm__reading ohm__reading--r" x={xs0} y={C.YS - 20} text-anchor="middle" data-read-r>R = 12 Ом</text>

		<!-- captions -->
		<g class="ohm__caption">
			<text x={(C.XBP + C.XBN) / 2} y={C.YB + 44} text-anchor="middle">источник тока</text>
			<text x={(C.XK1 + C.XK2) / 2} y={C.YB + 30} text-anchor="middle">ключ</text>
			<text x={(C.XA + C.XE) / 2} y={C.YT + 32} text-anchor="middle">реостат</text>
		</g>
	</svg>

	<div class="ohm__controls">
		<label class="ohm__slider ohm__slider--u">
			<span class="ohm__slider-name">Напряжение источника <i>U</i></span>
			<output data-u-out>6 В</output>
			<input type="range" min="0" max={RANGE.UMAX} step="0.5" value={U0} data-u />
		</label>
		<label class="ohm__slider ohm__slider--r">
			<span class="ohm__slider-name">Сопротивление реостата <i>R</i></span>
			<output data-r-out>12 Ом</output>
			<input type="range" min={RANGE.RMIN} max={RANGE.RMAX} step="1" value={R0} data-r />
		</label>
	</div>

	<div class="ohm__formula" data-formula></div>

	<div class="ohm__buttons">
		<button type="button" class="ohm__btn ohm__btn--primary" data-record>Записать точку</button>
		<button type="button" class="ohm__btn" data-auto>Провести опыт</button>
		<button type="button" class="ohm__btn" data-key-btn>Разомкнуть ключ</button>
		<button type="button" class="ohm__btn ohm__btn--quiet" data-clear>Очистить график</button>
	</div>
	<p class="ohm__live" data-live aria-live="polite"></p>

	<div class="ohm__results">
		<svg
			class="ohm__graph"
			viewBox={`0 0 ${G.W} ${G.H}`}
			role="img"
			aria-label="График зависимости силы тока от напряжения"
		>
			<g class="ohm__grid">
				{uTicks.slice(1).map((u) => <line x1={gx(u)} y1={G.Y0} x2={gx(u)} y2={G.Y0 - G.PH} />)}
				{iTicks.map((i) => <line x1={G.X0} y1={gy(i)} x2={G.X0 + G.PW} y2={gy(i)} />)}
			</g>
			<line class="ohm__axis" x1={G.X0} y1={G.Y0} x2={G.X0 + G.PW + 8} y2={G.Y0}></line>
			<line class="ohm__axis" x1={G.X0} y1={G.Y0} x2={G.X0} y2={G.Y0 - G.PH - 8}></line>
			<g class="ohm__gticks">
				{uTicks.map((u) => <text x={gx(u)} y={G.Y0 + 22} text-anchor="middle">{u}</text>)}
				{iTicks.map((i) => <text x={G.X0 - 9} y={gy(i) + 5} text-anchor="end">{fmtTick(i)}</text>)}
				<text class="ohm__gname ohm__gname--u" x={G.X0 + G.PW} y={G.Y0 + 44} text-anchor="end">
					<tspan class="ohm__math">U</tspan>, В
				</text>
				<text class="ohm__gname ohm__gname--i" x={G.X0 - 9} y={G.Y0 - G.PH - 16} text-anchor="end">
					<tspan class="ohm__math">I</tspan>, А
				</text>
			</g>
			<text class="ohm__empty" x={G.X0 + G.PW / 2} y={G.Y0 - G.PH / 2} text-anchor="middle" data-empty>
				Здесь появятся ваши измерения
			</text>
			<g data-series></g>
			<g class="ohm__probe" data-probe>
				<line class="ohm__proj" data-proj-x></line>
				<line class="ohm__proj" data-proj-y></line>
				<circle class="ohm__ring" r="7" data-ring></circle>
			</g>
		</svg>

		<div class="ohm__table-wrap" data-table-wrap hidden>
			<table class="ohm__table">
				<thead>
					<tr>
						<th><i>R</i>, Ом</th>
						<th><i>U</i>, В</th>
						<th><i>I</i>, А</th>
						<th><i>U</i>&thinsp;/&thinsp;<i>I</i>, Ом</th>
					</tr>
				</thead>
				<tbody data-rows></tbody>
			</table>
		</div>
	</div>

	<figcaption class="ohm__legend">
		<span class="ohm__key-dot"></span>свободные электроны: движутся от «−» источника к «+», навстречу направлению тока
		<span class="ohm__key-arrow"></span><i>I</i>. Чем больше сила тока, тем быстрее движутся точки. Скорость показана условно: настоящие электроны
		движутся гораздо медленнее — на доли миллиметра в секунду, а в тонкой проволоке реостата быстрее, чем в толстых проводах. Приборы идеальные: сопротивление амперметра и проводов очень
		мало, через вольтметр ток почти не идёт. Ползунок реостата можно тянуть прямо на схеме, ключ — нажимать.
	</figcaption>
</figure>

<style is:global>
	.ohm {
		--ohm-u: var(--ig-vy);
		--ohm-i: var(--ig-vx);
		--ohm-r: var(--ig-v);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ohm i,
	.ohm .ohm__math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.ohm__circuit,
	.ohm__graph {
		display: block;
		width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}

	/* circuit */
	.ohm__wires path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.ohm__node {
		fill: var(--sl-color-gray-2);
	}
	.ohm__rheo-body {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.ohm__coil line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.ohm__rheo-on {
		fill: color-mix(in srgb, var(--ohm-r) 22%, transparent);
		stroke: var(--ohm-r);
		stroke-width: 2.5;
		cursor: pointer;
	}
	.ohm__rheo-body {
		cursor: pointer;
	}
	.ohm__clamp {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.ohm__clamp--free {
		stroke: var(--sl-color-gray-4);
	}
	.ohm__stem {
		stroke: var(--ohm-r);
		stroke-width: 2.5;
	}
	.ohm__tip path {
		fill: var(--ohm-r);
	}
	.ohm__knob {
		cursor: grab;
		touch-action: none;
	}
	.ohm__knob.is-dragging {
		cursor: grabbing;
	}
	.ohm__knob rect {
		fill: var(--ohm-r);
		filter: drop-shadow(0 0 5px color-mix(in srgb, var(--ohm-r) 60%, transparent));
	}
	.ohm__knob line {
		stroke: var(--sl-color-black);
		stroke-width: 1.5;
		stroke-linecap: round;
		opacity: 0.55;
	}
	.ohm__hit {
		fill: transparent;
	}
	.ohm__dots circle {
		fill: var(--ohm-i);
	}
	.ohm__dots--rest circle {
		opacity: 0.45;
	}
	.ohm__current {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		transition: opacity 0.3s;
	}
	.ohm__curtip path {
		fill: var(--sl-color-gray-2);
	}
	.ohm__current-name {
		fill: var(--sl-color-gray-2);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 19px;
		transition: opacity 0.3s;
	}
	.ohm__source-bg {
		fill: var(--ig-surface);
	}
	.ohm__plate {
		stroke: var(--sl-color-white);
	}
	.ohm__plate--plus {
		stroke-width: 3;
	}
	.ohm__plate--minus {
		stroke-width: 8;
	}
	.ohm__sign {
		fill: var(--sl-color-gray-2);
		font-size: 20px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.ohm__key {
		cursor: pointer;
		outline: none;
	}
	.ohm__lever {
		stroke: var(--sl-color-white);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.ohm__key:hover .ohm__lever {
		stroke: var(--sl-color-accent);
	}
	.ohm__contact {
		fill: var(--ig-surface);
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	.ohm__face {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.ohm__scale {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.ohm__tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ohm__tick--major {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.ohm__needle {
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.ohm__meter--a .ohm__needle {
		stroke: var(--ohm-i);
	}
	.ohm__meter--v .ohm__needle {
		stroke: var(--ohm-u);
	}
	.ohm__pivot {
		fill: var(--sl-color-gray-2);
	}
	.ohm__letter {
		fill: var(--sl-color-white);
		font-size: 13px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.ohm__reading {
		font-size: 20px;
		font-weight: 700;
		font-family: var(--__sl-font);
		font-variant-numeric: tabular-nums;
	}
	.ohm__reading--i {
		fill: var(--ohm-i);
	}
	.ohm__reading--u {
		fill: var(--ohm-u);
	}
	.ohm__reading--r {
		fill: var(--ohm-r);
	}
	.ohm__caption text {
		fill: var(--sl-color-gray-3);
		font-size: 14px;
		font-family: var(--__sl-font);
	}

	/* controls */
	.ohm__controls {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem 1.5rem;
		margin-top: 0.75rem;
	}
	.ohm__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ohm__slider output {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.ohm__slider--u output {
		color: var(--ohm-u);
	}
	.ohm__slider--r output {
		color: var(--ohm-r);
	}
	.ohm__slider input {
		grid-column: 1 / -1;
		width: 100%;
	}
	.ohm__slider--u input {
		accent-color: var(--ohm-u);
	}
	.ohm__slider--r input {
		accent-color: var(--ohm-r);
	}
	.ohm__formula {
		min-height: 4.2rem;
		margin: 0.6rem 0 0;
		padding: 0.3rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		display: grid;
		place-items: center;
		overflow-x: auto;
		text-align: center;
	}
	.ohm__formula .katex-display {
		margin: 0.35rem 0;
	}
	.ohm__formula .katex {
		font-size: 1.35em;
	}
	.ohm__nowrap {
		white-space: nowrap;
	}
	.ohm__formula-note {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.zo-u {
		color: var(--ig-vy);
	}
	.zo-i {
		color: var(--ig-vx);
	}
	.zo-r {
		color: var(--ig-v);
	}
	.ohm__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.ohm__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
