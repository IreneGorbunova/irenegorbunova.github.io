		--s-text: var(--sl-color-purple-high);
	}
	.ohm__s-line {
		stroke: var(--s);
	}
	.ohm__s-pt {
		fill: var(--s);
	}
	.ohm__s-label {
		fill: var(--s-text);
	}
	.ohm__proj {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 4;
