	.ohm__s0 {
		--s: var(--ig-v);
		--s-text: var(--ig-v);
	}
	.ohm__s1 {
		--s: var(--sl-color-green);
		--s-text: var(--sl-color-green-high);
	}
	.ohm__s2 {
