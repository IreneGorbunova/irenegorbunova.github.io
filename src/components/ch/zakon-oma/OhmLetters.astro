---
/**
 * «Big letters» picture of Ohm's law: the size of each letter grows with the value of its quantity.
 * Moving U or R shows at once how I follows: I = U / R.
 */
---

<figure class="olet not-content" data-olet>
	<div class="olet__stage" aria-hidden="true">
		<span class="olet__sym olet__sym--i" data-sym="i">I</span>
		<span class="olet__eq">=</span>
		<div class="olet__frac">
			<span class="olet__sym olet__sym--u" data-sym="u">U</span>
			<span class="olet__bar"></span>
			<span class="olet__sym olet__sym--r" data-sym="r">R</span>
		</div>
	</div>
	<div class="olet__num" data-num></div>
	<div class="olet__controls">
		<label class="olet__slider olet__slider--u">
			<span>Напряжение <i>U</i></span>
			<output data-out="u"></output>
			<input type="range" min="1" max="12" step="0.5" value="6" data-in="u" />
		</label>
		<label class="olet__slider olet__slider--r">
			<span>Сопротивление <i>R</i></span>
			<output data-out="r"></output>
			<input type="range" min="2" max="24" step="1" value="12" data-in="r" />
		</label>
	</div>
	<p class="olet__live" data-live aria-live="polite"></p>
	<figcaption class="olet__caption">Чем больше величина, тем крупнее её буква.</figcaption>
</figure>

<style is:global>
	.olet {
		margin-block: 1.5rem 2rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.olet i {
		font-family: var(--ig-font-math);
	}
	.olet__stage {
		height: 13rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		color: var(--sl-color-white);
		overflow: hidden;
	}
	.olet__sym {
		font-family: var(--ig-font-math);
		font-style: italic;
		line-height: 0.95;
		transition: font-size 0.35s cubic-bezier(0.3, 1.3, 0.5, 1);
	}
	.olet__sym--u {
		color: var(--ig-vy);
	}
	.olet__sym--i {
		color: var(--ig-vx);
	}
	.olet__sym--r {
		color: var(--ig-v);
	}
	.olet__num {
		min-height: 3.6rem;
		margin: 0 0 0.9rem;
		padding: 0.2rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		display: grid;
		place-items: center;
		overflow-x: auto;
	}
	.olet__num .katex {
		font-size: 1.3em;
	}
	.olet .zo-u {
		color: var(--ig-vy);
	}
	.olet .zo-i {
		color: var(--ig-vx);
	}
	.olet .zo-r {
		color: var(--ig-v);
	}
	.olet__eq {
		font-family: var(--ig-font-math);
		font-size: 2.6rem;
		color: var(--sl-color-gray-2);
	}
	.olet__frac {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
	}
	.olet__bar {
		align-self: stretch;
		min-width: 3rem;
		height: 3px;
		border-radius: 2px;
		background: var(--sl-color-gray-2);
	}
	.olet__controls {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem 1.5rem;
	}
	.olet__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.olet__slider output {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.olet__slider input {
		grid-column: 1 / -1;
		width: 100%;
	}
	.olet__slider--u output {
		color: var(--ig-vy);
	}
	.olet__slider--u input {
		accent-color: var(--ig-vy);
	}
	.olet__slider--r output {
		color: var(--ig-v);
	}
	.olet__slider--r input {
		accent-color: var(--ig-v);
	}
	.olet__live {
		min-height: 1.5em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	.olet__caption {
		margin-top: 0.2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.olet {
			padding: 0.75rem;
		}
		.olet__stage {
			height: 12rem;
			gap: 0.75rem;
		}
		.olet__num .katex {
			font-size: 1.1em;
		}
		.olet__controls {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.olet__sym {
			transition: none;
		}
	}
</style>

<script>
	import { ru, isRounded, tex, q, renderTex } from './ohm';

	// Letter height in rem. Every doubling of a quantity adds the same step, so the sizes obey the law too:
	// doubling U grows I by the same step, doubling R shrinks it by the same step.
	const STEP = 0.75;
	const size = (v: number, v0: number) => Math.max(0.9, 3 + STEP * Math.log2(v / v0));

	for (const root of document.querySelectorAll<HTMLElement>('[data-olet]')) {
		const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const uIn = $<HTMLInputElement>('[data-in="u"]');
		const rIn = $<HTMLInputElement>('[data-in="r"]');
		const live = $<HTMLElement>('[data-live]');
		const num = $<HTMLElement>('[data-num]');
		const sym = { u: $<HTMLElement>('[data-sym="u"]'), r: $<HTMLElement>('[data-sym="r"]'), i: $<HTMLElement>('[data-sym="i"]') };
		let last = { u: Number(uIn.value), r: Number(rIn.value) };

		const draw = () => {
			const u = Number(uIn.value);
			const r = Number(rIn.value);
			const i = u / r;
			sym.u.style.fontSize = `${size(u, 6)}rem`;
			sym.r.style.fontSize = `${size(r, 12)}rem`;
			sym.i.style.fontSize = `${size(i, 0.5)}rem`;
			$<HTMLOutputElement>('[data-out="u"]').value = `${ru(u, 1)} В`;
			$<HTMLOutputElement>('[data-out="r"]').value = `${r} Ом`;
			renderTex(
				num,
				`${q('i', 'I')} = \\dfrac{${q('u', 'U')}}{${q('r', 'R')}} = \\dfrac{${q('u', `${tex(u, 1)}~\\text{В}`)}}{${q('r', `${r}~\\text{Ом}`)}} ${isRounded(i) ? '\\approx' : '='} ${q('i', `${tex(i)}~\\text{А}`)}`,
			);
			if (u !== last.u) {
				live.innerHTML =
					u > last.u
						? 'Напряжение растёт — во столько же раз растёт и сила тока.'
						: 'Напряжение уменьшается — во столько же раз уменьшается и сила тока.';
			} else if (r !== last.r) {
				live.innerHTML =
					r > last.r
						? 'Сопротивление растёт — во столько же раз уменьшается сила тока.'
						: 'Сопротивление уменьшается — во столько же раз растёт сила тока.';
			}
			last = { u, r };
		};
		uIn.addEventListener('input', draw);
		rIn.addEventListener('input', draw);
		draw();
		live.innerHTML = 'Подвигайте ползунки и следите за буквой <i>I</i>.';
	}
</script>
