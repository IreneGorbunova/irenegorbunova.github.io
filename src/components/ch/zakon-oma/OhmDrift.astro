---
/**
 * Picture to the two dependences of Ohm's law: two wires «under a microscope», side by side, with free electrons.
 * mode="u": the same wire (R = 4 Ом) at 2 В and at 4 В: I = 0,5 А and 1 А.
 * mode="r": the same voltage 4 В on two wires of one material and thickness, the second twice as long:
 *   R = 2 Ом and 4 Ом, I = 2 А and 1 А.
 * The electrons move chaotically and, besides, drift towards «+» (to the left, against the current arrow) with a
 * speed proportional to the field, i.e. to U / l. With the same density of electrons the charge through the cross
 * section per second is proportional to the drift: twice the drift — twice the current. Ions of the lattice are shown
 * faintly. Speeds are shown conventionally (stated in the caption).
 */
interface Props {
	mode: 'u' | 'r';
}
const { mode } = Astro.props;
/** U in В, len: share of the drawing's width (1 = full), R in Ом. */
const ROWS =
	mode === 'u'
		? [
				{ u: 2, len: 1, r: 4, note: '' },
				{ u: 4, len: 1, r: 4, note: '' },
			]
		: [
				{ u: 4, len: 0.5, r: 2, note: 'проволока 1 м' },
				{ u: 4, len: 1, r: 4, note: 'проволока 2 м' },
			];
const fmt = (v: number) => String(v).replace('.', ',');
const CAPTION =
	mode === 'u'
		? 'Один и тот же проводник. При 4 В электрическое поле в нём вдвое сильнее, чем при 2 В: электроны движутся упорядоченно вдвое быстрее, и сила тока вдвое больше.'
		: 'На каждый сантиметр длинной проволоки приходится вдвое меньшее напряжение, поле в ней вдвое слабее: электроны движутся упорядоченно вдвое медленнее, и сила тока вдвое меньше.';
---

<figure class="od not-content" data-od data-rows={JSON.stringify(ROWS)}>
	<div class="od__rows">
		{
			ROWS.map((row) => (
				<div class="od__row" data-row>
					<div class="od__head">
						<span class="od__u">
							<i>U</i> = {fmt(row.u)} В
						</span>
						{row.note && <span class="od__note">{row.note}</span>}
						<span class="od__r">
							<i>R</i> = {fmt(row.r)} Ом
						</span>
					</div>
					<canvas
						class="od__canvas"
						data-canvas
						aria-label={`Проводник под микроскопом при напряжении ${fmt(row.u)} В: свободные электроны движутся беспорядочно и вдобавок все вместе смещаются к «+»`}
					/>
					<div class="od__meter">
						<span class="od__meter-k">
							сила тока <i>I</i>
						</span>
						<span class="od__bar">
							<span style={`width: ${(100 * row.u) / row.r / 2}%`} />
						</span>
						<b>{fmt(row.u / row.r)} А</b>
					</div>
				</div>
			))
		}
	</div>
	<figcaption class="od__legend">
		{CAPTION} Точки — свободные электроны, они смещаются к «+», навстречу направлению тока <i>I</i>. Скорости показаны
		условно: на самом деле беспорядочное движение намного быстрее, а упорядоченное — намного медленнее.
	</figcaption>
</figure>

<style is:global>
	.od {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.od i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.od__rows {
		display: grid;
		gap: 0.75rem;
	}
	.od__row {
		border: 2px solid color-mix(in srgb, var(--ig-v) 55%, transparent);
		border-radius: 0.8rem;
		overflow: hidden;
		background: var(--sl-color-black);
	}
	.od__head,
	.od__meter {
		display: flex;
		align-items: center;
		gap: 0.4rem 0.9rem;
		padding: 0.35rem 0.8rem;
		font-size: var(--sl-text-sm);
		background: var(--ig-surface);
	}
	.od__head {
		justify-content: space-between;
		border-bottom: 1px solid var(--sl-color-gray-5);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.od__u {
		color: var(--ig-vy);
	}
	.od__r {
		color: var(--ig-v);
	}
	.od__note {
		font-weight: 400;
		color: var(--sl-color-gray-2);
	}
	.od__canvas {
		display: block;
		width: 100%;
		height: 112px;
	}
	.od__meter {
		border-top: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
	}
	.od__meter-k {
		white-space: nowrap;
	}
	.od__bar {
		flex: 1;
		min-width: 3rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		overflow: hidden;
	}
	.od__bar span {
		display: block;
		height: 100%;
		border-radius: 999px;
		background: var(--ig-vx);
	}
	.od__meter b {
		min-width: 3rem;
		text-align: right;
		color: var(--ig-vx);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.od__legend {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
</style>

<script>
	const H = 112;
	const WT = 32; // top of the wire
	const WB = 86; // bottom of the wire
	const PAD = 24; // room for the clamps
	const GAP = 18; // lattice spacing
	const VTH = 32; // chaotic speed, px/s
	const TAU = 0.22; // mean time between changes of direction, s
	const K = 9; // drift, px/s, for U / len = 1 (2 В on the full width)
	const AREA_PER_E = 260; // px² of wire per drawn electron

	type Row = { u: number; len: number; r: number };
	type El = { x: number; y: number; vx: number; vy: number; free: number };

	const colours = (el: Element) => {
		const cs = getComputedStyle(el);
		const get = (n: string) => cs.getPropertyValue(n).trim() || '#888';
		return {
			e: get('--ig-vx'),
			ion: get('--ig-vy'),
			g2: get('--sl-color-gray-2'),
			g3: get('--sl-color-gray-3'),
			g4: get('--sl-color-gray-4'),
			g5: get('--sl-color-gray-5'),
			g6: get('--sl-color-gray-6'),
			white: get('--sl-color-white'),
			math: get('--ig-font-math') || 'serif',
			font: cs.fontFamily,
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-od]')) {
		const cfg: Row[] = JSON.parse(root.dataset.rows!);
		let col = colours(root);
		const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')].map((el, k) => {
			const canvas = el.querySelector<HTMLCanvasElement>('[data-canvas]')!;
			return { ...cfg[k], canvas, ctx: canvas.getContext('2d')!, W: 0, x1: 0, x2: 0, els: [] as El[], ions: [] as { x: number; y: number; ph: number }[] };
		});
		type R = (typeof rows)[number];
		const free = () => Math.min(3 * TAU, -TAU * Math.log(1 - Math.random()));

		const build = (r: R) => {
			const w = (r.W - 2 * PAD) * r.len;
			r.x1 = (r.W - w) / 2;
			r.x2 = r.x1 + w;
			r.ions = [];
			let seed = 7;
			const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
			for (let x = r.x1 + GAP / 2; x < r.x2 - 4; x += GAP)
				for (const y of [WT + 9, (WT + WB) / 2, WB - 9]) r.ions.push({ x, y, ph: rnd() * 6.283 });
			const n = Math.round((w * (WB - WT)) / AREA_PER_E);
			r.els = Array.from({ length: n }, () => {
				const a = Math.random() * 6.283;
				return { x: r.x1 + Math.random() * w, y: WT + 4 + Math.random() * (WB - WT - 8), vx: VTH * Math.cos(a), vy: VTH * Math.sin(a), free: free() };
			});
		};

		const resize = (r: R) => {
			const w = Math.round(r.canvas.clientWidth);
			if (!w) return;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			r.canvas.width = Math.round(w * dpr);
			r.canvas.height = Math.round(H * dpr);
			r.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			if (w !== r.W) {
				r.W = w;
				build(r);
			}
		};

		const step = (r: R, dt: number) => {
			// the drift is proportional to the field, U / l; on a narrow screen the drawing is smaller, and so are the speeds
			const scale = Math.min(1, r.W / 560);
			const drift = K * scale * (r.u / 2 / r.len);
			const w = r.x2 - r.x1;
			for (const e of r.els) {
				e.free -= dt;
				if (e.free <= 0) {
					const a = Math.random() * 6.283;
					e.vx = VTH * scale * Math.cos(a);
					e.vy = VTH * Math.sin(a);
					e.free = free();
				}
				e.x += (e.vx - drift) * dt; // towards «+», on the left
				e.y += e.vy * dt;
				if (e.y < WT + 3) (e.y = 2 * (WT + 3) - e.y), (e.vy = Math.abs(e.vy));
				if (e.y > WB - 3) (e.y = 2 * (WB - 3) - e.y), (e.vy = -Math.abs(e.vy));
				if (e.x < r.x1) e.x += w; // what leaves at «+» comes back at «−» through the source
				if (e.x > r.x2) e.x -= w;
			}
		};

		const arrow = (ctx: CanvasRenderingContext2D, xa: number, xb: number, y: number) => {
			ctx.beginPath();
			ctx.moveTo(xa, y);
			ctx.lineTo(xb - 6, y);
			ctx.stroke();
			ctx.beginPath();
			ctx.moveTo(xb, y);
			ctx.lineTo(xb - 8, y - 4.5);
			ctx.lineTo(xb - 8, y + 4.5);
			ctx.closePath();
			ctx.fill();
		};

		const draw = (r: R, time: number) => {
			const { ctx, W, x1, x2 } = r;
			ctx.clearRect(0, 0, W, H);
			// the wire
			const g = ctx.createLinearGradient(0, WT, 0, WB);
			g.addColorStop(0, col.g5);
			g.addColorStop(0.35, col.g6);
			g.addColorStop(1, col.g6);
			ctx.fillStyle = g;
			ctx.fillRect(x1, WT, x2 - x1, WB - WT);
			ctx.strokeStyle = col.g3;
			ctx.lineWidth = 1.5;
			ctx.beginPath();
			ctx.moveTo(x1, WT);
			ctx.lineTo(x2, WT);
			ctx.moveTo(x1, WB);
			ctx.lineTo(x2, WB);
			ctx.stroke();
			// ions of the lattice, faint
			ctx.strokeStyle = col.ion;
			ctx.lineWidth = 1;
			ctx.globalAlpha = 0.45;
			for (const ion of r.ions) {
				const x = ion.x + Math.sin(time * 0.012 + ion.ph);
				const y = ion.y + Math.cos(time * 0.010 + ion.ph * 1.7);
				ctx.beginPath();
				ctx.arc(x, y, 4.2, 0, 6.283);
				ctx.stroke();
				ctx.beginPath();
				ctx.moveTo(x - 2, y);
				ctx.lineTo(x + 2, y);
				ctx.moveTo(x, y - 2);
				ctx.lineTo(x, y + 2);
				ctx.stroke();
			}
			ctx.globalAlpha = 1;
			// electrons
			ctx.fillStyle = col.e;
			for (const e of r.els) {
				ctx.beginPath();
				ctx.arc(e.x, e.y, 2.4, 0, 6.283);
				ctx.fill();
			}
			// clamps «+» and «−»
			ctx.fillStyle = col.g4;
			ctx.strokeStyle = col.g3;
			ctx.lineWidth = 1;
			for (const x of [x1 - 9, x2 - 1]) {
				ctx.beginPath();
				ctx.roundRect(x, WT - 6, 10, WB - WT + 12, 2);
				ctx.fill();
				ctx.stroke();
			}
			ctx.font = `700 15px ${col.font}`;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'alphabetic';
			ctx.fillStyle = col.white;
			ctx.fillText('+', x1 - 4, WT - 11);
			ctx.fillText('−', x2 + 4, WT - 11);
			// the direction of the current: from «+» to «−»
			const mid = (x1 + x2) / 2;
			ctx.strokeStyle = col.g2;
			ctx.fillStyle = col.g2;
			ctx.lineWidth = 1.6;
			arrow(ctx, mid - 34, mid + 34, WT - 15);
			ctx.font = `italic 16px ${col.math}`;
			ctx.textAlign = 'left';
			ctx.fillText('I', mid + 40, WT - 10);
			// the direction of the electrons' drift: towards «+»
			ctx.strokeStyle = col.e;
			ctx.fillStyle = col.e;
			arrow(ctx, mid + 34, mid - 34, WB + 15);
			ctx.font = `13px ${col.font}`;
			ctx.textAlign = 'left';
			ctx.fillText('электроны', mid + 42, WB + 20);
		};

		let visible = false;
		let raf = 0;
		let last = 0;
		let frame = 0;
		const loop = (time: number) => {
			const dt = Math.min(0.05, last ? (time - last) / 1000 : 0.016);
			last = time;
			if (frame++ % 30 === 0) col = colours(root);
			for (const r of rows) {
				step(r, dt);
				draw(r, time);
			}
			raf = visible ? requestAnimationFrame(loop) : 0;
		};
		new ResizeObserver(() => {
			col = colours(root);
			for (const r of rows) {
				resize(r);
				draw(r, performance.now());
			}
		}).observe(root);
		new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting;
			if (visible && !raf) {
				last = 0;
				raf = requestAnimationFrame(loop);
			}
		}).observe(root);
		rows.forEach(resize);
	}
</script>
