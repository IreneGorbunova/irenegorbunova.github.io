---
/**
 * Two short looping opening scenes of «Закон Ома для участка цепи». No numbers and no signs in the pictures; the
 * captions' popovers explain.
 * Flashlight: an evening room, a flashlight on the table with its body cut away (three cells inside) shines on the
 *   wall. The cells run down (hours, shown fast): the beam and the spot fade, the filament turns from white-yellow to
 *   dull red. The end cap comes off, the old cells slide out, fresh ones slide in, the cap goes back, and the
 *   flashlight shines brightly again. The voltage of the cells fell, the filament is the same: less current.
 * Hands: a bathroom. Hands are washed under the tap (drops fall), the tap closes, the hands are wiped on the towel
 *   (the drops on them vanish), then the hand takes the plug of the hair dryer from the counter and puts it into the
 *   socket; the hand leaves and the hair dryer blows. Wet skin has a much smaller resistance than dry skin.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gGlow = `oi-glow-${uid}`;
const gBeam = `oi-beam-${uid}`;
// Flashlight: the tube from x = 46 to 176 (y 130–156), three cells inside, + ends towards the bulb.
const CELLS = [52, 92, 132];
// Bathroom tiles
const TILES_X = Array.from({ length: 15 }, (_, k) => 24 * (k + 1));
const TILES_Y = [24, 48, 72, 96, 120, 144];
// Drops on the back of the hand (local coordinates, fingertip at 0,0)
const WET = [
	[-58, -9],
	[-42, -10],
	[-27, -7],
	[-14, -4],
	[-50, 2],
];
const FALL = [-46, -30, -16];
---

<IntroFrame data-ohmintro>
	<div class="intro__card" data-scene="torch">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер, комната. Фонарик на столе светит на стену. Батарейки садятся: свет тускнеет, нить лампочки становится тёмно-красной. Старые батарейки вынимают, вставляют новые — и фонарик снова светит ярко">
			<defs>
				<radialGradient id={gGlow}>
					<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.95"></stop>
					<stop offset="0.4" stop-color="var(--ig-v)" stop-opacity="0.35"></stop>
					<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
				</radialGradient>
				<linearGradient id={gBeam} x1="0" x2="1" y1="0" y2="0">
					<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.55"></stop>
					<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0.12"></stop>
				</linearGradient>
			</defs>
			<rect class="oi-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="oi-wall-side" x="326" y="0" width="34" height="186"></rect>
			<rect class="oi-table" x="0" y="186" width="360" height="54"></rect>
			<line class="oi-edge" x1="0" y1="186" x2="360" y2="186"></line>
			<!-- the beam and the spot on the wall -->
			<polygon points="206,132 206,154 326,196 326,90" fill={`url(#${gBeam})`} class="oi-beam" data-beam></polygon>
			<ellipse class="oi-spot" cx="327" cy="143" rx="5" ry="50" data-spot></ellipse>
			<!-- the flashlight: tube, head, lens -->
			<rect class="oi-body" x="40" y="128" width="140" height="30" rx="6"></rect>
			<rect class="oi-inside" x="46" y="132" width="130" height="22" rx="3"></rect>
			<path class="oi-spring" d="M 48 136 l 3 3 l -3 3 l 3 3 l -3 3 l 3 3"></path>
			<g data-cells>
				{
					CELLS.map((x) => (
						<g>
							<rect class="oi-cell" x={x} y="134" width="36" height="18" rx="2.5" />
							<rect class="oi-cell-band" x={x + 4} y="134" width="10" height="18" />
							<rect class="oi-cell-nub" x={x + 36} y="139.5" width="3" height="7" rx="1" />
						</g>
					))
				}
			</g>
			<path class="oi-head" d="M 176 126 L 196 116 H 206 V 170 H 196 L 176 160 Z"></path>
			<path class="oi-reflector" d="M 182 134 L 200 124 V 162 L 182 152 Z"></path>
			<circle cx="194" cy="143" r="30" fill={`url(#${gGlow})`} class="oi-glow" data-glow></circle>
			<circle class="oi-bulb" cx="192" cy="143" r="6"></circle>
			<path class="oi-fil oi-fil--hot" d="M 189 145 q 1.5 -5 3 0 q 1.5 -5 3 0" data-hot></path>
			<path class="oi-fil oi-fil--dim" d="M 189 145 q 1.5 -5 3 0 q 1.5 -5 3 0" data-dim></path>
			<line class="oi-lens" x1="206" y1="117" x2="206" y2="169"></line>
			<rect class="oi-switch" x="120" y="124" width="16" height="5" rx="2"></rect>
			<!-- the end cap -->
			<rect class="oi-cap" x="30" y="126" width="14" height="34" rx="4" data-cap></rect>
			<!-- the darkness of an evening room -->
			<rect class="oi-dark" x="0" y="0" width="360" height="240" data-dark></rect>
		</svg>
		<div class="intro__foot">
			<p>Когда батарейки садятся, фонарик светит всё тусклее, а с новыми — снова ярко: <More term="чем меньше напряжение, тем меньше сила тока">У новой пальчиковой батарейки <b>напряжение</b> 1,5 В, а у севшей оно падает примерно до 1 В. Нить лампочки та же, но при меньшем напряжении через неё идёт меньший ток, и она светит тусклее. Подробнее — в разделе <a href="#зависимость-силы-тока-от-напряжения">«Зависимость силы тока от напряжения»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="hands">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ванная комната. Руку моют под краном, потом вытирают полотенцем насухо и только после этого берут вилку фена и включают её в розетку. Фен дует">
			<rect class="oi-tiles" x="0" y="0" width="360" height="176"></rect>
			<g class="oi-grout">
				{TILES_X.map((x) => <line x1={x} y1="0" x2={x} y2="176" />)}
				{TILES_Y.map((y) => <line x1="0" y1={y} x2="360" y2={y} />)}
			</g>
			<rect class="oi-counter" x="0" y="176" width="360" height="64"></rect>
			<line class="oi-edge" x1="0" y1="176" x2="360" y2="176"></line>
			<!-- the sink and the tap -->
			<path class="oi-basin" d="M 18 170 H 142 Q 142 182 130 186 H 30 Q 18 182 18 170 Z"></path>
			<path class="oi-pipe" d="M 34 170 V 108 Q 34 100 42 100 H 88 Q 96 100 96 108 V 116"></path>
			<rect class="oi-tap" x="26" y="92" width="16" height="7" rx="3" data-tap></rect>
			<rect class="oi-stream" x="92" y="117" width="8" height="53" rx="3" data-stream></rect>
			<g data-falls>
				{FALL.map(() => <ellipse class="oi-drop" rx="1.8" ry="2.6" />)}
			</g>
			<!-- the towel on a hook -->
			<circle class="oi-hook" cx="186" cy="56" r="4"></circle>
			<g data-towel>
				<path class="oi-towel" d="M 168 60 H 204 V 146 Q 186 152 168 146 Z"></path>
				<path class="oi-towel-band" d="M 168 128 H 204 M 168 134 H 204"></path>
			</g>
			<!-- the socket -->
			<rect class="oi-socket" x="296" y="66" width="38" height="38" rx="6"></rect>
			<circle class="oi-socket-ring" cx="315" cy="85" r="13"></circle>
			<circle class="oi-hole" cx="310" cy="85" r="1.8"></circle>
			<circle class="oi-hole" cx="320" cy="85" r="1.8"></circle>
			<!-- the hair dryer on the counter: body, nozzle, handle; air when it works -->
			<g data-dryer>
				<rect class="oi-dryer" x="228" y="130" width="62" height="26" rx="12"></rect>
				<rect class="oi-dryer" x="288" y="134" width="22" height="18" rx="3"></rect>
				<rect class="oi-dryer" x="240" y="152" width="16" height="24" rx="4"></rect>
				<circle class="oi-dryer-grid" cx="234" cy="143" r="7"></circle>
			</g>
			<g data-air>
				<path class="oi-air" d="M 314 137 H 356"></path>
				<path class="oi-air" d="M 314 143 H 356"></path>
				<path class="oi-air" d="M 314 149 H 356"></path>
			</g>
			<path class="oi-cord" d="" data-cord></path>
			<!-- the plug: prongs to the right; its centre is moved -->
			<g data-plug>
				<rect class="oi-prong" x="6" y="-4" width="7" height="2"></rect>
				<rect class="oi-prong" x="6" y="2" width="7" height="2"></rect>
				<rect class="oi-plug" x="-8" y="-7" width="15" height="14" rx="4"></rect>
			</g>
			<!-- the hand, palm down; the fingertips at (0, 0) -->
			<g data-hand>
				<rect class="oi-sleeve" x="-600" y="-15" width="532" height="30" rx="6"></rect>
				<path class="oi-skin" d="M -72 -13 C -54 -16 -30 -13 -10 -7 Q 3 -3 1 2 Q -1 6 -9 6 L -36 7 C -50 9 -62 13 -72 13 Z"></path>
				<path class="oi-skin" d="M -58 6 Q -44 4 -32 9 Q -36 14 -46 13 Q -54 12 -58 6 Z"></path>
				<path class="oi-line" d="M -36 0 H -12 M -36 -5 H -16"></path>
				<g data-wet>
					{WET.map(([x, y]) => <ellipse class="oi-wet" cx={x} cy={y} rx="2" ry="2.6" />)}
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Прежде чем включить фен, руки вытирают насухо: <More term="мокрая кожа пропускает ток гораздо лучше сухой">У сухой кожи <b>сопротивление</b> большое, до 100 000 Ом, а у мокрой — всего около 1000 Ом. При одном и том же напряжении сила тока тем больше, чем меньше сопротивление, поэтому через мокрую руку пошёл бы ток во много раз больше. Подробнее — в разделе <a href="#закон-ома-и-безопасность">«Закон Ома и безопасность»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-ohmintro] {
		--oi-night: var(--sl-color-black);
		--oi-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--oi-wall: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-5));
		--oi-tile: color-mix(in srgb, var(--ig-vx) 18%, var(--sl-color-gray-5));
		--oi-hot: color-mix(in oklab, var(--ig-vy) 75%, var(--sl-color-gray-3));
		--oi-plastic: var(--sl-color-gray-2);
	}
	:root[data-theme='light'] [data-ohmintro] {
		--oi-night: var(--sl-color-white);
		--oi-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--oi-wall: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-6));
		--oi-tile: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-6));
		--oi-plastic: var(--sl-color-gray-3);
	}
	.oi-wall {
		fill: var(--oi-wall);
	}
	.oi-wall-side {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 60%, var(--oi-wall));
	}
	.oi-table {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-5));
	}
	.oi-edge {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.oi-beam {
		opacity: 0;
	}
	.oi-spot {
		fill: var(--ig-v);
		opacity: 0;
	}
	.oi-body {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 35%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.oi-inside {
		fill: color-mix(in srgb, var(--sl-color-gray-6) 85%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.oi-spring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.oi-cell {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.oi-cell-band {
		fill: color-mix(in srgb, var(--ig-vx) 60%, var(--sl-color-gray-4));
	}
	.oi-cell-nub {
		fill: var(--sl-color-gray-2);
	}
	.oi-head {
		fill: color-mix(in srgb, var(--sl-color-gray-3) 35%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.oi-reflector {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 25%, transparent);
	}
	.oi-glow {
		opacity: 0;
	}
	.oi-bulb {
		fill: color-mix(in srgb, var(--sl-color-white) 15%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.oi-fil {
		fill: none;
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.oi-fil--hot {
		stroke: var(--ig-v);
	}
	.oi-fil--dim {
		stroke: var(--oi-hot);
		opacity: 0;
	}
	.oi-lens {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.oi-switch {
		fill: var(--sl-color-gray-2);
	}
	.oi-cap {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.oi-dark {
		fill: var(--oi-night);
		opacity: 0.45;
		pointer-events: none;
	}
	/* bathroom */
	.oi-tiles {
		fill: var(--oi-tile);
	}
	.oi-grout line {
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 45%, transparent);
		stroke-width: 1;
	}
	.oi-counter {
		fill: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-5));
	}
	.oi-basin {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.oi-pipe {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 7;
		stroke-linecap: round;
	}
	.oi-tap {
		fill: var(--sl-color-gray-2);
		transform-box: fill-box;
		transform-origin: 70% 50%;
	}
	.oi-stream {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
	}
	.oi-drop,
	.oi-wet {
		fill: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-white));
	}
	.oi-hook {
		fill: var(--sl-color-gray-2);
	}
	.oi-towel {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.oi-towel-band {
		stroke: color-mix(in srgb, var(--ig-vy) 55%, var(--sl-color-gray-3));
		stroke-width: 3;
	}
	.oi-socket {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.oi-socket-ring {
		fill: var(--sl-color-gray-3);
	}
	.oi-hole {
		fill: var(--sl-color-gray-6);
	}
	.oi-dryer {
		fill: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.oi-dryer-grid {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 2 2;
	}
	.oi-air {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-dasharray: 9 7;
		opacity: 0;
	}
	.oi-cord {
		fill: none;
		stroke: var(--oi-plastic);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.oi-plug {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.oi-prong {
		fill: var(--sl-color-gray-3);
	}
	.oi-skin {
		fill: var(--oi-skin);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.oi-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linecap: round;
		opacity: 0.6;
	}
	.oi-sleeve {
		fill: color-mix(in srgb, var(--ig-vy) 35%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-ohmintro]')) {
		// Flashlight: fades (0,04 → 0,5), the cap off, old cells out, new in, the cap back (0,55 → 0,84), bright; 7 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="torch"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const beam = $<SVGPolygonElement>('[data-beam]');
			const spot = $<SVGEllipseElement>('[data-spot]');
			const glow = $<SVGCircleElement>('[data-glow]');
			const hot = $<SVGPathElement>('[data-hot]');
			const dim = $<SVGPathElement>('[data-dim]');
			const cells = $<SVGGElement>('[data-cells]');
			const cap = $<SVGRectElement>('[data-cap]');
			const dark = $<SVGRectElement>('[data-dark]');
			scene(card, 7, (x) => {
				// the light: bright → dim while the cells run down, off while they are changed, bright with new ones
				const fade = smooth(0.04, 0.5, x);
				const back = smooth(0.84, 0.88, x);
				const out = smooth(0.55, 0.57, x) * (1 - back);
				const b = Math.max(0, (1 - 0.88 * fade) * (1 - out)) * (1 - back) + back;
				beam.style.opacity = f2(b);
				spot.style.opacity = f2(0.85 * b);
				glow.style.opacity = f2(b);
				// the filament: white-yellow when hot, dull red when the current is small, dark when off
				const red = (1 - back) * fade * (1 - out);
				hot.style.opacity = f2(Math.max(0, b - 0.1 * red));
				dim.style.opacity = f2(red * 0.9);
				dark.style.opacity = f2(0.1 + 0.32 * (1 - b));
				// the cap: off to the left and down, then back
				const capOff = smooth(0.55, 0.6, x) * (1 - smooth(0.79, 0.84, x));
				cap.setAttribute('transform', `translate(${f1(-26 * capOff)} ${f1(40 * capOff)})`);
				// the cells: the old ones slide out to the left and vanish, the new ones slide in from the left
				const slideOut = smooth(0.6, 0.68, x);
				const slideIn = smooth(0.7, 0.79, x);
				const dx = x < 0.69 ? -160 * slideOut : -160 * (1 - slideIn);
				cells.setAttribute('transform', `translate(${f1(dx)} 0)`);
				cells.style.opacity = f2(x < 0.69 ? 1 - smooth(0.62, 0.68, x) : smooth(0.69, 0.74, x));
			});
		}

		// Hands: washing (→ 0,28), the tap shut, wiping on the towel (0,36 → 0,52), the plug into the socket (→ 0,74),
		// the hand leaves, the hair dryer blows; 9 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="hands"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const hand = $<SVGGElement>('[data-hand]');
			const wet = $<SVGGElement>('[data-wet]');
			const stream = $<SVGRectElement>('[data-stream]');
			const tap = $<SVGRectElement>('[data-tap]');
			const falls = [...card.querySelectorAll<SVGEllipseElement>('[data-falls] ellipse')];
			const towel = $<SVGGElement>('[data-towel]');
			const plug = $<SVGGElement>('[data-plug]');
			const prongs = [...card.querySelectorAll<SVGRectElement>('.oi-prong')];
			const cord = $<SVGPathElement>('[data-cord]');
			const air = [...card.querySelectorAll<SVGPathElement>('[data-air] path')];
			const dryer = $<SVGGElement>('[data-dryer]');
			const RUN = 9;
			const SINK = { x: 118, y: 140 }; // fingertips under the stream
			const TOWEL = { x: 202, y: 92 };
			const PLUG0 = { x: 206, y: 169 }; // the plug lying on the counter (its centre)
			const SOCKET = { x: 315, y: 85 };
			const AWAY = { x: 10, y: 270 };
			const SHOULDER = { x: -200, y: 260 };
			const GRIP = { x: 9, y: 2 }; // the plug's centre from the fingertips
			/** The fingertips' place that puts the held plug's centre at `t` (the hand is turned towards the shoulder). */
			const tipFor = (t: { x: number; y: number }) => {
				let tip = { x: t.x - GRIP.x, y: t.y - GRIP.y };
				for (let k = 0; k < 3; k++) {
					const a = Math.atan2(tip.y - SHOULDER.y, tip.x - SHOULDER.x);
					tip = { x: t.x - (GRIP.x * Math.cos(a) - GRIP.y * Math.sin(a)), y: t.y - (GRIP.x * Math.sin(a) + GRIP.y * Math.cos(a)) };
				}
				return tip;
			};
			const AT_PLUG = tipFor(PLUG0);
			const AT_SOCKET = tipFor(SOCKET);
			const path: [number, { x: number; y: number }][] = [
				[0, SINK],
				[0.3, SINK],
				[0.37, TOWEL],
				[0.53, TOWEL],
				[0.6, AT_PLUG],
				[0.63, AT_PLUG],
				[0.74, AT_SOCKET],
				[0.77, AT_SOCKET],
				[0.92, AWAY],
				[1, AWAY],
			];
			const at = (x: number) => {
				for (let k = 1; k < path.length; k++) {
					const [x0, p0] = path[k - 1];
					const [x1, p1] = path[k];
					if (x <= x1) {
						const t = smooth(x0, x1, x);
						return { x: lerp(p0.x, p1.x, t), y: lerp(p0.y, p1.y, t) };
					}
				}
				return AWAY;
			};
			scene(card, RUN, (x) => {
				const s = x * RUN; // seconds into the scene
				const p = at(x);
				let hx = p.x;
				let hy = p.y;
				// rubbing under the stream; wiping up and down on the towel
				if (x < 0.3) hx += 3 * Math.sin(s * 11) * smooth(0, 0.04, x);
				const wipe = smooth(0.37, 0.39, x) * (1 - smooth(0.51, 0.53, x));
				hy += 16 * Math.sin((x - 0.37) * RUN * 5.5) * wipe;
				// the arm comes from a shoulder below the left edge: the hand points away from it
				const ang = (Math.atan2(hy - SHOULDER.y, hx - SHOULDER.x) * 180) / Math.PI;
				hand.setAttribute('transform', `translate(${f1(hx)} ${f1(hy)}) rotate(${f1(ang)})`);
				towel.setAttribute('transform', `skewX(${f2(2.5 * wipe * Math.sin((x - 0.37) * RUN * 5.5))})`);
				wet.style.opacity = f2(1 - smooth(0.38, 0.52, x));
				// the tap: open while washing
				const on = 1 - smooth(0.27, 0.3, x);
				stream.style.opacity = f2(on);
				tap.style.transform = `rotate(${f1(-25 * on)}deg)`;
				// drops falling from the hand into the sink while it is wet and over the sink
				falls.forEach((d, k) => {
					const ph = (s * 1.6 + k / falls.length) % 1;
					const show = x < 0.33 ? 1 : 0;
					d.setAttribute('cx', f1(SINK.x + [-46, -30, -16][k]));
					d.setAttribute('cy', f1(SINK.y + 9 + 22 * ph * ph));
					d.style.opacity = f2(show * (1 - ph) * smooth(0.02, 0.06, x));
				});
				// the plug: on the counter, then in the fingers, then in the socket
				const held = x >= 0.63 && x < 0.77;
				const inSocket = x >= 0.77;
				const ar = Math.atan2(hy - SHOULDER.y, hx - SHOULDER.x);
				const grip = { x: hx + GRIP.x * Math.cos(ar) - GRIP.y * Math.sin(ar), y: hy + GRIP.x * Math.sin(ar) + GRIP.y * Math.cos(ar) };
				const pg = inSocket ? SOCKET : held ? grip : PLUG0;
				plug.setAttribute('transform', `translate(${f1(pg.x)} ${f1(pg.y)})`);
				prongs.forEach((r) => (r.style.opacity = inSocket ? '0' : '1'));
				// the cord from the handle of the dryer to the plug: it sags
				const c0 = { x: 248, y: 176 };
				const sag = Math.max(14, 40 - Math.abs(pg.x - c0.x) * 0.1);
				cord.setAttribute(
					'd',
					`M ${c0.x} ${c0.y} C ${f1(c0.x - 10)} ${f1(c0.y + sag)} ${f1(pg.x - 8)} ${f1(Math.max(pg.y, c0.y) + sag)} ${f1(pg.x - 8)} ${f1(pg.y)}`,
				);
				// the hair dryer works once it is plugged in
				const blow = smooth(0.78, 0.81, x);
				air.forEach((a, k) => {
					a.style.opacity = f2(blow * 0.9);
					a.style.strokeDashoffset = f1(-(s * 60 + k * 5));
				});
				dryer.setAttribute('transform', `translate(0 ${f2(blow * 0.6 * Math.sin(s * 40))})`);
			});
		}
	}
</script>
