---
/**
 * «Опыт с падением»: two bodies are let go from 2 м at the same moment, in air or in a tube with the air pumped out.
 * Each falls under gravity and the resistance of air, m·a = m·g − ½·ρ·C·A·υ² (ρ = 1,2 кг/м³):
 *   стальной шарик   d = 2 см, 32,7 г, C = 0,47                    → 0,64 с
 *   деревянный шарик d = 2 см, 2,5 г (600 кг/м³), C = 0,47          → 0,65 с
 *   лист бумаги      A5, 80 г/м², 2,5 г, falls flat, C = 1,2        → 1,99 с
 *   скомканный лист  the same sheet as a ball d = 4 см, C = 0,5     → 0,67 с
 *   пёрышко          settles at 0,8 м/с                             → 2,56 с
 * Without air every body falls 2 м in 0,64 с. The motion is shown 4 times slower; the clock shows the real time.
 * Marks are left every 0,1 с, as on a stroboscopic photograph. The height axis is to scale (125 px per metre).
 */
import G7Styles from '../g7/G7Styles.astro';

const BODIES = [
	{ key: 'steel', name: 'Стальной шарик' },
	{ key: 'wood', name: 'Деревянный шарик' },
	{ key: 'sheet', name: 'Лист бумаги' },
	{ key: 'crumpled', name: 'Скомканный лист' },
	{ key: 'feather', name: 'Пёрышко' },
];
const TOP = 34;
const M = 125;
const ticks = [0, 0.5, 1, 1.5, 2];
---

<G7Styles />
<figure class="g7 fall not-content" data-fall>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 320 320" role="img" aria-label="Два тела падают с высоты двух метров рядом с линейкой" data-svg>
			<rect class="fall__tube" x="50" y="14" width="220" height="286" rx="14" data-tube></rect>
			<text class="t-small" x="160" y="312" text-anchor="middle" data-air>в трубе воздух</text>
			<!-- the ruler: height above the floor -->
			<line class="ln" x1="160" y1={TOP} x2="160" y2={TOP + 2 * M}></line>
			{
				ticks.map((t) => (
					<>
						<line class="ln" x1="154" x2="166" y1={TOP + (2 - t) * M} y2={TOP + (2 - t) * M} />
						<text class="t-small t-num" x="170" y={TOP + (2 - t) * M + 4}>
							{String(t).replace('.', ',')} м
						</text>
					</>
				))
			}
			<line class="fall__floor" x1="56" x2="264" y1={TOP + 2 * M + 8} y2={TOP + 2 * M + 8}></line>
			<g data-marks></g>
			<g data-body="0"></g>
			<g data-body="1"></g>
			<text class="t-strong t-num" x="104" y="28" text-anchor="middle" data-t0></text>
			<text class="t-strong t-num" x="226" y="28" text-anchor="middle" data-t1></text>
		</svg>
		<div class="g7__side">
			<label class="g7__select">
				Слева
				<select data-pick="0" aria-label="Тело слева">
					{BODIES.map((b) => <option value={b.key} selected={b.key === 'steel'}>{b.name}</option>)}
				</select>
			</label>
			<label class="g7__select">
				Справа
				<select data-pick="1" aria-label="Тело справа">
					{BODIES.map((b) => <option value={b.key} selected={b.key === 'wood'}>{b.name}</option>)}
				</select>
			</label>
			<div class="g7__seg" role="group" aria-label="Воздух" data-airseg>
				<button type="button" class="g7__btn" aria-pressed="true" data-air-on="1">С воздухом</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-air-on="0">Воздух откачан</button>
			</div>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Отпустить</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span data-n0>Слева</span><b data-r0>—</b></li>
				<li><span data-n1>Справа</span><b data-r1>—</b></li>
			</ul>
			<p class="g7__msg" data-msg>Выберите два тела и нажмите «Отпустить».</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Оба тела отпускают одновременно с высоты 2 м. Падение показано в 4 раза медленнее, чем в жизни; числа — настоящее время падения. Метки остаются через каждую 0,1 с.
	</figcaption>
</figure>

<style is:global>
	.fall__tube {
		fill: color-mix(in srgb, var(--ig-vx) 7%, transparent);
		stroke: var(--g7-glass);
		stroke-width: 1.5;
	}
	.fall__tube.is-empty {
		fill: transparent;
		stroke-dasharray: 5 4;
	}
	.fall__floor {
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.fall__steel {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.fall__wood {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.fall__paper {
		fill: var(--sl-color-white);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.fall__feather {
		fill: color-mix(in oklab, var(--sl-color-white) 80%, var(--ig-vx));
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.fall__mark {
		fill: var(--g7-line);
		opacity: 0.55;
	}
</style>

<script>
	import { el, fmt, loop, segment } from '../g7/kit';

	const G = 9.8;
	const H = 2; // м
	const TOP = 34;
	const M = 125; // px per metre
	const SLOW = 4;
	const X = [104, 226];
	const ball = (m: number, c: number, a: number) => (1.2 * c * a) / (2 * m); // k in a = g − k·υ², 1/м
	const R = 0.01;
	const sheetM = 0.08 * 0.148 * 0.21;
	// k: resistance; h: the half-height of the drawing, px (the body touches the floor with its bottom)
	const BODY: Record<string, { name: string; k: number; h: number; draw: (g: SVGGElement) => void }> = {
		steel: { name: 'Стальной шарик', k: ball(7800 * (4 / 3) * Math.PI * R ** 3, 0.47, Math.PI * R ** 2), h: 6, draw: (g) => g.append(el('circle', { class: 'fall__steel', r: 6 })) },
		wood: { name: 'Деревянный шарик', k: ball(600 * (4 / 3) * Math.PI * R ** 3, 0.47, Math.PI * R ** 2), h: 6, draw: (g) => g.append(el('circle', { class: 'fall__wood', r: 6 })) },
		sheet: { name: 'Лист бумаги', k: ball(sheetM, 1.2, 0.148 * 0.21), h: 2, draw: (g) => g.append(el('rect', { class: 'fall__paper', x: -26, y: -2, width: 52, height: 4, rx: 1 })) },
		crumpled: {
			name: 'Скомканный лист',
			k: ball(sheetM, 0.5, Math.PI * 0.02 ** 2),
			h: 9,
			draw: (g) => g.append(el('path', { class: 'fall__paper', d: 'M-9 -3 L-5 -9 L2 -8 L8 -5 L9 2 L5 8 L-2 9 L-8 6 Z M-5 -9 L-1 -2 L8 -5 M-1 -2 L-2 9 M-1 -2 L-9 -3' })),
		},
		feather: {
			name: 'Пёрышко',
			k: G / 0.8 ** 2,
			h: 4,
			draw: (g) => g.append(el('path', { class: 'fall__feather', d: 'M-20 3 Q-8 -8 14 -5 Q20 -4 22 -1 Q10 6 -8 5 Z M-20 3 L22 -1' })),
		},
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-fall]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const groups = [q<SVGGElement>('[data-body="0"]'), q<SVGGElement>('[data-body="1"]')];
		const picks = [q<HTMLSelectElement>('[data-pick="0"]'), q<HTMLSelectElement>('[data-pick="1"]')];
		const marks = q<SVGGElement>('[data-marks]');
		const tube = q<SVGRectElement>('[data-tube]');
		const airText = q<SVGTextElement>('[data-air]');
		const go = q<HTMLButtonElement>('[data-go]');
		const msg = q<HTMLElement>('[data-msg]');
		const tText = [q<SVGTextElement>('[data-t0]'), q<SVGTextElement>('[data-t1]')];
		const rText = [q<HTMLElement>('[data-r0]'), q<HTMLElement>('[data-r1]')];
		const nText = [q<HTMLElement>('[data-n0]'), q<HTMLElement>('[data-n1]')];
		let air = true;
		let running = false;
		let t = 0;
		let nextMark = 0;
		const st = [
			{ y: 0, v: 0, land: 0 },
			{ y: 0, v: 0, land: 0 },
		];

		const place = (i: number) => {
			const b = BODY[picks[i].value];
			// y is the distance fallen by the bottom of the body; the body hangs with its bottom at the 2 м mark
			groups[i].setAttribute('transform', `translate(${X[i]} ${(TOP + st[i].y * M - b.h).toFixed(1)})`);
		};
		const reset = () => {
			running = false;
			t = 0;
			nextMark = 0;
			marks.replaceChildren();
			for (const i of [0, 1]) {
				st[i] = { y: 0, v: 0, land: 0 };
				groups[i].replaceChildren();
				BODY[picks[i].value].draw(groups[i]);
				place(i);
				tText[i].textContent = '';
				rText[i].textContent = '—';
				nText[i].textContent = BODY[picks[i].value].name;
			}
			go.textContent = 'Отпустить';
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			const steps = 8;
			const h = dt / SLOW / steps;
			for (let s = 0; s < steps; s++) {
				t += h;
				for (const i of [0, 1]) {
					const o = st[i];
					if (o.land) continue;
					const k = air ? BODY[picks[i].value].k : 0;
					o.v += (G - k * o.v * o.v) * h;
					o.y += o.v * h;
					if (o.y >= H) {
						o.y = H;
						o.land = t;
					}
				}
				if (t >= nextMark) {
					nextMark += 0.1;
					for (const i of [0, 1]) if (!st[i].land) marks.append(el('circle', { class: 'fall__mark', cx: X[i], cy: (TOP + st[i].y * M - BODY[picks[i].value].h).toFixed(1), r: 1.8 }));
				}
			}
			for (const i of [0, 1]) {
				place(i);
				tText[i].textContent = `${fmt(st[i].land || t, 2)} с`;
				if (st[i].land) rText[i].textContent = `${fmt(st[i].land, 2)} с`;
			}
			if (st[0].land && st[1].land) {
				running = false;
				const d = Math.abs(st[0].land - st[1].land);
				const first = st[0].land < st[1].land ? 0 : 1;
				msg.textContent =
					d < 0.005
						? 'Тела упали одновременно.'
						: d < 0.05
							? `Тела упали почти одновременно: ${BODY[picks[first].value].name.toLowerCase()} раньше всего на ${fmt(d, 2)} с.`
							: `${BODY[picks[first].value].name} упал раньше на ${fmt(d, 2)} с.`.replace('Пёрышко упал', 'Пёрышко упало');
				go.textContent = 'Ещё раз';
				return false;
			}
			return true;
		});

		for (const p of picks) p.addEventListener('change', () => { reset(); msg.textContent = 'Нажмите «Отпустить».'; });
		segment(q('[data-airseg]'), (b) => {
			air = b.dataset.airOn === '1';
			tube.classList.toggle('is-empty', !air);
			airText.textContent = air ? 'в трубе воздух' : 'воздух откачан';
			reset();
			msg.textContent = 'Нажмите «Отпустить».';
		});
		go.addEventListener('click', () => {
			reset();
			running = true;
			msg.textContent = 'Тела падают…';
			wake();
		});
		reset();
	}
</script>
