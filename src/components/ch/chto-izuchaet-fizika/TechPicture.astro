<script>
	import { loop, ease } from '../g7/kit';

	const TAU = 2 * Math.PI;
	const $ = <T extends Element = SVGElement>(root: Element, sel: string) => root.querySelector(sel) as T;
	const $$ = <T extends Element = SVGElement>(root: Element, sel: string) => [...root.querySelectorAll(sel)] as T[];
	const attrs = (e: Element, a: Record<string, string | number>) => {
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, typeof v === 'number' ? v.toFixed(2) : v);
	};

	/** 1. The locomotive: the wheels roll (period 2 s), 4 puffs per turn of the drivers. */
	const steam = (svg: SVGSVGElement) => {
		const W = TAU / 2; // rad/s
		const v = W * 11; // px/s of the rails under the train
		const sleepers = $(svg, '[data-sleepers]');
		const spokes = $$(svg, '[data-spokes]');
		const pins = $$(svg, '[data-pin]');
		const main = $(svg, '[data-main]');
		const cross = $(svg, '[data-cross]');
		const piston = $(svg, '[data-piston]');
		const couple = $(svg, '[data-couple]');
		const puffs = $$(svg, '[data-puffs] circle').map((e) => ({ e, age: 99 }));
		let th = 0;
		let next = 0;
		let p = 0;
		return (dt: number) => {
			th += W * dt;
			for (const s of spokes) {
				const r = +s.dataset.r!;
				s.setAttribute('transform', `rotate(${((th * 11) / r) * (180 / Math.PI)} ${s.dataset.cx} ${s.dataset.cy})`);
			}
			sleepers.setAttribute('transform', `translate(${-((th * 11) % 12)} 0)`);
			const c = Math.cos(th);
			const s = Math.sin(th);
			const px = [50, 74, 98].map((x) => x + 5 * c);
			const py = 87 + 5 * s;
			pins.forEach((e, i) => attrs(e, { cx: px[i], cy: py }));
			attrs(couple, { x1: px[0], y1: py, x2: px[2], y2: py });
			const dy = 76 - py;
			const xc = px[2] + Math.sqrt(24 * 24 - dy * dy);
			attrs(main, { x1: px[2], y1: py, x2: xc, y2: 76 });
			attrs(cross, { x: xc - 3, y: 73.5 });
			attrs(piston, { x1: xc, x2: 128 });
			// a puff at every quarter turn
			if (th >= next) {
				next += TAU / 4;
				puffs[p].age = 0;
				p = (p + 1) % puffs.length;
			}
			for (const q of puffs) {
				q.age += dt;
				if (q.age > 2.4) {
					q.e.setAttribute('opacity', '0');
					continue;
				}
				const a = q.age;
				attrs(q.e, { cx: 118 - v * a * 0.85, cy: 31 - 9 * a, r: 2.5 + 7 * Math.sqrt(a), opacity: 0.9 * (1 - a / 2.4) });
			}
		};
	};

	/** 2. The lamp and the fan on one switch: on 3,5 s, off 2,5 s. */
	const el = (svg: SVGSVGElement) => {
		const glow = $(svg, '[data-glow]');
		const bulb = $(svg, '[data-bulb]');
		const fil = $(svg, '[data-fil]');
		const sw = $(svg, '[data-switch]');
		const fan = $(svg, '[data-fan]');
		let t = 0;
		let w = 0; // rev/s
		let ang = 0;
		let heat = 0;
		return (dt: number) => {
			t = (t + dt) % 6;
			const on = t > 0.5 && t < 4;
			heat += ((on ? 1 : 0) - heat) * Math.min(1, dt / 0.1);
			w += ((on ? 2 : 0) - w) * Math.min(1, dt / (on ? 0.7 : 1.5));
			ang = (ang + w * 360 * dt) % 360;
			glow.setAttribute('opacity', heat.toFixed(2));
			bulb.classList.toggle('is-on', heat > 0.5);
			fil.classList.toggle('is-on', heat > 0.5);
			sw.classList.toggle('is-on', on);
			fan.setAttribute('transform', `translate(118 40) rotate(${ang.toFixed(1)})`);
		};
	};

	/** 3. The engraver: three ellipses, 2 s each, then the nucleus; the head moves between them with the laser off. */
	const laser = (svg: SVGSVGElement) => {
		const P = (u: number, v: number, h = 0) => [80 + u - 0.24 * v, 84 + 0.4 * v - h];
		const A = 34;
		const B = 11;
		const ell = (k: number, f: number) => {
			const al = (k * Math.PI) / 3;
			const ph = f * TAU;
			return [A * Math.cos(ph) * Math.cos(al) - B * Math.sin(ph) * Math.sin(al), A * Math.cos(ph) * Math.sin(al) + B * Math.sin(ph) * Math.cos(al)];
		};
		// the plan: [kind, duration, ...]
		type Seg = { d: number; on: boolean; pos: (f: number) => number[]; k?: number };
		const park = [0, -34];
		const lerp = (a: number[], b: number[]) => (f: number) => [a[0] + (b[0] - a[0]) * ease(f), a[1] + (b[1] - a[1]) * ease(f)];
		const plan: Seg[] = [];
		let at = park;
		for (let k = 0; k < 3; k++) {
			const s = ell(k, 0);
			plan.push({ d: 0.45, on: false, pos: lerp(at, s) });
			plan.push({ d: 2, on: true, pos: (f) => ell(k, f), k });
			at = s;
		}
		plan.push({ d: 0.45, on: false, pos: lerp(at, [0, 0]) });
		plan.push({ d: 0.7, on: true, pos: (f) => [2.6 * f * Math.cos(f * 18), 2.6 * f * Math.sin(f * 18)], k: 3 });
		plan.push({ d: 0.6, on: false, pos: lerp([0, 0], park) });
		plan.push({ d: 2.2, on: false, pos: () => park });
		plan.push({ d: 0.8, on: false, pos: () => park, k: -1 }); // the board is cleaned: the sign fades
		const total = plan.reduce((s, g) => s + g.d, 0);
		const lines = $$(svg, '[data-burn] polyline');
		const dot = $(svg, '[data-burn] circle');
		const burn = $(svg, '[data-burn]');
		const beam = $(svg, '[data-beam]');
		const beamLines = $$(beam, 'line');
		const spot = $(svg, '[data-spot]');
		const head = $(svg, '[data-head]');
		const gantry = $(svg, '[data-gantry]');
		const smoke = $$(svg, '[data-smoke] circle').map((e) => ({ e, age: 9, x: 0, y: 0 }));
		let si = 0;
		let st = 0;
		let t = 0;
		let lastSeg = -1;
		return (dt: number) => {
			t = (t + dt) % total;
			let i = 0;
			let s0 = 0;
			while (s0 + plan[i].d < t) s0 += plan[i++].d;
			const g = plan[i];
			const f = (t - s0) / g.d;
			if (i < lastSeg) {
				for (const l of lines) l.setAttribute('points', '');
				dot.setAttribute('r', '0');
				burn.setAttribute('opacity', '1');
			}
			lastSeg = i;
			const [u, v] = g.pos(f);
			// the burned lines: full for finished ellipses, partial for the current one
			for (let k = 0; k < 3; k++) {
				const done = g.k === k ? f : plan.findIndex((q) => q.k === k) < i ? 1 : 0;
				if (done <= 0) continue;
				const n = Math.max(2, Math.ceil(done * 72));
				const pts: string[] = [];
				for (let j = 0; j <= n; j++) {
					const [a, b] = ell(k, (j / n) * done);
					const [x, y] = P(a, b);
					pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
				}
				lines[k].setAttribute('points', pts.join(' '));
			}
			if (g.k === 3) dot.setAttribute('r', (2.8 * f).toFixed(2));
			if (g.k === -1) burn.setAttribute('opacity', (1 - f).toFixed(2));
			const [x, y] = P(u, v);
			const [hx, hy] = P(u, v, 36);
			head.setAttribute('transform', `translate(${hx.toFixed(1)} ${hy.toFixed(1)})`);
			const [gx1, gy1] = P(-58, v, 36);
			const [gx2, gy2] = P(58, v, 36);
			attrs(gantry, { x1: gx1, y1: gy1, x2: gx2, y2: gy2 });
			beam.setAttribute('opacity', g.on ? '1' : '0');
			for (const l of beamLines) attrs(l, { x1: hx, y1: hy + 9, x2: x, y2: y });
			attrs(spot, { cx: x, cy: y, opacity: g.on ? 0.55 + 0.3 * Math.random() : 0, r: 2.2 });
			st += dt;
			if (g.on && st > 0.12) {
				st = 0;
				Object.assign(smoke[si], { age: 0, x, y });
				si = (si + 1) % smoke.length;
			}
			for (const q of smoke) {
				q.age += dt;
				if (q.age > 1) {
					q.e.setAttribute('opacity', '0');
					continue;
				}
				attrs(q.e, { cx: q.x + 3 * q.age, cy: q.y - 12 * q.age, r: 0.6 + 1.6 * q.age, opacity: 0.3 * (1 - q.age) });
			}
		};
	};

	/** 4. Jupiter and its moons, edge-on: one day in 3 s. */
	const tele = (svg: SVGSVGElement) => {
		const moons = [
			[5.9, 1.769, 0.3],
			[9.39, 3.551, 2.2],
			[14.97, 7.155, 4.1],
			[26.33, 16.689, 5.6],
		];
		const dots = $$(svg, '.tech__moon');
		let days = 0;
		return (dt: number) => {
			days += dt / 3;
			moons.forEach(([a, P, ph], i) => {
				const q = (TAU * days) / P + ph;
				const x = 1.55 * a * Math.cos(q);
				const behind = Math.sin(q) < 0 && Math.abs(x) < 4.2;
				attrs(dots[i], { cx: 110 + x, cy: 52, opacity: behind ? 0 : 1 });
			});
		};
	};

	/** 5. Focusing: blurred → the knob turns for 1,6 s → sharp for 3,4 s. */
	const micro = (svg: SVGSVGElement) => {
		const blur = $(svg, '[data-blur]');
		const knob = $(svg, '[data-knob]');
		let t = 0;
		return (dt: number) => {
			t = (t + dt) % 6;
			const f = t < 0.6 ? 0 : t < 2.2 ? ease((t - 0.6) / 1.6) : t < 5.6 ? 1 : 1 - (t - 5.6) / 0.4;
			blur.setAttribute('stdDeviation', (2.6 * (1 - f)).toFixed(2));
			const turn = t < 0.6 ? 0 : t < 2.2 ? ease((t - 0.6) / 1.6) : 1;
			knob.setAttribute('transform', `rotate(${(turn * 220).toFixed(1)} 26 62)`);
		};
	};

	/** 6. The launch: ignition (shortened) and the climb with a = 4 м/с² in real time. */
	const rocket = (svg: SVGSVGElement) => {
		const K = 2.4;
		const T0 = 0.8; // ignition
		const T1 = 3.3; // lift-off
		const CYCLE = 11;
		const body = $(svg, '[data-rocket]');
		const flames = $(svg, '[data-flames]');
		const plume = $(svg, '[data-plume]');
		const inner = $$(svg, '[data-flamec]');
		const arms = $$(svg, '[data-arm]');
		const column = $(svg, '[data-column]');
		const clouds = $$(svg, '[data-clouds] circle');
		const cloudGroup = $(svg, '[data-clouds]');
		const flame = (c: number, len: number, w: number) => {
			const x = 80 + c * K;
			const y = 100 + 1.3 * K;
			const h = len * K;
			return `M${(x - w).toFixed(1)} ${y.toFixed(1)} Q${(x - w * 1.3).toFixed(1)} ${(y + h * 0.35).toFixed(1)} ${x.toFixed(1)} ${(y + h).toFixed(1)} Q${(x + w * 1.3).toFixed(1)} ${(y + h * 0.35).toFixed(1)} ${(x + w).toFixed(1)} ${y.toFixed(1)} Z`;
		};
		let t = 0;
		return (dt: number) => {
			t = (t + dt) % CYCLE;
			const ign = t < T0 ? 0 : Math.min(1, (t - T0) / (T1 - T0));
			const tau = Math.max(0, t - T1);
			const rise = 0.5 * 4 * tau * tau * K; // px
			body.setAttribute('transform', `translate(0 ${(-rise).toFixed(2)})`);
			const len = t < T0 ? 0 : (ign < 1 ? 6 * ign : 6 + 6 * Math.min(1, tau)) * (0.9 + 0.2 * Math.random());
			flames.setAttribute('opacity', t < T0 ? '0' : '1');
			plume.setAttribute('d', flame(0, len, 3.9 * K));
			inner.forEach((e) => e.setAttribute('d', flame(+e.dataset.flamec!, len * (0.5 + 0.1 * Math.random()), 0.9)));
			const swing = -32 * ease(tau / 1.2);
			for (const a of arms) {
				const s = +a.dataset.arm!;
				a.setAttribute('transform', `rotate(${(swing * -s).toFixed(1)} ${a.dataset.px} ${a.dataset.py})`);
			}
			// the column of exhaust from the pad to the rocket
			const top = 100 + 1.3 * K + len * K - rise;
			const ch = Math.max(0, 104 - Math.max(0, top));
			attrs(column, { y: 104 - ch, height: tau > 0 ? ch : 0, width: 10 + 6 * Math.min(1, tau / 2), x: 75 - 3 * Math.min(1, tau / 2) });
			const fade = t > 9.6 ? 1 - (t - 9.6) / 1.4 : 1;
			column.setAttribute('opacity', (0.5 * fade).toFixed(2));
			cloudGroup.setAttribute('opacity', fade.toFixed(2));
			for (const c of clouds) {
				const g = Math.max(0, (t - T0 - +c.dataset.delay!) / 2.5);
				c.setAttribute('r', (+c.dataset.r! * Math.min(1.5, Math.sqrt(g))).toFixed(2));
				c.setAttribute('cx', (+c.dataset.x! + +c.dataset.side! * 3 * Math.sqrt(g)).toFixed(2));
			}
		};
	};

	const make: Record<string, (svg: SVGSVGElement) => (dt: number) => void> = { steam, el, laser, tele, micro, rocket };
	for (const root of document.querySelectorAll('[data-techpic]')) {
		const steps = [...root.querySelectorAll<SVGSVGElement>('svg[data-panel]')].map((svg) => make[svg.dataset.panel!](svg));
		for (const s of steps) s(0);
		loop(root, (dt) => {
			for (const s of steps) s(dt);
			return true;
		});
	}
</script>
