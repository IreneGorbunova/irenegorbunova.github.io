---
/**
 * Picture «Как учёный узнаёт закон»: four panels with one scientist (Irina, 17 Nov 2026: наблюдение → гипотеза →
 * опыт → закон и теория, together with the Newton tube).
 *  1. Наблюдение: an apple and a feather leave a branch 2,5 м high at the same moment (30 px per metre). The apple
 *     (d = 7 см, 150 г, C = 0,47) falls 2,15 м in 0,66 с; the feather settles at 0,8 м/с, as in FallLab, and needs
 *     2,97 с for its 2,33 м. Shown 2 times slower than in life.
 *  2. Гипотеза: a thought bubble, air pushing up on the feather.
 *  3. Опыт: two Newton tubes, 0,93 м of fall (100 px per metre). With air: a lead shot d = 4 мм (υ∞ = 32 м/с) 0,44 с,
 *     a piece of cork 1 × 1 см (240 кг/м³, C = 1, υ∞ = 5,5 м/с) 0,46 с, the feather 1,22 с. Air pumped out: all three
 *     in 0,44 с. Shown 4 times slower than in life. The fall follows m·a = m·g − ½·ρ·C·A·υ² (ρ = 1,2 кг/м³).
 *  4. Закон и теория: the law on a blackboard.
 */
import G7Styles from '../g7/G7Styles.astro';
import Sci from './NaukaScientist.astro';

const GY = 150; // the floor of every panel
// the scientist standing at x on the floor; dir 1 looks right, −1 left; arms: a path of his two arms
const sci = (x: number, dir: 1 | -1, arms: string) => ({
	head: { cx: x, cy: GY - 58 },
	eye: { cx: x + 3.2 * dir, cy: GY - 58.5 },
	hair: `M${x - 8.4} ${GY - 59} A8.4 8.4 0 0 1 ${x + 8.4} ${GY - 59} Q${x + 4 * dir} ${GY - 63} ${x - 8.4} ${GY - 59} Z`,
	coat: `M${x - 6} ${GY - 49} L${x + 6} ${GY - 49} L${x + 10} ${GY - 18} L${x - 10} ${GY - 18} Z`,
	legs: `M${x - 4} ${GY - 18} L${x - 5} ${GY} M${x + 4} ${GY - 18} L${x + 5} ${GY}`,
	arms,
});
const S1 = sci(36, 1, `M31 104 L27 124 M41 104 L48 114 L52 108`);
const S2 = sci(36, 1, `M31 104 L27 124 M41 104 L47 114 L40 98`);
const S3 = sci(182, -1, `M187 104 L191 124 M177 104 L170 109 L161 97`);
const S4 = sci(36, 1, `M31 104 L27 124 M41 104 L52 94 L64 84`);

const feather = 'M-7 1.4 Q-3 -3.2 5 -2 Q7.5 -1.5 8 -0.2 Q3.5 2.6 -3 2.2 Z M-7 1.4 L8 -0.2';
---

<G7Styles />
<figure class="g7 g7--pic nk not-content" data-nauka>
	<div class="nk__grid">
		<div class="nk__cell">
			<p class="nk__h"><span class="nk__n">1</span>Наблюдение</p>
			<svg class="g7__svg" viewBox="0 0 200 165" role="img" aria-label="Учёный смотрит, как с ветки одновременно падают яблоко и перо: яблоко быстро долетает до земли, а перо медленно опускается, покачиваясь">
				<line class="nk__floor" x1="6" y1={GY} x2="194" y2={GY}></line>
				<rect class="nk__trunk" x="154" y="70" width="8" height={GY - 70} rx="2"></rect>
				<line class="nk__branch" x1="156" y1="80" x2="112" y2="74"></line>
				<circle class="nk__leaves" cx="158" cy="46" r="30"></circle>
				<circle class="nk__leaves" cx="132" cy="58" r="19"></circle>
				<circle class="nk__leaves" cx="182" cy="62" r="16"></circle>
				<g data-apple><line class="nk__stem" x1="0" y1="-5.5" x2="1" y2="-9"></line><circle class="nk__apple" r="5.5"></circle></g>
				<g data-feather1><path class="nk__feather" d={feather} transform="scale(1.4)"></path></g>
				<Sci s={S1} />
				<rect class="nk__book" x="48" y="102" width="8" height="10" rx="1" transform="rotate(-20 52 107)"></rect>
			</svg>
			<p class="nk__cap">Учёный замечает: яблоко падает быстро, а перо — медленно.</p>
		</div>
		<div class="nk__cell">
			<p class="nk__h"><span class="nk__n">2</span>Гипотеза</p>
			<svg class="g7__svg" viewBox="0 0 200 165" role="img" aria-label="Учёный задумался. В облачке его мысли: перо снизу подпирает воздух">
				<line class="nk__floor" x1="6" y1={GY} x2="194" y2={GY}></line>
				<circle class="nk__bubble" cx="56" cy="80" r="3"></circle>
				<circle class="nk__bubble" cx="66" cy="70" r="5"></circle>
				<ellipse class="nk__bubble" cx="130" cy="62" rx="62" ry="46"></ellipse>
				<path class="nk__feather" d={feather} transform="translate(130 50) scale(3.2)"></path>
				{
					[108, 130, 152].map((x) => (
						<g class="nk__air">
							<line x1={x} y1="88" x2={x} y2="66" />
							<path d={`M${x - 5} 72 L${x} 64 L${x + 5} 72`} />
						</g>
					))
				}
				<text class="nk__label" x="130" y="102" text-anchor="middle">воздух</text>
				<Sci s={S2} />
			</svg>
			<p class="nk__cap">Он предполагает: перо тормозит воздух, а без воздуха все тела падали бы одинаково.</p>
		</div>
		<div class="nk__cell">
			<p class="nk__h"><span class="nk__n">3</span>Опыт</p>
			<svg class="g7__svg" viewBox="0 0 200 165" role="img" aria-label="Две трубки Ньютона с дробинкой, пробкой и пером. В трубке с воздухом перо падает последним. Из второй трубки воздух откачан насосом, и все три тела падают вместе">
				<line class="nk__floor" x1="6" y1={GY} x2="194" y2={GY}></line>
				<text class="nk__label" x="36" y="14" text-anchor="middle">с воздухом</text>
				<text class="nk__label" x="108" y="14" text-anchor="middle">без воздуха</text>
				<path class="nk__table" d="M14 134 H130 M20 134 V150 M124 134 V150"></path>
				{
					[36, 108].map((x, i) => (
						<>
							<rect class={i ? 'nk__tube is-empty' : 'nk__tube'} x={x - 13} y="22" width="26" height="112" rx="5" />
							<rect class="nk__cap-end" x={x - 13} y="22" width="26" height="6" rx="2" />
							<rect class="nk__cap-end" x={x - 13} y="128" width="26" height="6" rx="2" />
						</>
					))
				}
				<path class="nk__hose" d="M121 131 Q141 131 141 140 L146 142"></path>
				<rect class="nk__pump" x="146" y="108" width="12" height={GY - 108} rx="2"></rect>
				<path class="nk__rod" d="M152 108 V96 M142 96 H162"></path>
				{
					[36, 108].map((x, i) => (
						<g data-tube={i}>
							<circle class="nk__shot" r="2.6" data-x={x - 8.5} />
							<rect class="nk__cork" x="-2.5" y="-7" width="5" height="7" rx="1" data-x={x - 2} />
							<path class="nk__feather" d={feather} data-x={x + 6} data-s="0.85" />
						</g>
					))
				}
				<Sci s={S3} />
			</svg>
			<p class="nk__cap">Он проверяет гипотезу в трубке Ньютона: с воздухом перо отстаёт, без воздуха дробинка, пробка и перо падают вместе.</p>
		</div>
		<div class="nk__cell">
			<p class="nk__h"><span class="nk__n">4</span>Закон и теория</p>
			<svg class="g7__svg" viewBox="0 0 200 165" role="img" aria-label="Учёный показывает на доску, где написан закон: без воздуха все тела падают одинаково">
				<line class="nk__floor" x1="6" y1={GY} x2="194" y2={GY}></line>
				<path class="nk__table" d="M84 112 L80 150 M180 112 L184 150"></path>
				<rect class="nk__board" x="70" y="20" width="124" height="94" rx="4"></rect>
				<text class="nk__chalk nk__chalk--title" x="132" y="40" text-anchor="middle">Закон</text>
				<text class="nk__chalk" x="132" y="62" text-anchor="middle">Без воздуха</text>
				<text class="nk__chalk" x="132" y="80" text-anchor="middle">все тела падают</text>
				<text class="nk__chalk" x="132" y="98" text-anchor="middle">одинаково</text>
				<Sci s={S4} />
			</svg>
			<p class="nk__cap">Гипотеза, много раз подтверждённая опытом, становится законом. Законы объединяют в теорию.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Падение показано медленнее, чем в жизни: у яблони в 2 раза, в трубках в 4 раза.</figcaption>
</figure>

<script>
	import { loop } from '../g7/kit';

	const G = 9.8;
	const CYCLE = 9; // s of the picture's own clock
	const PRE = 0.8;
	// the distance fallen after t s when a = g − k·υ², and the time of a fall of h metres
	const fallen = (k: number, t: number) => {
		if (t <= 0) return 0;
		if (!k) return (G * t * t) / 2;
		const z = t * Math.sqrt(G * k);
		return (z + Math.log1p(Math.exp(-2 * z)) - Math.LN2) / k;
	};
	const landing = (k: number, h: number) => (k ? Math.acosh(Math.exp(k * h)) / Math.sqrt(G * k) : Math.sqrt((2 * h) / G));
	const pos = (k: number, h: number, t: number) => Math.min(h, fallen(k, Math.min(t, landing(k, h))));

	const ball = (m: number, c: number, a: number) => (1.2 * c * a) / (2 * m);
	const K_APPLE = ball(0.15, 0.47, Math.PI * 0.035 ** 2);
	const K_FEATHER = G / 0.8 ** 2;
	const K_SHOT = ball(11340 * (Math.PI / 6) * 0.004 ** 3, 0.47, Math.PI * 0.002 ** 2);
	const K_CORK = ball(240 * Math.PI * 0.005 ** 2 * 0.01, 1, 1e-4);

	for (const root of document.querySelectorAll<HTMLElement>('[data-nauka]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const apple = q<SVGGElement>('[data-apple]');
		const feather1 = q<SVGGElement>('[data-feather1]');
		const tubes = [0, 1].map((i) => [...q<SVGGElement>(`[data-tube="${i}"]`).children] as SVGGraphicsElement[]);
		let t = 0;

		// panel 1: 30 px per metre, shown 2 times slower
		const A0 = 85.5; // the apple's bottom on the branch
		const F0 = 78; // the feather on the branch
		const draw1 = (s: number) => {
			const ya = pos(K_APPLE, (150 - A0) / 30, s) * 30;
			apple.setAttribute('transform', `translate(124 ${(A0 - 5.5 + ya).toFixed(1)})`);
			const hf = (148 - F0) / 30;
			const yf = pos(K_FEATHER, hf, s) * 30;
			const flying = yf < hf * 30 - 0.01 && s > 0;
			const w = flying ? Math.sin((2 * Math.PI * s) / 1.4) : 0;
			feather1.setAttribute('transform', `translate(${(104 + 6 * w).toFixed(1)} ${(F0 + yf).toFixed(1)}) rotate(${(16 * w).toFixed(1)})`);
		};
		// panel 3: 100 px per metre, shown 4 times slower; the bodies start with their bottoms at y = 35, under the cap,
		// and land on the bottom cap at y = 128
		const H = 0.93;
		const ks = [
			[K_SHOT, K_CORK, K_FEATHER],
			[0, 0, 0],
		];
		const lift = [2.6, 0, 2]; // from a body's bottom to its own origin
		const draw3 = (s: number) => {
			tubes.forEach((bodies, i) =>
				bodies.forEach((b, j) => {
					const y = 35 + pos(ks[i][j], H, s) * 100 - lift[j];
					b.setAttribute('transform', `translate(${b.dataset.x} ${y.toFixed(1)})${b.dataset.s ? ` scale(${b.dataset.s})` : ''}`);
				}),
			);
		};
		const draw = () => {
			const s = Math.max(0, t - PRE);
			draw1(s / 2);
			draw3(s / 4);
		};
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		})();
		draw();
	}
</script>

<style is:global>
	.nk__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem 0.75rem;
	}
	.nk__h {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.35rem;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.nk__n {
		display: inline-grid;
		place-items: center;
		flex: none;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 50%;
		background: var(--g7-gold);
		color: var(--sl-color-black);
		font-size: var(--sl-text-xs);
	}
	.nk__cap {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.35;
		color: var(--sl-color-gray-2);
	}
	.nk__floor {
		stroke: var(--g7-line);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.nk__trunk {
		fill: var(--g7-wood);
	}
	.nk__branch {
		stroke: var(--g7-wood);
		stroke-width: 3.5;
		stroke-linecap: round;
	}
	.nk__leaves {
		fill: color-mix(in srgb, var(--g7-green) 32%, transparent);
	}
	.nk__apple {
		fill: var(--g7-red);
	}
	.nk__stem {
		stroke: var(--g7-wood-dark);
		stroke-width: 1.5;
	}
	.nk__feather {
		fill: color-mix(in oklab, var(--sl-color-white) 80%, var(--ig-vx));
		stroke: var(--g7-line);
		stroke-width: 0.6;
		vector-effect: non-scaling-stroke;
	}
	.nk__book {
		fill: var(--g7-paper);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.nk__bubble {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.nk__air line,
	.nk__air path {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.nk__air {
		animation: nk-air 1.6s ease-in-out infinite alternate;
	}
	@keyframes nk-air {
		to {
			transform: translateY(-3px);
		}
	}
	.nk__tube {
		fill: color-mix(in srgb, var(--ig-vx) 9%, transparent);
		stroke: var(--g7-glass);
		stroke-width: 1.5;
	}
	.nk__tube.is-empty {
		fill: transparent;
		stroke-dasharray: 5 3;
	}
	.nk__cap-end {
		fill: var(--g7-steel-dark);
	}
	.nk__table,
	.nk__rod {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.nk__rod {
		stroke: var(--g7-steel-dark);
	}
	.nk__hose {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.nk__pump {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.nk__shot {
		fill: var(--g7-ink);
	}
	.nk__cork {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.nk__board {
		fill: hsl(160, 22%, 20%);
		stroke: var(--g7-wood);
		stroke-width: 4;
	}
	.g7__svg .nk__label {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .nk__chalk {
		font-size: 13.5px;
		fill: hsl(60, 20%, 94%);
	}
	.g7__svg .nk__chalk--title {
		font-size: 12px;
		font-weight: 700;
		fill: var(--ig-v);
	}
	:root[data-theme='light'] .g7__svg .nk__chalk--title {
		fill: hsl(42, 90%, 62%);
	}
	.nk__head {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 1.1;
	}
	.nk__hair {
		fill: var(--sl-color-gray-3);
	}
	.nk__eye {
		fill: var(--g7-ink);
	}
	.nk__coat {
		fill: color-mix(in oklab, var(--sl-color-white) 88%, var(--ig-vx));
		stroke: var(--g7-ink);
		stroke-width: 1.1;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .nk__coat {
		fill: hsl(220, 30%, 97%);
	}
	:root[data-theme='light'] .nk__feather {
		fill: hsl(210, 35%, 90%);
		stroke: var(--sl-color-gray-3);
	}
	.nk__limbs {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	@container (max-width: 30rem) {
		.nk__grid {
			gap: 0.75rem 0.5rem;
		}
	}
</style>
