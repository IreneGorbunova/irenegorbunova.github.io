---
/**
 * Picture «Физические явления»: six small looping panels, one for each kind the school course names: a rolling ball
 * (mechanical), a boiling kettle (thermal), a ringing bell (sound), lightning (electric), a compass needle turning to
 * a magnet (magnetic), a rainbow (light). The magnet's north pole is blue, the south pole red, as everywhere on the site.
 */
import G7Styles from '../g7/G7Styles.astro';

const panels = [
	{ key: 'mech', name: 'Механические', ex: 'мяч катится, машина едет, Земля обращается вокруг Солнца' },
	{ key: 'heat', name: 'Тепловые', ex: 'вода закипает, лёд тает, утюг нагревается' },
	{ key: 'sound', name: 'Звуковые', ex: 'звенит звонок, гремит гром, поёт птица' },
	{ key: 'el', name: 'Электрические', ex: 'сверкает молния, горит лампа, искрит свитер' },
	{ key: 'mag', name: 'Магнитные', ex: 'магнит притягивает гвозди, стрелка компаса показывает на север' },
	{ key: 'light', name: 'Световые', ex: 'светит Солнце, появляется радуга, предметы отбрасывают тень' },
];
---

<G7Styles />
<figure class="g7 g7--pic phen not-content">
	<div class="phen__grid">
		{
			panels.map((p) => (
				<div class="phen__cell">
					<svg class="g7__svg" viewBox="0 0 120 84" role="img" aria-label={`${p.name} явления: ${p.ex}`}>
						{p.key === 'mech' && (
							<>
								<line class="phen__floor" x1="6" y1="66" x2="114" y2="66" />
								<g class="phen__roll">
									<circle class="phen__ball" cx="0" cy="54" r="12" />
									<path class="phen__ballmark" d="M-12 54 H12 M0 42 V66" />
								</g>
							</>
						)}
						{p.key === 'heat' && (
							<>
								<path class="phen__kettle" d="M34 40 H78 L84 68 H28 Z" />
								<path class="phen__kettle-line" d="M78 46 L96 38 L98 42 L82 56 M40 40 Q56 22 72 40" />
								<rect class="phen__stove" x="20" y="68" width="72" height="8" rx="2" />
								<path class="phen__flame" d="M40 68 q4 -8 8 0 M52 68 q4 -8 8 0 M64 68 q4 -8 8 0" />
								<path class="phen__steam phen__steam--a" d="M98 32 q-5 -6 0 -12 q5 -6 0 -12" />
								<path class="phen__steam phen__steam--b" d="M108 34 q-5 -6 0 -12 q5 -6 0 -12" />
							</>
						)}
						{p.key === 'sound' && (
							<>
								<g class="phen__bell">
									<path class="phen__bellbody" d="M60 20 q-16 4 -16 30 l-5 8 h42 l-5 -8 q0 -26 -16 -30 z" />
									<circle class="phen__clapper" cx="60" cy="62" r="4" />
								</g>
								<line class="phen__kettle-line" x1="60" y1="8" x2="60" y2="20" />
								<path class="phen__wave phen__wave--a" d="M88 30 q10 14 0 28 M32 30 q-10 14 0 28" />
								<path class="phen__wave phen__wave--b" d="M98 24 q14 20 0 40 M22 24 q-14 20 0 40" />
								<path class="phen__wave phen__wave--c" d="M108 18 q18 26 0 52 M12 18 q-18 26 0 52" />
							</>
						)}
						{p.key === 'el' && (
							<>
								<rect class="phen__night" x="0" y="0" width="120" height="84" rx="7" />
								<path class="phen__cloud" d="M26 30 q-12 0 -12 -10 q0 -10 12 -10 q4 -8 16 -6 q8 -8 20 -2 q14 -4 18 8 q14 0 14 10 q0 10 -14 10 z" />
								<path class="phen__bolt" d="M58 30 L48 48 L58 48 L46 74 L70 44 L60 44 L68 30 Z" />
								<line class="phen__ground" x1="6" y1="76" x2="114" y2="76" />
							</>
						)}
						{p.key === 'mag' && (
							<>
								<g class="phen__magnet">
									<rect class="phen__n" x="0" y="-9" width="24" height="18" />
									<rect class="phen__s" x="24" y="-9" width="24" height="18" />
									<text class="phen__pole" x="12" y="4" text-anchor="middle">N</text>
									<text class="phen__pole" x="36" y="4" text-anchor="middle">S</text>
								</g>
								<circle class="phen__dial" cx="34" cy="42" r="24" />
								<g class="phen__needle">
									<path class="phen__n" d="M34 42 m0 -5 l18 5 l-18 5 z" />
									<path class="phen__s" d="M34 42 m0 -5 l-18 5 l18 5 z" />
								</g>
								<circle class="phen__pin" cx="34" cy="42" r="2.4" />
							</>
						)}
						{p.key === 'light' && (
							<>
								{['hsl(0,80%,60%)', 'hsl(30,90%,58%)', 'hsl(52,95%,56%)', 'hsl(130,60%,48%)', 'hsl(205,80%,58%)', 'hsl(265,60%,62%)'].map((c, i) => (
									<path class="phen__bow" style={`stroke:${c};animation-delay:${i * 0.12}s`} d={`M${16 + i * 4.5} 70 A${44 - i * 4.5} ${44 - i * 4.5} 0 0 1 ${104 - i * 4.5} 70`} />
								))}
								<path class="phen__hill" d="M0 84 V70 Q30 60 60 70 T120 68 V84 Z" />
								<circle class="phen__sun" cx="104" cy="16" r="8" />
							</>
						)}
					</svg>
					<p class="phen__name">{p.name}</p>
					<p class="phen__ex">{p.ex}</p>
				</div>
			))
		}
	</div>
</figure>

<style is:global>
	.phen__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.phen__name {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.phen__ex {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.35;
		color: var(--sl-color-gray-2);
	}
	.phen__floor,
	.phen__ground {
		stroke: var(--g7-line);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.phen__ball {
		fill: var(--g7-gold);
	}
	.phen__ballmark {
		stroke: color-mix(in oklab, var(--ig-v) 50%, black);
		stroke-width: 1.5;
		fill: none;
	}
	.phen__roll {
		animation: phen-roll 3.2s ease-in-out infinite alternate;
	}
	.phen__roll > * {
		transform-box: fill-box;
		transform-origin: center;
		animation: phen-spin 3.2s ease-in-out infinite alternate;
	}
	@keyframes phen-roll {
		from {
			transform: translateX(22px);
		}
		to {
			transform: translateX(98px);
		}
	}
	/* 76 px along the floor with a radius of 12 px: 76 / 12 rad = 363° */
	@keyframes phen-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(363deg);
		}
	}
	.phen__kettle {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.phen__kettle-line {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.phen__stove {
		fill: var(--g7-steel-dark);
	}
	.phen__flame {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.phen__steam {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2.2;
		stroke-linecap: round;
		opacity: 0;
		animation: phen-steam 2.4s linear infinite;
	}
	.phen__steam--b {
		animation-delay: 1.2s;
	}
	@keyframes phen-steam {
		0% {
			opacity: 0;
			transform: translateY(8px);
		}
		30% {
			opacity: 0.9;
		}
		100% {
			opacity: 0;
			transform: translateY(-8px);
		}
	}
	.phen__bell {
		transform-origin: 60px 20px;
		animation: phen-ring 0.9s ease-in-out infinite alternate;
	}
	.phen__bellbody {
		fill: var(--g7-gold);
		stroke: color-mix(in oklab, var(--ig-v) 50%, black);
		stroke-width: 1;
	}
	.phen__clapper {
		fill: color-mix(in oklab, var(--ig-v) 50%, black);
	}
	@keyframes phen-ring {
		from {
			transform: rotate(-9deg);
		}
		to {
			transform: rotate(9deg);
		}
	}
	.phen__wave {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.8;
		stroke-linecap: round;
		opacity: 0;
		animation: phen-wave 1.8s linear infinite;
	}
	.phen__wave--b {
		animation-delay: 0.3s;
	}
	.phen__wave--c {
		animation-delay: 0.6s;
	}
	@keyframes phen-wave {
		0% {
			opacity: 0;
		}
		25% {
			opacity: 1;
		}
		70% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	.phen__night {
		fill: hsl(232, 40%, 14%);
	}
	.phen__cloud {
		fill: hsl(230, 18%, 46%);
	}
	.phen__bolt {
		fill: hsl(52, 100%, 70%);
		animation: phen-bolt 2.6s steps(1) infinite;
	}
	.phen .phen__ground {
		stroke: hsl(230, 18%, 46%);
	}
	@keyframes phen-bolt {
		0% {
			opacity: 0;
		}
		60% {
			opacity: 1;
		}
		66% {
			opacity: 0;
		}
		70% {
			opacity: 1;
		}
		82% {
			opacity: 0;
		}
	}
	.phen__n {
		fill: var(--ig-vx);
	}
	.phen__s {
		fill: var(--ig-vy);
	}
	.phen .phen__pole {
		font-size: 11px;
		font-weight: 700;
		fill: white;
	}
	.phen__dial {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-line);
		stroke-width: 1.5;
	}
	.phen__pin {
		fill: var(--g7-ink);
	}
	/* the magnet comes and goes; the needle's north (blue) end turns to the magnet's south pole and back to the north */
	.phen__magnet {
		animation: phen-magnet 5s ease-in-out infinite;
	}
	.phen__needle {
		transform-origin: 34px 42px;
		animation: phen-needle 5s ease-in-out infinite;
	}
	@keyframes phen-magnet {
		0%,
		12% {
			transform: translate(130px, 42px);
		}
		30%,
		70% {
			transform: translate(68px, 42px);
		}
		88%,
		100% {
			transform: translate(130px, 42px);
		}
	}
	@keyframes phen-needle {
		0%,
		14% {
			transform: rotate(-90deg);
		}
		34% {
			transform: rotate(8deg);
		}
		40% {
			transform: rotate(-5deg);
		}
		46%,
		68% {
			transform: rotate(0deg);
		}
		90%,
		100% {
			transform: rotate(-90deg);
		}
	}
	.phen__bow {
		fill: none;
		stroke-width: 4.5;
		stroke-dasharray: 150;
		stroke-dashoffset: 150;
		animation: phen-bow 5s ease-out infinite;
	}
	@keyframes phen-bow {
		0% {
			stroke-dashoffset: 150;
		}
		45%,
		85% {
			stroke-dashoffset: 0;
			opacity: 1;
		}
		100% {
			stroke-dashoffset: 0;
			opacity: 0;
		}
	}
	.phen__hill {
		fill: color-mix(in oklab, hsl(110, 40%, 40%) 70%, var(--sl-color-bg));
	}
	.phen__sun {
		fill: hsl(45, 100%, 60%);
	}
	@container (max-width: 34rem) {
		.phen__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
