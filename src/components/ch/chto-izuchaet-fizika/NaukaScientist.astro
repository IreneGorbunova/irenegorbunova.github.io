---
/** The scientist of NaukaPicture.astro inside an SVG: legs, coat, arms, head, hair, eye (coordinates from `sci()`). */
interface Props {
	s: { head: { cx: number; cy: number }; eye: { cx: number; cy: number }; hair: string; coat: string; legs: string; arms: string };
}
const { s } = Astro.props;
---

<g aria-hidden="true">
	<path class="nk__limbs" d={s.legs}></path>
	<path class="nk__coat" d={s.coat}></path>
	<path class="nk__limbs" d={s.arms}></path>
	<circle class="nk__head" cx={s.head.cx} cy={s.head.cy} r="8"></circle>
	<path class="nk__hair" d={s.hair}></path>
	<circle class="nk__eye" cx={s.eye.cx} cy={s.eye.cy} r="1.1"></circle>
</g>
