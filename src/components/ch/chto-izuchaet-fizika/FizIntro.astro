---
/**
 * Two short looping opening scenes of «Что изучает физика». No terms of the chapter in the pictures.
 * Storm: lightning strikes 2 км away. The flash is seen at once, and the thunder comes 6 с later: the sound front
 *   moves across the picture in the real 6 seconds (sound covers a kilometer in about 3 с). The distance axis is
 *   to scale (116 px per kilometer); the house and the cloud are not.
 * Fall: two cast-iron balls, 10 кг and 1 кг, are let go from a tower 45 м high and fall in real time:
 *   s = g·t²/2 with g = 9,8 м/с², 3,03 с to the ground (in air such balls differ by centimeters, far less than
 *   the picture can show). The height axis is to scale (4 px per metre); the balls are drawn larger.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

let seed = 5;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const stars = Array.from({ length: 26 }, () => [Math.round(rnd() * 3600) / 10, Math.round(rnd() * 900) / 10, rnd() < 0.2 ? 1.2 : 0.7]);
const uid = Math.random().toString(36).slice(2, 8);
const clip = `fz-clip-${uid}`;
---

<IntroFrame data-fizintro>
	<div class="intro__card" data-scene="storm">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Гроза: вдали вспыхивает молния, а гром доходит до дома только через шесть секунд">
			<defs>
				<clipPath id={clip}>
					<rect x="0" y="0" width="360" height="196"></rect>
				</clipPath>
			</defs>
			<rect class="fz-night" x="0" y="0" width="360" height="240"></rect>
			<rect class="fz-flash" data-flash x="0" y="0" width="360" height="240"></rect>
			{stars.map(([x, y, r]) => <circle class="fz-star" cx={x} cy={y} r={r} />)}
			<path class="fz-cloud" d="M232 70 q-22 0 -22 -18 q0 -18 22 -18 q8 -16 30 -12 q14 -14 36 -4 q26 -6 32 14 q24 0 24 19 q0 19 -24 19 z"></path>
			<path class="fz-bolt" data-bolt d="M292 70 L280 104 L294 104 L276 150 L286 150 L270 194 L306 138 L294 138 L312 100 L298 100 L308 70 Z"></path>
			<!-- the sound on its way -->
			<g clip-path={`url(#${clip})`}>
				<circle class="fz-sound" data-s1 cx="290" cy="150" r="0"></circle>
				<circle class="fz-sound fz-sound--2" data-s2 cx="290" cy="150" r="0"></circle>
				<circle class="fz-sound fz-sound--3" data-s3 cx="290" cy="150" r="0"></circle>
			</g>
			<rect class="fz-land" x="0" y="196" width="360" height="44"></rect>
			<!-- the house -->
			<path class="fz-house" d="M36 196 V166 L58 148 L80 166 V196 Z"></path>
			<rect class="fz-window" data-window x="50" y="172" width="16" height="14"></rect>
			<path class="fz-shake" data-shake d="M28 150 l-8 -6 M88 150 l8 -6 M58 138 v-10"></path>
			<!-- the distance -->
			<line class="fz-axis" x1="58" y1="212" x2="290" y2="212"></line>
			<path class="fz-axis" d="M58 208 v8 M174 208 v8 M290 208 v8"></path>
			<text class="fz-small" x="58" y="230" text-anchor="middle">0</text>
			<text class="fz-small" x="174" y="230" text-anchor="middle">1 км</text>
			<text class="fz-small" x="290" y="230" text-anchor="middle">2 км</text>
			<rect class="fz-pill" x="10" y="10" width="150" height="40" rx="9"></rect>
			<text class="fz-small" x="20" y="26">после вспышки</text>
			<text class="fz-num" data-clock x="20" y="43">—</text>
		</svg>
		<div class="intro__foot">
			<p>
				Молния уже погасла, а гром приходит только через несколько секунд:{' '}
				<More term="свет летит намного быстрее звука">
					Свет доходит до нас почти мгновенно, а звук проходит километр примерно за три секунды. Если между вспышкой и громом шесть секунд, молния ударила в двух километрах. В грозе сразу несколько физических явлений: электрическое (молния — огромная искра), световое (вспышка), звуковое (гром). О них — в разделе{' '}
					<a href="#что-изучает-физика">«Что изучает физика»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="fall">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="С башни высотой 45 метров одновременно отпускают два чугунных шара: 10 килограммов и 1 килограмм. Они падают рядом и достигают земли вместе через 3 секунды">
			<rect class="fz-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="fz-ground" x="0" y="216" width="360" height="24"></rect>
			<!-- the tower, 45 м: 180 px -->
			<path class="fz-tower" d="M60 216 V44 h-6 v-14 h10 v6 h10 v-6 h10 v6 h10 v-6 h10 v6 h10 v-6 h10 v14 h-6 V216 Z"></path>
			<path class="fz-tower-line" d="M60 80 h64 M60 124 h64 M60 168 h64"></path>
			<rect class="fz-tower-win" x="86" y="56" width="12" height="16" rx="6"></rect>
			<rect class="fz-tower-win" x="86" y="98" width="12" height="16" rx="6"></rect>
			<rect class="fz-tower-win" x="86" y="142" width="12" height="16" rx="6"></rect>
			<path class="fz-beam" d="M124 36 H196"></path>
			<!-- the height axis -->
			<line class="fz-rule" x1="230" y1="36" x2="230" y2="216"></line>
			{[0, 10, 20, 30, 40].map((h) => <path class="fz-rule" d={`M226 ${216 - h * 4} h8`} />)}
			{[0, 10, 20, 30, 40].map((h) => <text class="fz-small fz-small--ink" x="238" y={216 - h * 4 + 4}>{h} м</text>)}
			<path class="fz-rule" d="M226 36 h8"></path>
			<text class="fz-small fz-small--ink" x="238" y="40">45 м</text>
			<circle class="fz-ball" data-big cx="150" cy="29" r="7"></circle>
			<circle class="fz-ball" data-small cx="178" cy="32" r="4"></circle>
			<text class="fz-small fz-small--ink" x="146" y="14" text-anchor="middle">10 кг</text>
			<text class="fz-small fz-small--ink" x="182" y="14" text-anchor="middle">1 кг</text>
			<rect class="fz-pill fz-pill--day" x="272" y="10" width="78" height="40" rx="9"></rect>
			<text class="fz-small fz-small--day" x="282" y="26">время</text>
			<text class="fz-num fz-num--day" data-clock x="282" y="43">0,0 с</text>
		</svg>
		<div class="intro__foot">
			<p>
				Чугунные шары в 10&nbsp;кг и в 1&nbsp;кг отпустили с башни одновременно. Упали они{' '}
				<More term="тоже одновременно">
					Две тысячи лет люди были уверены, что тяжёлое тело падает быстрее лёгкого: это казалось очевидным. В конце XVI&nbsp;века Симон Стевин и Галилео Галилей проверили это на опыте — и оказалось, что это не так. С тех пор в физике любое утверждение проверяют опытом. Об этом — в разделе{' '}
					<a href="#наблюдения-и-опыты">«Наблюдения и опыты»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-fizintro] .fz-night {
		fill: hsl(232, 44%, 10%);
	}
	[data-fizintro] .fz-flash {
		fill: hsl(220, 80%, 88%);
		opacity: 0;
	}
	[data-fizintro] .fz-star {
		fill: hsl(45, 40%, 92%);
		opacity: 0.8;
	}
	[data-fizintro] .fz-cloud {
		fill: hsl(230, 16%, 34%);
	}
	[data-fizintro] .fz-bolt {
		fill: hsl(52, 100%, 78%);
		opacity: 0;
	}
	[data-fizintro] .fz-sound {
		fill: none;
		stroke: hsl(200, 90%, 72%);
		stroke-width: 2.2;
		opacity: 0;
	}
	[data-fizintro] .fz-sound--2 {
		stroke-width: 1.5;
	}
	[data-fizintro] .fz-sound--3 {
		stroke-width: 1;
	}
	[data-fizintro] .fz-land {
		fill: hsl(232, 36%, 5%);
	}
	[data-fizintro] .fz-house {
		fill: hsl(232, 24%, 20%);
		stroke: hsl(232, 20%, 34%);
		stroke-width: 1;
	}
	[data-fizintro] .fz-window {
		fill: hsl(45, 90%, 64%);
	}
	[data-fizintro] .fz-shake {
		fill: none;
		stroke: hsl(200, 90%, 72%);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0;
	}
	[data-fizintro] .fz-axis {
		fill: none;
		stroke: hsl(230, 20%, 66%);
		stroke-width: 1.2;
	}
	[data-fizintro] .fz-small {
		font-size: 10px;
		fill: hsl(230, 20%, 78%);
	}
	[data-fizintro] .fz-pill {
		fill: hsl(232 45% 16% / 0.86);
	}
	[data-fizintro] .fz-num {
		font-size: 13px;
		font-weight: 700;
		fill: hsl(42, 90%, 72%);
	}
	[data-fizintro] .fz-sky {
		fill: var(--sl-color-bg);
	}
	[data-fizintro] .fz-ground {
		fill: color-mix(in oklab, hsl(110, 30%, 40%) 60%, var(--sl-color-bg));
	}
	[data-fizintro] .fz-tower {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	[data-fizintro] .fz-tower-line {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-fizintro] .fz-tower-win {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-fizintro] .fz-beam {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-fizintro] .fz-rule {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-fizintro] .fz-small--ink {
		fill: var(--sl-color-gray-2);
	}
	[data-fizintro] .fz-ball {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-fizintro] .fz-pill--day {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-fizintro] .fz-small--day {
		fill: var(--sl-color-gray-2);
	}
	[data-fizintro] .fz-num--day {
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ru = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
	for (const root of document.querySelectorAll<HTMLElement>('[data-fizintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="storm"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const flash = $<SVGRectElement>('[data-flash]');
			const bolt = $<SVGPathElement>('[data-bolt]');
			const rings = ['[data-s1]', '[data-s2]', '[data-s3]'].map((s) => $<SVGCircleElement>(s));
			const shake = $<SVGPathElement>('[data-shake]');
			const clock = $<SVGTextElement>('[data-clock]');
			const RUN = 8; // s; the flash at 1 s, the thunder at the house at 7 s
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const since = t - 1;
				// the flash: two quick flickers
				const f = since < 0 ? 0 : since < 0.12 ? 1 : since < 0.2 ? 0.25 : since < 0.34 ? 0.9 : Math.max(0, 0.9 - (since - 0.34) * 3);
				bolt.style.opacity = String(Math.min(1, f * 1.2));
				flash.style.opacity = String(f * 0.5);
				// the sound: 2 км (232 px) in 6 s; three fronts one after another
				rings.forEach((ring, i) => {
					const r = ((since - i * 0.18) / 6) * 232;
					const on = since > i * 0.18 && r < 238; // a front disappears just past the house
					ring.setAttribute('r', on ? r.toFixed(1) : '0');
					ring.style.opacity = on ? String(0.85 - i * 0.22) : '0';
				});
				const arrived = since >= 6;
				shake.style.opacity = arrived ? '1' : '0';
				clock.textContent = since < 0 ? '—' : arrived ? '6 с: гром!' : `${ru(since)} с`;
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="fall"]')!;
			const big = card.querySelector<SVGCircleElement>('[data-big]')!;
			const small = card.querySelector<SVGCircleElement>('[data-small]')!;
			const clock = card.querySelector<SVGTextElement>('[data-clock]')!;
			const RUN = 3.6;
			const T = Math.sqrt((2 * 45) / 9.8); // 3,03 s
			scene(card, RUN, (x) => {
				const t = Math.min(T, x * RUN);
				const s = (9.8 * t * t) / 2; // м
				big.setAttribute('cy', (36 + s * 4 - 7).toFixed(1)); // the bottom of the ball is at the height shown by the axis
				small.setAttribute('cy', (36 + s * 4 - 4).toFixed(1));
				clock.textContent = `${ru(t)} с`;
			});
		}
	}
</script>
