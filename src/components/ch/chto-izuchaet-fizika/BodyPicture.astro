---
/**
 * Picture «Тело и вещество»: left, one substance (glass) and three bodies made of it (a tumbler, a lens, a window
 * pane); right, one body (a pencil) made of two substances (wood and graphite). A static drawing.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic bodyp not-content">
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 240 150" role="img" aria-label="Одно вещество — стекло — и три тела из него: стакан, линза и оконное стекло">
			<text class="t-title" x="120" y="20" text-anchor="middle">одно вещество — разные тела</text>
			<path class="bodyp__glass" d="M30 48 h40 l-5 62 h-30 z"></path>
			<path class="bodyp__shine" d="M38 56 l3 44"></path>
			<path class="bodyp__glass" d="M120 44 q16 36 0 72 q-16 -36 0 -72 z"></path>
			<rect class="bodyp__frame" x="166" y="44" width="50" height="70" rx="2"></rect>
			<rect class="bodyp__glass" x="171" y="49" width="18" height="60"></rect>
			<rect class="bodyp__glass" x="193" y="49" width="18" height="60"></rect>
			<text x="50" y="132" text-anchor="middle">стакан</text>
			<text x="120" y="132" text-anchor="middle">линза</text>
			<text x="191" y="132" text-anchor="middle">окно</text>
			<text class="t-small" x="120" y="146" text-anchor="middle">вещество: стекло</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 240 150" role="img" aria-label="Одно тело — карандаш — из двух веществ: дерева и графита">
			<text class="t-title" x="120" y="20" text-anchor="middle">одно тело — два вещества</text>
			<g transform="translate(120 78) rotate(-14)">
				<rect class="bodyp__wood" x="-86" y="-9" width="140" height="18" rx="2"></rect>
				<path class="bodyp__woodtip" d="M54 -9 L84 0 L54 9 Z"></path>
				<path class="bodyp__lead" d="M74 -3 L86 0 L74 3 Z"></path>
				<rect class="bodyp__lead" x="-86" y="-2" width="140" height="4" opacity="0.55"></rect>
			</g>
			<path class="ln" d="M70 96 L62 118 M196 62 L204 96"></path>
			<text x="62" y="132" text-anchor="middle">дерево</text>
			<text x="204" y="110" text-anchor="middle">графит</text>
			<text class="t-small" x="120" y="146" text-anchor="middle">тело: карандаш</text>
		</svg>
	</div>
</figure>

<style is:global>
	.bodyp__glass {
		fill: color-mix(in srgb, var(--ig-vx) 22%, transparent);
		stroke: var(--g7-water-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.bodyp__shine {
		stroke: var(--sl-color-white);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0.6;
	}
	.bodyp__frame {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.bodyp__wood {
		fill: hsl(42, 85%, 58%);
		stroke: hsl(36, 70%, 34%);
		stroke-width: 1;
	}
	.bodyp__woodtip {
		fill: hsl(34, 50%, 74%);
		stroke: hsl(36, 70%, 34%);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.bodyp__lead {
		fill: hsl(230, 8%, 26%);
	}
	:root:not([data-theme='light']) .bodyp__lead {
		fill: hsl(230, 8%, 16%);
		stroke: hsl(230, 8%, 60%);
		stroke-width: 0.6;
	}
</style>
