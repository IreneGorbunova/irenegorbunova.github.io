</style>

<script>
	import { loop, scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { figure, ANKLE_CM } from '@components/people/body';
	import type { Pt } from '@components/people/core';

	const f1 = (v: number) => v.toFixed(1);
	const g = 9.8;
	const clampH = (a: number) => Math.max(-0.66, Math.min(0.4, a)); // the head turns by at most about 38°
	const hash = (i: number, k: number) => {
		const v = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
		return v - Math.floor(v);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-irdintro]')) {
		// ---------------------------------------------------------------- bumper cars
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bump"]')!;
			const K = 45; // px per metre
			const S = K / 100; // px per см
			const FL = 214;
			const NET = 28;
			const L = 90; // a car with its ring, 2 м
			const m1 = 235;
			const m2 = 185;
			const U = 1.4;
			const E = 0.5;
			const TAU = 0.12;
			const J = (m1 * m2 * (1 + E) * U) / (m1 + m2);
			const DEC = 0.6; // м/с², rolling with the pedal released
			const X1 = -14; // the father's car (rear end of the ring) at the start, px
			const X2 = 190; // the daughter's car
			const T_HIT = (X2 - (X1 + L)) / (U * K);
			const RUN = T_HIT + TAU + 1.96 + 0.4;
			// the motion, tabulated: positions (px), accelerations (м/с²) and the riders' sway
			const DT = 1 / 600;
			const N = Math.ceil(RUN / DT) + 2;
			const tab = { x1: new Float64Array(N), x2: new Float64Array(N), th1: new Float64Array(N), th2: new Float64Array(N), sq: new Float64Array(N), v1: new Float64Array(N) };
			{
				let x1 = X1 / K;
				let x2 = X2 / K;
				let v1 = U;
				let v2 = 0;
				let th1 = 0;
				let w1 = 0;
				let th2 = 0;
				let w2 = 0;
				const OM = 2 * Math.PI * 1.5;
				const ZE = 0.5;
				const LP = 0.5; // м, the pendulum's length for the sway
				for (let i = 0; i < N; i++) {
					const t = i * DT;
					let a1 = 0;
					let a2 = 0;
					const s = t - T_HIT;
					if (s >= 0 && s < TAU) {
						const F = ((J * Math.PI) / (2 * TAU)) * Math.sin((Math.PI * s) / TAU);
						a1 = -F / m1;
						a2 = F / m2;
					} else if (s >= TAU) {
						a1 = v1 > 0 ? -DEC : 0;
						a2 = v2 > 0 ? -DEC : 0;
					}
					tab.x1[i] = x1 * K;
					tab.x2[i] = x2 * K;
					tab.v1[i] = v1;
					tab.th1[i] = th1;
					tab.th2[i] = th2;
					tab.sq[i] = Math.max(0, (x1 * K + L) - x2 * K);
					v1 = Math.max(s >= TAU ? 0 : -9, v1 + a1 * DT);
					v2 = Math.max(0, v2 + a2 * DT);
					x1 += v1 * DT;
					x2 += v2 * DT;
					// the body leans forward (θ > 0) when the car slows down: θ'' = −ω²θ − 2ζωθ' − a/ℓ
					w1 += (-OM * OM * th1 - 2 * ZE * OM * w1 - a1 / LP) * DT;
					th1 += w1 * DT;
					w2 += (-OM * OM * th2 - 2 * ZE * OM * w2 - a2 / LP) * DT;
					th2 += w2 * DT;
				}
			}
			const at = (arr: Float64Array, t: number) => {
				const k = Math.max(0, Math.min(N - 1.001, t / DT));
				const i = Math.floor(k);
				return arr[i] + (arr[i + 1] - arr[i]) * (k - i);
			};

			// a car: back layer (pole, seat back, steering wheel), the rider, front layer (body, ring)
			const build = (gEl: SVGGElement, kind: 1 | 2, num: string, H: number, age: 'adult' | 'child', shirt: string, name: string) => {
				const back = el('g');
				const rider = el('g') as SVGGElement;
				const front = el('g');
				gEl.append(back, rider, front);
				const pole = el('path', { class: 'ird-pole', d: `M12 -30 V${NET - FL} M8 ${NET - FL + 4} h8` });
				back.append(pole);
				back.append(el('path', { class: 'ird-seat', d: 'M14 -20 Q14 -44 20 -44 Q26 -44 25 -20 Z' }));
				const wx = kind === 1 ? 47 : 41; // the steering wheel, in reach with the elbows bent
				const wy = kind === 1 ? -29 : -25.5;
				back.append(el('path', { class: 'ird-column', d: `M${wx + 8} -22 L${wx} ${wy}` }));
				back.append(el('ellipse', { class: 'ird-wheel', cx: wx, cy: wy, rx: 1.6, ry: 4.6, transform: `rotate(-24 ${wx} ${wy})` }));
				const body = `M5 -6 L5 -24 Q5 -30 12 -30 L26 -30 L30 -21 L${wx + 2} -21 Q${wx + 6} -28 ${wx + 12} -28 L76 -27 Q86 -26 86 -16 L86 -6 Z`;
				front.append(el('path', { class: `ird-body${kind}`, d: body }));
				const num_ = el('text', { class: 'ird-num', x: 64, y: -12, 'text-anchor': 'middle' });
				num_.textContent = num;
				front.append(num_);
				const ring = el('rect', { class: 'ird-ring', x: 0, y: -10, width: L, height: 9, rx: 4.5 });
				const ringHl = el('path', { class: 'ird-ring-hl', d: '' });
				front.append(ring, ringHl);
				const spark = el('g');
				gEl.append(spark);
				const sparks = Array.from({ length: 5 }, () => {
					const c = el('circle', { class: 'ird-spark', r: 0.9 });
					spark.append(c);
					return c;
				});
				const person = figure(rider, { s: S, H, age, clothes: 'indoor', shirt, hair: age === 'child' ? 'pony' : 'short', name });
				const u = H * S;
				return {
					draw: (x: number, lean: number, front0: number, rear0: number, moving: boolean, t: number) => {
						gEl.setAttribute('transform', `translate(${f1(x)} ${FL})`);
						// the ring squeezed at its front (front0 px) or rear (rear0 px)
						ring.setAttribute('x', f1(rear0));
						ring.setAttribute('width', f1(L - front0 - rear0));
						ringHl.setAttribute('d', `M${f1(rear0 + 4)} -8.6 H${f1(L - front0 - 4)}`);
						sparks.forEach((c, i) => {
							const on = moving && hash(Math.floor(t * 18), i + kind * 7) > 0.45;
							c.setAttribute('visibility', on ? 'visible' : 'hidden');
							c.setAttribute('cx', f1(12 + (hash(Math.floor(t * 18), i + 20) - 0.5) * 8));
							c.setAttribute('cy', f1(NET - FL + 1 + hash(Math.floor(t * 18), i + 40) * 5));
						});
						// the rider is drawn inside the car's group: car coordinates (x from the rear of the ring, y up from the floor)
						const hip: Pt = { x: 26, y: -0.31 * K };
						person.pose({
							hip,
							lean,
							head: clampH(-0.05 - lean * 0.6),
							ankles: [
								{ x: hip.x + (age === 'adult' ? 30 : 20), y: -6 },
								{ x: hip.x + (age === 'adult' ? 27 : 18), y: -6 },
							],
							feet: [-0.3, -0.3],
							hands: [
								{ at: { x: wx + 0.6, y: wy - 3.2 }, pose: 'grip', d: 3, contact: 'wheel' },
								{ at: { x: wx - 0.4, y: wy + 1.6 }, pose: 'grip', d: 3, contact: 'wheel' },
							],
						});
						void u;
					},
				};
			};
			const dad = build(card.querySelector<SVGGElement>('[data-car="0"]')!, 1, '7', 178, 'adult', 'hm-blue', 'father');
			const girl = build(card.querySelector<SVGGElement>('[data-car="1"]')!, 2, '12', 128, 'child', 'hm-green', 'daughter');
			scene(card, RUN, (xx) => {
				const t = RUN * xx;
				const sq = at(tab.sq, t);
				const v1 = at(tab.v1, t);
				dad.draw(at(tab.x1, t), 0.06 + at(tab.th1, t), sq / 2, 0, v1 > 0.01, t);
				const x2 = at(tab.x2, t);
				girl.draw(x2, 0.02 + at(tab.th2, t), 0, sq / 2, x2 > X2 + 0.5 && t < T_HIT + TAU + 1.95, t);
			});
		}

		// ---------------------------------------------------------------- the firework
		{
			const card = root.querySelector<HTMLElement>('[data-scene="firework"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 5; // px per metre for the rocket
			const FG = 206;
			const LX = 251; // the launch tube
			const M0 = 0.12;
			const MP = 0.03;
			const TB = 1.0;
			const F = 3.4;
			const KD = 0.0002;
			const T_WAIT = 0.6; // the fuse burns
			// the flight, tabulated
			const DT = 1 / 600;
			const ys: number[] = [];
			const vs: number[] = [];
			let T_TOP = 0;
			{
				let t = 0;
				let y = 0;
				let v = 0;
				for (;;) {
					ys.push(y);
					vs.push(v);
					const m = M0 - MP * Math.min(t, TB) / TB;
					const a = ((t < TB ? F : 0) - KD * v * Math.abs(v)) / m - g;
					if (t > TB && v + a * DT <= 0) break;
					v = Math.max(0, v + a * DT);
					y += v * DT;
					t += DT;
				}
				T_TOP = t;
			}
			const flight = (t: number) => {
				const k = Math.max(0, Math.min(ys.length - 1.001, t / DT));
				const i = Math.floor(k);
				return { y: ys[i] + (ys[i + 1] - ys[i]) * (k - i), v: vs[i] + (vs[i + 1] - vs[i]) * (k - i) };
			};
			const Y_TOP = ys[ys.length - 1];
			const T_FADE = 2.4;
			const RUN = T_WAIT + T_TOP + T_FADE + 0.4;
			const rocket = $<SVGGElement>('[data-rocket]');
			// sparks: one every 1/60 с of the burn, thrown down at 15 м/с relative to the rocket
			const sparkG = $('[data-sparks]');
			const sparks = Array.from({ length: 60 }, (_, i) => {
				const te = (i + 0.5) / 60;
				const c = el('circle', { class: 'ird-fwspark', r: 0.9 });
				sparkG.append(c);
				return { te, c, vx: (hash(i, 1) - 0.5) * 3, vy: flight(te).v - 15 * (0.8 + 0.4 * hash(i, 2)) };
			});
			// the burst: 40 stars, speeds 8–13 м/с seen in projection, air time constant 0,8 с
			const burstG = $('[data-burst]');
			const smoke = el('circle', { class: 'ird-smoke', r: 0 });
			const flash = el('circle', { class: 'ird-flash', r: 0 });
			burstG.append(smoke, flash);
			const TAUA = 0.8;
			// directions spread evenly over a sphere; the picture shows their projections, so the stars fill a disk
			const starsB = Array.from({ length: 48 }, (_, i) => {
				const a = hash(i, 3) * 2 * Math.PI;
				const cz = 2 * hash(i, 5) - 1;
				const sp = 13 * Math.sqrt(1 - cz * cz);
				const c = el('circle', { class: `ird-fw${i % 4}`, r: 1.5 });
				const tr = el('path', { class: `ird-tr ird-tr${i % 4}`, d: '' });
				burstG.append(tr, c);
				return { vx: sp * Math.cos(a), vy: sp * Math.sin(a), c, tr };
			});
			// position of a star s seconds after the burst, metres from the burst point (y up)
			const starAt = (vx: number, vy: number, s: number) => {
				const e = 1 - Math.exp(-s / TAUA);
				return { x: vx * TAUA * e, y: vy * TAUA * e - g * TAUA * (s - TAUA * e) };
			};
			// the people: much nearer than the rocket
			const S2 = 0.38;
			const GY = 232;
			const mom = figure($<SVGGElement>('[data-mother]'), { s: S2, H: 168, clothes: 'winter', shirt: 'hm-red', name: 'mother' });
			const son = figure($<SVGGElement>('[data-son]'), { s: S2, H: 118, age: 'child', clothes: 'winter', shirt: 'hm-blue', name: 'son' });
			const ank = ANKLE_CM.boot * S2;
			const MX = 78;
			const SX = 98;
			const um = 168 * S2;
			const us = 118 * S2;
			scene(card, RUN, (xx) => {
				const t = RUN * xx;
				const tf = t - T_WAIT; // since the lift-off
				const fl = flight(Math.max(0, tf));
				const ry = FG - 3 - fl.y * K;
				const burst = tf >= T_TOP;
				rocket.setAttribute('transform', `translate(${LX} ${f1(ry)})`);
				rocket.setAttribute('visibility', burst ? 'hidden' : 'visible');
				$('[data-flame]').setAttribute('visibility', tf > 0 && tf < TB ? 'visible' : 'hidden');
				$('[data-flame]').setAttribute('transform', `scale(1 ${f1(0.8 + 0.4 * hash(Math.floor(t * 30), 9))})`);
				$('[data-fuse]').setAttribute('visibility', tf < 0 && hash(Math.floor(t * 20), 11) > 0.3 ? 'visible' : 'hidden');
				for (const p of sparks) {
					const s = tf - p.te;
					const on = s >= 0 && s < 0.9;
					p.c.setAttribute('visibility', on ? 'visible' : 'hidden');
					if (!on) continue;
					const y0 = flight(p.te).y;
					const y = y0 + p.vy * s - 0.5 * g * s * s;
					p.c.setAttribute('cx', f1(LX + p.vx * s * K));
					p.c.setAttribute('cy', f1(Math.min(FG - 1, FG - 3 - y * K + 4)));
					p.c.setAttribute('opacity', f1(1 - s / 0.9));
				}
				// the fuse glows before the lift-off
				const sb = tf - T_TOP;
				flash.setAttribute('cx', String(LX));
				flash.setAttribute('cy', f1(FG - 3 - Y_TOP * K));
				flash.setAttribute('r', sb >= 0 && sb < 0.25 ? f1(10 * (1 - sb / 0.25) + 2) : '0');
				flash.setAttribute('opacity', sb >= 0 && sb < 0.25 ? f1(0.8 * (1 - sb / 0.25)) : '0');
				// a puff of smoke stays where the rocket burst and slowly spreads and sinks
				smoke.setAttribute('cx', String(LX + Math.max(0, sb) * 1.5));
				smoke.setAttribute('cy', f1(FG - 3 - Y_TOP * K + Math.max(0, sb) * 1.2));
				smoke.setAttribute('r', sb >= 0 ? f1(4 + 10 * (1 - Math.exp(-sb / 1.2))) : '0');
				for (const st of starsB) {
					const on = sb >= 0 && sb < T_FADE;
					st.c.setAttribute('visibility', on ? 'visible' : 'hidden');
					st.tr.setAttribute('visibility', on ? 'visible' : 'hidden');
					if (!on) continue;
					const p = starAt(st.vx, st.vy, sb);
					const q = starAt(st.vx, st.vy, Math.max(0, sb - 0.25));
					const cx = LX + p.x * K;
					const cy = FG - 3 - (Y_TOP + p.y) * K;
					st.c.setAttribute('cx', f1(cx));
					st.c.setAttribute('cy', f1(cy));
					const op = sb < 1.6 ? 1 : 1 - (sb - 1.6) / (T_FADE - 1.6);
					st.c.setAttribute('opacity', f1(op));
					st.tr.setAttribute('d', `M${f1(LX + q.x * K)} ${f1(FG - 3 - (Y_TOP + q.y) * K)} L${f1(cx)} ${f1(cy)}`);
				}
				// where the people look: the rocket, or the burst
				const target: Pt = { x: LX, y: burst ? FG - 3 - Y_TOP * K : ry };
				const look = (hx: number, hy: number) => Math.atan2(target.y - hy, Math.max(10, target.x - hx));
				const mHip: Pt = { x: MX, y: GY - ank - 0.475 * um + 0.4 };
				const sHip: Pt = { x: SX, y: GY - ank - 0.435 * us + 0.4 };
				const hold: Pt = { x: (MX + SX) / 2 + 1, y: GY - 0.76 * 100 * S2 }; // the joined hands, 76 см above the snow
				const lm = look(MX + 2, mHip.y - 0.4 * um);
				mom.pose({
					hip: mHip,
					lean: -0.04,
					head: clampH(lm),
					ankles: [
						{ x: MX + 4, y: GY - ank },
						{ x: MX - 4, y: GY - ank },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: hold, pose: 'grip', d: 4, contact: 'son-hand' },
						{ at: { x: MX - 2, y: mHip.y + 0.09 * um }, pose: 'relaxed' },
					],
				});
				const ls = look(SX + 2, sHip.y - 0.437 * us);
				son.pose({
					hip: sHip,
					lean: -0.06,
					head: clampH(ls),
					ankles: [
						{ x: SX + 3, y: GY - ank },
						{ x: SX - 3, y: GY - ank },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: SX + 3, y: sHip.y + 0.05 * us }, pose: 'relaxed' },
						{ at: hold, pose: 'grip', d: 4, contact: 'mother-hand' },
					],
				});
			});
		}
	}
</script>
