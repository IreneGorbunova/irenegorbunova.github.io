---
/**
 * Two short looping opening scenes of «Импульс. Закон сохранения импульса. Реактивное движение» (grade 9). No terms of
 * the chapter in the pictures or the visible captions; each caption's popover names the notion and links to its
 * section. People: the shared people kit (src/components/people/). Other chapters already use billiards, a boy jumping
 * from a boat, skaters pushing apart, a toy cannon on a cart, a squid and a balloon on a thread, so these scenes use
 * other subjects.
 *
 * Bumper cars (side view, real time, 4,4 с; 45 px per metre on both axes, 0,45 px per см for the people): a father
 *   (178 см) drives his car (150 кг; 235 кг with him) at 1,4 м/с into the car of his daughter (child of about 7 years in
 *   the kit's proportions, 128 см; 185 кг with her), which stands with its pedal released. The rubber rings meet for
 *   0,12 с with a force that rises and falls as a half sine (peak 2,85 кН) and pass the impulse J = 217 Н·с; the
 *   impact is partly elastic (coefficient of restitution 0,5). After it the father's car rolls at 0,475 м/с and the
 *   daughter's at 1,175 м/с: 235 · 1,4 = 329 = 235 · 0,475 + 185 · 1,175 кг·м/с. Then both roll with their pedals
 *   released and slow by 0,6 м/с² (rolling resistance): she rolls 1,15 м in 1,96 с, he 0,19 м in 0,79 с, so the cars
 *   do not meet again. The riders sway with the cars: the upper body is a damped pendulum (1,5 Гц, damping ratio 0,5)
 *   driven by the car's acceleration, so the father lurches forward and the daughter back at the impact. The hands
 *   (6–8 px) are mittens of the kit around the steering wheels. Sparks flicker where a moving car's pole slides on the
 *   ceiling net.
 * Firework (a winter night; real time, 6,6 с): a firework rocket of 120 г (30 г of it the charge) stands in a launch
 *   tube in the snow, 40 м beyond a mother (168 см) and her son (7 years, 118 см) who watch it hand in hand (0,38 px per
 *   см: they stand much nearer than the rocket). The rocket's flight is drawn at 5 px per metre: the charge burns for
 *   1,0 с with a thrust of 3,4 Н (air drag 0,0002 v² Н), the rocket reaches 10,6 м at 22,5 м/с, coasts up to 35 м at
 *   3,2 с and bursts at the top. Sparks leave the nozzle downward at 15 м/с relative to the rocket and fall back. The
 *   48 stars of the burst fly out at 13 м/с in directions spread over a sphere (so the picture shows them filling a
 *   disk), are slowed by the air (time constant 0,8 с),
 *   fall with g and fade in 2,4 с. The rocket and the stars are drawn larger than to scale (the rocket 3 times).
 *   A puff of smoke stays at the burst point and spreads. The people's heads follow the rocket within the kit's ±40°.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

// ---- bumper cars: the floor at y = 214, 45 px per metre
const FL = 214;
const NET = 28;
const bulbs = Array.from({ length: 19 }, (_, i) => 8 + i * 19);
const net = [
	...Array.from({ length: 40 }, (_, i) => `M${i * 10 - 20} ${NET - 6} L${i * 10 - 14} ${NET}`),
	...Array.from({ length: 40 }, (_, i) => `M${i * 10 - 20} ${NET} L${i * 10 - 14} ${NET - 6}`),
].join(' ');
const plates = Array.from({ length: 10 }, (_, i) => `M${i * 40 + 8} ${FL} L${i * 40 - 8} 240`).join(' ');

// ---- firework: the far snow field at y = 206, the near ground at y = 232
const FG = 206;
const stars = Array.from({ length: 60 }, (_, i) => {
	const r = (k: number) => {
		const v = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
		return v - Math.floor(v);
	};
	return { x: r(1) * 360, y: r(2) * 120, s: 0.3 + r(3) * 0.8 };
});
const houses = [
	{ x: -6, w: 64, h: 70 },
	{ x: 62, w: 46, h: 96 },
	{ x: 112, w: 58, h: 58 },
	{ x: 300, w: 66, h: 84 },
];
const windows = houses.flatMap((h, k) =>
	Array.from({ length: Math.floor(h.h / 16) * Math.floor(h.w / 14) }, (_, i) => {
		const cols = Math.floor(h.w / 14);
		const r = Math.floor(i / cols);
		const c = i % cols;
		const lit = Math.sin((k + 1) * 31.7 + i * 7.13) > -0.1;
		return { x: h.x + 5 + c * 14, y: FG - h.h + 6 + r * 16, lit };
	}),
);
---

<KitStyles />
<IntroFrame data-irdintro>
	<div class="intro__card" data-scene="bump">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Автодром в парке. Папа на красной машинке разгоняется и врезается сзади в стоящую жёлтую машинку дочки. После удара его машинка катится медленно, а машинка дочки отъезжает вперёд быстрее. Папу при ударе качнуло вперёд, дочку — назад">
			<rect class="ird-wall" x="0" y="0" width="360" height={FL}></rect>
			<path class="ird-stripe" d={Array.from({ length: 13 }, (_, i) => `M${i * 30 - 10} ${NET + 4} l20 0 l-30 ${FL - NET - 4} l-20 0 Z`).join(' ')}></path>
			<!-- the barrier at the back, with parked cars behind it -->
			<rect class="ird-barrier" x="0" y={FL - 44} width="360" height="16" rx="2"></rect>
			<path class="ird-barrier-line" d={`M0 ${FL - 36} H360`}></path>
			<g opacity="0.75">
				<rect class="ird-car-far" x="16" y={FL - 60} width="44" height="14" rx="5"></rect>
				<rect class="ird-car-far2" x="292" y={FL - 60} width="44" height="14" rx="5"></rect>
				<path class="ird-pole-far" d={`M22 ${FL - 58} V${NET} M298 ${FL - 58} V${NET}`}></path>
			</g>
			<rect class="ird-floor" x="0" y={FL - 28} width="360" height={240 - FL + 28}></rect>
			<path class="ird-plate" d={plates + ` M0 ${FL - 14} H360`}></path>
			<!-- the ceiling: frame, net, bulbs -->
			<rect class="ird-roof" x="0" y="0" width="360" height={NET - 6}></rect>
			<path class="ird-net" d={net + ` M0 ${NET} H360 M0 ${NET - 6} H360`}></path>
			{bulbs.map((x, i) => <circle class={`ird-bulb ird-bulb--${i % 3}`} cx={x} cy="9" r="2.6"></circle>)}
			<g data-car="1"></g>
			<g data-car="0"></g>
		</svg>
		<div class="intro__foot">
			<p>
				Папа на машинке врезается в стоящую машинку дочки:{' '}
				<More term={'его машинка резко замедляется, а дочкина уезжает вперёд'}>
					При ударе машинки толкают друг друга с равными силами в противоположные стороны и одинаковое время. Сколько «движения» потеряла папина машинка, столько получила дочкина: сумма произведений массы на скорость у двух машинок до удара и после удара одна и та же, 329&nbsp;кг·м/с. Это{' '}
					<a href="#закон-сохранения-импульса">закон сохранения импульса</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="firework">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимняя ночь, двор. Из трубы в снегу взлетает ракета фейерверка: из её хвоста вниз бьёт струя искр, а сама ракета летит вверх. Наверху она вспыхивает разноцветными звёздами. Мама с сыном смотрят на неё, держась за руки">
			<rect class="ird-night" x="0" y="0" width="360" height="240"></rect>
			{stars.map((s) => <circle class="ird-skystar" cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.s.toFixed(2)}></circle>)}
			<circle class="ird-moon" cx="40" cy="34" r="11"></circle>
			<circle class="ird-night" cx="45" cy="30" r="10"></circle>
			<!-- houses with lit windows -->
			{houses.map((h) => <rect class="ird-house" x={h.x} y={FG - h.h} width={h.w} height={h.h}></rect>)}
			{windows.map((w) => <rect class={w.lit ? 'ird-win ird-win--lit' : 'ird-win'} x={w.x} y={w.y} width="7" height="9"></rect>)}
			<path class="ird-roofsnow" d={houses.map((h) => `M${h.x - 2} ${FG - h.h} h${h.w + 4} v-3 q${-(h.w + 4) / 2} -4 ${-(h.w + 4)} 0 Z`).join(' ')}></path>
			<!-- snowy fir trees -->
			<path class="ird-fir" d="M196 206 L206 180 L202 180 L210 162 L206 162 L213 146 L220 162 L216 162 L224 180 L220 180 L230 206 Z M268 206 L276 186 L273 186 L279 172 L276 172 L282 160 L288 172 L285 172 L291 186 L288 186 L296 206 Z"></path>
			<path class="ird-firsnow" d="M204 182 L210 178 L216 182 M208 164 L213 160 L218 164 M275 188 L282 184 L289 188"></path>
			<rect class="ird-snow" x="0" y={FG} width="360" height={240 - FG}></rect>
			<path class="ird-drift" d={`M0 ${FG + 2} Q60 ${FG - 6} 120 ${FG + 1} Q180 ${FG + 6} 240 ${FG} Q300 ${FG - 5} 360 ${FG + 2} V${FG + 8} H0 Z`}></path>
			<path class="ird-steps" d="M40 236 l4 -1 M58 230 l4 -1 M74 236 l4 -1 M90 229 l4 -1 M106 235 l4 -1"></path>
			<!-- the launch tube in the snow -->
			<rect class="ird-tube" x="249" y={FG - 9} width="4" height="10" rx="0.8"></rect>
			<g data-sparks></g>
			<g data-burst></g>
			<g data-rocket>
				<rect class="ird-fwbody" x="-1.6" y="-9" width="3.2" height="8" rx="0.6"></rect>
				<path class="ird-fwcap" d="M-1.6 -9 L0 -12.5 L1.6 -9 Z"></path>
				<path class="ird-fwstick" d="M0.9 -2 V8"></path>
				<path class="ird-fwflame" data-flame d="M-1.4 -1 L0 6 L1.4 -1 Z"></path>
				<circle class="ird-fwspark" data-fuse cx="-1.8" cy="-0.5" r="0.9"></circle>
			</g>
			<g data-mother></g>
			<g data-son></g>
		</svg>
		<div class="intro__foot">
			<p>
				Ракете фейерверка не от чего оттолкнуться:{' '}
				<More term={'она взлетает, выбрасывая вниз струю раскалённых газов'}>
					Газы, вылетая вниз, уносят с собой «движение», направленное вниз, — и ракета получает такое же движение вверх. Опора ей не нужна, поэтому так летают и настоящие ракеты в космосе. Это{' '}
					<a href="#реактивное-движение">реактивное движение</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

