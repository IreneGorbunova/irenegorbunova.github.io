---
/**
 * Picture to the definition of momentum p = mυ: balls rolling on a floor, each with its velocity (blue, 6 px per м/с)
 * and its momentum (violet, 12 px per кг·м/с). One scale for each kind of arrow in all rows.
 *   1) a football, 0,5 кг at 4 м/с: p = 2 кг·м/с;
 *   2) a medicine ball, 1,5 кг at the same 4 м/с: p = 6 кг·м/с, three times as much;
 *   3) the football kicked to 12 м/с: p = 0,5 · 12 = 6 кг·м/с, as much as the heavy ball at 4 м/с;
 *   4) the medicine ball rolling to the left at 4 м/с: the momentum is directed to the left (its projection −6 кг·м/с).
 * The balls are not to the scale of the arrows (a football is 22 см across, a medicine ball 28 см). No animation.
 */
import IrdStyles from './IrdStyles.astro';

const VA = 6;
const PA = 12;
const rows = [
	{ kind: 'foot', m: '0,5', v: 4, p: 2, dir: 1, vt: '4 м/с' },
	{ kind: 'med', m: '1,5', v: 4, p: 6, dir: 1, vt: '4 м/с' },
	{ kind: 'foot', m: '0,5', v: 12, p: 6, dir: 1, vt: '12 м/с' },
	{ kind: 'med', m: '1,5', v: 4, p: 6, dir: -1, vt: '4 м/с влево' },
];
const RH = 62; // row height
const arrow = (x1: number, y: number, len: number, hl: number, hw: number) => {
	const x2 = x1 + len;
	const s = Math.sign(len);
	const bx = x2 - s * hl;
	return { shaft: `M${x1} ${y} L${bx + s * 0.5} ${y}`, head: `M${x2} ${y} L${bx} ${y - hw} L${bx} ${y + hw} Z` };
};
---

<IrdStyles />
<figure class="g7 g7--pic ird not-content" data-ird-momentum>
	<div class="g7__grid" style="grid-template-columns: minmax(0, 1fr)">
		<svg class="g7__svg" viewBox={`0 0 360 ${rows.length * RH + 6}`} role="img" aria-label="Четыре мяча на полу со стрелками скорости и импульса. Футбольный мяч массой 0,5 килограмма при скорости 4 метра в секунду имеет импульс 2 килограмм-метра в секунду. Набивной мяч массой 1,5 килограмма при той же скорости — 6. Футбольный мяч при скорости 12 метров в секунду — тоже 6. Набивной мяч, катящийся влево, имеет импульс, направленный влево">
			{rows.map((r, i) => {
				const y0 = i * RH;
				const fy = y0 + RH - 8; // the floor
				const R = r.kind === 'foot' ? 10 : 13;
				const cx = r.dir > 0 ? 150 : 250;
				const cy = fy - R;
				const v = arrow(cx, y0 + 23, r.dir * r.v * VA, 8, 4.5);
				const p = arrow(cx, y0 + 10, r.dir * r.p * PA, 10, 6.5);
				return (
					<g>
						<rect class="ird-floorband" x="0" y={fy} width="360" height="3"></rect>
						<text class="t-small" x="6" y={y0 + 18}><tspan class="t-i">m</tspan> = {r.m} кг, <tspan class="t-i">υ</tspan> = {r.vt}</text>
						<text class="t-small t-violet" x="6" y={y0 + 34}><tspan class="t-i">p</tspan> = <tspan class="t-i">mυ</tspan> = {r.dir < 0 ? '6 кг·м/с влево' : `${r.p} кг·м/с`}</text>
						{r.kind === 'foot' ? (
							<g>
								<circle class="ird-football" cx={cx} cy={cy} r={R}></circle>
								<path class="ird-patch" d={`M${cx} ${cy - 3.4} l3.2 2.3 l-1.2 3.8 h-4 l-1.2 -3.8 Z M${cx - 8.6} ${cy - 3} l2.6 -3 l1.6 2.6 l-1.6 3 Z M${cx + 8.6} ${cy - 3} l-2.6 -3 l-1.6 2.6 l1.6 3 Z M${cx - 3} ${cy + 9.4} l1.2 -3 h3.6 l1.2 3 Z`}></path>
							</g>
						) : (
							<g>
								<circle class="ird-medball" cx={cx} cy={cy} r={R}></circle>
								<path class="ird-seam" d={`M${cx - R} ${cy} Q${cx} ${cy - 6} ${cx + R} ${cy} M${cx} ${cy - R} Q${cx + 5} ${cy} ${cx} ${cy + R}`}></path>
							</g>
						)}
						<path class="arrow arrow--violet" d={p.shaft}></path>
						<path class="head--violet" d={p.head}></path>
						<path class="arrow arrow--blue" d={v.shaft}></path>
						<path class="head--blue" d={v.head}></path>
						<text class="t-small t-violet t-i" x={cx + r.dir * (r.p * PA + 6)} y={y0 + 14} text-anchor={r.dir > 0 ? 'start' : 'end'}>p</text>
						<text class="t-small t-blue t-i" x={cx + r.dir * (r.v * VA + 6)} y={y0 + 27} text-anchor={r.dir > 0 ? 'start' : 'end'}>υ</text>
					</g>
				);
			})}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Синие стрелки — скорости мячей, фиолетовые — их импульсы, каждая в своём масштабе. Набивной мяч в три раза тяжелее футбольного: при одинаковой скорости его импульс в три раза больше. Такой же импульс у футбольного мяча, если он летит в три раза быстрее. Импульс направлен так же, как скорость. Мячи нарисованы не в масштабе стрелок.
	</figcaption>
</figure>

<style is:global>
	.ird .ird-floorband {
		fill: var(--g7-ground);
	}
	.ird .ird-football {
		fill: hsl(0, 0%, 96%);
		stroke: hsl(0, 0%, 35%);
		stroke-width: 1;
	}
	.ird .ird-patch {
		fill: hsl(0, 0%, 18%);
	}
	.ird .ird-medball {
		fill: hsl(25, 45%, 38%);
		stroke: hsl(25, 40%, 22%);
		stroke-width: 1;
	}
	.ird .ird-seam {
		fill: none;
		stroke: hsl(25, 40%, 22%);
		stroke-width: 1;
	}
</style>
