---
/**
 * Small animated pictures to «Где это встречается» (calm loops, not to scale). In each the body throws part of a
 * substance one way and itself moves the other way; the body's velocity is a blue arrow with υ⃗ over it.
 * Medusa (period 2,4 с): the bell squeezes in 0,35 с and pushes water out of its opening downward, then slowly opens
 *   again. The camera follows the medusa: the specks in the water drift down, fast right after the squeeze and slower
 *   as the medusa coasts (its speed falls off in about 0,7 с); the velocity arrow grows and shrinks with that speed
 *   (14–42 px). Real medusae pulse about once a second and swim a few сантиметров per second.
 * Jet ski: a pump takes in water from under the hull and throws it back out of the nozzle in the stern; the jet ski
 *   moves forward. The camera follows it: the wave crests go back at 40 px/с, drops fly back from the nozzle, the hull
 *   rocks by about 1 px and 1° (period 1,6 с). A rider (people kit, 175 см, 0,4 px per см) holds the handlebar.
 * Fire hose: two firefighters (people kit, 175 и 170 см, 0,5 px per см) hold the hose and lean forward: the jet (for
 *   example 15 л/с at 30 м/с) pushes the nozzle back with ρQυ = 1000 · 0,015 · 30 = 450 Н (red arrow), too much for
 *   one person to hold steady. The water of the jet flows out (dashes and drops), slowed.
 * Jet engine: the engine of an airliner takes air in at the front and throws hot gas out at the back much faster; the
 *   airliner flies forward. The camera follows the airliner: the clouds below go back. Gray dashes: air going in (slow);
 *   orange: gas going out (fast).
 * Hunter (period 4,2 с): a hunter (people kit, 178 см, 0,46 px per см) aims a rifle at a paper target on a post (no
 *   animal). Rifle 110 см, 3 кг; bullet 9 г at 400 м/с: the free rifle would recoil at 0,009 · 400 / 3 = 1,2 м/с; with
 *   the butt pressed to the shoulder the rifle and the hunter (about 80 кг) move together at 3,6 / 83 ≈ 0,04 м/с. At
 *   1,8 с the shot: a flash at the muzzle, the bullet crosses to the target in 0,35 с (hugely slowed: 400 м/с), the
 *   rifle and the shoulder go back by 3 px in 0,06 с and come back in 0,84 с (exaggerated), with a short blue arrow
 *   (the velocity of the rifle) while they move back. A hole stays in the target until the loop restarts. The distance
 *   to the target is not to scale.
 * The hands of the rider and the firefighters are 9 px or less: mittens of the kit (gloves for the firefighters); the
 * hunter's hands (8,6 px) have fingers.
 */
import IrdStyles from './IrdStyles.astro';

const ar = (x1: number, y1: number, x2: number, y2: number, hl = 7, hw = 4) => {
	const L = Math.hypot(x2 - x1, y2 - y1);
	const ux = (x2 - x1) / L;
	const uy = (y2 - y1) / L;
	const bx = x2 - ux * hl;
	const by = y2 - uy * hl;
	return {
		shaft: `M${x1} ${y1} L${(bx + ux * 0.5).toFixed(1)} ${(by + uy * 0.5).toFixed(1)}`,
		head: `M${x2} ${y2} L${(bx - uy * hw).toFixed(1)} ${(by + ux * hw).toFixed(1)} L${(bx + uy * hw).toFixed(1)} ${(by - ux * hw).toFixed(1)} Z`,
	};
};
const vSki = ar(132, 36, 172, 36);
const vJet = ar(118, 18, 168, 18);
const fHose = ar(147, 54, 119, 54, 7, 4); // on the nozzle, backward
const jets = {
	jelly: [ar(84, 66, 80, 100, 5, 3), ar(90, 66, 90, 104, 5, 3), ar(96, 66, 100, 100, 5, 3)],
	airIn: [ar(176, 52, 140, 52, 5, 3), ar(176, 62, 140, 62, 5, 3), ar(176, 72, 140, 72, 5, 3)],
	gasOut: [ar(54, 58, 6, 56, 5, 3), ar(54, 66, 2, 66, 5, 3), ar(54, 74, 6, 76, 5, 3)],
};
// the rifle in сантиметрах, the butt at (0, 0), the barrel along +x (scaled by 0,46 px per см in the script)
const RIFLE = {
	stock: 'M0 -5 L30 -2.2 L31 4.2 L27 5 L0 8.5 Q-1 1.75 0 -5 Z',
	grip: 'M26 3.5 L32.5 3.2 L31 12 L26.5 11.2 Z',
	receiver: 'M29.5 -3.6 H50 V3 H29.5 Z',
	guard: 'M33 3 Q34 8.5 40 3',
	fore: 'M50 -1.6 H78 L76 5 H50 Z',
	barrel: 'M48 -3.4 H110 V0 H48 Z',
};
---

<IrdStyles />
<figure class="g7 g7--pic ird not-content" data-ird-uses>
	<div class="g7__grid is-three ird-uses">
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Медуза сжимает купол и выталкивает воду вниз, а сама движется вверх">
				<rect class="ird-sea" x="0" y="0" width="180" height="130" rx="6"></rect>
				<g data-specks></g>
				<path class="ird-tent" data-tent d=""></path>
				<path class="ird-bell" data-bell d=""></path>
				<path class="ird-bell-in" data-bell-in d=""></path>
				<g data-jelly-jets>
					{jets.jelly.map((j) => (
						<g>
							<path class="ird-water-jet" d={j.shaft}></path>
							<path class="ird-water-head" d={j.head}></path>
						</g>
					))}
				</g>
				<path class="arrow arrow--blue" data-vj d=""></path>
				<path class="head--blue" data-vjh d=""></path>
				<text class="t-small t-blue" x="147" y="74"><tspan class="t-i t-vec">υ</tspan></text>
			</svg>
			<p>Медуза</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Гидроцикл с водителем: из сопла на корме назад бьёт струя воды, гидроцикл движется вперёд">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<rect class="ird-sea" x="0" y="92" width="180" height="38"></rect>
				<g data-waves></g>
				<g data-bob>
					<path class="ird-water-spray" data-spray d="M50 88 Q30 82 4 90 Q28 86 50 92 Z"></path>
					<g data-drops></g>
					<g data-ski-rider></g>
					<path class="ird-ski" d="M50 82 L54 92 L132 92 Q150 90 158 80 L128 76 L112 72 L100 76 L56 76 Z"></path>
					<path class="ird-ski-seat" d="M66 76 Q66 70 74 70 L98 70 Q102 70 102 76 Z"></path>
					<path class="ird-ski-bar" d="M106 72 L109 59 M104 59 H114"></path>
					<rect class="ird-nozzle" x="46" y="84" width="6" height="6" rx="1"></rect>
					<path class="ird-wake" d="M54 94 Q90 98 132 94"></path>
				</g>
				<path class="arrow arrow--blue" d={vSki.shaft}></path>
				<path class="head--blue" d={vSki.head}></path>
				<text class="t-small t-blue" x="150" y="30"><tspan class="t-i t-vec">υ</tspan></text>
			</svg>
			<p>Гидроцикл</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Два пожарных держат пожарный рукав и наклоняются вперёд: струя воды бьёт вперёд, а рукав толкает их назад">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<rect class="ird-soil ird-asphalt" x="0" y="122" width="180" height="8"></rect>
				<path class="ird-water-spray" d="M146 60 Q164 52 182 56 L182 62 Q164 58 146 63 Z" opacity="0.55"></path>
				<path class="ird-stream" data-stream d="M146 61 Q164 55 182 58.5"></path>
				<g data-hose-drops></g>
				<g data-ff-rear></g>
				<path class="ird-hose" data-hose d=""></path>
				<g data-ff-front></g>
				<path class="ird-nozzle-ff" d="M136 59 L146 58.5 L146 63 L136 64 Z"></path>
				<path class="arrow arrow--red" d={fHose.shaft}></path>
				<path class="head--red" d={fHose.head}></path>
				<text class="t-small t-red" x="129" y="48"><tspan class="t-i t-vec">F</tspan></text>
			</svg>
			<p>Пожарный рукав</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Двигатель реактивного самолёта под крылом: спереди он забирает воздух, сзади выбрасывает горячий газ, самолёт летит вперёд">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<g data-clouds></g>
				<path class="ird-wing" d="M0 36 L180 26 L180 34 L0 46 Z"></path>
				<path class="ird-pylon" d="M80 40 L76 50 L112 50 L118 38 Z"></path>
				<path class="ird-engine" d="M58 52 Q58 48 64 48 L134 46 Q140 46 140 52 L140 74 Q140 80 134 80 L64 78 Q58 78 58 74 Z"></path>
				<path class="ird-fan" d="M137 50 V76 M134 50 V76"></path>
				<path class="ird-exhaust" d="M58 54 L50 57 L50 72 L58 76 Z"></path>
				{jets.airIn.map((j) => (
					<g>
						<path class="ird-air-jet" data-air d={j.shaft}></path>
						<path class="ird-air-head" d={j.head}></path>
					</g>
				))}
				{jets.gasOut.map((j) => (
					<g>
						<path class="ird-hot-jet" data-gas d={j.shaft}></path>
						<path class="ird-hot-head" d={j.head}></path>
					</g>
				))}
				<path class="arrow arrow--blue" d={vJet.shaft}></path>
				<path class="head--blue" d={vJet.head}></path>
				<text class="t-small t-blue" x="152" y="13"><tspan class="t-i t-vec">υ</tspan></text>
				<text class="t-small" x="158" y="96" text-anchor="middle">воздух</text>
				<text class="t-small" x="28" y="96" text-anchor="middle">газ</text>
			</svg>
			<p>Реактивный самолёт</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Охотник целится из ружья в бумажную мишень на столбе. При выстреле пуля летит вперёд, а ружьё вместе с плечом охотника чуть отходит назад">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<rect class="ird-grass" x="0" y="122" width="180" height="8"></rect>
				<g data-target>
					<rect class="ird-post" x="164.5" y="0" width="3" height="60"></rect>
					<circle class="ird-tgt" cx="166" cy="0" r="10"></circle>
					<circle class="ird-tgt-ring" cx="166" cy="0" r="6.5"></circle>
					<circle class="ird-tgt-eye" cx="166" cy="0" r="3"></circle>
					<circle class="ird-hole" data-hole cx="165" cy="0.6" r="1.2" opacity="0"></circle>
				</g>
				<g data-hunter></g>
				<g data-rifle-src>
					<g data-rifle>
						<path class="ird-wood" d={RIFLE.stock}></path>
						<path class="ird-wood" d={RIFLE.grip}></path>
						<path class="ird-wood" d={RIFLE.fore}></path>
						<path class="ird-steel" d={RIFLE.barrel}></path>
						<path class="ird-steel" d={RIFLE.receiver}></path>
						<path class="ird-guard" d={RIFLE.guard}></path>
					</g>
				</g>
				<path class="ird-flash" data-flash d="" opacity="0"></path>
				<ellipse class="ird-bullet" data-bullet cx="0" cy="0" rx="1.8" ry="0.9" opacity="0"></ellipse>
				<path class="ird-trail" data-trail d="" opacity="0"></path>
				<path class="arrow arrow--blue" data-vr d=""></path>
				<path class="head--blue" data-vrh d=""></path>
				<text class="t-small t-blue" data-vrl x="0" y="0" visibility="hidden"><tspan class="t-i t-vec">υ</tspan></text>
			</svg>
			<p>Выстрел из ружья</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Каждое тело выбрасывает в одну сторону часть вещества — воду, газ, пулю — и само движется в другую. Синие стрелки — скорость тела; рисунки следуют за медузой, гидроциклом и самолётом, поэтому вода, волны и облака уходят назад. Красная стрелка — сила, с которой струя отталкивает пожарный рукав. Приклад прижат к плечу, и ружьё отходит назад вместе с охотником. Рисунки не в масштабе, полёт пули сильно замедлен.
	</figcaption>
</figure>

<style is:global>
	.ird-uses .ird-use p {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ird .ird-sea { fill: color-mix(in oklab, var(--ig-vx) 22%, var(--g7-paper)); }
	.ird .ird-air { fill: color-mix(in oklab, var(--ig-vx) 8%, var(--g7-paper)); }
	.ird .ird-soil { fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5)); }
	.ird .ird-asphalt { fill: var(--sl-color-gray-4); }
	.ird .ird-grass { fill: color-mix(in oklab, hsl(110, 40%, 42%) 55%, var(--sl-color-gray-5)); }
	.ird .ird-speck { fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-2)); opacity: 0.55; }
	.ird .ird-bell { fill: hsl(300, 50%, 75%); fill-opacity: 0.75; stroke: hsl(300, 40%, 55%); stroke-width: 1; }
	.ird .ird-bell-in { fill: none; stroke: hsl(300, 40%, 60%); stroke-width: 1; opacity: 0.7; }
	.ird .ird-tent { fill: none; stroke: hsl(300, 40%, 65%); stroke-width: 1.2; opacity: 0.85; }
	.ird .ird-water-jet { fill: none; stroke: hsl(200, 75%, 62%); stroke-width: 1.6; stroke-dasharray: 3 2; }
	.ird .ird-water-head { fill: hsl(200, 75%, 62%); }
	.ird .ird-water-spray { fill: hsl(200, 75%, 66%); opacity: 0.85; }
	.ird .ird-stream { fill: none; stroke: hsl(200, 80%, 58%); stroke-width: 2.2; stroke-dasharray: 5 3; stroke-linecap: round; }
	.ird .ird-drop { fill: hsl(200, 75%, 62%); }
	.ird .ird-crest { fill: none; stroke: hsl(200, 60%, 85%); stroke-width: 1; opacity: 0.8; }
	.ird .ird-wake { fill: none; stroke: hsl(200, 60%, 85%); stroke-width: 1; opacity: 0.7; }
	.ird .ird-cloud { fill: var(--sl-color-gray-5); opacity: 0.9; }
	.ird .ird-ski { fill: hsl(0, 0%, 94%); stroke: hsl(210, 10%, 40%); stroke-width: 1; }
	.ird .ird-ski-seat { fill: hsl(220, 15%, 22%); }
	.ird .ird-ski-bar { fill: none; stroke: hsl(220, 10%, 25%); stroke-width: 2; stroke-linecap: round; }
	.ird .ird-hose { fill: none; stroke: hsl(45, 30%, 80%); stroke-width: 3.6; stroke-linecap: round; stroke-linejoin: round; }
	.ird .ird-nozzle-ff { fill: hsl(210, 8%, 55%); }
	.ird .ird-wing { fill: var(--sl-color-gray-3); }
	.ird .ird-pylon { fill: var(--sl-color-gray-4); }
	.ird .ird-engine { fill: hsl(210, 10%, 80%); stroke: hsl(210, 10%, 45%); stroke-width: 1; }
	.ird .ird-fan { stroke: hsl(210, 10%, 45%); stroke-width: 1; }
	.ird .ird-exhaust { fill: hsl(210, 8%, 45%); }
	.ird .ird-air-jet { fill: none; stroke: var(--sl-color-gray-2); stroke-width: 1.4; stroke-dasharray: 5 3; }
	.ird .ird-air-head { fill: var(--sl-color-gray-2); }
	.ird .ird-hot-jet { fill: none; stroke: hsl(28, 95%, 58%); stroke-width: 2; stroke-dasharray: 7 3; }
	.ird .ird-hot-head { fill: hsl(28, 95%, 58%); }
	.ird .ird-post { fill: var(--g7-wood-dark); }
	.ird .ird-tgt { fill: hsl(45, 40%, 92%); stroke: hsl(30, 20%, 35%); stroke-width: 0.8; }
	.ird .ird-tgt-ring { fill: none; stroke: hsl(30, 20%, 35%); stroke-width: 0.8; }
	.ird .ird-tgt-eye { fill: hsl(0, 0%, 15%); }
	.ird .ird-hole { fill: hsl(45, 40%, 92%); stroke: hsl(0, 0%, 5%); stroke-width: 0.6; }
	.ird .ird-wood { fill: hsl(28, 45%, 38%); stroke: hsl(28, 40%, 22%); stroke-width: 0.5; vector-effect: non-scaling-stroke; }
	.ird .ird-steel { fill: hsl(215, 10%, 30%); stroke: hsl(215, 10%, 18%); stroke-width: 0.5; vector-effect: non-scaling-stroke; }
	.ird .ird-guard { fill: none; stroke: hsl(215, 10%, 25%); stroke-width: 0.8; vector-effect: non-scaling-stroke; }
	.ird .ird-flash { fill: hsl(45, 100%, 62%); stroke: hsl(28, 95%, 55%); stroke-width: 0.6; }
	.ird .ird-bullet { fill: hsl(35, 60%, 40%); }
	.ird .ird-trail { fill: none; stroke: var(--sl-color-gray-3); stroke-width: 0.8; stroke-dasharray: 2 2; }
</style>

<script>
	import { loop } from '../g7/kit';
	import { figure, ANKLE_CM } from '@components/people/body';
	import { ease } from '@components/people/motion';
	import type { Pt } from '@components/people/core';
	import { arrow, el, f1, vecAuto, vecMarks } from './ird';

	const frac = (x: number) => x - Math.floor(x);
	const hash = (i: number, k: number) => frac(Math.sin(i * 12.9898 + k * 78.233) * 43758.5453);

	for (const fig of document.querySelectorAll<HTMLElement>('[data-ird-uses]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const steps: ((t: number, dt: number) => void)[] = [];

		// ---- the medusa: the bell squeezes, the water goes down, the camera follows the medusa
		{
			const PER = 2.4;
			const SQ = 0.35; // с, the squeeze
			const bell = $<SVGPathElement>('[data-bell]');
			const bellIn = $<SVGPathElement>('[data-bell-in]');
			const tent = $<SVGPathElement>('[data-tent]');
			const jetsG = $<SVGGElement>('[data-jelly-jets]');
			const jetPaths = [...jetsG.querySelectorAll<SVGPathElement>('.ird-water-jet')];
			const vS = $<SVGPathElement>('[data-vj]');
			const vH = $<SVGPathElement>('[data-vjh]');
			const specksG = $<SVGGElement>('[data-specks]');
			const specks = Array.from({ length: 16 }, (_, i) => {
				const c = el('circle', { class: 'ird-speck', r: f1(0.6 + 0.6 * hash(i, 3)) });
				specksG.append(c);
				return { c, x: 6 + 168 * hash(i, 1), y: 130 * hash(i, 2) };
			});
			const speed = (ph: number) => (ph < SQ ? Math.sin((Math.PI / 2) * (ph / SQ)) : Math.exp(-(ph - SQ) / 0.7)); // 0…1
			steps.push((t, dt) => {
				const ph = t % PER;
				const k = ph < SQ ? ease(ph / SQ) : 1 - ease((ph - SQ) / 1.6); // the squeeze 0…1
				const w = 28 * (1 - 0.22 * k);
				const top = 26 - 5 * k;
				const C = 90;
				bell.setAttribute('d', `M${f1(C - w)} 64 Q${f1(C - w)} ${f1(top)} ${C} ${f1(top)} Q${f1(C + w)} ${f1(top)} ${f1(C + w)} 64 Q${f1(C + 0.5 * w)} 58 ${C} 60 Q${f1(C - 0.5 * w)} 58 ${f1(C - w)} 64 Z`);
				bellIn.setAttribute('d', `M${f1(C - 0.71 * w)} 56 Q${f1(C - 0.64 * w)} ${f1(top + 10)} ${C} ${f1(top + 8)} Q${f1(C + 0.64 * w)} ${f1(top + 10)} ${f1(C + 0.71 * w)} 56`);
				let d = '';
				for (const [i, f] of [-0.7, -0.36, 0.36, 0.7].entries()) {
					const x0 = C + f * w;
					const s = 3 * Math.sin((2 * Math.PI * ph) / PER + i);
					d += `M${f1(x0)} 62 q${f1(-s)} 14 ${f1(s * 0.6)} 26 q${f1(s)} 12 ${f1(-s * 0.4)} 26 `;
				}
				tent.setAttribute('d', d.trim());
				// the water: strong right after the squeeze, fading out
				const wj = ph < SQ ? ph / SQ : Math.max(0, 1 - (ph - SQ) / 0.9);
				jetsG.setAttribute('opacity', f1(wj));
				for (const p of jetPaths) p.style.strokeDashoffset = f1(-ph * 30);
				const v = speed(ph);
				arrow(vS, vH, 140, 78, 140, 78 - (14 + 28 * v), 7, 4);
				for (const s of specks) {
					s.y += (8 + 46 * v) * dt;
					if (s.y > 132) s.y -= 134;
					s.c.setAttribute('cx', f1(s.x));
					s.c.setAttribute('cy', f1(s.y));
				}
			});
		}

		// ---- the jet ski rider, seated, hands on the handlebar; the waves go back, the drops fly from the nozzle
		{
			const S = 0.4;
			const H = 175;
			const rider = figure($<SVGGElement>('[data-ski-rider]'), { s: S, H, clothes: 'indoor', shirt: 'hm-red', name: 'rider' });
			const hip: Pt = { x: 84, y: 68 };
			rider.pose({
				hip,
				lean: 0.45,
				head: -0.3,
				ankles: [
					{ x: 104, y: 80 },
					{ x: 101, y: 80 },
				],
				feet: [0, 0],
				hands: [
					{ at: { x: 110, y: 59 }, pose: 'grip', d: 3, contact: 'handlebar' },
					{ at: { x: 108, y: 59.5 }, pose: 'grip', d: 3, contact: 'handlebar' },
				],
			});
			const bob = $<SVGGElement>('[data-bob]');
			const spray = $<SVGPathElement>('[data-spray]');
			const wavesG = $<SVGGElement>('[data-waves]');
			const crests = Array.from({ length: 8 }, (_, i) => {
				const p = el('path', { class: 'ird-crest', d: '' });
				wavesG.append(p);
				return { p, x0: i * 30 + 12 * hash(i, 4), y: 100 + 24 * hash(i, 5) };
			});
			const dropsG = $<SVGGElement>('[data-drops]');
			const drops = Array.from({ length: 9 }, (_, i) => {
				const c = el('circle', { class: 'ird-drop', r: f1(0.9 + 0.5 * hash(i, 6)) });
				dropsG.append(c);
				return { c, ph: i / 9, vx: -(55 + 25 * hash(i, 7)), vy: -(10 + 14 * hash(i, 8)) };
			});
			steps.push((t) => {
				const a = (2 * Math.PI * t) / 1.6;
				bob.setAttribute('transform', `translate(0 ${f1(Math.sin(a))}) rotate(${(0.9 * Math.sin(a + 0.8)).toFixed(2)} 100 88)`);
				spray.setAttribute('transform', `translate(50 90) scale(${(1 + 0.08 * Math.sin(t * 9)).toFixed(3)} 1) translate(-50 -90)`);
				for (const c of crests) {
					const x = (((c.x0 - 40 * t) % 240) + 240) % 240 - 30;
					c.p.setAttribute('d', `M${f1(x)} ${f1(c.y)} q5 -3 10 0`);
				}
				for (const d of drops) {
					const age = frac(t / 0.7 + d.ph) * 0.7;
					d.c.setAttribute('cx', f1(48 + d.vx * age));
					d.c.setAttribute('cy', f1(87 + d.vy * age + 0.5 * 90 * age * age));
					d.c.setAttribute('opacity', f1(1 - age / 0.7));
				}
			});
		}

		// ---- two firefighters holding the hose, leaning forward; the water of the jet flows out
		{
			const S = 0.5;
			const GY = 122;
			const ank = ANKLE_CM.boot * S;
			// the hose: from the ground at the left edge, up to the rear man's hands, straight to the nozzle
			const A: Pt = { x: 30, y: 74 };
			const B: Pt = { x: 136, y: 61.5 };
			const on = (x: number): Pt => ({ x, y: A.y + ((B.y - A.y) * (x - A.x)) / (B.x - A.x) });
			const hoseD = `M-2 120 Q14 118 20 96 Q24 78 ${A.x} ${A.y} L${B.x} ${B.y}`;
			const dir = Math.atan2(B.y - A.y, B.x - A.x);
			const man = (key: string, H: number, hipX: number, hands: [number, number], shirt: string) => {
				const f = figure($<SVGGElement>(`[data-ff-${key}]`), { s: S, H, clothes: 'indoor', shirt, covering: 'glove', name: `firefighter-${key}` });
				const u = H * S;
				const hip: Pt = { x: hipX, y: GY - ank - 0.455 * u };
				f.pose({
					hip,
					lean: 0.28,
					head: -0.2,
					ankles: [
						{ x: hipX + 0.1 * u, y: GY - ank },
						{ x: hipX - 0.14 * u, y: GY - ank },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: on(hands[0]), pose: 'grip', d: 7, dir: dir + Math.PI / 2, contact: 'hose' },
						{ at: on(hands[1]), pose: 'grip', d: 7, dir: dir + Math.PI / 2, contact: 'hose' },
					],
				});
				// the hose passes in front of the body and the far hand, behind the near arm: a copy of it goes into the
				// person's group right before the near arm (indoor clothes: far, near legs, neck, torso, seam, head, then
				// the near arm)
				const root = $<SVGGElement>(`[data-ff-${key}]`).firstElementChild!;
				const copy = document.createElementNS('http://www.w3.org/2000/svg', 'path');
				copy.setAttribute('class', 'ird-hose');
				const from = on(hipX - 0.1 * u);
				copy.setAttribute('d', key === 'rear' ? hoseD : `M${from.x} ${from.y} L${B.x} ${B.y}`);
				root.insertBefore(copy, root.children[6] ?? null);
			};
			// both hands of each man wrap the hose in front of his chest, the far hand nearer to the body
			man('rear', 170, 52, [84, 72], 'hm-gold');
			man('front', 175, 96, [128, 116], 'hm-gold');
			const stream = $<SVGPathElement>('[data-stream]');
			const dropsG = $<SVGGElement>('[data-hose-drops]');
			const drops = Array.from({ length: 8 }, (_, i) => {
				const c = el('circle', { class: 'ird-drop', r: f1(0.8 + 0.5 * hash(i, 9)) });
				dropsG.append(c);
				return { c, ph: i / 8, dy: 4 * (hash(i, 10) - 0.5) };
			});
			steps.push((t) => {
				stream.style.strokeDashoffset = f1(-t * 36);
				for (const d of drops) {
					const age = frac(t / 0.9 + d.ph) * 0.9;
					d.c.setAttribute('cx', f1(147 + 42 * age));
					d.c.setAttribute('cy', f1(61 + d.dy - 10 * age + 22 * age * age));
				}
			});
		}

		// ---- the airliner: air in, gas out, the clouds below go back
		{
			const air = [...fig.querySelectorAll<SVGPathElement>('[data-air]')];
			const gas = [...fig.querySelectorAll<SVGPathElement>('[data-gas]')];
			const cloudsG = $<SVGGElement>('[data-clouds]');
			const clouds = Array.from({ length: 3 }, (_, i) => {
				const p = el('path', { class: 'ird-cloud', d: '' });
				cloudsG.append(p);
				return { p, x0: i * 80 + 20 * hash(i, 11), y: 116 + 6 * hash(i, 12), s: 0.8 + 0.4 * hash(i, 13) };
			});
			steps.push((t) => {
				for (const p of air) p.style.strokeDashoffset = f1(-t * 16);
				for (const p of gas) p.style.strokeDashoffset = f1(-t * 60);
				for (const c of clouds) {
					const x = (((c.x0 - 30 * t) % 240) + 240) % 240 - 40;
					const s = c.s;
					c.p.setAttribute('d', `M${f1(x)} ${f1(c.y)} q${f1(2 * s)} ${f1(-7 * s)} ${f1(9 * s)} ${f1(-5 * s)} q${f1(5 * s)} ${f1(-7 * s)} ${f1(12 * s)} ${f1(-1 * s)} q${f1(7 * s)} ${f1(-2 * s)} ${f1(8 * s)} ${f1(6 * s)} Z`);
				}
			});
		}

		// ---- the hunter: aims, fires; the bullet flies to the target, the rifle and the shoulder go back together
		{
			const S = 0.46; // px per см
			const H = 178;
			const GY = 122;
			const u = S * H;
			const ank = ANKLE_CM.trainer * S;
			const PER = 4.2;
			const TF = 1.8; // the shot
			const TB = 0.35; // the bullet's flight, slowed
			const R = 3; // px, how far the rifle and the shoulder go back (exaggerated)
			const BUTT: Pt = { x: 36, y: 60 }; // the butt while aiming
			const MUZZLE = 110 * S;
			const tgtX = 166;
			const tgtY = BUTT.y - 1.7 * S;
			const target = $<SVGGElement>('[data-target]');
			target.setAttribute('transform', `translate(0 ${f1(tgtY)})`);
			$<SVGRectElement>('.ird-post').setAttribute('height', f1(GY - tgtY));
			const hole = $<SVGCircleElement>('[data-hole]');
			const flash = $<SVGPathElement>('[data-flash]');
			const bullet = $<SVGEllipseElement>('[data-bullet]');
			const trail = $<SVGPathElement>('[data-trail]');
			const vS = $<SVGPathElement>('[data-vr]');
			const vH = $<SVGPathElement>('[data-vrh]');
			const vL = $<SVGTextElement>('[data-vrl]');
			const hg = $<SVGGElement>('[data-hunter]');
			const hunter = figure(hg, { s: S, H, clothes: 'indoor', shirt: 'hm-green', name: 'hunter' });
			// the rifle goes into the hunter's group before the near arm, with a layer behind it for the far parts of the
			// near hand's fingers (indoor clothes: far arm, far and near legs, neck, torso, seam, head, then the near arm)
			const root = hg.firstElementChild!;
			const rifle = $<SVGGElement>('[data-rifle]');
			const back = el('g');
			root.insertBefore(back, root.children[6] ?? null);
			root.insertBefore(rifle, root.children[7] ?? null);
			$('[data-rifle-src]').remove();
			hunter.backLayer(0, back);
			const lean0 = 0.08;
			const onRifle = (b: Pt, x: number, y: number): Pt => ({ x: b.x + x * S, y: b.y + y * S });
			const pose = (r: number) => {
				const butt = { x: BUTT.x - r, y: BUTT.y };
				const lean = lean0 - 0.025 * (r / R);
				// the hip is placed so that the near shoulder sits just behind the butt
				const hip0: Pt = { x: 30, y: GY - ank - 0.45 * u };
				const sh = hunter.shoulders(hip0, lean)[0];
				const hip: Pt = { x: hip0.x + (butt.x - 1.2 - sh.x), y: hip0.y + (butt.y + 1 - sh.y) };
				rifle.setAttribute('transform', `translate(${f1(butt.x)} ${f1(butt.y)}) scale(${S})`);
				hunter.pose({
					hip,
					lean,
					head: 0.3,
					ankles: [
						{ x: 40, y: GY - ank },
						{ x: 18, y: GY - ank },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: onRifle(butt, 29, 7.5), pose: 'grip', d: 4, dir: 0.15, roll: -1.4, contact: 'rifle grip' },
						{ at: onRifle(butt, 64, 1.7), pose: 'grip', d: 6.5, dir: -1.25, contact: 'fore-end' },
					],
				});
				return butt;
			};
			steps.push((t) => {
				const ph = t % PER;
				const s = ph - TF; // since the shot
				const r = s < 0 ? 0 : s < 0.06 ? R * ease(s / 0.06) : s < 0.9 ? R * (1 - ease((s - 0.06) / 0.84)) : 0;
				const butt = pose(r);
				const my = butt.y - 1.7 * S;
				const mx = butt.x + MUZZLE;
				// the flash at the muzzle
				const fOn = s >= 0 && s < 0.12;
				flash.setAttribute('opacity', fOn ? '1' : '0');
				if (fOn) {
					// a burst in front of the muzzle: eight rays, the forward ones longer
					let d = '';
					for (let i = 0; i < 8; i++) {
						const a = (i * Math.PI) / 4;
						const L = 2.2 + 3.6 * Math.max(0, Math.cos(a));
						const a1 = a - 0.32;
						const a2 = a + 0.32;
						const cx = mx + 2.6;
						d += `${i ? 'L' : 'M'}${f1(cx + 1.1 * Math.cos(a1))} ${f1(my + 1.1 * Math.sin(a1))} L${f1(cx + L * Math.cos(a))} ${f1(my + L * Math.sin(a))} L${f1(cx + 1.1 * Math.cos(a2))} ${f1(my + 1.1 * Math.sin(a2))} `;
					}
					flash.setAttribute('d', `${d}Z`);
				}
				// the bullet
				const bOn = s >= 0 && s < TB;
				const bx = mx + (tgtX - 10 - mx) * (s / TB);
				bullet.setAttribute('opacity', bOn ? '1' : '0');
				bullet.setAttribute('cx', f1(bx));
				bullet.setAttribute('cy', f1(my));
				trail.setAttribute('opacity', bOn ? '0.8' : '0');
				trail.setAttribute('d', bOn ? `M${f1(Math.max(mx + 4, bx - 22))} ${f1(my)} H${f1(bx - 2.5)}` : '');
				// the hole stays until the loop restarts
				hole.setAttribute('opacity', s >= TB && ph < PER - 0.3 ? '1' : s >= TB ? f1((PER - ph) / 0.3) : '0');
				// the rifle's velocity while it goes back
				const vOn = s >= 0 && s < 0.45;
				if (vOn) arrow(vS, vH, 70, 49, 56, 49, 6, 3.5);
				else arrow(vS, vH, 0, 0, 0, 0);
				vL.setAttribute('x', '74');
				vL.setAttribute('y', '52');
				vL.setAttribute('visibility', vOn ? 'visible' : 'hidden');
			});
		}

		let t = 0;
		const frame = (dt: number) => {
			t += dt;
			for (const s of steps) s(t, dt);
			vecMarks(fig);
		};
		frame(0);
		vecAuto(fig);
		loop(fig, (dt) => {
			frame(dt);
			return true;
		});
	}
</script>
