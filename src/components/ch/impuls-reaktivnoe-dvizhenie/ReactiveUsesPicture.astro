---
/**
 * Small pictures to «Где это встречается» (static, not to scale). In each the body throws part of a substance one way
 * and itself moves the other way; the body's velocity is a blue arrow.
 * Medusa: the bell squeezes and pushes water out of its opening downward; the jellyfish moves up, bell first (a few
 *   сантиметров per second).
 * Squirting cucumber (бешеный огурец): the ripe fruit breaks off its stalk and its contents (seeds in slime) shoot out
 *   of the hole at about 10 м/с one way; the fruit itself flies the other way.
 * Jet ski: a pump takes in water from under the hull and throws it back out of the nozzle in the stern; the jet ski
 *   moves forward. A rider (people kit, 175 см, 0,4 px per см) sits holding the handlebar.
 * Fire hose: two firefighters (people kit, 175 и 170 см, 0,5 px per см) hold the hose and lean forward: the jet (for
 *   example 15 л/с at 30 м/с) pushes the nozzle back with ρQυ = 1000 · 0,015 · 30 = 450 Н (red arrow), too much for
 *   one person to hold steady.
 * Jet engine: the engine of an airliner takes air in at the front and throws hot gas out at the back much faster; the
 *   airliner flies forward. Gray arrows: air in; orange: gas out.
 * The hands of the people are 9 px or less: mittens of the kit (gloves for the firefighters).
 */
import IrdStyles from './IrdStyles.astro';

const ar = (x1: number, y1: number, x2: number, y2: number, hl = 7, hw = 4) => {
	const L = Math.hypot(x2 - x1, y2 - y1);
	const ux = (x2 - x1) / L;
	const uy = (y2 - y1) / L;
	const bx = x2 - ux * hl;
	const by = y2 - uy * hl;
	return {
		shaft: `M${x1} ${y1} L${(bx + ux * 0.5).toFixed(1)} ${(by + uy * 0.5).toFixed(1)}`,
		head: `M${x2} ${y2} L${(bx - uy * hw).toFixed(1)} ${(by + ux * hw).toFixed(1)} L${(bx + uy * hw).toFixed(1)} ${(by - ux * hw).toFixed(1)} Z`,
	};
};
const vJelly = ar(140, 78, 140, 36);
const vCuc = ar(56, 38, 26, 20);
const vSki = ar(132, 36, 172, 36);
const vJet = ar(118, 18, 168, 18);
const fHose = ar(147, 54, 119, 54, 7, 4); // on the nozzle, backward
const jets = {
	jelly: [ar(84, 66, 80, 100, 5, 3), ar(90, 66, 90, 104, 5, 3), ar(96, 66, 100, 100, 5, 3)],
	airIn: [ar(176, 52, 140, 52, 5, 3), ar(176, 62, 140, 62, 5, 3), ar(176, 72, 140, 72, 5, 3)],
	gasOut: [ar(54, 58, 6, 56, 5, 3), ar(54, 66, 2, 66, 5, 3), ar(54, 74, 6, 76, 5, 3)],
};
const seeds = Array.from({ length: 16 }, (_, i) => {
	const a = 0.55 + (Math.sin(i * 3.7) * 0.5 + 0.5) * 0.35;
	const r = 14 + i * 4.2;
	return { x: 82 + r * Math.cos(a), y: 52 + r * Math.sin(a), rot: (a * 180) / Math.PI };
});
---

<IrdStyles />
<figure class="g7 g7--pic ird not-content" data-ird-uses>
	<div class="g7__grid is-three ird-uses">
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Медуза сжимает купол и выталкивает воду вниз, а сама движется вверх">
				<rect class="ird-sea" x="0" y="0" width="180" height="130" rx="6"></rect>
				<path class="ird-tent" d="M70 62 q-4 14 2 26 q6 12 0 26 M80 64 q4 14 -2 28 q-5 12 2 22 M100 64 q-4 14 2 28 q5 12 -2 22 M110 62 q4 14 -2 26 q-6 12 0 26"></path>
				<path class="ird-bell" d="M62 64 Q62 26 90 26 Q118 26 118 64 Q104 58 90 60 Q76 58 62 64 Z"></path>
				<path class="ird-bell-in" d="M70 56 Q72 36 90 34 Q108 36 110 56"></path>
				{jets.jelly.map((j) => (
					<g>
						<path class="ird-water-jet" d={j.shaft}></path>
						<path class="ird-water-head" d={j.head}></path>
					</g>
				))}
				<path class="arrow arrow--blue" d={vJelly.shaft}></path>
				<path class="head--blue" d={vJelly.head}></path>
				<text class="t-small t-blue t-i" x="146" y="44">υ</text>
			</svg>
			<p>Медуза</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Плод бешеного огурца отрывается от плодоножки: семена со слизью вылетают в одну сторону, плод летит в другую">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<rect class="ird-soil" x="0" y="118" width="180" height="12"></rect>
				<path class="ird-stem" d="M132 118 Q128 98 122 84 M126 98 Q140 92 150 98 M124 92 Q110 86 104 94"></path>
				<path class="ird-leaf" d="M150 98 q12 -12 22 -4 q-8 12 -22 4 Z M104 94 q-12 -10 -22 -2 q8 12 22 2 Z"></path>
				{seeds.map((s) => <ellipse class="ird-seed" cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} rx="2.4" ry="1.3" transform={`rotate(${s.rot.toFixed(0)} ${s.x.toFixed(1)} ${s.y.toFixed(1)})`}></ellipse>)}
				<path class="ird-slime" d="M84 54 Q104 68 122 80 Q104 74 82 58 Z"></path>
				<g transform="rotate(32 70 46)">
					<ellipse class="ird-cucumber" cx="70" cy="46" rx="17" ry="8"></ellipse>
					<path class="ird-bristle" d="M58 40 l-1 -3 M64 39 l0 -3 M70 38 l0 -3 M76 39 l1 -3 M60 53 l-1 3 M68 54 l0 3 M76 53 l1 3"></path>
					<ellipse class="ird-hole" cx="87" cy="46" rx="1.6" ry="3"></ellipse>
				</g>
				<path class="arrow arrow--blue" d={vCuc.shaft}></path>
				<path class="head--blue" d={vCuc.head}></path>
				<text class="t-small t-blue t-i" x="20" y="34">υ</text>
			</svg>
			<p>Бешеный огурец</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Гидроцикл с водителем: из сопла на корме назад бьёт струя воды, гидроцикл движется вперёд">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<rect class="ird-sea" x="0" y="92" width="180" height="38"></rect>
				<path class="ird-water-spray" d="M50 88 Q30 82 4 90 Q28 86 50 92 Z"></path>
				<circle class="ird-drop" cx="18" cy="82" r="1.3"></circle>
				<circle class="ird-drop" cx="30" cy="80" r="1.1"></circle>
				<circle class="ird-drop" cx="10" cy="86" r="1.2"></circle>
				<g data-ski-rider></g>
				<path class="ird-ski" d="M50 82 L54 92 L132 92 Q150 90 158 80 L128 76 L112 72 L100 76 L56 76 Z"></path>
				<path class="ird-ski-seat" d="M66 76 Q66 70 74 70 L98 70 Q102 70 102 76 Z"></path>
				<path class="ird-ski-bar" d="M106 72 L109 59 M104 59 H114"></path>
				<rect class="ird-nozzle" x="46" y="84" width="6" height="6" rx="1"></rect>
				<path class="ird-wake" d="M54 94 Q90 98 132 94"></path>
				<path class="arrow arrow--blue" d={vSki.shaft}></path>
				<path class="head--blue" d={vSki.head}></path>
				<text class="t-small t-blue t-i" x="150" y="30">υ</text>
			</svg>
			<p>Гидроцикл</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Два пожарных держат пожарный рукав и наклоняются вперёд: струя воды бьёт вперёд, а рукав толкает их назад">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<rect class="ird-soil ird-asphalt" x="0" y="122" width="180" height="8"></rect>
				<path class="ird-water-spray" d="M146 60 Q164 52 182 56 L182 62 Q164 58 146 63 Z"></path>
				<circle class="ird-drop" cx="170" cy="66" r="1.2"></circle>
				<circle class="ird-drop" cx="176" cy="70" r="1.1"></circle>
				<g data-ff-rear></g>
				<path class="ird-hose" data-hose d=""></path>
				<g data-ff-front></g>
				<path class="ird-nozzle-ff" d="M136 59 L146 58.5 L146 63 L136 64 Z"></path>
				<path class="arrow arrow--red" d={fHose.shaft}></path>
				<path class="head--red" d={fHose.head}></path>
				<text class="t-small t-red t-i" x="130" y="48">F</text>
			</svg>
			<p>Пожарный рукав</p>
		</div>
		<div class="ird-use">
			<svg class="g7__svg" viewBox="0 0 180 130" role="img" aria-label="Двигатель реактивного самолёта под крылом: спереди он забирает воздух, сзади выбрасывает горячий газ, самолёт летит вперёд">
				<rect class="ird-air" x="0" y="0" width="180" height="130" rx="6"></rect>
				<path class="ird-wing" d="M0 36 L180 26 L180 34 L0 46 Z"></path>
				<path class="ird-pylon" d="M80 40 L76 50 L112 50 L118 38 Z"></path>
				<path class="ird-engine" d="M58 52 Q58 48 64 48 L134 46 Q140 46 140 52 L140 74 Q140 80 134 80 L64 78 Q58 78 58 74 Z"></path>
				<path class="ird-fan" d="M137 50 V76 M134 50 V76"></path>
				<path class="ird-exhaust" d="M58 54 L50 57 L50 72 L58 76 Z"></path>
				{jets.airIn.map((j) => (
					<g>
						<path class="ird-air-jet" d={j.shaft}></path>
						<path class="ird-air-head" d={j.head}></path>
					</g>
				))}
				{jets.gasOut.map((j) => (
					<g>
						<path class="ird-hot-jet" d={j.shaft}></path>
						<path class="ird-hot-head" d={j.head}></path>
					</g>
				))}
				<path class="arrow arrow--blue" d={vJet.shaft}></path>
				<path class="head--blue" d={vJet.head}></path>
				<text class="t-small t-blue t-i" x="152" y="13">υ</text>
				<text class="t-small" x="148" y="96" text-anchor="middle">воздух</text>
				<text class="t-small" x="28" y="96" text-anchor="middle">газ</text>
			</svg>
			<p>Реактивный самолёт</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Каждое тело выбрасывает в одну сторону часть вещества — воду, семена, газ — и само движется в другую. Синие стрелки — скорость тела. Струя отталкивает пожарный рукав назад с силой в сотни ньютонов (красная стрелка), поэтому его держат вдвоём. Рисунки не в масштабе.
	</figcaption>
</figure>

<style is:global>
	.ird-uses .ird-use p {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ird .ird-sea { fill: color-mix(in oklab, var(--ig-vx) 22%, var(--g7-paper)); }
	.ird .ird-air { fill: color-mix(in oklab, var(--ig-vx) 8%, var(--g7-paper)); }
	.ird .ird-soil { fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5)); }
	.ird .ird-asphalt { fill: var(--sl-color-gray-4); }
	.ird .ird-bell { fill: hsl(300, 50%, 75%); fill-opacity: 0.75; stroke: hsl(300, 40%, 55%); stroke-width: 1; }
	.ird .ird-bell-in { fill: none; stroke: hsl(300, 40%, 60%); stroke-width: 1; opacity: 0.7; }
	.ird .ird-tent { fill: none; stroke: hsl(300, 40%, 65%); stroke-width: 1.2; opacity: 0.85; }
	.ird .ird-water-jet { fill: none; stroke: hsl(200, 75%, 62%); stroke-width: 1.6; stroke-dasharray: 3 2; }
	.ird .ird-water-head { fill: hsl(200, 75%, 62%); }
	.ird .ird-water-spray { fill: hsl(200, 75%, 66%); opacity: 0.85; }
	.ird .ird-drop { fill: hsl(200, 75%, 62%); }
	.ird .ird-wake { fill: none; stroke: hsl(200, 60%, 85%); stroke-width: 1; opacity: 0.7; }
	.ird .ird-stem { fill: none; stroke: hsl(110, 40%, 40%); stroke-width: 2; stroke-linecap: round; }
	.ird .ird-leaf { fill: hsl(110, 40%, 42%); }
	.ird .ird-cucumber { fill: hsl(95, 45%, 45%); stroke: hsl(95, 40%, 30%); stroke-width: 1; }
	.ird .ird-bristle { stroke: hsl(95, 30%, 75%); stroke-width: 0.8; }
	.ird .ird-hole { fill: hsl(60, 30%, 25%); }
	.ird .ird-seed { fill: hsl(35, 40%, 30%); }
	.ird .ird-slime { fill: hsl(70, 50%, 70%); opacity: 0.6; }
	.ird .ird-ski { fill: hsl(0, 0%, 94%); stroke: hsl(210, 10%, 40%); stroke-width: 1; }
	.ird .ird-ski-seat { fill: hsl(220, 15%, 22%); }
	.ird .ird-ski-bar { fill: none; stroke: hsl(220, 10%, 25%); stroke-width: 2; stroke-linecap: round; }
	.ird .ird-hose { fill: none; stroke: hsl(45, 30%, 80%); stroke-width: 3.6; stroke-linecap: round; stroke-linejoin: round; }
	.ird .ird-nozzle-ff { fill: hsl(210, 8%, 55%); }
	.ird .ird-wing { fill: var(--sl-color-gray-3); }
	.ird .ird-pylon { fill: var(--sl-color-gray-4); }
	.ird .ird-engine { fill: hsl(210, 10%, 80%); stroke: hsl(210, 10%, 45%); stroke-width: 1; }
	.ird .ird-fan { stroke: hsl(210, 10%, 45%); stroke-width: 1; }
	.ird .ird-exhaust { fill: hsl(210, 8%, 45%); }
	.ird .ird-air-jet { fill: none; stroke: var(--sl-color-gray-2); stroke-width: 1.4; }
	.ird .ird-air-head { fill: var(--sl-color-gray-2); }
	.ird .ird-hot-jet { fill: none; stroke: hsl(28, 95%, 58%); stroke-width: 2; }
	.ird .ird-hot-head { fill: hsl(28, 95%, 58%); }
</style>

<script>
	import { figure, ANKLE_CM } from '@components/people/body';
	import type { Pt } from '@components/people/core';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-ird-uses]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		// ---- the jet ski rider, seated, hands on the handlebar
		{
			const S = 0.4;
			const H = 175;
			const rider = figure($<SVGGElement>('[data-ski-rider]'), { s: S, H, clothes: 'indoor', shirt: 'hm-red', name: 'rider' });
			const hip: Pt = { x: 84, y: 68 };
			rider.pose({
				hip,
				lean: 0.45,
				head: -0.3,
				ankles: [
					{ x: 104, y: 80 },
					{ x: 101, y: 80 },
				],
				feet: [0, 0],
				hands: [
					{ at: { x: 110, y: 59 }, pose: 'grip', d: 3, contact: 'handlebar' },
					{ at: { x: 108, y: 59.5 }, pose: 'grip', d: 3, contact: 'handlebar' },
				],
			});
		}
		// ---- two firefighters holding the hose, leaning forward
		{
			const S = 0.5;
			const GY = 122;
			const ank = ANKLE_CM.boot * S;
			// the hose: from the ground at the left edge, up to the rear man's hands, straight to the nozzle
			const A: Pt = { x: 30, y: 74 };
			const B: Pt = { x: 136, y: 61.5 };
			const on = (x: number): Pt => ({ x, y: A.y + ((B.y - A.y) * (x - A.x)) / (B.x - A.x) });
			const hoseD = `M-2 120 Q14 118 20 96 Q24 78 ${A.x} ${A.y} L${B.x} ${B.y}`;
			const dir = Math.atan2(B.y - A.y, B.x - A.x);
			const man = (key: string, H: number, hipX: number, hands: [number, number], shirt: string) => {
				const f = figure($<SVGGElement>(`[data-ff-${key}]`), { s: S, H, clothes: 'indoor', shirt, covering: 'glove', name: `firefighter-${key}` });
				const u = H * S;
				const hip: Pt = { x: hipX, y: GY - ank - 0.455 * u };
				f.pose({
					hip,
					lean: 0.28,
					head: -0.2,
					ankles: [
						{ x: hipX + 0.1 * u, y: GY - ank },
						{ x: hipX - 0.14 * u, y: GY - ank },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: on(hands[0]), pose: 'grip', d: 7, dir: dir + Math.PI / 2, contact: 'hose' },
						{ at: on(hands[1]), pose: 'grip', d: 7, dir: dir + Math.PI / 2, contact: 'hose' },
					],
				});
				// the hose passes in front of the body and the far hand, behind the near arm: a copy of it goes into the
				// person's group right before the near arm (indoor clothes: far, near legs, neck, torso, seam, head, then
				// the near arm)
				const root = $<SVGGElement>(`[data-ff-${key}]`).firstElementChild!;
				const copy = document.createElementNS('http://www.w3.org/2000/svg', 'path');
				copy.setAttribute('class', 'ird-hose');
				const from = on(hipX - 0.1 * u);
				copy.setAttribute('d', key === 'rear' ? hoseD : `M${from.x} ${from.y} L${B.x} ${B.y}`);
				root.insertBefore(copy, root.children[6] ?? null);
			};
			// both hands of each man wrap the hose in front of his chest, the far hand nearer to the body
			man('rear', 170, 52, [84, 72], 'hm-gold');
			man('front', 175, 96, [128, 116], 'hm-gold');
		}
	}
</script>
