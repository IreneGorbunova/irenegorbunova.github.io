---
/**
 * Styles shared by the pictures and models of «Импульс. Закон сохранения импульса. Реактивное движение» (grade 9),
 * scoped under `.ird` (every figure of the chapter has it next to `g7`). Renders nothing. One color per quantity:
 * velocity blue (`arrow--blue`, --ig-vx, as in «Прямолинейное движение»), momentum violet (`arrow--violet`, thicker),
 * force red (`arrow--red`, --ig-vy, as the forces of «Законы Ньютона»). Vector labels carry a small arrow over the
 * letter (`tspan.t-vec` + vecMarks in ird.ts, class `ird-vec`).
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';
---

<G7Styles />
<KitStyles />
<style is:global>
	.ird .g7__svg .arrow--violet {
		stroke: var(--g7-violet);
		stroke-width: 5;
		stroke-linecap: butt;
	}
	.ird .g7__svg .head--violet {
		fill: var(--g7-violet);
	}
	.ird .g7__svg .t-violet {
		fill: var(--g7-violet);
		font-weight: 600;
	}
	.ird .ird-track {
		fill: color-mix(in oklab, var(--sl-color-gray-4) 70%, var(--ig-vx) 8%);
	}
	.ird .ird-track-line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ird .ird-cart {
		stroke: color-mix(in oklab, var(--sl-color-gray-1) 40%, transparent);
		stroke-width: 1;
	}
	.ird .ird-cart--a {
		fill: color-mix(in oklab, hsl(205, 70%, 55%) 70%, var(--sl-color-gray-4));
	}
	.ird .ird-cart--b {
		fill: color-mix(in oklab, hsl(30, 80%, 55%) 70%, var(--sl-color-gray-4));
	}
	.ird .ird-load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-steel);
		stroke-width: 0.8;
	}
	.ird .ird-wheel {
		fill: var(--sl-color-gray-2);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.ird .ird-hub {
		fill: var(--g7-paper);
	}
	.ird .ird-spring {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.ird .ird-sep {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.ird .ird-ghost {
		opacity: 0.35;
	}
	.ird .ird-space {
		fill: color-mix(in oklab, hsl(230, 40%, 12%) 70%, var(--g7-paper));
	}
	:root[data-theme='light'] .ird .ird-space {
		fill: hsl(214, 40%, 86%);
	}
	:root[data-theme='light'] .ird .ird-star {
		fill: hsl(220, 30%, 45%);
	}
	.ird .ird-star {
		fill: hsl(50, 60%, 92%);
	}
	.ird .ird-gas {
		fill: hsl(32, 95%, 60%);
	}
	.ird .ird-gas-core {
		fill: hsl(48, 100%, 80%);
	}
	.ird .ird-hull {
		fill: hsl(210, 12%, 86%);
		stroke: hsl(215, 15%, 45%);
		stroke-width: 1;
	}
	.ird .ird-fin {
		fill: hsl(355, 65%, 52%);
		stroke: hsl(355, 50%, 35%);
		stroke-width: 0.8;
	}
	.ird .ird-window {
		fill: hsl(205, 60%, 45%);
		stroke: hsl(215, 15%, 45%);
		stroke-width: 1;
	}
	.ird .ird-nozzle {
		fill: hsl(215, 10%, 40%);
	}
	.ird .g7__svg .ird-mass {
		fill: hsl(0, 0%, 100%);
		font-weight: 600;
	}
	.ird .ird-vec {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ird .ird-vec--blue {
		stroke: var(--g7-blue);
	}
	.ird .ird-vec--violet {
		stroke: var(--g7-violet);
	}
	.ird .ird-vec--red {
		stroke: var(--g7-red);
	}
	.ird .ird-vec--gold {
		stroke: var(--g7-gold);
	}
	.ird .ird-vec--green {
		stroke: var(--g7-green);
	}
	.ird .ird-dot {
		fill: var(--g7-ink);
	}
	
</style>
