		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}
	.vlab__scene {
		position: relative;
	}
	.vlab__canvas {
		display: block;
		width: 100%;
		aspect-ratio: 560 / 470;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
	}
	.vlab__badge {
		position: absolute;
		left: 0.6rem;
		top: 0.5rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		background: color-mix(in srgb, var(--sl-color-black) 55%, transparent);
	}
	.vlab__badge:empty {
		display: none;
	}
	.vlab__chart {
		display: block;
		width: 100%;
		height: auto;
	}
	.vlab__grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.vlab__grid line.is-axis {
