		stroke-width: 1.5;
	}
	.vlab__grid text,
	.vlab__axis-name,
	.vlab__boil-label {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
		font-family: var(--__sl-font);
	}
	.vlab__boil {
		stroke: var(--ig-vy);
		stroke-width: 1.5;
		stroke-dasharray: 5 5;
	}
	.vlab__boil-label {
		fill: var(--ig-vy);
	}
	.vlab__curve {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.vlab__dot {
		fill: var(--ig-v);
		stroke: var(--ig-surface);
		stroke-width: 2;
	}
	.vlab__stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.4rem 0.8rem;
		margin: 0.6rem 0 0;
	}
	.vlab__stats div {
		padding: 0.35rem 0.6rem;
