	}
	.vlab__flow-note {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.vlab__meter-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.2rem 0.8rem;
	}
	.vlab__meter-head b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.vlab__state {
		font-weight: 700;
		color: var(--sl-color-gray-2);
	}
	.vlab__state.is-sat {
