---
/**
 * Main model: water in a beaker on a hot plate. Two layers:
 * 1) a "magnified" picture of molecules (canvas): the fastest molecules near the surface fly out,
 *    vapour molecules that hit the surface come back; under a lid the two flows become equal
 *    (saturated vapour); bubbles appear before and during boiling;
 * 2) a real-units heat balance of 0,5 kg of water in a beaker 10 cm wide (true proportions):
 *    P − k(t − 20 °C) − L·J = c·m·Δt/Δτ, evaporation J = h·A·(ρ₀(t) − ρ), boiling at t_кип(p).
 *    h grows with the water temperature (convection over hot water): at 80 °C an open beaker loses
 *    about 14 W by evaporation in still air, the order of measured values (~2–3 kg/(м²·ч)).
 * The t(τ) graph and the live formula Q = L·Δm follow the second layer.
 * `simple` (the humidity chapter): only evaporation — no hot-plate power, no «Где кипятим», no boiling line and
 * no formula; the plate stays off.
 */
interface Props {
	simple?: boolean;
}
const { simple = false } = Astro.props;
const presets = [
	{ id: 'home', label: 'Дома', p: 101.325 },
	{ id: 'elbrus', label: 'Эльбрус', p: 50 },
	{ id: 'everest', label: 'Эверест', p: 33 },
	{ id: 'cooker', label: 'Скороварка', p: 200 },
];
---

<figure class="vlab not-content" data-vlab data-simple={simple ? '' : undefined}>
	<div class="vlab__top">
		<div class="vlab__scene">
			<canvas class="vlab__canvas" data-canvas role="img" aria-label="Стакан с водой на электроплитке: молекулы, пар и пузырьки"></canvas>
			<div class="vlab__badge" data-badge></div>
		</div>
		<div class="vlab__side">
			<svg class="vlab__chart" viewBox="0 0 300 230" role="img" aria-label="График температуры воды от времени" data-chart>
				<g class="vlab__grid" data-grid></g>
				<line class="vlab__boil vlab__full" data-boil-line x1="40" x2="290"></line>
				<text class="vlab__boil-label vlab__full" data-boil-label x="288" text-anchor="end"></text>
				<polyline class="vlab__curve" data-curve points=""></polyline>
				<circle class="vlab__dot" r="4.5" data-now></circle>
				<text class="vlab__axis-name" x="44" y="14"><tspan font-style="italic">t</tspan>, °C</text>
				<text class="vlab__axis-name" x="288" y="194" text-anchor="end">время, мин</text>
			</svg>
			<dl class="vlab__stats">
				<div><dt>Температура воды <i>t</i></dt><dd data-t>—</dd></div>
				<div class="vlab__full"><dt>Кипит при <i>t</i><sub>кип</sub></dt><dd data-tb>—</dd></div>
				<div><dt>Масса воды <i>m</i></dt><dd data-m>—</dd></div>
				<div><dt>Время опыта</dt><dd data-time>—</dd></div>
			</dl>
		</div>
	</div>

	<div class="vlab__vapour">
		<div class="vlab__flows" aria-hidden="true">
			<span class="vlab__flow vlab__flow--out">↑ вылетают <b data-out>0</b></span>
			<span class="vlab__flow vlab__flow--in">↓ возвращаются <b data-in>0</b></span>
			<span class="vlab__flow-note">молекул в модели за 1 с</span>
		</div>
		<div class="vlab__meter">
			<div class="vlab__meter-head">
				<span>Пар над водой: <i>ρ</i> = <b data-rho>—</b></span>
				<span class="vlab__state" data-state>—</span>
			</div>
			<div class="vlab__bar"><span class="vlab__bar-fill" data-rho-bar></span><span class="vlab__bar-max" data-rho0-bar></span></div>
			<div class="vlab__meter-foot">насыщенный пар при этой температуре: <i>ρ</i><sub>0</sub> = <span data-rho0>—</span></div>
		</div>
	</div>

	<div class="vlab__controls">
		<label class="vlab__slider vlab__full">
			<span>Мощность плитки <i>P</i></span>
			<output data-p-out>0 Вт</output>
			<input type="range" min="0" max="1000" step="50" value="0" data-power />
		</label>
		<div class="vlab__group vlab__full" role="group" aria-label="Давление над водой">
			<span class="vlab__group-name">Где кипятим</span>
			<div class="vlab__seg">
				{presets.map((s, i) => (
					<button type="button" class="vlab__segbtn" data-place={s.id} data-p={s.p} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>
				))}
			</div>
		</div>
		<div class="vlab__buttons">
			<button type="button" class="vlab__btn" data-lid aria-pressed="false">Закрыть крышкой</button>
			<button type="button" class="vlab__btn" data-fan aria-pressed="false">Включить вентилятор</button>
			<button type="button" class="vlab__btn" data-fast aria-pressed="false">Ускорить время</button>
		</div>
		<div class="vlab__buttons">
			<button type="button" class="vlab__btn vlab__btn--primary" data-reset="20">Налить воду 20 °C</button>
			<button type="button" class="vlab__btn vlab__btn--primary" data-reset="80">Налить горячую 80 °C</button>
		</div>
	</div>

	<div class="vlab__q vlab__full" data-q aria-live="off"></div>
	<p class="vlab__live" data-live aria-live="polite"></p>

	<figcaption class="vlab__caption">
		<span class="vlab__key vlab__key--slow"></span>медленные молекулы
		<span class="vlab__key vlab__key--fast"></span>быстрые. Кружки лишь показывают, как ведут себя молекулы: на самом деле
		они в миллиарды раз меньше и их несравнимо больше. Числа — для 0,5 кг воды в стакане шириной 10 см; в комнате 20 °C.
		Время в опыте идёт в <span data-k>20</span> раз быстрее, чем на самом деле.
	</figcaption>
</figure>

<style is:global>
	.vlab[data-simple] .vlab__full {
		display: none !important;
	}
	.vlab {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
	}
	.vlab i {
		font-family: var(--ig-font-math);
	}
	.vlab__top {
