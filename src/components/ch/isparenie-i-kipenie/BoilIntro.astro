---
/**
 * Two short looping opening scenes of «Парообразование и конденсация. Кипение».
 * Kitchen: a pot of water on a stove, 10 min in 8 s. The thermometer climbs from 20 °C to 100 °C (about 6 min),
 *   then stays at 100 °C while the water boils; bubbles first collapse on the way up, then grow and burst at the
 *   surface; the water level drops a little (≈10 % of 1,5 kg in 4 min at 1,5 kW). A small t(time) graph follows.
 * Everest: the same pot on a camp stove at 8849 m (≈33 кПа): the water heats from 0 °C, boils at 71 °C and stays
 *   there; the dashed line at 100 °C shows how far it is from boiling at home; the spaghetti hardly soften.
 * Plays only while visible; «Повторить» restarts a scene.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// Shared geometry of the pot (inside: x 102…230, bottom 170) and of the thermometer (0 °C at y 152, 0,9 px per °C).
const pot = 'M100 92 V167 Q100 172 105 172 H227 Q232 172 232 167 V92';
const ty = (t: number) => 152 - 0.9 * t;
const TX = 120;
// Mini graph: t from 0 to 110 °C, time 0…10 min.
const gx = (u: number) => 270 + 72 * u;
const gy = (t: number) => 76 - 0.48 * t;
const flames = [-30, -15, 0, 15, 30];
const flame = (x: number, base: number) => `M ${x} ${base} q -5 -6 0 -15 q 5 9 0 15 z`;
const scenes = [
	{
		id: 'home',
		aria: 'Кастрюля с водой на плите: термометр поднимается до 100 °C и дальше не растёт, пока вода кипит; пузырьки пара растут и лопаются на поверхности',
	},
	{
		id: 'everest',
		aria: 'Кастрюля с водой и макаронами на походной горелке на Эвересте: вода закипает уже при 71 °C, термометр дальше не поднимается, до 100 °C ему далеко',
	},
];
---

<IntroFrame data-boilintro>
	{
		scenes.map((s) => (
			<div class="intro__card" data-scene={s.id}>
				<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label={s.aria}>
					{s.id === 'home' ? (
						<g>
							<rect class="bi-wall" x="0" y="0" width="360" height="188" />
							<rect class="bi-hob" x="40" y="188" width="280" height="14" rx="5" />
							<rect class="bi-front" x="52" y="202" width="256" height="38" />
							<g class="bi-flames">
								{flames.map((dx, j) => (
									<path style={`--d:${(j * 0.13).toFixed(2)}s`} d={flame(166 + dx, 187)} />
								))}
							</g>
						</g>
					) : (
						<g>
							<rect class="bi-sky" x="0" y="0" width="360" height="200" />
							<path class="bi-rock" d="M0 200 L0 150 L40 112 L70 132 L118 70 L150 96 L190 44 L236 104 L262 86 L300 128 L360 96 L360 200 Z" />
							<path class="bi-snow" d="M104 88 L118 70 L132 82 L124 86 L114 82 Z M176 62 L190 44 L206 70 L196 66 L186 72 Z M252 94 L262 86 L274 100 L266 98 Z" />
							<path class="bi-snow" d="M0 196 Q90 186 180 194 T360 192 V240 H0 Z" />
							<text class="bi-place" x="168" y="26" text-anchor="middle">Эверест, 8849 м</text>
							<!-- camp stove: gas canister, burner, pot supports -->
							<rect class="bi-can" x="146" y="206" width="40" height="28" rx="6" />
							<rect class="bi-burner" x="154" y="190" width="24" height="16" rx="3" />
							<path class="bi-legs" d="M156 192 L136 172 M176 192 L196 172" />
							<g class="bi-flames">
								{flames.slice(1, 4).map((dx, j) => (
									<path style={`--d:${(j * 0.17).toFixed(2)}s`} d={flame(166 + dx / 1.5, 189)} />
								))}
							</g>
						</g>
					)}
					<path class="bi-water" d="" data-water />
					{s.id === 'everest' && (
						<g class="bi-pasta" data-pasta>
							{[0, 1, 2, 3, 4].map((i) => (
								<line x1={150 + 8 * i} y1="166" x2={192 + 8 * i} y2={66 + 2 * i} data-stick={i} />
							))}
						</g>
					)}
					<g data-bubbles />
					<path class="bi-pot" d={pot} />
					<path class="bi-ear" d="M100 104 h-9 M232 104 h9" />
					<g class="bi-steam" data-steam>
						{[-36, -6, 24].map((dx, i) => (
							<path style={`--d:${i * 0.5}s`} d={`M ${176 + dx} 86 q -6 -7 0 -14 q 6 -7 0 -14`} />
						))}
					</g>
					<!-- thermometer in the water -->
					<rect class="bi-tube" x={TX - 3} y="38" width="6" height="124" rx="3" />
					<line class="bi-tick" x1={TX - 8} x2={TX - 3} y1={ty(100)} y2={ty(100)} />
					<text class="bi-tlabel" x={TX - 10} y={ty(100) + 4} text-anchor="end">100</text>
					<rect class="bi-col" x={TX - 1.4} y={ty(20)} width="2.8" height={164 - ty(20)} data-col />
					<circle class="bi-col" cx={TX} cy="164" r="5" />
					<rect class="bi-pill" x="12" y="44" width="72" height="26" rx="13" />
					<text class="bi-read" x="48" y="62.5" text-anchor="middle" data-read>20&nbsp;°C</text>
					<!-- clock -->
					<g class="bi-clock">
						<circle cx="22" cy="24" r="9" />
						<path d="M22 24 V18" data-hand />
						<text x="37" y="30" data-clock>0:00</text>
					</g>
					<!-- mini graph t(time) -->
					<rect class="bi-graph" x="244" y="8" width="108" height="86" rx="10" />
					<line class="bi-dash" x1={gx(0)} x2={gx(1)} y1={gy(100)} y2={gy(100)} />
					<text class="bi-glabel" x="266" y={gy(100) + 3.5} text-anchor="end">100</text>
					{s.id === 'everest' && (
						<g>
							<line class="bi-dash bi-dash--b" x1={gx(0)} x2={gx(1)} y1={gy(71)} y2={gy(71)} data-tbline />
							<text class="bi-glabel" x="266" y={gy(71) + 3.5} text-anchor="end">71</text>
						</g>
					)}
					<path class="bi-axis" d={`M${gx(0)} 18 V${gy(0)} H${gx(1) + 4}`} />
					<text class="bi-glabel" x="275" y="21"><tspan font-style="italic">t</tspan>, °C</text>
					<text class="bi-glabel" x={gx(1) + 4} y="89" text-anchor="end">время</text>
					<polyline class="bi-curve" points="" data-curve />
					<circle class="bi-dot" r="3" data-dot />
				</svg>
				<div class="intro__foot">
					{s.id === 'home' ? (
						<p>Вода закипела, и термометр остановился на 100&nbsp;°C, хотя плита греет так же сильно. <More term="Почему?">Пока вода кипит, вся теплота от плиты уходит на то, чтобы превращать воду в пар: в пузырьках, которые растут и лопаются, — водяной пар. Поэтому температура кипящей воды не растёт, пока вся вода не выкипит. На сильном огне вода выкипает быстрее, но горячее не становится&nbsp;— и суп на слабом огне варится так же быстро.</More></p>
					) : (
						<p>На Эвересте вода кипит уже при 71&nbsp;°C, и макароны в ней почти не варятся. <More term="Почему?">На высоте 8849&nbsp;м давление воздуха втрое меньше, чем у моря, — около 33&nbsp;кПа. Чем меньше давление над водой, тем ниже температура, при которой она кипит. Кипящая вода там горячая всего до 71&nbsp;°C, и продукты в ней варятся гораздо дольше. Поэтому высоко в горах готовят в кастрюлях с плотной крышкой — скороварках; о них рассказано ниже.</More></p>
					)}
					<button type="button" class="intro__again" data-again>Повторить</button>
				</div>
			</div>
		))
	}
</IntroFrame>

<style is:global>
	[data-boilintro] {
		--bi-light: var(--sl-color-white);
		--bi-snow: color-mix(in srgb, var(--sl-color-white) 88%, var(--ig-vx));
		--bi-edge: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-3));
	}
	:root[data-theme='light'] [data-boilintro] {
		--bi-light: var(--sl-color-black);
		--bi-snow: var(--sl-color-black);
		--bi-edge: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-gray-2));
	}
	.bi-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.bi-hob {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
	}
	.bi-front {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 80%, var(--ig-surface));
	}
	.bi-sky {
		fill: color-mix(in srgb, var(--ig-vx) 16%, transparent);
	}
	.bi-rock {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 55%, transparent);
	}
	.bi-snow {
		fill: var(--bi-snow);
		stroke: var(--bi-edge);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.bi-place {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.bi-can {
		fill: color-mix(in srgb, var(--ig-vy) 55%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
	}
	.bi-burner {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
	}
	.bi-legs {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.bi-flames path {
		fill: var(--ig-vx);
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: bi-flame 0.45s ease-in-out infinite alternate;
		animation-delay: var(--d);
	}
	@keyframes bi-flame {
		from { transform: scaleY(0.8); }
		to { transform: scaleY(1.1); }
	}
	.bi-water {
		fill: color-mix(in srgb, var(--ig-vx) 42%, transparent);
	}
	.bi-pasta line {
		stroke: color-mix(in srgb, var(--ig-v) 80%, var(--sl-color-white));
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.bi-bubble {
		fill: color-mix(in srgb, var(--bi-light) 22%, transparent);
		stroke: color-mix(in srgb, var(--bi-light) 85%, transparent);
		stroke-width: 1.1;
	}
	.bi-pot {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.bi-ear {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.bi-steam path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linecap: round;
		opacity: 0;
		animation: bi-steam 1.6s ease-in infinite;
		animation-delay: var(--d);
	}
	@keyframes bi-steam {
		0% { opacity: 0; transform: translateY(2px); }
		30% { opacity: calc(0.8 * var(--steam, 0)); }
		100% { opacity: 0; transform: translateY(-12px); }
	}
	.bi-tube {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 25%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.bi-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.bi-tlabel {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	.bi-col {
		fill: var(--sl-color-red);
	}
	.bi-pill,
	.bi-graph {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.bi-read {
		font-size: 16px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.bi-clock circle,
	.bi-clock path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.bi-clock text {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.bi-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.bi-dash {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.bi-dash--b {
		stroke: var(--ig-vx);
	}
	.bi-glabel {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.bi-curve {
		fill: none;
		stroke: var(--sl-color-red);
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.bi-dot {
		fill: var(--sl-color-red);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const f1 = (v: number) => v.toFixed(1);
	const ty = (t: number) => 152 - 0.9 * t;
	const gx = (u: number) => 270 + 72 * u;
	const gy = (t: number) => 76 - 0.48 * t;
	const BOTTOM = 170;
	const LEFT = 102;
	const RIGHT = 230;
	const LEVEL = 106; // water surface before boiling
	const HEAT = 0.58; // part of the run (10 min) spent on heating to the boiling point

	/** Temperature at run fraction x: heats (slowing a little, as with heat losses) to tb, then stays there. */
	const temp = (x: number, t0: number, tb: number) => {
		if (x >= HEAT) return tb;
		const v = x / HEAT;
		return t0 + ((tb - t0) * (1 - Math.exp(-1.1 * v))) / (1 - Math.exp(-1.1));
	};

	const setup = (card: HTMLElement, t0: number, tb: number) => {
		const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
		const water = $<SVGPathElement>('[data-water]');
		const col = $<SVGRectElement>('[data-col]');
		const read = $<SVGTextElement>('[data-read]');
		const clock = $<SVGTextElement>('[data-clock]');
		const hand = $<SVGPathElement>('[data-hand]');
		const curve = $<SVGPolylineElement>('[data-curve]');
		const dot = $<SVGCircleElement>('[data-dot]');
		const steam = $<SVGGElement>('[data-steam]');
		const sticks = Array.from(card.querySelectorAll<SVGLineElement>('[data-stick]'));
		const bubG = $<SVGGElement>('[data-bubbles]');
		const bubbles = Array.from({ length: 18 }, (_, i) => {
			const c = document.createElementNS(NS, 'circle');
			c.setAttribute('class', 'bi-bubble');
			bubG.append(c);
			return {
				c,
				x: 134 + ((i * 41) % 90),
				ph: (i * 0.618) % 1,
				v: 0.55 + ((i * 5) % 4) * 0.12,
				r: 1.3 + ((i * 7) % 3) * 0.4,
				k: ((i * 3) % 18) / 18, // order in which bubbles switch on
			};
		});
		scene(card, 8, (x) => {
			const s = 600 * x; // simulated seconds
			clock.textContent = `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
			const ang = (s / 60) * 2 * Math.PI;
			hand.setAttribute('d', `M22 24 L${f1(22 + 6 * Math.sin(ang))} ${f1(24 - 6 * Math.cos(ang))}`);
			const t = temp(x, t0, tb);
			col.setAttribute('y', f1(ty(t)));
			col.setAttribute('height', f1(164 - ty(t)));
			read.textContent = `${Math.round(t)} °C`;
			// graph up to now
			const pts: string[] = [];
			const n = Math.max(1, Math.round(40 * x));
			for (let i = 0; i <= n; i++) {
				const u = (x * i) / n;
				pts.push(`${f1(gx(u))},${f1(gy(temp(u, t0, tb)))}`);
			}
			curve.setAttribute('points', pts.join(' '));
			dot.setAttribute('cx', f1(gx(x)));
			dot.setAttribute('cy', f1(gy(t)));
			// boiling: b from 0 to 1 over the boiling part; the level drops by 6 px (≈10 % of the water)
			const boiling = x >= HEAT;
			const b = clamp((x - HEAT) / (1 - HEAT));
			const top = LEVEL + 6 * b;
			const now = performance.now() / 1000;
			const amp = boiling ? 1.6 : 0;
			const surf: string[] = [];
			for (let i = 0; i <= 16; i++) {
				const xp = LEFT + ((RIGHT - LEFT) * i) / 16;
				surf.push(`${f1(xp)} ${f1(top + amp * Math.sin(xp / 7 + now * 9) * Math.sin(xp / 23 - now * 3))}`);
			}
			water.setAttribute('d', `M${surf.join(' L')} L${RIGHT} ${BOTTOM} L${LEFT} ${BOTTOM} Z`);
			steam.style.setProperty('--steam', boiling ? '1' : clamp((t - tb + 12) / 12 * 0.4).toFixed(2));
			// bubbles: before boiling they rise a little and collapse; while boiling they grow and burst at the top
			const pre = clamp((t - (tb - 25)) / 25);
			const depth = BOTTOM - top;
			for (const q of bubbles) {
				const on = boiling ? 1 : q.k < pre * 0.6 ? 1 : 0;
				if (!on) {
					q.c.style.opacity = '0';
					continue;
				}
				const f = (q.ph + now * q.v * (boiling ? 1 : 0.7)) % 1;
				const wob = 1.5 * Math.sin(f * 9 + q.ph * 6);
				let y: number;
				let r: number;
				let op: number;
				if (boiling) {
					y = BOTTOM - 3 - f * (depth - 3);
					r = q.r + 3.2 * f;
					op = f < 0.92 ? 1 : (1 - f) / 0.08;
				} else {
					y = BOTTOM - 3 - f * depth * 0.45;
					r = q.r * (f < 0.5 ? 1 : 1 - (f - 0.5) / 0.5);
					op = 1;
				}
				q.c.setAttribute('cx', f1(q.x + wob));
				q.c.setAttribute('cy', f1(y));
				q.c.setAttribute('r', f1(Math.max(0, r)));
				q.c.style.opacity = op.toFixed(2);
			}
			// spaghetti: at 71 °C they hardly soften — they lean only a few degrees
			sticks.forEach((st, i) => {
				const a = b * (2 + 0.5 * i) * (Math.PI / 180);
				const x1 = 150 + 8 * i;
				const dx = 42;
				const dy = 66 + 2 * i - 166;
				st.setAttribute('x2', f1(x1 + dx * Math.cos(a) - dy * Math.sin(a)));
				st.setAttribute('y2', f1(166 + dx * Math.sin(a) + dy * Math.cos(a)));
			});
		});
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-boilintro]')) {
		setup(root.querySelector<HTMLElement>('[data-scene="home"]')!, 20, 100);
		setup(root.querySelector<HTMLElement>('[data-scene="everest"]')!, 0, 71);
	}
</script>
