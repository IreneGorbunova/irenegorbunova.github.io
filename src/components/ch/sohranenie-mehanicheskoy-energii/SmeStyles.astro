---
/**
 * Styles shared by the pictures and models of «Закон сохранения механической энергии» (grade 9), scoped under `.sme`
 * (every figure of the chapter has it next to `g7`). Renders nothing. Colors (sme.ts): forces red, velocity blue,
 * heights and displacement gold; energy bars: kinetic blue, potential gold, full mechanical green, internal violet.
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';
---

<G7Styles />
<KitStyles />
<style is:global>
	.sme {
		--sme-ek: var(--g7-blue);
		--sme-ep: var(--g7-gold);
		--sme-e: var(--g7-green);
		--sme-u: var(--g7-violet);
	}
	.sme-small .g7__grid {
		max-width: 24rem;
		margin-inline: auto;
	}
	.sme .sme-bar-base {
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.sme .sme-bar-ref {
		stroke: var(--sme-e);
		stroke-width: 1;
		stroke-dasharray: 4 3;
		opacity: 0.8;
	}
	.sme .sme-bar-slot {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 45%, transparent);
	}
	.sme .sme-bar--ep {
		fill: var(--sme-ep);
	}
	.sme .sme-bar--ek {
		fill: var(--sme-ek);
	}
	.sme .sme-bar--e {
		fill: var(--sme-e);
	}
	.sme .sme-bar--u {
		fill: var(--sme-u);
	}
	.sme .sme-bar-name--ep {
		fill: var(--sme-ep);
	}
	.sme .sme-bar-name--ek {
		fill: var(--sme-ek);
	}
	.sme .sme-bar-name--e {
		fill: var(--sme-e);
	}
	.sme .sme-bar-name--u {
		fill: var(--sme-u);
	}
	.sme .sme-bar-name .t-i {
		font-size: 15px;
	}
	.sme .sme-sky {
		fill: color-mix(in oklab, var(--ig-vx) 9%, var(--g7-paper));
	}
	.sme .sme-ground {
		fill: var(--g7-ground);
	}
	.sme .sme-grass {
		fill: color-mix(in oklab, var(--g7-green) 45%, var(--g7-ground));
	}
	.sme .sme-ref {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 4 3;
		fill: none;
	}
	.sme .sme-ball {
		fill: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.sme .sme-mark {
		fill: var(--sl-color-gray-3);
		opacity: 0.4;
	}
	.sme .sme-mark--down {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		opacity: 0.6;
	}
	.sme .sme-steel {
		fill: var(--g7-steel);
		stroke: var(--g7-steel-dark);
		stroke-width: 1;
	}
	.sme .sme-wood {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.sme .sme-bracket {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.sme .sme-pt {
		fill: var(--g7-ink);
	}
	.sme .sme-out {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.sme .sme-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.sme .sme-switch input {
		width: 1.05rem;
		height: 1.05rem;
		accent-color: var(--sl-color-accent);
	}
</style>
