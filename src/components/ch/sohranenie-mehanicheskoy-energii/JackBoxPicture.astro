---
/**
 * Picture «Чёртик из табакерки»: an everyday example of the energy of an elastically deformed body (grade 9, section
 * «Кинетическая и потенциальная энергия»). A toy box 15 см wide and 14 см high; inside, a spring of stiffness
 * 50 Н/м and free length 20 см is squeezed to 6 см, x = 14 см, under the lid: it stores kx²/2 = 50 · 0,14² / 2 =
 * 0,49 Дж. The lid opens, the spring straightens and throws the toy's head (30 г) up; the head bobs on the spring and
 * settles: the deflection from the rest position (the spring sags mg/k = 0,03 · 9,8 / 50 = 0,59 см) is
 * u(t) = −13,4 см · e^(−t/0,2 с) · cos(ωt), ω = √(k/m) = √(50 / 0,03) = 40,8 1/с (a swing of 0,15 с; the damping
 * stands for the losses in a real toy). Then the picture fades and starts closed again (no one is drawn closing it).
 * To scale: 4 px per сантиметр; the bobbing is slowed 6 times. The head is a toy (a ball with a painted face and a
 * jester's cap), not a person.
 */
import SmeStyles from './SmeStyles.astro';
---

<SmeStyles />
<figure class="g7 g7--pic sme sme-small not-content" data-sme-jack>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 206" role="img" aria-label="Игрушка: из коробки на пружине выскакивает голова в колпаке и качается вверх-вниз">
			<rect class="sme-sky" x="0" y="0" width="360" height="190"></rect>
			<rect class="sme-wood" x="0" y="190" width="360" height="16"></rect>
			<g data-all>
				<path class="sme-spring" data-spring d=""></path>
				<g data-head>
					<path class="sme-ruff" d="M-14 10 Q-7 16 0 11 Q7 16 14 10 Q7 6 0 8 Q-7 6 -14 10 Z"></path>
					<circle class="sme-face" cx="0" cy="0" r="11"></circle>
					<circle class="sme-eye" cx="-4" cy="-1.5" r="1.4"></circle>
					<circle class="sme-eye" cx="4" cy="-1.5" r="1.4"></circle>
					<path class="sme-smile" d="M-4.5 3.5 Q0 7.5 4.5 3.5"></path>
					<circle class="sme-nose" cx="0" cy="1.5" r="1.8"></circle>
					<path class="sme-cap sme-cap--a" d="M-11 -5 Q-12 -16 -21 -18 Q-10 -21 -1 -9 Z"></path>
					<path class="sme-cap sme-cap--b" d="M11 -5 Q12 -16 21 -18 Q10 -21 1 -9 Z"></path>
					<path class="sme-cap sme-cap--c" d="M-11 -5 Q0 -13 11 -5 L1 -9 L-1 -9 Z"></path>
					<circle class="sme-bell" cx="-21" cy="-18" r="2.2"></circle>
					<circle class="sme-bell" cx="21" cy="-18" r="2.2"></circle>
				</g>
				<!-- the box in front of the spring and the head: inside it they are hidden -->
				<rect class="sme-box" x="150" y="134" width="60" height="56" rx="2"></rect>
				<path class="sme-box-deco" d="M150 152 H210 M150 172 H210"></path>
				<rect class="sme-lid" data-lid x="0" y="-4" width="62" height="5" rx="1.5"></rect>
			</g>
			<text class="t-small t-halo" data-note x="180" y="22" text-anchor="middle"></text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		«Чёртик из табакерки»: в коробке под крышкой сжата пружина. Когда крышка открывается, пружина распрямляется и подбрасывает голову игрушки. Пружина жёсткостью 50&nbsp;Н/м сжата на 14&nbsp;см. Качания замедлены в 6&nbsp;раз.
	</figcaption>
</figure>

<style is:global>
	.sme .sme-box {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--g7-paper));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.sme .sme-box-deco {
		stroke: color-mix(in oklab, var(--g7-gold) 80%, var(--g7-paper));
		stroke-width: 3;
	}
	.sme .sme-lid {
		fill: color-mix(in oklab, var(--g7-red) 70%, var(--g7-paper));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.sme .sme-face {
		fill: hsl(32, 70%, 86%);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.sme .sme-eye {
		fill: #2b2b2b;
	}
	.sme .sme-nose {
		fill: hsl(0, 70%, 55%);
	}
	.sme .sme-smile {
		fill: none;
		stroke: #2b2b2b;
		stroke-width: 1;
		stroke-linecap: round;
	}
	.sme .sme-ruff {
		fill: #f4f4f4;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.7;
	}
	.sme .sme-cap {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.7;
	}
	.sme .sme-cap--a {
		fill: hsl(210, 60%, 55%);
	}
	.sme .sme-cap--b {
		fill: hsl(45, 85%, 55%);
	}
	.sme .sme-cap--c {
		fill: hsl(140, 45%, 48%);
	}
	.sme .sme-bell {
		fill: hsl(45, 90%, 60%);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.6;
	}
	[data-sme-jack] .sme-spring {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { f1, setLabel } from './sme';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-sme-jack]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const S = 4; // px per см
		const BASE = 188; // the bottom of the spring
		const L0 = 20; // free length, см
		const XC = 14; // the compression in the box, см
		const SAG = (0.03 * 9.8) / 50 * 100; // см
		const A = XC - SAG; // см
		const W = Math.sqrt(50 / 0.03);
		const TAU = 0.2;
		const SLOW = 6;
		const T_OPEN = 2.0; // screen seconds closed
		const T_BOB = 4.6;
		const T_FADE = 0.5;
		const CYCLE = T_OPEN + T_BOB + T_FADE;
		const spring = $<SVGPathElement>('[data-spring]');
		const head = $<SVGGElement>('[data-head]');
		const lid = $<SVGRectElement>('[data-lid]');
		const all = $<SVGGElement>('[data-all]');
		const note = $<SVGTextElement>('[data-note]');
		setLabel(note, [['E', 'п'], ' = ', ['kx'], '²/2 = 50 Н/м · (0,14 м)² / 2 = 0,49 Дж']);
		let clock = 0;
		const coils = (top: number) => {
			const n = 12;
			let p = `M180 ${BASE} V${f1(BASE - 2)}`;
			const a = BASE - 2;
			const b = top + 2;
			for (let i = 0; i < n; i++) p += ` L${i % 2 ? 187 : 173} ${f1(a + ((i + 0.5) * (b - a)) / n)}`;
			return p + ` L180 ${f1(b)} V${f1(top)}`;
		};
		const draw = () => {
			const c = clock % CYCLE;
			let len = L0 - XC; // the spring's length, см
			let ang = 0; // the lid, degrees (0 closed, −125 open)
			if (c >= T_OPEN - 0.15) ang = -125 * Math.min(1, (c - (T_OPEN - 0.15)) / 0.3);
			if (c >= T_OPEN) {
				const tr = (c - T_OPEN) / SLOW;
				len = L0 - SAG - A * Math.exp(-tr / TAU) * Math.cos(W * tr);
			}
			const top = BASE - len * S;
			spring.setAttribute('d', coils(top));
			head.setAttribute('transform', `translate(180 ${f1(top - 10)})`);
			lid.setAttribute('transform', `translate(149 134) rotate(${f1(ang)})`);
			const fade = c > T_OPEN + T_BOB ? 1 - (c - T_OPEN - T_BOB) / T_FADE : c < 0.4 ? c / 0.4 : 1;
			all.setAttribute('opacity', f1(Math.max(0, Math.min(1, fade))));
			note.setAttribute('visibility', c < T_OPEN ? 'visible' : 'hidden');
		};
		loop(fig, (dt) => {
			clock += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
