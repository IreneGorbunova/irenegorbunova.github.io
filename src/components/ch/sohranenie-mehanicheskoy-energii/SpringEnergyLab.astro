---
/**
 * Model «Энергия сжатой пружины» (grade 9, section «Кинетическая и потенциальная энергия»).
 * A light spring on a smooth table is fixed to a wall; a steel ball of 0,1 кг rests against the plate at its free end.
 * The slider compresses the spring by x = 0…10 см (a catch holds the ball); the spring has k = 200 Н/м or 400 Н/м.
 *   The elastic force F_упр = kx (Hooke's law, red arrow on the ball, 1,1 px per newton): at most 400 · 0,10 = 40 Н.
 *   The graph F_упр(x) is a straight line through zero (the other spring dashed gray); the gold triangle under it up
 *   to the present x has the area ½ · kx · x — the work needed to compress the spring, its energy E_п = kx²/2:
 *   k = 200 Н/м: x = 2, 4, 6 см → 4, 8, 12 Н and 0,04, 0,16, 0,36 Дж; x = 5 см → 10 Н, 0,25 Дж; x = 10 см → 20 Н, 1,00 Дж.
 *   k = 400 Н/м: x = 10 см → 40 Н, 2,00 Дж.
 * «Отпустить»: the catch drops, the spring straightens and pushes the ball: x(t) = x₀ cos ωt, ω = √(k/m) (the spring's
 *   own mass neglected). At the free length the ball leaves the plate with υ = x₀ω and rolls on without friction:
 *   k = 400, x₀ = 10 см: ω = 63,2 1/с, υ = 6,32 м/с, E_к = mυ²/2 = 2,00 Дж; k = 200, x₀ = 10 см: υ = 4,47 м/с, 1,00 Дж.
 *   The push lasts (π/2)/ω = 0,025 с (k = 400) or 0,035 с (k = 200): the motion is slowed 40 times.
 * To scale: the spring and the ball 8 px per сантиметр (free length 20 см, the ball 3 см across); the graph 16 px per
 * сантиметр and 3,4 px per newton. Colors of the chapter: forces red, the energy of the spring gold (potential).
 */
import SmeStyles from './SmeStyles.astro';
import katex from 'katex';
const kv = (s: string) => katex.renderToString(s, { throwOnError: false });
const GX0 = 40;
const GY0 = 168;
---

<SmeStyles />
<figure class="g7 sme not-content" data-sme-spring>
	<svg class="g7__svg" viewBox="0 0 360 112" role="img" aria-label="Пружина у стены сжата на x сантиметров; к её свободному концу прижат шарик. Красная стрелка — сила упругости, которая действует на шарик">
		<rect class="sme-sky" x="0" y="0" width="360" height="94"></rect>
		<rect class="sme-wood" x="0" y="94" width="360" height="10"></rect>
		<rect class="sme-wall" x="0" y="20" width="18" height="74"></rect>
		<path class="sme-brick" data-bricks d=""></path>
		<line class="sme-ref" x1="186" x2="186" y1="32" y2="94"></line>
		<text class="t-small t-halo" x="190" y="30">без деформации</text>
		<g data-dim></g>
		<path class="sme-spring" data-spring d=""></path>
		<rect class="sme-plate" data-plate x="0" y="58" width="4" height="34" rx="1"></rect>
		<path class="sme-catch" data-catch d=""></path>
		<circle class="sme-ball sme-ball--steel" data-ball cx="0" cy="82" r="12"></circle>
		<g data-arrows></g>
	</svg>
	<div class="g7__grid sme-slide-grid">
		<div class="g7__side">
			<div class="g7__seg" data-k>
				<button type="button" class="g7__btn" data-v="200" aria-pressed="true"><i>k</i> = 200&nbsp;Н/м</button>
				<button type="button" class="g7__btn" data-v="400"><i>k</i> = 400&nbsp;Н/м</button>
			</div>
			<label class="g7__slider"><span>Сжатие пружины <i>x</i></span><output data-ox></output><input type="range" min="0" max="10" step="1" value="4" data-x aria-label="Сжатие пружины, сантиметры" /></label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Отпустить</button>
				<button type="button" class="g7__btn" data-reset>Сжать снова</button>
			</div>
			<ul class="g7__read" data-read></ul>
		</div>
		<div class="sme-out">
			<svg class="g7__svg" viewBox="0 0 240 196" role="img" aria-label="График: сила упругости пружины в зависимости от сжатия — прямая; площадь закрашенного треугольника под ней равна энергии пружины">
				<g data-axes></g>
				<path class="sme-fline sme-fline--other" data-other d=""></path>
				<path class="sme-tri" data-tri d=""></path>
				<path class="sme-fline" data-line d=""></path>
				<path class="ln-dash" data-drop d=""></path>
				<circle class="sme-fpt" data-pt cx={GX0} cy={GY0} r="3"></circle>
				<text class="t-small t-strong t-halo t-red" data-ptl x="0" y="0"></text>
				<text class="t-strong t-halo sme-tri-l" data-tril x="0" y="0" text-anchor="middle"></text>
			</svg>
			<p class="g7__msg" data-msg></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Шарик массой 0,1&nbsp;кг прижат к сжатой пружине, его держит защёлка. Красная стрелка — сила упругости <Fragment set:html={kv('\\vec F_{\\text{упр}}')} />, с которой пружина действует на шарик. На графике золотой треугольник — работа, которую совершили, сжимая пружину. Трение не учитывается; отпущенная пружина распрямляется в 40 раз медленнее, чем на самом деле.
	</figcaption>
</figure>

<style is:global>
	.sme .sme-wall {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.sme .sme-brick {
		fill: none;
		stroke: var(--sl-color-gray-6);
		stroke-width: 0.8;
	}
	.sme .sme-spring {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.sme .sme-plate {
		fill: var(--g7-steel-dark);
	}
	.sme .sme-catch {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.sme .sme-ball--steel {
		fill: color-mix(in oklab, var(--g7-steel) 80%, var(--sl-color-gray-4));
	}
	.sme .sme-fline {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2;
	}
	.sme .sme-fline--other {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.sme .sme-tri {
		fill: color-mix(in oklab, var(--sme-ep) 45%, transparent);
		stroke: var(--sme-ep);
		stroke-width: 1;
	}
	.sme .sme-tri-l {
		fill: var(--sme-ep);
	}
	.sme .sme-fpt {
		fill: var(--g7-red);
	}
	[data-sme-spring] .g7__msg {
		text-align: center;
	}
</style>

<script>
	import { loop, segment } from '../g7/kit';
	import { el, f1, fmt, label, newArrow, setLabel, vecMark } from './sme';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-sme-spring]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const M = 0.1; // кг
		const S = 8; // px per см
		const WALL = 18;
		const FREE = WALL + 20 * S - 2; // the plate's left side at the free length (x = 186 is its right side)
		const Y = 82; // the axis of the spring and of the ball
		const R = 12;
		const FS = 1.1; // px per newton
		const SLOW = 40;
		const GX = 40;
		const GY = 168;
		const PXC = 16; // graph: px per см
		const PXN = 3.4; // graph: px per newton
		// bricks
		let d = '';
		for (let y = 20, row = 0; y < 94; y += 9, row++) {
			d += `M0 ${y} H18 `;
			for (let x = row % 2 ? 6 : 0; x < 18; x += 12) d += `M${x} ${y} V${Math.min(94, y + 9)} `;
		}
		$('[data-bricks]').setAttribute('d', d);
		// the axes of the graph
		const ax = $<SVGGElement>('[data-axes]');
		ax.append(el('path', { class: 'ink', d: `M${GX} ${GY} H${GX + 10 * PXC + 8} M${GX} ${GY} V${GY - 40 * PXN - 10}` }));
		ax.append(el('path', { class: 'head--ink', d: `M${GX + 10 * PXC + 14} ${GY} l-9 -4 v8 Z` }));
		ax.append(el('path', { class: 'head--ink', d: `M${GX} ${GY - 40 * PXN - 16} l-4 9 h8 Z` }));
		for (let c = 2; c <= 10; c += 2) {
			ax.append(el('line', { class: 'ln', x1: GX + c * PXC, x2: GX + c * PXC, y1: GY - 3, y2: GY + 3 }));
			ax.append(el('text', { class: 't-small t-num', x: GX + c * PXC, y: GY + 15, 'text-anchor': 'middle' }, String(c)));
		}
		for (let n = 10; n <= 40; n += 10) {
			ax.append(el('line', { class: 'ln', x1: GX - 3, x2: GX + 3, y1: f1(GY - n * PXN), y2: f1(GY - n * PXN) }));
			const tick = el('text', { class: 't-small t-num', x: GX - 6, y: f1(GY - n * PXN + 4), 'text-anchor': 'end' }, String(n));
			tick.dataset.n = String(n);
			ax.append(tick);
		}
		ax.append(el('text', { class: 't-small t-num', x: GX - 6, y: GY + 15, 'text-anchor': 'end' }, '0'));
		label(ax, 238, GY - 8, [['x'], ', см'], { class: 't-small', 'text-anchor': 'end' });
		label(ax, GX + 10, 14, [['F', 'упр'], ', Н'], { class: 't-small' });
		// scene parts
		const spring = $<SVGPathElement>('[data-spring]');
		const plate = $<SVGRectElement>('[data-plate]');
		const ball = $<SVGCircleElement>('[data-ball]');
		const catchP = $<SVGPathElement>('[data-catch]');
		const dim = $<SVGGElement>('[data-dim]');
		const dimA = newArrow(dim, 'gold');
		const dimB = newArrow(dim, 'gold');
		const dimL = label(dim, 0, 0, [['x']], { class: 't-gold t-halo t-small', 'text-anchor': 'middle' });
		const arrows = $<SVGGElement>('[data-arrows]');
		const fArrow = newArrow(arrows, 'red');
		const fLab = label(arrows, 0, 0, [['F', 'упр']], { class: 't-red t-halo' });
		const fVec = vecMark(fLab, 0, 'red');
		const vArrow = newArrow(arrows, 'blue');
		const vLab = label(arrows, 0, 0, [['υ']], { class: 't-blue t-halo' });
		const vVec = vecMark(vLab, 0, 'blue');
		const read = $<HTMLUListElement>('[data-read]');
		const msg = $<HTMLElement>('[data-msg]');
		const inX = $<HTMLInputElement>('[data-x]');
		const st = { k: 200, x0: 4 }; // Н/м, см
		let t = 0; // s of real time since the release
		let released = false;
		let running = false;

		const coils = (x1: number, x2: number) => {
			const n = 14;
			const a = x1 + 6;
			const b = x2 - 4;
			let p = `M${f1(x1)} ${Y} H${f1(a)}`;
			for (let i = 0; i < n; i++) p += ` L${f1(a + ((i + 0.5) * (b - a)) / n)} ${i % 2 ? Y + 9 : Y - 9}`;
			return p + ` L${f1(b)} ${Y} H${f1(x2)}`;
		};
		const omega = () => Math.sqrt(st.k / M);
		const tPush = () => Math.PI / 2 / omega();
		const draw = () => {
			const k = st.k;
			const x0 = st.x0 / 100; // м
			const w = omega();
			const vOut = x0 * w;
			let xs = x0; // the compression now, м
			let v = 0; // the ball's speed, м/с
			let ballX: number; // the ball's centre, px
			if (!released) {
				ballX = FREE + 4 - x0 * 100 * S + R;
			} else if (t < tPush()) {
				xs = x0 * Math.cos(w * t);
				v = x0 * w * Math.sin(w * t);
				ballX = FREE + 4 - xs * 100 * S + R;
			} else {
				xs = 0;
				v = vOut;
				ballX = FREE + 4 + R + (t - tPush()) * vOut * 100 * S;
			}
			const px = FREE - xs * 100 * S; // the plate's left side
			spring.setAttribute('d', coils(WALL, px));
			plate.setAttribute('x', f1(px));
			ball.setAttribute('cx', f1(ballX));
			ball.setAttribute('visibility', ballX < 380 ? 'visible' : 'hidden');
			// the catch: a small wedge on the table right of the ball; it drops when the ball is let go
			const cx = FREE + 4 - x0 * 100 * S + 2 * R;
			catchP.setAttribute('d', released || x0 === 0 ? '' : `M${f1(cx)} 94 L${f1(cx)} ${Y + 2} L${f1(cx + 8)} 94 Z`);
			// the compression x: gold dimension above the spring
			if (xs > 0.004) {
				const yd = 46;
				dimA(186, yd, px + 4, yd, 6, 3);
				dimB(px + 4, yd, 186, yd, 6, 3);
				dimL.setAttribute('x', f1((px + 4 + 186) / 2));
				dimL.setAttribute('y', f1(yd - 5));
				dimL.setAttribute('visibility', xs * 100 > 1.5 ? 'visible' : 'hidden');
			} else {
				dimA(0, 0, 0, 0);
				dimB(0, 0, 0, 0);
				dimL.setAttribute('visibility', 'hidden');
			}
			// the elastic force on the ball (while it touches the plate) and the ball's velocity
			const F = k * xs;
			const touching = !released || t < tPush();
			if (touching && F > 0.5) {
				const xa = ballX - R + 2;
				fArrow(xa, Y - 22, xa + F * FS + 6, Y - 22, 7, 4);
				fLab.setAttribute('x', f1(xa + F * FS + 10));
				fLab.setAttribute('y', f1(Y - 17));
				fLab.setAttribute('visibility', 'visible');
			} else {
				fArrow(0, 0, 0, 0);
				fLab.setAttribute('visibility', 'hidden');
			}
			fVec();
			if (released && !touching && ballX < 360) {
				const L = Math.min(60, v * 7);
				vArrow(ballX, Y - 22, ballX + L, Y - 22, 7, 4);
				vLab.setAttribute('x', f1(Math.min(ballX + L + 4, 346)));
				vLab.setAttribute('y', f1(Y - 28));
				vLab.setAttribute('visibility', 'visible');
			} else {
				vArrow(0, 0, 0, 0);
				vLab.setAttribute('visibility', 'hidden');
			}
			vVec();
			// the graph
			const xp = (c: number) => GX + c * PXC;
			const yp = (n: number) => GY - n * PXN;
			const other = st.k === 200 ? 400 : 200;
			const xEndOther = Math.min(10, 40 / (other / 100));
			$('[data-other]').setAttribute('d', `M${GX} ${GY} L${f1(xp(xEndOther))} ${f1(yp((other * xEndOther) / 100))}`);
			$('[data-line]').setAttribute('d', `M${GX} ${GY} L${f1(xp(10))} ${f1(yp(k / 10))}`);
			const c0 = st.x0; // the triangle is the energy stored before the release
			const F0 = (k * c0) / 100;
			$('[data-tri]').setAttribute('d', c0 > 0 ? `M${GX} ${GY} L${f1(xp(c0))} ${f1(yp(F0))} L${f1(xp(c0))} ${GY} Z` : '');
			$('[data-drop]').setAttribute('d', c0 > 0 ? `M${f1(xp(c0))} ${f1(yp(F0))} H${GX}` : '');
			const pt = $<SVGCircleElement>('[data-pt]');
			pt.setAttribute('cx', f1(xp(c0)));
			pt.setAttribute('cy', f1(yp(F0)));
			const ptl = $<SVGTextElement>('[data-ptl]');
			// the force is read off the force axis, at the end of the dashed level; a tick number too close is hidden
			ptl.textContent = c0 > 0 ? `${fmt(F0, 0)}` : '';
			ptl.setAttribute('x', f1(GX - 6));
			ptl.setAttribute('y', f1(yp(F0) + 4));
			ptl.setAttribute('text-anchor', 'end');
			for (const tk of ax.querySelectorAll<SVGTextElement>('[data-n]')) tk.setAttribute('visibility', c0 > 0 && Math.abs(yp(Number(tk.dataset.n)) - yp(F0)) < 11 ? 'hidden' : 'visible');
			const tril = $<SVGTextElement>('[data-tril]');
			const E0 = (k * x0 * x0) / 2;
			setLabel(tril, F0 * PXN >= 45 ? [['E', 'п']] : []);
			tril.setAttribute('x', f1(xp((2 * c0) / 3)));
			tril.setAttribute('y', f1(GY - (F0 * PXN) / 3 + 5));
			// the readouts
			const Ek = (M * v * v) / 2;
			const rows = [
				`<li><span>Сжатие <i>x</i></span><b>${fmt(xs * 100, 1)} см</b></li>`,
				`<li><span>Сила упругости <i>F</i><sub>упр</sub> = <i>kx</i></span><b>${fmt(F, 1)} Н</b></li>`,
				`<li class="${released ? '' : 'is-key'}"><span>Энергия пружины <i>E</i><sub>п</sub> = <i>kx</i><sup>2</sup>/2</span><b>${fmt((k * xs * xs) / 2, 2)} Дж</b></li>`,
			];
			if (released) {
				rows.push(`<li><span>Скорость шарика <i>υ</i></span><b>${fmt(v, 2)} м/с</b></li>`);
				rows.push(`<li class="is-key"><span>Кинетическая энергия <i>E</i><sub>к</sub> = <i>mυ</i><sup>2</sup>/2</span><b>${fmt(Ek, 2)} Дж</b></li>`);
			}
			read.innerHTML = rows.join('');
			msg.innerHTML =
				released && t >= tPush()
					? `Пружина распрямилась: шарик получил <i>E</i><sub>к</sub> = ${fmt(Ek, 2)}&nbsp;Дж`
					: `Площадь треугольника: ½ · ${fmt(F0, 0)}&nbsp;Н · ${fmt(x0, 2)}&nbsp;м = ${fmt(E0, 2)}&nbsp;Дж`;
		};
		const wake = loop(fig, (dt) => {
			if (!running) return false;
			t += dt / SLOW;
			const tEnd = tPush() + (0.3 / Math.max(0.01, (st.x0 / 100) * omega())) * 1.2; // until the ball is off the table
			if (t >= tEnd) {
				t = tEnd;
				running = false;
			}
			draw();
			return running;
		});
		const reset = () => {
			running = false;
			released = false;
			t = 0;
			$<HTMLOutputElement>('[data-ox]').textContent = `${st.x0} см`;
			draw();
		};
		segment($('[data-k]'), (b) => {
			st.k = Number(b.dataset.v);
			reset();
		});
		inX.addEventListener('input', () => {
			st.x0 = Number(inX.value);
			reset();
		});
		$('[data-go]').addEventListener('click', () => {
			if (st.x0 === 0) return;
			released = true;
			running = true;
			t = 0;
			draw();
			wake();
		});
		$('[data-reset]').addEventListener('click', reset);
		reset();
	}
</script>
