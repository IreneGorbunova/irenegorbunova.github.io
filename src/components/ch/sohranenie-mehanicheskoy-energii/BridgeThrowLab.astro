---
/**
 * Model «Камень с моста»: a small stone of mass m (0,1 / 0,2 / 0,5 кг) is thrown from a bridge, from a point just
 * outside the railing 20 м above the water (the water surface is the zero level), with the speed υ₀ = 10 м/с in one of
 * five directions: straight up, 45° up, horizontally, 45° down, straight down. Without air:
 *   x = υ₀ cos α · t, h = 20 + υ₀ sin α · t − g t²/2, υ² = υ₀² − 2g(h − 20), g = 9,8 м/с².
 * The full mechanical energy E = mυ₀²/2 + mgH = 10 + 39,2 = 49,2 Дж for 0,2 кг (24,6 for 0,1, 123,0 for 0,5) at
 * every moment, so at the water the speed is √(υ₀² + 2gH) = 22,2 м/с for every direction. Flight times: up 3,28 с,
 * 45° up 2,87 с, horizontally 2,02 с, 45° down 1,42 с, down 1,24 с; the highest points 25,1 / 22,6 / 20,0 м.
 * Scales: 10,8 px per metre on both axes (x −3…24 м, h 0…26 м); the stone (a few cm) is drawn 7 px across; the
 * velocity 2,2 px per м/с (blue), the force of gravity 6 px per newton (red: 0,98 / 1,96 / 4,9 Н). Faint marks every
 * 0,2 с; the last four trajectories stay faint for comparison («Сначала» clears them). The bars are drawn on the
 * scale of the full energy for the chosen mass (E fills its bar). Real time.
 */
import SmeStyles from './SmeStyles.astro';
import katex from 'katex';
const kv = (s: string) => katex.renderToString(s, { throwOnError: false });
---

<SmeStyles />
<figure class="g7 sme not-content" data-sme-bridge>
	<div class="g7__grid sme-bridge-grid">
		<div class="sme-bridge-left">
		<svg class="g7__svg" viewBox="0 0 320 312" role="img" aria-label="Камень бросают с моста высотой 20 метров над водой в одном из пяти направлений. Синяя стрелка — скорость камня, красная — сила тяжести; бледные кружки отмечают камень через каждые 0,2 секунды">
			<rect class="sme-sky" x="0" y="0" width="320" height="292"></rect>
			<g data-grid></g>
			<!-- the bridge: a cross-section of the deck with its railing, the pier -->
			<g data-bridge></g>
			<rect class="sme-water" x="0" y="292" width="320" height="20"></rect>
			<path class="sme-wave" d="M0 296 q8 -3 16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0 t16 0"></path>
			<g data-old></g>
			<g data-marks></g>
			<g data-aim></g>
			<circle class="sme-stone" data-stone r="3.5"></circle>
			<g data-arrows></g>
			<text class="t-small t-halo" data-water x="316" y="286" text-anchor="end"></text>
		</svg>
			<div class="sme-bridge-ctl">
				<div class="g7__seg" data-dir>
					<button type="button" class="g7__btn" data-a="90">Вверх</button>
					<button type="button" class="g7__btn" data-a="45">Под углом вверх</button>
					<button type="button" class="g7__btn" data-a="0" aria-pressed="true">Горизонтально</button>
					<button type="button" class="g7__btn" data-a="-45">Под углом вниз</button>
					<button type="button" class="g7__btn" data-a="-90">Вниз</button>
				</div>
				<div class="g7__row">
					<span class="g7__label">Масса <i>m</i></span>
					<div class="g7__seg" data-m><button type="button" class="g7__btn" data-v="0.1">0,1&nbsp;кг</button><button type="button" class="g7__btn" data-v="0.2" aria-pressed="true">0,2&nbsp;кг</button><button type="button" class="g7__btn" data-v="0.5">0,5&nbsp;кг</button></div>
				</div>
				<div class="g7__row">
					<button type="button" class="g7__btn g7__btn--go" data-go>Бросить</button>
					<button type="button" class="g7__btn" data-pause disabled>Пауза</button>
					<button type="button" class="g7__btn" data-reset>Сначала</button>
				</div>
			</div>
		</div>
		<div class="g7__side">
			<svg class="g7__svg" viewBox="0 0 220 150" role="img" aria-label="Столбики: кинетическая энергия, потенциальная энергия и их сумма — полная механическая энергия камня"><g data-bars></g></svg>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Камень бросают со скоростью 10&nbsp;м/с с высоты 20&nbsp;м; нулевой уровень — поверхность воды. Синяя стрелка — скорость камня, красная — сила тяжести <Fragment set:html={kv('m\\vec g')} />; бледные кружки — положения камня через каждые 0,2&nbsp;с. Синий столбик — кинетическая энергия, золотой — потенциальная, зелёный — их сумма. Сопротивление воздуха не учитывается; камень нарисован крупнее, чем в масштабе. Время идёт как настоящее.
	</figcaption>
</figure>

<style is:global>
	.g7 .g7__grid.sme-bridge-grid {
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
	}
	@container (max-width: 36rem) {
		.g7 .g7__grid.sme-bridge-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.sme .sme-bridge-ctl {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.sme .sme-water {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-5));
	}
	.sme .sme-wave {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-white));
		stroke-width: 0.8;
	}
	.sme .sme-gridline {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.6;
	}
	.sme .sme-concrete {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 55%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.sme .sme-railing {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.sme .sme-stone {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.sme .sme-old {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		opacity: 0.45;
	}
	.sme .sme-aim {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
</style>

<script>
	import { loop, segment } from '../g7/kit';
	import { el, energyBars, f1, fmt, G, label, newArrow } from './sme';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-sme-bridge]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const K = 10.8;
		const OX = 14 + 3 * K; // x = 0 (the throw point)
		const OY = 292; // the water, h = 0
		const H = 20;
		const V0 = 10;
		const VS = 2.2;
		const FS = 6;
		const px = (x: number) => OX + x * K;
		const py = (h: number) => OY - h * K;
		// a light grid every 2 м, numbers every 4 м on the left
		const grid = $<SVGGElement>('[data-grid]');
		for (let h = 2; h <= 26; h += 2) grid.append(el('line', { class: 'sme-gridline', x1: 0, x2: 320, y1: f1(py(h)), y2: f1(py(h)) }));
		for (let x = -2; x <= 24; x += 2) grid.append(el('line', { class: 'sme-gridline', x1: f1(px(x)), x2: f1(px(x)), y1: 0, y2: OY }));
		for (let h = 4; h <= 24; h += 4) {
			const t = el('text', { class: 't-small t-num t-halo', x: 316, y: f1(py(h) + 3.5), 'text-anchor': 'end' });
			t.textContent = String(h);
			grid.append(t);
		}
		label(grid, 316, 12, [['h'], ', м'], { 'text-anchor': 'end', class: 't-halo' });
		// the bridge, the throw point just outside the railing
		const br = $<SVGGElement>('[data-bridge]');
		br.append(el('rect', { class: 'sme-concrete', x: 0, y: f1(py(19.1)), width: f1(px(-0.25)), height: f1(0.9 * K) }));
		br.append(el('rect', { class: 'sme-concrete', x: 2, y: f1(py(18.2)), width: f1(px(-0.25) - 12), height: f1(18.2 * K) }));
		br.append(el('path', { class: 'sme-railing', d: `M${f1(px(-0.4))} ${f1(py(19.1))} V${f1(py(20))} H0 M${f1(px(-1.6))} ${f1(py(19.1))} V${f1(py(20))} M${f1(px(-2.8))} ${f1(py(19.1))} V${f1(py(20))} M0 ${f1(py(19.55))} H${f1(px(-0.4))}` }));
		const stone = $<SVGCircleElement>('[data-stone]');
		const marks = $<SVGGElement>('[data-marks]');
		const old = $<SVGGElement>('[data-old]');
		const aim = $<SVGGElement>('[data-aim]');
		const arrows = $<SVGGElement>('[data-arrows]');
		const vArrow = newArrow(arrows, 'blue');
		const gArrow = newArrow(arrows, 'red');
		const water = $<SVGTextElement>('[data-water]');
		const read = $<HTMLUListElement>('[data-read]');
		const goBtn = $<HTMLButtonElement>('[data-go]');
		const pauseBtn = $<HTMLButtonElement>('[data-pause]');
		const barsG = $<SVGGElement>('[data-bars]');
		const st = { a: 0, m: 0.2 };
		let bars: ReturnType<typeof energyBars>;
		const makeBars = () => {
			barsG.replaceChildren();
			bars = energyBars(barsG, { x: 44, base: 122, full: 100, max: st.m * (V0 * V0 / 2 + G * H), kinds: ['ek', 'ep', 'e'], w: 30, gap: 22 });
		};
		const traces: string[] = [];
		let t = 0;
		let running = false;
		let thrown = false;
		const flight = () => {
			const s = Math.sin((st.a * Math.PI) / 180);
			return (V0 * s + Math.sqrt(V0 * V0 * s * s + 2 * G * H)) / G;
		};
		const at = (tt: number) => {
			const al = (st.a * Math.PI) / 180;
			const vx = V0 * Math.cos(al);
			const vy = V0 * Math.sin(al) - G * tt;
			return { x: vx * tt, h: H + V0 * Math.sin(al) * tt - (G * tt * tt) / 2, vx, vy };
		};
		const path = (t1: number) => {
			let d = '';
			for (let i = 0; i <= 60; i++) {
				const p = at((t1 * i) / 60);
				d += `${i ? 'L' : 'M'}${f1(px(p.x))} ${f1(py(Math.max(0, p.h)))} `;
			}
			return d;
		};
		const draw = () => {
			const T = flight();
			const tt = Math.min(t, T);
			const p = at(tt);
			const h = Math.max(0, p.h);
			const v = Math.hypot(p.vx, p.vy);
			const sx = px(p.x);
			const sy = py(h);
			stone.setAttribute('cx', f1(sx));
			stone.setAttribute('cy', f1(sy));
			// the direction before the throw: a short dashed arrow
			aim.replaceChildren();
			if (!thrown) {
				const al = (st.a * Math.PI) / 180;
				const L = 26;
				aim.append(el('path', { class: 'sme-aim', d: `M${f1(sx)} ${f1(sy)} l${f1(L * Math.cos(al))} ${f1(-L * Math.sin(al))}` }));
			}
			// near the water an arrow that points down is moved up as a whole (its length kept), so it stays in the frame
			const vyEnd = sy - p.vy * VS;
			const lift = Math.max(0, vyEnd - (OY + 6));
			vArrow(sx, sy - lift, sx + p.vx * VS, vyEnd - lift, 6, 3.5);
			if (!thrown) vArrow(0, 0, 0, 0);
			const mg = st.m * G;
			const gl = Math.max(0, sy + 4 + mg * FS - (OY + 6));
			gArrow(sx - 5, sy + 4 - gl, sx - 5, sy + 4 + mg * FS - gl, 5, 3);
			marks.replaceChildren();
			if (thrown)
				for (let s = 0.2; s < tt - 1e-9; s += 0.2) {
					const q = at(s);
					marks.append(el('circle', { class: 'sme-mark', cx: f1(px(q.x)), cy: f1(py(Math.max(0, q.h))), r: 3 }));
				}
			// the energies
			const ek = (st.m * v * v) / 2;
			const ep = st.m * G * h;
			bars([ek, ep, ek + ep]);
			const done = thrown && t >= T - 1e-9;
			water.textContent = done ? `у воды: υ = ${fmt(v, 1)} м/с, полёт ${fmt(T, 2)} с` : '';
			read.innerHTML = [
				`<li><span>Время <i>t</i></span><b>${fmt(thrown ? tt : 0, 2)} с</b></li>`,
				`<li class="is-warm"><span>Высота <i>h</i></span><b>${fmt(h, 1)} м</b></li>`,
				`<li class="is-key"><span>Скорость <i>υ</i></span><b>${fmt(v, 1)} м/с</b></li>`,
				`<li><span><i>E</i> = <i>E</i><sub>к</sub> + <i>E</i><sub>п</sub></span><b>${fmt(ek + ep, 1)} Дж</b></li>`,
			].join('');
			pauseBtn.disabled = !thrown || done;
			pauseBtn.textContent = thrown && !running && !done ? 'Продолжить' : 'Пауза';
		};
		const drawOld = () => {
			old.replaceChildren();
			for (const d of traces) old.append(el('path', { class: 'sme-old', d }));
		};
		const wake = loop(fig, (dt) => {
			if (!running) return false;
			t += dt;
			if (t >= flight()) {
				t = flight();
				running = false;
				traces.push(path(t));
				while (traces.length > 4) traces.shift();
			}
			draw();
			if (!running) drawOld();
			return running;
		});
		const toStart = () => {
			running = false;
			thrown = false;
			t = 0;
			draw();
		};
		segment($('[data-dir]'), (b) => {
			st.a = Number(b.dataset.a);
			toStart();
		});
		segment($('[data-m]'), (b) => {
			st.m = Number(b.dataset.v);
			makeBars();
			toStart();
		});
		goBtn.addEventListener('click', () => {
			t = 0;
			thrown = true;
			running = true;
			draw();
			wake();
		});
		pauseBtn.addEventListener('click', () => {
			running = !running;
			draw();
			if (running) wake();
		});
		$('[data-reset]').addEventListener('click', () => {
			traces.length = 0;
			drawOld();
			toStart();
		});
		makeBars();
		draw();
	}
</script>
