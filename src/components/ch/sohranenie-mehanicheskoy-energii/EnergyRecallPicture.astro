---
/**
 * Two small looping pictures for the reminder section «Кинетическая и потенциальная энергия» (grade 9); `kind` picks one.
 *   kind="k" — two equal hockey pucks of 0,17 кг slide on ice, puck 1 at 10 м/с, puck 2 at 20 м/с (blue velocity
 *     arrows, 2 px per м/с). Their kinetic energies, mυ²/2: 0,17 · 10² / 2 = 8,5 Дж and 0,17 · 20² / 2 = 34 Дж — twice
 *     the speed, four times the energy (blue bars). 10 px per metre; real time (the rink of 26 м is crossed in 2,6 с
 *     and 1,3 с, then the pucks come in again from the left); the pucks are drawn larger than to scale; no friction.
 *   kind="p" — a building hoist lifts a box of 50 кг from the ground (the zero level) to 3 м at 1 м/с, waits and lowers
 *     it again. Its potential energy mgh grows in proportion to the height: 50 · 9,8 · 1 = 490 Дж per metre, 1470 Дж at
 *     3 м (gold bar, gold bracket h). 40 px per metre; real time: 1 с below, 3 с up, 1,5 с above, 3 с down.
 * The cable only holds the box (no force is labelled). Colors of the chapter: velocity and kinetic energy blue, height
 * and potential energy gold.
 */
import SmeStyles from './SmeStyles.astro';
interface Props {
	kind: 'k' | 'p';
}
const { kind } = Astro.props;
---

<SmeStyles />
{
	kind === 'k' ? (
		<figure class="g7 g7--pic sme sme-small not-content" data-sme-recall="k">
			<div class="g7__grid">
				<svg class="g7__svg" viewBox="0 0 360 160" role="img" aria-label="Две одинаковые шайбы скользят по льду, вторая вдвое быстрее первой; столбики показывают их кинетическую энергию: 8,5 и 34 джоуля">
					<rect class="sme-ice" x="0" y="0" width="282" height="160" />
					<path class="sme-ice-line" d="M0 80 H282" />
					<text class="t-strong t-halo" x="8" y="22">1</text>
					<text class="t-strong t-halo" x="8" y="102">2</text>
					<text class="t-small t-halo" x="24" y="66">10 м/с</text>
					<text class="t-small t-halo" x="24" y="146">20 м/с</text>
					<g data-pucks />
					<g data-bars />
				</svg>
			</div>
			<figcaption class="g7__caption">
				Две одинаковые шайбы массой 0,17&nbsp;кг скользят по льду: шайба&nbsp;1 со скоростью 10&nbsp;м/с, шайба&nbsp;2 — 20&nbsp;м/с (синие стрелки). Столбики — их кинетическая энергия: скорость вдвое больше, энергия вчетверо больше. Время настоящее, трение не учитывается; шайбы нарисованы крупнее, чем в масштабе.
			</figcaption>
		</figure>
	) : (
		<figure class="g7 g7--pic sme sme-small not-content" data-sme-recall="p">
			<div class="g7__grid">
				<svg class="g7__svg" viewBox="0 0 360 214" role="img" aria-label="Подъёмник поднимает ящик массой 50 килограммов с земли на высоту 3 метра и опускает обратно; столбик показывает потенциальную энергию ящика">
					<rect class="sme-sky" x="0" y="0" width="360" height="190" />
					<rect class="sme-ground" x="0" y="190" width="360" height="24" />
					<path class="sme-mast" d="M168 190 V16 M180 190 V16 M168 16 H226 M168 190 L180 172 L168 154 L180 136 L168 118 L180 100 L168 82 L180 64 L168 46 L180 28 L168 16" />
					<circle class="sme-pulley" cx="220" cy="20" r="5" />
					<path class="sme-cable" data-cable d="" />
					<path class="sme-hook" data-hook d="" />
					<rect class="sme-wood" data-box x="210" y="0" width="20" height="24" rx="1.5" />
					<g data-scale />
					<line class="sme-ref" x1="34" x2="258" y1="190" y2="190" />
					<text class="t-small t-halo" x="72" y="206">нулевой уровень</text>
					<g data-h />
					<g data-bars />
				</svg>
				<p class="g7__msg sme-gw-msg" data-msg />
			</div>
			<figcaption class="g7__caption">
				Подъёмник поднимает ящик массой 50&nbsp;кг с земли на высоту 3&nbsp;м и опускает обратно. Нулевой уровень — земля; золотой столбик — потенциальная энергия ящика. Время настоящее.
			</figcaption>
		</figure>
	)
}

<style is:global>
	.sme .sme-ice {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--g7-paper));
	}
	.sme .sme-ice-line {
		stroke: color-mix(in oklab, var(--g7-red) 45%, transparent);
		stroke-width: 1.5;
	}
	.sme .sme-puck {
		fill: #1f1f22;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.sme .sme-mast {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.sme .sme-pulley {
		fill: var(--g7-steel);
		stroke: var(--g7-steel-dark);
		stroke-width: 1.2;
	}
	.sme .sme-cable,
	.sme .sme-hook {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.sme .sme-gw-msg {
		text-align: center;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, energyBars, f1, fmt, label, newArrow } from './sme';

	const G = 9.8;
	for (const fig of document.querySelectorAll<HTMLElement>('[data-sme-recall="k"]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const M = 0.17;
		const K = 10; // px per metre
		const X0 = 20;
		const X1 = 282;
		const g = $<SVGGElement>('[data-pucks]');
		const lanes = [
			{ v: 10, y: 50 },
			{ v: 20, y: 130 },
		].map((l) => {
			const a = newArrow(g, 'blue');
			const p = el('ellipse', { class: 'sme-puck', rx: 7, ry: 3.2, cx: X0, cy: l.y });
			g.append(p);
			return { ...l, a, p };
		});
		const bars = energyBars($('[data-bars]'), { x: 296, base: 132, full: 104, max: 34, kinds: ['ek1', 'ek2'], w: 20, gap: 12 });
		bars(lanes.map((l) => (M * l.v * l.v) / 2));
		let clock = 0;
		const draw = () => {
			for (const l of lanes) {
				const span = X1 - X0 + 50; // re-enter after leaving the rink
				const x = X0 + ((clock * l.v * K) % span) - 10;
				const vis = x < X1 - 6 ? 'visible' : 'hidden';
				l.p.setAttribute('cx', f1(x));
				l.p.setAttribute('visibility', vis);
				if (vis === 'visible' && x + 8 + l.v * 2 < X1) l.a(x + 8, l.y - 10, x + 8 + l.v * 2, l.y - 10, 6, 3.5);
				else l.a(0, 0, 0, 0);
			}
		};
		loop(fig, (dt) => {
			clock += dt;
			draw();
			return true;
		});
		draw();
	}

	for (const fig of document.querySelectorAll<HTMLElement>('[data-sme-recall="p"]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const M = 50;
		const K = 40; // px per metre
		const Y0 = 190;
		const BX = 220; // the box's centre line
		const HMAX = 3;
		const T = [1, 3, 1.5, 3];
		const CYCLE = T.reduce((a, b) => a + b, 0);
		const yOf = (h: number) => Y0 - h * K;
		// the height scale
		const sc = $<SVGGElement>('[data-scale]');
		sc.append(el('path', { class: 'ink', d: `M40 ${Y0} V${yOf(3.6)}` }));
		sc.append(el('path', { class: 'head--ink', d: `M40 ${f1(yOf(3.6) - 6)} l-4 9 h8 Z` }));
		for (let m = 0; m <= 3; m++) {
			sc.append(el('line', { class: 'ln', x1: 36, y1: f1(yOf(m)), x2: 44, y2: f1(yOf(m)) }));
			if (m > 0) sc.append(el('text', { class: 't-small t-num t-halo', x: 32, y: f1(yOf(m) + 4), 'text-anchor': 'end' }, String(m)));
		}
		label(sc, 48, 30, [['h'], ', м'], { class: 't-small' });
		const hg = $<SVGGElement>('[data-h]');
		const hA = newArrow(hg, 'gold');
		const hLab = label(hg, 0, 0, [['h'], ' = 0 м'], { class: 't-gold t-halo t-small' });
		const box = $<SVGRectElement>('[data-box]');
		const cable = $<SVGPathElement>('[data-cable]');
		const hook = $<SVGPathElement>('[data-hook]');
		const bars = energyBars($('[data-bars]'), { x: 318, base: 182, full: 140, max: 1470, kinds: ['ep'], w: 26, digits: 0 });
		const msg = $<HTMLElement>('[data-msg]');
		let clock = 0;
		const height = (c: number) => {
			if (c < T[0]) return 0;
			c -= T[0];
			if (c < T[1]) return (HMAX * c) / T[1];
			c -= T[1];
			if (c < T[2]) return HMAX;
			c -= T[2];
			return HMAX * (1 - c / T[3]);
		};
		const draw = () => {
			const h = Math.max(0, Math.min(HMAX, height(clock % CYCLE)));
			const hr = Math.round(10 * h) / 10; // the numbers to 0,1 м, as shown
			const yb = yOf(h); // the box's bottom
			box.setAttribute('y', f1(yb - 24));
			const yh = yb - 30; // the hook
			cable.setAttribute('d', `M${BX + 5} 20 V${f1(yh)} M${BX - 10} ${f1(yb - 24)} L${BX + 2.5} ${f1(yh + 6.5)} L${BX + 10} ${f1(yb - 24)}`);
			hook.setAttribute('d', `M${BX + 5} ${f1(yh)} v4 a2.5 2.5 0 0 1 -5 0`);
			if (h > 0.05) {
				hA(246, Y0 - 1, 246, yb + 1, 6, 3);
				hLab.setAttribute('visibility', 'visible');
			} else {
				hA(0, 0, 0, 0);
				hLab.setAttribute('visibility', 'hidden');
			}
			hLab.setAttribute('x', '251');
			hLab.setAttribute('y', f1((Y0 + yb) / 2 + 4));
			const last = hLab.lastChild;
			if (last) last.textContent = ` = ${fmt(hr, 1)} м`;
			const E = M * G * hr;
			bars([E]);
			msg.innerHTML = `<i>E</i><sub>п</sub> = <i>mgh</i> = 50&nbsp;кг · 9,8&nbsp;м/с² · ${fmt(hr, 1)}&nbsp;м = ${fmt(E, 0)}&nbsp;Дж`;
		};
		loop(fig, (dt) => {
			clock += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
