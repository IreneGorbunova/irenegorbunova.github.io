---
/**
 * Picture «Работа силы тяжести»: a looping scheme. A ball of 0,2 кг beside a wall with a height scale 0…9 м (ticks
 * every metre); the ground is the zero level. Phase «вниз»: the ball is let go at point 1, h₁ = 8 м, and falls to
 * point 2, h₂ = 3 м: the fall of 5 м lasts √(2 · 5 / 9,8) = 1,01 с, the speed at point 2 is √(2 · 9,8 · 5) = 9,90 м/с.
 * Phase «вверх»: from point 2 it is thrown up at 9,90 м/с and rises back to point 1, where it stops (1,01 с).
 * The force of gravity mg = 0,2 · 9,8 = 1,96 Н (red arrow, always the same, down), the velocity (blue arrow,
 * 2,6 px per м/с), the displacement of 5 м (gold arrow, down or up, drawn when the motion is over), the heights h₁
 * and h₂ (gold brackets from the ground). The bars: E_п1 = 0,2 · 9,8 · 8 = 15,7 Дж, E_п2 = 0,2 · 9,8 · 3 = 5,9 Дж;
 * the bracket between them is the work of gravity, ±9,8 Дж. The line under the picture changes with the phase.
 * To scale: 30 px per metre (the ball, 6 см in reality, is drawn 10 px across). The motion is in real time; 1,2 с
 * pauses at the ends: the displacement arrow is drawn in the first half of each pause.
 */
import SmeStyles from './SmeStyles.astro';
---

<SmeStyles />
<figure class="g7 g7--pic sme sme-small not-content" data-sme-gw>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Мяч падает с высоты 8 метров до высоты 3 метра и затем подброшен обратно. Красная стрелка — сила тяжести, синяя — скорость, золотая — перемещение; столбики показывают потенциальную энергию в точках 1 и 2">
			<rect class="sme-sky" x="0" y="0" width="360" height="282"></rect>
			<!-- the wall with bricks -->
			<rect class="sme-wall" x="0" y="0" width="34" height="282"></rect>
			<path class="sme-brick" data-bricks d=""></path>
			<rect class="sme-ground" x="0" y="282" width="360" height="18"></rect>
			<g data-scale></g>
			<line class="sme-ref" x1="34" x2="200" y1="282" y2="282"></line>
			<text class="t-small t-halo" x="150" y="296">нулевой уровень</text>
			<g data-fixed></g>
			<g data-disp></g>
			<circle class="sme-ball" data-ball cx="140" cy="42" r="5"></circle>
			<g data-arrows></g>
			<g data-bars></g>
			<g data-bracket></g>
		</svg>
		<p class="g7__msg sme-gw-msg" data-msg></p>
	</div>
	<figcaption class="g7__caption">
		Красная стрелка — сила тяжести <i>mg</i>, синяя — скорость мяча, золотая — его перемещение; <i>h</i><sub>1</sub> и <i>h</i><sub>2</sub> — высоты над нулевым уровнем. Мяч массой 0,2&nbsp;кг падает из точки 1 в точку 2, а потом его подбрасывают обратно. Сопротивление воздуха не учитывается; мяч нарисован крупнее, чем в масштабе.
	</figcaption>
</figure>

<style is:global>
	.sme .sme-wall {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.sme .sme-brick {
		fill: none;
		stroke: var(--sl-color-gray-6);
		stroke-width: 0.8;
	}
	.sme .sme-gw-msg {
		text-align: center;
	}
</style>

<script>
	import { loop, k } from '../g7/kit';
	import { el, energyBars, f1, label, newArrow } from './sme';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-sme-gw]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const G = 9.8;
		const M = 0.2;
		const K = 30;
		const Y0 = 282; // the ground
		const BX = 140;
		const H1 = 8;
		const H2 = 3;
		const T = Math.sqrt((2 * (H1 - H2)) / G);
		const V = G * T;
		const PAUSE = 1.2;
		const CYCLE = 2 * (PAUSE + T);
		const VS = 2.6;
		const yOf = (h: number) => Y0 - h * K;
		// bricks on the wall
		let d = '';
		for (let y = 0, row = 0; y < Y0; y += 9, row++) {
			d += `M0 ${y} H34 `;
			for (let x = row % 2 ? 8 : 0; x < 34; x += 16) d += `M${x} ${y} V${Math.min(Y0, y + 9)} `;
		}
		$('[data-bricks]').setAttribute('d', d);
		// the scale on the wall
		const sc = $<SVGGElement>('[data-scale]');
		sc.append(el('path', { class: 'ink', d: `M50 ${Y0} V${yOf(9) - 4}` }));
		sc.append(el('path', { class: 'head--ink', d: `M50 ${f1(yOf(9) - 10)} l-4 9 h8 Z` }));
		for (let m = 0; m <= 9; m++) {
			sc.append(el('line', { class: 'ln', x1: 46, y1: f1(yOf(m)), x2: 54, y2: f1(yOf(m)) }));
			const t = el('text', { class: 't-small t-num t-halo', x: 44, y: f1(yOf(m) + 3.5), 'text-anchor': 'end' });
			t.textContent = String(m);
			if (m > 0) sc.append(t);
		}
		label(sc, 58, 12, [['h'], ', м']);
		// the points 1 and 2 and the gold brackets of the heights
		const fx = $<SVGGElement>('[data-fixed]');
		for (const [h, n] of [
			[H1, '1'],
			[H2, '2'],
		] as const) {
			fx.append(el('line', { class: 'sme-ref', x1: 60, x2: 196, y1: f1(yOf(h)), y2: f1(yOf(h)) }));
			fx.append(el('circle', { class: 'sme-pt', cx: BX, cy: f1(yOf(h)), r: 2 }));
			const t = el('text', { class: 't-strong t-halo', x: BX - 16, y: f1(yOf(h) - 4) });
			t.textContent = n;
			fx.append(t);
		}
		const bracket = (x: number, h: number, name: string) => {
			const a1 = newArrow(fx, 'gold');
			a1(x, Y0 - 1, x, yOf(h) + 1, 6, 3);
			fx.append(el('path', { class: 'arrow arrow--gold', d: `M${x - 4} ${Y0} H${x + 4}` }));
			label(fx, x + 4, yOf(h / 2), [['h', name], ` = ${h} м`], { class: 't-gold t-halo t-small' });
		};
		bracket(74, H1, '1');
		bracket(106, H2, '2');
		const disp = $<SVGGElement>('[data-disp]');
		const dArrow = newArrow(disp, 'gold');
		const ball = $<SVGCircleElement>('[data-ball]');
		const arrows = $<SVGGElement>('[data-arrows]');
		const vArrow = newArrow(arrows, 'blue');
		const gArrow = newArrow(arrows, 'red');
		const gLab = label(arrows, 0, 0, [['mg']], { class: 't-red t-halo' });
		const vLab = label(arrows, 0, 0, [['υ']], { class: 't-blue t-halo' });
		// the bars of the potential energy at the points 1 and 2
		const E1 = M * G * H1;
		const E2 = M * G * H2;
		const bars = energyBars($('[data-bars]'), { x: 212, base: 252, full: 150, max: 16, kinds: ['ep1', 'ep2'], w: 28, gap: 18 });
		bars([E1, E2]);
		const br = $<SVGGElement>('[data-bracket]');
		const xb = bars.x(1) + bars.w + 6;
		const y1 = bars.top(E1);
		const y2 = bars.top(E2);
		br.append(el('path', { class: 'ln-dash', d: `M${f1(bars.x(0))} ${f1(y1)} H${f1(xb)}` }));
		br.append(el('path', { class: 'sme-bracket', d: `M${f1(xb - 3)} ${f1(y1)} H${f1(xb)} V${f1(y2)} H${f1(xb - 3)}` }));
		const aText = el('text', { class: 't-small t-strong t-halo', x: f1(xb + 3), y: f1((y1 + y2) / 2 + 4) });
		br.append(aText);
		const msg = $<HTMLElement>('[data-msg]');
		const MSG = {
			down: k('\\text{вниз: } A = mg(h_1 - h_2) = 0{,}2 \\cdot 9{,}8 \\cdot 5 = +9{,}8\\ \\text{Дж}'),
			up: k('\\text{вверх: } A = -9{,}8\\ \\text{Дж}') + ', потенциальная энергия растёт',
		};
		let phase = '';
		let clock = 0;
		const draw = () => {
			const c = clock % CYCLE;
			let h: number;
			let v: number; // м/с, up positive
			let down: boolean;
			let shown = false; // the displacement arrow just after a motion
			if (c < PAUSE) {
				// at point 1: first the end of the rise (its displacement shown), then the moment before the fall
				h = H1;
				v = 0;
				down = c >= PAUSE / 2;
				shown = !down;
			} else if (c < PAUSE + T) {
				const t = c - PAUSE;
				h = H1 - (G * t * t) / 2;
				v = -G * t;
				down = true;
			} else if (c < 2 * PAUSE + T) {
				// at point 2: first the end of the fall, then the moment of the throw up
				h = H2;
				down = c < PAUSE + T + PAUSE / 2;
				v = down ? -V : V;
				shown = down;
			} else {
				const t = c - 2 * PAUSE - T;
				h = H2 + V * t - (G * t * t) / 2;
				v = V - G * t;
				down = false;
			}
			const yb = yOf(h);
			ball.setAttribute('cy', f1(yb));
			gArrow(BX, yb + 6, BX, yb + 6 + 30, 6, 3.5);
			gLab.setAttribute('x', f1(BX + 5));
			gLab.setAttribute('y', f1(yb + 32));
			const L = -v * VS;
			vArrow(BX + 14, yb, BX + 14, yb + L, 6, 3.5);
			vLab.setAttribute('x', f1(BX + 19));
			vLab.setAttribute('y', f1(yb + L / 2 + 4));
			vLab.setAttribute('visibility', Math.abs(v) > 0.3 ? 'visible' : 'hidden');
			// the displacement: from where the motion started to where it ended
			if (shown) dArrow(176, down ? yOf(H1) : yOf(H2), 176, down ? yOf(H2) : yOf(H1), 7, 4);
			else dArrow(0, 0, 0, 0);
			const ph = down ? 'down' : 'up';
			if (ph !== phase) {
				phase = ph;
				msg.innerHTML = MSG[ph];
				aText.textContent = down ? 'A = +9,8 Дж' : 'A = −9,8 Дж';
			}
		};
		loop(fig, (dt) => {
			clock += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
