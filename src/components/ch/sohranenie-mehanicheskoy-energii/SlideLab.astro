---
/**
 * Model «Горка на детской площадке»: a straight chute 4,0 м long whose top is 2,0 м above its lower end (30°); the
 * lower end is the zero level, after it a short level run-out and a sandbox; a ladder and a platform at the top.
 * A child (people kit, 125 см, sitting, the pose fixed while sliding, both hands resting on the side rails) slides
 * from rest at the top with the friction coefficient μ = 0 («так не бывает»), 0,10, 0,25 or 0,40.
 * Physics: N = mg cos 30°, F_тр = μN, a = g(sin 30° − μ cos 30°), s = at²/2 along the chute, υ = at. The energies:
 * E_п = mgh (h = (4,0 − s) · sin 30°), E_к = mυ²/2, E = E_п + E_к and the internal energy F_тр·s; E + F_тр·s stays
 * equal to the start value mgh₀ (588 Дж for 30 кг). The readouts name the path along the chute l (the grade-9 letter
 * of the path) and show the work of friction A_тр = −F_тр·l (negative: E₂ − E₁ = A_тр). At the bottom (s = 4,0 м), for 30 кг:
 *   μ = 0: 588 Дж → υ = 6,26 м/с, nothing to internal energy, 1,28 с;
 *   μ = 0,10: F_тр = 25,5 Н, F_тр·s = 101,8 Дж, E_к = 486,2 Дж, υ = 5,69 м/с, 17,3 %;
 *   μ = 0,25: 63,7 Н, 254,6 Дж, 333,4 Дж, 4,71 м/с, 43,3 %;
 *   μ = 0,40: 101,8 Н, 407,4 Дж, 180,6 Дж, 3,47 м/с, 69,3 %, 2,31 с.
 * All energies grow in proportion to the mass (20 кг: 392 Дж; 50 кг: 980 Дж); the speeds and the shares do not change.
 * The child's build changes a little with the mass (people kit `girth`). The run stops at the lower end of the chute,
 * where the readouts are taken. To scale, 50 px per metre; the friction force 0,35 px per newton (red, up the slope,
 * at the contact), the velocity 6 px per м/с (blue). Real time.
 * The bars use the colors of the chapter: E_п gold, E_к blue, E green, internal energy violet; the dashed line is the
 * energy at the start, E + internal energy reaches it at every moment.
 */
import SmeStyles from './SmeStyles.astro';
import katex from 'katex';
const kv = (s: string) => katex.renderToString(s, { throwOnError: false });
---

<SmeStyles />
<figure class="g7 sme not-content" data-sme-slide>
	<svg class="g7__svg" viewBox="0 0 340 212" role="img" aria-label="Ребёнок съезжает с горки длиной 4 метра и высотой 2 метра. Красная стрелка — сила трения, синяя — скорость">
		<rect class="sme-sky" x="0" y="0" width="340" height="188"></rect>
		<rect class="sme-ground" x="0" y="188" width="340" height="24"></rect>
		<rect class="sme-sand" x="262" y="185" width="70" height="7" rx="2"></rect>
		<!-- the ladder and the platform -->
		<path class="sme-ladder" d="M14 188 L34 88 M30 188 L50 88 M17 174 H33 M21 154 H37 M25 134 H41 M29 114 H45 M33 96 H48"></path>
		<path class="sme-post" d="M28 88 V188 M56 88 V188"></path>
		<rect class="sme-plat" x="24" y="85" width="36" height="5" rx="1"></rect>
		<path class="sme-rail-top" d="M26 85 V60 H58 V85 M26 72 H58"></path>
		<!-- the far side wall of the chute, the chute itself -->
		<path class="sme-chute-far" d="M57 76 L230 176 L262 176"></path>
		<path class="sme-chute" d="M57 88 L230 188 Q236 191 244 191 H262 V194 H244 Q234 194 228 191 L57 92 Z"></path>
		<path class="sme-chute-leg" d="M222 186 V188 M140 136 V188"></path>
		<g data-child></g>
		<!-- the near side wall (low) and its rail in front of the child -->
		<path class="sme-chute-near" d="M57 80 L230 180 L262 180"></path>
		<g data-arrows></g>
		<text class="t-small t-halo" x="334" y="16" text-anchor="end" data-ref></text>
		<path class="sme-ref" d="M200 188 H262"></path>
		<text class="t-small t-halo" x="226" y="204" text-anchor="middle">нулевой уровень</text>
	</svg>
	<div class="g7__grid sme-slide-grid">
		<div class="g7__side">
			<div class="g7__seg sme-mu" data-mu>
				<button type="button" class="g7__btn" data-v="0"><i>μ</i> = 0 (так не бывает)</button>
				<button type="button" class="g7__btn" data-v="0.1"><i>μ</i> = 0,10</button>
				<button type="button" class="g7__btn" data-v="0.25" aria-pressed="true"><i>μ</i> = 0,25</button>
				<button type="button" class="g7__btn" data-v="0.4"><i>μ</i> = 0,40</button>
			</div>
			<label class="g7__slider"><span>Масса ребёнка <i>m</i></span><output data-om></output><input type="range" min="20" max="50" step="5" value="30" data-m aria-label="Масса ребёнка, килограммы" /></label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Съехать</button>
				<button type="button" class="g7__btn" data-reset>Сначала</button>
			</div>
			<p class="g7__msg" data-msg></p>
		</div>
		<div class="sme-out">
			<svg class="g7__svg" viewBox="0 0 240 150" role="img" aria-label="Столбики: потенциальная, кинетическая, полная механическая и внутренняя энергия"><g data-bars></g></svg>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Длина горки 4,0&nbsp;м, её верх на 2,0&nbsp;м выше нижнего конца. Красная стрелка — сила трения <Fragment set:html={kv('\\vec F_{\\text{тр}}')} />, синяя — скорость <Fragment set:html={kv('\\vec\\upsilon')} />. Золотой столбик — потенциальная энергия, синий — кинетическая, зелёный — полная механическая, фиолетовый — внутренняя энергия, в которую переходит механическая энергия из-за трения; пунктир — энергия в начале. Время идёт как настоящее.
	</figcaption>
</figure>

<style is:global>
	.sme .sme-sand {
		fill: hsl(42, 55%, 62%);
	}
	.sme .sme-ladder,
	.sme .sme-post,
	.sme .sme-rail-top {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.sme .sme-plat {
		fill: var(--g7-wood);
	}
	.sme .sme-chute {
		fill: var(--g7-steel);
		stroke: var(--g7-steel-dark);
		stroke-width: 0.8;
	}
	.sme .sme-chute-far,
	.sme .sme-chute-near {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-steel) 70%, var(--sl-color-gray-2));
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.sme .sme-chute-far {
		opacity: 0.6;
	}
	.sme .sme-chute-leg {
		stroke: var(--g7-steel-dark);
		stroke-width: 2.4;
	}
	.g7 .g7__grid.sme-slide-grid {
		margin-top: 0.75rem;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	}
	@container (max-width: 36rem) {
		.g7 .g7__grid.sme-slide-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.sme .sme-mu .g7__btn {
		flex: 1 1 45%;
	}
</style>

<script>
	import { loop, segment } from '../g7/kit';
	import { figure } from '@components/people';
	import { el, energyBars, f1, fmt, G, label, newArrow, vecMark } from './sme';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-sme-slide]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const K = 50;
		const L = 4.0;
		const TH = (30 * Math.PI) / 180;
		const TOP = { x: 57, y: 88 }; // the top end of the chute's surface
		const D = { x: Math.cos(TH), y: Math.sin(TH) }; // down the chute
		const NRM = { x: Math.sin(TH), y: -Math.cos(TH) }; // out of the surface
		const S = 0.5; // px per см
		const HC = 125;
		const u = S * HC;
		const st = { mu: 0.25, m: 30 };
		const childG = $<SVGGElement>('[data-child]');
		let child = figure(childG, { s: S, H: HC, age: 'child', shirt: 'hm-blue', hair: 'pony', shorts: true, girth: 1, name: 'child on slide' });
		const arrows = $<SVGGElement>('[data-arrows]');
		const fArrow = newArrow(arrows, 'red');
		const vArrow = newArrow(arrows, 'blue');
		const fLab = label(arrows, 0, 0, [['F', 'тр']], { class: 't-red t-halo t-small' });
		const vLab = label(arrows, 0, 0, [['υ']], { class: 't-blue t-halo' });
		const fVec = vecMark(fLab, 0, 'red');
		const vVec = vecMark(vLab, 0, 'blue');
		const read = $<HTMLUListElement>('[data-read]');
		const msg = $<HTMLElement>('[data-msg]');
		const inM = $<HTMLInputElement>('[data-m]');
		const barsG = $<SVGGElement>('[data-bars]');
		let bars: ReturnType<typeof energyBars>;
		const ref = $('[data-ref]');
		const a = () => G * (Math.sin(TH) - st.mu * Math.cos(TH));
		const tEnd = () => Math.sqrt((2 * L) / a());
		let t = 0;
		let running = false;
		const P = (s: number) => ({ x: TOP.x + D.x * s * K, y: TOP.y + D.y * s * K });
		const build = () => {
			child = figure(childG, { s: S, H: HC, age: 'child', shirt: 'hm-blue', hair: 'pony', shorts: true, girth: 0.85 + ((st.m - 20) / 30) * 0.45, name: 'child on slide' });
			barsG.replaceChildren();
			const E0 = st.m * G * L * Math.sin(TH);
			bars = energyBars(barsG, { x: 30, base: 122, full: 100, max: E0, kinds: ['ep', 'ek', 'e', 'u'], w: 30, gap: 20, digits: 0, ref: true });
		};
		const draw = () => {
			const T = tEnd();
			const tt = Math.min(t, T);
			const s = (a() * tt * tt) / 2;
			const v = a() * tt;
			const m = st.m;
			const N = m * G * Math.cos(TH);
			const F = st.mu * N;
			const h = (L - s) * Math.sin(TH);
			const ep = m * G * h;
			const ek = (m * v * v) / 2;
			const q = F * s;
			bars([ep, ek, ep + ek, q]);
			// the child: sits on the chute, legs along it, hands on the side rails
			const c = P(s);
			const hip = { x: c.x + NRM.x * 0.06 * u, y: c.y + NRM.y * 0.06 * u };
			const legL = 0.93 * (0.218 + 0.217) * u;
			const ank = { x: hip.x + D.x * legL + NRM.x * 0.02 * u, y: hip.y + D.y * legL + NRM.y * 0.02 * u };
			const rail = (k: number) => ({ x: hip.x + D.x * k * u + NRM.x * 0.13 * u, y: hip.y + D.y * k * u + NRM.y * 0.13 * u });
			child.pose({
				hip,
				lean: -0.12,
				ankles: [ank, { x: ank.x - D.x * 0.02 * u, y: ank.y - D.y * 0.02 * u }],
				feet: [-0.85, -0.85],
				hands: [
					{ at: rail(0.08), pose: 'grip', d: 3, dir: TH, contact: 'rail' },
					{ at: rail(0.02), pose: 'grip', d: 3, dir: TH, contact: 'rail' },
				],
				head: 0.05,
			});
			// the arrows: friction at the contact, up the slope; the velocity above the legs, down the slope
			const fl = running || t > 0 ? F * 0.35 : 0; // before the start she holds on: no sliding friction yet
			const fc = { x: c.x + NRM.x * 2, y: c.y + NRM.y * 2 };
			fArrow(fc.x, fc.y, fc.x - D.x * fl, fc.y - D.y * fl, 6, 3.5);
			fLab.setAttribute('x', f1(c.x - D.x * fl - 14));
			fLab.setAttribute('y', f1(c.y - D.y * fl + 22));
			fLab.setAttribute('visibility', fl > 1 ? 'visible' : 'hidden');
			const vb = { x: hip.x + NRM.x * 0.38 * u, y: hip.y + NRM.y * 0.38 * u };
			vArrow(vb.x, vb.y, vb.x + D.x * v * 6, vb.y + D.y * v * 6, 6, 3.5);
			vLab.setAttribute('x', f1(vb.x + D.x * v * 6 + 3));
			vLab.setAttribute('y', f1(vb.y + D.y * v * 6 - 3));
			vLab.setAttribute('visibility', v > 0.3 ? 'visible' : 'hidden');
			fVec();
			vVec();
			const done = tt >= T - 1e-9;
			// the speed without friction only after a run with μ = 0 (it is the answer of a task)
			ref.textContent = done && t > 0 && st.mu === 0 ? 'без трения внизу: 6,26 м/с' : '';
			const E0 = m * G * L * Math.sin(TH);
			read.innerHTML = [
				`<li><span>Сила реакции опоры <i>N</i></span><b>${fmt(N, 1)} Н</b></li>`,
				`<li><span>Сила трения <i>F</i><sub>тр</sub> = <i>μN</i></span><b>${fmt(F, 1)} Н</b></li>`,
				`<li class="is-warm"><span>Путь по горке <i>l</i></span><b>${fmt(s, 2)} м</b></li>`,
				`<li><span>Работа силы трения <i>A</i><sub>тр</sub></span><b>${fmt(-q, 1)} Дж</b></li>`,
				`<li class="is-key"><span>Скорость <i>υ</i></span><b>${fmt(v, 2)} м/с</b></li>`,
			].join('');
			msg.innerHTML = done
				? `Внизу: <i>υ</i> = ${fmt(v, 2)} м/с; перешло во внутреннюю энергию: ${fmt(q, 1)} Дж (${fmt((100 * q) / E0, 1)} %)`
				: `В начале: <i>E</i> = <i>E</i><sub>п</sub> = <i>mgh</i> = ${fmt(E0, 0)} Дж`;
		};
		const wake = loop(fig, (dt) => {
			if (!running) return false;
			t += dt;
			if (t >= tEnd()) {
				t = tEnd();
				running = false;
			}
			draw();
			return running;
		});
		const reset = () => {
			running = false;
			t = 0;
			$<HTMLOutputElement>('[data-om]').textContent = `${st.m} кг`;
			build();
			draw();
		};
		segment($('[data-mu]'), (b) => {
			st.mu = Number(b.dataset.v);
			reset();
		});
		inM.addEventListener('input', () => {
			st.m = Number(inM.value);
			reset();
		});
		$('[data-go]').addEventListener('click', () => {
			t = 0;
			running = true;
			draw();
			wake();
		});
		$('[data-reset]').addEventListener('click', reset);
		reset();
	}
</script>
