---
/**
 * Picture «Опыт Джоуля» (1845) to «Внутренняя энергия идеального газа» (schematic sizes, slowed down). Two equal
 * copper vessels joined by a tube with a tap (inner bore drawn 22 px) lie in one can of water with a thermometer. At first the left vessel holds
 * air at about 22 атм and the right one is empty. The tap opens (its handle turns a quarter turn in 0,5 с) and the air
 * streams across until both vessels hold the same amount, about 11 атм each. The air expands into emptiness: it pushes
 * nothing, so it does no work, A′ = 0, and gets no heat, Q = 0; the water's temperature stays the same (15,0 °C, the
 * column does not move), so ΔU = 0 at a changed volume: the internal energy of the gas does not depend on its volume.
 * Joule's real result: no change he could detect (a real gas cools a little, an ideal one not at all).
 * The molecules: 44 points that fly straight and bounce off the walls (speeds drawn once from the same spread and never
 * changed: the same temperature before and after; slowed down billions of times). The gauges show the pressures levelling out,
 * 11·(1 ± e^(−t/1 с)) атм from the moment the tap is half open: 1 с is the time constant of the points' own flow
 * (measured on this drawing: the excess of points in the left vessel falls e times in about 1 с; 44 points jitter by
 * a few around the half, a real gauge does not). The walls of the vessels are
 * slightly rough (a bounce tilts by up to ±0,3 rad): in a smooth round vessel some points would circle for ever. One loop: 8 с (1,2 с closed, the
 * tap opens, about 5 с of flow; then the picture fades and starts again).
 */
import G7Styles from '../g7/G7Styles.astro';

const CY = 128;
const C1 = 120;
const C2 = 240;
const RV = 34;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow jl not-content" data-joule>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 206" role="img" aria-label="Опыт Джоуля: два медных сосуда, соединённых трубкой с краном, в банке с водой. В левом сжатый воздух, правый пустой. Кран открывают, воздух перетекает, пока давление в сосудах не сравняется. Термометр в воде показывает одну и ту же температуру">
			<!-- the can of water -->
			<path class="jl-can" d="M24 52 V196 H336 V52"></path>
			<rect class="jl-water" x="26" y="66" width="308" height="128"></rect>
			<path class="jl-surface" d="M26 66 H334"></path>
			<!-- stems of the gauges -->
			<path class="jl-stem" d={`M${C1} ${CY - RV} V42 M${C2} ${CY - RV} V42`}></path>
			<!-- the vessels and the tube -->
			<rect class="jl-tube" x={C1 + RV - 6} y={CY - 13} width={C2 - C1 - 2 * RV + 12} height="26"></rect>
			<circle class="jl-vessel" cx={C1} cy={CY} r={RV}></circle>
			<circle class="jl-vessel" cx={C2} cy={CY} r={RV}></circle>
			<rect class="jl-tube-in" x={C1 + RV - 8} y={CY - 11} width={C2 - C1 - 2 * RV + 16} height="22"></rect>
			<circle class="jl-in" cx={C1} cy={CY} r={RV - 2}></circle>
			<circle class="jl-in" cx={C2} cy={CY} r={RV - 2}></circle>
			<g data-mols></g>
			<!-- the tap: a gate in the tube and a handle on top -->
			<rect class="jl-gate" data-gate x="177" y={CY - 11} width="6" height="22"></rect>
			<circle class="jl-valve" cx="180" cy={CY - 17} r="5"></circle>
			<rect class="jl-handle" data-handle x="178" y={CY - 33} width="4" height="16" rx="1.5"></rect>
			<text class="t-small jl-s" x="180" y={CY + 32} text-anchor="middle">кран</text>
			<!-- the gauges -->
			{[C1, C2].map((cx, i) => (
				<g>
					<circle class="jl-dial" cx={cx} cy="30" r="12"></circle>
					<path class="jl-scale" d={Array.from({ length: 6 }, (_, k) => { const a = (-225 + k * 54) * Math.PI / 180; return `M${(cx + 9 * Math.cos(a)).toFixed(1)} ${(30 + 9 * Math.sin(a)).toFixed(1)} L${(cx + 11 * Math.cos(a)).toFixed(1)} ${(30 + 11 * Math.sin(a)).toFixed(1)}`; }).join(' ')}></path>
					<line class="jl-needle" data-needle={i} x1={cx} y1="30" x2={cx} y2="21"></line>
					<text class="t-title t-num jl-val" data-val={i} x={cx + 17} y="35">{i ? '0 атм' : '22 атм'}</text>
				</g>
			))}
			<!-- the thermometer in the water -->
			<rect class="jl-thermo" x="42" y="20" width="8" height="150" rx="4"></rect>
			<circle class="jl-bulb" cx="46" cy="174" r="7"></circle>
			<rect class="jl-column" x="44.5" y="96" width="3" height="76"></rect>
			<path class="jl-ticks" d={Array.from({ length: 13 }, (_, k) => `M50 ${30 + k * 11} h${k % 2 ? 3 : 5}`).join(' ')}></path>
			<text class="t-title t-num jl-val" x="56" y="14">15,0&nbsp;°C</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Опыт Джоуля (1845): воздух занял вдвое больший объём, но работы не совершал — расширялся в пустоту — и теплоты не получал. Температура воды и воздуха не изменилась: внутренняя энергия газа не зависит от его объёма. Схема; движение молекул замедлено.
	</figcaption>
</figure>

<style is:global>
	.jl-can {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.jl-water {
		fill: var(--g7-water);
	}
	.jl-surface {
		stroke: var(--g7-water-edge);
		stroke-width: 1.2;
	}
	.jl-vessel,
	.jl-tube {
		fill: hsl(22, 55%, 50%);
	}
	.jl-in,
	.jl-tube-in {
		fill: var(--g7-paper);
	}
	.jl-stem {
		fill: none;
		stroke: hsl(22, 55%, 50%);
		stroke-width: 3;
	}
	.jl-mol {
		fill: var(--g7-blue);
	}
	.jl-gate {
		fill: var(--sl-color-gray-2);
	}
	.jl-valve,
	.jl-handle {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.jl-dial {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.jl-scale {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.jl-needle {
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.jl-thermo {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.jl-bulb,
	.jl-column {
		fill: var(--g7-red);
	}
	.jl-ticks {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.g7__svg .jl-val {
		font-size: 12px;
	}
	@media (max-width: 40rem) {
		.g7__svg .jl-val {
			font-size: 13px;
		}
		.g7__svg .jl-s {
			font-size: 12.5px;
		}
	}
</style>

<script>
	import { el, loop, rng, ease } from '../g7/kit';

	const CY = 128;
	const C1 = 120;
	const C2 = 240;
	const RIN = 32 - 2.2; // a point's center stays this far from a vessel's center
	const TY = 11 - 2.2; // … and this far from the tube's axis
	const TX0 = C1 + 26;
	const TX1 = C2 - 26;
	const N = 44;
	const LOOP = 8;
	const f = (v: number) => v.toFixed(1);
	const inV = (x: number, y: number, c: number) => (x - c) ** 2 + (y - CY) ** 2 < RIN * RIN;
	const inT = (x: number, y: number) => x > TX0 && x < TX1 && Math.abs(y - CY) < TY;

	for (const root of document.querySelectorAll<HTMLElement>('[data-joule]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const g = $<SVGGElement>('[data-mols]');
		const gate = $<SVGRectElement>('[data-gate]');
		const handle = $<SVGRectElement>('[data-handle]');
		const needles = [0, 1].map((i) => $<SVGLineElement>(`[data-needle="${i}"]`));
		const vals = [0, 1].map((i) => $<SVGTextElement>(`[data-val="${i}"]`));
		const rnd = rng(17);
		// speeds from one spread (2D: Rayleigh, mean about 250 px/s), kept for ever
		const mols = Array.from({ length: N }, () => {
			const c = el('circle', { class: 'jl-mol', r: 2.2 });
			g.append(c);
			const v = 200 * Math.sqrt(-2 * Math.log(1 - 0.98 * rnd()));
			const a = rnd() * 2 * Math.PI;
			return { c, x: 0, y: 0, vx: v * Math.cos(a), vy: v * Math.sin(a) };
		});
		const start = () => {
			for (const m of mols) {
				do {
					m.x = C1 - RIN + 2 * RIN * rnd();
					m.y = CY - RIN + 2 * RIN * rnd();
				} while (!inV(m.x, m.y, C1));
			}
		};
		start();
		let t = 0;
		let shown = [22, 0];
		loop(root, (dt) => {
			const prev = t;
			t = (t + dt) % LOOP;
			if (t < prev) {
				start();
				shown = [22, 0];
			}
			const open = ease((t - 1.2) / 0.5) * (1 - ease((t - 7.4) / 0.3));
			const closed = open < 0.5;
			handle.setAttribute('transform', `rotate(${f(90 * open)} 180 ${CY - 17})`);
			gate.style.opacity = f(1 - open);
			const fade = t > 7.4 ? 1 - ease((t - 7.4) / 0.3) : t < 0.3 ? ease(t / 0.3) : 1;
			g.style.opacity = f(fade);
			const ok = (x: number, y: number) => inV(x, y, C1) || inV(x, y, C2) || inT(x, y);
			let left = 0;
			for (const m of mols) {
				const nx = m.x + m.vx * dt;
				const ny = m.y + m.vy * dt;
				const crosses = closed && inT(m.x, m.y) && (m.x - 180) * (nx - 180) <= 0;
				if (ok(nx, ny) && !crosses) {
					m.x = nx;
					m.y = ny;
				} else if (crosses) {
					m.vx = -m.vx;
				} else if (inT(m.x, m.y) && !inV(m.x, m.y, C1) && !inV(m.x, m.y, C2)) {
					m.vy = -m.vy;
				} else {
					// a vessel wall: reflect about the normal
					const c = inV(m.x, m.y, C1) ? C1 : C2;
					const nxn = (nx - c) / RIN;
					const nyn = (ny - CY) / RIN;
					const ln = Math.hypot(nxn, nyn) || 1;
					// a slightly rough wall: the normal is tilted at random by up to ±0,3 rad (a smooth round
					// vessel would keep some points circling near its wall for ever, away from the tube)
					const j = (Math.random() - 0.5) * 0.6;
					let ux = (nxn * Math.cos(j) - nyn * Math.sin(j)) / ln;
					let uy = (nxn * Math.sin(j) + nyn * Math.cos(j)) / ln;
					if (m.vx * ux + m.vy * uy <= 0) (ux = nxn / ln), (uy = nyn / ln);
					const dot = m.vx * ux + m.vy * uy;
					if (dot > 0) {
						m.vx -= 2 * dot * ux;
						m.vy -= 2 * dot * uy;
					} else {
						m.vy = -m.vy;
					}
				}
				if (m.x < 180) left++;
				m.c.setAttribute('cx', f(m.x));
				m.c.setAttribute('cy', f(m.y));
			}
			// the gauges: the pressures of the two vessels levelling out with the time constant of the points' flow
			const e = t > 1.45 ? Math.exp(-(t - 1.45) / 1.0) : 1;
			shown = [11 + 11 * e, 11 - 11 * e];
			void left;
			shown.forEach((s, i) => {
				const a = ((-225 + (s / 25) * 270) * Math.PI) / 180;
				const cx = i ? C2 : C1;
				needles[i].setAttribute('x2', f(cx + 9 * Math.cos(a)));
				needles[i].setAttribute('y2', f(30 + 9 * Math.sin(a)));
				vals[i].textContent = `${Math.round(s)} атм`;
			});
			return true;
		});
	}
</script>
