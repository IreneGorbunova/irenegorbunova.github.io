---
/**
 * Two short looping opening scenes of «Основы термодинамики. Тепловые двигатели» (grade 10). No terms of the chapter
 * in the pictures or the visible captions; each caption's popover names the notion and links to its section. People:
 * the shared people kit (src/components/people/). Grade 8 «Тепловые двигатели» has a kettle lid, a car and a power
 * station; grade 10 «Основы МКТ» has the tyre pump, so this chapter shows a soda bottle and a Stirling engine.
 *
 * Bottle (a kitchen, side view; 1,4 px per см on both axes, real time, 6 с). A teenage girl (people kit, 156 см) stands
 *   at a kitchen table 75 см high. Her near (right) hand holds a cold 1,5-л bottle of sparkling water (33 см high,
 *   9 см across) round its body, the back of the hand to us; her far (left) hand reaches the cap in 0,7 с and turns it
 *   with the thumb and the index finger (the wrist rolls to and fro, the ribs of the cap slide). At 2,5 с the gas under
 *   the cap (about three atmospheres) bursts out: it expands fast and cools by tens of degrees (an ideal adiabatic
 *   expansion of carbon dioxide from 3 to 1 атм would cool it from 5 °C by about 60 К), the water vapour in it
 *   condenses, and a small cloud of fog rises from the neck at 8–14 см/с and vanishes within 1,5 с. Then bubbles rise
 *   in the water. She puts the cap on the table beside the bottle and lays the hand on the table again, so the loop
 *   ends in its first pose (only the cap is back on the bottle when it restarts).
 * Stirling engine (an evening room, side view; 2,8 px per см; a magnifier circle in the upper right shows the mug top
 *   and the engine 1,85 times larger, a copy of the same drawing refreshed every frame, so the engine is about 57 units wide there; the teen 165 см seated, only the upper body in the
 *   picture). On the table a big mug of hot tea (9,5 см across, 10,5 см high) is covered by a low-temperature Stirling
 *   engine: a flat round can 11 см across and 2,4 см high (its bottom plate lies on the mug, its top plate is in the
 *   room air, a light foam displacer moves inside it), a small power cylinder on top and a flywheel 8 см across on a
 *   crank 9 см above the can; the power piston and the displacer are driven by two cranks a quarter turn apart.
 *   The teen gives the rim of the flywheel a flick with the index finger (real time, 0,2 с), and the wheel runs on by
 *   itself. From 1,2 с the time is sped up about 650 times (the wall clock runs from 19:00 to 20:35 in 8,8 с): the tea
 *   cools from 85 °C in a room at 22 °C with a time constant of 40 мин (the engine is a lid), T = 22 + 63·e^(−t/40 мин)
 *   °C; the engine runs while the bottom is warmer than the top by more than ΔT_min ≈ 6 К, at a speed taken
 *   proportional to ΔT − ΔT_min (illustrative): 2 об/с at ΔT = 63 К, slowing down and stopping at about 1 ч 35 мин.
 *   The wheel is always drawn turning at its real speed of that moment (only the clock and the cooling are sped up).
 *   Faint wisps of vapour leak at the rim while the tea is hot. Then the teen wraps a hand round the mug: only warm.
 *   The hand goes back to the table at the end, so the loop ends in its first pose.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// ---- the bottle scene (1,4 px per см)
const S1 = 1.4;
const FL = 232; // the floor
const TT = FL - 75 * S1; // the table top, 127
const NX = 172; // the bottle's axis
const bottle = 'M-4.5 0 L-4.5 -20.5 Q-4.5 -24.5 -2.6 -26.6 Q-1.4 -28 -1.4 -29.6 L-1.4 -33 L1.4 -33 L1.4 -29.6 Q1.4 -28 2.6 -26.6 Q4.5 -24.5 4.5 -20.5 L4.5 0 Z';
const water = 'M-4.1 -0.4 L-4.1 -20.4 Q-4.1 -23.6 -2.5 -25.2 L2.5 -25.2 Q4.1 -23.6 4.1 -20.4 L4.1 -0.4 Z';

// ---- the Stirling scene (2,8 px per см)
const S2 = 2.8;
const T2 = 200; // the table top
const MX = 214; // the mug's axis
const MUG_TOP = T2 - 10.5 * S2; // 170,6
const CAN_TOP = MUG_TOP - 2.4 * S2; // 163,9
const AY = CAN_TOP - 9 * S2; // the flywheel's axle, 138,7
const R = 4 * S2; // the flywheel's radius, 11,2 px
const mugHalf = 4.75 * S2;
const canHalf = 5.5 * S2;
const f1 = (v: number) => v.toFixed(1);
// the magnifier over the engine: a circle of radius 44 at (306, 82) shows the mug top and the engine 1,85 times larger
const uid = `td${Math.random().toString(36).slice(2, 8)}`;
const LX = 306;
const LY = 82;
const LR = 44;
const LK = 1.85;
const LC = { x: MX, y: 150 }; // the scene point at the center of the magnifier
const clockTicks = (cx: number, cy: number, r1: number, r2: number) =>
	Array.from({ length: 12 }, (_, k) => {
		const a = (k * Math.PI) / 6;
		return `M${f1(cx + r1 * Math.cos(a))} ${f1(cy + r1 * Math.sin(a))} L${f1(cx + r2 * Math.cos(a))} ${f1(cy + r2 * Math.sin(a))}`;
	}).join(' ');
---

<PeopleStyles />
<IntroFrame data-tdintro>
	<div class="intro__card" data-scene="bottle">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка на кухне открывает холодную бутылку газировки: одной рукой держит бутылку, другой поворачивает крышку. Над горлышком появляется облачко тумана и тут же исчезает, в воде поднимаются пузырьки">
			<rect class="td-wall" x="0" y="0" width="360" height={FL}></rect>
			<path class="td-tiles" d={Array.from({ length: 6 }, (_, k) => `M190 ${74 + k * 6} H360`).join(' ') + ' ' + Array.from({ length: 12 }, (_, k) => `M${196 + k * 14} 74 V108`).join(' ')}></path>
			<rect class="td-floor" x="0" y={FL} width="360" height={240 - FL}></rect>
			<path class="td-floorline" d={`M0 ${FL} H360`}></path>
			<!-- the window over the back counter, an evening garden behind it -->
			<rect class="td-win2" x="196" y="16" width="88" height="54" rx="2"></rect>
			<path class="td-tree2" d="M204 70 Q198 50 214 44 Q220 28 238 36 Q258 32 256 52 Q268 60 262 70 Z"></path>
			<path class="td-frame" d="M196 16 H284 V70 H196 Z M240 16 V70"></path>
			<rect class="td-sill" x="192" y="69" width="96" height="4" rx="1"></rect>
			<!-- upper cabinets -->
			<rect class="td-cab" x="292" y="10" width="68" height="52" rx="2"></rect>
			<path class="td-cabline" d="M326 10 V62 M320 34 V42 M332 34 V42"></path>
			<!-- the back counter along the wall (farther away: smaller and higher) -->
			<rect class="td-counter-top" x="186" y="108" width="174" height="4"></rect>
			<rect class="td-counter" x="188" y="112" width="172" height="100"></rect>
			<path class="td-cabline" d="M246 112 V212 M304 112 V212 M190 130 H360 M236 150 V160 M256 150 V160 M296 150 V160 M314 150 V160"></path>
			<rect class="td-plinth" x="188" y="212" width="172" height="6"></rect>
			<!-- a kettle and jars on the back counter -->
			<path class="td-kettle" d="M300 108 L302 92 Q312 86 322 92 L324 108 Z"></path>
			<path class="td-kettle-h" d="M303 92 Q312 80 321 92"></path>
			<path class="td-kettle" d="M324 98 L332 92 L331 95 L324 102 Z"></path>
			<rect class="td-jar" x="268" y="94" width="12" height="14" rx="2"></rect>
			<rect class="td-jar td-jar--b" x="252" y="98" width="11" height="10" rx="2"></rect>
			<!-- a shelf with jars and a plant -->
			<rect class="td-shelf" x="16" y="58" width="92" height="4"></rect>
			<rect class="td-jar" x="22" y="42" width="14" height="16" rx="3"></rect>
			<rect class="td-jar td-jar--b" x="42" y="38" width="18" height="20" rx="3"></rect>
			<rect class="td-jar" x="68" y="46" width="12" height="12" rx="3"></rect>
			<path class="td-plant" d="M90 58 L92 50 L100 50 L102 58 Z M96 50 Q90 40 86 36 M96 50 Q96 38 98 32 M96 50 Q102 42 106 40"></path>
			<!-- the girl's far arm and leg are moved here, behind the table and the bottle -->
			<g data-girl-far></g>
			<!-- the kitchen table in front, 75 см high -->
			<rect class="td-table" x="146" y={TT + 4} width="5" height={FL - TT - 4}></rect>
			<rect class="td-table" x="300" y={TT + 4} width="5" height={FL - TT - 4}></rect>
			<rect class="td-table-apron" x="146" y={TT + 4} width="159" height="7"></rect>
			<rect class="td-table-edge" x="140" y={TT} width="172" height="5" rx="1"></rect>
			<!-- a glass, 8 см across and 11 см high -->
			<path class="td-glass" d={`M262 ${TT} L260.6 ${TT - 15.4} L272 ${TT - 15.4} L270.6 ${TT} Z`}></path>
			<path class="td-glass-water" d={`M261.4 ${TT - 0.6} L260.9 ${TT - 8} L271.7 ${TT - 8} L271.2 ${TT - 0.6} Z`}></path>
			<!-- the fingers of the near hand behind the bottle -->
			<g data-gback></g>
			<!-- the bottle: 33 см high, 9 см across, its bottom on the table -->
			<g transform={`translate(${NX} ${TT}) scale(${S1})`}>
				<path class="td-bottle" d={bottle}></path>
				<path class="td-water" d={water}></path>
				<g data-bubbles></g>
				<rect class="td-label" x="-4.5" y="-15" width="9" height="6"></rect>
				<path class="td-shine" d="M-3 -20 V-3"></path>
			</g>
			<g data-cap>
				<rect class="td-cap" x="-1.6" y="-2" width="3.2" height="2" rx="0.4"></rect>
				<path class="td-cap-ribs" data-ribs d=""></path>
			</g>
			<g data-girl></g>
			<g data-fog></g>
		</svg>
		<div class="intro__foot">
			<p>
				Когда открывают холодную бутылку газировки, над горлышком на миг появляется{' '}
				<More term="облачко тумана">
					Газ под крышкой сжат примерно втрое сильнее, чем воздух вокруг. Вырываясь, он быстро расширяется и совершает работу — его внутренняя энергия уменьшается, и он охлаждается на десятки градусов. Водяной пар в нём превращается в капельки тумана. Об этом — раздел{' '}
					<a href="#первый-закон-термодинамики-для-изопроцессов">«Первый закон термодинамики для изопроцессов»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="stirling">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер. Подросток за столом щелчком пальца раскручивает маховик маленького двигателя, который стоит на кружке с горячим чаем. Маховик крутится сам, часы на стене бегут вперёд, чай остывает, маховик замедляется и останавливается. Подросток обхватывает кружку рукой: она уже только тёплая">
			<rect class="td-wall2" x="0" y="0" width="360" height="240"></rect>
			<!-- the window: evening sky, the houses across the street -->
			<rect class="td-night" x="128" y="18" width="118" height="96" rx="2"></rect>
			<path class="td-houses" d="M128 114 V70 H150 V60 H176 V78 H200 V52 H226 V74 H246 V114 Z"></path>
			{[[136, 76], [156, 66], [162, 80], [182, 84], [206, 58], [214, 70], [206, 90], [232, 80], [138, 94], [214, 100]].map(([x, y]) => <rect class="td-lit" x={x} y={y} width="5" height="6"></rect>)}
			<circle class="td-moon" cx="226" cy="34" r="6"></circle>
			<path class="td-frame" d="M128 18 H246 V114 H128 Z M187 18 V114 M128 64 H246"></path>
			<path class="td-curtain" d="M120 12 Q130 60 122 122 L134 122 Q138 60 130 12 Z M254 12 Q244 60 252 122 L240 122 Q236 60 244 12 Z"></path>
			<rect class="td-rodw" x="116" y="10" width="142" height="3" rx="1.5"></rect>
			<!-- the wall clock -->
			<circle class="td-clock" cx="340" cy="24" r="16"></circle>
			<path class="td-clock-ticks" d={clockTicks(340, 24, 12.4, 14.4)}></path>
			<line class="td-hand-h" data-hh x1="340" y1="24" x2="340" y2="16"></line>
			<line class="td-hand-m" data-hm x1="340" y1="24" x2="340" y2="12"></line>
			<circle class="td-clock-pin" cx="340" cy="24" r="1.4"></circle>
			<!-- the chair back behind the teen -->
			<rect class="td-chair" x="16" y="140" width="9" height="100" rx="3"></rect>
			<rect class="td-chair" x="10" y="134" width="20" height="9" rx="3"></rect>
			<g data-teen></g>
			<!-- the table (75 см high) -->
			<rect class="td-table-edge" x="100" y={T2} width="260" height="7"></rect>
			<rect class="td-under" x="104" y={T2 + 7} width="256" height={240 - T2 - 7}></rect>
			<!-- a desk lamp and a book -->
			<path class="td-lamplight" d={`M272 ${T2 - 58} L296 ${T2 - 50} L330 ${T2} L232 ${T2} Z`}></path>
			<path class="td-lampbase" d={`M318 ${T2} Q322 ${T2 - 5} 330 ${T2 - 5} Q338 ${T2 - 5} 342 ${T2} Z`}></path>
			<path class="td-lamparm" d={`M330 ${T2 - 5} L322 ${T2 - 52} L292 ${T2 - 66}`}></path>
			<path class="td-lampshade" d={`M282 ${T2 - 74} L304 ${T2 - 62} L296 ${T2 - 50} L272 ${T2 - 58} Z`}></path>
			<rect class="td-book" x="252" y={T2 - 7} width="46" height="7" rx="1"></rect>
			<path class="td-book-pages" d={`M254 ${T2 - 4.5} H296 M254 ${T2 - 2.5} H296`}></path>
			<g data-eng>
			<!-- vapour leaking at the rim -->
			<g data-wisps>
				<path class="td-wisp" d=""></path>
				<path class="td-wisp" d=""></path>
				<path class="td-wisp" d=""></path>
			</g>
			<!-- the fingers of the near hand behind the mug, when it holds the mug -->
			<g data-mback></g>
			<!-- the mug -->
			<path class="td-mug-handle" d={`M${f1(MX + mugHalf - 1)} ${f1(MUG_TOP + 6)} Q${f1(MX + mugHalf + 12)} ${f1(MUG_TOP + 6)} ${f1(MX + mugHalf + 11)} ${f1(MUG_TOP + 15)} Q${f1(MX + mugHalf + 10)} ${f1(MUG_TOP + 23)} ${f1(MX + mugHalf - 1)} ${f1(MUG_TOP + 22)}`}></path>
			<path class="td-mug" d={`M${f1(MX - mugHalf)} ${f1(MUG_TOP)} L${f1(MX - mugHalf + 1)} ${f1(T2 - 2)} Q${f1(MX - mugHalf + 1.5)} ${T2} ${f1(MX - mugHalf + 4)} ${T2} L${f1(MX + mugHalf - 4)} ${T2} Q${f1(MX + mugHalf - 1.5)} ${T2} ${f1(MX + mugHalf - 1)} ${f1(T2 - 2)} L${f1(MX + mugHalf)} ${f1(MUG_TOP)} Z`}></path>
			<path class="td-mug-band" d={`M${f1(MX - mugHalf + 0.5)} ${f1(MUG_TOP + 9)} H${f1(MX + mugHalf - 0.5)}`}></path>
			<!-- the engine: the can (bottom plate warm, top plate in the room air), the displacer inside -->
			<rect class="td-plate-hot" data-hotplate x={f1(MX - canHalf)} y={f1(MUG_TOP - 1)} width={f1(2 * canHalf)} height="1.6" rx="0.5"></rect>
			<rect class="td-can" x={f1(MX - canHalf + 1)} y={f1(CAN_TOP + 1)} width={f1(2 * canHalf - 2)} height={f1(MUG_TOP - CAN_TOP - 2)}></rect>
			<rect class="td-displacer" data-disp x={f1(MX - canHalf + 2.5)} y="0" width={f1(2 * canHalf - 5)} height="2.2" rx="0.8"></rect>
			<rect class="td-plate" x={f1(MX - canHalf)} y={f1(CAN_TOP)} width={f1(2 * canHalf)} height="1.6" rx="0.5"></rect>
			<!-- the stand of the axle (behind the wheel) and the power cylinder -->
			<path class="td-stand" d={`M${f1(MX - 9)} ${f1(CAN_TOP)} L${f1(MX)} ${f1(AY)} L${f1(MX + 9)} ${f1(CAN_TOP)}`}></path>
			<rect class="td-cyl" x={f1(MX - 2.6)} y={f1(CAN_TOP - 8.4)} width="5.2" height="8.4" rx="0.6"></rect>
			<path class="td-gland" d={`M${f1(MX - 9.5)} ${f1(CAN_TOP)} v-2.2 h3 v2.2`}></path>
			<line class="td-rod2" data-prod x1="0" y1="0" x2="0" y2="0"></line>
			<line class="td-rod2" data-drod x1="0" y1="0" x2="0" y2="0"></line>
			<!-- the flywheel, its spokes and the crank -->
			<circle class="td-wheel" cx={MX} cy={f1(AY)} r={f1(R - 1)}></circle>
			<path class="td-spokes2" data-spokes2 d=""></path>
			<circle class="td-weight" data-weight r="1.6"></circle>
			<circle class="td-hub" cx={MX} cy={f1(AY)} r="1.6"></circle>
			</g>
			<g data-teen-near></g>
			<!-- the magnifier: a thin ring round the engine, a line to the circle, and the same drawing enlarged (a copy refreshed every frame) -->
			<clipPath id={`${uid}-lens`}><circle cx={LX} cy={LY} r={LR}></circle></clipPath>
			<circle class="td-ring" cx={MX} cy="152" r="26"></circle>
			<line class="td-ring" x1={f1(MX + 26 * 0.796)} y1={f1(152 - 26 * 0.606)} x2={f1(LX - LR * 0.796)} y2={f1(LY + LR * 0.606)}></line>
			<g clip-path={`url(#${uid}-lens)`}>
				<rect class="td-wall2" x={LX - LR} y={LY - LR} width={2 * LR} height={2 * LR}></rect>
				<rect class="td-table-edge" x={LX - LR} y={f1(LY + LK * (T2 - LC.y))} width={2 * LR} height="20"></rect>
				<g data-lens-content transform={`translate(${LX} ${LY}) scale(${LK}) translate(${-LC.x} ${-LC.y})`}></g>
			</g>
			<circle class="td-lens" cx={LX} cy={LY} r={LR}></circle>
		</svg>
		<div class="intro__foot">
			<p>
				Маленький двигатель на кружке с горячим чаем крутит маховик — и{' '}
				<More term="останавливается, когда чай остынет">
					Внутри двигателя — воздух. Кружка греет его снизу, комнатный воздух охлаждает сверху, и газ поочерёдно нагревается и охлаждается, расширяется и сжимается, толкая поршень. Работает двигатель, только пока низ теплее верха. Его придумал в 1816&nbsp;году шотландский священник Роберт Стирлинг. Об этом — раздел{' '}
					<a href="#тепловые-двигатели">«Тепловые двигатели»</a>.
				</More>{' '}(время ускорено).
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-tdintro] {
		--td-wall: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-gray-6));
		--td-wall2: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-6));
		--td-wood: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
		--td-bottle: hsl(150, 45%, 55%);
		--td-fog: hsl(0, 0%, 100%);
		--td-night: hsl(225, 45%, 22%);
		--td-lit: hsl(45, 90%, 70%);
	}
	:root[data-theme='light'] [data-tdintro] {
		--td-bottle: hsl(150, 50%, 40%);
		--td-fog: hsl(210, 20%, 70%);
		--td-night: hsl(225, 45%, 38%);
		--td-lit: hsl(45, 95%, 62%);
	}
	[data-tdintro] .intro__svg {
		overflow: hidden;
	}
	[data-tdintro] .td-wall {
		fill: var(--td-wall);
	}
	[data-tdintro] .td-wall2 {
		fill: var(--td-wall2);
	}
	[data-tdintro] .td-tiles {
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 40%, transparent);
		stroke-width: 0.6;
	}
	[data-tdintro] .td-floor {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-tdintro] .td-floorline {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	[data-tdintro] .td-win2 {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-bg));
	}
	[data-tdintro] .td-tree2 {
		fill: hsl(140, 35%, 34%);
		opacity: 0.75;
	}
	[data-tdintro] .td-frame {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	[data-tdintro] .td-sill {
		fill: var(--sl-color-gray-3);
	}
	[data-tdintro] .td-cab,
	[data-tdintro] .td-counter {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	[data-tdintro] .td-counter-top {
		fill: var(--sl-color-gray-3);
	}
	[data-tdintro] .td-plinth {
		fill: var(--sl-color-gray-4);
	}
	[data-tdintro] .td-cabline {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-linecap: round;
	}
	[data-tdintro] .td-kettle {
		fill: color-mix(in oklab, var(--ig-vx) 20%, var(--sl-color-gray-3));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tdintro] .td-kettle-h {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	[data-tdintro] .td-shelf {
		fill: var(--td-wood);
	}
	[data-tdintro] .td-jar {
		fill: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-4));
