---
/**
 * Two short looping opening scenes of «Основы термодинамики. Тепловые двигатели». No terms of the chapter in the
 * pictures or the captions.
 *
 * Pump: a boy (165 см, the person of people.ts) pumps up a bicycle tire with a floor pump, 0,95 px per centimeter.
 *   A stroke of the handle is 40 см, one stroke a second. The time is sped up (the caption says so): the ten strokes
 *   shown stand for about fifty, during which the tire fills (its flat patch on the ground shrinks from 18 to 4 px)
 *   and the lower part of the barrel warms: drawn as a glow that grows, with a shimmer of warm air. The air is
 *   squeezed fast and has no time to give its heat away, so it heats up, and the barrel warms from it (a little also
 *   from the friction of the piston).
 *   The bicycle stands whole inside the picture (wheelbase 82 px ≈ 86 см, wheels 64 px across); its dark tires get a
 *   light edge so they show on the dark evening sky.
 * Bottle: a girl (155 см) stands at a kitchen table 80 см high and opens a cold bottle of sparkling water, 1,1 px per
 *   centimeter, the same kind of whole figure as in the other scenes (the bottle, 30 см, is drawn at 2 px per см and
 *   scaled by 0,55), real time. She turns the cap; when the gas under it (about three atmospheres) bursts out, it expands fast and
 *   cools by tens of degrees (an ideal adiabatic expansion of carbon dioxide from 3 to 1 атм would cool it from 5 °C
 *   by about 60 K), the water vapour in it condenses, and a small cloud of fog rises from the neck and vanishes within
 *   about 1,5 с. Then bubbles rise in the water.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const G = 222; // the ground of the pump scene
const TT = 140; // the table top of the bottle scene: 80 см above the floor at 1,1 px per см
const FL = 228; // the floor of the bottle scene
const K = 0.55; // the bottle is drawn at 2 px per см and scaled to 1,1 px per см
---

<PeopleStyles />
<IntroFrame data-tdintro>
	<div class="intro__card" data-scene="pump">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик во дворе накачивает ручным насосом колесо велосипеда. Шина становится тугой, а низ насоса нагревается">
			<defs>
				<linearGradient id="td-heat" x1="0" y1="1" x2="0" y2="0">
					<stop offset="0" class="td-heat-a"></stop>
					<stop offset="1" class="td-heat-b"></stop>
				</linearGradient>
			</defs>
			<rect class="td-sky" x="0" y="0" width="360" height="240"></rect>
			<!-- a house wall with a garage door and a window -->
			<rect class="td-house" x="0" y="40" width="210" height={G - 40}></rect>
			<path class="td-roof" d="M-6 44 L104 6 L216 44 Z"></path>
			<rect class="td-garage" x="22" y="118" width="74" height={G - 118}></rect>
			<path class="td-garage-lines" d={Array.from({ length: 6 }, (_, k) => `M22 ${130 + k * 16} H96`).join(' ')}></path>
			<rect class="td-win" x="128" y="72" width="44" height="40" rx="2"></rect>
			<path class="td-frame" d="M128 72 H172 V112 H128 Z M150 72 V112 M128 92 H172"></path>
			<circle class="td-bush" cx="236" cy={G - 12} r="18"></circle>
			<circle class="td-bush" cx="254" cy={G - 20} r="16"></circle>
			<rect class="td-ground" x="0" y={G} width="360" height={240 - G}></rect>
			<!-- the bicycle, moved 30 px left so that the whole front wheel is in the picture -->
			<g data-bike transform="translate(-30 0)">
				<circle class="td-tire-edge" cx="350" cy={G - 32} r="32"></circle>
				<circle class="td-tire-far" cx="350" cy={G - 32} r="32"></circle>
				<path class="td-bikeframe" d={`M268 ${G - 32} L298 ${G - 70} L340 ${G - 70} L314 ${G - 32} Z M298 ${G - 70} L292 ${G - 86} M282 ${G - 88} H302 M340 ${G - 70} L344 ${G - 92} M336 ${G - 94} L352 ${G - 90} M340 ${G - 70} L350 ${G - 32}`}></path>
				<circle class="td-chainring" cx="314" cy={G - 32} r="8"></circle>
				<path class="td-tire-edge" data-tire-edge d=""></path>
				<path class="td-tire" data-tire d=""></path>
				<circle class="td-rim" cx="268" cy={G - 32} r="26" data-rim></circle>
				<path class="td-spokes" data-spokes d=""></path>
			</g>
			<!-- the pump -->
			<path class="td-hose" data-hose d=""></path>
			<rect class="td-plate" x="146" y={G - 4} width="34" height="4" rx="1"></rect>
			<rect class="td-barrel" x="158" y={G - 60} width="10" height="56" rx="2"></rect>
			<rect x="158" y={G - 34} width="10" height="30" rx="2" fill="url(#td-heat)" data-heat opacity="0"></rect>
			<path class="td-shimmer" data-shimmer d={`M154 ${G - 30} q-3 -6 0 -12 q3 -6 0 -12 M172 ${G - 26} q-3 -6 0 -12 q3 -6 0 -12`} opacity="0"></path>
			<line class="td-rod" data-rod x1="163" y1={G - 60} x2="163" y2={G - 100}></line>
			<rect class="td-handle" data-handle x="151" y={G - 102} width="24" height="5" rx="2.5"></rect>
			<g data-boy></g>
		</svg>
		<div class="intro__foot">
			<p>
				Пока накачиваешь шину ручным насосом (время ускорено), низ насоса{' '}
				<More term="становится тёплым">
					Воздух в насосе сжимают быстро: поршень совершает над ним работу, и внутренняя энергия воздуха растёт — он нагревается, а от него нагреваются стенки насоса. Немного тепла даёт и трение поршня. Об этом — раздел{' '}
					<a href="#первый-закон-термодинамики">«Первый закон термодинамики»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="bottle">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка у кухонного стола открывает холодную бутылку газировки. Над горлышком появляется облачко тумана и тут же исчезает, в воде поднимаются пузырьки">
			<rect class="td-wall" x="0" y="0" width="360" height={FL}></rect>
			<rect class="td-floor" x="0" y={FL} width="360" height={240 - FL}></rect>
			<rect class="td-win2" x="232" y="20" width="96" height="112" rx="3"></rect>
			<path class="td-frame" d="M232 20 H328 V132 H232 Z M280 20 V132 M232 70 H328"></path>
			<path class="td-tree2" d="M250 132 Q244 96 262 84 Q270 60 292 72 Q318 70 314 100 Q326 118 312 132 Z"></path>
			<path class="td-curtain" d="M222 14 Q232 70 224 140 L238 140 Q242 70 234 14 Z M338 14 Q328 70 336 140 L322 140 Q318 70 326 14 Z"></path>
			<rect class="td-rodw" x="218" y="12" width="124" height="3" rx="1.5"></rect>
			<rect class="td-shelf" x="20" y="54" width="90" height="5"></rect>
			<rect class="td-jar" x="28" y="34" width="16" height="20" rx="3"></rect>
			<rect class="td-jar td-jar--b" x="52" y="30" width="20" height="24" rx="3"></rect>
			<rect class="td-jar" x="80" y="38" width="14" height="16" rx="3"></rect>
			<g data-girl></g>
			<!-- a kitchen table, 80 см high and 120 см long, in front of her -->
			<rect class="td-table" x="180" y={TT + 4} width="6" height={FL - TT - 4}></rect>
			<rect class="td-table" x="300" y={TT + 4} width="6" height={FL - TT - 4}></rect>
			<rect class="td-table-edge" x="174" y={TT} width="138" height="5" rx="1"></rect>
			<!-- a glass, 8 см across and 11 см high -->
			<path class="td-glass" d={`M262 ${TT} L261 ${TT - 12} L270 ${TT - 12} L269 ${TT} Z`}></path>
			<!-- the bottle: 30 см high, its bottom at (210, TT) -->
			<g transform={`translate(210 ${TT}) scale(${K})`}>
				<path class="td-bottle" d="M-14 0 L-14 -36 Q-14 -44 -6 -48 L-4 -54 L-4 -58 L4 -58 L4 -54 L6 -48 Q14 -44 14 -36 L14 0 Z"></path>
				<path class="td-water" d="M-12.5 -1.5 L-12.5 -38 Q-12 -42 -6 -45 L6 -45 Q12 -42 12.5 -38 L12.5 -1.5 Z"></path>
				<g data-bubbles></g>
				<rect class="td-label" x="-14" y="-28" width="28" height="12"></rect>
				<path class="td-shine" d="M-9 -36 V-6"></path>
				<path class="td-dew" d="M-11 -20 v1 M-7 -10 v1 M8 -24 v1 M11 -8 v1 M-2 -4 v1 M5 -14 v1"></path>
			</g>
			<g data-cap>
				<rect class="td-cap" x="-5" y="-8" width="10" height="8" rx="1.2"></rect>
				<path class="td-cap-ribs" data-ribs d=""></path>
			</g>
			<g data-fog></g>
		</svg>
		<div class="intro__foot">
			<p>
				Когда открывают холодную бутылку газировки, над горлышком на миг появляется{' '}
				<More term="облачко тумана">
					Газ под крышкой сжат примерно втрое сильнее, чем воздух вокруг. Вырываясь, он быстро расширяется и совершает работу — его внутренняя энергия уменьшается, и он охлаждается на десятки градусов. Водяной пар в нём превращается в капельки тумана. Об этом — раздел{' '}
					<a href="#первый-закон-термодинамики">«Первый закон термодинамики»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-tdintro] {
		--td-sky: color-mix(in oklab, var(--ig-vx) 20%, var(--sl-color-bg));
		--td-house: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
		--td-ground: hsl(110, 25%, 30%);
		--td-bush: hsl(140, 35%, 32%);
		--td-tire: hsl(222, 15%, 18%);
		--td-wall: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-gray-6));
		--td-wood: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
		--td-bottle: hsl(150, 45%, 55%);
		--td-fog: hsl(0, 0%, 100%);
	}
	:root[data-theme='light'] [data-tdintro] {
		--td-ground: hsl(100, 35%, 62%);
		--td-bush: hsl(140, 35%, 42%);
		--td-tire: hsl(222, 15%, 22%);
		--td-bottle: hsl(150, 50%, 40%);
		--td-fog: hsl(210, 20%, 70%);
	}
	[data-tdintro] .td-sky {
		fill: var(--td-sky);
	}
	[data-tdintro] .td-house {
		fill: var(--td-house);
	}
	[data-tdintro] .td-roof {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
	}
	[data-tdintro] .td-garage {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-tdintro] .td-garage-lines {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-tdintro] .td-win,
	[data-tdintro] .td-win2 {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-bg));
	}
	[data-tdintro] .td-frame {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	[data-tdintro] .td-bush,
	[data-tdintro] .td-tree2 {
		fill: var(--td-bush);
	}
	[data-tdintro] .td-ground {
		fill: var(--td-ground);
	}
	[data-tdintro] .td-tire,
	[data-tdintro] .td-tire-far {
		fill: none;
		stroke: var(--td-tire);
		stroke-width: 5;
	}
	[data-tdintro] .td-tire-far {
		stroke-width: 5;
	}
	[data-tdintro] .td-tire-edge {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 7.4;
	}
	[data-tdintro] .td-rim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	[data-tdintro] .td-spokes {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.5;
	}
	[data-tdintro] .td-bikeframe {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 3.2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	[data-tdintro] .td-chainring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	[data-tdintro] .td-hose {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
	}
	[data-tdintro] .td-plate {
		fill: var(--sl-color-gray-2);
	}
	[data-tdintro] .td-barrel {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-gray-3));
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
	[data-tdintro] .td-heat-a {
		stop-color: var(--ig-vy);
		stop-opacity: 0.95;
	}
	[data-tdintro] .td-heat-b {
		stop-color: var(--ig-vy);
		stop-opacity: 0;
	}
	[data-tdintro] .td-shimmer {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 1;
		stroke-linecap: round;
	}
	[data-tdintro] .td-rod {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	[data-tdintro] .td-handle {
		fill: hsl(222, 15%, 22%);
	}
	[data-tdintro] .td-wall {
		fill: var(--td-wall);
	}
	[data-tdintro] .td-tree2 {
		opacity: 0.8;
	}
	[data-tdintro] .td-curtain {
		fill: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-5));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tdintro] .td-rodw {
		fill: var(--sl-color-gray-3);
	}
	[data-tdintro] .td-shelf {
		fill: var(--td-wood);
	}
	[data-tdintro] .td-jar {
		fill: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tdintro] .td-jar--b {
		fill: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-4));
	}
	[data-tdintro] .td-table {
		fill: var(--td-wood);
	}
	[data-tdintro] .td-floor {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	/* the bottle and its cap are scaled down: keep their lines as thick as elsewhere */
	[data-tdintro] :is(.td-bottle, .td-bubble, .td-shine, .td-dew, .td-cap, .td-cap-ribs) {
		vector-effect: non-scaling-stroke;
	}
	[data-tdintro] .td-table-edge {
		fill: color-mix(in oklab, var(--ig-v) 34%, var(--sl-color-gray-5));
	}
	[data-tdintro] .td-glass {
		fill: color-mix(in oklab, var(--ig-vx) 18%, transparent);
		stroke: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-white));
		stroke-width: 1;
	}
	[data-tdintro] .intro__svg {
		overflow: hidden;
	}
	[data-tdintro] .td-bottle {
		fill: color-mix(in oklab, var(--td-bottle) 40%, var(--td-wall));
		stroke: var(--td-bottle);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	[data-tdintro] .td-water {
		fill: color-mix(in oklab, var(--td-bottle) 30%, transparent);
	}
	[data-tdintro] .td-bubble {
		fill: none;
		stroke: hsl(0, 0%, 100%);
		stroke-width: 0.6;
		opacity: 0.85;
	}
	[data-tdintro] .td-label {
		fill: var(--ig-vy);
	}
	[data-tdintro] .td-shine {
		stroke: hsl(0, 0%, 100%);
		stroke-width: 1.5;
		opacity: 0.5;
	}
	[data-tdintro] .td-dew {
		stroke: hsl(0, 0%, 100%);
		stroke-width: 1.4;
		stroke-linecap: round;
		opacity: 0.7;
	}
	[data-tdintro] .td-cap {
		fill: var(--ig-vy);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tdintro] .td-cap-ribs {
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-tdintro] .td-fog {
		fill: var(--td-fog);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { human, type HumanPose } from '../mehanicheskaya-rabota/people';

	const f = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-tdintro]')) {
		// ---------------- the pump ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="pump"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 222;
			const S = 0.95;
			const H = 165;
			const u = S * H;
			const A = 7 * S; // the ankle above the ground
			const boy = human($<SVGGElement>('[data-boy]'), { s: S, H, shirt: 'hm-green', hair: 'short' });
			const rod = $<SVGLineElement>('[data-rod]');
			const handle = $<SVGRectElement>('[data-handle]');
			const heat = $<SVGRectElement>('[data-heat]');
			const shimmer = $<SVGPathElement>('[data-shimmer]');
			const tire = $<SVGPathElement>('[data-tire]');
			const tireEdge = $<SVGPathElement>('[data-tire-edge]');
			const rim = $<SVGCircleElement>('[data-rim]');
			const spokes = $<SVGPathElement>('[data-spokes]');
			const hose = $<SVGPathElement>('[data-hose]');
			const WX = 268; // the rear wheel's axle
			const RUN = 10;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the handle: top 40 см above its lowest point, one stroke a second (down fast, up slower)
				const ph = t % 1;
				const down = ph < 0.45 ? 0.5 - 0.5 * Math.cos((ph / 0.45) * Math.PI) : 0.5 + 0.5 * Math.cos(((ph - 0.45) / 0.55) * Math.PI);
				const hy = G - 102 + (t > 0 && t < RUN ? down : 0) * 38;
				rod.setAttribute('y2', f(hy + 2));
				handle.setAttribute('y', f(hy));
				// the boy: hands on the handle, he bends at the hips and knees as it goes down
				const hipX = 128 - 6 * down;
				const pose: HumanPose = {
					hip: { x: hipX, y: G - A - 0.465 * u + 10 * down },
					lean: 0.35 + 0.45 * down,
					ankles: [
						{ x: 150, y: G - 4 - A },
						{ x: 112, y: G - A },
					],
					feet: [0, 0],
					hands: [
						{ x: 157, y: hy + 2 },
						{ x: 169, y: hy + 2 },
					],
					head: -0.25,
				};
				boy(pose);
				// the tire fills: the effective radius grows from 28 to 32 px, the flat patch shrinks
				const k = Math.min(1, t / (RUN - 0.5));
				const r = 28 + 4 * k;
				const cy = G - r;
				const half = Math.sqrt(Math.max(0, 32 * 32 - r * r)) + 4 * (1 - k) + 2;
				tire.setAttribute('d', `M${f(WX - half)} ${G - 2.5} A32 32 0 1 1 ${f(WX + half)} ${G - 2.5} Z`);
				tireEdge.setAttribute('d', tire.getAttribute('d')!);
				rim.setAttribute('cy', f(G - 32 + (32 - r) * 0.3));
				let d = '';
				for (let i = 0; i < 12; i++) {
					const a = (i * Math.PI) / 6;
					d += `M${WX} ${f(G - 32)} L${f(WX + 25 * Math.cos(a))} ${f(G - 32 + 25 * Math.sin(a))} `;
				}
				spokes.setAttribute('d', d);
				void cy;
				// the hose ends at the valve of the rear wheel (the bicycle group is shifted by −30 px)
				hose.setAttribute('d', `M168 ${G - 6} Q192 ${G + 2} 210 ${G - 8} Q224 ${G - 14} ${WX - 38} ${G - 10}`);
				heat.setAttribute('opacity', f(0.15 + 0.8 * k));
				shimmer.setAttribute('opacity', f(Math.max(0, k - 0.35) * 0.9));
				shimmer.setAttribute('transform', `translate(0 ${f(-((t * 8) % 6))})`);
			});
		}

		// ---------------- the bottle ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bottle"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const TT = 140;
			const FL = 228;
			const K = 0.55; // the bottle's drawing scale (2 px per см → 1,1 px per см)
			const S = 1.1;
			const H = 155;
			const u = S * H;
			const A = 7 * S; // the ankle above the floor
			const girl = human($<SVGGElement>('[data-girl]'), { s: S, H, shirt: 'hm-red', hair: 'pony' });
			const cap = $<SVGGElement>('[data-cap]');
			const ribs = $<SVGPathElement>('[data-ribs]');
			const fogG = $<SVGGElement>('[data-fog]');
			const bubG = $<SVGGElement>('[data-bubbles]');
			const NX = 210; // the bottle's axis
			const NY = TT - 58 * K; // the top of its neck
			const puffs = Array.from({ length: 9 }, (_, i) => {
				const e = el('ellipse', { class: 'td-fog' });
				fogG.append(e);
				return { e, dx: (i - 4) * 2.2 * K, vy: (16 + (i % 3) * 6) * K, r: (5 + (i % 4) * 1.5) * K };
			});
			const bubbles = Array.from({ length: 16 }, (_, i) => {
				const c = el('circle', { class: 'td-bubble', r: f(1.3 + (i % 3) * 0.5) }); // in the bottle's own (unscaled) units
				bubG.append(c);
				return { c, x: -9 + ((i * 7.3) % 18), t0: (i * 0.37) % 1.6, v: 18 + (i % 5) * 4 };
			});
			const OPEN = 2.4; // s: the gas bursts out
			const RUN = 6;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the cap turns between 0,6 and 2,4 s (ribs slide), then lifts and tilts in her fingers
				const turn = Math.min(1, Math.max(0, (t - 0.6) / 1.8));
				const off = Math.max(0, Math.min(1, (t - OPEN) / 0.4));
				const cx = NX + 9 * K * off;
				const cy = NY - 8 * K * off;
				cap.setAttribute('transform', `translate(${f(cx)} ${f(cy)}) rotate(${f(20 * off)}) scale(${K})`);
				let r = '';
				for (let k = 0; k < 4; k++) {
					const xx = -4 + ((k * 2.6 + turn * 14) % 10.4);
					if (xx < 4.5) r += `M${f(xx)} -7 V-1 `;
				}
				ribs.setAttribute('d', r);
				// the girl stands at the table: the near hand round the bottle, the far one on the cap
				const pose: HumanPose = {
					hip: { x: 156, y: FL - 0.52 * u + 1 },
					lean: 0.15,
					ankles: [
						{ x: 166, y: FL - A },
						{ x: 146, y: FL - A },
					],
					feet: [0, 0],
					hands: [
						{ x: NX - 5, y: TT - 14 },
						{ x: cx - 4, y: cy - 2 },
					],
					head: 0.25,
				};
				girl(pose);
				// the fog: appears at the neck, rises 9–15 px/s (8–14 см/с), grows and fades within 1,5 s
				for (const p of puffs) {
					const s = t - OPEN - 0.05;
					const on = s > 0 && s < 1.5;
					p.e.style.display = on ? '' : 'none';
					if (!on) continue;
					const g = Math.sqrt(s / 1.5);
					p.e.setAttribute('cx', f(NX + p.dx * (1 + 4 * s)));
					p.e.setAttribute('cy', f(NY - 2 - p.vy * s));
					p.e.setAttribute('rx', f(p.r * (0.6 + 1.6 * g)));
					p.e.setAttribute('ry', f(p.r * (0.5 + 1.1 * g)));
					p.e.setAttribute('opacity', f(0.8 * (1 - s / 1.5)));
				}
				// bubbles rise after the opening, from the bottom to the water surface (in the bottle's units)
				for (const b of bubbles) {
					const s = t - OPEN - b.t0;
					const on = s > 0;
					b.c.style.display = on ? '' : 'none';
					if (!on) continue;
					const y = -3 - ((b.v * s) % 40);
					b.c.setAttribute('cx', f(b.x + Math.sin(s * 9 + b.x) * 0.8));
					b.c.setAttribute('cy', f(y));
				}
			});
			void u;
		}
	}
</script>
