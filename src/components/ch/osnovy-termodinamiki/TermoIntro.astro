</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { figure, ease, lerp, lerpPt, ROLL, SKELETON, ANKLE_CM, handShape, blendShape, handPoint, contactLocal, type Pt, type HandTarget, type HandPose, type HandShape, type Side } from '@components/people';

	const f = (v: number) => v.toFixed(1);
	const smooth = (a: number, b: number, t: number) => ease((t - a) / (b - a));
	/**
	 * Where the contact point of pose `to` lies against that of pose `from`, for a hand of the shape `sh` placed at
	 * `dir` and `roll`: a reach that starts in pose `from` is run in pose `to` from a target shifted by this much, so the
	 * hand does not jump when its pose changes (the shape is blended over the reach).
	 */
	const delta = (side: Side, Lh: number, dir: number, roll: number, sh: HandShape, from: HandPose, to: HandPose, dLh: number): Pt => {
		const fr = { wrist: { x: 0, y: 0 }, dir, roll };
		const a = handPoint(side, fr, Lh, contactLocal(to, sh, dLh));
		const b = handPoint(side, fr, Lh, contactLocal(from, sh, dLh));
		return { x: a.x - b.x, y: a.y - b.y };
	};
	const plus = (a: Pt, b: Pt): Pt => ({ x: a.x + b.x, y: a.y + b.y });
	for (const root of document.querySelectorAll<HTMLElement>('[data-tdintro]')) {
		// ---------------- the bottle ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bottle"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1.4;
			const FL = 232;
			const TT = FL - 75 * S;
			const NX = 172;
			const NY = TT - 33 * S; // the top of the neck
			const H = 156;
			const sk = SKELETON.teen;
			const u = S * H;
			const gEl = $<SVGGElement>('[data-girl]');
			const girl = figure(gEl, { s: S, H, age: 'teen', clothes: 'indoor', shirt: 'hm-red', hair: 'pony', name: 'girl' });
			// the far arm and leg go behind the table and the bottle
			const farG = gEl.querySelector('.hm-far');
			if (farG) $<SVGGElement>('[data-girl-far]').append(farG);
			girl.backLayer(0, $<SVGGElement>('[data-gback]'));
			const cap = $<SVGGElement>('[data-cap]');
			const ribs = $<SVGPathElement>('[data-ribs]');
			const fogG = $<SVGGElement>('[data-fog]');
			const bubG = $<SVGGElement>('[data-bubbles]');
			const puffs = Array.from({ length: 9 }, (_, i) => {
				const e = el('ellipse', { class: 'td-fog' });
				fogG.append(e);
				return { e, dx: (i - 4) * 1.5, vy: (8 + (i % 3) * 3) * S, r: 3.2 + (i % 4) * 0.9 };
			});
			const bubbles = Array.from({ length: 16 }, (_, i) => {
				const c = el('circle', { class: 'td-bubble', r: (0.35 + (i % 3) * 0.15).toFixed(2) }); // см, in the bottle's units
				bubG.append(c);
				return { c, x: -3.4 + ((i * 2.3) % 6.8), t0: (i * 0.37) % 1.6, v: 6 + (i % 5) * 1.5 };
			});
			const ankleY = FL - ANKLE_CM.trainer * S;
			const leg = (sk.thigh + sk.shin) * u;
			const HIP: Pt = { x: 122, y: ankleY - leg * 0.995 };
			const OPEN = 2.5; // s: the gas bursts out
			const RUN = 6;
			const capRest: Pt = { x: NX - 13, y: TT }; // where the cap is put down
			const handRest: Pt = { x: 152, y: TT }; // the far hand lies on the table
			const LhG = sk.hand * u;
			const relaxedSh = handShape('relaxed');
			const pinchSh = handShape('pinch');
			const dPinch = delta('L', LhG, 0.05, ROLL.palmCw, relaxedSh, 'relaxed', 'pinch', 0.17);
			const restFar: HandTarget = { at: handRest, pose: 'relaxed', dir: 0.05, roll: ROLL.palmCw };
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the cap: on the neck, turned between 0,7 and 2,5 s, lifted at the burst, carried to the table 3,6–4,4 s
				const turn = smooth(0.7, OPEN, t);
				const lift = smooth(OPEN, OPEN + 0.35, t);
				const carry = smooth(3.6, 4.4, t);
				const onNeck: Pt = { x: NX, y: NY };
				const lifted: Pt = { x: NX + 2.5, y: NY - 7 };
				const capAt = carry > 0 ? lerpPt(lifted, capRest, carry) : lerpPt(onNeck, lifted, lift);
				cap.setAttribute('transform', `translate(${f(capAt.x)} ${f(capAt.y)}) scale(${S})`);
				let r = '';
				for (let k = 0; k < 4; k++) {
					const xx = -1.4 + ((k * 0.8 + turn * 4.4) % 3.2);
					if (xx < 1.5) r += `M${xx.toFixed(2)} -1.8 V-0.2 `;
				}
				ribs.setAttribute('d', r);
				// the far hand: from the table to the cap (0–0,7 s), turns it, carries it, lets go and goes back (4,5–5,3 s)
				const capGrip: Pt = { x: capAt.x, y: capAt.y - 1.4 };
				const reach = smooth(0.05, 0.7, t);
				const back = smooth(4.5, 5.3, t);
				const twist = t > 0.7 && t < OPEN ? 0.35 * Math.sin(((t - 0.7) / (OPEN - 0.7)) * 6 * Math.PI) : 0;
				let far: HandTarget = restFar;
				const from = plus(handRest, dPinch);
				if (t < 0.7 && reach > 0) far = { at: lerpPt(from, capGrip, reach), pose: 'pinch', shape: blendShape(relaxedSh, pinchSh, reach), dir: lerp(0.05, 0.55, reach), roll: lerp(ROLL.palmCw, -0.5, reach) };
				else if (t >= 0.7 && t < 4.5) far = { at: capGrip, pose: 'pinch', dir: 0.55, roll: -0.5 + twist, contact: 'cap' };
				else if (t >= 4.5 && back < 1) far = { at: lerpPt(capGrip, from, back), pose: 'pinch', shape: blendShape(pinchSh, relaxedSh, back), dir: lerp(0.55, 0.05, back), roll: lerp(-0.5, ROLL.palmCw, back) };
				girl.pose({
					hip: HIP,
					lean: 0.14,
					head: 0.32,
					ankles: [
						{ x: HIP.x + 6, y: ankleY },
						{ x: HIP.x - 10, y: ankleY },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [{ at: { x: NX, y: TT - 13 * S }, pose: 'grip', d: 9, dir: 0, roll: ROLL.backViewer, contact: 'bottle' }, far],
				});
				// the fog: appears at the neck, rises 8–14 см/с, grows and fades within 1,5 s
				for (const p of puffs) {
					const s = t - OPEN - 0.05;
					const on = s > 0 && s < 1.5;
					p.e.style.display = on ? '' : 'none';
					if (!on) continue;
					const g = Math.sqrt(s / 1.5);
					p.e.setAttribute('cx', f(NX + p.dx * (1 + 4 * s)));
					p.e.setAttribute('cy', f(NY - 2 - p.vy * s));
					p.e.setAttribute('rx', f(p.r * (0.6 + 1.6 * g)));
					p.e.setAttribute('ry', f(p.r * (0.5 + 1.1 * g)));
					p.e.setAttribute('opacity', f(0.8 * (1 - s / 1.5)));
				}
				// bubbles rise after the opening, from the bottom to the water surface (in centimeters of the bottle)
				for (const b of bubbles) {
					const s = t - OPEN - b.t0;
					const on = s > 0;
					b.c.style.display = on ? '' : 'none';
					if (!on) continue;
					const y = -1 - ((b.v * s) % 23.5);
					b.c.setAttribute('cx', (b.x + Math.sin(s * 9 + b.x) * 0.3).toFixed(2));
					b.c.setAttribute('cy', y.toFixed(2));
				}
			});
		}

		// ---------------- the Stirling engine on a mug ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="stirling"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 2.8;
			const T2 = 200;
			const MX = 214;
			const MUG_TOP = T2 - 10.5 * S;
			const CAN_TOP = MUG_TOP - 2.4 * S;
			const AY = CAN_TOP - 9 * S;
			const R = 4 * S;
			const H = 165;
			const tg = $<SVGGElement>('[data-teen]');
			const teen = figure(tg, { s: S, H, age: 'teen', clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'teen' });
			// the near arm is drawn in front of the table and the engine: its sleeve, outline and hand go to their own layer
			const nearArmParts = [...tg.querySelectorAll(':scope > g > path.hm-outline, :scope > g > path.hm-limb, :scope > g > g.pk-hand')].slice(-3);
			const nearLayer = $<SVGGElement>('[data-teen-near]');
			for (const p of nearArmParts) nearLayer.append(p);
			const mBack = $<SVGGElement>('[data-mback]');
			let holdsMug = false;
			const disp = $<SVGRectElement>('[data-disp]');
			const prod = $<SVGLineElement>('[data-prod]');
			const drod = $<SVGLineElement>('[data-drod]');
			const spokes = $<SVGPathElement>('[data-spokes2]');
			const weight = $<SVGCircleElement>('[data-weight]');
			const hotplate = $<SVGRectElement>('[data-hotplate]');
			const hh = $<SVGLineElement>('[data-hh]');
			const hm = $<SVGLineElement>('[data-hm]');
			const wisps = [...card.querySelectorAll<SVGPathElement>('.td-wisp')];
			// the magnifier shows a copy of the engine group, refreshed after every frame (the hand behind the mug is left out)
			const engG = $<SVGGElement>('[data-eng]');
			const lensG = $<SVGGElement>('[data-lens-content]');
			const syncLens = () => {
				const c = engG.cloneNode(true) as SVGGElement;
				c.querySelector('[data-mback]')?.remove();
				c.removeAttribute('data-eng');
				for (const e of c.querySelectorAll('*')) for (const a of [...e.attributes]) if (a.name.startsWith('data-')) e.removeAttribute(a.name);
				lensG.replaceChildren(c);
			};
			// the hip joint is below the picture (the teen sits on a chair 46 см high)
			const HIP: Pt = { x: 62, y: T2 + 25 * S };
			const ankleY = T2 + 75 * S - ANKLE_CM.trainer * S;
			const rest: [HandTarget, HandTarget] = [
				{ at: { x: 152, y: T2 }, pose: 'flat', dir: 0.02, roll: ROLL.palmCw, contact: 'table' },
				{ at: { x: 134, y: T2 }, pose: 'flat', dir: 0.02, roll: ROLL.palmCw, contact: 'table' },
			];
			// time: real until 1,2 s, then 95 minutes in 8,8 s (the clock), then real again
			const T_FAST = 1.2;
			const T_END = 10.0;
			const minutes = (t: number) => Math.min(95, Math.max(0, ((t - T_FAST) / (T_END - T_FAST)) * 95));
			const dT = (m: number) => 63 * Math.exp(-m / 40); // К, the tea above the room
			const wEq = (m: number) => (2 * Math.max(0, dT(m) - 6)) / 57; // об/с
			const T_FLICK = 0.95;
			const omega = (t: number) => {
				if (t < T_FLICK) return 0;
				const kick = 2.2 * smooth(T_FLICK, T_FLICK + 0.15, t);
				return lerp(kick, wEq(minutes(t)), smooth(T_FAST, T_FAST + 0.6, t));
			};
			let theta = 0;
			let last = 0;
			const RUN = 12;
			// the index finger slides along the rim from below to above its leftmost point
			const rim = (a: number): Pt => ({ x: MX + (R - 1.2) * Math.cos(a), y: AY + (R - 1.2) * Math.sin(a) });
			const A0 = (160 * Math.PI) / 180;
			const A1 = (205 * Math.PI) / 180;
			const LhT = SKELETON.teen.hand * S * H;
			const flatSh = handShape('flat');
			const pointSh = handShape('point');
			const dMug = (9.5 * S) / LhT;
			const gripSh = handShape('grip', dMug);
			const R0 = rest[0].at!;
			const fromPoint = plus(R0, delta('R', LhT, 0.02, ROLL.palmCw, flatSh, 'flat', 'point', 0.17));
			const fromGrip = plus(R0, delta('R', LhT, 0.02, ROLL.palmCw, flatSh, 'flat', 'grip', dMug));
			scene(card, RUN, (x) => {
				const t = x * RUN;
				if (t < last) {
					theta = 0;
					last = 0;
				}
				// integrate the angle in small steps, so a skipped frame does not change the result
				const n = Math.max(1, Math.ceil((t - last) / 0.01));
				const h = (t - last) / n;
				for (let i = 0; i < n && t > last; i++) theta += 2 * Math.PI * omega(last + (i + 0.5) * h) * h;
				last = t;
				const m = minutes(t);
				// the flywheel: four spokes, a small weight on the rim; the cranks a quarter turn apart
				let d = '';
				for (let k = 0; k < 4; k++) {
					const a = theta + (k * Math.PI) / 2;
					d += `M${f(MX + 1.6 * Math.cos(a))} ${f(AY + 1.6 * Math.sin(a))} L${f(MX + (R - 2) * Math.cos(a))} ${f(AY + (R - 2) * Math.sin(a))} `;
				}
				spokes.setAttribute('d', d);
				weight.setAttribute('cx', f(MX + (R - 3.4) * Math.cos(theta + Math.PI / 4)));
				weight.setAttribute('cy', f(AY + (R - 3.4) * Math.sin(theta + Math.PI / 4)));
				const pin = { x: MX + 2.6 * Math.cos(theta), y: AY + 2.6 * Math.sin(theta) };
				prod.setAttribute('x1', f(MX));
				prod.setAttribute('y1', f(CAN_TOP - 8.4 + 2.6 * Math.sin(theta)));
				prod.setAttribute('x2', f(pin.x));
				prod.setAttribute('y2', f(pin.y));
				const pin2 = { x: MX + 3.4 * Math.cos(theta + Math.PI / 2), y: AY + 3.4 * Math.sin(theta + Math.PI / 2) };
				drod.setAttribute('x1', f(MX - 8));
				drod.setAttribute('y1', f(CAN_TOP - 2.2));
				drod.setAttribute('x2', f(pin2.x));
				drod.setAttribute('y2', f(pin2.y));
				disp.setAttribute('y', f(CAN_TOP + 2.9 + 1.3 * (1 + Math.sin(theta + Math.PI / 2))));
				// the warm bottom plate cools with the tea
				hotplate.style.opacity = f(0.35 + 0.65 * (dT(m) / 63));
				// the clock: from 19:00
				const mm = (m / 60) * 2 * Math.PI;
				const hA = ((7 + m / 60) / 12) * 2 * Math.PI;
				hm.setAttribute('x2', f(340 + 12 * Math.sin(mm)));
				hm.setAttribute('y2', f(24 - 12 * Math.cos(mm)));
				hh.setAttribute('x2', f(340 + 8 * Math.sin(hA)));
				hh.setAttribute('y2', f(24 - 8 * Math.cos(hA)));
				// vapour at the rim while the tea is hot
				const steam = Math.max(0, Math.min(1, (dT(m) - 25) / 38));
				wisps.forEach((w, i) => {
					// three wisps leave the gap under the plate: left, right and (fainter) in front of the can
					const side = [-1, 1, 0.3][i];
					const x0 = MX + side * 14;
					const ph = t * 1.3 + i * 1.7;
					const sway = 2.5 * Math.sin(ph);
					const out = side < 0 ? -3 : 3;
					w.setAttribute('d', `M${f(x0)} ${f(MUG_TOP)} q${f(out + sway)} -7 ${f(sway * 0.6)} -14 q${f(-sway)} -6 ${f(out * 0.7 + sway * 0.5)} -12`);
					w.style.opacity = f((i === 2 ? 0.2 : 0.35) * steam * (0.75 + 0.25 * Math.sin(ph * 1.6)));
				});
				// the teen: the near hand flicks the wheel, later holds the mug; the far hand rests on the table
				let near: HandTarget = rest[0];
				if (t >= 0.25 && t < 1.9) {
					const go = smooth(0.25, 0.85, t);
					const flick = smooth(0.85, 1.05, t);
					const ret = smooth(1.15, 1.9, t);
					const tip = rim(lerp(A0, A1, flick));
					const at = ret > 0 ? lerpPt(tip, fromPoint, ret) : go < 1 ? lerpPt(fromPoint, rim(A0), go) : tip;
					const k = go * (1 - ret);
					near = { at, pose: 'point', shape: blendShape(flatSh, pointSh, k), dir: lerp(0.02, -0.1, k), roll: lerp(ROLL.palmCw, -0.5, k), contact: go >= 1 && ret <= 0 ? 'flywheel-rim' : undefined };
				} else if (t >= 10.1 && t < 11.9) {
					const go = smooth(10.1, 10.75, t);
					const ret = smooth(11.25, 11.9, t);
					const mug: Pt = { x: MX - 4, y: T2 - 5 * S };
					const k = go * (1 - ret);
					near = { at: lerpPt(fromGrip, mug, k), pose: 'grip', d: 9.5, shape: blendShape(flatSh, gripSh, k), dir: lerp(0.02, 0, k), roll: lerp(ROLL.palmCw, ROLL.backViewer, k), contact: k > 0.999 ? 'mug' : undefined };
				}
				const wantBack = t >= 10.4 && t < 11.6;
				if (wantBack !== holdsMug) {
					holdsMug = wantBack;
					teen.backLayer(0, holdsMug ? mBack : null);
				}
				teen.pose({
					hip: HIP,
					lean: 0.12,
					head: 0.18,
					ankles: [
						{ x: HIP.x + 112, y: ankleY },
						{ x: HIP.x + 100, y: ankleY },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [near, rest[1]],
				});
				syncLens();
			});
		}
	}
</script>
