---
/**
 * Small pictures for «Где это встречается» of «Основы термодинамики» (schemes, not to scale; a light animation):
 *   1. Кучевые облака: a summer field; a warm bubble of air rises (faint arrow) and expands with almost no heat
 *      exchange, so it cools: dry air by about 10 °C per kilometre of rise (25 °C at the ground, 10 °C at 1,5 км, where
 *      the vapour condenses and a cumulus with a flat base forms). A height scale 0, 1 км, 2 км (50 px per km).
 *   2. Холодильник: a kitchen fridge in section: the cold chamber at +4 °C, the warm grille on the back at about 40 °C
 *      giving heat to the kitchen (wavy lines), the compressor at the bottom, plugged into the wall; a red arrow: heat
 *      taken from the chamber and given off at the grille (it goes from cold to warm only because the compressor works).
 *   3. Турбина самолёта: a jet engine in section: the fan, the compressor (blades getting shorter), the combustion
 *      chamber (glowing) and the turbine; the gas before the turbine reaches about 1500 °C (a hotter heater: a higher
 *      possible efficiency); small blue arrows of cooling air inside a turbine blade.
 *   4. Градирни электростанции: two cooling towers with white plumes by a river: the cooler of a power station (grade 8
 *      «Тепловые двигатели» shows the whole station; here only its cooler, close up).
 */
import G7Styles from '../g7/G7Styles.astro';

const cloud = 'M52 50 H142 Q150 50 148 42 Q154 32 144 26 Q146 12 130 12 Q124 2 110 6 Q100 -2 88 6 Q74 2 70 14 Q56 14 58 28 Q46 32 52 42 Q48 50 52 50 Z';
---

<G7Styles />
<figure class="g7 g7--pic otuses not-content" data-otuses>
	<div class="g7__grid is-two">
		<div class="otuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Летний день над полем. Тёплый воздух поднимается, расширяется и охлаждается: у земли 25 градусов, на высоте полтора километра 10 градусов. Там образуется кучевое облако с плоским основанием">
				<rect class="otu-sky" x="0" y="0" width="200" height="124"></rect>
				<path class="otu-cloud" d={cloud} transform="translate(-10 0)"></path>
				<path class="otu-base" d="M44 50 H134"></path>
				<rect class="otu-field" x="0" y="124" width="200" height="10"></rect>
				<path class="otu-grass" d={Array.from({ length: 24 }, (_, k) => `M${4 + k * 8.2} 124 l-1.5 -3 M${7 + k * 8.2} 124 l1.5 -3.5`).join(' ')}></path>
				<!-- the rising bubble -->
				<ellipse class="otu-bubble" data-bubble cx="90" cy="104" rx="9" ry="7"></ellipse>
				<path class="otu-up" d="M90 96 V64 M86 70 L90 62 L94 70"></path>
				<!-- the height scale -->
				<path class="otu-scale" d="M14 124 V20 M10 124 H18 M10 74 H18 M10 24 H18"></path>
				<text class="otu-t" x="21" y="119">0</text>
				<text class="otu-t" x="21" y="77">1 км</text>
				<text class="otu-t" x="21" y="27">2 км</text>
				<!-- thermometers -->
				<g transform="translate(184 108)">
					<rect class="otu-therm" x="-2" y="-14" width="4" height="16" rx="2"></rect>
					<circle class="otu-bulb" cx="0" cy="3" r="3"></circle>
					<rect class="otu-col" x="-1" y="-9" width="2" height="11"></rect>
				</g>
				<text class="otu-t" x="178" y="112" text-anchor="end">25 °C</text>
				<g transform="translate(184 48)">
					<rect class="otu-therm" x="-2" y="-14" width="4" height="16" rx="2"></rect>
					<circle class="otu-bulb" cx="0" cy="3" r="3"></circle>
					<rect class="otu-col" x="-1" y="-4" width="2" height="6"></rect>
				</g>
				<text class="otu-t" x="178" y="52" text-anchor="end">10 °C</text>
			</svg>
			<p>Кучевые облака</p>
		</div>
		<div class="otuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Холодильник в разрезе: внутри плюс 4 градуса, решётка на задней стенке нагрета примерно до 40 градусов и отдаёт тепло в кухню; внизу компрессор, включённый в розетку">
				<rect class="otu-wall" x="0" y="0" width="200" height="126"></rect>
				<rect class="otu-floor" x="0" y="126" width="200" height="8"></rect>
				<!-- the fridge body and its cold chamber -->
				<rect class="otu-fridge" x="36" y="10" width="74" height="116" rx="4"></rect>
				<rect class="otu-cold" x="42" y="16" width="62" height="86" rx="2"></rect>
				<path class="otu-shelf" d="M42 44 H104 M42 72 H104"></path>
				<rect class="otu-food" x="50" y="32" width="10" height="12" rx="2"></rect>
				<rect class="otu-food otu-food--b" x="66" y="36" width="16" height="8" rx="2"></rect>
				<rect class="otu-food otu-food--c" x="54" y="60" width="20" height="12" rx="3"></rect>
				<rect class="otu-food" x="48" y="86" width="10" height="16" rx="2"></rect>
				<text class="otu-t otu-t--b" x="82" y="96" text-anchor="middle">+4 °C</text>
				<!-- the compressor at the bottom back, its cable and plug -->
				<rect class="otu-comp" x="88" y="108" width="18" height="14" rx="4"></rect>
				<path class="otu-cable" d="M106 120 Q124 126 150 122 L160 118"></path>
				<rect class="otu-socket" x="160" y="110" width="10" height="14" rx="2"></rect>
				<!-- the grille on the back and the heat it gives off -->
				<path class="otu-grille" d="M114 16 L120 20 L114 26 L120 32 L114 38 L120 44 L114 50 L120 56 L114 62 L120 68 L114 74 L120 80 L114 86 L120 92 L114 98"></path>
				<g data-waves>
					<path class="otu-wave" d="M126 36 q4 -4 0 -8 q-4 -4 0 -8"></path>
					<path class="otu-wave" d="M134 62 q4 -4 0 -8 q-4 -4 0 -8"></path>
					<path class="otu-wave" d="M126 88 q4 -4 0 -8 q-4 -4 0 -8"></path>
				</g>
				<text class="otu-t" x="142" y="50">≈ 40 °C</text>
				<!-- heat: out of the chamber, given off at the grille -->
				<path class="otu-heat" d="M72 24 H112"></path>
				<path class="otu-heat-h" d="M110 20.5 L117 24 L110 27.5 Z"></path>
				<text class="otu-t otu-t--r" x="64" y="27" text-anchor="end">Q</text>
			</svg>
			<p>Холодильник</p>
		</div>
		<div class="otuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Реактивный двигатель самолёта в разрезе: вентилятор, компрессор, камера сгорания и турбина. Газ перед турбиной нагрет до 1500 градусов">
				<rect class="otu-sky" x="0" y="0" width="200" height="134"></rect>
				<!-- the nacelle in section -->
				<path class="otu-nac" d="M8 48 Q10 36 30 36 H150 L186 48 V86 L150 98 H30 Q10 98 8 86 Z"></path>
				<rect class="otu-core" x="38" y="54" width="120" height="26" rx="4"></rect>
				<!-- the fan -->
				<path class="otu-fan" d="M20 40 V94 M24 40 V94 M28 40 V94"></path>
				<!-- the compressor stages: shorter and shorter blades -->
				<path class="otu-blade" d="M44 56 V78 M50 57 V77 M56 58 V76 M62 59 V75 M68 60 V74"></path>
				<!-- the combustion chamber -->
				<ellipse class="otu-fire" data-fire cx="96" cy="67" rx="18" ry="9"></ellipse>
				<ellipse class="otu-fire2" cx="96" cy="67" rx="10" ry="5"></ellipse>
				<!-- the turbine with cooling air inside a blade -->
				<path class="otu-blade otu-blade--t" d="M124 56 V78 M130 56 V78 M136 56 V78"></path>
				<path class="otu-cool" d="M130 76 V60 M128 63 L130 59 L132 63"></path>
				<!-- the exhaust -->
				<path class="otu-jet" data-jet d="M186 54 Q196 67 186 80"></path>
				<path class="otu-lead" d="M118 54 L112 30"></path>
				<text class="otu-t" x="112" y="16" text-anchor="middle">газ перед турбиной</text>
				<text class="otu-t" x="112" y="27" text-anchor="middle">до 1500 °C</text>
			</svg>
			<p>Турбина самолёта</p>
		</div>
		<div class="otuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Две градирни электростанции над рекой, из них поднимаются белые облака пара: это холодильник станции">
				<rect class="otu-sky" x="0" y="0" width="200" height="134"></rect>
				<rect class="otu-land" x="0" y="104" width="200" height="12"></rect>
				<rect class="otu-river" x="0" y="116" width="200" height="18"></rect>
				<path class="otu-ripple" d="M14 122 h14 M60 128 h18 M120 123 h16 M160 129 h20"></path>
				<!-- the station building -->
				<rect class="otu-bld" x="146" y="74" width="44" height="30"></rect>
				<rect class="otu-bld" x="160" y="44" width="6" height="30"></rect>
				<!-- the towers: hyperboloids -->
				<path class="otu-tower" d="M28 104 Q42 72 34 50 H70 Q62 72 76 104 Z"></path>
				<path class="otu-tower" d="M88 104 Q102 72 94 50 H130 Q122 72 136 104 Z"></path>
				<g data-plumes>
					<path class="otu-plume" d="M36 50 Q30 40 40 34 Q38 22 52 24 Q60 14 70 24 Q80 26 72 38 Q74 46 68 50 Z"></path>
					<path class="otu-plume" d="M96 50 Q90 40 100 34 Q98 22 112 24 Q120 14 130 24 Q140 26 132 38 Q134 46 128 50 Z"></path>
				</g>
				<text class="otu-t" x="100" y="11" text-anchor="middle">холодильник станции</text>
			</svg>
			<p>Градирни электростанции</p>
		</div>
	</div>
</figure>

<style is:global>
	.otuses__cell p {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		text-align: center;
	}
	.g7__svg .otu-t {
		font-size: 9.5px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .otu-t--b {
		fill: var(--g7-blue);
		font-weight: 600;
	}
	.g7__svg .otu-t--r {
		fill: var(--g7-red);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 11px;
	}
	.otu-sky {
		fill: var(--g7-sky);
	}
	.otu-cloud {
		fill: color-mix(in oklab, white 90%, var(--ig-vx));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	.otu-base {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.otu-field {
		fill: hsl(95, 40%, 40%);
	}
	.otu-grass {
		stroke: hsl(110, 45%, 32%);
		stroke-width: 1;
	}
	.otu-bubble {
		fill: color-mix(in oklab, var(--g7-red) 30%, transparent);
		stroke: var(--g7-red);
		stroke-width: 0.8;
		stroke-dasharray: 2 1.5;
	}
	.otu-up {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 2;
	}
	.otu-scale {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.otu-therm {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.otu-bulb,
	.otu-col {
		fill: var(--g7-red);
	}
	.otu-wall {
		fill: color-mix(in oklab, var(--ig-v) 8%, var(--sl-color-gray-6));
	}
	.otu-floor {
		fill: var(--g7-wood);
	}
	.otu-fridge {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.otu-cold {
		fill: color-mix(in oklab, var(--g7-blue) 22%, var(--g7-paper));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.otu-shelf {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.otu-food {
		fill: color-mix(in oklab, var(--g7-gold) 60%, var(--sl-color-gray-4));
	}
	.otu-food--b {
		fill: color-mix(in oklab, var(--g7-green) 50%, var(--sl-color-gray-4));
	}
	.otu-food--c {
		fill: color-mix(in oklab, var(--g7-red) 50%, var(--sl-color-gray-4));
	}
	.otu-comp {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.otu-cable {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.otu-socket {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.otu-grille {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.otu-wave {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.2;
		stroke-linecap: round;
		opacity: 0.8;
	}
	.otu-heat {
		stroke: var(--g7-red);
		stroke-width: 2.4;
	}
	.otu-heat-h {
		fill: var(--g7-red);
	}
	.otu-nac {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.otu-core {
		fill: color-mix(in oklab, var(--g7-steel) 60%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.otu-fan {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.otu-blade {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.otu-blade--t {
		stroke-width: 3;
		stroke: color-mix(in oklab, var(--g7-red) 35%, var(--sl-color-gray-2));
	}
	.otu-fire {
		fill: color-mix(in oklab, var(--g7-red) 70%, var(--g7-gold));
		opacity: 0.85;
	}
	.otu-fire2 {
		fill: var(--g7-gold);
	}
	.otu-cool {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1;
	}
	.otu-jet {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-red) 60%, var(--g7-gold));
		stroke-width: 2;
		stroke-dasharray: 3 2;
	}
	.otu-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.otu-air {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.otu-land {
		fill: hsl(95, 30%, 38%);
	}
	.otu-river {
		fill: var(--g7-water);
	}
	.otu-ripple {
		stroke: var(--g7-water-edge);
		stroke-width: 0.8;
		opacity: 0.7;
	}
	.otu-bld {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.otu-tower {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--g7-paper));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.otu-plume {
		fill: color-mix(in oklab, white 92%, var(--ig-vx));
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.6;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-otuses]')) {
		const bubble = root.querySelector<SVGEllipseElement>('[data-bubble]')!;
		const waves = root.querySelector<SVGGElement>('[data-waves]')!;
		const plumes = root.querySelector<SVGGElement>('[data-plumes]')!;
		const fire = root.querySelector<SVGEllipseElement>('[data-fire]')!;
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			// the bubble rises from the field to the cloud base in 4 s, growing a little as it expands
			const k = (t % 4) / 4;
			bubble.setAttribute('cy', (104 - 48 * k).toFixed(1));
			bubble.setAttribute('rx', (8 + 3 * k).toFixed(1));
			bubble.setAttribute('ry', (6 + 2.5 * k).toFixed(1));
			bubble.style.opacity = (k < 0.85 ? 1 : (1 - k) / 0.15).toFixed(2);
			waves.setAttribute('transform', `translate(${(2 * ((t * 0.8) % 1)).toFixed(2)} ${(-3 * ((t * 0.8) % 1)).toFixed(2)})`);
			waves.style.opacity = (1 - ((t * 0.8) % 1) * 0.6).toFixed(2);
			plumes.setAttribute('transform', `translate(${(1.5 * Math.sin(t * 0.7)).toFixed(2)} ${(-1 * Math.abs(Math.sin(t * 0.5))).toFixed(2)})`);
			fire.setAttribute('rx', (18 + 1.2 * Math.sin(t * 9)).toFixed(1));
			return true;
		});
	}
</script>
