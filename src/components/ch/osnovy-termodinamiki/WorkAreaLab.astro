---
/**
 * Model «Работа газа зависит от пути» (section «Работа в термодинамике»). A monatomic ideal gas (helium),
 * ν = 0,0802 моль, so νR = 2/3 Дж/К and T = pV/(νR) = 1,5·p·V К with p in кПа and V in л (1 кПа·л = 1 Дж). Two states:
 * 1 (200 кПа, 1 л, 300 К) and 2 (100 кПа, 2 л, 300 К). Three ways from 1 to 2:
 *   «Расширить, потом охладить»: 1 → (200 кПа, 2 л, 600 К) at p = const, A′ = 200·1 = 200 Дж; then → 2 at V = const,
 *     A′ adds 0: in all 200 Дж;
 *   «Охладить, потом расширить»: 1 → (100 кПа, 1 л, 150 К) at V = const, A′ = 0; then → 2 at p = const: 100 Дж;
 *   «При постоянной температуре»: the isotherm p = 200/V кПа, A′ = 200·ln 2 = 138,63 Дж, shown as 139 Дж.
 * The switch «2 → 1» runs the same way backwards: the gas is compressed and its work is negative (−200, −100,
 * −139 Дж). The work is computed from these formulas at every moment (not summed from the drawing); the isochoric part
 * adds nothing. «Пуск» runs the state along the way in 4 с (each part of a two-part way in 2 с); the piston moves
 * with V (66 px per liter); the area under the passed part of the graph is filled blue (solid for expansion, hatched
 * for compression, the work then negative). The plate under the cylinder heats or cools as the heat goes in or out:
 * Q = ΔU + A′ with ΔU = 3/2·νR·ΔT = ΔT Дж. The graph: p from 0 to 250 кПа (0,8 px per кПа), V from 0 to 2,5 л (92 px
 * per liter); the other two ways stay as faint dashed lines.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = `wal${Math.random().toString(36).slice(2, 8)}`;
const X0 = 118;
const Y0 = 226;
const X = (V: number) => X0 + V * 92;
const Y = (p: number) => Y0 - p * 0.8;
const BASE = 226;
---

<G7Styles />
<figure class="g7 g7--wide wal not-content" data-workarea>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 262" role="img" aria-label="Газ под поршнем и график давления от объёма. Газ переводят из состояния 1 в состояние 2 тремя путями; площадь под графиком — работа газа">
			<defs>
				<pattern id={`${uid}-h`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
					<rect width="6" height="6" class="wal-hatch-bg"></rect>
					<line x1="0" y1="0" x2="0" y2="6" class="wal-hatch-ln"></line>
				</pattern>
			</defs>
			<!-- the cylinder -->
			<path class="wal-wall" d={`M14 84 V${BASE} H76 V84`}></path>
			<rect class="wal-gas" data-gas x="16" width="58"></rect>
			<g data-piston>
				<rect class="wal-piston" x="16" y="-8" width="58" height="8"></rect>
				<rect class="wal-rod" x="41" y="-40" width="8" height="32"></rect>
			</g>
			<rect class="wal-plate" data-plate x="10" y={BASE + 2} width="70" height="8" rx="2"></rect>
			<g data-qarrow>
				<line class="wal-q" data-qline x1="88" x2="88"></line>
				<path class="wal-q-head" data-qhead d=""></path>
				<text class="t-i t-red" x="95" y={BASE + 10}>Q</text>
			</g>
			<text class="t-small wal-s" data-platelab x="45" y="254" text-anchor="middle"></text>
			<!-- the graph -->
			<g class="wal-grid">
				{[50, 100, 150, 200, 250].map((p) => <line x1={X0} y1={Y(p)} x2={X(2.5)} y2={Y(p)}></line>)}
				{[0.5, 1, 1.5, 2].map((V) => <line x1={X(V)} y1={Y(250)} x2={X(V)} y2={Y0}></line>)}
			</g>
			{[50, 100, 150, 200, 250].map((p) => <text class="t-small wal-s" x={X0 - 5} y={Y(p) + 4} text-anchor="end">{p}</text>)}
			{[0.5, 1, 1.5, 2].map((V) => <text class="t-small wal-s" x={X(V)} y={Y0 + 14} text-anchor="middle">{String(V).replace('.', ',')}</text>)}
			<path class="wal-area" data-area d=""></path>
			<path class="wal-narea" data-narea d="" fill={`url(#${uid}-h)`}></path>
			<path class="wal-ghost" data-ghost d=""></path>
			<path class="wal-way" data-way d=""></path>
			<path class="wal-done" data-done d=""></path>
			<path class="wal-axis" d={`M${X0} ${Y(250) - 12} V${Y0} H${X(2.5) + 8}`}></path>
			<path class="wal-axis-head" d={`M${X0 - 3.5} ${Y(250) - 8} L${X0} ${Y(250) - 16} L${X0 + 3.5} ${Y(250) - 8} Z M${X(2.5) + 4} ${Y0 - 3.5} L${X(2.5) + 12} ${Y0} L${X(2.5) + 4} ${Y0 + 3.5} Z`}></path>
			<text class="t-i" x={X0 + 7} y={Y(250) - 6}>p<tspan class="t-small wal-s" font-style="normal">, кПа</tspan></text>
			<text class="t-i" x={X(2.5) + 10} y={Y0 - 8} text-anchor="end">V<tspan class="t-small wal-s" font-style="normal">, л</tspan></text>
			<circle class="wal-pt" cx={X(1)} cy={Y(200)} r="3.6"></circle>
			<circle class="wal-pt" cx={X(2)} cy={Y(100)} r="3.6"></circle>
			<text class="t-title" x={X(1) - 6} y={Y(200) - 7} text-anchor="end">1</text>
			<text class="t-title" x={X(2) + 7} y={Y(100) - 6}>2</text>
			<circle class="wal-dot" data-dot r="4.5"></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__label" data-waylab>Путь из 1 в 2</div>
			<div class="g7__seg wal-seg" data-way-btns>
				<button type="button" class="g7__btn" aria-pressed="true" data-w="A">Расширить, потом охладить</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-w="B">Охладить, потом расширить</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-w="C">При постоянной температуре</button>
			</div>
			<div class="g7__seg" data-dir-btns>
				<button type="button" class="g7__btn" aria-pressed="true" data-d="f">1 → 2 (расширение)</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-d="r">2 → 1 (сжатие)</button>
			</div>
			<button type="button" class="g7__btn g7__btn--go g7__again" data-go>Пуск</button>
			<ul class="g7__read">
				<li><span>давление <i>p</i></span> <b data-p></b></li>
				<li><span>объём <i>V</i></span> <b data-v></b></li>
				<li class="is-warm"><span>температура <i>T</i></span> <b data-t></b></li>
				<li class="is-key"><span>работа газа <i>A</i>′</span> <b data-a></b></li>
			</ul>
			<p class="g7__note" data-leg></p>
		</div>
	</div>
	<figcaption class="g7__caption">Одноатомный газ (гелий, 0,08&nbsp;моль). В состояниях 1 и 2 его температура одна и та же, 300&nbsp;К. Выберите путь и направление и нажмите «Пуск»: площадь под графиком — работа газа (заштрихована, когда работа отрицательна).</figcaption>
</figure>

<style is:global>
	.wal-wall {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.wal-gas {
		fill: color-mix(in oklab, var(--ig-vx) 18%, transparent);
	}
	.wal-piston,
	.wal-rod {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.wal-plate {
		fill: var(--sl-color-gray-4);
	}
	.wal-plate.is-hot {
		fill: var(--g7-red);
	}
	.wal-plate.is-cold {
		fill: var(--g7-blue);
	}
	.wal-q {
		stroke: var(--g7-red);
		stroke-width: 3;
	}
	.wal-q-head {
		fill: var(--g7-red);
	}
	.wal-grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.wal-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.wal-axis-head {
		fill: var(--sl-color-gray-2);
	}
	.wal-area {
		fill: color-mix(in oklab, var(--g7-blue) 38%, transparent);
		stroke: none;
	}
	.wal-hatch-bg {
		fill: color-mix(in oklab, var(--g7-blue) 12%, transparent);
	}
	.wal-hatch-ln {
		stroke: var(--g7-blue);
		stroke-width: 2;
	}
	.wal-ghost {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.wal-way {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.wal-done {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.wal-pt {
		fill: var(--sl-color-gray-1);
	}
	.wal-dot {
		fill: var(--g7-blue);
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
	}
	.wal-seg .g7__btn {
		flex-basis: 100%;
		text-align: left;
	}
	.wal-seg .g7__btn + .g7__btn {
		border-left: 0;
		border-top: 1px solid var(--sl-color-gray-4);
	}
	@media (max-width: 40rem) {
		.g7__svg .wal-s {
			font-size: 12.5px;
		}
	}
</style>

<script>
	import { fmt, fmtInt, loop, segment } from '../g7/kit';

	type St = { p: number; V: number };
	type Leg = { kind: 'p' | 'V' | 'T'; a: St; b: St };
	const X = (V: number) => 118 + V * 92;
	const Y = (p: number) => 226 - p * 0.8;
	const BASE = 226;
	const PX = 66; // px per liter of the gas column
	const S1: St = { p: 200, V: 1 };
	const S2: St = { p: 100, V: 2 };
	const WAYS: Record<string, Leg[]> = {
		A: [
			{ kind: 'p', a: S1, b: { p: 200, V: 2 } },
			{ kind: 'V', a: { p: 200, V: 2 }, b: S2 },
		],
		B: [
			{ kind: 'V', a: S1, b: { p: 100, V: 1 } },
			{ kind: 'p', a: { p: 100, V: 1 }, b: S2 },
		],
		C: [{ kind: 'T', a: S1, b: S2 }],
	};
	const legsOf = (w: string, rev: boolean): Leg[] => (rev ? WAYS[w].slice().reverse().map((l) => ({ kind: l.kind, a: l.b, b: l.a })) : WAYS[w]);
	// the state at s (0…1) along a leg
	const at = (l: Leg, s: number): St => {
		if (l.kind === 'V') return { V: l.a.V, p: l.a.p + (l.b.p - l.a.p) * s };
		const V = l.a.V + (l.b.V - l.a.V) * s;
		return { V, p: l.kind === 'p' ? l.a.p : 200 / V };
	};
	// the work of the gas over a leg up to s, Дж (кПа·л)
	const work = (l: Leg, s: number) => {
		const q = at(l, s);
		if (l.kind === 'V') return 0;
		if (l.kind === 'p') return l.a.p * (q.V - l.a.V);
		return 200 * Math.log(q.V / l.a.V);
	};
	const T = (q: St) => 1.5 * q.p * q.V;
	const RUN = 4;
	const LEG_NOTE: Record<string, string> = {
		p: 'Давление постоянно: работа газа A′ = pΔV.',
		V: 'Объём постоянен: поршень стоит, работа газа равна нулю.',
		T: 'Температура постоянна: давление падает с ростом объёма, p = 200 кПа·л / V.',
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-workarea]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const gas = $<SVGRectElement>('[data-gas]');
		const piston = $<SVGGElement>('[data-piston]');
		const plate = $<SVGRectElement>('[data-plate]');
		const qArrow = $<SVGGElement>('[data-qarrow]');
		const qLine = $<SVGLineElement>('[data-qline]');
		const qHead = $<SVGPathElement>('[data-qhead]');
		const area = $<SVGPathElement>('[data-area]');
		const narea = $<SVGPathElement>('[data-narea]');
		const ghost = $<SVGPathElement>('[data-ghost]');
		const way = $<SVGPathElement>('[data-way]');
		const done = $<SVGPathElement>('[data-done]');
		const dot = $<SVGCircleElement>('[data-dot]');
		let w = 'A';
		let rev = false;
		let t = 0; // s since «Пуск»
		let running = false;
		const line = (legs: Leg[], upto = 1) => {
			let d = '';
			const n = legs.length;
			legs.forEach((l, i) => {
				const s1 = Math.min(1, Math.max(0, upto * n - i));
				if (s1 <= 0 && i > 0) return;
				const steps = l.kind === 'T' ? 60 : 1;
				for (let k = 0; k <= steps; k++) {
					const q = at(l, (s1 * k) / steps);
					d += `${d ? 'L' : 'M'}${X(q.V).toFixed(1)} ${Y(q.p).toFixed(1)} `;
				}
			});
			return d;
		};
		const draw = () => {
			const legs = legsOf(w, rev);
			const n = legs.length;
			const x = Math.min(1, t / RUN);
			const i = Math.min(n - 1, Math.floor(x * n));
			const s = Math.min(1, x * n - i);
			const q = at(legs[i], s);
			let A = 0;
			for (let k = 0; k < i; k++) A += work(legs[k], 1);
			A += work(legs[i], s);
			// the way: the other two ways dashed, this one gray, the passed part blue, the area under it
			ghost.setAttribute('d', ['A', 'B', 'C'].filter((o) => o !== w).map((o) => line(legsOf(o, false))).join(' '));
			way.setAttribute('d', line(legs));
			const passed = line(legs, x);
			done.setAttribute('d', x > 0 ? passed : '');
			const v0 = legs[0].a.V;
			const poly = x > 0 && Math.abs(q.V - v0) > 1e-6 ? `${passed}L${X(q.V).toFixed(1)} ${Y(0)} L${X(v0).toFixed(1)} ${Y(0)} Z` : '';
			area.setAttribute('d', rev ? '' : poly);
			narea.setAttribute('d', rev ? poly : '');
			dot.setAttribute('cx', X(q.V).toFixed(1));
			dot.setAttribute('cy', Y(q.p).toFixed(1));
			// the cylinder
			const h = PX * q.V;
			gas.setAttribute('y', (BASE - h).toFixed(1));
			gas.setAttribute('height', h.toFixed(1));
			piston.setAttribute('transform', `translate(0 ${(BASE - h).toFixed(1)})`);
			// heat in or out: dQ = dT + p·dV over a small step ahead on this leg
			const ds = 0.002;
			const q2 = at(legs[i], Math.min(1, s + ds));
			const q1 = at(legs[i], Math.min(1, s + ds) - ds);
			const dQ = T(q2) - T(q1) + 0.5 * (q1.p + q2.p) * (q2.V - q1.V);
			const moving = running && x < 1;
			const hot = moving && dQ > 1e-6;
			const cold = moving && dQ < -1e-6;
			plate.classList.toggle('is-hot', hot);
			plate.classList.toggle('is-cold', cold);
			qArrow.style.display = hot || cold ? '' : 'none';
			qLine.setAttribute('y1', String(hot ? BASE + 22 : BASE - 2));
			qLine.setAttribute('y2', String(hot ? BASE + 2 : BASE + 18));
			qHead.setAttribute('d', hot ? `M82 ${BASE + 4} L88 ${BASE - 7} L94 ${BASE + 4} Z` : `M82 ${BASE + 16} L88 ${BASE + 27} L94 ${BASE + 16} Z`);
			$('[data-platelab]').textContent = hot ? 'нагревание' : cold ? 'охлаждение' : '';
			$('[data-p]').textContent = `${fmtInt(q.p)} кПа`;
			$('[data-v]').textContent = `${fmt(q.V, 2)} л`;
			$('[data-t]').textContent = `${fmtInt(T(q))} К`;
			$('[data-a]').textContent = `${fmtInt(A)} Дж`;
			$('[data-leg]').textContent = x > 0 && x < 1 ? LEG_NOTE[legs[i].kind] : x >= 1 ? `Готово: работа газа ${fmtInt(A)} Дж.` : 'Нажмите «Пуск».';
		};
		const reset = () => {
			t = 0;
			running = false;
			draw();
		};
		segment($('[data-way-btns]'), (b) => {
			w = b.dataset.w!;
			reset();
		});
		// the same paths run backwards are named by what happens to the gas then (2 → 1: heated and compressed, …)
		const NAMES: Record<string, [string, string]> = {
			A: ['Расширить, потом охладить', 'Нагреть, потом сжать'],
			B: ['Охладить, потом расширить', 'Сжать, потом нагреть'],
			C: ['При постоянной температуре', 'При постоянной температуре'],
		};
		segment($('[data-dir-btns]'), (b) => {
			rev = b.dataset.d === 'r';
			$('[data-waylab]').textContent = rev ? 'Путь из 2 в 1' : 'Путь из 1 в 2';
			root.querySelectorAll<HTMLButtonElement>('[data-way-btns] [data-w]').forEach((x) => (x.textContent = NAMES[x.dataset.w!][rev ? 1 : 0]));
			reset();
		});
		const wake = loop(root, (dt) => {
			if (!running) return false;
			t += dt;
			if (t >= RUN) {
				t = RUN;
				running = false;
			}
			draw();
			return running;
		});
		$('[data-go]').addEventListener('click', () => {
			t = 0;
			running = true;
			draw();
			wake();
		});
		draw();
	}
</script>
