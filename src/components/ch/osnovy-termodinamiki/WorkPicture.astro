---
/**
 * Picture to «Работа в термодинамике» (a scheme). A gas under a piston with a load is heated; the load keeps the
 * pressure p constant, and the piston of area S rises by Δh, so the volume grows by ΔV = SΔh. The gas pushes the
 * piston with the force F⃗ (its modulus F = pS; red, labelled with an arrow over the letter, the only force in this chapter's pictures) along the whole way, so its work is
 * A′ = FΔh = pSΔh = pΔV. On the right, the process on the p–V graph: a horizontal line from V₁ to V₂, and the work is
 * the area of the rectangle under it, which grows with the piston. The volume doubles (as when air at 300 К is heated
 * to 600 К at constant pressure). One loop: 3 s of heating, 2 s holding.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic wk not-content" data-work>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 200" role="img" aria-label="Газ под поршнем с грузом нагревают. Поршень поднимается, объём растёт при постоянном давлении. На графике давления от объёма работа газа равна площади прямоугольника под линией процесса">
			<!-- the cylinder -->
			<path class="wk-wall" d="M34 40 V170 H126 V40"></path>
			<rect class="wk-gas" data-gas x="36" y="120" width="88" height="48"></rect>
			<g data-piston>
				<rect class="wk-piston" x="36" y="-8" width="88" height="8"></rect>
				<rect class="wk-load" x="56" y="-30" width="48" height="22" rx="2"></rect>
				<line class="wk-force" x1="80" y1="14" x2="80" y2="2"></line>
				<path class="wk-force-head" d="M75 4 L80 -6 L85 4 Z"></path>
			</g>
			<text class="t-i t-red" data-flab x="88" y="0">F</text>
			<path class="wk-vec" data-fvec d=""></path>
			<path class="wk-dim" data-dim d=""></path>
			<text class="t-i t-gold" data-dh x="132" y="0">Δh</text>
			<path class="wk-flame" d="M70 192 Q64 182 72 174 Q74 182 80 178 Q78 170 86 166 Q92 180 88 192 Z"></path>
			<rect class="wk-burner" x="62" y="192" width="36" height="5" rx="1"></rect>
			<!-- the graph -->
			<path class="wk-axis" d="M184 24 V172 H346"></path>
			<text class="t-i" x="190" y="30">p</text>
			<text class="t-i" x="340" y="164" text-anchor="end">V</text>
			<rect class="wk-area" data-area x="220" y="80" width="0" height="92"></rect>
			<line class="wk-line" data-line x1="220" y1="80" x2="220" y2="80"></line>
			<circle class="wk-dot" data-dot cx="220" cy="80" r="4"></circle>
			<path class="wk-guide" d="M184 80 H220 M220 80 V172"></path>
			<text class="t-i" x="178" y="84" text-anchor="end">p</text>
			<text class="t-i" x="220" y="188" text-anchor="middle">V<tspan font-size="9" dy="3">1</tspan></text>
			<text class="t-i" data-v2 x="320" y="188" text-anchor="middle">V<tspan font-size="9" dy="3">2</tspan></text>
			<text class="t-strong" data-alab x="270" y="132" text-anchor="middle">A′ = pΔV</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Газ нагревают, и он при постоянном давлении поднимает поршень с грузом. Работа газа равна площади прямоугольника под линией процесса на графике <i>p</i>(<i>V</i>) (схема).</figcaption>
</figure>

<style is:global>
	.wk-wall {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.wk-gas {
		fill: color-mix(in oklab, var(--ig-vx) 22%, transparent);
	}
	.wk-piston {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.wk-load {
		fill: var(--g7-steel-dark);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.wk-force {
		stroke: var(--g7-red);
		stroke-width: 3;
	}
	.wk-force-head {
		fill: var(--g7-red);
	}
	.wk-flame {
		fill: var(--g7-gold);
		opacity: 0.9;
	}
	.wk-burner {
		fill: var(--sl-color-gray-3);
	}
	.wk-dim {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.wk-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.wk-area {
		fill: color-mix(in oklab, var(--ig-vx) 35%, transparent);
	}
	.wk-line {
		stroke: var(--g7-blue);
		stroke-width: 3;
	}
	.wk-dot {
		fill: var(--g7-blue);
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	.wk-vec {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.1;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.wk-guide {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-work]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const gas = $<SVGRectElement>('[data-gas]');
		const piston = $<SVGGElement>('[data-piston]');
		const area = $<SVGRectElement>('[data-area]');
		const line = $<SVGLineElement>('[data-line]');
		const dot = $<SVGCircleElement>('[data-dot]');
		const dim = $<SVGPathElement>('[data-dim]');
		const dh = $<SVGTextElement>('[data-dh]');
		const flab = $<SVGTextElement>('[data-flab]');
		const alab = $<SVGTextElement>('[data-alab]');
		const fvec = $<SVGPathElement>('[data-fvec]');
		let t = 0;
		loop(root, (dt) => {
			t = (t + dt) % 5;
			const k = ease((t - 0.3) / 3);
			// the gas column: 48 px (V₁) to 96 px (V₂ = 2V₁)
			const h = 48 * (1 + k);
			const top = 168 - h;
			gas.setAttribute('y', f(top));
			gas.setAttribute('height', f(h));
			piston.setAttribute('transform', `translate(0 ${f(top)})`);
			flab.setAttribute('y', f(top + 26));
			// the vector arrow over F
			const vy = top + 14.5;
			fvec.setAttribute('d', `M88.5 ${f(vy)} H97 M95 ${f(vy - 1.8)} L97.4 ${f(vy)} L95 ${f(vy + 1.8)}`);
			dim.setAttribute('d', k > 0.02 ? `M132 ${f(top)} V120 M128 ${f(top)} h8 M128 120 h8` : '');
			dh.setAttribute('y', f((top + 120) / 2 + 4));
			dh.setAttribute('x', '140');
			dh.style.display = k > 0.15 ? '' : 'none';
			const x = 220 + 100 * k;
			area.setAttribute('width', f(100 * k));
			line.setAttribute('x2', f(x));
			dot.setAttribute('cx', f(x));
			alab.style.display = k > 0.6 ? '' : 'none';
			return true;
		});
	}
</script>
