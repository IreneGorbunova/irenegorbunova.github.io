---
/**
 * Model «Цикл Карно». An ideal engine whose working body is a monatomic ideal gas, ν = 0,0401 моль (νR = 1/3 Дж/К).
 * One cycle, 2,5 s for each of its four stages, played round and round:
 *   1→2 the cylinder stands on the heater at T₁: the gas expands at T₁ from V₁ = 1 л to V₂ = 2 л, receiving
 *       Q₁ = νRT₁·ln 2 (the work of an isothermal expansion; no school formula is needed, the model computes it);
 *   2→3 the cylinder stands on an insulator: the gas expands with no heat exchange and cools to T₂
 *       (T·V^(2/3) = const, so V₃ = V₂·(T₁/T₂)^(3/2));
 *   3→4 on the cooler at T₂: the gas is compressed at T₂ to V₄ = V₁·(T₁/T₂)^(3/2) and gives |Q₂| = νRT₂·ln 2 away;
 *   4→1 on the insulator: compressed with no heat exchange back to T₁ and V₁.
 * The work of the cycle is A′ = Q₁ − |Q₂| (the shaded area inside the loop on the p–V graph), and the efficiency
 * η = A′/Q₁ equals (T₁ − T₂)/T₁ for every pair of temperatures. Example: T₁ = 600 К, T₂ = 300 К: Q₁ = 138,6 Дж,
 * |Q₂| = 69,3 Дж, A′ = 69,3 Дж, η = 50 %. Ranges: T₁ 450–800 К, T₂ 250–400 К. The axes rescale with the
 * temperatures (the caption says so), so the loop of one setting cannot be compared with another by its area on the
 * screen: the tasks compare the work A′ by its readout. The gas column is drawn to the same scale of volume as the
 * graph. The point labels sit where no axis label is: «1» below and left of its corner, «3» above and right of it,
 * and «V, л» under the tick numbers. The cycle is slowed down (a real
 * engine makes tens of cycles a second).
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--wide cn not-content" data-carnot>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Цикл Карно: газ под поршнем по очереди стоит на нагревателе, на теплоизоляции, на холодильнике и снова на теплоизоляции. Справа замкнутый цикл на графике давления от объёма; площадь внутри цикла — работа газа за цикл">
			<!-- the cylinder -->
			<path class="cn-wall" d="M22 34 V204 H112 V34"></path>
			<rect class="cn-gas" data-gas x="24" y="150" width="86" height="54"></rect>
			<g data-piston>
				<rect class="cn-piston" x="24" y="-8" width="86" height="8"></rect>
				<rect class="cn-rod" x="62" y="-40" width="10" height="32"></rect>
			</g>
			<rect class="cn-stand" data-stand x="14" y="206" width="106" height="14" rx="3"></rect>
			<text class="t-small" data-standlab x="67" y="236" text-anchor="middle"></text>
			<text class="t-small" data-tgas x="67" y="22" text-anchor="middle"></text>
			<!-- the graph -->
			<g data-ticks></g>
			<path class="cn-axis" d="M150 12 V206 H352"></path>
			<text class="t-i" x="156" y="20">p<tspan class="t-small" font-style="normal">, кПа</tspan></text>
			<text class="t-i" x="352" y="234" text-anchor="end">V<tspan class="t-small" font-style="normal">, л</tspan></text>
			<path class="cn-area" data-area d=""></path>
			<path class="cn-iso cn-iso--hot" data-s0 d=""></path>
			<path class="cn-iso cn-adi" data-s1 d=""></path>
			<path class="cn-iso cn-iso--cold" data-s2 d=""></path>
			<path class="cn-iso cn-adi" data-s3 d=""></path>
			<g data-nums></g>
			<circle class="cn-dot" data-dot r="5"></circle>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Нагреватель <i>T</i><sub>1</sub></span>
				<output data-t1out>600 К</output>
				<input type="range" data-t1 min="450" max="800" step="50" value="600" aria-label="Температура нагревателя" />
			</label>
			<label class="g7__slider">
				<span>Холодильник <i>T</i><sub>2</sub></span>
				<output data-t2out>300 К</output>
				<input type="range" data-t2 min="250" max="400" step="25" value="300" aria-label="Температура холодильника" />
			</label>
			<ul class="g7__read">
				<li class="is-key"><span>от нагревателя <i>Q</i><sub>1</sub></span> <b data-q1></b></li>
				<li><span>холодильнику |<i>Q</i><sub>2</sub>|</span> <b data-q2></b></li>
				<li><span>работа за цикл <i>A</i>′</span> <b data-a></b></li>
				<li class="is-warm"><span>КПД η = <i>A</i>′/<i>Q</i><sub>1</sub></span> <b data-eta></b></li>
				<li><span>(<i>T</i><sub>1</sub> − <i>T</i><sub>2</sub>)/<i>T</i><sub>1</sub></span> <b data-etat></b></li>
			</ul>
			<p class="g7__note" data-stage aria-live="off"></p>
		</div>
	</div>
	<figcaption class="g7__caption">Идеальный тепловой двигатель: газ под поршнем проходит цикл из двух изотерм и двух адиабат (цикл замедлен). Площадь внутри цикла на графике — работа газа за цикл. Масштаб осей подстраивается под температуры.</figcaption>
</figure>

<style is:global>
	.cn-wall {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.cn-gas {
		fill: color-mix(in oklab, var(--ig-vx) 20%, transparent);
	}
	.cn-piston,
	.cn-rod {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.cn-stand {
		fill: var(--sl-color-gray-4);
	}
	.cn-stand.is-hot {
		fill: var(--g7-red);
	}
	.cn-stand.is-cold {
		fill: var(--g7-blue);
	}
	.cn-stand.is-ins {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-dasharray: 3 2;
	}
	.cn-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.cn-tick {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.cn-area {
		fill: color-mix(in oklab, var(--ig-v) 28%, transparent);
	}
	.cn-iso {
		fill: none;
		stroke-width: 2.6;
	}
	.cn-iso--hot {
		stroke: var(--g7-red);
	}
	.cn-iso--cold {
		stroke: var(--g7-blue);
	}
	.cn-adi {
		stroke: var(--sl-color-gray-2);
		stroke-dasharray: 5 3;
	}
	.cn-dot {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
	}
</style>

<script>
	import { el, fmt, fmtInt, fmtTrim, loop } from '../g7/kit';

	const nuR = 1 / 3;
	const STAGE = 2.5;
	const L2 = Math.log(2);
	const f = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-carnot]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const t1 = $<HTMLInputElement>('[data-t1]');
		const t2 = $<HTMLInputElement>('[data-t2]');
		const ticks = $<SVGGElement>('[data-ticks]');
		const nums = $<SVGGElement>('[data-nums]');
		const segs = [0, 1, 2, 3].map((i) => $<SVGPathElement>(`[data-s${i}]`));
		const area = $<SVGPathElement>('[data-area]');
		const dot = $<SVGCircleElement>('[data-dot]');
		const gas = $<SVGRectElement>('[data-gas]');
		const piston = $<SVGGElement>('[data-piston]');
		const stand = $<SVGRectElement>('[data-stand]');
		let T1 = 600;
		let T2 = 300;
		let Vmax = 1;
		let Pmax = 1;
		const X = (V: number) => 150 + (V / Vmax) * 196;
		const Y = (p: number) => 206 - (p / Pmax) * 186;
		// the state at stage i, fraction s of the stage
		const at = (i: number, s: number) => {
			const r = Math.pow(T1 / T2, 1.5);
			const V1 = 1;
			const V2 = 2;
			const V3 = 2 * r;
			const V4 = r;
			const geo = (a: number, b: number) => a * Math.pow(b / a, s);
			if (i === 0) {
				const V = geo(V1, V2);
				return { V, T: T1 };
			}
			if (i === 1) {
				const V = geo(V2, V3);
				return { V, T: T1 * Math.pow(V2 / V, 2 / 3) };
			}
			if (i === 2) {
				const V = geo(V3, V4);
				return { V, T: T2 };
			}
			const V = geo(V4, V1);
			return { V, T: T2 * Math.pow(V4 / V, 2 / 3) };
		};
		const P = (st: { V: number; T: number }) => (nuR * st.T) / st.V; // кПа, since Дж/л = кПа
		const nice = (m: number, opts: number[]) => opts.find((o) => m / o <= 6) ?? opts[opts.length - 1];
		const rebuild = () => {
			T1 = +t1.value;
			T2 = +t2.value;
			Vmax = 2 * Math.pow(T1 / T2, 1.5) * 1.08;
			Pmax = nuR * T1 * 1.08;
			ticks.replaceChildren();
			const vs = nice(Vmax, [1, 2, 5]);
			for (let V = vs; V < Vmax; V += vs) {
				ticks.append(el('line', { class: 'cn-tick', x1: X(V), y1: 16, x2: X(V), y2: 206 }));
				ticks.append(el('text', { class: 't-small', x: X(V), y: 219, 'text-anchor': 'middle' }, String(V)));
			}
			const ps = nice(Pmax, [50, 100]);
			for (let p = ps; p < Pmax; p += ps) {
				ticks.append(el('line', { class: 'cn-tick', x1: 150, y1: Y(p), x2: 352, y2: Y(p) }));
				ticks.append(el('text', { class: 't-small', x: 146, y: Y(p) + 4, 'text-anchor': 'end' }, String(p)));
			}
			let all = '';
			segs.forEach((sg, i) => {
				let d = '';
				for (let k = 0; k <= 40; k++) {
					const st = at(i, k / 40);
					const c = `${f(X(st.V))} ${f(Y(P(st)))}`;
					d += `${k ? 'L' : 'M'}${c} `;
					all += `${all ? 'L' : 'M'}${c} `;
				}
				sg.setAttribute('d', d);
			});
			area.setAttribute('d', all + 'Z');
			nums.replaceChildren();
			[0, 1, 2, 3].forEach((i) => {
				const st = at(i, 0);
				const dx = i === 0 ? -11 : i === 3 ? -9 : i === 2 ? 5 : 7;
				const dy = i === 0 ? 12 : i === 2 ? -5 : i === 1 ? -6 : 12;
				nums.append(el('text', { class: 't-strong', x: f(X(st.V) + dx), y: f(Y(P(st)) + dy) }, String(i + 1)));
			});
			const Q1 = nuR * T1 * L2;
			const Q2 = nuR * T2 * L2;
			$('[data-t1out]').textContent = `${T1}\u00a0К`;
			$('[data-t2out]').textContent = `${T2}\u00a0К`;
			$('[data-q1]').textContent = `${fmt(Q1, 1)}\u00a0Дж`;
			$('[data-q2]').textContent = `${fmt(Q2, 1)}\u00a0Дж`;
			$('[data-a]').textContent = `${fmt(Q1 - Q2, 1)}\u00a0Дж`;
			$('[data-eta]').textContent = `${fmtTrim((100 * (Q1 - Q2)) / Q1 + 1e-9, 1)}\u00a0%`;
			$('[data-etat]').textContent = `${fmtTrim((100 * (T1 - T2)) / T1 + 1e-9, 1)}\u00a0%`;
		};
		t1.addEventListener('input', rebuild);
		t2.addEventListener('input', rebuild);
		rebuild();
		const names = [
			'1→2: на нагревателе газ расширяется при T₁ и получает теплоту Q₁.',
			'2→3: на теплоизоляции газ расширяется и охлаждается до T₂.',
			'3→4: на холодильнике газ сжимают при T₂, он отдаёт теплоту |Q₂|.',
			'4→1: на теплоизоляции газ сжимают, он нагревается до T₁.',
		];
		let t = 0;
		let shown = -1;
		loop(root, (dt) => {
			t = (t + dt) % (4 * STAGE);
			const i = Math.floor(t / STAGE);
			const s = (t - i * STAGE) / STAGE;
			const st = at(i, s);
			dot.setAttribute('cx', f(X(st.V)));
			dot.setAttribute('cy', f(Y(P(st))));
			const h = (st.V / Vmax) * 196 * 0.86;
			gas.setAttribute('y', f(204 - h));
			gas.setAttribute('height', f(h));
			piston.setAttribute('transform', `translate(0 ${f(204 - h)})`);
			$('[data-tgas]').textContent = `газ: ${fmtInt(st.T)}\u00a0К`;
			if (i !== shown) {
				shown = i;
				stand.classList.toggle('is-hot', i === 0);
				stand.classList.toggle('is-cold', i === 2);
				stand.classList.toggle('is-ins', i === 1 || i === 3);
				$('[data-standlab]').textContent = i === 0 ? 'нагреватель' : i === 2 ? 'холодильник' : 'теплоизоляция';
				$('[data-stage]').textContent = names[i];
			}
			return true;
		});
	}
</script>
