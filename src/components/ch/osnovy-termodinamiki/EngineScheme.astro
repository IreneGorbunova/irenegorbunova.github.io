---
/**
 * Scheme of a heat engine (the school scheme: heater → working body → cooler). The widths of the arrows are to scale:
 * of Q₁ = 100 Дж received from the heater the working body turns A′ = 40 Дж into work (the flywheel turns) and gives
 * |Q₂| = 60 Дж to the cooler, so η = 40 %, about as in the steam turbines of a power station. The dashes inside the
 * arrows run to show the direction in which energy goes.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow es not-content">
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 250" role="img" aria-label="Схема теплового двигателя: нагреватель отдаёт рабочему телу 100 джоулей, 40 из них превращаются в работу, 60 отдаются холодильнику">
			<rect class="es-hot" x="40" y="10" width="200" height="40" rx="6"></rect>
			<text class="t-strong" x="140" y="35" text-anchor="middle">нагреватель, <tspan class="t-i">T</tspan><tspan font-size="9" dy="3">1</tspan></text>
			<!-- Q1: 40 px wide = 100 Дж -->
			<path class="es-flow es-flow--q" d="M120 50 H160 V92 H120 Z"></path>
			<path class="es-dash" d="M140 50 V92"></path>
			<text class="t-i t-red" x="168" y="74">Q<tspan font-size="9" dy="3">1</tspan><tspan class="t-small" font-style="normal" dy="-3"> = 100 Дж</tspan></text>
			<!-- the working body: a cylinder with a piston -->
			<rect class="es-body" x="100" y="92" width="80" height="58" rx="6"></rect>
			<text class="t-small" x="140" y="114" text-anchor="middle">рабочее</text>
			<text class="t-small" x="140" y="128" text-anchor="middle">тело (газ)</text>
			<!-- A′: 16 px = 40 Дж, to the flywheel -->
			<path class="es-flow es-flow--a" d="M180 106 H262 V122 H180 Z"></path>
			<path class="es-dash es-dash--h" d="M180 114 H262"></path>
			<g transform="translate(286 114)">
				<g class="es-wheel">
					<circle class="es-wheelc" r="22"></circle>
					<path class="es-spoke" d="M-22 0 H22 M0 -22 V22 M-15 -15 L15 15 M15 -15 L-15 15"></path>
				</g>
				<circle class="es-hub" r="4"></circle>
			</g>
			<text class="t-i t-blue" x="196" y="100">A′<tspan class="t-small" font-style="normal"> = 40 Дж</tspan></text>
			<!-- Q2: 24 px = 60 Дж -->
			<path class="es-flow es-flow--c" d="M128 150 H152 V192 H128 Z"></path>
			<path class="es-dash" d="M140 150 V192"></path>
			<text class="t-i t-red" x="160" y="176">|Q<tspan font-size="9" dy="3">2</tspan><tspan dy="-3">|</tspan><tspan class="t-small" font-style="normal"> = 60 Дж</tspan></text>
			<rect class="es-cold" x="40" y="192" width="200" height="40" rx="6"></rect>
			<text class="t-strong" x="140" y="217" text-anchor="middle">холодильник, <tspan class="t-i">T</tspan><tspan font-size="9" dy="3">2</tspan></text>
			<text class="t-small" x="140" y="246" text-anchor="middle">например, окружающий воздух</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Рабочее тело получает от нагревателя теплоту <i>Q</i><sub>1</sub>, часть её превращает в работу <i>A</i>′, а остальное отдаёт холодильнику. Ширина стрелок — в масштабе: здесь КПД 40&nbsp;%.</figcaption>
</figure>

<style is:global>
	.es-hot {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-gray-5));
	}
	.es-cold {
		fill: color-mix(in oklab, var(--ig-vx) 60%, var(--sl-color-gray-5));
	}
	.es-body {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.es-flow--q {
		fill: color-mix(in oklab, var(--ig-vy) 55%, transparent);
	}
	.es-flow--a {
		fill: color-mix(in oklab, var(--ig-vx) 60%, transparent);
	}
	.es-flow--c {
		fill: color-mix(in oklab, var(--ig-vy) 35%, transparent);
	}
	.es-dash {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2;
		stroke-dasharray: 5 7;
		animation: es-run 0.8s linear infinite;
		opacity: 0.8;
	}
	@keyframes es-run {
		to {
			stroke-dashoffset: -12;
		}
	}
	.es-wheel {
		animation: es-turn 3s linear infinite;
	}
	@keyframes es-turn {
		to {
			transform: rotate(360deg);
		}
	}
	.es-wheelc {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 4;
	}
	.es-spoke {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.es-hub {
		fill: var(--sl-color-gray-1);
	}
</style>
