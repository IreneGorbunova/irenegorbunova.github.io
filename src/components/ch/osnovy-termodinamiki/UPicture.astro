---
/**
 * Picture to «Внутренняя энергия идеального газа». The same monatomic gas (helium, 0,040 моль: 1 л at 100 кПа and
 * 300 К) in two equal closed vessels, at 300 К and at 600 К. The molecules are points that fly straight and bounce off
 * the walls (no attraction, no collisions with each other — the ideal gas). Every speed on the right is √2 ≈ 1,41
 * times larger, so the kinetic energy of every molecule, and the sum of them, U = 3/2·νRT, is twice as large:
 * 150 Дж and 300 Дж (the gold bars, to scale). The speeds are slowed down about ten billion times.
 */
import G7Styles from '../g7/G7Styles.astro';

const boxes = [
	{ x0: 22, T: 300, U: 150, k: 1 },
	{ x0: 196, T: 600, U: 300, k: Math.SQRT2 },
];
---

<G7Styles />
<figure class="g7 g7--pic up not-content" data-upic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 196" role="img" aria-label="Один и тот же газ в двух сосудах при 300 и 600 кельвинах. Во втором молекулы движутся быстрее, и внутренняя энергия газа вдвое больше: 150 и 300 джоулей">
			{boxes.map((b) => (
				<g data-box data-k={b.k} data-x0={b.x0}>
					<rect class="up-box" x={b.x0 - 3} y="21" width="148" height="104" rx="4" />
					<g data-mols />
					<text class="t-title" x={b.x0 + 71} y="144" text-anchor="middle">
						<tspan class="t-i">T</tspan> = {b.T}&nbsp;К
					</text>
					<rect class="up-bar" x={b.x0} y="156" width={(b.U / 300) * 142} height="12" rx="3" />
					<text x={b.x0} y="186">
						<tspan class="t-i">U</tspan> = {b.U}&nbsp;Дж
					</text>
				</g>
			))}
		</svg>
	</div>
	<figcaption class="g7__caption">Один и тот же газ при 300 и 600&nbsp;К. При вдвое большей абсолютной температуре кинетическая энергия каждой молекулы вдвое больше — и внутренняя энергия газа тоже (скорости молекул замедлены в миллиарды раз).</figcaption>
</figure>

<style is:global>
	.up-box {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.up-mol {
		fill: var(--g7-blue);
	}
	.up-bar {
		fill: var(--g7-gold);
	}
</style>

<script>
	import { el, loop, rng } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-upic]')) {
		const sets = [...root.querySelectorAll<SVGGElement>('[data-box]')].map((box) => {
			const k = +box.dataset.k!;
			const x0 = +box.dataset.x0!;
			const rnd = rng(3); // the same start for both vessels
			const g = box.querySelector<SVGGElement>('[data-mols]')!;
			return Array.from({ length: 16 }, () => {
				const a = rnd() * 2 * Math.PI;
				const v = (30 + rnd() * 30) * k;
				const c = el('circle', { class: 'up-mol', r: 3 });
				g.append(c);
				return { c, x: 4 + rnd() * 134, y: 4 + rnd() * 96, vx: v * Math.cos(a), vy: v * Math.sin(a), x0 };
			});
		});
		loop(root, (dt) => {
			for (const ms of sets)
				for (const m of ms) {
					m.x += m.vx * dt;
					m.y += m.vy * dt;
					if (m.x < 3 || m.x > 139) (m.vx = -m.vx), (m.x = Math.min(139, Math.max(3, m.x)));
					if (m.y < 3 || m.y > 97) (m.vy = -m.vy), (m.y = Math.min(97, Math.max(3, m.y)));
					m.c.setAttribute('cx', (m.x0 + m.x).toFixed(1));
					m.c.setAttribute('cy', (24 + m.y).toFixed(1));
				}
			return true;
		});
	}
</script>
