---
/**
 * Interactive picture «Зачем двигателю холодильник» (section «Тепловые двигатели»). The working body: a monatomic ideal
 * gas with νR = 1/3 Дж/К (ν = 0,0401 моль, as in FirstLawLab), so p·V = T/3 (p in кПа, V in л, T in К; 1 кПа·л = 1 Дж).
 * A cylinder with a piston stands on the heater plate (T₁ = 500 К) or on the cooler plate (T₂ = 300 К).
 *   «Сжимать на нагревателе»: the gas expands from 1 to 3 л on the isotherm 500 К (p = 166,7 → 55,6 кПа) and is pushed
 *     back on the same isotherm: the work when expanding +500/3·ln 3 = +183,1 Дж, when compressed −183,1 Дж, per cycle 0.
 *   «Сжимать на холодильнике»: the same expansion (+183,1 Дж); the cylinder moves to the cooler, the gas cools at 3 л
 *     to 300 К (p → 33,3 кПа); it is compressed from 3 to 1 л at 300 К (p up to 100 кПа): −100·ln 3 = −109,9 Дж; back
 *     on the heater it warms at 1 л to 500 К. Per cycle +73,2 Дж = the area inside the loop.
 * The readouts follow the formulas at every moment and show whole joules (+183, −183, 0; +183, −110, +73). The area
 * under the expansion is filled blue, the area under the compression hatched over it; at the end of the second cycle
 * the loop is filled brighter. Red arrows: heat into the gas (up) or out of it (down) at the plate. No η here (CarnotLab
 * further down gives it). The graph: p from 0 to 200 кПа (0,9 px per кПа), V from 0 to 3,5 л (50 px per liter); the
 * cylinder's gas column 40 px per liter. One cycle lasts 7,4 с (compressed on the heater) or 8,6 с (on the cooler) and repeats; slowed down.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = `cyp${Math.random().toString(36).slice(2, 8)}`;
const X0 = 170;
const Y0 = 210;
const X = (V: number) => X0 + V * 50;
const Y = (p: number) => Y0 - p * 0.9;
const iso = (T: number) =>
	Array.from({ length: 61 }, (_, k) => {
		const V = 1 + (2 * k) / 60;
		return `${k ? 'L' : 'M'}${X(V).toFixed(1)} ${Y(T / 3 / V).toFixed(1)}`;
	}).join(' ');
const PB = 214; // the bottom of the cylinder
---

<G7Styles />
<figure class="g7 g7--wide cyp not-content" data-cycle>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 272" role="img" aria-label="Цилиндр с газом на нагревателе или на холодильнике и график давления от объёма. Если сжимать газ горячим, работа за цикл равна нулю; если сжимать охлаждённым, она положительна и равна площади внутри цикла">
			<defs>
				<pattern id={`${uid}-h`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
					<line x1="0" y1="0" x2="0" y2="6" class="cyp-hatch-ln"></line>
				</pattern>
			</defs>
			<!-- the plates -->
			<rect class="cyp-plate cyp-plate--hot" data-hotp x="10" y={PB + 6} width="52" height="8" rx="2"></rect>
			<rect class="cyp-plate cyp-plate--cold" data-coldp x="94" y={PB + 6} width="52" height="8" rx="2"></rect>
			<text class="t-small cyp-s" x="36" y={PB + 27} text-anchor="middle">нагреватель</text>
			<!-- the cooler's labels sit one row lower, so the two names never read as one phrase on a phone -->
			<text class="t-small cyp-s" x="120" y={PB + 47} text-anchor="middle">холодильник</text>
			<text class="t-small cyp-s" x="36" y={PB + 38} text-anchor="middle">500 К</text>
			<text class="t-small cyp-s" x="120" y={PB + 58} text-anchor="middle">300 К</text>
			<!-- the cylinder (moves between the plates) -->
			<g data-cyl>
				<path class="cyp-wall" d={`M-22 ${PB - 128} V${PB} H22 V${PB - 128}`}></path>
				<rect class="cyp-gas" data-gas x="-20" width="40"></rect>
				<rect class="cyp-tint" data-tint x="-20" width="40"></rect>
				<g data-piston>
					<rect class="cyp-piston" x="-20" y="-7" width="40" height="7"></rect>
					<rect class="cyp-rod" x="-3.5" y="-26" width="7" height="19"></rect>
				</g>
				<g data-q>
					<line class="cyp-q" data-qline x1="0" x2="0"></line>
					<path class="cyp-q-head" data-qhead d=""></path>
				</g>
			</g>
			<!-- the graph -->
			<g class="cyp-grid">
				{[50, 100, 150, 200].map((p) => <line x1={X0} y1={Y(p)} x2={X(3.5)} y2={Y(p)}></line>)}
				{[1, 2, 3].map((V) => <line x1={X(V)} y1={Y(200)} x2={X(V)} y2={Y0}></line>)}
			</g>
			{[50, 100, 150, 200].map((p) => <text class="t-small cyp-s" x={X0 - 5} y={Y(p) + 4} text-anchor="end">{p}</text>)}
			{[1, 2, 3].map((V) => <text class="t-small cyp-s" x={X(V)} y={Y0 + 14} text-anchor="middle">{V}</text>)}
			<path class="cyp-under" data-under d=""></path>
			<path class="cyp-hatch" data-hatch d="" fill={`url(#${uid}-h)`}></path>
			<path class="cyp-loop" data-loop d=""></path>
			<path class="cyp-iso" data-iso1 d={iso(500)}></path>
			<path class="cyp-iso" data-iso2 d={iso(300)}></path>
			<path class="cyp-done" data-done d=""></path>
			<path class="cyp-axis" d={`M${X0} ${Y(200) - 14} V${Y0} H${X(3.5) + 6}`}></path>
			<path class="cyp-axis-head" d={`M${X0 - 3.5} ${Y(200) - 10} L${X0} ${Y(200) - 18} L${X0 + 3.5} ${Y(200) - 10} Z M${X(3.5) + 2} ${Y0 - 3.5} L${X(3.5) + 10} ${Y0} L${X(3.5) + 2} ${Y0 + 3.5} Z`}></path>
			<text class="t-i" x={X0 + 7} y={Y(200) - 8}>p<tspan class="t-small cyp-s" font-style="normal">, кПа</tspan></text>
			<text class="t-i" x="358" y={Y0 - 8} text-anchor="end">V<tspan class="t-small cyp-s" font-style="normal">, л</tspan></text>
			<text class="t-small cyp-s cyp-tl" x={X(3) + 6} y={Y(500 / 9) + 4}>500 К</text>
			<text class="t-small cyp-s cyp-tl" data-tl2 x={X(3) + 6} y={Y(100 / 3) + 4}>300 К</text>
			<circle class="cyp-dot" data-dot r="4.5"></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__seg cyp-seg" data-mode>
				<button type="button" class="g7__btn" aria-pressed="true" data-m="hot">Сжимать на нагревателе</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-m="cold">Сжимать на холодильнике</button>
			</div>
			<ul class="g7__read">
				<li><span>работа газа при расширении</span> <b data-a1></b></li>
				<li><span>работа газа при сжатии</span> <b data-a2></b></li>
				<li class="is-key"><span>работа газа за цикл</span> <b data-a></b></li>
			</ul>
			<p class="g7__note" data-step></p>
		</div>
	</div>
	<figcaption class="g7__caption">Расширяется газ горячим, а сжимать его выгодно холодным: при меньшем давлении на сжатие уходит меньше работы. Разница — площадь внутри цикла — и есть работа двигателя за цикл. Одноатомный газ, 0,04&nbsp;моль; процессы замедлены.</figcaption>
</figure>

<style is:global>
	.cyp-plate--hot {
		fill: color-mix(in oklab, var(--g7-red) 45%, var(--sl-color-gray-4));
	}
	.cyp-plate--cold {
		fill: color-mix(in oklab, var(--g7-blue) 45%, var(--sl-color-gray-4));
	}
	.cyp-plate.is-on.cyp-plate--hot {
		fill: var(--g7-red);
	}
	.cyp-plate.is-on.cyp-plate--cold {
		fill: var(--g7-blue);
	}
	.cyp-wall {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.cyp-gas {
		fill: color-mix(in oklab, var(--ig-vx) 14%, transparent);
	}
	.cyp-tint {
		fill: var(--g7-red);
	}
	.cyp-tint.is-cold {
		fill: var(--g7-blue);
	}
	.cyp-piston,
	.cyp-rod {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.cyp-q {
		stroke: var(--g7-red);
		stroke-width: 3;
	}
	.cyp-q-head {
		fill: var(--g7-red);
	}
	.cyp-grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.cyp-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.cyp-axis-head {
		fill: var(--sl-color-gray-2);
	}
	.cyp-iso {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.cyp-under {
		fill: color-mix(in oklab, var(--g7-blue) 32%, transparent);
	}
	.cyp-hatch-ln {
		stroke: var(--g7-blue);
		stroke-width: 2.2;
	}
	.cyp-hatch {
		stroke: none;
	}
	.cyp-loop {
		fill: color-mix(in oklab, var(--g7-blue) 70%, transparent);
		stroke: var(--g7-blue);
		stroke-width: 1;
	}
	.cyp-done {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.cyp-dot {
		fill: var(--g7-blue);
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
	}
	.g7__svg .cyp-tl {
		fill: var(--sl-color-gray-2);
	}
	.cyp-seg .g7__btn {
		flex-basis: 100%;
		text-align: left;
	}
	.cyp-seg .g7__btn + .g7__btn {
		border-left: 0;
		border-top: 1px solid var(--sl-color-gray-4);
	}
	@media (max-width: 40rem) {
		.g7__svg .cyp-s {
			font-size: 12.5px;
		}
	}
</style>

<script>
	import { fmtInt, loop, segment, ease } from '../g7/kit';

	const X = (V: number) => 170 + V * 50;
	const Y = (p: number) => 210 - p * 0.9;
	const PB = 214;
	const PX = 40; // px per liter of the gas column
	const HOT_X = 36;
	const COLD_X = 120;
	type Phase = { k: 'wait' | 'exp' | 'cmp' | 'move' | 'heat' | 'cool' | 'hold'; d: number; T?: number; to?: number };
	const PLAN: Record<string, Phase[]> = {
		hot: [
			{ k: 'wait', d: 0.4 },
			{ k: 'exp', d: 2.2, T: 500 },
			{ k: 'wait', d: 0.4 },
			{ k: 'cmp', d: 2.2, T: 500 },
			{ k: 'hold', d: 2.2 },
		],
		cold: [
			{ k: 'wait', d: 0.4 },
			{ k: 'exp', d: 2.2, T: 500 },
			{ k: 'move', d: 0.6, to: COLD_X },
			{ k: 'cool', d: 1.0 },
			{ k: 'cmp', d: 1.8, T: 300 },
			{ k: 'move', d: 0.6, to: HOT_X },
			{ k: 'heat', d: 0.8 },
			{ k: 'hold', d: 1.2 },
		],
	};
	const W = (T: number, Va: number, Vb: number) => (T / 3) * Math.log(Vb / Va); // Дж
	const sgn = (v: number) => (Math.round(v) > 0 ? `+${fmtInt(v)}` : fmtInt(v));
	const curve = (T: number, Va: number, Vb: number) => {
		let d = '';
		for (let k = 0; k <= 40; k++) {
			const V = Va + ((Vb - Va) * k) / 40;
			d += `${k ? 'L' : 'M'}${X(V).toFixed(1)} ${Y(T / 3 / V).toFixed(1)} `;
		}
		return d;
	};
	const under = (T: number, Va: number, Vb: number) => (Math.abs(Vb - Va) < 1e-4 ? '' : `${curve(T, Va, Vb)}L${X(Vb).toFixed(1)} ${Y(0)} L${X(Va).toFixed(1)} ${Y(0)} Z`);

	for (const root of document.querySelectorAll<HTMLElement>('[data-cycle]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const cyl = $<SVGGElement>('[data-cyl]');
		const gas = $<SVGRectElement>('[data-gas]');
		const tint = $<SVGRectElement>('[data-tint]');
		const piston = $<SVGGElement>('[data-piston]');
		const qG = $<SVGGElement>('[data-q]');
		const qLine = $<SVGLineElement>('[data-qline]');
		const qHead = $<SVGPathElement>('[data-qhead]');
		const hotp = $<SVGRectElement>('[data-hotp]');
		const coldp = $<SVGRectElement>('[data-coldp]');
		const underP = $<SVGPathElement>('[data-under]');
		const hatch = $<SVGPathElement>('[data-hatch]');
		const loopP = $<SVGPathElement>('[data-loop]');
		const done = $<SVGPathElement>('[data-done]');
		const dot = $<SVGCircleElement>('[data-dot]');
		const iso2 = $<SVGPathElement>('[data-iso2]');
		const tl2 = $<SVGTextElement>('[data-tl2]');
		let mode = 'hot';
		let t = 0;
		const draw = () => {
			const plan = PLAN[mode];
			let s = t;
			let V = 1;
			let T = 500;
			let x = HOT_X;
			let A1 = 0;
			let A2 = 0;
			let q = 0; // +1 heat in, −1 heat out
			let expDone = false;
			let cmpFrom = 3;
			let cmpT = 500;
			let cmpTo = 3; // the compression has reached this volume
			let path = '';
			let note = '';
			for (const ph of plan) {
				const u = Math.min(1, Math.max(0, s / ph.d));
				const e = ease(u);
				const active = s >= 0 && s < ph.d;
				if (ph.k === 'exp') {
					V = 1 + 2 * (s >= 0 ? e : 0);
					A1 = W(500, 1, V);
					if (s >= 0) path += curve(500, 1, V);
					if (active) (q = 1), (note = 'Газ получает теплоту от нагревателя и, расширяясь, совершает работу.');
					expDone = s >= ph.d;
				} else if (ph.k === 'cmp' && s >= 0) {
					V = 3 - 2 * e;
					cmpT = ph.T!;
					cmpTo = V;
					A2 = -W(ph.T!, V, 3);
					path += curve(ph.T!, 3, V).replace(/^M/, 'L');
					T = ph.T!;
					if (active) (q = -1), (note = ph.T === 500 ? 'Газ сжимают таким же горячим: давление велико, и на сжатие уходит вся полученная работа.' : 'Газ сжимают холодным: давление меньше, и на сжатие уходит меньше работы.');
				} else if (ph.k === 'move' && s >= 0) {
					const from = ph.to === COLD_X ? HOT_X : COLD_X;
					x = from + (ph.to! - from) * e;
					if (active) note = ph.to === COLD_X ? 'Цилиндр переносят на холодильник.' : 'Цилиндр возвращают на нагреватель.';
				} else if (ph.k === 'cool' && s >= 0) {
					T = 500 - 200 * e;
					x = COLD_X;
					path += `L${X(3).toFixed(1)} ${Y(T / 9).toFixed(1)} `;
					if (active) (q = -1), (note = 'Газ остывает при постоянном объёме и отдаёт теплоту холодильнику.');
				} else if (ph.k === 'heat' && s >= 0) {
					T = 300 + 200 * e;
					x = HOT_X;
					path += `L${X(1).toFixed(1)} ${Y(T / 3).toFixed(1)} `;
					if (active) (q = 1), (note = 'Газ нагревается при постоянном объёме: цикл замкнулся.');
				} else if (ph.k === 'hold' && s >= 0) {
					note = mode === 'hot' ? 'За цикл газ не совершил работы: площадь под сжатием закрыла всю площадь под расширением.' : 'За цикл газ совершил работу: она равна площади внутри цикла.';
				}
				if (ph.k === 'exp' && s >= 0) T = 500;
				s -= ph.d;
			}
			void expDone;
			// the graph
			underP.setAttribute('d', under(500, 1, V > 1 && A2 === 0 ? V : 3));
			if (A1 === 0) underP.setAttribute('d', '');
			hatch.setAttribute('d', A2 !== 0 ? under(cmpT, cmpTo, 3) : '');
			const closed = mode === 'cold' && t >= plan.slice(0, -1).reduce((a, p) => a + p.d, 0);
			loopP.setAttribute('d', closed ? `${curve(500, 1, 3)}${curve(300, 3, 1).replace(/^M/, 'L')}Z` : '');
			done.setAttribute('d', path);
			const pNow = T / 3 / V;
			dot.setAttribute('cx', X(V).toFixed(1));
			dot.setAttribute('cy', Y(pNow).toFixed(1));
			iso2.style.display = mode === 'cold' ? '' : 'none';
			tl2.style.display = mode === 'cold' ? '' : 'none';
			// the cylinder
			cyl.setAttribute('transform', `translate(${x.toFixed(1)} 0)`);
			const h = PX * V;
			for (const r of [gas, tint]) {
				r.setAttribute('y', (PB - h).toFixed(1));
				r.setAttribute('height', h.toFixed(1));
			}
			tint.classList.toggle('is-cold', T < 400);
			tint.setAttribute('opacity', (0.12 + 0.2 * (Math.abs(T - 400) / 100)).toFixed(2));
			piston.setAttribute('transform', `translate(0 ${(PB - h).toFixed(1)})`);
			const onHot = Math.abs(x - HOT_X) < 1;
			const onCold = Math.abs(x - COLD_X) < 1;
			hotp.classList.toggle('is-on', onHot && q !== 0);
			coldp.classList.toggle('is-on', onCold && q !== 0);
			qG.style.display = q ? '' : 'none';
			qLine.setAttribute('x1', '-29');
			qLine.setAttribute('x2', '-29');
			qLine.setAttribute('y1', String(q > 0 ? PB + 4 : PB - 18));
			qLine.setAttribute('y2', String(q > 0 ? PB - 14 : PB + 0));
			qHead.setAttribute('d', q > 0 ? `M-34 ${PB - 12} L-29 ${PB - 22} L-24 ${PB - 12} Z` : `M-34 ${PB - 2} L-29 ${PB + 6} L-24 ${PB - 2} Z`);
			$('[data-a1]').textContent = `${sgn(A1)} Дж`;
			$('[data-a2]').textContent = `${sgn(A2)} Дж`;
			$('[data-a]').textContent = `${sgn(A1 + A2)} Дж`;
			$('[data-step]').textContent = note || 'Газ на нагревателе: 1\u00a0л, 500\u00a0К.';
		};
		segment($('[data-mode]'), (b) => {
			mode = b.dataset.m!;
			t = 0;
			draw();
		});
		loop(root, (dt) => {
			const total = PLAN[mode].reduce((a, p) => a + p.d, 0);
			t = (t + dt) % total;
			draw();
			return true;
		});
		draw();
	}
</script>
