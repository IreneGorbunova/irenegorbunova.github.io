---
/**
 * Picture to «Время полёта и высота подъёма», after «Время полёта и высота зависят только от υ0y». Three balls leave
 * one point at the same moment with the same vertical projection υ0y = 9,8 м/с and the horizontal projections
 * υ0x = 0; 3; 6 м/с (υ0 = 9,8; 10,25; 11,49 м/с at 90°; 73,0°; 58,5° to the horizontal), g = 9,8 м/с². All three rise
 * H = υ0y²/(2g) = 4,9 м in 1 с and land together after 2 с, at 0; 6; 12 м. Real time (2 с), 25 px per м on both axes.
 * Every 0,2 с a ghost of each ball stays, the three joined by a thin horizontal dashed line: they are always at one
 * height. The start arrows (4 px per м/с) show the three initial velocities, gold, with their common vertical
 * projection υ0y in red.
 */
import BpPicStyles from './BpPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const f1 = (v: number) => v.toFixed(1);
const OX = 36;
const OY = 150;
const K = 25;
const VY = 9.8;
const G = 9.8;
const VXS = [0, 3, 6];
const A = 4;
const path = (vx: number) =>
	Array.from({ length: 41 }, (_, i) => {
		const t = (2 * i) / 40;
		return `${f1(OX + vx * t * K)} ${f1(OY - (VY * t - (G * t * t) / 2) * K)}`;
	}).join(' L ');
const MARKS = Array.from({ length: 11 }, (_, k) => 0.2 * k);
---

<BpPicStyles />
<figure class="bp-pic not-content" data-bpsame>
	<svg class="bp-pic__svg bp-pic__svg--wide" viewBox="0 0 360 172" role="img" aria-label="Три мяча брошены из одной точки одновременно с одинаковой вертикальной проекцией скорости и разными горизонтальными: 0, 3 и 6 метров в секунду. Все три в каждый момент на одной высоте, вместе поднимаются на 4,9 метра и вместе падают через 2 секунды">
		<defs>
			{
				['v', 'y', 'axis'].map((k) => (
					<marker id={`${uid}-${k}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth={k === 'axis' ? 7 : 5} markerHeight={k === 'axis' ? 7 : 5} orient="auto">
						<path class={`bp-head--${k}`} d="M0,0 L10,5 L0,10 z" />
					</marker>
				))
			}
		</defs>
		<line class="bp-axis" x1={OX} y1={OY} x2="352" y2={OY} marker-end={`url(#${uid}-axis)`}></line>
		<line class="bp-axis" x1={OX} y1={OY} x2={OX} y2="10" marker-end={`url(#${uid}-axis)`}></line>
		<text class="bp-math" x="342" y={OY - 8}>x</text>
		<text class="bp-math" x={OX - 18} y="20">y</text>
		<text class="bp-math" x={OX - 16} y={OY + 18}>O</text>
		{[2, 4, 6, 8, 10, 12].map((m) => <text x={OX + m * K} y={OY + 18} text-anchor="middle">{m} м</text>)}
		<line class="bp-dash" x1={OX} y1={f1(OY - 4.9 * K)} x2="346" y2={f1(OY - 4.9 * K)}></line>
		<text x="346" y={f1(OY - 4.9 * K - 6)} text-anchor="end"><tspan class="bp-math" style="font-size: 15px">H</tspan> = 4,9 м через 1 с</text>
		{VXS.map((vx) => <path class="bp-dash" style="stroke-dasharray: 1 3" d={`M ${path(vx)}`} />)}
		<g data-marks>
			{
				MARKS.map((t) => {
					const y = OY - (VY * t - (G * t * t) / 2) * K;
					return (
						<g style="opacity: 0">
							<line class="bp-dash" x1={OX} y1={f1(y)} x2={f1(OX + 6 * t * K)} y2={f1(y)} />
							{VXS.map((vx) => <circle class="bp-ghost" cx={f1(OX + vx * t * K)} cy={f1(y)} r="4.5" />)}
						</g>
					);
				})
			}
		</g>
		<!-- the start velocities -->
		{VXS.map((vx) => <line class="bp-vec bp-vec--v" style="stroke-width: 2" x1={OX} y1={OY} x2={f1(OX + vx * A * 0.93)} y2={f1(OY - VY * A * 0.93)} marker-end={`url(#${uid}-v)`} />)}
		<line class="bp-vec bp-vec--y" style="stroke-width: 1.6" x1={OX - 7} y1={OY} x2={OX - 7} y2={f1(OY - VY * A + 3)} marker-end={`url(#${uid}-y)`}></line>
		<g data-balls>{VXS.map(() => <circle class="bp-ball" r="5.5" cx={OX} cy={OY} />)}</g>
		<text class="bp-math bp-cy" x={OX - 10} y={OY - 18} text-anchor="end" style="font-size: 14px">υ<tspan class="bp-sub" dy="4">0y</tspan></text>
		{VXS.map((vx, k) => <text x={f1(OX + vx * 2 * K + (k === 0 ? 8 : k === 2 ? -4 : 0))} y={OY - 6} text-anchor={k === 0 ? 'start' : k === 2 ? 'end' : 'middle'}><tspan class="bp-math bp-cx" style="font-size: 14px">υ</tspan><tspan class="bp-sub bp-cx" dy="3">0x</tspan><tspan dy="-3"> = {vx}{vx ? ' м/с' : ''}</tspan></text>)}
	</svg>
	<div class="bp-pic__foot">
		<figcaption>Три мяча брошены одновременно с одинаковой <i>υ</i><sub>0<i>y</i></sub> = 9,8&nbsp;м/с и разными <i>υ</i><sub>0<i>x</i></sub>; отметки — через каждые 0,2&nbsp;с. В каждый момент мячи на одной высоте: все поднимаются на 4,9&nbsp;м и падают через 2&nbsp;с.</figcaption>
		<button type="button" class="bp-pic__again" data-again>Повторить</button>
	</div>
</figure>

<script>
	import { scene } from '@components/intro/scene';

	const f1 = (v: number) => v.toFixed(1);
	const OX = 36;
	const OY = 150;
	const K = 25;
	const VY = 9.8;
	const G = 9.8;
	const VXS = [0, 3, 6];
	const T = 2;

	for (const root of document.querySelectorAll<HTMLElement>('[data-bpsame]')) {
		const balls = [...root.querySelectorAll<SVGCircleElement>('[data-balls] circle')];
		const marks = [...root.querySelectorAll<SVGGElement>('[data-marks] > g')];
		scene(root, T, (s) => {
			const t = s * T;
			const y = OY - (VY * t - (G * t * t) / 2) * K;
			balls.forEach((b, k) => {
				b.setAttribute('cx', f1(OX + VXS[k] * t * K));
				b.setAttribute('cy', f1(y));
			});
			marks.forEach((m, k) => (m.style.opacity = t >= 0.2 * k - 1e-6 ? '1' : '0'));
		});
	}
</script>
