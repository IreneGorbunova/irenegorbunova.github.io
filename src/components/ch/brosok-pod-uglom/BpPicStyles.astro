---
/** Frame of the explanatory pictures of «Движение тела, брошенного под углом к горизонту» (caption, «Повторить»). Renders nothing. */
---

<style is:global>
	.bp-pic {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.bp-pic__svg {
		display: block;
		width: 100%;
		max-width: 34rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.bp-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.bp-pic .bp-math {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 17px;
		fill: var(--sl-color-gray-1);
	}
	.bp-pic .bp-sub {
		font-family: var(--ig-font-math);
		font-size: 12px;
	}
	.bp-pic .bp-up {
		font-family: var(--__sl-font);
		font-style: normal;
	}
	.bp-pic .bp-cx {
		fill: var(--ig-vx);
	}
	.bp-pic .bp-cy {
		fill: var(--ig-vy);
	}
	.bp-pic .bp-cv {
		fill: var(--ig-v);
	}
	.bp-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		fill: none;
	}
	.bp-path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	.bp-dash {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.bp-vec {
		stroke-width: 2.6;
		stroke-linecap: round;
		fill: none;
	}
	.bp-vec--v {
		stroke: var(--ig-v);
	}
	.bp-vec--x {
		stroke: var(--ig-vx);
	}
	.bp-vec--y {
		stroke: var(--ig-vy);
	}
	.bp-head--v {
		fill: var(--ig-v);
	}
	.bp-head--x {
		fill: var(--ig-vx);
	}
	.bp-head--y {
		fill: var(--ig-vy);
	}
	.bp-head--axis {
		fill: var(--sl-color-gray-3);
	}
	.bp-ball {
		fill: var(--ig-v);
	}
	.bp-ghost {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.2;
		opacity: 0.7;
	}
	.bp-tick--x {
		fill: var(--ig-vx);
	}
	.bp-tick--y {
		fill: var(--ig-vy);
	}
	.bp-ovl {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.bp-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.bp-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.bp-pic__foot figcaption i {
		font-family: var(--ig-font-math);
	}
	.bp-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.bp-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
</style>
