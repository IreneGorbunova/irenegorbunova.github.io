---
/**
 * Two short looping opening scenes of «Движение тела, брошенного под углом к горизонту». No formulas in the pictures;
 * the captions' popovers explain.
 * Fountain: five jets leave one nozzle at the water surface with the same speed, 5 m/s, at 15°, 30°, 45°, 60° and 75°
 *   (105 px per m, equal scales on both axes). They switch on one after another. Every drop flies on its own parabola
 *   (no air): x = υ0·cos α·τ, y = υ0·sin α·τ − gτ²/2, and moves along it in real time. The 45° jet reaches farthest
 *   (2,55 m), the 30° and 60° jets meet the water at one spot (2,21 m), and so do the 15° and 75° jets (1,28 m).
 * Basketball: a free throw. The ball leaves the hand 2,1 m above the floor at 52° and passes the centre of the ring
 *   (3,05 m high, 4,2 m farther) on the way down; υ0 = 7,18 m/s from the parabola through both points, flight 0,95 s,
 *   top 3,73 m (48 px per m). Slowed down twice. Every 0,1 s a ghost of the ball stays, with its marks on the floor
 *   (equally spaced, blue) and on a vertical line at the left (closer together near the top, red), the colours of
 *   υx and υy in the models. The net stops the ball; it drops out and fades.
 * Plays only while visible.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gPool = `bpi-pool-${uid}`;
const gBall = `bpi-ball-${uid}`;

// Fountain: the water surface at y = 196, the nozzle at x = 46
const SURF = 196;
const NX = 46;
const KF = 105;
const V0 = 5;
const G = 9.8;
const JETS = [15, 30, 45, 60, 75];
const land = (a: number) => NX + ((V0 * V0 * Math.sin((2 * a * Math.PI) / 180)) / G) * KF;
const SPOTS = [
	{ x: land(15), y: 216, text: '15° и 75°', anchor: 'middle' },
	{ x: land(30), y: 234, text: '30° и 60°', anchor: 'middle' },
	{ x: land(45), y: 216, text: '45°', anchor: 'start' },
];

// Basketball: the floor at y = 228, 48 px per m; the hand at (70, 127), the ring 4,2 m farther and 3,05 m high
const FLOOR = 228;
const KB = 48;
const HX = 70;
const RX = HX + 4.2 * KB;
const RY = FLOOR - 3.05 * KB;
const BOARD = RX + (0.225 + 0.15) * KB;
const GHOSTS = 10;
---

<IntroFrame data-bpintro>
	<div class="intro__card" data-scene="fountain">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Фонтан: из одного сопла одна за другой бьют пять струй с одинаковой скоростью под углами 15, 30, 45, 60 и 75 градусов к горизонту. Дальше всех падает струя под углом 45 градусов; струи под углами 30 и 60 градусов падают в одно место, струи под углами 15 и 75 градусов — тоже">
			<defs>
				<linearGradient id={gPool} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" style="stop-color: var(--ig-vx); stop-opacity: 0.3"></stop>
					<stop offset="1" style="stop-color: var(--ig-vx); stop-opacity: 0.55"></stop>
				</linearGradient>
			</defs>
			<rect class="bpi-sky" x="0" y="0" width="360" height={SURF + 2}></rect>
			<!-- trees and a hedge behind the fountain -->
			<path class="bpi-hedge" d={`M 0 ${SURF} L 0 160 Q 30 148 60 158 Q 92 144 126 156 Q 160 146 196 157 Q 232 145 266 156 Q 300 147 330 157 Q 348 151 360 155 L 360 ${SURF} Z`}></path>
			<!-- the jets -->
			<g data-jets>
				{JETS.map((a) => <path class={`bpi-jet${a === 45 ? ' bpi-jet--best' : ''}`} d="" data-a={a} />)}
			</g>
			<g class="bpi-drops" data-fdrops>
				{JETS.map(() => Array.from({ length: 4 }, () => <circle r="1.7" />))}
			</g>
			<!-- the pool -->
			<rect x="0" y={SURF} width="360" height={226 - SURF} fill={`url(#${gPool})`}></rect>
			<path class="bpi-surface" d="" data-fsurf></path>
			<g data-rings>
				{JETS.map(() => <ellipse class="bpi-ring" rx="0" ry="0" />)}
			</g>
			<rect class="bpi-rim" x="0" y="222" width="360" height="18"></rect>
			<!-- the nozzle -->
			<path class="bpi-nozzle" d={`M ${NX - 7} ${SURF + 4} L ${NX - 5} ${SURF - 3} Q ${NX} ${SURF - 7} ${NX + 5} ${SURF - 3} L ${NX + 7} ${SURF + 4} Z`}></path>
			<!-- where the jets fall -->
			{
				SPOTS.map((s, k) => (
					<g class="bpi-spot" data-spot={k}>
						<line x1={s.x} y1={SURF + 3} x2={s.x} y2={s.y - 10} />
						<text x={s.anchor === 'start' ? s.x - 6 : s.x} y={s.y} text-anchor={s.anchor}>{s.text}</text>
					</g>
				))
			}
		</svg>
		<div class="intro__foot">
			<p>Струи фонтана вылетают с одинаковой скоростью, но под разными углами. Дальше всех бьёт <More term="струя под углом 45°">Каждая капля летит как брошенный камешек. Капли крутой струи поднимаются высоко, но вперёд движутся медленно. Капли пологой струи быстро движутся вперёд, но скоро падают. Дальше всего улетают капли, вылетевшие под углом 45°, а углы 30° и 60° дают одну и ту же дальность. Подробнее — в разделе <a href="#дальность-полёта">«Дальность полёта»</a>.</More>, а струи под углами 30° и 60° падают в одно место.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="ball">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Штрафной бросок в баскетболе, замедленно. Через каждые 0,1 секунды остаётся отпечаток мяча. Отметки отпечатков на полу идут на равных расстояниях, а отметки на вертикальной линии слева у верхней точки сближаются">
			<defs>
				<clipPath id={gBall}>
					<circle cx="0" cy="0" r="6"></circle>
				</clipPath>
			</defs>
			<rect class="bpi-hall" x="0" y="0" width="360" height={FLOOR}></rect>
			<rect class="bpi-floor" x="0" y={FLOOR} width="360" height={240 - FLOOR}></rect>
			<line class="bpi-floorline" x1="0" y1={FLOOR} x2="360" y2={FLOOR}></line>
			<text class="bpi-note" x="352" y="16" text-anchor="end">замедлено в 2 раза</text>
			<!-- the stand: the pole, the arm, the board, the ring and the net -->
			<rect class="bpi-pole" x="334" y="52" width="7" height={FLOOR - 52}></rect>
			<path class="bpi-arm" d={`M ${BOARD + 3} 62 L 337 56 M ${BOARD + 3} 78 L 337 66`}></path>
			<rect class="bpi-board" x={BOARD} y={FLOOR - 3.95 * KB} width="3.5" height={1.05 * KB}></rect>
			<path class="bpi-net" d="" data-net></path>
			<!-- the marks: on the floor (horizontal motion) and on the vertical line (vertical motion) -->
			<line class="bpi-vline" x1="16" y1="34" x2="16" y2={FLOOR}></line>
			<g data-ghosts>
				{
					Array.from({ length: GHOSTS }, () => (
						<g class="bpi-ghost">
							<line class="bpi-guide" />
							<line class="bpi-guide" />
							<circle class="bpi-ghost-ball" r="6" />
							<circle class="bpi-tick bpi-tick--x" r="2.6" />
							<circle class="bpi-tick bpi-tick--y" r="2.6" />
						</g>
					))
				}
			</g>
			<!-- the player -->
			<g class="bpi-player">
				<path class="bpi-leg" d={`M 47 182 L 42 205 L 40 ${FLOOR - 2} M 51 182 L 56 205 L 59 ${FLOOR - 2}`}></path>
				<path class="bpi-shirt" d="M 41 150 L 58 150 L 56 186 L 42 186 Z"></path>
				<path class="bpi-skin-line" d={`M 56 152 L 64 140 L ${HX - 1} 131 M 43 153 L 54 142 L ${HX - 6} 131`}></path>
				<circle class="bpi-head" cx="48" cy="141" r="6.2"></circle>
			</g>
			<!-- the ball -->
			<g data-bball>
				<g clip-path={`url(#${gBall})`}>
					<circle class="bpi-bball" r="6"></circle>
					<g data-seams>
						<path class="bpi-seam" d="M -7 0 L 7 0 M 0 -7 L 0 7"></path>
						<path class="bpi-seam" d="M -4.5 -7 Q -1.5 0 -4.5 7 M 4.5 -7 Q 1.5 0 4.5 7"></path>
					</g>
				</g>
			</g>
			<!-- the ring in front of the ball -->
			<line class="bpi-hoopbar" x1={RX + 10.8} y1={RY} x2={BOARD} y2={RY}></line>
			<ellipse class="bpi-hoop" cx={RX} cy={RY} rx="10.8" ry="2.4"></ellipse>
		</svg>
		<div class="intro__foot">
			<p>Снимки летящего мяча через каждые 0,1&nbsp;с. По горизонтали мяч каждый раз смещается <More term="на одно и то же расстояние">По горизонтали на мяч почти ничего не действует (сопротивление воздуха мало), и он движется равномерно — как отметки на полу. По вертикали мяч движется как подброшенный вверх: сила тяжести сначала тормозит его, а потом разгоняет вниз, — отметки на линии слева у верхней точки сближаются. Подробнее — в разделе <a href="#два-движения-сразу">«Два движения сразу»</a>.</More>, а по вертикали сначала поднимается всё медленнее, потом опускается всё быстрее.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-bpintro] {
		--bpi-sky: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-6, #17181c));
		--bpi-hedge: color-mix(in oklab, hsl(120 40% 45%) 45%, var(--sl-color-gray-4));
		--bpi-stone: color-mix(in oklab, var(--ig-v) 18%, var(--sl-color-gray-4));
		--bpi-bronze: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-3));
		--bpi-water: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-white));
		--bpi-hall: color-mix(in srgb, var(--ig-v) 6%, var(--sl-color-gray-6, #17181c));
		--bpi-wood: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		--bpi-ball: color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy));
		--bpi-skin: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-2));
	}
	:root[data-theme='light'] [data-bpintro] {
		--bpi-sky: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-7, #fff));
		--bpi-hedge: color-mix(in oklab, hsl(120 40% 40%) 50%, var(--sl-color-gray-5));
		--bpi-stone: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-gray-5));
		--bpi-water: color-mix(in srgb, var(--ig-vx) 85%, var(--sl-color-white));
		--bpi-hall: color-mix(in srgb, var(--ig-v) 7%, var(--sl-color-gray-7, #fff));
		--bpi-wood: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-5));
		--bpi-skin: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
	}
	.bpi-sky {
		fill: var(--bpi-sky);
	}
	.bpi-hedge {
		fill: var(--bpi-hedge);
	}
	.bpi-rim {
		fill: var(--bpi-stone);
	}
	.bpi-surface {
		fill: none;
		stroke: var(--bpi-water);
		stroke-width: 1.6;
	}
	.bpi-jet {
		fill: none;
		stroke: var(--bpi-water);
		stroke-width: 2.4;
		stroke-linecap: round;
		opacity: 0.85;
	}
	.bpi-jet--best {
		stroke-width: 3.2;
		opacity: 1;
	}
	.bpi-drops circle {
		fill: var(--bpi-water);
	}
	.bpi-ring {
		fill: none;
		stroke: var(--bpi-water);
		stroke-width: 1.2;
	}
	.bpi-nozzle {
		fill: var(--bpi-bronze);
		stroke: color-mix(in oklab, var(--bpi-bronze) 60%, var(--sl-color-black));
		stroke-width: 0.8;
	}
	.bpi-spot {
		transition: opacity 0.4s;
	}
	.bpi-spot line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-dasharray: 2 2;
	}
	.bpi-spot text {
		font-size: 12.5px;
		fill: var(--sl-color-gray-1);
		paint-order: stroke fill;
		stroke: var(--bpi-stone);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	.bpi-hall {
		fill: var(--bpi-hall);
	}
	.bpi-floor {
		fill: var(--bpi-wood);
	}
	.bpi-floorline {
		stroke: color-mix(in oklab, var(--bpi-wood) 60%, var(--sl-color-black));
		stroke-width: 1;
	}
	.bpi-note {
		font-size: 11.5px;
		fill: var(--sl-color-gray-3);
	}
	.bpi-pole {
		fill: var(--sl-color-gray-4);
	}
	.bpi-arm {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 2.5;
	}
	.bpi-board {
		fill: var(--sl-color-gray-2);
	}
	.bpi-hoop {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
	}
	.bpi-hoopbar {
		stroke: var(--ig-vy);
		stroke-width: 2;
	}
	.bpi-net {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
		opacity: 0.8;
	}
	.bpi-vline {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.bpi-ghost-ball {
		fill: none;
		stroke: var(--bpi-ball);
		stroke-width: 1.4;
		opacity: 0.75;
	}
	.bpi-guide {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 1.5 2.5;
		opacity: 0.6;
	}
	.bpi-tick--x {
		fill: var(--ig-vx);
	}
	.bpi-tick--y {
		fill: var(--ig-vy);
	}
	.bpi-bball {
		fill: var(--bpi-ball);
	}
	.bpi-seam {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 0.8;
		opacity: 0.55;
	}
	.bpi-leg,
	.bpi-skin-line {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.bpi-leg {
		stroke: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-3));
		stroke-width: 5.5;
	}
	.bpi-skin-line {
		stroke: var(--bpi-skin);
		stroke-width: 4;
	}
	.bpi-shirt {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-4));
	}
	.bpi-head {
		fill: var(--bpi-skin);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const f1 = (v: number) => v.toFixed(1);
	const G = 9.8;
	const rad = (a: number) => (a * Math.PI) / 180;

	for (const root of document.querySelectorAll<HTMLElement>('[data-bpintro]')) {
		// Fountain: the jets switch on every 0,8 s; 4,6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="fountain"]')!;
			const SURF = 196;
			const NX = 46;
			const K = 105;
			const V0 = 5;
			const ON = 0.8;
			const RUN = 4.6;
			const jets = [...card.querySelectorAll<SVGPathElement>('[data-jets] path')];
			const drops = [...card.querySelectorAll<SVGCircleElement>('[data-fdrops] circle')];
			const rings = [...card.querySelectorAll<SVGEllipseElement>('[data-rings] ellipse')];
			const spots = [...card.querySelectorAll<SVGGElement>('[data-spot]')];
			const surf = card.querySelector<SVGPathElement>('[data-fsurf]')!;
			const J = jets.map((el, k) => {
				const a = rad(Number(el.dataset.a));
				const vx = V0 * Math.cos(a);
				const vy = V0 * Math.sin(a);
				return { el, vx, vy, T: (2 * vy) / G, on: k * ON };
			});
			const pos = (j: (typeof J)[number], tau: number) => [NX + j.vx * tau * K, SURF - (j.vy * tau - (G * tau * tau) / 2) * K];
			// a jet has reached the water when its first drop has landed
			const landed = (j: (typeof J)[number], t: number) => t - j.on >= j.T;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const now = performance.now() / 1000;
				J.forEach((j, k) => {
					const age = Math.min(t - j.on, j.T);
					if (age <= 0) {
						j.el.setAttribute('d', '');
						for (let i = 0; i < 4; i++) drops[4 * k + i].style.opacity = '0';
						rings[k].style.opacity = '0';
						return;
					}
					const n = Math.max(2, Math.ceil(age / 0.015));
					const pts: string[] = [];
					for (let i = 0; i <= n; i++) {
						const [px, py] = pos(j, (age * i) / n);
						pts.push(`${f1(px)} ${f1(py)}`);
					}
					j.el.setAttribute('d', `M ${pts.join(' L ')}`);
					// drops ride on the jet in real time
					for (let i = 0; i < 4; i++) {
						const d = drops[4 * k + i];
						const tau = (now + (i * j.T) / 4 + k * 0.17) % j.T;
						if (tau > age) {
							d.style.opacity = '0';
							continue;
						}
						const [px, py] = pos(j, tau);
						d.style.opacity = '0.95';
						d.setAttribute('cx', f1(px));
						d.setAttribute('cy', f1(py));
					}
					// rings where the jet meets the water
					if (landed(j, t)) {
						const ph = (now * 1.6 + k * 0.3) % 1;
						rings[k].style.opacity = (0.9 * (1 - ph)).toFixed(2);
						rings[k].setAttribute('cx', f1(NX + j.vx * j.T * K));
						rings[k].setAttribute('cy', String(SURF + 1));
						rings[k].setAttribute('rx', f1(3 + 9 * ph));
						rings[k].setAttribute('ry', f1(1 + 2.5 * ph));
					} else rings[k].style.opacity = '0';
				});
				// the labels: 15° and 75°, 30° and 60°, 45°
				const pairs = [
					[0, 4],
					[1, 3],
					[2, 2],
				];
				spots.forEach((s, k) => {
					s.style.opacity = landed(J[pairs[k][0]], t) && landed(J[pairs[k][1]], t) ? '1' : '0';
				});
				const p: string[] = [];
				for (let px = 0; px <= 360; px += 8) p.push(`${px} ${f1(SURF + 0.7 * Math.sin(px / 17 + now * 1.8))}`);
				surf.setAttribute('d', `M ${p.join(' L ')}`);
			});
		}

		// Basketball: released at 0,4 s of the run, slowed down twice; 3,4 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ball"]')!;
			const FLOOR = 228;
			const K = 48;
			const HX = 70;
			const H0 = 2.1;
			const DX = 4.2;
			const RING = 3.05;
			const A = rad(52);
			const V0 = Math.sqrt((G * DX * DX) / (2 * Math.cos(A) ** 2 * (DX * Math.tan(A) - (RING - H0))));
			const VX = V0 * Math.cos(A);
			const VY = V0 * Math.sin(A);
			const TR = DX / VX; // at the ring
			const SLOW = 2;
			const T0 = 0.4;
			const RUN = 3.4;
			const RX = HX + DX * K;
			const RY = FLOOR - RING * K;
			const ball = card.querySelector<SVGGElement>('[data-bball]')!;
			const seams = card.querySelector<SVGGElement>('[data-seams]')!;
			const net = card.querySelector<SVGPathElement>('[data-net]')!;
			const ghosts = [...card.querySelectorAll<SVGGElement>('[data-ghosts] > g')];
			const at = (t: number) => [HX + VX * t * K, FLOOR - (H0 + VY * t - (G * t * t) / 2) * K];
			const netPath = (sag: number) => {
				const top = [-10.8, -6.5, -2.2, 2.2, 6.5, 10.8];
				const bot = [-6, -3.6, -1.2, 1.2, 3.6, 6];
				const yb = RY + 19 + sag;
				let d = '';
				top.forEach((u, i) => {
					d += `M ${f1(RX + u)} ${RY} L ${f1(RX + bot[i])} ${f1(yb)} `;
				});
				d += `M ${f1(RX - 9)} ${f1(RY + 7 + sag / 3)} L ${f1(RX + 9)} ${f1(RY + 7 + sag / 3)} M ${f1(RX - 7.5)} ${f1(RY + 13 + sag / 2)} L ${f1(RX + 7.5)} ${f1(RY + 13 + sag / 2)} M ${RX - 6} ${f1(yb)} L ${RX + 6} ${f1(yb)}`;
				return d;
			};
			ghosts.forEach((g, k) => {
				const [x, y] = at(0.1 * k);
				const [gx1, gx2, c, tx, ty] = [...g.children] as SVGElement[];
				gx1.setAttribute('x1', f1(x));
				gx1.setAttribute('y1', f1(y + 6));
				gx1.setAttribute('x2', f1(x));
				gx1.setAttribute('y2', String(FLOOR));
				gx2.setAttribute('x1', f1(x - 6));
				gx2.setAttribute('y1', f1(y));
				gx2.setAttribute('x2', '16');
				gx2.setAttribute('y2', f1(y));
				c.setAttribute('cx', f1(x));
				c.setAttribute('cy', f1(y));
				tx.setAttribute('cx', f1(x));
				tx.setAttribute('cy', String(FLOOR));
				ty.setAttribute('cx', '16');
				ty.setAttribute('cy', f1(y));
			});
			scene(card, RUN, (x) => {
				const t = Math.max(0, (x * RUN - T0) / SLOW); // real time since the release, s
				let bx: number;
				let by: number;
				let op = 1;
				let sag = 0;
				if (t <= TR) [bx, by] = at(t);
				else {
					// the net takes the horizontal speed; the ball falls through it and fades
					const u = t - TR;
					const vy = VY - G * TR;
					bx = RX + 0.1 * VX * u * K;
					by = RY - (vy * u - (G * u * u) / 2) * K;
					sag = 6 * Math.max(0, Math.min(1, (by - RY) / 12)) * Math.max(0, 1 - (by - RY - 14) / 14);
					op = clamp(1 - (by - RY - 18) / 40);
				}
				ball.setAttribute('transform', `translate(${f1(bx)} ${f1(by)})`);
				ball.style.opacity = op.toFixed(2);
				seams.setAttribute('transform', `rotate(${f1(-360 * 1.5 * t)})`);
				net.setAttribute('d', netPath(sag));
				ghosts.forEach((g, k) => {
					g.style.opacity = t >= 0.1 * k && x * RUN >= T0 ? '1' : '0';
				});
			});
		}
	}
</script>
