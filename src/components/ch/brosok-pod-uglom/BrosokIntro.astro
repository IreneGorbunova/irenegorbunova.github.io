---
/**
 * Two short looping opening scenes of «Движение тела, брошенного под углом к горизонту». No formulas in the pictures;
 * the captions' popovers explain. People: the shared people kit (src/components/people/).
 *
 * Fountain (real time, 4,6 с): a city square with a large pool, trees, houses, lamps and a bench behind it. The jets
 *   lie in one vertical plane across the pool, drawn at 105 px per metre on both axes. Five jets leave one nozzle at
 *   the water surface with the same speed, 5 м/с, at 15°, 30°, 45°, 60° and 75°; they switch on every 0,8 с. Every
 *   drop flies on its own parabola (no air): x = υ0·cos α·τ, y = υ0·sin α·τ − gτ²/2, g = 9,8 м/с², and moves along it
 *   in real time. The 45° jet reaches farthest (2,55 м), the 30° and 60° jets meet the water at one spot (2,21 м), and
 *   so do the 15° and 75° jets (1,28 м); the 75° jet rises 1,19 м. The picture writes no angles: the
 *   result is for the chapter (the caption's popover names it). Behind the pool, several metres farther from us and
 *   so drawn smaller (0,42 px per см), a father (172 см) and his daughter (7 years, 120 см) stand hand in hand and look
 *   at the jets. Their hands are about 5–7 px long, so the kit draws them as mittens; nobody points (a finger would
 *   not read at this size).
 * Basketball (slowed down twice): a school gym seen from the side of the court, 48 px per metre in the plane of the
 *   throw (the middle of the painted lane). A player (190 см) stands at the free-throw line with the ball (diameter
 *   24 см) held above his forehead in both hands. He bends his knees (0,35 с), straightens them and pushes the ball
 *   along a line at 52° to the horizontal: from rest over 0,40 м, so with a = υ0²/(2·0,40) = 64 м/с² for 0,11 с, rising
 *   onto the balls of his feet. The ball leaves his hands 2,1 м above the floor at 52° and passes the center of the
 *   ring (3,05 м high, 4,2 м farther) on the way down: υ0 = 7,18 м/с from the parabola through both points, flight to
 *   the ring 0,95 с, top 3,73 м. The arms are straight at the release; after it the wrists bend forward (the
 *   follow-through). Every 0,1 с a ghost of the ball stays, with its marks on the floor line (equally spaced, blue)
 *   and on a vertical line at the left (closer together near the top, red), the colors of υx and υy in the models.
 *   The net stops the ball; it drops out and fades. Two teammates (188 и 184 см) wait on the far lane line, about 2 м
 *   behind the plane of the throw (0,42 px per см), and follow the ball with their heads.
 * Plays only while visible.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gSky = `bpi-sky-${uid}`;
const gPool = `bpi-pool-${uid}`;
const gBall = `bpi-ball-${uid}`;
const gFloor = `bpi-floor-${uid}`;
const gWin = `bpi-win-${uid}`;

// Fountain: the plane of the jets meets the water at y = 196, the nozzle at x = 46
const SURF = 196;
const NX = 46;
const KF = 105;
const V0 = 5;
const G = 9.8;
const JETS = [15, 30, 45, 60, 75];
// houses across the square: x, width, top, color, window rows × columns
const HOUSES = [
	{ x: -6, w: 70, top: 62, c: 'a', rows: 4, cols: 3 },
	{ x: 64, w: 58, top: 84, c: 'b', rows: 3, cols: 3 },
	{ x: 122, w: 84, top: 54, c: 'c', rows: 4, cols: 4 },
	{ x: 206, w: 62, top: 76, c: 'a', rows: 3, cols: 3 },
	{ x: 268, w: 98, top: 60, c: 'b', rows: 4, cols: 5 },
];
const TREES = [
	{ x: 30, y: 150, r: 26 },
	{ x: 108, y: 146, r: 30 },
	{ x: 196, y: 150, r: 27 },
	{ x: 262, y: 144, r: 31 },
	{ x: 352, y: 148, r: 26 },
];
const TILES = Array.from({ length: 13 }, (_, i) => i * 30 - 12);

// Basketball: the plane of the throw meets the floor at y = 228, 48 px per m; the release at (70; 127,2)
const FLOOR = 228;
const KB = 48;
const HX = 70;
const RX = HX + 4.2 * KB;
const RY = FLOOR - 3.05 * KB;
const BOARD = RX + (0.225 + 0.15) * KB;
const GHOSTS = 10;
const WALL = 150; // the far wall meets the floor
const LANE_FAR = 214;
const LANE_X0 = 58; // the free-throw line
const BASE_X = BOARD + 30; // the baseline
const WINDOWS = [24, 84, 144, 204];
const PLANKS = Array.from({ length: 9 }, (_, i) => WALL + 6 + i * i * 1.1 + i * 7);
---

<PeopleStyles />
<IntroFrame data-bpintro>
	<div class="intro__card" data-scene="fountain">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Фонтан на городской площади: из одного сопла одна за другой бьют пять струй с одинаковой скоростью под углами 15, 30, 45, 60 и 75 градусов к горизонту. Дальше всех падает струя под углом 45 градусов; струи под углами 30 и 60 градусов падают в одно место, струи под углами 15 и 75 градусов — тоже. За бассейном папа с дочкой смотрят на струи">
			<defs>
				<linearGradient id={gSky} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="bpi-sky-top"></stop>
					<stop offset="1" class="bpi-sky-low"></stop>
				</linearGradient>
				<linearGradient id={gPool} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="bpi-pool-far"></stop>
					<stop offset="1" class="bpi-pool-near"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="176" fill={`url(#${gSky})`}></rect>
			<g class="bpi-cloud">
				<path d="M 214 30 q 6 -10 18 -6 q 8 -8 18 0 q 10 -2 10 7 z"></path>
				<path d="M 70 22 q 5 -8 14 -5 q 7 -6 14 0 q 8 -1 8 5 z"></path>
			</g>
			<!-- houses across the square -->
			{
				HOUSES.map((h) => (
					<g>
						<rect class={`bpi-house bpi-house--${h.c}`} x={h.x} y={h.top} width={h.w} height={176 - h.top}></rect>
						<rect class="bpi-roof" x={h.x - 2} y={h.top - 4} width={h.w + 4} height="5"></rect>
						{Array.from({ length: h.rows }, (_, r) =>
							Array.from({ length: h.cols }, (_, c) => (
								<rect class="bpi-win" x={h.x + ((c + 0.5) * h.w) / h.cols - 4} y={h.top + 9 + r * 20} width="8" height="11" rx="0.8"></rect>
							)),
						)}
					</g>
				))
			}
			<!-- trees along the far side of the square -->
			{
				TREES.map((t) => (
					<g>
						<rect class="bpi-trunk" x={t.x - 2.5} y={t.y} width="5" height={176 - t.y}></rect>
						<circle class="bpi-crown" cx={t.x} cy={t.y - t.r * 0.35} r={t.r * 0.78}></circle>
						<circle class="bpi-crown bpi-crown--lit" cx={t.x - t.r * 0.35} cy={t.y - t.r * 0.6} r={t.r * 0.5}></circle>
						<circle class="bpi-crown" cx={t.x + t.r * 0.45} cy={t.y - t.r * 0.15} r={t.r * 0.55}></circle>
					</g>
				))
			}
			<!-- the far pavement with two lamps and a bench -->
			<rect class="bpi-pave-far" x="0" y="170" width="360" height="16"></rect>
			<path class="bpi-pave-line" d="M 0 176 H 360 M 0 181.5 H 360"></path>
			{
				[150, 236].map((x) => (
					<g>
						<rect class="bpi-lamp-pole" x={x - 1.2} y="104" width="2.4" height="76"></rect>
						<path class="bpi-lamp-arm" d={`M ${x} 106 q 0 -6 7 -6`}></path>
						<path class="bpi-lamp" d={`M ${x + 3} 101 h 9 l -2 4 h -5 z`}></path>
						<rect class="bpi-lamp-pole" x={x - 2.5} y="176" width="5" height="4"></rect>
					</g>
				))
			}
			<g class="bpi-bench">
				<rect x="176" y="164" width="34" height="3" rx="1"></rect>
				<rect x="176" y="169.5" width="34" height="2.5" rx="1"></rect>
				<path d="M 179 172 v 9 M 207 172 v 9 M 180 167 v 3 M 206 167 v 3"></path>
			</g>
			<!-- the father and the daughter (people kit), behind the pool -->
			<g data-bpi-dad></g>
			<g data-bpi-girl></g>
			<!-- the back rim of the pool -->
			<rect class="bpi-rim-top" x="0" y="185" width="360" height="3"></rect>
			<rect class="bpi-rim" x="0" y="188" width="360" height="4"></rect>
			<!-- the pool -->
			<rect x="0" y="192" width="360" height="23" fill={`url(#${gPool})`}></rect>
			<path class="bpi-glint" d="M 20 204 h 14 M 96 209 h 22 M 170 202 h 12 M 240 207 h 18 M 330 203 h 14"></path>
			<path class="bpi-surface" d="" data-fsurf></path>
			<!-- the jets -->
			<g data-jets>
				{JETS.map((a) => <path class={`bpi-jet${a === 45 ? ' bpi-jet--best' : ''}`} d="" data-a={a} />)}
			</g>
			<g class="bpi-drops" data-fdrops>
				{JETS.map(() => Array.from({ length: 4 }, () => <circle r="1.7" />))}
			</g>
			<g data-rings>
				{JETS.map(() => <ellipse class="bpi-ring" rx="0" ry="0" />)}
			</g>
			<!-- the nozzle on its small stone -->
			<ellipse class="bpi-rim" cx={NX} cy={SURF + 3} rx="11" ry="3"></ellipse>
			<path class="bpi-nozzle" d={`M ${NX - 6} ${SURF + 2} L ${NX - 4} ${SURF - 4} Q ${NX} ${SURF - 8} ${NX + 4} ${SURF - 4} L ${NX + 6} ${SURF + 2} Z`}></path>
			<!-- the near rim and the tiled square -->
			<rect class="bpi-rim-top" x="0" y="214" width="360" height="5"></rect>
			<rect class="bpi-rim" x="0" y="219" width="360" height="9"></rect>
			<path class="bpi-rim-joint" d="M 40 219 v 9 M 120 219 v 9 M 200 219 v 9 M 280 219 v 9"></path>
			<rect class="bpi-tiles" x="0" y="228" width="360" height="12"></rect>
			<path class="bpi-tile-line" d={`M 0 233 H 360 ${TILES.map((x) => `M ${x} 228 l -4 12`).join(' ')}`}></path>
			<!-- a pigeon on the rim -->
			<g class="bpi-bird" transform="translate(152 214)">
				<path d="M -5 0 q 1 -5 6 -5 q 3 -3 5 0 l 2 1 l -2 0.6 q 0 3 -4 4 z"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Струи фонтана вылетают с одинаковой скоростью, но под разными углами. Дальше всех бьёт не самая крутая и не самая пологая струя, а две разные струи <More term="падают в одно место">Каждая капля летит как брошенный камешек. Капли крутой струи поднимаются высоко, но вперёд движутся медленно, капли пологой струи быстро движутся вперёд, но скоро падают. Дальше всего улетают капли, вылетевшие под углом 45°; струи под углами 30° и 60° падают в одно место, струи под углами 15° и 75° — тоже. Подробнее — в разделе <a href="#дальность-полёта">«Дальность полёта»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="ball">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Штрафной бросок в школьном спортзале, замедленно. Баскетболист сгибает колени и выталкивает мяч обеими руками. Через каждые 0,1 секунды остаётся отпечаток мяча. Отметки отпечатков на полу идут на равных расстояниях, а отметки на вертикальной линии слева у верхней точки сближаются. Двое игроков у линии штрафной зоны следят за мячом">
			<defs>
				<clipPath id={gBall}>
					<circle cx="0" cy="0" r="6"></circle>
				</clipPath>
				<linearGradient id={gFloor} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="bpi-floor-far"></stop>
					<stop offset="1" class="bpi-floor-near"></stop>
				</linearGradient>
				<linearGradient id={gWin} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="bpi-glass-top"></stop>
					<stop offset="1" class="bpi-glass-low"></stop>
				</linearGradient>
			</defs>
			<!-- the far wall: high windows, a scoreboard, a banner, the stands -->
			<rect class="bpi-wall" x="0" y="0" width="360" height={WALL}></rect>
			<rect class="bpi-wall-low" x="0" y="96" width="360" height={WALL - 96}></rect>
			{
				WINDOWS.map((x) => (
					<g>
						<rect class="bpi-winframe" x={x - 1.5} y="10.5" width="47" height="33" rx="1"></rect>
						<rect x={x} y="12" width="44" height="30" fill={`url(#${gWin})`}></rect>
						<path class="bpi-winbar" d={`M ${x + 22} 12 v 30 M ${x} 27 h 44`}></path>
					</g>
				))
			}
			<rect class="bpi-board-wall" x="134" y="90" width="52" height="20" rx="2"></rect>
			<text class="bpi-score" x="147" y="104.5" text-anchor="middle">12</text>
			<text class="bpi-score bpi-score--b" x="173" y="104.5" text-anchor="middle">10</text>
			<rect class="bpi-banner" x="196" y="94" width="48" height="14" rx="1.5"></rect>
			<path class="bpi-banner-band" d="M 196 103 h 48"></path>
			<!-- the stands: three steps along the wall -->
			<path class="bpi-stand" d={`M 0 ${WALL} V 118 H 360 V ${WALL} Z`}></path>
			<path class="bpi-stand-step" d="M 0 118 H 360 M 0 128 H 360 M 0 139 H 360"></path>
			<path class="bpi-stand-seat" d="M 0 121 H 360 M 0 131.5 H 360 M 0 142.5 H 360"></path>
			<rect class="bpi-bag" x="196" y="133" width="11" height="6" rx="2"></rect>
			<rect class="bpi-towel" x="226" y="137" width="9" height="2.5" rx="1"></rect>
			<!-- the floor with the court lines in perspective -->
			<rect x="0" y={WALL} width="360" height={240 - WALL} fill={`url(#${gFloor})`}></rect>
			<path class="bpi-plank" d={PLANKS.map((y) => `M 0 ${y.toFixed(1)} H 360`).join(' ')}></path>
			<path class="bpi-courtline" d={`M 0 ${WALL + 6} H 360`}></path>
			<path class="bpi-lane" d={`M ${LANE_X0 + 6} ${LANE_FAR} L ${BASE_X - 4} ${LANE_FAR} L ${BASE_X + 4} 240 L ${LANE_X0 - 4} 240 Z`}></path>
			<path class="bpi-courtline" d={`M ${LANE_X0 + 6} ${LANE_FAR} L ${BASE_X - 4} ${LANE_FAR} M ${LANE_X0 + 6} ${LANE_FAR} L ${LANE_X0 - 4} 240 M ${BASE_X - 4} ${LANE_FAR} L ${BASE_X + 4} 240`}></path>
			<path class="bpi-courtline" d={`M ${LANE_X0 + 6} ${LANE_FAR} A 26 13 0 0 0 ${LANE_X0 - 4} 240`}></path>
			<path class="bpi-courtline bpi-courtline--thin" d={`M ${BASE_X - 2} ${WALL + 6} L ${BASE_X - 4} ${LANE_FAR}`}></path>
			<!-- the stand of the basket: the base, the pole, the arm, the board, the ring and the net -->
			<rect class="bpi-pole-base" x="322" y={LANE_FAR - 10} width="30" height="10" rx="2"></rect>
			<rect class="bpi-pole" x="334" y="52" width="7" height={LANE_FAR - 62}></rect>
			<path class="bpi-arm" d={`M ${BOARD + 3} 62 L 337 56 M ${BOARD + 3} 78 L 337 66`}></path>
			<rect class="bpi-board" x={BOARD} y={FLOOR - 3.95 * KB} width="3.5" height={1.05 * KB}></rect>
			<path class="bpi-net" d="" data-net></path>
			<!-- the teammates (people kit), on the far lane line -->
			<g data-bpi-mate1></g>
			<g data-bpi-mate2></g>
			<text class="bpi-note" x="352" y="24" text-anchor="end">замедлено в 2 раза</text>
			<!-- the marks: on the floor line (horizontal motion) and on the vertical line (vertical motion) -->
			<line class="bpi-vline" x1="16" y1="34" x2="16" y2={FLOOR}></line>
			<line class="bpi-hline" x1="16" y1={FLOOR} x2={BASE_X - 6} y2={FLOOR}></line>
			<g data-ghosts>
				{
					Array.from({ length: GHOSTS }, () => (
						<g class="bpi-ghost">
							<line class="bpi-guide" />
							<line class="bpi-guide" />
							<circle class="bpi-ghost-ball" r="6" />
							<circle class="bpi-tick bpi-tick--x" r="2.6" />
							<circle class="bpi-tick bpi-tick--y" r="2.6" />
						</g>
					))
				}
			</g>
			<!-- the player (people kit), 1,9 м; the script puts the ball between his far arm and his body -->
			<g data-bpi-player></g>
			<g data-bball>
				<g clip-path={`url(#${gBall})`}>
					<circle class="bpi-bball" r="6"></circle>
					<g data-seams>
						<path class="bpi-seam" d="M -7 0 L 7 0 M 0 -7 L 0 7"></path>
						<path class="bpi-seam" d="M -4.5 -7 Q -1.5 0 -4.5 7 M 4.5 -7 Q 1.5 0 4.5 7"></path>
					</g>
				</g>
			</g>
			<!-- the ring in front of the ball -->
			<line class="bpi-hoopbar" x1={RX + 10.8} y1={RY} x2={BOARD} y2={RY}></line>
			<ellipse class="bpi-hoop" cx={RX} cy={RY} rx="10.8" ry="2.4"></ellipse>
		</svg>
		<div class="intro__foot">
			<p>Снимки летящего мяча через каждые 0,1&nbsp;с. По горизонтали мяч каждый раз смещается <More term="на одно и то же расстояние">По горизонтали на мяч почти ничего не действует (сопротивление воздуха мало), и он движется равномерно — как отметки на полу. По вертикали мяч движется как подброшенный вверх: сила тяжести сначала тормозит его, а потом разгоняет вниз, — отметки на линии слева у верхней точки сближаются. Подробнее — в разделе <a href="#два-движения-сразу">«Два движения сразу»</a>.</More>, а по вертикали сначала поднимается всё медленнее, потом опускается всё быстрее.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-bpintro] {
		--bpi-sky-top: hsl(214, 40%, 20%);
		--bpi-sky-low: hsl(208, 38%, 32%);
		--bpi-cloud: hsl(212, 22%, 40%);
		--bpi-house-a: hsl(24, 22%, 34%);
		--bpi-house-b: hsl(210, 10%, 36%);
		--bpi-house-c: hsl(40, 20%, 38%);
		--bpi-roof: hsl(210, 12%, 24%);
		--bpi-win: hsl(42, 55%, 55%);
		--bpi-trunk: hsl(25, 28%, 26%);
		--bpi-crown: hsl(128, 28%, 25%);
		--bpi-crown-lit: hsl(118, 30%, 32%);
		--bpi-pave: hsl(30, 10%, 36%);
		--bpi-pave-line: hsl(30, 8%, 30%);
		--bpi-lamp: hsl(210, 8%, 55%);
		--bpi-lamp-glow: hsl(48, 80%, 66%);
		--bpi-bench: hsl(28, 40%, 40%);
		--bpi-stone: hsl(36, 14%, 50%);
		--bpi-stone-top: hsl(36, 16%, 62%);
		--bpi-stone-joint: hsl(36, 10%, 40%);
		--bpi-pool-far: hsl(198, 45%, 30%);
		--bpi-pool-near: hsl(204, 50%, 22%);
		--bpi-water: hsl(195, 80%, 82%);
		--bpi-glint: hsl(195, 60%, 60%);
		--bpi-bronze: hsl(34, 45%, 45%);
		--bpi-tiles: hsl(30, 10%, 42%);
		--bpi-tile-line: hsl(30, 8%, 34%);
		--bpi-bird: hsl(220, 8%, 62%);
		--bpi-wall: hsl(210, 14%, 26%);
		--bpi-wall-low: hsl(205, 22%, 30%);
		--bpi-winframe: hsl(210, 10%, 48%);
		--bpi-glass-top: hsl(205, 45%, 52%);
		--bpi-glass-low: hsl(205, 40%, 36%);
		--bpi-scoreboard: hsl(220, 15%, 12%);
		--bpi-score: hsl(30, 95%, 60%);
		--bpi-score-b: hsl(120, 60%, 58%);
		--bpi-banner: hsl(214, 55%, 42%);
		--bpi-banner-band: hsl(45, 80%, 60%);
		--bpi-stand: hsl(24, 30%, 30%);
		--bpi-stand-step: hsl(24, 20%, 22%);
		--bpi-stand-seat: hsl(24, 40%, 40%);
		--bpi-bag: hsl(0, 50%, 45%);
		--bpi-towel: hsl(190, 40%, 70%);
		--bpi-floor-far: hsl(32, 40%, 38%);
		--bpi-floor-near: hsl(30, 45%, 46%);
		--bpi-plank: hsl(30, 35%, 33%);
		--bpi-lane: hsl(214, 40%, 38%);
		--bpi-courtline: hsl(40, 30%, 88%);
		--bpi-steel: hsl(210, 8%, 52%);
		--bpi-glass: hsl(200, 30%, 85%);
		--bpi-ball: hsl(24, 85%, 52%);
		--bpi-note: hsl(210, 15%, 82%);
		--bpi-seam: hsl(0, 0%, 8%);
		--bpi-nozzle-edge: hsl(34, 40%, 25%);
	}
	:root[data-theme='light'] [data-bpintro] {
		--bpi-sky-top: hsl(205, 70%, 78%);
		--bpi-sky-low: hsl(200, 70%, 90%);
		--bpi-cloud: hsl(0, 0%, 100%);
		--bpi-house-a: hsl(24, 45%, 70%);
		--bpi-house-b: hsl(205, 18%, 78%);
		--bpi-house-c: hsl(42, 50%, 78%);
		--bpi-roof: hsl(210, 14%, 50%);
		--bpi-win: hsl(205, 45%, 62%);
		--bpi-trunk: hsl(25, 30%, 36%);
		--bpi-crown: hsl(125, 35%, 40%);
		--bpi-crown-lit: hsl(115, 40%, 50%);
		--bpi-pave: hsl(30, 12%, 72%);
		--bpi-pave-line: hsl(30, 10%, 62%);
		--bpi-lamp: hsl(210, 10%, 40%);
		--bpi-lamp-glow: hsl(45, 85%, 60%);
		--bpi-bench: hsl(28, 45%, 42%);
		--bpi-stone: hsl(36, 18%, 64%);
		--bpi-stone-top: hsl(36, 22%, 80%);
		--bpi-stone-joint: hsl(36, 12%, 52%);
		--bpi-pool-far: hsl(195, 55%, 62%);
		--bpi-pool-near: hsl(200, 55%, 48%);
		--bpi-water: hsl(198, 85%, 38%);
		--bpi-glint: hsl(195, 70%, 88%);
		--bpi-bronze: hsl(34, 50%, 40%);
		--bpi-tiles: hsl(30, 14%, 78%);
		--bpi-tile-line: hsl(30, 10%, 66%);
		--bpi-bird: hsl(220, 8%, 46%);
		--bpi-wall: hsl(40, 25%, 86%);
		--bpi-wall-low: hsl(205, 35%, 74%);
		--bpi-winframe: hsl(210, 10%, 60%);
		--bpi-glass-top: hsl(200, 70%, 82%);
		--bpi-glass-low: hsl(200, 60%, 70%);
		--bpi-scoreboard: hsl(220, 15%, 16%);
		--bpi-banner: hsl(214, 60%, 50%);
		--bpi-stand: hsl(24, 40%, 52%);
		--bpi-stand-step: hsl(24, 30%, 42%);
		--bpi-stand-seat: hsl(24, 50%, 62%);
		--bpi-floor-far: hsl(34, 50%, 62%);
		--bpi-floor-near: hsl(32, 55%, 70%);
		--bpi-plank: hsl(32, 40%, 56%);
		--bpi-lane: hsl(214, 50%, 58%);
		--bpi-courtline: hsl(0, 0%, 100%);
		--bpi-steel: hsl(210, 8%, 44%);
		--bpi-glass: hsl(200, 30%, 96%);
		--bpi-note: hsl(210, 15%, 25%);
	}
	.bpi-sky-top { stop-color: var(--bpi-sky-top); }
	.bpi-sky-low { stop-color: var(--bpi-sky-low); }
	.bpi-pool-far { stop-color: var(--bpi-pool-far); }
	.bpi-pool-near { stop-color: var(--bpi-pool-near); }
	.bpi-floor-far { stop-color: var(--bpi-floor-far); }
	.bpi-floor-near { stop-color: var(--bpi-floor-near); }
	.bpi-glass-top { stop-color: var(--bpi-glass-top); }
	.bpi-glass-low { stop-color: var(--bpi-glass-low); }
	.bpi-cloud { fill: var(--bpi-cloud); }
	.bpi-house--a { fill: var(--bpi-house-a); }
	.bpi-house--b { fill: var(--bpi-house-b); }
	.bpi-house--c { fill: var(--bpi-house-c); }
	.bpi-roof { fill: var(--bpi-roof); }
	.bpi-win { fill: var(--bpi-win); opacity: 0.85; }
	.bpi-trunk { fill: var(--bpi-trunk); }
	.bpi-crown { fill: var(--bpi-crown); }
	.bpi-crown--lit { fill: var(--bpi-crown-lit); }
	.bpi-pave-far { fill: var(--bpi-pave); }
	.bpi-pave-line { stroke: var(--bpi-pave-line); stroke-width: 0.7; fill: none; }
	.bpi-lamp-pole { fill: var(--bpi-lamp); }
	.bpi-lamp-arm { stroke: var(--bpi-lamp); stroke-width: 1.4; fill: none; }
	.bpi-lamp { fill: var(--bpi-lamp-glow); }
	.bpi-bench rect { fill: var(--bpi-bench); }
	.bpi-bench path { stroke: var(--bpi-lamp); stroke-width: 1.4; fill: none; }
	.bpi-rim { fill: var(--bpi-stone); }
	.bpi-rim-top { fill: var(--bpi-stone-top); }
	.bpi-rim-joint { stroke: var(--bpi-stone-joint); stroke-width: 0.8; fill: none; }
	.bpi-tiles { fill: var(--bpi-tiles); }
	.bpi-tile-line { stroke: var(--bpi-tile-line); stroke-width: 0.7; fill: none; }
	.bpi-glint { stroke: var(--bpi-glint); stroke-width: 1; stroke-linecap: round; opacity: 0.6; fill: none; }
	.bpi-bird { fill: var(--bpi-bird); }
	.bpi-surface { fill: none; stroke: var(--bpi-water); stroke-width: 1.2; opacity: 0.8; }
	.bpi-jet { fill: none; stroke: var(--bpi-water); stroke-width: 2.4; stroke-linecap: round; opacity: 0.85; }
	.bpi-jet--best { stroke-width: 3.2; opacity: 1; }
	.bpi-drops circle { fill: var(--bpi-water); }
	.bpi-ring { fill: none; stroke: var(--bpi-water); stroke-width: 1.2; }
	.bpi-nozzle { fill: var(--bpi-bronze); stroke: var(--bpi-nozzle-edge); stroke-width: 0.8; }
	.bpi-wall { fill: var(--bpi-wall); }
	.bpi-wall-low { fill: var(--bpi-wall-low); }
	.bpi-winframe { fill: var(--bpi-winframe); }
	.bpi-winbar { stroke: var(--bpi-winframe); stroke-width: 1.5; fill: none; }
	.bpi-board-wall { fill: var(--bpi-scoreboard); }
	.bpi-score { font-size: 13px; font-weight: 700; fill: var(--bpi-score); font-family: ui-monospace, monospace; }
	.bpi-score--b { fill: var(--bpi-score-b); }
	.bpi-banner { fill: var(--bpi-banner); }
	.bpi-banner-band { stroke: var(--bpi-banner-band); stroke-width: 2; fill: none; }
	.bpi-stand { fill: var(--bpi-stand); }
	.bpi-stand-step { stroke: var(--bpi-stand-step); stroke-width: 1.2; fill: none; }
	.bpi-stand-seat { stroke: var(--bpi-stand-seat); stroke-width: 2; fill: none; }
	.bpi-bag { fill: var(--bpi-bag); }
	.bpi-towel { fill: var(--bpi-towel); }
	.bpi-plank { stroke: var(--bpi-plank); stroke-width: 0.6; fill: none; opacity: 0.8; }
	.bpi-lane { fill: var(--bpi-lane); opacity: 0.55; }
	.bpi-courtline { stroke: var(--bpi-courtline); stroke-width: 1.4; fill: none; }
	.bpi-courtline--thin { stroke-width: 1; }
	.bpi-note { font-size: 11.5px; fill: var(--bpi-note); }
	.bpi-pole,
	.bpi-pole-base { fill: var(--bpi-steel); }
	.bpi-arm { fill: none; stroke: var(--bpi-steel); stroke-width: 2.5; }
	.bpi-board { fill: var(--bpi-glass); }
	.bpi-hoop { fill: none; stroke: var(--ig-vy); stroke-width: 2; }
	.bpi-hoopbar { stroke: var(--ig-vy); stroke-width: 2; }
	.bpi-net { fill: none; stroke: var(--bpi-courtline); stroke-width: 0.8; opacity: 0.85; }
	.bpi-vline,
	.bpi-hline { stroke: var(--sl-color-gray-2); stroke-width: 1; opacity: 0.7; }
	.bpi-ghost-ball { fill: none; stroke: var(--bpi-ball); stroke-width: 1.4; opacity: 0.9; }
	.bpi-guide { stroke: var(--sl-color-gray-1); stroke-width: 0.8; stroke-dasharray: 1.5 2.5; opacity: 0.55; }
	.bpi-tick--x { fill: var(--ig-vx); }
	.bpi-tick--y { fill: var(--ig-vy); }
	.bpi-bball { fill: var(--bpi-ball); }
	.bpi-seam { fill: none; stroke: var(--bpi-seam); stroke-width: 0.8; opacity: 0.55; }
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';
	import { figure, ease, type Pt } from '@components/people';

	const f1 = (v: number) => v.toFixed(1);
	const G = 9.8;
	const rad = (a: number) => (a * Math.PI) / 180;
	const clampH = (a: number) => Math.max(-0.66, Math.min(0.66, a));

	for (const root of document.querySelectorAll<HTMLElement>('[data-bpintro]')) {
		// Fountain: the jets switch on every 0,8 s; 4,6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="fountain"]')!;
			const SURF = 196;
			const NX = 46;
			const K = 105;
			const V0 = 5;
			const ON = 0.8;
			const RUN = 4.6;
			const jets = [...card.querySelectorAll<SVGPathElement>('[data-jets] path')];
			const drops = [...card.querySelectorAll<SVGCircleElement>('[data-fdrops] circle')];
			const rings = [...card.querySelectorAll<SVGEllipseElement>('[data-rings] ellipse')];
			const surf = card.querySelector<SVGPathElement>('[data-fsurf]')!;
			const J = jets.map((el, k) => {
				const a = rad(Number(el.dataset.a));
				const vx = V0 * Math.cos(a);
				const vy = V0 * Math.sin(a);
				return { el, vx, vy, T: (2 * vy) / G, on: k * ON };
			});
			const pos = (j: (typeof J)[number], tau: number) => [NX + j.vx * tau * K, SURF - (j.vy * tau - (G * tau * tau) / 2) * K];
			// a jet has reached the water when its first drop has landed
			const landed = (j: (typeof J)[number], t: number) => t - j.on >= j.T;

			// the father (172 см) and the daughter (120 см), 0,42 px per см, on the far pavement; both face left
			const S = 0.42;
			const FEET = 182;
			const dad = figure(card.querySelector<SVGGElement>('[data-bpi-dad]')!, { s: S, H: 172, clothes: 'home', shirt: 'hm-green', dir: -1, name: 'father' });
			const girl = figure(card.querySelector<SVGGElement>('[data-bpi-girl]')!, { s: S, H: 120, age: 'child', clothes: 'indoor', shirt: 'hm-red', hair: 'pony', dir: -1, name: 'daughter' });
			const uD = S * 172;
			const uG = S * 120;
			const DX = 342;
			const GX = 322;
			const hold: Pt = { x: 332, y: FEET - 34 };
			const posePeople = (look: number) => {
				dad.pose({
					hip: { x: DX, y: FEET - 0.52 * uD },
					lean: 0,
					head: clampH(look),
					ankles: [
						{ x: DX - 2, y: FEET - 0.045 * uD },
						{ x: DX + 3, y: FEET - 0.045 * uD },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: hold, pose: 'grip', d: 4, contact: 'daughter-hand' },
						{ at: { x: DX + 2, y: FEET - 0.43 * uD }, pose: 'relaxed' },
					],
				});
				girl.pose({
					hip: { x: GX, y: FEET - 0.48 * uG },
					lean: 0.02,
					head: clampH(look - 0.1),
					ankles: [
						{ x: GX - 2, y: FEET - 0.045 * uG },
						{ x: GX + 2.5, y: FEET - 0.045 * uG },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: hold, pose: 'grip', d: 4, contact: 'father-hand' },
						{ at: { x: GX - 1, y: FEET - 0.42 * uG }, pose: 'relaxed' },
					],
				});
			};

			scene(card, RUN, (x) => {
				const t = x * RUN;
				const now = performance.now() / 1000;
				J.forEach((j, k) => {
					const age = Math.min(t - j.on, j.T);
					if (age <= 0) {
						j.el.setAttribute('d', '');
						for (let i = 0; i < 4; i++) drops[4 * k + i].style.opacity = '0';
						rings[k].style.opacity = '0';
						return;
					}
					const n = Math.max(2, Math.ceil(age / 0.015));
					const pts: string[] = [];
					for (let i = 0; i <= n; i++) {
						const [px, py] = pos(j, (age * i) / n);
						pts.push(`${f1(px)} ${f1(py)}`);
					}
					j.el.setAttribute('d', `M ${pts.join(' L ')}`);
					// drops ride on the jet in real time
					for (let i = 0; i < 4; i++) {
						const d = drops[4 * k + i];
						const tau = (now + (i * j.T) / 4 + k * 0.17) % j.T;
						if (tau > age) {
							d.style.opacity = '0';
							continue;
						}
						const [px, py] = pos(j, tau);
						d.style.opacity = '0.95';
						d.setAttribute('cx', f1(px));
						d.setAttribute('cy', f1(py));
					}
					// rings where the jet meets the water
					if (landed(j, t)) {
						const ph = (now * 1.6 + k * 0.3) % 1;
						rings[k].style.opacity = (0.9 * (1 - ph)).toFixed(2);
						rings[k].setAttribute('cx', f1(NX + j.vx * j.T * K));
						rings[k].setAttribute('cy', String(SURF + 1));
						rings[k].setAttribute('rx', f1(3 + 9 * ph));
						rings[k].setAttribute('ry', f1(1 + 2.5 * ph));
					} else rings[k].style.opacity = '0';
				});
				const p: string[] = [];
				for (let px = 0; px <= 360; px += 8) p.push(`${px} ${f1(SURF + 0.7 * Math.sin(px / 17 + now * 1.8))}`);
				surf.setAttribute('d', `M ${p.join(' L ')}`);
				// the people look up at the jets, a little higher once the steep jets rise (the head turns slowly)
				posePeople(-0.3 - 0.14 * ease((t - 2.4) / 1.2));
			});
		}

		// Basketball: slowed down twice
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ball"]')!;
			const FLOOR = 228;
			const K = 48;
			const HX = 70;
			const H0 = 2.1;
			const DX = 4.2;
			const RING = 3.05;
			const A = rad(52);
			const V0 = Math.sqrt((G * DX * DX) / (2 * Math.cos(A) ** 2 * (DX * Math.tan(A) - (RING - H0))));
			const VX = V0 * Math.cos(A);
			const VY = V0 * Math.sin(A);
			const TR = DX / VX; // at the ring
			const SLOW = 2;
			const R = 6; // the ball's radius, px (12 см)
			// the shot in real seconds: hold, dip, push along the 52° line over D from rest, release
			const T_DIP0 = 0.2;
			const T_DIP1 = 0.55;
			const D = 0.4;
			const ACC = (V0 * V0) / (2 * D);
			const T_PUSH = Math.sqrt((2 * D) / ACC);
			const T_REL = T_DIP1 + T_PUSH;
			const RUN = (T_REL + TR + 0.6) * SLOW;
			const RX = HX + DX * K;
			const RY = FLOOR - RING * K;
			const dirX = Math.cos(A);
			const dirY = -Math.sin(A);
			const REL: Pt = { x: HX, y: FLOOR - H0 * K };
			const SET: Pt = { x: REL.x - D * K * dirX, y: REL.y - D * K * dirY };
			// the ball's center while it is held (real time t) and the depth of the dip (0…1)
			const inHands = (t: number): { c: Pt; dip: number } => {
				if (t < T_DIP0) return { c: SET, dip: 0 };
				if (t < T_DIP1) {
					const dip = Math.sin(Math.PI * ease((t - T_DIP0) / (T_DIP1 - T_DIP0)));
					return { c: { x: SET.x - 1 * dip, y: SET.y + 0.08 * K * dip }, dip };
				}
				const s = Math.min(t, T_REL) - T_DIP1;
				const along = 0.5 * ACC * s * s * K;
				return { c: { x: SET.x + along * dirX, y: SET.y + along * dirY }, dip: 0 };
			};
			const at = (t: number): Pt => ({ x: HX + VX * t * K, y: FLOOR - (H0 + VY * t - (G * t * t) / 2) * K });

			const ball = card.querySelector<SVGGElement>('[data-bball]')!;
			const seams = card.querySelector<SVGGElement>('[data-seams]')!;
			const net = card.querySelector<SVGPathElement>('[data-net]')!;
			const ghosts = [...card.querySelectorAll<SVGGElement>('[data-ghosts] > g')];
			const netPath = (sag: number) => {
				const top = [-10.8, -6.5, -2.2, 2.2, 6.5, 10.8];
				const bot = [-6, -3.6, -1.2, 1.2, 3.6, 6];
				const yb = RY + 19 + sag;
				let d = '';
				top.forEach((u, i) => {
					d += `M ${f1(RX + u)} ${RY} L ${f1(RX + bot[i])} ${f1(yb)} `;
				});
				d += `M ${f1(RX - 9)} ${f1(RY + 7 + sag / 3)} L ${f1(RX + 9)} ${f1(RY + 7 + sag / 3)} M ${f1(RX - 7.5)} ${f1(RY + 13 + sag / 2)} L ${f1(RX + 7.5)} ${f1(RY + 13 + sag / 2)} M ${RX - 6} ${f1(yb)} L ${RX + 6} ${f1(yb)}`;
				return d;
			};
			ghosts.forEach((g, k) => {
				const p = at(0.1 * k);
				const [gx1, gx2, c, tx, ty] = [...g.children] as SVGElement[];
				gx1.setAttribute('x1', f1(p.x));
				gx1.setAttribute('y1', f1(p.y + 6));
				gx1.setAttribute('x2', f1(p.x));
				gx1.setAttribute('y2', String(FLOOR));
				gx2.setAttribute('x1', f1(p.x - 6));
				gx2.setAttribute('y1', f1(p.y));
				gx2.setAttribute('x2', '16');
				gx2.setAttribute('y2', f1(p.y));
				c.setAttribute('cx', f1(p.x));
				c.setAttribute('cy', f1(p.y));
				tx.setAttribute('cx', f1(p.x));
				tx.setAttribute('cy', String(FLOOR));
				ty.setAttribute('cx', '16');
				ty.setAttribute('cy', f1(p.y));
			});

			// the player: 190 см at 0,48 px per см, facing the ring
			const S = K / 100;
			const H = 190;
			const u = S * H;
			const BX = 44; // his hips
			const playerG = card.querySelector<SVGGElement>('[data-bpi-player]')!;
			const player = figure(playerG, { s: S, H, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', shorts: true, bare: true, name: 'player' });
			// the ball goes between his far arm (behind it) and his body and near arm (in front of it)
			const bodyRoot = playerG.firstElementChild!;
			bodyRoot.insertBefore(ball, bodyRoot.children[1]);
			const ankY = FLOOR - 0.045 * u;
			// the teammates on the far lane line, 0,42 px per см
			const S2 = 0.42;
			const LANE = 214;
			const mates = [
				{ g: card.querySelector<SVGGElement>('[data-bpi-mate1]')!, H: 188, x: 176, dir: -1 as const, shirt: 'hm-red', name: 'mate-1' },
				{ g: card.querySelector<SVGGElement>('[data-bpi-mate2]')!, H: 184, x: 232, dir: 1 as const, shirt: 'hm-gold', name: 'mate-2' },
			].map((m) => ({ ...m, f: figure(m.g, { s: S2, H: m.H, clothes: 'indoor', shirt: m.shirt, hair: 'short', shorts: true, bare: true, dir: m.dir, name: m.name }) }));

			scene(card, RUN, (x) => {
				const t = (x * RUN) / SLOW; // real time, s
				const tf = t - T_REL; // since the release
				let bx: number;
				let by: number;
				let op = 1;
				let sag = 0;
				let dip = 0;
				let hc: Pt; // where the hands hold (the ball's center while it is held)
				if (tf < 0) {
					const h = inHands(t);
					hc = h.c;
					dip = h.dip;
					bx = hc.x;
					by = hc.y;
				} else {
					// the arms are straight at the release: the hands stay there and only the wrists bend forward
					hc = REL;
					if (tf <= TR) ({ x: bx, y: by } = at(tf));
					else {
						// the net takes the horizontal speed; the ball falls through it and fades
						const w = tf - TR;
						const vy = VY - G * TR;
						bx = RX + 0.1 * VX * w * K;
						by = RY - (vy * w - (G * w * w) / 2) * K;
						sag = 6 * clamp((by - RY) / 12) * Math.max(0, 1 - (by - RY - 14) / 14);
						op = clamp(1 - (by - RY - 18) / 40);
					}
				}
				ball.setAttribute('transform', `translate(${f1(bx)} ${f1(by)})`);
				ball.style.opacity = op.toFixed(2);
				seams.setAttribute('transform', `rotate(${f1(tf > 0 ? -360 * 1.5 * tf : 0)})`);
				net.setAttribute('d', netPath(sag));
				ghosts.forEach((g, k) => {
					g.style.opacity = tf >= 0.1 * k - 1e-6 ? '1' : '0';
				});

				// the legs: a dip of 7 см in the knees, then the push lifts him onto the balls of his feet (3 см)
				const push = tf < 0 ? clamp((t - T_DIP1) / T_PUSH) : 1;
				const rise = 0.03 * K * ease(push);
				const hip: Pt = { x: BX, y: FLOOR - 0.52 * u + 0.07 * K * dip - rise };
				// the shooting (near) hand behind and under the ball, the guide (far) hand on its side;
				// after the release the wrists bend forward
				const flick = tf < 0 ? 0 : ease(clamp(tf / 0.18));
				const near: Pt = { x: hc.x - 0.7 * R, y: hc.y + 0.65 * R };
				const far: Pt = { x: hc.x - 0.05 * R, y: hc.y + 0.75 * R };
				const headC = { x: BX + 3, y: hip.y - 0.4 * u };
				player.pose({
					hip,
					lean: 0.04,
					head: clampH(Math.atan2(RY - headC.y, RX - headC.x) + 0.05),
					ankles: [
						{ x: BX + 6, y: ankY - rise },
						{ x: BX - 4, y: ankY - rise },
					],
					feet: [0.35 * ease(push), 0.35 * ease(push)],
					hands: [
						{ at: near, pose: 'open', dir: -Math.PI / 2 + 0.35 + 1.3 * flick, roll: -Math.PI / 2, contact: tf < 0 ? 'ball' : undefined },
						{ at: far, pose: 'open', dir: -Math.PI / 2 + 0.1 + 0.6 * flick, roll: Math.PI / 2, contact: tf < 0 ? 'ball' : undefined },
					],
				});
				// the teammates wait with the knees a little bent and follow the ball with their heads
				for (const m of mates) {
					const um = S2 * m.H;
					const hipM: Pt = { x: m.x, y: LANE - 0.5 * um };
					const head = { x: m.x, y: hipM.y - 0.4 * um };
					const look = Math.max(-0.5, Math.min(0.5, Math.atan2(by - head.y, Math.max(8, m.dir * (bx - head.x)))));
					m.f.pose({
						hip: hipM,
						lean: 0.12,
						head: clampH(look),
						ankles: [
							{ x: m.x + m.dir * 3, y: LANE - 0.045 * um },
							{ x: m.x - m.dir * 4, y: LANE - 0.045 * um },
						],
						feet: [0, 0],
						planted: [true, true],
						hands: [
							{ at: { x: m.x + m.dir * 0.2 * um, y: hipM.y + 0.03 * um }, pose: 'relaxed' },
							{ at: { x: m.x + m.dir * 0.16 * um, y: hipM.y + 0.05 * um }, pose: 'relaxed' },
						],
					});
				}
			});
		}
	}
</script>
