---
/**
 * Labelled scheme to «Скорость и координаты»: the same throw as in TwoMotions (υ0x = 6 m/s, υ0y = 7,84 m/s,
 * α = 52,6°, g = 9,8 m/s²; 28 px per m on both axes, 6 px per m/s for the arrows). At the start: υ0 and its
 * projections υ0x, υ0y with the angle α. At the top: the velocity is horizontal and equals υ0x. At the landing: the
 * velocity has the same length υ0 and the same angle α to the horizontal, pointing down (υx = υ0x, υy = −υ0y).
 * H — the greatest height (3,14 m), L — the range (9,6 m).
 */
import BpPicStyles from './BpPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const OX = 34;
const OY = 176;
const K = 28;
const S = 6;
const VX = 6;
const VY = 7.84;
const G = 9.8;
const T = (2 * VY) / G;
const f1 = (v: number) => v.toFixed(1);
const path = Array.from({ length: 41 }, (_, i) => {
	const t = (T * i) / 40;
	return `${f1(OX + VX * t * K)} ${f1(OY - (VY * t - (G * t * t) / 2) * K)}`;
}).join(' L ');
const top = { x: OX + (VX * T * K) / 2, y: OY - ((VY * VY) / (2 * G)) * K };
const end = { x: OX + VX * T * K, y: OY };
const a = Math.atan2(VY, VX);
const R = 18;
const arc0 = `M ${f1(OX + R)} ${OY} A ${R} ${R} 0 0 0 ${f1(OX + R * Math.cos(a))} ${f1(OY - R * Math.sin(a))}`;
const R2 = 15;
const arc1 = `M ${f1(end.x + R2)} ${OY} A ${R2} ${R2} 0 0 1 ${f1(end.x + R2 * Math.cos(a))} ${f1(OY + R2 * Math.sin(a))}`;
const LDIM = 212;
/** A small arrow over a letter that starts at x (the vector sign). */
const over = (x: number, y: number, w = 9) => `M ${f1(x)} ${f1(y)} L ${f1(x + w)} ${f1(y)} M ${f1(x + w - 2.5)} ${f1(y - 2)} L ${f1(x + w)} ${f1(y)} L ${f1(x + w - 2.5)} ${f1(y + 2)}`;
---

<BpPicStyles />
<figure class="bp-pic not-content">
	<svg class="bp-pic__svg" viewBox="0 0 360 236" role="img" aria-label="Схема полёта тела, брошенного под углом альфа к горизонту. В начале начальная скорость и её проекции на оси x и y. В верхней точке скорость горизонтальна. При падении скорость такая же по модулю, как при броске, и направлена под тем же углом к горизонту, но вниз. Отмечены наибольшая высота H и дальность полёта L">
		<defs>
			{
				['v', 'x', 'y', 'axis'].map((k) => (
					<marker id={`${uid}-${k}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth={k === 'axis' ? 7 : 5} markerHeight={k === 'axis' ? 7 : 5} orient="auto">
						<path class={`bp-head--${k}`} d="M0,0 L10,5 L0,10 z" />
					</marker>
				))
			}
			<marker id={`${uid}-d`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
				<path class="bp-ovl" d="M0,1 L9,5 L0,9" />
			</marker>
		</defs>
		<!-- axes and the path -->
		<line class="bp-axis" x1={OX} y1={OY} x2="352" y2={OY} marker-end={`url(#${uid}-axis)`}></line>
		<line class="bp-axis" x1={OX} y1={OY} x2={OX} y2="18" marker-end={`url(#${uid}-axis)`}></line>
		<text class="bp-math" x="344" y={OY - 8}>x</text>
		<text class="bp-math" x={OX + 8} y="26">y</text>
		<text class="bp-math" x={OX - 16} y={OY + 18}>O</text>
		<path class="bp-path" d={`M ${path}`}></path>

		<!-- H and L -->
		<line class="bp-dash" x1={f1(top.x)} y1={f1(top.y + 4)} x2={f1(top.x)} y2={OY}></line>
		<line class="bp-ovl" x1={f1(top.x + 10)} y1={f1(top.y + 1)} x2={f1(top.x + 10)} y2={OY - 1} marker-start={`url(#${uid}-d)`} marker-end={`url(#${uid}-d)`}></line>
		<text class="bp-math" x={f1(top.x + 15)} y={f1((top.y + OY) / 2 + 6)}>H</text>
		<line class="bp-dash" x1={OX} y1={OY + 4} x2={OX} y2={LDIM + 6}></line>
		<line class="bp-dash" x1={f1(end.x)} y1={OY + 4} x2={f1(end.x)} y2={LDIM + 6}></line>
		<line class="bp-ovl" x1={OX + 1} y1={LDIM} x2={f1(end.x - 1)} y2={LDIM} marker-start={`url(#${uid}-d)`} marker-end={`url(#${uid}-d)`}></line>
		<text class="bp-math" x={f1((OX + end.x) / 2)} y={LDIM + 18} text-anchor="middle">L</text>

		<!-- at the start: υ0, its projections and α -->
		<line class="bp-dash" x1={OX + VX * S} y1={f1(OY - VY * S)} x2={OX + VX * S} y2={OY}></line>
		<line class="bp-dash" x1={OX + VX * S} y1={f1(OY - VY * S)} x2={OX} y2={f1(OY - VY * S)}></line>
		<path class="bp-ovl" d={arc0}></path>
		<text class="bp-math" x={OX + 21} y={OY - 6}>α</text>
		<line class="bp-vec bp-vec--x" x1={OX} y1={OY} x2={OX + VX * S - 3} y2={OY} marker-end={`url(#${uid}-x)`}></line>
		<line class="bp-vec bp-vec--y" x1={OX} y1={OY} x2={OX} y2={f1(OY - VY * S + 3)} marker-end={`url(#${uid}-y)`}></line>
		<line class="bp-vec bp-vec--v" x1={OX} y1={OY} x2={f1(OX + VX * S - 2)} y2={f1(OY - VY * S + 2.6)} marker-end={`url(#${uid}-v)`}></line>
		<text class="bp-math bp-cv" x={OX + VX * S - 4} y={f1(OY - VY * S - 6)}>υ<tspan class="bp-sub" dy="4">0</tspan></text>
		<path class="bp-ovl" d={over(OX + VX * S - 4, OY - VY * S - 20)}></path>
		<text class="bp-math bp-cx" x={OX + 10} y={OY + 19}>υ<tspan class="bp-sub" dy="4">0x</tspan></text>
		<text class="bp-math bp-cy" x={OX - 6} y={f1(OY - (VY * S) / 2 + 4)} text-anchor="end">υ<tspan class="bp-sub" dy="4">0y</tspan></text>

		<!-- at the top -->
		<line class="bp-vec bp-vec--v" x1={f1(top.x)} y1={f1(top.y)} x2={f1(top.x + VX * S - 3)} y2={f1(top.y)} marker-end={`url(#${uid}-v)`}></line>
		<text class="bp-math bp-cv" x={f1(top.x + 4)} y={f1(top.y - 10)}>υ<tspan class="bp-up" dx="3"> = </tspan>υ<tspan class="bp-sub" dy="4">0x</tspan></text>
		<circle class="bp-ball" cx={f1(top.x)} cy={f1(top.y)} r="4"></circle>

		<!-- at the landing -->
		<path class="bp-ovl" d={arc1}></path>
		<text class="bp-math" x={f1(end.x + 15)} y={OY + 17}>α</text>
		<line class="bp-vec bp-vec--x" x1={f1(end.x)} y1={OY} x2={f1(end.x + VX * S - 3)} y2={OY} marker-end={`url(#${uid}-x)`}></line>
		<line class="bp-dash" x1={f1(end.x)} y1={f1(OY + VY * S)} x2={f1(end.x + VX * S)} y2={f1(OY + VY * S)}></line>
		<line class="bp-vec bp-vec--y" x1={f1(end.x + VX * S)} y1={OY} x2={f1(end.x + VX * S)} y2={f1(OY + VY * S - 3)} marker-end={`url(#${uid}-y)`}></line>
		<line class="bp-vec bp-vec--v" x1={f1(end.x)} y1={OY} x2={f1(end.x + VX * S - 2)} y2={f1(OY + VY * S - 2.6)} marker-end={`url(#${uid}-v)`}></line>
		<text class="bp-math bp-cx" x={f1(end.x + 6)} y={OY - 8}>υ<tspan class="bp-sub" dy="4">x</tspan></text>
		<text class="bp-math bp-cy" x={f1(end.x + VX * S + 4)} y={f1(OY + (VY * S) / 2 + 2)}>υ<tspan class="bp-sub" dy="4">y</tspan></text>
		<text class="bp-math bp-cv" x={f1(end.x + 4)} y={f1(OY + VY * S + 2)}>υ</text>
		<path class="bp-ovl" d={over(end.x + 4, OY + VY * S - 12)}></path>
	</svg>
	<div class="bp-pic__foot">
		<figcaption>Начальная скорость <i>υ</i><sub>0</sub> и её проекции <i>υ</i><sub>0<i>x</i></sub> и <i>υ</i><sub>0<i>y</i></sub>. В верхней точке скорость направлена горизонтально и равна <i>υ</i><sub>0<i>x</i></sub>. При падении скорость по модулю снова равна <i>υ</i><sub>0</sub> и направлена под тем же углом <i>α</i> к горизонту, но вниз. <i>H</i> — наибольшая высота подъёма, <i>L</i> — дальность полёта.</figcaption>
	</div>
</figure>
