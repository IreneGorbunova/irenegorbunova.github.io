---
/**
 * Picture to «Скорость и координаты», after the vector formulas υ = υ0 + g·t and s = υ0·t + g·t²/2. The common throw
 * of the chapter (TwoMotions, ProjectileScheme): υ0x = 6 м/с, υ0y = 7,84 м/с (υ0 = 9,87 м/с, α = 52,6°), g = 9,8 м/с²;
 * top 3,14 м at 0,8 с, landing at 1,6 с, 9,6 м away. One time cursor runs through both panels, slowed down 2,5 times
 * (1,6 с of flight in 4 с); marks stay at t = 0,4; 0,8; 1,2; 1,6 с.
 * Left, «Перемещение» (15 px per м on both axes): without gravity the ball would fly along the dashed straight line and
 *   be at υ0·t: (2,4; 3,14), (4,8; 6,27), (7,2; 9,41), (9,6; 12,54) м at the marks. From there a green arrow goes
 *   straight down by g·t²/2 = 0,78; 3,14; 7,06; 12,54 м and ends on the parabola at (2,4; 2,35), (4,8; 3,14),
 *   (7,2; 2,35), (9,6; 0) м. The violet displacement s from O to the ball is the sum of the gray υ0·t and the green
 *   g·t²/2 (the triangle rule).
 * Right, «Скорость» (10 px per м/с on both axes): the velocities at the marks drawn from one point. Their tips lie on
 *   one vertical line υx = 6 м/с, at υy = 7,84; 3,92; 0; −3,92; −7,84 м/с; between neighboring tips green arrows
 *   Δυ = g·Δt = 9,8 · 0,4 = 3,92 м/с, all equal and vertical, down. The current velocity (gold, thick) moves with the
 *   cursor.
 */
import BpPicStyles from './BpPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const f1 = (v: number) => v.toFixed(1);
const VX = 6;
const VY = 7.84;
const G = 9.8;
const T = (2 * VY) / G;
// left panel
const K = 15;
const OX = 62;
const OY = 214;
const traj = Array.from({ length: 41 }, (_, i) => {
	const t = (T * i) / 40;
	return `${f1(OX + VX * t * K)} ${f1(OY - (VY * t - (G * t * t) / 2) * K)}`;
}).join(' L ');
const MARKS = [0.4, 0.8, 1.2, 1.6];
// right panel
const V = 10;
const PX = 112;
const PY = 118;
const TIPS = [0, 0.4, 0.8, 1.2, 1.6];
const MK = ['v', 'g', 's', 'line', 'axis'];
---

<BpPicStyles />
<figure class="bp-pic not-content" data-bpvec>
	<div class="bp-pic__row">
		<svg class="bp-pic__svg" viewBox="0 0 360 236" role="img" aria-label="Перемещение тела, брошенного под углом к горизонту: без притяжения тело летело бы по прямой вдоль начальной скорости; на самом деле за время t оно опускается ниже этой прямой на g t в квадрате пополам. Перемещение равно сумме этих двух векторов">
			<defs>
				{
					MK.map((k) => (
						<marker id={`${uid}-${k}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth={k === 'axis' ? 7 : 5} markerHeight={k === 'axis' ? 7 : 5} orient="auto">
							<path class={`bp-head--${k}`} d="M0,0 L10,5 L0,10 z" />
						</marker>
					))
				}
			</defs>
			<text class="bp-title" x="350" y="20" text-anchor="end">Перемещение</text>
			<line class="bp-axis" x1={OX} y1={OY} x2="350" y2={OY} marker-end={`url(#${uid}-axis)`}></line>
			<line class="bp-axis" x1={OX} y1={OY} x2={OX} y2="14" marker-end={`url(#${uid}-axis)`}></line>
			<text class="bp-math" x="340" y={OY + 20}>x</text>
			<text class="bp-math" x={OX - 18} y="26">y</text>
			<text class="bp-math" x={OX - 16} y={OY + 18}>O</text>
			<line class="bp-dash" x1={OX} y1={OY} x2={f1(OX + VX * T * K)} y2={f1(OY - VY * T * K)}></line>
			<path class="bp-path" d={`M ${traj}`}></path>
			<text x={f1(OX + VX * T * K + 8)} y={f1(OY - VY * T * K + 20)}>без притяжения</text>
			<g data-marks>
				{
					MARKS.map((t) => {
						const lx = OX + VX * t * K;
						const ly = OY - VY * t * K;
						const by = OY - (VY * t - (G * t * t) / 2) * K;
						return (
							<g style="opacity: 0">
								<circle class="bp-ghost" cx={f1(lx)} cy={f1(ly)} r="2.5" style="stroke: var(--sl-color-gray-3)" />
								<line class="bp-vec bp-vec--g" style="stroke-width: 1.4; opacity: 0.6" x1={f1(lx)} y1={f1(ly)} x2={f1(lx)} y2={f1(by - 3)} marker-end={`url(#${uid}-g)`} />
								<circle class="bp-ghost" cx={f1(lx)} cy={f1(by)} r="4.5" />
							</g>
						);
					})
				}
			</g>
			<line class="bp-vec bp-vec--line" data-a-line marker-end={`url(#${uid}-line)`}></line>
			<line class="bp-vec bp-vec--g" data-a-g marker-end={`url(#${uid}-g)`}></line>
			<line class="bp-vec bp-vec--s" data-a-s marker-end={`url(#${uid}-s)`}></line>
			<circle class="bp-ball" r="5.5" data-ball></circle>
			<text class="bp-math" style="fill: var(--sl-color-gray-2)" data-l-line>υ<tspan class="bp-sub" dy="4">0</tspan><tspan dy="-4">t</tspan></text>
			<text class="bp-math bp-cg" data-l-g>gt²/2</text>
			<text class="bp-math bp-cs" data-l-s>s</text>
		</svg>
		<svg class="bp-pic__svg" viewBox="0 0 360 236" role="img" aria-label="Скорости тела в моменты 0; 0,4; 0,8; 1,2 и 1,6 секунды, отложенные от одной точки: их концы лежат на одной вертикальной прямой, и каждая следующая скорость отличается от предыдущей на одну и ту же величину g дельта t, направленную вниз">
			<text class="bp-title" x="350" y="20" text-anchor="end">Скорость</text>
			<line class="bp-axis" x1="40" y1={PY} x2="300" y2={PY} marker-end={`url(#${uid}-axis)`}></line>
			<line class="bp-axis" x1={PX} y1="226" x2={PX} y2="28" marker-end={`url(#${uid}-axis)`}></line>
			<text class="bp-math bp-cx" x="284" y={PY - 9}>υ<tspan class="bp-sub" dy="4">x</tspan></text>
			<text class="bp-math bp-cy" x={PX - 30} y="40">υ<tspan class="bp-sub" dy="4">y</tspan></text>
			<line class="bp-dash" x1={PX + VX * V} y1="30" x2={PX + VX * V} y2="226"></line>
			<text x={PX + VX * V + 26} y="222"><tspan class="bp-math bp-cx" style="font-size: 15px">υ</tspan><tspan class="bp-sub bp-cx" dy="3">x</tspan><tspan dy="-3"> = 6 м/с</tspan></text>
			<g data-tips>
				{
					TIPS.map((t) => {
						const vy = VY - G * t;
						return <line class="bp-vec bp-vec--v" style="stroke-width: 1.4; opacity: 0" x1={PX} y1={PY} x2={f1(PX + VX * V - 2.6)} y2={f1(PY - vy * V + (vy * 2.6) / VX)} marker-end={`url(#${uid}-v)`} />;
					})
				}
			</g>
			<g data-dv>
				{
					TIPS.slice(1).map((t) => {
						const y0 = PY - (VY - G * (t - 0.4)) * V;
						const y1 = PY - (VY - G * t) * V;
						return <line class="bp-vec bp-vec--g" style="opacity: 0" x1={PX + VX * V + 9} y1={f1(y0 + 1)} x2={PX + VX * V + 9} y2={f1(y1 - 4)} marker-end={`url(#${uid}-g)`} />;
					})
				}
			</g>
			<text class="bp-math bp-cg" x={PX + VX * V + 18} y={PY + 34} data-dvlabel style="opacity: 0">Δυ = gΔt</text>
			<text class="bp-math bp-cv" x={PX + VX * V - 24} y={f1(PY - VY * V - 4)}>υ<tspan class="bp-sub" dy="4">0</tspan></text>
			<line class="bp-vec bp-vec--v" data-v marker-end={`url(#${uid}-v)`}></line>
			<circle class="bp-ball" cx={PX} cy={PY} r="3"></circle>
			<text class="bp-math bp-cv" data-vlabel>υ</text>
		</svg>
	</div>
	<div class="bp-pic__foot">
		<figcaption>Слева: без притяжения тело летело бы по прямой и оказалось бы в точке <i>υ</i><sub>0</sub><i>t</i>, а на самом деле оно ниже на <i>gt</i>²/2; перемещение <i>s</i> — сумма этих двух векторов. Справа: скорости в моменты 0; 0,4; 0,8; 1,2; 1,6&nbsp;с, отложенные от одной точки, — каждые 0,4&nbsp;с скорость меняется на одно и то же <i>g</i>Δ<i>t</i>, вниз (замедлено в 2,5 раза).</figcaption>
		<button type="button" class="bp-pic__again" data-again>Повторить</button>
	</div>
</figure>

<script>
	import { scene } from '@components/intro/scene';

	const f1 = (v: number) => v.toFixed(1);
	const VX = 6;
	const VY = 7.84;
	const G = 9.8;
	const T = (2 * VY) / G;
	const K = 15;
	const OX = 62;
	const OY = 214;
	const V = 10;
	const PX = 112;
	const PY = 118;
	const SLOW = 2.5;
	const MARKS = [0.4, 0.8, 1.2, 1.6];
	const TIPS = [0, 0.4, 0.8, 1.2, 1.6];

	for (const root of document.querySelectorAll<HTMLElement>('[data-bpvec]')) {
		const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const set = (el: Element, a: Record<string, number>) => {
			for (const [k, v] of Object.entries(a)) el.setAttribute(k, f1(v));
		};
		/** A line from a to b that stops `back` px short of b, so the arrow head ends at b. */
		const arrow = (el: Element, ax: number, ay: number, bx: number, by: number, back = 3) => {
			const d = Math.hypot(bx - ax, by - ay);
			const show = d > back + 3;
			(el as SVGElement).style.opacity = show ? '1' : '0';
			if (!show) return;
			set(el, { x1: ax, y1: ay, x2: bx - ((bx - ax) * back) / d, y2: by - ((by - ay) * back) / d });
		};
		const ball = $('[data-ball]');
		const aLine = $('[data-a-line]');
		const aG = $('[data-a-g]');
		const aS = $('[data-a-s]');
		const lLine = $<SVGTextElement>('[data-l-line]');
		const lG = $<SVGTextElement>('[data-l-g]');
		const lS = $<SVGTextElement>('[data-l-s]');
		const marks = [...root.querySelectorAll<SVGGElement>('[data-marks] > g')];
		const tips = [...root.querySelectorAll<SVGLineElement>('[data-tips] > line')];
		const dvs = [...root.querySelectorAll<SVGLineElement>('[data-dv] > line')];
		const dvLabel = $<SVGTextElement>('[data-dvlabel]');
		const vArrow = $('[data-v]');
		const vLabel = $<SVGTextElement>('[data-vlabel]');
		scene(root, T * SLOW, (s) => {
			const t = s * T;
			// left: the straight line, the drop and the displacement
			const lx = OX + VX * t * K;
			const ly = OY - VY * t * K;
			const by = OY - (VY * t - (G * t * t) / 2) * K;
			set(ball, { cx: lx, cy: by });
			arrow(aLine, OX, OY, lx, ly);
			arrow(aG, lx, ly, lx, by);
			arrow(aS, OX, OY, lx, by);
			const on = (el: SVGElement, v: boolean) => (el.style.opacity = v ? '1' : '0');
			on(lLine, t > 0.15);
			set(lLine, { x: (OX + lx) / 2 - 30, y: (OY + ly) / 2 - 2 });
			on(lG, by - ly > 14);
			set(lG, { x: lx + 7, y: (ly + by) / 2 + 5 });
			on(lS, t > 0.15);
			set(lS, { x: (OX + lx) / 2 + 6, y: (OY + by) / 2 + 14 });
			marks.forEach((m, k) => (m.style.opacity = t >= MARKS[k] - 1e-6 ? '1' : '0'));
			// right: the velocities from one point
			tips.forEach((l, k) => (l.style.opacity = t >= TIPS[k] - 1e-6 ? '0.55' : '0'));
			dvs.forEach((l, k) => (l.style.opacity = t >= TIPS[k + 1] - 1e-6 ? '1' : '0'));
			on(dvLabel, t >= 0.4 - 1e-6);
			const vy = VY - G * t;
			arrow(vArrow, PX, PY, PX + VX * V, PY - vy * V, 2.6);
			set(vLabel, { x: PX + (VX * V) / 2 - 16, y: PY - (vy * V) / 2 + (vy >= 0 ? -4 : 16) });
			vLabel.style.opacity = t > 0.05 ? '1' : '0';
		});
	}
</script>
