---
/**
 * Picture to «Дальность полёта», after the list of consequences. υ0 = 20 м/с, g = 9,8 м/с², no air.
 * Left: the trajectory for the chosen angle α (gold, solid) and for its twin 90° − α (gold, dashed), 7,5 px per м on
 *   both axes (0…42 м × 0…20 м). The two balls leave together and fly in real time: the flatter one lands first, the
 *   steeper one later, at the same spot.
 * Right: the graph L(α) = υ0²·sin 2α / g for α from 0 to 90° (L_max = 40,8 м at 45°); the points α and 90° − α on it are
 *   joined by a horizontal dashed line.
 * Buttons 15°, 30°, 45°, 60°, 75° (they cycle by themselves until one is tapped). Readouts for α and 90° − α:
 *   15° — L 20,4 м, H 1,37 м, t 1,06 с; 30° — 35,3 м, 5,10 м, 2,04 с; 45° — 40,8 м, 10,2 м, 2,89 с;
 *   60° — 35,3 м, 15,3 м, 3,53 с; 75° — 20,4 м, 19,0 м, 3,94 с.
 */
import BpPicStyles from './BpPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const f1 = (v: number) => v.toFixed(1);
const V0 = 20;
const G = 9.8;
// left
const OX = 30;
const OY = 176;
const K = 7.5;
// right
const AX = 46;
const KA = 3.25; // px per degree
const KL = 3.3; // px per м
const curveL = Array.from({ length: 91 }, (_, a) => `${f1(AX + a * KA)} ${f1(OY - ((V0 * V0 * Math.sin((2 * a * Math.PI) / 180)) / G) * KL)}`).join(' L ');
const ANGLES = [15, 30, 45, 60, 75];
---

<BpPicStyles />
<figure class="bp-pic not-content" data-bprange>
	<div class="bp-pic__row">
		<svg class="bp-pic__svg" viewBox="0 0 360 200" role="img" aria-label="Траектории двух тел, брошенных с одинаковой скоростью 20 метров в секунду под углами альфа и 90 градусов минус альфа: они падают в одну точку">
			<defs>
				<marker id={`${uid}-axis`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto">
					<path class="bp-head--axis" d="M0,0 L10,5 L0,10 z" />
				</marker>
			</defs>
			{[10, 20, 30, 40].map((m) => <line class="bp-grid" x1={OX + m * K} y1={OY} x2={OX + m * K} y2={OY - 20 * K} />)}
			{[10, 20].map((m) => <line class="bp-grid" x1={OX} y1={OY - m * K} x2={OX + 42 * K} y2={OY - m * K} />)}
			<line class="bp-axis" x1={OX} y1={OY} x2="352" y2={OY} marker-end={`url(#${uid}-axis)`}></line>
			<line class="bp-axis" x1={OX} y1={OY} x2={OX} y2="16" marker-end={`url(#${uid}-axis)`}></line>
			{[10, 20, 30, 40].map((m) => <text x={OX + m * K} y={OY + 17} text-anchor="middle">{m}</text>)}
			{[10, 20].map((m) => <text x={OX - 5} y={OY - m * K + 4} text-anchor="end">{m}</text>)}
			<text x="350" y={OY - 6} text-anchor="end"><tspan class="bp-math" style="font-size: 14px">x</tspan>, м</text>
			<text x={OX + 7} y="24"><tspan class="bp-math" style="font-size: 14px">y</tspan>, м</text>
			<path class="bp-rg-path" d="" data-p1></path>
			<path class="bp-rg-path bp-rg-path--twin" d="" data-p2></path>
			<circle class="bp-ball" r="5" data-b1></circle>
			<circle class="bp-ball" r="5" data-b2></circle>
			<text class="bp-math bp-cv" data-l1></text>
			<text class="bp-math bp-cv" data-l2></text>
		</svg>
		<svg class="bp-pic__svg" viewBox="0 0 360 200" role="img" aria-label="График зависимости дальности полёта от угла броска при скорости 20 метров в секунду: наибольшая дальность 40,8 метра при 45 градусах, углы альфа и 90 градусов минус альфа дают одну и ту же дальность">
			{[10, 20, 30, 40].map((m) => <line class="bp-grid" x1={AX} y1={OY - m * KL} x2={AX + 90 * KA} y2={OY - m * KL} />)}
			{[15, 30, 45, 60, 75, 90].map((a) => <line class="bp-grid" x1={AX + a * KA} y1={OY} x2={AX + a * KA} y2={OY - 45 * KL} />)}
			<line class="bp-axis" x1={AX} y1={OY} x2={AX + 90 * KA + 4} y2={OY}></line>
			<line class="bp-axis" x1={AX} y1={OY} x2={AX} y2="20"></line>
			{[0, 15, 30, 45, 60, 75, 90].map((a) => <text x={AX + a * KA} y={OY + 17} text-anchor="middle">{a}°</text>)}
			{[10, 20, 30, 40].map((m) => <text x={AX - 5} y={OY - m * KL + 4} text-anchor="end">{m}</text>)}
			<text x={AX + 6} y="18"><tspan class="bp-math" style="font-size: 14px">L</tspan>, м</text>
			<text x="358" y={OY + 4} text-anchor="end"><tspan class="bp-math" style="font-size: 14px">α</tspan></text>
			<path class="bp-path" style="stroke: var(--ig-v); stroke-width: 2.2" d={`M ${curveL}`}></path>
			<line class="bp-dash" data-hl></line>
			<line class="bp-dash" data-v1></line>
			<line class="bp-dash" data-v2></line>
			<circle class="bp-ball" r="5" data-q1></circle>
			<circle class="bp-rg-twin" r="5" data-q2></circle>
			<text class="bp-rg-val" text-anchor="middle" data-lv></text>
		</svg>
	</div>
	<div class="bp-rg-ctrl">
		<span class="bp-rg-label">Угол броска <i>α</i>:</span>
		<span class="bp-rg-seg" role="group" aria-label="Угол броска" data-seg>
			{ANGLES.map((a) => <button type="button" class="bp-rg-btn" aria-pressed={a === 30 ? 'true' : 'false'} data-a={a}>{a}°</button>)}
		</span>
	</div>
	<p class="bp-read" data-read></p>
	<div class="bp-pic__foot">
		<figcaption>Тела брошены с одной скоростью 20&nbsp;м/с под углами <i>α</i> (сплошная линия) и 90°&nbsp;−&nbsp;<i>α</i> (пунктир) и летят в реальном времени. На графике дальности <i>L</i>(<i>α</i>) видно: дальше всего тело летит при 45°, а два угла, дополняющие друг друга до 90°, дают одну дальность.</figcaption>
	</div>
</figure>

<style is:global>
	.bp-rg-path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.2;
	}
	.bp-rg-path--twin {
		stroke-dasharray: 6 4;
	}
	.bp-rg-twin {
		fill: var(--sl-color-bg);
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.bp-pic .bp-rg-val {
		font-size: 13px;
		fill: var(--sl-color-gray-1);
	}
	.bp-rg-ctrl {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.4rem 0.6rem;
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.bp-rg-ctrl i,
	.bp-pic .bp-read i {
		font-family: var(--ig-font-math);
	}
	.bp-rg-seg {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.bp-rg-btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		min-width: 3.2rem;
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.bp-rg-btn[aria-pressed='true'] {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.bp-rg-btn:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.bp-pic .bp-read {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		text-align: center;
	}
	.bp-pic .bp-read span {
		white-space: nowrap;
	}
</style>

<script>
	import { loop, fmt } from '@components/ch/g7/kit';

	const f1 = (v: number) => v.toFixed(1);
	const V0 = 20;
	const G = 9.8;
	const OX = 30;
	const OY = 176;
	const K = 7.5;
	const AX = 46;
	const KA = 3.25;
	const KL = 3.3;
	const ANGLES = [15, 30, 45, 60, 75];
	const PAUSE = 1.5; // s after the later ball has landed
	const rad = (a: number) => (a * Math.PI) / 180;
	const fly = (a: number) => {
		const vx = V0 * Math.cos(rad(a));
		const vy = V0 * Math.sin(rad(a));
		const T = (2 * vy) / G;
		return { vx, vy, T, L: vx * T, H: (vy * vy) / (2 * G) };
	};
	const pt = (f: ReturnType<typeof fly>, t: number) => ({ x: OX + f.vx * t * K, y: OY - (f.vy * t - (G * t * t) / 2) * K });
	const pathTo = (f: ReturnType<typeof fly>, t: number) => {
		const n = Math.max(2, Math.ceil(t / 0.04));
		const p: string[] = [];
		for (let i = 0; i <= n; i++) {
			const q = pt(f, (t * i) / n);
			p.push(`${f1(q.x)} ${f1(q.y)}`);
		}
		return `M ${p.join(' L ')}`;
	};
	const line = (a: number, f: ReturnType<typeof fly>) =>
		`<span><i>α</i> = ${a}°: <i>L</i> = ${fmt(f.L, 1)} м, <i>H</i> = ${fmt(f.H, f.H < 10 ? 2 : 1)} м, <i>t</i><sub>пол</sub> = ${fmt(f.T, 2)} с</span>`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-bprange]')) {
		const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const p1 = $('[data-p1]');
		const p2 = $('[data-p2]');
		const b1 = $('[data-b1]');
		const b2 = $('[data-b2]');
		const l1 = $('[data-l1]');
		const l2 = $('[data-l2]');
		const q1 = $('[data-q1]');
		const q2 = $('[data-q2]');
		const hl = $('[data-hl]');
		const v1 = $('[data-v1]');
		const v2 = $('[data-v2]');
		const lv = $('[data-lv]');
		const read = $<HTMLElement>('[data-read]');
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-a]')];
		let a = 30;
		let t = 0;
		let auto = true;
		const set = (el: Element, o: Record<string, number | string>) => {
			for (const [k, v] of Object.entries(o)) el.setAttribute(k, typeof v === 'number' ? f1(v) : v);
		};
		const choose = (na: number) => {
			a = na;
			t = 0;
			for (const b of btns) b.setAttribute('aria-pressed', String(Number(b.dataset.a) === a));
			const f = fly(a);
			const tw = 90 - a;
			const ft = fly(tw);
			// the graph
			const y = OY - f.L * KL;
			set(q1, { cx: AX + a * KA, cy: y });
			set(q2, { cx: AX + tw * KA, cy: y });
			(q2 as SVGElement).style.opacity = a === 45 ? '0' : '1';
			set(hl, { x1: AX, y1: y, x2: AX + Math.max(a, tw) * KA, y2: y });
			set(v1, { x1: AX + a * KA, y1: y, x2: AX + a * KA, y2: OY });
			set(v2, { x1: AX + tw * KA, y1: y, x2: AX + tw * KA, y2: OY });
			// the value at the marked points: under the dashed line between them, or above the single point at 45°
			set(lv, { x: AX + 45 * KA, y: a === 45 ? y - 10 : y + 17 });
			lv.textContent = `L = ${fmt(f.L, 1)} м`;
			read.innerHTML = a === 45 ? line(45, f) : `${line(a, f)}; ${line(tw, ft)}`;
			l1.textContent = `${a}°`;
			l2.textContent = `${tw}°`;
			const top1 = pt(f, f.T / 2);
			const top2 = pt(ft, ft.T / 2);
			set(l1, { x: top1.x - 6, y: top1.y - 9 });
			set(l2, { x: top2.x + 8, y: top2.y - 4 });
			(l2 as SVGElement).style.opacity = a === 45 ? '0' : '1';
			wake();
		};
		for (const b of btns)
			b.addEventListener('click', () => {
				auto = false;
				choose(Number(b.dataset.a));
			});
		const draw = () => {
			const f = fly(a);
			const ft = fly(90 - a);
			const t1 = Math.min(t, f.T);
			const t2 = Math.min(t, ft.T);
			p1.setAttribute('d', pathTo(f, t1));
			p2.setAttribute('d', a === 45 ? '' : pathTo(ft, t2));
			const c1 = pt(f, t1);
			const c2 = pt(ft, t2);
			set(b1, { cx: c1.x, cy: c1.y });
			set(b2, { cx: c2.x, cy: c2.y });
			(b2 as SVGElement).style.opacity = a === 45 ? '0' : '1';
		};
		const wake = loop(root, (dt) => {
			t += dt;
			draw();
			const end = Math.max(fly(a).T, fly(90 - a).T);
			if (t > end + PAUSE) {
				if (!auto) {
					t = end;
					return false;
				}
				choose(ANGLES[(ANGLES.indexOf(a) + 1) % ANGLES.length]);
			}
			return true;
		});
		choose(30);
	}
</script>
