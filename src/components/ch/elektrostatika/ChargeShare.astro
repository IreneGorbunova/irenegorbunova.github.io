---
/**
 * «Два шара»: two identical metal balls on insulating stands. The sliders give their charges, −8 … +8 нКл.
 * «Соприкоснуть» brings ball 2 to ball 1: electrons flow through the contact until the charges are equal, each
 * (q₁ + q₂)/2, because the balls are identical; then ball 2 goes back. The sum q₁ + q₂ stays the same: the two balls
 * are a closed system. «Заземлить шар 1» joins ball 1 to the ground by a wire: its charge goes to the Earth (or comes
 * from it), q₁ becomes 0 and the sum changes — the system is no longer closed.
 *
 * The signs are drawn at the surface of the balls (the charge of a conductor sits on its surface): one sign per
 * нанокулон, a small sign for a half. Each moving dot stands for many electrons: the readout gives their number,
 * |Δq| / e with e = 1,6·10⁻¹⁹ Кл (1 нКл is 6,25·10⁹ electrons). The motion is slowed: in reality the charges level in
 * a tiny fraction of a second.
 */
import G7Styles from '../g7/G7Styles.astro';

const B1 = 96; // ball 1, px
const B2 = 224; // ball 2 at rest
const Y = 88; // centers of the balls
const R = 26;
---

<G7Styles />
<figure class="g7 cs not-content" data-cs>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 320 202" role="img" aria-label="Два одинаковых металлических шара на изолирующих подставках; знаки плюс и минус показывают их заряды" data-svg>
			<rect class="cs__table" x="0" y="176" width="320" height="9"></rect>
			<!-- ground for ball 1 -->
			<g class="cs__earth" data-earth opacity="0">
				<path class="cs__wire" d={`M${B1 - R + 4} ${Y + 10} Q30 ${Y + 30} 30 150 V170`}></path>
				<path class="cs__gnd" d="M18 170 H42 M22 175 H38 M26 180 H34"></path>
				<text class="t-small t-halo" x="36" y="150">к земле</text>
			</g>
			{[B1, B2].map((x, i) => (
				<g data-ball={i}>
					<rect class="cs__base" x={x - 22} y="168" width="44" height="8" rx="2" />
					<rect class="cs__rod" x={x - 3} y={Y + R - 2} width="6" height={168 - Y - R + 2} rx="2" />
					<circle class="cs__ball" cx={x} cy={Y} r={R} />
					<ellipse class="cs__shine" cx={x - 9} cy={Y - 10} rx="7" ry="4.5" transform={`rotate(-30 ${x - 9} ${Y - 10})`} />
					<g data-signs />
					<text class="t-strong t-num t-halo" x={x} y={Y - R - 9} text-anchor="middle" data-q />
				</g>
			))}
			<g data-dots></g>
			<text class="t-small" x="96" y="198" text-anchor="middle">шар 1</text>
			<text class="t-small" x="224" y="198" text-anchor="middle">шар 2</text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Заряд шара 1</span>
				<output data-o1></output>
				<input type="range" min="-8" max="8" step="1" value="6" data-q1 aria-label="Заряд шара 1, нанокулоны" />
			</label>
			<label class="g7__slider">
				<span>Заряд шара 2</span>
				<output data-o2></output>
				<input type="range" min="-8" max="8" step="1" value="-2" data-q2 aria-label="Заряд шара 2, нанокулоны" />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-touch>Соприкоснуть</button>
				<button type="button" class="g7__btn" data-ground>Заземлить шар 1</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li>шар 1 <b data-r1></b></li>
				<li>шар 2 <b data-r2></b></li>
				<li class="is-key"><span>сумма <i>q</i><sub>1</sub> + <i>q</i><sub>2</sub></span> <b data-rs></b></li>
				<li>перешло электронов <b data-rn>—</b></li>
			</ul>
			<p class="g7__note" data-msg>Каждый знак — заряд 1&nbsp;нКл, то есть 6,25·10⁹ элементарных зарядов.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Шары одинаковые, подставки не проводят ток. Движение зарядов замедлено: на самом деле заряды выравниваются за ничтожную долю секунды.</figcaption>
</figure>

<style is:global>
	[data-cs] .cs__table {
		fill: var(--g7-wood);
	}
	[data-cs] .cs__base {
		fill: var(--g7-wood-dark);
	}
	[data-cs] .cs__rod {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 40%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	[data-cs] .cs__ball {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-cs] .cs__shine {
		fill: var(--sl-color-white);
		opacity: 0.35;
	}
	[data-cs] .cs__wire {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	[data-cs] .cs__gnd {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.8;
	}
	[data-cs] .cs__plus {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	[data-cs] .cs__minus {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	[data-cs] .cs__e {
		fill: var(--g7-blue);
		stroke: var(--g7-paper);
		stroke-width: 0.8;
	}
</style>

<script>
	import { el, loop } from '../g7/kit';
	import { sci } from './vec';

	const B1 = 96;
	const B2 = 224;
	const TOUCH = B1 + 52;
	const Y = 88;
	const QE = 1.6e-19;
	const fq = (q: number) => {
		const s = (Math.round(q * 10) / 10).toString().replace('.', ',');
		return `${q > 0 ? '+' : q < 0 ? '−' : ''}${s.replace('-', '')} нКл`;
	};
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-cs]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const s1 = $<HTMLInputElement>('[data-q1]');
		const s2 = $<HTMLInputElement>('[data-q2]');
		const balls = [...root.querySelectorAll<SVGGElement>('[data-ball]')];
		const dots = $<SVGGElement>('[data-dots]');
		const earth = $<SVGGElement>('[data-earth]');
		const msg = $('[data-msg]');
		const btnT = $<HTMLButtonElement>('[data-touch]');
		const btnG = $<HTMLButtonElement>('[data-ground]');

		let q = [6, -2]; // charges now, нКл
		let from = [6, -2]; // at the start of the action
		let to = [6, -2]; // at its end
		let act: 'none' | 'touch' | 'ground' = 'none';
		let t = 0;
		let moved = 0; // the charge that went over, нКл
		let x2 = B2;

		// the signs of one ball at its surface: one per нКл, a smaller one for a half
		const signs = (g: SVGGElement, cx: number, qq: number) => {
			g.replaceChildren();
			const n = Math.abs(qq);
			const whole = Math.floor(n + 1e-6);
			const half = n - whole > 0.25;
			const cnt = whole + (half ? 1 : 0);
			for (let i = 0; i < cnt; i++) {
				const a = -Math.PI / 2 + (i * 2 * Math.PI) / Math.max(cnt, 1);
				const x = cx + 17.5 * Math.cos(a);
				const y = Y + 17.5 * Math.sin(a);
				const h = i === cnt - 1 && half ? 2 : 3.6;
				const d = qq > 0 ? `M${x - h} ${y} H${x + h} M${x} ${y - h} V${y + h}` : `M${x - h} ${y} H${x + h}`;
				g.append(el('path', { class: qq > 0 ? 'cs__plus' : 'cs__minus', d }));
			}
		};

		const draw = () => {
			balls.forEach((g, i) => {
				g.setAttribute('transform', i === 1 ? `translate(${(x2 - B2).toFixed(1)} 0)` : '');
				signs(g.querySelector<SVGGElement>('[data-signs]')!, i === 0 ? B1 : B2, q[i]);
				g.querySelector('[data-q]')!.textContent = fq(q[i]);
			});
			$('[data-o1]').textContent = fq(+s1.value);
			$('[data-o2]').textContent = fq(+s2.value);
			$('[data-r1]').textContent = fq(q[0]);
			$('[data-r2]').textContent = fq(q[1]);
			$('[data-rs]').textContent = fq(q[0] + q[1]);
			$('[data-rn]').textContent = moved > 0 ? sci((moved * 1e-9) / QE) : '—';
		};

		// electrons in flight: they go from the more negative body to the other one
		const flight = (u: number, ax: number, ay: number, bx: number, by: number, n: number) => {
			dots.replaceChildren();
			if (u <= 0 || u >= 1) return;
			for (let i = 0; i < n; i++) {
				const p = Math.min(1, Math.max(0, u * 1.6 - (i / n) * 0.6));
				if (p <= 0 || p >= 1) continue;
				const x = ax + (bx - ax) * p;
				const y = ay + (by - ay) * p + Math.sin(p * Math.PI) * 6 * (i % 2 ? 1 : -1);
				dots.append(el('circle', { class: 'cs__e', cx: x.toFixed(1), cy: y.toFixed(1), r: 3 }));
			}
		};

		const wake = loop(root, (dt) => {
			if (act === 'none') return false;
			t += dt;
			if (act === 'touch') {
				// 0–0,8 с: ball 2 rolls to ball 1; 0,8–2,2 с: the charges level; 2,4–3,2 с: back
				x2 = t < 0.8 ? B2 + (TOUCH - B2) * ease(t / 0.8) : t < 2.4 ? TOUCH : TOUCH + (B2 - TOUCH) * ease((t - 2.4) / 0.8);
				const u = (t - 0.8) / 1.4;
				const k = ease(u);
				q = [from[0] + (to[0] - from[0]) * k, from[1] + (to[1] - from[1]) * k];
				// electrons go toward the ball whose charge grows more negative... i.e. against the change of q
				const dq = to[0] - from[0];
				const n = Math.min(8, Math.max(1, Math.round(Math.abs(dq))));
				if (dq !== 0) {
					const [ax, bx] = dq < 0 ? [TOUCH - 18, B1 + 8] : [B1 + 8, TOUCH - 18];
					flight(u, ax, Y, bx, Y, n);
				} else dots.replaceChildren();
				if (t > 3.2) {
					act = 'none';
					x2 = B2;
					q = [...to];
					dots.replaceChildren();
				}
			} else {
				const u = (t - 0.5) / 1.4;
				earth.setAttribute('opacity', String(Math.min(1, t / 0.4)));
				const k = ease(u);
				q = [from[0] + (to[0] - from[0]) * k, from[1]];
				const dq = to[0] - from[0];
				const n = Math.min(8, Math.max(1, Math.round(Math.abs(dq))));
				if (dq !== 0) {
					// along the wire: from the ball to the ground or back
					const pts = dq < 0 ? [30, 168, B1 - 18, Y + 12] : [B1 - 18, Y + 12, 30, 168];
					flight(u, pts[0], pts[1], pts[2], pts[3], n);
				}
				if (t > 2.2) {
					act = 'none';
					q = [...to];
					dots.replaceChildren();
				}
			}
			draw();
			return act !== 'none';
		});

		const busy = () => act !== 'none';
		btnT.addEventListener('click', () => {
			if (busy()) return;
			from = [...q];
			const m = (q[0] + q[1]) / 2;
			to = [m, m];
			moved = Math.abs(q[0] - m);
			earth.setAttribute('opacity', '0');
			act = 'touch';
			t = 0;
			msg.textContent = 'Шары соприкоснулись: заряды разделились поровну. Сумма зарядов не изменилась.';
			wake();
		});
		btnG.addEventListener('click', () => {
			if (busy()) return;
			from = [...q];
			to = [0, q[1]];
			moved = Math.abs(q[0]);
			act = 'ground';
			t = 0;
			msg.textContent = 'Шар 1 соединили с землёй, и его заряд ушёл в землю (или пришёл из неё). Система двух шаров уже не замкнута, и сумма зарядов изменилась.';
			wake();
		});
		const reset = () => {
			if (busy()) return;
			q = [+s1.value, +s2.value];
			moved = 0;
			x2 = B2;
			earth.setAttribute('opacity', '0');
			dots.replaceChildren();
			msg.textContent = 'Каждый знак — заряд 1 нКл, то есть 6,25·10⁹ элементарных зарядов.';
			draw();
		};
		s1.addEventListener('input', reset);
		s2.addEventListener('input', reset);
		reset();
	}
</script>
