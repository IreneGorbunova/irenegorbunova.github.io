---
/**
 * «Два заряда»: two small charged balls (radius 0,4 см, so they are close to point charges) on a ruler, seen from
 * above. The sliders set the charges q₁, q₂ (−5 … +5 нКл) and the distance r (3 … 15 см); ball 2 can also be dragged
 * along the ruler (1 см steps). The force is Coulomb's F = k·|q₁|·|q₂|/r², k = 9·10⁹ Н·м²/Кл², in микроньютонах:
 * from 0,4 мкН (1 нКл and 1 нКл at 15 см) to 250 мкН (5 нКл and 5 нКл at 3 см).
 *
 * The force arrows (gold, the color of this force through the chapter) are equal and opposite, on both balls. Their
 * length is proportional to the force; because the force changes a thousand times, the scale switches by steps of
 * ten (the smallest power of ten that keeps the arrow within 50 px; attracting arrows run 3,5 px off the line) and the
 * scale bar under the ruler always says how many микроньютонов 25 px stand for. The arrows are labelled F⃗₂₁ (on ball 1,
 * from ball 2) and F⃗₁₂ (on ball 2, from ball 1) above their middles; when attracting arrows overlap in the gap the
 * two labels are moved apart around its middle, F⃗₂₁ to the left. Under the picture the
 * model compares the force with the previous setting («было … стало … в N раз»), which is how Coulomb's law is found.
 * Scale of the drawing: 15 px per сантиметр.
 */
import G7Styles from '../g7/G7Styles.astro';
import VlabStyles from './VlabStyles.astro';

const X0 = 22; // 0 см on the ruler
const PX = 15; // px per см
const ticks = Array.from({ length: 21 }, (_, i) => i);
---

<G7Styles />
<VlabStyles />
<figure class="g7 g7--stack cl not-content" data-cl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 150" role="img" aria-label="Два заряженных шарика на линейке и стрелки сил, с которыми они действуют друг на друга" data-svg>
			<rect class="cl__ruler" x={X0 - 8} y="104" width={20 * PX + 16} height="26" rx="3"></rect>
			{ticks.map((i) => <line class="cl__tick" x1={X0 + i * PX} y1="104" x2={X0 + i * PX} y2={i % 5 === 0 ? 116 : 111} />)}
			{ticks.filter((i) => i % 5 === 0).map((i) => <text class="t-small" x={X0 + i * PX} y="127" text-anchor="middle">{i === 20 ? '20 см' : i}</text>)}
			<line class="ln-dash" data-rline x1="0" y1="78" x2="0" y2="78"></line>
			<text class="t-small t-halo" data-rtext x="0" y="96" text-anchor="middle"></text>
			<g data-b1>
				<path class="arrow arrow--gold" data-f1></path>
				<path class="head--gold" data-h1></path>
				<circle class="cl__ball" data-c1 cx="0" cy="62" r="6"></circle>
				<path class="cl__sign" data-s1></path>
				<text class="t-strong t-num t-halo" data-t1 x="0" y="24" text-anchor="middle"></text>
				<g data-l1></g>
			</g>
			<g data-b2>
				<path class="arrow arrow--gold" data-f2></path>
				<path class="head--gold" data-h2></path>
				<circle class="cl__ball drag" data-c2 cx="0" cy="62" r="6"></circle>
				<circle class="drag" data-grab cx="0" cy="62" r="16" fill="transparent"></circle>
				<path class="cl__sign" data-s2></path>
				<text class="t-strong t-num t-halo" data-t2 x="0" y="24" text-anchor="middle"></text>
				<g data-l2></g>
			</g>
			<g data-scale>
				<line class="arrow arrow--gold" x1="12" y1="142" x2="37" y2="142"></line>
				<text class="t-small" x="43" y="146" data-scaletext></text>
			</g>
			<text class="t-small" x="332" y="146" text-anchor="end">вид сверху</text>
		</svg>
		<div class="g7__side cl__side">
			<label class="g7__slider">
				<span>Заряд <i>q</i><sub>1</sub></span>
				<output data-o1></output>
				<input type="range" min="-5" max="5" step="1" value="2" data-q1 aria-label="Заряд первого шарика, нанокулоны" />
			</label>
			<label class="g7__slider">
				<span>Заряд <i>q</i><sub>2</sub></span>
				<output data-o2></output>
				<input type="range" min="-5" max="5" step="1" value="2" data-q2 aria-label="Заряд второго шарика, нанокулоны" />
			</label>
			<label class="g7__slider">
				<span>Расстояние <i>r</i></span>
				<output data-or></output>
				<input type="range" min="3" max="15" step="1" value="6" data-r aria-label="Расстояние между шариками, сантиметры" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li class="is-key"><span>сила взаимодействия <i>F</i></span> <b data-f></b></li>
				<li>было <b data-prev>—</b></li>
				<li>изменилась <b data-ratio>—</b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Длина стрелок пропорциональна силе; масштаб стрелок показан внизу слева и меняется в 10 раз, когда сила становится слишком большой или слишком маленькой. Рисунок в масштабе.</figcaption>
</figure>

<style is:global>
	[data-cl] .cl__ruler {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	[data-cl] .cl__tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-cl] .cl__ball {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-cl] .cl__ball.is-plus {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--g7-steel));
	}
	[data-cl] .cl__ball.is-minus {
		fill: color-mix(in oklab, var(--g7-blue) 55%, var(--g7-steel));
	}
	[data-cl] .cl__sign {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	@container (min-width: 36rem) {
		[data-cl] .cl__side {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		[data-cl] .g7__read {
			grid-column: 1 / -1;
		}
	}
</style>

<script>
	import { drag } from '../g7/kit';
	import { arrow, sig, K } from './vec';
	import { vlabSvg } from './vlab';

	const X0 = 22;
	const PX = 15;
	const fq = (q: number) => `${q > 0 ? '+' : q < 0 ? '−' : ''}${Math.abs(q)} нКл`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-cl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = $<SVGSVGElement>('[data-svg]');
		const s1 = $<HTMLInputElement>('[data-q1]');
		const s2 = $<HTMLInputElement>('[data-q2]');
		const sr = $<HTMLInputElement>('[data-r]');
		const l1 = $<SVGGElement>('[data-l1]');
		const l2 = $<SVGGElement>('[data-l2]');
		l1.innerHTML = vlabSvg('F', '21', 'vl--gold', 13);
		l2.innerHTML = vlabSvg('F', '12', 'vl--gold', 13);
		let prev: number | null = null;
		let last: number | null = null;

		const ball = (i: 1 | 2, x: number, q: number) => {
			const c = $<SVGCircleElement>(`[data-c${i}]`);
			c.setAttribute('cx', x.toFixed(1));
			c.classList.toggle('is-plus', q > 0);
			c.classList.toggle('is-minus', q < 0);
			const h = 3.2;
			$(`[data-s${i}]`).setAttribute('d', q > 0 ? `M${x - h} 62 H${x + h} M${x} ${62 - h} V${62 + h}` : q < 0 ? `M${x - h} 62 H${x + h}` : '');
			const t = $(`[data-t${i}]`);
			t.setAttribute('x', x.toFixed(1));
			t.textContent = fq(q);
		};

		const draw = () => {
			const q1 = +s1.value;
			const q2 = +s2.value;
			const r = +sr.value;
			const x1 = X0 + 2 * PX;
			const x2 = x1 + r * PX;
			ball(1, x1, q1);
			ball(2, x2, q2);
			$('[data-grab]').setAttribute('cx', x2.toFixed(1));
			$('[data-rline]').setAttribute('x1', x1.toFixed(1));
			$('[data-rline]').setAttribute('x2', x2.toFixed(1));
			const rt = $('[data-rtext]');
			rt.setAttribute('x', ((x1 + x2) / 2).toFixed(1));
			rt.textContent = `r = ${r} см`;
			$('[data-o1]').textContent = fq(q1);
			$('[data-o2]').textContent = fq(q2);
			$('[data-or]').textContent = `${r} см`;

			// F in микроньютонах
			const F = (K * Math.abs(q1 * 1e-9) * Math.abs(q2 * 1e-9)) / (r / 100) ** 2 / 1e-6;
			// the scale: 25 px stand for `unit` мкН, the smallest power of ten that keeps the arrow within 50 px
			const rep = q1 * q2 > 0 ? 1 : -1;
			const cap = 50;
			let unit = 1;
			if (F > 0) unit = 10 ** Math.ceil(Math.log10((F * 25) / cap) - 1e-9);
			$('[data-scaletext]').textContent = `${sig(unit)} мкН`;
			const L = (F / unit) * 25;
			// attracting arrows point into the gap: they run 3,5 px above and below the line so they do not hide each other
			const dy = rep > 0 ? 0 : 3.5;
			const a1 = arrow(x1, 62 - dy, x1 - rep * L, 62 - dy);
			const a2 = arrow(x2, 62 + dy, x2 + rep * L, 62 + dy);
			$('[data-f1]').setAttribute('d', a1.line);
			$('[data-h1]').setAttribute('d', a1.head);
			$('[data-f2]').setAttribute('d', a2.line);
			$('[data-h2]').setAttribute('d', a2.head);
			// the labels above the middles of the arrows (at least beside the ball when the arrow is short)
			let m1 = x1 - rep * Math.max(L / 2, 13);
			let m2 = x2 + rep * Math.max(L / 2, 13);
			if (rep < 0 && m2 - m1 < 24) {
				const c = (x1 + x2) / 2;
				m1 = c - 12;
				m2 = c + 12;
			}
			l1.setAttribute('transform', `translate(${m1.toFixed(1)} 47)`);
			l2.setAttribute('transform', `translate(${m2.toFixed(1)} 47)`);
			l1.style.display = F > 0 ? '' : 'none';
			l2.style.display = F > 0 ? '' : 'none';
			$('[data-f]').textContent = `${sig(F)} мкН${F > 0 ? (rep > 0 ? ', отталкивание' : ', притяжение') : ''}`;

			if (last !== null && Math.abs(F - last) > 1e-12) prev = last;
			last = F;
			$('[data-prev]').textContent = prev === null ? '—' : `${sig(prev)} мкН`;
			let ratio = '—';
			if (prev !== null && prev > 0 && F > 0) {
				const k = F / prev;
				const times = (x: number) => {
					// «в 1,5 раза», «в 4 раза», but «в 16 раз», «в 21 раз»
					const t = sig(x);
					if (/[.,]/.test(t)) return `в ${t} раза`;
					const n = Math.round(x) % 100;
					return `в ${t} ${n % 10 >= 2 && n % 10 <= 4 && (n < 12 || n > 14) ? 'раза' : 'раз'}`;
				};
				ratio = k >= 1 ? `больше ${times(k)}` : `меньше ${times(1 / k)}`;
			} else if (prev !== null && F === 0) ratio = 'сила исчезла';
			$('[data-ratio]').textContent = ratio;
		};

		drag($('[data-grab]'), svg, {
			move: (p) => {
				const x1 = X0 + 2 * PX;
				const r = Math.round((p.x - x1) / PX);
				const v = String(Math.min(15, Math.max(3, r)));
				if (v !== sr.value) {
					sr.value = v;
					draw();
				}
			},
		});
		for (const s of [s1, s2, sr]) s.addEventListener('input', draw);
		draw();
	}
</script>
