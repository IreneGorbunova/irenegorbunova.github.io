---
/**
 * «Работа поля»: a uniform field between two plates d = 6 см apart, the voltage between them U = 100 … 600 В
 * (slider), so E = U/d = 1667 … 10 000 Н/Кл (shown in Н/Кл: В/м comes later in the chapter). A charge q = +1 нКл goes from point A (1 см from the «+» plate) to point B
 * (5 см from it, lower) along one of three paths: straight, a step (along the field, then across it), or a loop that
 * first goes 0,77 см toward «+» (the work falls to −0,0386 мкДж at 300 В), turns through a loop and ends at B without
 * ever going farther from «+» than B (so the work never overshoots). While it moves the model adds up the work of the field, A = qE·Δx for every small step (Δx along the field;
 * across the field the work is zero). Every path ends with the same work: at U = 300 В, A = 10⁻⁹ Кл · 5000 В/м ·
 * 0,04 м = 2·10⁻⁷ Дж = 0,2 мкДж, and A/q = 200 В = φ_A − φ_B.
 * The dashed lines are the equipotential lines, every сантиметр, with their potentials (the «−» plate is taken as 0).
 * Scale: 260 px for 6 см (43,3 px per сантиметр). A run lasts 3 s; the force on the charge (gold) does not change.
 */
import G7Styles from '../g7/G7Styles.astro';
import VlabStyles from './VlabStyles.astro';

const XP = 40;
const XM = 300;
const PX = (XM - XP) / 6;
const A = { x: XP + PX, y: 62 };
const B = { x: XP + 5 * PX, y: 140 };
const paths = [
	`M${A.x} ${A.y} L${B.x} ${B.y}`,
	`M${A.x} ${A.y} L${B.x} ${A.y} L${B.x} ${B.y}`,
	// the loop: first 0,77 см toward «+» (to x = 49,8), then down, up into a loop and to B, never farther from «+» than B
	`M${A.x} ${A.y} C66 46 48 72 50 100 C52 135 110 172 150 152 C190 132 215 75 185 62 C155 50 140 95 175 115 C200 130 235 140 ${B.x} ${B.y}`,
];
---

<G7Styles />
<VlabStyles />
<figure class="g7 pl not-content" data-pl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 204" role="img" aria-label="Однородное поле между двумя пластинами; заряд переходит из точки A в точку B по разным путям, и поле совершает одну и ту же работу" data-svg>
			{[1, 2, 3, 4, 5].map((k) => (
				<>
					<line class="pl__eq" x1={XP + k * PX} y1="22" x2={XP + k * PX} y2="182" />
					<text class="t-small t-halo" x={XP + k * PX} y="196" text-anchor="middle" data-phi={k} />
				</>
			))}
			<text class="t-small" x="170" y="13" text-anchor="middle">потенциалы (у пластины «−» ноль)</text>
			<rect class="pl__plate is-plus" x={XP - 6} y="18" width="6" height="168" rx="1.5"></rect>
			<rect class="pl__plate is-minus" x={XM} y="18" width="6" height="168" rx="1.5"></rect>
			<text class="t-strong" x={XP - 3} y="16" text-anchor="middle">+</text>
			<text class="t-strong" x={XM + 3} y="16" text-anchor="middle">−</text>
			{paths.map((d, i) => <path class="pl__path" data-path={i} d={d} />)}
			<path class="pl__done" data-done></path>
			<circle class="pl__pt" cx={A.x} cy={A.y} r="3"></circle>
			<circle class="pl__pt" cx={B.x} cy={B.y} r="3"></circle>
			<text class="t-strong t-halo" x={A.x - 14} y={A.y - 6}>A</text>
			<text class="t-strong t-halo" x={B.x + 8} y={B.y + 16}>B</text>
			<path class="arrow arrow--gold" data-farr></path>
			<path class="head--gold" data-fhd></path>
			<circle class="pl__q" data-q cx={A.x} cy={A.y} r="6"></circle>
			<path class="pl__sign" data-qs></path>
			<g data-ftx></g>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Путь заряда" data-seg>
				<button type="button" class="g7__btn" aria-pressed="true" data-p="0">Прямо</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="1">Ступенькой</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="2">Петлёй</button>
			</div>
			<label class="g7__slider">
				<span>Напряжение <i>U</i></span>
				<output data-ou></output>
				<input type="range" min="100" max="600" step="50" value="300" data-volt aria-label="Напряжение между пластинами, вольты" />
			</label>
			<button type="button" class="g7__btn g7__btn--go g7__again" data-go>Пуск</button>
			<ul class="g7__read" aria-live="polite">
				<li><span>напряжённость <i>E</i></span> <b data-e></b></li>
				<li><span>работа поля <i>A</i></span> <b data-a>0 мкДж</b></li>
				<li class="is-key"><span><i>A</i>/<i>q</i></span> <b data-aq>—</b></li>
				<li><span><i>φ</i><sub>A</sub> − <i>φ</i><sub>B</sub></span> <b data-dphi></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Заряд <i>q</i> = +1&nbsp;нКл, расстояние между пластинами 6&nbsp;см, точка B на 4&nbsp;см дальше от пластины «+», чем A. Пунктир — линии равного потенциала. Рисунок в масштабе.</figcaption>
</figure>

<style is:global>
	[data-pl] .pl__eq {
		stroke: var(--g7-green);
		stroke-width: 1;
		stroke-dasharray: 4 4;
		opacity: 0.7;
	}
	[data-pl] .pl__plate {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-pl] .is-plus {
		fill: var(--g7-red);
	}
	[data-pl] .is-minus {
		fill: var(--g7-blue);
	}
	[data-pl] .pl__path {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.4;
		stroke-dasharray: 2 3;
	}
	[data-pl] .pl__path.is-on {
		stroke: var(--sl-color-gray-2);
	}
	[data-pl] .pl__done {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	[data-pl] .pl__pt {
		fill: var(--sl-color-white);
	}
	[data-pl] .pl__q {
		fill: var(--g7-red);
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	[data-pl] .pl__sign {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
</style>

<script>
	import { loop, segment } from '../g7/kit';
	import { arrow, sig } from './vec';
	import { vlabSvg } from './vlab';

	const XP = 40;
	const XM = 300;
	const PX = (XM - XP) / 6;
	const Q = 1e-9;
	for (const root of document.querySelectorAll<HTMLElement>('[data-pl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const su = $<HTMLInputElement>('[data-volt]');
		const paths = [...root.querySelectorAll<SVGPathElement>('[data-path]')];
		const done = $<SVGPathElement>('[data-done]');
		let pi = 0;
		let t = -1; // −1: waiting at A; 0…3: running; >3: at B
		let work = 0;
		let lastX = 0;
		let trail = '';

		const E = () => +su.value / 0.06;
		const place = (x: number, y: number) => {
			$('[data-q]').setAttribute('cx', x.toFixed(1));
			$('[data-q]').setAttribute('cy', y.toFixed(1));
			$('[data-qs]').setAttribute('d', `M${x - 3.2} ${y} H${x + 3.2} M${x} ${y - 3.2} V${y + 3.2}`);
			const L = 14 + E() / 400; // 18 … 39 px: longer for a stronger field
			const a = arrow(x + 7, y, x + 7 + L, y, 7);
			$('[data-farr]').setAttribute('d', a.line);
			$('[data-fhd]').setAttribute('d', a.head);
			const ftx = $('[data-ftx]');
			if (!ftx.firstChild) ftx.innerHTML = vlabSvg('F', '', 'vl--gold', 13);
			ftx.setAttribute('transform', `translate(${(x + 14).toFixed(1)} ${(y - 7).toFixed(1)})`);
			// the label stands while the charge rests at A or B; in motion it would cross the dashed lines, so it hides
			ftx.style.display = t > 0 && t < 3 ? 'none' : '';
		};
		const read = () => {
			const U = +su.value;
			$('[data-ou]').textContent = `${U} В`;
			$('[data-e]').textContent = `${sig(E())} Н/Кл`;
			for (let k = 1; k <= 5; k++) $(`[data-phi="${k}"]`).textContent = `${sig(E() * ((6 - k) / 100))} В`;
			$('[data-dphi]').textContent = `${sig(E() * 0.04)} В`;
			$('[data-a]').textContent = `${work === 0 ? '0' : sig(work / 1e-6)} мкДж`;
			$('[data-aq]').textContent = t > 3 ? `${sig(work / Q)} В` : '—';
		};
		const reset = () => {
			t = -1;
			work = 0;
			trail = '';
			done.setAttribute('d', '');
			const p = paths[pi].getPointAtLength(0);
			lastX = p.x;
			place(p.x, p.y);
			paths.forEach((p, i) => p.classList.toggle('is-on', i === pi));
			read();
		};
		const wake = loop(root, (dt) => {
			if (t < 0 || t > 3) return false;
			t = Math.min(3.0001, t + dt);
			const path = paths[pi];
			const total = path.getTotalLength();
			const p = path.getPointAtLength(Math.min(1, t / 3) * total);
			work += Q * E() * ((p.x - lastX) / PX / 100);
			lastX = p.x;
			trail += `${trail ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)} `;
			done.setAttribute('d', trail);
			place(p.x, p.y);
			read();
			return t <= 3;
		});
		segment($('[data-seg]'), (b) => {
			pi = +b.dataset.p!;
			reset();
		});
		su.addEventListener('input', reset);
		$('[data-go]').addEventListener('click', () => {
			reset();
			t = 0;
			wake();
		});
		reset();
	}
</script>
