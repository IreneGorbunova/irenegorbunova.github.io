---
/**
 * «Эквипотенциальные поверхности» (static picture, two panels; stacked on a phone).
 * (а) A point charge +1 нКл: 6 radial lines (gray, at 0°, 60°, …) and the equipotential circles (green, dashed) at
 *     φ = kq/r = 300, 150, 100 and 75 В, i.e. r = 3, 6, 9 and 12 см (8 px per сантиметр): equal steps in r, so the
 *     potential differences between neighbours fall (150, 50, 25 В) — the circles of equal ΔU would get farther apart.
 *     The labels stand in a column above the charge, between the circles, clear of the lines (which are 30° off the
 *     vertical there).
 * (б) Two plates 5 см apart with U = 100 В (+ above, − below; 30 px per сантиметр): straight parallel lines (gray,
 *     down) and equipotential planes (green, dashed) every 1 см: 100, 80, 60, 40, 20, 0 В; a bracket «d = 1 см» with
 *     «U = 20 В». The field there is E = U/d = 2000 В/м, which the picture does not write (the text asks it).
 * Equipotential surfaces are perpendicular to the lines; E⃗ points toward lower potential.
 */
import G7Styles from '../g7/G7Styles.astro';
import VlabStyles from './VlabStyles.astro';
import { vlabSvg } from './vlab';

const W = 220;
const H = 228;
// (а)
const CX = 110;
const CY = 129;
const PXa = 8;
const circles = [3, 6, 9, 12].map((r, i) => ({ r: r * PXa, f: [300, 150, 100, 75][i] }));
const rays = Array.from({ length: 6 }, (_, i) => (i * Math.PI) / 3);
const R0 = 9;
const R1 = 104;
// (б)
const PY = 30;
const TOP = 52;
const PL = 64; // plates from x 64 to 170
const PR = 170;
const levels = [0, 1, 2, 3, 4, 5].map((k) => ({ y: TOP + k * PY, f: 100 - 20 * k }));
const flines = [78, 101, 124, 147];
---

<G7Styles />
<VlabStyles />
<figure class="g7 g7--pic eq not-content" data-eq>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Точечный заряд: радиальные линии напряжённости и эквипотенциальные окружности с потенциалами 300, 150, 100 и 75 вольт">
			<text class="t-title" x="8" y="16">а) Точечный заряд</text>
			{rays.map((a) => (
				<>
					<line class="eq__line" x1={CX + R0 * Math.cos(a)} y1={CY + R0 * Math.sin(a)} x2={CX + R1 * Math.cos(a)} y2={CY + R1 * Math.sin(a)} />
					<path class="eq__tip" d={`M${(CX + 64 * Math.cos(a)).toFixed(1)} ${(CY + 64 * Math.sin(a)).toFixed(1)} L${(CX + 57 * Math.cos(a) - 3.2 * Math.sin(a)).toFixed(1)} ${(CY + 57 * Math.sin(a) + 3.2 * Math.cos(a)).toFixed(1)} L${(CX + 57 * Math.cos(a) + 3.2 * Math.sin(a)).toFixed(1)} ${(CY + 57 * Math.sin(a) - 3.2 * Math.cos(a)).toFixed(1)} Z`} />
				</>
			))}
			{circles.map((c) => <circle class="eq__eqp" cx={CX} cy={CY} r={c.r} />)}
			{circles.map((c) => <text class="eq__lab" x={CX} y={CY - c.r - 5} text-anchor="middle">{c.f} В</text>)}
			<circle class="eq__q" cx={CX} cy={CY} r="7" />
			<path class="eq__s" d={`M${CX - 3.5} ${CY} h7 M${CX} ${CY - 3.5} v7`} />
		</svg>
		<svg class="g7__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Две заряженные пластины: параллельные линии напряжённости и эквипотенциальные плоскости через каждый сантиметр: 100, 80, 60, 40, 20 и 0 вольт">
			<text class="t-title" x="8" y="16">б) Две пластины</text>
			{flines.map((x) => (
				<>
					<line class="eq__line" x1={x} y1={TOP + 3} x2={x} y2={TOP + 5 * PY - 3} />
					{[0, 1, 2, 3, 4].map((k) => <path class="eq__tip" d={`M${x} ${TOP + k * PY + 19} l-3 -7 h6 Z`} />)}
				</>
			))}
			{levels.map((l, k) => k > 0 && k < 5 && <line class="eq__eqp" x1={PL} y1={l.y} x2={PR} y2={l.y} />)}
			<rect class="eq__plate is-plus" x={PL} y={TOP - 4} width={PR - PL} height="5" rx="1.5" />
			<rect class="eq__plate is-minus" x={PL} y={TOP + 5 * PY - 1} width={PR - PL} height="5" rx="1.5" />
			{levels.map((l) => <text class="eq__lab" x={PR + 6} y={l.y + 4}>{l.f} В</text>)}
			<path class="eq__br" d={`M${PL - 8} ${TOP + 2 * PY} V${TOP + 3 * PY} M${PL - 12} ${TOP + 2 * PY} h8 M${PL - 12} ${TOP + 3 * PY} h8`} />
			<text class="eq__lab" x={PL - 14} y={TOP + 2 * PY + 11} text-anchor="end">d = 1 см</text>
			<text class="eq__lab" x={PL - 14} y={TOP + 2 * PY + 26} text-anchor="end">U = 20 В</text>
			<g transform={`translate(${(flines[2] + flines[3]) / 2} ${TOP + 4 * PY + 21})`} set:html={vlabSvg('E', '', 'vl--ink', 13)} />
		</svg>
	</div>
	<figcaption class="g7__caption">Зелёные пунктирные линии — эквипотенциальные поверхности (в разрезе), серые — линии напряжённости. Они везде перпендикулярны друг другу; вектор <i>E⃗</i> направлен в сторону убывания потенциала.</figcaption>
</figure>

<style is:global>
	[data-eq] .g7__grid {
		max-width: 32rem;
		margin-inline: auto;
	}
	[data-eq] .eq__line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	[data-eq] .eq__tip {
		fill: var(--sl-color-gray-2);
	}
	[data-eq] .eq__eqp {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.4;
		stroke-dasharray: 5 3;
	}
	[data-eq] .g7__svg .eq__lab {
		font-size: 11.5px;
		fill: var(--g7-green);
		font-weight: 600;
	}
	[data-eq] .eq__q {
		fill: var(--g7-red);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-eq] .eq__s {
		stroke: var(--sl-color-black);
		stroke-width: 1.6;
	}
	[data-eq] .eq__plate {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-eq] .is-plus {
		fill: var(--g7-red);
	}
	[data-eq] .is-minus {
		fill: var(--g7-blue);
	}
	[data-eq] .eq__br {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.1;
	}
</style>
