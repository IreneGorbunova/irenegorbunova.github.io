---
/**
 * «Почему поле точечного заряда убывает как 1/r²» (picture, slow reveal: 3 s per frame, a 12 s loop).
 * A charge +q and a bundle of 9 of its lines (straight, radial, through a 3 × 3 grid) going out through three square
 * frames at r, 2r and 3r, drawn in a parallel projection in which the frames face the viewer (the axis recedes up and to
 * the right: screen x = 0,95 x + 0,9 z, screen y = −0,32 x − y), so each frame shows as a square. The frames
 * are cut by the same nine lines, so the side of a frame grows as its distance: areas S, 4S and 9S. The frames light
 * one after another; under each «r — S», «2r — 4S», «3r — 9S». The same lines pass through each frame: the number of
 * lines per unit area falls as 1/r², and so does the field strength. No values of E in the picture.
 */
import G7Styles from '../g7/G7Styles.astro';

const W = 340;
const H = 194;
const QX = 30;
const QY = 162;
const D = [78, 156, 234]; // distances of the frames, px
const A = 0.17; // the half side of a frame per unit distance
const prj = (x: number, y: number, z: number) => ({ x: QX + 0.95 * x + 0.9 * z, y: QY - 0.32 * x - y });
const f = (p: { x: number; y: number }) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
const frames = D.map((d) => {
	const a = A * d;
	const c = [prj(d, -a, -a), prj(d, a, -a), prj(d, a, a), prj(d, -a, a)];
	return { d, a, path: `M${f(c[0])} L${f(c[1])} L${f(c[2])} L${f(c[3])} Z`, low: prj(d, -a, 0) };
});
const grid = [-1, 0, 1].flatMap((i) => [-1, 0, 1].map((j) => ({ i, j })));
// each line from the charge to beyond the last frame (1,12 of its distance)
const lines = grid.map(({ i, j }) => {
	const e = 1.14 * D[2];
	return { from: prj(0, 0, 0), to: prj(e, i * A * e, j * A * e), pts: D.map((d) => prj(d, i * A * d, j * A * d)) };
});
const labels = ['r — S', '2r — 4S', '3r — 9S'];
---

<G7Styles />
<figure class="g7 g7--pic cn not-content" data-cn>
	<svg class="g7__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Пучок линий напряжённости точечного заряда проходит через три квадратные рамки на расстояниях r, 2r и 3r; площади рамок S, 4S и 9S, а линий через каждую проходит одинаково">
		<text class="t-small" x={W / 2} y="16" text-anchor="middle">через каждую рамку проходят одни и те же линии</text>
		{frames.map((fr, k) => <path class="cn__frame" data-fr={k} d={fr.path} />)}
		{lines.map((l) => <line class="cn__line" x1={l.from.x} y1={l.from.y} x2={l.to.x} y2={l.to.y} />)}
		{lines.flatMap((l) => l.pts.map((p, k) => <circle class="cn__hit" data-hit={k} cx={p.x} cy={p.y} r="2" />))}
		<circle class="cn__q" cx={QX} cy={QY} r="9" />
		<path class="cn__sign" d={`M${QX - 4} ${QY} h8 M${QX} ${QY - 4} v8`} />
		<text class="cn__ql" x={QX} y={QY + 24} text-anchor="middle">+q</text>
		{frames.map((fr, k) => <text class="cn__lab" data-lab={k} x={fr.low.x} y={fr.low.y + 20} text-anchor="middle">{labels[k]}</text>)}
	</svg>
	<figcaption class="g7__caption">Рамки на расстояниях <i>r</i>, 2<i>r</i> и 3<i>r</i> от заряда, их площади <i>S</i>, 4<i>S</i> и 9<i>S</i>: густота линий убывает как 1/<i>r</i><sup>2</sup>.</figcaption>
</figure>

<style is:global>
	[data-cn] .g7__svg {
		max-width: 24rem;
		margin-inline: auto;
	}
	[data-cn] .cn__frame {
		fill: color-mix(in oklab, var(--g7-gold) 6%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		transition:
			fill 0.4s,
			stroke 0.4s;
	}
	[data-cn] .cn__frame.is-on {
		fill: color-mix(in oklab, var(--g7-gold) 26%, transparent);
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	[data-cn] .cn__line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-cn] .cn__hit {
		fill: var(--sl-color-gray-3);
		transition: fill 0.4s;
	}
	[data-cn] .cn__hit.is-on {
		fill: var(--g7-gold);
	}
	[data-cn] .cn__q {
		fill: var(--g7-red);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-cn] .cn__sign {
		stroke: var(--sl-color-black);
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-cn] .g7__svg .cn__ql {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
		fill: var(--sl-color-gray-1);
	}
	[data-cn] .g7__svg .cn__lab {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
		fill: var(--sl-color-gray-3);
		transition: fill 0.4s;
	}
	[data-cn] .g7__svg .cn__lab.is-on {
		fill: var(--g7-gold);
		font-weight: 700;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-cn]')) {
		const frames = [...fig.querySelectorAll<SVGElement>('[data-fr]')];
		const labs = [...fig.querySelectorAll<SVGElement>('[data-lab]')];
		const hits = [...fig.querySelectorAll<SVGElement>('[data-hit]')];
		let t = 0;
		let shown = -2;
		const draw = () => {
			// 0–3 s: frame r, 3–6 s: 2r, 6–9 s: 3r, 9–12 s: all three
			const k = t < 9 ? Math.floor(t / 3) : -1;
			if (k === shown) return;
			shown = k;
			const on = (i: number) => k === -1 || i === k;
			frames.forEach((e, i) => e.classList.toggle('is-on', on(i)));
			labs.forEach((e, i) => e.classList.toggle('is-on', on(i)));
			hits.forEach((e) => e.classList.toggle('is-on', on(+e.dataset.hit!)));
		};
		draw();
		loop(fig, (dt) => {
			t = (t + dt) % 12;
			draw();
			return true;
		});
	}
</script>
