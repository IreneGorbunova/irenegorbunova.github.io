	}
	[data-elintro] .el-mark {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-elintro] .el-cloud-d {
		fill: color-mix(in oklab, var(--sl-color-gray-4) 70%, var(--sl-color-black));
	}
	[data-elintro] .el-cloud-d2 {
		fill: color-mix(in oklab, var(--sl-color-gray-4) 85%, var(--sl-color-black));
	}
	[data-elintro] .el-bolt {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 60%, white);
		stroke-width: 5;
		stroke-linejoin: round;
		opacity: 0;
		filter: blur(1.5px);
	}
	[data-elintro] .el-bolt-core {
		fill: none;
		stroke: white;
		stroke-width: 1.8;
		stroke-linejoin: round;
		opacity: 0;
	}
	[data-elintro] .el-flash {
		fill: white;
		pointer-events: none;
	}
	[data-elintro] .el-flash-road {
		fill: color-mix(in oklab, var(--ig-v) 40%, white);
	}
	[data-elintro] .el-cabin {
		fill: color-mix(in oklab, var(--sl-color-gray-6) 70%, var(--sl-color-black));
	}
	[data-elintro] .el-car {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-4));
