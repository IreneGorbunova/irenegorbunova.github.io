</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { human, type HumanPose } from '../mehanicheskaya-rabota/people';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, k: number) => a + (b - a) * k;

	for (const root of document.querySelectorAll<HTMLElement>('[data-elintro]')) {
		// ---------- the balloon ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="balloon"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1.05;
			const FL = 226;
			const Hg = 128;
			const Hb = 168;
			const ug = S * Hg;
			const ub = S * Hb;
			const Ag = 7 * S * (Hg / 172);
			const Ab = 7 * S;
			const girl = human($<SVGGElement>('[data-girl]'), { s: S, H: Hg, shirt: 'hm-green', hair: 'short', girth: 0.9 });
			$<SVGGElement>('[data-girl]').classList.add('hm-blond');
			const boy = human($<SVGGElement>('[data-boy]'), { s: S, H: Hb, shirt: 'hm-blue', hair: 'short', dir: -1 });
			const gx = 112;
			const bx = 172; // close enough to hold the balloon over her head with his arm within reach
			const ghip = { x: gx, y: FL - 0.505 * ug };
			const bhip = { x: bx, y: FL - 0.505 * ub };
			// centers of the heads (people.ts: 0,4 H above the hip joint, 0,015 H forward), radii 0,064 H
			const gh = { x: gx + 0.015 * ug, y: ghip.y - 0.4 * ug };
			const gr = 0.064 * ug;
			const bh = { x: bx - 0.015 * ub, y: bhip.y - 0.4 * ub };
			const br = 0.064 * ub;

			// the girl's hair: 14 strands from the top and the back of her head
			const hairG = $<SVGGElement>('[data-hair]');
			// the mass of long hair lying on the head and the back; it fades as the strands lift
			const mass = el('path', { class: 'el-hair-mass' });
			hairG.append(mass);
			{
				const P = (a: number, k: number) => `${(gh.x + k * gr * Math.cos((a * Math.PI) / 180)).toFixed(1)} ${(gh.y + k * gr * Math.sin((a * Math.PI) / 180)).toFixed(1)}`;
				mass.setAttribute('d', `M${P(-40, 1.0)} A${(1.12 * gr).toFixed(1)} ${(1.12 * gr).toFixed(1)} 0 0 0 ${P(-200, 1.12)} Q${(gh.x - 1.25 * gr).toFixed(1)} ${(gh.y + 1.6 * gr).toFixed(1)} ${(gh.x - 1.05 * gr).toFixed(1)} ${(gh.y + 1.2 * gr + 18).toFixed(1)} L${(gh.x - 0.3 * gr).toFixed(1)} ${(gh.y + 1.2 * gr + 14).toFixed(1)} Q${(gh.x - 0.25 * gr).toFixed(1)} ${(gh.y + 0.8 * gr).toFixed(1)} ${P(150, 0.85)} L${P(-30, 0.9)} Z`);
			}
			const N = 18;
			const strands = Array.from({ length: N }, (_, i) => {
				const a = ((-55 - (i * 150) / (N - 1)) * Math.PI) / 180; // from the forehead over the top to the nape
				const p = el('path', { class: i % 3 === 1 ? 'el-hair-d' : 'el-hair' });
				hairG.append(p);
				return { a, p, i };
			});
			const hair = (b: { x: number; y: number } | null, lam: number, t: number) => {
				mass.style.opacity = String(1 - 0.85 * lam);
				for (const s of strands) {
					const R = { x: gh.x + gr * Math.cos(s.a), y: gh.y + gr * Math.sin(s.a) };
					const nrm = { x: Math.cos(s.a), y: Math.sin(s.a) };
					const f = s.i / (N - 1);
					// at rest: the strand hugs the head, goes to the back and hangs down to the shoulder blades
					const rest = { x: gh.x - 0.35 * gr - 0.75 * gr * f - (s.i % 2) * 0.8, y: gh.y + 1.2 * gr + 8 + 10 * f + (s.i % 3) * 2 };
					const restC = { x: gh.x + nrm.x * gr * 1.45 - 0.6 * gr, y: gh.y + nrm.y * gr * 1.3 };
					let tip = rest;
					let ctrl = restC;
					if (b && lam > 0.001) {
						const dx = b.x - R.x;
						const dy = b.y - R.y;
						const d = Math.hypot(dx, dy) || 1;
						// a strand that grows on the side of the balloon is pulled harder (it is nearer)
						const facing = Math.max(0, (nrm.x * dx + nrm.y * dy) / d);
						const li = lam * (0.35 + 0.65 * facing);
						// the strands push one another apart: a narrow fan around the direction to the balloon
						const fan = (s.i - (N - 1) / 2) * 0.035 + 0.05 * Math.sin(t * 5 + s.i);
						const ang = Math.atan2(dy, dx) + fan;
						// a lifted strand reaches toward the balloon but stops short of its surface
						const L = Math.min(gr + 22, d - 15);
						const up = { x: R.x + L * Math.cos(ang), y: R.y + L * Math.sin(ang) };
						const upC = { x: R.x + (nrm.x * 0.4 + Math.cos(ang) * 0.6) * L * 0.5, y: R.y + (nrm.y * 0.4 + Math.sin(ang) * 0.6) * L * 0.5 };
						tip = { x: lerp(rest.x, up.x, li), y: lerp(rest.y, up.y, li) };
						ctrl = { x: lerp(restC.x, upC.x, li), y: lerp(restC.y, upC.y, li) };
					}
					s.p.setAttribute('d', `M${R.x.toFixed(1)} ${R.y.toFixed(1)} Q${ctrl.x.toFixed(1)} ${ctrl.y.toFixed(1)} ${tip.x.toFixed(1)} ${tip.y.toFixed(1)}`);
				}
			};
			const balloon = $<SVGGElement>('[data-balloon]');
			const standG = (head: number): HumanPose => ({
				hip: ghip,
				lean: 0,
				ankles: [
					{ x: gx + 0.015 * ug, y: FL - Ag },
					{ x: gx - 0.03 * ug, y: FL - Ag },
				],
				feet: [0, 0],
				hands: [
					{ x: gx + 0.035 * ug, y: FL - 0.42 * ug },
					{ x: gx - 0.01 * ug, y: FL - 0.42 * ug },
				],
				head,
			});
			const hang = [
				{ x: bx - 0.03 * ub, y: FL - 0.42 * ub },
				{ x: bx + 0.01 * ub, y: FL - 0.42 * ub },
			];
			const top = gh.y - gr; // the top of her head
			const rubC = (t: number) => ({ x: bh.x + 7 * Math.sin(t * 2 * Math.PI * 2.5), y: bh.y - br - 11 });
			const gapAt = (t: number) => {
				// px between her hair and the balloon: 46 → 6 → 50
				if (t < 3.3) return 46;
				if (t < 6.3) return lerp(46, 16, ease((t - 3.3) / 3));
				if (t < 7.3) return 16;
				return lerp(16, 50, ease((t - 7.3) / 1.7));
			};
			scene(card, 9, (x) => {
				const t = x * 9;
				let B: { x: number; y: number };
				let hands: [{ x: number; y: number }, { x: number; y: number }];
				const over = (g: number) => ({ x: gh.x - 3, y: top - 14 - g });
				if (t < 2.5) {
					B = rubC(t);
					hands = [
						{ x: B.x - 9, y: B.y + 6 },
						{ x: B.x - 3, y: B.y + 11 },
					];
				} else if (t < 3.3) {
					const k = ease((t - 2.5) / 0.8);
					const a = rubC(2.5);
					const b = over(46);
					B = { x: lerp(a.x, b.x, k), y: lerp(a.y, b.y, k) - 10 * Math.sin(Math.PI * k) };
					hands = [
						{ x: B.x + 3, y: B.y + 16 },
						// on the way down the far hand keeps out of the shoulder's way (an elbow bends 150° at most)
						{ x: lerp(B.x - 3, hang[1].x - 0.06 * ub, k) - 16 * Math.sin(Math.PI * k), y: lerp(B.y + 11, hang[1].y, k) },
					];
				} else {
					B = over(gapAt(t));
					// the far arm hangs below its shoulder, which has moved forward with the lean
					hands = [{ x: B.x + 3, y: B.y + 16 }, { x: hang[1].x - 0.06 * ub, y: hang[1].y }];
				}
				balloon.setAttribute('transform', `translate(${B.x.toFixed(1)} ${B.y.toFixed(1)})`);
				boy({
					hip: bhip,
					lean: t < 2.5 ? 0 : 0.06 + 0.16 * ease((t - 2.5) / 0.8),
					ankles: [
						{ x: bx - 0.02 * ub, y: FL - Ab },
						{ x: bx + 0.03 * ub, y: FL - Ab },
					],
					feet: [0, 0],
					hands,
					// the far hand lets the balloon go and hangs relaxed
					grips: [null, t >= 2.5 ? { pose: 'relaxed' } : null],
					head: t < 2.5 ? -0.25 : 0.25,
				});
				// the pull ∝ 1/d², d from the balloon to the center of her head; full at the closest approach
				const charged = t > 2.5;
				const d = Math.hypot(B.x - gh.x, B.y - gh.y);
				const dmin = gr + 14 + 16;
				const lam = charged ? Math.min(1, (dmin / d) ** 2) : 0;
				hair(B, lam, t);
				girl(standG(-0.35 * lam));
			});
		}
		// ---------- the storm ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="storm"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.49;
			const mom = human($<SVGGElement>('[data-mom]'), { s: S, H: 166, shirt: 'hm-red', hair: 'pony' });
			const kid = human($<SVGGElement>('[data-kid]'), { s: S, H: 128, shirt: 'hm-gold', hair: 'pony' });
			const um = S * 166;
			const uk = S * 128;
			// seated: hip on the seat, thighs forward, feet on the floor
			const seat = (x: number, y: number, u: number, hands: [{ x: number; y: number }, { x: number; y: number }], head: number, lean = -0.12): HumanPose => ({
				hip: { x, y },
				lean,
				ankles: [
					{ x: x + 0.3 * u, y: y + 0.2 * u },
					{ x: x + 0.28 * u, y: y + 0.2 * u },
				],
				feet: [0, 0],
				hands,
				head,
			});
			const bolt = [$('[data-bolt]'), $('[data-bolt2]')];
			const flash = $('[data-flash]');
			const froad = $('[data-froad]');
			const glow = $('[data-glow]');
			const spark = $('[data-spark]');
			const drops = [...card.querySelectorAll<SVGLineElement>('.el-drop')].map((l) => ({ l, x: +l.getAttribute('x1')!, y: +l.getAttribute('y1')!, s: (+l.getAttribute('y2')! - +l.getAttribute('y1')!) / 9 }));
			// the brightness of a flash with three return strokes, 0…1
			const strokes = (t: number) => {
				let b = 0;
				for (const [t0, a] of [
					[2.0, 1],
					[2.35, 0.75],
					[2.7, 0.9],
				] as const) {
					const u = t - t0;
					if (u >= 0 && u < 0.3) b = Math.max(b, a * Math.exp(-u / 0.07));
				}
				return b;
			};
			scene(card, 6, (x) => {
				const t = x * 6;
				const b = strokes(t);
				for (const p of bolt) p.style.opacity = String(Math.min(1, b * 1.4));
				flash.setAttribute('opacity', (0.45 * b).toFixed(2));
				froad.setAttribute('opacity', (0.35 * b).toFixed(2));
				glow.style.opacity = String(Math.min(1, b * 1.6));
				spark.style.opacity = t > 2.02 && t < 2.9 && b > 0.25 ? '1' : '0';
				// the rain falls all the time: 240 px in 0,6 s
				for (const d of drops) {
					const y = (((d.y + t * 400 * d.s) % 250) + 250) % 250 - 10;
					const xx = d.x - (t * 130 * d.s) % 380;
					const X = ((xx % 380) + 380) % 380 - 10;
					d.l.setAttribute('x1', X.toFixed(1));
					d.l.setAttribute('y1', y.toFixed(1));
					d.l.setAttribute('x2', (X - 3 * d.s).toFixed(1));
					d.l.setAttribute('y2', (y + 9 * d.s).toFixed(1));
				}
				// the girl looks up after the flash
				const look = t > 2.2 ? -0.35 * ease((t - 2.2) / 0.6) * (t < 4.8 ? 1 : 1 - ease((t - 4.8) / 0.8)) : 0;
				// the mother sits up, a little forward, so that her hands reach the steering wheel
				mom(seat(208, 156, um, [{ x: 236, y: 141 }, { x: 234, y: 143 }], 0.05, 0.1));
				kid(seat(152, 150, uk, [{ x: 166, y: 147 }, { x: 164, y: 148 }], look));
			});
		}
	}
</script>
