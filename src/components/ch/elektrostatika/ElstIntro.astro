---
/**
 * Two looping opening scenes of «Электростатика. Закон Кулона. Электрическое поле». No terms of the chapter in the
 * pictures or in the visible captions.
 *
 * Balloon: a living room drawn at 1,05 px per centimeter. A boy (168 см) rubs a balloon (25 см across) on his hair
 *   for 2,5 s, then holds it over the head of his sister (128 см, long hair). The balloon comes down from 46 px
 *   (44 см) above her hair to 16 px (15 см) in 3 s, waits, and goes back up. Her strands are pulled toward the balloon
 *   with a strength ∝ 1/d² (d — from the balloon to the center of her head), so they rise more and more steeply as it
 *   approaches, and fan out (a drawing rule: the uncharged strands are pulled by the charges the balloon shifts in
 *   them). Real time.
 * Storm: a parked hatchback (4,1 м long, 0,49 px per centimeter) in the rain; a mother at the wheel, a girl in the back
 *   seat. After 2 s a lightning stroke hits the roof: the sky flashes (three return strokes, as a real flash flickers),
 *   the metal body glows along its outline, a spark jumps from the sill to the wet road. The people inside go on
 *   sitting; the girl looks up. The flash is slowed about ten times so it can be seen (a real one lasts about 0,2 s,
 *   each stroke a ten-thousandth of a second).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

// the living room
const FL = 226; // floor
const books = [
	{ x: 292, w: 6, h: 22, c: 'a' },
	{ x: 299, w: 5, h: 19, c: 'b' },
	{ x: 305, w: 7, h: 24, c: 'c' },
	{ x: 313, w: 5, h: 18, c: 'a' },
	{ x: 319, w: 6, h: 23, c: 'b' },
	{ x: 326, w: 8, h: 20, c: 'c' },
	{ x: 335, w: 5, h: 22, c: 'a' },
];
const boards = Array.from({ length: 9 }, (_, i) => i * 44 - 10);

// the car (see the header): ground at 198
const CAR =
	'M92 176 L92 146 Q94 128 112 117 L134 106 L222 106 Q233 108 241 118 L262 142 Q286 146 292 156 L292 176 Q292 182 286 182 L273 182 A18 18 0 0 0 237 182 L149 182 A18 18 0 0 0 113 182 L98 182 Q92 182 92 176 Z';
const WIN = 'M108 140 L122 120 L136 114 L178 113 L178 140 Z M184 140 L184 113 L219 113 Q227 114 234 122 L248 140 Z';
const rain = Array.from({ length: 70 }, (_, i) => ({ x: (i * 53.3) % 380, y: (i * 97.1) % 240, s: 0.8 + ((i * 37) % 10) / 25 }));
---

<PeopleStyles />
<IntroFrame data-elintro>
	<div class="intro__card" data-scene="balloon">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик потёр воздушный шарик о свои волосы и подносит его к голове младшей сестры; её волосы поднимаются и тянутся к шарику, тем сильнее, чем он ближе">
			<rect class="el-wall" x="0" y="0" width="360" height={FL}></rect>
			<path class="el-stripes" d={Array.from({ length: 19 }, (_, i) => `M${i * 20 + 6} 0 V${FL - 12}`).join(' ')}></path>
			<!-- the window with curtains -->
			<rect class="el-sky" x="14" y="22" width="64" height="86" rx="2"></rect>
			<path class="el-cloud" d="M22 52 q6 -9 15 -4 q6 -8 14 0 q8 -1 8 6 q-1 5 -8 5 H25 q-7 0 -3 -7 Z"></path>
			<path class="el-frame" d="M14 22 h64 v86 h-64 Z M46 22 v86 M14 64 h64"></path>
			<rect class="el-sill" x="10" y="106" width="72" height="5" rx="1"></rect>
			<path class="el-curtain" d="M6 16 Q16 60 8 112 L2 112 L2 16 Z M86 16 Q76 60 84 112 L90 112 L90 16 Z"></path>
			<rect class="el-rod" x="0" y="13" width="94" height="3" rx="1.5"></rect>
			<!-- a picture on the wall -->
			<rect class="el-pic" x="222" y="26" width="44" height="32" rx="1"></rect>
			<path class="el-pic-in" d="M226 54 L238 40 L246 48 L252 42 L262 54 Z"></path>
			<circle class="el-sun" cx="256" cy="34" r="3.5"></circle>
			<!-- the bookcase -->
			<rect class="el-case" x="286" y="58" width="56" height={FL - 58}></rect>
			{[84, 120, 156, 192].map((y) => <rect class="el-shelf" x="286" y={y} width="56" height="3" />)}
			{books.map((b) => <rect class={`el-book el-book--${b.c}`} x={b.x} y={84 - b.h} width={b.w} height={b.h} rx="0.6" />)}
			{books.slice(2).map((b, i) => <rect class={`el-book el-book--${b.c}`} x={b.x - 2 * i} y={120 - b.h + 2} width={b.w} height={b.h - 2} rx="0.6" />)}
			<path class="el-plant" d="M300 156 q-6 -14 2 -24 q2 10 -2 24 Z M304 156 q2 -18 12 -22 q-4 12 -12 22 Z M302 156 q-12 -8 -14 -18 q10 2 14 18 Z"></path>
			<rect class="el-pot" x="296" y="148" width="14" height="8" rx="1.5"></rect>
			<rect class="el-box" x="318" y="166" width="20" height="26" rx="1"></rect>
			<!-- floor -->
			<rect class="el-floor" x="0" y={FL - 12} width="360" height={240 - FL + 12}></rect>
			<path class="el-board" d={boards.map((x) => `M${x} ${FL} L${x - 22} 240`).join(' ')}></path>
			<rect class="el-skirt" x="0" y={FL - 14} width="360" height="4"></rect>
			<ellipse class="el-rug" cx="150" cy={FL + 4} rx="110" ry="8"></ellipse>
			<g data-girl></g>
			<g data-hair></g>
			<g data-boy></g>
			<g data-balloon>
				<ellipse class="el-balloon" cx="0" cy="0" rx="12.5" ry="14"></ellipse>
				<ellipse class="el-balloon-hi" cx="-4.5" cy="-6" rx="3.2" ry="4.6" transform="rotate(25 -4.5 -6)"></ellipse>
				<path class="el-balloon" d="M-2 13.5 L2 13.5 L1 16.5 L-1 16.5 Z"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Брат потёр воздушный шарик о свои волосы и поднёс его к голове сестры:{' '}
				<More term="чем ближе шарик, тем сильнее волосы тянутся к нему">
					Трение о волосы брата зарядило шарик. Волосы сестры не заряжены, но заряженный шарик смещает в них заряды: ближе к шарику оказываются заряды противоположного знака, и волоски притягиваются к нему — тем сильнее, чем он ближе. Как сила взаимодействия зарядов зависит от расстояния, — раздел{' '}
					<a href="#закон-кулона">«Закон Кулона»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="storm">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Гроза. Молния ударяет в крышу стоящей машины, кузов вспыхивает по контуру, искра уходит в мокрую дорогу; мама за рулём и девочка на заднем сиденье спокойно сидят внутри">
			<rect class="el-storm-sky" x="0" y="0" width="360" height="200"></rect>
			<path class="el-hill" d="M0 150 Q60 128 120 140 T240 134 T360 142 V200 H0 Z"></path>
			<path class="el-trees" d="M20 150 l8 -26 l8 26 Z M40 146 l7 -22 l7 22 Z M318 144 l9 -30 l9 30 Z M338 146 l7 -22 l7 22 Z"></path>
			<rect class="el-pole" x="56" y="96" width="3" height="54"></rect>
			<path class="el-wire" d="M0 102 Q30 108 57 100 Q120 112 190 104"></path>
			<rect class="el-road" x="0" y="190" width="360" height="50"></rect>
			<path class="el-mark" d="M10 216 h30 M70 216 h30 M130 216 h30 M190 216 h30 M250 216 h30 M310 216 h30"></path>
			<rect class="el-flash-road" data-froad x="0" y="190" width="360" height="50" opacity="0"></rect>
			<path class="el-cloud-d" d="M-10 34 Q10 6 50 18 Q76 -6 116 12 Q150 -4 190 14 Q226 -2 262 16 Q300 2 330 22 Q366 18 370 40 L370 -5 L-10 -5 Z"></path>
			<path class="el-cloud-d2" d="M-10 46 Q30 30 70 42 Q110 26 150 40 Q190 28 236 42 Q280 30 320 44 Q350 38 370 50 L370 30 L-10 30 Z"></path>
			<path class="el-bolt" data-bolt d="M214 30 L204 52 L212 56 L196 78 L204 82 L192 104"></path>
			<path class="el-bolt-core" data-bolt2 d="M214 30 L204 52 L212 56 L196 78 L204 82 L192 104"></path>
			<!-- people inside, behind the body -->
			<path class="el-cabin" d={WIN}></path>
			<g data-mom></g>
			<g data-kid></g>
			<circle class="el-wheel-st" cx="238" cy="136" r="6"></circle>
			<path class="el-car" d={`${CAR} ${WIN}`} fill-rule="evenodd"></path>
			<path class="el-glass" d={WIN} opacity="0.18"></path>
			<path class="el-car-line" d="M92 160 H292 M181 113 V176 M118 142 Q116 160 120 176"></path>
			<path class="el-car" d="M246 128 l7 -3 l3 6 l-8 2 Z"></path>
			<rect class="el-handle" x="160" y="146" width="10" height="2.5" rx="1"></rect>
			<rect class="el-handle" x="226" y="146" width="10" height="2.5" rx="1"></rect>
			<path class="el-lamp" d="M284 150 h8 v8 h-6 Z"></path>
			<path class="el-lamp-r" d="M92 148 h4 v10 h-4 Z"></path>
			<path class="el-glow" data-glow d={CAR}></path>
			{[131, 255].map((x) => (
				<g>
					<circle class="el-tyre" cx={x} cy="182" r="16" />
					<circle class="el-rim" cx={x} cy="182" r="8.5" />
					<circle class="el-hub" cx={x} cy="182" r="2.5" />
				</g>
			))}
			<path class="el-spark" data-spark d="M150 183 L146 188 L152 190 L147 197"></path>
			<rect class="el-flash" data-flash x="0" y="0" width="360" height="240" opacity="0"></rect>
			<g data-rain>
				{rain.map((r) => <line class="el-drop" x1={r.x} y1={r.y} x2={r.x - 3 * r.s} y2={r.y + 9 * r.s} />)}
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Молния ударила в машину, а людям внутри{' '}
				<More term="ничего не грозит">
					Металлический кузов проводит ток. Заряд молнии проходит по наружной поверхности кузова и уходит в землю через мокрые колёса и капли воды, а внутри замкнутой металлической оболочки электрического поля нет. Это электростатическая защита — раздел{' '}
					<a href="#проводники-и-диэлектрики-в-электрическом-поле">«Проводники и диэлектрики в электрическом поле»</a>. Машина с матерчатой или пластиковой крышей так не защищает.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-elintro] {
		--el-wall: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-6));
