---
/**
 * «Потенциал поля точечного заряда» (picture, looping animation of 8 s).
 * The graph φ(r) = kq₀/r of a point charge q₀ = +1 нКл for r = 1 … 12 см (k = 9·10⁹ Н·м²/Кл²: φ = 900 В / r[см]),
 * 23 px per сантиметр, 0,2 px per вольт. Points A at 3 см (φ_A = 300 В) and B at 9 см (φ_B = 100 В) with dashed
 * guides to the axes and a bracket «U = 200 В» between their levels. Under the graph, on the same horizontal scale,
 * a line with the charge q₀ at r = 0 and the marks A and B; a small positive charge q = 2 нКл goes from A to B in 4 s
 * and the readout «работа поля A = q(φ_A − φ_B) = 0,4 мкДж» appears when it arrives (2·10⁻⁹ · 200 = 4·10⁻⁷ Дж).
 * Far from the charge φ → 0.
 */
import G7Styles from '../g7/G7Styles.astro';

const W = 340;
const H = 278;
const X0 = 40;
const PX = 23;
const GY = 210;
const PV = 0.2;
const gx = (r: number) => X0 + r * PX;
const gy = (f: number) => GY - f * PV;
const curve = Array.from({ length: 111 }, (_, i) => 1 + i * 0.1).map((r) => `${gx(r).toFixed(1)} ${gy(900 / r).toFixed(1)}`);
const A = { x: gx(3), y: gy(300) };
const Bp = { x: gx(9), y: gy(100) };
const LY = 246; // the line of charges
---

<G7Styles />
<figure class="g7 g7--pic pg not-content" data-pg>
	<svg class="g7__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="График потенциала поля точечного заряда: потенциал убывает обратно пропорционально расстоянию; в точке A на расстоянии 3 см он 300 В, в точке B на расстоянии 9 см — 100 В; заряд q переходит из A в B">
		<!-- axes -->
		<line class="pg__ax" x1={X0} y1={GY} x2={gx(12.6)} y2={GY} />
		<line class="pg__ax" x1={X0} y1={GY} x2={X0} y2="22" />
		<path class="pg__axh" d={`M${gx(12.6) + 6} ${GY} l-7 -3 v6 Z M${X0} 16 l-3 7 h6 Z`} />
		{[0, 3, 6, 9, 12].map((r) => (
			<>
				<line class="pg__ax" x1={gx(r)} y1={GY} x2={gx(r)} y2={GY + 4} />
				<text class="t-small" x={gx(r)} y={GY + 16} text-anchor="middle">{r}</text>
			</>
		))}
		{[100, 300, 600, 900].map((f) => (
			<>
				<line class="pg__ax" x1={X0 - 4} y1={gy(f)} x2={X0} y2={gy(f)} />
				<text class="t-small" x={X0 - 6} y={gy(f) + 4} text-anchor="end">{f}</text>
			</>
		))}
		<text class="t-small" x={X0 + 8} y="20">φ, В</text>
		<text class="t-small" x={gx(12.6)} y={GY + 16} text-anchor="end" dx="-24">r, см</text>
		<!-- guides and the bracket -->
		<path class="pg__guide" d={`M${X0} ${A.y} H${A.x} V${GY} M${X0} ${Bp.y} H${Bp.x} V${GY}`} />
		<path class="pg__br" d={`M${X0 + 10} ${A.y + 2} V${Bp.y - 2} M${X0 + 6} ${A.y + 2} h8 M${X0 + 6} ${Bp.y - 2} h8`} />
		<text class="pg__u" x={X0 + 16} y={(A.y + Bp.y) / 2 + 5}>U = 200 В</text>
		<!-- the graph -->
		<path class="pg__curve" d={`M${curve.join(' L')}`} />
		<circle class="pg__pt" cx={A.x} cy={A.y} r="3.5" />
		<circle class="pg__pt" cx={Bp.x} cy={Bp.y} r="3.5" />
		<text class="pg__name" x={A.x + 7} y={A.y - 6}>A</text>
		<text class="pg__name" x={Bp.x + 6} y={Bp.y - 7}>B</text>
		<text class="t-small" x={W - 6} y="122" text-anchor="end">φ → 0 далеко от заряда</text>
		<text class="t-num pg__read" data-read x={W - 6} y="40" text-anchor="end"></text>
		<!-- the line of charges -->
		<line class="pg__line" x1={X0} y1={LY} x2={gx(12.4)} y2={LY} />
		<path class="pg__mk" d={`M${A.x} ${LY - 5} v10 M${Bp.x} ${LY - 5} v10`} />
		<circle class="pg__q0" cx={X0} cy={LY} r="8" />
		<path class="pg__s" d={`M${X0 - 4} ${LY} h8 M${X0} ${LY - 4} v8`} />
		<text class="t-small" x="4" y={LY + 24}>q₀ = +1 нКл</text>
		<text class="pg__name" x={A.x} y={LY + 22} text-anchor="middle">A</text>
		<text class="pg__name" x={Bp.x} y={LY + 22} text-anchor="middle">B</text>
		<text class="t-small" x={(A.x + Bp.x) / 2} y={LY + 22} text-anchor="middle">q = 2 нКл</text>
		<g data-q>
			<circle class="pg__q" r="5" cx="0" cy={LY} />
			<path class="pg__s" d={`M-2.5 ${LY} h5 M0 ${LY - 2.5} v5`} />
		</g>
	</svg>
	<figcaption class="g7__caption">Потенциал поля заряда <i>q</i><sub>0</sub> = +1&nbsp;нКл; под графиком в том же масштабе — заряд и точки A и B. Заряд <i>q</i> = 2&nbsp;нКл переходит из A в B.</figcaption>
</figure>

<style is:global>
	[data-pg] .g7__svg {
		max-width: 26rem;
		margin-inline: auto;
	}
	[data-pg] .pg__ax {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
	}
	[data-pg] .pg__axh {
		fill: var(--sl-color-gray-2);
	}
	[data-pg] .pg__guide {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.9;
		stroke-dasharray: 3 3;
	}
	[data-pg] .pg__br {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-pg] .g7__svg .pg__u {
		font-size: 12px;
		fill: var(--sl-color-gray-1);
	}
	[data-pg] .pg__curve {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	[data-pg] .pg__pt {
		fill: var(--g7-green);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-pg] .g7__svg .pg__name {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 13px;
		fill: var(--sl-color-gray-1);
	}
	[data-pg] .g7__svg .pg__read {
		font-size: 12px;
		fill: var(--sl-color-gray-1);
	}
	[data-pg] .pg__line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	[data-pg] .pg__mk {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-pg] .pg__q0,
	[data-pg] .pg__q {
		fill: var(--g7-red);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-pg] .pg__s {
		stroke: var(--sl-color-black);
		stroke-width: 1.5;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const X0 = 40;
	const PX = 23;
	for (const fig of document.querySelectorAll<HTMLElement>('[data-pg]')) {
		const q = fig.querySelector<SVGGElement>('[data-q]')!;
		const read = fig.querySelector<SVGTextElement>('[data-read]')!;
		let t = 0;
		let shown = false;
		const draw = () => {
			// 0–1 s at A, 1–5 s from A to B, 5–8 s at B with the readout
			const u = Math.min(1, Math.max(0, (t - 1) / 4));
			const e = u * u * (3 - 2 * u);
			const r = 3 + 6 * e;
			q.setAttribute('transform', `translate(${(X0 + r * PX).toFixed(1)} 0)`);
			if (t >= 5 === shown) return;
			shown = t >= 5;
			read.innerHTML = t >= 5 ? 'работа поля A = q(φ<tspan dy="3" font-size="9">A</tspan><tspan dy="-3"> − φ</tspan><tspan dy="3" font-size="9">B</tspan><tspan dy="-3">) = 0,4 мкДж</tspan>' : '';
		};
		draw();
		loop(fig, (dt) => {
			t = (t + dt) % 8;
			draw();
			return true;
		});
	}
</script>
