---
/**
 * A metal slab and a slab of a dielectric between two charged plates; the field of the plates goes from «+» (left)
 * to «−» (right). The loop (9 s): 1 s without a field; in 1,5 s the plates charge; then
 *  — in the metal the free electrons (blue dots) drift to the left face; the right face is left with the positive
 *    ions; the field lines end on these charges and inside the metal no field remains;
 *  — in the dielectric the molecules (each one «+» half and «−» half) turn along the field, not perfectly (they keep
 *    trembling with the heat); bound charges appear on the faces and the field inside is weaker: of six lines two go
 *    through, as for ε = 3.
 * The shift of the electrons is exaggerated (in reality it is far smaller than an atom); the motion is slowed.
 */
import G7Styles from '../g7/G7Styles.astro';

const ys = [36, 50, 64, 78, 92, 106];
const ions: { x: number; y: number }[] = [];
for (let i = 0; i < 5; i++) for (let j = 0; j < 6; j++) ions.push({ x: 78 + i * 11, y: 38 + j * 13 });
const mols: { x: number; y: number }[] = [];
for (let i = 0; i < 4; i++) for (let j = 0; j < 5; j++) mols.push({ x: 80 + i * 13.5, y: 40 + j * 15 });
---

<G7Styles />
<figure class="g7 g7--pic pol not-content" data-pol>
	<div class="g7__grid is-two">
		{['metal', 'diel'].map((kind) => (
			<svg class="g7__svg" viewBox="0 0 200 160" role="img" aria-label={kind === 'metal' ? 'Металлическая пластина в электрическом поле: свободные электроны смещаются к одной грани, и поле внутри металла исчезает' : 'Диэлектрик в электрическом поле: молекулы поворачиваются вдоль поля, и поле внутри ослабевает'} data-panel={kind}>
				<rect class="pol__plate" x="14" y="14" width="6" height="114" rx="1.5" data-plate="+" />
				<rect class="pol__plate" x="180" y="14" width="6" height="114" rx="1.5" data-plate="-" />
				<g data-psigns />
				{[22, 120, ...ys].map((y) => (
					<g data-line={y}>
						<line class="pol__line" x1="22" y1={y} x2={ys.includes(y) ? 70 : 178} y2={y} />
						{ys.includes(y) && <line class="pol__line" x1="130" y1={y} x2="178" y2={y} />}
						{ys.includes(y) && <line class="pol__line pol__in" x1="70" y1={y} x2="130" y2={y} />}
						<path class="pol__tip" d={`M${ys.includes(y) ? 48 : 104} ${y} l-6 -3 v6 Z`} />
					</g>
				))}
				<rect class={kind === 'metal' ? 'pol__metal' : 'pol__diel'} x="70" y="30" width="60" height="82" rx="3" />
				{kind === 'metal' ? (
					<>
						{ions.map((p) => <circle class="pol__ion" cx={p.x} cy={p.y} r="2.6" />)}
						<g data-electrons>
							{ions.map((p) => <circle class="pol__el" cx={p.x + 5} cy={p.y + 6} r="1.9" />)}
						</g>
					</>
				) : (
					<g data-mols>
						{mols.map((p) => (
							<g transform={`translate(${p.x} ${p.y})`}>
								<g data-mol>
									<path class="pol__mp" d="M0 -3 A6 3 0 0 1 0 3 Z" />
									<path class="pol__mm" d="M0 -3 A6 3 0 0 0 0 3 Z" />
								</g>
							</g>
						))}
					</g>
				)}
				<g data-face opacity="0">
					{[0, 1, 2, 3, 4].map((i) => (
						<>
							<path class="pol__s pol__s--m" d={`M64 ${42 + 15 * i} h4`} />
							<path class="pol__s pol__s--p" d={`M132 ${42 + 15 * i} h4 M134 ${40 + 15 * i} v4`} />
						</>
					))}
				</g>
				<text class="t-title" x="100" y="148" text-anchor="middle">{kind === 'metal' ? 'Проводник' : 'Диэлектрик'}</text>
				<text class="t-small t-halo" x="100" y="10" text-anchor="middle" data-state></text>
			</svg>
		))}
	</div>
	<figcaption class="g7__caption">Слева пластина «+», справа «−». Смещение электронов сильно преувеличено и замедлено: на самом деле оно меньше размера атома и происходит почти мгновенно.</figcaption>
</figure>

<style is:global>
	[data-pol] .pol__plate[data-plate='+'] {
		fill: var(--g7-red);
	}
	[data-pol] .pol__plate[data-plate='-'] {
		fill: var(--g7-blue);
	}
	[data-pol] .pol__plate {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-pol] .pol__line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	[data-pol] .pol__tip {
		fill: var(--sl-color-gray-2);
	}
	[data-pol] .pol__metal {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		opacity: 0.85;
	}
	[data-pol] .pol__diel {
		fill: color-mix(in oklab, var(--ig-v) 18%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		opacity: 0.85;
	}
	[data-pol] .pol__ion {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 0.9;
		opacity: 0.8;
	}
	[data-pol] .pol__el {
		fill: var(--g7-blue);
	}
	[data-pol] .pol__mp {
		fill: var(--g7-red);
	}
	[data-pol] .pol__mm {
		fill: var(--g7-blue);
	}
	[data-pol] .pol__s {
		fill: none;
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	[data-pol] .pol__s--m {
		stroke: var(--g7-blue);
	}
	[data-pol] .pol__s--p {
		stroke: var(--g7-red);
	}
	[data-pol] .pol__sp {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 1.4;
	}
</style>

<script>
	import { el, loop, rng } from '../g7/kit';

	const ys = [36, 50, 64, 78, 92, 106];
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-pol]')) {
		const panels = [...root.querySelectorAll<SVGSVGElement>('[data-panel]')];
		const rand = rng(7);
		// the molecules: a random start angle, a random phase of the heat tremble
		const mols = [...root.querySelectorAll<SVGGElement>('[data-mol]')].map((g) => ({ g, a0: rand() * 2 * Math.PI, ph: rand() * 6.3 }));
		const els = [...root.querySelectorAll<SVGCircleElement>('[data-electrons] circle')].map((c) => ({ c, x: +c.getAttribute('cx')!, ph: rand() * 6.3 }));
		// the signs on the plates, five on each
		for (const p of panels) {
			const g = p.querySelector('[data-psigns]')!;
			for (let i = 0; i < 5; i++) {
				const y = 32 + 19 * i;
				g.append(el('path', { class: 'pol__sp', d: `M15 ${y} h4 M17 ${y - 2} v4`, 'data-ps': '' }));
				g.append(el('path', { class: 'pol__sp', d: `M181 ${y} h4`, 'data-ps': '' }));
			}
		}
		let t = 0;
		loop(root, (dt) => {
			t = (t + dt) % 9;
			const on = ease((t - 1) / 1.5); // the plates charge
			const pol = ease((t - 1.6) / 2); // the slab answers
			for (const p of panels) {
				const metal = p.dataset.panel === 'metal';
				for (const s of p.querySelectorAll<SVGPathElement>('[data-ps]')) s.style.opacity = String(on);
				for (const y of [22, 120, ...ys]) {
					const g = p.querySelector<SVGGElement>(`[data-line="${y}"]`)!;
					g.style.opacity = String(on);
					const inner = g.querySelector<SVGLineElement>('.pol__in');
					if (inner) {
						const keep = !metal && (y === 50 || y === 92);
						inner.style.opacity = String(keep ? 1 : 1 - pol);
					}
				}
				p.querySelector<SVGGElement>('[data-face]')!.setAttribute('opacity', String(pol));
				p.querySelector('[data-state]')!.textContent = on < 0.05 ? 'поля нет' : metal ? (pol > 0.9 ? 'внутри металла поля нет' : '') : pol > 0.9 ? 'поле внутри ослаблено' : '';
			}
			// electrons drift to the left face (and tremble a little)
			for (const e of els) {
				const shift = -(e.x - 72) * pol; // to x ≈ 72
				e.c.setAttribute('cx', (e.x + shift + 0.6 * Math.sin(t * 9 + e.ph)).toFixed(1));
			}
			// molecules: from a random angle to the field direction (+ end to the right), trembling ±18°
			for (const m of mols) {
				const tremble = 0.32 * Math.sin(t * 3.1 + m.ph);
				let a0 = m.a0 % (2 * Math.PI);
				if (a0 > Math.PI) a0 -= 2 * Math.PI;
				const a = a0 * (1 - pol) + tremble * (0.4 + 0.6 * pol);
				m.g.setAttribute('transform', `rotate(${((a * 180) / Math.PI).toFixed(1)})`);
			}
			return true;
		});
	}
</script>
