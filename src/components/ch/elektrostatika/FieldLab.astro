---
/**
 * «Поле двух зарядов»: two point charges q₁ and q₂ (sliders, −4 … +4 нКл) stand 8 см apart; a small positive probe
 * charge is dragged to any point of a 1 см grid (not closer than 2 см to a charge). At the probe the model draws
 * the field of each charge, E₁ = k|q₁|/r₁² and E₂ = k|q₂|/r₂² (violet, thin), the parallelogram (dashed) and the
 * resulting field E = E₁ + E₂ as a vector sum (gold), k = 9·10⁹ Н·м²/Кл². Scale: 20 px per сантиметр; arrows
 * 6 px per кН/Кл. An arrow longer than 120 px is cut, drawn with a dashed end, and the number says how large it is.
 * Examples (both 2 нКл, probe 3 см above the middle, r = 5 см): E₁ = E₂ = 7,2 кН/Кл, E = 8,64 кН/Кл straight up;
 * with q₂ = −2 нКл E = 11,52 кН/Кл along the line from q₁ to q₂.
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 170;
const CY = 136;
const PX = 20;
const dots: { x: number; y: number }[] = [];
for (let i = -8; i <= 8; i++) for (let j = -6; j <= 4; j++) dots.push({ x: CX + i * PX, y: CY + j * PX });
---

<G7Styles />
<figure class="g7 fl not-content" data-fl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 232" role="img" aria-label="Два точечных заряда и пробный заряд; в точке, где он стоит, показаны напряжённости полей каждого заряда и их векторная сумма" data-svg>
			{dots.map((d) => <circle class="fl__dot" cx={d.x} cy={d.y} r="0.9" />)}
			<line class="ln-dash" x1={CX - 4 * PX} y1={CY} x2={CX + 4 * PX} y2={CY}></line>
			<text class="t-small" x={CX} y={CY + 27} text-anchor="middle">8 см</text>
			<line class="ln-dash fl__r" data-r1 x1="0" y1="0" x2="0" y2="0"></line>
			<line class="ln-dash fl__r" data-r2 x1="0" y1="0" x2="0" y2="0"></line>
			<path class="fl__par" data-par></path>
			<path class="fl__e12" data-e1l></path>
			<path class="fl__e12h" data-e1h></path>
			<path class="fl__e12" data-e2l></path>
			<path class="fl__e12h" data-e2h></path>
			<path class="arrow arrow--gold" data-el></path>
			<path class="head--gold" data-eh></path>
			{[1, 2].map((i) => (
				<g>
					<circle class="fl__q" data-qc={i} cx={CX + (i === 1 ? -4 : 4) * PX} cy={CY} r="9" />
					<path class="fl__sign" data-qs={i} />
					<text class="t-strong t-halo" x={CX + (i === 1 ? -4 : 4) * PX} y={CY + 26} text-anchor="middle">
						q<tspan baseline-shift="sub" font-size="9">{i}</tspan>
					</text>
				</g>
			))}
			<circle class="fl__probe drag" data-probe cx="0" cy="0" r="5"></circle>
			<circle class="drag" data-grab cx="0" cy="0" r="16" fill="transparent"></circle>
			<text class="t-small t-halo t-gold" data-elab x="0" y="0">E</text>
			<text class="t-small t-halo" x="6" y="228">тяните пробный заряд</text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Заряд <i>q</i><sub>1</sub></span>
				<output data-o1></output>
				<input type="range" min="-4" max="4" step="1" value="2" data-q1 aria-label="Заряд q1, нанокулоны" />
			</label>
			<label class="g7__slider">
				<span>Заряд <i>q</i><sub>2</sub></span>
				<output data-o2></output>
				<input type="range" min="-4" max="4" step="1" value="2" data-q2 aria-label="Заряд q2, нанокулоны" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>расстояния <i>r</i><sub>1</sub>, <i>r</i><sub>2</sub></span> <b data-rr></b></li>
				<li><span>поле заряда <i>q</i><sub>1</sub>: <i>E</i><sub>1</sub></span> <b data-e1></b></li>
				<li><span>поле заряда <i>q</i><sub>2</sub>: <i>E</i><sub>2</sub></span> <b data-e2></b></li>
				<li class="is-key"><span>результирующее поле <i>E</i></span> <b data-e></b></li>
			</ul>
			<p class="g7__note">Тонкие стрелки — поля каждого заряда, толстая — их векторная сумма.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Масштаб: 1&nbsp;см — 20&nbsp;px; стрелка 6&nbsp;px — 1&nbsp;кН/Кл. Стрелка длиннее 120&nbsp;px обрезана (её конец пунктирный).</figcaption>
</figure>

<style is:global>
	[data-fl] .fl__dot {
		fill: var(--sl-color-gray-4);
	}
	[data-fl] .fl__r {
		opacity: 0.6;
	}
	[data-fl] .fl__par {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		opacity: 0.8;
	}
	[data-fl] .fl__e12 {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-fl] .fl__e12h {
		fill: var(--g7-violet);
	}
	[data-fl] .is-cut {
		stroke-dasharray: 6 3;
	}
	[data-fl] .fl__q {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-fl] .fl__q.is-plus {
		fill: var(--g7-red);
	}
	[data-fl] .fl__q.is-minus {
		fill: var(--g7-blue);
	}
	[data-fl] .fl__sign {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-fl] .fl__probe {
		fill: var(--g7-red);
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
</style>

<script>
	import { drag } from '../g7/kit';
	import { arrow, sig, K } from './vec';

	const CX = 170;
	const CY = 136;
	const PX = 20;
	const SC = 6; // px per кН/Кл
	const CUT = 120;
	const fq = (q: number) => `${q > 0 ? '+' : q < 0 ? '−' : ''}${Math.abs(q)} нКл`;
	const fr = (v: number) => (Math.round(v * 100) / 100).toString().replace('.', ',');

	for (const root of document.querySelectorAll<HTMLElement>('[data-fl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = $<SVGSVGElement>('[data-svg]');
		const s1 = $<HTMLInputElement>('[data-q1]');
		const s2 = $<HTMLInputElement>('[data-q2]');
		let P = { i: 0, j: -3 }; // the probe, см (x to the right, y up)
		const Q = [
			{ i: -4, j: 0 },
			{ i: 4, j: 0 },
		];
		const ok = (i: number, j: number) => Q.every((q) => Math.hypot(i - q.i, j - q.j) >= 2 - 1e-9) && Math.abs(i) <= 8 && j >= -6 && j <= 4;

		const vec = (lc: string, hc: string, x: number, y: number, ex: number, ey: number) => {
			// ex, ey in кН/Кл; y of the screen goes down
			const L = Math.hypot(ex, ey) * SC;
			const k = L > CUT ? CUT / L : 1;
			const a = arrow(x, y, x + ex * SC * k, y + ey * SC * k, 7);
			const l = $(lc);
			l.setAttribute('d', a.line);
			l.classList.toggle('is-cut', L > CUT);
			$(hc).setAttribute('d', a.head);
			return { x: x + ex * SC * k, y: y + ey * SC * k };
		};

		const draw = () => {
			const q = [+s1.value, +s2.value];
			$('[data-o1]').textContent = fq(q[0]);
			$('[data-o2]').textContent = fq(q[1]);
			q.forEach((v, n) => {
				const c = $(`[data-qc="${n + 1}"]`);
				c.classList.toggle('is-plus', v > 0);
				c.classList.toggle('is-minus', v < 0);
				const x = CX + Q[n].i * PX;
				const h = 4.5;
				$(`[data-qs="${n + 1}"]`).setAttribute('d', v > 0 ? `M${x - h} ${CY} H${x + h} M${x} ${CY - h} V${CY + h}` : v < 0 ? `M${x - h} ${CY} H${x + h}` : '');
			});
			const px = CX + P.i * PX;
			const py = CY + P.j * PX;
			for (const s of ['[data-probe]', '[data-grab]']) {
				$(s).setAttribute('cx', String(px));
				$(s).setAttribute('cy', String(py));
			}
			// the fields in кН/Кл, screen axes
			const parts = Q.map((c, n) => {
				const dx = (P.i - c.i) / 100;
				const dy = (P.j - c.j) / 100;
				const r = Math.hypot(dx, dy);
				const E = (K * Math.abs(q[n]) * 1e-9) / r ** 2 / 1000;
				const s = Math.sign(q[n]);
				const line = $(`[data-r${n + 1}]`);
				line.setAttribute('x1', String(CX + c.i * PX));
				line.setAttribute('y1', String(CY));
				line.setAttribute('x2', String(px));
				line.setAttribute('y2', String(py));
				return { r: r * 100, E, ex: (s * E * dx) / r, ey: (s * E * dy) / r };
			});
			const t1 = vec('[data-e1l]', '[data-e1h]', px, py, parts[0].ex, parts[0].ey);
			const t2 = vec('[data-e2l]', '[data-e2h]', px, py, parts[1].ex, parts[1].ey);
			const ex = parts[0].ex + parts[1].ex;
			const ey = parts[0].ey + parts[1].ey;
			const t = vec('[data-el]', '[data-eh]', px, py, ex, ey);
			const E = Math.hypot(ex, ey);
			// the parallelogram, only when both fields are there and no arrow is cut
			const cut = [parts[0].E, parts[1].E, E].some((v) => v * SC > CUT);
			$('[data-par]').setAttribute('d', parts[0].E > 0 && parts[1].E > 0 && !cut && E * SC > 3 ? `M${t1.x} ${t1.y} L${t.x} ${t.y} L${t2.x} ${t2.y}` : '');
			const lab = $('[data-elab]');
			const ux = E > 0 ? ex / E : 0;
			const uy = E > 0 ? ey / E : 0;
			lab.setAttribute('x', (t.x + ux * 10 - 4).toFixed(1));
			lab.setAttribute('y', (t.y + uy * 10 + 4).toFixed(1));
			lab.textContent = E * SC > 6 ? 'E' : '';
			$('[data-rr]').textContent = `${fr(parts[0].r)} и ${fr(parts[1].r)} см`;
			$('[data-e1]').textContent = `${sig(parts[0].E)} кН/Кл`;
			$('[data-e2]').textContent = `${sig(parts[1].E)} кН/Кл`;
			$('[data-e]').textContent = `${E < 1e-9 ? '0' : sig(E)} кН/Кл`;
		};

		drag($('[data-grab]'), svg, {
			move: (p) => {
				const i = Math.round((p.x - CX) / PX);
				const j = Math.round((p.y - CY) / PX);
				if ((i !== P.i || j !== P.j) && ok(i, j)) {
					P = { i, j };
					draw();
				}
			},
		});
		for (const s of [s1, s2]) s.addEventListener('input', draw);
		draw();
	}
</script>
