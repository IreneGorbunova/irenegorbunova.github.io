---
/**
 * «Поле двух зарядов»: two point charges q₁ and q₂ (sliders, −4 … +4 нКл) stand 8 см apart; a small positive probe
 * charge is dragged to any point of a 1 см grid (not closer than 2 см to a charge). At the probe the model draws
 * the field of each charge, E₁ = k|q₁|/r₁² and E₂ = k|q₂|/r₂² (violet, thin), the parallelogram (dashed) and the
 * resulting field E⃗ = E⃗₁ + E⃗₂ as a vector sum (gold), k = 9·10⁹ Н·м²/Кл²; the arrows are labelled E⃗₁, E⃗₂, E⃗ (vlab.ts),
 * each label at the free spot nearest to its arrow; the names q₁, q₂ and «8 см» also move to the freest side. Scale: 20 px per сантиметр; arrows
 * 6 px per кН/Кл. An arrow longer than 120 px is cut, drawn with a dashed end, and the number says how large it is.
 * Examples (both 2 нКл, probe 3 см above the middle, r = 5 см): E₁ = E₂ = 7,2 кН/Кл, E = 8,64 кН/Кл straight up;
 * with q₂ = −2 нКл E = 11,52 кН/Кл along the line from q₁ to q₂.
 */
import G7Styles from '../g7/G7Styles.astro';
import VlabStyles from './VlabStyles.astro';

const CX = 170;
const CY = 136;
const PX = 20;
const dots: { x: number; y: number }[] = [];
for (let i = -8; i <= 8; i++) for (let j = -6; j <= 4; j++) dots.push({ x: CX + i * PX, y: CY + j * PX });
---

<G7Styles />
<VlabStyles />
<figure class="g7 fl not-content" data-fl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 232" role="img" aria-label="Два точечных заряда и пробный заряд; в точке, где он стоит, показаны напряжённости полей каждого заряда и их векторная сумма" data-svg>
			{dots.map((d) => <circle class="fl__dot" cx={d.x} cy={d.y} r="0.9" />)}
			<line class="ln-dash" x1={CX - 4 * PX} y1={CY} x2={CX + 4 * PX} y2={CY}></line>
			<text class="t-small t-halo" data-dlab x={CX} y={CY + 27} text-anchor="middle">8 см</text>
			<line class="ln-dash fl__r" data-r1 x1="0" y1="0" x2="0" y2="0"></line>
			<line class="ln-dash fl__r" data-r2 x1="0" y1="0" x2="0" y2="0"></line>
			<path class="fl__par" data-par></path>
			<path class="fl__e12" data-e1l></path>
			<path class="fl__e12h" data-e1h></path>
			<path class="fl__e12" data-e2l></path>
			<path class="fl__e12h" data-e2h></path>
			<path class="arrow arrow--gold" data-el></path>
			<path class="head--gold" data-eh></path>
			{[1, 2].map((i) => (
				<g>
					<circle class="fl__q" data-qc={i} cx={CX + (i === 1 ? -4 : 4) * PX} cy={CY} r="9" />
					<path class="fl__sign" data-qs={i} />
					<text class="t-strong t-halo" data-qlab={i} x={CX + (i === 1 ? -4 : 4) * PX} y={CY + 26} text-anchor="middle">
						q<tspan baseline-shift="sub" font-size="9">{i}</tspan>
					</text>
				</g>
			))}
			<circle class="fl__probe drag" data-probe cx="0" cy="0" r="5"></circle>
			<circle class="drag" data-grab cx="0" cy="0" r="16" fill="transparent"></circle>
			<g data-lab0></g>
			<g data-lab1></g>
			<g data-lab2></g>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Заряд <i>q</i><sub>1</sub></span>
				<output data-o1></output>
				<input type="range" min="-4" max="4" step="1" value="2" data-q1 aria-label="Заряд q1, нанокулоны" />
			</label>
			<label class="g7__slider">
				<span>Заряд <i>q</i><sub>2</sub></span>
				<output data-o2></output>
				<input type="range" min="-4" max="4" step="1" value="2" data-q2 aria-label="Заряд q2, нанокулоны" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>расстояния <i>r</i><sub>1</sub>, <i>r</i><sub>2</sub></span> <b data-rr></b></li>
				<li><span>поле заряда <i>q</i><sub>1</sub>: <i>E</i><sub>1</sub></span> <b data-e1></b></li>
				<li><span>поле заряда <i>q</i><sub>2</sub>: <i>E</i><sub>2</sub></span> <b data-e2></b></li>
				<li class="is-key"><span>результирующее поле <i>E</i></span> <b data-e></b></li>
			</ul>
			<p class="g7__note">Тяните пробный заряд по сетке. Тонкие стрелки — поля каждого заряда, толстая — их векторная сумма.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Рисунок и стрелки в масштабе. Слишком длинная стрелка обрезана, её конец пунктирный.</figcaption>
</figure>

<style is:global>
	[data-fl] .fl__dot {
		fill: var(--sl-color-gray-4);
	}
	[data-fl] .fl__r {
		opacity: 0.6;
	}
	[data-fl] .fl__par {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		opacity: 0.8;
	}
	[data-fl] .fl__e12 {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-fl] .fl__e12h {
		fill: var(--g7-violet);
	}
	[data-fl] .is-cut {
		stroke-dasharray: 6 3;
	}
	[data-fl] .fl__q {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-fl] .fl__q.is-plus {
		fill: var(--g7-red);
	}
	[data-fl] .fl__q.is-minus {
		fill: var(--g7-blue);
	}
	[data-fl] .fl__sign {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-fl] .fl__probe {
		fill: var(--g7-red);
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
</style>

<script>
	import { drag } from '../g7/kit';
	import { arrow, sig, K } from './vec';
	import { vlabSvg } from './vlab';

	const CX = 170;
	const CY = 136;
	const PX = 20;
	const SC = 6; // px per кН/Кл
	const CUT = 120;
	const fq = (q: number) => `${q > 0 ? '+' : q < 0 ? '−' : ''}${Math.abs(q)} нКл`;
	const fr = (v: number) => (Math.round(v * 100) / 100).toString().replace('.', ',');

	for (const root of document.querySelectorAll<HTMLElement>('[data-fl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = $<SVGSVGElement>('[data-svg]');
		const s1 = $<HTMLInputElement>('[data-q1]');
		const s2 = $<HTMLInputElement>('[data-q2]');
		let P = { i: 0, j: -3 }; // the probe, см (x to the right, y up)
		const Q = [
			{ i: -4, j: 0 },
			{ i: 4, j: 0 },
		];
		const ok = (i: number, j: number) => Q.every((q) => Math.hypot(i - q.i, j - q.j) >= 2 - 1e-9) && Math.abs(i) <= 8 && j >= -6 && j <= 4;

		const labs = [$<SVGGElement>('[data-lab0]'), $<SVGGElement>('[data-lab1]'), $<SVGGElement>('[data-lab2]')];
		labs[0].innerHTML = vlabSvg('E', '', 'vl--gold', 13);
		labs[1].innerHTML = vlabSvg('E', '1', 'vl--violet', 13);
		labs[2].innerHTML = vlabSvg('E', '2', 'vl--violet', 13);
		// places the labels: first the names of the charges (around each charge) and «8 см» (under or over the line
		// between them), then the labels of the arrows; each at the candidate spot whose box keeps farthest from the
		// arrows, the dashed lines, the charges, the probe and the labels placed before it (candidates kept in the svg; the
		// first candidate with a 3 px margin is taken, otherwise the freest one)
		const dots = [...root.querySelectorAll<SVGCircleElement>('.fl__dot')];
		const qlabs = [$<SVGTextElement>('[data-qlab="1"]'), $<SVGTextElement>('[data-qlab="2"]')];
		const dlab = $<SVGTextElement>('[data-dlab]');
		type Pt = { x: number; y: number };
		const placeLabels = (px: number, py: number, tips: { x: number; y: number; on: boolean; w: number }[], par: boolean) => {
			const pts: Pt[] = [];
			const seg = (a: Pt, b: Pt, n = 30) => {
				for (let k = 0; k <= n; k++) pts.push({ x: a.x + ((b.x - a.x) * k) / n, y: a.y + ((b.y - a.y) * k) / n });
			};
			for (const t of tips) if (t.on) seg({ x: px, y: py }, t, 24);
			for (const c of Q) seg({ x: CX + c.i * PX, y: CY }, { x: px, y: py });
			if (par && tips[1].on && tips[2].on) {
				seg(tips[1], tips[0]);
				seg(tips[2], tips[0]);
			}
			seg({ x: CX - 4 * PX, y: CY }, { x: CX + 4 * PX, y: CY });
			for (const c of Q) for (let a = 0; a < 16; a++) pts.push({ x: CX + c.i * PX + 10 * Math.cos(a), y: CY + 10 * Math.sin(a) });
			for (let a = 0; a < 12; a++) pts.push({ x: px + 6 * Math.cos(a), y: py + 6 * Math.sin(a) });
			const boxes: { x: number; y: number; w: number; h: number }[] = [];
			// the best of the candidate centers for a box w × h
			const best = (cands: Pt[], w: number, h: number): Pt => {
				let b = cands[0];
				let bd = -1;
				for (const c0 of cands) {
					const c = { x: Math.min(338 - w / 2, Math.max(2 + w / 2, c0.x)), y: Math.min(230 - h / 2, Math.max(2 + h / 2, c0.y)) };
					let d = 1e9;
					for (const q of pts) d = Math.min(d, Math.hypot(Math.max(0, Math.abs(q.x - c.x) - w / 2), Math.max(0, Math.abs(q.y - c.y) - h / 2)));
					for (const o of boxes) d = Math.min(d, Math.hypot(Math.max(0, Math.abs(o.x - c.x) - (w + o.w) / 2), Math.max(0, Math.abs(o.y - c.y) - (h + o.h) / 2)));
					if (d > bd + 0.5) {
						bd = d;
						b = c;
					}
					// the candidates come in order of preference: the first one with a clear margin wins
					if (d >= 3) break;
				}
				boxes.push({ x: b.x, y: b.y, w, h });
				return b;
			};
			Q.forEach((c, n) => {
				const x = CX + c.i * PX;
				const p = best([{ x, y: CY + 22 }, { x, y: CY - 21 }, { x: x - 22, y: CY }, { x: x + 22, y: CY }, { x: x - 17, y: CY + 17 }, { x: x + 17, y: CY + 17 }, { x: x - 17, y: CY - 17 }, { x: x + 17, y: CY - 17 }], 16, 15);
				qlabs[n].setAttribute('x', p.x.toFixed(1));
				qlabs[n].setAttribute('y', (p.y + 5).toFixed(1));
			});
			const dp = best([{ x: CX, y: CY + 22 }, { x: CX, y: CY - 10 }, { x: CX - 30, y: CY + 22 }, { x: CX + 30, y: CY + 22 }, { x: CX - 30, y: CY - 10 }, { x: CX + 30, y: CY - 10 }], 36, 13);
			dlab.setAttribute('x', dp.x.toFixed(1));
			dlab.setAttribute('y', (dp.y + 4).toFixed(1));
			// the grid dots under these names are hidden, so no dot sits on a letter or its index
			const qb = [...boxes];
			for (const d of dots) {
				const x = +d.getAttribute('cx')!;
				const y = +d.getAttribute('cy')!;
				d.style.visibility = qb.some((b) => Math.abs(x - b.x) < b.w / 2 + 2 && Math.abs(y - b.y) < b.h / 2 + 2) ? 'hidden' : '';
			}
			tips.forEach((t, i) => {
				if (!t.on) {
					labs[i].style.display = 'none';
					return;
				}
				labs[i].style.display = '';
				const dx = t.x - px;
				const dy = t.y - py;
				const L = Math.hypot(dx, dy) || 1;
				const ux = dx / L;
				const uy = dy / L;
				const cands: Pt[] = [];
				for (const d of [13, 20, 28]) cands.push({ x: t.x + ux * d, y: t.y + uy * d });
				for (const f of [0.85, 0.6, 0.4]) for (const s of [1, -1]) for (const d of [13, 20, 26]) cands.push({ x: px + dx * f - s * uy * d, y: py + dy * f + s * ux * d });
				for (let a = 0; a < 8; a++) for (const d of [15, 24]) cands.push({ x: t.x + d * Math.cos((a * Math.PI) / 4), y: t.y + d * Math.sin((a * Math.PI) / 4) });
				for (let a = 0; a < 8; a++) for (const d of [18, 30, 42, 56, 70]) cands.push({ x: px + d * Math.cos((a * Math.PI) / 4 + Math.PI / 8), y: py + d * Math.sin((a * Math.PI) / 4 + Math.PI / 8) });
				const p = best(cands, t.w + 2, 21);
				// the label's origin is its baseline: the box center is about 4 px above it
				labs[i].setAttribute('transform', `translate(${p.x.toFixed(1)} ${(p.y + 4).toFixed(1)})`);
			});
		};
		const vec = (lc: string, hc: string, x: number, y: number, ex: number, ey: number) => {
			// ex, ey in кН/Кл; y of the screen goes down
			const L = Math.hypot(ex, ey) * SC;
			const k = L > CUT ? CUT / L : 1;
			const a = arrow(x, y, x + ex * SC * k, y + ey * SC * k, 7);
			const l = $(lc);
			l.setAttribute('d', a.line);
			l.classList.toggle('is-cut', L > CUT);
			$(hc).setAttribute('d', a.head);
			return { x: x + ex * SC * k, y: y + ey * SC * k };
		};

		const draw = () => {
			const q = [+s1.value, +s2.value];
			$('[data-o1]').textContent = fq(q[0]);
			$('[data-o2]').textContent = fq(q[1]);
			q.forEach((v, n) => {
				const c = $(`[data-qc="${n + 1}"]`);
				c.classList.toggle('is-plus', v > 0);
				c.classList.toggle('is-minus', v < 0);
				const x = CX + Q[n].i * PX;
				const h = 4.5;
				$(`[data-qs="${n + 1}"]`).setAttribute('d', v > 0 ? `M${x - h} ${CY} H${x + h} M${x} ${CY - h} V${CY + h}` : v < 0 ? `M${x - h} ${CY} H${x + h}` : '');
			});
			const px = CX + P.i * PX;
			const py = CY + P.j * PX;
			for (const s of ['[data-probe]', '[data-grab]']) {
				$(s).setAttribute('cx', String(px));
				$(s).setAttribute('cy', String(py));
			}
			// the fields in кН/Кл, screen axes
			const parts = Q.map((c, n) => {
				const dx = (P.i - c.i) / 100;
				const dy = (P.j - c.j) / 100;
				const r = Math.hypot(dx, dy);
				const E = (K * Math.abs(q[n]) * 1e-9) / r ** 2 / 1000;
				const s = Math.sign(q[n]);
				const line = $(`[data-r${n + 1}]`);
				line.setAttribute('x1', String(CX + c.i * PX));
				line.setAttribute('y1', String(CY));
				line.setAttribute('x2', String(px));
				line.setAttribute('y2', String(py));
				return { r: r * 100, E, ex: (s * E * dx) / r, ey: (s * E * dy) / r };
			});
			const t1 = vec('[data-e1l]', '[data-e1h]', px, py, parts[0].ex, parts[0].ey);
			const t2 = vec('[data-e2l]', '[data-e2h]', px, py, parts[1].ex, parts[1].ey);
			const ex = parts[0].ex + parts[1].ex;
			const ey = parts[0].ey + parts[1].ey;
			const t = vec('[data-el]', '[data-eh]', px, py, ex, ey);
			const E = Math.hypot(ex, ey);
			// the parallelogram, only when both fields are there and no arrow is cut
			const cut = [parts[0].E, parts[1].E, E].some((v) => v * SC > CUT);
			$('[data-par]').setAttribute('d', parts[0].E > 0 && parts[1].E > 0 && !cut && E * SC > 3 ? `M${t1.x} ${t1.y} L${t.x} ${t.y} L${t2.x} ${t2.y}` : '');
			placeLabels(
				px,
				py,
				[
					{ ...t, on: E * SC > 6, w: 12 },
					{ ...t1, on: parts[0].E * SC > 6, w: 18 },
					{ ...t2, on: parts[1].E * SC > 6, w: 18 },
				],
				parts[0].E > 0 && parts[1].E > 0 && !cut && E * SC > 3,
			);
			$('[data-rr]').textContent = `${fr(parts[0].r)} и ${fr(parts[1].r)} см`;
			$('[data-e1]').textContent = `${sig(parts[0].E)} кН/Кл`;
			$('[data-e2]').textContent = `${sig(parts[1].E)} кН/Кл`;
			$('[data-e]').textContent = `${E < 1e-9 ? '0' : sig(E)} кН/Кл`;
		};

		drag($('[data-grab]'), svg, {
			move: (p) => {
				const i = Math.round((p.x - CX) / PX);
				const j = Math.round((p.y - CY) / PX);
				if ((i !== P.i || j !== P.j) && ok(i, j)) {
					P = { i, j };
					draw();
				}
			},
		});
		for (const s of [s1, s2]) s.addEventListener('input', draw);
		draw();
	}
</script>
