---
/**
 * «Крутильные весы Кулона» (picture, looping animation of 15 s; two panels, stacked on a phone).
 * Left: the balance as in Coulomb's memoir of 1785, seen from the side (a scheme, not to scale): a glass cylinder with
 * a lid, a tube on the lid with the torsion head and its scale at the top, a thin silver wire down the tube to a light
 * horizontal needle with a small gilded pith ball «a» on one end and a counterweight on the other, a fixed ball «t»
 * lowered through a hole in the lid, and a degree scale around the cylinder at the level of the balls.
 * Right: the same seen from above (ball t at 0° of the scale, the needle turns about the wire), the torsion head as a
 * small dial with its pointer, and a table that fills row by row with Coulomb's own data:
 *   1) head at 0, the balls charged by touching: a is repelled to 36° from t — the wire is twisted by 36°;
 *   2) the head is turned by 126°: the balls stop 18° apart — the twist is 126° + 18° = 144°;
 *   3) the head is turned by 567°: the balls stop 8,5° apart — the twist is 567° + 8,5° ≈ 576°.
 * The twist of the wire is proportional to the force. Half the distance, four times the twist: 144/36 = 4 with
 * (36/18)² = 4; 576/36 = 16 while (36/8,5)² = 17,9 — Coulomb put the difference down to charge leaking away. The
 * picture does not write the ratios or 1/r² (the model and the text find them). Angles in the top view are true; the
 * needle swings to each new rest in about 2 s (slowed: a real swing took minutes).
 */
import G7Styles from '../g7/G7Styles.astro';

const W = 200;
const H = 250;
// the side view
const CX = 70; // the axis of the wire
const LID = 92;
const BOT = 206;
const BALL = 152; // level of the balls
const RX = 52; // the cylinder's half-width
// the top view
const OX = 108;
const OY = 86;
const R = 54; // the radius of the ball a's circle, px
const ticks = Array.from({ length: 36 }, (_, i) => i * 10);
const pol = (deg: number, r: number) => {
	const a = ((deg - 90) * Math.PI) / 180;
	return { x: OX + r * Math.cos(a), y: OY + r * Math.sin(a) };
};
---

<G7Styles />
<figure class="g7 g7--pic tb not-content" data-tb>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Крутильные весы Кулона сбоку: стеклянный цилиндр, на крышке трубка с головкой и отсчётом, серебряная нить, коромысло с шариком a и противовесом, неподвижный шарик t и шкала вокруг цилиндра">
			<text class="t-title" x="8" y="16">Вид сбоку</text>
			<!-- the torsion head and the tube -->
			<rect class="tb__brass" x={CX - 12} y="30" width="24" height="7" rx="1.5" />
			<ellipse class="tb__brass" cx={CX} cy="30" rx="12" ry="3.5" />
			<path class="tb__tick" d={Array.from({ length: 9 }, (_, i) => `M${CX - 10 + i * 2.5} 32 v3`).join(' ')} />
			<rect class="tb__glass" x={CX - 5} y="37" width="10" height={LID - 37} />
			<!-- the cylinder -->
			<path class="tb__glass" d={`M${CX - RX} ${LID} V${BOT} A${RX} 8 0 0 0 ${CX + RX} ${BOT} V${LID}`} />
			<ellipse class="tb__lid" cx={CX} cy={LID} rx={RX} ry="8" />
			<ellipse class="tb__hole" cx={CX - 30} cy={LID + 1} rx="3" ry="1.5" />
			<!-- the scale band around the cylinder at the level of the balls -->
			<path class="tb__band" d={`M${CX - RX} ${BALL - 6} A${RX} 8 0 0 0 ${CX + RX} ${BALL - 6} V${BALL + 2} A${RX} 8 0 0 1 ${CX - RX} ${BALL + 2} Z`} />
			<path class="tb__tick" d={Array.from({ length: 13 }, (_, i) => { const a = Math.PI * (i / 12); const x = CX - RX * Math.cos(a); const y = BALL + 2 + 8 * Math.sin(a); return `M${x.toFixed(1)} ${y.toFixed(1)} v-3`; }).join(' ')} />
			<!-- the wire, the fixed ball t on its rod, the needle with ball a and the counterweight -->
			<line class="tb__wire" x1={CX} y1="37" x2={CX} y2={BALL} />
			<line class="tb__rod" x1={CX - 30} y1={LID + 1} x2={CX - 30} y2={BALL - 4} />
			<circle class="tb__ball" cx={CX - 30} cy={BALL} r="4" />
			<g data-side>
				<line class="tb__needle" data-needle x1="0" y1={BALL} x2="0" y2={BALL} />
				<rect class="tb__cw" data-cw x="0" y={BALL - 3} width="6" height="6" rx="1" />
				<circle class="tb__ball" data-a cx="0" cy={BALL} r="4" />
			</g>
			<ellipse class="tb__base" cx={CX} cy={BOT + 10} rx={RX + 8} ry="9" />
			<!-- labels with leaders -->
			<path class="tb__lead" d={`M${CX + 13} 31 L130 24 M${CX + 1} 66 L130 66 M${CX - 27} ${BALL - 4} L${CX - 14} 112 L130 112 M${CX + 52} ${BALL - 2} L130 140`} />
			<path class="tb__lead" data-alead d="" />
			<text class="t-small" x="133" y="22">головка</text>
			<text class="t-small" x="133" y="35">с отсчётом</text>
			<text class="t-small" x="133" y="70">нить</text>
			<text class="t-small" x="133" y="116">шарик t</text>
			<text class="t-small" x="133" y="144">шкала</text>
			<text class="t-small" x="133" y="186">шарик a</text>
		</svg>
		<svg class="g7__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Вид сверху: шарик a отталкивается от шарика t, угол между ними уменьшается, когда головку закручивают; таблица углов" data-top>
			<text class="t-title" x="8" y="16">Вид сверху</text>
			<circle class="tb__ring" cx={OX} cy={OY} r={R + 6} />
			<path class="tb__tick" d={ticks.map((d) => { const a = pol(d, R + 6); const b = pol(d, R + (d % 30 === 0 ? 12 : 9)); return `M${a.x.toFixed(1)} ${a.y.toFixed(1)} L${b.x.toFixed(1)} ${b.y.toFixed(1)}`; }).join(' ')} />
			<text class="t-small" x={OX} y={OY - R - 15} text-anchor="middle">0°</text>
			<path class="tb__arc" data-arc d="" />
			<line class="tb__needle" data-tneedle x1={OX} y1={OY} x2={OX} y2={OY} />
			<rect class="tb__cw" data-tcw x="0" y="0" width="6" height="6" rx="1" />
			<circle class="tb__wirept" cx={OX} cy={OY} r="2" />
			<circle class="tb__ball" cx={pol(0, R).x} cy={pol(0, R).y} r="4.5" />
			<circle class="tb__ball" data-ta cx={OX} cy={OY} r="4.5" />
			<text class="t-small t-halo" x={pol(0, R).x - 7} y={pol(0, R).y + 16} text-anchor="end">t</text>
			<text class="t-small t-halo" data-tal x="0" y="0">a</text>
			<text class="t-strong t-num t-halo tb__ang" data-angt x="0" y="0"></text>
			<!-- the torsion head -->
			<circle class="tb__dial" cx="24" cy="44" r="13" />
			<path class="tb__tick" d={Array.from({ length: 12 }, (_, i) => { const a = (i * Math.PI) / 6; return `M${(24 + 10 * Math.sin(a)).toFixed(1)} ${(44 - 10 * Math.cos(a)).toFixed(1)} L${(24 + 13 * Math.sin(a)).toFixed(1)} ${(44 - 13 * Math.cos(a)).toFixed(1)}`; }).join(' ')} />
			<line class="tb__ptr" data-ptr x1="24" y1="44" x2="24" y2="33" />
			<text class="t-small t-num" x="8" y="166" data-head>головка: 0°</text>
			<!-- the table -->
			<g class="tb__table">
				<line class="tb__rule" x1="6" y1="176" x2="194" y2="176" />
				<line class="tb__rule" x1="6" y1="200" x2="194" y2="200" />
				<line class="tb__rule" x1="6" y1="224" x2="194" y2="224" />
				<text class="t-small" x="8" y="192">угол a — t</text>
				<text class="t-small" x="8" y="216">закручивание</text>
				{[0, 1, 2].map((i) => (
					<>
						<text class="t-num tb__cell" data-row={i} data-c="r" x={113 + 35 * i} y="192" text-anchor="middle"></text>
						<text class="t-num tb__cell" data-row={i} data-c="f" x={113 + 35 * i} y="216" text-anchor="middle"></text>
					</>
				))}
			</g>
		</svg>
	</div>
	<figcaption class="g7__caption">Крутильные весы Кулона, схема. Шарик a отталкивается от шарика t и закручивает нить; угол закручивания пропорционален силе. Поворачивая головку, Кулон сближал шарики; в таблице — его числа. Движение ускорено.</figcaption>
</figure>

<style is:global>
	[data-tb] .g7__grid {
		max-width: 32rem;
		margin-inline: auto;
	}
	[data-tb] .tb__glass {
		fill: color-mix(in oklab, var(--g7-glass) 25%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	[data-tb] .tb__lid,
	[data-tb] .tb__base {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	[data-tb] .tb__hole {
		fill: var(--g7-wood-dark);
	}
	[data-tb] .tb__brass {
		fill: color-mix(in oklab, var(--g7-gold) 60%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--g7-gold) 50%, var(--sl-color-gray-5));
		stroke-width: 0.8;
	}
	[data-tb] .tb__band {
		fill: color-mix(in oklab, var(--g7-gold) 14%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	[data-tb] .tb__tick {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	[data-tb] .tb__wire {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-tb] .tb__rod {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	[data-tb] .tb__needle {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	[data-tb] .tb__cw {
		fill: var(--sl-color-gray-3);
	}
	[data-tb] .tb__ball {
		fill: color-mix(in oklab, var(--g7-gold) 75%, var(--sl-color-white));
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	[data-tb] .tb__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.7;
	}
	[data-tb] .tb__ring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-tb] .tb__arc {
		fill: color-mix(in oklab, var(--g7-gold) 22%, transparent);
		stroke: var(--g7-gold);
		stroke-width: 1.2;
	}
	[data-tb] .tb__wirept {
		fill: var(--sl-color-gray-1);
	}
	[data-tb] .tb__dial {
		fill: color-mix(in oklab, var(--g7-gold) 40%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-tb] .tb__ptr {
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-tb] .tb__rule {
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	[data-tb] .tb__cell {
		font-size: 12px;
		fill: var(--sl-color-gray-1);
	}
	[data-tb] .tb__ang {
		font-size: 11px;
	}
	@media (max-width: 40rem) {
		[data-tb] .tb__ang {
			font-size: 12px;
		}
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const CX = 70;
	const BALL = 152;
	const RX = 52;
	const OX = 108;
	const OY = 86;
	const R = 54;
	// Coulomb's three settings: the head (deg) and the angle between the balls (deg)
	const STEPS = [
		{ head: 0, ang: 36, row: '36°', tw: '36°' },
		{ head: 126, ang: 18, row: '18°', tw: '144°' },
		{ head: 567, ang: 8.5, row: '8½°', tw: '576°' },
	];
	const T = 15;
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	// a damped swing from a to b in about 2 s
	const swing = (a: number, b: number, u: number) => (u <= 0 ? a : b + (a - b) * Math.exp(-2.2 * u) * Math.cos(3.4 * u));
	const pol = (deg: number, r: number) => {
		const a = ((deg - 90) * Math.PI) / 180;
		return { x: OX + r * Math.cos(a), y: OY + r * Math.sin(a) };
	};
	for (const fig of document.querySelectorAll<HTMLElement>('[data-tb]')) {
		const $ = (s: string) => fig.querySelector<SVGGraphicsElement>(s)!;
		const cells = [...fig.querySelectorAll<SVGTextElement>('.tb__cell')];
		let t = 0;
		const draw = () => {
			// timeline: 0–1 s the balls touch (a at t); 1–4 s a swings out to 36°; 4–5,5 s head to 126°, a to 18°;
			// 8–10 s head to 567°, a to 8,5°; 12,5–15 s hold
			let head = 0;
			let ang = 0;
			let rows = 0;
			if (t < 1) ang = 0;
			else if (t < 4.2) {
				ang = swing(0, 36, t - 1);
				rows = t > 3.2 ? 1 : 0;
			} else if (t < 8) {
				head = 126 * ease((t - 4.2) / 1.4);
				ang = t < 5.6 ? 36 - (head / 126) * 18 : swing(18, 18, 0);
				rows = t > 6.4 ? 2 : 1;
			} else {
				head = 126 + 441 * ease((t - 8) / 2.2);
				ang = 18 - ((head - 126) / 441) * 9.5;
				rows = t > 11 ? 3 : 2;
			}
			// the top view: t at 0°, a at `ang` clockwise
			const a = pol(ang, R);
			const c = pol(ang + 180, R * 0.8);
			$('[data-tneedle]').setAttribute('x1', c.x.toFixed(1));
			$('[data-tneedle]').setAttribute('y1', c.y.toFixed(1));
			$('[data-tneedle]').setAttribute('x2', a.x.toFixed(1));
			$('[data-tneedle]').setAttribute('y2', a.y.toFixed(1));
			$('[data-tcw]').setAttribute('x', (c.x - 3).toFixed(1));
			$('[data-tcw]').setAttribute('y', (c.y - 3).toFixed(1));
			$('[data-ta]').setAttribute('cx', a.x.toFixed(1));
			$('[data-ta]').setAttribute('cy', a.y.toFixed(1));
			const al = pol(ang + 14, R - 6);
			$('[data-tal]').setAttribute('x', (al.x - 3).toFixed(1));
			$('[data-tal]').setAttribute('y', (al.y + 4).toFixed(1));
			// the arc between the balls and its angle, outside the ring
			const r0 = R + 6;
			const p0 = pol(0, r0);
			const p1 = pol(ang, r0);
			$('[data-arc]').setAttribute('d', ang > 0.5 ? `M${OX} ${OY} L${p0.x.toFixed(1)} ${p0.y.toFixed(1)} A${r0} ${r0} 0 0 1 ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} Z` : '');
			const lt = pol(Math.max(ang, 14) + 6, R + 22);
			const at = $('[data-angt]');
			at.setAttribute('x', lt.x.toFixed(1));
			at.setAttribute('y', (lt.y + 4).toFixed(1));
			at.textContent = ang > 0.5 ? `${(Math.round(ang * 2) / 2).toString().replace('.5', '½')}°` : '';
			// the side view: the needle turned by `ang` from the direction of t (t on the left, toward the viewer is +y/3)
			const ph = Math.PI - (ang * Math.PI) / 180;
			const ax = CX + 30 * Math.cos(ph);
			const ay = BALL + 0.15 * 30 * Math.sin(ph);
			$('[data-needle]').setAttribute('x1', (CX - 24 * Math.cos(ph)).toFixed(1));
			$('[data-needle]').setAttribute('y1', (BALL - 0.15 * 24 * Math.sin(ph)).toFixed(1));
			$('[data-needle]').setAttribute('x2', ax.toFixed(1));
			$('[data-needle]').setAttribute('y2', ay.toFixed(1));
			$('[data-cw]').setAttribute('x', (CX - 24 * Math.cos(ph) - 3).toFixed(1));
			$('[data-cw]').setAttribute('y', (BALL - 0.15 * 24 * Math.sin(ph) - 3).toFixed(1));
			$('[data-a]').setAttribute('cx', ax.toFixed(1));
			$('[data-a]').setAttribute('cy', ay.toFixed(1));
			$('[data-alead]').setAttribute('d', `M${ax.toFixed(1)} ${(ay + 5).toFixed(1)} L${ax.toFixed(1)} 182 L130 182`);
			// the head
			const hr = (head * Math.PI) / 180;
			$('[data-ptr]').setAttribute('x2', (24 + 11 * Math.sin(hr)).toFixed(1));
			$('[data-ptr]').setAttribute('y2', (44 - 11 * Math.cos(hr)).toFixed(1));
			$('[data-head]').textContent = `головка повёрнута на ${Math.round(head)}°`;
			for (const cell of cells) {
				const i = +cell.dataset.row!;
				cell.textContent = i < rows ? (cell.dataset.c === 'r' ? STEPS[i].row : STEPS[i].tw) : '';
			}
		};
		draw();
		loop(fig, (dt) => {
			t = (t + dt) % T;
			draw();
			return true;
		});
	}
</script>
