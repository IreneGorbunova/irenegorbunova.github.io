---
/** Styles of the vector labels made by vlab.ts (include once per component that uses them; identical copies are fine). */
---

<style is:global>
	.vl .vl__t {
		font-family: var(--ig-font-math);
		font-style: italic;
		paint-order: stroke fill;
		stroke: var(--g7-paper, var(--sl-color-bg));
		stroke-width: 3.5px;
		stroke-linejoin: round;
		fill: currentColor;
	}
	.vl .vl__sub {
		font-style: normal;
		font-family: var(--__sl-font);
	}
	.vl .vl__halo {
		fill: none;
		stroke: var(--g7-paper, var(--sl-color-bg));
		stroke-width: 3.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.vl .vl__arr {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.vl--gold {
		color: var(--g7-gold, var(--ig-v));
	}
	.vl--red {
		color: var(--g7-red, var(--ig-vy));
	}
	.vl--blue {
		color: var(--g7-blue, var(--ig-vx));
	}
	.vl--violet {
		color: var(--g7-violet, hsl(275, 75%, 76%));
	}
	.vl--ink {
		color: var(--sl-color-gray-1);
	}
</style>
