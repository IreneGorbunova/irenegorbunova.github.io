---
/**
 * Two short looping opening scenes of «Звук и его характеристики» (OUTLINE: no terms of the chapter in the pictures or
 * the visible captions; the site is silent, so what a person hears is shown only as a short word in a bubble at the
 * moment it reaches him or her; no drawn waves). Real time in both. People: the shared kit, in profile.
 *
 * Echo: an evening lake in the mountains. A teenager (165 см, about 7 heads, 0,6 px per см) stands at the end of a
 *   wooden pier and shouts toward a steep rocky cliff across the lake, 170 м away (drawn far: small, hazy, pines on
 *   top for scale; the depth is compressed, as in any picture). His hands rise to the sides of his mouth in 0,5 с
 *   (eased), the shout «Эге-гей!» shows by his mouth from 0,6 с to 1,2 с, the hands come down, and at
 *   0,6 + 2·170/343 = 1,59 с (the way there and back, 340 м, at 343 м/с) a fainter «…гей!» shows by his ear and he
 *   lifts his head a little. Only the first reflection is drawn. A small stopwatch in the corner runs from the shout and
 *   stops when the echo comes: «1,0 с».
 * Hammer: a summer meadow. Far away (343 м; drawn at 0,25 px per см, 44 px tall, larger than true perspective would
 *   allow, so that the person can be seen) a man drives a fence post with a sledgehammer held in both hands (handle
 *   90 см). One blow every 2,0 с: after the impact the hammer rests on the post for 0,2 с, rises in 0,8 с (eased),
 *   is held up for 0,75 с and comes down in 0,25 с (speeding up); the impacts are at 1,05 с, 3,05 с … (the OUTLINE's
 *   0,8 + 0,25 + 0,95 с put the hammer at its lowest just when the knock arrives, against the caption). A puff of dust at the post shows at once (light
 *   arrives in about a microsecond). In the foreground a girl (150 см, 0,7 px per см) holding a small bunch of meadow
 *   flowers watches (a hand shading the eyes cannot be drawn in profile within the kit's wrist limits); «тук!» shows by her head 343/343 = 1,00 с after each impact, when the hammer is already high in the next
 *   swing. The clock runs continuously (no hold frame); «Повторить» starts it from zero (the first knock is heard at
 *   2,05 с).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const rnd = (i: number, k: number) => {
	const r = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
	return r - Math.floor(r);
};
// ---------- echo scene
const WL = 150; // water line at the cliff
const PIER = 196; // the deck of the pier
const ridge = (y0: number, amp: number, seed: number, step = 24) => {
	let d = `M0 ${y0}`;
	for (let x = 0; x <= 360; x += step) d += ` L${x} ${(y0 - amp * (0.3 + 0.7 * rnd(x, seed))).toFixed(1)}`;
	return `${d} L360 ${y0} Z`;
};
// the cliff: a steep rock face from the water to its top, its outline
const cliff = 'M206 150 L214 128 L222 120 L226 104 L236 96 L250 92 L272 88 L300 86 L330 84 L360 83 L360 150 Z';
const strata = ['M222 122 L246 118 L270 122', 'M216 136 L240 131 L262 135 L282 132', 'M228 106 L252 102 L280 104 L310 100', 'M238 142 L262 140 L290 143 L320 139', 'M290 114 L318 110 L350 112', 'M300 128 L330 124 L360 126'];
const pines = Array.from({ length: 16 }, (_, i) => ({ x: 236 + i * 8 + rnd(i, 3) * 4, h: 7 + rnd(i, 4) * 6 })).map((p) => ({ ...p, base: p.x < 250 ? 93 : p.x < 272 ? 89.5 : p.x < 300 ? 87.5 : 85.5 }));
const planks = Array.from({ length: 16 }, (_, i) => i * 9.6);
const reeds = Array.from({ length: 14 }, (_, i) => ({ x: 150 + i * 4.5 + rnd(i, 9) * 3, h: 10 + rnd(i, 8) * 12 }));
const ripples = Array.from({ length: 12 }, (_, i) => ({ x: 20 + rnd(i, 5) * 320, y: 158 + rnd(i, 6) * 76, w: 10 + rnd(i, 7) * 26 }));
// ---------- hammer scene
const FY = 150; // the ground line of the fence
const clouds = [
	{ x: 60, y: 30, s: 1 },
	{ x: 230, y: 20, s: 0.8 },
	{ x: 330, y: 46, s: 0.6 },
];
const flowers = Array.from({ length: 40 }, (_, i) => ({ x: rnd(i, 11) * 360, y: 176 + rnd(i, 12) * 62, c: ['zi-fl-a', 'zi-fl-b', 'zi-fl-c'][i % 3] }));
const tufts = Array.from({ length: 34 }, (_, i) => ({ x: rnd(i, 13) * 360, y: 160 + rnd(i, 14) * 78 }));
const houses = [
	{ x: 26, w: 12 },
	{ x: 46, w: 10 },
	{ x: 128, w: 13 },
	{ x: 150, w: 9 },
];
---

<PeopleStyles />
<IntroFrame data-zvintro data-pier={PIER} data-fy={FY}>
	<div class="intro__card" data-scene="echo">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечернее горное озеро. Мальчик стоит на краю деревянных мостков, приложил ладони ко рту и кричит в сторону высокой скалы на другом берегу. Через секунду рядом с ним появляется ответ скалы — тише">
			<defs>
				<linearGradient id={`zi-sky-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="zi-sky-top"></stop>
					<stop offset="0.75" class="zi-sky-mid"></stop>
					<stop offset="1" class="zi-sky-low"></stop>
				</linearGradient>
				<linearGradient id={`zi-lake-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="zi-lake-far"></stop>
					<stop offset="1" class="zi-lake-near"></stop>
				</linearGradient>
				<linearGradient id={`zi-haze-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="zi-haze" stop-opacity="0.05"></stop>
					<stop offset="1" class="zi-haze" stop-opacity="0.45"></stop>
				</linearGradient>
				<clipPath id={`zi-water-${uid}`}><rect x="0" y={WL} width="360" height={240 - WL}></rect></clipPath>
			</defs>
			<rect x="0" y="0" width="360" height={WL} fill={`url(#zi-sky-${uid})`}></rect>
			<circle class="zi-sunglow" cx="118" cy="128" r="34"></circle>
			<circle class="zi-star" cx="40" cy="22" r="0.9"></circle>
			<circle class="zi-star" cx="96" cy="12" r="0.7"></circle>
			<circle class="zi-star" cx="176" cy="30" r="0.8"></circle>
			<path class="zi-mtn-far" d={ridge(WL, 46, 1, 30)}></path>
			<path class="zi-mtn-near" d={ridge(WL, 26, 2, 18)}></path>
			<!-- the cliff with pines on top, in haze -->
			<g data-cliff>
				<path class="zi-rock" d={cliff}></path>
				{strata.map((d) => <path class="zi-strata" d={d} />)}
				{pines.map((p) => <path class="zi-pine" d={`M${p.x.toFixed(1)} ${(p.base - p.h).toFixed(1)} L${(p.x + 2.6).toFixed(1)} ${p.base} L${(p.x - 2.6).toFixed(1)} ${p.base} Z`} />)}
				<path d={cliff} fill={`url(#zi-haze-${uid})`}></path>
			</g>
			<!-- the lake and the reflections -->
			<rect x="0" y={WL} width="360" height={240 - WL} fill={`url(#zi-lake-${uid})`}></rect>
			<g clip-path={`url(#zi-water-${uid})`} class="zi-reflect">
				<use href={`#zi-cliffref-${uid}`} transform={`translate(0 ${2 * WL}) scale(1 -1)`}></use>
			</g>
			<g id={`zi-cliffref-${uid}`} style="display:none">
				<path class="zi-mtn-near" d={ridge(WL, 26, 2, 18)}></path>
				<path class="zi-rock" d={cliff}></path>
			</g>
			<line class="zi-shore" x1="0" y1={WL} x2="360" y2={WL}></line>
			<g data-ripples>
				{ripples.map((r) => <path class="zi-ripple" d={`M${r.x.toFixed(1)} ${r.y.toFixed(1)} h${r.w.toFixed(1)}`} />)}
			</g>
			<g data-birds class="zi-bird"></g>
			<!-- the near shore: stones and reeds; the pier -->
			<path class="zi-stone" d="M0 214 Q14 204 30 210 Q40 200 54 212 L54 240 L0 240 Z"></path>
			{reeds.map((r) => <path class="zi-reed" d={`M${r.x.toFixed(1)} 240 Q${(r.x + 2).toFixed(1)} ${(240 - r.h / 2).toFixed(1)} ${(r.x + 3.5).toFixed(1)} ${(222 - r.h).toFixed(1)}`} />)}
			{[18, 66, 114, 146].map((x) => <rect class="zi-post" x={x} y={PIER + 2} width="4.5" height={240 - PIER} />)}
			<rect class="zi-deck" x="0" y={PIER} width="152" height="6"></rect>
			{planks.map((x) => <line class="zi-plank" x1={x} y1={PIER} x2={x} y2={PIER + 6} />)}
			<g data-teen></g>
			<g data-shout class="zi-bub" opacity="0">
				<path class="zi-bub-bg" data-bubpath></path>
				<text class="zi-bub-t" text-anchor="middle" data-bubtext>Эге-гей!</text>
			</g>
			<g data-echo class="zi-bub zi-bub--echo" opacity="0">
				<path class="zi-bub-bg" data-bubpath></path>
				<text class="zi-bub-t" text-anchor="middle" data-bubtext>…гей!</text>
			</g>
			<g class="zi-watch">
				<rect x="8" y="8" width="54" height="20" rx="10" class="zi-watch-bg"></rect>
				<circle cx="19" cy="18" r="5.2" class="zi-watch-face"></circle>
				<line x1="19" y1="18" x2="19" y2="14" class="zi-watch-hand" data-hand></line>
				<text x="28" y="22" class="zi-watch-t" data-watch>0,0 с</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Мальчик крикнул, а ровно через секунду <More term="скала ответила ему его же голосом">Это эхо — звук, отражённый от скалы. До неё 170 м: туда и обратно звук проходит 340 м — за 1 с. Подробно — в разделе <a href="#отражение-звука-эхо">«Отражение звука. Эхо»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="hammer">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Летний луг. Далеко у изгороди мужчина забивает столб тяжёлым молотом. На переднем плане девочка смотрит на него из-под ладони. Стук долетает до неё, когда молот уже снова поднят">
			<defs>
				<linearGradient id={`zi-sky2-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="zi-day-top"></stop>
					<stop offset="1" class="zi-day-low"></stop>
				</linearGradient>
				<linearGradient id={`zi-field-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="zi-field-far"></stop>
					<stop offset="1" class="zi-field-near"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="124" fill={`url(#zi-sky2-${uid})`}></rect>
			<g data-clouds>
				{clouds.map((c) => (
					<g class="zi-cloud" data-x={c.x} data-y={c.y} data-s={c.s}>
						<ellipse cx="0" cy="0" rx="22" ry="7"></ellipse>
						<ellipse cx="-9" cy="-4" rx="10" ry="7"></ellipse>
						<ellipse cx="7" cy="-6" rx="11" ry="8"></ellipse>
					</g>
				))}
			</g>
			<!-- far: a forest edge and a village beyond the river -->
			<path class="zi-forest" d={ridge(124, 14, 5, 8)}></path>
			{houses.map((h) => (
				<g>
					<rect class="zi-house" x={h.x} y={118} width={h.w} height="7"></rect>
					<path class="zi-roof" d={`M${h.x - 1} 118 L${h.x + h.w / 2} 112 L${h.x + h.w + 1} 118 Z`}></path>
				</g>
			))}
			<path class="zi-dome" d="M96 114 Q99 106 102 114 Z M98.5 114 h7 v10 h-7 Z M102 104 v3"></path>
			<rect x="0" y="124" width="360" height="116" fill={`url(#zi-field-${uid})`}></rect>
			<path class="zi-river" d="M0 132 Q90 128 180 133 T360 130 L360 136 Q270 139 180 138 T0 137 Z"></path>
			<!-- the fence: old posts with rails and the new post the man drives -->
			{[186, 206, 226, 246].map((x) => <rect class="zi-fpost" x={x - 1.4} y={FY - 26} width="2.8" height="26" />)}
			<path class="zi-rail" d={`M180 ${FY - 21} H248 M180 ${FY - 12} H248`}></path>
			<rect class="zi-fpost" data-newpost width="3" height="26"></rect>
			<g data-dust></g>
			<g data-man></g>
			<path class="zi-handle" data-handle></path>
			<rect class="zi-hammerhead" data-head width="4.4" height="2.8" rx="0.6"></rect>
			<!-- the path and the meadow in front -->
			<path class="zi-path" d="M0 240 Q40 206 120 190 Q200 176 250 160 Q262 156 268 152 L276 152 Q270 160 262 166 Q220 190 160 206 Q110 220 92 240 Z"></path>
			{tufts.map((t) => <path class="zi-grass" d={`M${t.x.toFixed(1)} ${t.y.toFixed(1)} l-1.6 -5 M${t.x.toFixed(1)} ${t.y.toFixed(1)} l0.4 -6 M${t.x.toFixed(1)} ${t.y.toFixed(1)} l2 -4.5`} />)}
			{flowers.map((f) => <circle class={f.c} cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r="1.4" />)}
			<g data-bunch-back></g>
			<g data-bunch>
				<path class="zi-stem" d="M0 9 L-1 -8 M0.6 9 L2.5 -9 M-0.6 9 L-4 -6 M0.3 9 L5 -5"></path>
				<circle class="zi-fl-a" cx="-1" cy="-9" r="2"></circle>
				<circle class="zi-fl-b" cx="2.8" cy="-10" r="1.9"></circle>
				<circle class="zi-fl-c" cx="-4.3" cy="-7" r="1.8"></circle>
				<circle class="zi-fl-a" cx="5.4" cy="-6" r="1.6"></circle>
			</g>
			<g data-girl></g>
			<g data-tuk class="zi-bub" opacity="0">
				<path class="zi-bub-bg" data-bubpath></path>
				<text class="zi-bub-t" text-anchor="middle" data-bubtext>тук!</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Молот ударил по столбу, а стук долетел до девочки, <More term="когда молот уже снова поднят">Свет от удара приходит почти сразу, а звук идёт до девочки 1 с: до плотника 343 м, а звук в воздухе проходит 343 м за секунду. Подробно — в разделе <a href="#скорость-звука">«Скорость звука»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-zvintro] {
		--zi-sky-top: hsl(232, 45%, 22%);
		--zi-sky-mid: hsl(285, 30%, 42%);
		--zi-sky-low: hsl(24, 75%, 64%);
		--zi-mtn-far: hsl(255, 22%, 40%);
		--zi-mtn-near: hsl(240, 20%, 30%);
		--zi-rock: hsl(25, 14%, 38%);
		--zi-rock-line: hsl(25, 12%, 26%);
		--zi-pine: hsl(160, 30%, 20%);
		--zi-haze: hsl(285, 35%, 70%);
		--zi-lake-far: hsl(255, 25%, 34%);
		--zi-lake-near: hsl(222, 40%, 16%);
		--zi-ripple: hsl(30, 70%, 72%);
		--zi-wood: hsl(28, 35%, 40%);
		--zi-wood-d: hsl(28, 35%, 26%);
		--zi-reed: hsl(80, 25%, 32%);
		--zi-stone: hsl(220, 8%, 30%);
		--zi-day-top: hsl(205, 60%, 58%);
		--zi-day-low: hsl(200, 55%, 82%);
		--zi-field-far: hsl(95, 35%, 52%);
		--zi-field-near: hsl(105, 38%, 36%);
		--zi-forest: hsl(140, 28%, 32%);
		--zi-ink: hsl(222, 35%, 14%);
		--zi-bub: hsl(0, 0%, 100%);
	}
	:root[data-theme='light'] [data-zvintro] {
		--zi-sky-top: hsl(228, 50%, 40%);
		--zi-sky-mid: hsl(290, 30%, 62%);
		--zi-sky-low: hsl(28, 85%, 75%);
		--zi-mtn-far: hsl(255, 22%, 58%);
		--zi-mtn-near: hsl(240, 18%, 46%);
		--zi-rock: hsl(25, 16%, 50%);
		--zi-lake-far: hsl(255, 25%, 52%);
		--zi-lake-near: hsl(222, 40%, 30%);
		--zi-day-top: hsl(205, 70%, 66%);
		--zi-day-low: hsl(200, 60%, 90%);
		--zi-field-far: hsl(95, 40%, 62%);
		--zi-field-near: hsl(105, 40%, 46%);
		--zi-forest: hsl(140, 30%, 40%);
	}
	.zi-sky-top {
		stop-color: var(--zi-sky-top);
	}
	.zi-sky-mid {
		stop-color: var(--zi-sky-mid);
	}
	.zi-sky-low {
		stop-color: var(--zi-sky-low);
	}
	.zi-sunglow {
		fill: hsl(35, 95%, 75%);
		opacity: 0.35;
	}
	.zi-star {
		fill: white;
		opacity: 0.8;
	}
	.zi-mtn-far {
		fill: var(--zi-mtn-far);
	}
	.zi-mtn-near {
		fill: var(--zi-mtn-near);
	}
	.zi-rock {
		fill: var(--zi-rock);
		stroke: var(--zi-rock-line);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.zi-strata {
		fill: none;
		stroke: var(--zi-rock-line);
		stroke-width: 0.7;
		opacity: 0.8;
	}
	.zi-pine {
		fill: var(--zi-pine);
	}
	.zi-haze {
		stop-color: var(--zi-haze);
	}
	.zi-lake-far {
		stop-color: var(--zi-lake-far);
	}
	.zi-lake-near {
		stop-color: var(--zi-lake-near);
	}
	.zi-reflect {
		opacity: 0.35;
	}
	.zi-shore {
		stroke: var(--zi-ripple);
		stroke-width: 0.6;
		opacity: 0.6;
	}
	.zi-ripple {
		stroke: var(--zi-ripple);
		stroke-width: 0.8;
		stroke-linecap: round;
		opacity: 0.45;
	}
	.zi-bird {
		fill: none;
		stroke: var(--zi-ink);
		stroke-width: 0.9;
		stroke-linecap: round;
	}
	.zi-stone {
		fill: var(--zi-stone);
		stroke: var(--zi-ink);
		stroke-width: 0.7;
	}
	.zi-reed {
		fill: none;
		stroke: var(--zi-reed);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.zi-post {
		fill: var(--zi-wood-d);
		stroke: var(--zi-ink);
		stroke-width: 0.6;
	}
	.zi-deck {
		fill: var(--zi-wood);
		stroke: var(--zi-ink);
		stroke-width: 0.8;
	}
	.zi-plank {
		stroke: var(--zi-wood-d);
		stroke-width: 0.7;
	}
	.zi-bub-bg {
		fill: var(--zi-bub);
		stroke: var(--zi-ink);
		stroke-width: 0.9;
		stroke-linejoin: round;
	}
	.intro .zi-bub-t {
		font-size: 12px;
		font-weight: 700;
		fill: var(--zi-ink);
	}
	.zi-bub--echo .zi-bub-bg {
		fill-opacity: 0.6;
		stroke-dasharray: 2.5 2;
	}
	.intro .zi-bub--echo .zi-bub-t {
		font-weight: 600;
		font-style: italic;
		font-size: 11px;
		opacity: 0.75;
	}
	.zi-watch-bg {
		fill: var(--ig-surface);
		opacity: 0.85;
	}
	.zi-watch-face {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
	}
	.zi-watch-hand {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.1;
		stroke-linecap: round;
	}
	.intro .zi-watch-t {
		font-size: 11px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	/* hammer scene */
	.zi-day-top {
		stop-color: var(--zi-day-top);
	}
	.zi-day-low {
		stop-color: var(--zi-day-low);
	}
	.zi-field-far {
		stop-color: var(--zi-field-far);
	}
	.zi-field-near {
		stop-color: var(--zi-field-near);
	}
	.zi-cloud ellipse {
		fill: white;
		opacity: 0.85;
	}
	.zi-forest {
		fill: var(--zi-forest);
	}
	.zi-house {
		fill: hsl(35, 30%, 80%);
		stroke: var(--zi-ink);
		stroke-width: 0.4;
	}
	.zi-roof {
		fill: hsl(10, 45%, 45%);
	}
	.zi-dome {
		fill: hsl(45, 70%, 60%);
		stroke: var(--zi-ink);
		stroke-width: 0.4;
	}
	.zi-river {
		fill: hsl(200, 50%, 70%);
		opacity: 0.8;
	}
	.zi-fpost {
		fill: var(--zi-wood);
		stroke: var(--zi-ink);
		stroke-width: 0.5;
	}
	.zi-rail {
		fill: none;
		stroke: var(--zi-wood);
		stroke-width: 1.6;
	}
	.zi-dust {
		fill: hsl(35, 30%, 75%);
	}
	.zi-handle {
		fill: none;
		stroke: hsl(32, 45%, 52%);
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	.zi-hammerhead {
		fill: hsl(220, 8%, 30%);
		stroke: var(--zi-ink);
		stroke-width: 0.4;
	}
	.zi-path {
		fill: hsl(38, 35%, 64%);
		opacity: 0.85;
	}
	.zi-grass {
		fill: none;
		stroke: hsl(110, 40%, 26%);
		stroke-width: 0.9;
		stroke-linecap: round;
	}
	.zi-stem {
		fill: none;
		stroke: hsl(110, 45%, 30%);
		stroke-width: 0.8;
		stroke-linecap: round;
	}
	.zi-fl-a {
		fill: hsl(50, 90%, 62%);
	}
	.zi-fl-b {
		fill: white;
	}
	.zi-fl-c {
		fill: hsl(265, 60%, 70%);
	}
	.pkh-shirt.zi-work,
	.pkh-sleeve.zi-work {
		fill: hsl(205, 30%, 52%);
		stroke: hsl(205, 30%, 52%);
	}
	.pkh-shirt.zi-work {
		stroke: var(--hm-line);
	}
	.pkh-sleeve.zi-work {
		fill: none;
	}
</style>

<script>
	import { scene, loop } from '@components/intro/scene';
	import { figure, type FigurePose, type HandTarget } from '@components/people/body';
	import { reach, ease, easeSine } from '@components/people/motion';
	import { ROLL } from '@components/people/hand';
	import { SKELETON, type Pt } from '@components/people/core';

	const NS = 'http://www.w3.org/2000/svg';
	const C = 343; // м/с
	const fmt1 = (v: number) => v.toFixed(1).replace('.', ',');

	/** A speech bubble centered at (cx, cy) above its speaker or listener, the tail from its bottom edge to (tx, ty). */
	const bubble = (g: SVGGElement, cx: number, cy: number, tx: number, ty: number) => {
		const t = g.querySelector<SVGTextElement>('[data-bubtext]')!;
		const w = Math.max(30, t.getComputedTextLength() + 14);
		const h = 18;
		const x0 = cx - w / 2;
		const y0 = cy - h / 2;
		const y1 = y0 + h;
		const r = 8;
		const bx = Math.min(Math.max(tx, x0 + r + 1), x0 + w - r - 7);
		const d = `M${x0 + r} ${y0} H${x0 + w - r} Q${x0 + w} ${y0} ${x0 + w} ${y0 + r} V${y1 - r} Q${x0 + w} ${y1} ${x0 + w - r} ${y1} H${bx + 6} L${tx} ${ty} L${bx} ${y1} H${x0 + r} Q${x0} ${y1} ${x0} ${y1 - r} V${y0 + r} Q${x0} ${y0} ${x0 + r} ${y0} Z`;
		g.querySelector('[data-bubpath]')!.setAttribute('d', d);
		t.setAttribute('x', cx.toFixed(1));
		t.setAttribute('y', (cy + 4).toFixed(1));
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-zvintro]')) {
		const PIER = Number(root.dataset.pier);
		const FY = Number(root.dataset.fy);

		// ---------- Echo: 3,4 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="echo"]')!;
			const S = 0.6;
			const H = 165;
			const u = H * S;
			const sk = SKELETON.teen;
			const teen = figure(card.querySelector<SVGGElement>('[data-teen]')!, { s: S, H, age: 'teen', shirt: 'hm-blue', hair: 'short', name: 'teen on the pier' });
			const X = 118;
			const ANK = 7 * S; // trainers: the ankle above the deck
			const hip: Pt = { x: X, y: PIER - ANK - (sk.thigh + sk.shin) * u * 0.995 };
			const ankles: [Pt, Pt] = [
				{ x: X + 0.035 * u, y: PIER - ANK },
				{ x: X - 0.045 * u, y: PIER - ANK - 1 },
			];
			const LEAN = 0.05;
			// head center (as body.ts puts it): along the spine from the hip joint, a little forward
			const W = 0.15 * u * (sk.depth / 0.15);
			const hc = { x: hip.x + Math.sin(LEAN) * sk.headC * u + 0.1 * W * Math.cos(LEAN), y: hip.y - Math.cos(LEAN) * sk.headC * u + 0.1 * W * Math.sin(LEAN) };
			const r = sk.headR * u;
			const mouth = { x: hc.x + 0.95 * r, y: hc.y + 0.45 * r };
			const base = (hands: [HandTarget, HandTarget], head = 0): FigurePose => ({ hip, lean: LEAN, ankles, feet: [0, 0], hands, head, planted: [true, true] });
			// hands hanging relaxed (given by points: reach() blends points with points)
			const sh0 = teen.shoulders(hip, LEAN);
			// direction and roll given too, so that they blend smoothly into the cupped hands (no jump halfway)
			const hang = (s0: Pt, a: number, roll: number): HandTarget => {
				const l = (sk.upper + sk.fore + 0.4 * sk.hand) * u * 0.97;
				return { at: { x: s0.x + l * Math.sin(a), y: s0.y + l * Math.cos(a) }, pose: 'relaxed', dir: Math.PI / 2 - a, roll };
			};
			const rest = base([hang(sh0[0], 0.07, -1.1), hang(sh0[1], -0.05, 1.1)]);
			// the palms at the sides of the mouth, fingers forward and a little up: the near one shows its back, the far one its palm
			const cup = base([
				{ at: { x: mouth.x + 1.2, y: mouth.y + 0.6 }, pose: 'flat', dir: -0.35, roll: ROLL.backViewer, contact: 'near side of the mouth' },
				{ at: { x: mouth.x + 1.8, y: mouth.y - 0.4 }, pose: 'flat', dir: -0.35, roll: ROLL.palmViewer, contact: 'far side of the mouth' },
			]);
			// the hands travel on a curve in front of the chest (a straight line would take them through the body)
			const ctrl = (i: 0 | 1): Pt => ({ x: sh0[i].x + 0.24 * u, y: sh0[i].y + 0.17 * u });
			const bez = (a: Pt, c: Pt, b: Pt, e: number): Pt => ({ x: (1 - e) ** 2 * a.x + 2 * e * (1 - e) * c.x + e * e * b.x, y: (1 - e) ** 2 * a.y + 2 * e * (1 - e) * c.y + e * e * b.y });
			const lift = (k: number, down: boolean): FigurePose => {
				const p = down ? reach(cup, rest, k) : reach(rest, cup, k);
				const e = ease(k);
				const hands = p.hands.map((h, i) => {
					const a = (rest.hands[i] as HandTarget).at!;
					const b = (cup.hands[i] as HandTarget).at!;
					return { ...(h as HandTarget), at: down ? bez(b, ctrl(i as 0 | 1), a, e) : bez(a, ctrl(i as 0 | 1), b, e) };
				}) as [HandTarget, HandTarget];
				return { ...p, hands };
			};
			const shout = card.querySelector<SVGGElement>('[data-shout]')!;
			const echo = card.querySelector<SVGGElement>('[data-echo]')!;
			const watch = card.querySelector('[data-watch]')!;
			const hand = card.querySelector('[data-hand]')!;
			const ripples = card.querySelectorAll<SVGPathElement>('[data-ripples] path');
			const birdsG = card.querySelector('[data-birds]')!;
			const birds = [0, 1, 2].map(() => {
				const p = document.createElementNS(NS, 'path');
				birdsG.append(p);
				return p;
			});
			const T_SHOUT = 0.6;
			const T_ECHO = T_SHOUT + (2 * 170) / C; // 1,59 с
			const RUN = 3.4;
			let laid = false;
			scene(card, RUN, (q) => {
				const t = q * RUN;
				let p: FigurePose;
				if (t < 0.5) p = lift(t / 0.5, false);
				else if (t < 1.2) p = cup;
				else if (t < 1.75) p = lift((t - 1.2) / 0.55, true);
				else p = rest;
				// he lifts his head a little when the answer comes (0,4 s)
				p = { ...p, head: t < T_ECHO ? 0 : -0.12 * easeSine((t - T_ECHO) / 0.4) };
				teen.pose(p);
				if (!laid) {
					bubble(shout, mouth.x + 40, mouth.y - 24, mouth.x + 9, mouth.y - 4);
					bubble(echo, hc.x - 30, hc.y - 30, hc.x - 4, hc.y - 9);
					laid = true;
				}
				shout.setAttribute('opacity', t >= T_SHOUT && t < T_SHOUT + 0.6 ? '1' : '0');
				echo.setAttribute('opacity', t >= T_ECHO ? '1' : '0');
				const w = t < T_SHOUT ? 0 : Math.min(t, T_ECHO) - T_SHOUT;
				watch.textContent = `${fmt1(w)} с`;
				const a = (w / 1) * Math.PI * 2;
				hand.setAttribute('x2', (19 + 4 * Math.sin(a)).toFixed(2));
				hand.setAttribute('y2', (18 - 4 * Math.cos(a)).toFixed(2));
				ripples.forEach((rp, i) => rp.setAttribute('transform', `translate(${(3 * Math.sin(0.8 * t + i)).toFixed(2)} 0)`));
				birds.forEach((b, i) => {
					const bx = 250 + i * 18 + 6 * t;
					const by = 60 + i * 7 + 2 * Math.sin(t * 2 + i);
					const f = 2.2 * Math.sin(t * 6 + i * 2);
					b.setAttribute('d', `M${(bx - 4).toFixed(1)} ${(by - f).toFixed(1)} Q${(bx - 2).toFixed(1)} ${(by - 1).toFixed(1)} ${bx.toFixed(1)} ${by.toFixed(1)} Q${(bx + 2).toFixed(1)} ${(by - 1).toFixed(1)} ${(bx + 4).toFixed(1)} ${(by - f).toFixed(1)}`);
				});
			});
		}

		// ---------- Hammer: continuous, a blow every 2 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="hammer"]')!;
			// the far man
			const SM = 0.25;
			const HM = 178;
			const um = HM * SM;
			const skm = SKELETON.adult;
			const man = figure(card.querySelector<SVGGElement>('[data-man]')!, { s: SM, H: HM, clothes: 'home', shirt: 'zi-work', dir: -1, name: 'man with the sledgehammer' });
			const XM = 292;
			const ANKM = 7.5 * SM;
			const anklesM: [Pt, Pt] = [
				{ x: XM - 0.07 * um, y: FY - ANKM },
				{ x: XM + 0.08 * um, y: FY - ANKM - 0.6 },
			];
			const hipM = (bend: number): Pt => ({ x: XM, y: FY - ANKM - (skm.thigh + skm.shin) * um * bend });
			const RH = 11; // hands from the near shoulder
			const HANDLE = 90 * SM; // 22,5 px
			const A_IMP = -0.26; // rad above the forward horizontal at the impact
			const A_UP = 1.85; // raised over the head
			const L_IMP = 0.38;
			const L_UP = -0.08;
			const forward = (a: number): Pt => ({ x: -Math.cos(a), y: -Math.sin(a) }); // the man faces left
			const at = (a: number, lean: number, bend: number) => {
				const h = hipM(bend);
				const s = man.shoulders(h, lean)[0];
				const f = forward(a);
				return { h, s, f, grip: { x: s.x + RH * f.x, y: s.y + RH * f.y } };
			};
			// the post stands where the hammer head comes down
			const imp = at(A_IMP, L_IMP, 0.95);
			const headImp = { x: imp.grip.x + (HANDLE - 1.5) * imp.f.x, y: imp.grip.y + (HANDLE - 1.5) * imp.f.y };
			const post = card.querySelector('[data-newpost]')!;
			post.setAttribute('x', (headImp.x - 1.5).toFixed(1));
			post.setAttribute('y', (headImp.y + 1.6).toFixed(1));
			post.setAttribute('height', (FY - headImp.y - 1.6).toFixed(1));
			const handle = card.querySelector('[data-handle]')!;
			const headEl = card.querySelector('[data-head]')!;
			const dust = card.querySelector('[data-dust]')!;
			const puffs = [0, 1, 2, 3, 4].map((i) => {
				const c = document.createElementNS(NS, 'circle');
				c.setAttribute('class', 'zi-dust');
				dust.append(c);
				return { c, dx: (i - 2) * 1.6, up: 0.6 + (i % 2) * 0.5 };
			});
			/**
			 * The swing angle, lean and leg bend at time τ within a 2-s cycle (impact at τ = 1,05 s). After the impact the
			 * hammer rests on the post for 0,2 s, rises in 0,8 s (eased), is held up for 0,75 s and comes down in 0,25 s
			 * (speeding up): so 1,00 s after the impact, when the knock reaches the girl, it is high again.
			 */
			const swing = (tau: number) => {
				const u = (((tau - 1.05) % 2) + 2) % 2; // s since the last impact
				let k: number; // 0 at the impact, 1 raised
				if (u < 0.2) k = 0;
				else if (u < 1.0) k = easeSine((u - 0.2) / 0.8);
				else if (u < 1.75) k = 1;
				else k = 1 - ((u - 1.75) / 0.25) ** 2;
				return { a: A_IMP + (A_UP - A_IMP) * k, lean: L_IMP + (L_UP - L_IMP) * k, bend: 0.95 + 0.04 * k };
			};
			const posed = (tau: number) => {
				const w = swing(tau);
				const g = at(w.a, w.lean, w.bend);
				// the far hand at the end of the handle, the near hand 3 px up the handle
				const far = { x: g.grip.x - 1.5 * g.f.x, y: g.grip.y - 1.5 * g.f.y };
				const near = { x: g.grip.x + 1.5 * g.f.x, y: g.grip.y + 1.5 * g.f.y };
				const st = man.pose({
					hip: g.h,
					lean: w.lean,
					ankles: anklesM,
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: near, pose: 'grip', d: 3.5, contact: 'sledgehammer handle' },
						{ at: far, pose: 'grip', d: 3.5, contact: 'sledgehammer handle' },
					],
				});
				// the handle goes through both actual grips; its end is a little beyond the far hand
				const a = st.grips[1];
				const b = st.grips[0];
				const dx = b.x - a.x;
				const dy = b.y - a.y;
				const l = Math.hypot(dx, dy) || 1;
				const ux = dx / l;
				const uy = dy / l;
				const end = { x: a.x - 1.5 * ux, y: a.y - 1.5 * uy };
				const tip = { x: end.x + HANDLE * ux, y: end.y + HANDLE * uy };
				handle.setAttribute('d', `M${end.x.toFixed(2)} ${end.y.toFixed(2)} L${tip.x.toFixed(2)} ${tip.y.toFixed(2)}`);
				const ang = (Math.atan2(uy, ux) * 180) / Math.PI;
				headEl.setAttribute('x', (tip.x - 2.2).toFixed(2));
				headEl.setAttribute('y', (tip.y - 1.4).toFixed(2));
				headEl.setAttribute('transform', `rotate(${(ang + 90).toFixed(1)} ${tip.x.toFixed(2)} ${tip.y.toFixed(2)})`);
			};

			// the girl in front, shading her eyes with her near hand
			const SG = 0.7;
			const HG = 150;
			const ug = HG * SG;
			const skg = SKELETON.teen;
			const girl = figure(card.querySelector<SVGGElement>('[data-girl]')!, { s: SG, H: HG, age: 'teen', shirt: 'hm-red', hair: 'pony', shorts: true, name: 'girl watching' });
			const XG = 66;
			const GY = 234;
			const ANKG = 7 * SG;
			const hipG = { x: XG, y: GY - ANKG - (skg.thigh + skg.shin) * ug * 0.995 };
			const LEANG = 0.03;
			const WG = 0.15 * ug * (skg.depth / 0.15);
			const hcG = { x: hipG.x + Math.sin(LEANG) * skg.headC * ug + 0.1 * WG, y: hipG.y - Math.cos(LEANG) * skg.headC * ug };
			const rG = skg.headR * ug;
			const bunchAt = { x: hipG.x + 0.2 * ug, y: hipG.y - 0.07 * ug };
			girl.backLayer(0, card.querySelector('[data-bunch-back]'));
			const stG = girl.pose({
				hip: hipG,
				lean: LEANG,
				ankles: [
					{ x: XG + 0.04 * ug, y: GY - ANKG },
					{ x: XG - 0.05 * ug, y: GY - ANKG - 1.2 },
				],
				feet: [0, 0],
				planted: [true, true],
				head: -0.08,
				hands: [
					// a small bunch of meadow flowers in the near hand, the far hand hangs relaxed
					{ at: bunchAt, pose: 'grip', d: 1.6, dir: -0.25, contact: 'bunch of flowers' },
					{ arm: [Math.PI / 2 + 0.1, 0.25], pose: 'relaxed' },
				],
			});
			// the bunch: stems through the fist, flower heads above the thumb
			const bunch = card.querySelector<SVGGElement>('[data-bunch]')!;
			const gfr = stG.grips[0];
			bunch.setAttribute('transform', `translate(${gfr.x.toFixed(2)} ${gfr.y.toFixed(2)})`);
			const tuk = card.querySelector<SVGGElement>('[data-tuk]')!;
			const clouds = [...card.querySelectorAll<SVGGElement>('[data-clouds] g')];
			let laid = false;
			let t = 0;
			const draw = () => {
				const tau = t % 2;
				posed(tau);
				// the puff of dust: seen at once, 0,5 s
				const sinceImp = tau >= 1.05 ? tau - 1.05 : t >= 2 ? tau + 0.95 : -1;
				puffs.forEach((p) => {
					const on = sinceImp >= 0 && sinceImp < 0.5;
					const k = on ? sinceImp / 0.5 : 0;
					p.c.setAttribute('cx', (headImp.x + p.dx * (1 + 3 * k)).toFixed(2));
					p.c.setAttribute('cy', (FY - 0.5 - p.up * 4 * k).toFixed(2));
					p.c.setAttribute('r', on ? (0.8 + 1.8 * k).toFixed(2) : '0');
					p.c.setAttribute('opacity', on ? (0.9 * (1 - k)).toFixed(2) : '0');
				});
				// the knock reaches her 343/343 = 1,00 s after each impact
				const heard = t - 1.05 - 343 / C;
				const showTuk = heard >= 0 && heard % 2 < 0.6;
				if (!laid) {
					bubble(tuk, hcG.x + 34, hcG.y - 26, hcG.x + 0.9 * rG, hcG.y - 1.4 * rG);
					laid = true;
				}
				tuk.setAttribute('opacity', showTuk ? '1' : '0');
				clouds.forEach((c) => {
					const x = ((Number(c.dataset.x) + 3 * t + 40) % 440) - 40;
					c.setAttribute('transform', `translate(${x.toFixed(1)} ${c.dataset.y}) scale(${c.dataset.s})`);
				});
			};
			const wake = loop(card, (dt) => {
				t += dt;
				draw();
				return true;
			});
			card.querySelector('[data-again]')!.addEventListener('click', () => {
				t = 0;
				draw();
				wake();
			});
			draw();
		}
	}
</script>
