---
/**
 * Styles shared by the pictures and models of «Звук и его характеристики» (grade 9), scoped under `.zv` (every figure
 * of the chapter has it next to `g7`). Renders nothing. One color per role, as in «Волны. Длина волны»: the air
 * (its particles) neutral gray; the one marked particle red (--g7-red); the direction in which the sound runs gold
 * (arrow--gold); the direction in which the particles oscillate blue (arrow--blue), a double arrow; λ and periods
 * green (--g7-green). No forces are drawn in this chapter.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<style is:global>
	.zv {
		--zv-air: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-2));
		--zv-dense: color-mix(in oklab, var(--ig-vx) 22%, var(--sl-color-gray-5));
		--zv-trace: var(--g7-red);
	}
	.zv .zv-air {
		fill: var(--zv-air);
	}
	.zv .zv-red {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 0.9;
	}
	.zv .zv-band {
		fill: var(--zv-dense);
	}
	.zv .zv-metal {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
		stroke-linejoin: round;
	}
	.zv .zv-metal-dark {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
		stroke-linejoin: round;
	}
	.zv .zv-wood {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
		stroke-linejoin: round;
	}
	.zv .zv-wood-dark {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zv .zv-hole {
		fill: color-mix(in oklab, var(--sl-color-black) 70%, var(--g7-wood-dark));
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zv .zv-cone {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 55%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.zv .zv-surround {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.zv .zv-skin {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.zv .zv-skin-line {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.9;
		opacity: 0.6;
	}
	.zv .zv-canal {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zv .zv-drum {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.zv .g7__svg .zv-on-metal {
		fill: hsl(222, 35%, 14%);
		font-weight: 600;
	}
	.zv .zv-ink {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-ghost {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 2 2.5;
	}
	.zv .zv-axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.zv .zv-grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.7;
	}
	.zv .zv-trace {
		fill: none;
		stroke: var(--zv-trace);
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.zv .zv-trace--b {
		stroke: var(--g7-blue);
	}
	.zv .zv-lambda {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.5;
	}
	.zv .zv-lambda-guide {
		stroke: var(--g7-green);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		opacity: 0.8;
	}
	.zv .zv-faint {
		fill: var(--sl-color-gray-3);
	}
	.zv .zv-blur {
		fill: var(--g7-steel);
		opacity: 0.5;
	}
	.zv--narrow .g7__grid {
		max-width: 30rem;
		margin-inline: auto;
	}
	.zv .zv-screen {
		fill: color-mix(in oklab, var(--sl-color-black) 85%, var(--ig-vx));
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.zv .zv-screen-grid {
		stroke: color-mix(in oklab, var(--g7-green) 30%, transparent);
		stroke-width: 0.7;
	}
	.zv .zv-screen-trace {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 2;
		stroke-linejoin: round;
	}
</style>
