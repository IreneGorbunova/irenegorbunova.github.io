---
/**
 * «Отражение звука от стены» (picture next to the definition of an echo; a looping schematic top view, no numbers).
 * A clap at S, 80 px in front of a straight wall (hatched as on a school scheme). The front of the sound is a circle
 * around S growing at 40 px/s; where it has reached the wall it comes back as a circle of the same radius around the
 * image point S′ behind the wall (S′ is as far behind the wall as S is in front, drawn faint; S–S′ dashed). One
 * incident ray S → P and its reflected ray, with the normal at P (dashed) and the equal angles α = β. The reflected
 * front passes back over S when its radius is 160 px (4 с): «эхо вернулось». Loop: 5 с of growth, 1,2 с hold.
 */
import ZvStyles from './ZvStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const S = { x: 160, y: 132 };
const WX = 230; // the wall
const S2 = { x: 2 * WX - S.x, y: S.y };
const P = { x: WX, y: 62 };
// the reflected ray: from S′ through P, on beyond P
const ux = P.x - S2.x;
const uy = P.y - S2.y;
const R2 = { x: P.x + ux * 1.15, y: P.y + uy * 1.15 };
const hatch = Array.from({ length: 22 }, (_, i) => `M${WX + 6} ${12 + i * 10} l-6 6`).join(' ');
---

<ZvStyles />
<figure class="g7 g7--pic zv zv--narrow not-content" data-zv-echo data-sx={S.x} data-sy={S.y} data-s2x={S2.x}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 320 240" role="img" aria-label="Вид сверху: хлопок перед стеной. Круговой фронт звука доходит до стены и отражается; отражённый фронт как будто идёт из точки за стеной и возвращается к источнику. Угол падения равен углу отражения">
			<defs>
				<clipPath id={`zv-room-${uid}`}><rect x="0" y="0" width={WX} height="240"></rect></clipPath>
			</defs>
			<rect class="zv-behind" x={WX} y="0" width={320 - WX} height="240"></rect>
			<g clip-path={`url(#zv-room-${uid})`}>
				<circle class="zv-front" cx={S.x} cy={S.y} data-inc></circle>
				<circle class="zv-front zv-front--back" cx={S2.x} cy={S2.y} data-ref></circle>
			</g>
			<line class="zv-wall" x1={WX} y1="6" x2={WX} y2="234"></line>
			<path class="zv-hatch" d={hatch}></path>
			<!-- the rays and the normal -->
			<line class="zv-ray" x1={S.x} y1={S.y} x2={P.x} y2={P.y}></line>
			<line class="zv-ray" x1={P.x} y1={P.y} x2={R2.x.toFixed(1)} y2={R2.y.toFixed(1)}></line>
			<path class="zv-ray-head" d={`M${S.x + (P.x - S.x) * 0.55} ${S.y + (P.y - S.y) * 0.55} l-7 1 l4 5 Z`} data-h1></path>
			<line class="zv-dash" x1={P.x} y1={P.y} x2={S2.x} y2={S2.y}></line>
			<line class="zv-dash" x1={S.x} y1={S.y} x2={S2.x} y2={S2.y}></line>
			<line class="zv-normal" x1={P.x - 60} y1={P.y} x2={P.x} y2={P.y}></line>
			<path class="zv-angle" d={`M${P.x - 26} ${P.y} A26 26 0 0 0 ${(P.x + (26 * (S.x - P.x)) / Math.hypot(S.x - P.x, S.y - P.y)).toFixed(1)} ${(P.y + (26 * (S.y - P.y)) / Math.hypot(S.x - P.x, S.y - P.y)).toFixed(1)}`}></path>
			<path class="zv-angle" d={`M${P.x - 22} ${P.y} A22 22 0 0 1 ${(P.x + (22 * (R2.x - P.x)) / Math.hypot(R2.x - P.x, R2.y - P.y)).toFixed(1)} ${(P.y + (22 * (R2.y - P.y)) / Math.hypot(R2.x - P.x, R2.y - P.y)).toFixed(1)}`}></path>
			<text class="t-i zv-ang-t" x={P.x - 34} y={P.y + 18}>α</text>
			<text class="t-i zv-ang-t" x={P.x - 32} y={P.y - 8}>β</text>
			<!-- the source and its image -->
			<circle class="zv-src" cx={S.x} cy={S.y} r="5"></circle>
			<text class="t-strong" x={S.x - 8} y={S.y + 18} text-anchor="end">S</text>
			<text class="t-small" x={S.x - 8} y={S.y - 9} text-anchor="end">хлопок</text>
			<circle class="zv-src zv-src--img" cx={S2.x} cy={S2.y} r="5"></circle>
			<text class="t-strong zv-faint" x={S2.x + 8} y={S2.y + 18}>S′</text>
			<text class="t-small" x={WX + 10} y="232">стена</text>
			<g data-back opacity="0">
				<rect class="zv-tag-bg" x={S.x - 92} y={S.y + 26} width="96" height="20" rx="10"></rect>
				<text class="t-small t-gold" x={S.x - 44} y={S.y + 40} text-anchor="middle">эхо вернулось</text>
			</g>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Вид сверху. Фронт звука от хлопка доходит до стены и отражается: отражённый звук идёт так, будто его источник —
		точка <i>S′</i> за стеной. Угол отражения <i>β</i> равен углу падения <i>α</i>.
	</figcaption>
</figure>

<style is:global>
	.zv .zv-behind {
		fill: color-mix(in oklab, var(--g7-wood) 22%, transparent);
	}
	.zv .zv-wall {
		stroke: var(--g7-ink);
		stroke-width: 2.4;
	}
	.zv .zv-hatch {
		stroke: var(--g7-ink);
		stroke-width: 1;
		fill: none;
	}
	.zv .zv-front {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
	}
	.zv .zv-front--back {
		stroke-dasharray: 6 3;
	}
	.zv .zv-ray {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.zv .zv-ray-head {
		fill: var(--sl-color-gray-2);
	}
	.zv .zv-dash {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.zv .zv-normal {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 5 3;
	}
	.zv .zv-angle {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.3;
	}
	.zv .g7__svg .zv-ang-t {
		fill: var(--g7-green);
		font-size: 15px;
	}
	.zv .zv-src {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-src--img {
		opacity: 0.4;
		stroke-dasharray: 2 2;
	}
	.zv .zv-tag-bg {
		fill: var(--ig-surface);
		stroke: var(--g7-gold);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from './zv';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-zv-echo]')) {
		const SX = Number(fig.dataset.sx);
		const S2X = Number(fig.dataset.s2x);
		const D = (S2X - SX) / 2; // S to the wall
		const V = 40; // px/s
		const RUN = 5;
		const HOLD = 1.2;
		const inc = fig.querySelector('[data-inc]')!;
		const ref = fig.querySelector('[data-ref]')!;
		const back = fig.querySelector('[data-back]')!;
		let t = 0;
		const draw = () => {
			const r = V * Math.min(t, RUN);
			const fade = (x: number) => Math.max(0.15, 1 - x / 260).toFixed(2);
			inc.setAttribute('r', r.toFixed(2));
			inc.setAttribute('opacity', fade(r));
			ref.setAttribute('r', r.toFixed(2));
			ref.setAttribute('opacity', r > D ? fade(r) : '0');
			back.setAttribute('opacity', r >= 2 * D ? '1' : '0');
		};
		loop(fig, (dt) => {
			t = (t + dt) % (RUN + HOLD);
			draw();
			return true;
		});
		draw();
	}
</script>
