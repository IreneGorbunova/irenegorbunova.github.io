---
/**
 * «Где это встречается» (four small panels with gentle loops and a short label under each; no people).
 * УЗИ: an ultrasound probe on a belly sends short arcs into the body; on the monitor a fan-shaped picture is drawn by a
 *   sweeping line (one sweep in 2 с; slowed: a real scanner makes some 30 pictures a second).
 * Парктроник: a car backs toward a wall at 0,4 м/с (60 px per м, the car drawn at 0,6 of that scale; real time) from 1,3 м to 0,3 м; sensors in the rear
 *   bumper send arcs; the beeps of the indicator (a blinking dot) come more often as the gap shrinks (the interval
 *   0,5 с · gap/1 м, at least 0,1 с).
 * Звукопоглощающие панели: arcs reach a studio wall covered with foam wedges and die out in it (no reflected arc).
 * Стетоскоп: the chest piece on a chest; with each heartbeat (72 per minute) a pulse runs along the tube to the ear
 *   tips.
 */
import ZvStyles from './ZvStyles.astro';
const foam = Array.from({ length: 9 }, (_, i) => `M140 ${12 + i * 12} L124 ${18 + i * 12} L140 ${24 + i * 12}`).join(' ');
---

<ZvStyles />
<figure class="g7 g7--pic zv not-content" data-zv-uses>
	<div class="zv-uses">
		<div>
			<svg class="g7__svg" viewBox="0 0 170 130" role="img" aria-label="УЗИ: датчик на животе посылает ультразвук внутрь, на экране появляется веерное изображение">
				<rect class="zv-monitor" x="92" y="10" width="72" height="56" rx="4"></rect>
				<path class="zv-fan" d="M128 16 L104 60 Q128 66 152 60 Z"></path>
				<path class="zv-fan-img" d="M120 40 q8 -6 16 0 q-8 8 -16 0 Z M112 52 q16 4 32 0"></path>
				<line class="zv-sweep" x1="128" y1="16" data-sweep></line>
				<rect class="zv-metal-dark" x="124" y="66" width="8" height="14"></rect>
				<path class="zv-skinfill" d="M0 130 V96 Q60 66 120 96 V130 Z"></path>
				<path class="zv-cable" d="M58 70 Q80 50 96 62"></path>
				<rect class="zv-probe" x="50" y="64" width="16" height="16" rx="4" transform="rotate(-8 58 72)"></rect>
				<g data-us></g>
			</svg>
			<p class="zv-uses__t">УЗИ</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 170 130" role="img" aria-label="Парктроник: машина задним ходом подъезжает к стене, датчики в бампере посылают ультразвук, сигналы звучат всё чаще">
				<rect class="zv-wallblk" x="8" y="20" width="14" height="90"></rect>
				<line class="zv-axis" x1="0" y1="110" x2="170" y2="110"></line>
				<g data-pt></g>
				<g data-car>
					<path class="zv-car" d="M0 -8 L4 -20 L20 -22 L34 -34 L76 -34 L94 -20 L112 -18 L114 -8 Z"></path>
					<path class="zv-window" d="M38 -31 L72 -31 L86 -21 L28 -21 Z"></path>
					<circle class="zv-wheel" cx="22" cy="-6" r="8"></circle>
					<circle class="zv-wheel" cx="92" cy="-6" r="8"></circle>
					<rect class="zv-sensor" x="-1" y="-15" width="3" height="3"></rect>
				</g>
				<circle class="zv-beep" cx="150" cy="24" r="6" data-beep></circle>
				<text class="t-small zv-faint" x="150" y="44" text-anchor="middle" font-size="9.5">сигнал</text>
			</svg>
			<p class="zv-uses__t">Парктроник</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 170 130" role="img" aria-label="Звукопоглощающие панели: звук входит в поролоновые клинья на стене студии и затухает, почти не отражаясь">
				<rect class="zv-wallblk" x="140" y="6" width="24" height="118"></rect>
				<path class="zv-foam" d={`M140 6 ${foam.replace(/M140 \d+ /g, 'L140 ')} L140 124 Z`}></path>
				<path class="zv-foam-line" d={foam}></path>
				<circle class="zv-src" cx="30" cy="66" r="5"></circle>
				<g data-ab></g>
			</svg>
			<p class="zv-uses__t">Звукопоглощающие панели</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 170 130" role="img" aria-label="Стетоскоп: удары сердца по трубке доходят до ушей врача">
				<path class="zv-skinfill" d="M0 130 V70 Q30 52 70 60 Q90 64 96 130 Z"></path>
				<path class="zv-heart" d="M44 100 c-6 -6 -12 -2 -10 4 c2 5 10 9 10 9 c0 0 8 -4 10 -9 c2 -6 -4 -10 -10 -4 Z" data-heart></path>
				<path class="zv-tube" d="M112 30 C126 26 136 22 142 12"></path>
				<path class="zv-tube" d="M60 70 C70 40 100 44 112 30 C120 20 120 12 128 10" data-tube></path>
				<circle class="zv-chest" cx="58" cy="72" r="8"></circle>
				<circle class="zv-metal-dark" cx="128" cy="10" r="3"></circle>
				<circle class="zv-metal-dark" cx="142" cy="12" r="3"></circle>
				<circle class="zv-pulse-dot" r="3" data-sd></circle>
			</svg>
			<p class="zv-uses__t">Стетоскоп</p>
		</div>
	</div>
</figure>

<style is:global>
	.zv .zv-uses {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.zv .zv-uses__t {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.zv .zv-monitor {
		fill: hsl(220, 20%, 14%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-fan {
		fill: hsl(220, 10%, 26%);
	}
	.zv .zv-fan-img {
		fill: none;
		stroke: hsl(0, 0%, 75%);
		stroke-width: 1.2;
	}
	.zv .zv-sweep {
		stroke: hsl(0, 0%, 92%);
		stroke-width: 1;
		opacity: 0.8;
	}
	.zv .zv-skinfill {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-probe {
		fill: hsl(210, 15%, 85%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-wallblk {
		fill: color-mix(in oklab, var(--g7-wood) 40%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zv .zv-car {
		fill: hsl(205, 60%, 50%);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.zv .zv-window {
		fill: hsl(200, 40%, 85%);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.zv .zv-wheel {
		fill: hsl(220, 10%, 20%);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.zv .zv-sensor {
		fill: var(--g7-gold);
	}
	.zv .zv-beep {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zv .zv-beep.is-on {
		fill: var(--g7-red);
	}
	.zv .zv-foam {
		fill: hsl(215, 18%, 50%);
	}
	.zv .zv-foam-line {
		fill: none;
		stroke: hsl(220, 12%, 18%);
		stroke-width: 0.8;
	}
	.zv .zv-heart {
		fill: var(--g7-red);
		opacity: 0.8;
	}
	.zv .zv-tube {
		fill: none;
		stroke: hsl(220, 10%, 25%);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.zv .zv-chest {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-pulse-dot {
		fill: var(--g7-gold);
	}
</style>

<script>
	import { el, loop } from './zv';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-zv-uses]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const sweep = q('[data-sweep]');
		const us = q('[data-us]');
		const usArcs = [0, 1, 2].map(() => {
			const e = el('path', { class: 'zv-arc' });
			us.append(e);
			return e;
		});
		const car = q('[data-car]');
		const pt = q('[data-pt]');
		const ptArcs = [0, 1, 2].map(() => {
			const e = el('path', { class: 'zv-arc' });
			pt.append(e);
			return e;
		});
		const beep = q('[data-beep]');
		const ab = q('[data-ab]');
		const abArcs = [0, 1, 2, 3].map(() => {
			const e = el('path', { class: 'zv-arc' });
			ab.append(e);
			return e;
		});
		const tube = q<SVGPathElement>('[data-tube]');
		const tubeLen = tube.getTotalLength();
		const sd = q('[data-sd]');
		const heart = q('[data-heart]');
		const arcD = (cx: number, cy: number, r: number, dir: number, cone: number) =>
			`M${(cx + r * Math.cos(dir - cone)).toFixed(1)} ${(cy + r * Math.sin(dir - cone)).toFixed(1)} A${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(cx + r * Math.cos(dir + cone)).toFixed(1)} ${(cy + r * Math.sin(dir + cone)).toFixed(1)}`;
		let t = 0;
		let lastBeep = 0;
		const PARK = (1.3 - 0.3) / 0.4; // s of backing
		const frame = (dt: number) => {
			t += dt;
			// УЗИ
			const a = Math.PI / 2 + (((t % 2) / 2) * 2 - 1) * 0.48; // the scan line sweeps the fan once in 2 s
			sweep.setAttribute('x2', (128 + 46 * Math.cos(a)).toFixed(1));
			sweep.setAttribute('y2', (16 + 46 * Math.sin(a)).toFixed(1));
			usArcs.forEach((e, i) => {
				const k = ((t * 0.8 + i / 3) % 1);
				e.setAttribute('d', arcD(56, 80, 4 + 40 * k, Math.PI / 2 + 0.1, 0.45));
				e.setAttribute('opacity', (0.9 * (1 - k)).toFixed(2));
			});
			// Парктроник: 1,3 м → 0,3 м at 0,4 м/с, then a pause of 1,5 s
			const tp = t % (PARK + 1.5);
			const gap = 1.3 - 0.4 * Math.min(tp, PARK);
			const cx = 22 + gap * 60;
			car.setAttribute('transform', `translate(${cx.toFixed(1)} 110) scale(0.6)`);
			ptArcs.forEach((e, i) => {
				const k = ((t * 1.2 + i / 3) % 1);
				const r = 4 + (gap * 60 - 2) * k;
				e.setAttribute('d', arcD(cx, 102, r, Math.PI, 0.5));
				e.setAttribute('opacity', (0.9 * (1 - k)).toFixed(2));
			});
			const interval = Math.max(0.1, 0.5 * gap);
			if (t - lastBeep >= interval) lastBeep = t;
			beep.classList.toggle('is-on', t - lastBeep < Math.min(0.06, interval / 2));
			// panels: arcs run to the foam and die out in it
			abArcs.forEach((e, i) => {
				const k = ((t * 0.5 + i / 4) % 1);
				const r = 6 + 120 * k;
				const into = Math.max(0, 30 + r - 124);
				e.setAttribute('d', arcD(30, 66, r, 0, 0.55));
				e.setAttribute('opacity', (into > 0 ? Math.max(0, 0.9 - into / 12) : 0.9).toFixed(2));
			});
			// stethoscope: 72 beats per minute
			const ph = (t * 1.2) % 1;
			heart.setAttribute('transform', `translate(44 104) scale(${(1 + 0.12 * Math.exp(-ph * 10)).toFixed(3)}) translate(-44 -104)`);
			const p = tube.getPointAtLength(Math.min(1, ph / 0.6) * tubeLen);
			sd.setAttribute('cx', p.x.toFixed(1));
			sd.setAttribute('cy', p.y.toFixed(1));
			sd.setAttribute('opacity', ph < 0.6 ? '1' : '0');
			return true;
		};
		loop(fig, frame);
		frame(0);
	}
</script>
