---
/**
 * «Звонок под колоколом» (model, before the statement that sound does not travel in a vacuum). A glass bell jar on
 * the plate of a vacuum pump; inside, an electric bell stands on a foam pad (so that it does not pass its shaking to
 * the plate) and is wired through the plate to a battery and a switch. Its hammer strikes the cup 10 times a second
 * (real bells 10–20 strikes per second; drawn as a quick flicker between «touching» and «drawn back»).
 * Controls: «Включить звонок» (on/off), «Откачивать воздух» (pump on/off), «Впустить воздух».
 * Pressure under the jar: pumping lowers it exponentially, p ← p·e^(−Δt/τ) with τ = 15 с / ln 101 = 3,25 с, so
 * 101 кПа → 1 кПа in 15 с and → 0,1 кПа in 22,5 с (a real pump slows down at the end; the floor here is 0,01 кПа);
 * letting the air in brings it back to 101 кПа with τ = 0,4 с (about 2 с).
 * «Громкость снаружи» (relative units, 0–100): a simple model in which the loudness outside is proportional to the
 * pressure inside, 100·p/101 кПа (100 at 101 кПа, 10 at 10 кПа, 1 at 1 кПа). This proportional law is a
 * simplification: what really matters is how well the thinning air passes the vibrations of the bell to the glass.
 * Inside the jar 60 air dots at 101 кПа, their number ∝ p (none below 1 кПа: one dot stands for about 1,7 кПа); they
 * jitter. Outside, gold arcs (the fronts of the sound) leave the jar 4 times a second while the bell rings; their
 * opacity follows the loudness; none at p < 1 кПа (loudness under 1). The page is silent: the sound is only shown.
 */
import ZvStyles from './ZvStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
---

<ZvStyles />
<figure class="g7 zv not-content" data-zv-jar>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Электрический звонок под стеклянным колоколом на тарелке насоса. Насос откачивает воздух, давление под колоколом падает, и звук снаружи становится всё тише, хотя молоточек продолжает бить по чашке">
			<defs>
				<clipPath id={`zv-jar-${uid}`}><path d="M96 214 V112 Q96 58 160 58 Q224 58 224 112 V214 Z"></path></clipPath>
			</defs>
			<g data-arcs></g>
			<!-- the plate and the jar -->
			<rect class="zv-metal-dark" x="70" y="214" width="180" height="9" rx="2"></rect>
			<rect class="zv-metal" x="150" y="223" width="20" height="14"></rect>
			<path class="zv-glass-fill" d="M96 214 V112 Q96 58 160 58 Q224 58 224 112 V214 Z"></path>
			<g clip-path={`url(#zv-jar-${uid})`}><g data-dots></g></g>
			<!-- the bell on its foam pad -->
			<rect class="zv-foam" x="128" y="198" width="64" height="16" rx="3"></rect>
			<rect class="zv-wood" x="134" y="190" width="52" height="8" rx="1.5"></rect>
			<rect class="zv-metal-dark" x="157" y="160" width="4" height="30"></rect>
			<path class="zv-gong" d="M136 160 Q136 134 159 134 Q182 134 182 160 Z"></path>
			<path class="zv-gong-hi" d="M142 154 Q143 141 155 139"></path>
			<rect class="zv-coil" x="168" y="176" width="14" height="13" rx="2"></rect>
			<g data-hammer>
				<line class="zv-arm" x1="186" y1="186" x2="186" y2="152"></line>
				<circle class="zv-knob" cx="186" cy="150" r="3.6"></circle>
			</g>
			<path class="zv-wire" d="M140 214 V230 Q140 238 128 238 H46 M178 214 V232 Q178 242 166 242 H40"></path>
			<path class="zv-glass" d="M96 214 V112 Q96 58 160 58 Q224 58 224 112 V214"></path>
			<path class="zv-glass-hi" d="M106 200 V114 Q106 74 140 66"></path>
			<rect class="zv-metal" x="152" y="48" width="16" height="10" rx="3"></rect>
			<!-- battery and switch -->
			<rect class="zv-battery" x="12" y="226" width="26" height="18" rx="2"></rect>
			<text class="t-small" x="25" y="221" text-anchor="middle">+  −</text>
			<!-- the hose, the gauge and the pump -->
			<path class="zv-hose" d="M170 232 H262 Q272 232 272 222 V200"></path>
			<rect class="zv-pump" x="258" y="150" width="92" height="52" rx="6"></rect>
			<circle class="zv-fan" cx="284" cy="176" r="15"></circle>
			<g data-fan><path class="zv-blade" d="M284 176 L284 163 Q290 166 284 176 Z M284 176 L297 176 Q294 182 284 176 Z M284 176 L284 189 Q278 186 284 176 Z M284 176 L271 176 Q274 170 284 176 Z"></path></g>
			<text class="t-small zv-on-metal" x="322" y="170" text-anchor="middle">насос</text>
			<circle class="zv-led" cx="322" cy="186" r="3.5" data-led></circle>
			<!-- the pressure gauge on the hose -->
			<circle class="zv-dial" cx="300" cy="96" r="30"></circle>
			<path class="zv-dial-scale" d="M279 117 A30 30 0 1 1 321 117"></path>
			<line class="zv-needle" x1="300" y1="96" data-needle></line>
			<circle class="zv-knob" cx="300" cy="96" r="2.4"></circle>
			<text class="t-small" x="300" y="120" text-anchor="middle">кПа</text>
			<text class="t-small zv-faint" x="276" y="128" text-anchor="middle">0</text>
			<text class="t-small zv-faint" x="326" y="128" text-anchor="middle">101</text>
			<line class="zv-hose-thin" x1="300" y1="126" x2="300" y2="150"></line>
			<text class="t-small zv-faint" x="160" y="16" text-anchor="middle" data-quiet></text>
		</svg>
		<div class="g7__side">
			<ul class="g7__read">
				<li class="is-key"><span>давление под колоколом</span> <b data-p>101 кПа</b></li>
				<li><span>громкость снаружи</span> <span class="zv-nowrap"><b data-loud>0</b> <span class="zv-meter"><span data-meter></span></span></span></li>
			</ul>
			<div class="zv-btns">
				<button type="button" class="g7__btn g7__btn--go" data-bell>Включить звонок</button>
				<button type="button" class="g7__btn" data-pump>Откачивать воздух</button>
				<button type="button" class="g7__btn" data-vent>Впустить воздух</button>
			</div>
			<p class="g7__note">Громкость — в условных единицах: 100 при обычном давлении.</p>
		</div>
	</div>
</figure>

<style is:global>
	.zv .zv-glass-fill {
		fill: color-mix(in oklab, var(--ig-vx) 7%, transparent);
	}
	.zv .zv-glass {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-2));
		stroke-width: 2;
	}
	.zv .zv-glass-hi {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0.35;
	}
	.zv .zv-foam {
		fill: hsl(48, 70%, 72%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zv .zv-gong {
		fill: hsl(42, 70%, 55%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-gong-hi {
		fill: none;
		stroke: white;
		stroke-width: 1.4;
		opacity: 0.5;
		stroke-linecap: round;
	}
	.zv .zv-coil {
		fill: hsl(15, 55%, 45%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zv .zv-arm {
		stroke: var(--g7-steel-dark);
		stroke-width: 2;
	}
	.zv .zv-knob {
		fill: var(--g7-ink);
	}
	.zv .zv-wire {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.2;
	}
	.zv .zv-battery {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zv .zv-hose {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.zv .zv-hose-thin {
		stroke: var(--sl-color-gray-4);
		stroke-width: 3;
	}
	.zv .zv-pump {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-fan {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zv .zv-blade {
		fill: var(--sl-color-gray-3);
	}
	.zv .zv-led {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.zv .zv-led.is-on {
		fill: var(--g7-green);
	}
	.zv .zv-dial {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.zv .zv-dial-scale {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-dasharray: 1 5.3;
	}
	.zv .zv-needle {
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.zv .zv-arc {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.zv .zv-btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.zv .zv-nowrap,
	[data-zv-jar] .g7__read li > span:first-child {
		white-space: nowrap;
	}
	.zv .zv-meter {
		display: inline-block;
		vertical-align: middle;
		width: 4rem;
		height: 0.6rem;
		margin-left: 0.4rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		overflow: hidden;
	}
	.zv .zv-meter span {
		display: block;
		height: 100%;
		width: 0;
		background: var(--g7-gold);
	}
</style>

<script>
	import { el, loop, fmt, rnd } from './zv';

	const P0 = 101; // кПа
	const TAU_PUMP = 15 / Math.log(101); // 3,25 s
	const TAU_VENT = 0.4;
	const N_DOTS = 60;
	/** The pressure the Russian way: 101 кПа, 5,3 кПа, 0,45 кПа. */
	const fmtP = (p: number) => (p >= 9.95 ? fmt(p, 0) : p >= 0.995 ? fmt(p, 1) : fmt(Math.max(p, 0.01), 2));

	for (const fig of document.querySelectorAll<HTMLElement>('[data-zv-jar]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const dotsG = q('[data-dots]');
		const dots = Array.from({ length: N_DOTS }, (_, i) => {
			// rest places inside the jar, above and around the bell
			let x = 0;
			let y = 0;
			for (let k = 0; k < 20; k++) {
				x = 104 + rnd(i, 1 + k) * 112;
				y = 66 + rnd(i, 30 + k) * 140;
				const inBell = x > 128 && x < 192 && y > 130;
				const inDome = (x - 160) ** 2 / 64 ** 2 + (y - 112) ** 2 / 54 ** 2 > 1 && y < 112;
				if (!inBell && !inDome) break;
			}
			const c = el('circle', { class: 'zv-air', r: 1.7, cx: x, cy: y });
			dotsG.append(c);
			return { c, x, y, ph: rnd(i, 99) * 6.28 };
		});
		const arcsG = q('[data-arcs]');
		const arcs: { born: number; e: SVGPathElement }[] = [];
		const hammer = q('[data-hammer]');
		const fan = q('[data-fan]');
		const led = q('[data-led]');
		const needle = q('[data-needle]');
		const outP = q('[data-p]');
		const outL = q('[data-loud]');
		const meter = q<HTMLElement>('[data-meter]');
		const quiet = q('[data-quiet]');
		const bBell = q<HTMLButtonElement>('[data-bell]');
		const bPump = q<HTMLButtonElement>('[data-pump]');
		const bVent = q<HTMLButtonElement>('[data-vent]');

		let p = P0;
		let bell = false;
		let pump = false;
		let vent = false;
		let t = 0;
		let lastArc = -1;
		const loud = () => (bell ? (100 * p) / P0 : 0);

		const draw = () => {
			// the hammer: 10 strikes per second, touching the cup for the first half of each 0,1 s
			const touch = bell && Math.floor(t * 20) % 2 === 0;
			hammer.setAttribute('transform', touch ? 'rotate(-9 186 186)' : 'rotate(4 186 186)');
			// air dots: their number ∝ p
			const n = Math.round((N_DOTS * p) / P0);
			dots.forEach((d, i) => {
				d.c.style.display = i < n ? '' : 'none';
				d.c.setAttribute('cx', (d.x + 1.6 * Math.sin(7 * t + d.ph)).toFixed(1));
				d.c.setAttribute('cy', (d.y + 1.6 * Math.cos(5.3 * t + 2 * d.ph)).toFixed(1));
			});
			// the gauge: 0…101 кПа over 270°
			const a = ((135 + (270 * p) / P0) * Math.PI) / 180;
			needle.setAttribute('x2', (300 + 24 * Math.cos(a)).toFixed(2));
			needle.setAttribute('y2', (96 + 24 * Math.sin(a)).toFixed(2));
			fan.setAttribute('transform', `rotate(${pump ? ((t * 720) % 360).toFixed(1) : 0} 284 176)`);
			led.classList.toggle('is-on', pump);
			const L = loud();
			outP.textContent = `${fmtP(p)} кПа`;
			outL.textContent = bell ? (L >= 9.95 ? fmt(L, 0) : fmt(L, 1)) : '0';
			meter.style.width = `${Math.min(100, L)}%`;
			quiet.textContent = bell && L < 1 ? 'молоточек бьёт, а снаружи тихо' : '';
			// sound fronts: born 4 times a second at the glass, they grow and fade
			if (bell && L >= 1 && t - lastArc >= 0.25) {
				const e = el('path', { class: 'zv-arc' });
				arcsG.append(e);
				arcs.push({ born: t, e });
				lastArc = t;
			}
			for (let i = arcs.length - 1; i >= 0; i--) {
				const k = (t - arcs[i].born) / 1.6;
				if (k > 1 || k < 0) {
					arcs[i].e.remove();
					arcs.splice(i, 1);
					continue;
				}
				const r = 74 + 70 * k;
				arcs[i].e.setAttribute('d', `M${(160 - r * 0.97).toFixed(1)} ${(130 - r * 0.24).toFixed(1)} A${r} ${r} 0 0 1 ${(160 + r * 0.97).toFixed(1)} ${(130 - r * 0.24).toFixed(1)}`);
				arcs[i].e.setAttribute('opacity', ((1 - k) * Math.min(1, L / 100) ** 0.5 * 0.9).toFixed(3));
			}
		};
		const wake = loop(fig, (dt) => {
			t += dt;
			if (pump) p = Math.max(0.01, p * Math.exp(-dt / TAU_PUMP));
			if (vent) {
				p = P0 - (P0 - p) * Math.exp(-dt / TAU_VENT);
				if (P0 - p < 0.05) {
					p = P0;
					vent = false;
				}
			}
			draw();
			return bell || pump || vent || arcs.length > 0;
		});
		const sync = () => {
			bBell.textContent = bell ? 'Выключить звонок' : 'Включить звонок';
			bBell.setAttribute('aria-pressed', String(bell));
			bPump.textContent = pump ? 'Остановить насос' : 'Откачивать воздух';
			bPump.setAttribute('aria-pressed', String(pump));
			draw();
			wake();
		};
		bBell.addEventListener('click', () => {
			bell = !bell;
			sync();
		});
		bPump.addEventListener('click', () => {
			pump = !pump;
			if (pump) vent = false;
			sync();
		});
		bVent.addEventListener('click', () => {
			pump = false;
			vent = true;
			sync();
		});
		draw();
	}
</script>
