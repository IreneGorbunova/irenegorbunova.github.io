---
/**
 * «Звук в воздухе, воде и стали» (picture next to the statement about the speed of sound; a looping animation,
 * slowed 5 times: the caption says so). Three lanes, each 1 000 м long (0,28 px per м): «воздух, 20 °C» (343 м/с),
 * «вода» (1 480 м/с) and «сталь» (5 000 м/с, a rail). At t = 0 one hammer blow at the left end of all three (one flash).
 * A short gold pulse (a compression) runs along each lane at its speed; when it reaches the right end, the arrival time
 * appears there: 1000/5000 = 0,20 с, 1000/1480 = 0,68 с, 1000/343 = 2,92 с. A clock shows the real time
 * «t = … с» (the animation runs 5 times slower); the final picture holds 2 с, then everything starts again.
 */
import ZvStyles from './ZvStyles.astro';
const X0 = 34;
const K = 0.28; // px per м
const lanes = [
	{ key: 'air', name: 'воздух, 20 °C', v: 343, y: 52 },
	{ key: 'water', name: 'вода', v: 1480, y: 110 },
	{ key: 'steel', name: 'сталь', v: 5000, y: 168 },
];
---

<ZvStyles />
<figure class="g7 g7--pic zv not-content" data-zv-speed>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 214" role="img" aria-label="Три дорожки длиной 1000 метров: воздух, вода и сталь. Удар по их началу одновременный. Звук проходит сталь за 0,2 секунды, воду за 0,68 секунды, а воздух — почти за 3 секунды">
			<text class="t-strong" x="356" y="16" text-anchor="end" data-clock>t = 0,00 с</text>
			{
				lanes.map((l) => (
					<g data-lane={l.key} data-v={l.v} data-y={l.y}>
						<text class="t-small" x={X0} y={l.y - 14}>
							{l.name} — {l.v.toLocaleString('ru-RU')} м/с
						</text>
						{l.key === 'air' && <rect class="zv-lane-air" x={X0} y={l.y - 6} width={1000 * K} height="12" rx="2" />}
						{l.key === 'water' && <rect class="zv-lane-water" x={X0} y={l.y - 6} width={1000 * K} height="12" rx="2" />}
						{l.key === 'steel' && (
							<g>
								<rect class="zv-metal" x={X0} y={l.y - 5} width={1000 * K} height="4"></rect>
								<rect class="zv-metal" x={X0} y={l.y - 1} width={1000 * K} height="3"></rect>
								<rect class="zv-metal-dark" x={X0} y={l.y + 2} width={1000 * K} height="4"></rect>
							</g>
						)}
						<rect class="zv-pulse" y={l.y - 7} width="6" height="14" rx="2" data-pulse></rect>
						<path class="zv-flash" d={`M${X0 - 4} ${l.y} l-5 -6 l2 5 l-8 -1 l7 3 l-6 5 l8 -3 Z`} data-flash></path>
						<text class="t-num zv-arrive" x={X0 + 1000 * K + 4} y={l.y + 4} data-arrive>
							{(1000 / l.v).toFixed(2).replace('.', ',')} с
						</text>
					</g>
				))
			}
			<g class="zv-ruler">
				<line class="zv-axis" x1={X0} y1="196" x2={X0 + 1000 * K} y2="196"></line>
				{[0, 250, 500, 750, 1000].map((m) => (
					<g>
						<line class="zv-axis" x1={X0 + m * K} y1="192" x2={X0 + m * K} y2="200"></line>
						<text class="t-small zv-faint" x={X0 + m * K} y="211" text-anchor="middle" font-size="10.5">
							{m === 1000 ? '1000 м' : m}
						</text>
					</g>
				))}
			</g>
			<path class="zv-hammer" d={`M8 ${lanes[0].y - 6} h10 v${lanes[2].y - lanes[0].y + 12} h-10 Z`} data-hammer></path>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Один удар по началу трёх дорожек длиной 1000 м. Звук быстрее всего бежит по стали, медленнее — в воде, ещё
		медленнее — в воздухе. Показано в 5 раз медленнее, часы показывают настоящее время.
	</figcaption>
</figure>

<style is:global>
	.zv .zv-lane-air {
		fill: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.zv .zv-lane-water {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.zv .zv-pulse {
		fill: var(--g7-gold);
		opacity: 0.9;
	}
	.zv .zv-flash {
		fill: var(--g7-gold);
	}
	.zv .zv-arrive {
		fill: var(--g7-gold);
		font-weight: 700;
		font-size: 12px;
	}
	.zv .zv-hammer {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
</style>

<script>
	import { loop, fmt } from './zv';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-zv-speed]')) {
		const X0 = 34;
		const K = 0.28;
		const SLOW = 5;
		const T_END = 1000 / 343; // s of real time until the last arrival
		const HOLD = 2; // s of screen time
		const PRE = 0.6; // s of screen time before the blow (the hammer comes in)
		const lanes = [...fig.querySelectorAll<SVGGElement>('[data-lane]')].map((g) => ({
			v: Number(g.dataset.v),
			pulse: g.querySelector('[data-pulse]')!,
			flash: g.querySelector('[data-flash]')!,
			arrive: g.querySelector('[data-arrive]')!,
		}));
		const clock = fig.querySelector('[data-clock]')!;
		const hammer = fig.querySelector('[data-hammer]')!;
		const CYCLE = PRE + T_END * SLOW + HOLD;
		let s = 0; // screen time
		const draw = () => {
			const t = Math.max(0, (s - PRE) / SLOW); // real time since the blow
			const tc = Math.min(t, T_END);
			clock.textContent = `t = ${fmt(tc, 2)} с`;
			// the hammer swings in and strikes at s = PRE
			const k = s < PRE ? 1 - s / PRE : 0;
			hammer.setAttribute('transform', `translate(${(-14 * k * k).toFixed(2)} 0)`);
			for (const l of lanes) {
				const x = Math.min(X0 + l.v * tc * K, X0 + 1000 * K);
				const arrived = l.v * tc >= 1000;
				l.pulse.setAttribute('x', (x - 3).toFixed(2));
				l.pulse.setAttribute('opacity', s >= PRE && !arrived ? '0.9' : '0');
				l.flash.setAttribute('opacity', s >= PRE && s < PRE + 0.3 ? '1' : '0');
				l.arrive.setAttribute('opacity', arrived ? '1' : '0');
			}
		};
		loop(fig, (dt) => {
			s = (s + dt) % CYCLE;
			draw();
			return true;
		});
		draw();
	}
</script>
