---
/**
 * «Кто что слышит» (static picture after the definitions of infrasound and ultrasound). A logarithmic frequency axis
 * from 1 Гц to 200 000 Гц (one decade = 50 px; ticks 1, 10, 100, 1 000, 10 000, 100 000 Гц) with three zones:
 * инфразвук (< 16 Гц), слышимый звук (16–20 000 Гц), ультразвук (> 20 000 Гц). Above it, one row per listener: a small
 * icon and the hearing range as a line with dots at its ends (OUTLINE, after Heffner & Heffner, audiograms at about
 * 60 dB): человек 16–20 000 Гц (the school range), собака 67–45 000 Гц, кошка 55–79 000 Гц, слон 16–12 000 Гц,
 * летучая мышь (большой бурый кожан) 2 000–110 000 Гц, дельфин (афалина) 75–150 000 Гц. Below the axis a piano keyboard
 * from 27,5 Гц (the lowest «ля») to 4 186 Гц (the highest «до») placed on the same log axis (52 white keys).
 */
import ZvStyles from './ZvStyles.astro';

const X0 = 74;
const DEC = 50; // px per decade
const xOf = (f: number) => X0 + DEC * Math.log10(f);
const rows = [
	{ name: 'человек', lo: 16, hi: 20000, icon: 'human' },
	{ name: 'собака', lo: 67, hi: 45000, icon: 'dog' },
	{ name: 'кошка', lo: 55, hi: 79000, icon: 'cat' },
	{ name: 'слон', lo: 16, hi: 12000, icon: 'elephant' },
	{ name: 'летучая мышь', lo: 2000, hi: 110000, icon: 'bat' },
	{ name: 'дельфин', lo: 75, hi: 150000, icon: 'dolphin' },
];
const RY = 22; // first row
const RH = 24;
const AX = RY + rows.length * RH + 6; // the axis
const ticks = [1, 10, 100, 1000, 10000, 100000];
const tickLab = ['1 Гц', '10 Гц', '100 Гц', '1 кГц', '10 кГц', '100 кГц'];
const minor = ticks.flatMap((d) => [2, 3, 4, 5, 6, 7, 8, 9].map((k) => k * d)).filter((f) => f < 200000);
// the piano: 52 white keys from A0 (27,5 Гц) to C8 (4 186 Гц); a white key's frequency by its semitone number
const WHITE = [0, 2, 3, 5, 7, 8, 10]; // A B C D E F G within an octave counted from A
const whites: number[] = [];
for (let n = 0; n < 88; n++) if (WHITE.includes(n % 12)) whites.push(27.5 * 2 ** (n / 12));
const blacks: number[] = [];
for (let n = 0; n < 88; n++) if (!WHITE.includes(n % 12)) blacks.push(27.5 * 2 ** (n / 12));
const PY = AX + 34;
const ICONS: Record<string, string> = {
	human: 'M7 1.5a2.4 2.4 0 1 1 0 4.8a2.4 2.4 0 1 1 0-4.8Z M4.6 7.5h4.8l0.8 6h-1.6l-0.6 6h-2l-0.6-6H3.8Z',
	dog: 'M1 9l2-3h7l2-3l1 0.5l0.5 2l1.5 1l-0.5 1.5h-2.5l-0.5 3l0.5 5h-1.5l-1-4.5h-4l-1 4.5H3l0.2-5L1.5 10Z',
	cat: 'M2 16l0.5-6c0-3 3-4 6-4l1.5-3l0.6 2h1.4l0.6-2l1 3.5c0.8 1 0.6 2.5-0.6 3l-0.6 6.5h-1.4l-0.4-5h-4l-1 5H3l-0.2-4c-1.5 1-2.8 2-3 0.5c1-0.2 1.6-0.7 2.2-1.5Z',
	elephant: 'M1 15V8c0-3 2.5-5 6-5h3c2.5 0 4 1.6 4 3.6V14h-1.4V9.5c-0.6 0.5-0.8 1.5-0.6 3l-1.4-0.2V15H9V12H5v3H3.4v-2.6l-1 2.6Z',
	bat: 'M7 6l1-1.5l1 1.5l1.5-0.5c1.5-2 3.6-2.6 5.5-1.6c-0.8 1-1 2-1 3c-1-0.6-2-0.4-2.6 0.6c-0.8-0.6-1.8-0.4-2.4 0.6L9 9H7L6 8.1c-0.6-1-1.6-1.2-2.4-0.6C3 6.5 2 6.3 1 6.9c0-1-0.2-2-1-3c1.9-1 4-0.4 5.5 1.6Z',
	dolphin: 'M0.5 11c3-4.5 7.5-6 12-4.5l1.5-2l0.5 2.6c1 0.6 1.6 1.4 1.5 2.4c-1 0.2-2 0-3-0.4c-2.6 0.8-5 1.2-7.4 1l-2.6 2.4l0.4-2.2c-1-0.2-2-0.3-2.9 0.7Z',
};
---

<ZvStyles />
<figure class="g7 g7--pic zv not-content" data-zv-hearing>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox={`0 0 360 ${PY + 40}`} role="img" aria-label="Шкала частот от 1 Гц до 200 кГц: инфразвук, слышимый звук и ультразвук. Над ней — какие частоты слышат человек, собака, кошка, слон, летучая мышь и дельфин. Под шкалой — какие частоты даёт рояль">
			<rect class="zv-zone zv-zone--infra" x={xOf(1)} y={RY - 14} width={xOf(16) - xOf(1)} height={AX - RY + 14}></rect>
			<rect class="zv-zone zv-zone--aud" x={xOf(16)} y={RY - 14} width={xOf(20000) - xOf(16)} height={AX - RY + 14}></rect>
			<rect class="zv-zone zv-zone--ultra" x={xOf(20000)} y={RY - 14} width={xOf(200000) - xOf(20000)} height={AX - RY + 14}></rect>
			<text class="t-small zv-zone-t" x={(xOf(1) + xOf(16)) / 2} y={RY - 3} text-anchor="middle">инфразвук</text>
			<text class="t-small zv-zone-t" x={(xOf(16) + xOf(20000)) / 2} y={RY - 3} text-anchor="middle">слышимый звук</text>
			<text class="t-small zv-zone-t" x={(xOf(20000) + xOf(200000)) / 2} y={RY - 3} text-anchor="middle">ультразвук</text>
			{
				rows.map((r, i) => {
					const y = RY + 12 + i * RH;
					return (
						<g>
							<path class="zv-icon" d={ICONS[r.icon]} transform={`translate(4 ${y - 10}) scale(1.05)`}></path>
							<text class="t-small" x="24" y={y + 4}>
								{r.name.split(' ')[0]}
							</text>
							{r.name.includes(' ') && (
								<text class="t-small" x="24" y={y + 14} font-size="10">
									{r.name.split(' ')[1]}
								</text>
							)}
							<line class="zv-range" x1={xOf(r.lo)} y1={y} x2={xOf(r.hi)} y2={y}></line>
							<circle class="zv-range-dot" cx={xOf(r.lo)} cy={y} r="3"></circle>
							<circle class="zv-range-dot" cx={xOf(r.hi)} cy={y} r="3"></circle>
						</g>
					);
				})
			}
			<line class="zv-axis" x1={xOf(1)} y1={AX} x2={xOf(200000)} y2={AX}></line>
			{minor.map((f) => <line class="zv-axis" x1={xOf(f)} y1={AX} x2={xOf(f)} y2={AX + 3} />)}
			{ticks.map((f, i) => (
				<g>
					<line class="zv-axis" x1={xOf(f)} y1={AX} x2={xOf(f)} y2={AX + 6}></line>
					<text class="t-small" x={xOf(f)} y={AX + 18} text-anchor="middle" font-size="10.5">
						{tickLab[i]}
					</text>
				</g>
			))}
			<text class="t-small zv-faint" x={xOf(200000)} y={AX - 4} text-anchor="end" font-size="10">частота</text>
			<!-- the piano -->
			<rect class="zv-key" x={xOf(27.5 / 2 ** (1 / 24))} y={PY} width={xOf(4186 * 2 ** (1 / 24)) - xOf(27.5 / 2 ** (1 / 24))} height="16"></rect>
			{whites.map((f) => <line class="zv-key-line" x1={xOf(f * 2 ** (1 / 24))} y1={PY} x2={xOf(f * 2 ** (1 / 24))} y2={PY + 16} />)}
			{blacks.map((f) => <rect class="zv-key-black" x={xOf(f) - 0.5} y={PY} width="1.1" height="10" />)}
			<text class="t-small" x={xOf(4186) + 8} y={PY + 12}>рояль</text>
			<text class="t-small zv-faint" x={xOf(27.5)} y={PY + 30} text-anchor="middle" font-size="10">27,5 Гц</text>
			<text class="t-small zv-faint" x={xOf(4186)} y={PY + 30} text-anchor="middle" font-size="10">4 186 Гц</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Какие частоты слышат человек и животные. Шкала частот неравномерная: каждое деление — в 10 раз больше предыдущего.
	</figcaption>
</figure>

<style is:global>
	.zv .zv-zone--infra {
		fill: color-mix(in oklab, var(--g7-blue) 14%, transparent);
	}
	.zv .zv-zone--aud {
		fill: color-mix(in oklab, var(--g7-green) 12%, transparent);
	}
	.zv .zv-zone--ultra {
		fill: color-mix(in oklab, var(--g7-violet) 16%, transparent);
	}
	.zv .zv-zone-t {
		fill: var(--sl-color-gray-2);
		font-weight: 600;
	}
	.zv .zv-icon {
		fill: var(--sl-color-gray-2);
	}
	.zv .zv-range {
		stroke: var(--g7-gold);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.zv .zv-range-dot {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.zv .zv-key {
		fill: hsl(40, 30%, 96%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zv .zv-key-line {
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.35;
	}
	.zv .zv-key-black {
		fill: hsl(220, 15%, 12%);
	}
</style>
