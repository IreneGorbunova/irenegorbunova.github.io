---
/**
 * Picture «Свинцовые цилиндры»: two lead cylinders, pressed together with freshly cleaned faces, hold together
 * and carry a weight of 5 кг; next to them, two halves of a broken piece of chalk that do not stick. A static drawing.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic lead not-content">
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 220 220" role="img" aria-label="Два свинцовых цилиндра, прижатых свежими срезами, держатся друг за друга и выдерживают гирю в пять килограммов">
			<path class="lead__stand" d="M20 14 H200 M110 14 V34"></path>
			<path class="ink" d="M110 34 v10"></path>
			<rect class="lead__cyl" x="88" y="44" width="44" height="46" rx="3"></rect>
			<rect class="lead__cyl" x="88" y="92" width="44" height="46" rx="3"></rect>
			<path class="lead__cut" d="M88 91 H132"></path>
			<path class="ink" d="M110 138 v16"></path>
			<path class="lead__weight" d="M84 158 q0 -6 8 -6 h36 q8 0 8 6 l6 44 H78 Z"></path>
			<text class="t-strong" x="110" y="188" text-anchor="middle">5 кг</text>
			<text class="t-small" x="140" y="72">свинец</text>
			<text class="t-small" x="140" y="120">свинец</text>
			<path class="ln" d="M134 91 H150"></path>
			<text class="t-small" x="152" y="95">срезы</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 220 220" role="img" aria-label="Половинки сломанного мела не слипаются: их неровные изломы соприкасаются только в нескольких точках">
			<text class="t-title" x="110" y="24" text-anchor="middle">излом мела под лупой</text>
			<path class="lead__chalk" d="M30 40 H190 V96 L176 104 L160 94 L146 106 L130 96 L112 108 L96 98 L80 106 L62 96 L46 104 L30 98 Z"></path>
			<path class="lead__chalk" d="M30 200 H190 V124 L172 116 L158 126 L140 114 L126 124 L112 114 L98 122 L78 112 L64 122 L46 112 L30 120 Z"></path>
			<circle class="lead__touch" cx="112" cy="111" r="6"></circle>
			<circle class="lead__touch" cx="46" cy="108" r="6"></circle>
			<circle class="lead__touch" cx="172" cy="110" r="6"></circle>
			<text class="t-small" x="110" y="214" text-anchor="middle">соприкасаются только в отдельных точках</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Слева: мягкий свинец на свежих срезах сминается, и молекулы двух цилиндров сближаются почти по всей площади. Справа: у твёрдого мела выступы излома не дают сблизиться остальным молекулам.
	</figcaption>
</figure>

<style is:global>
	.lead__stand {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.lead__cyl {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.lead__cut {
		stroke: var(--g7-gold);
		stroke-width: 2.4;
	}
	.lead__weight {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.lead__chalk {
		fill: color-mix(in oklab, var(--sl-color-white) 85%, var(--sl-color-gray-4));
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	:root:not([data-theme='light']) .lead__chalk {
		fill: hsl(220, 14%, 82%);
	}
	.lead__touch {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.6;
	}
</style>
