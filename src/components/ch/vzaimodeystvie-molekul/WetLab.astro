---
/**
 * «Смачивание»: a drop of 110 molecules (the model of g7/md.ts, temperature 0,42, weak gravity) lies on a solid
 * surface that attracts the molecules with an adjustable strength. When the surface attracts the molecules weakly,
 * they hold on to each other and the drop stays a rounded bead; when it attracts them strongly, they spread over
 * it. The number of molecules in the layer next to the surface is counted (those within 1,3 diameters of it).
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--stack wet not-content" data-wet>
	<div class="g7__grid">
		<canvas class="g7__canvas" width="720" height="378" role="img" aria-label="Капля из молекул на твёрдой поверхности" data-canvas></canvas>
		<div class="g7__side wet__side">
			<label class="g7__slider">
				<span>Притяжение молекул жидкости к поверхности</span>
				<output data-out></output>
				<input type="range" min="0" max="4" step="1" value="0" data-f aria-label="Притяжение молекул жидкости к поверхности" />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-new>Новая капля</button>
			</div>
			<ul class="g7__read" aria-live="off">
				<li><span>Молекул в слое у поверхности</span><b data-n>—</b></li>
				<li class="is-key"><span>Жидкость</span><b data-verdict>—</b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Молекулы жидкости притягиваются друг к другу всегда одинаково. Меняется только то, как сильно их притягивает твёрдая поверхность внизу. После смены притяжения подождите несколько секунд: капле нужно время, чтобы изменить форму.
	</figcaption>
</figure>

<style is:global>
	.wet__side {
		grid-template-columns: minmax(0, 1.3fr) auto;
		align-items: end;
	}
	.wet__side .g7__read {
		grid-column: 1 / -1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	@container (max-width: 30rem) {
		.wet__side,
		.wet__side .g7__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { MD, lattice, paint, themeColors } from '../g7/md';

	const W = 40;
	const H = 21;
	const PX = 18;
	const FLOOR = [0, 0.5, 1.2, 2, 3.2];
	const WORDS = ['очень слабое', 'слабое', 'среднее', 'сильное', 'очень сильное'];
	const NAMES = { mol: '--ig-vx', solid: '--sl-color-gray-3', edge: '--sl-color-gray-1' };
	for (const root of document.querySelectorAll<HTMLElement>('[data-wet]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const canvas = q<HTMLCanvasElement>('[data-canvas]');
		const ctx = canvas.getContext('2d')!;
		const fIn = q<HTMLInputElement>('[data-f]');
		let md = new MD({ w: W, h: H, g: 0.02 });
		let colors = themeColors(root, NAMES);
		let frame = 0;
		let avg = 0;
		const fresh = () => {
			md = new MD({ w: W, h: H, g: 0.02, floor: FLOOR[Number(fIn.value)] });
			md.set(lattice(13, H - 10, 27, H - 1, 1.12).slice(0, 110), 0.42);
			md.target = 0.42;
			avg = 8;
		};
		const label = () => {
			q('[data-out]').textContent = WORDS[Number(fIn.value)];
			md.floor = FLOOR[Number(fIn.value)];
		};
		loop(root, () => {
			md.run(12);
			if (frame++ % 90 === 0) colors = themeColors(root, NAMES);
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			paint(ctx, md, PX, () => colors.mol);
			// the solid surface: a row of its own molecules under the floor
			ctx.fillStyle = colors.solid;
			for (let x = 0.5; x < W; x += 1) {
				ctx.beginPath();
				ctx.arc(x * PX, H * PX + 0.1 * PX, PX * 0.5, 0, Math.PI * 2);
				ctx.fill();
			}
			if (frame % 20 === 0) {
				let n = 0;
				for (let i = 0; i < md.n; i++) if (md.y[i] > H - 1.3) n++;
				avg += (n - avg) * 0.25;
				q('[data-n]').textContent = String(Math.round(avg));
				q('[data-verdict]').textContent = avg < 13 ? 'не смачивает поверхность' : avg < 22 ? 'смачивает слабо' : 'смачивает поверхность';
			}
			return true;
		});
		fIn.addEventListener('input', label);
		q('[data-new]').addEventListener('click', () => {
			fresh();
			label();
		});
		fresh();
		label();
	}
</script>
