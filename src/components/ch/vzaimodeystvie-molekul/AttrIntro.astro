---
/**
 * Two short looping opening scenes of «Взаимодействие молекул». No terms of the chapter in the pictures.
 * Clay: two pieces of plasticine are pressed together and lifted as one; two halves of a broken stick of chalk
 *   are pressed together in the same way, and only the upper half is lifted.
 * Drops: a drop of water falls on clean glass and on a waxed surface. The drop keeps its area in the drawing
 *   (its volume) and is a segment of a circle; on the glass its edge angle goes to 25° (the water spreads), on
 *   the wax to 105° (the water stays a bead).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-attrintro>
	<div class="intro__card" data-scene="clay">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Слева два куска пластилина прижимают друг к другу, и они слипаются. Справа прижимают друг к другу половинки сломанного мела: они не слипаются">
			<rect class="ai-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="ai-table" x="0" y="196" width="360" height="44"></rect>
			<line class="ai-sep" x1="180" y1="20" x2="180" y2="190"></line>
			<text class="ai-label" x="90" y="24" text-anchor="middle">пластилин</text>
			<text class="ai-label" x="270" y="24" text-anchor="middle">сломанный мел</text>
			<!-- plasticine: the lower piece and the upper piece -->
			<g data-clay-low><rect class="ai-clay" x="56" y="150" width="68" height="46" rx="10"></rect></g>
			<g data-clay-up><rect class="ai-clay ai-clay--b" x="56" y="0" width="68" height="46" rx="10"></rect></g>
			<!-- chalk: the lower half and the upper half -->
			<g data-chalk-low><path class="ai-chalk" d="M250 196 V150 l8 -5 l8 6 l8 -7 l8 6 l8 -5 V196 Z"></path></g>
			<g data-chalk-up><path class="ai-chalk" d="M250 0 V46 l8 -5 l8 6 l8 -7 l8 6 l8 -5 V0 Z"></path></g>
			<text class="ai-note" x="90" y="226" text-anchor="middle" data-n1></text>
			<text class="ai-note" x="270" y="226" text-anchor="middle" data-n2></text>
		</svg>
		<div class="intro__foot">
			<p>
				Два куска пластилина, если их прижать, становятся одним. Половинки сломанного мела не срастаются, как их ни прижимай:{' '}
				<More term="частицы притягиваются только на очень малых расстояниях">
					Мягкий пластилин сминается, и частицы двух кусков сближаются вплотную. У твёрдого мела излом неровный: половинки соприкасаются лишь в нескольких точках, а остальные частицы остаются слишком далеко друг от друга. Об этом — в разделе{' '}
					<a href="#притяжение-молекул">«Притяжение молекул»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="drops">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Капля воды на чистом стекле растекается, а на навощённой поверхности остаётся шариком">
			<rect class="ai-room" x="0" y="0" width="360" height="240"></rect>
			<line class="ai-sep" x1="180" y1="20" x2="180" y2="200"></line>
			<text class="ai-label" x="90" y="24" text-anchor="middle">чистое стекло</text>
			<text class="ai-label" x="270" y="24" text-anchor="middle">стекло, натёртое воском</text>
			<rect class="ai-glass" x="14" y="170" width="152" height="12" rx="2"></rect>
			<rect class="ai-glass" x="194" y="170" width="152" height="12" rx="2"></rect>
			<rect class="ai-wax" x="194" y="166" width="152" height="4"></rect>
			<path class="ai-drop" data-d1></path>
			<path class="ai-drop" data-d2></path>
			<text class="ai-note" x="90" y="212" text-anchor="middle" data-t1></text>
			<text class="ai-note" x="270" y="212" text-anchor="middle" data-t2></text>
		</svg>
		<div class="intro__foot">
			<p>
				На чистом стекле капля воды растекается, а на стекле, натёртом воском, остаётся шариком:{' '}
				<More term="стекло притягивает частицы воды сильнее, чем воск">
					Частицы воды притягиваются и друг к другу, и к поверхности, на которой лежит капля. Стекло притягивает их сильнее, чем они притягивают друг друга, — и вода растекается. Воск притягивает их слабее — и капля собирается в шарик. Об этом — в разделе{' '}
					<a href="#смачивание">«Смачивание»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-attrintro] .ai-room {
		fill: var(--sl-color-bg);
	}
	[data-attrintro] .ai-table {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-attrintro] .ai-sep {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	[data-attrintro] .ai-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-attrintro] .ai-note {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-attrintro] .ai-clay {
		fill: hsl(205, 70%, 52%);
		stroke: hsl(205, 70%, 34%);
		stroke-width: 1.2;
	}
	[data-attrintro] .ai-clay--b {
		fill: hsl(350, 70%, 58%);
		stroke: hsl(350, 60%, 38%);
	}
	[data-attrintro] .ai-chalk {
		fill: hsl(220, 14%, 88%);
		stroke: hsl(220, 10%, 52%);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	[data-attrintro] .ai-glass {
		fill: color-mix(in srgb, var(--ig-vx) 18%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-attrintro] .ai-wax {
		fill: hsl(42, 70%, 70%);
	}
	[data-attrintro] .ai-drop {
		fill: color-mix(in srgb, var(--ig-vx) 62%, transparent);
		stroke: var(--ig-vx);
		stroke-width: 1.2;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-attrintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="clay"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const clayUp = $<SVGGElement>('[data-clay-up]');
			const clayLow = $<SVGGElement>('[data-clay-low]');
			const chalkUp = $<SVGGElement>('[data-chalk-up]');
			const n1 = $<SVGTextElement>('[data-n1]');
			const n2 = $<SVGTextElement>('[data-n2]');
			scene(card, 7, (x) => {
				// the upper pieces come down (0…0,3), are pressed (0,3…0,5) and are lifted (0,5…1)
				const down = ease(x / 0.3);
				const press = ease((x - 0.3) / 0.15) - ease((x - 0.45) / 0.05) * 0; // stays pressed
				const up = ease((x - 0.55) / 0.35);
				const lift = 60 * up;
				// plasticine: the upper piece ends 6 px inside the lower one (they are squeezed together)
				const yClay = 40 + (104 + 6 * press - 40) * down - lift;
				clayUp.setAttribute('transform', `translate(0 ${yClay.toFixed(1)})`);
				clayLow.setAttribute('transform', `translate(0 ${(-lift).toFixed(1)})`);
				// chalk: the upper half rests on the teeth of the lower one, then leaves alone
				const yChalk = 40 + (104 - 40) * down - lift;
				chalkUp.setAttribute('transform', `translate(0 ${yChalk.toFixed(1)})`);
				n1.textContent = up > 0.3 ? 'слиплись' : '';
				n2.textContent = up > 0.3 ? 'не слиплись' : '';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="drops"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const AREA = Math.PI * 17 * 17; // the drop in the air: a circle of radius 17 px
			// a circular segment of the given area with the edge angle th (rad), resting on y = floor
			const seg = (cx: number, floor: number, th: number) => {
				const R = Math.sqrt(AREA / (th - Math.sin(th) * Math.cos(th)));
				const half = R * Math.sin(th);
				const large = th > Math.PI / 2 ? 1 : 0;
				return `M${(cx - half).toFixed(1)} ${floor} A${R.toFixed(1)} ${R.toFixed(1)} 0 ${large} 1 ${(cx + half).toFixed(1)} ${floor} Z`;
			};
			const circle = (cx: number, cy: number, r: number) => `M${cx - r} ${cy} a${r} ${r} 0 1 0 ${2 * r} 0 a${r} ${r} 0 1 0 ${-2 * r} 0 Z`;
			const d1 = $<SVGPathElement>('[data-d1]');
			const d2 = $<SVGPathElement>('[data-d2]');
			const t1 = $<SVGTextElement>('[data-t1]');
			const t2 = $<SVGTextElement>('[data-t2]');
			const deg = Math.PI / 180;
			scene(card, 6, (x) => {
				const fall = Math.min(1, x / 0.3);
				const spread = ease((x - 0.3) / 0.5);
				if (fall < 1) {
					const y = 40 + (153 - 40) * fall * fall;
					d1.setAttribute('d', circle(90, y, 17));
					d2.setAttribute('d', circle(270, y - 4, 17));
				} else {
					d1.setAttribute('d', seg(90, 170, (179 - (179 - 25) * spread) * deg));
					d2.setAttribute('d', seg(270, 166, (179 - (179 - 105) * spread) * deg));
				}
				t1.textContent = spread > 0.9 ? 'растеклась' : '';
				t2.textContent = spread > 0.9 ? 'осталась шариком' : '';
			});
		}
	}
</script>
