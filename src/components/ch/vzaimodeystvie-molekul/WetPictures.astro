---
/**
 * Pictures «Смачивание в жизни» for the examples of the section «Смачивание»: side views of drops.
 *   1. Water on clean glass: contact angle 10° (clean glass: 0–20°), the drop spreads into a thin layer.
 *   2. Water on paraffin: 107° (measured 105–110°), the drop gathers into a bead.
 *   3. A duck: water drops on the oiled feathers (apparent contact angle about 150°) roll down the back and fall off.
 *   4. Mercury: on glass 140°, a ball; on clean copper it wets (10°) and spreads.
 * Panels 1, 2 and 4 share one scale, 20 units per мм: the water drops are 5 мм³ each, the mercury drops 1,5 мм³ each,
 * so in each pair the volumes are equal and only the wetting differs. Drops this small (about 1–2 мм high, below the
 * capillary length: 2,7 мм for water, 1,9 мм for mercury) are hardly flattened by gravity, so each is drawn as a
 * spherical cap with its contact angle. Panel 3 is not to scale: the duck is 30 см long (1 unit ≈ 2,7 мм), the drops
 * are drawn about eight times larger than real ones (radius 1,5 мм). Their motion is computed: a drop rolls down the
 * back from its crest without friction losses (a = 5/7 · g · sin α along the back, 19 см of back), then falls freely;
 * the clock is slowed down 5 times (the real roll takes 0,4–0,7 с, the drop leaves the tail at about 0,9 м/с). The
 * caption says both.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 20; // units per мм
const cap = (cx: number, base: number, thetaDeg: number, volMm3: number) => {
	const th = (thetaDeg * Math.PI) / 180;
	const c = Math.cos(th);
	const R = Math.cbrt((3 * volMm3 * K ** 3) / (Math.PI * (2 - 3 * c + c ** 3)));
	const a = R * Math.sin(th);
	const big = thetaDeg > 90 ? 1 : 0;
	return `M${(cx - a).toFixed(2)} ${base} A${R.toFixed(2)} ${R.toFixed(2)} 0 ${big} 1 ${(cx + a).toFixed(2)} ${base} Z`;
};
const BASE = 100;
---

<G7Styles />
<figure class="g7 g7--pic wtp not-content" data-wetpics>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 30 220 126" role="img" aria-label="Капля воды на чистом стекле растекается тонким слоем">
			<rect class="wtp__glass" x="14" y={BASE} width="192" height="12" rx="1.5"></rect>
			<path class="wtp__glint" d="M26 110 l5 -8 M34 110 l3 -5"></path>
			<path class="wtp__water" d={cap(110, BASE, 10, 5)}></path>
			<text class="t-title" x="110" y="136" text-anchor="middle">Вода на чистом стекле</text>
			<text class="t-small" x="110" y="150" text-anchor="middle">растекается тонким слоем</text>
		</svg>
		<svg class="g7__svg" viewBox="0 30 220 126" role="img" aria-label="Вода на парафине собирается в выпуклую каплю">
			<rect class="wtp__wax" x="14" y={BASE} width="192" height="16" rx="1.5"></rect>
			<path class="wtp__water" d={cap(110, BASE, 107, 5)}></path>
			<text class="t-title" x="110" y="136" text-anchor="middle">Вода на парафине</text>
			<text class="t-small" x="110" y="150" text-anchor="middle">собирается в каплю</text>
		</svg>
		<svg class="g7__svg" viewBox="0 30 220 126" role="img" aria-label="Капли воды скатываются с жирных перьев утки">
			<path class="wtp__duck" d="M150 72 C 132 66 104 66 84 74 C 72 79 62 86 50 88 C 46 92 50 100 60 104 H 150 C 166 104 172 94 170 84 Z"></path>
			<path class="wtp__wing" d="M134 80 C 118 76 98 78 82 88 C 100 92 122 92 136 88 Z"></path>
			<path class="wtp__neck" d="M150 74 C 152 62 150 52 154 44 C 156 38 170 36 176 44 C 178 50 172 56 168 62 C 166 70 168 78 166 84 Z"></path>
			<path class="wtp__beak" d="M176 45 C 182 44 188 46 192 49 C 186 51 180 51 175 50 Z"></path>
			<circle class="wtp__eye" cx="166" cy="45" r="1.6"></circle>
			<path class="wtp__guide" d="M118 67.5 C 106 67.5 96 70 84 74 C 72 79 62 86 50 88" data-back></path>
			<path class="wtp__pond" d="M0 97 H220 V118 H0 Z"></path>
			<path class="wtp__pond-edge" d="M0 97 H220"></path>
			<g data-drops></g>
			<text class="t-title" x="110" y="136" text-anchor="middle">Вода на перьях утки</text>
			<text class="t-small" x="110" y="150" text-anchor="middle">капли скатываются, перья сухие</text>
		</svg>
		<svg class="g7__svg" viewBox="0 30 220 126" role="img" aria-label="Ртуть на стекле собирается в шарик, а на чистой меди растекается">
			<rect class="wtp__glass" x="8" y={BASE} width="98" height="12" rx="1.5"></rect>
			<path class="wtp__glint" d="M16 110 l5 -8 M24 110 l3 -5"></path>
			<rect class="wtp__copper" x="114" y={BASE} width="98" height="12" rx="1.5"></rect>
			<path class="wtp__hg" d={cap(57, BASE, 140, 1.5)}></path>
			<path class="wtp__hg" d={cap(163, BASE, 10, 1.5)}></path>
			<ellipse class="wtp__shine" cx="53" cy="83" rx="3" ry="5" transform="rotate(-25 53 83)"></ellipse>
			<text class="t-small" x="57" y="62" text-anchor="middle">стекло</text>
			<text class="t-small" x="163" y="62" text-anchor="middle">медь</text>
			<text class="t-title" x="110" y="136" text-anchor="middle">Ртуть</text>
			<text class="t-small" x="110" y="150" text-anchor="middle">на стекле — шарик, на меди — слой</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Капли нарисованы сбоку в одном масштабе: на стекле и на парафине капли воды одинакового объёма, на стекле и на меди капли ртути тоже одного объёма. На утке капли увеличены, а их движение замедлено в 5&nbsp;раз.
	</figcaption>
</figure>

<style is:global>
	.wtp__glass {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 30%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.wtp__glint {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-linecap: round;
		opacity: 0.7;
	}
	:root[data-theme='light'] .wtp__glint {
		stroke: var(--sl-color-black);
		opacity: 1;
	}
	.wtp__wax {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-2));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	:root[data-theme='light'] .wtp__wax {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-6));
	}
	.wtp__copper {
		fill: color-mix(in oklab, color-mix(in oklab, var(--ig-v) 55%, var(--ig-vy)) 70%, var(--sl-color-gray-4));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.wtp__water {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.wtp__hg {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--ig-vx));
		stroke: var(--g7-ink);
		stroke-width: 1.1;
		stroke-linejoin: round;
	}
	.wtp__shine {
		fill: var(--sl-color-gray-1);
		opacity: 0.75;
	}
	:root[data-theme='light'] .wtp__shine {
		fill: var(--sl-color-black);
		opacity: 0.9;
	}
	.wtp__pond {
		fill: color-mix(in srgb, var(--ig-vx) 45%, transparent);
	}
	.wtp__pond-edge {
		stroke: var(--g7-water-edge);
		stroke-width: 1.4;
	}
	.wtp__duck {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 1.1;
		stroke-linejoin: round;
	}
	.wtp__wing {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.wtp__neck {
		fill: color-mix(in oklab, var(--g7-green) 55%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1.1;
		stroke-linejoin: round;
	}
	.wtp__beak {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.wtp__eye {
		fill: var(--g7-ink);
	}
	.wtp__guide {
		fill: none;
		stroke: none;
	}
	.wtp__drop {
		fill: var(--g7-water);
		stroke: var(--g7-water-edge);
		stroke-width: 1.2;
	}
	.wtp__ring {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 1;
	}
</style>

<script>
	import { el, loop } from '../g7/kit';

	const UNIT = 2.7; // мм per unit in the duck panel (the duck is 30 см long)
	const G = 9810 / UNIT; // units per с²
	const SLOW = 5;
	const R = 4.4; // units: the drawn drop (real: about 0,55 unit)
	const TH = (150 * Math.PI) / 180;
	const WATER = 97;
	const GAP = 0.8; // s on screen between two drops

	/** a drop with contact angle TH, resting on a surface with tangent (tx, ty), touching it at (x, y) */
	const dropPath = (x: number, y: number, tx: number, ty: number) => {
		if (tx < 0) {
			tx = -tx;
			ty = -ty;
		}
		const a = R * Math.sin(TH);
		const p0 = `${(x - tx * a).toFixed(2)} ${(y - ty * a).toFixed(2)}`;
		const p1 = `${(x + tx * a).toFixed(2)} ${(y + ty * a).toFixed(2)}`;
		return `M${p0} A${R} ${R} 0 1 1 ${p1} Z`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-wetpics]')) {
		const back = root.querySelector<SVGPathElement>('[data-back]')!;
		const g = root.querySelector('[data-drops]')!;
		const L = back.getTotalLength();
		const at = (s: number) => {
			const p = back.getPointAtLength(Math.max(0, Math.min(L, s)));
			const q = back.getPointAtLength(Math.max(0, Math.min(L, s + 0.5)));
			const d = Math.hypot(q.x - p.x, q.y - p.y) || 1;
			return { x: p.x, y: p.y, tx: (q.x - p.x) / d, ty: (q.y - p.y) / d };
		};
		// one drop at a time: it appears on the back (in turn at two places), rolls down, falls and makes a ring
		const STARTS = [4, 14];
		const path = el('path', { class: 'wtp__drop' });
		const ring = el('ellipse', { class: 'wtp__ring', rx: 0, ry: 0, cy: WATER, opacity: 0 });
		g.append(path, ring);
		const drops = [{ n: 0, s0: STARTS[0], path, ring, t: 0, s: 0, v: 0, fall: null as null | { x: number; y: number; vx: number; vy: number }, splash: -1 }];
		const reset = (d: (typeof drops)[number]) => {
			d.s0 = STARTS[d.n++ % STARTS.length];
			d.s = d.s0;
			d.v = 0;
			d.fall = null;
			d.splash = -1;
			d.path.setAttribute('opacity', '0');
		};
		drops.forEach(reset);
		loop(root, (dtShown) => {
			const dt = dtShown / SLOW;
			for (const d of drops) {
				d.t += dtShown;
				if (d.t < 0) continue;
				if (d.t < 0.6) {
					// the drop appears where it landed on the back
					const p = at(d.s);
					d.path.setAttribute('d', dropPath(p.x, p.y, p.tx, p.ty));
					d.path.setAttribute('opacity', (d.t / 0.6).toFixed(2));
					continue;
				}
				d.path.setAttribute('opacity', '1');
				if (!d.fall) {
					const p = at(d.s);
					d.v += (5 / 7) * G * p.ty * dt; // sin α = the downward component of the tangent
					d.s += d.v * dt;
					if (d.s >= L) {
						const e = at(L);
						d.fall = { x: e.x, y: e.y - R * 0.9, vx: d.v * e.tx, vy: d.v * e.ty };
					} else d.path.setAttribute('d', dropPath(p.x, p.y, p.tx, p.ty));
				}
				if (d.fall && d.splash < 0) {
					const f = d.fall;
					f.vy += G * dt;
					f.x += f.vx * dt;
					f.y += f.vy * dt;
					if (f.y + R >= WATER) {
						d.splash = 0;
						d.path.setAttribute('opacity', '0');
						d.ring.setAttribute('cx', f.x.toFixed(1));
					} else d.path.setAttribute('d', `M${(f.x - R).toFixed(2)} ${f.y.toFixed(2)} a${R} ${R} 0 1 0 ${2 * R} 0 a${R} ${R} 0 1 0 ${-2 * R} 0`);
				}
				if (d.splash >= 0) {
					d.splash += dtShown;
					const u = d.splash / 0.9;
					d.ring.setAttribute('rx', (3 + 12 * u).toFixed(1));
					d.ring.setAttribute('ry', (1 + 2.5 * u).toFixed(1));
					d.ring.setAttribute('opacity', Math.max(0, 1 - u).toFixed(2));
					if (u >= 1) {
						reset(d);
						d.t = -GAP;
					}
				}
			}
			return true;
		});
	}
</script>
