---
/**
 * A labelled scheme of a small DC motor (as in toys and cordless drills), cut along its shaft.
 * Inside the steel can: two permanent magnets (the inner face of the upper one is N, of the lower one S); between
 * them the armature — an iron cylinder whose slots carry the copper winding; on the same shaft, in the plastic end
 * cap, the commutator (copper plates with gaps) and two brushes pressed to it by springs; the leads «+» and «−».
 * The armature turns slowly (0,5 об/с, shown slowly): the slots and the commutator plates move down on the front
 * side, as on a turning cylinder (y = r·sin β, seen while cos β > 0).
 */
const uid = Math.random().toString(36).slice(2, 8);
const SLOTS = 8;
const PLATES = 6;
---

<figure class="mpt not-content" data-mpt>
	<div class="mpt__stage">
		<svg class="mpt__svg" viewBox="0 0 360 236" role="img" aria-label="Устройство электродвигателя в разрезе: корпус, два постоянных магнита, якорь с обмоткой, вал, коллектор и две щётки">
			<defs>
				<clipPath id={`mpt-a-${uid}`}><rect x="104" y="80" width="108" height="64" rx="4"></rect></clipPath>
				<clipPath id={`mpt-c-${uid}`}><rect x="262" y="98" width="30" height="28" rx="3"></rect></clipPath>
			</defs>
			<!-- shaft -->
			<rect class="mpt__shaft" x="40" y="108" width="282" height="8" rx="2"></rect>
			<!-- the can -->
			<path class="mpt__can" d="M 248 42 H 76 Q 66 42 66 52 V 172 Q 66 182 76 182 H 248"></path>
			<rect class="mpt__bearing" x="60" y="103" width="12" height="18" rx="2"></rect>
			<!-- the magnets -->
			<rect class="mpt__n" x="86" y="46" width="146" height="22" rx="3"></rect>
			<rect class="mpt__s" x="86" y="156" width="146" height="22" rx="3"></rect>
			<text class="mpt__pole" x="159" y="62" text-anchor="middle">N</text>
			<text class="mpt__pole" x="159" y="172" text-anchor="middle">S</text>
			<!-- the armature: iron with slots of copper winding -->
			<rect class="mpt__iron" x="104" y="80" width="108" height="64" rx="4"></rect>
			<g clip-path={`url(#mpt-a-${uid})`}>
				<g data-slots>{Array.from({ length: SLOTS }, () => <line class="mpt__slot" x1="104" y1="112" x2="212" y2="112" />)}</g>
			</g>
			<path class="mpt__coil" d="M 104 84 Q 92 86 92 112 Q 92 138 104 140"></path>
			<path class="mpt__coil" d="M 212 84 Q 224 86 224 112 Q 224 138 212 140"></path>
			<!-- leads from the winding to the commutator -->
			<path class="mpt__lead" d="M 222 98 Q 244 98 262 102"></path>
			<path class="mpt__lead" d="M 222 126 Q 244 126 262 122"></path>
			<!-- end cap with the commutator and the brushes -->
			<path class="mpt__cap" d="M 248 42 H 296 Q 306 42 306 52 V 172 Q 306 182 296 182 H 248 Z"></path>
			<rect class="mpt__bearing" x="300" y="103" width="12" height="18" rx="2"></rect>
			<rect class="mpt__comm" x="262" y="98" width="30" height="28" rx="3"></rect>
			<g clip-path={`url(#mpt-c-${uid})`}>
				<g data-plates>{Array.from({ length: PLATES }, () => <line class="mpt__gap" x1="262" y1="112" x2="292" y2="112" />)}</g>
			</g>
			<path class="mpt__spring" d="M 277 50 l -5 4 l 10 4 l -10 4 l 10 4 l -10 4 l 5 4"></path>
			<path class="mpt__spring" d="M 277 174 l -5 -4 l 10 -4 l -10 -4 l 10 -4 l -10 -4 l 5 -4"></path>
			<rect class="mpt__brush" x="270" y="78" width="14" height="20" rx="2"></rect>
			<rect class="mpt__brush" x="270" y="126" width="14" height="20" rx="2"></rect>
			<path class="mpt__wire" d="M 284 84 H 328 V 64"></path>
			<path class="mpt__wire" d="M 284 140 H 328 V 160"></path>
			<text class="mpt__sign" x="328" y="58" text-anchor="middle">+</text>
			<text class="mpt__sign" x="328" y="176" text-anchor="middle">−</text>
			<!-- labels -->
			<g class="mpt__names">
				<line x1="80" y1="44" x2="62" y2="22"></line>
				<text x="62" y="16" text-anchor="middle">корпус</text>
				<line x1="200" y1="46" x2="212" y2="22"></line>
				<text x="212" y="16" text-anchor="middle">постоянный магнит</text>
				<line x1="130" y1="144" x2="116" y2="204"></line>
				<text x="116" y="216" text-anchor="middle">якорь</text>
				<line x1="222" y1="134" x2="192" y2="204"></line>
				<text x="192" y="216" text-anchor="middle">обмотка</text>
				<line x1="50" y1="116" x2="40" y2="140"></line>
				<text x="40" y="154" text-anchor="middle">вал</text>
				<line x1="277" y1="127" x2="262" y2="204"></line>
				<text x="262" y="216" text-anchor="middle">коллектор</text>
				<line x1="284" y1="80" x2="324" y2="24"></line>
				<text x="332" y="16" text-anchor="middle">щётка</text>
				<line x1="284" y1="144" x2="324" y2="204"></line>
				<text x="334" y="216" text-anchor="middle">щётка</text>
			</g>
		</svg>
	</div>
	<figcaption class="mpt__cap-text">
		Электродвигатель, как в игрушках и в аккумуляторной дрели, разрезанный вдоль вала. Якорь с обмоткой и коллектор сидят на одном валу и вращаются вместе; магниты, корпус и щётки неподвижны.
	</figcaption>
</figure>

<style is:global>
	.mpt {
		margin-block: 1.25rem 1.75rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
	}
	.mpt__stage {
		border-radius: 0.8rem;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-6);
		padding: 0.4rem;
	}
	.mpt__svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		height: auto;
		margin-inline: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.mpt__cap-text {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		line-height: 1.45;
	}
	.mpt text {
		font-family: var(--__sl-font);
	}
	.mpt__shaft {
		fill: var(--sl-color-gray-3);
	}
	.mpt__can {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 5;
	}
	.mpt__cap {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 50%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
		stroke-dasharray: 5 3;
	}
	.mpt__bearing {
		fill: var(--sl-color-gray-4);
	}
	.mpt__n {
		fill: color-mix(in srgb, var(--ig-vx) 78%, var(--ig-surface));
	}
	.mpt__s {
		fill: color-mix(in srgb, var(--ig-vy) 78%, var(--ig-surface));
	}
	.mpt .mpt__pole {
		fill: white;
		font-size: 14px;
		font-weight: 700;
	}
	.mpt__iron {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mpt__slot {
		stroke: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		stroke-width: 4;
	}
	.mpt__coil,
	.mpt__lead {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.mpt__lead {
		stroke-width: 1.6;
	}
	.mpt__comm {
		fill: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
	}
	.mpt__gap {
		stroke: var(--sl-color-black);
		stroke-width: 2;
	}
	.mpt__brush {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mpt__spring,
	.mpt__wire {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.mpt__wire {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.mpt .mpt__sign {
		fill: var(--sl-color-white);
		font-size: 15px;
		font-weight: 700;
	}
	.mpt__names line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
	}
	.mpt__names text {
		fill: var(--sl-color-gray-2);
		font-size: 12.5px;
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	for (const root of document.querySelectorAll<HTMLElement>('[data-mpt]')) {
		const slots = [...root.querySelectorAll<SVGLineElement>('[data-slots] line')];
		const plates = [...root.querySelectorAll<SVGLineElement>('[data-plates] line')];
		const N = 0.5; // rev/s
		let a = 0; // turns
		const place = (lines: SVGLineElement[], r: number) =>
			lines.forEach((l, k) => {
				const b = 2 * Math.PI * (a + k / lines.length);
				const y = (112 + r * Math.sin(b)).toFixed(1);
				l.setAttribute('y1', y);
				l.setAttribute('y2', y);
				l.style.opacity = Math.cos(b) > 0 ? (0.35 + 0.65 * Math.cos(b)).toFixed(2) : '0';
			});
		const show = () => {
			place(slots, 31);
			place(plates, 13);
		};
		show();
		loop(root, (dt) => {
			a = (a + N * dt) % 1;
			show();
			return true;
		});
	}
</script>
