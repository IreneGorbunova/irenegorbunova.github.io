---
/**
 * Two short looping opening scenes of «Электродвигатель». Only what one sees; the captions' popovers explain.
 * Tram: side view, the camera follows a tram leaving a stop. It accelerates uniformly, a = 1,2 м/с², for 6 s
 *   (scale 16 px = 1 м: the car is 15 м long), reaching 7,2 м/с ≈ 26 км/ч after 21,6 м. The street, the poles of
 *   the overhead line and the stop sign scroll back by exactly the distance travelled, the far houses at 0,35 of
 *   it (parallax); the wheels roll without slipping (angle = distance / radius). The pantograph slides along the
 *   contact wire; a small spark flashes where it passes a hanger of the wire.
 * Drill: a cordless drill. The trigger is pressed: the bit spins up (τ = 0,25 с) to 4 об/с — a low gear, the real
 *   speed; released, it stops. The reversing button is pushed through, the trigger pressed again: the bit spins
 *   the other way. The flutes of a right-hand twist drill pointing right look like «\»; turning forward (clockwise
 *   seen from behind) they run back towards the chuck at one pitch per turn, in reverse towards the tip. The
 *   grooves of the chuck move down on its front side when turning forward. A ring arrow around the bit (its front
 *   half drawn over the bit) shows the turning.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const clipBit = `mi-bit-${uid}`;
const headId = `mi-head-${uid}`;
// far houses: [x, width, height]; drawn twice (period 360) for the wrap
const HOUSES: [number, number, number][] = [
	[0, 62, 112],
	[66, 48, 84],
	[118, 70, 128],
	[192, 54, 96],
	[250, 64, 120],
	[318, 42, 88],
];
// windows of the tram: x of the left edge
const WIN = [92, 124, 156, 208, 240];
const DOORS = [72, 186, 270];
const BOGIES = [110, 250];
---

<IntroFrame data-mintro>
	<div class="intro__card" data-scene="tram">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Трамвай трогается с остановки и разгоняется. Токоприёмник на крыше скользит по проводу над улицей, колёса катятся по рельсам">
			<rect class="mi-sky" x="0" y="0" width="360" height="240"></rect>
			<g data-houses>
				{
					[0, 360].map((dx) =>
						HOUSES.map(([x, w, h]) => (
							<g>
								<rect class="mi-house" x={x + dx} y={200 - h} width={w} height={h} />
								{Array.from({ length: Math.floor((h - 20) / 22) }, (_, r) =>
									Array.from({ length: Math.floor((w - 8) / 16) }, (_, c) => <rect class="mi-hwin" x={x + dx + 8 + c * 16} y={200 - h + 10 + r * 22} width="7" height="10" rx="1" />),
								)}
							</g>
						)),
					)
				}
			</g>
			<rect class="mi-walk" x="0" y="196" width="360" height="10"></rect>
			<!-- poles of the overhead line and the stop sign: scroll with the street -->
			<g data-street>
				{
					[0, 180, 360, 540].map((x) => (
						<g>
							<rect class="mi-pole" x={x + 40} y="10" width="5" height="190" />
							<line class="mi-arm" x1={x + 42} y1="20" x2={x + 120} y2="20" />
							<line class="mi-hanger" x1={x + 112} y1="20" x2={x + 112} y2="28" />
						</g>
					))
				}
				<rect class="mi-pole mi-pole--thin" x="306" y="62" width="3" height="138"></rect>
				<rect class="mi-sign" x="294" y="44" width="27" height="24" rx="3"></rect>
				<text class="mi-sign-t" x="307.5" y="62" text-anchor="middle">Т</text>
			</g>
			<line class="mi-wire" x1="0" y1="28" x2="360" y2="28"></line>
			<!-- the tram (stays in place, the street moves) -->
			<g class="mi-tram">
				<path class="mi-panto" d="M 172 108 L 196 74 L 170 30 M 196 74 L 206 108"></path>
				<line class="mi-shoe" x1="158" y1="29.5" x2="182" y2="29.5"></line>
				<circle class="mi-spark" cx="170" cy="28" r="7" data-spark></circle>
				<rect class="mi-roof" x="66" y="104" width="226" height="8" rx="3"></rect>
				<path class="mi-body" d="M 58 114 Q 58 108 66 108 H 290 Q 314 110 318 140 V 186 Q 318 190 314 190 H 62 Q 58 190 58 186 Z"></path>
				<rect class="mi-band" x="58" y="160" width="260" height="12"></rect>
				{WIN.map((x) => <rect class="mi-win" x={x} y="120" width="26" height="28" rx="3" />)}
				<path class="mi-win" d="M 290 120 Q 306 122 310 148 H 290 Z"></path>
				{DOORS.map((x) => <rect class="mi-door" x={x} y="118" width="16" height="70" rx="2" />)}
				{DOORS.map((x) => <line class="mi-doorline" x1={x + 8} y1="118" x2={x + 8} y2="188" />)}
				<rect class="mi-light" x="312" y="174" width="5" height="6" rx="1.5"></rect>
				{
					BOGIES.map((x) => (
						<g>
							<rect class="mi-bogie" x={x - 30} y="186" width="60" height="10" rx="3" />
							{[-18, 18].map((d) => (
								<g data-wheel transform={`translate(${x + d} 196)`}>
									<circle class="mi-wheel" r="9" />
									<g class="mi-spokes">
										<line x1="-8" y1="0" x2="8" y2="0" />
										<line x1="0" y1="-8" x2="0" y2="8" />
									</g>
									<circle class="mi-hub" r="2.2" />
								</g>
							))}
						</g>
					))
				}
			</g>
			<rect class="mi-road" x="0" y="205" width="360" height="35"></rect>
			<line class="mi-rail" x1="0" y1="205.5" x2="360" y2="205.5"></line>
			<g data-marks>
				{[0, 60, 120, 180, 240, 300, 360].map((x) => <line class="mi-mark" x1={x} y1="222" x2={x + 26} y2="222" />)}
			</g>
		</svg>
		<div class="intro__foot">
			<p>Трамвай трогается с остановки почти бесшумно и без выхлопа. Его колёса <More term="вращают электродвигатели">Они стоят под полом вагона, у каждой тележки свои. Ток приходит к ним от электростанции по проводу над улицей через токоприёмник на крыше, а уходит через колёса и рельсы. Подробнее — в разделе <a href="#применение-электродвигателей">«Применение электродвигателей»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="drill">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Аккумуляторная дрель. Нажали курок — сверло завертелось. Отпустили, нажали кнопку переключателя, снова нажали курок — сверло вращается в другую сторону">
			<defs>
				<clipPath id={clipBit}>
					<rect x="262" y="89" width="80" height="10"></rect>
				</clipPath>
				<marker id={headId} viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="mi-ring-head" d="M0,0 L10,5 L0,10 z"></path>
				</marker>
			</defs>
			<rect class="mi-sky mi-sky--in" x="0" y="0" width="360" height="240"></rect>
			<rect class="mi-bench" x="0" y="214" width="360" height="26"></rect>
			<!-- ring arrow, back half: behind the bit -->
			<path class="mi-ring mi-ring--back" d="M 306 74 A 6 20 0 0 0 306 114" data-ring-back></path>
			<!-- the bit -->
			<rect class="mi-bit" x="262" y="89" width="80" height="10"></rect>
			<g clip-path={`url(#${clipBit})`}>
				<g data-flutes>
					{Array.from({ length: 10 }, (_, k) => <line class="mi-flute" x1={250 + k * 12} y1="88" x2={258 + k * 12} y2="100" />)}
				</g>
			</g>
			<path class="mi-bit" d="M 342 89 L 350 94 L 342 99 Z"></path>
			<!-- ring arrow, front half: over the bit -->
			<path class="mi-ring" d="M 306 74 A 6 20 0 0 1 306 114" data-ring-front></path>
			<!-- the chuck -->
			<path class="mi-chuck" d="M 218 76 H 250 L 264 86 V 102 L 250 112 H 218 Z"></path>
			<g data-grooves>
				{[0, 1, 2, 3].map(() => <line class="mi-groove" x1="222" y1="94" x2="248" y2="94" />)}
			</g>
			<!-- the body: barrel with the motor, the handle, the battery -->
			<path class="mi-dbody" d="M 70 74 Q 70 64 82 64 H 212 Q 220 64 220 72 V 116 Q 220 122 212 122 H 176 L 170 176 H 128 L 132 122 H 82 Q 70 122 70 112 Z"></path>
			{[86, 96, 106].map((x) => <line class="mi-vent" x1={x} y1="76" x2={x} y2="108" />)}
			<rect class="mi-grip" x="132" y="128" width="34" height="44" rx="6"></rect>
			<rect class="mi-batt" x="106" y="176" width="90" height="30" rx="5"></rect>
			<rect class="mi-batt-strip" x="110" y="196" width="82" height="5" rx="2"></rect>
			<!-- the reversing button goes through the body above the trigger -->
			<rect class="mi-rev-slot" x="168" y="100" width="20" height="10" rx="3"></rect>
			<rect class="mi-rev" x="172" y="101" width="12" height="8" rx="2" data-rev></rect>
			<text class="mi-click" x="178" y="92" text-anchor="middle" data-click>щёлк</text>
			<!-- the trigger -->
			<path class="mi-trigger" d="M 180 124 h 8 q 4 14 -2 26 h -8 z" data-trigger></path>
		</svg>
		<div class="intro__foot">
			<p>Нажали кнопку над курком — и дрель <More term="вращает сверло в обратную сторону">Кнопка меняет направление тока в электродвигателе дрели. Ток пошёл в другую сторону — и магнитное поле толкает обмотку двигателя тоже в другую сторону. Так шуруп можно и закрутить, и выкрутить. Подробнее — в разделе <a href="#действие-магнитного-поля-на-проводник-с-током">«Действие магнитного поля на проводник с током»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-mintro] {
		--mi-sky: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-5));
		--mi-house: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-4));
		--mi-plastic: var(--sl-color-gray-6);
		--mi-steel: var(--sl-color-gray-3);
		--mi-tram: color-mix(in srgb, var(--sl-color-white) 82%, var(--ig-vx));
	}
	:root[data-theme='light'] [data-mintro] {
		--mi-sky: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-6));
		--mi-house: color-mix(in srgb, var(--ig-vx) 8%, var(--sl-color-gray-5));
		--mi-plastic: var(--sl-color-gray-7, var(--sl-color-black));
		--mi-tram: color-mix(in srgb, var(--sl-color-gray-7, #fff) 70%, var(--ig-vx));
	}
	.mi-sky {
		fill: var(--mi-sky);
	}
	.mi-sky--in {
		fill: color-mix(in srgb, var(--ig-v) 8%, var(--mi-sky));
	}
	.mi-house {
		fill: var(--mi-house);
	}
	.mi-hwin {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-5));
		opacity: 0.7;
	}
	.mi-walk {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 70%, var(--sl-color-gray-5));
	}
	.mi-pole {
		fill: var(--sl-color-gray-3);
	}
	.mi-arm,
	.mi-hanger {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.mi-hanger {
		stroke-width: 1.2;
	}
	.mi-wire {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.mi-sign {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.intro .mi-sign-t {
		font-size: 16px;
		font-weight: 700;
		fill: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-black));
	}
	.mi-panto {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.mi-shoe {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.mi-spark {
		fill: var(--ig-v);
		opacity: 0;
		filter: blur(1.5px);
	}
	.mi-roof {
		fill: var(--sl-color-gray-4);
	}
	.mi-body {
		fill: var(--mi-tram);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.mi-band {
		fill: var(--ig-v);
		opacity: 0.85;
	}
	.mi-win {
		fill: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-door {
		fill: color-mix(in srgb, var(--ig-vx) 22%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-doorline {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-light {
		fill: var(--ig-v);
	}
	.mi-bogie {
		fill: var(--sl-color-gray-4);
	}
	.mi-wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.mi-spokes line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.mi-hub {
		fill: var(--sl-color-gray-2);
	}
	.mi-road {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 50%, var(--sl-color-gray-5));
	}
	.mi-rail {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
	}
	.mi-mark {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		opacity: 0.6;
	}
	.mi-bench {
		fill: color-mix(in srgb, var(--ig-v) 28%, var(--sl-color-gray-5));
	}
	.mi-bit {
		fill: var(--sl-color-gray-3);
	}
	.mi-flute {
		stroke: var(--sl-color-gray-5);
		stroke-width: 3.2;
	}
	.mi-chuck {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-groove {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.mi-dbody {
		fill: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.mi-vent {
		stroke: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-6));
		stroke-width: 3;
		stroke-linecap: round;
	}
	.mi-grip,
	.mi-batt {
		fill: var(--mi-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.mi-batt-strip {
		fill: color-mix(in srgb, var(--ig-v) 60%, var(--sl-color-gray-5));
	}
	.mi-rev-slot {
		fill: var(--mi-plastic);
	}
	.mi-rev {
		fill: var(--sl-color-gray-2);
	}
	.mi-trigger {
		fill: var(--mi-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-ring {
		fill: none;
		stroke: var(--sl-color-text-accent, var(--ig-v));
		stroke-width: 2.4;
		stroke-linecap: round;
		opacity: 0;
	}
	.mi-ring--back {
		stroke-dasharray: 3 3;
	}
	.mi-ring-head {
		fill: var(--sl-color-text-accent, var(--ig-v));
	}
	.mi-click {
		font-size: 13px;
		font-weight: 700;
		fill: var(--sl-color-text-accent, var(--ig-v));
		opacity: 0;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-mintro]')) {
		// Tram: uniform acceleration from the stop; 16 px = 1 м
		{
			const card = root.querySelector<HTMLElement>('[data-scene="tram"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const street = $<SVGGElement>('[data-street]');
			const houses = $<SVGGElement>('[data-houses]');
			const marks = $<SVGGElement>('[data-marks]');
			const wheels = [...card.querySelectorAll<SVGGElement>('[data-wheel]')];
			const spark = $<SVGCircleElement>('[data-spark]');
			const base = wheels.map((w) => w.getAttribute('transform')!);
			const RUN = 6;
			const PX = 16; // px per metre
			const A = 1.2 * PX; // px/s²
			const R = 9; // wheel radius, px
			const SHOE = 170; // x of the pantograph shoe
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const s = (A * t * t) / 2; // px travelled
				street.setAttribute('transform', `translate(${(-s).toFixed(1)} 0)`);
				houses.setAttribute('transform', `translate(${(-((0.35 * s) % 360)).toFixed(1)} 0)`);
				marks.setAttribute('transform', `translate(${(-(s % 60)).toFixed(1)} 0)`);
				const deg = ((s / R) * 180) / Math.PI;
				wheels.forEach((w, k) => w.setAttribute('transform', `${base[k]} rotate(${deg.toFixed(1)})`));
				// the hangers stand at 112 + 180 k (street coordinates): a flash when one passes the shoe
				let near = Infinity;
				for (let k = 0; k < 4; k++) near = Math.min(near, Math.abs(112 + 180 * k - s - SHOE));
				spark.style.opacity = f2(s > 1 ? clamp(1 - near / 6) : 0);
			});
		}

		// Drill: forward, stop, reverse button, reverse. Speeds from first-order spin-up/down, phase integrated once.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="drill"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const flutes = $<SVGGElement>('[data-flutes]');
			const grooves = [...card.querySelectorAll<SVGLineElement>('[data-grooves] line')];
			const ringF = $<SVGPathElement>('[data-ring-front]');
			const ringB = $<SVGPathElement>('[data-ring-back]');
			const rev = $<SVGRectElement>('[data-rev]');
			const trig = $<SVGPathElement>('[data-trigger]');
			const click = $<SVGTextElement>('[data-click]');
			const headId = card.querySelector('marker')!.id;
			const RUN = 8;
			const N = 4; // rev/s at the trigger
			const TAU_UP = 0.25;
			const TAU_DOWN = 0.3;
			const PRESS = [
				[0.3, 2.6, 1],
				[4.4, 7.0, -1],
			] as const;
			const T_REV = 3.6;
			const PITCH = 12; // px of the flutes per turn
			const DT = 0.002;
			// speed n(t) (rev/s) and angle α(t) (turns), tabulated
			const nTab: number[] = [];
			const aTab: number[] = [];
			{
				let n = 0;
				let a = 0;
				for (let k = 0; k <= RUN / DT; k++) {
					const t = k * DT;
					nTab.push(n);
					aTab.push(a);
					const p = PRESS.find(([t0, t1]) => t >= t0 && t < t1);
					const target = p ? N * p[2] : 0;
					n += (target - n) * (DT / (p ? TAU_UP : TAU_DOWN));
					a += n * DT;
				}
			}
			const at = (tab: number[], t: number) => tab[Math.min(tab.length - 1, Math.max(0, Math.round(t / DT)))];
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const n = at(nTab, t);
				const a = at(aTab, t); // turns
				// flutes: back towards the chuck when turning forward
				const off = -((((a * PITCH) % PITCH) + PITCH) % PITCH);
				flutes.setAttribute('transform', `translate(${off.toFixed(2)} 0)`);
				// chuck grooves on a cylinder of radius 16: the front moves down when turning forward
				grooves.forEach((g, k) => {
					const b = 2 * Math.PI * (a + k / grooves.length);
					const y = 94 + 15 * Math.sin(b);
					const front = Math.cos(b) > 0.05;
					g.setAttribute('y1', y.toFixed(1));
					g.setAttribute('y2', y.toFixed(1));
					g.style.opacity = front ? f2(0.35 + 0.65 * Math.cos(b)) : '0';
				});
				// ring arrow: arrowhead at the bottom of the front half when forward, at the top when in reverse
				const show = clamp(Math.abs(n) / N);
				ringF.style.opacity = f2(show);
				ringB.style.opacity = f2(0.6 * show);
				const fwd = n >= 0;
				ringF.setAttribute('d', fwd ? 'M 306 74 A 6 20 0 0 1 306 114' : 'M 306 114 A 6 20 0 0 0 306 74');
				ringF.setAttribute('marker-end', `url(#${headId})`);
				// the trigger goes in while pressed; the reversing button moves across at T_REV
				const pressed = PRESS.some(([t0, t1]) => t >= t0 && t < t1);
				trig.setAttribute('transform', pressed ? 'translate(-6 0)' : '');
				const r = smooth(T_REV, T_REV + 0.15, t);
				rev.setAttribute('x', (172 + 8 * r).toFixed(1));
				click.style.opacity = f2(t >= T_REV ? 1 - smooth(T_REV + 0.4, T_REV + 0.9, t) : 0);
			});
		}
	}
</script>
