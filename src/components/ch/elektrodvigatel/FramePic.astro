---
/**
 * A frame with current between the poles of a magnet, seen along its axis (the pictures next to the definitions).
 * N on the left (blue), S on the right (red), the magnetic lines from N to S. ⊗ — the current in a side goes away
 * from us, ⊙ — towards us. The field pushes a side with current up or down (force ⟂ side and ⟂ lines); the arm l
 * of the force is the distance from the axis to the vertical line of the force.
 * mode="stop": the current always flows the same way (no commutator). The key closes at 0,3 s; the frame starts
 *   along the lines (φ = 0) and turns as a rigid body: φ'' = −7·cos φ − 1,6·φ' (s⁻²; the moment of the two equal
 *   forces is ∝ cos φ, viscous damping). It swings past the vertical, comes back and settles perpendicular to the
 *   lines (φ = −90°) after about 6 s. The forces keep their size; only the arm changes.
 * mode="comm": a commutator (two half-rings, gaps ±8° wide) and two fixed brushes, «+» on the right. The frame turns
 *   clockwise at a steady 0,25 об/с (shown slowly). The half-ring that touches the «+» brush always belongs to the
 *   side on the right, so the current there always goes away from us and the force always turns the frame the same
 *   way; while the brushes are on the gaps (frame vertical) there is no current.
 */
interface Props {
	mode: 'stop' | 'comm';
	caption: string;
}
const { mode, caption } = Astro.props;
const uid = `fp-${Math.random().toString(36).slice(2, 8)}`;
const C = { x: 150, y: 112 };
const FIELD = [-72, -28, 28, 72];
---

<figure class="fp not-content" data-fp={mode}>
	<div class="fp__stage">
		<svg class="fp__svg" viewBox="0 0 300 226" role="img" aria-label={caption}>
			<defs>
				<marker id={`${uid}-f`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
					<path class="fp__hf" d="M0,0 L10,5 L0,10 z"></path>
				</marker>
				<marker id={`${uid}-b`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
					<path class="fp__hb" d="M0,0 L10,5 L0,10 z"></path>
				</marker>
			</defs>
			<rect class="fp__n" x="10" y="18" width="26" height="188" rx="3"></rect>
			<rect class="fp__s" x="264" y="18" width="26" height="188" rx="3"></rect>
			<text class="fp__pl" x="23" y={C.y + 6} text-anchor="middle">N</text>
			<text class="fp__pl" x="277" y={C.y + 6} text-anchor="middle">S</text>
			{FIELD.map((d) => <line class="fp__b" x1="36" y1={C.y + d} x2="264" y2={C.y + d} />)}
			{FIELD.map((d) => <line class="fp__b fp__b--tip" x1="232" y1={C.y + d} x2="240" y2={C.y + d} marker-end={`url(#${uid}-b)`} />)}
			<g data-dyn></g>
			{
				mode === 'comm' && (
					<g>
						<text class="fp__sign" x={C.x + 38} y={C.y + 28} text-anchor="middle">+</text>
						<text class="fp__sign" x={C.x - 38} y={C.y + 28} text-anchor="middle">−</text>
					</g>
				)
			}
		</svg>
	</div>
	<div class="fp__foot">
		<figcaption class="fp__cap">
			{caption}
			<span class="fp__keys">
				<span class="fp__key fp__key--f"></span><i>F</i> — сила, с которой поле действует на сторону рамки{mode === 'stop' ? '; ' : ''}{mode === 'stop' && <><i>l</i> — её плечо</>}; ⊗ — ток уходит от нас, ⊙ — идёт к нам{mode === 'comm' ? '; в центре — два полукольца коллектора и щётки «+» и «−»' : ''}.
			</span>
		</figcaption>
		{mode === 'stop' && <button type="button" class="fp__again" data-again>Повторить</button>}
	</div>
</figure>

<style is:global>
	.fp {
		margin-block: 1.25rem 1.75rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
	}
	.fp i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.fp__stage {
		border-radius: 0.8rem;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-6);
		padding: 0.4rem;
	}
	.fp__svg {
		display: block;
		width: 100%;
		max-width: 22rem;
		height: auto;
		margin-inline: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.fp__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.6rem;
		margin-top: 0.6rem;
	}
	.fp__cap {
		font-size: var(--sl-text-sm);
		line-height: 1.45;
	}
	.fp__keys {
		display: block;
		margin-top: 0.3rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.fp__key {
		display: inline-block;
		width: 1.1em;
		height: 3px;
		margin-right: 0.3em;
		vertical-align: 0.25em;
		border-radius: 2px;
	}
	.fp__key--f {
		background: var(--ig-v);
	}
	.fp__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.fp__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.fp__n {
		fill: color-mix(in srgb, var(--ig-vx) 78%, var(--ig-surface));
	}
	.fp__s {
		fill: color-mix(in srgb, var(--ig-vy) 78%, var(--ig-surface));
	}
	.fp text {
		font-family: var(--__sl-font);
	}
	.fp .fp__pl {
		fill: white;
		font-size: 17px;
		font-weight: 700;
	}
	.fp .fp__sign {
		fill: var(--sl-color-white);
		font-size: 17px;
		font-weight: 700;
	}
	.fp__b {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
		stroke-dasharray: 4 4;
	}
	.fp__b--tip {
		stroke-dasharray: none;
	}
	.fp__hb {
		fill: var(--sl-color-gray-3);
	}
	.fp__hf {
		fill: var(--ig-v);
	}
	.fp__frame {
		stroke: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		stroke-width: 4;
		stroke-linecap: round;
	}
	.fp__axis {
		fill: var(--sl-color-gray-2);
	}
	.fp__side {
		fill: var(--sl-color-black);
		stroke: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		stroke-width: 2.5;
	}
	.fp__m {
		stroke: var(--sl-color-green);
		fill: var(--sl-color-green);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.fp__f {
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.fp__line {
		stroke: var(--ig-v);
		stroke-width: 1;
		stroke-dasharray: 2 4;
		opacity: 0.7;
	}
	.fp__arm {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-dasharray: 4 3;
	}
	.fp .fp__lbl {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
		font-style: italic;
		font-family: var(--ig-font-math);
	}
	.fp .fp__lbl--f {
		fill: var(--ig-v);
	}
	.fp__ring {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		stroke-width: 7;
	}
	.fp__ring.is-live {
		stroke: color-mix(in srgb, var(--ig-v) 85%, var(--sl-color-white));
	}
	.fp__brush {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
</style>

<script>
	import { scene, loop } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const C = { x: 150, y: 112 };
	const R = 66; // radius of the frame, px
	const FL = 34; // force arrow, px
	const RC = 18; // radius of the commutator
	const GAP = (8 * Math.PI) / 180;

	const el = (tag: string, attrs: Record<string, string | number>, parent: Element) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent.append(e);
		return e;
	};

	/** Draw the frame at angle phi (side A, anticlockwise from the right); awayA: +1 current in A away from us, −1 towards, 0 none. */
	const draw = (g: SVGGElement, ids: { f: string }, phi: number, awayA: number, comm: boolean) => {
		g.replaceChildren();
		const c = Math.cos(phi);
		const s = Math.sin(phi);
		const sides = [1, -1].map((k) => ({ x: C.x + k * R * c, y: C.y - k * R * s, away: k * awayA }));
		const right = sides[0].x >= sides[1].x ? sides[0] : sides[1];
		if (awayA !== 0) {
			for (const sd of sides) el('line', { class: 'fp__line', x1: sd.x, y1: C.y - 100, x2: sd.x, y2: C.y + 100 }, g);
			const arm = Math.abs(right.x - C.x);
			if (arm > 5 && !comm) {
				el('line', { class: 'fp__arm', x1: C.x, y1: C.y, x2: right.x, y2: C.y }, g);
				const t = el('text', { class: 'fp__lbl', x: (C.x + right.x) / 2 - 4, y: C.y - 7 }, g);
				t.textContent = 'l';
			}
		}
		el('line', { class: 'fp__frame', x1: sides[0].x, y1: sides[0].y, x2: sides[1].x, y2: sides[1].y }, g);
		el('circle', { class: 'fp__axis', cx: C.x, cy: C.y, r: 3.5 }, g);
		for (const sd of sides) {
			if (sd.away !== 0) {
				// current away from us (into the page) and field to the right: the force points down
				const y2 = sd.y + sd.away * FL;
				el('line', { class: 'fp__f', x1: sd.x, y1: sd.y, x2: sd.x, y2, 'marker-end': `url(#${ids.f})` }, g);
				const t = el('text', { class: 'fp__lbl fp__lbl--f', x: sd.x + 8, y: sd.away > 0 ? y2 : y2 + 10 }, g);
				t.textContent = 'F';
			}
		}
		for (const sd of sides) {
			el('circle', { class: 'fp__side', cx: sd.x, cy: sd.y, r: 9 }, g);
			if (sd.away > 0) el('path', { class: 'fp__m', d: `M ${sd.x - 4.5} ${sd.y - 4.5} L ${sd.x + 4.5} ${sd.y + 4.5} M ${sd.x + 4.5} ${sd.y - 4.5} L ${sd.x - 4.5} ${sd.y + 4.5}` }, g);
			else if (sd.away < 0) el('circle', { class: 'fp__m', cx: sd.x, cy: sd.y, r: 2.4 }, g);
		}
		if (comm) {
			// half-ring k is centred on the direction of side k; the brushes press on it from the left and the right
			[1, -1].forEach((k) => {
				const mid = k > 0 ? phi : phi + Math.PI;
				const a0 = mid - Math.PI / 2 + GAP;
				const a1 = mid + Math.PI / 2 - GAP;
				const p = (a: number) => `${(C.x + RC * Math.cos(a)).toFixed(2)} ${(C.y - RC * Math.sin(a)).toFixed(2)}`;
				// does this half-ring touch the «+» brush (at angle 0)?
				let d = ((0 - mid) % (2 * Math.PI) + 3 * Math.PI) % (2 * Math.PI) - Math.PI;
				const live = Math.abs(d) < Math.PI / 2 - GAP;
				el('path', { class: `fp__ring${live && awayA !== 0 ? ' is-live' : ''}`, d: `M ${p(a0)} A ${RC} ${RC} 0 0 0 ${p(a1)}` }, g);
			});
			for (const k of [1, -1]) {
				const x0 = k > 0 ? C.x + RC + 3 : C.x - RC - 15;
				el('rect', { class: 'fp__brush', x: x0, y: C.y - 6, width: 12, height: 12, rx: 2 }, g);
			}
		}
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-fp]')) {
		const g = root.querySelector<SVGGElement>('[data-dyn]')!;
		const ids = { f: root.querySelector('marker')!.id };
		if (root.dataset.fp === 'stop') {
			const RUN = 6.5;
			const T_ON = 0.3;
			const DT = 0.002;
			const tab: number[] = [];
			let phi = 0;
			let w = 0;
			for (let k = 0; k <= RUN / DT; k++) {
				tab.push(phi);
				if (k * DT >= T_ON) {
					w += (-7 * Math.cos(phi) - 1.6 * w) * DT;
					phi += w * DT;
				}
			}
			scene(root, RUN, (x) => {
				const t = x * RUN;
				const k = Math.min(tab.length - 1, Math.round(t / DT));
				draw(g, ids, tab[k], t >= T_ON ? 1 : 0, false);
			});
		} else {
			const N = 0.25; // rev/s, clockwise
			let t = 0;
			const show = () => {
				const phi = -2 * Math.PI * N * t;
				const onGap = Math.abs(Math.cos(phi)) < Math.sin(GAP);
				// the side on the right gets the current away from us
				const rightIsA = Math.cos(phi) >= 0;
				draw(g, ids, phi, onGap ? 0 : rightIsA ? 1 : -1, true);
			};
			show();
			loop(root, (dt) => {
				t = (t + dt) % (1 / N);
				show();
				return true;
			});
		}
	}
</script>
