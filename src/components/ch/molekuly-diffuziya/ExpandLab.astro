---
/**
 * «Шар и кольцо» и «Сжатие газа»: two experiments that show the gaps between particles.
 *
 * Шар и кольцо (the Gravesande ring). A steel ball of 25,00 мм at 20 °C and a steel ring with a hole of 25,05 мм. Steel
 * expands by α = 1,2·10⁻⁵ 1/°C, so the ball's diameter is d = 25,00 мм · (1 + α·(t − 20 °C)): heated over the spirit
 * lamp to 300 °C it becomes 25,084 мм and sticks on the ring; cooling, it slips through at d = 25,05 мм, that is at
 * t = 20 + 0,05/(25·1,2·10⁻⁵) ≈ 187 °C. The ring stays at 20 °C (its warming by the ball is neglected), and the ball
 * keeps its temperature until «Остудить» is pressed. Steel at 300 °C does not glow; only a heat shimmer is drawn.
 * The chain goes up out of the picture (the hand that holds it is not drawn). Scale: 25 мм = 56 px, but every difference from 25,00 мм (the ball's growth and the hole's excess) is drawn 100 times
 * larger: 2,24 px/мм · 100 = 224 px per millimetre of difference. The inset «частицы стали» is a scheme; its spacing
 * grows by the same 100 times (0,34 % → 34 %). Time is compressed: heating (about two minutes in reality) takes 4 с
 * (70 °C/с), cooling (several minutes) takes about 5 с (60 °C/с).
 *
 * Сжатие газа. A 20 мл syringe with its outlet closed, pushed slowly so that the temperature stays the same. The push
 * raises the pressure from 1 to 3 atmospheres (the slider s = 0…1, p = 1 + 2s атм; for a barrel of 20 мм in diameter
 * that is a force of up to about 64 Н). Air obeys Boyle's law, V = 20 мл · 1 атм / p: down to 6,67 мл at 3 атм. Water's
 * compressibility is 4,6·10⁻¹⁰ 1/Па, so at +2 атм (202 650 Па) 20 мл shrink by 20 · 4,6·10⁻¹⁰ · 202 650 ≈ 0,0019 мл:
 * the readout stays at 20,00 мл. The syringe is to scale along its axis (7 px per мл). The particles are a scheme:
 * enormously enlarged; in air the real gaps are about ten times the size of a particle, in the drawing about three.
 * Their motion is random and does not depend on the push (the temperature does not change).
 */
import G7Styles from '../g7/G7Styles.astro';

// ring: 25 мм = 56 px; differences from 25,00 мм are drawn 100 times larger
const dpx = (d: number) => 56 + (d - 25) * 224;
const RX = 200;
const RY = 170;
const RH = dpx(25.05) / 2;
const RO = RH + 9;
const K = 0.3;
const backRing = `M${RX - RO} ${RY} A${RO} ${RO * K} 0 0 1 ${RX + RO} ${RY} L${RX + RH} ${RY} A${RH} ${RH * K} 0 0 0 ${RX - RH} ${RY} Z`;
const frontRing = `M${RX - RO} ${RY} A${RO} ${RO * K} 0 0 0 ${RX + RO} ${RY} L${RX + RH} ${RY} A${RH} ${RH * K} 0 0 1 ${RX - RH} ${RY} Z`;
const ringBand = `M${RX - RO} ${RY} A${RO} ${RO * K} 0 0 0 ${RX + RO} ${RY} v4 A${RO} ${RO * K} 0 0 1 ${RX - RO} ${RY + 4} Z`;

// syringe: 0 мл at x = 34, 7 px per мл
const X0 = 34;
const PXML = 7;
const ticks = Array.from({ length: 21 }, (_, i) => i);
---

<G7Styles />
<figure class="g7 exl not-content" data-explab>
	<div class="g7__row exl__top">
		<div class="g7__seg" role="group" aria-label="Опыт" data-exp>
			<button type="button" class="g7__btn" aria-pressed="true" data-e="ring">Шар и кольцо</button>
			<button type="button" class="g7__btn" aria-pressed="false" data-e="gas">Сжатие газа</button>
		</div>
	</div>

	<div class="g7__grid" data-part="ring">
		<svg class="g7__svg" viewBox="0 0 340 306" role="img" aria-label="Стальной шар на цепочке над стальным кольцом, рядом спиртовка" data-svg-ring>
			<!-- the table -->
			<line class="exl__table" x1="6" x2="334" y1="291" y2="291"></line>
			<!-- the stand with the ring -->
			<rect class="exl__stand" x="270" y="283" width="62" height="8" rx="2"></rect>
			<rect class="exl__stand" x="312" y="150" width="6" height="134"></rect>
			<rect class="exl__stand" x={RX + RO - 2} y={RY - 2} width={318 - (RX + RO - 2)} height="5" rx="1.5"></rect>
			<path class="exl__ring-back" d={backRing}></path>
			<text class="t-small" x={RX - RO - 6} y={RY + 4} text-anchor="end">кольцо</text>
			<!-- the spirit lamp -->
			<path class="exl__flame-out" data-flame d=""></path>
			<path class="exl__flame-in" data-flame-in d=""></path>
			<rect class="exl__wick" x="68" y="231" width="4" height="10"></rect>
			<rect class="exl__neck" x="62" y="240" width="16" height="10" rx="2"></rect>
			<path class="exl__lamp" d="M44 250 H96 Q104 251 104 262 V282 Q104 289 96 289 H44 Q36 289 36 282 V262 Q36 251 44 250 Z"></path>
			<path class="exl__spirit" d="M38 268 H102 V282 Q102 287 96 287 H44 Q38 287 38 282 Z"></path>
			<text class="t-small" x="70" y="303" text-anchor="middle">спиртовка</text>
			<!-- the ball on a chain -->
			<g data-ball>
				<line class="exl__chain" data-chain x1="0" x2="0" y1="0" y2="0"></line>
				<g class="exl__shimmer" data-shimmer>
					<path data-sh="0"></path>
					<path data-sh="1"></path>
					<path data-sh="2"></path>
				</g>
				<circle class="exl__ball" data-ballc r="28"></circle>
				<ellipse class="exl__shine" data-shine rx="7" ry="5"></ellipse>
			</g>
			<path class="exl__ring-band" d={ringBand}></path>
			<path class="exl__ring-front" d={frontRing}></path>
			<!-- the inset: particles of the ball -->
			<rect class="exl__inset" x="248" y="8" width="86" height="96" rx="8"></rect>
			<text class="t-small" x="291" y="23" text-anchor="middle">частицы</text>
			<text class="t-small" x="291" y="36" text-anchor="middle">металла</text>
			<g data-lattice></g>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-heat>Нагреть</button>
				<button type="button" class="g7__btn" data-cool>Остудить</button>
				<button type="button" class="g7__btn" data-lower>Опустить в кольцо</button>
			</div>
			<ul class="g7__read" aria-live="off">
				<li class="is-warm"><span>Температура шара</span><b data-temp>20 °C</b></li>
				<li><span>Диаметр шара</span><b data-dball>25,00 мм</b></li>
				<li><span>Отверстие кольца</span><b>25,05 мм</b></li>
			</ul>
			<p class="g7__msg" data-msg-ring></p>
		</div>
	</div>

	<div class="g7__grid exl__gas" data-part="gas" hidden>
		<svg class="g7__svg" viewBox="0 28 360 104" role="img" aria-label="Шприц с закрытым отверстием, на поршень давят" data-svg-gas>
			<!-- the scale of the syringe, мл -->
			{
				ticks.map((v) => (
					<>
						<line class="exl__tick" x1={X0 + v * PXML} x2={X0 + v * PXML} y1={v % 5 === 0 ? 44 : 49} y2="55" />
						{v % 5 === 0 && (
							<text class="t-small t-num" x={X0 + v * PXML} y="39" text-anchor="middle">
								{v}
							</text>
						)}
					</>
				))
			}
			<text class="t-small" x={X0 + 20 * PXML + 10} y="39">мл</text>
			<!-- the contents and the particles -->
			<rect class="exl__content" data-content x={X0} y="57" width={20 * PXML} height="46"></rect>
			<g data-dots></g>
			<!-- the barrel, the outlet and its cap -->
			<path class="exl__barrel" d={`M${X0} 55 H${X0 + 20 * PXML + 6} M${X0} 105 H${X0 + 20 * PXML + 6} M${X0} 55 V70 M${X0} 90 V105`}></path>
			<path class="exl__barrel" d={`M${X0} 74 H22 M${X0} 86 H22`}></path>
			<rect class="exl__cap" x="10" y="70" width="14" height="20" rx="3"></rect>
			<rect class="exl__flange" x={X0 + 20 * PXML + 6} y="46" width="5" height="68" rx="2"></rect>
			<text class="t-small" x="2" y="126">закрыто</text>
			<!-- the piston, its rod and the push -->
			<g data-piston>
				<rect class="exl__rubber" x="0" y="57" width="8" height="46" rx="2"></rect>
				<rect class="exl__rod" x="8" y="76" width="124" height="8"></rect>
				<rect class="exl__rod" x="132" y="56" width="6" height="48" rx="2"></rect>
				<line class="arrow arrow--red" data-arrow x1="0" x2="0" y1="80" y2="80"></line>
				<path class="head--red" data-arrowhead d="M142 80 l9 -5 v10 Z"></path>
			</g>
			<text class="t-small" data-push-label x="0" y="66" text-anchor="middle"></text>
			<text class="t-small" x={X0 + 10 * PXML} y="126" text-anchor="middle" data-what>воздух</text>
			<text class="t-small" data-piston-label x="0" y="126" text-anchor="middle">поршень</text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Что в шприце" data-fill>
				<button type="button" class="g7__btn" aria-pressed="true" data-f="air">Воздух</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-f="water">Вода</button>
			</div>
			<label class="g7__slider">
				<span>Сила нажатия</span>
				<output data-force-out>нет</output>
				<input type="range" min="0" max="100" step="1" value="0" data-force aria-label="Сила нажатия" />
			</label>
			<ul class="g7__read" aria-live="off">
				<li><span>Объём в начале</span><b>20,00 мл</b></li>
				<li class="is-key"><span data-vname>Объём воздуха</span><b data-vol>20,00 мл</b></li>
			</ul>
			<p class="g7__msg" data-msg-gas></p>
		</div>
	</div>

	<figcaption class="g7__caption" data-cap="ring">
		Разница размеров шара и отверстия на рисунке увеличена в 100 раз: на самом деле нагретый шар вырастает всего на 0,08 мм. Нагрев и остывание, которые длятся минуты, показаны за несколько секунд.
	</figcaption>
	<figcaption class="g7__caption" data-cap="gas" hidden>
		Отверстие шприца закрыто, поэтому ни воздух, ни вода выйти не могут. Частицы нарисованы схематично и сильно увеличенными.
	</figcaption>
</figure>

<style is:global>
	.exl__gas {
		grid-template-columns: minmax(0, 1fr);
	}
	.exl__gas .g7__svg {
		max-width: 40rem;
	}
	.exl__top {
		margin-bottom: 0.75rem;
	}
	.exl [hidden] {
		display: none !important;
	}
	.exl__table {
		stroke: var(--g7-line);
		stroke-width: 1.5;
	}
	.exl__stand {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.exl__ring-back {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.exl__ring-band {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.exl__ring-front {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.exl__ball {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	:root[data-theme='light'] .exl__ball {
		fill: color-mix(in oklab, var(--g7-steel) 40%, var(--sl-color-gray-6));
	}
	/* a pressed button stays readable under the pointer (a tapped button keeps :hover on a phone) */
	.exl__shine {
		fill: var(--sl-color-white);
		opacity: 0.35;
	}
	.exl__chain {
		stroke: var(--g7-ink);
		stroke-width: 2;
		stroke-dasharray: 3 2;
	}
	.exl__shimmer path {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	.exl__lamp {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
		stroke: var(--g7-glass);
		stroke-width: 1.5;
	}
	.exl__spirit {
		fill: color-mix(in srgb, var(--ig-vx) 18%, transparent);
	}
	.exl__neck {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.exl__wick {
		fill: var(--g7-wood-dark);
	}
	.exl__flame-out {
		fill: color-mix(in srgb, var(--g7-gold) 75%, transparent);
	}
	.exl__flame-in {
		fill: color-mix(in srgb, var(--g7-blue) 65%, transparent);
	}
	.exl__inset {
		fill: var(--g7-paper);
		stroke: var(--g7-faint);
		stroke-width: 1;
	}
	.exl__atom {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.exl__tick {
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.exl__barrel {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.exl__cap {
		fill: var(--g7-red);
		opacity: 0.85;
	}
	.exl__flange {
		fill: var(--g7-glass);
	}
	.exl__content {
		fill: transparent;
	}
	.exl__content.is-water {
		fill: var(--g7-water);
	}
	.exl__rubber {
		fill: color-mix(in oklab, var(--g7-ink) 55%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.exl__rod {
		fill: color-mix(in oklab, var(--g7-glass) 60%, transparent);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.exl__air {
		fill: var(--g7-ink);
		opacity: 0.85;
	}
	.exl__h2o {
		fill: var(--g7-blue);
	}
</style>

<script>
	import { el, fmt, fmtTrim, loop, segment, rng } from '../g7/kit';

	// ---- ring and ball -------------------------------------------------------------------------------------------
	const ALPHA = 1.2e-5; // 1/°C, steel
	const D0 = 25.0; // мм at 20 °C
	const HOLE = 25.05; // мм
	const T_HOT = 300;
	const HEAT_RATE = 70; // °C per second of the animation
	const COOL_RATE = 60;
	const dBall = (t: number) => D0 * (1 + ALPHA * (t - 20));
	const dpx = (d: number) => 56 + (d - 25) * 224; // 100 times exaggerated differences
	const RX = 200;
	const RY = 170;
	const RH = dpx(HOLE) / 2;
	const UP = { x: RX, y: 100 };
	const SIDE = { x: 70, y: 100 };
	const LAMP = { x: 70, y: 172 };
	const BELOW = { x: RX, y: 245 };
	type P = { x: number; y: number };
	type Mode = 'up' | 'lamp' | 'rest' | 'down' | 'moving';

	// ---- syringe ---------------------------------------------------------------------------------------------------
	const X0 = 34;
	const PXML = 7;
	const V0 = 20; // мл
	const BETA = 4.6e-10; // 1/Па, water
	const ATM = 101325;
	const Y_TOP = 59;
	const Y_H = 42;
	const FORCE_WORDS = ['нет', 'слабая', 'средняя', 'сильная', 'очень сильная'];

	for (const root of document.querySelectorAll<HTMLElement>('[data-explab]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let exp: 'ring' | 'gas' = 'ring';
		let time = 0;

		// ===== the ball =====
		let T = 20;
		let pos: P = { ...UP };
		let path: P[] = [];
		let speed = 160;
		let mode: Mode = 'up';
		let after: Mode = 'up';
		let heating = false;
		let cooling = false;
		let fellAt = 0;
		const ballG = q<SVGGElement>('[data-ball]');
		const ballC = q<SVGCircleElement>('[data-ballc]');
		const shine = q<SVGEllipseElement>('[data-shine]');
		const chain = q<SVGLineElement>('[data-chain]');
		const sh = [0, 1, 2].map((i) => q<SVGPathElement>(`[data-sh="${i}"]`));
		const shG = q<SVGGElement>('[data-shimmer]');
		const flame = q<SVGPathElement>('[data-flame]');
		const flameIn = q<SVGPathElement>('[data-flame-in]');
		const msgRing = q('[data-msg-ring]');
		const bHeat = q<HTMLButtonElement>('[data-heat]');
		const bCool = q<HTMLButtonElement>('[data-cool]');
		const bLower = q<HTMLButtonElement>('[data-lower]');
		// the inset: 4 × 3 particles of steel
		const lattice = q<SVGGElement>('[data-lattice]');
		const rand = rng(7);
		const atoms = Array.from({ length: 12 }, (_, i) => ({
			i: (i % 4) - 1.5,
			j: Math.floor(i / 4) - 1,
			f: [9 + 5 * rand(), 9 + 5 * rand()],
			ph: [6.3 * rand(), 6.3 * rand()],
			c: lattice.appendChild(el('circle', { class: 'exl__atom', r: 4.5 })),
		}));

		const rBall = () => dpx(dBall(T)) / 2;
		const restY = () => RY - Math.sqrt(Math.max(0, rBall() ** 2 - RH ** 2));
		const go = (pts: P[], then: Mode, v = 160) => {
			path = pts;
			after = then;
			speed = v;
			mode = 'moving';
		};
		const say = (s: string) => (msgRing.textContent = s);
		const buttons = () => {
			const busy = mode === 'moving' || heating;
			bHeat.disabled = busy;
			bCool.disabled = busy || T <= 20;
			bLower.disabled = busy;
			bLower.textContent = mode === 'rest' || mode === 'down' ? 'Поднять' : 'Опустить в кольцо';
		};
		const arrive = () => {
			mode = after;
			if (mode === 'lamp') {
				heating = true;
				say('Шар нагревается в пламени спиртовки…');
			} else if (mode === 'down') {
				say(
					fellAt
						? `Шар остыл примерно до ${Math.round(fellAt / 10) * 10}\u00a0°C, стал меньше отверстия и проскочил через кольцо.`
						: 'Шар меньше отверстия и свободно проходит через кольцо.',
				);
				fellAt = 0;
			} else if (mode === 'rest') {
				say('Горячий шар застрял: он стал больше отверстия кольца. Частицы металла остались прежними — увеличились промежутки между ними.');
			} else if (mode === 'up') {
				if (T >= T_HOT - 0.5) say('Шар нагрет до 300 °C. Опустите его в кольцо.');
				else if (T <= 20) say('Шар и кольцо при комнатной температуре. Опустите шар в кольцо.');
			}
		};
		bHeat.addEventListener('click', () => {
			cooling = false;
			const pts = mode === 'rest' || mode === 'down' ? [UP, SIDE, LAMP] : [SIDE, LAMP];
			go(pts, 'lamp');
			say('Несём шар к спиртовке.');
		});
		bCool.addEventListener('click', () => {
			cooling = true;
			if (mode === 'lamp') go([SIDE, UP], 'up');
			say('Шар остывает…');
		});
		bLower.addEventListener('click', () => {
			if (mode === 'rest' || mode === 'down') {
				go([UP], 'up');
				say('Поднимаем шар.');
				return;
			}
			if (dBall(T) < HOLE) go([BELOW], 'down');
			else go([{ x: RX, y: restY() }], 'rest');
		});

		const drawBall = () => {
			const r = rBall();
			ballC.setAttribute('cx', String(pos.x));
			ballC.setAttribute('cy', String(pos.y));
			ballC.setAttribute('r', String(r));
			shine.setAttribute('cx', String(pos.x - r * 0.38));
			shine.setAttribute('cy', String(pos.y - r * 0.4));
			const top = pos.y - r;
			chain.setAttribute('x1', String(pos.x));
			chain.setAttribute('x2', String(pos.x));
			chain.setAttribute('y1', String(top));
			chain.setAttribute('y2', '0');
			// a heat shimmer above a hot ball (steel at 300 °C does not glow)
			const w = Math.min(1, Math.max(0, (T - 100) / 160));
			shG.style.opacity = String(0.75 * w);
			if (w > 0)
				sh.forEach((p, i) => {
					const x = pos.x - 12 + 12 * i;
					const rise = ((time * 18 + i * 9) % 26) - 4;
					const y0 = top - 4 - rise;
					let d = `M${x} ${y0}`;
					for (let k = 1; k <= 6; k++) d += ` L${(x + 2.5 * Math.sin(time * 7 + k * 1.3 + i)).toFixed(1)} ${(y0 - k * 4).toFixed(1)}`;
					p.setAttribute('d', d);
				});
			// the lamp's flame flickers
			const h = 30 + 3 * Math.sin(time * 11) + 2 * Math.sin(time * 17.3);
			const sx = 1.5 * Math.sin(time * 6.1);
			flame.setAttribute('d', `M70 241 C58 238 61 ${231 - h * 0.4} ${70 + sx} ${231 - h} C79 ${231 - h * 0.4} 82 238 70 241 Z`);
			flameIn.setAttribute('d', `M70 240 C65 238 65.5 ${233 - h * 0.18} ${70 + sx * 0.5} ${231 - h * 0.42} C74.5 ${233 - h * 0.18} 75 238 70 240 Z`);
			// the inset: spacing grows by 0,34 % at 300 °C, drawn 100 times larger; the particles shake harder
			const u = (T - 20) / 280;
			const s = 14 * (1 + (dBall(T) / D0 - 1) * 100);
			const a = 0.5 + 1.8 * u;
			for (const at of atoms) {
				at.c.setAttribute('cx', (291 + at.i * s + a * Math.sin(time * at.f[0] + at.ph[0])).toFixed(2));
				at.c.setAttribute('cy', (70 + at.j * s + a * Math.sin(time * at.f[1] + at.ph[1])).toFixed(2));
			}
			q('[data-temp]').textContent = `${fmt(T, 0)}\u00a0°C`;
			q('[data-dball]').textContent = `${fmt(dBall(T), 2)}\u00a0мм`;
		};

		const stepRing = (dt: number) => {
			if (heating) {
				T = Math.min(T_HOT, T + HEAT_RATE * dt);
				if (T >= T_HOT) {
					heating = false;
					go([SIDE, UP], 'up');
					say('Шар нагрет. Несём его обратно к кольцу.');
				}
			}
			if (cooling) {
				T = Math.max(20, T - COOL_RATE * dt);
				if (T <= 20) {
					cooling = false;
					if (mode === 'up') say('Шар остыл до комнатной температуры.');
				}
			}
			if (mode === 'rest') {
				pos.y = restY();
				if (dBall(T) < HOLE) {
					fellAt = T;
					go([BELOW], 'down', 220);
				}
			}
			while (mode === 'moving' && dt > 0) {
				const tgt = path[0];
				const dx = tgt.x - pos.x;
				const dy = tgt.y - pos.y;
				const L = Math.hypot(dx, dy);
				const stepLen = speed * dt;
				if (L <= stepLen) {
					pos = { ...tgt };
					dt -= L / speed;
					path.shift();
					if (!path.length) arrive();
				} else {
					pos = { x: pos.x + (dx / L) * stepLen, y: pos.y + (dy / L) * stepLen };
					dt = 0;
				}
			}
			drawBall();
			buttons();
		};

		// ===== the syringe =====
		let filled: 'air' | 'water' = 'air';
		let push = 0; // 0…1
		let vShown = V0;
		const dotsG = q<SVGGElement>('[data-dots]');
		const content = q<SVGRectElement>('[data-content]');
		const piston = q<SVGGElement>('[data-piston]');
		const arrow = q<SVGLineElement>('[data-arrow]');
		const arrowHead = q<SVGPathElement>('[data-arrowhead]');
		const pushLabel = q<SVGTextElement>('[data-push-label]');
		const pistonLabel = q<SVGTextElement>('[data-piston-label]');
		const msgGas = q('[data-msg-gas]');
		const slider = q<HTMLInputElement>('[data-force]');
		const r2 = rng(11);
		// air: 30 particles moving at random; u, v are positions in the column (0…1)
		const air = Array.from({ length: 30 }, () => {
			const ang = 6.283 * r2();
			const sp = 22 + 18 * r2();
			return { u: r2(), v: r2(), vx: sp * Math.cos(ang), vy: sp * Math.sin(ang), c: el('circle', { class: 'exl__air', r: 2.3 }) };
		});
		// water: closely packed particles that only tremble in place
		const water: { u: number; y: number; f: number; ph: number; c: SVGCircleElement }[] = [];
		const STEP = 4.9;
		for (let row = 0; row < 9; row++)
			for (let col = 0; col < 28; col++) {
				const x = 2.6 + col * STEP + (row % 2 ? STEP / 2 : 0) + (r2() - 0.5) * 1.6;
				if (x > V0 * PXML - 2.4) continue;
				water.push({ u: x / (V0 * PXML), y: Y_TOP + 2.4 + row * 4.55 + (r2() - 0.5) * 1.2, f: 7 + 6 * r2(), ph: 6.3 * r2(), c: el('circle', { class: 'exl__h2o', r: 2.3 }) });
			}
		const pAtm = () => 1 + 2 * push;
		const vTarget = () => (filled === 'air' ? V0 / pAtm() : V0 * (1 - BETA * (pAtm() - 1) * ATM));
		const fillDots = () => {
			dotsG.replaceChildren(...(filled === 'air' ? air : water).map((d) => d.c));
			content.classList.toggle('is-water', filled === 'water');
			q('[data-what]').textContent = filled === 'air' ? 'воздух' : 'вода';
			q('[data-vname]').textContent = filled === 'air' ? 'Объём воздуха' : 'Объём воды';
		};
		const sayGas = () => {
			const v = vTarget();
			const word = FORCE_WORDS[push === 0 ? 0 : Math.min(4, 1 + Math.floor(push * 3.999))];
			q('[data-force-out]').textContent = word;
			if (push === 0)
				msgGas.textContent = filled === 'air' ? 'В шприце 20\u00a0мл воздуха, отверстие закрыто. Надавите на поршень.' : 'В шприце 20\u00a0мл воды, отверстие закрыто. Надавите на поршень.';
			else if (filled === 'air')
				msgGas.textContent = `Воздух сжался до ${fmt(v, 2)}\u00a0мл${V0 / v >= 1.05 ? ` — в ${fmtTrim(V0 / v, 1)} раза` : ''}. Частицы воздуха сблизились: промежутки между ними уменьшились.`;
			else
				msgGas.textContent = `Поршень почти не сдвинулся: объём воды уменьшился всего на ${fmt(V0 - v, 4)}\u00a0мл. Частицы воды и так расположены почти вплотную друг к другу.`;
		};
		const stepGas = (dt: number) => {
			// the piston follows the push smoothly
			vShown += (vTarget() - vShown) * Math.min(1, dt * 6);
			const len = vShown * PXML;
			const xp = X0 + len;
			piston.setAttribute('transform', `translate(${xp.toFixed(2)} 0)`);
			content.setAttribute('width', len.toFixed(2));
			const aLen = push > 0 ? 8 + 18 * push : 0;
			arrow.setAttribute('x1', '151');
			arrow.setAttribute('x2', String(151 + aLen));
			arrow.style.opacity = arrowHead.style.opacity = push > 0 ? '1' : '0';
			pushLabel.textContent = push > 0 ? 'давим' : '';
			pushLabel.setAttribute('x', String(xp + 151 + aLen / 2));
			pushLabel.setAttribute('y', '66');
			q('[data-what]').setAttribute('x', String(Math.max(80, X0 + len / 2)));
			pistonLabel.setAttribute('x', String(xp + 70));
			q('[data-vol]').textContent = `${fmt(vTarget(), 2)} мл`;
			if (filled === 'air')
				for (const d of air) {
					d.u += (d.vx * dt) / len;
					d.v += (d.vy * dt) / Y_H;
					if (d.u < 0) (d.u = -d.u), (d.vx = Math.abs(d.vx));
					if (d.u > 1) (d.u = 2 - d.u), (d.vx = -Math.abs(d.vx));
					if (d.v < 0) (d.v = -d.v), (d.vy = Math.abs(d.vy));
					if (d.v > 1) (d.v = 2 - d.v), (d.vy = -Math.abs(d.vy));
					d.c.setAttribute('cx', (X0 + 2.6 + d.u * (len - 5.2)).toFixed(2));
					d.c.setAttribute('cy', (Y_TOP + d.v * Y_H).toFixed(2));
				}
			else
				for (const d of water) {
					d.c.setAttribute('cx', (X0 + d.u * len + 0.6 * Math.sin(time * d.f + d.ph)).toFixed(2));
					d.c.setAttribute('cy', (d.y + 0.6 * Math.sin(time * d.f * 1.3 + d.ph * 2)).toFixed(2));
				}
		};
		segment(q('[data-fill]'), (b) => {
			filled = b.dataset.f as 'air' | 'water';
			vShown = vTarget();
			fillDots();
			sayGas();
		});
		slider.addEventListener('input', () => {
			push = Number(slider.value) / 100;
			sayGas();
		});

		// ===== the switch of the experiments =====
		const show = () => {
			for (const p of root.querySelectorAll<HTMLElement>('[data-part]')) p.hidden = p.dataset.part !== exp;
			for (const c of root.querySelectorAll<HTMLElement>('[data-cap]')) c.hidden = c.dataset.cap !== exp;
		};
		const wake = loop(root, (dt) => {
			time += dt;
			if (exp === 'ring') stepRing(dt);
			else stepGas(dt);
			return true;
		});
		segment(q('[data-exp]'), (b) => {
			exp = b.dataset.e as 'ring' | 'gas';
			show();
			wake();
		});
		fillDots();
		sayGas();
		say('Шар и кольцо при комнатной температуре. Опустите шар в кольцо.');
		show();
		drawBall();
		buttons();
	}
</script>
