---
/**
 * Two short looping opening scenes of «Молекулы. Диффузия». No terms of the chapter in the pictures.
 * Scent: a bottle of perfume is opened in one corner of a room; the scent (70 dots, each on its own random walk
 *   with reflecting walls, a fixed seed) spreads and reaches a person at the other side. The dots only show where
 *   the scent is: the real molecules are far too small to see.
 * Tea: two glasses of water, cold and hot, with a tea bag in each. The colored cloud around the bag grows as the
 *   square root of the time, as diffusion does, three times faster in the hot water; the clock runs to three minutes.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const glass = (x: number) => `M${x} 60 L${x + 6} 204 H${x + 94} L${x + 100} 60 Z`;
---

<KitStyles />
<IntroFrame data-molintro>
	<div class="intro__card" data-scene="scent">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="В одном углу комнаты открывают флакон духов. Запах постепенно распространяется и доходит до человека в другом конце комнаты">
			<rect class="mi-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="mi-floor" x="0" y="206" width="360" height="34"></rect>
			<!-- the table and the bottle -->
			<path class="mi-table" d="M14 168 H92 V174 H14 Z M22 174 V206 M84 174 V206"></path>
			<path class="mi-bottle" d="M44 168 V146 q0 -6 6 -6 h4 v-8 h8 v8 h4 q6 0 6 6 V168 Z"></path>
			<rect class="mi-cap" data-cap x="52" y="122" width="12" height="9" rx="2"></rect>
			<!-- the person (the shared people kit, 1,75 м at the scale of the table), facing the bottle -->
			<g data-person></g>
			<path class="mi-sniff" data-sniff d="M300 124 q-5 -5 0 -10 M293 128 q-7 -8 0 -16"></path>
			<g data-dots></g>
			<text class="mi-label" x="180" y="26" text-anchor="middle" data-note></text>
		</svg>
		<div class="intro__foot">
			<p>
				Флакон духов открыли в одном углу комнаты, а запах через некоторое время чувствуется в другом:{' '}
				<More term="молекулы духов сами расходятся по комнате">
					Молекулы летают со скоростью в сотни метров в секунду, но запах идёт медленно: молекула духов то и дело сталкивается с молекулами воздуха и меняет направление. В комнате запаху помогают и потоки воздуха. Точки на рисунке лишь показывают, куда дошёл запах: сами молекулы увидеть нельзя. Об этом — в разделе{' '}
					<a href="#диффузия">«Диффузия»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="tea">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Два стакана с пакетиками чая. В горячей воде вода окрашивается быстро, в холодной медленно">
			<defs>
				<radialGradient id={`mi-tea-${uid}`}>
					<stop offset="0" stop-color="hsl(24, 75%, 30%)" stop-opacity="0.95"></stop>
					<stop offset="0.6" stop-color="hsl(26, 75%, 36%)" stop-opacity="0.7"></stop>
					<stop offset="1" stop-color="hsl(28, 75%, 40%)" stop-opacity="0"></stop>
				</radialGradient>
				<clipPath id={`mi-c1-${uid}`}><path d="M43 78 L48 202 H132 L137 78 Z"></path></clipPath>
				<clipPath id={`mi-c2-${uid}`}><path d="M223 78 L228 202 H312 L317 78 Z"></path></clipPath>
			</defs>
			<rect class="mi-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="mi-floor" x="0" y="206" width="360" height="34"></rect>
			{
				[
					[40, `mi-c1-${uid}`, 'cold'],
					[220, `mi-c2-${uid}`, 'hot'],
				].map(([x, clip, key]) => (
					<g>
						<path class="mi-water" d={`M${Number(x) + 3} 78 L${Number(x) + 8} 202 H${Number(x) + 92} L${Number(x) + 97} 78 Z`} />
						<g clip-path={`url(#${clip})`}>
							<rect class="mi-teafill" data-fill={key} x={Number(x)} y="78" width="100" height="126" />
							<circle data-cloud={key} cx={Number(x) + 50} cy="150" r="0" fill={`url(#mi-tea-${uid})`} />
						</g>
						<path class="mi-glass" d={glass(Number(x))} />
						<line class="mi-string" x1={Number(x) + 50} y1="52" x2={Number(x) + 50} y2="138" />
						<rect class="mi-tag" x={Number(x) + 42} y="40" width="16" height="12" rx="2" />
						<rect class="mi-bag" x={Number(x) + 38} y="138" width="24" height="26" rx="3" />
					</g>
				))
			}
			<path class="mi-steam" d="M246 52 q-6 -8 0 -16 q6 -8 0 -16 M296 52 q-6 -8 0 -16 q6 -8 0 -16"></path>
			<text class="mi-label" x="90" y="226" text-anchor="middle">холодная вода</text>
			<text class="mi-label" x="270" y="226" text-anchor="middle">горячая вода</text>
			<text class="mi-clock" x="180" y="30" text-anchor="middle" data-clock>0 мин</text>
		</svg>
		<div class="intro__foot">
			<p>
				Пакетики с чаем опустили в холодную и в горячую воду и не размешивали. Горячая вода{' '}
				<More term="окрасилась намного быстрее">
					Частицы заварки сами расходятся между частицами воды: и те и другие всё время беспорядочно движутся. В горячей воде частицы движутся быстрее, поэтому и перемешиваются быстрее. Об этом — в разделе{' '}
					<a href="#диффузия">«Диффузия»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-molintro] .mi-room {
		fill: var(--sl-color-bg);
	}
	[data-molintro] .mi-floor {
		fill: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-gray-5));
	}
	[data-molintro] .mi-table {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-3));
		stroke-width: 3;
	}
	[data-molintro] .mi-bottle {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-6));
		stroke: var(--ig-vy);
		stroke-width: 1.2;
	}
	[data-molintro] .mi-cap {
		fill: var(--ig-v);
	}
	[data-molintro] .mi-sniff {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0;
	}
	[data-molintro] .mi-dot {
		fill: var(--ig-vy);
		opacity: 0.75;
	}
	[data-molintro] .mi-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-molintro] .mi-clock {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-molintro] .mi-water {
		fill: color-mix(in srgb, var(--ig-vx) 22%, transparent);
	}
	[data-molintro] .mi-teafill {
		fill: hsl(28, 75%, 40%);
		opacity: 0;
	}
	[data-molintro] .mi-glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	[data-molintro] .mi-string {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-molintro] .mi-tag {
		fill: var(--ig-v);
	}
	[data-molintro] .mi-bag {
		fill: hsl(34, 40%, 72%);
		stroke: hsl(30, 40%, 40%);
		stroke-width: 1;
	}
	[data-molintro] .mi-steam {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0.7;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure } from '@components/people/body';

	const NS = 'http://www.w3.org/2000/svg';
	for (const root of document.querySelectorAll<HTMLElement>('[data-molintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="scent"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const holder = $<SVGGElement>('[data-dots]');
			const cap = $<SVGRectElement>('[data-cap]');
			const sniff = $<SVGPathElement>('[data-sniff]');
			// the person: 1,75 м drawn 96 px, standing on the floor (y = 206) at x = 318, facing left, the arms hanging
			{
				const S = 96 / 175;
				const fig = figure($<SVGGElement>('[data-person]'), { s: S, H: 175, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', dir: -1, name: 'person' });
				const ank = 206 - 7 * S;
				fig.pose({
					hip: { x: 320, y: 206 - 0.515 * 96 },
					lean: 0,
					ankles: [
						{ x: 317, y: ank },
						{ x: 322, y: ank },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ arm: [Math.PI / 2 - 0.05, 0.2], pose: 'relaxed' },
						{ arm: [Math.PI / 2 + 0.05, 0.25], pose: 'relaxed' },
					],
				});
			}
			const note = $<SVGTextElement>('[data-note]');
			// 70 random walks from the mouth of the bottle, the same every time (a fixed seed)
			let seed = 4;
			const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
			const STEPS = 220;
			const N = 70;
			const walks: Float32Array[] = [];
			let arrive = STEPS;
			for (let k = 0; k < N; k++) {
				const w = new Float32Array(2 * (STEPS + 1));
				let x = 58;
				let y = 128;
				const start = Math.floor(rnd() * 50); // the molecules leave the bottle one after another
				for (let s = 0; s <= STEPS; s++) {
					w[2 * s] = x;
					w[2 * s + 1] = y;
					if (s < start) continue;
					const a = rnd() * Math.PI * 2;
					x += 13 * Math.cos(a);
					y += 13 * Math.sin(a);
					if (x < 6) x = 12 - x;
					if (x > 354) x = 708 - x;
					if (y < 6) y = 12 - y;
					if (y > 200) y = 400 - y;
					if (Math.hypot(x - 292, y - 121) < 16 && s < arrive) arrive = s;
				}
				walks.push(w);
				const c = document.createElementNS(NS, 'circle');
				c.setAttribute('class', 'mi-dot');
				c.setAttribute('r', '2.6');
				holder.append(c);
			}
			const dots = [...holder.children] as SVGCircleElement[];
			scene(card, 9, (x) => {
				const f = Math.min(STEPS, x * STEPS);
				const s = Math.floor(f);
				const u = f - s;
				cap.setAttribute('transform', `translate(${x > 0.02 ? 16 : 0} ${x > 0.02 ? -6 : 0}) rotate(${x > 0.02 ? 30 : 0} 58 126)`);
				dots.forEach((d, k) => {
					const w = walks[k];
					const s2 = Math.min(STEPS, s + 1);
					d.setAttribute('cx', (w[2 * s] + (w[2 * s2] - w[2 * s]) * u).toFixed(1));
					d.setAttribute('cy', (w[2 * s + 1] + (w[2 * s2 + 1] - w[2 * s + 1]) * u).toFixed(1));
					d.style.opacity = x > 0.02 ? '0.75' : '0';
				});
				const got = f >= arrive;
				sniff.style.opacity = got ? '1' : '0';
				note.textContent = got ? 'запах дошёл' : x > 0.02 ? 'флакон открыт' : '';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="tea"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const cloud = { cold: $<SVGCircleElement>('[data-cloud="cold"]'), hot: $<SVGCircleElement>('[data-cloud="hot"]') };
			const fill = { cold: $<SVGRectElement>('[data-fill="cold"]'), hot: $<SVGRectElement>('[data-fill="hot"]') };
			const clock = $<SVGTextElement>('[data-clock]');
			scene(card, 8, (x) => {
				const min = 3 * x; // minutes
				// the cloud's radius grows as the square root of the time; in hot water three times faster
				for (const [key, k] of [['cold', 26], ['hot', 78]] as const) {
					const r = k * Math.sqrt(min);
					cloud[key].setAttribute('r', r.toFixed(1));
					// when the cloud has outgrown the glass, the whole water is colored
					fill[key].style.opacity = String(Math.min(0.85, Math.max(0, (r - 70) / 70)));
				}
				clock.textContent = `${Math.floor(min)} мин ${String(Math.floor((min % 1) * 60)).padStart(2, '0')} с`;
			});
		}
	}
</script>
