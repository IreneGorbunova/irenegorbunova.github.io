---
/**
 * Picture «Вода — молекулы — атомы» (Irina, 17 Nov 2026: «вода — вещество, она состоит из молекул, а молекулы из
 * атомов… схематично с последовательным открыванием каждого пункта»). Three steps opened one by one with «Дальше»:
 * a glass of water; a magnified drop where identical water molecules jostle; one molecule with its three atoms, an
 * oxygen atom and two hydrogen atoms at 104,5°. A scheme: the sizes are not to scale (the molecules are magnified tens
 * of millions of times; the true model of the molecule is in the picture below). The atoms keep the colors of that
 * picture: oxygen red, hydrogen light.
 */
import G7Styles from '../g7/G7Styles.astro';

const A = ((104.5 / 2) * Math.PI) / 180;
// one water molecule at the origin, pointing down: the oxygen atom and two hydrogen atoms
const mol = (k: number) => ({
	o: 7 * k,
	h: 5 * k,
	hx: 8 * k * Math.sin(A),
	hy: 8 * k * Math.cos(A),
});
const m2 = mol(0.72);
const m3 = mol(2.6);
// the molecules in the magnifier: a close packing, as in a liquid
const spots: [number, number, number][] = [];
for (let r = -2; r <= 2; r++)
	for (let c = -2; c <= 2; c++) {
		const x = c * 17 + (r % 2 ? 8.5 : 0);
		const y = r * 16;
		if (x * x + y * y < 40 * 40) spots.push([180 + x, 74 + y, (r * 53 + c * 97) % 360]);
	}
const STEPS = [
	'Вода — вещество.',
	'Вода состоит из молекул. Все молекулы воды одинаковы, и они непрерывно движутся.',
	'Молекула воды состоит из трёх атомов: одного атома кислорода и двух атомов водорода.',
];
---

<G7Styles />
<figure class="g7 g7--stack wch not-content" data-wchain>
	<svg class="g7__svg" viewBox="0 0 360 160" role="img" aria-label="Вода состоит из молекул, а молекула воды — из одного атома кислорода и двух атомов водорода">
		<g data-step="1">
			<text class="t-title" x="60" y="18" text-anchor="middle">1. Вещество</text>
			<path class="wch__water" d="M32 66 H88 L84 134 Q84 140 78 140 H42 Q36 140 36 134 Z"></path>
			<path class="wch__glass" d="M28 40 L36 134 Q36 140 42 140 H78 Q84 140 84 134 L92 40"></path>
			<path class="wch__surf" d="M32 66 H88"></path>
			<circle class="wch__spot" cx="62" cy="104" r="5"></circle>
			<text class="t-small" x="60" y="155" text-anchor="middle">вода</text>
		</g>
		<g data-step="2">
			<path class="wch__zoom" d="M66 100 L140 46 M66 108 L140 104"></path>
			<text class="t-title" x="180" y="18" text-anchor="middle">2. Молекулы</text>
			<circle class="wch__lens" cx="180" cy="74" r="44"></circle>
			<clipPath id="wch-clip"><circle cx="180" cy="74" r="42"></circle></clipPath>
			<g clip-path="url(#wch-clip)">
				{
					spots.map(([x, y, a]) => (
						<g class="wch__mol" data-mol transform={`translate(${x} ${y}) rotate(${a})`} data-x={x} data-y={y} data-a={a}>
							<circle class="wch__h" cx={-m2.hx} cy={m2.hy} r={m2.h} />
							<circle class="wch__h" cx={m2.hx} cy={m2.hy} r={m2.h} />
							<circle class="wch__o" r={m2.o} />
						</g>
					))
				}
			</g>
			<circle class="wch__mark" cx="180" cy="74" r="13"></circle>
			<text class="t-small" x="180" y="135" text-anchor="middle">молекулы воды</text>
		</g>
		<g data-step="3">
			<path class="wch__zoom" d="M193 67 L274 60 M193 81 L274 86"></path>
			<text class="t-title" x="300" y="18" text-anchor="middle">3. Атомы</text>
			<g transform="translate(300 72)">
				<circle class="wch__h" cx={-m3.hx} cy={m3.hy} r={m3.h}></circle>
				<circle class="wch__h" cx={m3.hx} cy={m3.hy} r={m3.h}></circle>
				<circle class="wch__o" r={m3.o}></circle>
			</g>
			<text class="t-small" x="300" y="44" text-anchor="middle">атом кислорода</text>
			<text class="t-small" x="300" y="128" text-anchor="middle">два атома водорода</text>
		</g>
	</svg>
	<ol class="wch__steps" data-steps>
		{STEPS.map((t, i) => <li data-item={i + 1}>{t}</li>)}
	</ol>
	<div class="g7__row">
		<button type="button" class="g7__btn g7__btn--go" data-next>Дальше</button>
		<button type="button" class="g7__btn" data-first>Сначала</button>
	</div>
	<figcaption class="g7__caption">Схема: молекулы и атомы увеличены в десятки миллионов раз. Модели молекул воды, кислорода и водорода в верном масштабе — на рисунке ниже.</figcaption>
</figure>

<style is:global>
	.wch [data-step] {
		transition: opacity 0.6s;
	}
	.wch [data-step].is-closed {
		opacity: 0;
	}
	.wch__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.wch__water {
		fill: var(--g7-water);
	}
	.wch__surf {
		stroke: var(--g7-water-edge);
		stroke-width: 1.5;
	}
	.wch__spot,
	.wch__mark {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
	}
	.wch__zoom {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.wch__lens {
		fill: var(--g7-water);
		stroke: var(--g7-gold);
		stroke-width: 2.4;
	}
	.wch__o {
		fill: var(--ig-vy);
		stroke: color-mix(in oklab, var(--ig-vy) 60%, black);
		stroke-width: 0.8;
	}
	.wch__h {
		fill: hsl(220, 30%, 88%);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.wch__steps {
		margin: 0.6rem 0 0.4rem;
		padding-left: 1.4rem;
	}
	.wch__steps li {
		transition: opacity 0.6s;
	}
	.wch__steps li.is-closed {
		opacity: 0;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-wchain]')) {
		const steps = [...root.querySelectorAll<SVGGElement>('[data-step]')];
		const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const mols = [...root.querySelectorAll<SVGGElement>('[data-mol]')].map((g, i) => ({
			g,
			x: Number(g.dataset.x),
			y: Number(g.dataset.y),
			a: Number(g.dataset.a),
			f: 1.3 + (i % 5) * 0.37, // each molecule jostles at its own pace
			p: i * 1.7,
		}));
		let open = 1;
		const show = () => {
			steps.forEach((s, i) => s.classList.toggle('is-closed', i >= open));
			items.forEach((s, i) => s.classList.toggle('is-closed', i >= open));
			next.disabled = open >= steps.length;
		};
		next.addEventListener('click', () => {
			open = Math.min(steps.length, open + 1);
			show();
		});
		root.querySelector('[data-first]')!.addEventListener('click', () => {
			open = 1;
			show();
		});
		show();
		// the molecules in the drop never stand still
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			for (const m of mols) {
				const dx = 1.6 * Math.sin(m.f * t + m.p);
				const dy = 1.6 * Math.cos(0.8 * m.f * t + 2 * m.p);
				const da = 14 * Math.sin(0.6 * m.f * t + m.p);
				m.g.setAttribute('transform', `translate(${(m.x + dx).toFixed(1)} ${(m.y + dy).toFixed(1)}) rotate(${(m.a + da).toFixed(0)})`);
			}
			return true;
		})();
	}
</script>
