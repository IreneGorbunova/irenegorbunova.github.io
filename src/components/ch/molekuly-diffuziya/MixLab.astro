---
/**
 * «Вода и спирт»: 50 мл of water and 50 мл of spirit are poured into one measuring cylinder: the mixture takes
 * 97 мл, not 100 (for ethanol and water at room temperature the loss is about 3 %). The second pair, peas and
 * millet, shows why: the small grains fill the gaps between the large ones (about 90 мл from 50 + 50; the exact
 * number depends on the grains). The scales are to scale: 1,5 px per millilitre.
 */
import G7Styles from '../g7/G7Styles.astro';

const ml = (v: number) => 196 - v * 1.5;
const CYL = [
	{ x: 30, key: 'a' },
	{ x: 130, key: 'b' },
	{ x: 240, key: 'c' },
];
---

<G7Styles />
<figure class="g7 g7--stack mix not-content" data-mixlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 230" role="img" aria-label="Три мензурки: в двух по 50 миллилитров, в третью сливают оба вещества" data-svg>
			{
				CYL.map((c) => (
					<g>
						<rect class="mix__fill" data-fill={c.key} x={c.x} width="60" y={ml(0)} height="0" />
						<rect class="mix__fill mix__fill--top" data-fill2={c.key} x={c.x} width="60" y={ml(0)} height="0" />
						<path class="mix__glass" d={`M${c.x} 30 V${ml(0) + 6} H${c.x + 60} V30 M${c.x - 10} ${ml(0) + 12} H${c.x + 70} L${c.x + 60} ${ml(0) + 6} H${c.x} Z`} />
						{Array.from({ length: 11 }, (_, i) => i * 10).map((v) => (
							<>
								<line class="mix__tick" x1={c.x} x2={c.x + (v % 50 === 0 ? 18 : 10)} y1={ml(v)} y2={ml(v)} />
								{v % 50 === 0 && (
									<text class="t-small t-num" x={c.x - 5} y={ml(v) + 4} text-anchor="end">
										{v}
									</text>
								)}
							</>
						))}
						<text class="t-strong t-num" x={c.x + 30} y="22" text-anchor="middle" data-read={c.key} />
						<text class="t-small" x={c.x + 30} y="224" text-anchor="middle" data-name={c.key} />
					</g>
				))
			}
			<path class="mix__want" d={`M240 ${ml(100)} H300`}></path>
			<text class="t-small t-red" x="304" y={ml(100) + 4}>100</text>
			<text class="t-title" x="107" y="120" text-anchor="middle">+</text>
			<text class="t-title" x="215" y="120" text-anchor="middle">→</text>
		</svg>
		<div class="g7__side mix__side">
			<div class="g7__seg" role="group" aria-label="Что смешиваем" data-pair>
				<button type="button" class="g7__btn" aria-pressed="true" data-p="liquid">Вода и спирт</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-p="grain">Горох и пшено</button>
			</div>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Смешать</button>
				<button type="button" class="g7__btn" data-reset>Разделить снова</button>
			</div>
			<p class="g7__msg" data-msg></p>
		</div>
	</div>
</figure>

<style is:global>
	.mix__side {
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
	}
	.mix__side .g7__msg {
		grid-column: 1 / -1;
	}
	.mix__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.mix__tick {
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.mix__fill {
		fill: var(--g7-water);
	}
	.mix__want {
		stroke: var(--g7-red);
		stroke-width: 1.5;
		stroke-dasharray: 4 3;
	}
	@container (max-width: 36rem) {
		.mix__side {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { ease, fmt, loop, segment } from '../g7/kit';

	const ml = (v: number) => 196 - v * 1.5;
	const PAIR = {
		liquid: {
			a: 'вода',
			b: 'спирт',
			c: 'смесь',
			total: 97,
			ca: 'color-mix(in srgb, var(--ig-vx) 34%, transparent)',
			cb: 'color-mix(in srgb, var(--ig-v) 26%, transparent)',
			cc: 'color-mix(in srgb, var(--ig-vx) 24%, color-mix(in srgb, var(--ig-v) 14%, transparent))',
			start: 'В первой мензурке 50 мл воды, во второй — 50 мл спирта. Сколько получится вместе?',
			end: 'Получилось 97 мл, а не 100: три миллилитра «исчезли». Молекулы воды и спирта разместились в промежутках друг между другом.',
		},
		grain: {
			a: 'горох',
			b: 'пшено',
			c: 'смесь',
			total: 90,
			ca: 'hsl(95, 45%, 50%)',
			cb: 'hsl(45, 80%, 60%)',
			cc: 'hsl(70, 55%, 54%)',
			start: 'В первой мензурке 50 мл гороха, во второй — 50 мл пшена. Сколько получится, если их перемешать?',
			end: 'Получилось около 90 мл: мелкое пшено заняло промежутки между горошинами. С молекулами воды и спирта происходит то же самое.',
		},
	} as const;
	for (const root of document.querySelectorAll<HTMLElement>("[data-mixlab]")) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let pair: keyof typeof PAIR = 'liquid';
		let t = -1;
		const show = (u: number) => {
			const P = PAIR[pair];
			const e = ease(u);
			const levels = { a: 50 * (1 - e), b: 50 * (1 - e), c: P.total * e };
			for (const key of ['a', 'b', 'c'] as const) {
				const f = q<SVGRectElement>(`[data-fill="${key}"]`);
				f.setAttribute('y', String(ml(levels[key])));
				f.setAttribute('height', String(levels[key] * 1.5 + (levels[key] > 0 ? 6 : 0)));
				f.style.fill = P[`c${key}` as 'ca'];
				q(`[data-read="${key}"]`).textContent = u <= 0 || u >= 1 ? `${fmt(levels[key], 0)} мл` : '';
				q(`[data-name="${key}"]`).textContent = P[key];
			}
			q('[data-msg]').textContent = u >= 1 ? P.end : P.start;
		};
		const wake = loop(root, (dt) => {
			if (t < 0) return false;
			t += dt;
			show(t / 2);
			return t < 2.1;
		});
		q('[data-go]').addEventListener('click', () => {
			t = 0;
			wake();
		});
		q('[data-reset]').addEventListener('click', () => {
			t = -1;
			show(0);
		});
		segment(q('[data-pair]'), (b) => {
			pair = b.dataset.p as keyof typeof PAIR;
			t = -1;
			show(0);
		});
		show(0);
	}
</script>
