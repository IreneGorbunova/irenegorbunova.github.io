---
/**
 * Picture «Молекулы и атомы»: models of the molecules of water (an oxygen atom and two hydrogen atoms at an angle of
 * 104,5°), oxygen and hydrogen (two atoms each). The atoms are drawn as balls of their van der Waals radii
 * (O 152 пм, H 120 пм) at the real distances between their centres (O–H 96 пм, O=O 121 пм, H–H 74 пм): 0,13 px
 * per picometer, the same scale in all three panels.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 0.13;
const rO = 152 * K;
const rH = 120 * K;
const a = ((104.5 / 2) * Math.PI) / 180;
const hx = 96 * K * Math.sin(a);
const hy = 96 * K * Math.cos(a);
---

<G7Styles />
<figure class="g7 g7--pic molp not-content">
	<div class="g7__grid is-three">
		<svg class="g7__svg" viewBox="0 0 150 120" role="img" aria-label="Молекула воды: атом кислорода и два атома водорода">
			<circle class="molp__h" cx={75 - hx} cy={52 + hy} r={rH}></circle>
			<circle class="molp__h" cx={75 + hx} cy={52 + hy} r={rH}></circle>
			<circle class="molp__o" cx="75" cy="52" r={rO}></circle>
			<text class="t-title" x="75" y="104" text-anchor="middle">вода</text>
			<text class="t-small" x="75" y="116" text-anchor="middle">кислород и два водорода</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 150 120" role="img" aria-label="Молекула кислорода: два атома кислорода">
			<circle class="molp__o" cx={75 - 60.5 * K} cy="52" r={rO}></circle>
			<circle class="molp__o" cx={75 + 60.5 * K} cy="52" r={rO}></circle>
			<text class="t-title" x="75" y="104" text-anchor="middle">кислород</text>
			<text class="t-small" x="75" y="116" text-anchor="middle">два атома кислорода</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 150 120" role="img" aria-label="Молекула водорода: два атома водорода">
			<circle class="molp__h" cx={75 - 37 * K} cy="52" r={rH}></circle>
			<circle class="molp__h" cx={75 + 37 * K} cy="52" r={rH}></circle>
			<text class="t-title" x="75" y="104" text-anchor="middle">водород</text>
			<text class="t-small" x="75" y="116" text-anchor="middle">два атома водорода</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Модели молекул. Атомы кислорода закрашены красным, атомы водорода — светлым. Все три молекулы нарисованы в одном масштабе, увеличенными в десятки миллионов раз.</figcaption>
</figure>

<style is:global>
	.molp__o {
		fill: var(--ig-vy);
		stroke: color-mix(in oklab, var(--ig-vy) 60%, black);
		stroke-width: 1;
	}
	.molp__h {
		fill: color-mix(in oklab, var(--sl-color-white) 82%, var(--ig-vx));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	:root:not([data-theme='light']) .molp__h {
		fill: hsl(220, 30%, 88%);
	}
</style>
