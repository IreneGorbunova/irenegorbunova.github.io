---
/**
 * Model «Уравнение равномерного движения»: two bodies move uniformly along one straight road, the axis Ox along it.
 * The pupil sets each body's initial coordinate x₀ (0…800 м, step 50 м) and the projection of its velocity υx
 * (−30…30 м/с, step 5 м/с); the time runs from 0 to 40 s, four times faster than real (10 s), and repeats; the
 * time slider stops it and sets it by hand.
 * Shown: the bodies as points on the road (0,4 px per metre) with their velocity arrows (1,5 px per м/с), the graphs
 * x(t) (7 px per second, 0,25 px per metre), the equations x = x₀ + υx·t of both bodies and the meeting computed from
 * them: t = (x₀₂ − x₀₁)/(υx₁ − υx₂), when it is positive. Start: x₀₁ = 0, υx₁ = 20 м/с; x₀₂ = 700 м, υx₂ = −15 м/с:
 * they meet at t = 20 с at x = 400 м.
 */
import G7Styles from '../g7/G7Styles.astro';

const RX = 22; // x = 0 on the road, px
const RK = 0.4; // px per metre on the road
const GX = 52; // t = 0 on the graph
const GY = 280; // x = 0 on the graph
const TK = 7; // px per second
const XK = 0.25; // px per metre
---

<G7Styles />
<figure class="g7 g7--wide not-content" data-meetlab>
	<div class="g7__grid">
		<div>
			<svg class="g7__svg" viewBox="0 0 360 318" role="img" aria-label="Два тела движутся по одной дороге; ниже графики их координат от времени. Точка пересечения графиков — встреча">
				<!-- the road -->
				<rect class="mt-road" x="0" y="18" width="360" height="14"></rect>
				<path class="ink" d={`M${RX - 8} 40 H350`}></path>
				<path class="head--ink" d="M355 40 l-8 -4 v8 Z"></path>
				{[0, 200, 400, 600, 800].map((m) => (
					<>
						<line class="ln" x1={RX + m * RK} y1="36" x2={RX + m * RK} y2="44"></line>
						<text class="t-small t-num" x={RX + m * RK} y="55" text-anchor="middle">{m}</text>
					</>
				))}
				<text x="352" y="32" text-anchor="end"><tspan class="t-i">x</tspan>, м</text>
				{[1, 2].map((b) => (
					<g data-body={b}>
						<path class={`arrow arrow--${b === 1 ? 'gold' : 'blue'}`} data-va d=""></path>
						<path class={`head--${b === 1 ? 'gold' : 'blue'}`} data-vh d=""></path>
						<circle class={`mt-dot mt-dot--${b}`} cy="25" r="7"></circle>
						<text class="mt-num" data-n y="29" text-anchor="middle">{b}</text>
					</g>
				))}
				<!-- the graph -->
				{[100, 200, 300, 400, 500, 600, 700, 800].map((m) => <path class="mt-grid" d={`M${GX} ${GY - m * XK} H${GX + 40 * TK}`}></path>)}
				{[5, 10, 15, 20, 25, 30, 35, 40].map((t) => <path class="mt-grid" d={`M${GX + t * TK} ${GY} V${GY - 800 * XK}`}></path>)}
				<path class="ink" d={`M${GX} ${GY} H${GX + 40 * TK + 8} M${GX} ${GY} V${GY - 800 * XK - 12}`}></path>
				<path class="head--ink" d={`M${GX + 40 * TK + 12} ${GY} l-7 -3.5 v7 Z M${GX} ${GY - 800 * XK - 16} l-3.5 7 h7 Z`}></path>
				{[0, 10, 20, 30, 40].map((t) => <text class="t-small t-num" x={GX + t * TK} y={GY + 14} text-anchor="middle">{t}</text>)}
				{[0, 200, 400, 600, 800].map((m) => <text class="t-small t-num" x={GX - 5} y={GY - m * XK + 4} text-anchor="end">{m}</text>)}
				<text x={GX + 8} y={GY - 800 * XK - 8}><tspan class="t-i">x</tspan>, м</text>
				<text x="350" y={GY + 28} text-anchor="end"><tspan class="t-i">t</tspan>, с</text>
				<line class="mt-line mt-line--1" data-l1></line>
				<line class="mt-line mt-line--2" data-l2></line>
				<line class="mt-now" data-now y1={GY} y2={GY - 800 * XK}></line>
				<g data-meet>
					<path class="mt-meetdrop" data-md d=""></path>
					<circle class="mt-meet" r="5"></circle>
				</g>
				<circle class="mt-dot mt-dot--1" data-g1 r="4"></circle>
				<circle class="mt-dot mt-dot--2" data-g2 r="4"></circle>
			</svg>
		</div>
		<div class="g7__side">
			<div class="mt-pair mt-pair--1">
				<b>Тело 1</b>
				<label class="g7__slider"><span><i>x</i><sub>01</sub></span><output data-ox1></output><input type="range" min="0" max="800" step="50" value="0" data-x1 aria-label="Начальная координата тела 1" /></label>
				<label class="g7__slider"><span><i>υ</i><sub>x1</sub></span><output data-ov1></output><input type="range" min="-30" max="30" step="5" value="20" data-v1 aria-label="Проекция скорости тела 1" /></label>
			</div>
			<div class="mt-pair mt-pair--2">
				<b>Тело 2</b>
				<label class="g7__slider"><span><i>x</i><sub>02</sub></span><output data-ox2></output><input type="range" min="0" max="800" step="50" value="700" data-x2 aria-label="Начальная координата тела 2" /></label>
				<label class="g7__slider"><span><i>υ</i><sub>x2</sub></span><output data-ov2></output><input type="range" min="-30" max="30" step="5" value="-15" data-v2 aria-label="Проекция скорости тела 2" /></label>
			</div>
			<ul class="g7__lines" data-eq></ul>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-play>Повторить</button>
				<label class="g7__slider mt-time"><span>Время <i>t</i></span><output data-ot></output><input type="range" min="0" max="40" step="0.5" value="0" data-t aria-label="Время, секунды" /></label>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Тела показаны точками, стрелки — их скорости. Внизу графики координаты от времени: точка пересечения — место и время
		встречи. Часы модели идут в 4 раза быстрее настоящих; дорога и графики нарисованы в масштабе.
	</figcaption>
</figure>

<style is:global>
	[data-meetlab] .mt-road {
		fill: var(--sl-color-gray-6);
	}
	[data-meetlab] .mt-dot {
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	[data-meetlab] .mt-dot--1 {
		fill: var(--g7-gold);
	}
	[data-meetlab] .mt-dot--2 {
		fill: var(--g7-blue);
	}
	[data-meetlab] .g7__svg .mt-num {
		font-size: 10px;
		font-weight: 700;
		fill: var(--g7-paper);
	}
	[data-meetlab] .mt-grid {
		stroke: var(--g7-faint);
		stroke-width: 1;
	}
	[data-meetlab] .mt-line {
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	[data-meetlab] .mt-line--1 {
		stroke: var(--g7-gold);
	}
	[data-meetlab] .mt-line--2 {
		stroke: var(--g7-blue);
	}
	[data-meetlab] .mt-now {
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	[data-meetlab] .mt-meet {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.4;
	}
	[data-meetlab] .mt-meetdrop {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	[data-meetlab] .mt-pair {
		display: grid;
		gap: 0.3rem;
		padding: 0.45rem 0.6rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
	}
	[data-meetlab] .mt-pair--1 {
		box-shadow: inset 3px 0 0 var(--g7-gold);
	}
	[data-meetlab] .mt-pair--2 {
		box-shadow: inset 3px 0 0 var(--g7-blue);
	}
	[data-meetlab] .mt-time {
		flex: 1 1 9rem;
	}
</style>

<script>
	import { fmt, fmtInt, fmtTrim, k, loop } from '../g7/kit';

	const RX = 22;
	const RK = 0.4;
	const GX = 52;
	const GY = 280;
	const TK = 7;
	const XK = 0.25;
	const T = 40;
	const SPEED = 4;
	const n = (v: number) => fmtInt(v).replace(/ /g, '\\,').replace('−', '-');

	for (const root of document.querySelectorAll<HTMLElement>('[data-meetlab]')) {
		const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const inp = (s: string) => q<HTMLInputElement>(s);
		const tS = inp('[data-t]');
		let t = 0;
		let hold = 0;
		let playing = true;
		const read = () => ({ x1: +inp('[data-x1]').value, v1: +inp('[data-v1]').value, x2: +inp('[data-x2]').value, v2: +inp('[data-v2]').value });
		const eq = (x0: number, v: number) => (v === 0 ? n(x0) : `${n(x0)} ${v < 0 ? '-' : '+'} ${n(Math.abs(v))}\\,t`);

		const show = () => {
			const { x1, v1, x2, v2 } = read();
			q('[data-ox1]').textContent = `${fmtInt(x1)} м`;
			q('[data-ox2]').textContent = `${fmtInt(x2)} м`;
			q('[data-ov1]').textContent = `${fmt(v1, 0)} м/с`;
			q('[data-ov2]').textContent = `${fmt(v2, 0)} м/с`;
			q('[data-ot]').textContent = `${fmt(t, 1)} с`;
			tS.value = String(t);
			const bodies: [number, number][] = [
				[x1, v1],
				[x2, v2],
			];
			bodies.forEach(([x0, v], i) => {
				const b = i + 1;
				const x = x0 + v * t;
				const g = q(`[data-body="${b}"]`);
				const px = RX + x * RK;
				const vis = x >= -20 && x <= 830;
				g.setAttribute('opacity', vis ? '1' : '0');
				g.querySelector('circle')!.setAttribute('cx', px.toFixed(1));
				g.querySelector('[data-n]')!.setAttribute('x', px.toFixed(1));
				const len = v * 1.5;
				const y = b === 1 ? 10 : 10;
				if (Math.abs(len) > 2) {
					const e = px + len;
					const s = Math.sign(len);
					g.querySelector('[data-va]')!.setAttribute('d', `M${px.toFixed(1)} ${y} H${(e - s * 6).toFixed(1)}`);
					g.querySelector('[data-vh]')!.setAttribute('d', `M${e.toFixed(1)} ${y} l${(-s * 6).toFixed(1)} -3.5 v7 Z`);
				} else {
					g.querySelector('[data-va]')!.setAttribute('d', '');
					g.querySelector('[data-vh]')!.setAttribute('d', '');
				}
				// the graph x(t), cut to 0…800 м
				let lo = 0;
				let hi = T;
				if (v !== 0) {
					const ta = (0 - x0) / v;
					const tb = (800 - x0) / v;
					lo = Math.max(0, Math.min(ta, tb));
					hi = Math.min(T, Math.max(ta, tb));
				}
				const l = q(`[data-l${b}]`);
				l.setAttribute('opacity', lo < hi ? '1' : '0');
				l.setAttribute('x1', (GX + lo * TK).toFixed(1));
				l.setAttribute('y1', (GY - (x0 + v * lo) * XK).toFixed(1));
				l.setAttribute('x2', (GX + hi * TK).toFixed(1));
				l.setAttribute('y2', (GY - (x0 + v * hi) * XK).toFixed(1));
				const gd = q(`[data-g${b}]`);
				gd.setAttribute('cx', (GX + t * TK).toFixed(1));
				gd.setAttribute('cy', (GY - x * XK).toFixed(1));
				gd.setAttribute('opacity', x >= 0 && x <= 800 ? '1' : '0');
			});
			const now = q('[data-now]');
			now.setAttribute('x1', (GX + t * TK).toFixed(1));
			now.setAttribute('x2', (GX + t * TK).toFixed(1));
			// the meeting
			const lines = [`x_1 = ${eq(x1, v1)}`, `x_2 = ${eq(x2, v2)}`];
			let meet = '';
			const meetG = q('[data-meet]');
			if (v1 !== v2) {
				const tm = (x2 - x1) / (v1 - v2);
				const xm = x1 + v1 * tm;
				if (tm >= 0 && tm <= T && xm >= 0 && xm <= 800) {
					meet = `\\text{встреча: } t = ${fmtTrim(tm, 1).replace(',', '{,}')}~\\text{с},\\; x = ${n(Math.round(xm))}~\\text{м}`;
					meetG.setAttribute('opacity', '1');
					const mx = GX + tm * TK;
					const my = GY - xm * XK;
					meetG.querySelector('circle')!.setAttribute('cx', mx.toFixed(1));
					meetG.querySelector('circle')!.setAttribute('cy', my.toFixed(1));
					q('[data-md]').setAttribute('d', `M${mx.toFixed(1)} ${my.toFixed(1)} V${GY} M${mx.toFixed(1)} ${my.toFixed(1)} H${GX}`);
				} else if (tm > T) {
					meet = `\\text{встреча позже чем через 40 с}`;
					meetG.setAttribute('opacity', '0');
				} else {
					meet = `\\text{тела не встретятся}`;
					meetG.setAttribute('opacity', '0');
				}
			} else {
				meet = x1 === x2 ? `\\text{тела всё время рядом}` : `\\text{тела не встретятся}`;
				meetG.setAttribute('opacity', '0');
			}
			q('[data-eq]').innerHTML = [...lines, meet].map((s, i) => `<li${i === 2 ? ' class="is-key"' : ''}>${k(s)}</li>`).join('');
		};

		// the clock runs by itself and repeats; the time slider stops it, «Повторить» starts it again
		const wake = loop(root, (dt) => {
			if (!playing) return false;
			if (t < T) t = Math.min(T, t + dt * SPEED);
			else if ((hold += dt) > 2) {
				t = 0;
				hold = 0;
			}
			show();
			return true;
		});
		q('[data-play]').addEventListener('click', () => {
			t = 0;
			hold = 0;
			playing = true;
			show();
			wake();
		});
		tS.addEventListener('input', () => {
			playing = false;
			t = +tS.value;
			show();
		});
		for (const s of ['[data-x1]', '[data-v1]', '[data-x2]', '[data-v2]']) inp(s).addEventListener('input', show);
		show();
	}
</script>
