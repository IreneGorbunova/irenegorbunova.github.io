---
/**
 * Model «Мгновенная скорость»: a car starts from rest with a = 2 м/с², so x = t² (м, с). We look for its speed at the
 * moment t = 4 с, when the speedometer shows 8 м/с (28,8 км/ч). The average speed over the interval from 4 с to
 * 4 с + Δt is Δx/Δt = ((4 + Δt)² − 16)/Δt = 8 + Δt: for Δt = 2; 1; 0,5; 0,1; 0,01 с it is 10; 9; 8,5; 8,1; 8,01 м/с.
 * Shown: the road (8 px per metre) with the two positions and Δx; the graph x(t) (40 px per second, 5 px per metre)
 * with the chord between the two moments (gold) and the tangent at t = 4 с (dashed, slope 8 м/с): as Δt shrinks, the
 * chord turns into the tangent. The Δt values change by themselves every 2,5 s until the pupil picks one.
 */
import G7Styles from '../g7/G7Styles.astro';

const GX = 40;
const GY = 236;
const TK = 40;
const XK = 5;
const curve = Array.from({ length: 61 }, (_, i) => {
	const t = i * 0.1;
	return `${i ? 'L' : 'M'}${(GX + t * TK).toFixed(1)} ${(GY - t * t * XK).toFixed(1)}`;
}).join(' ');
const RX = 24;
const RK = 8;
---

<G7Styles />
<figure class="g7 g7--wide not-content" data-instlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 266" role="img" aria-label="График координаты разгоняющегося автомобиля. Хорда между моментами 4 секунды и 4 секунды плюс Δt; при уменьшении Δt она приближается к касательной">
			<!-- the road -->
			<rect class="in-road" x="0" y="4" width="340" height="10"></rect>
			{[0, 10, 20, 30].map((m) => (
				<>
					<line class="ln" x1={RX + m * RK} y1="14" x2={RX + m * RK} y2="19"></line>
					<text class="t-small t-num" x={RX + m * RK} y="29" text-anchor="middle">{m}</text>
				</>
			))}
			<text class="t-small" x="336" y="29" text-anchor="end">x, м</text>
			<circle class="in-a" cx={RX + 16 * RK} cy="9" r="4.5"></circle>
			<circle class="in-b" data-rb cy="9" r="4.5"></circle>
			<path class="in-dx" data-rdx d=""></path>
			<text class="t-small t-strong t-num t-halo in-gold" data-rdxt y="44" text-anchor="middle"></text>
			<!-- the graph -->
			{[5, 10, 15, 20, 25, 30, 35].map((m) => <path class="in-grid" d={`M${GX} ${GY - m * XK} H${GX + 6 * TK}`}></path>)}
			{[1, 2, 3, 4, 5, 6].map((t) => <path class="in-grid" d={`M${GX + t * TK} ${GY} V${GY - 36 * XK}`}></path>)}
			<path class="ink" d={`M${GX} ${GY} H${GX + 6 * TK + 10} M${GX} ${GY} V${GY - 36 * XK - 6}`}></path>
			<path class="head--ink" d={`M${GX + 6 * TK + 14} ${GY} l-7 -3.5 v7 Z M${GX} ${GY - 36 * XK - 10} l-3.5 7 h7 Z`}></path>
			{[0, 1, 2, 3, 4, 5, 6].map((t) => <text class="t-small t-num" x={GX + t * TK} y={GY + 14} text-anchor="middle">{t}</text>)}
			{[0, 10, 20, 30].map((m) => <text class="t-small t-num" x={GX - 5} y={GY - m * XK + 4} text-anchor="end">{m}</text>)}
			<text x={GX + 8} y={GY - 36 * XK - 2}><tspan class="t-i">x</tspan>, м</text>
			<text x="336" y={GY + 26} text-anchor="end"><tspan class="t-i">t</tspan>, с</text>
			<path class="in-curve" d={curve}></path>
			<line class="in-tan" x1={GX + 2.2 * TK} y1={GY - (16 + 8 * (2.2 - 4)) * XK} x2={GX + 6 * TK} y2={GY - (16 + 8 * 2) * XK}></line>
			<path class="in-legs" data-legs d=""></path>
			<line class="in-chord" data-chord></line>
			<circle class="in-a" cx={GX + 4 * TK} cy={GY - 16 * XK} r="4.5"></circle>
			<circle class="in-b" data-gb r="4.5"></circle>
			<text class="t-small t-num t-halo" data-dtt text-anchor="middle"></text>
			<text class="t-small t-num t-halo in-gold" data-dxt></text>
		</svg>
		<div class="g7__side">
			<span class="g7__label">Промежуток времени после <span class="nw"><i>t</i> = 4&nbsp;с</span>:</span>
			<div class="g7__seg" role="group" aria-label="Промежуток времени" data-dts>
				<button type="button" class="g7__btn" aria-pressed="true" data-dt="2">2&nbsp;с</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-dt="1">1&nbsp;с</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-dt="0.5">0,5&nbsp;с</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-dt="0.1">0,1&nbsp;с</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-dt="0.01">0,01&nbsp;с</button>
			</div>
			<ul class="g7__lines" data-calc></ul>
			<div class="in-meter">
				<svg viewBox="0 0 120 74" aria-hidden="true">
					<path class="in-dial" d="M12 66 A48 48 0 0 1 108 66"></path>
					{Array.from({ length: 7 }, (_, i) => {
						const a = Math.PI - (i * Math.PI) / 6;
						return <line class="in-tick" x1={(60 + 42 * Math.cos(a)).toFixed(1)} y1={(66 - 42 * Math.sin(a)).toFixed(1)} x2={(60 + 48 * Math.cos(a)).toFixed(1)} y2={(66 - 48 * Math.sin(a)).toFixed(1)} />;
					})}
					{[0, 20, 40, 60].map((v) => {
						const a = Math.PI - (v / 60) * Math.PI;
						return <text class="in-mt" x={(60 + 33 * Math.cos(a)).toFixed(1)} y={(70 - 33 * Math.sin(a)).toFixed(1)} text-anchor="middle">{v}</text>;
					})}
					<line class="in-needle" x1="60" y1="66" x2={(60 + 40 * Math.cos(Math.PI - (28.8 / 60) * Math.PI)).toFixed(1)} y2={(66 - 40 * Math.sin(Math.PI - (28.8 / 60) * Math.PI)).toFixed(1)}></line>
					<circle class="in-hub" cx="60" cy="66" r="3"></circle>
				</svg>
				<p>Спидометр в момент 4&nbsp;с: <span class="nw">28,8&nbsp;км/ч</span> = <b class="nw">8&nbsp;м/с</b></p>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Автомобиль трогается с места с ускорением 2&nbsp;м/с², его координата <i>x</i>&nbsp;=&nbsp;<i>t</i>² (в метрах и
		секундах). Золотая хорда соединяет положения в моменты 4&nbsp;с и 4&nbsp;с&nbsp;+&nbsp;Δ<i>t</i>; пунктир — касательная к
		графику в момент 4&nbsp;с. График и дорога нарисованы в масштабе.
	</figcaption>
</figure>

<style is:global>
	[data-instlab] .in-road {
		fill: var(--sl-color-gray-6);
	}
	[data-instlab] .in-grid {
		stroke: var(--g7-faint);
		stroke-width: 1;
	}
	[data-instlab] .in-curve {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.6;
	}
	[data-instlab] .in-tan {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		stroke-dasharray: 5 4;
	}
	[data-instlab] .in-chord {
		stroke: var(--g7-gold);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-instlab] .in-legs,
	[data-instlab] .in-dx {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.2;
		stroke-dasharray: 3 2;
	}
	[data-instlab] .in-dx {
		stroke-dasharray: none;
		stroke-width: 2;
	}
	[data-instlab] .in-a {
		fill: var(--g7-paper);
		stroke: var(--g7-gold);
		stroke-width: 2.2;
	}
	[data-instlab] .in-b {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	[data-instlab] .g7__svg .in-gold {
		fill: var(--g7-gold);
	}
	[data-instlab] .g7__seg .g7__btn {
		padding-inline: 0.5rem;
	}
	[data-instlab] .in-meter {
		display: grid;
		grid-template-columns: 7rem 1fr;
		align-items: center;
		gap: 0.6rem;
	}
	[data-instlab] .in-meter p {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	[data-instlab] .in-dial {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-instlab] .in-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	[data-instlab] .in-mt {
		font-size: 9px;
		fill: var(--sl-color-gray-2);
	}
	[data-instlab] .in-needle {
		stroke: var(--ig-vy);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-instlab] .in-hub {
		fill: var(--sl-color-gray-1);
	}
</style>

<script>
	import { fmtTrim, k, loop } from '../g7/kit';

	const GX = 40;
	const GY = 236;
	const TK = 40;
	const XK = 5;
	const RX = 24;
	const RK = 8;
	const DTS = [2, 1, 0.5, 0.1, 0.01];
	const c = (v: number, d = 4) => fmtTrim(v, d).replace(',', '{,}');

	for (const root of document.querySelectorAll<HTMLElement>('[data-instlab]')) {
		const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-dt]')];
		let target = 2;
		let shown = 2; // eases toward the target
		let auto = true;
		let since = 0;

		const draw = () => {
			const dt = shown;
			const t1 = 4 + dt;
			const x1 = t1 * t1;
			const bx = GX + t1 * TK;
			const by = GY - x1 * XK;
			q('[data-gb]').setAttribute('cx', bx.toFixed(1));
			q('[data-gb]').setAttribute('cy', by.toFixed(1));
			const ch = q('[data-chord]');
			// the chord, drawn a little beyond both points so that it stays visible when they almost merge
			const ax = GX + 4 * TK;
			const ay = GY - 16 * XK;
			const sl = (by - ay) / (bx - ax || 1e-6);
			ch.setAttribute('x1', (ax - 40).toFixed(1));
			ch.setAttribute('y1', (ay - 40 * sl).toFixed(1));
			ch.setAttribute('x2', (bx + 30).toFixed(1));
			ch.setAttribute('y2', (by + 30 * sl).toFixed(1));
			q('[data-legs]').setAttribute('d', `M${ax} ${ay} H${bx.toFixed(1)} V${by.toFixed(1)}`);
			const dtt = q('[data-dtt]');
			dtt.setAttribute('x', ((ax + bx) / 2).toFixed(1));
			dtt.setAttribute('y', (ay + 14).toFixed(1));
			dtt.textContent = dt > 0.3 ? `Δt = ${fmtTrim(target, 2)} с` : '';
			const dxt = q('[data-dxt]');
			dxt.setAttribute('x', (bx + 5).toFixed(1));
			dxt.setAttribute('y', ((ay + by) / 2 + 4).toFixed(1));
			dxt.textContent = dt > 0.3 ? 'Δx' : '';
			// the road
			const rb = RX + x1 * RK;
			q('[data-rb]').setAttribute('cx', rb.toFixed(1));
			q('[data-rdx]').setAttribute('d', `M${RX + 16 * RK} 20 V24 M${RX + 16 * RK} 22 H${rb.toFixed(1)} M${rb.toFixed(1)} 20 V24`);
			const rt = q('[data-rdxt]');
			rt.setAttribute('x', ((RX + 16 * RK + rb) / 2).toFixed(1));
			rt.textContent = dt > 0.3 ? `Δx = ${fmtTrim(x1 - 16, 2)} м` : '';
		};
		const calc = () => {
			const dt = target;
			const dx = (4 + dt) ** 2 - 16;
			const lines = [`\\Delta t = ${c(dt)}~\\text{с}`, `\\Delta x = ${c(4 + dt)}^2 - 4^2 = ${c(dx)}~\\text{м}`, `\\upsilon_{\\text{ср}} = \\dfrac{\\Delta x}{\\Delta t} = ${c(dx / dt)}~\\text{м/с}`];
			q('[data-calc]').innerHTML = lines.map((s, i) => `<li${i === 2 ? ' class="is-key"' : ''}>${k(s)}</li>`).join('');
			btns.forEach((b) => b.setAttribute('aria-pressed', String(+b.dataset.dt! === target)));
		};
		const pick = (dt: number) => {
			target = dt;
			calc();
		};
		loop(root, (dt) => {
			if (auto && (since += dt) > 2.5) {
				since = 0;
				pick(DTS[(DTS.indexOf(target) + 1) % DTS.length]);
			}
			// ease in a log scale, so that 0,1 → 0,01 is visible too
			const ls = Math.log(shown);
			const lt = Math.log(target);
			shown = Math.exp(ls + (lt - ls) * Math.min(1, dt * 6));
			draw();
			return true;
		});
		for (const b of btns)
			b.addEventListener('click', () => {
				auto = false;
				pick(+b.dataset.dt!);
			});
		calc();
		draw();
	}
</script>
