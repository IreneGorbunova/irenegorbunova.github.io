---
/**
 * Two short looping opening scenes of «Равномерное и равноускоренное прямолинейное движение». No terms of the chapter
 * in the pictures.
 *
 * Green light (20 px per metre, real time, 5,2 s): the light turns green as a cyclist rides past the stop line at a
 *   steady 5 м/с (18 км/ч); the car that waited there starts with 2,5 м/с². The camera rides with the cyclist, so the
 *   street runs back at 5 м/с. The car's front relative to the cyclist's: 1,25 t² − 5t (м): it falls behind by 5 м at
 *   t = 2 с, draws level at t = 4 с (20 м from the line, the car at 10 м/с = 36 км/ч) and is 7,8 м ahead at
 *   t = 5,2 с (46,8 км/ч). The labels show the speeds rounded to whole км/ч.
 * Brakes (19 px per metre, real time): two cars come to the same mark at 18 км/ч (5 м/с) and at 36 км/ч (10 м/с) and
 *   brake with the same 5 м/с² (an ordinary braking on asphalt): the first stops after 1 с and 5²/(2·5) = 2,5 м, the
 *   second after 2 с and 10²/(2·5) = 10 м — twice the speed, four times the distance. Both stop before the zebra
 *   (11…15 м), where a woman (165 см) and a man (178 см) with a child (125 см) wait on the pavement. The cars (440 см) and the people are to scale.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';
import { carCss } from './car';

const X0 = 42; // the braking mark, px
const K2 = 19;
const rows = [104, 222];
const zebra = (gy: number) =>
	Array.from({ length: 5 }, (_, i) => {
		const x = X0 + (11 + i * 0.85) * K2;
		return `M${x.toFixed(1)} ${gy + 4} L${(x + 7).toFixed(1)} ${gy + 4} L${(x + 13).toFixed(1)} ${gy - 26} L${(x + 6).toFixed(1)} ${gy - 26} Z`;
	}).join(' ');
const css = carCss('[data-ruintro]');
---

<PeopleStyles />
<Fragment set:html={`<style>${css}</style>`} />
<IntroFrame data-ruintro>
	<div class="intro__card" data-scene="green">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Перекрёсток. Загорается зелёный, велосипедист проезжает мимо с постоянной скоростью, а стоявший автомобиль трогается: сначала отстаёт, потом догоняет и обгоняет">
			<rect class="ru-sky" x="0" y="0" width="360" height="240"></rect>
			<g data-far></g>
			<rect class="ru-walk" x="0" y="150" width="360" height="16"></rect>
			<g data-near></g>
			<rect class="ru-road" x="0" y="166" width="360" height="60"></rect>
			<path class="ru-lane" data-lane d=""></path>
			<rect class="ru-walk" x="0" y="226" width="360" height="14"></rect>
			<line class="ru-curb" x1="0" y1="226" x2="360" y2="226"></line>
			<g data-car></g>
			<g data-bike></g>
			<text class="ru-speed" data-vcar text-anchor="middle"></text>
			<text class="ru-speed" data-vbike text-anchor="middle">18 км/ч</text>
		</svg>
		<div class="intro__foot">
			<p>
				На зелёный велосипедист проезжает перекрёсток, не меняя скорости, а стоявший автомобиль трогается: сначала он отстаёт, но{' '}
				<More term="через 4 секунды догоняет велосипедиста">
					Скорость автомобиля каждую секунду растёт на 2,5&nbsp;м/с, а велосипедист всё время едет со скоростью 5&nbsp;м/с. Через 4&nbsp;с оба оказываются в 20&nbsp;м от перекрёстка: в этот момент автомобиль едет вдвое быстрее велосипедиста. Такое движение называют равноускоренным — об этом в разделе{' '}
					<a href="#ускорение">«Ускорение»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="brakes">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Две машины тормозят от одной отметки: при скорости 18 километров в час машина останавливается через 2,5 метра, при 36 километрах в час — через 10 метров">
			<rect class="ru-sky" x="0" y="0" width="360" height="240"></rect>
			{rows.map((gy) => (
				<>
					<path class="ru-house" d={`M0 ${gy - 40} V${gy - 92} H70 V${gy - 80} H150 V${gy - 100} H240 V${gy - 86} H360 V${gy - 40} Z`} />
					{[12, 40, 84, 116, 166, 200, 256, 290, 324].map((x, k) => <rect class="ru-win" x={x} y={gy - (k % 2 ? 66 : 74)} width="9" height="11" />)}
					<rect class="ru-walk" x="0" y={gy - 40} width="360" height="12" />
					<rect class="ru-road" x="0" y={gy - 28} width="360" height="36" />
					<path class="ru-zebra" d={zebra(gy)} />
					<line class="ru-mark" x1={X0} y1={gy - 28} x2={X0} y2={gy + 8} />
				</>
			))}
			<g data-p1></g>
			<g data-p2></g>
			<g data-p3></g>
			<g data-c1></g>
			<g data-c2></g>
			<path class="ru-bracket" data-b1 d=""></path>
			<path class="ru-bracket" data-b2 d=""></path>
			<text class="ru-dist" data-d1></text>
			<text class="ru-dist" data-d2></text>
			<text class="ru-speed" data-v1 text-anchor="middle"></text>
			<text class="ru-speed" data-v2 text-anchor="middle"></text>
		</svg>
		<div class="intro__foot">
			<p>
				Две машины тормозят одинаково, но одна ехала вдвое быстрее, и{' '}
				<More term="её путь до остановки вчетверо длиннее">
					При 18&nbsp;км/ч машина проезжает до остановки 2,5&nbsp;м, при 36&nbsp;км/ч — 10&nbsp;м: путь торможения растёт как квадрат скорости. Поэтому быстрая езда так опасна. Об этом — в разделе{' '}
					<a href="#перемещение-при-равноускоренном-движении">«Перемещение при равноускоренном движении»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-ruintro] .ru-sky {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-bg));
	}
	[data-ruintro] .ru-house {
		fill: var(--sl-color-gray-5);
	}
	[data-ruintro] .ru-win {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-6));
	}
	[data-ruintro] .ru-walk {
		fill: color-mix(in oklab, var(--ig-v) 12%, var(--sl-color-gray-5));
	}
	[data-ruintro] .ru-road {
		fill: var(--sl-color-gray-6);
	}
	[data-ruintro] .ru-curb {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	[data-ruintro] .ru-lane {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	[data-ruintro] .ru-zebra {
		fill: var(--sl-color-gray-2);
		opacity: 0.8;
	}
	[data-ruintro] .ru-mark {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	[data-ruintro] .ru-trunk {
		fill: var(--g7-wood-dark, color-mix(in oklab, var(--ig-v) 34%, var(--sl-color-gray-5)));
	}
	[data-ruintro] .ru-crown {
		fill: color-mix(in oklab, hsl(150, 60%, 50%) 45%, var(--sl-color-gray-5));
	}
	[data-ruintro] .ru-pole {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		fill: none;
	}
	[data-ruintro] .ru-box {
		fill: var(--sl-color-gray-1);
	}
	[data-ruintro] .ru-off {
		fill: var(--sl-color-gray-4);
	}
	[data-ruintro] .ru-red.is-on {
		fill: var(--ig-vy);
	}
	[data-ruintro] .ru-green.is-on {
		fill: hsl(150, 70%, 50%);
	}
	[data-ruintro] .ru-speed {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3px;
	}
	[data-ruintro] .ru-dist {
		font-size: 12px;
		font-weight: 700;
		fill: var(--ig-v);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3px;
	}
	[data-ruintro] .ru-bracket {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.5;
	}
	[data-ruintro] .bk-tire {
		fill: none;
		stroke: var(--sl-color-gray-1);
	}
	[data-ruintro] .bk-rim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	[data-ruintro] .bk-spoke {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.3;
	}
	[data-ruintro] .bk-hub {
		fill: var(--sl-color-gray-3);
	}
	[data-ruintro] .bk-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	[data-ruintro] .bk-frame {
		fill: none;
		stroke: var(--ig-vy);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-ruintro] .bk-part {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-linecap: round;
	}
	[data-ruintro] .bk-saddle,
	[data-ruintro] .bk-pedal {
		fill: var(--sl-color-gray-2);
	}
	[data-ruintro] .bk-far {
		opacity: 0.7;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { human, type HumanPose } from '../mehanicheskaya-rabota/people';
	import { bike } from '../sistema-otscheta/bike';
	import { car, LEN } from './car';

	const stand = (x0: number, floor: number, s: number, H: number): HumanPose => {
		const u = s * H;
		const A = 7 * s * Math.min(1, H / 172);
		return {
			hip: { x: x0, y: floor - 0.505 * u },
			lean: 0,
			ankles: [
				{ x: x0 + 0.02 * u, y: floor - A },
				{ x: x0 - 0.03 * u, y: floor - A },
			],
			feet: [0, 0],
			hands: [
				{ x: x0 + 0.03 * u, y: floor - 0.42 * u },
				{ x: x0 - 0.01 * u, y: floor - 0.42 * u },
			],
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-ruintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="green"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 20; // px per metre
			const S = K / 100;
			const VB = 5; // м/с, the cyclist
			const A = 2.5; // м/с², the car
			const XF = 196; // the cyclist's front wheel on the screen, px
			const far = $<SVGGElement>('[data-far]');
			const near = $<SVGGElement>('[data-near]');
			// the street, in metres from the stop line: houses far behind (they slide at a third of the speed:
			// they are farther), trees and lamps on the far pavement, a traffic light and a pedestrian at the line
			const houses: { g: SVGGElement; x: number }[] = [];
			for (let i = 0; i < 6; i++) {
				const g = el('g', {});
				const w = 70 + ((i * 37) % 30);
				const h = 92 + ((i * 53) % 50);
				g.append(el('rect', { class: 'ru-house', x: 0, y: 150 - h, width: w, height: h }));
				for (let r = 0; r < Math.floor(h / 22); r++)
					for (let c = 0; c < Math.floor(w / 20); c++) g.append(el('rect', { class: 'ru-win', x: 8 + c * 20, y: 150 - h + 8 + r * 22, width: 9, height: 11 }));
				far.append(g);
				houses.push({ g, x: i * 90 });
			}
			const items: { g: SVGGElement; x: number }[] = [];
			for (let i = 0; i < 8; i++) {
				const g = el('g', {});
				if (i % 2) {
					g.append(el('rect', { class: 'ru-trunk', x: -2, y: 120, width: 4, height: 34 }));
					g.append(el('circle', { class: 'ru-crown', cx: -6, cy: 112, r: 13 }));
					g.append(el('circle', { class: 'ru-crown', cx: 6, cy: 108, r: 14 }));
				} else {
					g.append(el('path', { class: 'ru-pole', d: 'M0 154 V86 Q0 82 6 82 H14' }));
				}
				near.append(g);
				items.push({ g, x: -10 + i * 8 }); // м
			}
			const light = el('g', {});
			light.append(el('path', { class: 'ru-pole', d: 'M0 154 V108' }));
			light.append(el('rect', { class: 'ru-box', x: -5, y: 84, width: 10, height: 24, rx: 2 }));
			const red = el('circle', { class: 'ru-off ru-red', cx: 0, cy: 90, r: 3.2 });
			const green = el('circle', { class: 'ru-off ru-green', cx: 0, cy: 102, r: 3.2 });
			light.append(red, green);
			near.append(light);
			const walker = el('g', {});
			near.append(walker);
			const man = human(walker, { s: S, H: 170, shirt: 'hm-blue', hair: 'short' });
			const lane = $<SVGPathElement>('[data-lane]');
			const poseCar = car($<SVGGElement>('[data-car]'), S, 'cr-gold');
			const poseBike = bike($<SVGGElement>('[data-bike]'), S, { shirt: 'hm-green', hair: 'pony' });
			const vcar = $<SVGTextElement>('[data-vcar]');
			const vbike = $<SVGTextElement>('[data-vbike]');
			scene(card, 5.2, (x) => {
				const t = 5.2 * x;
				const cam = VB * t; // м: the camera rides with the cyclist
				const sx = (m: number) => XF + (m - cam) * K;
				for (const h of houses) h.g.setAttribute('transform', `translate(${((((h.x - cam * K * 0.33) % 540) + 540) % 540 - 90).toFixed(1)} 0)`);
				for (const it of items) {
					const px = ((((sx(it.x) + 40) % 520) + 520) % 520) - 40;
					it.g.setAttribute('transform', `translate(${px.toFixed(1)} 0)`);
				}
				light.setAttribute('transform', `translate(${sx(-1.2).toFixed(1)} 0)`);
				red.classList.toggle('is-on', t <= 0);
				green.classList.toggle('is-on', t > 0);
				man(stand(sx(-3), 154, S, 170));
				// the lane marking: 3 м dashes every 9 м, on the ground
				let d = '';
				const off = ((cam % 9) + 9) % 9;
				for (let m = -off - 9; m < 30; m += 9) d += `M${sx(cam + m).toFixed(1)} 204 h${(3 * K).toFixed(1)} `;
				lane.setAttribute('d', d);
				// the car and the cyclist
				const xc = (A * t * t) / 2;
				const vc = A * t;
				poseCar(sx(xc), 196, xc * 100, false);
				poseBike(XF - 140 * S, 222, cam * 100);
				vcar.setAttribute('x', Math.max(26, sx(xc) - (LEN * S) / 2).toFixed(1));
				vcar.setAttribute('y', '161');
				vcar.textContent = `${Math.round(vc * 3.6)} км/ч`;
				vbike.setAttribute('x', (XF - 60 * S).toFixed(1));
				vbike.setAttribute('y', '237');
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="brakes"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 19;
			const S = K / 100;
			const X0 = 42;
			const ROWS = [104, 222];
			const V0 = [5, 10]; // м/с
			const A = 5; // м/с²
			const T0 = 0.5; // s: both reach the mark
			const cars = [car($<SVGGElement>('[data-c1]'), S, 'cr-blue'), car($<SVGGElement>('[data-c2]'), S, 'cr-gold')];
			// pedestrians waiting at the zebra on the far pavement, facing the road ahead of them (to the left), to scale:
			// above a woman (165 см); below a man (178 см) holding the hand of a child (125 см), the hands 86 см high
			const woman = human($<SVGGElement>('[data-p1]'), { s: S, H: 165, shirt: 'hm-red', hair: 'pony', dir: -1 });
			woman(stand(X0 + 15.6 * K, ROWS[0] - 30, S, 165));
			const man = human($<SVGGElement>('[data-p2]'), { s: S, H: 178, shirt: 'hm-blue', hair: 'short', dir: -1 });
			const child = human($<SVGGElement>('[data-p3]'), { s: S, H: 125, shirt: 'hm-green', hair: 'pony', dir: -1 });
			const floor2 = ROWS[1] - 30;
			const xm = X0 + 16.1 * K;
			const xc = X0 + 15.55 * K;
			const hold = { x: (xm + xc) / 2, y: floor2 - 86 * S };
			const pm = stand(xm, floor2, S, 178);
			pm.hands[0] = hold;
			man(pm);
			const pc = stand(xc, floor2, S, 125);
			pc.hands[1] = hold;
			child(pc);
			scene(card, 3, (x) => {
				const t = 3 * x;
				ROWS.forEach((gy, i) => {
					const v0 = V0[i];
					const tb = v0 / A;
					let pos: number;
					let v: number;
					if (t < T0) {
						pos = -v0 * (T0 - t);
						v = v0;
					} else {
						const u = Math.min(t - T0, tb);
						pos = v0 * u - (A * u * u) / 2;
						v = v0 - A * u;
					}
					cars[i](X0 + pos * K, gy, (pos + 10) * 100, t >= T0 && v > 0.01);
					const lab = $<SVGTextElement>(`[data-v${i + 1}]`);
					lab.setAttribute('x', (X0 + pos * K - (LEN * S) / 2).toFixed(1));
					lab.setAttribute('y', String(gy - 30));
					lab.textContent = `${Math.round(v * 3.6)} км/ч`;
					const stopped = t >= T0 + tb;
					const end = X0 + ((v0 * v0) / (2 * A)) * K;
					$(`[data-b${i + 1}]`).setAttribute('d', stopped ? `M${X0} ${gy + 14} v-4 M${X0} ${gy + 12} H${end} M${end} ${gy + 14} v-4` : '');
					const dl = $<SVGTextElement>(`[data-d${i + 1}]`);
					dl.setAttribute('x', (end + 5).toFixed(1));
					dl.setAttribute('y', String(gy + 16));
					dl.textContent = stopped ? (i ? '10 м' : '2,5 м') : '';
				});
			});
		}
	}
</script>
