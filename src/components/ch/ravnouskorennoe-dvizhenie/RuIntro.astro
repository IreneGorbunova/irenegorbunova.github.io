---
/**
 * Two short looping opening scenes of «Равномерное и равноускоренное прямолинейное движение». No terms of the chapter
 * in the pictures. Both are drawn as a street seen from the pavement and a little from above, in an oblique projection:
 * along the street (X) and upward one scale K, depth (Z, away from the viewer) drawn shortened, KX px to the right and
 * KZ px up per metre. Every object stands at its real place and is drawn to the same scale, so distances along the
 * street can be compared in any lane. People: the shared people kit (src/components/people/).
 *
 * Green light (K = 22 px per metre, real time, 5,2 s): the light turns green as a cyclist (168 см) rides past the stop
 *   line in the bike lane at a steady 5 м/с (18 км/ч); the car that waited at the line starts with 2,5 м/с². The camera
 *   rides with the cyclist, so the street runs back at 5 м/с: the crossroads (stop line, zebra 1,5–5 м, the cross street
 *   6–18 м) slides past, with a mother (165 см) and a girl (120 см) hand in hand and a man (178 см) waiting for their
 *   own light. The car's front relative to the cyclist's: 1,25 t² − 5t (м): it falls behind by 5 м at t = 2 с, draws
 *   level at t = 4 с (20 м from the line, the car at 10 м/с = 36 км/ч) and is 7,8 м ahead at t = 5,2 с (46,8 км/ч).
 *   The labels show the speeds rounded to whole км/ч. The houses down the cross street, farther away, slide at half speed.
 * Brakes (K = 21 px per metre, real time, 3 s): two cars in two lanes come to the same mark at 18 км/ч (5 м/с, far
 *   lane) and at 36 км/ч (10 м/с, near lane) and brake with the same 5 м/с² (an ordinary braking on dry asphalt): the
 *   first stops after 1 с and 5²/(2·5) = 2,5 м, the second after 2 с and 10²/(2·5) = 10 м — twice the speed, four times
 *   the distance. Both stop before the zebra (11…14 м), where a father (178 см) with a boy (120 см) and a woman (165 см)
 *   wait. Tapes on the road show the two distances. The cars (440 см) and the people are to scale.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';
import { carCss } from './car';

const css = carCss('[data-ruintro]');
---

<KitStyles />
<Fragment set:html={`<style>${css}</style>`} />
<IntroFrame data-ruintro>
	<div class="intro__card" data-scene="green">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Перекрёсток. Загорается зелёный, велосипедист проезжает мимо с постоянной скоростью, а стоявший автомобиль трогается: сначала отстаёт, потом догоняет и обгоняет">
			<rect class="ru-sky" x="0" y="0" width="360" height="240"></rect>
			<g data-world></g>
		</svg>
		<div class="intro__foot">
			<p>
				На зелёный велосипедист проезжает перекрёсток, не меняя скорости, а стоявший автомобиль трогается: сначала он отстаёт, но{' '}
				<More term="через 4 секунды догоняет велосипедиста">
					Скорость автомобиля каждую секунду растёт на 2,5&nbsp;м/с, а велосипедист всё время едет со скоростью 5&nbsp;м/с. Через 4&nbsp;с оба оказываются в 20&nbsp;м от перекрёстка: в этот момент автомобиль едет вдвое быстрее велосипедиста. Такое движение называют равноускоренным — об этом в разделе{' '}
					<a href="#равноускоренное-движение">«Равноускоренное движение»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="brakes">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Две машины в соседних рядах тормозят от одной отметки перед пешеходным переходом: при скорости 18 километров в час машина останавливается через 2,5 метра, при 36 километрах в час — через 10 метров">
			<rect class="ru-sky" x="0" y="0" width="360" height="240"></rect>
			<g data-world></g>
		</svg>
		<div class="intro__foot">
			<p>
				Две машины тормозят одинаково, но одна ехала вдвое быстрее, и{' '}
				<More term="её путь до остановки вчетверо длиннее">
					При 18&nbsp;км/ч машина проезжает до остановки 2,5&nbsp;м, при 36&nbsp;км/ч — 10&nbsp;м: путь торможения растёт как квадрат скорости. Поэтому быстрая езда так опасна. Об этом — в разделе{' '}
					<a href="#перемещение-при-равноускоренном-движении">«Перемещение при равноускоренном движении»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-ruintro] {
		--ru-asph: color-mix(in oklab, var(--sl-color-gray-6) 80%, var(--sl-color-gray-5));
		--ru-walk: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-5));
	}
	[data-ruintro] .ru-sky {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-bg));
	}
	[data-ruintro] .ru-road {
		fill: var(--ru-asph);
	}
	[data-ruintro] .ru-walk {
		fill: var(--ru-walk);
	}
	[data-ruintro] .ru-tile {
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 40%, var(--ru-walk));
		stroke-width: 0.6;
		fill: none;
	}
	[data-ruintro] .ru-curb {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--ru-walk));
	}
	[data-ruintro] .ru-paint {
		fill: color-mix(in oklab, var(--sl-color-white) 80%, var(--ru-asph));
	}
	[data-ruintro] .ru-line {
		stroke: color-mix(in oklab, var(--sl-color-white) 80%, var(--ru-asph));
		stroke-width: 1.4;
		fill: none;
	}
	[data-ruintro] .ru-dash {
		stroke: color-mix(in oklab, var(--sl-color-white) 70%, var(--ru-asph));
		stroke-width: 1.4;
		stroke-dasharray: 5 4;
		fill: none;
	}
	[data-ruintro] .ru-fac1 {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-ruintro] .ru-fac2 {
		fill: color-mix(in oklab, var(--ig-vx) 22%, var(--sl-color-gray-5));
	}
	[data-ruintro] .ru-fac3 {
		fill: color-mix(in oklab, var(--ig-vy) 16%, var(--sl-color-gray-5));
	}
	[data-ruintro] .ru-side {
		fill: color-mix(in oklab, var(--sl-color-black) 30%, var(--sl-color-gray-5));
	}
	[data-ruintro] .ru-cross {
		opacity: 0.7;
	}
	[data-ruintro] .ru-win {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-6));
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-ruintro] .ru-shop {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-6));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-ruintro] .ru-awn1 {
		fill: var(--ig-vy);
	}
	[data-ruintro] .ru-awn2 {
		fill: hsl(150, 45%, 42%);
	}
	[data-ruintro] .ru-cornice {
		fill: color-mix(in oklab, var(--sl-color-black) 18%, var(--sl-color-gray-4));
	}
	[data-ruintro] .ru-trunk {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	[data-ruintro] .ru-crown {
		fill: color-mix(in oklab, hsl(150, 55%, 45%) 55%, var(--sl-color-gray-5));
		stroke: color-mix(in oklab, hsl(150, 55%, 25%) 60%, var(--sl-color-gray-6));
		stroke-width: 0.6;
	}
	[data-ruintro] .ru-pole {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		fill: none;
		stroke-linecap: round;
	}
	[data-ruintro] .ru-pole-thin {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		fill: none;
	}
	[data-ruintro] .ru-box {
		fill: color-mix(in oklab, var(--sl-color-black) 40%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	[data-ruintro] .ru-off {
		fill: var(--sl-color-gray-4);
	}
	[data-ruintro] .ru-red.is-on {
		fill: hsl(0, 85%, 58%);
	}
	[data-ruintro] .ru-green.is-on {
		fill: hsl(140, 75%, 50%);
	}
	[data-ruintro] .ru-sign {
		fill: hsl(215, 75%, 45%);
		stroke: var(--sl-color-white);
		stroke-width: 0.8;
	}
	[data-ruintro] .ru-sign-tri {
		fill: var(--sl-color-white);
	}
	[data-ruintro] .ru-speed {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3px;
	}
	[data-ruintro] .ru-dist {
		font-size: 12px;
		font-weight: 700;
		fill: var(--ig-v);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3px;
	}
	[data-ruintro] .ru-tape {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.8;
	}
	[data-ruintro] .bk-tire {
		fill: none;
		stroke: var(--hm-line);
	}
	[data-ruintro] .bk-rim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	[data-ruintro] .bk-spoke {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.3;
	}
	[data-ruintro] .bk-hub {
		fill: var(--sl-color-gray-3);
	}
	[data-ruintro] .bk-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	[data-ruintro] .bk-frame {
		fill: none;
		stroke: var(--ig-vy);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-ruintro] .bk-part {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-linecap: round;
	}
	[data-ruintro] .bk-saddle,
	[data-ruintro] .bk-pedal {
		fill: var(--sl-color-gray-2);
	}
	[data-ruintro] .bk-far {
		opacity: 0.7;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { figure, type Figure, type HandTarget } from '@components/people/body';
	import { car, LEN } from './car';
	import { rbike, BIKE_LEN } from './rbike';

	const f1 = (v: number) => v.toFixed(1);
	type Pt = { x: number; y: number };

	/** The oblique projection of a scene: X along the street, Z away from the viewer, Y up (metres). */
	const proj = (OX: number, GY: number, K: number, KX: number, KZ: number) => (X: number, Z: number, Y = 0): Pt => ({
		x: OX + X * K + Z * KX,
		y: GY - Z * KZ - Y * K,
	});
	type P = ReturnType<typeof proj>;
	const poly = (pts: Pt[]) => `M${pts.map((p) => `${f1(p.x)} ${f1(p.y)}`).join(' L')} Z`;
	/** A flat patch of the ground, X1…X2 by Z1…Z2. */
	const ground = (P: P, X1: number, X2: number, Z1: number, Z2: number) => poly([P(X1, Z1), P(X2, Z1), P(X2, Z2), P(X1, Z2)]);
	const line = (P: P, X1: number, Z1: number, X2: number, Z2: number) => `M${f1(P(X1, Z1).x)} ${f1(P(X1, Z1).y)} L${f1(P(X2, Z2).x)} ${f1(P(X2, Z2).y)} `;
	const add = <K extends keyof SVGElementTagNameMap>(g: Element, tag: K, a: Record<string, string | number>) => {
		const e = el(tag, a);
		g.append(e);
		return e;
	};

	/** A row of house fronts at depth Z from X1 to X2 (their tops run out of the picture). */
	const houses = (g: Element, P: P, K: number, X1: number, X2: number, Z: number, seed: number) => {
		let X = X1;
		let i = seed;
		while (X < X2 - 0.5) {
			const w = Math.min(X2 - X, 9 + ((i * 7) % 5));
			const a = P(X, Z);
			const b = P(X + w, Z);
			add(g, 'path', { class: `ru-fac${(i % 3) + 1}`, d: poly([a, b, { x: b.x, y: -40 }, { x: a.x, y: -40 }]) });
			// the ground floor: shop windows under awnings and a door
			const gf = 3.6 * K;
			add(g, 'rect', { class: 'ru-cornice', x: f1(a.x), y: f1(a.y - gf - 4), width: f1(b.x - a.x), height: 4 });
			const nShop = Math.max(1, Math.floor(w / 3.4));
			const sw = (w * K) / nShop;
			for (let k = 0; k < nShop; k++) {
				const x = a.x + k * sw;
				if (k === 1 && nShop > 2) {
					add(g, 'rect', { class: 'ru-win', x: f1(x + sw * 0.3), y: f1(a.y - 2.3 * K), width: f1(sw * 0.4), height: f1(2.3 * K) });
					continue;
				}
				add(g, 'rect', { class: 'ru-shop', x: f1(x + 4), y: f1(a.y - 2.6 * K), width: f1(sw - 8), height: f1(2.1 * K) });
				add(g, 'path', { class: (i + k) % 2 ? 'ru-awn1' : 'ru-awn2', d: `M${f1(x + 2)} ${f1(a.y - 2.75 * K)} h${f1(sw - 4)} l4 ${f1(0.5 * K)} h${f1(-sw - 4)} Z` });
			}
			// upper floors: windows every 3 м
			for (let fl = 1; fl < 4; fl++) {
				const wy = a.y - gf - 4 - fl * 3 * K + 0.9 * K;
				if (wy + 1.6 * K < 0) break;
				for (let c = 0; c < Math.floor(w / 2.4); c++) add(g, 'rect', { class: 'ru-win', x: f1(a.x + 0.7 * K + c * 2.4 * K), y: f1(wy), width: f1(1.2 * K), height: f1(1.6 * K) });
			}
			X += w;
			i++;
		}
	};

	/** A tree on the pavement. */
	const tree = (g: Element, P: P, K: number, X: number, Z: number) => {
		const b = P(X, Z);
		add(g, 'path', { class: 'ru-trunk', d: `M${f1(b.x - 2.5)} ${f1(b.y)} L${f1(b.x - 1.6)} ${f1(b.y - 3.4 * K)} L${f1(b.x + 1.6)} ${f1(b.y - 3.4 * K)} L${f1(b.x + 2.5)} ${f1(b.y)} Z` });
		for (const [dx, dy, r] of [
			[-0.9, 3.9, 1.3],
			[0.8, 4.1, 1.4],
			[0, 4.9, 1.5],
		])
			add(g, 'circle', { class: 'ru-crown', cx: f1(b.x + dx * K), cy: f1(b.y - dy * K), r: f1(r * K) });
	};

	/** A pedestrian-crossing sign on a pole. */
	const sign = (g: Element, P: P, K: number, X: number, Z: number) => {
		const b = P(X, Z);
		add(g, 'path', { class: 'ru-pole-thin', d: `M${f1(b.x)} ${f1(b.y)} V${f1(b.y - 2.6 * K)}` });
		const h = 0.32 * K;
		const c = { x: b.x, y: b.y - 2.6 * K - h };
		add(g, 'rect', { class: 'ru-sign', x: f1(c.x - h), y: f1(c.y - h), width: f1(2 * h), height: f1(2 * h), rx: 1.2 });
		add(g, 'path', { class: 'ru-sign-tri', d: `M${f1(c.x)} ${f1(c.y - h * 0.8)} L${f1(c.x + h * 0.8)} ${f1(c.y + h * 0.65)} L${f1(c.x - h * 0.8)} ${f1(c.y + h * 0.65)} Z` });
	};

	/** A standing person of the kit: feet at `base`; `hands` overrides the hanging hands. */
	const stand = (fig: Figure, base: Pt, H: number, s: number, age: 'adult' | 'child', dir: 1 | -1, hands?: [HandTarget, HandTarget], head = 0) => {
		const hip = { x: base.x, y: base.y - (age === 'adult' ? 0.52 : 0.48) * H * s + 0.6 };
		const ank = base.y - 0.045 * H * s;
		return fig.pose({
			hip,
			lean: 0.02,
			head,
			ankles: [
				{ x: base.x + dir * 0.035 * H * s, y: ank },
				{ x: base.x - dir * 0.03 * H * s, y: ank },
			],
			feet: [0, 0],
			planted: [true, true],
			hands: hands ?? [
				{ at: { x: base.x + dir * 0.02 * H * s, y: hip.y + 0.07 * H * s }, pose: 'relaxed' },
				{ at: { x: base.x - dir * 0.01 * H * s, y: hip.y + 0.07 * H * s }, pose: 'relaxed' },
			],
		});
	};

	/**
	 * A grown-up and a child facing the same way (dir), hand in hand: the grown-up's near hand holds the child's far hand;
	 * the child stands half a metre ahead and a little farther from the viewer, so it is drawn first.
	 */
	const pair = (g: Element, P: P, s: number, X: number, Z: number, dir: 1 | -1, Hs: [number, number], shirts: [string, string], hair: 'short' | 'pony', names: [string, string]) => {
		const gc = add(g, 'g', {}) as SVGGElement;
		const ga = add(g, 'g', {}) as SVGGElement;
		const adult = figure(ga, { s, H: Hs[0], clothes: 'indoor', shirt: shirts[0], hair, dir, name: names[0] });
		const child = figure(gc, { s, H: Hs[1], age: 'child', clothes: 'indoor', shirt: shirts[1], hair, shorts: true, dir, name: names[1] });
		const a = P(X, Z);
		const c = P(X + dir * 0.55, Z + 0.15);
		// the hands meet a little below the grown-up's hanging hand (0,44 H above the ground): both arms reach it
		const hold = { x: (a.x + c.x) / 2, y: a.y - 0.44 * Hs[0] * s };
		return () => {
			stand(child, c, Hs[1], s, 'child', dir, [
				{ at: { x: c.x + dir * 0.02 * Hs[1] * s, y: c.y - 0.42 * Hs[1] * s }, pose: 'relaxed' },
				{ at: hold, pose: 'grip', d: 4, contact: 'adult-hand' },
			], -0.12);
			stand(adult, a, Hs[0], s, 'adult', dir, [
				{ at: hold, pose: 'grip', d: 4, contact: 'child-hand' },
				{ at: { x: a.x - dir * 0.01 * Hs[0] * s, y: a.y - 0.45 * Hs[0] * s }, pose: 'relaxed' },
			]);
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-ruintro]')) {
		// ---------------------------------------------------------------- green light
		{
			const card = root.querySelector<HTMLElement>('[data-scene="green"]')!;
			const world = card.querySelector<SVGGElement>('[data-world]')!;
			const K = 22;
			const S = K / 100;
			const ZB = 0.8; // the bike lane
			const ZC = 3.45; // the car's lane
			const XF = 170; // the cyclist's front wheel on the screen, px
			const P = proj(XF - ZB * 4, 212, K, 4, 7);
			const VB = 5;
			const ACC = 2.5;
			const L = -40;
			const R = 70;
			const G0 = 6; // the cross street, 6…18 м
			const G1 = 18;
			const far = add(world, 'g', {});
			// down the cross street: its roadway to Z = 26 м, then a row of houses there; they slide at half speed (farther)
			add(far, 'path', { class: 'ru-road', d: ground(P, G0, G1, 9, 26) });
			const crossFar = add(far, 'g', { class: 'ru-cross' });
			houses(crossFar, P, K, -30, 50, 26, 4);
			add(far, 'path', { class: 'ru-side', d: poly([P(G0, 12), P(G0, 26), P(G0, 26, 30), P(G0, 12, 30)]) });
			houses(far, P, K, L, G0, 12, 0);
			houses(far, P, K, G1, R, 12, 2);
			add(far, 'path', { class: 'ru-walk', d: ground(P, L, G0, 9, 12) });
			add(far, 'path', { class: 'ru-walk', d: ground(P, G1, R, 9, 12) });
			add(far, 'path', { class: 'ru-curb', d: ground(P, L, G0, 8.8, 9) });
			add(far, 'path', { class: 'ru-curb', d: ground(P, G1, R, 8.8, 9) });
			for (const X of [-30, -21, -12, -3, 22, 31, 40, 49, 58]) tree(far, P, K, X, 10.8);
			add(far, 'path', { class: 'ru-road', d: ground(P, L, R, 0, 8.8) });
			// markings: the bike-lane line and the center line (broken at the crossroads), the stop line, the zebra
			add(far, 'path', { class: 'ru-line', d: line(P, L, 1.6, 0, 1.6) + line(P, G1, 1.6, R, 1.6) });
			add(far, 'path', { class: 'ru-dash', d: line(P, L, 5.3, 0, 5.3) + line(P, G1, 5.3, R, 5.3) });
			add(far, 'path', { class: 'ru-paint', d: ground(P, -0.4, 0, 0, 5.3) });
			for (let k = 0; k < 9; k++) add(far, 'path', { class: 'ru-paint', d: ground(P, 1.5, 5, 0.25 + k, 0.75 + k) });
			// the far traffic light, and a man waiting at the zebra on the far side
			{
				const b = P(5.6, 9.6);
				add(far, 'path', { class: 'ru-pole', d: `M${f1(b.x)} ${f1(b.y)} V${f1(b.y - 3 * K)}` });
				add(far, 'rect', { class: 'ru-box', x: f1(b.x - 4), y: f1(b.y - 3 * K - 18), width: 8, height: 18, rx: 2 });
			}
			const man = figure(add(far, 'g', {}) as SVGGElement, { s: S, H: 178, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', dir: -1, name: 'man far side' });
			// the moving: the car in its lane, then the cyclist (nearer)
			const poseCar = car(add(world, 'g', {}) as SVGGElement, S, 'cr-gold');
			const poseBike = rbike(add(world, 'g', {}) as SVGGElement, S, { shirt: 'hm-green', hair: 'pony', H: 168, name: 'cyclist' });
			// the near pavement (broken by the cross street), the traffic light at the stop line, the mother and the girl
			const near = add(world, 'g', {});
			add(near, 'path', { class: 'ru-curb', d: ground(P, L, G0, -0.25, 0) });
			add(near, 'path', { class: 'ru-curb', d: ground(P, G1, R, -0.25, 0) });
			add(near, 'path', { class: 'ru-walk', d: ground(P, L, G0, -5, -0.25) });
			add(near, 'path', { class: 'ru-walk', d: ground(P, G1, R, -5, -0.25) });
			add(near, 'path', { class: 'ru-road', d: ground(P, G0, G1, -5, 0) });
			let tiles = '';
			for (let X = L; X < R; X += 1.2) if (X < G0 || X > G1) tiles += line(P, X, -0.25, X, -5);
			add(near, 'path', { class: 'ru-tile', d: tiles });
			const lp = P(-0.9, -0.6);
			const top = lp.y - 3.1 * K;
			add(near, 'path', { class: 'ru-pole', d: `M${f1(lp.x)} ${f1(lp.y)} V${f1(top)}` });
			add(near, 'rect', { class: 'ru-box', x: f1(lp.x - 6), y: f1(top - 30), width: 12, height: 30, rx: 2.5 });
			const red = add(near, 'circle', { class: 'ru-off ru-red', cx: f1(lp.x), cy: f1(top - 24), r: 3.6 });
			add(near, 'circle', { class: 'ru-off', cx: f1(lp.x), cy: f1(top - 15), r: 3.6 });
			const green = add(near, 'circle', { class: 'ru-off ru-green', cx: f1(lp.x), cy: f1(top - 6), r: 3.6 });
			const people = pair(near, P, S, 2.4, -1.9, 1, [165, 120], ['hm-red', 'hm-gold'], 'pony', ['mother', 'girl']);
			const vcar = add(world, 'text', { class: 'ru-speed', 'text-anchor': 'middle' });
			const vbike = add(world, 'text', { class: 'ru-speed', 'text-anchor': 'middle' });
			scene(card, 5.2, (x) => {
				const t = 5.2 * x;
				const cam = VB * t; // м: the camera rides with the cyclist
				world.setAttribute('transform', `translate(${f1(-cam * K)} 0)`);
				crossFar.setAttribute('transform', `translate(${f1(cam * K * 0.5)} 0)`);
				red.classList.toggle('is-on', t <= 0);
				green.classList.toggle('is-on', t > 0);
				people();
				stand(man, P(5.4, 10.2), 178, S, 'adult', -1);
				const xc = (ACC * t * t) / 2;
				const pc = P(xc, ZC);
				poseCar(pc.x, pc.y, xc * 100, false);
				const pb = P(cam, ZB);
				poseBike(pb.x - BIKE_LEN * S, pb.y, cam * 100);
				vcar.setAttribute('x', f1(pc.x - (LEN * S) / 2));
				vcar.setAttribute('y', f1(pc.y - 1.65 * K));
				vcar.textContent = `${Math.round(ACC * t * 3.6)} км/ч`;
				vbike.setAttribute('x', f1(pb.x - 0.7 * K));
				vbike.setAttribute('y', f1(pb.y + 0.95 * K));
				vbike.textContent = '18 км/ч';
			});
		}
		// ---------------------------------------------------------------- brakes
		{
			const card = root.querySelector<HTMLElement>('[data-scene="brakes"]')!;
			const world = card.querySelector<SVGGElement>('[data-world]')!;
			const K = 21;
			const S = K / 100;
			const P = proj(26, 198, K, 5, 8);
			const L = -6;
			const R = 20;
			const LANES = [5.25, 1.75]; // the far lane (18 км/ч), the near lane (36 км/ч)
			const V0 = [5, 10]; // м/с
			const ACC = 5; // м/с²
			const T0 = 0.5; // s: both reach the mark
			const g = add(world, 'g', {});
			houses(g, P, K, L, R, 10, 1);
			add(g, 'path', { class: 'ru-walk', d: ground(P, L, R, 7.2, 10) });
			add(g, 'path', { class: 'ru-curb', d: ground(P, L, R, 7, 7.2) });
			tree(g, P, K, 3, 9);
			tree(g, P, K, -4.5, 9);
			sign(g, P, K, 14.5, 7.6);
			const woman = figure(add(g, 'g', {}) as SVGGElement, { s: S, H: 165, clothes: 'indoor', shirt: 'hm-red', hair: 'pony', dir: -1, name: 'woman far side' });
			add(g, 'path', { class: 'ru-road', d: ground(P, L, R, 0, 7) });
			// markings: the lane line, the mark at X = 0 (dashed), the zebra 11…14 м
			add(g, 'path', { class: 'ru-dash', d: line(P, L, 3.5, R, 3.5) });
			add(g, 'path', { class: 'ru-line', d: line(P, 0, 0, 0, 7), 'stroke-dasharray': '3 3' });
			for (let k = 0; k < 7; k++) add(g, 'path', { class: 'ru-paint', d: ground(P, 11, 14, 0.25 + k, 0.75 + k) });
			// each tape lies on the road beside its car, nearer to the viewer, drawn after its car and before the nearer one
			const cars: ReturnType<typeof car>[] = [];
			const tapes: SVGPathElement[] = [];
			(['cr-blue', 'cr-gold'] as const).forEach((c) => {
				cars.push(car(add(world, 'g', {}) as SVGGElement, S, c));
				tapes.push(add(world, 'path', { class: 'ru-tape', d: '' }));
			});
			// the near pavement with the sign, and a father with a boy at the zebra, facing the coming cars
			const n = add(world, 'g', {});
			add(n, 'path', { class: 'ru-curb', d: ground(P, L, R, -0.25, 0) });
			add(n, 'path', { class: 'ru-walk', d: ground(P, L, R, -6, -0.25) });
			let tiles = '';
			for (let X = L; X < R; X += 1.2) tiles += line(P, X, -0.25, X, -6);
			add(n, 'path', { class: 'ru-tile', d: tiles });
			sign(n, P, K, 15, -0.6);
			const people = pair(n, P, S, 12.9, -1.5, -1, [178, 120], ['hm-blue', 'hm-green'], 'short', ['father', 'boy']);
			const vlab = LANES.map(() => add(world, 'text', { class: 'ru-speed', 'text-anchor': 'middle' }));
			const dlab = LANES.map(() => add(world, 'text', { class: 'ru-dist', 'text-anchor': 'start' }));
			scene(card, 3, (x) => {
				const t = 3 * x;
				people();
				stand(woman, P(13.4, 8.6), 165, S, 'adult', -1);
				LANES.forEach((Z, i) => {
					const v0 = V0[i];
					const tb = v0 / ACC;
					let pos: number;
					let v: number;
					if (t < T0) {
						pos = -v0 * (T0 - t);
						v = v0;
					} else {
						const u = Math.min(t - T0, tb);
						pos = v0 * u - (ACC * u * u) / 2;
						v = v0 - ACC * u;
					}
					const p = P(pos, Z);
					cars[i](p.x, p.y, (pos + 10) * 100, t >= T0 && v > 0.01);
					vlab[i].setAttribute('x', f1(Math.max(30, p.x - (LEN * S) / 2)));
					vlab[i].setAttribute('y', f1(p.y - 1.75 * K));
					vlab[i].textContent = `${Math.round(v * 3.6)} км/ч`;
					const stopped = t >= T0 + tb - 1e-6;
					const dist = (v0 * v0) / (2 * ACC);
					const zt = Z - 1.45;
					const a = P(0, zt);
					const b = P(Math.min(Math.max(pos, 0), dist), zt);
					tapes[i].setAttribute('d', t >= T0 ? `M${f1(a.x)} ${f1(a.y - 3)} v6 M${f1(a.x)} ${f1(a.y)} L${f1(b.x)} ${f1(b.y)}${stopped ? ` M${f1(b.x)} ${f1(b.y - 3)} v6` : ''}` : '');
					dlab[i].setAttribute('x', f1(b.x + 5));
					dlab[i].setAttribute('y', f1(b.y + 4));
					dlab[i].textContent = stopped ? (i ? '10 м' : '2,5 м') : '';
				});
			});
		}
	}
</script>
