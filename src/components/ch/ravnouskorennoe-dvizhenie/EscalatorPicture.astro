---
/**
 * Picture for the definition of uniform straight motion: a metro escalator in a side view (the near balustrade cut
 * away), inclined at 30°, one scale on both axes: 48 px per metre. A passenger (168 см, people kit) stands on a step
 * holding the handrails (near and far; in the side view they lie on one line), which move with the steps, and rides up at a steady υ = 0,75 м/с (a usual
 * escalator speed). Real time: 4 с of motion, 2 с of the end frame, loop.
 * As on a photograph with a flash once a second, the center of her head is marked by a dot at t = 0, 1, 2, 3, 4 с: the
 * dots lie on one straight line, 0,75 м apart (36 px). On her chest the velocity (blue, 80 px per м/с: 60 px) with its
 * components along the axes: υₓ = υ cos 30° = 0,65 м/с, υ_y = υ sin 30° = 0,375 ≈ 0,38 м/с (dashed). In the end frame
 * the displacement over 4 с, s = 3 м (gold, 144 px), from the first dot to the last, with its projections on the axes,
 * sₓ = 3 cos 30° = 2,6 м and s_y = 3 sin 30° = 1,5 м (thick gold segments, dashed drops). The axes start at the lower
 * comb plate O: Ox along the floor, Oy up. The steps (tread 40 см, riser 23 см) move with the passenger; the lamps of
 * the tunnel stay.
 */
import RdStyles from './RdStyles.astro';

const K = 48;
const O = { x: 46, y: 222 };
const C30 = Math.cos(Math.PI / 6);
const S30 = 0.5;
const D = 5.4; // м along the incline, the upper comb plate
const N = (d: number) => ({ x: O.x + d * C30 * K, y: O.y - d * S30 * K });
const f = (v: number) => v.toFixed(1);
const top = N(D);
const HR = 0.95 * K; // the handrail above the line of the step noses, px (vertical)
// the tunnel: its vault 2,9 м above the steps, lamps 2,45 м above them every 1,1 м
const vault = (d: number) => ({ x: N(d).x, y: N(d).y - 2.9 * K });
const lamps = Array.from({ length: 5 }, (_, k) => {
	const p = N(1.4 + k * 1.1);
	return { x: p.x, y: p.y - 2.45 * K };
}).filter((p) => p.y > 6);
const tickX = [1, 2, 3, 4, 5, 6];
const tickY = [1, 2, 3, 4];
---

<RdStyles />
<figure class="g7 g7--pic rdm not-content" data-rdesc>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 250" role="img" aria-label="Пассажир поднимается на эскалаторе с постоянной скоростью; положение его головы отмечено точкой каждую секунду, точки лежат на прямой на равных расстояниях; показаны скорость, перемещение за 4 секунды и их проекции на оси">
			<!-- the tunnel wall and vault -->
			<path class="es-wall" d={`M0 0 H400 V${f(top.y)} H${f(top.x)} L${f(O.x)} ${f(O.y)} H0 Z`}></path>
			<path class="es-vault" d={`M${f(vault(-1).x)} ${f(vault(-1).y)} L${f(vault(D + 2).x)} ${f(vault(D + 2).y)}`}></path>
			{lamps.map((p) => (
				<g>
					<line class="es-rod" x1={f(p.x)} y1={f(p.y - 0.5 * K + 0.5 * C30 * 0)} x2={f(p.x)} y2={f(p.y - 6)}></line>
					<circle class="es-lamp-glow" cx={f(p.x)} cy={f(p.y)} r="13"></circle>
					<circle class="es-lamp" cx={f(p.x)} cy={f(p.y)} r="6"></circle>
				</g>
			))}
			<!-- the floors -->
			<rect class="es-floor" x="0" y={O.y} width={O.x} height={250 - O.y}></rect>
			<rect class="es-floor" x={f(top.x)} y={f(top.y)} width={f(400 - top.x)} height="8"></rect>
			<!-- the far balustrade: glass and handrail -->
			<path class="es-glass" d={`M${f(O.x - 10)} ${f(O.y - HR)} L${f(top.x + 10)} ${f(top.y - HR)} L${f(top.x + 10)} ${f(top.y)} L${f(O.x - 10)} ${f(O.y)} Z`}></path>
			<path class="es-rail" d={`M${f(O.x - 22)} ${f(O.y - HR + 6)} Q${f(O.x - 16)} ${f(O.y - HR)} ${f(O.x - 8)} ${f(O.y - HR)} L${f(top.x + 8)} ${f(top.y - HR)} Q${f(top.x + 16)} ${f(top.y - HR)} ${f(top.x + 22)} ${f(top.y - HR + 6)}`}></path>
			<!-- the truss under the steps -->
			<path class="es-truss" d={`M${f(O.x - 6)} ${f(O.y + 2)} L${f(top.x + 6)} ${f(top.y + 2)} L${f(top.x + 6)} ${f(top.y + 30)} L${f(O.x + 30)} ${f(O.y + 22)} Z`}></path>
			<g data-steps></g>
			<path class="es-comb" d={`M${f(O.x - 14)} ${f(O.y)} H${f(O.x + 4)} M${f(top.x - 4)} ${f(top.y)} H${f(top.x + 14)}`}></path>
			<!-- axes from O -->
			<g class="es-axes">
				<path class="rd-axis" d={`M${O.x} ${O.y} H390`}></path>
				<path class="rd-axis-head" d={`M396 ${O.y} l-9 -4 v8 Z`}></path>
				<path class="rd-axis" d={`M${O.x} ${O.y} V14`}></path>
				<path class="rd-axis-head" d={`M${O.x} 8 l-4 9 h8 Z`}></path>
				{tickX.map((m) => <line class="rd-axis" x1={O.x + m * K} y1={O.y} x2={O.x + m * K} y2={O.y + 5}></line>)}
				{tickX.map((m) => <text class="t-small t-num" x={O.x + m * K} y={O.y + 19} text-anchor="middle">{m}</text>)}
				{tickY.map((m) => <line class="rd-axis" x1={O.x} y1={O.y - m * K} x2={O.x - 5} y2={O.y - m * K}></line>)}
				{tickY.map((m) => <text class="t-small t-num" x={O.x - 8} y={O.y - m * K + 4} text-anchor="end">{m}</text>)}
				<text class="t-small" x={O.x - 8} y={O.y + 19} text-anchor="end">O</text>
				<text x="392" y={O.y - 8} text-anchor="end"><tspan class="t-i">x</tspan>, м</text>
				<text x={O.x + 8} y="20"><tspan class="t-i">y</tspan>, м</text>
			</g>
			<g data-proj></g>
			<g data-dots></g>
			<g data-rider></g>
			<!-- the near handrail: in a side view it lies over the far one; drawn in front of the passenger, who holds it -->
			<path class="es-rail es-rail--near" d={`M${f(O.x - 22)} ${f(O.y - HR + 6)} Q${f(O.x - 16)} ${f(O.y - HR)} ${f(O.x - 8)} ${f(O.y - HR)} L${f(top.x + 8)} ${f(top.y - HR)} Q${f(top.x + 16)} ${f(top.y - HR)} ${f(top.x + 22)} ${f(top.y - HR + 6)}`}></path>
			<g data-vel>
				<path class="rd-dash-blue" data-vx d=""></path>
				<path class="rd-dash-blue" data-vy d=""></path>
				<path class="arrow arrow--blue" data-va d=""></path>
				<path class="head--blue" data-vh d=""></path>
				<text class="rd-label-blue" data-vl><tspan class="t-i">υ</tspan></text>
				<text class="rd-label-blue" data-vxl><tspan class="t-i">υ</tspan><tspan class="t-sub" dy="4">x</tspan></text>
				<text class="rd-label-blue" data-vyl><tspan class="t-i">υ</tspan><tspan class="t-sub" dy="4">y</tspan></text>
			</g>
			<g data-disp>
				<path class="arrow arrow--gold" data-sa d=""></path>
				<path class="head--gold" data-sh d=""></path>
				<text class="rd-label-gold t-halo" data-sl><tspan class="t-i">s</tspan> = 3 м</text>
			</g>
			<text class="t-strong t-num t-halo" data-clock x="392" y="34" text-anchor="end"></text>
		</svg>
		<ul class="rd-read">
			<li class="c-blue">скорость <b>0,75 м/с</b>: <i>υ</i><sub>x</sub> = <b>0,65 м/с</b>, <i>υ</i><sub>y</sub> = <b>0,38 м/с</b></li>
			<li class="c-gold" data-sread>перемещение за 4 с <b>3 м</b>: <i>s</i><sub>x</sub> = <b>2,6 м</b>, <i>s</i><sub>y</sub> = <b>1,5 м</b></li>
		</ul>
	</div>
	<figcaption class="g7__caption">
		Пассажир эскалатора: положение его головы отмечено точкой через каждую секунду. Точки лежат на одной прямой на равных
		расстояниях — за любую секунду одно и то же перемещение, 0,75&nbsp;м. Масштаб одинаков по обеим осям, время реальное.
	</figcaption>
</figure>

<style is:global>
	.rdm[data-rdesc] .es-wall {
		fill: color-mix(in oklab, var(--g7-gold) 8%, var(--sl-color-gray-6));
	}
	.rdm[data-rdesc] .es-vault {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 3;
	}
	.rdm[data-rdesc] .es-rod {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.rdm[data-rdesc] .es-lamp {
		fill: color-mix(in oklab, var(--g7-gold) 60%, white);
	}
	.rdm[data-rdesc] .es-lamp-glow {
		fill: color-mix(in oklab, var(--g7-gold) 30%, transparent);
	}
	.rdm[data-rdesc] .es-floor {
		fill: var(--sl-color-gray-4);
	}
	.rdm[data-rdesc] .es-glass {
		fill: color-mix(in oklab, var(--g7-blue) 12%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.rdm[data-rdesc] .es-rail {
		fill: none;
		stroke: var(--hm-line, var(--sl-color-gray-1));
		stroke-width: 4.5;
		stroke-linecap: round;
	}
	.rdm[data-rdesc] .es-rail--near {
		stroke-width: 4;
	}
	.rdm[data-rdesc] .es-truss {
		fill: color-mix(in oklab, var(--g7-blue) 10%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.rdm[data-rdesc] .es-step {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.rdm[data-rdesc] .es-comb {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.5;
	}
	.rdm[data-rdesc] .es-hd {
		fill: var(--sl-color-gray-1);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	.rdm[data-rdesc] [data-sread] {
		transition: opacity 0.3s;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, setArrow, num } from './rd';
	import { figure } from '@components/people/body';

	const K = 48;
	const O = { x: 46, y: 222 };
	const C30 = Math.cos(Math.PI / 6);
	const S30 = 0.5;
	const D = 5.4;
	const V = 0.75; // м/с
	const D0 = 0.9; // м along the incline: the passenger's step at t = 0
	const P_STEP = 0.4 / C30; // the steps repeat every 0,462 м along the incline
	const H = 168;
	const S = K / 100; // px per см
	const HEAD = 0.92 * H * S; // the center of the head above the soles (kit: hip 0,52 H + head center 0,40 H)
	const CHEST = 0.68 * H * S;
	const RUN = 4;
	const HOLD = 2;
	const N = (d: number) => ({ x: O.x + d * C30 * K, y: O.y - d * S30 * K });
	const f = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-rdesc]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const steps = $<SVGGElement>('[data-steps]');
		const stepPath = el('path', { class: 'es-step', d: '' });
		steps.append(stepPath);
		const dots = $<SVGGElement>('[data-dots]');
		const proj = $<SVGGElement>('[data-proj]');
		const riderG = $<SVGGElement>('[data-rider]');
		const personG = el('g', {});
		riderG.append(personG);
		const person = figure(personG, { s: S, H, clothes: 'indoor', shirt: 'hm-red', hair: 'pony', name: 'passenger' });
		const vel = $<SVGGElement>('[data-vel]');
		const disp = $<SVGGElement>('[data-disp]');
		const clock = $<SVGTextElement>('[data-clock]');
		const sread = $<HTMLElement>('[data-sread]');

		// the feet point of the passenger (middle of her tread) for the step whose nose is at d along the incline
		const feet = (d: number) => {
			const n = N(d);
			return { x: n.x + 0.2 * K, y: n.y };
		};
		const headAt = (t: number) => {
			const p = feet(D0 + V * t);
			return { x: p.x, y: p.y - HEAD };
		};
		// the pose in her own frame (origin at the feet point): standing, both hands on the handrails
		const yRail = (x: number) => -0.95 * K - Math.tan(Math.PI / 6) * (x + 0.2 * K);
		const hip = { x: 0, y: -0.52 * H * S + 0.6 };
		const ank = -0.045 * H * S;
		person.pose({
			hip,
			lean: 0.03,
			head: 0.05,
			ankles: [
				{ x: 0.04 * H * S, y: ank },
				{ x: -0.03 * H * S, y: ank },
			],
			feet: [0, 0],
			planted: [true, true],
			hands: [
				{ at: { x: 0.24 * K, y: yRail(0.24 * K) }, pose: 'grip', d: 5, contact: 'near handrail' },
				{ at: { x: 0.12 * K, y: yRail(0.12 * K) }, pose: 'grip', d: 5, contact: 'far handrail' },
			],
		});

		const draw = (t: number) => {
			const d = D0 + V * t;
			// the steps: noses every P_STEP along the incline, phase locked to the passenger's step
			let path = '';
			const first = d - Math.ceil((d - 0.25) / P_STEP) * P_STEP;
			for (let dn = first; dn < D - 0.3; dn += P_STEP) {
				const a = N(dn);
				const b = N(dn + P_STEP);
				path += `M${f(a.x)} ${f(a.y)} H${f(Math.min(b.x, a.x + 0.4 * K))} L${f(b.x)} ${f(b.y)} L${f(b.x)} ${f(b.y + 8)} L${f(a.x)} ${f(a.y + 8)} Z `;
			}
			stepPath.setAttribute('d', path);
			const p = feet(d);
			personG.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)})`);
			// strobe dots at whole seconds
			dots.replaceChildren();
			for (let k = 0; k <= Math.min(4, Math.floor(t + 1e-6)); k++) {
				const h = headAt(k);
				dots.append(el('circle', { class: 'es-hd', cx: f(h.x), cy: f(h.y), r: 3.6 }));
			}
			// the velocity on the chest while she moves
			const moving = t < RUN - 1e-6;
			vel.style.display = moving ? '' : 'none';
			if (moving) {
				const c = { x: p.x + 0.05 * K, y: p.y - CHEST };
				const L = 80 * V;
				const e = { x: c.x + L * C30, y: c.y - L * S30 };
				setArrow($('[data-va]'), $('[data-vh]'), c.x, c.y, e.x, e.y);
				// the components head to tail: υₓ along Ox from the chest, then υ_y up to the tip
				$('[data-vx]').setAttribute('d', `M${f(c.x)} ${f(c.y)} H${f(e.x)}`);
				$('[data-vy]').setAttribute('d', `M${f(e.x)} ${f(c.y)} V${f(e.y)}`);
				const vl = $('[data-vl]');
				vl.setAttribute('x', f(e.x - 14));
				vl.setAttribute('y', f(e.y - 6));
				const vxl = $('[data-vxl]');
				vxl.setAttribute('x', f(c.x + L * C30 * 0.4));
				vxl.setAttribute('y', f(c.y + 16));
				const vyl = $('[data-vyl]');
				vyl.setAttribute('x', f(e.x + 5));
				vyl.setAttribute('y', f(c.y - 2));
			}
			// the displacement and its projections in the end frame
			const done = !moving;
			disp.style.display = done ? '' : 'none';
			sread.style.opacity = done ? '1' : '0.35';
			proj.replaceChildren();
			if (done) {
				const a = headAt(0);
				const b = headAt(4);
				setArrow($('[data-sa]'), $('[data-sh]'), a.x, a.y, b.x, b.y, 10, 5);
				const sl = $('[data-sl]');
				sl.setAttribute('x', f((a.x + b.x) / 2 - 46));
				sl.setAttribute('y', f((a.y + b.y) / 2 - 10));
				const add = (cls: string, dd: string) => proj.append(el('path', { class: cls, d: dd }));
				add('rd-drop', `M${f(a.x)} ${f(a.y)} V${O.y} M${f(b.x)} ${f(b.y)} V${O.y} M${f(a.x)} ${f(a.y)} H${O.x} M${f(b.x)} ${f(b.y)} H${O.x}`);
				add('rd-proj-gold', `M${f(a.x)} ${O.y - 2.5} H${f(b.x)} M${O.x + 2.5} ${f(a.y)} V${f(b.y)}`);
				const tx = el('text', { class: 'rd-label-gold t-halo', x: f((a.x + b.x) / 2), y: O.y - 8, 'text-anchor': 'middle' });
				tx.innerHTML = '<tspan class="t-i">s</tspan><tspan class="t-sub" dy="4">x</tspan><tspan dy="-4"> = 2,6 м</tspan>';
				const ty = el('text', { class: 'rd-label-gold t-halo', x: O.x + 9, y: f((a.y + b.y) / 2 + 5) });
				ty.innerHTML = '<tspan class="t-i">s</tspan><tspan class="t-sub" dy="4">y</tspan><tspan dy="-4"> = 1,5 м</tspan>';
				proj.append(tx, ty);
			}
			clock.textContent = `t = ${num(Math.min(t, RUN), 1)} с`;
		};

		let clockT = 0;
		draw(0);
		loop(root, (dt) => {
			clockT = (clockT + dt) % (RUN + HOLD);
			draw(Math.min(clockT, RUN));
			return true;
		});
	}
</script>
