---
/**
 * Picture for the definition of acceleration: three cars seen from above, each changing its velocity in t = 5 с
 * (real time: 5 с of motion, 4 с of the end frame, loop). Above, the road (1,6 px per metre; the cars, 4,4 м,
 * drawn twice larger) with the car's velocity (blue, 3,5 px per м/с); below, the vectors from one point: the initial
 * velocity υ₀ and the final one υ (blue, 3,5 px per м/с) and their difference Δυ = υ − υ₀ (red, dashed) drawn from the tip
 * of υ₀ to the tip of υ. υ and Δυ grow with the motion (their labels give the current values); the acceleration
 * a = Δυ/t (red, 12 px per м/с²) is drawn on the car all the time on the straight road, and for the turn its average
 * appears in the end frame.
 *   «Разгоняется»: 10 → 20 м/с along the road, Δυ = 10 м/с, a = 2 м/с² along the velocity; path 75 м.
 *   «Тормозит»: 20 → 5 м/с, Δυ = 15 м/с against the velocity, a = 3 м/с²; path 62,5 м.
 *   «Поворачивает»: a quarter turn to the left at a steady 10 м/с (arc 50 м, radius 50/(π/2) = 31,8 м): υ₀ to the east,
 *   υ to the north, |Δυ| = 10√2 = 14,1 м/с to the north-west, the average acceleration 14,1/5 = 2,8 м/с², drawn at the
 *   middle of the turn, where it points to the center of the turn.
 * In the straight panels υ₀, Δυ and υ lie on one line; they are drawn in three rows one under the other.
 */
import RdStyles from './RdStyles.astro';

const panels = [
	{ id: 'up', title: 'Разгоняется' },
	{ id: 'down', title: 'Тормозит' },
	{ id: 'turn', title: 'Поворачивает' },
];
---

<RdStyles />
<figure class="g7 g7--pic rdm not-content" data-rddv>
	<div class="g7__grid dv-grid">
		{panels.map((p) => (
			<div class="dv-panel">
				<p class="dv-title">{p.title}</p>
				<svg class="g7__svg" viewBox="0 0 220 150" role="img" data-panel={p.id} aria-label={`${p.title}: начальная и конечная скорости, их разность и ускорение`}>
					<rect class="dv-grass" x="0" y="0" width="220" height="72"></rect>
					<path class="dv-road" data-road d=""></path>
					<path class="dv-lane" data-lane d=""></path>
					<g data-car></g>
					<path class="arrow arrow--blue" data-cva d=""></path>
					<path class="head--blue" data-cvh d=""></path>
					<path class="arrow arrow--red" data-caa d=""></path>
					<path class="head--red" data-cah d=""></path>
					<text class="rd-label-red t-halo" data-cal></text>
					<path class="rd-drop" data-guides d=""></path>
					<path class="arrow arrow--blue" data-v0a d=""></path>
					<path class="head--blue" data-v0h d=""></path>
					<text class="rd-label-blue" data-v0l></text>
					<path class="rd-dash-red" data-dva d=""></path>
					<path class="head--red" data-dvh d=""></path>
					<text class="rd-label-red" data-dvl></text>
					<path class="arrow arrow--blue" data-v1a d=""></path>
					<path class="head--blue" data-v1h d=""></path>
					<text class="rd-label-blue" data-v1l></text>
				</svg>
			</div>
		))}
	</div>
	<p class="dv-note">Справа скорость по модулю та же, а ускорение есть: изменилось направление скорости.</p>
	<figcaption class="g7__caption">
		Три автомобиля за 5&nbsp;с меняют скорость. Внизу начальная скорость <i>υ</i><sub>0</sub>, конечная <i>υ</i> и их
		разность Δ<i>υ</i>, проведённая от конца <i>υ</i><sub>0</sub> к концу <i>υ</i>; ускорение <i>a</i> = Δ<i>υ</i>/<i>t</i>{' '}
		направлено так же, как Δ<i>υ</i>. Вид сверху, время реальное, автомобили увеличены в 2&nbsp;раза.
	</figcaption>
</figure>

<style is:global>
	.rdm[data-rddv].g7--pic {
		max-width: 44rem;
	}
	.rdm[data-rddv] .dv-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@media (max-width: 40rem) {
		.rdm[data-rddv] .dv-grid {
			grid-template-columns: minmax(0, 1fr);
			max-width: 15rem;
			margin-inline: auto;
		}
	}
	.rdm[data-rddv] .dv-title {
		margin: 0 0 0.3rem;
		text-align: center;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.rdm[data-rddv] .dv-note {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rdm[data-rddv] .dv-grass {
		fill: color-mix(in oklab, hsl(150, 45%, 45%) 16%, var(--g7-paper));
	}
	.rdm[data-rddv] .dv-road {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-5) 85%, var(--g7-paper));
		stroke-width: 22;
	}
	.rdm[data-rddv] .dv-lane {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 6 6;
	}
	.rdm[data-rddv] .dv-body {
		fill: var(--g7-gold);
		stroke: var(--hm-line, var(--sl-color-gray-1));
		stroke-width: 0.6;
	}
	.rdm[data-rddv] .dv-glass {
		fill: color-mix(in oklab, var(--g7-blue) 35%, var(--sl-color-gray-6));
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, setArrow, numT } from './rd';

	const KR = 1.6; // px per metre on the road
	const KV = 3.5; // px per м/с
	const KA = 12; // px per м/с²
	const T = 5;
	const HOLD = 4;
	const f = (v: number) => v.toFixed(1);
	type Pt = { x: number; y: number };
	interface Panel {
		pos: (t: number) => Pt; // the car's place on the road
		vel: (t: number) => Pt; // its velocity, м/с (screen axes, y down)
		road: string;
		aAt: (t: number) => Pt; // where the acceleration is drawn
		a: Pt; // the acceleration (average for the turn), м/с²
		aText: string;
		aAlways: boolean;
		rows: boolean; // straight motion: the vectors in three rows
	}
	const RY = 30; // the straight road
	const straight = (v0: number, v1: number): Panel => {
		const a = (v1 - v0) / T;
		const pos = (t: number) => ({ x: 24 + KR * (v0 * t + (a * t * t) / 2), y: RY });
		return {
			pos,
			vel: (t) => ({ x: v0 + a * t, y: 0 }),
			road: `M0 ${RY} H220`,
			aAt: (t) => ({ x: pos(t).x - 4.4 * KR, y: RY + 20 }),
			a: { x: a, y: 0 },
			aText: `a = ${Math.abs(a)} м/с²`,
			aAlways: true,
			rows: true,
		};
	};
	// the quarter turn: center (44, 12), radius 50/(π/2) м
	const RT = (50 / (Math.PI / 2)) * KR;
	const CT = { x: 44, y: 12 };
	const turn: Panel = {
		pos: (t) => {
			const th = (Math.PI / 2) * (t / T);
			return { x: CT.x + RT * Math.sin(th), y: CT.y + RT * Math.cos(th) };
		},
		vel: (t) => {
			const th = (Math.PI / 2) * (t / T);
			return { x: 10 * Math.cos(th), y: -10 * Math.sin(th) };
		},
		road: `M0 ${f(CT.y + RT)} H${CT.x} A${f(RT)} ${f(RT)} 0 0 0 ${f(CT.x + RT)} ${CT.y} V0`,
		aAt: () => ({ x: CT.x + RT * Math.SQRT1_2, y: CT.y + RT * Math.SQRT1_2 }),
		a: { x: -2 * Math.SQRT1_2, y: -2 * Math.SQRT1_2 },
		aText: 'a ≈ 2,8 м/с²',
		aAlways: false,
		rows: false,
	};
	const PANELS: Record<string, Panel> = { up: straight(10, 20), down: straight(20, 5), turn };

	const carTop = (g: SVGGElement) => {
		const L = 4.4 * KR * 2;
		const W = 1.8 * KR * 2;
		g.append(el('rect', { class: 'dv-body', x: -L, y: -W / 2, width: L, height: W, rx: 2.5 }));
		g.append(el('rect', { class: 'dv-glass', x: -L * 0.42, y: -W / 2 + 1, width: L * 0.16, height: W - 2, rx: 1 }));
		g.append(el('rect', { class: 'dv-glass', x: -L * 0.86, y: -W / 2 + 1.2, width: L * 0.1, height: W - 2.4, rx: 1 }));
	};
	const label = (t: Element, x: number, y: number, s: string, anchor = 'start') => {
		t.setAttribute('x', f(x));
		t.setAttribute('y', f(y));
		t.setAttribute('text-anchor', anchor);
		t.textContent = s;
	};
	const ms = (v: number) => `${numT(v, 1)} м/с`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-rddv]')) {
		const svgs = [...root.querySelectorAll<SVGSVGElement>('[data-panel]')];
		const setups = svgs.map((svg) => {
			const P = PANELS[svg.dataset.panel!];
			const $ = <T extends Element>(s: string) => svg.querySelector<T>(s)!;
			$('[data-road]').setAttribute('d', P.road);
			const car = $<SVGGElement>('[data-car]');
			carTop(car);
			const O = P.rows ? { x: 24, y: 92 } : { x: 70, y: 132 };
			const v0 = P.vel(0);
			return (t: number) => {
				const p = P.pos(t);
				const v = P.vel(t);
				const ang = (Math.atan2(v.y, v.x) * 180) / Math.PI;
				car.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)}) rotate(${f(ang)})`);
				const sp = Math.hypot(v.x, v.y);
				const ux = v.x / sp;
				const uy = v.y / sp;
				setArrow($('[data-cva]'), $('[data-cvh]'), p.x + ux * 2, p.y + uy * 2, p.x + ux * (2 + sp * KV), p.y + uy * (2 + sp * KV));
				// the acceleration: on the car all the time (straight road), the average one at the end (the turn)
				const showA = P.aAlways || t >= T;
				if (showA) {
					const aa = P.aAt(t);
					setArrow($('[data-caa]'), $('[data-cah]'), aa.x, aa.y, aa.x + P.a.x * KA, aa.y + P.a.y * KA);
					label($('[data-cal]'), P.rows ? aa.x + P.a.x * KA * 0.5 : aa.x + 6, P.rows ? aa.y + 16 : aa.y + 16, P.aText, P.rows ? 'middle' : 'start');
				} else {
					$('[data-caa]').setAttribute('d', '');
					$('[data-cah]').setAttribute('d', '');
					$('[data-cal]').textContent = '';
				}
				// the vectors: υ₀ fixed, υ and Δυ = υ − υ₀ as they are now
				const dv = { x: v.x - v0.x, y: v.y - v0.y };
				const dvm = Math.hypot(dv.x, dv.y);
				if (P.rows) {
					const y0 = O.y;
					const y1 = O.y + 22;
					const y2 = O.y + 44;
					const x0 = O.x + v0.x * KV;
					const x1 = O.x + v.x * KV;
					setArrow($('[data-v0a]'), $('[data-v0h]'), O.x, y0, x0, y0);
					label($('[data-v0l]'), Math.max(x0, O.x) + 6, y0 + 5, `υ₀ = ${ms(v0.x)}`);
					setArrow($('[data-v1a]'), $('[data-v1h]'), O.x, y2, x1, y2);
					label($('[data-v1l]'), x1 + 6, y2 + 5, `υ = ${ms(v.x)}`);
					setArrow($('[data-dva]'), $('[data-dvh]'), x0, y1, x1, y1, 6, 3);
					label($('[data-dvl]'), Math.max(x0, x1) + 6, y1 + 5, dvm > 0.05 ? `Δυ = ${ms(dvm)}` : '');
					$('[data-guides]').setAttribute('d', `M${O.x} ${y0 - 6} V${y2 + 6} M${f(x0)} ${y0} V${y1} M${f(x1)} ${y1} V${y2}`);
				} else {
					const t0 = { x: O.x + v0.x * KV, y: O.y + v0.y * KV };
					const t1 = { x: O.x + v.x * KV, y: O.y + v.y * KV };
					setArrow($('[data-v0a]'), $('[data-v0h]'), O.x, O.y, t0.x, t0.y);
					label($('[data-v0l]'), t0.x + 4, t0.y + 5, 'υ₀ = 10 м/с');
					setArrow($('[data-v1a]'), $('[data-v1h]'), O.x, O.y, t1.x, t1.y);
					label($('[data-v1l]'), t1.x + (t1.x > t0.x - 1 ? 6 : -6), t1.y + (t1.y < O.y - 20 ? 4 : -6), 'υ = 10 м/с', t1.x > t0.x - 1 ? 'start' : 'end');
					$('[data-v1l]').textContent = t > 0.4 ? 'υ = 10 м/с' : '';
					$('[data-guides]').setAttribute('d', '');
					setArrow($('[data-dva]'), $('[data-dvh]'), t0.x, t0.y, t1.x, t1.y, 6, 3);
					label($('[data-dvl]'), (t0.x + t1.x) / 2 + 9, (t0.y + t1.y) / 2, dvm > 0.5 ? `Δυ ≈ ${ms(dvm)}` : '');
				}
			};
		});
		let clock = 0;
		setups.forEach((s) => s(0));
		loop(root, (dt) => {
			clock = (clock + dt) % (T + HOLD);
			const t = Math.min(clock, T);
			setups.forEach((s) => s(t));
			return true;
		});
	}
</script>
