---
/**
 * Pictures for the definitions of uniform and uniformly accelerated straight motion: a car on an axis Ox, its
 * position marked by a dot every second (as on a photograph taken with flashes once a second), the gaps between the
 * dots written in metres, the velocity (blue) and, when there is one, the acceleration (red) drawn on the moving car.
 * Real time; after the run the last frame stays 2 s and the run repeats.
 *
 * mode="uniform" (8 px per metre, 0…45 м; arrows 4 px per м/с): a car at υx = 10 м/с from x = 0 (gaps 10 м), another
 *   at υx = −5 м/с from x = 40 м (gaps 5 м, moving against the axis), 4 s.
 * mode="accel" (11 px per metre, 0…28 м; velocity 4 px per м/с, acceleration 10 px per м/с²), 5 s:
 *   speeding up from rest with a = 2 м/с²: x = t², dots at 0, 1, 4, 9, 16, 25 м, gaps 1, 3, 5, 7, 9 м, υ = 0, 2, …, 10 м/с;
 *   braking from 10 м/с with a = −2 м/с²: x = 10t − t², dots at 0, 9, 16, 21, 24, 25 м, gaps 9, 7, 5, 3, 1 м, υ down to 0.
 * The cars (4,4 м) are drawn to the scale of the axis.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';
import { carCss } from './car';

interface Props {
	mode: 'uniform' | 'accel';
}
const { mode } = Astro.props;
const cfg =
	mode === 'uniform'
		? {
				K: 7.2,
				max: 45,
				step: 5,
				T: 4,
				rows: [
					{ x0: 0, v0: 10, a: 0, pre: '', sym: 'υ', rest: ' = 10 м/с', car: 'cr-gold' },
					{ x0: 40, v0: -5, a: 0, pre: '', sym: 'υ', rest: ' = −5 м/с', car: 'cr-blue' },
				],
			}
		: {
				K: 11.4,
				max: 28,
				step: 5,
				T: 5,
				rows: [
					{ x0: 0, v0: 0, a: 2, pre: 'разгон: ', sym: 'a', rest: ' = 2 м/с²', car: 'cr-gold' },
					{ x0: 0, v0: 10, a: -2, pre: 'торможение: ', sym: 'a', rest: ' = −2 м/с²', car: 'cr-blue' },
				],
			};
const OX = 22;
const ROW = 112;
const H = cfg.rows.length * ROW + 6;
const css = carCss('[data-strobe]');
---

<G7Styles />
<PeopleStyles />
<Fragment set:html={`<style>${css}</style>`} />
<figure class="g7 g7--pic not-content" data-strobe data-cfg={JSON.stringify({ ...cfg, OX, ROW })}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox={`0 0 360 ${H}`} role="img" aria-label={mode === 'uniform' ? 'Два автомобиля движутся равномерно в разные стороны; их положения через каждую секунду отмечены точками на равных расстояниях' : 'Автомобиль разгоняется и тормозит; его положения через каждую секунду отмечены точками, расстояния между ними растут или уменьшаются'}>
			{
				cfg.rows.map((r, i) => {
					const y = i * ROW;
					return (
						<g transform={`translate(0 ${y})`}>
							<text class="t-title" x="10" y="106">{r.pre}<tspan class="t-i">{r.sym}</tspan><tspan baseline-shift="sub" font-size="9">x</tspan>{r.rest}</text>
							<rect class="sb-road" x="0" y="48" width="360" height="12" />
							<path class="ink" d={`M${OX - 8} 74 H350`} />
							<path class="head--ink" d="M355 74 l-8 -4 v8 Z" />
							{Array.from({ length: Math.floor(cfg.max / cfg.step) + 1 }, (_, k) => k * cfg.step).filter((m) => OX + m * cfg.K < 326).map((m) => (
								<>
									<line class="ln" x1={OX + m * cfg.K} y1="70" x2={OX + m * cfg.K} y2="78" />
									<text class="t-small t-num" x={OX + m * cfg.K} y="90" text-anchor="middle">{m}</text>
								</>
							))}
							<text x="352" y="92" text-anchor="end"><tspan class="t-i">x</tspan>, м</text>
							<g data-dots />
							<g data-gaps />
							<g data-carwrap><g data-car /></g>
							<path class="arrow arrow--blue" data-va d="" />
							<path class="head--blue" data-vh d="" />
							<path class="arrow arrow--red" data-aa d="" />
							<path class="head--red" data-ah d="" />
							<text class="t-small t-strong t-num t-halo" data-vt text-anchor="middle"></text>
						</g>
					);
				})
			}
		</svg>
	</div>
	<figcaption class="g7__caption">
		{
			mode === 'uniform'
				? 'Точки — положения автомобилей через каждую секунду. За любую секунду каждый автомобиль совершает одно и то же перемещение: первый — 10\u00a0м по оси, второй — 5\u00a0м против оси. Синие стрелки — скорости. Часы идут как настоящие, автомобили нарисованы в масштабе оси.'
				: 'Точки — положения автомобиля через каждую секунду. Синяя стрелка — скорость, красная — ускорение. При разгоне скорость каждую секунду растёт на 2\u00a0м/с, расстояния между точками растут как 1, 3, 5, 7, 9; при торможении — наоборот. Часы идут как настоящие.'
		}
	</figcaption>
</figure>

<style is:global>
	[data-strobe] .sb-road {
		fill: var(--sl-color-gray-6);
	}
	[data-strobe] .sb-dot {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	[data-strobe] .sb-dot--blue {
		fill: var(--g7-blue);
	}
	[data-strobe] .sb-tick {
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
</style>

<script>
	import { el, fmtTrim, loop } from '../g7/kit';
	import { car, LEN } from './car';

	type Row = { x0: number; v0: number; a: number; car: string };
	type Cfg = { K: number; max: number; T: number; rows: Row[]; OX: number; ROW: number };
	const HOLD = 2;
	const arrow = (x0: number, y: number, len: number) => {
		if (Math.abs(len) < 1.5) return ['', ''];
		const d = Math.sign(len);
		const x1 = x0 + len;
		const b = x1 - d * 6;
		return [`M${x0.toFixed(1)} ${y} H${b.toFixed(1)}`, `M${x1.toFixed(1)} ${y} L${b.toFixed(1)} ${y - 3.6} L${b.toFixed(1)} ${y + 3.6} Z`];
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-strobe]')) {
		const cfg: Cfg = JSON.parse(root.dataset.cfg!);
		const { K, OX, T } = cfg;
		const S = K / 100;
		const rows = [...root.querySelectorAll<SVGGElement>('svg > g')].map((g, i) => {
			const r = cfg.rows[i];
			const q = <E extends Element>(s: string) => g.querySelector<E>(s)!;
			const dots = q<SVGGElement>('[data-dots]');
			const gaps = q<SVGGElement>('[data-gaps]');
			const pose = car(q<SVGGElement>('[data-car]'), S, r.car);
			const pos = (t: number) => r.x0 + r.v0 * t + (r.a * t * t) / 2;
			let lastLab = -1e9;
			const marks = Array.from({ length: T + 1 }, (_, k) => {
				const x = OX + pos(k) * K;
				// a time label only where it does not run into the previous one
				const room = Math.abs(x - lastLab) > 24;
				if (room) lastLab = x;
				const c = el('circle', { class: `sb-dot${i ? ' sb-dot--blue' : ''}`, cx: x.toFixed(1), cy: 74, r: 3.6 });
				const lab = el('text', { class: 't-small t-num', x: x.toFixed(1), y: 42, 'text-anchor': 'middle' }, room ? `${k} с` : '');
				const tick = el('line', { class: 'sb-tick', x1: x.toFixed(1), y1: 45, x2: x.toFixed(1), y2: 70 });
				dots.append(tick, c, lab);
				return [c, lab, tick];
			});
			const gapLabs = Array.from({ length: T }, (_, k) => {
				const a = pos(k);
				const b = pos(k + 1);
				const t = el('text', { class: 't-small t-num t-halo', x: (OX + ((a + b) / 2) * K).toFixed(1), y: 68, 'text-anchor': 'middle' }, fmtTrim(Math.abs(b - a), 1));
				gaps.append(t);
				return t;
			});
			return { g, r, q, pose, pos, marks, gapLabs };
		});
		let run = 0;
		const show = () => {
			const t = Math.min(run, T);
			for (const row of rows) {
				const { r, q, pose, pos, marks, gapLabs } = row;
				const x = pos(t);
				const v = r.v0 + r.a * t;
				const px = OX + x * K;
				// the car faces where it moves (the braking car keeps facing forward when it stops)
				const dir = r.v0 + r.a * 0.001 >= 0 ? 1 : -1;
				const front = px + (dir * LEN * S) / 2;
				q('[data-carwrap]').setAttribute('transform', dir > 0 ? '' : `translate(${(2 * front).toFixed(1)} 0) scale(-1 1)`);
				pose(front, 60, x * 100 * dir, r.a * v < 0);
				marks.forEach((m, k) => m.forEach((e) => e.setAttribute('opacity', k <= t + 1e-6 ? '1' : '0')));
				gapLabs.forEach((e, k) => e.setAttribute('opacity', k + 1 <= t + 1e-6 ? '1' : '0'));
				const [va, vh] = arrow(px, 20, v * 4);
				q('[data-va]').setAttribute('d', va);
				q('[data-vh]').setAttribute('d', vh);
				const [aa, ah] = arrow(px, 30, r.a * 10);
				q('[data-aa]').setAttribute('d', aa);
				q('[data-ah]').setAttribute('d', ah);
				const vt = q<SVGTextElement>('[data-vt]');
				vt.setAttribute('x', (px + v * 2).toFixed(1));
				vt.setAttribute('y', '11');
				vt.textContent = `${fmtTrim(Math.abs(v), 1)} м/с`;
			}
		};
		loop(root, (dt) => {
			run += dt;
			if (run > T + HOLD) run = 0;
			show();
			return true;
		});
		show();
	}
</script>
