---
/**
 * Model «Перемещение при равноускоренном движении»: a body (a point) moves along Ox from x₀ = 0 with the initial
 * velocity υ0x (−6…6 м/с) and the constant acceleration a_x (−2…2 м/с², step 0,5); the clock runs 0…8 s in real time
 * and repeats, or is set by hand. Shown: the body on the axis with its velocity (blue, 2 px per м/с) and acceleration
 * (red, 12 px per м/с²); the graph υx(t) (18 px per second) with the area under it from 0 to t shaded — gold above
 * the t axis, violet below it (that part counts negative); the graph x(t) drawn up to t.
 * The scales fit the motion chosen: the axis and the x(t) graph reach ±10, 20, 40, 60, 80 or 120 м, the smallest that
 * holds |x| over the 8 s; the υx(t) graph reaches ±4, 10, 20 or 30 м/с likewise. The numbers on the axes change with them.
 * Readouts computed by υx = υ0x + a_x t and s_x = υ0x t + a_x t²/2; the shaded area equals s_x.
 * Start: υ0x = 2 м/с, a_x = 1 м/с²: at t = 6 с υx = 8 м/с, s_x = 30 м = (2 + 8)/2 · 6. With υ0x = 6 м/с and
 * a_x = −1,5 м/с² the body stops at t = 4 с, 12 м from the start, and is back at x = 0 at t = 8 с (axis ±20 м).
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--stack not-content" data-accellab>
	<div class="g7__grid">
		<div class="ac-figs">
			<svg class="g7__svg" viewBox="0 0 370 70" role="img" aria-label="Тело движется вдоль оси Ox с постоянным ускорением; стрелки — скорость и ускорение">
				<g data-road></g>
				<path class="ac-trace" data-trace d=""></path>
				<path class="arrow arrow--blue" data-va d=""></path>
				<path class="head--blue" data-vh d=""></path>
				<path class="arrow arrow--red" data-aa d=""></path>
				<path class="head--red" data-ah d=""></path>
				<circle class="ac-body" data-body cy="40" r="6"></circle>
			</svg>
			<div class="ac-graphs">
				<div>
					<p>Скорость</p>
					<svg class="g7__svg" viewBox="0 0 196 148" role="img" aria-label="График проекции скорости от времени; площадь под ним равна перемещению"><g data-vg></g></svg>
				</div>
				<div>
					<p>Координата</p>
					<svg class="g7__svg" viewBox="0 0 196 148" role="img" aria-label="График координаты от времени"><g data-xg></g></svg>
				</div>
			</div>
		</div>
		<div class="ac-ctrl">
			<label class="g7__slider"><span>Начальная скорость <i>υ</i><sub>0x</sub></span><output data-o0></output><input type="range" min="-6" max="6" step="1" value="2" data-v0 aria-label="Проекция начальной скорости" /></label>
			<label class="g7__slider"><span>Ускорение <i>a<sub>x</sub></i></span><output data-oa></output><input type="range" min="-2" max="2" step="0.5" value="1" data-a aria-label="Проекция ускорения" /></label>
			<label class="g7__slider"><span>Время <i>t</i></span><output data-ot></output><input type="range" min="0" max="8" step="0.1" value="0" data-t aria-label="Время, секунды" /></label>
			<button type="button" class="g7__btn g7__again" data-again>Повторить</button>
		</div>
		<ul class="g7__lines" data-calc></ul>
	</div>
	<figcaption class="g7__caption">
		Тело показано точкой, синяя стрелка — его скорость, красная — ускорение. Закрашенная площадь под графиком скорости
		равна проекции перемещения <i>s<sub>x</sub></i>: золотая часть над осью времени считается со знаком «плюс», фиолетовая
		под осью — со знаком «минус». Часы идут как настоящие; масштаб осей подстраивается под движение.
	</figcaption>
</figure>

<style is:global>
	[data-accellab] .ac-body {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	[data-accellab] .ac-trace {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 3;
		opacity: 0.45;
		stroke-linecap: round;
	}
	[data-accellab] .ac-grid {
		stroke: var(--g7-faint);
		stroke-width: 1;
	}
	[data-accellab] .ac-line {
		fill: none;
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	[data-accellab] .ac-line--v {
		stroke: var(--g7-blue);
	}
	[data-accellab] .ac-line--x {
		stroke: var(--g7-gold);
	}
	[data-accellab] .ac-area {
		fill: color-mix(in srgb, var(--g7-gold) 30%, transparent);
		stroke: var(--g7-gold);
		stroke-width: 1;
	}
	[data-accellab] .ac-area--neg {
		fill: color-mix(in srgb, var(--g7-violet) 32%, transparent);
		stroke: var(--g7-violet);
	}
	[data-accellab] .ac-figs {
		display: grid;
		gap: 0.5rem;
	}
	[data-accellab] .ac-graphs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}
	[data-accellab] .ac-graphs p {
		margin: 0 0 0.2rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-1);
	}
	@container (max-width: 34rem) {
		[data-accellab] .ac-graphs {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	[data-accellab] .ac-now {
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	[data-accellab] .ac-ctrl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 0.6rem 1rem;
		align-items: end;
	}
</style>

<script>
	import { el, fmt, fmtTrim, k, loop } from '../g7/kit';

	const RX = 185; // x = 0 on the road
	const RW = 135; // px from x = 0 to the end of the road's range
	const O = { x: 34, y: 78 }; // the origin of both graphs
	const TK = 18; // px per second
	const HH = 56; // px from the t axis to the end of the value range
	const T = 8;
	const HOLD = 2;
	const XR = [10, 20, 40, 60, 80, 120];
	const VR = [4, 10, 20, 30];
	const c = (v: number, d = 2) => fmtTrim(v, d).replace(',', '{,}').replace('−', '-');
	const par = (v: number, d = 2) => (v < 0 ? `(${c(v, d)})` : c(v, d));
	const pick = (list: number[], need: number) => list.find((r) => r >= need - 1e-9) ?? list[list.length - 1];

	// the frame of a graph for the range ±R: axes, grid, numbers
	const frame = (g: SVGGElement, R: number, label: string, unit: string) => {
		g.replaceChildren();
		const ky = HH / R;
		const add = (tag: 'path' | 'text' | 'line', a: Record<string, string | number>, text?: string) => {
			const e = el(tag, a, text);
			g.append(e);
			return e;
		};
		const ticks = [-R, -R / 2, R / 2, R];
		for (const v of ticks) add('path', { class: 'ac-grid', d: `M${O.x} ${O.y - v * ky} H${O.x + T * TK}` });
		for (let t = 2; t <= T; t += 2) add('path', { class: 'ac-grid', d: `M${O.x + t * TK} ${O.y - HH} V${O.y + HH}` });
		add('path', { class: 'ink', d: `M${O.x} ${O.y} H${O.x + T * TK + 6} M${O.x} ${O.y + HH} V${O.y - HH - 8}` });
		add('path', { class: 'head--ink', d: `M${O.x + T * TK + 10} ${O.y} l-7 -3.5 v7 Z M${O.x} ${O.y - HH - 12} l-3.5 7 h7 Z` });
		for (const v of ticks) add('text', { class: 't-small t-num', x: O.x - 4, y: O.y - v * ky + 4, 'text-anchor': 'end' }, fmt(v, 0));
		for (let t = 2; t < T; t += 2) add('text', { class: 't-small t-num t-halo', x: O.x + t * TK, y: O.y + 13, 'text-anchor': 'middle' }, String(t));
		const lab = el('text', { class: 't-small', x: O.x + 6, y: O.y - HH - 2 });
		lab.innerHTML = `<tspan class="t-i">${label}</tspan>, ${unit}`;
		g.append(lab);
		const tl = el('text', { class: 't-small', x: O.x + T * TK + 12, y: O.y + 14, 'text-anchor': 'end' });
		tl.innerHTML = '<tspan class="t-i">t</tspan>, с';
		g.append(tl);
		const pos = add('path', { class: 'ac-area', d: '' });
		const neg = add('path', { class: 'ac-area ac-area--neg', d: '' });
		const line = add('path', { class: 'ac-line', d: '' });
		const now = add('line', { class: 'ac-now', y1: O.y + HH, y2: O.y - HH });
		const dot = add('circle', { r: 4, class: 'ac-body' });
		return { ky, pos, neg, line, now, dot };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-accellab]')) {
		const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const inp = (s: string) => q<HTMLInputElement>(s);
		const road = q<SVGGElement>('[data-road]');
		let vg: ReturnType<typeof frame>;
		let xg: ReturnType<typeof frame>;
		let rk = 1; // px per metre on the road
		let key = '';
		const setup = (v0: number, a: number) => {
			if (key === `${v0}/${a}`) return;
			key = `${v0}/${a}`;
			let xmax = 0;
			let vmax = Math.abs(v0);
			for (let i = 0; i <= 160; i++) {
				const ti = (T * i) / 160;
				xmax = Math.max(xmax, Math.abs(v0 * ti + (a * ti * ti) / 2));
				vmax = Math.max(vmax, Math.abs(v0 + a * ti));
			}
			const XRg = pick(XR, xmax);
			const VRg = pick(VR, vmax);
			rk = RW / XRg;
			vg = frame(q('[data-vg]'), VRg, 'υ<tspan baseline-shift="sub" font-size="8">x</tspan>', 'м/с');
			vg.line.classList.add('ac-line--v');
			xg = frame(q('[data-xg]'), XRg, 'x', 'м');
			xg.line.classList.add('ac-line--x');
			road.replaceChildren();
			const add = (tag: 'path' | 'text' | 'line', at: Record<string, string | number>, text?: string) => road.append(el(tag, at, text));
			add('path', { class: 'ink', d: 'M16 40 H352' });
			add('path', { class: 'head--ink', d: 'M358 40 l-8 -4 v8 Z' });
			for (const m of [-XRg, -XRg / 2, 0, XRg / 2, XRg]) {
				add('line', { class: 'ln', x1: RX + m * rk, y1: 36, x2: RX + m * rk, y2: 44 });
				add('text', { class: 't-small t-num', x: RX + m * rk, y: 58, 'text-anchor': 'middle' }, fmt(m, 0));
			}
			const xl = el('text', { x: 360, y: 64, 'text-anchor': 'end' });
			xl.innerHTML = '<tspan class="t-i">x</tspan>, м';
			road.append(xl);
		};
		let t = 0;
		let run = 0;
		let playing = true;

		const show = () => {
			const v0 = +inp('[data-v0]').value;
			const a = +inp('[data-a]').value;
			setup(v0, a);
			const v = v0 + a * t;
			const x = v0 * t + (a * t * t) / 2;
			inp('[data-t]').value = String(Math.round(t * 10) / 10);
			q('[data-o0]').textContent = `${fmt(v0, 0)} м/с`;
			q('[data-oa]').textContent = `${fmtTrim(a, 1)} м/с²`;
			q('[data-ot]').textContent = `${fmt(t, 1)} с`;
			// the body and its arrows
			const px = RX + x * rk;
			q('[data-body]').setAttribute('cx', px.toFixed(1));
			let tr = '';
			for (let i = 0; i <= 40; i++) {
				const ti = (t * i) / 40;
				tr += `${i ? 'L' : 'M'}${(RX + (v0 * ti + (a * ti * ti) / 2) * rk).toFixed(1)} 40 `;
			}
			q('[data-trace]').setAttribute('d', tr);
			const arr = (sel: string, y: number, len: number) => {
				if (Math.abs(len) < 2) {
					q(`[data-${sel}a]`).setAttribute('d', '');
					q(`[data-${sel}h]`).setAttribute('d', '');
					return;
				}
				const s = Math.sign(len);
				const e = px + len;
				q(`[data-${sel}a]`).setAttribute('d', `M${px.toFixed(1)} ${y} H${(e - s * 6).toFixed(1)}`);
				q(`[data-${sel}h]`).setAttribute('d', `M${e.toFixed(1)} ${y} l${(-s * 6).toFixed(1)} -3.5 v7 Z`);
			};
			arr('v', 24, v * 2);
			arr('a', 13, a * 12);
			// υx(t): the whole line; the area from 0 to t, split where the line crosses the t axis
			const vy = (vv: number) => O.y - vv * vg.ky;
			const X = (tt: number) => O.x + tt * TK;
			vg.line.setAttribute('d', `M${X(0)} ${vy(v0).toFixed(1)} L${X(T)} ${vy(v0 + a * T).toFixed(1)}`);
			const piece = (t0: number, t1: number) => (t1 > t0 ? `M${X(t0).toFixed(1)} ${O.y} L${X(t0).toFixed(1)} ${vy(v0 + a * t0).toFixed(1)} L${X(t1).toFixed(1)} ${vy(v0 + a * t1).toFixed(1)} L${X(t1).toFixed(1)} ${O.y} Z` : '');
			const tc = a !== 0 ? -v0 / a : -1; // the moment the velocity is zero
			let pos = '';
			let neg = '';
			const parts = tc > 0 && tc < t ? [[0, tc], [tc, t]] : [[0, t]];
			for (const [t0, t1] of parts) {
				const mid = v0 + a * ((t0 + t1) / 2);
				if (mid >= 0) pos += piece(t0, t1);
				else neg += piece(t0, t1);
			}
			vg.pos.setAttribute('d', pos);
			vg.neg.setAttribute('d', neg);
			vg.now.setAttribute('x1', X(t).toFixed(1));
			vg.now.setAttribute('x2', X(t).toFixed(1));
			vg.dot.setAttribute('cx', X(t).toFixed(1));
			vg.dot.setAttribute('cy', vy(v).toFixed(1));
			// x(t) up to t
			let d = '';
			for (let i = 0; i <= 60; i++) {
				const ti = (t * i) / 60;
				d += `${i ? 'L' : 'M'}${X(ti).toFixed(1)} ${(O.y - (v0 * ti + (a * ti * ti) / 2) * xg.ky).toFixed(1)} `;
			}
			xg.line.setAttribute('d', d);
			xg.now.setAttribute('x1', X(t).toFixed(1));
			xg.now.setAttribute('x2', X(t).toFixed(1));
			xg.dot.setAttribute('cx', X(t).toFixed(1));
			xg.dot.setAttribute('cy', (O.y - x * xg.ky).toFixed(1));
			// the readouts, by the formulas
			const tt = Math.round(t * 10) / 10;
			const vv = v0 + a * tt;
			const ss = v0 * tt + (a * tt * tt) / 2;
			const lines = [
				`\\upsilon_x = \\upsilon_{0x} + a_x t = ${c(v0)} + ${par(a)} \\cdot ${c(tt, 1)} = ${c(vv)}~\\text{м/с}`,
				`s_x = \\upsilon_{0x} t + \\dfrac{a_x t^2}{2} = ${c(v0)} \\cdot ${c(tt, 1)} + \\dfrac{${par(a)} \\cdot ${c(tt, 1)}^2}{2} = ${c(ss)}~\\text{м}`,
			];
			q('[data-calc]').innerHTML = lines.map((s, i) => `<li${i ? ' class="is-key"' : ''}>${k(s)}</li>`).join('');
		};

		const wake = loop(root, (dt) => {
			if (!playing) return false;
			run += dt;
			if (run > T + HOLD) run = 0;
			t = Math.min(run, T);
			show();
			return true;
		});
		const restart = () => {
			run = 0;
			t = 0;
			playing = true;
			show();
			wake();
		};
		q('[data-again]').addEventListener('click', restart);
		inp('[data-v0]').addEventListener('input', restart);
		inp('[data-a]').addEventListener('input', restart);
		inp('[data-t]').addEventListener('input', () => {
			playing = false;
			t = +inp('[data-t]').value;
			show();
		});
		show();
	}
</script>
