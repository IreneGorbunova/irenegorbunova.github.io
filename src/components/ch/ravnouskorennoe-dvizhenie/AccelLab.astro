---
/**
 * Model «Перемещение при равноускоренном движении» (grade 10): a body (a point) moves along Ox from x₀ (−20…20 м,
 * step 5) with the initial velocity υ0x (−6…6 м/с, step 1) and the constant acceleration a_x (−2…2 м/с², step 0,5); the
 * clock runs 0…8 s in real time and repeats, or is set by hand (step 0,1 с).
 * Shown: the body on the axis with its velocity (blue, 2 px per м/с) and acceleration (red, 12 px per м/с²) and its
 * trace; three graphs on one time axis (18 px per second):
 *   υx(t) with the area under it from 0 to t shaded — gold above the t axis, violet below it (that part counts
 *     negative); the signed area equals s_x = x − x₀;
 *   a_x(t) (±2 м/с², 15 px per м/с²) with the rectangle from 0 to t shaded the same way; its area a_x t equals the change
 *     of the velocity υx − υ0x;
 *   x(t) (green) drawn up to t, with the tangent at the moment t (dashed): its slope is υx.
 * The scales fit the motion chosen: the axis and the x(t) graph reach ±10, 20, 40, 60, 80 or 120 м, the smallest that
 * holds |x| over the 8 s (x₀ included); the υx(t) graph reaches ±4, 10, 20 or 30 м/с likewise.
 * Readouts by υx = υ0x + a_x t, s_x = υ0x t + a_x t²/2, x = x₀ + s_x; the path l (the parts of the area without signs)
 * when the body turns back. Start: x₀ = 0, υ0x = 4 м/с, a_x = −1 м/с²: the body stops at t = 4 с at x = 8 м and is back
 * at x = 0 at t = 8 с (υx = −4 м/с, s_x = 0, l = 16 м); at t = 3 с υx = 1 м/с, x = 7,5 м, a_x t = −3 м/с.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--stack not-content" data-accellab>
	<div class="g7__grid">
		<div class="ac-figs">
			<svg class="g7__svg" viewBox="0 0 370 56" role="img" aria-label="Тело движется вдоль оси Ox с постоянным ускорением; стрелки — скорость и ускорение">
				<g data-road></g>
				<path class="ac-trace" data-trace d=""></path>
				<path class="arrow arrow--blue" data-va d=""></path>
				<path class="head--blue" data-vh d=""></path>
				<path class="arrow arrow--red" data-aa d=""></path>
				<path class="head--red" data-ah d=""></path>
				<circle class="ac-body" data-body cy="32" r="6"></circle>
			</svg>
			<div class="ac-graphs">
				<div class="ac-gv">
					<p>Скорость</p>
					<svg class="g7__svg" viewBox="0 0 196 116" role="img" aria-label="График проекции скорости от времени; площадь под ним равна проекции перемещения"><g data-vg></g></svg>
				</div>
				<div class="ac-ga">
					<p>Ускорение</p>
					<svg class="g7__svg" viewBox="0 0 196 96" role="img" aria-label="График проекции ускорения от времени; площадь под ним равна изменению скорости"><g data-ag></g></svg>
				</div>
				<div class="ac-gx">
					<p>Координата</p>
					<svg class="g7__svg" viewBox="0 0 196 116" role="img" aria-label="График координаты от времени и касательная к нему; наклон касательной равен проекции скорости"><g data-xg></g></svg>
				</div>
				<div class="ac-ctrl">
					<label class="g7__slider"><span>Координата <i>x</i><sub>0</sub></span><output data-ox></output><input type="range" min="-20" max="20" step="5" value="0" data-x0 aria-label="Начальная координата" /></label>
					<label class="g7__slider"><span>Скорость <i>υ</i><sub>0x</sub></span><output data-o0></output><input type="range" min="-6" max="6" step="1" value="4" data-v0 aria-label="Проекция начальной скорости" /></label>
					<label class="g7__slider"><span>Ускорение <i>a<sub>x</sub></i></span><output data-oa></output><input type="range" min="-2" max="2" step="0.5" value="-1" data-a aria-label="Проекция ускорения" /></label>
					<label class="g7__slider"><span>Время <i>t</i></span><output data-ot></output><input type="range" min="0" max="8" step="0.1" value="0" data-t aria-label="Время, секунды" /></label>
					<button type="button" class="g7__btn g7__again" data-again>Повторить</button>
				</div>
			</div>
			<ul class="ac-read" data-read></ul>
		</div>
		<ul class="g7__lines" data-calc></ul>
	</div>
	<figcaption class="g7__caption">
		Синяя стрелка — скорость тела, красная — ускорение. Площадь под графиком скорости равна <i>s<sub>x</sub></i>, под
		графиком ускорения — изменению скорости (золотая часть — со знаком «плюс», фиолетовая — «минус»); наклон
		касательной к графику координаты равен <i>υ<sub>x</sub></i>. Время реальное, масштаб осей подстраивается под движение.
	</figcaption>
</figure>

<style is:global>
	[data-accellab] .ac-body {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	[data-accellab] .ac-trace {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 3;
		opacity: 0.45;
		stroke-linecap: round;
	}
	[data-accellab] .ac-grid {
		stroke: var(--g7-faint);
		stroke-width: 1;
	}
	[data-accellab] .ac-line {
		fill: none;
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	[data-accellab] .ac-line--v {
		stroke: var(--g7-blue);
	}
	[data-accellab] .ac-line--a {
		stroke: var(--g7-red);
	}
	[data-accellab] .ac-line--x {
		stroke: var(--g7-green);
	}
	[data-accellab] .ac-figs > svg text {
		font-size: 13px;
	}
	[data-accellab] .ac-tan {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.4;
		stroke-dasharray: 5 3;
	}
	[data-accellab] .ac-area {
		fill: color-mix(in srgb, var(--g7-gold) 30%, transparent);
		stroke: var(--g7-gold);
		stroke-width: 1;
	}
	[data-accellab] .ac-area--neg {
		fill: color-mix(in srgb, var(--g7-violet) 32%, transparent);
		stroke: var(--g7-violet);
	}
	[data-accellab] .ac-figs {
		display: grid;
		gap: 0.5rem;
		container-type: inline-size;
	}
	[data-accellab] .ac-graphs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-areas: 'v x' 'a c';
		gap: 0.5rem 0.75rem;
		align-items: start;
	}
	[data-accellab] .ac-gv {
		grid-area: v;
	}
	[data-accellab] .ac-ga {
		grid-area: a;
	}
	[data-accellab] .ac-gx {
		grid-area: x;
	}
	[data-accellab] .ac-read {
		margin: -0.2rem 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 1.1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	[data-accellab] .ac-read li {
		margin: 0;
	}
	[data-accellab] .ac-read b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	[data-accellab] .ac-graphs p {
		margin: 0 0 0.2rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-1);
	}
	@container (max-width: 34rem) {
		[data-accellab] .ac-graphs {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'v' 'a' 'x' 'c';
		}
	}
	[data-accellab] .ac-now {
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	[data-accellab] .ac-ctrl {
		grid-area: c;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem 0.8rem;
		align-items: end;
		align-self: center;
	}
	[data-accellab] .ac-ctrl .g7__slider {
		font-size: var(--sl-text-xs);
	}
</style>

<script>
	import { el, fmt, fmtTrim, k, loop } from '../g7/kit';

	const RX = 185; // x = 0 on the road
	const RW = 135; // px from x = 0 to the end of the road's range
	const TK = 18; // px per second
	const T = 8;
	const HOLD = 2;
	const XR = [10, 20, 40, 60, 80, 120];
	const VR = [4, 10, 20, 30];
	const c = (v: number, d = 2) => fmtTrim(v, d).replace(',', '{,}').replace('−', '-');
	const par = (v: number, d = 2) => (v < 0 ? `(${c(v, d)})` : c(v, d));
	const pick = (list: number[], need: number) => list.find((r) => r >= need - 1e-9) ?? list[list.length - 1];
	const f1 = (v: number) => v.toFixed(1);

	// the frame of a graph for the range ±R: axes, grid, numbers; origin (OX, OY), HH px from the t axis to ±R
	const frame = (g: SVGGElement, R: number, OY: number, HH: number, label: string, unit: string) => {
		const OX = 34;
		g.replaceChildren();
		const ky = HH / R;
		const add = (tag: 'path' | 'text' | 'line', a: Record<string, string | number>, text?: string) => {
			const e = el(tag, a, text);
			g.append(e);
			return e;
		};
		const ticks = [-R, -R / 2, R / 2, R];
		for (const v of ticks) add('path', { class: 'ac-grid', d: `M${OX} ${OY - v * ky} H${OX + T * TK}` });
		for (let t = 2; t <= T; t += 2) add('path', { class: 'ac-grid', d: `M${OX + t * TK} ${OY - HH} V${OY + HH}` });
		add('path', { class: 'ink', d: `M${OX} ${OY} H${OX + T * TK + 6} M${OX} ${OY + HH} V${OY - HH - 8}` });
		add('path', { class: 'head--ink', d: `M${OX + T * TK + 10} ${OY} l-7 -3.5 v7 Z M${OX} ${OY - HH - 12} l-3.5 7 h7 Z` });
		for (const v of HH < 40 ? [-R, R] : ticks) add('text', { class: 't-small t-num', x: OX - 4, y: OY - v * ky + 4, 'text-anchor': 'end' }, fmt(v, 0));
		for (let t = 2; t < T; t += 2) add('text', { class: 't-small t-num t-halo', x: OX + t * TK, y: OY + 13, 'text-anchor': 'middle' }, String(t));
		const lab = el('text', { class: 't-small', x: OX + 6, y: OY - HH - 2 });
		lab.innerHTML = `<tspan class="t-i">${label}</tspan>, ${unit}`;
		g.append(lab);
		const tl = el('text', { class: 't-small', x: OX + T * TK + 12, y: OY + 14, 'text-anchor': 'end' });
		tl.innerHTML = '<tspan class="t-i">t</tspan>, с';
		g.append(tl);
		const pos = add('path', { class: 'ac-area', d: '' });
		const neg = add('path', { class: 'ac-area ac-area--neg', d: '' });
		const tan = add('path', { class: 'ac-tan', d: '' });
		const line = add('path', { class: 'ac-line', d: '' });
		const now = add('line', { class: 'ac-now', y1: OY + HH, y2: OY - HH });
		const dot = add('circle', { r: 4, class: 'ac-body' });
		return { OX, OY, HH, ky, pos, neg, tan, line, now, dot };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-accellab]')) {
		const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const inp = (s: string) => q<HTMLInputElement>(s);
		const road = q<SVGGElement>('[data-road]');
		const ag = frame(q('[data-ag]'), 2, 50, 30, 'a<tspan baseline-shift="sub" font-size="8">x</tspan>', 'м/с²');
		ag.line.classList.add('ac-line--a');
		let vg: ReturnType<typeof frame>;
		let xg: ReturnType<typeof frame>;
		let rk = 1; // px per metre on the road
		let key = '';
		const setup = (x0: number, v0: number, a: number) => {
			if (key === `${x0}/${v0}/${a}`) return;
			key = `${x0}/${v0}/${a}`;
			let xmax = Math.abs(x0);
			let vmax = Math.abs(v0);
			for (let i = 0; i <= 160; i++) {
				const ti = (T * i) / 160;
				xmax = Math.max(xmax, Math.abs(x0 + v0 * ti + (a * ti * ti) / 2));
				vmax = Math.max(vmax, Math.abs(v0 + a * ti));
			}
			const XRg = pick(XR, xmax);
			const VRg = pick(VR, vmax);
			rk = RW / XRg;
			vg = frame(q('[data-vg]'), VRg, 60, 42, 'υ<tspan baseline-shift="sub" font-size="8">x</tspan>', 'м/с');
			vg.line.classList.add('ac-line--v');
			xg = frame(q('[data-xg]'), XRg, 60, 42, 'x', 'м');
			xg.line.classList.add('ac-line--x');
			road.replaceChildren();
			const add = (tag: 'path' | 'text' | 'line', at: Record<string, string | number>, text?: string) => road.append(el(tag, at, text));
			add('path', { class: 'ink', d: 'M16 32 H352' });
			add('path', { class: 'head--ink', d: 'M358 32 l-8 -4 v8 Z' });
			for (const m of [-XRg, -XRg / 2, 0, XRg / 2, XRg]) {
				add('line', { class: 'ln', x1: RX + m * rk, y1: 28, x2: RX + m * rk, y2: 36 });
				add('text', { class: 't-small t-num', x: RX + m * rk, y: 49, 'text-anchor': 'middle' }, fmt(m, 0));
			}
			const xl = el('text', { x: 360, y: 52, 'text-anchor': 'end' });
			xl.innerHTML = '<tspan class="t-i">x</tspan>, м';
			road.append(xl);
		};
		let t = 0;
		let run = 0;
		let playing = true;

		const show = () => {
			const x0 = +inp('[data-x0]').value;
			const v0 = +inp('[data-v0]').value;
			const a = +inp('[data-a]').value;
			setup(x0, v0, a);
			const xOf = (tt: number) => x0 + v0 * tt + (a * tt * tt) / 2;
			const v = v0 + a * t;
			const x = xOf(t);
			inp('[data-t]').value = String(Math.round(t * 10) / 10);
			q('[data-ox]').textContent = `${fmt(x0, 0)} м`;
			q('[data-o0]').textContent = `${fmt(v0, 0)} м/с`;
			q('[data-oa]').textContent = `${fmtTrim(a, 1)} м/с²`;
			q('[data-ot]').textContent = `${fmt(t, 1)} с`;
			// the body and its arrows
			const px = RX + x * rk;
			q('[data-body]').setAttribute('cx', f1(px));
			let tr = '';
			for (let i = 0; i <= 40; i++) tr += `${i ? 'L' : 'M'}${f1(RX + xOf((t * i) / 40) * rk)} 32 `;
			q('[data-trace]').setAttribute('d', tr);
			const arr = (sel: string, y: number, len: number) => {
				if (Math.abs(len) < 2) {
					q(`[data-${sel}a]`).setAttribute('d', '');
					q(`[data-${sel}h]`).setAttribute('d', '');
					return;
				}
				const s = Math.sign(len);
				const e = px + len;
				q(`[data-${sel}a]`).setAttribute('d', `M${f1(px)} ${y} H${f1(e - s * 6)}`);
				q(`[data-${sel}h]`).setAttribute('d', `M${f1(e)} ${y} l${f1(-s * 6)} -3.5 v7 Z`);
			};
			arr('v', 17, v * 2);
			arr('a', 7, a * 12);
			const X = (tt: number) => vg.OX + tt * TK;
			// υx(t): the whole line; the area from 0 to t, split where the line crosses the t axis
			const vy = (vv: number) => vg.OY - vv * vg.ky;
			vg.line.setAttribute('d', `M${X(0)} ${f1(vy(v0))} L${X(T)} ${f1(vy(v0 + a * T))}`);
			const piece = (t0: number, t1: number) => (t1 > t0 ? `M${f1(X(t0))} ${vg.OY} L${f1(X(t0))} ${f1(vy(v0 + a * t0))} L${f1(X(t1))} ${f1(vy(v0 + a * t1))} L${f1(X(t1))} ${vg.OY} Z` : '');
			const tc = a !== 0 ? -v0 / a : -1; // the moment the velocity is zero
			let pos = '';
			let neg = '';
			const turned = tc > 0 && tc < t;
			const parts = turned ? [[0, tc], [tc, t]] : [[0, t]];
			let l = 0;
			for (const [t0, t1] of parts) {
				const mid = v0 + a * ((t0 + t1) / 2);
				if (mid >= 0) pos += piece(t0, t1);
				else neg += piece(t0, t1);
				l += Math.abs(xOf(t1) - xOf(t0));
			}
			vg.pos.setAttribute('d', pos);
			vg.neg.setAttribute('d', neg);
			for (const g of [vg, xg, ag]) {
				g.now.setAttribute('x1', f1(X(t)));
				g.now.setAttribute('x2', f1(X(t)));
				g.dot.setAttribute('cx', f1(X(t)));
			}
			vg.dot.setAttribute('cy', f1(vy(v)));
			// a_x(t): a horizontal line, the rectangle from 0 to t
			const ay = ag.OY - a * ag.ky;
			ag.line.setAttribute('d', `M${X(0)} ${f1(ay)} H${X(T)}`);
			const rect = t > 0 && a !== 0 ? `M${X(0)} ${ag.OY} V${f1(ay)} H${f1(X(t))} V${ag.OY} Z` : '';
			ag.pos.setAttribute('d', a > 0 ? rect : '');
			ag.neg.setAttribute('d', a < 0 ? rect : '');
			ag.dot.setAttribute('cy', f1(ay));
			// x(t) up to t and the tangent at t (slope υx), 1,6 s to each side
			const xy = (xx: number) => xg.OY - xx * xg.ky;
			let d = '';
			for (let i = 0; i <= 60; i++) {
				const ti = (t * i) / 60;
				d += `${i ? 'L' : 'M'}${f1(X(ti))} ${f1(xy(xOf(ti)))} `;
			}
			xg.line.setAttribute('d', d);
			const ta = Math.max(0, t - 1.6);
			const tb = Math.min(T, t + 1.6);
			xg.tan.setAttribute('d', `M${f1(X(ta))} ${f1(xy(x + v * (ta - t)))} L${f1(X(tb))} ${f1(xy(x + v * (tb - t)))}`);
			xg.dot.setAttribute('cy', f1(xy(x)));
			// the readouts, by the formulas
			const tt = Math.round(t * 10) / 10;
			const vv = v0 + a * tt;
			const ss = v0 * tt + (a * tt * tt) / 2;
			const xx = x0 + ss;
			const lines = [
				`\\upsilon_x = \\upsilon_{0x} + a_x t = ${c(v0)} + ${par(a)} \\cdot ${c(tt, 1)} = ${c(vv)}~\\text{м/с}`,
				`s_x = \\upsilon_{0x} t + \\dfrac{a_x t^2}{2} = ${c(v0)} \\cdot ${c(tt, 1)} + \\dfrac{${par(a)} \\cdot ${c(tt, 1)}^2}{2} = ${c(ss)}~\\text{м}`,
			];
			q('[data-calc]').innerHTML = lines.map((s, i) => `<li${i === 1 ? ' class="is-key"' : ''}>${k(s)}</li>`).join('');
			const n = (val: number, dd = 2) => fmtTrim(val, dd);
			const read = [
				`<i>x</i> = <i>x</i><sub>0</sub> + <i>s</i><sub>x</sub> = <b>${n(xx)} м</b>`,
				`площадь под <i>υ</i><sub>x</sub>(<i>t</i>): <b>${n(ss)} м</b> = <i>s</i><sub>x</sub>`,
				turned ? `путь <i>l</i> = <b>${n(l)} м</b>: тело повернуло назад` : '',
				`площадь под <i>a</i><sub>x</sub>(<i>t</i>): <i>a</i><sub>x</sub><i>t</i> = <b>${n(a * tt)} м/с</b> = <i>υ</i><sub>x</sub> − <i>υ</i><sub>0x</sub>`,
				`наклон касательной к <i>x</i>(<i>t</i>): <b>${n(vv)} м/с</b> = <i>υ</i><sub>x</sub>`,
			].filter(Boolean);
			q('[data-read]').innerHTML = read.map((s) => `<li>${s}</li>`).join('');
		};

		const wake = loop(root, (dt) => {
			if (!playing) return false;
			run += dt;
			if (run > T + HOLD) run = 0;
			t = Math.min(run, T);
			show();
			return true;
		});
		const restart = () => {
			run = 0;
			t = 0;
			playing = true;
			show();
			wake();
		};
		q('[data-again]').addEventListener('click', restart);
		for (const s of ['[data-x0]', '[data-v0]', '[data-a]']) inp(s).addEventListener('input', restart);
		inp('[data-t]').addEventListener('input', () => {
			playing = false;
			t = +inp('[data-t]').value;
			show();
		});
		show();
	}
</script>
