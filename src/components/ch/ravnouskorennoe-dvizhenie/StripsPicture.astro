---
/**
 * Why the displacement equals the area under υₓ(t) for any motion: the graph υₓ(t) = 3 + 1,5t (м/с), t 0…8 с (blue,
 * 3 → 15 м/с; 40 px per second, 7 px per м/с). The area under it from 0 to 8 с is covered by n equal strips; the height
 * of each strip is υₓ at its left edge: on a short interval the motion is almost uniform, and the strip υₓΔt is the
 * displacement over it. Buttons n = 4; 8; 16; 32 (they switch by themselves every 2,5 с until one is pressed):
 * Δt = 2; 1; 0,5; 0,25 с, the sum of the strips 60; 66; 69; 70,5 м; the exact area under the line (a trapezoid, gold
 * outline) (3 + 15)/2 · 8 = 72 м. The gap 72 − sum = 12; 6; 3; 1,5 м halves each time.
 */
import RdStyles from './RdStyles.astro';

const GX = 50;
const GY = 132;
const TK = 40;
const VK = 7;
const f = (v: number) => v.toFixed(1);
const vOf = (t: number) => 3 + 1.5 * t;
const ts = [0, 1, 2, 3, 4, 5, 6, 7, 8];
const vs = [5, 10, 15];
---

<RdStyles />
<figure class="g7 g7--pic rdm not-content" data-rdstrips>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 152" role="img" aria-label="График скорости, площадь под ним покрыта узкими полосками; чем больше полосок, тем ближе их суммарная площадь к площади под графиком">
			{ts.map((t) => <path class="rd-grid" d={`M${GX + t * TK} ${GY} V${GY - 16 * VK}`}></path>)}
			{vs.map((v) => <path class="rd-grid" d={`M${GX} ${GY - v * VK} H${GX + 8 * TK}`}></path>)}
			<path class="st-trap" d={`M${GX} ${GY} V${GY - vOf(0) * VK} L${GX + 8 * TK} ${GY - vOf(8) * VK} V${GY} Z`}></path>
			<g data-strips></g>
			<path class="st-trap-line" d={`M${GX} ${GY} V${GY - vOf(0) * VK} L${GX + 8 * TK} ${GY - vOf(8) * VK} V${GY}`}></path>
			<path class="rd-v" d={`M${GX} ${GY - vOf(0) * VK} L${GX + 8 * TK} ${GY - vOf(8) * VK}`}></path>
			<path class="rd-axis" d={`M${GX} ${GY} H${GX + 8 * TK + 16} M${GX} ${GY} V${GY - 16 * VK - 12}`}></path>
			<path class="rd-axis-head" d={`M${GX + 8 * TK + 22} ${GY} l-8 -4 v8 Z M${GX} ${GY - 16 * VK - 18} l-4 8 h8 Z`}></path>
			{ts.map((t) => <text class="t-small t-num" x={GX + t * TK} y={GY + 16} text-anchor="middle">{t}</text>)}
			{vs.map((v) => <text class="t-small t-num" x={GX - 6} y={GY - v * VK + 4} text-anchor="end">{v}</text>)}
			<text class="t-small t-num" x={GX - 6} y={GY + 4} text-anchor="end">0</text>
			<text x={GX + 8} y={GY - 16 * VK - 6}><tspan class="t-i">υ</tspan><tspan class="t-sub" dy="4">x</tspan><tspan dy="-4">, м/с</tspan></text>
			<text x={GX + 8 * TK + 22} y={GY - 8} text-anchor="end"><tspan class="t-i">t</tspan>, с</text>
		</svg>
		<div class="st-bar">
		<div class="g7__row rd-seg">
			<span class="g7__label">Полосок:</span>
			<div class="g7__seg" role="group" aria-label="Число полосок">
				<button type="button" class="g7__btn" data-n="4">4</button>
				<button type="button" class="g7__btn" data-n="8">8</button>
				<button type="button" class="g7__btn" data-n="16">16</button>
				<button type="button" class="g7__btn" data-n="32">32</button>
			</div>
		</div>
		<ul class="rd-read">
			<li>Δ<i>t</i> = <b data-rdt></b></li>
			<li class="c-gold">сумма полосок <b data-rsum></b></li>
			<li class="c-gold">площадь под графиком <b>72 м</b></li>
		</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		На коротком промежутке Δ<i>t</i> движение почти равномерное, и перемещение за него — площадь узкой полоски{' '}
		<i>υ</i><sub>x</sub>Δ<i>t</i>. Чем уже полоски, тем ближе их сумма к площади под графиком скорости: поэтому перемещение
		равно этой площади при любом движении.
	</figcaption>
</figure>

<style is:global>
	.rdm[data-rdstrips].g7--pic {
		max-width: 40rem;
	}
	.rdm[data-rdstrips] .st-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.2rem 1.2rem;
	}
	.rdm[data-rdstrips] .st-bar .rd-seg,
	.rdm[data-rdstrips] .st-bar .rd-read {
		margin: 0;
	}
	.rdm[data-rdstrips] .st-trap {
		fill: color-mix(in oklab, var(--g7-gold) 10%, transparent);
	}
	.rdm[data-rdstrips] .st-trap-line {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.rdm[data-rdstrips] .st-strip {
		fill: color-mix(in oklab, var(--g7-gold) 34%, transparent);
		stroke: color-mix(in oklab, var(--g7-gold) 70%, var(--g7-paper));
		stroke-width: 0.8;
	}
</style>

<script>
	import { el, num, numT, autoSeg } from './rd';

	const GX = 50;
	const GY = 132;
	const TK = 40;
	const VK = 7;
	const vOf = (t: number) => 3 + 1.5 * t;
	const f = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-rdstrips]')) {
		const strips = root.querySelector<SVGGElement>('[data-strips]')!;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-n]')];
		autoSeg(root, buttons, (i) => {
			const n = Number(buttons[i].dataset.n);
			const dt = 8 / n;
			strips.replaceChildren();
			let sum = 0;
			for (let k = 0; k < n; k++) {
				const v = vOf(k * dt);
				sum += v * dt;
				strips.append(el('rect', { class: 'st-strip', x: f(GX + k * dt * TK), y: f(GY - v * VK), width: f(dt * TK), height: f(v * VK) }));
			}
			root.querySelector('[data-rdt]')!.textContent = `${numT(dt, 2)} с`;
			root.querySelector('[data-rsum]')!.textContent = `${num(sum, sum % 1 ? 1 : 0)} м`;
		});
	}
</script>
