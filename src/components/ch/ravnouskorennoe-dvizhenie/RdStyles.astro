---
/**
 * Styles shared by the pictures and models of «Равномерное и равноускоренное прямолинейное движение» (grade 10),
 * scoped under `.rdm` (every figure of the chapter has it next to `g7`). Renders nothing. One color per quantity in the
 * whole chapter: velocity blue (--g7-blue), acceleration and Δυ red (--g7-red), displacement and areas above the time
 * axis gold (--g7-gold), areas below it violet (--g7-violet), the coordinate graph x(t) green (--g7-green), strobe
 * dots neutral. SVG text is 13,5 px in a viewBox about 400 wide, so it stays at least 11 px on a 390 px phone.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<style is:global>
	.rdm.g7--pic {
		max-width: 36rem;
		margin-inline: auto;
	}
	.rdm .g7__svg text {
		font-size: 13.5px;
	}
	.rdm .g7__svg .t-i {
		font-size: 15px;
	}
	.rdm .g7__svg .t-sub {
		font-size: 10.5px;
	}
	.rdm .rd-grid {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.7;
	}
	.rdm .rd-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.rdm .rd-axis-head {
		fill: var(--sl-color-gray-2);
	}
	.rdm .rd-drop {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.rdm .rd-pos {
		fill: color-mix(in oklab, var(--g7-gold) 32%, transparent);
	}
	.rdm .rd-neg {
		fill: color-mix(in oklab, var(--g7-violet) 34%, transparent);
	}
	.rdm .rd-v {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.rdm .rd-a {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.rdm .rd-x {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.rdm .rd-thin-v {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.6;
	}
	.rdm .rd-dash-red {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.2;
		stroke-dasharray: 5 3;
		stroke-linecap: round;
	}
	.rdm .rd-dash-blue {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.6;
		stroke-dasharray: 4 3;
	}
	.rdm .rd-tan {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 6 4;
	}
	.rdm .rd-proj-gold {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 5;
		stroke-linecap: butt;
	}
	.rdm .rd-proj-blue {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 5;
	}
	.rdm .rd-dot {
		fill: var(--sl-color-gray-1);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.rdm .rd-cursor {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.rdm .rd-label-blue {
		fill: var(--g7-blue);
		font-weight: 700;
	}
	.rdm .rd-label-red {
		fill: var(--g7-red);
		font-weight: 700;
	}
	.rdm .rd-label-gold {
		fill: var(--g7-gold);
		font-weight: 700;
	}
	.rdm .rd-label-green {
		fill: var(--g7-green);
		font-weight: 700;
	}
	.rdm .g7__lines li b,
	.rdm .rd-read b {
		font-variant-numeric: tabular-nums;
	}
	.rdm .rd-read {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 1rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rdm .rd-read li {
		margin: 0;
	}
	.rdm .rd-read b {
		color: var(--sl-color-white);
	}
	.rdm .rd-read .c-blue b {
		color: var(--g7-blue);
	}
	.rdm .rd-read .c-red b {
		color: var(--g7-red);
	}
	.rdm .rd-read .c-gold b {
		color: var(--g7-gold);
	}
	.rdm .rd-read .c-green b {
		color: var(--g7-green);
	}
	.rdm .rd-seg {
		margin-top: 0.5rem;
	}
</style>
