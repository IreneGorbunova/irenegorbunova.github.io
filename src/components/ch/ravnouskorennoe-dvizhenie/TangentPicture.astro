---
/**
 * Picture for the definition of instantaneous velocity: a car on a road bend seen from above (an arc of a circle of
 * radius R = 40 м, 7 px per metre), moving at a steady 10 м/с, clockwise. Point A is its place at a moment t, point B
 * its place Δt later: the arc AB has the angle φ = υΔt/R. The chord AB is the displacement Δs (gold), |Δs| = 2R sin(φ/2);
 * the average velocity Δs/Δt lies along the chord (blue, thin), the instantaneous velocity at A along the tangent
 * (blue, thick, dashed tangent line); both arrows 10 px per м/с. The angle between the chord and the tangent is φ/2.
 * Buttons Δt = 2; 1; 0,5; 0,1 с (they switch by themselves every 2,5 с until one is pressed):
 *   |Δs| = 19,79; 9,97; 5,00; 1,000 м; |average velocity| = 9,896; 9,974; 9,993; 9,9997 м/с (shown 9,90; 9,97; 9,99;
 *   10,00); the angle 14,3°; 7,2°; 3,6°; 0,7°.
 * The car (4,4 м × 1,8 м) is drawn to scale at A; at B a faint copy. The car drives from A to B in Δt of real time,
 * then waits 1 с and starts again.
 */
import RdStyles from './RdStyles.astro';

const K = 7;
const R = 40 * K;
const C = { x: 155.8, y: 383.1 };
const P = (phi: number) => ({ x: C.x + R * Math.cos(phi), y: C.y - R * Math.sin(phi) });
const f = (v: number) => v.toFixed(1);
const arc = (r: number, a1: number, a2: number) => {
	const p = { x: C.x + r * Math.cos(a1), y: C.y - r * Math.sin(a1) };
	const q = { x: C.x + r * Math.cos(a2), y: C.y - r * Math.sin(a2) };
	return `M${f(p.x)} ${f(p.y)} A${r} ${r} 0 0 1 ${f(q.x)} ${f(q.y)}`;
};
const A1 = (126 * Math.PI) / 180;
const A2 = (38 * Math.PI) / 180;
const W = 7 * K / 2; // half of the roadway, 3,5 м
---

<RdStyles />
<figure class="g7 g7--pic rdm not-content" data-rdtan>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 190" role="img" aria-label="Автомобиль на повороте дороги, вид сверху. Хорда между положениями A и B — перемещение; при уменьшении промежутка времени она поворачивается и сливается с касательной в точке A">
			<rect class="tg-grass" x="0" y="0" width="400" height="190"></rect>
			<path class="tg-road" d={`${arc(R + W, A1, A2)} L${f(C.x + (R - W) * Math.cos(A2))} ${f(C.y - (R - W) * Math.sin(A2))} A${R - W} ${R - W} 0 0 0 ${f(C.x + (R - W) * Math.cos(A1))} ${f(C.y - (R - W) * Math.sin(A1))} Z`}></path>
			<path class="tg-mid" d={arc(R, A1, A2)}></path>
			<path class="tg-edge" d={arc(R + W, A1, A2)}></path>
			<path class="tg-edge" d={arc(R - W, A1, A2)}></path>
			<path class="rd-tan" data-tan d=""></path>
			<g data-ghost class="tg-ghost"></g>
			<g data-car></g>
			<path class="tg-chord" data-chord d=""></path>
			<path class="tg-chord-head" data-chordh d=""></path>
			<path class="tg-angle" data-ang d=""></path>
			<path class="rd-thin-v" data-ava d=""></path>
			<path class="head--blue" data-avh d=""></path>
			<path class="arrow arrow--blue" data-iva d=""></path>
			<path class="head--blue" data-ivh d=""></path>
			<circle class="tg-pt" data-pa r="3.5"></circle>
			<circle class="tg-pt" data-pb r="3.5"></circle>
			<text class="t-strong t-halo" data-la>A</text>
			<text class="t-strong t-halo" data-lb>B</text>
			<text class="rd-label-gold t-halo" data-ls><tspan class="t-i">Δs</tspan></text>
			<text class="rd-label-blue t-halo" data-liv><tspan class="t-i">υ</tspan></text>
			<path class="rd-axis" d={`M16 30 h${10 * K}`}></path>
			<text class="t-small" x={16 + 5 * K} y="24" text-anchor="middle">10 м</text>
		</svg>
		<div class="g7__row rd-seg">
			<span class="g7__label">Δ<i>t</i>:</span>
			<div class="g7__seg" role="group" aria-label="Промежуток времени Δt">
				<button type="button" class="g7__btn" data-dt="2">2 с</button>
				<button type="button" class="g7__btn" data-dt="1">1 с</button>
				<button type="button" class="g7__btn" data-dt="0.5">0,5 с</button>
				<button type="button" class="g7__btn" data-dt="0.1">0,1 с</button>
			</div>
		</div>
		<ul class="rd-read">
			<li class="c-gold">перемещение |Δ<i>s</i>| = <b data-rs></b></li>
			<li class="c-blue">средняя скорость |Δ<i>s</i>|/Δ<i>t</i> = <b data-rv></b></li>
			<li>угол между хордой и касательной <b data-ra></b></li>
		</ul>
	</div>
	<figcaption class="g7__caption">
		Автомобиль на повороте едет со скоростью 10&nbsp;м/с, вид сверху, всё в масштабе. Чем меньше промежуток Δ<i>t</i>, тем
		ближе хорда AB к касательной в точке A: средняя скорость по направлению и по модулю приближается к мгновенной.
	</figcaption>
</figure>

<style is:global>
	.rdm[data-rdtan] .tg-grass {
		fill: color-mix(in oklab, hsl(150, 45%, 45%) 18%, var(--g7-paper));
	}
	.rdm[data-rdtan] .tg-road {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 80%, var(--g7-paper));
	}
	.rdm[data-rdtan] .tg-edge {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.rdm[data-rdtan] .tg-mid {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 8 8;
		opacity: 0.6;
	}
	.rdm[data-rdtan] .tg-chord {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.6;
	}
	.rdm[data-rdtan] .tg-chord-head {
		fill: var(--g7-gold);
	}
	.rdm[data-rdtan] .tg-angle {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
	}
	.rdm[data-rdtan] .tg-pt {
		fill: var(--sl-color-white);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	.rdm[data-rdtan] .tg-body {
		fill: var(--g7-gold);
		stroke: var(--hm-line, var(--sl-color-gray-1));
		stroke-width: 0.6;
	}
	.rdm[data-rdtan] .tg-glass {
		fill: color-mix(in oklab, var(--g7-blue) 35%, var(--sl-color-gray-6));
	}
	.rdm[data-rdtan] .tg-ghost {
		opacity: 0.35;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, setArrow, num, autoSeg } from './rd';

	const K = 7;
	const R = 40 * K;
	const C = { x: 155.8, y: 383.1 };
	const V = 10;
	const PHI_A = (110 * Math.PI) / 180; // A on the arc, at (60, 120)
	const P = (phi: number) => ({ x: C.x + R * Math.cos(phi), y: C.y - R * Math.sin(phi) });
	const f = (v: number) => v.toFixed(2);

	/** A car seen from above, 4,4 × 1,8 м, its front toward +x of its own group. */
	const carTop = (g: SVGGElement) => {
		const L = 4.4 * K;
		const Wd = 1.8 * K;
		g.append(el('rect', { class: 'tg-body', x: -L, y: -Wd / 2, width: L, height: Wd, rx: 2.5 }));
		g.append(el('rect', { class: 'tg-glass', x: -L * 0.42, y: -Wd / 2 + 1, width: L * 0.16, height: Wd - 2, rx: 1 }));
		g.append(el('rect', { class: 'tg-glass', x: -L * 0.86, y: -Wd / 2 + 1.2, width: L * 0.1, height: Wd - 2.4, rx: 1 }));
	};
	/** Places a car on the arc at angle phi, heading clockwise (along the tangent). */
	const place = (g: SVGGElement, phi: number) => {
		const p = P(phi);
		const head = (Math.atan2(Math.cos(phi), Math.sin(phi)) * 180) / Math.PI; // screen direction of (sin φ, cos φ)
		g.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)}) rotate(${f(head)}) translate(${f(2.2 * K)} 0)`);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-rdtan]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const car = $<SVGGElement>('[data-car]');
		const ghost = $<SVGGElement>('[data-ghost]');
		carTop(car);
		carTop(ghost);
		const A = P(PHI_A);
		const tA = { x: Math.sin(PHI_A), y: Math.cos(PHI_A) }; // unit tangent on screen, along the motion
		$('[data-tan]').setAttribute('d', `M${f(A.x - tA.x * 80)} ${f(A.y - tA.y * 80)} L${f(A.x + tA.x * 300)} ${f(A.y + tA.y * 300)}`);
		const pa = $('[data-pa]');
		pa.setAttribute('cx', f(A.x));
		pa.setAttribute('cy', f(A.y));
		const la = $('[data-la]');
		la.setAttribute('x', f(A.x - 18));
		la.setAttribute('y', f(A.y + 18));
		// the instantaneous velocity at A: 10 м/с, 8 px per м/с
		setArrow($('[data-iva]'), $('[data-ivh]'), A.x, A.y, A.x + tA.x * 100, A.y + tA.y * 100, 10, 5);
		const liv = $('[data-liv]');
		liv.setAttribute('x', f(A.x + tA.x * 100 - 14));
		liv.setAttribute('y', f(A.y + tA.y * 100 - 10));

		let dt = 2;
		let clock = 0;
		const show = () => {
			const phi = (V * dt) / (40);
			const B = P(PHI_A - phi);
			const chord = 2 * 40 * Math.sin(phi / 2); // м
			const vavg = chord / dt;
			setArrow($('[data-chord]'), $('[data-chordh]'), A.x, A.y, B.x, B.y, Math.min(9, chord * K * 0.5), 4.5);
			const pb = $('[data-pb]');
			pb.setAttribute('cx', f(B.x));
			pb.setAttribute('cy', f(B.y));
			const lb = $('[data-lb]');
			lb.setAttribute('x', f(B.x + 6));
			lb.setAttribute('y', f(B.y + 18));
			lb.style.display = dt < 0.4 ? 'none' : '';
			const ls = $('[data-ls]');
			ls.setAttribute('x', f((A.x + B.x) / 2 + 6));
			ls.setAttribute('y', f((A.y + B.y) / 2 + 24));
			ls.style.display = dt < 0.4 ? 'none' : '';
			// the average velocity along the chord
			const ux = (B.x - A.x) / (chord * K);
			const uy = (B.y - A.y) / (chord * K);
			setArrow($('[data-ava]'), $('[data-avh]'), A.x, A.y, A.x + ux * vavg * 10, A.y + uy * vavg * 10, 9, 4.5);
			// the angle between the chord and the tangent, an arc of radius 34 px at A
			const r = 75;
			const a1 = Math.atan2(tA.y, tA.x);
			const a2 = Math.atan2(uy, ux);
			$('[data-ang]').setAttribute('d', `M${f(A.x + r * Math.cos(a1))} ${f(A.y + r * Math.sin(a1))} A${r} ${r} 0 0 1 ${f(A.x + r * Math.cos(a2))} ${f(A.y + r * Math.sin(a2))}`);
			place(ghost, PHI_A - phi);
			$('[data-rs]').textContent = `${num(chord, chord < 2 ? 3 : 2)} м`;
			$('[data-rv]').textContent = `${num(vavg, 2)} м/с`;
			$('[data-ra]').textContent = `${num(((phi / 2) * 180) / Math.PI, 1)}°`;
		};
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-dt]')];
		autoSeg(root, buttons, (i) => {
			dt = Number(buttons[i].dataset.dt);
			clock = 0;
			show();
		});
		loop(root, (step) => {
			clock = (clock + step) % (dt + 1);
			const u = Math.min(clock, dt);
			place(car, PHI_A - (V * u) / 40);
			return true;
		});
	}
</script>
