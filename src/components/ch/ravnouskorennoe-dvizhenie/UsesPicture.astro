---
/**
 * «Где это встречается»: four small tiles in a 2 × 2 grid (also on a phone), each with its title under it (the
 * numbers are in the list above the picture, in the text). The cars are the profile car of car.ts (4,4 м).
 *   cameras — two camera gantries over a highway 10 км apart (not to scale: the road between them is cut, a break
 *     sign), the same car under each with the time stamps 12:00 and 12:06: average speed 10 км / 0,1 ч = 100 км/ч.
 *   distance — two cars at 90 км/ч = 25 м/с, 50 м apart (2,5 px per metre, the cars drawn twice larger); the camera rides
 *     with them, a road post slides back at 25 м/с; a stopwatch starts when the front car passes the post and stops
 *     when the rear car passes it: 2,0 с = 50 м / 25 м/с. Loop: 2,6 с of motion, 1,5 с of the end frame.
 *   razgon — a car and its speedometer: the needle goes from 0 to 100 км/ч in 4 с at a steady rate (constant
 *     acceleration 27,8 / 4 = 6,9 м/с²), the timer counts; the road under the car slides back at the car's speed
 *     (2 px per metre). Loop: 4 с, 1,5 с of the end frame.
 *   crash — a crash test: a car at 15 м/с (54 км/ч) hits a concrete block; its front crumples by 0,5 м and it stops in
 *     2 · 0,5 / 15 = 0,067 с with a = 15² / (2 · 0,5) = 225 м/с². 20 px per metre; slowed down 10 times
 *     (the tile says so). Loop: 0,3 с of approach and 0,067 с of crumpling (×10), 1,5 с of the end frame.
 */
import RdStyles from './RdStyles.astro';
import { carCss } from './car';

const css = carCss('[data-rduses]');
const tiles = [
	{ id: 'cameras', title: 'Камеры средней скорости', line: '10 км за 6 мин: 100 км/ч' },
	{ id: 'distance', title: 'Дистанция в две секунды', line: '90 км/ч · 2 с = 25 м/с · 2 с = 50 м' },
	{ id: 'razgon', title: 'Разгон «до сотни»', line: '0 → 100 км/ч за 4 с: <i>a</i> ≈ 6,9 м/с²' },
	{ id: 'crash', title: 'Сминаемый кузов', line: '15 м/с → 0 на 0,5 м: <i>a</i> = 225 м/с²' },
];
---

<RdStyles />
<Fragment set:html={`<style>${css}</style>`} />
<figure class="g7 g7--pic rdm not-content" data-rduses>
	<div class="g7__grid us-grid">
		{tiles.map((t) => (
			<div class="us-tile">
				<svg class="g7__svg" viewBox="0 0 200 106" role="img" aria-label={t.title} data-tile={t.id}>
					<rect class="us-sky" x="0" y="0" width="200" height="106"></rect>
					<g data-scene></g>
				</svg>
				<p class="us-title">{t.title}</p>
			</div>
		))}
	</div>
</figure>

<style is:global>
	.rdm[data-rduses] .us-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.rdm[data-rduses] .us-title {
		margin: 0.3rem 0 0;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		line-height: 1.25;
	}
	.rdm[data-rduses] .us-line {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		line-height: 1.3;
	}
	.rdm[data-rduses] .us-sky {
		fill: color-mix(in oklab, var(--g7-blue) 10%, var(--g7-paper));
	}
	.rdm[data-rduses] .us-road {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 85%, var(--g7-paper));
	}
	.rdm[data-rduses] .us-grass {
		fill: color-mix(in oklab, hsl(150, 45%, 45%) 25%, var(--g7-paper));
	}
	.rdm[data-rduses] .us-lane {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 8 7;
		fill: none;
	}
	.rdm[data-rduses] .us-steel {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 3;
	}
	.rdm[data-rduses] .us-cam {
		fill: var(--sl-color-gray-2);
	}
	.rdm[data-rduses] .us-stamp {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rdm[data-rduses] .us-cut {
		fill: var(--us-cut, var(--g7-paper));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rdm[data-rduses] .us-post {
		fill: var(--sl-color-gray-1);
	}
	.rdm[data-rduses] .us-post-band {
		fill: var(--sl-color-gray-6);
	}
	.rdm[data-rduses] .us-dial {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.rdm[data-rduses] .us-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.rdm[data-rduses] .us-needle {
		stroke: var(--g7-red);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.rdm[data-rduses] .us-block {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-steel);
		stroke-width: 1;
	}
	.rdm[data-rduses] .us-crumple {
		fill: none;
		stroke: var(--hm-line, var(--sl-color-gray-1));
		stroke-width: 1.2;
	}
	.rdm[data-rduses] .us-dim {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.5;
	}
	.rdm[data-rduses] .us-speedlines {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, num } from './rd';
	import { car, LEN } from './car';

	const f = (v: number) => v.toFixed(1);
	const add = <K extends keyof SVGElementTagNameMap>(g: Element, tag: K, a: Record<string, string | number>, text?: string) => {
		const e = el(tag, a);
		if (text !== undefined) e.textContent = text;
		g.append(e);
		return e;
	};
	type Tile = (g: SVGGElement) => (t: number) => void;
	const GY = 76; // the road line, px

	const tiles: Record<string, { run: number; hold: number; make: Tile }> = {
		cameras: {
			run: 0,
			hold: 1,
			make: (g) => {
				add(g, 'rect', { class: 'us-grass', x: 0, y: GY + 12, width: 200, height: 30 });
				add(g, 'rect', { class: 'us-road', x: 0, y: GY - 26, width: 200, height: 38 });
				add(g, 'path', { class: 'us-lane', d: `M0 ${GY - 7} H200` });
				for (const x of [44, 168]) {
					add(g, 'path', { class: 'us-steel', d: `M${x - 30} ${GY + 10} V30 H${x + 10} V${GY - 24}` });
					add(g, 'rect', { class: 'us-cam', x: x - 14, y: 32, width: 12, height: 7, rx: 1.5 });
					const c = car(add(g, 'g', {}) as SVGGElement, 0.11, 'cr-gold');
					c(x + 10, GY, 0, false);
				}
				// the break in the road between the gantries: the 10 км are not to scale
				add(g, 'path', { class: 'us-cut', d: `M98 ${GY + 14} l6 -20 l-4 0 l6 -24 l6 0 l-6 24 l4 0 l-6 20 Z` });
				for (const [x, s] of [
					[44, '12:00'],
					[168, '12:06'],
				] as const) {
					add(g, 'rect', { class: 'us-stamp', x: x - 24, y: 4, width: 46, height: 20, rx: 4 });
					add(g, 'text', { class: 't-strong t-num', x, y: 19, 'text-anchor': 'middle' }, s);
				}
				add(g, 'path', { class: 'us-dim', d: `M44 ${GY + 18} v8 M44 ${GY + 22} H168 M168 ${GY + 18} v8` });
				add(g, 'text', { class: 'rd-label-gold t-halo', x: 106, y: GY + 27, 'text-anchor': 'middle' }, '10 км');
				return () => {};
			},
		},
		distance: {
			run: 2.6,
			hold: 1.5,
			make: (g) => {
				const K = 2.5; // px per metre
				const V = 25;
				add(g, 'rect', { class: 'us-grass', x: 0, y: GY + 12, width: 200, height: 30 });
				add(g, 'rect', { class: 'us-road', x: 0, y: GY - 20, width: 200, height: 32 });
				const lane = add(g, 'path', { class: 'us-lane', d: '' });
				const post = add(g, 'g', {});
				add(post, 'rect', { class: 'us-post', x: -2, y: GY - 26, width: 4, height: 20 });
				add(post, 'rect', { class: 'us-post-band', x: -2, y: GY - 22, width: 4, height: 5 });
				// the cars drawn twice larger: 0,06 px per см; fronts 50 м + 4,4 м apart (the gap between them is 50 м)
				const S = 0.06;
				const rear = car(add(g, 'g', {}) as SVGGElement, S, 'cr-blue');
				const front = car(add(g, 'g', {}) as SVGGElement, S, 'cr-gold');
				const XR = 10 + LEN * S; // the rear car's front, px
				const gapPx = 50 * K;
				const dim = add(g, 'path', { class: 'us-dim', d: `M${f(XR)} 24 v8 M${f(XR)} 28 H${f(XR + gapPx)} M${f(XR + gapPx)} 24 v8` });
				void dim;
				add(g, 'text', { class: 'rd-label-gold t-halo', x: f(XR + gapPx / 2), y: 22, 'text-anchor': 'middle' }, '50 м');
				const watch = add(g, 'text', { class: 't-strong t-num t-halo', x: 196, y: GY + 24, 'text-anchor': 'end' });
				// the post: the front car's rear passes it at t = 0 … the rear car's front passes it at t = 2 с
				const postX0 = XR + gapPx; // at t = 0 the post is at the gap's front end
				return (t: number) => {
					const shift = V * K * t;
					const px = postX0 - shift;
					post.setAttribute('transform', `translate(${f(px)} 0)`);
					let d = '';
					const off = shift % 30;
					for (let x = -off; x < 200; x += 30) d += `M${f(x)} ${GY - 4} h14 `;
					lane.setAttribute('d', d);
					rear(XR, GY + 2, shift * 100 / K, false);
					front(XR + gapPx + LEN * S, GY + 2, shift * 100 / K, false);
					const tw = Math.min(t, 2);
					watch.textContent = `${num(tw, 1)} с`;
				};
			},
		},
		razgon: {
			run: 4,
			hold: 1.5,
			make: (g) => {
				add(g, 'rect', { class: 'us-grass', x: 0, y: GY + 12, width: 200, height: 30 });
				add(g, 'rect', { class: 'us-road', x: 0, y: GY - 14, width: 200, height: 26 });
				const lane = add(g, 'path', { class: 'us-lane', d: '' });
				const c = car(add(g, 'g', {}) as SVGGElement, 0.2, 'cr-gold');
				const lines = add(g, 'path', { class: 'us-speedlines', d: '' });
				// the speedometer: 0…120 км/ч over 240°
				const D = { x: 158, y: 46, r: 34 };
				add(g, 'circle', { class: 'us-dial', cx: D.x, cy: D.y, r: D.r });
				const angOf = (v: number) => ((-210 + (v / 120) * 240) * Math.PI) / 180;
				for (let v = 0; v <= 120; v += 20) {
					const a = angOf(v);
					add(g, 'line', { class: 'us-tick', x1: f(D.x + Math.cos(a) * (D.r - 6)), y1: f(D.y + Math.sin(a) * (D.r - 6)), x2: f(D.x + Math.cos(a) * D.r), y2: f(D.y + Math.sin(a) * D.r) });
				}
				for (const v of [0]) {
					const a = angOf(v);
					add(g, 'text', { class: 't-small t-num', x: f(D.x + Math.cos(a) * (D.r - 15)), y: f(D.y + Math.sin(a) * (D.r - 15) + 4), 'text-anchor': 'middle' }, String(v));
				}
				const needle = add(g, 'line', { class: 'us-needle', x1: D.x, y1: D.y });
				const timer = add(g, 'text', { class: 't-strong t-num t-halo', x: 8, y: 22 });
				const vt = add(g, 'text', { class: 't-strong t-num', x: D.x, y: D.y + 24, 'text-anchor': 'middle' });
				return (t: number) => {
					const v = (100 / 3.6) * (t / 4); // м/с
					const s = (100 / 3.6 / 4) * t * t * 0.5; // м
					c(100, GY, s * 100, false);
					let d = '';
					const off = (s * 2) % 30;
					for (let x = -off; x < 200; x += 30) d += `M${f(x)} ${GY + 1} h14 `;
					lane.setAttribute('d', d);
					const L = Math.min(22, v * 0.8);
					lines.setAttribute('d', v > 1 ? `M${f(8 - L * 0.2)} ${GY - 18} h${f(-L)} M${f(4)} ${GY - 10} h${f(-L)} M${f(10)} ${GY - 26} h${f(-L * 0.7)}` : '');
					const a = angOf(v * 3.6);
					needle.setAttribute('x2', f(D.x + Math.cos(a) * (D.r - 8)));
					needle.setAttribute('y2', f(D.y + Math.sin(a) * (D.r - 8)));
					timer.textContent = `${num(t, 1)} с`;
					vt.textContent = `${Math.round(v * 3.6)} км/ч`;
				};
			},
		},
		crash: {
			run: 3.7,
			hold: 1.5,
			make: (g) => {
				const K = 20; // px per metre
				const S = K / 100;
				add(g, 'rect', { class: 'us-grass', x: 0, y: GY + 12, width: 200, height: 30 });
				add(g, 'rect', { class: 'us-road', x: 0, y: GY - 6, width: 200, height: 18 });
				const BX = 172; // the face of the block
				const clipId = `us-clip-${Math.random().toString(36).slice(2, 8)}`;
				const defs = add(g, 'defs', {});
				const cp = add(defs, 'clipPath', { id: clipId });
				const cr = add(cp, 'rect', { x: -10, y: 0, width: 0, height: 118 });
				const cg = add(g, 'g', { 'clip-path': `url(#${clipId})` }) as SVGGElement;
				const c = car(add(cg, 'g', {}) as SVGGElement, S, 'cr-gold');
				const crum = add(g, 'path', { class: 'us-crumple', d: '' });
				add(g, 'rect', { class: 'us-block', x: BX, y: GY - 42, width: 26, height: 54 });
				const vlab = add(g, 'text', { class: 't-strong t-num t-halo', x: 8, y: 22 });
				add(g, 'text', { class: 't-small', x: 8, y: GY + 24 }, 'замедлено в 10 раз');
				const dim = add(g, 'path', { class: 'us-dim', d: '' });
				const dl = add(g, 'text', { class: 'rd-label-gold t-halo', 'text-anchor': 'end' });
				const V = 15;
				const SLOW = 10;
				const T1 = 0.3 * SLOW; // approach
				const T2 = (2 * 0.5) / V; // crumple, real
				return (t: number) => {
					let front: number; // м: position of the undamaged front relative to the block face (≤ 0.5 in)
					let v: number;
					if (t < T1) {
						front = -V * (T1 - t) / SLOW;
						v = V;
					} else {
						const u = Math.min((t - T1) / SLOW, T2);
						front = V * u - (225 * u * u) / 2;
						v = V - 225 * u;
					}
					const x = BX + front * K;
					c(x, GY, (front + 5) * 100, false);
					const crushed = Math.max(0, front);
					cr.setAttribute('width', f(BX + 10));
					// the crumpled front: a zigzag between the block and the car body, as long as the car got in
					if (crushed > 0.01) {
						let d = `M${BX} ${GY - 20}`;
						const n = 6;
						for (let i = 1; i <= n; i++) d += ` L${f(BX - (i % 2 ? crushed * K * 0.9 : 1))} ${f(GY - 20 + (i * 16) / n)}`;
						crum.setAttribute('d', d);
					} else crum.setAttribute('d', '');
					vlab.textContent = `${num(Math.max(0, v), 0)} м/с`;
					const done = t >= T1 + T2 * SLOW - 1e-6;
					dim.setAttribute('d', done ? `M${f(BX - 0.5 * K)} ${GY - 30} v-8 M${f(BX - 0.5 * K)} ${GY - 34} H${BX}` : '');
					dl.setAttribute('x', f(BX - 0.5 * K - 4));
					dl.setAttribute('y', f(GY - 30));
					dl.textContent = done ? '0,5 м' : '';
				};
			},
		},
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-rduses]')) {
		const draws = [...root.querySelectorAll<SVGSVGElement>('[data-tile]')].map((svg) => {
			const T = tiles[svg.dataset.tile!];
			const draw = T.make(svg.querySelector<SVGGElement>('[data-scene]')!);
			draw(0);
			return { T, draw, clock: 0 };
		});
		loop(root, (dt) => {
			for (const d of draws) {
				if (!d.T.run) continue;
				d.clock = (d.clock + dt) % (d.T.run + d.T.hold);
				d.draw(Math.min(d.clock, d.T.run));
			}
			return true;
		});
	}
</script>
