---
/**
 * Picture for the definition of uniformly accelerated motion: a lab cart on an inclined board 1,2 м long. The board is
 * inclined at 2,9°, so a light rolling cart has a = g sin 2,9° ≈ 0,5 м/с² down the board; it is drawn three times steeper
 * (8,7°), 255 px per metre along the board. The cart is pushed up from the start mark at υ₀ = 1 м/с: x = t − 0,25t²,
 * υ = 1 − 0,5t (x and υ along the board, up). It stops at the top after 2 с at x = 1 м and rolls back to the start mark
 * at t = 4 с with 1 м/с. Real time: 4 с of motion, 2,5 с of the end frame, loop.
 * Left: the cart with its velocity (blue, 60 px per м/с) and acceleration (red, 60 px per м/с², the same all the time,
 * also at the top where υ = 0), and dots every 0,5 с as on a photograph with flashes, the way up in the lower row,
 * the way back in the upper one: x = 0; 0,44; 0,75; 0,94; 1,00; 0,94; 0,75; 0,44; 0 м.
 * Right: a table that fills as the cart moves: t, x and the velocity as an arrow (70 px per м/с, up the board to the
 * right) 1; 0,75; 0,5; 0,25; 0; −0,25; −0,5; −0,75; −1 м/с; between neighbouring rows Δυ (red, dashed) is always
 * 0,25 м/с down the board.
 */
import RdStyles from './RdStyles.astro';

const K = 255;
const ANG = (8.7 * Math.PI) / 180;
const B0 = { x: 58, y: 150 }; // the lower end of the board, on its top surface
const LB = 1.2 * K;
const B1 = { x: B0.x + LB * Math.cos(ANG), y: B0.y - LB * Math.sin(ANG) };
const f = (v: number) => v.toFixed(1);
const nx = Math.sin(ANG); // the normal to the board, up (screen)
const ny = -Math.cos(ANG);
const TH = 9; // board thickness, px
const ticks = Array.from({ length: 13 }, (_, k) => k * 0.1);
const at = (s: number, off = 0) => ({ x: B0.x + s * K * Math.cos(ANG) + off * nx, y: B0.y - s * K * Math.sin(ANG) + off * ny });
const X0 = 0.08; // the start mark, м from the lower end
const rows = Array.from({ length: 9 }, (_, k) => k * 0.5);
const LX = 168; // the ladder: zero of the velocity arrows
const LK = 70;
---

<RdStyles />
<figure class="g7 g7--pic rdm not-content" data-rdcart>
	<div class="g7__grid cs-grid">
		<svg class="g7__svg" viewBox="0 0 380 190" role="img" aria-label="Тележку толкнули вверх по наклонной доске: она замедляется, останавливается и скатывается обратно; точки отмечают её положение через каждые 0,5 секунды">
			<rect class="cs-wall" x="0" y="0" width="380" height="166"></rect>
			<rect class="cs-table" x="0" y="166" width="380" height="24"></rect>
			<path class="cs-table-edge" d="M0 166 H380"></path>
			<!-- the stand under the upper end and the board -->
			<path class="cs-stand" d={`M${f(B1.x - 30)} 166 L${f(B1.x - 24)} ${f(B1.y + TH)} L${f(B1.x - 6)} ${f(B1.y + TH)} L${f(B1.x)} 166 Z`}></path>
			<path class="cs-board" d={`M${f(B0.x)} ${f(B0.y)} L${f(B1.x)} ${f(B1.y)} L${f(B1.x)} ${f(B1.y + TH)} L${f(B0.x)} ${f(B0.y + TH)} Z`}></path>
			<path class="cs-block" d={`M${f(B0.x - 6)} 166 L${f(B0.x - 6)} ${f(B0.y + TH)} L${f(B0.x + 10)} ${f(B0.y + TH + 2)} L${f(B0.x + 10)} 166 Z`}></path>
			<path class="cs-stop" d={`M${f(B1.x - 3)} ${f(B1.y)} l${f(-12 * nx)} ${f(-12 * ny)}`}></path>
			{ticks.map((s) => {
				const a = at(s);
				return <line class="cs-tick" x1={f(a.x)} y1={f(a.y + 1)} x2={f(a.x)} y2={f(a.y + (Math.round(s * 10) % 5 === 0 ? 8 : 5))}></line>;
			})}
			<line class="cs-mark" x1={f(at(X0).x)} y1={f(at(X0).y - 2)} x2={f(at(X0).x)} y2={f(at(X0).y + TH)}></line>
			<!-- the two rows of strobe dots -->
			<path class="cs-row" d={`M${f(at(0.02, 34).x)} ${f(at(0.02, 34).y)} L${f(at(1.18, 34).x)} ${f(at(1.18, 34).y)} M${f(at(0.02, 50).x)} ${f(at(0.02, 50).y)} L${f(at(1.18, 50).x)} ${f(at(1.18, 50).y)}`}></path>
			<text class="t-small" x={f(at(0.0, 34).x - 4)} y={f(at(0.0, 34).y + 5)} text-anchor="end">вверх</text>
			<text class="t-small" x={f(at(0.0, 50).x - 4)} y={f(at(0.0, 50).y + 5)} text-anchor="end">вниз</text>
			<g data-dots></g>
			<g data-cart></g>
			<path class="arrow arrow--blue" data-va d=""></path>
			<path class="head--blue" data-vh d=""></path>
			<path class="arrow arrow--red" data-aa d=""></path>
			<path class="head--red" data-ah d=""></path>
			<text class="t-strong t-num t-halo" data-clock x="370" y="22" text-anchor="end"></text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 262 236" role="img" aria-label="Таблица: время, координата и скорость тележки через каждые 0,5 секунды; между соседними строками скорость меняется на одно и то же значение">
			<text x="18" y="22"><tspan class="t-i">t</tspan>, с</text>
			<text x="62" y="22"><tspan class="t-i">x</tspan>, м</text>
			<text x={LX} y="22" text-anchor="middle"><tspan class="t-i">υ</tspan>, м/с</text>
			<path class="rd-grid" d={`M${LX} 30 V226 M${LX - LK} 30 V226 M${LX + LK} 30 V226`}></path>
			<text class="t-small t-num" x={LX - LK} y="234" text-anchor="middle">−1</text>
			<text class="t-small t-num" x={LX} y="234" text-anchor="middle">0</text>
			<text class="t-small t-num" x={LX + LK} y="234" text-anchor="middle">1</text>
			{rows.map((t, k) => (
				<g data-row={k} class="cs-rowg">
					<text class="t-num" x="18" y={44 + k * 21}>{String(t).replace('.', ',')}</text>
					<text class="t-num" x="62" y={44 + k * 21}>{(t - 0.25 * t * t).toFixed(2).replace('.', ',')}</text>
				</g>
			))}
			<g data-ladder></g>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Тележку толкнули вверх по наклонной доске. Точки отмечают её место через каждые 0,5&nbsp;с: она замедляется,
		останавливается и скатывается обратно. Справа видно, что за каждые 0,5&nbsp;с её скорость меняется на одно и то же:
		на 0,25&nbsp;м/с вниз по доске — и наверху, где она на миг равна нулю. Время реальное, наклон доски показан втрое
		круче.
	</figcaption>
</figure>

<style is:global>
	.rdm[data-rdcart].g7--pic {
		max-width: 46rem;
	}
	.rdm[data-rdcart] .cs-grid {
		grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
		gap: 0.6rem;
		align-items: center;
	}
	@media (max-width: 40rem) {
		.rdm[data-rdcart] .cs-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.rdm[data-rdcart] .cs-wall {
		fill: color-mix(in oklab, var(--g7-blue) 6%, var(--g7-paper));
	}
	.rdm[data-rdcart] .cs-table {
		fill: var(--g7-wood-dark);
	}
	.rdm[data-rdcart] .cs-table-edge {
		stroke: var(--g7-wood);
		stroke-width: 2;
	}
	.rdm[data-rdcart] .cs-stand,
	.rdm[data-rdcart] .cs-block {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-steel);
		stroke-width: 0.8;
	}
	.rdm[data-rdcart] .cs-board {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.rdm[data-rdcart] .cs-stop {
		stroke: var(--g7-steel);
		stroke-width: 4;
	}
	.rdm[data-rdcart] .cs-tick {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.rdm[data-rdcart] .cs-mark {
		stroke: var(--g7-gold);
		stroke-width: 2.5;
	}
	.rdm[data-rdcart] .cs-row {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.rdm[data-rdcart] .cs-dot-up {
		fill: var(--sl-color-gray-1);
	}
	.rdm[data-rdcart] .cs-dot-down {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
	}
	.rdm[data-rdcart] .cs-body {
		fill: var(--g7-blue);
		stroke: var(--hm-line, var(--sl-color-gray-1));
		stroke-width: 0.8;
	}
	.rdm[data-rdcart] .cs-wheel {
		fill: var(--sl-color-gray-1);
	}
	.rdm[data-rdcart] .cs-hub {
		fill: var(--sl-color-gray-4);
	}
	.rdm[data-rdcart] .cs-rowg {
		transition: opacity 0.2s;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, setArrow, num } from './rd';

	const K = 255;
	const ANG = (8.7 * Math.PI) / 180;
	const B0 = { x: 58, y: 150 };
	const nx = Math.sin(ANG);
	const ny = -Math.cos(ANG);
	const X0 = 0.08;
	const LX = 168;
	const LK = 70;
	const RUN = 4;
	const HOLD = 2.5;
	const f = (v: number) => v.toFixed(1);
	const at = (s: number, off = 0) => ({ x: B0.x + s * K * Math.cos(ANG) + off * nx, y: B0.y - s * K * Math.sin(ANG) + off * ny });
	const xOf = (t: number) => t - 0.25 * t * t;
	const vOf = (t: number) => 1 - 0.5 * t;
	const DEG = (ANG * 180) / Math.PI;

	for (const root of document.querySelectorAll<HTMLElement>('[data-rdcart]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		// the cart: body 17 × 5 см, wheels of 2 см radius; its center over the board
		const cart = $<SVGGElement>('[data-cart]');
		const body = el('g', {});
		const L = 0.17 * K;
		const h = 0.05 * K;
		const r = 0.02 * K;
		body.append(el('rect', { class: 'cs-body', x: -L / 2, y: -2 * r - h + 1, width: L, height: h, rx: 2 }));
		for (const wx of [-L / 2 + r + 2, L / 2 - r - 2]) {
			body.append(el('circle', { class: 'cs-wheel', cx: wx, cy: -r, r }));
			body.append(el('circle', { class: 'cs-hub', cx: wx, cy: -r, r: r * 0.35 }));
		}
		cart.append(body);
		const dots = $<SVGGElement>('[data-dots]');
		const ladder = $<SVGGElement>('[data-ladder]');
		const rowsG = [...root.querySelectorAll<SVGGElement>('[data-row]')];
		const clock = $<SVGTextElement>('[data-clock]');

		const draw = (t: number) => {
			const s = X0 + xOf(t);
			const p = at(s);
			cart.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)}) rotate(${f(-DEG)})`);
			// velocity and acceleration on the cart, 20 px above the board
			const c = at(s, 22);
			const v = vOf(t);
			const ux = Math.cos(ANG);
			const uy = -Math.sin(ANG);
			setArrow($('[data-va]'), $('[data-vh]'), c.x, c.y, c.x + ux * v * 60, c.y + uy * v * 60);
			const a = at(s, 12);
			setArrow($('[data-aa]'), $('[data-ah]'), a.x, a.y, a.x - ux * 30, a.y - uy * 30, 7, 3.5);
			// the strobe dots
			dots.replaceChildren();
			const n = Math.floor(t / 0.5 + 1e-6);
			for (let k = 0; k <= Math.min(n, 8); k++) {
				const tk = k * 0.5;
				const up = tk <= 2;
				const d = at(X0 + xOf(tk), up ? 34 : 50);
				dots.append(el('circle', { class: up ? 'cs-dot-up' : 'cs-dot-down', cx: f(d.x), cy: f(d.y), r: 3.6 }));
			}
			// the table
			ladder.replaceChildren();
			rowsG.forEach((g, k) => (g.style.opacity = k <= n ? '1' : '0.25'));
			for (let k = 0; k <= Math.min(n, 8); k++) {
				const y = 40 + k * 21;
				const vk = vOf(k * 0.5);
				const tip = LX + vk * LK;
				if (Math.abs(vk) > 1e-6) {
					const ar = { s: el('path', { class: 'arrow arrow--blue' }), h: el('path', { class: 'head--blue' }) };
					setArrow(ar.s, ar.h, LX, y, tip, y, 7, 3.5);
					ladder.append(ar.s, ar.h);
				} else ladder.append(el('circle', { class: 'head--blue', cx: LX, cy: y, r: 3 }));
				if (k > 0) {
					const prev = LX + vOf((k - 1) * 0.5) * LK;
					const d = { s: el('path', { class: 'rd-dash-red' }), h: el('path', { class: 'head--red' }) };
					setArrow(d.s, d.h, prev, y - 10.5, tip, y - 10.5, 6, 3);
					ladder.append(d.s, d.h);
				}
			}
			clock.textContent = `t = ${num(t, 1)} с`;
		};

		let clockT = 0;
		draw(0);
		loop(root, (dt) => {
			clockT = (clockT + dt) % (RUN + HOLD);
			draw(Math.min(clockT, RUN));
			return true;
		});
	}
</script>
