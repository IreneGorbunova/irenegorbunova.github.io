---
/**
 * A compass seen from above, with labels: the case, the scale with С, В, Ю, З, the magnetic needle and the pivot.
 * «Повернуть компас» turns the case; the needle, dragged a little by friction, swings back to the north and settles
 * (θ'' = −ω²·sin θ − b·(θ' − ψ'), period 1,6 s). «Сориентировать» turns the case until С is under the N end.
 * North is up in the picture.
 */
import PmStyles from './PmStyles.astro';

const C = { x: 125, y: 128 };
const R = 104;
const ticks = Array.from({ length: 72 }, (_, i) => {
	const a = (i * 5 * Math.PI) / 180;
	const r0 = i % 6 === 0 ? 77 : i % 2 === 0 ? 82 : 85;
	const s = Math.sin(a);
	const c = -Math.cos(a);
	return `M${(s * r0).toFixed(1)} ${(c * r0).toFixed(1)}L${(s * 89).toFixed(1)} ${(c * 89).toFixed(1)}`;
}).join('');
const letters = [
	{ t: 'С', a: 0 },
	{ t: 'В', a: 90 },
	{ t: 'Ю', a: 180 },
	{ t: 'З', a: 270 },
].map((l) => ({ ...l, x: 62 * Math.sin((l.a * Math.PI) / 180), y: -62 * Math.cos((l.a * Math.PI) / 180) }));
const at = (deg: number, r: number) => ({ x: C.x + r * Math.sin((deg * Math.PI) / 180), y: C.y - r * Math.cos((deg * Math.PI) / 180) });
const rim = at(62, R - 3);
const ring = at(104, 84);
---

<PmStyles />
<figure class="pm-box cp not-content" data-cp>
	<svg class="pm-svg cp__svg" viewBox="0 0 370 250" role="img" aria-label="Компас, вид сверху: корпус, шкала с буквами С, В, Ю, З, магнитная стрелка на острие">
		<g transform={`translate(${C.x} ${C.y})`}>
			<circle class="cp__case" r={R}></circle>
			<g data-dial>
				<circle class="cp__dial" r="91"></circle>
				<path class="cp__tick" d={ticks}></path>
				{letters.map((l) => <text class={`cp__let${l.t === 'С' ? ' cp__let--n' : ''}`} x={l.x.toFixed(1)} y={(l.y + 6).toFixed(1)} transform={`rotate(${l.a} ${l.x.toFixed(1)} ${l.y.toFixed(1)})`}>{l.t}</text>)}
			</g>
			<g data-needle>
				<path class="cp__n" d="M0 -64L-8 0H8Z"></path>
				<path class="cp__s" d="M0 64L-8 0H8Z"></path>
			</g>
			<circle class="cp__cap" r="5"></circle>
		</g>
		<g class="cp__labels">
			<path class="cp__north" d="M16 62V14M10 23L16 13L22 23"></path>
			<text class="cp__lab" x="26" y="24">север</text>
			<path class="cp__lead" d={`M248 44H232L${C.x + 6} ${C.y - 40}`}></path>
			<text class="cp__lab" x="252" y="40">магнитная</text>
			<text class="cp__lab" x="252" y="56">стрелка</text>
			<path class="cp__lead" d={`M248 104L${rim.x.toFixed(1)} ${rim.y.toFixed(1)}`}></path>
			<text class="cp__lab" x="252" y="108">корпус</text>
			<path class="cp__lead" d={`M248 160L${ring.x.toFixed(1)} ${ring.y.toFixed(1)}`}></path>
			<text class="cp__lab" x="252" y="164">шкала</text>
			<path class="cp__lead" d={`M248 214L${C.x + 4} ${C.y + 4}`}></path>
			<text class="cp__lab" x="252" y="212">острие,</text>
			<text class="cp__lab cp__lab--sm" x="252" y="228">на нём стрелка</text>
			<text class="cp__lab cp__lab--sm" x="252" y="242">вращается</text>
		</g>
	</svg>
	<div class="pm-row">
		<button type="button" class="pm-btn" data-act="turn">Повернуть компас</button>
		<button type="button" class="pm-btn pm-btn--primary" data-act="orient">Сориентировать</button>
	</div>
	<p class="pm-live" aria-live="polite" data-live></p>
</figure>

<style is:global>
	.cp__svg {
		max-width: 25rem;
		margin-inline: auto;
		border-radius: 0.75rem;
		background: var(--sl-color-bg);
	}
	.cp text {
		font-family: var(--__sl-font);
	}
	.cp__case {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 5;
	}
	.cp__dial {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.cp__tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.cp__let {
		font-size: 17px;
		font-weight: 700;
		text-anchor: middle;
		fill: var(--sl-color-white);
	}
	.cp__let--n {
		fill: var(--ig-vx);
	}
	.cp__n {
		fill: var(--ig-vx);
	}
	.cp__s {
		fill: var(--ig-vy);
	}
	.cp__cap {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.cp__lab {
		font-size: 14px;
		fill: var(--sl-color-white);
	}
	.cp__lab--sm {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.cp__lead {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.cp__north {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop } from './mag';

	const DEG = Math.PI / 180;
	const W2 = ((2 * Math.PI) / 1.6) ** 2; // the needle's swing: period 1,6 s
	const B = 3; // friction with the case, 1/s

	for (const root of document.querySelectorAll<HTMLElement>('[data-cp]')) {
		const dial = root.querySelector<SVGGElement>('[data-dial]')!;
		const needle = root.querySelector<SVGGElement>('[data-needle]')!;
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		let psi = 0; // the case, rad, clockwise from north
		let om = 0; // its angular velocity
		let th = 0; // the needle, rad, clockwise from north
		let w = 0;
		let turn: { from: number; to: number; t: number; dur: number } | null = null;
		let started = false;

		const say = () => {
			// how far С on the scale is turned from the north, 0…180°
			const away = Math.round(Math.abs((((psi / DEG) % 360) + 540) % 360 - 180));
			live.innerHTML =
				away < 2
					? 'Буква <b>С</b> — под северным концом стрелки. Компас сориентирован: шкала показывает, где север, юг, восток и запад.'
					: `Стрелка показывает на север, а буква <b>С</b> на шкале отвёрнута от неё на ${away}°. Нажмите «Сориентировать».`;
		};
		const draw = () => {
			dial.setAttribute('transform', `rotate(${(psi / DEG).toFixed(2)})`);
			needle.setAttribute('transform', `rotate(${(th / DEG).toFixed(2)})`);
		};
		const start = (to: number) => {
			const dur = 0.5 + Math.min(1, Math.abs(to - psi) / Math.PI) * 0.7;
			turn = { from: psi, to, t: 0, dur };
			live.textContent = '';
			wake();
		};
		const wake = loop(root, (dt) => {
			if (!started) {
				started = true;
				setTimeout(() => start(55 * DEG), 600);
				return false;
			}
			const n = 8;
			for (let i = 0; i < n; i++) {
				const h = dt / n;
				const prev = psi;
				if (turn) {
					turn.t = Math.min(1, turn.t + h / turn.dur);
					const e = turn.t < 0.5 ? 2 * turn.t * turn.t : 1 - (-2 * turn.t + 2) ** 2 / 2;
					psi = turn.from + (turn.to - turn.from) * e;
					if (turn.t >= 1) turn = null;
				}
				om = (psi - prev) / (h || 1);
				const a = -W2 * Math.sin(th) - B * (w - om);
				w += a * h;
				th += w * h;
			}
			draw();
			const busy = !!turn || Math.abs(th) > 0.004 || Math.abs(w) > 0.01;
			if (!busy) {
				th = 0;
				w = 0;
				draw();
				say();
			}
			return busy;
		});

		root.querySelector('[data-act="turn"]')!.addEventListener('click', () => {
			const sign = Math.random() < 0.5 ? -1 : 1;
			started = true;
			start(psi + sign * (60 + Math.random() * 80) * DEG);
		});
		root.querySelector('[data-act="orient"]')!.addEventListener('click', () => {
			started = true;
			const full = 2 * Math.PI;
			start(Math.round(psi / full) * full);
		});
		draw();
		say();
	}
</script>
