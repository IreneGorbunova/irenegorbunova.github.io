---
/** Shared look of the small models of the chapter «Постоянные магниты» (boxes, buttons, sliders, chips, live formulas). */
---

<style is:global>
	.pm-box {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.pm-box i,
	.pm-math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.pm-canvas,
	.pm-svg {
		display: block;
		width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.pm-canvas {
		border-radius: 0.75rem;
		background: var(--sl-color-bg);
	}
	.pm-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.pm-btn,
	.pm-chip {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			border-color 0.2s,
			background-color 0.2s;
	}
	.pm-chip {
		font-weight: 400;
		padding: 0.3rem 0.85rem;
	}
	.pm-btn:hover,
	.pm-chip:hover {
		border-color: var(--sl-color-accent);
	}
	.pm-btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.pm-btn--primary:hover {
		filter: brightness(1.08);
	}
	.pm-btn:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.pm-chip[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		font-weight: 700;
	}
	.pm-slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pm-slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.pm-slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.pm-formula {
		min-height: 3.6rem;
		margin-top: 0.75rem;
		padding: 0.3rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		display: grid;
		place-items: center;
		overflow-x: auto;
		text-align: center;
	}
	.pm-formula .katex-display {
		margin: 0.35rem 0;
	}
	.pm-formula .katex {
		font-size: 1.2em;
	}
	.pm-live {
		min-height: 1.5em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pm-live b {
		color: var(--sl-color-white);
	}
	.pm-cap {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.pm-c-acc {
		color: var(--sl-color-accent);
	}
	.pm-c-vx {
		color: var(--ig-vx);
	}
	.pm-c-vy {
		color: var(--ig-vy);
	}
	.pm-c-v {
		color: var(--ig-v);
	}
	@media (max-width: 40rem) {
		.pm-box {
			padding: 0.75rem;
		}
		.pm-formula .katex {
			font-size: 1.05em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pm-btn,
		.pm-chip {
			transition: none;
		}
	}
</style>
<style is:global>
	.pm-n {
		color: var(--ig-vx);
		font-weight: 700;
	}
	.pm-s {
		color: var(--ig-vy);
		font-weight: 700;
	}
	.pm-check {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.pm-check input {
		accent-color: var(--sl-color-accent);
		margin: 0;
	}
	.pm-canvas {
		touch-action: none;
	}
</style>
