---
/**
 * Two short looping opening scenes of «Магнитное поле Земли». No numbers: the scenes show only what one sees; the
 * captions' popovers explain.
 * Aurora: a winter night in the north: snowy hills, spruces, a small village with lit windows, stars. A faint
 *   quiet arc of the northern lights grows into bright curtains that wave, fold and flicker, then fades back.
 *   True to the look of a real aurora (NASA, NPS «The Colors of the Aurora»): the oxygen green (557,7 nm,
 *   ~100–200 km) is the lowest and brightest part with a sharp lower edge, the oxygen red (630 nm, above ~200 km)
 *   forms the faint upper edge, at the brightest moment the lower edge turns purple-pink (nitrogen). The curtain
 *   is made of rays along the magnetic field lines: nearly vertical, converging slightly towards one point high in
 *   the sky (perspective). The near end of the curtain is big and high, the far end low and small, so its folds
 *   bunch up there; a second, distant curtain glows low over the hills. Snow reflects a little of the green.
 *   All motion is periodic in the scene time, so the end frame equals the start frame.
 * Turtles: loggerhead sea turtles (Caretta caretta) on a moonlit beach, seen from the side with the sand and the
 *   sea cut open. The camera starts close to a nest: a flask-shaped chamber about half a metre under the sand,
 *   full of eggs. The eggs crack, the hatchlings dig up through the sand, come out at night and crawl down the beach
 *   (alternating flippers, as loggerheads crawl), the camera pulls back and follows them through the surf into the
 *   open ocean, where they swim off near the surface past floating sargassum. A small globe appears in the sky: the
 *   North Atlantic with faint gray field lines of the Earth (a dipole, schematic), and a dot that goes from the
 *   Florida coast round the North Atlantic gyre and back (the loggerheads' route, Lohmann et al. 2001): the years
 *   pass. A big adult female swims back (synchronous strokes of the front flippers), comes ashore on the same beach,
 *   crawls up to the place of her own nest, digs a chamber with her hind flippers and lays her eggs into it, so the
 *   end frame is the start frame of the next generation. One world scale (about 60 px per metre at zoom 1:
 *   carapace 0,85 m, chamber top ~0,3 m and centre ~0,45 m deep); hatchlings are drawn ~1,9 times and eggs ~1,3 times too big
 *   to be seen, and the beach and the time are shortened.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import { LAND } from '@components/ch/zemlya/origin/land';

const gid = `ei-${Math.random().toString(36).slice(2, 8)}`;
// aurora scene: stars (seeded, fixed), hills, spruces, a village
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const starList = Array.from({ length: 48 }, (_, i) => ({
	x: (rnd() * 360).toFixed(1),
	y: (3 + rnd() * rnd() * 150).toFixed(1),
	r: (0.45 + rnd() * rnd() * 0.95).toFixed(2),
	o: (0.45 + rnd() * 0.55).toFixed(2),
	tw: i % 4 === 0,
}));
const RIDGE = 'M0 166 C 26 152 50 154 74 162 S 118 148 148 157 S 196 170 226 161 S 286 146 316 157 S 348 162 360 156 V240 H0 Z';
const FIELD = 'M0 192 C 50 180 104 183 158 189 S 262 176 360 184 V240 H0 Z';
const HILL_L = 'M0 212 C 40 197 98 199 148 212 S 206 232 224 240 H0 Z';
const HILL_R = 'M164 240 C 196 214 248 199 300 197 S 348 199 360 201 V240 Z';
const spruce = (x: number, b: number, h: number) => {
	const w = h * 0.44;
	const p = (dx: number, f: number) => `${(x + dx).toFixed(1)} ${(b - h * f).toFixed(1)}`;
	return (
		`M${p(0, 1)} L${p(w * 0.42, 0.62)} L${p(w * 0.2, 0.62)} L${p(w * 0.72, 0.28)} L${p(w * 0.36, 0.28)} ` +
		`L${p(w, 0.06)} L${p(w * 0.12, 0.06)} L${p(w * 0.12, 0)} L${p(-w * 0.12, 0)} L${p(-w * 0.12, 0.06)} ` +
		`L${p(-w, 0.06)} L${p(-w * 0.36, 0.28)} L${p(-w * 0.72, 0.28)} L${p(-w * 0.2, 0.62)} L${p(-w * 0.42, 0.62)} Z`
	);
};
const trees = [
	[16, 210, 42], [38, 205, 30], [58, 207, 24], [112, 205, 20], [128, 207, 15], [92, 186, 10], [101, 185, 8],
	[208, 216, 22], [350, 204, 20], [190, 186, 9],
].map(([x, b, h]) => spruce(x, b, h));
// houses: left x, base y, width, wall height, windows [x, y] relative to the left bottom corner
const houses = [
	{ x: 234, b: 214, w: 22, h: 13, win: [[7, -8]] },
	{ x: 262, b: 206, w: 30, h: 17, win: [[6, -11], [19, -11]], chimney: true },
	{ x: 300, b: 203, w: 19, h: 12, win: [] as number[][] },
	{ x: 324, b: 204, w: 25, h: 15, win: [[5, -10], [15, -10]] },
	{ x: 150, b: 190, w: 12, h: 7, win: [[4, -5]] },
].map((o) => ({
	...o,
	roof: `M${o.x - 3} ${o.b - o.h} L${o.x + o.w / 2} ${(o.b - o.h - o.w * 0.42).toFixed(1)} L${o.x + o.w + 3} ${o.b - o.h} Z`,
	s: o.w < 15 ? 0.6 : 1,
}));

// ---------- turtles ----------
// the profile of the beach and the sea floor: [x, y] in world units (y down, the sea surface at y = 150)
const PROF = [
	[-260, 100], [-80, 100], [-40, 103], [0, 109], [40, 118], [80, 126], [120, 131], [170, 138], [205, 145], [232, 150],
	[290, 162], [380, 186], [480, 208], [600, 226], [760, 234], [1400, 236],
];
// monotone cubic through PROF (the same function is in the script)
const sandAt = (() => {
	const n = PROF.length;
	const d = PROF.slice(0, -1).map((p, i) => (PROF[i + 1][1] - p[1]) / (PROF[i + 1][0] - p[0]));
	const m = PROF.map((_, i) => (i === 0 ? d[0] : i === n - 1 ? d[n - 2] : d[i - 1] * d[i] <= 0 ? 0 : (2 * d[i - 1] * d[i]) / (d[i - 1] + d[i])));
	return (x: number) => {
		let i = 0;
		while (i < n - 2 && x > PROF[i + 1][0]) i++;
		const [x0, y0] = PROF[i];
		const [x1, y1] = PROF[i + 1];
		const h = x1 - x0;
		const t = Math.min(1, Math.max(0, (x - x0) / h));
		const t2 = t * t;
		const t3 = t2 * t;
		return (2 * t3 - 3 * t2 + 1) * y0 + (t3 - 2 * t2 + t) * h * m[i] + (-2 * t3 + 3 * t2) * y1 + (t3 - t2) * h * m[i + 1];
	};
})();
const r1 = (v: number) => Math.round(v * 10) / 10;
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
const sandTop: string[] = [];
for (let x = -300; x <= 1500; x += 4) sandTop.push(`${x} ${r1(sandAt(x))}`);
const SAND = `M${sandTop.join(' L')} L1500 420 L-300 420 Z`;
// the dry, lighter top layer of the beach (a thin band along the surface above the water line)
const dryTop: string[] = [];
for (let x = -300; x <= 236; x += 4) dryTop.push(`${x} ${r1(sandAt(x))}`);
const dryBot: string[] = [];
for (let x = 236; x >= -300; x -= 4) dryBot.push(`${x} ${r1(sandAt(x) + 3 + 1.2 * Math.sin(x * 0.11))}`);
const DRY = `M${dryTop.join(' L')} L${dryBot.join(' L')} Z`;
// the nest: x = 80, the sand surface there, the chamber (centre ~0,45 m deep) and its neck
const NX = 80;
const NS = sandAt(NX);
const CH = { x: NX + 1, y: NS + 28, rx: 8.5, ry: 8 };
const CHAMBER = `M${CH.x - 3} ${r1(CH.y - CH.ry - 6)} C${CH.x - 3} ${r1(CH.y - CH.ry - 1)} ${CH.x - CH.rx - 1} ${r1(CH.y - CH.ry + 1)} ${CH.x - CH.rx} ${CH.y} C${CH.x - CH.rx} ${r1(CH.y + CH.ry * 1.1)} ${CH.x + CH.rx} ${r1(CH.y + CH.ry * 1.1)} ${CH.x + CH.rx} ${CH.y} C${CH.x + CH.rx + 1} ${r1(CH.y - CH.ry + 1)} ${CH.x + 3} ${r1(CH.y - CH.ry - 1)} ${CH.x + 3} ${r1(CH.y - CH.ry - 6)} Z`;
// the column of loosened sand the hatchlings dig up through
const shaftL: string[] = [];
const shaftR: string[] = [];
for (let i = 0; i <= 8; i++) {
	const y = lerp(NS - 0.6, CH.y - CH.ry + 1, i / 8);
	shaftL.push(`${r1(CH.x - 2.6 - 0.6 * Math.sin(i * 1.9))} ${r1(y)}`);
	shaftR.unshift(`${r1(CH.x + 2.5 + 0.6 * Math.sin(i * 2.7 + 1))} ${r1(y)}`);
}
const SHAFT = `M${shaftL.join(' L')} L${shaftR.join(' L')} Z`;
const NECK = `M${CH.x - 3} ${r1(NS - 0.5)} L${CH.x - 3} ${r1(CH.y - CH.ry - 5)} L${CH.x + 3} ${r1(CH.y - CH.ry - 5)} L${CH.x + 3} ${r1(NS - 0.5)} Z`;
// the eggs (diameter ~4 cm, drawn ~1,3 times bigger), packed in the chamber from the bottom up
const ER = 1.55;
const eggs: { x: number; y: number; a: number }[] = [];
let eggSeed = 3;
const eggRnd = () => ((eggSeed = (eggSeed * 16807) % 2147483647) - 1) / 2147483646;
for (let row = 0; row < 7; row++)
	for (let k = -4; k <= 4; k++) {
		const x = CH.x + k * 2 * ER + (row % 2 ? ER : 0);
		const y = CH.y + CH.ry - ER - 0.3 - row * ER * 1.75;
		if (((x - CH.x) / (CH.rx - ER)) ** 2 + ((y - CH.y) / (CH.ry - ER + 0.6)) ** 2 <= 1) eggs.push({ x: r1(x), y: r1(y), a: Math.round(-50 + 100 * eggRnd()) });
	}
// dune grass (sea oats): tufts of blades
const grass: string[] = [];
{
	let s = 5;
	const rr = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
	for (const gx of [-150, -124, -98, -74, -52, -30, -10, 10, 28, 46]) {
		const base = sandAt(gx);
		for (let b = 0; b < 5; b++) {
			const x0 = gx + (rr() - 0.5) * 6;
			const h = 9 + rr() * 10;
			const lean = (rr() - 0.3) * 7;
			grass.push(`M${r1(x0)} ${r1(base + 0.5)} Q${r1(x0 + lean * 0.3)} ${r1(base - h * 0.6)} ${r1(x0 + lean)} ${r1(base - h)}`);
		}
	}
}
const GRASS = grass.join(' ');
// seed heads of the sea oats
const OATS = [[-122, 0], [-52, 0], [10, 0]].map(([x]) => ({ x, y: r1(sandAt(x) - 19) }));
// floating sargassum in the open ocean
const SARG = [
	{ x: 640, w: 26 },
	{ x: 790, w: 34 },
	{ x: 905, w: 22 },
];
// stars of the turtles' sky (seeded)
const tStars = (() => {
	let s = 19;
	const rr = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
	return Array.from({ length: 40 }, () => ({ x: r1(rr() * 360), y: r1(3 + rr() * rr() * 120), r: (0.4 + rr() * rr() * 0.9).toFixed(2), o: (0.4 + rr() * 0.5).toFixed(2) }));
})();

// the globe: orthographic view of the North Atlantic, land from the Natural Earth 1:110m mask of the «Земля» chapter
const GR = 24;
const LAT0 = (27 * Math.PI) / 180;
const LON0 = (-48 * Math.PI) / 180;
const mask = new Uint8Array(256 * 128);
{
	const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
	let k = 0;
	let on = 0;
	for (let i = 0; i < LAND.length; i += 2) {
		const n = A.indexOf(LAND[i]) * 64 + A.indexOf(LAND[i + 1]);
		if (on) mask.fill(1, k, k + n);
		k += n;
		on ^= 1;
	}
}
const landAt = (u: number, v: number) => {
	const z = Math.sqrt(Math.max(0, 1 - u * u - v * v));
	const lat = Math.asin(v * Math.cos(LAT0) + z * Math.sin(LAT0));
	const lon = LON0 + Math.atan2(u, z * Math.cos(LAT0) - v * Math.sin(LAT0));
	const c = ((Math.floor(((lon / Math.PI + 1) / 2) * 256) % 256) + 256) % 256;
	const r = Math.min(127, Math.floor((0.5 - lat / Math.PI) * 128));
	return mask[r * 256 + c] === 1;
};
const GSTEP = 0.5;
let GLAND = '';
for (let y = -GR; y < GR; y += GSTEP) {
	let x0: number | null = null;
	for (let x = -GR; x <= GR; x += GSTEP) {
		const u = (x + GSTEP / 2) / GR;
		const v = -(y + GSTEP / 2) / GR;
		const on = x < GR && u * u + v * v < 1 && landAt(u, v);
		if (on && x0 === null) x0 = x;
		if (!on && x0 !== null) {
			GLAND += `M${x0} ${y}h${x - x0}v${GSTEP}h${x0 - x}z`;
			x0 = null;
		}
	}
}
const ortho = (lat: number, lon: number) => {
	const p = (lat * Math.PI) / 180;
	const l = (lon * Math.PI) / 180 - LON0;
	return [GR * Math.cos(p) * Math.sin(l), -GR * (Math.cos(LAT0) * Math.sin(p) - Math.sin(LAT0) * Math.cos(p) * Math.cos(l))];
};
// the loggerheads' loop round the North Atlantic gyre: from the Florida coast with the Gulf Stream to the north-east,
// past the Azores, south along Africa with the Canary Current, west with the North Equatorial Current, home
const ROUTE = [
	[28.2, -80.4], [30.5, -79.6], [33, -77.5], [35.5, -73.5], [38.2, -66], [40, -56], [40.5, -46], [39.2, -36], [36.8, -27],
	[32.5, -20.5], [27.5, -18.5], [22, -22], [17.5, -30], [15, -40], [14.5, -50], [16, -59], [18.5, -66], [21.8, -72],
	[25, -76.5], [27, -79.6], [28.2, -80.4],
];
const routePts: number[][] = [];
for (let i = 0; i < ROUTE.length - 1; i++) {
	const p0 = ROUTE[Math.max(0, i - 1)];
	const p1 = ROUTE[i];
	const p2 = ROUTE[i + 1];
	const p3 = ROUTE[Math.min(ROUTE.length - 1, i + 2)];
	for (let k = 0; k < 6; k++) {
		const t = k / 6;
		const cr = (a: number, b: number, c: number, d: number) =>
			0.5 * (2 * b + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t * t + (-a + 3 * b - 3 * c + d) * t * t * t);
		routePts.push(ortho(cr(p0[0], p1[0], p2[0], p3[0]), cr(p0[1], p1[1], p2[1], p3[1])));
	}
}
routePts.push(ortho(ROUTE[0][0], ROUTE[0][1]));
const GROUTE = 'M' + routePts.map(([x, y]) => `${r1(x)} ${r1(y)}`).join(' L');
const HOME = ortho(ROUTE[0][0], ROUTE[0][1]).map(r1);
// field lines of a dipole round the globe (in the picture plane, schematic): r = L·R·sin²ψ
const GFIELD: string[] = [];
for (const L of [1.4, 1.95, 2.75])
	for (const s of [-1, 1]) {
		const psi0 = Math.asin(Math.sqrt(1 / L));
		const pts: string[] = [];
		for (let i = 0; i <= 48; i++) {
			const psi = psi0 + ((Math.PI - 2 * psi0) * i) / 48;
			const r = L * GR * Math.sin(psi) ** 2;
			pts.push(`${r1(s * r * Math.sin(psi))} ${r1(-r * Math.cos(psi))}`);
		}
		GFIELD.push('M' + pts.join(' L'));
	}
const NPOLE = ortho(90, 0).map(r1);
---

<IntroFrame data-eintro>
	<div class="intro__card" data-scene="aurora">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимняя ночь на севере: заснеженные холмы, ели, маленький посёлок со светящимися окнами, звёзды. Над холмами разгорается полярное сияние: зелёные занавеси с красным верхним краем колышутся, становятся всё ярче, а потом гаснут.">
			<defs>
				<linearGradient id={`${gid}-sky`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="ea-sky0"></stop>
					<stop offset="1" class="ea-sky1"></stop>
				</linearGradient>
				<!-- one ray of the curtain, from its lower edge (bottom) up -->
				<linearGradient id={`${gid}-ray`} x1="0" y1="1" x2="0" y2="0" data-ray>
					<stop offset="0" class="ea-hem" data-hem></stop>
					<stop offset="0.05" class="ea-g" style="stop-opacity: 1"></stop>
					<stop offset="0.22" class="ea-g" style="stop-opacity: 0.8"></stop>
					<stop offset="0.46" class="ea-g" style="stop-opacity: 0.28"></stop>
					<stop offset="0.64" class="ea-r" data-red></stop>
					<stop offset="0.82" class="ea-r" data-red2></stop>
					<stop offset="1" class="ea-r" style="stop-opacity: 0"></stop>
				</linearGradient>
				<radialGradient id={`${gid}-glow`} cx="0.5" cy="0.5" r="0.5">
					<stop offset="0" class="ea-g" style="stop-opacity: 0.3"></stop>
					<stop offset="1" class="ea-g" style="stop-opacity: 0"></stop>
				</radialGradient>
				<radialGradient id={`${gid}-win`} cx="0.5" cy="0.5" r="0.5">
					<stop offset="0" class="ea-w" style="stop-opacity: 0.5"></stop>
					<stop offset="1" class="ea-w" style="stop-opacity: 0"></stop>
				</radialGradient>
				<filter id={`${gid}-soft`} filterUnits="userSpaceOnUse" x="-20" y="-20" width="400" height="280">
					<feGaussianBlur in="SourceGraphic" stdDeviation="7" result="wide"></feGaussianBlur>
					<feGaussianBlur in="SourceGraphic" stdDeviation="1.4" result="fine"></feGaussianBlur>
					<feMerge>
						<feMergeNode in="wide"></feMergeNode>
						<feMergeNode in="fine"></feMergeNode>
					</feMerge>
				</filter>
				<filter id={`${gid}-haze`} x="-1" y="-1" width="3" height="3">
					<feGaussianBlur stdDeviation="1.6"></feGaussianBlur>
				</filter>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${gid}-sky)`}></rect>
			<g class="ea-stars">
				{starList.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} data-tw={s.tw ? s.o : undefined} />)}
			</g>
			<ellipse cx="150" cy="122" rx="230" ry="78" fill={`url(#${gid}-glow)`} data-skyglow></ellipse>
			<!-- the curtains: rays are added by the script -->
			<g filter={`url(#${gid}-soft)`}>
				<g data-far></g>
				<g data-near></g>
			</g>
			<!-- the land -->
			<path class="ea-ridge" d={RIDGE}></path>
			<path class="ea-snow1" d={FIELD}></path>
			<path class="ea-snow2" d={HILL_L}></path>
			<path class="ea-snow2" d={HILL_R}></path>
			<g class="ea-snowglow" data-snowglow>
				<path d={RIDGE}></path>
				<path d={FIELD}></path>
				<path d={HILL_L}></path>
				<path d={HILL_R}></path>
			</g>
			{trees.map((d) => <path class="ea-tree" d={d} />)}
			<!-- the village -->
			{houses.map((o) => (
				<g>
					{o.win.map(([wx, wy]) => <circle cx={o.x + wx + 2 * o.s} cy={o.b + wy + 2 * o.s} r={12 * o.s} fill={`url(#${gid}-win)`} />)}
					{o.chimney && <rect class="ea-hwall" x={o.x + o.w - 9} y={o.b - o.h - 14} width="4" height="10" />}
					<rect class="ea-hwall" x={o.x} y={o.b - o.h} width={o.w} height={o.h} />
					<path class="ea-roof" d={o.roof} />
					{o.win.map(([wx, wy]) => <rect class="ea-window" x={o.x + wx} y={o.b + wy} width={4 * o.s} height={4 * o.s} />)}
				</g>
			))}
			<g class="ea-smoke" data-smoke filter={`url(#${gid}-haze)`}>
				<circle cx="285" cy="174" r="2"></circle>
				<circle cx="285" cy="174" r="2"></circle>
				<circle cx="285" cy="174" r="2"></circle>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Ночью на севере в небе разгорается полярное сияние: колышутся зелёные занавеси с красным верхним краем. Это <More term="светится сам воздух высоко над Землёй">От Солнца к Земле прилетают быстрые заряженные частицы. Магнитное поле Земли направляет их к полярным областям, и на высоте примерно 100–300 км частицы налетают на газы воздуха и заставляют их светиться. Кислород светится зелёным (ниже) и красным (выше), азот — синим и фиолетовым. Частицы летят вдоль магнитного поля, поэтому сияние состоит из почти вертикальных лучей. Подробнее — в разделе <a href="#магнитные-бури-и-полярные-сияния">«Магнитные бури и полярные сияния»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="turtles" data-prof={JSON.stringify(PROF)} data-nest={JSON.stringify({ x: NX, s: r1(NS), cx: CH.x, cy: CH.y, top: r1(CH.y - CH.ry) })}>
