<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-eintro]')) {
		// Aurora: a faint quiet arc (start = end) brightens into waving curtains and fades back; 11 s.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="aurora"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const NS = 'http://www.w3.org/2000/svg';
			const fill = `url(#${$<SVGLinearGradientElement>('[data-ray]').id})`;
			const hem = $<SVGStopElement>('[data-hem]');
			const red = $<SVGStopElement>('[data-red]');
			const red2 = $<SVGStopElement>('[data-red2]');
			const skyglow = $<SVGEllipseElement>('[data-skyglow]');
			const snowglow = $<SVGGElement>('[data-snowglow]');
			const smoke = [...card.querySelectorAll<SVGCircleElement>('[data-smoke] circle')];
			const twinkle = [...card.querySelectorAll<SVGCircleElement>('[data-tw]')].map((el, i) => ({
				el,
				o: Number(el.dataset.tw),
				w: 1.3 + (i % 5) * 0.45,
				ph: i * 2.1,
			}));
			let seed = 11;
			const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
			// each ray flickers with a whole number of cycles per run, so the loop has no seam
			const rays = (g: SVGGElement, n: number) =>
				Array.from({ length: n }, (_, i) => {
					const el = document.createElementNS(NS, 'rect');
					el.setAttribute('fill', fill);
					g.appendChild(el);
					return { el, u: clamp((i + 0.7 * (rnd() - 0.5)) / (n - 1)), f: 3 + Math.floor(rnd() * 6), ph: rnd() * 6.283, g: 2 + Math.floor(rnd() * 4), ps: rnd() * 6.283 };
				});
			const near = rays($<SVGGElement>('[data-near]'), 160);
			const far = rays($<SVGGElement>('[data-far]'), 80);
			const TAU = 2 * Math.PI;
			const S0 = 1 - Math.exp(-1.6);
			// a ray at (x, base): rect from the base up, leaning towards a point high above the sky (the rays are
			// parallel to the magnetic field; in perspective they converge)
			const put = (el: SVGRectElement, x: number, base: number, h: number, w: number, op: number) => {
				const lean = (Math.atan((150 - x) / (base + 900)) * 180) / Math.PI;
				el.setAttribute('transform', `translate(${f1(x)} ${f1(base)}) rotate(${f1(lean)})`);
				el.setAttribute('x', f2(-w / 2));
				el.setAttribute('y', f1(-h));
				el.setAttribute('width', f2(w));
				el.setAttribute('height', f1(h));
				el.setAttribute('opacity', f2(op));
			};
			scene(card, 11, (x) => {
				const ph = TAU * x;
				const act = smooth(0.06, 0.42, x) * (1 - smooth(0.64, 0.96, x));
				const peak = smooth(0.34, 0.48, x) * (1 - smooth(0.58, 0.74, x));
				const B = 0.16 + 0.84 * act;
				hem.style.stopOpacity = f2(0.8 * peak);
				red.style.stopOpacity = f2(0.3 + 0.22 * act);
				red2.style.stopOpacity = f2(0.16 + 0.16 * act);
				skyglow.setAttribute('opacity', f2(0.08 + 0.72 * act));
				snowglow.style.opacity = f2(0.03 + 0.13 * act);
				// the near curtain: big and high at the left, receding to the right; folds travel along it
				const drift = 10 * Math.sin(ph);
				const fold = 8 + 22 * act;
				for (const r of near) {
					const u = r.u;
					const p = 1 - 0.45 * u;
					const X =
						-40 +
						(420 * (1 - Math.exp(-1.6 * u))) / S0 +
						drift * p +
						fold * p * Math.sin(TAU * 3.2 * u - ph + 0.4) +
						0.35 * fold * p * Math.sin(TAU * 7 * u + 2 * ph);
					// where the curtain folds away from us its lower edge sinks and the rays get shorter
					const deep = (fold / 30) * Math.cos(TAU * 3.2 * u - ph + 0.4);
					const base = 110 + 40 * u + 9 * p * deep + 3 * p * Math.sin(TAU * 2.3 * u - ph);
					const h = 90 * (1 - 0.5 * u) * (1 - 0.12 * deep) * (0.55 + 0.45 * act) * (0.82 + 0.18 * Math.sin(r.g * ph + r.ps));
					const flick = 0.5 + 0.5 * Math.sin(r.f * ph + r.ph);
					const pulse = 0.5 + 0.5 * Math.sin(TAU * 4 * u - 2 * ph);
					const env = smooth(0, 0.06, u) * (1 - smooth(0.9, 1, u));
					const op = B * env * (0.35 + 0.35 * flick * (0.4 + 0.6 * act) + 0.3 * pulse * act);
					put(r.el, X, base, h, 5.5 * (1 - 0.55 * u), op);
				}
				// the far curtain: low over the hills, fainter, a little behind in time
				const actF = smooth(0.18, 0.5, x) * (1 - smooth(0.7, 0.98, x));
				for (const r of far) {
					const u = r.u;
					const X = -10 + 380 * u + 6 * Math.sin(TAU * 2.5 * u + ph);
					const base = 172 + 3 * Math.sin(TAU * 1.7 * u - ph);
					const h = 34 * (0.6 + 0.4 * actF) * (0.8 + 0.2 * Math.sin(r.g * ph + r.ps));
					const flick = 0.5 + 0.5 * Math.sin(r.f * ph + r.ph);
					const patch = 0.5 + 0.5 * Math.sin(TAU * 1.4 * u + ph + 1);
					put(r.el, X, base, h, 2.6, (0.06 + 0.5 * actF) * (0.25 + 0.75 * patch) * (0.5 + 0.5 * flick));
				}
				// chimney smoke rises twice per run
				smoke.forEach((c, k) => {
					const q = (2 * x + k / 3) % 1;
					c.setAttribute('cx', f1(285 + 7 * q + 1.5 * Math.sin(TAU * q)));
					c.setAttribute('cy', f1(174 - 26 * q));
					c.setAttribute('r', f1(2.5 + 6 * q));
					c.style.opacity = f2(0.22 * Math.sin(Math.PI * q));
				});
				// a few stars twinkle (wall-clock time: they keep twinkling during the pause between runs)
				const now = performance.now() / 1000;
				for (const s of twinkle) s.el.setAttribute('opacity', f2(s.o * (0.65 + 0.35 * Math.sin(s.w * now + s.ph))));
			});
		}

		// Turtles: the eggs hatch and the hatchlings swim off (→ 0,5), the globe shows the years in the ocean
		// (0,42 → 0,76), the grown female swims back, comes ashore and lays her eggs in the same place (0,55 → 0,99); 20 s.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="turtles"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const TAU = 2 * Math.PI;
			const RUN = 20;
			const PROF: number[][] = JSON.parse(card.dataset.prof!);
			const NEST: { x: number; s: number; cy: number; top: number; cx: number } = JSON.parse(card.dataset.nest!);
			// the beach profile: the same monotone cubic as in the frontmatter
			const S = (() => {
				const n = PROF.length;
				const d = PROF.slice(0, -1).map((p, i) => (PROF[i + 1][1] - p[1]) / (PROF[i + 1][0] - p[0]));
				const m = PROF.map((_, i) => (i === 0 ? d[0] : i === n - 1 ? d[n - 2] : d[i - 1] * d[i] <= 0 ? 0 : (2 * d[i - 1] * d[i]) / (d[i - 1] + d[i])));
				return (x: number) => {
					let i = 0;
					while (i < n - 2 && x > PROF[i + 1][0]) i++;
					const [x0, y0] = PROF[i];
					const [x1, y1] = PROF[i + 1];
					const h = x1 - x0;
					const t = clamp((x - x0) / h);
					const t2 = t * t;
					const t3 = t2 * t;
					return (2 * t3 - 3 * t2 + 1) * y0 + (t3 - 2 * t2 + t) * h * m[i] + (-2 * t3 + 3 * t2) * y1 + (t3 - t2) * h * m[i + 1];
				};
			})();
			const slope = (x: number) => (Math.atan((S(x + 1.5) - S(x - 1.5)) / 3) * 180) / Math.PI;
			const SEA = 150; // the sea level
			const SHORE = 232; // where the sea meets the sand
			const world = $<SVGGElement>('[data-world]');
			const water = $<SVGPathElement>('[data-water]');
			const surf = $<SVGPathElement>('[data-surf]');
			const swash = $<SVGPathElement>('[data-swash]');
			const shaft = $<SVGPathElement>('[data-shaft]');
			const neck = $<SVGPathElement>('[data-neck]');
			const chamber = $<SVGPathElement>('[data-chamber]');
			const grains = [...card.querySelectorAll<SVGCircleElement>('[data-grains] circle')];
			const globe = $<SVGGElement>('[data-globe]');
			const route = $<SVGPathElement>('[data-route]');
			const dot = $<SVGCircleElement>('[data-dot]');
			const RL = route.getTotalLength();
			route.style.strokeDasharray = `${f1(RL + 1)} ${f1(RL + 1)}`;
			// wet sand: a dark band along the surface where the waves run up
			{
				const top: string[] = [];
				const bot: string[] = [];
				for (let x = 206; x <= SHORE + 6; x += 2) {
					top.push(`${x} ${f2(S(x) - 0.1)}`);
					bot.unshift(`${x} ${f2(S(x) + 2.2 * smooth(206, 222, x))}`);
				}
				$<SVGPathElement>('[data-wet]').setAttribute('d', `M${top.join(' L')} L${bot.join(' L')} Z`);
			}
			const eggs = [...card.querySelectorAll<SVGGElement>('[data-egg]')].map((g) => ({
				x: Number(g.dataset.x),
				y: Number(g.dataset.y),
				whole: g.querySelector<SVGElement>('[data-whole]')!,
				broken: g.querySelector<SVGElement>('[data-broken]')!,
			}));
			const NE = eggs.length;
			// the turtles: the adult in the markup, the hatchlings are its copies
			type T = { g: SVGGElement; ff: SVGGElement; ff2: SVGGElement; hf: SVGGElement; hf2: SVGGElement; head: SVGGElement };
			const parts = (g: SVGGElement): T => ({
				g,
				ff: g.querySelector('[data-ff]')!,
				ff2: g.querySelector('[data-ff2]')!,
				hf: g.querySelector('[data-hf]')!,
				hf2: g.querySelector('[data-hf2]')!,
				head: g.querySelector('[data-head]')!,
			});
			const adultG = $<SVGGElement>('[data-adult]');
			const adult = parts(adultG);
			const babies = Array.from({ length: 6 }, () => {
				const g = adultG.cloneNode(true) as SVGGElement;
				g.removeAttribute('data-adult');
				g.classList.add('et-baby');
				$<SVGGElement>('[data-babies]').appendChild(g);
				return parts(g);
			});
			// flipper angles in degrees (0 = along the body forwards, 90 = down, 180 = backwards); k shortens a flipper
			// that points towards us (on land the front flippers stand out sideways)
			type Pose = { ff: number; ff2: number; hf: number; hf2: number; kf: number; kh: number; head: number };
			// on land loggerheads crawl with alternating flippers
			const crawl = (ph: number): Pose => ({
				ff: 90 + 36 * Math.sin(ph),
				ff2: 90 - 36 * Math.sin(ph),
				hf: 150 - 14 * Math.sin(ph),
				hf2: 150 + 14 * Math.sin(ph),
				kf: 0.38,
				kh: 0.62,
				head: 5 + 2 * Math.sin(2 * ph),
			});
			// in water both front flippers beat together, like wings
			const swim = (ph: number): Pose => ({
				ff: 172 + 30 * Math.sin(ph),
				ff2: 166 + 30 * Math.sin(ph),
				hf: 168 + 7 * Math.sin(ph),
				hf2: 172 + 7 * Math.sin(ph),
				kf: 1,
				kh: 0.9,
				head: 3,
			});
			const mixPose = (a: Pose, b: Pose, t: number): Pose => ({
				ff: lerp(a.ff, b.ff, t),
				ff2: lerp(a.ff2, b.ff2, t),
				hf: lerp(a.hf, b.hf, t),
				hf2: lerp(a.hf2, b.hf2, t),
				kf: lerp(a.kf, b.kf, t),
				kh: lerp(a.kh, b.kh, t),
				head: lerp(a.head, b.head, t),
			});
			const limb = (el: SVGGElement, px: number, py: number, a: number, k: number) =>
				el.setAttribute('transform', `translate(${px} ${py}) rotate(${f1(a)}) scale(${f2(k)} 1)`);
			const place = (t: T, x: number, y: number, ang: number, s: number, face: number, p: Pose, op: number) => {
				t.g.style.opacity = f2(op);
				if (op <= 0) return;
				t.g.setAttribute('transform', `translate(${f2(x)} ${f2(y)}) rotate(${f1(ang)}) scale(${(face * s).toFixed(4)} ${s.toFixed(4)})`);
				limb(t.ff, 34, -11, p.ff, p.kf);
				limb(t.ff2, 36, -12, p.ff2, p.kf);
				limb(t.hf, -40, -7, p.hf, p.kh);
				limb(t.hf2, -38, -8, p.hf2, p.kh);
				t.head.setAttribute('transform', `rotate(${f1(p.head)} 40 -16)`);
			};
			const AS = 0.51; // the adult: carapace 0,85 m at 60 px/m
			const BS = 0.05; // a hatchling: carapace ~4,5 cm, drawn ~1,9 times bigger
			// the hatchlings' schedule: egg cracks, out of the sand, at the water
			const hatch = babies.map((b, i) => {
				const egg = eggs[NE - 1 - ((i * 3) % NE)];
				const tc = 0.035 + 0.01 * i;
				const te = 0.09 + 0.017 * i;
				const tw = te + 0.01 + 0.085 + 0.012 * ((i * 7) % 3);
				return { b, egg, tc, te, tw, ts: tw + 0.2, f: 1.1 + 0.15 * (i % 3), dy: 0.6 * (i % 2) };
			});
			const crackAt = eggs.map((_, k) => {
				const h = hatch.find((o) => o.egg === eggs[k]);
				return h ? h.tc : 0.04 + ((k * 37) % 23) * 0.003;
			});
			const layAt = eggs.map((_, k) => 0.915 + (0.07 * k) / NE);
			// the camera: the world point at the centre of the frame and the zoom
			type Cam = [number, number, number];
			const C0: Cam = [NEST.x, 146, 3.2];
			const C1: Cam = [156, 136, 2];
			const C2: Cam = [760, 162, 1.3];
			const C3: Cam = [70, 140, 2.2];
			const blend = (a: Cam, b: Cam, t: number): Cam => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), a[2] * Math.pow(b[2] / a[2], t)];
			const camera = (x: number): Cam => {
				if (x < 0.27) return blend(C0, C1, smooth(0.08, 0.24, x));
				if (x < 0.58) return blend(C1, C2, smooth(0.27, 0.45, x));
				const k = smooth(0.62, 0.78, x);
				const F: Cam = [lerp(760, 160, smooth(0.58, 0.78, x)), lerp(162, 140, k), lerp(1.3, 1.4, k)];
				return blend(F, C3, smooth(0.8, 0.92, x));
			};
			// the adult's way: in deep water she swims at one depth, in the shallows she follows the bottom
			const swimY = (x: number, u: number) => Math.min(S(x), 186 + 3 * Math.sin(TAU * 2 * u));
			const AX = NEST.x - 22; // she stops with her tail over the nest
			const grain = (c: SVGCircleElement, x0: number, y0: number, vx: number, vy: number, tau: number, op: number) => {
				c.setAttribute('cx', f2(x0 + vx * tau));
				c.setAttribute('cy', f2(y0 - vy * tau + 0.5 * 588 * tau * tau)); // g = 9,8 m/s² at 60 px/m
				c.style.opacity = f2(op);
			};

			scene(card, RUN, (x) => {
				const sec = x * RUN;
				const [cx, cy, z] = camera(x);
				world.setAttribute('transform', `translate(${f2(180 - cx * z)} ${f2(120 - cy * z)}) scale(${z.toFixed(4)})`);
				// the sea: a gentle swell on the surface and waves that run up the sand (10 per run)
				const pts: string[] = [];
				for (let wx = SHORE - 14; wx <= 1500; wx += 6)
					pts.push(`${wx} ${f2(SEA + 0.7 * Math.sin(0.09 * wx + TAU * 6 * x) + 0.35 * Math.sin(0.23 * wx - TAU * 9 * x))}`);
				water.setAttribute('d', `M${pts.join(' L')} L1500 420 L${SHORE - 14} 420 Z`);
				surf.setAttribute('d', `M${pts.join(' L')}`);
				const wave = 0.5 - 0.5 * Math.cos(TAU * 10 * x);
				const xr = SHORE + 2 - 22 * wave;
				const top: string[] = [];
				const bot: string[] = [];
				for (let i = 0; i <= 12; i++) {
					const wx = lerp(xr, SHORE + 1, i / 12);
					const th = Math.sqrt(i / 12) * (1 - (i / 12) ** 6);
					top.push(`${f2(wx)} ${f2(S(wx) - 1.3 * th * (0.4 + 0.6 * wave))}`);
					bot.unshift(`${f2(wx)} ${f2(S(wx) + 0.2)}`);
				}
				swash.setAttribute('d', `M${top.join(' L')} L${bot.join(' L')} Z`);
				swash.style.opacity = f2(0.25 + 0.4 * wave);

				// the nest: the old chamber is there at the start, a new one is dug at the end
				const dig = smooth(0.875, 0.905, x);
				chamber.style.opacity = f2(Math.max(1 - smooth(0.45, 0.47, x), smooth(0.885, 0.915, x)));
				neck.style.opacity = f2(dig);
				shaft.style.opacity = f2(0.75 * smooth(0.05, 0.08, x) * (1 - smooth(0.2, 0.3, x)));
				eggs.forEach((e, k) => {
					const laid = x >= layAt[k];
					const hatched = x >= crackAt[k] && x < 0.45;
					e.broken.style.opacity = hatched ? '0.75' : '0';
					let op = laid || x < crackAt[k] ? 1 : 0;
					let tr = '';
					if (laid) {
						// a new egg falls down the neck into the chamber
						const q = clamp((x - layAt[k]) / 0.006);
						const fy = NEST.s + 1;
						const p = q < 0.6 ? q / 0.6 : 1;
						const yy = q < 0.6 ? lerp(fy, NEST.top, p * p) : lerp(NEST.top, e.y, (q - 0.6) / 0.4);
						const xx = q < 0.6 ? NEST.cx : lerp(NEST.cx, e.x, (q - 0.6) / 0.4);
						tr = `translate(${f2(xx - e.x)} ${f2(yy - e.y)})`;
					}
					e.whole.style.opacity = String(op);
					e.whole.setAttribute('transform', tr);
				});

				// the hatchlings
				for (const h of hatch) {
					const ex = h.egg.x;
					const ey = h.egg.y;
					let op = x < h.tc || x > h.ts ? 0 : smooth(h.tc, h.tc + 0.006, x);
					let px = ex;
					let py = ey;
					let ang = -75;
					let p = crawl(TAU * 2.6 * h.f * sec);
					if (x < h.te) {
						// out of the egg and up through the sand, wriggling
						const q = clamp((x - h.tc - 0.004) / (h.te - h.tc - 0.004));
						if (q < 0.3) {
							px = lerp(ex, NEST.cx, q / 0.3);
							py = lerp(ey, NEST.top + 1, q / 0.3);
						} else {
							px = NEST.cx + 0.6 * Math.sin(TAU * 3 * q);
							py = lerp(NEST.top + 1, NEST.s, (q - 0.3) / 0.7);
						}
						ang = -75 + 14 * Math.sin(TAU * 2.2 * h.f * sec) * (1 - smooth(h.te - 0.012, h.te, x));
					} else if (x < h.tw) {
						// out on the sand: a short rest, then down the beach to the sea
						const q = clamp((x - h.te - 0.01) / (h.tw - h.te - 0.01));
						const st = TAU * 9 * q;
						px = lerp(NEST.cx, SHORE + 2, q) + 0.5 * Math.sin(st);
						py = S(px);
						ang = lerp(-75, slope(px), smooth(h.te, h.te + 0.01, x));
						p = crawl(st);
					} else {
						// in the sea: just under the surface, off to the open ocean
						const q = clamp((x - h.tw) / (h.ts - h.tw));
						px = SHORE + 2 + 790 * q;
						const depth = SEA + 3.2 + h.dy + 0.6 * Math.sin(TAU * 0.6 * sec + h.f);
						py = Math.min(S(px) - 0.2, depth);
						ang = lerp(slope(px), 2 * Math.sin(TAU * 1.5 * sec), smooth(0, 0.05, q));
						p = mixPose(crawl(TAU * 9 * 1), swim(TAU * 3.2 * h.f * sec), smooth(0, 0.03, q));
					}
					place(h.b, px, py, ang, BS, 1, p, op);
				}
				// grains of sand: a little puff where each hatchling comes out, then the female's digging
				grains.forEach((c, k) => {
					if (x < 0.5) {
						const h = hatch[k % 6];
						const tau = (x - h.te + (k >= 6 ? -0.004 : 0)) * RUN;
						if (tau > 0 && tau < 0.25) grain(c, NEST.x, NEST.s - 0.5, (k % 2 ? 9 : -7) + k, 28 + 2 * k, tau, 1 - tau / 0.25);
						else c.style.opacity = '0';
					} else {
						const tau = (((sec - 0.875 * RUN) / 0.32 + k / grains.length) % 1) * 0.32;
						const on = x > 0.875 && x < 0.93;
						if (on) grain(c, NEST.x + 4, NEST.s - 2.5, 40 + 5 * (k % 4), 55 + 7 * (k % 3), tau, 0.9 * (1 - tau / 0.32));
						else c.style.opacity = '0';
					}
				});

				// the grown female: back across the sea (0,55 → 0,76), up the beach (→ 0,88), digs and lays (→ 0,985)
				{
					let ax: number;
					let ay: number;
					let ang: number;
					let p: Pose;
					if (x < 0.76) {
						const u = smooth(0.55, 0.76, x);
						ax = lerp(960, SHORE + 4, u);
						ay = swimY(ax, x);
						ang = (Math.atan((swimY(ax + 2, x) - swimY(ax - 2, x)) / 4) * 180) / Math.PI;
						const land = 1 - smooth(SHORE + 4, 330, ax);
						p = mixPose(swim(TAU * sec / 1.7), crawl(TAU * sec / 0.9), land);
					} else if (x < 0.88) {
						// heavy lurching steps: the body moves when the front flippers pull
						const q = clamp((x - 0.76) / 0.12);
						const ph = TAU * sec / 0.9;
						ax = lerp(SHORE + 4, AX, q) - 1.2 * Math.sin(ph) * smooth(0.76, 0.78, x) * (1 - smooth(0.85, 0.88, x));
						ay = S(ax);
						ang = slope(ax);
						p = crawl(ph);
					} else {
						// at the nest: the hind flippers dig the chamber in turn, then she lays the eggs
						ax = AX;
						ay = S(ax) + 1.2 * smooth(0.87, 0.9, x);
						ang = slope(ax) - 1.5;
						const q = Math.sin(TAU * sec / 0.64) * (1 - smooth(0.93, 0.95, x));
						const nest: Pose = { ...crawl(0), ff: 110, ff2: 70, hf: 140 + 30 * q, hf2: 140 - 30 * q, kh: 0.85, head: 4 + Math.sin(TAU * sec / 3) };
						p = mixPose(crawl(TAU * sec / 0.9), nest, smooth(0.88, 0.895, x));
					}
					place(adult, ax, ay, ang, AS, -1, p, smooth(0.55, 0.56, x));
				}

				// the globe: the years in the ocean; the dot goes round the gyre and comes home
				globe.style.opacity = f2(smooth(0.42, 0.46, x) * (1 - smooth(0.74, 0.78, x)));
				const g = smooth(0.46, 0.7, x);
				const pt = route.getPointAtLength(g * RL);
				dot.setAttribute('cx', f2(pt.x));
				dot.setAttribute('cy', f2(pt.y));
				dot.setAttribute('r', f2(1.2 + 1 * g));
				route.style.strokeDashoffset = f1(RL + 1 - g * RL);
			});
		}
	}
</script>
