---
/**
 * Two short looping opening scenes of «Постоянные магниты. Магнитное поле Земли». No numbers: the scenes show only
 * what one sees; the captions' popovers explain.
 * Fridge: the front of a fridge in a kitchen. A hand brings a paper note with a round magnet from in front of the
 *   door (drawn larger and with a long soft shadow: it is closer to us). Near the steel door the magnet leaves the
 *   fingers and snaps to the door by itself (the force grows steeply as the gap closes), the hand goes away, the
 *   note swings a little on the magnet and stays.
 * Aurora: a winter night in the north: snowy hills, spruces, a small village with lit windows, stars. A faint
 *   quiet arc of the northern lights grows into bright curtains that wave, fold and flicker, then fades back.
 *   True to the look of a real aurora (NASA, NPS «The Colors of the Aurora»): the oxygen green (557,7 nm,
 *   ~100–200 km) is the lowest and brightest part with a sharp lower edge, the oxygen red (630 nm, above ~200 km)
 *   forms the faint upper edge, at the brightest moment the lower edge turns purple-pink (nitrogen). The curtain
 *   is made of rays along the magnetic field lines: nearly vertical, converging slightly towards one point high in
 *   the sky (perspective). The near end of the curtain is big and high, the far end low and small, so its folds
 *   bunch up there; a second, distant curtain glows low over the hills. Snow reflects a little of the green.
 *   All motion is periodic in the scene time, so the end frame equals the start frame.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const gid = `mi-${Math.random().toString(36).slice(2, 8)}`;
// aurora scene: stars (seeded, fixed), hills, spruces, a village
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const starList = Array.from({ length: 48 }, (_, i) => ({
	x: (rnd() * 360).toFixed(1),
	y: (3 + rnd() * rnd() * 150).toFixed(1),
	r: (0.45 + rnd() * rnd() * 0.95).toFixed(2),
	o: (0.45 + rnd() * 0.55).toFixed(2),
	tw: i % 4 === 0,
}));
const RIDGE = 'M0 166 C 26 152 50 154 74 162 S 118 148 148 157 S 196 170 226 161 S 286 146 316 157 S 348 162 360 156 V240 H0 Z';
const FIELD = 'M0 192 C 50 180 104 183 158 189 S 262 176 360 184 V240 H0 Z';
const HILL_L = 'M0 212 C 40 197 98 199 148 212 S 206 232 224 240 H0 Z';
const HILL_R = 'M164 240 C 196 214 248 199 300 197 S 348 199 360 201 V240 Z';
const spruce = (x: number, b: number, h: number) => {
	const w = h * 0.44;
	const p = (dx: number, f: number) => `${(x + dx).toFixed(1)} ${(b - h * f).toFixed(1)}`;
	return (
		`M${p(0, 1)} L${p(w * 0.42, 0.62)} L${p(w * 0.2, 0.62)} L${p(w * 0.72, 0.28)} L${p(w * 0.36, 0.28)} ` +
		`L${p(w, 0.06)} L${p(w * 0.12, 0.06)} L${p(w * 0.12, 0)} L${p(-w * 0.12, 0)} L${p(-w * 0.12, 0.06)} ` +
		`L${p(-w, 0.06)} L${p(-w * 0.36, 0.28)} L${p(-w * 0.72, 0.28)} L${p(-w * 0.2, 0.62)} L${p(-w * 0.42, 0.62)} Z`
	);
};
const trees = [
	[16, 210, 42], [38, 205, 30], [58, 207, 24], [112, 205, 20], [128, 207, 15], [92, 186, 10], [101, 185, 8],
	[208, 216, 22], [350, 204, 20], [190, 186, 9],
].map(([x, b, h]) => spruce(x, b, h));
// houses: left x, base y, width, wall height, windows [x, y] relative to the left bottom corner
const houses = [
	{ x: 234, b: 214, w: 22, h: 13, win: [[7, -8]] },
	{ x: 262, b: 206, w: 30, h: 17, win: [[6, -11], [19, -11]], chimney: true },
	{ x: 300, b: 203, w: 19, h: 12, win: [] as number[][] },
	{ x: 324, b: 204, w: 25, h: 15, win: [[5, -10], [15, -10]] },
	{ x: 150, b: 190, w: 12, h: 7, win: [[4, -5]] },
].map((o) => ({
	...o,
	roof: `M${o.x - 3} ${o.b - o.h} L${o.x + o.w / 2} ${(o.b - o.h - o.w * 0.42).toFixed(1)} L${o.x + o.w + 3} ${o.b - o.h} Z`,
	s: o.w < 15 ? 0.6 : 1,
}));
---

<IntroFrame data-mintro>
	<div class="intro__card" data-scene="fridge">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Кухня, дверца холодильника. Рука подносит к дверце записку с круглым магнитиком. У самой дверцы магнитик выскальзывает из пальцев, сам прыгает к дверце и прижимает записку. Рука уходит, записка висит.">
			<defs>
				<radialGradient id={`${gid}-mag`} cx="0.35" cy="0.3" r="0.8">
					<stop offset="0" stop-color="var(--mi-mag-hi)"></stop>
					<stop offset="1" stop-color="var(--mi-mag)"></stop>
				</radialGradient>
			</defs>
			<rect class="mi-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="mi-floor" x="0" y="214" width="360" height="26"></rect>
			<!-- the fridge -->
			<rect class="mi-fridge" x="88" y="4" width="182" height="216" rx="12"></rect>
			<line class="mi-gap" x1="88" y1="74" x2="270" y2="74"></line>
			<rect class="mi-handle" x="250" y="26" width="8" height="36" rx="4"></rect>
			<rect class="mi-handle" x="250" y="90" width="8" height="64" rx="4"></rect>
			<rect class="mi-foot" x="98" y="220" width="18" height="5" rx="2"></rect>
			<rect class="mi-foot" x="242" y="220" width="18" height="5" rx="2"></rect>
			<!-- a drawing that already hangs on the door -->
			<g transform="rotate(-3 132 126)">
				<rect class="mi-paper" x="104" y="98" width="58" height="48" rx="1.5"></rect>
				<circle class="mi-sun" cx="148" cy="111" r="6"></circle>
				<path class="mi-ink" d="M114 138 V124 L126 114 L138 124 V138 Z M123 138 V130 H129 V138"></path>
				<path class="mi-grass" d="M108 140 Q120 136 132 140 T158 140"></path>
				<circle class="mi-mag2" cx="133" cy="100" r="6.5"></circle>
			</g>
			<circle class="mi-mag3" cx="118" cy="40" r="7"></circle>
			<rect class="mi-paper mi-paper--list" x="186" y="22" width="40" height="40" rx="1.5" transform="rotate(4 206 42)"></rect>
			<path class="mi-ink mi-ink--thin" d="M192 34 h24 M192 42 h20 M192 50 h26" transform="rotate(4 206 42)"></path>
			<circle class="mi-mag3" cx="206" cy="24" r="6"></circle>
			<!-- the new note: its shadow on the door, the note on the magnet -->
			<g data-shadow>
				<rect class="mi-shadow" x="-22" y="-4" width="44" height="46" rx="3"></rect>
			</g>
			<g data-note>
				<g data-swing>
					<rect class="mi-note" x="-22" y="-4" width="44" height="46" rx="1.5"></rect>
					<path class="mi-ink mi-ink--thin" d="M-14 14 h26 M-14 22 h20 M-14 30 h24"></path>
					<circle cx="0" cy="0" r="8.5" fill={`url(#${gid}-mag)`} class="mi-mag"></circle>
				</g>
			</g>
			<text class="mi-click" x="226" y="114" data-click>щёлк!</text>
			<!-- the hand: its fingertips hold the right edge of the note; drawn at the note's position -->
			<g data-hand>
				<path class="mi-sleeve" d="M74 8 L170 -8 V62 L76 44 Z"></path>
				<rect class="mi-skin" x="34" y="0" width="54" height="46" rx="16"></rect>
				<rect class="mi-skin" x="14" y="2" width="40" height="13" rx="6.5"></rect>
				<rect class="mi-skin" x="20" y="14" width="34" height="12" rx="6"></rect>
				<rect class="mi-skin" x="26" y="26" width="30" height="11" rx="5.5"></rect>
				<rect class="mi-skin" x="22" y="34" width="26" height="11" rx="5.5" transform="rotate(-18 36 40)"></rect>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Магнитик сам прыгает к дверце холодильника и держит записку <More term="прямо сквозь бумагу">Магнит действует на железо и сталь на расстоянии: сквозь бумагу, картон, стекло, даже сквозь ладонь. Дверца холодильника сделана из тонкой стали, и магнит её притягивает. Чем ближе магнит к стали, тем сильнее притяжение, поэтому последний миллиметр он пролетает сам. К деревянной двери или к алюминиевой кастрюле магнитик не прилипнет. Подробнее — в разделе <a href="#постоянные-магниты">«Постоянные магниты»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="aurora">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимняя ночь на севере: заснеженные холмы, ели, маленький посёлок со светящимися окнами, звёзды. Над холмами разгорается полярное сияние: зелёные занавеси с красным верхним краем колышутся, становятся всё ярче, а потом гаснут.">
			<defs>
				<linearGradient id={`${gid}-sky`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="mi-sky0"></stop>
					<stop offset="1" class="mi-sky1"></stop>
				</linearGradient>
				<!-- one ray of the curtain, from its lower edge (bottom) up -->
				<linearGradient id={`${gid}-ray`} x1="0" y1="1" x2="0" y2="0" data-ray>
					<stop offset="0" class="mi-hem" data-hem></stop>
					<stop offset="0.05" class="mi-g" style="stop-opacity: 1"></stop>
					<stop offset="0.22" class="mi-g" style="stop-opacity: 0.8"></stop>
					<stop offset="0.46" class="mi-g" style="stop-opacity: 0.28"></stop>
					<stop offset="0.64" class="mi-r" data-red></stop>
					<stop offset="0.82" class="mi-r" data-red2></stop>
					<stop offset="1" class="mi-r" style="stop-opacity: 0"></stop>
				</linearGradient>
				<radialGradient id={`${gid}-glow`} cx="0.5" cy="0.5" r="0.5">
					<stop offset="0" class="mi-g" style="stop-opacity: 0.3"></stop>
					<stop offset="1" class="mi-g" style="stop-opacity: 0"></stop>
				</radialGradient>
				<radialGradient id={`${gid}-win`} cx="0.5" cy="0.5" r="0.5">
					<stop offset="0" class="mi-w" style="stop-opacity: 0.5"></stop>
					<stop offset="1" class="mi-w" style="stop-opacity: 0"></stop>
				</radialGradient>
				<filter id={`${gid}-soft`} filterUnits="userSpaceOnUse" x="-20" y="-20" width="400" height="280">
					<feGaussianBlur in="SourceGraphic" stdDeviation="7" result="wide"></feGaussianBlur>
					<feGaussianBlur in="SourceGraphic" stdDeviation="1.4" result="fine"></feGaussianBlur>
					<feMerge>
						<feMergeNode in="wide"></feMergeNode>
						<feMergeNode in="fine"></feMergeNode>
					</feMerge>
				</filter>
				<filter id={`${gid}-haze`} x="-1" y="-1" width="3" height="3">
					<feGaussianBlur stdDeviation="1.6"></feGaussianBlur>
				</filter>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${gid}-sky)`}></rect>
			<g class="mi-stars">
				{starList.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} data-tw={s.tw ? s.o : undefined} />)}
			</g>
			<ellipse cx="150" cy="122" rx="230" ry="78" fill={`url(#${gid}-glow)`} data-skyglow></ellipse>
			<!-- the curtains: rays are added by the script -->
			<g filter={`url(#${gid}-soft)`}>
				<g data-far></g>
				<g data-near></g>
			</g>
			<!-- the land -->
			<path class="mi-ridge" d={RIDGE}></path>
			<path class="mi-snow1" d={FIELD}></path>
			<path class="mi-snow2" d={HILL_L}></path>
			<path class="mi-snow2" d={HILL_R}></path>
			<g class="mi-snowglow" data-snowglow>
				<path d={RIDGE}></path>
				<path d={FIELD}></path>
				<path d={HILL_L}></path>
				<path d={HILL_R}></path>
			</g>
			{trees.map((d) => <path class="mi-tree" d={d} />)}
			<!-- the village -->
			{houses.map((o) => (
				<g>
					{o.win.map(([wx, wy]) => <circle cx={o.x + wx + 2 * o.s} cy={o.b + wy + 2 * o.s} r={12 * o.s} fill={`url(#${gid}-win)`} />)}
					{o.chimney && <rect class="mi-hwall" x={o.x + o.w - 9} y={o.b - o.h - 14} width="4" height="10" />}
					<rect class="mi-hwall" x={o.x} y={o.b - o.h} width={o.w} height={o.h} />
					<path class="mi-roof" d={o.roof} />
					{o.win.map(([wx, wy]) => <rect class="mi-window" x={o.x + wx} y={o.b + wy} width={4 * o.s} height={4 * o.s} />)}
				</g>
			))}
			<g class="mi-smoke" data-smoke filter={`url(#${gid}-haze)`}>
				<circle cx="285" cy="174" r="2"></circle>
				<circle cx="285" cy="174" r="2"></circle>
				<circle cx="285" cy="174" r="2"></circle>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Ночью на севере в небе разгорается полярное сияние: колышутся зелёные занавеси с красным верхним краем. Это <More term="светится сам воздух высоко над Землёй">От Солнца к Земле прилетают быстрые заряженные частицы. Магнитное поле Земли направляет их к полярным областям, и на высоте примерно 100–300 км частицы налетают на газы воздуха и заставляют их светиться. Кислород светится зелёным (ниже) и красным (выше), азот — синим и фиолетовым. Частицы летят вдоль магнитного поля, поэтому сияние состоит из почти вертикальных лучей. Подробнее — в разделе <a href="#магнитные-бури-и-полярные-сияния">«Магнитные бури и полярные сияния»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-mintro] {
		--mi-wall: color-mix(in srgb, var(--ig-v) 10%, var(--sl-color-gray-5));
		--mi-fridge: color-mix(in srgb, var(--sl-color-gray-2) 34%, var(--sl-color-gray-5));
		--mi-paper: var(--sl-color-gray-2);
		--mi-note: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-2));
		--mi-ink: var(--sl-color-gray-5);
		--mi-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--mi-mag: color-mix(in oklab, var(--sl-color-green) 70%, var(--sl-color-gray-5));
		--mi-mag-hi: color-mix(in oklab, var(--sl-color-green) 70%, var(--sl-color-white));
		--mi-shadow: var(--sl-color-black);
	}
	:root[data-theme='light'] [data-mintro] {
		--mi-wall: color-mix(in srgb, var(--ig-v) 8%, var(--sl-color-gray-6));
		--mi-fridge: var(--sl-color-gray-7, #fff);
		--mi-paper: var(--sl-color-gray-7, #fff);
		--mi-note: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-7, #fff));
		--mi-ink: var(--sl-color-gray-4);
		--mi-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--mi-mag: color-mix(in oklab, var(--sl-color-green) 85%, var(--sl-color-gray-3));
		--mi-mag-hi: color-mix(in oklab, var(--sl-color-green) 45%, var(--sl-color-gray-7, #fff));
		--mi-shadow: var(--sl-color-gray-3);
	}
	.mi-wall {
		fill: var(--mi-wall);
	}
	.mi-floor {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.mi-fridge {
		fill: var(--mi-fridge);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.mi-gap {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.mi-handle {
		fill: var(--sl-color-gray-3);
	}
	.mi-foot {
		fill: var(--sl-color-gray-4);
	}
	.mi-paper {
		fill: var(--mi-paper);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.mi-sun {
		fill: color-mix(in oklab, var(--ig-v) 80%, transparent);
	}
	.mi-ink {
		fill: none;
		stroke: var(--mi-ink);
		stroke-width: 1.6;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.mi-ink--thin {
		stroke-width: 1.3;
		opacity: 0.8;
	}
	.mi-grass {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-green) 70%, transparent);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.mi-mag2 {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.mi-mag3 {
		fill: color-mix(in oklab, var(--ig-vx) 65%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.mi-note {
		fill: var(--mi-note);
		stroke: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-3));
		stroke-width: 0.8;
	}
	.mi-mag {
		stroke: color-mix(in oklab, var(--sl-color-green) 50%, var(--sl-color-gray-3));
		stroke-width: 1;
	}
	.mi-shadow {
		fill: var(--mi-shadow);
		opacity: 0.3;
	}
	.mi-click {
		font-size: 15px;
		font-weight: 700;
		fill: var(--ig-v);
		opacity: 0;
	}
	.mi-skin {
		fill: var(--mi-skin);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .mi-skin {
		stroke: var(--sl-color-gray-3);
	}
	.mi-sleeve {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	/* aurora: a night inside the frame in both themes (the light theme's grays are dark from gray-1 to gray-3) */
	[data-mintro] [data-scene='aurora'] {
		--mn-sky0: color-mix(in srgb, var(--ig-vx) 7%, var(--sl-color-black));
		--mn-sky1: color-mix(in srgb, var(--ig-vx) 16%, var(--sl-color-gray-6));
		--mn-ridge: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-5));
		--mn-snow1: color-mix(in srgb, var(--ig-vx) 12%, color-mix(in srgb, var(--sl-color-gray-4) 35%, var(--sl-color-gray-5)));
		--mn-snow2: color-mix(in srgb, var(--ig-vx) 10%, color-mix(in srgb, var(--sl-color-gray-4) 72%, var(--sl-color-gray-5)));
		--mn-tree: color-mix(in srgb, var(--sl-color-black) 70%, var(--sl-color-gray-6));
		--mn-wall: color-mix(in srgb, var(--ig-v) 12%, var(--sl-color-gray-6));
		--mn-roof: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-3));
		--mn-star: var(--sl-color-white);
		--mn-smoke: var(--sl-color-gray-3);
		--mn-win: var(--ig-v);
		--mn-green: color-mix(in oklab, color-mix(in oklab, var(--sl-color-green) 82%, var(--ig-vx)) 82%, var(--sl-color-green-high));
		--mn-red: color-mix(in oklab, var(--sl-color-red) 72%, var(--sl-color-purple));
		--mn-hem: color-mix(in oklab, var(--sl-color-purple) 55%, var(--sl-color-red));
	}
	:root[data-theme='light'] [data-mintro] [data-scene='aurora'] {
		--mn-sky0: color-mix(in srgb, var(--ig-vx) 7%, var(--sl-color-white));
		--mn-sky1: color-mix(in srgb, var(--ig-vx) 16%, var(--sl-color-gray-1));
		--mn-ridge: color-mix(in srgb, var(--ig-vx) 14%, var(--sl-color-gray-2));
		--mn-snow1: color-mix(in srgb, var(--ig-vx) 12%, color-mix(in srgb, var(--sl-color-gray-3) 35%, var(--sl-color-gray-2)));
		--mn-snow2: color-mix(in srgb, var(--ig-vx) 10%, color-mix(in srgb, var(--sl-color-gray-3) 72%, var(--sl-color-gray-2)));
		--mn-tree: color-mix(in srgb, var(--sl-color-white) 70%, var(--sl-color-gray-1));
		--mn-wall: color-mix(in srgb, var(--ig-v) 12%, var(--sl-color-gray-1));
		--mn-roof: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-4));
		--mn-star: var(--sl-color-black);
		--mn-smoke: var(--sl-color-gray-4);
		--mn-win: color-mix(in oklab, var(--sl-color-orange) 70%, var(--sl-color-orange-low));
		--mn-green: color-mix(in oklab, color-mix(in oklab, var(--sl-color-green) 82%, var(--ig-vx)) 55%, var(--sl-color-green-low));
		--mn-red: color-mix(in oklab, var(--sl-color-red) 72%, var(--sl-color-purple));
		--mn-hem: color-mix(in oklab, var(--sl-color-purple) 55%, var(--sl-color-red));
	}
	.mi-sky0 {
		stop-color: var(--mn-sky0);
	}
	.mi-sky1 {
		stop-color: var(--mn-sky1);
	}
	.mi-g {
		stop-color: var(--mn-green);
	}
	.mi-r {
		stop-color: var(--mn-red);
	}
	.mi-hem {
		stop-color: var(--mn-hem);
		stop-opacity: 0;
	}
	.mi-w {
		stop-color: var(--mn-win);
	}
	.mi-stars circle {
		fill: var(--mn-star);
	}
	.mi-ridge {
		fill: var(--mn-ridge);
	}
	.mi-snow1 {
		fill: var(--mn-snow1);
	}
	.mi-snow2 {
		fill: var(--mn-snow2);
	}
	.mi-snowglow {
		fill: var(--mn-green);
		opacity: 0;
	}
	.mi-tree {
		fill: var(--mn-tree);
	}
	.mi-hwall {
		fill: var(--mn-wall);
	}
	.mi-roof {
		fill: var(--mn-roof);
	}
	.mi-window {
		fill: var(--mn-win);
	}
	.mi-smoke circle {
		fill: var(--mn-smoke);
		opacity: 0;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-mintro]')) {
		// Fridge: the hand brings the note (→ 0,36), the magnet snaps at 0,36, the hand leaves (0,42 → 0,62),
		// the note swings and rests; 5 s.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="fridge"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const note = $<SVGGElement>('[data-note]');
			const swing = $<SVGGElement>('[data-swing]');
			const shadow = $<SVGGElement>('[data-shadow]');
			const hand = $<SVGGElement>('[data-hand]');
			const click = $<SVGTextElement>('[data-click]');
			const X1 = 198; // the magnet on the door
			const Y1 = 132;
			const SNAP = 0.36;
			scene(card, 5, (x) => {
				// depth d: 1 far in front of the door, 0 on the door. The hand carries the note to d = 0,12, then the
				// magnet jumps the last bit by itself (a few hundredths of a second) with a tiny bounce.
				const carry = smooth(0.04, SNAP, x);
				let d = lerp(1, 0.12, carry);
				if (x >= SNAP) {
					const p = clamp((x - SNAP) / 0.025);
					d = 0.12 * (1 - p) - 0.015 * Math.sin(Math.PI * clamp((x - SNAP - 0.025) / 0.03));
				}
				const s = 1 + 0.32 * d; // closer to us: larger
				const nx = X1 + 112 * (1 - carry) + 8 * d;
				const ny = Y1 + 26 * (1 - carry) + 6 * d;
				note.setAttribute('transform', `translate(${f1(nx)} ${f1(ny)}) scale(${f2(s)})`);
				// the shadow on the door: far behind and soft while the note is in front of the door
				shadow.setAttribute('transform', `translate(${f1(nx + 2 + 30 * d)} ${f1(ny + 3 + 22 * d)}) scale(${f2(s)})`);
				shadow.style.opacity = f2(0.9 - 0.6 * d);
				// after the snap the note swings on the magnet with a damped swing
				const ts = (x - SNAP) * 5; // seconds after the snap
				const ang = x < SNAP ? -4 * carry : 7 * Math.exp(-ts * 1.6) * Math.cos(ts * 7);
				swing.setAttribute('transform', `rotate(${f1(ang)})`);
				// the hand keeps the right edge of the note until the snap, then goes away to the right and to us
				const away = smooth(SNAP + 0.04, 0.62, x);
				const hs = s + 0.25 * away;
				const hx = (x < SNAP ? nx : lerp(X1, X1 + 190, away)) + 2 * hs;
				const hy = (x < SNAP ? ny : lerp(Y1, Y1 + 36, away)) - 4 * hs;
				hand.setAttribute('transform', `translate(${f1(hx)} ${f1(hy)}) scale(${f2(hs)})`);
				hand.style.opacity = f2(1 - smooth(0.55, 0.62, x));
				click.style.opacity = f2(smooth(SNAP, SNAP + 0.01, x) * (1 - smooth(0.5, 0.58, x)));
			});
		}

		// Aurora: a faint quiet arc (start = end) brightens into waving curtains and fades back; 11 s.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="aurora"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const NS = 'http://www.w3.org/2000/svg';
			const fill = `url(#${$<SVGLinearGradientElement>('[data-ray]').id})`;
			const hem = $<SVGStopElement>('[data-hem]');
			const red = $<SVGStopElement>('[data-red]');
			const red2 = $<SVGStopElement>('[data-red2]');
			const skyglow = $<SVGEllipseElement>('[data-skyglow]');
			const snowglow = $<SVGGElement>('[data-snowglow]');
			const smoke = [...card.querySelectorAll<SVGCircleElement>('[data-smoke] circle')];
			const twinkle = [...card.querySelectorAll<SVGCircleElement>('[data-tw]')].map((el, i) => ({
				el,
				o: Number(el.dataset.tw),
				w: 1.3 + (i % 5) * 0.45,
				ph: i * 2.1,
			}));
			let seed = 11;
			const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
			// each ray flickers with a whole number of cycles per run, so the loop has no seam
			const rays = (g: SVGGElement, n: number) =>
				Array.from({ length: n }, (_, i) => {
					const el = document.createElementNS(NS, 'rect');
					el.setAttribute('fill', fill);
					g.appendChild(el);
					return { el, u: clamp((i + 0.7 * (rnd() - 0.5)) / (n - 1)), f: 3 + Math.floor(rnd() * 6), ph: rnd() * 6.283, g: 2 + Math.floor(rnd() * 4), ps: rnd() * 6.283 };
				});
			const near = rays($<SVGGElement>('[data-near]'), 160);
			const far = rays($<SVGGElement>('[data-far]'), 80);
			const TAU = 2 * Math.PI;
			const S0 = 1 - Math.exp(-1.6);
			// a ray at (x, base): rect from the base up, leaning towards a point high above the sky (the rays are
			// parallel to the magnetic field; in perspective they converge)
			const put = (el: SVGRectElement, x: number, base: number, h: number, w: number, op: number) => {
				const lean = (Math.atan((150 - x) / (base + 900)) * 180) / Math.PI;
				el.setAttribute('transform', `translate(${f1(x)} ${f1(base)}) rotate(${f1(lean)})`);
				el.setAttribute('x', f2(-w / 2));
				el.setAttribute('y', f1(-h));
				el.setAttribute('width', f2(w));
				el.setAttribute('height', f1(h));
				el.setAttribute('opacity', f2(op));
			};
			scene(card, 11, (x) => {
				const ph = TAU * x;
				const act = smooth(0.06, 0.42, x) * (1 - smooth(0.64, 0.96, x));
				const peak = smooth(0.34, 0.48, x) * (1 - smooth(0.58, 0.74, x));
				const B = 0.16 + 0.84 * act;
				hem.style.stopOpacity = f2(0.8 * peak);
				red.style.stopOpacity = f2(0.3 + 0.22 * act);
				red2.style.stopOpacity = f2(0.16 + 0.16 * act);
				skyglow.setAttribute('opacity', f2(0.08 + 0.72 * act));
				snowglow.style.opacity = f2(0.03 + 0.13 * act);
				// the near curtain: big and high at the left, receding to the right; folds travel along it
				const drift = 10 * Math.sin(ph);
				const fold = 8 + 22 * act;
				for (const r of near) {
					const u = r.u;
					const p = 1 - 0.45 * u;
					const X =
						-40 +
						(420 * (1 - Math.exp(-1.6 * u))) / S0 +
						drift * p +
						fold * p * Math.sin(TAU * 3.2 * u - ph + 0.4) +
						0.35 * fold * p * Math.sin(TAU * 7 * u + 2 * ph);
					// where the curtain folds away from us its lower edge sinks and the rays get shorter
					const deep = (fold / 30) * Math.cos(TAU * 3.2 * u - ph + 0.4);
					const base = 110 + 40 * u + 9 * p * deep + 3 * p * Math.sin(TAU * 2.3 * u - ph);
					const h = 90 * (1 - 0.5 * u) * (1 - 0.12 * deep) * (0.55 + 0.45 * act) * (0.82 + 0.18 * Math.sin(r.g * ph + r.ps));
					const flick = 0.5 + 0.5 * Math.sin(r.f * ph + r.ph);
					const pulse = 0.5 + 0.5 * Math.sin(TAU * 4 * u - 2 * ph);
					const env = smooth(0, 0.06, u) * (1 - smooth(0.9, 1, u));
					const op = B * env * (0.35 + 0.35 * flick * (0.4 + 0.6 * act) + 0.3 * pulse * act);
					put(r.el, X, base, h, 5.5 * (1 - 0.55 * u), op);
				}
				// the far curtain: low over the hills, fainter, a little behind in time
				const actF = smooth(0.18, 0.5, x) * (1 - smooth(0.7, 0.98, x));
				for (const r of far) {
					const u = r.u;
					const X = -10 + 380 * u + 6 * Math.sin(TAU * 2.5 * u + ph);
					const base = 172 + 3 * Math.sin(TAU * 1.7 * u - ph);
					const h = 34 * (0.6 + 0.4 * actF) * (0.8 + 0.2 * Math.sin(r.g * ph + r.ps));
					const flick = 0.5 + 0.5 * Math.sin(r.f * ph + r.ph);
					const patch = 0.5 + 0.5 * Math.sin(TAU * 1.4 * u + ph + 1);
					put(r.el, X, base, h, 2.6, (0.06 + 0.5 * actF) * (0.25 + 0.75 * patch) * (0.5 + 0.5 * flick));
				}
				// chimney smoke rises twice per run
				smoke.forEach((c, k) => {
					const q = (2 * x + k / 3) % 1;
					c.setAttribute('cx', f1(285 + 7 * q + 1.5 * Math.sin(TAU * q)));
					c.setAttribute('cy', f1(174 - 26 * q));
					c.setAttribute('r', f1(2.5 + 6 * q));
					c.style.opacity = f2(0.22 * Math.sin(Math.PI * q));
				});
				// a few stars twinkle (wall-clock time: they keep twinkling during the pause between runs)
				const now = performance.now() / 1000;
				for (const s of twinkle) s.el.setAttribute('opacity', f2(s.o * (0.65 + 0.35 * Math.sin(s.w * now + s.ph))));
			});
		}
	}
</script>
