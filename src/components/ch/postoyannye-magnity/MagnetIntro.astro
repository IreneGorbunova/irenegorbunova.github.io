<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const f1 = (v: number) => v.toFixed(1);
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-mintro]')) {
		// Fridge: the hand brings the note (→ 0,36), the magnet snaps at 0,36, the hand leaves (0,42 → 0,62),
		// the note swings and rests; 5 s.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="fridge"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const note = $<SVGGElement>('[data-note]');
			const swing = $<SVGGElement>('[data-swing]');
			const shadow = $<SVGGElement>('[data-shadow]');
			const hand = $<SVGGElement>('[data-hand]');
			const click = $<SVGTextElement>('[data-click]');
			const X1 = 198; // the magnet on the door
			const Y1 = 132;
			const SNAP = 0.36;
			scene(card, 5, (x) => {
				// depth d: 1 far in front of the door, 0 on the door. The hand carries the note to d = 0,12, then the
				// magnet jumps the last bit by itself (a few hundredths of a second) with a tiny bounce.
				const carry = smooth(0.04, SNAP, x);
				let d = lerp(1, 0.12, carry);
				if (x >= SNAP) {
					const p = clamp((x - SNAP) / 0.025);
					d = 0.12 * (1 - p) - 0.015 * Math.sin(Math.PI * clamp((x - SNAP - 0.025) / 0.03));
				}
				const s = 1 + 0.32 * d; // closer to us: larger
				const nx = X1 + 112 * (1 - carry) + 8 * d;
				const ny = Y1 + 26 * (1 - carry) + 6 * d;
				note.setAttribute('transform', `translate(${f1(nx)} ${f1(ny)}) scale(${f2(s)})`);
				// the shadow on the door: far behind and soft while the note is in front of the door
				shadow.setAttribute('transform', `translate(${f1(nx + 2 + 30 * d)} ${f1(ny + 3 + 22 * d)}) scale(${f2(s)})`);
				shadow.style.opacity = f2(0.9 - 0.6 * d);
				// after the snap the note swings on the magnet with a damped swing
				const ts = (x - SNAP) * 5; // seconds after the snap
				const ang = x < SNAP ? -4 * carry : 7 * Math.exp(-ts * 1.6) * Math.cos(ts * 7);
				swing.setAttribute('transform', `rotate(${f1(ang)})`);
				// the hand keeps the right edge of the note until the snap, then goes away to the right and to us
				const away = smooth(SNAP + 0.04, 0.62, x);
				const hs = s + 0.25 * away;
				const hx = (x < SNAP ? nx : lerp(X1, X1 + 190, away)) + 2 * hs;
				const hy = (x < SNAP ? ny : lerp(Y1, Y1 + 36, away)) - 4 * hs;
				hand.setAttribute('transform', `translate(${f1(hx)} ${f1(hy)}) scale(${f2(hs)})`);
				hand.style.opacity = f2(1 - smooth(0.55, 0.62, x));
				click.style.opacity = f2(smooth(SNAP, SNAP + 0.01, x) * (1 - smooth(0.5, 0.58, x)));
			});
		}

		// Search: 60 px/m, deck top 112, water surface 128, flat bottom 224; a 13 s run. The magnet goes down
		// 0,4–2,3 s, the man turns 2,5–3,0 s, walks to the bank 3,1–8,3 s, turns back 8,5–9,0 s and pulls the rope up
		// hand over hand 9,2–12,4 s (five half-strokes).
		{
			const card = root.querySelector<HTMLElement>('[data-scene="search"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const $$ = <T extends Element>(s: string) => [...card.querySelectorAll<T>(s)];
			const man = $<SVGGElement>('[data-man]');
			const leg1 = $<SVGGElement>('[data-leg1]');
			const leg2 = $<SVGGElement>('[data-leg2]');
			const arm1 = [$<SVGPathElement>('[data-arm1]'), $<SVGPathElement>('[data-arm1o]')];
			const arm2 = [$<SVGPathElement>('[data-arm2]'), $<SVGPathElement>('[data-arm2o]')];
			const hand1 = $<SVGCircleElement>('[data-hand1]');
			const hand2 = $<SVGCircleElement>('[data-hand2]');
			const magnet = $<SVGGElement>('[data-magnet]');
			const rope = $<SVGPathElement>('[data-rope]');
			const strand = $<SVGPathElement>('[data-strand]');
			const coil = $$<SVGEllipseElement>('[data-coil] ellipse');
			const lensview = $<SVGUseElement>('[data-lensview]');
			const lensrope = $<SVGPathElement>('[data-lensrope]');
			const pointer = $<SVGLineElement>('[data-pointer]');
			const ripples = $$<SVGPathElement>('[data-ripples] path');
			const drops = $$<SVGCircleElement>('[data-drops] circle');
			const weeds = $$<SVGPathElement>('[data-weeds] path').map((el) => ({
				el,
				x: Number(el.dataset.x),
				y: Number(el.dataset.y),
				h: Number(el.dataset.h),
			}));
			type P2 = [number, number];
			const mix = (a: P2, b: P2, k: number): P2 => [lerp(a[0], b[0], k), lerp(a[1], b[1], k)];
			const RUN = 13;
			const DECK = 112;
			const SURF = 128;
			const CM = 0.6; // px per cm
			const BEDM = 224 - 5.8 * CM; // the eyebolt top of the magnet lying on the bottom
			const G = 9.8 * 60; // px/s²
			const GW = G * (1 - 1 / 7.5); // in water: steel minus the buoyancy
			const PX0 = 306;
			const PX1 = 150;
			const GAIT = 84; // px per two steps
			const W0 = 3.1;
			const W1 = 8.3;
			const TP0 = 9.2; // the pull: Q half-strokes of HS s, hands between YLOW and YHIGH
			const HS = 0.64;
			const Q = 5;
			const YLOW = 60;
			const YHIGH = 30;
			const LWALK = 172; // rope out while walking
			const ROPE = 330; // the whole rope
			const SH: P2 = [1, 29]; // the shoulder
			const LENS: P2 = [56, 54];
			const LR = 44;
			const K = 4;
			// a walk from t0 to t1 with speed-up and slow-down of r s: [share of the way, speed / top speed]
			const ramp = (t: number, t0: number, t1: number, r: number): P2 => {
				const T = t1 - t0;
				const v = 1 / (T - r);
				const u = t - t0;
				if (u <= 0) return [0, 0];
				if (u >= T) return [1, 0];
				if (u < r) return [(0.5 * v * u * u) / r, u / r];
				if (u < T - r) return [v * (u - r / 2), 1];
				return [1 - (0.5 * v * (T - u) * (T - u)) / r, (T - u) / r];
			};
			// the man at time t: position, facing (sx), both hands in his own frame, the pulling hand (world y)
			const pose = (t: number) => {
				const [s, mv] = ramp(t, W0, W1, 0.7);
				const x = PX0 + (PX1 - PX0) * s;
				const ph = (2 * Math.PI * (PX0 - x)) / GAIT;
				const sx = Math.cos(Math.PI * (smooth(2.5, 3, t) - smooth(8.5, 9, t)));
				const bob = -1.2 * Math.cos(ph) ** 2 * mv;
				const pay = smooth(0.35, 0.6, t) * (1 - smooth(2.1, 2.35, t));
				let h1: P2 = [20, 52 + 2.5 * Math.sin((2 * Math.PI * 3 * (t - 0.4)) / 1.9) * pay];
				h1 = mix(h1, [-10 + 1.5 * Math.sin(ph) * mv, 60], smooth(2.45, 3, t));
				const rest: P2 = [3 - 4 * Math.sin(ph) * mv, 64];
				// hand over hand: the near hand pulls on even half-strokes, the far one on odd ones
				const q = Math.max(0, (t - TP0) / HS);
				const k = Math.min(Q - 1, Math.floor(q));
				const e = q >= Q ? 1 : smooth(0, 1, q - k);
				const up = YLOW - (YLOW - YHIGH) * e;
				const down = YHIGH + (YLOW - YHIGH) * e;
				h1 = mix(h1, [16, k % 2 === 0 ? up : down], smooth(8.5, 9.1, t));
				let h2 = rest;
				if (t > TP0) h2 = k === 0 ? mix(rest, [16, YLOW], e) : [16, k % 2 === 1 ? up : down];
				h2 = mix(h2, [15, YHIGH + 5], smooth(TP0 + Q * HS, TP0 + Q * HS + 0.5, t));
				return { x, sx, bob, leg: 0.36 * Math.sin(ph) * mv, h1, h2, up, k };
			};
			const world = (p: ReturnType<typeof pose>, h: P2): P2 => [p.x + p.sx * h[0], h[1] + p.bob];
			// the catch: rest on the bottom (x, y, angle; foreshortened), where it sticks to the magnet on the bottom
			// and hanging (magnet frame, cm), its right edge and the gap from which it jumps (px)
			type Obj = { el: SVGGElement; rest: number[]; bed: number[]; hang: number[]; edge: number; gap: number; dur: number; ts: number };
			const objs: Obj[] = [
				{ el: $<SVGGElement>('[data-shoe]'), rest: [232.5, 222, 90], bed: [-4.2, 3.6, 90], hang: [1, 5.8, 0], edge: 232.5, gap: 3, dur: 0.12, ts: -1 },
				{ el: $<SVGGElement>('[data-nail1]'), rest: [252, 223.4, 95], bed: [-4.2, 3.4, 80], hang: [-4.2, 3.4, 55], edge: 252.6, gap: 1.8, dur: 0.1, ts: -1 },
				{ el: $<SVGGElement>('[data-nail2]'), rest: [248.5, 223.6, -80], bed: [-4.2, 4.9, 100], hang: [-4.2, 4.9, 22], edge: 253.3, gap: 1.8, dur: 0.1, ts: -1 },
			];
			// the magnet: a point on the rope (the eyebolt), steps of DT
			const DT = 1 / 600;
			let st = 0;
			let m: P2 = [0, 0];
			let v: P2 = [0, 0];
			let L = 22;
			let ell = 0;
			let kp = -1;
			let tIn = -1;
			let tOut = -1;
			let xIn = 0;
			let xOut = 0;
			const rel: (P2 | null)[] = drops.map(() => null);
			const anchor = (t: number): P2 => {
				const p = pose(t);
				return t < TP0 ? world(p, p.h1) : [p.x + p.sx * 16, p.up + p.bob];
			};
			const reset = () => {
				st = 0;
				const a = anchor(0);
				m = [a[0], a[1] + 22];
				v = [0, 0];
				L = 22;
				kp = -1;
				tIn = tOut = -1;
				rel.fill(null);
				for (const o of objs) o.ts = -1;
			};
			const step = (t: number) => {
				const A = anchor(t);
				const dA = Math.hypot(m[0] - A[0], m[1] - A[1]);
				// he lets the rope slide through his hand as the magnet sinks and as he walks off: it stays taut
				if (t < 2.4) L = Math.min(22 + 153 * smooth(0.4, 2.3, t), dA + 0.3);
				else if (t < 8.55) L = Math.min(LWALK, dA + 0.3);
				else if (t < TP0) L = LWALK + (dA + 1 - LWALK) * smooth(8.6, 9.15, t);
				else {
					const k = pose(t).k;
					if (k !== kp) {
						kp = k;
						ell = Math.hypot(m[0] - A[0], m[1] - A[1]); // the next hand takes the rope where it is
					}
					L = ell;
				}
				const wet = m[1] > SURF;
				const c = wet ? 4.5 : 0.3; // linear drag, 1/s
				const f = Math.exp(-c * DT);
				v = [v[0] * f, (v[1] + (wet ? GW : G) * DT) * f];
				if (m[1] >= BEDM - 0.01) v[0] = Math.sign(v[0]) * Math.max(0, Math.abs(v[0]) - 0.4 * GW * DT);
				let n: P2 = [m[0] + v[0] * DT, m[1] + v[1] * DT];
				const d = Math.hypot(n[0] - A[0], n[1] - A[1]);
				if (d > L) n = [A[0] + ((n[0] - A[0]) * L) / d, A[1] + ((n[1] - A[1]) * L) / d];
				if (n[1] > BEDM) {
					n[1] = BEDM;
					const dx = Math.sqrt(Math.max(0, L * L - (BEDM - A[1]) ** 2));
					if (Math.abs(n[0] - A[0]) > dx) n[0] = A[0] + Math.sign(n[0] - A[0]) * dx;
				}
				v = [(n[0] - m[0]) / DT, (n[1] - m[1]) / DT];
				if (m[1] <= SURF && n[1] > SURF && tIn < 0) [tIn, xIn] = [t, n[0]];
				if (m[1] > SURF && n[1] <= SURF && t > TP0 && tOut < 0) [tOut, xOut] = [t, n[0]];
				m = n;
				// iron near the magnet's leading edge jumps to it
				if (t > W0 && t < TP0 && m[1] > BEDM - 1)
					for (const o of objs) if (o.ts < 0 && m[0] - 4.2 * CM - o.edge <= o.gap) o.ts = t;
				// drops fall off the catch after it leaves the water
				rel.forEach((r, i) => {
					if (!r && tOut > 0 && t >= tOut + 0.2 + 0.35 * i) rel[i] = [m[0] - 1 + i, m[1] + 9 + i];
				});
			};
			const run = (t: number) => {
				if (t < st - 1e-9 || st === 0) reset();
				while (st + DT <= t + 1e-9) {
					st += DT;
					step(st);
				}
			};
			// a two-part arm from the shoulder to the hand, the elbow bent down
			const arm = (paths: SVGPathElement[], dot: SVGCircleElement, [hx, hy]: P2) => {
				const dx = hx - SH[0];
				const dy = hy - SH[1];
				const d = Math.min(Math.hypot(dx, dy), 35.9);
				let nx = -dy / d;
				let ny = dx / d;
				if (ny < 0 || (Math.abs(ny) < 1e-6 && nx > 0)) {
					nx = -nx;
					ny = -ny;
				}
				const k = Math.sqrt(Math.max(0, 18 * 18 - (d / 2) ** 2));
				const d1 = `M ${SH[0]} ${SH[1]} L ${f1(SH[0] + dx / 2 + nx * k)} ${f1(SH[1] + dy / 2 + ny * k)} L ${f1(hx)} ${f1(hy)}`;
				for (const el of paths) el.setAttribute('d', d1);
				dot.setAttribute('cx', f1(hx));
				dot.setAttribute('cy', f1(hy));
			};
			// a rope from a to b of length len: straight when taut, a parabola when slack; bow: sideways push of the water
			const curve = (a: P2, b: P2, len: number, bow: number): P2 => {
				const dx = b[0] - a[0];
				const dy = b[1] - a[1];
				const d = Math.hypot(dx, dy) || 1;
				const h = Math.min(30, Math.sqrt((3 * d * Math.max(0, len - d)) / 8));
				let nx = -dy / d;
				let ny = dx / d;
				if (ny < 0 || (Math.abs(ny) < 0.05 && nx < 0)) {
					nx = -nx;
					ny = -ny;
				}
				return [(a[0] + b[0]) / 2 + 2 * h * nx + bow, (a[1] + b[1]) / 2 + 2 * h * ny];
			};
			const p2 = ([x, y]: P2) => `${f1(x)} ${f1(y)}`;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				run(t);
				const p = pose(t);
				man.setAttribute('transform', `translate(${f1(p.x)} ${f1(p.bob)}) scale(${f2(p.sx)} 1)`);
				const deg = (p.leg * 180) / Math.PI;
				leg1.setAttribute('transform', `rotate(${f1(deg)} 0 57)`);
				leg2.setAttribute('transform', `rotate(${f1(-deg)} 0 57)`);
				arm(arm1, hand1, p.h1);
				arm(arm2, hand2, p.h2);
				// the magnet hangs along the rope once off the bottom
				const H1 = world(p, p.h1);
				const H2 = world(p, p.h2);
				const pulling = t >= TP0;
				const P: P2 = pulling ? [p.x + p.sx * 16, p.up + p.bob] : H1;
				const top: P2 = pulling ? [P[0], Math.min(H1[1], H2[1], P[1])] : H1;
				const lift = clamp((BEDM - m[1]) / 6);
				const tilt = (Math.atan2(P[0] - m[0], m[1] - P[1]) * 180) / Math.PI;
				const phi = Math.max(-60, Math.min(60, tilt)) * lift;
				magnet.setAttribute('transform', `translate(${f2(m[0])} ${f2(m[1])}) rotate(${f1(phi)}) scale(${CM})`);
				const rad = (phi * Math.PI) / 180;
				const toWorld = (lx: number, ly: number): P2 => [
					m[0] + CM * (lx * Math.cos(rad) - ly * Math.sin(rad)),
					m[1] + CM * (lx * Math.sin(rad) + ly * Math.cos(rad)),
				];
				for (const o of objs) {
					let [ox, oy, oa] = o.rest;
					let sq = 0.55;
					if (o.ts >= 0 && t >= o.ts) {
						const a = [0, 1, 2].map((i) => lerp(o.bed[i], o.hang[i], lift));
						const [wx, wy] = toWorld(a[0], a[1]);
						const j = clamp((t - o.ts) / o.dur) ** 2; // the pull grows steeply as the gap closes
						ox = lerp(ox, wx, j);
						oy = lerp(oy, wy, j);
						oa = lerp(oa, phi + a[2], j);
						sq = lerp(0.55, lerp(0.55, 1, lift), j);
					}
					o.el.setAttribute('transform', `translate(${f2(ox)} ${f2(oy)}) scale(1 ${f2(sq)}) rotate(${f1(oa)}) scale(${CM})`);
				}
				// the rope: from the top hand down to the pulling hand and on to the magnet
				const wet = clamp((m[1] - SURF) / 20);
				const C = curve(P, m, L, Math.max(-4, Math.min(4, -0.04 * v[0])) * wet);
				const path = (f: (q: P2) => P2) =>
					`M ${p2(f(top))} L ${p2(f(P))} Q ${p2(f(C))} ${p2(f(m))}`;
				rope.setAttribute('d', path((q) => q));
				// the coil: in the hand until the man puts it on the deck behind him before pulling
				const put = smooth(8.55, 9.05, t);
				const out = pulling ? Math.hypot(m[0] - P[0], m[1] - P[1]) + (P[1] - top[1]) : L;
				const stored = Math.max(0, ROPE - out);
				const pile: P2 = [p.x - 11, DECK - 1.6];
				const held: P2 = [H1[0], H1[1] + 1];
				const cpos = mix(held, pile, put);
				coil.forEach((el, i) => {
					const ry = lerp(2 + stored * 0.012, 1.1 + 0.002 * stored, put);
					const rx = lerp(2.4 + 0.3 * i, 2.8 + stored * 0.018 - 0.6 * i, put);
					el.setAttribute('cx', f1(cpos[0] + (i - 1) * lerp(0.7, 0.4, put)));
					el.setAttribute('cy', f1(cpos[1] + lerp(ry, -0.9 * i, put)));
					el.setAttribute('rx', f2(rx));
					el.setAttribute('ry', f2(ry));
				});
				const ctop: P2 = [cpos[0], cpos[1] - 0.9 * 2 * put];
				const sl = Math.hypot(ctop[0] - top[0], ctop[1] - top[1]);
				strand.setAttribute('d', put > 0 ? `M ${p2(top)} Q ${p2(curve(top, ctop, sl * 1.25, 0))} ${p2(ctop)}` : '');
				// the lens follows the magnet
				const cam: P2 = [m[0] - 2, m[1] + lerp(-1, 4, lift)];
				const toLens = (q: P2): P2 => [LENS[0] + K * (q[0] - cam[0]), LENS[1] + K * (q[1] - cam[1])];
				lensview.setAttribute('transform', `translate(${f1(LENS[0] - K * cam[0])} ${f1(LENS[1] - K * cam[1])}) scale(${K})`);
				lensrope.setAttribute('d', path(toLens));
				const ux = m[0] - LENS[0];
				const uy = m[1] + 2 - LENS[1];
				const un = Math.hypot(ux, uy);
				pointer.setAttribute('x1', f1(LENS[0] + (LR * ux) / un));
				pointer.setAttribute('y1', f1(LENS[1] + (LR * uy) / un));
				pointer.setAttribute('x2', f1(m[0] - (5 * ux) / un));
				pointer.setAttribute('y2', f1(m[1] + 2 - (5 * uy) / un));
				// rings on the water where the magnet goes in and comes out; drops fall back
				[[tIn, xIn], [tOut, xOut], [tOut + 0.25, xOut]].forEach(([t0, x0], i) => {
					const a = t0 < 0 ? -1 : (t - t0) / 1.6;
					if (a < 0 || a > 1) {
						ripples[i].setAttribute('d', '');
						return;
					}
					const rx = 1.5 + 13 * Math.sqrt(a);
					ripples[i].setAttribute('d', `M ${f1(x0 - rx)} 127.6 A ${f1(rx)} ${f1(0.22 * rx)} 0 0 1 ${f1(x0 + rx)} 127.6`);
					ripples[i].style.opacity = f2(0.9 * (1 - a));
				});
				drops.forEach((el, i) => {
					const r = rel[i];
					const t0 = tOut + 0.2 + 0.35 * i;
					const y = r ? r[1] + 0.5 * G * (t - t0) ** 2 : SURF;
					el.style.opacity = r && y < SURF ? '0.9' : '0';
					if (r) {
						el.setAttribute('cx', f1(r[0]));
						el.setAttribute('cy', f2(Math.min(y, SURF)));
					}
				});
				// water plants sway (wall-clock time: also during the pause between runs)
				const now = performance.now() / 1000;
				for (const w of weeds) {
					const s = 2.2 * Math.sin(0.9 * now + w.x * 0.37);
					w.el.setAttribute('d', `M ${w.x} ${w.y} Q ${f1(w.x + 0.4 * s - 1.5)} ${f1(w.y - w.h / 2)} ${f1(w.x + s)} ${f1(w.y - w.h)}`);
				}
			});
		}
	}
</script>
