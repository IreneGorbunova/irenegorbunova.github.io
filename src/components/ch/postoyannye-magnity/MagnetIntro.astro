---
/**
 * Two short looping opening scenes of «Постоянные магниты». No numbers: the scenes show only what one sees; the
 * captions' popovers explain.
 * Fridge: the front of a fridge in a kitchen. A hand brings a paper note with a round magnet from in front of the
 *   door (drawn larger and with a long soft shadow: it is closer to us). Near the steel door the magnet leaves the
 *   fingers and snaps to the door by itself (the force grows steeply as the gap closes), the hand goes away, the
 *   note swings a little on the magnet and stays.
 * Search: a search magnet on a calm river, in cut-away at 60 px/m (a 1,7 m man, water 1,6 m deep). A man on a low
 *   wooden pier lowers a round magnet (a puck-sized disc in a steel cup with an eyebolt) on a rope to the bottom,
 *   turns and walks slowly to the bank (0,5 m/s), the magnet drags along the bottom behind him. It passes an
 *   aluminum can and a glass bottle (nothing happens); near two nails and a horseshoe these jump the last 3–5 cm to
 *   the magnet by themselves (as fast as in a tenth of a second), a nail farther away stays. He turns and pulls the
 *   rope up hand over hand: the magnet rises along the rope, swings under his hands (strongly damped in water) and
 *   comes out with the catch; drops fall back. The magnet is a point on the rope, simulated in steps of 1/600 s:
 *   gravity (less in water by the buoyancy of steel), linear drag (water: terminal speed ~1,9 m/s), friction on the
 *   bottom, an inextensible rope (position projection); slack rope sags as a parabola. Objects lying on the bottom are
 *   drawn foreshortened (seen a little from above). The lens on the left shows the magnet four times larger (a <use>
 *   copy of the scene, without the rope, which it draws itself).
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const gid = `mi-${Math.random().toString(36).slice(2, 8)}`;
// search scene, 60 px/m: deck top 112, water surface 128, flat bottom 224 from x = 150, the bank on the left
const ss = (u: number) => (u <= 0 ? 0 : u >= 1 ? 1 : u * u * (3 - 2 * u));
const bedY = (x: number) => (x < 40 ? 114 : x < 150 ? 114 + 110 * ss((x - 40) / 110) : 224);
const f1 = (v: number) => v.toFixed(1);
const pts = (a: number, b: number, n: number) =>
	Array.from({ length: n + 1 }, (_, i) => a + ((b - a) * i) / n).map((x) => `${f1(x)} ${f1(bedY(x))}`).join(' L');
const SOIL = `M0 114 L${pts(40, 150, 22)} L360 224 V240 H0 Z`;
const SILT = `M${pts(64, 150, 18)} L360 224`;
const POSTS = [72, 140, 208, 276, 344].map((x) => ({ x, h: bedY(x) + 5 - 116 }));
const PEBBLES = [
	[86, 1.6], [104, 1.2], [158, 1.4], [171, 0.9], [189, 1.7], [226, 1.1], [243, 0.8], [262, 1.3], [287, 1.0], [318, 1.5], [331, 0.9], [352, 1.3],
].map(([x, r]) => ({ x, y: f1(bedY(x) - r * 0.45), r }));
const STONES = [[30, 128, 2.2], [92, 214, 1.8], [180, 233, 2], [250, 236, 1.6], [310, 231, 2.3], [20, 200, 1.5], [60, 176, 1.7]];
// water plants (swaying) and reeds by the bank
const WEEDS = [[176, 16], [181, 11], [298, 13], [355, 17], [118, 12], [124, 9]].map(([x, h]) => ({ x, y: bedY(x), h }));
const REEDS = [[46, 100], [50, 94], [55, 98], [60, 92], [66, 101]].map(([x, top]) => ({ x, y: f1(bedY(x)), top }));
const TUFTS = [6, 15, 27, 36].map((x) => `M${x - 3} 114 q 2 -5 3 -6 M${x} 114 q 0 -5 1 -7 M${x + 3} 114 q -1 -4 -3 -6`).join(' ');
---

<IntroFrame data-mintro>
	<div class="intro__card" data-scene="fridge">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Кухня, дверца холодильника. Рука подносит к дверце записку с круглым магнитиком. У самой дверцы магнитик выскальзывает из пальцев, сам прыгает к дверце и прижимает записку. Рука уходит, записка висит.">
			<defs>
				<radialGradient id={`${gid}-mag`} cx="0.35" cy="0.3" r="0.8">
					<stop offset="0" stop-color="var(--mi-mag-hi)"></stop>
					<stop offset="1" stop-color="var(--mi-mag)"></stop>
				</radialGradient>
			</defs>
			<rect class="mi-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="mi-floor" x="0" y="214" width="360" height="26"></rect>
			<!-- the fridge -->
			<rect class="mi-fridge" x="88" y="4" width="182" height="216" rx="12"></rect>
			<line class="mi-gap" x1="88" y1="74" x2="270" y2="74"></line>
			<rect class="mi-handle" x="250" y="26" width="8" height="36" rx="4"></rect>
			<rect class="mi-handle" x="250" y="90" width="8" height="64" rx="4"></rect>
			<rect class="mi-foot" x="98" y="220" width="18" height="5" rx="2"></rect>
			<rect class="mi-foot" x="242" y="220" width="18" height="5" rx="2"></rect>
			<!-- a drawing that already hangs on the door -->
			<g transform="rotate(-3 132 126)">
				<rect class="mi-paper" x="104" y="98" width="58" height="48" rx="1.5"></rect>
				<circle class="mi-sun" cx="148" cy="111" r="6"></circle>
				<path class="mi-ink" d="M114 138 V124 L126 114 L138 124 V138 Z M123 138 V130 H129 V138"></path>
				<path class="mi-grass" d="M108 140 Q120 136 132 140 T158 140"></path>
				<circle class="mi-mag2" cx="133" cy="100" r="6.5"></circle>
			</g>
			<circle class="mi-mag3" cx="118" cy="40" r="7"></circle>
			<rect class="mi-paper mi-paper--list" x="186" y="22" width="40" height="40" rx="1.5" transform="rotate(4 206 42)"></rect>
			<path class="mi-ink mi-ink--thin" d="M192 34 h24 M192 42 h20 M192 50 h26" transform="rotate(4 206 42)"></path>
			<circle class="mi-mag3" cx="206" cy="24" r="6"></circle>
			<!-- the new note: its shadow on the door, the note on the magnet -->
			<g data-shadow>
				<rect class="mi-shadow" x="-22" y="-4" width="44" height="46" rx="3"></rect>
			</g>
			<g data-note>
				<g data-swing>
					<rect class="mi-note" x="-22" y="-4" width="44" height="46" rx="1.5"></rect>
					<path class="mi-ink mi-ink--thin" d="M-14 14 h26 M-14 22 h20 M-14 30 h24"></path>
					<circle cx="0" cy="0" r="8.5" fill={`url(#${gid}-mag)`} class="mi-mag"></circle>
				</g>
			</g>
			<text class="mi-click" x="226" y="114" data-click>щёлк!</text>
			<!-- the hand: its fingertips hold the right edge of the note; drawn at the note's position -->
			<g data-hand>
				<path class="mi-sleeve" d="M74 8 L170 -8 V62 L76 44 Z"></path>
				<rect class="mi-skin" x="34" y="0" width="54" height="46" rx="16"></rect>
				<rect class="mi-skin" x="14" y="2" width="40" height="13" rx="6.5"></rect>
				<rect class="mi-skin" x="20" y="14" width="34" height="12" rx="6"></rect>
				<rect class="mi-skin" x="26" y="26" width="30" height="11" rx="5.5"></rect>
				<rect class="mi-skin" x="22" y="34" width="26" height="11" rx="5.5" transform="rotate(-18 36 40)"></rect>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Магнитик сам прыгает к дверце холодильника и держит записку <More term="прямо сквозь бумагу">Магнит действует на железо и сталь на расстоянии: сквозь бумагу, картон, стекло, даже сквозь ладонь. Дверца холодильника сделана из тонкой стали, и магнит её притягивает. Чем ближе магнит к стали, тем сильнее притяжение, поэтому последний миллиметр он пролетает сам. К деревянной двери или к алюминиевой кастрюле магнитик не прилипнет. Подробнее — в разделе <a href="#постоянные-магниты">«Постоянные магниты»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="search">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Тихая река, вода показана в разрезе. Человек на деревянных мостках опускает на верёвке круглый магнит на дно и медленно идёт к берегу, магнит ползёт по дну. В круге магнит показан крупно. Мимо алюминиевой банки и стеклянной бутылки он проходит, а два ржавых гвоздя и старая подкова сами прыгают к нему. Человек вытягивает верёвку, и магнит с подковой и гвоздями поднимается из воды.">
			<defs>
				<linearGradient id={`${gid}-water`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="ms-w0"></stop>
					<stop offset="1" class="ms-w1"></stop>
				</linearGradient>
				<clipPath id={`${gid}-lens`}>
					<circle cx="56" cy="54" r="44"></circle>
				</clipPath>
			</defs>
			<g id={`${gid}-world`}>
				<rect class="ms-sky" x="-400" y="-400" width="1160" height="1040"></rect>
				<g class="ms-cloud">
					<ellipse cx="236" cy="30" rx="26" ry="6"></ellipse>
					<ellipse cx="252" cy="25" rx="14" ry="7"></ellipse>
					<ellipse cx="330" cy="58" rx="20" ry="4.5"></ellipse>
					<ellipse cx="320" cy="54" rx="10" ry="5"></ellipse>
				</g>
				<!-- the far bank across the river -->
				<path class="ms-far" d="M 150 117 a 8 7 0 0 1 15 -3 a 7 6 0 0 1 13 1 a 5 4 0 0 1 9 2 Z M 236 117 a 9 9 0 0 1 17 -4 a 8 7 0 0 1 15 1 a 6 5 0 0 1 11 3 Z M 312 117 a 7 6 0 0 1 13 -2 a 9 8 0 0 1 17 0 a 6 5 0 0 1 11 2 Z"></path>
				<path class="ms-farbank" d="M 60 118.5 C 110 116 150 117.5 190 116.5 S 290 115.2 360 117 V 120.5 H 60 Z"></path>
				<rect class="ms-surface" x="60" y="120" width="300" height="8"></rect>
				<path class="ms-glint" d="M 120 123 h 9 M 168 125.5 h 6 M 226 122.5 h 11 M 300 124.5 h 8 M 342 122 h 6"></path>
				<!-- the water in cut-away, the bank and the bottom -->
				<rect x="0" y="128" width="360" height="112" fill={`url(#${gid}-water)`}></rect>
				<path class="ms-soil" d={SOIL}></path>
				{STONES.map(([x, y, r]) => <ellipse class="ms-stone" cx={x} cy={y} rx={r} ry={r * 0.6} />)}
				<path class="ms-silt" d={SILT}></path>
				{PEBBLES.map((p) => <ellipse class="ms-pebble" cx={p.x} cy={p.y} rx={p.r} ry={p.r * 0.5} />)}
				<g class="ms-weed" data-weeds>
					{WEEDS.map((w) => <path data-x={w.x} data-y={w.y} data-h={w.h} d="" />)}
				</g>
				<line class="ms-edge" x1="64" y1="128" x2="360" y2="128"></line>
				<g class="ms-reed">
					{REEDS.map((r) => <path d={`M ${r.x} ${r.y} Q ${r.x - 1} ${(Number(r.y) + r.top) / 2} ${r.x + 1} ${r.top}`} />)}
				</g>
				{REEDS.filter((_, i) => i % 2 === 0).map((r) => <rect class="ms-cattail" x={r.x + 0.1} y={r.top + 3} width="2.2" height="7" rx="1.1" />)}
				<path class="ms-tuft" d={TUFTS}></path>
				<!-- the pier -->
				{POSTS.map((p) => <rect class="ms-post" x={p.x - 2.5} y="116" width="5" height={f1(p.h)} />)}
				<rect class="ms-beam" x="22" y="116" width="332" height="3"></rect>
				<rect class="ms-deck" x="20" y="112" width="336" height="4.4" rx="1"></rect>
				<!-- on the bottom (cm drawn at 0,6 px/cm): a can, a bottle, a nail far away; then the catch -->
				<g transform="translate(299.5 224) rotate(-5) scale(0.6)">
					<rect class="ms-alu" x="-6" y="-6.6" width="12" height="6.6" rx="0.6"></rect>
					<rect class="ms-label" x="-3.2" y="-6.6" width="5" height="6.6"></rect>
					<ellipse class="ms-lid" cx="6" cy="-3.3" rx="0.9" ry="3.3"></ellipse>
				</g>
				<g transform="translate(277 224) rotate(3) scale(0.6)">
					<path class="ms-glass" d="M 8 -6.6 Q 8.6 -3.3 8 0 H -3 C -5 0 -6 -2.1 -7.6 -2.1 H -13 V -4.5 H -7.6 C -6 -4.5 -5 -6.6 -3 -6.6 Z"></path>
					<rect class="ms-glass" x="-13.9" y="-4.9" width="1.1" height="3.2" rx="0.3"></rect>
					<path class="ms-glare" d="M 6 -5.3 H -2.6"></path>
				</g>
				<g transform="translate(200 223.6) scale(1 0.55) rotate(100) scale(0.6)">
					<path class="ms-nail" d="M -1.2 -0.6 H 1.2 V 0.2 H 0.35 L 0.15 8 H -0.15 L -0.35 0.2 H -1.2 Z"></path>
				</g>
				<g data-shoe>
					<path class="ms-rust" d="M -6 13 V 6 A 6 6 0 0 1 6 6 V 13 H 4 V 6 A 4 4 0 0 0 -4 6 V 13 Z"></path>
					<path class="ms-holes" d="M -5 10 v 0.1 M 5 10 v 0.1 M -4.6 4.6 v 0.1 M 4.6 4.6 v 0.1"></path>
				</g>
				<g data-nail1>
					<path class="ms-nail" d="M -1.2 -0.6 H 1.2 V 0.2 H 0.35 L 0.15 8 H -0.15 L -0.35 0.2 H -1.2 Z"></path>
				</g>
				<g data-nail2>
					<path class="ms-nail" d="M -1.2 -0.6 H 1.2 V 0.2 H 0.35 L 0.15 8 H -0.15 L -0.35 0.2 H -1.2 Z"></path>
				</g>
				<!-- the man (local: x = 0 at his middle, facing +x; y as in the scene; turned by the script) -->
				<g data-man>
					<g data-leg2>
						<path class="ms-pants ms-back" d="M 0 57 V 101"></path>
						<path class="ms-boot ms-back" d="M -3.5 98 H 3.5 V 108 H 6.5 Q 9 108 9 110.5 V 112 H -3.5 Z"></path>
					</g>
					<path class="ms-armline" d="" data-arm2o></path>
					<path class="ms-arm ms-back" d="" data-arm2></path>
					<circle class="ms-hand ms-back" r="2.5" data-hand2></circle>
					<rect class="ms-jacket" x="-8.5" y="24" width="17.5" height="35" rx="6"></rect>
					<rect class="ms-skin" x="-6.5" y="8" width="14" height="16" rx="6.5"></rect>
					<circle class="ms-eye" cx="4.6" cy="16.5" r="0.9"></circle>
					<path class="ms-cap" d="M -7 14.5 Q -7.5 5 0.5 5 Q 8.5 5 8 14.5 Z M 5 13 H 12.8 Q 13.4 14.4 11.8 14.8 H 5 Z"></path>
					<g data-leg1>
						<path class="ms-pants" d="M 0 57 V 101"></path>
						<path class="ms-boot" d="M -3.5 98 H 3.5 V 108 H 6.5 Q 9 108 9 110.5 V 112 H -3.5 Z"></path>
					</g>
					<path class="ms-armline" d="" data-arm1o></path>
					<path class="ms-arm" d="" data-arm1></path>
					<circle class="ms-hand" r="2.5" data-hand1></circle>
				</g>
				<!-- the magnet: origin at the top of the eyebolt -->
				<g data-magnet>
					<circle class="ms-eyebolt" cx="0" cy="1.3" r="1.05"></circle>
					<rect class="ms-steel" x="-0.45" y="2.2" width="0.9" height="0.8"></rect>
					<rect class="ms-cup" x="-4.2" y="2.8" width="8.4" height="3" rx="0.7"></rect>
					<rect class="ms-face" x="-3.4" y="5.2" width="6.8" height="0.6" rx="0.2"></rect>
					<path class="ms-shine" d="M -3.2 3.7 H 2.2"></path>
				</g>
				<g class="ms-ripple" data-ripples>
					<path d=""></path>
					<path d=""></path>
					<path d=""></path>
				</g>
				<g class="ms-drop" data-drops>
					<circle r="0.5"></circle>
					<circle r="0.45"></circle>
					<circle r="0.4"></circle>
				</g>
			</g>
			<!-- the rope: to the magnet, and from the hands to the coil -->
			<path class="ms-rope ms-rope--slack" d="" data-strand></path>
			<g class="ms-rope ms-rope--slack" data-coil>
				<ellipse></ellipse>
				<ellipse></ellipse>
				<ellipse></ellipse>
			</g>
			<path class="ms-rope" d="" data-rope></path>
			<!-- the lens: the magnet four times larger -->
			<line class="ms-pointer" data-pointer></line>
			<g clip-path={`url(#${gid}-lens)`}>
				<use href={`#${gid}-world`} data-lensview></use>
				<path class="ms-rope ms-rope--lens" d="" data-lensrope></path>
			</g>
			<circle class="ms-lensring" cx="56" cy="54" r="44"></circle>
		</svg>
		<div class="intro__foot">
			<p>Поисковый магнит тащат на верёвке по дну реки: банка и бутылка остаются лежать, а ржавые гвозди и подкова сами прыгают к нему. Ему не нужны ни батарейка, ни провода — <More term="он сам притягивает железо">Поисковые магниты делают из сплава неодима, железа и бора — это самые сильные постоянные магниты. Неодимовый магнит размером с хоккейную шайбу, прилипнув к толстой ровной стальной плите, удержит подвешенный к нему груз в 180–200 кг. Алюминиевая банка и стеклянная бутылка остаются на дне, потому что на алюминий и стекло магнит почти не действует. Подробнее — в разделе <a href="#постоянные-магниты">«Постоянные магниты»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-mintro] {
		--mi-wall: color-mix(in srgb, var(--ig-v) 10%, var(--sl-color-gray-5));
		--mi-fridge: color-mix(in srgb, var(--sl-color-gray-2) 34%, var(--sl-color-gray-5));
		--mi-paper: var(--sl-color-gray-2);
		--mi-note: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-2));
		--mi-ink: var(--sl-color-gray-5);
		--mi-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		--mi-mag: color-mix(in oklab, var(--sl-color-green) 70%, var(--sl-color-gray-5));
		--mi-mag-hi: color-mix(in oklab, var(--sl-color-green) 70%, var(--sl-color-white));
		--mi-shadow: var(--sl-color-black);
	}
	:root[data-theme='light'] [data-mintro] {
		--mi-wall: color-mix(in srgb, var(--ig-v) 8%, var(--sl-color-gray-6));
		--mi-fridge: var(--sl-color-gray-7, #fff);
		--mi-paper: var(--sl-color-gray-7, #fff);
		--mi-note: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-7, #fff));
		--mi-ink: var(--sl-color-gray-4);
		--mi-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		--mi-mag: color-mix(in oklab, var(--sl-color-green) 85%, var(--sl-color-gray-3));
		--mi-mag-hi: color-mix(in oklab, var(--sl-color-green) 45%, var(--sl-color-gray-7, #fff));
		--mi-shadow: var(--sl-color-gray-3);
	}
	.mi-wall {
		fill: var(--mi-wall);
	}
	.mi-floor {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.mi-fridge {
		fill: var(--mi-fridge);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.mi-gap {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.mi-handle {
		fill: var(--sl-color-gray-3);
	}
	.mi-foot {
		fill: var(--sl-color-gray-4);
	}
	.mi-paper {
		fill: var(--mi-paper);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.mi-sun {
		fill: color-mix(in oklab, var(--ig-v) 80%, transparent);
	}
	.mi-ink {
		fill: none;
		stroke: var(--mi-ink);
		stroke-width: 1.6;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.mi-ink--thin {
		stroke-width: 1.3;
		opacity: 0.8;
	}
	.mi-grass {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-green) 70%, transparent);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.mi-mag2 {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.mi-mag3 {
		fill: color-mix(in oklab, var(--ig-vx) 65%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.mi-note {
		fill: var(--mi-note);
		stroke: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-3));
		stroke-width: 0.8;
