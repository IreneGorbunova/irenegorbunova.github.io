---
/**
 * Why a permanent magnet stays a magnet. Two bars, soft iron and hardened steel, with their tiny magnets (arrows
 * from S to N, as in Magnetize.astro). Equal magnets are brought to their right ends, S pole first, and taken away.
 * Soft iron lines up already while the magnet is still coming and falls back into disorder when it is gone; steel
 * lines up only next to the pole and stays in order: it has become a magnet with its N end on the right.
 */
import PmStyles from './PmStyles.astro';
import { rng } from './mag';

const COLS = 8;
const X0 = 16;
const BW = 200;
const BH = 44;
const ROWS = [
	{ id: 'soft', y: 34, name: 'Мягкое железо' },
	{ id: 'steel', y: 140, name: 'Закалённая сталь' },
];
const rand = rng(23);
const cells = ROWS.flatMap((row) =>
	Array.from({ length: COLS * 2 }, (_, i) => {
		const c = i % COLS;
		const r = Math.floor(i / COLS);
		return {
			row: row.id,
			x: X0 + ((c + 0.5) * BW) / COLS,
			y: row.y + ((r + 0.5) * BH) / 2,
			c,
			a0: (rand() * 2 - 1) * Math.PI, // the angle in disorder
			a1: (rand() * 2 - 1) * Math.PI, // the angle in disorder after the magnet is gone
			d: rand(),
		};
	}),
);
---

<PmStyles />
<figure class="rp not-content" data-rp>
	<svg class="rp__svg" viewBox="0 0 360 236" role="img" aria-label="К бруску мягкого железа и к бруску закалённой стали подносят одинаковые магниты и убирают их. В железе крошечные магниты снова смотрят в разные стороны, а в стали остаются повёрнутыми в одну сторону.">
		{
			ROWS.map((row) => (
				<g>
					<text class="rp__name" x={X0} y={row.y - 10}>{row.name}</text>
					<rect class="rp__bar" x={X0} y={row.y} width={BW} height={BH} rx="4" />
					<text class="rp__state" x={X0 + BW / 2} y={row.y + BH + 22} data-state={row.id}>не магнит</text>
					<g data-mag={row.id} transform="translate(380 0)">
						<rect class="rp__s" x="0" y={row.y + BH / 2 - 15} width="62" height="30" rx="3" />
						<rect class="rp__n" x="62" y={row.y + BH / 2 - 15} width="62" height="30" rx="3" />
						<text class="rp__lt" x="16" y={row.y + BH / 2 + 5.5}>S</text>
						<text class="rp__lt" x="108" y={row.y + BH / 2 + 5.5}>N</text>
					</g>
				</g>
			))
		}
		{cells.map((c) => <path class="rp__dom" d="M-8 0H8M3.5 -4L8 0L3.5 4" data-row={c.row} data-c={c.c} data-a0={c.a0} data-a1={c.a1} data-d={c.d} transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)}) rotate(${((c.a0 * 180) / Math.PI).toFixed(0)})`} />)}
	</svg>
	<div class="rp__foot">
		<figcaption>Стрелки — крошечные магниты внутри брусков (стрелка смотрит от <span class="pm-s">S</span> к <span class="pm-n">N</span>). К обоим брускам подносят одинаковые магниты, а потом убирают.</figcaption>
		<button type="button" class="intro__again rp__again" data-again>Повторить</button>
	</div>
</figure>

<style is:global>
	.rp {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.rp__svg {
		display: block;
		width: 100%;
		max-width: 26rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.rp text {
		font-family: var(--__sl-font);
	}
	.rp__name {
		font-size: 14px;
		font-weight: 600;
		fill: var(--sl-color-gray-2);
	}
	.rp__bar {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
	}
	.rp__dom {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.rp__state {
		font-size: 14px;
		text-anchor: middle;
		fill: var(--sl-color-gray-3);
	}
	.rp__state.is-mag {
		fill: var(--sl-color-white);
		font-weight: 700;
	}
	.rp__n {
		fill: var(--ig-vx);
	}
	.rp__s {
		fill: var(--ig-vy);
	}
	.rp__lt {
		font-size: 15px;
		font-weight: 700;
		text-anchor: middle;
		fill: var(--sl-color-black);
	}
	:root[data-theme='light'] .rp__lt {
		fill: #fff;
	}
	.rp__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.rp__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.rp__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.rp__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	/** Turns from angle a to angle b the short way, by the fraction t. */
	const turnTo = (a: number, b: number, t: number) => {
		let d = (b - a) % (2 * Math.PI);
		if (d > Math.PI) d -= 2 * Math.PI;
		if (d < -Math.PI) d += 2 * Math.PI;
		return a + d * t;
	};
	const BAR_END = 216; // right end of the bars
	const OUT = 380; // the magnet out of the picture
	const RUN = 8;

	for (const root of document.querySelectorAll<HTMLElement>('[data-rp]')) {
		const doms = [...root.querySelectorAll<SVGPathElement>('[data-row]')].map((el) => ({
			el,
			row: el.dataset.row!,
			c: +el.dataset.c!,
			a0: +el.dataset.a0!,
			a1: +el.dataset.a1!,
			d: +el.dataset.d!,
			best: 0,
			tr: el.getAttribute('transform')!.replace(/ rotate\(.*\)/, ''),
		}));
		const mags = [...root.querySelectorAll<SVGGElement>('[data-mag]')];
		const states = Object.fromEntries([...root.querySelectorAll<SVGTextElement>('[data-state]')].map((e) => [e.dataset.state!, e]));

		let last = 0;
		scene(root, RUN, (x) => {
			// the magnet comes in (0,05–0,3), stays, and goes away (0,45–0,6)
			const u = smooth(0.05, 0.3, x); // 0: the magnet far away, 1: at the end of the bar
			const pos = OUT + (BAR_END + 4 - OUT) * (u - smooth(0.45, 0.6, x));
			for (const m of mags) m.setAttribute('transform', `translate(${pos.toFixed(1)} 0)`);
			const order = { soft: 0, steel: 0 };
			for (const d of doms) {
				const far = (7 - d.c) / 7; // 0 at the end next to the magnet, 1 at the other end
				let ang: number;
				if (d.row === 'soft') {
					// turns in a weak field already; when the magnet is gone, falls back into disorder
					if (x < 0.45) ang = turnTo(d.a0, 0, smooth(0.35 + 0.25 * far + 0.08 * d.d, 0.5 + 0.25 * far + 0.08 * d.d, u));
					else ang = turnTo(0, d.a1, smooth(0.47 + 0.1 * d.d, 0.6 + 0.1 * d.d, x));
					order.soft += Math.cos(ang);
				} else {
					// needs a strong field: turns only near the pole, and keeps the order it got
					const reach = smooth(0.78 + 0.1 * far + 0.03 * d.d, 0.85 + 0.1 * far + 0.03 * d.d, u);
					d.best = x < last ? reach : Math.max(d.best, reach);
					ang = turnTo(d.a0, 0, d.best);
					order.steel += Math.cos(ang);
				}
				d.el.setAttribute('transform', `${d.tr} rotate(${((ang * 180) / Math.PI).toFixed(1)})`);
			}
			last = x;
			for (const [id, e] of Object.entries(states)) {
				const mag = (order as Record<string, number>)[id] / 16 > 0.8;
				if (id === 'soft') e.textContent = mag ? 'магнит' : x > 0.45 ? 'снова не магнит' : 'не магнит';
				else e.textContent = mag ? (x > 0.6 ? 'остался магнитом' : 'магнит') : 'не магнит';
				e.classList.toggle('is-mag', mag);
			}
		});
	}
</script>
