---
/**
 * Picture to the definitions of the types of galaxies by Hubble's classification: a spiral (face-on, two arms
 * around a bright core), an elliptical (a smooth ellipse, brighter to the centre) and an irregular one (bright
 * clumps without a shape). Not to scale with each other.
 */
import VsPicStyles from './VsPicStyles.astro';

let seed = 41;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const gauss = () => Math.sqrt(-2 * Math.log(rnd() + 1e-9)) * Math.cos(2 * Math.PI * rnd());
const r2 = (v: number) => Math.round(v * 10) / 10;
const uid = Math.random().toString(36).slice(2, 8);
const gEll = `vgt-ell-${uid}`;
const gCore = `vgt-core-${uid}`;
const SP = { x: 60, y: 70 };
const pitch = Math.tan((16 * Math.PI) / 180);
const spiral: [number, number, number][] = [];
for (const th0 of [0, Math.PI]) {
	for (let i = 0; i < 200; i++) {
		const u = rnd() * 2.4 * Math.PI;
		const r = 7 * Math.exp(pitch * u);
		if (r > 48) continue;
		const th = th0 + u;
		const s = 1 + r * 0.035;
		spiral.push([r2(SP.x + r * Math.cos(th) + gauss() * s), r2(SP.y - r * Math.sin(th) * 0.92 + gauss() * s), rnd() < 0.15 ? 1.2 : 0.75]);
	}
}
const IR = { x: 300, y: 70 };
const clumps = [
	[-14, -8, 9],
	[10, 4, 12],
	[-4, 16, 7],
	[22, -14, 6],
	[-24, 10, 5],
];
const irr: [number, number, number][] = [];
for (const [cx, cy, s] of clumps) {
	for (let i = 0; i < 40; i++) irr.push([r2(IR.x + cx + gauss() * s), r2(IR.y + cy + gauss() * s * 0.8), rnd() < 0.2 ? 1.2 : 0.75]);
}
---

<VsPicStyles />
<figure class="vs-pic vs-pic--one not-content">
	<div class="vs-pic__grid">
		<svg class="vs-pic__svg" viewBox="0 0 360 170" role="img" aria-label="Три вида галактик: спиральная — диск с рукавами, эллиптическая — гладкий эллипсоид, неправильная — без определённой формы">
			<defs>
				<radialGradient id={gEll}>
					<stop offset="0" class="vgt-stop0"></stop>
					<stop offset="0.45" class="vgt-stop1"></stop>
					<stop offset="1" class="vgt-stop2"></stop>
				</radialGradient>
				<radialGradient id={gCore}>
					<stop offset="0" class="vgt-stop0"></stop>
					<stop offset="1" class="vgt-stop2"></stop>
				</radialGradient>
			</defs>
			{spiral.map(([x, y, r]) => <circle class="vgt-star" cx={x} cy={y} r={r} />)}
			<circle cx={SP.x} cy={SP.y} r="12" fill={`url(#${gCore})`}></circle>
			<ellipse cx="180" cy="70" rx="48" ry="32" fill={`url(#${gEll})`} transform="rotate(-18 180 70)"></ellipse>
			{irr.map(([x, y, r]) => <circle class="vgt-star" cx={x} cy={y} r={r} />)}
			<text class="vs-title" x="60" y="140" text-anchor="middle">спиральная</text>
			<text x="60" y="158" text-anchor="middle">как наша Галактика</text>
			<text class="vs-title" x="180" y="140" text-anchor="middle">эллиптическая</text>
			<text x="180" y="158" text-anchor="middle">старые звёзды</text>
			<text class="vs-title" x="300" y="140" text-anchor="middle">неправильная</text>
			<text x="356" y="158" text-anchor="end">Магеллановы Облака</text>
		</svg>
	</div>
</figure>

<style is:global>
	.vgt-star {
		fill: color-mix(in srgb, var(--ig-vx) 60%, var(--sl-color-gray-2));
	}
	.vgt-stop0 {
		stop-color: var(--ig-v);
		stop-opacity: 0.95;
	}
	.vgt-stop1 {
		stop-color: var(--ig-v);
		stop-opacity: 0.4;
	}
	.vgt-stop2 {
		stop-color: var(--ig-v);
		stop-opacity: 0;
	}
</style>
