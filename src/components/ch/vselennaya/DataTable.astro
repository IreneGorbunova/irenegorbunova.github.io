---
/** A compact wrapper for the chapter's data tables, so they fit a phone screen without scrolling. */
---

<div class="vtab"><slot /></div>

<style is:global>
	.vtab table {
		width: 100%;
		font-variant-numeric: tabular-nums;
	}
	.vtab th,
	.vtab td {
		white-space: nowrap;
	}
	.vtab td:last-child,
	.vtab th:last-child {
		white-space: normal;
	}
	@media (max-width: 40rem) {
		.vtab {
			font-size: var(--sl-text-xs);
		}
		.vtab th,
		.vtab td {
			padding: 0.3rem 0.35rem;
		}
		.vtab .katex {
			font-size: 1em;
		}
	}
</style>
