		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.vh__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin-top: 0.75rem;
		align-items: start;
	}
	.vh__stage {
		min-width: 0;
	}
	.vh__canvas {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 4;
		border-radius: 0.75rem;
