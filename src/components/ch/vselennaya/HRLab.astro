		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.vh__buttons {
		display: flex;
		gap: 0.5rem;
	}
	.vh__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		white-space: nowrap;
	}
