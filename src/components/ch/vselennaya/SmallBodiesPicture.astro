---
/**
 * Picture to the definitions of the small bodies.
 * Left: the inner Solar System from above, 28 px per а.е.: the orbits of the Earth (1), Mars (1,52) and Jupiter
 *   (5,20 а.е.), the asteroid belt between 2,2 and 3,3 а.е., and a short-period comet on an ellipse with
 *   q = 0,6 а.е. and a = 3 а.е. (e = 0,8, aphelion 5,4 а.е., period 5,2 years). Faint copies show it at 16 equal
 *   time steps (Kepler's equation), the bright one moves round in 8 s. The tail points away from the Sun and
 *   grows as 1/r² near the Sun (no tail beyond 3 а.е.).
 * Right: a cross-section of the atmosphere, the same scale on both axes (1,2 px per km). A meteoroid glows from
 *   about 120 km and burns out by 80 km: a meteor. A larger one glows down to about 25 km, then falls dark and
 *   lands: a meteorite.
 */
import VsPicStyles from './VsPicStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const clip = `vsb-clip-${uid}`;
let seed = 23;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const SUN = { x: 46, y: 122 };
const K = 28; // px per а.е.
const belt = Array.from({ length: 150 }, () => {
	const r = (2.2 + rnd() * 1.1) * K;
	const a = rnd() * Math.PI * 2;
	return [Math.round((SUN.x + r * Math.cos(a)) * 10) / 10, Math.round((SUN.y + r * Math.sin(a)) * 10) / 10];
}).filter(([x, y]) => x > 2 && x < 318 && y > 34 && y < 226);
// the comet's orbit
const A = 3 * K;
const E = 0.8;
const B = A * Math.sqrt(1 - E * E);
const CX = SUN.x + A * E; // the centre of the ellipse (perihelion to the left of the Sun)
// the comet at 16 equal time steps, with its tail
const tailPath = (x: number, y: number) => {
	const r = Math.hypot(x - SUN.x, y - SUN.y) / K;
	const len = r < 3 ? Math.min(40, 16 / (r * r)) : 0;
	if (len < 0.5) return '';
	const ux = (x - SUN.x) / (r * K);
	const uy = (y - SUN.y) / (r * K);
	const w = Math.min(6, 1.5 + len / 9);
	const tx = x + ux * len;
	const ty = y + uy * len;
	const f = (v: number) => v.toFixed(1);
	return `M${f(x - uy * 1.5)} ${f(y + ux * 1.5)} L${f(tx - uy * w)} ${f(ty + ux * w)} Q${f(tx + ux * 3)} ${f(ty + uy * 3)} ${f(tx + uy * w)} ${f(ty - ux * w)} L${f(x + uy * 1.5)} ${f(y - ux * 1.5)} Z`;
};
const steps = Array.from({ length: 16 }, (_, i) => {
	const M = (2 * Math.PI * i) / 16;
	let En = M;
	for (let k = 0; k < 40; k++) En -= (En - E * Math.sin(En) - M) / (1 - E * Math.cos(En));
	const x = SUN.x - A * (Math.cos(En) - E);
	const y = SUN.y - B * Math.sin(En);
	return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10, tail: tailPath(x, y) };
});
// km scale of the right panel
const G = 206; // ground
const KM = 1.2;
const hy = (h: number) => Math.round((G - h * KM) * 10) / 10;
---

<VsPicStyles />
<figure class="vs-pic not-content" data-vsb>
	<div class="vs-pic__grid">
		<svg class="vs-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Вид сверху на Солнце и орбиты Земли, Марса и Юпитера. Между Марсом и Юпитером — пояс астероидов. Комета пролетает у Солнца по вытянутой орбите, её хвост всегда направлен от Солнца">
			<defs>
				<clipPath id={clip}>
					<rect x="0" y="0" width="320" height="230"></rect>
				</clipPath>
			</defs>
			<g clip-path={`url(#${clip})`}>
				<circle class="vs-orbit" cx={SUN.x} cy={SUN.y} r={K}></circle>
				<circle class="vs-orbit" cx={SUN.x} cy={SUN.y} r={1.524 * K}></circle>
				<circle class="vs-orbit" cx={SUN.x} cy={SUN.y} r={5.2 * K}></circle>
				{belt.map(([x, y]) => <circle class="vsb-ast" cx={x} cy={y} r="0.9" />)}
				<ellipse class="vs-orbit vs-orbit--dash vsb-corbit" cx={CX} cy={SUN.y} rx={A} ry={B}></ellipse>
				{steps.map((p) => (
					<g class="vsb-ghost">
						<path class="vsb-tail" d={p.tail} />
						<circle class="vsb-nucleus" cx={p.x} cy={p.y} r="1.4" />
					</g>
				))}
				<path class="vsb-tail" data-tail></path>
				<circle class="vsb-coma" data-coma r="4"></circle>
				<circle class="vsb-nucleus" data-nucleus r="1.8"></circle>
			</g>
			<circle class="vs-sun-glow" cx={SUN.x} cy={SUN.y} r="9"></circle>
			<circle class="vs-sun" cx={SUN.x} cy={SUN.y} r="5"></circle>
			<circle class="vsb-earth" cx={SUN.x + K * Math.cos(-2.2)} cy={SUN.y + K * Math.sin(-2.2)} r="2.6"></circle>
			<circle class="vsb-mars" cx={SUN.x + 1.524 * K * Math.cos(1.9)} cy={SUN.y + 1.524 * K * Math.sin(1.9)} r="2.2"></circle>
			<circle class="vsb-jup" cx={SUN.x + 5.2 * K * Math.cos(-0.5)} cy={SUN.y + 5.2 * K * Math.sin(-0.5)} r="4.5"></circle>
			<text class="vs-title" x="8" y="20">Малые тела</text>
			<circle class="vs-sun" cx="12" cy="219" r="4"></circle>
			<text x="20" y="223">Солнце</text>
			<circle class="vsb-earth" cx="80" cy="219" r="2.6"></circle>
			<text class="vs-t-acc" x="86" y="223">Земля</text>
			<circle class="vsb-mars" cx="138" cy="219" r="2.2"></circle>
			<text class="vs-t-red" x="144" y="223">Марс</text>
			<circle class="vsb-jup" cx="188" cy="219" r="4"></circle>
			<text x="196" y="223">Юпитер</text>
			<text x="112" y="20">пояс астероидов</text>
			<line class="vs-line" x1="122" y1="25" x2="96" y2="56"></line>
			<text x="204" y="160">орбита кометы</text>
		</svg>
		<svg class="vs-pic__svg" viewBox="0 0 320 230" role="img" aria-label="Атмосфера в разрезе. Метеороид влетает в атмосферу и сгорает на высоте около 100 км — это метеор. Крупный осколок долетает до земли — это метеорит">
			<rect class="vsb-air" x="0" y={hy(120)} width="320" height={G - hy(120)}></rect>
			<rect class="vsb-ground" x="0" y={G} width="320" height={230 - G}></rect>
			<line class="vs-line" x1="0" y1={G} x2="320" y2={G}></line>
			<text class="vs-title" x="314" y="20" text-anchor="end">Метеор и метеорит</text>
			<!-- height scale -->
			<line class="vs-line" x1="30" y1={hy(0)} x2="30" y2={hy(140)}></line>
			{
				[0, 50, 100].map((h) => (
					<>
						<line class="vs-line" x1="26" y1={hy(h)} x2="34" y2={hy(h)} />
						<text x="38" y={hy(h) + 4}>
							{h === 0 ? '' : `${h} км`}
						</text>
					</>
				))
			}
			<!-- trails (drawn by the script) -->
			<path class="vsb-dark" data-path1></path>
			<path class="vsb-glow" data-glow1></path>
			<path class="vsb-dark" data-path2></path>
			<path class="vsb-glow vsb-glow--big" data-glow2></path>
			<circle class="vsb-rock" data-rock1 r="2.4"></circle>
			<circle class="vsb-rock" data-rock2 r="3.2"></circle>
			<path class="vsb-meteorite" data-landed d={`M233 ${G} q4 -7 9 -1 q2 3 -1 1 z`}></path>
			<text x="44" y="60"><tspan class="vs-t-sun">метеор</tspan> — вспышка</text>
			<text x="44" y="75">в атмосфере</text>
			<text class="vs-t-acc" x="238" y={G + 18} text-anchor="middle">метеорит</text>
			<text x="94" y={hy(30)}>воздух</text>
		</svg>
	</div>
	<div class="vs-pic__foot">
		<figcaption>
			Слева: пояс астероидов и комета в одном масштабе с орбитами планет (вид сверху). Бледные копии кометы показаны через равные промежутки времени: у Солнца она движется быстрее, а её хвост растёт и всегда направлен прочь от Солнца. Справа: атмосфера в разрезе, высоты настоящие.
		</figcaption>
	</div>
</figure>

<style is:global>
	.vsb-ast {
		fill: var(--sl-color-gray-3);
	}
	.vsb-corbit {
		stroke: color-mix(in srgb, var(--ig-vx) 55%, var(--sl-color-gray-4));
	}
	.vsb-ghost {
		opacity: 0.45;
	}
	.vsb-tail {
		fill: color-mix(in srgb, var(--ig-v) 45%, transparent);
	}
	.vsb-coma {
		fill: color-mix(in srgb, var(--ig-vx) 35%, transparent);
	}
	.vsb-nucleus {
		fill: var(--sl-color-white);
	}
	.vsb-earth {
		fill: var(--ig-vx);
	}
	.vsb-mars {
		fill: var(--ig-vy);
	}
	.vsb-jup {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-3));
	}
	.vsb-air {
		fill: color-mix(in srgb, var(--ig-vx) 12%, transparent);
	}
	.vsb-ground {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.vsb-dark {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.vsb-glow {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.vsb-glow--big {
		stroke-width: 3.4;
	}
	.vsb-rock {
		fill: var(--sl-color-gray-2);
	}
	.vsb-meteorite {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	for (const root of document.querySelectorAll<HTMLElement>('[data-vsb]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		// ---- the comet ----
		const tail = $<SVGPathElement>('[data-tail]');
		const coma = $<SVGCircleElement>('[data-coma]');
		const nucleus = $<SVGCircleElement>('[data-nucleus]');
		const SX = 46;
		const SY = 122;
		const K = 28;
		const A = 3 * K;
		const E = 0.8;
		const B = A * Math.sqrt(1 - E * E);
		const kepler = (M: number) => {
			let En = M;
			for (let i = 0; i < 30; i++) En -= (En - E * Math.sin(En) - M) / (1 - E * Math.cos(En));
			return En;
		};
		// ---- the meteors ----
		const G = 206;
		const KM = 1.2;
		const hy = (h: number) => G - h * KM;
		const path1 = $<SVGPathElement>('[data-path1]');
		const glow1 = $<SVGPathElement>('[data-glow1]');
		const path2 = $<SVGPathElement>('[data-path2]');
		const glow2 = $<SVGPathElement>('[data-glow2]');
		const rock1 = $<SVGCircleElement>('[data-rock1]');
		const rock2 = $<SVGCircleElement>('[data-rock2]');
		const landed = $<SVGPathElement>('[data-landed]');
		// meteor 1: enters at 45°, glows from 120 to 80 km; meteor 2: glows to 25 km, then falls dark, steeper
		const m1 = { x0: 138 + 140 * KM * 0.6, h0: 140, k: 1 };
		const m2 = { x0: 330, h0: 140, k: 0.55 };
		const at = (m: { x0: number; h0: number; k: number }, h: number) => [m.x0 - (m.h0 - h) * KM * m.k, hy(h)];
		const seg = (m: { x0: number; h0: number; k: number }, h1: number, h2: number) => {
			const [x1, y1] = at(m, h1);
			const [x2, y2] = at(m, h2);
			return `M${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)}`;
		};
		let t = 0;
		let tc = 0;
		const CYCLE = 7; // s
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			// comet: one revolution in 8 s (Kepler's equation in time); its own clock
			tc = (tc + dt) % 8;
			const M = Math.PI + (2 * Math.PI * tc) / 8;
			const En = kepler(M);
			const x = SX - A * (Math.cos(En) - E);
			const y = SY - B * Math.sin(En);
			const r = Math.hypot(x - SX, y - SY) / K; // а.е.
			nucleus.setAttribute('cx', x.toFixed(1));
			nucleus.setAttribute('cy', y.toFixed(1));
			coma.setAttribute('cx', x.toFixed(1));
			coma.setAttribute('cy', y.toFixed(1));
			const on = true;
			const len = r < 3 ? Math.min(40, 16 / (r * r)) : 0;
			coma.setAttribute('r', (1.8 + Math.min(4, 2.4 / r)).toFixed(2));
			const ux = (x - SX) / (r * K);
			const uy = (y - SY) / (r * K);
			const w = Math.min(6, 1.5 + len / 9);
			const tx = x + ux * len;
			const ty = y + uy * len;
			tail.setAttribute(
				'd',
				len > 0.5 ? `M${(x - uy * 2).toFixed(1)} ${(y + ux * 2).toFixed(1)} L${(tx - uy * w).toFixed(1)} ${(ty + ux * w).toFixed(1)} Q${(tx + ux * 4).toFixed(1)} ${(ty + uy * 4).toFixed(1)} ${(tx + uy * w).toFixed(1)} ${(ty - ux * w).toFixed(1)} L${(x + uy * 2).toFixed(1)} ${(y - ux * 2).toFixed(1)} Z` : '',
			);
			for (const el of [nucleus, coma, tail]) el.style.opacity = on ? '1' : '0';

			// meteors: 1 runs 0–2,5 s, 2 runs 3–6 s
			const t1 = t / 2.5;
			const h1 = 140 - 70 * Math.min(1, t1);
			path1.setAttribute('d', t1 < 1.4 ? seg(m1, 140, Math.max(h1, 80)) : '');
			const g1 = h1 < 120 && t1 < 1.4;
			glow1.setAttribute('d', g1 ? seg(m1, Math.min(120, Math.max(h1, 80) + 18), Math.max(h1, 80)) : '');
			glow1.style.opacity = h1 > 80 ? '1' : String(Math.max(0, 1 - (t1 - 0.86) * 4));
			const [r1x, r1y] = at(m1, Math.max(h1, 80));
			rock1.setAttribute('cx', r1x.toFixed(1));
			rock1.setAttribute('cy', r1y.toFixed(1));
			rock1.style.opacity = t1 < 1 && h1 > 82 ? '1' : '0';

			const t2 = Math.max(0, (t - 3) / 3);
			const h2 = 140 - 140 * Math.min(1, t2);
			path2.setAttribute('d', t > 3 ? seg(m2, 140, h2) : '');
			const g2 = h2 < 120 && h2 > 25;
			glow2.setAttribute('d', g2 ? seg(m2, Math.min(120, h2 + 24), h2) : '');
			const [r2x, r2y] = at(m2, h2);
			rock2.setAttribute('cx', r2x.toFixed(1));
			rock2.setAttribute('cy', r2y.toFixed(1));
			rock2.style.opacity = t > 3 && h2 > 1 ? '1' : '0';
			landed.style.opacity = h2 <= 1 && t > 3 ? '1' : '0';
			return true;
		});
	}
</script>
