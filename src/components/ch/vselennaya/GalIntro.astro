---
/**
 * Two short looping opening scenes of «Галактики и Вселенная». No terms of the chapter in the pictures; the
 * popovers explain.
 * Band: the night sky with a hazy band across it. In the round field of a telescope the magnification grows from
 *   1 to 30 times (Galileo's telescopes of 1610 gave 20–30 times), and the haze breaks up into separate stars.
 * Balloon: a balloon with ink dots is blown up from a radius of 5 см to 10 см. One dot is marked; the distances
 *   from it to a near dot (2 см at the start) and to a far one (4 см) are measured along the rubber, and both
 *   double: the far dot moves away by 4 см while the near one moves away by 2 см. The picture is the balloon seen
 *   face on (the dots are placed by their angles on the sphere), 9,2 px per centimeter.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const hazeBlur = `gi-haze-${uid}`;
const clipField = `gi-field-${uid}`;
const shine = `gi-shine-${uid}`;
let seed = 29;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const r1 = (v: number) => Math.round(v * 10) / 10;
// naked-eye stars of the whole sky
const skyStars = Array.from({ length: 54 }, () => [r1(rnd() * 360), r1(rnd() * 176), rnd() < 0.14 ? 1.4 : rnd() < 0.5 ? 1 : 0.7]);
// the stars the telescope shows inside its field: more of them toward the middle line of the band
const FIELD = { x: 262, y: 96, r: 64 };
const fieldStars = Array.from({ length: 300 }, () => {
	const a = rnd() * Math.PI * 2;
	const d = Math.sqrt(rnd()) * FIELD.r;
	const across = (rnd() + rnd() + rnd() - 1.5) * 0.9; // gathered toward the band
	const x = FIELD.x + Math.cos(a) * d;
	const y = FIELD.y + across * FIELD.r * 0.75 + (x - FIELD.x) * -0.42;
	return [r1(x), r1(y), rnd() < 0.08 ? 1.25 : rnd() < 0.4 ? 0.8 : 0.5];
});
// the dots of the balloon: [angle from the marked dot, rad; direction, rad]. The first two are the near and the far dot.
const dots = [
	[0.4, -0.5],
	[0.8, 2.5],
	[0.55, 1.3],
	[0.7, -1.9],
	[0.95, 0.35],
	[1.05, -2.9],
	[0.9, -1.05],
	[1.15, 1.75],
	[0.3, 3.4],
	[1.2, -0.25],
];
---

<IntroFrame data-galintro>
	<div class="intro__card" data-scene="band">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ночное небо пересекает туманная полоса. В телескоп при увеличении в 30 раз туман распадается на отдельные звёзды">
			<defs>
				<filter id={hazeBlur} filterUnits="userSpaceOnUse" x="-40" y="-40" width="440" height="320">
					<feGaussianBlur stdDeviation="11"></feGaussianBlur>
				</filter>
				<clipPath id={clipField}>
					<circle cx={FIELD.x} cy={FIELD.y} r={FIELD.r}></circle>
				</clipPath>
			</defs>
			<rect class="gi-night" x="0" y="0" width="360" height="240"></rect>
			<!-- the band across the sky -->
			<path class="gi-haze" d="M-30 196 C70 150 150 96 390 -6" filter={`url(#${hazeBlur})`}></path>
			<path class="gi-haze gi-haze--core" d="M-30 196 C70 150 150 96 390 -6" filter={`url(#${hazeBlur})`}></path>
			{skyStars.map(([x, y, r]) => <circle class="gi-star" cx={x} cy={y} r={r} />)}
			<!-- the land -->
			<path class="gi-land" d="M0 204 Q40 188 84 198 T168 196 T250 204 T360 192 V240 H0 Z"></path>
			<path class="gi-tree" d="M40 200 l7 -26 l7 26 z M52 201 l6 -20 l6 20 z M318 196 l7 -28 l7 28 z"></path>
			<!-- the place the telescope looks at, and its field -->
			<circle class="gi-spot" cx="118" cy="128" r="9"></circle>
			<path class="gi-lead" d="M126 123 L204 70 M124 136 L226 148"></path>
			<circle class="gi-fieldbg" cx={FIELD.x} cy={FIELD.y} r={FIELD.r}></circle>
			<g clip-path={`url(#${clipField})`}>
				<path class="gi-haze gi-haze--field" data-fhaze d="M150 143 L374 49" filter={`url(#${hazeBlur})`}></path>
				<g data-fstars>{fieldStars.map(([x, y, r]) => <circle class="gi-star" cx={x} cy={y} r={r} />)}</g>
			</g>
			<circle class="gi-rim" cx={FIELD.x} cy={FIELD.y} r={FIELD.r}></circle>
			<text class="gi-label" x={FIELD.x} y={FIELD.y + FIELD.r + 16} text-anchor="middle">в телескоп</text>
			<rect class="gi-read" x="12" y="12" width="132" height="26" rx="8"></rect>
			<text class="gi-num" data-mag x="22" y="30">увеличение 1×</text>
		</svg>
		<div class="intro__foot">
			<p>
				Тёмной ночью вдали от фонарей через всё небо тянется туманная полоса. В телескоп видно, что она{' '}
				<More term="состоит из звёзд">
					Звёзд в ней так много и они так далеки, что глаз видит только общее свечение. Эта полоса — наша Галактика, видимая изнутри: в ней сотни миллиардов звёзд, и Солнце — одна из них. Об этом{' '}
					<a href="#наша-галактика--млечный-путь">дальше в главе</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="balloon">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Воздушный шарик с точками надувают. Расстояния от отмеченной точки до всех остальных растут: до ближней точки с 2 до 4 сантиметров, до дальней с 4 до 8 сантиметров">
			<defs>
				<radialGradient id={shine} cx="0.36" cy="0.3" r="0.8">
					<stop offset="0" class="gi-b0"></stop>
					<stop offset="0.55" class="gi-b1"></stop>
					<stop offset="1" class="gi-b2"></stop>
				</radialGradient>
			</defs>
			<rect class="gi-room" x="0" y="0" width="360" height="240"></rect>
			<path class="gi-knot" data-knot></path>
			<circle class="gi-balloon" data-balloon cx="118" cy="112" r="46" fill={`url(#${shine})`}></circle>
			<line class="gi-rule gi-rule--near" data-lnear></line>
			<line class="gi-rule gi-rule--far" data-lfar></line>
			<g data-dots>{dots.map((_, i) => <circle class={`gi-dot${i === 0 ? ' gi-dot--near' : i === 1 ? ' gi-dot--far' : ''}`} r="3.2" />)}</g>
			<circle class="gi-home" data-home cx="118" cy="112" r="4.2"></circle>
			<circle class="gi-homering" cx="118" cy="112" r="8"></circle>
			<!-- the readout -->
			<rect class="gi-card" x="226" y="34" width="126" height="150" rx="10"></rect>
			<text class="gi-small" x="236" y="54">от отмеченной точки</text>
			<circle class="gi-dot gi-dot--near" cx="241" cy="78" r="3.2"></circle>
			<text class="gi-small" x="250" y="76">до ближней</text>
			<text class="gi-num gi-num--near" data-near x="250" y="94">2,0 см</text>
			<circle class="gi-dot gi-dot--far" cx="241" cy="124" r="3.2"></circle>
			<text class="gi-small" x="250" y="122">до дальней</text>
			<text class="gi-num gi-num--far" data-far x="250" y="140">4,0 см</text>
			<text class="gi-small" data-gain x="236" y="170"></text>
		</svg>
		<div class="intro__foot">
			<p>
				Нарисуйте на воздушном шарике точки и надувайте его. От любой точки все остальные удаляются, и{' '}
				<More term="дальние — быстрее ближних">
					Пока расстояние до ближней точки выросло на 2&nbsp;см, расстояние до дальней выросло на 4&nbsp;см. Так же ведут себя галактики: чем дальше галактика, тем быстрее она удаляется от нас. И ни одна точка на шарике не служит центром: с любой видно одно и то же. Об этом{' '}
					<a href="#расширяющаяся-вселенная">дальше в главе</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-galintro] .gi-night {
		fill: hsl(232, 46%, 9%);
	}
	[data-galintro] .gi-haze {
		fill: none;
		stroke: hsl(220, 40%, 82%);
		stroke-width: 44;
		stroke-linecap: round;
		opacity: 0.2;
	}
	[data-galintro] .gi-haze--core {
		stroke-width: 16;
		opacity: 0.22;
	}
	[data-galintro] .gi-haze--field {
		stroke-width: 96;
		opacity: 0.42;
	}
	[data-galintro] .gi-star {
		fill: hsl(45, 40%, 94%);
	}
	[data-galintro] .gi-land {
		fill: hsl(232, 40%, 4%);
	}
	[data-galintro] .gi-tree {
		fill: hsl(232, 40%, 4%);
	}
	[data-galintro] .gi-spot {
		fill: none;
		stroke: hsl(42, 90%, 70%);
		stroke-width: 1.4;
	}
	[data-galintro] .gi-lead {
		fill: none;
		stroke: hsl(42, 90%, 70%);
		stroke-width: 0.9;
		stroke-dasharray: 3 3;
		opacity: 0.7;
	}
	[data-galintro] .gi-fieldbg {
		fill: hsl(232, 50%, 6%);
	}
	[data-galintro] .gi-rim {
		fill: none;
		stroke: hsl(42, 90%, 70%);
		stroke-width: 2;
	}
	[data-galintro] .gi-label {
		font-size: 11px;
		fill: hsl(42, 90%, 76%);
	}
	[data-galintro] .gi-read {
		fill: hsl(232 45% 14% / 0.85);
	}
	[data-galintro] .gi-num {
		font-size: 13px;
		font-weight: 700;
		fill: hsl(42, 90%, 72%);
	}
	[data-galintro] .gi-room {
		fill: var(--sl-color-bg);
	}
	[data-galintro] .gi-b0 {
		stop-color: hsl(190, 80%, 78%);
	}
	[data-galintro] .gi-b1 {
		stop-color: hsl(196, 70%, 56%);
	}
	[data-galintro] .gi-b2 {
		stop-color: hsl(205, 66%, 38%);
	}
	[data-galintro] .gi-balloon {
		stroke: hsl(205, 60%, 30%);
		stroke-width: 1.2;
	}
	[data-galintro] .gi-knot {
		fill: hsl(205, 66%, 38%);
		stroke: hsl(205, 60%, 30%);
		stroke-width: 1;
	}
	[data-galintro] .gi-dot {
		fill: hsl(232, 40%, 16%);
	}
	[data-galintro] .gi-dot--near {
		fill: hsl(140, 60%, 24%);
		stroke: hsl(120, 70%, 82%);
		stroke-width: 1.2;
	}
	[data-galintro] .gi-dot--far {
		fill: hsl(275, 60%, 34%);
		stroke: hsl(280, 80%, 88%);
		stroke-width: 1.2;
	}
	[data-galintro] .gi-home {
		fill: hsl(20, 95%, 56%);
		stroke: white;
		stroke-width: 1.2;
	}
	[data-galintro] .gi-homering {
		fill: none;
		stroke: hsl(20, 95%, 56%);
		stroke-width: 1.2;
	}
	[data-galintro] .gi-rule {
		stroke-width: 1.6;
		stroke-dasharray: 4 3;
	}
	[data-galintro] .gi-rule--near {
		stroke: hsl(120, 70%, 82%);
	}
	[data-galintro] .gi-rule--far {
		stroke: hsl(280, 80%, 90%);
	}
	[data-galintro] .gi-card {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	[data-galintro] .gi-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-galintro] .gi-num--near,
	[data-galintro] .gi-num--far {
		font-size: 14px;
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ru = (v: number) => v.toFixed(1).replace('.', ',');
	const ease = (u: number) => u * u * (3 - 2 * u);

	for (const root of document.querySelectorAll<HTMLElement>('[data-galintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="band"]')!;
			const haze = card.querySelector<SVGPathElement>('[data-fhaze]')!;
			const stars = card.querySelector<SVGGElement>('[data-fstars]')!;
			const mag = card.querySelector<SVGTextElement>('[data-mag]')!;
			scene(card, 7, (x) => {
				const u = ease(Math.min(1, x / 0.85));
				// the magnification grows evenly on a logarithmic scale: 1, 3, 10, 30 times
				const m = Math.pow(30, u);
				mag.textContent = `увеличение ${Math.round(m)}×`;
				stars.style.opacity = String(ease(Math.min(1, Math.max(0, (u - 0.12) / 0.7))));
				haze.style.opacity = String(0.42 * (1 - 0.8 * u));
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="balloon"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const balloon = $<SVGCircleElement>('[data-balloon]');
			const knot = $<SVGPathElement>('[data-knot]');
			const circles = [...card.querySelectorAll<SVGCircleElement>('[data-dots] circle')];
			const lnear = $<SVGLineElement>('[data-lnear]');
			const lfar = $<SVGLineElement>('[data-lfar]');
			const near = $<SVGTextElement>('[data-near]');
			const far = $<SVGTextElement>('[data-far]');
			const gain = $<SVGTextElement>('[data-gain]');
			const DOTS = [[0.4, -0.5], [0.8, 2.5], [0.55, 1.3], [0.7, -1.9], [0.95, 0.35], [1.05, -2.9], [0.9, -1.05], [1.15, 1.75], [0.3, 3.4], [1.2, -0.25]];
			const CX = 118;
			const CY = 112;
			const PX = 9.2; // px per centimeter
			scene(card, 7, (x) => {
				const R = 5 + 5 * ease(x); // the radius of the balloon, см
				const r = R * PX;
				balloon.setAttribute('r', r.toFixed(1));
				const by = CY + r;
				knot.setAttribute('d', `M${CX - 4} ${(by - 1).toFixed(1)} L${CX + 4} ${(by - 1).toFixed(1)} L${CX + 6} ${(by + 9).toFixed(1)} L${CX - 6} ${(by + 9).toFixed(1)} Z`);
				DOTS.forEach(([th, ph], i) => {
					const px = CX + r * Math.sin(th) * Math.cos(ph);
					const py = CY + r * Math.sin(th) * Math.sin(ph);
					circles[i].setAttribute('cx', px.toFixed(1));
					circles[i].setAttribute('cy', py.toFixed(1));
					const line = i === 0 ? lnear : i === 1 ? lfar : null;
					if (line) {
						line.setAttribute('x1', String(CX));
						line.setAttribute('y1', String(CY));
						line.setAttribute('x2', px.toFixed(1));
						line.setAttribute('y2', py.toFixed(1));
					}
				});
				// distances along the rubber: the arc is the radius times the angle
				const sn = R * DOTS[0][0];
				const sf = R * DOTS[1][0];
				near.textContent = `${ru(sn)} см`;
				far.textContent = `${ru(sf)} см`;
				gain.textContent = x >= 1 ? 'выросли на 2 см и на 4 см' : '';
			});
		}
	}
</script>
