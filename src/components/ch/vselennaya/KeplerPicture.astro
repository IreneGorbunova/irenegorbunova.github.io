---
/**
 * Picture to Kepler's first law and the definitions of perihelion, aphelion and the semi-major axis: an ellipse
 * (a = 120 px, e = 0,6, more elongated than any planet's orbit, as on school schemes) with the Sun in one focus.
 * A planet moves along it by Kepler's equation (M = E − e·sin E, one revolution in 8 s), so it is fast near the
 * perihelion and slow near the aphelion; the line Sun — planet is drawn.
 */
import VsPicStyles from './VsPicStyles.astro';

const A = 120;
const E = 0.6;
const B = A * Math.sqrt(1 - E * E);
const C = A * E;
const CX = 184;
const CY = 126;
const F1 = CX - C;
const F2 = CX + C;
const uid = Math.random().toString(36).slice(2, 8);
const mk = `vkp-${uid}`;
---

<VsPicStyles />
<figure class="vs-pic vs-pic--one not-content" data-vkp>
	<div class="vs-pic__grid">
		<svg class="vs-pic__svg" viewBox="0 0 360 256" role="img" aria-label="Орбита планеты — эллипс, Солнце в одном из его фокусов. Ближайшая к Солнцу точка орбиты — перигелий, самая далёкая — афелий. Половина длинной оси эллипса — большая полуось a. Планета движется быстрее у перигелия и медленнее у афелия">
			<defs>
				<marker id={mk} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
					<path class="vs-dimhead" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<ellipse class="vs-orbit vkp-orbit" cx={CX} cy={CY} rx={A} ry={B}></ellipse>
			<line class="vs-line vs-orbit--dash" x1={CX - A} y1={CY} x2={CX + A} y2={CY}></line>
			<!-- the semi-major axis -->
			<line class="vs-dim" x1={CX + 2} y1={CY + 14} x2={CX + A - 2} y2={CY + 14} marker-start={`url(#${mk})`} marker-end={`url(#${mk})`}></line>
			<text class="vs-t-sun vs-t-math" x={CX + A / 2} y={CY + 30} text-anchor="middle">a</text>
			<text x={CX + A / 2} y={CY + 46} text-anchor="middle">большая полуось</text>
			<line class="vkp-rv" data-rv x1={F1} y1={CY}></line>
			<circle class="vs-sun-glow" cx={F1} cy={CY} r="13"></circle>
			<circle class="vs-sun" cx={F1} cy={CY} r="8"></circle>
			<circle class="vkp-focus" cx={F2} cy={CY} r="2.6"></circle>
			<circle class="vkp-planet" data-planet r="5.5"></circle>
			<text class="vs-t-sun" x={F1 + 4} y={CY - 16} text-anchor="middle">Солнце</text>
			<text x={F2} y={CY - 10} text-anchor="middle">второй фокус</text>
			<circle class="vkp-vertex" cx={CX - A} cy={CY} r="2.6"></circle>
			<circle class="vkp-vertex" cx={CX + A} cy={CY} r="2.6"></circle>
			<text x={CX - A + 2} y={CY + B + 22} text-anchor="start">перигелий</text>
			<line class="vs-line" x1={CX - A + 14} y1={CY + B + 10} x2={CX - A + 1} y2={CY + 6}></line>
			<text x={CX + A - 2} y={CY + B + 22} text-anchor="end">афелий</text>
			<line class="vs-line" x1={CX + A - 16} y1={CY + B + 10} x2={CX + A - 1} y2={CY + 6}></line>
			<text class="vs-title" x="180" y="18" text-anchor="middle">Орбита планеты — эллипс</text>
		</svg>
	</div>
	<div class="vs-pic__foot">
		<figcaption>
			Эллипс вытянут сильнее, чем орбита любой планеты: так его рисуют на схемах. Планета движется по законам Кеплера&nbsp;— у перигелия быстрее, у афелия медленнее.
		</figcaption>
	</div>
</figure>

<style is:global>
	.vkp-orbit {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	.vkp-rv {
		stroke: color-mix(in srgb, var(--ig-vx) 70%, transparent);
		stroke-width: 1.4;
	}
	.vkp-planet {
		fill: var(--ig-vx);
	}
	.vkp-focus,
	.vkp-vertex {
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	for (const root of document.querySelectorAll<HTMLElement>('[data-vkp]')) {
		const planet = root.querySelector<SVGCircleElement>('[data-planet]')!;
		const rv = root.querySelector<SVGLineElement>('[data-rv]')!;
		const A = 120;
		const E = 0.6;
		const B = A * Math.sqrt(1 - E * E);
		const CX = 184;
		const CY = 126;
		const PERIOD = 8; // s per revolution
		let t = 0;
		loop(root, (dt) => {
			t = (t + dt) % PERIOD;
			const M = (2 * Math.PI * t) / PERIOD;
			let En = M;
			for (let i = 0; i < 30; i++) En -= (En - E * Math.sin(En) - M) / (1 - E * Math.cos(En));
			// perihelion at the left vertex (next to the Sun), counterclockwise on the screen
			const x = CX - A * Math.cos(En);
			const y = CY + B * Math.sin(En);
			planet.setAttribute('cx', x.toFixed(1));
			planet.setAttribute('cy', y.toFixed(1));
			rv.setAttribute('x2', x.toFixed(1));
			rv.setAttribute('y2', y.toFixed(1));
			return true;
		});
	}
</script>
