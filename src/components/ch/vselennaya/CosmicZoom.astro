---
/**
 * «От человека до края Вселенной»: a continuous zoom through the scales of the Universe.
 * The frame width is 10^lg metres; inside a frame every size and distance is true to scale
 * (the Earth, the Moon's orbit, the planets' orbits, the nearest stars, the Galaxy, the Local Group,
 * the observable Universe). The zoom itself is logarithmic. Positions in the plane are real distances
 * in chosen directions; crowds of stars and the cosmic web are drawn schematically (too many to draw).
 */
const LEVELS = [
	{ lg: 0.6, name: 'Человек' },
	{ lg: 7.3, name: 'Земля' },
	{ lg: 9.05, name: 'Земля и Луна' },
	{ lg: 13.0, name: 'Солнечная система' },
	{ lg: 17.6, name: 'Ближайшие звёзды' },
	{ lg: 21.1, name: 'Галактика' },
	{ lg: 23.0, name: 'Местная группа' },
	{ lg: 27.0, name: 'Вселенная' },
];
---

<figure class="vz not-content" data-vz>
	<div class="vz__stage">
		<canvas class="vz__canvas" aria-label="Масштабы Вселенной: от человека до наблюдаемой Вселенной"></canvas>
		<div class="vz__hud">
			<p class="vz__title" data-title>Человек</p>
			<p class="vz__sub" data-sub></p>
		</div>
		<div class="vz__bar" aria-hidden="true">
			<span class="vz__bar-line" data-bar-line></span>
			<span class="vz__bar-text" data-bar-text></span>
		</div>
		<p class="vz__light" data-light aria-live="polite"></p>
	</div>

	<div class="vz__controls">
		<label class="vz__slider">
			<span class="vz__slider-name">Ширина кадра: <output data-width>2 м</output></span>
			<input type="range" min="0.3" max="27.2" step="0.01" value="0.6" data-lg aria-label="Масштаб" />
		</label>
		<div class="vz__levels" role="group" aria-label="Уровни">
			{
				LEVELS.map((l) => (
					<button type="button" class="vz__chip" data-level={l.lg}>
						{l.name}
					</button>
				))
			}
		</div>
		<div class="vz__buttons">
			<button type="button" class="vz__btn vz__btn--primary" data-fly>Полёт до края Вселенной</button>
			<button type="button" class="vz__btn" data-home>К человеку</button>
		</div>
	</div>

	<figcaption class="vz__caption">
		Внутри каждого кадра все размеры и расстояния настоящие, в одном масштабе. Сам переход между кадрами —
		логарифмический: каждое деление ползунка увеличивает ширину кадра в 10 раз. Планеты и звёзды, которые
		меньше пикселя, показаны точками; направления на плоскости выбраны условно, а скопления звёзд и галактик
		нарисованы схематично — их слишком много, чтобы нарисовать каждую.
	</figcaption>
</figure>

<style is:global>
