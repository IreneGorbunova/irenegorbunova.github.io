---
/**
 * Annual parallax: the Earth goes round the Sun, and a nearby star shifts against the far stars.
 * Left: the scheme (the angle is hugely exaggerated — a real parallax is under one second of arc).
 * Right: what a telescope sees — the near star swinging in front of the background, the swing ∝ 1/d.
 * The numbers are real: p = 1/d (arcseconds, parsecs).
 */
const presets = [
	{ name: 'Проксима Центавра', p: 0.768 },
	{ name: 'Сириус', p: 0.379 },
	{ name: 'Вега', p: 0.13 },
	{ name: 'Арктур', p: 0.089 },
	{ name: 'Полярная', p: 0.0075 },
];
---

<figure class="vp not-content" data-vp>
	<div class="vp__grid">
		<svg class="vp__scheme" viewBox="0 0 360 300" role="img" aria-label="Схема годичного параллакса">
			<g class="vp__bg">
				{
					[
						[30, 24],
						[80, 14],
						[130, 30],
						[200, 12],
						[250, 28],
						[300, 16],
						[340, 30],
						[55, 40],
						[160, 44],
						[280, 42],
					].map(([x, y]) => <circle cx={x} cy={y} r="1.3" />)
				}
			</g>
			<text class="vp__t" x="180" y="60" text-anchor="middle">далёкие звёзды</text>
			<!-- the near star -->
			<g data-star>
				<circle class="vp__near-glow" cx="180" cy="110" r="9" />
				<circle class="vp__near" cx="180" cy="110" r="3.5" />
			</g>
			<text class="vp__t" x="194" y="106">звезда</text>
			<!-- lines of sight -->
			<line class="vp__ray" data-ray-a x1="110" y1="245" x2="180" y2="110" />
			<line class="vp__ray" data-ray-b x1="250" y1="245" x2="180" y2="110" />
			<path class="vp__angle" data-angle d="" />
			<text class="vp__t vp__t--p" data-p-label x="180" y="146" text-anchor="middle"><tspan font-style="italic">p</tspan></text>
			<!-- orbit (seen almost edge-on) -->
			<ellipse class="vp__orbit" cx="180" cy="245" rx="70" ry="14" />
			<circle class="vp__sun" cx="180" cy="245" r="7" />
			<text class="vp__t" x="180" y="272" text-anchor="middle">Солнце</text>
			<g data-earth>
				<circle class="vp__earth" cx="110" cy="245" r="4" />
			</g>
			<text class="vp__t" x="100" y="232" text-anchor="end">Земля</text>
			<line class="vp__au" x1="110" y1="286" x2="180" y2="286" />
			<text class="vp__t" x="145" y="297" text-anchor="middle">1 а.е.</text>
		</svg>
		<div class="vp__view">
			<svg class="vp__tele" viewBox="0 0 300 300" role="img" aria-label="Вид в телескоп: звезда смещается на фоне далёких звёзд">
				<circle class="vp__field" cx="150" cy="150" r="140" />
				<g class="vp__bg">
					{
						[
							[60, 80, 1.6],
							[110, 50, 1.1],
							[200, 70, 1.4],
							[240, 120, 1.0],
							[90, 200, 1.3],
							[210, 220, 1.8],
							[150, 250, 1.0],
							[70, 140, 1.0],
							[250, 190, 1.2],
							[130, 100, 0.9],
							[180, 180, 1.1],
						].map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)
					}
				</g>
				<line class="vp__track" data-track x1="150" y1="150" x2="150" y2="150" />
				<g data-tele-star>
					<circle class="vp__near-glow" cx="150" cy="150" r="12" />
					<circle class="vp__near" cx="150" cy="150" r="4.5" />
				</g>
				<text class="vp__t" x="150" y="290" text-anchor="middle" data-scale-note></text>
			</svg>
			<p class="vp__view-title">Вид в телескоп за год</p>
		</div>
	</div>
	<div class="vp__controls">
		<label class="vp__slider">
			<span class="vp__slider-name">Расстояние до звезды: <output data-d-out></output></span>
			<input type="range" min="0" max="2.2" step="0.01" value="0.115" data-d aria-label="Расстояние до звезды" />
		</label>
		<div class="vp__chips" role="group" aria-label="Примеры звёзд">
			{
				presets.map((s) => (
					<button type="button" class="vp__chip" data-p={s.p}>
						{s.name}
					</button>
				))
			}
		</div>
	</div>
	<p class="vp__calc" data-calc aria-live="polite"></p>
	<figcaption class="vp__caption">
		Углы на схеме увеличены во много раз: даже у ближайшей звезды параллакс меньше секунды дуги — под таким углом
		видна монета диаметром 2 см с расстояния 4 км. Смещение в «телескопе» тоже увеличено (во сколько — написано
		под звездой), но его зависимость от расстояния настоящая: вдвое дальше — вдвое меньше.
	</figcaption>
</figure>

<style is:global>
	.vp {
		margin-block: 2rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vp i {
		font-family: var(--ig-font-math);
	}
	.vp__grid {
		display: grid;
		grid-template-columns: 6fr 5fr;
		gap: 0.75rem;
		align-items: start;
	}
	.vp__scheme,
	.vp__tele {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		background: #02030a;
	}
	.vp__view-title {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.vp__bg circle {
		fill: rgb(225 232 255 / 0.85);
	}
	.vp__field {
		fill: #04061a;
		stroke: rgb(180 195 255 / 0.3);
	}
	.vp__t {
		fill: rgb(235 238 255 / 0.9);
		font-size: 11px;
		font-family: var(--sl-font);
	}
	.vp__t--p {
		fill: #ffe9b0;
		font-size: 13px;
	}
	.vp__near {
		fill: #ffe9b0;
	}
	.vp__near-glow {
		fill: #ffe9b0;
		opacity: 0.22;
	}
	.vp__ray {
		stroke: rgb(255 233 176 / 0.6);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.vp__angle {
		fill: none;
		stroke: #ffe9b0;
		stroke-width: 1.5;
	}
	.vp__orbit {
		fill: none;
		stroke: rgb(180 195 255 / 0.5);
		stroke-width: 1;
	}
	.vp__sun {
		fill: #ffd56b;
	}
	.vp__earth {
		fill: #6fa8ff;
	}
	.vp__au {
		stroke: rgb(235 238 255 / 0.5);
		stroke-width: 1;
	}
	.vp__track {
		stroke: rgb(255 233 176 / 0.35);
		stroke-width: 1;
	}
	.vp__controls {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.vp__slider {
		display: grid;
		gap: 0.2rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.vp__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.vp__slider input {
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.vp__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.vp__chip {
		margin: 0;
		padding: 0.3rem 0.8rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.vp__chip:hover {
		border-color: var(--sl-color-accent);
	}
	.vp__chip[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.vp__calc {
		margin: 0.6rem 0 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.vp__calc b {
		color: var(--sl-color-white);
	}
	.vp__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.vp {
			padding: 0.5rem;
		}
		.vp__grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { fmt, reducedMotion, sig } from './util';

	for (const root of document.querySelectorAll<HTMLElement>('[data-vp]')) {
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const dIn = q<HTMLInputElement>('[data-d]');
		const dOut = q<HTMLOutputElement>('[data-d-out]');
		const calc = q<HTMLElement>('[data-calc]');
		const earth = q<SVGGElement>('[data-earth]');
		const rayA = q<SVGLineElement>('[data-ray-a]');
		const rayB = q<SVGLineElement>('[data-ray-b]');
		const angle = q<SVGPathElement>('[data-angle]');
		const pLabel = q<SVGTextElement>('[data-p-label]');
		const star = q<SVGGElement>('[data-star]');
		const teleStar = q<SVGGElement>('[data-tele-star]');
		const track = q<SVGLineElement>('[data-track]');
		const note = q<SVGTextElement>('[data-scale-note]');
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-p]'));
		const still = reducedMotion();

		const SX = 180; // the Sun on the scheme
		const SY = 245;
		const RX = 70; // the orbit, seen almost edge-on
		const RY = 14;
		// the star on the scheme sits at a height that shrinks with distance (the scheme is not to scale)
		const starY = (d: number) => 150 - 40 * Math.log10(d * 3);
		let phase = 0;
		let raf = 0;
		let last = 0;

		const dist = () => 10 ** Number(dIn.value); // parsecs
		const place = () => {
			const d = dist();
			const p = 1 / d; // arcseconds
			// Earth on its orbit
			const ex = SX + RX * Math.cos(phase);
			const ey = SY + RY * Math.sin(phase);
			earth.querySelector('circle')!.setAttribute('cx', String(ex));
			earth.querySelector('circle')!.setAttribute('cy', String(ey));
			const sy = Math.max(84, starY(d));
			star.querySelectorAll('circle').forEach((c) => c.setAttribute('cy', String(sy)));
			rayA.setAttribute('x1', String(ex));
			rayA.setAttribute('y1', String(ey));
			rayA.setAttribute('y2', String(sy));
			rayB.setAttribute('x1', String(SX));
			rayB.setAttribute('y1', String(SY));
			rayB.setAttribute('y2', String(sy));
			// the parallax angle at the star: between the direction to the Sun and to the Earth
			const a1 = Math.atan2(SY - sy, SX - 180);
			const a2 = Math.atan2(ey - sy, ex - 180);
			const r = 26;
			const large = Math.abs(a2 - a1) > Math.PI ? 1 : 0;
			const sweep = a2 > a1 ? 1 : 0;
			angle.setAttribute('d', `M ${180 + r * Math.cos(a1)} ${sy + r * Math.sin(a1)} A ${r} ${r} 0 ${large} ${sweep} ${180 + r * Math.cos(a2)} ${sy + r * Math.sin(a2)}`);
			pLabel.setAttribute('y', String(sy + 40));
			pLabel.setAttribute('x', String(180 + 16 * Math.cos((a1 + a2) / 2)));
			// telescope view: the shift is ∝ p; 1 arcsecond = 120 px of swing (the exaggeration is stated)
			const K = 120;
			const dx = -K * p * Math.cos(phase);
			const dy = -K * p * Math.sin(phase) * 0.35;
			teleStar.querySelectorAll('circle').forEach((c) => {
				c.setAttribute('cx', String(150 + dx));
				c.setAttribute('cy', String(150 + dy));
			});
			track.setAttribute('x1', String(150 - K * p));
			track.setAttribute('x2', String(150 + K * p));
			note.textContent = 'смещение увеличено примерно в 3000 раз';
		};
		const update = () => {
			const d = dist();
			const p = 1 / d;
			dOut.value = `${d < 10 ? fmt(d, 2) : fmt(d, 0)} пк = ${d * 3.26 < 10 ? fmt(d * 3.26, 1) : fmt(d * 3.26, 0)} св. лет`;
			calc.innerHTML = `Параллакс <b><i>p</i> = 1/<i>d</i> = ${p >= 0.01 ? fmt(p, 3) : sig(p, 2)}″</b>${p < 0.05 ? ' — такой угол с Земли измерить трудно, зато из космоса (телескоп Gaia) измеряют и в тысячу раз меньшие.' : p < 0.3 ? ' — его уверенно измеряют с Земли.' : ' — это один из самых больших параллаксов на небе.'} Расстояние <b><i>d</i> = 1/<i>p</i> = ${d < 10 ? fmt(d, 2) : fmt(d, 0)} пк</b>; свет идёт от звезды ${d * 3.26 < 10 ? fmt(d * 3.26, 1) : fmt(d * 3.26, 0)} ${d * 3.26 < 5 && d * 3.26 >= 2 ? 'года' : 'лет'}.`;
			for (const c of chips) c.setAttribute('aria-pressed', String(Math.abs(Math.log10(1 / Number(c.dataset.p)) - Number(dIn.value)) < 0.012));
			place();
		};
		const frame = (now: number) => {
			const dt = Math.min((now - last) / 1000, 0.1);
			last = now;
			phase += dt * 0.9; // one year in about 7 s
			place();
			raf = requestAnimationFrame(frame);
		};
		dIn.addEventListener('input', update);
		for (const c of chips)
			c.addEventListener('click', () => {
				dIn.value = Math.log10(1 / Number(c.dataset.p)).toFixed(3);
				update();
			});
		// without animation the reader drags the Earth round by hand
		root.querySelector('.vp__scheme')!.addEventListener('pointermove', (e) => {
			if (!still.matches) return;
			const svg = e.currentTarget as SVGSVGElement;
			const rect = svg.getBoundingClientRect();
			const x = (((e as PointerEvent).clientX - rect.left) / rect.width) * 360;
			phase = Math.acos(Math.max(-1, Math.min(1, (x - SX) / RX)));
			place();
		});
		update();
		if (!still.matches) {
			last = performance.now();
			raf = requestAnimationFrame(frame);
			new IntersectionObserver((entries) => {
				for (const en of entries) {
					if (en.isIntersecting) {
						cancelAnimationFrame(raf);
						last = performance.now();
						raf = requestAnimationFrame(frame);
					} else cancelAnimationFrame(raf);
				}
			}).observe(root);
		}
	}
</script>
