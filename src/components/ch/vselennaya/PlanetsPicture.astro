---
/**
 * Picture to the definitions of the planets of the terrestrial group and of the giant planets: the edge of the Sun
 * and the eight planets with their true mean radii in one scale, S = 4 px per Earth radius (R/R⊕: Mercury 0,383,
 * Venus 0,950, Earth 1, Mars 0,532, Jupiter 10,97, Saturn 9,14, Uranus 3,98, Neptune 3,86; the Sun 109). Saturn's
 * main rings reach 136 775 km = 21,5 R⊕ (the inner edge of ring C 74 490 km = 11,7 R⊕), drawn tilted by 27°.
 * Distances between the bodies are not to scale (said in the caption).
 */
import VsPicStyles from './VsPicStyles.astro';

const S = 4;
const uid = Math.random().toString(36).slice(2, 8);
const clipFront = `vpp-front-${uid}`;
const clipSun = `vpp-sun-${uid}`;
const Y1 = 58;
const Y2 = 198;
const SUN_R = 109 * S;
const inner = [
	{ name: 'Меркурий', r: 0.383, x: 92, cls: 'vpp-mercury' },
	{ name: 'Венера', r: 0.95, x: 152, cls: 'vpp-venus' },
	{ name: 'Земля', r: 1, x: 212, cls: 'vpp-earth' },
	{ name: 'Марс', r: 0.532, x: 272, cls: 'vpp-mars' },
];
const J = { r: 10.97 * S, x: 6 + 10.97 * S };
const ringOut = 21.47 * S;
const ringIn = 11.7 * S;
const tilt = Math.sin((27 * Math.PI) / 180);
const Sat = { r: 9.14 * S, x: J.x + J.r + 6 + ringOut };
const U = { r: 3.98 * S, x: Sat.x + ringOut + 8 + 3.98 * S };
const N = { r: 3.86 * S, x: U.x + U.r + 7 + 3.86 * S };
const ring = (cx: number, cy: number) =>
	`M${cx - ringOut} ${cy} A${ringOut} ${ringOut * tilt} 0 1 0 ${cx + ringOut} ${cy} A${ringOut} ${ringOut * tilt} 0 1 0 ${cx - ringOut} ${cy} Z ` +
	`M${cx - ringIn} ${cy} A${ringIn} ${ringIn * tilt} 0 1 1 ${cx + ringIn} ${cy} A${ringIn} ${ringIn * tilt} 0 1 1 ${cx - ringIn} ${cy} Z`;
const r1 = (v: number) => Math.round(v * 10) / 10;
---

<VsPicStyles />
<figure class="vs-pic vs-pic--one not-content">
	<div class="vs-pic__grid">
		<svg class="vs-pic__svg" viewBox="0 0 360 268" role="img" aria-label="Край Солнца и восемь планет в одном масштабе. Планеты земной группы — Меркурий, Венера, Земля, Марс — маленькие. Планеты-гиганты — Юпитер, Сатурн с кольцами, Уран, Нептун — в несколько раз и в десятки раз больше Земли">
			<defs>
				<clipPath id={clipFront}>
					<rect x="0" y={Y2} width="360" height="80"></rect>
				</clipPath>
				<clipPath id={clipSun}>
					<rect x="0" y="0" width="60" height={Y1 + 44}></rect>
				</clipPath>
			</defs>
			<!-- row 1: the edge of the Sun and the terrestrial planets -->
			<text class="vs-title" x="186" y="18" text-anchor="middle">Планеты земной группы</text>
			<circle class="vs-sun" cx={40 - SUN_R} cy={Y1} r={SUN_R} clip-path={`url(#${clipSun})`}></circle>
			<text class="vpp-sun-text" x="3" y={Y1 - 30}>край</text>
			<text class="vpp-sun-text" x="3" y={Y1 - 16}>Солнца</text>
			{
				inner.map((p) => (
					<>
						<circle class={p.cls} cx={p.x} cy={Y1} r={r1(p.r * S)} />
						<text x={p.x} y={Y1 + 24} text-anchor="middle">
							{p.name}
						</text>
					</>
				))
			}
			<path class="vs-bracket" d={`M74 ${Y1 + 36} v6 H290 v-6`}></path>
			<text x="182" y={Y1 + 56} text-anchor="middle">малые, плотные, с твёрдой поверхностью</text>
			<!-- row 2: the giants -->
			<text class="vs-title" x="180" y={Y2 - 58} text-anchor="middle">Планеты-гиганты</text>
			<circle class="vpp-jupiter" cx={r1(J.x)} cy={Y2} r={r1(J.r)}></circle>
			<path class="vpp-band" d={`M${r1(J.x - J.r * 0.95)} ${Y2 - 10} Q${r1(J.x)} ${Y2 - 7} ${r1(J.x + J.r * 0.95)} ${Y2 - 10}`}></path>
			<path class="vpp-band" d={`M${r1(J.x - J.r * 0.98)} ${Y2 + 6} Q${r1(J.x)} ${Y2 + 9} ${r1(J.x + J.r * 0.98)} ${Y2 + 6}`}></path>
			<ellipse class="vpp-spot" cx={r1(J.x + 14)} cy={Y2 + 18} rx="6" ry="3.5"></ellipse>
			<path class="vpp-ring" d={ring(r1(Sat.x), Y2)} fill-rule="evenodd"></path>
			<circle class="vpp-saturn" cx={r1(Sat.x)} cy={Y2} r={r1(Sat.r)}></circle>
			<path class="vpp-ring" d={ring(r1(Sat.x), Y2)} fill-rule="evenodd" clip-path={`url(#${clipFront})`}></path>
			<circle class="vpp-uranus" cx={r1(U.x)} cy={Y2} r={r1(U.r)}></circle>
			<circle class="vpp-neptune" cx={r1(N.x)} cy={Y2} r={r1(N.r)}></circle>
			<text x={r1(J.x)} y={Y2 + 62} text-anchor="middle">Юпитер</text>
			<text x={r1(Sat.x)} y={Y2 + 62} text-anchor="middle">Сатурн</text>
			<text x={r1(U.x)} y={Y2 + 38} text-anchor="middle">Уран</text>
			<text x={r1(N.x) - 4} y={Y2 + 62} text-anchor="middle">Нептун</text>
		</svg>
	</div>
	<div class="vs-pic__foot">
		<figcaption>
			Размеры Солнца и планет&nbsp;— в одном масштабе, расстояния между ними&nbsp;— нет. Земля в 109&nbsp;раз меньше Солнца по диаметру и в 11&nbsp;раз меньше Юпитера.
		</figcaption>
	</div>
</figure>

<style is:global>
	.vs-pic .vpp-sun-text {
		font-size: 10px;
		font-weight: 600;
		fill: var(--sl-color-black);
		stroke: none;
	}
	.vpp-mercury {
		fill: var(--sl-color-gray-3);
	}
	.vpp-venus {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-2));
	}
	.vpp-earth {
		fill: var(--ig-vx);
	}
	.vpp-mars {
		fill: var(--ig-vy);
	}
	.vpp-jupiter {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-3));
	}
	.vpp-band {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vy) 45%, var(--sl-color-gray-3));
		stroke-width: 4;
		stroke-linecap: round;
		opacity: 0.8;
	}
	.vpp-spot {
		fill: color-mix(in srgb, var(--ig-vy) 70%, var(--sl-color-gray-3));
	}
	.vpp-saturn {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-2));
	}
	.vpp-ring {
		fill: color-mix(in srgb, var(--ig-v) 25%, var(--sl-color-gray-3));
		opacity: 0.85;
	}
	.vpp-uranus {
		fill: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-2));
	}
	.vpp-neptune {
		fill: color-mix(in srgb, var(--ig-vx) 80%, var(--sl-color-gray-4));
	}
</style>
