---
/**
 * Two short looping opening scenes of «Солнечная система. Звёзды. Галактики». No terms of the chapter in the
 * pictures; the captions' popovers explain.
 * Light: the light of the Sun crosses 150 million km to the Earth. The front moves at a constant speed, and the
 *   clock shows the real travel time: 1,496·10¹¹ м / 2,998·10⁸ м/с = 499 с = 8 мин 19 с at the end. The sizes of
 *   the Sun and the Earth are not to scale (said in the picture).
 * Mars: Mars against the stars for 200 days around an opposition. The top view (left) shows the Earth and Mars on
 *   circular orbits (radii 1 and 1,524 а.е., periods 365,26 and 686,98 days) and the line of sight; the sky window
 *   (right) shows where Mars is seen among the stars: ecliptic longitude and latitude, the same scale on both axes,
 *   east on the left as on a sky facing south. Mars's orbit is tilted by 1,85°; its node is 90° from the
 *   opposition, so the latitude peaks at the opposition and the path closes into a loop (retrograde arc ≈ 15°).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const clipSky = `vi-sky-${uid}`;
const clipSun = `vi-sun-${uid}`;
// fixed pseudo-random stars
let seed = 17;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const spaceStars = Array.from({ length: 40 }, () => [Math.round(rnd() * 3600) / 10, Math.round(rnd() * 2400) / 10, rnd() < 0.2 ? 1.3 : 0.8]);
const SKY = { x: 158, y: 30, w: 196, h: 176 };
const skyStars = Array.from({ length: 46 }, () => [
	Math.round((SKY.x + 4 + rnd() * (SKY.w - 8)) * 10) / 10,
	Math.round((SKY.y + 4 + rnd() * (SKY.h - 8)) * 10) / 10,
	rnd() < 0.15 ? 1.6 : rnd() < 0.5 ? 1.1 : 0.8,
]);
---

<IntroFrame data-vselintro>
	<div class="intro__card" data-scene="light">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Свет выходит от Солнца и летит к Земле 150 миллионов километров. Часы показывают время в пути: 8 минут 19 секунд">
			<defs>
				<clipPath id={clipSun}>
					<rect x="0" y="0" width="360" height="240"></rect>
				</clipPath>
			</defs>
			<rect class="vi-space" x="0" y="0" width="360" height="240"></rect>
			{spaceStars.map(([x, y, r]) => <circle class="vi-fstar" cx={x} cy={y} r={r} />)}
			<!-- the light that has already left the Sun -->
			<path class="vi-lit" data-lit></path>
			<path class="vi-front" data-front></path>
			<g clip-path={`url(#${clipSun})`}>
				<circle class="vi-sun-glow" cx="-40" cy="120" r="96"></circle>
				<circle class="vi-sun" cx="-40" cy="120" r="82"></circle>
			</g>
			<text class="vi-label vi-label--sun" x="4" y="124">Солнце</text>
			<!-- the Earth: day side to the Sun -->
			<circle class="vi-earth" cx="320" cy="120" r="11"></circle>
			<path class="vi-night" d="M320 109 A11 11 0 0 1 320 131 Z"></path>
			<circle class="vi-earth-lit" data-earthlit cx="320" cy="120" r="15"></circle>
			<text class="vi-label" x="320" y="150" text-anchor="middle">Земля</text>
			<!-- the distance -->
			<line class="vi-dim" x1="48" y1="188" x2="306" y2="188"></line>
			<path class="vi-dimhead" d="M44 188 l8 -4 v8 z M310 188 l-8 -4 v8 z"></path>
			<text class="vi-label" x="177" y="182" text-anchor="middle">150 млн км</text>
			<text class="vi-small" x="352" y="232" text-anchor="end">размеры не в масштабе</text>
			<!-- the clock -->
			<rect class="vi-pill" x="112" y="10" width="136" height="26" rx="13"></rect>
			<text class="vi-read" x="180" y="28" text-anchor="middle" data-clock>0 мин 00 с</text>
		</svg>
		<div class="intro__foot">
			<p>Свет летит от Солнца до Земли 150&nbsp;млн&nbsp;км больше восьми минут. Поэтому мы видим Солнце таким, каким оно было <More term="8 минут назад">Свет летит со скоростью <a href="../../../8-klass/svetovye-yavleniya/istochniki-sveta/#скорость-света">300&nbsp;000&nbsp;км/с</a>, и путь от Солнца занимает 499&nbsp;с&nbsp;— 8&nbsp;мин 19&nbsp;с. Свет ближайшей звезды, Проксимы Центавра, летит к нам 4,2&nbsp;года, Веги&nbsp;— 25&nbsp;лет, а туманного пятнышка в созвездии Андромеды, другой звёздной системы,&nbsp;— 2,5&nbsp;млн лет. Глядя на небо, мы смотрим в прошлое. Подробнее&nbsp;— в разделе <a href="#единицы-расстояний">«Единицы расстояний»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="mars">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Слева вид сверху: Земля и Марс обращаются вокруг Солнца, Земля обгоняет Марс. Справа — небо: Марс смещается среди звёзд, останавливается, идёт назад, описывает петлю и снова идёт вперёд">
			<defs>
				<clipPath id={clipSky}>
					<rect x={SKY.x} y={SKY.y} width={SKY.w} height={SKY.h} rx="8"></rect>
				</clipPath>
			</defs>
			<!-- top view -->
			<text class="vi-label vi-label--title" x="78" y="24" text-anchor="middle">вид сверху</text>
			<circle class="vi-orbit" cx="78" cy="124" r="34"></circle>
			<circle class="vi-orbit" cx="78" cy="124" r="51.8"></circle>
			<line class="vi-sight" data-sight></line>
			<circle class="vi-sun" cx="78" cy="124" r="6"></circle>
			<circle class="vi-earth" data-e r="4"></circle>
			<circle class="vi-mars" data-m r="3.4"></circle>
			<circle class="vi-sun" cx="8" cy="194" r="4"></circle>
			<text class="vi-label" x="15" y="198">Солнце</text>
			<circle class="vi-earth" cx="64" cy="194" r="3.5"></circle>
			<text class="vi-label vi-label--e" x="70" y="198">Земля</text>
			<circle class="vi-mars" cx="111" cy="194" r="3"></circle>
			<text class="vi-label vi-label--m" x="117" y="198">Марс</text>
			<!-- the sky -->
			<text class="vi-label vi-label--title" x={SKY.x + SKY.w / 2} y="24" text-anchor="middle">Марс на небе среди звёзд</text>
			<rect class="vi-skybox" x={SKY.x} y={SKY.y} width={SKY.w} height={SKY.h} rx="8"></rect>
			<g clip-path={`url(#${clipSky})`}>
				{skyStars.map(([x, y, r]) => <circle class="vi-sstar" cx={x} cy={y} r={r} />)}
				<path class="vi-trail" data-trail></path>
				<g data-ticks></g>
				<circle class="vi-mars vi-mars--sky" data-sm r="3"></circle>
			</g>
			<text class="vi-small" x={SKY.x + 6} y={SKY.y + SKY.h + 14}>← восток</text>
			<text class="vi-small" x={SKY.x + SKY.w - 6} y={SKY.y + SKY.h + 14} text-anchor="end">запад →</text>
			<text class="vi-read vi-read--days" x="78" y="226" text-anchor="middle" data-days></text>
		</svg>
		<div class="intro__foot">
			<p>Марс обычно смещается среди звёзд с запада на восток. Но раз в два с небольшим года он останавливается, <More term="пятится назад и описывает петлю">Земля и Марс обращаются вокруг Солнца, и Земля&nbsp;— быстрее. Когда она обгоняет Марс, направление на него поворачивается назад, и на фоне далёких звёзд Марс будто пятится&nbsp;— как медленная машина, которую обгоняют на шоссе. Петлю, а не отрезок, он рисует потому, что его орбита немного наклонена к земной. Так объяснил петли планет Коперник&nbsp;— подробнее в разделе <a href="#кто-это-открыл">«Кто это открыл»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.vi-space {
		fill: color-mix(in srgb, var(--sl-color-gray-6, var(--sl-color-black)) 60%, transparent);
	}
	.vi-fstar,
	.vi-sstar {
		fill: var(--sl-color-gray-3);
	}
	.vi-sun {
		fill: var(--ig-v);
	}
	.vi-sun-glow {
		fill: color-mix(in srgb, var(--ig-v) 25%, transparent);
	}
	.vi-lit {
		fill: color-mix(in srgb, var(--ig-v) 12%, transparent);
	}
	.vi-front {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.vi-earth {
		fill: var(--ig-vx);
	}
	.vi-night {
		fill: color-mix(in srgb, var(--sl-color-black) 55%, transparent);
	}
	.vi-earth-lit {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2;
		opacity: 0;
	}
	.vi-mars {
		fill: var(--ig-vy);
	}
	.vi-orbit {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.vi-sight {
		stroke: var(--ig-vy);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.vi-skybox {
		fill: color-mix(in srgb, var(--sl-color-gray-6, var(--sl-color-black)) 70%, transparent);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.vi-trail {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vy) 70%, transparent);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.vi-tick {
		fill: var(--ig-vy);
		opacity: 0.55;
	}
	.vi-dim {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.vi-dimhead {
		fill: var(--sl-color-gray-3);
	}
	.vi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.intro .vi-read {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.intro .vi-read--days {
		font-size: 12px;
		font-weight: 600;
		fill: var(--sl-color-gray-2);
	}
	.intro .vi-read--days.is-back {
		fill: var(--ig-vy);
	}
	.intro .vi-label {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--ig-surface);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	.intro .vi-label--title {
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.intro .vi-label--sun {
		fill: var(--sl-color-black);
		stroke: none;
		font-weight: 600;
	}
	.intro .vi-label--e {
		fill: var(--ig-vx);
		font-weight: 600;
	}
	.intro .vi-label--m {
		fill: var(--ig-vy);
		font-weight: 600;
	}
	.intro .vi-small {
		font-size: 10.5px;
		fill: var(--sl-color-gray-3);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const AU = 1.496e11; // м
	const C = 2.998e8; // м/с
	const TRAVEL = AU / C; // 499 с

	for (const root of document.querySelectorAll<HTMLElement>('[data-vselintro]')) {
		// ---------- Light: 6 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="light"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const front = $<SVGPathElement>('[data-front]');
			const lit = $<SVGPathElement>('[data-lit]');
			const clock = $<SVGTextElement>('[data-clock]');
			const earthLit = $<SVGCircleElement>('[data-earthlit]');
			const SX = -40;
			const SY = 120;
			const R0 = 82; // the Sun's surface
			const R1 = 320 - 11 - SX; // the front touches the Earth
			const HALF = 0.42; // half-angle of the drawn beam, rad
			const arc = (r: number) => {
				const x0 = SX + r * Math.cos(HALF);
				const y0 = SY - r * Math.sin(HALF);
				const y1 = SY + r * Math.sin(HALF);
				return `M${x0.toFixed(1)} ${y0.toFixed(1)} A${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${x0.toFixed(1)} ${y1.toFixed(1)}`;
			};
			scene(card, 6, (x) => {
				// constant speed: the front's distance from the Sun grows linearly with time
				const r = R0 + (R1 - R0) * x;
				front.setAttribute('d', arc(r));
				front.style.opacity = x >= 1 ? '0' : '1';
				lit.setAttribute(
					'd',
					`M${SX} ${SY} L${(SX + r * Math.cos(HALF)).toFixed(1)} ${(SY - r * Math.sin(HALF)).toFixed(1)} A${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${(SX + r * Math.cos(HALF)).toFixed(1)} ${(SY + r * Math.sin(HALF)).toFixed(1)} Z`,
				);
				const s = Math.round(TRAVEL * x);
				clock.textContent = `${Math.floor(s / 60)} мин ${String(s % 60).padStart(2, '0')} с`;
				earthLit.style.opacity = x >= 1 ? '1' : '0';
			});
		}

		// ---------- Mars: 8 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="mars"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const eDot = $<SVGCircleElement>('[data-e]');
			const mDot = $<SVGCircleElement>('[data-m]');
			const sight = $<SVGLineElement>('[data-sight]');
			const sm = $<SVGCircleElement>('[data-sm]');
			const trail = $<SVGPathElement>('[data-trail]');
			const ticks = $<SVGGElement>('[data-ticks]');
			const days = $<SVGTextElement>('[data-days]');
			const OX = 78;
			const OY = 124;
			const RE = 34; // px per а.е. × 1
			const AM = 1.5237;
			const TE = 365.256;
			const TM = 686.98;
			const INC = (1.85 * Math.PI) / 180;
			const T0 = 100; // days before and after the opposition
			// heliocentric positions (а.е.), the opposition at t = 0 along +x; Mars's node at −90°
			const helio = (t: number) => {
				const lE = (2 * Math.PI * t) / TE;
				const lM = (2 * Math.PI * t) / TM;
				const u = lM + Math.PI / 2; // angle from the ascending node
				const xo = AM * Math.cos(u);
				const yo = AM * Math.sin(u);
				// rotate the orbit plane: node at −90°, inclination INC
				return {
					e: [Math.cos(lE), Math.sin(lE)],
					m: [yo * Math.cos(INC), -xo, yo * Math.sin(INC)],
				};
			};
			const geo = (t: number) => {
				const { e, m } = helio(t);
				const dx = m[0] - e[0];
				const dy = m[1] - e[1];
				const dz = m[2];
				return { lam: (Math.atan2(dy, dx) * 180) / Math.PI, beta: (Math.atan2(dz, Math.hypot(dx, dy)) * 180) / Math.PI, dist: Math.hypot(dx, dy, dz) };
			};
			// the sky window: the same scale on both axes, east (larger longitude) on the left
			const K = 7; // px per degree
			const CXs = 256;
			const BETA0 = 3.2; // latitude at the window's middle
			const CYs = 118;
			const skyXY = (lam: number, beta: number) => [CXs - lam * K, CYs - (beta - BETA0) * K];
			// a dot every 10 days along the path
			const tickDots: { t: number; c: SVGCircleElement }[] = [];
			for (let t = -T0; t <= T0; t += 10) {
				const g = geo(t);
				const [x, y] = skyXY(g.lam, g.beta);
				const c = document.createElementNS(NS, 'circle');
				c.setAttribute('class', 'vi-tick');
				c.setAttribute('cx', x.toFixed(1));
				c.setAttribute('cy', y.toFixed(1));
				c.setAttribute('r', '1.3');
				ticks.append(c);
				tickDots.push({ t, c });
			}
			scene(card, 8, (x) => {
				const t = -T0 + 2 * T0 * x;
				const { e, m } = helio(t);
				const ex = OX + RE * e[0];
				const ey = OY - RE * e[1];
				const mx = OX + RE * m[0];
				const my = OY - RE * m[1];
				eDot.setAttribute('cx', ex.toFixed(1));
				eDot.setAttribute('cy', ey.toFixed(1));
				mDot.setAttribute('cx', mx.toFixed(1));
				mDot.setAttribute('cy', my.toFixed(1));
				// the line of sight from the Earth through Mars
				const dx = mx - ex;
				const dy = my - ey;
				const d = Math.hypot(dx, dy);
				sight.setAttribute('x1', ex.toFixed(1));
				sight.setAttribute('y1', ey.toFixed(1));
				sight.setAttribute('x2', (mx + (dx / d) * 30).toFixed(1));
				sight.setAttribute('y2', (my + (dy / d) * 30).toFixed(1));
				// the sky: path so far and Mars, a little bigger when it is closer
				const pts: string[] = [];
				for (let s = -T0; s <= t + 1e-6; s += 1) {
					const g = geo(s);
					const [px, py] = skyXY(g.lam, g.beta);
					pts.push(`${pts.length ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`);
				}
				const g = geo(t);
				const [sx, sy] = skyXY(g.lam, g.beta);
				pts.push(`${pts.length ? 'L' : 'M'}${sx.toFixed(1)} ${sy.toFixed(1)}`);
				trail.setAttribute('d', pts.join(' '));
				sm.setAttribute('cx', sx.toFixed(1));
				sm.setAttribute('cy', sy.toFixed(1));
				sm.setAttribute('r', (2 + 1.6 * (0.524 / g.dist)).toFixed(2));
				for (const td of tickDots) td.c.style.opacity = td.t <= t ? '' : '0';
				// which way Mars goes among the stars now
				const back = geo(t + 0.5).lam < geo(t - 0.5).lam;
				days.textContent = back ? 'Марс пятится на запад' : 'Марс идёт на восток';
				days.classList.toggle('is-back', back);
			});
		}
	}
</script>
