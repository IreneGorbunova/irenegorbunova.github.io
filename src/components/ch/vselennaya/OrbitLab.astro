		font-family: var(--ig-font-math);
	}
	.vo__views,
	.vo__bodies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.vo__chip {
		margin: 0;
		padding: 0.3rem 0.8rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
