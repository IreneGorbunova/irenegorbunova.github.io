---
/**
 * A live Solar System obeying Kepler's laws. Orbits are the true ellipses (JPL J2000 elements), the Sun at a focus,
 * positions from Kepler's equation for the shown date (the model starts at today's date). The selected body shows
 * the sector swept in the last tenth of its period (equal areas), its distance and speed (vis-viva), and the
 * T–a diagram fills in as bodies complete a revolution. Equal axis scales; the Sun and the bodies are drawn larger
 * than life (at this scale even Jupiter would be a fraction of a pixel).
 */
import { BODIES } from './physics';

const views = [
	{ id: 'inner', name: 'Планеты земной группы', ids: ['mercury', 'venus', 'earth', 'mars'], half: 1.75, speed: 30, sel: 'mercury' },
	{ id: 'outer', name: 'Планеты-гиганты, Плутон и комета', ids: ['jupiter', 'saturn', 'uranus', 'neptune', 'pluto', 'halley'], half: 52, speed: 3 * 365.25, sel: 'halley' },
];
const bodies = BODIES.map((b) => ({ id: b.id, name: b.name, a: b.a, e: b.e, T: b.T, color: b.color }));
---

<figure class="vo not-content" data-vo data-bodies={JSON.stringify(bodies)} data-views={JSON.stringify(views)}>
	<div class="vo__top">
		<div class="vo__views" role="group" aria-label="Что показать">
			{
				views.map((v, i) => (
					<button type="button" class="vo__chip" data-view={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>
						{v.name}
					</button>
				))
			}
		</div>
	</div>
	<div class="vo__grid">
		<div class="vo__stage">
			<canvas class="vo__canvas" aria-label="Орбиты планет вокруг Солнца"></canvas>
			<p class="vo__date" data-date></p>
		</div>
		<div class="vo__side">
			<div class="vo__bodies" role="group" aria-label="Выбрать тело" data-body-chips></div>
			<dl class="vo__stats">
				<div><dt>Расстояние до Солнца <i>r</i></dt><dd data-r>—</dd></div>
				<div><dt>Скорость <i>υ</i></dt><dd data-v>—</dd></div>
				<div><dt>Перигелий</dt><dd data-peri>—</dd></div>
				<div><dt>Афелий</dt><dd data-apo>—</dd></div>
			</dl>
			<p class="vo__sector" data-sector aria-live="polite"></p>
		</div>
		<div class="vo__side">
			<canvas class="vo__graph" aria-label="Диаграмма: период обращения и большая полуось"></canvas>
			<table class="vo__table">
				<thead><tr><th>Тело</th><th><i>a</i>, а.е.</th><th><i>T</i>, лет</th><th><i>T</i>²/<i>a</i>³</th></tr></thead>
				<tbody data-rows></tbody>
			</table>
		</div>
	</div>
	<div class="vo__controls">
		<label class="vo__slider">
			<span class="vo__slider-name">Скорость времени: <output data-speed-out></output></span>
			<input type="range" min="0" max="4" step="0.01" value="1.48" data-speed aria-label="Скорость времени" />
		</label>
		<div class="vo__buttons">
			<button type="button" class="vo__btn vo__btn--primary" data-play aria-pressed="true">Пауза</button>
			<button type="button" class="vo__btn" data-pin>Запомнить сектор</button>
			<button type="button" class="vo__btn" data-reset>Сегодня</button>
		</div>
	</div>
	<figcaption class="vo__caption">
		Орбиты — настоящие эллипсы с Солнцем в фокусе, масштаб по обеим осям одинаковый, положения тел соответствуют
		дате (с точностью до нескольких градусов). Размеры Солнца и тел не в масштабе: при такой ширине кадра даже
		Юпитер был бы меньше пикселя. Орбиты показаны в проекции на плоскость орбиты Земли; комета Галлея движется
		по своей орбите в обратную сторону — так и есть на самом деле.
	</figcaption>
</figure>

<style is:global>
	.vo {
		margin-block: 2rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
