---
/**
 * The Sun in section: core, radiative zone, convective zone, photosphere, chromosphere, corona.
 * Layer radii are to scale (0,25 R☉ and 0,7 R☉); the thin outer layers are drawn thicker than life so they can be seen.
 * A tap on a layer (or its button) shows what happens there.
 */
const uid = `vs-${Math.random().toString(36).slice(2, 8)}`;
const R = 150;
const CX = 165;
const CY = 200;
const layers = [
	{
		id: 'core',
		name: 'Ядро',
		where: 'r < 0,25 R☉',
		T: '≈ 15 млн K',
		text: 'Здесь, при температуре 15 миллионов кельвинов и плотности в 150 раз больше плотности воды, ядра водорода сливаются в гелий. Каждую секунду 600 млн тонн водорода превращаются в 596 млн тонн гелия, а разница в 4 млн тонн массы уходит в излучение.',
	},
	{
		id: 'rad',
		name: 'Зона лучистого переноса',
		where: '0,25–0,7 R☉',
		T: 'от 7 млн до 2 млн K',
		text: 'Энергия просачивается наружу излучением: фотон поглощается и переизлучается бессчётное число раз. Из ядра до поверхности свет добирается не за две секунды, а за десятки и сотни тысяч лет.',
	},
	{
		id: 'conv',
		name: 'Конвективная зона',
		where: '0,7–1 R☉',
		T: 'от 2 млн до 6 тыс. K',
		text: 'Газ здесь непрозрачнее, и энергию переносят потоки вещества, как в кастрюле с кипящей водой: горячие струи поднимаются, остывшие опускаются. На поверхности эти потоки видны как грануляция — ячейки размером с крупную страну.',
	},
	{
		id: 'photo',
		name: 'Фотосфера',
		where: 'слой толщиной ≈ 300 км',
		T: '≈ 6000 K',
		text: 'Видимая «поверхность» Солнца: отсюда выходит почти весь свет. Это газ, а не твёрдая кора. Здесь появляются солнечные пятна — области с сильным магнитным полем, холоднее соседних на полторы-две тысячи градусов и потому тёмные на их фоне.',
	},
	{
		id: 'chromo',
		name: 'Хромосфера',
		where: '≈ 2000 км над фотосферой',
		T: 'от 4,5 тыс. до 20 тыс. K',
		text: 'Прозрачный разреженный слой, который виден только в полное затмение — красноватой каймой вокруг закрытого Луной диска. Из хромосферы поднимаются протуберанцы — светящиеся арки газа высотой в десятки тысяч километров.',
	},
	{
		id: 'corona',
		name: 'Корона',
		where: 'на миллионы километров',
		T: '1–2 млн K',
		text: 'Внешняя атмосфера Солнца: жемчужное сияние, видимое в полное затмение. Она горячее фотосферы в сотни раз — почему, учёные выясняют до сих пор. Корона не удерживается тяготением и истекает в космос солнечным ветром, который долетает и до Земли, рождая полярные сияния.',
	},
];
---

<figure class="vs not-content" data-vs>
	<div class="vs__grid">
		<svg class="vs__svg" viewBox="0 0 460 400" role="img" aria-label="Строение Солнца в разрезе">
			<defs>
				<radialGradient id={`${uid}-corona`} cx="50%" cy="50%" r="50%">
					<stop offset="60%" stop-color="#ffd27a" stop-opacity="0.35" />
					<stop offset="80%" stop-color="#ffb84d" stop-opacity="0.12" />
					<stop offset="100%" stop-color="#ffb84d" stop-opacity="0" />
				</radialGradient>
				<radialGradient id={`${uid}-surface`} cx="38%" cy="35%" r="70%">
					<stop offset="0%" stop-color="#fff2c6" />
					<stop offset="55%" stop-color="#ffb640" />
					<stop offset="100%" stop-color="#e2651c" />
				</radialGradient>
				<radialGradient id={`${uid}-conv`} cx="50%" cy="50%" r="50%">
					<stop offset="70%" stop-color="#ff9a2e" />
					<stop offset="100%" stop-color="#ffd27a" />
				</radialGradient>
				<radialGradient id={`${uid}-rad`} cx="50%" cy="50%" r="50%">
					<stop offset="36%" stop-color="#ffe9a8" />
					<stop offset="100%" stop-color="#ff7a1f" />
				</radialGradient>
				<radialGradient id={`${uid}-core`} cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="#ffffff" />
					<stop offset="100%" stop-color="#fff1b0" />
				</radialGradient>
				<clipPath id={`${uid}-wedge`}>
					<path d={`M ${CX} ${CY} L ${CX + R * 1.1} ${CY} A ${R * 1.1} ${R * 1.1} 0 0 1 ${CX} ${CY + R * 1.1} Z`} />
				</clipPath>
			</defs>
			<!-- corona -->
			<circle class="vs__corona" data-layer="corona" cx={CX} cy={CY} r={R * 1.3} fill={`url(#${uid}-corona)`} />
			<!-- chromosphere (drawn thicker than life) -->
			<circle data-layer="chromo" cx={CX} cy={CY} r={R * 1.045} fill="#ff6a3d" opacity="0.85" />
			<!-- surface -->
			<circle data-layer="photo" cx={CX} cy={CY} r={R} fill={`url(#${uid}-surface)`} />
			<!-- sunspots -->
			<g class="vs__spots" data-layer="photo">
				<ellipse cx={CX - 70} cy={CY - 48} rx="9" ry="6" fill="#7a2a08" opacity="0.8" />
				<ellipse cx={CX - 52} cy={CY - 38} rx="5" ry="3.5" fill="#7a2a08" opacity="0.7" />
				<ellipse cx={CX - 20} cy={CY - 95} rx="6" ry="4" fill="#7a2a08" opacity="0.75" />
			</g>
			<!-- the cut-away wedge: a quarter of the disc removed -->
			<g clip-path={`url(#${uid}-wedge)`}>
				<circle cx={CX} cy={CY} r={R * 1.045} fill="#02030a" />
				<circle data-layer="conv" cx={CX} cy={CY} r={R} fill={`url(#${uid}-conv)`} />
				<circle data-layer="rad" cx={CX} cy={CY} r={R * 0.7} fill={`url(#${uid}-rad)`} />
				<circle data-layer="core" cx={CX} cy={CY} r={R * 0.25} fill={`url(#${uid}-core)`} />
				<!-- convection cells -->
				<g class="vs__cells" fill="none" stroke="#ffe3a0" stroke-width="1.2" opacity="0.55">
					{
						[0.76, 0.85, 0.94].map((f) =>
							[12, 32, 52, 72].map((ang) => {
								const a = (ang * Math.PI) / 180;
								const x = CX + R * f * Math.cos(a);
								const y = CY + R * f * Math.sin(a);
								return <path d={`M ${x - 5} ${y + 4} q 5 -9 10 0 q -5 6 -10 0`} />;
							}),
						)
					}
				</g>
				<!-- radiative zone: a zigzag photon path -->
				<path class="vs__photon" d={`M ${CX + R * 0.27} ${CY + 8} l 7 -4 l 5 7 l 6 -5 l 4 6 l 7 -3 l 5 6 l 6 -4 l 5 7 l 7 -2 l 4 6 l 6 -4`} fill="none" stroke="#fff6d8" stroke-width="1.2" opacity="0.8" />
			</g>
			<!-- labels and leader lines -->
			<g class="vs__labels" font-size="13">
				<line x1={CX + R * 0.12} y1={CY + R * 0.12} x2={CX + R * 0.6} y2={CY + R * 1.1} />
				<text x={CX + R * 0.62} y={CY + R * 1.17}>ядро</text>
				<line x1={CX + R * 0.45} y1={CY + R * 0.32} x2={CX + R * 1.05} y2={CY + R * 0.9} />
				<text x={CX + R * 1.07} y={CY + R * 0.95}>лучистая зона</text>
				<line x1={CX + R * 0.8} y1={CY + R * 0.42} x2={CX + R * 1.2} y2={CY + R * 0.62} />
				<text x={CX + R * 1.22} y={CY + R * 0.66}>конвективная<tspan x={CX + R * 1.22} dy="1.15em">зона</tspan></text>
				<line x1={CX + R * 0.99} y1={CY - R * 0.14} x2={CX + R * 1.25} y2={CY - R * 0.14} />
				<text x={CX + R * 1.27} y={CY - R * 0.1}>фотосфера</text>
				<line x1={CX + R * 0.86} y1={CY - R * 0.59} x2={CX + R * 1.25} y2={CY - R * 0.64} />
				<text x={CX + R * 1.27} y={CY - R * 0.6}>хромосфера</text>
				<text x={CX + R * 0.55} y={CY - R * 1.22}>корона</text>
				<text x={CX - R * 1.05} y={CY - R * 0.72}>пятна</text>
			</g>
		</svg>
		<div class="vs__info">
			<div class="vs__chips" role="group" aria-label="Слои Солнца">
				{
					layers.map((l, i) => (
						<button type="button" class="vs__chip" data-pick={l.id} aria-pressed={i === 0 ? 'true' : 'false'}>
							{l.name}
						</button>
					))
				}
			</div>
			{
				layers.map((l, i) => (
					<div class="vs__card" data-card={l.id} hidden={i !== 0}>
						<p class="vs__name">{l.name}</p>
						<p class="vs__meta">
							{l.where} · <i>T</i> {l.T}
						</p>
						<p class="vs__text">{l.text}</p>
					</div>
				))
			}
		</div>
	</div>
	<figcaption class="vs__caption">
		Радиусы ядра и зон — в масштабе (0,25 и 0,7 радиуса Солнца); фотосфера и хромосфера на самом деле в сотни
		раз тоньше, чем нарисованы. Радиус Солнца 696 000 км — 109 радиусов Земли; масса 2·10³⁰ кг — в 333 000 раз
		больше массы Земли и в 750 раз больше массы всех планет вместе. По массе Солнце на 73 % состоит из водорода
		и на 25 % из гелия.
	</figcaption>
</figure>

<style is:global>
	.vs {
		margin-block: 2rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vs i {
		font-family: var(--ig-font-math);
	}
	.vs__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		align-items: start;
	}
	.vs__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		background: #02030a;
	}
	.vs__svg [data-layer] {
		cursor: pointer;
		transition: filter 0.25s;
	}
	.vs__svg .is-lit {
		filter: brightness(1.25) drop-shadow(0 0 6px rgb(255 240 200 / 0.8));
	}
	.vs__labels line {
		stroke: rgb(235 238 255 / 0.6);
		stroke-width: 1;
	}
	.vs__labels text {
		fill: rgb(235 238 255 / 0.9);
		font-family: var(--sl-font);
	}
	.vs__corona {
		animation: vs-breathe 6s ease-in-out infinite;
		transform-origin: 165px 200px;
	}
	@keyframes vs-breathe {
		50% {
			transform: scale(1.06);
			opacity: 0.85;
		}
	}
	.vs__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.vs__chip {
		margin: 0;
		padding: 0.3rem 0.8rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.vs__chip:hover {
		border-color: var(--sl-color-accent);
	}
	.vs__chip[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.vs__card[hidden] {
		display: none;
	}
	.vs__name {
		margin: 0.7rem 0 0;
		font-family: var(--ig-font-display);
		font-size: 1.8rem;
		line-height: 1.15;
		color: var(--sl-color-white);
	}
	.vs__meta {
		margin: 0.1rem 0 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.vs__text {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.vs__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.vs {
			padding: 0.5rem;
		}
		.vs__grid {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.vs__corona {
			animation: none;
		}
		.vs__svg [data-layer] {
			transition: none;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-vs]')) {
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pick]'));
		const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
		const parts = Array.from(root.querySelectorAll<SVGElement>('[data-layer]'));
		const pick = (id: string) => {
			for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.pick === id));
			for (const c of cards) c.hidden = c.dataset.card !== id;
			for (const p of parts) p.classList.toggle('is-lit', p.dataset.layer === id);
		};
		for (const c of chips) c.addEventListener('click', () => pick(c.dataset.pick!));
		for (const p of parts) p.addEventListener('click', () => pick(p.dataset.layer!));
		pick('core');
	}
</script>
