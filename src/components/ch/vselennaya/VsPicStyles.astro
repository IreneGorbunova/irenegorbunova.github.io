---
/** Frame and shared parts of the explanatory pictures of «Солнечная система. Звёзды. Галактики» (panels, caption, «Повторить», bodies, labels). Renders nothing. */
---

<style is:global>
	.vs-pic {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vs-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.vs-pic--one .vs-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 30rem;
		margin-inline: auto;
	}
	.vs-pic--three .vs-pic__grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.vs-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.vs-pic text {
		font-family: var(--__sl-font);
		font-size: 12px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3.5px;
		stroke-linejoin: round;
	}
	.vs-pic .vs-title {
		font-size: 14px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.vs-pic .vs-t-sun {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.vs-pic .vs-t-acc {
		fill: var(--ig-vx);
		font-weight: 700;
	}
	.vs-pic .vs-t-red {
		fill: var(--ig-vy);
		font-weight: 700;
	}
	.vs-pic .vs-t-math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.vs-pic__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
	}
	.vs-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.vs-pic__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.vs-pic__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	/* bodies and lines */
	.vs-sun {
		fill: var(--ig-v);
	}
	.vs-sun-glow {
		fill: color-mix(in srgb, var(--ig-v) 22%, transparent);
	}
	.vs-orbit {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.vs-orbit--dash {
		stroke-dasharray: 4 4;
	}
	.vs-line {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.vs-bracket {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.vs-star {
		fill: var(--sl-color-gray-3);
	}
	.vs-dim {
		stroke: var(--ig-v);
		stroke-width: 1.4;
		fill: none;
	}
	.vs-dimhead {
		fill: var(--ig-v);
	}
	@media (max-width: 40rem) {
		.vs-pic__grid,
		.vs-pic--three .vs-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
