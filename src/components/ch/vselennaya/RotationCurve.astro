---
/**
 * «Predict, then look»: how fast do stars go round the Galaxy at different distances from its centre?
 * The reader picks a prediction, then the measured rotation curve of the Milky Way appears next to the curve
 * expected if all the mass were in the visible stars and gas. The measured curve is schematic (rounded values
 * of modern measurements, flat at about 220–230 км/с out to 25 kpc).
 */
const W = 520;
const H = 300;
const PL = 48;
const PR = 16;
const PT = 18;
const PB = 40;
const RMAX = 26;
const VMAX = 300;
const px = (r: number) => PL + (r / RMAX) * (W - PL - PR);
const py = (v: number) => H - PB - (v / VMAX) * (H - PT - PB);
// measured (schematic): r, kpc → υ, km/s
const observed: [number, number][] = [
	[0.5, 180],
	[1, 205],
	[2, 220],
	[3, 225],
	[4, 230],
	[5, 232],
	[6, 234],
	[7, 232],
	[8.2, 230],
	[10, 226],
	[12, 223],
	[14, 220],
	[16, 217],
	[18, 214],
	[20, 211],
	[22, 208],
	[24, 206],
];
// expected from the visible matter alone: rises inside the bright disc, then falls as 1/√r
const expected: [number, number][] = [];
for (let r = 0.5; r <= RMAX; r += 0.5) {
	const v = r < 5 ? 232 * Math.sqrt(r / 5) * (1 + 0.1 * (1 - r / 5)) : 232 * Math.sqrt(5 / r);
	expected.push([r, v]);
}
const path = (pts: [number, number][]) => pts.map(([r, v], i) => `${i ? 'L' : 'M'} ${px(r).toFixed(1)} ${py(v).toFixed(1)}`).join(' ');
const sunR = 8.2;
---

<figure class="vr not-content" data-vr>
	<p class="vr__q">Солнце обращается вокруг центра Галактики со скоростью около 230 км/с. А с какой скоростью движутся звёзды в два-три раза дальше от центра, чем Солнце? Сначала предскажите, потом посмотрите.</p>
	<div class="vr__opts" role="group" aria-label="Предсказание">
		<button type="button" class="vr__opt" data-guess="0">Медленнее: как далёкие планеты вокруг Солнца</button>
		<button type="button" class="vr__opt" data-guess="1">Примерно с той же скоростью</button>
		<button type="button" class="vr__opt" data-guess="2">Быстрее: они дальше, им нужно успевать</button>
	</div>
	<svg class="vr__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Кривая вращения Галактики: скорость звёзд в зависимости от расстояния до центра">
		<g class="vr__grid">
			{[5, 10, 15, 20, 25].map((r) => <line x1={px(r)} y1={py(0)} x2={px(r)} y2={py(VMAX)} />)}
			{[100, 200, 300].map((v) => <line x1={px(0)} y1={py(v)} x2={px(RMAX)} y2={py(v)} />)}
		</g>
		<g class="vr__ticks">
			{[0, 5, 10, 15, 20, 25].map((r) => <text x={px(r)} y={H - PB + 16} text-anchor="middle">{r}</text>)}
			{[0, 100, 200, 300].map((v) => <text x={PL - 6} y={py(v) + 4} text-anchor="end">{v}</text>)}
			<text class="vr__axis" x={W - PR} y={H - 6} text-anchor="end">r, тыс. пк от центра Галактики</text>
			<text class="vr__axis" x={PL + 4} y={PT - 4}>υ, км/с</text>
		</g>
		<line class="vr__sun-line" x1={px(sunR)} y1={py(0)} x2={px(sunR)} y2={py(260)} />
		<text class="vr__sun-text" x={px(sunR) + 4} y={py(262)}>Солнце</text>
		<path class="vr__expected" data-expected d={path(expected)} />
		<text class="vr__label vr__label--exp" data-expected-label x={px(17)} y={py(100)} text-anchor="middle">ожидали: вся масса — в видимых звёздах и газе</text>
		<path class="vr__observed" data-observed d={path(observed)} />
		<g class="vr__points" data-points>
			{observed.map(([r, v]) => <circle cx={px(r)} cy={py(v)} r="3" />)}
		</g>
		<text class="vr__label vr__label--obs" data-observed-label x={px(17)} y={py(250)} text-anchor="middle">измерено</text>
	</svg>
	<p class="vr__fb" data-fb aria-live="polite">Выберите ответ — и на графике появятся измерения.</p>
	<details class="vr__expl" data-expl>
		<summary>Что это значит</summary>
		<p>Почти все звёзды и газ Галактики сосредоточены в пределах 15 тыс. пк от центра. Если бы это была вся её масса, то дальше звёзды должны были бы двигаться всё медленнее, как планеты вокруг Солнца: <i>υ</i> ∝ 1/√<i>r</i>. А измерения показывают: скорость почти не падает до самых окраин. Значит, Галактика погружена в огромное невидимое облако массы — <b>тёмную материю</b>. Её в Галактике примерно в пять раз больше, чем обычного вещества, и что она такое, пока неизвестно.</p>
	</details>
</figure>

<style is:global>
	.vr {
		margin-block: 2rem;
		padding: 0.9rem 1rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.vr i {
		font-family: var(--ig-font-math);
	}
	.vr__q {
		margin: 0 0 0.6rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.vr__opts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.vr__opt {
		margin: 0;
		padding: 0.45rem 1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.vr__opt:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}
	.vr__opt.is-right {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.vr__opt.is-right::before {
		content: '✓ ';
	}
	.vr__opt.is-wrong {
		border-color: var(--ig-vy);
		opacity: 0.75;
		text-decoration: line-through;
	}
	.vr__svg {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 0.75rem;
	}
	.vr__grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.vr__ticks text {
		fill: var(--sl-color-gray-3);
		font-size: 12px;
		font-family: var(--sl-font);
	}
	.vr__axis {
		font-style: italic;
		fill: var(--sl-color-gray-2) !important;
	}
	.vr__sun-line {
		stroke: var(--sl-color-accent);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.vr__sun-text {
		fill: var(--sl-color-accent);
		font-size: 12px;
		font-family: var(--sl-font);
	}
	.vr__expected {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2;
		stroke-dasharray: 6 5;
	}
	.vr__observed {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.5;
	}
	.vr__points circle {
		fill: var(--ig-v);
	}
	.vr__label {
		font-size: 12px;
		font-family: var(--sl-font);
	}
	.vr__label--exp {
		fill: var(--ig-vx);
	}
	.vr__label--obs {
		fill: var(--ig-v);
	}
	.vr:not(.is-revealed) .vr__observed,
	.vr:not(.is-revealed) .vr__points,
	.vr:not(.is-revealed) .vr__label--obs,
	.vr:not(.is-revealed) .vr__expected,
	.vr:not(.is-revealed) .vr__label--exp {
		opacity: 0;
	}
	.vr.is-revealed .vr__observed {
		stroke-dasharray: 1200;
		stroke-dashoffset: 1200;
		animation: vr-draw 2s ease-out forwards;
	}
	.vr.is-revealed .vr__points circle {
		animation: vr-pop 0.3s ease-out both;
	}
	@keyframes vr-draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes vr-pop {
		from {
			opacity: 0;
		}
	}
	.vr__fb {
		min-height: 1.4em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.vr__fb.is-right {
		color: var(--sl-color-text-accent);
		font-weight: 700;
	}
	.vr__expl {
		margin-top: 0.3rem;
	}
	.vr__expl summary {
		cursor: pointer;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.vr__expl p {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.vr__expl b {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.vr__ticks text,
		.vr__label,
		.vr__sun-text {
			font-size: 15px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.vr.is-revealed .vr__observed,
		.vr.is-revealed .vr__points circle {
			animation: none;
			stroke-dashoffset: 0;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-vr]')) {
		const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-guess]'));
		const fb = root.querySelector<HTMLElement>('[data-fb]')!;
		const expl = root.querySelector<HTMLDetailsElement>('[data-expl]')!;
		const points = Array.from(root.querySelectorAll<SVGCircleElement>('[data-points] circle'));
		points.forEach((c, i) => (c.style.animationDelay = `${(i / points.length) * 2}s`));
		for (const btn of opts)
			btn.addEventListener('click', () => {
				const g = Number(btn.dataset.guess);
				opts.forEach((b) => (b.disabled = true));
				opts[1].classList.add('is-right');
				if (g !== 1) btn.classList.add('is-wrong');
				root.classList.add('is-revealed');
				fb.innerHTML =
					g === 1
						? 'Верно! Скорость почти не меняется — и это одна из главных загадок астрономии.'
						: g === 0
							? 'Так думали и астрономы — но измерения показали другое: скорость почти не падает.'
							: 'Нет: при обычном тяготении далёкие звёзды двигались бы медленнее. Но измерения показали, что скорость почти не меняется.';
				fb.classList.toggle('is-right', g === 1);
				expl.open = true;
			});
	}
</script>
