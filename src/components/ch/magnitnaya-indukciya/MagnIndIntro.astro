---
/**
 * Two short looping opening scenes of «Магнитное поле. Индукция магнитного поля». No terms and no numbers in the
 * pictures; the captions' popovers explain. People: the people kit, in profile.
 *
 * Speaker («Колонка»): a living room, 1,5 px per см (the teen is 158 см). A teen sits on a sofa with a phone in the far
 *   hand and taps it with the index finger of the near hand: music starts; a small portable speaker lies on its back on
 *   the floor, its woofer up. The round inset over the speaker shows the woofer close up (1 px per мм, seen from above
 *   at about 25°) with seven grains of rice on it. On every bass beat (120 beats per minute, 2 per second) the cone
 *   kicks and the grains jump; between beats it trembles a little. A second tap stops the music and the grains rest.
 *   Physics: a 60 Гц bass at an amplitude of 1 мм gives the cone an acceleration (2π·60)²·0,001 ≈ 140 м/с² ≫ g, so
 *   the grains leave it with up to v = 2π·60·0,001 ≈ 0,38 м/с and rise up to v²/2g ≈ 7 мм; here each grain rises
 *   3–11 мм on a beat and flies a real ballistic arc, g = 9,8 м/с², in real time (a 1 см jump lasts 2√(2h/g) = 90 мс).
 *   Exaggerated: the cone's own motion (drawn up to 3 мм, a real one moves 1–2 мм and too fast to see; the 60 Гц
 *   oscillation is shown as its beat envelope with a small tremor). The notes over the speaker are a decoration.
 * Northern lights («Сияние»): a winter night in a small town beyond the Arctic Circle (e.g. Murmansk, 69° N), 0,8 px per
 *   см for the teen (160 см, winter clothes and mittens, people kit). Two curtains of the aurora wave over the roofs: each
 *   is a row of vertical rays (green body, a pink lower fringe, a faint red top: the 557,7 нм oxygen line at about
 *   100–200 км, the 630 нм one above 200 км, nitrogen at the lower edge), its lower edge a slow travelling wave, the
 *   brightness running along it in patches; the snow takes a faint green from the light. The far curtain is higher and
 *   fainter. Not to scale: a real curtain is 100–300 км up and hundreds of kilometres long; its folds move in seconds
 *   to minutes, here in about real time. The teen raises the phone with both hands (0,9 с), takes two photos (the screen
 *   light flashes) and lowers it, as the photographer in yadernye-reakcii/ReakciiIntro does; the head is tilted up.
 * Plays only while visible (scene() from intro/scene.ts).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
---

<PeopleStyles />
<IntroFrame data-miintro>
	<div class="intro__card" data-scene="speaker">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Комната. Подросток сидит на диване и нажимает на экран телефона. На полу лежит колонка динамиком вверх, на нём рисинки. Заиграла музыка: в увеличенном круге видно, как мембрана динамика дрожит и рисинки подпрыгивают в такт. Второе нажатие останавливает музыку, рисинки лежат спокойно">
			<rect class="mii-wall" x="0" y="0" width="360" height="226"></rect>
			<rect class="mii-skirt" x="0" y="221" width="360" height="5"></rect>
			<rect class="mii-floor" x="0" y="226" width="360" height="14"></rect>
			<ellipse class="mii-rug" cx="210" cy="231" rx="110" ry="6"></ellipse>
			<!-- window -->
			<rect class="mii-frame" x="142" y="26" width="86" height="92" rx="2"></rect>
			<rect class="mii-sky" x="147" y="31" width="76" height="82"></rect>
			<path class="mii-cloud" d="M160 60 q6 -9 15 -4 q7 -6 13 1 q8 0 7 6 h-36 q-4 -3 1 -3 Z"></path>
			<path class="mii-house" d="M150 113 V88 h20 V96 h16 V80 h22 V113 Z"></path>
			<path class="mii-bar" d="M185 31 V113 M147 72 H223"></path>
			<rect class="mii-sill" x="138" y="117" width="94" height="5" rx="1.5"></rect>
			<!-- a shelf with books -->
			<rect class="mii-wood" x="262" y="62" width="84" height="4" rx="1"></rect>
			<rect class="mii-book1" x="268" y="38" width="7" height="24"></rect>
			<rect class="mii-book2" x="276" y="42" width="6" height="20"></rect>
			<rect class="mii-book3" x="283" y="36" width="8" height="26"></rect>
			<rect class="mii-book1" x="292" y="44" width="5" height="18" transform="rotate(14 297 62)"></rect>
			<!-- a plant -->
			<path class="mii-pot" d="M330 226 l-5 -26 h22 l-5 26 Z"></path>
			<path class="mii-leaf" d="M336 200 q-14 -14 -10 -34 q10 12 10 34 Z M336 200 q4 -22 16 -30 q0 20 -16 30 Z M336 200 q-4 -12 4 -22 q4 12 -4 22 Z"></path>
			<!-- the sofa -->
			<path class="mii-sofa-back" d="M0 106 h44 q6 0 6 6 v52 H0 Z"></path>
			<path class="mii-sofa" d="M0 160 h128 q6 0 6 6 v28 H0 Z"></path>
			<rect class="mii-sofa-leg" x="122" y="194" width="6" height="32"></rect>
			<rect class="mii-cushion" x="4" y="116" width="34" height="40" rx="7" transform="rotate(-8 21 136)"></rect>
			<!-- the speaker on its back -->
			<g data-spk>
				<rect class="mii-spk" x="196" y="211" width="44" height="15" rx="4"></rect>
				<path class="mii-spk-top" d="M199 211 q19 -5 38 0 Z"></path>
				<rect class="mii-spk-led" x="233" y="219" width="3" height="2" rx="0.6" data-led></rect>
			</g>
			<g data-notes></g>
			<!-- the teen -->
			<g data-phone-back></g>
			<g data-phone>
				<rect class="mii-phone" x="-1.2" y="-11" width="2.4" height="22" rx="1"></rect>
			</g>
			<g data-teen></g>
			<path class="mii-screen" d="" data-screen></path>
			<!-- the inset -->
			<path class="mii-loupe-line" d="M205 210 L247 120 M233 210 L330 112"></path>
			<circle class="mii-loupe" cx="285" cy="80" r="56"></circle>
			<clipPath id="mii-clip"><circle cx="285" cy="80" r="55"></circle></clipPath>
			<g clip-path="url(#mii-clip)">
				<rect class="mii-spk-face" x="225" y="20" width="120" height="120"></rect>
				<ellipse class="mii-surround" cx="285" cy="92" rx="47" ry="20"></ellipse>
				<g data-cone>
					<ellipse class="mii-cone" cx="285" cy="92" rx="40" ry="17"></ellipse>
					<ellipse class="mii-cone-in" cx="285" cy="95" rx="24" ry="10"></ellipse>
					<ellipse class="mii-cap" cx="285" cy="97" rx="11" ry="4.8"></ellipse>
				</g>
				<g data-grains></g>
			</g>
			<circle class="mii-loupe-rim" cx="285" cy="80" r="56"></circle>
		</svg>
		<div class="intro__foot">
			<p>
				Включили музыку —{' '}<More term="мембрана колонки дрожит">К мембране приклеена лёгкая катушка из тонкого провода, она сидит в узком зазоре кольцевого магнита. По катушке идёт ток, который меняется в такт музыке, и магнитное поле толкает её то вперёд, то назад — это <a href="#действие-магнитного-поля-на-проводник-с-током">сила Ампера</a>.</More>, и рисинки на ней подпрыгивают в такт.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="aurora">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимняя ночь в северном городе. Над заснеженными крышами по небу колышутся светящиеся зелёные занавеси с розовой каймой, снег под ними чуть зеленеет. Подросток в зимней куртке поднимает телефон двумя руками и фотографирует небо, потом опускает телефон">
			<defs>
				<linearGradient id="mii-ray" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="hsl(345, 70%, 60%)" stop-opacity="0"></stop>
					<stop offset="0.3" stop-color="hsl(345, 65%, 58%)" stop-opacity="0.22"></stop>
					<stop offset="0.62" stop-color="hsl(140, 85%, 58%)" stop-opacity="0.55"></stop>
					<stop offset="0.93" stop-color="hsl(130, 90%, 72%)" stop-opacity="0.95"></stop>
					<stop offset="1" stop-color="hsl(310, 70%, 72%)" stop-opacity="0.7"></stop>
				</linearGradient>
				<linearGradient id="mii-night" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="hsl(225, 55%, 7%)"></stop>
					<stop offset="1" stop-color="hsl(215, 45%, 17%)"></stop>
				</linearGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill="url(#mii-night)"></rect>
			<g data-stars></g>
			<g class="mii-aurora" data-aurora></g>
			<!-- the town: houses with snow on the roofs, lit windows, a fir tree, the snow -->
			<path class="mii-hill" d="M0 176 Q90 166 180 172 T360 168 V240 H0 Z"></path>
			<g class="mii-town">
				<path class="mii-th" d="M196 196 V160 L214 146 L232 160 V196 Z"></path>
				<path class="mii-troof" d="M193 161 L214 144 L235 161 L232 162 L214 148 L196 162 Z"></path>
				<rect class="mii-win" x="203" y="166" width="7" height="8"></rect>
				<rect class="mii-win" x="218" y="166" width="7" height="8"></rect>
				<rect class="mii-win is-dark" x="218" y="180" width="7" height="8"></rect>
				<path class="mii-th" d="M244 198 V150 H300 V198 Z"></path>
				<path class="mii-troof" d="M241 151 H303 V146 H241 Z"></path>
				<rect class="mii-win" x="251" y="158" width="7" height="8"></rect>
				<rect class="mii-win is-dark" x="268" y="158" width="7" height="8"></rect>
				<rect class="mii-win" x="285" y="158" width="7" height="8"></rect>
				<rect class="mii-win is-dark" x="251" y="176" width="7" height="8"></rect>
				<rect class="mii-win" x="268" y="176" width="7" height="8"></rect>
				<rect class="mii-win" x="285" y="176" width="7" height="8"></rect>
				<path class="mii-th" d="M312 198 V164 L330 152 L348 164 V198 Z"></path>
				<path class="mii-troof" d="M309 165 L330 150 L351 165 L348 166 L330 154 L312 166 Z"></path>
				<rect class="mii-win" x="326" y="172" width="8" height="9"></rect>
				<path class="mii-smoke" d="M222 150 q-3 -8 2 -14 q5 -6 1 -14" data-smoke></path>
				<rect class="mii-th" x="219" y="148" width="5" height="8"></rect>
				<path class="mii-fir" d="M40 206 L52 176 L46 177 L56 156 L50 157 L58 138 L66 157 L60 156 L70 177 L64 176 L76 206 Z"></path>
				<rect class="mii-trunk" x="55" y="206" width="6" height="8"></rect>
				<path class="mii-firsnow" d="M47 190 l8 -3 l9 3 M51 170 l7 -3 l7 3 M54 151 l4 -2 l4 2"></path>
			</g>
			<path class="mii-tsnow" d="M0 206 Q100 198 200 204 T360 200 V240 H0 Z"></path>
			<path class="mii-snowglow" d="M0 206 Q100 198 200 204 T360 200 V240 H0 Z" data-glow></path>
			<!-- the teen with the phone -->
			<circle class="mii-screenlight" r="6" data-slight></circle>
			<g data-teen></g>
			<rect class="mii-phone2" x="-2.8" y="-6" width="5.6" height="12" rx="1.2" data-phone2></rect>
		</svg>
		<div class="intro__foot">
			<p>
				Зимней ночью за Полярным кругом{' '}<More term="по небу бегут светящиеся зелёные занавеси">Это полярное сияние: на высоте 100–300&nbsp;км светится воздух, в который врезаются заряженные частицы, прилетевшие от Солнца. Магнитное поле Земли действует на движущиеся частицы и заворачивает их — это <a href="#сила-лоренца">сила Лоренца</a>; к атмосфере частицы пробиваются в основном вблизи магнитных полюсов. Подробнее — глава <a href="../../../8-klass/elektromagnitnye-yavleniya/magnitnoe-pole-zemli/#магнитные-бури-и-полярные-сияния">«Магнитное поле Земли»</a> 8&nbsp;класса.</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<script>
	import { scene } from '@components/intro/scene';
	import { DEG, SKELETON, add, polar, type Pt } from '@components/people/core';
	import { figure, ANKLE_CM, type FigurePose, type HandTarget } from '@components/people/body';
	import { blendShape, handShape } from '@components/people/hand';
	import { attachAxis, ease, reach } from '@components/people/motion';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = <K extends keyof SVGElementTagNameMap>(p: Element, tag: K, a: Record<string, string | number> = {}) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	const f = (v: number) => v.toFixed(1);
	const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
	const rand = (k: number) => {
		const s = Math.sin(k * 127.1 + 311.7) * 43758.5453;
		return s - Math.floor(s);
	};

	document.querySelectorAll<HTMLElement>('[data-miintro]').forEach((root) => {
		// ---------------- scene 1: the speaker
		{
			const card = root.querySelector<HTMLElement>('[data-scene="speaker"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 9;
			const S = 1.5;
			const FLOOR = 226;
			const TAP1 = 0.8; // the finger touches the screen
			const TAP2 = 7.5;
			const ON = 1.0; // the music starts
			const OFF = 7.6;
			const BEATS = Array.from({ length: 13 }, (_, k) => ON + 0.2 + 0.5 * k).filter((b) => b < OFF);
			const teen = figure($<SVGGElement>('[data-teen]'), { s: S, H: 158, age: 'teen', shirt: 'hm-green', hair: 'pony', name: 'speaker-teen' });
			teen.backLayer(1, $<SVGGElement>('[data-phone-back]'));
			const phone = $<SVGGElement>('[data-phone]');
			const screen = $<SVGPathElement>('[data-screen]');
			const led = $<SVGRectElement>('[data-led]');
			const cone = $<SVGGElement>('[data-cone]');
			const notes = $<SVGGElement>('[data-notes]');
			const noteEls = Array.from({ length: 4 }, (_, k) => {
				const t = mk(notes, 'text', { class: 'mii-note', 'text-anchor': 'middle' });
				t.textContent = k % 2 ? '♫' : '♪';
				return t;
			});
			// the grains on the cone: polar positions (ρ in parts of the cone radius, φ) and lengths
			const grainsG = $<SVGGElement>('[data-grains]');
			const GR = [
				[0.55, 0.4],
				[0.75, 2.2],
				[0.4, 3.5],
				[0.8, 4.6],
				[0.62, 5.5],
				[0.85, 1.2],
				[0.3, 2.8],
			].map(([r, p], k) => ({ r, p, a: rand(k + 3) * 180, el: mk(grainsG, 'ellipse', { class: 'mii-rice', rx: 3.5, ry: 1.5 }), sh: 0 }));
			const ankleY = FLOOR - ANKLE_CM.trainer * S;
			const u = S * 158;
			const seat = { x: 62, y: 160 - 0.04 * u };
			const hold: HandTarget = { at: { x: 104, y: 124 }, pose: 'grip', d: 7, dir: -25 * DEG, roll: -Math.PI / 2 + 0.25, contact: 'phone' };
			const base = (head: number): FigurePose => ({
				hip: seat,
				lean: 0.2,
				head,
				ankles: [{ x: 116, y: ankleY }, { x: 109, y: ankleY }],
				feet: [0, 0],
				hands: [{ at: { x: 98, y: 140 }, pose: 'relaxed' }, hold],
				planted: [true, true],
			});
			// the cone's displacement (px, up = −) at time t
			const coneY = (t: number) => {
				if (t < ON || t > OFF + 0.15) return 0;
				let y = 0;
				for (const b of BEATS) {
					const tau = t - b;
					if (tau >= 0 && tau < 0.3) y -= 3 * Math.exp(-tau / 0.05) * Math.cos((2 * Math.PI * tau) / 0.1);
				}
				return y + (t < OFF ? 0.5 * (rand(Math.floor(t * 60)) - 0.5) : 0);
			};
			scene(card, RUN, (x) => {
				const t = RUN * x;
				// the near hand: up to the screen and a tap, at TAP1 and TAP2 (0,5 s each way)
				const reach = (tt: number) => ease(clamp01((t - (tt - 0.5)) / 0.4)) * (1 - ease(clamp01((t - (tt + 0.15)) / 0.45)));
				const k = Math.max(reach(TAP1), reach(TAP2));
				const look = ease(clamp01((t - 1.3) / 0.6)) * (1 - ease(clamp01((t - 6.8) / 0.6)));
				const p0 = base(0.42 - 0.3 * look);
				const st0 = teen.pose(p0);
				const g = st0.grips[1];
				// a point on the screen (the phone's near face, toward the eyes), as in the kit's gallery
				const scr: Pt = { x: g.x - g.axis.x * 2 * S - 2.2 * S, y: g.y - g.axis.y * 2 * S - 0.6 * S };
				const rest: Pt = { x: 98, y: 140 };
				const bump = Math.max(0, 1 - Math.min(Math.abs(t - TAP1), Math.abs(t - TAP2)) / 0.14);
				const lift = 3 * S * (1 - bump);
				const goal: Pt = { x: scr.x - lift * 0.4, y: scr.y - lift };
				const at: Pt = { x: rest.x + (goal.x - rest.x) * k, y: rest.y + (goal.y - rest.y) * k };
				const near: HandTarget = k > 0.02 ? { at, pose: 'tap', dir: 12 * DEG, roll: -0.5, shape: blendShape(handShape('relaxed'), handShape('tap'), ease(clamp01(k * 1.4))), contact: bump > 0.9 ? 'screen' : undefined } : { at: rest, pose: 'relaxed' };
				const st = teen.pose({ ...p0, hands: [near, hold] });
				attachAxis(phone, st.grips[1]);
				// the phone's screen lights while the music plays
				const playing = t > ON && t < OFF;
				const ax = st.grips[1].axis;
				const sx = st.grips[1].x;
				const sy = st.grips[1].y;
				const nx = ax.y;
				const ny = -ax.x;
				const c = (a: number, b: number) => `${f(sx + ax.x * a + nx * b)} ${f(sy + ax.y * a + ny * b)}`;
				screen.setAttribute('d', `M${c(-9.5 * 1, 1.3)}L${c(9.5, 1.3)}`);
				screen.classList.toggle('is-on', playing);
				led.classList.toggle('is-on', playing);
				// the cone and the grains
				const cy = coneY(t);
				cone.setAttribute('transform', `translate(0 ${f(cy)})`);
				GR.forEach((gr, i) => {
					// the last beat that launched it and the flight since then
					let up = 0;
					for (const b of BEATS) {
						const tau = t - b - 0.012;
						if (tau < 0) break;
						const h = 3 + 8 * rand(i * 31 + b * 7.3); // мм
						const v = Math.sqrt(2 * 9.8 * h * 1e-3);
						const T = (2 * v) / 9.8;
						if (tau < T) up = (v * tau - 0.5 * 9.8 * tau * tau) * 1000; // мм
					}
					const R = 40 * gr.r;
					const px = 285 + R * Math.cos(gr.p);
					const depth = 6 * (1 - gr.r); // the cone is deeper toward the center
					const py = 92 + R * 0.42 * Math.sin(gr.p) + depth + (up > 0 ? 0 : cy);
					const spin = up > 0 ? gr.a + up * 25 : gr.a;
					gr.el.setAttribute('cx', f(px));
					gr.el.setAttribute('cy', f(py - up * 0.9));
					gr.el.setAttribute('transform', `rotate(${f(spin)} ${f(px)} ${f(py - up * 0.9)})`);
				});
				// the notes rise from the speaker while it plays
				noteEls.forEach((n, i) => {
					const ph = (t - ON) * 0.45 + i * 0.25;
					const q = ph - Math.floor(ph);
					const vis = playing && t - ON > i * 0.55 ? Math.sin(Math.PI * q) : 0;
					n.setAttribute('x', f(218 + (i % 2 ? 12 : -6) + 6 * Math.sin(ph * 6)));
					n.setAttribute('y', f(204 - 40 * q));
					n.style.opacity = (0.85 * vis).toFixed(2);
				});
			});
		}

		// ---------------- scene 2: the northern lights
		{
			const card = root.querySelector<HTMLElement>('[data-scene="aurora"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 10;
			const S = 0.8;
			const FLOOR = 222;
			const u = S * 160;
			const teen = figure($<SVGGElement>('[data-teen]'), { s: S, H: 160, age: 'teen', clothes: 'winter', gear: 'boot', shirt: 'hm-blue', name: 'aurora-teen' });
			const sk = SKELETON.teen;
			const ank = FLOOR - ANKLE_CM.boot * S;
			const hip: Pt = { x: 112, y: ank - 0.995 * (sk.thigh + sk.shin) * u };
			const sh = teen.shoulders(hip, 0.02);
			const stand = (hands: [HandTarget, HandTarget], head: number): FigurePose => ({
				hip,
				lean: 0.02,
				head,
				ankles: [{ x: hip.x + 2.2, y: ank }, { x: hip.x - 2.2, y: ank }],
				feet: [0, 0],
				hands,
				planted: [true, true],
			});
			const farHang: HandTarget = { at: add(sh[1], polar(0.36 * u, Math.PI / 2 + 4 * DEG)), pose: 'relaxed' };
			// the phone in the near hand all the time; both hands raise it in front of the face, aimed at the sky
			const HANG = stand([{ at: add(sh[0], polar(0.36 * u, Math.PI / 2 - 4 * DEG)), pose: 'grip', d: 1, dir: Math.PI / 2, contact: 'phone' }, farHang], -0.25);
			const up: Pt = { x: hip.x + 0.2 * u, y: hip.y - 0.42 * u };
			const UP = stand(
				[
					{ at: { x: up.x, y: up.y + 3.4 }, pose: 'grip', d: 1, dir: -80 * DEG, contact: 'phone' },
					{ at: { x: up.x - 1.1, y: up.y - 1.7 }, pose: 'grip', d: 1, dir: -80 * DEG, contact: 'phone' },
				],
				-0.5,
			);
			const phone = $<SVGRectElement>('[data-phone2]');
			const slight = $<SVGCircleElement>('[data-slight]');
			const glow = $<SVGPathElement>('[data-glow]');
			// stars: fixed, a few twinkle
			const starsG = $<SVGGElement>('[data-stars]');
			const stars = Array.from({ length: 46 }, (_, k) => {
				const x = rand(k + 11) * 360;
				const y = 6 + rand(k + 57) * 150;
				return { el: mk(starsG, 'circle', { class: 'mii-star', cx: f(x), cy: f(y), r: (0.5 + rand(k + 91) * 0.7).toFixed(2) }), k };
			});
			// the curtains: rays from the lower edge up; two curtains, the far one higher and fainter
			const auroraG = $<SVGGElement>('[data-aurora]');
			type Ray = { el: SVGRectElement; x: number; far: boolean };
			const rays: Ray[] = [];
			for (let x = -4; x < 364; x += 5) rays.push({ el: mk(auroraG, 'rect', { fill: 'url(#mii-ray)', width: 6, x: f(x - 3) }) as SVGRectElement, x, far: true });
			for (let x = 120; x < 364; x += 3.5) rays.push({ el: mk(auroraG, 'rect', { fill: 'url(#mii-ray)', width: 4.5, x: f(x - 2.25) }) as SVGRectElement, x, far: false });
			const edge = (x: number, t: number, far: boolean) =>
				far ? 78 - 0.05 * x + 7 * Math.sin(0.018 * x + 0.25 * t) + 3 * Math.sin(0.06 * x - 0.5 * t) : 132 - 0.1 * (x - 120) + 10 * Math.sin(0.024 * x + 0.35 * t) + 4 * Math.sin(0.075 * x - 0.65 * t);
			const bright = (x: number, t: number, far: boolean) => {
				const b = 0.5 + 0.3 * Math.sin(0.045 * x - 0.8 * t + (far ? 2 : 0)) + 0.2 * Math.sin(0.16 * x + 1.9 * t);
				return Math.max(0.08, Math.min(1, b)) * (far ? 0.45 : 1);
			};
			scene(card, RUN, (xx) => {
				const t = RUN * xx;
				let sum = 0;
				for (const r of rays) {
					const yb = edge(r.x, t, r.far);
					const h = (r.far ? 46 : 62) + 22 * Math.sin(0.09 * r.x + 1.1 * t + (r.far ? 1 : 0));
					const b = bright(r.x, t, r.far);
					r.el.setAttribute('y', f(yb - h));
					r.el.setAttribute('height', f(h + 2));
					r.el.setAttribute('opacity', b.toFixed(2));
					if (!r.far) sum += b;
				}
				glow.style.opacity = ((0.5 * sum) / rays.filter((r) => !r.far).length).toFixed(2);
				for (const s of stars) s.el.style.opacity = (0.55 + 0.45 * Math.sin(t * (1.3 + rand(s.k) * 2) + s.k)).toFixed(2);
				// the teen: raise the phone (0,9 с), take two photos, lower it
				let p: FigurePose;
				if (t < 1.5) p = HANG;
				else if (t < 2.4) p = reach(HANG, UP, (t - 1.5) / 0.9);
				else if (t < 7.6) p = UP;
				else if (t < 8.5) p = reach(UP, HANG, (t - 7.6) / 0.9);
				else p = HANG;
				const st = teen.pose(p);
				const g = st.grips[0];
				const k = t >= 1.5 && t < 8.5 ? (t < 2.4 ? ease((t - 1.5) / 0.9) : t < 7.6 ? 1 : 1 - ease((t - 7.6) / 0.9)) : 0;
				const pang = 180 - 202 * k; // hangs down along the fingers, turns up with the forearm, tilted back to aim at the sky
				phone.setAttribute('transform', `translate(${f(g.x)} ${f(g.y)}) rotate(${f(pang)}) translate(0 -4.5)`);
				const shot = (t >= 4.4 && t < 4.6) || (t >= 6 && t < 6.2);
				slight.setAttribute('cx', f(g.x - 4));
				slight.setAttribute('cy', f(g.y - 4));
				slight.style.opacity = (k * (shot ? 0.9 : 0.45)).toFixed(2);
			});
		}
	});
</script>

