---
/**
 * Two short looping opening scenes of «Магнитное поле. Индукция магнитного поля». No terms and no numbers in the
 * pictures; the captions' popovers explain. People: the people kit, in profile.
 *
 * Speaker («Колонка»): a living room, 1,5 px per см (the teen is 158 см). A teen sits on a sofa with a phone in the far
 *   hand and taps it with the index finger of the near hand: music starts; a small portable speaker lies on its back on
 *   the floor, its woofer up. The round inset over the speaker shows the woofer close up (1 px per мм, seen from above
 *   at about 25°) with seven grains of rice on it. On every bass beat (120 beats per minute, 2 per second) the cone
 *   kicks and the grains jump; between beats it trembles a little. A second tap stops the music and the grains rest.
 *   Physics: a 60 Гц bass at an amplitude of 1 мм gives the cone an acceleration (2π·60)²·0,001 ≈ 140 м/с² ≫ g, so
 *   the grains leave it with up to v = 2π·60·0,001 ≈ 0,38 м/с and rise up to v²/2g ≈ 7 мм; here each grain rises
 *   3–11 мм on a beat and flies a real ballistic arc, g = 9,8 м/с², in real time (a 1 см jump lasts 2√(2h/g) = 90 мс).
 *   Exaggerated: the cone's own motion (drawn up to 3 мм, a real one moves 1–2 мм and too fast to see; the 60 Гц
 *   oscillation is shown as its beat envelope with a small tremor). The notes over the speaker are a decoration.
 * Lamp («Лампочка»): a bedroom, a bedside table (55 см) with a lamp (30 см) whose shade lies beside it, 1,45 px per см
 *   (the teen is 160 см). The teen screws a bulb into the lamp's socket at waist height: the near hand grips the glass
 *   from above (fingers down round the bulb)
 *   and turns it clockwise as seen from above, 90° per stroke, and regrips between the strokes (the hand opens, turns
 *   back, closes: 0,45 s a stroke, 0,35 s a regrip, human speed). After four strokes (one full turn) the bulb sits
 *   and lights (the lamp's switch is on); one stroke counterclockwise and it goes out; the hand lets go and drops.
 *   Turning the bulb about its vertical axis is the hand's roll (people/hand.ts: rotation about the direction of the
 *   fingers): the contact point stays at the bulb's center and the wrist goes round it. The round inset shows the bulb
 *   from above with its printed mark and the arrow of the turn: clockwise while it goes in, counterclockwise while it
 *   comes out. An E27 thread has a pitch of 3,6 мм, so one turn lowers the bulb by 0,7 px: the descent is drawn true
 *   and is barely seen; the light tells that the bulb is in.
 * Plays only while visible (scene() from intro/scene.ts).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
---

<PeopleStyles />
<IntroFrame data-miintro>
	<div class="intro__card" data-scene="speaker">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Комната. Подросток сидит на диване и нажимает на экран телефона. На полу лежит колонка динамиком вверх, на нём рисинки. Заиграла музыка: в увеличенном круге видно, как мембрана динамика дрожит и рисинки подпрыгивают в такт. Второе нажатие останавливает музыку, рисинки лежат спокойно">
			<rect class="mii-wall" x="0" y="0" width="360" height="226"></rect>
			<rect class="mii-skirt" x="0" y="221" width="360" height="5"></rect>
			<rect class="mii-floor" x="0" y="226" width="360" height="14"></rect>
			<ellipse class="mii-rug" cx="210" cy="231" rx="110" ry="6"></ellipse>
			<!-- window -->
			<rect class="mii-frame" x="142" y="26" width="86" height="92" rx="2"></rect>
			<rect class="mii-sky" x="147" y="31" width="76" height="82"></rect>
			<path class="mii-cloud" d="M160 60 q6 -9 15 -4 q7 -6 13 1 q8 0 7 6 h-36 q-4 -3 1 -3 Z"></path>
			<path class="mii-house" d="M150 113 V88 h20 V96 h16 V80 h22 V113 Z"></path>
			<path class="mii-bar" d="M185 31 V113 M147 72 H223"></path>
			<rect class="mii-sill" x="138" y="117" width="94" height="5" rx="1.5"></rect>
			<!-- a shelf with books -->
			<rect class="mii-wood" x="262" y="62" width="84" height="4" rx="1"></rect>
			<rect class="mii-book1" x="268" y="38" width="7" height="24"></rect>
			<rect class="mii-book2" x="276" y="42" width="6" height="20"></rect>
			<rect class="mii-book3" x="283" y="36" width="8" height="26"></rect>
			<rect class="mii-book1" x="292" y="44" width="5" height="18" transform="rotate(14 297 62)"></rect>
			<!-- a plant -->
			<path class="mii-pot" d="M330 226 l-5 -26 h22 l-5 26 Z"></path>
			<path class="mii-leaf" d="M336 200 q-14 -14 -10 -34 q10 12 10 34 Z M336 200 q4 -22 16 -30 q0 20 -16 30 Z M336 200 q-4 -12 4 -22 q4 12 -4 22 Z"></path>
			<!-- the sofa -->
			<path class="mii-sofa-back" d="M0 106 h44 q6 0 6 6 v52 H0 Z"></path>
			<path class="mii-sofa" d="M0 160 h128 q6 0 6 6 v28 H0 Z"></path>
			<rect class="mii-sofa-leg" x="122" y="194" width="6" height="32"></rect>
			<rect class="mii-cushion" x="4" y="116" width="34" height="40" rx="7" transform="rotate(-8 21 136)"></rect>
			<!-- the speaker on its back -->
			<g data-spk>
				<rect class="mii-spk" x="196" y="211" width="44" height="15" rx="4"></rect>
				<path class="mii-spk-top" d="M199 211 q19 -5 38 0 Z"></path>
				<rect class="mii-spk-led" x="233" y="219" width="3" height="2" rx="0.6" data-led></rect>
			</g>
			<g data-notes></g>
			<!-- the teen -->
			<g data-phone-back></g>
			<g data-phone>
				<rect class="mii-phone" x="-1.2" y="-11" width="2.4" height="22" rx="1"></rect>
			</g>
			<g data-teen></g>
			<path class="mii-screen" d="" data-screen></path>
			<!-- the inset -->
			<path class="mii-loupe-line" d="M205 210 L247 120 M233 210 L330 112"></path>
			<circle class="mii-loupe" cx="285" cy="80" r="56"></circle>
			<clipPath id="mii-clip"><circle cx="285" cy="80" r="55"></circle></clipPath>
			<g clip-path="url(#mii-clip)">
				<rect class="mii-spk-face" x="225" y="20" width="120" height="120"></rect>
				<ellipse class="mii-surround" cx="285" cy="92" rx="47" ry="20"></ellipse>
				<g data-cone>
					<ellipse class="mii-cone" cx="285" cy="92" rx="40" ry="17"></ellipse>
					<ellipse class="mii-cone-in" cx="285" cy="95" rx="24" ry="10"></ellipse>
					<ellipse class="mii-cap" cx="285" cy="97" rx="11" ry="4.8"></ellipse>
				</g>
				<g data-grains></g>
			</g>
			<circle class="mii-loupe-rim" cx="285" cy="80" r="56"></circle>
		</svg>
		<div class="intro__foot">
			<p>
				Включили музыку —{' '}<More term="мембрана колонки дрожит">К мембране приклеена лёгкая катушка из тонкого провода, она сидит в узком зазоре кольцевого магнита. По катушке идёт ток, который меняется в такт музыке, и магнитное поле толкает её то вперёд, то назад — это [сила Ампера](#действие-магнитного-поля-на-проводник-с-током).</More>, и рисинки на ней подпрыгивают в такт.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="lamp">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Подросток у прикроватной тумбочки вкручивает лампочку в настольную лампу: берёт её сверху пальцами и поворачивает по часовой стрелке, несколько раз перехватывая. В круге — вид сверху со стрелкой поворота. Лампочка вкручивается и загорается; поворот против часовой стрелки — и она гаснет">
			<rect class="mii-wall2" x="0" y="0" width="360" height="236"></rect>
			<rect class="mii-skirt" x="0" y="231" width="360" height="5"></rect>
			<rect class="mii-floor" x="0" y="236" width="360" height="4"></rect>
			<!-- a poster with mountains -->
			<rect class="mii-frame" x="18" y="26" width="64" height="72" rx="1.5"></rect>
			<rect class="mii-sky" x="22" y="30" width="56" height="64"></rect>
			<path class="mii-mount" d="M22 94 L40 58 L50 72 L60 52 L78 94 Z"></path>
			<path class="mii-snow" d="M36 66 L40 58 L44 66 L41 64 Z M56 60 L60 52 L64 60 L60 58 Z"></path>
			<!-- the bed behind the teen -->
			<rect class="mii-bed" x="0" y="150" width="104" height="10" rx="3"></rect>
			<path class="mii-blanket" d="M0 156 H100 q6 0 6 6 v12 H0 Z"></path>
			<rect class="mii-bedframe" x="0" y="174" width="106" height="16"></rect>
			<rect class="mii-bedframe" x="98" y="190" width="7" height="46"></rect>
			<!-- the nightstand -->
			<rect class="mii-desk" x="170" y="155" width="70" height="5" rx="1.5"></rect>
			<rect class="mii-desk-side" x="173" y="160" width="64" height="70"></rect>
			<path class="mii-drawer" d="M177 166 h56 v24 h-56 Z M177 196 h56 v28 h-56 Z"></path>
			<circle class="mii-knob" cx="205" cy="178" r="2"></circle>
			<circle class="mii-knob" cx="205" cy="210" r="2"></circle>
			<rect class="mii-desk-side" x="175" y="230" width="5" height="6"></rect>
			<rect class="mii-desk-side" x="230" y="230" width="5" height="6"></rect>
			<!-- the shade lying beside the lamp -->
			<path class="mii-shade" d="M216 155 l4 -19 h15 l4 19 Z"></path>
			<path class="mii-shade-in" d="M220 136 h15"></path>
			<!-- the lamp and its cable to the wall socket -->
			<path class="mii-cable" d="M196 155 q-8 1 -14 4 M240 158 q14 4 18 22 q3 14 14 18"></path>
			<rect class="mii-outlet" x="268" y="192" width="12" height="14" rx="2"></rect>
			<ellipse class="mii-metal" cx="205" cy="155" rx="12" ry="2.6"></ellipse>
			<rect class="mii-metal" x="204" y="121" width="2.4" height="34"></rect>
			<rect class="mii-switch" x="210" y="151" width="5" height="3" rx="1"></rect>
			<rect class="mii-switch-on" x="211" y="151.5" width="2" height="2" rx="0.5"></rect>
			<g data-glow></g>
			<rect class="mii-socket" x="202" y="113" width="6.4" height="9" rx="1.2"></rect>
			<g data-bulb-back></g>
			<g data-bulb>
				<path class="mii-base" d="" data-base></path>
				<path class="mii-glass" d="" data-glass></path>
				<path class="mii-filament" d="" data-fil></path>
				<path class="mii-mark" d="" data-mark></path>
			</g>
			<g data-teen></g>
			<!-- the inset: the bulb seen from above -->
			<path class="mii-loupe-line" d="M207 102 L266 74"></path>
			<circle class="mii-loupe" cx="305" cy="62" r="42"></circle>
			<circle class="mii-glass-top" cx="305" cy="62" r="24" data-top></circle>
			<path class="mii-mark-top" d="" data-mark-top></path>
			<path class="mii-turn" d="" data-turn></path>
			<path class="mii-turn-head" d="" data-turn-head></path>
			<circle class="mii-loupe-rim" cx="305" cy="62" r="42"></circle>
		</svg>
		<div class="intro__foot">
			<p>
				Если смотреть сверху, лампочку поворачивают по часовой стрелке — она{' '}<More term="вкручивается в патрон">У почти всех лампочек, шурупов, винтов и болтов правая резьба: если вращать по часовой стрелке, глядя со стороны головки, винт уходит от нас. Так же связаны направление тока в проводе и направление его магнитных линий: [правило буравчика](#направление-магнитных-линий-тока).</More>{' '}и загорается, против часовой — выходит из него и гаснет.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<script>
	import { scene } from '@components/intro/scene';
	import { DEG, add, polar, type Pt } from '@components/people/core';
	import { figure, ANKLE_CM, type FigurePose, type HandTarget } from '@components/people/body';
	import { blendShape, handShape } from '@components/people/hand';
	import { attachAxis, ease } from '@components/people/motion';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = <K extends keyof SVGElementTagNameMap>(p: Element, tag: K, a: Record<string, string | number> = {}) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	const f = (v: number) => v.toFixed(1);
	const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
	const rand = (k: number) => {
		const s = Math.sin(k * 127.1 + 311.7) * 43758.5453;
		return s - Math.floor(s);
	};

	document.querySelectorAll<HTMLElement>('[data-miintro]').forEach((root) => {
		// ---------------- scene 1: the speaker
		{
			const card = root.querySelector<HTMLElement>('[data-scene="speaker"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 9;
			const S = 1.5;
			const FLOOR = 226;
			const TAP1 = 0.8; // the finger touches the screen
			const TAP2 = 7.5;
			const ON = 1.0; // the music starts
			const OFF = 7.6;
			const BEATS = Array.from({ length: 13 }, (_, k) => ON + 0.2 + 0.5 * k).filter((b) => b < OFF);
			const teen = figure($<SVGGElement>('[data-teen]'), { s: S, H: 158, age: 'teen', shirt: 'hm-green', hair: 'pony', name: 'speaker-teen' });
			teen.backLayer(1, $<SVGGElement>('[data-phone-back]'));
			const phone = $<SVGGElement>('[data-phone]');
			const screen = $<SVGPathElement>('[data-screen]');
			const led = $<SVGRectElement>('[data-led]');
			const cone = $<SVGGElement>('[data-cone]');
			const notes = $<SVGGElement>('[data-notes]');
			const noteEls = Array.from({ length: 4 }, (_, k) => {
				const t = mk(notes, 'text', { class: 'mii-note', 'text-anchor': 'middle' });
				t.textContent = k % 2 ? '♫' : '♪';
				return t;
			});
			// the grains on the cone: polar positions (ρ in parts of the cone radius, φ) and lengths
			const grainsG = $<SVGGElement>('[data-grains]');
			const GR = [
				[0.55, 0.4],
				[0.75, 2.2],
				[0.4, 3.5],
				[0.8, 4.6],
				[0.62, 5.5],
				[0.85, 1.2],
				[0.3, 2.8],
			].map(([r, p], k) => ({ r, p, a: rand(k + 3) * 180, el: mk(grainsG, 'ellipse', { class: 'mii-rice', rx: 3.5, ry: 1.5 }), sh: 0 }));
			const ankleY = FLOOR - ANKLE_CM.trainer * S;
			const u = S * 158;
			const seat = { x: 62, y: 160 - 0.04 * u };
			const hold: HandTarget = { at: { x: 104, y: 124 }, pose: 'grip', d: 7, dir: -25 * DEG, roll: -Math.PI / 2 + 0.25, contact: 'phone' };
			const base = (head: number): FigurePose => ({
				hip: seat,
				lean: 0.2,
				head,
				ankles: [{ x: 116, y: ankleY }, { x: 109, y: ankleY }],
				feet: [0, 0],
				hands: [{ at: { x: 98, y: 140 }, pose: 'relaxed' }, hold],
				planted: [true, true],
			});
			// the cone's displacement (px, up = −) at time t
			const coneY = (t: number) => {
				if (t < ON || t > OFF + 0.15) return 0;
				let y = 0;
				for (const b of BEATS) {
					const tau = t - b;
					if (tau >= 0 && tau < 0.3) y -= 3 * Math.exp(-tau / 0.05) * Math.cos((2 * Math.PI * tau) / 0.1);
				}
				return y + (t < OFF ? 0.5 * (rand(Math.floor(t * 60)) - 0.5) : 0);
			};
			scene(card, RUN, (x) => {
				const t = RUN * x;
				// the near hand: up to the screen and a tap, at TAP1 and TAP2 (0,5 s each way)
				const reach = (tt: number) => ease(clamp01((t - (tt - 0.5)) / 0.4)) * (1 - ease(clamp01((t - (tt + 0.15)) / 0.45)));
				const k = Math.max(reach(TAP1), reach(TAP2));
				const look = ease(clamp01((t - 1.3) / 0.6)) * (1 - ease(clamp01((t - 6.8) / 0.6)));
				const p0 = base(0.42 - 0.3 * look);
				const st0 = teen.pose(p0);
				const g = st0.grips[1];
				// a point on the screen (the phone's near face, toward the eyes), as in the kit's gallery
				const scr: Pt = { x: g.x - g.axis.x * 2 * S - 2.2 * S, y: g.y - g.axis.y * 2 * S - 0.6 * S };
				const rest: Pt = { x: 98, y: 140 };
				const bump = Math.max(0, 1 - Math.min(Math.abs(t - TAP1), Math.abs(t - TAP2)) / 0.14);
				const lift = 3 * S * (1 - bump);
				const goal: Pt = { x: scr.x - lift * 0.4, y: scr.y - lift };
				const at: Pt = { x: rest.x + (goal.x - rest.x) * k, y: rest.y + (goal.y - rest.y) * k };
				const near: HandTarget = k > 0.02 ? { at, pose: 'tap', dir: 12 * DEG, roll: -0.5, shape: blendShape(handShape('relaxed'), handShape('tap'), ease(clamp01(k * 1.4))), contact: bump > 0.9 ? 'screen' : undefined } : { at: rest, pose: 'relaxed' };
				const st = teen.pose({ ...p0, hands: [near, hold] });
				attachAxis(phone, st.grips[1]);
				// the phone's screen lights while the music plays
				const playing = t > ON && t < OFF;
				const ax = st.grips[1].axis;
				const sx = st.grips[1].x;
				const sy = st.grips[1].y;
				const nx = ax.y;
				const ny = -ax.x;
				const c = (a: number, b: number) => `${f(sx + ax.x * a + nx * b)} ${f(sy + ax.y * a + ny * b)}`;
				screen.setAttribute('d', `M${c(-9.5 * 1, 1.3)}L${c(9.5, 1.3)}`);
				screen.classList.toggle('is-on', playing);
				led.classList.toggle('is-on', playing);
				// the cone and the grains
				const cy = coneY(t);
				cone.setAttribute('transform', `translate(0 ${f(cy)})`);
				GR.forEach((gr, i) => {
					// the last beat that launched it and the flight since then
					let up = 0;
					for (const b of BEATS) {
						const tau = t - b - 0.012;
						if (tau < 0) break;
						const h = 3 + 8 * rand(i * 31 + b * 7.3); // мм
						const v = Math.sqrt(2 * 9.8 * h * 1e-3);
						const T = (2 * v) / 9.8;
						if (tau < T) up = (v * tau - 0.5 * 9.8 * tau * tau) * 1000; // мм
					}
					const R = 40 * gr.r;
					const px = 285 + R * Math.cos(gr.p);
					const depth = 6 * (1 - gr.r); // the cone is deeper toward the center
					const py = 92 + R * 0.42 * Math.sin(gr.p) + depth + (up > 0 ? 0 : cy);
					const spin = up > 0 ? gr.a + up * 25 : gr.a;
					gr.el.setAttribute('cx', f(px));
					gr.el.setAttribute('cy', f(py - up * 0.9));
					gr.el.setAttribute('transform', `rotate(${f(spin)} ${f(px)} ${f(py - up * 0.9)})`);
				});
				// the notes rise from the speaker while it plays
				noteEls.forEach((n, i) => {
					const ph = (t - ON) * 0.45 + i * 0.25;
					const q = ph - Math.floor(ph);
					const vis = playing && t - ON > i * 0.55 ? Math.sin(Math.PI * q) : 0;
					n.setAttribute('x', f(218 + (i % 2 ? 12 : -6) + 6 * Math.sin(ph * 6)));
					n.setAttribute('y', f(204 - 40 * q));
					n.style.opacity = (0.85 * vis).toFixed(2);
				});
			});
		}

		// ---------------- scene 2: the lamp
		{
			const card = root.querySelector<HTMLElement>('[data-scene="lamp"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 8.6;
			const S = 1.45;
			const FLOOR = 236;
			const BX = 205; // the bulb's axis
			const SOCK = 113; // the top of the socket (a nightstand 55 см + a lamp 30 см)
			const IX = 305; // the inset's center
			const IY = 62;
			const RG = 3 * S; // the glass radius (A60: 6 см)
			const teen = figure($<SVGGElement>('[data-teen]'), { s: S, H: 160, age: 'teen', shirt: 'hm-gold', hair: 'short', name: 'lamp-teen' });
			teen.backLayer(0, $<SVGGElement>('[data-bulb-back]'));
			const u = S * 160;
			const ankleY = FLOOR - ANKLE_CM.trainer * S;
			const legL = (0.245 + 0.246) * u;
			const hip = { x: 130, y: ankleY - legL * 0.99 };
			const Lh = teen.bones.hand;
			const dLh = (2 * RG) / Lh;
			const sh = teen.shoulders(hip, 0.22);
			const hang: Pt = add(sh[0], polar(0.37 * u, Math.PI / 2 - 4 * DEG));
			const hangFar: Pt = add(sh[1], polar(0.37 * u, Math.PI / 2 + 2 * DEG));
			// strokes: [start, end] of each twist, the angle turned (+ = clockwise from above)
			const T_REACH = 0.9;
			const STROKE = 0.45;
			const REGRIP = 0.35;
			const strokes: { t0: number; dpsi: number }[] = [];
			let tt = T_REACH + 0.15;
			for (let k = 0; k < 4; k++) {
				strokes.push({ t0: tt, dpsi: 90 });
				tt += STROKE + REGRIP;
			}
			const T_LIT = strokes[3].t0 + STROKE;
			tt += 0.6; // a moment with the light on
			strokes.push({ t0: tt, dpsi: -90 });
			const T_OUT = tt + STROKE * 0.6;
			const T_LEAVE = tt + STROKE + 0.2;
			// the bulb's turn ψ (deg, clockwise from above) and the hand's phase at time t
			const state = (t: number) => {
				let psi = 0;
				let grip = 1;
				for (let k = 0; k < strokes.length; k++) {
					const s = strokes[k];
					const e = ease(clamp01((t - s.t0) / STROKE));
					psi += s.dpsi * e;
					if (t >= s.t0 + STROKE && t < s.t0 + STROKE + REGRIP && k < strokes.length - 1) {
						// regrip: open, turn back, close (the turn back is in `phase` below)
						const r = (t - s.t0 - STROKE) / REGRIP;
						grip = 1 - Math.sin(Math.PI * r) * 0.9;
					}
				}
				return { psi, grip };
			};
			const glow = $<SVGGElement>('[data-glow]');
			const halo = mk(glow, 'circle', { class: 'mii-halo', cx: BX, cy: SOCK - 4.6 * S, r: 30 });
			const base = $<SVGPathElement>('[data-base]');
			const glass = $<SVGPathElement>('[data-glass]');
			const fil = $<SVGPathElement>('[data-fil]');
			const mark = $<SVGPathElement>('[data-mark]');
			const markTop = $<SVGPathElement>('[data-mark-top]');
			const top = $<SVGCircleElement>('[data-top]');
			const turn = $<SVGPathElement>('[data-turn]');
			const turnHead = $<SVGPathElement>('[data-turn-head]');
			const bulbAt = (psi: number) => {
				// one turn (360°) lowers the bulb by the pitch 3,6 мм; it starts one turn out
				const yb = SOCK - (1 - psi / 360) * 0.36 * S; // the bottom of the visible base
				const gc = yb - 2.2 * S - RG; // the glass center
				return { yb, gc };
			};
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const st = state(t);
				const { yb, gc } = bulbAt(st.psi);
				const lit = t > T_LIT && t < T_OUT;
				// the bulb: base (2,2 см visible, 2,7 см wide), neck and glass
				base.setAttribute('d', `M${f(BX - 1.35 * S)} ${f(yb)} V${f(yb - 2.2 * S)} H${f(BX + 1.35 * S)} V${f(yb)} Z M${f(BX - 1.35 * S)} ${f(yb - 0.7 * S)} H${f(BX + 1.35 * S)} M${f(BX - 1.35 * S)} ${f(yb - 1.4 * S)} H${f(BX + 1.35 * S)}`);
				glass.setAttribute('d', `M${f(BX - 1.35 * S)} ${f(yb - 2.2 * S)} Q${f(BX - 1.5 * S)} ${f(gc + RG * 0.6)} ${f(BX - RG)} ${f(gc)} A${f(RG)} ${f(RG)} 0 1 1 ${f(BX + RG)} ${f(gc)} Q${f(BX + 1.5 * S)} ${f(gc + RG * 0.6)} ${f(BX + 1.35 * S)} ${f(yb - 2.2 * S)} Z`);
				fil.setAttribute('d', `M${f(BX - 1)} ${f(yb - 2.4 * S)} V${f(gc + 1)} M${f(BX + 1)} ${f(yb - 2.4 * S)} V${f(gc + 1)} M${f(BX - 2.5)} ${f(gc + 1)} H${f(BX + 2.5)}`);
				card.classList.toggle('is-lit', lit);
				halo.style.opacity = lit ? '1' : '0';
				// the printed mark on the glass goes round with the bulb; seen only on the front half
				const a = (st.psi + 40) * DEG;
				const mz = Math.cos(a);
				const mx = BX + RG * 0.8 * Math.sin(a);
				mark.setAttribute('d', mz > 0.15 ? `M${f(mx - 1.2 * mz)} ${f(gc - 1)} h${f(2.4 * mz)} M${f(mx - 1.2 * mz)} ${f(gc + 1)} h${f(2.4 * mz)}` : '');
				// the inset: the bulb from above (we look down; the viewer of the main picture is at the bottom)
				const ca = IX + 17 * Math.sin(a);
				const cb = IY + 17 * Math.cos(a);
				markTop.setAttribute('d', `M${f(ca - 3 * Math.cos(a))} ${f(cb + 3 * Math.sin(a))} L${f(ca + 3 * Math.cos(a))} ${f(cb - 3 * Math.sin(a))}`);
				top.classList.toggle('is-lit', lit);
				let dir = 0;
				for (const s of strokes) if (t >= s.t0 - 0.05 && t <= s.t0 + STROKE + 0.05) dir = Math.sign(s.dpsi);
				if (dir) {
					// clockwise on the inset is the turn that screws the bulb in
					const a0 = -Math.PI / 2 - (dir > 0 ? 0.9 : -0.9);
					const a1 = -Math.PI / 2 + (dir > 0 ? 0.9 : -0.9);
					let d = '';
					for (let k = 0; k <= 12; k++) {
						const q = a0 + ((a1 - a0) * k) / 12;
						d += `${k ? 'L' : 'M'}${f(IX + 33 * Math.cos(q))} ${f(IY + 33 * Math.sin(q))}`;
					}
					turn.setAttribute('d', d);
					const hx = IX + 33 * Math.cos(a1);
					const hy = IY + 33 * Math.sin(a1);
					const tx = -Math.sin(a1) * dir;
					const ty = Math.cos(a1) * dir;
					turnHead.setAttribute('d', `M${f(hx + tx * 6)} ${f(hy + ty * 6)} L${f(hx - ty * 4.5)} ${f(hy + tx * 4.5)} L${f(hx + ty * 4.5)} ${f(hy - tx * 4.5)} Z`);
				} else {
					turn.setAttribute('d', '');
					turnHead.setAttribute('d', '');
				}
				// the teen: reach to the bulb, twist with the hand's roll, regrip, let go and drop the arm
				const roll0 = Math.PI; // the palm toward the bulb, the fingers down round it
				// the hand's turn: within a stroke it turns with the bulb, between the strokes it turns back
				let phase = 0; // deg, the hand's turn about the bulb's axis, clockwise from above (= −roll)
				for (const s of strokes) {
					const e = ease(clamp01((t - s.t0) / STROKE));
					if (t >= s.t0 && t <= s.t0 + STROKE) phase = -45 * Math.sign(s.dpsi) + s.dpsi * e;
					else if (t > s.t0 + STROKE) phase = 45 * Math.sign(s.dpsi);
				}
				// between strokes: back from +45 to −45 (or the reverse) while open
				for (let k = 0; k < strokes.length - 1; k++) {
					const s = strokes[k];
					const r = (t - s.t0 - STROKE) / REGRIP;
					if (r >= 0 && r <= 1) {
						const from = 45 * Math.sign(s.dpsi);
						const to = -45 * Math.sign(strokes[k + 1].dpsi);
						phase = from + (to - from) * ease(r);
					}
				}
				if (t < strokes[0].t0) phase = -45;
				const roll = roll0 - phase * DEG;
				const reachK = ease(clamp01((t - 0.1) / (T_REACH - 0.1))) * (1 - ease(clamp01((t - T_LEAVE) / 0.8)));
				const gripK = t < T_REACH ? ease(clamp01((t - T_REACH + 0.3) / 0.3)) : t > T_LEAVE ? 1 - ease(clamp01((t - T_LEAVE) / 0.25)) : st.grip;
				const shape = blendShape(handShape('open'), handShape('grip', dLh), gripK);
				const target: Pt = { x: BX, y: gc };
				const near: HandTarget =
					reachK > 0.02
						? { at: { x: hang.x + (target.x - hang.x) * reachK, y: hang.y + (target.y - hang.y) * reachK }, pose: 'grip', d: 6, dir: 90 * DEG, roll: roll * reachK + 1.5 * Math.PI * (1 - reachK), shape, contact: gripK > 0.9 && reachK > 0.99 ? 'bulb' : undefined }
						: { at: hang, pose: 'relaxed' };
				teen.pose({ hip, lean: 0.22, head: 0.45, ankles: [{ x: hip.x + 6, y: ankleY }, { x: hip.x - 5, y: ankleY }], feet: [0, 0], hands: [near, { at: hangFar, pose: 'relaxed' }], planted: [true, true] });
			});
		}
	});
</script>

