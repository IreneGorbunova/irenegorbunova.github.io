---
/**
 * The left-hand rule on the gap of «Проводник на качелях» (SwingLab), two panels side by side (stacked on a narrow
 * phone), with two toggles: «Сменить направление тока» and «Перевернуть магнит».
 *   left, «Вид спереди»: the gap seen along the rod: the upper and the lower pole, the gray lines between them, the rod
 *     end-on with ⊗ (current away from us) or ⊙ (toward us), the gold arrow of the force on it;
 *   right, «Вид сверху»: the same gap seen from above with the upper pole taken away: the lines go away from us (⊗,
 *     N on top) or come toward us (⊙, S on top); the rod lies up the picture (away from the front viewer = up); a LEFT
 *     hand (people kit) lies next to it with the four fingers along the current, the palm toward the upper N pole so
 *     that the lines go into it, and the thumb set out at 90° in the plane of the palm: it points along the force.
 * The hand is only ever ROTATED, never mirrored, so it stays a left hand: turning the current turns it by 180° in the
 * picture (fingers down); turning the magnet over turns it palm down (its back toward us).
 * Physics: F = I·l × B (x right, y up, z toward the front viewer). N on top: B = −y. Current away (−z):
 * (−z) × (−y) = −x, the force to the left; toward us: to the right; the magnet turned over: the opposite. The same
 * signs as SwingLab. In the top view x stays to the right and −z (away from the front viewer) is up the picture.
 * Not to scale: the hand is drawn large, next to the rod.
 */
import PeopleStyles from '@components/people/PeopleStyles.astro';
---

<PeopleStyles />
<figure class="lhp not-content" data-lhp>
	<div class="lhp__ctrl">
		<button type="button" class="lhp__btn" data-rev>Сменить направление тока</button>
		<button type="button" class="lhp__btn" data-flip>Перевернуть магнит</button>
	</div>
	<div class="lhp__panels">
		<div>
			<svg class="lhp__svg" viewBox="0 0 300 300" role="img" aria-label="Вид спереди: между полюсами магнита проходят магнитные линии, проводник виден с торца, стрелка показывает силу, действующую на него" data-front></svg>
			<p class="lhp__cap">Вид спереди</p>
		</div>
		<div>
			<svg class="lhp__svg" viewBox="0 0 300 300" role="img" aria-label="Вид сверху: левая рука лежит рядом с проводником, четыре пальца направлены по току, магнитные линии входят в ладонь, отставленный большой палец показывает направление силы" data-top>
				<g data-bg></g>
				<g data-arm></g>
				<g data-hand></g>
				<g data-marks></g>
			</svg>
			<p class="lhp__cap">Вид сверху (верхний полюс убран)<br /><span class="lhp__tag" data-tag>левая рука, ладонь</span></p>
		</div>
	</div>
	<figcaption class="lhp__legend">
		<span><i class="lhp__sw lhp__sw--i"></i>ток</span>
		<span><i class="lhp__sw lhp__sw--b"></i>магнитные линии</span>
		<span><i class="lhp__sw lhp__sw--f"></i>сила, действующая на проводник</span>
	</figcaption>
</figure>

<script>
	import { fingerPts, hand, handPoint, type V3 } from '@components/people/hand';
	import { forearm, place, thumbOut } from './grip';
	import { loop } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = <K extends keyof SVGElementTagNameMap>(p: Element, tag: K, a: Record<string, string | number> = {}, text?: string) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		if (text !== undefined) e.textContent = text;
		p.append(e);
		return e;
	};
	const f = (v: number) => v.toFixed(1);
	const SHAPE = thumbOut();
	const PALM: [number, number, number] = [0.42, -0.055, 0];
	const LH = 116;
	const arrowPath = (x1: number, y1: number, x2: number, y2: number, s = 11) => {
		const l = Math.hypot(x2 - x1, y2 - y1);
		const ux = (x2 - x1) / l;
		const uy = (y2 - y1) / l;
		const bx = x2 - ux * s;
		const by = y2 - uy * s;
		return { shaft: `M${f(x1)} ${f(y1)}L${f(bx + ux * 2)} ${f(by + uy * 2)}`, head: `M${f(x2)} ${f(y2)}L${f(bx - uy * s * 0.5)} ${f(by + ux * s * 0.5)}L${f(bx + uy * s * 0.5)} ${f(by - ux * s * 0.5)}Z` };
	};

	document.querySelectorAll<HTMLElement>('[data-lhp]').forEach((root) => {
		const front = root.querySelector<SVGSVGElement>('[data-front]')!;
		const top = root.querySelector<SVGSVGElement>('[data-top]')!;
		const part = (k: string) => top.querySelector<SVGGElement>(`[data-${k}]`)!;
		let away = true; // the current goes away from the front viewer (⊗)
		let nTop = true;
		let chev: SVGPathElement[] = [];
		let t = 0;

		const build = () => {
			// F along x: −1 left, +1 right
			const fx = (away ? -1 : 1) * (nTop ? 1 : -1);
			// ---- the front view
			front.replaceChildren();
			const up = nTop ? 'n' : 's';
			const dn = nTop ? 's' : 'n';
			mk(front, 'rect', { class: `lhp__pole lhp__pole--${up}`, x: 30, y: 22, width: 240, height: 52, rx: 4 });
			mk(front, 'rect', { class: `lhp__pole lhp__pole--${dn}`, x: 30, y: 226, width: 240, height: 52, rx: 4 });
			mk(front, 'text', { class: 'lhp__pl', x: 150, y: 56, 'text-anchor': 'middle' }, nTop ? 'N' : 'S');
			mk(front, 'text', { class: 'lhp__pl', x: 150, y: 260, 'text-anchor': 'middle' }, nTop ? 'S' : 'N');
			for (let k = 0; k < 7; k++) {
				const x = 48 + k * 34;
				mk(front, 'path', { class: 'lhp__line', d: `M${x} 74V226` });
				const yy = k % 2 ? 112 : 196;
				const d = nTop ? 1 : -1;
				mk(front, 'path', { class: 'lhp__head', d: `M${x} ${yy + 6 * d}L${x - 4.5} ${yy - 5 * d}L${x + 4.5} ${yy - 5 * d}Z` });
			}
			mk(front, 'circle', { class: 'lhp__rod', cx: 150, cy: 150, r: 17 });
			if (away) mk(front, 'path', { class: 'lhp__cur', d: 'M140 140L160 160M160 140L140 160' });
			else mk(front, 'circle', { class: 'lhp__dot', cx: 150, cy: 150, r: 4.5 });
			const fa = arrowPath(150 + fx * 20, 150, 150 + fx * 100, 150);
			mk(front, 'path', { class: 'lhp__f', d: fa.shaft });
			mk(front, 'path', { class: 'lhp__fh', d: fa.head });
			mk(front, 'text', { class: 'lhp__fl', x: 150 + fx * 74, y: 140, 'text-anchor': 'middle' }, 'F');
			// ---- the top view
			for (const k of ['bg', 'arm', 'hand', 'marks']) part(k).replaceChildren();
			const bg = part('bg');
			mk(bg, 'rect', { class: `lhp__face lhp__face--${dn}`, x: 20, y: 20, width: 260, height: 260, rx: 6 });
			for (let i = 0; i < 6; i++)
				for (let j = 0; j < 6; j++) {
					const x = 42 + i * 43;
					const y = 42 + j * 43;
					if (nTop) mk(bg, 'path', { class: 'lhp__x', d: `M${x - 5} ${y - 5}L${x + 5} ${y + 5}M${x + 5} ${y - 5}L${x - 5} ${y + 5}` });
					else mk(bg, 'circle', { class: 'lhp__xd', cx: x, cy: y, r: 2.6 });
					mk(bg, 'circle', { class: 'lhp__xc', cx: x, cy: y, r: 8 });
				}
			// the rod up the picture at x = 118
			mk(bg, 'rect', { class: 'lhp__rodtop', x: 109, y: -2, width: 18, height: 304 });
			mk(bg, 'rect', { class: 'lhp__rodhi', x: 112, y: -2, width: 4, height: 304 });
			chev = [0, 1, 2, 3, 4].map(() => mk(bg, 'path', { class: 'lhp__chev' }));
			// the left hand next to the rod: fingers along the current, palm toward the N pole
			const dir = away ? -Math.PI / 2 : Math.PI / 2;
			const palmToUs = nTop; // N above us (taken away): the lines go away from us and come into a palm facing us
			const roll = palmToUs ? Math.PI / 2 : -Math.PI / 2;
			const at = { x: 186, y: 150 };
			const wrist = place('L', at, dir, roll, LH, PALM);
			const arm = forearm(wrist, dir, LH, 2.2);
			mk(part('arm'), 'path', { class: 'hm-skin lhp__arm', d: arm.skin });
			mk(part('arm'), 'path', { class: 'lhp__sleeve', d: arm.sleeve });
			const h = hand(part('hand'), { cls: 'hm-skin', side: 'L', Lh: LH });
			h.set({ wrist, dir, roll }, SHAPE, 'flat');
			// cues that tell the palm from the back (the two views are mirror images): palm creases, or nails
			const fr = { wrist, dir, roll };
			const hp = (p: V3) => handPoint('L', fr, LH, p);
			const line = (ps: V3[]) => ps.map((p, i) => `${i ? 'L' : 'M'}${f(hp(p).x)} ${f(hp(p).y)}`).join('');
			if (palmToUs) {
				const y = -0.057;
				mk(part('hand'), 'path', { class: 'lhp__crease', d: line([[0.41, y, -0.17], [0.38, y, -0.04], [0.39, y, 0.06], [0.42, y, 0.14]]) });
				mk(part('hand'), 'path', { class: 'lhp__crease', d: line([[0.31, y, 0.13], [0.32, y, 0.0], [0.34, y, -0.12]]) });
				mk(part('hand'), 'path', { class: 'lhp__crease', d: line([[0.3, y, 0.135], [0.2, y, 0.11], [0.12, y, 0.06], [0.06, y, 0.0]]) });
			} else {
				for (let i = 0; i < 4; i++) {
					const q = fingerPts(i, SHAPE);
					const a = q[2];
					const b = q[3];
					const c: V3 = [a[0] + (b[0] - a[0]) * 0.55, 0.05, a[2] + (b[2] - a[2]) * 0.55];
					const s = hp(c);
					const e = hp([c[0] + 0.05, c[1], c[2]]);
					const ang = (Math.atan2(e.y - s.y, e.x - s.x) * 180) / Math.PI;
					mk(part('hand'), 'ellipse', { class: 'lhp__nail', cx: f(s.x), cy: f(s.y), rx: f(0.045 * LH), ry: f(0.03 * LH), transform: `rotate(${f(ang)} ${f(s.x)} ${f(s.y)})` });
				}
			}
			root.querySelector('[data-tag]')!.textContent = palmToUs ? 'левая рука, ладонь' : 'левая рука, тыльная сторона';
			// the force beside the thumb, from the rod
			// the force on the rod, drawn where the hand is not (beyond its fingertips), parallel to the thumb
			const fy = away ? 44 : 256;
			const ta = arrowPath(118 + fx * 12, fy, 118 + fx * 92, fy);
			const mks = part('marks');
			mk(mks, 'path', { class: 'lhp__f', d: ta.shaft });
			mk(mks, 'path', { class: 'lhp__fh', d: ta.head });
			mk(mks, 'text', { class: 'lhp__fl', x: 118 + fx * 62, y: fy - 10, 'text-anchor': 'middle' }, 'F');
		};
		const draw = () => {
			chev.forEach((e, k) => {
				const s = ((t * 30 + k * 64) % 320) - 10;
				const y = away ? 300 - s : s;
				const d = away ? -1 : 1;
				e.setAttribute('d', `M${f(110)} ${f(y - 7 * d)}L118 ${f(y)}L126 ${f(y - 7 * d)}`);
			});
		};
		build();
		draw();
		const wake = loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		root.querySelector('[data-rev]')!.addEventListener('click', () => {
			away = !away;
			build();
			draw();
			wake();
		});
		root.querySelector('[data-flip]')!.addEventListener('click', () => {
			nTop = !nTop;
			build();
			draw();
			wake();
		});
	});
</script>

<style>
	.lhp {
		--lhp-i: var(--sl-color-green);
		--lhp-f: var(--ig-v);
		--lhp-cu: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		margin: 1.25rem 0 1.75rem;
		padding: 0.8rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lhp__ctrl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.5rem;
	}
	.lhp__btn {
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.lhp__panels {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@media (max-width: 30rem) {
		.lhp__panels {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.lhp__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
	}
	.lhp__cap {
		margin: 0.35rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	.lhp__tag {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.lhp :global(.lhp__crease) {
		fill: none;
		stroke: color-mix(in srgb, var(--hm-skin) 55%, black);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.lhp :global(.lhp__nail) {
		fill: color-mix(in srgb, var(--hm-skin) 45%, white);
		stroke: color-mix(in srgb, var(--hm-skin) 55%, black);
		stroke-width: 0.6;
	}
	.lhp__legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.lhp__sw {
		display: inline-block;
		width: 1.4rem;
		height: 0.2rem;
		margin-right: 0.35rem;
		vertical-align: middle;
	}
	.lhp__sw--i {
		background: var(--lhp-i);
	}
	.lhp__sw--b {
		background: var(--sl-color-gray-2);
	}
	.lhp__sw--f {
		background: var(--lhp-f);
	}
	.lhp :global(.lhp__pole--n) {
		fill: var(--ig-vx);
	}
	.lhp :global(.lhp__pole--s) {
		fill: var(--ig-vy);
	}
	.lhp :global(.lhp__pl) {
		fill: white;
		font-weight: 700;
		font-size: 24px;
		font-family: var(--__sl-font);
	}
	.lhp :global(.lhp__line) {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.lhp :global(.lhp__head) {
		fill: var(--sl-color-gray-2);
	}
	.lhp :global(.lhp__rod) {
		fill: var(--lhp-cu);
		stroke: color-mix(in srgb, var(--lhp-cu) 60%, black);
		stroke-width: 1;
	}
	.lhp :global(.lhp__cur) {
		stroke: var(--lhp-i);
		stroke-width: 3.5;
		stroke-linecap: round;
	}
	.lhp :global(.lhp__dot) {
		fill: var(--lhp-i);
	}
	.lhp :global(.lhp__f) {
		stroke: var(--lhp-f);
		stroke-width: 4;
	}
	.lhp :global(.lhp__fh) {
		fill: var(--lhp-f);
	}
	.lhp :global(.lhp__fl) {
		fill: var(--lhp-f);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 600;
		font-size: 22px;
	}
	.lhp :global(.lhp__face--s) {
		fill: color-mix(in srgb, var(--ig-vy) 16%, transparent);
	}
	.lhp :global(.lhp__face--n) {
		fill: color-mix(in srgb, var(--ig-vx) 16%, transparent);
	}
	.lhp :global(.lhp__x) {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.lhp :global(.lhp__xd) {
		fill: var(--sl-color-gray-2);
	}
	.lhp :global(.lhp__xc) {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.lhp :global(.lhp__rodtop) {
		fill: var(--lhp-cu);
	}
	.lhp :global(.lhp__rodhi) {
		fill: color-mix(in srgb, var(--lhp-cu) 55%, white);
		opacity: 0.6;
	}
	.lhp :global(.lhp__chev) {
		fill: none;
		stroke: var(--lhp-i);
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lhp :global(.lhp__arm) {
		stroke-width: 0.8;
	}
	.lhp :global(.lhp__sleeve) {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 80%, var(--ig-vx));
		stroke: var(--hm-line);
		stroke-width: 0.8;
	}
</style>
