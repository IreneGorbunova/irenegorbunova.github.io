---
/**
 * «Человек на снегу»: a person of a chosen mass (30…100 кг) stands on loose snow in boots (two soles of 150 см²:
 * 0,03 м²), on skis (two of 180 × 8 см: 0,29 м²), on snowshoes (two of 60 × 25 см: 0,30 м²... shown as 0,3 м²)
 * or on skates on ice (two blades of 27 × 0,3 см: 0,0016 м²). The pressure is p = F/S with F = g·m.
 *
 * The picture: the person in profile (person.ts), drawn at 0,95 px per centimeter, stands at the front face of the
 * snow, which is cut along his footprints, so the depth of the footprint shows in the cut: the hole, the compressed
 * snow under the sole, a bracket from the surface to the sole. The depth grows with the pressure, 1,3 см per kPa,
 * at most 42 см (it is only an illustration: real snow differs; the caption says so). Boots at 60 кг: 19,6 кПа,
 * 25 см; skis: 2,0 кПа, 2,6 см; snowshoes: 2,0 кПа, 2,5 см. The person grows with the mass, as people do: 30 кг —
 * 138 см (a pupil), 45 кг — 155 см, 60 кг — 167 см, 80 кг — 176 см, 100 кг — 181 см (linear in between), and the
 * build follows the body-mass index m/h² (the body is √(BMI/21,5) times as thick as an average one); the footwear
 * keeps its size. On ice the skater does not sink (ice under 0,4 МПа does not give way); the number is what matters.
 */
import G7Styles from '../g7/G7Styles.astro';

const layers = 'M0 207 Q60 205 120 208 T240 206 T320 207 M0 226 Q70 228 140 225 T280 227 T320 226 M0 245 Q50 242 110 246 T230 244 T320 245';
const firs = [
	{ x: 22, h: 40 },
	{ x: 58, h: 30 },
	{ x: 272, h: 44 },
	{ x: 302, h: 32 },
];
const fir = (x: number, h: number) => {
	let tree = `M${x - 0.05 * h} 0 h${0.1 * h} v${-0.15 * h} h${-0.1 * h} Z `;
	let snow = '';
	for (let i = 0; i < 3; i++) {
		const top = -h + i * 0.26 * h;
		const bot = top + 0.46 * h;
		const w = 0.17 * h + 0.09 * h * i;
		tree += `M${x} ${top} L${x + w} ${bot} L${x - w} ${bot} Z `;
		snow += `M${x} ${top} L${x + w * 0.45} ${top + 0.21 * h} Q${x} ${top + 0.15 * h} ${x - w * 0.45} ${top + 0.21 * h} Z `;
	}
	return { tree, snow };
};
const trees = firs.map((t) => fir(t.x, t.h));
---

<G7Styles />
<figure class="g7 prs not-content" data-prs>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 320 260" role="img" aria-label="Человек стоит на снегу; снег показан в разрезе, и видно, как глубоко провалилась опора: тем глубже, чем больше давление" data-svg>
			<rect class="prs__sky" x="0" y="0" width="320" height="260"></rect>
			<path class="prs__hill" d="M0 152 Q60 134 130 143 T260 138 T320 142 V152 Z"></path>
			<g transform="translate(0 153)">
				<path class="prs__tree" d={trees.map((t) => t.tree).join(' ')}></path>
				<path class="prs__tree-snow" d={trees.map((t) => t.snow).join(' ')}></path>
			</g>
			<rect class="prs__field" data-field x="0" y="150" width="320" height="40"></rect>
			<path class="prs__gloss" data-gloss d="M30 160 h60 M120 172 h90 M230 164 h50 M60 182 h40"></path>
			<path class="prs__mark" data-mark></path>
			<rect class="prs__cut" data-cut x="0" y="190" width="320" height="70"></rect>
			<rect class="prs__water" data-water x="0" y="228" width="320" height="32"></rect>
			<path class="prs__layer" data-layer d={layers}></path>
			<path class="prs__hole" data-hole></path>
			<path class="prs__pack" data-pack></path>
			<g data-man></g>
			<g data-depth>
				<path class="prs__bracket" data-bracket></path>
				<text class="prs__on-snow" data-dtext>след</text>
			</g>
			<text class="t-strong t-num t-halo" x="312" y="24" text-anchor="end" data-p></text>
			<text class="t-small t-halo" x="312" y="40" text-anchor="end">давление на опору</text>
			<text class="prs__on-snow" x="8" y="254" data-ground>снег в разрезе</text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="На чём стоит человек" data-kind>
				<button type="button" class="g7__btn" aria-pressed="true" data-k="boots">Ботинки</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-k="skis">Лыжи</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-k="shoes">Снегоступы</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-k="skates">Коньки на льду</button>
			</div>
			<label class="g7__slider">
				<span>Масса человека</span>
				<output data-out></output>
				<input type="range" min="30" max="100" step="5" value="60" data-m aria-label="Масса человека, килограммы" />
			</label>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Снег и лёд показаны в разрезе. Глубина следа в снегу на рисунке условная: чем больше давление, тем глубже; настоящий снег бывает разным.
	</figcaption>
</figure>

<style is:global>
	[data-prs] {
		--prs-field: hsl(212, 30%, 82%);
		--prs-cut: hsl(212, 30%, 72%);
		--prs-layer: hsl(212, 30%, 66%);
		--prs-hole: hsl(218, 30%, 42%);
		--prs-pack: hsl(212, 32%, 78%);
		--prs-ice: hsl(196, 55%, 70%);
		--prs-ice-cut: hsl(198, 50%, 58%);
		--prs-water: hsl(208, 50%, 32%);
		--prs-tree: hsl(150, 30%, 30%);
		--prs-hill: hsl(214, 22%, 34%);
		--pp-skin: hsl(26, 55%, 72%);
		--pp-line: hsl(222, 35%, 14%);
		--pp-pants: hsl(225, 25%, 34%);
		--pp-boot: hsl(24, 38%, 34%);
		--pp-fur: hsl(36, 40%, 84%);
		--pp-hat: var(--ig-v);
		--pp-scarf: hsl(150, 50%, 50%);
	}
	:root[data-theme='light'] [data-prs] {
		--prs-field: hsl(210, 45%, 96%);
		--prs-cut: hsl(210, 40%, 89%);
		--prs-layer: hsl(210, 35%, 82%);
		--prs-hole: hsl(214, 30%, 62%);
		--prs-pack: hsl(210, 42%, 94%);
		--prs-ice: hsl(196, 60%, 86%);
		--prs-ice-cut: hsl(198, 55%, 76%);
		--prs-water: hsl(208, 45%, 52%);
		--prs-tree: hsl(150, 35%, 32%);
		--prs-hill: hsl(205, 30%, 82%);
		--pp-line: hsl(222, 30%, 22%);
		--pp-pants: hsl(225, 30%, 30%);
	}
	.prs__sky {
		fill: var(--g7-sky);
	}
	.prs__hill {
		fill: var(--prs-hill);
	}
	.prs__tree {
		fill: var(--prs-tree);
	}
	.prs__tree-snow {
		fill: var(--prs-field);
	}
	.prs__field {
		fill: var(--prs-field);
	}
	.prs__field.is-ice {
		fill: var(--prs-ice);
	}
	.prs__gloss {
		stroke: white;
		stroke-width: 1.4;
		stroke-linecap: round;
		opacity: 0.6;
	}
	.prs__cut {
		fill: var(--prs-cut);
	}
	.prs__cut.is-ice {
		fill: var(--prs-ice-cut);
	}
	.prs__water {
		fill: var(--prs-water);
	}
	.prs__layer {
		fill: none;
		stroke: var(--prs-layer);
		stroke-width: 1;
	}
	.prs__hole {
		fill: var(--prs-hole);
	}
	.prs__pack {
		fill: var(--prs-pack);
	}
	.prs__mark {
		fill: color-mix(in oklab, var(--prs-hole) 60%, var(--prs-field));
	}
	.prs__bracket {
		fill: none;
		stroke: var(--pp-line);
		stroke-width: 1.3;
	}
	.g7__svg .prs__on-snow {
		font-size: 11px;
		font-weight: 600;
		fill: var(--pp-line);
	}
	.g7__svg .prs__on-snow.is-ice {
		fill: white;
	}
	/* the person (person.ts) */
	[data-prs] .pp-far {
		filter: brightness(0.78);
	}
	[data-prs] .pp-outline {
		fill: none;
		stroke: var(--pp-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-prs] .pp-pants,
	[data-prs] .pp-sleeve {
		fill: none;
		stroke: var(--pp-pants);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-prs] .pp-sleeve.prs-coat {
		stroke: var(--g7-red);
	}
	[data-prs] .pp-coat {
		fill: var(--g7-red);
		stroke: var(--pp-line);
		stroke-width: 0.8;
	}
	[data-prs] .pp-zip {
		fill: none;
		stroke: var(--pp-line);
		stroke-width: 0.7;
		opacity: 0.6;
	}
	[data-prs] .pp-skin {
		fill: var(--pp-skin);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-prs] .pp-ear {
		stroke-width: 0.5;
	}
	[data-prs] .pp-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-prs] .pp-eye {
		fill: var(--pp-line);
	}
	[data-prs] .pp-mouth {
		fill: none;
		stroke: var(--pp-line);
		stroke-width: 0.7;
		stroke-linecap: round;
	}
	[data-prs] .pp-hair {
		fill: hsl(25, 40%, 28%);
	}
	[data-prs] .pp-hat,
	[data-prs] .pp-pompom,
	[data-prs] .pp-mitten {
		fill: var(--pp-hat);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-prs] .pp-hat-band {
		fill: color-mix(in oklab, var(--pp-hat) 70%, var(--pp-line));
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-prs] .pp-scarf {
		fill: var(--pp-scarf);
		stroke: var(--pp-line);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	[data-prs] .pp-boot {
		fill: var(--pp-boot);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-prs] .pp-sole,
	[data-prs] .pp-bind,
	[data-prs] .pp-strap {
		fill: var(--pp-line);
	}
	[data-prs] .pp-cuff {
		fill: var(--pp-fur);
	}
	[data-prs] .pp-ski {
		fill: var(--g7-blue);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-prs] .pp-shoe {
		fill: color-mix(in oklab, var(--prs-hole) 35%, transparent);
		stroke: hsl(28, 45%, 40%);
		stroke-width: 2.4;
	}
	[data-prs] .pp-shoe-rim {
		fill: none;
		stroke: hsl(28, 50%, 48%);
		stroke-width: 2.6;
	}
	[data-prs] .pp-lattice {
		fill: none;
		stroke: hsl(28, 30%, 30%);
		stroke-width: 0.9;
	}
	[data-prs] .pp-blade {
		fill: hsl(210, 12%, 82%);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-prs] .pp-holder {
		fill: hsl(210, 10%, 60%);
	}
	[data-prs] .pp-lace {
		fill: none;
		stroke: var(--pp-fur);
		stroke-width: 0.8;
	}
	[data-prs] .pp-pole {
		fill: none;
		stroke: hsl(220, 10%, 62%);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
</style>

<script>
	import { fmt, fmtInt, k, segment, tex } from '../g7/kit';
	import { ANKLE, person, type Gear, type Pt } from './person';

	const KIND: Record<string, { S: number; name: string; gear: Gear; from: number; to: number }> = {
		// from, to: the part of the footwear that presses the snow, см from the ankle
		boots: { S: 0.03, name: 'две подошвы по 150 см²', gear: 'boot', from: -8, to: 21.5 },
		skis: { S: 0.29, name: 'две лыжи 180 × 8 см', gear: 'ski', from: -86, to: 84 },
		shoes: { S: 0.3, name: 'два снегоступа 60 × 25 см', gear: 'shoe', from: -24, to: 36 },
		skates: { S: 0.0016, name: 'два лезвия 27 × 0,3 см', gear: 'skate', from: -9.5, to: 22 },
	};
	// height (см) against mass (кг), typical values
	const HM = [
		[30, 138],
		[45, 155],
		[60, 167],
		[80, 176],
		[100, 181],
	];
	const height = (m: number) => {
		for (let i = 1; i < HM.length; i++) {
			if (m <= HM[i][0]) {
				const [m0, h0] = HM[i - 1];
				const [m1, h1] = HM[i];
				return h0 + ((h1 - h0) * (m - m0)) / (m1 - m0);
			}
		}
		return HM[HM.length - 1][1];
	};
	const S = 0.95; // px per centimeter
	const SURF = 190; // the surface of the snow, px
	const X0 = 150; // the ankle between the feet, px
	const f = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-prs]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const mIn = q<HTMLInputElement>('[data-m]');
		let kind = 'boots';
		const draw = () => {
			const K = KIND[kind];
			const m = Number(mIn.value);
			const F = 9.8 * m;
			const p = F / K.S;
			const ice = kind === 'skates';
			const depthCm = ice ? 0 : Math.min(42, (p / 1000) * 1.3);
			const d = depthCm * S; // px
			for (const s of ['[data-field]', '[data-cut]']) q(s).classList.toggle('is-ice', ice);
			q<SVGElement>('[data-water]').style.display = ice ? '' : 'none';
			q<SVGElement>('[data-gloss]').style.display = ice ? '' : 'none';
			q<SVGElement>('[data-layer]').style.display = ice ? 'none' : '';
			q('[data-ground]').textContent = ice ? 'лёд в разрезе' : 'снег в разрезе';
			q('[data-ground]').classList.toggle('is-ice', ice);

			// the person: taller and heavier with the mass
			const H = height(m);
			const bmi = m / (H / 100) ** 2;
			const girth = Math.sqrt(bmi / 21.5);
			const pose = person(q<SVGGElement>('[data-man]'), { s: S, H, girth, gear: K.gear, coat: 'prs-coat', poles: kind === 'skis' });
			const ya = SURF + d - ANKLE[K.gear] * S;
			const ank: [Pt, Pt] = [
				{ x: X0 + 6 * S, y: ya },
				{ x: X0 - 6 * S, y: ya - 1 },
			];
			const hip = { x: X0 + 1, y: ya - 0.472 * H * S };
			const lean = 0.03;
			const sh = { x: hip.x + Math.sin(lean) * 0.27 * H * S, y: hip.y - Math.cos(lean) * 0.27 * H * S };
			const poles = kind === 'skis';
			const hand = (phi: number, r: number): Pt => ({ x: sh.x + Math.sin(phi) * r, y: sh.y + Math.cos(phi) * r });
			const hands: [Pt, Pt] = poles ? [hand(0.75, 0.28 * H * S), hand(-0.1, 0.3 * H * S)] : [hand(0.14, 0.34 * H * S), hand(0.02, 0.34 * H * S)];
			let poleTips: [Pt, Pt] | undefined;
			if (poles) {
				const Lp = 0.83 * H * S;
				const tip = (h: Pt, side: number): Pt => {
					const grip = { x: h.x + 0.02 * H * S, y: h.y - 0.035 * H * S };
					const ty = SURF + 10;
					const dy = ty - grip.y;
					return { x: grip.x + side * Math.sqrt(Math.max(0, Lp * Lp - dy * dy)), y: ty };
				};
				poleTips = [tip(hands[0], 0.35), tip(hands[1], -0.35)];
			}
			pose({ hip, lean, ankles: ank, feet: [0, 0], hands, poleTips });

			// the footprint in the cut: a hole as deep as the sole went, compressed snow under it
			const xl = X0 + (K.from - 6) * S;
			const xr = X0 + (K.to + 6) * S;
			const hole = q<SVGPathElement>('[data-hole]');
			const pack = q<SVGPathElement>('[data-pack]');
			const mark = q<SVGPathElement>('[data-mark]');
			const bracket = q<SVGPathElement>('[data-bracket]');
			const dtext = q<SVGTextElement>('[data-dtext]');
			if (d > 0.3) {
				const yb = SURF + d;
				const w = Math.min(4, d * 0.4);
				hole.setAttribute('d', `M${f(xl - w)} ${SURF} L${f(xl)} ${f(yb)} L${f(xr)} ${f(yb)} L${f(xr + w)} ${SURF} Z`);
				const pk = Math.min(9, 1.5 + d * 0.25);
				pack.setAttribute('d', `M${f(xl)} ${f(yb)} L${f(xr)} ${f(yb)} Q${f(xr + 3)} ${f(yb + pk)} ${f(xr - 8)} ${f(yb + pk)} L${f(xl + 8)} ${f(yb + pk)} Q${f(xl - 3)} ${f(yb + pk)} ${f(xl)} ${f(yb)} Z`);
				mark.setAttribute('d', `M${f(xl - w)} ${SURF} A${f((xr - xl) / 2 + w)} ${f(Math.min(5, 1 + d * 0.15))} 0 0 1 ${f(xr + w)} ${SURF} Z`);
			} else {
				hole.setAttribute('d', '');
				pack.setAttribute('d', '');
				mark.setAttribute('d', '');
			}
			if (d >= 6) {
				const bx = xr + 10;
				bracket.setAttribute('d', `M${f(bx - 4)} ${SURF} H${f(bx + 4)} M${f(bx)} ${SURF} V${f(SURF + d)} M${f(bx - 4)} ${f(SURF + d)} H${f(bx + 4)}`);
				dtext.setAttribute('x', f(bx + 7));
				dtext.setAttribute('y', f(SURF + d / 2 + 4));
				dtext.style.display = '';
			} else {
				bracket.setAttribute('d', '');
				dtext.style.display = 'none';
			}

			q('[data-out]').textContent = `${m}\u00a0кг`;
			// one rounding for the label and the formula: to 1 кПа above 100 кПа, to 100 Па above 1 кПа, else to 10 Па
			const pr = p >= 99950 ? Math.round(p / 1000) * 1000 : p >= 995 ? Math.round(p / 100) * 100 : Math.round(p / 10) * 10;
			q('[data-p]').textContent = pr >= 1000 ? `${fmt(pr / 1000, pr >= 100000 ? 0 : 1)}\u00a0кПа` : `${fmtInt(pr)}\u00a0Па`;
			q('[data-lines]').innerHTML = [
				`<li class="is-text">Опора: ${K.name}.</li>`,
				`<li>${k(`F = gm = 9{,}8 \\cdot ${m} = ${tex(fmt(F, 0))}~\\text{Н}`)}</li>`,
				`<li>${k(`S = ${tex(String(K.S).replace('.', ','))}~\\text{м}^2`)}</li>`,
				`<li class="is-key">${k(`p = \\dfrac{F}{S} = \\dfrac{${tex(fmt(F, 0))}}{${tex(String(K.S).replace('.', ','))}} \\approx ${tex(fmtInt(pr))}~\\text{Па}`)}</li>`,
			].join('');
		};
		mIn.addEventListener('input', draw);
		segment(q('[data-kind]'), (b) => {
			kind = b.dataset.k!;
			draw();
		});
		draw();
	}
</script>
