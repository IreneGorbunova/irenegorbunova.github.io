---
/**
 * Picture «Как передают давление твёрдое тело и жидкость» (Irina, 21 Nov 2026: «рисунок сравнения твёрдых тел с
 * жидкостями/газами» for «Твёрдые тела ведут себя иначе…»). Two panels with the same piston and the same force F
 * (blue, the applied force, as F₁ in the press model):
 *  - Твёрдое тело: a column of particles bound into a lattice (bonds drawn) stands on a support, with no walls. The
 *    push runs down the columns of particles (a pulse, lit blue), and the column presses only on the support under
 *    it: red arrows only there, along the force. Its sides push on nothing (the slight sideways bulge of a real solid
 *    is far too small to draw).
 *  - Жидкость или газ: free particles in a closed vessel under the same piston. The pressure added by the piston is the
 *    same everywhere (Pascal's law): equal red arrows on the bottom, on both walls at three heights, and up on the
 *    piston itself. The weight of the liquid is left out (it adds pressure that grows with depth; the next chapter).
 * The forces of pressure are red, as everywhere in this chapter. Particle sizes and their jiggling are a cartoon (5 × 7
 * free particles in a jittered grid): real molecules are about 10⁻¹⁰ м, tens of millions of times smaller; the squeeze of the column is exaggerated to 1,5 px. Cycle 6 с: the piston presses
 * (0,3…0,9 с), the pulse runs down (0,6…1,5 с), the arrows grow (1,2…1,8 с), stay, fade out (4,8…5,4 с).
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
// the solid: 6 columns × 8 rows, 13 px apart, bottom row on the support at y = 186
const COLS = 6;
const ROWS = 8;
const STEP = 13;
const SX = 90 - ((COLS - 1) * STEP) / 2;
const SY0 = 186 - 7; // centers of the bottom row
const solid: { x: number; y: number; r: number; c: number }[] = [];
for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) solid.push({ x: SX + c * STEP, y: SY0 - r * STEP, r, c });
const bonds: string[] = [];
for (const p of solid) {
	if (p.c < COLS - 1) bonds.push(`M${p.x} ${p.y} h${STEP}`);
	if (p.r < ROWS - 1) bonds.push(`M${p.x} ${p.y} v${-STEP}`);
}
const solidTop = SY0 - (ROWS - 1) * STEP - 7; // the top of the column
// the liquid: the same piston width as the column; the vessel inside x ∈ [228, 312], y ∈ [solidTop, 186]
const VX0 = 228;
const VX1 = 312;
// arrows: [x, y, dx, dy] at the wall (the arrow points out of the liquid; the upward ones stand under the piston)
const wallArrows = [
	...[0.2, 0.5, 0.8].map((u) => [VX0 + 6 + u * (VX1 - VX0 - 12), 186, 0, 1]),
	...[0.25, 0.55, 0.85].flatMap((u) => [
		[VX0, solidTop + 8 + u * (186 - solidTop - 8), -1, 0],
		[VX1, solidTop + 8 + u * (186 - solidTop - 8), 1, 0],
	]),
	...[0.2, 0.5, 0.8].map((u) => [VX0 + 6 + u * (VX1 - VX0 - 12), solidTop - 1, 0, -1]),
];
const solidArrows = [0, 2, 3, 5].map((c) => [SX + c * STEP, 186, 0, 1]);
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow sl not-content" data-dz-solliq>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 236" role="img" aria-label="Поршень давит вниз на столбик твёрдого тела и на жидкость в сосуде. Твёрдое тело давит только вниз на опору, жидкость давит одинаково на дно, на стенки и вверх на поршень">
			<defs>
				<clipPath id={`sl-in-${uid}`}><rect x={VX0} y={solidTop} width={VX1 - VX0} height={186 - solidTop}></rect></clipPath>
			</defs>
			<text class="t-title" x="90" y="18" text-anchor="middle">твёрдое тело</text>
			<text class="t-title" x="270" y="18" text-anchor="middle">жидкость или газ</text>
			<path class="ln-dash" d="M180 28 V226"></path>

			<!-- the solid: support, column, piston -->
			<rect class="sl__support" x="30" y="186" width="120" height="10" rx="1.5"></rect>
			<g data-solid>
				<path class="sl__bond" d={bonds.join(' ')}></path>
				{solid.map((p) => <circle class="sl__atom" r="5" cx={p.x} cy={p.y} data-r={p.r} data-x={p.x} data-y={p.y} />)}
			</g>
			<g data-piston="s">
				<rect class="sl__piston" x={SX - 9} y={solidTop - 9} width={(COLS - 1) * STEP + 18} height="8" rx="2"></rect>
				<rect class="sl__rod" x="87" y={solidTop - 35} width="6" height="26"></rect>
			</g>

			<!-- the liquid: vessel, particles, piston -->
			<rect class="sl__liquid" x={VX0} y={solidTop} width={VX1 - VX0} height={186 - solidTop} data-liq></rect>
			<g clip-path={`url(#sl-in-${uid})`} data-free></g>
			<path class="sl__wall" d={`M${VX0 - 2} ${solidTop - 30} V${188} H${VX1 + 2} V${solidTop - 30}`}></path>
			<g data-piston="l">
				<rect class="sl__piston" x={VX0} y={solidTop - 9} width={VX1 - VX0} height="8" rx="2"></rect>
				<rect class="sl__rod" x="267" y={solidTop - 35} width="6" height="26"></rect>
			</g>

			<!-- the forces -->
			{[90, 270].map((x) => (
				<g data-f>
					<line class="arrow arrow--blue" x1={x} x2={x} />
					<path class="head--blue" />
					<text class="t-i t-blue t-halo" x={x + 8}>F</text>
				</g>
			))}
			{solidArrows.map(([x, y, dx, dy]) => <path class="sl__p" data-p={`${x} ${y} ${dx} ${dy}`} />)}
			{wallArrows.map(([x, y, dx, dy]) => <path class="sl__p" data-p={`${x} ${y} ${dx} ${dy}`} />)}
			<text class="t-small" x="90" y="214" text-anchor="middle">давит только вниз,</text>
			<text class="t-small" x="90" y="227" text-anchor="middle">вдоль силы</text>
			<text class="t-small" x="270" y="214" text-anchor="middle">давит во все стороны</text>
			<text class="t-small" x="270" y="227" text-anchor="middle">одинаково</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Поршень давит одинаково на столбик твёрдого тела и на жидкость. Частицы твёрдого тела связаны друг с другом, и толчок идёт по ним только вниз, на опору. Частицы жидкости и газа свободно сдвигаются, и давление поршня доходит до дна, до стенок и даже до самого поршня снизу — во всех направлениях одинаковое. Частицы нарисованы условно, во много миллионов раз крупнее настоящих.
	</figcaption>
</figure>

<style is:global>
	.sl__support {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.sl__bond {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.sl__atom {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.sl__atom.is-hit {
		fill: var(--g7-blue);
	}
	.sl__piston {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.sl__rod {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.sl__liquid {
		fill: var(--g7-water);
	}
	.sl__mol {
		fill: var(--g7-water-edge);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.sl__wall {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.sl__p {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop, NS, rng } from '../g7/kit';

	const CYCLE = 6;
	const LEN = 16; // px, the full length of a red arrow
	const F_LEN = 18; // px, the blue arrow (its tail stays clear of the panel titles)
	const f = (v: number) => v.toFixed(1);
	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	const ramp = (t: number, a: number, b: number) => clamp((t - a) / (b - a));

	for (const root of document.querySelectorAll<HTMLElement>('[data-dz-solliq]')) {
		const liq = root.querySelector<SVGRectElement>('[data-liq]')!;
		const x0 = Number(liq.getAttribute('x'));
		const y0 = Number(liq.getAttribute('y'));
		const w = Number(liq.getAttribute('width'));
		const h = Number(liq.getAttribute('height'));
		// the free particles: a jittered grid (so they fill the vessel evenly), each wanders on its own Lissajous path
		const rand = rng(7);
		const free = root.querySelector('[data-free]')!;
		const mols: { e: SVGCircleElement; x: number; y: number; ax: number; ay: number; wx: number; wy: number; ph: number }[] = [];
		for (let i = 0; i < 5; i++)
			for (let j = 0; j < 7; j++) {
				const e = document.createElementNS(NS, 'circle');
				e.setAttribute('class', 'sl__mol');
				e.setAttribute('r', '5');
				free.append(e);
				mols.push({
					e,
					x: x0 + 7 + (i + 0.5) * ((w - 14) / 5) + (rand() - 0.5) * 6,
					y: y0 + 6 + (j + 0.5) * ((h - 12) / 7) + (rand() - 0.5) * 5,
					ax: 0.8 + rand(),
					ay: 0.8 + rand(),
					wx: 1.5 + 2 * rand(),
					wy: 1.5 + 2 * rand(),
					ph: 6.3 * rand(),
				});
			}
		const atoms = [...root.querySelectorAll<SVGCircleElement>('.sl__atom')].map((e) => ({
			e,
			r: Number(e.dataset.r),
			x: Number(e.dataset.x),
			y: Number(e.dataset.y),
			ph: 6.3 * rand(),
		}));
		const rows = Math.max(...atoms.map((a) => a.r)) + 1;
		const pistons = [...root.querySelectorAll<SVGGElement>('[data-piston]')];
		const forces = [...root.querySelectorAll<SVGGElement>('[data-f]')];
		const arrows = [...root.querySelectorAll<SVGPathElement>('[data-p]')].map((e) => ({ e, v: e.dataset.p!.split(' ').map(Number) }));
		let t = 0;
		const draw = () => {
			const press = ramp(t, 0.3, 0.9) * (1 - ramp(t, 4.8, 5.4)); // 0…1, the force of the hand
			const shown = ramp(t, 1.2, 1.8) * (1 - ramp(t, 4.8, 5.4)); // the arrows of pressure
			const squeeze = 1.5 * press; // px, exaggerated
			// only the solid gives a little; the liquid is practically not compressed
			pistons[0].setAttribute('transform', `translate(0 ${f(squeeze)})`);
			forces.forEach((g, i) => {
				const x = Number(g.querySelector('line')!.getAttribute('x1'));
				const yEnd = y0 - 36 + (i === 0 ? squeeze : 0);
				const L = F_LEN * press;
				g.style.opacity = press > 0.05 ? '1' : '0';
				g.querySelector('line')!.setAttribute('y1', f(yEnd - L));
				g.querySelector('line')!.setAttribute('y2', f(yEnd - 6));
				g.querySelector('path')!.setAttribute('d', `M${f(x - 5)} ${f(yEnd - 8)} L${f(x)} ${f(yEnd)} L${f(x + 5)} ${f(yEnd - 8)} Z`);
				g.querySelector('text')!.setAttribute('y', f(yEnd - L / 2 + 4));
			});
			// the pulse runs down the solid from the top row (rows − 1) to the bottom (0)
			const front = (t - 0.6) / 0.9; // 0…1 over 0,6…1,5 с
			for (const a of atoms) {
				const u = (rows - 1 - a.r) / (rows - 1);
				const hit = Math.abs(front - u) < 0.12;
				a.e.classList.toggle('is-hit', hit);
				const dy = squeeze * (a.r / (rows - 1)); // the column is squeezed evenly
				a.e.setAttribute('cx', f(a.x + 0.5 * Math.sin(9 * t + a.ph)));
				a.e.setAttribute('cy', f(a.y + dy + 0.5 * Math.cos(11 * t + a.ph)));
			}
			for (const m of mols) {
				m.e.setAttribute('cx', f(m.x + m.ax * Math.sin(m.wx * t + m.ph)));
				m.e.setAttribute('cy', f(m.y + m.ay * Math.cos(m.wy * t + 1.7 * m.ph)));
			}
			for (const { e, v } of arrows) {
				const [x, y, dx, dy] = v;
				const L = LEN * shown;
				if (L < 3) {
					e.setAttribute('d', '');
					continue;
				}
				// the arrow starts at the wall and points out of the body; under the piston it ends at the piston
				const yy = dy < 0 ? y + 1 + L : y;
				const ex = x + dx * L;
				const ey = yy + dy * L;
				const px = -dy;
				const py = dx;
				e.setAttribute(
					'd',
					`M${f(x)} ${f(yy)} L${f(ex)} ${f(ey)} M${f(ex - dx * 4 + px * 3.5)} ${f(ey - dy * 4 + py * 3.5)} L${f(ex)} ${f(ey)} L${f(ex - dx * 4 - px * 3.5)} ${f(ey - dy * 4 - py * 3.5)}`,
				);
			}
		};
		draw();
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		});
	}
</script>
