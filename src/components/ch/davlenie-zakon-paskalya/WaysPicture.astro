<style is:global>
	.ways {
		--w-rubber: var(--sl-color-gray-5);
		--w-dark: hsl(225, 25%, 30%);
		--w-snow: hsl(210, 30%, 84%);
		--w-crumb: hsl(42, 55%, 80%);
		--w-crust: hsl(30, 60%, 45%);
		--w-bird: var(--sl-color-gray-4);
		--w-birdlight: var(--sl-color-gray-1);
		--w-beaver: color-mix(in oklab, var(--ig-v) 30%, hsl(20, 35%, 32%));
		--w-bark: color-mix(in oklab, var(--g7-wood-dark) 60%, var(--sl-color-gray-4));
	}
	:root[data-theme='light'] .ways {
		--w-rubber: var(--sl-color-gray-2);
		--w-dark: hsl(225, 25%, 26%);
