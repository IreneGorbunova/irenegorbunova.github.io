<script>
	import { loop, ease } from '../g7/kit';
	import { ANKLE, person, type Pt } from './person';

	// rails: 50 px per metre
	const L = 37.5; // px, the characteristic length of the track (0,75 м)
	const SP = 0.543 * 50;
	const SHARE = SP / (2 * L); // share of the sleeper right under a wheel (≈ 0,36)
	const W0 = 4; // px, the sag under one wheel (exaggerated about 40 times)
	const eta = (x: number) => {
		const u = Math.abs(x) / L;
		return Math.exp(-u) * (Math.cos(u) + Math.sin(u));
	};
	const V_TRAIN = 40; // px/s = 0,8 м/с
	const WB = 46.25; // half the wheelbase, px
	const R_WHEEL = 23.75;
	const RAIL_TOP = 160 - 11.5 - 9;
	// tractor: drawn at 30 px per metre, shown at 42 px per metre; 5 км/ч
	const SC = 1.4;
	const V_TR = 1.39 * 42;
	const X_FROM = -168;
	// the person on one foot: 167 см at 0,42 px per cm
	const PS = 0.42;
	const PH = 167;
	const PX = 214;
	const T_DRIVE = -X_FROM / V_TR;
	const T_TR = T_DRIVE + 3.2 + 0.6;
	// snow: 1,2 px per cm; boot 40 см, snowshoe 5 см
	const SS = 108;
	const DEPTH = { boot: 48, shoe: 6 };
	const T_SNOW = 5;
	// knife
	const T_KNIFE = 6.5;
	// pin: 5 px per мм, the point is 8 мм long
	const T_PIN = 5.5;
	// woodpecker: bursts of 6 blows per second
	const T_BIRD = 2.6;

	const f = (v: number) => v.toFixed(2);
	const dome = (u: number) => 126 - 22 * Math.sqrt(Math.max(0, 1 - u * u));

	for (const root of document.querySelectorAll<HTMLElement>('[data-ways]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s);
		const steps: ((t: number) => void)[] = [];

		// ---- rails
		const rails = q<SVGSVGElement>('[data-p="rails"]');
		if (rails) {
			const bogie = rails.querySelector<SVGGElement>('[data-bogie]')!;
			const wheels = [...rails.querySelectorAll<SVGGElement>('[data-wheel]')];
			const spins = [...rails.querySelectorAll<SVGGElement>('[data-spin]')];
			const sl = [...rails.querySelectorAll<SVGGElement>('[data-sleepers] > g')];
			const ar = [...rails.querySelectorAll<SVGGElement>('[data-arrows] > g')];
			const rail = rails.querySelector<SVGPathElement>('[data-rail]')!;
			const railLine = rails.querySelector<SVGPathElement>('[data-railline]')!;
			const span = 240 + 2 * 60;
			steps.push((t) => {
				const xc = -60 + ((t * V_TRAIN) % span);
				const xs = [xc - WB, xc + WB];
				const w = (x: number) => W0 * (eta(x - xs[0]) + eta(x - xs[1]));
				bogie.setAttribute('transform', `translate(${f(xc)} ${f(w(xc) * 0.5)})`);
				wheels.forEach((g, i) => g.setAttribute('transform', `translate(${f(xs[i] - xc)} ${f(RAIL_TOP - R_WHEEL + w(xs[i]) - w(xc) * 0.5)})`));
				for (const s of spins) s.setAttribute('transform', `rotate(${f(((t * V_TRAIN) / R_WHEEL) * (180 / Math.PI))})`);
				let top = '';
				let bot = '';
				let line = '';
				for (let x = -4; x <= 244; x += 4) {
					const y = w(x);
					top += `${top ? 'L' : 'M'}${x} ${f(RAIL_TOP + y)} `;
					bot = `L${x} ${f(RAIL_TOP + 9 + y)} ` + bot;
					line += `${line ? 'L' : 'M'}${x} ${f(RAIL_TOP + 4 + y)} `;
				}
				rail.setAttribute('d', `${top}${bot.replace(/^L/, 'L')}Z`);
				railLine.setAttribute('d', line);
				sl.forEach((g, i) => {
					const x = Number(g.dataset.x);
					const share = SHARE * (eta(x - xs[0]) + eta(x - xs[1]));
					g.setAttribute('transform', `translate(0 ${f(w(x))})`);
					const a = Math.max(0, Math.min(1, share / SHARE));
					(g.children[1] as SVGRectElement).setAttribute('opacity', f(a));
					const len = share > 0.02 ? 15 * a : 0;
					const y0 = 163 + w(x);
					(ar[i].children[0] as SVGPathElement).setAttribute('d', `M${f(x)} ${f(y0)} V${f(y0 + len)}`);
					(ar[i].children[1] as SVGPathElement).setAttribute('d', len > 0 ? `M${f(x - 3)} ${f(y0 + len - 1)} L${f(x)} ${f(y0 + len + 4)} L${f(x + 3)} ${f(y0 + len - 1)} Z` : '');
					ar[i].setAttribute('opacity', len > 0 ? '1' : '0');
				});
			});
		}

		// ---- tractor
		const tr = q<SVGSVGElement>('[data-p="tractor"]');
		if (tr) {
			const body = tr.querySelector<SVGGElement>('[data-tractor]')!;
			const trk = tr.querySelector<SVGPathElement>('[data-track]')!;
			const lugs = tr.querySelector<SVGLineElement>('[data-lugs]')!;
			const spr = [tr.querySelector<SVGGElement>('[data-sprocket]')!, tr.querySelector<SVGGElement>('[data-idler]')!];
			const sprBase = spr.map((g) => g.getAttribute('transform')!);
			const R = (180 - 108) / (2 * Math.PI);
			// the person stands on the near foot; the far leg is lifted behind, the arms keep the balance
			const pose = person(tr.querySelector<SVGGElement>('[data-man]')!, { s: PS, H: PH, girth: 1, gear: 'boot', coat: 'ways-coat' });
			const ya = 156 - ANKLE.boot * PS;
			const hip = { x: PX - 1, y: ya - 0.472 * PH * PS };
			const sh = { x: hip.x, y: hip.y - 0.27 * PH * PS };
			const hand = (phi: number, r: number): Pt => ({ x: sh.x + Math.sin(phi) * r, y: sh.y + Math.cos(phi) * r });
			pose({
				hip,
				lean: 0.04,
				ankles: [
					{ x: PX, y: ya },
					{ x: PX - 0.16 * PH * PS, y: ya - 0.25 * PH * PS },
				],
				feet: [0, 0.7],
				hands: [hand(1.25, 0.33 * PH * PS), hand(-1.15, 0.33 * PH * PS)],
			});
			steps.push((t) => {
				const tt = t % T_TR;
				const X = X_FROM + V_TR * Math.min(tt, T_DRIVE);
				const fade = tt > T_TR - 0.6 ? (T_TR - tt) / 0.6 : 1;
				body.setAttribute('transform', `translate(${f(X)} 0)`);
				body.setAttribute('opacity', f(fade));
				trk.setAttribute('stroke-dashoffset', f((X - X_FROM) / SC));
				lugs.setAttribute('x1', f(X_FROM + 30 * SC));
				lugs.setAttribute('x2', f(X + 84 * SC));
				lugs.setAttribute('opacity', f(fade));
				spr.forEach((g, i) => g.setAttribute('transform', `${sprBase[i]} rotate(${f((((X - X_FROM) / SC / R) * 180) / Math.PI)})`));
			});
		}

		// ---- snowshoe
		const snow = q<SVGSVGElement>('[data-p="snow"]');
		if (snow) {
			const feet = [...snow.querySelectorAll<SVGGElement>('[data-foot]')];
			const steps2 = snow.querySelector<SVGGElement>('[data-steps]')!;
			const xs = { boot: 58, shoe: 170 };
			steps.push((t) => {
				const tt = t % T_SNOW;
				const down = ease(tt / 0.7);
				const sink = 1 - (1 - Math.min(1, Math.max(0, (tt - 0.7) / 1.1))) ** 2.2;
				const fade = tt > T_SNOW - 0.5 ? (T_SNOW - tt) / 0.5 : tt < 0.25 ? tt / 0.25 : 1;
				steps2.setAttribute('opacity', f(fade));
				for (const g of feet) {
					const k = g.dataset.foot as 'boot' | 'shoe';
					const d = DEPTH[k] * sink;
					const y = SS - 16 * (1 - down) + d;
					g.querySelector('[data-leg]')!.setAttribute('transform', `translate(${xs[k]} ${f(y)})`);
					g.querySelector('[data-pit]')!.setAttribute('height', f(Math.max(0, d)));
				}
			});
		}

		// ---- knife
		const kn = q<SVGSVGElement>('[data-p="knife"]');
		if (kn) {
			const sharp = kn.querySelector<SVGGElement>('[data-knife="sharp"]')!;
			const blunt = kn.querySelector<SVGGElement>('[data-knife="blunt"]')!;
			const loaf = kn.querySelector<SVGPathElement>('[data-loaf]')!;
			const loafClip = kn.querySelector<SVGPathElement>('[data-loafclip]')!;
			const cut = kn.querySelector<SVGPathElement>('[data-cut]')!;
			const loafD = (ys: number) => {
				let d = `M136 172 Q130 172 130 166 V126`;
				for (let i = 0; i <= 28; i++) {
					const u = -1 + (2 * i) / 28;
					d += ` L${f(165 + 35 * u)} ${f(Math.max(dome(u), ys))}`;
				}
				return `${d} V166 Q200 172 194 172 Z`;
			};
			steps.push((t) => {
				const tt = t % T_KNIFE;
				const fade = tt > T_KNIFE - 0.5 ? (T_KNIFE - tt) / 0.5 : 1;
				// the sharp knife: from touching the top (edge at 104) to the board (edge at 168)
				const a = ease((tt - 0.6) / 3.2);
				const jig = tt > 0.6 && tt < 3.8 ? 2.5 * Math.sin(tt * 9) : 0;
				const yEdge = 104 + 64 * a;
				sharp.setAttribute('transform', `translate(${f(jig)} ${f(yEdge - 16)})`);
				cut.setAttribute('d', `M75 104 V${f(Math.max(104, yEdge - 16))}`);
				// the blunt one: the spine flattens the top of the loaf by 7 px and stops
				const b = ease((tt - 0.6) / 0.9);
				const ySpine = 104 + 7 * b;
				blunt.setAttribute('transform', `translate(0 ${f(ySpine - 16)})`);
				const d = loafD(ySpine);
				loaf.setAttribute('d', d);
				loafClip.setAttribute('d', d);
				sharp.setAttribute('opacity', f(fade));
				blunt.setAttribute('opacity', f(fade));
			});
		}

		// ---- scissors
		const tools = q<SVGSVGElement>('[data-p="tools"]');
		if (tools) {
			const b1 = tools.querySelector<SVGGElement>('[data-blade="1"]')!;
			const b2 = tools.querySelector<SVGGElement>('[data-blade="2"]')!;
			const sc = tools.querySelector<SVGGElement>('[data-scissors]')!;
			const pc = tools.querySelector<SVGPathElement>('[data-papercut]')!;
			const T_CUT = 1.4;
			const N = 4;
			steps.push((t) => {
				const n = Math.floor(t / T_CUT) % (N + 1);
				const ph = (t % T_CUT) / T_CUT;
				const open = n === N ? 1 : 0.5 + 0.5 * Math.cos(2 * Math.PI * ph);
				const ang = 3 + 15 * open;
				b1.setAttribute('transform', `rotate(${f(-ang)})`);
				b2.setAttribute('transform', `rotate(${f(ang)})`);
				// each closing advances the cut by 20 px; between the cuts the scissors move on
				const done = n === N ? N : n + (ph > 0.5 ? ease((ph - 0.5) * 2) : 0);
				const cut = 20 * done;
				sc.setAttribute('transform', `translate(${f(120 + 20 * Math.min(n, N) - 4)} 196)`);
				pc.setAttribute('d', `M120 196 H${f(120 + cut)}`);
			});
		}

		// ---- pin
		const pin = q<SVGSVGElement>('[data-p="pin"]');
		if (pin) {
			const p = pin.querySelector<SVGGElement>('[data-pin]')!;
			const th = pin.querySelector<SVGGElement>('[data-thumb]')!;
			const hole = pin.querySelector<SVGPathElement>('[data-pinhole]')!;
			const lead = pin.querySelector<SVGPathElement>('[data-tiplead]')!;
			steps.push((t) => {
				const tt = t % T_PIN;
				const fade = tt > T_PIN - 0.5 ? (T_PIN - tt) / 0.5 : 1;
				const tdown = ease(tt / 0.8);
				const inn = ease((tt - 0.9) / 2);
				const yHead = 110 + 40 * inn; // the head's underside: from 110 to the board at 150
				p.setAttribute('transform', `translate(0 ${f(yHead)})`);
				th.setAttribute('transform', `translate(${f(80 - 33 * 0.5)} ${f(yHead - 7 - 33 * (1 - Math.cos(Math.PI / 6)) - 24 * (1 - tdown))})`);
				th.setAttribute('opacity', f(fade));
				hole.setAttribute('d', `M80 150 V${f(150 + 40 * inn)}`);
				lead.setAttribute('d', `M66 201 L${f(77)} ${f(yHead + 40 + 2)}`);
				p.setAttribute('opacity', f(fade));
			});
		}

		// ---- beaver and woodpecker
		const wood = q<SVGSVGElement>('[data-p="wood"]');
		if (wood) {
			const bhead = wood.querySelector<SVGGElement>('[data-bhead]')!;
			const bhd = wood.querySelector<SVGGElement>('[data-bhd]')!;
			const chips = [...wood.querySelectorAll<SVGRectElement>('[data-chips] > rect')];
			steps.push((t) => {
				// the beaver gnaws twice a second
				const g = Math.sin(t * 2 * Math.PI * 2);
				bhead.setAttribute('transform', `rotate(${f(4 * g)} 80 160)`);
				// the woodpecker: 6 blows in 1 s, then a pause
				const tt = t % T_BIRD;
				const blow = tt < 1 ? Math.max(0, Math.sin(Math.PI * 6 * tt)) ** 0.6 : 0;
				bhd.setAttribute('transform', `translate(${f(-3 + 3 * (1 - blow))} 0) rotate(${f(-6 * (1 - blow))} 150 80)`);
				chips.forEach((c, i) => {
					const beaver = i % 2 === 0;
					const ph = ((t + i * 0.37) % 1.1) / 1.1;
					const x0 = beaver ? 108 : 136;
					const y0 = beaver ? 166 : 76;
					const vx = beaver ? -20 - 12 * (i % 3) : 10 + 8 * (i % 3);
					const x = x0 + vx * ph;
					const y = y0 - 14 * ph + 40 * ph * ph;
					c.setAttribute('transform', `translate(${f(x)} ${f(y)}) rotate(${f(ph * 400 + i * 40)})`);
					const show = beaver || tt < 1.3;
					c.setAttribute('opacity', show ? f(1 - ph) : '0');
				});
			});
		}

		// ---- bee
		const bee = q<SVGSVGElement>('[data-p="bee"]');
		if (bee) {
			const body = bee.querySelector<SVGGElement>('[data-beebody]')!;
			const wings = bee.querySelector<SVGGElement>('[data-wings]')!;
			steps.push((t) => {
				body.setAttribute('transform', `translate(${f(2 * Math.sin(t * 1.3))} ${f(3 * Math.sin(t * 2.1))})`);
				wings.setAttribute('transform', `rotate(${f(14 * Math.sin(t * 2 * Math.PI * 7))} 164 66)`);
			});
		}

		let t = 0;
		const draw = () => {
			for (const s of steps) s(t);
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
