---
/**
 * Pictures for «Как уменьшают и увеличивают давление» (Irina, 18 Nov 2026: «Для места со способами увеличения и
 * уменьшения давления тоже добавим картинки»). Two figures, one per list of the section, in the order of the list:
 * `part="less"` (уменьшают давление: five panels) and `part="more"` (увеличивают давление: five panels); without the
 * prop both figures are rendered one after the other. In every panel the area the force acts on is gold.
 *
 * УМЕНЬШАЮТ
 * Фундамент — a house in section (18 px per metre): brick walls 0,5 м thick on a strip foundation whose footing is
 *   1,2 м wide. The same weight on 2,4 times the width gives 2,4 times less pressure on the ground (the footing's own
 *   weight, which makes the gain a little smaller, is left out). Static.
 * Рельсы на шпалах — a freight bogie (wheels 0,95 м, wheelbase 1,85 м) rolls along a rail on concrete sleepers
 *   (0,3 м wide along the track, 0,543 м apart: 1840 per km) at 50 px per metre. The rail is a beam on an elastic bed:
 *   its sag under one wheel is w(x) = w₀·e^(−|x|/L)·(cos |x|/L + sin |x|/L) with L = 0,75 м, and a sleeper carries the
 *   share (s/2L)·e^(−|x|/L)·(cos + sin) of the wheel's load, about 36 % for the sleeper under the wheel, 25 % for each
 *   neighbour, 10 % for the next ones (Zimmermann's method, the usual textbook model of a track). The gold strip under
 *   a sleeper and its arrow grow with its share. The sag is exaggerated about 40 times (real: 2–3 мм); the bogie moves
 *   at 0,8 м/с, slower than a train.
 * Гусеницы — a tracked tractor of 6 т (two tracks with 1,8 м × 0,42 м on the ground: 1,51 м²) and a person of 60 кг
 *   (167 см, the chapter's person from person.ts) standing on one foot in a winter boot (a sole of 150 см², as in the
 *   model «Человек на снегу»), both at 42 px per metre:
 *   p = 6000 · 9,8 / 1,5 = 39 200 Па and p = 60 · 9,8 / 0,015 = 39 200 Па, the same 39 кПа. The tractor drives in at
 *   5 км/ч (1,39 м/с, real time); its track links on the ground stand still (the lower run moves back relative to the
 *   tractor as fast as the tractor goes forward), and the track has a pitch of 0,17 м (5 px). The lugs leave marks.
 * Широкие шины — a lorry wheel with a load of 2 т (19,6 кН) on soft sand, front view at 90 px per metre, and the
 *   footprints seen from below. The pressure under a pneumatic tyre is close to the air pressure in it: an ordinary
 *   tyre at 600 кПа needs 19 600 / 600 000 = 0,033 м² (330 см²; drawn 0,20 × 0,165 м), a wide tyre at 200 кПа
 *   0,098 м² (980 см²; drawn 0,45 × 0,22 м). The ruts are drawn deeper for the narrow tyre; their depths are
 *   illustrative. Static.
 * Снегоступы — a person of 60 кг puts all the weight on one foot: a boot with a sole of 150 см² (39 кПа) and a
 *   snowshoe of 60 × 25 см (0,15 м², 3,9 кПа), at 1,2 px per cm. The foot sinks by 1,3 см per кПа, at most 40 см, the
 *   same illustrative rule as in «Человек на снегу»: 40 см and 5 см. Real snow differs.
 *
 * УВЕЛИЧИВАЮТ
 * Нож — two loaves, two knives, the same force on each. The edge of a sharp knife is thinner than 0,01 мм, its spine
 *   is about 2 мм: under the edge the pressure is hundreds of times higher. The edge goes into the bread (the blade
 *   hides behind the front face of the loaf), the spine only flattens the top of the loaf by 7 px. The magnified
 *   sections show the edge and the spine. Slowed down.
 * Ножницы, топор, стамеска — the three tools with their sharpened edges in gold; the scissors cut a strip of paper.
 * Кнопка, игла, гвоздь — a thumb pushes a drawing pin into a board, 5 px per мм: head 11 мм across (about 1 см²),
 *   point 8 мм long. The text's numbers: 50 Н on the head gives 50 / 0,0001 = 500 000 Па = 500 кПа under the thumb,
 *   on the point of 0,1 мм² 50 / 0,000 000 1 = 500 000 000 Па = 500 000 кПа, 1000 times more (the areas differ
 *   1000 times). The needle and the nail beside it are not to scale.
 * Зубы, когти, клювы — a beaver gnaws a trunk at its base (beaver incisors are orange with iron), a woodpecker holds
 *   on with its claws and pecks; the woodpecker's pecking is slowed to 6 blows per second (real: up to 20).
 * Жала и шипы — thorns of a rose and the sting of a bee, magnified with its barbs. The bee hovers; its wings are
 *   slowed down (real: about 230 beats per second).
 */
import G7Styles from '../g7/G7Styles.astro';

interface Props {
	part?: 'less' | 'more';
}
const { part } = Astro.props;
const showLess = part !== 'more';
const showMore = part !== 'less';

const f = (v: number) => (Math.round(v * 100) / 100).toString();
let seed = 20261118;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);

// ---- foundation: 18 px per metre
const FG = 146; // ground surface
const walls = [52.5, 187.5]; // wall centres
const WALL = 9; // 0,5 м
const FOOT = 21.6; // 1,2 м
const grass = [6, 14, 23, 31, 206, 215, 224, 233]
	.map((x, i) => `M${x - 2} ${FG} q-1 -3 -2 -${5 + (i % 3)} M${x} ${FG} q0 -4 1 -${7 + (i % 2)} M${x + 2} ${FG} q1 -3 2 -${5 + ((i + 1) % 3)}`)
	.join(' ');
const pebblesF = Array.from({ length: 26 }, () => ({ x: 4 + rnd() * 232, y: FG + 6 + rnd() * 46, r: 0.8 + rnd() * 1.3 }));

// ---- rails: 50 px per metre
const RS = 50;
const SP = 0.543 * RS;
const YB = 160; // the top of the ballast = the bottom of the sleepers
const SLEEPERS = Array.from({ length: 10 }, (_, i) => -2 + SP * i);
const gravel = Array.from({ length: 150 }, () => ({
	x: rnd() * 240,
	y: YB + 3 + rnd() * 36,
	rx: 1.6 + rnd() * 1.8,
	ry: 1.1 + rnd() * 1.2,
	a: Math.round(rnd() * 180),
}));

// ---- tractor: 30 px per metre
const TG = 156; // ground (the tractor is drawn at 30 px per metre and scaled by 1,4 to 42 px per metre)
const tR = (180 - 108) / (2 * Math.PI); // radius of the track ends: perimeter 180 px = 36 links of 5 px
const tA = 30; // rear end centre x
const tB = 84; // front end centre x (54 px = 1,8 м on the ground)
const tY = TG - tR;
const track = `M${tA} ${TG} H${tB} A${f(tR)} ${f(tR)} 0 0 0 ${tB} ${f(TG - 2 * tR)} H${tA} A${f(tR)} ${f(tR)} 0 0 0 ${tA} ${TG} Z`;

// ---- tyres: 90 px per metre
const TY = 140; // sand surface
const tyres = [
	{ cx: 64, w: 0.26 * 90, sink: 12, fw: 0.2 * 90, fl: 0.165 * 90, name: 'обычная', area: '330 см²' },
	{ cx: 172, w: 0.53 * 90, sink: 4, fw: 0.45 * 90, fl: 0.218 * 90, name: 'широкая', area: '980 см²' },
];
const D_TYRE = 1.1 * 90;

// ---- snow: 1,2 px per cm
const SS = 108; // snow surface

// ---- bread
const LB = 172; // the board
const dome = (u: number) => 126 - 22 * Math.sqrt(Math.max(0, 1 - u * u));
const loafPath = (x0: number) => {
	let d = `M${x0 + 6} ${LB} Q${x0} ${LB} ${x0} ${LB - 6} V126`;
	for (let i = 0; i <= 28; i++) {
		const u = -1 + (2 * i) / 28;
		d += ` L${f(x0 + 35 + 35 * u)} ${f(dome(u))}`;
	}
	return `${d} V${LB - 6} Q${x0 + 70} ${LB} ${x0 + 64} ${LB} Z`;
};
const pores = (x0: number) =>
	Array.from({ length: 34 }, () => ({ x: x0 + 7 + rnd() * 56, y: 112 + rnd() * 54, rx: 1 + rnd() * 2.2, ry: 0.8 + rnd() * 1.4 }));
const poresL = pores(40);
const poresR = pores(130);
// a chef's knife in local coordinates: spine at y = 0, edge at y = 16, the handle on the left
const blade = 'M0 0 H70 Q80 2 86 10 Q72 16 56 16 H0 Z';
const edge = 'M0 16 H56 Q72 16 86 10';

// ---- woodpecker and beaver
const barkLines = Array.from({ length: 9 }, (_, i) => {
	const x = 100 + i * 4.2;
	let d = `M${f(x)} 30`;
	for (let y = 40; y <= 190; y += 10) d += ` L${f(x + (rnd() - 0.5) * 2.4)} ${y}`;
	return d;
});
---

<G7Styles />
{
	showLess && (
		<figure class="g7 g7--pic ways not-content" data-ways>
			<div class="g7__grid is-two ways__grid">
				{/* 1. foundation */}
				<svg class="g7__svg" viewBox="0 0 240 244" role="img" aria-label="Дом в разрезе: стены стоят на фундаменте, подошва которого шире стены">
					<text class="t-title" x="120" y="18" text-anchor="middle">Фундамент</text>
					<rect class="ways__soil" x="0" y={FG} width="240" height="58" />
					{pebblesF.map((p) => (
						<circle class="ways__pebble" cx={f(p.x)} cy={f(p.y)} r={f(p.r)} />
					))}
					<path class="ways__grass" d={grass} />
					{/* the room */}
					<rect class="ways__room" x="57" y="88" width="126" height="52" />
					<rect class="ways__window" x="100" y="100" width="40" height="24" rx="1" />
					<path class="ways__frame" d="M120 100 V124 M100 112 H140" />
					<rect class="ways__concrete" x="57" y="138" width="126" height="5" />
					<path class="ways__roof" d="M38 90 L120 44 L202 90 Z" />
					<rect class="ways__concrete" x="46" y="86" width="148" height="5" />
					{walls.map((c) => (
						<g>
							<rect class="ways__brick" x={c - WALL / 2} y="91" width={WALL} height={FG - 91} />
							<path class="ways__brickline" d={Array.from({ length: 9 }, (_, i) => `M${c - WALL / 2} ${97 + i * 6} h${WALL}`).join(' ')} />
							<path class="ways__concrete" d={`M${c - WALL / 2} ${FG} V170 H${c - FOOT / 2} V178 H${c + FOOT / 2} V170 H${c + WALL / 2} V${FG} Z`} />
							<rect class="ways__area" x={f(c - FOOT / 2)} y="178" width={FOOT} height="3" />
							{[-7, 0, 7].map((dx) => (
								<g>
									<path class="ways__push" d={`M${c + dx} 183 V190`} />
									<path class="ways__pushhead" d={`M${c + dx - 2.6} 189 L${c + dx} 193.5 L${c + dx + 2.6} 189 Z`} />
								</g>
							))}
						</g>
					))}
					<path class="ln" d="M194 120 L203 113" />
					<text class="t-small" x="204" y="102">стена</text>
					<text class="t-small" x="204" y="114">0,5 м</text>
					<text class="t-small t-halo" x="120" y="166" text-anchor="middle">подошва</text>
					<text class="t-small t-halo" x="120" y="179" text-anchor="middle">1,2 м</text>
					<path class="ln" d="M144 170 L174 174 M96 170 L66 174" />
					<text class="t-small ways__note" x="120" y="222" text-anchor="middle">подошва фундамента в 2,4 раза шире стены —</text>
					<text class="t-small ways__note" x="120" y="236" text-anchor="middle">во столько же раз меньше давление на грунт</text>
				</svg>

				{/* 2. rails on sleepers */}
				<svg class="g7__svg" viewBox="0 0 240 244" role="img" aria-label="Тележка вагона катится по рельсу; рельс лежит на шпалах, шпалы — на щебне; под колесом нагружены несколько шпал" data-p="rails">
					<text class="t-title" x="120" y="18" text-anchor="middle">Рельсы на шпалах</text>
					<rect class="ways__ballast" x="0" y={YB} width="240" height="40" />
					{gravel.map((g) => (
						<ellipse class="ways__stone" cx={f(g.x)} cy={f(g.y)} rx={f(g.rx)} ry={f(g.ry)} transform={`rotate(${g.a} ${f(g.x)} ${f(g.y)})`} />
					))}
					<g data-arrows>
						{SLEEPERS.map((x) => (
							<g data-x={f(x)}>
								<path class="ways__push" d={`M${f(x)} ${YB + 3} V${YB + 4}`} />
								<path class="ways__pushhead" d="" />
							</g>
						))}
					</g>
					<g data-sleepers>
						{SLEEPERS.map((x) => (
							<g data-x={f(x)}>
								<rect class="ways__concrete" x={f(x - 7.5)} y={YB - 11.5} width="15" height="11.5" rx="1" />
								<rect class="ways__area" x={f(x - 7.5)} y={YB - 1} width="15" height="3" opacity="0" />
							</g>
						))}
					</g>
					<path class="ways__rail" d="" data-rail />
					<path class="ways__railline" d="" data-railline />
					<g data-bogie>
						<rect class="ways__car" x="-420" y="30" width="840" height="44" />
						<path class="ways__carline" d="M-420 34 H420 M-420 70 H420" />
						<path class="ways__carline" d={Array.from({ length: 28 }, (_, i) => `M${-405 + i * 30} 34 V70`).join(' ')} />
						<rect class="ways__steel-dark" x="-420" y="74" width="840" height="6" />
						<rect class="ways__steel-dark" x="-13" y="80" width="26" height="22" rx="2" />
						<path class="ways__spring" d="M-8 84 h16 M-8 88 h16 M-8 92 h16 M-8 96 h16" />
						<path class="ways__frame-bogie" d="M-58 114 L-46 104 L-20 98 H20 L46 104 L58 114 L46 124 L22 110 H-22 L-46 124 Z" />
						{[-46.25, 46.25].map((x) => (
							<g data-wheel transform={`translate(${x} 0)`}>
								<circle class="ways__flange" r="25.2" cx="0" cy="0" />
								<circle class="ways__wheel" r="23.75" cx="0" cy="0" />
								<g data-spin>
									{[0, 120, 240].map((a) => (
										<circle class="ways__hole" r="3.4" cx={f(14 * Math.cos((a * Math.PI) / 180))} cy={f(14 * Math.sin((a * Math.PI) / 180))} />
									))}
								</g>
								<rect class="ways__steel-dark" x="-7" y="-7" width="14" height="14" rx="2" />
							</g>
						))}
					</g>
					<text class="t-small t-halo" x="236" y="133" text-anchor="end">рельс</text>
					<text class="t-small t-halo" x="4" y="196">щебень</text>
					<text class="t-small ways__note" x="120" y="222" text-anchor="middle">рельс раздаёт вес колеса нескольким шпалам,</text>
					<text class="t-small ways__note" x="120" y="236" text-anchor="middle">а шпалы — широкому слою щебня</text>
				</svg>

				{/* 3. tracks */}
				<svg class="g7__svg" viewBox="0 0 240 244" role="img" aria-label="Гусеничный трактор массой 6 тонн подъезжает к человеку, стоящему на одной ноге; оба давят на почву около 39 килопаскалей" data-p="tractor">
					<text class="t-title" x="120" y="18" text-anchor="middle">Гусеницы</text>
					<rect class="ways__soil" x="0" y={TG} width="240" height="14" />
					<line class="ways__lugs" x1="0" y1={TG + 1.5} x2="0" y2={TG + 1.5} data-lugs />
					<g data-tractor>
						<g transform={`translate(0 ${TG}) scale(1.4) translate(0 ${-TG})`}>
						<rect class="ways__tractor" x="16" y="128" width="82" height="6" rx="1" />
						<path class="ways__tractor" d="M20 128 V80 H70 V128 Z" />
						<path class="ways__glass" d="M25 86 H65 V112 H25 Z" />
						<path class="ways__frame" d="M45 86 V112" />
						<circle class="ways__skin" cx="38" cy="100" r="4.2" />
						<path class="ways__tractor" d="M70 128 V104 H128 Q134 104 134 110 V134 H70 Z" />
						<path class="ways__grille" d="M128 108 V130 M131 108 V130" />
						<path class="ways__hoodline" d="M76 110 H124 M76 116 H124" />
						<path class="ways__exhaust" d="M108 104 V86" />
						<g>
							<path class="ways__trackbase" d={track} />
							<path class="ways__track" d={track} data-track />
							{[42, 57, 72].map((x) => (
								<circle class="ways__roller" cx={x} cy={TG - 5.5} r="4.5" />
							))}
							<circle class="ways__roller" cx={tA} cy={f(tY)} r="8" />
							<circle class="ways__roller" cx={tB} cy={f(tY)} r="8" />
							<g data-sprocket transform={`translate(${tA} ${f(tY)})`}>
								<path class="ways__hub" d="M-5 0 H5 M0 -5 V5" />
							</g>
							<g data-idler transform={`translate(${tB} ${f(tY)})`}>
								<path class="ways__hub" d="M-5 0 H5 M0 -5 V5" />
							</g>
						</g>
						<rect class="ways__area" x={tA} y={TG} width={tB - tA} height="2.6" />
						</g>
					</g>
					<text class="t-small" x="80" y="182" text-anchor="middle">6 т на 1,5 м²</text>
					<text class="t-strong" x="80" y="196" text-anchor="middle">≈ 39 кПа</text>
					{/* a person of 60 кг (167 см, person.ts) on one foot; the sole is gold */}
					<g data-man></g>
					<rect class="ways__area" x={214 - 8 * 0.42} y={TG} width={29.5 * 0.42} height="2.6" />
					<text class="t-small" x="236" y="182" text-anchor="end">60 кг на 150 см²</text>
					<text class="t-strong" x="236" y="196" text-anchor="end">≈ 39 кПа</text>
					<text class="t-small ways__note" x="120" y="222" text-anchor="middle">трактор массой 6 т давит на почву</text>
					<text class="t-small ways__note" x="120" y="236" text-anchor="middle">как человек на одной ноге</text>
				</svg>

				{/* 4. wide tyres */}
				<svg class="g7__svg" viewBox="0 0 240 244" role="img" aria-label="Обычная и широкая шина грузовика на песке и их следы: след широкой шины втрое больше">
					<text class="t-title" x="120" y="18" text-anchor="middle">Широкие шины</text>
					{tyres.map((t) => (
						<text class="t-small" x={t.cx} y="36" text-anchor="middle">{t.name}</text>
					))}
					<path
						class="ways__sand"
						d={`M0 ${TY} H${tyres[0].cx - tyres[0].w / 2 - 4} Q${tyres[0].cx - tyres[0].w / 2} ${TY} ${tyres[0].cx - tyres[0].w / 2} ${TY + tyres[0].sink} H${tyres[0].cx + tyres[0].w / 2} Q${tyres[0].cx + tyres[0].w / 2} ${TY} ${tyres[0].cx + tyres[0].w / 2 + 4} ${TY} H${tyres[1].cx - tyres[1].w / 2 - 3} Q${tyres[1].cx - tyres[1].w / 2} ${TY} ${tyres[1].cx - tyres[1].w / 2} ${TY + tyres[1].sink} H${tyres[1].cx + tyres[1].w / 2} Q${tyres[1].cx + tyres[1].w / 2} ${TY} ${tyres[1].cx + tyres[1].w / 2 + 3} ${TY} H240 V152 H0 Z`}
					/>
					{tyres.map((t) => {
						const x = t.cx - t.w / 2;
						const yb = TY + t.sink;
						const yt = yb - D_TYRE;
						const r = Math.min(t.w * 0.32, 12);
						return (
							<g>
								<path class="ways__steel-dark" d={`M${f(t.cx - 3)} ${f(yt + D_TYRE / 2)} H${f(t.cx + 3)}`} />
								<rect class="ways__tyre" x={f(x)} y={f(yt)} width={f(t.w)} height={D_TYRE} rx={f(r)} />
								<path
									class="ways__tread"
									d={Array.from({ length: 12 }, (_, i) => {
										const y = yt + 6 + i * 7.9;
										return `M${f(x + 3)} ${f(y)} L${f(t.cx)} ${f(y + 3)} L${f(x + t.w - 3)} ${f(y)}`;
									}).join(' ')}
								/>
								<rect class="ways__area" x={f(x + 1)} y={f(yb - 1.5)} width={f(t.w - 2)} height="3" rx="1" />
							</g>
						);
					})}
					<text class="t-small" x="120" y="166" text-anchor="middle">след</text>
					<text class="t-small" x="120" y="178" text-anchor="middle">снизу</text>
					{tyres.map((t) => (
						<g>
							<rect class="ways__area ways__area--fill" x={f(t.cx - t.fw / 2)} y={f(172 - t.fl / 2)} width={f(t.fw)} height={f(t.fl)} rx="3" />
							<text class="t-small" x={t.cx} y="199" text-anchor="middle">{t.area}</text>
						</g>
					))}
					<text class="t-small ways__note" x="120" y="222" text-anchor="middle">на колесо 2 т: под обычной шиной 600 кПа,</text>
					<text class="t-small ways__note" x="120" y="236" text-anchor="middle">под широкой — 200 кПа</text>
				</svg>

				{/* 5. snowshoes */}
				<svg class="g7__svg" viewBox="0 0 240 244" role="img" aria-label="Нога в ботинке проваливается в снег по колено, нога на снегоступе почти не проваливается" data-p="snow">
					<text class="t-title" x="120" y="18" text-anchor="middle">Снегоступы</text>
					<clipPath id="ways-snowclip">
						<rect x="0" y="28" width="240" height="152" />
					</clipPath>
					<rect class="ways__snow" x="0" y={SS} width="240" height="72" />
					<path class="ways__snowline" d={`M0 ${SS} H240`} />
					<g clip-path="url(#ways-snowclip)" data-steps>
						{/* the boot: origin at the middle of the sole */}
						<g data-foot="boot">
							<rect class="ways__pit" x="38" y={SS} width="40" height="0" data-pit />
							<g data-leg>
								<path class="ways__trousers" d="M-13 -22 L-15 -80 Q-15 -88 -18 -96 L-26 -150 H-2 L2 -96 Q4 -88 4 -80 L4 -22 Z" />
								<path class="ways__crease" d="M-14 -84 Q-6 -80 3 -84" />
