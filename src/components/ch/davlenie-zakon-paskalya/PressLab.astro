		stroke: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-5));
	}
	/* the bodies */
	.prl2__foam {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-2));
		stroke: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-4));
		stroke-width: 1.2;
	}
