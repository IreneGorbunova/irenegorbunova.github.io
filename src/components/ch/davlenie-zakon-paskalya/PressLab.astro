	}
	.prl2__kernel {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-2));
		stroke: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke-width: 1;
	}
	.prl2__can {
		fill: color-mix(in oklab, var(--ig-vx) 8%, var(--sl-color-gray-3));
		stroke: var(--g7-ink);
		stroke-width: 1.1;
		stroke-linejoin: round;
	}
	.prl2__band {
		fill: var(--g7-red);
		opacity: 0.85;
	}
	.prl2__wood {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
	}
	.prl2__grain {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.prl2__lens {
		fill: var(--g7-paper);
	}
	.prl2__lensrim {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2;
	}
	:root[data-theme='light'] .prl2__foam {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-6));
	}
	:root[data-theme='light'] .prl2__pore {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-4));
	}
	:root[data-theme='light'] .prl2__kernel {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-6));
	}
	.prl2 svg .prl2__count {
		font-size: 15px;
	}
	.prl2 svg .prl2__s {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.prl2 svg .prl2__sub {
		font-size: 9px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>

<script>
	import { el, fmtInt, fmtTrim, loop, segment, set } from '../g7/kit';
	import { ROLL } from '@components/people/hand';
	import { kitArm } from '../atmosfernoe-davlenie/kitArm';

	const K = 0.6; // px per мм
	const L = 100; // the stroke of the small piston, мм
	const T0 = 120; // the top of the table at rest, px
	const CX = 262; // the axis of the large cylinder
	const C1 = 104; // the axis of the small cylinder
	const S_TANK = 600; // см²
	const TANK_OIL = 150; // мм of oil in the full tank

	// --- the bodies: squeeze x (мм) under the force F (Н), after the largest force Fmax so far ---
	const FOAM: [number, number][] = [
		[0, 0],
		[0.05, 0.55],
		[0.25, 0.8],
		[0.4, 1],
		[0.55, 1.5],
		[0.65, 2.2],
		[0.75, 4],
		[0.8, 7],
		[0.85, 15],
		[0.88, 40],
	]; // ε, σ/σ₄₀
	const foamX = (F: number) => {
		const s = F / 36;
		for (let i = 1; i < FOAM.length; i++) {
			const [e0, s0] = FOAM[i - 1];
			const [e1, s1] = FOAM[i];
			if (s <= s1) return 80 * (e0 + ((e1 - e0) * (s - s0)) / (s1 - s0));
		}
		return 80 * (0.88 + 0.02 * (1 - 40 / s));
	};
	const nutX = (F: number, Fmax: number) => {
		if (Fmax < 300) return 1.5 * Math.pow(F / 300, 2 / 3);
		const env = (f: number) => 14 + 12 * (1 - 300 / f);
		return F >= Fmax ? env(F) : Math.max(0, env(Fmax) - (Fmax - F) / 10000);
	};
	const canX = (F: number, Fmax: number) => {
		if (Fmax < 900) return F / 12600;
		const env = (f: number) => 95 + 5 * (1 - 900 / f);
		return F >= Fmax ? env(F) : env(Fmax) - (Fmax - F) / 20000;
	};
	type Body = { h0: number; x: (F: number, Fmax: number) => number; draw: (g: SVGGElement, h: number, x: number, Fmax: number) => void };
	// fixed pseudo-random pores of the foam
	let seed = 7;
	const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
	const PORES = Array.from({ length: 34 }, () => [0.07 + 0.86 * rnd(), 0.08 + 0.84 * rnd(), 1.3 + 1.3 * rnd()]);
	const f1 = (v: number) => v.toFixed(1);

	const BODIES: Record<string, Body> = {
		foam: {
			h0: 80,
			x: (F) => foamX(F),
			draw: (g, h) => {
				const k = h / (80 * K);
				g.append(el('rect', { class: 'prl2__foam', x: -30, y: f1(-h), width: 60, height: f1(h), rx: 3 }));
				for (const [u, v, r] of PORES) g.append(el('ellipse', { class: 'prl2__pore', cx: f1(-30 + 60 * u), cy: f1(-h * v), rx: f1(r), ry: f1(Math.max(0.3, r * k)) }));
			},
		},
		spring: {
			h0: 100,
			x: (F) => Math.min(F / 6.585, 68) + Math.max(0, F - 448) / 50000,
			draw: (g, h) => {
				// a helix of 7,5 turns, wire 2,4 px, mean radius 12 px; the back halves of the turns are darker
				const turns = 7.5;
				const w = 2.4;
				let front = '';
				let back = '';
				let prev: [number, number, boolean] | null = null;
				for (let i = 0; i <= turns * 24; i++) {
					const t = i / (turns * 24);
					const a = 2 * Math.PI * turns * t;
					const p: [number, number, boolean] = [12 * Math.sin(a), -(w / 2 + t * (h - w)), Math.cos(a) >= 0];
					if (prev) {
						const seg = `M${f1(prev[0])} ${f1(prev[1])} L${f1(p[0])} ${f1(p[1])} `;
						if (p[2] || prev[2]) front += seg;
						else back += seg;
					}
					prev = p;
				}
				g.append(el('path', { class: 'prl2__coil-back', d: back }));
				g.append(el('path', { class: 'prl2__coil', d: front }));
			},
		},
		nut: {
			h0: 35,
			x: nutX,
			draw: (g, h, x, Fmax) => {
				if (Fmax < 300 || x < 1.6) {
					const m = -h / 2;
					g.append(el('path', { class: 'prl2__shell', d: `M0 ${f1(-h)} C13 ${f1(-h)} 13 0 0 0 C-13 0 -13 ${f1(-h)} 0 ${f1(-h)} Z` }));
					g.append(el('path', { class: 'prl2__wrinkle', d: `M0 ${f1(-h + 1.5)} V-1.5 M-5 ${f1(m - 6)} q2.5 3 0 6 q-2.5 3 0 6 M5 ${f1(m - 6)} q-2.5 3 0 6 q2.5 3 0 6` }));
					return;
				}
				// cracked: the kernel squeezed under the plate, bits of the shell around it
				g.append(el('path', { class: 'prl2__kernel', d: `M-11 0 C-13 ${f1(-h * 0.7)} -6 ${f1(-h)} 0 ${f1(-h)} C6 ${f1(-h)} 13 ${f1(-h * 0.7)} 11 0 Z` }));
				for (const b of [
					[-23, -17, -6, -12],
					[-31, -27, -4, -24],
					[12, 17, -6, 22],
					[25, 28, -3, 32],
				])
					g.append(el('path', { class: 'prl2__shell', d: `M${b[0]} 0 Q${b[1]} ${f1(Math.max(b[2], 1.6 - h))} ${b[3]} 0 Z` }));
			},
		},
		can: {
			h0: 115,
			x: canX,
			draw: (g, h) => {
				const H = 115 * K;
				if (h > H - 0.5) {
					g.append(el('path', { class: 'prl2__can', d: `M-20 -2 Q-20 0 -17 0 H17 Q20 0 20 -2 V${f1(-h + 8)} L16 ${f1(-h + 2)} V${f1(-h)} H-16 V${f1(-h + 2)} L-20 ${f1(-h + 8)} Z` }));
					g.append(el('rect', { class: 'prl2__band', x: -20, y: f1(-h * 0.64), width: 40, height: f1(h * 0.3) }));
					return;
				}
				// crushed: the wall folds into rings that stick out; more folds the more it is squeezed
				const n = Math.max(2, Math.min(9, Math.round((H - h) / 6) + 1));
				const top = -h;
				let d = `M16 ${f1(top)} H-16`;
				for (let i = 0; i <= n; i++) d += ` L${i % 2 ? -25 : -19} ${f1(top + 2 + ((h - 4) * i) / n)}`;
				d += ' L-17 0 H17';
				for (let i = n; i >= 0; i--) d += ` L${i % 2 ? 25 : 19} ${f1(top + 2 + ((h - 4) * i) / n)}`;
				g.append(el('path', { class: 'prl2__can', d: `${d} Z` }));
				g.append(el('path', { class: 'prl2__band', d: `M-19 ${f1(top + h * 0.4)} L19 ${f1(top + h * 0.33)} V${f1(top + h * 0.58)} L-19 ${f1(top + h * 0.66)} Z` }));
			},
		},
		wood: {
			h0: 50,
			x: (F) => F / 560000,
			draw: (g, h) => {
				g.append(el('rect', { class: 'prl2__wood', x: -15, y: f1(-h), width: 30, height: f1(h), rx: 1 }));
				g.append(el('path', { class: 'prl2__grain', d: `M-9 -2 V${f1(-h + 2)} M-3 -2 Q-1 ${f1(-h / 2)} -3 ${f1(-h + 2)} M4 -2 V${f1(-h + 2)} M10 -2 Q8 ${f1(-h / 2)} 10 ${f1(-h + 2)}` }));
			},
		},
	};

	const arrowLen = (F: number) => (F > 0 ? 10 + 13 * Math.log10(Math.max(1, F)) : 0);
	const plural = (n: number, one: string, few: string, many: string) => {
		const a = n % 10;
		const b = n % 100;
		if (a === 1 && b !== 11) return one;
		if (a >= 2 && a <= 4 && (b < 12 || b > 14)) return few;
		return many;
	};
	const len = (mm: number) => {
		if (mm < 1) return `${fmtTrim(mm, 2)} мм`;
		if (mm < 10) return `${fmtTrim(mm, 1)} мм`;
		if (mm < 1000) return `${fmtTrim(mm / 10, 1)} см`;
		return `${fmtTrim(mm / 1000, 2)} м`;
	};
	const force = (F: number) => (F < 10 ? `${fmtTrim(F, 1)} Н` : `${fmtInt(F)} Н`);
	const pres = (p: number) => {
		if (p < 1000) return `${fmtInt(p)} Па`;
		if (p < 1e6) return `${fmtTrim(p / 1000, p < 1e4 ? 1 : 0)} кПа`;
		return `${fmtTrim(p / 1e6, 2)} МПа`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-presslab]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		// the fist: a hand drawn 40 px long, the fingers down, the back of the hand to the viewer, the forearm straight up
		kitArm(q<SVGGElement>('[data-presshand]'), { Lh: 40, side: 'R', sleeve: 'prl2-kit-sleeve', reach: 200 })({ at: { x: 0, y: -3 }, pose: 'fist', dir: Math.PI / 2, roll: ROLL.backViewer });
		const fIn = q<HTMLInputElement>('[data-f]');
		const STEPS = fIn.dataset.steps!.split(',').map(Number);
		const s1In = q<HTMLInputElement>('[data-s1in]');
		const s2In = q<HTMLInputElement>('[data-s2in]');
		const bodyG = q<SVGGElement>('[data-body]');
		const flows = [...root.querySelectorAll<SVGPathElement>('.prl2__flow')];
		let bodyName = 'foam';
		let body = BODIES.foam;
		// the state
		let x2 = 0; // мм: the rise of the large piston = the squeeze of the body
		let s = 0; // мм: how far the small piston is down in its current stroke
		let n = 0; // strokes made with this body
		let Fmax = 0; // the largest force the body has felt
		let phase: 'idle' | 'down' | 'up' | 'release' = 'idle';
		let vDown = 500; // мм/с of the small piston
		let tFlow = 0;

		const F1 = () => STEPS[Number(fIn.value)];
		const S1 = () => Number(s1In.value);
		const S2 = () => Number(s2In.value);
		const F2 = () => (F1() * S2()) / S1();
		const target = () => body.x(F2(), Fmax);

		const plan = () => {
			Fmax = Math.max(Fmax, F2());
			const need = ((target() - x2) * S2()) / S1() / L; // strokes still to make
			vDown = need > 0 ? L / Math.min(0.7, Math.max(0.1, 4 / (1.5 * need))) : 500;
		};
		// a new body or a new pair of pistons: everything back to rest
		const fresh = () => {
			x2 = 0;
			s = 0;
			n = 0;
			Fmax = 0;
			phase = 'idle';
			plan();
		};
		// the state reached at once (when the page opens)
		const settle = () => {
			Fmax = Math.max(Fmax, F2());
			x2 = target();
			const x1 = (x2 * S2()) / S1();
			n = x1 > 1e-6 ? Math.ceil(x1 / L - 1e-9) : 0;
			s = n ? x1 - (n - 1) * L : 0;
			phase = 'idle';
		};

		const message = () => {
			const moving = phase !== 'idle';
			switch (bodyName) {
				case 'foam':
					return x2 > 0.84 * 80 ? 'Поролон сжат почти до конца: поры сомкнулись, сильнее его не сжать.' : 'Поролон мягкий: даже малая сила сжимает его на сантиметры.';
				case 'spring':
					return x2 >= 67.9 ? 'Витки пружины сомкнулись — дальше она почти не сжимается.' : `Пружина сжата на ${len(x2)}: её сила упругости равна F₂.`;
				case 'nut':
					if (Fmax >= 300) return moving && x2 < 13 ? 'Скорлупа треснула — пресс давит ядро.' : 'Орех треснул: скорлупа выдерживает около 300 Н.';
					return `Скорлупа сжата всего на ${len(x2)}. Орех трескается при силе около 300 Н.`;
				case 'can':
					if (Fmax >= 900) return moving && x2 < 90 ? 'Стенка банки не выдержала и складывается гармошкой.' : 'Банка смялась: пустая банка выдерживает вдоль оси около 900 Н.';
					return `Банка держит: она сжата всего на ${len(x2)}. Смять её можно силой около 900 Н.`;
				default:
					return F2() > 0 ? `Брусок сжат всего на ${len(x2)} — на глаз незаметно. Поршни почти стоят, а сила большая.` : 'Брусок из сосны стоит торцом: вдоль волокон дерево очень жёсткое.';
			}
		};

		const draw = () => {
			const w1 = Math.sqrt((4 * S1()) / Math.PI) * 10 * K;
			const w2 = Math.sqrt((4 * S2()) / Math.PI) * 10 * K;
			const yT = T0 - x2 * K; // the top of the table
			const yP2 = 222 - x2 * K; // the top of the large piston
			const yP1 = 140 + s * K; // the top of the small piston
			const l1 = C1 - w1 / 2;
			const r1 = C1 + w1 / 2;
			const l2 = CX - w2 / 2;
			const r2 = CX + w2 / 2;
			const used = (((x2 / 10) * S2() - (s / 10) * S1()) / S_TANK) * 10; // мм of the tank's oil now in the cylinders
			const tankTop = 252 - (TANK_OIL - used) * K;
			// walls: the tank and the channel to the large cylinder; the small cylinder stands on the channel
			q('[data-wall]').setAttribute(
				'd',
				`M8 150 V252 H${f1(l2 + 8)} V238 H${f1(r2)} V132 M${f1(l2)} 132 V244 H${f1(r1)} V120 M${f1(l1)} 120 V244 H62 V150`,
			);
			set(q('[data-oil-tank]'), { x: 9.2, y: f1(tankTop), width: 51.6, height: f1(Math.max(0, 250.8 - tankTop)) });
			q('[data-oil]').setAttribute(
				'd',
				`M60.8 245.2 H${f1(l1 + 1.2)} V${f1(yP1 + 8)} H${f1(r1 - 1.2)} V245.2 H${f1(l2 + 1.2)} V${f1(yP2 + 12)} H${f1(r2 - 1.2)} V236.8 H${f1(l2 + 6.8)} V250.8 H60.8 Z`,
			);
			q('[data-flow-out]').setAttribute('d', `M104 248 H${f1(l2 + 4)} V${f1(Math.min(236, yP2 + 18))}`);
			q('[data-flow-back]').setAttribute('d', `M${f1(l2 + 4)} 240 V248 H154 V280 H35 V256`);
			// the valves: open = the ball pushed off its seat and lit
			const v1 = q('[data-v1]');
			const v2 = q('[data-v2]');
			set(v1, { cx: phase === 'up' ? 78 : 75.5 });
			set(v2, { cx: phase === 'down' ? 144 : 141.5 });
			v1.classList.toggle('is-open', phase === 'up');
			v2.classList.toggle('is-open', phase === 'down');
			const rel = phase === 'release';
			set(q('[data-tap]'), rel ? { x1: -9, y1: 0, x2: 9, y2: 0 } : { x1: 0, y1: -9, x2: 0, y2: 9 });
			q('[data-tapc]').classList.toggle('is-open', rel);
			flows[0].classList.toggle('is-on', phase === 'up');
			flows[1].classList.toggle('is-on', phase === 'down');
			flows[2].classList.toggle('is-on', rel);
			// the large piston with the ram and the table
			q('[data-big]').setAttribute('transform', `translate(${CX} ${f1(yT)})`);
			const rw = Math.max(18, w2 * 0.45);
			set(q('[data-ram]'), { x: f1(-rw / 2), width: f1(rw) });
			set(q('[data-p2]'), { x: f1(-w2 / 2 + 1.4), width: f1(w2 - 2.8) });
			// the upper plate, lowered onto the body; the body itself
			const hBody = body.h0 * K;
			q('[data-beam]').setAttribute('transform', `translate(0 ${f1(T0 - hBody)})`);
			bodyG.replaceChildren();
			bodyG.setAttribute('transform', `translate(${CX} ${f1(yT)})`);
			body.draw(bodyG, hBody - x2 * K, x2, Fmax);
			const lens = q<SVGGElement>('[data-lens]');
			lens.style.display = bodyName === 'nut' ? '' : 'none';
			if (bodyName === 'nut') {
				const h = hBody - x2 * K;
				const g = q<SVGGElement>('[data-lensbody]');
				g.replaceChildren();
				g.setAttribute('transform', `translate(262 49) scale(1.8) translate(0 ${f1(h / 2)})`);
				g.append(el('rect', { class: 'prl2__table', x: -24, y: 0, width: 48, height: 6 }));
				g.append(el('rect', { class: 'prl2__frame', x: -24, y: f1(-h - 6), width: 48, height: 6 }));
				body.draw(g, h, x2, Fmax);
			}
			// the small piston and the hand
			q('[data-small]').setAttribute('transform', `translate(${C1} ${f1(yP1)})`);
			set(q('[data-p1]'), { x: f1(-w1 / 2 + 1.2), width: f1(w1 - 2.4) });
			set(q('[data-s1]'), { x: f1(r1 + 5), y: f1(yP1 + 9) });
			set(q('[data-s2]'), { x: f1(CX - rw / 2 - 4), y: f1(yP2 - 4) });
			// the arrows: F₁ down on the handle, F₂ up on the large piston (lengths not to scale)
			const on = F1() > 0 ? 'visible' : 'hidden';
			const La = arrowLen(F1());
			const Lb = Math.min(86, arrowLen(F2()));
			const hy = yP1 - 78; // the handle
			set(q('[data-a1]'), { x1: C1 - 20, x2: C1 - 20, y1: f1(hy - 4 - La), y2: f1(hy - 3) });
			set(q('[data-a2]'), { x1: CX, x2: CX, y1: f1(yP2 + 10), y2: f1(yP2 + 10 - Lb) });
			set(q('[data-l1]'), { x: C1 - 26, y: f1(hy - 2 - La / 2) });
			set(q('[data-l2]'), { x: f1(CX + rw / 2 + 5), y: f1(yP2 + 4 - Lb / 2) });
			for (const a of ['[data-a1]', '[data-a2]', '[data-l1]', '[data-l2]']) (q(a) as SVGElement).style.visibility = on;
			q('[data-count]').textContent = n ? String(n) : '';
			q('[data-count-w]').textContent = n ? plural(n, 'ход', 'хода', 'ходов') : '';
			// the readouts
			q('[data-of]').textContent = `${F1()} Н`;
			q('[data-o1]').textContent = `${S1()} см²`;
			q('[data-o2]').textContent = `${S2()} см²`;
			q('[data-p]').textContent = pres(F1() / (S1() / 10000));
			q('[data-f2]').textContent = force(F2());
			q('[data-gain]').textContent = fmtTrim(S2() / S1(), 1);
			q('[data-x2]').textContent = len(x2);
			q('[data-x1]').textContent = len((x2 * S2()) / S1());
			q('[data-n]').textContent = String(n);
			q('[data-msg]').textContent = message();
		};

		const step = (dt: number) => {
			const xT = target();
			const r = S1() / S2();
			tFlow += dt;
			if (x2 < xT - 1e-7) {
				// pumping: down strokes push oil into the large cylinder, up strokes take it from the tank
				if (phase === 'up') {
					s -= 2 * vDown * dt;
					if (s <= 0) {
						s = 0;
						phase = 'down';
						n++;
					}
				} else if (s >= L - 1e-9) phase = 'up';
				else {
					if (phase !== 'down' && s <= 1e-9) n++;
					phase = 'down';
					const ds = Math.min(vDown * dt, L - s, (xT - x2) / r);
					s += ds;
					x2 = Math.min(xT, x2 + ds * r);
				}
			} else if (x2 > xT + 1e-7) {
				// the tap lets oil back into the tank
				phase = 'release';
				x2 = Math.max(xT, x2 - Math.max(4, (x2 - xT) / 0.5) * dt);
			} else phase = 'idle';
			for (const f of flows) f.style.strokeDashoffset = String(-tFlow * 30);
			draw();
			return phase !== 'idle';
		};
		const wake = loop(root, step);
		const restart = () => {
			fresh();
			draw();
			wake();
		};

		segment(q('[data-pick]'), (b) => {
			bodyName = b.dataset.b!;
			body = BODIES[bodyName];
			restart();
		});
		q('[data-new]').addEventListener('click', restart);
		for (const i of [s1In, s2In]) i.addEventListener('input', restart);
		fIn.addEventListener('input', () => {
			plan();
			draw();
			wake();
		});
		settle();
		draw();
	}
</script>
