---
/**
 * School scheme of a hydraulic press (Irina, 21 Nov 2026: «простую схему пресса с площадями и силами»), for the
 * formula F₂/F₁ = S₂/S₁, before the press model. Two cylinders joined at the bottom and filled with oil (the oil color
 * of the press model), each closed by a piston at the same height. The small piston has half the diameter of the large
 * one (30 and 60 px), so S₂ = 4·S₁. The force F₁ (blue, as in the press model) presses the small piston down and
 * makes the pressure p = F₁/S₁ in the oil; by Pascal's law the oil presses on the large piston with the same p, so
 * F₂ = p·S₂ = 4·F₁ (red, up). The arrows are to scale: 24 and 96 px. The areas S₁ and S₂ are the gold faces of the
 * pistons that touch the oil (gold is the area in every picture of this chapter). The weight of the oil and of the
 * pistons is left out. Static.
 */
import G7Styles from '../g7/G7Styles.astro';

const TOP = 136; // the pistons' faces on the oil
const small = { cx: 92, r: 15 };
const large = { cx: 252, r: 30 };
const F1 = 24;
const F2 = 4 * F1;
const oil = `M${small.cx - small.r} ${TOP} V226 H${large.cx + large.r} V${TOP} H${large.cx - large.r} V208 H${small.cx + small.r} V${TOP} Z`;
const walls = `M${small.cx - small.r - 2} 74 V228 H${large.cx + large.r + 2} V74 M${small.cx + small.r + 2} 74 V206 H${large.cx - large.r - 2} V74`;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow psc not-content" data-dz-press>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Схема гидравлического пресса: на малый поршень площадью S1 давит сила F1, масло давит на большой поршень площадью S2 с силой F2. Давление p под обоими поршнями одинаковое">
			<path class="psc__oil" d={oil}></path>
			<path class="psc__wall" d={walls}></path>
			<text class="t-small" x="172" y="221" text-anchor="middle">масло</text>
			{[small, large].map((c) => (
				<>
					<rect class="psc__piston" x={c.cx - c.r} y={TOP - 14} width={2 * c.r} height="14" rx="2" />
					<ellipse class="psc__area" cx={c.cx} cy={TOP} rx={c.r} ry={c.r * 0.28} />
					<text class="t-i t-halo psc__p" x={c.cx} y={TOP + 30} text-anchor="middle">p</text>
				</>
			))}
			<!-- the forces, to scale: F₂ = 4·F₁ -->
			<line class="arrow arrow--blue" x1={small.cx} y1={TOP - 14 - F1 - 2} x2={small.cx} y2={TOP - 14 - 7}></line>
			<path class="head--blue" d={`M${small.cx - 5} ${TOP - 23} L${small.cx} ${TOP - 15} L${small.cx + 5} ${TOP - 23} Z`}></path>
			<text class="t-i t-blue t-halo" x={small.cx - small.r - 8} y={TOP - 24} text-anchor="end">F<tspan class="psc__sub" dy="4">1</tspan></text>
			<line class="arrow arrow--red" x1={large.cx} y1={TOP - 14} x2={large.cx} y2={TOP - 14 - F2 + 7}></line>
			<path class="head--red" d={`M${large.cx - 5} ${TOP - 14 - F2 + 8} L${large.cx} ${TOP - 14 - F2} L${large.cx + 5} ${TOP - 14 - F2 + 8} Z`}></path>
			<text class="t-i t-red t-halo" x={large.cx + 10} y={TOP - 14 - F2 / 2}>F<tspan class="psc__sub" dy="4">2</tspan></text>
			<!-- the areas -->
			<path class="psc__lead" d={`M${small.cx - small.r + 3} ${TOP + 2} L${small.cx - small.r - 22} ${TOP + 18}`}></path>
			<text class="t-i t-gold t-halo" x={small.cx - small.r - 26} y={TOP + 26} text-anchor="end">S<tspan class="psc__sub" dy="4">1</tspan></text>
			<path class="psc__lead" d={`M${large.cx + large.r - 4} ${TOP + 3} L${large.cx + large.r + 20} ${TOP + 18}`}></path>
			<text class="t-i t-gold t-halo" x={large.cx + large.r + 23} y={TOP + 26}>S<tspan class="psc__sub" dy="4">2</tspan></text>
			<!-- the formulas -->
			<text class="t-num" x={small.cx} y="256" text-anchor="middle"><tspan class="t-i">p</tspan> = <tspan class="t-i">F</tspan><tspan class="psc__sub" dy="3">1</tspan><tspan dy="-3"> : </tspan><tspan class="t-i">S</tspan><tspan class="psc__sub" dy="3">1</tspan></text>
			<text class="t-num" x={large.cx} y="256" text-anchor="middle"><tspan class="t-i">p</tspan> = <tspan class="t-i">F</tspan><tspan class="psc__sub" dy="3">2</tspan><tspan dy="-3"> : </tspan><tspan class="t-i">S</tspan><tspan class="psc__sub" dy="3">2</tspan></text>
			<text class="t-small" x="180" y="278" text-anchor="middle">давление одно и то же под обоими поршнями</text>
			<text class="t-small" x="180" y="293" text-anchor="middle"><tspan class="t-i psc__u">F</tspan> — в ньютонах (Н), <tspan class="t-i psc__u">S</tspan> — в м², <tspan class="t-i psc__u">p</tspan> — в паскалях (Па)</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Малый поршень давит на масло с силой <i>F</i><sub>1</sub>. Давление масла одно и то же под обоими поршнями, а площадь большого поршня в 4&nbsp;раза больше, поэтому и сила <i>F</i><sub>2</sub> в 4&nbsp;раза больше. Стрелки сил нарисованы в масштабе.
	</figcaption>
</figure>

<style is:global>
	.psc__oil {
		fill: color-mix(in oklab, var(--ig-v) 40%, transparent);
	}
	.psc__wall {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.psc__piston {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.psc__area {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.psc__lead {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1;
	}
	.psc .t-gold {
		fill: var(--g7-gold);
	}
	.g7__svg .psc__p {
		fill: var(--g7-ink);
		font-size: 16px;
	}
	.g7__svg .psc__u {
		font-size: 12px;
	}
	.g7__svg .psc__sub {
		font-size: 10px;
		font-style: normal;
	}
</style>
