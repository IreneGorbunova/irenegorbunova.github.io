---
/**
 * Two short looping opening scenes of «Давление. Закон Паскаля». No terms of the chapter in the pictures.
 * Snow: two people of the same mass cross deep snow. The one in boots sinks to the knees at every step; the one
 *   on skis stays on top. The skis are 180 см long, the people 170 см tall (0,45 px per centimeter).
 * Tube: a tube of toothpaste is squeezed at its far end, and the paste comes out at the other end, at the nozzle:
 *   the paste that comes out has the same area in the drawing as the part of the tube that is squeezed flat.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-davintro>
	<div class="intro__card" data-scene="snow">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Два человека идут по глубокому снегу. Тот, что в ботинках, проваливается по колено, а лыжник остаётся на поверхности">
			<rect class="da-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="da-snow" x="0" y="150" width="360" height="90"></rect>
			<path class="da-holes" data-holes></path>
			<line class="da-sep" x1="0" y1="150" x2="360" y2="150"></line>
			<g data-walker>
				<circle class="da-head" cx="0" cy="-70" r="7"></circle>
				<path class="da-coat da-coat--a" d="M-8 -62 h16 v30 h-16 Z"></path>
				<path class="da-leg" data-legs></path>
			</g>
			<g data-skier>
				<circle class="da-head" cx="0" cy="-74" r="7"></circle>
				<path class="da-coat da-coat--b" d="M-8 -66 h16 v30 h-16 Z"></path>
				<path class="da-leg" d="M-4 -36 V-4 M4 -36 V-4"></path>
				<rect class="da-ski" x="-40" y="-4" width="82" height="3.5" rx="1.5"></rect>
				<path class="da-pole" d="M10 -56 L24 -2 M-10 -56 L-22 -2"></path>
			</g>
			<text class="da-label" x="10" y="20">в ботинках</text>
			<text class="da-label" x="350" y="20" text-anchor="end">на лыжах</text>
		</svg>
		<div class="intro__foot">
			<p>
				По глубокому снегу идут двое. Тот, кто в ботинках, проваливается по колено, а лыжник идёт поверху, хотя{' '}
				<More term="весят они одинаково">
					Оба давят на снег с одной и той же силой. Но у лыжника эта сила приходится на площадь двух лыж, а у пешехода — на площадь двух подошв, которая раз в десять меньше. На каждый квадратный сантиметр снега под лыжами приходится в десять раз меньшая сила. Об этом — в разделе{' '}
					<a href="#давление">«Давление»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="tube">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Тюбик с зубной пастой сжимают у дальнего конца, а паста выходит из отверстия на другом конце">
			<rect class="da-sky" x="0" y="0" width="360" height="240"></rect>
			<path class="da-tube" data-tube></path>
			<rect class="da-cap" x="246" y="102" width="20" height="36" rx="3"></rect>
			<rect class="da-neck" x="266" y="112" width="14" height="16"></rect>
			<path class="da-paste" data-paste></path>
			<g data-fingers>
				<path class="da-finger" data-f1 d="M-12 0 q12 -52 24 0 Z"></path>
				<path class="da-finger" data-f2 d="M-12 0 q12 52 24 0 Z"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				На тюбик нажимают у одного конца, а паста выходит на другом:{' '}
				<More term="давление передаётся по всей пасте">
					Пальцы сжимают тюбик только в одном месте, но сдавленной оказывается вся паста: она передаёт давление во все стороны и в каждую свою точку. Так же ведут себя жидкости и газы. Об этом — в разделе{' '}
					<a href="#закон-паскаля">«Закон Паскаля»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-davintro] .da-sky {
		fill: var(--sl-color-bg);
	}
	[data-davintro] .da-snow {
		fill: hsl(210, 30%, 88%);
	}
	:root:not([data-theme='light']) [data-davintro] .da-snow {
		fill: hsl(215, 22%, 72%);
	}
	[data-davintro] .da-holes {
		fill: var(--sl-color-bg);
	}
	[data-davintro] .da-sep {
		stroke: hsl(210, 30%, 60%);
		stroke-width: 1;
	}
	[data-davintro] .da-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-davintro] .da-coat--a {
		fill: var(--ig-vy);
	}
	[data-davintro] .da-coat--b {
		fill: var(--ig-vx);
	}
	[data-davintro] .da-leg {
		fill: none;
		stroke: hsl(225, 30%, 26%);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-davintro] .da-ski {
		fill: var(--ig-v);
		stroke: hsl(30, 60%, 30%);
		stroke-width: 0.6;
	}
	[data-davintro] .da-pole {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	[data-davintro] .da-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-davintro] .da-tube {
		fill: color-mix(in oklab, var(--ig-vx) 46%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	[data-davintro] .da-cap,
	[data-davintro] .da-neck {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-davintro] .da-paste {
		fill: none;
		stroke: hsl(170, 60%, 60%);
		stroke-width: 12;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-davintro] .da-finger {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 1.2;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-davintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="snow"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const walker = $<SVGGElement>('[data-walker]');
			const skier = $<SVGGElement>('[data-skier]');
			const legs = $<SVGPathElement>('[data-legs]');
			const holes = $<SVGPathElement>('[data-holes]');
			const STEP = 22; // px between the walker's footprints
			const DEPTH = 20; // he sinks to the knees: 45 см
			scene(card, 8, (x) => {
				// both go from left to right; the skier glides, the walker makes 7 steps
				const wx = 30 + 150 * x;
				const sx = 200 + 130 * x;
				skier.setAttribute('transform', `translate(${sx.toFixed(1)} 150)`);
				const phase = ((wx - 30) / STEP) % 1;
				// the body sinks with every step and comes up a little between the steps
				const sink = DEPTH - 6 * Math.sin(Math.PI * phase);
				walker.setAttribute('transform', `translate(${wx.toFixed(1)} ${(150 + sink).toFixed(1)})`);
				const swing = 7 * Math.sin(Math.PI * 2 * phase);
				legs.setAttribute('d', `M-3 -32 L${(-3 - swing).toFixed(1)} -2 M3 -32 L${(3 + swing).toFixed(1)} -2`);
				let d = '';
				for (let fx = 30; fx <= wx + 6; fx += STEP) d += `M${fx - 7} 150 v${DEPTH} h14 v${-DEPTH} Z `;
				holes.setAttribute('d', d);
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="tube"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const tube = $<SVGPathElement>('[data-tube]');
			const paste = $<SVGPathElement>('[data-paste]');
			const f1 = $<SVGPathElement>('[data-f1]');
			const f2 = $<SVGPathElement>('[data-f2]');
			scene(card, 6, (x) => {
				const sq = ease((x - 0.15) / 0.6); // how hard the tube is squeezed
				const pinch = 22 * sq; // the walls come together by this much at x = 90
				// the tube: flat end on the left, round shoulder at the cap on the right
				tube.setAttribute('d', `M40 120 L60 ${92 + pinch * 0.4} Q90 ${86 + pinch} 130 ${88 + pinch * 0.3} L230 92 Q246 96 246 120 Q246 144 230 148 L130 ${152 - pinch * 0.3} Q90 ${154 - pinch} 60 ${148 - pinch * 0.4} Z`);
				f1.setAttribute('transform', `translate(90 ${(84 + pinch).toFixed(1)})`);
				f2.setAttribute('transform', `translate(90 ${(156 - pinch).toFixed(1)})`);
				// the paste: what has been pressed out of the tube lies as a strip of the same area (12 px wide)
				const len = (pinch * 2 * 70 * 0.6) / 12; // the squeezed area divided by the width of the strip
				paste.setAttribute('d', len > 1 ? `M282 120 h8 q10 0 10 10 v${Math.min(len, 70).toFixed(1)}${len > 70 ? ` q0 10 10 10 h${(len - 70).toFixed(1)}` : ''}` : '');
			});
		}
	}
</script>
