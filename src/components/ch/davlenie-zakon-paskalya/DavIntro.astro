<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { person, type Pt } from './person';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const f = (v: number) => v.toFixed(1);
	const fir = (x: number, h: number) => {
		// a snowy fir: three tiers, the trunk, snow on the tiers
		let tree = `M${f(x - 0.05 * h)} 0 h${f(0.1 * h)} v${f(-0.15 * h)} h${f(-0.1 * h)} Z `;
		let snow = '';
		for (let i = 0; i < 3; i++) {
			const top = -h + i * 0.26 * h;
			const bot = top + 0.46 * h;
			const w = 0.17 * h + 0.09 * h * i;
			tree += `M${f(x)} ${f(top)} L${f(x + w)} ${f(bot)} L${f(x - w)} ${f(bot)} Z `;
			snow += `M${f(x)} ${f(top)} L${f(x + w * 0.45)} ${f(top + 0.21 * h)} Q${f(x)} ${f(top + 0.15 * h)} ${f(x - w * 0.45)} ${f(top + 0.21 * h)} Z `;
		}
		return { tree, snow };
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-davintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="snow"]')!;
			const S = 0.75; // px per centimeter
			const SURF = 168; // the surface of the snow, px
			const H = 170; // both people, см
			const RUN = 8;
			const sx = (w: number, W: number, X0: number) => X0 + (w - W) * S;

			// trees on the horizon (they slide back four times slower: far away)
			const trees = [
				{ b: 14, h: 34 },
				{ b: 62, h: 26 },
				{ b: 104, h: 40 },
				{ b: 150, h: 30 },
				{ b: 186, h: 36 },
			];
			const treeEls = new Map<Element, SVGPathElement[]>();
			const setTrees = (panel: Element, shift: number) => {
				let els = treeEls.get(panel);
				if (!els) {
					const g = panel.querySelector('[data-trees]')!;
					els = [el('path', { class: 'da-tree', transform: 'translate(0 130)' }), el('path', { class: 'da-tree-snow', transform: 'translate(0 130)' })];
					g.append(...els);
					treeEls.set(panel, els);
				}
				let tree = '';
				let snow = '';
				for (const t of trees) {
					const x = ((((t.b - shift) % 220) + 220) % 220) - 20;
					const fr = fir(x, t.h);
					tree += fr.tree;
					snow += fr.snow;
				}
				els[0].setAttribute('d', tree);
				els[1].setAttribute('d', snow);
			};

			// falling snow over both halves
			const flakes = card.querySelector('[data-flakes]')!;
			const FL = Array.from({ length: 28 }, (_, i) => ({ x: (i * 97.3) % 360, y: (i * 53.7) % 240, r: 0.9 + (i % 3) * 0.45, v: 9 + (i % 5) * 2.5 }));
			const flakeEls = FL.map((q) => {
				const c = el('circle', { class: 'da-flake', r: q.r });
				flakes.append(c);
				return c;
			});

			// the walker in boots
			const pBoots = card.querySelector('[data-panel="boots"]')!;
			const holesB = pBoots.querySelector('[data-holes]')!;
			const manB = person(pBoots.querySelector('[data-man]')!, { s: S, H, girth: 1, gear: 'boot', coat: 'da-coat--a' });
			// the cut goes through the prints of the near foot; the far foot steps 20 см behind it, inside the snow,
			// so below the surface it is hidden
			const clipId = card.querySelector('[data-above]')!.id;
			pBoots.querySelector('[data-man] .pp-far')!.setAttribute('clip-path', `url(#${clipId})`);
			holesB.setAttribute('fill', `url(#${card.querySelector('linearGradient')!.id})`);
			const packB = pBoots.querySelector('[data-pack]')!;
			const marksB = pBoots.querySelector('[data-marks]')!;
			marksB.setAttribute('class', 'da-mound');
			// the walls of the pits, drawn over the packed snow
			const wallB = el('path', { class: 'da-wall-line' });
			packB.after(wallB);
			const D = 45; // см, the depth of every footprint
			const STEP = 45; // см
			const V = 40; // см/с
			const XB = 86; // px, where the walker stays in his half

			// the skier
			const pSkis = card.querySelector('[data-panel="skis"]')!;
			const manS = person(pSkis.querySelector('[data-man]')!, { s: S, H, girth: 1, gear: 'ski', coat: 'da-coat--b', poles: true });
			const holesS = pSkis.querySelector('[data-holes]')!;
			const packS = pSkis.querySelector('[data-pack]')!;
			const marksS = pSkis.querySelector('[data-marks]')!;
			const DS = 3; // см, the skis press the snow by this much
			const VS = 120; // см/с
			const XS = 82;

			const shoulder = (hip: Pt, lean: number): Pt => ({ x: hip.x + Math.sin(lean) * 0.27 * H * S, y: hip.y - Math.cos(lean) * 0.27 * H * S });
			const hand = (sh: Pt, phi: number, R: number): Pt => ({ x: sh.x + Math.sin(phi) * R, y: sh.y + Math.cos(phi) * R });

			scene(card, RUN, (x) => {
				const t = x * RUN;
				for (let i = 0; i < FL.length; i++) {
					const q = FL[i];
					const y = (q.y + q.v * t) % 250;
					flakeEls[i].setAttribute('cx', f(q.x + 6 * Math.sin(t * 0.8 + i)));
					flakeEls[i].setAttribute('cy', f(y - 5));
				}

				// ---- boots: footprints at k·STEP; the stance foot stands in hole k, the other foot swings from k − 1 to k + 1
				{
					const W = 20 + V * t;
					setTrees(pBoots, W * S * 0.25);
					const q = W / STEP + 0.5;
					const k = Math.floor(q);
					const s = q - k;
					let swX: number;
					let swD: number; // depth of the sole below the surface, см (negative: above)
					let swA: number;
					if (s < 0.3) {
						const e = ease(s / 0.3);
						swX = (k - 1) * STEP + 6 * e;
						swD = D - (D + 6) * e;
						swA = 0.45 * e;
					} else if (s < 0.7) {
						const e = ease((s - 0.3) / 0.4);
						swX = (k - 1) * STEP + 6 + (2 * STEP - 6) * e;
						swD = -6 - 8 * Math.sin((Math.PI * (s - 0.3)) / 0.4);
						swA = 0.45 - 0.3 * e;
					} else {
						const e = ease((s - 0.7) / 0.3);
						swX = (k + 1) * STEP;
						swD = -6 + (D + 6) * e;
						swA = 0.15 * (1 - e);
					}
					const ank = (wx: number, depth: number): Pt => ({ x: sx(wx, W, XB), y: SURF + (depth - 8) * S });
					const stance = ank(k * STEP, D);
					const swing = ank(swX, swD);
					const nearIsStance = ((k % 2) + 2) % 2 === 0;
					const lean = 0.14;
					const hip = { x: sx(W + 4, W, XB), y: SURF + (D - 8 - 73 - 2 * Math.sin(Math.PI * s)) * S };
					const psi = (Math.PI * W) / STEP;
					const sh = shoulder(hip, lean);
					const R = 0.3 * H * S;
					manB({
						hip,
						lean,
						ankles: nearIsStance ? [stance, swing] : [swing, stance],
						feet: nearIsStance ? [0, swA] : [swA, 0],
						hands: [hand(sh, 0.25 + 0.5 * Math.sin(psi), R), hand(sh, 0.25 - 0.5 * Math.sin(psi), R)],
					});
					// the pits in the cut: uneven walls, open at the top, packed snow at the bottom, the snow thrown out
					// on both sides of the opening (the shapes vary a little from one footprint to the next)
					let dh = '';
					let dp = '';
					let dw = '';
					let dm = '';
					for (let j = k - 6; j <= k + 1; j++) {
						const depth = j <= k ? D : s > 0.7 ? Math.max(0, swD) : 0;
						if (depth <= 0.5) continue;
						const P = j * STEP;
						if (sx(P + 40, W, XB) < -5 || sx(P - 22, W, XB) > 185) continue;
						const rn = (i: number) => {
							const v = Math.sin(j * 12.9898 + i * 78.233) * 43758.5453;
							return v - Math.floor(v) - 0.5;
						};
						const pt = (x: number, y: number) => ({ x: sx(P + x, W, XB), y: SURF + y * S });
						// a smooth line through the points (quadratic curves through the midpoints)
						const smooth = (q: Pt[]) => {
							let d = `M${f(q[0].x)} ${f(q[0].y)} L${f((q[0].x + q[1].x) / 2)} ${f((q[0].y + q[1].y) / 2)}`;
							for (let i = 1; i < q.length - 1; i++) d += ` Q${f(q[i].x)} ${f(q[i].y)} ${f((q[i].x + q[i + 1].x) / 2)} ${f((q[i].y + q[i + 1].y) / 2)}`;
							return `${d} L${f(q[q.length - 1].x)} ${f(q[q.length - 1].y)}`;
						};
						const lip = (x0: number, x1: number, y: number, h: number): string => `M${f(x0)} ${f(y)} Q${f(x0 + (x1 - x0) * 0.3)} ${f(y - h)} ${f((x0 + x1) / 2)} ${f(y - h * 0.9)} Q${f(x0 + (x1 - x0) * 0.75)} ${f(y - h * 0.7)} ${f(x1)} ${f(y)} Z `;
						if (((j % 2) + 2) % 2 === 1) {
							// a print of the far foot: an opening in the surface behind the cut
							const q = [pt(-13 + 3 * rn(0), -8), pt(-6, -8 - 3.5 + rn(1)), pt(8, -8 - 4.5 + rn(2)), pt(22, -8 - 3.5 + rn(3)), pt(28 + 3 * rn(4), -8), pt(20, -8 + 2.5), pt(5, -8 + 3 + rn(5)), pt(-8, -8 + 2.2), pt(-13 + 3 * rn(0), -8)];
							dm += `${smooth(q)} Z `;
							dw += `${smooth(q.slice(0, 5))} `;
							continue;
						}
						// a print of the near foot, cut through: uneven crumbly walls, open at the top
						const wall: Pt[] = [pt(-17 + 4 * rn(0), 0)];
						for (let i = 1; i <= 5; i++) wall.push(pt(-13 + 2 * i * 0.25 + 3.2 * rn(i), (i / 6) * depth));
						wall.push(pt(-8 + 2 * rn(6), depth - 1 + 1.5 * rn(7)), pt(2 + 4 * rn(8), depth + 1 + 1.5 * rn(9)), pt(13 + 3 * rn(10), depth + 1.5 * rn(11)), pt(21 + 2 * rn(12), depth - 1.5));
						for (let i = 5; i >= 1; i--) wall.push(pt(26 - i * 0.4 + 3.2 * rn(12 + i), (i / 6) * depth));
						wall.push(pt(32 + 4 * rn(18), 0));
						const line = smooth(wall);
						dh += `${line} Z `;
						dw += `${line} `;
						// packed snow under the bottom, 5…8 см thick, its lower edge uneven
						const b0 = 5;
						const b1 = 10;
						const pk = (5 + 3 * (depth / D)) * S;
						const under = wall.slice(b0, b1 + 1).map((q, i) => ({ x: q.x + (i === 0 ? 3 : i === b1 - b0 ? -3 : 0), y: q.y + pk * (i === 0 || i === b1 - b0 ? 0.3 : 0.8 + 0.4 * Math.abs(rn(20 + i))) }));
						dp += `${smooth(wall.slice(b0, b1 + 1))} ${smooth(under.slice().reverse()).replace(/^M/, 'L')} Z `;
						// snow thrown out on both sides of the opening
						const h = (2 + 1.2 * rn(14)) * (depth / D);
						dp += lip(wall[0].x - 9, wall[0].x + 1, SURF, h) + lip(wall[wall.length - 1].x - 1, wall[wall.length - 1].x + 10, SURF, h * 0.85);
					}
					holesB.setAttribute('d', dh);
					packB.setAttribute('d', dp);
					wallB.setAttribute('d', dw);
					marksB.setAttribute('d', dm);
				}

				// ---- skis: diagonal stride, the skis slide back and forth under the body
				{
					const W = VS * t;
					setTrees(pSkis, W * S * 0.25 + 70);
					const psi = (2 * Math.PI * t) / 1.3;
					const relN = 18 * Math.sin(psi);
					const yA = SURF + (DS - 10.5) * S;
					const lean = 0.22;
					const hip = { x: sx(W + 2, W, XS), y: yA - (71 + 1.5 * Math.abs(Math.cos(psi))) * S };
					const sh = shoulder(hip, lean);
					const R = 0.31 * H * S;
					const hN = hand(sh, 0.35 - 0.6 * Math.sin(psi), R);
					const hF = hand(sh, 0.35 + 0.6 * Math.sin(psi), R);
					const Lp = 0.83 * H * S;
					const tip = (h: Pt): Pt => {
						const grip = { x: h.x + 0.02 * H * S, y: h.y - 0.035 * H * S };
						const ty = SURF + 2 * S;
						const dy = ty - grip.y;
						return { x: grip.x - Math.sqrt(Math.max(0, Lp * Lp - dy * dy)), y: Math.min(ty, grip.y + Lp) };
					};
					manS({
						hip,
						lean,
						ankles: [
							{ x: sx(W + relN, W, XS), y: yA },
							{ x: sx(W - relN, W, XS), y: yA - 1.2 },
						],
						feet: [0, 0],
						hands: [hN, hF],
						poleTips: [tip(hN), tip(hF)],
					});
					// the track: a groove 3 см deep from far behind up to the front of the skis
					const xe = sx(W + Math.abs(relN) + 82, W, XS);
					const yb = SURF + DS * S;
					holesS.setAttribute('d', `M-5 ${SURF} H${f(xe + 4)} L${f(xe)} ${f(yb)} H-5 Z`);
					packS.setAttribute('d', `M-5 ${f(yb)} H${f(xe)} Q${f(xe + 3)} ${f(yb + 3)} ${f(xe - 6)} ${f(yb + 3.2)} H-5 Z`);
					const xr = sx(W - Math.abs(relN) - 84, W, XS);
					marksS.setAttribute('d', `M-5 ${SURF - 3.5} H${f(xr)}`);
				}
			});
		}

		{
			const card = root.querySelector<HTMLElement>('[data-scene="tube"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 1.1; // px per millimeter
			const R0 = 17.5; // мм, half the thickness of the round part
			const XP = -129; // мм, the middle of the dent: 42 мм from the flat end (the tube is 171 мм long)
			const SIG = 16; // мм, the width of the dent
			const XH = -96; // мм, the point the hand is drawn around
			const HS = -43; // мм, the hand is shifted by this much: the fingertips end at the middle of the dent
			const r = 3.5; // мм, the radius of the paste strand
			const THETA = (16 * Math.PI) / 180;
			const TOE = 300 - r * K; // px, the far end of the strand on the bristles
			const YB = 193; // px, the tops of the bristles
			const YR = YB - r * K + 1; // px, the axis of the strand lying on the bristles
			const OY = 171; // px, the height of the opening
			// the hanging part of the strand: from the opening along the tube, down onto the bristles
			const hang = (ox: number): Pt[] => [
				{ x: ox, y: OY },
				{ x: ox + 9 * Math.cos(THETA), y: OY + 9 * Math.sin(THETA) },
				{ x: ox + 6, y: YR },
				{ x: ox + 13, y: YR },
			];
			const bez = (p: Pt[], u: number): Pt => {
				const a = 1 - u;
				return {
					x: a * a * a * p[0].x + 3 * a * a * u * p[1].x + 3 * a * u * u * p[2].x + u * u * u * p[3].x,
					y: a * a * a * p[0].y + 3 * a * a * u * p[1].y + 3 * a * u * u * p[2].y + u * u * u * p[3].y,
				};
			};
			let LH = 0; // px, the length of the hanging part
			{
				const p = hang(0);
				let prev = p[0];
				for (let i = 1; i <= 50; i++) {
					const q = bez(p, i / 50);
					LH += Math.hypot(q.x - prev.x, q.y - prev.y);
					prev = q;
				}
			}
			const LAID = 26; // мм lie on the bristles at the end
			const LTOT = LH / K + LAID; // мм of paste in all
			// the volume the tube loses, ∫π·δ² dx = π·δmax²·σ·√(π/2), equals the volume of the strand π·r²·LTOT
			const DMAX = Math.sqrt((r * r * LTOT) / (SIG * Math.sqrt(Math.PI / 2)));
			const O0 = TOE - 13; // the opening above the toe of the brush when the strand first touches it

			// the half-thickness of the tube at x (мм from the opening, the flat end at −171)
			const half = (x: number, dmax: number) => {
				const a = x + 171; // from the flat end
				let t = R0;
				if (a < 8) t = 1.6;
				else if (a < 32) t = 1.6 + (R0 - 1.6) * Math.sqrt(ease((a - 8) / 24));
				return Math.max(1.2, t - dmax * Math.exp(-(((x - XP) / SIG) ** 2)));
			};
			const tubePath = (dm: number) => {
				const top: string[] = [];
				const bot: string[] = [];
				for (let x = -171; x <= -22; x += 1.5) {
					const h = half(x, dm);
					top.push(`${f(x)} ${f(-h)}`);
					bot.unshift(`${f(x)} ${f(h)}`);
				}
				return `M${top.join(' L')} Q-23 ${-R0} -22 -9 L-22 9 Q-23 ${R0} ${bot.join(' L')} Z`;
			};
			const tube = $<SVGPathElement>('[data-tube]');
			const clip = $<SVGPathElement>('[data-tubeclip]');
			const tubeg = $<SVGGElement>('[data-tubeg]');
			const pastes = card.querySelectorAll<SVGPathElement>('[data-paste]');

			// the hand: a right hand seen from the thumb side; the flat end of the tube lies in the web between the thumb
			// (on top) and the index finger (curled under); the middle and the ring finger are behind the tube
			const hand = $<SVGGElement>('[data-hand]');
			const back = $<SVGGElement>('[data-backfingers]');
			const mkF = (parent: Element, w: number, cls = 'da-finger') => {
				const o = el('path', { class: 'da-finger-o', 'stroke-width': f(w + 1.8 / K) });
				const p = el('path', { class: cls, 'stroke-width': f(w) });
				parent.append(o, p);
				return (d: string) => {
					o.setAttribute('d', d);
					p.setAttribute('d', d);
				};
			};
			const C = -171; // the flat end of the tube
			// the forearm goes up and to the left from the wrist (center WC), 52 мм wide, in a knitted sleeve
			const WC = { x: C - 36, y: -40 };
			const dir = { x: -0.62, y: -0.78 };
			const nrm = { x: 0.78, y: -0.62 };
			const at = (a: number, b: number) => `${f(WC.x + dir.x * a + nrm.x * b)} ${f(WC.y + dir.y * a + nrm.y * b)}`;
			back.append(el('path', { class: 'da-palm', d: `M${at(0, 27)} L${at(200, 27)} L${at(200, -27)} L${at(0, -27)} Z` }));
			back.setAttribute('transform', `translate(${HS} 0)`);
			hand.setAttribute('transform', `translate(${HS} 0)`);
			const ring = mkF(back, 15, 'da-finger da-finger--back');
			const middle = mkF(back, 16, 'da-finger da-finger--back');
			const palm = el('path', { class: 'da-palm' });
			hand.append(palm);
			const index = mkF(hand, 16.5);
			const thumb = mkF(hand, 19);
			const nailT = el('path', { class: 'da-nail' });
			const nailI = el('path', { class: 'da-nail' });
			const crease = el('path', { class: 'da-crease' });
			hand.append(nailT, nailI, crease);
			hand.append(el('path', { class: 'da-sleeve', d: `M${at(22, 31)} L${at(200, 31)} L${at(200, -31)} L${at(22, -31)} Q${at(16, 0)} ${at(22, 31)} Z` }));
			hand.append(el('path', { class: 'da-sleeve-rib', d: [5, 15, 25, 35].map((b) => `M${at(24, b - 20)} L${at(52, b - 20)}`).join(' ') }));
			const pose = (d: number) => {
				const top = -(R0 - d); // the top of the tube under the thumb
				const bot = R0 - d;
				palm.setAttribute('d', `M${at(4, 27)} Q${f(C - 6)} -58 ${f(C + 6)} -40 L${f(C + 2)} -8 Q${f(C + 12)} 8 ${f(C + 14)} 20 Q${f(C + 6)} 40 ${f(C - 18)} 36 Q${f(C - 46)} 26 ${at(4, -27)} Z`);
				thumb(`M${f(C - 2)} -44 Q${f(C + 34)} ${f(-R0 - 18)} ${f(XH - 8)} ${f(top - 12)} L${f(XH + 12)} ${f(top - 9.5)}`);
				nailT.setAttribute('d', `M${f(XH + 3)} ${f(top - 17.5)} Q${f(XH + 13)} ${f(top - 19)} ${f(XH + 20)} ${f(top - 14)} L${f(XH + 19)} ${f(top - 11)} Q${f(XH + 10)} ${f(top - 13)} ${f(XH + 3)} ${f(top - 13)} Z`);
				index(`M${f(C + 8)} 18 Q${f(C + 40)} ${f(R0 + 24)} ${f(XH - 4)} ${f(bot + 18)} Q${f(XH + 16)} ${f(bot + 17)} ${f(XH + 14)} ${f(bot + 9)} L${f(XH + 4)} ${f(bot + 7.5)}`);
				nailI.setAttribute('d', `M${f(XH + 19)} ${f(bot + 17)} Q${f(XH + 25)} ${f(bot + 12)} ${f(XH + 21)} ${f(bot + 5.5)} L${f(XH + 17.5)} ${f(bot + 7)} Q${f(XH + 20)} ${f(bot + 11)} ${f(XH + 16)} ${f(bot + 15.5)} Z`);
				middle(`M${f(C)} 26 Q${f(C + 34)} ${f(R0 + 34)} ${f(XH - 12)} ${f(bot + 28)} Q${f(XH + 4)} ${f(bot + 26)} ${f(XH)} ${f(bot + 17)} L${f(XH - 8)} ${f(bot + 10)}`);
				ring(`M${f(C - 8)} 30 Q${f(C + 26)} ${R0 + 42} ${f(C + 50)} ${R0 + 36} Q${f(C + 64)} ${R0 + 32} ${f(C + 58)} ${R0 + 22} L${f(C + 50)} ${R0 + 17}`);
				crease.setAttribute('d', `M${f(C + 40)} ${f(-R0 - 26)} q3 4 1 9 M${f(XH - 2)} ${f(bot + 10)} q4 5 1 10 M${f(XH - 34)} ${f(R0 + 13)} q-2 6 1 12`);
			};

			scene(card, 6, (x) => {
				const sq = ease((x - 0.08) / 0.6); // the squeeze grows for 3,6 s
				const dm = DMAX * sq;
				const L = LTOT * sq * sq * K; // px of paste out: ∝ δ², the volume the tube lost
				let ox = O0;
				let dPaste = '';
				if (L > 0.3) {
					if (L <= LH) {
						// the strand grows out of the opening along its curve
						const p = hang(O0);
						const u = L / LH;
						const pts: string[] = [];
						for (let i = 0; i <= 16; i++) {
							const q = bez(p, (u * i) / 16);
							pts.push(`${f(q.x)} ${f(q.y)}`);
						}
						dPaste = `M${pts.join(' L')}`;
					} else {
						// it lies on the bristles from the toe back to where it lands; the hand moves the tube along
						const laid = L - LH;
						ox = O0 - laid;
						const ph = hang(ox);
						dPaste = `M${f(ph[0].x)} ${OY} C${f(ph[1].x)} ${f(ph[1].y)} ${f(ph[2].x)} ${f(ph[2].y)} ${f(ph[3].x)} ${f(ph[3].y)} L${f(ph[3].x + laid)} ${f(YR)}`;
					}
				}
				tubeg.setAttribute('transform', `translate(${f(ox)} ${OY}) rotate(16) scale(${K})`);
				const d = tubePath(dm);
				tube.setAttribute('d', d);
				clip.setAttribute('d', d);
				pose(R0 - half(XH + HS + 8, dm));
				for (const e of pastes) e.setAttribute('d', dPaste);
			});
		}
	}
</script>
