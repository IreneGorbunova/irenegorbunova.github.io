---
/**
 * Two short looping opening scenes of «Давление. Закон Паскаля». No terms of the chapter in the pictures.
 *
 * Snow: two people of the same height (170 см) and build cross deep loose snow, each in his own half of the
 *   picture; the camera follows each of them, so the snow, the trees and the tracks slide back. The front face of the
 *   snow is a cut along the track, so one sees how deep each foot goes. The one in boots trudges at 0,4 м/с with steps
 *   of 45 см and sinks to just under the knee, 45 см, at every step; the holes stay behind him. The skier glides at
 *   1,2 м/с on skis 180 см long, and his skis press the snow by only 3 см; his track stays behind as a shallow groove.
 *   Scale 0,75 px per centimeter, the snow drawn 1 м deep. Real time. The depths are typical of fresh loose snow
 *   (boots 30–50 см, skis a few centimeters); real snow differs.
 * Tube: a hand pinches a toothpaste tube at its flat (closed) end; the paste comes out of the nozzle at the other end and is
 *   laid on the bristles of a toothbrush as the hand moves the tube along. Seen from the edge of the tube, 1,1 px per
 *   millimeter: the round part is 35 мм across, the tube 171 мм long, the nozzle opening 7 мм, the brush head about
 *   31 мм, the whole brush 19 см. The tube is held tilted by 16°; it is flat for its last 8 мм and round from 32 мм
 *   on. The fingers press near the flat end and flatten the tube by 2δ, δ(x) = δmax·exp(−((x − 42 мм)/16 мм)²), x from
 *   the flat end; the fingertips end at the middle of the dent, so its other half shows next to them. A round tube
 *   flattened to the thickness h keeps its perimeter, so its cross-section loses π·δ² (exactly, for a stadium-shaped
 *   section; the small tail of the dent in the flattening part is counted the same way); the paste that comes out
 *   has the volume the tube lost: a strand 7 мм thick and 48 мм long (22 мм hanging, 26 мм lying on the bristles;
 *   1,9 см³), which takes δmax ≈ 5,4 мм (computed in the script). The squeeze takes 3,6 s; the strand is laid as the
 *   hand moves the tube back along the brush, as fast as the paste comes out. The hand is to the same scale.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const PANELS = [
	{ key: 'boots', x: 0, label: 'в ботинках' },
	{ key: 'skis', x: 180, label: 'на лыжах' },
];
// faint layers in the cut of the snow
const layers = 'M0 186 Q45 184 90 187 T180 185 M0 205 Q60 207 120 204 T180 206 M0 224 Q50 221 100 225 T180 223';
// bathroom tiles behind the tube
const tiles: string[] = [];
for (let x = 30; x < 360; x += 48) tiles.push(`M${x} 0 V214`);
for (let y = 22; y < 214; y += 48) tiles.push(`M0 ${y} H360`);
// bristle tufts of the brush, from the heel (x = 266) to the toe (x = 300)
const tufts = Array.from({ length: 8 }, (_, i) => 266 + i * 4.3);
---

<IntroFrame data-davintro>
	<div class="intro__card" data-scene="snow">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Два человека одного роста идут по глубокому снегу. Тот, что в ботинках, при каждом шаге проваливается почти по колено и оставляет глубокие ямы, а лыжник скользит по поверхности, и после него остаётся мелкая лыжня">
			<defs>
				{PANELS.map((p) => (
					<clipPath id={`da-clip-${p.key}-${uid}`}>
						<rect x="0" y="0" width="180" height="240" />
					</clipPath>
				))}
				<clipPath id={`da-above-${uid}`} data-above>
					<rect x="-20" y="-20" width="220" height="183" />
				</clipPath>
				<linearGradient id={`da-pit-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="da-pit-top" />
					<stop offset="1" class="da-pit-bottom" />
				</linearGradient>
			</defs>
			{
				PANELS.map((p) => (
					<g transform={`translate(${p.x} 0)`}>
						<g clip-path={`url(#da-clip-${p.key}-${uid})`} data-panel={p.key}>
							<rect class="da-sky" x="0" y="0" width="180" height="240" />
							<path class="da-hill" d="M0 128 Q40 112 80 120 T180 116 V130 H0 Z" />
							<g data-trees />
							<rect class="da-field" x="0" y="127" width="180" height="41" />
							<path class="da-mark" data-marks />
							<rect class="da-cut" x="0" y="168" width="180" height="72" />
							<path class="da-layer" d={layers} />
							<path class="da-hole" data-holes />
							<path class="da-pack" data-pack />
							<g data-man />
							<text class="da-label da-halo" x="10" y="20">{p.label}</text>
						</g>
					</g>
				))
			}
			<g data-flakes></g>
			<line class="da-sep" x1="180" y1="0" x2="180" y2="240"></line>
		</svg>
		<div class="intro__foot">
			<p>
				По глубокому снегу идут двое. Тот, кто в ботинках, проваливается по колено, а лыжник идёт поверху, хотя{' '}
				<More term="весят они одинаково">
					Оба давят на снег с одной и той же силой. Но у лыжника эта сила приходится на площадь двух лыж, а у пешехода — на площадь двух подошв, которая раз в десять меньше. На каждый квадратный сантиметр снега под лыжами приходится в десять раз меньшая сила. Об этом — в разделе{' '}
					<a href="#давление">«Давление»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="tube">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Рука сжимает тюбик зубной пасты у плоского конца, а из отверстия на другом конце выходит полоска пасты и ложится на щётку">
			<defs>
				<clipPath id={`da-tubeclip-${uid}`}>
					<path data-tubeclip />
				</clipPath>
			</defs>
			<rect class="da-wall" x="0" y="0" width="360" height="240"></rect>
			<path class="da-tiles" d={tiles.join(' ')}></path>
			<rect class="da-shelf" x="0" y="214" width="360" height="26"></rect>
			<line class="da-shelf-edge" x1="0" y1="214.5" x2="360" y2="214.5"></line>
			<g>
				<path class="da-brush" d="M100 207.5 Q100 203.5 106 203 L170 202 Q186 202 200 206 L262 207.5 L304 207.5 Q308 207.5 308 211 Q308 214 304 214 L106 214 Q100 214 100 210 Z"></path>
				<path class="da-grip" d="M114 205 Q135 203 156 204 L156 209.5 Q135 208 114 210 Z"></path>
				{tufts.map((x, i) => <rect class={i % 2 ? 'da-tuft da-tuft--b' : 'da-tuft'} x={x} y="193" width="3.8" height="15" rx="1.6" />)}
			</g>
			<g class="da-cap">
				<rect x="318" y="200" width="18" height="14" rx="2"></rect>
				<path d="M321 201.5 V212.5 M324.5 201.5 V212.5 M328 201.5 V212.5 M331.5 201.5 V212.5"></path>
			</g>
			<g data-tubeg>
				<g data-backfingers></g>
				<path class="da-tube" data-tube></path>
				<g clip-path={`url(#da-tubeclip-${uid})`}>
					<rect class="da-band" x="-112" y="-30" width="78" height="60"></rect>
					<path class="da-band-line" d="M-104 -30 V30 M-42 -30 V30"></path>
					<rect class="da-shine" x="-171" y="-11" width="160" height="4"></rect>
				</g>
				<path class="da-crimp" d="M-169.5 -1.4 V1.4 M-167 -1.4 V1.4 M-164.5 -1.4 V1.4 M-162 -1.4 V1.4"></path>
				<path class="da-neck" d="M-22 -9 Q-14 -6 -11 -5.5 H0 V5.5 H-11 Q-14 6 -22 9 Z"></path>
				<path class="da-thread" d="M-9 -5.5 L-7.5 5.5 M-5.5 -5.5 L-4 5.5 M-2 -5.5 L-0.5 5.5"></path>
				<g data-hand></g>
			</g>
			<path class="da-paste-edge" data-paste></path>
			<path class="da-paste" data-paste></path>
			<path class="da-stripe" data-paste></path>
		</svg>
		<div class="intro__foot">
			<p>
				На тюбик нажимают у одного конца, а паста выходит на другом:{' '}
				<More term="давление передаётся по всей пасте">
					Пальцы сжимают тюбик только в одном месте, но сдавленной оказывается вся паста: она передаёт давление во все стороны и в каждую свою точку. Так же ведут себя жидкости и газы. Об этом — в разделе{' '}
					<a href="#закон-паскаля">«Закон Паскаля»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

