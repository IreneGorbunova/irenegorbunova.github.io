---
/**
 * «Гидравлические машины за работой» (Irina, 18 Nov 2026: «К гидравлическому прессу добавить ещё анимации в
 * использовании»). Four animated panels, schemes not to scale; the numbers in the notes are real and checked:
 *
 * Домкрат — a bottle jack under the sill of a car, the hand pumps the lever. Plunger d = 14 мм (1,54 см²), ram
 *   d = 32 мм (8,04 см²): S₂/S₁ = 5,2; the lever is 8 : 1 (pin 4,5 см, handle 36 см from the pivot), so the gain is
 *   about 42. One side of a 1200 кг car: about 600 кг, 5,9 кН; the hand needs 5,9 кН/42 ≈ 140 Н. A plunger stroke of
 *   25 мм lifts the ram by 25·1,54/8,04 = 4,8 мм ≈ 5 мм. Drawn at 2 px per сантиметр near the jack (the car's wheel is
 *   to the same scale); 15 strokes lift the sill by 7,2 см: the first 5 см only let the suspension out, then the wheel
 *   leaves the ground. A stroke takes 0,6 с (by hand about 1 с). Then the release valve lets the car down.
 * Тормоза — the foot presses the pedal (lever 4 : 1) with 200 Н, the push rod presses the master cylinder's piston
 *   (d = 22,2 мм, 3,87 см²) with 800 Н: p = 800 Н/3,87 см² = 2,07 МПа. The same pressure in the four calipers (pistons
 *   d = 54 мм, 22,9 см²) presses each pad with 2,07 МПа·22,9 см² = 4,7 кН. Real cars add a vacuum booster (about
 *   ×4), left out here. Top view of the chassis; the tyres' tread and the road show the motion; braking from the
 *   drawn speed to rest takes 2 с.
 * Экскаватор — the boom is lifted by a hydraulic cylinder. Working pressure up to 30 МПа (usual for excavators,
 *   30–35 МПа); a boom cylinder of bore 12 см (113 см²) pushes with 30 МПа·113 см² ≈ 340 кН. The boom turns between
 *   12° and 55° in 3 с each way; the cylinder's length follows from the geometry.
 * Пресс для масла — a hand oil press: a 20 т jack (196 кН ≈ 200 кН) pushes a piston of diameter 10 см (78,5 см²) into a
 *   perforated cage of sunflower seeds: p = 200 кН/78,5 см² ≈ 25 МПа. The oil runs out through the holes into the
 *   tray and the jar. The seed layer is squeezed to a little more than half its height; slowed down (7 с).
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);

const TREAD = [0, 6, 12, 18, 24, 30];
---

<G7Styles />
<figure class="g7 g7--pic pru not-content" data-pressuses>
	<div class="g7__grid is-two">
		<!-- 1. jack -->
		<svg class="g7__svg" viewBox="0 0 240 242" role="img" aria-label="Гидравлический домкрат: рука качает рычаг, и домкрат приподнимает автомобиль, колесо отрывается от земли" data-p="jack">
			<text class="t-title" x="120" y="18" text-anchor="middle">Домкрат</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">рука поднимает автомобиль</text>
			<clipPath id={`pru-jack-${uid}`}><rect x="0" y="40" width="240" height="160"></rect></clipPath>
			<rect class="pru__road" x="0" y="190" width="240" height="8"></rect>
			<g clip-path={`url(#pru-jack-${uid})`}>
				<g data-wheel>
					<circle class="pru__tyre" cx="206" cy="159" r="31"></circle>
					<circle class="pru__rim" cx="206" cy="159" r="18"></circle>
					<circle class="pru__hub" cx="206" cy="159" r="5"></circle>
				</g>
				<g data-car>
					<path class="pru__car" d="M0 44 H240 V144.4 A37 37 0 0 0 169.3 154 H0 Z"></path>
					<path class="pru__glass" d="M0 44 H150 L160 64 H0 Z"></path>
					<rect class="pru__sill" x="0" y="146" width="170" height="8"></rect>
					<path class="pru__seam" d="M118 64 V146 M8 64 V146"></path>
					<rect class="pru__handle" x="96" y="82" width="16" height="4" rx="2"></rect>
				</g>
			</g>
			<!-- the jack: base, body, ram, saddle -->
			<rect class="pru__steel" x="70" y="184" width="50" height="6" rx="1"></rect>
			<rect class="pru__jack" x="88" y="162" width="24" height="22" rx="3"></rect>
			<rect class="pru__jackpump" x="72" y="168" width="9" height="16" rx="1"></rect>
			<rect class="pru__ram" data-ram x="94" width="12"></rect>
			<rect class="pru__steel" data-saddle x="90" width="20" height="4" rx="1"></rect>
			<line class="pru__rod" data-plunger x1="76.5" x2="76.5" y2="170"></line>
			<g data-lever>
				<line class="pru__lever" x1="0" y1="0" x2="-72" y2="0"></line>
				<circle class="pru__pin" cx="0" cy="0" r="2"></circle>
			</g>
			<g clip-path={`url(#pru-jack-${uid})`}>
				<g data-hand>
					<path class="pru__sleeve" d="M-9 -6 L-30 -130 L-6 -134 L9 -6 Z"></path>
					<rect class="pru__skin" x="-8" y="-14" width="15" height="8" rx="2"></rect>
					<rect class="pru__skin" x="-11" y="-9" width="22" height="17" rx="7"></rect>
					<path class="pru__knuckle" d="M-4 -1 V6 M2 -1 V6"></path>
				</g>
			</g>
			<text class="t-strong t-num t-halo" x="232" y="58" text-anchor="end" data-strokes></text>
			<text class="t-small pru__note" x="120" y="214" text-anchor="middle">рука давит 140 Н, а домкрат держит 6 кН;</text>
			<text class="t-small pru__note" x="120" y="228" text-anchor="middle">за один ход машина поднимается на 5&nbsp;мм</text>
		</svg>

		<!-- 2. brakes -->
		<svg class="g7__svg" viewBox="0 0 240 242" role="img" aria-label="Тормоза автомобиля: нога давит на педаль и малый поршень, жидкость по трубкам давит на поршни у всех четырёх колёс, колодки сжимают диски, и машина останавливается" data-p="brake">
			<text class="t-title" x="120" y="18" text-anchor="middle">Тормоза</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">нога останавливает автомобиль</text>
			<!-- road dashes -->
			<g data-dashes>
				{[0, 1, 2, 3, 4, 5, 6].map((i) => <rect class="pru__dash" x="234" y={40 + i * 26} width="3" height="12" />)}
			</g>
			<!-- chassis from above -->
			<rect class="pru__body" x="128" y="46" width="88" height="150" rx="24"></rect>
			<rect class="pru__roof" x="140" y="92" width="64" height="64" rx="8"></rect>
			{[
				[115, 64],
				[215, 64],
				[115, 150],
				[215, 150],
			].map(([x, y]) => (
				<g>
					<rect class="pru__tyretop" x={x} y={y} width="14" height="32" rx="3" />
					{TREAD.map((d) => <line class="pru__tread" data-tread={`${y} ${d}`} x1={x + 2} x2={x + 12} y1={y + d} y2={y + d} />)}
				</g>
			))}
			<path class="pru__line" d="M104 80 H172 M140 80 H172 H204 M172 80 V166 M140 166 H204"></path>
			<path class="pru__line pru__line--p" data-pressure d="M104 80 H172 M140 80 H172 H204 M172 80 V166 M140 166 H204"></path>
			{[
				[130, 80, 1],
				[214, 80, -1],
				[130, 166, 1],
				[214, 166, -1],
			].map(([x, y, s]) => (
				<g data-cal={s}>
					<rect class="pru__caliper" x={s > 0 ? x : x - 12} y={y - 8} width="12" height="16" rx="2" />
					<rect class="pru__pad" data-pad x={s > 0 ? x - 1 : x - 2} y={y - 6} width="3" height="12" />
				</g>
			))}
			<!-- pedal, foot, master cylinder -->
			<rect class="pru__master" x="66" y="72" width="38" height="16" rx="2"></rect>
			<rect class="pru__res" x="78" y="60" width="18" height="12" rx="2"></rect>
			<rect class="pru__mpiston" data-mpiston x="70" y="74" width="5" height="12"></rect>
			<line class="pru__rod" data-pushrod y1="80" y2="80"></line>
			<g data-pedal>
				<line class="pru__lever" x1="54" y1="48" x2="47" y2="118"></line>
				<rect class="pru__pedalpad" x="42" y="106" width="8" height="26" rx="2"></rect>
				<path class="pru__leg" d="M4 166 L30 150 L-4 58 L-40 76 Z"></path>
				<path class="pru__shoe" d="M42 102 Q47 118 43 136 L26 182 Q20 190 10 186 L4 178 Q2 164 12 152 L30 104 Q34 96 42 102 Z"></path>
				<path class="pru__sole" d="M44 102 Q49 118 45 136 L28 183"></path>
				<path class="pru__lace" d="M27 118 l6 3 M24 128 l6 3 M21 138 l6 3"></path>
			</g>
			<circle class="pru__pin" cx="54" cy="48" r="2.5"></circle>
			<text class="t-small" x="92" y="102" text-anchor="middle">малый</text>
			<text class="t-small" x="92" y="114" text-anchor="middle">поршень</text>
			<text class="t-small" x="172" y="62" text-anchor="middle">колодки</text>
			<text class="t-small pru__note" x="120" y="214" text-anchor="middle">нога давит на педаль с силой 200 Н,</text>
			<text class="t-small pru__note" x="120" y="228" text-anchor="middle">а каждую колодку прижимает 4,7 кН</text>
		</svg>

		<!-- 3. excavator -->
		<svg class="g7__svg" viewBox="0 0 240 242" role="img" aria-label="Экскаватор: гидроцилиндр выдвигается и поднимает стрелу с ковшом земли" data-p="dig">
			<text class="t-title" x="120" y="18" text-anchor="middle">Экскаватор</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">масло поднимает стрелу с ковшом</text>
			<rect class="pru__soil" x="0" y="192" width="240" height="8"></rect>
			<path class="pru__earth" d="M178 192 Q196 170 214 176 Q230 180 240 174 V192 Z"></path>
			<!-- tracks and the turntable -->
			<rect class="pru__track" x="20" y="172" width="100" height="20" rx="10"></rect>
			{[32, 52, 72, 92, 108].map((x) => <circle class="pru__roller" cx={x} cy="182" r="5.5" />)}
			<rect class="pru__machine" x="22" y="134" width="94" height="36" rx="6"></rect>
			<rect class="pru__machine" x="78" y="98" width="36" height="38" rx="4"></rect>
			<rect class="pru__window" x="83" y="103" width="25" height="19" rx="2"></rect>
			<rect class="pru__steel" x="40" y="124" width="5" height="12"></rect>
			<!-- the boom, its cylinder, the arm and the bucket -->
			<line class="pru__barrel" data-barrel></line>
			<line class="pru__rodline" data-crod></line>
			<line class="pru__boom" data-boom></line>
			<line class="pru__arm" data-arm></line>
			<g data-bucket>
				<path class="pru__dirt" d="M-15 3 Q-9 -13 3 -9 Q13 -6 14 4 Z"></path>
				<path class="pru__bucket" d="M-14 0 L-14 10 Q-12 22 4 24 L14 24 L16 28 L18 24 L14 4 L13 0"></path>
			</g>
			<circle class="pru__pin" data-pin0 cx="104" cy="146" r="2.5"></circle>
			<circle class="pru__pin" data-pin1 r="2.5"></circle>
			<line class="ln" x1="122" y1="156" x2="138" y2="199"></line>
			<text class="t-small" x="140" y="208" text-anchor="middle">гидроцилиндр</text>
			<text class="t-small pru__note" x="120" y="225" text-anchor="middle">давление масла в цилиндре 30 МПа,</text>
			<text class="t-small pru__note" x="120" y="238" text-anchor="middle">и он толкает стрелу с силой 340 кН</text>
		</svg>

		<!-- 4. oil press -->
		<svg class="g7__svg" viewBox="0 0 240 242" role="img" aria-label="Пресс для масла: домкрат вдавливает поршень в цилиндр с семенами, и масло вытекает через отверстия в банку" data-p="oil">
			<text class="t-title" x="120" y="18" text-anchor="middle">Пресс для масла</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">масло выжимают из семян</text>
			<line class="ln" x1="4" x2="236" y1="190" y2="190"></line>
			<rect class="pru__frame" x="48" y="182" width="144" height="8" rx="1"></rect>
			<rect class="pru__frame" x="56" y="44" width="8" height="138"></rect>
			<rect class="pru__frame" x="176" y="44" width="8" height="138"></rect>
			<rect class="pru__frame" x="48" y="42" width="144" height="14" rx="2"></rect>
			<!-- seeds in the cage -->
			<clipPath id={`pru-cage-${uid}`}><rect x="95.5" y="56" width="49" height="88"></rect></clipPath>
			<g clip-path={`url(#pru-cage-${uid})`} data-seeds>
				{Array.from({ length: 46 }, () => <ellipse class="pru__seed" rx="3.4" ry="1.8" />)}
			</g>
			<path class="pru__cage" d="M94 56 V142 M146 56 V142"></path>
			<path class="pru__cagering" d="M90 58 H150 M90 140 H150 M90 99 H150"></path>
			<!-- the piston, the ram, the jack -->
			<rect class="pru__steel" data-plate x="96" width="48" height="8" rx="1"></rect>
			<rect class="pru__ram" data-pram x="112" width="16"></rect>
			<rect class="pru__jack" x="102" y="150" width="36" height="32" rx="3"></rect>
			<line class="pru__lever" data-jlever x1="138" y1="158"></line>
			<!-- tray, spout, jar -->
			<path class="pru__tray" d="M80 142 V150 H94 M146 150 H168 L176 156"></path>
			<path class="pru__oilfill" d="M82 146 H94 V149 H82 Z M146 146 H166 L172 152 H146 Z"></path>
			<line class="pru__stream" data-stream x1="177" y1="157" x2="218" y2="176"></line>
			<rect class="pru__jar" x="208" y="150" width="26" height="40" rx="3"></rect>
			<rect class="pru__oil" data-jar x="210" width="22" rx="1.5"></rect>
			<g data-drops>
				{Array.from({ length: 10 }, () => <circle class="pru__drop" r="1.7" cx="-9" cy="-9" />)}
			</g>
			<text class="t-small" x="52" y="122" text-anchor="end">семена</text>
			<line class="ln" x1="54" y1="118" x2="100" y2="110"></line>
			<text class="t-small" x="221" y="144" text-anchor="middle">масло</text>
			<text class="t-small" x="52" y="172" text-anchor="end">домкрат</text>
			<text class="t-small pru__note" x="120" y="214" text-anchor="middle">200 кН на поршень диаметром 10 см —</text>
			<text class="t-small pru__note" x="120" y="228" text-anchor="middle">давление 25 МПа выжимает масло</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Схемы не в масштабе; силы и давления в подписях — настоящие. Качки домкрата, подъём стрелы и отжим масла показаны быстрее или медленнее, чем в жизни.
	</figcaption>
</figure>

<style is:global>
	.g7__svg text.pru__note {
		font-size: 10.5px;
	}
	.pru__road,
	.pru__soil {
		fill: var(--g7-ground);
	}
	.pru__dash {
		fill: var(--g7-line);
	}
	.pru__tyre,
	.pru__tyretop {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	:root[data-theme='light'] .pru__tyre,
	:root[data-theme='light'] .pru__tyretop {
		fill: var(--sl-color-gray-2);
	}
	.pru__rim {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__hub {
		fill: var(--g7-steel-dark);
	}
	.pru__tread {
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.pru__car {
		fill: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pru__glass {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__sill {
		fill: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-5));
	}
	.pru__seam {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-5));
		stroke-width: 1.2;
	}
	.pru__handle {
		fill: var(--g7-steel);
	}
	.pru__steel {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__jack,
	.pru__jackpump {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1.1;
	}
	.pru__ram {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__rod {
		stroke: var(--g7-steel);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.pru__lever {
		stroke: var(--g7-ink);
		stroke-width: 3.4;
		stroke-linecap: round;
	}
	.pru__pin {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pru__sleeve,
	.pru__leg {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.pru__skin {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pru__knuckle {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.pru__sole {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.pru__lace {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.pru__shoe {
		fill: var(--sl-color-gray-4);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.pru__body {
		fill: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pru__roof {
		fill: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-4));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.pru__line {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-4));
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.pru__line--p {
		stroke: var(--g7-gold);
		stroke-width: 3.4;
		opacity: 0;
	}
	.pru__caliper {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__pad {
		fill: var(--g7-ink);
	}
	.pru__master {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.1;
	}
	.pru__res {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__mpiston {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.pru__pedalpad {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__earth,
	.pru__dirt {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
	}
	.pru__track {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.pru__roller {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__machine {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pru__window {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pru__boom,
	.pru__arm {
		stroke: color-mix(in oklab, var(--ig-v) 80%, var(--sl-color-gray-3));
		stroke-width: 10;
		stroke-linecap: round;
	}
	.pru__arm {
		stroke-width: 8;
	}
	.pru__barrel {
		stroke: var(--g7-steel-dark);
		stroke-width: 9;
		stroke-linecap: round;
	}
	.pru__rodline {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.pru__bucket {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.pru__frame {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.1;
	}
	.pru__cage {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-dasharray: 5 3;
	}
	.pru__cagering {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.pru__seed {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	:root[data-theme='light'] .pru__seed {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-5);
	}
	.pru__tray {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.pru__oilfill,
	.pru__oil {
		fill: color-mix(in oklab, var(--ig-v) 70%, transparent);
	}
	.pru__stream {
		stroke: color-mix(in oklab, var(--ig-v) 80%, transparent);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.pru__drop {
		fill: var(--g7-gold);
	}
	.pru__jar {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 20%, transparent);
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const D = Math.PI / 180;
	const f = (v: number) => v.toFixed(1);
	const pl = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'ход' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'хода' : 'ходов');

	// jack: 15 strokes of 0,6 с, 4,8 мм each at 2 px/см; hold, then down through the release valve
	const J_N = 15;
	const J_T = 0.6;
	const J_STEP = 0.96; // px of lift per stroke
	const J_HOLD = 1.4;
	const J_DOWN = 2.2;
	const J_CYCLE = J_N * J_T + J_HOLD + J_DOWN + 0.6;
	const J_DROOP = 10; // px: 5 см of suspension before the wheel leaves the ground
	// brakes
	const B_CYCLE = 7;
	const V0 = 70; // px/s of the road
	// excavator
	const X_CYCLE = 8;
	const P0 = [104, 146];
	const BASE = [114, 168];
	// oil press
	const O_CYCLE = 10;
	const H0 = 82; // the seed layer, px
	const H1 = 46;

	for (const root of document.querySelectorAll<HTMLElement>('[data-pressuses]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const jack = q('[data-p="jack"]');
		const brake = q('[data-p="brake"]');
		const dig = q('[data-p="dig"]');
		const oil = q('[data-p="oil"]');
		const treads = [...brake.querySelectorAll<SVGLineElement>('[data-tread]')];
		const treadY = treads.map((l) => l.dataset.tread!.split(' ').map(Number));
		const dashes = [...brake.querySelectorAll<SVGRectElement>('.pru__dash')];
		const pads = [...brake.querySelectorAll<SVGRectElement>('[data-pad]')];
		const padX = pads.map((p) => Number(p.getAttribute('x')));
		const seeds = [...oil.querySelectorAll<SVGEllipseElement>('.pru__seed')];
		const SEEDS = seeds.map((_, i) => [((i * 37) % 46) / 46, ((i * 17) % 46) / 46 + 0.01, (i * 53) % 180]);
		const drops = [...oil.querySelectorAll<SVGCircleElement>('.pru__drop')];
		let t = 0;
		let road = 0;

		const drawJack = () => {
			const tc = t % J_CYCLE;
			let lift: number;
			let alpha: number; // the lever's angle above horizontal, degrees
			let strokes: number;
			if (tc < J_N * J_T) {
				const k = Math.floor(tc / J_T);
				const u = (tc % J_T) / J_T;
				// first half: the hand pushes down (30° → 0°), the ram rises; second half: the lever goes back up
				const down = u < 0.5 ? ease(u / 0.5) : 1;
				alpha = u < 0.5 ? 30 * (1 - down) : 30 * ease((u - 0.5) / 0.5);
				lift = (k + down) * J_STEP;
				strokes = k + 1;
			} else if (tc < J_N * J_T + J_HOLD) {
				alpha = 30;
				lift = J_N * J_STEP;
				strokes = J_N;
			} else {
				alpha = 30;
				const u = Math.min(1, (tc - J_N * J_T - J_HOLD) / J_DOWN);
				lift = J_N * J_STEP * (1 - ease(u));
				strokes = u < 1 ? J_N : 0;
			}
			const L = lift * 2; // the lift in the drawing: 2 px/см, 0,96 px per stroke is 4,8 мм
			q('[data-car]').setAttribute('transform', `translate(0 ${f(-L)})`);
			q('[data-wheel]').setAttribute('transform', `translate(0 ${f(-Math.max(0, L - J_DROOP))})`);
			const ram = jack.querySelector('[data-ram]')!;
			ram.setAttribute('y', f(158 - L));
			ram.setAttribute('height', f(L + 6));
			jack.querySelector('[data-saddle]')!.setAttribute('y', f(154 - L));
			const a = alpha * D;
			const py = 158 - 9 * Math.sin(a);
			jack.querySelector('[data-plunger]')!.setAttribute('y1', f(py));
			jack.querySelector('[data-lever]')!.setAttribute('transform', `translate(86 158) rotate(${f(alpha)})`);
			jack.querySelector('[data-hand]')!.setAttribute('transform', `translate(${f(86 - 72 * Math.cos(a))} ${f(158 - 72 * Math.sin(a))})`);
			jack.querySelector('[data-strokes]')!.textContent = strokes ? `${strokes} ${pl(strokes)}` : '';
		};

		const drawBrake = (dt: number) => {
			const tc = t % B_CYCLE;
			let u = 0; // the pedal, 0…1
			let v = V0;
			if (tc < 2) v = V0;
			else if (tc < 2.4) {
				u = ease((tc - 2) / 0.4);
				v = V0;
			} else if (tc < 4.4) {
				u = 1;
				v = V0 * (1 - (tc - 2.4) / 2);
			} else if (tc < 5.4) {
				u = 1;
				v = 0;
			} else if (tc < 5.8) {
				u = 1 - ease((tc - 5.4) / 0.4);
				v = 0;
			} else v = V0 * ((tc - 5.8) / 1.2);
			road = (road + v * dt) % 26;
			dashes.forEach((d, i) => d.setAttribute('y', f(14 + i * 26 + road)));
			const tr = (road * 6) / 26;
			// the tread lines of the tyres run backward as the wheels roll
			treads.forEach((l, i) => {
				const [wy, d] = treadY[i];
				const y = wy + 1 + ((((d - tr) % 36) + 36) % 36);
				l.setAttribute('y1', f(y));
				l.setAttribute('y2', f(y));
				l.style.opacity = y < wy + 31 ? '1' : '0';
			});
			const ang = -12 * u;
			brake.querySelector('[data-pedal]')!.setAttribute('transform', `rotate(${f(ang)} 54 48)`);
			// the push rod: from the pedal arm, 30 px below the pivot, to the piston
			const a = Math.atan2(70, -7) + ang * D;
			const rx = 54 + 30 * Math.cos(a);
			const mx = 70 + 5 * u;
			brake.querySelector('[data-mpiston]')!.setAttribute('x', f(mx));
			const rod = brake.querySelector('[data-pushrod]')!;
			rod.setAttribute('x1', f(rx));
			rod.setAttribute('x2', f(mx));
			(brake.querySelector('[data-pressure]') as SVGElement).style.opacity = f(u);
			pads.forEach((p, i) => p.setAttribute('x', f(padX[i] + (i % 2 ? 1.5 : -1.5) * u)));
		};

		const drawDig = () => {
			const tc = t % X_CYCLE;
			const u = tc < 3 ? ease(tc / 3) : tc < 4 ? 1 : tc < 7 ? 1 - ease((tc - 4) / 3) : 0;
			const th = (12 + 43 * u) * D;
			const P1 = [P0[0] + 96 * Math.cos(th), P0[1] - 96 * Math.sin(th)];
			const armA = th - 105 * D + 20 * D * u;
			const P2 = [P1[0] + 58 * Math.cos(armA), P1[1] - 58 * Math.sin(armA)];
			const Q = [P0[0] + 56 * Math.cos(th), P0[1] - 56 * Math.sin(th)];
			const dx = Q[0] - BASE[0];
			const dy = Q[1] - BASE[1];
			const l = Math.hypot(dx, dy);
			const e = [dx / l, dy / l];
			const set = (sel: string, x1: number, y1: number, x2: number, y2: number) => {
				const n = dig.querySelector(sel)!;
				n.setAttribute('x1', f(x1));
				n.setAttribute('y1', f(y1));
				n.setAttribute('x2', f(x2));
				n.setAttribute('y2', f(y2));
			};
			set('[data-barrel]', BASE[0], BASE[1], BASE[0] + 40 * e[0], BASE[1] + 40 * e[1]);
			set('[data-crod]', BASE[0] + 36 * e[0], BASE[1] + 36 * e[1], Q[0], Q[1]);
			set('[data-boom]', P0[0], P0[1], P1[0], P1[1]);
			set('[data-arm]', P1[0], P1[1], P2[0], P2[1]);
			dig.querySelector('[data-pin1]')!.setAttribute('cx', f(P1[0]));
			dig.querySelector('[data-pin1]')!.setAttribute('cy', f(P1[1]));
			const bucketTilt = -40 * u;
			dig.querySelector('[data-bucket]')!.setAttribute('transform', `translate(${f(P2[0])} ${f(P2[1])}) rotate(${f(bucketTilt)})`);
		};

		const drawOil = () => {
			const tc = t % O_CYCLE;
			const u = tc < 7 ? ease(tc / 7) : tc < 8.5 ? 1 : 1 - ease((tc - 8.5) / 1.5);
			const h = H0 - (H0 - H1) * u;
			const yPl = 56 + h; // the top of the piston
			oil.querySelector('[data-plate]')!.setAttribute('y', f(yPl));
			const ram = oil.querySelector('[data-pram]')!;
			ram.setAttribute('y', f(yPl + 8));
			ram.setAttribute('height', f(Math.max(0, 150 - yPl - 8)));
			seeds.forEach((s, i) => {
				const [a, b, r] = SEEDS[i];
				s.setAttribute('cx', f(98 + 44 * a));
				s.setAttribute('cy', f(58 + (h - 4) * b));
				s.setAttribute('ry', f(1.8 * (0.55 + (0.45 * h) / H0)));
				s.setAttribute('transform', `rotate(${r} ${f(98 + 44 * a)} ${f(58 + (h - 4) * b)})`);
			});
			// oil: it flows once the seeds are squeezed by a fifth; the jar fills while the piston rises
			const flow = tc < 8.5 ? Math.max(0, Math.min(1, (u - 0.2) / 0.8)) : 1;
			const running = tc > 1.5 && tc < 8.5;
			const level = 22 * (tc < 8.5 ? flow : 1 - ease((tc - 8.5) / 1.5));
			const jar = oil.querySelector('[data-jar]')!;
			jar.setAttribute('y', f(188 - level));
			jar.setAttribute('height', f(level));
			(oil.querySelector('[data-stream]') as SVGElement).style.opacity = running && flow > 0 ? '1' : '0';
			drops.forEach((d, i) => {
				const side = i % 2 ? 148 : 92;
				const ph = (t * 0.9 + i * 0.37) % 1;
				const y0 = 64 + ((i * 13) % 50);
				d.setAttribute('cx', f(side));
				d.setAttribute('cy', f(y0 + (146 - y0) * ph));
				d.style.opacity = running && flow > 0 && y0 < yPl ? f(1 - 0.4 * ph) : '0';
			});
			const lv = tc < 7 ? 12 * Math.sin(t * 9) : 0;
			const jl = oil.querySelector('[data-jlever]')!;
			jl.setAttribute('x2', f(138 + 24 * Math.cos((-20 + lv) * D)));
			jl.setAttribute('y2', f(158 + 24 * Math.sin((-20 + lv) * D)));
		};

		loop(root, (dt) => {
			t += dt;
			drawJack();
			drawBrake(dt);
			drawDig();
			drawOil();
			return true;
		});
		drawJack();
		drawBrake(0);
		drawDig();
		drawOil();
	}
</script>
