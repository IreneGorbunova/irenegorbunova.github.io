---
/**
 * Convection in a room (cross-section 5 m × 2,8 m). Dots are small portions of air, coloured by temperature.
 * Radiator below the window: warm air rises, a circulation cell forms (a divergence-free stream function),
 * the whole room is mixed. Radiator under the ceiling: warm air is lighter and stays at the top —
 * the air is stratified, it only drifts up or down by buoyancy and mixes slowly. A qualitative model:
 * the air motion is sped up, the thermometers show the average colour, not exact numbers.
 */
import VeStyles from './VeStyles.astro';
---

<VeStyles />
<figure class="ve-box cr not-content" data-cr>
	<div class="ve-row" role="group" aria-label="Где висит батарея" style="margin-top: 0">
		<button type="button" class="ve-chip" data-mode="low" aria-pressed="true">Батарея под окном</button>
		<button type="button" class="ve-chip" data-mode="high" aria-pressed="false">Батарея под потолком</button>
	</div>
	<div class="cr__wrap">
		<canvas class="ve-canvas" width="720" height="400" aria-label="Разрез комнаты: окно, батарея и потоки воздуха"></canvas>
		<div class="cr__therms" aria-hidden="true">
			<div class="cr__th" data-th="2"><span class="cr__tube"><span class="cr__fill"></span></span>под потолком</div>
			<div class="cr__th" data-th="1"><span class="cr__tube"><span class="cr__fill"></span></span>на уровне головы</div>
			<div class="cr__th" data-th="0"><span class="cr__tube"><span class="cr__fill"></span></span>у пола</div>
		</div>
	</div>
	<p class="ve-live" aria-live="polite" data-live></p>
	<figcaption class="ve-cap">
		Точки — маленькие порции воздуха, цвет показывает их температуру: синие — холодные, красные — тёплые, жёлтые — горячие. Справа окно, за ним мороз. Слева — три термометра: у пола, на уровне
		головы и под потолком. Модель упрощённая: она показывает, куда движется воздух, а движение ускорено.
	</figcaption>
</figure>

<style is:global>
	.cr__wrap {
		position: relative;
		margin-top: 0.75rem;
	}
	.cr__therms {
		position: absolute;
		left: 0.6rem;
		top: 0.4rem;
		bottom: 0.4rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		pointer-events: none;
	}
	.cr__th {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		text-shadow: 0 0 4px var(--sl-color-bg);
	}
	.cr__tube {
		position: relative;
		width: 0.55rem;
		height: 2.6rem;
		border-radius: 999px;
		border: 1.5px solid var(--sl-color-gray-3);
		background: var(--sl-color-bg);
		overflow: hidden;
	}
	.cr__fill {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 30%;
		border-radius: 999px;
		transition: height 0.4s linear;
	}
	@media (max-width: 40rem) {
		.cr__th {
			font-size: 0.65rem;
		}
		.cr__tube {
			height: 1.6rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cr__fill {
			transition: none;
		}
	}
</style>

<script>
	import { heatScale, onTheme, loop, reduceMotion, rng, css, varRGB } from './heat';

	const W = 720;
	const H = 400;
	const PXM = 144; // px per metre: the room is 5 m × 2,78 m
	const N = 320;
	const A = 125 * (W / (2 * Math.PI)); // stream-function amplitude: up-flow ≈ 125 px/s at the window wall
	const WIN = { y0: 0.9 * PXM, y1: 2.0 * PXM }; // window, from the floor
	const RAD = { low: { y0: 0.12 * PXM, y1: 0.72 * PXM }, high: { y0: 2.12 * PXM, y1: 2.68 * PXM } };
	const RX0 = W - 0.26 * PXM;
	const RX1 = W - 0.12 * PXM;
	const T_RAD = 55;
	const T_GLASS = 5;
	const GX = 12;
	const GY = 7;

	for (const root of document.querySelectorAll<HTMLElement>('[data-cr]')) {
		const canvas = root.querySelector('canvas')!;
		const ctx = canvas.getContext('2d')!;
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const therms = [0, 1, 2].map((k) => root.querySelector<HTMLElement>(`[data-th="${k}"] .cr__fill`)!);
		const dpr = Math.min(2, window.devicePixelRatio || 1);
		canvas.width = W * dpr;
		canvas.height = H * dpr;
		ctx.scale(dpr, dpr);
		let heat = heatScale(root);
		let col = {
			bg: getComputedStyle(root).getPropertyValue('--sl-color-bg'),
			wall: getComputedStyle(root).getPropertyValue('--sl-color-gray-3'),
			text: getComputedStyle(root).getPropertyValue('--sl-color-gray-2'),
			glass: css(varRGB(root, '--ig-vx'), 0.25),
		};
		const tColor = (t: number) => heat((t - T_GLASS) / (T_RAD - T_GLASS));

		const r = rng(3);
		let mode: 'low' | 'high' = 'low';
		let ps = [] as { x: number; y: number; t: number }[]; // y measured up from the floor
		const fresh = () => {
			ps = Array.from({ length: N }, () => ({ x: 4 + r() * (W - 8), y: 4 + r() * (H - 8), t: 14 }));
		};
		fresh();

		const flow = (x: number, y: number) => {
			if (mode === 'high') return [0, 0];
			const xi = (x / W) ** 2;
			const s = Math.PI * xi;
			const e = (Math.PI * y) / H;
			// u = ∂ψ/∂y, v = −∂ψ/∂x (y up): air rises at the window wall and sinks at the far wall
			return [((A * Math.PI) / H) * Math.sin(s) * Math.cos(e), A * Math.PI * Math.cos(s) * Math.sin(e) * ((-2 * x) / (W * W))];
		};

		const cellT = new Float64Array(GX * GY);
		const cellN = new Float64Array(GX * GY);
		const cell = (p: { x: number; y: number }) =>
			Math.min(GX - 1, Math.floor((p.x / W) * GX)) + GX * Math.min(GY - 1, Math.floor((p.y / H) * GY));

		const update = (dt: number) => {
			const rad = RAD[mode];
			cellT.fill(0);
			cellN.fill(0);
			for (const p of ps) {
				const c = cell(p);
				cellT[c] += p.t;
				cellN[c] += 1;
			}
			for (const p of ps) {
				const [u, v] = flow(p.x, p.y);
				// buoyancy relative to the surrounding air + small turbulent wandering
				const c = cell(p);
				const around = cellN[c] ? cellT[c] / cellN[c] : p.t;
				const buoy = mode === 'high' ? 6 * (p.t - around) : 0;
				const jig = mode === 'high' ? 14 : 22;
				p.x += u * dt + (r() - 0.5) * jig * Math.sqrt(dt) * 2;
				p.y += (v + buoy) * dt + (r() - 0.5) * jig * Math.sqrt(dt) * 2;
				p.x = Math.min(W - 3, Math.max(3, p.x));
				p.y = Math.min(H - 3, Math.max(3, p.y));
				// heat exchange
				const nearRad = p.x > RX0 - 26 && p.y > rad.y0 - 12 && p.y < rad.y1 + 20;
				const nearGlass = p.x > W - 10 && p.y > WIN.y0 && p.y < WIN.y1;
				if (nearRad) p.t += (T_RAD - p.t) * Math.min(1, dt / 0.25);
				else if (nearGlass) p.t += (T_GLASS - p.t) * Math.min(1, dt / 2.5);
				p.t += (around - p.t) * Math.min(1, dt / 10);
			}
		};

		const draw = () => {
			ctx.globalAlpha = reduceMotion() ? 1 : 0.35;
			ctx.fillStyle = col.bg;
			ctx.fillRect(0, 0, W, H);
			ctx.globalAlpha = 1;
			// window
			ctx.fillStyle = col.glass;
			ctx.fillRect(W - 8, H - WIN.y1, 8, WIN.y1 - WIN.y0);
			ctx.fillStyle = col.text;
			ctx.font = '15px system-ui, sans-serif';
			ctx.textAlign = 'right';
			ctx.fillText('окно', W - 14, H - WIN.y1 + 18);
			// radiator
			const rad = RAD[mode];
			ctx.strokeStyle = col.wall;
			ctx.lineWidth = 2;
			for (let x = RX0; x <= RX1; x += 5) {
				ctx.beginPath();
				ctx.moveTo(x, H - rad.y1);
				ctx.lineTo(x, H - rad.y0);
				ctx.stroke();
			}
			ctx.strokeRect(RX0 - 2, H - rad.y1, RX1 - RX0 + 4, rad.y1 - rad.y0);
			for (const p of ps) {
				ctx.fillStyle = css(tColor(p.t));
				ctx.beginPath();
				ctx.arc(p.x, H - p.y, 3.4, 0, 6.2832);
				ctx.fill();
			}
			ctx.strokeStyle = col.wall;
			ctx.lineWidth = 3;
			ctx.strokeRect(1.5, 1.5, W - 3, H - 3);
			// thermometers: bands near the floor, at the head (1,4–1,8 m) and under the ceiling
			const bands = [
				[0, 0.4],
				[1.4, 1.8],
				[2.35, 2.78],
			];
			bands.forEach(([a, b], k) => {
				let s = 0;
				let n = 0;
				for (const p of ps)
					if (p.y >= a * PXM && p.y < b * PXM && p.x < W - 0.4 * PXM) {
						s += p.t;
						n += 1;
					}
				const t = n ? s / n : 14;
				const f = Math.min(1, Math.max(0.05, (t - T_GLASS) / (T_RAD - T_GLASS)));
				therms[k].style.height = `${(f * 100).toFixed(0)}%`;
				therms[k].style.background = css(tColor(t));
			});
		};

		let shown = 0;
		const wake = loop(root, (dt) => {
			// real time in both modes (a fixed step per frame ran 8–20 times too fast, depending on the screen's refresh rate)
			for (let k = 0; k < 2; k++) update(dt / 2);
			shown += dt;
			draw();
			return true;
		});

		const say = () => {
			live.textContent =
				mode === 'low'
					? 'Тёплый воздух от батареи поднимается вдоль окна, растекается под потолком, остывает и опускается у дальней стены. Воздух перемешивается, и тепло доходит до всей комнаты.'
					: 'Тёплый воздух легче холодного, поэтому он так и остаётся под потолком. Потоков нет, и у пола воздух остаётся холодным — ногам зябко.';
		};
		for (const chip of root.querySelectorAll<HTMLButtonElement>('[data-mode]')) {
			chip.addEventListener('click', () => {
				mode = chip.dataset.mode as 'low' | 'high';
				for (const c of root.querySelectorAll('[data-mode]')) c.setAttribute('aria-pressed', String(c === chip));
				fresh();
				say();
				wake();
			});
		}
		onTheme(() => {
			heat = heatScale(root);
			col = {
				bg: getComputedStyle(root).getPropertyValue('--sl-color-bg'),
				wall: getComputedStyle(root).getPropertyValue('--sl-color-gray-3'),
				text: getComputedStyle(root).getPropertyValue('--sl-color-gray-2'),
				glass: css(varRGB(root, '--ig-vx'), 0.25),
			};
			draw();
		});
		say();
		draw();
	}
</script>
