---
/**
 * Air fire piston (воздушное огниво). The air under the piston is compressed; its temperature follows
 * dT = −(γ − 1)·T·dV/V − (T − T₀)·dt/τ, T in kelvins, γ = 1,4 for air: the first term is the work done
 * on the gas, the second — heat transfer to the cold walls (τ = 0,5 s, an estimate for a narrow glass tube).
 * Cotton wool moistened with ether flashes when the air reaches 160 °C (autoignition of ether vapour).
 * The graph shows the temperature against the compression ratio V₀/V for the last two pushes.
 */
import VeStyles from './VeStyles.astro';

const CX = 175; // axis of the cylinder
const BORE = 50;
const YB = 350; // bottom (inside)
const YTOP = 196; // top edge of the tube
const GX0 = 380;
const GX1 = 700;
const GY0 = 330;
const GY1 = 50;
const gx = (r: number) => GX0 + ((r - 1) / 9) * (GX1 - GX0);
const gy = (t: number) => GY0 - (t / 500) * (GY0 - GY1);
---

<VeStyles />
<figure class="ve-box fp not-content" data-fp>
	<svg class="ve-svg" viewBox="0 0 720 384" role="img" aria-label="Воздушное огниво: толстостенный стеклянный цилиндр с поршнем, на дне — вата, смоченная эфиром">
		<defs>
			<radialGradient id="fp-flash" cx="0.5" cy="0.85" r="0.8">
				<stop offset="0" class="fp__fl1"></stop>
				<stop offset="0.6" class="fp__fl2"></stop>
				<stop offset="1" class="fp__fl3"></stop>
			</radialGradient>
		</defs>
		<!-- air -->
		<rect class="fp__air" x={CX - BORE / 2} width={BORE} data-air></rect>
		<rect class="fp__flash" x={CX - BORE / 2} width={BORE} fill="url(#fp-flash)" data-flash></rect>
		<!-- cotton -->
		<path class="fp__cotton" data-cotton d={`M ${CX - 18} ${YB} q 3 -9 10 -8 q 5 -6 12 -1 q 7 -3 10 4 q 4 3 2 5 z`}></path>
		<!-- glass tube -->
		<rect class="fp__glass" x={CX - BORE / 2 - 12} y={YTOP} width={BORE + 24} height={YB - YTOP + 14} rx="6"></rect>
		<rect class="fp__bore" x={CX - BORE / 2} y={YTOP} width={BORE} height={YB - YTOP} fill="none"></rect>
		<rect class="fp__shine" x={CX - BORE / 2 - 8} y={YTOP + 10} width="4" height={YB - YTOP - 20} rx="2"></rect>
		<rect class="fp__base" x={CX - 70} y={YB + 14} width="140" height="16" rx="4"></rect>
		<!-- piston, rod and handle -->
		<g class="fp__piston" data-piston>
			<rect class="fp__rod" x={CX - 4} y="-160" width="8" height="160"></rect>
			<rect class="fp__handle" x={CX - 45} y="-178" width="90" height="20" rx="10"></rect>
			<rect class="fp__head" x={CX - BORE / 2 + 1} y="0" width={BORE - 2} height="16" rx="2"></rect>
			<line class="fp__ring" x1={CX - BORE / 2 + 2} y1="5" x2={CX + BORE / 2 - 2} y2="5"></line>
			<line class="fp__ring" x1={CX - BORE / 2 + 2} y1="11" x2={CX + BORE / 2 - 2} y2="11"></line>
			<rect class="fp__grab" x={CX - 60} y="-190" width="120" height="210" fill="transparent"></rect>
		</g>
		<text class="fp__t" x={CX + BORE / 2 + 22} text-anchor="start" data-t-label></text>

		<!-- graph -->
		<g class="fp__grid">
			{[100, 200, 300, 400, 500].map((t) => <line x1={GX0} y1={gy(t)} x2={GX1} y2={gy(t)} />)}
			{[4, 7, 10].map((r) => <line x1={gx(r)} y1={GY0} x2={gx(r)} y2={GY1} />)}
		</g>
		<line class="fp__axis" x1={GX0} y1={GY0} x2={GX1 + 6} y2={GY0}></line>
		<line class="fp__axis" x1={GX0} y1={GY0} x2={GX0} y2={GY1 - 8}></line>
		<line class="fp__ign" x1={GX0} y1={gy(160)} x2={GX1} y2={gy(160)}></line>
		<text class="fp__ign-label" x={GX1} y={gy(160) - 8} text-anchor="end">вспышка паров эфира, 160 °C</text>
		<g class="fp__ticks">
			{[0, 100, 200, 300, 400, 500].map((t) => <text x={GX0 - 8} y={gy(t) + 5} text-anchor="end">{t}</text>)}
			{[1, 4, 7, 10].map((r) => <text x={gx(r)} y={GY0 + 22} text-anchor="middle">{r}</text>)}
			<text x={GX0 - 8} y={GY1 - 18} text-anchor="end"><tspan class="ve-math">t</tspan>, °C</text>
			<text x={GX1} y={GY0 + 46} text-anchor="end">во сколько раз уменьшился объём</text>
		</g>
		<polyline class="fp__trace fp__trace--old" data-trace-old></polyline>
		<polyline class="fp__trace" data-trace></polyline>
		<circle class="fp__dot" r="5" data-dot></circle>
	</svg>
	<div class="ve-row">
		<button type="button" class="ve-btn ve-btn--primary" data-fast>Резко вдвинуть</button>
		<button type="button" class="ve-btn" data-slow>Медленно вдвинуть</button>
		<button type="button" class="ve-btn" data-pull>Вытянуть поршень</button>
	</div>
	<p class="ve-live" aria-live="polite" data-live></p>
	<figcaption class="ve-cap">
		Поршень можно двигать и рукой — тяните за ручку. «Резко» — поршень проходит весь путь за 0,1 с, «медленно» — за 10 с. Объём воздуха уменьшается в 10 раз. Цвет воздуха показывает его
		температуру. Пока поршень движется, воздух через стенки отдаёт тепло стеклу; модель считает, что без движения разница температур воздуха и стенок уменьшается вдвое примерно за треть секунды.
	</figcaption>
</figure>

<style is:global>
	.fp__glass {
		fill: color-mix(in srgb, var(--ig-vx) 10%, transparent);
		stroke: color-mix(in srgb, var(--ig-vx) 55%, var(--sl-color-gray-3));
		stroke-width: 2;
	}
	.fp__bore {
		stroke: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-4));
		stroke-width: 1;
	}
	.fp__shine {
		fill: white;
		opacity: 0.25;
	}
	.fp__base {
		fill: var(--sl-color-gray-4);
	}
	.fp__air {
		opacity: 0.55;
	}
	.fp__flash {
		opacity: 0;
		pointer-events: none;
	}
	.fp__fl1 {
		stop-color: color-mix(in srgb, var(--ig-v) 40%, white);
	}
	.fp__fl2 {
		stop-color: var(--ig-v);
		stop-opacity: 0.9;
	}
	.fp__fl3 {
		stop-color: var(--ig-vy);
		stop-opacity: 0.4;
	}
	.fp__cotton {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-3);
		transition: fill 0.6s;
	}
	.fp.is-burnt .fp__cotton {
		fill: var(--sl-color-gray-5);
	}
	.fp__rod,
	.fp__head {
		fill: var(--sl-color-gray-3);
	}
	.fp__ring {
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}
	.fp__handle {
		fill: var(--sl-color-accent);
	}
	.fp__piston {
		cursor: grab;
	}
	.fp__t {
		font-size: 20px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.fp__grid line {
		stroke: var(--sl-color-gray-6);
	}
	.fp__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.fp__ign {
		stroke: var(--ig-vy);
		stroke-width: 1.5;
		stroke-dasharray: 6 5;
	}
	.fp__ign-label {
		font-size: 14px;
		fill: var(--ig-vy);
	}
	.fp__ticks text {
		font-size: 15px;
		fill: var(--sl-color-gray-2);
	}
	.fp__trace {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.fp__trace--old {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-dasharray: 6 5;
	}
	.fp__dot {
		fill: var(--sl-color-accent);
	}
	@media (max-width: 40rem) {
		.fp__t {
			font-size: 26px;
		}
		.fp__ticks text,
		.fp__ign-label {
			font-size: 21px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.fp__cotton {
			transition: none;
		}
	}
</style>

<script>
	import { heatScale, onTheme, loop, reduceMotion, css, svgPoint } from './heat';

	const CX = 175;
	const BORE = 50;
	const YB = 350;
	const VMAX = 150; // px of air column when pulled out
	const VMIN = 15; // ×10 compression
	const T0 = 293.15;
	const GAMMA = 1.4;
	const TAU = 0.5; // s
	const T_IGN = 160; // °C
	const GX0 = 380;
	const GX1 = 700;
	const GY0 = 330;
	const GY1 = 50;
	const gx = (r: number) => GX0 + ((r - 1) / 9) * (GX1 - GX0);
	const gy = (t: number) => GY0 - (Math.min(Math.max(t, 0), 520) / 500) * (GY0 - GY1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-fp]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = $<SVGSVGElement>('svg');
		const air = $<SVGRectElement>('[data-air]');
		const flash = $<SVGRectElement>('[data-flash]');
		const piston = $<SVGGElement>('[data-piston]');
		const tLabel = $<SVGTextElement>('[data-t-label]');
		const trace = $<SVGPolylineElement>('[data-trace]');
		const traceOld = $<SVGPolylineElement>('[data-trace-old]');
		const dot = $<SVGCircleElement>('[data-dot]');
		const live = $<HTMLElement>('[data-live]');
		let heat = heatScale(root);

		let V = VMAX;
		let T = T0;
		let target: number | null = null; // volume the piston is driven to
		let rate = 0; // px of volume per second for driven motion
		let dragV: number | null = null;
		let burnt = false;
		let flashT = 0;
		let pts: string[] = [];
		let peak = T0;

		const tC = () => T - 273.15;
		const draw = () => {
			const yP = YB - V;
			piston.style.transform = `translateY(${yP - 16}px)`;
			air.setAttribute('y', String(yP));
			air.setAttribute('height', String(V));
			air.style.fill = css(heat((tC() - 20) / 480));
			flash.setAttribute('y', String(yP));
			flash.setAttribute('height', String(V));
			flash.style.opacity = String(Math.max(0, Math.min(1, flashT / 0.25)));
			tLabel.setAttribute('y', String(Math.max(210, yP + V / 2 + 7)));
			tLabel.textContent = `${Math.round(tC())} °C`;
			const r = VMAX / V;
			dot.setAttribute('cx', gx(r).toFixed(1));
			dot.setAttribute('cy', gy(tC()).toFixed(1));
			trace.setAttribute('points', pts.join(' '));
		};

		let recording = false;
		const record = () => {
			if (!recording) return;
			const p = `${gx(VMAX / V).toFixed(1)},${gy(tC()).toFixed(1)}`;
			if (pts[pts.length - 1] !== p) pts.push(p);
		};

		const physics = (dt: number) => {
			const n = Math.max(1, Math.ceil(dt / 0.002));
			const h = dt / n;
			for (let s = 0; s < n; s++) {
				let V1 = V;
				if (dragV !== null) V1 = V + (dragV - V) * Math.min(1, h / 0.02);
				else if (target !== null) {
					const d = target - V;
					V1 = Math.abs(d) <= rate * h ? target : V + Math.sign(d) * rate * h;
					if (V1 === target) target = null;
				}
				T += -(GAMMA - 1) * T * ((V1 - V) / V) - ((T - T0) * h) / TAU;
				V = V1;
				peak = Math.max(peak, T);
				if (!burnt && tC() >= T_IGN) {
					burnt = true;
					flashT = reduceMotion() ? 0.25 : 0.5;
					root.classList.add('is-burnt');
					live.textContent = `Вспышка! Воздух нагрелся до ${T_IGN} °C, и пары эфира загорелись. Мы совершили работу — сжали воздух — и его внутренняя энергия увеличилась.`;
				}
			}
			record();
		};

		const step = (dt: number) => {
			physics(dt);
			if (flashT > 0) flashT = Math.max(0, flashT - dt);
			draw();
			const moving = target !== null || dragV !== null || flashT > 0;
			const settling = Math.abs(T - T0) > 0.3;
			if (!moving && !settling && pts.length) {
				if (!burnt && peak - 273.15 > 25)
					live.textContent = `Пары эфира не вспыхнули: самая высокая температура воздуха была ${Math.round(peak - 273.15)} °C. При медленном сжатии воздух успевает отдать тепло стенкам.`;
			}
			return moving || settling;
		};
		const wake = loop(root, step);

		const newStroke = () => {
			if (pts.length > 1) traceOld.setAttribute('points', pts.join(' '));
			pts = [];
			peak = T;
		};
		const push = (seconds: number) => {
			if (V <= VMIN + 0.5) return;
			newStroke();
			recording = true;
			target = VMIN;
			rate = (VMAX - VMIN) / seconds;
			live.textContent = seconds < 1 ? 'Резко вдвигаем поршень…' : 'Медленно вдвигаем поршень…';
			wake();
		};
		$('[data-fast]').addEventListener('click', () => push(0.1));
		$('[data-slow]').addEventListener('click', () => push(10));
		$('[data-pull]').addEventListener('click', () => {
			target = VMAX;
			recording = false;
			rate = (VMAX - VMIN) / 1;
			burnt = false;
			peak = T0;
			root.classList.remove('is-burnt');
			live.textContent = 'Поршень вытянут, на дно положен новый кусочек ваты с эфиром.';
			wake();
		});

		// dragging the handle
		let dy = 0;
		piston.addEventListener('pointerdown', (e) => {
			e.preventDefault();
			svg.setPointerCapture(e.pointerId);
			target = null;
			if (V >= VMAX - 1 || pts.length === 0) newStroke();
			recording = true;
			dy = svgPoint(svg, e).y - (YB - V);
			dragV = V;
			wake();
		});
		svg.addEventListener('pointermove', (e) => {
			if (dragV === null) return;
			const y = svgPoint(svg, e).y - dy;
			dragV = Math.min(VMAX, Math.max(VMIN, YB - y));
		});
		const end = () => {
			dragV = null;
		};
		svg.addEventListener('pointerup', end);
		svg.addEventListener('pointercancel', end);

		onTheme(() => {
			heat = heatScale(root);
			draw();
		});
		live.textContent = 'Нажмите «Резко вдвинуть» или «Медленно вдвинуть» — или двигайте ручку поршня сами.';
		draw();
	}
</script>
