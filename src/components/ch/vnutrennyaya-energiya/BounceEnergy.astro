---
/**
 * A ball falls on a heavy plate and bounces. Free fall with g = 9,8 m/s², air resistance neglected;
 * an impact keeps the fraction e of the speed (restitution coefficient), so the next height is e²·h.
 * The energy bars: potential mgh, kinetic mυ²/2 and the increase of the internal energy of the ball
 * and the plate — everything the ball has lost. The sum stays equal to mgh₀.
 */
import VeStyles from './VeStyles.astro';

const FY = 330; // floor
const PXM = 140; // px per metre
const BX = 210;
const ticks = [0, 0.5, 1, 1.5, 2];
const bars = [
	{ k: 'p', x: 470, name: 'потенц.', sym: 'E_п' },
	{ k: 'k', x: 560, name: 'кинет.', sym: 'E_к' },
	{ k: 'u', x: 650, name: 'внутр.', sym: 'ΔE' },
];
---

<VeStyles />
<figure class="ve-box be not-content" data-be>
	<div class="ve-row be__balls" role="group" aria-label="Какой шар бросаем">
		<button type="button" class="ve-chip" data-ball="rub" aria-pressed="true">Резиновый мяч</button>
		<button type="button" class="ve-chip" data-ball="st" aria-pressed="false">Стальной шарик</button>
		<button type="button" class="ve-chip" data-ball="pl" aria-pressed="false">Пластилиновый шар</button>
	</div>
	<svg class="ve-svg be__svg" viewBox="0 0 720 370" role="img" aria-label="Шар падает на плиту; столбики показывают его потенциальную и кинетическую энергию и рост внутренней энергии">
		<rect class="be__plate" x="90" y={FY} width="260" height="18" rx="3"></rect>
		<line class="be__floor" x1="20" y1={FY + 18} x2="420" y2={FY + 18}></line>
		<g class="be__ruler">
			<line x1="50" y1={FY} x2="50" y2={FY - 2 * PXM - 6}></line>
			{
				ticks.map((h) => (
					<g>
						<line x1="44" y1={FY - h * PXM} x2="56" y2={FY - h * PXM} />
						<text x="38" y={FY - h * PXM + 5} text-anchor="end">
							{String(h).replace('.', ',')}
						</text>
					</g>
				))
			}
			<text x="62" y={FY - 2 * PXM - 12}>
				<tspan class="ve-math">h</tspan>, м
			</text>
		</g>
		<line class="be__h0" x1="120" x2="320" data-h0></line>
		<text class="be__h0-label" x="326" data-h0-label></text>
		<ellipse class="be__ball" cx={BX} rx="14" ry="14" data-ball-el></ellipse>
		<ellipse class="be__glint" rx="4" ry="3" data-glint></ellipse>

		<g class="be__bars">
			<line class="be__base" x1="430" y1={FY} x2="700" y2={FY}></line>
			<line class="be__total" x1="430" x2="700" data-total></line>
			<text class="be__total-label" x="700" text-anchor="end" data-total-label></text>
			{
				bars.map((b) => (
					<g>
						<rect class={`be__bar be__bar--${b.k}`} x={b.x - 30} width="60" y={FY} height="0" rx="4" data-bar={b.k} />
						<text class="be__val" x={b.x} y={FY - 8} text-anchor="middle" data-val={b.k} />
						<text class="be__name" x={b.x} y={FY + 30} text-anchor="middle">
							{b.name}
						</text>
					</g>
				))
			}
		</g>
	</svg>

	<label class="ve-slider">
		<span>Начальная высота <i>h</i><sub>0</sub></span>
		<output data-h-out>1,5 м</output>
		<input type="range" min="0.5" max="2" step="0.1" value="1.5" data-h />
	</label>
	<div class="ve-row">
		<button type="button" class="ve-btn ve-btn--primary" data-drop>Отпустить шар</button>
		<label class="be__slow"><input type="checkbox" data-slow checked /> замедлить в 4 раза</label>
	</div>
	<div class="ve-formula" data-formula></div>
	<p class="ve-live" aria-live="polite" data-live></p>
	<figcaption class="ve-cap">
		Масса каждого шара 0,2 кг, <i>g</i> = 9,8 Н/кг, сопротивление воздуха не учитываем. Столбики: <span class="ve-c-vx">потенциальная энергия</span>{' '}
		<i>E</i><sub>п</sub> = <i>mgh</i>, <span class="ve-c-vy">кинетическая</span> <i>E</i><sub>к</sub> = <i>m</i>υ²/2 и <span class="ve-c-v">на сколько увеличилась внутренняя энергия</span> шара и
		плиты. Пунктир — начальная механическая энергия <i>mgh</i><sub>0</sub>: сумма трёх столбиков всё время равна ей.
	</figcaption>
</figure>

<style is:global>
	.be__plate {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.be__floor,
	.be__base {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.be__ruler line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.be__ruler text,
	.be__name {
		font-size: 15px;
		fill: var(--sl-color-gray-2);
	}
	.be__h0 {
		stroke: var(--sl-color-gray-3);
		stroke-dasharray: 5 5;
	}
	.be__h0-label {
		font-size: 15px;
		fill: var(--sl-color-gray-2);
	}
	.be__ball {
		stroke-width: 2;
	}
	[data-be][data-kind='rub'] .be__ball {
		fill: var(--ig-vy);
		stroke: color-mix(in srgb, var(--ig-vy) 60%, black);
	}
	[data-be][data-kind='st'] .be__ball {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
	}
	[data-be][data-kind='pl'] .be__ball {
		fill: color-mix(in srgb, var(--ig-vx) 70%, var(--ig-v));
		stroke: color-mix(in srgb, var(--ig-vx) 50%, black);
	}
	.be__glint {
		fill: white;
		opacity: 0.55;
	}
	.be__bar--p {
		fill: var(--ig-vx);
	}
	.be__bar--k {
		fill: var(--ig-vy);
	}
	.be__bar--u {
		fill: var(--ig-v);
	}
	.be__val {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.be__total {
		stroke: var(--sl-color-white);
		stroke-width: 1.5;
		stroke-dasharray: 7 5;
	}
	.be__total-label {
		font-size: 14px;
		fill: var(--sl-color-gray-2);
	}
	.be__slow {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.be__slow input {
		accent-color: var(--sl-color-accent);
	}
	.be__formula-sub {
		color: var(--ig-v);
	}
	@media (max-width: 40rem) {
		.be__ruler text,
		.be__h0-label,
		.be__val {
			font-size: 23px;
		}
		.be__name {
			font-size: 20px;
		}
		.be__total-label {
			font-size: 20px;
		}
	}
</style>

<script>
	import { loop, reduceMotion, renderTex, tex, ru } from './heat';

	const FY = 330;
	const PXM = 140;
	const BX = 210;
	const M = 0.2;
	const G = 9.8;
	const EMAX = M * G * 2; // energy of the highest drop, J: the full height of a bar
	const BAR_H = 270;
	const BALLS = {
		rub: { e: 0.8, r: 14, name: 'резиновый мяч' },
		st: { e: 0.95, r: 10, name: 'стальной шарик' },
		pl: { e: 0, r: 13, name: 'пластилиновый шар' },
	} as const;
	type Kind = keyof typeof BALLS;

	for (const root of document.querySelectorAll<HTMLElement>('[data-be]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const ball = $<SVGEllipseElement>('[data-ball-el]');
		const glint = $<SVGEllipseElement>('[data-glint]');
		const hIn = $<HTMLInputElement>('[data-h]');
		const hOut = $<HTMLOutputElement>('[data-h-out]');
		const slow = $<HTMLInputElement>('[data-slow]');
		const formula = $<HTMLElement>('[data-formula]');
		const live = $<HTMLElement>('[data-live]');
		const dropBtn = $<HTMLButtonElement>('[data-drop]');
		const bar = (k: string) => $<SVGRectElement>(`[data-bar="${k}"]`);
		const val = (k: string) => $<SVGTextElement>(`[data-val="${k}"]`);

		let kind: Kind = 'rub';
		let h0 = 1.5;
		let y = h0; // height of the bottom of the ball, m
		let v = 0; // velocity, m/s (up is +)
		let state: 'ready' | 'fly' | 'rest' = 'ready';
		let bounces = 0;
		let squash = 0; // seconds of the squash after an impact
		root.dataset.kind = kind;

		const E0 = () => M * G * h0;

		const showFormulaStart = () =>
			renderTex(
				formula,
				`E_{\\text{п}} = mgh_0 = ${tex(M)}~\\text{кг}\\cdot ${tex(G)}~\\tfrac{\\text{Н}}{\\text{кг}}\\cdot ${tex(h0)}~\\text{м} \\approx ${tex(E0(), 2)}~\\text{Дж}`,
			);
		const showFormulaAfter = (h1: number) => {
			const dE = M * G * (h0 - h1);
			renderTex(
				formula,
				h1 > 0
					? `\\begin{aligned}\\Delta E_{\\text{вн}} &= mgh_0 - mgh_{${bounces}} = mg\\,(h_0 - h_{${bounces}}) \\\\ &= ${tex(M)}\\cdot ${tex(G)}\\cdot(${tex(h0)} - ${tex(h1, 2)}) \\approx ${tex(dE, 2)}~\\text{Дж}\\end{aligned}`
					: `\\Delta E_{\\text{вн}} = mgh_0 = ${tex(M)}\\cdot ${tex(G)}\\cdot ${tex(h0)} \\approx ${tex(dE, 2)}~\\text{Дж}`,
			);
		};

		const draw = () => {
			const b = BALLS[kind];
			let sx = 1;
			let sy = 1;
			if (kind === 'pl' && state === 'rest') {
				sx = 1.45;
				sy = 0.55;
			} else if (squash > 0) {
				const s = Math.sin((squash / 0.07) * Math.PI) * 0.25;
				sx = 1 + s;
				sy = 1 - s;
			}
			const rx = b.r * sx;
			const ry = b.r * sy;
			const cy = FY - y * PXM - ry;
			ball.setAttribute('rx', rx.toFixed(2));
			ball.setAttribute('ry', ry.toFixed(2));
			ball.setAttribute('cy', cy.toFixed(2));
			glint.setAttribute('cx', (BX - rx * 0.35).toFixed(2));
			glint.setAttribute('cy', (cy - ry * 0.4).toFixed(2));
			const ep = M * G * y;
			const ek = (M * v * v) / 2;
			const du = Math.max(0, E0() - ep - ek);
			for (const [k, e] of [
				['p', ep],
				['k', ek],
				['u', du],
			] as const) {
				const hgt = (e / EMAX) * BAR_H;
				bar(k).setAttribute('y', (FY - hgt).toFixed(1));
				bar(k).setAttribute('height', hgt.toFixed(1));
				val(k).setAttribute('y', (FY - hgt - 8).toFixed(1));
				val(k).textContent = `${ru(e, 2)} Дж`;
			}
			const yt = FY - (E0() / EMAX) * BAR_H;
			$('[data-total]').setAttribute('y1', String(yt));
			$('[data-total]').setAttribute('y2', String(yt));
			const tl = $<SVGTextElement>('[data-total-label]');
			tl.setAttribute('y', String(yt - 28));
			tl.textContent = `mgh₀ = ${ru(E0(), 2)} Дж`;
			const hy = FY - h0 * PXM;
			$('[data-h0]').setAttribute('y1', String(hy));
			$('[data-h0]').setAttribute('y2', String(hy));
			const hl = $<SVGTextElement>('[data-h0-label]');
			hl.setAttribute('y', String(hy + 5));
			hl.textContent = `h₀ = ${ru(h0, 1)} м`;
		};

		const step = (dtReal: number) => {
			if (squash > 0) squash = Math.max(0, squash - dtReal);
			if (state !== 'fly') {
				draw();
				return squash > 0;
			}
			let dt = dtReal * (slow.checked ? 0.25 : 1);
			// exact free fall up to the impact inside the step
			while (dt > 0 && state === 'fly') {
				const tHit = (v + Math.sqrt(v * v + 2 * G * y)) / G; // time to reach y = 0
				if (tHit > dt) {
					y += v * dt - (G * dt * dt) / 2;
					v -= G * dt;
					dt = 0;
				} else {
					const vHit = v - G * tHit;
					dt -= tHit;
					y = 0;
					bounces += 1;
					squash = reduceMotion() ? 0 : 0.07;
					const e = BALLS[kind].e;
					const h1 = (e * vHit) ** 2 / (2 * G);
					if (h1 < 0.003) {
						v = 0;
						state = 'rest';
						showFormulaAfter(0);
						live.innerHTML =
							kind === 'pl'
								? `Пластилин прилип к плите. Механическая энергия шара стала равна нулю — вся она, <b>${ru(E0(), 2)} Дж</b>, перешла во внутреннюю энергию шара и плиты.`
								: `Шар успокоился. Вся механическая энергия, <b>${ru(E0(), 2)} Дж</b>, перешла во внутреннюю энергию шара и плиты.`;
						dropBtn.disabled = false;
					} else {
						v = -vHit * e;
						showFormulaAfter(h1);
						live.innerHTML = `Удар ${bounces}: шар подскочит на высоту <b>${ru(h1, 2)} м</b>. Внутренняя энергия шара и плиты уже увеличилась на <b>${ru(M * G * (h0 - h1), 2)} Дж</b>.`;
					}
				}
			}
			draw();
			return true;
		};
		const wake = loop(root, step);

		const ready = () => {
			state = 'ready';
			y = h0;
			v = 0;
			bounces = 0;
			showFormulaStart();
			live.textContent = 'Шар поднят и неподвижен: у него есть только потенциальная энергия. Нажмите «Отпустить шар».';
			dropBtn.disabled = false;
			dropBtn.textContent = 'Отпустить шар';
			draw();
		};

		dropBtn.addEventListener('click', () => {
			if (state !== 'ready') {
				ready();
				return;
			}
			state = 'fly';
			dropBtn.textContent = 'Поднять снова';
			live.textContent = 'Шар падает: потенциальная энергия переходит в кинетическую.';
			wake();
		});
		hIn.addEventListener('input', () => {
			h0 = Number(hIn.value);
			hOut.textContent = `${ru(h0, 1)} м`;
			ready();
		});
		for (const chip of root.querySelectorAll<HTMLButtonElement>('[data-ball]')) {
			chip.addEventListener('click', () => {
				kind = chip.dataset.ball as Kind;
				root.dataset.kind = kind;
				for (const c of root.querySelectorAll('[data-ball]')) c.setAttribute('aria-pressed', String(c === chip));
				ready();
			});
		}
		ready();
	}
</script>
