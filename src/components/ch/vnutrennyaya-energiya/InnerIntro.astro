---
/**
 * Two short looping opening scenes of «Внутренняя энергия».
 * Palms: two hands rub against each other (2 strokes per second) and grow warm; no numbers: the measured rise is
 * small (about +0,4 °C after 10 s of vigorous rubbing, Gunner et al., Gut 64 Suppl 1, A385, 2015).
 * Spoon: an aluminium teaspoon in a glass of tea at 80 °C, 0:00 → 1:00 in 6,5 s; the colour along the part above
 * the tea follows a 1D fin model (k = 237 Вт/(м·К), 4,8 cm above the tea, bowl lag 15 s), so the handle end is
 * hot (≈ 70 °C) after half a minute; a finger touches it and jerks back.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// Spoon: bowl bottom (144, 216), leans on the rim at (206, 92), handle end at (225, 54).
const SP = { x0: 144, y0: 216, x1: 225, y1: 54 };
const ySurf = 110; // tea surface
const yHold = 150; // top of the glass holder
const at = (y: number) => SP.x0 + ((SP.x1 - SP.x0) * (SP.y0 - y)) / (SP.y0 - SP.y1);
const SEG = 24; // segments of the spoon above the tea
const segs = Array.from({ length: SEG }, (_, i) => {
	const ya = ySurf + ((SP.y1 - ySurf) * i) / SEG;
	const yb = ySurf + ((SP.y1 - ySurf) * (i + 1)) / SEG;
	return { x1: at(ya), y1: ya, x2: at(yb), y2: yb };
});
const r1 = (v: number) => Math.round(v * 10) / 10;
---

<IntroFrame data-veintro>
	<div class="intro__card" data-scene="palms">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Человек быстро трёт ладони друг о друга, и через несколько секунд ладони становятся тёплыми">
			<rect class="vei__wall" x="0" y="0" width="360" height="240" />
			<!-- arrows: the hands slide up and down -->
			<g class="vei__arrows" data-arrows>
				{[100, 260].map((x) => (
					<path d={`M${x} 92 V140 M${x - 7} 100 L${x} 91 L${x + 7} 100 M${x - 7} 132 L${x} 141 L${x + 7} 132`} />
				))}
			</g>
			<!-- left hand, the right one is its mirror image -->
			{[0, 1].map((i) => (
				<g transform={i ? 'translate(360 0) scale(-1 1)' : undefined}>
					<path class="vei__sleeve" d="M144 184 H180 L178 240 H112 Z" />
					<g data-hand={i}>
						<path class="vei__hand" data-palm d="M180 34 C173 34 168 39 167 47 L162 100 C161 108 157 114 153 120 C147 130 145 146 146 162 L149 192 H180 Z" />
						<path class="vei__line" d="M180 46 C175 46 171 50 170 57 L166 104 M165 66 q 4 -2 7 0 M163 88 q 4 -2 7 0" />
						<path class="vei__hand" data-palm d="M180 96 C175 96 172 100 171 106 L168 132 C166 150 160 166 150 180 L149 192 H180 Z" />
					</g>
				</g>
			))}
			<!-- the warmth between the palms -->
			<g class="vei__glow" data-glow>
				<ellipse cx="180" cy="116" rx="34" ry="80" />
				<ellipse cx="180" cy="116" rx="20" ry="66" />
				<ellipse cx="180" cy="116" rx="8" ry="54" />
			</g>
			<g class="vei__shim" data-shim>
				{[168, 192].map((x, i) => (
					<path style={`--d:${i * 0.7}s`} d={`M ${x} 36 q -5 -7 0 -14 q 5 -7 0 -14`} />
				))}
			</g>
		</svg>
		<div class="intro__foot">
			<p>Потрите ладони — и через несколько секунд они потеплеют. Их никто не грел: их нагрело трение. <More term="Почему?">Когда ладони трутся, мы совершаем работу против силы трения, и частицы кожи начинают двигаться быстрее. Так растёт <b>внутренняя энергия</b> ладоней — её можно изменить, <b>совершая работу</b>. Об этом ниже. Термометр покажет немного: после 10&nbsp;секунд энергичного трения ладони теплее примерно на полградуса.</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="spoon">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Алюминиевая ложка в стакане горячего чая: за минуту она прогревается до самого конца ручки, и палец, коснувшись ручки, отдёргивается">
			<rect class="vei__wall" x="0" y="0" width="360" height="240" />
			<g class="vei__clock">
				<circle cx="30" cy="30" r="9" />
				<path d="M27 18 h6 M30 21 V30" data-hand2 />
				<text x="45" y="36" data-clock>0:00</text>
			</g>
			<rect class="vei__table" x="0" y="226" width="360" height="14" />
			<!-- steam -->
			<g class="vei__steam">
				{[150, 170].map((x, i) => (
					<path style={`--d:${i * 0.6}s`} d={`M ${x} 90 q -6 -7 0 -14 q 6 -7 0 -14`} />
				))}
			</g>
			<!-- the spoon: the part in the tea, then segments above it -->
			<line class="vei__spoon" data-wet x1={r1(at(yHold + 4))} y1={yHold + 4} x2={r1(at(ySurf))} y2={ySurf} />
			<g data-segs>
				{segs.map((s) => (
					<line class="vei__spoon" x1={r1(s.x1)} y1={r1(s.y1)} x2={r1(s.x2)} y2={r1(s.y2)} />
				))}
			</g>
			<ellipse class="vei__spoon-end" data-end cx={SP.x1} cy={SP.y1} rx="5.5" ry="7.5" transform={`rotate(27 ${SP.x1} ${SP.y1})`} />
			<!-- tea and glass -->
			<path class="vei__tea" d={`M130.6 ${ySurf} H205.4 L201 222 H135 Z`} />
			<path class="vei__glass" d="M128 92 L135 222 H201 L208 92" />
			<!-- the holder -->
			<path class="vei__holder-ear" d="M132 160 C 108 160 104 172 106 186 C 108 200 116 206 134 206" />
			<path class="vei__holder" d="M130 150 H206 L202 220 L208 228 H128 L134 220 Z" />
			<path class="vei__holder-line" d="M131 162 H205 M133 208 H203" />
			<g class="vei__holder-dots">
				{[146, 160, 174, 188].map((x) => (
					<circle cx={x + 2} cy="185" r="4" />
				))}
			</g>
			<!-- the finger that touches the handle -->
			<g data-finger>
				<g class="vei__ouch" data-ouch>
					<path d="M220 34 l -5 -9 M232 32 l 1 -10 M242 40 l 8 -6" />
				</g>
				<g data-fingerbody>
					<path class="vei__sleeve" d="M300 66 L360 58 V112 L306 112 Z" />
					<rect class="vei__hand" x="262" y="62" width="48" height="40" rx="14" />
					<rect class="vei__hand" x="228" y="50" width="56" height="14" rx="7" />
					<path class="vei__line" d="M272 63 q 6 4 0 8" />
				</g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Ложка стоит в горячем чае, и через минуту горячей стала даже её ручка: тепло добралось до неё по металлу. <More term="Почему?">Быстрые частицы горячего чая толкают частицы ложки, те — соседние, и так энергия по металлу добирается до ручки. Это <b>теплопередача</b>, а точнее — <b>теплопроводность</b>, о ней ниже. Быстрее всего прогреваются серебряные и алюминиевые ложки. Сталь проводит тепло хуже, и ручка стальной ложки нагревается медленнее.</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.vei__wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	[data-veintro] {
		--vei-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	:root[data-theme='light'] [data-veintro] {
		--vei-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.vei__hand {
		fill: var(--vei-skin);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.vei__line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	.vei__sleeve {
		fill: color-mix(in srgb, var(--ig-vx) 55%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.vei__arrows path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.vei__glow ellipse {
		fill: var(--ig-vy);
		opacity: calc(0.14 * var(--heat, 0));
	}
	.vei__shim path,
	.vei__steam path {
		fill: none;
		stroke-width: 2.2;
		stroke-linecap: round;
		opacity: 0;
		animation: veintro-rise 1.4s ease-in infinite;
		animation-delay: var(--d);
	}
	.vei__shim path {
		stroke: var(--ig-vy);
	}
	.vei__steam path {
		--heat: 0.7;
		stroke: var(--sl-color-gray-2);
	}
	@keyframes veintro-rise {
		0% { opacity: 0; transform: translateY(4px); }
		40% { opacity: calc(0.9 * var(--heat, 0)); }
		100% { opacity: 0; transform: translateY(-10px); }
	}
	.vei__clock circle,
	.vei__clock path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.vei__clock text {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.vei__table {
		fill: var(--sl-color-gray-5);
	}
	.vei__spoon {
		stroke: var(--sl-color-gray-3);
		stroke-width: 6;
		stroke-linecap: round;
	}
	.vei__spoon-end {
		fill: var(--sl-color-gray-3);
	}
	.vei__tea {
		fill: color-mix(in srgb, color-mix(in oklab, var(--ig-v) 70%, var(--ig-vy)) 55%, transparent);
	}
	.vei__glass {
		fill: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.vei__holder,
	.vei__holder-ear {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.vei__holder {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-4));
	}
	.vei__holder-ear {
		fill: none;
		stroke-width: 6;
		stroke-linecap: round;
		stroke: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-3));
	}
	.vei__holder-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.vei__holder-dots circle {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.vei__ouch path {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	@media (prefers-reduced-motion: reduce) {
		.vei__shim path,
		.vei__steam path {
			animation: none;
			opacity: calc(0.7 * var(--heat, 0));
		}
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};

	/**
	 * Aluminium teaspoon in tea at 80 °C, room 22 °C: the part above the tea is a fin of length 4,8 cm
	 * (8 × 2 mm, k = 237 Вт/(м·К), ρ = 2700 кг/м³, c = 900 Дж/(кг·°C), h = 12 Вт/(м²·°C), tip insulated);
	 * its base follows the bowl, which warms with a time constant of 15 s. Returns T(node, s) for s = 0…60 s.
	 */
	const spoonModel = (n: number) => {
		const L = 0.048, k = 237, rho = 2700, c = 900, w = 0.008, th = 0.002, h = 12;
		const a = k / (rho * c);
		const m2 = (h * 2 * (w + th)) / (k * w * th);
		const dx = L / n;
		const dt = (0.4 * dx * dx) / a;
		const T = new Float64Array(n + 1).fill(22);
		const frames: Float64Array[] = [T.slice()];
		let t = 0;
		let next = 0.5;
		while (t < 60) {
			const b = T[0] + (dt * (80 - T[0])) / 15;
			const Tn = T.slice();
			for (let i = 1; i < n; i++) Tn[i] = T[i] + dt * a * ((T[i + 1] - 2 * T[i] + T[i - 1]) / (dx * dx) - m2 * (T[i] - 22));
			Tn[n] = T[n] + dt * a * ((2 * (T[n - 1] - T[n])) / (dx * dx) - m2 * (T[n] - 22));
			Tn[0] = b;
			T.set(Tn);
			t += dt;
			if (t >= next) {
				frames.push(T.slice());
				next += 0.5;
			}
		}
		return (s: number) => {
			const f = Math.min(frames.length - 1.001, (s / 60) * (frames.length - 1));
			const i = Math.floor(f);
			const u = f - i;
			return (j: number) => frames[i][j] * (1 - u) + frames[i + 1][j] * u;
		};
	};

	const tint = (T: number) =>
		`color-mix(in oklab, var(--ig-vy) ${Math.round(85 * clamp((T - 22) / 58))}%, var(--sl-color-gray-3))`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-veintro]')) {
		// Palms: about 12 strokes in 6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="palms"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const hands = [0, 1].map((i) => $<SVGGElement>(`[data-hand="${i}"]`));
			const palms = Array.from(card.querySelectorAll<SVGPathElement>('[data-palm]'));
			const glow = $<SVGGElement>('[data-glow]');
			const shim = $<SVGGElement>('[data-shim]');
			const arrows = $<SVGGElement>('[data-arrows]');
			scene(card, 6, (x) => {
				const env = smooth(0, 0.06, x) * (1 - smooth(0.9, 1, x));
				const dy = 12 * env * Math.sin(2 * Math.PI * 12 * x);
				hands[0].setAttribute('transform', `translate(0 ${dy.toFixed(2)})`);
				hands[1].setAttribute('transform', `translate(0 ${(-dy).toFixed(2)})`);
				const heat = 1 - (1 - x) ** 2;
				for (const p of palms)
					p.style.fill = `color-mix(in oklab, var(--ig-vy) ${Math.round(40 * heat)}%, var(--vei-skin))`;
				glow.style.setProperty('--heat', heat.toFixed(2));
				shim.style.setProperty('--heat', clamp((heat - 0.3) / 0.7).toFixed(2));
				arrows.style.opacity = (0.9 * env).toFixed(2);
			});
		}

		// Spoon: 0:00 → 1:00 in 6,5 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="spoon"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const clock = $<SVGTextElement>('[data-clock]');
			const hand = $<SVGPathElement>('[data-hand2]');
			const wet = $<SVGLineElement>('[data-wet]');
			const segs = Array.from($<SVGGElement>('[data-segs]').children) as SVGLineElement[];
			const end = $<SVGEllipseElement>('[data-end]');
			const finger = $<SVGGElement>('[data-fingerbody]');
			const ouch = $<SVGGElement>('[data-ouch]');
			const model = spoonModel(segs.length);
			scene(card, 6.5, (x) => {
				const s = 60 * x;
				clock.textContent = `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
				const ang = (s / 60) * 2 * Math.PI;
				hand.setAttribute('d', `M30 30 L${(30 + 6 * Math.sin(ang)).toFixed(1)} ${(30 - 6 * Math.cos(ang)).toFixed(1)}`);
				const T = model(s);
				wet.style.stroke = tint(T(0));
				segs.forEach((seg, j) => (seg.style.stroke = tint((T(j) + T(j + 1)) / 2)));
				end.style.fill = tint(T(segs.length));
				// the finger comes at 0:40, touches at 0:48, jerks back at 0:51
				const come = smooth(40, 48, s);
				const back = smooth(50.5, 52, s);
				const fx = 140 * (1 - come) + 22 * back;
				const fy = -10 * back;
				finger.setAttribute('transform', `translate(${fx.toFixed(1)} ${fy.toFixed(1)})`);
				ouch.style.opacity = smooth(50.5, 51.5, s).toFixed(2);
			});
		}
	}
</script>
