---
/**
 * Heat receiver (теплоприёмник): a flat closed metal box, one face black, the other shiny,
 * connected to a liquid manometer. The box absorbs the fraction α of the radiation falling on its front face
 * (black ≈ 0,95, shiny ≈ 0,1) and loses heat through both faces, so the steady heating — and the difference of
 * the liquid levels — is proportional to α·E, where E ∝ R²/(R² + d²) is the radiation falling from a disc
 * heater of radius R = 10 cm at the distance d. The approach to the steady state is sped up.
 */
import VeStyles from './VeStyles.astro';

const HX = 92; // front of the heater
const MX = 610; // axis between the arms of the manometer
const MY = 250; // level of liquid at rest
const rays = [-48, -24, 0, 24, 48];
---

<VeStyles />
<figure class="ve-box rb not-content" data-rb>
	<svg class="ve-svg" viewBox="0 0 720 336" role="img" aria-label="Нагреватель излучает; теплоприёмник соединён с жидкостным манометром">
		<!-- heater -->
		<rect class="rb__stand" x="40" y="236" width="70" height="12" rx="3"></rect>
		<rect class="rb__stand" x="66" y="190" width="14" height="48"></rect>
		<rect class="rb__heater" x="62" y="70" width="30" height="124" rx="6"></rect>
		<path class="rb__coil" d="M 92 80 q 8 6 0 12 q -8 6 0 12 q 8 6 0 12 q -8 6 0 12 q 8 6 0 12 q -8 6 0 12 q 8 6 0 12 q -8 6 0 12 q 8 6 0 12"></path>
		<text class="rb__lbl" x="77" y="56" text-anchor="middle">нагреватель</text>
		<!-- rays (invisible infrared radiation, drawn as dashed waves) -->
		<g class="rb__rays" data-rays>
			{rays.map((dy) => <path data-ray={dy} />)}
		</g>
		<!-- heat receiver -->
		<g data-box>
			<g class="rb__box" data-box-body>
				<rect class="rb__case" x="-13" y="72" width="26" height="120" rx="4"></rect>
				<rect class="rb__face rb__face--black" x="-15" y="74" width="7" height="116" rx="2" data-face-l></rect>
				<rect class="rb__face rb__face--shiny" x="8" y="74" width="7" height="116" rx="2" data-face-r></rect>
			</g>
			<rect class="rb__stand" x="-4" y="192" width="8" height="46"></rect>
			<rect class="rb__stand" x="-26" y="236" width="52" height="12" rx="3"></rect>
			<path class="rb__tube" data-tube></path>
			<text class="rb__lbl" x="0" y="272" text-anchor="middle">теплоприёмник</text>
		</g>
		<!-- manometer -->
		<path class="rb__u-glass" d={`M ${MX - 30} 110 V 270 a 30 30 0 0 0 60 0 V 110`}></path>
		<path class="rb__liquid" data-liquid></path>
		<path class="rb__u-glass rb__u-in" d={`M ${MX - 30} 110 V 270 a 30 30 0 0 0 60 0 V 110`}></path>
		<line class="rb__rest" x1={MX - 46} y1={MY} x2={MX + 46} y2={MY}></line>
		<text class="rb__lbl" x={MX} y="330" text-anchor="middle">манометр</text>
		<text class="rb__dh" x={MX + 44} text-anchor="start" data-dh></text>
	</svg>
	<label class="ve-slider">
		<span>Расстояние от нагревателя до теплоприёмника</span>
		<output data-d-out>15 см</output>
		<input type="range" min="10" max="40" step="1" value="15" data-d />
	</label>
	<div class="ve-row">
		<button type="button" class="ve-btn ve-btn--primary" data-power>Включить нагреватель</button>
		<button type="button" class="ve-btn" data-turn>Повернуть другой стороной</button>
	</div>
	<p class="ve-live" aria-live="polite" data-live></p>
	<figcaption class="ve-cap">
		Теплоприёмник — плоская закрытая металлическая коробочка: одна сторона покрашена в чёрный цвет, другая блестящая. Воздух в ней нагревается, расширяется и давит на жидкость в манометре.
		Волнистые линии условно показывают невидимое (инфракрасное) излучение. Модель считает, что чёрная поверхность поглощает около 95 % падающего на неё излучения, а блестящая — около 10 %.
		Время в модели ускорено.
	</figcaption>
</figure>

<style is:global>
	.rb__stand {
		fill: var(--sl-color-gray-4);
	}
	.rb__heater {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.rb__coil {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
		transition: stroke 1.2s;
	}
	.rb.is-on .rb__coil {
		stroke: var(--ig-vy);
		filter: drop-shadow(0 0 5px var(--ig-vy));
	}
	.rb__rays path {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
		stroke-dasharray: 2 6;
		stroke-linecap: round;
		opacity: 0;
		transition: opacity 0.6s;
	}
	.rb__case {
		fill: var(--sl-color-gray-4);
	}
	.rb__face--black {
		fill: #111;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rb__face--shiny {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rb__tube {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linejoin: round;
	}
	.rb__u-glass {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 18;
		stroke-linejoin: round;
		opacity: 0.35;
	}
	.rb__u-in {
		stroke: var(--sl-color-bg);
		stroke-width: 12;
		opacity: 0;
	}
	.rb__liquid {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 12;
	}
	.rb__rest {
		stroke: var(--sl-color-gray-3);
		stroke-dasharray: 4 4;
	}
	.rb__lbl {
		font-size: 15px;
		fill: var(--sl-color-gray-2);
	}
	.rb__dh {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.rb__lbl,
		.rb__dh {
			font-size: 22px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.rb__coil,
		.rb__rays path {
			transition: none;
		}
	}
</style>

<script>
	import { loop, reduceMotion } from './heat';

	const HX = 92;
	const MX = 610;
	const MY = 250;
	const PX_CM = 9; // drawing scale for the distance
	const R = 10; // radius of the heater, cm
	const ALPHA = { black: 0.95, shiny: 0.1 };
	const DH_MAX = 70; // px: level difference for the black face at 10 cm
	const TAU = 2.5; // s, sped up

	const flux = (d: number) => (R * R) / (R * R + d * d);

	for (const root of document.querySelectorAll<HTMLElement>('[data-rb]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const box = $<SVGGElement>('[data-box]');
		const body = $<SVGGElement>('[data-box-body]');
		const tube = $<SVGPathElement>('[data-tube]');
		const liquid = $<SVGPathElement>('[data-liquid]');
		const dIn = $<HTMLInputElement>('[data-d]');
		const dOut = $<HTMLOutputElement>('[data-d-out]');
		const live = $<HTMLElement>('[data-live]');
		const powerBtn = $<HTMLButtonElement>('[data-power]');
		const raysEl = Array.from(root.querySelectorAll<SVGPathElement>('[data-ray]'));

		let d = 15;
		let on = false;
		let front: 'black' | 'shiny' = 'black';
		let dh = 0; // level difference, px
		let turn = 1; // 1 → black faces the heater; animated through 0 when turning
		let turnGoal = 1;

		const boxX = () => HX + d * PX_CM;
		const goal = () => (on ? (DH_MAX * ALPHA[front] * flux(d)) / flux(10) : 0);

		const draw = (t: number) => {
			const bx = boxX();
			box.setAttribute('transform', `translate(${bx} 0)`);
			body.setAttribute('transform', `scale(${turn.toFixed(3)} 1)`);
			// the faces: at turn = 1 the black face is on the left (towards the heater)
			tube.setAttribute('d', `M 0 72 V 40 H ${MX - 30 - bx} V 110`);
			const yl = MY + dh / 2;
			const yr = MY - dh / 2;
			liquid.setAttribute('d', `M ${MX - 30} ${yl} V 270 a 30 30 0 0 0 60 0 V ${yr}`);
			const dhEl = $<SVGTextElement>('[data-dh]');
			dhEl.setAttribute('y', String(yr + 5));
			dhEl.textContent = '';
			const len = bx - 15 - HX - 6;
			const amp = on ? 1 : 0;
			raysEl.forEach((p) => {
				const dy = Number(p.dataset.ray);
				const y = 132 + dy * Math.min(1, 0.4 + 0.06 * d);
				const ph = reduceMotion() ? 0 : (t * 60) % 16;
				let path = `M ${HX + 6} ${132 + dy * 0.45}`;
				for (let k = 1; k <= 24; k++) {
					const x = HX + 6 + (len * k) / 24;
					const yy = 132 + dy * 0.45 + (y - 132 - dy * 0.45) * (k / 24) + Math.sin(k * 1.6) * 3;
					path += ` L ${x.toFixed(1)} ${yy.toFixed(1)}`;
				}
				p.setAttribute('d', path);
				p.style.strokeDashoffset = String(-ph);
				p.style.opacity = String(amp * (0.35 + 0.65 * flux(d) / flux(10)));
			});
		};

		const step = (dt: number, t: number) => {
			const g = goal();
			dh += (g - dh) * Math.min(1, dt / TAU);
			if (turn !== turnGoal) {
				const s = reduceMotion() ? 2 : dt * 4;
				turn = turnGoal > turn ? Math.min(turnGoal, turn + s) : Math.max(turnGoal, turn - s);
			}
			draw(t);
			return on || Math.abs(g - dh) > 0.2 || turn !== turnGoal;
		};
		const wake = loop(root, step);

		const say = () => {
			if (!on) live.textContent = 'Нагреватель выключен. Включите его и следите за жидкостью в манометре.';
			else
				live.textContent =
					front === 'black'
						? 'К нагревателю повёрнута чёрная сторона: она поглощает почти всё излучение, воздух в коробочке нагревается сильнее, и уровни жидкости расходятся сильнее.'
						: 'К нагревателю повёрнута блестящая сторона: она отражает почти всё излучение, поэтому теплоприёмник нагревается гораздо слабее.';
		};

		powerBtn.addEventListener('click', () => {
			on = !on;
			root.classList.toggle('is-on', on);
			powerBtn.textContent = on ? 'Выключить нагреватель' : 'Включить нагреватель';
			say();
			wake();
		});
		$('[data-turn]').addEventListener('click', () => {
			front = front === 'black' ? 'shiny' : 'black';
			turnGoal = front === 'black' ? 1 : -1;
			say();
			wake();
		});
		dIn.addEventListener('input', () => {
			d = Number(dIn.value);
			dOut.textContent = `${d} см`;
			wake();
		});
		say();
		draw(0);
	}
</script>
