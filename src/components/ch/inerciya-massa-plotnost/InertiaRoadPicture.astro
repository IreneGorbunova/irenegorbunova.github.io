---
/**
 * Picture «Автомобиль нельзя остановить мгновенно»: a car at 60 км/ч, a pedestrian comes up to a zebra crossing ahead
 * and waits on the pavement; the driver brakes, but the car passes the crossing and stops only beyond it.
 *
 * Numbers. υ = 60 км/ч = 16,67 м/с.
 *   Reaction of the driver 1 с: the car keeps its speed and covers 16,67 · 1 ≈ 16,7 м.
 *   Braking on dry asphalt with a deceleration of 7 м/с² (friction coefficient about 0,7): the braking path is
 *   υ²/(2a) = 277,8 / 14 ≈ 19,8 м, the braking time υ/a ≈ 2,38 с.
 *   Total: 36,5 м in 3,38 с. The chapter's popover says «около 37 м: около 17 м … и ещё около 20 м».
 *   The crossing (4 м wide) begins 25 м ahead of the car's front at the moment the pedestrian comes up to it; the car
 *   reaches it still at about 46 км/ч and stops with its rear 3 м beyond it (front at 36,5 м, car 4,3 м long).
 * Scale: 9 px per метр along the road, the same for the car (4,3 × 1,45 м) and the pedestrian (1,7 м); the road
 *   (two lanes, 7 м) is seen a little from above, so its width is shortened. The distances along the road, the
 *   car and the pedestrian are to scale; nothing is exaggerated.
 * Time: real time. The pedestrian walks at 1,4 м/с; after the car has stopped he crosses the 7 м of the road in 5 с.
 */
import G7Styles from '../g7/G7Styles.astro';

const S = 9; // px per metre along the road
const X0 = 50; // x of the car's front at the moment the pedestrian comes up to the crossing (s = 0)
const x = (s: number) => X0 + S * s;
const FAR = 58; // far pavement top
const R0 = 70; // far edge of the road
const R1 = 118; // near edge of the road
const Z0 = 25; // the crossing, м from the car's front at t = 0
const Z1 = 29;
const AX = 160; // the scale axis
// the car in profile, its front at x = 0, the road at y = 0 (metres × S)
const car = `M${-4.3 * S} -2.2 V-7.4 L${-3.4 * S} -8 L${-2.75 * S} -13 H${-1.45 * S} L${-0.95 * S} -8.2 L-1.2 -7.4 Q0 -6.6 0 -4.6 V-2.2 Z`;
const glass = `M${-3.25 * S} -8.2 L${-2.68 * S} -12.2 H${-1.52 * S} L${-1.1 * S} -8.2 Z`;
---

<G7Styles />
<figure class="g7 g7--pic irp not-content" data-irp>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 216" role="img" aria-label="Машина едет со скоростью 60 километров в час. Пешеход подходит к переходу и ждёт на тротуаре. Водитель тормозит, но машина проезжает переход и останавливается только через 36,5 метра" data-svg>
			<text class="t-title" x="200" y="18" text-anchor="middle" data-status>Пешеход подходит к переходу</text>
			<text class="t-num" x="200" y="38" text-anchor="middle" data-read></text>
			<!-- the street -->
			<rect class="irp__pave" x="0" y={FAR} width="400" height={R0 - FAR}></rect>
			<rect class="irp__road" x="0" y={R0} width="400" height={R1 - R0}></rect>
			<rect class="irp__pave" x="0" y={R1} width="400" height="10"></rect>
			<line class="irp__kerb" x1="0" x2="400" y1={R0} y2={R0}></line>
			<line class="irp__kerb" x1="0" x2="400" y1={R1} y2={R1}></line>
			<line class="irp__mid" x1="0" x2={x(Z0) - 4} y1={(R0 + R1) / 2} y2={(R0 + R1) / 2}></line>
			<line class="irp__mid" x1={x(Z1) + 4} x2="400" y1={(R0 + R1) / 2} y2={(R0 + R1) / 2}></line>
			{Array.from({ length: 7 }, (_, i) => (
				<rect class="irp__zebra" x={x(Z0)} y={R0 + 1.7 + i * 6.86} width={(Z1 - Z0) * S} height="3.43" />
			))}
			<!-- the pedestrian -->
			<g data-man>
				<g class="irp__man">
					<path class="irp__leg" d="M0 0 L-1.4 -7" data-leg="a"></path>
					<path class="irp__leg" d="M0 0 L1.4 -7" data-leg="b"></path>
					<rect class="irp__body" x="-2" y="-12.6" width="4" height="6.2" rx="1.2"></rect>
					<circle class="irp__head" cx="0" cy="-14.2" r="1.6"></circle>
				</g>
			</g>
			<!-- the car -->
			<g data-car>
				<path class="irp__car" d={car}></path>
				<path class="irp__glass" d={glass}></path>
				<rect class="irp__stop" x={-4.3 * S - 0.6} y="-7" width="1.8" height="2" data-stop></rect>
				<circle class="irp__wheel" cx={-3.45 * S} cy="-2.8" r="2.8"></circle>
				<circle class="irp__wheel" cx={-0.85 * S} cy="-2.8" r="2.8"></circle>
			</g>
			<!-- the scale: the path of the car's front from the moment the pedestrian came up to the crossing -->
			<path class="ln-dash" d={`M${x(Z0)} ${R1 + 10} V${AX - 22} M${x(Z1)} ${R1 + 10} V${AX - 22}`}></path>
			<rect class="irp__zone" x={x(Z0)} y={AX - 3} width={(Z1 - Z0) * S} height="6"></rect>
			<line class="irp__axis" x1={x(0)} x2={x(38)} y1={AX} y2={AX}></line>
			{Array.from({ length: 8 }, (_, i) => (
				<line class="ln" x1={x(5 * i)} x2={x(5 * i)} y1={AX} y2={AX + (i % 2 ? 4 : 7)} />
			))}
			{[0, 10, 20, 30].map((m) => (
				<text class="t-small t-num" x={x(m)} y={AX + 18} text-anchor="middle">{m === 0 ? '0' : `${m} м`}</text>
			))}
			<rect class="irp__bar irp__bar--react" x={x(0)} y={AX - 4} width="0" height="8" rx="1.5" data-bar="react"></rect>
			<rect class="irp__bar irp__bar--brake" x={x(50 / 3)} y={AX - 4} width="0" height="8" rx="1.5" data-bar="brake"></rect>
			<text class="t-small t-halo irp__lab--react" x={x(50 / 6)} y={AX - 9} text-anchor="middle" data-lab="react">реакция 1 с — 16,7 м</text>
			<text class="t-small t-halo irp__lab--brake" x={x(50 / 3 + 9.92)} y={AX - 9} text-anchor="middle" data-lab="brake">торможение — 19,8 м</text>
			<g data-lab="total">
				<path class="ln" d={`M${x(0)} ${AX + 26} V${AX + 32} H${x(36.5)} V${AX + 26}`}></path>
				<text class="t-strong" x={x(18.25)} y={AX + 47} text-anchor="middle">до остановки 36,5 м</text>
			</g>
		</svg>
		<button type="button" class="g7__btn g7__again" data-again>Повторить</button>
	</div>
	<figcaption class="g7__caption">
		За секунду, пока водитель замечает пешехода и нажимает на тормоз, машина проезжает 16,7&nbsp;м, а затем по инерции ещё 19,8&nbsp;м. Движение не замедлено; расстояния, машина и пешеход нарисованы в одном масштабе, путь отсчитан от места, где была машина, когда пешеход подошёл к переходу.
	</figcaption>
</figure>

<style is:global>
	.irp__pave {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 60%, var(--g7-paper));
	}
	.irp__road {
		fill: var(--sl-color-gray-5);
	}
	.irp__kerb {
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.irp__mid {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 14 12;
	}
	.irp__zebra {
		fill: var(--sl-color-gray-1);
		opacity: 0.85;
	}
	.irp__zone {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 40%, transparent);
	}
	.irp__axis {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.irp__car {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.irp__glass {
		fill: var(--g7-paper);
		opacity: 0.85;
	}
	.irp__wheel {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.irp__stop {
		fill: var(--g7-red);
		opacity: 0.25;
	}
	.irp__stop.is-on {
		opacity: 1;
	}
	.irp__leg {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.irp__body {
		fill: var(--g7-gold);
	}
	.irp__head {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.irp__bar--react {
		fill: var(--g7-gold);
	}
	.irp__bar--brake {
		fill: var(--g7-red);
	}
	.irp svg .irp__lab--react {
		fill: var(--g7-gold);
		font-weight: 600;
	}
	.irp svg .irp__lab--brake {
		fill: var(--g7-red);
		font-weight: 600;
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';

	const S = 9;
	const X0 = 50;
	const LANE = 112;
	const FAR_FEET = 68; // the pedestrian's feet on the far pavement, at its edge
	const NEAR_FEET = 124;
	const ZX = X0 + S * 27; // the middle of the crossing
	const V = 60 / 3.6; // м/с
	const A = 7; // м/с²
	const REACT = 1; // с
	const TB = V / A; // с of braking
	const STOP = REACT + TB;
	const S_REACT = V * REACT;
	const S_STOP = S_REACT + (V * V) / (2 * A);
	const WALK = 1.4; // м/с
	const PRE = 2.5; // с before the pedestrian reaches the crossing
	const WAIT = 1.5; // с after the stop
	const CROSS = 7 / WALK; // с
	const HOLD = 2.5;
	const CYCLE = PRE + STOP + WAIT + CROSS + HOLD;

	// the car's path and speed (t from the moment the pedestrian reached the crossing)
	const path = (t: number) => (t <= REACT ? V * t : t <= STOP ? S_REACT + V * (t - REACT) - (A * (t - REACT) ** 2) / 2 : S_STOP);
	const speed = (t: number) => (t <= REACT ? V : t <= STOP ? V - A * (t - REACT) : 0);

	for (const root of document.querySelectorAll<HTMLElement>('[data-irp]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const carG = q<SVGGElement>('[data-car]');
		const stop = q<SVGRectElement>('[data-stop]');
		const man = q<SVGGElement>('[data-man]');
		const legA = q<SVGPathElement>('[data-leg="a"]');
		const legB = q<SVGPathElement>('[data-leg="b"]');
		const status = q<SVGTextElement>('[data-status]');
		const read = q<SVGTextElement>('[data-read]');
		const barR = q<SVGRectElement>('[data-bar="react"]');
		const barB = q<SVGRectElement>('[data-bar="brake"]');
		const labR = q<SVGTextElement>('[data-lab="react"]');
		const labB = q<SVGTextElement>('[data-lab="brake"]');
		const total = q<SVGGElement>('[data-lab="total"]');

		const draw = (c: number) => {
			const t = c - PRE; // < 0 before the pedestrian reaches the crossing
			const s = path(Math.max(0, t)) + Math.min(0, t) * V;
			carG.setAttribute('transform', `translate(${(X0 + S * s).toFixed(2)} ${LANE})`);
			stop.classList.toggle('is-on', t > REACT && t < STOP + WAIT);
			// the pedestrian: walks along the far pavement to the crossing, waits, then crosses after the stop
			let mx = ZX;
			let my = FAR_FEET;
			let walking = false;
			if (t < 0) {
				mx = ZX - WALK * S * t;
				walking = true;
			} else if (t > STOP + WAIT && t < STOP + WAIT + CROSS) {
				my = FAR_FEET + ((NEAR_FEET - FAR_FEET) * (t - STOP - WAIT)) / CROSS;
				walking = true;
			} else if (t >= STOP + WAIT + CROSS) my = NEAR_FEET;
			man.setAttribute('transform', `translate(${mx.toFixed(2)} ${my.toFixed(2)})`);
			const sw = walking ? 1.6 * Math.sin(c * 2 * Math.PI * 1.8) : 0;
			legA.setAttribute('d', `M${(-0.4 + sw).toFixed(2)} 0 L-0.8 -7`);
			legB.setAttribute('d', `M${(0.4 - sw).toFixed(2)} 0 L0.8 -7`);
			// texts
			if (t < 0) status.textContent = 'Пешеход подходит к переходу';
			else if (t < REACT) status.textContent = 'Пешеход у перехода. Водитель ещё не нажал на тормоз';
			else if (t < STOP) status.textContent = 'Водитель тормозит, а машина по инерции едет дальше';
			else if (t < STOP + WAIT) status.textContent = 'Машина остановилась только за переходом';
			else status.textContent = 'Пешеход подождал и теперь переходит дорогу';
			const tt = Math.min(Math.max(0, t), STOP);
			read.textContent =
				t < 0
					? `скорость ${Math.round(speed(0) * 3.6)} км/ч`
					: `время ${fmt(tt, 1)} с   ·   скорость ${Math.round(speed(tt) * 3.6)} км/ч   ·   путь ${fmt(path(tt), 1)} м`;
			// the scale bars grow with the car's path
			const p = t < 0 ? 0 : path(tt);
			barR.setAttribute('width', (S * Math.min(p, S_REACT)).toFixed(2));
			barB.setAttribute('width', (S * Math.max(0, p - S_REACT)).toFixed(2));
			labR.setAttribute('opacity', t >= REACT ? '1' : '0');
			labB.setAttribute('opacity', t >= STOP ? '1' : '0');
			total.setAttribute('opacity', t >= STOP ? '1' : '0');
		};

		let c = 0;
		const wake = loop(root, (dt) => {
			c += dt;
			if (c >= CYCLE) c = 0;
			draw(c);
			return true;
		});
		q('[data-again]').addEventListener('click', () => {
			c = 0;
			draw(c);
			wake();
		});
		draw(c);
	}
</script>
