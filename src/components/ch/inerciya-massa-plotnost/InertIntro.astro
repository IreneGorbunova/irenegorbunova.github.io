---
/**
 * Two short looping opening scenes of «Инерция. Масса. Плотность». No terms of the chapter in the pictures.
 * Bus: a bus rolls at 40 км/ч with a standing passenger and brakes hard. The passenger's body keeps moving and
 *   leans forward (up to 22°), then straightens when the bus has stopped. The speedometer shows the bus's speed.
 * Cubes: two cubes of the same size, wooden and iron, are put on the pans of a balance: the iron one goes down.
 *   (Iron is about eleven times denser than dry oak: 7,8 against 0,7 г/см³.)
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-inertintro>
	<div class="intro__card" data-scene="bus">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Автобус резко тормозит, и стоящий пассажир наклоняется вперёд">
			<rect class="ii-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="ii-road" x="0" y="196" width="360" height="44"></rect>
			<g data-marks>{Array.from({ length: 10 }, (_, i) => <rect class="ii-dash" x={i * 60} y="214" width="30" height="4" />)}</g>
			<g data-bus>
				<rect class="ii-bus" x="0" y="96" width="250" height="92" rx="12"></rect>
				<rect class="ii-glass" x="14" y="108" width="222" height="48" rx="6"></rect>
				<line class="ii-rail" x1="20" y1="116" x2="230" y2="116"></line>
				<g data-man>
					<path class="ii-leg" d="M-5 0 V-22 M5 0 V-22"></path>
					<path class="ii-torso" d="M-8 -22 h16 v-22 h-16 Z"></path>
					<circle class="ii-head" cx="0" cy="-52" r="7"></circle>
					<path class="ii-arm" data-arm d="M4 -40 L10 -66"></path>
				</g>
				<circle class="ii-wheel" cx="54" cy="190" r="15"></circle>
				<circle class="ii-wheel" cx="196" cy="190" r="15"></circle>
				<rect class="ii-stop" data-stop x="-2" y="150" width="6" height="14" rx="2"></rect>
			</g>
			<rect class="ii-pill" x="10" y="10" width="120" height="42" rx="9"></rect>
			<text class="ii-small" x="20" y="27">скорость автобуса</text>
			<text class="ii-num" x="20" y="45" data-speed>40 км/ч</text>
		</svg>
		<div class="intro__foot">
			<p>
				Автобус резко тормозит — и пассажиров{' '}
				<More term="бросает вперёд">
					На самом деле пассажиров никто не толкает. Автобус замедляется, а тело пассажира продолжает двигаться вперёд с прежней скоростью, пока его не остановят поручень или пол под ногами. Об этом — в разделе{' '}
					<a href="#инерция">«Инерция»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="cubes">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Одинаковые по размеру кубики, деревянный и железный, кладут на чаши весов. Чаша с железным кубиком опускается">
			<rect class="ii-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="ii-table" x="0" y="214" width="360" height="26"></rect>
			<path class="ii-stand" d="M180 70 V206 M130 214 H230 M160 214 L180 200 L200 214"></path>
			<g data-beam><line class="ii-beam" x1="60" y1="70" x2="300" y2="70"></line></g>
			<circle class="ii-pivot" cx="180" cy="70" r="5"></circle>
			{['l', 'r'].map((k) => (
				<g data-pan={k}>
					<path class="ii-string" d="M0 0 L-34 66 M0 0 L34 66"></path>
					<path class="ii-pan" d="M-42 66 H42 q-6 14 -42 14 q-36 0 -42 -14 Z"></path>
					<rect class={k === 'l' ? 'ii-wood' : 'ii-iron'} data-cube={k} x="-18" y="30" width="36" height="36" rx="2"></rect>
				</g>
			))}
			<text class="ii-label" x="60" y="26" text-anchor="middle">дерево</text>
			<text class="ii-label" x="300" y="26" text-anchor="middle">железо</text>
		</svg>
		<div class="intro__foot">
			<p>
				Кубики одинакового размера — деревянный и железный — положили на весы.{' '}
				<More term="Железный перетянул">
					Объёмы кубиков равны, а массы разные: кубический сантиметр железа примерно в одиннадцать раз тяжелее кубического сантиметра сухого дуба. Величину, которая показывает массу единицы объёма вещества, называют плотностью. Об этом — в разделе{' '}
					<a href="#плотность">«Плотность»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-inertintro] .ii-sky {
		fill: var(--sl-color-bg);
	}
	[data-inertintro] .ii-road {
		fill: var(--sl-color-gray-5);
	}
	[data-inertintro] .ii-dash {
		fill: var(--sl-color-gray-2);
	}
	[data-inertintro] .ii-bus {
		fill: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
	}
	[data-inertintro] .ii-glass {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-inertintro] .ii-rail {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-inertintro] .ii-leg,
	[data-inertintro] .ii-arm {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-inertintro] .ii-torso {
		fill: var(--ig-vx);
	}
	[data-inertintro] .ii-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-inertintro] .ii-wheel {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-1);
		stroke-width: 3;
	}
	[data-inertintro] .ii-stop {
		fill: var(--ig-vy);
		opacity: 0.25;
	}
	[data-inertintro] .ii-pill {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-inertintro] .ii-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-inertintro] .ii-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-inertintro] .ii-table {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-inertintro] .ii-stand {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-inertintro] .ii-beam {
		stroke: var(--ig-v);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-inertintro] .ii-pivot {
		fill: var(--sl-color-gray-1);
	}
	[data-inertintro] .ii-string {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-inertintro] .ii-pan {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-inertintro] .ii-wood {
		fill: hsl(30, 50%, 52%);
		stroke: hsl(28, 50%, 30%);
		stroke-width: 1.2;
	}
	[data-inertintro] .ii-iron {
		fill: hsl(215, 10%, 52%);
		stroke: hsl(215, 14%, 26%);
		stroke-width: 1.2;
	}
	[data-inertintro] .ii-label {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-inertintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bus"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const marks = $<SVGGElement>('[data-marks]');
			const man = $<SVGGElement>('[data-man]');
			const stop = $<SVGRectElement>('[data-stop]');
			const speed = $<SVGTextElement>('[data-speed]');
			const bus = $<SVGGElement>('[data-bus]');
			bus.setAttribute('transform', 'translate(60 0)');
			let road = 0;
			let last = 0;
			scene(card, 7, (x) => {
				// the speed: steady, then braking to a stop between 45 % and 70 % of the run
				const k = 1 - ease((x - 0.45) / 0.25);
				speed.textContent = `${Math.round(40 * k)} км/ч`;
				// the road marks run back at the bus's speed
				const dx = x < last ? 0 : x - last;
				last = x;
				road = x === 0 ? 0 : (road + dx * 900 * k) % 60;
				marks.setAttribute('transform', `translate(${(-road).toFixed(1)} 0)`);
				// the passenger leans forward while the bus slows down, and straightens after the stop
				const lean = 22 * Math.sin(Math.PI * Math.min(1, Math.max(0, (x - 0.45) / 0.4)));
				man.setAttribute('transform', `translate(120 188) rotate(${lean.toFixed(1)})`);
				stop.style.opacity = x > 0.45 && x < 0.72 ? '1' : '0.25';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="cubes"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const beam = $<SVGGElement>('[data-beam]');
			const pans = { l: $<SVGGElement>('[data-pan="l"]'), r: $<SVGGElement>('[data-pan="r"]') };
			const cubes = { l: $<SVGRectElement>('[data-cube="l"]'), r: $<SVGRectElement>('[data-cube="r"]') };
			scene(card, 6, (x) => {
				// the cubes come down onto the pans (0…0,3), then the beam tilts to the iron cube (0,3…0,7)
				const put = ease(x / 0.3);
				const u = (x - 0.3) / 0.4;
				const tilt = u <= 0 ? 0 : 11 * (1 - Math.exp(-4 * u) * Math.cos(7 * u));
				const rad = (tilt * Math.PI) / 180;
				beam.setAttribute('transform', `rotate(${tilt.toFixed(2)} 180 70)`);
				pans.l.setAttribute('transform', `translate(${(180 - 120 * Math.cos(rad)).toFixed(1)} ${(70 - 120 * Math.sin(rad)).toFixed(1)})`);
				pans.r.setAttribute('transform', `translate(${(180 + 120 * Math.cos(rad)).toFixed(1)} ${(70 + 120 * Math.sin(rad)).toFixed(1)})`);
				for (const k of ['l', 'r'] as const) cubes[k].setAttribute('y', (30 - 60 * (1 - put)).toFixed(1));
			});
		}
	}
</script>
