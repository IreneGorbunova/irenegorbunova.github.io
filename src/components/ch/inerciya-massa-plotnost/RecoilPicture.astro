---
/**
 * Picture «Взаимодействие: лодка и отдача»: two panels on one clock (1 s of the start frame, 2 s of motion, 3 s of
 * the end frame). Both bodies were at rest and pushed each other apart; the push is taken as instant. In each panel
 * brackets grow from the start positions, so the paths covered in the same time show the ratio of the speeds:
 * m₁/m₂ = υ₂/υ₁.
 *
 * Лодка — the numbers of task 1 of the chapter: a boy of 40 кг jumps from a boat of 80 кг at rest onto a pier with a
 *   horizontal speed of 2 м/с; the boat gets 1 м/с away from the shore (40 · 2 = 80 · 1). Side view, 40 px per метр,
 *   the boat 3 м long, the boy 1,5 м tall (the shared people kit). The boy's jump: up 2,95 м/с, so that he lands after 0,5 с on the pier,
 *   0,25 м above the boat's floor (apex 0,44 м); in 0,5 с he moves 1 м forward and the boat 0,5 м back. The
 *   resistance of the water over half a second is small and is neglected. The motion of 0,5 с is slowed four times.
 * Пушка — a toy spring cannon on a cart instead of a rifle: nobody aims at anything, and a cart on wheels can really
 *   roll back, so the recoil is seen as motion (a rifle's recoil goes into the shooter's shoulder). Cannon with its
 *   cart 250 г, a rubber ball of 25 г (3,5 см across) shot out horizontally at 3 м/с; the cannon rolls back at
 *   0,3 м/с (0,025 · 3 = 0,25 · 0,3). Side view, 4 px per сантиметр. In 0,1 с the ball flies 30 см forward and
 *   falls 4,9 см (it is still above the table), the cannon rolls 3 см back; the friction of the wheels over 0,1 с is
 *   neglected. The motion of 0,1 с is slowed twenty times.
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

const WY = 180; // water level (a) and table (b)
// (a) boat, 40 px per м
const BOAT0 = 56; // stern at the start
const BOY0 = 154; // the boy's feet at the start
const PIER = 186;
const hull = 'M0 -12 H120 L104 6 H8 Z';
// (b) cannon, 4 px per см
const CART0 = 22;
const BALL0 = CART0 + 55;
---

<G7Styles />
<KitStyles />
<figure class="g7 g7--pic rcl not-content" data-rcl>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 240 282" role="img" aria-label="Мальчик массой 40 килограммов прыгает из лодки массой 80 килограммов на причал со скоростью 2 метра в секунду, а лодка отплывает от берега со скоростью 1 метр в секунду">
			<text class="t-title" x="120" y="18" text-anchor="middle">Мальчик прыгает на берег</text>
			<text class="t-small t-num" x="120" y="33" text-anchor="middle" data-clock="a"></text>
			<!-- water and the pier -->
			<rect class="rcl__water" x="0" y={WY + 8} width={PIER + 4} height="30"></rect>
			<path class="rcl__wave" d="M8 192 q6 -3 12 0 t12 0 M70 204 q6 -3 12 0 t12 0 M130 196 q6 -3 12 0 t12 0"></path>
			<rect class="rcl__ground" x={PIER + 4} y={WY - 10} width={240 - PIER - 4} height="50"></rect>
			<rect class="rcl__plank" x={PIER} y={WY - 12} width={240 - PIER} height="5"></rect>
			<rect class="rcl__plank" x={PIER + 2} y={WY - 7} width="5" height="45"></rect>
			<text class="t-small" x="214" y={WY + 14} text-anchor="middle">берег</text>
			<!-- the boy (drawn before the boat: its side hides his feet) -->
			<g data-boy><g data-pose></g></g>
			<g data-boat>
				<path class="rcl__boat" d={hull}></path>
				<line class="rcl__rim" x1="0" x2="120" y1="-12" y2="-12"></line>
			</g>
			<rect class="rcl__water rcl__water--front" x="0" y={WY} width={PIER + 4} height="8"></rect>
			<!-- brackets: paths in the same time -->
			<path class="ln-dash" d={`M${BOY0} 80 V94`}></path>
			<path class="rcl__br rcl__br--blue" d="" data-br="boy"></path>
			<text class="t-small t-num t-halo t-blue" x={BOY0 + 20} y="80" text-anchor="middle" data-brl="boy"></text>
			<path class="ln-dash" d={`M${BOAT0} 146 V160`}></path>
			<path class="rcl__br rcl__br--gold" d="" data-br="boat"></path>
			<text class="t-small t-num t-halo t-gold" x={BOAT0} y="146" text-anchor="middle" data-brl="boat"></text>
			<text class="t-strong t-num t-blue" x="12" y="250">мальчик 40 кг — 2 м/с</text>
			<text class="t-strong t-num t-gold" x="12" y="266">лодка 80 кг — 1 м/с</text>
			<text class="t-small" x="120" y="280" text-anchor="middle">вдвое массивнее — вдвое медленнее</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 240 282" role="img" aria-label="Пушка-игрушка массой 250 граммов на тележке выстреливает мячик массой 25 граммов со скоростью 3 метра в секунду и откатывается назад со скоростью 0,3 метра в секунду">
			<text class="t-title" x="120" y="18" text-anchor="middle">Пушка-игрушка стреляет</text>
			<text class="t-small t-num" x="120" y="33" text-anchor="middle" data-clock="b"></text>
			<rect class="rcl__table" x="0" y={WY} width="240" height="10"></rect>
			<!-- the ball (drawn before the cannon: it starts inside the barrel) -->
			<circle class="rcl__ball" cx={BALL0} cy={WY - 30} r="7" data-ball></circle>
			<g data-cannon>
				<rect class="rcl__cart" x="0" y="-20" width="52" height="7" rx="2"></rect>
				<path class="rcl__cannon" d="M6 -40 H62 V-20 H6 A10 10 0 0 1 6 -40 Z"></path>
				<rect class="rcl__cannon" x="58" y="-42" width="6" height="24" rx="1.5"></rect>
				{[12, 40].map((cx) => (
					<g data-wheel={cx}>
						<circle class="rcl__wheel" cx="0" cy="0" r="8"></circle>
						<path class="rcl__spoke" d="M0 -7 V7 M-7 0 H7"></path>
					</g>
				))}
				<g class="rcl__puff" data-puff>
					<path d="M68 -36 l7 -5 M69 -30 h9 M68 -24 l7 5"></path>
				</g>
			</g>
			<path class="ln-dash" d={`M${BALL0} 114 V128`}></path>
			<path class="rcl__br rcl__br--blue" d="" data-br="ball"></path>
			<text class="t-small t-num t-halo t-blue" x={BALL0 + 60} y="114" text-anchor="middle" data-brl="ball"></text>
			<path class="ln-dash" d={`M${CART0} 114 V128`}></path>
			<path class="rcl__br rcl__br--gold" d="" data-br="cart"></path>
			<text class="t-small t-num t-halo t-gold" x={CART0} y="114" text-anchor="middle" data-brl="cart"></text>
			<text class="t-strong t-num t-blue" x="12" y="250">мячик 25 г — 3 м/с</text>
			<text class="t-strong t-num t-gold" x="12" y="266">пушка 250 г — 0,3 м/с</text>
			<text class="t-small" x="120" y="280" text-anchor="middle">в 10 раз массивнее — в 10 раз медленнее</text>
		</svg>
	</div>
	<div class="rcl__row">
		<button type="button" class="g7__btn" data-again>Повторить</button>
	</div>
	<figcaption class="g7__caption">
		Мальчик и лодка, мячик и пушка отталкиваются друг от друга: лёгкое тело получает большую скорость, тяжёлое — меньшую. Движение замедлено: прыжок — в 4 раза, выстрел — в 20 раз; скобки показывают пути за одно и то же время.
	</figcaption>
</figure>

<style is:global>
	.rcl__water {
		fill: var(--g7-water);
	}
		.rcl__wave {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 1;
		opacity: 0.7;
	}
	.rcl__ground {
		fill: var(--g7-ground);
	}
	.rcl__plank {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.rcl__table {
		fill: var(--g7-wood);
	}
	.rcl__boat {
		fill: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.rcl__rim {
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.rcl__ball {
		fill: var(--g7-blue);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.rcl__cannon {
		fill: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.rcl__cart {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.rcl__wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.rcl__spoke {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.rcl__puff path {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.rcl__br {
		fill: none;
		stroke-width: 1.4;
	}
	.rcl__br--blue {
		stroke: var(--g7-blue);
	}
	.rcl__br--gold {
		stroke: var(--g7-gold);
	}
	.rcl__row {
		display: flex;
		margin-top: 0.6rem;
	}
</style>

<script>
	import { fmt, fmtTrim, loop } from '../g7/kit';
	import { figure } from '@components/people/body';

	const WY = 180;
	const G = 9.8;
	// (a)
	const SA = 40; // px per м
	const BOAT0 = 56;
	const BOY0 = 154;
	const FEET = WY - 2; // the boat's floor
	const TA = 0.5; // с of real time shown
	const VBOY = 2; // м/с
	const VBOAT = 1;
	const VUP = 2.95; // м/с, the boy's vertical push: lands on the pier (0,25 м higher) after 0,5 с
	// (b)
	const SB = 400; // px per м
	const CART0 = 22;
	const BALL0 = CART0 + 55;
	const TB = 0.1;
	const VBALL = 3;
	const VCART = 0.3;
	const WHEEL_R = 0.02; // м
	// the clock
	const PRE = 1;
	const RUN = 2;
	const HOLD = 3;

	const bracket = (x0: number, x1: number, y: number, up: boolean) => {
		const d = up ? -5 : 5;
		return Math.abs(x1 - x0) < 0.5 ? '' : `M${x0.toFixed(2)} ${y + d} V${y} H${x1.toFixed(2)} V${y + d}`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-rcl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const boy = q<SVGGElement>('[data-boy]');
		const pose = q<SVGGElement>('[data-pose]');
		// the boy, 1,5 м (the shared people kit, a teenager's proportions), drawn in his group with the feet at (0, 0)
		const S = SA / 100;
		const H = 150;
		const U = S * H;
		const ANK = -7 * S * (H / 172);
		const kid = figure(pose, { s: S, H, age: 'teen', clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'boy' });
		/** c: the crouch before the push (0…1), a: the tuck in the air (0…1) */
		const poseBoy = (c: number, a: number, planted: boolean) => {
			const hipY = -(0.505 * U - 0.13 * U * c);
			const lift = 0.09 * U * a; // the feet come up under him in the air
			const arm = Math.PI / 2 + 0.05 + 0.7 * c - 1.6 * a; // the arms swing back, then forward
			kid.pose({
				hip: { x: -0.03 * U * c, y: hipY },
				lean: 0.25 * c + 0.12 * a,
				head: -0.1 * c,
				ankles: [
					{ x: 2 + 0.02 * U * a, y: ANK - lift },
					{ x: -2 + 0.01 * U * a, y: ANK - lift },
				],
				feet: [0.35 * a, 0.35 * a],
				planted: [planted, planted],
				hands: [
					{ arm: [arm, 0.25 + 0.3 * a], pose: 'relaxed' },
					{ arm: [arm + 0.15, 0.3 + 0.3 * a], pose: 'relaxed' },
				],
			});
		};
		const boat = q<SVGGElement>('[data-boat]');
		const ball = q<SVGCircleElement>('[data-ball]');
		const cannon = q<SVGGElement>('[data-cannon]');
		const wheels = [...root.querySelectorAll<SVGGElement>('[data-wheel]')];
		const puff = q<SVGGElement>('[data-puff]');
		const br = (k: string) => [q<SVGPathElement>(`[data-br="${k}"]`), q<SVGTextElement>(`[data-brl="${k}"]`)] as const;
		const [brBoy, lBoy] = br('boy');
		const [brBoat, lBoat] = br('boat');
		const [brBall, lBall] = br('ball');
		const [brCart, lCart] = br('cart');
		const clockA = q<SVGTextElement>('[data-clock="a"]');
		const clockB = q<SVGTextElement>('[data-clock="b"]');

		const draw = (u: number, before: number) => {
			// (a) the boy and the boat, real time ta
			const ta = TA * u;
			const bx = BOY0 + SA * VBOY * ta;
			const by = FEET - SA * (VUP * ta - (G * ta * ta) / 2);
			boy.setAttribute('transform', `translate(${bx.toFixed(2)} ${by.toFixed(2)})`);
			// a short crouch just before the jump (the knees bend, the arms swing back), the arms forward in the air
			const crouch = u === 0 && before > 0.6 ? Math.sin((Math.PI * (before - 0.6)) / 0.4) : 0;
			poseBoy(crouch, Math.sin(Math.PI * u), u === 0 || u === 1);
			const sx = BOAT0 - SA * VBOAT * ta;
			boat.setAttribute('transform', `translate(${sx.toFixed(2)} ${WY})`);
			brBoy.setAttribute('d', bracket(BOY0, bx, 87, false));
			lBoy.setAttribute('x', ((BOY0 + bx) / 2).toFixed(2));
			lBoy.textContent = u > 0 ? `${fmtTrim(VBOY * ta, 1)} м` : '';
			brBoat.setAttribute('d', bracket(BOAT0, sx, 153, false));
			lBoat.setAttribute('x', ((BOAT0 + sx) / 2).toFixed(2));
			lBoat.textContent = u > 0 ? `${fmtTrim(VBOAT * ta, 1)} м` : '';
			clockA.textContent = `прошло ${fmt(ta, 2)} с · замедлено в 4 раза`;

			// (b) the ball and the cannon, real time tb
			const tb = TB * u;
			const fired = u > 0;
			const ballX = BALL0 + SB * VBALL * tb;
			ball.setAttribute('cx', ballX.toFixed(2));
			ball.setAttribute('cy', (WY - 30 + (SB * G * tb * tb) / 2).toFixed(2));
			const cx = CART0 - SB * VCART * tb;
			cannon.setAttribute('transform', `translate(${cx.toFixed(2)} ${WY})`);
			const turn = -((VCART * tb) / WHEEL_R) * (180 / Math.PI);
			for (const w of wheels) w.setAttribute('transform', `translate(${w.dataset.wheel} -8) rotate(${turn.toFixed(1)})`);
			puff.setAttribute('opacity', fired && tb < 0.02 ? '1' : '0');
			brBall.setAttribute('d', bracket(BALL0, ballX, 121, false));
			lBall.setAttribute('x', ((BALL0 + ballX) / 2).toFixed(2));
			lBall.textContent = fired ? `${Math.round(100 * VBALL * tb)} см` : '';
			brCart.setAttribute('d', bracket(CART0, cx, 121, false));
			lCart.setAttribute('x', ((CART0 + cx) / 2).toFixed(2));
			lCart.textContent = fired ? `${fmtTrim(100 * VCART * tb, 1)} см` : '';
			clockB.textContent = `прошло ${fmt(tb, 2)} с · замедлено в 20 раз`;
		};

		let t = 0;
		const cycle = PRE + RUN + HOLD;
		const show = () => draw(Math.min(1, Math.max(0, (t - PRE) / RUN)), t / PRE);
		const wake = loop(root, (dt) => {
			t += dt;
			if (t >= cycle) t = 0;
			show();
			return true;
		});
		q('[data-again]').addEventListener('click', () => {
			t = 0;
			show();
			wake();
		});
		show();
	}
</script>
