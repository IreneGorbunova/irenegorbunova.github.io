---
/**
 * Picture «Плотность сплава»: a gold and a silver ingot are melted together in a crucible and poured into a mould.
 *
 * Numbers (table densities of the chapter): gold ρ₁ = 19,3 г/см³, V₁ = 10 см³ → m₁ = 19,3 · 10 = 193 г; silver
 * ρ₂ = 10,5 г/см³, V₂ = 10 см³ → m₂ = 10,5 · 10 = 105 г. The alloy: m = 193 + 105 = 298 г, V = 10 + 10 = 20 см³
 * (gold and silver mix almost without a change of volume), ρ = 298 : 20 = 14,9 г/см³. With equal volumes this is
 * exactly the mean of the two densities: (19,3 + 10,5) : 2 = 14,9; on the number line below the drawing it lies
 * 4,4 г/см³ from each.
 *
 * Scale: 12 px per см for the three ingots. Each ingot of 10 см³ is 4 × 2,5 × 1 см (front 48 × 12 px, the top face in
 * an oblique view with the depth halved); the alloy fills the mould, 4 см wide inside, to 2 см (48 × 24 px), so its
 * front area is the sum of the two fronts. The crucible and the mould are drawn in section (cut-away). In the crucible
 * the liquid keeps the same drawn area (1152 px²) and a level surface: its outline is the crucible's inside, turned
 * with the crucible and cut by a horizontal line found by bisection. The liquid leaves over the lip only when the
 * tilted crucible can no longer hold it, and the mould fills by exactly the area that has left.
 *
 * Time: one cycle is 16,6 s; melting (minutes in reality) takes 3 s. Gold melts at 1064 °C and silver at 962 °C, so
 * the step text says «около 1100 °C». The caption says what is to scale and what is sped up.
 */
import katex from 'katex';
import G7Styles from '../g7/G7Styles.astro';

const k = (s: string) => katex.renderToString(s, { throwOnError: false });
const S = 12; // px per см
const L = 4 * S; // ingot length
const H = 1 * S; // ingot height
const D = (2.5 * S) / 2 / Math.SQRT2; // oblique depth, x and y
const AU = { x: 20, y: 64 };
const AG = { x: 20, y: 132 };
const ingot = (x: number, y: number, h: number) =>
	`M${x} ${y} L${x + D} ${y - D} H${x + L + D} V${y + h - D} L${x + L} ${y + h} H${x} Z M${x + L} ${y + h} V${y}`;
const top = (x: number, y: number) => `M${x} ${y} L${x + D} ${y - D} H${x + L + D} L${x + L} ${y} Z`;
// crucible (local coordinates), the pivot is the outer top right corner
const IN = 'M132 92 H202 L192 140 H142 Z';
const OUT = 'M125 92 H209 L198 147 H136 Z';
// density number line: 10…20 г/см³
const nx = (r: number) => 22 + (r - 10) * 24;
---

<G7Styles />
<figure class="g7 g7--pic mix not-content" data-mixpic>
	<svg class="g7__svg mix__svg" viewBox="0 0 340 240" role="img" aria-label="Слиток золота и слиток серебра расплавляют в тигле и выливают в форму: получается один слиток сплава массой 298 граммов и объёмом 20 кубических сантиметров">
		<text class="t-title" x="8" y="234" data-step>1. Слитки кладут в тигель</text>

		<!-- the burner and the tripod -->
		<path class="mix__stand" d="M138 148 H196 M143 148 L136 218 M191 148 L198 218"></path>
		<path class="mix__flame" d="M167 204 C152 192 160 176 167 160 C174 176 182 192 167 204 Z" data-flame></path>
		<path class="mix__flame-in" d="M167 204 C160 196 163 186 167 178 C171 186 174 196 167 204 Z" data-flame2></path>
		<rect class="mix__steel" x="162" y="204" width="10" height="6"></rect>
		<rect class="mix__steel" x="150" y="210" width="34" height="8" rx="2"></rect>

		<!-- the mould in section -->
		<path class="mix__steel" d="M226 176 H232 V212 H280 V176 H286 V218 H226 Z"></path>
		<rect class="mix__hollow" x="232" y="176" width="48" height="36"></rect>
		<rect class="mix__melt" x="232" y="212" width="48" height="0" data-mfill></rect>
		<rect class="mix__alloy" x="232" y="188" width="48" height="24" opacity="0" data-mcool></rect>
		<line class="ln" x1="4" x2="336" y1="218" y2="218"></line>
		<text class="t-small" x="256" y="234" text-anchor="middle">форма</text>
		<text class="t-small" x="122" y="86" text-anchor="end" data-crulabel>тигель</text>

		<!-- the crucible: its inside, then the ingots and the liquid, then its walls on top -->
		<g data-cru><path class="mix__hollow" d={IN}></path></g>
		<g data-au>
			<path class="mix__au" d={ingot(AU.x, AU.y, H)}></path>
			<path class="mix__face" d={top(AU.x, AU.y)}></path>
		</g>
		<g data-ag>
			<path class="mix__ag" d={ingot(AG.x, AG.y, H)}></path>
			<path class="mix__face" d={top(AG.x, AG.y)}></path>
		</g>
		<path class="mix__melt" d="" data-liq></path>
		<rect class="mix__melt" x="0" y="0" width="3" height="0" data-stream></rect>
		<g data-cru><path class="mix__clay" d={`${OUT} ${IN}`} fill-rule="evenodd"></path></g>

		<g data-aulabel>
			<text class="t-strong" x={AU.x} y="31">золото</text>
			<text class="t-small t-num" x={AU.x} y="45">193 г · 10 см³</text>
		</g>
		<g data-aglabel>
			<text class="t-strong" x={AG.x} y="99">серебро</text>
			<text class="t-small t-num" x={AG.x} y="113">105 г · 10 см³</text>
		</g>
		<g opacity="0" data-alloylabel>
			<text class="t-strong" x="256" y="150" text-anchor="middle">сплав</text>
			<text class="t-small t-num" x="256" y="164" text-anchor="middle">298 г · 20 см³</text>
		</g>
	</svg>

	<div class="mix__eq">
		<div class="mix__card mix__card--au">
			<b>Золото</b>
			<span><i>m</i><sub>1</sub> = 193&nbsp;г</span>
			<span><i>V</i><sub>1</sub> = 10&nbsp;см³</span>
		</div>
		<span class="mix__op">+</span>
		<div class="mix__card mix__card--ag">
			<b>Серебро</b>
			<span><i>m</i><sub>2</sub> = 105&nbsp;г</span>
			<span><i>V</i><sub>2</sub> = 10&nbsp;см³</span>
		</div>
		<span class="mix__op">=</span>
		<div class="mix__card mix__card--alloy">
			<b>Сплав</b>
			<span><i>m</i> = 298&nbsp;г</span>
			<span><i>V</i> = 20&nbsp;см³</span>
		</div>
	</div>

	<p class="mix__calc">
		<span set:html={k('\\rho = \\dfrac{m_1 + m_2}{V_1 + V_2}')}></span>
		<span set:html={k('= \\dfrac{193~\\text{г} + 105~\\text{г}}{10~\\text{см}^3 + 10~\\text{см}^3}')}></span>
		<span set:html={k('= \\dfrac{298~\\text{г}}{20~\\text{см}^3}')}></span>
		<span set:html={k('= 14{,}9~\\text{г/см}^3')}></span>
	</p>

	<svg class="g7__svg mix__line" viewBox="0 0 320 74" role="img" aria-label="Плотность сплава 14,9 грамма на кубический сантиметр лежит ровно посередине между плотностью серебра 10,5 и плотностью золота 19,3">
		<line class="ln" x1={nx(10)} x2={nx(20)} y1="50" y2="50"></line>
		{Array.from({ length: 11 }, (_, i) => 10 + i).map((r) => <line class="ln" x1={nx(r)} x2={nx(r)} y1={r % 5 === 0 ? 45 : 47} y2={r % 5 === 0 ? 55 : 53}></line>)}
		{[10, 15, 20].map((r) => <text class="t-small" x={nx(r)} y="68" text-anchor="middle">{r}</text>)}
		<text class="t-small" x={nx(20) + 14} y="68">г/см³</text>
		<path class="mix__span" d={`M${nx(10.5)} 34 H${nx(14.9)} M${nx(14.9)} 34 H${nx(19.3)} M${nx(10.5)} 30 V38 M${nx(14.9)} 30 V38 M${nx(19.3)} 30 V38`}></path>
		<text class="t-small t-halo" x={(nx(10.5) + nx(14.9)) / 2} y="28" text-anchor="middle">4,4</text>
		<text class="t-small t-halo" x={(nx(14.9) + nx(19.3)) / 2} y="28" text-anchor="middle">4,4</text>
		<circle class="mix__ag" cx={nx(10.5)} cy="50" r="5"></circle>
		<circle class="mix__alloy" cx={nx(14.9)} cy="50" r="6"></circle>
		<circle class="mix__au" cx={nx(19.3)} cy="50" r="5"></circle>
		<text class="t-small" x="2" y="14">серебро 10,5</text>
		<text class="t-strong" x={nx(14.9)} y="14" text-anchor="middle">сплав 14,9</text>
		<text class="t-small" x="318" y="14" text-anchor="end">золото 19,3</text>
	</svg>
	<p class="g7__note mix__note">Объёмы золота и серебра одинаковые, поэтому плотность сплава — ровно посередине между их плотностями.</p>

	<figcaption class="g7__caption">
		Три слитка нарисованы в одном масштабе, тигель и форма — в разрезе. Плавка, которая длится минуты, здесь занимает 3&nbsp;секунды.
	</figcaption>
</figure>

<style is:global>
	.mix {
		--mix-ag: color-mix(in oklab, var(--sl-color-gray-2) 82%, var(--ig-vx));
		--mix-alloy: color-mix(in oklab, var(--g7-gold) 55%, var(--mix-ag));
		--mix-hot: color-mix(in oklab, var(--g7-gold) 62%, var(--g7-red));
	}
	:root[data-theme='light'] .mix {
		--mix-ag: color-mix(in oklab, var(--sl-color-gray-4) 80%, var(--ig-vx));
	}
	.mix__svg {
		max-width: 30rem;
		margin-inline: auto;
	}
	.mix__au {
		fill: var(--g7-gold);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mix__ag {
		fill: var(--mix-ag);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mix__alloy {
		fill: var(--mix-alloy);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.mix__face {
		fill: var(--g7-paper);
		fill-opacity: 0.35;
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mix__melt {
		fill: var(--mix-hot);
	}
	.mix__hollow {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 45%, var(--g7-paper));
	}
	.mix__clay {
		fill: color-mix(in oklab, var(--g7-red) 16%, var(--sl-color-gray-4));
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mix__steel {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mix__stand {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.mix__flame {
		fill: var(--g7-red);
		opacity: 0.85;
	}
	.mix__flame-in {
		fill: var(--g7-gold);
	}
	.mix__span {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.mix__eq {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 0.4rem;
		max-width: 30rem;
		margin: 0.75rem auto 0;
	}
	.mix__card {
		display: grid;
		gap: 0.1rem;
		padding: 0.4rem 0.5rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.mix__card b {
		color: var(--sl-color-white);
	}
	.mix__card--au {
		box-shadow: inset 3px 0 0 var(--g7-gold);
	}
	.mix__card--ag {
		box-shadow: inset 3px 0 0 var(--mix-ag);
	}
	.mix__card--alloy {
		box-shadow: inset 3px 0 0 var(--mix-alloy);
		background: color-mix(in oklab, var(--ig-v) 12%, var(--sl-color-gray-6));
	}
	.mix__op {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.mix__calc {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.25rem 0.4rem;
		max-width: 30rem;
		margin: 0.75rem auto 0;
		padding: 0.4rem 0.6rem;
		border-radius: 0.6rem;
		background: color-mix(in srgb, var(--g7-blue) 14%, transparent);
		color: var(--sl-color-white);
	}
	.mix__calc .katex {
		font-size: 1.05em;
	}
	.mix__line {
		max-width: 26rem;
		margin: 0.75rem auto 0;
	}
	.mix__note {
		max-width: 30rem;
		margin: 0.3rem auto 0;
		text-align: center;
	}
	@container (max-width: 24rem) {
		.mix__card {
			padding: 0.35rem 0.4rem;
			font-size: var(--sl-text-xs);
		}
		.mix__op {
			font-size: 1.1rem;
		}
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	type P = [number, number];
	const S = 12;
	const A0 = 4 * S * 2 * S; // the drawn area of the alloy, px² (48 × 24)
	const INNER: P[] = [
		[132, 92],
		[202, 92],
		[192, 140],
		[142, 140],
	];
	const PIV: P = [209, 92]; // the crucible turns about its outer lip
	const SPILL: P = [202, 92]; // the liquid leaves over the inner lip
	const MOVE: P = [41, 4]; // the crucible's shift to the mould
	const TILT = 88; // degrees; it is empty above 78°
	const AU = { from: [20, 64], to: [143, 128] };
	const AG = { from: [20, 132], to: [143, 116] };
	const MOULD = { floor: 212, x: 232 };
	// timeline, s
	const T = { au: [0.8, 2.0], ag: [2.0, 3.2], fire: [3.2, 6.9], melt: [3.6, 6.6], go: [6.9, 7.9], tilt: [7.9, 10.1], back: [10.1, 10.9], ret: [10.9, 11.9], cool: [10.1, 11.9], end: 16.0, cycle: 16.6 };
	const STEPS = ['1. Слитки кладут в тигель', '2. Плавят — около 1100 °C', '3. Выливают в форму', '4. Получился слиток сплава'];

	const u = (t: number, [a, b]: number[]) => Math.min(1, Math.max(0, (t - a) / (b - a)));
	const rot = (p: P, deg: number, move: P): P => {
		const a = (deg * Math.PI) / 180;
		const x = p[0] - PIV[0];
		const y = p[1] - PIV[1];
		return [PIV[0] + x * Math.cos(a) - y * Math.sin(a) + move[0], PIV[1] + x * Math.sin(a) + y * Math.cos(a) + move[1]];
	};
	/** The part of a polygon below the horizontal line y = L (screen y grows downward). */
	const below = (poly: P[], L: number): P[] => {
		const out: P[] = [];
		for (let i = 0; i < poly.length; i++) {
			const p = poly[i];
			const q = poly[(i + 1) % poly.length];
			const pin = p[1] >= L;
			const qin = q[1] >= L;
			if (pin) out.push(p);
			if (pin !== qin) {
				const s = (L - p[1]) / (q[1] - p[1]);
				out.push([p[0] + s * (q[0] - p[0]), L]);
			}
		}
		return out;
	};
	const area = (poly: P[]) => {
		let s = 0;
		for (let i = 0; i < poly.length; i++) {
			const p = poly[i];
			const q = poly[(i + 1) % poly.length];
			s += p[0] * q[1] - q[0] * p[1];
		}
		return Math.abs(s) / 2;
	};
	/** The liquid of drawn area `a` in the crucible turned by `deg`: its outline. */
	const liquid = (a: number, deg: number, move: P): P[] => {
		if (a < 0.5) return [];
		const poly = INNER.map((p) => rot(p, deg, move));
		let lo = Math.min(...poly.map((p) => p[1]));
		let hi = Math.max(...poly.map((p) => p[1]));
		for (let i = 0; i < 40; i++) {
			const mid = (lo + hi) / 2;
			if (area(below(poly, mid)) > a) lo = mid;
			else hi = mid;
		}
		return below(poly, (lo + hi) / 2);
	};
	/** How much the crucible turned by `deg` can hold: the area below its inner lip. */
	const holds = (deg: number) => {
		const poly = INNER.map((p) => rot(p, deg, [0, 0]));
		return area(below(poly, rot(SPILL, deg, [0, 0])[1]));
	};
	const fly = (from: number[], to: number[], v: number): P => {
		const x = from[0] + (to[0] - from[0]) * ease(v / 0.7);
		const y = v < 0.7 ? from[1] + (50 - from[1]) * ease(v / 0.7) : 50 + (to[1] - 50) * ease((v - 0.7) / 0.3);
		return [x - from[0], y - from[1]];
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-mixpic]')) {
		const q = <E extends Element>(s: string) => root.querySelector<E>(s)!;
		const cru = [...root.querySelectorAll<SVGGElement>('[data-cru]')];
		const au = q<SVGGElement>('[data-au]');
		const ag = q<SVGGElement>('[data-ag]');
		const liq = q<SVGPathElement>('[data-liq]');
		const stream = q<SVGRectElement>('[data-stream]');
		const mfill = q<SVGRectElement>('[data-mfill]');
		const mcool = q<SVGRectElement>('[data-mcool]');
		const flames = [q('[data-flame]'), q('[data-flame2]')];
		const step = q<SVGTextElement>('[data-step]');
		const auL = q('[data-aulabel]');
		const agL = q('[data-aglabel]');
		const alloyL = q('[data-alloylabel]');
		const cruL = q('[data-crulabel]');
		let t = 0;
		const draw = () => {
			const fade = t > T.end ? u(t, [T.end, T.cycle]) : 0; // the end frame fades back to the start
			// the ingots fly in and melt
			const melt = u(t, T.melt);
			const a = fly(AU.from, AU.to, u(t, T.au));
			const g = fly(AG.from, AG.to, u(t, T.ag));
			const back = t > T.end;
			au.setAttribute('transform', back ? '' : `translate(${a[0].toFixed(2)} ${a[1].toFixed(2)})`);
			ag.setAttribute('transform', back ? '' : `translate(${g[0].toFixed(2)} ${g[1].toFixed(2)})`);
			const ingotOp = back ? fade : 1 - melt;
			au.setAttribute('opacity', ingotOp.toFixed(3));
			ag.setAttribute('opacity', ingotOp.toFixed(3));
			auL.setAttribute('opacity', back ? fade.toFixed(3) : (1 - u(t, [0.8, 1.1])).toFixed(3));
			agL.setAttribute('opacity', back ? fade.toFixed(3) : (1 - u(t, [2.0, 2.3])).toFixed(3));
			const fire = t > T.fire[0] && t < T.fire[1];
			const fl = 0.92 + 0.08 * Math.sin(t * 17) * Math.sin(t * 5.3);
			for (const f of flames) {
				(f as SVGElement).style.display = fire ? '' : 'none';
				f.setAttribute('transform', `translate(167 204) scale(${(1 / fl).toFixed(3)} ${fl.toFixed(3)}) translate(-167 -204)`);
			}
			// the crucible goes to the mould, tilts, tilts back and returns
			const go = ease(u(t, T.go)) - ease(u(t, T.ret));
			const lift = -20 * (Math.sin(Math.PI * u(t, T.go)) + Math.sin(Math.PI * u(t, T.ret)));
			const move: P = [MOVE[0] * go, MOVE[1] * go + lift];
			const up = ease(u(t, T.tilt));
			const deg = TILT * (up - ease(u(t, T.back)));
			for (const c of cru) c.setAttribute('transform', `translate(${move[0].toFixed(2)} ${move[1].toFixed(2)}) rotate(${deg.toFixed(2)} ${PIV[0]} ${PIV[1]})`);
			cruL.setAttribute('opacity', go > 0.02 ? '0' : '1');
			// the liquid: grows while melting, then the tilted crucible keeps only what it can hold
			const left = t >= T.tilt[1] ? 0 : Math.min(A0 * melt, t >= T.tilt[0] ? holds(TILT * up) : A0);
			const poured = melt >= 1 ? A0 - left : 0;
			const poly = back ? [] : liquid(left, deg, move);
			liq.setAttribute('d', poly.length ? `M${poly.map((p) => `${p[0].toFixed(2)} ${p[1].toFixed(2)}`).join(' L')} Z` : '');
			const h = back ? 0 : (poured / A0) * 2 * S; // the alloy in the mould, px
			mfill.setAttribute('y', (MOULD.floor - h).toFixed(2));
			mfill.setAttribute('height', h.toFixed(2));
			const pouring = t > T.tilt[0] && t < T.tilt[1] && left > 0.5 && left < A0 - 0.5;
			if (pouring) {
				const sp = rot(SPILL, deg, move);
				stream.setAttribute('x', (sp[0] - 1.5).toFixed(2));
				stream.setAttribute('y', sp[1].toFixed(2));
				stream.setAttribute('height', Math.max(0, MOULD.floor - h - sp[1]).toFixed(2));
			} else stream.setAttribute('height', '0');
			// the alloy cools and gets its label
			const cool = back ? 1 - fade : u(t, T.cool);
			mcool.setAttribute('opacity', cool.toFixed(3));
			mfill.setAttribute('opacity', back ? (1 - fade).toFixed(3) : '1');
			alloyL.setAttribute('opacity', back ? (1 - fade).toFixed(3) : u(t, [T.ret[1], T.ret[1] + 0.4]).toFixed(3));
			step.textContent = back ? STEPS[0] : t < T.fire[0] ? STEPS[0] : t < T.go[0] ? STEPS[1] : t < T.ret[1] ? STEPS[2] : STEPS[3];
		};
		loop(root, (dt) => {
			t = (t + dt) % T.cycle;
			draw();
			return true;
		});
		draw();
	}
</script>
