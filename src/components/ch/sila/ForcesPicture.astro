---
/**
 * Picture «Сила тяжести, сила упругости и вес»: a ball on a table and a ball on a thread. In each panel three
 * arrows of equal length: the force of gravity (red, from the centre of the ball, down), the elastic force of the
 * support or the thread (green, applied to the ball, up) and the weight (blue, applied to the support or to the
 * thread, down). The arrows that start at different bodies are drawn side by side so that they do not hide each
 * other. A static drawing.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const heads = ['red', 'green', 'blue'];
---

<G7Styles />
<figure class="g7 g7--pic frc not-content">
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 240 220" role="img" aria-label="Шар лежит на столе. Сила тяжести приложена к шару и направлена вниз, сила упругости стола приложена к шару и направлена вверх, вес шара приложен к столу и направлен вниз">
			<defs>
				{heads.map((h) => <marker id={`frc-${uid}-${h}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${h}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<text class="t-title" x="120" y="18" text-anchor="middle">тело на опоре</text>
			<rect class="frc__table" x="30" y="130" width="180" height="12"></rect>
			<path class="frc__leg" d="M46 142 V206 M194 142 V206"></path>
			<circle class="frc__ball" cx="120" cy="104" r="26"></circle>
			<line class="arrow arrow--red" x1="110" y1="104" x2="110" y2="170" marker-end={`url(#frc-${uid}-red)`}></line>
			<line class="arrow arrow--green" x1="130" y1="130" x2="130" y2="64" marker-end={`url(#frc-${uid}-green)`}></line>
			<line class="arrow arrow--blue" x1="150" y1="130" x2="150" y2="196" marker-end={`url(#frc-${uid}-blue)`}></line>
			<circle class="frc__dot frc__dot--red" cx="110" cy="104" r="3"></circle>
			<circle class="frc__dot frc__dot--green" cx="130" cy="130" r="3"></circle>
			<circle class="frc__dot frc__dot--blue" cx="150" cy="130" r="3"></circle>
			<text class="t-i t-red t-halo" x="74" y="176">F<tspan class="frc__sub" dy="4">тяж</tspan></text>
			<text class="t-i t-green t-halo" x="136" y="62">F<tspan class="frc__sub" dy="4">упр</tspan></text>
			<text class="t-i t-blue t-halo" x="158" y="190">P</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 240 220" role="img" aria-label="Шар висит на нити. Сила тяжести приложена к шару и направлена вниз, сила упругости нити приложена к шару и направлена вверх, вес шара приложен к нити и направлен вниз">
			<text class="t-title" x="120" y="18" text-anchor="middle">тело на подвесе</text>
			<path class="frc__leg" d="M50 34 H190"></path>
			<line class="frc__thread" x1="120" y1="34" x2="120" y2="110"></line>
			<circle class="frc__ball" cx="120" cy="136" r="26"></circle>
			<line class="arrow arrow--red" x1="110" y1="136" x2="110" y2="202" marker-end={`url(#frc-${uid}-red)`}></line>
			<line class="arrow arrow--green" x1="130" y1="110" x2="130" y2="46" marker-end={`url(#frc-${uid}-green)`}></line>
			<line class="arrow arrow--blue" x1="150" y1="74" x2="150" y2="140" marker-end={`url(#frc-${uid}-blue)`}></line>
			<path class="ln-dash" d="M120 74 H150"></path>
			<circle class="frc__dot frc__dot--red" cx="110" cy="136" r="3"></circle>
			<circle class="frc__dot frc__dot--green" cx="130" cy="110" r="3"></circle>
			<circle class="frc__dot frc__dot--blue" cx="120" cy="74" r="3"></circle>
			<text class="t-i t-red t-halo" x="74" y="206">F<tspan class="frc__sub" dy="4">тяж</tspan></text>
			<text class="t-i t-green t-halo" x="136" y="50">F<tspan class="frc__sub" dy="4">упр</tspan></text>
			<text class="t-i t-blue t-halo" x="158" y="134">P</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Сила тяжести <i>F</i><sub>тяж</sub> приложена к самому телу. Сила упругости <i>F</i><sub>упр</sub> опоры или нити тоже приложена к телу и направлена вверх. Вес <i>P</i> приложен не к телу, а к опоре или нити. Стрелки нарисованы рядом, чтобы не закрывать друг друга.
	</figcaption>
</figure>

<style is:global>
	.frc__table {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.frc__leg {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 6;
		stroke-linecap: round;
	}
	.frc__thread {
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.frc__ball {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.frc__dot--red {
		fill: var(--g7-red);
	}
	.frc__dot--green {
		fill: var(--g7-green);
	}
	.frc__dot--blue {
		fill: var(--g7-blue);
	}
	.frc svg .frc__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>
