---
/**
 * Picture «Виды деформации» (Irina, 17 Nov 2026: «В силу упругости, где вводится деформация, добавить рисунки с
 * деформациями, может быть модели, ещё что есть разные виды деформации»). Six small loops on one clock (6 s): the
 * forces grow for 1,4 s, hold 1 s, are taken away in 1,2 s, then 1,8 s of rest. A grid is drawn on every body, so one
 * sees how its parts shift. Red arrows are the forces acting on the body, each starts where the force is applied;
 * their length grows in proportion to the deformation (Hooke's law), and the forces on a body at rest balance.
 *
 *   Растяжение — a rubber cord pulled at both ends: it gets 35 % longer and, its volume kept, √1,35 = 1,16 times thinner.
 *   Сжатие — a column pressed by a plate and held by the ground: 18 % shorter; its ends are held by the plate and the
 *     ground, so it bulges in the middle (the area of the drawing kept).
 *   Изгиб — a board on two supports, a person walks from near the left support to the middle and back. The shape is the
 *     deflection of a beam under a point load, y ∝ b·x·(L² − b² − x²), largest when the person is in the middle; the
 *     supports push up with forces in the ratio of the distances (lever rule), their sum equals the person's push.
 *     The lines across the board stay perpendicular to its middle line: the top gets shorter, the bottom longer.
 *   Кручение — a rod fixed in a wall, its free end turned by 60°; each straight line drawn along the rod becomes a
 *     helix, the angle of turn growing evenly from the wall to the end. Curved arrows: the turning forces at the end
 *     and the opposite ones of the wall.
 *   Сдвиг — a book (106 × 52 px) on a table, the top cover pushed sideways while the table holds the bottom one: the pages slide over
 *     each other, the side of the book leans like a parallelogram.
 *   Упругая и пластическая — a rubber ball and a plasticine ball pressed equally (40 % flatter, area kept); when the
 *     plates lift, the rubber is round again and the plasticine stays flat (it is rolled round again before the
 *     next loop).
 * The drawings are shifted 16 px up under the titles (one group), the script works in their own coordinates.
 * EXAGGERATED: real rods, columns and boards deform by fractions of a millimetre (a steel rod by about 0,1 % at
 * most); every deformation here is drawn large enough to see (the caption says it). Not to scale.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const PANELS = [
	{ key: 'stretch', title: 'Растяжение', ex: 'трос, канат, пружина под грузом' },
	{ key: 'squeeze', title: 'Сжатие', ex: 'колонна, ножки стула, фундамент' },
	{ key: 'bend', title: 'Изгиб', ex: 'доска под человеком, полка' },
	{ key: 'twist', title: 'Кручение', ex: 'ключ в замке, отжимаемое бельё' },
	{ key: 'shear', title: 'Сдвиг', ex: 'страницы книги, заклёпка' },
	{ key: 'plastic', title: 'Упругая и пластическая', ex: 'сжали одинаково, потом отпустили' },
];
const LABEL: Record<string, string> = {
	stretch: 'Резиновый жгут растягивают за оба конца',
	squeeze: 'Колонну сжимают плита сверху и земля снизу',
	bend: 'Человек идёт по доске на двух опорах, доска прогибается',
	twist: 'Конец стержня, закреплённого в стене, поворачивают, стержень закручивается',
	shear: 'Верхнюю обложку книги сдвигают, нижнюю держит стол, страницы смещаются',
	plastic: 'Резиновый мяч и пластилиновый шарик сжали, потом отпустили: мяч вернул форму, пластилин остался сплющенным',
};
---

<G7Styles />
<figure class="g7 g7--pic dfp not-content" data-dfp>
	<div class="g7__grid is-three">
		{
			PANELS.map((p, i) => (
				<svg class="g7__svg" viewBox="0 0 220 184" role="img" aria-label={LABEL[p.key]} data-panel={p.key}>
					<defs>
						<marker id={`dfp-${uid}-${i}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
							<path class="head--red" d="M0,0 L10,5 L0,10 z" />
						</marker>
					</defs>
					<text class="t-title" x="110" y="18" text-anchor="middle">{p.title}</text>
					<text class="t-small" x="110" y="34" text-anchor="middle">{p.ex}</text>
					<g transform="translate(0 -16)">

					{p.key === 'stretch' && (
						<>
							<rect class="dfp__ghost" x="65" y="99" width="90" height="26" />
							<path class="dfp__rubber" data-body />
							<path class="dfp__grid" data-grid />
						</>
					)}
					{p.key === 'squeeze' && (
						<>
							<path class="dfp__floor" d="M40 176.5 H180" />
							<rect class="dfp__ghost" x="92" y="76" width="36" height="100" />
							<path class="dfp__stone" data-body />
							<path class="dfp__grid" data-grid />
							<rect class="dfp__plate" x="80" y="70" width="60" height="6" rx="1.5" data-plate />
						</>
					)}
					{p.key === 'bend' && (
						<>
							<path class="dfp__floor" d="M6 147.5 H214" />
							<path class="dfp__support" d="M26 128 L18 147 H34 Z M194 128 L186 147 H202 Z" />
							<path class="dfp__wood" data-body />
							<path class="dfp__grid" data-grid />
							<g data-man>
								<path class="dfp__man" data-limbs />
								<circle class="dfp__head" r="5.5" data-head />
							</g>
						</>
					)}
					{p.key === 'twist' && (
						<>
							<path class="dfp__hatch" d={Array.from({ length: 8 }, (_, j) => `M22 ${80 + j * 9} l12 -9`).join(' ')} />
							<path class="dfp__wall" d="M34 72 V152" />
							<rect class="dfp__steel" x="34" y="88" width="142" height="48" />
							<path class="dfp__grid" d={Array.from({ length: 5 }, (_, j) => `M${(34 + ((j + 1) * 142) / 6).toFixed(1)} 88 V136`).join(' ')} />
							<path class="dfp__helix" data-grid />
							<ellipse class="dfp__end" cx="176" cy="112" rx="8.4" ry="24" />
							<line class="dfp__mark" x1="176" y1="112" x2="176" y2="88" data-mark />
						</>
					)}
					{p.key === 'shear' && (
						<>
							<path class="dfp__floor" d="M14 157.5 H206" />
							<rect class="dfp__ghost" x="40" y="104" width="106" height="52" />
							<path class="dfp__pages" data-pages />
							<path class="dfp__grid" data-grid />
							<path class="dfp__cover" data-covers />
						</>
					)}
					{p.key === 'plastic' && (
						<>
							<path class="dfp__floor" d="M14 164.5 H206" />
							<ellipse class="dfp__rubber-ball" cx="60" cy="142" rx="22" ry="22" data-ball="0" />
							<ellipse class="dfp__clay" cx="160" cy="142" rx="22" ry="22" data-ball="1" />
							<rect class="dfp__plate" x="32" y="114" width="56" height="5" rx="1.5" data-plate="0" />
							<rect class="dfp__plate" x="132" y="114" width="56" height="5" rx="1.5" data-plate="1" />
							<text class="t-small" x="60" y="180" text-anchor="middle">резина</text>
							<text class="t-green dfp__kind" x="60" y="195" text-anchor="middle">упругая</text>
							<text class="t-small" x="160" y="180" text-anchor="middle">пластилин</text>
							<text class="t-gold dfp__kind" x="160" y="195" text-anchor="middle">пластическая</text>
						</>
					)}

					<g data-arrows>
						{[0, 1, 2].map(() => (
							<path class="arrow arrow--red" marker-end={`url(#dfp-${uid}-${i})`} />
						))}
					</g>
					<g data-flabels>
						{[0, 1].map(() => (
							<text class="t-i t-red t-halo" text-anchor="middle">F</text>
						))}
					</g>
					</g>
				</svg>
			))
		}
	</div>
	<figcaption class="g7__caption">
		Деформации сильно преувеличены: настоящие трос или колонна меняют форму так мало, что на глаз этого не видно. Сетка на телах показывает, как смещаются их части; когда силы убирают, упругое тело возвращает прежнюю форму, а пластилин — нет.
	</figcaption>
</figure>

<style is:global>
	.dfp__ghost {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.dfp__grid,
	.dfp__helix {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.8;
		opacity: 0.55;
	}
	.dfp__rubber {
		fill: color-mix(in oklab, var(--g7-violet) 40%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.dfp__stone {
		fill: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-4));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.dfp__plate {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.dfp__floor {
		stroke: var(--g7-wood);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.dfp__support {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.dfp__wood {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.dfp__man {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.dfp__head {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.dfp__hatch {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.dfp__wall {
		stroke: var(--g7-ink);
		stroke-width: 2.5;
	}
	.dfp__steel {
		fill: var(--g7-steel);
	}
	.dfp__end {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.dfp__mark {
		stroke: var(--g7-gold);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.dfp__pages {
		fill: color-mix(in oklab, var(--ig-v) 8%, var(--sl-color-gray-6));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.dfp__cover {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.dfp__rubber-ball {
		fill: color-mix(in oklab, var(--g7-red) 50%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.dfp__clay {
		fill: color-mix(in oklab, var(--g7-green) 45%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.dfp svg .dfp__kind {
		font-size: 12px;
		font-weight: 700;
	}
</style>

<script>
	import { ease, loop } from '../g7/kit';

	const CYCLE = 6;
	/** The load from 0 to 1: rises 0,6–2,0 с, holds, is taken away 3,0–4,2 с. */
	const load = (t: number) => (t < 0.6 ? 0 : t < 2 ? ease((t - 0.6) / 1.4) : t < 3 ? 1 : t < 4.2 ? 1 - ease((t - 3) / 1.2) : 0);
	const f1 = (v: number) => v.toFixed(1);
	type Arrow = SVGPathElement;
	const arrow = (a: Arrow, x1: number, y1: number, x2: number, y2: number) => {
		const len = Math.hypot(x2 - x1, y2 - y1);
		a.setAttribute('d', `M${f1(x1)} ${f1(y1)} L${f1(x2)} ${f1(y2)}`);
		a.setAttribute('visibility', len > 5 ? 'visible' : 'hidden');
	};
	const label = (e: SVGTextElement, x: number, y: number, on: boolean) => {
		e.setAttribute('x', f1(x));
		e.setAttribute('y', f1(y));
		e.setAttribute('visibility', on ? 'visible' : 'hidden');
	};
	const hide = (e: Element) => e.setAttribute('visibility', 'hidden');

	type Draw = (t: number) => void;
	const make: Record<string, (svg: SVGSVGElement, A: Arrow[], Lb: SVGTextElement[]) => Draw> = {
		stretch(svg, A, Lb) {
			const body = svg.querySelector('[data-body]')!;
			const grid = svg.querySelector('[data-grid]')!;
			hide(A[2]);
			return (t) => {
				const s = load(t);
				const len = 90 * (1 + 0.35 * s);
				const h = 26 / Math.sqrt(1 + 0.35 * s);
				const x0 = 110 - len / 2;
				const x1 = 110 + len / 2;
				const y0 = 112 - h / 2;
				body.setAttribute('d', `M${f1(x0)} ${f1(y0)} H${f1(x1)} V${f1(y0 + h)} H${f1(x0)} Z`);
				let d = `M${f1(x0)} 112 H${f1(x1)}`;
				for (let j = 1; j < 8; j++) d += ` M${f1(x0 + (len * j) / 8)} ${f1(y0)} V${f1(y0 + h)}`;
				grid.setAttribute('d', d);
				const fl = 36 * s;
				arrow(A[0], x1, 112, x1 + fl, 112);
				arrow(A[1], x0, 112, x0 - fl, 112);
				label(Lb[0], x1 + fl / 2 + 2, 102 - h / 2, s > 0.2);
				label(Lb[1], x0 - fl / 2 - 2, 102 - h / 2, s > 0.2);
			};
		},
		squeeze(svg, A, Lb) {
			const body = svg.querySelector('[data-body]')!;
			const grid = svg.querySelector('[data-grid]')!;
			const plate = svg.querySelector('[data-plate]')!;
			hide(A[2]);
			const G = 176;
			return (t) => {
				const s = load(t);
				const h = 100 * (1 - 0.18 * s);
				const top = G - h;
				// the ends keep 36 px, the middle bulges by b: h·(36 + 4b/3) = 36·100
				const b = ((36 * 100) / h - 36) * 0.75;
				const xl = 92;
				const xr = 128;
				body.setAttribute('d', `M${xl} ${f1(top)} H${xr} Q${f1(xr + 2 * b)} ${f1(top + h / 2)} ${xr} ${G} H${xl} Q${f1(xl - 2 * b)} ${f1(top + h / 2)} ${xl} ${f1(top)} Z`);
				let d = '';
				for (let j = 1; j < 6; j++) {
					const y = top + (h * j) / 6;
					const u = (2 * j) / 6 - 1;
					const bulge = b * (1 - u * u);
					d += ` M${f1(xl - bulge)} ${f1(y)} H${f1(xr + bulge)}`;
				}
				for (const v of [-0.5, 0, 0.5]) d += ` M${f1(110 + v * 18)} ${f1(top)} Q${f1(110 + v * (18 + 2 * b))} ${f1(top + h / 2)} ${f1(110 + v * 18)} ${G}`;
				grid.setAttribute('d', d);
				plate.setAttribute('y', f1(top - 6));
				const fl = 30 * s;
				arrow(A[0], 110, top, 110, top + fl);
				arrow(A[1], 110, G, 110, G - fl);
				label(Lb[0], 140 + b, top + 18, s > 0.2);
				label(Lb[1], 140 + b, G - 8, s > 0.2);
			};
		},
		bend(svg, A, Lb) {
			const body = svg.querySelector('[data-body]')!;
			const grid = svg.querySelector('[data-grid]')!;
			const man = svg.querySelector<SVGGElement>('[data-man]')!;
			const limbs = svg.querySelector('[data-limbs]')!;
			const head = svg.querySelector('[data-head]')!;
			hide(Lb[1]);
			const X0 = 26;
			const L = 168;
			const TOP = 118;
			const TH = 10;
			const DMAX = 16; // px, the sag with the person in the middle
			/** The sag at x (from the left support) with the load at a. */
			const sag = (x: number, a: number) => {
				const b = L - a;
				if (x < 0 || x > L) return 0;
				const v = x <= a ? b * x * (L * L - b * b - x * x) : a * (L - x) * (L * L - a * a - (L - x) * (L - x));
				return (DMAX * 8 * v) / L ** 4;
			};
			const yc = (x: number, a: number) => {
				// overhangs keep the slope of the board at the support
				if (x < 0) return TOP + TH / 2 + x * (sag(0.5, a) / 0.5);
				if (x > L) return TOP + TH / 2 + (x - L) * (sag(L - 0.5, a) / 0.5);
				return TOP + TH / 2 + sag(x, a);
			};
			return (t) => {
				// the person: from 0,12 L to the middle in 1,8 s, stands, back
				const A0 = 0.12 * L;
				const u = t < 0.6 ? 0 : t < 2.4 ? ease((t - 0.6) / 1.8) : t < 3.4 ? 1 : t < 5.2 ? 1 - ease((t - 3.4) / 1.8) : 0;
				const a = A0 + (L / 2 - A0) * u;
				const pts: { x: number; y: number; nx: number; ny: number }[] = [];
				for (let j = 0; j <= 48; j++) {
					const x = -12 + ((L + 24) * j) / 48;
					const y = yc(x, a);
					const dy = (yc(x + 0.5, a) - yc(x - 0.5, a)) / 1;
					const n = Math.hypot(dy, 1);
					pts.push({ x: X0 + x, y, nx: -dy / n, ny: 1 / n });
				}
				const top = pts.map((p) => `${f1(p.x - p.nx * TH * 0.5)} ${f1(p.y - p.ny * TH * 0.5)}`);
				const bot = pts.map((p) => `${f1(p.x + p.nx * TH * 0.5)} ${f1(p.y + p.ny * TH * 0.5)}`).reverse();
				body.setAttribute('d', `M${top.join(' L')} L${bot.join(' L')} Z`);
				let d = '';
				for (let j = 2; j <= 46; j += 4) {
					const p = pts[j];
					d += ` M${f1(p.x - p.nx * TH * 0.5)} ${f1(p.y - p.ny * TH * 0.5)} L${f1(p.x + p.nx * TH * 0.5)} ${f1(p.y + p.ny * TH * 0.5)}`;
				}
				grid.setAttribute('d', d);
				// the person stands on the top of the board at a
				const fy = yc(a, a) - TH / 2;
				const fx = X0 + a;
				man.setAttribute('transform', `translate(${f1(fx)} ${f1(fy)})`);
				const walking = (t > 0.6 && t < 2.4) || (t > 3.4 && t < 5.2);
				const sw = walking ? 0.45 * Math.sin(a / 3.2) : 0;
				// legs and arms: apart by 0,2 рад when standing, swinging when walking
				const leg = (k: number) => {
					const g = k * (0.2 + sw);
					return `M0 -24 L${f1(Math.sin(g) * 24)} ${f1(-24 + Math.cos(g) * 24)}`;
				};
				const arm = (k: number) => {
					const g = k * (0.3 + sw);
					return `M0 -40 L${f1(Math.sin(g) * 16)} ${f1(-40 + Math.cos(g) * 16)}`;
				};
				limbs.setAttribute('d', `${leg(1)} ${leg(-1)} M0 -24 V-44 ${arm(-1)} ${arm(1)}`);
				head.setAttribute('cx', '0');
				head.setAttribute('cy', '-50');
				// the person pushes the board down; the supports push it up in the ratio of the distances
				const F = 34;
				arrow(A[0], fx, fy, fx, fy + F);
				label(Lb[0], fx + 10, fy + F + 2, true);
				const BOT = TOP + TH;
				const r1 = (F * (L - a)) / L;
				const r2 = (F * a) / L;
				arrow(A[1], X0, BOT, X0, BOT - r1);
				arrow(A[2], X0 + L, BOT, X0 + L, BOT - r2);
			};
		},
		twist(svg, A, Lb) {
			const helix = svg.querySelector('[data-grid]')!;
			const mark = svg.querySelector('[data-mark]')!;
			hide(A[2]);
			const X0 = 34;
			const X1 = 176;
			const CY = 112;
			const R = 24;
			const K = 0.35; // the oblique view: z shifts the point to the right
			const deg = Math.PI / 180;
			const arc = (xc: number, ra: number, from: number, to: number) => {
				const n = 24;
				let d = '';
				for (let j = 0; j <= n; j++) {
					const p = (from + ((to - from) * j) / n) * deg;
					d += `${j ? ' L' : 'M'}${f1(xc + K * ra * Math.cos(p))} ${f1(CY - ra * Math.sin(p))}`;
				}
				return d;
			};
			return (t) => {
				const s = load(t);
				const th = 60 * s;
				let d = '';
				for (let phi = -150; phi <= 90; phi += 30) {
					let on = false;
					for (let j = 0; j <= 40; j++) {
						const x = X0 + ((X1 - X0) * j) / 40;
						const psi = (phi + (th * (x - X0)) / (X1 - X0)) * deg;
						if (Math.cos(psi) > 0.02) {
							d += `${on ? ' L' : ' M'}${f1(x)} ${f1(CY - R * Math.sin(psi))}`;
							on = true;
						} else on = false;
					}
				}
				helix.setAttribute('d', d);
				const pm = (90 + th) * deg;
				mark.setAttribute('x2', f1(X1 + K * R * Math.cos(pm)));
				mark.setAttribute('y2', f1(CY - R * Math.sin(pm)));
				// the turning forces: at the free end the front goes up, at the wall it is held the other way
				const sweep = 110 * s;
				A[0].setAttribute('d', arc(X1, 36, -55, -55 + sweep));
				A[0].setAttribute('visibility', s > 0.08 ? 'visible' : 'hidden');
				A[1].setAttribute('d', arc(X0 + 10, 36, 55, 55 - sweep));
				A[1].setAttribute('visibility', s > 0.08 ? 'visible' : 'hidden');
				label(Lb[0], 204, 82, s > 0.2);
				label(Lb[1], 62, 162, s > 0.2);
			};
		},
		shear(svg, A, Lb) {
			const pages = svg.querySelector('[data-pages]')!;
			const grid = svg.querySelector('[data-grid]')!;
			const covers = svg.querySelector('[data-covers]')!;
			hide(A[2]);
			const X0 = 40;
			const W = 106;
			const B = 156;
			const H = 52;
			const C = 5; // a cover
			return (t) => {
				const s = load(t);
				const D = 30 * s;
				const sx = (y: number) => (D * (B - y)) / H;
				const quad = (y0: number, y1: number) => `M${f1(X0 + sx(y0))} ${y0} H${f1(X0 + W + sx(y0))} L${f1(X0 + W + sx(y1))} ${y1} H${f1(X0 + sx(y1))} Z`;
				covers.setAttribute('d', `${quad(B - H, B - H + C)} ${quad(B - C, B)}`);
				pages.setAttribute('d', quad(B - H + C, B - C));
				let d = '';
				for (let j = 1; j < 9; j++) {
					const y = B - H + C + ((H - 2 * C) * j) / 9;
					d += ` M${f1(X0 + sx(y))} ${f1(y)} H${f1(X0 + W - 3 + sx(y))}`;
				}
				grid.setAttribute('d', d);
				const fl = 28 * s;
				const yt = B - H + C / 2;
				arrow(A[0], X0 + W + D, yt, X0 + W + D + fl, yt);
				arrow(A[1], X0, B - C / 2, X0 - fl, B - C / 2);
				label(Lb[0], X0 + W + D + fl / 2, yt - 9, s > 0.2);
				label(Lb[1], X0 - fl / 2, B - C / 2 - 9, s > 0.2);
			};
		},
		plastic(svg, A, Lb) {
			const balls = [...svg.querySelectorAll<SVGEllipseElement>('[data-ball]')];
			const plates = [...svg.querySelectorAll<SVGRectElement>('[data-plate]')];
			hide(A[2]);
			const G = 164;
			const R = 22;
			const XS = [60, 160];
			let clay = 0; // how flat the plasticine is
			const flat = (ball: SVGEllipseElement, f: number) => {
				const ry = R * (1 - 0.4 * f);
				ball.setAttribute('ry', f1(ry));
				ball.setAttribute('rx', f1((R * R) / ry));
				ball.setAttribute('cy', f1(G - ry));
				return G - 2 * ry;
			};
			return (t) => {
				const s = load(t);
				if (t < 0.6) clay = 0;
				clay = Math.max(clay, s);
				const pressing = t < 3;
				const topR = flat(balls[0], s);
				const topC = flat(balls[1], clay);
				balls[1].setAttribute('opacity', t > 5.4 ? f1(Math.max(0, 1 - (t - 5.4) / 0.3)) : t < 0.3 ? f1(t / 0.3) : '1');
				// both plates follow the press; the one over the plasticine leaves it once the press goes back
				for (const [j, top] of [topR, Math.min(topC, topR)].entries()) plates[j].setAttribute('y', f1(top - 5));
				const fl = 30 * s;
				for (let j = 0; j < 2; j++) {
					const y = (j ? Math.min(topC, topR) : topR) - 5;
					// the rubber is pushed while the press goes back; the plasticine is left at once
					const on = j === 0 || pressing;
					if (on) arrow(A[j], XS[j], y - fl - 2, XS[j], y - 1);
					else hide(A[j]);
					label(Lb[j], XS[j] + 12, y - 10, on && s > 0.2);
				}
			};
		},
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-dfp]')) {
		const draws: Draw[] = [];
		for (const svg of root.querySelectorAll<SVGSVGElement>('svg[data-panel]')) {
			const A = [...svg.querySelectorAll<Arrow>('[data-arrows] path')];
			const Lb = [...svg.querySelectorAll<SVGTextElement>('[data-flabels] text')];
			draws.push(make[svg.dataset.panel!](svg, A, Lb));
		}
		let t = 0;
		const draw = () => {
			for (const d of draws) d(t);
		};
		loop(root, (dt) => {
			t += dt;
			if (t >= CYCLE) t = 0;
			draw();
			return true;
		});
		draw();
	}
</script>
