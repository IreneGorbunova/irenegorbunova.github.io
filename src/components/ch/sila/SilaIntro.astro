---
/**
 * Two short looping opening scenes of «Сила. Сила тяжести, сила упругости, вес тела». No terms in the pictures.
 * Ball: a ball is thrown straight up with 9,8 м/с from a height of 1,5 м and moves for 2 real seconds:
 *   h = 1,5 + 9,8·t − 4,9·t² (g = 9,8 м/с²). It rises 4,9 м in one second, stops and comes back with the same
 *   speed. The height axis is to scale (28 px per metre); the ball is drawn larger.
 * Plank: a weight of 16 кг is put on the middle of a plank that lies on two supports. The plank sags (the sag is
 *   drawn larger than a real one would be) and straightens, with a little swing, when the weight is taken away.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-silaintro>
	<div class="intro__card" data-scene="ball">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик бросает мяч вертикально вверх. Мяч поднимается почти на пять метров, останавливается и падает обратно">
			<rect class="sa-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="sa-ground" x="0" y="214" width="360" height="26"></rect>
			<!-- the boy: 1,5 м to the raised hand -->
			<circle class="sa-head" cx="120" cy="180" r="7"></circle>
			<path class="sa-body" d="M120 187 V204 M120 204 L113 214 M120 204 L127 214 M120 191 L134 176"></path>
			<circle class="sa-ball" data-ball cx="140" cy="172" r="6"></circle>
			<line class="sa-axis" x1="230" y1="18" x2="230" y2="214"></line>
			{[0, 1, 2, 3, 4, 5, 6, 7].map((m) => (
				<>
					<line class="sa-axis" x1="226" x2="234" y1={214 - m * 28} y2={214 - m * 28} />
					<text class="sa-small" x="240" y={218 - m * 28}>{m} м</text>
				</>
			))}
			<rect class="sa-pill" x="10" y="10" width="112" height="56" rx="9"></rect>
			<text class="sa-small" x="20" y="26">скорость мяча</text>
			<text class="sa-num" x="20" y="43" data-speed>9,8 м/с</text>
			<text class="sa-small" x="20" y="59" data-dir>вверх</text>
		</svg>
		<div class="intro__foot">
			<p>
				Мяч, брошенный вверх, летит всё медленнее, останавливается и падает обратно:{' '}
				<More term="его притягивает Земля">
					Земля притягивает к себе все тела: мяч, дождевые капли, людей, Луну. Это притяжение каждую секунду уменьшает скорость летящего вверх мяча почти на 10&nbsp;м/с, а потом так же разгоняет его вниз. Об этом — в разделе{' '}
					<a href="#сила-тяжести">«Сила тяжести»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="plank">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="На доску, лежащую на двух опорах, ставят гирю. Доска прогибается, а когда гирю снимают, распрямляется">
			<rect class="sa-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="sa-ground" x="0" y="214" width="360" height="26"></rect>
			<path class="sa-support" d="M50 214 V150 H80 V214 Z M280 214 V150 H310 V214 Z"></path>
			<path class="sa-plank" data-plank></path>
			<g data-weight>
				<path class="sa-weight" d="M-22 0 q0 -34 22 -34 q22 0 22 34 Z"></path>
				<path class="sa-handle" d="M-10 -34 q0 -16 10 -16 q10 0 10 16"></path>
				<text class="sa-wtext" x="0" y="-9" text-anchor="middle">16 кг</text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Под гирей доска прогибается, а когда гирю снимают, распрямляется:{' '}
				<More term="согнутая доска сама стремится выпрямиться">
					Когда тело сгибают, сжимают или растягивают, в нём возникает сила, которая стремится вернуть ему прежнюю форму. Эта сила и удерживает гирю: доска прогибается ровно настолько, чтобы уравновесить притяжение гири к Земле. Об этом — в разделе{' '}
					<a href="#сила-упругости-закон-гука">«Сила упругости. Закон Гука»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-silaintro] .sa-sky {
		fill: var(--sl-color-bg);
	}
	[data-silaintro] .sa-ground {
		fill: color-mix(in oklab, hsl(110, 30%, 42%) 60%, var(--sl-color-bg));
	}
	[data-silaintro] .sa-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-silaintro] .sa-body {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-silaintro] .sa-ball {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-silaintro] .sa-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-silaintro] .sa-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-silaintro] .sa-pill {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-silaintro] .sa-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-silaintro] .sa-support {
		fill: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-silaintro] .sa-plank {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke-width: 9;
		stroke-linecap: round;
	}
	[data-silaintro] .sa-weight {
		fill: hsl(225, 12%, 34%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-silaintro] .sa-handle {
		fill: none;
		stroke: hsl(225, 12%, 34%);
		stroke-width: 6;
	}
	[data-silaintro] .sa-wtext {
		font-size: 10px;
		font-weight: 700;
		fill: white;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const ru = (v: number) => v.toFixed(1).replace('.', ',');
	for (const root of document.querySelectorAll<HTMLElement>('[data-silaintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ball"]')!;
			const ball = card.querySelector<SVGCircleElement>('[data-ball]')!;
			const speed = card.querySelector<SVGTextElement>('[data-speed]')!;
			const dir = card.querySelector<SVGTextElement>('[data-dir]')!;
			scene(card, 2, (x) => {
				const t = 2 * x;
				const h = 1.5 + 9.8 * t - 4.9 * t * t;
				const v = 9.8 - 9.8 * t;
				ball.setAttribute('cy', (214 - h * 28).toFixed(1));
				speed.textContent = `${ru(Math.abs(v))} м/с`;
				dir.textContent = Math.abs(v) < 0.25 ? 'остановился' : v > 0 ? 'вверх' : 'вниз';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="plank"]')!;
			const plank = card.querySelector<SVGPathElement>('[data-plank]')!;
			const weight = card.querySelector<SVGGElement>('[data-weight]')!;
			scene(card, 7, (x) => {
				const down = ease(x / 0.25); // the weight comes down onto the plank
				const up = ease((x - 0.6) / 0.2); // and is taken away
				// the sag: grows while the weight settles, and dies out with a few swings after it is lifted
				const u = (x - 0.6) / 0.4;
				const sag = x < 0.6 ? 16 * ease((x - 0.22) / 0.12) : 16 * Math.exp(-7 * u) * Math.cos(26 * u) * (1 - up) + 5 * Math.exp(-5 * u) * Math.sin(40 * u) * up;
				plank.setAttribute('d', `M44 146 Q180 ${(146 + 2 * sag).toFixed(1)} 316 146`);
				const rest = 141 + sag; // the top of the plank in the middle
				const y = x < 0.6 ? 60 + (rest - 60) * down : rest - (rest - 60) * up;
				weight.setAttribute('transform', `translate(180 ${Math.min(y, rest).toFixed(1)})`);
			});
		}
	}
</script>
