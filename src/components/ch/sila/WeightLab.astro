---
/**
 * «Вес тела на весах»: a body lies on a platform scale that shows its reading in newtons. Three bodies: a 2 кг
 * kettlebell, a 5 кг box and a 16 кг kettlebell («пудовая гиря»); g = 9,8 Н/кг, so F_тяж = 19,6 Н, 49 Н and 156,8 Н.
 * A hand acts on the body with an extra force F: it pulls up through a spring (0 … 1,5·mg) or presses down with a fist
 * (0 … mg). The body is at rest, so the scale's reading (the weight P, the force with which the body presses on the
 * scale) is P = mg − F when pulling and P = mg + F when pressing; the force of the platform on the body, N («сила
 * реакции опоры», Irina 18 Nov 2026; F_упр before), has the same value. When the pull exceeds mg the body leaves the platform and P = 0: the picture shows it
 * 16 px above the platform (the further rise is not drawn). At F = mg exactly (5 кг, 49 Н) the body still touches the
 * platform but does not press on it.
 * Arrows: F_тяж red (on the body, from its centre, down), N green (on the body, from the platform, up), P blue (on
 * the platform, down), F gold (on the body, at the point where the hand acts). As in ForcesPicture, arrows that start
 * at the same body are drawn side by side, and a dashed line joins an arrow to its point of application. The arrows
 * are to scale within each body: mg is 36 px, so 1 Н is 36/mg px; the scale bar in the corner shows 10 Н, 50 Н or
 * 100 Н. Labels sit on fixed sides so that they never meet: F_тяж left of its tip and always below the platform, N
 * right of its foot (just above the platform), P right of its tip and below the platform, F right of its tip when
 * pulling and left of its middle when pressing (the pressing arrow stands left of the body). The spring stretches in proportion to F (drawn length 34 + 24·F/mg px). Sizes of the bodies are not to scale.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const heads = ['red', 'green', 'blue', 'gold'];
---

<G7Styles />
<figure class="g7 wtl not-content" data-wtl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 344" role="img" aria-label="Тело лежит на весах, рука тянет его вверх через пружину или давит на него сверху; стрелками показаны сила тяжести, сила реакции опоры, вес и сила руки" data-svg>
			<defs>
				{heads.map((h) => <marker id={`wtl-${uid}-${h}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class={`head--${h}`} d="M0,0 L10,5 L0,10 z" /></marker>)}
			</defs>
			<!-- the scale bar of the forces -->
			<line class="wtl__bar" data-bar x1="16" y1="28" x2="34" y2="28"></line>
			<text class="t-small t-num" data-bar-t x="16" y="18">10&nbsp;Н</text>
			<!-- the floor and the scale -->
			<line class="ln" x1="6" x2="334" y1="333" y2="333"></line>
			<rect class="wtl__base" x="40" y="220" width="260" height="104" rx="5"></rect>
			<rect class="wtl__foot" x="54" y="324" width="22" height="8" rx="2"></rect>
			<rect class="wtl__foot" x="264" y="324" width="22" height="8" rx="2"></rect>
			<rect class="wtl__plat" x="26" y="210" width="288" height="10" rx="3"></rect>
			<rect class="wtl__screen" x="46" y="244" width="92" height="30" rx="4"></rect>
			<text class="wtl__digits t-num" data-screen x="131" y="265" text-anchor="end">19,6&nbsp;Н</text>
			<text class="t-small" x="92" y="292" text-anchor="middle">весы</text>
			<!-- the hand, the spring, the body -->
			<g data-hand>
				<rect class="wtl__sleeve" x="-15" y="-260" width="30" height="206"></rect>
				<rect class="wtl__arm" x="-11" y="-56" width="22" height="36"></rect>
				<rect class="wtl__fist" x="-17" y="-28" width="34" height="28" rx="9"></rect>
				<path class="wtl__knuckle" d="M-9 -8 V-2 M0 -8 V-2 M9 -8 V-2 M-17 -18 Q-8 -16 -6 -22"></path>
			</g>
			<path class="wtl__spring" data-spring></path>
			<g data-body></g>
			<!-- the forces -->
			<path class="ln-dash" data-link></path>
			<line class="arrow arrow--red" data-a-g marker-end={`url(#wtl-${uid}-red)`}></line>
			<line class="arrow arrow--green" data-a-n marker-end={`url(#wtl-${uid}-green)`}></line>
			<line class="arrow arrow--blue" data-a-p marker-end={`url(#wtl-${uid}-blue)`}></line>
			<line class="arrow arrow--gold" data-a-f marker-end={`url(#wtl-${uid}-gold)`}></line>
			<circle class="wtl__dot wtl__dot--red" data-d-g r="3"></circle>
			<circle class="wtl__dot wtl__dot--green" data-d-n r="3"></circle>
			<circle class="wtl__dot wtl__dot--blue" data-d-p r="3"></circle>
			<circle class="wtl__dot wtl__dot--gold" data-d-f r="3"></circle>
			<text class="t-i t-red t-halo" data-l-g text-anchor="end">F<tspan class="wtl__sub" dy="4">тяж</tspan></text>
			<text class="t-i t-green t-halo" data-l-n>N</text>
			<text class="t-i t-blue t-halo" data-l-p>P</text>
			<text class="t-i t-gold t-halo" data-l-f>F</text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Тело" data-body-pick>
				<button type="button" class="g7__btn" aria-pressed="true" data-b="kb2">Гиря 2&nbsp;кг</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-b="box">Ящик 5&nbsp;кг</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-b="kb16">Гиря 16&nbsp;кг</button>
			</div>
			<div class="g7__seg" role="group" aria-label="Что делает рука" data-dir>
				<button type="button" class="g7__btn" aria-pressed="true" data-d="up">Тянем вверх</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-d="down">Давим вниз</button>
			</div>
			<label class="g7__slider">
				<span>Сила руки <i>F</i></span>
				<output data-out></output>
				<input type="range" min="0" max="30" step="1" value="0" data-f aria-label="Сила руки, ньютоны" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сила тяжести <i>F</i><sub>тяж</sub> = <i>gm</i></span><b data-r-g></b></li>
				<li><span data-r-f-name>Сила руки <i>F</i></span><b data-r-f></b></li>
				<li class="is-key"><span>Вес <i>P</i> — показание весов</span><b data-r-p></b></li>
			</ul>
			<p class="g7__msg" data-msg></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Весы показывают вес — силу, с которой тело давит на них. Стрелки нарисованы в масштабе, он показан в углу рисунка.
	</figcaption>
</figure>

<style is:global>
	.wtl__base {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.wtl__plat {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.wtl__foot {
		fill: var(--g7-line);
	}
	.wtl__screen {
		fill: color-mix(in oklab, var(--g7-green) 14%, var(--sl-color-black));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.wtl svg .wtl__digits {
		font-variant-numeric: lining-nums tabular-nums;
		font-size: 16px;
		font-weight: 700;
		fill: var(--g7-green);
	}
	.wtl__bar {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.wtl__sleeve {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.wtl__arm,
	.wtl__fist {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.wtl__knuckle {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linecap: round;
	}
	.wtl__spring {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.wtl__iron {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.wtl__handle {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.wtl__handle-edge {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 7.4;
		stroke-linecap: round;
	}
	.wtl__card {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.4;
	}
	.wtl__tape {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-3));
	}
	.wtl__rope {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.wtl svg .wtl__mass {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.wtl__dot--red {
		fill: var(--g7-red);
	}
	.wtl__dot--green {
		fill: var(--g7-green);
	}
	.wtl__dot--blue {
		fill: var(--g7-blue);
	}
	.wtl__dot--gold {
		fill: var(--g7-gold);
	}
	.wtl svg .wtl__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>

<script>
	import { el, fmtTrim, loop, segment, set } from '../g7/kit';

	const G = 9.8;
	const PT = 210; // the top of the platform
	const CX = 204; // the axis of the body
	const MG_PX = 56; // the force of gravity is always 56 px long
	const GAP = 16; // how high a lifted body is drawn
	type Body = { m: number; label: string; hw: number; off: number; top: number; mid: number; press: number; step: number; up: number; down: number; bar: number; draw: () => SVGElement[] };
	const kettle = (r: number, text: string) => () => [
		el('path', { class: 'wtl__handle-edge', d: `M${-0.62 * r} ${-1.55 * r} C${-0.62 * r} ${-2.55 * r} ${0.62 * r} ${-2.55 * r} ${0.62 * r} ${-1.55 * r}` }),
		el('path', { class: 'wtl__handle', d: `M${-0.62 * r} ${-1.55 * r} C${-0.62 * r} ${-2.55 * r} ${0.62 * r} ${-2.55 * r} ${0.62 * r} ${-1.55 * r}` }),
		el('path', { class: 'wtl__iron', d: `M${-0.55 * r} 0 A${r} ${r} 0 1 1 ${0.55 * r} 0 Z` }),
		el('text', { class: 'wtl__mass', x: 0, y: -1.2 * r, 'text-anchor': 'middle' }, text),
	];
	const BODIES: Record<string, Body> = {
		// top = where the spring is hooked (the top of the handle), mid = the centre, press = where the fist presses
		kb2: { m: 2, label: '2\u00a0кг', hw: 28, off: 16, top: -2.3 * 28, mid: -0.84 * 28, press: -2.4 * 28, step: 1, up: 30, down: 20, bar: 10, draw: kettle(28, '2\u00a0кг') },
		box: {
			m: 5,
			label: '5\u00a0кг',
			hw: 46,
			off: 16,
			top: -72,
			mid: -28,
			press: -56,
			step: 1,
			up: 75,
			down: 50,
			bar: 50,
			draw: () => [
				el('rect', { class: 'wtl__card', x: -46, y: -56, width: 92, height: 56, rx: 2 }),
				el('rect', { class: 'wtl__tape', x: -46, y: -33, width: 92, height: 7 }),
				el('path', { class: 'wtl__rope', d: 'M-14 -56 Q-14 -74 0 -73 Q14 -74 14 -56' }),
				el('text', { class: 'wtl__mass', x: -26, y: -40, 'text-anchor': 'middle' }, '5\u00a0кг'),
			],
		},
		kb16: { m: 16, label: '16\u00a0кг', hw: 38, off: 22, top: -2.3 * 38, mid: -0.84 * 38, press: -2.38 * 38, step: 2, up: 240, down: 160, bar: 100, draw: kettle(38, '16\u00a0кг') },
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-wtl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const fIn = q<HTMLInputElement>('[data-f]');
		const bodyG = q<SVGGElement>('[data-body]');
		const hand = q<SVGGElement>('[data-hand]');
		const spring = q<SVGPathElement>('[data-spring]');
		let body = BODIES.kb2;
		let up = true;
		let lift = 0; // the drawn height of the body above the platform, px
		let shown = 0; // the drawn hand force, Н (follows the slider smoothly)

		const arrow = (name: string, x: number, y1: number, y2: number, dot: [number, number]) => {
			const a = q<SVGLineElement>(`[data-a-${name}]`);
			const d = q<SVGCircleElement>(`[data-d-${name}]`);
			const on = Math.abs(y2 - y1) > 0.5;
			a.style.display = on ? '' : 'none';
			d.style.display = on ? '' : 'none';
			set(a, { x1: x, x2: x, y1: y1.toFixed(1), y2: y2.toFixed(1) });
			set(d, { cx: dot[0], cy: dot[1].toFixed(1) });
			return on;
		};
		const label = (name: string, x: number, y: number, on: boolean) => {
			const t = q<SVGTextElement>(`[data-l-${name}]`);
			t.style.display = on ? '' : 'none';
			set(t, { x, y: y.toFixed(1) });
		};

		const draw = () => {
			const mg = Math.round(body.m * G * 10) / 10;
			const px = MG_PX / mg;
			const F = shown;
			const touching = !(up && F > mg + 1e-9);
			const P = touching ? (up ? mg - F : mg + F) : 0;
			const base = PT - lift; // the bottom of the body
			bodyG.setAttribute('transform', `translate(${CX} ${base.toFixed(1)})`);
			// the hand: above the spring when pulling, on top of the body when pressing; hidden when it does nothing
			const handOn = F > 0.01 || !up;
			hand.style.display = handOn ? '' : 'none';
			let gold: [number, number, number]; // x, from, to
			if (up) {
				const len = 34 + (24 * F) / mg;
				const y0 = base + body.top;
				const y1 = y0 - len;
				hand.setAttribute('transform', `translate(${CX} ${(y1 - 4).toFixed(1)})`);
				let d = `M${CX} ${y0.toFixed(1)} v-6`;
				const n = 14;
				for (let i = 1; i < n; i++) d += ` L${CX + (i % 2 ? 7 : -7)} ${(y0 - 6 - ((len - 12) * i) / n).toFixed(1)}`;
				d += ` L${CX} ${(y1 + 6).toFixed(1)} V${(y1 - 4).toFixed(1)}`;
				spring.setAttribute('d', handOn ? d : '');
				gold = [y0, y0, y0 - F * px];
			} else {
				const y0 = base + body.press;
				hand.setAttribute('transform', `translate(${CX} ${y0.toFixed(1)})`);
				spring.setAttribute('d', '');
				gold = [y0, y0, y0 + F * px];
			}
			// pulling: to the right of the body; pressing: to the left, so that it does not hide the weight
			const XF = up ? CX + 44 : CX - body.hw - 14;
			const fOn = arrow('f', XF, gold[1], gold[2], [XF, gold[0]]);
			q('[data-link]').setAttribute('d', fOn ? `M${CX} ${gold[0].toFixed(1)} H${XF}` : '');
			label('f', up ? XF + 8 : XF - 8, up ? gold[2] + 6 : (gold[1] + gold[2]) / 2 + 5, fOn);
			q('[data-l-f]').setAttribute('text-anchor', up ? 'start' : 'end');
			// the force of gravity: from the centre of the body, down
			const XG = CX - body.off;
			const yc = base + body.mid;
			arrow('g', XG, yc, yc + mg * px, [XG, yc]);
			label('g', XG - 6, Math.max(yc + mg * px + 4, PT + 24), true); // always below the platform
			// the force of the support N (on the body, up) and the weight (on the platform, down)
			const XN = CX + body.off;
			const nOn = arrow('n', XN, PT, PT - P * px, [XN, PT]);
			label('n', XN + 5, PT - 12, nOn); // right of the arrow's foot, just above the platform
			const XP = CX + 44;
			const pOn = arrow('p', XP, PT, PT + P * px, [XP, PT]);
			label('p', XP + 8, Math.max(PT + P * px + 5, PT + 24), pOn);
		};

		const update = () => {
			const mg = Math.round(body.m * G * 10) / 10;
			const F = Number(fIn.value);
			const P = up ? Math.max(0, mg - F) : mg + F;
			const s = (v: number) => `${fmtTrim(v, 1)}\u00a0Н`;
			q('[data-out]').textContent = F ? `${F}\u00a0Н ${up ? 'вверх' : 'вниз'}` : 'нет';
			q('[data-screen]').textContent = s(P);
			q('[data-r-g]').textContent = s(mg);
			q('[data-r-f]').textContent = F ? s(F) : '0\u00a0Н';
			q('[data-r-f-name]').innerHTML = `Сила руки <i>F</i> ${up ? 'вверх' : 'вниз'}`;
			q('[data-r-p]').textContent = s(P);
			let msg: string;
			if (!F) msg = `Рука не действует. Тело давит на весы так же сильно, как Земля притягивает его: <i>P</i> = <i>F</i><sub>тяж</sub> = ${s(mg)}.`;
			else if (!up) msg = `Рука давит на тело вниз, и тело сильнее давит на весы: <i>P</i> = ${s(mg)} + ${s(F)} = ${s(P)}. Масса тела не изменилась — ${body.label}.`;
			else if (F < mg) msg = `Рука держит часть тяжести тела, и оно слабее давит на весы: <i>P</i> = ${s(mg)} − ${s(F)} = ${s(P)}. Масса тела не изменилась — ${body.label}.`;
			else if (F === mg) msg = `Рука тянет вверх с силой, равной силе тяжести. Тело ещё касается весов, но уже не давит на них: <i>P</i> = 0.`;
			else msg = `Рука тянет вверх сильнее, чем Земля притягивает тело. Тело оторвалось от весов, весы показывают 0.`;
			q('[data-msg]').innerHTML = msg;
			wake();
		};

		const setBody = () => {
			const mg = Math.round(body.m * G * 10) / 10;
			bodyG.replaceChildren(...body.draw());
			const bar = q<SVGLineElement>('[data-bar]');
			bar.setAttribute('x2', (16 + (body.bar * MG_PX) / mg).toFixed(1));
			q('[data-bar-t]').textContent = `${body.bar}\u00a0Н`;
		};
		const setRange = () => {
			fIn.step = String(body.step);
			fIn.max = String(up ? body.up : body.down);
			if (Number(fIn.value) > Number(fIn.max)) fIn.value = fIn.max;
		};

		const wake = loop(root, (dt) => {
			const mg = Math.round(body.m * G * 10) / 10;
			const F = Number(fIn.value);
			const k = 1 - Math.exp(-dt / 0.08);
			shown += (F - shown) * k;
			if (Math.abs(F - shown) < 0.01 * mg) shown = F;
			const target = up && F > mg ? GAP : 0;
			lift += (target - lift) * (1 - Math.exp(-dt / 0.12));
			if (Math.abs(target - lift) < 0.2) lift = target;
			draw();
			return shown !== F || lift !== target;
		});

		segment(q('[data-body-pick]'), (b) => {
			body = BODIES[b.dataset.b!];
			fIn.value = '0';
			shown = 0;
			lift = 0;
			setBody();
			setRange();
			update();
			draw();
		});
		segment(q('[data-dir]'), (b) => {
			up = b.dataset.d === 'up';
			shown = 0;
			setRange();
			update();
			draw();
		});
		fIn.addEventListener('input', update);
		setBody();
		setRange();
		update();
		draw();
	}
</script>
