---
/**
 * Picture «Куда направлена сила тяжести» (Irina, 17 Nov 2026: «Сила тяжести, где написано, что она направлена всегда
 * вертикально вниз — нужен рисунок»).
 *
 * Left: the Earth with five people — at the North Pole, in Russia (Moscow, 56° с. ш.), on the equator, in Australia
 * (Sydney, 34° ю. ш.) and at the South Pole. Each stands at the real latitude of the place; their longitudes differ,
 * so the circle is a scheme, not a cut along one meridian. Each person has a red arrow F_тяж from the middle of the
 * body to the centre of the Earth (dashed continuations meet at the centre): «вниз» everywhere means «к центру
 * Земли». Every person (the shared people kit) drops an apple from about 0,77 м (the hand at 14 px of a 26 px tall
 * person of 1,7 м); it falls towards the centre in 0,40 с = √(2h/g), real time, lies 1,4 с and is back in the hand.
 * NOT to scale: the Earth's radius is 6371 км, a person 1,7 м, about 3,7 million times less; the people are drawn huge
 * (the caption says it). Gravity points to the centre to within 0,2° (the Earth is slightly flattened and rotates),
 * which no drawing can show.
 *
 * Right: a builder's plumb line (отвес) on a brick wall about 1 м tall, 200 px per м; the thread is 0,8 м long. The bob
 * is let go at 10° and swings with the real period 2π√(L/g) = 1,8 с; the damping is exaggerated (it stops in a few
 * seconds instead of about a minute). The arrow F_тяж on the bob stays vertical while the bob swings; at rest the thread
 * lies along it — the vertical. Loop: 7 s of swinging, 2 s at rest.
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const C = { x: 180, y: 172 };
const R = 95;
const rad = (a: number) => (a * Math.PI) / 180;
const at = (a: number, r: number) => ({ x: C.x + r * Math.cos(rad(a)), y: C.y - r * Math.sin(rad(a)) });
const f = (v: number) => v.toFixed(1);
// angle on the drawing (0° — right, 90° — up), side of the F label (+1 counterclockwise of the arrow)
const PLACES = [
	{ name: 'Северный полюс', a: 90, side: -1 },
	{ name: 'Россия', a: 180 - 56, side: 1 },
	{ name: 'экватор', a: 0, side: 1 },
	{ name: 'Австралия', a: 180 + 34, side: -1 },
	{ name: 'Южный полюс', a: 270, side: 1 },
].map((p) => {
	const from = at(p.a, R + 13);
	const to = at(p.a, R - 24);
	const mid = at(p.a, R - 38);
	const tx = -Math.sin(rad(p.a));
	const ty = -Math.cos(rad(p.a));
	const lab = { x: mid.x + p.side * 15 * tx, y: mid.y + p.side * 15 * ty + 4 };
	const nm = at(p.a, R + 40);
	const c = Math.cos(rad(p.a));
	const anchor = Math.abs(c) < 0.3 || p.a === 0 ? 'middle' : c > 0 ? 'start' : 'end';
	// the equator: the name above the person, so that it stays inside the picture
	const nameXY = p.a === 0 ? { x: C.x + R + 14, y: C.y - 14 } : { x: nm.x, y: nm.y + 4 };
	return { ...p, from, to, lab, foot: at(p.a, R), rot: 90 - p.a, anchor, nameXY };
});
// the plumb line
const P = { x: 106, y: 100 };
const L = 160;
const BOB = 24;
---

<G7Styles />
<KitStyles />
<figure class="g7 g7--pic gdp not-content" data-gdp>
	<div class="gdp__grid">
		<svg class="g7__svg" viewBox="0 0 360 330" role="img" aria-label="Земля и люди в пяти местах: на Северном полюсе, в России, на экваторе, в Австралии и на Южном полюсе. У каждого стрелка силы тяжести направлена к центру Земли">
			<defs>
				<marker id={`gdp-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<text class="t-title" x="180" y="17" text-anchor="middle">«Вниз» — значит к центру Земли</text>
			<circle class="gdp__earth" cx={C.x} cy={C.y} r={R}></circle>
			<path class="ln-dash gdp__axis" d={`M${C.x} ${C.y - R} V${C.y + R} M${C.x - R} ${C.y} H${C.x + R}`}></path>
			{PLACES.map((p) => <path class="gdp__ray" d={`M${f(p.to.x)} ${f(p.to.y)} L${C.x} ${C.y}`} />)}
			<circle class="gdp__centre" cx={C.x} cy={C.y} r="3.5"></circle>
			<text class="t-small t-halo" x={C.x + 6} y={C.y + 16}>центр Земли</text>
			{
				PLACES.map((p) => (
					<g transform={`translate(${f(p.foot.x)} ${f(p.foot.y)}) rotate(${p.rot})`}>
						<path class="gdp__ground" d="M-13 1.5 Q0 3 13 1.5"></path>
						<g data-man></g>
						<circle class="gdp__apple" cx="7" cy="-14" r="2.4" data-apple></circle>
					</g>
				))
			}
			{PLACES.map((p) => <line class="arrow arrow--red" x1={f(p.from.x)} y1={f(p.from.y)} x2={f(p.to.x)} y2={f(p.to.y)} marker-end={`url(#gdp-${uid})`} />)}
			{
				PLACES.map((p) => (
					<text class="t-i t-red t-halo" x={f(p.lab.x)} y={f(p.lab.y)} text-anchor="middle">
						F<tspan class="gdp__sub" dy="4">тяж</tspan>
					</text>
				))
			}
			{
				PLACES.map((p) => (
					<text class="t-strong t-halo gdp__place" x={f(p.nameXY.x)} y={f(p.nameXY.y)} text-anchor={p.anchor}>
						{p.name}
					</text>
				))
			}
		</svg>

		<svg class="g7__svg gdp__plumb" viewBox="0 0 200 330" role="img" aria-label="Отвес строителя: грузик на нити висит вдоль вертикали у кирпичной стены. Сила тяжести грузика направлена вертикально вниз">
			<defs>
				<marker id={`gdp2-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<text class="t-title" x="100" y="17" text-anchor="middle">Отвес строителя</text>
			<path class="gdp__floor" d="M4 312.5 H196"></path>
			{
				Array.from({ length: 18 }, (_, row) => {
					const y = 312 - (row + 1) * 12;
					const off = row % 2 ? 0 : 13;
					return Array.from({ length: 4 }, (_, i) => {
						const x0 = Math.max(14, 14 - 13 + off + i * 26);
						const x1 = Math.min(92, 14 - 13 + off + i * 26 + 25);
						return x1 - x0 > 4 ? <rect class="gdp__brick" x={x0} y={y} width={x1 - x0} height="11" rx="1" /> : null;
					});
				})
			}
			<rect class="gdp__holder" x="92" y="94" width="16" height="10" rx="1.5"></rect>
			<path class="ln-dash" d={`M${P.x} 46 V312`}></path>
			<text class="t-small t-halo" x={P.x + 6} y="56">вертикаль</text>
			<g data-bob>
				<line class="gdp__thread" x1={P.x} y1={P.y} x2={P.x} y2={P.y + L}></line>
				<path class="gdp__bob" d={`M${P.x - 7} ${P.y + L} H${P.x + 7} V${P.y + L + 8} L${P.x} ${P.y + L + BOB} L${P.x - 7} ${P.y + L + 8} Z`}></path>
			</g>
			<line class="arrow arrow--red" x1={P.x} y1={P.y + L + 9} x2={P.x} y2={P.y + L + 44} marker-end={`url(#gdp2-${uid})`} data-farrow></line>
			<circle class="gdp__dot" cx={P.x} cy={P.y + L + 9} r="2.6" data-fdot></circle>
			<text class="t-i t-red t-halo" x={P.x + 12} y={P.y + L + 42} data-flab>F<tspan class="gdp__sub" dy="4">тяж</tspan></text>
			<text class="t-small t-halo" x={P.x + 14} y={P.y + 70}>нить</text>
			<text class="t-small t-halo" x={P.x + 16} y={P.y + L + 8} data-boblab>грузик</text>
			<text class="t-small" x="53" y="326" text-anchor="middle">стена</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Где бы ни стоял человек, сила тяжести направлена к центру Земли — это и есть «вниз», а нить отвеса показывает это направление, вертикаль. Земля и люди нарисованы не в масштабе: человек почти в 4 миллиона раз меньше радиуса Земли.
	</figcaption>
</figure>

<style is:global>
	.gdp__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
		gap: 0.75rem;
		align-items: start;
	}
	@container (max-width: 34rem) {
		.gdp__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.gdp__plumb {
			max-width: 14rem;
			margin-inline: auto;
		}
	}
	.gdp__earth {
		fill: color-mix(in oklab, var(--ig-vx) 22%, var(--g7-paper));
		stroke: var(--g7-water-edge);
		stroke-width: 1.4;
	}
	.gdp__axis {
		opacity: 0.55;
	}
	.gdp__ray {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		opacity: 0.7;
	}
	.gdp__centre {
		fill: var(--g7-ink);
	}
	.gdp__ground {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.gdp__apple {
		fill: var(--g7-red);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.gdp__place {
		font-size: 12px;
	}
	.gdp svg .gdp__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
	.gdp__floor {
		stroke: var(--g7-wood);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.gdp__brick {
		fill: color-mix(in oklab, var(--g7-red) 34%, var(--sl-color-gray-5));
		stroke: var(--g7-paper);
		stroke-width: 0.8;
	}
	.gdp__holder {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.gdp__thread {
		stroke: var(--g7-ink);
		stroke-width: 1.3;
	}
	.gdp__bob {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.1;
		stroke-linejoin: round;
	}
	.gdp__dot {
		fill: var(--g7-red);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { figure } from '@components/people/body';
	import { blendShape, handShape } from '@components/people/hand';

	const G = 9.8;
	// the apples: 0,77 м in 0,40 с
	const MAN = 1.7; // м, a person
	const MAN_PX = 26;
	const DROP_PX = 14 - 2.4; // from the hand to the ground
	const H = (DROP_PX * MAN) / MAN_PX;
	const T_FALL = Math.sqrt((2 * H) / G);
	const T_APPLE = 0.6 + T_FALL + 1.4;
	// the plumb line
	const P = { x: 106, y: 100 };
	const L_M = 0.8;
	const W = Math.sqrt(G / L_M); // rad/s
	const TAU = 1.6; // s, the damping (exaggerated)
	const TH0 = (10 * Math.PI) / 180;
	const RUN = 7;
	const HOLD = 2;
	const L = 160;

	for (const root of document.querySelectorAll<HTMLElement>('[data-gdp]')) {
		const apples = [...root.querySelectorAll<SVGCircleElement>('[data-apple]')];
		// the people (the shared people kit), 26 px for 1,7 м, each in its group turned so that its feet are on the
		// ground; the near hand holds the apple from above (its top at 16,4 px) and opens to let it go
		const S = MAN_PX / 170;
		const people = [...root.querySelectorAll<SVGGElement>('[data-man]')].map((g) => figure(g, { s: S, H: 170, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'man' }));
		const GRIP = handShape('grip', 0.6);
		const OPEN = handShape('open');
		const posePeople = (open: number) => {
			const shape = blendShape(GRIP, OPEN, open);
			for (const fig of people)
				fig.pose({
					hip: { x: 0, y: -0.515 * MAN_PX },
					lean: 0,
					ankles: [
						{ x: 1, y: -7 * S },
						{ x: -1, y: -7 * S },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: 7, y: -16.4 }, pose: open < 0.5 ? 'grip' : 'open', shape, dir: Math.PI / 2 - 0.3, contact: open < 0.5 ? 'apple' : '' },
						{ arm: [Math.PI / 2 + 0.05, 0.2], pose: 'relaxed' },
					],
				});
		};
		const bob = root.querySelector<SVGGElement>('[data-bob]')!;
		const farrow = root.querySelector<SVGLineElement>('[data-farrow]')!;
		const fdot = root.querySelector<SVGCircleElement>('[data-fdot]')!;
		const flab = root.querySelector<SVGTextElement>('[data-flab]')!;
		const boblab = root.querySelector<SVGTextElement>('[data-boblab]')!;
		let t = 0;
		const draw = () => {
			// apples: in the hand 0,6 с, falling, lying
			const ta = t % T_APPLE;
			const u = ta < 0.6 ? 0 : Math.min(1, ((ta - 0.6) / T_FALL) ** 2);
			for (const a of apples) a.setAttribute('cy', (-14 + DROP_PX * u).toFixed(2));
			// the hand opens just before the apple falls (0,45…0,6 с) and closes again when it is back
			posePeople(Math.min(1, Math.max(0, (ta - 0.45) / 0.15)));
			// the plumb line
			const tp = t % (RUN + HOLD);
			const th = tp < RUN ? TH0 * Math.exp(-tp / TAU) * Math.cos(W * tp) : 0;
			const deg = (-th * 180) / Math.PI;
			bob.setAttribute('transform', `rotate(${deg.toFixed(2)} ${P.x} ${P.y})`);
			// the centre of the bob, where F_тяж starts
			const cx = P.x + Math.sin(th) * (L + 9);
			const cy = P.y + Math.cos(th) * (L + 9);
			farrow.setAttribute('x1', cx.toFixed(1));
			farrow.setAttribute('x2', cx.toFixed(1));
			farrow.setAttribute('y1', cy.toFixed(1));
			farrow.setAttribute('y2', (cy + 35).toFixed(1));
			fdot.setAttribute('cx', cx.toFixed(1));
			fdot.setAttribute('cy', cy.toFixed(1));
			flab.setAttribute('x', (cx + 12).toFixed(1));
			boblab.setAttribute('x', (cx + 16).toFixed(1));
		};
		loop(root, (dt) => {
			t += dt;
			if (t > 1e4) t = 0;
			draw();
			return true;
		});
		draw();
	}
</script>
