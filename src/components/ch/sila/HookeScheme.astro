---
/**
 * Scheme «Закон Гука: l₀, l и Δl» (Irina, 17 Nov 2026: «рисунок-схему для закона Гука: пружина собственной длины l₀,
 * растянутая пружина длиной l под действием силы тяжести, направление сил. Написать, что Δl — это разность конечной
 * длины и начальной»).
 *
 * Two equal springs on one support with a ruler whose zero is at the support. Left: the free spring, l₀ = 10 см.
 * Right: the same spring with a brass weight of 200 г (a cylinder 3 см wide and 3,3 см tall: 23,3 см³ × 8,5 г/см³ ≈
 * 200 г). Stiffness k = 49 Н/м (the stiff spring of SpringLab), g = 9,8 Н/кг (as everywhere in the chapter):
 * F_тяж = 9,8 Н/кг · 0,2 кг = 1,96 Н, Δl = F/k = 1,96 Н : 49 Н/м = 0,04 м = 4 см, l = 14 см.
 * Scale: springs, weight and ruler 12 px per см; forces 20 px per Н (1,96 Н → 39 px). F_тяж starts at the centre of
 * the weight, F_упр at the hook where the spring holds the weight.
 * Animation: the weight is brought up to the free spring and let go; it swings with the real period
 * 2π√(m/k) = 0,40 с, while the arrow F_упр = kΔl follows the stretch and F_тяж stays the same; the damping is
 * exaggerated (it settles in about 1,5 с, a real spring swings longer — the caption says it). At rest the two arrows
 * are equal, and the brackets l and Δl appear. 10 s loop; «Повторить» restarts it.
 */
import katex from 'katex';
import G7Styles from '../g7/G7Styles.astro';

const k = (s: string) => katex.renderToString(s, { throwOnError: false });
const uid = Math.random().toString(36).slice(2, 8);
const TOP = 34; // the support, 0 on the ruler
const CM = 12;
const L0 = 10;
const DL = 4;
const XA = 75;
const XB = 210;
const RX0 = 120; // the ruler
const FPX = 20; // px per Н
const F = 1.96;
const E0 = TOP + L0 * CM; // 154
const E1 = TOP + (L0 + DL) * CM; // 202
/** A spring hanging from the support at x down to the hook at y = end. */
const coil = (x: number, end: number) => {
	const turns = 11;
	let d = `M${x} ${TOP} V${TOP + 8}`;
	const a = TOP + 8;
	const b = end - 10;
	for (let i = 1; i <= turns * 2; i++) d += ` L${i % 2 ? x + 10 : x - 10} ${(a + ((b - a) * (i - 0.5)) / (turns * 2)).toFixed(1)}`;
	d += ` L${x} ${b} V${end}`;
	return d;
};
const lines = [
	{ key: true, tex: '\\Delta l = l - l_0 = 14~\\text{см} - 10~\\text{см} = 4~\\text{см}' },
	{ key: false, tex: 'F_{\\text{тяж}} = gm = 9{,}8~\\text{Н/кг} \\cdot 0{,}2~\\text{кг} = 1{,}96~\\text{Н}' },
	{ key: false, tex: 'F_{\\text{упр}} = k\\,\\Delta l = 49~\\text{Н/м} \\cdot 0{,}04~\\text{м} = 1{,}96~\\text{Н}' },
];
---

<G7Styles />
<figure class="g7 hks not-content" data-hks>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Две одинаковые пружины на одной опоре и линейка. Пружина без груза длиной 10 см; та же пружина с грузом 200 г длиной 14 см; удлинение 4 см. На груз действуют сила тяжести вниз и сила упругости пружины вверх, они равны">
			<defs>
				<marker id={`hks-${uid}-red`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`hks-${uid}-green`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path class="head--green" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<!-- the support -->
			<path class="hks__hatch" d={Array.from({ length: 22 }, (_, i) => `M${44 + i * 10} ${TOP - 2} l8 -8`).join(' ')}></path>
			<path class="hks__beam" d={`M42 ${TOP} H262`}></path>
			<!-- the ruler, zero at the support -->
			<rect class="hks__ruler" x={RX0} y={TOP} width="22" height={16 * CM + 4}></rect>
			{Array.from({ length: 17 }, (_, i) => <line class="hks__tick" x1={RX0} x2={RX0 + (i % 2 === 0 ? 7 : 4)} y1={TOP + i * CM} y2={TOP + i * CM} />)}
			{Array.from({ length: 9 }, (_, i) => <text class="t-small t-num" x={RX0 + 20} y={TOP + i * 2 * CM + 4} text-anchor="end">{i * 2}</text>)}
			<text class="t-small" x={RX0 + 11} y={TOP + 16 * CM + 18} text-anchor="middle">см</text>
			<!-- levels -->
			<path class="ln-dash" d={`M${XA + 12} ${E0} H${RX0} M${RX0 + 22} ${E0} H262`}></path>
			<path class="ln-dash" d={`M${RX0 + 22} ${E1} H${XB - 12} M${XB + 12} ${E1} H336`} data-show></path>
			<!-- the free spring -->
			<path class="hks__coil" d={coil(XA, E0)}></path>
			<circle class="hks__ring" cx={XA} cy={E0 + 3} r="3"></circle>
			<path class="ln" d={`M40 ${TOP} V${E0} M36 ${TOP} H44 M36 ${E0} H44`}></path>
			<text class="t-i t-strong t-halo" x="31" y={(TOP + E0) / 2} text-anchor="middle" transform={`rotate(-90 31 ${(TOP + E0) / 2})`}>l<tspan class="hks__sub" dy="4">0</tspan><tspan class="hks__eq" dy="-4"> = 10 см</tspan></text>
			<text class="t-small" x={XA} y="292" text-anchor="middle">без груза</text>
			<!-- the spring with the weight -->
			<path class="hks__coil" d={coil(XB, E0)} data-coil></path>
			<g data-weight>
				<circle class="hks__ring" cx={XB} cy="3" r="3"></circle>
				<path class="hks__hookw" d={`M${XB} 6 V9`}></path>
				<rect class="hks__weight" x={XB - 18} y="9" width="36" height="40" rx="2"></rect>
				<rect class="hks__weight-top" x={XB - 18} y="9" width="36" height="5" rx="2"></rect>
				<text class="hks__mass t-num" x={XB} y="25" text-anchor="middle">200 г</text>
			</g>
			<text class="t-small" x={XB} y="292" text-anchor="middle">с грузом</text>
			<!-- forces -->
			<g data-forces>
				<line class="arrow arrow--green" x1={XB} y1={E1} x2={XB} y2={E1 - F * FPX} marker-end={`url(#hks-${uid}-green)`} data-fup></line>
				<line class="arrow arrow--red" x1={XB} y1={E1 + 29} x2={XB} y2={E1 + 29 + F * FPX} marker-end={`url(#hks-${uid}-red)`} data-fdown></line>
				<circle class="hks__dot hks__dot--green" cx={XB} cy={E1} r="2.8" data-dup></circle>
				<circle class="hks__dot hks__dot--red" cx={XB} cy={E1 + 29} r="2.8" data-ddown></circle>
				<text class="t-i t-green t-halo" x={XB - 16} y={E1 - 18} text-anchor="end" data-lup>F<tspan class="hks__sub" dy="4">упр</tspan></text>
				<text class="t-i t-red t-halo" x={XB - 22} y={E1 + 62} text-anchor="end" data-ldown>F<tspan class="hks__sub" dy="4">тяж</tspan></text>
			</g>
			<!-- brackets l and Δl -->
			<g data-show>
				<path class="ln hks__br" d={`M250 ${E0} V${E1} M246 ${E0} H254 M246 ${E1} H254`}></path>
				<text class="t-i t-gold t-halo" x="258" y={(E0 + E1) / 2 + 5}>Δl<tspan class="hks__eq"> = 4 см</tspan></text>
				<path class="ln hks__br" d={`M336 ${TOP} V${E1} M332 ${TOP} H340 M332 ${E1} H340`}></path>
				<text class="t-i t-strong t-halo" x="348" y={(TOP + E1) / 2} text-anchor="middle" transform={`rotate(-90 348 ${(TOP + E1) / 2})`}>l<tspan class="hks__eq"> = 14 см</tspan></text>
			</g>
		</svg>
		<div class="g7__side">
			<ol class="g7__lines">
				{lines.map((l) => <li class={l.key ? 'is-key' : undefined} set:html={k(l.tex)} />)}
				<li class="is-text">Жёсткость пружины <i>k</i> = 49&nbsp;Н/м, масса груза <i>m</i> = 200&nbsp;г, <i>g</i> = 9,8&nbsp;Н/кг.</li>
			</ol>
			<button type="button" class="g7__btn g7__again" data-again>Повторить</button>
		</div>
	</div>
	<figcaption class="g7__caption">
		Груз висит неподвижно, поэтому сила упругости равна силе тяжести и стрелки одной длины. Длины и силы нарисованы в масштабе; настоящая пружина качается дольше, чем здесь.
	</figcaption>
</figure>

<style is:global>
	.hks__beam {
		stroke: var(--g7-ink);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.hks__hatch {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.hks__ruler {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-6));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.hks__tick {
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.hks__coil {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.hks__ring {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.hks__hookw {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.hks__weight {
		fill: color-mix(in oklab, var(--ig-v) 48%, var(--sl-color-gray-5));
		stroke: var(--g7-ink);
		stroke-width: 1.1;
	}
	.hks__weight-top {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.hks svg .hks__mass {
		font-size: 10.5px;
		font-weight: 700;
		fill: var(--sl-color-black);
	}
	.hks__dot--green {
		fill: var(--g7-green);
	}
	.hks__dot--red {
		fill: var(--g7-red);
	}
	.hks svg .hks__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
	.hks svg .hks__eq {
		font-style: normal;
		font-family: var(--__sl-font);
		font-size: 12px;
	}
	.hks__br {
		stroke: var(--g7-ink);
	}
	.hks [data-show],
	.hks [data-forces] {
		transition: opacity 0.4s;
	}
</style>

<script>
	import { ease, loop } from '../g7/kit';

	const TOP = 34;
	const CM = 12;
	const XB = 210;
	const E0 = TOP + 10 * CM;
	const FPX = 20;
	const K = 49; // Н/м
	const M = 0.2; // кг
	const G = 9.8;
	const FG = M * G; // 1,96 Н
	const DL = FG / K; // 0,04 м
	const W0 = Math.sqrt(K / M); // 15,65 рад/с
	const GAM = 3; // 1/с, exaggerated damping
	const WD = Math.sqrt(W0 * W0 - GAM * GAM);
	// timeline, s
	const T_IN = 0.6;
	const T_HOOK = 2.0;
	const T_SHOW = 3.6;
	const T_OUT = 9.4;
	const CYCLE = 10;
	const coil = (x: number, end: number) => {
		const turns = 11;
		let d = `M${x} ${TOP} V${TOP + 8}`;
		const a = TOP + 8;
		const b = end - 10;
		for (let i = 1; i <= turns * 2; i++) d += ` L${i % 2 ? x + 10 : x - 10} ${(a + ((b - a) * (i - 0.5)) / (turns * 2)).toFixed(1)}`;
		d += ` L${x} ${b} V${end}`;
		return d;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-hks]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const coilB = q<SVGPathElement>('[data-coil]');
		const weight = q<SVGGElement>('[data-weight]');
		const forces = q<SVGGElement>('[data-forces]');
		const shows = [...root.querySelectorAll<SVGElement>('[data-show]')];
		const fup = q<SVGLineElement>('[data-fup]');
		const fdown = q<SVGLineElement>('[data-fdown]');
		const dup = q<SVGCircleElement>('[data-dup]');
		const ddown = q<SVGCircleElement>('[data-ddown]');
		const lup = q<SVGTextElement>('[data-lup]');
		const ldown = q<SVGTextElement>('[data-ldown]');
		let t = 0;
		const draw = () => {
			let x = 0; // м, the stretch
			let hookY = E0; // where the ring of the weight is
			let alpha = 1;
			if (t < T_HOOK) {
				// the weight comes up to the hook of the free spring
				const u = ease((t - T_IN) / (T_HOOK - T_IN));
				hookY = E0 + (1 - u) * 90;
				alpha = Math.min(1, t / T_IN);
			} else {
				const s = t - T_HOOK;
				x = DL * (1 - Math.exp(-GAM * s) * (Math.cos(WD * s) + (GAM / WD) * Math.sin(WD * s)));
				hookY = E0 + x * 100 * CM;
				if (t > T_OUT) alpha = Math.max(0, 1 - (t - T_OUT) / 0.5);
			}
			const end = t < T_HOOK ? E0 : hookY;
			coilB.setAttribute('d', coil(XB, end));
			weight.setAttribute('transform', `translate(0 ${hookY.toFixed(2)})`);
			weight.setAttribute('opacity', alpha.toFixed(2));
			// forces on the weight once it hangs: F_упр = kx follows the stretch
			const hang = t >= T_HOOK && t <= T_OUT;
			forces.setAttribute('opacity', hang ? '1' : '0');
			const fu = K * x * FPX;
			fup.setAttribute('y1', end.toFixed(1));
			fup.setAttribute('y2', (end - Math.max(fu, 0.01)).toFixed(1));
			fup.setAttribute('visibility', fu > 6 ? 'visible' : 'hidden');
			dup.setAttribute('cy', end.toFixed(1));
			lup.setAttribute('y', (end - 18).toFixed(1));
			const c = end + 29;
			fdown.setAttribute('y1', c.toFixed(1));
			fdown.setAttribute('y2', (c + FG * FPX).toFixed(1));
			ddown.setAttribute('cy', c.toFixed(1));
			ldown.setAttribute('y', (c + 33).toFixed(1));
			const on = t >= T_SHOW && t <= T_OUT;
			for (const s of shows) s.setAttribute('opacity', on ? '1' : '0');
		};
		const wake = loop(root, (dt) => {
			t += dt;
			if (t >= CYCLE) t = 0;
			draw();
			return true;
		});
		q('[data-again]').addEventListener('click', () => {
			t = 0;
			draw();
			wake();
		});
		draw();
	}
</script>
