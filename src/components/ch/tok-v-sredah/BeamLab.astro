---
/**
 * «Электронно-лучевая трубка». Side view of a glass tube: a heated cathode (glowing filament), an anode with a hole (the
 * electron gun), a pair of horizontal deflecting plates and a round screen; under it the screen seen from the front
 * (10 см across, a grid of 1 см) with the glowing spot.
 * Physics: the electrons leave the cathode slowly and gain m_eυ²/2 = eU between cathode and anode, υ = √(2eU/m) with
 * e = 1,6·10⁻¹⁹ Кл, m = 9,1·10⁻³¹ кг: 1 кВ 1,88; 2 кВ 2,65; 3 кВ 3,25; 4 кВ 3,75; 5 кВ 4,19 (·10⁷ м/с).
 * Plates l = 4 см long, d = 1 см apart, the screen L = 20 см from their middle; with U_п on the plates the beam leaves
 * them at y₁ = U_п·l²/(4dU) and hits the screen at Y = U_п·l·L/(2dU) = 40·U_п/U см (2 кВ, 100 В → 2,0 см;
 * 1 кВ → 4,0; 4 кВ → 1,0; 5 кВ → 0,8 см). The beam bends toward the «+» plate (the upper plate is «+» for U_п > 0).
 * Drawing: 10 px per см along the tube and on the screen (the deflection is true to scale), but the gap between the
 * plates is drawn 3,6 times wider than 1 см so that the field arrow «E⃗» fits; the tube is shorter than a real one.
 * The blue dots fly at a symbolic speed proportional to υ (150 px/s at 1 кВ). Controls: U = 1…5 кВ (step 0,5),
 * U_п = −100…+100 В (step 10). No «U for a given υ» and no flight time: the worked task after the model asks for them.
 */
import G7Styles from '../g7/G7Styles.astro';

const AX = 95; // the tube's axis
const XS = 324; // the screen
---

<G7Styles />
<figure class="g7 bml not-content" data-bml>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 296" role="img" aria-label="Электронно-лучевая трубка сбоку и её экран спереди: катод, анод с отверстием, две отклоняющие пластины и экран. Пучок электронов летит от катода к экрану и отклоняется к положительной пластине">
			<defs>
				<marker id="bml-g" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--gold" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<!-- the glass: a neck and a cone to the screen -->
			<path class="bml-glass" d={`M8 63 H160 L318 39 Q330 ${AX} 318 151 L160 127 H8 Q2 ${AX} 8 63 Z`}></path>
			<path class="bml-screen" d={`M318 41 Q329 ${AX} 318 149`}></path>
			<!-- the cathode: the glowing filament in a cap -->
			<path class="bml-cap" d={`M14 ${AX - 12} H32 V${AX + 12} H14`}></path>
			<path class="bml-fil" d={`M18 ${AX - 7} L24 ${AX - 4} L18 ${AX - 1} L24 ${AX + 2} L18 ${AX + 5} L24 ${AX + 8}`}></path>
			<!-- the anode with a hole -->
			<rect class="bml-anode" x="62" y={AX - 24} width="5" height="20"></rect>
			<rect class="bml-anode" x="62" y={AX + 4} width="5" height="20"></rect>
			<!-- the plates -->
			<rect class="bml-plate" x="104" y={AX - 21} width="40" height="3"></rect>
			<rect class="bml-plate" x="104" y={AX + 18} width="40" height="3"></rect>
			<text class="bml-sign" data-sup x="152" y={AX - 18} text-anchor="middle"></text>
			<text class="bml-sign" data-sdn x="152" y={AX + 28} text-anchor="middle"></text>
			<line class="bml-e" data-e x1="107" x2="107" y1="0" y2="0" marker-end="url(#bml-g)"></line>
			<g data-elabel>
				<text class="bml-el" x="86" y={AX - 5}>E</text>
				<path class="bml-earrow" d={`M86.5 ${AX - 17} H96 M93.5 ${AX - 19} L96 ${AX - 17} L93.5 ${AX - 15}`}></path>
			</g>
			<!-- the beam -->
			<path class="bml-beam" data-beam d=""></path>
			<g data-dots></g>
			<ellipse class="bml-spot" data-spot cx={XS} cy={AX} rx="2.4" ry="4"></ellipse>
			<text class="bml-t" x="24" y="146" text-anchor="middle">катод</text>
			<text class="bml-t" x="66" y="146" text-anchor="middle">анод</text>
			<text class="bml-t" x="124" y="54" text-anchor="middle">пластины</text>
			<text class="bml-t" x="318" y="176" text-anchor="middle">экран</text>
			<!-- the screen seen from the front, 10 px per см -->
			<defs><clipPath id="bml-clip"><circle cx="292" cy="240" r="50"></circle></clipPath></defs>
			<circle class="bml-face" cx="292" cy="240" r="50"></circle>
			<path class="bml-grid" clip-path="url(#bml-clip)" d={Array.from({ length: 9 }, (_, k) => `M${252 + k * 10} 190 V290 M242 ${200 + k * 10} H342`).join(' ')}></path>
			<path class="bml-axis" d="M242 240 H342 M292 190 V290"></path>
			<circle class="bml-fspot" data-fspot cx="292" cy="240" r="4"></circle>
			<text class="bml-t" x="230" y="236" text-anchor="end">экран спереди,</text>
			<text class="bml-t" x="230" y="252" text-anchor="end">сетка через 1 см</text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Ускоряющее напряжение <i>U</i></span>
				<output data-out-u></output>
				<input type="range" min="1" max="5" step="0.5" value="2" data-u aria-label="Ускоряющее напряжение, киловольты" />
			</label>
			<label class="g7__slider">
				<span>Напряжение на пластинах <i>U</i><sub>п</sub></span>
				<output data-out-p></output>
				<input type="range" min="-100" max="100" step="10" value="0" data-p aria-label="Напряжение на пластинах, вольты; плюс — верхняя пластина положительная" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li class="is-key"><span>Скорость электронов <i>υ</i></span><b data-v></b></li>
				<li><span>Смещение пятна</span><b data-y></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Скорость электронов рассчитана по формуле <i>m</i><sub>e</sub><i>υ</i><sup>2</sup>/2 = <i>eU</i>; размеры трубки уменьшены, скорость полёта точек условная. Зазор между пластинами нарисован шире настоящего (1&nbsp;см); смещение пятна — в масштабе экрана.</figcaption>
</figure>

<style is:global>
	.bml .g7__svg .bml-t {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	.bml .g7__svg .bml-sign {
		font-size: 15px;
		font-weight: 700;
	}
	.bml .g7__svg .bml-sign.is-plus {
		fill: var(--g7-red);
	}
	.bml .g7__svg .bml-sign.is-minus {
		fill: var(--g7-blue);
	}
	.bml .g7__svg .bml-el {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 700;
		font-size: 15px;
		fill: var(--g7-gold);
	}
	.bml-earrow {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.bml-glass {
		fill: color-mix(in oklab, var(--g7-blue) 6%, var(--g7-paper));
		stroke: var(--g7-glass);
		stroke-width: 1.6;
	}
	.bml-screen {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-green) 70%, var(--g7-paper));
		stroke-width: 3.5;
	}
	.bml-cap,
	.bml-anode,
	.bml-plate {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.bml-cap {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2.4;
	}
	.bml-fil {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-red) 55%, var(--g7-gold));
		stroke-width: 1.6;
		filter: drop-shadow(0 0 2px color-mix(in oklab, var(--g7-gold) 80%, transparent));
	}
	.bml-e {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.bml-beam {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-blue) 45%, transparent);
		stroke-width: 1.6;
	}
	.bml-dot {
		fill: var(--g7-blue);
	}
	.bml-spot,
	.bml-fspot {
		fill: var(--g7-green);
		filter: drop-shadow(0 0 3px var(--g7-green));
	}
	.bml-face {
		fill: color-mix(in oklab, var(--g7-green) 8%, var(--g7-paper));
		stroke: var(--g7-glass);
		stroke-width: 1.6;
	}
	.bml-grid {
		fill: none;
		stroke: var(--g7-faint);
		stroke-width: 0.8;
	}
	.bml-axis {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
</style>

<script>
	import { el, fmt, loop } from '../g7/kit';

	const AX = 95;
	const X0 = 30; // the electrons start at the cathode
	const XP0 = 104; // the plates
	const XP1 = 144;
	const XS = 324; // the screen
	const f = (v: number) => v.toFixed(1);
	const E = 1.6e-19;
	const M = 9.1e-31;
	for (const root of document.querySelectorAll<HTMLElement>('[data-bml]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const uIn = q<HTMLInputElement>('[data-u]');
		const pIn = q<HTMLInputElement>('[data-p]');
		const dotsG = q<SVGGElement>('[data-dots]');
		const dots: { c: SVGCircleElement; x: number }[] = [];
		let U = 2000;
		let Up = 0;
		let y1 = 0; // px, the beam's height at the plates' exit (up is positive)
		let slope = 0;
		let speed = 0;
		const yAt = (x: number) => {
			if (x <= XP0) return 0;
			if (x <= XP1) return y1 * ((x - XP0) / 40) ** 2;
			return y1 + slope * (x - XP1);
		};
		const update = () => {
			U = Number(uIn.value) * 1000;
			Up = Number(pIn.value);
			const v = Math.sqrt((2 * E * U) / M);
			// l = 4 см, d = 1 см, L = 20 см; 10 px per см
			y1 = (10 * Up * 16) / (4 * U);
			slope = (Up * 4) / (2 * U);
			const Y = (40 * Up) / U; // см
			speed = 150 * (v / Math.sqrt((2 * E * 1000) / M));
			q('[data-out-u]').textContent = `${fmt(U / 1000, 1)} кВ`;
			q('[data-out-p]').textContent = `${Up > 0 ? '+' : ''}${fmt(Up, 0)} В`;
			q('[data-v]').innerHTML = `${fmt(v / 1e7, 2)}·10<sup>7</sup>&nbsp;м/с`;
			q('[data-y]').textContent = Up === 0 ? '0 см' : `${fmt(Math.abs(Y), 1)} см ${Up > 0 ? 'вверх' : 'вниз'}`;
			let d = `M${X0} ${AX}`;
			for (let x = X0 + 4; x <= XS; x += 4) d += ` L${x} ${f(AX - yAt(x))}`;
			q('[data-beam]').setAttribute('d', d);
			q('[data-spot]').setAttribute('cy', f(AX - 10 * Y));
			q('[data-fspot]').setAttribute('cy', f(240 - 10 * Y));
			const up = q<SVGTextElement>('[data-sup]');
			const dn = q<SVGTextElement>('[data-sdn]');
			up.textContent = Up > 0 ? '+' : Up < 0 ? '−' : '';
			dn.textContent = Up > 0 ? '−' : Up < 0 ? '+' : '';
			up.setAttribute('class', `bml-sign ${Up > 0 ? 'is-plus' : 'is-minus'}`);
			dn.setAttribute('class', `bml-sign ${Up > 0 ? 'is-minus' : 'is-plus'}`);
			// the field points from «+» to «−»
			const e = q<SVGLineElement>('[data-e]');
			e.style.display = Up === 0 ? 'none' : '';
			q<SVGGElement>('[data-elabel]').style.display = Up === 0 ? 'none' : '';
			e.setAttribute('y1', String(Up > 0 ? AX - 15 : AX + 15));
			e.setAttribute('y2', String(Up > 0 ? AX + 9 : AX - 9));
		};
		uIn.addEventListener('input', update);
		pIn.addEventListener('input', update);
		update();
		let acc = 0;
		loop(root, (dt) => {
			acc += dt;
			if (acc > 0.08) {
				acc = 0;
				const c = el('circle', { class: 'bml-dot', r: 2.2 });
				dotsG.append(c);
				dots.push({ c, x: X0 });
			}
			for (let i = dots.length - 1; i >= 0; i--) {
				const d = dots[i];
				d.x += speed * dt;
				if (d.x >= XS - 2) {
					d.c.remove();
					dots.splice(i, 1);
					continue;
				}
				d.c.setAttribute('cx', f(d.x));
				d.c.setAttribute('cy', f(AX - yAt(d.x)));
			}
			return true;
		});
	}
</script>
