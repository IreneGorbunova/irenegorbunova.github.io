---
/**
 * «Вакуумный диод»: two glass bulbs without air. In each, a cathode heated by a glowing filament (left) gives off
 * electrons (blue dots) by thermionic emission; a cold anode plate stands on the right. Left panel: the anode is «+»,
 * the electrons are pulled to it and a current flows (red arrow in the wire). Right panel: the anode is «−», the
 * electrons fly out a little, turn back and form a cloud at the cathode; no current. The anode battery sits in the
 * bottom wire (long plate «+», short plate «−»): on the left its «+» is wired to the anode, on the right it is turned
 * round, so its «−» goes to the anode. Symbolic speeds and numbers.
 */
import G7Styles from '../g7/G7Styles.astro';

const panels = [
	{ x: 0, plus: true, label: 'анод «+»: ток есть' },
	{ x: 180, plus: false, label: 'анод «−»: тока нет' },
];
---

<G7Styles />
<figure class="g7 g7--pic vac not-content" data-vac>
	<svg class="g7__svg" viewBox="0 0 360 192" role="img" aria-label="Два вакуумных диода. Нагретый катод испускает электроны. Если анод заряжен положительно, электроны летят к нему и идёт ток; если отрицательно — возвращаются к катоду">
		<defs>
			<marker id="vac-r" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
		</defs>
		{panels.map((p) => (
			<g transform={`translate(${p.x} 0)`}>
				<ellipse class="vac-glass" cx="90" cy="70" rx="72" ry="50" />
				<rect class="vac-cathode" x="36" y="44" width="8" height="52" rx="2" />
				<path class="vac-fil" d="M30 50 L26 58 L30 66 L26 74 L30 82 L26 90" />
				<rect class="vac-anode" x="138" y="40" width="7" height="60" rx="1" />
				<text class="t-strong" x="152" y="36">{p.plus ? '+' : '−'}</text>
				<text class="t-small" x="46" y="138">катод</text>
				<text class="t-small" x="135" y="138" text-anchor="end">анод</text>
				<path class="vac-wire" d="M141 100 V150 H94 M86 150 H40 V96" />
				<line class="vac-cell" x1={p.plus ? 94 : 86} y1="139" x2={p.plus ? 94 : 86} y2="161" />
				<line class="vac-cell vac-cell--short" x1={p.plus ? 86 : 94} y1="144" x2={p.plus ? 86 : 94} y2="156" />
				<text class="t-strong" x={p.plus ? 100 : 80} y="172" text-anchor="middle">+</text>
				{p.plus && <line class="arrow arrow--red" x1="48" y1="164" x2="76" y2="164" marker-end="url(#vac-r)" />}
				<text class="t-small" x="90" y="186" text-anchor="middle">{p.label}</text>
				<g data-e={p.plus ? '1' : '0'} />
			</g>
		))}
	</svg>
	<figcaption class="g7__caption">Нагретый катод испускает электроны — это термоэлектронная эмиссия. Анод соединён с полюсом батареи: слева с «+», справа с «−». Ток идёт, только когда анод заряжен положительно: вакуумный диод пропускает ток в одном направлении. Красная стрелка — направление тока. Скорости условные.</figcaption>
</figure>

<style is:global>
	.vac-glass {
		fill: color-mix(in oklab, var(--g7-blue) 6%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.vac-cathode {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--g7-gold));
	}
	.vac-fil {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
	}
	.vac-anode {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.vac-cell {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.vac-cell--short {
		stroke-width: 4.5;
	}
	.vac-wire {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.6;
	}
	.vac-e {
		fill: var(--g7-blue);
	}
</style>

<script>
	import { el, loop } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-vac]')) {
		const groups = [...root.querySelectorAll<SVGGElement>('[data-e]')];
		let seed = 9;
		const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
		const sets = groups.map((g) => {
			const plus = g.dataset.e === '1';
			const es = Array.from({ length: 16 }, (_, i) => {
				const c = el('circle', { class: 'vac-e', r: 2.4 });
				g.append(c);
				return { c, age: (i / 16) * 2, y: 48 + rnd() * 44, v: 0.7 + rnd() * 0.6 };
			});
			return { plus, es };
		});
		let t = 0;
		const draw = (dt: number) => {
			for (const s of sets)
				for (const e of s.es) {
					e.age += dt;
					let x: number;
					if (s.plus) {
						// accelerated to the anode: x grows as the square of time, 2 с to cross 92 px
						const T = 1.6 / e.v;
						if (e.age > T) e.age -= T;
						const u = e.age / T;
						x = 46 + 92 * u * u;
					} else {
						// thrown out with a small speed, braked by the anode field, back to the cathode
						const T = 1.2 / e.v;
						if (e.age > T) e.age -= T;
						const u = e.age / T;
						x = 46 + 34 * e.v * 4 * u * (1 - u);
					}
					e.c.setAttribute('cx', x.toFixed(1));
					e.c.setAttribute('cy', (e.y + Math.sin(t * 3 + e.y) * 1.5).toFixed(1));
				}
		};
		draw(0);
		loop(root, (dt) => {
			t += dt;
			draw(dt);
			return true;
		});
	}
</script>
