---
/**
 * «Где это встречается»: eight small static pictures in a grid (4 × 2 on a wide screen, 2 × 4 on a phone), in the order
 * of the bullets under it: a hospital MRI scanner (a superconducting coil), a digital medical thermometer (a thermistor
 * in its tip), an LED bulb (its chips visible), a solar panel on a roof, a chromed tap (electroplating), an X-ray tube
 * (a hot cathode, electrons to the anode, the X-ray beam out of the window), a glowing neon sign (glow discharge) and
 * the Sun with prominences (plasma). Schemes, not to scale. Colors: electrons blue as everywhere in the chapter, the
 * glow of a gas discharge violet-pink or orange as the gas gives it.
 */
import G7Styles from '../g7/G7Styles.astro';

const ITEMS = ['Томограф', 'Электронный термометр', 'Светодиодная лампа', 'Солнечная батарея', 'Хромированный кран', 'Рентгеновский аппарат', 'Неоновая вывеска', 'Солнце'];
---

<G7Styles />
<figure class="g7 g7--pic tsu not-content">
	<div class="tsu__grid">
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Томограф: большое кольцо с круглым отверстием, в которое въезжает стол с пациентом">
				<rect class="tsu-floor" x="0" y="76" width="120" height="14"></rect>
				<rect class="tsu-mri" x="40" y="12" width="44" height="64" rx="10"></rect>
				<ellipse class="tsu-hole" cx="62" cy="44" rx="10" ry="19"></ellipse>
				<path class="tsu-coil" d="M47 22 Q62 14 77 22 M47 66 Q62 74 77 66"></path>
				<rect class="tsu-bed" x="8" y="52" width="66" height="5" rx="2"></rect>
				<rect class="tsu-leg" x="16" y="57" width="5" height="19"></rect>
				<path class="tsu-pat" d="M12 52 Q14 44 22 45 H52 Q58 45 58 52 Z"></path>
				<circle class="tsu-skin" cx="16" cy="46" r="4.5"></circle>
			</svg>
			<p class="tsu__name">{ITEMS[0]}</p>
		</div>
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Электронный термометр: удлинённый корпус с экраном, металлический кончик">
				<path class="tsu-therm" d="M10 38 Q10 30 20 30 H84 L104 40 L104 50 L84 60 H20 Q10 60 10 52 Z"></path>
				<rect class="tsu-lcd" x="24" y="36" width="40" height="18" rx="2"></rect>
				<text class="tsu-num" x="44" y="50" text-anchor="middle">36,6</text>
				<path class="tsu-tip" d="M104 40 L114 43 Q116 45 114 47 L104 50 Z"></path>
				<circle class="tsu-btn" cx="76" cy="45" r="4"></circle>
			</svg>
			<p class="tsu__name">{ITEMS[1]}</p>
		</div>
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Светодиодная лампа: внутри колбы — плата с маленькими светящимися кристаллами">
				<path class="tsu-rays" d="M60 8 V2 M84 18 L89 13 M36 18 L31 13 M94 42 H101 M26 42 H19"></path>
				<path class="tsu-ledbulb" d="M44 60 Q30 50 30 38 Q30 14 60 14 Q90 14 90 38 Q90 50 76 60 Z"></path>
				<rect class="tsu-board" x="44" y="34" width="32" height="10" rx="2"></rect>
				{[0, 1, 2, 3].map((k) => <rect class="tsu-chip" x={47 + k * 7.5} y="36.5" width="4.5" height="5"></rect>)}
				<rect class="tsu-base" x="46" y="60" width="28" height="16" rx="2"></rect>
				<path class="tsu-thread" d="M46 64 H74 M46 68 H74 M46 72 H74"></path>
				<path class="tsu-base" d="M54 76 H66 L63 82 H57 Z"></path>
			</svg>
			<p class="tsu__name">{ITEMS[2]}</p>
		</div>
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Солнечная батарея на крыше дома, светит солнце">
				<circle class="tsu-sun" cx="100" cy="16" r="9"></circle>
				<path class="tsu-wall" d="M16 50 H92 V86 H16 Z"></path>
				<path class="tsu-roof" d="M8 52 L40 22 H72 L100 52 Z"></path>
				<path class="tsu-panel" d="M26 47 L46 28 H72 L90 47 Z"></path>
				<path class="tsu-cells" d="M32.5 41 H84 M39 34.5 H77.5 M52.5 28 L44 47 M59 28 L56 47 M65.5 28 L68 47"></path>
				<rect class="tsu-win" x="28" y="60" width="16" height="14"></rect>
				<rect class="tsu-door" x="62" y="60" width="14" height="26"></rect>
			</svg>
			<p class="tsu__name">{ITEMS[3]}</p>
		</div>
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Блестящий хромированный кран над раковиной, с носика падает капля">
				<rect class="tsu-sink" x="10" y="74" width="100" height="10" rx="3"></rect>
				<path class="tsu-chrome" d="M28 74 V40 Q28 22 46 22 H74 Q88 22 88 36 V44 H80 V36 Q80 30 74 30 H46 Q36 30 36 40 V74 Z"></path>
				<rect class="tsu-chrome" x="38" y="12" width="20" height="6" rx="2"></rect>
				<rect class="tsu-chrome" x="46" y="18" width="4" height="5"></rect>
				<path class="tsu-shine" d="M31 70 V42 Q31 27 46 25 M76 25 Q84 26 85 34"></path>
				<path class="tsu-drop" d="M84 52 Q80 58 84 60 Q88 58 84 52 Z"></path>
			</svg>
			<p class="tsu__name">{ITEMS[4]}</p>
		</div>
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Рентгеновская трубка: горячий катод, пучок электронов летит к аноду, из окошка выходит рентгеновское излучение">
				<ellipse class="tsu-tube" cx="60" cy="36" rx="50" ry="22"></ellipse>
				<path class="tsu-fil" d="M22 30 L26 34 L22 38 L26 42"></path>
				<rect class="tsu-metal" x="10" y="32" width="10" height="8"></rect>
				<path class="tsu-metal" d="M84 26 L96 26 L96 46 L80 46 Z"></path>
				<rect class="tsu-metal" x="96" y="32" width="14" height="8"></rect>
				{[0, 1, 2, 3, 4].map((k) => <circle class="tsu-e" cx={34 + k * 10} cy="36" r="2"></circle>)}
				<path class="tsu-xray" d="M82 46 L64 88 M82 46 L76 88 M82 46 L88 88"></path>
			</svg>
			<p class="tsu__name">{ITEMS[5]}</p>
		</div>
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Неоновая вывеска: светящаяся трубка в виде чашки с паром на тёмной стене">
				<rect class="tsu-dark" x="0" y="0" width="120" height="90" rx="6"></rect>
				<path class="tsu-neon-glow" d="M36 44 H78 V56 Q78 72 57 72 Q36 72 36 56 Z M78 48 Q90 48 90 56 Q90 64 78 64 M46 38 Q42 32 46 26 Q50 20 46 14 M58 38 Q54 32 58 26 Q62 20 58 14"></path>
				<path class="tsu-neon" d="M36 44 H78 V56 Q78 72 57 72 Q36 72 36 56 Z M78 48 Q90 48 90 56 Q90 64 78 64 M46 38 Q42 32 46 26 Q50 20 46 14 M58 38 Q54 32 58 26 Q62 20 58 14"></path>
			</svg>
			<p class="tsu__name">{ITEMS[6]}</p>
		</div>
		<div class="tsu__item">
			<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label="Солнце с протуберанцами — огромными петлями светящегося газа над краем диска">
				<rect class="tsu-space" x="0" y="0" width="120" height="90" rx="6"></rect>
				<path class="tsu-prom" d="M37.5 25.4 Q24 4 48.5 17 M92.1 56.9 Q112 72 86.5 66.6 M41.4 70.5 Q20 84 34.3 62"></path>
				<circle class="tsu-sundisk" cx="62" cy="46" r="32"></circle>
			</svg>
			<p class="tsu__name">{ITEMS[7]}</p>
		</div>
	</div>
</figure>

<style is:global>
	.tsu__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.7rem;
	}
	@container (max-width: 30rem) {
		.tsu__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.tsu__item {
		display: grid;
		gap: 0.25rem;
		align-content: start;
	}
	.tsu__name {
		margin: 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		line-height: 1.25;
		color: var(--sl-color-gray-2);
	}
	.tsu .g7__svg .tsu-num {
		font-size: 13px;
		font-weight: 700;
		fill: hsl(220, 20%, 15%);
		font-variant-numeric: tabular-nums;
	}
	.tsu-floor {
		fill: var(--g7-faint);
	}
	.tsu-mri {
		fill: hsl(210, 15%, 88%);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.tsu-hole {
		fill: hsl(210, 20%, 30%);
	}
	.tsu-coil {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2;
		stroke-dasharray: 3 2;
	}
	.tsu-bed,
	.tsu-leg {
		fill: var(--g7-steel);
	}
	.tsu-pat {
		fill: color-mix(in oklab, var(--g7-green) 50%, var(--g7-paper));
	}
	.tsu-skin {
		fill: var(--g7-skin);
	}
	.tsu-therm {
		fill: hsl(0, 0%, 94%);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.tsu-lcd {
		fill: hsl(90, 25%, 72%);
		stroke: hsl(90, 15%, 45%);
		stroke-width: 0.8;
	}
	.tsu-tip {
		fill: var(--g7-steel);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.tsu-btn {
		fill: var(--g7-blue);
	}
	.tsu-rays {
		stroke: var(--g7-gold);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.tsu-ledbulb {
		fill: color-mix(in oklab, var(--sl-color-white) 14%, var(--g7-paper));
		stroke: var(--g7-glass);
		stroke-width: 1.4;
	}
	.tsu-board {
		fill: var(--g7-steel);
	}
	.tsu-chip {
		fill: hsl(52, 100%, 70%);
		filter: drop-shadow(0 0 2px hsl(52, 100%, 70%));
	}
	.tsu-base {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.tsu-thread {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.tsu-sun {
		fill: var(--g7-gold);
	}
	.tsu-wall {
		fill: color-mix(in oklab, var(--g7-gold) 25%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.tsu-roof {
		fill: color-mix(in oklab, var(--g7-red) 40%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.tsu-panel {
		fill: hsl(220, 60%, 30%);
		stroke: hsl(220, 20%, 70%);
		stroke-width: 1;
	}
	.tsu-cells {
		stroke: hsl(220, 30%, 65%);
		stroke-width: 0.7;
	}
	.tsu-win {
		fill: var(--g7-water);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.tsu-door {
		fill: var(--g7-wood-dark);
	}
	.tsu-sink {
		fill: hsl(0, 0%, 90%);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.tsu-chrome {
		fill: hsl(210, 10%, 72%);
		stroke: hsl(210, 10%, 45%);
		stroke-width: 0.8;
	}
	.tsu-shine {
		fill: none;
		stroke: hsl(0, 0%, 100%);
		stroke-width: 1.6;
		stroke-linecap: round;
		opacity: 0.9;
	}
	.tsu-drop {
		fill: var(--g7-water-edge);
	}
	.tsu-tube {
		fill: color-mix(in oklab, var(--g7-blue) 6%, var(--g7-paper));
		stroke: var(--g7-glass);
		stroke-width: 1.4;
	}
	.tsu-fil {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-red) 55%, var(--g7-gold));
		stroke-width: 1.6;
	}
	.tsu-metal {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.tsu-e {
		fill: var(--g7-blue);
	}
	.tsu-xray {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-violet) 70%, var(--g7-paper));
		stroke-width: 1.4;
		stroke-dasharray: 3 2;
	}
	.tsu-dark {
		fill: hsl(230, 25%, 14%);
	}
	.tsu-neon {
		fill: none;
		stroke: hsl(20, 100%, 72%);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tsu-neon-glow {
		fill: none;
		stroke: hsl(15, 100%, 55%);
		stroke-width: 7;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.35;
	}
	.tsu-space {
		fill: hsl(230, 30%, 10%);
	}
	.tsu-sundisk {
		fill: hsl(40, 100%, 60%);
		filter: drop-shadow(0 0 4px hsl(40, 100%, 60%));
	}
	.tsu-prom {
		fill: none;
		stroke: hsl(15, 95%, 58%);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.tsu-spot {
		fill: hsl(25, 70%, 40%);
	}
</style>
