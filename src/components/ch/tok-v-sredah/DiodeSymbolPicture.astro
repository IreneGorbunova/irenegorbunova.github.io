---
/**
 * «Полупроводниковый диод»: three small school-style drawings in a row (two rows on a phone).
 *   (a) the symbol of a diode on a circuit diagram: a triangle and a bar; the triangle's base is the anode (p-region),
 *       the bar the cathode (n-region); the arrow «I» (red, the chapter's color of the current) runs along the
 *       triangle's direction, from p to n;
 *   (b) a rectifier diode as it looks: a black cylinder about 5 мм long with two leads and a gray stripe at the cathode
 *       end;
 *   (c) a 5-мм LED: a clear dome on a rim and two leads, the longer one is the anode (p), the shorter the cathode (n),
 *       and its symbol: the diode symbol with two small arrows of light going out.
 * Static. Not to scale between the panels.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic dsy not-content">
	<div class="dsy__grid">
		<div class="dsy__item">
			<svg class="g7__svg" viewBox="0 0 190 110" role="img" aria-label="Условное обозначение диода: треугольник и черта. Со стороны основания треугольника — анод, p-область, со стороны черты — катод, n-область. Стрелка тока идёт по направлению треугольника">
				<defs>
					<marker id="dsy-r" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				</defs>
				<path class="dsy-wire" d="M12 60 H78 M112 60 H178"></path>
				<path class="dsy-tri" d="M78 43 L112 60 L78 77 Z"></path>
				<line class="dsy-bar" x1="112" y1="42" x2="112" y2="78"></line>
				<line class="arrow arrow--red" x1="64" y1="22" x2="114" y2="22" marker-end="url(#dsy-r)"></line>
				<text class="dsy-i" x="132" y="28">I</text>
				<text class="dsy-t" x="56" y="102" text-anchor="middle">анод (p)</text>
				<text class="dsy-t" x="140" y="102" text-anchor="middle">катод (n)</text>
			</svg>
			<p class="dsy__name">Условное обозначение</p>
		</div>
		<div class="dsy__item">
			<svg class="g7__svg" viewBox="0 0 190 110" role="img" aria-label="Выпрямительный диод: чёрный цилиндрик с двумя выводами, серая полоска на нём обозначает катод">
				<path class="dsy-lead" d="M10 46 H56 M134 46 H180"></path>
				<rect class="dsy-body" x="56" y="32" width="78" height="28" rx="5"></rect>
				<rect class="dsy-stripe" x="114" y="32" width="9" height="28"></rect>
				<path class="dsy-shine" d="M62 37 H108"></path>
				<line class="dsy-leader" x1="118.5" y1="62" x2="118.5" y2="82"></line>
				<text class="dsy-t" x="95" y="100" text-anchor="middle">полоска — катод (n)</text>
			</svg>
			<p class="dsy__name">Выпрямительный диод</p>
		</div>
		<div class="dsy__item">
			<svg class="g7__svg" viewBox="0 0 190 110" role="img" aria-label="Светодиод: прозрачный колпачок и два вывода, длинный — анод, короткий — катод. Рядом его условное обозначение: значок диода с двумя стрелками света">
				<path class="dsy-dome" d="M66 52 V24 Q66 8 80 8 Q94 8 94 24 V52 Z"></path>
				<rect class="dsy-rim" x="62" y="50" width="36" height="5" rx="1"></rect>
				<path class="dsy-chip" d="M73 44 V34 H78 L80 30 M87 44 V34"></path>
				<path class="dsy-lead" d="M74 55 V80 M86 55 V96"></path>
				<text class="dsy-t" x="68" y="84" text-anchor="end">катод (n)</text>
				<text class="dsy-t" x="94" y="100">анод (p)</text>
				<!-- the symbol -->
				<path class="dsy-wire" d="M118 48 H140 M160 48 H184"></path>
				<path class="dsy-tri" d="M140 38 L160 48 L140 58 Z"></path>
				<line class="dsy-bar" x1="160" y1="37" x2="160" y2="59"></line>
				<path class="dsy-ray" d="M147 32 L156 20 M154 35 L163 23 M156 20 l-4.5 1 M156 20 l-0.4 4.6 M163 23 l-4.5 1 M163 23 l-0.4 4.6"></path>
			</svg>
			<p class="dsy__name">Светодиод</p>
		</div>
	</div>
	<figcaption class="g7__caption">Ток через диод идёт по стрелке его значка — от p к n.</figcaption>
</figure>

<style is:global>
	.dsy__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@container (max-width: 30rem) {
		.dsy__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.dsy__item {
		display: grid;
		gap: 0.3rem;
		align-content: start;
	}
	.dsy__name {
		margin: 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.dsy .g7__svg .dsy-t {
		font-size: 14px;
		fill: var(--sl-color-gray-2);
	}
	.dsy .g7__svg .dsy-i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 700;
		font-size: 19px;
		fill: var(--g7-red);
	}
	.dsy-wire,
	.dsy-bar {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.2;
	}
	.dsy-tri {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.dsy-lead {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2.6;
	}
	.dsy-body {
		fill: hsl(220, 10%, 12%);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.dsy-stripe {
		fill: hsl(220, 6%, 72%);
	}
	.dsy-shine {
		stroke: hsl(0, 0%, 100%);
		stroke-width: 1.4;
		opacity: 0.25;
	}
	.dsy-leader {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.dsy-dome {
		fill: color-mix(in oklab, var(--sl-color-white) 14%, transparent);
		stroke: var(--g7-glass);
		stroke-width: 1.2;
	}
	.dsy-rim {
		fill: color-mix(in oklab, var(--sl-color-white) 22%, var(--g7-paper));
		stroke: var(--g7-glass);
		stroke-width: 1;
	}
	.dsy-chip {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 1.6;
	}
	.dsy-ray {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
</style>
