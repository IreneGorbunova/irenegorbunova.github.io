---
/**
 * «Электролитическая диссоциация». Left: a beaker of distilled water with two electrodes in a circuit with a battery
 * and a small lamp; the lamp is off (distilled water hardly conducts). The button «Насыпать медный купорос» drops a few
 * blue crystals in: they fall (0,6 с) and dissolve (about 2 с), the water turns light blue and the lamp lights up as the
 * solution fills with ions. «Сначала» returns to pure water.
 * Right, a round inset «под увеличением» (symbolic, not to scale): before the button only water molecules wander, each
 * a dipole: a bigger oxygen end (tinted blue, its «−» side) and two hydrogens (tinted red, the «+» side). After it a
 * small crystal of alternating Cu²⁺ (red) and SO₄²⁻ (blue) ions falls in; the molecules near it turn their «−» ends to
 * Cu²⁺ and their «+» ends to SO₄²⁻ and pull the ions off one by one (every 0,35 с); each free ion wanders inside a shell
 * of three water molecules turned the same way. 8 ions, 30 molecules.
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 268;
const CY = 100;
const R = 86;
---

<G7Styles />
<figure class="g7 g7--pic dsc not-content" data-dissoc>
	<div class="dsc__wrap">
		<svg class="g7__svg" viewBox="0 0 360 226" role="img" aria-label="Стакан с дистиллированной водой, два электрода, батарейка и лампочка. После того как в воду насыпают медный купорос, вода голубеет и лампочка загорается. Под увеличением молекулы воды отрывают от кристалла ионы меди и ионы кислотного остатка">
			<defs>
				<clipPath id="dsc-clip"><circle cx={CX} cy={CY} r={R}></circle></clipPath>
			</defs>
			<!-- the circuit: electrodes, battery, lamp -->
			<path class="dsc-wire" d="M58 44 V22 H74 M82 22 H94 M110 22 H122 V44"></path>
			<line class="dsc-bat" x1="74" y1="12" x2="74" y2="32"></line>
			<line class="dsc-bat dsc-bat--s" x1="82" y1="16" x2="82" y2="28"></line>
			<circle class="dsc-glow" data-glow cx="102" cy="22" r="16"></circle>
			<circle class="dsc-lamp" cx="102" cy="22" r="8"></circle>
			<path class="dsc-lampx" d="M96.5 16.5 L107.5 27.5 M96.5 27.5 L107.5 16.5"></path>
			<!-- the beaker -->
			<rect class="dsc-water" data-water x="30" y="80" width="120" height="98"></rect>
			<path class="dsc-glass" d="M26 60 H30 V176 Q30 180 34 180 H146 Q150 180 150 176 V60 H154"></path>
			<rect class="dsc-el" x="55" y="44" width="6" height="120"></rect>
			<rect class="dsc-el" x="119" y="44" width="6" height="120"></rect>
			<g data-crys></g>
			<!-- the link to the inset -->
			<circle class="dsc-ring" cx="90" cy="140" r="10"></circle>
			<line class="dsc-ring" x1="100" y1="139" x2={CX - R} y2="124"></line>
			<!-- the inset -->
			<circle class="dsc-inset" cx={CX} cy={CY} r={R}></circle>
			<g clip-path="url(#dsc-clip)">
				<g data-in></g>
			</g>
			<circle class="dsc-inset-rim" cx={CX} cy={CY} r={R}></circle>
			<!-- the legend -->
			<circle class="dsc-cu" cx="14" cy="212" r="5.5"></circle>
			<text class="dsc-t" x="24" y="217">Cu²⁺</text>
			<circle class="dsc-so" cx="74" cy="212" r="7"></circle>
			<text class="dsc-t" x="86" y="217">SO₄²⁻</text>
			<g transform="translate(150 212) rotate(180)">
				<circle class="dsc-h" cx="-3" cy="-3.6" r="2.4"></circle>
				<circle class="dsc-h" cx="-3" cy="3.6" r="2.4"></circle>
				<circle class="dsc-o" r="4.2"></circle>
			</g>
			<text class="dsc-t" x="160" y="217">молекула воды</text>
		</svg>
		<div class="g7__row">
			<button type="button" class="g7__btn g7__btn--go" data-go>Насыпать медный купорос</button>
		</div>
	</div>
	<figcaption class="g7__caption">Молекулы воды растаскивают кристалл на ионы: раствор начинает проводить ток. Масштабы и число частиц условные.</figcaption>
</figure>

<style is:global>
	.dsc__wrap {
		display: grid;
		gap: 0.6rem;
		max-width: 26rem;
		margin-inline: auto;
	}
	.dsc .g7__svg .dsc-t {
		font-size: 12.5px;
		fill: var(--sl-color-gray-2);
	}
	.dsc-wire {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.dsc-bat {
		stroke: var(--g7-ink);
		stroke-width: 2.2;
	}
	.dsc-bat--s {
		stroke-width: 4;
	}
	.dsc-glow {
		fill: var(--g7-gold);
		opacity: 0;
	}
	.dsc-lamp {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.dsc-lampx {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.dsc-water {
		fill: var(--g7-water);
	}
	.dsc-glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.dsc-el {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.dsc-crystal {
		fill: hsl(195, 80%, 50%);
		stroke: hsl(200, 70%, 30%);
		stroke-width: 0.6;
	}
	.dsc-ring {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.dsc-inset {
		fill: color-mix(in oklab, var(--g7-blue) 8%, var(--g7-paper));
	}
	.dsc-inset-rim {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2;
	}
	.dsc-cu {
		fill: color-mix(in oklab, var(--g7-red) 70%, var(--g7-paper));
		stroke: var(--g7-red);
		stroke-width: 1.2;
	}
	.dsc-so {
		fill: color-mix(in oklab, var(--g7-blue) 65%, var(--g7-paper));
		stroke: var(--g7-blue);
		stroke-width: 1.2;
	}
	.dsc-o {
		fill: color-mix(in oklab, var(--g7-blue) 22%, var(--sl-color-gray-5));
		stroke: color-mix(in oklab, var(--g7-blue) 50%, var(--g7-line));
		stroke-width: 0.8;
	}
	.dsc-h {
		fill: color-mix(in oklab, var(--g7-red) 22%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--g7-red) 50%, var(--g7-line));
		stroke-width: 0.7;
	}
</style>

<script>
	import { el, loop, rng } from '../g7/kit';

	const CX = 268;
	const CY = 100;
	const RIN = 76; // particles stay inside this radius
	const f = (v: number) => v.toFixed(1);
	type Mol = { g: SVGGElement; x: number; y: number; vx: number; vy: number; th: number; w: number; ion: Ion | null; slot: number };
	type Ion = { g: SVGCircleElement; cu: boolean; x: number; y: number; vx: number; vy: number; free: boolean; t0: number; dir: number; hx: number; hy: number; spin: number };
	for (const root of document.querySelectorAll<HTMLElement>('[data-dissoc]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const inG = q<SVGGElement>('[data-in]');
		const crysG = q<SVGGElement>('[data-crys]');
		const go = q<HTMLButtonElement>('[data-go]');
		let rand = rng(11);
		let mols: Mol[] = [];
		let ions: Ion[] = [];
		let crystals: { r: SVGRectElement; x: number; s: number }[] = [];
		let on = false;
		let ts = 0; // s since the button
		const molG = el('g', {});
		const ionG = el('g', {});
		inG.append(molG, ionG);
		const mol = (): Mol => {
			const g = el('g', {});
			g.append(el('circle', { class: 'dsc-h', cx: -3, cy: -3.6, r: 2.4 }), el('circle', { class: 'dsc-h', cx: -3, cy: 3.6, r: 2.4 }), el('circle', { class: 'dsc-o', r: 4.2 }));
			molG.append(g);
			const a = rand() * 6.283;
			const r = Math.sqrt(rand()) * RIN;
			return { g, x: CX + r * Math.cos(a), y: CY + r * Math.sin(a), vx: 0, vy: 0, th: rand() * 6.283, w: (rand() - 0.5) * 2, ion: null, slot: 0 };
		};
		const reset = () => {
			rand = rng(11);
			molG.replaceChildren();
			ionG.replaceChildren();
			crysG.replaceChildren();
			mols = Array.from({ length: 30 }, mol);
			ions = [];
			crystals = [];
			on = false;
			ts = 0;
			go.textContent = 'Насыпать медный купорос';
			q<SVGRectElement>('[data-water]').style.fill = '';
			q<SVGCircleElement>('[data-glow]').style.opacity = '0';
		};
		const start = () => {
			on = true;
			ts = 0;
			go.textContent = 'Сначала';
			// the crystal in the inset: 4×2 alternating ions, 13 px apart; the crystals in the beaker
			for (let k = 0; k < 8; k++) {
				const i = k % 4;
				const j = Math.floor(k / 4);
				const cu = (i + j) % 2 === 0;
				const g = el('circle', { class: cu ? 'dsc-cu' : 'dsc-so', r: cu ? 5.5 : 7 });
				ionG.append(g);
				ions.push({ g, cu, x: 0, y: 0, vx: 0, vy: 0, free: false, t0: 0, dir: 0, hx: (i - 1.5) * 14, hy: (j - 0.5) * 14, spin: rand() * 6.283 });
			}
			for (let k = 0; k < 5; k++) {
				const r = el('rect', { class: 'dsc-crystal', width: 5, height: 5 });
				crysG.append(r);
				crystals.push({ r, x: 68 + k * 9 + rand() * 4, s: 5 });
			}
		};
		go.addEventListener('click', () => (on ? reset() : start()));
		reset();
		// the order in which the ions leave the crystal: the corners first
		const ORDER = [0, 7, 3, 4, 1, 6, 2, 5];
		const dist = (a: { x: number; y: number }, b: { x: number; y: number }) => Math.hypot(a.x - b.x, a.y - b.y);
		loop(root, (dt) => {
			if (on) ts += dt;
			// the crystal falls into the inset (0–0,6 s) and sits in its center
			const fall = Math.min(1, ts / 0.6);
			const cyc = CY - 110 * (1 - fall * fall);
			ions.forEach((io, k) => {
				const leave = 0.9 + 0.35 * ORDER.indexOf(k);
				if (!io.free && on && ts >= leave) {
					io.free = true;
					io.t0 = ts;
					io.dir = Math.atan2(io.hy || 0.1, io.hx || 0.1) + (rand() - 0.5) * 0.8;
					// three free molecules nearest to it become its shell
					const cand = mols.filter((m) => !m.ion).sort((a, b) => dist(a, io) - dist(b, io)).slice(0, 3);
					cand.forEach((m, s) => {
						m.ion = io;
						m.slot = s;
					});
				}
				if (!io.free) {
					io.x = CX + io.hx;
					io.y = cyc + io.hy;
				} else {
					const s = ts - io.t0;
					if (s < 0.6) {
						io.x += 40 * Math.cos(io.dir) * dt * (1 - s / 0.6);
						io.y += 40 * Math.sin(io.dir) * dt * (1 - s / 0.6);
					} else {
						io.vx += (rand() - 0.5) * 60 * dt;
						io.vy += (rand() - 0.5) * 60 * dt;
						io.vx *= 0.98;
						io.vy *= 0.98;
						io.x += io.vx * dt;
						io.y += io.vy * dt;
					}
					const r = Math.hypot(io.x - CX, io.y - CY);
					const lim = RIN - 14;
					if (r > lim) {
						io.x = CX + ((io.x - CX) * lim) / r;
						io.y = CY + ((io.y - CY) * lim) / r;
						io.vx = -io.vx;
						io.vy = -io.vy;
					}
					io.spin += 0.6 * dt;
				}
				io.g.setAttribute('cx', f(io.x));
				io.g.setAttribute('cy', f(io.y));
				io.g.style.display = on ? '' : 'none';
			});
			const bound = ions.filter((io) => !io.free && on && fall >= 1);
			for (const m of mols) {
				if (m.ion) {
					// in the shell of its ion: «−» end (oxygen) to Cu²⁺, «+» ends (hydrogens) to SO₄²⁻
					const io = m.ion;
					const rs = io.cu ? 11 : 13;
					const a = io.spin + (m.slot * 2 * Math.PI) / 3;
					const tx = io.x + rs * Math.cos(a);
					const ty = io.y + rs * Math.sin(a);
					const k = Math.min(1, 6 * dt);
					m.x += (tx - m.x) * k;
					m.y += (ty - m.y) * k;
					const to = Math.atan2(io.y - m.y, io.x - m.x);
					const want = io.cu ? to : to + Math.PI;
					m.th += Math.atan2(Math.sin(want - m.th), Math.cos(want - m.th)) * Math.min(1, 6 * dt);
				} else {
					m.vx += (rand() - 0.5) * 80 * dt;
					m.vy += (rand() - 0.5) * 80 * dt;
					m.vx *= 0.97;
					m.vy *= 0.97;
					m.x += m.vx * dt;
					m.y += m.vy * dt;
					const r = Math.hypot(m.x - CX, m.y - CY);
					if (r > RIN) {
						m.x = CX + ((m.x - CX) * RIN) / r;
						m.y = CY + ((m.y - CY) * RIN) / r;
						m.vx = -m.vx;
						m.vy = -m.vy;
					}
					// keep out of the crystal; near it turn to the nearest ion the proper way
					let near: Ion | null = null;
					let dn = 1e9;
					for (const io of bound) {
						const d = dist(m, io);
						if (d < dn) {
							dn = d;
							near = io;
						}
					}
					if (near && dn < 12) {
						const a = Math.atan2(m.y - near.y, m.x - near.x);
						m.x = near.x + 12 * Math.cos(a);
						m.y = near.y + 12 * Math.sin(a);
					}
					if (near && dn < 30) {
						const to = Math.atan2(near.y - m.y, near.x - m.x);
						const want = near.cu ? to : to + Math.PI;
						m.th += Math.atan2(Math.sin(want - m.th), Math.cos(want - m.th)) * Math.min(1, 4 * dt);
					} else m.th += m.w * dt;
				}
				m.g.setAttribute('transform', `translate(${f(m.x)} ${f(m.y)}) rotate(${f((m.th * 180) / Math.PI)})`);
			}
			// the beaker: crystals fall (0–0,6 s) and dissolve (0,6–2,4 s); the water turns blue, the lamp lights
			for (const c of crystals) {
				const y = 58 + 112 * Math.min(1, (ts / 0.6) ** 2);
				const s = 5 * Math.max(0, 1 - (ts - 0.6) / 1.8);
				c.r.setAttribute('x', f(c.x + (5 - s) / 2));
				c.r.setAttribute('y', f(y + (5 - s)));
				c.r.setAttribute('width', f(s));
				c.r.setAttribute('height', f(s));
			}
			const tint = on ? Math.min(1, Math.max(0, (ts - 0.4) / 2)) : 0;
			q<SVGRectElement>('[data-water]').style.fill = tint > 0 ? `color-mix(in oklab, hsl(195, 80%, 55%) ${f(10 + 35 * tint)}%, var(--g7-water))` : '';
			q<SVGCircleElement>('[data-glow]').style.opacity = f(0.6 * tint);
			return true;
		});
	}
</script>
