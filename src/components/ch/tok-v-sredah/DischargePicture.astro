---
/**
 * «Виды самостоятельного разряда»: four small schemes, each with its everyday example. Glow: a tube of rarefied neon
 * glowing orange-red between two electrodes (a sign). Spark: a zigzag spark between two metal balls, repeating every
 * 0,8 с (like lightning). Corona: a violet glow around a wire of a high-voltage line, drawn as a blurred halo along the
 * wire and short flickering tufts (brighter than a real corona, which is seen only in the dark). Arc: a dazzling arc between
 * two carbon rods (welding, Petrov's arc). The glows flicker a little; schemes, not to scale.
 */
import G7Styles from '../g7/G7Styles.astro';

// the corona tufts: short strokes standing out of the wire, alternately up and down
const tufts = Array.from({ length: 21 }, (_, i) => {
	const x = 4 + 8 * i;
	const up = i % 2 ? -1 : 1;
	const len = 5 + ((i * 7) % 4);
	const lean = ((i * 5) % 3) - 1;
	return `M${x} ${44 + 2 * up} l${lean} ${up * len}`;
}).join(' ');
---

<G7Styles />
<figure class="g7 g7--pic dsc not-content" data-dsc>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 170 110" role="img" aria-label="Тлеющий разряд: светящаяся трубка с неоном">
			<rect class="dsc-tube" x="14" y="40" width="142" height="22" rx="11"></rect>
			<rect class="dsc-neon" data-flick x="22" y="44" width="126" height="14" rx="7"></rect>
			<rect class="dsc-el" x="16" y="45" width="6" height="12"></rect>
			<rect class="dsc-el" x="148" y="45" width="6" height="12"></rect>
			<text class="t-title" x="85" y="22" text-anchor="middle">тлеющий</text>
			<text class="t-small" x="85" y="94" text-anchor="middle">неоновые вывески, лампы</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 170 110" role="img" aria-label="Искровой разряд: искра между двумя шарами">
			<circle class="dsc-ball" cx="34" cy="52" r="14"></circle>
			<circle class="dsc-ball" cx="136" cy="52" r="14"></circle>
			<path class="dsc-spark" data-spark d="M48 52 L62 44 L70 58 L84 46 L94 60 L106 48 L122 52"></path>
			<text class="t-title" x="85" y="22" text-anchor="middle">искровой</text>
			<text class="t-small" x="85" y="94" text-anchor="middle">молния, искра зажигалки</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 170 110" role="img" aria-label="Коронный разряд: свечение вокруг провода высоковольтной линии">
			<path class="dsc-pylon" d="M118 104 L130 30 L142 104 M122 80 H138 M125 60 H135 M106 34 H154"></path>
			<line class="dsc-corona" data-flick x1="0" y1="44" x2="170" y2="44"></line>
			<line class="dsc-wire" x1="0" y1="44" x2="170" y2="44"></line>
			<path class="dsc-tuft" data-flick d={tufts}></path>
			<text class="t-title" x="85" y="16" text-anchor="middle">коронный</text>
			<text class="t-small" x="52" y="94" text-anchor="middle">у проводов ЛЭП</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 170 110" role="img" aria-label="Дуговой разряд: яркая дуга между двумя угольными стержнями">
			<rect class="dsc-rod" x="12" y="47" width="58" height="10" rx="2"></rect>
			<rect class="dsc-rod" x="100" y="47" width="58" height="10" rx="2"></rect>
			<ellipse class="dsc-arcglow" data-flick cx="85" cy="50" rx="26" ry="16"></ellipse>
			<path class="dsc-arc" d="M70 52 Q85 34 100 52"></path>
			<text class="t-title" x="85" y="22" text-anchor="middle">дуговой</text>
			<text class="t-small" x="85" y="94" text-anchor="middle">электросварка</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Схемы, не в масштабе.</figcaption>
</figure>

<style is:global>
	.dsc-tube {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 1.4;
	}
	.dsc-neon {
		fill: hsl(10, 100%, 62%);
		filter: drop-shadow(0 0 5px hsl(10, 100%, 60%));
	}
	.dsc-el,
	.dsc-rod {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.dsc-ball {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.dsc-spark {
		fill: none;
		stroke: hsl(230, 100%, 88%);
		stroke-width: 2;
		stroke-linejoin: round;
		filter: drop-shadow(0 0 4px hsl(230, 100%, 70%));
	}
	.dsc-pylon {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2;
	}
	.dsc-wire {
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.dsc-corona {
		stroke: color-mix(in oklab, var(--g7-violet) 75%, var(--g7-blue));
		stroke-width: 18;
		stroke-opacity: 0.55;
		filter: blur(3px);
	}
	.dsc-tuft {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.dsc-arcglow {
		fill: hsl(50, 100%, 85%);
		filter: drop-shadow(0 0 8px hsl(45, 100%, 65%));
	}
	.dsc-arc {
		fill: none;
		stroke: hsl(0, 0%, 100%);
		stroke-width: 3;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-dsc]')) {
		const flicks = [...root.querySelectorAll<SVGElement>('[data-flick]')];
		const spark = root.querySelector<SVGElement>('[data-spark]')!;
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			flicks.forEach((f, i) => (f.style.opacity = (0.75 + 0.2 * Math.sin(t * (17 + 5 * i)) * Math.sin(t * 7.3 + i)).toFixed(2)));
			spark.style.opacity = t % 0.8 < 0.12 ? '1' : '0';
			return true;
		});
	}
</script>
