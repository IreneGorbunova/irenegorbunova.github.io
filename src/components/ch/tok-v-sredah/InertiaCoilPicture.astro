---
/**
 * «Опыт с резко остановленной катушкой» (the experiment of Mandelstam and Papaleksi, 1913, and of Tolman and Stewart,
 * 1916), as the school scheme draws it. A loop of 8 с:
 *   0–4 с   the coil spins fast on a vertical axle (the windings run across its front, a dashed arc shows the turn);
 *           its two ends go to two rings on the axle, sliding contacts on the rings and wires to a galvanometer: the
 *           needle stands at 0, because the ions and the free electrons of the wire move together (no current);
 *   4,0 с   a brake pad comes to the rim and stops the coil within 0,3 с: the ions of the lattice stop with the wire,
 *           the free electrons slide on a little by inertia and are pulled back to even spacing within about 1 с; while
 *           they slide, a short current pulse runs through the circuit: the needle kicks to one side and comes back, and
 *           an arrow «I» (red, the chapter's color of the current) points in the wire AGAINST the electrons' slide;
 *   7,5–8,35 с the picture fades out and back in to its first frame (a restart from rest would give a pulse the other way).
 * The magnified panel («под увеличением») shows a piece of the wire: red ions (+) and blue free electrons, all moving
 * with the wire while it spins. Not to scale: in the real experiment the pulse carried about 10⁻⁹ Кл through the
 * galvanometer and the electrons' shift was far smaller than an atom; it is exaggerated here so that it is seen.
 * No numbers in the picture. The two panels stand side by side, one above the other on a phone.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic inc not-content" data-inc>
	<div class="inc__grid">
		<svg class="g7__svg" viewBox="0 0 260 210" role="img" aria-label="Катушка быстро вращается, концы её обмотки через скользящие контакты соединены с гальванометром. Тормоз резко останавливает катушку, и стрелка гальванометра отклоняется и возвращается">
			<defs>
				<marker id="inc-m" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path class="head--ink" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<!-- the stand: a foot and the axle -->
			<rect class="inc-foot" x="28" y="190" width="120" height="8" rx="2"></rect>
			<line class="inc-axle" x1="88" y1="18" x2="88" y2="190"></line>
			<!-- the coil: a short cylinder with windings -->
			<ellipse class="inc-coil-back" cx="88" cy="100" rx="50" ry="10"></ellipse>
			<rect class="inc-coil" x="38" y="46" width="100" height="54"></rect>
			<g data-wind></g>
			<ellipse class="inc-coil-top" cx="88" cy="46" rx="50" ry="10"></ellipse>
			<path class="inc-spin" data-spin d="M40 30 A52 12 0 0 0 128 32" marker-end="url(#inc-m)"></path>
			<!-- the rings and the sliding contacts -->
			<rect class="inc-ring" x="80" y="132" width="16" height="7" rx="2"></rect>
			<rect class="inc-ring" x="80" y="156" width="16" height="7" rx="2"></rect>
			<path class="inc-lead" d="M80 109 Q74 122 81 132 M96 109 Q104 136 95 156"></path>
			<path class="inc-brush" d="M97 135.5 H112 M97 159.5 H112"></path>
			<path class="inc-wire" d="M112 135.5 H190 V122 M112 159.5 H214 V122"></path>
			<!-- the galvanometer -->
			<rect class="inc-meter" x="174" y="66" width="56" height="56" rx="6"></rect>
			<path class="inc-scale" d="M182 102 A20 20 0 0 1 222 102"></path>
			<path class="inc-ticks" d="M202 80 V84 M188.6 86.6 L191.3 89.3 M215.4 86.6 L212.7 89.3"></path>
			<line class="inc-needle" data-needle x1="202" y1="108" x2="202" y2="84"></line>
			<circle class="inc-pivot" cx="202" cy="108" r="2.4"></circle>
			<!-- the brake: a pad on a lever that comes to the rim -->
			<path class="inc-lever" data-lever d=""></path>
			<rect class="inc-pad" data-pad x="0" y="62" width="9" height="22" rx="2"></rect>
			<text class="inc-t" x="4" y="128">катушка</text>
			<line class="inc-lead-l" x1="30" y1="118" x2="42" y2="102"></line>
			<text class="inc-t" x="76" y="152" text-anchor="end">скользящие</text>
			<text class="inc-t" x="76" y="166" text-anchor="end">контакты</text>
			<text class="inc-t" x="202" y="178" text-anchor="middle">гальванометр</text>
			<text class="inc-t" x="252" y="24" text-anchor="end">тормоз</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 260 210" role="img" aria-label="Кусочек провода под увеличением: красные ионы решётки и синие свободные электроны движутся вместе с катушкой. Когда катушка останавливается, электроны по инерции проскакивают немного вперёд, и в проводе на миг возникает ток, направленный против их смещения">
			<defs>
				<marker id="inc-r" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id="inc-g" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path class="head--ink" d="M0,0 L10,5 L0,10 z"></path></marker>
				<clipPath id="inc-clip"><rect x="16" y="66" width="228" height="84" rx="6"></rect></clipPath>
			</defs>
			<text class="inc-t" x="130" y="20" text-anchor="middle">кусочек провода под увеличением</text>
			<line class="inc-move" data-move x1="96" y1="36" x2="156" y2="36" marker-end="url(#inc-g)"></line>
			<text class="inc-t inc-t--soft" data-movet x="130" y="58" text-anchor="middle">движется с катушкой</text>
			<rect class="inc-wire-in" x="16" y="66" width="228" height="84" rx="6"></rect>
			<g clip-path="url(#inc-clip)">
				<g data-ions></g>
				<g data-els></g>
			</g>
			<line class="arrow arrow--red" data-i x1="164" y1="168" x2="100" y2="168" marker-end="url(#inc-r)"></line>
			<text class="inc-i" data-it x="172" y="174">I</text>
			<circle class="inc-key-ion" cx="30" cy="194" r="6"></circle>
			<path class="inc-plus" d="M26.5 194 H33.5 M30 190.5 V197.5"></path>
			<text class="inc-t" x="42" y="198">ион</text>
			<circle class="inc-key-el" cx="98" cy="194" r="3.6"></circle>
			<text class="inc-t" x="108" y="198">свободный электрон</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Опыт с резко остановленной катушкой: свободные электроны по инерции продолжают двигаться, и по цепи проходит короткий импульс тока. Схема, не в масштабе; смещение электронов сильно преувеличено.</figcaption>
</figure>

<style is:global>
	.inc__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@container (max-width: 30rem) {
		.inc__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.inc .g7__svg .inc-t {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.inc .g7__svg .inc-t--soft {
		fill: var(--sl-color-gray-3);
	}
	.inc .g7__svg .inc-i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 17px;
		font-weight: 700;
		fill: var(--g7-red);
	}
	.inc-foot {
		fill: var(--g7-wood);
	}
	.inc-axle {
		stroke: var(--g7-steel);
		stroke-width: 4;
	}
	.inc-coil,
	.inc-coil-back {
		fill: color-mix(in oklab, var(--g7-gold) 45%, var(--g7-wood-dark));
	}
	.inc-coil-top {
		fill: color-mix(in oklab, var(--g7-gold) 30%, var(--g7-paper));
		stroke: var(--g7-gold);
		stroke-width: 1.2;
	}
	.inc-wind {
		stroke: color-mix(in oklab, var(--g7-gold) 80%, var(--sl-color-white));
		stroke-width: 1.6;
	}
	.inc-spin {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.inc-ring {
		fill: color-mix(in oklab, var(--g7-gold) 60%, var(--g7-steel));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.inc-lead {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	.inc-brush {
		stroke: var(--g7-steel-dark);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.inc-wire {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.inc-meter {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.inc-scale,
	.inc-ticks {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.inc-needle {
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.inc-pivot {
		fill: var(--g7-ink);
	}
	.inc-lever {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.inc-pad {
		fill: color-mix(in oklab, var(--g7-red) 35%, var(--g7-steel-dark));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.inc-lead-l {
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.inc-wire-in {
		fill: color-mix(in oklab, var(--g7-gold) 14%, var(--g7-paper));
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	.inc-move {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.inc-ion,
	.inc-key-ion {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--g7-paper));
		stroke: var(--g7-red);
		stroke-width: 1.2;
	}
	.inc-plus {
		stroke: var(--sl-color-white);
		stroke-width: 1.6;
	}
	.inc-el,
	.inc-key-el {
		fill: var(--g7-blue);
	}
</style>

<script>
	import { el, loop } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	const PERIOD = 8;
	const T_STOP = 4;
	const STOP = 0.3; // s, the brake stops the coil
	// the electrons' slide against the lattice after the stop (px): up quickly, back within about 1 s
	const slide = (t: number) => {
		const s = t - T_STOP;
		if (s <= 0) return 0;
		return 16 * (1 - Math.exp(-s / 0.12)) * Math.exp(-s / 0.35);
	};
	let SLIDE_MAX = 0;
	for (let s = 0; s < 2; s += 0.005) SLIDE_MAX = Math.max(SLIDE_MAX, slide(T_STOP + s));
	for (const root of document.querySelectorAll<HTMLElement>('[data-inc]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const wind = q<SVGGElement>('[data-wind]');
		const winds = Array.from({ length: 8 }, () => {
			const l = el('line', { class: 'inc-wind', y1: 50, y2: 104 });
			wind.append(l);
			return l;
		});
		const spin = q<SVGPathElement>('[data-spin]');
		const needle = q<SVGLineElement>('[data-needle]');
		const pad = q<SVGRectElement>('[data-pad]');
		const lever = q<SVGPathElement>('[data-lever]');
		const ionsG = q<SVGGElement>('[data-ions]');
		const elsG = q<SVGGElement>('[data-els]');
		const iArrow = q<SVGLineElement>('[data-i]');
		const iText = q<SVGTextElement>('[data-it]');
		const move = q<SVGLineElement>('[data-move]');
		const moveT = q<SVGTextElement>('[data-movet]');
		const svgs = root.querySelectorAll<SVGSVGElement>('svg');
		// the lattice: 2 rows of ions 32 px apart; free electrons in 3 rows between them
		const DX = 32;
		const ions = [0, 1].flatMap((r) =>
			Array.from({ length: 9 }, (_, k) => {
				const g = el('g', {});
				g.append(el('circle', { class: 'inc-ion', r: 7 }), el('path', { class: 'inc-plus', d: 'M-3.5 0 H3.5 M0 -3.5 V3.5' }));
				ionsG.append(g);
				return { g, x0: k * DX, y: 92 + r * 34 };
			}),
		);
		const els = [0, 1, 2].flatMap((r) =>
			Array.from({ length: 9 }, (_, k) => {
				const c = el('circle', { class: 'inc-el', r: 3.6 });
				elsG.append(c);
				return { c, x0: k * DX + 16 + (r === 1 ? 6 : 0), y: 76 + r * 34 - (r === 2 ? 6 : 0), ph: k * 1.3 + r * 2.1 };
			}),
		);
		// the distance the wire has moved (px): constant speed, then a stop with constant deceleration
		const SPEED = 60;
		const shiftAt = (t: number) => {
			if (t < T_STOP) return SPEED * t;
			const s = Math.min(t - T_STOP, STOP);
			return SPEED * T_STOP + SPEED * (s - (s * s) / (2 * STOP));
		};
		let t = 0;
		loop(root, (dt) => {
			t = (t + dt) % PERIOD;
			const x = shiftAt(t);
			const v = t < T_STOP ? 1 : Math.max(0, 1 - (t - T_STOP) / STOP);
			// the windings run across the coil's front (the front of the coil moves to the right)
			const ph = (x / 10) % 1;
			winds.forEach((l, k) => {
				const a = Math.PI * ((k + ph) / 8);
				const wx = 88 - 49 * Math.cos(a);
				l.setAttribute('x1', f(wx));
				l.setAttribute('x2', f(wx));
			});
			spin.style.opacity = f(v);
			// the brake: the pad comes from the right to the coil's rim just before 4 s and goes back at 7 s
			const inB = Math.min(1, Math.max(0, (t - (T_STOP - 0.15)) / 0.15)) * (1 - Math.min(1, Math.max(0, (t - 7) / 0.3)));
			const px = 168 - 29 * inB;
			pad.setAttribute('x', f(px));
			lever.setAttribute('d', `M${f(px + 9)} 73 L${f(px + 30)} 73 L${f(px + 62)} 36`);
			// the slide of the electrons and the current pulse
			const s = slide(t);
			const k = s / SLIDE_MAX;
			needle.setAttribute('transform', `rotate(${f(-48 * k)} 202 108)`);
			const iOn = k > 0.12 ? Math.min(1, (k - 0.12) / 0.2) : 0;
			iArrow.style.opacity = f(iOn);
			iText.style.opacity = f(iOn);
			move.style.opacity = f(v);
			moveT.style.opacity = f(v);
			// the magnified wire: everything moves with it; after the stop the electrons are ahead by s
			const W = 9 * DX;
			const wrap = (xx: number) => (((xx % W) + W) % W) - DX + 16;
			for (const io of ions) io.g.setAttribute('transform', `translate(${f(wrap(io.x0 + x))} ${io.y})`);
			for (const e of els) {
				e.c.setAttribute('cx', f(wrap(e.x0 + x + s) + 1.2 * Math.sin(7 * t + e.ph)));
				e.c.setAttribute('cy', f(e.y + 1.2 * Math.cos(6 * t + e.ph)));
			}
			// the loop: fade to the first frame
			const fade = t > 7.5 ? (t - 7.5) / 0.5 : t < 0.35 ? 1 - t / 0.35 : 0;
			for (const sv of svgs) sv.style.opacity = f(1 - 0.85 * fade);
			return true;
		});
	}
</script>
