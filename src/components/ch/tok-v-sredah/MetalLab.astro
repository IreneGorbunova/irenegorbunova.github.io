---
/**
 * «Проволока на огне»: a wire of 10 Ом at 0 °C (copper, tungsten, nichrome or constantan) is heated from 0 to 1000 °C.
 * Its resistance follows R = R₀(1 + αt) with the school table values of α: copper 4,3·10⁻³, tungsten 4,8·10⁻³,
 * nichrome 1·10⁻⁴, constantan 1·10⁻⁵ К⁻¹ (copper melts at 1085 °C, so its line ends at 1000 °C). The graph has fixed
 * axes: t 0…1000 °C (0,26 px per °C), R 0…60 Ом (2,6 px per Ом), under the coil; the chosen metal's line is bold, the others faint.
 * The coil glows as hot metal does: from about 525 °C dark red, then red, orange and yellow-white by 1000 °C.
 * The inset «под увеличением» (symbolic; added 28 Nov 2026): a lattice of 6×3 ions (red) and 10 free electrons (blue)
 * that drift to the left while the arrow «I» (red, the chapter's color of the current) points to the right. The ions'
 * vibration amplitude grows as √T, T = t + 273 К (1,5 px at 0 °C, 3,2 px at 1000 °C), and the electrons bounce off the
 * ions (a small gold flash) at a rate proportional to R/R₀ of the chosen metal: 2 per second at 0 °C for every metal,
 * 2,0 for constantan, 2,2 for nichrome, 10,6 for copper and 11,6 for tungsten at 1000 °C.
 */
import G7Styles from '../g7/G7Styles.astro';

const OX = 44;
const OY = 276;
const PT = 0.26;
const PR = 2.6;
const METALS = [
	{ k: 'cu', name: 'Медь', a: 4.3e-3 },
	{ k: 'w', name: 'Вольфрам', a: 4.8e-3 },
	{ k: 'nichrome', name: 'Нихром', a: 1e-4 },
	{ k: 'const', name: 'Константан', a: 1e-5 },
];
const line = (a: number) => `M${OX} ${OY - 10 * PR} L${OX + 1000 * PT} ${(OY - 10 * (1 + a * 1000) * PR).toFixed(1)}`;
// the coil: a spring drawn as loops
let coil = 'M40 40';
for (let i = 0; i < 6; i++) coil += ` q6 -16 14 0 q-4 10 6 0`;
---

<G7Styles />
<figure class="g7 mtl not-content" data-mtl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 330 310" role="img" aria-label="Проволока нагревается, и её сопротивление растёт. График сопротивления в зависимости от температуры для меди, вольфрама, нихрома и константана">
			<rect class="mtl-clamp" x="22" y="30" width="16" height="20" rx="2"></rect>
			<rect class="mtl-clamp" x="158" y="30" width="16" height="20" rx="2"></rect>
			<path class="mtl-coil" data-coil d={coil}></path>
			<path class="mtl-flame" data-flame d="M80 92 Q70 76 86 62 Q84 74 94 70 Q98 56 108 52 Q106 66 116 70 Q126 76 118 92 Z"></path>
			<rect class="mtl-burner" data-burner style="opacity: 0" x="84" y="92" width="30" height="10" rx="2"></rect>
			<text class="t-strong t-num" x="196" y="38" data-temp></text>
			<text class="t-small" x="196" y="56" data-rtext></text>
			<path class="ln" d={`M${OX} ${OY} H${OX + 1000 * PT + 8} M${OX} ${OY} V${OY - 60 * PR - 8}`}></path>
			{[0, 250, 500, 750, 1000].map((t) => (
				<>
					<line class="mtl-grid" x1={OX + t * PT} x2={OX + t * PT} y1={OY} y2={OY - 60 * PR} />
					<text class="t-small t-num" x={OX + t * PT} y={OY + 13} text-anchor="middle">{t}</text>
				</>
			))}
			{[0, 20, 40, 60].map((r) => (
				<>
					<line class="mtl-grid" x1={OX} x2={OX + 1000 * PT} y1={OY - r * PR} y2={OY - r * PR} />
					<text class="t-small t-num" x={OX - 5} y={OY - r * PR + 4} text-anchor="end">{r}</text>
				</>
			))}
			<text class="t-small" x={OX + 1000 * PT + 6} y={OY + 26} text-anchor="end"><tspan class="t-i">t</tspan>, °C</text>
			<text class="t-small" x="6" y={OY - 60 * PR - 10}><tspan class="t-i">R</tspan>, Ом</text>
			{METALS.map((m) => <path class="mtl-line" data-line={m.k} d={line(m.a)} />)}
			<circle class="mtl-point" data-point r="5"></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<span class="g7__label">Металл</span>
				<div class="g7__seg mtl-seg" data-metals>
					{METALS.map((m, i) => (
						<button type="button" class="g7__btn" data-k={m.k} data-a={m.a} aria-pressed={i === 0 ? 'true' : 'false'}>{m.name}</button>
					))}
				</div>
			</div>
			<label class="g7__slider">
				<span>Температура проволоки <i>t</i></span>
				<output data-out-t></output>
				<input type="range" min="0" max="1000" step="10" value="0" data-t aria-label="Температура проволоки, градусы Цельсия" />
			</label>
			<svg class="g7__svg mtl-zoom" viewBox="0 0 200 112" role="img" aria-label="Кусочек проволоки под увеличением: колеблющиеся ионы решётки и свободные электроны, которые движутся против направления тока и сталкиваются с ионами">
				<defs>
					<marker id="mtl-r" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
					<clipPath id="mtl-clip"><rect x="4" y="24" width="192" height="84" rx="5"></rect></clipPath>
				</defs>
				<text class="mtl-zt" x="6" y="15">под увеличением</text>
				<line class="arrow arrow--red" x1="134" y1="11" x2="170" y2="11" marker-end="url(#mtl-r)"></line>
				<text class="mtl-zi" x="182" y="17">I</text>
				<rect class="mtl-zwire" x="4" y="24" width="192" height="84" rx="5"></rect>
				<g clip-path="url(#mtl-clip)" data-zoom></g>
			</svg>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сопротивление при 0&nbsp;°C, <i>R</i><sub>0</sub></span><b>10&nbsp;Ом</b></li>
				<li><span>Температурный коэффициент <i>α</i></span><b data-alpha></b></li>
				<li class="is-key"><span>Сопротивление <i>R</i></span><b data-r></b></li>
			</ul>
			<p class="g7__note" data-calc></p>
		</div>
	</div>
	<figcaption class="g7__caption">Проволока сопротивлением 10&nbsp;Ом при 0&nbsp;°C. Сопротивление рассчитано по формуле <i>R</i> = <i>R</i><sub>0</sub>(1 + <i>αt</i>) с табличными значениями <i>α</i>. Тонкие линии — другие металлы. Свечение проволоки — как у раскалённого металла: тёмно-красное начинается около 525&nbsp;°C.</figcaption>
</figure>

<style is:global>
	/* labels at least 11 px on screen (28 Nov 2026) */
	.mtl .g7__svg .t-small {
		font-size: 11.8px;
	}
	.mtl-clamp {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.mtl-coil {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.mtl-flame {
		fill: color-mix(in oklab, var(--g7-gold) 70%, var(--g7-red));
		opacity: 0.85;
	}
	.mtl-burner {
		fill: var(--g7-steel-dark);
	}
	.mtl-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.mtl-line {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		opacity: 0.6;
	}
	.mtl-line.is-on {
		stroke: var(--g7-gold);
		stroke-width: 2.6;
		opacity: 1;
	}
	.mtl-point {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	.mtl-seg {
		flex-wrap: wrap;
	}
	.mtl-zoom {
		max-width: 250px;
	}
	.mtl .g7__svg .mtl-zt {
		font-size: 11.5px;
		fill: var(--sl-color-gray-2);
	}
	.mtl .g7__svg .mtl-zi {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 700;
		font-size: 16px;
		fill: var(--g7-red);
	}
	.mtl-zwire {
		fill: color-mix(in oklab, var(--g7-gold) 12%, var(--g7-paper));
		stroke: var(--g7-gold);
		stroke-width: 1.2;
	}
	.mtl-ion {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--g7-paper));
		stroke: var(--g7-red);
		stroke-width: 1;
	}
	.mtl-el {
		fill: var(--g7-blue);
	}
	.mtl-flash {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
</style>

<script>
	import { el, fmt, loop, rng, segment } from '../g7/kit';

	const OX = 44;
	const OY = 276;
	const PT = 0.26;
	const PR = 2.6;
	// the color of hot metal: none below 500 °C, then dark red → red → orange → yellow-white at 1000 °C
	const glow = (t: number) => {
		if (t < 500) return null;
		const u = Math.min(1, (t - 500) / 500);
		const h = 0 + 50 * u;
		const l = 28 + 55 * u;
		return `hsl(${h.toFixed(0)}, 100%, ${l.toFixed(0)}%)`;
	};
	const sup = (a: number) => {
		const e = Math.floor(Math.log10(a));
		return `${fmt(a / 10 ** e, 1).replace(',0', '')}·10<sup>${String(e).replace('-', '−')}</sup>&nbsp;К<sup>−1</sup>`;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-mtl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const tIn = q<HTMLInputElement>('[data-t]');
		let key = 'cu';
		let a = 4.3e-3;
		const update = () => {
			const t = Number(tIn.value);
			const R = 10 * (1 + a * t);
			q('[data-out-t]').textContent = `${t} °C`;
			q('[data-temp]').textContent = `${t} °C`;
			q('[data-rtext]').textContent = `R = ${fmt(R, 1)} Ом`;
			q('[data-alpha]').innerHTML = sup(a);
			q('[data-r]').textContent = `${fmt(R, 1)} Ом`;
			q('[data-calc]').innerHTML = `<i>R</i> = 10&nbsp;Ом · (1 + ${fmt(a * 1000, a < 1e-3 ? 2 : 1)}·10<sup>−3</sup> · ${t}) = ${fmt(R, 1)}&nbsp;Ом`;
			for (const l of root.querySelectorAll('[data-line]')) l.classList.toggle('is-on', (l as SVGElement).dataset.line === key);
			q('[data-point]').setAttribute('cx', (OX + t * PT).toFixed(1));
			q('[data-point]').setAttribute('cy', (OY - R * PR).toFixed(1));
			const c = glow(t);
			const coil = q<SVGPathElement>('[data-coil]');
			coil.style.stroke = c ?? '';
			coil.style.filter = c ? `drop-shadow(0 0 ${(2 + (t - 500) / 100).toFixed(1)}px ${c})` : '';
			q<SVGPathElement>('[data-flame]').style.opacity = t > 0 ? '0.85' : '0';
			q<SVGRectElement>('[data-burner]').style.opacity = t > 0 ? '1' : '0';
		};
		segment(q('[data-metals]'), (b) => {
			key = b.dataset.k!;
			a = Number(b.dataset.a);
			update();
		});
		tIn.addEventListener('input', update);
		update();
		// the inset: ions vibrate (amplitude ∝ √T), electrons drift left and bounce off ions at a rate ∝ R/R₀
		const zg = q<SVGGElement>('[data-zoom]');
		const rand = rng(9);
		const ions = Array.from({ length: 18 }, (_, i) => {
			const c = el('circle', { class: 'mtl-ion', r: 6 });
			zg.append(c);
			return { c, x: 22 + (i % 6) * 31, y: 38 + Math.floor(i / 6) * 28, ph: rand() * 6.3, w: 10 + rand() * 4 };
		});
		const els = Array.from({ length: 10 }, () => {
			const c = el('circle', { class: 'mtl-el', r: 3 });
			zg.append(c);
			const a = rand() * 6.3;
			return { c, x: 8 + rand() * 184, y: 28 + rand() * 76, vx: 45 * Math.cos(a), vy: 45 * Math.sin(a) };
		});
		const flashes: { c: SVGCircleElement; age: number }[] = [];
		let clock = 0;
		loop(root, (dt) => {
			clock += dt;
			const t = Number(tIn.value);
			const A = 1.5 * Math.sqrt((t + 273) / 273);
			for (const io of ions) {
				io.c.setAttribute('cx', (io.x + A * Math.sin(io.w * clock + io.ph)).toFixed(1));
				io.c.setAttribute('cy', (io.y + A * Math.cos(1.3 * io.w * clock + io.ph)).toFixed(1));
			}
			const rate = 2 * (1 + a * t);
			for (const e of els) {
				e.x += (e.vx - 18) * dt;
				e.y += e.vy * dt;
				if (e.x < 4) e.x += 192;
				if (e.y < 28 || e.y > 104) e.vy = -e.vy;
				e.y = Math.min(104, Math.max(28, e.y));
				if (rand() < (rate / els.length) * dt) {
					const ang = rand() * 6.3;
					e.vx = 45 * Math.cos(ang);
					e.vy = 45 * Math.sin(ang);
					const c = el('circle', { class: 'mtl-flash', cx: e.x.toFixed(1), cy: e.y.toFixed(1), r: 3 });
					zg.append(c);
					flashes.push({ c, age: 0 });
				}
				if (e.x > 196) e.x -= 192;
				e.c.setAttribute('cx', e.x.toFixed(1));
				e.c.setAttribute('cy', e.y.toFixed(1));
			}
			for (let i = flashes.length - 1; i >= 0; i--) {
				const fl = flashes[i];
				fl.age += dt;
				fl.c.setAttribute('r', (3 + 14 * fl.age).toFixed(1));
				fl.c.style.opacity = Math.max(0, 1 - fl.age / 0.35).toFixed(2);
				if (fl.age > 0.35) {
					fl.c.remove();
					flashes.splice(i, 1);
				}
			}
			return true;
		});
	}
</script>
