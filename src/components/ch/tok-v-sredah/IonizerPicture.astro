---
/**
 * «Пламя ионизует воздух» — the classic school experiment, a loop of 10 с. Two vertical metal plates 5 см apart stand
 * in air on insulating stands (11,2 px per см); the left one is joined to a charged electrometer (the needle at 60°
 * from the rod), the right one is grounded.
 *   0–3 с   nothing changes: air does not conduct, the needle stays;
 *   3–4 с   a spirit lamp slides in under the gap; while its flame is under the gap it makes positive ions (red, «+»)
 *           and electrons (blue) between the plates; in the field the electrons drift to the «+» plate and the ions to
 *           the grounded one, the warm air also carries them up a little; the charge of the left plate falls, so the
 *           needle falls steadily (10° per second with the flame fully under the gap: to 15° when the lamp is out);
 *   8–9 с   the lamp slides out: no new charges, the needle stops where it is;
 *   9,4–10,3 с the picture fades out and back in to its first frame (the needle at 60° again).
 * The «+» marks on the outer side of the left plate are as many as the needle's angle allows (6 at 60°). Symbolic
 * speeds of the charges; real ions drift far slower.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic ion not-content" data-ionz>
	<div class="ion__wrap">
		<svg class="g7__svg" viewBox="0 0 360 214" role="img" aria-label="Две металлические пластины на изолирующих подставках; одна соединена с заряженным электрометром, другая заземлена. Под зазор между пластинами подвигают горящую спиртовку, и стрелка электрометра опускается. Спиртовку убирают, и стрелка останавливается">
			<!-- the table -->
			<rect class="ion-table" x="0" y="186" width="360" height="9"></rect>
			<!-- the electrometer: a case, a rod with a ball, the needle and a scale -->
			<rect class="ion-stand" x="57" y="130" width="10" height="56"></rect>
			<rect class="ion-stand" x="40" y="180" width="44" height="6" rx="2"></rect>
			<circle class="ion-case" cx="62" cy="92" r="38"></circle>
			<path class="ion-scale" d="M30.9 70.2 A38 38 0 0 1 93.1 70.2" transform="translate(0 4) scale(1)"></path>
			<line class="ion-rod" x1="62" y1="44" x2="62" y2="112"></line>
			<circle class="ion-ball" cx="62" cy="42" r="4.5"></circle>
			<line class="ion-needle" data-needle x1="62" y1="120" x2="62" y2="64"></line>
			<circle class="ion-pivot" cx="62" cy="92" r="2.2"></circle>
			<!-- the wire to the left plate; the ground of the right plate -->
			<path class="ion-wire" d="M66 42 H169 V48"></path>
			<path class="ion-wire" d="M231 48 V30 H292 V42"></path>
			<path class="ion-ground" d="M282 42 H302 M286 47 H298 M290 52 H294"></path>
			<!-- the plates on insulating stands -->
			<rect class="ion-plate" x="166" y="48" width="6" height="90"></rect>
			<rect class="ion-plate" x="228" y="48" width="6" height="90"></rect>
			<rect class="ion-ins" x="166.5" y="138" width="5" height="44"></rect>
			<rect class="ion-ins" x="228.5" y="138" width="5" height="44"></rect>
			<rect class="ion-stand" x="158" y="182" width="22" height="4" rx="1"></rect>
			<rect class="ion-stand" x="220" y="182" width="22" height="4" rx="1"></rect>
			<g data-plus></g>
			<g data-q></g>
			<!-- the spirit lamp -->
			<g data-lamp transform="translate(312 186)">
				<path class="ion-flame" data-flame d=""></path>
				<rect class="ion-wick" x="-1.5" y="-30" width="3" height="6"></rect>
				<rect class="ion-neck" x="-5" y="-26" width="10" height="5" rx="1"></rect>
				<path class="ion-bottle" d="M-14 0 V-14 Q-14 -21 -6 -22 H6 Q14 -21 14 -14 V0 Z"></path>
				<path class="ion-spirit" d="M-13 -1 V-9 H13 V-1 Z"></path>
				<text class="ion-t" x="0" y="20" text-anchor="middle">спиртовка</text>
			</g>
			<text class="ion-t" x="62" y="206" text-anchor="middle">электрометр</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Пламя ионизует воздух между пластинами, и электрометр разряжается; без пламени заряд держится. Скорости частиц условные.</figcaption>
</figure>

<style is:global>
	.ion__wrap {
		max-width: 30rem;
		margin-inline: auto;
	}
	.ion .g7__svg .ion-t {
		font-size: 12.5px;
		fill: var(--sl-color-gray-2);
	}
	.ion-table {
		fill: var(--g7-wood);
	}
	.ion-stand {
		fill: var(--g7-steel-dark);
	}
	.ion-case {
		fill: color-mix(in oklab, var(--g7-blue) 6%, var(--g7-paper));
		stroke: var(--g7-steel);
		stroke-width: 4;
	}
	.ion-scale {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-dasharray: 2 4;
	}
	.ion-rod {
		stroke: var(--g7-steel);
		stroke-width: 3;
	}
	.ion-ball {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.ion-needle {
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.ion-pivot {
		fill: var(--g7-ink);
	}
	.ion-wire,
	.ion-ground {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.ion-plate {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.ion-ins {
		fill: hsl(25, 30%, 22%);
	}
	.ion-plus {
		stroke: var(--g7-red);
		stroke-width: 1.8;
	}
	.ion-pos {
		fill: color-mix(in oklab, var(--g7-red) 60%, var(--g7-paper));
		stroke: var(--g7-red);
		stroke-width: 1;
	}
	.ion-pos-sign {
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	.ion-el {
		fill: var(--g7-blue);
	}
	.ion-flame {
		fill: color-mix(in oklab, var(--g7-gold) 65%, var(--g7-blue));
		opacity: 0.85;
	}
	.ion-wick {
		fill: var(--sl-color-gray-1);
	}
	.ion-neck {
		fill: var(--g7-steel);
	}
	.ion-bottle {
		fill: color-mix(in oklab, var(--sl-color-white) 14%, var(--g7-paper));
		stroke: var(--g7-glass);
		stroke-width: 1.4;
	}
	.ion-spirit {
		fill: var(--g7-water);
	}
</style>

<script>
	import { el, loop, rng } from '../g7/kit';

	const PERIOD = 10;
	const f = (v: number) => v.toFixed(1);
	const ease = (u: number) => {
		const x = Math.min(1, Math.max(0, u));
		return x * x * (3 - 2 * x);
	};
	const XOUT = 312;
	const XIN = 200;
	const lampX = (t: number) => (t < 8 ? XOUT + (XIN - XOUT) * ease(t - 3) : XIN + (XOUT - XIN) * ease(t - 8));
	const under = (t: number) => Math.min(1, Math.max(0, 1 - Math.abs(lampX(t) - XIN) / 40));
	// the needle's angle, integrated once: −10° per second with the flame fully under the gap
	const DT = 0.01;
	const PHI: number[] = [];
	let phi = 60;
	for (let k = 0; k <= PERIOD / DT; k++) {
		PHI.push(phi);
		phi -= 10 * under(k * DT) * DT;
	}
	const phiAt = (t: number) => PHI[Math.min(PHI.length - 1, Math.round(t / DT))];
	for (const root of document.querySelectorAll<HTMLElement>('[data-ionz]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('svg');
		const needle = q<SVGLineElement>('[data-needle]');
		const lamp = q<SVGGElement>('[data-lamp]');
		const flame = q<SVGPathElement>('[data-flame]');
		const plusG = q<SVGGElement>('[data-plus]');
		const qG = q<SVGGElement>('[data-q]');
		const rand = rng(5);
		const pluses = Array.from({ length: 6 }, (_, k) => {
			const y = 58 + k * 14;
			const p = el('path', { class: 'ion-plus', d: `M154 ${y} H162 M158 ${y - 4} V${y + 4}` });
			plusG.append(p);
			return p;
		});
		const parts: { g: SVGElement; x: number; y: number; vx: number; vy: number }[] = [];
		let t = 0;
		let acc = 0;
		loop(root, (dt) => {
			const tp = t;
			t = (t + dt) % PERIOD;
			if (t < tp) {
				for (const p of parts) p.g.remove();
				parts.length = 0;
			}
			const x = lampX(t);
			lamp.setAttribute('transform', `translate(${f(x)} 186)`);
			const fl = 1 + 0.12 * Math.sin(t * 23) + 0.08 * Math.sin(t * 37);
			flame.setAttribute('d', `M0 -30 Q-7 ${f(-38 * fl)} 0 ${f(-58 * fl)} Q7 ${f(-38 * fl)} 0 -30 Z`);
			const ph = phiAt(t);
			// the needle: its upper end swings away from the rod by φ
			const a = (ph * Math.PI) / 180;
			needle.setAttribute('x1', f(62 - 24 * Math.sin(a)));
			needle.setAttribute('y1', f(92 + 24 * Math.cos(a)));
			needle.setAttribute('x2', f(62 + 28 * Math.sin(a)));
			needle.setAttribute('y2', f(92 - 28 * Math.cos(a)));
			const n = Math.round((6 * ph) / 60);
			pluses.forEach((p, k) => (p.style.display = k < n ? '' : 'none'));
			// new pairs in the flame's tip while it is under the gap
			const g = under(t);
			acc += dt * 9 * g;
			while (acc > 1) {
				acc -= 1;
				const y = 118 + rand() * 14;
				const xx = x - 6 + rand() * 12;
				const io = el('g', {});
				io.append(el('circle', { class: 'ion-pos', r: 4 }), el('path', { class: 'ion-pos-sign', d: 'M-2.2 0 H2.2 M0 -2.2 V2.2' }));
				const e = el('circle', { class: 'ion-el', r: 2.4 });
				qG.append(io, e);
				parts.push({ g: io, x: xx + 3, y, vx: 26, vy: -10 }, { g: e, x: xx - 3, y, vx: -52, vy: -10 });
			}
			for (let i = parts.length - 1; i >= 0; i--) {
				const p = parts[i];
				p.x += p.vx * dt;
				p.y += p.vy * dt;
				if (p.x < 176 || p.x > 224 || p.y < 54) {
					p.g.remove();
					parts.splice(i, 1);
					continue;
				}
				if (p.g.tagName === 'circle') {
					p.g.setAttribute('cx', f(p.x));
					p.g.setAttribute('cy', f(p.y));
				} else p.g.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)})`);
			}
			const fade = t > 9.4 ? (t - 9.4) / 0.6 : t < 0.3 ? 1 - t / 0.3 : 0;
			svg.style.opacity = f(1 - 0.85 * fade);
			return true;
		});
	}
</script>
