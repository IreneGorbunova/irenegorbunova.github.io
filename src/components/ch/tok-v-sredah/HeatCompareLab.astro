---
/**
 * «Медь и полупроводник при нагревании». A beaker of water on an electric stove holds two samples on long leads: a coil
 * of copper wire and a small semiconductor thermistor (a bead). Two ohmmeters above read their resistance; a
 * thermometer in the water shows its temperature t.
 *   copper: R = R₀(1 + αt), R₀ = 10,0 Ом at 0 °C, α = 4,3·10⁻³ К⁻¹: 10,0 → 14,3 Ом from 0 to 100 °C;
 *   thermistor: R = R₂₅·exp(B(1/T − 1/298,15 К)), R₂₅ = 10,0 кОм, B = 3950 К (a common NTC thermistor), T = t + 273,15:
 *     33,6 кОм at 0 °C, 12,5 at 20, 10,0 at 25, 3,59 at 50, 1,49 at 75, 0,698 кОм at 100 °C (half of R₂₅ at 41,5 °C).
 * Controls: the slider t = 0…100 °C (step 1) and «Нагреть», which warms the water by 10 °C per second (time compressed;
 * pressed at 100 °C it starts again from 0 °C, pressed while heating it pauses). Bubbles rise from 90 °C on.
 * The small graph: R/R(0 °C) against t for both, copper 1 → 1,43, the thermistor 1 → 0,021, with today's points.
 * «Под увеличением» (symbolic): copper — a lattice of 6×3 ions (red) and 10 free electrons (blue); the number of
 *   electrons does not change, the ions' vibration amplitude grows as √T (2,5 px at 0 °C, 2,9 px at 100 °C) and the
 *   electrons bounce off them (a small flash) at a rate proportional to R, 2,4 per second at 0 °C;
 *   semiconductor — a lattice of 6×3 silicon atoms (gray) with n free electrons (blue) and n holes (red rings),
 *   n = 1 + 15·(R(0 °C)/R − 1)/47 rounded, so 1 pair at 0 °C and 16 at 100 °C: the count grows as the conductance does.
 * The time of heating is compressed; the caption says so.
 */
import G7Styles from '../g7/G7Styles.astro';

const OX = 40;
const OY = 128;
const PT = 1.8; // px per °C
const PY = 200 / 3; // px per unit of R/R₀
const semi = (t: number) => Math.exp(3950 * (1 / (t + 273.15) - 1 / 273.15));
let curve = '';
for (let t = 0; t <= 100; t += 2) curve += `${t ? 'L' : 'M'}${(OX + t * PT).toFixed(1)} ${(OY - semi(t) * PY).toFixed(1)} `;
let coil = 'M102 198';
for (let i = 0; i < 6; i++) coil += ` c0 -24 8 -24 7 0 c0 8 -4 8 -2 0`;
---

<G7Styles />
<figure class="g7 hcl not-content" data-hcl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 356" role="img" aria-label="Стакан с водой на электроплитке. В воде медная проволока и полупроводниковый терморезистор, их сопротивление показывают два омметра. Ниже — оба образца под увеличением">
			<!-- the ohmmeters -->
			<rect class="hcl-meter" x="14" y="8" width="144" height="46" rx="6"></rect>
			<rect class="hcl-meter" x="202" y="8" width="144" height="46" rx="6"></rect>
			<text class="hcl-name" x="86" y="25" text-anchor="middle">медь</text>
			<text class="hcl-name" x="274" y="25" text-anchor="middle">полупроводник</text>
			<text class="hcl-val" data-vcu x="86" y="46" text-anchor="middle"></text>
			<text class="hcl-val" data-vsi x="274" y="46" text-anchor="middle"></text>
			<!-- the leads -->
			<path class="hcl-wire" d="M80 54 V150 L104 192 M92 54 V150 L136 192"></path>
			<path class="hcl-wire" d="M268 54 V150 L238 186 M280 54 V150 L246 186"></path>
			<!-- the beaker and the water -->
			<rect class="hcl-water" data-water x="70" y="102" width="220" height="128"></rect>
			<path class="hcl-glass" d="M66 82 H72 V230 Q72 234 76 234 H284 Q288 234 288 230 V82 H294"></path>
			<g data-bub></g>
			<!-- the samples -->
			<path class="hcl-coil" d={coil}></path>
			<ellipse class="hcl-bead" cx="242" cy="192" rx="7" ry="9"></ellipse>
			<!-- the thermometer -->
			<rect class="hcl-thermo" x="176" y="64" width="8" height="154" rx="4"></rect>
			<circle class="hcl-bulb" cx="180" cy="222" r="7"></circle>
			<rect class="hcl-col" data-col x="178" y="100" width="4" height="120"></rect>
			<text class="hcl-tt" data-tt x="190" y="76"></text>
			<!-- the stove -->
			<rect class="hcl-stove" x="56" y="236" width="248" height="16" rx="3"></rect>
			<rect class="hcl-plate" data-plate x="74" y="234" width="212" height="4" rx="1.5"></rect>
			<!-- the magnified pieces -->
			<text class="hcl-name" x="180" y="268" text-anchor="middle">под увеличением</text>
			<rect class="hcl-inset" x="12" y="276" width="160" height="76" rx="6"></rect>
			<rect class="hcl-inset" x="188" y="276" width="160" height="76" rx="6"></rect>
			<g data-icu></g>
			<g data-isi></g>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Температура воды <i>t</i></span>
				<output data-out></output>
				<input type="range" min="0" max="100" step="1" value="0" data-t aria-label="Температура воды, градусы Цельсия" />
			</label>
			<button type="button" class="g7__btn g7__btn--go hcl-go" data-go>Нагреть</button>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сопротивление меди</span><b data-rcu></b></li>
				<li class="is-key"><span>Сопротивление полупроводника</span><b data-rsi></b></li>
			</ul>
			<svg class="g7__svg hcl-graph" viewBox="0 0 240 160" role="img" aria-label="График: отношение сопротивления к сопротивлению при 0 °C в зависимости от температуры для меди и полупроводника">
				<path class="ln" d={`M${OX} ${OY} H${OX + 100 * PT + 8} M${OX} ${OY} V${OY - 1.5 * PY - 8}`}></path>
				{[0, 50, 100].map((t) => <text class="hcl-ax" x={OX + t * PT} y={OY + 15} text-anchor="middle">{t}</text>)}
				{[0.5, 1, 1.5].map((r) => (
					<>
						<line class="hcl-grid" x1={OX} x2={OX + 100 * PT} y1={OY - r * PY} y2={OY - r * PY} />
						<text class="hcl-ax" x={OX - 5} y={OY - r * PY + 4} text-anchor="end">{String(r).replace('.', ',')}</text>
					</>
				))}
				<text class="hcl-ax" x="236" y="156" text-anchor="end"><tspan class="hcl-i">t</tspan>, °C</text>
				<text class="hcl-ax" x="4" y="14"><tspan class="hcl-i">R</tspan> / <tspan class="hcl-i">R</tspan>₀</text>
				<path class="hcl-lcu" d={`M${OX} ${OY - PY} L${OX + 100 * PT} ${(OY - 1.43 * PY).toFixed(1)}`}></path>
				<path class="hcl-lsi" d={curve}></path>
				<text class="hcl-lab hcl-lab--cu" x="106" y="32">медь</text>
				<text class="hcl-lab hcl-lab--si" x="96" y="100">полупроводник</text>
				<circle class="hcl-pcu" data-pcu r="4"></circle>
				<circle class="hcl-psi" data-psi r="4"></circle>
			</svg>
		</div>
	</div>
	<figcaption class="g7__caption">Сопротивление полупроводника считается по формуле для настоящего терморезистора; время нагрева сжато. Под увеличением: красные кружки — ионы меди, красные кольца — дырки, синие точки — свободные электроны; число частиц условное.</figcaption>
</figure>

<style is:global>
	.hcl .g7__svg .hcl-name {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	.hcl .g7__svg .hcl-val {
		font-size: 16px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.hcl .g7__svg .hcl-tt {
		font-size: 13px;
		font-weight: 700;
		fill: var(--g7-red);
		font-variant-numeric: tabular-nums;
	}
	.hcl .g7__svg .hcl-ax {
		font-size: 11px;
		fill: var(--sl-color-gray-3);
	}
	.hcl .g7__svg .hcl-i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 13px;
	}
	.hcl .g7__svg .hcl-lab {
		font-size: 11.5px;
		font-weight: 600;
	}
	.hcl .g7__svg .hcl-lab--cu {
		fill: var(--g7-gold);
	}
	.hcl .g7__svg .hcl-lab--si {
		fill: var(--g7-violet);
	}
	.hcl-graph {
		max-width: 270px;
	}
	.hcl-go {
		justify-self: start;
	}
	.hcl-meter {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.hcl-wire {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.3;
	}
	.hcl-water {
		fill: var(--g7-water);
	}
	.hcl-glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.hcl-bubble {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 1;
	}
	.hcl-coil {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-gold) 70%, var(--g7-red));
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.hcl-bead {
		fill: color-mix(in oklab, var(--g7-violet) 45%, var(--g7-ink) 10%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.hcl-thermo {
		fill: color-mix(in oklab, var(--sl-color-white) 12%, var(--g7-paper));
		stroke: var(--g7-glass);
		stroke-width: 1;
	}
	.hcl-bulb,
	.hcl-col {
		fill: var(--g7-red);
	}
	.hcl-stove {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.hcl-plate {
		fill: var(--g7-steel);
	}
	.hcl-inset {
		fill: var(--g7-paper);
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.hcl-ion {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--g7-paper));
		stroke: var(--g7-red);
		stroke-width: 1;
	}
	.hcl-si {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 45%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.hcl-el {
		fill: var(--g7-blue);
	}
	.hcl-hole {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.8;
	}
	.hcl-flash {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	.hcl-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.hcl-lcu {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
	}
	.hcl-lsi {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 2.2;
	}
	.hcl-pcu {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.4;
	}
	.hcl-psi {
		fill: var(--g7-violet);
		stroke: var(--g7-paper);
		stroke-width: 1.4;
	}
</style>

<script>
	import { el, fmt, loop, rng } from '../g7/kit';

	const OX = 40;
	const OY = 128;
	const PT = 1.8;
	const PY = 200 / 3;
	const rCu = (t: number) => 10 * (1 + 4.3e-3 * t); // Ом
	const rSi = (t: number) => 10 * Math.exp(3950 * (1 / (t + 273.15) - 1 / 298.15)); // кОм
	const R0SI = rSi(0);
	const pairs = (t: number) => Math.round(1 + (15 * (R0SI / rSi(t) - 1)) / 47);
	const kOhm = (r: number) => (r >= 10 ? fmt(r, 1) : r >= 1 ? fmt(r, 2) : fmt(r, 3));
	const f = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-hcl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const tIn = q<HTMLInputElement>('[data-t]');
		const go = q<HTMLButtonElement>('[data-go]');
		const rand = rng(7);
		// copper inset: 6×3 ions, 10 electrons
		const gCu = q<SVGGElement>('[data-icu]');
		const ions = Array.from({ length: 18 }, (_, i) => {
			const c = el('circle', { class: 'hcl-ion', r: 5.5 });
			gCu.append(c);
			return { c, x: 30 + (i % 6) * 25, y: 290 + Math.floor(i / 6) * 22, ph: rand() * 6.3, w: 9 + rand() * 4 };
		});
		const flashes: { c: SVGCircleElement; age: number }[] = [];
		const els = Array.from({ length: 10 }, () => {
			const c = el('circle', { class: 'hcl-el', r: 3 });
			gCu.append(c);
			const a = rand() * 6.3;
			return { c, x: 20 + rand() * 144, y: 282 + rand() * 64, vx: 40 * Math.cos(a), vy: 40 * Math.sin(a) };
		});
		// semiconductor inset: 6×3 atoms, up to 16 electrons and 16 holes
		const gSi = q<SVGGElement>('[data-isi]');
		const SITES = Array.from({ length: 18 }, (_, i) => ({ x: 206 + (i % 6) * 25, y: 290 + Math.floor(i / 6) * 22 }));
		for (const s of SITES) gSi.append(el('circle', { class: 'hcl-si', r: 5.5 }));
		[...gSi.children].forEach((c, i) => {
			c.setAttribute('cx', String(SITES[i].x));
			c.setAttribute('cy', String(SITES[i].y));
		});
		const sEls = Array.from({ length: 16 }, () => {
			const c = el('circle', { class: 'hcl-el', r: 3 });
			gSi.append(c);
			const a = rand() * 6.3;
			return { c, x: 196 + rand() * 144, y: 282 + rand() * 64, vx: 40 * Math.cos(a), vy: 40 * Math.sin(a) };
		});
		const holes = Array.from({ length: 16 }, (_, i) => {
			const c = el('circle', { class: 'hcl-hole', r: 7.5 });
			gSi.append(c);
			return { c, site: [0, 7, 14, 3, 10, 17, 5, 12, 1, 8, 15, 4, 11, 2, 9, 16][i], next: rand() * 1.5 };
		});
		const bubG = q<SVGGElement>('[data-bub]');
		const bubbles = Array.from({ length: 10 }, (_, i) => {
			const c = el('circle', { class: 'hcl-bubble', r: 2 + (i % 3) });
			bubG.append(c);
			return { c, x: 84 + ((i * 53) % 190), t0: rand() * 1.6, v: 60 + rand() * 30 };
		});
		let heating = false;
		let clock = 0;
		let temp = 0; // °C, kept as a float: the slider (step 1) only shows it
		const show = () => {
			const t = Math.round(temp);
			tIn.value = String(t);
			const cu = rCu(t);
			const si = rSi(t);
			q('[data-out]').textContent = `${t} °C`;
			q('[data-tt]').textContent = `${t} °C`;
			q('[data-vcu]').textContent = `${fmt(cu, 1)} Ом`;
			q('[data-vsi]').textContent = `${kOhm(si)} кОм`;
			q('[data-rcu]').textContent = `${fmt(cu, 1)} Ом`;
			q('[data-rsi]').textContent = `${kOhm(si)} кОм`;
			q('[data-col]').setAttribute('y', f(210 - t * 1.2));
			q('[data-col]').setAttribute('height', f(12 + t * 1.2));
			q('[data-pcu]').setAttribute('cx', f(OX + t * PT));
			q('[data-pcu]').setAttribute('cy', f(OY - (cu / 10) * PY));
			q('[data-psi]').setAttribute('cx', f(OX + t * PT));
			q('[data-psi]').setAttribute('cy', f(OY - (si / R0SI) * PY));
			(q('[data-plate]') as SVGElement).style.fill = heating ? 'color-mix(in oklab, var(--g7-red) 75%, var(--g7-gold))' : '';
			const n = pairs(t);
			sEls.forEach((e, i) => (e.c.style.display = i < n ? '' : 'none'));
			holes.forEach((h, i) => (h.c.style.display = i < n ? '' : 'none'));
			go.textContent = heating ? 'Пауза' : 'Нагреть';
		};
		tIn.addEventListener('input', () => {
			heating = false;
			temp = Number(tIn.value);
			show();
		});
		go.addEventListener('click', () => {
			if (!heating && temp >= 100) temp = 0;
			heating = !heating;
			show();
		});
		const bounce = (e: { x: number; y: number; vx: number; vy: number }, x0: number, x1: number, y0: number, y1: number) => {
			if (e.x < x0 || e.x > x1) e.vx = -e.vx;
			if (e.y < y0 || e.y > y1) e.vy = -e.vy;
			e.x = Math.min(x1, Math.max(x0, e.x));
			e.y = Math.min(y1, Math.max(y0, e.y));
		};
		loop(root, (dt) => {
			clock += dt;
			if (heating) {
				temp = Math.min(100, temp + 10 * dt);
				if (temp >= 100) heating = false;
				show();
			}
			const t = temp;
			const T = t + 273.15;
			// copper: ions vibrate (amplitude ∝ √T), electrons fly and bounce off ions at a rate ∝ R
			const A = 2.5 * Math.sqrt(T / 273.15);
			for (const io of ions) {
				io.c.setAttribute('cx', f(io.x + A * Math.sin(io.w * clock + io.ph)));
				io.c.setAttribute('cy', f(io.y + A * Math.cos(1.3 * io.w * clock + io.ph)));
			}
			const rate = 2.4 * (rCu(t) / 10);
			for (const e of els) {
				e.x += e.vx * dt;
				e.y += e.vy * dt;
				bounce(e, 18, 166, 281, 347);
				if (rand() < (rate / els.length) * dt) {
					// a collision: a small flash and a new direction
					const a = rand() * 6.3;
					e.vx = 40 * Math.cos(a);
					e.vy = 40 * Math.sin(a);
					const c = el('circle', { class: 'hcl-flash', cx: f(e.x), cy: f(e.y), r: 3 });
					gCu.append(c);
					flashes.push({ c, age: 0 });
				}
				e.c.setAttribute('cx', f(e.x));
				e.c.setAttribute('cy', f(e.y));
			}
			for (let i = flashes.length - 1; i >= 0; i--) {
				const fl = flashes[i];
				fl.age += dt;
				fl.c.setAttribute('r', f(3 + 14 * fl.age));
				fl.c.style.opacity = f(Math.max(0, 1 - fl.age / 0.35));
				if (fl.age > 0.35) {
					fl.c.remove();
					flashes.splice(i, 1);
				}
			}
			// semiconductor: free electrons fly, holes hop from atom to atom
			for (const e of sEls) {
				e.x += e.vx * dt;
				e.y += e.vy * dt;
				bounce(e, 194, 342, 281, 347);
				e.c.setAttribute('cx', f(e.x));
				e.c.setAttribute('cy', f(e.y));
			}
			for (const h of holes) {
				h.next -= dt;
				if (h.next < 0) {
					const s = SITES[h.site];
					const busy = new Set(holes.filter((o) => o.c.style.display !== 'none').map((o) => o.site));
					const nb = SITES.map((p, i) => ({ i, d: Math.hypot(p.x - s.x, p.y - s.y) })).filter((o) => o.d > 1 && o.d < 26 && !busy.has(o.i));
					if (nb.length) h.site = nb[Math.floor(rand() * nb.length)].i;
					h.next = 0.6 + rand() * 0.9;
				}
				h.c.setAttribute('cx', String(SITES[h.site].x));
				h.c.setAttribute('cy', String(SITES[h.site].y));
			}
			// bubbles from 90 °C on
			const nb = t < 90 ? 0 : Math.round(((t - 90) / 10) * bubbles.length);
			bubbles.forEach((b, i) => {
				const on = i < nb;
				b.c.style.display = on ? '' : 'none';
				if (!on) return;
				const y = 226 - ((b.v * (clock + b.t0)) % 120);
				b.c.setAttribute('cx', f(b.x + 2 * Math.sin(clock * 6 + i)));
				b.c.setAttribute('cy', f(y));
			});
			return true;
		});
		show();
	}
</script>
