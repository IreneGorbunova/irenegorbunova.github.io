---
/**
 * «Кристалл кремния»: a flat scheme of a silicon crystal, 6 × 4 atoms, each joined to its neighbors by bonds of two
 * electrons (small blue dots). The electric field E points to the right. Three cases by buttons:
 *   pure — two bonds are broken by heat: a free electron (big blue dot) drifts to the left between the atoms, and the
 *     hole it left (red ring with «+») moves to the right, jumping from bond to bond as a neighboring bond electron fills
 *     it (one jump every 0,7 с);
 *   n — two atoms of arsenic (valence 5, gold) give their fifth electrons, which drift freely; no holes;
 *   p — two atoms of indium (valence 3, violet) leave a bond without an electron: holes that move to the right.
 * Atom symbols are 12,5 px and the legend 12 px (about 11 px on a 390 px phone).
 * A flat scheme of a three-dimensional crystal; symbolic speeds; the real share of free carriers is far smaller.
 */
import G7Styles from '../g7/G7Styles.astro';

const X0 = 46;
const Y0 = 44;
const DX = 54;
const DY = 42;
const atoms: { i: number; j: number }[] = [];
for (let j = 0; j < 4; j++) for (let i = 0; i < 6; i++) atoms.push({ i, j });
const bonds: { x: number; y: number; h: boolean }[] = [];
for (let j = 0; j < 4; j++) for (let i = 0; i < 6; i++) {
	if (i < 5) bonds.push({ x: X0 + DX * i + DX / 2, y: Y0 + DY * j, h: true });
	if (j < 3) bonds.push({ x: X0 + DX * i, y: Y0 + DY * j + DY / 2, h: false });
}
---

<G7Styles />
<figure class="g7 g7--pic smc not-content" data-smc>
	<div class="g7__row smc-btns">
		<div class="g7__seg" data-modes>
			<button type="button" class="g7__btn" data-m="pure" aria-pressed="true">Чистый кремний</button>
			<button type="button" class="g7__btn" data-m="n" aria-pressed="false">Примесь мышьяка: n-тип</button>
			<button type="button" class="g7__btn" data-m="p" aria-pressed="false">Примесь индия: p-тип</button>
		</div>
	</div>
	<svg class="g7__svg" viewBox="0 0 360 220" role="img" aria-label="Схема кристалла кремния: атомы связаны парами электронов. Свободные электроны движутся против поля, дырки — по полю">
		<defs>
			<marker id="smc-a" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--ink" d="M0,0 L10,5 L0,10 z"></path></marker>
		</defs>
		{bonds.map((b) => (
			<>
				<line class="smc-bond" x1={b.h ? b.x - DX / 2 : b.x} x2={b.h ? b.x + DX / 2 : b.x} y1={b.h ? b.y : b.y - DY / 2} y2={b.h ? b.y : b.y + DY / 2} />
				<circle class="smc-be" cx={b.h ? b.x - 4 : b.x - 3} cy={b.h ? b.y - 3 : b.y - 4} r="2.2" />
				<circle class="smc-be" cx={b.h ? b.x + 4 : b.x + 3} cy={b.h ? b.y + 3 : b.y + 4} r="2.2" />
			</>
		))}
		{atoms.map((a) => (
			<g data-atom={`${a.i}-${a.j}`}>
				<circle class="smc-atom" cx={X0 + DX * a.i} cy={Y0 + DY * a.j} r="12.5" />
				<text class="smc-sym" x={X0 + DX * a.i} y={Y0 + DY * a.j + 4.5} text-anchor="middle">Si</text>
			</g>
		))}
		<g data-carriers></g>
		<line class="arrow smc-field" x1="140" y1="14" x2="210" y2="14" marker-end="url(#smc-a)"></line>
		<text class="t-i" x="222" y="19">E</text>
		<circle class="smc-free" cx="12" cy="200" r="4"></circle>
		<text x="20" y="204">свободный электрон</text>
		<circle class="smc-hole" cx="168" cy="200" r="6.5"></circle>
		<text class="smc-plus" x="168" y="204" text-anchor="middle">+</text>
		<text x="178" y="204">дырка</text>
		<circle class="smc-be" cx="238" cy="200" r="2.2"></circle>
		<text x="246" y="204">электрон связи</text>
	</svg>
	<figcaption class="g7__caption" data-cap></figcaption>
</figure>

<style is:global>
	.smc-btns {
		margin-bottom: 0.6rem;
	}
	.smc-btns .g7__seg {
		flex-wrap: wrap;
	}
	.smc-bond {
		stroke: var(--g7-faint);
		stroke-width: 6;
	}
	.smc-be {
		fill: color-mix(in oklab, var(--g7-blue) 70%, var(--g7-paper));
	}
	.smc-atom {
		fill: color-mix(in oklab, var(--g7-steel) 40%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.smc-atom.is-as {
		fill: color-mix(in oklab, var(--g7-gold) 45%, var(--g7-paper));
		stroke: var(--g7-gold);
	}
	.smc-atom.is-in {
		fill: color-mix(in oklab, var(--g7-violet) 40%, var(--g7-paper));
		stroke: var(--g7-violet);
	}
	.g7__svg .smc-sym {
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--g7-ink);
	}
	.smc-free {
		fill: var(--g7-blue);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.smc-hole {
		fill: var(--g7-paper);
		stroke: var(--g7-red);
		stroke-width: 1.6;
	}
	.g7__svg .smc-plus {
		font-size: 12px;
		font-weight: 700;
		fill: var(--g7-red);
	}
	.smc-field {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
</style>

<script>
	import { el, loop, segment } from '../g7/kit';

	const X0 = 46;
	const Y0 = 44;
	const DX = 54;
	const DY = 42;
	const CAPS: Record<string, string> = {
		pure: 'Нагревание рвёт отдельные связи: появляются свободный электрон и дырка. Электроны движутся против поля, дырки — по полю: в чистом полупроводнике проводимость электронно-дырочная. Скорости условные.',
		n: 'У атома мышьяка пять внешних электронов: четыре идут на связи, пятый становится свободным. Носители тока — электроны: полупроводник n-типа.',
		p: 'У атома индия три внешних электрона: одной связи не хватает электрона, получается дырка. Её заполняют электроны соседних связей, и дырка движется по полю: полупроводник p-типа.',
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-smc]')) {
		const g = root.querySelector<SVGGElement>('[data-carriers]')!;
		const cap = root.querySelector<HTMLElement>('[data-cap]')!;
		let mode = 'pure';
		type C = { node: SVGGElement; kind: 'e' | 'h'; row: number; x0: number };
		let list: C[] = [];
		const setAtoms = () => {
			for (const a of root.querySelectorAll<SVGGElement>('[data-atom]')) {
				const c = a.querySelector('circle')!;
				const t = a.querySelector('text')!;
				const id = a.dataset.atom;
				const as = mode === 'n' && (id === '1-1' || id === '4-2');
				const inn = mode === 'p' && (id === '1-1' || id === '4-2');
				c.setAttribute('class', `smc-atom${as ? ' is-as' : inn ? ' is-in' : ''}`);
				t.textContent = as ? 'As' : inn ? 'In' : 'Si';
			}
		};
		const electron = (row: number, x0: number): C => {
			const node = el('g', {});
			node.append(el('circle', { class: 'smc-free', r: 4 }));
			g.append(node);
			return { node, kind: 'e', row, x0 };
		};
		const hole = (row: number, x0: number): C => {
			const node = el('g', {});
			node.append(el('circle', { class: 'smc-hole', r: 6.5 }), el('text', { class: 'smc-plus', 'text-anchor': 'middle', y: 4 }, '+'));
			g.append(node);
			return { node, kind: 'h', row, x0 };
		};
		const build = () => {
			g.replaceChildren();
			list = [];
			setAtoms();
			// free electrons glide between the rows of atoms; holes sit on horizontal bonds (upper dot)
			if (mode === 'pure') list.push(electron(0, 150), hole(1, 1), electron(2, 300), hole(2, 3));
			if (mode === 'n') list.push(electron(0, 110), electron(2, 280), electron(1, 40));
			if (mode === 'p') list.push(hole(1, 1), hole(2, 4), hole(0, 2));
			cap.textContent = CAPS[mode];
		};
		let t = 0;
		const draw = () => {
			for (const c of list) {
				if (c.kind === 'e') {
					let x = c.x0 - 22 * t;
					x = ((((x - 20) % 320) + 320) % 320) + 20;
					const y = Y0 + DY * c.row + DY / 2 + 3 * Math.sin(t * 3 + c.x0);
					c.node.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
				} else {
					const k = (c.x0 + Math.floor(t / 0.7)) % 5;
					const x = X0 + DX * k + DX / 2 - 4;
					const y = Y0 + DY * c.row - 3;
					c.node.setAttribute('transform', `translate(${x} ${y})`);
				}
			}
		};
		segment(root.querySelector('[data-modes]')!, (b) => {
			mode = b.dataset.m!;
			t = 0;
			build();
			draw();
		});
		build();
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
