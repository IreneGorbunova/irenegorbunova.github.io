---
/**
 * «Опыт 1911 года»: the resistance of mercury as Kamerlingh Onnes measured it while cooling it with liquid helium:
 * above 4,2 К it falls slowly with temperature, at 4,2 К it drops to zero within a few hundredths of a kelvin. The
 * resistance is given relative to its value at 4,4 К (the shape after his published curve; the drop is drawn as
 * steep as it was measured). Axes: T 4,0…4,4 К (600 px per К), R 0…1,1 of R(4,4 К) (100 px per unit).
 */
import G7Styles from '../g7/G7Styles.astro';

const OX = 56;
const OY = 150;
const PT = 600;
const PR = 100;
const X = (T: number) => (OX + (T - 4.0) * PT).toFixed(1);
const Y = (r: number) => (OY - r * PR).toFixed(1);
const pts: [number, number][] = [
	[4.4, 1.0],
	[4.35, 0.985],
	[4.3, 0.97],
	[4.25, 0.955],
	[4.225, 0.945],
	[4.215, 0.9],
	[4.205, 0.15],
	[4.2, 0.0],
	[4.0, 0.0],
];
const d = pts.map(([T, r], i) => `${i ? 'L' : 'M'}${X(T)} ${Y(r)}`).join(' ');
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow sup not-content">
	<svg class="g7__svg" viewBox="0 0 330 190" role="img" aria-label="График сопротивления ртути при охлаждении: при 4,2 кельвина оно скачком падает до нуля">
		<path class="ln" d={`M${OX} ${OY} H${OX + 0.4 * PT + 8} M${OX} ${OY} V${OY - 1.1 * PR - 8}`}></path>
		{[4.0, 4.1, 4.2, 4.3, 4.4].map((T) => (
			<>
				<line class="sup-grid" x1={X(T)} x2={X(T)} y1={OY} y2={OY - 1.1 * PR} />
				<text class="t-small t-num" x={X(T)} y={OY + 14} text-anchor="middle">{T.toFixed(1).replace('.', ',')}</text>
			</>
		))}
		{[0, 0.5, 1].map((r) => (
			<>
				<line class="sup-grid" x1={OX} x2={OX + 0.4 * PT} y1={Y(r)} y2={Y(r)} />
				<text class="t-small t-num" x={OX - 6} y={+Y(r) + 4} text-anchor="end">{String(r).replace('.', ',')}</text>
			</>
		))}
		<path class="sup-line" d={d}></path>
		<text class="t-small" x={OX + 0.4 * PT + 8} y={OY + 28} text-anchor="end"><tspan class="t-i">T</tspan>, К</text>
		<text class="t-small" x="6" y="22"><tspan class="t-i">R</tspan> / <tspan class="t-i">R</tspan>(4,4&nbsp;К)</text>
		<text class="t-small t-gold" x={+X(4.2) - 6} y={OY - 60} text-anchor="end">ртуть становится</text>
		<text class="t-small t-gold" x={+X(4.2) - 6} y={OY - 46} text-anchor="end">сверхпроводником</text>
	</svg>
	<figcaption class="g7__caption">Как менялось сопротивление ртути при охлаждении в опыте Х. Камерлинг-Оннеса (1911), упрощённо. Сопротивление дано в долях от его значения при 4,4&nbsp;К. При 4,2&nbsp;К оно скачком падает до нуля.</figcaption>
</figure>

<style is:global>
	.sup-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.sup-line {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
</style>
