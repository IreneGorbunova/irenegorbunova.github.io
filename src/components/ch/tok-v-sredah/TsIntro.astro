---
/**
 * Two short looping opening scenes of «Электрический ток в различных средах» (grade 10). No terms of the chapter in the
 * pictures or the visible captions; each caption's popover names the notion and links to its section. People: the
 * shared people kit (src/components/people/). Grade 8 «Электрический ток» opens with a wall switch and a ceiling lamp,
 * grade 8 «Электризация» and grade 10 «Электростатика» with lightning, so this chapter shows a desk lamp and a plasma
 * ball.
 *
 * Desk lamp (an evening room, side view; 2,2 px per см on both axes; the desk top 75 см above the floor at y 165, the
 *   floor below the picture). A teenage girl (people kit, 160 см) sits at the desk over an open exercise book; the dusk
 *   is in the window. A desk lamp with a clear incandescent bulb 6 см across (13 px) hangs its bulb under a small shade.
 *   From 0,3 с her near hand moves from the book to the push button on the lamp's base (0,7 с, eased) and presses it at
 *   1,0 с with the index finger. The bulb flashes brighter and whiter than in normal work for 0,35 с and at 1,4 с the
 *   filament breaks at its thinnest point (a tiny spark there); the room is dark again. The flash is stretched so that it
 *   is seen: a real failure takes a few hundredths of a second. Her hand goes back to the book, she leans back and looks
 *   at the lamp, then leans over the book again, so the loop ends in its first pose (only the bulb is whole again when
 *   it restarts). A magnifier (upper right) shows the bulb 6 times larger: the glass, the two leads and the coiled
 *   filament, which glows during the flash and breaks. The physics is in the popover: a cold tungsten filament has
 *   about one twelfth of its working resistance, so the first current is many times the working one (the worked task
 *   of the chapter computes «в 12 раз»; neither the picture nor the caption says the number).
 * Plasma ball (a science museum hall, side view; 2,6 px per см; the picture shows heights 93–185 см). On a pedestal
 *   100 см high stands a plasma ball: a black base 12 см high and a glass sphere 20 см across (radius 26 px) with an
 *   electrode ball 3 см across in its center. Nine thin violet-pink filaments with bluish roots run from the electrode
 *   to the glass; their ends wander and they flicker all the time. A teenage boy (people kit, 170 см) stands at the
 *   ball; his younger sister (125 см, only her head and shoulders are in the picture) watches from the other side.
 *   From 1,4 с he raises his near hand (0,6 с, eased) and at 2,0 с touches the glass with the tip of his index finger:
 *   within 0,2 с six filaments gather into one bright thick channel from the electrode to the fingertip (three weak
 *   ones stay) and a small bright spot lights on the glass under the finger. He holds it for 3 с, takes the hand away
 *   (5,0–5,7 с), and the filaments spread again. Real time.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = `ts${Math.random().toString(36).slice(2, 8)}`;
const f1 = (v: number) => v.toFixed(1);

// ---- the desk lamp (2,2 px per см)
const S1 = 2.2;
const TT = 165; // the desk top (75 см)
const BX = 166; // the bulb's center
const BY = 101;
const BR = 3 * S1; // 6,6 px
// the magnifier: the bulb 6 times larger
const MX = 306;
const MY = 60;
const MR = 46;
const MK = 6;
const fil = (() => {
	// the coiled filament in the scene's units around the bulb's center
	let d = 'M-2.6 0.6';
	for (let k = 0; k < 10; k++) d += ` L${(-2.35 + k * 0.52).toFixed(2)} ${k % 2 ? 0.95 : 0.25}`;
	return d + ' L2.6 0.6';
})();

// ---- the plasma ball (2,6 px per см)
const S2 = 2.6;
const Y2 = (h: number) => (185 - h) * S2; // the picture y of a height h (см)
const PX = 200; // the ball's axis
const PED = Y2(100); // the pedestal top, 221
const BASE_TOP = PED - 12 * S2; // 189,8
const PR = 10 * S2; // the sphere's radius, 26
const PCY = BASE_TOP - 0.8 * PR; // the sphere's center, 169
---

<PeopleStyles />
<IntroFrame data-tsintro>
	<div class="intro__card" data-scene="lamp">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер. Девочка за письменным столом нажимает кнопку настольной лампы. Лампочка ярко вспыхивает и тут же гаснет: в лупе видно, что её нить порвалась. Девочка откидывается на спинку стула и смотрит на лампу">
			<defs>
				<radialGradient id={`${uid}-glow`}>
					<stop offset="0" class="ts-glow-a"></stop>
					<stop offset="1" class="ts-glow-b"></stop>
				</radialGradient>
				<clipPath id={`${uid}-lens`}><circle cx={MX} cy={MY} r={MR}></circle></clipPath>
			</defs>
			<rect class="ts-wall" x="0" y="0" width="360" height="240"></rect>
			<!-- the window: dusk, the houses across the street -->
			<rect class="ts-dusk" x="196" y="16" width="56" height="92" rx="2"></rect>
			<path class="ts-houses" d="M196 108 V82 H210 V74 H226 V88 H240 V70 H252 V108 Z"></path>
			<rect class="ts-lit" x="214" y="78" width="4" height="5"></rect>
			<rect class="ts-lit" x="243" y="76" width="4" height="5"></rect>
			<path class="ts-frame" d="M196 16 H252 V108 H196 Z M224 16 V108 M196 60 H252"></path>
			<rect class="ts-sill" x="192" y="107" width="64" height="4" rx="1"></rect>
			<!-- a shelf with books and a poster on the wall -->
			<rect class="ts-poster" x="12" y="22" width="36" height="46" rx="1"></rect>
			<path class="ts-poster-art" d="M18 56 L26 40 L32 50 L36 44 L44 56 Z"></path>
			<circle class="ts-poster-sun" cx="38" cy="32" r="4"></circle>
			<rect class="ts-shelf" x="120" y="34" width="62" height="3"></rect>
			<rect class="ts-book ts-book--a" x="124" y="18" width="7" height="16"></rect>
			<rect class="ts-book ts-book--b" x="132" y="15" width="6" height="19"></rect>
			<rect class="ts-book ts-book--c" x="139" y="20" width="8" height="14"></rect>
			<rect class="ts-book ts-book--a" x="148" y="17" width="5" height="17"></rect>
			<!-- the chair: the back behind the girl, the seat under her -->
			<rect class="ts-chair" x="24" y="132" width="7" height="108" rx="2"></rect>
			<rect class="ts-chair" x="24" y="228" width="76" height="6" rx="2"></rect>
			<g data-girl></g>
			<!-- the desk: the top in slight perspective, the near leg in front of the girl's legs -->
			<path class="ts-desk-top" d={`M104 ${TT} L112 ${TT - 7} H360 V${TT} Z`}></path>
			<rect class="ts-desk-edge" x="102" y={TT} width="258" height="6"></rect>
			<rect class="ts-desk-apron" x="108" y={TT + 6} width="252" height="7"></rect>
			<rect class="ts-desk-leg" x="108" y={TT + 13} width="7" height={240 - TT - 13}></rect>
			<rect class="ts-drawers" x="296" y={TT + 13} width="64" height={240 - TT - 13}></rect>
			<path class="ts-desk-line" d={`M296 ${TT + 44} H360 M296 ${TT + 74} H360 M322 ${TT + 26} H334 M322 ${TT + 57} H334`}></path>
			<!-- the open exercise book -->
			<path class="ts-nb" d={`M120 ${TT - 0.5} L124 ${TT - 5.5} L172 ${TT - 5.5} L170 ${TT - 0.5} Z`}></path>
			<path class="ts-nb-line" d={`M146 ${TT - 0.5} L148 ${TT - 5.5} M127 ${TT - 3} H143 M151 ${TT - 3} H167`}></path>
			<!-- a pencil cup and a globe -->
			<rect class="ts-cup" x="262" y={TT - 18} width="11" height="15" rx="1.5"></rect>
			<path class="ts-pencils" d={`M265 ${TT - 18} L263 ${TT - 30} M268 ${TT - 18} L269 ${TT - 32} M271 ${TT - 18} L275 ${TT - 28}`}></path>
			<path class="ts-globe-stand" d={`M318 ${TT - 3} H340 M329 ${TT - 3} V${TT - 12} M314 ${TT - 34} A17 17 0 0 0 340 ${TT - 14}`}></path>
			<circle class="ts-globe" cx="329" cy={TT - 30} r="14"></circle>
			<path class="ts-globe-land" d={`M320 ${TT - 38} Q326 ${TT - 42} 330 ${TT - 36} Q334 ${TT - 30} 328 ${TT - 26} Q322 ${TT - 28} 320 ${TT - 38} Z M334 ${TT - 22} Q339 ${TT - 24} 340 ${TT - 30} Q337 ${TT - 26} 334 ${TT - 22} Z`}></path>
			<!-- the lamp: a round base with the push button, a two-part arm with hinges, a cone shade over the bulb -->
			<path class="ts-lamp-light" data-cone d={`M${BX - 14} ${BY - 2} L${BX - 52} ${TT - 1} L${BX + 40} ${TT - 1} L${BX + 16} ${BY - 5} Z`}></path>
			<path class="ts-lamp-arm" d={`M192 ${TT - 6} L206 112 L${BX + 12} 80`}></path>
			<circle class="ts-hinge" cx="206" cy="112" r="2.6"></circle>
			<path class="ts-lamp-base" d={`M176 ${TT} Q177 ${TT - 7} 192 ${TT - 7} Q207 ${TT - 7} 208 ${TT} Z`}></path>
			<rect class="ts-button" data-button x="194.5" y={TT - 9.5} width="5" height="3" rx="0.8"></rect>
			<path class="ts-cord" d={`M208 ${TT - 2} Q218 ${TT - 1} 224 ${TT + 2}`}></path>
			<path class="ts-shade" d={`M${BX + 9} 74 L${BX + 19} ${BY - 6} L${BX - 13} ${BY - 1} L${BX - 9} 78 Z`}></path>
			<circle class="ts-hinge" cx={BX + 12} cy="80" r="2.4"></circle>
			<circle class="ts-halo" data-halo cx={BX} cy={BY} r="30" fill={`url(#${uid}-glow)`}></circle>
			<circle class="ts-bulb" data-bulb cx={BX} cy={BY} r={BR}></circle>
			<path class="ts-fil" data-fil d={`M${BX - 2.2} ${BY} h4.4`}></path>
			<path class="ts-spark" data-spark d=""></path>
			<!-- dusk over the room (the window is left out) -->
			<path class="ts-dark" data-dark fill-rule="evenodd" d="M0 0 H360 V240 H0 Z M196 16 H252 V108 H196 Z"></path>
			<!-- the magnifier: a ring round the bulb, a line, and the bulb 6 times larger -->
			<circle class="ts-ring" cx={BX} cy={BY} r="11"></circle>
			<line class="ts-ring" x1={BX + 9.5} y1={BY - 5.5} x2={f1(MX - MR * 0.87)} y2={f1(MY + MR * 0.5)}></line>
			<g clip-path={`url(#${uid}-lens)`}>
				<rect class="ts-lens-bg" x={MX - MR} y={MY - MR} width={2 * MR} height={2 * MR}></rect>
				<g transform={`translate(${MX} ${MY}) scale(${MK})`}>
					<circle class="ts-mglow" data-mglow r="6"></circle>
					<path class="ts-mglass" d={`M-1.6 -${f1(BR - 0.2)} L-1.6 -9 M1.6 -${f1(BR - 0.2)} L1.6 -9`}></path>
					<circle class="ts-mglass" r={BR}></circle>
					<path class="ts-mlead" d="M-0.9 -8 L-0.9 -2.4 L-2.6 0.6 M0.9 -8 L0.9 -2.4 L2.6 0.6"></path>
					<path class="ts-mstem" d="M-0.9 -5 Q0 -3.6 0.9 -5"></path>
					<path class="ts-mfil" data-mfil d={fil}></path>
					<path class="ts-mfil" data-mfil2 d=""></path>
					<path class="ts-mspark" data-mspark d=""></path>
				</g>
			</g>
			<circle class="ts-lens" cx={MX} cy={MY} r={MR}></circle>
		</svg>
		<div class="intro__foot">
			<p>
				Лампа накаливания чаще всего{' '}
				<More term="перегорает в момент включения">
					Сопротивление холодной вольфрамовой нити во много раз меньше, чем раскалённой, поэтому в первый миг ток в ней во много раз больше рабочего, и самое тонкое место нити перегревается. Об этом — раздел{' '}
					<a href="#электрический-ток-в-металлах">«Электрический ток в металлах»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="plasma">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зал музея. На подставке стоит стеклянный шар, внутри от центра к стеклу тянутся тонкие светящиеся нити. Мальчик касается шара пальцем, и нити собираются в один яркий канал к его пальцу; он убирает руку, и нити снова расходятся. Младшая сестра смотрит">
			<defs>
				<radialGradient id={`${uid}-gas`}>
					<stop offset="0" class="ts-gas-a"></stop>
					<stop offset="1" class="ts-gas-b"></stop>
				</radialGradient>
			</defs>
			<rect class="ts-hall" x="0" y="0" width="360" height="240"></rect>
			<!-- the ceiling lights and their cones -->
			<path class="ts-beam" d="M70 0 L40 120 L100 120 Z M290 0 L262 112 L318 112 Z"></path>
			<rect class="ts-lampc" x="62" y="0" width="16" height="5" rx="1"></rect>
			<rect class="ts-lampc" x="282" y="0" width="16" height="5" rx="1"></rect>
			<!-- a framed picture, an exhibit label and a display case with exhibits -->
			<rect class="ts-pic" x="20" y="28" width="44" height="34" rx="1"></rect>
			<path class="ts-pic-art" d="M25 56 Q34 38 42 48 Q50 34 59 56 Z"></path>
			<rect class="ts-case" x="236" y="40" width="112" height="140" rx="2"></rect>
			<path class="ts-case-line" d="M236 86 H348 M236 132 H348"></path>
			<circle class="ts-exh" cx="258" cy="74" r="10"></circle>
			<path class="ts-exh" d="M276 86 V70 H286 V86 Z M300 86 L306 62 L312 86 Z M326 86 Q326 70 336 70 Q342 76 340 86 Z"></path>
			<path class="ts-exh" d="M246 132 H272 V122 H246 Z M282 132 Q290 110 298 132 Z M312 132 V112 L330 112 V132 Z"></path>
			<path class="ts-case-shine" d="M244 46 L254 46 L240 74 Z"></path>
			<rect class="ts-label" x="140" y="34" width="44" height="14" rx="2"></rect>
			<path class="ts-label-line" d="M146 39 H178 M146 43 H170"></path>
			<g data-sister></g>
			<g data-boy></g>
			<!-- the pedestal and the black base -->
			<rect class="ts-ped" x={PX - 30} y={PED} width="60" height={240 - PED}></rect>
			<rect class="ts-ped-top" x={PX - 33} y={PED - 3} width="66" height="4" rx="1"></rect>
			<path class="ts-base" d={`M${PX - 22} ${PED - 3} L${PX - 14} ${f1(BASE_TOP)} H${PX + 14} L${PX + 22} ${PED - 3} Z`}></path>
			<path class="ts-base-rim" d={`M${PX - 15.5} ${f1(BASE_TOP + 2)} H${PX + 15.5}`}></path>
			<!-- the sphere: gas glow, filaments, the electrode, the glass -->
			<circle cx={PX} cy={f1(PCY)} r={PR} fill={`url(#${uid}-gas)`}></circle>
			<g data-fils></g>
			<circle class="ts-spot" data-spot r="3.2" cx="0" cy="0"></circle>
			<circle class="ts-electrode" cx={PX} cy={f1(PCY)} r={f1(1.5 * S2)}></circle>
			<circle class="ts-sphere" cx={PX} cy={f1(PCY)} r={PR}></circle>
			<path class="ts-sphere-shine" d={`M${f1(PX - 14)} ${f1(PCY - 17)} A${PR - 4} ${PR - 4} 0 0 1 ${f1(PX + 6)} ${f1(PCY - 21)}`}></path>
			<g data-boy-near></g>
		</svg>
		<div class="intro__foot">
			<p>
				Коснитесь пальцем стеклянного шара — и светящиеся нити внутри него{' '}
				<More term="собираются к пальцу">
					Внутри шара — разреженная смесь неона и других газов, в центре — электрод, напряжение на котором в несколько тысяч вольт меняется десятки тысяч раз в секунду. Газ проводит ток по тонким светящимся каналам. Через стекло, руку и тело заряды уходят к земле легче всего, поэтому каналы собираются к пальцу; ток через человека ничтожно мал. Об этом — раздел{' '}
					<a href="#электрический-ток-в-газах">«Электрический ток в газах»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-tsintro] {
		--ts-wall: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-6));
		--ts-wood: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
		--ts-dusk: hsl(225, 40%, 30%);
		--ts-night: hsl(230, 45%, 8%);
		--ts-hall: hsl(225, 25%, 14%);
		--ts-plasma: hsl(310, 90%, 72%);
		--ts-root: hsl(225, 95%, 72%);
	}
	:root[data-theme='light'] [data-tsintro] {
		--ts-dusk: hsl(225, 45%, 45%);
		--ts-hall: hsl(225, 22%, 26%);
	}
	[data-tsintro] .intro__svg {
		overflow: hidden;
	}
	[data-tsintro] .ts-wall {
		fill: var(--ts-wall);
	}
	[data-tsintro] .ts-dusk {
		fill: var(--ts-dusk);
	}
	[data-tsintro] .ts-houses {
		fill: color-mix(in oklab, var(--ts-dusk) 50%, black);
	}
	[data-tsintro] .ts-lit {
		fill: hsl(45, 90%, 70%);
		opacity: 0.85;
	}
	[data-tsintro] .ts-frame {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
	}
	[data-tsintro] .ts-sill,
	[data-tsintro] .ts-shelf {
		fill: var(--sl-color-gray-3);
	}
	[data-tsintro] .ts-poster {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	[data-tsintro] .ts-poster-art {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-gray-3));
	}
	[data-tsintro] .ts-poster-sun {
		fill: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-4));
	}
	[data-tsintro] .ts-book {
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-tsintro] .ts-book--a {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
	}
	[data-tsintro] .ts-book--b {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-4));
	}
	[data-tsintro] .ts-book--c {
		fill: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-4));
	}
	[data-tsintro] .ts-chair {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-desk-top {
		fill: color-mix(in oklab, var(--ig-v) 38%, var(--sl-color-gray-4));
	}
	[data-tsintro] .ts-desk-edge,
	[data-tsintro] .ts-desk-leg {
		fill: var(--ts-wood);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-desk-apron,
	[data-tsintro] .ts-drawers {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-desk-line {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
		stroke-linecap: round;
	}
	[data-tsintro] .ts-nb {
		fill: hsl(0, 0%, 96%);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.5;
	}
	[data-tsintro] .ts-nb-line {
		stroke: hsl(210, 30%, 60%);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-cup {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--sl-color-gray-4));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-pencils {
		stroke: var(--ig-v);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	[data-tsintro] .ts-globe {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-5));
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-globe-land {
		fill: hsl(120, 30%, 45%);
	}
	[data-tsintro] .ts-globe-stand {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	[data-tsintro] .ts-lamp-light {
		fill: hsl(48, 100%, 80%);
		opacity: 0;
	}
	[data-tsintro] .ts-lamp-arm {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	[data-tsintro] .ts-lamp-base,
	[data-tsintro] .ts-shade {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-3));
		stroke: var(--hm-line);
		stroke-width: 0.7;
	}
	[data-tsintro] .ts-button {
		fill: var(--sl-color-gray-1);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-tsintro] .ts-cord {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-tsintro] .ts-hinge {
		fill: var(--sl-color-gray-3);
		stroke: var(--hm-line);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-socket {
		fill: var(--sl-color-gray-3);
		stroke: var(--hm-line);
		stroke-width: 0.5;
	}
	[data-tsintro] .ts-glow-a {
		stop-color: hsl(50, 100%, 92%);
		stop-opacity: 0.95;
	}
	[data-tsintro] .ts-glow-b {
		stop-color: hsl(45, 100%, 70%);
		stop-opacity: 0;
	}
	[data-tsintro] .ts-halo {
		opacity: 0;
	}
	[data-tsintro] .ts-bulb {
		fill: color-mix(in oklab, var(--sl-color-white) 18%, transparent);
		stroke: color-mix(in oklab, var(--sl-color-white) 70%, var(--sl-color-gray-3));
		stroke-width: 0.8;
	}
	[data-tsintro] .ts-fil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-tsintro] .ts-spark,
	[data-tsintro] .ts-mspark {
		fill: none;
		stroke: hsl(50, 100%, 85%);
		stroke-linecap: round;
	}
	[data-tsintro] .ts-spark {
		stroke-width: 1;
	}
	[data-tsintro] .ts-mspark {
		stroke-width: 0.25;
	}
	[data-tsintro] .ts-dark {
		fill: var(--ts-night);
	}
	[data-tsintro] .ts-ring {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-tsintro] .ts-lens {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	[data-tsintro] .ts-lens-bg {
		fill: color-mix(in oklab, var(--ts-night) 70%, var(--ts-wall));
	}
	[data-tsintro] .ts-mglow {
		fill: hsl(50, 100%, 85%);
		opacity: 0;
	}
	[data-tsintro] .ts-mglass {
		fill: color-mix(in oklab, var(--sl-color-white) 6%, transparent);
		stroke: color-mix(in oklab, var(--sl-color-white) 70%, var(--sl-color-gray-3));
		stroke-width: 0.2;
	}
	[data-tsintro] .ts-mlead {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.2;
	}
	[data-tsintro] .ts-mstem {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-white) 60%, transparent);
		stroke-width: 0.25;
	}
	[data-tsintro] .ts-mfil {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.2;
		stroke-linejoin: round;
	}
	/* the museum hall */
	[data-tsintro] .ts-hall {
		fill: var(--ts-hall);
	}
	[data-tsintro] .ts-beam {
		fill: hsl(45, 80%, 85%);
		opacity: 0.06;
	}
	[data-tsintro] .ts-lampc {
		fill: var(--sl-color-gray-3);
	}
	[data-tsintro] .ts-pic {
		fill: color-mix(in oklab, var(--ig-v) 20%, var(--ts-hall));
		stroke: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-3));
		stroke-width: 2;
	}
	[data-tsintro] .ts-pic-art {
		fill: color-mix(in oklab, var(--ig-vx) 40%, var(--ts-hall));
	}
	[data-tsintro] .ts-case {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--ts-hall));
		stroke: hsl(220, 15%, 55%);
		stroke-width: 1.4;
	}
	[data-tsintro] .ts-case-line {
		stroke: hsl(220, 15%, 50%);
		stroke-width: 1.4;
	}
	[data-tsintro] .ts-case-shine {
		fill: hsl(0, 0%, 100%);
		opacity: 0.08;
	}
	[data-tsintro] .ts-exh {
		fill: hsl(35, 30%, 45%);
		stroke: hsl(35, 20%, 30%);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-label {
		fill: hsl(40, 25%, 80%);
		opacity: 0.8;
	}
	[data-tsintro] .ts-label-line {
		stroke: hsl(220, 10%, 35%);
		stroke-width: 1;
	}
	[data-tsintro] .ts-ped {
		fill: hsl(220, 8%, 82%);
		stroke: hsl(220, 8%, 55%);
		stroke-width: 0.8;
	}
	[data-tsintro] .ts-ped-top {
		fill: hsl(220, 8%, 90%);
		stroke: hsl(220, 8%, 55%);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-base {
		fill: hsl(220, 10%, 9%);
		stroke: hsl(220, 10%, 30%);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-base-rim {
		stroke: hsl(220, 10%, 35%);
		stroke-width: 1;
	}
	[data-tsintro] .ts-gas-a {
		stop-color: hsl(300, 60%, 35%);
		stop-opacity: 0.85;
	}
	[data-tsintro] .ts-gas-b {
		stop-color: hsl(260, 50%, 12%);
		stop-opacity: 0.95;
	}
	[data-tsintro] .ts-fil-p {
		fill: none;
		stroke: var(--ts-plasma);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-tsintro] .ts-fil-r {
		fill: none;
		stroke: var(--ts-root);
		stroke-linecap: round;
	}
	[data-tsintro] .ts-spot {
		fill: hsl(320, 100%, 90%);
		opacity: 0;
	}
	[data-tsintro] .ts-electrode {
		fill: hsl(230, 30%, 70%);
		stroke: hsl(230, 60%, 85%);
		stroke-width: 0.6;
	}
	[data-tsintro] .ts-sphere {
		fill: none;
		stroke: hsl(220, 30%, 85%);
		stroke-width: 1.2;
		stroke-opacity: 0.8;
	}
	[data-tsintro] .ts-sphere-shine {
		fill: none;
		stroke: hsl(0, 0%, 100%);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0.35;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { figure, ease, lerp, lerpPt, ROLL, SKELETON, ANKLE_CM, handShape, blendShape, handPoint, contactLocal, type Pt, type HandTarget, type HandPose, type HandShape, type Side } from '@components/people';

	const f = (v: number) => v.toFixed(1);
	const smooth = (a: number, b: number, t: number) => ease((t - a) / (b - a));
	/** The shift of the contact point when a hand's pose changes (as in TermoIntro): reaches start from shifted targets. */
	const delta = (side: Side, Lh: number, dir: number, roll: number, sh: HandShape, from: HandPose, to: HandPose, dLh: number): Pt => {
		const fr = { wrist: { x: 0, y: 0 }, dir, roll };
		const a = handPoint(side, fr, Lh, contactLocal(to, sh, dLh));
		const b = handPoint(side, fr, Lh, contactLocal(from, sh, dLh));
		return { x: a.x - b.x, y: a.y - b.y };
	};
	const plus = (a: Pt, b: Pt): Pt => ({ x: a.x + b.x, y: a.y + b.y });
	const star = (x: number, y: number, r: number) =>
		[0, 1, 2, 3]
			.map((k) => {
				const a = (k * Math.PI) / 4;
				return `M${(x - r * Math.cos(a)).toFixed(2)} ${(y - r * Math.sin(a)).toFixed(2)} L${(x + r * Math.cos(a)).toFixed(2)} ${(y + r * Math.sin(a)).toFixed(2)}`;
			})
			.join(' ');

	for (const root of document.querySelectorAll<HTMLElement>('[data-tsintro]')) {
		// ---------------- the desk lamp ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="lamp"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 2.2;
			const TT = 165;
			const FLOOR = TT + 75 * S;
			const BX = 166;
			const BY = 101;
			const H = 160;
			const sk = SKELETON.teen;
			const u = S * H;
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H, age: 'teen', clothes: 'indoor', shirt: 'hm-green', hair: 'pony', name: 'girl' });
			const HIP: Pt = { x: 64, y: FLOOR - 47 * S };
			const ankleY = FLOOR - ANKLE_CM.trainer * S;
			const Lh = sk.hand * u;
			const flatSh = handShape('flat');
			const pointSh = handShape('point');
			const BOOK: Pt = { x: 150, y: TT - 5.5 };
			const FAR: Pt = { x: 128, y: TT - 3 };
			const BTN: Pt = { x: 197, y: TT - 9.5 };
			const DIR_REST = 0.08;
			const DIR_PRESS = 1.05;
			const ROLL_PRESS = -0.35;
			const fromPoint = plus(BOOK, delta('R', Lh, DIR_REST, ROLL.palmCw, flatSh, 'flat', 'point', 0.17));
			const restNear: HandTarget = { at: BOOK, pose: 'flat', dir: DIR_REST, roll: ROLL.palmCw, contact: 'book' };
			const restFar: HandTarget = { at: FAR, pose: 'flat', dir: 0.05, roll: ROLL.palmCw, contact: 'desk' };
			const button = $<SVGRectElement>('[data-button]');
			const halo = $<SVGCircleElement>('[data-halo]');
			const cone = $<SVGPathElement>('[data-cone]');
			const bulb = $<SVGCircleElement>('[data-bulb]');
			const filS = $<SVGPathElement>('[data-fil]');
			const spark = $<SVGPathElement>('[data-spark]');
			const dark = $<SVGPathElement>('[data-dark]');
			const mglow = $<SVGCircleElement>('[data-mglow]');
			const mfil = $<SVGPathElement>('[data-mfil]');
			const mfil2 = $<SVGPathElement>('[data-mfil2]');
			const mspark = $<SVGPathElement>('[data-mspark]');
			const filWhole = mfil.getAttribute('d')!;
			// the filament after the break: the coil splits between its 7th and 8th turns, both ends sag a little
			const pts = Array.from({ length: 10 }, (_, k) => ({ x: -2.35 + k * 0.52, y: k % 2 ? 0.95 : 0.25 }));
			const left = (s: number) => 'M-2.6 0.6 ' + pts.slice(0, 7).map((p, k) => `L${p.x.toFixed(2)} ${(p.y + s * 0.09 * k).toFixed(2)}`).join(' ');
			const right = (s: number) => `M${pts[7].x.toFixed(2)} ${(pts[7].y + s * 0.5).toFixed(2)} ` + pts.slice(8).map((p, k) => `L${p.x.toFixed(2)} ${(p.y + s * 0.5 * (1 - (k + 1) / 3)).toFixed(2)}`).join(' ') + ' L2.6 0.6';
			const RUN = 5.2;
			const T_PRESS = 1.0;
			const T_BREAK = 1.4;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the near hand: book → button (0,3–1,0 s), presses, button → book (1,6–2,3 s)
				const go = smooth(0.3, T_PRESS, t);
				const back = smooth(1.6, 2.3, t);
				const press = t >= T_PRESS && t < 1.6 ? Math.min(1, (t - T_PRESS) / 0.12) * (1 - smooth(1.35, 1.55, t)) : 0;
				const tip: Pt = { x: BTN.x, y: BTN.y + 1.2 * press };
				let near: HandTarget = restNear;
				if (t >= 0.3 && t < 2.3) {
					const k = go * (1 - back);
					const at = back > 0 ? lerpPt(tip, fromPoint, back) : lerpPt(fromPoint, tip, go);
					near = { at, pose: 'point', shape: blendShape(flatSh, pointSh, k), dir: lerp(DIR_REST, DIR_PRESS, k), roll: lerp(ROLL.palmCw, ROLL_PRESS, k), contact: go >= 1 && back <= 0 ? 'button' : undefined };
				}
				button.setAttribute('y', f(TT - 9.5 + 1.2 * press));
				// she leans back and looks at the lamp (2,0–2,8 s), then bends over the book again (4,2–5,0 s)
				const up = smooth(2.0, 2.8, t) * (1 - smooth(4.2, 5.0, t));
				girl.pose({
					hip: HIP,
					lean: lerp(0.12, -0.04, up),
					head: lerp(0.42, 0.12, up),
					ankles: [
						{ x: HIP.x + 84, y: ankleY },
						{ x: HIP.x + 74, y: ankleY },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [near, restFar],
				});
				// the light: dusk, a flash brighter and whiter than normal (1,05–1,4 s), the break, dusk again
				const on = t >= T_PRESS + 0.05 && t < T_BREAK ? Math.min(1, (t - T_PRESS - 0.05) / 0.06) : 0;
				const broken = t >= T_BREAK;
				halo.style.opacity = f(on);
				halo.setAttribute('r', f(30 + 6 * on));
				cone.style.opacity = f(0.28 * on);
				dark.style.opacity = f(0.42 * (1 - 0.85 * on));
				bulb.style.fill = on ? 'hsl(52, 100%, 94%)' : '';
				filS.style.stroke = on ? 'hsl(55, 100%, 97%)' : '';
				filS.setAttribute('d', broken ? `M${BX - 2.2} ${BY} h2.6 M${BX + 1.2} ${BY + 0.7} h1` : `M${BX - 2.2} ${BY} h4.4`);
				const sp = broken && t < T_BREAK + 0.22 ? 1 - (t - T_BREAK) / 0.22 : 0;
				spark.setAttribute('d', sp > 0 ? star(BX + 0.8, BY + 0.2, 1 + 3 * sp) : '');
				mglow.style.opacity = f(0.55 * on);
				mfil.style.stroke = on ? 'hsl(55, 100%, 96%)' : '';
				mfil.style.strokeWidth = on ? '0.3' : '';
				const sag = broken ? smooth(T_BREAK, T_BREAK + 0.3, t) : 0;
				mfil.setAttribute('d', broken ? left(sag) : filWhole);
				mfil2.setAttribute('d', broken ? right(sag) : '');
				mspark.setAttribute('d', sp > 0 ? star((pts[6].x + pts[7].x) / 2, 0.6, 0.4 + 1.1 * sp) : '');
			});
		}

		// ---------------- the plasma ball ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="plasma"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 2.6;
			const Y = (h: number) => (185 - h) * S;
			const PX = 200;
			const PED = Y(100);
			const BASE_TOP = PED - 12 * S;
			const PR = 10 * S;
			const PCY = BASE_TOP - 0.8 * PR;
			const RE = 1.5 * S;
			const FLOOR = Y(0);
			// the boy
			const Hb = 170;
			const bg = $<SVGGElement>('[data-boy]');
			const boy = figure(bg, { s: S, H: Hb, age: 'teen', clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'boy' });
			// the near arm is drawn in front of the ball: its sleeve, outline and hand go to their own layer
			const nearParts = [...bg.querySelectorAll(':scope > g > path.hm-outline, :scope > g > path.hm-limb, :scope > g > g.pk-hand')].slice(-3);
			const nearLayer = $<SVGGElement>('[data-boy-near]');
			for (const p of nearParts) nearLayer.append(p);
			const skb = SKELETON.teen;
			const ub = S * Hb;
			const legB = (skb.thigh + skb.shin) * ub;
			const ankleB = FLOOR - ANKLE_CM.trainer * S;
			const HIPB: Pt = { x: 70, y: ankleB - legB * 0.995 };
			const LEANB = 0.05;
			const [shB] = boy.shoulders(HIPB, LEANB);
			const LhB = skb.hand * ub;
			const armB = (skb.upper + skb.fore) * ub;
			// the hanging hands (by the thighs) and the touch point on the glass, up and to the left of the center
			const relaxedSh = handShape('relaxed');
			const pointSh = handShape('point');
			const restN: Pt = { x: shB.x + 0.06 * armB, y: shB.y + 0.97 * armB + 0.42 * LhB };
			const restF: Pt = { x: shB.x - 0.02 * armB, y: shB.y + 0.97 * armB + 0.42 * LhB };
			const PHI_F = (-152 * Math.PI) / 180; // the direction from the center to the fingertip
			const TOUCH: Pt = { x: PX + PR * Math.cos(PHI_F), y: PCY + PR * Math.sin(PHI_F) };
			const DIR_T = PHI_F + Math.PI; // the finger points at the center
			const ROLL_T = -0.4;
			const fromN = plus(restN, delta('R', LhB, Math.PI / 2, ROLL.palmCw, relaxedSh, 'relaxed', 'point', 0.17));
			// the sister (125 см), facing left, only her head and shoulders in the picture
			const Hs = 125;
			const sister = figure($<SVGGElement>('[data-sister]'), { s: S, H: Hs, age: 'child', clothes: 'indoor', shirt: 'hm-gold', hair: 'pony', dir: -1, name: 'sister' });
			const sks = SKELETON.child;
			const us = S * Hs;
			const HIPS: Pt = { x: 292, y: FLOOR - ANKLE_CM.trainer * S - (sks.thigh + sks.shin) * us * 0.995 };
			const [shS] = sister.shoulders(HIPS, 0.02);
			const armS = (sks.upper + sks.fore) * us;
			const LhS = sks.hand * us;
			// the filaments
			const fg = $<SVGGElement>('[data-fils]');
			const spot = $<SVGCircleElement>('[data-spot]');
			const N = 9;
			const fils = Array.from({ length: N }, (_, i) => {
				const p = el('path', { class: 'ts-fil-p' });
				const r = el('path', { class: 'ts-fil-r' });
				fg.append(p, r);
				return { p, r, base: (i / N) * 2 * Math.PI + 0.3 * Math.sin(i * 2.3), w1: 0.35 + 0.11 * (i % 4), w2: 0.9 + 0.17 * (i % 3), ph: i * 1.7, gathers: i % 3 !== 1 };
			});
			const channel = el('path', { class: 'ts-fil-p' });
			const channelR = el('path', { class: 'ts-fil-r' });
			fg.append(channel, channelR);
			const path = (phi: number, t: number, seed: number, amp: number) => {
				// from the electrode to the glass, with a wiggle that dies at both ends
				const n = 10;
				let d = '';
				let root = '';
				for (let k = 0; k <= n; k++) {
					const s = k / n;
					const r = RE + (PR - RE - 0.6) * s;
					const off = amp * Math.sin(9 * s + 7 * t + seed) * Math.sin(Math.PI * s) * (0.6 + 0.4 * Math.sin(3.1 * t + seed * 2));
					const a = phi + off / Math.max(r, 4);
					const q = `${k ? 'L' : 'M'}${f(PX + r * Math.cos(a))} ${f(PCY + r * Math.sin(a))} `;
					d += q;
					if (k <= 3) root += q;
				}
				return { d, root };
			};
			const RUN = 6.5;
			const T_TOUCH = 2.0;
			const T_OFF = 5.0;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the boy's near hand: hanging → glass (1,4–2,0 s), holds, glass → hanging (5,0–5,7 s)
				const go = smooth(1.4, T_TOUCH, t);
				const back = smooth(T_OFF, T_OFF + 0.7, t);
				let near: HandTarget = { at: restN, pose: 'relaxed', dir: Math.PI / 2, roll: ROLL.palmCw };
				if (t >= 1.4 && t < T_OFF + 0.7) {
					const k = go * (1 - back);
					const at = back > 0 ? lerpPt(TOUCH, fromN, back) : lerpPt(fromN, TOUCH, go);
					// the hand swings forward on its way (an arc, not a straight line through the shoulder's reach limit)
					at.x += 22 * Math.sin(Math.PI * (back > 0 ? back : go));
					near = { at, pose: 'point', shape: blendShape(relaxedSh, pointSh, k), dir: lerp(Math.PI / 2, DIR_T, k), roll: lerp(ROLL.palmCw, ROLL_T, k), contact: go >= 1 && back <= 0 ? 'glass' : undefined };
				}
				boy.pose({
					hip: HIPB,
					lean: LEANB,
					head: lerp(0.2, 0.32, go * (1 - back)),
					ankles: [
						{ x: HIPB.x + 8, y: ankleB },
						{ x: HIPB.x - 6, y: ankleB },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [near, { at: restF, pose: 'relaxed', dir: Math.PI / 2 + 0.05, roll: ROLL.palmCw }],
				});
				sister.pose({
					hip: HIPS,
					lean: 0.02,
					head: 0.18,
					ankles: [
						{ x: HIPS.x - 4, y: FLOOR - ANKLE_CM.trainer * S },
						{ x: HIPS.x + 8, y: FLOOR - ANKLE_CM.trainer * S },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: shS.x - 0.05 * armS, y: shS.y + 0.97 * armS + 0.42 * LhS }, pose: 'relaxed', dir: Math.PI / 2, roll: ROLL.palmCw },
						{ at: { x: shS.x + 0.02 * armS, y: shS.y + 0.97 * armS + 0.42 * LhS }, pose: 'relaxed', dir: Math.PI / 2, roll: ROLL.palmCw },
					],
				});
				// the filaments: wander and flicker; while the finger touches the glass most of them gather to it
				const g = t >= T_TOUCH && t < T_OFF ? Math.min(1, (t - T_TOUCH) / 0.2) : t >= T_OFF ? Math.max(0, 1 - (t - T_OFF) / 0.35) : 0;
				const tt = t + 3;
				for (const [i, fl] of fils.entries()) {
					let phi = fl.base + 0.55 * Math.sin(fl.w1 * tt + fl.ph) + 0.3 * Math.sin(fl.w2 * tt + 2 * fl.ph);
					if (fl.gathers) {
						const target = PHI_F + 0.05 * Math.sin(i * 1.9 + 4 * t);
						phi += Math.atan2(Math.sin(target - phi), Math.cos(target - phi)) * g;
					}
					const fade = fl.gathers ? 1 - 0.75 * g : 1;
					const { d, root } = path(phi, tt, fl.ph, 2.4);
					const flick = 0.55 + 0.45 * Math.abs(Math.sin(5.3 * tt + fl.ph * 3));
					fl.p.setAttribute('d', d);
					fl.r.setAttribute('d', root);
					fl.p.style.opacity = f(flick * fade);
					fl.r.style.opacity = f(0.9 * flick * fade);
					fl.p.style.strokeWidth = fl.gathers ? '1.1' : '0.9';
					fl.r.style.strokeWidth = '1.1';
				}
				const ch = path(PHI_F, tt, 0.7, 1.6);
				channel.setAttribute('d', ch.d);
				channelR.setAttribute('d', ch.root);
				channel.style.opacity = f(g);
				channelR.style.opacity = f(g);
				channel.style.strokeWidth = f(2.2 + 0.6 * Math.abs(Math.sin(9 * tt)));
				channelR.style.strokeWidth = '2.4';
				spot.setAttribute('cx', f(PX + (PR - 1.2) * Math.cos(PHI_F)));
				spot.setAttribute('cy', f(PCY + (PR - 1.2) * Math.sin(PHI_F)));
				spot.style.opacity = f(0.9 * g);
			});
		}
	}
</script>
