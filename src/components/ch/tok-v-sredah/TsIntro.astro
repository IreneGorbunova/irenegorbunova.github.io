---
/**
 * Two short looping opening scenes of «Электрический ток в различных средах». No terms of the chapter in the pictures.
 *
 * Bulb: an evening hallway, 0,85 px per centimeter. A girl (152 см, indoor clothes from mehanicheskaya-rabota/people.ts)
 *   presses the switch (90 см above the floor) at 1,0 с; the incandescent bulb under the ceiling flashes and at
 *   1,35 с its filament breaks at its thinnest point; the hallway goes dark again and the girl looks up. A magnifier
 *   shows the bulb eight times larger (a real bulb is 6 см across). Physics in the popover: a cold tungsten filament has
 *   about 1/12 of its working resistance, so the first current is about 12 times the working one. The flash is
 *   stretched to 0,35 с so that it is seen (a real failure takes a few hundredths of a second).
 * Storm: a summer storm seen from the covered veranda of a dacha, 0,75 px per centimeter for the people: a grandfather
 *   (175 см) sits on a bench, his grandson (135 см) points at the field. Far away (not to the people's scale) lightning
 *   strikes the rod on a barn: three strokes 100 ms apart at 2,0 с (a typical flash has three or four strokes some
 *   tens of milliseconds apart: slowed so that it is seen), each lighting the sky; the channel then fades. Rain falls all the time. Real time.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const G = 214;
// the filament in the magnifier (the bulb drawn 8 times larger, center 300, 66)
const fil = 'M286 70 L290 62 L294 70 L298 62 L302 70 L306 62 L310 70 L314 62';
// the lightning: from the cloud to the tip of the rod (302, 92)
const bolt = 'M262 22 L274 38 L268 46 L284 58 L280 66 L294 78 L292 84 L302 92';
const branch = 'M274 38 L262 54 L266 60 M284 58 L296 62';
---

<PeopleStyles />
<IntroFrame data-tsintro>
	<div class="intro__card" data-scene="bulb">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка включает свет в прихожей, лампочка ярко вспыхивает и тут же перегорает. Лупа показывает, что нить лампы порвалась">
			<defs>
				<radialGradient id="tsi-light" cx="0.62" cy="0.3" r="0.75">
					<stop offset="0" class="tsi-light-a"></stop>
					<stop offset="1" class="tsi-light-b"></stop>
				</radialGradient>
				<clipPath id="tsi-lens"><circle cx="300" cy="66" r="38"></circle></clipPath>
			</defs>
			<rect class="tsi-wall" x="0" y="0" width="360" height={G}></rect>
			<rect class="tsi-ceiling" x="0" y="0" width="360" height="6"></rect>
			<!-- the front door -->
			<rect class="tsi-door" x="6" y="44" width="62" height={G - 44}></rect>
			<rect class="tsi-doorframe" x="2" y="40" width="70" height={G - 40} rx="1"></rect>
			<circle class="tsi-knob" cx="60" cy="136" r="2.6"></circle>
			<rect class="tsi-peephole" x="35" y="96" width="4" height="4" rx="2"></rect>
			<!-- a coat rack with a jacket and a scarf -->
			<rect class="tsi-rack" x="150" y="70" width="58" height="5" rx="1"></rect>
			<path class="tsi-jacket" d="M160 75 Q154 78 152 92 L150 128 L176 128 L174 92 Q172 78 166 75 Z"></path>
			<path class="tsi-scarf" d="M190 75 L186 118 L194 118 L196 75 Z"></path>
			<!-- a shoe rack with shoes -->
			<rect class="tsi-shelf" x="150" y="196" width="70" height="4"></rect>
			<path class="tsi-boot" d="M156 196 L156 182 L164 182 L165 192 L174 194 L174 196 Z M182 196 L182 184 L189 184 L190 193 L198 194 L198 196 Z"></path>
			<!-- the switch -->
			<rect class="tsi-switch" x="104" y="131" width="9" height="13" rx="1.5"></rect>
			<rect class="tsi-rocker" data-rocker x="106" y="133" width="5" height="5" rx="1"></rect>
			<!-- floor -->
			<rect class="tsi-floor" x="0" y={G} width="360" height={240 - G}></rect>
			<path class="tsi-board" d="M0 226 H360 M0 234 H360"></path>
			<g data-girl></g>
			<!-- the lamp -->
			<line class="tsi-cord" x1="236" y1="6" x2="236" y2="54"></line>
			<path class="tsi-shade" d="M226 62 L230 52 L242 52 L246 62 Z"></path>
			<circle class="tsi-bulb" data-bulb cx="236" cy="64.6" r="2.6"></circle>
			<!-- light and dark of the hallway -->
			<rect data-lit x="0" y="0" width="360" height="240" fill="url(#tsi-light)" opacity="0"></rect>
			<rect class="tsi-dark" data-dark x="0" y="0" width="360" height="240"></rect>
			<!-- the magnifier -->
			<line class="tsi-leader" x1="262" y1="66" x2="241" y2="65"></line>
			<circle class="tsi-lens-bg" cx="300" cy="66" r="38"></circle>
			<g clip-path="url(#tsi-lens)">
				<circle class="tsi-glow" data-glow cx="300" cy="72" r="30" opacity="0"></circle>
				<path class="tsi-glass" d="M300 30 Q324 34 324 66 Q324 90 300 100 Q276 90 276 66 Q276 34 300 30 Z" transform="translate(0 6)"></path>
				<rect class="tsi-base" x="290" y="22" width="20" height="14" rx="2"></rect>
				<path class="tsi-wires" d="M294 36 L286 70 M306 36 L314 62"></path>
				<path class="tsi-fil" data-fil d={fil}></path>
				<circle class="tsi-spark" data-spark cx="300" cy="66" r="0"></circle>
			</g>
			<circle class="tsi-lens" cx="300" cy="66" r="38"></circle>
			<text class="tsi-small" x="300" y="118" text-anchor="middle">×8</text>
		</svg>
		<div class="intro__foot">
			<p>
				Лампочка накаливания чаще всего перегорает{' '}
				<More term="в тот самый миг, когда её включают">
					У холодной вольфрамовой нити сопротивление примерно в 12 раз меньше, чем у раскалённой. Поэтому в первые сотые доли секунды ток в 10–12 раз больше рабочего, и самое тонкое место нити не выдерживает. Об этом — в разделе{' '}
					<a href="#электрический-ток-в-металлах">«Электрический ток в металлах»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="storm">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Дедушка и внук на веранде дачи смотрят на грозу. Молния бьёт в громоотвод на крыше сарая, и небо вспыхивает">
			<rect class="tsi-sky" x="0" y="0" width="360" height="190"></rect>
			<rect class="tsi-flash" data-flash x="0" y="0" width="360" height="190" opacity="0"></rect>
			<path class="tsi-cloud" d="M150 0 H360 V24 Q340 34 318 26 Q300 38 280 26 Q262 36 244 24 Q222 34 204 22 Q180 30 166 18 Q150 14 150 0 Z"></path>
			<!-- the field, a wood and the barn far away -->
			<path class="tsi-wood" d="M170 182 Q180 166 192 172 Q204 160 216 170 Q228 162 238 174 L240 182 Z"></path>
			<rect class="tsi-field" x="0" y="180" width="360" height="40"></rect>
			<path class="tsi-barn" d="M282 182 V146 L302 132 L322 146 V182 Z"></path>
			<rect class="tsi-barn-door" x="296" y="160" width="12" height="22"></rect>
			<line class="tsi-rod" x1="302" y1="132" x2="302" y2="92"></line>
			<line class="tsi-rod-down" x1="304" y1="134" x2="324" y2="182"></line>
			<g data-bolt opacity="0">
				<path class="tsi-bolt-glow" d={`${bolt} ${branch}`}></path>
				<path class="tsi-bolt" d={`${bolt} ${branch}`}></path>
			</g>
			<g data-rain></g>
			<!-- the veranda -->
			<rect class="tsi-roof" x="0" y="0" width="190" height="16"></rect>
			<path class="tsi-roof-edge" d="M0 16 H190 L196 20 H0 Z"></path>
			<rect class="tsi-post" x="0" y="20" width="10" height={G - 20}></rect>
			<rect class="tsi-post" x="180" y="20" width="9" height={G - 20}></rect>
			<rect class="tsi-floor2" x="0" y={G} width="196" height={240 - G}></rect>
			<rect class="tsi-step" x="190" y={G + 8} width="30" height="18"></rect>
			<rect class="tsi-ground" x="196" y="220" width="164" height="20"></rect>
			<!-- the bench -->
			<rect class="tsi-bench" x="22" y="176" width="64" height="5" rx="1"></rect>
			<path class="tsi-bench-leg" d="M28 181 V214 M80 181 V214"></path>
			<rect class="tsi-bench" x="20" y="146" width="5" height="34" rx="1"></rect>
			<g data-grandpa></g>
			<g data-boy></g>
			<!-- the railing in front of them -->
			<path class="tsi-rail" d="M10 172 H180 M10 176 H180"></path>
			{[30, 50, 70, 90, 110, 130, 150, 170].map((x) => <rect class="tsi-baluster" x={x} y="176" width="3" height={G - 176} />)}
			<rect class="tsi-flash tsi-flash--near" data-flash2 x="0" y="0" width="360" height="240" opacity="0"></rect>
		</svg>
		<div class="intro__foot">
			<p>
				Воздух обычно не проводит ток, но в грозу{' '}
				<More term="он на мгновение пропускает огромный ток">
					Между тучей и землёй накапливается напряжение в сотни миллионов вольт, и воздух не выдерживает: в нём лавиной рождаются ионы и свободные электроны. По каналу толщиной в несколько сантиметров идёт ток около 30&nbsp;000&nbsp;А, и канал раскаляется до 30&nbsp;000&nbsp;градусов. Громоотвод принимает удар на себя и отводит ток в землю. Об этом — в разделе{' '}
					<a href="#электрический-ток-в-газах">«Электрический ток в газах»</a>.
				</More>: молния бьёт в громоотвод на крыше сарая.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-tsintro] {
		--tsi-wall: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-5));
		--tsi-floor: hsl(28, 32%, 34%);
		--tsi-sky: hsl(222, 25%, 22%);
		--tsi-field: hsl(110, 25%, 28%);
	}
	:root[data-theme='light'] [data-tsintro] {
		--tsi-wall: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-6));
		--tsi-floor: hsl(28, 40%, 62%);
		--tsi-sky: hsl(215, 22%, 40%);
		--tsi-field: hsl(110, 30%, 45%);
	}
	[data-tsintro] .tsi-wall {
		fill: var(--tsi-wall);
	}
	[data-tsintro] .tsi-ceiling {
		fill: hsl(0, 0%, 88%);
	}
	[data-tsintro] .tsi-door {
		fill: hsl(25, 35%, 38%);
	}
	[data-tsintro] .tsi-doorframe {
		fill: none;
		stroke: hsl(25, 30%, 26%);
		stroke-width: 4;
	}
	[data-tsintro] .tsi-knob {
		fill: hsl(45, 60%, 60%);
	}
	[data-tsintro] .tsi-peephole {
		fill: hsl(0, 0%, 20%);
	}
	[data-tsintro] .tsi-rack,
	[data-tsintro] .tsi-shelf {
		fill: hsl(25, 30%, 30%);
	}
	[data-tsintro] .tsi-jacket {
		fill: var(--ig-vy);
		stroke: hsl(222, 35%, 14%);
		stroke-width: 0.7;
	}
	[data-tsintro] .tsi-scarf {
		fill: hsl(150, 50%, 50%);
		stroke: hsl(222, 35%, 14%);
		stroke-width: 0.6;
	}
	[data-tsintro] .tsi-boot {
		fill: hsl(24, 38%, 30%);
	}
	[data-tsintro] .tsi-switch {
		fill: hsl(0, 0%, 94%);
		stroke: hsl(0, 0%, 55%);
		stroke-width: 0.6;
	}
	[data-tsintro] .tsi-rocker {
		fill: hsl(0, 0%, 78%);
	}
	[data-tsintro] .tsi-floor,
	[data-tsintro] .tsi-floor2 {
		fill: var(--tsi-floor);
	}
	[data-tsintro] .tsi-board {
		fill: none;
		stroke: color-mix(in oklab, var(--tsi-floor) 70%, black);
		stroke-width: 0.6;
	}
	[data-tsintro] .tsi-cord {
		stroke: hsl(0, 0%, 25%);
		stroke-width: 1;
	}
	[data-tsintro] .tsi-shade {
		fill: hsl(40, 30%, 80%);
		stroke: hsl(222, 35%, 14%);
		stroke-width: 0.6;
	}
	[data-tsintro] .tsi-bulb {
		fill: hsl(50, 30%, 85%);
	}
	[data-tsintro] .tsi-bulb.is-on {
		fill: hsl(50, 100%, 92%);
	}
	[data-tsintro] .tsi-light-a {
		stop-color: hsl(48, 100%, 80%);
		stop-opacity: 0.55;
	}
	[data-tsintro] .tsi-light-b {
		stop-color: hsl(48, 100%, 70%);
		stop-opacity: 0.08;
	}
	[data-tsintro] .tsi-dark {
		fill: hsl(230, 40%, 8%);
	}
	[data-tsintro] .tsi-leader {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	[data-tsintro] .tsi-lens-bg {
		fill: var(--sl-color-bg);
	}
	[data-tsintro] .tsi-lens {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
	}
	[data-tsintro] .tsi-glow {
		fill: hsl(50, 100%, 75%);
	}
	[data-tsintro] .tsi-glass {
		fill: color-mix(in oklab, hsl(200, 40%, 85%) 30%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-tsintro] .tsi-base {
		fill: hsl(40, 15%, 62%);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	[data-tsintro] .tsi-wires {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-tsintro] .tsi-fil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	[data-tsintro] .tsi-fil.is-hot {
		stroke: hsl(50, 100%, 92%);
		stroke-width: 2;
		filter: drop-shadow(0 0 3px hsl(45, 100%, 60%));
	}
	[data-tsintro] .tsi-spark {
		fill: hsl(0, 0%, 100%);
		filter: drop-shadow(0 0 4px hsl(45, 100%, 60%));
	}
	[data-tsintro] .tsi-small {
		font-size: 12px;
		fill: var(--sl-color-gray-1);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3px;
	}
	/* the storm */
	[data-tsintro] .tsi-sky {
		fill: var(--tsi-sky);
	}
	[data-tsintro] .tsi-flash {
		fill: hsl(220, 60%, 92%);
	}
	[data-tsintro] .tsi-cloud {
		fill: color-mix(in oklab, var(--tsi-sky) 60%, black);
	}
	[data-tsintro] .tsi-wood {
		fill: hsl(140, 25%, 20%);
	}
	[data-tsintro] .tsi-field {
		fill: var(--tsi-field);
	}
	[data-tsintro] .tsi-barn {
		fill: hsl(10, 35%, 32%);
		stroke: hsl(222, 35%, 14%);
		stroke-width: 0.7;
	}
	[data-tsintro] .tsi-barn-door {
		fill: hsl(10, 30%, 22%);
	}
	[data-tsintro] .tsi-rod,
	[data-tsintro] .tsi-rod-down {
		stroke: hsl(210, 10%, 70%);
		stroke-width: 1.2;
	}
	[data-tsintro] .tsi-bolt {
		fill: none;
		stroke: hsl(0, 0%, 100%);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	[data-tsintro] .tsi-bolt-glow {
		fill: none;
		stroke: hsl(235, 90%, 62%);
		stroke-width: 6;
		opacity: 0.5;
		stroke-linejoin: round;
	}
	[data-tsintro] .tsi-rain {
		stroke: hsl(210, 40%, 75%);
		stroke-width: 0.8;
		opacity: 0.6;
	}
	[data-tsintro] .tsi-roof {
		fill: hsl(25, 30%, 28%);
	}
	[data-tsintro] .tsi-roof-edge,
	[data-tsintro] .tsi-post,
	[data-tsintro] .tsi-baluster {
		fill: hsl(30, 35%, 42%);
	}
	[data-tsintro] .tsi-rail {
		fill: none;
		stroke: hsl(30, 35%, 42%);
		stroke-width: 3;
	}
	[data-tsintro] .tsi-step {
		fill: color-mix(in oklab, var(--tsi-floor) 80%, black);
	}
	[data-tsintro] .tsi-ground {
		fill: hsl(25, 25%, 25%);
	}
	[data-tsintro] .tsi-bench {
		fill: hsl(25, 35%, 32%);
	}
	[data-tsintro] .tsi-bench-leg {
		stroke: hsl(25, 35%, 28%);
		stroke-width: 4;
	}
	[data-tsintro] .tsi-flash--near {
		fill: hsl(220, 60%, 92%);
		mix-blend-mode: soft-light;
	}
	[data-tsintro] .hm-gray .hm-hair {
		fill: hsl(0, 0%, 78%);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { human } from '../mehanicheskaya-rabota/people';

	const smooth = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, u: number) => a + (b - a) * u;
	const FIL = 'M286 70 L290 62 L294 70 L298 62 L302 70 L306 62 L310 70 L314 62';
	const BROKEN = 'M286 70 L290 62 L294 70 L298 62 L299.4 64.8 M300.8 67.4 L302 70 L306 62 L310 70 L314 62';

	for (const root of document.querySelectorAll<HTMLElement>('[data-tsintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bulb"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 214;
			const S = 0.85;
			const H = 152;
			const u = S * H;
			const A = 7 * S * (H / 172);
			const girl = human($<SVGGElement>('[data-girl]'), { s: S, H, shirt: 'hm-gold', hair: 'pony' });
			const hipX = 80;
			const ON = 1.0;
			const BREAK = 1.35;
			const lit = $('[data-lit]');
			const dark = $('[data-dark]');
			const bulb = $('[data-bulb]');
			const glow = $('[data-glow]');
			const filament = $('[data-fil]');
			const spark = $('[data-spark]');
			const rocker = $('[data-rocker]');
			scene(card, 4.5, (x) => {
				const t = 4.5 * x;
				const reach = smooth((t - 0.15) / 0.8);
				const press = t > ON - 0.12 && t < ON + 0.3 ? 1.2 : 0;
				const look = smooth((t - BREAK - 0.2) / 0.6);
				girl({
					hip: { x: hipX, y: G - 0.505 * u },
					lean: 0.03,
					ankles: [
						{ x: hipX + 0.03 * u, y: G - A },
						{ x: hipX - 0.04 * u, y: G - A },
					],
					feet: [0, 0],
					hands: [
						{ x: lerp(88, 106.5, reach), y: lerp(160, 135.5 + press, reach) },
						{ x: hipX - 0.01 * u, y: G - 0.42 * u },
					],
					palms: [lerp(1.4, 0.3, reach), null],
					head: lerp(0.15, -0.45, look),
				});
				const on = t >= ON && t < BREAK;
				rocker.setAttribute('y', t >= ON ? '137' : '133');
				lit.setAttribute('opacity', on ? '1' : '0');
				dark.setAttribute('opacity', on ? '0' : '0.42');
				bulb.classList.toggle('is-on', on);
				glow.setAttribute('opacity', on ? '0.8' : '0');
				filament.classList.toggle('is-hot', on);
				filament.setAttribute('d', t >= BREAK ? BROKEN : FIL);
				const sp = t >= BREAK && t < BREAK + 0.12 ? 1 - (t - BREAK) / 0.12 : 0;
				spark.setAttribute('r', (4 * sp).toFixed(2));
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="storm"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 214;
			const S = 0.75;
			const grandpa = human($<SVGGElement>('[data-grandpa]'), { s: S, H: 175, girth: 1.15, shirt: 'hm-blue', hair: 'short' });
			$<SVGGElement>('[data-grandpa]').classList.add('hm-gray');
			const boy = human($<SVGGElement>('[data-boy]'), { s: S, H: 135, shirt: 'hm-red', hair: 'short', shorts: true });
			const uG = S * 175;
			const uB = S * 135;
			const AG = 7 * S;
			const AB = 7 * S * (135 / 172);
			const bolt = $('[data-bolt]');
			const flash = $('[data-flash]');
			const flash2 = $('[data-flash2]');
			// rain: straight streaks falling at 3 px per frame-second unit, looping
			const rainG = $<SVGGElement>('[data-rain]');
			let seed = 5;
			const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
			const drops = Array.from({ length: 70 }, () => {
				const l = el('line', { class: 'tsi-rain' });
				rainG.append(l);
				return { l, x: rnd() * 380, y: rnd(), v: 0.9 + rnd() * 0.4 };
			});
			const STRIKE = 2.0;
			scene(card, 5, (x) => {
				const t = 5 * x;
				// three strokes 100 ms apart
				const k = (t - STRIKE) / 0.1;
				const strokeOn = k >= 0 && k < 5 && Math.floor(k) % 2 === 0;
				bolt.setAttribute('opacity', strokeOn ? '1' : t > STRIKE && t < STRIKE + 0.9 ? '0.3' : '0');
				flash.setAttribute('opacity', strokeOn ? '0.75' : '0');
				flash2.setAttribute('opacity', strokeOn ? '0.55' : '0');
				for (const d of drops) {
					const y = ((d.y + d.v * t) % 1) * 240;
					const xx = d.x - y * 0.12;
					d.l.setAttribute('x1', xx.toFixed(1));
					d.l.setAttribute('y1', y.toFixed(1));
					d.l.setAttribute('x2', (xx - 1.2).toFixed(1));
					d.l.setAttribute('y2', (y + 9).toFixed(1));
				}
				// the grandfather sits; at the flash he turns his head to the field
				const hipG = { x: 50, y: 176 - 0.02 * uG };
				grandpa({
					hip: hipG,
					lean: -0.06,
					ankles: [
						{ x: hipG.x + 0.27 * uG, y: G - AG },
						{ x: hipG.x + 0.22 * uG, y: G - AG },
					],
					feet: [0, 0],
					hands: [
						{ x: hipG.x + 0.2 * uG, y: hipG.y - 0.03 * uG },
						{ x: hipG.x + 0.17 * uG, y: hipG.y - 0.03 * uG },
					],
					head: t > STRIKE ? lerp(0.05, -0.12, smooth((t - STRIKE) / 0.4)) : 0.05,
				});
				// the boy stands at the railing and points at the field
				const hipB = { x: 128, y: G - 0.505 * uB };
				const point = smooth((t - STRIKE - 0.2) / 0.5);
				boy({
					hip: hipB,
					lean: 0.04,
					ankles: [
						{ x: hipB.x + 0.04 * uB, y: G - AB },
						{ x: hipB.x - 0.05 * uB, y: G - AB },
					],
					feet: [0, 0],
					hands: [
						{ x: lerp(hipB.x + 0.06 * uB, hipB.x + 0.36 * uB, point), y: lerp(G - 0.43 * uB, G - 0.86 * uB, point) },
						{ x: hipB.x + 0.13 * uB, y: 171 },
					],
					// the near hand points with the index finger; the far hand holds the railing
					grips: [point > 0.5 ? { pose: 'point', dir: -0.5 } : null, { pose: 'grip' }],
					head: lerp(0.05, -0.15, point),
				});
			});
		}
	}
</script>
