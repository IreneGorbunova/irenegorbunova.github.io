---
/**
 * «Диод в цепи»: a crystal with a p-region (holes, red rings) and an n-region (free electrons, blue dots) joined at the
 * p–n junction, in a circuit with a battery of 3 В and a lamp. Two cases:
 *   forward — «+» of the battery to the p-region: holes move to the right and electrons to the left, meet at the
 *     junction and vanish there (recombine, a small flash); new ones keep coming from the wires: a current, the lamp is on;
 *   reverse — «+» to the n-region: the carriers are pulled away from the junction, a layer without free carriers
 *     (shaded, the blocking layer) widens, there is (almost) no current, the lamp is off.
 * The side graph is the current–voltage curve of a silicon diode, I = I₀(e^(U/0,06 В) − 1) with I₀ chosen so that
 * I = 20 мА at 0,7 В (axes: U −4…1 В, I 0…30 мА); the point is the present case: 0,7 В and 20 мА in the forward
 * direction (the rest of the 3 В falls on the lamp), −3 В and less than a microampere in the reverse one.
 * The curve is not capped: it ends where it leaves the frame at the top (31,5 мА), still rising steeply.
 * Symbolic speeds.
 */
import G7Styles from '../g7/G7Styles.astro';

const GX = 36;
const GY = 128;
const PU = 34; // px per В (U from −4 to 1)
const PI = 3.8; // px per мА
const U0 = GX + 4 * PU; // the point U = 0
// the curve is drawn up to the top of the frame (31,5 мА, at U ≈ 0,727 В) and simply ends there: it keeps rising
const iAt = (U: number) => 20 * (Math.exp((U - 0.7) / 0.06) - Math.exp(-0.7 / 0.06));
const I_END = 31.5;
const U_END = 0.7 + 0.06 * Math.log(I_END / 20 + Math.exp(-0.7 / 0.06));
let curve = '';
for (let k = 0; k <= 400; k++) {
	const U = -4 + ((U_END + 4) * k) / 400;
	curve += `${k ? 'L' : 'M'}${(U0 + U * PU).toFixed(1)} ${(GY - iAt(U) * PI).toFixed(1)} `;
}
---

<G7Styles />
<figure class="g7 dio not-content" data-dio>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 230" role="img" aria-label="Полупроводниковый диод из областей p и n в цепи с батарейкой и лампой. При прямом включении носители идут к переходу и лампа горит, при обратном — уходят от перехода и тока нет">
			<defs>
				<marker id="dio-r" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="dio-p" x="70" y="40" width="110" height="80"></rect>
			<rect class="dio-n" x="180" y="40" width="110" height="80"></rect>
			<rect class="dio-block" data-block x="180" y="40" width="0" height="80"></rect>
			<line class="dio-junction" x1="180" y1="34" x2="180" y2="126"></line>
			<text class="t-strong" x="78" y="34">p</text>
			<text class="t-strong" x="274" y="34">n</text>
			<text class="t-small" x="180" y="138" text-anchor="middle">p–n-переход</text>
			<g data-car></g>
			<!-- the circuit -->
			<path class="dio-wire" d="M70 80 H30 V196 H140 M220 196 H330 V80 H290"></path>
			<g data-bat>
				<line class="dio-plate" x1="160" y1="184" x2="160" y2="208"></line>
				<line class="dio-plate dio-plate--short" x1="168" y1="190" x2="168" y2="202"></line>
				<line class="dio-plate" x1="176" y1="184" x2="176" y2="208"></line>
				<line class="dio-plate dio-plate--short" x1="184" y1="190" x2="184" y2="202"></line>
				<path class="dio-wire" d="M140 196 H160 M184 196 H220"></path>
			</g>
			<text class="t-strong" data-sl x="148" y="182" text-anchor="middle">+</text>
			<text class="t-strong" data-sr x="196" y="182" text-anchor="middle">−</text>
			<circle class="dio-glow" data-glow cx="330" cy="140" r="20"></circle>
			<circle class="dio-bulb" cx="330" cy="140" r="12"></circle>
			<path class="dio-x" d="M322 132 L338 148 M322 148 L338 132"></path>
			<line class="arrow arrow--red" data-cur x1="120" y1="210" x2="70" y2="210" marker-end="url(#dio-r)"></line>
			<text class="t-small" data-curt x="30" y="226"></text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" data-modes>
				<button type="button" class="g7__btn" data-m="fwd" aria-pressed="true">Прямое включение</button>
				<button type="button" class="g7__btn" data-m="rev" aria-pressed="false">Обратное включение</button>
			</div>
			<svg class="g7__svg" viewBox="0 0 220 166" role="img" aria-label="Вольт-амперная характеристика диода">
				<path class="ln" d={`M${GX} ${GY} H${GX + 5 * PU + 6} M${U0} ${GY + 6} V${GY - 30 * PI - 6}`}></path>
				{[-4, -3, -2, -1, 1].map((u) => <text class="t-small t-num" x={U0 + u * PU} y={GY + 18} text-anchor="middle">{u}</text>)}
				{[10, 20, 30].map((i) => (
					<>
						<line class="dio-grid" x1={GX} x2={GX + 5 * PU} y1={GY - i * PI} y2={GY - i * PI} />
						<text class="t-small t-num" x={U0 - 4} y={GY - i * PI + 4} text-anchor="end">{i}</text>
					</>
				))}
				<text class="t-small" x={GX + 5 * PU + 6} y={GY + 31} text-anchor="end"><tspan class="t-i">U</tspan>, В</text>
				<text class="t-small" x={U0 - 24} y="10" text-anchor="end"><tspan class="t-i">I</tspan>, мА</text>
				<path class="dio-curve" d={curve}></path>
				<circle class="dio-point" data-pt r="4.5"></circle>
			</svg>
			<ul class="g7__read" aria-live="polite">
				<li><span>Напряжение на диоде</span><b data-u></b></li>
				<li class="is-key"><span>Сила тока</span><b data-i></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Батарейка 3&nbsp;В. Красные кольца — дырки, синие точки — свободные электроны; скорости условные. Справа — вольт-амперная характеристика кремниевого диода, точка — нынешнее включение.</figcaption>
</figure>

<style is:global>
	/* labels at least 11 px on screen at 1280 and 390 (28 Nov 2026) */
	.dio .g7__svg .t-small {
		font-size: 13px;
	}
	.dio .g7__svg text {
		font-size: 13px;
	}
	.dio-p {
		fill: color-mix(in oklab, var(--g7-red) 14%, var(--g7-paper));
		stroke: var(--g7-line);
	}
	.dio-n {
		fill: color-mix(in oklab, var(--g7-blue) 14%, var(--g7-paper));
		stroke: var(--g7-line);
	}
	.dio-block {
		fill: color-mix(in oklab, var(--g7-ink) 12%, transparent);
	}
	.dio-junction {
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.dio-wire {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2.2;
	}
	.dio-plate {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.dio-plate--short {
		stroke-width: 5;
	}
	.dio-bulb {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.dio-x {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.dio-glow {
		fill: var(--g7-gold);
		opacity: 0;
	}
	.dio-glow.is-on {
		opacity: 0.55;
	}
	.dio-h {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.6;
	}
	.dio-e {
		fill: var(--g7-blue);
	}
	.dio-flash {
		fill: var(--g7-gold);
	}
	.dio-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.dio-curve {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
	}
	.dio-point {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
</style>

<script>
	import { el, loop, segment } from '../g7/kit';

	const GX = 36;
	const GY = 128;
	const PU = 34;
	const PI = 3.8;
	const U0 = GX + 4 * PU;
	for (const root of document.querySelectorAll<HTMLElement>('[data-dio]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const g = q<SVGGElement>('[data-car]');
		let seed = 3;
		const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
		// 14 holes in the p-region, 14 electrons in the n-region; s is the distance from the far end (0…110 px)
		type P = { node: SVGElement; kind: 'h' | 'e'; s: number; y: number; b: number };
		const parts: P[] = [];
		for (let i = 0; i < 28; i++) {
			const kind = i < 14 ? 'h' : 'e';
			const node = kind === 'h' ? el('circle', { class: 'dio-h', r: 4 }) : el('circle', { class: 'dio-e', r: 3.2 });
			g.append(node);
			parts.push({ node, kind, s: (i % 14) * 7.6 + rnd() * 5, y: 48 + rnd() * 64, b: (i % 14) * 5.6 + rnd() * 3 });
		}
		const flashes = Array.from({ length: 4 }, () => {
			const c = el('circle', { class: 'dio-flash', r: 0, cx: 180 });
			g.append(c);
			return { c, age: 1 };
		});
		let fi = 0;
		let fwd = true;
		const set = () => {
			q('[data-block]').setAttribute('x', fwd ? '180' : '150');
			q('[data-block]').setAttribute('width', fwd ? '0' : '60');
			q('[data-glow]').classList.toggle('is-on', fwd);
			q('[data-bat]').setAttribute('transform', fwd ? '' : 'translate(344 0) scale(-1 1)');
			q('[data-sl]').textContent = fwd ? '+' : '−';
			q('[data-sr]').textContent = fwd ? '−' : '+';
			q('[data-cur]').setAttribute('opacity', fwd ? '1' : '0');
			q('[data-curt]').textContent = fwd ? 'направление тока' : 'тока почти нет';
			q('[data-pt]').setAttribute('cx', String(fwd ? U0 + 0.7 * PU : U0 - 3 * PU));
			q('[data-pt]').setAttribute('cy', String(fwd ? GY - 20 * PI : GY));
			q('[data-u]').textContent = fwd ? '0,7\u00a0В' : '−3\u00a0В';
			q('[data-i]').textContent = fwd ? '20\u00a0мА' : 'меньше 1\u00a0мкА';
		};
		let t = 0;
		const draw = (dt: number) => {
			for (const p of parts) {
				if (fwd) {
					p.s += 22 * dt;
					if (p.s > 108) {
						// recombination at the junction: a flash, and a new carrier comes from the wire
						const f = flashes[fi++ % flashes.length];
						f.age = 0;
						f.c.setAttribute('cy', p.y.toFixed(1));
						p.s = 0;
						p.y = 48 + rnd() * 64;
					}
				} else {
					// pulled away from the junction: they gather in the outer 80 px
					p.s += (p.b - p.s) * Math.min(1, 3 * dt);
				}
				const x = p.kind === 'h' ? 74 + p.s : 286 - p.s;
				p.node.setAttribute('cx', (x + Math.sin(t * 5 + p.y) * 0.8).toFixed(1));
				p.node.setAttribute('cy', (p.y + Math.cos(t * 4 + p.s) * 0.8).toFixed(1));
			}
			for (const f of flashes) {
				f.age += dt;
				f.c.setAttribute('r', f.age < 0.25 ? (4 * (1 - f.age / 0.25)).toFixed(1) : '0');
			}
		};
		segment(q('[data-modes]'), (b) => {
			fwd = b.dataset.m === 'fwd';
			set();
		});
		set();
		draw(0);
		loop(root, (dt) => {
			t += dt;
			draw(dt);
			return true;
		});
	}
</script>
