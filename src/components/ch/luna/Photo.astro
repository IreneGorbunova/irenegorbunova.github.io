---
/**
 * A photograph from public/moon/ with a caption and its source (NASA photos are in the public domain).
 * Not a model: the figure has no `not-content` class, so it does not count for the chapter star.
 */
interface Props {
	src: string;
	alt: string;
	credit: string;
	width: number;
	height: number;
	/** Narrower picture, e.g. 22rem. */
	max?: string;
}
const { src, alt, credit, width, height, max = '36rem' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<figure class="lphoto" style={`--lphoto-max:${max}`}>
	<img src={`${base}moon/${src}`} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
	<figcaption><slot /> <span class="lphoto__credit">{credit}</span></figcaption>
</figure>

<style is:global>
	.sl-markdown-content .lphoto {
		margin: 1.5rem auto;
		max-width: var(--lphoto-max);
	}
	.sl-markdown-content .lphoto img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.8rem;
		background: #000;
	}
	.sl-markdown-content .lphoto figcaption {
		margin-top: 0.45rem;
		font-size: var(--sl-text-xs);
		line-height: 1.45;
		color: var(--sl-color-gray-3);
	}
	.lphoto__credit {
		opacity: 0.8;
	}
</style>
