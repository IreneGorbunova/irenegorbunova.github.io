---
/**
 * The Earth and the Moon to one scale (1 unit = 1250 km): sizes and distance are true.
 * «Послать импульс» sends a laser pulse at the speed of light in REAL time: 1,28 s there, 1,28 s back,
 * and a stopwatch counts the trip; r = ct/2. Chips put the Moon at perigee / mean distance / apogee
 * (NASA Moon Fact Sheet: 363 300 / 384 400 / 405 500 km). Distances are between the centres.
 */
const KM = 1250; // km per SVG unit
const RE = 6371 / KM;
const RM = 1737.4 / KM;
const EX = 12; // the Earth's centre
const dists = [
	{ name: 'перигей', d: 363300 },
	{ name: 'в среднем', d: 384400 },
	{ name: 'апогей', d: 405500 },
];
const uid = Math.random().toString(36).slice(2, 8);
const ghosts = Array.from({ length: 30 }, (_, i) => EX + RE * (2 * i + 1));
---

<figure class="lls not-content" data-lls data-km={KM} data-re={RE} data-rm={RM} data-ex={EX}>
	<svg class="lls__svg" viewBox="0 0 345 48" role="img" aria-label="Земля и Луна в одном масштабе; лазерный импульс летит к Луне и обратно">
		<defs>
			<radialGradient id={`lls-earth-${uid}`} cx="35%" cy="35%" r="70%">
				<stop offset="0" stop-color="#9fd0ff" />
				<stop offset="0.55" stop-color="#3b82d6" />
				<stop offset="1" stop-color="#173a7a" />
			</radialGradient>
			<radialGradient id={`lls-moon-${uid}`} cx="35%" cy="35%" r="70%">
				<stop offset="0" stop-color="#f4f1e8" />
				<stop offset="1" stop-color="#9c9a93" />
			</radialGradient>
		</defs>
		<g class="lls__stars">
			{
				[
					[40, 8], [77, 46], [112, 14], [150, 50], [176, 6], [214, 40], [250, 12], [281, 48], [318, 9], [96, 30], [232, 27], [300, 33], [60, 52], [192, 22],
				].map(([x, y]) => <circle cx={x} cy={y} r="0.45" />)
			}
		</g>
		<g class="lls__ghosts" aria-hidden="true">
			{ghosts.map((x) => <circle cx={x} cy="26" r={RE} />)}
		</g>
		<line class="lls__beam" data-beam x1="0" y1="26" x2="0" y2="26" />
		<circle class="lls__earth" cx={EX} cy="26" r={RE} fill={`url(#lls-earth-${uid})`} />
		<g data-moon>
			<circle class="lls__flash" data-flash cx="0" cy="26" r="4" />
			<circle cx="0" cy="26" r={RM} fill={`url(#lls-moon-${uid})`} />
		</g>
		<line class="lls__dim" data-dim x1={EX} y1="40" x2="0" y2="40" />
		<line class="lls__dim" x1={EX} y1="37" x2={EX} y2="43" />
		<line class="lls__dim" data-dim-end x1="0" y1="37" x2="0" y2="43" />
	</svg>
	<div class="lls__labels">
		<span>Земля</span>
		<span class="lls__dist" data-dim-label></span>
		<span>Луна</span>
	</div>
	<div class="lls__bar">
		<button type="button" class="lls__go" data-go>Послать лазерный импульс</button>
		<span class="lls__watch" aria-live="off"><span data-watch>0,0000</span> с</span>
	</div>
	<div class="lls__chips" role="group" aria-label="Расстояние до Луны">
		{
			dists.map((x, i) => (
				<button type="button" class="lls__chip" data-d={x.d} aria-pressed={i === 1 ? 'true' : 'false'}>
					{x.name}: <span class="nw">{x.d.toLocaleString('ru-RU')} км</span>
				</button>
			))
		}
	</div>
	<p class="lls__calc" data-calc aria-live="polite"></p>
	<figcaption class="lls__caption">
		Размеры Земли, Луны и расстояние между ними — в одном масштабе. Между ними поместились бы 30 таких Земель (бледные
		кружки). Импульс летит со скоростью света, и секундомер идёт по-настоящему; расстояние считаем между центрами.
	</figcaption>
</figure>

<style is:global>
	.lls {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lls__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.7rem;
		background: radial-gradient(ellipse at 20% 50%, #0b1433, #02030a 70%);
	}
	.lls__stars circle {
		fill: rgb(225 232 255 / 0.7);
	}
	.lls__ghosts circle {
		fill: none;
		stroke: rgb(159 208 255 / 0.16);
		stroke-width: 0.35;
	}
	.lls__beam {
		stroke: #ff5a5a;
		stroke-width: 1.1;
		stroke-linecap: round;
		filter: drop-shadow(0 0 1.5px #ff5a5a);
	}
	.lls__flash {
		fill: #ff8a8a;
		opacity: 0;
	}
	.lls__labels {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.lls__dist {
		text-align: center;
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
	}
	.lls__dim {
		stroke: rgb(235 238 255 / 0.45);
		stroke-width: 0.5;
	}
	.lls__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1rem;
		margin-top: 0.7rem;
	}
	.lls__go {
		margin: 0;
		padding: 0.4rem 1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-black);
		background: var(--sl-color-accent-high);
		border: 0;
		border-radius: 999px;
		cursor: pointer;
	}
	.lls__go:disabled {
		opacity: 0.55;
		cursor: default;
	}
	.lls__watch {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.lls__watch span {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.lls__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.6rem;
	}
	.lls__chip {
		margin: 0;
		padding: 0.3rem 0.8rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.lls__chip:hover {
		border-color: var(--sl-color-accent);
	}
	.lls__chip[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.lls__calc {
		margin: 0.6rem 0 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.lls__calc b {
		color: var(--sl-color-white);
	}
	.lls__calc i {
		font-family: var(--ig-font-math);
	}
	.lls__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.lls {
			padding: 0.5rem;
		}
	}
</style>

<script>
	import { fmt } from './util';

	const C = 299792.458; // km/s
	for (const root of document.querySelectorAll<HTMLElement>('[data-lls]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const KM = Number(root.dataset.km);
		const RE = Number(root.dataset.re);
		const RM = Number(root.dataset.rm);
		const EX = Number(root.dataset.ex);
		const moon = q<SVGGElement>('[data-moon]');
		const dimEnd = q<SVGLineElement>('[data-dim-end]');
		const flash = q<SVGCircleElement>('[data-flash]');
		const beam = q<SVGLineElement>('[data-beam]');
		const dim = q<SVGLineElement>('[data-dim]');
		const dimLabel = q<HTMLElement>('[data-dim-label]');
		const go = q<HTMLButtonElement>('[data-go]');
		const watch = q<HTMLElement>('[data-watch]');
		const calc = q<HTMLElement>('[data-calc]');
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-d]'));

		let d = 384400; // km, between the centres
		let shownX = EX + d / KM; // the Moon's drawn position (eases to the target)
		let t0 = -1; // start of the pulse, ms
		let raf = 0;

		const tTotal = () => (2 * d) / C;
		const place = () => {
			moon.querySelectorAll('circle').forEach((c) => c.setAttribute('cx', String(shownX)));
			dim.setAttribute('x2', String(shownX));
			dimEnd.setAttribute('x1', String(shownX));
			dimEnd.setAttribute('x2', String(shownX));
		};
		const text = () => {
			const t = tTotal();
			dimLabel.textContent = `${d.toLocaleString('ru-RU')} км ≈ ${fmt(d / 12742, 0)} диаметров Земли`;
			calc.innerHTML =
				t0 < 0 && watch.textContent === '0,0000'
					? `Нажмите на кнопку: свет пройдёт ${d.toLocaleString('ru-RU')} км до Луны и столько же обратно.`
					: `Импульс вернулся через <b><i>t</i> = ${fmt(t, 4)} с</b>. Расстояние до Луны <b><i>r</i> = <i>ct</i>/2 = ${(Math.round((C * Number(t.toFixed(4))) / 2 / 100) * 100).toLocaleString('ru-RU')} км</b>.`;
		};
		const frame = (now: number) => {
			const target = EX + d / KM;
			shownX += (target - shownX) * 0.15;
			if (Math.abs(target - shownX) < 0.01) shownX = target;
			place();
			let busy = Math.abs(target - shownX) > 0;
			if (t0 >= 0) {
				const s = (now - t0) / 1000;
				const T = tTotal();
				const xs = EX + RE; // from the Earth's surface
				const xm = shownX - RM; // to the Moon's surface
				const path = xm - xs;
				const len = 8;
				if (s < T / 2) {
					const x = xs + (path * s) / (T / 2);
					beam.setAttribute('x1', String(Math.max(xs, x - len)));
					beam.setAttribute('x2', String(x));
					flash.style.opacity = '0';
				} else if (s < T) {
					const x = xm - (path * (s - T / 2)) / (T / 2);
					beam.setAttribute('x1', String(x));
					beam.setAttribute('x2', String(Math.min(xm, x + len)));
					flash.style.opacity = String(Math.max(0, 0.8 - (s - T / 2) * 2));
				} else {
					beam.setAttribute('x1', '0');
					beam.setAttribute('x2', '0');
					flash.style.opacity = '0';
				}
				watch.textContent = fmt(Math.min(s, T), 4);
				if (s >= T) {
					t0 = -1;
					go.disabled = false;
					chips.forEach((c) => (c.disabled = false));
					text();
				} else busy = true;
			}
			raf = busy ? requestAnimationFrame(frame) : 0;
		};
		const kick = () => {
			if (!raf) raf = requestAnimationFrame(frame);
		};
		go.addEventListener('click', () => {
			shownX = EX + d / KM;
			t0 = performance.now();
			go.disabled = true;
			chips.forEach((c) => (c.disabled = true));
			watch.textContent = fmt(0, 4);
			kick();
		});
		for (const c of chips)
			c.addEventListener('click', () => {
				d = Number(c.dataset.d);
				chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
				watch.textContent = '0,0000';
				text();
				kick();
			});
		place();
		text();
	}
</script>
