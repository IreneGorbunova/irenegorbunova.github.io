---
/**
 * Small pictures to «Где это встречается»: a month in a calendar with the Moon's phase on every day (day 1 — new moon,
 * mean motion, 29,53 сут: first quarter on day 8, full moon on day 16, last quarter on day 23, new moon on day 30);
 * a tidal power station (the sea, the dam with a turbine in its tunnel, the basin; the water flows through the
 * turbine while the levels differ: CSS loop); a solar eclipse as a school scheme (the Sun, the Moon and the Earth on
 * one line, extreme rays dashed, the Moon's shadow on the Earth; not to scale); the ashen light (a young crescent and
 * the rest of the disc faintly lit by the Earth).
 */
import { shadowPath } from './moonface';

const uid = Math.random().toString(36).slice(2, 8);
const mA = `lus-${uid}`;
// calendar: 30 cells, 7 per row
const cells = Array.from({ length: 30 }, (_, i) => ({ x: 16 + (i % 7) * 24, y: 30 + Math.floor(i / 7) * 23, d: i + 1 }));
const PR = 7.5;
// the Moon's phase on each day: day 1 is the new moon
const phase = (d: number) => shadowPath((2 * Math.PI * (d - 1)) / 29.53, PR + 0.2, 12);
---

<figure class="lus not-content">
	<div class="lus__grid">
		<svg class="lus__svg" viewBox="0 0 200 150" role="img" aria-label="Календарь на месяц с фазами Луны на каждый день: в первый день новолуние, на восьмой — первая четверть, на шестнадцатый — полнолуние, на двадцать третий — последняя четверть, на тридцатый снова новолуние">
			<text class="lus-title" x="100" y="18" text-anchor="middle">Календарь</text>
			{cells.map((c) => (
				<rect class="lus-cell" x={c.x} y={c.y} width="22" height="21" rx="3"></rect>
			))}
			{cells.map((c) => (
				<g transform={`translate(${c.x + 11} ${c.y + 10.5})`}>
					<circle class="lus-lit" r={PR}></circle>
					<path class="lus-unlit" d={phase(c.d)}></path>
				</g>
			))}
		</svg>

		<svg class="lus__svg" viewBox="0 0 200 150" role="img" aria-label="Приливная электростанция в разрезе: слева море, справа бассейн, между ними плотина. Вода из моря проходит через турбину в плотине">
			<text class="lus-title" x="100" y="18" text-anchor="middle">Приливная станция</text>
			<path class="lus-water" d="M0 58 H84 V140 H0 Z"></path>
			<path class="lus-water" d="M116 84 H200 V140 H116 Z"></path>
			<path class="lus-wave" d="M6 58 q6 -3 12 0 t12 0 t12 0 t12 0 t12 0 t12 0"></path>
			<path class="lus-dam" d="M84 40 H116 V140 H84 Z"></path>
			<path class="lus-tunnel" d="M80 112 H120 V128 H80 Z"></path>
			<line class="lus-flow" x1="20" y1="120" x2="186" y2="120"></line>
			<g class="lus-turbine" transform="translate(100 120)">
				<g class="lus-spin">
					<path d="M0 0 L-3 -7 L3 -7 Z M0 0 L-3 7 L3 7 Z M0 0 L-7 -3 L-7 3 Z M0 0 L7 -3 L7 3 Z"></path>
				</g>
				<circle r="2"></circle>
			</g>
			<line class="lus-wire" x1="100" y1="112" x2="100" y2="56"></line>
			<rect class="lus-gen" x="92" y="44" width="16" height="12" rx="2"></rect>
			<text class="lus-t" x="38" y="78" text-anchor="middle">море</text>
			<text class="lus-t" x="160" y="104" text-anchor="middle">бассейн</text>
			<line class="lus-arrow" x1="44" y1="100" x2="66" y2="100" marker-end={`url(#${mA})`}></line>
			<defs>
				<marker id={mA} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="lus-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
		</svg>

		<svg class="lus__svg" viewBox="0 0 200 150" role="img" aria-label="Солнечное затмение: Солнце, Луна и Земля на одной прямой. Крайние лучи от краёв Солнца через края Луны сходятся, и тень Луны падает на Землю. Размеры и расстояния не в масштабе">
			<text class="lus-title" x="100" y="18" text-anchor="middle">Солнечное затмение</text>
			<circle class="lus-sun" cx="-6" cy="88" r="44"></circle>
			<line class="lus-ray" x1="20" y1="52" x2="176" y2="107.9"></line>
			<line class="lus-ray" x1="20" y1="124" x2="176" y2="68.1"></line>
			<line class="lus-ray" x1="20" y1="52" x2="169" y2="88"></line>
			<line class="lus-ray" x1="20" y1="124" x2="169" y2="88"></line>
			<path class="lus-umbra" d="M140 81 L169 88 L140 95 Z"></path>
			<circle class="lus-earth" cx="178" cy="88" r="22"></circle>
			<circle class="lus-moon" cx="140" cy="88" r="7"></circle>
			<circle class="lus-spot" cx="157" cy="88" r="2.6"></circle>
			<text class="lus-t" x="136" y="60" text-anchor="middle">Луна</text>
			<text class="lus-t" x="178" y="128" text-anchor="middle">Земля</text>
		</svg>

		<svg class="lus__svg" viewBox="0 0 200 150" role="img" aria-label="Узкий серп Луны вскоре после новолуния, а рядом с ним видна и тёмная часть лунного диска: её слабо освещает Земля">
			<text class="lus-title" x="100" y="18" text-anchor="middle">Пепельный свет</text>
			<rect class="lus-sky" x="8" y="26" width="184" height="118" rx="8"></rect>
			{[[30, 44], [168, 52], [48, 124], [160, 130], [140, 40], [24, 92]].map(([x, y]) => <circle class="lus-star" cx={x} cy={y} r="1"></circle>)}
			<circle class="lus-ashen" cx="100" cy="86" r="40"></circle>
			<path class="lus-crescent" d="M100 46 A40 40 0 0 1 100 126 A33 40 0 0 0 100 46 Z"></path>
		</svg>
	</div>
	<figcaption class="lus__cap">
		Фазы Луны в календаре повторяются через 29,5&nbsp;сут. В приливной электростанции вода проходит через турбину в
		плотине. При солнечном затмении тень Луны падает на Землю (размеры и расстояния не в масштабе, крайние лучи —
		штриховые). Пепельный свет — тёмную часть Луны слабо освещает Земля.
	</figcaption>
</figure>

<style is:global>
	.lus {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lus__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@media (max-width: 50rem) {
		.lus__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.5rem;
		}
	}
	.lus__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
	}
	.lus__cap {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.lus text {
		font-family: var(--__sl-font);
	}
	.lus .lus-title {
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.lus .lus-t {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	.lus-cell {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 50%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.lus-lit {
		fill: var(--ig-v);
	}
	.lus-unlit {
		fill: var(--sl-color-gray-4);
	}
	.lus-water {
		fill: color-mix(in srgb, var(--ig-vx) 40%, transparent);
	}
	.lus-wave {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.2;
	}
	.lus-dam {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.lus-tunnel {
		fill: color-mix(in srgb, var(--ig-vx) 40%, var(--sl-color-bg));
	}
	.lus-flow {
		stroke: var(--ig-vx);
		stroke-width: 1.6;
		stroke-dasharray: 4 6;
		animation: lus-flow 0.9s linear infinite;
	}
	@keyframes lus-flow {
		to {
			stroke-dashoffset: -10;
		}
	}
	.lus-turbine {
		fill: var(--ig-vy);
	}
	.lus-spin {
		transform-box: fill-box;
		transform-origin: center;
		animation: lus-spin 1.2s linear infinite;
	}
	@keyframes lus-spin {
		to {
			transform: rotate(360deg);
		}
	}
	.lus-wire {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.lus-gen {
		fill: var(--ig-v);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.lus-arrow {
		stroke: var(--ig-vx);
		stroke-width: 2.2;
	}
	.lus-head {
		fill: var(--ig-vx);
	}
	.lus-sun {
		fill: var(--ig-v);
	}
	.lus-ray {
		stroke: var(--ig-v);
		stroke-width: 1.1;
		stroke-dasharray: 4 3;
	}
	.lus-umbra {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 22%, transparent);
	}
	.lus-moon {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.lus-earth {
		fill: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-bg));
	}
	.lus-spot {
		fill: var(--sl-color-gray-1);
	}
	.lus-sky {
		fill: #0b1229;
	}
	.lus-star {
		fill: #f4f6ff;
		opacity: 0.8;
	}
	.lus-ashen {
		fill: #3b3f4e;
	}
	.lus-crescent {
		fill: #efe9d2;
	}
</style>
