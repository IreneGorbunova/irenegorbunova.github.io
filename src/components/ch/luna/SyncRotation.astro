---
/**
 * Why we always see one side of the Moon. Left: the Moon on its orbit seen from the north (counter-clockwise),
 * with a flag on the middle of the near side; the near half (with the dark seas) is shaded. Right: the Moon as
 * seen from the Earth — an orthographic globe with real positions of the main seas and far-side basins.
 * «Вращается»: one turn about its axis per orbit (the real Moon) — the flag always faces the Earth.
 * «Не вращается»: the Moon keeps its orientation in space — during a month the Earth sees all its sides.
 */
type F = [number, number, number, 'mare' | 'ring' | 'dark' | 'bright' | 'basin'];
// [longitude E, latitude N, angular radius (degrees), kind]
const features: F[] = [
	// near side seas (overlapping discs give the familiar «face»)
	[-58, 22, 14, 'mare'], [-55, 6, 13, 'mare'], [-66, -6, 9, 'mare'], [-45, 32, 10, 'mare'], [-40, 14, 10, 'mare'],
	[-30, 2, 8, 'mare'], [-50, 44, 7, 'mare'], [-16, 33, 14, 'mare'], [-26, 40, 8, 'mare'], [-5, 25, 7, 'mare'],
	[17, 28, 9.5, 'mare'], [30, 8, 10, 'mare'], [22, 4, 7, 'mare'], [40, 12, 6, 'mare'], [59, 17, 7, 'mare'],
	[51, -8, 9, 'mare'], [44, -2, 6, 'mare'], [35, -15, 5.5, 'mare'], [-17, -21, 9, 'mare'], [-10, -15, 6, 'mare'],
	[-23, -10, 6, 'mare'], [-39, -24, 5.5, 'mare'], [4, 13, 4.5, 'mare'], [-31, 7, 6, 'mare'],
	[-40, 54, 5, 'mare'], [-20, 56, 5, 'mare'], [0, 56, 5, 'mare'], [20, 57, 4.5, 'mare'],
	// bright young craters of the near side
	[-20, 9.6, 1.6, 'bright'], [-11, -43, 1.6, 'bright'], [-38, 8, 1.1, 'bright'],
	// far side: a giant old basin, a few dark spots and large rings
	[-169, -53, 28, 'basin'], [147, 27, 4, 'dark'], [129, -20, 3, 'dark'], [164, -34, 3, 'dark'],
	[-151, -36, 7, 'ring'], [-157, -4, 6, 'ring'], [-129, 2, 7, 'ring'], [-95, -20, 8, 'ring'],
];
// many craters on the far side (a fixed pseudo-random set)
let s = 7;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
for (let i = 0; i < 46; i++) {
	const L = 100 + rnd() * 160;
	const B = (rnd() * 2 - 1) * 68;
	features.push([L > 180 ? L - 360 : L, B, 1.4 + rnd() * 3, 'ring']);
}
for (let i = 0; i < 14; i++) {
	const L = (rnd() * 2 - 1) * 80;
	const B = (rnd() * 2 - 1) * 70;
	features.push([L, B, 1 + rnd() * 1.8, 'ring']);
}
const uid = Math.random().toString(36).slice(2, 8);
---

<figure class="lsr not-content" data-lsr data-features={JSON.stringify(features)}>
	<div class="lsr__grid">
		<div class="lsr__panel">
			<svg class="lsr__svg" viewBox="0 0 300 300" role="img" aria-label="Луна на орбите вокруг Земли, вид с севера">
				<defs>
					<radialGradient id={`lsr-earth-${uid}`} cx="40%" cy="40%" r="65%">
						<stop offset="0" stop-color="#9fd0ff" />
						<stop offset="0.6" stop-color="#3b82d6" />
						<stop offset="1" stop-color="#173a7a" />
					</radialGradient>
				</defs>
				<g class="lsr__stars">
					{
						[
							[20, 30], [60, 270], [280, 40], [270, 280], [30, 160], [290, 160], [150, 15], [150, 290], [90, 80], [215, 220], [80, 210], [230, 70],
						].map(([x, y]) => <circle cx={x} cy={y} r="0.9" />)
					}
				</g>
				<circle class="lsr__orbit" cx="150" cy="150" r="112" />
				<path class="lsr__arrow" d="M 262 150 m -4 -26 l 4 -9 l 4 9" />
				<line class="lsr__sight" data-sight x1="150" y1="150" x2="150" y2="150" />
				<circle cx="150" cy="150" r="24" fill={`url(#lsr-earth-${uid})`} />
				<text class="lsr__t" x="150" y="192" text-anchor="middle">Земля</text>
				<g data-moon>
					<circle class="lsr__far" r="20" />
					<path class="lsr__near" d="M 0 -20 A 20 20 0 0 1 0 20 Z" />
					<circle class="lsr__mare" cx="9" cy="-6" r="5" />
					<circle class="lsr__mare" cx="7" cy="8" r="4" />
					<circle class="lsr__crater" cx="-9" cy="5" r="2.5" />
					<circle class="lsr__crater" cx="-6" cy="-10" r="2" />
					<line class="lsr__pole" x1="19" y1="0" x2="31" y2="0" />
					<path class="lsr__flag" d="M 31 0 L 31 -7 L 24 -5 L 31 -3.5" />
				</g>
			</svg>
			<p class="lsr__label">Вид сверху, с севера</p>
		</div>
		<div class="lsr__panel lsr__panel--view">
			<svg class="lsr__svg lsr__svg--view" viewBox="0 0 160 160" role="img" aria-label="Луна, как её видно с Земли">
				<defs>
					<clipPath id={`lsr-disc-${uid}`}><circle cx="80" cy="80" r="66" /></clipPath>
					<radialGradient id={`lsr-shade-${uid}`} cx="50%" cy="50%" r="50%">
						<stop offset="0.7" stop-color="#000" stop-opacity="0" />
						<stop offset="1" stop-color="#000" stop-opacity="0.35" />
					</radialGradient>
				</defs>
				<circle class="lsr__disc" cx="80" cy="80" r="66" />
				<g clip-path={`url(#lsr-disc-${uid})`} data-globe></g>
				<circle cx="80" cy="80" r="66" fill={`url(#lsr-shade-${uid})`} />
				<g data-vflag>
					<line class="lsr__pole" x1="0" y1="0" x2="0" y2="-12" />
					<path class="lsr__flag" d="M 0 -12 L 8 -10 L 0 -7.5" />
					<circle class="lsr__flagfoot" r="1.6" />
				</g>
			</svg>
			<p class="lsr__label">Вид с Земли</p>
			<p class="lsr__far-share" data-share aria-live="polite"></p>
		</div>
	</div>
	<div class="lsr__bar">
		<div class="lsr__seg" role="group" aria-label="Вращение Луны">
			<button type="button" class="lsr__opt" data-mode="spin" aria-pressed="true">Вращается вокруг своей оси</button>
			<button type="button" class="lsr__opt" data-mode="still" aria-pressed="false">Не вращается</button>
		</div>
		<button type="button" class="lsr__btn" data-pause>Пауза</button>
	</div>
	<p class="lsr__msg" data-msg aria-live="polite"></p>
	<figcaption class="lsr__caption">
		Луна обходит Землю против часовой стрелки за 27,3 сут; здесь — за 14 с. Флажок стоит в середине видимой с
		Земли стороны. Справа — те же моря и кратеры, что на настоящей Луне; освещение Солнцем не показано.
	</figcaption>
</figure>

<style is:global>
	.lsr {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lsr__grid {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: 0.75rem;
		align-items: center;
	}
	.lsr__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.7rem;
		background: radial-gradient(circle at 50% 50%, #0b1433, #02030a 75%);
	}
	.lsr__svg--view {
		background: radial-gradient(circle at 50% 50%, #0a0f24, #02030a 80%);
	}
	.lsr__label {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.lsr__far-share {
		margin: 0.4rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.lsr__far-share b {
		color: var(--sl-color-white);
	}
	.lsr__stars circle {
		fill: rgb(225 232 255 / 0.75);
	}
	.lsr__orbit {
		fill: none;
		stroke: rgb(180 195 255 / 0.35);
		stroke-dasharray: 3 4;
	}
	.lsr__arrow {
		fill: none;
		stroke: rgb(180 195 255 / 0.7);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.lsr__sight {
		stroke: rgb(255 233 176 / 0.45);
		stroke-dasharray: 2 3;
	}
	.lsr__t {
		fill: rgb(235 238 255 / 0.88);
		font-size: 16px;
		font-family: var(--sl-font);
	}
	.lsr__far {
		fill: #d9d7cf;
	}
	.lsr__near {
		fill: #b4b2aa;
	}
	.lsr__mare {
		fill: #6e6d68;
	}
	.lsr__crater {
		fill: none;
		stroke: #9a988f;
		stroke-width: 0.8;
	}
	.lsr__pole {
		stroke: #f2f2f2;
		stroke-width: 1.2;
	}
	.lsr__flag {
		fill: #ff5d5d;
	}
	.lsr__flagfoot {
		fill: #ff5d5d;
	}
	.lsr__disc {
		fill: #d8d6ce;
	}
	.lsr__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.7rem;
	}
	.lsr__seg {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.lsr__opt,
	.lsr__btn {
		margin: 0;
		padding: 0.35rem 0.9rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.lsr__opt:hover,
	.lsr__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.lsr__opt[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.lsr__msg {
		min-height: 3em;
		margin: 0.6rem 0 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.lsr__msg b {
		color: var(--sl-color-white);
	}
	.lsr__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.lsr {
			padding: 0.5rem;
		}
		.lsr__grid {
			gap: 0.4rem;
		}
		.lsr__opt,
		.lsr__btn {
			font-size: var(--sl-text-xs);
			padding: 0.35rem 0.7rem;
		}
	}
</style>

<script>
	import { fmt, loop, attrs, TAU } from './util';

	const T_SID = 27.32166;
	const SECONDS_PER_ORBIT = 14;
	const NS = 'http://www.w3.org/2000/svg';
	const D = Math.PI / 180;
	const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));

	for (const root of document.querySelectorAll<HTMLElement>('[data-lsr]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const feats = JSON.parse(root.dataset.features!) as [number, number, number, string][];
		const moon = q<SVGGElement>('[data-moon]');
		const sight = q<SVGLineElement>('[data-sight]');
		const globe = q<SVGGElement>('[data-globe]');
		const vflag = q<SVGGElement>('[data-vflag]');
		const share = q<HTMLElement>('[data-share]');
		const msg = q<HTMLElement>('[data-msg]');
		const pause = q<HTMLButtonElement>('[data-pause]');
		const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode]'));

		// the globe: one ellipse per feature, drawn far-side-basin first
		const style: Record<string, Record<string, string>> = {
			mare: { fill: '#6f6e68' },
			basin: { fill: '#b9b7af' },
			dark: { fill: '#86857e' },
			bright: { fill: '#f6f5ef' },
			ring: { fill: 'none', stroke: '#a8a69e', 'stroke-width': '0.9' },
		};
		const els = feats.map(([, , , kind]) => {
			const e = document.createElementNS(NS, 'ellipse');
			attrs(e, style[kind]);
			globe.append(e);
			return e;
		});

		let alpha = 0; // the Moon's place on its orbit, radians from the +x axis (counter-clockwise)
		let spin = true;
		let psi = Math.PI; // the direction of the near side's middle in space
		let offset = 0; // after switching back to spinning the Moon turns its near side to the Earth again
		let running = true;
		let days = 0;

		const view = () => {
			// the longitude on the Moon that faces the Earth
			const toEarth = alpha + Math.PI;
			const lam = wrap(toEarth - psi);
			for (let i = 0; i < feats.length; i++) {
				const [L, B, r] = feats[i];
				const dl = L * D - lam;
				const cb = Math.cos(B * D);
				const x = cb * Math.sin(dl);
				const y = Math.sin(B * D);
				const cr = cb * Math.cos(dl); // cosine of the angle from the middle of the visible disc
				const e = els[i];
				if (cr <= 0) {
					e.setAttribute('visibility', 'hidden');
					continue;
				}
				e.setAttribute('visibility', 'visible');
				const px = 80 + 66 * x;
				const py = 80 - 66 * y;
				const rp = 66 * Math.sin(r * D);
				const ang = (Math.atan2(-y, x) * 180) / Math.PI;
				attrs(e, { cx: px, cy: py, rx: Math.max(0.2, rp * cr), ry: rp, transform: `rotate(${ang} ${px} ${py})`, opacity: Math.min(1, cr / 0.12) });
			}
			// the flag at longitude 0, latitude 0
			const fx = Math.sin(-lam);
			const fc = Math.cos(-lam);
			vflag.setAttribute('transform', `translate(${80 + 66 * fx} 80)`);
			vflag.style.opacity = fc > 0 ? String(Math.min(1, fc / 0.12)) : '0';
			// how much of the far hemisphere (centred on longitude 180°) faces the Earth
			const gamma = Math.abs(wrap(lam - Math.PI));
			const pct = Math.round((1 - gamma / Math.PI) * 100);
			share.innerHTML = `Видно обратной стороны: <b>${pct} %</b>`;
		};
		const draw = () => {
			const mx = 150 + 112 * Math.cos(alpha);
			const my = 150 - 112 * Math.sin(alpha);
			moon.setAttribute('transform', `translate(${mx} ${my}) rotate(${(-psi * 180) / Math.PI})`);
			attrs(sight, { x2: mx, y2: my });
			view();
			const part = `Прошло <b>${fmt(days % T_SID, 1)} сут</b> из ${fmt(T_SID, 1)}.`;
			msg.innerHTML = spin
				? `${part} Луна поворачивается вокруг своей оси с тем же периодом, с каким обходит Землю. Флажок всё время смотрит на Землю, и мы видим одну и ту же сторону.`
				: `${part} Луна не поворачивается: флажок всё время смотрит в одну сторону пространства. Тогда за месяц с Земли была бы видна вся Луна — и обратная сторона тоже.`;
		};
		loop(root, (dt) => {
			if (running) {
				const dA = (dt / SECONDS_PER_ORBIT) * TAU;
				alpha = (alpha + dA) % TAU;
				days += (dt / SECONDS_PER_ORBIT) * T_SID;
			}
			if (spin) {
				offset *= Math.exp(-dt * 3);
				if (Math.abs(offset) < 1e-3) offset = 0;
				psi = alpha + Math.PI + offset;
			}
			draw();
		});
		for (const b of opts)
			b.addEventListener('click', () => {
				const s = b.dataset.mode === 'spin';
				if (s === spin) return;
				spin = s;
				if (spin) offset = wrap(psi - alpha - Math.PI);
				opts.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
				draw();
			});
		pause.addEventListener('click', () => {
			running = !running;
			pause.textContent = running ? 'Пауза' : 'Пуск';
		});
		draw();
	}
</script>
