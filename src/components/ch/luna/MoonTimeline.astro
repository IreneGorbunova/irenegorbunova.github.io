---
/**
 * A light timeline of Moon exploration: chips with the year and the mission, the chosen one opens a card.
 * Dates checked (Nov 2026) against Wikipedia articles of each mission and NASA's Artemis II pages.
 */
const events = [
	{ y: 1959, name: '«Луна-2»', who: 'СССР', date: '14 сентября 1959 г.', text: 'Первый аппарат, который долетел до Луны: станция упала на её поверхность восточнее Моря Дождей и доставила туда вымпелы с гербом СССР.' },
	{ y: 1959, name: '«Луна-3»', who: 'СССР', date: '7 октября 1959 г.', text: 'Облетела Луну и впервые сфотографировала её обратную сторону: 29 снимков, на которых видно около 70 % этой стороны. Оказалось, что морей там почти нет.' },
	{ y: 1966, name: '«Луна-9»', who: 'СССР', date: '3 февраля 1966 г.', text: 'Первая мягкая посадка на Луну — в Океане Бурь — и первые панорамы с её поверхности. Стало ясно, что грунт держит аппарат и не похож на глубокий слой пыли, в котором, как опасались, всё утонет.' },
	{ y: 1968, name: '«Аполлон-8»', who: 'США', date: '24–25 декабря 1968 г.', text: 'Фрэнк Борман, Джеймс Ловелл и Уильям Андерс — первые люди, которые облетели Луну: корабль сделал вокруг неё 10 витков. Андерс снял знаменитый «Восход Земли».' },
	{ y: 1969, name: '«Аполлон-11»', who: 'США', date: '20 июля 1969 г.', text: 'Лунный модуль сел в Море Спокойствия. Нил Армстронг и Базз Олдрин вышли на поверхность (по всемирному времени было уже 21 июля), Майкл Коллинз ждал их на орбите. Астронавты привезли 21,5 кг лунных пород и оставили уголковый отражатель для лазерной локации.' },
	{ y: 1970, name: '«Луна-16»', who: 'СССР', date: '20–24 сентября 1970 г.', text: 'Автоматическая станция сама взяла пробу грунта в Море Изобилия и вернула на Землю 101 г лунного вещества — впервые без людей.' },
	{ y: 1970, name: '«Луноход-1»', who: 'СССР', date: '17 ноября 1970 г.', text: 'Первый планетоход: его доставила станция «Луна-17» в Море Дождей. Луноходом управляли с Земли; за 10 месяцев он проехал около 10,5 км. На нём тоже стоял уголковый отражатель.' },
	{ y: 1972, name: '«Аполлон-17»', who: 'США', date: '11–14 декабря 1972 г.', text: 'Юджин Сернан и Харрисон Шмитт — пока последние люди, ходившие по Луне. Всего в 1969–1972 годах на Луне побывали 12 астронавтов.' },
	{ y: 2019, name: '«Чанъэ-4»', who: 'Китай', date: '3 января 2019 г.', text: 'Первая мягкая посадка на обратной стороне Луны, в кратере фон Карман; луноход «Юйту-2». С обратной стороны Земли не видно, поэтому связь шла через спутник-ретранслятор «Цюэцяо».' },
	{ y: 2023, name: '«Чандраян-3»', who: 'Индия', date: '23 августа 2023 г.', text: 'Первая посадка недалеко от южного полюса Луны. Там, в вечно затенённых кратерах, надеются найти водяной лёд.' },
	{ y: 2024, name: '«Чанъэ-6»', who: 'Китай', date: 'июнь 2024 г.', text: 'Аппарат сел в бассейне Аполлон на обратной стороне Луны и 25 июня 2024 года доставил на Землю 1935\u00a0г грунта — первые образцы с обратной стороны.' },
	{ y: 2026, name: '«Артемида-2»', who: 'США, Канада', date: '1–10 апреля 2026 г.', text: 'Рид Уайзман, Виктор Гловер, Кристина Кок и канадец Джереми Хансен облетели Луну — впервые с 1972 года люди снова у Луны. Корабль удалился от Земли на 406\u00a0771\u00a0км — дальше, чем любые люди до них.' },
];
---

<figure class="ltm not-content" data-ltm>
	<div class="ltm__eras">
		<div class="ltm__era">
			<p class="ltm__era-name">Первые шаги, 1959–1972</p>
			<div class="ltm__chips" role="group" aria-label="События 1959–1972">
				{
					events.slice(0, 8).map((e, i) => (
						<button type="button" class="ltm__chip" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>
							<span class="ltm__year">{e.y}</span> {e.name}
						</button>
					))
				}
			</div>
		</div>
		<p class="ltm__gap">почти полвека люди не летали к Луне</p>
		<div class="ltm__era">
			<p class="ltm__era-name">Возвращение, 2019–2026</p>
			<div class="ltm__chips" role="group" aria-label="События 2019–2026">
				{
					events.slice(8).map((e, i) => (
						<button type="button" class="ltm__chip" data-i={i + 8} aria-pressed="false">
							<span class="ltm__year">{e.y}</span> {e.name}
						</button>
					))
				}
			</div>
		</div>
	</div>
	<div class="ltm__card" aria-live="polite">
		{
			events.map((e, i) => (
				<div class="ltm__item" data-item={i} hidden={i !== 0}>
					<p class="ltm__title">
						{e.name} <span class="ltm__who">{e.who}</span>
					</p>
					<p class="ltm__date">{e.date}</p>
					<p class="ltm__text">{e.text}</p>
				</div>
			))
		}
		<div class="ltm__nav">
			<button type="button" class="ltm__arrow" data-step="-1" aria-label="Предыдущее событие">←</button>
			<span class="ltm__count" data-count>1 из {events.length}</span>
			<button type="button" class="ltm__arrow" data-step="1" aria-label="Следующее событие">→</button>
		</div>
	</div>
</figure>

<style is:global>
	.ltm {
		margin-block: 1.5rem;
		padding: 0.85rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.ltm__era-name {
		margin: 0 0 0.35rem;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--sl-color-gray-3);
	}
	.ltm__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.ltm__chip {
		margin: 0;
		padding: 0.3rem 0.75rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.ltm__chip:hover {
		border-color: var(--sl-color-accent);
	}
	.ltm__chip[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.ltm__year {
		color: var(--sl-color-text-accent);
		font-variant-numeric: tabular-nums;
	}
	.ltm__gap {
		position: relative;
		margin: 0.7rem 0;
		padding-left: 1.4rem;
		font-size: var(--sl-text-xs);
		font-style: italic;
		color: var(--sl-color-gray-3);
	}
	.ltm__gap::before {
		content: '';
		position: absolute;
		left: 0.45rem;
		top: -0.4rem;
		bottom: -0.4rem;
		border-left: 2px dotted var(--sl-color-gray-4);
	}
	.ltm__card {
		margin-top: 0.85rem;
		padding: 0.75rem 0.9rem 0.5rem;
		border-radius: 0.8rem;
		background: radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--sl-color-accent-high) 12%, transparent), transparent 14rem),
			var(--sl-color-gray-6);
	}
	.ltm__title {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.ltm__who {
		margin-left: 0.3rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-gray-3);
	}
	.ltm__date {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.ltm__text {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.ltm__nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-top: 0.4rem;
	}
	.ltm__arrow {
		margin: 0;
		width: 2rem;
		height: 2rem;
		font: inherit;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 50%;
		cursor: pointer;
	}
	.ltm__arrow:hover {
		border-color: var(--sl-color-accent);
	}
	.ltm__count {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-ltm]')) {
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-i]'));
		const items = Array.from(root.querySelectorAll<HTMLElement>('[data-item]'));
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		let cur = 0;
		const show = (i: number) => {
			cur = (i + items.length) % items.length;
			chips.forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.i) === cur)));
			items.forEach((it, k) => (it.hidden = k !== cur));
			count.textContent = `${cur + 1} из ${items.length}`;
		};
		chips.forEach((c) => c.addEventListener('click', () => show(Number(c.dataset.i))));
		root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(cur + Number(b.dataset.step))));
	}
</script>
