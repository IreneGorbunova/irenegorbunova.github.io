---
/**
 * Sidereal and synodic month, seen from the north of the ecliptic: the Earth goes round the Sun (365,26 сут)
 * and the Moon round the Earth (27,32 сут), both counter-clockwise. At t = 0 it is full moon.
 * After one sidereal month the Moon points at the same far star again; full moon comes 2,2 сут later.
 * Angles and periods are real; sizes and the Moon's distance are enlarged (said in the caption).
 */
const SX = 40;
const SY = 285;
const R = 250; // the Earth's orbit
const TH0 = 12; // the Earth's starting angle, degrees
const arc = (a: number, b: number) => {
	const p = (d: number) => [SX + R * Math.cos((d * Math.PI) / 180), SY - R * Math.sin((d * Math.PI) / 180)];
	const [x1, y1] = p(a);
	const [x2, y2] = p(b);
	return `M ${x1} ${y1} A ${R} ${R} 0 0 0 ${x2} ${y2}`;
};
---

<figure class="lml not-content" data-lml data-sx={SX} data-sy={SY} data-r={R} data-th0={TH0}>
	<svg class="lml__svg" viewBox="0 0 400 300" role="img" aria-label="Земля обходит Солнце, Луна обходит Землю: звёздный и синодический месяц">
		<g class="lml__stars">
			{
				[
					[150, 20], [210, 60], [330, 30], [380, 120], [300, 160], [360, 250], [250, 280], [120, 140], [70, 60], [20, 20], [190, 190], [340, 200], [100, 230],
				].map(([x, y]) => <circle cx={x} cy={y} r="0.8" />)
			}
		</g>
		<circle class="lml__sunglow" cx={SX} cy={SY} r="34" />
		<circle class="lml__sun" cx={SX} cy={SY} r="14" />
		<text class="lml__t" x={SX + 4} y={SY - 22}>Солнце</text>
		<path class="lml__orbit" d={arc(2, 84)} />
		<path class="lml__track" data-track d="" />
		<path class="lml__wedge" data-wedge d="" />
		<text class="lml__t lml__t--angle" data-angle x="0" y="0"></text>
		<!-- the starting place -->
		<g class="lml__ghost" data-ghost>
			<circle data-ghost-orbit r="36" />
			<circle data-ghost-earth r="4" />
		</g>
		<!-- directions -->
		<line class="lml__dir lml__dir--star" data-star-line />
		<line class="lml__dir lml__dir--star" data-star-line0 />
		<path class="lml__starglyph" data-star-glyph d="M0 -5 L1.3 -1.3 L5 0 L1.3 1.3 L0 5 L-1.3 1.3 L-5 0 L-1.3 -1.3 Z" />
		<path class="lml__starglyph" transform="translate(268 20)" d="M0 -5 L1.3 -1.3 L5 0 L1.3 1.3 L0 5 L-1.3 1.3 L-5 0 L-1.3 -1.3 Z" />
		<text class="lml__t lml__t--star" x="278" y="24.5">далёкая звезда</text>
		<line class="lml__dir lml__dir--sun" data-sun-line />
		<!-- marks left where the months end -->
		<g data-marks></g>
		<!-- the Earth and the Moon -->
		<circle class="lml__morbit" data-morbit r="36" />
		<g data-earth>
			<circle class="lml__night" r="7" />
			<path class="lml__earth" d="M 0 -7 A 7 7 0 0 1 0 7 Z" />
		</g>
		<g data-moon>
			<circle class="lml__night" r="4.6" />
			<path class="lml__moon" d="M 0 -4.6 A 4.6 4.6 0 0 1 0 4.6 Z" />
		</g>
	</svg>
	<div class="lml__bar">
		<button type="button" class="lml__play" data-play>Пуск</button>
		<button type="button" class="lml__btn" data-reset>Заново</button>
		<span class="lml__time">Прошло <b data-days>0,00</b> сут</span>
	</div>
	<label class="lml__slider">
		<span class="lml__slider-name">Время</span>
		<input type="range" min="0" max="59.06" step="0.01" value="0" data-t aria-label="Время в сутках" />
	</label>
	<p class="lml__msg" data-msg aria-live="polite"></p>
	<figcaption class="lml__caption">
		Вид с севера: Земля и Луна движутся против часовой стрелки. Периоды и углы настоящие, а размеры тел и
		расстояние от Земли до Луны увеличены во много раз. Голубой пунктир — направление на далёкую звезду, жёлтый —
		продолжение линии Солнце — Земля. Светлая половина Луны и Земли — та, на которую падает свет Солнца.
	</figcaption>
</figure>

<style is:global>
	.lml {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lml i {
		font-family: var(--ig-font-math);
	}
	.lml__svg {
		display: block;
		width: 100%;
		max-width: 40rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.7rem;
		background: radial-gradient(circle at 10% 95%, #2a1c08, #050816 45%, #02030a);
	}
	.lml__stars circle {
		fill: rgb(225 232 255 / 0.75);
	}
	.lml__sun {
		fill: #ffd66b;
	}
	.lml__sunglow {
		fill: #ffd66b;
		opacity: 0.18;
	}
	.lml__t {
		fill: rgb(235 238 255 / 0.88);
		font-size: 13px;
		font-family: var(--sl-font);
	}
	.lml__t--angle {
		fill: #ffe39a;
	}
	.lml__t--star {
		fill: #cfe0ff;
		font-size: 12px;
	}
	.lml__orbit {
		fill: none;
		stroke: rgb(180 195 255 / 0.35);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.lml__track {
		fill: none;
		stroke: #6fa8ff;
		stroke-width: 2;
	}
	.lml__wedge {
		fill: rgb(255 214 107 / 0.1);
		stroke: rgb(255 214 107 / 0.45);
		stroke-width: 0.8;
	}
	.lml__ghost circle {
		fill: none;
		stroke: rgb(180 195 255 / 0.3);
		stroke-dasharray: 2 3;
	}
	.lml__morbit {
		fill: none;
		stroke: rgb(220 220 230 / 0.35);
		stroke-width: 0.8;
	}
	.lml__dir {
		stroke-width: 1.1;
		stroke-dasharray: 4 3;
	}
	.lml__dir--star {
		stroke: #9fc0ff;
	}
	.lml__dir--sun {
		stroke: #ffd66b;
		opacity: 0.8;
	}
	.lml__starglyph {
		fill: #e6eeff;
	}
	.lml__night {
		fill: #2b2f3d;
	}
	.lml__earth {
		fill: #6fa8ff;
	}
	.lml__moon {
		fill: #ecebe4;
	}
	.lml__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 0.7rem;
	}
	.lml__play,
	.lml__btn {
		margin: 0;
		padding: 0.35rem 1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		border-radius: 999px;
		cursor: pointer;
	}
	.lml__play {
		color: var(--sl-color-black);
		background: var(--sl-color-accent-high);
		border: 1px solid var(--sl-color-accent-high);
	}
	.lml__btn {
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
	}
	.lml__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.lml__time {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.lml__time b {
		color: var(--sl-color-white);
	}
	.lml__slider {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.lml__slider input {
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.lml__msg {
		min-height: 3em;
		margin: 0.6rem 0 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.lml__msg b {
		color: var(--sl-color-white);
	}
	.lml__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.lml {
			padding: 0.5rem;
		}
	}
</style>

<script>
	import { fmt, loop, attrs } from './util';

	const T_SID = 27.32166;
	const T_YEAR = 365.256;
	const S = 1 / (1 / T_SID - 1 / T_YEAR); // 29,53 сут
	const T_MAX = 2 * S;
	const SPEED = 4; // days per second
	const RM = 36; // the Moon's orbit on the picture

	for (const root of document.querySelectorAll<HTMLElement>('[data-lml]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const SX = Number(root.dataset.sx);
		const SY = Number(root.dataset.sy);
		const R = Number(root.dataset.r);
		const TH0 = (Number(root.dataset.th0) * Math.PI) / 180;
		const play = q<HTMLButtonElement>('[data-play]');
		const reset = q<HTMLButtonElement>('[data-reset]');
		const days = q<HTMLElement>('[data-days]');
		const slider = q<HTMLInputElement>('[data-t]');
		const msg = q<HTMLElement>('[data-msg]');
		const track = q<SVGPathElement>('[data-track]');
		const wedge = q<SVGPathElement>('[data-wedge]');
		const angleText = q<SVGTextElement>('[data-angle]');
		const earth = q<SVGGElement>('[data-earth]');
		const moon = q<SVGGElement>('[data-moon]');
		const morbit = q<SVGCircleElement>('[data-morbit]');
		const starLine = q<SVGLineElement>('[data-star-line]');
		const starLine0 = q<SVGLineElement>('[data-star-line0]');
		const starGlyph = q<SVGPathElement>('[data-star-glyph]');
		const sunLine = q<SVGLineElement>('[data-sun-line]');
		const marks = q<SVGGElement>('[data-marks]');
		const NS = 'http://www.w3.org/2000/svg';

		const E = (t: number) => {
			const a = TH0 + (2 * Math.PI * t) / T_YEAR;
			return { a, x: SX + R * Math.cos(a), y: SY - R * Math.sin(a) };
		};
		const e0 = E(0);
		attrs(q('[data-ghost-orbit]'), { cx: e0.x, cy: e0.y });
		attrs(q('[data-ghost-earth]'), { cx: e0.x, cy: e0.y });

		let t = 0;
		let running = false;
		const stops = [T_SID, S, T_SID * 2, T_MAX];
		let nextStop = 0;

		const lit = (g: SVGGElement, x: number, y: number) => {
			const deg = (Math.atan2(SY - y, SX - x) * 180) / Math.PI;
			g.setAttribute('transform', `translate(${x} ${y}) rotate(${deg})`);
		};
		const mark = (tm: number, label: string) => {
			const e = E(tm);
			const ph = TH0 + (2 * Math.PI * tm) / T_SID;
			const x = e.x + RM * Math.cos(ph);
			const y = e.y - RM * Math.sin(ph);
			const c = document.createElementNS(NS, 'circle');
			attrs(c, { cx: x, cy: y, r: 2.4, fill: 'none', stroke: tm === S || tm === T_MAX ? '#ffd66b' : '#9fc0ff', 'stroke-width': 1.2 });
			// the label goes to the side of the line through the Moon: below for the sidereal, above for the synodic month
			const side = tm === S || tm === T_MAX ? -1 : 1;
			const tx = document.createElementNS(NS, 'text');
			attrs(tx, { x: x + side * 11 * Math.sin(ph), y: y + side * 11 * Math.cos(ph) + 3, class: 'lml__t', 'text-anchor': side > 0 ? 'start' : 'end' });
			tx.setAttribute('style', 'font-size:12px');
			tx.textContent = label;
			marks.append(c, tx);
		};
		const message = () => {
			const near = (v: number) => Math.abs(t - v) < 0.005;
			if (near(T_SID))
				msg.innerHTML = `<b>Прошёл звёздный месяц — ${fmt(T_SID, 2)} сут.</b> Луна снова на одной прямой с Землёй и той же далёкой звездой: относительно звёзд она сделала полный оборот. Но Земля за это время ушла по орбите на ${fmt((360 * T_SID) / T_YEAR, 0)}°, Солнце светит на Луну сбоку — полнолуния ещё нет.`;
			else if (near(S))
				msg.innerHTML = `<b>Прошёл синодический месяц — ${fmt(S, 2)} сут.</b> Луна снова на продолжении линии Солнце — Земля: снова полнолуние. Чтобы догнать это направление, ей понадобилось ещё ${fmt(S - T_SID, 1)} сут.`;
			else if (t >= T_MAX - 0.005)
				msg.innerHTML = `Прошло два синодических месяца — ${fmt(T_MAX, 2)} сут, и снова полнолуние. Нажмите «Заново», чтобы повторить.`;
			else if (t < T_SID)
				msg.innerHTML = 'В начале — полнолуние: Луна на продолжении линии Солнце — Земля и на одной прямой с далёкой звездой. Луна обходит Землю, а Земля тем временем движется вокруг Солнца.';
			else if (t < S) msg.innerHTML = 'Луна уже прошла направление на звезду и догоняет линию Солнце — Земля.';
			else msg.innerHTML = `Звёздный месяц — ${fmt(T_SID, 2)} сут, синодический — ${fmt(S, 2)} сут.`;
		};
		const draw = () => {
			const e = E(t);
			const ph = TH0 + (2 * Math.PI * t) / T_SID;
			const mx = e.x + RM * Math.cos(ph);
			const my = e.y - RM * Math.sin(ph);
			lit(earth, e.x, e.y);
			lit(moon, mx, my);
			attrs(morbit, { cx: e.x, cy: e.y });
			// the track of the Earth and the swept angle at the Sun
			const big = e.a - TH0 > Math.PI ? 1 : 0;
			track.setAttribute('d', t > 0 ? `M ${e0.x} ${e0.y} A ${R} ${R} 0 ${big} 0 ${e.x} ${e.y}` : '');
			const rw = 70;
			wedge.setAttribute(
				'd',
				t > 0.2
					? `M ${SX} ${SY} L ${SX + rw * Math.cos(TH0)} ${SY - rw * Math.sin(TH0)} A ${rw} ${rw} 0 0 0 ${SX + rw * Math.cos(e.a)} ${SY - rw * Math.sin(e.a)} Z`
					: '',
			);
			const mid = (TH0 + e.a) / 2;
			attrs(angleText, { x: SX + (rw + 6) * Math.cos(mid), y: SY - (rw + 6) * Math.sin(mid) + 4 });
			angleText.textContent = t > 0.2 ? `${fmt(((e.a - TH0) * 180) / Math.PI, 0)}°` : '';
			// the direction to a far star is the same from everywhere (parallel lines)
			const L = 62;
			const ux = Math.cos(TH0);
			const uy = -Math.sin(TH0);
			attrs(starLine, { x1: e.x, y1: e.y, x2: e.x + L * ux, y2: e.y + L * uy });
			attrs(starLine0, { x1: e0.x, y1: e0.y, x2: e0.x + L * ux, y2: e0.y + L * uy });
			starLine0.style.opacity = t > 0.5 ? '0.45' : '0';
			const gx = e.x + (L + 6) * ux;
			const gy = e.y + (L + 6) * uy;
			starGlyph.setAttribute('transform', `translate(${gx} ${gy})`);
			// the line Sun → Earth, continued past the Earth: full moon when the Moon is on it
			const sx = (e.x - SX) / R;
			const sy = (e.y - SY) / R;
			attrs(sunLine, { x1: e.x, y1: e.y, x2: e.x + L * sx, y2: e.y + L * sy });
			days.textContent = fmt(t, 2);
			slider.value = String(t);
			message();
		};
		const setRunning = (v: boolean) => {
			running = v;
			play.textContent = v ? 'Пауза' : t >= T_MAX - 0.005 ? 'Пуск' : t > 0 ? 'Дальше' : 'Пуск';
		};
		const rebuildMarks = () => {
			marks.replaceChildren();
			if (t >= T_SID - 1e-6) mark(T_SID, '27,32 сут');
			if (t >= S - 1e-6) mark(S, '29,53 сут');
			nextStop = stops.findIndex((v) => v > t + 1e-6);
			if (nextStop < 0) nextStop = stops.length;
		};
		loop(root, (dt) => {
			if (!running) return;
			let nt = t + dt * SPEED;
			if (nextStop < stops.length && nt >= stops[nextStop]) {
				nt = stops[nextStop];
				t = nt;
				if (t === T_SID) mark(T_SID, '27,32 сут');
				if (t === S) mark(S, '29,53 сут');
				nextStop += 1;
				// pause at the end of the first sidereal and synodic months and at the end
				if (t === T_SID || t === S || t === T_MAX) setRunning(false);
			}
			t = nt;
			draw();
		});
		play.addEventListener('click', () => {
			if (!running && t >= T_MAX - 0.005) {
				t = 0;
				rebuildMarks();
			}
			setRunning(!running);
			draw();
		});
		reset.addEventListener('click', () => {
			t = 0;
			rebuildMarks();
			setRunning(false);
			draw();
		});
		slider.addEventListener('input', () => {
			t = Number(slider.value);
			// snap to the month ends so that their explanations can be read
			for (const v of [T_SID, S, T_MAX]) if (Math.abs(t - v) < 0.25) t = v;
			rebuildMarks();
			setRunning(false);
			draw();
		});
		draw();
	}
</script>
