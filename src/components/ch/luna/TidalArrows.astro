---
/**
 * Why there are two tidal bulges. «Притяжение Луны»: the Moon's pull (per kilogram) at the near side, the centre
 * and the far side of the Earth — the nearer, the stronger. «Относительно центра Земли»: the same minus the pull
 * on the centre: water on the near side is pulled ahead of the Earth, the Earth is pulled away from the water on
 * the far side, and at the sides the water is pressed in. The differences are enlarged (really ±3 % of the pull).
 */
const uid = Math.random().toString(36).slice(2, 8);
const O = { x: 120, y: 95 };
const R = 56;
---

<figure class="lta not-content" data-lta>
	<svg class="lta__svg" viewBox="0 0 360 190" role="img" aria-label="Притяжение Луны в разных точках Земли">
		<defs>
			<marker id={`lta-head-${uid}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="#ffd66b" />
			</marker>
		</defs>
		<ellipse class="lta__water" data-water cx={O.x} cy={O.y} rx={R + 4} ry={R + 4} />
		<circle class="lta__earth" cx={O.x} cy={O.y} r={R} />
		<circle class="lta__moon" cx="330" cy={O.y} r="13" />
		<text class="lta__t" x="330" y={O.y + 30} text-anchor="middle">Луна</text>
		<g data-arrows marker-end={`url(#lta-head-${uid})`}>
			<line class="lta__arr" data-a="near" />
			<line class="lta__arr" data-a="centre" />
			<line class="lta__arr" data-a="far" />
			<line class="lta__arr" data-a="top" />
			<line class="lta__arr" data-a="bottom" />
		</g>
		<g class="lta__dots">
			<circle cx={O.x + R} cy={O.y} r="2.4" />
			<circle cx={O.x} cy={O.y} r="2.4" />
			<circle cx={O.x - R} cy={O.y} r="2.4" />
			<circle cx={O.x} cy={O.y - R} r="2.4" />
			<circle cx={O.x} cy={O.y + R} r="2.4" />
		</g>
		<text class="lta__t lta__t--s" x={O.x + R - 4} y={O.y + 16} text-anchor="end">A</text>
		<text class="lta__t lta__t--s" x={O.x - 4} y={O.y + 16} text-anchor="end">O</text>
		<text class="lta__t lta__t--s" x={O.x - R + 6} y={O.y + 16}>B</text>
	</svg>
	<div class="lta__seg" role="group" aria-label="Что показать">
		<button type="button" class="lta__opt" data-mode="abs" aria-pressed="true">Притяжение Луны</button>
		<button type="button" class="lta__opt" data-mode="rel" aria-pressed="false">Относительно центра Земли</button>
	</div>
	<p class="lta__msg" data-msg aria-live="polite"></p>
	<figcaption class="lta__caption">
		Стрелки — ускорения, которые Луна сообщает воде и Земле. Разница между ними сильно увеличена: на самом деле
		притяжение в точке A всего на 3 % больше, чем в центре O.
	</figcaption>
</figure>

<style is:global>
	.lta {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lta__svg {
		display: block;
		width: 100%;
		max-width: 36rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.7rem;
		background: radial-gradient(circle at 30% 50%, #0b1433, #02030a 75%);
	}
	.lta__water {
		fill: rgb(80 160 255 / 0.35);
		stroke: rgb(140 200 255 / 0.7);
		stroke-width: 1;
		transition:
			rx 0.6s,
			ry 0.6s;
	}
	.lta__earth {
		fill: #2f6a4f;
		stroke: #5aa57f;
		stroke-width: 1;
	}
	.lta__moon {
		fill: #dcdad2;
	}
	.lta__arr {
		stroke: #ffd66b;
		stroke-width: 2.4;
		stroke-linecap: round;
		transition: all 0.6s;
	}
	.lta__dots circle {
		fill: #fff;
	}
	.lta__t {
		fill: rgb(235 238 255 / 0.9);
		font-size: 12px;
		font-family: var(--sl-font);
	}
	.lta__t--s {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 13px;
	}
	.lta__seg {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.7rem;
	}
	.lta__opt {
		margin: 0;
		padding: 0.35rem 0.9rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.lta__opt:hover {
		border-color: var(--sl-color-accent);
	}
	.lta__opt[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.lta__msg {
		min-height: 3em;
		margin: 0.6rem 0 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.lta__msg b {
		color: var(--sl-color-white);
	}
	.lta__msg i {
		font-family: var(--ig-font-math);
	}
	.lta__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.lta {
			padding: 0.5rem;
		}
	}
</style>

<script>
	import { attrs } from './util';

	const O = { x: 120, y: 95 };
	const R = 56;
	// arrow vectors [dx, dy] in the two modes (lengths in px, the differences exaggerated)
	const ABS: Record<string, [number, number, number, number]> = {
		near: [O.x + R, O.y, 66, 0],
		centre: [O.x, O.y, 52, 0],
		far: [O.x - R, O.y, 40, 0],
		top: [O.x, O.y - R, 52, 7],
		bottom: [O.x, O.y + R, 52, -7],
	};
	const REL: Record<string, [number, number, number, number]> = {
		near: [O.x + R, O.y, 40, 0],
		centre: [O.x, O.y, 0.01, 0],
		far: [O.x - R, O.y, -36, 0],
		top: [O.x, O.y - R, 0.01, 19],
		bottom: [O.x, O.y + R, 0.01, -19],
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-lta]')) {
		const msg = root.querySelector<HTMLElement>('[data-msg]')!;
		const water = root.querySelector<SVGEllipseElement>('[data-water]')!;
		const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode]'));
		const lines = Array.from(root.querySelectorAll<SVGLineElement>('[data-a]'));
		const show = (mode: string) => {
			const set = mode === 'abs' ? ABS : REL;
			for (const l of lines) {
				const [x, y, dx, dy] = set[l.dataset.a!];
				attrs(l, { x1: x, y1: y, x2: x + dx, y2: y + dy });
				l.style.opacity = Math.hypot(dx, dy) < 1 ? '0' : '1';
			}
			if (mode === 'abs') {
				water.style.rx = `${R + 4}px`;
				water.style.ry = `${R + 4}px`;
				msg.innerHTML =
					'Луна притягивает всё на Земле, но чем ближе к Луне, тем сильнее: в точке <i>A</i> больше всего, в центре <i>O</i> меньше, в точке <i>B</i> ещё меньше. Нажмите «Относительно центра Земли».';
			} else {
				water.style.rx = `${R + 16}px`;
				water.style.ry = `${R + 1}px`;
				msg.innerHTML =
					'Вычтем из каждой стрелки ускорение центра Земли. <b>Вода в точке <i>A</i> притягивается сильнее, чем Земля, и «уходит вперёд»</b> к Луне. <b>Земля притягивается сильнее, чем вода в точке <i>B</i>, и «уходит» от неё</b> — вода там отстаёт. По бокам вода прижимается к Земле. Получаются две выпуклости.';
			}
		};
		for (const b of opts)
			b.addEventListener('click', () => {
				opts.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
				show(b.dataset.mode!);
			});
		show('abs');
	}
</script>
