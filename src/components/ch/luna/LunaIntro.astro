---
/**
 * Two short looping opening scenes of «Луна — спутник Земли». No terms of the chapter in the pictures; the captions'
 * popovers explain.
 * Face: the Moon in the night sky during one synodic month (29,53 сут), from day 2 to day 27,5 after new moon, as seen
 *   from the Northern hemisphere with north up: a waxing Moon is lit on the right, a waning one on the left. The
 *   terminator is exactly half an ellipse of half-width R·|cos e| (e — elongation, mean motion); the dark part is
 *   faintly lit by the Earth (brighter near new moon, when the Earth seen from the Moon is nearly full). The seas
 *   (moonface.ts, real positions) never move: every few days a small copy of that evening's Moon is added to the row
 *   below, and all the copies show the same spots. Libration (a few degrees) is left out.
 * Tide: a beach in cross-section at the equinox, full moon. In 10 s one lunar day passes (24 ч 50 мин), from midnight
 *   to 0:50 the next night. The water follows the simple equilibrium tide: two high waters 12 ч 25 мин apart, the
 *   first and the last when the Moon is highest, the middle one when it is lowest (under the Earth). The Sun and the
 *   Moon move on the same arc (declination 0): the full Moon is opposite the Sun. The boat floats at high water and
 *   lies on the sand at low water. Real ports have their own delay (said in the popover).
 * Plays only while visible; «Повторить» restarts.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import { NEAR, project } from './moonface';

const uid = Math.random().toString(36).slice(2, 8);
const g = (n: string) => `lni-${n}-${uid}`;

// the face: radius 100, centred at (0, 0)
const face = NEAR.map((f) => project(f, 100)).filter((e) => e !== null);

// Face scene: the main Moon and the row of small copies
const MX = 180;
const MY = 92;
const MR = 62;
const THUMB_R = 15;
const THUMB_Y = 204;
const THUMB_DAYS = [2.5, 6, 9.5, 13, 16.5, 20, 23.5, 27];
const thumbX = (i: number) => 33 + 42 * i;
const STARS: [number, number, number][] = [
	[22, 50, 0.8], [58, 22, 0.6], [92, 120, 0.5], [40, 140, 0.7], [292, 30, 0.9], [326, 76, 0.6], [270, 130, 0.5],
	[318, 150, 0.7], [110, 40, 0.4], [250, 18, 0.5], [16, 96, 0.5], [344, 112, 0.4],
];

// Tide scene: the beach slope and the tide pole
const SHORE = 'M0 240 L0 118 L60 124 L360 222 L360 240 Z';
const POLE_X = 300;
const STARS2: [number, number, number][] = [
	[20, 20, 0.8], [70, 44, 0.6], [128, 16, 0.7], [236, 36, 0.6], [300, 20, 0.9], [340, 60, 0.5], [180, 52, 0.5],
	[40, 84, 0.5], [262, 92, 0.4], [100, 96, 0.4],
];
---

<IntroFrame data-lunaintro>
	<div class="intro__card" data-scene="face">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Луна на ночном небе в течение месяца: она растёт от узкого серпа до полной и снова убывает. Тёмные пятна на ней всё время одни и те же. Внизу — ряд маленьких Лун через каждые три-четыре дня, на всех те же пятна">
			<defs>
				<linearGradient id={g('night')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="#060a1a"></stop>
					<stop offset="1" stop-color="#151c36"></stop>
				</linearGradient>
				<!-- fills as attributes: page CSS with an ancestor selector does not reach into <use> copies -->
				<g id={g('face')}>
					<circle r="100" fill="#d9d7cf"></circle>
					{face.map((e) => (
						<ellipse fill={e!.kind === 'bright' ? '#f6f5ef' : '#77756f'} cx={e!.cx.toFixed(1)} cy={e!.cy.toFixed(1)} rx={e!.rx.toFixed(1)} ry={e!.ry.toFixed(1)} transform={`rotate(${e!.rot.toFixed(1)} ${e!.cx.toFixed(1)} ${e!.cy.toFixed(1)})`} opacity={e!.op.toFixed(2)}></ellipse>
					))}
				</g>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${g('night')})`}></rect>
			{STARS.map(([x, y, m]) => <circle class="lni-star" cx={x} cy={y} r={0.5 + m} style={`opacity:${m}`} />)}
			<line class="lni-strip" x1="10" y1="176" x2="350" y2="176"></line>
			<!-- the Moon tonight -->
			<g transform={`translate(${MX} ${MY})`}>
				<use href={`#${g('face')}`} transform={`scale(${MR / 100})`}></use>
				<path class="lni-dark" data-shadow></path>
			</g>
			<!-- the Moon on earlier evenings -->
			{THUMB_DAYS.map((d, i) => (
				<g transform={`translate(${thumbX(i)} ${THUMB_Y})`} data-thumb={d} style="opacity:0">
					<use href={`#${g('face')}`} transform={`scale(${THUMB_R / 100})`}></use>
					<path class="lni-dark"></path>
				</g>
			))}
			<rect class="lni-pill" x="8" y="8" width="92" height="24" rx="12"></rect>
			<text class="lni-read" x="54" y="25" text-anchor="middle" data-day>2-й день</text>
		</svg>
		<div class="intro__foot">
			<p>За месяц Луна то растёт, то убывает, но тёмные пятна на ней всегда одни и те же: к Земле <More term="всегда повёрнута одна сторона Луны">Луна поворачивается вокруг своей оси ровно один раз, пока обходит Землю, поэтому её обратную сторону с Земли не видно никогда. А форма Луны меняется оттого, что Солнце освещает её то сбоку, то спереди. Подробнее — в разделе <a href="#почему-мы-видим-одну-сторону-луны">«Почему мы видим одну сторону Луны»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="tide">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Берег океана в разрезе. За сутки вода дважды поднимается и дважды отступает: лодка то плавает, то лежит на песке. По небу проходят Луна и Солнце">
			<defs>
				<linearGradient id={g('sky')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" data-sky0></stop>
					<stop offset="1" data-sky1></stop>
				</linearGradient>
				<radialGradient id={g('sunglow')}>
					<stop offset="0" stop-color="#fff3c4" stop-opacity="0.9"></stop>
					<stop offset="0.35" stop-color="#ffd66b" stop-opacity="0.45"></stop>
					<stop offset="1" stop-color="#ffd66b" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${g('sky')})`}></rect>
			<g data-stars2>
				{STARS2.map(([x, y, m]) => <circle class="lni-star" cx={x} cy={y} r={0.5 + m} style={`opacity:${m}`} />)}
			</g>
			<g data-sun>
				<circle r="22" fill={`url(#${g('sunglow')})`}></circle>
				<circle class="lni-sun" r="10"></circle>
			</g>
			<g data-moon>
				<circle class="lni-fullmoon" r="9"></circle>
				<circle class="lni-fullmoon-mare" cx="-3" cy="-2.5" r="3"></circle>
				<circle class="lni-fullmoon-mare" cx="2.6" cy="-1" r="2.2"></circle>
				<circle class="lni-fullmoon-mare" cx="-1" cy="3.4" r="1.8"></circle>
			</g>
			<!-- the sea: a level surface behind the beach -->
			<rect class="lni-sea" x="0" y="160" width="360" height="80" data-sea></rect>
			<path class="lni-wave" data-wave></path>
			<!-- the tide pole -->
			<rect class="lni-pole" x={POLE_X - 2.5} y="118" width="5" height="86"></rect>
			{[130, 140, 150, 160, 170, 180, 190].map((y) => (
				<line class="lni-tick" x1={POLE_X + 2.5} x2={POLE_X + 8} y1={y} y2={y} />
			))}
			<path class="lni-ground" d={SHORE} data-ground></path>
			<path class="lni-sand" d="M60 124 L360 222"></path>
			<!-- the mooring post and the rope -->
			<rect class="lni-post" x="118" y="128" width="4" height="18"></rect>
			<path class="lni-rope" data-rope></path>
			<!-- the boat: keel at (0, 0) -->
			<g data-boat>
				<path class="lni-hull" d="M-19 -9 L19 -9 L14 -1 Q12 0 9 0 L-11 0 Q-14 0 -16 -2 Z"></path>
				<line class="lni-gunwale" x1="-19" y1="-9" x2="19" y2="-9"></line>
				<rect class="lni-seat" x="-3" y="-12" width="8" height="3" rx="1"></rect>
			</g>
			<text class="lni-label" x={POLE_X} y="112" text-anchor="middle" data-high>полная вода</text>
			<rect class="lni-pill" x="8" y="8" width="132" height="24" rx="12"></rect>
			<text class="lni-read" x="74" y="25" text-anchor="middle" data-clock>1-е сутки, 0:00</text>
		</svg>
		<div class="intro__foot">
			<p>У берега океана вода дважды в сутки поднимается и снова уходит: <More term="её поднимает Луна">Луна притягивает ближнюю к ней сторону Земли сильнее, чем дальнюю, и вода в океане вытягивается двумя горбами: под Луной и на противоположной стороне Земли. Земля поворачивается под ними, поэтому высокая вода приходит в среднем через 12&nbsp;ч 25&nbsp;мин и каждый день примерно на 50&nbsp;минут позже. В каждом порту — со своим запозданием. Подробнее — в разделе <a href="#приливы">«Приливы»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-lunaintro] .lni-star {
		fill: #f4f6ff;
	}
	[data-lunaintro] .lni-dark {
		fill: #0b0f20;
	}
	[data-lunaintro] .lni-strip {
		stroke: rgb(180 195 255 / 0.18);
		stroke-width: 1;
	}
	[data-lunaintro] .lni-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		opacity: 0.92;
	}
	[data-lunaintro] .lni-read {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	[data-lunaintro] .lni-sun {
		fill: #ffe08a;
	}
	[data-lunaintro] .lni-fullmoon {
		fill: #e9e7df;
	}
	[data-lunaintro] .lni-fullmoon-mare {
		fill: #a9a79f;
	}
	[data-lunaintro] .lni-sea {
		fill: #2f6fae;
	}
	[data-lunaintro] .lni-wave {
		fill: none;
		stroke: rgb(255 255 255 / 0.45);
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	[data-lunaintro] .lni-ground {
		fill: #c8ad78;
	}
	[data-lunaintro] .lni-sand {
		stroke: #e3cc98;
		stroke-width: 1.5;
	}
	[data-lunaintro] .lni-pole {
		fill: #7b6a55;
	}
	[data-lunaintro] .lni-tick {
		stroke: #f2f2f2;
		stroke-width: 1.4;
	}
	[data-lunaintro] .lni-post {
		fill: #6b5a46;
	}
	[data-lunaintro] .lni-rope {
		fill: none;
		stroke: #4a3d30;
		stroke-width: 1.1;
	}
	[data-lunaintro] .lni-hull {
		fill: #c0453a;
		stroke: #6e231c;
		stroke-width: 1;
		stroke-linejoin: round;
	}
	[data-lunaintro] .lni-gunwale {
		stroke: #f0e6d6;
		stroke-width: 1.6;
	}
	[data-lunaintro] .lni-seat {
		fill: #8a6a48;
	}
	[data-lunaintro] .lni-label {
		font-size: 13px;
		font-weight: 600;
		fill: #ffffff;
		paint-order: stroke fill;
		stroke: rgb(10 20 40 / 0.55);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';
	import { shadowPath } from './moonface';

	const SYN = 29.530589; // synodic month, days
	const LUNAR_DAY = 24 + 50.5 / 60; // h: the Moon returns to the same place in the sky
	const mix = (a: number[], b: number[], t: number) =>
		`rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(' ')})`;

	for (const root of document.querySelectorAll<HTMLElement>('[data-lunaintro]')) {
		// ---------- Face: 8 s, day 2 → 27,5 ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="face"]')!;
			const shadow = card.querySelector<SVGPathElement>('[data-shadow]')!;
			const dayText = card.querySelector<SVGTextElement>('[data-day]')!;
			const MR = 62;
			const TR = 15;
			// earthshine: the dark part is a little brighter when the Moon is a thin crescent
			const darkOp = (e: number) => (0.9 + 0.07 * (1 - Math.cos(e)) / 2).toFixed(3);
			const thumbs = Array.from(card.querySelectorAll<SVGGElement>('[data-thumb]')).map((el) => {
				const d = Number(el.dataset.thumb);
				const e = (2 * Math.PI * d) / SYN;
				const p = el.querySelector('path')!;
				p.setAttribute('d', shadowPath(e, TR + 0.3));
				p.style.opacity = darkOp(e);
				return { el, d };
			});
			const D0 = 2;
			const D1 = 27.5;
			scene(card, 8, (x) => {
				const day = D0 + (D1 - D0) * x;
				const e = (2 * Math.PI * day) / SYN;
				shadow.setAttribute('d', shadowPath(e, MR + 0.4));
				shadow.style.opacity = darkOp(e);
				dayText.textContent = `${Math.floor(day)}-й день`;
				for (const t of thumbs) t.el.style.opacity = day >= t.d ? '1' : '0';
			});
		}

		// ---------- Tide: 10 s, one lunar day from midnight ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="tide"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const sky0 = $<SVGStopElement>('[data-sky0]');
			const sky1 = $<SVGStopElement>('[data-sky1]');
			const stars = $<SVGGElement>('[data-stars2]');
			const sun = $<SVGGElement>('[data-sun]');
			const moon = $<SVGGElement>('[data-moon]');
			const sea = $<SVGRectElement>('[data-sea]');
			const wave = $<SVGPathElement>('[data-wave]');
			const boat = $<SVGGElement>('[data-boat]');
			const rope = $<SVGPathElement>('[data-rope]');
			const high = $<SVGTextElement>('[data-high]');
			const clock = $<SVGTextElement>('[data-clock]');
			const groundEl = $<SVGPathElement>('[data-ground]');
			// the sky bodies rise on the left (east) and set on the right (west) at the mean sea level
			const BASE = 168;
			const arc = (H: number) => ({ x: 180 + 160 * Math.sin(H), y: BASE - 140 * Math.cos(H) });
			const sandY = (x: number) => 124 + ((x - 60) * 98) / 300;
			const BOAT_X = 196;
			const DRAFT = 6;
			scene(card, 10, (x) => {
				const t = LUNAR_DAY * x; // hours after midnight
				const Hm = (2 * Math.PI * t) / LUNAR_DAY; // the Moon's hour angle (0 — highest)
				const Hs = (2 * Math.PI * (t - 12)) / 24; // the Sun's hour angle
				const m = arc(Hm);
				const s = arc(Hs);
				moon.setAttribute('transform', `translate(${m.x.toFixed(1)} ${m.y.toFixed(1)})`);
				sun.setAttribute('transform', `translate(${s.x.toFixed(1)} ${s.y.toFixed(1)})`);
				// daylight from the Sun's height (twilight while it is a little below the horizon)
				const L = clamp((Math.cos(Hs) + 0.12) / 0.45);
				sky0.setAttribute('stop-color', mix([6, 10, 26], [72, 132, 206], L));
				sky1.setAttribute('stop-color', mix([24, 32, 62], [160, 202, 236], L));
				stars.style.opacity = (1 - L).toFixed(2);
				// the beach and the sea are darker at night (lit by the full Moon only)
				groundEl.style.fill = mix([92, 82, 66], [200, 173, 120], L);
				sea.style.fill = mix([28, 58, 98], [47, 111, 174], L);
				// the water: high when the Moon is highest or lowest (two bulges)
				const level = Math.cos(2 * Hm); // 1 — high water, −1 — low water
				const yw = 166 - 16 * level;
				sea.setAttribute('y', yw.toFixed(1));
				const now = performance.now() / 1000;
				let d = `M0 ${yw.toFixed(1)}`;
				for (let px = 0; px <= 360; px += 12) d += ` L${px} ${(yw + 1.2 * Math.sin(px / 9 + now * 2.2)).toFixed(1)}`;
				wave.setAttribute('d', d);
				// the boat floats or lies on the sand
				const floatY = yw + DRAFT + 0.8 * Math.sin(now * 1.8);
				const ground = sandY(BOAT_X);
				const keel = Math.min(floatY, ground);
				const aground = clamp((floatY - ground) / 6);
				const tilt = 18 * aground + 1.5 * Math.sin(now * 1.3) * (1 - aground);
				boat.setAttribute('transform', `translate(${BOAT_X} ${keel.toFixed(1)}) rotate(${tilt.toFixed(1)})`);
				const a = (tilt * Math.PI) / 180;
				const bowX = BOAT_X - 18 * Math.cos(a) + 9 * Math.sin(a);
				const bowY = keel - 18 * Math.sin(a) - 9 * Math.cos(a);
				rope.setAttribute('d', `M120 129 Q${((120 + bowX) / 2).toFixed(1)} ${(Math.max(129, bowY) + 8).toFixed(1)} ${bowX.toFixed(1)} ${bowY.toFixed(1)}`);
				high.style.opacity = clamp((level - 0.93) / 0.05).toFixed(2);
				const day = t < 24 ? 1 : 2;
				const hh = Math.floor(t % 24);
				const mm = Math.floor((t * 60) % 60);
				clock.textContent = `${day}-е сутки, ${hh}:${String(mm).padStart(2, '0')}`;
			});
		}
	}
</script>
