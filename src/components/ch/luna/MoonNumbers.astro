---
/**
 * «Луна в числах»: tiles with the Moon's main numbers, each compared with the Earth.
 * Values: NASA Moon Fact Sheet (nssdc.gsfc.nasa.gov/planetary/factsheet/moonfact.html), rounded.
 */
const tiles = [
	{ name: 'Радиус', value: '1737 км', note: 'в 3,7 раза меньше, чем у Земли' },
	{ name: 'Масса', value: '7,35·10²² кг', note: 'в 81 раз меньше массы Земли' },
	{ name: 'Среднее расстояние от Земли', value: '384 400 км', note: 'это 60 радиусов Земли; свет проходит его за 1,3 с' },
	{ name: 'Ускорение свободного падения', value: '1,62 м/с²', note: 'в 6 раз меньше, чем на Земле' },
	{ name: 'Скорость движения по орбите', value: '1,02 км/с', note: 'Луна обходит Землю против часовой стрелки, если смотреть с севера' },
	{ name: 'Звёздный месяц', value: '27,32 сут', note: 'за это время Луна делает оборот вокруг Земли и оборот вокруг своей оси' },
	{ name: 'Синодический месяц', value: '29,53 сут', note: 'от новолуния до новолуния — смена всех фаз' },
	{ name: 'Сутки на Луне', value: '29,5 земных суток', note: 'день и ночь — примерно по две недели' },
];
---

<div class="lnum not-content">
	{
		tiles.map((t) => (
			<div class="lnum__tile">
				<span class="lnum__name">{t.name}</span>
				<span class="lnum__value">{t.value}</span>
				<span class="lnum__note">{t.note}</span>
			</div>
		))
	}
</div>

<style is:global>
	.lnum {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
		gap: 0.6rem;
		margin-block: 1.25rem;
	}
	.lnum__tile {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.7rem 0.85rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-top: 3px solid color-mix(in srgb, var(--sl-color-accent-high) 70%, var(--sl-color-gray-4));
		border-radius: 0.8rem;
		background: radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--sl-color-accent-high) 10%, transparent), transparent 9rem),
			var(--ig-surface);
	}
	.lnum__name {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		line-height: 1.3;
	}
	.lnum__value {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		line-height: 1.25;
	}
	.lnum__note {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		line-height: 1.35;
	}
	@media (max-width: 30rem) {
		.lnum {
			grid-template-columns: 1fr 1fr;
			gap: 0.45rem;
		}
		.lnum__tile {
			padding: 0.55rem 0.6rem 0.6rem;
		}
		.lnum__value {
			font-size: 1.05rem;
		}
	}
</style>
