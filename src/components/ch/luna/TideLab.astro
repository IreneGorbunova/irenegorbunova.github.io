<script>
	import { clock, hm, loop, attrs, TAU } from './util';

	const DAY_SID = 23.9345; // h, the Earth's turn relative to the stars
	const MONTH = 27.32166 * 24; // h
	const YEAR = 365.256 * 24; // h
	const SUN_SHARE = 0.46; // the Sun's tide / the Moon's tide
	const DT = 0.1; // h between samples of the level
	const KEEP = 24 * 32; // h of history
	const C = { x: 180, y: 170 };
	const RE = 64;
	const NS = 'http://www.w3.org/2000/svg';

	for (const root of document.querySelectorAll<HTMLElement>('[data-ltl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const water = q<SVGPathElement>('[data-water]');
		const earth = q<SVGGElement>('[data-earth]');
		const night = q<SVGPathElement>('[data-night]');
		const moon = q<SVGGElement>('[data-moon]');
		const sun = q<SVGGElement>('[data-sun]');
		const axis = q<SVGLineElement>('[data-axis]');
		const cityLabel = q<SVGTextElement>('[data-city-label]');
		const moonLabel = q<SVGTextElement>('[data-moon-label]');
		const sunLabel = q<SVGTextElement>('[data-sun-label]');
		const clockEl = q<HTMLElement>('[data-clock]');
		const dayEl = q<HTMLElement>('[data-day]');
		const read = q<HTMLElement>('[data-read]');
		const phase = q<HTMLElement>('[data-phase]');
		const pauseBtn = q<HTMLButtonElement>('[data-pause]');
		const resetBtn = q<HTMLButtonElement>('[data-reset]');
		const speeds = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-speed]'));
		const sunBtn = q<HTMLButtonElement>('[data-sun-toggle]');
		const curve = q<SVGPathElement>('[data-curve]');
		const grid = q<SVGGElement>('[data-grid]');
		const highsG = q<SVGGElement>('[data-highs]');
		const graph = q<SVGSVGElement>('[data-graph]');
		const zero = q<SVGLineElement>('[data-zero]');
		// the graph is drawn in real pixels: its viewBox follows its width, so the labels keep their size
		let GW = 360;
		const fitGraph = () => {
			GW = Math.max(240, Math.round(graph.getBoundingClientRect().width) || 360);
			graph.setAttribute('viewBox', `0 0 ${GW} 132`);
			zero.setAttribute('x2', String(GW - 6));
		};
		new ResizeObserver(() => {
			fitGraph();
			drawGraph();
		}).observe(graph);

		// angles in radians, counter-clockwise from the +x axis, seen from the north
		const PHI_S0 = 0;
		const PHI_M0 = (75 * Math.PI) / 180;
		const PHI_C0 = -Math.PI / 2; // 06:00 local solar time
		const ang = (t: number) => ({
			c: PHI_C0 + (TAU * t) / DAY_SID,
			m: PHI_M0 + (TAU * t) / MONTH,
			s: PHI_S0 + (TAU * t) / YEAR,
		});
		let sunOn = false;
		let speed = 2; // h per second
		let running = true;
		let t = 0;
		let ts = 0; // time of the last sample
		let samples: { t: number; h: number }[] = [];
		let highs: number[] = [];

		const wrap = (a: number) => Math.atan2(Math.sin(a), Math.cos(a));
		const level = (t: number) => {
			const a = ang(t);
			return Math.cos(2 * (a.c - a.m)) + (sunOn ? SUN_SHARE * Math.cos(2 * (a.c - a.s)) : 0);
		};
		const localHours = (t: number) => {
			const a = ang(t);
			return 12 + (24 * wrap(a.c - a.s)) / TAU;
		};
		const reset = () => {
			t = 0;
			ts = 0;
			samples = [{ t: 0, h: level(0) }];
			highs = [];
		};
		const sample = () => {
			while (ts + DT <= t) {
				ts += DT;
				samples.push({ t: ts, h: level(ts) });
				const n = samples.length;
				if (n >= 3) {
					const [a, b, c] = [samples[n - 3], samples[n - 2], samples[n - 1]];
					if (b.h > a.h && b.h >= c.h) {
						// the top of a parabola through three points
						const den = a.h - 2 * b.h + c.h;
						const off = den !== 0 ? (0.5 * (a.h - c.h)) / den : 0;
						highs.push(b.t + off * DT);
					}
				}
			}
			while (samples.length && samples[0].t < t - KEEP) samples.shift();
			while (highs.length && highs[0] < t - KEEP) highs.shift();
		};
		const winH = () => (speed > 4 ? 24 * 30 : 54);
		const drawGraph = () => {
			const W = winH();
			const t0 = t - W;
			const X = (v: number) => 44 + ((v - t0) / W) * (GW - 50);
			const Y = (h: number) => 62 - (h / (1 + SUN_SHARE)) * 48;
			const step = speed > 4 ? 2 : 1;
			let d = '';
			let first = true;
			for (let i = 0; i < samples.length; i += step) {
				const s = samples[i];
				if (s.t < t0) continue;
				d += `${first ? 'M' : 'L'}${X(s.t).toFixed(1)} ${Y(s.h).toFixed(1)}`;
				first = false;
			}
			curve.setAttribute('d', d);
			// day lines at local midnights
			grid.replaceChildren();
			const every = speed > 4 ? (GW < 520 ? 10 : 5) : 1;
			const mid0 = Math.ceil((t0 + 6) / 24); // the clock starts at 06:00
			for (let k = mid0; ; k++) {
				const tm = k * 24 - 6;
				if (tm > t) break;
				if (tm < t0 || tm < 0 || k % every) continue;
				if (X(tm) > GW - 62) continue;
				const x = X(tm);
				const l = document.createElementNS(NS, 'line');
				attrs(l, { x1: x, y1: 8, x2: x, y2: 114, class: 'ltl__grid-line' });
				const tx = document.createElementNS(NS, 'text');
				attrs(tx, { x: x + 2, y: 128, class: 'ltl__gt' });
				tx.textContent = `${k + 1}-е сутки`;
				grid.append(l, tx);
			}
			highsG.replaceChildren();
			if (speed <= 4)
				for (const h of highs) {
					if (h < t0) continue;
					const c = document.createElementNS(NS, 'circle');
					attrs(c, { cx: X(h), cy: Y(level(h)), r: 3, class: 'ltl__high' });
					highsG.append(c);
				}
		};
		const drawScene = () => {
			const a = ang(t);
			const pts: string[] = [];
			const K = 9;
			for (let i = 0; i <= 120; i++) {
				const th = (TAU * i) / 120;
				const h = Math.cos(2 * (th - a.m)) + (sunOn ? SUN_SHARE * Math.cos(2 * (th - a.s)) : 0);
				const r = RE + 14 + K * h;
				pts.push(`${(C.x + r * Math.cos(th)).toFixed(1)} ${(C.y - r * Math.sin(th)).toFixed(1)}`);
			}
			water.setAttribute('d', `M ${pts.join(' L ')} Z`);
			earth.setAttribute('transform', `rotate(${(-a.c * 180) / Math.PI})`);
			// the night half: away from the Sun
			night.setAttribute('transform', `rotate(${(-a.s * 180) / Math.PI})`);
			const mx = C.x + 128 * Math.cos(a.m);
			const my = C.y - 128 * Math.sin(a.m);
			moon.setAttribute('transform', `translate(${mx} ${my})`);
			attrs(moonLabel, { x: mx, y: my + (Math.sin(a.m) > 0 ? -15 : 24), 'text-anchor': 'middle' });
			const sx = C.x + 156 * Math.cos(a.s);
			const sy = C.y - 156 * Math.sin(a.s);
			sun.setAttribute('transform', `translate(${sx} ${sy})`);
			attrs(sunLabel, { x: sx - 8 * Math.cos(a.s), y: sy + 26, 'text-anchor': Math.cos(a.s) > 0.3 ? 'end' : 'middle' });
			attrs(axis, { x1: C.x - 150 * Math.cos(a.m), y1: C.y + 150 * Math.sin(a.m), x2: mx, y2: my });
			const lr = RE - 22;
			attrs(cityLabel, { x: C.x + lr * Math.cos(a.c), y: C.y - lr * Math.sin(a.c) + 4, 'text-anchor': 'middle' });
		};
		const drawText = () => {
			const lh = localHours(t);
			clockEl.textContent = clock(lh);
			dayEl.textContent = `сутки ${Math.floor((t + 6) / 24) + 1}`;
			const n = highs.length;
			const rising = level(t + 0.05) > level(t);
			let s = `Вода <b>${rising ? 'прибывает' : 'убывает'}</b>.`;
			if (n >= 1) s += ` Последняя полная вода — в <b>${clock(localHours(highs[n - 1]))}</b>.`;
			if (n >= 2) s += ` Промежуток между двумя последними приливами: <b>${hm(highs[n - 1] - highs[n - 2])}</b>.`;
			else s += ' Дождитесь двух приливов: модель измерит промежуток между ними.';
			read.innerHTML = s;
			if (sunOn) {
				const a = ang(t);
				const e = wrap(a.m - a.s);
				const deg = Math.abs((e * 180) / Math.PI);
				let p = '';
				if (deg < 20) p = '<b>Новолуние:</b> Луна и Солнце с одной стороны от Земли. Их выпуклости складываются — приливы самые высокие (сизигийные).';
				else if (deg > 160) p = '<b>Полнолуние:</b> Луна и Солнце по разные стороны от Земли, на одной прямой. Выпуклости складываются — приливы самые высокие (сизигийные).';
				else if (Math.abs(deg - 90) < 20) p = '<b>Луна в четверти:</b> направления на Луну и на Солнце под прямым углом. Выпуклости частично гасят друг друга — приливы самые низкие (квадратурные).';
				else p = `Угол между направлениями на Луну и на Солнце — ${Math.round(deg)}°.`;
				phase.innerHTML = p;
			} else phase.innerHTML = '';
		};
		const draw = () => {
			drawScene();
			drawGraph();
			drawText();
		};
		loop(root, (dt) => {
			if (!running) return;
			t += dt * speed;
			sample();
			draw();
		});
		pauseBtn.addEventListener('click', () => {
			running = !running;
			pauseBtn.textContent = running ? 'Пауза' : 'Пуск';
		});
		resetBtn.addEventListener('click', () => {
			reset();
			draw();
		});
		for (const b of speeds)
			b.addEventListener('click', () => {
				speed = Number(b.dataset.speed);
				speeds.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				draw();
			});
		sunBtn.addEventListener('click', () => {
			sunOn = !sunOn;
			sunBtn.setAttribute('aria-pressed', String(sunOn));
			draw();
		});
		reset();
		draw();
	}
</script>
