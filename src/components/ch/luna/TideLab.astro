---
/**
 * Tides, seen from above the North Pole. The Earth turns counter-clockwise once in 23 h 56 min (relative to the stars),
 * the Moon goes round counter-clockwise in 27,32 сут, the Sun's direction turns once a year. The water forms two bulges
 * along the Earth–Moon line (the equilibrium tide: height ∝ cos 2θ); with «Солнце тоже» the Sun's bulges are added with
 * 0,46 of the Moon's height (the ratio of the tidal accelerations, 2GM/r³). A city on the equator turns under the bulges;
 * the graph shows its water level, finds the high waters and the time between them (12 ч 25 мин with the Moon alone).
 * Real tides lag and depend on the coasts — said in the chapter text.
 */
const uid = Math.random().toString(36).slice(2, 8);
// simple continents around the North Pole (angle in degrees, radius as a share of the Earth's radius)
const land = [
	'M 0.95 -40 L 0.7 -20 L 0.62 10 L 0.8 30 L 0.98 35 Z',
	'M 0.98 70 L 0.72 85 L 0.6 120 L 0.75 150 L 0.98 160 Z',
	'M 0.98 200 L 0.68 215 L 0.66 250 L 0.85 275 L 0.98 280 Z',
];
const R = 64;
const toPath = (d: string) =>
	d.replace(/([ML]) ([\d.]+) (-?[\d.]+)/g, (_m, c, r, a) => {
		const rr = Number(r) * R;
		const aa = (Number(a) * Math.PI) / 180;
		return `${c} ${(rr * Math.cos(aa)).toFixed(1)} ${(-rr * Math.sin(aa)).toFixed(1)}`;
	});
---

<figure class="ltl not-content" data-ltl>
	<div class="ltl__grid">
		<svg class="ltl__scene" viewBox="0 0 360 340" role="img" aria-label="Земля с приливными выпуклостями, вид с северного полюса">
			<defs>
				<radialGradient id={`ltl-sun-${uid}`}>
					<stop offset="0" stop-color="#fff3c4" />
					<stop offset="0.45" stop-color="#ffd66b" />
					<stop offset="1" stop-color="#ffd66b" stop-opacity="0" />
				</radialGradient>
			</defs>
			<g class="ltl__stars">
				{
					[
						[20, 30], [60, 310], [340, 40], [320, 300], [30, 170], [345, 170], [180, 12], [180, 330], [100, 80], [260, 260], [90, 250], [270, 70], [140, 40], [230, 300],
					].map(([x, y]) => <circle cx={x} cy={y} r="0.9" />)
				}
			</g>
			<g data-sun>
				<circle r="22" fill={`url(#ltl-sun-${uid})`} />
				<circle r="8" class="ltl__sun" />
			</g>
			<line class="ltl__axis" data-axis />
			<path class="ltl__water" data-water d="" />
			<g transform="translate(180 170)">
				<circle class="ltl__ocean" r={R} />
				<g data-earth>
					{land.map((d) => <path class="ltl__land" d={toPath(d)} />)}
					<circle class="ltl__ice" r="13" />
					<g data-city>
						<circle class="ltl__city" cx={R - 3} cy="0" r="4.2" />
					</g>
				</g>
				<path class="ltl__night" data-night d={`M 0 ${-R} A ${R} ${R} 0 0 0 0 ${R} Z`} />
				<path class="ltl__spin" d="M -26 -38 A 46 46 0 0 0 -44 -12" />
				<path class="ltl__spin-head" d="M -46 -18 L -44 -10 L -38 -15" />
			</g>
			<text class="ltl__t ltl__t--city" data-city-label>город</text>
			<g data-moon>
				<circle r="10" class="ltl__moon" />
			</g>
			<text class="ltl__t" data-moon-label>Луна</text>
			<text class="ltl__t" data-sun-label>Солнце</text>
		</svg>
		<div class="ltl__side">
			<p class="ltl__clock"><span>Время в городе</span> <b data-clock>06:00</b> <span data-day>сутки 1</span></p>
			<p class="ltl__read" data-read aria-live="polite"></p>
			<div class="ltl__controls">
				<button type="button" class="ltl__btn ltl__btn--main" data-pause>Пауза</button>
				<button type="button" class="ltl__btn" data-reset>Заново</button>
			</div>
			<div class="ltl__chips" role="group" aria-label="Скорость">
				<button type="button" class="ltl__chip" data-speed="2" aria-pressed="true">2 часа в секунду</button>
				<button type="button" class="ltl__chip" data-speed="24" aria-pressed="false">сутки в секунду</button>
			</div>
			<button type="button" class="ltl__chip ltl__chip--sun" data-sun-toggle aria-pressed="false">Солнце тоже притягивает воду</button>
			<p class="ltl__phase" data-phase aria-live="polite"></p>
		</div>
	</div>
	<div class="ltl__graph-wrap">
		<p class="ltl__graph-title">Уровень воды у города</p>
		<svg class="ltl__graph" viewBox="0 0 360 132" role="img" aria-label="График уровня воды у города" data-graph>
			<line class="ltl__zero" data-zero x1="40" y1="62" x2="354" y2="62" />
			<g data-grid></g>
			<path class="ltl__curve" data-curve d="" />
			<g data-highs></g>
			<text class="ltl__gt" x="4" y="20">выше</text>
			<text class="ltl__gt" x="4" y="110">ниже</text>
		</svg>
	</div>
	<figcaption class="ltl__caption">
		Вид с северного полюса: Земля вращается против часовой стрелки, Луна обходит её в ту же сторону, но медленно.
		Высота выпуклостей и расстояние до Луны сильно увеличены: в открытом океане прилив поднимает воду всего примерно
		на полметра. Город стоит на экваторе; ночная сторона Земли затемнена.
	</figcaption>
</figure>

