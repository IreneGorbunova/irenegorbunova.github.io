---
/**
 * Picture «Кубический метр»: a cube with an edge of 1 м = 100 см in an oblique view (front face 120 px). The front
 * face (blue) is divided into 10 × 10 squares of 10 см × 10 см, the cube itself is gold. Beside it, the area of the
 * face and the volume of the cube are found twice, in metres and in centimetres, and the two results are equated:
 * 1 м² = 100 · 100 см² = 10 000 см², 1 м³ = 100 · 100 · 100 см³ = 1 000 000 см³.
 */
import katex from 'katex';
import G7Styles from '../g7/G7Styles.astro';

const tex = (s: string) => katex.renderToString(s, { throwOnError: false, displayMode: true });
const A = 120; // the edge, px
const X = 34;
const Y = 70;
const DX = 52;
const DY = -38;
const grid = Array.from({ length: 9 }, (_, i) => (i + 1) * (A / 10))
	.map((d) => `M${X + d} ${Y} V${Y + A} M${X} ${Y + d} H${X + A}`)
	.join(' ');
---

<G7Styles />
<figure class="g7 g7--pic cube not-content">
	<div class="g7__grid cube__grid">
		<svg class="g7__svg" viewBox="0 0 240 230" role="img" aria-label="Куб с ребром 1 метр, то есть 100 сантиметров. Передняя грань разбита на 100 квадратов со стороной 10 сантиметров">
			<path class="cube__side" d={`M${X} ${Y} L${X + DX} ${Y + DY} H${X + A + DX} L${X + A} ${Y} Z`}></path>
			<path class="cube__side cube__side--dark" d={`M${X + A} ${Y} L${X + A + DX} ${Y + DY} V${Y + A + DY} L${X + A} ${Y + A} Z`}></path>
			<rect class="cube__face" x={X} y={Y} width={A} height={A}></rect>
			<path class="cube__grid-lines" d={grid}></path>
			<rect class="cube__edge" x={X} y={Y} width={A} height={A} fill="none"></rect>
			<path class="cube__edge" d={`M${X} ${Y} L${X + DX} ${Y + DY} H${X + A + DX} V${Y + A + DY} L${X + A} ${Y + A} M${X + A} ${Y} L${X + A + DX} ${Y + DY}`} fill="none"></path>
			<text class="t-strong" x={X + A / 2} y={Y + A + 20} text-anchor="middle">1 м = 100 см</text>
			<text class="t-strong" x={X - 10} y={Y + A / 2} text-anchor="middle" transform={`rotate(-90 ${X - 10} ${Y + A / 2})`}>1 м = 100 см</text>
			<text class="t-strong" x={X + A + DX / 2 + 12} y={Y + A + DY / 2 + 14} text-anchor="middle" transform={`rotate(${(Math.atan2(DY, DX) * 180) / Math.PI} ${X + A + DX / 2 + 12} ${Y + A + DY / 2 + 14})`}>1 м = 100 см</text>
			<rect class="cube__cell" x={X} y={Y + A - A / 10} width={A / 10} height={A / 10}></rect>
			<text class="t-small" x={X + A / 10 + 4} y={Y + A + 34}>клетка 10 см × 10 см</text>
			<path class="cube__ptr" d={`M${X + A / 20} ${Y + A - 2} L${X + A / 10 + 2} ${Y + A + 28}`}></path>
		</svg>
		<div class="cube__calc">
			<p class="cube__h cube__h--s">Площадь грани</p>
			<Fragment set:html={tex('S = 1~\\text{м} \\cdot 1~\\text{м} = 1~\\text{м}^2')} />
			<Fragment set:html={tex('\\begin{aligned} S &= 100~\\text{см} \\cdot 100~\\text{см} = \\\\ &= 10\\,000~\\text{см}^2 \\end{aligned}')} />
			<p class="cube__res cube__res--s">1&nbsp;м² = 10&nbsp;000&nbsp;см²</p>
			<p class="cube__h cube__h--v">Объём куба</p>
			<Fragment set:html={tex('V = 1~\\text{м} \\cdot 1~\\text{м} \\cdot 1~\\text{м} = 1~\\text{м}^3')} />
			<Fragment set:html={tex('\\begin{aligned} V &= 100~\\text{см} \\cdot 100~\\text{см} \\cdot 100~\\text{см} = \\\\ &= 1\\,000\\,000~\\text{см}^3 \\end{aligned}')} />
			<p class="cube__res cube__res--v">1&nbsp;м³ = 1&nbsp;000&nbsp;000&nbsp;см³</p>
		</div>
	</div>
	<figcaption class="g7__caption">Ребро куба можно записать в метрах или в сантиметрах. Площадь грани — сторона, умноженная на сторону; объём куба — три ребра, умноженные друг на друга. На передней грани 100 клеток по 100&nbsp;см², вместе 10&nbsp;000&nbsp;см².</figcaption>
</figure>

<style is:global>
	.g7--pic .cube__grid {
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
	}
	.cube__face {
		fill: color-mix(in srgb, var(--g7-blue) 22%, transparent);
	}
	.cube__side {
		fill: color-mix(in srgb, var(--g7-gold) 26%, transparent);
	}
	.cube__side--dark {
		fill: color-mix(in srgb, var(--g7-gold) 40%, transparent);
	}
	.cube__grid-lines {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 0.6;
		opacity: 0.7;
	}
	.cube__edge {
		stroke: var(--g7-ink);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.cube__cell {
		fill: var(--g7-blue);
		opacity: 0.8;
	}
	.cube__ptr {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.cube__calc .katex-display {
		margin: 0.25rem 0;
		overflow-x: auto;
		overflow-y: hidden;
	}
	.cube__h {
		margin: 0.5rem 0 0;
		font-weight: 700;
	}
	.cube__h--s {
		color: var(--g7-blue);
	}
	.cube__h--v {
		margin-top: 0.9rem;
		color: var(--g7-gold);
	}
	.cube__res {
		margin: 0.1rem 0 0;
		padding: 0.2rem 0.6rem;
		border-radius: 0.5rem;
		font-weight: 700;
		text-align: center;
		color: var(--sl-color-white);
	}
	.cube__res--s {
		background: color-mix(in srgb, var(--g7-blue) 18%, transparent);
	}
	.cube__res--v {
		background: color-mix(in srgb, var(--g7-gold) 22%, transparent);
	}
	@container (max-width: 34rem) {
		.g7--pic .cube__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.cube__grid > svg {
			max-width: 20rem;
			margin-inline: auto;
		}
	}
</style>
