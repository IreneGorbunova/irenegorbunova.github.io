---
/**
 * Picture «Виды физических величин»: two groups of small panels.
 *
 * Векторные величины — an arrow whose length shows the value (each panel states its scale) and whose direction matters:
 *   Скорость: two cars, both 20 м/с, one going east and one going west. Scale 10 м/с = 20 px, so each arrow is 40 px.
 *     The car (4,4 м) is 44 px, i.e. 10 px per м; 20 м/с would then be 200 px/s, so the cars move 10 times slower
 *     (20 px/s), as the caption says.
 *   Сила: a sled pulled by a rope at 25° to the snow with F = 50 Н. Scale 10 Н = 14 px, so the arrow along the rope is
 *     70 px.
 *   Перемещение: a map, А at (36; 128) and Б at (186; 66): the straight arrow from А to Б is √(150² + 62²) = 162,3 px;
 *     with the scale bar 1 км = 54,1 px it is 3,0 км. The winding dashed road between them is longer than 3 км.
 * Скалярные величины — only a number with a unit, no arrow: scales with a 2 кг weight (the display says 2,00 кг),
 *   a stopwatch whose hand stands at 45 с (a quarter turn before 60 с: 270° clockwise from the top), a thermometer
 *   from −20 to 40 °C at 20 °C, a measuring cylinder from 0 to 250 мл with water at 200 мл (a division of 10 мл).
 * Only the cars move; everything else is still.
 */
import G7Styles from '../g7/G7Styles.astro';

/** An arrow from (x1, y1) with its tip exactly at (x2, y2): the shaft stops where the head begins. */
const arrow = (x1: number, y1: number, x2: number, y2: number, hl = 10, hw = 5.5) => {
	const L = Math.hypot(x2 - x1, y2 - y1);
	const ux = (x2 - x1) / L;
	const uy = (y2 - y1) / L;
	const bx = x2 - ux * hl;
	const by = y2 - uy * hl;
	return {
		shaft: `M${x1.toFixed(2)} ${y1.toFixed(2)} L${(bx + ux).toFixed(2)} ${(by + uy).toFixed(2)}`,
		head: `M${x2.toFixed(2)} ${y2.toFixed(2)} L${(bx - uy * hw).toFixed(2)} ${(by + ux * hw).toFixed(2)} L${(bx + uy * hw).toFixed(2)} ${(by - ux * hw).toFixed(2)} Z`,
	};
};

// cars: 44 px long, the arrow 40 px from the front bumper
const CAR = 'M0 -5 V-14 H8 L15 -22 H30 L37 -14 H44 V-5 Z';
const WIN = 'M10 -14 L16 -20 H22 V-14 Z M24 -14 V-20 H29 L34 -14 Z';
const carArrow = arrow(46, -11, 86, -11);
// sled: the rope at 25°, the force 50 Н = 70 px
const ANG = (25 * Math.PI) / 180;
const SL = { x: 96, y: 108 };
const rope = { x: SL.x + 120 * Math.cos(ANG), y: SL.y - 120 * Math.sin(ANG) };
const fArrow = arrow(SL.x, SL.y, SL.x + 70 * Math.cos(ANG), SL.y - 70 * Math.sin(ANG));
// displacement: А → Б
const A = { x: 36, y: 128 };
const B = { x: 186, y: 66 };
const sArrow = arrow(A.x, A.y, B.x, B.y);
const KM = Math.hypot(B.x - A.x, B.y - A.y) / 3;
// stopwatch: 45 с
const SW = { x: 75, y: 80, r: 40 };
const handA = (45 / 60) * 2 * Math.PI;
const hand = { x: SW.x + 32 * Math.sin(handA), y: SW.y - 32 * Math.cos(handA) };
const swTicks = Array.from({ length: 60 }, (_, i) => {
	const a = (i / 60) * 2 * Math.PI;
	const r1 = i % 5 === 0 ? SW.r - 7 : SW.r - 4;
	return `M${(SW.x + r1 * Math.sin(a)).toFixed(2)} ${(SW.y - r1 * Math.cos(a)).toFixed(2)} L${(SW.x + (SW.r - 1) * Math.sin(a)).toFixed(2)} ${(SW.y - (SW.r - 1) * Math.cos(a)).toFixed(2)}`;
}).join(' ');
// thermometer: −20…40 °C from y 112 to y 32 (4/3 px per °C)
const ty = (c: number) => 112 - ((c + 20) * 80) / 60;
// measuring cylinder: 0…250 мл from y 118 to y 38 (0,32 px per мл)
const my = (v: number) => 118 - (v * 80) / 250;
---

<G7Styles />
<figure class="g7 g7--pic vsp not-content" data-vsp>
	<p class="vsp__h vsp__h--vec">Векторные величины: число, единица и&nbsp;направление</p>
	<div class="g7__grid is-three">
		<svg class="g7__svg" viewBox="0 0 220 176" role="img" aria-label="Два автомобиля едут со скоростью 20 метров в секунду: один на восток, другой на запад. Стрелки скорости одинаковой длины, но направлены в разные стороны">
			<text class="t-title" x="110" y="17" text-anchor="middle">Скорость автомобиля</text>
			<text class="t-small" x="8" y="34">← запад</text>
			<text class="t-small" x="212" y="34" text-anchor="end">восток →</text>
			<line class="ln" x1="0" x2="220" y1="78" y2="78"></line>
			<g data-car="1">
				<path class="vsp__car vsp__car--a" d={CAR}></path>
				<path class="vsp__win" d={WIN}></path>
				<circle class="vsp__wheel" cx="10" cy="-5" r="5"></circle>
				<circle class="vsp__wheel" cx="34" cy="-5" r="5"></circle>
				<path class="arrow arrow--blue" d={carArrow.shaft}></path>
				<path class="head--blue" d={carArrow.head}></path>
				<text class="t-i t-blue" x="62" y="-17">υ</text>
			</g>
			<text class="t-strong" x="110" y="94" text-anchor="middle">20 м/с, на восток</text>
			<line class="ln" x1="0" x2="220" y1="138" y2="138"></line>
			<g data-car="-1">
				<g transform="scale(-1 1)">
					<path class="vsp__car vsp__car--b" d={CAR}></path>
					<path class="vsp__win" d={WIN}></path>
					<circle class="vsp__wheel" cx="10" cy="-5" r="5"></circle>
					<circle class="vsp__wheel" cx="34" cy="-5" r="5"></circle>
					<path class="arrow arrow--blue" d={carArrow.shaft}></path>
					<path class="head--blue" d={carArrow.head}></path>
				</g>
				<text class="t-i t-blue" x="-70" y="-17">υ</text>
			</g>
			<text class="t-strong" x="110" y="154" text-anchor="middle">20 м/с, на запад</text>
			<path class="ln" d="M170 166 H190 M170 162 V170 M190 162 V170"></path>
			<text class="t-small" x="166" y="170" text-anchor="end">масштаб: 10 м/с</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 220 176" role="img" aria-label="Санки тянут за верёвку с силой 50 ньютонов: стрелка силы идёт вдоль верёвки">
			<text class="t-title" x="110" y="17" text-anchor="middle">Сила, с которой тянут санки</text>
			<path class="vsp__snow" d="M0 128 Q60 122 120 127 T220 125 V172 H0 Z"></path>
			<!-- the sled: runners, posts, the seat and a box on it -->
			<path class="vsp__runner" d="M28 124 H90 Q100 124 100 114"></path>
			<path class="vsp__runner" d="M38 124 V111 M60 124 V111 M82 124 V111"></path>
			<rect class="vsp__seat" x="32" y="105" width="60" height="6" rx="2"></rect>
			<rect class="vsp__box" x="42" y="79" width="38" height="26" rx="2"></rect>
			<path class="vsp__rope" d={`M${SL.x} ${SL.y} L${rope.x.toFixed(2)} ${rope.y.toFixed(2)}`}></path>
			<circle class="vsp__mitt" cx={rope.x} cy={rope.y} r="5"></circle>
			<path class="arrow arrow--red" d={fArrow.shaft}></path>
			<path class="head--red" d={fArrow.head}></path>
			<text class="t-i t-red" x="128" y="76">F</text>
			<text class="t-strong" x="110" y="150" text-anchor="middle">50 Н, вдоль верёвки</text>
			<path class="ln" d="M176 166 H190 M176 162 V170 M190 162 V170"></path>
			<text class="t-small" x="172" y="170" text-anchor="end">масштаб: 10 Н</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 220 176" role="img" aria-label="Перемещение — стрелка от точки А к точке Б длиной 3 километра. Дорога между ними извилистая и длиннее">
			<text class="t-title" x="110" y="17" text-anchor="middle">Перемещение</text>
			<path class="vsp__road" d={`M${A.x} ${A.y} C30 80 78 54 92 84 S118 140 146 116 S170 50 ${B.x} ${B.y}`}></path>
			<text class="t-small" x="40" y="66">дорога</text>
			<path class="arrow arrow--green" d={sArrow.shaft}></path>
			<path class="head--green" d={sArrow.head}></path>
			<circle class="vsp__pt" cx={A.x} cy={A.y} r="3.5"></circle>
			<circle class="vsp__pt" cx={B.x} cy={B.y} r="3.5"></circle>
			<text class="t-strong" x={A.x - 10} y={A.y + 14} text-anchor="middle">А</text>
			<text class="t-strong" x={B.x + 10} y={B.y - 8} text-anchor="middle">Б</text>
			<text class="t-small t-green t-halo" x="124" y="114">перемещение</text>
			<text class="t-strong" x="110" y="150" text-anchor="middle">3 км, от А к Б</text>
			<path class="ln" d={`M${190 - KM} 166 H190 M${190 - KM} 162 V170 M190 162 V170`}></path>
			<text class="t-small" x={186 - KM} y="170" text-anchor="end">масштаб: 1 км</text>
		</svg>
	</div>

	<p class="vsp__h vsp__h--sc">Скалярные величины: только число и&nbsp;единица</p>
	<div class="g7__grid vsp__four">
		<svg class="g7__svg" viewBox="0 0 150 150" role="img" aria-label="Гиря на весах, весы показывают 2 килограмма">
			<text class="t-title" x="75" y="17" text-anchor="middle">Масса</text>
			<path class="vsp__iron" d="M61 52 Q61 42 75 42 Q89 42 89 52 H83 Q83 48 75 48 Q67 48 67 52 Z"></path>
			<path class="vsp__iron" d="M56 52 H94 Q106 64 104 86 Q102 96 96 96 H54 Q48 96 46 86 Q44 64 56 52 Z"></path>
			<text class="vsp__stamp" x="75" y="80" text-anchor="middle">2 кг</text>
			<rect class="vsp__plate" x="30" y="96" width="90" height="6" rx="3"></rect>
			<rect class="vsp__scale" x="24" y="102" width="102" height="24" rx="6"></rect>
			<rect class="vsp__screen" x="48" y="106" width="54" height="16" rx="3"></rect>
			<text class="vsp__digits" x="98" y="118.5" text-anchor="end">2,00 кг</text>
			<text class="t-strong" x="75" y="144" text-anchor="middle">2 кг</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 150 150" role="img" aria-label="Секундомер показывает 45 секунд">
			<text class="t-title" x="75" y="17" text-anchor="middle">Время</text>
			<rect class="vsp__steel" x="70" y="28" width="10" height="7" rx="1.5"></rect>
			<rect class="vsp__steel" x="66" y="24" width="18" height="5" rx="2"></rect>
			<circle class="vsp__dial" cx={SW.x} cy={SW.y} r={SW.r + 4}></circle>
			<circle class="vsp__face" cx={SW.x} cy={SW.y} r={SW.r}></circle>
			<path class="vsp__ticks" d={swTicks}></path>
			<path class="vsp__hand" d={`M${SW.x} ${SW.y} L${hand.x.toFixed(2)} ${hand.y.toFixed(2)}`}></path>
			<text class="vsp__num t-halo" x={SW.x} y={SW.y - 22} text-anchor="middle">60</text>
			<text class="vsp__num t-halo" x={SW.x + 24} y={SW.y + 3.5} text-anchor="middle">15</text>
			<text class="vsp__num t-halo" x={SW.x} y={SW.y + 29} text-anchor="middle">30</text>
			<text class="vsp__num t-halo" x={SW.x - 24} y={SW.y + 3.5} text-anchor="middle">45</text>
			<circle class="vsp__hub" cx={SW.x} cy={SW.y} r="2.5"></circle>
			<text class="t-strong" x="75" y="144" text-anchor="middle">45 с</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 150 150" role="img" aria-label="Термометр показывает 20 градусов Цельсия">
			<text class="t-title" x="75" y="17" text-anchor="middle">Температура</text>
			<rect class="vsp__tube" x="56" y="26" width="12" height="96" rx="6"></rect>
			<circle class="vsp__tube" cx="62" cy="122" r="10"></circle>
			<rect class="vsp__mercury" x="59.5" y={ty(20)} width="5" height={120 - ty(20)}></rect>
			<circle class="vsp__mercury" cx="62" cy="122" r="7"></circle>
			{Array.from({ length: 13 }, (_, i) => -20 + i * 5).map((c) => <line class="vsp__tick" x1="70" x2={c % 10 === 0 ? 78 : 74} y1={ty(c)} y2={ty(c)}></line>)}
			{[-20, -10, 0, 10, 20, 30, 40].map((c) => <text class="vsp__num" x="82" y={ty(c) + 3.5}>{String(c).replace('-', '−')}</text>)}
			<text class="vsp__num" x="100" y={ty(40) + 3.5}>°C</text>
			<text class="t-strong" x="75" y="144" text-anchor="middle">20 °C</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 150 150" role="img" aria-label="В мензурке 200 миллилитров воды">
			<text class="t-title" x="75" y="17" text-anchor="middle">Объём</text>
			<rect class="vsp__water" x="58" y={my(200)} width="34" height={118 - my(200)}></rect>
			<line class="vsp__level" x1="58" x2="92" y1={my(200)} y2={my(200)}></line>
			{Array.from({ length: 26 }, (_, i) => i * 10).map((v) => <line class="vsp__tick" x1="58" x2={v % 50 === 0 ? 70 : 64} y1={my(v)} y2={my(v)}></line>)}
			{[0, 50, 100, 150, 200, 250].map((v) => <text class="vsp__num" x="51" y={my(v) + 3.5} text-anchor="end">{v}</text>)}
			<text class="vsp__num" x="51" y={my(250) - 10} text-anchor="end">мл</text>
			<path class="vsp__glass" d="M58 26 V118 H92 V26 M58 26 l-5 -4 M55 118 H95 V123 H55 Z"></path>
			<text class="t-strong" x="75" y="144" text-anchor="middle">200 мл</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Стрелки нарисованы в масштабе, он указан в каждой рамке: чем больше значение, тем длиннее стрелка. Автомобили едут в 10&nbsp;раз медленнее, чем на самом деле.
	</figcaption>
</figure>

<style is:global>
	.vsp__h {
		margin: 0.25rem 0 0.5rem;
		padding-left: 0.6rem;
		font-weight: 700;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	.vsp__h--vec {
		box-shadow: inset 3px 0 0 var(--g7-blue);
	}
	.vsp__h--sc {
		margin-top: 1rem;
		box-shadow: inset 3px 0 0 var(--g7-gold);
	}
	.g7--pic .vsp__four {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@container (max-width: 36rem) {
		.g7--pic .vsp__four {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.vsp__over {
		fill: none;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.vsp__over--blue {
		stroke: var(--g7-blue);
	}
	.vsp__over--red {
		stroke: var(--g7-red);
	}
	.vsp__over--green {
		stroke: var(--g7-green);
	}
	.vsp__car {
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.vsp__car--a {
		fill: color-mix(in oklab, var(--g7-red) 55%, var(--sl-color-gray-4));
	}
	.vsp__car--b {
		fill: color-mix(in oklab, var(--g7-violet) 55%, var(--sl-color-gray-4));
	}
	.vsp__win {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--g7-paper));
	}
	.vsp__wheel {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.vsp__snow {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-5));
	}
	:root[data-theme='light'] .vsp__snow {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-6));
	}
	.vsp__runner {
		fill: none;
		stroke: var(--g7-steel-dark);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.vsp__seat {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.vsp__box {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.vsp__rope {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.vsp__mitt {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.vsp__road {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-dasharray: 5 4;
	}
	.vsp__pt {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.vsp__iron {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.g7__svg .vsp__stamp {
		font-size: 11px;
		font-weight: 700;
		fill: var(--sl-color-gray-1);
	}
	.vsp__plate {
		fill: var(--sl-color-gray-3);
	}
	.vsp__scale {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.vsp__screen {
		fill: color-mix(in oklab, var(--g7-green) 14%, var(--g7-paper));
	}
	.g7__svg .vsp__digits {
		font-size: 11px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		fill: var(--g7-green);
	}
	.vsp__steel {
		fill: var(--g7-steel);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.vsp__dial {
		fill: var(--g7-steel);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.vsp__face {
		fill: var(--g7-paper);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.vsp__ticks,
	.vsp__tick {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.g7__svg .vsp__num {
		font-size: 9.5px;
		fill: var(--sl-color-gray-2);
	}
	.vsp__hand {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.vsp__hub {
		fill: var(--g7-red);
	}
	.vsp__tube {
		fill: var(--g7-paper);
		stroke: var(--g7-glass);
		stroke-width: 2;
	}
	.vsp__mercury {
		fill: var(--g7-red);
	}
	.vsp__water {
		fill: var(--g7-water);
	}
	.vsp__level {
		stroke: var(--g7-water-edge);
		stroke-width: 1.6;
	}
	.vsp__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const V = 20; // px/s: 20 м/с at 10 px per м, slowed ten times
	const W = 220 + 140; // the cars leave the panel and come back from the other side

	for (const root of document.querySelectorAll<HTMLElement>('[data-vsp]')) {
		const east = root.querySelector<SVGGElement>('[data-car="1"]')!;
		const west = root.querySelector<SVGGElement>('[data-car="-1"]')!;
		let t = 0;
		const draw = () => {
			const s = (V * t) % W;
			// east: the back bumper from −90 to 270; west: the mirror image
			east.setAttribute('transform', `translate(${(-90 + ((s + 140) % W)).toFixed(2)} 78)`);
			west.setAttribute('transform', `translate(${(310 - ((s + 140) % W)).toFixed(2)} 138)`);
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
