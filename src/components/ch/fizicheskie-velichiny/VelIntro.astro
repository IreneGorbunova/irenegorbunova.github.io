---
/**
 * Two short looping opening scenes of «Физические величины и их измерение». No terms of the chapter in the pictures.
 * Cloth: a piece of cloth 2,4 м long is measured with the forearm (the cubit) of a tall seller (48 см: 5 cubits),
 *   of a short one (40 см: 6 cubits) and with a metre stick (2,4 м). The lengths are to scale (125 px per metre).
 * Stone: a stone on a thread is lowered into a measuring cylinder; the water rises from 60 мл to 85 мл as the
 *   stone goes under (the rise is proportional to the part of the stone under water): its volume is 25 см³.
 *   The scale: numbers every 20 мл, a division is 5 мл; 1,6 px per millilitre.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const X0 = 30;
const S = 125; // px per metre
const W = 2.4 * S;
const ml = (v: number) => 208 - v * 1.6;
---

<IntroFrame data-velintro>
	<div class="intro__card" data-scene="cloth">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Один и тот же отрез ткани: пять локтей высокого продавца, шесть локтей низкого и два целых четыре десятых метра">
			<rect class="ve-room" x="0" y="0" width="360" height="240"></rect>
			<!-- the cloth on the counter -->
			<rect class="ve-counter" x="0" y="176" width="360" height="64"></rect>
			<rect class="ve-cloth" x={X0} y="148" width={W} height="28" rx="2"></rect>
			<path class="ve-fold" d={`M${X0} 157 H${X0 + W} M${X0} 167 H${X0 + W}`}></path>
			<!-- three rows of measuring -->
			<text class="ve-label" x={X0} y="30">локоть высокого продавца</text>
			<g data-row="a">{Array.from({ length: 5 }, (_, i) => <rect class="ve-seg ve-seg--a" x={X0 + i * 0.48 * S} y="36" width={0.48 * S} height="16" rx="2" />)}</g>
			<text class="ve-count" x="346" y="30" text-anchor="end" data-na></text>
			<text class="ve-label" x={X0} y="72">локоть низкого продавца</text>
			<g data-row="b">{Array.from({ length: 6 }, (_, i) => <rect class="ve-seg ve-seg--b" x={X0 + i * 0.4 * S} y="78" width={0.4 * S} height="16" rx="2" />)}</g>
			<text class="ve-count" x="346" y="72" text-anchor="end" data-nb></text>
			<text class="ve-label" x={X0} y="114">метр</text>
			<g data-row="m">
				{[0, 1, 2].map((i) => <rect class="ve-seg ve-seg--m" x={X0 + i * S} y="120" width={i < 2 ? S : 0.4 * S} height="16" rx="2" />)}
				{Array.from({ length: 25 }, (_, i) => <path class="ve-tick" d={`M${X0 + i * 0.1 * S} 120 v${i % 10 === 0 ? 16 : 6}`} />)}
			</g>
			<text class="ve-count" x="346" y="114" text-anchor="end" data-nm></text>
		</svg>
		<div class="intro__foot">
			<p>
				В одном и том же отрезе ткани у высокого продавца пять локтей, а у низкого — шесть.{' '}
				<More term="Метр у всех одинаковый">
					Когда-то длину мерили частями тела: локтями, пядями, ступнями. У каждого человека они свои, и покупатели спорили с продавцами. В конце XVIII&nbsp;века во Франции придумали единицу длины, которая не зависит от человека, — метр. Об этом — в разделе{' '}
					<a href="#измерение-и-единицы">«Измерение и единицы»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="stone">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Камень на нитке опускают в мензурку с водой. Уровень воды поднимается с 60 до 85 миллилитров">
			<rect class="ve-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="ve-counter" x="0" y="216" width="360" height="24"></rect>
			<rect class="ve-water" data-water x="132" y={ml(60)} width="76" height={208 - ml(60) + 8}></rect>
			<line class="ve-thread" data-thread x1="170" y1="0" x2="170" y2="40"></line>
			<path class="ve-stone" data-stone d="M-17 -6 L-9 -15 L6 -16 L16 -8 L18 5 L9 15 L-6 16 L-16 8 Z"></path>
			<path class="ve-glass" d="M132 28 V216 H208 V28 M120 222 H220 L208 216 H132 Z"></path>
			<line class="ve-level" data-level x1="132" x2="208" y1={ml(60)} y2={ml(60)}></line>
			{
				Array.from({ length: 21 }, (_, i) => i * 5).map((v) => (
					<>
						<line class="ve-tick" x1="132" x2={132 + (v % 20 === 0 ? 26 : v % 10 === 0 ? 18 : 12)} y1={ml(v)} y2={ml(v)} />
						{v % 20 === 0 && (
							<text class="ve-small" x="126" y={ml(v) + 4} text-anchor="end">
								{v}
							</text>
						)}
					</>
				))
			}
			<text class="ve-small" x="126" y="30" text-anchor="end">мл</text>
			<rect class="ve-pill" x="232" y="60" width="118" height="92" rx="10"></rect>
			<text class="ve-small" x="242" y="80">было</text>
			<text class="ve-num" x="242" y="97">60 мл</text>
			<text class="ve-small" x="242" y="118">стало</text>
			<text class="ve-num" x="242" y="135" data-now>60 мл</text>
			<text class="ve-label" x="232" y="176" data-vol></text>
		</svg>
		<div class="intro__foot">
			<p>
				Камень неправильной формы линейкой не измерить. Его опускают в воду и смотрят,{' '}
				<More term="на сколько поднялся уровень">
					Камень вытесняет столько воды, каков его объём. Было 60&nbsp;мл, стало 85&nbsp;мл — значит, объём камня 25&nbsp;мл, или 25&nbsp;см³. Сосуд со шкалой для измерения объёма называют мензуркой. Как читать шкалу — в разделе{' '}
					<a href="#измерительные-приборы">«Измерительные приборы»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-velintro] .ve-room {
		fill: var(--sl-color-bg);
	}
	[data-velintro] .ve-counter {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-velintro] .ve-cloth {
		fill: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-5));
		stroke: color-mix(in oklab, var(--ig-vy) 70%, black);
		stroke-width: 1;
	}
	[data-velintro] .ve-fold {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 70%, black);
		stroke-width: 0.8;
		opacity: 0.5;
	}
	[data-velintro] .ve-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-velintro] .ve-count {
		font-size: 13px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-velintro] .ve-seg {
		stroke-width: 1.2;
		opacity: 0;
	}
	[data-velintro] .ve-seg--a {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-6));
		stroke: var(--ig-v);
	}
	[data-velintro] .ve-seg--b {
		fill: color-mix(in oklab, var(--ig-vx) 34%, var(--sl-color-gray-6));
		stroke: var(--ig-vx);
	}
	[data-velintro] .ve-seg--m {
		fill: color-mix(in oklab, hsl(150, 60%, 50%) 30%, var(--sl-color-gray-6));
		stroke: hsl(150, 50%, 45%);
	}
	[data-velintro] .ve-tick {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-velintro] [data-row='m'] .ve-tick {
		opacity: 0;
	}
	[data-velintro] .ve-water {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
	}
	[data-velintro] .ve-level {
		stroke: var(--ig-vx);
		stroke-width: 2;
	}
	[data-velintro] .ve-glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	[data-velintro] .ve-thread {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-velintro] .ve-stone {
		fill: color-mix(in oklab, var(--ig-v) 16%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	[data-velintro] .ve-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-velintro] .ve-pill {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-velintro] .ve-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-velintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="cloth"]')!;
			const rows = ['a', 'b', 'm'].map((k) => [...card.querySelectorAll<SVGElement>(`[data-row="${k}"] .ve-seg`)]);
			const ticks = [...card.querySelectorAll<SVGElement>('[data-row="m"] .ve-tick')];
			const counts = ['[data-na]', '[data-nb]', '[data-nm]'].map((s) => card.querySelector<SVGTextElement>(s)!);
			// each row is laid out during its own third of the run
			scene(card, 8, (x) => {
				rows.forEach((segs, r) => {
					const u = Math.min(1, Math.max(0, (x - r * 0.31) / 0.26));
					const shown = Math.floor(u * segs.length + 1e-9);
					segs.forEach((s, i) => (s.style.opacity = i < shown ? '1' : '0'));
					if (r < 2) counts[r].textContent = shown ? String(shown) : '';
					else {
						ticks.forEach((t) => (t.style.opacity = shown ? '1' : '0'));
						counts[r].textContent = u >= 1 ? '2,4 м' : shown ? `${shown} м` : '';
					}
				});
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="stone"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const water = $<SVGRectElement>('[data-water]');
			const level = $<SVGLineElement>('[data-level]');
			const stone = $<SVGPathElement>('[data-stone]');
			const thread = $<SVGLineElement>('[data-thread]');
			const now = $<SVGTextElement>('[data-now]');
			const vol = $<SVGTextElement>('[data-vol]');
			const y = (v: number) => 208 - v * 1.6; // the height of the mark of v millilitres
			scene(card, 6, (x) => {
				const sy = 44 + (176 - 44) * ease(x / 0.8); // the centre of the stone
				// the part of the stone under water (its height is 32 px), found together with the level it raises
				let v = 60;
				for (let k = 0; k < 6; k++) v = 60 + 25 * ease((sy + 16 - y(v)) / 32);
				const yl = y(v);
				water.setAttribute('y', yl.toFixed(1));
				water.setAttribute('height', (216 - yl).toFixed(1));
				level.setAttribute('y1', yl.toFixed(1));
				level.setAttribute('y2', yl.toFixed(1));
				stone.setAttribute('transform', `translate(170 ${sy.toFixed(1)})`);
				thread.setAttribute('y2', (sy - 14).toFixed(1));
				now.textContent = `${Math.round(v)} мл`;
				vol.textContent = x >= 0.8 ? 'объём камня 25 см³' : '';
			});
		}
	}
</script>
