---
/**
 * Two short looping opening scenes of «Физические величины и их измерение». No terms of the chapter in the pictures.
 * Height: every year the parents mark on the door frame how tall the child is: 122 см at 7, 133 см at 9, 151 см at
 *   12 (about the medians of the WHO growth charts). The child is drawn with the shared people kit, in profile, its
 *   back to the frame; before the tape measure comes it steps aside in three steps. A book laid flat on the head touches the frame, a pencil line is
 *   drawn under it. Then a tape measure rises from the floor along the frame and gives each mark in centimetres.
 *   Heights to scale: 1 px per centimetre, the floor at y = 216.
 * Stone: a stone on a thread is lowered into a measuring cylinder; the water rises from 60 мл to 85 мл as the
 *   stone goes under (the rise is proportional to the part of the stone under water): its volume is 25 см³.
 *   The scale: numbers every 20 мл, a division is 5 мл; 1,6 px per millilitre.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

const F = 216; // the floor
const AGES = [
	{ age: '7 лет', h: 122 },
	{ age: '9 лет', h: 133 },
	{ age: '12 лет', h: 151 },
];
const ml = (v: number) => 208 - v * 1.6;
---

<KitStyles />
<IntroFrame data-velintro>
	<div class="intro__card" data-scene="height">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ребёнок растёт, и каждый год на дверном косяке появляется отметка его роста: в 7, 9 и 12 лет. Потом рулетка показывает высоту отметок: 122, 133 и 151 сантиметр">
			<rect class="ve-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="ve-door" x="176" y="18" width="114" height={F - 18}></rect>
			<rect class="ve-jamb" x="162" y="10" width="14" height={F - 10}></rect>
			<rect class="ve-jamb" x="290" y="10" width="14" height={F - 10}></rect>
			<rect class="ve-jamb" x="162" y="10" width="142" height="8"></rect>
			<rect class="ve-floor" x="0" y={F} width="360" height={240 - F}></rect>
			{AGES.map((a, i) => <line class="ve-mark" data-mark={i} x1="162" x2="162" y1={F - a.h} y2={F - a.h} />)}
			{AGES.map((a, i) => <text class="ve-age" data-age={i} x="192" y={F - a.h + 4} opacity="0">{a.age}</text>)}
			<!-- the child (the shared people kit), its back to the door frame; scaled as it grows -->
			<g data-kid><g data-kidfig></g></g>
			<rect class="ve-book" data-book x="122" y="0" width="54" height="5" rx="1" opacity="0"></rect>
			<g data-tape opacity="0">
				<rect class="ve-tape" data-band x="177" y={F} width="9" height="0"></rect>
				<path class="ve-tick" data-tticks></path>
				<rect class="ve-case" x="176" y={F - 16} width="22" height="16" rx="4"></rect>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Год за годом родители отмечают на дверном косяке{' '}
				<More term="рост ребёнка">
					Высоту отметок измеряют рулеткой от пола: 122&nbsp;см в 7&nbsp;лет, 133&nbsp;см в 9&nbsp;лет, 151&nbsp;см в 12&nbsp;лет. Результат измерения — число и единица. Об этом — в разделе{' '}
					<a href="#измерение-и-единицы">«Измерение и единицы»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="stone">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Камень на нитке опускают в мензурку с водой. Уровень воды поднимается с 60 до 85 миллилитров">
			<rect class="ve-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="ve-counter" x="0" y="216" width="360" height="24"></rect>
			<rect class="ve-water" data-water x="132" y={ml(60)} width="76" height={208 - ml(60) + 8}></rect>
			<line class="ve-thread" data-thread x1="170" y1="0" x2="170" y2="40"></line>
			<path class="ve-stone" data-stone d="M-17 -6 L-9 -15 L6 -16 L16 -8 L18 5 L9 15 L-6 16 L-16 8 Z"></path>
			<path class="ve-glass" d="M132 28 V216 H208 V28 M120 222 H220 L208 216 H132 Z"></path>
			<line class="ve-level" data-level x1="132" x2="208" y1={ml(60)} y2={ml(60)}></line>
			{
				Array.from({ length: 21 }, (_, i) => i * 5).map((v) => (
					<>
						<line class="ve-tick" x1="132" x2={132 + (v % 20 === 0 ? 26 : v % 10 === 0 ? 18 : 12)} y1={ml(v)} y2={ml(v)} />
						{v % 20 === 0 && (
							<text class="ve-small" x="126" y={ml(v) + 4} text-anchor="end">
								{v}
							</text>
						)}
					</>
				))
			}
			<text class="ve-small" x="126" y="30" text-anchor="end">мл</text>
			<rect class="ve-pill" x="232" y="60" width="118" height="92" rx="10"></rect>
			<text class="ve-small" x="242" y="80">было</text>
			<text class="ve-num" x="242" y="97">60 мл</text>
			<text class="ve-small" x="242" y="118">стало</text>
			<text class="ve-num" x="242" y="135" data-now>60 мл</text>
			<text class="ve-label" x="232" y="176" data-vol></text>
		</svg>
		<div class="intro__foot">
			<p>
				Камень неправильной формы линейкой не измерить. Его опускают в воду и смотрят,{' '}
				<More term="на сколько поднялся уровень">
					Камень вытесняет столько воды, каков его объём. Было 60&nbsp;мл, стало 85&nbsp;мл — значит, объём камня 25&nbsp;мл, или 25&nbsp;см³. Сосуд со шкалой для измерения объёма называют мензуркой. Как читать шкалу — в разделе{' '}
					<a href="#измерительные-приборы">«Измерительные приборы»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-velintro] .ve-room {
		fill: var(--sl-color-bg);
	}
	[data-velintro] .ve-counter {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-velintro] .ve-floor {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-velintro] .ve-door {
		fill: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-6));
	}
	[data-velintro] .ve-jamb {
		fill: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
	}
	[data-velintro] .ve-mark {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
	}
	[data-velintro] .ve-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-velintro] .ve-age {
		font-size: 10.5px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-velintro] .ve-book {
		fill: var(--ig-vy);
	}
	[data-velintro] .ve-tape {
		fill: var(--ig-v);
	}
	[data-velintro] .ve-case {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-velintro] .ve-tick {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-velintro] .ve-water {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
	}
	[data-velintro] .ve-level {
		stroke: var(--ig-vx);
		stroke-width: 2;
	}
	[data-velintro] .ve-glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	[data-velintro] .ve-thread {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-velintro] .ve-stone {
		fill: color-mix(in oklab, var(--ig-v) 16%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	[data-velintro] .ve-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-velintro] .ve-pill {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-velintro] .ve-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure } from '@components/people/body';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-velintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="height"]')!;
			const $ = <T extends Element>(q: string) => card.querySelector<T>(q)!;
			const F = 216;
			const H = [122, 133, 151];
			const kid = $<SVGGElement>('[data-kid]');
			const book = $<SVGRectElement>('[data-book]');
			// the child at 12 (151 см, 1 px per см; the group is scaled down for the younger ages), facing left, the back
			// of the head at the door frame; it steps aside to the left in three steps (near, far, near: feet together)
			const fig = figure($<SVGGElement>('[data-kidfig]'), { s: 1, H: 151, age: 'teen', clothes: 'indoor', shirt: 'hm-blue', hair: 'short', dir: -1, name: 'child' });
			const X0 = 150; // the hip joint while standing at the frame
			const ANK = F - 7 * (151 / 172);
			const poseKid = (D: number, p: number) => {
				// p: 0…1 of the walk; three steps of equal time; D: how far it goes, px (in the group's units)
				const k = Math.min(2, Math.floor(p * 3));
				const e = ease(p * 3 - k);
				const pos = [0, 0];
				const lift = [0, 0];
				if (p > 0) {
					if (k === 0) pos[0] = (D / 2) * e;
					if (k >= 1) pos[0] = D / 2;
					if (k === 1) pos[1] = D * e;
					if (k === 2) (pos[1] = D), (pos[0] = D / 2 + (D / 2) * e);
					const sw = k === 1 ? 1 : 0;
					if (p < 1) lift[sw] = 0.035 * 151 * Math.sin(Math.PI * e);
				}
				const swing = p > 0 && p < 1 ? (k === 1 ? 1 : 0) : -1;
				const mid = (pos[0] + pos[1]) / 2;
				const arm = p > 0 && p < 1 ? 0.25 * Math.sin(Math.PI * p * 3) : 0;
				fig.pose({
					// the hip goes a little lower while walking, so that the legs reach the feet half a step apart
					hip: { x: X0 - mid, y: F - 74.5 + (p > 0 && p < 1 ? 4.5 * Math.sin(Math.PI * p) : 0) },
					lean: 0.02,
					ankles: [
						{ x: X0 - 2 - pos[0], y: ANK - lift[0] },
						{ x: X0 + 2 - pos[1], y: ANK - lift[1] },
					],
					feet: [lift[0] > 0.5 ? 0.15 : 0, lift[1] > 0.5 ? 0.15 : 0],
					planted: [p < 1 && swing !== 0, p < 1 && swing !== 1], // after the walk it stands still (the loop then starts again from the frame)
					hands: [
						{ arm: [Math.PI / 2 - arm, 0.15], pose: 'relaxed' },
						{ arm: [Math.PI / 2 + arm, 0.15], pose: 'relaxed' },
					],
				});
			};
			const marks = H.map((_, i) => $<SVGLineElement>(`[data-mark="${i}"]`));
			const ages = H.map((_, i) => $<SVGTextElement>(`[data-age="${i}"]`));
			const AGE = ['7 лет', '9 лет', '12 лет'];
			const tape = $<SVGGElement>('[data-tape]');
			const band = $<SVGRectElement>('[data-band]');
			const tticks = $<SVGPathElement>('[data-tticks]');
			const u = (x: number, a: number, b: number) => Math.min(1, Math.max(0, (x - a) / (b - a)));
			// each year: the book comes down on the head, the line is drawn, the book goes; between the years the child grows
			const T = [0, 0.27, 0.54];
			scene(card, 9, (x) => {
				let h = H[0];
				if (x > 0.15) h = H[0] + (H[1] - H[0]) * ease(u(x, 0.15, 0.25));
				if (x > 0.42) h = H[1] + (H[2] - H[1]) * ease(u(x, 0.42, 0.52));
				// it steps aside by 92 px (at 12, the group at full size) in 0,72 с
				// the group grows about the point between the feet, so that they stay where they stand
				kid.setAttribute('transform', `translate(${X0} ${F}) scale(${(h / 151).toFixed(4)}) translate(-${X0} -${F})`);
				poseKid(92, u(x, 0.66, 0.74));
				let bookOn = 0;
				T.forEach((t0, i) => {
					const on = u(x, t0, t0 + 0.04) * (1 - u(x, t0 + 0.11, t0 + 0.13));
					if (on > 0) {
						bookOn = on;
						book.setAttribute('y', (F - H[i] - 5 - 10 * (1 - on)).toFixed(1));
					}
					marks[i].setAttribute('x2', (162 + 14 * u(x, t0 + 0.05, t0 + 0.09)).toFixed(1));
					ages[i].setAttribute('opacity', String(u(x, t0 + 0.08, t0 + 0.1)));
				});
				book.setAttribute('opacity', bookOn.toFixed(2));
				// the tape measure, from the floor up to the highest mark
				const top = H[2] * ease(u(x, 0.76, 0.96));
				tape.setAttribute('opacity', String(u(x, 0.73, 0.76)));
				band.setAttribute('y', (F - 16 - Math.max(0, top - 16)).toFixed(1));
				band.setAttribute('height', Math.max(0, top - 16).toFixed(1));
				let d = '';
				for (let c = 20; c <= top; c += 10) d += `M177 ${F - c} h${c % 50 === 0 ? 9 : 4}`;
				tticks.setAttribute('d', d);
				H.forEach((hh, i) => (ages[i].textContent = top >= hh - 0.5 ? `${AGE[i]} — ${hh} см` : AGE[i]));
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="stone"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const water = $<SVGRectElement>('[data-water]');
			const level = $<SVGLineElement>('[data-level]');
			const stone = $<SVGPathElement>('[data-stone]');
			const thread = $<SVGLineElement>('[data-thread]');
			const now = $<SVGTextElement>('[data-now]');
			const vol = $<SVGTextElement>('[data-vol]');
			const y = (v: number) => 208 - v * 1.6; // the height of the mark of v millilitres
			scene(card, 6, (x) => {
				const sy = 44 + (176 - 44) * ease(x / 0.8); // the centre of the stone
				// the part of the stone under water (its height is 32 px), found together with the level it raises
				let v = 60;
				for (let k = 0; k < 6; k++) v = 60 + 25 * ease((sy + 16 - y(v)) / 32);
				const yl = y(v);
				water.setAttribute('y', yl.toFixed(1));
				water.setAttribute('height', (216 - yl).toFixed(1));
				level.setAttribute('y1', yl.toFixed(1));
				level.setAttribute('y2', yl.toFixed(1));
				stone.setAttribute('transform', `translate(170 ${sy.toFixed(1)})`);
				thread.setAttribute('y2', (sy - 14).toFixed(1));
				now.textContent = `${Math.round(v)} мл`;
				vol.textContent = x >= 0.8 ? 'объём камня 25 см³' : '';
			});
		}
	}
</script>
