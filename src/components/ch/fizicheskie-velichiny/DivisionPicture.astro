---
/**
 * Picture «Цена деления термометра»: a thermometer from 0 to 40 °C, numbers every 10 °C and five divisions between
 * them (4 px per degree). The strokes 10 and 20 are gold, the five divisions between them are counted in blue, and
 * the three steps of the text are written beside it: (20 − 10) : 5 = 2 °C. The column stands two divisions above
 * 10: 10 + 2 · 2 = 14 °C. (Other numbers than in ScaleLab's first task and the example problem.)
 */
import G7Styles from '../g7/G7Styles.astro';

const y = (t: number) => 190 - t * 4;
const T = 14;
const ticks = Array.from({ length: 21 }, (_, i) => i * 2);
---

<G7Styles />
<figure class="g7 g7--pic div not-content">
	<svg class="g7__svg div__svg" viewBox="0 0 340 226" role="img" aria-label="Термометр: между штрихами 10 и 20 градусов пять делений, цена деления 2 градуса, столбик показывает 14 градусов">
		<rect class="div__plate" x="36" y="16" width="70" height="196" rx="8"></rect>
		<rect class="div__tube" x="62" y="22" width="12" height={y(0) - 22 + 6} rx="6"></rect>
		<rect class="div__red" x="65" y={y(T)} width="6" height={y(0) - y(T) + 8}></rect>
		<circle class="div__red" cx="68" cy="200" r="10"></circle>
		<circle class="div__bulb" cx="68" cy="200" r="10"></circle>
		{
			ticks.map((t) => (
				<line class:list={['div__tick', (t === 10 || t === 20) && 'is-gold']} x1="76" x2={t % 10 === 0 ? 90 : 84} y1={y(t)} y2={y(t)} />
			))
		}
		{
			[0, 10, 20, 30, 40].map((t) => (
				<text class:list={['div__num', (t === 10 || t === 20) && 'is-gold']} x="57" y={y(t) + 4} text-anchor="end">
					{t}
				</text>
			))
		}
		<text class="t-small" x="57" y="12" text-anchor="end">°C</text>
		{
			[1, 2, 3, 4, 5].map((k) => (
				<text class="div__k" x="97" y={y(10 + 2 * k - 1) + 3.5} text-anchor="middle">
					{k}
				</text>
			))
		}
		<path class="div__brace" d={`M104 ${y(20)} h4 V${y(10)} h-4`}></path>
		<text class="div__step is-gold" x="122" y="30">1. Штрихи с числами 10 и 20</text>
		<text class="div__step" x="122" y="52">2. 20 °C − 10 °C = 10 °C</text>
		<text class="div__step is-blue" x="122" y="74">3. Между ними 5 делений:</text>
		<text class="div__step" x="138" y="94">10 °C : 5 = 2 °C</text>
		<rect class="div__pill" x="118" y="104" width="196" height="26" rx="8"></rect>
		<text class="div__res" x="216" y="122" text-anchor="middle">Цена деления 2 °C</text>
		<text class="div__step" x="122" y="162">Столбик на 2 деления выше</text>
		<text class="div__step" x="122" y="180">штриха 10:</text>
		<text class="div__step div__strong" x="122" y="202">10 + 2 · 2 = 14 °C</text>
	</svg>
	<figcaption class="g7__caption">Цену деления находят по двум соседним штрихам с числами. Показание — число у штриха под столбиком плюс цена деления, умноженная на число делений до верха столбика.</figcaption>
</figure>

<style is:global>
	.div__svg {
		max-width: 30rem;
		margin-inline: auto;
	}
	.div__plate {
		fill: var(--sl-color-gray-6);
		stroke: var(--g7-faint);
	}
	.div__tube {
		fill: var(--g7-paper);
		stroke: var(--g7-glass);
		stroke-width: 1.5;
	}
	.div__red {
		fill: var(--g7-red);
	}
	.div__bulb {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 1.5;
	}
	.div__tick {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.div__tick.is-gold {
		stroke: var(--g7-gold);
		stroke-width: 2.6;
	}
	.g7__svg .div__num {
		font-size: 12px;
		font-weight: 700;
		fill: var(--g7-ink);
	}
	.g7__svg .div__num.is-gold,
	.g7__svg .div__step.is-gold {
		fill: var(--g7-gold);
	}
	.g7__svg .div__k {
		font-size: 8.5px;
		font-weight: 700;
		fill: var(--g7-blue);
	}
	.g7__svg .div__step.is-blue {
		fill: var(--g7-blue);
	}
	.div__brace {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.6;
	}
	.g7__svg .div__step {
		font-size: 13px;
		fill: var(--sl-color-gray-1);
	}
	.g7__svg .div__strong {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.div__pill {
		fill: color-mix(in srgb, var(--g7-gold) 20%, transparent);
		stroke: var(--g7-gold);
	}
	.g7__svg .div__res {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
</style>
