---
/**
 * Two short looping opening scenes of «Три состояния вещества». No terms of the chapter in the pictures.
 * Pot: a piece of ice in a pot on a burner. The thermometer goes from −10 °C to 0 °C, stays at 0 °C while the ice
 *   melts, goes to 100 °C, and stays at 100 °C while the water boils away as steam. The melted water takes 0,92
 *   of the volume of the ice (the densities of ice and water are 917 and 1000 кг/м³).
 * Jug: 200 мл of juice run from a tall narrow jug with a tap into a wide bowl. The areas of the juice in the
 *   drawing are equal (40 px × 120 px in the jug, 148 px × 32,4 px in the bowl): the volume stays, the shape changes.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-stateintro>
	<div class="intro__card" data-scene="pot">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Кусок льда в кастрюле на плите тает и превращается в воду, а вода закипает и превращается в пар">
			<rect class="si-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="si-stove" x="60" y="204" width="240" height="36" rx="4"></rect>
			<path class="si-flame" d="M130 204 q6 -14 12 0 M156 204 q6 -14 12 0 M182 204 q6 -14 12 0 M208 204 q6 -14 12 0"></path>
			<rect class="si-water" data-water x="104" y="190" width="152" height="0"></rect>
			<rect class="si-ice" data-ice x="140" y="120" width="80" height="70" rx="4"></rect>
			<g data-bubbles>{[120, 150, 176, 204, 236].map((x, i) => <circle class="si-bubble" cx={x} cy="180" r={2 + (i % 2)} />)}</g>
			<path class="si-pot" d="M100 96 V190 q0 6 6 6 H254 q6 0 6 -6 V96 M84 110 H100 M260 110 H276"></path>
			<g data-steam>
				<path class="si-steam" d="M140 88 q-10 -14 0 -28 q10 -14 0 -28"></path>
				<path class="si-steam" d="M180 84 q-10 -14 0 -28 q10 -14 0 -28"></path>
				<path class="si-steam" d="M220 88 q-10 -14 0 -28 q10 -14 0 -28"></path>
			</g>
			<rect class="si-pill" x="10" y="10" width="112" height="42" rx="9"></rect>
			<text class="si-small" x="20" y="27">температура</text>
			<text class="si-num" x="20" y="45" data-temp>−10 °C</text>
			<text class="si-word" x="20" y="74" data-word>лёд</text>
		</svg>
		<div class="intro__foot">
			<p>
				Кусок льда в кастрюле на плите превращается в воду, а вода — в пар.{' '}
				<More term="Вещество остаётся тем же">
					Лёд, вода и водяной пар состоят из одинаковых молекул. Различается только то, как эти молекулы расположены и как движутся. Пока лёд тает, термометр показывает 0&nbsp;°C, а пока вода кипит — 100&nbsp;°C. Об этом — в разделе{' '}
					<a href="#три-состояния-вещества">«Три состояния вещества»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="jug">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Сок вытекает из высокого узкого кувшина в широкую миску: форма меняется, а объём остаётся прежним, 200 миллилитров">
			<rect class="si-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="si-table" x="0" y="214" width="360" height="26"></rect>
			<!-- the jug on a stand -->
			<rect class="si-stand" x="40" y="150" width="76" height="64" rx="3"></rect>
			<rect class="si-juice" data-j1 x="58" y="30" width="40" height="120"></rect>
			<path class="si-glass" d="M58 22 V150 H98 V22"></path>
			<path class="si-tap" d="M98 144 H164 V152"></path>
			<rect class="si-juice" data-stream x="161" y="152" width="6" height="0"></rect>
			<!-- the bowl -->
			<rect class="si-juice" data-j2 x="151" y="207" width="148" height="0"></rect>
			<path class="si-glass" d="M148 160 V204 q0 6 6 6 H296 q6 0 6 -6 V160"></path>
			<text class="si-word" x="78" y="16" text-anchor="middle" data-v1>200 мл</text>
			<text class="si-word" x="225" y="150" text-anchor="middle" data-v2></text>
		</svg>
		<div class="intro__foot">
			<p>
				Сок из высокого кувшина вылили в широкую миску:{' '}
				<More term="форма у него теперь другая, а объём тот же">
					Жидкость легко меняет форму: она принимает форму сосуда, в который её налили. А сжать её или растянуть почти невозможно: свой объём она сохраняет. Об этом — в разделе{' '}
					<a href="#три-состояния-вещества">«Три состояния вещества»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-stateintro] .si-room {
		fill: var(--sl-color-bg);
	}
	[data-stateintro] .si-stove {
		fill: var(--sl-color-gray-5);
	}
	[data-stateintro] .si-flame {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-stateintro] .si-water {
		fill: color-mix(in srgb, var(--ig-vx) 34%, transparent);
	}
	[data-stateintro] .si-ice {
		fill: hsl(205, 55%, 86%);
		stroke: var(--ig-vx);
		stroke-width: 1.2;
	}
	[data-stateintro] .si-bubble {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1;
		opacity: 0;
	}
	[data-stateintro] .si-pot {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-stateintro] .si-steam {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-linecap: round;
		opacity: 0;
	}
	[data-stateintro] .si-pill {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-stateintro] .si-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-stateintro] .si-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-stateintro] .si-word {
		font-size: 13px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-stateintro] .si-table {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-stateintro] .si-stand {
		fill: color-mix(in oklab, var(--ig-v) 34%, var(--sl-color-gray-4));
	}
	[data-stateintro] .si-juice {
		fill: hsl(32, 95%, 58%);
	}
	[data-stateintro] .si-glass {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	[data-stateintro] .si-tap {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 5;
		stroke-linejoin: round;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	for (const root of document.querySelectorAll<HTMLElement>('[data-stateintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="pot"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const water = $<SVGRectElement>('[data-water]');
			const ice = $<SVGRectElement>('[data-ice]');
			const bubbles = [...card.querySelectorAll<SVGCircleElement>('[data-bubbles] circle')];
			const steam = [...card.querySelectorAll<SVGPathElement>('[data-steam] path')];
			const temp = $<SVGTextElement>('[data-temp]');
			const word = $<SVGTextElement>('[data-word]');
			// the ice: 80 × 70 px; melted, it gives 0,92 of this area as water in a pot 152 px wide
			const FULL = (80 * 70 * 0.92) / 152;
			scene(card, 10, (x) => {
				const warm = clamp(x / 0.12); // −10 → 0 °C
				const melt = clamp((x - 0.12) / 0.3); // at 0 °C
				const heat = clamp((x - 0.42) / 0.26); // 0 → 100 °C
				const boil = clamp((x - 0.68) / 0.32); // at 100 °C
				const T = warm < 1 ? -10 + 10 * warm : melt < 1 ? 0 : heat < 1 ? 100 * heat : 100;
				temp.textContent = `${T < 0 ? '−' : ''}${Math.abs(Math.round(T))} °C`;
				// the ice keeps its width and gets lower; the water it gives is added to the pot
				const hIce = 70 * (1 - melt);
				const level = FULL * melt * (1 - 0.55 * boil);
				ice.setAttribute('height', hIce.toFixed(1));
				ice.setAttribute('y', (190 - hIce).toFixed(1));
				ice.style.opacity = melt < 1 ? '1' : '0';
				water.setAttribute('height', level.toFixed(1));
				water.setAttribute('y', (190 - level).toFixed(1));
				bubbles.forEach((b, i) => {
					const ph = (x * 14 + i * 0.37) % 1;
					b.setAttribute('cy', (188 - ph * Math.max(4, level - 4)).toFixed(1));
					b.style.opacity = boil > 0 ? '0.9' : '0';
				});
				steam.forEach((s, i) => {
					const ph = (x * 6 + i * 0.33) % 1;
					s.style.opacity = boil > 0 ? String(0.8 * Math.sin(Math.PI * ph)) : '0';
					s.setAttribute('transform', `translate(0 ${(10 - 20 * ph).toFixed(1)})`);
				});
				word.textContent = melt <= 0 ? 'лёд' : melt < 1 ? 'лёд тает' : boil <= 0 ? 'вода' : 'вода кипит: пар';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="jug"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const j1 = $<SVGRectElement>('[data-j1]');
			const j2 = $<SVGRectElement>('[data-j2]');
			const stream = $<SVGRectElement>('[data-stream]');
			const v1 = $<SVGTextElement>('[data-v1]');
			const v2 = $<SVGTextElement>('[data-v2]');
			scene(card, 7, (x) => {
				const u = clamp((x - 0.08) / 0.8); // the share of the juice that has run out
				const h1 = 120 * (1 - u);
				const h2 = 32.4 * u; // 148 px wide: the same area as 40 px × 120 px in the jug
				j1.setAttribute('height', h1.toFixed(1));
				j1.setAttribute('y', (150 - h1).toFixed(1));
				j2.setAttribute('height', h2.toFixed(1));
				j2.setAttribute('y', (207 - h2).toFixed(1));
				const flowing = u > 0 && u < 1;
				stream.setAttribute('height', flowing ? (207 - h2 - 152).toFixed(1) : '0');
				v1.textContent = `${Math.round(200 * (1 - u))} мл`;
				v2.textContent = u > 0 ? `${Math.round(200 * u)} мл` : '';
			});
		}
	}
</script>
