---
/**
 * Picture «Как расположены молекулы»: three panels with the same number of molecules per panel area for the solid
 * and the liquid (they are almost equally dense) and far fewer for the gas. Solid: a regular lattice. Liquid: the
 * same molecules close together but without order. Gas: molecules far apart. A scheme: in a real gas at room
 * conditions the distances are about ten times the size of a molecule. The positions are fixed (a seeded generator).
 */
import G7Styles from '../g7/G7Styles.astro';

let seed = 21;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const R = 6.5;
// solid: a triangular lattice
const solid: [number, number][] = [];
for (let row = 0; row < 7; row++) for (let col = 0; col < 8; col++) solid.push([22 + col * 14 + (row % 2 ? 7 : 0), 22 + row * 12.2]);
// liquid: the lattice shaken, with a few gaps; rejected when two molecules overlap
const liquid: [number, number][] = [];
let tries = 0;
while (liquid.length < 50 && tries++ < 6000) {
	const p: [number, number] = [14 + rnd() * 122, 34 + rnd() * 72];
	if (liquid.every(([x, y]) => Math.hypot(x - p[0], y - p[1]) > 2 * R + 0.6)) liquid.push(p);
}
const gas: [number, number][] = [];
tries = 0;
while (gas.length < 7 && tries++ < 2000) {
	const p: [number, number] = [14 + rnd() * 122, 14 + rnd() * 92];
	if (gas.every(([x, y]) => Math.hypot(x - p[0], y - p[1]) > 34)) gas.push(p);
}
const panels = [
	{ name: 'твёрдое тело', note: 'молекулы в строгом порядке, колеблются на своих местах', pts: solid, arrows: false },
	{ name: 'жидкость', note: 'молекулы вплотную, но без порядка: меняются местами', pts: liquid, arrows: false },
	{ name: 'газ', note: 'молекулы далеко друг от друга, летают по всему сосуду', pts: gas, arrows: true },
];
---

<G7Styles />
<figure class="g7 g7--pic thr not-content">
	<div class="g7__grid is-three">
		{
			panels.map((p) => (
				<div>
					<svg class="g7__svg" viewBox="0 0 150 120" role="img" aria-label={`${p.name}: ${p.note}`}>
						{p.pts.map(([x, y], i) => (
							<>
								<circle class="thr__mol" cx={x} cy={y} r={R} />
								{p.arrows && <line class="thr__v" x1={x} y1={y} x2={x + 16 * Math.cos(i * 2.4)} y2={y + 16 * Math.sin(i * 2.4)} />}
							</>
						))}
					</svg>
					<p class="thr__name">{p.name}</p>
					<p class="thr__note">{p.note}</p>
				</div>
			))
		}
	</div>
</figure>

<style is:global>
	.thr__mol {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-5));
		stroke: var(--g7-blue);
		stroke-width: 0.8;
	}
	.thr__v {
		stroke: var(--g7-gold);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.thr__name {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.thr__note {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.35;
		color: var(--sl-color-gray-2);
	}
</style>
