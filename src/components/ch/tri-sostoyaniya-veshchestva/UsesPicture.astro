---
/**
 * Picture «Где это встречается»: four small panels, one for each item of the list, in its order.
 *
 * Сжатый газ — a standard steel cylinder of 40 л (outer diameter 219 мм, body 1,39 м tall) filled to 150 атм holds
 *   40 л · 150 = 6000 л ≈ 6 м³ of gas at ordinary pressure (oxygen: about 6 м³), a cube with an edge of ∛6 ≈ 1,82 м.
 *   Both are drawn side by side at 75 px per metre (the cube in an oblique view, its depth shortened).
 * Тормоз автомобиля — a scheme, not to scale: pedal → rod → piston of the main cylinder → liquid in a pipe →
 *   piston of the wheel cylinder → brake pad → disc of the wheel. The liquid does not compress, so the volume pushed
 *   in at one end comes out at the other: for round bores the travels go as the inverse squares of the diameters.
 *   Drawn bores: 14 px (main), 22 px (wheel), the pipe 5 px; the main piston moves 9,9 px, the wheel piston
 *   9,9 · (14/22)² = 4,0 px (exactly the gap to the disc), the liquid in the pipe 9,9 · (14/5)² ≈ 78 px (shown by the
 *   moving dashes). Cycle 4 s: press, hold, release.
 * Вода → пар — 1 л of water (a cube of 10 см) boils at 100 °C and ordinary pressure; 1 кг of steam then takes
 *   1 / 0,598 кг/м³ ≈ 1,67 м³ ≈ 1700 л. The steam lifts a weightless piston in a cylinder of 1,2 м inner diameter
 *   (area 1,131 м²) to 1,7 / 1,131 ≈ 1,5 м. The same scale as the gas cylinder: 75 px per metre, so the 10 см pot is
 *   7,5 px. Boiling (minutes in reality) takes 4 s; the pot's water level falls as the piston rises.
 * Вода замерзает — a full, closed glass bottle of 0,5 л (about 0,9 px per мм). Ice (916,7 кг/м³) takes
 *   999,8 / 916,7 ≈ 1,09 times the volume of the water (999,8 кг/м³ at 0 °C): 500 мл of water would become
 *   545 мл of ice, and the bottle cracks. The ice grows from the walls inward (drawn simply as a shrinking water core);
 *   freezing (hours in reality) takes 4 s.
 * The caption says what is to scale and what is not.
 */
import G7Styles from '../g7/G7Styles.astro';

const S = 75; // px per metre in the gas and the steam panels
const G = 232; // the floor
// gas: cylinder 0,219 × 1,39 м; the cube 1,817 м
const cylW = 0.219 * S;
const cylH = 1.39 * S;
const cx0 = 14;
const cube = Math.cbrt(6) * S;
const k0 = 50; // the cube's front face starts here
const dep = 0.25 * cube; // oblique depth (shortened)
// brake
const PIV = { x: 36, y: 60 };
const ROD_Y = 130;
const S1 = 4 / (14 / 22) ** 2; // travel of the main piston that closes the 4 px gap at the wheel
// steam: the cylinder of 1,2 м, the piston up to 1,503 м
const sx0 = 128;
const sw = 1.2 * S;
const stop = G - 1.62 * S;
// bottle
const bottle = 'M88.5 232 V106 Q88.5 92 109.2 82 V52 H130.8 V82 Q151.5 92 151.5 106 V232 Z';
const inner = 'M91.5 229 V107 Q91.5 94 112.2 84 V55 H127.8 V84 Q148.5 94 148.5 107 V229 Z';
---

<G7Styles />
<figure class="g7 g7--pic use not-content" data-usepic>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 240 262" role="img" aria-label="Баллон на 40 литров и куб с ребром 1,8 метра: столько места занял бы газ из баллона при обычном давлении">
			<text class="t-title" x="120" y="18" text-anchor="middle">Сжатый газ</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">баллон 40 л</text>
			<path class="use__gas" d={`M${k0} ${G} V${G - cube} L${k0 + dep} ${G - cube - dep} H${k0 + cube + dep} V${G - dep} L${k0 + cube} ${G} Z`}></path>
			<path class="use__gas-edge" d={`M${k0} ${G - cube} H${k0 + cube} V${G} M${k0 + cube} ${G - cube} L${k0 + cube + dep} ${G - cube - dep}`}></path>
			<rect class="use__steel" x={cx0} y={G - cylH} width={cylW} height={cylH} rx={cylW / 2}></rect>
			<rect class="use__steel-dark" x={cx0 + cylW / 2 - 3} y={G - cylH - 8} width="6" height="9" rx="1"></rect>
			<text class="t-small" x={cx0 + cylW / 2} y={G - cylH - 28} text-anchor="middle">баллон</text>
			<text class="t-small" x={cx0 + cylW / 2} y={G - cylH - 15} text-anchor="middle">40 л</text>
			<text class="t-strong" x={k0 + cube / 2} y={G - cube / 2 - 6} text-anchor="middle">6 м³ газа</text>
			<text class="t-small" x={k0 + cube / 2} y={G - cube / 2 + 10} text-anchor="middle">при обычном</text>
			<text class="t-small" x={k0 + cube / 2} y={G - cube / 2 + 23} text-anchor="middle">давлении</text>
			<line class="ln" x1="4" x2="236" y1={G} y2={G}></line>
			<path class="ln" d={`M${k0} ${G + 13} H${k0 + cube / 2 - 20} M${k0 + cube / 2 + 20} ${G + 13} H${k0 + cube} M${k0} ${G + 9} V${G + 17} M${k0 + cube} ${G + 9} V${G + 17}`}></path>
			<text class="t-small" x={k0 + cube / 2} y={G + 17} text-anchor="middle">1,8 м</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 240 262" role="img" aria-label="Тормоз автомобиля: педаль вдвигает поршень, жидкость по трубке передаёт нажим поршню у колеса, и колодка прижимается к диску">
			<text class="t-title" x="120" y="18" text-anchor="middle">Тормоз автомобиля</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">жидкость передаёт нажим</text>
			<!-- the main cylinder: bore 14 px -->
			<rect class="use__wall" x="68" y="121" width="52" height="18" rx="2"></rect>
			<rect class="use__liquid" x="80" y="123" width="40" height="14" data-mliq></rect>
			<rect class="use__steel-dark" x="74" y="123" width="6" height="14" data-mpis></rect>
			<!-- the pipe -->
			<path class="use__pipe" d="M120 130 H142 V150 H164"></path>
			<path class="use__pipe-liq" d="M120 130 H142 V150 H164"></path>
			<path class="use__flow" d="M120 130 H142 V150 H164" data-flow></path>
			<!-- the wheel cylinder: bore 22 px -->
			<rect class="use__wall" x="162" y="137" width="28" height="26" rx="2"></rect>
			<rect class="use__liquid" x="164" y="139" width="18" height="22" data-wliq></rect>
			<rect class="use__steel-dark" x="182" y="139" width="6" height="22" data-wpis></rect>
			<rect class="use__pad" x="188" y="132" width="6" height="36" rx="1" data-pad></rect>
			<!-- the disc of the wheel, seen edge-on -->
			<rect class="use__steel" x="198" y="92" width="6" height="116" rx="1"></rect>
			<rect class="use__steel-dark" x="204" y="141" width="14" height="18" rx="2"></rect>
			<!-- the pedal -->
			<g data-pedal>
				<line class="use__lever" x1={PIV.x} y1={PIV.y} x2={PIV.x} y2="186"></line>
				<line class="use__lever use__lever--pad" x1={PIV.x - 4} y1="170" x2={PIV.x - 4} y2="192"></line>
			</g>
			<line class="use__rod" x1={PIV.x} y1={ROD_Y} x2="74" y2="130" data-rod></line>
			<circle class="use__pivot" cx={PIV.x} cy={PIV.y} r="3.5"></circle>
			<g data-push>
				<path class="arrow arrow--gold" d="M8 181 H21"></path>
				<path class="head--gold" d="M29 181 L21 176 V186 Z"></path>
			</g>
			<text class="t-small" x="22" y="212" text-anchor="middle">педаль</text>
			<text class="t-small" x="100" y="160" text-anchor="middle">жидкость</text>
			<path class="ln" d="M100 150 L110 132"></path>
			<text class="t-small" x="170" y="110" text-anchor="end">колодка</text>
			<path class="ln" d="M172 107 L189 132"></path>
			<text class="t-small" x="201" y="224" text-anchor="middle">диск колеса</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 240 262" role="img" aria-label="Один литр воды выкипает, и пар поднимает поршень в цилиндре диаметром 1,2 метра на высоту 1,5 метра">
			<text class="t-title" x="120" y="18" text-anchor="middle">Вода превращается в пар</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">из 1 л воды — около 1700 л пара</text>
			<!-- the pot of 10 см on a stand with a flame -->
			<path class="ln" d="M40 220 L36 232 M51 220 L55 232"></path>
			<path class="use__flame" d="M45.75 231 C42 227 45 224 45.75 221.5 C46.5 224 49.5 227 45.75 231 Z" data-flame></path>
			<rect class="use__liquid" x="42" y="212.5" width="7.5" height="7.5" data-pot></rect>
			<rect class="use__pot" x="42" y="212.5" width="7.5" height="7.5"></rect>
			<path class="use__pipe-thin" d={`M45.75 212.5 V204 H90 V228 H${sx0}`}></path>
			<text class="t-small" x="46" y="196" text-anchor="middle">1 л воды</text>
			<!-- the cylinder with the piston -->
			<rect class="use__steam" x={sx0} y={G} width={sw} height="0" data-steam></rect>
			<path class="use__wall-line" d={`M${sx0 - 1.5} ${stop} V${G + 1.5} H${sx0 + sw + 1.5} V${stop}`}></path>
			<g data-piston>
				<rect class="use__steel-dark" x={sx0} y={G - 6} width={sw} height="6"></rect>
				<rect class="use__steel-dark" x={sx0 + sw / 2 - 3} y={G - 46} width="6" height="40"></rect>
			</g>
			<text class="t-small t-halo" x={sx0 + sw / 2} y={G - 52} text-anchor="middle" data-plabel>поршень</text>
			<text class="t-strong t-num" x={sx0 + sw / 2} y={G} text-anchor="middle" data-steamlabel opacity="0">пар</text>
			<line class="ln" x1="4" x2="236" y1={G} y2={G}></line>
			<path class="ln" d={`M${sx0} ${G + 13} H${sx0 + sw / 2 - 20} M${sx0 + sw / 2 + 20} ${G + 13} H${sx0 + sw} M${sx0} ${G + 9} V${G + 17} M${sx0 + sw} ${G + 9} V${G + 17}`}></path>
			<text class="t-small" x={sx0 + sw / 2} y={G + 17} text-anchor="middle">1,2 м</text>
			<path class="ln-dash" d={`M${sx0 - 16} ${G - 1.503 * S} H${sx0 - 4}`}></path>
			<text class="t-small" x={sx0 - 19} y={G - 1.503 * S + 4} text-anchor="end">1,5 м</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 240 262" role="img" aria-label="Полная закрытая бутылка с водой замерзает: лёд занимает больше места, и бутылка трескается">
			<defs>
				<clipPath id="use-inner"><path d={inner}></path></clipPath>
				<pattern id="use-ice" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
					<path class="use__ice-line" d="M0 4 H8 M4 0 V8"></path>
				</pattern>
			</defs>
			<text class="t-title" x="120" y="18" text-anchor="middle">Вода замерзает</text>
			<text class="t-small" x="120" y="33" text-anchor="middle">лёд занимает на 9 % больше места</text>
			<g clip-path="url(#use-inner)">
				<path class="use__ice" d={inner}></path>
				<path fill="url(#use-ice)" d={inner}></path>
				<path class="use__water" d={inner} data-core></path>
			</g>
			<path class="use__glass" d={bottle}></path>
			<rect class="use__cap" x="107" y="43" width="26" height="10" rx="2"></rect>
			<g class="use__cracks" opacity="0" data-cracks>
				<path d="M88.5 140 l9 5 l-5 8 l10 6 l-4 7"></path>
				<path d="M151.5 118 l-8 7 l5 6 l-9 9"></path>
				<path d="M151.5 196 l-10 -3 l3 9 l-9 4"></path>
				<path d="M92 232 l6 -9 l7 2 l5 -8"></path>
			</g>
			<text class="t-small" x="160" y="122" opacity="0" data-icelabel>лёд</text>
			<path class="ln" d="M158 118 L146 124" opacity="0" data-iceline></path>
			<text class="t-small" x="160" y="170" data-waterlabel>вода</text>
			<path class="ln" d="M158 166 L124 166" data-waterline></path>
			<line class="ln" x1="4" x2="236" y1={G} y2={G}></line>
			<text class="t-strong t-num" x="120" y="252" text-anchor="middle" data-vol>вода: 500 мл</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Баллон и цилиндр с паром нарисованы в одном масштабе; тормоз и бутылка — схемы не в масштабе. Кипение и замерзание, которые идут минуты и часы, здесь занимают по 4&nbsp;секунды.
	</figcaption>
</figure>

<style is:global>
	.use__gas {
		fill: color-mix(in srgb, var(--ig-vx) 12%, transparent);
		stroke: var(--g7-blue);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.use__gas-edge {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1;
		stroke-dasharray: 4 3;
		opacity: 0.7;
	}
	.use__steel {
		fill: var(--g7-steel);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.use__steel-dark {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.use__wall {
		fill: var(--g7-steel);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.use__wall-line {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.use__liquid {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
	}
	.use__pipe {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 9;
		stroke-linejoin: round;
	}
	.use__pipe-liq {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 60%, var(--g7-paper));
		stroke-width: 5;
		stroke-linejoin: round;
	}
	.use__flow {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 2;
		stroke-dasharray: 2 8;
	}
	.use__pipe-thin {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.use__pad {
		fill: var(--g7-wood-dark);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.use__lever {
		stroke: var(--g7-ink);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.use__lever--pad {
		stroke-width: 6;
	}
	.use__rod {
		stroke: var(--g7-ink);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.use__pivot {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.use__flame {
		fill: var(--g7-gold);
	}
	.use__pot {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.use__steam {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 22%, transparent);
	}
	.use__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.use__cap {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.use__water {
		fill: color-mix(in srgb, var(--ig-vx) 45%, var(--g7-paper));
	}
	.use__ice {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-2));
	}
	.use__ice-line {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 0.8;
		opacity: 0.45;
	}
	:root[data-theme='light'] .use__ice {
		fill: color-mix(in oklab, var(--ig-vx) 14%, var(--g7-paper));
	}
	:root[data-theme='light'] .use__ice-line {
		stroke: var(--g7-blue);
	}
	.use__cracks path {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const PIV = { x: 36, y: 60 };
	const ROD_Y = 130;
	const S1 = 4 / (14 / 22) ** 2;
	const S = 75;
	const G = 232;
	const CYCLE = 8; // s: the steam and the bottle (0,8 s still, 4 s change, the end held)
	const BRAKE = 4; // s: press, hold, release

	for (const root of document.querySelectorAll<HTMLElement>('[data-usepic]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const pedal = q<SVGGElement>('[data-pedal]');
		const rod = q<SVGLineElement>('[data-rod]');
		const mpis = q<SVGRectElement>('[data-mpis]');
		const mliq = q<SVGRectElement>('[data-mliq]');
		const wpis = q<SVGRectElement>('[data-wpis]');
		const wliq = q<SVGRectElement>('[data-wliq]');
		const pad = q<SVGRectElement>('[data-pad]');
		const flow = q<SVGPathElement>('[data-flow]');
		const push = q<SVGGElement>('[data-push]');
		const steam = q<SVGRectElement>('[data-steam]');
		const piston = q<SVGGElement>('[data-piston]');
		const plabel = q<SVGTextElement>('[data-plabel]');
		const slabel = q<SVGTextElement>('[data-steamlabel]');
		const pot = q<SVGRectElement>('[data-pot]');
		const flame = q<SVGPathElement>('[data-flame]');
		const core = q<SVGPathElement>('[data-core]');
		const cracks = q<SVGGElement>('[data-cracks]');
		const vol = q<SVGTextElement>('[data-vol]');
		const iceL = [q('[data-icelabel]'), q('[data-iceline]')];
		const waterL = [q('[data-waterlabel]'), q('[data-waterline]')];
		let t = 0;
		const draw = () => {
			// brake: s = 0…1 of the full press
			const b = t % BRAKE;
			const s = b < 0.3 ? 0 : b < 1.1 ? ease((b - 0.3) / 0.8) : b < 2.3 ? 1 : b < 3.1 ? 1 - ease((b - 2.3) / 0.8) : 0;
			const s1 = S1 * s; // travel of the main piston, px
			const s2 = s1 * (14 / 22) ** 2; // of the wheel piston: the same volume through a wider bore
			const ang = Math.asin(s1 / (ROD_Y - PIV.y)); // the lever turns so that the rod point moves by s1
			pedal.setAttribute('transform', `rotate(${(-ang * 180) / Math.PI} ${PIV.x} ${PIV.y})`);
			const rx = PIV.x + (ROD_Y - PIV.y) * Math.sin(ang);
			const ry = PIV.y + (ROD_Y - PIV.y) * Math.cos(ang);
			rod.setAttribute('x1', rx.toFixed(2));
			rod.setAttribute('y1', ry.toFixed(2));
			rod.setAttribute('x2', (74 + s1).toFixed(2));
			mpis.setAttribute('x', (74 + s1).toFixed(2));
			mliq.setAttribute('x', (80 + s1).toFixed(2));
			mliq.setAttribute('width', (40 - s1).toFixed(2));
			wpis.setAttribute('x', (182 + s2).toFixed(2));
			wliq.setAttribute('width', (18 + s2).toFixed(2));
			pad.setAttribute('x', (188 + s2).toFixed(2));
			flow.setAttribute('stroke-dashoffset', (-s1 * (14 / 5) ** 2).toFixed(2));
			push.setAttribute('opacity', b > 0.2 && b < 2.4 ? '1' : '0');
			push.setAttribute('transform', `translate(${(((181 - PIV.y) / (ROD_Y - PIV.y)) * s1).toFixed(2)} 0)`);

			// steam and ice: u = 0…1 of the change
			const c = t % CYCLE;
			const u = Math.min(1, Math.max(0, (c - 0.8) / 4));
			const h = 1.503 * u * S; // the piston's height, px
			steam.setAttribute('y', (G - h).toFixed(2));
			steam.setAttribute('height', h.toFixed(2));
			piston.setAttribute('transform', `translate(0 ${(-h).toFixed(2)})`);
			plabel.setAttribute('y', (G - 52 - h).toFixed(2));
			slabel.setAttribute('opacity', h > 26 ? '1' : '0');
			slabel.setAttribute('y', (G - h / 2 + 4).toFixed(2));
			slabel.textContent = `пар ${Math.round(170 * u) * 10} л`;
			pot.setAttribute('y', (212.5 + 7.5 * u).toFixed(2));
			pot.setAttribute('height', (7.5 * (1 - u)).toFixed(2));
			flame.setAttribute('opacity', c < 4.8 ? '1' : '0');

			// the water core keeps the area 1 − u of the bottle (u: the frozen part)
			core.setAttribute('transform', `translate(120 150) scale(${Math.sqrt(1 - u).toFixed(3)}) translate(-120 -150)`);
			cracks.setAttribute('opacity', u >= 1 ? '1' : '0');
			for (const e of iceL) e.setAttribute('opacity', u > 0.08 ? '1' : '0');
			for (const e of waterL) e.setAttribute('opacity', u < 0.85 ? '1' : '0');
			vol.textContent = u <= 0 ? 'вода: 500 мл' : u < 1 ? 'вода замерзает' : 'лёд: 545 мл — бутылка лопнула';
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
		draw();
	}
</script>
