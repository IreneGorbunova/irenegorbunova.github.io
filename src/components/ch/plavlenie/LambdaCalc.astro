---
/**
 * Specific heat of fusion of several substances (rounded table values, А. В. Пёрышкин, «Физика. 8 класс»;
 * naphthalene from reference tables). Pick a substance and a mass: Q = λm is computed live and compared
 * with heating the same mass of water.
 */
const LIST = [
	{ name: 'Алюминий', gen: 'алюминия', l: 3.9, tm: '660' },
	{ name: 'Лёд', gen: 'льда', l: 3.4, tm: '0' },
	{ name: 'Железо', gen: 'железа', l: 2.7, tm: '1538' },
	{ name: 'Медь', gen: 'меди', l: 2.1, tm: '1085' },
	{ name: 'Нафталин', gen: 'нафталина', l: 1.5, tm: '80' },
	{ name: 'Золото', gen: 'золота', l: 0.67, tm: '1064' },
	{ name: 'Олово', gen: 'олова', l: 0.59, tm: '232' },
	{ name: 'Свинец', gen: 'свинца', l: 0.25, tm: '327' },
	{ name: 'Ртуть', gen: 'ртути', l: 0.12, tm: '−39' },
];
const MAX = 3.9;
---

<figure class="lcalc not-content" data-lcalc>
	<div class="lcalc__bars" role="radiogroup" aria-label="Вещество">
		{
			LIST.map((s, i) => (
				<button type="button" class="lcalc__row" role="radio" aria-checked={i === 1 ? 'true' : 'false'} data-l={s.l} data-gen={s.gen} data-tm={s.tm}>
					<span class="lcalc__name">{s.name}</span>
					<span class="lcalc__track">
						<span class="lcalc__bar" style={`width:${(s.l / MAX) * 100}%`} />
					</span>
					<span class="lcalc__val">
						{String(s.l).replace('.', ',')}·10<sup>5</sup>
					</span>
				</button>
			))
		}
	</div>
	<p class="lcalc__unit">λ, Дж/кг (округлённые табличные значения)</p>
	<label class="lcalc__slider">
		<span>Масса <i>m</i> = <b data-m-out>2 кг</b></span>
		<input type="range" min="0.1" max="5" step="0.1" value="2" data-m />
	</label>
	<div class="lcalc__f" data-f1></div>
	<p class="lcalc__note" data-note></p>
</figure>

<style is:global>
	.lcalc {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.lcalc i {
		font-family: var(--ig-font-math);
	}
	.lcalc__bars {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.lcalc__row {
		display: grid;
		grid-template-columns: 6.2rem 1fr 4.6rem;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.2rem 0.5rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid transparent;
		border-radius: 0.5rem;
		cursor: pointer;
		transition:
			background-color 0.2s,
			border-color 0.2s;
	}
	.lcalc__row:hover {
		border-color: var(--sl-color-gray-5);
	}
	.lcalc__row[aria-checked='true'] {
		color: var(--sl-color-white);
		font-weight: 700;
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
	}
	.lcalc__track {
		height: 0.7rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		overflow: hidden;
	}
	.lcalc__bar {
		display: block;
		height: 100%;
		border-radius: 999px;
		background: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
		transition: background-color 0.2s;
	}
	.lcalc__row[aria-checked='true'] .lcalc__bar {
		background: var(--sl-color-accent);
	}
	.lcalc__val {
		text-align: end;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.lcalc__unit {
		margin: 0.3rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: end;
	}
	.lcalc__slider {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.lcalc__slider b {
		color: var(--sl-color-white);
	}
	.lcalc__slider input {
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.lcalc__f {
		color: var(--sl-color-white);
		overflow-x: auto;
		overflow-y: hidden;
	}
	.lcalc__f .katex-display {
		margin: 0.5rem 0 0.2rem;
	}
	.lcalc__note {
		margin: 0.2rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.lcalc__note b {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.lcalc {
			padding: 0.75rem;
		}
		.lcalc__row {
			grid-template-columns: 5.4rem 1fr 4.3rem;
			gap: 0.4rem;
			padding: 0.25rem 0.3rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.lcalc__row,
		.lcalc__bar {
			transition: none;
		}
	}
</style>

<script>
	import { ru, tex, renderTex } from './melt';

	for (const root of document.querySelectorAll<HTMLElement>('[data-lcalc]')) {
		const rows = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-l]'));
		const mIn = root.querySelector<HTMLInputElement>('[data-m]')!;
		const mOut = root.querySelector<HTMLElement>('[data-m-out]')!;
		const f1 = root.querySelector<HTMLElement>('[data-f1]')!;
		const note = root.querySelector<HTMLElement>('[data-note]')!;
		let cur = rows.find((r) => r.getAttribute('aria-checked') === 'true')!;

		const draw = () => {
			const l = Number(cur.dataset.l); // in units of 10^5 J/kg
			const m = Number(mIn.value);
			mOut.textContent = `${ru(m, 1)} кг`;
			const narrow = root.clientWidth < 520;
			const q = Math.round(l * 1e5 * m); // J, exact: λ has two significant digits, m one decimal
			const kj = q / 1000;
			renderTex(
				f1,
				`${narrow ? '\\begin{aligned}Q &' : 'Q '}= \\lambda m = ${tex(l, 2)}\\cdot 10^5~\\dfrac{\\text{Дж}}{\\text{кг}}\\cdot ${tex(m, 1)}~\\text{кг} ${narrow ? '\\\\ &' : ''}= ${tex(q, 0)}~\\text{Дж}${q >= 1000 ? ` = ${tex(kj, 1)}~\\text{кДж}` : ''}${narrow ? '\\end{aligned}' : ''}`,
			);
			const dt = (l * 1e5) / 4200;
			note.innerHTML = `Это теплота для вещества, уже нагретого до температуры плавления (у ${cur.dataset.gen} — <b>${cur.dataset.tm} °C</b>). Столько же теплоты нужно, чтобы нагреть воду такой же массы примерно на <b>${ru(dt, 0)} °C</b>.`;
		};
		rows.forEach((r) =>
			r.addEventListener('click', () => {
				cur = r;
				rows.forEach((o) => o.setAttribute('aria-checked', String(o === r)));
				draw();
			}),
		);
		mIn.addEventListener('input', draw);
		let lastW = root.clientWidth;
		new ResizeObserver(() => {
			if (Math.abs(root.clientWidth - lastW) > 4) {
				lastW = root.clientWidth;
				draw();
			}
		}).observe(root);
		draw();
	}
</script>
