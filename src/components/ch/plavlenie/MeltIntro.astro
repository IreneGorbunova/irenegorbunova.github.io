---
/**
 * Four short looping opening scenes of «Плавление и отвердевание».
 * Snow: the sun shines on a snowdrift for three weeks (day 1 → 21 in 7 s); the drift shrinks slowly, a thermometer
 *   in it shows 0 °C all the time.
 * Cellar: in hard frost (−10 → −25 °C outside) the air of a cellar cools to 0 °C; then the water in the barrel
 *   starts to freeze, gives off heat and keeps the air at 0 °C; the ice layer grows as the square root of time.
 * Casting: molten metal is poured into a bell mould (bell upright, poured through the crown, a core inside);
 *   it fills the mould, cools and solidifies, the mould is removed and a hollow bell is left.
 * Freezing rain: liquid drops at −3 °C freeze on a branch, a wire and the ground; the ice coat grows, the wire sags.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// Snow: ground line and the centre of the drift
const G = 200;
const CX = 140;
// Cellar: barrel, water inside it
const BAR = { x0: 70, x1: 150, top: 142, bot: 224 };
const WAT = { x0: 77, x1: 143, top: 152, bot: 217 };
// Casting: bell (upright), poured through the crown
const bellOuter =
	'M240 128 C262 128 268 136 268 150 L272 186 C274 202 284 208 298 212 L298 216 L182 216 L182 212 C196 208 206 202 208 186 L212 150 C212 136 218 128 240 128 Z';
const bellInner =
	'M240 137 C256 137 260 143 260 153 L263 186 C265 200 274 209 288 216 L192 216 C206 209 215 200 217 186 L220 153 C220 143 224 137 240 137 Z';
const cup = 'M224 92 L256 92 L246 105 L234 105 Z';
// Freezing rain: branch, twig, wire between two poles
const branch = 'M38 140 L175 112';
const twig = 'M108 126 L148 96';
const icicles = [62, 92, 122, 150];
const snowflake = (x: number, y: number, r: number) =>
	[0, 60, 120].map((a) => {
		const c = Math.cos((a * Math.PI) / 180) * r;
		const s = Math.sin((a * Math.PI) / 180) * r;
		return `M${(x - c).toFixed(1)} ${(y - s).toFixed(1)} L${(x + c).toFixed(1)} ${(y + s).toFixed(1)}`;
	}).join(' ');
---

<IntroFrame data-meltintro>
	<div class="intro__card" data-scene="snow">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Весна: солнце каждый день светит на сугроб, а он тает три недели; термометр в тающем снегу всё время показывает 0 °C">
			<rect class="mi-sky" x="0" y="0" width="360" height={G} />
			<g class="mi-cal">
				<rect x="14" y="13" width="22" height="20" rx="3" />
				<path d="M14 19 H36 M20 10 V15 M30 10 V15" />
				<text x="44" y="30" data-day>день 1</text>
			</g>
			<g class="mi-sun" transform="translate(304 46)">
				<g class="mi-sun__rays">
					{Array.from({ length: 8 }, (_, i) => (
						<line x1="20" y1="0" x2="27" y2="0" transform={`rotate(${i * 45})`} />
					))}
				</g>
				<circle r="15" />
			</g>
			<rect class="mi-soil" x="0" y={G} width="360" height={240 - G} />
			<g class="mi-grass" data-grass>
				{[22, 48, 214, 306, 338].map((x) => (
					<path d={`M${x - 5} ${G - 6} L${x} ${G} L${x + 1} ${G - 9} M${x} ${G} L${x + 6} ${G - 6}`} />
				))}
			</g>
			<rect class="mi-snowfill" x="0" y={G - 9} width="360" height="9" data-layer />
			<ellipse class="mi-water" cx="266" cy={G + 3} rx="6" ry="2" data-puddle />
			<path class="mi-trickle" d="" data-trickle />
			<!-- thermometer stuck in the snow -->
			<rect class="mi-tube" x={CX - 3} y="98" width="6" height="96" rx="3" />
			<line class="mi-tick" x1={CX - 8} x2={CX - 3} y1="112" y2="112" />
			<rect class="mi-col" x={CX - 1.4} y="112" width="2.8" height="84" />
			<circle class="mi-col" cx={CX} cy="196" r="5" />
			<path class="mi-snowfill" d="" data-drift />
			<rect class="mi-pill" x={CX - 34} y="64" width="68" height="26" rx="13" />
			<text class="mi-read" x={CX} y="82.5" text-anchor="middle">0&nbsp;°C</text>
			<g class="mi-rays" data-rays>
				{[0, 1].map(() => <line x1="0" y1="0" x2="0" y2="0" marker-end="url(#mi-arrow)" />)}
			</g>
			<defs>
				<marker id="mi-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
					<path class="mi-head" d="M 0 0 L 10 5 L 0 10 z" />
				</marker>
			</defs>
		</svg>
		<div class="intro__foot">
			<p>Солнце греет сугроб каждый день, а он тает неделями: на таяние нужно очень много теплоты. <More term="Почему?">Пока снег тает, термометр в нём показывает 0&nbsp;°C: вся теплота, которую получает снег, уходит на таяние, а не на нагревание. Чтобы растопить килограмм снега, нужно столько же теплоты, сколько, чтобы нагреть килограмм воды примерно на 80&nbsp;°C. Если бы на таяние хватало совсем немного теплоты, снег сходил бы за несколько часов&nbsp;— и каждую весну случались бы страшные наводнения. Так рассуждал Джозеф Блэк, о котором рассказано ниже, в разделе «Кто это открыл».</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="cellar">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Погреб в мороз: снаружи до −25 °C, в погребе стоит кадка с водой; вода замерзает, отдаёт теплоту, и воздух рядом с овощами держится около 0 °C">
			<rect class="mi-night" x="0" y="0" width="360" height="62" />
			<path class="mi-flake" d={snowflake(24, 26, 9)} />
			<rect class="mi-pill" x="40" y="13" width="80" height="26" rx="13" />
			<text class="mi-read" x="80" y="31.5" text-anchor="middle" data-out>−10&nbsp;°C</text>
			<rect class="mi-soil" x="0" y="62" width="360" height="178" />
			<rect class="mi-snowfill" x="0" y="56" width="360" height="8" />
			<g class="mi-dots">
				{[[14, 80], [60, 74], [130, 82], [200, 76], [270, 84], [338, 78], [10, 160], [350, 190], [12, 232], [348, 120]].map(([x, y]) => (
					<circle cx={x} cy={y} r="1.6" />
				))}
			</g>
			<rect class="mi-room" x="26" y="96" width="310" height="132" rx="4" />
			<!-- barrel, cut open -->
			<path class="mi-wood" d={`M${BAR.x0 + 4} ${BAR.top} Q${BAR.x0 - 5} ${(BAR.top + BAR.bot) / 2} ${BAR.x0 + 4} ${BAR.bot} H${BAR.x1 - 4} Q${BAR.x1 + 5} ${(BAR.top + BAR.bot) / 2} ${BAR.x1 - 4} ${BAR.top} Z`} />
			<rect class="mi-water" x={WAT.x0} y={WAT.top} width={WAT.x1 - WAT.x0} height={WAT.bot - WAT.top} />
			<rect class="mi-ice" x={WAT.x0} y={WAT.top} width={WAT.x1 - WAT.x0} height="0" data-icetop />
			<rect class="mi-ice" x={WAT.x0} y={WAT.top} width="0" height={WAT.bot - WAT.top} data-iceleft />
			<rect class="mi-ice" x={WAT.x1} y={WAT.top} width="0" height={WAT.bot - WAT.top} data-iceright />
			<path class="mi-hoop" d={`M${BAR.x0 + 1} 156 Q110 160 ${BAR.x1 - 1} 156 M${BAR.x0 + 1} 210 Q110 214 ${BAR.x1 - 1} 210`} />
			<g class="mi-heat" data-heat>
				{[
					'M110 136 q -5 -7 0 -14 q 5 -7 0 -14',
					'M158 176 q 7 -5 14 0 q 7 5 14 0',
					'M152 146 q 8 -2 10 -10 q 2 -8 10 -10',
				].map((d, i) => (
					<path style={`--d:${(i * 0.45).toFixed(2)}s`} d={d} marker-end="url(#mi-arrow)" />
				))}
			</g>
			<!-- vegetables -->
			<rect class="mi-crate" x="214" y="186" width="106" height="40" rx="2" />
			<path class="mi-slat" d="M214 199 H320 M214 212 H320" />
			{[[230, 182, 11], [252, 180, 12], [276, 182, 11], [300, 181, 12], [242, 172, 10], [266, 171, 11], [290, 172, 10]].map(([x, y, r]) => (
				<ellipse class="mi-potato" cx={x} cy={y} rx={r} ry={r * 0.72} />
			))}
			<rect class="mi-pill" x="232" y="114" width="72" height="26" rx="13" />
			<text class="mi-read" x="268" y="132.5" text-anchor="middle" data-in>+3&nbsp;°C</text>
		</svg>
		<div class="intro__foot">
			<p>Замерзая, вода в кадке отдаёт теплоту, и в погребе держится около 0&nbsp;°C&nbsp;— овощи не промерзают даже в сильный мороз. <More term="Почему?">В сильный мороз в погреб или овощехранилище ставят кадку или бочку с водой. Замерзая, вода отдаёт столько же теплоты, сколько нужно, чтобы растопить такой же лёд,&nbsp;— а это очень много. Пока вода в кадке не замёрзнет вся, её температура остаётся 0&nbsp;°C, и отданная ею теплота не даёт воздуху вокруг остыть ниже. Чем больше воды, тем дольше она так греет погреб.</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="cast">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Литьё колокола: расплавленный металл льют из тигля в форму; он заполняет её, остывает и твердеет, форму снимают, и остаётся колокол">
			<rect class="mi-wall" x="0" y="0" width="360" height="222" />
			<rect class="mi-floor" x="0" y="222" width="360" height="18" />
			<g data-mould>
				<rect class="mi-sand" x="164" y="92" width="152" height="130" rx="3" />
				<g class="mi-dots">
					{[[174, 104], [300, 102], [176, 160], [306, 150], [180, 200], [304, 196], [196, 120], [286, 124]].map(([x, y]) => (
						<circle cx={x} cy={y} r="1.6" />
					))}
				</g>
				<path class="mi-void" d={bellOuter} />
				<rect class="mi-void" x="236" y="104" width="8" height="26" />
				<path class="mi-void" d={cup} />
				<path class="mi-sand" d={bellInner} />
			</g>
			<path class="mi-bellin" d={bellInner} data-bellin />
			<defs>
				<clipPath id="mi-level">
					<rect x="150" y="216" width="180" height="140" data-level />
				</clipPath>
			</defs>
			<g clip-path="url(#mi-level)">
				<path class="mi-glow" d={bellOuter} data-glow />
				<path class="mi-metal" d={`${bellOuter} ${bellInner}`} fill-rule="evenodd" data-bell />
				<g data-gate>
					<rect class="mi-metal" x="236" y="104" width="8" height="26" />
					<path class="mi-metal" d={cup} />
				</g>
			</g>
			<path class="mi-stream" d="" data-stream />
			<g data-crucible>
				<rect class="mi-rod" x="-54" y="-7" width="36" height="5" rx="2.5" />
				<path class="mi-crucible" d="M-20 -18 L20 -18 L15 18 Q15 22 11 22 L-11 22 Q-15 22 -15 18 Z" />
				<ellipse class="mi-melt" cx="0" cy="-18" rx="18" ry="3.5" data-meltop />
			</g>
			<rect class="mi-pill" x="254" y="13" width="96" height="26" rx="13" />
			<text class="mi-read" x="302" y="31.5" text-anchor="middle" data-state>жидкий</text>
		</svg>
		<div class="intro__foot">
			<p>Расплавленный металл заливают в форму; отвердевая, он принимает её вид. Так отливают колокола и памятники. <More term="Почему?">Металл расплавляют и заливают в форму. Отвердевая, он в точности повторяет её&nbsp;— так отливают детали машин, колокола, памятники. Внутри формы колокола стоит сердечник, поэтому колокол получается полым. На отвердевании держится и пайка: провода соединяют расплавленным припоем&nbsp;— сплавом олова со свинцом или другими металлами, который плавится при сравнительно низкой температуре. Застывая, припой скрепляет провода.</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="glaze">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Гололёд: при −3 °C идёт дождь из жидких капель; коснувшись ветки, провода и земли, капли замерзают, и всё покрывается коркой льда">
			<rect class="mi-grey" x="0" y="0" width="360" height="222" />
			<g class="mi-cloud">
				{[[40, 4, 34], [92, 10, 30], [150, 2, 36], [212, 8, 32], [270, 0, 34], [326, 6, 32]].map(([x, y, r]) => (
					<circle cx={x} cy={y} r={r} />
				))}
			</g>
			<rect class="mi-soil" x="0" y="222" width="360" height="18" />
			<rect class="mi-ice" x="0" y="222" width="360" height="0" data-groundice />
			<!-- tree -->
			<path class="mi-iceedge" d={`${branch} ${twig}`} data-treeedge />
			<path class="mi-ice mi-icecoat" d={`${branch} ${twig}`} data-treeice />
			<path class="mi-bark" d="M34 222 L36 60" stroke-width="12" />
			<path class="mi-bark" d={branch} stroke-width="6" />
			<path class="mi-bark" d={twig} stroke-width="4" />
			<path class="mi-bark" d="M36 104 L0 88" stroke-width="5" />
			<g data-treeicicles>
				{icicles.map(() => <path class="mi-ice" d="" />)}
			</g>
			<!-- poles and wire -->
			{[212, 344].map((x) => (
				<g class="mi-pole">
					<path d={`M${x} 222 V94 M${x - 10} 100 H${x + 10}`} />
				</g>
			))}
			<path class="mi-iceedge" d="" data-wireedge />
			<path class="mi-ice mi-icecoat" d="" data-wireice />
			<path class="mi-wire" d="" data-wire />
			<g data-wireicicles>
				{[0.25, 0.42, 0.58, 0.75].map(() => <path class="mi-ice" d="" />)}
			</g>
			<g data-drops></g>
			<rect class="mi-pill" x="196" y="48" width="148" height="26" rx="13" />
			<text class="mi-read" x="270" y="66.5" text-anchor="middle">воздух −3&nbsp;°C</text>
		</svg>
		<div class="intro__foot">
			<p>Капли дождя холоднее 0&nbsp;°C, но ещё жидкие. Коснувшись ветки или провода, они сразу замерзают&nbsp;— получается гололёд. <More term="Почему?">Очень чистая вода в покое может остаться жидкой и ниже 0&nbsp;°C. Такую воду называют <b>переохлаждённой</b>. Стоит её встряхнуть или бросить в неё крупинку льда, как она начинает быстро замерзать, а её температура подскакивает до 0&nbsp;°C: при кристаллизации выделяется теплота. Так и переохлаждённые капли дождя замерзают, коснувшись земли, деревьев или проводов,&nbsp;— получается гололёд. Такой дождь часто называют ледяным, хотя метеорологи так называют дождь из ледяных крупинок, а этот&nbsp;— переохлаждённым. Под тяжестью льда ломаются ветки и рвутся провода.</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-meltintro] {
		--mi-snow: color-mix(in srgb, var(--sl-color-white) 88%, var(--ig-vx));
		--mi-edge: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-3));
		--mi-soil: color-mix(in srgb, var(--ig-v) 28%, var(--sl-color-gray-5));
		--mi-hot: color-mix(in srgb, var(--ig-v) 65%, var(--ig-vy));
		--mi-bronze: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-3));
		--mi-wood: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
		--mi-ice: color-mix(in srgb, var(--mi-snow) 85%, var(--ig-vx));
		--mi-shade: var(--sl-color-black);
	}
	:root[data-theme='light'] [data-meltintro] {
		--mi-snow: var(--sl-color-black);
		--mi-ice: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-black));
		--mi-edge: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-gray-2));
		--mi-shade: var(--sl-color-white);
	}
	/* shared bits */
	.mi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.mi-read {
		font-size: 16px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.mi-soil {
		fill: var(--mi-soil);
	}
	.mi-dots circle {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-3));
	}
	.mi-snowfill {
		fill: var(--mi-snow);
		stroke: var(--mi-edge);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mi-water {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
	}
	.mi-ice {
		fill: var(--mi-ice);
		stroke: var(--mi-edge);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.mi-tube {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 25%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.mi-col {
		fill: var(--sl-color-red);
	}
	/* snow */
	.mi-sky {
		fill: color-mix(in srgb, var(--ig-vx) 16%, transparent);
	}
	.mi-cal rect,
	.mi-cal path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.mi-cal text {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.mi-sun circle {
		fill: var(--ig-v);
	}
	.mi-sun line {
		stroke: var(--ig-v);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.mi-sun__rays {
		animation: mi-spin 24s linear infinite;
	}
	@keyframes mi-spin {
		to { transform: rotate(45deg); }
	}
	.mi-rays line {
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 6 5;
		animation: mi-flow 0.8s linear infinite;
	}
	.mi-head {
		fill: var(--ig-v);
	}
	@keyframes mi-flow {
		to { stroke-dashoffset: -11; }
	}
	.mi-trickle {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, transparent);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.mi-grass path {
		fill: none;
		stroke: var(--sl-color-green);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* cellar */
	.mi-night {
		fill: color-mix(in srgb, var(--ig-vx) 24%, transparent);
	}
	.mi-flake {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.mi-room {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 35%, var(--ig-surface));
		stroke: var(--sl-color-gray-4);
	}
	.mi-wood {
		fill: var(--mi-wood);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.mi-hoop {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.mi-heat path {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.5;
		stroke-linecap: round;
		opacity: 0;
		animation: mi-rise 1.4s ease-in infinite;
		animation-delay: var(--d);
	}
	@keyframes mi-rise {
		0% { opacity: 0; transform: translate(0, 0); }
		40% { opacity: calc(0.9 * var(--heat, 0)); }
		100% { opacity: 0; transform: translate(4px, -6px); }
	}
	.mi-crate {
		fill: color-mix(in srgb, var(--mi-wood) 70%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.mi-slat {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-potato {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-3));
		stroke: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-2));
		stroke-width: 1;
	}
	/* casting */
	.mi-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.mi-floor {
		fill: var(--sl-color-gray-5);
	}
	.mi-sand {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-void {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 40%, var(--mi-shade));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-bellin {
		fill: color-mix(in srgb, var(--mi-bronze) 45%, var(--mi-shade));
	}
	.mi-metal {
		fill: var(--mi-metal, var(--mi-hot));
	}
	.mi-glow {
		fill: none;
		stroke: var(--mi-hot);
		stroke-width: 9;
		stroke-linejoin: round;
	}
	.mi-stream {
		fill: none;
		stroke: var(--mi-hot);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.mi-rod {
		fill: var(--sl-color-gray-3);
	}
	.mi-crucible {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.mi-melt {
		fill: var(--mi-hot);
	}
	/* freezing rain */
	.mi-grey {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.mi-cloud circle {
		fill: var(--sl-color-gray-4);
	}
	.mi-bark {
		fill: none;
		stroke: var(--mi-wood);
		stroke-linecap: round;
	}
	.mi-icecoat {
		fill: none;
		stroke: var(--mi-ice);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mi-iceedge {
		fill: none;
		stroke: var(--mi-edge);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mi-pole path {
		fill: none;
		stroke: var(--mi-wood);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.mi-wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.mi-drop {
		stroke: var(--ig-vx);
		stroke-width: 2;
		stroke-linecap: round;
	}
	@media (prefers-reduced-motion: reduce) {
		.mi-sun__rays,
		.mi-rays line,
		.mi-heat path {
			animation: none;
		}
		.mi-heat path {
			opacity: calc(0.8 * var(--heat, 0));
		}
	}
</style>

<script>
	import { scene, clamp, reduce } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const deg = (v: number) => {
		const r = Math.round(v);
		return `${r < 0 ? '−' : r > 0 ? '+' : ''}${Math.abs(r)}\u00a0°C`;
	};
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-meltintro]')) {
		// Snow: day 1 → 21 in 7 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="snow"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 200;
			const CX = 140;
			const SUN = [304, 46];
			const day = $<SVGTextElement>('[data-day]');
			const drift = $<SVGPathElement>('[data-drift]');
			const layer = $<SVGRectElement>('[data-layer]');
			const puddle = $<SVGEllipseElement>('[data-puddle]');
			const trickle = $<SVGPathElement>('[data-trickle]');
			const grass = $<SVGGElement>('[data-grass]');
			const rays = Array.from(card.querySelectorAll<SVGLineElement>('[data-rays] line'));
			scene(card, 7, (x) => {
				day.textContent = `день ${1 + Math.round(20 * x)}`;
				const W = 125 - 72 * x;
				const H = 72 - 50 * x;
				const top = (xp: number) => G - (H * (1 + Math.cos((Math.PI * (xp - CX)) / W))) / 2;
				const pts: string[] = [];
				for (let i = 0; i <= 28; i++) {
					const xp = CX - W + (2 * W * i) / 28;
					pts.push(`${f1(xp)} ${f1(top(xp))}`);
				}
				drift.setAttribute('d', `M${pts.join(' L')} Z`);
				const th = 9 * (1 - clamp(x / 0.6));
				layer.setAttribute('y', f1(G - th));
				layer.setAttribute('height', f1(th));
				layer.style.opacity = th > 0.3 ? '1' : '0';
				grass.style.opacity = clamp((x - 0.5) / 0.25).toFixed(2);
				const e = clamp((x - 0.08) / 0.92);
				puddle.setAttribute('rx', f1(6 + 34 * e));
				puddle.setAttribute('ry', f1(2 + 2.5 * e));
				puddle.style.opacity = e > 0 ? '1' : '0';
				const tx = CX + W * 0.8;
				trickle.setAttribute('d', `M${f1(tx)} ${G + 1} Q${f1((tx + 226) / 2)} ${G + 4} ${f1(266 - 6 - 34 * e)} ${G + 3}`);
				trickle.style.opacity = e > 0 ? '1' : '0';
				[0.05, 0.5].forEach((k, i) => {
					const xt = CX + k * W;
					const yt = top(xt);
					const dx = SUN[0] - xt;
					const dy = SUN[1] - yt;
					const n = Math.hypot(dx, dy);
					rays[i].setAttribute('x1', f1(xt + (dx / n) * 46));
					rays[i].setAttribute('y1', f1(yt + (dy / n) * 46));
					rays[i].setAttribute('x2', f1(xt + (dx / n) * 5));
					rays[i].setAttribute('y2', f1(yt + (dy / n) * 5));
				});
			});
		}

		// Cellar: the night of hard frost in 7 s; the water starts to freeze at x = 0.25
		{
			const card = root.querySelector<HTMLElement>('[data-scene="cellar"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const out = $<SVGTextElement>('[data-out]');
			const inn = $<SVGTextElement>('[data-in]');
			const top = $<SVGRectElement>('[data-icetop]');
			const left = $<SVGRectElement>('[data-iceleft]');
			const right = $<SVGRectElement>('[data-iceright]');
			const heat = $<SVGGElement>('[data-heat]');
			const X1 = 143;
			scene(card, 7, (x) => {
				out.textContent = deg(-10 - 15 * x);
				const p = clamp((x - 0.25) / 0.75);
				inn.textContent = deg(x < 0.25 ? 3 - 12 * x : 0);
				const d = 22 * Math.sqrt(p);
				const s = 7 * Math.sqrt(p);
				top.setAttribute('height', f1(d));
				left.setAttribute('width', f1(s));
				right.setAttribute('x', f1(X1 - s));
				right.setAttribute('width', f1(s));
				heat.style.setProperty('--heat', clamp((x - 0.25) / 0.08).toFixed(2));
			});
		}

		// Casting: pour, cool, open the mould (7 s)
		{
			const card = root.querySelector<HTMLElement>('[data-scene="cast"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const crucible = $<SVGGElement>('[data-crucible]');
			const meltTop = $<SVGEllipseElement>('[data-meltop]');
			const stream = $<SVGPathElement>('[data-stream]');
			const level = $<SVGRectElement>('[data-level]');
			const bell = $<SVGPathElement>('[data-bell]');
			const gate = $<SVGGElement>('[data-gate]');
			const glow = $<SVGPathElement>('[data-glow]');
			const mould = $<SVGGElement>('[data-mould]');
			const bellIn = $<SVGPathElement>('[data-bellin]');
			const state = $<SVGTextElement>('[data-state]');
			const P = [215, 58];
			const lip = [20, -18];
			scene(card, 7, (x) => {
				const tilt = x < 0.12 ? x / 0.12 : x < 0.55 ? 1 : 1 - clamp((x - 0.55) / 0.08);
				const a = 70 * (tilt * tilt * (3 - 2 * tilt));
				crucible.setAttribute('transform', `translate(${P[0]} ${P[1]}) rotate(${f1(a)})`);
				const r = (a * Math.PI) / 180;
				const lx = P[0] + lip[0] * Math.cos(r) - lip[1] * Math.sin(r);
				const ly = P[1] + lip[0] * Math.sin(r) + lip[1] * Math.cos(r);
				const pour = x > 0.11 && x < 0.56;
				stream.setAttribute('d', pour ? `M${f1(lx)} ${f1(ly)} C${f1(lx + 2)} ${f1(ly + 8)} 240 ${f1(ly + 12)} 240 102` : '');
				meltTop.style.opacity = (1 - clamp((x - 0.12) / 0.43)).toFixed(2);
				// metal level: bottom of the bell (216) up to the top of the cup (92)
				const f = clamp((x - 0.13) / 0.42);
				const y = 216 - 124 * f;
				level.setAttribute('y', f1(y));
				// cooling: k = 1 hot, 0 cold
				const k = 1 - clamp((x - 0.55) / 0.3);
				const metal = `color-mix(in srgb, var(--mi-hot) ${Math.round(100 * k)}%, var(--mi-bronze))`;
				bell.style.setProperty('--mi-metal', metal);
				gate.style.setProperty('--mi-metal', metal);
				glow.style.opacity = (0.35 * k).toFixed(2);
				const open = clamp((x - 0.86) / 0.12);
				mould.style.opacity = (1 - open).toFixed(2);
				gate.style.opacity = (1 - open).toFixed(2);
				bellIn.style.opacity = open.toFixed(2);
				state.textContent = x < 0.56 ? 'жидкий' : x < 0.85 ? 'твердеет' : 'твёрдый';
			});
		}

		// Freezing rain: drops at −3 °C freeze where they land (7 s)
		{
			const card = root.querySelector<HTMLElement>('[data-scene="glaze"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const wire = $<SVGPathElement>('[data-wire]');
			const wireIce = $<SVGPathElement>('[data-wireice]');
			const treeIce = $<SVGPathElement>('[data-treeice]');
			const treeEdge = $<SVGPathElement>('[data-treeedge]');
			const wireEdge = $<SVGPathElement>('[data-wireedge]');
			const groundIce = $<SVGRectElement>('[data-groundice]');
			const treeIcicles = Array.from(card.querySelectorAll<SVGPathElement>('[data-treeicicles] path'));
			const wireIcicles = Array.from(card.querySelectorAll<SVGPathElement>('[data-wireicicles] path'));
			const dropG = $<SVGGElement>('[data-drops]');
			const W0 = 212;
			const W1 = 344;
			const WY = 100;
			const branchY = (px: number) => 140 - (28 * (px - 38)) / 137;
			let sag = 10;
			const wireY = (px: number) => {
				const t = (px - W0) / (W1 - W0);
				return WY + sag * 4 * t * (1 - t);
			};
			const land = (px: number) => (px > 40 && px < 175 ? branchY(px) : px > W0 + 2 && px < W1 - 2 ? wireY(px) : 222);
			const drops = Array.from({ length: 26 }, (_, i) => {
				const l = document.createElementNS(NS, 'line');
				l.setAttribute('class', 'mi-drop');
				dropG.append(l);
				return { l, x: 8 + ((i * 131) % 346), ph: (i * 0.618) % 1, v: 0.9 + ((i * 7) % 5) * 0.08 };
			});
			const icicle = (px: number, py: number, len: number) =>
				len < 0.5 ? '' : `M${f1(px - 2.5)} ${f1(py)} L${f1(px + 2.5)} ${f1(py)} L${f1(px)} ${f1(py + len)} Z`;
			scene(card, 7, (x) => {
				const g = x;
				sag = 10 + 8 * g;
				let d = `M${W0} ${WY}`;
				for (let i = 1; i <= 20; i++) {
					const px = W0 + ((W1 - W0) * i) / 20;
					d += ` L${f1(px)} ${f1(wireY(px))}`;
				}
				wire.setAttribute('d', d);
				wireIce.setAttribute('d', d);
				wireIce.style.strokeWidth = f1(1.6 + 7 * g);
				treeIce.style.strokeWidth = f1(6 + 8 * g);
				wireEdge.setAttribute('d', d);
				wireEdge.style.strokeWidth = f1(3.2 + 7 * g);
				treeEdge.style.strokeWidth = f1(7.6 + 8 * g);
				for (const el of [wireIce, treeIce, wireEdge, treeEdge]) el.style.opacity = g > 0.01 ? '1' : '0';
				groundIce.setAttribute('y', f1(222 - 3 * g));
				groundIce.setAttribute('height', f1(3 * g));
				const icl = (n: number) => clamp((g - 0.15) / 0.85) * (8 + 5 * (n % 2));
				const cicles = [62, 92, 122, 150];
				treeIcicles.forEach((p, n) => p.setAttribute('d', icicle(cicles[n], branchY(cicles[n]) + 2 + 3.5 * g, icl(n))));
				[0.25, 0.42, 0.58, 0.75].forEach((t, n) => {
					const px = W0 + (W1 - W0) * t;
					wireIcicles[n].setAttribute('d', icicle(px, wireY(px) + 0.8 + 3.5 * g, icl(n + 1)));
				});
				const still = reduce();
				const now = performance.now() / 1000;
				for (const b of drops) {
					const f = still ? b.ph : (b.ph + now * b.v) % 1;
					const y0 = 36;
					const y1 = land(b.x);
					const y = y0 + (y1 - y0 + 8) * f;
					const head = Math.min(y, y1);
					b.l.setAttribute('x1', f1(b.x));
					b.l.setAttribute('x2', f1(b.x));
					b.l.setAttribute('y1', f1(head - 8));
					b.l.setAttribute('y2', f1(head));
					b.l.style.opacity = y >= y1 ? '0' : '1';
				}
			});
		}
	}
</script>
