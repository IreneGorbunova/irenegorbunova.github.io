---
/**
 * Two short looping opening scenes of «Плавление и отвердевание».
 * Snow: the sun shines on a snowdrift for three weeks (day 1 → 21 in 7 s); the drift shrinks slowly, a thermometer
 *   in it shows 0 °C all the time.
 * Casting: molten metal is poured into a bell mould (bell upright, poured through the crown, a core inside);
 *   it fills the mould, cools and solidifies, the mould is removed and a hollow bell is left.
 * Plays only while visible; with reduced motion shows the final state.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// Snow: ground line and the centre of the drift
const G = 200;
const CX = 140;
// Casting: bell (upright), poured through the crown
const bellOuter =
	'M240 128 C262 128 268 136 268 150 L272 186 C274 202 284 208 298 212 L298 216 L182 216 L182 212 C196 208 206 202 208 186 L212 150 C212 136 218 128 240 128 Z';
const bellInner =
	'M240 137 C256 137 260 143 260 153 L263 186 C265 200 274 209 288 216 L192 216 C206 209 215 200 217 186 L220 153 C220 143 224 137 240 137 Z';
const cup = 'M224 92 L256 92 L246 105 L234 105 Z';
const snowflake = (x: number, y: number, r: number) =>
	[0, 60, 120].map((a) => {
		const c = Math.cos((a * Math.PI) / 180) * r;
		const s = Math.sin((a * Math.PI) / 180) * r;
		return `M${(x - c).toFixed(1)} ${(y - s).toFixed(1)} L${(x + c).toFixed(1)} ${(y + s).toFixed(1)}`;
	}).join(' ');
---

<IntroFrame data-meltintro>
	<div class="intro__card" data-scene="snow">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Весна: солнце каждый день светит на сугроб, а он тает три недели; термометр в тающем снегу всё время показывает 0 °C">
			<rect class="mi-sky" x="0" y="0" width="360" height={G} />
			<g class="mi-cal">
				<rect x="14" y="13" width="22" height="20" rx="3" />
				<path d="M14 19 H36 M20 10 V15 M30 10 V15" />
				<text x="44" y="30" data-day>день 1</text>
			</g>
			<g class="mi-sun" transform="translate(304 46)">
				<g class="mi-sun__rays">
					{Array.from({ length: 8 }, (_, i) => (
						<line x1="20" y1="0" x2="27" y2="0" transform={`rotate(${i * 45})`} />
					))}
				</g>
				<circle r="15" />
			</g>
			<rect class="mi-soil" x="0" y={G} width="360" height={240 - G} />
			<g class="mi-grass" data-grass>
				{[22, 48, 214, 306, 338].map((x) => (
					<path d={`M${x - 5} ${G - 6} L${x} ${G} L${x + 1} ${G - 9} M${x} ${G} L${x + 6} ${G - 6}`} />
				))}
			</g>
			<rect class="mi-snowfill" x="0" y={G - 9} width="360" height="9" data-layer />
			<ellipse class="mi-water" cx="266" cy={G + 3} rx="6" ry="2" data-puddle />
			<path class="mi-trickle" d="" data-trickle />
			<!-- thermometer stuck in the snow -->
			<rect class="mi-tube" x={CX - 3} y="98" width="6" height="96" rx="3" />
			<line class="mi-tick" x1={CX - 8} x2={CX - 3} y1="112" y2="112" />
			<rect class="mi-col" x={CX - 1.4} y="112" width="2.8" height="84" />
			<circle class="mi-col" cx={CX} cy="196" r="5" />
			<path class="mi-snowfill" d="" data-drift />
			<rect class="mi-pill" x={CX - 34} y="64" width="68" height="26" rx="13" />
			<text class="mi-read" x={CX} y="82.5" text-anchor="middle">0&nbsp;°C</text>
			<g class="mi-rays" data-rays>
				{[0, 1].map(() => <line x1="0" y1="0" x2="0" y2="0" marker-end="url(#mi-arrow)" />)}
			</g>
			<defs>
				<marker id="mi-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
					<path class="mi-head" d="M 0 0 L 10 5 L 0 10 z" />
				</marker>
			</defs>
		</svg>
		<div class="intro__foot">
			<p>Солнце греет сугроб каждый день, а он тает неделями: на таяние нужно очень много теплоты. <More term="Почему?">Пока снег тает, термометр в нём показывает 0&nbsp;°C: вся теплота, которую получает снег, уходит на таяние, а не на нагревание. Чтобы растопить килограмм снега, нужно столько же теплоты, сколько, чтобы нагреть килограмм воды примерно на 80&nbsp;°C. Если бы на таяние хватало совсем немного теплоты, снег сходил бы за несколько часов&nbsp;— и каждую весну случались бы страшные наводнения. Так рассуждал Джозеф Блэк, о котором рассказано ниже, в разделе «Кто это открыл».</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="cast">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Литьё колокола: расплавленный металл льют из тигля в форму; он заполняет её, остывает и твердеет, форму снимают, и остаётся колокол">
			<rect class="mi-wall" x="0" y="0" width="360" height="222" />
			<rect class="mi-floor" x="0" y="222" width="360" height="18" />
			<g data-mould>
				<rect class="mi-sand" x="164" y="92" width="152" height="130" rx="3" />
				<g class="mi-dots">
					{[[174, 104], [300, 102], [176, 160], [306, 150], [180, 200], [304, 196], [196, 120], [286, 124]].map(([x, y]) => (
						<circle cx={x} cy={y} r="1.6" />
					))}
				</g>
				<path class="mi-void" d={bellOuter} />
				<rect class="mi-void" x="236" y="104" width="8" height="26" />
				<path class="mi-void" d={cup} />
				<path class="mi-sand" d={bellInner} />
			</g>
			<path class="mi-bellin" d={bellInner} data-bellin />
			<defs>
				<clipPath id="mi-level">
					<rect x="150" y="216" width="180" height="140" data-level />
				</clipPath>
			</defs>
			<g clip-path="url(#mi-level)">
				<path class="mi-glow" d={bellOuter} data-glow />
				<path class="mi-metal" d={`${bellOuter} ${bellInner}`} fill-rule="evenodd" data-bell />
				<g data-gate>
					<rect class="mi-metal" x="236" y="104" width="8" height="26" />
					<path class="mi-metal" d={cup} />
				</g>
			</g>
			<path class="mi-stream" d="" data-stream />
			<g data-crucible>
				<rect class="mi-rod" x="-54" y="-7" width="36" height="5" rx="2.5" />
				<path class="mi-crucible" d="M-20 -18 L20 -18 L15 18 Q15 22 11 22 L-11 22 Q-15 22 -15 18 Z" />
				<ellipse class="mi-melt" cx="0" cy="-18" rx="18" ry="3.5" data-meltop />
			</g>
			<rect class="mi-pill" x="254" y="13" width="96" height="26" rx="13" />
			<text class="mi-read" x="302" y="31.5" text-anchor="middle" data-state>жидкий</text>
		</svg>
		<div class="intro__foot">
			<p>Расплавленный металл заливают в форму; отвердевая, он принимает её вид. Так отливают колокола и памятники. <More term="Почему?">Металл расплавляют и заливают в форму. Отвердевая, он в точности повторяет её&nbsp;— так отливают детали машин, колокола, памятники. Внутри формы колокола стоит сердечник, поэтому колокол получается полым. На отвердевании держится и пайка: провода соединяют расплавленным припоем&nbsp;— сплавом олова со свинцом или другими металлами, который плавится при сравнительно низкой температуре. Застывая, припой скрепляет провода.</More></p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

</IntroFrame>

<style is:global>
	[data-meltintro] {
		--mi-snow: color-mix(in srgb, var(--sl-color-white) 88%, var(--ig-vx));
		--mi-edge: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-3));
		--mi-soil: color-mix(in srgb, var(--ig-v) 28%, var(--sl-color-gray-5));
		--mi-hot: color-mix(in srgb, var(--ig-v) 65%, var(--ig-vy));
		--mi-bronze: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-3));
		--mi-shade: var(--sl-color-black);
	}
	:root[data-theme='light'] [data-meltintro] {
		--mi-snow: var(--sl-color-black);
		--mi-edge: color-mix(in srgb, var(--ig-vx) 75%, var(--sl-color-gray-2));
		--mi-shade: var(--sl-color-white);
	}
	/* shared bits */
	.mi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.mi-read {
		font-size: 16px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.mi-soil {
		fill: var(--mi-soil);
	}
	.mi-dots circle {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-3));
	}
	.mi-snowfill {
		fill: var(--mi-snow);
		stroke: var(--mi-edge);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mi-water {
		fill: color-mix(in srgb, var(--ig-vx) 55%, transparent);
	}
	.mi-tube {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 25%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.mi-col {
		fill: var(--sl-color-red);
	}
	/* snow */
	.mi-sky {
		fill: color-mix(in srgb, var(--ig-vx) 16%, transparent);
	}
	.mi-cal rect,
	.mi-cal path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.mi-cal text {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.mi-sun circle {
		fill: var(--ig-v);
	}
	.mi-sun line {
		stroke: var(--ig-v);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.mi-sun__rays {
		animation: mi-spin 24s linear infinite;
	}
	@keyframes mi-spin {
		to { transform: rotate(45deg); }
	}
	.mi-rays line {
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 6 5;
		animation: mi-flow 0.8s linear infinite;
	}
	.mi-head {
		fill: var(--ig-v);
	}
	@keyframes mi-flow {
		to { stroke-dashoffset: -11; }
	}
	.mi-trickle {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, transparent);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.mi-grass path {
		fill: none;
		stroke: var(--sl-color-green);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* casting */
	.mi-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.mi-floor {
		fill: var(--sl-color-gray-5);
	}
	.mi-sand {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-void {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 40%, var(--mi-shade));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mi-bellin {
		fill: color-mix(in srgb, var(--mi-bronze) 45%, var(--mi-shade));
	}
	.mi-metal {
		fill: var(--mi-metal, var(--mi-hot));
	}
	.mi-glow {
		fill: none;
		stroke: var(--mi-hot);
		stroke-width: 9;
		stroke-linejoin: round;
	}
	.mi-stream {
		fill: none;
		stroke: var(--mi-hot);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.mi-rod {
		fill: var(--sl-color-gray-3);
	}
	.mi-crucible {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.mi-melt {
		fill: var(--mi-hot);
	}
	@media (prefers-reduced-motion: reduce) {
		.mi-sun__rays,
		.mi-rays line {
			animation: none;
		}
	}
</style>

<script>
	import { scene, clamp, reduce } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const deg = (v: number) => {
		const r = Math.round(v);
		return `${r < 0 ? '−' : r > 0 ? '+' : ''}${Math.abs(r)}\u00a0°C`;
	};
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-meltintro]')) {
		// Snow: day 1 → 21 in 7 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="snow"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 200;
			const CX = 140;
			const SUN = [304, 46];
			const day = $<SVGTextElement>('[data-day]');
			const drift = $<SVGPathElement>('[data-drift]');
			const layer = $<SVGRectElement>('[data-layer]');
			const puddle = $<SVGEllipseElement>('[data-puddle]');
			const trickle = $<SVGPathElement>('[data-trickle]');
			const grass = $<SVGGElement>('[data-grass]');
			const rays = Array.from(card.querySelectorAll<SVGLineElement>('[data-rays] line'));
			scene(card, 7, (x) => {
				day.textContent = `день ${1 + Math.round(20 * x)}`;
				const W = 125 - 72 * x;
				const H = 72 - 50 * x;
				const top = (xp: number) => G - (H * (1 + Math.cos((Math.PI * (xp - CX)) / W))) / 2;
				const pts: string[] = [];
				for (let i = 0; i <= 28; i++) {
					const xp = CX - W + (2 * W * i) / 28;
					pts.push(`${f1(xp)} ${f1(top(xp))}`);
				}
				drift.setAttribute('d', `M${pts.join(' L')} Z`);
				const th = 9 * (1 - clamp(x / 0.6));
				layer.setAttribute('y', f1(G - th));
				layer.setAttribute('height', f1(th));
				layer.style.opacity = th > 0.3 ? '1' : '0';
				grass.style.opacity = clamp((x - 0.5) / 0.25).toFixed(2);
				const e = clamp((x - 0.08) / 0.92);
				puddle.setAttribute('rx', f1(6 + 34 * e));
				puddle.setAttribute('ry', f1(2 + 2.5 * e));
				puddle.style.opacity = e > 0 ? '1' : '0';
				const tx = CX + W * 0.8;
				trickle.setAttribute('d', `M${f1(tx)} ${G + 1} Q${f1((tx + 226) / 2)} ${G + 4} ${f1(266 - 6 - 34 * e)} ${G + 3}`);
				trickle.style.opacity = e > 0 ? '1' : '0';
				[0.05, 0.5].forEach((k, i) => {
					const xt = CX + k * W;
					const yt = top(xt);
					const dx = SUN[0] - xt;
					const dy = SUN[1] - yt;
					const n = Math.hypot(dx, dy);
					rays[i].setAttribute('x1', f1(xt + (dx / n) * 46));
					rays[i].setAttribute('y1', f1(yt + (dy / n) * 46));
					rays[i].setAttribute('x2', f1(xt + (dx / n) * 5));
					rays[i].setAttribute('y2', f1(yt + (dy / n) * 5));
				});
			});
		}

		// Casting: pour, cool, open the mould (7 s)
		{
			const card = root.querySelector<HTMLElement>('[data-scene="cast"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const crucible = $<SVGGElement>('[data-crucible]');
			const meltTop = $<SVGEllipseElement>('[data-meltop]');
			const stream = $<SVGPathElement>('[data-stream]');
			const level = $<SVGRectElement>('[data-level]');
			const bell = $<SVGPathElement>('[data-bell]');
			const gate = $<SVGGElement>('[data-gate]');
			const glow = $<SVGPathElement>('[data-glow]');
			const mould = $<SVGGElement>('[data-mould]');
			const bellIn = $<SVGPathElement>('[data-bellin]');
			const state = $<SVGTextElement>('[data-state]');
			const P = [215, 58];
			const lip = [20, -18];
			scene(card, 7, (x) => {
				const tilt = x < 0.12 ? x / 0.12 : x < 0.55 ? 1 : 1 - clamp((x - 0.55) / 0.08);
				const a = 70 * (tilt * tilt * (3 - 2 * tilt));
				crucible.setAttribute('transform', `translate(${P[0]} ${P[1]}) rotate(${f1(a)})`);
				const r = (a * Math.PI) / 180;
				const lx = P[0] + lip[0] * Math.cos(r) - lip[1] * Math.sin(r);
				const ly = P[1] + lip[0] * Math.sin(r) + lip[1] * Math.cos(r);
				const pour = x > 0.11 && x < 0.56;
				stream.setAttribute('d', pour ? `M${f1(lx)} ${f1(ly)} C${f1(lx + 2)} ${f1(ly + 8)} 240 ${f1(ly + 12)} 240 102` : '');
				meltTop.style.opacity = (1 - clamp((x - 0.12) / 0.43)).toFixed(2);
				// metal level: bottom of the bell (216) up to the top of the cup (92)
				const f = clamp((x - 0.13) / 0.42);
				const y = 216 - 124 * f;
				level.setAttribute('y', f1(y));
				// cooling: k = 1 hot, 0 cold
				const k = 1 - clamp((x - 0.55) / 0.3);
				const metal = `color-mix(in srgb, var(--mi-hot) ${Math.round(100 * k)}%, var(--mi-bronze))`;
				bell.style.setProperty('--mi-metal', metal);
				gate.style.setProperty('--mi-metal', metal);
				glow.style.opacity = (0.35 * k).toFixed(2);
				const open = clamp((x - 0.86) / 0.12);
				mould.style.opacity = (1 - open).toFixed(2);
				gate.style.opacity = (1 - open).toFixed(2);
				bellIn.style.opacity = open.toFixed(2);
				state.textContent = x < 0.56 ? 'жидкий' : x < 0.85 ? 'твердеет' : 'твёрдый';
			});
		}

	}
</script>
