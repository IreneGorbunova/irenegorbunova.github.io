---
/**
 * The graph of melting and solidification of 0,1 kg of ice (heater and cooler pass 2 kJ per minute).
 * The pupil answers questions by tapping a part of the graph; every tap explains that part.
 * Times: AB 2,1 min (4200 J), BC 17 min (34 000 J), CD 8,4 min (16 800 J), then the mirror image.
 */
const P = { A: [0, -20], B: [2.1, 0], C: [19.1, 0], D: [27.5, 40], E: [35.9, 0], F: [52.9, 0], K: [55, -20] } as const;
type Key = keyof typeof P;
const G = { X0: 58, X1: 584, Y0: 262, Y1: 24, XMAX: 56, YMIN: -30, YMAX: 50 };
const gx = (v: number) => G.X0 + (v / G.XMAX) * (G.X1 - G.X0);
const gy = (t: number) => G.Y0 - ((t - G.YMIN) / (G.YMAX - G.YMIN)) * (G.Y0 - G.Y1);
const segs: [Key, Key, 'heat' | 'cool'][] = [
	['A', 'B', 'heat'],
	['B', 'C', 'heat'],
	['C', 'D', 'heat'],
	['D', 'E', 'cool'],
	['E', 'F', 'cool'],
	['F', 'K', 'cool'],
];
const xt = [0, 10, 20, 30, 40, 50];
const yt = [-20, -10, 0, 10, 20, 30, 40];
const labelPos: Record<Key, [number, number, string]> = {
	A: [9, 24, 'start'],
	B: [-8, -10, 'end'],
	C: [0, -12, 'middle'],
	D: [0, -12, 'middle'],
	E: [0, -12, 'middle'],
	F: [6, -10, 'start'],
	K: [-10, 24, 'end'],
};
---

<figure class="gseg not-content" data-gseg>
	<p class="gseg__q" aria-live="polite" data-q></p>
	<svg class="gseg__svg" viewBox="0 0 600 322" role="group" aria-label="График плавления и отвердевания льда">
		<g class="gseg__grid">
			{xt.slice(1).map((v) => <line x1={gx(v)} x2={gx(v)} y1={G.Y0} y2={G.Y1} />)}
			{yt.map((v) => <line x1={G.X0} x2={G.X1} y1={gy(v)} y2={gy(v)} />)}
		</g>
		<line class="gseg__axis" x1={G.X0} y1={gy(G.YMIN)} x2={G.X1 + 6} y2={gy(G.YMIN)}></line>
		<line class="gseg__axis" x1={G.X0} y1={gy(G.YMIN)} x2={G.X0} y2={G.Y1 - 6}></line>
		<g class="gseg__ticks">
			{xt.map((v) => <text x={gx(v)} y={gy(G.YMIN) + 22} text-anchor="middle">{v}</text>)}
			{yt.map((v) => <text x={G.X0 - 8} y={gy(v) + 5} text-anchor="end">{String(v).replace('-', '−')}</text>)}
			<text class="gseg__name" x={G.X0 + 8} y={G.Y1 + 2}><tspan class="gseg__math">t</tspan>, °C</text>
			<text class="gseg__name" x={(G.X0 + G.X1) / 2} y={gy(G.YMIN) + 54} text-anchor="middle">время, мин</text>
		</g>
		{
			segs.map(([a, b, kind]) => (
				<g class="gseg__seg" data-seg={a + b} tabindex="0" role="button" aria-label={`Участок ${a}${b}`}>
					<line class={`gseg__line gseg__line--${kind}`} x1={gx(P[a][0])} y1={gy(P[a][1])} x2={gx(P[b][0])} y2={gy(P[b][1])} />
					<line class="gseg__hit" x1={gx(P[a][0])} y1={gy(P[a][1])} x2={gx(P[b][0])} y2={gy(P[b][1])} />
				</g>
			))
		}
		{
			(Object.keys(P) as Key[]).map((k) => (
				<g class="gseg__pt">
					<circle cx={gx(P[k][0])} cy={gy(P[k][1])} r="4.5" />
					<text x={gx(P[k][0]) + labelPos[k][0]} y={gy(P[k][1]) + labelPos[k][1]} text-anchor={labelPos[k][2]}>
						{k}
					</text>
				</g>
			))
		}
	</svg>
	<div class="gseg__info" data-info hidden></div>
	<div class="gseg__nav">
		<p class="gseg__fb" aria-live="polite" data-fb></p>
		<button type="button" class="gseg__next" data-next hidden>Следующий вопрос</button>
	</div>
	<template data-text="AB">
		<b>AB — лёд нагревается</b> от −20 °C до 0 °C. Всё вещество твёрдое. За 2,1 мин лёд получил <span class="nw">2 кДж/мин · 2,1 мин = 4,2 кДж</span>. Проверим: <span class="nw"><i>Q</i> = <i>c</i><sub>льда</sub><i>m</i>(<i>t</i><sub>2</sub> − <i>t</i><sub>1</sub>)</span> = <span class="nw">2100 · 0,1 · 20 = 4200 Дж</span>.
	</template>
	<template data-text="BC">
		<b>BC — лёд плавится.</b> В сосуде одновременно лёд и вода, температура не меняется: 0 °C. Теплота поступает все 17 минут — <span class="nw">2 кДж/мин · 17 мин = 34 кДж</span>, — и вся она идёт на разрушение кристаллов: <span class="nw"><i>Q</i> = λ<i>m</i></span> = <span class="nw">3,4·10<sup>5</sup> · 0,1 = 34 000 Дж</span>.
	</template>
	<template data-text="CD">
		<b>CD — вода нагревается</b> от 0 °C до 40 °C и получает <span class="nw">4200 · 0,1 · 40 = 16 800 Дж</span>. Этот участок идёт в 2 раза положе, чем AB: удельная теплоёмкость воды в 2 раза больше, чем у льда, и на каждый градус ей нужно вдвое больше теплоты.
	</template>
	<template data-text="DE">
		<b>DE — вода остывает</b> от 40 °C до 0 °C и отдаёт охладителю те же 16 800 Дж, которые получила на участке CD.
	</template>
	<template data-text="EF">
		<b>EF — вода отвердевает (кристаллизуется).</b> Температура снова держится на 0 °C — той же, при которой лёд плавился. Частицы выстраиваются в кристаллическую решётку, и вода <em>выделяет</em> теплоту <span class="nw"><i>Q</i> = λ<i>m</i> = 34 000 Дж</span>. Поэтому участок EF такой же длинный, как BC.
	</template>
	<template data-text="FK">
		<b>FK — лёд остывает</b> от 0 °C до −20 °C и отдаёт 4200 Дж.
	</template>
</figure>

<style is:global>
	.gseg {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.gseg i,
	.gseg__math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.gseg__q {
		margin: 0 0 0.4rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.gseg__svg {
		display: block;
		width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.gseg text {
		font-family: var(--__sl-font);
	}
	.gseg__grid line {
		stroke: var(--sl-color-gray-5);
	}
	.gseg__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.gseg__ticks text {
		fill: var(--sl-color-gray-3);
		font-size: 14px;
	}
	.gseg__ticks .gseg__name {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
	}
	.gseg__seg {
		cursor: pointer;
		outline: none;
	}
	.gseg__line {
		stroke-width: 4;
		stroke-linecap: round;
		transition:
			stroke-width 0.2s,
			opacity 0.2s;
	}
	.gseg__line--heat {
		stroke: var(--ig-vy);
	}
	.gseg__line--cool {
		stroke: var(--ig-vx);
	}
	.gseg__hit {
		stroke: transparent;
		stroke-width: 26;
		stroke-linecap: round;
	}
	.gseg__seg:hover .gseg__line,
	.gseg__seg:focus-visible .gseg__line {
		stroke-width: 7;
	}
	.gseg__seg.is-picked .gseg__line {
		stroke-width: 8;
		stroke: var(--sl-color-accent);
	}
	.gseg__seg.is-wrong .gseg__line {
		animation: gseg-shake 0.4s;
	}
	@keyframes gseg-shake {
		30% {
			opacity: 0.2;
		}
	}
	.gseg__pt circle {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		pointer-events: none;
	}
	.gseg__pt text {
		fill: var(--sl-color-white);
		font-size: 17px;
		font-weight: 700;
		pointer-events: none;
		paint-order: stroke;
		stroke: var(--ig-surface);
		stroke-width: 5px;
		stroke-linejoin: round;
	}
	.gseg__info {
		margin-top: 0.5rem;
		padding: 0.6rem 0.8rem;
		border-left: 4px solid var(--sl-color-accent);
		border-radius: 0.4rem;
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
		color: var(--sl-color-gray-1);
		animation: gseg-in 0.35s ease-out;
	}
	.gseg__info[hidden] {
		display: none;
	}
	.gseg__info b {
		color: var(--sl-color-white);
	}
	@keyframes gseg-in {
		from {
			opacity: 0;
			transform: translateY(0.3rem);
		}
	}
	.gseg__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-top: 0.5rem;
	}
	.gseg__fb {
		flex: 1 1 14rem;
		min-height: 1.4em;
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.gseg__fb.is-right {
		color: var(--sl-color-text-accent);
		font-weight: 700;
	}
	.gseg__next {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		cursor: pointer;
	}
	.gseg__next[hidden] {
		display: none;
	}
	@media (max-width: 40rem) {
		.gseg {
			padding: 0.75rem;
		}
		.gseg__ticks text {
			font-size: 21px;
		}
		.gseg__ticks .gseg__name {
			font-size: 22px;
		}
		.gseg__pt text {
			font-size: 24px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.gseg__info,
		.gseg__seg.is-wrong .gseg__line {
			animation: none;
		}
	}
</style>

<script>
	const QUESTIONS: [string, string][] = [
		['На каком участке лёд плавится? Нажмите на него.', 'BC'],
		['На каком участке вода отвердевает (кристаллизуется)?', 'EF'],
		['На каком участке нагревается вода?', 'CD'],
		['На каком участке остывает лёд?', 'FK'],
		['На каком участке лёд нагревается?', 'AB'],
	];
	for (const root of document.querySelectorAll<HTMLElement>('[data-gseg]')) {
		const q = root.querySelector<HTMLElement>('[data-q]')!;
		const info = root.querySelector<HTMLElement>('[data-info]')!;
		const fb = root.querySelector<HTMLElement>('[data-fb]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const segs = Array.from(root.querySelectorAll<SVGGElement>('[data-seg]'));
		const text = (id: string) => root.querySelector<HTMLTemplateElement>(`template[data-text="${id}"]`)!.innerHTML;
		let k = 0;
		let done = false;
		const ask = () => {
			if (k >= QUESTIONS.length) {
				done = true;
				q.textContent = 'Все участки найдены! Нажимайте на любой участок, чтобы перечитать объяснение.';
				fb.textContent = '';
				next.hidden = true;
				return;
			}
			q.textContent = `Вопрос ${k + 1} из ${QUESTIONS.length}. ${QUESTIONS[k][0]}`;
			fb.textContent = '';
			fb.classList.remove('is-right');
			next.hidden = true;
		};
		const pick = (g: SVGGElement) => {
			const id = g.dataset.seg!;
			segs.forEach((s) => s.classList.toggle('is-picked', s === g));
			info.innerHTML = text(id);
			info.hidden = false;
			info.style.animation = 'none';
			void info.offsetWidth;
			info.style.animation = '';
			if (done || !next.hidden) return;
			if (id === QUESTIONS[k][1]) {
				fb.textContent = 'Верно!';
				fb.classList.add('is-right');
				next.hidden = false;
			} else {
				fb.textContent = `Нет, это участок ${id}. Прочитайте, что на нём происходит, и попробуйте ещё раз.`;
				g.classList.remove('is-wrong');
				void g.getBoundingClientRect();
				g.classList.add('is-wrong');
			}
		};
		segs.forEach((g) => {
			g.addEventListener('click', () => pick(g));
			g.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					pick(g);
				}
			});
		});
		next.addEventListener('click', () => {
			k += 1;
			ask();
		});
		ask();
	}
</script>
