---
/**
 * «Куда идёт индукционный ток»: a coil (8 см long, radius 2,5 см, 1000 turns, six drawn) with a galvanometer, and a bar
 * magnet (10 см) on its axis to the right. Four buttons: the N or the S pole is brought in (from 12 см to 3 см between
 * the pole and the coil's end) or taken away (back), at a steady 4 см/с for 2,25 с with 0,2 с smooth starts and stops
 * (real time, 900 px per meter). While the magnet moves: inside the coil a gray arrow shows the magnet's field and an
 * purple arrow the field of the induced current; green arrows the current on the front halves of the turns; the
 * letter on the coil's right end (N blue / S red) the pole the current makes; a gold arrow the force on the magnet.
 * When the magnet stops, the current stops: the arrows of the current, of its field and of the force fade out, the
 * needle comes back to zero; the text line under the picture stays.
 * Physics: the flux linkage from the two-pole model (emi.ts), I = (dΨ/dt)/R, R = 50 Ом; at 4 см/с the current is
 * about 0,1–0,4 мА, so this galvanometer is more sensitive: 1 division per 0,1 мА.
 * Directions (x to the right): N near the coil → the magnet's field inside points left; N in → flux grows → the
 * current's field points right → the right end is N → repulsion; N out → the current's field points left → the right
 * end is S → attraction; with S facing the coil everything turns over. Seen from the magnet the current is
 * counter-clockwise for «N in» and «S out», clockwise for «N out» and «S in».
 */
import G7Styles from '../g7/G7Styles.astro';
import EmiStyles from './EmiStyles.astro';
import { coilPaths, MAG_L, MAG_W } from './emi';

const S = 900;
const CX = 140;
const CY = 86;
const coil = coilPaths(CX, CY, 72, 22.5, 6, 0.32, 0.5); // current arrows at mid-height of the front strands
const ML = MAG_L * S;
const MW = MAG_W * S;
---

<G7Styles />
<EmiStyles />
<figure class="g7 g7--stack emi lz not-content" data-lenzpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 236" role="img" aria-label="Катушка с гальванометром и магнит справа на её оси; стрелки показывают поле магнита, поле индукционного тока, сам ток и силу, действующую на магнит">
			<g>{coil.back.map((d) => <path class="emi-cu is-back" stroke-width="2.8" d={d} />)}</g>
			<!-- arrows inside the coil: the magnet's field (gray) above the axis, the current's field (purple) below -->
			<path class="lz__bm" data-bm d=""></path>
			<path class="lz__bi" data-bi d=""></path>
			<g data-mag>
				<rect data-left x={-ML / 2} y={CY - MW / 2} width={ML / 2} height={MW} rx="1.5"></rect>
				<rect data-right x="0" y={CY - MW / 2} width={ML / 2} height={MW} rx="1.5"></rect>
				<text class="emi-pole" data-tl x={-ML / 4} y={CY + 5} text-anchor="middle" font-size="13">N</text>
				<text class="emi-pole" data-tr x={ML / 4} y={CY + 5} text-anchor="middle" font-size="13">S</text>
				<path class="lz__f" data-f d=""></path>
			</g>
			<g>{coil.front.map((d) => <path class="emi-cu" stroke-width="2.8" d={d} />)}</g>
			<g data-arrows>{coil.mids.map((m) => <path class="emi-i" data-x={m.x.toFixed(1)} data-y={m.y.toFixed(1)} data-dx={m.dx.toFixed(3)} data-dy={m.dy.toFixed(3)} />)}</g>
			<text class="lz__end" data-end x={coil.x1 + 4} y={CY - 30} text-anchor="middle" font-size="15"></text>
			<path class="emi-wire" d={`M${coil.x0} ${CY + 22.5} C${coil.x0 - 6} ${CY + 60} ${CX - 25} 158 ${CX - 25} 176`}></path>
			<path class="emi-wire" d={`M${coil.x1} ${CY + 22.5} C${coil.x1 + 6} ${CY + 60} ${CX + 25} 158 ${CX + 25} 176`}></path>
			<g data-galv></g>
			<text class="t-small" x="190" y="226">гальванометр</text>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn" data-case="Nin">Северный полюс вносим</button>
				<button type="button" class="g7__btn" data-case="Nout">Северный полюс выносим</button>
				<button type="button" class="g7__btn" data-case="Sin">Южный полюс вносим</button>
				<button type="button" class="g7__btn" data-case="Sout">Южный полюс выносим</button>
			</div>
			<p class="lz__line" data-line>Нажмите кнопку: магнит начнёт двигаться.</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Внутри катушки: <span class="lz__k-m">серая стрелка</span> — поле магнита, <span class="lz__k-i">фиолетовая</span> — поле индукционного тока. <span class="lz__k-c">Зелёные</span> стрелки — индукционный ток, <span class="lz__k-f">жёлтая</span> — сила, с которой катушка действует на магнит. Магнит движется со скоростью 4&nbsp;см/с; в катушке около тысячи витков, нарисовано шесть.
	</figcaption>
</figure>

<style is:global>
	.lz .lz__bm {
		fill: var(--emi-line);
	}
	.lz .lz__bi {
		fill: var(--emi-b);
	}
	.lz .lz__f {
		fill: var(--emi-f);
	}
	.lz .lz__end {
		font-weight: 700;
	}
	.lz__line {
		margin: 0;
		min-height: 2.8em;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	.lz__k-m {
		color: var(--sl-color-gray-2);
		font-weight: 600;
	}
	.lz__k-i {
		color: var(--sl-color-purple);
		font-weight: 600;
	}
	.lz__k-c {
		color: var(--sl-color-green);
		font-weight: 600;
	}
	.lz__k-f {
		color: var(--ig-v);
		font-weight: 600;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { linkage, needle, arrowHead, galvanometer, R_OHM, MAG_L } from './emi';

	const S = 900;
	const CX = 140;
	const CY = 86;
	const X1 = CX + 36; // the coil's right end
	const ML = MAG_L * S;
	const f1 = (v: number) => v.toFixed(1);
	// a flat arrow (shaft + head) from x0 to x1 at height y
	const flat = (x0: number, x1: number, y: number, w = 2.4, hd = 8) => {
		const s = Math.sign(x1 - x0) || 1;
		const xb = x1 - s * hd;
		return `M${f1(x0)} ${f1(y - w / 2)} L${f1(xb)} ${f1(y - w / 2)} L${f1(xb)} ${f1(y - 5)} L${f1(x1)} ${f1(y)} L${f1(xb)} ${f1(y + 5)} L${f1(xb)} ${f1(y + w / 2)} L${f1(x0)} ${f1(y + w / 2)} Z`;
	};
	const TEXT: Record<string, string> = {
		Nin: 'Поток растёт → поле тока против поля магнита → катушка отталкивает магнит',
		Sin: 'Поток растёт → поле тока против поля магнита → катушка отталкивает магнит',
		Nout: 'Поток убывает → поле тока по полю магнита → катушка притягивает магнит',
		Sout: 'Поток убывает → поле тока по полю магнита → катушка притягивает магнит',
	};

	for (const fig of document.querySelectorAll<HTMLElement>('[data-lenzpic]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const gal = galvanometer($('[data-galv]'), CX, 210, 24);
		const nd = needle();
		const mag = $<SVGGElement>('[data-mag]');
		const left = $<SVGRectElement>('[data-left]');
		const right = $<SVGRectElement>('[data-right]');
		const tl = $<SVGTextElement>('[data-tl]');
		const tr = $<SVGTextElement>('[data-tr]');
		const bm = $<SVGPathElement>('[data-bm]');
		const bi = $<SVGPathElement>('[data-bi]');
		const fArrow = $<SVGPathElement>('[data-f]');
		const end = $<SVGTextElement>('[data-end]');
		const line = $<HTMLParagraphElement>('[data-line]');
		const arrows = [...fig.querySelectorAll<SVGPathElement>('[data-arrows] path')];
		let nNear = true; // the N pole faces the coil
		let gap = 0.12; // м between the near pole and the coil's end
		let from = 0.12;
		let to = 0.12;
		let t = 99;
		let show = 0; // opacity of the arrows of the current, its field and the force
		let kind = '';
		const RUN = 2.25 + 0.2; // s of motion
		const gapAt = (tt: number) => {
			// steady speed with 0,2 s smooth starts and stops: a trapezoid of speed, integrated
			const v = (to - from) / (RUN - 0.2);
			const r = 0.2;
			const x = Math.min(tt, RUN);
			let s: number;
			if (x < r) s = (v * x * x) / (2 * r);
			else if (x < RUN - r) s = (v * r) / 2 + v * (x - r);
			else {
				const y = RUN - x;
				s = v * (RUN - 0.2) - (v * y * y) / (2 * r);
			}
			return from + s;
		};
		const centerOf = (g: number) => X1 + g * S + ML / 2; // the magnet's center, px
		const psi = (g: number) => linkage((centerOf(g) - CX) / S, !nNear);
		let prev = psi(gap);
		const PSI_NEAR = Math.abs(psi(0.03)); // the flux with the pole 3 см from the coil
		const draw = (I: number) => {
			mag.setAttribute('transform', `translate(${f1(centerOf(gap))} 0)`);
			left.setAttribute('class', nNear ? 'emi-n' : 'emi-s');
			right.setAttribute('class', nNear ? 'emi-s' : 'emi-n');
			tl.textContent = nNear ? 'N' : 'S';
			tr.textContent = nNear ? 'S' : 'N';
			// the magnet's field inside the coil: left when N is near
			const strong = Math.min(1, Math.abs(psi(gap)) / PSI_NEAR);
			const mdir = nNear ? -1 : 1;
			const lenM = 18 + 26 * strong;
			bm.setAttribute('d', flat(CX - (mdir * lenM) / 2, CX + (mdir * lenM) / 2, CY - 7));
			const sg = I > 0 ? 1 : -1; // I > 0: up on the front halves, its field points left
			bi.setAttribute('d', flat(CX + (sg * 36) / 2, CX - (sg * 36) / 2, CY + 7));
			bi.style.opacity = show.toFixed(2);
			for (const a of arrows) {
				const dx = sg * +a.dataset.dx!;
				const dy = sg * +a.dataset.dy!;
				const l = Math.hypot(dx, dy);
				a.setAttribute('d', arrowHead(+a.dataset.x! + (3.5 * dx) / l, +a.dataset.y! + (3.5 * dy) / l, dx, dy, 7.5));
				a.style.opacity = show.toFixed(2);
			}
			// the right end of the coil: N when the current's field points right (I < 0)
			end.textContent = I < 0 ? 'N' : 'S';
			end.setAttribute('class', `lz__end ${I < 0 ? 't-n' : 't-s'}`);
			end.style.opacity = show.toFixed(2);
			// force on the magnet: away from the coil (right) when like poles face each other
			const repel = (I < 0) === nNear;
			fArrow.setAttribute('d', flat(0, repel ? 34 : -34, 86 - 22, 3, 9));
			fArrow.style.opacity = show.toFixed(2);
		};
		let lastI = 0;
		for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-case]'))
			b.addEventListener('click', () => {
				kind = b.dataset.case!;
				nNear = kind[0] === 'N';
				const inward = kind.endsWith('in');
				from = inward ? 0.12 : 0.03;
				to = inward ? 0.03 : 0.12;
				gap = from;
				prev = psi(gap);
				t = 0;
				nd.reset();
				line.textContent = TEXT[kind];
				fig.querySelectorAll<HTMLButtonElement>('[data-case]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				wake();
			});
		draw(0);
		gal.set(0);
		const wake = loop(fig, (dt) => {
			if (dt <= 0) return true;
			t += dt;
			if (t <= RUN + 0.05) gap = gapAt(t);
			const p = psi(gap);
			const I = ((p - prev) / dt / R_OHM) * 1000; // мА
			prev = p;
			const moving = t < RUN;
			if (moving && Math.abs(I) > 1e-4) lastI = I;
			show = moving ? Math.min(1, show + dt / 0.15) : Math.max(0, show - dt / 0.6);
			const th = nd.step(I / 0.1, dt);
			gal.set(th);
			draw(lastI);
			return t < RUN + 2.5;
		});
	}
</script>
