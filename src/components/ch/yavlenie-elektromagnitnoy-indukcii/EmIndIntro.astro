---
/**
 * Two looping opening scenes of «Электромагнитная индукция» (grade 9). No terms of the chapter in the pictures; the
 * captions' popovers explain.
 *
 * Lantern: dusk at a campsite (a tent, pines, first stars). A teenager (1,65 м, 1,5 px per см) sits on a log with a
 *   camping lantern standing on the near thigh; the far hand holds the lantern's handle, the near hand grips the knob
 *   of a crank on the lantern's near side (crank radius 5 см). The run of 7 с: rest 0–1 с (dark), the crank speeds up
 *   1–1,5 с to 2 turns per second (a real hand speed), turns steadily to 4,5 с, slows down to rest at 5 с — exactly 7
 *   turns, so the loop ends where it began. The light follows the speed of turning and fades in about 0,5 с after the
 *   hand stops (the lantern's LEDs, the glow on the tent, the log and the face). Inset (no labels): inside the lantern
 *   a small magnet turns beside a coil on an iron core; it is drawn turning 1,5 times faster than the crank, while the
 *   real gearing is about 10 times (slowed so it can be seen).
 *
 * Trolleybus: a winter evening street, side view at 22 px per м. A trolleybus 12 м long drives from right to left at
 *   4 м/с (≈ 15 км/ч, real time) under two contact wires 5,8 м above the road; its two poles (6 м) slide along the
 *   wires on shoes. Over the street the wires are crossed by the wires of another line (drawn obliquely: they go away
 *   from the viewer); each crossing piece has short insulating inserts. When a shoe passes the crossing piece the
 *   contact breaks for a moment and a blue-white spark flashes for 0,1 с, lighting the wires and the snow (the near
 *   shoe first, the far one 0,11 с later). Two people wait at a stop, the nearer one looks up at the spark; three
 *   passengers sit in the lit windows (all drawn with the people kit; at this size their hands are mittens, so the
 *   poses are plain: standing with the arms down, sitting). Snow falls at about 1 м/с.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const gid = (n: string) => `eii-${n}-${uid}`;
// lantern scene: stars and pines
const STARS = [
	[24, 18, 1.1],
	[70, 40, 0.8],
	[118, 14, 1],
	[176, 30, 0.7],
	[214, 12, 1.2],
	[262, 44, 0.8],
	[150, 58, 0.6],
	[40, 70, 0.7],
	[340, 96, 0.7],
	[96, 88, 0.6],
];
const pine = (x: number, base: number, h: number) => {
	const w = h * 0.36;
	let d = '';
	for (let k = 0; k < 4; k++) {
		const top = base - h + (k * h) / 5;
		const bw = w * (0.45 + 0.18 * k);
		const bot = top + h * 0.38;
		d += `M${x} ${top} L${x + bw} ${bot} L${x - bw} ${bot} Z `;
	}
	return d;
};
// trolleybus scene: buildings with windows
const HOUSES = [
	{ x: -4, w: 92, h: 120 },
	{ x: 92, w: 70, h: 150 },
	{ x: 166, w: 104, h: 112 },
	{ x: 274, w: 92, h: 140 },
];
const WIN = HOUSES.flatMap((b, i) => {
	const out: { x: number; y: number; on: boolean }[] = [];
	for (let r = 0; r < Math.floor((b.h - 20) / 22); r++)
		for (let c = 0; c < Math.floor((b.w - 10) / 18); c++) out.push({ x: b.x + 10 + c * 18, y: 190 - b.h + 14 + r * 22, on: (i * 7 + r * 3 + c * 5) % 4 !== 0 });
	return out;
});
const FLAKES = Array.from({ length: 46 }, (_, k) => [((k * 97) % 360) + 0.5, (k * 53) % 240, 0.6 + ((k * 13) % 5) / 6]);
---

<PeopleStyles />
<IntroFrame data-emindintro>
	<div class="intro__card" data-scene="lantern">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер в походе: палатка, сосны, первые звёзды. Подросток сидит на бревне, держит на колене походный фонарь и крутит ручку на его боку. Пока ручка вращается, фонарь светит и освещает палатку и лицо; рука остановилась — свет гаснет. В круглой выноске видно, что внутри фонаря рядом с катушкой вращается маленький магнит">
			<defs>
				<linearGradient id={gid('sky')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" class="eii-sky0"></stop>
					<stop offset="1" class="eii-sky1"></stop>
				</linearGradient>
				<radialGradient id={gid('lamp')}>
					<stop offset="0" class="eii-warm" stop-opacity="0.75"></stop>
					<stop offset="0.35" class="eii-warm" stop-opacity="0.28"></stop>
					<stop offset="1" class="eii-warm" stop-opacity="0"></stop>
				</radialGradient>
				<clipPath id={gid('inset')}><circle cx="306" cy="52" r="36"></circle></clipPath>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${gid('sky')})`}></rect>
			{STARS.map(([x, y, r]) => <circle class="eii-star" cx={x} cy={y} r={r}></circle>)}
			<path class="eii-hill" d="M0 168 Q90 140 180 160 T360 150 V240 H0 Z"></path>
			<path class="eii-pine" d={pine(250, 206, 120) + pine(282, 200, 92) + pine(336, 208, 150) + pine(8, 190, 70)}></path>
			<path class="eii-ground" d="M0 200 Q180 194 360 202 V240 H0 Z"></path>
			<!-- the tent: an A-frame, its open door toward the fire side -->
			<path class="eii-tent" d="M14 206 L66 104 L124 206 Z"></path>
			<path class="eii-tent-side" d="M66 104 L96 100 L150 200 L124 206 Z"></path>
			<path class="eii-door" d="M66 120 L48 206 L84 206 Z"></path>
			<path class="eii-rope" d="M66 104 L4 196 M96 100 L168 192"></path>
			<!-- the log -->
			<rect class="eii-log" x="112" y="147" width="96" height="22" rx="11"></rect>
			<ellipse class="eii-log-end" cx="206" cy="158" rx="6" ry="11"></ellipse>
			<path class="eii-bark" d="M124 152 H170 M140 160 H196 M118 164 H150"></path>
			<!-- the glow of the lantern on the scene (opacity set by the script) -->
			<circle data-glow cx="190" cy="120" r="150" fill={`url(#${gid('lamp')})`} opacity="0"></circle>
			<g data-teen></g>
			<!-- the lantern on the thigh: body 12 см × 20 см; the handle and the crank are placed by the script -->
			<g data-lantern>
				<path class="eii-bail" data-bail d=""></path>
				<rect class="eii-lbody" x="-9" y="-30" width="18" height="30" rx="3"></rect>
				<rect class="eii-lcap" x="-10" y="-33" width="20" height="5" rx="2"></rect>
				<rect class="eii-lcap" x="-10" y="-3" width="20" height="4" rx="2"></rect>
				<rect class="eii-led" data-led x="-6.5" y="-26" width="13" height="20" rx="2"></rect>
				<circle class="eii-hub" cx="0" cy="-15" r="2.4"></circle>
				<path class="eii-crank" data-crank d=""></path>
			</g>
			<circle class="eii-knob" data-knob r="2.3" cx="0" cy="0"></circle>
			<g data-teen-near></g>
			<!-- inset: inside the lantern, no labels -->
			<circle class="eii-inset-bg" cx="306" cy="52" r="37"></circle>
			<g clip-path={`url(#${gid('inset')})`}>
				<rect class="eii-core" x="318" y="30" width="12" height="44" rx="1.5"></rect>
				{[0, 1, 2, 3, 4, 5, 6, 7, 8].map((k) => <rect class="eii-wind" x="314" y={33 + k * 4.4} width="20" height="3.2" rx="1.6"></rect>)}
				<g data-rotor>
					<circle class="eii-rotor" cx="0" cy="0" r="13"></circle>
					<rect class="eii-s" x="-12" y="-3.5" width="12" height="7" rx="1"></rect>
					<rect class="eii-n" x="0" y="-3.5" width="12" height="7" rx="1"></rect>
					<circle class="eii-shaft" cx="0" cy="0" r="2.2"></circle>
				</g>
			</g>
			<circle class="eii-inset-rim" cx="306" cy="52" r="37"></circle>
			<path class="eii-inset-link" d="M272 66 L204 104"></path>
		</svg>
		<div class="intro__foot">
			<p>Батарейки в походном фонаре сели, но стоит <More term="покрутить ручку">Ручка через шестерёнки быстро вращает маленький магнит рядом с катушкой из провода. Пока магнит вращается, в катушке возникает ток и зажигает светодиоды — так работает [индукционный генератор](#индукционный-генератор).</More> — и он снова светит.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="trolley">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимний вечер, улица, идёт снег. Троллейбус едет под проводами; над улицей их пересекают провода другой линии. Когда штанги троллейбуса проходят перекрёсток проводов, у их башмаков на миг вспыхивает голубая искра и освещает провода и снег. На остановке ждут двое, один смотрит вверх; в окнах троллейбуса сидят пассажиры">
			<defs>
				<linearGradient id={gid('night')} x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" class="eii-sky0"></stop>
					<stop offset="1" class="eii-sky1"></stop>
				</linearGradient>
				<radialGradient id={gid('spark')}>
					<stop offset="0" class="eii-spark-c" stop-opacity="1"></stop>
					<stop offset="0.25" class="eii-spark-c" stop-opacity="0.55"></stop>
					<stop offset="1" class="eii-spark-c" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id={gid('street')}>
					<stop offset="0" class="eii-warm" stop-opacity="0.45"></stop>
					<stop offset="1" class="eii-warm" stop-opacity="0"></stop>
				</radialGradient>
				<clipPath id={gid('wins')}>
					<rect data-wclip x="0" y="0" width="0" height="0"></rect>
				</clipPath>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill={`url(#${gid('night')})`}></rect>
			{HOUSES.map((b) => <rect class="eii-house" x={b.x} y={190 - b.h} width={b.w} height={b.h}></rect>)}
			{WIN.map((w) => <rect class={w.on ? 'eii-win is-on' : 'eii-win'} x={w.x} y={w.y} width="9" height="12" rx="1"></rect>)}
			<!-- the pavement with snow, the road -->
			<rect class="eii-snow" x="0" y="186" width="360" height="12"></rect>
			<rect class="eii-road" x="0" y="198" width="360" height="42"></rect>
			<path class="eii-mark" d="M0 222 H30 M60 222 H90 M120 222 H150 M180 222 H210 M240 222 H270 M300 222 H330"></path>
			<!-- the stop: a shelter on the pavement -->
			<path class="eii-shelter" d="M276 128 H346 V132 H276 Z M280 132 V190 M342 132 V190"></path>
			<rect class="eii-glass" x="300" y="134" width="40" height="44"></rect>
			<rect class="eii-sign" x="282" y="120" width="10" height="10" rx="2"></rect>
			<g data-waiting></g>
			<!-- street lamps -->
			<path class="eii-post" d="M20 190 V60 Q20 52 30 52 H46 M352 190 V64"></path>
			<circle cx="46" cy="58" r="40" fill={`url(#${gid('street')})`}></circle>
			<rect class="eii-lampbox" x="40" y="52" width="14" height="4" rx="1.5"></rect>
			<!-- the wires: two of our line (far one higher), the crossing line obliquely, the crossing pieces -->
			<path class="eii-span" d="M20 70 L352 76"></path>
			<path class="eii-wire" data-wire d="M0 82 H360 M0 88 H360"></path>
			<path class="eii-wire is-cross" data-wire d="M96 34 L184 134 M104 34 L192 134"></path>
			<path class="eii-frog" d="M131 80 H140 M144 86 H153 M139 80 H151 M152 86 H164"></path>
			<path class="eii-ins" d="M126 82 H131 M151 82 H156 M139 88 H144 M164 88 H169"></path>
			<!-- the trolleybus (moved by the script); the poles are drawn in screen coordinates -->
			<g data-bus>
				<g clip-path={`url(#${gid('wins')})`}>
					<rect class="eii-cabin" x="10" y="146" width="250" height="26"></rect>
					<g data-passengers></g>
				</g>
				<path class="eii-bus" data-busbody d=""></path>
				<path class="eii-bus-roof" d="M14 134 Q20 128 30 128 H250 Q258 128 260 134 Z"></path>
				<path class="eii-winframe" data-winframe d=""></path>
				<rect class="eii-stripe" x="2" y="178" width="262" height="5"></rect>
				<path class="eii-door-l" d="M44 150 V194 M62 150 V194 M150 150 V194 M168 150 V194"></path>
				<rect class="eii-head" x="2" y="182" width="5" height="4" rx="1"></rect>
				<rect class="eii-sign-b" x="8" y="137" width="30" height="7" rx="1.5"></rect>
				<rect class="eii-pod" x="150" y="124" width="40" height="6" rx="2"></rect>
				<g data-wheel transform="translate(52 198)"><circle class="eii-tyre" r="12"></circle><circle class="eii-rim" r="6"></circle><path class="eii-spoke" d="M-5 0 H5 M0 -5 V5"></path></g>
				<g data-wheel transform="translate(212 198)"><circle class="eii-tyre" r="12"></circle><circle class="eii-rim" r="6"></circle><path class="eii-spoke" d="M-5 0 H5 M0 -5 V5"></path></g>
			</g>
			<path class="eii-pole is-far" data-pole="1" d=""></path>
			<path class="eii-pole" data-pole="0" d=""></path>
			<rect class="eii-shoe is-far" data-shoe="1" width="7" height="3" rx="1"></rect>
			<rect class="eii-shoe" data-shoe="0" width="7" height="3" rx="1"></rect>
			<!-- the spark and its light -->
			<circle data-flash cx="148" cy="86" r="80" fill={`url(#${gid('spark')})`} opacity="0"></circle>
			<path class="eii-bolt" data-bolt d="" opacity="0"></path>
			<g class="eii-flakes" data-flakes>{FLAKES.map(([x, y, r]) => <circle cx={x} cy={y} r={r}></circle>)}</g>
		</svg>
		<div class="intro__foot">
			<p>Троллейбус проезжает под перекрёстком проводов — и наверху на миг <More term="вспыхивает голубая искра">На стыке проводов токоприёмник на мгновение теряет контакт с проводом. Ток в обмотках двигателя не может исчезнуть сразу и проскакивает по воздуху искрой — это [самоиндукция](#самоиндукция). Зимой, когда на проводах лёд, искр больше.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-emindintro] {
		--eii-sky0: color-mix(in srgb, var(--ig-vx) 22%, var(--sl-color-black));
		--eii-sky1: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-gray-5));
		--eii-dark: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-6));
		--eii-pine: color-mix(in srgb, hsl(150, 40%, 30%) 40%, var(--sl-color-black));
		--eii-ground: color-mix(in srgb, var(--ig-v) 14%, var(--sl-color-gray-6));
		--eii-warm: hsl(42, 100%, 72%);
		--eii-wood: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
		--eii-snow: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-3));
		--eii-spark: hsl(200, 100%, 88%);
	}
	:root[data-theme='light'] [data-emindintro] {
		--eii-sky0: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-1));
		--eii-sky1: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-gray-3));
		--eii-dark: color-mix(in srgb, var(--ig-vx) 20%, var(--sl-color-gray-2));
		--eii-pine: color-mix(in srgb, hsl(150, 40%, 22%) 70%, var(--sl-color-gray-1));
		--eii-ground: color-mix(in srgb, var(--ig-v) 20%, var(--sl-color-gray-2));
		--eii-wood: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-3));
		--eii-snow: color-mix(in srgb, var(--ig-vx) 8%, var(--sl-color-gray-5));
	}
	.eii-sky0 {
		stop-color: var(--eii-sky0);
	}
	.eii-sky1 {
		stop-color: var(--eii-sky1);
	}
	.eii-warm {
		stop-color: var(--eii-warm);
	}
	.eii-spark-c {
		stop-color: var(--eii-spark);
	}
	.eii-star {
		fill: hsl(48, 60%, 92%);
	}
	.eii-hill {
		fill: color-mix(in srgb, var(--eii-pine) 70%, var(--eii-sky1));
	}
	.eii-pine {
		fill: var(--eii-pine);
	}
	.eii-ground {
		fill: var(--eii-ground);
	}
	.eii-tent {
		fill: color-mix(in oklab, hsl(25, 70%, 50%) 55%, var(--eii-dark));
	}
	.eii-tent-side {
		fill: color-mix(in oklab, hsl(25, 70%, 45%) 35%, var(--eii-dark));
	}
	.eii-door {
		fill: color-mix(in srgb, var(--eii-dark) 70%, black);
	}
	.eii-rope,
	.eii-bark {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 60%, transparent);
		stroke-width: 0.7;
	}
	.eii-bark {
		stroke: color-mix(in oklab, var(--eii-wood) 60%, black);
		stroke-width: 1;
	}
	.eii-log {
		fill: var(--eii-wood);
	}
	.eii-log-end {
		fill: color-mix(in oklab, var(--eii-wood) 60%, white);
	}
	.eii-lbody {
		fill: color-mix(in srgb, hsl(150, 45%, 40%) 70%, var(--sl-color-gray-5));
	}
	.eii-lcap {
		fill: var(--sl-color-gray-4);
	}
	.eii-led {
		fill: color-mix(in srgb, var(--eii-warm) 15%, var(--sl-color-gray-6));
	}
	.eii-bail,
	.eii-crank {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.eii-hub {
		fill: var(--sl-color-gray-3);
	}
	.eii-knob {
		fill: color-mix(in srgb, var(--ig-vy) 60%, var(--sl-color-gray-4));
	}
	.eii-inset-bg {
		fill: var(--eii-dark);
	}
	.eii-inset-rim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.eii-inset-link {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	.eii-core {
		fill: var(--sl-color-gray-4);
	}
	.eii-wind {
		fill: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
	}
	.eii-rotor {
		fill: var(--sl-color-gray-5);
	}
	.eii-n {
		fill: var(--ig-vx);
	}
	.eii-s {
		fill: var(--ig-vy);
	}
	.eii-shaft {
		fill: var(--sl-color-gray-2);
	}
	/* trolleybus */
	.eii-house {
		fill: var(--eii-dark);
	}
	.eii-win {
		fill: color-mix(in srgb, var(--eii-dark) 70%, var(--sl-color-gray-4));
	}
	.eii-win.is-on {
		fill: color-mix(in srgb, var(--eii-warm) 55%, var(--eii-dark));
	}
	.eii-snow {
		fill: var(--eii-snow);
	}
	.eii-road {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 70%, var(--eii-dark));
	}
	.eii-mark {
		stroke: var(--eii-snow);
		stroke-width: 1.5;
	}
	.eii-shelter {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.eii-glass {
		fill: color-mix(in srgb, var(--ig-vx) 20%, transparent);
	}
	.eii-sign {
		fill: hsl(45, 90%, 55%);
	}
	.eii-post {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 3;
	}
	.eii-lampbox {
		fill: var(--eii-warm);
	}
	.eii-span {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.7;
	}
	.eii-wire {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.eii-wire.is-cross {
		stroke-width: 0.8;
	}
	.eii-frog {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
	}
	.eii-ins {
		stroke: hsl(20, 60%, 45%);
		stroke-width: 2.4;
	}
	.eii-cabin {
		fill: color-mix(in srgb, var(--eii-warm) 45%, var(--eii-dark));
	}
	.eii-bus {
		fill-rule: evenodd;
		fill: color-mix(in srgb, hsl(205, 60%, 50%) 60%, var(--sl-color-gray-4));
	}
	.eii-bus-roof,
	.eii-pod {
		fill: var(--sl-color-gray-4);
	}
	.eii-winframe {
		fill: none;
		stroke: color-mix(in srgb, hsl(205, 60%, 30%) 60%, var(--sl-color-gray-5));
		stroke-width: 1.5;
	}
	.eii-stripe {
		fill: var(--sl-color-gray-2);
	}
	.eii-door-l {
		stroke: color-mix(in srgb, hsl(205, 60%, 25%) 60%, var(--sl-color-gray-6));
		stroke-width: 1;
	}
	.eii-head {
		fill: var(--eii-warm);
	}
	.eii-sign-b {
		fill: hsl(32, 100%, 55%);
	}
	.eii-tyre {
		fill: hsl(220, 10%, 14%);
	}
	.eii-rim {
		fill: var(--sl-color-gray-3);
	}
	.eii-spoke {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.4;
	}
	.eii-pole {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.eii-pole.is-far,
	.eii-shoe.is-far {
		opacity: 0.7;
	}
	.eii-shoe {
		fill: var(--sl-color-gray-2);
	}
	.eii-bolt {
		fill: none;
		stroke: var(--eii-spark);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.eii-flakes circle {
		fill: hsl(210, 30%, 94%);
		opacity: 0.85;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';
	import { figure, ROLL, type Pt } from '@components/people';

	const f1 = (v: number) => v.toFixed(1);
	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-emindintro]')) {
		// ---- the lantern
		{
			const card = root.querySelector<HTMLElement>('[data-scene="lantern"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1.5; // px per см
			const H = 165;
			const teen = figure($<SVGGElement>('[data-teen]'), { s: S, H, age: 'teen', shirt: 'hm-green', hair: 'short', clothes: 'indoor', name: 'teen with a lantern' });
			// the hip on the log (its top at y = 147), the soles on the ground (y = 204); ankle 7 см above the sole
			const HIP: Pt = { x: 150, y: 140 };
			const ANK: [Pt, Pt] = [
				{ x: 214, y: 204 - 7 * S },
				{ x: 202, y: 204 - 7 * S },
			];
			// the lantern stands on the near thigh, 72 % of the way to the knee (the knee from a first pose)
			const st0 = teen.pose({ hip: HIP, lean: 0.1, ankles: ANK, feet: [0, 0], hands: [{ arm: [1.6, 0.3] }, { arm: [1.6, 0.3] }] });
			const knee = st0.knees[0];
			const thighTop = (x: number) => HIP.y - 0.05 * H * S + ((knee.y - 0.05 * H * S - HIP.y + 0.05 * H * S) * (x - HIP.x)) / (knee.x - HIP.x);
			const LX = HIP.x + 0.72 * (knee.x - HIP.x);
			const LY = thighTop(LX) + 1;
			const lantern = $<SVGGElement>('[data-lantern]');
			lantern.setAttribute('transform', `translate(${f1(LX)} ${f1(LY)})`);
			// the crank: its hub on the near side at the lantern's middle, radius 5 см; the bail over the top
			const HUB: Pt = { x: LX, y: LY - 15 };
			const RC = 5 * S;
			const HANDLE: Pt = { x: LX, y: LY - 44 };
			$<SVGPathElement>('[data-bail]').setAttribute('d', 'M-8 -32 Q-8 -46 0 -46 Q8 -46 8 -32');
			const crank = $<SVGPathElement>('[data-crank]');
			const knob = $<SVGCircleElement>('[data-knob]');
			const led = $<SVGRectElement>('[data-led]');
			const glow = $<SVGCircleElement>('[data-glow]');
			const rotor = $<SVGGElement>('[data-rotor]');
			// the near arm is drawn in front of the lantern: move the kit's near arm group into the front layer
			const front = $<SVGGElement>('[data-teen-near]');
			const RUN = 7;
			const W = 2 * 2 * Math.PI; // rad/s at full speed
			// the crank angle: ramps of 0,5 s (smoothstep) at 1–1,5 s and 4,5–5 s; 7 turns in all
			const angle = (t: number) => {
				// ∫ smoothstep over a ramp of 0,5 s: 0,5·(u³ − u⁴/2), 0,25 s at its end
				const ramp = (u: number) => 0.5 * (u * u * u - 0.5 * u * u * u * u);
				if (t < 1) return 0;
				if (t < 1.5) return W * ramp((t - 1) / 0.5);
				if (t < 4.5) return W * (0.25 + (t - 1.5));
				if (t < 5) return W * (3.25 + (t - 4.5) - ramp((t - 4.5) / 0.5));
				return W * 3.5; // 3,5 s at full speed = 7 turns
			};
			const speed = (t: number) => (t < 1 || t > 5 ? 0 : t < 1.5 ? smooth(1, 1.5, t) : t < 4.5 ? 1 : 1 - smooth(4.5, 5, t));
			// the light: follows the speed, fades with a time constant of 0,12 s (gone in about 0,5 s)
			const light = (t: number) => {
				if (t <= 5) return speed(t);
				return Math.exp(-(t - 5) / 0.12) * speed(5);
			};
			let moved = false;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const a = angle(t) - Math.PI / 2; // the knob starts at the top
				const k: Pt = { x: HUB.x + RC * Math.cos(a), y: HUB.y + RC * Math.sin(a) };
				crank.setAttribute('d', `M0 -15 L${f1(RC * Math.cos(a))} ${f1(-15 + RC * Math.sin(a))}`);
				knob.setAttribute('cx', f1(k.x));
				knob.setAttribute('cy', f1(k.y));
				teen.pose({
					hip: HIP,
					lean: 0.1,
					head: 0.32,
					ankles: ANK,
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: k, pose: 'grip', d: 1.6, dir: 0.5, roll: ROLL.backViewer, contact: 'crank knob' },
						{ at: HANDLE, pose: 'grip', d: 1.2, dir: 0.15, roll: ROLL.palmCw, contact: 'lantern handle' },
					],
				});
				if (!moved) {
					// the kit draws the near arm last in its root group (two limb paths and the hand, indoor clothes): move
					// them in front of the lantern, which stands in front of the body
					const rootG = $<SVGGElement>('[data-teen]').firstElementChild!;
					const kids = [...rootG.children].slice(-3);
					front.append(...kids);
					moved = true;
				}
				const L = light(t);
				led.style.fill = `color-mix(in srgb, var(--eii-warm) ${Math.round(15 + 85 * L)}%, var(--sl-color-gray-6))`;
				glow.setAttribute('opacity', (0.9 * L).toFixed(2));
				rotor.setAttribute('transform', `translate(292 52) rotate(${f1((1.5 * angle(t) * 180) / Math.PI)})`);
			});
		}

		// ---- the trolleybus
		{
			const card = root.querySelector<HTMLElement>('[data-scene="trolley"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 22; // px per м
			const V = 4 * K; // px/s
			const ROAD = 198;
			const bus = $<SVGGElement>('[data-bus]');
			const wheels = [...card.querySelectorAll<SVGGElement>('[data-wheel]')];
			const poles = [0, 1].map((i) => $<SVGPathElement>(`[data-pole="${i}"]`));
			const shoes = [0, 1].map((i) => $<SVGRectElement>(`[data-shoe="${i}"]`));
			const flash = $<SVGCircleElement>('[data-flash]');
			const bolt = $<SVGPathElement>('[data-bolt]');
			const flakes = [...card.querySelectorAll<SVGCircleElement>('[data-flakes] circle')];
			const wires = [...card.querySelectorAll<SVGPathElement>('[data-wire]')];
			// windows of the bus (its own coordinates) and the clip that shows the passengers only through them
			const WINS = [
				[66, 80],
				[84, 98],
				[102, 120],
				[124, 146],
				[172, 192],
				[196, 216],
				[220, 240],
				[244, 258],
			];
			const holes = WINS.map(([a, b]) => `M${a} 148 H${b} V172 H${a} Z`).join(' ') + ' M10 140 Q8 160 10 174 H38 V140 Z';
			$<SVGPathElement>('[data-winframe]').setAttribute('d', holes);
			// the body with the windows cut out (even-odd), so the lit cabin and the passengers show through
			$<SVGPathElement>('[data-busbody]').setAttribute('d', 'M2 196 V150 Q2 136 16 134 L250 134 Q264 134 264 148 V196 Z ' + holes);
			const clip = $<SVGRectElement>('[data-wclip]');
			clip.setAttribute('x', '10');
			clip.setAttribute('y', '146');
			clip.setAttribute('width', '250');
			clip.setAttribute('height', '26');
			// passengers, seated, facing left (the way the bus goes), 1,7 м at 22 px per м
			const pg = $<SVGGElement>('[data-passengers]');
			const SP = 0.22;
			[
				{ x: 92, shirt: 'hm-red', hair: 'pony' as const },
				{ x: 136, shirt: 'hm-blue', hair: 'short' as const },
				{ x: 206, shirt: 'hm-gold', hair: 'short' as const },
			].forEach((p, i) => {
				const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
				pg.append(g);
				const fig = figure(g, { s: SP, H: 170, clothes: 'winter', shirt: p.shirt, hair: p.hair, dir: -1, name: `passenger ${i + 1}` });
				const hip = { x: p.x, y: 180 };
				fig.pose({
					hip,
					lean: 0.05,
					ankles: [
						{ x: hip.x - 8, y: 193 },
						{ x: hip.x - 6, y: 193 },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: hip.x - 6, y: hip.y - 2 }, pose: 'relaxed' },
						{ at: { x: hip.x - 5, y: hip.y - 1 }, pose: 'relaxed' },
					],
				});
			});
			// two people at the stop, winter clothes, 1,72 м and 1,62 м; the nearer one (facing left) looks up at the spark
			const wg = $<SVGGElement>('[data-waiting]');
			const mkp = (o: { H: number; shirt: string; hair: 'short' | 'pony'; dir: 1 | -1; name: string }) => {
				const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
				wg.append(g);
				return figure(g, { s: SP, H: o.H, clothes: 'winter', shirt: o.shirt, hair: o.hair, dir: o.dir, name: o.name });
			};
			const pA = mkp({ H: 162, shirt: 'hm-red', hair: 'pony', dir: 1, name: 'woman at the stop' });
			const pB = mkp({ H: 172, shirt: 'hm-green', hair: 'short', dir: -1, name: 'man at the stop' });
			const stand = (fig: ReturnType<typeof figure>, x: number, H: number, dir: 1 | -1, head: number) => {
				const u = H * SP;
				const hip = { x, y: 189 - 8 * SP - 0.47 * u };
				fig.pose({
					hip,
					lean: 0.02,
					head,
					ankles: [
						{ x: x + dir * 1.5, y: 189 - 8 * SP },
						{ x: x - dir * 1.5, y: 189 - 8 * SP },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: x + dir * 1.2, y: hip.y + 0.06 * u }, pose: 'relaxed' },
						{ at: { x: x - dir * 0.5, y: hip.y + 0.06 * u }, pose: 'relaxed' },
					],
				});
			};
			// the bus: its front at x0 + … ; the poles' bases on the roof 150 px behind the front; 6 м poles
			const X0 = 372;
			const RUN = (X0 + 420) / V; // until the shoes have left the frame
			const WIRE = [88, 82];
			const LP = 6 * K;
			const BASE = [
				{ dx: 156, y: 124 },
				{ dx: 160, y: 121 },
			];
			const shoeAt = (xf: number, i: number) => {
				const b = { x: xf + BASE[i].dx, y: BASE[i].y };
				const h = b.y - WIRE[i];
				return { b, s: { x: b.x + Math.sqrt(LP * LP - h * h), y: WIRE[i] } };
			};
			// the crossing pieces where the shoes meet them: x = 152,8 (near wire) and 143,2 (far wire)
			const CROSS = [152.8, 143.2];
			const tSpark = CROSS.map((c, i) => (X0 + BASE[i].dx + Math.sqrt(LP * LP - (BASE[i].y - WIRE[i]) ** 2) - c) / V);
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const xf = X0 - V * t;
				bus.setAttribute('transform', `translate(${f1(xf)} 0)`);
				const rot = ((-(V * t) / 12) * 180) / Math.PI;
				wheels.forEach((w, i) => w.setAttribute('transform', `translate(${i ? 212 : 52} ${ROAD}) rotate(${f1(rot)})`));
				let spark = 0;
				let sx = 0;
				let sy = 0;
				[0, 1].forEach((i) => {
					const { b, s } = shoeAt(xf, i);
					poles[i].setAttribute('d', `M${f1(b.x)} ${f1(b.y)} L${f1(s.x)} ${f1(s.y)}`);
					shoes[i].setAttribute('x', f1(s.x - 3.5));
					shoes[i].setAttribute('y', f1(s.y - 1));
					const a = t - tSpark[i];
					if (a >= 0 && a < 0.1) {
						const v = 1 - a / 0.1;
						if (v > spark) {
							spark = v;
							sx = s.x;
							sy = s.y;
						}
					}
				});
				flash.setAttribute('opacity', (0.95 * spark).toFixed(2));
				if (spark > 0) {
					flash.setAttribute('cx', f1(sx));
					flash.setAttribute('cy', f1(sy));
					const j = Math.floor(t * 60);
					const z = (k: number) => (((j * 7 + k * 13) % 9) - 4) * 0.9;
					bolt.setAttribute('d', `M${f1(sx - 4)} ${f1(sy)} L${f1(sx - 1)} ${f1(sy + 3 + z(1))} L${f1(sx + 1)} ${f1(sy - 2 + z(2))} L${f1(sx + 4)} ${f1(sy + 1)}`);
				}
				bolt.setAttribute('opacity', spark > 0 ? '1' : '0');
				wires.forEach((w) => (w.style.stroke = spark > 0 ? `color-mix(in srgb, var(--eii-spark) ${Math.round(80 * spark)}%, var(--sl-color-gray-3))` : ''));
				// the man looks up at the crossing during the spark and a little after, then back
				const look = smooth(tSpark[0] - 0.25, tSpark[0] + 0.25, t) * (1 - smooth(tSpark[0] + 2.2, tSpark[0] + 3, t));
				stand(pA, 300, 162, 1, 0.05);
				stand(pB, 322, 172, -1, 0.05 - 0.6 * look);
				// snow: 1 м/с down, a little drift
				flakes.forEach((c, k) => {
					const r = +c.getAttribute('r')!;
					const y0 = (k * 53) % 240;
					const y = (y0 + t * K * (0.8 + 0.4 * r)) % 240;
					c.setAttribute('cy', f1(y));
					c.setAttribute('cx', f1(((k * 97) % 360) + 4 * Math.sin(t * 0.9 + k)));
				});
			});
		}
	}
</script>
