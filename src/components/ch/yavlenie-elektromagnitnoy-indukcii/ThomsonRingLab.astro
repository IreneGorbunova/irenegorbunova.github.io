---
/**
 * «Прыгающее кольцо» (Thomson's ring). A vertical coil (12 см wide, 10 см tall) on an iron core that sticks out 25 см
 * above it; a ring (outer diameter 6 см) sits loosely on the core on top of the coil. The coil is fed by a DC source
 * through a key. Scale 6 px per см, real time.
 * Closing the key: the coil's current and its flux grow and settle in about 0,1 с (time constant 0,03 с). In the solid
 * aluminium ring a current appears while the flux grows; its field is opposite to the coil's, like poles face each
 * other, and the ring is thrown up. Its flight is ballistic with g = 9,8 м/с²: a jump of 10 см, υ₀ = √(2gh) = 1,4 м/с,
 * 0,14 с up and 0,14 с down (the height is illustrative, not computed from the circuit). It falls back and lies on the
 * coil while the current is steady (no force). Opening the key: the flux falls; the ring's current makes a field along
 * the coil's, unlike poles face each other and the ring is pulled down onto the coil (a short gold arrow; it already
 * lies on the coil, so it does not move). The ring with a cut and the plastic ring never move: no closed circuit, no
 * conductor. Reversing the source (only with the key open) gives the same jump: repulsion does not depend on the
 * direction of the current.
 * «Показать поля и токи»: gray arrows of the coil's field in the core, green arrows of the currents on the front of the
 * coil and of the ring, the purple arrow of the ring's field, the letters of the poles on the coil's top end and the
 * ring (beside it, for its lower face), the gold arrow of the force on the ring. The ring's current lasts only about
 * 0,1 с; its arrows are held for 0,6 с so that they can be seen (the caption says so); after opening, the coil's field
 * arrows and pole letter are held as long, as they were while the flux fell.
 */
import G7Styles from '../g7/G7Styles.astro';
import EmiStyles from './EmiStyles.astro';

const K = 6; // px per см
const CX = 178; // axis of the core
const TOP = 212; // top of the coil
const BOT = TOP + 10 * K;
const CORE_TOP = TOP - 25 * K;
const turns = Array.from({ length: 12 }, (_, k) => TOP + 3 + k * 4.6);
---

<G7Styles />
<EmiStyles />
<figure class="g7 emi tr not-content" data-thomsonlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Вертикальная катушка на железном сердечнике, на сердечнике сверху лежит кольцо; катушка подключена к источнику тока через ключ">
			<!-- the ruler beside the core -->
			<g class="tr__ruler">
				<path d={`M244 ${TOP} V${TOP - 20 * K}`}></path>
				{[0, 5, 10, 15, 20].map((c) => (
					<>
						<path d={`M244 ${TOP - c * K} H252`}></path>
						<text x="256" y={TOP - c * K + 4}>{c} см</text>
					</>
				))}
			</g>
			<!-- the ring's back half, behind the core -->
			<path class="tr__ring is-back" data-ring-back d=""></path>
			<rect class="tr__core" x={CX - 8} y={CORE_TOP} width="16" height={BOT - CORE_TOP + 6}></rect>
			<g data-bcoil>
				<path class="tr__barrow" d="" data-bc="0"></path>
				<path class="tr__barrow" d="" data-bc="1"></path>
			</g>
			<!-- the coil -->
			<rect class="tr__coil" x={CX - 36} y={TOP} width="72" height={10 * K} rx="4"></rect>
			{turns.map((y) => <path class="emi-cu" stroke-width="2.6" d={`M${CX - 35} ${y} Q${CX} ${y + 4} ${CX + 35} ${y}`} />)}
			<rect class="tr__base" x={CX - 60} y={BOT} width="120" height="10" rx="2"></rect>
			<g data-coil-i><path class="emi-i"></path><path class="emi-i"></path></g>
			<text class="tr__pole" data-cpole x={CX + 44} y={TOP + 6}></text>
			<!-- the source and the key -->
			<path class="emi-wire" d={`M${CX - 36} ${BOT - 6} H60 V196 M60 176 V150 H80 M104 150 H120 V${TOP + 8} H${CX - 36}`}></path>
			<path class="tr__bat" data-bat d=""></path>
			<text class="t-small" data-batl x="22" y="190"></text>
			<circle class="tr__kp" cx="80" cy="150" r="2.4"></circle>
			<circle class="tr__kp" cx="104" cy="150" r="2.4"></circle>
			<path class="tr__key" data-key d=""></path>
			<text class="t-small" x="92" y="138" text-anchor="middle">ключ</text>
			<!-- the ring (front half), its current, its field, the force on it -->
			<g data-ring>
				<path class="tr__ring" data-ring-front d=""></path>
				<path class="emi-i" data-ring-i d=""></path>
				<path class="tr__bi" data-ring-b d=""></path>
				<text class="tr__pole" data-rpole x={CX - 24} y="0" text-anchor="end"></text>
				<path class="tr__f" data-ring-f d=""></path>
			</g>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-key-btn>Замкнуть ключ</button>
				<button type="button" class="g7__btn" data-pol>Поменять полюсы источника</button>
			</div>
			<div class="g7__seg" role="group" aria-label="Кольцо">
				<button type="button" class="g7__btn" aria-pressed="true" data-ring-kind="al">Алюминиевое кольцо</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-ring-kind="cut">Кольцо с разрезом</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-ring-kind="pl">Пластмассовое кольцо</button>
			</div>
			<label class="g7__label tr__check"><input type="checkbox" data-show /> Показать поля и токи</label>
			<p class="g7__note" data-note></p>
		</div>
	</div>
	<figcaption class="g7__caption">Размеры и время настоящие; высота прыжка (около 10&nbsp;см) показана примерно — она зависит от тока и от кольца. Ток в кольце длится около 0,1&nbsp;с, его стрелки показаны дольше.</figcaption>
</figure>

<style is:global>
	.tr__ruler path {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.tr .tr__ruler text {
		font-size: 10px;
		fill: var(--sl-color-gray-3);
	}
	.tr__core {
		fill: var(--emi-fe);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.tr__coil {
		fill: color-mix(in srgb, var(--emi-cu) 35%, var(--sl-color-gray-6));
	}
	.tr__base {
		fill: var(--sl-color-gray-4);
	}
	.tr__barrow {
		fill: var(--emi-line);
	}
	.tr__ring {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-gray-2) 85%, var(--ig-vx));
		stroke-width: 5;
		stroke-linecap: butt;
	}
	.tr__ring.is-back {
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 70%, var(--sl-color-gray-5));
	}
	.tr[data-kind='pl'] .tr__ring {
		stroke: hsl(195, 70%, 45%);
	}
	.tr[data-kind='pl'] .tr__ring.is-back {
		stroke: hsl(195, 50%, 32%);
	}
	.tr__bi {
		fill: var(--emi-b);
	}
	.tr__f {
		fill: var(--emi-f);
	}
	.tr .tr__pole {
		font-size: 14px;
		font-weight: 700;
	}
	.tr__bat {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2.4;
	}
	.tr__key {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.tr__kp {
		fill: var(--sl-color-gray-1);
	}
	.tr__check {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.tr__check input {
		accent-color: var(--sl-color-purple);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { arrowHead } from './emi';

	const K = 6;
	const CX = 178;
	const TOP = 212;
	const G = 9.8 * 100 * K; // px/s²
	const V0 = Math.sqrt(2 * 9.8 * 0.1) * 100 * K; // px/s, a jump of 10 см
	const RX = 18;
	const RY = 6;
	const f1 = (v: number) => v.toFixed(1);
	// a flat vertical arrow from y0 to y1 at x
	const vflat = (x: number, y0: number, y1: number, w = 2.6, hd = 8) => {
		const s = Math.sign(y1 - y0) || 1;
		const yb = y1 - s * hd;
		return `M${f1(x - w / 2)} ${f1(y0)} L${f1(x - w / 2)} ${f1(yb)} L${f1(x - 5)} ${f1(yb)} L${f1(x)} ${f1(y1)} L${f1(x + 5)} ${f1(yb)} L${f1(x + w / 2)} ${f1(yb)} L${f1(x + w / 2)} ${f1(y0)} Z`;
	};

	for (const fig of document.querySelectorAll<HTMLElement>('[data-thomsonlab]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const $$ = <T extends Element>(s: string) => [...fig.querySelectorAll<T>(s)];
		let closed = false;
		let pol = 1; // +1: the coil's field points up in the core (its top end is N)
		let kind: 'al' | 'cut' | 'pl' = 'al';
		let show = false;
		let iC = 0; // the coil's current, parts of its steady value, signed by pol
		let y = 0; // the ring's height above the coil, px
		let v = 0; // px/s, up
		let rate = 0; // d|Φ|/dt of the coil's flux, parts per second (for the ring's current and the force)
		let launch = -1; // time left before the ring leaves the coil
		let hold = 0; // s left to show the ring's current, field and force
		let held = { grow: true, field: 1 };
		const keyBtn = $<HTMLButtonElement>('[data-key-btn]');
		const polBtn = $<HTMLButtonElement>('[data-pol]');
		const note = $<HTMLParagraphElement>('[data-note]');
		const setKey = () => {
			$('[data-key]').setAttribute('d', closed ? 'M80 150 L104 150' : 'M80 150 L100 134');
			keyBtn.textContent = closed ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			polBtn.disabled = closed;
			note.textContent = closed ? 'Полюсы источника меняют при разомкнутом ключе.' : '';
			// the battery: the long plate (+) on top when pol = +1
			$('[data-bat]').setAttribute('d', pol > 0 ? 'M48 176 H72 M54 196 H66' : 'M54 176 H66 M48 196 H72');
			$('[data-batl]').textContent = '';
		};
		keyBtn.addEventListener('click', () => {
			closed = !closed;
			if (closed && kind === 'al' && y === 0) launch = 0.04;
			setKey();
			wake();
		});
		polBtn.addEventListener('click', () => {
			pol = -pol;
			setKey();
			wake();
		});
		$$<HTMLButtonElement>('[data-ring-kind]').forEach((b) =>
			b.addEventListener('click', () => {
				kind = b.dataset.ringKind as typeof kind;
				fig.dataset.kind = kind;
				$$<HTMLButtonElement>('[data-ring-kind]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				wake();
			}),
		);
		$<HTMLInputElement>('[data-show]').addEventListener('change', (e) => {
			show = (e.target as HTMLInputElement).checked;
			wake();
		});
		const ringBack = $<SVGPathElement>('[data-ring-back]');
		const ringFront = $<SVGPathElement>('[data-ring-front]');
		const ringG = $<SVGGElement>('[data-ring]');
		const ringI = $<SVGPathElement>('[data-ring-i]');
		const ringB = $<SVGPathElement>('[data-ring-b]');
		const ringF = $<SVGPathElement>('[data-ring-f]');
		const rpole = $<SVGTextElement>('[data-rpole]');
		const cpole = $<SVGTextElement>('[data-cpole]');
		const bc = $$<SVGPathElement>('[data-bc]');
		const coilI = $$<SVGPathElement>('[data-coil-i] path');
		const draw = () => {
			const cy = TOP - 3 - y; // the ring's center
			const gap = kind === 'cut' ? 0.35 : 0; // the cut: a gap at the front
			const arc = (a0: number, a1: number) => {
				const n = 20;
				let d = '';
				for (let i = 0; i <= n; i++) {
					const a = a0 + ((a1 - a0) * i) / n;
					d += `${i ? 'L' : 'M'}${f1(CX + RX * Math.cos(a))} ${f1(cy + RY * Math.sin(a))}`;
				}
				return d;
			};
			ringBack.setAttribute('d', arc(Math.PI, 2 * Math.PI));
			ringFront.setAttribute('d', gap ? arc(0, Math.PI / 2 - gap / 2) + ' ' + arc(Math.PI / 2 + gap / 2, Math.PI) : arc(0, Math.PI));
			// the coil's field in the core and its current (front of the coil: to the right for pol·iC > 0)
			// after opening, the coil's field and pole are held for the same 0,6 с as the ring's current (as it was
			// while the flux fell), so the attraction of unlike poles can be seen
			const on = Math.abs(iC) > 0.02 || (kind === 'al' && hold > 0);
			const up = Math.abs(iC) > 0.02 ? iC > 0 : held.field > 0;
			bc.forEach((p, i) => {
				const yy = [150, 100][i];
				p.setAttribute('d', on && show ? vflat(CX, up ? yy + 14 : yy - 14, up ? yy - 14 : yy + 14, 3, 8) : '');
			});
			coilI.forEach((p, i) => {
				const yy = TOP + 18 + i * 26;
				p.setAttribute('d', on && show ? arrowHead(CX + (up ? 10 : -10), yy + 3, up ? 1 : -1, 0.12, 9) : '');
			});
			cpole.textContent = on && show ? (up ? 'N' : 'S') : '';
			cpole.setAttribute('class', `tr__pole ${up ? 't-n' : 't-s'}`);
			// the ring's current while the coil's flux changes (solid ring only)
			// (the current lasts about 0,1 с; its arrows are held for 0,6 с so that they can be seen)
			const act = kind === 'al' && hold > 0;
			const grow = held.grow; // |Φ| grew: the ring's field is opposite to the coil's
			const rUp = grow ? held.field < 0 : held.field > 0;
			ringI.setAttribute('d', act && show ? arrowHead(CX + (rUp ? 8 : -8), cy + RY, rUp ? 1 : -1, 0, 8) : '');
			ringB.setAttribute('d', act && show ? vflat(CX + 30, rUp ? cy + 12 : cy - 12, rUp ? cy - 12 : cy + 12, 2.6, 7) : '');
			rpole.setAttribute('y', f1(cy + 1));
			rpole.textContent = act && show ? (rUp ? 'S' : 'N') : '';
			rpole.setAttribute('class', `tr__pole ${rUp ? 't-s' : 't-n'}`);
			// the force on the ring: up while the flux grows, down while it falls (only drawn with the fields)
			ringF.setAttribute('d', act && show ? vflat(CX + 46, grow ? cy + 4 : cy - 22, grow ? cy - 22 : cy + 4, 3, 9) : '');
			void ringG;
		};
		let idle = 0;
		const wake = loop(fig, (dt) => {
			if (dt <= 0) return true;
			const target = closed ? pol : 0;
			const old = iC;
			iC += (target - iC) * (1 - Math.exp(-dt / 0.03));
			if (Math.abs(iC - target) < 1e-4) iC = target;
			rate = (Math.abs(iC) - Math.abs(old)) / dt;
			if (Math.abs(rate) > 0.5) {
				held = { grow: rate > 0, field: Math.sign(iC || old) };
				hold = 0.6;
			} else hold = Math.max(0, hold - dt);
			if (launch >= 0) {
				launch -= dt;
				if (launch < 0) {
					v = V0;
					launch = -1;
				}
			}
			if (y > 0 || v > 0) {
				v -= G * dt;
				y += v * dt;
				if (y <= 0) {
					y = 0;
					v = 0;
				}
			}
			draw();
			idle = y === 0 && v === 0 && launch < 0 && hold === 0 && Math.abs(iC - target) < 1e-4 ? idle + dt : 0;
			return idle < 0.3;
		});
		setKey();
		draw();
	}
</script>
