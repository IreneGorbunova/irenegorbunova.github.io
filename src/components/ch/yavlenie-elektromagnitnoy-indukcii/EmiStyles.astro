---
/**
 * Shared colors of the pictures and models of «Электромагнитная индукция» (grade 9), the same as in «Магнитное поле.
 * Индукция магнитного поля»: N blue, S red, the magnet's field lines gray, current green, the field of the induced
 * current purple (as the vector B there), a force gold, copper from gold and red, iron gray. Renders nothing.
 */
---

<style is:global>
	.emi {
		--emi-cu: color-mix(in srgb, var(--ig-v) 62%, var(--ig-vy));
		--emi-cu-back: color-mix(in srgb, var(--emi-cu) 45%, var(--sl-color-gray-5));
		--emi-i: var(--sl-color-green);
		--emi-b: var(--sl-color-purple); /* the B color of «Магнитное поле. Индукция…»: the accent is gold in the dark theme */
		--emi-f: var(--ig-v);
		--emi-fe: var(--sl-color-gray-4);
		--emi-line: var(--sl-color-gray-2);
	}
	.emi .emi-galv__case {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
	}
	.emi .emi-galv__face {
		fill: color-mix(in srgb, white 88%, var(--ig-v));
	}
	.emi .emi-galv__tick {
		stroke: hsl(222, 20%, 25%);
		stroke-width: 1;
	}
	.emi .emi-galv__num,
	.emi .emi-galv__g {
		fill: hsl(222, 20%, 25%);
		font-family: var(--__sl-font);
	}
	.emi .emi-galv__needle {
		stroke: hsl(222, 30%, 14%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.emi .emi-galv__pivot {
		fill: hsl(222, 30%, 14%);
	}
	.emi .emi-galv__term {
		fill: var(--sl-color-gray-2);
	}
	.emi .emi-cu {
		fill: none;
		stroke: var(--emi-cu);
		stroke-linecap: round;
	}
	.emi .emi-cu.is-back {
		stroke: var(--emi-cu-back);
	}
	.emi .emi-wire {
		fill: none;
		stroke: var(--emi-cu);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.emi .emi-i {
		fill: var(--emi-i);
	}
	.emi .emi-b {
		fill: var(--emi-b);
	}
	.emi .emi-bs {
		stroke: var(--emi-b);
		fill: none;
	}
	.emi .emi-f {
		fill: var(--emi-f);
	}
	.emi .emi-fs {
		stroke: var(--emi-f);
		fill: none;
	}
	.emi .emi-line {
		fill: none;
		stroke: var(--emi-line);
		stroke-width: 0.9;
		opacity: 0.75;
	}
	.emi .emi-line.is-on {
		stroke-width: 1.6;
		opacity: 1;
	}
	.emi .emi-n {
		fill: var(--ig-vx);
	}
	.emi .emi-s {
		fill: var(--ig-vy);
	}
	.emi .emi-pole {
		font-weight: 700;
		fill: var(--sl-color-black);
	}
	.emi .emi-fe {
		fill: var(--emi-fe);
	}
	.emi .t-n {
		fill: var(--ig-vx);
		font-weight: 700;
	}
	.emi .t-s {
		fill: var(--ig-vy);
		font-weight: 700;
	}
	.emi .t-acc {
		fill: var(--emi-b);
	}
</style>
