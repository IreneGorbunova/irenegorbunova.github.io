---
/**
 * «Генератор на столе». Two flat poles of a magnet (N on the left, blue; S on the right, red) make a uniform horizontal
 * field B = 0,2 Тл (gray lines from left to right, a grid of 6 × 4 across the field). A square frame of 50 turns,
 * 10 см × 10 см (S = 0,01 м²), turns about a vertical axis between the poles, driven by a crank on top of the axis.
 * The ends of its winding go to two slip rings on the axis; two graphite brushes press on the rings; from the brushes
 * the wires go through a key to a switch: a small lamp or the galvanometer. Oblique view at 4,5 px per см.
 * Speed 0–2 об/с (step 0,25), real time; a real generator turns about 50 times faster (the caption says the turning
 * is slowed). The angle is 0° when the frame is perpendicular to the lines. The flux through the frame is shown as a
 * positive number Φ = B·S·|cos(угла)|: 2,0 мВб at 0° and 180°, 0 at 90° and 270° (a signed flux is grade 11). The
 * lines that pass through the frame are drawn bolder, and the frame is tinted by the side the lines enter it (teal from
 * one side, violet from the other): the color changes when the frame is along the lines.
 * Current: e = N·B·S·ω·sin(угла) (1,26 В at the peak at 2 об/с); with the lamp (R ≈ 5 Ом) the current is e/R, with the
 * galvanometer (R ≈ 2 кОм) 400 times smaller. The current is zero when the frame is perpendicular to the lines (the
 * flux is then largest) and largest when the frame lies along the lines (the flux is zero); it changes its direction
 * at 0° and 180°, twice per turn: 2 times per second at 1 об/с, 4 at 2 об/с. The galvanometer: 5 divisions at the peak
 * current at 2 об/с, needle period 0,15 с; the strip below records its reading for the last 4 с. The lamp's brightness
 * follows the power, ∝ e² (a filament lag of 0,05 с), so it flickers twice per turn. «Усилие на рукоятке»: the braking
 * torque N·B·S·I·sin(угла), as a bar from 0 to its largest value (lamp, 2 об/с); with the galvanometer or the key open
 * it is almost zero.
 */
import G7Styles from '../g7/G7Styles.astro';
import EmiStyles from './EmiStyles.astro';
---

<G7Styles />
<EmiStyles />
<figure class="g7 g7--stack emi gn not-content" data-generatorlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 300" role="img" aria-label="Рамка из провода вращается между полюсами магнита; её концы через кольца и щётки соединены с лампой или гальванометром; внизу — запись показаний гальванометра">
			<g data-back></g>
			<g data-frame></g>
			<g data-front></g>
			<g data-circuit></g>
			<g data-strip></g>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Скорость вращения</span>
				<output data-vout>1 об/с</output>
				<input type="range" min="0" max="2" step="0.25" value="1" data-v />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-pause>Пауза</button>
				<div class="g7__seg">
					<button type="button" class="g7__btn" aria-pressed="true" data-load="lamp">Лампа</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-load="galv">Гальванометр</button>
				</div>
				<button type="button" class="g7__btn" data-key-btn>Цепь замкнута</button>
			</div>
			<ul class="g7__read">
				<li>Угол поворота рамки <b data-r-ang>0°</b></li>
				<li class="is-key">Поток через рамку <b data-r-phi>2,0 мВб</b></li>
				<li>Оборотов <b data-r-turns>0</b></li>
				<li class="is-warm">Ток сменил направление <b data-r-rev>0 раз</b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Вращение замедлено: генератор электростанции делает 50 оборотов в секунду. Жирнее нарисованы магнитные линии, которые проходят сквозь рамку; цвет рамки показывает, с какой стороны в неё входят линии. Внизу — показания гальванометра за последние 4&nbsp;с.
	</figcaption>
</figure>

<style is:global>
	.gn .gn__pole-n {
		fill: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-gray-5));
	}
	.gn .gn__pole-s {
		fill: color-mix(in srgb, var(--ig-vy) 70%, var(--sl-color-gray-5));
	}
	.gn .gn__frame {
		fill: none;
		stroke: var(--emi-cu);
		stroke-width: 3.2;
		stroke-linejoin: round;
	}
	.gn .gn__frame.is-back {
		stroke: var(--emi-cu-back);
	}
	.gn .gn__face-a {
		fill: color-mix(in srgb, hsl(175, 60%, 45%) 30%, transparent);
	}
	.gn .gn__face-b {
		fill: color-mix(in srgb, hsl(285, 60%, 60%) 30%, transparent);
	}
	.gn .gn__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.gn .gn__ring {
		fill: color-mix(in srgb, var(--emi-cu) 70%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.6;
	}
	.gn .gn__brush {
		fill: hsl(220, 8%, 30%);
	}
	.gn .gn__crank {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.gn .gn__knob {
		fill: color-mix(in srgb, var(--ig-vy) 60%, var(--sl-color-gray-4));
	}
	.gn .gn__bulb {
		fill: color-mix(in srgb, white 10%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.gn .gn__glow {
		fill: hsl(45, 100%, 65%);
	}
	.gn .gn__fil {
		fill: none;
		stroke: hsl(35, 90%, 55%);
		stroke-width: 1.2;
	}
	.gn .gn__sym {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.gn .gn__dot {
		fill: var(--sl-color-gray-1);
	}
	.gn .gn__axisline {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.gn .gn__trace {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.6;
	}
	.gn .gn__bar-bg {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
	}
	.gn .gn__bar {
		fill: var(--emi-f);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { needle, galvanometer, svgEl } from './emi';

	const K = 4.5; // px per см
	const H = 5 * K; // half side of the frame
	const C = { x: 150, y: 104 };
	const P = (x: number, y: number, z: number) => ({ x: C.x + x - 0.42 * z, y: C.y - y + 0.3 * z });
	const f1 = (v: number) => v.toFixed(1);
	const pts = (a: { x: number; y: number }[]) => a.map((p, i) => `${i ? 'L' : 'M'}${f1(p.x)} ${f1(p.y)}`).join(' ');
	const LY = [-1.25, -0.75, -0.25, 0.25, 0.75, 1.25].map((v) => v * H);
	const LZ = [-0.75, -0.25, 0.25, 0.75].map((v) => v * H);
	const B = 0.2;
	const SF = 0.01;
	const N = 50;
	const E_MAX = N * B * SF * 2 * Math.PI * 2; // В, peak EMF at 2 об/с
	const R_LAMP = 5;
	const I_MAX = E_MAX / R_LAMP;
	const STRIP = { x0: 24, x1: 392, y: 262, a: 26, span: 4 };

	for (const fig of document.querySelectorAll<HTMLElement>('[data-generatorlab]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const $$ = <T extends Element>(s: string) => [...fig.querySelectorAll<T>(s)];
		const back = $<SVGGElement>('[data-back]');
		const frameG = $<SVGGElement>('[data-frame]');
		const front = $<SVGGElement>('[data-front]');
		const circ = $<SVGGElement>('[data-circuit]');
		const strip = $<SVGGElement>('[data-strip]');
		// the poles and the field lines
		const block = (x0: number, x1: number) => pts([P(x0, 52, -40), P(x1, 52, -40), P(x1, 52, 40), P(x1, -52, 40), P(x0, -52, 40), P(x0, 52, 40)]) + ' Z';
		const face = (x: number) => pts([P(x, 52, -40), P(x, 52, 40), P(x, -52, 40), P(x, -52, -40)]) + ' Z';
		svgEl(back, 'path', { class: 'gn__pole-n', d: block(-108, -90) });
		svgEl(back, 'path', { class: 'emi-n', d: face(-90), opacity: 0.85 });
		svgEl(back, 'path', { class: 'gn__pole-s', d: block(90, 108) });
		svgEl(back, 'path', { class: 'emi-s', d: face(90), opacity: 0.85 });
		svgEl(back, 'text', { class: 'emi-pole', x: f1(P(-90, -40, 0).x), y: f1(P(-90, -40, 0).y + 5), 'text-anchor': 'middle', 'font-size': 15 }, 'N');
		svgEl(back, 'text', { class: 'emi-pole', x: f1(P(90, -40, 0).x), y: f1(P(90, -40, 0).y + 5), 'text-anchor': 'middle', 'font-size': 15 }, 'S');
		const lines: { el: SVGPathElement; y: number; z: number }[] = [];
		for (const z of LZ)
			for (const y of LY) {
				const a = P(-90, y, z);
				const b = P(90, y, z);
				lines.push({ el: svgEl(back, 'path', { class: 'emi-line', d: `M${f1(a.x)} ${f1(a.y)} L${f1(b.x)} ${f1(b.y)}` }), y, z });
			}
		// the frame: its interior (tint), its back and front halves; the axis, the rings, the brushes, the crank
		const tint = svgEl(frameG, 'path', {});
		const fBack = svgEl(frameG, 'path', { class: 'gn__frame is-back' });
		const axisTop = P(0, H + 26, 0);
		const axisBot = P(0, -H - 34, 0);
		svgEl(frameG, 'path', { class: 'gn__axis', d: `M${f1(axisTop.x)} ${f1(axisTop.y)} L${f1(axisBot.x)} ${f1(axisBot.y)}` });
		const fFront = svgEl(frameG, 'path', { class: 'gn__frame' });
		const ringY = [-H - 14, -H - 25];
		for (const ry of ringY) {
			const c = P(0, ry, 0);
			svgEl(frameG, 'ellipse', { class: 'gn__ring', cx: f1(c.x), cy: f1(c.y), rx: 9, ry: 3.6 });
			svgEl(frameG, 'rect', { class: 'emi-fe', x: f1(c.x - 9), y: f1(c.y), width: 18, height: 3 });
			svgEl(frameG, 'rect', { class: 'gn__brush', x: f1(c.x + 9), y: f1(c.y - 2.5), width: 9, height: 6, rx: 1 });
		}
		const crank = svgEl(frameG, 'path', { class: 'gn__crank' });
		const knob = svgEl(frameG, 'circle', { class: 'gn__knob', r: 3.4 });
		svgEl(front, 'text', { class: 't-small', x: f1(P(0, -H - 14, 0).x - 14), y: f1(P(0, -H - 14, 0).y + 4), 'text-anchor': 'end' }, 'кольца');
		svgEl(front, 'text', { class: 't-small', x: f1(axisTop.x + 26), y: f1(axisTop.y - 2) }, 'рукоятка');
		// the circuit: brushes → key → switch → lamp (top) or galvanometer (bottom), back to the other brush
		const b1 = P(0, ringY[0], 0);
		const b2 = P(0, ringY[1], 0);
		const xr = b1.x + 18;
		// both wires go down under the poles (their lower edge is at y ≈ 168) before they turn right
		const KY = 184;
		svgEl(circ, 'path', { class: 'emi-wire', d: `M${f1(xr)} ${f1(b1.y)} H${f1(xr + 8)} V${KY} H262 M286 ${KY} H300 V88 M${f1(xr)} ${f1(b2.y)} H${f1(xr + 3)} V192 H392 V40 H361 M392 152 H372` });
		// the key on the top wire (262–286)
		const keyL = svgEl(circ, 'path', { class: 'gn__sym' });
		svgEl(circ, 'circle', { class: 'gn__dot', cx: 262, cy: KY, r: 2.2 });
		svgEl(circ, 'circle', { class: 'gn__dot', cx: 286, cy: KY, r: 2.2 });
		svgEl(circ, 'text', { class: 't-small', x: 274, y: KY - 10, 'text-anchor': 'middle' }, 'ключ');
		// the switch at (300, 88): its lever goes up to the lamp (300, 62) or right to the galvanometer (322, 100)
		const sw = svgEl(circ, 'path', { class: 'gn__sym' });
		svgEl(circ, 'circle', { class: 'gn__dot', cx: 300, cy: 88, r: 2.2 });
		svgEl(circ, 'path', { class: 'emi-wire', d: 'M300 60 V48 H338 M318 100 H328 V128' });
		svgEl(circ, 'circle', { class: 'gn__dot', cx: 300, cy: 62, r: 2 });
		svgEl(circ, 'circle', { class: 'gn__dot', cx: 318, cy: 100, r: 2 });
		// the lamp at (350, 40)
		const glow = svgEl(circ, 'circle', { class: 'gn__glow', cx: 350, cy: 40, r: 22, opacity: 0 });
		svgEl(circ, 'circle', { class: 'gn__bulb', cx: 350, cy: 40, r: 11 });
		svgEl(circ, 'path', { class: 'gn__fil', d: 'M344 48 L345 40 Q346.5 36 348 40 Q349.5 36 351 40 Q352.5 36 354 40 L355 48' });
		svgEl(circ, 'text', { class: 't-small', x: 350, y: 70, 'text-anchor': 'middle' }, 'лампа');
		// the galvanometer at (350, 152)
		const gal = galvanometer(svgEl(circ, 'g'), 350, 152, 20);
		svgEl(circ, 'path', { class: 'emi-wire', d: `M328 128 H${f1(gal.terminals[0].x)} V${f1(gal.terminals[0].y)} M${f1(gal.terminals[1].x)} ${f1(gal.terminals[1].y)} V124 H392` });
		// the effort bar
		svgEl(circ, 'text', { class: 't-small', x: 24, y: 204 }, 'усилие на рукоятке');
		svgEl(circ, 'rect', { class: 'gn__bar-bg', x: 24, y: 209, width: 140, height: 8, rx: 3 });
		const bar = svgEl(circ, 'rect', { class: 'gn__bar', x: 24, y: 209, width: 0, height: 8, rx: 3 });
		// the strip of the galvanometer's reading
		svgEl(strip, 'path', { class: 'gn__axisline', d: `M${STRIP.x0} ${STRIP.y} H${STRIP.x1} M${STRIP.x0} ${STRIP.y - STRIP.a} V${STRIP.y + STRIP.a}` });
		svgEl(strip, 'text', { class: 't-small', x: STRIP.x0 + 4, y: STRIP.y - STRIP.a + 2 }, 'показания гальванометра');
		svgEl(strip, 'text', { class: 't-small', x: STRIP.x1, y: STRIP.y + STRIP.a + 8, 'text-anchor': 'end' }, 'сейчас');
		svgEl(strip, 'text', { class: 't-small', x: STRIP.x0, y: STRIP.y + STRIP.a + 8 }, '4 с назад');
		const trace = svgEl(strip, 'path', { class: 'gn__trace' });

		// state
		let speed = 1; // об/с
		let paused = false;
		let closed = true;
		let load: 'lamp' | 'galv' = 'lamp';
		let ang = 0; // rad
		let turns = 0;
		let revs = 0;
		let lastSign = 0;
		let bright = 0;
		let time = 0;
		const nd = needle(0.15, 0.7);
		const hist: { t: number; v: number }[] = [];
		const rAng = $('[data-r-ang]');
		const rPhi = $('[data-r-phi]');
		const rTurns = $('[data-r-turns]');
		const rRev = $('[data-r-rev]');
		const vIn = $<HTMLInputElement>('[data-v]');
		const vOut = $<HTMLOutputElement>('[data-vout]');
		const keyBtn = $<HTMLButtonElement>('[data-key-btn]');
		const pauseBtn = $<HTMLButtonElement>('[data-pause]');
		const fmt = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
		const reset = () => {
			turns = 0;
			revs = 0;
			lastSign = 0;
		};
		vIn.addEventListener('input', () => {
			speed = +vIn.value;
			vOut.textContent = `${fmt(speed, 2).replace(/,?0+$/, '')} об/с`;
			reset();
			wake();
		});
		pauseBtn.addEventListener('click', () => {
			paused = !paused;
			pauseBtn.textContent = paused ? 'Дальше' : 'Пауза';
			pauseBtn.setAttribute('aria-pressed', String(paused));
			wake();
		});
		keyBtn.addEventListener('click', () => {
			closed = !closed;
			keyBtn.textContent = closed ? 'Цепь замкнута' : 'Цепь разомкнута';
			reset();
			wake();
		});
		$$<HTMLButtonElement>('[data-load]').forEach((b) =>
			b.addEventListener('click', () => {
				load = b.dataset.load as typeof load;
				$$<HTMLButtonElement>('[data-load]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				reset();
				wake();
			}),
		);

		const draw = (dt: number) => {
			const c = Math.cos(ang);
			const s = Math.sin(ang);
			// the frame: points (u·sin, y, u·cos), u = ±H; its front half has z > 0
			const Q = (u: number, y: number) => P(u * s, y, u * c);
			const corners = [Q(H, H), Q(H, -H), Q(-H, -H), Q(-H, H)];
			tint.setAttribute('d', pts(corners) + ' Z');
			// lines go to +x; face A has the outward normal (cos, 0, −sin): the lines enter it when cos < 0
			tint.setAttribute('class', c < 0 ? 'gn__face-a' : 'gn__face-b');
			tint.style.opacity = Math.abs(c) < 0.02 ? '0' : '1';
			const nearIsPlus = c > 0; // the side u > 0 is nearer the viewer when cos > 0
			const half = (sg: number) => pts([Q(0, -H), Q(sg * H, -H), Q(sg * H, H), Q(0, H)]);
			fFront.setAttribute('d', half(nearIsPlus ? 1 : -1));
			fBack.setAttribute('d', half(nearIsPlus ? -1 : 1));
			for (const l of lines) l.el.classList.toggle('is-on', Math.abs(l.y) < H && Math.abs(l.z) < H * Math.abs(c) - 1e-6);
			// the crank on top: an arm of 4 см along the frame's u direction, a knob at its end
			const k0 = P(0, H + 26, 0);
			const k1 = P(4 * K * s, H + 26, 4 * K * c);
			crank.setAttribute('d', `M${f1(k0.x)} ${f1(k0.y)} L${f1(k1.x)} ${f1(k1.y)} L${f1(k1.x)} ${f1(k1.y - 7)}`);
			knob.setAttribute('cx', f1(k1.x));
			knob.setAttribute('cy', f1(k1.y - 8));
			// EMF and current
			const w = 2 * Math.PI * speed;
			const e = N * B * SF * w * s;
			const I = closed ? (load === 'lamp' ? e / R_LAMP : e / 2000) : 0;
			// galvanometer: 5 divisions at the peak current at 2 об/с through it
			const div = load === 'galv' && closed ? (5 * e) / E_MAX : 0;
			gal.set(nd.step(div, dt));
			// lamp: brightness ∝ power, filament lag 0,05 s
			const pw = load === 'lamp' && closed ? (I / I_MAX) ** 2 : 0;
			bright += (pw - bright) * (dt > 0 ? 1 - Math.exp(-dt / 0.05) : 1);
			glow.setAttribute('opacity', Math.min(1, 1.2 * bright).toFixed(2));
			// the effort: torque ∝ I·sin
			bar.setAttribute('width', f1(140 * Math.min(1, Math.abs((I / I_MAX) * s))));
			// the switch lever and the key
			sw.setAttribute('d', load === 'lamp' ? 'M300 88 L300 64' : 'M300 88 L316 99');
			keyL.setAttribute('d', closed ? `M262 ${KY} L286 ${KY}` : `M262 ${KY} L282 ${KY - 12}`);
			// readouts
			const deg = (((ang * 180) / Math.PI) % 360 + 360) % 360;
			rAng.textContent = `${Math.round(deg) % 360}°`;
			rPhi.textContent = `${fmt(B * SF * Math.abs(c) * 1000, 1)} мВб`;
			rTurns.textContent = String(turns);
			rRev.textContent = `${revs} ${revs % 10 >= 2 && revs % 10 <= 4 && (revs % 100 < 10 || revs % 100 >= 20) ? 'раза' : 'раз'}`;
			// the strip
			if (dt > 0) hist.push({ t: time, v: nd.value });
			while (hist.length && hist[0].t < time - STRIP.span) hist.shift();
			trace.setAttribute(
				'd',
				hist
					.map((h, i) => {
						const x = STRIP.x1 - ((time - h.t) / STRIP.span) * (STRIP.x1 - STRIP.x0);
						return `${i ? 'L' : 'M'}${f1(x)} ${f1(STRIP.y - (h.v / 5.5) * STRIP.a)}`;
					})
					.join(' '),
			);
			return I;
		};
		draw(0);
		const wake = loop(fig, (dt) => {
			if (dt <= 0) return true;
			if (!paused) {
				time += dt;
				const prev = ang;
				ang += 2 * Math.PI * speed * dt;
				if (Math.floor(ang / (2 * Math.PI)) > Math.floor(prev / (2 * Math.PI))) turns++;
			}
			const I = draw(paused ? 0 : dt);
			// a change of direction is counted only while a current flows in a closed circuit
			const sg = Math.sign(Math.sin(ang));
			if (!paused && closed && speed > 0 && sg !== 0) {
				if (lastSign !== 0 && sg !== lastSign) revs++;
				lastSign = sg;
			}
			void I;
			return true;
		});
	}
</script>
