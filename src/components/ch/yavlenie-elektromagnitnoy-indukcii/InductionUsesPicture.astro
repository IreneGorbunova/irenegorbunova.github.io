---
/**
 * «Где это встречается»: four small looping schemes (2 × 2, one column on a phone). No numbers.
 *   Электростанция: water runs down a pipe and turns a turbine wheel; its shaft turns the rotor of the generator (front
 *     view: four electromagnet poles N/S turning inside a ring of stator coils); a current goes along the line to the
 *     houses (the windows light). The rotor is drawn turning slowly (a real one makes 50 turns a second or fewer with
 *     more poles).
 *   Микрофон: sound waves (arcs) push a membrane; a light coil glued to it moves in the narrow gap of a magnet (section:
 *     N blue in the middle, S red around); the current in the wires copies the sound (a trace of the same shape).
 *   Петля под дорогой: top view of a crossing; a rectangle of wire laid in a cut in the asphalt before the stop line;
 *     a car drives in and stops over it, the box at the roadside notices the metal (its lamp lights), and after a while
 *     the traffic light turns green and the car drives on. Loop of 9 с.
 *   Торможение электропоезда: a train brakes under the contact wire; its motors work as generators, and green arrows
 *     show the current going back up the pantograph into the wire; the train slows from its speed to a stop in 5 с.
 * Current green, magnets N blue / S red, copper from gold and red.
 */
import G7Styles from '../g7/G7Styles.astro';
import EmiStyles from './EmiStyles.astro';

const TILES = [
	{ k: 'plant', t: 'Электростанция' },
	{ k: 'mic', t: 'Микрофон' },
	{ k: 'loop', t: 'Петля под дорогой' },
	{ k: 'train', t: 'Торможение электропоезда' },
];
---

<G7Styles />
<EmiStyles />
<figure class="g7 g7--pic emi iu not-content" data-inductionuses>
	<div class="g7__grid is-two">
		{
			TILES.map((x) => (
				<div class="iu__tile">
					<svg class="g7__svg" viewBox="0 0 200 140" role="img" aria-label={x.t} data-tile={x.k} />
					<p class="iu__t">{x.t}</p>
				</div>
			))
		}
	</div>
</figure>

<style is:global>
	.iu__tile {
		display: grid;
		gap: 0.3rem;
	}
	.iu__t {
		margin: 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.iu .iu__water {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-gray-3));
		stroke-width: 7;
		stroke-dasharray: 6 5;
	}
	.iu .iu__pipe {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 11;
	}
	.iu .iu__dam {
		fill: var(--sl-color-gray-5);
	}
	.iu .iu__lake {
		fill: color-mix(in srgb, var(--ig-vx) 45%, var(--sl-color-gray-5));
	}
	.iu .iu__steel {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.iu .iu__blade {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.iu .iu__shaft {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.iu .iu__house {
		fill: var(--sl-color-gray-5);
	}
	.iu .iu__win {
		fill: hsl(45, 100%, 65%);
	}
	.iu .iu__mem {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.iu .iu__wave {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.iu .iu__trace {
		fill: none;
		stroke: var(--emi-i);
		stroke-width: 1.6;
	}
	.iu .iu__asphalt {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 80%, var(--sl-color-gray-4));
	}
	.iu .iu__mark {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.iu .iu__cut {
		fill: none;
		stroke: var(--emi-cu);
		stroke-width: 1.6;
		stroke-dasharray: 3 2;
	}
	.iu .iu__car {
		fill: color-mix(in srgb, var(--ig-vy) 60%, var(--sl-color-gray-4));
	}
	.iu .iu__glass {
		fill: color-mix(in srgb, var(--ig-vx) 30%, var(--sl-color-gray-6));
	}
	.iu .iu__tl {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
	}
	.iu .iu__off {
		fill: var(--sl-color-gray-5);
	}
	.iu .iu__red {
		fill: hsl(0, 85%, 58%);
	}
	.iu .iu__green {
		fill: hsl(140, 70%, 50%);
	}
	.iu .iu__train {
		fill: color-mix(in srgb, hsl(150, 50%, 45%) 70%, var(--sl-color-gray-4));
	}
	.iu .iu__wire {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.iu .iu__rail {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.iu .iu__panto {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.iu .iu__tyre {
		fill: hsl(220, 10%, 20%);
		stroke: var(--sl-color-gray-3);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { svgEl, arrowHead } from './emi';

	const f1 = (v: number) => v.toFixed(1);

	for (const fig of document.querySelectorAll<HTMLElement>('[data-inductionuses]')) {
		const steps: ((t: number) => void)[] = [];
		for (const svg of fig.querySelectorAll<SVGSVGElement>('[data-tile]')) {
			const k = svg.dataset.tile;
			if (k === 'plant') {
				// dam and lake, the pipe, the turbine wheel (side view), the shaft, the generator (front view), the line
				svgEl(svg, 'path', { class: 'iu__lake', d: 'M0 30 H34 L34 120 H0 Z' });
				svgEl(svg, 'path', { class: 'iu__dam', d: 'M30 24 H44 L58 124 H30 Z' });
				svgEl(svg, 'path', { class: 'iu__pipe', d: 'M30 60 Q50 64 56 96' });
				const water = svgEl(svg, 'path', { class: 'iu__water', d: 'M30 60 Q50 64 56 96' });
				const wheel = svgEl(svg, 'g', {});
				svgEl(wheel, 'circle', { class: 'iu__steel', r: 13 });
				for (let i = 0; i < 8; i++) {
					const a = (i * Math.PI) / 4;
					svgEl(wheel, 'path', { class: 'iu__blade', d: `M${f1(4 * Math.cos(a))} ${f1(4 * Math.sin(a))} L${f1(12 * Math.cos(a + 0.3))} ${f1(12 * Math.sin(a + 0.3))}` });
				}
				svgEl(svg, 'path', { class: 'iu__shaft', d: 'M62 104 H100' });
				// generator: stator ring with 6 coils, rotor with 4 poles
				svgEl(svg, 'circle', { class: 'iu__steel', cx: 122, cy: 80, r: 30 });
				svgEl(svg, 'circle', { class: 'emi-fe', cx: 122, cy: 80, r: 22, opacity: 0.6 });
				for (let i = 0; i < 6; i++) {
					const a = (i * Math.PI) / 3;
					svgEl(svg, 'rect', { class: 'emi-cu', x: -4, y: -27, width: 8, height: 8, rx: 1.5, transform: `translate(122 80) rotate(${(a * 180) / Math.PI})`, style: 'fill: var(--emi-cu); stroke: none' });
				}
				const rotor = svgEl(svg, 'g', {});
				for (let i = 0; i < 4; i++) svgEl(rotor, 'rect', { class: i % 2 ? 'emi-s' : 'emi-n', x: -4, y: -18, width: 8, height: 12, rx: 1.5, transform: `rotate(${i * 90})` });
				svgEl(rotor, 'circle', { class: 'iu__steel', r: 6 });
				svgEl(svg, 'path', { class: 'emi-wire', d: 'M140 56 L160 30 H196' });
				const cur = [svgEl(svg, 'path', { class: 'emi-i' }), svgEl(svg, 'path', { class: 'emi-i' })];
				svgEl(svg, 'rect', { class: 'iu__house', x: 166, y: 96, width: 28, height: 28 });
				svgEl(svg, 'path', { class: 'iu__house', d: 'M162 98 L180 82 L198 98 Z' });
				svgEl(svg, 'rect', { class: 'iu__win', x: 171, y: 104, width: 7, height: 7 });
				svgEl(svg, 'rect', { class: 'iu__win', x: 183, y: 104, width: 7, height: 7 });
				svgEl(svg, 'path', { class: 'emi-wire', d: 'M196 30 V96' });
				steps.push((t) => {
					water.setAttribute('stroke-dashoffset', f1(-t * 30));
					wheel.setAttribute('transform', `translate(62 104) rotate(${f1(t * 140)})`);
					rotor.setAttribute('transform', `translate(122 80) rotate(${f1(t * 140)})`);
					const x = 166 + ((t * 30) % 26);
					cur[0].setAttribute('d', arrowHead(x, 30, 1, 0, 6));
					cur[1].setAttribute('d', arrowHead(196, 50 + ((t * 30) % 30), 0, 1, 6));
				});
			} else if (k === 'mic') {
				// sound arcs from the left, the membrane, the coil in the magnet's gap (section), the wires and the trace
				const arcs = [0, 1, 2].map(() => svgEl(svg, 'path', { class: 'iu__wave' }));
				const mem = svgEl(svg, 'path', { class: 'iu__mem' });
				// the magnet: S around (two red blocks), N in the middle (blue)
				svgEl(svg, 'rect', { class: 'emi-s', x: 92, y: 34, width: 30, height: 14 });
				svgEl(svg, 'rect', { class: 'emi-s', x: 92, y: 92, width: 30, height: 14 });
				svgEl(svg, 'rect', { class: 'emi-s', x: 116, y: 34, width: 8, height: 72 });
				svgEl(svg, 'rect', { class: 'emi-n', x: 98, y: 56, width: 26, height: 28 });
				const coil = svgEl(svg, 'g', {});
				for (const y of [50, 52.5, 87.5, 90]) svgEl(coil, 'rect', { x: 0, y: y - 1.2, width: 12, height: 2.4, style: 'fill: var(--emi-cu)' });
				svgEl(svg, 'path', { class: 'emi-wire', d: 'M108 51 C130 20 150 20 152 34 M108 89 C130 120 150 120 152 106' });
				svgEl(svg, 'rect', { class: 'iu__steel', x: 140, y: 34, width: 56, height: 72, rx: 4 });
				const tr = svgEl(svg, 'path', { class: 'iu__trace' });
				const hist: number[] = [];
				let last = -1;
				const sound = (t: number) => 0.6 * Math.sin(2 * Math.PI * 1.1 * t) + 0.4 * Math.sin(2 * Math.PI * 2.7 * t + 1);
				steps.push((t) => {
					const s = sound(t);
					const dx = 4 * s;
					mem.setAttribute('d', `M${f1(70 + dx)} 30 Q${f1(80 + 2 * dx)} 70 ${f1(70 + dx)} 110 L${f1(96 + dx)} 70 Z`);
					coil.setAttribute('transform', `translate(${f1(94 + dx)} 0)`);
					arcs.forEach((a, i) => {
						const r = 10 + (((t * 24 + i * 18) % 54));
						a.setAttribute('d', `M${f1(10 + r * 0.5)} ${f1(70 - r)} Q${f1(10 + r * 1.1)} 70 ${f1(10 + r * 0.5)} ${f1(70 + r)}`);
						a.style.opacity = f1(Math.max(0, 1 - r / 64));
					});
					if (t - last > 0.03 || t < last) {
						hist.push(s);
						if (hist.length > 48) hist.shift();
						last = t;
					}
					tr.setAttribute('d', hist.map((v, i) => `${i ? 'L' : 'M'}${f1(146 + i)} ${f1(70 - 26 * v)}`).join(' '));
				});
			} else if (k === 'loop') {
				// top view: a road going up, the stop line, the loop cut in the asphalt, a box with a lamp, a traffic light
				svgEl(svg, 'rect', { class: 'iu__asphalt', x: 40, y: 0, width: 110, height: 140 });
				svgEl(svg, 'path', { class: 'iu__mark', d: 'M95 0 V140', 'stroke-dasharray': '8 8' });
				svgEl(svg, 'path', { class: 'iu__mark', d: 'M95 40 H150', 'stroke-width': 3 });
				svgEl(svg, 'rect', { class: 'iu__cut', x: 104, y: 46, width: 38, height: 44 });
				svgEl(svg, 'path', { class: 'iu__cut', d: 'M142 68 H164' });
				svgEl(svg, 'rect', { class: 'iu__tl', x: 164, y: 60, width: 22, height: 16, rx: 3 });
				const det = svgEl(svg, 'circle', { class: 'iu__off', cx: 175, cy: 68, r: 4 });
				svgEl(svg, 'rect', { class: 'iu__tl', x: 160, y: 14, width: 14, height: 34, rx: 3 });
				const red = svgEl(svg, 'circle', { class: 'iu__red', cx: 167, cy: 22, r: 4.5 });
				const green = svgEl(svg, 'circle', { class: 'iu__off', cx: 167, cy: 40, r: 4.5 });
				const car = svgEl(svg, 'g', {});
				svgEl(car, 'rect', { class: 'iu__car', x: -11, y: -21, width: 22, height: 42, rx: 6 });
				svgEl(car, 'rect', { class: 'iu__glass', x: -8, y: -14, width: 16, height: 9, rx: 2 });
				svgEl(car, 'rect', { class: 'iu__glass', x: -8, y: 8, width: 16, height: 6, rx: 2 });
				// the car drives up: 0–2 s in, rests over the loop 2–5 s (detector lit from 2 s, green from 3,5 s), leaves 5–7 s
				steps.push((t) => {
					const T = t % 9;
					const e = (x: number) => x * x * (3 - 2 * x);
					const y = T < 2 ? 170 - 102 * e(T / 2) : T < 5 ? 68 : T < 7 ? 68 - 140 * ((T - 5) / 2) ** 2 : -100;
					car.setAttribute('transform', `translate(123 ${f1(y)})`);
					const over = y > 30 && y < 106;
					det.setAttribute('class', over ? 'iu__green' : 'iu__off');
					const go = T >= 3.5 && T < 7.5;
					red.setAttribute('class', go ? 'iu__off' : 'iu__red');
					green.setAttribute('class', go ? 'iu__green' : 'iu__off');
				});
			} else {
				// a train braking under the wire; the pantograph sends the current back into the wire
				svgEl(svg, 'path', { class: 'iu__wire', d: 'M0 20 H200' });
				svgEl(svg, 'path', { class: 'iu__rail', d: 'M0 122 H200' });
				const tr = svgEl(svg, 'g', {});
				svgEl(tr, 'path', { class: 'iu__panto', d: 'M50 64 L62 44 L52 20 M72 64 L62 44 L72 20 M46 20 H78' });
				svgEl(tr, 'rect', { class: 'iu__train', x: 0, y: 64, width: 130, height: 48, rx: 8 });
				for (let i = 0; i < 5; i++) svgEl(tr, 'rect', { class: 'iu__glass', x: 12 + i * 22, y: 74, width: 14, height: 14, rx: 2 });
				const wheels = [20, 44, 86, 110].map((x) => {
					const w = svgEl(tr, 'g', {});
					svgEl(w, 'circle', { class: 'iu__tyre', r: 8 });
					svgEl(w, 'path', { class: 'iu__blade', d: 'M-6 0 H6', 'stroke-width': 1.4 });
					return { w, x };
				});
				const up = [svgEl(svg, 'path', { class: 'emi-i' }), svgEl(svg, 'path', { class: 'emi-i' }), svgEl(svg, 'path', { class: 'emi-i' })];
				// 6 s loop: brakes from 6 м/с to a stop in 5 s (in px: 30 px/s → 0), then 1 s still; restarts off the left edge
				steps.push((t) => {
					const T = t % 6;
					const v0 = 30;
					const tb = Math.min(T, 5);
					const x = -40 + v0 * tb - (v0 / 10) * tb * tb;
					tr.setAttribute('transform', `translate(${f1(x)} 0)`);
					const v = T < 5 ? v0 * (1 - T / 5) : 0;
					wheels.forEach(({ w, x: wx }) => w.setAttribute('transform', `translate(${wx} 116) rotate(${f1(((x / 8) * 180) / Math.PI)})`));
					const k = v / v0;
					const px = x + 62;
					up[0].setAttribute('d', arrowHead(px + 6, 34 - ((t * 20) % 12), 0, -1, 6));
					up[1].setAttribute('d', arrowHead(px + 30 + ((t * 20) % 20), 20, 1, 0, 6));
					up[2].setAttribute('d', arrowHead(px - 26 - ((t * 20) % 20), 20, -1, 0, 6));
					up.forEach((a) => (a.style.opacity = k > 0.05 ? (0.3 + 0.7 * k).toFixed(2) : '0'));
				});
			}
		}
		let t = 0;
		steps.forEach((s) => s(0));
		loop(fig, (dt) => {
			t += dt;
			steps.forEach((s) => s(t));
			return true;
		})();
	}
</script>
