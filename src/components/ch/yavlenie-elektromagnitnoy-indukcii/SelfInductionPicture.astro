---
/**
 * «Вспышка при размыкании». A circuit: a battery 4,5 В, a key, a coil with an iron core (about 3600 turns, L ≈ 10 Гн,
 * R ≈ 50 Ом) and a small neon lamp joined in parallel to the coil; the neon lights only above about 80 В. A button
 * closes and opens the key; below, a graph of the current in the coil over the last 1,5 с.
 * Closing: the current grows smoothly to I = 4,5 В / 50 Ом = 90 мА with the time constant τ = L/R = 0,2 с (about 1 с
 * to the end); the green arrows grow; the neon stays dark (4,5 В is too little).
 * Opening: the coil's current cannot stop at once; it goes on round the loop coil → neon and the neon flashes orange.
 * The real flash lasts about 10 мс (L·I/U ≈ 10·0,09/80 ≈ 11 мс): the graph shows it at the real time (a nearly
 * vertical fall), while the flash and the arrows round the loop are drawn slowed to 0,5 с (the caption says so).
 */
import G7Styles from '../g7/G7Styles.astro';
import EmiStyles from './EmiStyles.astro';

const coilY = Array.from({ length: 9 }, (_, k) => 62 + k * 6.6);
const GX0 = 56;
const GX1 = 384;
const GY0 = 252;
const GY1 = 176; // 100 мА
---

<G7Styles />
<EmiStyles />
<figure class="g7 g7--stack emi si not-content" data-selfind>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 270" role="img" aria-label="Цепь: батарейка, ключ, катушка с железным сердечником и неоновая лампочка, подключённая параллельно катушке; внизу график силы тока в катушке">
			<path class="emi-wire" d="M40 76 V40 H112 M136 40 H360 V78 M360 104 V140 H40 V96 M290 40 V54 M290 128 V140"></path>
			<path class="si__bat" d="M28 76 H52 M34 96 H46"></path>
			<text class="t-small" x="58" y="92">4,5 В</text>
			<circle class="si__kp" cx="112" cy="40" r="2.4"></circle>
			<circle class="si__kp" cx="136" cy="40" r="2.4"></circle>
			<path class="si__key" data-key d="M112 40 L132 26"></path>
			<text class="t-small" x="124" y="58" text-anchor="middle">ключ</text>
			<!-- the coil with its core -->
			<rect class="emi-fe" x="283" y="52" width="14" height="80" rx="2"></rect>
			{coilY.map((y) => <path class="emi-cu" stroke-width="3" d={`M278 ${y} Q290 ${y + 4} 302 ${y}`} />)}
			<text class="t-small" x="270" y="96" text-anchor="end">катушка</text>
			<!-- the neon lamp -->
			<circle class="si__glow" data-glow cx="360" cy="91" r="22" opacity="0"></circle>
			<ellipse class="si__neon" cx="360" cy="91" rx="8" ry="13"></ellipse>
			<path class="si__el" d="M357 80 V90 M363 102 V92"></path>
			<text class="t-small" x="376" y="28" text-anchor="end">неоновая лампочка</text>
			<g data-arrows></g>
			<!-- the graph -->
			<path class="si__axis" d={`M${GX0} ${GY0} H${GX1} M${GX0} ${GY0} V${GY1 - 10}`}></path>
			<path class="si__grid" d={`M${GX0} ${(GY0 + GY1) / 2} H${GX1} M${GX0} ${GY1} H${GX1}`}></path>
			<text class="t-small" x={GX0 - 4} y={GY0 + 4} text-anchor="end">0</text>
			<text class="t-small" x={GX0 - 4} y={(GY0 + GY1) / 2 + 4} text-anchor="end">50</text>
			<text class="t-small" x={GX0 - 4} y={GY1 + 4} text-anchor="end">100</text>
			<text class="t-small" x={GX0 + 6} y={GY1 - 4}><tspan class="t-i">I</tspan>, мА</text>
			<text class="t-small" x={GX1} y={GY0 + 14} text-anchor="end">сейчас</text>
			<text class="t-small" x={GX0} y={GY0 + 14}>1,5 с назад</text>
			<path class="si__trace" data-trace d=""></path>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-key-btn>Замкнуть ключ</button>
				<span class="g7__label" data-read>Ток в катушке: 0 мА</span>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">Катушка: около 3600 витков на железном сердечнике. Ток нарастает и падает в настоящем времени; вспышка лампочки длится около 0,01&nbsp;с — на рисунке она растянута до 0,5&nbsp;с.</figcaption>
</figure>

<style is:global>
	.si__bat {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2.4;
	}
	.si__key {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.si__kp {
		fill: var(--sl-color-gray-1);
	}
	.si__neon {
		fill: color-mix(in srgb, white 12%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.si__el {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.si__glow {
		fill: hsl(22, 100%, 58%);
	}
	.si__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		fill: none;
	}
	.si__grid {
		stroke: var(--sl-color-gray-5);
		stroke-dasharray: 3 3;
	}
	.si__trace {
		fill: none;
		stroke: var(--emi-i);
		stroke-width: 2;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { arrowHead, svgEl } from './emi';

	const I0 = 4.5 / 50; // А
	const TAU = 10 / 50; // с
	const T_FALL = (10 * I0) / 80; // с, the real fall through the neon (≈ 11 мс)
	const SHOW = 0.5; // с, the flash drawn slowed
	const GX0 = 56;
	const GX1 = 384;
	const GY0 = 252;
	const GY1 = 176;
	const f1 = (v: number) => v.toFixed(1);

	for (const fig of document.querySelectorAll<HTMLElement>('[data-selfind]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const ag = $<SVGGElement>('[data-arrows]');
		// arrows: the main loop (battery → key → coil → back) and the coil–neon loop
		const A = (x: number, y: number, dx: number, dy: number) => ({ el: svgEl(ag, 'path', { class: 'emi-i' }), x, y, dx, dy });
		const main = [A(200, 40, 1, 0), A(40, 120, 0, -1), A(200, 140, -1, 0), A(290, 112, 0, 1)];
		const loopN = [A(325, 140, 1, 0), A(360, 120, 0, -1), A(325, 40, -1, 0), A(290, 112, 0, 1)];
		const glow = $<SVGCircleElement>('[data-glow]');
		const trace = $<SVGPathElement>('[data-trace]');
		const read = $('[data-read]');
		const btn = $<HTMLButtonElement>('[data-key-btn]');
		let closed = false;
		let I = 0;
		let flash = 0; // s left of the slowed flash
		let tOpen = -1; // s since the key was opened (for the real fall)
		let Iopen = 0;
		let time = 0;
		const hist: { t: number; v: number }[] = [];
		btn.addEventListener('click', () => {
			closed = !closed;
			btn.textContent = closed ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			$('[data-key]').setAttribute('d', closed ? 'M112 40 L136 40' : 'M112 40 L132 26');
			if (!closed && I > 0.002) {
				tOpen = 0;
				Iopen = I;
				flash = SHOW;
			}
			wake();
		});
		const draw = () => {
			const k = Math.min(1, I / I0);
			for (const a of main) {
				a.el.setAttribute('d', arrowHead(a.x + a.dx * 4, a.y + a.dy * 4, a.dx, a.dy, 8));
				a.el.style.opacity = closed && I > 0.002 ? (0.3 + 0.7 * k).toFixed(2) : '0';
			}
			const kf = flash / SHOW;
			for (const a of loopN) {
				a.el.setAttribute('d', arrowHead(a.x + a.dx * 4, a.y + a.dy * 4, a.dx, a.dy, 8));
				a.el.style.opacity = !closed && flash > 0 ? (0.3 + 0.7 * kf).toFixed(2) : '0';
			}
			glow.setAttribute('opacity', (flash > 0 ? 0.25 + 0.75 * kf : 0).toFixed(2));
			read.textContent = `Ток в катушке: ${Math.round(I * 1000)} мА`;
			const span = 1.5;
			trace.setAttribute(
				'd',
				hist.map((h, i) => `${i ? 'L' : 'M'}${f1(GX1 - ((time - h.t) / span) * (GX1 - GX0))} ${f1(GY0 - (h.v / 0.1) * (GY0 - GY1))}`).join(' '),
			);
		};
		const wake = loop(fig, (dt) => {
			if (dt <= 0) return true;
			// substeps of 1 мс, so the 11 мс fall is resolved on the graph
			const n = Math.ceil(dt / 0.001);
			for (let i = 0; i < n; i++) {
				const h = dt / n;
				time += h;
				if (closed) I += (I0 - I) * (1 - Math.exp(-h / TAU));
				else if (tOpen >= 0) {
					tOpen += h;
					I = Math.max(0, Iopen * (1 - tOpen / T_FALL));
					if (I === 0) tOpen = -1;
				}
				if (tOpen >= 0 || Math.round(time * 1000) % 5 === 0) hist.push({ t: time, v: I });
			}
			while (hist.length && hist[0].t < time - 1.5) hist.shift();
			flash = Math.max(0, flash - dt);
			draw();
			return true;
		});
		draw();
	}
</script>
