---
/**
 * Two short looping opening scenes of «Ядерные реакции. Атомная энергетика». No terms of the chapter in the pictures
 * or the visible captions; the captions' popovers explain and link to the sections. People: the people kit, in profile.
 *
 * Ice («Ледокол во льдах»): an icebreaker in two-meter ice on a polar day, seen from the side; the view follows the
 *   ship, so the ice drifts back past it. Perspective: the eye 8 м above the ice, 40 м from the ship's side; the ship's
 *   plane is drawn at 20 px per м (the freeboard at the bow 7,5 м = 150 px, the passengers 1,75 and 1,65 м = 35 and
 *   33 px; at this size the kit draws their hands as mittens, and they wear mittens anyway). A point of the ice at
 *   distance d (м) lies 6400/d px below the horizon and drifts back at 14·40/d px/с: the ship goes 0,7 м/с (1,4 узла,
 *   a usual speed in thick ice). The ice is 2 м thick: the slabs that break off at the bow and slide along the hull
 *   are as thick as a person is tall; they turn and show their blue-green edge. Cracks run ahead of the bow before a
 *   slab breaks off (one slab about every 3 м, every 4,3 с). No smoke: a nuclear icebreaker burns no fuel.
 *   A polar bear (2,4 м long) stands on a floe 150 м from the camera (5,3 px per м): it sniffs the ice, raises its head
 *   at the camera's flash and walks away at 0,8 м/с. Passenger A points at it (0,9-s reach, the arm straight at the
 *   bear); passenger B raises the phone with both hands (0,9 s), takes two photos (the screen flashes) and lowers it.
 *   Real time, 14 с.
 * Flight («Полёт над облаками»): a cabin of a passenger plane seen from the aisle, drawn in cabin units of 0,9 px per см
 *   and enlarged 1,32 times (1,19 px per см on screen; the parent 175 см in the aisle seat, the teen 160 см in the window
 *   seat half a meter farther, at 0,86·1,32 px per см): the teen's hands are 19 px long, so the kit draws fingers.
 *   The parent reads a book held in both hands; the teen rests one hand on the armrest and one on the window frame,
 *   looks out, then points at the screen on the seat in front (0,8-s reach); the parent looks up at it; both return
 *   to the first pose. The screen is shown enlarged in an inset (top right, its texts 12 px): the route Москва → Владивосток, the plane icon,
 *   «Высота 11 000 м» and the time in flight. The clock is sped up: 2 ч 10 мин → 8 ч 00 мин of the flight in the 12 с
 *   of the loop (the inset shows the flight time; the plane icon goes along the route in proportion). Outside the
 *   window the clouds below drift back; the day turns to sunset (the window glows orange) and to night (stars, the
 *   cabin dims and a reading light comes on above the parent).
 * Plays only while visible (scene() from intro/scene.ts).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const HOR = 48; // the horizon of the ice scene
const yAt = (d: number) => HOR + 6400 / d;
// distant pressure ridges (distance м, x, length px)
const RIDGES = [
	[70, 20, 60],
	[90, 150, 40],
	[110, 260, 50],
	[140, 60, 36],
	[180, 200, 30],
	[230, 320, 26],
	[300, 110, 22],
	[400, 250, 18],
	[60, 330, 50],
	[200, 30, 24],
].map(([d, x, l]) => ({ d, x, l, y: +yAt(d).toFixed(1) }));
// stars of the night sky in the window
const STARS = [
	[234, 85],
	[242, 89],
	[249, 83],
	[255, 91],
	[238, 94],
	[252, 96],
];
---

<PeopleStyles />
<IntroFrame data-yrintro>
	<div class="intro__card" data-scene="ice">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Полярный день. Большой красный ледокол медленно идёт сквозь сплошной лёд. Нос корабля наползает на лёд, впереди бегут трещины, толстые льдины откалываются, поворачиваются и показывают голубовато-зелёный край. Над ледоколом нет дыма. На носу двое пассажиров в тёплых куртках: один показывает рукой на белого медведя на далёкой льдине, другой фотографирует его телефоном. Медведь поднимает голову и неторопливо уходит">
			<defs>
				<linearGradient id="yri-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="yri-sky0"></stop><stop offset="1" class="yri-sky1"></stop></linearGradient>
				<linearGradient id="yri-ice" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="yri-ice0"></stop><stop offset="1" class="yri-ice1"></stop></linearGradient>
				<linearGradient id="yri-edge" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="yri-edge0"></stop><stop offset="1" class="yri-edge1"></stop></linearGradient>
				<linearGradient id="yri-hull" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="yri-hull0"></stop><stop offset="1" class="yri-hull1"></stop></linearGradient>
				<radialGradient id="yri-sun"><stop offset="0" class="yri-sun0"></stop><stop offset="1" class="yri-sun1"></stop></radialGradient>
			</defs>
			<rect x="0" y="0" width="360" height={HOR} fill="url(#yri-sky)"></rect>
			<circle cx="70" cy="30" r="26" fill="url(#yri-sun)"></circle>
			<circle class="yri-sundisk" cx="70" cy="30" r="5"></circle>
			<rect x="0" y={HOR} width="360" height={240 - HOR} fill="url(#yri-ice)"></rect>
			<!-- far ridges drift back slowly (parallax) -->
			<g data-ridges>
				{RIDGES.map((r) => <path class="yri-ridge" data-d={r.d} data-x={r.x} d={`M0 ${r.y} l${r.l * 0.3} ${-r.l * 0.06} l${r.l * 0.25} ${r.l * 0.03} l${r.l * 0.2} ${-r.l * 0.05} l${r.l * 0.25} ${r.l * 0.08} Z`} />)}
			</g>
			<!-- the floe with the bear: a dark lead of open water around it -->
			<g data-floe>
				<path class="yri-lead" d="M-34 2 Q-30 -6 -8 -7 Q18 -9 34 -4 Q40 1 30 5 Q4 9 -22 7 Q-36 6 -34 2 Z"></path>
				<path class="yri-floe" d="M-31 1.5 Q-27 -4.6 -8 -5.4 Q16 -7 31 -3 Q35 0.6 28 3.4 Q4 6.4 -20 5.4 Q-32 4.6 -31 1.5 Z"></path>
				<path class="yri-floe-e" d="M-31 1.5 Q-32 4.6 -20 5.4 Q4 6.4 28 3.4 L28 4.6 Q4 7.6 -20 6.6 Q-32 5.8 -31 2.6 Z"></path>
				<g data-bear>
					<g data-bear-legs></g>
					<path class="yri-bear" d="M-6 -4.6 Q-6.6 -7.2 -3.4 -7.6 L2.6 -7.4 Q5.2 -7.2 5.6 -5 L5.4 -3.2 Q0 -2.2 -5.2 -2.8 Z"></path>
					<g data-bear-head>
						<path class="yri-bear" d="M4.6 -6.6 Q6.6 -7.4 8.4 -6.4 L10 -5.6 Q10.4 -5 9.6 -4.8 L7.4 -4.4 Q5.4 -4.6 4.6 -5.2 Z"></path>
						<circle class="yri-bear" cx="6" cy="-7.2" r="0.8"></circle>
						<circle class="yri-bear-dk" cx="10" cy="-5.3" r="0.45"></circle>
					</g>
				</g>
			</g>
			<!-- the ship: superstructure, hull, deck, rail -->
			<path class="yri-sup" d="M-10 58 V-2 H96 V20 H112 V58 Z"></path>
			<path class="yri-win" d="M4 12 h10 v6 h-10 Z M22 12 h10 v6 h-10 Z M40 12 h10 v6 h-10 Z M58 12 h10 v6 h-10 Z M76 12 h10 v6 h-10 Z M4 34 h10 v6 h-10 Z M22 34 h10 v6 h-10 Z M40 34 h10 v6 h-10 Z M58 34 h10 v6 h-10 Z M76 34 h10 v6 h-10 Z M100 30 h8 v6 h-8 Z"></path>
			<path class="yri-band" d="M-10 2 H96 V6 H-10 Z"></path>
			<path class="yri-mast" d="M140 58 V18 M134 26 H146 M140 18 l-3 4 M140 18 l3 4"></path>
			<path class="yri-hull" fill="url(#yri-hull)" d="M-10 60 L250 56.5 Q258 56.2 258.6 59.5 C256 108 236 172 190 212 L-10 212 Z"></path>
			<path class="yri-boot" d="M-10 196 L205 196 C200 202 195 207 190 212 L-10 212 Z"></path>
			<path class="yri-scuff" d="M40 186 h18 M70 190 h26 M112 184 h14 M140 189 h30 M176 186 h14 M24 191 h12 M92 181 h10 M160 181 h8"></path>
			<path class="yri-deck" d="M-10 60 L250 56.5 Q258 56.2 258.6 59.5"></path>
			<circle class="yri-hawse" cx="232" cy="84" r="4"></circle>
			<path class="yri-port" d="M30 96 a2.6 2.6 0 1 0 0.01 0 M60 95.6 a2.6 2.6 0 1 0 0.01 0 M90 95.2 a2.6 2.6 0 1 0 0.01 0 M120 94.8 a2.6 2.6 0 1 0 0.01 0 M150 94.4 a2.6 2.6 0 1 0 0.01 0"></path>
			<path class="yri-rail" d="M150 37 L256 35.4 M150 46.5 L256 45 M150 58.2 V37 M168 58 V36.8 M186 57.8 V36.5 M204 57.6 V36.2 M222 57.4 V35.9 M240 57.2 V35.6 M256 57 V35.4"></path>
			<path class="yri-staff" d="M255 57 L262 22"></path>
			<path class="yri-flag" d="M262 22 l12 2.6 l-11.2 3.6 Z"></path>
			<!-- slabs breaking at the bow, the channel water, the near ice -->
			<rect class="yri-water" x="-10" y="206" width="210" height="10"></rect>
			<g data-slabs></g>
			<path class="yri-near" fill="url(#yri-ice)" d="M-10 215 Q60 212 120 215.5 T200 214 Q240 212 280 215 T370 214 V240 H-10 Z"></path>
			<g data-cracks></g>
			<!-- the passengers -->
			<g data-pb></g>
			<rect class="yri-phone" width="2.4" height="4.2" rx="0.6" data-phone></rect>
			<circle class="yri-flash" r="3" data-flash></circle>
			<g data-pa></g>
		</svg>
		<div class="intro__foot">
			<p>Этот ледокол идёт сквозь лёд толщиной в два метра, и ему годами{' '}<More term="не нужно заходить в порт за топливом">На ледоколе стоит ядерный реактор: топливом для него служит уран, и одной загрузки хватает на несколько лет плавания. Первый в мире атомный ледокол «Ленин» вышел в море в 1959 году. Как работает реактор — раздел <a href="#ядерный-реактор">«Ядерный реактор»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="flight">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Салон самолёта. У иллюминатора сидит девочка-подросток, рядом взрослый читает книгу. За окном внизу море облаков, день сменяется закатом и ночью со звёздами. На экране в спинке переднего кресла, показанном крупно, — карта полёта Москва — Владивосток, высота 11 000 метров и время в пути. Девочка показывает на экран, взрослый поднимает глаза от книги">
			<defs>
				<clipPath id="yrf-win"><rect x="219" y="78" width="30" height="40" rx="12"></rect></clipPath>
				<clipPath id="yrf-ins"><rect x="244" y="2" width="114" height="76" rx="6"></rect></clipPath>
				<linearGradient id="yrf-day" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="yrf-day0"></stop><stop offset="1" class="yrf-day1"></stop></linearGradient>
				<linearGradient id="yrf-dusk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="yrf-dusk0"></stop><stop offset="0.6" class="yrf-dusk1"></stop><stop offset="1" class="yrf-dusk2"></stop></linearGradient>
				<radialGradient id="yrf-lamp" cx="0.5" cy="0" r="1"><stop offset="0" class="yrf-lamp0"></stop><stop offset="1" class="yrf-lamp1"></stop></radialGradient>
			</defs>
			<!-- the cabin is drawn in cabin units and enlarged 1,32 times (so the hands are big enough for fingers) -->
			<g transform="matrix(1.32 0 0 1.32 -92 -72.4)">
				<rect class="yrf-wall" x="0" y="0" width="360" height="226"></rect>
				<path class="yrf-bin" d="M0 0 H360 V30 Q360 40 350 42 H10 Q0 40 0 30 Z"></path>
				<path class="yrf-bin-l" d="M0 34 H360 M120 4 V40 M240 4 V40"></path>
				<rect class="yrf-floor" x="0" y="226" width="360" height="14"></rect>
				<!-- the windows: the teen's one and one farther back -->
				<rect class="yrf-wframe" x="215" y="74" width="38" height="48" rx="15"></rect>
				<rect class="yrf-wframe" x="61" y="84" width="38" height="48" rx="15"></rect>
				<rect class="yrf-shade" x="65" y="88" width="30" height="40" rx="12"></rect>
				<g clip-path="url(#yrf-win)">
					<rect x="219" y="78" width="30" height="40" fill="url(#yrf-day)"></rect>
					<rect x="219" y="78" width="30" height="40" fill="url(#yrf-dusk)" data-dusk></rect>
					<rect class="yrf-night" x="219" y="78" width="30" height="40" data-night></rect>
					<g data-stars>{STARS.map(([x, y]) => <circle class="yrf-star" cx={x - 12} cy={y} r="0.7" />)}</g>
					<g data-clouds></g>
				</g>
				<!-- the seat in front of the teen (farther row), its back with the screen -->
				<path class="yrf-seat yrf-far" d="M314 226 V192 Q314 186 320 186 H352 V226 Z"></path>
				<path class="yrf-seat yrf-far" d="M300 182 Q294 146 298 108 Q300 98 310 98 L318 100 Q324 102 322 114 L316 186 Q314 192 306 192 Z"></path>
				<rect class="yrf-scr" x="296.4" y="114" width="2.6" height="14" rx="1" data-scr></rect>
				<!-- the teen's seat (window seat, farther) -->
				<path class="yrf-seat yrf-far" d="M190 226 V186 Q190 179 198 179 H244 Q250 179 250 185 V190 H198 V226 Z"></path>
				<path class="yrf-seat yrf-far" d="M174 182 Q170 140 176 98 Q178 90 186 90 L192 92 Q198 94 196 104 L194 180 Z"></path>
				<!-- the armrest between the seats (her hand lies on it) -->
				<path class="yrf-arm" d="M192 168 H240 Q244 168 244 172 Q244 175 240 175 H196 Z"></path>
			</g>
			<g data-teen></g>
			<g transform="matrix(1.32 0 0 1.32 -92 -72.4)">
				<!-- the parent's seat (aisle seat, nearer) -->
				<path class="yrf-seat" d="M132 226 V192 Q132 184 140 184 H192 Q198 184 198 190 V196 H140 V226 Z"></path>
				<path class="yrf-seat" d="M110 188 Q104 146 112 104 Q114 96 122 96 L128 98 Q136 100 134 112 L132 186 Z"></path>
				<!-- the seat in front of the parent: at the edge -->
				<path class="yrf-seat" d="M338 192 Q332 152 336 112 Q338 102 348 102 L360 104 V196 Z"></path>
			</g>
			<g data-parent></g>
			<g data-book>
				<path class="yrf-book" d="M0 0 L-9 -3 L-9 5 L0 8 Z"></path>
				<path class="yrf-book" d="M0 0 L9 -3 L9 5 L0 8 Z"></path>
				<path class="yrf-book-l" d="M-7 -0.8 L-2 0.8 M-7 1.4 L-2 3 M2 0.8 L7 -0.8 M2 3 L7 1.4"></path>
			</g>
			<rect class="yrf-dim" x="0" y="0" width="360" height="240" data-dim></rect>
			<g transform="matrix(1.32 0 0 1.32 -92 -72.4)">
				<path class="yrf-lampcone" d="M166 42 L196 42 L232 226 L120 226 Z" fill="url(#yrf-lamp)" data-lamp></path>
				<circle class="yrf-lampbulb" cx="181" cy="42" r="2.2" data-bulb></circle>
			</g>
			<!-- the screen on the seat in front, enlarged -->
			<path class="yrf-lead" d="M270 78 L298 80 M336 78 L301 80"></path>
			<rect class="yrf-ins-bg" x="244" y="2" width="114" height="76" rx="6"></rect>
			<g clip-path="url(#yrf-ins)">
				<rect class="yrf-map" x="244" y="2" width="114" height="48"></rect>
				<path class="yrf-land" d="M244 16 Q270 8 300 14 Q330 6 358 16 V50 H244 Z"></path>
				<path class="yrf-route" d="M256 34 Q301 12 346 34"></path>
				<path class="yrf-route-done" d="" data-done></path>
				<circle class="yrf-city" cx="256" cy="34" r="2"></circle>
				<circle class="yrf-city" cx="346" cy="34" r="2"></circle>
				<text class="yrf-t" x="247" y="47" text-anchor="start">Москва</text>
				<text class="yrf-t" x="356" y="23" text-anchor="end">Владивосток</text>
				<path class="yrf-plane" d="M4 0 L-3 -1 L-5 -4.4 L-6.4 -4.4 L-5 -0.9 L-7 -0.6 L-8 -2 L-9 -2 L-8.4 0 L-9 2 L-8 2 L-7 0.6 L-5 0.9 L-6.4 4.4 L-5 4.4 L-3 1 Z" data-plane></path>
				<rect class="yrf-info" x="244" y="50" width="114" height="28"></rect>
				<text class="yrf-t2" x="301" y="62" text-anchor="middle">Высота 11 000 м</text>
				<text class="yrf-t2" x="301" y="75" text-anchor="middle" data-tt>В пути 2:10</text>
			</g>
			<rect class="yrf-ins-rim" x="244" y="2" width="114" height="76" rx="6"></rect>
		</svg>
		<div class="intro__foot">
			<p>За восемь часов полёта на высоте 11&nbsp;км пассажир получает от космоса{' '}<More term="примерно столько же облучения, сколько при рентгеновском снимке лёгких">Из космоса к Земле постоянно летят быстрые заряженные частицы. Атмосфера задерживает большинство из них, поэтому на высоте полёта самолёта облучение в десятки раз сильнее, чем на земле. За долгий перелёт это примерно 0,03 мЗв — столько же, сколько при рентгеновском снимке лёгких, и в 100 раз меньше того, что человек получает за год от природных источников. Что такое мЗв — раздел <a href="#действие-излучения-на-живые-организмы">«Действие излучения на живые организмы»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	/* ---- ice */
	.yri-sky0 { stop-color: hsl(205, 60%, 62%); }
	.yri-sky1 { stop-color: hsl(200, 50%, 88%); }
	.yri-sun0 { stop-color: hsl(48, 100%, 92%); stop-opacity: 0.95; }
	.yri-sun1 { stop-color: hsl(48, 100%, 85%); stop-opacity: 0; }
	.yri-sundisk { fill: hsl(50, 100%, 94%); }
	.yri-ice0 { stop-color: hsl(205, 30%, 86%); }
	.yri-ice1 { stop-color: hsl(200, 25%, 97%); }
	.yri-ridge { fill: hsl(205, 30%, 76%); stroke: hsl(205, 25%, 96%); stroke-width: 0.6; }
	.yri-lead { fill: hsl(210, 35%, 30%); }
	.yri-floe { fill: hsl(200, 30%, 96%); }
	.yri-floe-e { fill: hsl(175, 40%, 62%); }
	.yri-bear { fill: hsl(45, 45%, 90%); stroke: hsl(40, 15%, 55%); stroke-width: 0.35; }
	.yri-bear-leg { stroke: hsl(45, 35%, 84%); stroke-width: 1.3; stroke-linecap: round; }
	.yri-bear-dk { fill: hsl(0, 0%, 10%); }
	.yri-sup { fill: hsl(40, 20%, 95%); stroke: hsl(210, 10%, 60%); stroke-width: 0.6; }
	.yri-win { fill: hsl(210, 40%, 28%); }
	.yri-band { fill: hsl(355, 70%, 46%); }
	.yri-mast { fill: none; stroke: hsl(40, 15%, 88%); stroke-width: 1.6; stroke-linecap: round; }
	.yri-hull0 { stop-color: hsl(356, 72%, 50%); }
	.yri-hull1 { stop-color: hsl(354, 68%, 38%); }
	.yri-hull { stroke: hsl(354, 60%, 30%); stroke-width: 0.8; }
	.yri-boot { fill: hsl(352, 40%, 28%); }
	.yri-deck { fill: none; stroke: hsl(0, 0%, 96%); stroke-width: 1.6; }
	.yri-hawse { fill: hsl(354, 50%, 22%); stroke: hsl(0, 0%, 85%); stroke-width: 0.8; }
	.yri-port { fill: hsl(210, 30%, 85%); stroke: hsl(0, 0%, 96%); stroke-width: 0.7; }
	.yri-rail { fill: none; stroke: hsl(0, 0%, 94%); stroke-width: 0.9; }
	.yri-staff { stroke: hsl(0, 0%, 85%); stroke-width: 0.9; }
	.yri-flag { fill: hsl(210, 70%, 50%); }
	.yri-water { fill: hsl(205, 40%, 22%); }
	.yri-slab-top { fill: hsl(200, 30%, 97%); stroke: hsl(205, 25%, 70%); stroke-width: 0.6; }
	.yri-slab { stroke: hsl(185, 30%, 45%); stroke-width: 0.6; }
	.yri-edge0 { stop-color: hsl(178, 45%, 70%); }
	.yri-edge1 { stop-color: hsl(190, 50%, 42%); }
	.yri-near { stroke: hsl(205, 25%, 78%); stroke-width: 0.6; }
	.yri-scuff { stroke: hsl(350, 35%, 70%); stroke-width: 1.2; stroke-linecap: round; opacity: 0.6; }
	.yri-crack { fill: none; stroke: hsl(205, 35%, 34%); stroke-width: 1.2; stroke-linejoin: round; }
	.yri-phone { fill: hsl(220, 15%, 18%); }
	.yri-flash { fill: hsl(50, 100%, 96%); opacity: 0; }
	/* ---- flight */
	.yrf-wall { fill: hsl(35, 18%, 86%); }
	.yrf-bin { fill: hsl(35, 14%, 93%); stroke: hsl(35, 10%, 70%); stroke-width: 0.8; }
	.yrf-bin-l { stroke: hsl(35, 10%, 74%); stroke-width: 0.8; fill: none; }
	.yrf-floor { fill: hsl(215, 20%, 34%); }
	.yrf-wframe { fill: hsl(35, 10%, 96%); stroke: hsl(35, 8%, 72%); stroke-width: 0.8; }
	.yrf-shade { fill: hsl(35, 8%, 80%); }
	.yrf-day0 { stop-color: hsl(212, 70%, 52%); }
	.yrf-day1 { stop-color: hsl(200, 70%, 84%); }
	.yrf-dusk0 { stop-color: hsl(235, 45%, 30%); }
	.yrf-dusk1 { stop-color: hsl(20, 85%, 62%); }
	.yrf-dusk2 { stop-color: hsl(40, 95%, 70%); }
	.yrf-night { fill: hsl(230, 50%, 10%); }
	.yrf-star { fill: hsl(50, 100%, 95%); }
	.yrf-cloud { fill: hsl(0, 0%, 98%); }
	.yrf-seat { fill: hsl(215, 30%, 38%); stroke: hsl(215, 30%, 26%); stroke-width: 0.8; }
	.yrf-seat.yrf-far { fill: hsl(215, 26%, 30%); }
	.yrf-arm { fill: hsl(215, 15%, 55%); stroke: hsl(215, 20%, 35%); stroke-width: 0.6; }
	.yrf-scr { fill: hsl(200, 80%, 70%); }
	.yrf-book { fill: hsl(45, 40%, 96%); stroke: hsl(20, 50%, 40%); stroke-width: 0.8; stroke-linejoin: round; }
	.yrf-book-l { stroke: hsl(0, 0%, 60%); stroke-width: 0.5; }
	.yrf-dim { fill: hsl(230, 50%, 12%); opacity: 0; pointer-events: none; }
	.yrf-lamp0 { stop-color: hsl(45, 100%, 75%); stop-opacity: 0.35; }
	.yrf-lamp1 { stop-color: hsl(45, 100%, 80%); stop-opacity: 0; }
	.yrf-lampcone { opacity: 0; }
	.yrf-lampbulb { fill: hsl(48, 100%, 88%); opacity: 0; }
	.yrf-lead { stroke: hsl(215, 15%, 45%); stroke-width: 0.8; stroke-dasharray: 2 2; fill: none; }
	.yrf-ins-bg { fill: hsl(220, 45%, 14%); }
	.yrf-ins-rim { fill: none; stroke: hsl(215, 15%, 45%); stroke-width: 2; }
	.yrf-map { fill: hsl(210, 55%, 26%); }
	.yrf-land { fill: hsl(140, 22%, 34%); }
	.yrf-route { fill: none; stroke: hsl(0, 0%, 80%); stroke-width: 1; stroke-dasharray: 2 2; }
	.yrf-route-done { fill: none; stroke: hsl(45, 100%, 65%); stroke-width: 1.6; }
	.yrf-city { fill: hsl(0, 0%, 98%); }
	.yrf-plane { fill: hsl(0, 0%, 98%); }
	.yrf-info { fill: hsl(220, 45%, 12%); opacity: 0.85; }
	.yrf-t { fill: hsl(0, 0%, 96%); font-size: 12px; font-family: var(--__sl-font); }
	.yrf-t2 { fill: hsl(0, 0%, 98%); font-size: 12px; font-weight: 600; font-family: var(--__sl-font); font-variant-numeric: tabular-nums; }
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { DEG, SKELETON, add, polar, type Pt } from '@components/people/core';
	import { figure, ANKLE_CM, type FigurePose, type HandTarget } from '@components/people/body';
	import { ease, reach } from '@components/people/motion';

	const f = (v: number) => v.toFixed(1);
	const c01 = (x: number) => Math.min(1, Math.max(0, x));
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const NS = 'http://www.w3.org/2000/svg';
	const mkEl = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};

	document.querySelectorAll<HTMLElement>('[data-yrintro]').forEach((root) => {
		// ================= scene 1: the icebreaker
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ice"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 14;
			const HOR = 48;
			const V = 14; // px/s: 0,7 м/с at 20 px per м
			const drift = (d: number) => (V * 40) / d; // px/s at distance d
			const DECK = 57.4; // the deck under the passengers
			const S = 0.2; // px per см
			// ---- far ridges
			const ridges = [...card.querySelectorAll<SVGPathElement>('[data-ridges] path')].map((p) => ({ p, d: +p.dataset.d!, x: +p.dataset.x! }));
			// ---- floe and bear: 150 м away, ahead of the bow
			const floe = $<SVGGElement>('[data-floe]');
			const bear = $<SVGGElement>('[data-bear]');
			const bearHead = $<SVGGElement>('[data-bear-head]');
			const legsG = $<SVGGElement>('[data-bear-legs]');
			const legs = [0, 1, 2, 3].map(() => mkEl(legsG, 'path', { class: 'yri-bear-leg' }));
			const DF = 150;
			const YF = HOR + 6400 / DF;
			const KB = (20 * 40) / DF; // px per м at the floe (5,3)
			// ---- slabs and cracks: one slab every 60 px of ice (3 м)
			const slabG = $<SVGGElement>('[data-slabs]');
			const crackG = $<SVGGElement>('[data-cracks]');
			const STEM = 194; // where the stem meets the ice
			const NS_ = 9;
			const slabs = Array.from({ length: NS_ }, (_, i) => {
				const g = mkEl(slabG, 'g', {}) as SVGGElement;
				const side = mkEl(g, 'path', { class: 'yri-slab', fill: 'url(#yri-edge)' });
				const top = mkEl(g, 'path', { class: 'yri-slab-top' });
				const crack = mkEl(crackG, 'path', { class: 'yri-crack' });
				const w = 46 + ((i * 37) % 24); // px (2,3–3,5 м)
				const sgn = i % 2 ? 1 : -1;
				const peak = (22 + ((i * 53) % 18)) * DEG;
				return { g, side, top, crack, w, sgn, peak, x0: STEM + 40 + i * 60 };
			});
			const SPAN = NS_ * 60;
			// ---- passengers
			const sk = SKELETON.adult;
			const pa = figure($<SVGGElement>('[data-pa]'), { s: S, H: 175, clothes: 'winter', gear: 'boot', shirt: 'hm-blue', name: 'icebreaker pointer' });
			const pb = figure($<SVGGElement>('[data-pb]'), { s: S, H: 165, clothes: 'winter', gear: 'boot', shirt: 'hm-gold', name: 'icebreaker photographer' });
			const ank = DECK - ANKLE_CM.boot * S;
			const uA = 175 * S;
			const uB = 165 * S;
			const hipA: Pt = { x: 230, y: ank - 0.995 * (sk.thigh + sk.shin) * uA };
			const hipB: Pt = { x: 205, y: ank - 0.995 * (sk.thigh + sk.shin) * uB };
			const shA = pa.shoulders(hipA, 0.02);
			const shB = pb.shoulders(hipB, 0.02);
			const hang = (sh: [Pt, Pt], u: number): [HandTarget, HandTarget] => [
				{ at: add(sh[0], polar(0.36 * u, Math.PI / 2 - 4 * DEG)), pose: 'relaxed' },
				{ at: add(sh[1], polar(0.36 * u, Math.PI / 2 + 4 * DEG)), pose: 'relaxed' },
			];
			const stand = (hip: Pt, hands: [HandTarget, HandTarget], head: number): FigurePose => ({
				hip,
				lean: 0.02,
				head,
				ankles: [
					{ x: hip.x + 1.6, y: ank },
					{ x: hip.x - 1.6, y: ank },
				],
				feet: [0, 0],
				hands,
				planted: [true, true],
			});
			const A_HANG = stand(hipA, hang(shA, uA), 0.1);
			const aimA = (bx: number, by: number): FigurePose => {
				const a = Math.atan2(by - shA[0].y, bx - shA[0].x);
				return stand(hipA, [{ at: add(shA[0], polar(0.37 * uA, a)), pose: 'point', dir: a }, hang(shA, uA)[1]], 0.3);
			};
			// B holds the phone in the near hand all the time; both hands raise it in front of the face
			const PH0: HandTarget = { at: add(shB[0], polar(0.36 * uB, Math.PI / 2 - 4 * DEG)), pose: 'grip', d: 1, dir: Math.PI / 2, contact: 'phone' };
			const B_HANG = stand(hipB, [PH0, hang(shB, uB)[1]], 0.1);
			const phoneUp: Pt = { x: hipB.x + 0.2 * uB, y: hipB.y - 0.37 * uB };
			const B_UP = stand(
				hipB,
				[
					{ at: { x: phoneUp.x, y: phoneUp.y + 1.2 }, pose: 'grip', d: 1, dir: -80 * DEG, contact: 'phone' },
					{ at: { x: phoneUp.x - 0.4, y: phoneUp.y - 0.6 }, pose: 'grip', d: 1, dir: -80 * DEG, contact: 'phone' },
				],
				0.15,
			);
			const phone = $<SVGRectElement>('[data-phone]');
			const flash = $<SVGCircleElement>('[data-flash]');

			scene(card, RUN, (x) => {
				const t = RUN * x;
				// ---- ridges drift back
				for (const r of ridges) {
					const xx = ((((r.x - drift(r.d) * t) % 400) + 400) % 400) - 20;
					r.p.setAttribute('transform', `translate(${f(xx)} 0)`);
				}
				// ---- the floe and the bear
				const fx = 352 - drift(DF) * t;
				floe.setAttribute('transform', `translate(${f(fx)} ${f(YF)})`);
				const walk = t > 7.4 ? (t - 7.4) * 0.8 * KB : 0; // 0,8 м/с along the floe
				bear.setAttribute('transform', `translate(${f(-10 + Math.min(walk, 22))} -0.6)`);
				const look = t < 5.6 ? 0 : t < 6.4 ? ease((t - 5.6) / 0.8) : t < 7.2 ? 1 : 1 - ease((t - 7.2) / 0.6);
				bearHead.setAttribute('transform', `rotate(${f(-28 * look + (t < 5.6 ? 14 : 14 * (1 - look)))} 5 -6)`);
				const ph = t > 7.4 && walk < 22 ? (t - 7.4) * 2 * Math.PI * 1.1 : 0;
				[
					[-4.4, 0],
					[-2.6, Math.PI],
					[2.6, Math.PI],
					[4.2, 0],
				].forEach(([lx, p], k) => {
					const sw = 1.6 * Math.sin(ph + p);
					legs[k].setAttribute('d', `M${f(lx)} -3.6 L${f(lx + sw)} 0`);
					legs[k].setAttribute('opacity', k === 1 || k === 2 ? '0.8' : '1');
				});
				// ---- slabs: cracks ahead of the stem, then a slab breaks, turns, slides back along the hull
				for (const s of slabs) {
					let xs = s.x0 - V * t;
					xs = ((((xs + 40) % SPAN) + SPAN) % SPAN) - 40 - 10; // wrap
					const ahead = xs - STEM; // > 0: still ahead of the stem
					if (ahead > 0) {
						const show = c01(1 - ahead / 70);
						s.crack.setAttribute('d', ahead < 70 ? `M${f(xs)} 214 l-4 5 l3 4 l-5 6 l2 5 l-4 6 M${f(xs - 4)} 219 l-8 3 l-6 -1 M${f(xs - 3)} 228 l7 3 l5 5` : '');
						s.crack.style.opacity = f(show);
						s.g.style.display = 'none';
						continue;
					}
					s.crack.setAttribute('d', '');
					s.g.style.display = '';
					const back = -ahead; // px behind the stem
					const tilt = s.sgn * s.peak * (back < 40 ? ease(back / 40) : Math.max(0.3, 1 - (back - 40) / 160));
					const cx = xs - s.w / 2;
					const cy = 205 - (back < 40 ? 6 * ease(back / 40) : 6);
					// the slab: 2 м thick (40 px), mostly under water; the near ice hides what is below
					const w2 = s.w / 2;
					s.g.setAttribute('transform', `translate(${f(cx)} ${f(cy)}) rotate(${f(tilt / DEG)})`);
					s.side.setAttribute('d', `M${f(-w2)} -2 H${f(w2)} V38 H${f(-w2)} Z`);
					s.top.setAttribute('d', `M${f(-w2)} -2 L${f(-w2 + 3)} -6 H${f(w2 + 3)} L${f(w2)} -2 Z`);
				}
				// ---- passenger A points at the bear
				const bearX = fx - 10 + Math.min(walk, 22);
				const bearY = YF - 5;
				let pA: FigurePose;
				if (t < 1.5) pA = A_HANG;
				else if (t < 2.4) pA = reach(A_HANG, aimA(bearX, bearY), (t - 1.5) / 0.9);
				else if (t < 9) pA = aimA(bearX, bearY);
				else if (t < 9.9) pA = reach(aimA(bearX, bearY), A_HANG, (t - 9) / 0.9);
				else pA = A_HANG;
				pa.pose(pA);
				// ---- passenger B photographs
				let pB: FigurePose;
				if (t < 3) pB = B_HANG;
				else if (t < 3.9) pB = reach(B_HANG, B_UP, (t - 3) / 0.9);
				else if (t < 7.6) pB = B_UP;
				else if (t < 8.5) pB = reach(B_UP, B_HANG, (t - 7.6) / 0.9);
				else pB = B_HANG;
				const st = pb.pose(pB);
				const g = st.grips[0];
				const up = t >= 3 && t < 8.5 ? (t < 3.9 ? ease((t - 3) / 0.9) : t < 7.6 ? 1 : 1 - ease((t - 7.6) / 0.9)) : 0;
				const pang = lerp(90, 0, up); // the phone hangs along the hand, then stands upright facing the bear
				phone.setAttribute('transform', `translate(${f(g.x)} ${f(g.y)}) rotate(${f(pang)}) translate(-1.2 -2.1)`);
				const fl = (t >= 5 && t < 5.18) || (t >= 6.3 && t < 6.48) ? 1 : 0;
				flash.setAttribute('cx', f(g.x + 1));
				flash.setAttribute('cy', f(g.y - 1));
				flash.style.opacity = fl ? '0.9' : '0';
			});
		}

		// ================= scene 2: the flight
		{
			const card = root.querySelector<HTMLElement>('[data-scene="flight"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 12;
			const FLOOR = 226;
			const T0 = 130; // min in flight at the start (2:10)
			const T1 = 480; // 8:00
			const dusk = $<SVGRectElement>('[data-dusk]');
			const night = $<SVGRectElement>('[data-night]');
			const stars = $<SVGGElement>('[data-stars]');
			const dim = $<SVGRectElement>('[data-dim]');
			const lamp = $<SVGRectElement>('[data-lamp]');
			const bulb = $<SVGCircleElement>('[data-bulb]');
			const plane = $<SVGPathElement>('[data-plane]');
			const done = $<SVGPathElement>('[data-done]');
			const tt = $<SVGTextElement>('[data-tt]');
			const book = $<SVGGElement>('[data-book]');
			const cloudG = $<SVGGElement>('[data-clouds]');
			const clouds = Array.from({ length: 7 }, (_, i) => {
				const g = mkEl(cloudG, 'g', {}) as SVGGElement;
				const w = 9 + ((i * 7) % 6);
				mkEl(g, 'ellipse', { class: 'yrf-cloud', cx: 0, cy: 0, rx: w, ry: 3.4 });
				mkEl(g, 'ellipse', { class: 'yrf-cloud', cx: -w * 0.3, cy: -2.4, rx: w * 0.45, ry: 2.8 });
				mkEl(g, 'ellipse', { class: 'yrf-cloud', cx: w * 0.3, cy: -1.8, rx: w * 0.4, ry: 2.4 });
				return { g, x0: 212 + i * 9, y: 108 + (i % 3) * 3.5 };
			});
			mkEl(cloudG, 'rect', { class: 'yrf-cloud', x: 216, y: 111, width: 36, height: 10 });
			const cloudShade = [...cloudG.querySelectorAll('.yrf-cloud')] as SVGElement[];
			// the route on the map: a quadratic curve
			const P0 = { x: 256, y: 34 };
			const PC = { x: 301, y: 12 };
			const P1 = { x: 346, y: 34 };
			const bez = (u: number) => ({ x: (1 - u) ** 2 * P0.x + 2 * u * (1 - u) * PC.x + u * u * P1.x, y: (1 - u) ** 2 * P0.y + 2 * u * (1 - u) * PC.y + u * u * P1.y });

			// ---- the people
			const SP = 0.9;
			const ST = 0.86;
			const sk = SKELETON.adult;
			const skT = SKELETON.teen;
			const uP = 175 * SP;
			const uT = 160 * ST;
			const KZ = 1.32; // the cabin is enlarged 1,32 times: screen = 1,32·(cabin) − (92; 72,4)
			const Z = (p: Pt): Pt => ({ x: KZ * p.x - 92, y: KZ * p.y - 72.4 });
			const teen = figure($<SVGGElement>('[data-teen]'), { s: ST * KZ, H: 160, age: 'teen', shirt: 'hm-green', hair: 'pony', name: 'flight teen' });
			const parent = figure($<SVGGElement>('[data-parent]'), { s: SP * KZ, H: 175, shirt: 'hm-blue', name: 'flight parent' });
			// seated: the hip joint just above the cushion, the feet on the floor
			const hipT: Pt = { x: 206, y: 179 - 0.055 * uT };
			const hipP: Pt = { x: 146, y: 184 - 0.05 * uP };
			const ankT: [Pt, Pt] = [
				{ x: hipT.x + 0.29 * uT, y: FLOOR - 5 - 7 * ST },
				{ x: hipT.x + 0.26 * uT, y: FLOOR - 6 - 7 * ST },
			];
			const ankP: [Pt, Pt] = [
				{ x: hipP.x + 0.31 * uP, y: FLOOR - 7 * SP },
				{ x: hipP.x + 0.27 * uP, y: FLOOR - 1.5 - 7 * SP },
			];
			const shT = teen.shoulders(Z(hipT), 0.12);
			// the teen: near hand on the armrest, far hand on the window frame
			// the near hand rests relaxed on the armrest, turned a little so that its fingers show
			const ARM: HandTarget = { at: Z({ x: hipT.x + 0.17 * uT, y: 167.5 }), pose: 'relaxed', dir: 0.15, roll: -0.9, contact: 'armrest' };
			const WIN: HandTarget = { at: Z({ x: 222, y: 117 }), pose: 'flat', dir: -60 * DEG, roll: -Math.PI / 2 + 0.25, contact: 'window frame' };
			const SCREEN: Pt = Z({ x: 297, y: 121 });
			const aT = Math.atan2(SCREEN.y - shT[0].y, SCREEN.x - shT[0].x);
			const POINT: HandTarget = { at: add(shT[0], polar(0.355 * uT * KZ, aT)), pose: 'point', dir: aT };
			const seatT = (near: HandTarget, head: number, lean = 0.12): FigurePose => ({ hip: Z(hipT), lean, head, ankles: [Z(ankT[0]), Z(ankT[1])], feet: [0, 0], hands: [near, WIN], planted: [true, true] });
			const T_REST = seatT(ARM, -0.15);
			const T_POINT = seatT(POINT, 0.05, 0.16);
			// the parent: the book held in both hands in front of the chest
			const BOOK0: Pt = { x: hipP.x + 0.24 * uP, y: hipP.y - 0.2 * uP };
			const BOOK1: Pt = { x: hipP.x + 0.23 * uP, y: hipP.y - 0.15 * uP };
			const seatP = (b: Pt, head: number): FigurePose => ({
				hip: Z(hipP),
				lean: -0.12,
				head,
				ankles: [Z(ankP[0]), Z(ankP[1])],
				feet: [0, 0],
				hands: [
					{ at: Z({ x: b.x + 1, y: b.y + 7 }), pose: 'grip', d: 2, dir: -70 * DEG, contact: 'book' },
					{ at: Z({ x: b.x - 6, y: b.y + 3 }), pose: 'grip', d: 2, dir: -60 * DEG, contact: 'book' },
				],
				planted: [true, true],
			});
			const P_READ = seatP(BOOK0, 0.45);
			const P_LOOK = seatP(BOOK1, 0.05);

			scene(card, RUN, (x) => {
				const t = RUN * x;
				const min = T0 + (T1 - T0) * x;
				// ---- the sky: day until 4:30, sunset to 6:00, night after
				const ds = c01((min - 260) / 50);
				const nt = c01((min - 330) / 50);
				dusk.style.opacity = f(ds);
				night.style.opacity = f(nt * 0.92);
				stars.style.opacity = f(c01((min - 360) / 40));
				dim.style.opacity = f(0.32 * nt);
				const on = c01((min - 350) / 10);
				lamp.style.opacity = f(on);
				bulb.style.opacity = f(on);
				for (const c of cloudShade) c.style.fill = `hsl(${f(lerp(0, 20, ds * (1 - nt)))}, ${f(lerp(0, 60, ds * (1 - nt)))}%, ${f(lerp(98, 82, ds) - 62 * nt)}%)`;
				clouds.forEach((c, i) => {
					const xx = 212 + ((((c.x0 - 212 - 5 * t) % 50) + 50) % 50);
					c.g.setAttribute('transform', `translate(${f(xx)} ${f(c.y)})`);
				});
				// ---- the map
				const u = min / T1;
				const p = bez(u);
				const p2 = bez(Math.min(1, u + 0.01));
				plane.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)}) rotate(${f((Math.atan2(p2.y - p.y, p2.x - p.x) * 180) / Math.PI)}) scale(0.8)`);
				let d = `M${P0.x} ${P0.y}`;
				for (let k = 1; k <= 20; k++) {
					const q = bez((u * k) / 20);
					d += ` L${f(q.x)} ${f(q.y)}`;
				}
				done.setAttribute('d', d);
				const mm = Math.floor(min);
				tt.textContent = `В пути ${Math.floor(mm / 60)}:${String(mm % 60).padStart(2, '0')}`;
				// ---- the teen
				let pT: FigurePose;
				if (t < 7.6) pT = T_REST;
				else if (t < 8.4) pT = reach(T_REST, T_POINT, (t - 7.6) / 0.8);
				else if (t < 10.6) pT = T_POINT;
				else if (t < 11.5) pT = reach(T_POINT, T_REST, (t - 10.6) / 0.9);
				else pT = T_REST;
				teen.pose(pT);
				// ---- the parent
				let pP: FigurePose;
				if (t < 8.8) pP = P_READ;
				else if (t < 9.6) pP = reach(P_READ, P_LOOK, (t - 8.8) / 0.8);
				else if (t < 10.8) pP = P_LOOK;
				else if (t < 11.7) pP = reach(P_LOOK, P_READ, (t - 10.8) / 0.9);
				else pP = P_READ;
				const st = parent.pose(pP);
				// the book goes with the hands (between the two grips)
				const g0 = st.grips[0];
				const g1 = st.grips[1];
				book.setAttribute('transform', `translate(${f((g0.x + g1.x) / 2 + 1.3)} ${f((g0.y + g1.y) / 2 - 4)}) rotate(-12) scale(${KZ})`);
			});
		}
	});
</script>
