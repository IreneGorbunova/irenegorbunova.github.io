---
/**
 * «Ядерный реактор»: a labelled vertical section of a pressurized-water reactor (as the ВВЭР of Russian stations):
 * a thick steel vessel inside a concrete shield; in the core, vertical fuel rods (твэлы) with water between them (the
 * water is both the moderator and the coolant); control rods come down from the top between the fuel rods. Cold water
 * (290 °C) comes in through the left nozzle, goes down between the vessel and the core barrel, up through the core,
 * and leaves hot through the right nozzle to the steam generator. Not to scale (a real vessel is about 11 м high and
 * 4,5 м wide; the core is 3,5 м high).
 *
 * Physics: a toy model, the caption says so. The multiplication factor depends on the depth d of the rods (%):
 *   k = 1,010 − 0,010·d/55 for d ≤ 55, k = 1 − 0,050·(d − 55)/45 for d > 55,
 * so k = 1,010 with the rods out, k = 1 at 55 %, k = 0,950 with the rods fully in. The power P (in % of the nominal
 * power) changes by the factor k¹⁰ every second of the screen (about ten «effective generations» a second; in a real
 * reactor it is slower, because some neutrons leave the fragments with a delay), P from 0,1 % to 150 %. Above 120 % a
 * warning «перегрев»; at 140 % the automatic protection drops the rods (as the button «Аварийная защита» does: the
 * rods fall fully in within 2 с). The water leaves at 290 °C + 30 °C·P/100 % (320 °C at the nominal power). The
 * neutron dots in the core: their number is proportional to P (30 at 100 %). The graph shows P over the last 60 с.
 * On a phone (≤ 560 px) the label column is replaced by numbered marks and a numbered list, and the drawing is cropped
 * to the reactor (viewBox 300 wide), so every text is at least 11 px.
 * Start and «Сброс»: d = 55 %, k = 1, P = 100 %, the graph cleared.
 */
import YrStyles from './YrStyles.astro';
const FUEL = Array.from({ length: 7 }, (_, i) => 99 + 16 * i);
const CTRL = [110, 142, 158, 190];
const CORE = { x0: 95, x1: 207, y0: 150, y1: 270 };
---

<YrStyles />
<figure class="yr rl not-content" data-rl>
	<svg viewBox="0 0 420 338" role="img" aria-label="Модель ядерного реактора в разрезе: стальной корпус в бетонной защите, внутри топливные стержни с водой между ними и управляющие стержни сверху. Холодная вода входит слева, проходит через активную зону и выходит горячей справа. Можно опускать и поднимать управляющие стержни и включать аварийную защиту">
		<defs>
			<pattern id="rl-stip" width="9" height="9" patternUnits="userSpaceOnUse">
				<rect width="9" height="9" class="rl-conc"></rect>
				<circle cx="2" cy="2" r="0.9" class="rl-stip"></circle>
				<circle cx="6.5" cy="5.5" r="0.7" class="rl-stip"></circle>
				<circle cx="3.5" cy="7.5" r="0.5" class="rl-stip"></circle>
			</pattern>
		</defs>
		<!-- concrete shield -->
		<path fill="url(#rl-stip)" class="rl-concw" d="M30 14 H270 V330 H30 Z M56 36 V312 H244 V36 Z" fill-rule="evenodd"></path>
		<!-- pipes through the shield -->
		<rect class="rl-pipe rl-pipe-c" x="0" y="96" width="74" height="16"></rect>
		<rect class="rl-pipe rl-pipe-h" x="226" y="96" width="64" height="16" data-hotpipe></rect>
		<!-- the vessel with water -->
		<rect class="rl-water" x="74" y="56" width="152" height="240" rx="28"></rect>
		<path class="rl-barrel" d="M86 92 V284 M214 92 V284 M86 284 H214"></path>
		<rect class="rl-ves" x="70" y="52" width="160" height="248" rx="32"></rect>
		<!-- core: fuel rods -->
		<rect class="rl-core" x={CORE.x0} y={CORE.y0} width={CORE.x1 - CORE.x0} height={CORE.y1 - CORE.y0}></rect>
		{FUEL.map((x) => <rect class="rl-fuel" x={x} y={CORE.y0} width="6" height={CORE.y1 - CORE.y0} rx="2" />)}
		<g data-flow></g>
		<g data-neut></g>
		<!-- control rods with their drive lines -->
		<g data-rods>
			{CTRL.map((x) => <g><path class="rl-drive" d={`M${x} 10 V150`} /><rect class="rl-rod" x={x - 2.2} y="30" width="4.4" height="120" rx="1" /></g>)}
		</g>
		<rect class="rl-head" x="96" y="20" width="108" height="14" rx="3"></rect>
		<!-- labels with leaders -->
		<g class="rl-lab">
			<path class="rl-leader" d="M296 34 H206 L190 40"></path>
			<text class="yr-lbl" x="298" y="30">управляющие</text>
			<text class="yr-lbl" x="298" y="44">стержни</text>
			<path class="rl-leader" d="M296 74 H232 L226 70"></path>
			<text class="yr-lbl" x="298" y="70">корпус</text>
			<text class="yr-lbl" x="298" y="84">(сталь)</text>
			<path class="rl-leader" d="M296 108 H290"></path>
			<text class="yr-lbl rl-hot" x="298" y="104">горячая вода —</text>
			<text class="yr-lbl rl-hot" x="298" y="118">к парогенератору</text>
			<path class="rl-leader" d="M296 168 H210 L204 172"></path>
			<text class="yr-lbl" x="298" y="164">топливо —</text>
			<text class="yr-lbl" x="298" y="178">твэлы с ураном</text>
			<path class="rl-leader" d="M296 214 H216 L199 222"></path>
			<text class="yr-lbl" x="298" y="206">вода —</text>
			<text class="yr-lbl" x="298" y="220">замедлитель</text>
			<text class="yr-lbl" x="298" y="234">и теплоноситель</text>
			<path class="rl-leader" d="M296 284 H258"></path>
			<text class="yr-lbl" x="298" y="280">защита</text>
			<text class="yr-lbl" x="298" y="294">из бетона</text>
			<text class="yr-lbl rl-cold rl-halo" x="4" y="90">холодная вода</text>
			<text class="yr-lbl-s" x={(CORE.x0 + CORE.x1) / 2} y={CORE.y1 + 13} text-anchor="middle">активная зона</text>
		</g>
		<g class="rl-nums" aria-hidden="true"><g transform="translate(289 34)"><circle r="10"></circle><text y="5" text-anchor="middle">1</text></g><g transform="translate(289 74)"><circle r="10"></circle><text y="5" text-anchor="middle">2</text></g><g transform="translate(281 128)"><circle r="10"></circle><text y="5" text-anchor="middle">3</text></g><g transform="translate(289 168)"><circle r="10"></circle><text y="5" text-anchor="middle">4</text></g><g transform="translate(289 214)"><circle r="10"></circle><text y="5" text-anchor="middle">5</text></g><g transform="translate(289 284)"><circle r="10"></circle><text y="5" text-anchor="middle">6</text></g><g transform="translate(14 126)"><circle r="10"></circle><text y="5" text-anchor="middle">7</text></g><g transform="translate(151 287)"><circle r="10"></circle><text y="5" text-anchor="middle">8</text></g></g>
	</svg>
	<ol class="rl-legend"><li>управляющие стержни</li><li>корпус (сталь)</li><li>горячая вода — к парогенератору</li><li>топливо — твэлы с ураном</li><li>вода — замедлитель и теплоноситель</li><li>защита из бетона</li><li>холодная вода</li><li>активная зона</li></ol>
	<div class="rl-read">
		<span><i>k</i> = <b data-k>1,000</b></span>
		<span>мощность <b data-p>100</b>&nbsp;%</span>
		<span>вода на выходе <b data-t>320</b>&nbsp;°C</span>
	</div>
	<p class="rl-warn" data-warn aria-live="polite"></p>
	<svg class="rl-graph" viewBox="0 0 420 100" role="img" aria-label="График мощности реактора за последние 60 секунд">
		<path class="rl-axis" d="M40 8 V80 H412"></path>
		<path class="rl-grid" d="M40 32 H412 M40 56 H412"></path>
		<path class="rl-g140" d="M40 12.8 H412"></path>
		<text class="yr-lbl-s" x="36" y="11" text-anchor="end">150</text>
		<text class="yr-lbl-s" x="36" y="35" text-anchor="end">100</text>
		<text class="yr-lbl-s" x="36" y="59" text-anchor="end">50</text>
		<text class="yr-lbl-s" x="36" y="83" text-anchor="end">0</text>
		<text class="yr-lbl-s" x="44" y="94">мощность, % · последние 60 с</text>
		<text class="yr-lbl-s rl-warnc" x="408" y="25" text-anchor="end">140 % — автоматическая защита</text>
		<path class="rl-line" d="" data-line></path>
	</svg>
	<div class="yr-ctl">
		<label class="rl-sl"><span>Глубина управляющих стержней <b data-dv>55</b>&nbsp;%</span><input type="range" min="0" max="100" step="1" value="55" data-d /></label>
	</div>
	<div class="yr-ctl">
		<button type="button" class="yr-btn rl-scram" data-scram>Аварийная защита</button>
		<button type="button" class="yr-btn" data-reset>Сброс</button>
	</div>
	<p class="yr-cap">Это упрощённая модель, размеры не в масштабе. Мощность здесь меняется за секунды; в настоящем реакторе — медленнее, потому что часть нейтронов вылетает из осколков с запаздыванием.</p>
</figure>

<style is:global>
	.rl .rl-conc {
		fill: var(--yr-concrete);
	}
	.rl .rl-stip {
		fill: color-mix(in srgb, var(--sl-color-black) 30%, transparent);
	}
	.rl .rl-concw {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rl .rl-water {
		fill: color-mix(in srgb, var(--ig-vx) 22%, transparent);
	}
	.rl .rl-ves {
		fill: none;
		stroke: var(--yr-steel);
		stroke-width: 8;
	}
	.rl .rl-barrel {
		fill: none;
		stroke: color-mix(in srgb, var(--yr-steel) 70%, transparent);
		stroke-width: 2;
	}
	.rl .rl-core {
		fill: color-mix(in srgb, var(--ig-vx) 18%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 3 2;
	}
	.rl .rl-fuel {
		fill: var(--yr-fuel);
		stroke: color-mix(in srgb, var(--yr-fuel) 60%, black);
		stroke-width: 0.8;
	}
	.rl .rl-rod {
		fill: var(--yr-rod);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	.rl .rl-drive {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.rl .rl-head {
		fill: var(--yr-steel);
	}
	.rl .rl-pipe {
		stroke: var(--yr-steel);
		stroke-width: 2;
	}
	.rl .rl-pipe-c {
		fill: color-mix(in srgb, var(--yr-cold) 45%, transparent);
	}
	.rl .rl-pipe-h {
		fill: color-mix(in srgb, var(--yr-hot) 45%, transparent);
	}
	.rl .rl-leader {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.rl .rl-nums,
	.rl .rl-legend {
		display: none;
	}
	.rl .rl-nums circle {
		fill: var(--ig-surface);
		stroke: var(--sl-color-accent);
		stroke-width: 1.4;
	}
	.rl .rl-nums text {
		fill: var(--sl-color-white);
		font-size: 14.4px;
		font-weight: 600;
	}
	.rl .rl-legend {
		margin: 0.4rem 0 0;
		padding-left: 1.6rem;
		columns: 2;
		column-gap: 1.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.rl .rl-legend li {
		margin: 0;
		break-inside: avoid;
	}
	@media (max-width: 560px) {
		.rl .rl-lab text {
			display: none;
		}
		.rl .rl-nums {
			display: inline;
		}
		.rl .rl-legend {
			display: block;
		}
		.rl .rl-graph text {
			font-size: 14.2px;
		}
	}
	.rl .rl-halo {
		paint-order: stroke;
		stroke: var(--ig-surface);
		stroke-width: 3px;
	}
	.rl .rl-hot {
		fill: var(--yr-hot);
	}
	.rl .rl-cold {
		fill: var(--yr-cold);
	}
	.rl .rl-warnc {
		fill: var(--yr-hot);
		font-weight: 600;
	}
	.rl .rl-warn {
		min-height: 1.4em;
		margin: 0.1rem 0 0;
		text-align: center;
		color: var(--yr-hot);
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	.rl .rl-read {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.2rem 1.2rem;
		margin-top: 0.35rem;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
	}
	.rl .rl-graph {
		margin-top: 0.3rem;
	}
	.rl .rl-axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rl .rl-grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.rl .rl-g140 {
		stroke: var(--yr-hot);
		stroke-width: 0.8;
		stroke-dasharray: 4 3;
	}
	.rl .rl-line {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.rl .rl-sl {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		width: min(100%, 22rem);
		font-size: var(--sl-text-sm);
	}
	.rl .rl-sl input {
		width: 100%;
	}
	.rl .rl-scram {
		border-color: var(--yr-hot);
	}
	.rl .rl-n {
		fill: var(--yr-n);
		stroke: var(--sl-color-text);
		stroke-width: 0.6;
	}
</style>

<script>
	import { loop } from '@components/ch/g7/kit';
	const NS = 'http://www.w3.org/2000/svg';
	const CORE = { x0: 95, x1: 207, y0: 150, y1: 270 };
	const CTRL_X = [110, 142, 158, 190];
	const LANES = [103.5, 119.5, 135.5, 151.5, 167.5, 183.5, 199.5].map((x) => x - 6.5); // the water channels between rods
	const fmt = (v: number, d: number) => v.toFixed(d).replace('.', ',');
	const kOf = (d: number) => (d <= 55 ? 1.01 - (0.01 * d) / 55 : 1 - (0.05 * (d - 55)) / 45);
	const mk = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};

	document.querySelectorAll<HTMLElement>('[data-rl]').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const slider = q<HTMLInputElement>('[data-d]');
		// on a phone the label column gives way to numbers: the drawing is cropped to the reactor and gets larger
		const svgMain = root.querySelector('svg')!;
		const mq = window.matchMedia('(max-width: 560px)');
		const fit = () => svgMain.setAttribute('viewBox', mq.matches ? '0 0 300 338' : '0 0 420 338');
		mq.addEventListener('change', fit);
		fit();
		const rods = [...root.querySelectorAll<SVGRectElement>('[data-rods] rect')];
		const drives = [...root.querySelectorAll<SVGPathElement>('[data-rods] path')];
		const out = { k: q('[data-k]'), p: q('[data-p]'), t: q('[data-t]'), dv: q('[data-dv]'), warn: q<HTMLElement>('[data-warn]'), line: q<SVGPathElement>('[data-line]') };
		const hotpipe = q<SVGRectElement>('[data-hotpipe]');
		// ---- flow: each dot has its own lane through the core
		const flowG = q<SVGGElement>('[data-flow]');
		type Dot = { e: SVGCircleElement; s: number; pts: [number, number][]; segs: number[]; L: number };
		const dots: Dot[] = Array.from({ length: 34 }, (_, i) => {
			const lane = LANES[i % LANES.length] + 3;
			const pts: [number, number][] = [
				[0, 104],
				[80, 104],
				[80, 288],
				[lane, 288],
				[lane, CORE.y0 - 30],
				[lane, 118],
				[218, 104],
				[300, 104],
			];
			const segs = pts.slice(1).map((p, k) => Math.hypot(p[0] - pts[k][0], p[1] - pts[k][1]));
			const L = segs.reduce((a, b) => a + b, 0);
			return { e: mk(flowG, 'circle', { r: 2.2 }) as SVGCircleElement, s: (i / 34) * L, pts, segs, L };
		});
		const at = (d: Dot, s: number): [number, number] => {
			let r = s;
			for (let k = 0; k < d.segs.length; k++) {
				if (r <= d.segs[k]) {
					const u = r / d.segs[k];
					return [d.pts[k][0] + (d.pts[k + 1][0] - d.pts[k][0]) * u, d.pts[k][1] + (d.pts[k + 1][1] - d.pts[k][1]) * u];
				}
				r -= d.segs[k];
			}
			return d.pts[d.pts.length - 1];
		};
		// ---- neutrons in the core
		const nG = q<SVGGElement>('[data-neut]');
		const neut = Array.from({ length: 45 }, () => ({ e: mk(nG, 'circle', { class: 'rl-n', r: 1.6 }) as SVGCircleElement, x: CORE.x0 + Math.random() * (CORE.x1 - CORE.x0), y: CORE.y0 + Math.random() * (CORE.y1 - CORE.y0), a: Math.random() * 6.28 }));

		let d = 55;
		let P = 100;
		let scram = -1; // s since the protection started, −1 = off
		let d0 = 55;
		let warnText = '';
		const hist: number[] = [];
		let histT = 0;
		const setRods = () => {
			rods.forEach((r, i) => {
				const yb = CORE.y0 + ((CORE.y1 - CORE.y0) * d) / 100;
				r.setAttribute('y', (yb - 120).toFixed(1));
				drives[i].setAttribute('d', `M${CTRL_X[i]} 10 V${(yb - 120).toFixed(1)}`);
			});
			out.dv.textContent = String(Math.round(d));
		};
		const show = () => {
			const k = kOf(d);
			out.k.textContent = fmt(k, 3);
			out.p.textContent = P < 1 ? fmt(P, 1) : String(Math.round(P));
			const T = 290 + (30 * P) / 100;
			out.t.textContent = String(Math.round(T));
			out.warn.textContent = warnText;
			hotpipe.style.opacity = (0.35 + 0.65 * Math.min(1, P / 100)).toFixed(2);
		};
		const tempColor = (T: number) => {
			const m = Math.max(0, Math.min(100, ((T - 290) / 30) * 100));
			return `color-mix(in srgb, var(--yr-hot) ${m.toFixed(0)}%, var(--yr-cold))`;
		};
		const tick = (dt: number) => {
			// rods
			if (scram >= 0) {
				scram += dt;
				const u = Math.min(1, scram / 2);
				d = d0 + (100 - d0) * u * u;
				slider.value = String(Math.round(d));
				if (u >= 1) scram = -1;
			}
			setRods();
			const k = kOf(d);
			P = Math.min(150, Math.max(0.1, P * Math.pow(k, 10 * dt)));
			if (P >= 140 && scram < 0 && d < 100) {
				scram = 0;
				d0 = d;
				warnText = 'сработала аварийная защита';
			} else if (P > 120 && scram < 0) warnText = 'перегрев — опустите стержни';
			else if (scram < 0 && P <= 120 && warnText === 'перегрев — опустите стержни') warnText = '';
			show();
			// the flow: 40 px/s
			const Tout = 290 + (30 * P) / 100;
			for (const o of dots) {
				o.s = (o.s + 40 * dt) % o.L;
				const [x, y] = at(o, o.s);
				o.e.setAttribute('cx', x.toFixed(1));
				o.e.setAttribute('cy', y.toFixed(1));
				let T = 290;
				const inCore = x > CORE.x0 - 2 && x < CORE.x1 + 2 && y < 288;
				if (inCore) T = y > CORE.y1 ? 290 : y > CORE.y0 ? 290 + ((Tout - 290) * (CORE.y1 - y)) / (CORE.y1 - CORE.y0) : Tout;
				if (x > 214 && y < 112) T = Tout;
				o.e.style.fill = tempColor(T);
			}
			// the neutrons: the number ∝ P, fast random flights inside the core (not below the rods' tips)
			const n = Math.round((Math.min(P, 150) / 100) * 30);
			neut.forEach((m, i) => {
				m.e.style.display = i < n ? '' : 'none';
				if (i >= n) return;
				m.a += (Math.random() - 0.5) * 1.2;
				m.x += Math.cos(m.a) * 60 * dt;
				m.y += Math.sin(m.a) * 60 * dt;
				if (m.x < CORE.x0 || m.x > CORE.x1) m.a = Math.PI - m.a;
				if (m.y < CORE.y0 || m.y > CORE.y1) m.a = -m.a;
				m.x = Math.min(CORE.x1, Math.max(CORE.x0, m.x));
				m.y = Math.min(CORE.y1, Math.max(CORE.y0, m.y));
				m.e.setAttribute('cx', m.x.toFixed(1));
				m.e.setAttribute('cy', m.y.toFixed(1));
			});
			// the graph: a point every 0,25 s, the last 60 s
			histT += dt;
			while (histT >= 0.25) {
				histT -= 0.25;
				hist.push(P);
				if (hist.length > 241) hist.shift();
			}
			const x0 = 412 - (hist.length - 1) * (372 / 240);
			out.line.setAttribute('d', hist.map((p, i) => `${i ? 'L' : 'M'}${(x0 + i * (372 / 240)).toFixed(1)} ${(80 - (Math.min(p, 150) / 150) * 72).toFixed(1)}`).join(''));
			return true;
		};
		loop(root, tick)();
		slider.addEventListener('input', () => {
			scram = -1;
			d = Number(slider.value);
			if (warnText === 'сработала аварийная защита') warnText = '';
			setRods();
			show();
		});
		q('[data-scram]').addEventListener('click', () => {
			if (d >= 100) return;
			scram = 0;
			d0 = d;
			warnText = 'аварийная защита: стержни падают в активную зону';
		});
		q('[data-reset]').addEventListener('click', () => {
			scram = -1;
			d = 55;
			P = 100;
			slider.value = '55';
			warnText = '';
			hist.length = 0;
			setRods();
			show();
		});
		setRods();
		show();
	});
</script>
