---
/**
 * «Как работает атомная электростанция»: a school-style scheme of a station with a pressurized-water reactor (ВВЭР),
 * drawn in two rows so that it reads on a phone as on a desktop.
 *   Top row, inside the protective shell: the reactor → the 1st loop (water under pressure, about 160 атм, so it does
 *   not boil at 320 °C; hot pipe orange, the cooled water blue, a pump) → the steam generator: the 1st-loop water flows
 *   in a coil; around it the 2nd-loop water boils (bubbles), the steam leaves at the top. The two loops never mix.
 *   The steam pipe (white) goes down to the bottom row: the turbine (its blade wheels turn) on one shaft with the
 *   generator (it turns) → a transformer and a power line to a house with lit windows (gold dashes run along the
 *   wires). The used steam turns back to water in the condenser, cooled by a 3rd loop of water from the cooling tower
 *   (a white plume of water vapor, labelled «пар»), and a pump sends the water back to the steam generator.
 * Dots flow in every loop at the same speed (40 px/с; not to scale). Under the picture a strip of the five steps of the
 * energy chain lights in turn (1,6 с each), and the part of the scheme where that step happens is lit.
 * On a phone (≤ 560 px) the labels give way to numbered marks and a numbered list under the picture, so that every text
 * stays at least 11 px. Not to scale: a real reactor building is about 70 м high, a cooling tower about 150 м.
 */
import YrStyles from './YrStyles.astro';
const CHAIN = ['энергия ядер', 'внутренняя энергия воды', 'энергия пара', 'механическая энергия турбины', 'электрическая энергия'];
// the coil of the 1st loop inside the steam generator
const COIL: [number, number][] = [
	[150, 64],
	[160, 70],
	[200, 76],
	[160, 86],
	[200, 96],
	[160, 106],
	[200, 116],
	[160, 126],
	[150, 132],
];
const L1: [number, number][] = [[58, 70], [80, 62], [146, 62], ...COIL, [118, 134], [82, 128], [58, 128], [58, 70]];
const L2: [number, number][] = [
	[178, 44],
	[178, 24],
	[278, 24],
	[278, 196],
	[278, 246],
	[278, 268],
	[278, 292],
	[226, 292],
	[218, 292],
	[218, 132],
	[206, 132],
];
const L3: [number, number][] = [
	[250, 276],
	[140, 276],
	[100, 262],
	[100, 296],
	[140, 304],
	[250, 304],
];
const pts = (p: [number, number][]) => p.map(([x, y]) => `${x} ${y}`).join(' L');
---

<YrStyles />
<figure class="yr npp not-content" data-npp data-l1={JSON.stringify(L1)} data-l2={JSON.stringify(L2)} data-l3={JSON.stringify(L3)}>
	<svg viewBox="0 0 420 330" role="img" aria-label="Схема атомной электростанции. Реактор нагревает воду первого контура, она отдаёт тепло воде второго контура в парогенераторе, вода кипит, пар крутит турбину, турбина вращает генератор, электричество идёт по линии в дом. Пар превращается в воду в конденсаторе, его охлаждает вода из градирни">
		<!-- the protective shell -->
		<path class="npp-shell" d="M8 172 V60 Q8 10 128 8 Q248 10 248 60 V172 Z"></path>
		<text class="yr-lbl-s npp-w" x="116" y="27" text-anchor="middle">защитная оболочка</text>
		<!-- loop 3: condenser ↔ cooling tower -->
		<path class="npp-pipe npp-p3" d={`M${pts(L3)}`}></path>
		<!-- loop 2 -->
		<path class="npp-pipe npp-steam" data-part="2" d={`M${pts(L2.slice(0, 5))}`}></path>
		<path class="npp-pipe npp-p2" d={`M${pts(L2.slice(5))}`}></path>
		<!-- loop 1 -->
		<path class="npp-pipe npp-hot" d="M80 62 H146"></path>
		<path class="npp-pipe npp-cold" d="M150 132 L118 134 L82 128"></path>
		<!-- the reactor -->
		<g data-part="0">
			<rect class="npp-ves" x="30" y="48" width="52" height="96" rx="16"></rect>
			<rect class="npp-water" x="34" y="52" width="44" height="88" rx="13"></rect>
			{[40, 50, 60, 70].map((x) => <rect class="npp-fuel" x={x - 2} y="82" width="4" height="46" rx="1.5" />)}
			{[45, 55, 65].map((x) => <path class="npp-rod" d={`M${x} 36 V96`} />)}
			<circle class="npp-glow" cx="56" cy="105" r="22" data-glow></circle>
		</g>
		<text class="yr-lbl npp-w" x="56" y="160" text-anchor="middle">реактор</text>
		<!-- pump of loop 1 -->
		<circle class="npp-pump" cx="118" cy="134" r="6"></circle>
		<path class="npp-pumpb" d="M114 134 L120 130 L120 138 Z"></path>
		<!-- the steam generator -->
		<g data-part="1">
			<rect class="npp-sg" x="144" y="40" width="68" height="104" rx="16"></rect>
			<rect class="npp-sgw" x="147" y="80" width="62" height="61" rx="12"></rect>
			<path class="npp-coil" d={`M${pts(COIL)}`}></path>
			<g data-bubbles></g>
		</g>
		<text class="yr-lbl npp-w" x="170" y="160" text-anchor="middle">парогенератор</text>
		<text class="yr-lbl-s npp-hott npp-w" x="112" y="42" text-anchor="middle">1-й контур</text>
		<text class="yr-lbl-s npp-hott npp-w" x="112" y="54" text-anchor="middle">вода, 320 °C</text>
		<text class="yr-lbl-s npp-w" x="284" y="58">2-й контур:</text>
		<text class="yr-lbl-s npp-w" x="284" y="70">пар</text>
		<!-- the power line, the transformer, the house -->
		<g data-part="4">
			<path class="npp-wire" d="M378 216 H404 V170 M404 150 L360 72 L392 52" data-wire></path>
			<path class="npp-wire-e" d="M378 216 H404 V170 M404 150 L360 72 L392 52" data-wiree></path>
			<rect class="npp-tr" x="397" y="150" width="14" height="20" rx="2"></rect>
			<path class="npp-pylon" d="M354 100 L360 70 L366 100 M356 85 H364 M354 100 H366"></path>
			<path class="npp-house" d="M392 64 V40 L405 28 L418 40 V64 Z"></path>
			<rect class="npp-winl" x="396" y="46" width="7" height="7" data-win></rect>
			<rect class="npp-winl" x="407" y="46" width="7" height="7"></rect>
		</g>
		<text class="yr-lbl-s npp-w" x="393" y="164" text-anchor="end">трансформатор</text>
		<text class="yr-lbl-s npp-w" x="374" y="118" text-anchor="end">линия</text>
		<text class="yr-lbl-s npp-w" x="374" y="130" text-anchor="end">электропередачи</text>
		<!-- the turbine and the generator on one shaft -->
		<g data-part="3">
			<path class="npp-turb" d="M256 196 L300 186 V246 L256 236 Z"></path>
			<g data-blades></g>
			<path class="npp-shaft" d="M300 216 H330"></path>
			<rect class="npp-gen" x="330" y="196" width="48" height="40" rx="6"></rect>
			<g data-rotor></g>
		</g>
		<text class="yr-lbl npp-w" x="285" y="182">турбина</text>
		<text class="yr-lbl npp-w" x="354" y="252" text-anchor="middle">генератор</text>
		<!-- the condenser -->
		<rect class="npp-cond" x="252" y="258" width="52" height="54" rx="6"></rect>
		<path class="npp-ccoil" d="M252 276 H304 M252 304 H304"></path>
		<text class="yr-lbl npp-w" x="310" y="290">конденсатор</text>
		<circle class="npp-pump" cx="226" cy="292" r="6"></circle>
		<path class="npp-pumpb" d="M230 292 L224 288 L224 296 Z"></path>
		<text class="yr-lbl-s npp-w" x="226" y="316" text-anchor="middle">насос</text>
		<!-- the cooling tower with its plume -->
		<path class="npp-tower" d="M66 312 Q80 268 72 236 H128 Q120 268 134 312 Z"></path>
		<g data-plume></g>
		<text class="yr-lbl npp-w" x="100" y="326" text-anchor="middle">градирня</text>
		<text class="yr-lbl-s npp-w" x="132" y="194">пар</text>
		<g data-dots></g>
		<g class="npp-nums" aria-hidden="true"><g transform="translate(56 152)"><circle r="10"></circle><text y="5" text-anchor="middle">1</text></g><g transform="translate(178 152)"><circle r="10"></circle><text y="5" text-anchor="middle">2</text></g><g transform="translate(112 48)"><circle r="10"></circle><text y="5" text-anchor="middle">3</text></g><g transform="translate(296 40)"><circle r="10"></circle><text y="5" text-anchor="middle">4</text></g><g transform="translate(308 176)"><circle r="10"></circle><text y="5" text-anchor="middle">5</text></g><g transform="translate(354 252)"><circle r="10"></circle><text y="5" text-anchor="middle">6</text></g><g transform="translate(320 290)"><circle r="10"></circle><text y="5" text-anchor="middle">7</text></g><g transform="translate(226 316)"><circle r="10"></circle><text y="5" text-anchor="middle">8</text></g><g transform="translate(82 304)"><circle r="10"></circle><text y="5" text-anchor="middle">9</text></g><g transform="translate(140 196)"><circle r="10"></circle><text y="5" text-anchor="middle">10</text></g><g transform="translate(388 164)"><circle r="10"></circle><text y="5" text-anchor="middle">11</text></g><g transform="translate(368 122)"><circle r="10"></circle><text y="5" text-anchor="middle">12</text></g><g transform="translate(22 186)"><circle r="10"></circle><text y="5" text-anchor="middle">13</text></g></g>
	</svg>
	<ol class="npp-legend"><li>реактор</li><li>парогенератор</li><li>1-й контур: вода под давлением, 320 °C</li><li>2-й контур: вода и пар</li><li>турбина</li><li>генератор</li><li>конденсатор</li><li>насос</li><li>градирня</li><li>пар над градирней</li><li>трансформатор</li><li>линия электропередачи</li><li>защитная оболочка</li></ol>
	<ol class="npp-chain" aria-label="Цепочка превращений энергии">
		{CHAIN.map((c, i) => <li data-step={i}>{c}</li>)}
	</ol>
</figure>

<style is:global>
	.npp .npp-shell {
		fill: color-mix(in srgb, var(--yr-concrete) 18%, transparent);
		stroke: var(--yr-concrete);
		stroke-width: 3;
	}
	.npp .npp-pipe {
		fill: none;
		stroke-width: 5;
		stroke-linejoin: round;
		opacity: 0.55;
	}
	.npp .npp-hot {
		stroke: var(--yr-hot);
	}
	.npp .npp-cold,
	.npp .npp-p2,
	.npp .npp-p3 {
		stroke: var(--yr-cold);
	}
	.npp .npp-steam {
		stroke: var(--yr-steam);
	}
	.npp .npp-ves,
	.npp .npp-sg {
		fill: none;
		stroke: var(--yr-steel);
		stroke-width: 4;
	}
	.npp .npp-water {
		fill: color-mix(in srgb, var(--ig-vx) 25%, transparent);
	}
	.npp .npp-sgw {
		fill: color-mix(in srgb, var(--ig-vx) 28%, transparent);
	}
	.npp .npp-fuel {
		fill: var(--yr-fuel);
	}
	.npp .npp-rod {
		stroke: var(--yr-rod);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.npp .npp-glow {
		fill: var(--yr-g);
		opacity: 0.18;
	}
	.npp .npp-coil {
		fill: none;
		stroke: var(--yr-warm);
		stroke-width: 2.6;
		stroke-linejoin: round;
	}
	.npp .npp-bub {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 0.8;
	}
	.npp .npp-pump {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.npp .npp-pumpb {
		fill: var(--sl-color-gray-2);
	}
	.npp .npp-turb {
		fill: color-mix(in srgb, var(--yr-steel) 35%, transparent);
		stroke: var(--yr-steel);
		stroke-width: 2;
	}
	.npp .npp-blade {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.npp .npp-shaft {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.npp .npp-gen {
		fill: color-mix(in srgb, var(--yr-steel) 35%, transparent);
		stroke: var(--yr-steel);
		stroke-width: 2;
	}
	.npp .npp-rotor {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.npp .npp-cond {
		fill: color-mix(in srgb, var(--yr-steel) 25%, transparent);
		stroke: var(--yr-steel);
		stroke-width: 2;
	}
	.npp .npp-ccoil {
		stroke: var(--yr-cold);
		stroke-width: 3;
		opacity: 0.7;
	}
	.npp .npp-tower {
		fill: color-mix(in srgb, var(--yr-concrete) 60%, transparent);
		stroke: var(--yr-concrete);
		stroke-width: 1.6;
	}
	.npp .npp-puff {
		fill: hsl(0, 0%, 98%);
		stroke: color-mix(in srgb, var(--sl-color-gray-3) 50%, transparent);
		stroke-width: 0.6;
	}
	.npp .npp-nums {
		display: none;
	}
	.npp .npp-nums circle {
		fill: var(--ig-surface);
		stroke: var(--sl-color-accent);
		stroke-width: 1.4;
	}
	.npp .npp-nums text {
		fill: var(--sl-color-white);
		font-size: 14.4px;
		font-weight: 600;
	}
	.npp .npp-legend {
		display: none;
		margin: 0.5rem 0 0;
		padding-left: 1.6rem;
		columns: 2;
		column-gap: 1.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.npp .npp-legend li {
		margin: 0;
		break-inside: avoid;
	}
	@media (max-width: 560px) {
		.npp .npp-w {
			display: none;
		}
		.npp .npp-nums {
			display: inline;
		}
		.npp .npp-legend {
			display: block;
		}
	}
	.npp .npp-wire {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.npp .npp-wire-e {
		fill: none;
		stroke: var(--yr-g);
		stroke-width: 1.6;
		stroke-dasharray: 3 9;
	}
	.npp .npp-tr {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
	}
	.npp .npp-pylon {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.npp .npp-house {
		fill: color-mix(in srgb, var(--yr-concrete) 50%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.npp .npp-winl {
		fill: var(--yr-g);
	}
	.npp .npp-hott {
		fill: var(--yr-hot);
	}
	.npp [data-part] {
		transition: filter 0.3s;
	}
	.npp [data-part].is-lit {
		filter: drop-shadow(0 0 5px var(--yr-g));
	}
	.npp .npp-chain {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.3rem;
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-xs);
	}
	.npp .npp-chain li {
		margin: 0;
		padding: 0.2rem 0.55rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		transition: all 0.3s;
	}
	.npp .npp-chain li + li::before {
		content: '→ ';
		color: var(--sl-color-gray-3);
	}
	.npp .npp-chain li.is-on {
		border-color: var(--yr-g);
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--yr-g) 18%, transparent);
	}
</style>

<script>
	import { loop } from '@components/ch/g7/kit';
	const NS = 'http://www.w3.org/2000/svg';
	const mk = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	type Path = { pts: [number, number][]; segs: number[]; L: number };
	const path = (pts: [number, number][]): Path => {
		const segs = pts.slice(1).map((p, k) => Math.hypot(p[0] - pts[k][0], p[1] - pts[k][1]));
		return { pts, segs, L: segs.reduce((a, b) => a + b, 0) };
	};
	const at = (P: Path, s: number): [number, number, number] => {
		let r = s;
		for (let k = 0; k < P.segs.length; k++) {
			if (r <= P.segs[k]) {
				const u = r / P.segs[k];
				return [P.pts[k][0] + (P.pts[k + 1][0] - P.pts[k][0]) * u, P.pts[k][1] + (P.pts[k + 1][1] - P.pts[k][1]) * u, k];
			}
			r -= P.segs[k];
		}
		const e = P.pts[P.pts.length - 1];
		return [e[0], e[1], P.segs.length - 1];
	};

	document.querySelectorAll<HTMLElement>('[data-npp]').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const loops = ['l1', 'l2', 'l3'].map((k) => path(JSON.parse(root.dataset[k]!)));
		const dotG = q<SVGGElement>('[data-dots]');
		// colors: loop 1 hot until the coil's end (segment 11), then cold; loop 2 steam on its first 4 segments
		const color = (li: number, seg: number) => (li === 0 ? (seg >= 3 && seg < 11 ? 'var(--yr-warm)' : seg >= 11 ? 'var(--yr-cold)' : 'var(--yr-hot)') : li === 1 ? (seg < 4 ? 'var(--yr-steam)' : 'var(--yr-cold)') : 'var(--yr-cold)');
		const dots = loops.flatMap((P, li) => Array.from({ length: Math.floor(P.L / 22) }, (_, i) => ({ li, s: (i * P.L) / Math.floor(P.L / 22), e: mk(dotG, 'circle', { r: 2.4 }) as SVGCircleElement })));
		const bubG = q<SVGGElement>('[data-bubbles]');
		const bubbles = Array.from({ length: 12 }, (_, i) => ({ x: 156 + ((i * 37) % 48), y: 140 - ((i * 23) % 56), e: mk(bubG, 'circle', { class: 'npp-bub', r: 1.6 }) as SVGCircleElement }));
		const bladeG = q<SVGGElement>('[data-blades]');
		const blades = [266, 278, 290].map((x, k) => ({ x, h: 14 + k * 3, e: mk(bladeG, 'path', { class: 'npp-blade' }) as SVGPathElement }));
		const rotor = mk(q('[data-rotor]'), 'path', { class: 'npp-rotor' }) as SVGPathElement;
		const plumeG = q<SVGGElement>('[data-plume]');
		const puffs = Array.from({ length: 8 }, (_, i) => ({ ph: i / 8, e: mk(plumeG, 'circle', { class: 'npp-puff' }) as SVGCircleElement }));
		const wiree = q<SVGPathElement>('[data-wiree]');
		const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
		const parts = [...root.querySelectorAll<SVGElement>('[data-part]')];
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			for (const d of dots) {
				const P = loops[d.li];
				d.s = (d.s + 40 * dt) % P.L;
				const [x, y, seg] = at(P, d.s);
				d.e.setAttribute('cx', x.toFixed(1));
				d.e.setAttribute('cy', y.toFixed(1));
				d.e.style.fill = color(d.li, seg);
			}
			for (const b of bubbles) {
				b.y -= 22 * dt;
				if (b.y < 82) b.y = 138;
				b.e.setAttribute('cx', (b.x + Math.sin(b.y * 0.3) * 1.2).toFixed(1));
				b.e.setAttribute('cy', b.y.toFixed(1));
			}
			blades.forEach((b, k) => {
				const a = t * 6 + k;
				const c = Math.cos(a) * b.h;
				b.e.setAttribute('d', `M${b.x - 2} ${(216 - c).toFixed(1)} L${b.x + 2} ${(216 + c).toFixed(1)} M${b.x + 2} ${(216 - Math.sin(a) * b.h).toFixed(1)} L${b.x - 2} ${(216 + Math.sin(a) * b.h).toFixed(1)}`);
			});
			const ra = t * 6;
			rotor.setAttribute('d', `M354 216 m-12 0 a12 12 0 1 0 24 0 a12 12 0 1 0 -24 0 M${(354 - 12 * Math.cos(ra)).toFixed(1)} ${(216 - 12 * Math.sin(ra)).toFixed(1)} L${(354 + 12 * Math.cos(ra)).toFixed(1)} ${(216 + 12 * Math.sin(ra)).toFixed(1)}`);
			puffs.forEach((p) => {
				const u = (t / 5 + p.ph) % 1;
				p.e.setAttribute('cx', (100 + 14 * u + 4 * Math.sin(u * 9 + p.ph * 6)).toFixed(1));
				p.e.setAttribute('cy', (230 - 52 * u).toFixed(1));
				p.e.setAttribute('r', (6 + 10 * u).toFixed(1));
				p.e.style.opacity = (0.75 * (1 - u)).toFixed(2);
			});
			wiree.style.strokeDashoffset = String(-(t * 30) % 12);
			const k = Math.floor(t / 1.6) % 5;
			steps.forEach((s, i) => s.classList.toggle('is-on', i === k));
			parts.forEach((p) => p.classList.toggle('is-lit', Number(p.dataset.part) === k));
			return true;
		})();
	});
</script>
