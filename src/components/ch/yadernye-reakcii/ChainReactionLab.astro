</style>

<script>
	import { loop } from '@components/ch/g7/kit';
	const NS = 'http://www.w3.org/2000/svg';
	const CX = 180;
	const CY = 168;
	const PXCM = 14;
	const RHO = 19; // г/см³
	const M = 3.14; // см
	const KINF = { '235': 2.3, nat: 0.35 } as const;
	const MAXDRAW = 200;
	const START = 10; // neutrons from the source at the center
	const GEN = 1; // s per generation
	const FLY = 0.8; // s of flight
	const mk = (p: Element, tag: string, a: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	const fmt = (v: number, d = 2) => v.toFixed(d).replace('.', ',');
	const fint = (v: number) => Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
	const radius = (m: number) => Math.cbrt((3 * m * 1000) / (4 * Math.PI * RHO)); // см
	const stayP = (R: number) => 1 / (1 + ((Math.PI * M) / R) ** 2);
	/** binomial(n, p) by direct trials (n ≤ 5000) */
	const binom = (n: number, p: number) => {
		let c = 0;
		for (let i = 0; i < n; i++) if (Math.random() < p) c++;
		return c;
	};

	document.querySelectorAll<HTMLElement>('[data-crl]').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const dots = JSON.parse(root.dataset.dots!) as [number, number, 0 | 1][];
		const ball = q<SVGCircleElement>('[data-ball]');
		const glow = q<SVGCircleElement>('[data-glow]');
		const dotG = q<SVGGElement>('[data-dots]');
		const flG = q<SVGGElement>('[data-flashes]');
		const nG = q<SVGGElement>('[data-ns]');
		const rline = q<SVGPathElement>('[data-rline]');
		const rlab = q<SVGTextElement>('[data-rlab]');
		const many = q<SVGTextElement>('[data-many]');
		const out = { gen: q('[data-gen]'), num: q('[data-num]'), hist: q('[data-hist]'), kk: q('[data-kk]'), km: q('[data-km]'), verdict: q<HTMLElement>('[data-verdict]'), mv: q('[data-mv]'), rv: q('[data-rv]') };
		const slider = q<HTMLInputElement>('[data-m]');
		const dotEls = dots.map(([x, y]) => mk(dotG, 'circle', { cx: CX + x, cy: CY + y, r: 3.6 }) as SVGCircleElement);
		// pools: neutrons (dot + trail), flashes
		const pool = Array.from({ length: MAXDRAW }, () => {
			const g = mk(nG, 'g', {}) as SVGGElement;
			const tr = mk(g, 'line', { class: 'crl-tr' });
			const c = mk(g, 'circle', { class: 'yr-ball yr-free crl-n', r: 2.6 });
			g.style.display = 'none';
			return { g, tr, c };
		});
		const fpool = Array.from({ length: MAXDRAW }, () => {
			const c = mk(flG, 'circle', { class: 'crl-fl', r: 0 });
			c.style.display = 'none';
			return c;
		});

		let mass = 30;
		let kind: '235' | 'nat' = '235';
		let R = radius(mass);
		let kModel = 0;
		const setup = () => {
			R = radius(mass);
			kModel = KINF[kind] * stayP(R);
			const rp = R * PXCM;
			ball.setAttribute('r', rp.toFixed(1));
			glow.setAttribute('r', rp.toFixed(1));
			dots.forEach(([x, y, f], i) => {
				const inside = Math.hypot(x, y) < rp - 3;
				dotEls[i].style.display = inside ? '' : 'none';
				dotEls[i].setAttribute('class', kind === '235' || f ? 'crl-u5' : 'crl-u8');
			});
			rline.setAttribute('d', `M${CX} ${CY} H${(CX + rp).toFixed(1)}`);
			rlab.setAttribute('x', String(CX + rp / 2));
			rlab.setAttribute('y', String(CY - 6));
			out.mv.textContent = String(mass);
			out.rv.textContent = fmt(R, 1);
			out.km.textContent = fmt(kModel, 2);
			const v = out.verdict;
			const [cls, txt] = Math.abs(kModel - 1) < 0.01 ? ['is-eq', '<i>k</i> ≈ 1: реакция идёт с постоянной скоростью'] : kModel > 1 ? ['is-up', '<i>k</i> > 1: реакция нарастает'] : ['is-down', '<i>k</i> < 1: реакция затухает'];
			v.className = cls;
			v.innerHTML = txt;
			q<SVGCircleElement>('[data-key8]').style.display = kind === 'nat' ? '' : 'none';
			q<SVGTextElement>('[data-key8t]').style.display = kind === 'nat' ? '' : 'none';
		};

		// ---- the run: generations
		type Fly = { x0: number; y0: number; x1: number; y1: number; fate: 0 | 1 | 2 }; // 0 fission, 1 out, 2 swallowed
		let running = false;
		let t = 0;
		let gen = 0;
		let N = 0; // neutrons in the current generation
		let hist: number[] = [];
		let flies: Fly[] = [];
		let sites: [number, number][] = []; // where the current neutrons start
		const u5 = () => dots.filter(([x, y, f]) => (kind === '235' || f) && Math.hypot(x, y) < R * PXCM - 3);
		const u8 = () => dots.filter(([x, y, f]) => kind === 'nat' && !f && Math.hypot(x, y) < R * PXCM - 3);
		const near = (list: [number, number, 0 | 1][], x: number, y: number) => {
			// a random nucleus of the list 15–70 px away, else the nearest one
			const c = list.filter(([a, b]) => {
				const d = Math.hypot(a - x, b - y);
				return d > 15 && d < 70;
			});
			if (c.length) return c[Math.floor(Math.random() * c.length)];
			let best = list[0];
			let bd = 1e9;
			for (const p of list) {
				const d = Math.hypot(p[0] - x, p[1] - y);
				if (d > 4 && d < bd) {
					bd = d;
					best = p;
				}
			}
			return best;
		};
		/** decide the fates of N neutrons; returns the number of the next generation */
		const step = (n: number): { next: number; fis: number; outN: number; abs: number } => {
			const P = stayP(R);
			const pf = KINF[kind] / 2.5;
			if (n <= 5000) {
				const stay = binom(n, P);
				const fis = binom(stay, pf);
				let next = 0;
				for (let i = 0; i < fis; i++) next += Math.random() < 0.5 ? 2 : 3;
				return { next, fis, outN: n - stay, abs: stay - fis };
			}
			const fis = n * P * pf;
			return { next: Math.round(fis * 2.5), fis, outN: n * (1 - P), abs: n * P * (1 - pf) };
		};
		const plan = () => {
			// the paths of the drawn neutrons of this generation
			flies = [];
			const res = step(N);
			const drawN = Math.min(N, MAXDRAW);
			if (N <= MAXDRAW) {
				const fates: (0 | 1 | 2)[] = [];
				for (let i = 0; i < Math.round(res.fis); i++) fates.push(0);
				for (let i = 0; i < Math.round(res.outN); i++) fates.push(1);
				while (fates.length < N) fates.push(2);
				const list5 = u5();
				const list8 = u8();
				fates.forEach((fate, i) => {
					const [x0, y0] = sites[i % sites.length];
					let x1 = x0;
					let y1 = y0;
					if (fate === 1) {
						// straight out through the surface, 40 px beyond it
						const an = Math.random() * 2 * Math.PI;
						const dx = Math.cos(an);
						const dy = Math.sin(an);
						const Rr = R * PXCM + 40;
						const b = x0 * dx + y0 * dy;
						const L = -b + Math.sqrt(b * b - (x0 * x0 + y0 * y0 - Rr * Rr));
						x1 = x0 + dx * L;
						y1 = y0 + dy * L;
					} else {
						const list = fate === 2 && list8.length ? list8 : list5;
						const p = list.length ? near(list, x0, y0) : [x0 + 20, y0, 0];
						x1 = p[0];
						y1 = p[1];
					}
					flies.push({ x0, y0, x1, y1, fate });
				});
			}
			many.textContent = N > MAXDRAW ? 'нейтронов слишком много, чтобы нарисовать' : '';
			return { res, drawN };
		};
		let pending: { next: number; fis: number } = { next: 0, fis: 0 };
		const startGen = () => {
			const { res } = plan();
			pending = res;
			hist.push(N);
			out.gen.textContent = String(gen);
			out.num.textContent = fint(N);
			const h = hist.slice(-7).map(fint).join(' → ');
			out.hist.textContent = (hist.length > 7 ? '… → ' : '') + h;
			if (hist.length >= 2 && hist[hist.length - 2] > 0) out.kk.textContent = fmt(hist[hist.length - 1] / hist[hist.length - 2], 2);
			else out.kk.textContent = '—';
		};
		const finishGen = () => {
			// the next generation starts at the fissioned nuclei
			const fs = flies.filter((f) => f.fate === 0).map((f) => [f.x1, f.y1] as [number, number]);
			sites = [];
			if (fs.length) {
				// each fission gives 2 or 3 neutrons: repeat its site
				let k = 0;
				while (sites.length < Math.min(pending.next, MAXDRAW)) sites.push(fs[k++ % fs.length]);
			} else {
				const l = u5();
				for (let i = 0; i < Math.min(pending.next, MAXDRAW); i++) {
					const p = l[Math.floor(Math.random() * l.length)];
					sites.push([p[0], p[1]]);
				}
			}
			N = pending.next;
			gen++;
			if (N === 0 || gen > 40 || N > 1e15) {
				running = false;
				hist.push(N);
				out.gen.textContent = String(gen);
				out.num.textContent = fint(N);
				const h = hist.slice(-7).map(fint).join(' → ');
				out.hist.textContent = (hist.length > 7 ? '… → ' : '') + h + (N === 0 ? ' — реакция затухла' : '');
				if (hist[hist.length - 2] > 0) out.kk.textContent = fmt(hist[hist.length - 1] / hist[hist.length - 2], 2);
				pool.forEach((p) => (p.g.style.display = 'none'));
				return;
			}
			startGen();
		};
		const draw = () => {
			const u = Math.min(1, t / FLY);
			pool.forEach((p, i) => {
				const f = flies[i];
				if (!f || !running) {
					p.g.style.display = 'none';
					return;
				}
				const x = f.x0 + (f.x1 - f.x0) * u;
				const y = f.y0 + (f.y1 - f.y0) * u;
				const a = Math.atan2(f.y1 - f.y0, f.x1 - f.x0);
				const tl = Math.min(14, Math.hypot(x - f.x0, y - f.y0));
				const out1 = f.fate === 1 && Math.hypot(x, y) > R * PXCM;
				p.g.style.display = u >= 1 ? 'none' : '';
				p.g.style.opacity = out1 ? String(Math.max(0, 1 - (Math.hypot(x, y) - R * PXCM) / 40)) : '1';
				p.c.setAttribute('cx', (CX + x).toFixed(1));
				p.c.setAttribute('cy', (CY + y).toFixed(1));
				p.tr.setAttribute('x1', (CX + x - tl * Math.cos(a)).toFixed(1));
				p.tr.setAttribute('y1', (CY + y - tl * Math.sin(a)).toFixed(1));
				p.tr.setAttribute('x2', (CX + x - 3 * Math.cos(a)).toFixed(1));
				p.tr.setAttribute('y2', (CY + y - 3 * Math.sin(a)).toFixed(1));
			});
			// flashes at the end of the flight: gold for a fission, a gray ring for a neutron swallowed
			const fu = (t - FLY) / (GEN - FLY);
			fpool.forEach((c, i) => {
				const f = flies[i];
				if (!f || !running || f.fate === 1 || fu < 0) {
					c.style.display = 'none';
					return;
				}
				c.style.display = '';
				c.setAttribute('class', f.fate === 0 ? 'crl-fl' : 'crl-ab');
				c.setAttribute('cx', (CX + f.x1).toFixed(1));
				c.setAttribute('cy', (CY + f.y1).toFixed(1));
				c.setAttribute('r', (3 + 7 * fu).toFixed(1));
				c.style.opacity = (1 - fu).toFixed(2);
			});
			glow.setAttribute('opacity', running && N > 0 ? Math.min(1, Math.log10(N + 1) / 6).toFixed(2) : '0');
		};
		const wake = loop(root, (dt) => {
			if (!running) {
				draw();
				return false;
			}
			t += dt;
			if (t >= GEN) {
				t = 0;
				finishGen();
			}
			draw();
			return running;
		});
		const reset = () => {
			running = false;
			gen = 0;
			N = 0;
			hist = [];
			t = 0;
			flies = [];
			out.gen.textContent = '—';
			out.num.textContent = '—';
			out.kk.textContent = '—';
			out.hist.innerHTML = '&nbsp;';
			many.textContent = '';
			draw();
		};
		q('[data-go]').addEventListener('click', () => {
			reset();
			running = true;
			N = START;
			sites = Array.from({ length: START }, () => [0, 0] as [number, number]);
			startGen();
			wake();
		});
		q('[data-reset]').addEventListener('click', reset);
		slider.addEventListener('input', () => {
			mass = Number(slider.value);
			setup();
			reset();
		});
		root.querySelectorAll<HTMLButtonElement>('[data-u]').forEach((b) =>
			b.addEventListener('click', () => {
				kind = b.dataset.u as '235' | 'nat';
				root.querySelectorAll('[data-u]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				setup();
				reset();
			}),
		);
		setup();
		reset();
	});
</script>
