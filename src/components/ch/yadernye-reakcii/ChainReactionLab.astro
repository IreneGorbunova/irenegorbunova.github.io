---
/**
 * «Цепная реакция»: a cross-section of a ball of uranium (a disc) and the neutrons of a chain reaction, generation by
 * generation.
 *
 * Physics (a one-group estimate, honest within the model; the caption says it is a model):
 *   radius of the ball R = (3m / (4πρ))^⅓, ρ = 19 г/см³: 4,0 см at 5 кг, 8,7 см at 52 кг, 10,8 см at 100 кг;
 *   the share of neutrons that stay inside P = 1 / (1 + (πM/R)²), M = 3,14 см;
 *   k = k∞·P, k∞ = 2,3 for pure uranium-235 (k = 1 at R = 8,66 см, m ≈ 52 кг: the critical mass), k∞ = 0,35 for natural
 *   uranium (0,7 % of uranium-235; uranium-238 swallows most neutrons; k < 1 at any mass).
 *   A neutron leaves through the surface with the probability 1 − P; a neutron that stays splits a uranium-235 nucleus
 *   with the probability k∞/2,5, otherwise it is swallowed (in natural uranium mostly by uranium-238). Each fission
 *   gives 2 or 3 neutrons (2,5 on average). So the mean number of neutrons of the next generation is k times larger.
 *   The drawing follows this random process (Math.random); the counts are exact up to 5000 neutrons in a generation,
 *   beyond that the mean k·N is used. At most 200 neutrons are drawn; beyond that the picture says so and the numbers go
 *   on. One generation lasts 1 с on screen (in a real piece of uranium about 10⁻⁸ с). The disc is drawn at 14 px per см;
 *   the nuclei are drawn as a grid of dots, one dot for very many nuclei; in natural uranium every tenth dot is drawn as
 *   uranium-235 (in reality one in 140).
 * Controls: «Масса шара» 5–100 кг; «Уран-235 / Природный уран»; «Запустить 10 нейтронов» (a neutron source at the
 * center gives generation 0; with a single neutron the chain often dies at once by chance even at k = 1,25: the
 * probability is about 0,7, with ten neutrons about 0,04);
 * «Сброс». Readouts: the generation, the number of neutrons in it, the last ones in a row, k ≈ (the ratio of the last
 * two generations), the model's k, and the verdict.
 */
import YrStyles from './YrStyles.astro';
const PXCM = 14;
const RMAX = 10.8 * PXCM;
const DOTS: [number, number, number][] = [];
{
	let i = 0;
	for (let r = -12; r <= 12; r++)
		for (let c = -13; c <= 13; c++) {
			const x = c * 13 + (r % 2 ? 6.5 : 0);
			const y = r * 11.3;
			if (Math.hypot(x, y) < RMAX - 4) {
				// a fixed pseudo-random tenth of the dots are uranium-235 in natural uranium
				const h = Math.sin(i * 12.9898 + 78.233) * 43758.5453;
				DOTS.push([+x.toFixed(1), +y.toFixed(1), h - Math.floor(h) < 0.1 ? 1 : 0]);
				i++;
			}
		}
}
---

<YrStyles />
<figure class="yr crl not-content" data-crl data-dots={JSON.stringify(DOTS)}>
	<svg viewBox="0 0 360 336" role="img" aria-label="Модель цепной реакции: срез уранового шара. Нейтроны разлетаются от разделившихся ядер, часть вылетает наружу, часть поглощается, остальные делят новые ядра. Можно менять массу шара и выбирать уран-235 или природный уран">
		<defs>
			<radialGradient id="crl-glow"><stop offset="0" class="crl-glow0"></stop><stop offset="1" class="crl-glow1"></stop></radialGradient>
		</defs>
		<circle class="crl-ball" cx="180" cy="168" r="60" data-ball></circle>
		<circle cx="180" cy="168" r="60" fill="url(#crl-glow)" opacity="0" data-glow></circle>
		<g data-dots></g>
		<g data-flashes></g>
		<g data-ns></g>
		<path class="crl-rline" d="" data-rline></path>
		<text class="yr-lbl crl-l yr-sym" x="180" y="0" text-anchor="middle" data-rlab>R</text>
		<text class="yr-lbl-s crl-l" x="350" y="326" text-anchor="end" data-many></text>
		<g class="crl-key" transform="translate(10 14)">
			<circle class="crl-u5" cx="5" cy="0" r="4"></circle>
			<text class="yr-lbl-s" x="13" y="3.5">уран-235</text>
			<circle class="crl-u8" cx="5" cy="14" r="4" data-key8></circle>
			<text class="yr-lbl-s" x="13" y="17.5" data-key8t>уран-238</text>
			<circle class="yr-ball yr-free crl-n" cx="5" cy="28" r="2.6"></circle>
			<text class="yr-lbl-s" x="13" y="31.5">нейтрон</text>
		</g>
	</svg>
	<div class="crl-read">
		<p><span class="crl-k">Поколение:</span> <b data-gen>—</b> · <span class="crl-k">нейтронов в поколении:</span> <b data-num>—</b></p>
		<p class="crl-hist" data-hist>&nbsp;</p>
		<p><span class="crl-k"><i>k</i> ≈</span> <b data-kk>—</b> <span class="crl-k">(отношение двух последних поколений)</span></p>
		<p><span class="crl-k"><i>k</i> модели =</span> <b data-km>—</b> · <span data-verdict></span></p>
	</div>
	<div class="yr-ctl">
		<label class="crl-sl"><span>Масса шара <b data-mv>30</b>&nbsp;кг · радиус <i>R</i> = <b data-rv>7,2</b>&nbsp;см</span><input type="range" min="5" max="100" step="1" value="30" data-m /></label>
	</div>
	<div class="yr-ctl">
		<button type="button" class="yr-btn" data-u="235" aria-pressed="true">Уран-235</button>
		<button type="button" class="yr-btn" data-u="nat" aria-pressed="false">Природный уран</button>
	</div>
	<div class="yr-ctl">
		<button type="button" class="yr-btn crl-go" data-go>Запустить 10 нейтронов</button>
		<button type="button" class="yr-btn" data-reset>Сброс</button>
	</div>
	<p class="yr-cap">10 нейтронов вылетают из источника в центре шара. Это модель: каждый нейтрон с некоторой вероятностью вылетает наружу, поглощается или делит ядро урана-235, и при каждом делении вылетает 2 или 3 нейтрона. Одно поколение длится здесь 1&nbsp;с, в настоящем куске урана — около 10<sup>−8</sup>&nbsp;с. В природном уране ядра урана-235 нарисованы чаще, чем они встречаются (на самом деле одно на 140).</p>
</figure>

<style is:global>
