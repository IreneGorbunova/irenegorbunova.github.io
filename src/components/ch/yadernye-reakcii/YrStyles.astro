---
/**
 * Shared colors and controls of the pictures and models of «Ядерные реакции. Атомная энергетика» (grade 9). Renders
 * nothing; each component includes it (identical style blocks are merged by the build). The same colors as the two
 * previous atom chapters («Радиоактивность. Модели атома», «Состав атомного ядра. Ядерные силы») and grade 8:
 *   protons and α particles  red-pink (--yr-p = --ig-vy), a «+» on the bigger balls;
 *   neutrons                 neutral gray (--yr-n = gray-3, gray-4 in the light theme);
 *   electrons, β particles   blue (--yr-e = --ig-vx);
 *   γ radiation and energy   gold (--yr-g = --ig-v), γ as a short wavy line, energy as a gold glow;
 *   a free neutron in flight a gray ball with a thin rim of the text color and a gray trail (long = fast);
 *   uranium-235              its nucleus has a ring in the accent color (the fissile one);
 *   no force arrows in this chapter;
 *   the notation ᴬ_Z X       A in the accent color, Z in the color of protons (as in «Состав атомного ядра»).
 * Gradient stops for the balls: .yr-p0/.yr-p1 (proton), .yr-n0/.yr-n1 (neutron).
 */
---

<style is:global>
	.yr {
		--yr-p: var(--ig-vy);
		--yr-n: var(--sl-color-gray-3);
		--yr-e: var(--ig-vx);
		--yr-g: var(--ig-v);
		--yr-ink: var(--sl-color-white);
		--yr-dim: var(--sl-color-gray-3);
		--yr-line: var(--sl-color-gray-4);
		--yr-hot: hsl(8, 85%, 60%);
		--yr-warm: hsl(30, 80%, 58%);
		--yr-cold: hsl(205, 75%, 62%);
		--yr-water: hsl(205, 70%, 55%);
		--yr-steam: hsl(210, 20%, 82%);
		--yr-steel: hsl(215, 10%, 55%);
		--yr-concrete: hsl(35, 6%, 46%);
		--yr-fuel: hsl(48, 55%, 52%);
		--yr-rod: hsl(220, 12%, 22%);
	}
	:root[data-theme='light'] .yr {
		--yr-n: var(--sl-color-gray-4);
		--yr-hot: hsl(4, 75%, 50%);
		--yr-warm: hsl(28, 85%, 48%);
		--yr-cold: hsl(205, 75%, 45%);
		--yr-water: hsl(205, 70%, 50%);
		--yr-steam: hsl(210, 15%, 62%);
		--yr-steel: hsl(215, 10%, 58%);
		--yr-concrete: hsl(35, 8%, 70%);
		--yr-fuel: hsl(45, 65%, 48%);
		--yr-rod: hsl(220, 15%, 28%);
	}
	.yr {
		margin: 1.25rem 0 1.75rem;
		padding: 0.8rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.yr svg {
		display: block;
		width: 100%;
		height: auto;
		margin-inline: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.yr svg text {
		font-family: var(--__sl-font);
	}
	.yr .yr-lbl {
		fill: var(--sl-color-gray-2);
		font-size: 12px;
	}
	.yr .yr-lbl-s {
		fill: var(--sl-color-gray-3);
		font-size: 10.5px;
	}
	/* 420-wide drawings with labels: at least 11 px on a phone (the drawing is about 330 px wide there) */
	@media (max-width: 560px) {
		.yr svg.yr-big text {
			font-size: 14.2px;
		}
	}
	.yr .yr-sym {
		font-family: var(--ig-font-math) !important;
		font-style: italic;
	}
	.yr .yr-p0 {
		stop-color: color-mix(in srgb, var(--yr-p) 55%, white);
	}
	.yr .yr-p1 {
		stop-color: color-mix(in srgb, var(--yr-p) 80%, black);
	}
	.yr .yr-n0 {
		stop-color: color-mix(in srgb, var(--yr-n) 55%, white);
	}
	.yr .yr-n1 {
		stop-color: color-mix(in srgb, var(--yr-n) 75%, black);
	}
	.yr .yr-ball {
		stroke: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
		stroke-width: 0.5;
	}
	/* a free neutron in flight: a gray ball with a thin rim of the text color and a gray trail */
	.yr .yr-ball.yr-free {
		stroke: var(--sl-color-text);
		stroke-width: 0.9;
	}
	.yr .yr-trail {
		fill: none;
		stroke: var(--yr-n);
		stroke-linecap: round;
	}
	/* the fissile U-235 nucleus: a ring in the accent color */
	.yr .yr-fiss {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 1.8;
	}
	.yr .yr-el {
		fill: var(--yr-e);
		stroke: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
		stroke-width: 0.5;
	}
	.yr .yr-plus {
		fill: none;
		stroke: white;
		stroke-linecap: round;
		opacity: 0.9;
	}
	.yr .yr-gamma {
		fill: none;
		stroke: var(--yr-g);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.yr .yr-cap {
		margin: 0.5rem 0 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		line-height: 1.45;
	}
	.yr .yr-step {
		min-height: 2.9em;
		margin: 0.45rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		line-height: 1.45;
	}
	.yr .yr-ctl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
		justify-content: center;
		margin-top: 0.5rem;
	}
	.yr .yr-btn {
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.yr .yr-btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.yr .yr-btn:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.yr .yr-lab {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.yr i {
		font-family: var(--ig-font-math);
	}
	/* the notation ᴬ_Z X in HTML: the numbers stacked in front of the symbol */
	.yr .nt {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}
	.yr .nt__n {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		margin-right: 0.08em;
		font-size: max(0.68em, 11.5px);
		line-height: 1.05;
		font-variant-numeric: tabular-nums;
	}
	.yr .nt__a {
		color: var(--sl-color-accent);
	}
	.yr .nt__z {
		color: var(--yr-p);
	}
	.yr .nt__x {
		font-weight: 600;
	}
</style>
