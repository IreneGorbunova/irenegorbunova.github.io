---
/**
 * «Слияние ядер», two panels side by side (stacked on a phone; not tabs, so the person of the tokamak is always
 * visible and checked by the people checker).
 * «Реакция»: ²₁H + ³₁H → ⁴₂He + ¹₀n. A deuteron (1 proton + 1 neutron) and a triton (1 + 2) fly toward each other;
 *   they repel (both are positive): the motion is integrated with a repulsive force ∝ 1/r², the center of mass at rest
 *   (masses 2 and 3). «холодно»: relative speed 40 px/с, they slow down and turn back at about 80 px apart.
 *   «горячо, 100 млн К» (default): relative speed 90 px/с, they come close enough to touch (in reality the last part
 *   of the way they pass by the quantum tunnel effect, not drawn) and merge: helium-4 (2 + 2) flies one way and a
 *   neutron with a long trail the other, four times faster (equal and opposite momenta: 3,5 МэВ and 14,1 МэВ, speeds
 *   1,3·10⁷ and 5,2·10⁷ м/с; drawn 30 and 120 px/с); a gold flash: 2,8·10⁻¹² Дж released. Nuclei at 6 px per фм; the
 *   time is stretched enormously. Under it the equation and the checks 2 + 3 = 4 + 1, 1 + 1 = 2 + 0. Loop 6 с.
 * «Токамак»: the ring-shaped chamber of ITER seen at an angle, at 14 px per м: the plasma ring (major radius 6,2 м,
 *   minor radius 2 м, about 1,7 times taller than wide) glows inside the chamber and does not touch its walls; 8 of the
 *   18 D-shaped magnet coils (about 17 м tall, 9 м wide) stand around it; the central solenoid in the middle. A person
 *   (people kit, 175 см = 24,5 px, arms relaxed) stands beside for scale. The plasma color is symbolic (a real plasma
 *   of 150 млн К glows faintly); its streaks run along the ring.
 */
import YrStyles from './YrStyles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
import { pack } from './nucleus';
const D2 = pack(2, 1, 5);
const T3 = pack(3, 1, 5);
const HE = pack(4, 2, 5);
const nt = (A: number | string, Z: number | string, X: string) => `<span class="nt"><span class="nt__n"><span class="nt__a">${A}</span><span class="nt__z">${Z}</span></span><span class="nt__x">${X}</span></span>`;
const EQ = `${nt(2, 1, 'H')} + ${nt(3, 1, 'H')} → ${nt(4, 2, 'He')} + ${nt(1, 0, 'n')}`;
// tokamak geometry (м) and projection: 14 px per м, the ring plane tilted (vertical squeeze 0,35)
const KT = 14;
const CXT = 190;
const CYT = 150;
const RM = 6.2;
const SQ = 0.35;
const P = (x: number, y: number, z: number) => [CXT + KT * x, CYT + KT * (SQ * y - z)];
const coil = (phi: number) => {
	// a D: the inner leg straight at 2,2 м from the axis, the outer arc to 11,2 м; half-height 8,5 м
	const pts: number[][] = [];
	for (let i = 0; i <= 24; i++) {
		const t = (i / 24) * Math.PI;
		const rho = 2.2 + 9 * Math.sin(t);
		const z = 8.5 * Math.cos(t);
		pts.push(P(rho * Math.cos(phi), rho * Math.sin(phi), z));
	}
	pts.push(P(2.2 * Math.cos(phi), 2.2 * Math.sin(phi), -8.5));
	return 'M' + pts.map((p) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' L') + ' Z';
};
const COILS = Array.from({ length: 8 }, (_, i) => {
	const phi = (i / 8) * 2 * Math.PI + 0.2;
	return { d: coil(phi), front: Math.sin(phi) > 0 };
});
// a ring (torus center line) as an elliptic arc: back half (sin < 0) and front half
const ring = (r: number, front: boolean) => {
	const [x0, y0] = P(-r, 0, 0);
	const [x1] = P(r, 0, 0);
	return `M${x0.toFixed(1)} ${y0.toFixed(1)} A${(r * KT).toFixed(1)} ${(r * KT * SQ).toFixed(1)} 0 0 ${front ? 0 : 1} ${x1.toFixed(1)} ${y0.toFixed(1)}`;
};
---

<YrStyles />
<PeopleStyles />
<figure class="yr fus not-content" data-fus data-json={JSON.stringify({ D2, T3, HE })}>
	<div class="fus-grid">
	<div data-pane="0">
		<p class="fus-h">Реакция</p>
		<svg class="yr-big" viewBox="0 0 420 200" role="img" aria-label="Дейтрон и тритон летят навстречу друг другу. Медленные отталкиваются и разлетаются, быстрые сливаются: получается ядро гелия-4 и нейтрон, выделяется энергия">
			<defs>
				<radialGradient id="fus-gp" cx="0.35" cy="0.3" r="0.75"><stop offset="0" class="yr-p0"></stop><stop offset="1" class="yr-p1"></stop></radialGradient>
				<radialGradient id="fus-gn" cx="0.35" cy="0.3" r="0.75"><stop offset="0" class="yr-n0"></stop><stop offset="1" class="yr-n1"></stop></radialGradient>
				<radialGradient id="fus-glow"><stop offset="0" class="fus-g0"></stop><stop offset="1" class="fus-g1"></stop></radialGradient>
			</defs>
			<circle r="60" cx="210" cy="100" fill="url(#fus-glow)" opacity="0" data-flash></circle>
			<path class="yr-trail fus-ntr" d="" data-ntr></path>
			<g data-nuc></g>
			<text class="yr-lbl fus-l" data-l="d" text-anchor="middle">дейтрон</text>
			<text class="yr-lbl fus-l" data-l="t" text-anchor="middle">тритон</text>
			<text class="yr-lbl fus-l" data-l="he" text-anchor="middle">гелий-4</text>
			<text class="yr-lbl fus-l" data-l="n" text-anchor="middle">нейтрон</text>
			<text class="yr-lbl fus-l fus-gold" data-l="e" text-anchor="middle">энергия</text>
		</svg>
		<p class="fus-eq" set:html={EQ} />
		<p class="fus-chk"><span data-ca><span class="nt__a">2 + 3</span> = <span class="nt__a">4 + 1</span></span><span data-cz><span class="nt__z">1 + 1</span> = <span class="nt__z">2 + 0</span></span></p>
		<div class="yr-ctl">
			<button type="button" class="yr-btn" data-hot="1" aria-pressed="true">горячо, 100&nbsp;млн&nbsp;К</button>
			<button type="button" class="yr-btn" data-hot="0" aria-pressed="false">холодно</button>
			<button type="button" class="yr-btn" data-again>Повторить</button>
		</div>
	</div>
	<div data-pane="1">
		<p class="fus-h">Токамак</p>
		<svg class="yr-big" viewBox="0 0 420 300" role="img" aria-label="Токамак ИТЭР в разрезе: внутри кольцевой камеры светится кольцо плазмы, которое не касается стенок, вокруг стоят D-образные магнитные катушки. Рядом для масштаба стоит человек">
			<defs>
				<linearGradient id="fus-pl" x1="0" y1="0" x2="1" y2="0"><stop offset="0" class="fus-pl0"></stop><stop offset="0.5" class="fus-pl1"></stop><stop offset="1" class="fus-pl0"></stop></linearGradient>
			</defs>
			<path class="fus-floor" d="M0 286 H420"></path>
			{COILS.filter((c) => !c.front).map((c) => <path class="fus-coil" d={c.d} />)}
			<path class="fus-wall" d={ring(RM, false)} stroke-width={2 * 2.6 * KT}></path>
			<path class="fus-plasma-g" d={ring(RM, false)} stroke-width={2 * 1.9 * KT}></path>
			<path class="fus-plasma" d={ring(RM, false)} stroke-width={2 * 1.4 * KT}></path>
			<path class="fus-streak" d={ring(RM, false)} data-streak></path>
			<rect class="fus-sol" x={CXT - 1.6 * KT} y={CYT - 8.5 * KT} width={3.2 * KT} height={17 * KT} rx="4"></rect>
			<path class="fus-wall" d={ring(RM, true)} stroke-width={2 * 2.6 * KT}></path>
			<path class="fus-plasma-g" d={ring(RM, true)} stroke-width={2 * 1.9 * KT}></path>
			<path class="fus-plasma" d={ring(RM, true)} stroke-width={2 * 1.4 * KT}></path>
			<path class="fus-streak" d={ring(RM, true)} data-streak></path>
			{COILS.filter((c) => c.front).map((c) => <path class="fus-coil is-front" d={c.d} />)}
			<g data-person></g>
			<path class="fus-leader" d="M262 172 L300 210 H324"></path>
			<text class="yr-lbl fus-l" x="326" y="214">плазма</text>
			<path class="fus-leader" d="M332 98 L372 64"></path>
			<text class="yr-lbl fus-l" x="416" y="44" text-anchor="end">магнитные</text>
			<text class="yr-lbl fus-l" x="416" y="58" text-anchor="end">катушки</text>
			<path class="fus-leader" d="M108 196 L72 236 H40"></path>
			<text class="yr-lbl fus-l" x="8" y="252">стенка камеры</text>
			<text class="yr-lbl-s fus-l" x="360" y="282" text-anchor="end">человек — для масштаба</text>
		</svg>
		<p class="yr-cap">Токамак ИТЭР строят во Франции. Цвет плазмы условный.</p>
	</div>
	</div>
</figure>

<style is:global>
	.fus .fus-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: 0.8rem;
	}
	.fus .fus-h {
		margin: 0 0 0.2rem;
		text-align: center;
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	.fus .fus-l {
		paint-order: stroke;
		stroke: var(--ig-surface);
		stroke-width: 3px;
	}
	.fus .fus-gold {
		fill: var(--yr-g);
	}
	.fus .fus-g0 {
		stop-color: var(--yr-g);
		stop-opacity: 0.9;
	}
	.fus .fus-g1 {
		stop-color: var(--yr-g);
		stop-opacity: 0;
	}
	.fus .fus-ntr {
		stroke-width: 3;
		opacity: 0.55;
	}
	.fus .fus-eq {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
	}
	.fus .fus-chk {
		display: flex;
		justify-content: center;
		gap: 1.6rem;
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.fus .fus-chk > span {
		opacity: 0.25;
		transition: opacity 0.4s;
	}
	.fus .fus-chk > span.is-on {
		opacity: 1;
	}
	.fus .fus-floor {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.4;
	}
	.fus .fus-coil {
		fill: none;
		stroke: var(--yr-steel);
		stroke-width: 3.5;
		stroke-linejoin: round;
		opacity: 0.9;
	}
	.fus .fus-coil.is-front {
		opacity: 0.5;
	}
	.fus .fus-wall {
		fill: none;
		stroke: color-mix(in srgb, var(--yr-steel) 35%, transparent);
	}
	.fus .fus-plasma-g {
		fill: none;
		stroke: hsl(300, 80%, 65%);
		opacity: 0.25;
	}
	.fus .fus-plasma {
		fill: none;
		stroke: url(#fus-pl);
		opacity: 0.85;
	}
	.fus .fus-pl0 {
		stop-color: hsl(285, 75%, 62%);
	}
	.fus .fus-pl1 {
		stop-color: hsl(320, 90%, 74%);
	}
	.fus .fus-streak {
		fill: none;
		stroke: hsl(320, 100%, 92%);
		stroke-width: 1.4;
		stroke-dasharray: 14 22;
		opacity: 0.8;
	}
	.fus .fus-sol {
		fill: color-mix(in srgb, var(--yr-steel) 70%, var(--ig-surface));
		stroke: var(--yr-steel);
	}
	.fus .fus-leader {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { loop } from '@components/ch/g7/kit';
	import { balls, view } from './nucleus';
	import { SKELETON, add, polar, DEG, type Pt } from '@components/people/core';
	import { figure } from '@components/people/body';
	type Nuc = [number, number, number, 0 | 1][];
	const K = 6;
	const RUN = 6;
	const C = 76800; // the repulsion constant, px³·mass/s²
	const c01 = (x: number) => Math.min(1, Math.max(0, x));
	document.querySelectorAll<HTMLElement>('[data-fus]').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const Dd = JSON.parse(root.dataset.json!) as { D2: Nuc; T3: Nuc; HE: Nuc };
		// ---- the reaction
		const pane = q<HTMLElement>('[data-pane="0"]');
		const all: Nuc = [...Dd.D2, ...Dd.T3];
		const B = balls(q<SVGGElement>('[data-nuc]'), all.map((p) => p[3]), { k: K, fills: ['url(#fus-gn)', 'url(#fus-gp)'] });
		// after the merge: helium from the 2 protons and 2 of the neutrons; the third neutron leaves
		const tN = Dd.T3.map((p, i) => [p[3], i]).filter(([k]) => k === 0);
		const nOut = 2 + tN[tN.length - 1][1];
		const heIdx = all.map((_, i) => i).filter((i) => i !== nOut);
		const heT: [number, number, number][] = new Array(5);
		for (const kind of [0, 1] as const) {
			const mine = heIdx.filter((i) => all[i][3] === kind);
			const slots = Dd.HE.filter((p) => p[3] === kind);
			mine.forEach((i, k) => (heT[i] = [slots[k][0], slots[k][1], slots[k][2]]));
		}
		let hot = true;
		const flash = q<SVGCircleElement>('[data-flash]');
		const ntr = q<SVGPathElement>('[data-ntr]');
		const lab = (k: string) => q<SVGTextElement>(`[data-l="${k}"]`);
		const put = (t: SVGTextElement, x: number, y: number, o: number) => {
			t.setAttribute('x', x.toFixed(1));
			t.setAttribute('y', y.toFixed(1));
			t.style.opacity = o.toFixed(2);
		};
		const ca = q<HTMLElement>('[data-ca]');
		const cz = q<HTMLElement>('[data-cz]');
		// the 1D motion with repulsion, precomputed for both cases: positions of D and T (px from the center) over time
		const traj = (vrel: number) => {
			const mD = 2;
			const mT = 3;
			let xD = -150;
			let xT = 150 * (mD / mT);
			let vD = (vrel * mT) / (mD + mT);
			let vT = (-vrel * mD) / (mD + mT);
			const out: { xD: number; xT: number; touch: number }[] = [];
			let touch = -1;
			const dt = 1 / 240;
			for (let i = 0; i <= RUN * 240; i++) {
				const r = xT - xD;
				if (touch < 0 && r <= 26) touch = i / 240;
				if (touch < 0) {
					const F = C / (r * r);
					vD -= (F / mD) * dt;
					vT += (F / mT) * dt;
					xD += vD * dt;
					xT += vT * dt;
				}
				if (i % 4 === 0) out.push({ xD, xT, touch });
			}
			return out;
		};
		const TR = { hot: traj(90), cold: traj(40) };
		const CX = 210;
		const CY = 100;
		const draw = (x: number) => {
			const t = RUN * x;
			const T = hot ? TR.hot : TR.cold;
			const s = T[Math.min(T.length - 1, Math.round(t * 60))];
			const touch = T[T.length - 1].touch;
			const tau = hot && touch > 0 ? t - touch : -1;
			const merge = c01(tau / 0.25);
			const dir = (-35 * Math.PI) / 180; // helium flies up-left, the neutron down-right
			const heC = { x: CX - Math.cos(dir) * 30 * Math.max(0, tau - 0.25), y: CY - Math.sin(dir) * 30 * Math.max(0, tau - 0.25) };
			const nP = { x: CX + Math.cos(dir) * 120 * Math.max(0, tau - 0.25), y: CY + Math.sin(dir) * 120 * Math.max(0, tau - 0.25) };
			const cm = tau >= 0 ? (s.xD * 2 + s.xT * 3) / 5 : 0;
			all.forEach((p, i) => {
				const isD = i < 2;
				let x0 = CX + (isD ? s.xD : s.xT) - cm + p[0] * K;
				let y0 = CY + p[1] * K;
				let z0 = p[2];
				if (tau >= 0) {
					if (i === nOut && tau > 0.25) {
						x0 = nP.x;
						y0 = nP.y;
						z0 = 9;
					} else if (i !== nOut) {
						const g = heT[i];
						x0 = x0 + (heC.x + g[0] * K - x0) * merge;
						y0 = y0 + (heC.y + g[1] * K - y0) * merge;
						z0 = g[2];
					}
				}
				const v = view((x0 - CX) / K, (y0 - CY) / K, z0);
				B.set(i, CX + v.x * K, CY + v.y * K, v.z, !(i === nOut && tau > 0.25 && (nP.x > 430 || nP.y > 210)));
			});
			B.render();
			const nt = Math.max(0, tau - 0.25);
			ntr.setAttribute('d', tau > 0.25 ? `M${(nP.x - Math.cos(dir) * Math.min(60, 120 * nt)).toFixed(1)} ${(nP.y - Math.sin(dir) * Math.min(60, 120 * nt)).toFixed(1)} L${(nP.x - Math.cos(dir) * 6).toFixed(1)} ${(nP.y - Math.sin(dir) * 6).toFixed(1)}` : '');
			flash.setAttribute('opacity', tau >= 0 ? (Math.exp(-tau / 0.8) * c01(tau / 0.1)).toFixed(2) : '0');
			put(lab('d'), CX + s.xD - cm, CY - 22, tau < 0 ? 1 : 0);
			put(lab('t'), CX + s.xT - cm, CY - 24, tau < 0 ? 1 : 0);
			put(lab('he'), heC.x, heC.y - 22, c01((tau - 0.6) / 0.3));
			put(lab('n'), Math.min(nP.x, 380), Math.min(nP.y, 190) - 14, c01((tau - 0.6) / 0.3) * (nP.x < 440 ? 1 : 0));
			put(lab('e'), CX, CY + 44, tau >= 0 ? c01(tau / 0.2) * (1 - c01((tau - 1.8) / 0.5)) : 0);
			ca.classList.toggle('is-on', tau > 1.0);
			cz.classList.toggle('is-on', tau > 1.6);
		};
		scene(pane, RUN, draw);
		root.querySelectorAll<HTMLButtonElement>('[data-hot]').forEach((b) =>
			b.addEventListener('click', () => {
				hot = b.dataset.hot === '1';
				root.querySelectorAll('[data-hot]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				pane.querySelector<HTMLButtonElement>('[data-again]')!.click();
			}),
		);
		// ---- the tokamak: streaks run along the ring; a person stands beside for scale
		const tok = q<HTMLElement>('[data-pane="1"]');
		const streaks = [...tok.querySelectorAll<SVGPathElement>('[data-streak]')];
		let ts = 0;
		loop(tok, (dt) => {
			ts += dt;
			streaks.forEach((s, i) => (s.style.strokeDashoffset = String((i ? -1 : 1) * ts * 40)));
			return true;
		});
		const S = 0.14; // px per см (14 px per м)
		const H = 175;
		const u = S * H;
		const sk = SKELETON.adult;
		const man = figure(tok.querySelector<SVGGElement>('[data-person]')!, { s: S, H, shirt: 'hm-gold', dir: -1, name: 'tokamak person' });
		const ank = 286 - 7 * S;
		const hip: Pt = { x: 372, y: ank - 0.995 * (sk.thigh + sk.shin) * u };
		const sh = man.shoulders(hip, 0);
		man.pose({
			hip,
			lean: 0,
			head: 0,
			ankles: [
				{ x: hip.x - 1.5, y: ank },
				{ x: hip.x + 1.5, y: ank },
			],
			feet: [0, 0],
			hands: [
				{ at: add(sh[0], polar(0.36 * u, Math.PI / 2 + 4 * DEG)), pose: 'relaxed' },
				{ at: add(sh[1], polar(0.36 * u, Math.PI / 2 - 4 * DEG)), pose: 'relaxed' },
			],
			planted: [true, true],
		});
	});
</script>
