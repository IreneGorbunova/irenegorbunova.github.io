---
/**
 * Model «Разрыв снаряда»: the centre of mass of a shell that bursts in flight (side view, one scale on both axes,
 * g = 9,8 м/с², air left out). The shell leaves the ground at 30 м/с at 60° to the horizon: υ₀ₓ = 15 м/с,
 * υ₀ᵧ = 25,98 м/с; it reaches the top after t = 2,651 с at x = 39,8 м, H = 34,4 м; without a burst it would land at
 * L = 79,5 м. At the top it bursts horizontally into two fragments (both keep υᵧ = 0 there, so they fall 34,4 м and land
 * together, 2,651 с later). The reader sets the share s of fragment 1 in the mass (20…80 %, step 10) and its horizontal
 * speed after the burst υ₁ₓ (0…30 м/с, step 5; 15 м/с = the speed of the shell, «без разрыва»). The momentum along x is
 * kept in the burst: m·15 = m₁υ₁ₓ + m₂υ₂ₓ, so υ₂ₓ = (15 − s·υ₁ₓ)/(1 − s). Landing points x₁ = 39,8 + υ₁ₓ·2,651,
 * x₂ = 39,8 + υ₂ₓ·2,651 and the centre of mass x_c = s·x₁ + (1 − s)·x₂ = 79,5 м always: the centre of mass goes on along
 * the parabola of the whole shell (dashed) as if there were no burst.
 * Checks: s = 50 %, υ₁ₓ = 0 → υ₂ₓ = 30 м/с, x₁ = 39,8, x₂ = 119,3; s = 30 %, υ₁ₓ = 0 → 21,4 м/с, x₂ = 96,6;
 * s = 20 %, υ₁ₓ = 30 → 11,25 м/с, x₁ = 119,3, x₂ = 69,6; s = 80 %, υ₁ₓ = 0 → 75 м/с, x₂ = 238,6 (the farthest);
 * s = 80 %, υ₁ₓ = 30 → −45 м/с, x₂ = −79,5 (fragment 2 flies back).
 * The drawing is in screen pixels (the viewBox follows the width), scaled for each setting so that both landing points
 * fit; the flight is shown in real time (5,3 с). The fragments' sizes grow as the cube root of their masses and are not
 * to scale. Colors: fragment 1 blue, fragment 2 red, the centre of mass a cross in the text color.
 */
import G7Styles from '../g7/G7Styles.astro';
import ImpPicStyles from './ImpPicStyles.astro';
---

<ImpPicStyles />

<G7Styles />
<figure class="g7 g7--stack cml not-content" data-cml>
	<div class="g7__grid">
		<div class="cml__stage">
			<svg class="g7__svg cml__svg" role="img" aria-label="Снаряд вылетает из пушки, в верхней точке разрывается на два осколка. Осколки летят по своим параболам, а крестик — центр масс осколков — продолжает лететь по пунктирной параболе целого снаряда и падает туда же, куда упал бы снаряд" data-svg></svg>
			<p class="cml__time" data-time></p>
		</div>
		<div class="cml__controls">
			<label class="g7__slider"><span>Доля массы первого осколка <i>s</i></span><output data-o="s"></output><input type="range" min="20" max="80" step="10" value="50" data-s="s" aria-label="Доля массы первого осколка, проценты" /></label>
			<label class="g7__slider"><span>Его скорость сразу после разрыва <i>υ</i><sub>1<i>x</i></sub></span><output data-o="v"></output><input type="range" min="0" max="30" step="5" value="0" data-s="v" aria-label="Горизонтальная скорость первого осколка после разрыва, метры в секунду" /></label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Пуск</button>
				<button type="button" class="g7__btn" data-preset="50,0">Половинки, одна падает отвесно</button>
				<button type="button" class="g7__btn" data-preset="50,15">Без разрыва</button>
			</div>
			<ul class="g7__read" data-read></ul>
		</div>
	</div>
	<figcaption class="g7__caption">Пунктир — парабола целого снаряда, крестик — центр масс осколков. Сопротивление воздуха не учтено, масштаб по обеим осям одинаковый, размеры осколков не в масштабе.</figcaption>
</figure>

<style is:global>
	.cml__stage {
		display: grid;
		gap: 0.3rem;
	}
	.cml__svg {
		touch-action: pan-y;
	}
	.cml__time {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
	}
	.cml__controls {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem 1.25rem;
		align-items: start;
	}
	.cml__controls .g7__row,
	.cml__controls .g7__read {
		grid-column: 1 / -1;
	}
	.cml__controls .g7__read {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	@container (max-width: 34rem) {
		.cml__controls,
		.cml__controls .g7__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.cml .g7__read li.is-c {
		box-shadow: inset 3px 0 0 var(--sl-color-white);
	}
	.cml .g7__read li.is-1 {
		box-shadow: inset 3px 0 0 var(--ig-vx);
	}
	.cml .g7__read li.is-2 {
		box-shadow: inset 3px 0 0 var(--ig-vy);
	}
	.cml__svg .cml-ground {
		fill: var(--g7-ground);
	}
	.cml__svg .cml-guide {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.3;
		stroke-dasharray: 5 4;
	}
	.cml__svg .cml-path0 {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.cml__svg .cml-path1 {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2;
	}
	.cml__svg .cml-path2 {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
	}
	.cml__svg .cml-shell {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-1);
	}
	.cml__svg .cml-f1 {
		fill: var(--ig-vx);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.cml__svg .cml-f2 {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.cml__svg .cml-cross {
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.cml__svg .cml-tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.cml__svg .cml-mark {
		stroke-width: 2;
	}
	.cml__svg .cml-mark1 {
		stroke: var(--ig-vx);
	}
	.cml__svg .cml-mark2 {
		stroke: var(--ig-vy);
	}
	.cml__svg .cml-markc {
		stroke: var(--sl-color-white);
	}
	.cml__svg text {
		font-family: var(--__sl-font);
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.cml__svg .cml-t1 {
		fill: var(--ig-vx);
		font-weight: 700;
	}
	.cml__svg .cml-t2 {
		fill: var(--ig-vy);
		font-weight: 700;
	}
	.cml__svg .cml-tc {
		fill: var(--sl-color-white);
		font-weight: 700;
	}
	.cml__svg .cml-gun {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.cml__svg .cml-flash {
		fill: var(--ig-v);
	}
</style>

<script>
	import { loop, fmt, NS } from '../g7/kit';

	const G = 9.8;
	const V0 = 30;
	const VX = V0 * Math.cos(Math.PI / 3); // 15
	const VY = V0 * Math.sin(Math.PI / 3); // 25,98
	const TT = VY / G; // the time to the top, 2,651 s
	const XT = VX * TT; // 39,8 м
	const HT = (VY * VY) / (2 * G); // 34,4 м
	const L = 2 * XT; // 79,5 м
	const TEND = 2 * TT;

	const mk = <K extends keyof SVGElementTagNameMap>(p: Element, tag: K, a: Record<string, string | number> = {}, text?: string) => {
		const e = document.createElementNS(NS, tag) as SVGElementTagNameMap[K];
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		if (text !== undefined) e.textContent = text;
		p.append(e);
		return e;
	};
	const niceStep = (span: number, px: number) => {
		const raw = (span * 60) / Math.max(px, 1);
		const p = 10 ** Math.floor(Math.log10(raw));
		for (const m of [1, 2, 5, 10]) if (m * p >= raw) return m * p;
		return 10 * p;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-cml]')) {
		const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
		const sS = root.querySelector<HTMLInputElement>('[data-s="s"]')!;
		const sV = root.querySelector<HTMLInputElement>('[data-s="v"]')!;
		const oS = root.querySelector<HTMLOutputElement>('[data-o="s"]')!;
		const oV = root.querySelector<HTMLOutputElement>('[data-o="v"]')!;
		const read = root.querySelector<HTMLUListElement>('[data-read]')!;
		const timeEl = root.querySelector<HTMLElement>('[data-time]')!;
		const go = root.querySelector<HTMLButtonElement>('[data-go]')!;

		let t = 0; // model time, s
		let running = false;
		let W = 0;
		let H = 0;
		// the current setting
		let s = 0.5;
		let v1 = 0;
		let v2 = 30;
		let x1 = XT;
		let x2 = XT;
		// the drawing
		let k = 1; // px per м
		let X = (x: number) => x;
		let Y = (y: number) => y;
		let el: {
			path0: SVGPathElement;
			path1: SVGPathElement;
			path2: SVGPathElement;
			shell: SVGCircleElement;
			f1: SVGCircleElement;
			f2: SVGCircleElement;
			cross: SVGPathElement;
			flash: SVGPathElement;
			marks: SVGGElement;
		};

		const setting = () => {
			s = Number(sS.value) / 100;
			v1 = Number(sV.value);
			v2 = (VX - s * v1) / (1 - s);
			x1 = XT + v1 * TT;
			x2 = XT + v2 * TT;
			oS.value = `${Math.round(s * 100)} %`;
			oV.value = `${v1} м/с`;
		};
		const pos = (which: 0 | 1 | 2, tt: number) => {
			// 0: the shell (and the centre of mass after the burst)
			if (which === 0 || tt <= TT) return { x: VX * tt, y: VY * tt - (G * tt * tt) / 2 };
			const d = Math.min(tt, TEND) - TT;
			const vx = which === 1 ? v1 : v2;
			return { x: XT + vx * d, y: HT - (G * d * d) / 2 };
		};
		const pathTo = (which: 0 | 1 | 2, from: number, to: number) => {
			const n = 60;
			let d = '';
			for (let i = 0; i <= n; i++) {
				const p = pos(which, from + ((to - from) * i) / n);
				d += `${i ? 'L' : 'M'}${X(p.x).toFixed(1)} ${Y(p.y).toFixed(1)} `;
			}
			return d;
		};

		const build = () => {
			W = Math.max(280, Math.round(svg.clientWidth || 600));
			svg.replaceChildren();
			const lo = Math.min(0, x1, x2);
			const hi = Math.max(L, x1, x2);
			const padL = 16;
			const padR = 16;
			const top = 30;
			const below = 74; // the axis numbers and up to three rows of landing labels
			const maxH = W < 480 ? 200 : 260;
			k = Math.min((W - padL - padR) / (hi - lo), (maxH - top - below) / HT);
			H = Math.round(top + HT * k + below);
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			const x0 = padL + ((W - padL - padR) - (hi - lo) * k) / 2 - lo * k;
			const y0 = top + HT * k;
			X = (x: number) => x0 + x * k;
			Y = (y: number) => y0 - y * k;
			mk(svg, 'rect', { class: 'cml-ground', x: 0, y: y0, width: W, height: H - y0 });
			// the axis: ticks every nice step
			const step = niceStep(hi - lo, W - padL - padR);
			const unit = mk(svg, 'text', { x: W - 4, y: y0 + 17, 'text-anchor': 'end' });
			mk(unit, 'tspan', { 'font-style': 'italic' }, 'x');
			unit.append(', м');
			const uw = unit.getComputedTextLength() || 30;
			for (let v = Math.ceil(lo / step) * step; v <= hi + 1e-9; v += step) {
				mk(svg, 'line', { class: 'cml-tick', x1: X(v), x2: X(v), y1: y0, y2: y0 + 5 });
				if (X(v) + 14 < W - 8 - uw) mk(svg, 'text', { x: X(v), y: y0 + 17, 'text-anchor': 'middle' }, fmt(v, 0));
			}
			// the cannon at x = 0
			const g = mk(svg, 'g', { transform: `translate(${X(0).toFixed(1)} ${y0}) rotate(-60)` });
			mk(g, 'rect', { class: 'cml-gun', x: -4, y: -3.5, width: 22, height: 7, rx: 2 });
			mk(svg, 'circle', { class: 'cml-gun', cx: X(0), cy: y0 - 2, r: 5 });
			// the parabola of the whole shell (dashed), the paths drawn as the flight goes
			mk(svg, 'path', { class: 'cml-guide', d: pathTo(0, 0, TEND) });
			const path0 = mk(svg, 'path', { class: 'cml-path0' });
			const path1 = mk(svg, 'path', { class: 'cml-path1' });
			const path2 = mk(svg, 'path', { class: 'cml-path2' });
			const marks = mk(svg, 'g', {});
			const flash = mk(svg, 'path', { class: 'cml-flash', opacity: 0 });
			const shell = mk(svg, 'circle', { class: 'cml-shell', r: 5 });
			const r1 = 5 * Math.cbrt(s) / Math.cbrt(0.5) * 0.85;
			const r2 = 5 * Math.cbrt(1 - s) / Math.cbrt(0.5) * 0.85;
			const f1 = mk(svg, 'circle', { class: 'cml-f1', r: r1.toFixed(1) });
			const f2 = mk(svg, 'circle', { class: 'cml-f2', r: r2.toFixed(1) });
			const cross = mk(svg, 'path', { class: 'cml-cross' });
			el = { path0, path1, path2, shell, f1, f2, cross, flash, marks };
			draw();
		};

		const landingLabels = () => {
			el.marks.replaceChildren();
			const y0 = Y(0);
			const items = [
				{ x: x1, cls: '1', sub: '1', v: x1 },
				{ x: x2, cls: '2', sub: '2', v: x2 },
				{ x: L, cls: 'c', sub: 'c', v: L },
			];
			// marks on the ground, labels below the axis numbers in rows that do not overlap
			const rows: [number, number][][] = [[], [], []];
			for (const it of items.sort((a, b) => a.x - b.x)) {
				mk(el.marks, 'line', { class: `cml-mark cml-mark${it.cls}`, x1: X(it.x), x2: X(it.x), y1: y0 - 9, y2: y0 + 3 });
				const t = mk(el.marks, 'text', { class: `cml-t${it.cls}`, x: X(it.x), y: 0, 'text-anchor': 'middle' });
				mk(t, 'tspan', { 'font-style': 'italic' }, 'x');
				mk(t, 'tspan', { dy: 3, 'font-size': 10 }, it.sub);
				mk(t, 'tspan', { dy: -3 }, ` = ${fmt(it.v, 1)} м`);
				const w = t.getComputedTextLength();
				let x = Math.min(Math.max(X(it.x), w / 2 + 2), W - w / 2 - 2);
				t.setAttribute('x', x.toFixed(1));
				let row = rows.findIndex((r) => r.every(([a, b]) => x + w / 2 + 6 < a || x - w / 2 - 6 > b));
				if (row < 0) row = 2;
				rows[row].push([x - w / 2, x + w / 2]);
				t.setAttribute('y', (y0 + 36 + row * 15).toFixed(1));
			}
		};

		const draw = () => {
			const tt = Math.min(t, TEND);
			const burst = tt > TT;
			el.path0.setAttribute('d', pathTo(0, 0, Math.min(tt, TT)));
			el.path1.setAttribute('d', burst ? pathTo(1, TT, tt) : '');
			el.path2.setAttribute('d', burst ? pathTo(2, TT, tt) : '');
			const p0 = pos(0, tt);
			el.shell.setAttribute('cx', X(p0.x).toFixed(1));
			el.shell.setAttribute('cy', Y(p0.y).toFixed(1));
			el.shell.style.display = burst ? 'none' : '';
			const p1 = pos(1, tt);
			const p2 = pos(2, tt);
			for (const [c, p] of [
				[el.f1, p1],
				[el.f2, p2],
			] as const) {
				c.setAttribute('cx', X(p.x).toFixed(1));
				c.setAttribute('cy', Y(p.y).toFixed(1));
				c.style.display = burst ? '' : 'none';
			}
			// the centre of mass of the fragments
			const cx = X(s * p1.x + (1 - s) * p2.x);
			const cy = Y(s * p1.y + (1 - s) * p2.y);
			el.cross.setAttribute('d', burst ? `M${(cx - 5).toFixed(1)} ${(cy - 5).toFixed(1)} l10 10 m0 -10 l-10 10` : '');
			const fl = burst ? Math.max(0, 1 - (tt - TT) / 0.35) : 0;
			el.flash.setAttribute('opacity', fl.toFixed(2));
			el.flash.setAttribute('d', `M${X(XT).toFixed(1)} ${(Y(HT) - 12).toFixed(1)} l3 8 l8 -3 l-5 7 l7 5 l-9 0 l-1 8 l-4 -7 l-7 4 l3 -8 l-7 -4 l8 -1 Z`);
			if (t >= TEND) landingLabels();
			else el.marks.replaceChildren();
			timeEl.textContent = `t = ${fmt(tt, 2)} с`;
		};

		const readout = () => {
			const rows = [
				{ cls: 'is-1', name: 'Скорость первого осколка <i>υ</i><sub>1<i>x</i></sub>', val: `${fmt(v1, 2)} м/с` },
				{ cls: 'is-2', name: 'Скорость второго осколка <i>υ</i><sub>2<i>x</i></sub> = (15 − <i>s</i>·<i>υ</i><sub>1<i>x</i></sub>)/(1 − <i>s</i>)', val: `${fmt(v2, 2)} м/с` },
				{ cls: 'is-1', name: 'Первый осколок упал в точке <i>x</i><sub>1</sub>', val: t >= TEND ? `${fmt(x1, 1)} м` : '—' },
				{ cls: 'is-2', name: 'Второй осколок упал в точке <i>x</i><sub>2</sub>', val: t >= TEND ? `${fmt(x2, 1)} м` : '—' },
				{ cls: 'is-c', name: 'Центр масс <i>x</i><sub>c</sub> = <i>s</i>·<i>x</i><sub>1</sub> + (1 − <i>s</i>)·<i>x</i><sub>2</sub>', val: t >= TEND ? `${fmt(s * x1 + (1 - s) * x2, 1)} м` : '—' },
				{ cls: '', name: 'Целый снаряд упал бы в точке <i>L</i>', val: `${fmt(L, 1)} м` },
			];
			read.innerHTML = rows.map((r) => `<li class="${r.cls}"><span>${r.name}</span><b>${r.val}</b></li>`).join('');
		};

		const reset = () => {
			running = false;
			t = 0;
			setting();
			build();
			readout();
		};
		const wake = loop(svg, (dt) => {
			if (!running) return false;
			t += dt;
			if (t >= TEND) {
				t = TEND;
				running = false;
			}
			draw();
			if (!running) readout();
			return running;
		});
		go.addEventListener('click', () => {
			if (running) return;
			if (t >= TEND || t > 0) {
				t = 0;
				build();
				readout();
			}
			running = true;
			wake();
		});
		for (const inp of [sS, sV]) inp.addEventListener('input', reset);
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
			b.addEventListener('click', () => {
				const [a, v] = b.dataset.preset!.split(',');
				sS.value = a;
				sV.value = v;
				reset();
				running = true;
				wake();
			});
		}
		let lastW = 0;
		new ResizeObserver(() => {
			const w = Math.round(svg.clientWidth);
			if (Math.abs(w - lastW) < 2) return;
			lastW = w;
			build();
		}).observe(svg);
		reset();
	}
</script>
