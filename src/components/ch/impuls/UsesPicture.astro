---
/**
 * Small pictures to «Где это встречается» (static, not to scale), six panels: three in a row on a wide screen, two on a
 * phone. Gold arrows: where a body moves; green: a force.
 * Mat: a high jumper falls on his back onto a thick soft mat, which gives way under him (people kit).
 * Ball: the hands meet the ball and move back with it (the ball's velocity gold, the hands' motion gray).
 * Hammer: a hand (people kit) holds a hammer whose head stops on the head of a nail in a few thousandths of a second;
 *   the force on the nail (green) is large.
 * Fosbury flop: a high jumper (people kit, 175 см) goes over the bar on his back, arched: the head and the arms hang on
 *   one side of the bar, the legs on the other (seen along the bar: the bar is its round end on the post), so his centre
 *   of mass (the cross, computed from the body segments as in the opening scene: head 8,1 %, trunk 49,7 %, arms, thighs
 *   10 %, shins 6,1 %) passes about at the height of the bar, below the body. The kit's trunk is straight, so the arch
 *   is drawn as a bend at the hips; a real jumper arches more and his centre of mass can pass a little under the bar.
 * Balloon: an inflated balloon taped to a straw on a stretched thread; the air rushes out backward, the balloon moves
 *   forward along the thread.
 * Ion engine: a space probe with an ion engine; the blue jet of ions leaves at about 30 км/с, the thrust is less than
 *   0,1 Н, but the engine works for years (Dawn, 2007–2018), and the small force gives a large impulse over a long time.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const ballV = arrow(34, 70, 62, 70, 8, 4);
const fallV = arrow(86, 46, 86, 76, 8, 4);
const handsV = arrow(118, 104, 142, 104, 8, 4);
const balloonV = arrow(112, 34, 148, 34, 8, 4);
const airV = arrow(46, 98, 14, 98, 8, 4);
const hammerV = arrow(112, 48, 112, 74, 8, 4);
const nailF = arrow(84, 92, 84, 122, 8, 4.5);
const probeV = arrow(110, 34, 148, 34, 8, 4);
const stars = [
	[14, 30],
	[40, 118],
	[66, 24],
	[96, 126],
	[150, 104],
	[132, 60],
	[24, 70],
	[146, 128],
];
---

<ImpPicStyles />
<PeopleStyles />
<figure class="ip-pic ip-pic--six not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Прыгун в высоту падает спиной на толстый мягкий мат, мат прогибается под ним">
			<text class="ip-title" x="10" y="20">Мат</text>
			<path class="ip-arrow ip-arrow--v" d={fallV.shaft}></path>
			<polygon class="ip-head--v" points={fallV.head}></polygon>
			<path class="up-mat" d="M 8 96 L 152 96 L 152 128 L 8 128 Z"></path>
			<path class="up-mat-top" d="M 8 96 Q 40 96 52 104 Q 80 116 108 104 Q 120 96 152 96"></path>
			<!-- the jumper lying on his back, sunk into the mat, the arms thrown back (people kit) -->
			<g data-up-jumper></g>
			<path class="up-fold" d="M 30 120 Q 60 112 80 122 M 96 120 Q 116 112 136 120"></path>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Руки ловят летящий мяч и отходят назад вместе с ним">
			<text class="ip-title" x="10" y="20">Ловим мяч</text>
			<path class="ip-arrow ip-arrow--v" d={ballV.shaft}></path>
			<polygon class="ip-head--v" points={ballV.head}></polygon>
			<circle class="up-ball" cx="82" cy="70" r="14"></circle>
			<path class="up-seam" d="M 72 60 Q 82 70 72 80 M 92 60 Q 82 70 92 80"></path>
			<!-- two hands from the right, the palms round the ball from above and from below (people kit) -->
			<g data-up-hands></g>
			<path class="ip-arrow ip-arrow--ext" d={handsV.shaft}></path>
			<polygon class="ip-head--ext" points={handsV.head}></polygon>
			<text class="ip-small" x="112" y="124" text-anchor="middle">руки отходят</text>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Рука держит молоток, его боёк ударяет по шляпке гвоздя. Молоток останавливается за тысячные доли секунды, и сила удара по гвоздю большая">
			<text class="ip-title" x="10" y="20">Молоток</text>
			<!-- the board and the nail -->
			<rect class="up-board" x="10" y="108" width="140" height="20" rx="2"></rect>
			<path class="up-grain" d="M 16 114 Q 60 112 100 116 T 146 114 M 14 122 Q 50 120 90 124 T 148 121"></path>
			<path class="up-nail" d="M 84 88 V 112"></path>
			<path class="up-nail-head" d="M 78 87 H 90"></path>
			<!-- the hammer at the moment of the blow: the handle level, the head's face on the nail -->
			<g class="up-hammer">
				<path class="up-handle" d="M 22 66 H 80"></path>
				<rect class="up-hhead" x="77" y="56" width="14" height="29" rx="2"></rect>
				<path class="up-hface" d="M 76 85 H 92"></path>
			</g>
			<g data-up-hammer-hand></g>
			<path class="up-spark" d="M 74 88 l -7 -4 M 94 88 l 7 -4 M 72 93 l -8 0 M 96 93 l 8 0"></path>
			<path class="ip-arrow ip-arrow--v" d={hammerV.shaft}></path>
			<polygon class="ip-head--v" points={hammerV.head}></polygon>
			<path class="ip-arrow ip-arrow--f" d={nailF.shaft}></path>
			<polygon class="ip-head--f" points={nailF.head}></polygon>
			<text class="ip-math ip-tf" x="76" y="120" text-anchor="end">F</text>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Прыгун в высоту перелетает планку спиной, выгнувшись дугой; планка видна с торца. Голова и руки свисают по одну сторону планки, ноги — по другую. Его центр масс, отмеченный крестиком, проходит почти на уровне планки, ниже спины">
			<text class="ip-title" x="10" y="20">Фосбери-флоп</text>
			<!-- seen along the bar: the bar is its round end on the post -->
			<path class="up-post up-post--far" d="M 94 132 V 59"></path>
			<path class="up-post" d="M 88 132 V 61"></path>
			<g data-up-flop></g>
			<circle class="up-bar" cx="88" cy="57.5" r="3"></circle>
			<path class="up-cm" data-up-cm></path>
			<path class="ip-lead" data-up-cm-lead></path>
			<text class="ip-small" x="40" y="128" text-anchor="middle">центр масс</text>
			<rect class="up-mat up-mat--low" x="6" y="132" width="148" height="8"></rect>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Надутый шарик приклеен к соломинке, надетой на натянутую нитку. Воздух вырывается из шарика назад, а шарик едет по нитке вперёд">
			<text class="ip-title" x="10" y="20">Шарик</text>
			<path class="ip-arrow ip-arrow--v" d={balloonV.shaft}></path>
			<polygon class="ip-head--v" points={balloonV.head}></polygon>
			<line class="up-thread" x1="0" y1="56" x2="160" y2="56"></line>
			<rect class="up-straw" x="76" y="53" width="44" height="6" rx="2"></rect>
			<ellipse class="up-balloon" cx="98" cy="84" rx="38" ry="22"></ellipse>
			<path class="up-balloon" d="M 62 80 L 52 76 L 52 92 L 62 88 Z"></path>
			<path class="up-tape" d="M 84 58 L 84 64 M 112 58 L 112 64"></path>
			<path class="up-air" d="M 50 84 q -8 -6 -16 -2 M 50 88 q -10 2 -20 0 M 50 92 q -8 6 -16 4"></path>
			<path class="ip-arrow ip-arrow--ext" d={airV.shaft}></path>
			<polygon class="ip-head--ext" points={airV.head}></polygon>
			<text class="ip-small" x="34" y="124" text-anchor="middle">воздух</text>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Космический аппарат с ионным двигателем. Из двигателя назад вылетает слабая голубая струя ионов, а аппарат медленно разгоняется вперёд годами">
			<rect class="up-space" x="0" y="0" width="160" height="140"></rect>
			{stars.map(([x, y]) => <circle class="up-star" cx={x} cy={y} r="0.9" />)}
			<text class="ip-title" x="10" y="20">Ионный двигатель</text>
			<path class="ip-arrow ip-arrow--v" d={probeV.shaft}></path>
			<polygon class="ip-head--v" points={probeV.head}></polygon>
			<!-- the ion jet -->
			<path class="up-ion" d="M 70 74 L 8 64 L 8 96 L 70 86 Z"></path>
			<path class="up-ion-core" d="M 70 77 L 26 76 L 26 84 L 70 83 Z"></path>
			<!-- the solar panels (far one behind), the body, the dish, the engine -->
			<path class="up-panel up-panel--far" d="M 100 66 L 112 40 L 150 40 L 138 66 Z"></path>
			<rect class="up-probe" x="82" y="66" width="34" height="28" rx="2"></rect>
			<path class="up-panel" d="M 100 94 L 88 122 L 126 122 L 138 94 Z"></path>
			<path class="up-cells" d="M 94 108 L 132 108 M 107 94 L 95 122 M 119 94 L 107 122"></path>
			<path class="up-dish" d="M 120 72 Q 132 80 120 88 Z"></path>
			<path class="up-engine" d="M 82 74 L 72 72 L 72 88 L 82 86 Z"></path>
			<text class="ip-small" x="40" y="118" text-anchor="middle">ионы</text>
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Золотые стрелки — куда движутся тела, зелёная — сила.</figcaption>
	</div>
</figure>

<style>
	.up-mat {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.up-mat-top {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.up-fold {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.up-ball {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.up-seam {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
	}
	.up-air {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.up-thread {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.up-straw {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.up-balloon {
		fill: color-mix(in srgb, var(--ig-vy) 55%, transparent);
		stroke: var(--ig-vy);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.up-tape {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.up-board {
		fill: color-mix(in oklab, hsl(32, 55%, 55%) 60%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.up-grain {
		fill: none;
		stroke: color-mix(in oklab, hsl(28, 50%, 35%) 60%, var(--sl-color-gray-4));
		stroke-width: 0.8;
	}
	.up-nail {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
	}
	.up-nail-head {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.up-handle {
		stroke: color-mix(in oklab, hsl(30, 55%, 50%) 70%, var(--sl-color-gray-4));
		stroke-width: 6;
		stroke-linecap: round;
	}
	.up-hhead {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.up-hface {
		stroke: var(--sl-color-gray-1);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.up-spark {
		stroke: var(--ig-v);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.up-post {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.up-pin {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.up-bar {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.up-post--far {
		opacity: 0.5;
	}
	.up-cm {
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.up-mat--low {
		opacity: 0.8;
	}
	.up-space {
		fill: color-mix(in oklab, black 55%, var(--sl-color-bg));
	}
	.up-star {
		fill: hsl(0, 0%, 90%);
	}
	.up-ion {
		fill: hsl(210, 100%, 70%);
		opacity: 0.25;
	}
	.up-ion-core {
		fill: hsl(200, 100%, 78%);
		opacity: 0.6;
	}
	.up-probe {
		fill: hsl(40, 70%, 55%);
		stroke: hsl(40, 40%, 30%);
		stroke-width: 1;
	}
	.up-panel {
		fill: hsl(220, 50%, 35%);
		stroke: hsl(220, 30%, 70%);
		stroke-width: 0.8;
	}
	.up-panel--far {
		opacity: 0.7;
	}
	.up-cells {
		stroke: hsl(220, 30%, 70%);
		stroke-width: 0.6;
	}
	.up-dish {
		fill: hsl(0, 0%, 85%);
		stroke: hsl(0, 0%, 50%);
		stroke-width: 0.8;
	}
	.up-engine {
		fill: hsl(0, 0%, 60%);
		stroke: hsl(0, 0%, 35%);
		stroke-width: 0.8;
	}
	.up-space ~ text.ip-small {
		fill: hsl(0, 0%, 85%);
		stroke: hsl(0, 0%, 10%);
	}
	.up-space ~ .ip-title {
		fill: hsl(0, 0%, 95%);
		stroke: hsl(0, 0%, 10%);
	}
</style>

<script>
	import { figure, SKELETON, lerpPt, add, type Pt } from '@components/people';
	import { armHand } from '../elektricheskiy-tok/armHand';

	const D = Math.PI / 180;
	const sleeve = 'color-mix(in oklab, var(--ig-vy) 60%, var(--sl-color-gray-3))';
	// the ball (r = 14 px, about 22 см) between two hands of 25 px: the grip axis at the ball's centre
	for (const g of document.querySelectorAll<SVGGElement>('[data-up-hands]')) {
		const top = armHand(g, { Lh: 25, side: 'L', sleeve });
		const low = armHand(g, { Lh: 25, side: 'L', sleeve });
		top.set({ at: { x: 82, y: 70 }, pose: 'grip', d: 1.1, fore: 172 * D, dir: 180 * D, roll: Math.PI });
		low.set({ at: { x: 82, y: 70 }, pose: 'grip', d: 1.1, fore: -170 * D, dir: 180 * D, roll: 0 });
	}
	// the hammer: a right hand from the upper left grips the handle near its end (grip axis across the palm)
	for (const g of document.querySelectorAll<SVGGElement>('[data-up-hammer-hand]')) {
		const h = armHand(g, { Lh: 22, side: 'R', sleeve: 'color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-3))' });
		// the handle is level, the fingers wrap round it pointing down, the forearm comes from the upper left
		h.set({ at: { x: 38, y: 66 }, pose: 'grip', d: 0.3, fore: 35 * D, dir: 90 * D, roll: -Math.PI / 2, len: 2.2 });
	}
	// the jumper: 175 см, head radius 7 px; on his back (the spine to the left), the knees up, the feet on the mat
	for (const g of document.querySelectorAll<SVGGElement>('[data-up-jumper]')) {
		const u = 7 / 0.064;
		const fig = figure(g, { s: u / 175, H: 175, shirt: 'hm-red', hair: 'short', clothes: 'indoor', prefix: 'hm', shorts: true, name: 'jumper' });
		const lean = -84 * D;
		fig.pose({
			hip: { x: 86, y: 103 },
			lean,
			head: 0.6 * lean,
			ankles: [
				{ x: 122, y: 97 },
				{ x: 128, y: 99 },
			],
			feet: [-0.2, -0.1],
			hands: [
				{ at: { x: 30, y: 84 }, pose: 'open' },
				{ at: { x: 40, y: 82 }, pose: 'open' },
			],
		});
	}
	// the flop: 175 см at 0,54 px per см; the lower back on the bar, head and arms down to the left, legs to the right
	for (const g of document.querySelectorAll<SVGGElement>('[data-up-flop]')) {
		const svg = g.ownerSVGElement!;
		const H = 175;
		const s = 0.54;
		const u = s * H;
		const sk = SKELETON.adult;
		const fig = figure(g, { s, H, shirt: 'hm-gold', hair: 'short', clothes: 'indoor', prefix: 'hm', shorts: true, name: 'flop' });
		const hip: Pt = { x: 88, y: 47 };
		const lean = -112 * D;
		const sh = fig.shoulders(hip, lean);
		const ankles: [Pt, Pt] = [
			{ x: 107, y: 86 },
			{ x: 103, y: 88 },
		];
		const arm = (sk.upper + sk.fore) * u * 0.95;
		const st = fig.pose({
			hip,
			lean,
			head: 0.6 * lean,
			ankles,
			feet: [0.4, 0.5],
			hands: [
				{ at: add(sh[0], { x: -arm * 0.05, y: arm * 0.99 }), pose: 'relaxed' },
				{ at: add(sh[1], { x: arm * 0.1, y: arm * 0.98 }), pose: 'relaxed' },
			],
		});
		// the centre of mass from the body segments
		const spine = { x: Math.sin(lean), y: -Math.cos(lean) };
		const head = add(hip, { x: spine.x * sk.headC * u, y: spine.y * sk.headC * u });
		const neck = add(hip, { x: spine.x * sk.shoulder * u, y: spine.y * sk.shoulder * u });
		const parts: [Pt, number][] = [
			[head, 0.081],
			[lerpPt(hip, neck, 0.5), 0.497],
		];
		for (const i of [0, 1] as const) {
			parts.push([lerpPt(st.shoulders[i], st.elbows[i], 0.44), 0.028]);
			parts.push([lerpPt(st.elbows[i], st.wrists[i], 0.6), 0.022]);
			parts.push([lerpPt(hip, st.knees[i], 0.43), 0.1]);
			parts.push([lerpPt(st.knees[i], ankles[i], 0.55), 0.061]);
		}
		const c = parts.reduce((a, [p, m]) => ({ x: a.x + p.x * m, y: a.y + p.y * m }), { x: 0, y: 0 });
		svg.querySelector('[data-up-cm]')!.setAttribute('d', `M ${(c.x - 4).toFixed(1)} ${(c.y - 4).toFixed(1)} l 8 8 m 0 -8 l -8 8`);
		svg.querySelector('[data-up-cm-lead]')!.setAttribute('d', `M ${(c.x - 5).toFixed(1)} ${(c.y + 5).toFixed(1)} L 40 117`);
	}
</script>
