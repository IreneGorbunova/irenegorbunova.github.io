---
/**
 * Small pictures to «Где это встречается» (not to scale).
 * Mat: a high jumper falls on his back onto a thick soft mat, which gives way under him.
 * Ball: the hands meet the ball and move back with it (arrows: the ball's velocity and the hands' motion).
 * Squid: it swims mantle first; the water jet from its funnel goes the other way, towards the arms.
 * Balloon: an inflated balloon taped to a straw on a stretched thread; the air rushes out backwards, the balloon
 *   moves forwards along the thread.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const ballV = arrow(34, 70, 62, 70, 8, 4);
const fallV = arrow(86, 46, 86, 76, 8, 4);
const handsV = arrow(118, 104, 142, 104, 8, 4);
const squidV = arrow(108, 34, 146, 34, 8, 4);
const jetV = arrow(44, 104, 14, 104, 8, 4);
const balloonV = arrow(112, 34, 148, 34, 8, 4);
const airV = arrow(46, 98, 14, 98, 8, 4);
---

<ImpPicStyles />
<figure class="ip-pic ip-pic--four not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Прыгун в высоту падает спиной на толстый мягкий мат, мат прогибается под ним">
			<text class="ip-title" x="10" y="20">Мат</text>
			<path class="ip-arrow ip-arrow--v" d={fallV.shaft}></path>
			<polygon class="ip-head--v" points={fallV.head}></polygon>
			<path class="up-mat" d="M 8 96 L 152 96 L 152 128 L 8 128 Z"></path>
			<path class="up-mat-top" d="M 8 96 Q 40 96 52 104 Q 80 116 108 104 Q 120 96 152 96"></path>
			<!-- the jumper lying on his back, sunk into the mat -->
			<path class="up-limb" d="M 48 100 L 70 104 L 98 106 M 98 106 L 118 94 L 132 98 M 98 106 L 116 100 L 134 104"></path>
			<path class="up-shirt" d="M 50 100 L 96 106"></path>
			<path class="up-arm" d="M 62 102 L 50 88 L 40 82 M 66 103 L 60 90 L 52 84"></path>
			<circle class="ip-skin" cx="40" cy="96" r="7"></circle>
			<path class="up-fold" d="M 30 120 Q 60 112 80 122 M 96 120 Q 116 112 136 120"></path>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Руки ловят летящий мяч и отходят назад вместе с ним">
			<text class="ip-title" x="10" y="20">Ловим мяч</text>
			<path class="ip-arrow ip-arrow--v" d={ballV.shaft}></path>
			<polygon class="ip-head--v" points={ballV.head}></polygon>
			<circle class="up-ball" cx="82" cy="70" r="14"></circle>
			<path class="up-seam" d="M 72 60 Q 82 70 72 80 M 92 60 Q 82 70 92 80"></path>
			<!-- two hands from the right, palms around the ball -->
			<path class="up-arm2" d="M 154 52 L 112 58 L 98 60"></path>
			<path class="up-arm2" d="M 154 90 L 112 84 L 98 80"></path>
			<path class="up-hand" d="M 98 54 Q 90 56 92 62 L 100 64 Z"></path>
			<path class="up-hand" d="M 98 86 Q 90 84 92 78 L 100 76 Z"></path>
			<path class="ip-arrow ip-arrow--ext" d={handsV.shaft}></path>
			<polygon class="ip-head--ext" points={handsV.head}></polygon>
			<text class="ip-small" x="112" y="124" text-anchor="middle">руки отходят</text>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Кальмар выбрасывает струю воды назад, в сторону щупалец, а сам плывёт вперёд, хвостовой частью тела вперёд">
			<text class="ip-title" x="10" y="20">Кальмар</text>
			<path class="ip-arrow ip-arrow--v" d={squidV.shaft}></path>
			<polygon class="ip-head--v" points={squidV.head}></polygon>
			<!-- the jet of water from the funnel -->
			<path class="up-jet" d="M 62 82 Q 40 78 12 86 Q 30 92 12 100 Q 40 104 62 92 Z"></path>
			<path class="ip-arrow ip-arrow--ext" d={jetV.shaft}></path>
			<polygon class="ip-head--ext" points={jetV.head}></polygon>
			<!-- arms trailing behind -->
			<path class="up-arms" d="M 66 70 Q 46 60 26 66 M 66 74 Q 44 70 22 76 M 66 80 Q 48 82 30 80 M 66 76 Q 40 64 16 58"></path>
			<!-- the mantle with fins, pointing forwards -->
			<path class="up-squid" d="M 64 66 Q 90 58 128 66 L 150 75 L 128 84 Q 90 92 64 84 Q 58 75 64 66 Z"></path>
			<path class="up-fin" d="M 122 66 L 140 54 L 148 74 Z M 122 84 L 140 96 L 148 76 Z"></path>
			<circle class="up-eye" cx="72" cy="72" r="2.6"></circle>
			<path class="up-funnel" d="M 66 82 L 60 88 L 64 92 L 70 86 Z"></path>
			<text class="ip-small" x="40" y="124" text-anchor="middle">вода</text>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 160 140" role="img" aria-label="Надутый шарик приклеен к соломинке, надетой на натянутую нитку. Воздух вырывается из шарика назад, а шарик едет по нитке вперёд">
			<text class="ip-title" x="10" y="20">Шарик</text>
			<path class="ip-arrow ip-arrow--v" d={balloonV.shaft}></path>
			<polygon class="ip-head--v" points={balloonV.head}></polygon>
			<line class="up-thread" x1="0" y1="56" x2="160" y2="56"></line>
			<rect class="up-straw" x="76" y="53" width="44" height="6" rx="2"></rect>
			<ellipse class="up-balloon" cx="98" cy="84" rx="38" ry="22"></ellipse>
			<path class="up-balloon" d="M 62 80 L 52 76 L 52 92 L 62 88 Z"></path>
			<path class="up-tape" d="M 84 58 L 84 64 M 112 58 L 112 64"></path>
			<path class="up-air" d="M 50 84 q -8 -6 -16 -2 M 50 88 q -10 2 -20 0 M 50 92 q -8 6 -16 4"></path>
			<path class="ip-arrow ip-arrow--ext" d={airV.shaft}></path>
			<polygon class="ip-head--ext" points={airV.head}></polygon>
			<text class="ip-small" x="34" y="124" text-anchor="middle">воздух</text>
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Мягкий мат и руки, отходящие назад, растягивают время торможения — сила удара меньше. Кальмар и шарик выбрасывают струю назад и сами движутся вперёд. Стрелки над телами показывают, куда они движутся.</figcaption>
	</div>
</figure>

<style>
	.up-mat {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.up-mat-top {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.up-fold {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.up-limb,
	.up-arm,
	.up-shirt,
	.up-arm2 {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.up-limb {
		stroke: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-3));
		stroke-width: 5;
	}
	.up-shirt {
		stroke: var(--ig-vy);
		stroke-width: 9;
	}
	.up-arm {
		stroke: color-mix(in oklab, var(--ig-vy) 60%, var(--sl-color-gray-3));
		stroke-width: 4;
	}
	.up-arm2 {
		stroke: color-mix(in oklab, var(--ig-vy) 60%, var(--sl-color-gray-3));
		stroke-width: 9;
	}
	.up-hand {
		fill: var(--ip-skin);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.up-ball {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.up-seam {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
	}
	.up-jet,
	.up-air {
		fill: color-mix(in srgb, var(--ig-vx) 30%, transparent);
	}
	.up-air {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.up-arms {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 55%, var(--sl-color-gray-3));
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.up-squid,
	.up-fin {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-2));
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.up-funnel {
		fill: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-3));
	}
	.up-eye {
		fill: var(--sl-color-gray-1);
	}
	.up-thread {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.up-straw {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.up-balloon {
		fill: color-mix(in srgb, var(--ig-vy) 55%, transparent);
		stroke: var(--ig-vy);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.up-tape {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
</style>
