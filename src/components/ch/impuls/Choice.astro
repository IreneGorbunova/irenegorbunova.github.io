---
/**
 * A question with instant feedback. `options` may contain simple inline HTML (<i>, <sub>).
 * The slot is the explanation, shown after the right answer (or on «Показать ответ»).
 * `preset` (optional) adds a button that runs the cart model with these values
 * (the model listens to the window event `imp:collide`).
 */
interface Props {
	question: string;
	options: string[];
	answer: number;
	preset?: { mode: 'elastic' | 'inelastic' | 'burst'; m1: number; v1: number; m2: number; v2: number };
}
const { question, options, answer, preset } = Astro.props;
---

<div class="imp-q not-content" data-imp-q data-answer={answer}>
	<p class="imp-q__question" set:html={question} />
	<div class="imp-q__options" role="group" aria-label="Варианты ответа">
		{
			options.map((o, i) => (
				<button type="button" class="imp-q__opt" data-i={i}>
					<span class="imp-q__mark" aria-hidden="true" />
					<span set:html={o} />
				</button>
			))
		}
	</div>
	<p class="imp-q__verdict" data-verdict aria-live="polite"></p>
	<div class="imp-q__actions">
		<button type="button" class="imp-q__link" data-show hidden>Показать ответ</button>
		{
			preset && (
				<button type="button" class="imp-q__link imp-q__link--model" data-preset={JSON.stringify(preset)}>
					Проверить в модели ↑
				</button>
			)
		}
	</div>
	<div class="imp-q__explain" data-explain hidden>
		<slot />
	</div>
</div>

<style is:global>
	.imp-q {
		margin-block: 1.25rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
	}
	.imp-q i {
		font-family: var(--ig-font-math);
	}
	.imp-q__question {
		margin: 0 0 0.75rem;
		font-weight: 700;
		color: var(--sl-color-white);
		line-height: 1.5;
	}
	.imp-q__options {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 0.5rem;
	}
	.imp-q__opt {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.55rem 0.8rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		line-height: 1.4;
		color: var(--sl-color-gray-1);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.7rem;
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s,
			transform 0.2s;
	}
	.imp-q__opt:hover {
		border-color: var(--sl-color-accent);
	}
	.imp-q__opt:focus-visible,
	.imp-q__link:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.imp-q__mark {
		flex: none;
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 50%;
		border: 2px solid var(--sl-color-gray-4);
		display: grid;
		place-items: center;
		font-size: 0.8rem;
		font-weight: 700;
	}
	.imp-q__opt.is-right {
		border-color: var(--sl-color-green);
		background: var(--sl-color-green-low);
		color: var(--sl-color-white);
	}
	.imp-q__opt.is-right .imp-q__mark {
		border-color: var(--sl-color-green);
		background: var(--sl-color-green);
		color: var(--sl-color-black);
	}
	.imp-q__opt.is-right .imp-q__mark::after {
		content: '✓';
	}
	.imp-q__opt.is-wrong {
		border-color: var(--sl-color-red);
		background: var(--sl-color-red-low);
	}
	.imp-q__opt.is-wrong .imp-q__mark {
		border-color: var(--sl-color-red);
		background: var(--sl-color-red);
		color: var(--sl-color-black);
	}
	.imp-q__opt.is-wrong .imp-q__mark::after {
		content: '×';
	}
	.imp-q__opt.is-shake {
		animation: imp-q-shake 0.4s;
	}
	@keyframes imp-q-shake {
		25% {
			transform: translateX(-4px);
		}
		75% {
			transform: translateX(4px);
		}
	}
	.imp-q__verdict {
		min-height: 1.2em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-gray-2);
	}
	.imp-q__verdict.is-right {
		color: var(--sl-color-green-high);
	}
	.imp-q__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.imp-q__actions:empty {
		display: none;
	}
	.imp-q__link {
		margin: 0.4rem 0 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.imp-q__link:hover {
		border-color: var(--sl-color-accent);
	}
	.imp-q__link[hidden] {
		display: none;
	}
	.imp-q__explain {
		margin-top: 0.6rem;
		padding-top: 0.6rem;
		border-top: 1px dashed var(--sl-color-gray-5);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	.imp-q__explain[hidden] {
		display: none;
	}
	.imp-q__explain p {
		margin: 0.35rem 0;
	}
	.imp-q__explain:not([hidden]) {
		animation: imp-q-in 0.4s ease-out;
	}
	@keyframes imp-q-in {
		from {
			opacity: 0;
			transform: translateY(0.3rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.imp-q__opt.is-shake,
		.imp-q__explain:not([hidden]) {
			animation: none;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-imp-q]')) {
		const answer = Number(root.dataset.answer);
		const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('.imp-q__opt'));
		const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
		const explain = root.querySelector<HTMLElement>('[data-explain]')!;
		const show = root.querySelector<HTMLButtonElement>('[data-show]')!;
		const model = root.querySelector<HTMLButtonElement>('[data-preset]');
		let solved = false;
		const reveal = () => {
			solved = true;
			opts[answer].classList.add('is-right');
			explain.hidden = false;
			show.hidden = true;
		};
		opts.forEach((b, i) =>
			b.addEventListener('click', () => {
				if (solved) return;
				if (i === answer) {
					verdict.textContent = 'Верно!';
					verdict.classList.add('is-right');
					reveal();
				} else {
					b.classList.add('is-wrong');
					b.classList.remove('is-shake');
					void b.offsetWidth;
					b.classList.add('is-shake');
					verdict.textContent = model
						? 'Нет. Подумайте ещё — или проверьте в модели.'
						: 'Нет. Подумайте ещё раз.';
					show.hidden = false;
				}
			}),
		);
		show.addEventListener('click', () => {
			verdict.textContent = '';
			reveal();
		});
		model?.addEventListener('click', () => {
			window.dispatchEvent(new CustomEvent('imp:collide', { detail: JSON.parse(model.dataset.preset!) }));
		});
	}
</script>
