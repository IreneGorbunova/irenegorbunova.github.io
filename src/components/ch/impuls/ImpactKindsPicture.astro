---
/**
 * Picture to the definitions of elastic and inelastic impacts (two looping panels, stacked on a phone; side view).
 * Two balls of the same size are dropped from the same height h (126 px; say 1 м, so the fall lasts 0,45 с) onto a
 * hard floor; the motion is slowed 2 times.
 * Rubber ball: it flattens for a moment (the squash is drawn for 0,12 с of the picture's time; really it lasts a few
 *   thousandths of a second) and bounces up at 0,95 of its speed of impact, so it rises to 0,95² = 0,90 h (113 px).
 *   Its kinetic energy just after the impact is 90 % of that just before; 10 % went into internal energy.
 * Plasticine ball: it flattens into a cake and stays; its kinetic energy all went into internal energy (it warms a
 *   little: for 1 м of fall by about 0,004 °C).
 * Bars (one scale, 96 px = the kinetic energy just before the impact): «перед ударом» — kinetic, violet; «после удара»
 * (shown after the impact) — kinetic violet, the part that went into internal energy red, stacked: the bars are equally
 * tall, the energy does not vanish. Colors: the chapter's tokens (ImpPicStyles), kinetic energy violet, internal red.
 */
import ImpPicStyles from './ImpPicStyles.astro';

const FLOOR = 186;
const R = 13;
const BAR = { x0: 214, x1: 252, w: 24, h: 96, base: 160 };
const panels = [
	{ key: 'rubber', title: 'Резиновый мяч', after: 0.9 },
	{ key: 'clay', title: 'Пластилиновый шар', after: 0 },
];
---

<ImpPicStyles />
<figure class="ip-pic ik not-content" data-ik>
	<div class="ip-pic__grid">
		{
			panels.map((p) => (
				<svg class="ip-pic__svg" viewBox="0 0 300 206" role="img" data-panel={p.key} aria-label={p.key === 'rubber' ? 'Резиновый мяч падает на пол, на миг сплющивается и подпрыгивает почти на ту же высоту. Столбики: кинетическая энергия перед ударом и после удара почти одинаковы, небольшая часть перешла во внутреннюю энергию' : 'Пластилиновый шар того же размера падает с той же высоты, сплющивается в лепёшку и остаётся на полу. Столбики: вся кинетическая энергия, которая была перед ударом, перешла во внутреннюю энергию'}>
					<text class="ip-title" x="14" y="22">{p.title}</text>
					<rect class="ik-floor" x="0" y={FLOOR} width="300" height="20" />
					<path class="ik-hatch" d={Array.from({ length: 24 }, (_, i) => `M ${i * 13} ${FLOOR + 20} l 10 -10`).join(' ')} />
					<line class="ik-floor-top" x1="0" x2="300" y1={FLOOR} y2={FLOOR} />
					<line class="ik-level" x1="40" x2="150" y1={FLOOR - R - 126} y2={FLOOR - R - 126} />
					<text class="ip-small" x="152" y={FLOOR - R - 122}>старт</text>
					{p.key === 'rubber' && <line class="ik-level ik-level--b" x1="40" x2="150" y1={FLOOR - R - 113} y2={FLOOR - R - 113} />}
					{p.key === 'rubber' && <text class="ip-small" x="152" y={FLOOR - R - 108}>отскок</text>}
					<ellipse class={p.key === 'rubber' ? 'ik-rubber' : 'ik-clay'} data-ball cx="92" cy={FLOOR - R} rx={R} ry={R} />
					<g class="ik-bars">
						<rect class="ik-frame" x={BAR.x0} y={BAR.base - BAR.h} width={BAR.w} height={BAR.h} />
						<rect class="ik-ek" x={BAR.x0} y={BAR.base - BAR.h} width={BAR.w} height={BAR.h} />
						<rect class="ik-frame" x={BAR.x1} y={BAR.base - BAR.h} width={BAR.w} height={BAR.h} />
						<g data-after>
							<rect class="ik-ek" x={BAR.x1} y={BAR.base - BAR.h * p.after} width={BAR.w} height={BAR.h * p.after} />
							<rect class="ik-q" x={BAR.x1} y={BAR.base - BAR.h} width={BAR.w} height={BAR.h * (1 - p.after)} />
						</g>
						<text class="ip-small" x={BAR.x0 + BAR.w / 2} y={BAR.base + 13} text-anchor="middle">до</text>
						<text class="ip-small" x={BAR.x1 + BAR.w / 2} y={BAR.base + 13} text-anchor="middle">после</text>
					</g>
				</svg>
			))
		}
	</div>
	<p class="ik-key"><span class="ik-key__ek">■</span> кинетическая энергия <span class="ik-key__q">■</span> перешла во внутреннюю энергию</p>
	<div class="ip-pic__foot">
		<figcaption>Движение замедлено. Столбики — кинетическая энергия шара перед ударом и сразу после него.</figcaption>
	</div>
</figure>

<style>
	.ik-floor {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--sl-color-bg));
	}
	.ik-floor-top {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.ik-hatch {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ik-level {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.ik-level--b {
		stroke: var(--ig-v);
	}
	.ik-rubber {
		fill: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.ik-clay {
		fill: color-mix(in oklab, hsl(100, 45%, 50%) 70%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.ik-frame {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ik-ek {
		fill: var(--imp-ek);
	}
	.ik-q {
		fill: var(--imp-q);
	}
	[data-after] {
		transition: opacity 0.25s;
	}
	.ik-key {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-align: center;
	}
	.ik-key__ek {
		color: var(--imp-ek);
	}
	.ik-key__q {
		color: var(--imp-q);
		margin-inline-start: 0.6rem;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const FLOOR = 186;
	const R = 13;
	const H0 = 126; // px of fall
	const G = (2 * H0) / (0.45 * 2) ** 2; // px/s²: 0,45 s of fall, slowed 2 times
	const TF = Math.sqrt((2 * H0) / G); // 0,9 s
	const SQ = 0.12; // s of the squash
	const E = 0.95; // rubber: the share of the speed kept
	const CYCLE = 4.2;
	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-ik]')) {
		const panels = [...root.querySelectorAll<SVGSVGElement>('svg[data-panel]')].map((svg) => ({
			svg,
			rubber: svg.dataset.panel === 'rubber',
			ball: svg.querySelector<SVGEllipseElement>('[data-ball]')!,
			after: svg.querySelector<SVGGElement>('[data-after]')!,
		}));
		let t = 0;
		const T0 = 0.4; // hanging at the start
		const draw = () => {
			for (const p of panels) {
				const tt = t - T0;
				let y = FLOOR - R - H0; // the centre
				let sx = 1;
				let sy = 1;
				if (tt > 0 && tt < TF) y += 0.5 * G * tt * tt;
				else if (tt >= TF) {
					const ts = tt - TF;
					if (p.rubber) {
						if (ts < SQ) {
							const k = Math.sin((Math.PI * ts) / SQ) * 0.32;
							sy = 1 - k;
							sx = 1 + k * 0.8;
							y = FLOOR - R * sy;
						} else {
							const tb = ts - SQ;
							const v = E * G * TF;
							const h = Math.max(0, v * tb - 0.5 * G * tb * tb);
							y = FLOOR - R - h;
						}
					} else {
						const k = Math.min(1, ts / SQ);
						const e = 1 - (1 - k) * (1 - k);
						sy = 1 - 0.55 * e;
						sx = 1 + 0.7 * e;
						y = FLOOR - R * sy;
					}
				}
				p.ball.setAttribute('cy', f1(y));
				p.ball.setAttribute('rx', f1(R * sx));
				p.ball.setAttribute('ry', f1(R * sy));
				p.after.style.opacity = tt >= TF + 0.05 ? '1' : '0';
			}
		};
		draw();
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		});
	}
</script>
