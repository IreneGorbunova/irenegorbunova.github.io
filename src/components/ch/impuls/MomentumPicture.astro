---
/**
 * Picture to the momentum of a body as a vector (top view of smooth ice, axes Ox and Oy). One momentum scale in both
 * panels: 35,3 px per кг·м/с (3,4 кг·м/с = 120 px); velocity 3,5 px per м/с (20 м/с = 70 px).
 * Panel 1 «Импульс и его проекции» (static): a puck of 0,17 кг slides at 20 м/с at 30° to Ox: p = 3,4 кг·м/с,
 *   p_x = mυ_x = 3,4 cos 30° = 2,94 кг·м/с, p_y = mυ_y = 3,4 sin 30° = 1,70 кг·м/с. The velocity arrow is drawn beside
 *   the momentum arrow (parallel, 12 px aside) so that the two do not cover each other.
 * Panel 2 «Изменение импульса» (a loop of 7 с, slowed: the real push lasts 0,01 с): the puck comes along Ox at
 *   10 м/с (p = 1,7 кг·м/с); the blade of a hockey stick pushes it along Oy; after the push the puck goes at 20 м/с at
 *   60° to Ox (p′ = 3,4 кг·м/с; p′_x = 1,70, p′_y = 2,94 кг·м/с). Then the arrows are laid tip to tail: p + Δp = p′,
 *   Δp = p′ − p = 2,94 кг·м/с along Oy, the direction of the stick's force F (its mean value Δp/Δt = 294 Н; the green
 *   arrow shows its direction, not to scale, and only while the blade touches the puck). The puck moves 100 px/s before the push and 200 px/s after it (speeds
 *   1 : 2 as the real ones).
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const KP = 120 / 3.4; // px per кг·м/с
const KV = 3.5; // px per м/с
const c30 = Math.cos(Math.PI / 6);
const s30 = 0.5;
// panel 1
const O = { x: 56, y: 186 };
const pTip = { x: O.x + KP * 3.4 * c30, y: O.y - KP * 3.4 * s30 };
const p1 = arrow(O.x, O.y, pTip.x, pTip.y, 11, 6);
const vOff = { x: -12 * s30, y: -12 * c30 };
const vTip = { x: O.x + vOff.x + KV * 20 * c30, y: O.y + vOff.y - KV * 20 * s30 };
const v1 = arrow(O.x + vOff.x, O.y + vOff.y, vTip.x, vTip.y, 8, 4);
const px1 = arrow(O.x, O.y, pTip.x, O.y, 9, 5);
const py1 = arrow(O.x, O.y, O.x, pTip.y, 9, 5);
const ax1 = arrow(O.x - 14, O.y, 300, O.y, 8, 4);
const ay1 = arrow(O.x, O.y + 14, O.x, 52, 8, 4);
const arc = (r: number) => `M ${O.x + r} ${O.y} A ${r} ${r} 0 0 0 ${(O.x + r * c30).toFixed(1)} ${(O.y - r * s30).toFixed(1)}`;
// panel 2: the push point and the triangle p + Δp = p′
const H = { x: 96, y: 178 };
const pLen = KP * 1.7;
const dpLen = KP * 2.94;
const pA = { x: H.x + pLen, y: H.y };
const pB = { x: H.x + pLen, y: H.y - dpLen };
const pArr = arrow(H.x, H.y, pA.x, pA.y, 11, 6);
const p2Arr = arrow(H.x, H.y, pB.x, pB.y, 11, 6);
const dpArr = arrow(pA.x, pA.y, pB.x, pB.y, 11, 6);
const fArr = arrow(H.x - 28, H.y + 2, H.x - 28, H.y - 44, 10, 5.5);
const ax2 = arrow(262, 226, 294, 226, 7, 3.5);
const ay2 = arrow(262, 226, 262, 194, 7, 3.5);
const clip = `mp-clip-${Math.random().toString(36).slice(2, 8)}`;
---

<ImpPicStyles />
<figure class="ip-pic mp not-content" data-mp>
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 0 320 240" role="img" aria-label="Шайба на льду, вид сверху. Она скользит со скоростью 20 м/с под углом 30 градусов к оси Ox. Её импульс 3,4 кг·м/с направлен так же, как скорость. Проекции импульса на оси: 2,94 кг·м/с на ось Ox и 1,70 кг·м/с на ось Oy">
			<rect class="mp-ice" x="0" y="0" width="320" height="240" rx="10"></rect>
			<text class="ip-title" x="14" y="22">Импульс и его проекции</text>
			<text class="ip-small" x="14" y="40"><tspan class="ip-math">m</tspan> = 0,17 кг, <tspan class="ip-math">υ</tspan> = 20 м/с</text>
			<path class="ip-arrow ip-axis" d={ax1.shaft}></path>
			<polygon class="mp-axhead" points={ax1.head}></polygon>
			<path class="ip-arrow ip-axis" d={ay1.shaft}></path>
			<polygon class="mp-axhead" points={ay1.head}></polygon>
			<text class="ip-math" x="300" y="206" text-anchor="end">x</text>
			<text class="ip-math" x={O.x - 8} y="60" text-anchor="end">y</text>
			<text class="ip-small" x={O.x - 8} y={O.y + 16} text-anchor="end">O</text>
			<path class="mp-dash" d={`M ${pTip.x.toFixed(1)} ${pTip.y.toFixed(1)} V ${O.y} M ${pTip.x.toFixed(1)} ${pTip.y.toFixed(1)} H ${O.x}`}></path>
			<path class="ip-arrow mp-proj" d={px1.shaft}></path>
			<polygon class="mp-projhead" points={px1.head}></polygon>
			<path class="ip-arrow mp-proj" d={py1.shaft}></path>
			<polygon class="mp-projhead" points={py1.head}></polygon>
			<path class="mp-arc" d={arc(34)}></path>
			<text class="ip-small" x={O.x + 40} y={O.y - 6}>30°</text>
			<ellipse class="mp-puck" cx={O.x} cy={O.y} rx="9" ry="9"></ellipse>
			<path class="ip-arrow ip-arrow--p" d={p1.shaft}></path>
			<polygon class="ip-head--p" points={p1.head}></polygon>
			<path class="ip-arrow ip-arrow--v" d={v1.shaft}></path>
			<polygon class="ip-head--v" points={v1.head}></polygon>
			<text class="ip-tv" x={O.x + 18} y={O.y - 36} text-anchor="end"><tspan class="ip-math">υ</tspan></text>
			<text class="ip-tp" x={pTip.x + 6} y={pTip.y - 4}><tspan class="ip-math">p</tspan> = 3,4 кг·м/с</text>
			<text class="ip-tp" x={(O.x + pTip.x) / 2} y={O.y + 18} text-anchor="middle"><tspan class="ip-math">p</tspan><tspan class="ip-sub" dy="4">x</tspan><tspan dy="-4"> = 2,94 кг·м/с</tspan></text>
			<text class="ip-tp" x={O.x + 6} y={pTip.y - 8}><tspan class="ip-math">p</tspan><tspan class="ip-sub" dy="4">y</tspan><tspan dy="-4"> = 1,70 кг·м/с</tspan></text>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 320 240" role="img" aria-label="Шайба едет вдоль оси Ox со скоростью 10 м/с, клюшка толкает её вдоль оси Oy, и шайба уезжает со скоростью 20 м/с под углом 60 градусов. Стрелки импульсов сложены: импульс до удара плюс изменение импульса равно импульсу после удара. Изменение импульса направлено вдоль оси Oy, как сила удара клюшки">
			<rect class="mp-ice" x="0" y="0" width="320" height="240" rx="10"></rect>
			<text class="ip-title" x="14" y="22">Изменение импульса</text>
			<path class="ip-arrow ip-axis" d={ax2.shaft}></path>
			<polygon class="mp-axhead" points={ax2.head}></polygon>
			<path class="ip-arrow ip-axis" d={ay2.shaft}></path>
			<polygon class="mp-axhead" points={ay2.head}></polygon>
			<text class="ip-math" x="300" y="230">x</text>
			<text class="ip-math" x="268" y="196">y</text>
			<!-- the triangle (appears after the push) -->
			<g class="mp-tri" data-tri>
				<path class="ip-arrow ip-arrow--p mp-pale" d={pArr.shaft}></path>
				<polygon class="ip-head--p mp-pale" points={pArr.head}></polygon>
				<path class="ip-arrow ip-arrow--p" d={p2Arr.shaft}></path>
				<polygon class="ip-head--p" points={p2Arr.head}></polygon>
				<path class="ip-arrow mp-dp" d={dpArr.shaft}></path>
				<polygon class="mp-dphead" points={dpArr.head}></polygon>
				<text class="ip-tp" x={pA.x + 8} y={(pA.y + pB.y) / 2 + 4}>Δ<tspan class="ip-math">p</tspan> = 2,94 кг·м/с</text>
				<text class="ip-tp" x={H.x + 22} y={H.y - 66} text-anchor="end"><tspan class="ip-math">p′</tspan> = 3,4 кг·м/с</text>
			</g>
			<text class="ip-tp" data-plabel x={H.x + pLen / 2} y={H.y + 20} text-anchor="middle"><tspan class="ip-math">p</tspan> = 1,7 кг·м/с</text>
			<!-- the force of the stick on the puck -->
			<g data-force>
				<path class="ip-arrow ip-arrow--f" d={fArr.shaft}></path>
				<polygon class="ip-head--f" points={fArr.head}></polygon>
				<text class="ip-math ip-tf" x={H.x - 36} y={H.y - 30} text-anchor="end">F</text>
			</g>
			<!-- the stick's blade (its shaft goes off to the lower left) and the puck with its riding arrow -->
			<g data-blade>
				<path class="mp-shaft" d="M -14 4 L -70 70"></path>
				<path class="mp-blade" d="M -18 0 Q -20 -5 -14 -6 L 18 -6 Q 22 -5 20 0 Q 18 4 10 4 L -12 4 Q -17 4 -18 0 Z"></path>
			</g>
			<clipPath id={clip}><rect x="0" y="34" width="320" height="206"></rect></clipPath>
			<g clip-path={`url(#${clip})`}><g data-puck>
				<path class="ip-arrow ip-arrow--p" data-ride></path>
				<polygon class="ip-head--p" data-ride-head></polygon>
				<ellipse class="mp-puck" cx="0" cy="0" rx="9" ry="9"></ellipse>
			</g></g>
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Второй рисунок: <i>p</i> + Δ<i>p</i> = <i>p′</i>, изменение импульса направлено так же, как сила удара <i>F</i>; движение замедлено. Стрелки импульсов на обоих рисунках — в одном масштабе.</figcaption>
	</div>
</figure>

<style>
	.mp-ice {
		fill: color-mix(in oklab, var(--ig-vx) 7%, var(--sl-color-bg));
	}
	.mp-axhead {
		fill: var(--sl-color-gray-3);
	}
	.mp-dash {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
		stroke-dasharray: 4 3;
	}
	.mp-proj {
		stroke: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-bg));
		stroke-width: 3.4;
	}
	.mp-projhead {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-bg));
	}
	.mp-arc {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.mp-puck {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
	}
	:root[data-theme='light'] .mp-puck {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-3);
	}
	.mp-pale {
		opacity: 0.45;
	}
	.mp-dp {
		stroke: var(--ig-vx);
		stroke-width: 4;
		stroke-dasharray: 7 4;
	}
	.mp-dphead {
		fill: var(--ig-vx);
	}
	.mp-shaft {
		stroke: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-3));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.mp-blade {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.mp-tri,
	[data-plabel] {
		transition: opacity 0.4s;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-mp]')) {
		const svg = root.querySelectorAll('svg')[1];
		const puck = svg.querySelector<SVGGElement>('[data-puck]')!;
		const ride = svg.querySelector<SVGPathElement>('[data-ride]')!;
		const rideHead = svg.querySelector<SVGPolygonElement>('[data-ride-head]')!;
		const blade = svg.querySelector<SVGGElement>('[data-blade]')!;
		const tri = svg.querySelector<SVGGElement>('[data-tri]')!;
		const force = svg.querySelector<SVGGElement>('[data-force]')!;
		const plabel = svg.querySelector<SVGTextElement>('[data-plabel]')!;
		const KP = 120 / 3.4;
		const H = { x: 96, y: 178 };
		const T_HIT = 1.6;
		const V1 = 100; // px/s before the push
		const V2 = 200; // px/s after it
		const a2 = -Math.PI / 3; // 60° to Ox, up on the screen
		const CYCLE = 7;
		const arrowAt = (x: number, y: number, ang: number, len: number) => {
			const ux = Math.cos(ang);
			const uy = Math.sin(ang);
			const bx = x + ux * (len - 11);
			const by = y + uy * (len - 11);
			ride.setAttribute('d', `M ${f1(x)} ${f1(y)} L ${f1(bx + ux * 1.5)} ${f1(by + uy * 1.5)}`);
			rideHead.setAttribute('points', `${f1(x + ux * len)},${f1(y + uy * len)} ${f1(bx - uy * 6)},${f1(by + ux * 6)} ${f1(bx + uy * 6)},${f1(by - ux * 6)}`);
		};
		let t = 0;
		const draw = () => {
			let x: number;
			let y: number;
			if (t < T_HIT) {
				x = H.x - V1 * (T_HIT - t);
				y = H.y;
				arrowAt(0, 0, 0, KP * 1.7); // in the puck's own coordinates
			} else {
				const d = V2 * (t - T_HIT);
				x = H.x + d * Math.cos(a2);
				y = H.y + d * Math.sin(a2);
				arrowAt(0, 0, a2, KP * 3.4);
			}
			puck.setAttribute('transform', `translate(${f1(x)} ${f1(y)})`);
			// the riding puck is hidden while the triangle is shown
			puck.style.opacity = t > T_HIT + 1.3 ? '0' : '1';
			// the blade comes up from below, pushes the puck for a moment and goes back
			const bt = t - T_HIT;
			const off = bt < -0.4 ? 36 : bt < 0 ? 36 - 25 * ((bt + 0.4) / 0.4) ** 2 : bt < 0.25 ? 11 - 6 * Math.sin((Math.PI * bt) / 0.5) : 11 + 25 * Math.min(1, (bt - 0.25) / 0.6);
			blade.setAttribute('transform', `translate(${H.x} ${(H.y + off).toFixed(1)})`);
			force.style.opacity = bt >= -0.02 && bt < 0.27 ? '1' : '0'; // only while the blade touches the puck
			plabel.style.opacity = t < T_HIT - 0.45 || t > T_HIT + 1.3 ? '1' : '0';
			tri.style.opacity = t > T_HIT + 1.3 ? '1' : '0';
		};
		draw();
		loop(svg, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		});
	}
</script>
