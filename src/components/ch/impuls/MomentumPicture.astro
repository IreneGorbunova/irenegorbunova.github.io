---
/**
 * Picture to the definition of the momentum of a body: three carts with their velocity (thin, gold, 15 px per m/s)
 * and momentum (thick, blue, 18 px per kg·m/s) arrows. 1 kg at 2 m/s: 2 kg·m/s; 2 kg at 2 m/s: 4 kg·m/s; 2 kg at
 * 2 m/s to the left: 4 kg·m/s to the left. One scale for each kind of arrow.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const PV = 15; // px per m/s
const PP = 18; // px per kg·m/s
const rows = [
	{ y: 44, m: 1, v: 2, w: 44, x0: 20, dir: 1, kind: 'ip-cart1' },
	{ y: 114, m: 2, v: 2, w: 66, x0: 20, dir: 1, kind: 'ip-cart1' },
	{ y: 184, m: 2, v: 2, w: 66, x0: 254, dir: -1, kind: 'ip-cart2' },
].map((r) => {
	const front = r.dir > 0 ? r.x0 + r.w + 6 : r.x0 - 6;
	const va = arrow(front, r.y - 8, front + r.dir * PV * r.v, r.y - 8, 8, 4);
	const pa = arrow(front, r.y + 7, front + r.dir * PP * r.m * r.v, r.y + 7, 10, 5.5);
	return { ...r, va, pa, p: r.m * r.v };
});
---

<ImpPicStyles />
<figure class="ip-pic ip-pic--one not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 0 340 216" role="img" aria-label="Три тележки. Тележка массой 1 кг со скоростью 2 м/с имеет импульс 2 кг·м/с. Тележка массой 2 кг с той же скоростью — импульс 4 кг·м/с, вдвое больше. Тележка массой 2 кг, которая едет влево со скоростью 2 м/с, имеет импульс 4 кг·м/с, направленный влево">
			{
				rows.map((r) => (
					<g>
						<line class="ip-track" x1={r.dir > 0 ? 8 : 172} x2={r.dir > 0 ? 168 : 332} y1={r.y + 19} y2={r.y + 19} />
						<rect class={r.kind} x={r.x0} y={r.y - 11} width={r.w} height="22" rx="4" />
						<circle class="ip-wheel" cx={r.x0 + 9} cy={r.y + 14} r="5" />
						<circle class="ip-wheel" cx={r.x0 + r.w - 9} cy={r.y + 14} r="5" />
						<text x={r.x0 + r.w / 2} y={r.y + 4.5} text-anchor="middle">{r.m} кг</text>
						<path class="ip-arrow ip-arrow--v" d={r.va.shaft} />
						<polygon class="ip-head--v" points={r.va.head} />
						<path class="ip-arrow ip-arrow--p" d={r.pa.shaft} />
						<polygon class="ip-head--p" points={r.pa.head} />
						<text class="ip-tv" x={r.dir > 0 ? 176 : 164} y={r.y - 4} text-anchor={r.dir > 0 ? 'start' : 'end'}>
							<tspan class="ip-math">υ</tspan> = {r.v} м/с
						</text>
						<text class="ip-tp" x={r.dir > 0 ? 176 : 164} y={r.y + 15} text-anchor={r.dir > 0 ? 'start' : 'end'}>
							<tspan class="ip-math">p</tspan> = {r.p} кг·м/с
						</text>
					</g>
				))
			}
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Тонкие стрелки — скорости тележек, толстые — их импульсы. При той же скорости у вдвое более тяжёлой тележки импульс вдвое больше. Импульс направлен так же, как скорость: у тележки, которая едет влево, он направлен влево.</figcaption>
	</div>
</figure>
