---
/**
 * Collisions on a plane: two pucks slide on smooth ice (top view, one true scale in metres).
 * Elastic impact of smooth pucks (the impulse acts along the line of centres), perfectly inelastic
 * impact (the pucks stick and move on as one rigid body) or a burst (two pucks held by a latch with a
 * compressed spring between them fly apart). Everything is analytic, see collision2d.ts.
 * Velocities are set by dragging the tips of the momentum arrows, pucks are moved by dragging them.
 * The panel «Сумма импульсов» adds the momentum vectors tip to tail before (pale) and after (bright).
 * Other parts of the page start a preset with the window event `imp:collide2d` (detail: preset key).
 */
const presets = [
	{
		key: 'head',
		label: 'Лобовой удар',
		mode: 'elastic',
		m1: 1,
		m2: 1,
		r1: { x: 0.45, y: 0.75 },
		v1: { x: 1, y: 0 },
		r2: { x: 1.25, y: 0.75 },
		v2: { x: 0, y: 0 },
	},
	{
		key: 'glancing',
		label: 'Скользящий удар равных шайб',
		mode: 'elastic',
		m1: 1,
		m2: 1,
		r1: { x: 0.45, y: 0.75 },
		v1: { x: 1, y: 0 },
		r2: { x: 1.25, y: 0.65 },
		v2: { x: 0, y: 0 },
	},
	{
		key: 'stick',
		label: 'Слипание',
		mode: 'inelastic',
		m1: 2,
		m2: 1,
		r1: { x: 0.3, y: 0.65 },
		v1: { x: 0.6, y: 0 },
		r2: { x: 0.72, y: 0.14 },
		v2: { x: 0, y: 0.6 },
	},
	{
		key: 'shell',
		label: 'Разрыв снаряда',
		mode: 'burst',
		m1: 1,
		m2: 2,
		s0: { x: 0.5, y: 0.75 },
		V: { x: 0.6, y: 0 },
		u1: { x: 0.9, y: 0.6 },
	},
];
---

<figure class="imp-2d not-content" data-imp-2d>
	<div class="imp-2d__modes" role="radiogroup" aria-label="Что происходит с шайбами">
		<button type="button" role="radio" aria-checked="true" data-mode="elastic">Упругий удар</button>
		<button type="button" role="radio" aria-checked="false" data-mode="inelastic">Неупругий (шайбы слипаются)</button>
		<button type="button" role="radio" aria-checked="false" data-mode="burst">Разлёт</button>
	</div>
	<p class="imp-2d__note" data-note></p>

	<div class="imp-2d__stage" data-stage>
		<div class="imp-2d__field-box">
			<svg class="imp-2d__field" data-field role="img" aria-label="Вид сверху на гладкий лёд: две шайбы и стрелки их импульсов"></svg>
			<span class="imp-2d__slowmo" data-slowmo hidden>Замедлено в 4 раза</span>
		</div>
		<div class="imp-2d__buttons">
			<button type="button" class="imp-2d__btn imp-2d__btn--primary" data-run>Пуск</button>
			<button type="button" class="imp-2d__btn" data-reset>Сначала</button>
			<label class="imp-2d__check"><input type="checkbox" data-slow /> <span>Замедленно</span></label>
		</div>
		<div class="imp-2d__panel-box">
			<p class="imp-2d__panel-title">Сумма импульсов</p>
			<svg class="imp-2d__panel" data-panel role="img" aria-label="Стрелки импульсов шайб, сложенные одна за другой, до и после удара"></svg>
			<p class="imp-2d__panel-key">
				<span class="imp-2d__key imp-2d__key--1"></span>шайба 1
				<span class="imp-2d__key imp-2d__key--2"></span>шайба 2
				<span class="imp-2d__key imp-2d__key--s"></span>сумма<br />
				<span data-panel-when>бледные — до удара, яркие — после</span>; клетка — <span class="imp-2d__nw" data-cell></span>
			</p>
		</div>
	</div>

	<p class="imp-2d__live" data-live aria-live="polite"></p>

	<div class="imp-2d__pucks">
		<fieldset class="imp-2d__puck imp-2d__puck--1">
			<legend>Шайба 1</legend>
			<label class="imp-2d__slider">
				<span>Масса <i>m</i><sub>1</sub></span>
				<output data-out="m1"></output>
				<input type="range" min="0.5" max="3" step="0.5" value="1" data-in="m1" />
			</label>
			<p class="imp-2d__speed" data-speed="1"></p>
		</fieldset>
		<fieldset class="imp-2d__puck imp-2d__puck--2">
			<legend>Шайба 2</legend>
			<label class="imp-2d__slider">
				<span>Масса <i>m</i><sub>2</sub></span>
				<output data-out="m2"></output>
				<input type="range" min="0.5" max="3" step="0.5" value="1" data-in="m2" />
			</label>
			<p class="imp-2d__speed" data-speed="2"></p>
		</fieldset>
	</div>
	<p class="imp-2d__hint" data-hint></p>

	<div class="imp-2d__presets">
		<span class="imp-2d__presets-title">Готовые опыты:</span>
		{
			presets.map((p) => (
				<button type="button" class="imp-2d__chip" data-preset={JSON.stringify(p)} data-key={p.key}>
					{p.label}
				</button>
			))
		}
	</div>

	<div class="imp-2d__table-box">
		<table class="imp-2d__table" data-table>
			<thead>
				<tr>
					<th rowspan="2" class="imp-2d__corner">Импульс, кг·м/с</th>
					<th colspan="2" data-th-before>до удара</th>
					<th colspan="2" data-th-after>после удара</th>
				</tr>
				<tr>
					<th><i>p<sub>x</sub></i></th>
					<th><i>p<sub>y</sub></i></th>
					<th><i>p<sub>x</sub></i></th>
					<th><i>p<sub>y</sub></i></th>
				</tr>
			</thead>
			<tbody>
				<tr class="imp-2d__row--1">
					<th>Шайба 1</th>
					<td data-c="b1x"></td>
					<td data-c="b1y"></td>
					<td data-c="a1x"></td>
					<td data-c="a1y"></td>
				</tr>
				<tr class="imp-2d__row--2">
					<th>Шайба 2</th>
					<td data-c="b2x"></td>
					<td data-c="b2y"></td>
					<td data-c="a2x"></td>
					<td data-c="a2y"></td>
				</tr>
				<tr class="imp-2d__row--s">
					<th>Сумма</th>
					<td data-c="bsx"></td>
					<td data-c="bsy"></td>
					<td data-c="asx"></td>
					<td data-c="asy"></td>
				</tr>
				<tr class="imp-2d__row--e">
					<th>Энергия <i>E</i><sub>к</sub>, Дж</th>
					<td colspan="2" data-c="eb"></td>
					<td colspan="2" data-c="ea"></td>
				</tr>
			</tbody>
		</table>
		<p class="imp-2d__after-note" data-after-note></p>
	</div>

	<figcaption class="imp-2d__legend">
		Лёд гладкий, трения нет. Стрелки у шайб — их импульсы <i>p</i> = <i>mυ</i>, все в одном масштабе.
		Ось <i>x</i> направлена вправо, ось <i>y</i> — вверх.
		Опыт кончается, когда шайба доезжает до края льда: бортик толкнул бы её и изменил бы суммарный импульс.
	</figcaption>
</figure>

<style is:global>
	.imp-2d {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-text);
	}
	.imp-2d i {
		font-family: var(--ig-font-math);
	}
	.imp-2d__modes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 1.2rem;
		background: var(--sl-color-gray-6);
		width: fit-content;
		max-width: 100%;
	}
	.imp-2d__modes button {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.4rem 0.95rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background 0.2s,
			color 0.2s;
	}
	.imp-2d__modes button[aria-checked='true'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.imp-2d__modes button:focus-visible,
	.imp-2d__chip:focus-visible,
	.imp-2d__btn:focus-visible,
	.imp-2d .hit:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.imp-2d__note {
		margin: 0.6rem 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		min-height: 3em;
	}
	.imp-2d__stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'field' 'buttons' 'panel';
		gap: 0.75rem;
	}
	.imp-2d__stage.is-wide {
		grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
		grid-template-areas: 'field panel' 'buttons panel';
		align-items: start;
	}
	.imp-2d__field-box {
		grid-area: field;
		position: relative;
		min-width: 0;
	}
	.imp-2d__panel-box {
		grid-area: panel;
		min-width: 0;
	}
	.imp-2d__nw {
		white-space: nowrap;
	}
	.imp-2d__field,
	.imp-2d__panel {
		display: block;
		width: 100%;
		overflow: hidden;
		font-family: var(--__sl-font);
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.imp-2d__panel {
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
	}
	.imp-2d__panel-title {
		margin: 0 0 0.3rem;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.imp-2d__panel-key {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.7;
		color: var(--sl-color-gray-3);
	}
	.imp-2d__key {
		display: inline-block;
		width: 1rem;
		height: 4px;
		margin: 0 0.3rem 0.2rem 0.5rem;
		vertical-align: middle;
		border-radius: 2px;
	}
	.imp-2d__key:first-child {
		margin-left: 0;
	}
	.imp-2d__key--1 {
		background: var(--ig-vx);
	}
	.imp-2d__key--2 {
		background: var(--ig-vy);
	}
	.imp-2d__key--s {
		background: var(--ig-v);
	}
	.imp-2d__slowmo {
		position: absolute;
		top: 0.35rem;
		right: 0.35rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-black);
		background: var(--sl-color-accent);
		pointer-events: none;
	}
	.imp-2d__slowmo[hidden] {
		display: none;
	}

	/* SVG parts */
	.imp-2d text {
		fill: var(--sl-color-gray-2);
	}
	.imp-2d .t-small {
		font-size: 12px;
		fill: var(--sl-color-gray-3);
	}
	.imp-2d .t-math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.imp-2d .t-halo {
		paint-order: stroke;
		stroke: var(--ig-surface);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.imp-2d .t-halo6 {
		paint-order: stroke;
		stroke: var(--sl-color-gray-6);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.imp-2d .ice {
		fill: color-mix(in srgb, var(--ig-vx) 7%, var(--ig-surface));
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.imp-2d .grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
		opacity: 0.55;
	}
	.imp-2d .grid.major {
		opacity: 1;
	}
	.imp-2d .zero {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.imp-2d .tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.imp-2d .c1 {
		fill: var(--ig-vx);
	}
	.imp-2d .c2 {
		fill: var(--ig-vy);
	}
	.imp-2d .cs {
		fill: var(--ig-v);
	}
	.imp-2d text.c1 {
		fill: var(--ig-vx);
	}
	.imp-2d text.c2 {
		fill: var(--ig-vy);
	}
	.imp-2d text.cs {
		fill: var(--ig-v);
	}
	.imp-2d .arrow {
		stroke: var(--ig-surface);
		stroke-width: 1;
		paint-order: stroke;
	}
	.imp-2d__panel .arrow {
		stroke: var(--sl-color-gray-6);
	}
	.imp-2d .pale {
		opacity: 0.38;
	}
	.imp-2d .plan {
		opacity: 0.6;
	}
	.imp-2d .puck1 {
		fill: color-mix(in srgb, var(--ig-vx) 24%, var(--ig-surface));
		stroke: var(--ig-vx);
		stroke-width: 2;
	}
	.imp-2d .puck2 {
		fill: color-mix(in srgb, var(--ig-vy) 24%, var(--ig-surface));
		stroke: var(--ig-vy);
		stroke-width: 2;
	}
	.imp-2d .latch {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.imp-2d .ghost {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.3;
		stroke-dasharray: 4 3;
	}
	.imp-2d .centres {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 6 4;
	}
	.imp-2d .trail {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 1 5;
	}
	.imp-2d .trail.t1 {
		stroke: var(--ig-vx);
	}
	.imp-2d .trail.t2 {
		stroke: var(--ig-vy);
	}
	.imp-2d .trail.ts {
		stroke: var(--ig-v);
		stroke-dasharray: 6 5;
		stroke-width: 1.5;
	}
	.imp-2d .cm {
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.imp-2d .knob {
		fill: var(--ig-surface);
		stroke-width: 2.5;
		pointer-events: none;
	}
	.imp-2d .knob.k1 {
		stroke: var(--ig-vx);
	}
	.imp-2d .knob.k2 {
		stroke: var(--ig-vy);
	}
	.imp-2d .knob.ks {
		stroke: var(--ig-v);
	}
	.imp-2d .knob.parked {
		stroke-dasharray: 3 2.5;
	}
	.imp-2d .hit {
		fill: transparent;
		stroke: none;
		cursor: grab;
		touch-action: none;
		outline: none;
	}
	.imp-2d .hit.disc {
		cursor: move;
	}
	.imp-2d.is-dragging .hit {
		cursor: grabbing;
	}
	.imp-2d .tip-label {
		font-size: 13px;
		font-weight: 600;
		fill: var(--sl-color-white);
	}
	.imp-2d .flash {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.5;
	}
	.imp-2d .right-angle {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
	}
	.imp-2d .end-ring {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.6;
	}
	.imp-2d .origin {
		fill: var(--sl-color-white);
	}

	/* controls */
	.imp-2d__buttons {
		grid-area: buttons;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}
	.imp-2d__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.5rem 1.2rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.imp-2d__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.imp-2d__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.imp-2d__check {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.imp-2d__check input {
		accent-color: var(--sl-color-accent);
		width: 1.05rem;
		height: 1.05rem;
		margin: 0;
	}
	.imp-2d__live {
		min-height: 3em;
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.imp-2d__live b {
		color: var(--sl-color-white);
	}
	.imp-2d__pucks {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}
	.imp-2d__puck {
		margin: 0;
		padding: 0.4rem 0.8rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-left-width: 4px;
		border-radius: 0.6rem;
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}
	.imp-2d__puck--1 {
		border-left-color: var(--ig-vx);
	}
	.imp-2d__puck--2 {
		border-left-color: var(--ig-vy);
	}
	.imp-2d__puck legend {
		padding: 0 0.3rem;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.imp-2d__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.15rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.imp-2d__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.imp-2d__slider input {
		grid-column: 1 / -1;
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.imp-2d__speed {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.imp-2d__speed b {
		color: var(--sl-color-white);
	}
	.imp-2d__hint {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.imp-2d__presets {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.75rem;
	}
	.imp-2d__presets-title {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-right: 0.2rem;
	}
	.imp-2d__chip {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-1);
		cursor: pointer;
	}
	.imp-2d__chip:hover {
		border-color: var(--sl-color-accent);
	}

	/* readouts */
	.imp-2d__table-box {
		margin-top: 0.85rem;
		padding-top: 0.75rem;
		border-top: 1px dashed var(--sl-color-gray-5);
	}
	.imp-2d__table {
		display: table;
		width: 100%;
		margin: 0;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
	}
	.imp-2d__table th,
	.imp-2d__table td {
		padding: 0.25rem 0.4rem;
		border: 0;
		border-bottom: 1px solid var(--sl-color-gray-5);
		text-align: right;
		white-space: nowrap;
		background: transparent;
	}
	.imp-2d__table thead th {
