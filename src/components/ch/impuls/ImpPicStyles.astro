---
/** Frame and common marks of the explanatory pictures of «Импульс» (panels, caption, arrows). Renders nothing. */
---

<style is:global>
	.ip-pic {
		--ip-p: var(--ig-vx); /* momentum */
		--ip-v: var(--ig-v); /* velocity */
		--ip-f: hsl(150, 60%, 58%); /* forces between the bodies */
		--ip-ext: var(--sl-color-gray-2); /* external forces */
		--ip-body1: color-mix(in srgb, var(--ig-vx) 22%, var(--ig-surface));
		--ip-body2: color-mix(in srgb, var(--ig-vy) 22%, var(--ig-surface));
		--ip-skin: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-2));
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .ip-pic {
		--ip-f: hsl(150, 70%, 30%);
		--ip-skin: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.ip-pic__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.ip-pic--one .ip-pic__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 30rem;
		margin-inline: auto;
	}
	.ip-pic--four .ip-pic__grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}
	.ip-pic__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.ip-pic text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.ip-pic .ip-title {
		font-size: 14px;
		font-weight: 600;
		fill: var(--sl-color-gray-1);
	}
	.ip-pic .ip-math {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 16px;
	}
	.ip-pic .ip-sub {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 11px;
	}
	.ip-pic .ip-small {
		font-size: 11.5px;
	}
	.ip-pic .ip-tp {
		fill: var(--ip-p);
		font-weight: 700;
	}
	.ip-pic .ip-tv {
		fill: var(--ip-v);
		font-weight: 700;
	}
	.ip-pic .ip-tf {
		fill: var(--ip-f);
		font-weight: 700;
	}
	.ip-pic__foot {
		margin-top: 0.6rem;
	}
	.ip-pic__foot figcaption {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.ip-pic__foot figcaption i {
		font-family: var(--ig-font-math);
	}
	.ip-arrow {
		fill: none;
		stroke-linecap: round;
	}
	.ip-arrow--p {
		stroke: var(--ip-p);
		stroke-width: 4;
	}
	.ip-arrow--v {
		stroke: var(--ip-v);
		stroke-width: 2.2;
	}
	.ip-arrow--f {
		stroke: var(--ip-f);
		stroke-width: 3.2;
	}
	.ip-arrow--ext {
		stroke: var(--ip-ext);
		stroke-width: 2.4;
	}
	.ip-head--p {
		fill: var(--ip-p);
	}
	.ip-head--v {
		fill: var(--ip-v);
	}
	.ip-head--f {
		fill: var(--ip-f);
	}
	.ip-head--ext {
		fill: var(--ip-ext);
	}
	.ip-cart1 {
		fill: var(--ip-body1);
		stroke: var(--ig-vx);
		stroke-width: 2;
	}
	.ip-cart2 {
		fill: var(--ip-body2);
		stroke: var(--ig-vy);
		stroke-width: 2;
	}
	.ip-wheel {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.ip-track {
		stroke: var(--sl-color-gray-4);
		stroke-width: 2;
	}
	.ip-lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
		fill: none;
	}
	.ip-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.3;
		fill: none;
	}
	.ip-skin {
		fill: var(--ip-skin);
	}
	@media (max-width: 40rem) {
		.ip-pic__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.ip-pic--four .ip-pic__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
