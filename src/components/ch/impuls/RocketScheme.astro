---
/**
 * School scheme of a liquid-fuel rocket (not to scale): payload under the nose cone, the oxidizer and fuel tanks,
 * the combustion chamber, the nozzle and the jet of gas. Above: the momenta of the rocket and of the gas thrown out,
 * equal in length and opposite (the system was at rest).
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const Y = 104;
const pR = arrow(198, 64, 254, 64, 10, 5.5);
const pG = arrow(66, 64, 10, 64, 10, 5.5);
const labels = [
	{ t: 'сопло', x: 88, y: 162, px: 88, py: 118 },
	{ t: 'бак с горючим', x: 174, y: 162, px: 174, py: 120 },
	{ t: 'полезный груз', x: 294, y: 162, px: 302, py: 112 },
	{ t: 'камера сгорания', x: 121, y: 186, px: 121, py: 114 },
	{ t: 'бак с окислителем', x: 246, y: 186, px: 238, py: 120 },
];
---

<ImpPicStyles />
<figure class="ip-pic ip-pic--one not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 0 340 198" role="img" aria-label="Схема ракеты: полезный груз под обтекателем, баки с окислителем и горючим, камера сгорания, сопло и струя газа. Импульс ракеты направлен вперёд, импульс газа — назад, они равны по модулю">
			<!-- the jet of gas -->
			<path class="rs-jet" d={`M 72 ${Y - 13} Q 40 ${Y - 22} 6 ${Y - 10} Q 20 ${Y} 6 ${Y + 10} Q 40 ${Y + 22} 72 ${Y + 13} Z`}></path>
			<path class="rs-core" d={`M 72 ${Y - 7} Q 50 ${Y - 9} 30 ${Y} Q 50 ${Y + 9} 72 ${Y + 7} Z`}></path>
			<!-- fins -->
			<path class="rs-fin" d={`M 104 ${Y - 20} L 92 ${Y - 40} L 132 ${Y - 20} Z`}></path>
			<path class="rs-fin" d={`M 104 ${Y + 20} L 92 ${Y + 40} L 132 ${Y + 20} Z`}></path>
			<!-- the body and the nose cone -->
			<rect class="rs-body" x="100" y={Y - 20} width="190" height="40" rx="3"></rect>
			<path class="rs-body" d={`M 290 ${Y - 20} Q 318 ${Y - 18} 330 ${Y} Q 318 ${Y + 18} 290 ${Y + 20} Z`}></path>
			<rect class="rs-load" x="294" y={Y - 10} width="18" height="20" rx="3"></rect>
			<!-- tanks -->
			<rect class="rs-fuel" x="142" y={Y - 15} width="66" height="30" rx="8"></rect>
			<rect class="rs-ox" x="214" y={Y - 15} width="70" height="30" rx="8"></rect>
			<!-- pipes to the chamber -->
			<path class="rs-pipe" d={`M 142 ${Y - 6} L 136 ${Y - 6} M 214 ${Y + 10} L 210 ${Y + 10} L 210 ${Y + 17} L 138 ${Y + 17} L 136 ${Y + 6}`}></path>
			<!-- the combustion chamber and the nozzle -->
			<rect class="rs-chamber" x="106" y={Y - 11} width="30" height="22" rx="6"></rect>
			<path class="rs-nozzle" d={`M 106 ${Y - 6} L 72 ${Y - 16} L 72 ${Y + 16} L 106 ${Y + 6} Z`}></path>
			<!-- momenta -->
			<path class="ip-arrow ip-arrow--p" d={pR.shaft}></path>
			<polygon class="ip-head--p" points={pR.head}></polygon>
			<text class="ip-small ip-tp" x="226" y="52" text-anchor="middle">импульс ракеты</text>
			<path class="ip-arrow ip-arrow--p" d={pG.shaft}></path>
			<polygon class="ip-head--p" points={pG.head}></polygon>
			<text class="ip-small ip-tp" x="38" y="52" text-anchor="middle">импульс газа</text>
			<text class="ip-small" x="38" y="142" text-anchor="middle">струя газа</text>
			{
				labels.map((l) => (
					<g>
						<path class="ip-lead" d={`M ${l.px} ${l.py} L ${l.x} ${l.y - 13}`} />
						<text class="ip-small" x={l.x} y={l.y} text-anchor="middle">{l.t}</text>
					</g>
				))
			}
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Схема ракеты. Горючее и окислитель из баков поступают в камеру сгорания. Раскалённый газ с большой скоростью вырывается из сопла назад, а ракета получает такой же по модулю импульс вперёд.</figcaption>
	</div>
</figure>

<style>
	.rs-body {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.rs-fin {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.rs-load {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.rs-fuel {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--ig-surface));
		stroke: var(--ig-v);
		stroke-width: 1.4;
	}
	.rs-ox {
		fill: color-mix(in srgb, var(--ig-vx) 30%, var(--ig-surface));
		stroke: var(--ig-vx);
		stroke-width: 1.4;
	}
	.rs-pipe {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.rs-chamber {
		fill: color-mix(in srgb, var(--ig-vy) 35%, var(--ig-surface));
		stroke: var(--ig-vy);
		stroke-width: 1.4;
	}
	.rs-nozzle {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.rs-jet {
		fill: color-mix(in srgb, var(--ig-vy) 45%, transparent);
	}
	.rs-core {
		fill: var(--ig-v);
	}
</style>
