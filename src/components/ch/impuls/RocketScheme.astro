---
/**
 * School scheme of a liquid-fuel rocket (not to scale): payload under the nose cone, the oxidizer and fuel tanks,
 * the combustion chamber, the nozzle and the jet of gas. The jet is drawn as portions of gas that leave the nozzle one
 * after another (a loop: a portion every 0,5 с of the picture): each portion Δm leaves at the speed u relative to the
 * rocket (gold arrow) and the gas pushes the rocket forward with the reactive force F_р (green arrow). Letters only:
 * the numbers belong to the worked task of the section. Not to scale.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const Y = 104;
const Fr = arrow(196, 56, 280, 56, 11, 6);
const uA = arrow(66, 134, 14, 134, 8, 4);
const labels = [
	{ t: 'сопло', x: 88, y: 162, px: 88, py: 118 },
	{ t: 'бак с горючим', x: 174, y: 162, px: 174, py: 120 },
	{ t: 'полезный груз', x: 294, y: 162, px: 302, py: 112 },
	{ t: 'камера сгорания', x: 121, y: 186, px: 121, py: 114 },
	{ t: 'бак с окислителем', x: 246, y: 186, px: 238, py: 120 },
];
---

<ImpPicStyles />
<figure class="ip-pic ip-pic--one not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 18 340 180" role="img" aria-label="Схема ракеты: полезный груз под обтекателем, баки с окислителем и горючим, камера сгорания, сопло и струя газа. Порции газа массой Δm вылетают из сопла назад со скоростью u относительно ракеты, а газ толкает ракету вперёд с реактивной силой">
			<!-- the jet of gas -->
			<path class="rs-jet" d={`M 72 ${Y - 13} Q 40 ${Y - 22} 6 ${Y - 10} Q 20 ${Y} 6 ${Y + 10} Q 40 ${Y + 22} 72 ${Y + 13} Z`}></path>
			<path class="rs-core" d={`M 72 ${Y - 7} Q 50 ${Y - 9} 30 ${Y} Q 50 ${Y + 9} 72 ${Y + 7} Z`}></path>
			<!-- fins -->
			<path class="rs-fin" d={`M 104 ${Y - 20} L 92 ${Y - 40} L 132 ${Y - 20} Z`}></path>
			<path class="rs-fin" d={`M 104 ${Y + 20} L 92 ${Y + 40} L 132 ${Y + 20} Z`}></path>
			<!-- the body and the nose cone -->
			<rect class="rs-body" x="100" y={Y - 20} width="190" height="40" rx="3"></rect>
			<path class="rs-body" d={`M 290 ${Y - 20} Q 318 ${Y - 18} 330 ${Y} Q 318 ${Y + 18} 290 ${Y + 20} Z`}></path>
			<rect class="rs-load" x="294" y={Y - 10} width="18" height="20" rx="3"></rect>
			<!-- tanks -->
			<rect class="rs-fuel" x="142" y={Y - 15} width="66" height="30" rx="8"></rect>
			<rect class="rs-ox" x="214" y={Y - 15} width="70" height="30" rx="8"></rect>
			<!-- pipes to the chamber -->
			<path class="rs-pipe" d={`M 142 ${Y - 6} L 136 ${Y - 6} M 214 ${Y + 10} L 210 ${Y + 10} L 210 ${Y + 17} L 138 ${Y + 17} L 136 ${Y + 6}`}></path>
			<!-- the combustion chamber and the nozzle -->
			<rect class="rs-chamber" x="106" y={Y - 11} width="30" height="22" rx="6"></rect>
			<path class="rs-nozzle" d={`M 106 ${Y - 6} L 72 ${Y - 16} L 72 ${Y + 16} L 106 ${Y + 6} Z`}></path>
			<!-- the portions of gas, the speed of the gas relative to the rocket, the reactive force -->
			<g data-puffs>{[0, 1, 2, 3].map(() => <circle class="rs-puff" cx="-20" cy={Y} r="7" />)}</g>
			<text class="ip-small" x="10" y="40">порция газа Δ<tspan class="ip-math">m</tspan></text>
			<path class="ip-lead" d={`M 30 44 L 36 ${Y - 12}`}></path>
			<path class="ip-arrow ip-arrow--v" d={uA.shaft}></path>
			<polygon class="ip-head--v" points={uA.head}></polygon>
			<text class="ip-tv" x="18" y="150"><tspan class="ip-math">u</tspan></text>
			<path class="ip-arrow ip-arrow--f" d={Fr.shaft}></path>
			<polygon class="ip-head--f" points={Fr.head}></polygon>
			<text class="ip-small ip-tf" x="238" y="40" text-anchor="middle"><tspan class="ip-math">F</tspan><tspan class="ip-sub" dy="4">р</tspan></text>
			{
				labels.map((l) => (
					<g>
						<path class="ip-lead" d={`M ${l.px} ${l.py} L ${l.x} ${l.y - 13}`} />
						<text class="ip-small" x={l.x} y={l.y} text-anchor="middle">{l.t}</text>
					</g>
				))
			}
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Схема ракеты (не в масштабе). Порции газа Δ<i>m</i> вылетают из сопла назад со скоростью <i>u</i> относительно ракеты, а газ толкает ракету вперёд с реактивной силой <i>F</i><sub>р</sub>.</figcaption>
	</div>
</figure>

<style>
	.rs-body {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--sl-color-bg));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.rs-fin {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.rs-load {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.rs-fuel {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--ig-surface));
		stroke: var(--ig-v);
		stroke-width: 1.4;
	}
	.rs-ox {
		fill: color-mix(in srgb, var(--ig-vx) 30%, var(--ig-surface));
		stroke: var(--ig-vx);
		stroke-width: 1.4;
	}
	.rs-pipe {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.rs-chamber {
		fill: color-mix(in srgb, var(--ig-vy) 35%, var(--ig-surface));
		stroke: var(--ig-vy);
		stroke-width: 1.4;
	}
	.rs-nozzle {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.rs-jet {
		fill: color-mix(in srgb, var(--ig-vy) 45%, transparent);
	}
	.rs-core {
		fill: var(--ig-v);
	}
	.rs-puff {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 40%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	// portions of gas leave the nozzle (x = 72) one after another every 0,5 s and fly back, fading
	for (const g of document.querySelectorAll<SVGGElement>('[data-puffs]')) {
		const puffs = [...g.querySelectorAll<SVGCircleElement>('circle')];
		let t = 0;
		loop(g.ownerSVGElement!, (dt) => {
			t = (t + dt) % 2;
			puffs.forEach((c, i) => {
				const a = (t + i * 0.5) % 2; // age, s
				c.setAttribute('cx', (66 - a * 40).toFixed(1));
				c.setAttribute('r', (6 + a * 3).toFixed(1));
				c.setAttribute('opacity', Math.max(0, 1 - a / 2).toFixed(2));
			});
			return true;
		});
	}
</script>
