---
/**
 * Picture to the definition of the centre of mass (static): a dumbbell on the axis Ox — balls of 1 кг at x₁ = 1 м and
 * 3 кг at x₂ = 5 м on a light rod (44 px per м). The centre of mass x_c = (1 · 1 + 3 · 5) / (1 + 3) = 4 м (a cross);
 * it divides the rod 3 м : 1 м, inversely to the masses: 1 кг · 3 м = 3 кг · 1 м. The balls' sizes grow as the cube
 * root of the mass (same material): radii 9 and 13 px; they are not to the scale of the axis.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const K = 44; // px per м
const X0 = 34; // x = 0
const Y = 96; // the rod
const X = (m: number) => X0 + K * m;
const ax = arrow(X0 - 10, 150, 316, 150, 8, 4);
const dim = (a: number, b: number, y: number) => `M ${X(a)} ${y - 4} V ${y + 4} M ${X(b)} ${y - 4} V ${y + 4} M ${X(a)} ${y} H ${X(b)}`;
---

<ImpPicStyles />
<figure class="ip-pic ip-pic--one cm not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 20 330 180" role="img" aria-label="Гантель на оси Ox: шар массой 1 кг в точке x = 1 м и шар массой 3 кг в точке x = 5 м на лёгком стержне. Центр масс отмечен крестиком в точке x = 4 м: от него до лёгкого шара 3 м, до тяжёлого 1 м">
			<!-- the rod and the balls -->
			<line class="cm-rod" x1={X(1)} x2={X(5)} y1={Y} y2={Y}></line>
			<circle class="ip-cart1 cm-ball" cx={X(1)} cy={Y} r="9"></circle>
			<circle class="ip-cart2 cm-ball" cx={X(5)} cy={Y} r="13"></circle>
			<text class="ip-small" x={X(1)} y={Y - 16} text-anchor="middle"><tspan class="ip-math">m</tspan><tspan class="ip-sub" dy="4">1</tspan><tspan dy="-4"> = 1 кг</tspan></text>
			<text class="ip-small" x={X(5)} y={Y - 20} text-anchor="middle"><tspan class="ip-math">m</tspan><tspan class="ip-sub" dy="4">2</tspan><tspan dy="-4"> = 3 кг</tspan></text>
			<!-- the centre of mass -->
			<path class="cm-cross" d={`M ${X(4) - 6} ${Y - 6} L ${X(4) + 6} ${Y + 6} M ${X(4) - 6} ${Y + 6} L ${X(4) + 6} ${Y - 6}`}></path>
			<text class="ip-small cm-tc" x={X(4) + 2} y={Y - 18} text-anchor="end">центр масс</text>
			<!-- the distances -->
			<path class="cm-dim" d={dim(1, 4, 122)}></path>
			<path class="cm-dim" d={dim(4, 5, 122)}></path>
			<text class="ip-small" x={X(2.5)} y="116" text-anchor="middle">3 м</text>
			<text class="ip-small" x={X(4.5)} y="116" text-anchor="middle">1 м</text>
			<!-- the axis -->
			<path class="ip-arrow ip-axis" d={ax.shaft}></path>
			<polygon class="cm-axhead" points={ax.head}></polygon>
			{[0, 1, 2, 3, 4, 5, 6].map((m) => <line class="cm-tick" x1={X(m)} x2={X(m)} y1="146" y2="154" />)}
			{[0, 1, 2, 3, 4, 5, 6].map((m) => <text class="ip-small" x={X(m)} y="168" text-anchor="middle">{m}</text>)}
			<text class="ip-small" x="318" y="140" text-anchor="end"><tspan class="ip-math">x</tspan>, м</text>
			<path class="cm-drop" d={`M ${X(1)} ${Y + 10} V 146 M ${X(4)} ${Y + 7} V 146 M ${X(5)} ${Y + 14} V 146`}></path>
			<text class="ip-small" x="165" y="192" text-anchor="middle">1 кг · 3 м = 3 кг · 1 м</text>
			<text class="ip-small" x={X(1) - 2} y="40" text-anchor="start"><tspan class="ip-math">x</tspan><tspan class="ip-sub" dy="4">c</tspan><tspan dy="-4"> = (1 · 1 + 3 · 5) / (1 + 3) = 4 м</tspan></text>
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Шары нарисованы не в масштабе оси.</figcaption>
	</div>
</figure>

<style>
	.cm-rod {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.cm-cross {
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.cm-tc {
		fill: var(--sl-color-white) !important;
		font-weight: 700;
	}
	.cm-dim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.cm-axhead {
		fill: var(--sl-color-gray-3);
	}
	.cm-tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.cm-drop {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
</style>
