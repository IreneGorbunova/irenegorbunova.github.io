---
/** A button that runs the cart model (CollisionLab) with the given values. */
interface Props {
	preset: { mode: 'elastic' | 'inelastic' | 'burst'; m1: number; v1: number; m2: number; v2: number };
	label?: string;
}
const { preset, label = 'Проверить в модели ↑' } = Astro.props;
---

<button type="button" class="imp-try not-content" data-imp-try={JSON.stringify(preset)}>{label}</button>

<style is:global>
	.imp-try {
		margin: 0.25rem 0 0.5rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.4rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-accent);
		background: transparent;
		color: var(--sl-color-text-accent);
		cursor: pointer;
	}
	.imp-try:hover {
		background: var(--sl-color-accent-low);
	}
	.imp-try:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
</style>

<script>
	for (const b of document.querySelectorAll<HTMLButtonElement>('[data-imp-try]')) {
		b.addEventListener('click', () =>
			window.dispatchEvent(new CustomEvent('imp:collide', { detail: JSON.parse(b.dataset.impTry!) })),
		);
	}
</script>
