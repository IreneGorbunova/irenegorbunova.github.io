---
/**
 * Picture to the impulse of a force: the same egg falls from the same height onto a tiled floor and onto a pillow.
 * Below each, the force on the egg against time during the stop: a real impact is a pulse that rises and falls,
 * drawn as a half sine, F = F_max sin(πt/τ). The area under each pulse is the change of the egg's momentum, the same
 * in both: 640 px² (half sine: (2/π)·F_max·τ; tile τ = 10 px, F_max = 100,5 px; pillow τ = 80 px, F_max = 12,6 px).
 * Dashed: the mean force over the same time, a rectangle of the same area (10 × 64 and 80 × 8 px), F_ср = Δp/Δt.
 * The stop on the pillow lasts 8 times longer, so the mean force is 8 times smaller. Same axes in both graphs; the
 * scales are not given (only the ratio matters).
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const O = { x: 40, y: 232 }; // origin of the graphs
const tAx = arrow(O.x, O.y, 304, O.y, 8, 4);
const fAx = arrow(O.x, O.y, O.x, 110, 8, 4);
const AREA = 640;
const pulse = (tau: number) => {
	const Fm = (AREA * Math.PI) / (2 * tau);
	const pts = Array.from({ length: 41 }, (_, i) => {
		const t = (tau * i) / 40;
		return `${(O.x + 0.8 + t).toFixed(1)} ${(O.y - Fm * Math.sin((Math.PI * t) / tau)).toFixed(1)}`;
	});
	return { line: `M ${pts.join(' L ')}`, area: `M ${pts.join(' L ')} Z`, mean: AREA / tau, Fm };
};
const panels = [
	{
		key: 'tile',
		title: 'Кафельный пол',
		tau: 10,
		note: ['удар короткий —', 'сила большая'],
		nx: 74,
		ny: 128,
		areaL: { x: 74, y: 210, to: [47, 218] },
		meanL: { x: 74, y: 176, to: [52, 170] },
	},
	{
		key: 'pillow',
		title: 'Подушка',
		tau: 80,
		note: ['удар долгий —', 'сила маленькая'],
		nx: 150,
		ny: 150,
		areaL: { x: 150, y: 214, to: [112, 228] },
		meanL: { x: 150, y: 196, to: [118, 223] },
	},
].map((p) => ({ ...p, ...pulse(p.tau) }));
---

<ImpPicStyles />
<figure class="ip-pic not-content">
	<div class="ip-pic__grid">
		{
			panels.map((p) => (
				<svg class="ip-pic__svg" viewBox="0 0 320 246" role="img" aria-label={p.key === 'tile' ? 'Яйцо упало на кафельный пол и разбилось. График: сила удара большая, но действует очень короткое время' : 'Такое же яйцо упало на подушку и осталось целым. График: сила маленькая, но действует долго. Площади под двумя графиками одинаковые'}>
					<text class="ip-title" x="14" y="22">{p.title}</text>
					{p.key === 'tile' ? (
						<g>
							<rect class="ep-tile" x="0" y="92" width="320" height="16" />
							{[40, 100, 160, 220, 280].map((x) => <line class="ep-seam" x1={x} x2={x} y1="92" y2="108" />)}
							<ellipse class="ep-white" cx="164" cy="91" rx="34" ry="5" />
							<circle class="ep-yolk" cx="166" cy="89" r="7" />
							<path class="ep-shell" d="M 136 90 Q 132 76 142 68 L 146 75 L 150 70 L 152 90 Z" />
							<path class="ep-shell" d="M 178 90 Q 196 82 192 70 L 186 74 L 183 68 L 174 88 Z" />
							<path class="ep-drop" d="M 128 86 l -6 -4 M 200 84 l 7 -5 M 122 90 l -8 0 M 206 89 l 8 -1" />
						</g>
					) : (
						<g>
							<path class="ep-pillow" d="M 90 106 Q 84 84 104 76 Q 140 70 152 80 Q 164 88 176 80 Q 190 70 226 76 Q 246 84 240 106 Z" />
							<path class="ep-seam" d="M 104 86 Q 108 96 104 102 M 226 86 Q 222 96 226 102" />
							<ellipse class="ep-egg" cx="164" cy="66" rx="13" ry="17" />
							<path class="ep-shine" d="M 158 56 Q 160 52 164 52" />
						</g>
					)}
					<path class="ip-arrow ip-axis" d={tAx.shaft} />
					<polygon class="ep-axhead" points={tAx.head} />
					<path class="ip-arrow ip-axis" d={fAx.shaft} />
					<polygon class="ep-axhead" points={fAx.head} />
					<text class="ip-math" x="21" y="124">F</text>
					<text class="ip-math" x="300" y="226" text-anchor="end">t</text>
					<path class="ep-area" d={p.area} />
					<path class="ep-pulse" d={p.line} />
					<rect class="ep-mean" x={O.x + 0.8} y={O.y - p.mean} width={p.tau} height={p.mean} />
					<text class="ip-small" x={p.nx} y={p.ny}>{p.note[0]}</text>
					<text class="ip-small" x={p.nx} y={p.ny + 14}>{p.note[1]}</text>
					<path class="ip-lead" d={`M ${p.areaL.x - 3} ${p.areaL.y - 4} L ${p.areaL.to[0]} ${p.areaL.to[1]}`} />
					<text class="ip-small ep-tarea" x={p.areaL.x} y={p.areaL.y}>площадь = Δ<tspan class="ip-math">p</tspan></text>
					<path class="ip-lead" d={`M ${p.meanL.x - 3} ${p.meanL.y - 4} L ${p.meanL.to[0]} ${p.meanL.to[1]}`} />
					<text class="ip-small" x={p.meanL.x} y={p.meanL.y}>средняя сила</text>
				</svg>
			))
		}
	</div>
	<div class="ip-pic__foot">
		<figcaption>Площади под графиками одинаковые и равны изменению импульса яйца; пунктир — средняя сила. О подушку яйцо тормозит в 8&nbsp;раз дольше, и средняя сила в 8&nbsp;раз меньше.</figcaption>
	</div>
</figure>

<style>
	.ep-tile {
		fill: color-mix(in oklab, var(--ig-vx) 15%, var(--sl-color-gray-5));
	}
	.ep-seam {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		fill: none;
	}
	.ep-egg,
	.ep-shell {
		fill: var(--ip-skin);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .ep-egg,
	:root[data-theme='light'] .ep-shell {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-black));
		stroke: var(--sl-color-gray-2);
	}
	:root[data-theme='light'] .ep-pillow {
		fill: color-mix(in oklab, var(--ig-vx) 28%, var(--sl-color-black));
	}
	.ep-shine {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
		stroke-linecap: round;
		opacity: 0.6;
	}
	.ep-white {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 35%, transparent);
	}
	.ep-yolk {
		fill: var(--ig-v);
	}
	.ep-drop {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.ep-pillow {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.ep-axhead {
		fill: var(--sl-color-gray-3);
	}
	.ep-area {
		fill: color-mix(in srgb, var(--ig-vx) 35%, transparent);
	}
	.ep-pulse {
		fill: none;
		stroke: var(--ip-f);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.ep-mean {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-dasharray: 4 3;
	}
	.ep-tarea {
		fill: var(--ig-vx) !important;
		font-weight: 700;
	}
</style>
