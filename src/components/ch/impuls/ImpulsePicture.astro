---
/**
 * Picture to the impulse of a force: the same egg falls from the same height onto a tiled floor and onto a pillow.
 * Below each, the force on the egg against time as a rectangle (the force taken constant during the stop). Both
 * rectangles have the same area, 640 px² (8 × 80 and 64 × 10): the change of the egg's momentum is the same, the time
 * of the stop on the pillow is 8 times longer and the force 8 times smaller. Same axes in both graphs.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const O = { x: 40, y: 206 }; // origin of the graphs
const tAx = arrow(O.x, O.y, 304, O.y, 8, 4);
const fAx = arrow(O.x, O.y, O.x, 116, 8, 4);
const panels = [
	{ key: 'tile', title: 'Кафельный пол', w: 8, h: 80, note: ['удар короткий —', 'сила большая'], nx: 60, ny: 150 },
	{ key: 'pillow', title: 'Подушка', w: 64, h: 10, note: ['удар долгий —', 'сила маленькая'], nx: 112, ny: 176 },
];
---

<ImpPicStyles />
<figure class="ip-pic not-content">
	<div class="ip-pic__grid">
		{
			panels.map((p) => (
				<svg class="ip-pic__svg" viewBox="0 0 320 222" role="img" aria-label={p.key === 'tile' ? 'Яйцо упало на кафельный пол и разбилось. График: сила удара большая, но действует очень короткое время' : 'Такое же яйцо упало на подушку и осталось целым. График: сила маленькая, но действует долго. Площади прямоугольников на двух графиках одинаковые'}>
					<text class="ip-title" x="14" y="22">{p.title}</text>
					{p.key === 'tile' ? (
						<g>
							<rect class="ep-tile" x="0" y="92" width="320" height="16" />
							{[40, 100, 160, 220, 280].map((x) => <line class="ep-seam" x1={x} x2={x} y1="92" y2="108" />)}
							<ellipse class="ep-white" cx="164" cy="91" rx="34" ry="5" />
							<circle class="ep-yolk" cx="166" cy="89" r="7" />
							<path class="ep-shell" d="M 136 90 Q 132 76 142 68 L 146 75 L 150 70 L 152 90 Z" />
							<path class="ep-shell" d="M 178 90 Q 196 82 192 70 L 186 74 L 183 68 L 174 88 Z" />
							<path class="ep-drop" d="M 128 86 l -6 -4 M 200 84 l 7 -5 M 122 90 l -8 0 M 206 89 l 8 -1" />
						</g>
					) : (
						<g>
							<path class="ep-pillow" d="M 90 106 Q 84 84 104 76 Q 140 70 152 80 Q 164 88 176 80 Q 190 70 226 76 Q 246 84 240 106 Z" />
							<path class="ep-seam" d="M 104 86 Q 108 96 104 102 M 226 86 Q 222 96 226 102" />
							<ellipse class="ep-egg" cx="164" cy="66" rx="13" ry="17" />
							<path class="ep-shine" d="M 158 56 Q 160 52 164 52" />
						</g>
					)}
					<path class="ip-arrow ip-axis" d={tAx.shaft} />
					<polygon class="ep-axhead" points={tAx.head} />
					<path class="ip-arrow ip-axis" d={fAx.shaft} />
					<polygon class="ep-axhead" points={fAx.head} />
					<text class="ip-math" x="50" y="126">F</text>
					<text class="ip-math" x="300" y="200" text-anchor="end">t</text>
					<rect class="ep-rect" x={O.x + 0.8} y={O.y - p.h} width={p.w} height={p.h} />
					<text class="ip-small" x={p.nx} y={p.ny}>{p.note[0]}</text>
					<text class="ip-small" x={p.nx} y={p.ny + 14}>{p.note[1]}</text>
					<path class="ip-lead" d={p.key === 'tile' ? 'M 58 156 L 50 160' : 'M 110 180 L 100 197'} />
				</svg>
			))
		}
	</div>
	<div class="ip-pic__foot">
		<figcaption>Одинаковые яйца упали с одной и той же высоты, поэтому изменение импульса у них одно и то же. На графиках — сила, которая останавливает яйцо. Площади закрашенных прямоугольников одинаковые: о подушку яйцо тормозит в 8&nbsp;раз дольше, поэтому сила в 8&nbsp;раз меньше.</figcaption>
	</div>
</figure>

<style>
	.ep-tile {
		fill: color-mix(in oklab, var(--ig-vx) 15%, var(--sl-color-gray-5));
	}
	.ep-seam {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		fill: none;
	}
	.ep-egg,
	.ep-shell {
		fill: var(--ip-skin);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .ep-egg,
	:root[data-theme='light'] .ep-shell {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-black));
		stroke: var(--sl-color-gray-2);
	}
	:root[data-theme='light'] .ep-pillow {
		fill: color-mix(in oklab, var(--ig-vx) 28%, var(--sl-color-black));
	}
	.ep-shine {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
		stroke-linecap: round;
		opacity: 0.6;
	}
	.ep-white {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 35%, transparent);
	}
	.ep-yolk {
		fill: var(--ig-v);
	}
	.ep-drop {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.ep-pillow {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.ep-axhead {
		fill: var(--sl-color-gray-3);
	}
	.ep-rect {
		fill: color-mix(in srgb, var(--ig-vx) 35%, transparent);
		stroke: var(--ig-vx);
		stroke-width: 1.6;
	}
</style>
