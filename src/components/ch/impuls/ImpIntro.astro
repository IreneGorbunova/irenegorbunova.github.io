---
/**
 * Two short looping opening scenes of «Импульс. Закон сохранения импульса». No terms of the chapter in the pictures;
 * the captions' popovers explain.
 * Billiards (top view): the cue strikes the white ball; it slides straight at the red ball of the same mass and hits
 *   it dead centre. The white ball stops at the point of impact, the red one goes on along the same line with the same
 *   speed (110 px/s for both) and drops into the corner pocket. Rolling friction is left out.
 * Boat (side view, 40 px per m): a boy (50 kg, 1,6 m) crouches in a boat (100 kg, 3 m) and jumps onto the pier. During
 *   the 0,2 s push he gets 2 m/s horizontally and the boat 1 m/s backwards (equal and opposite momenta); he flies
 *   0,7 s on a parabola (g = 9,8 m/s², the pier is 0,35 m above the boat floor) and lands on the pier. The water slows
 *   the boat afterwards (its speed decays with a time constant of 4 s). The arrows of the two speeds are 2 : 1.
 * Plays only while visible.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mArrow = `ii-ar-${uid}`;
// Billiards: the table cloth and the pockets
const T = { x0: 22, y0: 30, x1: 338, y1: 210 };
const POCKETS = [
	[T.x0, T.y0],
	[180, T.y0 - 2],
	[T.x1, T.y0],
	[T.x0, T.y1],
	[180, T.y1 + 2],
	[T.x1, T.y1],
];
// Boat: the water surface and the pier
const WL = 172;
const PIER = { x: 266, y: 150 };
---

<IntroFrame data-impintro>
	<div class="intro__card" data-scene="billiards">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Бильярдный стол, вид сверху. Кий ударяет белый шар, он катится к красному шару и ударяет его точно в центр. Белый шар останавливается на месте удара, а красный катится дальше с той же скоростью и падает в лузу">
			<defs>
				<marker id={mArrow} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="ii-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<rect class="ii-rail" x="0" y="8" width="360" height="224" rx="14"></rect>
			<rect class="ii-cloth" x={T.x0} y={T.y0} width={T.x1 - T.x0} height={T.y1 - T.y0} rx="4"></rect>
			{[70, 125, 235, 290].map((x) => <circle class="ii-diamond" cx={x} cy="19" r="2" />)}
			{[70, 125, 235, 290].map((x) => <circle class="ii-diamond" cx={x} cy="221" r="2" />)}
			{POCKETS.map(([x, y]) => <circle class="ii-pocket" cx={x} cy={y} r="12" />)}
			<!-- the red ball: drops into the pocket -->
			<g data-red>
				<circle class="ii-shadow" cx="1.5" cy="2" r="9"></circle>
				<circle class="ii-red" cx="0" cy="0" r="9"></circle>
				<circle class="ii-shine" cx="-3" cy="-3" r="2.4"></circle>
			</g>
			<g data-white>
				<circle class="ii-shadow" cx="1.5" cy="2" r="9"></circle>
				<circle class="ii-white" cx="0" cy="0" r="9"></circle>
				<circle class="ii-shine" cx="-3" cy="-3" r="2.4"></circle>
			</g>
			<line class="ii-varrow" data-varrow marker-end={`url(#${mArrow})`}></line>
			<!-- the cue, drawn along the line of the shot -->
			<g data-cue>
				<line class="ii-cue" x1="-260" y1="0" x2="-12" y2="0"></line>
				<line class="ii-cue-tip" x1="-16" y1="0" x2="-11" y2="0"></line>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Шар ударяет точно в центр такого же неподвижного шара и останавливается как вкопанный, а второй шар <More term="катится дальше с его скоростью">Шары одинаковые, и при ударе первый шар передаёт второму всё своё движение — весь свой импульс. То же происходит с одинаковыми тележками в модели раздела <a href="#закон-сохранения-импульса">«Закон сохранения импульса»</a>. На бильярде так получается, если в момент удара первый шар скользит по сукну, не вращаясь: для этого кием бьют чуть ниже центра шара.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="boat">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Мальчик стоит в лодке у причала. Он приседает и прыгает на причал, а лодка в тот же момент отплывает назад, в другую сторону, вдвое медленнее, чем летит мальчик">
			<defs>
				<marker id={`${mArrow}b`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
					<path class="ii-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<rect class="ii-sky" x="0" y="0" width="360" height={WL}></rect>
			<path class="ii-shore" d={`M 0 ${WL} L 0 ${WL - 26} Q 40 ${WL - 40} 96 ${WL - 30} Q 130 ${WL - 22} 160 ${WL} Z`}></path>
			<!-- the pier -->
			{[PIER.x + 10, PIER.x + 62, PIER.x + 114].map((x) => <rect class="ii-post" x={x} y={PIER.y} width="8" height={240 - PIER.y} />)}
			<rect class="ii-deck" x={PIER.x} y={PIER.y} width={360 - PIER.x} height="8"></rect>
			{[PIER.x + 26, PIER.x + 52, PIER.x + 78].map((x) => <line class="ii-plank" x1={x} y1={PIER.y + 1} x2={x} y2={PIER.y + 7} />)}
			<!-- the boy -->
			<g data-boy>
				<path class="ii-leg" data-legs></path>
				<line class="ii-torso" data-torso></line>
				<path class="ii-arm" data-arms></path>
				<circle class="ii-skin" data-headc r="6.5"></circle>
			</g>
			<!-- the boat -->
			<g data-boat>
				<path class="ii-hull-in" d="M 4 -18 L 116 -18 L 112 -8 L 8 -8 Z"></path>
				<path class="ii-hull" d="M 0 -18 L 120 -18 L 108 4 Q 104 10 96 10 L 18 10 Q 10 10 6 4 Z"></path>
				<line class="ii-gunwale" x1="0" y1="-18" x2="120" y2="-18"></line>
				<line class="ii-seat" x1="52" y1="-11" x2="70" y2="-11"></line>
			</g>
			<path class="ii-water" data-water></path>
			<path class="ii-surf" data-surf></path>
			<line class="ii-varrow" data-vboy marker-end={`url(#${mArrow}b)`}></line>
			<line class="ii-varrow" data-vboat marker-end={`url(#${mArrow}b)`}></line>
		</svg>
		<div class="intro__foot">
			<p>Мальчик прыгает с лодки на причал, а лодка в тот же миг <More term="отплывает назад">Отталкиваясь от лодки, мальчик толкает и её: они действуют друг на друга с равными силами в противоположные стороны. Лодка (100 кг) вдвое тяжелее мальчика (50 кг), поэтому отплывает вдвое медленнее: 1 м/с против его 2 м/с. Расчёт — в задаче 2 раздела <a href="#пример-задачи">«Пример задачи»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.ii-rail {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
	}
	.ii-cloth {
		fill: color-mix(in oklab, color-mix(in oklch decreasing hue, var(--ig-vx) 50%, var(--ig-v)) 50%, var(--ig-surface));
		stroke: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke-width: 3;
	}
	.ii-diamond {
		fill: var(--sl-color-gray-2);
	}
	.ii-pocket {
		fill: var(--sl-color-black);
	}
	:root[data-theme='light'] .ii-pocket {
		fill: var(--sl-color-white);
	}
	.ii-shadow {
		fill: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
	}
	:root[data-theme='light'] .ii-shadow {
		fill: color-mix(in srgb, var(--sl-color-white) 25%, transparent);
	}
	.ii-white {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	:root[data-theme='light'] .ii-white {
		fill: var(--sl-color-black);
	}
	.ii-red {
		fill: var(--ig-vy);
		stroke: color-mix(in srgb, var(--ig-vy) 60%, var(--sl-color-gray-5));
		stroke-width: 0.8;
	}
	.ii-shine {
		fill: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
	}
	:root[data-theme='light'] .ii-shine {
		fill: color-mix(in srgb, var(--sl-color-black) 70%, transparent);
	}
	.ii-cue {
		stroke: color-mix(in oklab, var(--ig-v) 70%, var(--sl-color-gray-2));
		stroke-width: 5;
		stroke-linecap: round;
	}
	.ii-cue-tip {
		stroke: var(--ig-vx);
		stroke-width: 4;
	}
	.ii-varrow {
		stroke: var(--ig-v);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.ii-head {
		fill: var(--ig-v);
	}
	/* boat scene */
	.ii-sky {
		fill: color-mix(in srgb, var(--ig-vx) 12%, transparent);
	}
	.ii-shore {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.ii-water {
		fill: color-mix(in srgb, var(--ig-vx) 40%, transparent);
	}
	.ii-surf {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, var(--sl-color-white));
		stroke-width: 1.6;
	}
	.ii-post,
	.ii-deck {
		fill: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-4));
	}
	.ii-plank {
		stroke: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-gray-5));
		stroke-width: 1;
	}
	.ii-hull {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
		stroke: color-mix(in oklab, var(--ig-vy) 30%, var(--sl-color-gray-3));
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.ii-hull-in {
		fill: color-mix(in oklab, var(--ig-vy) 25%, var(--sl-color-gray-5));
	}
	.ii-gunwale {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.ii-seat {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.ii-leg,
	.ii-arm,
	.ii-torso {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ii-leg {
		stroke: color-mix(in oklab, var(--ig-vx) 70%, var(--sl-color-gray-3));
		stroke-width: 5.5;
	}
	.ii-torso {
		stroke: var(--ig-v);
		stroke-width: 9;
	}
	.ii-arm {
		stroke: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-2));
		stroke-width: 3.6;
	}
	.ii-skin {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-2));
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-impintro]')) {
		// ---------- Billiards: 3,5 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="billiards"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const white = $<SVGGElement>('[data-white]');
			const red = $<SVGGElement>('[data-red]');
			const cue = $<SVGGElement>('[data-cue]');
			const arrow = $<SVGLineElement>('[data-varrow]');
			// the line of the shot: from the white ball to the corner pocket
			const A0 = [64, 62];
			const P = [334, 206];
			const L = Math.hypot(P[0] - A0[0], P[1] - A0[1]);
			const d = [(P[0] - A0[0]) / L, (P[1] - A0[1]) / L];
			const ang = (Math.atan2(d[1], d[0]) * 180) / Math.PI;
			const at = (s: number) => [A0[0] + d[0] * s, A0[1] + d[1] * s];
			const R = 9;
			const SB = 170; // the red ball on the line
			const SC = SB - 2 * R; // the white ball stops here
			const V = 110; // px/s, the same for both balls
			const RUN = 3.5;
			const tHit = 0.62; // the cue touches the white ball
			const tC = tHit + SC / V; // the balls collide
			const place = (g: SVGGElement, s: number) => {
				const [x, y] = at(s);
				g.setAttribute('transform', `translate(${f1(x)} ${f1(y)})`);
			};
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the cue: drawn back, strikes, then slowly withdraws
				let back = 4;
				if (t < 0.5) back = 4 + 26 * ease(t / 0.5);
				else if (t < tHit) back = 30 - 26 * ((t - 0.5) / (tHit - 0.5));
				else back = 4 + 30 * ease((t - tHit) / 0.8);
				const [cx, cy] = at(-back);
				cue.setAttribute('transform', `translate(${f1(cx)} ${f1(cy)}) rotate(${ang.toFixed(2)})`);
				cue.style.opacity = t > tHit + 0.6 ? String(Math.max(0, 1 - (t - tHit - 0.6) / 0.4)) : '1';
				// the white ball slides to the red one and stops there
				const sW = t < tHit ? 0 : Math.min(SC, V * (t - tHit));
				place(white, sW);
				// the red ball goes on with the same speed and drops into the pocket
				const sR = t < tC ? SB : Math.min(L, SB + V * (t - tC));
				place(red, sR);
				const left = L - sR;
				const inPocket = left < 14 ? Math.max(0, left / 14) : 1;
				red.setAttribute('transform', `${red.getAttribute('transform')} scale(${(0.55 + 0.45 * inPocket).toFixed(2)})`);
				red.style.opacity = left < 1 ? '0' : String(0.35 + 0.65 * inPocket);
				// the speed arrow in front of whichever ball moves
				const moving = t > tHit && t < tC ? sW : t >= tC && left > 22 ? sR : -1;
				if (moving < 0) arrow.style.opacity = '0';
				else {
					const [x1, y1] = at(moving + R + 4);
					const [x2, y2] = at(moving + R + 30);
					arrow.setAttribute('x1', f1(x1));
					arrow.setAttribute('y1', f1(y1));
					arrow.setAttribute('x2', f1(x2));
					arrow.setAttribute('y2', f1(y2));
					arrow.style.opacity = '1';
				}
			});
		}

		// ---------- Boat: 5 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="boat"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const boat = $<SVGGElement>('[data-boat]');
			const legs = $<SVGPathElement>('[data-legs]');
			const arms = $<SVGPathElement>('[data-arms]');
			const torso = $<SVGLineElement>('[data-torso]');
			const head = $<SVGCircleElement>('[data-headc]');
			const water = $<SVGPathElement>('[data-water]');
			const surf = $<SVGPathElement>('[data-surf]');
			const vBoy = $<SVGLineElement>('[data-vboy]');
			const vBoat = $<SVGLineElement>('[data-vboat]');
			const K = 40; // px per m
			const WL = 172;
			const FLOOR = WL - 6; // the boat floor
			const DECK = 150; // the pier
			const BX0 = 120; // the left end of the boat at the start
			const X0 = 222; // the boy's feet at the start
			const t1 = 0.6; // crouching starts
			const t2 = 1.0; // the push starts
			const TP = 0.2; // the push lasts
			const t3 = t2 + TP; // take-off
			const TF = 0.7; // flight
			const t4 = t3 + TF; // landing
			const U = 2; // m/s, the boy
			const W = 1; // m/s, the boat (backwards)
			const TAU = 4; // s, the water slows the boat
			const G = 9.8;
			const H = (FLOOR - DECK) / K; // m, the pier above the floor
			const VY = (H + (G * TF * TF) / 2) / TF; // vertical speed at take-off
			const RUN = 5;
			// the boat's shift backwards (m) at time t
			const boatShift = (t: number) => {
				if (t < t2) return 0;
				if (t < t3) return (0.5 * (W / TP) * (t - t2) ** 2);
				return 0.5 * W * TP + W * TAU * (1 - Math.exp(-(t - t3) / TAU));
			};
			const boatSpeed = (t: number) => (t < t2 ? 0 : t < t3 ? (W * (t - t2)) / TP : W * Math.exp(-(t - t3) / TAU));
			// the boy: feet position (px) and how much he crouches
			const boy = (t: number) => {
				if (t < t2) return { x: X0, y: FLOOR, c: ease((t - t1) / (t2 - t1)), fly: 0 };
				if (t < t3) {
					const tt = t - t2;
					const sx = 0.5 * (U / TP) * tt * tt; // the body moves forward during the push
					return { x: X0 + sx * K, y: FLOOR, c: 1 - tt / TP, fly: 0 };
				}
				const x3 = X0 + 0.5 * U * TP * K;
				if (t < t4) {
					const tt = t - t3;
					return { x: x3 + U * tt * K, y: FLOOR - (VY * tt - (G * tt * tt) / 2) * K, c: 0, fly: Math.sin((Math.PI * tt) / TF) };
				}
				return { x: x3 + U * TF * K, y: DECK, c: 0.5 * Math.sin(Math.PI * Math.min(1, (t - t4) / 0.5)), fly: 0 };
			};
			const drawBoy = (x: number, y: number, c: number, fly: number) => {
				const hip = y - 30 + 11 * c;
				const knee = [x + 3 + 9 * c, (y + hip) / 2 + 2];
				legs.setAttribute('d', `M ${f1(x - 4)} ${f1(y)} L ${f1(knee[0] - 4)} ${f1(knee[1])} L ${f1(x - 1)} ${f1(hip)} M ${f1(x + 5)} ${f1(y)} L ${f1(knee[0] + 2)} ${f1(knee[1])} L ${f1(x + 1)} ${f1(hip)}`);
				const lean = 6 * c + 4 * fly; // the body leans forward
				const sh = [x + lean - 1, hip - 22];
				torso.setAttribute('x1', f1(x - 1));
				torso.setAttribute('y1', f1(hip));
				torso.setAttribute('x2', f1(sh[0]));
				torso.setAttribute('y2', f1(sh[1]));
				head.setAttribute('cx', f1(sh[0] + 2));
				head.setAttribute('cy', f1(sh[1] - 9));
				// arms: down and back while crouching, forward and up in the flight
				const swing = -0.9 * c + 2.1 * fly;
				const ex = sh[0] + 12 * Math.sin(swing);
				const ey = sh[1] + 12 * Math.cos(swing);
				const hx = ex + 10 * Math.sin(swing + 0.5);
				const hy = ey + 10 * Math.cos(swing + 0.5);
				arms.setAttribute('d', `M ${f1(sh[0])} ${f1(sh[1] + 2)} L ${f1(ex)} ${f1(ey)} L ${f1(hx)} ${f1(hy)}`);
			};
			const arrowAt = (ln: SVGLineElement, x: number, y: number, len: number) => {
				ln.setAttribute('x1', f1(x));
				ln.setAttribute('y1', f1(y));
				ln.setAttribute('x2', f1(x + len));
				ln.setAttribute('y2', f1(y));
			};
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const now = performance.now() / 1000;
				const bx = BX0 - boatShift(t) * K;
				const bob = 0.7 * Math.sin(now * 1.4);
				boat.setAttribute('transform', `translate(${f1(bx)} ${f1(WL + bob)})`);
				const b = boy(t);
				// while he stands in the boat, he bobs with it
				drawBoy(b.x, b.y + (t < t3 ? bob : 0), b.c, b.fly);
				// the water surface with a small wake behind the moving boat
				const vb = boatSpeed(t);
				const pts: string[] = [];
				for (let px = 0; px <= 360; px += 6) {
					let h = 0.8 * Math.sin(px / 21 + now * 1.6);
					const dl = px - bx; // the bow wave on the left end of the boat
					if (dl > -26 && dl < 4) h -= 2.2 * vb * Math.exp(-((dl + 6) ** 2) / 80);
					pts.push(`${px} ${f1(WL + h)}`);
				}
				surf.setAttribute('d', `M ${pts.join(' L ')}`);
				water.setAttribute('d', `M ${pts.join(' L ')} L 360 240 L 0 240 Z`);
				// the speed arrows: the boy 2, the boat 1 (18 px per m/s)
				const show = t > t3 - 0.05 && t < t4 + 0.6;
				vBoy.style.opacity = show && t < t4 ? '1' : '0';
				vBoat.style.opacity = show ? '1' : '0';
				if (show) {
					arrowAt(vBoy, b.x - 14, b.y - 76, 18 * U);
					arrowAt(vBoat, bx + 58, WL - 34, -18 * vb);
				}
			});
		}
	}
</script>
