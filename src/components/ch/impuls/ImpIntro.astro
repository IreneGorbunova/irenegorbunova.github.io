---
/**
 * Two short looping opening scenes of «Импульс. Закон сохранения импульса» (grade 10). No terms of the chapter in the
 * pictures or the visible captions; each caption's popover names the notion and links to its section. People: the
 * shared people kit (src/components/people/). Grade 9 has bumper cars and a firework, grade 7 the boy jumping from a
 * boat, so this chapter keeps billiards and adds a platform dive.
 *
 * Billiards (a billiard room seen from the side and a little from above; real time, 3,0 с). A 9-foot table (playing
 *   field 254 × 127 см, cloth 80 см above the floor) is drawn at 0,72–0,79 px per см with the far side raised by
 *   perspective; the player (people kit, 178 см, 0,76 px per см) stands at the head end in the usual stance: the body
 *   bent forward, the left hand flat on the cloth as a bridge, the right hand holding the cue (147 см) by the butt,
 *   the forearm hanging down. The stroke: the cue is drawn back by 12 см in 0,5 с and pushed forward with an even
 *   acceleration over 15 см (0,3 с); the tip meets the white ball at 1,0 м/с and the ball leaves at 1,5 м/с (a cue of
 *   0,55 кг on a ball of 0,17 кг: 2 · 0,55 / 0,72 · 1,0 = 1,53 м/с; the cue goes on at 0,5 м/с, follows through by 5 см
 *   and stops). The white ball slides 83 см to the red ball in 0,55 с and hits it dead centre; balls of equal mass, an
 *   elastic impact: the white ball stops on the spot, the red one goes on at 1,5 м/с along the same line, 119 см in
 *   0,80 с, and drops into the far corner pocket. Rolling friction (a slowing of about 0,1 м/с over this distance) is
 *   left out. The balls (57 мм) are drawn 1,8 times larger than to scale so that they can be seen.
 * Platform dive (an outdoor pool; real time, 45 px per м on both axes, the diver 180 см at 0,45 px per см; the picture
 *   shows 5,3 м of height, and the view follows the diver down from the platform to the water). The diver
 *   stands at the edge of the 10-м platform, bends the knees with the arms swinging back and springs up with the arms
 *   swinging over the head; at the take-off (1,1 с) his centre of mass moves at 4,0 м/с up and 1,3 м/с forward. In
 *   the air it moves as a thrown stone: x = x₀ + 1,3t, y = y₀ + 4,0t − 4,9t² (м, с; g = 9,8 м/с², air left out),
 *   rises by 0,82 м in 0,41 с and is 1,05 м above the water (the hands touch it) about 1,9 с after the take-off. The
 *   body turns 1½ somersaults forward: it tucks (0,15–0,40 с), spins tucked, opens (1,20–1,45 с) and enters the water
 *   head first, straight, with the hands over the head. The turning keeps the angular momentum: the moment of inertia
 *   is taken as 18 кг·м² stretched and 4 кг·м² tucked, so the spin is 4,5 times faster in the tuck (about 8 рад/с
 *   against 1,8 рад/с). The centre of mass is computed in every frame from the body segments (head 8,1 %, trunk 49,7 %,
 *   upper arm 2,8 %, forearm with hand 2,2 %, thigh 10 %, shin with foot 6,1 %), and the figure is placed so that this
 *   point lies on the parabola; faint dots mark it every 0,1 с. Under the water the body is slowed (time constant
 *   0,12 с). The splash and the rings on the water are drawn, not computed. A coach on the deck follows the dive.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// ---- billiards: the table in perspective; u along the table (0 head end, 1 foot end), w across (0 near, 1 far)
const YN = 168; // the near cushion line
const YF = 140; // the far cushion line
const XN = [118, 318];
const XF = [126, 310];
const P = (u: number, w: number) => {
	const xn = XN[0] + (XN[1] - XN[0]) * u;
	const xf = XF[0] + (XF[1] - XF[0]) * u;
	return { x: xn + (xf - xn) * w, y: YN + (YF - YN) * w };
};
const pt = (u: number, w: number) => {
	const p = P(u, w);
	return `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
};
const quad = (u0: number, w0: number, u1: number, w1: number) => `M${pt(u0, w0)} L${pt(u1, w0)} L${pt(u1, w1)} L${pt(u0, w1)} Z`;
const pockets = [
	[0, 0],
	[0.5, 0],
	[1, 0],
	[0, 1],
	[0.5, 1],
	[1, 1],
].map(([u, w]) => ({ ...P(u, w), r: 7.2 - 1.2 * w }));
const diamonds = [0.125, 0.25, 0.375, 0.625, 0.75, 0.875].flatMap((u) => [P(u, -0.1), P(u, 1.08)]);
const planks = Array.from({ length: 11 }, (_, i) => {
	const x = -60 + i * 50;
	return `M${(180 + (x - 180) * 0.45).toFixed(1)} 112 L${x} 240`;
});
const cues = [324, 331, 338, 345];
const lightPath = `M174 56 L276 56 L${pt(1.02, 0.6)} L${pt(1.02, -0.12)} L${pt(0.02, -0.12)} L${pt(0.02, 0.6)} Z`;

// ---- dive: drawn in world coordinates (45 px per м), the water at y = 600, the 10-м platform at 600 − 450 = 150;
// the camera (the [data-world] group) follows the diver down
const WY = 600;
const K = 45; // px per м
const PLAT = WY - 10 * K;
const EDGE = 120; // the front edge of the platform
const levels = [
	{ h: 7.5, x: 112 },
	{ h: 5, x: 104 },
	{ h: 3, x: 96 },
];
const clouds = [
	{ x: 150, y: 30 },
	{ x: 230, y: 70 },
	{ x: 300, y: 24 },
];
const crowd = Array.from({ length: 34 }, (_, i) => {
	const v = Math.sin(i * 12.9898) * 43758.5453;
	const r = v - Math.floor(v);
	return { x: 190 + i * 5 + r * 2, y: WY - 54 - (i % 3) * 7 - r * 2, c: i % 4 };
});
const lanes = [0, 1, 2].map((i) => WY + 6 + i * 6.5);
const rungs = Array.from({ length: Math.floor((WY - PLAT) / 20) }, (_, i) => `M8 ${WY - 14 - i * 20} H22`).join(' ');
---

<PeopleStyles />
<IntroFrame data-impintro>
	<div class="intro__card" data-scene="billiards">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Бильярдная. Игрок склонился над столом и бьёт кием по белому шару. Белый шар катится к красному и ударяет его точно в центр. Белый шар останавливается на месте удара, а красный катится дальше с той же скоростью и падает в дальнюю угловую лузу">
			<!-- the room -->
			<rect class="ib-wall" x="0" y="0" width="360" height="112"></rect>
			<rect class="ib-panel" x="0" y="88" width="360" height="24"></rect>
			<rect class="ib-floor" x="0" y="112" width="360" height="128"></rect>
			<path class="ib-plank" d={planks.join(' ')}></path>
			<!-- the scoreboard and the cue rack on the wall -->
			<rect class="ib-board" x="22" y="22" width="78" height="22" rx="2"></rect>
			<path class="ib-wire" d="M27 29 H95 M27 37 H95"></path>
			{[31, 36, 41, 67, 72].map((x) => <circle class="ib-bead" cx={x} cy="29" r="2.2" />)}
			{[31, 36, 75, 80, 85].map((x) => <circle class="ib-bead ib-bead--b" cx={x} cy="37" r="2.2" />)}
			<rect class="ib-rack" x="318" y="30" width="34" height="6" rx="1.5"></rect>
			<rect class="ib-rack" x="318" y="96" width="34" height="8" rx="1.5"></rect>
			{cues.map((x) => <path class="ib-cue-wall" d={`M${x} 28 L${x + 0.6} 98`} />)}
			<!-- the lamp and its light -->
			<path class="ib-cord" d="M184 0 V46 M266 0 V46"></path>
			<path class="ib-light" d={lightPath}></path>
			<!-- the table: far legs, aprons, rails, cloth, pockets -->
			<path class="ib-leg ib-leg--far" d={`M${P(0.06, 1).x} ${YF + 10} V203 M${P(0.94, 1).x} ${YF + 10} V203`}></path>
			<path class="ib-apron ib-apron--end" d={`M${pt(-0.05, -0.15)} L${pt(-0.05, 1.15)} L${P(-0.05, 1.15).x + 1} ${YF + 12} L${P(-0.05, -0.15).x + 2} ${YN + 19} Z`}></path>
			<path class="ib-apron" d={`M${pt(-0.05, -0.15)} L${pt(1.05, -0.15)} L${P(1.05, -0.15).x - 2} ${YN + 19} L${P(-0.05, -0.15).x + 2} ${YN + 19} Z`}></path>
			<path class="ib-leg" d={`M${P(0.05, 0).x} ${YN + 19} V231 M${P(0.95, 0).x} ${YN + 19} V231`}></path>
			<path class="ib-foot" d={`M${P(0.05, 0).x - 5} 231 h10 M${P(0.95, 0).x - 5} 231 h10`}></path>
			<path class="ib-rail" d={quad(-0.05, -0.15, 1.05, 1.15)}></path>
			<path class="ib-cloth" d={quad(0, 0, 1, 1)}></path>
			<path class="ib-cushion" d={`M${pt(0, 0)} L${pt(1, 0)} M${pt(0, 1)} L${pt(1, 1)} M${pt(0, 0)} L${pt(0, 1)} M${pt(1, 0)} L${pt(1, 1)}`}></path>
			{diamonds.map((d) => <circle class="ib-diamond" cx={d.x} cy={d.y} r="1" />)}
			{pockets.map((p) => <ellipse class="ib-pocket" cx={p.x} cy={p.y} rx={p.r} ry={p.r * 0.55} />)}
			<!-- the balls -->
			<g data-red>
				<ellipse class="ib-shadow" cx="1" cy="3.2" rx="4" ry="1.5"></ellipse>
				<circle class="ib-red" cx="0" cy="0" r="3.9"></circle>
				<circle class="ib-shine" cx="-1.3" cy="-1.4" r="1.1"></circle>
			</g>
			<g data-white>
				<ellipse class="ib-shadow" cx="1" cy="3.2" rx="4" ry="1.5"></ellipse>
				<circle class="ib-white" cx="0" cy="0" r="3.9"></circle>
				<circle class="ib-shine" cx="-1.3" cy="-1.4" r="1.1"></circle>
			</g>
			<!-- the lamp shade in front of the light -->
			<path class="ib-shade" d="M170 56 L176 46 H274 L280 56 Z"></path>
			<path class="ib-shade-rim" d="M170 56 H280"></path>
			<!-- the player (people kit) and the cue -->
			<g data-cue-back></g>
			<g data-player></g>
			<path class="ib-cue-butt" data-butt></path>
			<path class="ib-cue" data-cue></path>
			<path class="ib-cue-tip" data-tip></path>
		</svg>
		<div class="intro__foot">
			<p>Шар ударяет точно в центр такого же неподвижного шара и останавливается как вкопанный, а второй шар <More term="катится дальше с его скоростью">Шары одинаковые, и при ударе первый шар передаёт второму весь свой импульс. Удар бильярдных шаров почти упругий — так же ведут себя одинаковые тележки в модели раздела <a href="#упругий-и-неупругий-удар">«Упругий и неупругий удар»</a>. На бильярде так получается, если в момент удара первый шар скользит по сукну, не вращаясь: для этого кием бьют чуть ниже центра шара.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="dive">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Открытый бассейн с вышкой. Прыгун отталкивается от края десятиметровой вышки, сгибается, крутит в воздухе полтора сальто, выпрямляется и входит в воду головой вниз. Бледные точки, поставленные через равные промежутки времени, отмечают одну точку его тела: они лежат на ровной параболе. Тренер на бортике следит за прыжком">
			<rect class="id-sky" x="0" y="0" width="360" height="240"></rect>
			{clouds.map((s) => <path class="id-cloud" d={`M${s.x} ${s.y} q6 -7 14 -2 q8 -6 14 2 q6 1 4 5 h-34 q-4 -3 2 -5 Z`} />)}
			<g data-world>
				<path class="id-hill" d={`M0 ${WY - 72} Q60 ${WY - 94} 130 ${WY - 82} Q200 ${WY - 98} 270 ${WY - 84} Q320 ${WY - 92} 360 ${WY - 86} V${WY} H0 Z`}></path>
				<path class="id-tree" d={`M246 ${WY - 72} q-6 -16 6 -24 q12 8 6 24 Z M262 ${WY - 70} q-5 -12 5 -19 q10 7 5 19 Z M300 ${WY - 72} q-6 -15 6 -22 q12 7 6 22 Z M318 ${WY - 71} q-5 -12 5 -18 q10 6 5 18 Z`}></path>
				<!-- the stand with spectators -->
				<path class="id-stand" d={`M180 ${WY - 46} L184 ${WY - 72} H360 V${WY - 46} Z`}></path>
				<path class="id-step" d={`M182 ${WY - 54} H360 M183 ${WY - 61} H360 M184 ${WY - 68} H360`}></path>
				{crowd.map((c) => <g class={`id-fan id-fan--${c.c}`}><circle cx={c.x} cy={c.y - 4.2} r="1.5" /><rect x={c.x - 1.6} y={c.y - 2.8} width="3.2" height="4" rx="1" /></g>)}
				<rect class="id-deck-far" x="0" y={WY - 46} width="360" height="46"></rect>
				<!-- the tower -->
				<rect class="id-tower" x="30" y={PLAT} width="66" height={WY - PLAT}></rect>
				<path class="id-joint" d={[0.25, 0.5, 0.75].map((f) => `M30 ${PLAT + (WY - PLAT) * f} H96`).join(' ')}></path>
				{levels.map((l) => <rect class="id-plat id-plat--low" x="40" y={WY - l.h * K} width={l.x - 40} height="8" />)}
				<rect class="id-plat" x="40" y={PLAT} width={EDGE - 40} height="10"></rect>
				<path class="id-rail" d={`M46 ${PLAT} V${PLAT - 46} H84 V${PLAT} M46 ${PLAT - 24} H84`}></path>
				<path class="id-ladder" d={`M8 ${WY} V${PLAT - 10} M22 ${WY} V${PLAT - 10} ${rungs}`}></path>
				<!-- the deck, the coach -->
				<rect class="id-deck" x="290" y={WY - 8} width="70" height="8"></rect>
				<g data-coach></g>
				<!-- the marks of the one point, the diver -->
				<g data-dots></g>
				<g data-wrap><g data-diver></g></g>
				<!-- the water over the part of the diver that is under it -->
				<rect class="id-water" x="0" y={WY} width="360" height="90"></rect>
				{lanes.map((y, i) => <path class="id-lane" d={`M0 ${y} H360`} stroke-dasharray={`${4 + 2 * i} ${5 + 2 * i}`} />)}
				<path class="id-surf" d={`M0 ${WY} H360`}></path>
				<g data-rings></g>
				<g data-splash></g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Прыгун крутит сальто, руки и ноги движутся как угодно, а <More term="одна точка его тела">Это центр масс прыгуна. После толчка на него действует только сила тяжести (сопротивление воздуха мало), и центр масс летит по параболе, как брошенный камень. Сгибаясь и разгибаясь, прыгун меняет только положение рук и ног относительно этой точки: внутренние силы не меняют движения центра масс. Подробнее — в разделе <a href="#центр-масс">«Центр масс»</a>.</More> летит по ровной дуге.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-impintro] {
		--ib-wood: color-mix(in oklab, hsl(25, 45%, 38%) 80%, var(--sl-color-gray-5));
		--ib-wood-d: color-mix(in oklab, hsl(25, 45%, 24%) 80%, var(--sl-color-gray-6));
		--ib-cloth: color-mix(in oklab, hsl(160, 45%, 34%) 85%, var(--ig-surface));
	}
	[data-impintro] .ib-wall { fill: color-mix(in oklab, hsl(35, 30%, 40%) 30%, var(--sl-color-gray-6)); }
	[data-impintro] .ib-panel { fill: color-mix(in oklab, var(--ib-wood-d) 60%, var(--sl-color-gray-6)); }
	[data-impintro] .ib-floor { fill: color-mix(in oklab, hsl(28, 35%, 30%) 45%, var(--sl-color-gray-6)); }
	[data-impintro] .ib-plank { stroke: color-mix(in oklab, var(--sl-color-gray-5) 70%, transparent); stroke-width: 0.7; fill: none; }
	[data-impintro] .ib-board { fill: var(--ib-wood-d); stroke: var(--ib-wood); stroke-width: 1.2; }
	[data-impintro] .ib-wire { stroke: var(--sl-color-gray-3); stroke-width: 0.6; }
	[data-impintro] .ib-bead { fill: hsl(40, 70%, 70%); }
	[data-impintro] .ib-bead--b { fill: hsl(0, 0%, 88%); }
	[data-impintro] .ib-rack { fill: var(--ib-wood); }
	[data-impintro] .ib-cue-wall { stroke: hsl(32, 55%, 62%); stroke-width: 1.6; stroke-linecap: round; }
	[data-impintro] .ib-cord { stroke: var(--sl-color-gray-4); stroke-width: 0.8; }
	[data-impintro] .ib-shade { fill: color-mix(in oklab, hsl(150, 40%, 30%) 80%, var(--sl-color-gray-6)); }
	[data-impintro] .ib-shade-rim { stroke: hsl(45, 90%, 78%); stroke-width: 1.4; }
	[data-impintro] .ib-light { fill: hsl(48, 90%, 75%); opacity: 0.1; }
	[data-impintro] .ib-leg { stroke: var(--ib-wood-d); stroke-width: 7; }
	[data-impintro] .ib-leg--far { stroke-width: 5; opacity: 0.8; }
	[data-impintro] .ib-foot { stroke: var(--ib-wood-d); stroke-width: 3; stroke-linecap: round; }
	[data-impintro] .ib-apron { fill: var(--ib-wood-d); stroke: var(--ib-wood); stroke-width: 0.8; }
	[data-impintro] .ib-apron--end { fill: color-mix(in oklab, var(--ib-wood-d) 80%, black); }
	[data-impintro] .ib-rail { fill: var(--ib-wood); stroke: var(--ib-wood-d); stroke-width: 1; }
	[data-impintro] .ib-cloth { fill: var(--ib-cloth); }
	[data-impintro] .ib-cushion { stroke: color-mix(in oklab, var(--ib-cloth) 70%, black); stroke-width: 1.6; }
	[data-impintro] .ib-diamond { fill: hsl(45, 40%, 88%); }
	[data-impintro] .ib-pocket { fill: hsl(220, 25%, 8%); }
	[data-impintro] .ib-shadow { fill: hsl(160, 50%, 10%); opacity: 0.45; }
	[data-impintro] .ib-white { fill: hsl(45, 40%, 95%); stroke: hsl(45, 10%, 60%); stroke-width: 0.5; }
	[data-impintro] .ib-red { fill: hsl(355, 75%, 52%); stroke: hsl(355, 60%, 32%); stroke-width: 0.5; }
	[data-impintro] .ib-shine { fill: white; opacity: 0.75; }
	[data-impintro] .ib-cue { stroke: hsl(36, 60%, 66%); stroke-linecap: round; fill: none; }
	[data-impintro] .ib-cue-butt { stroke: hsl(15, 45%, 26%); stroke-linecap: round; fill: none; }
