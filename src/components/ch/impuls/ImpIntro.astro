	[data-impintro] .id-hill { fill: color-mix(in oklab, hsl(130, 30%, 40%) 45%, var(--sl-color-bg)); }
	[data-impintro] .id-tree { fill: color-mix(in oklab, hsl(140, 35%, 30%) 60%, var(--sl-color-bg)); }
	[data-impintro] .id-stand { fill: color-mix(in oklab, hsl(210, 10%, 60%) 40%, var(--sl-color-bg)); }
	[data-impintro] .id-step { stroke: color-mix(in oklab, var(--sl-color-gray-3) 50%, transparent); stroke-width: 0.6; }
	[data-impintro] .id-fan circle { fill: color-mix(in oklab, hsl(26, 55%, 72%) 70%, var(--sl-color-bg)); }
	[data-impintro] .id-fan rect { fill: color-mix(in oklab, hsl(0, 70%, 60%) 60%, var(--sl-color-bg)); }
	[data-impintro] .id-fan--1 rect { fill: color-mix(in oklab, hsl(205, 70%, 60%) 60%, var(--sl-color-bg)); }
	[data-impintro] .id-fan--2 rect { fill: color-mix(in oklab, hsl(45, 80%, 60%) 60%, var(--sl-color-bg)); }
	[data-impintro] .id-fan--3 rect { fill: color-mix(in oklab, hsl(150, 50%, 50%) 60%, var(--sl-color-bg)); }
	[data-impintro] .id-deck-far { fill: color-mix(in oklab, hsl(30, 8%, 75%) 45%, var(--sl-color-bg)); }
	[data-impintro] .id-tower { fill: color-mix(in oklab, hsl(30, 8%, 70%) 60%, var(--sl-color-gray-5)); }
	[data-impintro] .id-joint { stroke: var(--sl-color-gray-4); stroke-width: 0.6; }
	[data-impintro] .id-plat { fill: color-mix(in oklab, hsl(30, 8%, 80%) 70%, var(--sl-color-gray-4)); }
	[data-impintro] .id-plat--low { opacity: 0.75; }
	[data-impintro] .id-rail { stroke: var(--sl-color-gray-3); stroke-width: 1; fill: none; }
	[data-impintro] .id-ladder { stroke: var(--sl-color-gray-3); stroke-width: 0.8; fill: none; }
	[data-impintro] .id-deck { fill: color-mix(in oklab, hsl(30, 8%, 80%) 60%, var(--sl-color-gray-5)); }
	[data-impintro] .id-water { fill: hsl(195, 75%, 45%); opacity: 0.88; }
	[data-impintro] .id-lane { stroke: hsl(0, 0%, 95%); stroke-width: 1.2; opacity: 0.6; }
	[data-impintro] .id-surf { stroke: hsl(190, 80%, 80%); stroke-width: 1; }
	[data-impintro] .id-dot { fill: var(--sl-color-white); }
	[data-impintro] .id-ring { fill: none; stroke: hsl(190, 80%, 85%); stroke-width: 1.6; }
	[data-impintro] .id-drop { fill: hsl(190, 80%, 88%); }
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { figure, ANKLE_CM, SKELETON, DEG, ROLL, add, sub, polar, mk, lerp, lerpPt, ease, type Pt, type FigurePose, type FigureState } from '@components/people';

	const f1 = (v: number) => v.toFixed(1);
	const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
	const smooth = (a: number, b: number, t: number) => ease((t - a) / (b - a));

	for (const root of document.querySelectorAll<HTMLElement>('[data-impintro]')) {
		// ------------------------------------------------------------------ billiards
		{
			const card = root.querySelector<HTMLElement>('[data-scene="billiards"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			// the table, as in the frontmatter
			const P = (u: number, w: number): Pt => {
				const xn = 118 + 200 * u;
				const xf = 126 + 184 * u;
				return { x: xn + (xf - xn) * w, y: 168 - 28 * w };
			};
			const LEN = 254;
			const WID = 127; // см
			const V = 1.5; // м/с, the balls
			// the shot line: from the white ball toward the far corner pocket (u = 1, w = 1)
			const W0 = { u: 0.22, w: 0.5 };
			const dU = (1 - W0.u) * LEN;
			const dW = (1 - W0.w) * WID;
			const Ltot = Math.hypot(dU, dW); // см, white start → pocket
			const at = (s: number) => P(W0.u + (dU * s) / Ltot / LEN, W0.w + (dW * s) / Ltot / WID); // s см along the line
			const D1 = 83; // см, the travel of the white ball to the impact
			const ballY = (p: Pt) => ({ x: p.x, y: p.y - 3.4 });
			const white = $<SVGGElement>('[data-white]');
			const red = $<SVGGElement>('[data-red]');
			const place = (g: SVGGElement, p: Pt, k = 1, op = 1) => {
				const q = ballY(p);
				g.setAttribute('transform', `translate(${f1(q.x)} ${f1(q.y)}) scale(${k.toFixed(3)})`);
				g.setAttribute('opacity', op.toFixed(2));
			};
			// the player: 178 см at 0,76 px per см, standing at the head end
			const S = 0.76;
			const player = figure($<SVGGElement>('[data-player]'), { s: S, H: 178, clothes: 'home', shirt: 'hm-green', name: 'player' });
			player.backLayer(0, $<SVGGElement>('[data-cue-back]'));
			const FLOOR = 215;
			const ankleY = FLOOR - ANKLE_CM.lowshoe * S;
			const HIP: Pt = { x: 70, y: 148.5 };
			const LEAN = 1.22;
			// the cue in the picture: the tip aims at the white ball along the shot, the cue rises a little toward the butt
			const wStart = ballY(at(0));
			const ahead = ballY(at(20));
			const a0 = Math.atan2(ahead.y - wStart.y, ahead.x - wStart.x) + 5.5 * DEG;
			const cd: Pt = { x: Math.cos(a0), y: Math.sin(a0) }; // from the butt toward the tip
			const contact: Pt = { x: wStart.x - cd.x * 3.9, y: wStart.y - cd.y * 3.9 }; // the tip meets the ball here
			const CUE = 147 * S;
			const GRIP = 112 * S; // the grip, from the tip
			const bridgeOn: Pt = { x: contact.x - cd.x * 25 * S, y: contact.y - cd.y * 25 * S };
			const bridgeHand: Pt = { x: bridgeOn.x + 1.5, y: P(0.13, 0.46).y - 0.6 }; // the palm on the cloth under the cue
			// the stroke: the tip's distance (см) behind the contact point; negative = past it
			const T_BACK = [0.35, 0.85]; // drawn back by 12 см
			const ACC = (1.0 * 1.0) / (2 * 0.15); // м/с²: from rest to 1,0 м/с over 15 см
			const T_HIT = T_BACK[1] + 0.3;
			const tipBehind = (t: number) => {
				if (t < T_BACK[0]) return 3;
				if (t < T_BACK[1]) return 3 + 12 * smooth(T_BACK[0], T_BACK[1], t);
				if (t < T_HIT) {
					const tt = t - T_BACK[1];
					return 15 - 100 * 0.5 * ACC * tt * tt;
				}
				const tt = Math.min(t - T_HIT, 0.2); // the follow-through: from 0,5 м/с to a stop in 0,2 с, 5 см
				return -100 * (0.5 * tt - 1.25 * tt * tt);
			};
			const cueEls = { cue: $<SVGPathElement>('[data-cue]'), tip: $<SVGPathElement>('[data-tip]'), butt: $<SVGPathElement>('[data-butt]') };
			const RED0 = D1 + 5.7; // the red ball's centre, см along the line
			const T_MEET = T_HIT + D1 / 100 / V;
			const T_POCKET = T_MEET + (Ltot - RED0) / 100 / V;
			const RUN = 3.0;
			const pose = (t: number): FigurePose => {
				const b = tipBehind(t) * S;
				const tip: Pt = { x: contact.x - cd.x * b, y: contact.y - cd.y * b };
				const grip: Pt = { x: tip.x - cd.x * GRIP, y: tip.y - cd.y * GRIP };
				const butt: Pt = { x: tip.x - cd.x * CUE, y: tip.y - cd.y * CUE };
				// the cue tapers: thick at the butt, thin at the tip
				const mid: Pt = lerpPt(butt, tip, 0.3);
				cueEls.cue.setAttribute('d', `M${f1(mid.x)} ${f1(mid.y)} L${f1(tip.x - cd.x * 1.2)} ${f1(tip.y - cd.y * 1.2)}`);
				cueEls.cue.setAttribute('stroke-width', '1.6');
				cueEls.butt.setAttribute('d', `M${f1(butt.x)} ${f1(butt.y)} L${f1(mid.x)} ${f1(mid.y)}`);
				cueEls.butt.setAttribute('stroke-width', '2.6');
				cueEls.tip.setAttribute('d', `M${f1(tip.x - cd.x * 1.4)} ${f1(tip.y - cd.y * 1.4)} L${f1(tip.x)} ${f1(tip.y)}`);
				return {
					hip: HIP,
					lean: LEAN,
					head: 0.06,
					ankles: [
						{ x: HIP.x - 15, y: ankleY },
						{ x: HIP.x + 17, y: ankleY },
					],
					feet: [0, 0],
					hands: [
						{ at: grip, pose: 'grip', d: 3, dir: Math.PI / 2 - 0.15, roll: ROLL.backViewer, contact: 'cue' },
						{ at: bridgeHand, pose: 'flat', dir: 0.05, roll: ROLL.palmCw, contact: 'cloth' },
					],
					planted: [true, true],
				};
			};
			const draw = (t: number) => {
				player.pose(pose(t));
				if (t < T_HIT) place(white, at(0));
				else if (t < T_MEET) place(white, at((t - T_HIT) * V * 100));
				else place(white, at(D1));
				if (t < T_MEET) place(red, at(RED0));
				else {
					const s = Math.min(RED0 + (t - T_MEET) * V * 100, Ltot);
					const drop = clamp01((t - T_POCKET) / 0.18);
					place(red, at(s), 1 - 0.45 * drop, 1 - drop);
				}
			};
			scene(card, RUN, (x) => draw(x * RUN));
		}

		// ------------------------------------------------------------------ dive
		{
			const card = root.querySelector<HTMLElement>('[data-scene="dive"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const WY = 600;
			const K = 45; // px per м
			const PLAT = WY - 10 * K;
			const EDGE = 120;
			const S = 0.45; // px per см
			const H = 180;
			const sk = SKELETON.adult;
			const u = S * H;
			const diver = figure($<SVGGElement>('[data-diver]'), { s: S, H, clothes: 'swim', shirt: 'hm-blue', name: 'diver' });
			const wrap = $<SVGGElement>('[data-wrap]');
			const coach = figure($<SVGGElement>('[data-coach]'), { s: S, H: 176, clothes: 'home', shirt: 'hm-red', dir: -1, name: 'coach' });
			const ARM = (sk.upper + sk.fore) * u;
			const REACH = ARM * 0.98 + 0.04 * u; // shoulder to the middle of a stretched hand
			const LEG = (sk.thigh + sk.shin) * u;

			// the centre of mass of a pose (in the figure's own coordinates), from its joints
			const cmOf = (hip: Pt, lean: number, st: FigureState, ankles: [Pt, Pt]): Pt => {
				const spine = { x: Math.sin(lean), y: -Math.cos(lean) };
				const head = add(hip, { x: spine.x * sk.headC * u, y: spine.y * sk.headC * u });
				const neck = add(hip, { x: spine.x * sk.shoulder * u, y: spine.y * sk.shoulder * u });
				const parts: [Pt, number][] = [
					[head, 0.081],
					[lerpPt(hip, neck, 0.5), 0.497],
				];
				for (const i of [0, 1] as const) {
					parts.push([lerpPt(st.shoulders[i], st.elbows[i], 0.44), 0.028]);
					parts.push([lerpPt(st.elbows[i], st.wrists[i], 0.6), 0.022]);
					parts.push([lerpPt(hip, st.knees[i], 0.43), 0.1]);
					parts.push([lerpPt(st.knees[i], ankles[i], 0.55), 0.061]);
				}
				let x = 0;
				let y = 0;
				for (const [p, m] of parts) {
					x += p.x * m;
					y += p.y * m;
				}
				return { x, y };
			};

			// the take-off: standing at the edge (the figure's coordinates = the picture's, no turn yet)
			const ankleY = PLAT - ANKLE_CM.barefoot * S;
			const FOOT_X = EDGE - 17 * S; // the ankle, the toes at the edge
			const T_OFF = 1.1; // s
			const VX = 1.3;
			const VY = 4.0; // м/с
			const hipStand = { x: FOOT_X + 1, y: ankleY - LEG * 0.995 };
			const prePose = (t: number): FigurePose => {
				const dip = smooth(0.45, 0.8, t) * (1 - smooth(0.8, T_OFF, t)); // knees bend, then straighten
				const rise = smooth(0.85, T_OFF, t); // up on the toes
				const ankle = { x: FOOT_X, y: ankleY - rise * 7 * S };
				const hip = { x: hipStand.x - dip * 2.2, y: hipStand.y + dip * 4.6 - rise * 7 * S };
				const lean = 0.05 + dip * 0.35 - 0.05 * rise;
				const sh = diver.shoulders(hip, lean);
				// the arms: by the sides, swung back in the dip, then forward and up over the head
				const back = smooth(0.4, 0.75, t);
				const up = smooth(0.72, T_OFF, t);
				const ang = lerp(lerp(Math.PI / 2, Math.PI / 2 + 0.75, back), -Math.PI / 2 + 0.12, up); // screen angle of the arm
				const hand = (i: 0 | 1) => ({ at: add(sh[i], polar(REACH, ang - i * 0.05)), pose: (up > 0.5 ? 'flat' : 'relaxed') as 'flat' | 'relaxed' });
				return {
					hip,
					lean,
					head: -0.05 * up,
					ankles: [ankle, { x: ankle.x - 1.2, y: ankle.y }],
					feet: [rise * 0.9, rise * 0.9],
					hands: [hand(0), hand(1)],
					planted: [rise < 0.02, rise < 0.02],
				};
			};

			// in the air: stretched ↔ tucked; the figure's coordinates with the hip at the origin
			const tuckOf = (tau: number) => smooth(0.15, 0.4, tau) * (1 - smooth(1.2, 1.45, tau));
			const inertia = (tau: number) => lerp(18, 4, tuckOf(tau));
			const airPose = (tau: number): { q: FigurePose; ankles: [Pt, Pt] } => {
				const k = tuckOf(tau);
				const hip = { x: 0, y: 0 };
				const lean = lerp(-0.05, 1.0, k);
				const thigh = lerp(Math.PI / 2, -0.35, k);
				const bend = lerp(0, 2.5, k);
				const legs: [[number, number], [number, number]] = [
					[thigh, bend],
					[thigh + 0.05, bend],
				];
				const knee = (l: [number, number]): Pt => polar(sk.thigh * u, l[0]);
				const ank = (l: [number, number]): Pt => add(knee(l), polar(sk.shin * u, l[0] + l[1]));
				const ankles: [Pt, Pt] = [ank(legs[0]), ank(legs[1])];
				const sh = diver.shoulders(hip, lean);
				// the hands: over the head when stretched, on the shins when tucked; swept forward in between
				const hand = (i: 0 | 1) => {
					const a0 = -Math.PI / 2 + 0.12 - i * 0.05;
					const tgt = lerpPt(knee(legs[i]), ankles[i], 0.3);
					const v = sub(tgt, sh[i]);
					let a1 = Math.atan2(v.y, v.x);
					if (a1 < a0) a1 += 2 * Math.PI;
					const r = Math.min(REACH, lerp(REACH, Math.hypot(v.x, v.y), k)); // never beyond the reach of the arm
					const at = k > 0.995 ? tgt : add(sh[i], polar(r, lerp(a0, a1, k)));
					return { at, pose: (k > 0.5 ? 'grip' : 'flat') as 'grip' | 'flat', d: 9, contact: k > 0.995 ? `shin-${i}` : undefined };
				};
				return {
					q: { hip, lean, head: lerp(-0.05, 0.25, k), ankles, legs, feet: [lerp(0.9, 0.7, k), lerp(0.9, 0.7, k)], hands: [hand(0), hand(1)] },
					ankles,
				};
			};
			// the angle turned (rad) after tau s in the air for the angular momentum L (кг·м²/с)
			const turned = (tau: number, L: number) => {
				let a = 0;
				const n = Math.max(1, Math.ceil(tau / 0.002));
				for (let i = 0; i < n; i++) a += (L / inertia((i + 0.5) * (tau / n))) * (tau / n);
				return a;
			};
			const dots = $<SVGGElement>('[data-dots]');
			const dotEls: SVGCircleElement[] = [];
			const rings = $<SVGGElement>('[data-rings]');
			const ringEls = [0, 1, 2].map(() => mk(rings, 'ellipse', { class: 'id-ring', rx: 0, ry: 0, opacity: 0 }));
			const splash = $<SVGGElement>('[data-splash]');
			const drops = Array.from({ length: 14 }, (_, i) => {
				const r = Math.abs(Math.sin(i * 91.7) * 1000) % 1;
				return { vx: (i % 2 ? 1 : -1) * (0.3 + 1.2 * r), vy: 2.6 + 2.2 * ((i * 0.37) % 1), el: mk(splash, 'circle', { class: 'id-drop', r: f1(1.6 + 1.4 * r), opacity: 0 }) };
			});
			// the take-off pose fixes the start of the parabola; the entry fixes the angular momentum (1½ turns)
			const p0 = prePose(T_OFF);
			const cm0 = cmOf(p0.hip, p0.lean, diver.pose(p0), p0.ankles);
			const y0m = (WY - cm0.y) / K; // the centre of mass above the water at the take-off, м
			const T_E = (VY + Math.sqrt(VY * VY + 4 * 4.9 * (y0m - 1.05))) / (2 * 4.9);
			const Lmom = (3 * Math.PI) / turned(T_E, 1);
			for (let i = 1; i * 0.1 < T_E; i++) dotEls.push(mk(dots, 'circle', { class: 'id-dot', r: '2.2', opacity: 0 }));
			const RUN = T_OFF + T_E + 1.1;
			// the coach on the deck, following the diver with his eyes
			const CS = 0.45;
			const coachAnkle = WY - 8 - ANKLE_CM.lowshoe * CS;
			const coachHip = { x: 326, y: coachAnkle - (sk.thigh + sk.shin) * 176 * CS * 0.995 };
			const coachPose = (look: number): FigurePose => {
				const sh = coach.shoulders(coachHip, -0.02);
				const r = (sk.upper + sk.fore) * 176 * CS * 0.97;
				return {
					hip: coachHip,
					lean: -0.02,
					head: look,
					ankles: [
						{ x: 320, y: coachAnkle },
						{ x: 333, y: coachAnkle },
					],
					feet: [0, 0],
					hands: [
						{ at: add(sh[0], polar(r, Math.PI / 2 - 0.08)), pose: 'relaxed' },
						{ at: add(sh[1], polar(r, Math.PI / 2 + 0.06)), pose: 'relaxed' },
					],
					planted: [true, true],
				};
			};
			// the camera: the platform stays in view until the diver comes down past it, then the view follows his centre of
			// mass until the water reaches the lower part of the picture
			const world = $<SVGGElement>('[data-world]');
			const TOP0 = PLAT - 120;
			const TOP1 = WY - 196;
			let camY = TOP0;
			const draw = (t: number) => {
				const tau = t - T_OFF;
				{
					const ta = Math.max(0, Math.min(tau, T_E));
					const cy = cm0.y - (VY * ta - 4.9 * ta * ta) * K;
					camY = Math.min(TOP1, Math.max(TOP0, cy - 110));
					world.setAttribute('transform', `translate(0 ${f1(-camY)})`);
				}
				coach.pose(coachPose(-0.6 + 0.55 * smooth(T_OFF + 0.5, T_OFF + T_E, t)));
				if (tau < 0) {
					wrap.removeAttribute('transform');
					diver.pose(prePose(t));
				} else {
					const ta = Math.min(tau, T_E);
					// after the entry the body goes on down, slowed by the water
					const under = Math.max(0, tau - T_E);
					const slow = 0.12 * (1 - Math.exp(-under / 0.12)); // s of motion at the entry speed
					const vE = VY - 9.8 * T_E;
					const xm = VX * ta + VX * slow;
					const ym = VY * ta - 4.9 * ta * ta + vE * slow;
					const C: Pt = { x: cm0.x + xm * K, y: cm0.y - ym * K };
					const { q, ankles } = airPose(ta);
					const st = diver.pose(q);
					const cm = cmOf(q.hip, q.lean, st, ankles);
					const th = turned(ta, Lmom);
					wrap.setAttribute('transform', `translate(${f1(C.x)} ${f1(C.y)}) rotate(${(th / DEG).toFixed(1)}) translate(${f1(-cm.x)} ${f1(-cm.y)})`);
				}
				// the marks every 0,1 s in the air
				dotEls.forEach((d, i) => {
					const tt = (i + 1) * 0.1;
					const on = tau >= tt;
					d.setAttribute('opacity', on ? '0.6' : '0');
					d.setAttribute('cx', f1(cm0.x + VX * tt * K));
					d.setAttribute('cy', f1(cm0.y - (VY * tt - 4.9 * tt * tt) * K));
				});
				// the splash and the rings
				const te = tau - T_E + 0.08;
				const xe = cm0.x + VX * T_E * K;
				drops.forEach((d) => {
					const y = d.vy * te - 4.9 * te * te;
					const on = te > 0 && y > 0;
					d.el.setAttribute('opacity', on ? (0.9 * (1 - te)).toFixed(2) : '0');
					d.el.setAttribute('cx', f1(xe + d.vx * Math.max(0, te) * K));
					d.el.setAttribute('cy', f1(WY - Math.max(0, y) * K));
				});
				ringEls.forEach((r, i) => {
					const tr = te - i * 0.25;
					const on = tr > 0;
					r.setAttribute('cx', f1(xe));
					r.setAttribute('cy', f1(WY + 1.5));
					r.setAttribute('rx', f1(on ? 9 + tr * 66 : 0));
					r.setAttribute('ry', f1(on ? 2.4 + tr * 9 : 0));
					r.setAttribute('opacity', on ? Math.max(0, 0.9 - tr * 0.8).toFixed(2) : '0');
				});
			};
			scene(card, RUN, (x) => draw(x * RUN));
		}
	}
</script>
