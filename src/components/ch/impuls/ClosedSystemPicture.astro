---
/**
 * Picture to the closed system: two carts (1 kg and 2 kg) at the moment of impact on a smooth level track. The
 * internal forces F₁ and F₂ (green) are equal and opposite; the external forces (gray) are the forces of gravity and
 * the normal forces of the track, which balance on each cart (arrows 28 px per 9,8 N). The internal forces are not to
 * the scale of the external ones: during an impact they are much larger.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const Y = 110; // middle of the bodies
const C = 170; // the point of contact
const carts = [
	{ x0: 70, w: 100, m: 1, kind: 'ip-cart1', lx: 92 },
	{ x0: C, w: 120, m: 2, kind: 'ip-cart2', lx: 262 },
].map((c) => ({ ...c, cx: c.x0 + c.w / 2 }));
const K = 30; // px per 9,8 N
const ext = carts.map((c, i) => ({
	i: i + 1,
	cx: c.cx,
	g: arrow(c.cx, Y, c.cx, Y + K * c.m, 9, 4.5),
	n: arrow(c.cx, Y, c.cx, Y - K * c.m, 9, 4.5),
	gy: Y + K * c.m,
	ny: Y - K * c.m,
}));
const F1 = arrow(C, Y - 6, C - 42, Y - 6, 10, 5);
const F2 = arrow(C, Y - 6, C + 42, Y - 6, 10, 5);
---

<ImpPicStyles />
<figure class="ip-pic ip-pic--one not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 0 340 236" role="img" aria-label="Две тележки в момент удара. Они действуют друг на друга с силами F1 и F2, равными по модулю и противоположными по направлению, — это внутренние силы. Внешние силы — силы тяжести и силы реакции дорожки — на каждой тележке уравновешивают друг друга">
			<line class="ip-track" x1="30" x2="310" y1="146" y2="146" />
			{
				carts.map((c) => (
					<g>
						<rect class={c.kind} x={c.x0} y={Y - 20} width={c.w} height="40" rx="5" />
						<circle class="ip-wheel" cx={c.x0 + 13} cy="139" r="7" />
						<circle class="ip-wheel" cx={c.x0 + c.w - 13} cy="139" r="7" />
						<text class="ip-small" x={c.lx} y={Y + 15} text-anchor="middle">{c.m} кг</text>
					</g>
				))
			}
			{
				ext.map((e) => (
					<g>
						<path class="ip-arrow ip-arrow--ext" d={e.g.shaft} />
						<polygon class="ip-head--ext" points={e.g.head} />
						<path class="ip-arrow ip-arrow--ext" d={e.n.shaft} />
						<polygon class="ip-head--ext" points={e.n.head} />
						<circle class="cs-dot" cx={e.cx} cy={Y} r="2.4" />
						<text class="ip-math" x={e.cx + 7} y={e.ny + 8}>N<tspan class="ip-sub" dy="4">{e.i}</tspan></text>
						<text class="ip-math" x={e.cx + 7} y={e.gy + (e.i === 1 ? 16 : 2)}>m<tspan class="ip-sub" dy="4">{e.i}</tspan><tspan dy="-4">g</tspan></text>
					</g>
				))
			}
			<path class="ip-arrow ip-arrow--f" d={F1.shaft} />
			<polygon class="ip-head--f" points={F1.head} />
			<path class="ip-arrow ip-arrow--f" d={F2.shaft} />
			<polygon class="ip-head--f" points={F2.head} />
			<text class="ip-math ip-tf" x={C - 22} y={Y + 12} text-anchor="middle">F<tspan class="ip-sub" dy="4">1</tspan></text>
			<text class="ip-math ip-tf" x={C + 22} y={Y + 12} text-anchor="middle">F<tspan class="ip-sub" dy="4">2</tspan></text>
			<text class="ip-small ip-tf" x="170" y="206" text-anchor="middle">внутренние силы: тележки действуют друг на друга</text>
			<text class="ip-small" x="170" y="224" text-anchor="middle">внешние силы: Земля и дорожка, они уравновешены</text>
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Две тележки — система тел. Силы, с которыми тележки действуют друг на друга, — внутренние. Сила тяжести и сила реакции дорожки — внешние; на каждую тележку они действуют уравновешенно. Поэтому две тележки на гладкой дорожке — замкнутая система.</figcaption>
	</div>
</figure>

<style>
	.cs-dot {
		fill: var(--sl-color-gray-1);
	}
</style>
