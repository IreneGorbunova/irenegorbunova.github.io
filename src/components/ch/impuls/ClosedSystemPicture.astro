---
/**
 * Picture to «almost closed» systems (static, not to scale; two panels, stacked on a phone).
 * Panel 1 «Выстрел с платформы»: a cannon on a railway flatcar (together 2 т) fires a shell of 10 кг at 30° above the
 *   horizontal. External forces (gray): gravity of the whole system (M + m)g down and the normal forces of the rails N
 *   up. While the shell moves in the barrel the cannon presses down on the rails harder than its weight, so the sum of
 *   the N arrows (2 × 38 px) is drawn longer than (M + m)g (56 px). Friction on the rails is left out, so no external
 *   force acts along the rails (axis Ox): the projection p_x of the system's momentum is kept, p_y is not. Internal
 *   forces (green): the gases push the shell forward along the barrel (F₂) and the cannon backward (F₁), equal and
 *   opposite (26 px each).
 * Panel 2 «Столкновение на перекрёстке» (top view): car 1 drives north, car 2 east; they collide in the middle of the
 *   crossing. The impact lasts a fraction of a second and the forces between the cars are much larger than the friction
 *   of the tyres on the road, so for the impact the two cars are a closed system: the momentum of the stuck pair right
 *   after the impact is p = p₁ + p₂ (tip to tail in the corner). Letters only, generic lengths (p₁ 60 px, p₂ 45 px), so
 *   that the picture does not give the answer of the chapter's task about cars at a crossing.
 */
import ImpPicStyles from './ImpPicStyles.astro';
import { arrow } from './pic';

const D = Math.PI / 180;
// panel 1
const RAIL = 200;
const piv = { x: 150, y: 140 };
const dir = { x: Math.cos(30 * D), y: -Math.sin(30 * D) };
const breech = { x: piv.x - 30 * dir.x, y: piv.y - 30 * dir.y };
const muzzle = { x: piv.x + 72 * dir.x, y: piv.y + 72 * dir.y };
const shell = { x: muzzle.x + 12 * dir.x, y: muzzle.y + 12 * dir.y };
const F2 = arrow(shell.x + 7 * dir.x, shell.y + 7 * dir.y, shell.x + 33 * dir.x, shell.y + 33 * dir.y, 10, 5);
const F1 = arrow(breech.x, breech.y, breech.x - 26 * dir.x, breech.y - 26 * dir.y, 10, 5);
const N1 = arrow(64, 180, 64, 142, 9, 4.5);
const N2 = arrow(216, 180, 216, 142, 9, 4.5);
const G = arrow(140, 178, 140, 234, 9, 4.5);
const ox = arrow(18, 112, 54, 112, 7, 3.5);
const oy = arrow(18, 112, 18, 76, 7, 3.5);
const barrel = (w: number) =>
	`M ${(breech.x + dir.y * w).toFixed(1)} ${(breech.y - dir.x * w).toFixed(1)} L ${(muzzle.x + (dir.y * w) / 1.4).toFixed(1)} ${(muzzle.y - (dir.x * w) / 1.4).toFixed(1)} L ${(muzzle.x - (dir.y * w) / 1.4).toFixed(1)} ${(muzzle.y + (dir.x * w) / 1.4).toFixed(1)} L ${(breech.x - dir.y * w).toFixed(1)} ${(breech.y + dir.x * w).toFixed(1)} Z`;
const shellPath = `M -7 -3.5 L 4 -3.5 Q 10 -3.5 12 0 Q 10 3.5 4 3.5 L -7 3.5 Z`;
// panel 2: the crossing, centre C; car 1 northbound below it, car 2 eastbound left of it
const C = { x: 140, y: 130 };
const p1A = arrow(C.x + 18, 216, C.x + 18, 156, 10, 5.5);
const p2A = arrow(76, C.y - 18, 121, C.y - 18, 10, 5.5);
const V0 = { x: 222, y: 222 };
const s2 = arrow(V0.x, V0.y, V0.x + 45, V0.y, 10, 5.5);
const s1 = arrow(V0.x + 45, V0.y, V0.x + 45, V0.y - 60, 10, 5.5);
const sp = arrow(V0.x, V0.y, V0.x + 45, V0.y - 60, 10, 5.5);
const dirP = { x: 45 / 75, y: -60 / 75 };
---

<ImpPicStyles />
<figure class="ip-pic cs not-content">
	<div class="ip-pic__grid">
		<svg class="ip-pic__svg" viewBox="0 0 320 250" role="img" aria-label="Пушка на железнодорожной платформе стреляет снарядом вверх под углом 30 градусов. Пороховые газы толкают снаряд вперёд, а пушку назад — это внутренние силы. Внешние силы — сила тяжести и силы реакции рельсов — направлены вертикально, вдоль рельсов внешних сил нет">
			<text class="ip-title" x="14" y="22">Выстрел с платформы</text>
			<path class="ip-arrow ip-axis" d={ox.shaft}></path>
			<polygon class="cs-axhead" points={ox.head}></polygon>
			<path class="ip-arrow ip-axis" d={oy.shaft}></path>
			<polygon class="cs-axhead" points={oy.head}></polygon>
			<text class="ip-math" x="58" y="116">x</text>
			<text class="ip-math" x="24" y="80">y</text>
			<!-- rails, sleepers, flatcar -->
			<path class="cs-sleeper" d={Array.from({ length: 16 }, (_, i) => `M ${6 + i * 20} ${RAIL + 1} l -4 7`).join(' ')}></path>
			<line class="cs-rail" x1="0" x2="320" y1={RAIL} y2={RAIL}></line>
			{[72, 96, 184, 208].map((x) => <circle class="ip-wheel" cx={x} cy={RAIL - 8} r="8" />)}
			<path class="cs-bogie" d="M 66 186 H 102 M 178 186 H 214"></path>
			<rect class="cs-deck" x="46" y="168" width="188" height="12" rx="2"></rect>
			<!-- the cannon: carriage, barrel, the shell just out of the muzzle -->
			<path class="cs-carriage" d={`M 122 168 L 132 ${piv.y - 2} L 168 ${piv.y - 2} L 178 168 Z`}></path>
			<path class="cs-barrel" d={barrel(6)}></path>
			<circle class="cs-pivot" cx={piv.x} cy={piv.y} r="4"></circle>
			<path class="cs-flash" d={`M ${muzzle.x.toFixed(1)} ${muzzle.y.toFixed(1)} l 4 -9 l 2 7 l 7 -4 l -4 8 l 8 2 l -9 3 l 3 7 l -8 -4 Z`}></path>
			<path class="cs-shell" d={shellPath} transform={`translate(${shell.x.toFixed(1)} ${shell.y.toFixed(1)}) rotate(-30)`}></path>
			<!-- internal forces -->
			<path class="ip-arrow ip-arrow--f" d={F2.shaft}></path>
			<polygon class="ip-head--f" points={F2.head}></polygon>
			<text class="ip-math ip-tf" x="270" y="70">F<tspan class="ip-sub" dy="4">2</tspan></text>
			<path class="ip-arrow ip-arrow--f" d={F1.shaft}></path>
			<polygon class="ip-head--f" points={F1.head}></polygon>
			<text class="ip-math ip-tf" x="82" y="157">F<tspan class="ip-sub" dy="4">1</tspan></text>
			<!-- external forces -->
			<path class="ip-arrow ip-arrow--ext" d={N1.shaft}></path>
			<polygon class="ip-head--ext" points={N1.head}></polygon>
			<path class="ip-arrow ip-arrow--ext" d={N2.shaft}></path>
			<polygon class="ip-head--ext" points={N2.head}></polygon>
			<text class="ip-math" x="52" y="150" text-anchor="end">N</text>
			<text class="ip-math" x="224" y="150">N</text>
			<path class="ip-arrow ip-arrow--ext" d={G.shaft}></path>
			<polygon class="ip-head--ext" points={G.head}></polygon>
			<circle class="cs-dot" cx="140" cy="178" r="2.4"></circle>
			<text class="ip-math" x="148" y="236">(M + m)g</text>
		</svg>
		<svg class="ip-pic__svg" viewBox="0 0 320 250" role="img" aria-label="Перекрёсток, вид сверху. Одна машина едет на север, другая на восток, они сталкиваются в центре перекрёстка. На время короткого удара две машины можно считать замкнутой системой: импульс сцепившихся машин сразу после удара равен сумме их импульсов до удара">
			<text class="ip-title" x="14" y="22">Столкновение на перекрёстке</text>
			<!-- the roads -->
			<rect class="cs-road" x={C.x - 24} y="30" width="48" height="220"></rect>
			<rect class="cs-road" x="0" y={C.y - 24} width="320" height="48"></rect>
			<path class="cs-lane" d={`M ${C.x} 34 V ${C.y - 30} M ${C.x} ${C.y + 30} V 250 M 0 ${C.y} H ${C.x - 30} M ${C.x + 30} ${C.y} H 320`}></path>
			<!-- after the impact: the stuck pair goes on along p (dashed) -->
			<path class="cs-after" d={`M ${C.x} ${C.y} L ${(C.x + dirP.x * 90).toFixed(1)} ${(C.y + dirP.y * 90).toFixed(1)}`}></path>
			<!-- the cars just before the impact (car 1 nose up, car 2 nose right) -->
			<g transform={`translate(${C.x} ${C.y + 30})`}>
				<rect class="cs-car1" x="-8" y="0" width="16" height="28" rx="4"></rect>
				<rect class="cs-glass" x="-6" y="5" width="12" height="6" rx="1.5"></rect>
			</g>
			<g transform={`translate(${C.x - 30} ${C.y})`}>
				<rect class="cs-car2" x="-28" y="-8" width="28" height="16" rx="4"></rect>
				<rect class="cs-glass" x="-11" y="-6" width="6" height="12" rx="1.5"></rect>
			</g>
			<path class="ip-arrow ip-arrow--p" d={p1A.shaft}></path>
			<polygon class="ip-head--p" points={p1A.head}></polygon>
			<text class="ip-math ip-tp" x={C.x + 26} y="196">p<tspan class="ip-sub" dy="4">1</tspan></text>
			<path class="ip-arrow ip-arrow--p" d={p2A.shaft}></path>
			<polygon class="ip-head--p" points={p2A.head}></polygon>
			<text class="ip-math ip-tp" x="70" y={C.y - 10} text-anchor="end">p<tspan class="ip-sub" dy="4">2</tspan></text>
			<!-- the sum, tip to tail -->
			<path class="ip-arrow ip-arrow--p" d={s2.shaft}></path>
			<polygon class="ip-head--p" points={s2.head}></polygon>
			<path class="ip-arrow ip-arrow--p" d={s1.shaft}></path>
			<polygon class="ip-head--p" points={s1.head}></polygon>
			<path class="ip-arrow cs-sum" d={sp.shaft}></path>
			<polygon class="cs-sumhead" points={sp.head}></polygon>
			<text class="ip-math ip-tp" x={V0.x + 20} y={V0.y + 18}>p<tspan class="ip-sub" dy="4">2</tspan></text>
			<text class="ip-math ip-tp" x={V0.x + 52} y={V0.y - 26}>p<tspan class="ip-sub" dy="4">1</tspan></text>
			<text class="ip-math cs-tsum" x={V0.x - 4} y={V0.y - 34} text-anchor="end">p</text>
		</svg>
	</div>
	<div class="ip-pic__foot">
		<figcaption>Первый рисунок: вдоль рельсов внешних сил нет, и сохраняется проекция импульса <i>p<sub>x</sub></i>; по вертикали внешние силы не уравновешены. Второй: на время короткого удара две машины — замкнутая система, <i>p</i> = <i>p</i><sub>1</sub> + <i>p</i><sub>2</sub>. Стрелки не в масштабе.</figcaption>
	</div>
</figure>

<style>
	.cs-axhead {
		fill: var(--sl-color-gray-3);
	}
	.cs-rail {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.cs-sleeper {
		stroke: var(--sl-color-gray-4);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.cs-bogie {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.cs-deck {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.cs-carriage {
		fill: color-mix(in oklab, hsl(120, 20%, 40%) 45%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.cs-barrel {
		fill: color-mix(in oklab, hsl(120, 15%, 35%) 50%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.cs-pivot {
		fill: var(--sl-color-gray-2);
	}
	.cs-flash {
		fill: color-mix(in oklab, var(--ig-v) 70%, transparent);
	}
	.cs-shell {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.cs-dot {
		fill: var(--sl-color-gray-1);
	}
	.cs-road {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 80%, var(--sl-color-bg));
	}
	.cs-lane {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 6 5;
	}
	.cs-after {
		fill: none;
		stroke: var(--imp-sum);
		stroke-width: 1.3;
		stroke-dasharray: 3 4;
	}
	.cs-car1 {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.cs-car2 {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.cs-glass {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 60%, var(--sl-color-bg));
	}
	.cs-sum {
		stroke: var(--imp-sum);
		stroke-width: 4;
	}
	.cs-sumhead {
		fill: var(--imp-sum);
	}
	.ip-pic .cs-tsum {
		fill: var(--imp-sum);
		font-weight: 700;
	}
</style>
