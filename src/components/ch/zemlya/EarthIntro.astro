---
/**
 * Two short looping opening scenes of «Земля — планета». No terms of the chapter in the pictures; the captions'
 * popovers explain.
 * Shadow: Moscow (55,75° N) at true noon, from 21 June to 21 December 2026 in 8 s. A person 1,7 m tall (20 px per m)
 *   and the shadow on level ground; the Sun's noon height h = 90° − φ + δ with the Sun's declination δ of that day
 *   (sun.ts), the shadow 1,7 м / tg h: 1,1 m in June (h = 57,7°), 8,9 m in December (h = 10,8°). A dashed ray from
 *   the Sun through the top of the head ends at the tip of the shadow. Leaves turn and fall, snow comes.
 * Stars: the sky to the north from Moscow from 22:00 to 4:00 (6 h of solar time = 90,25° of the Earth's turn against
 *   the stars). Real stars (J2000, Big Dipper, Cassiopeia, Polaris and a few others) as a wide-angle camera pointed
 *   north at 32° above the horizon sees them (gnomonic projection); each star leaves its trail, an arc around the
 *   celestial pole. Polaris, 0,74° from the pole, draws a tiny circle.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

// Shadow scene: ground, the person and the tree.
const GY = 196; // ground level
const PX = 118; // the person's feet
const TX = 330; // the tree
---

<IntroFrame data-zintro>
	<div class="intro__card" data-scene="shadow">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Москва, полдень. В июне Солнце стоит высоко, и тень человека короче его роста. К декабрю Солнце в полдень опускается всё ниже, а тень становится в пять раз длиннее человека">
			<rect class="zi-sky" x="0" y="0" width="360" height={GY}></rect>
			<rect class="zi-grass" x="0" y={GY} width="360" height={240 - GY}></rect>
			<rect class="zi-snow" x="0" y={GY} width="360" height={240 - GY} data-snow></rect>
			<line class="zi-edge" x1="0" y1={GY} x2="360" y2={GY}></line>
			<!-- the tree -->
			<path class="zi-trunk" d={`M${TX - 3} ${GY} L${TX - 2} ${GY - 52} L${TX + 2} ${GY - 52} L${TX + 3} ${GY} Z M${TX} ${GY - 40} L${TX - 14} ${GY - 62} M${TX} ${GY - 46} L${TX + 13} ${GY - 66} M${TX} ${GY - 52} L${TX} ${GY - 74}`}></path>
			<g class="zi-leaves" data-leaves>
				<circle cx={TX - 12} cy={GY - 66} r="13"></circle>
				<circle cx={TX + 11} cy={GY - 68} r="14"></circle>
				<circle cx={TX} cy={GY - 80} r="14"></circle>
				<circle cx={TX} cy={GY - 58} r="12"></circle>
			</g>
			<!-- the shadow and the ray -->
			<path class="zi-shadow" data-shadow></path>
			<line class="zi-ray" data-ray></line>
			<path class="zi-arc" data-arc></path>
			<text class="zi-deg" data-deg></text>
			<!-- the person, 1,7 m -->
			<g class="zi-man">
				<path d={`M${PX - 4} ${GY} L${PX - 1} ${GY - 15} M${PX + 4} ${GY} L${PX + 1} ${GY - 15} M${PX} ${GY - 15} L${PX} ${GY - 27} M${PX} ${GY - 25} L${PX - 5} ${GY - 15} M${PX} ${GY - 25} L${PX + 5} ${GY - 15}`}></path>
				<circle cx={PX} cy={GY - 30.5} r="3.5"></circle>
			</g>
			<g data-sun>
				<circle class="zi-glow" r="17"></circle>
				<circle class="zi-sun" r="10"></circle>
			</g>
			<!-- readings -->
			<rect class="zi-pill" x="8" y="8" width="142" height="24" rx="12"></rect>
			<text class="zi-read" x="79" y="25" text-anchor="middle" data-date>Полдень, 21 июня</text>
			<rect class="zi-pill" x="218" y="8" width="134" height="24" rx="12"></rect>
			<text class="zi-read" x="285" y="25" text-anchor="middle" data-len>тень 1,1 м</text>
			<text class="zi-small" x="16" y="50">Москва</text>
		</svg>
		<div class="intro__foot">
			<p>В Москве в июньский полдень тень человека короче его роста, а в декабрьский — в пять раз длиннее: <More term="зимой Солнце даже в полдень стоит низко">В Москве 21 июня Солнце в полдень поднимается на 58° над горизонтом, и тень человека ростом 1,7&nbsp;м — около 1,1&nbsp;м. 21 декабря — только на 11°, и тень почти 9&nbsp;м. Почему так, рассказано в разделах <a href="#высота-солнца-в-полдень">«Высота Солнца в полдень»</a> и <a href="#почему-бывают-лето-и-зима">«Почему бывают лето и зима»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="stars">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ночное небо на севере с 22 часов до 4 часов утра. Звёзды, среди них ковш Большой Медведицы и Кассиопея, оставляют дуги вокруг Полярной звезды, а она сама почти не двигается">
			<rect class="zi-night" x="0" y="0" width="360" height="240"></rect>
			<g data-trails></g>
			<g data-figures></g>
			<g data-stars></g>
			<text class="zi-label" data-polaris-label>Полярная</text>
			<!-- the ground: roofs and trees to the north -->
			<path class="zi-land" data-land></path>
			<g class="zi-windows" data-windows></g>
			<rect class="zi-pill" x="8" y="8" width="70" height="24" rx="12"></rect>
			<text class="zi-read" x="43" y="25" text-anchor="middle" data-clock>22:00</text>
			<text class="zi-small zi-small--n" x="180" y="232" text-anchor="middle">север</text>
		</svg>
		<div class="intro__foot">
			<p>За ночь звёзды описывают дуги вокруг Полярной звезды, а она сама почти не двигается. Это <More term="поворачивается сама Земля">Ось вращения Земли направлена почти точно на Полярную звезду: она отстоит от оси меньше чем на 1°. Земля поворачивается на 15° в час, и на столько же за час поворачивается для нас всё звёздное небо — за 6 часов на четверть оборота. Подробнее — в разделе <a href="#звёздные-и-солнечные-сутки">«Звёздные и солнечные сутки»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-zintro] {
		--zi-night: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-black));
		--zi-star: var(--sl-color-white);
		--zi-land: color-mix(in srgb, var(--sl-color-gray-6) 70%, var(--sl-color-black));
		--zi-shadow: color-mix(in srgb, var(--sl-color-black) 75%, transparent);
		--zi-snow: color-mix(in srgb, var(--sl-color-white) 82%, var(--ig-vx));
	}
	:root[data-theme='light'] [data-zintro] {
		--zi-night: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-1));
		--zi-star: var(--sl-color-black);
		--zi-land: var(--sl-color-white);
		--zi-shadow: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
		--zi-snow: color-mix(in srgb, var(--sl-color-black) 92%, var(--ig-vx));
	}
	.zi-sky {
		fill: color-mix(in srgb, var(--ig-vx) 14%, transparent);
	}
	.zi-grass {
		fill: color-mix(in srgb, var(--sl-color-green) 30%, var(--sl-color-gray-5));
	}
	.zi-snow {
		fill: var(--zi-snow);
	}
	.zi-edge {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
	}
	.zi-trunk {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-3));
		stroke: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-3));
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.zi-leaves circle {
		fill: var(--zi-leaf, var(--sl-color-green));
		opacity: 0.85;
	}
	.zi-shadow {
		fill: var(--zi-shadow);
	}
	.zi-ray {
		stroke: var(--ig-v);
		stroke-width: 1.4;
		stroke-dasharray: 4 4;
	}
	.zi-arc {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.6;
	}
	.zi-deg {
		font-size: 13px;
		font-weight: 700;
		fill: var(--ig-v);
		paint-order: stroke fill;
		stroke: var(--ig-surface);
		stroke-width: 3px;
	}
	.zi-man path {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.zi-man circle {
		fill: var(--ig-vy);
	}
	.zi-sun {
		fill: var(--ig-v);
	}
	.zi-glow {
		fill: color-mix(in srgb, var(--ig-v) 25%, transparent);
	}
	.zi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.zi-read {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.zi-small {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.zi-small--n {
		fill: var(--sl-color-gray-3);
	}
	/* stars scene */
	.zi-night {
		fill: var(--zi-night);
	}
	.zi-trail {
		fill: none;
		stroke: var(--zi-star);
		stroke-linecap: round;
		opacity: 0.45;
	}
	.zi-star {
		fill: var(--zi-star);
	}
	.zi-star--polaris {
		fill: var(--ig-v);
	}
	.zi-fig {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, var(--zi-star));
		stroke-width: 0.9;
		opacity: 0.55;
	}
	.zi-label {
		font-size: 12px;
		fill: var(--ig-v);
		paint-order: stroke fill;
		stroke: var(--zi-night);
		stroke-width: 3px;
	}
	.zi-land {
		fill: var(--zi-land);
	}
	.zi-windows rect {
		fill: var(--ig-v);
		opacity: 0.8;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { sunAt, dateLabel, DEG } from './sun';

	const NS = 'http://www.w3.org/2000/svg';
	const el = (parent: Element, tag: string, attrs: Record<string, string | number>) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		parent.append(e);
		return e;
	};
	const comma = (x: number, d = 1) => x.toFixed(d).replace('.', ',');
	const LAT = 55.75; // Moscow

	for (const root of document.querySelectorAll<HTMLElement>('[data-zintro]')) {
		// ---------- Shadow: 21 June → 21 December in 8 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="shadow"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const GY = 196;
			const PX = 118;
			const HM = 1.7; // the person's height, m
			const K = 20; // px per m
			const top: [number, number] = [PX, GY - HM * K];
			const D_SUN = 98; // the Sun is drawn this far from the top of the head, along the ray
			const sun = $<SVGGElement>('[data-sun]');
			const shadow = $<SVGPathElement>('[data-shadow]');
			const ray = $<SVGLineElement>('[data-ray]');
			const arc = $<SVGPathElement>('[data-arc]');
			const deg = $<SVGTextElement>('[data-deg]');
			const date = $<SVGTextElement>('[data-date]');
			const len = $<SVGTextElement>('[data-len]');
			const snow = $<SVGRectElement>('[data-snow]');
			const leaves = $<SVGGElement>('[data-leaves]');
			const D0 = 171; // 21 June 2026 (0 = 1 January)
			const D1 = 354; // 21 December 2026
			scene(card, 8, (x) => {
				const day = D0 + (D1 - D0) * x;
				const { dec } = sunAt(day);
				const h = 90 - LAT + dec; // noon height in Moscow, degrees
				const L = HM / Math.tan(h * DEG); // shadow, m
				const tip = PX + L * K;
				const c = Math.cos(h * DEG);
				const s = Math.sin(h * DEG);
				const sx = top[0] - D_SUN * c;
				const sy = top[1] - D_SUN * s;
				sun.setAttribute('transform', `translate(${sx.toFixed(1)} ${sy.toFixed(1)})`);
				shadow.setAttribute('d', `M${PX - 3} ${GY} L${tip.toFixed(1)} ${GY} L${(tip - 5).toFixed(1)} ${GY + 5} L${PX - 2} ${GY + 5} Z`);
				ray.setAttribute('x1', sx.toFixed(1));
				ray.setAttribute('y1', sy.toFixed(1));
				ray.setAttribute('x2', tip.toFixed(1));
				ray.setAttribute('y2', String(GY));
				// the angle between the ground and the ray, at the tip of the shadow
				const r = 24;
				arc.setAttribute('d', `M${(tip - r).toFixed(1)} ${GY} A${r} ${r} 0 0 1 ${(tip - r * c).toFixed(1)} ${(GY - r * s).toFixed(1)}`);
				const m = (h / 2) * DEG;
				deg.setAttribute('x', (tip - (r + 6) * Math.cos(m) - 26).toFixed(1));
				deg.setAttribute('y', (GY - (r + 6) * Math.sin(m) - Math.max(0, 6 - h / 4)).toFixed(1));
				deg.textContent = `${Math.round(h)}°`;
				date.textContent = `Полдень, ${dateLabel(day)}`;
				len.textContent = `тень ${comma(L)} м`;
				// seasons on the ground: autumn leaves from the end of August, bare from mid-October, snow in December
				const autumn = Math.min(1, Math.max(0, (day - 236) / 40));
				const fall = Math.min(1, Math.max(0, (day - 276) / 20));
				leaves.style.setProperty('--zi-leaf', `color-mix(in srgb, var(--sl-color-orange) ${Math.round(autumn * 100)}%, var(--sl-color-green))`);
				leaves.style.opacity = String(1 - fall);
				snow.style.opacity = String(Math.min(1, Math.max(0, (day - 318) / 22)));
			});
		}

		// ---------- Stars: 22:00 → 4:00 in 8 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="stars"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const trailsG = $<SVGGElement>('[data-trails]');
			const figG = $<SVGGElement>('[data-figures]');
			const starsG = $<SVGGElement>('[data-stars]');
			const clock = $<SVGTextElement>('[data-clock]');
			const polLabel = $<SVGTextElement>('[data-polaris-label]');
			const land = $<SVGPathElement>('[data-land]');
			const windowsG = $<SVGGElement>('[data-windows]');
			// camera: to the north, 32° above the horizon; F px per unit of the tangent plane
			const A0 = 32 * DEG;
			const F = 136;
			const CX = 180;
			const CY = 125;
			const phi = LAT * DEG;
			const proj = (Hdeg: number, decDeg: number): [number, number, number] | null => {
				const H = Hdeg * DEG;
				const d = decDeg * DEG;
				const e = -Math.cos(d) * Math.sin(H); // east
				const n = Math.cos(phi) * Math.sin(d) - Math.sin(phi) * Math.cos(d) * Math.cos(H); // north
				const u = Math.sin(phi) * Math.sin(d) + Math.cos(phi) * Math.cos(d) * Math.cos(H); // up
				const fw = n * Math.cos(A0) + u * Math.sin(A0);
				if (fw < 0.15) return null;
				const up = -n * Math.sin(A0) + u * Math.cos(A0);
				return [CX + (F * e) / fw, CY - (F * up) / fw, u];
			};
			// the horizon (altitude 0) is a straight line in this projection
			const HY = CY + F * Math.tan(A0);
			// stars: RA in hours, Dec in degrees (J2000), magnitude
			type S = { ra: number; dec: number; mag: number };
			const DIPPER: S[] = [
				{ ra: 11.062, dec: 61.751, mag: 1.8 },
				{ ra: 11.031, dec: 56.383, mag: 2.4 },
				{ ra: 11.897, dec: 53.695, mag: 2.4 },
				{ ra: 12.257, dec: 57.033, mag: 3.3 },
				{ ra: 12.9, dec: 55.96, mag: 1.8 },
				{ ra: 13.399, dec: 54.925, mag: 2.2 },
				{ ra: 13.792, dec: 49.313, mag: 1.9 },
			];
			const CASS: S[] = [
				{ ra: 0.153, dec: 59.15, mag: 2.3 },
				{ ra: 0.675, dec: 56.537, mag: 2.2 },
				{ ra: 0.945, dec: 60.717, mag: 2.2 },
				{ ra: 1.43, dec: 60.235, mag: 2.7 },
				{ ra: 1.906, dec: 63.67, mag: 3.4 },
			];
			const POLARIS: S = { ra: 2.53, dec: 89.264, mag: 2.0 };
			const OTHERS: S[] = [
				{ ra: 5.278, dec: 45.998, mag: 0.1 }, // Capella
				{ ra: 18.616, dec: 38.784, mag: 0.0 }, // Vega
				{ ra: 20.69, dec: 45.28, mag: 1.3 }, // Deneb
				{ ra: 3.405, dec: 49.861, mag: 1.8 }, // Mirfak
				{ ra: 14.845, dec: 74.156, mag: 2.1 }, // Kochab
				{ ra: 15.345, dec: 71.834, mag: 3.0 }, // Pherkad
				{ ra: 17.507, dec: 52.301, mag: 2.8 }, // Rastaban
				{ ra: 17.943, dec: 51.489, mag: 2.2 }, // Eltanin
				{ ra: 14.073, dec: 64.376, mag: 3.7 }, // Thuban
				{ ra: 21.31, dec: 62.585, mag: 2.5 }, // Alderamin
				{ ra: 9.525, dec: 63.062, mag: 3.6 }, // 23 UMa
				{ ra: 9.849, dec: 59.039, mag: 3.8 }, // 24 UMa area
				{ ra: 8.987, dec: 48.042, mag: 3.1 }, // Talitha
				{ ra: 10.372, dec: 41.499, mag: 3.1 }, // Tania Australis
				{ ra: 6.379, dec: 56.0, mag: 4.0 },
				{ ra: 7.4, dec: 69.0, mag: 4.2 },
				{ ra: 16.4, dec: 61.5, mag: 2.7 }, // eta Dra
				{ ra: 19.21, dec: 67.66, mag: 3.1 }, // delta Dra
				{ ra: 22.8, dec: 66.2, mag: 3.5 }, // iota Cep
				{ ra: 4.95, dec: 33.17, mag: 2.7 }, // iota Aur
				{ ra: 2.07, dec: 42.33, mag: 2.1 }, // Almach
				{ ra: 1.16, dec: 35.62, mag: 2.1 }, // Mirach
			];
			// a few faint stars, the same on every load
			let seed = 5;
			const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
			const FAINT: S[] = Array.from({ length: 46 }, () => ({ ra: rnd() * 24, dec: 30 + Math.asin(rnd()) / DEG * 0.65, mag: 4.2 + rnd() * 0.8 }));
			const ALL = [...DIPPER, ...CASS, POLARIS, ...OTHERS, ...FAINT];
			const rad = (m: number) => Math.max(0.6, 2.4 - 0.42 * m);
			const stars = ALL.map((s) => ({
				s,
				dot: el(starsG, 'circle', { r: rad(s.mag).toFixed(2), class: s === POLARIS ? 'zi-star zi-star--polaris' : 'zi-star' }),
				trail: el(trailsG, 'path', { class: 'zi-trail', 'stroke-width': (rad(s.mag) * 0.9).toFixed(2) }),
			}));
			const figD = (list: S[], H: (s: S) => number) => {
				const pts = list.map((s) => proj(H(s), s.dec));
				if (pts.some((p) => !p || p[2] < 0)) return '';
				return pts.map((p, i) => `${i ? 'L' : 'M'}${p![0].toFixed(1)} ${p![1].toFixed(1)}`).join(' ');
			};
			const dipFig = el(figG, 'path', { class: 'zi-fig' });
			const casFig = el(figG, 'path', { class: 'zi-fig' });
			const DIP_ORDER = [DIPPER[6], DIPPER[5], DIPPER[4], DIPPER[3], DIPPER[0], DIPPER[1], DIPPER[2], DIPPER[3]];
			// the ground: a low line of roofs and trees on the horizon
			const roof = [
				[0, 4], [22, 4], [22, 16], [40, 26], [58, 16], [58, 4], [92, 4], [96, 10], [104, 6], [110, 12], [118, 5], [150, 5],
				[150, 20], [186, 20], [186, 4], [232, 4], [238, 12], [246, 7], [252, 15], [260, 8], [266, 4], [290, 4], [290, 24],
				[302, 30], [314, 24], [314, 4], [360, 4],
			];
			land.setAttribute('d', `M0 240 ${roof.map(([x, h]) => `L${x} ${(HY - h).toFixed(1)}`).join(' ')} L360 240 Z`);
			for (const [x, y] of [[30, 10], [44, 10], [160, 12], [174, 12], [298, 12]]) el(windowsG, 'rect', { x, y: (HY - y).toFixed(1), width: 5, height: 5 });
			// local sidereal time at 22:00 is taken as 23,5 h (an autumn evening); 6 solar hours = 6,0164 sidereal hours
			const LST0 = 23.5;
			const SID = 1.0027379;
			scene(card, 8, (x) => {
				const hours = 6 * x;
				const H = (s: S, t: number) => ((LST0 + SID * t - s.ra) * 15 + 720) % 360;
				for (const st of stars) {
					const p = proj(H(st.s, hours), st.s.dec);
					const on = !!p && p[2] > 0 && p[0] > -4 && p[0] < 364 && p[1] > -4;
					st.dot.style.opacity = on ? '1' : '0';
					if (p) {
						st.dot.setAttribute('cx', p[0].toFixed(1));
						st.dot.setAttribute('cy', p[1].toFixed(1));
					}
					// the trail: from 22:00 to now, every ~2°
					let d = '';
					let pen = false;
					const n = Math.max(1, Math.ceil(hours * 7.5));
					for (let i = 0; i <= n; i++) {
						const q = proj(H(st.s, (hours * i) / n), st.s.dec);
						if (!q || q[2] < -0.02) {
							pen = false;
							continue;
						}
						d += `${pen ? 'L' : 'M'}${q[0].toFixed(1)} ${q[1].toFixed(1)}`;
						pen = true;
					}
					st.trail.setAttribute('d', hours > 0.02 ? d : '');
				}
				dipFig.setAttribute('d', figD(DIP_ORDER, (s) => H(s, hours)));
				casFig.setAttribute('d', figD([...CASS], (s) => H(s, hours)));
				const pp = proj(H(POLARIS, hours), POLARIS.dec)!;
				polLabel.setAttribute('x', (pp[0] + 7).toFixed(1));
				polLabel.setAttribute('y', (pp[1] - 6).toFixed(1));
				const hh = (22 + Math.floor(hours)) % 24;
				const mm = Math.floor((hours % 1) * 60);
				clock.textContent = `${hh}:${String(mm).padStart(2, '0')}`;
			});
		}
	}
</script>
