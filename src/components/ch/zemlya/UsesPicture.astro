---
/**
 * Small pictures for «Где это встречается».
 * Time zones: the Earth seen from above the North Pole, 24 zones of 15°, the Sun to the left; Moscow at noon, and
 *   Vladivostok 7 zones (105°) to the east, in the direction of rotation: 19:00, just past the evening terminator.
 * Leap year: a calendar page with 29 February.
 * Solar panel: tilted towards the south (the Sun at noon), the rays fall on it square-on.
 * Launch sites: the Earth from the side, the parallels of Kourou (5° N) and Baikonur (46° N) and the speeds of
 *   rotation at their front points to one scale (0,1 px per m/s): 463 and 323 m/s.
 */
import PicStyles from './PicStyles.astro';

const f = (x: number) => x.toFixed(1);
const rad = (d: number) => (d * Math.PI) / 180;
// time zones
const TZ = { x: 100, y: 68, r: 50 };
const at = (a: number, r: number) => [TZ.x + r * Math.cos(rad(a)), TZ.y - r * Math.sin(rad(a))];
const [mx, my] = at(180, TZ.r);
const [vx, vy] = at(285, TZ.r);
// launch sites
const LS = { x: 76, y: 74, r: 52 };
const par = (lat: number) => ({ y: LS.y - LS.r * Math.sin(rad(lat)), rx: LS.r * Math.cos(rad(lat)) });
const kourou = par(5);
const baik = par(46);
const uid = Math.random().toString(36).slice(2, 8);
---

<PicStyles />
<figure class="zp zuse not-content">
	<div class="zuse__grid">
		<div>
			<svg class="zp__svg" viewBox="0 0 200 150" role="img" aria-label="Земля, вид над Северным полюсом, поделена на 24 часовых пояса. Солнце слева: в Москве полдень, во Владивостоке, на семь поясов восточнее, 19 часов">
				<circle class="zp-earth" cx={TZ.x} cy={TZ.y} r={TZ.r}></circle>
				<path class="zp-nightside" d={`M${TZ.x} ${TZ.y - TZ.r} A${TZ.r} ${TZ.r} 0 0 1 ${TZ.x} ${TZ.y + TZ.r} Z`}></path>
				{Array.from({ length: 24 }, (_, i) => {
					const [x, y] = at(i * 15 + 7.5, TZ.r);
					return <line class="zuse-zone" x1={TZ.x} y1={TZ.y} x2={f(x)} y2={f(y)} />;
				})}
				<path class="zp-arc" d={`M${f(TZ.x + 18)} ${TZ.y} A18 18 0 0 0 ${TZ.x} ${TZ.y - 18}`} marker-end={`url(#zu-r-${uid})`}></path>
				<circle class="zuse-city" cx={f(mx)} cy={f(my)} r="3.5"></circle>
				<circle class="zuse-city" cx={f(vx)} cy={f(vy)} r="3.5"></circle>
				<text x={f(mx + 6)} y={f(my - 22)} class="zp-t-small">Москва</text>
				<text x={f(mx + 6)} y={f(my - 9)} class="zp-t-small zp-t-hl">12:00</text>
				<text x={f(vx + 4)} y={f(vy + 14)} class="zp-t-small">Владивосток</text>
				<text x={f(vx + 4)} y={f(vy + 27)} class="zp-t-small zp-t-hl">19:00</text>
				<text x="4" y="14" class="zp-t-small">← Солнце</text>
				<defs>
					<marker id={`zu-r-${uid}`} viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto">
						<path class="zp-head" d="M0 0 L10 5 L0 10 z"></path>
					</marker>
				</defs>
			</svg>
			<p class="zp__label">Часовые пояса</p>
		</div>
		<div>
			<svg class="zp__svg" viewBox="0 0 200 150" role="img" aria-label="Листок календаря: 29 февраля, раз в 4 года">
				<rect class="zuse-page" x="56" y="22" width="88" height="104" rx="8"></rect>
				<rect class="zuse-top" x="56" y="22" width="88" height="26" rx="8"></rect>
				<rect class="zuse-top" x="56" y="38" width="88" height="10"></rect>
				<text x="100" y="40" text-anchor="middle" class="zp-t-small zuse-white">февраль</text>
				<text x="100" y="100" text-anchor="middle" class="zuse-big">29</text>
				<text x="100" y="144" text-anchor="middle" class="zp-t-small">раз в 4 года</text>
			</svg>
			<p class="zp__label">Високосный год</p>
		</div>
		<div>
			<svg class="zp__svg" viewBox="0 0 200 150" role="img" aria-label="Солнечная батарея стоит наклонно и повёрнута к югу, к полуденному Солнцу. Лучи падают на неё почти отвесно">
				<rect class="zuse-ground" x="0" y="122" width="200" height="28"></rect>
				<line class="zuse-leg" x1="104" y1="122" x2="104" y2="96"></line>
				<line class="zuse-leg" x1="136" y1="122" x2="136" y2="76"></line>
				{/* the panel, tilted by 35° and facing the Sun at h = 55° */}
				<line class="zuse-panel" x1="86" y1="108" x2="152" y2="62"></line>
				{[0.2, 0.5, 0.8].map((s) => {
					const px = 86 + 66 * s;
					const py = 108 - 46 * s;
					const ux = -Math.cos(rad(55));
					const uy = -Math.sin(rad(55));
					return <line class="zp-ray" x1={f(px + 62 * ux)} y1={f(py + 62 * uy)} x2={f(px + 4 * ux)} y2={f(py + 4 * uy)} marker-end={`url(#zu-s-${uid})`} />;
				})}
				<text x="6" y="140" class="zp-t-small">юг</text>
				<text x="194" y="140" class="zp-t-small" text-anchor="end">север</text>
				<defs>
					<marker id={`zu-s-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
						<path class="zp-head" d="M0 0 L10 5 L0 10 z"></path>
					</marker>
				</defs>
			</svg>
			<p class="zp__label">Солнечные батареи</p>
		</div>
		<div>
			<svg class="zp__svg" viewBox="0 0 200 150" role="img" aria-label="Земля сбоку. Космодром Куру у экватора движется вместе с Землёй со скоростью 463 м/с, Байконур — 323 м/с">
				<circle class="zp-earth" cx={LS.x} cy={LS.y} r={LS.r}></circle>
				<line class="zp-axis" x1={LS.x} y1={LS.y - LS.r - 10} x2={LS.x} y2={LS.y + LS.r + 10}></line>
				<path class="zuse-par" d={`M${f(LS.x - kourou.rx)} ${f(kourou.y)} A${f(kourou.rx)} ${f(kourou.rx * 0.18)} 0 0 0 ${f(LS.x + kourou.rx)} ${f(kourou.y)}`}></path>
				<path class="zuse-par" d={`M${f(LS.x - baik.rx)} ${f(baik.y)} A${f(baik.rx)} ${f(baik.rx * 0.18)} 0 0 0 ${f(LS.x + baik.rx)} ${f(baik.y)}`}></path>
				<line class="zuse-v" x1={LS.x} y1={f(kourou.y + kourou.rx * 0.18)} x2={f(LS.x + 46.3)} y2={f(kourou.y + kourou.rx * 0.18)} marker-end={`url(#zu-v-${uid})`}></line>
				<line class="zuse-v" x1={LS.x} y1={f(baik.y + baik.rx * 0.18)} x2={f(LS.x + 32.3)} y2={f(baik.y + baik.rx * 0.18)} marker-end={`url(#zu-v-${uid})`}></line>
				<text x="134" y={f(baik.y + 4)} class="zp-t-small">Байконур</text>
				<text x="134" y={f(baik.y + 18)} class="zp-t-small zp-t-hl">323 м/с</text>
				<text x="134" y={f(kourou.y + 10)} class="zp-t-small">Куру</text>
				<text x="134" y={f(kourou.y + 24)} class="zp-t-small zp-t-hl">463 м/с</text>
				<defs>
					<marker id={`zu-v-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
						<path class="zp-head--blue" d="M0 0 L10 5 L0 10 z"></path>
					</marker>
				</defs>
			</svg>
			<p class="zp__label">Космодромы</p>
		</div>
	</div>
</figure>

<style is:global>
	.zuse__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.zuse .zp__label {
		text-align: center;
		font-size: var(--sl-text-xs);
	}
	.zuse-zone {
		stroke: color-mix(in srgb, var(--sl-color-white) 30%, transparent);
		stroke-width: 0.8;
	}
	.zuse-city {
		fill: var(--ig-vy);
	}
	.zuse-page {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.zuse-top {
		fill: var(--ig-vy);
	}
	.zp .zuse-white {
		fill: var(--sl-color-black);
		stroke: none;
	}
	.zp .zuse-big {
		font-size: 46px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.zuse-ground {
		fill: color-mix(in srgb, var(--sl-color-green) 22%, var(--sl-color-gray-5));
	}
	.zuse-leg {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.4;
	}
	.zuse-panel {
		stroke: var(--ig-vx);
		stroke-width: 6;
		stroke-linecap: round;
	}
	.zuse-par {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	.zuse-v {
		stroke: var(--ig-vx);
		stroke-width: 2.4;
	}
	@media (max-width: 40rem) {
		.zuse__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
