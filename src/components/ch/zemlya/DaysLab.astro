---
/**
 * Sidereal and solar day, seen from the north. The Earth turns counter-clockwise and moves along its orbit in the same
 * sense. At t = 0 it is midnight for the observer: the far star and the anti-Sun direction are overhead. After
 * 23 ч 56 мин 4 с the Earth has turned by 360° (the star is overhead again), after 24 ч by 360° + ~1° (midnight).
 * The orbital step of a day (0,986°) and the extra turn are both drawn 15 times larger, so the picture stays
 * consistent: in the last 4 minutes the drawn turn is sped up by the same factor.
 */
const SX = 22;
const SY = 178;
const RO = 280;
---

<figure class="zdl not-content" data-zdl data-geo={JSON.stringify({ SX, SY, RO })}>
	<svg class="zdl__svg" viewBox="0 0 400 228" role="img" aria-label="Звёздные и солнечные сутки: Земля вращается и движется по орбите">
		<circle class="zdl__glow" cx={SX} cy={SY} r="30" />
		<circle class="zdl__sun" cx={SX} cy={SY} r="15" />
		<text class="zdl__t" x={SX - 6} y={SY + 36}>Солнце</text>
		<path class="zdl__orbit" d={`M ${SX + RO * Math.cos(-0.12)} ${SY - RO * Math.sin(-0.12)} A ${RO} ${RO} 0 0 0 ${SX + RO * Math.cos(0.42)} ${SY - RO * Math.sin(0.42)}`} />
		<path class="zdl__star" transform="translate(386 30)" d="M0 -6 L1.5 -1.5 L6 0 L1.5 1.5 L0 6 L-1.5 1.5 L-6 0 L-1.5 -1.5 Z" />
		<text class="zdl__t zdl__t--star" x="376" y="34" text-anchor="end">к далёкой звезде</text>
		<!-- the start -->
		<g class="zdl__ghost">
			<circle cx={SX + RO} cy={SY} r="30" />
		</g>
		<line class="zdl__dir zdl__dir--star" x1={SX + RO + 30} y1={SY} x2="396" y2={SY} />
		<line class="zdl__dir zdl__dir--star" data-star />
		<line class="zdl__dir zdl__dir--sun" data-anti />
		<path class="zdl__wedge" data-wedge d="" />
		<text class="zdl__t zdl__t--wedge" data-wtext></text>
		<g data-earth>
			<circle class="zdl__night" r="30" />
			<path class="zdl__day" d="M 0 -30 A 30 30 0 0 0 0 30 Z" />
		</g>
		<g data-obs>
			<line class="zdl__man" x1="30" y1="0" x2="44" y2="0" />
			<circle class="zdl__head" cx="48" cy="0" r="3.4" />
		</g>
	</svg>
	<div class="zdl__bar">
		<button type="button" class="zdl__play" data-play>Пуск</button>
		<button type="button" class="zdl__btn" data-reset>Заново</button>
		<span class="zdl__time">Прошло <b data-time>0 ч 00 мин</b>, Земля повернулась на <b data-turn>0°</b></span>
	</div>
	<label class="zdl__slider">
		<span>Время</span>
		<input type="range" min="0" max="1440" step="1" value="0" data-t aria-label="Время в минутах" />
	</label>
	<p class="zdl__msg" data-msg aria-live="polite"></p>
	<figcaption class="zdl__caption">
		Вид с севера: Земля вращается и обходит Солнце против часовой стрелки. Голубой пунктир — направление на далёкую
		звезду, жёлтый — направление «от Солнца»: когда наблюдатель смотрит вдоль него, у него полночь. Сдвиг Земли по
		орбите за сутки (около 1°) на рисунке увеличен в 15 раз.
	</figcaption>
</figure>

<style is:global>
	.zdl {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.zdl__svg {
		display: block;
		width: 100%;
		max-width: 40rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.7rem;
		background: radial-gradient(circle at 10% 78%, #2a1c08, #050816 45%, #02030a);
	}
	.zdl__t {
		fill: rgb(235 238 255 / 0.9);
		font-size: 13px;
		font-family: var(--sl-font);
	}
	.zdl__t--star {
		fill: #cfe0ff;
		font-size: 12px;
	}
	.zdl__t--wedge {
		fill: #ffe39a;
		font-size: 12px;
	}
	.zdl__glow {
		fill: #ffd66b;
		opacity: 0.18;
	}
	.zdl__sun {
		fill: #ffd66b;
	}
	.zdl__orbit {
		fill: none;
		stroke: rgb(180 195 255 / 0.35);
		stroke-dasharray: 3 4;
	}
	.zdl__star {
		fill: #e6eeff;
	}
	.zdl__ghost circle {
		fill: none;
		stroke: rgb(180 195 255 / 0.35);
		stroke-dasharray: 2 3;
	}
	.zdl__dir {
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.zdl__dir--star {
		stroke: #9fc0ff;
	}
	.zdl__dir--sun {
		stroke: #ffd66b;
	}
	.zdl__wedge {
		fill: rgb(255 214 107 / 0.18);
		stroke: rgb(255 214 107 / 0.6);
		stroke-width: 0.8;
	}
	.zdl__night {
		fill: #252c3d;
	}
	.zdl__day {
		fill: #4b86d8;
	}
	.zdl__man {
		stroke: #ff8fa3;
		stroke-width: 3;
		stroke-linecap: round;
	}
	.zdl__head {
		fill: #ff8fa3;
	}
	.zdl__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 0.7rem;
	}
	.zdl__play,
	.zdl__btn {
		margin: 0;
		padding: 0.35rem 1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		border-radius: 999px;
		cursor: pointer;
	}
	.zdl__play {
		color: var(--sl-color-black);
		background: var(--sl-color-accent-high);
		border: 1px solid var(--sl-color-accent-high);
	}
	.zdl__btn {
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
	}
	.zdl__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.zdl__time {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}
	.zdl__time b {
		color: var(--sl-color-white);
	}
	.zdl__slider {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.zdl__slider input {
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.zdl__msg {
		min-height: 3em;
		margin: 0.6rem 0 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.zdl__msg b {
		color: var(--sl-color-white);
	}
	.zdl__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.zdl {
			padding: 0.5rem;
		}
	}
</style>

<script>
	import { fmt, loop, attrs } from '../luna/util';

	const DEG = Math.PI / 180;
	const T_SID = 23 * 60 + 56 + 4.09 / 60; // minutes
	const T_SUN = 24 * 60;
	const STEP = 360 / 365.256; // the Earth's orbital step per solar day, degrees
	const K = 15; // drawn larger

	for (const root of document.querySelectorAll<HTMLElement>('[data-zdl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const { SX, SY, RO } = JSON.parse(root.dataset.geo!);
		const play = q<HTMLButtonElement>('[data-play]');
		const reset = q<HTMLButtonElement>('[data-reset]');
		const slider = q<HTMLInputElement>('[data-t]');
		const msg = q<HTMLElement>('[data-msg]');
		const timeEl = q<HTMLElement>('[data-time]');
		const turnEl = q<HTMLElement>('[data-turn]');
		const earth = q<SVGGElement>('[data-earth]');
		const obs = q<SVGGElement>('[data-obs]');
		const star = q<SVGLineElement>('[data-star]');
		const anti = q<SVGLineElement>('[data-anti]');
		const wedge = q<SVGPathElement>('[data-wedge]');
		const wtext = q<SVGTextElement>('[data-wtext]');

		let t = 0; // minutes
		let running = false;
		let stopAt = T_SID;

		// the true turn of the Earth relative to the stars, degrees
		const trueTurn = (m: number) => (360 * m) / T_SID;
		// the drawn turn: true up to the sidereal day, then the last ~1° drawn K times larger
		const drawnTurn = (m: number) => (m <= T_SID ? trueTurn(m) : 360 + ((K * STEP) * (m - T_SID)) / (T_SUN - T_SID));
		const orbitAngle = (m: number) => (K * STEP * m) / T_SUN; // drawn, degrees

		const clockText = (m: number) => {
			const H = Math.floor(m / 60);
			const M = Math.floor(m % 60);
			const S = Math.round((m * 60) % 60);
			return Math.abs(m - T_SID) < 0.02 ? '23 ч 56 мин 4 с' : `${H} ч ${String(M).padStart(2, '0')} мин${m > T_SID && m < T_SUN ? ` ${S} с` : ''}`;
		};
		const message = () => {
			if (Math.abs(t - T_SID) < 0.02)
				msg.innerHTML = '<b>Прошли звёздные сутки — 23 ч 56 мин 4 с.</b> Земля повернулась ровно на 360°: звезда снова прямо над головой. Но за это время Земля сдвинулась по орбите почти на 1°, и направление «от Солнца» повернулось. До полуночи осталось чуть-чуть. Нажмите «Дальше».';
			else if (t >= T_SUN - 0.01)
				msg.innerHTML = '<b>Прошли солнечные сутки — 24 ч.</b> Снова полночь. Относительно звёзд Земля повернулась не на 360°, а почти на 361°. На лишний градус ей нужно около 4 минут.';
			else if (t > T_SID) msg.innerHTML = 'Земля доворачивается на тот угол, на который она сдвинулась по орбите.';
			else
				msg.innerHTML = 'В начале полночь: далёкая звезда и направление «от Солнца» прямо над головой наблюдателя. Земля вращается вокруг оси и одновременно движется по орбите.';
		};
		const draw = () => {
			const th = orbitAngle(t) * DEG;
			const ex = SX + RO * Math.cos(th);
			const ey = SY - RO * Math.sin(th);
			earth.setAttribute('transform', `translate(${ex} ${ey}) rotate(${(-orbitAngle(t)).toFixed(3)})`);
			obs.setAttribute('transform', `translate(${ex} ${ey}) rotate(${(-drawnTurn(t)).toFixed(3)})`);
			attrs(star, { x1: ex + 30, y1: ey, x2: 396, y2: ey });
			star.style.opacity = t > 1 ? '1' : '0';
			const L = 80;
			attrs(anti, { x1: ex + 30 * Math.cos(th), y1: ey - 30 * Math.sin(th), x2: ex + L * Math.cos(th), y2: ey - L * Math.sin(th) });
			const rw = 62;
			wedge.setAttribute(
				'd',
				th > 0.01 ? `M ${ex} ${ey} L ${ex + rw} ${ey} A ${rw} ${rw} 0 0 0 ${ex + rw * Math.cos(th)} ${ey - rw * Math.sin(th)} Z` : '',
			);
			attrs(wtext, { x: ex + rw + 4, y: ey - rw * Math.sin(th / 2) + 3 });
			wtext.textContent = th > 0.05 ? `${fmt(STEP * (t / T_SUN), 2)}°` : '';
			const turn = (360 * t) / T_SID;
			timeEl.textContent = clockText(t);
			turnEl.textContent = `${fmt(turn, turn > 359 ? 2 : 0)}°`;
			slider.value = String(Math.round(t));
			message();
		};
		const setRunning = (v: boolean) => {
			running = v;
			play.textContent = v ? 'Пауза' : t >= T_SUN - 0.01 ? 'Пуск' : t > 0 ? 'Дальше' : 'Пуск';
		};
		loop(root, (dt) => {
			if (!running) return;
			// 4 hours a second, the last 4 minutes slowly
			const speed = t < T_SID ? 240 : 2.2;
			let nt = t + dt * speed;
			if (nt >= stopAt) {
				nt = stopAt;
				t = nt;
				stopAt = stopAt === T_SID ? T_SUN : T_SUN;
				setRunning(false);
			}
			t = nt;
			draw();
		});
		play.addEventListener('click', () => {
			if (!running && t >= T_SUN - 0.01) {
				t = 0;
				stopAt = T_SID;
			}
			if (!running) stopAt = t < T_SID - 0.01 ? T_SID : T_SUN;
			setRunning(!running);
			draw();
		});
		reset.addEventListener('click', () => {
			t = 0;
			stopAt = T_SID;
			setRunning(false);
			draw();
		});
		slider.addEventListener('input', () => {
			t = Number(slider.value);
			if (Math.abs(t - T_SID) < 1) t = T_SID;
			setRunning(false);
			draw();
		});
		draw();
	}
</script>
