---
/**
 * An earthquake on the surface and its P and S rays through the Earth, traced numerically in seismic.ts (Snell's law
 * for a sphere in 10 km shells of a simplified IASP91 velocity model). Nothing is drawn by hand: the shadow zones on
 * the surface come from a dense fan of 6000 rays per wave. The rays go to the right; the left half shows the layers.
 * «Землетрясение!» lets the waves run with real travel times (1 minute of travel = 0,4 s).
 * The toggle makes the inner core liquid — the Earth as seismologists pictured it before Inge Lehmann (1936).
 */
const CX = 186;
const CY = 202;
const RP = 165;
const R_EARTH = 6371;
const rr = (km: number) => (RP * km) / R_EARTH;
const ticks = [30, 60, 90, 120, 150, 180].map((d) => {
	const a = (d * Math.PI) / 180;
	return { x1: CX + RP * Math.sin(a), y1: CY - RP * Math.cos(a), x2: CX + (RP + 5) * Math.sin(a), y2: CY - (RP + 5) * Math.cos(a) };
});
---

<figure class="zsm not-content" data-zsm data-geo={JSON.stringify({ CX, CY, RP })}>
	<svg class="zsm__svg" viewBox="0 0 400 400" role="img" aria-label="Сейсмические лучи внутри Земли и зоны тени">
		<circle class="zsm__mantle" cx={CX} cy={CY} r={RP} />
		<circle class="zsm__outer" cx={CX} cy={CY} r={rr(3482)} />
		<circle class="zsm__inner" data-innerdisc cx={CX} cy={CY} r={rr(1217)} />
		<circle class="zsm__crust" cx={CX} cy={CY} r={RP} />
		<line class="zsm__axis" x1={CX} y1={CY - RP} x2={CX} y2={CY + RP} />
		<text class="zsm__t zsm__t--layer" x={CX - RP + 14} y={CY + 4}>мантия</text>
		<text class="zsm__t zsm__t--layer" x={CX - rr(2400)} y={CY + 4} text-anchor="middle">ядро</text>
		<text class="zsm__t" x={CX - 8} y={CY - RP - 10} text-anchor="end">эпицентр</text>
		<path class="zsm__epi" transform={`translate(${CX} ${CY - RP})`} d="M0 -7 L2 -2 L7 0 L2 2 L0 7 L-2 2 L-7 0 L-2 -2 Z" />
		{ticks.map((t) => <line class="zsm__tick" {...t} />)}
		<text class="zsm__t zsm__t--deg" x={CX + RP + 15} y={CY + 4}>90°</text>
		<text class="zsm__t zsm__t--deg" x={CX} y={CY + RP + 24} text-anchor="middle">180°</text>
		<g data-cover></g>
		<g data-shadow></g>
		<g data-rays-p></g>
		<g data-rays-s></g>
		<g data-heads></g>
		<path class="zsm__hl zsm__hl--p" data-hl-p d="" />
		<path class="zsm__hl zsm__hl--s" data-hl-s d="" />
	</svg>
	<p class="zsm__legend">
		<span class="zsm__sw zsm__sw--crust"></span>кора, 5–70 км{' '}
		<span class="zsm__sw zsm__sw--mantle"></span>мантия, до глубины 2900 км{' '}
		<span class="zsm__sw zsm__sw--outer"></span>внешнее ядро, жидкое{' '}
		<span class="zsm__sw zsm__sw--inner" data-inner-sw></span><span data-inner-name>внутреннее ядро, твёрдое, радиус около 1220 км</span>
		<br />
		<span class="zsm__line zsm__line--p"></span>P-волны{' '}
		<span class="zsm__line zsm__line--pi"></span>P-волны, прошедшие внутреннее ядро{' '}
		<span class="zsm__line zsm__line--s"></span>S-волны
	</p>
	<div class="zsm__bar">
		<button type="button" class="zsm__play" data-go>Землетрясение!</button>
		<button type="button" class="zsm__chip is-on" data-show="p" aria-pressed="true">P-волны</button>
		<button type="button" class="zsm__chip is-on" data-show="s" aria-pressed="true">S-волны</button>
		<span class="zsm__clock" data-clock></span>
	</div>
	<button type="button" class="zsm__toggle" data-solid aria-pressed="true">
		<span class="zsm__switch" aria-hidden="true"></span> Внутреннее ядро твёрдое
	</button>
	<label class="zsm__slider">
		<span>Один луч: угол к вертикали <b data-i0>20°</b></span>
		<input type="range" min="1" max="40" step="0.2" value="20" data-ray aria-label="Угол, под которым луч выходит из очага" />
	</label>
	<p class="zsm__msg" data-msg aria-live="polite"></p>
	<figcaption class="zsm__caption">
		Разрез Земли через эпицентр. Лучи рассчитаны по закону преломления для слоёв со скоростями волн, измеренными
		сейсмологами (упрощённая модель IASP91); показаны лучи, идущие вправо, влево всё так же. Цветные дуги снаружи — где
		на поверхность приходят волны; модель считает их по 6000 лучам каждого вида.
	</figcaption>
</figure>

