<script>
	import { fmt, loop, attrs } from '../luna/util';
	import { buildShells, trace, gaps, R_EARTH, type Ray } from './seismic';

	const NS = 'http://www.w3.org/2000/svg';
	const SHOWN = [1, 2, 3, 4, 5, 5.5, 6, 7, 8, 9, 10, 11, 12, 13, 13.4, 14, 15, 16, 17, 18, 19, 20, 21.5, 23, 24.5, 26, 27.5, 29, 31, 33, 35];
	const T_END = 22 * 60; // s of travel shown in the animation
	const SPEED = 150; // s of travel per second

	interface Drawn {
		path: SVGPathElement;
		head: SVGCircleElement;
		len: number[];
		t: number[];
		xy: [number, number][];
		total: number;
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-zsm]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const { CX, CY, RP } = JSON.parse(root.dataset.geo!);
		const gP = q<SVGGElement>('[data-rays-p]');
		const gS = q<SVGGElement>('[data-rays-s]');
		const gHeads = q<SVGGElement>('[data-heads]');
		const gCover = q<SVGGElement>('[data-cover]');
		const gShadow = q<SVGGElement>('[data-shadow]');
		const hlP = q<SVGPathElement>('[data-hl-p]');
		const hlS = q<SVGPathElement>('[data-hl-s]');
		const go = q<HTMLButtonElement>('[data-go]');
		const clock = q<HTMLElement>('[data-clock]');
		const solidBtn = q<HTMLButtonElement>('[data-solid]');
		const raySl = q<HTMLInputElement>('[data-ray]');
		const i0El = q<HTMLElement>('[data-i0]');
		const msg = q<HTMLElement>('[data-msg]');
		const showBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-show]'));

		let solid = true;
		let shells = buildShells(true);
		let drawn: Drawn[] = [];
		let anim = -1; // travel time in s, or −1 when not animating
		let shadowText = '';

		const xy = (r: number, th: number): [number, number] => [CX + ((RP * r) / R_EARTH) * Math.sin(th), CY - ((RP * r) / R_EARTH) * Math.cos(th)];
		const toPath = (ray: Ray) => {
			const pts: [number, number][] = [];
			const ts: number[] = [];
			let last: [number, number] | null = null;
			ray.pts.forEach(([r, th], i) => {
				const p = xy(r, th);
				const end = i === ray.pts.length - 1;
				if (!last || end || Math.hypot(p[0] - last[0], p[1] - last[1]) > 1.2) {
					pts.push(p);
					ts.push(ray.times[i]);
					last = p;
				}
			});
			const len = [0];
			for (let i = 1; i < pts.length; i++) len.push(len[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
			const d = pts.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join('');
			return { d, len, ts, pts };
		};
		const arc = (r: number, a0: number, a1: number) => {
			const p0 = [CX + r * Math.sin(a0), CY - r * Math.cos(a0)];
			const p1 = [CX + r * Math.sin(a1), CY - r * Math.cos(a1)];
			return `M ${p0[0]} ${p0[1]} A ${r} ${r} 0 ${a1 - a0 > Math.PI ? 1 : 0} 1 ${p1[0]} ${p1[1]}`;
		};
		const DEG = Math.PI / 180;

		const build = () => {
			gP.replaceChildren();
			gS.replaceChildren();
			gHeads.replaceChildren();
			gCover.replaceChildren();
			gShadow.replaceChildren();
			drawn = [];
			for (const wave of ['P', 'S'] as const) {
				for (const i0 of SHOWN) {
					const ray = trace(i0, wave, shells);
					const { d, len, ts, pts } = toPath(ray);
					const path = document.createElementNS(NS, 'path');
					const cls = wave === 'S' ? 'zsm__ray--s' : ray.inner ? 'zsm__ray--pi' : 'zsm__ray--p';
					attrs(path, { d, class: `zsm__ray ${cls}` });
					(wave === 'P' ? gP : gS).append(path);
					if (ray.stopped) {
						const end = pts[pts.length - 1];
						const c = document.createElementNS(NS, 'circle');
						attrs(c, { cx: end[0], cy: end[1], r: 1.6, class: 'zsm__stop' });
						gS.append(c);
					}
					const head = document.createElementNS(NS, 'circle');
					attrs(head, { r: 2.2, class: 'zsm__head', fill: wave === 'S' ? '#ff8fb8' : ray.inner ? '#7dffb6' : '#9fd8ff' });
					head.style.display = 'none';
					gHeads.append(head);
					drawn.push({ path, head, len, t: ts, xy: pts, total: len[len.length - 1] });
				}
			}
			// coverage from dense fans
			const arrive = { P: [] as number[], Pi: [] as number[], S: [] as number[] };
			for (const wave of ['P', 'S'] as const) {
				for (let i = 0; i < 6000; i++) {
					const r = trace(0.01 + (45 * i) / 6000, wave, shells);
					if (r.dist === null) continue;
					const x = Math.min(r.dist % 360, 360 - (r.dist % 360));
					if (wave === 'S') arrive.S.push(x);
					else if (r.inner) arrive.Pi.push(x);
					else arrive.P.push(x);
				}
			}
			const cover = (list: number[], radius: number, color: string) => {
				// covered = complement of the gaps (gaps narrower than 1.5° are gaps between sampled rays)
				const g = gaps(list, 0, 0.5).filter(([a, b]) => b - a >= 1.5);
				let s = 0;
				const segs: [number, number][] = [];
				for (const [a, b] of g) {
					if (a > s) segs.push([s, a]);
					s = b;
				}
				if (s < 180) segs.push([s, 180]);
				for (const [a, b] of segs) {
					if (b - a < 0.5) continue;
					const p = document.createElementNS(NS, 'path');
					attrs(p, { d: arc(radius, a * DEG, b * DEG), class: 'zsm__cov', stroke: color });
					gCover.append(p);
				}
				return g;
			};
			const gp = cover(arrive.P, RP + 5, '#9fd8ff');
			if (arrive.Pi.length) {
				// the inner-core arrivals: only where they are
				const lo = Math.min(...arrive.Pi);
				const hi = Math.max(...arrive.Pi);
				const p = document.createElementNS(NS, 'path');
				attrs(p, { d: arc(RP + 5, lo * DEG, hi * DEG), class: 'zsm__cov', stroke: '#7dffb6', 'stroke-dasharray': '3 2' });
				gCover.append(p);
			}
			const gs = cover(arrive.S, RP + 10, '#ff8fb8');
			// the shadow zone of P (without the inner-core waves) and the S shadow
			const pz = gp.find(([a, b]) => a > 60 && b < 179) ?? [0, 0];
			const sz = gs.find(([a]) => a > 60) ?? [0, 180];
			const tickAt = (deg: number, label: string, out: number) => {
				const a = deg * DEG;
				const l = document.createElementNS(NS, 'line');
				attrs(l, { x1: CX + (RP + 2) * Math.sin(a), y1: CY - (RP + 2) * Math.cos(a), x2: CX + (RP + 20) * Math.sin(a), y2: CY - (RP + 20) * Math.cos(a), class: 'zsm__shtick' });
				const t = document.createElementNS(NS, 'text');
				attrs(t, { x: CX + (RP + out) * Math.sin(a), y: CY - (RP + out) * Math.cos(a) + 4, class: 'zsm__t zsm__t--sh', 'text-anchor': 'start' });
				t.textContent = label;
				gShadow.append(l, t);
			};
			tickAt(pz[0], `${Math.round(pz[0])}°`, 23);
			tickAt(pz[1], `${Math.round(pz[1])}°`, 23);
			const sh = document.createElementNS(NS, 'path');
			attrs(sh, { d: arc(RP + 17, pz[0] * DEG, pz[1] * DEG), class: 'zsm__sharc' });
			gShadow.append(sh);
			const mid = ((pz[0] + pz[1]) / 2) * DEG;
			const lab = document.createElementNS(NS, 'text');
			attrs(lab, { x: CX + (RP + 26) * Math.sin(mid) - 2, y: CY - (RP + 26) * Math.cos(mid) + 10, class: 'zsm__t zsm__t--sh', 'text-anchor': 'middle' });
			lab.textContent = 'зона тени P';
			gShadow.append(lab);
			shadowText =
				`<b>Зона тени P-волн: от ${Math.round(pz[0])}° до ${Math.round(pz[1])}°</b> от эпицентра. ` +
				`<b>S-волны</b> не приходят дальше ${Math.round(sz[0])}°: через жидкое ядро они не проходят.` +
				(solid
					? ' В зону тени попадают только слабые P-волны, прошедшие через твёрдое внутреннее ядро (зелёные).'
					: ' Если ядро всё жидкое, зона тени P-волн пуста.');
			highlight();
			showHide();
		};

		const highlight = () => {
			const i0 = Number(raySl.value);
			i0El.textContent = `${fmt(i0, i0 % 1 ? 1 : 0)}°`;
			const p = trace(i0, 'P', shells);
			const s = trace(i0, 'S', shells);
			hlP.setAttribute('d', toPath(p).d);
			hlS.setAttribute('d', toPath(s).d);
			const km = (d: number) => fmt(Math.round((d * Math.PI * R_EARTH) / 180 / 10) * 10, 0);
			const ptxt =
				p.dist === null
					? 'P-волна не вышла на поверхность'
					: `P-волна пришла на ${fmt(p.dist, 0)}° (${km(p.dist)} км по поверхности) через ${fmt(p.time / 60, 1)} мин${p.inner ? ', пройдя внутреннее ядро' : ''}`;
			const stxt = s.stopped
				? 'S-волна дошла до жидкого ядра и дальше не прошла'
				: s.dist === null
					? 'S-волна не вышла на поверхность'
					: `S-волна — туда же, на ${fmt(s.dist, 0)}°, через ${fmt(s.time / 60, 1)} мин`;
			msg.innerHTML = `${shadowText}<br/>Выделенный луч: ${ptxt}; ${s.stopped || s.dist === null || p.dist === null || Math.abs(s.dist - p.dist) > 1 ? stxt.replace('туда же, ', '') : stxt}.`;
		};

		const showHide = () => {
			const onP = showBtns[0].classList.contains('is-on');
			const onS = showBtns[1].classList.contains('is-on');
			gP.style.display = hlP.style.display = onP ? '' : 'none';
			gS.style.display = hlS.style.display = onS ? '' : 'none';
			drawn.forEach((d, i) => {
				const isP = i < SHOWN.length;
				d.head.style.visibility = (isP ? onP : onS) ? '' : 'hidden';
			});
		};

		const frame = () => {
			for (const d of drawn) {
				if (anim < 0) {
					d.path.style.strokeDasharray = '';
					d.head.style.display = 'none';
					continue;
				}
				const T = d.t;
				let L = d.total;
				let pos = d.xy[d.xy.length - 1];
				if (anim < T[T.length - 1]) {
					let lo = 0;
					let hi = T.length - 1;
					while (hi - lo > 1) {
						const m = (lo + hi) >> 1;
						if (T[m] <= anim) lo = m;
						else hi = m;
					}
					const f = (anim - T[lo]) / Math.max(1e-9, T[hi] - T[lo]);
					L = d.len[lo] + f * (d.len[hi] - d.len[lo]);
					pos = [d.xy[lo][0] + f * (d.xy[hi][0] - d.xy[lo][0]), d.xy[lo][1] + f * (d.xy[hi][1] - d.xy[lo][1])];
				}
				d.path.style.strokeDasharray = `${L.toFixed(1)} ${(d.total + 10).toFixed(0)}`;
				d.head.style.display = '';
				attrs(d.head, { cx: pos[0], cy: pos[1] });
			}
			clock.textContent = anim < 0 ? '' : `Прошло ${fmt(anim / 60, 1)} мин`;
			hlP.style.opacity = hlS.style.opacity = anim >= 0 ? '0' : '1';
		};

		loop(root, (dt) => {
			if (anim < 0) return;
			anim += dt * SPEED;
			if (anim >= T_END) {
				anim = T_END;
				frame();
				anim = -2; // finished: keep the last frame until the next change
				hlP.style.opacity = hlS.style.opacity = '1';
				go.textContent = 'Землетрясение!';
				return;
			}
			frame();
		});
		go.addEventListener('click', () => {
			anim = 0;
			go.textContent = 'Ещё раз';
			frame();
		});
		for (const b of showBtns)
			b.addEventListener('click', () => {
				b.classList.toggle('is-on');
				b.setAttribute('aria-pressed', String(b.classList.contains('is-on')));
				showHide();
			});
		solidBtn.addEventListener('click', () => {
			solid = !solid;
			solidBtn.setAttribute('aria-pressed', String(solid));
			q('[data-innerdisc]').classList.toggle('is-liquid', !solid);
			q('[data-inner-sw]').classList.toggle('is-liquid', !solid);
			q('[data-inner-name]').textContent = solid ? 'внутреннее ядро, твёрдое, радиус около 1220 км' : 'внутреннее ядро — тоже жидкое (так думали до 1936 года)';
			shells = buildShells(solid);
			anim = -1;
			build();
			frame();
		});
		raySl.addEventListener('input', highlight);
		build();
	}
</script>
