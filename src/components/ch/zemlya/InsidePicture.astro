---
/**
 * Two panels for «Что внутри Земли».
 * Left: the layers of the Earth to scale (100 px = 6371 km): the mantle down to 2900 km (radius 3480 km), the liquid
 *   outer core down to 5150 km (radius 1220 km is the solid inner core). The crust (5–70 km, 0,1–1 px) is thinner than
 *   the outline, so it is labelled on the outline.
 * Right: what the particles do in the two seismic waves. A grid of particles; in the P wave every particle oscillates
 *   along the direction the wave runs (compressions and rarefactions run to the right), in the S wave across it. The
 *   same frequency, the S wave runs 1,7 times slower, so its wavelength is 1,7 times shorter. One particle of each is
 *   marked: it stays in its place on average.
 */
import PicStyles from './PicStyles.astro';

const C = { x: 112, y: 128 };
const K = 100 / 6371;
const rCMB = 3480 * K;
const rICB = 1220 * K;
const f = (x: number) => x.toFixed(1);
// label leader lines from a point at angle a (degrees, from +x counterclockwise) on radius r to x = 214
const lead = (r: number, a: number, y: number) => {
	const px = C.x + r * Math.cos((a * Math.PI) / 180);
	const py = C.y - r * Math.sin((a * Math.PI) / 180);
	return `M${f(px)} ${f(py)} L${f(206)} ${y} L214 ${y}`;
};
const COLS = 22;
const ROWS = 4;
---

<PicStyles />
<figure class="zp zin not-content" data-zin>
	<div class="zp__grid">
		<div>
			<svg class="zp__svg" viewBox="0 0 360 260" role="img" aria-label="Строение Земли в масштабе: тонкая кора, мантия до глубины 2900 км, жидкое внешнее ядро до глубины 5150 км и твёрдое внутреннее ядро радиусом около 1220 км">
				<circle class="zin-mantle" cx={C.x} cy={C.y} r="100"></circle>
				<circle class="zin-outer" cx={C.x} cy={C.y} r={rCMB}></circle>
				<circle class="zin-inner" cx={C.x} cy={C.y} r={rICB}></circle>
				<circle class="zin-crust" cx={C.x} cy={C.y} r="100"></circle>
				<path class="zp-line" d={lead(100, 40, 44)}></path>
				<path class="zp-line" d={lead(78, 18, 98)}></path>
				<path class="zp-line" d={lead(40, -12, 156)}></path>
				<path class="zp-line" d={lead(12, -40, 210)}></path>
				<text x="216" y="40"><tspan class="zp-t-hl">кора</tspan></text>
				<text x="216" y="56" class="zp-t-small">5–70 км, тоньше линии</text>
				<text x="216" y="94"><tspan class="zp-t-hl">мантия</tspan></text>
				<text x="216" y="110" class="zp-t-small">до глубины 2900 км</text>
				<text x="216" y="152"><tspan class="zp-t-hl">внешнее ядро</tspan></text>
				<text x="216" y="168" class="zp-t-small">жидкое, до 5150 км</text>
				<text x="216" y="206"><tspan class="zp-t-hl">внутреннее ядро</tspan></text>
				<text x="216" y="222" class="zp-t-small">твёрдое, радиус 1220 км</text>
				<text x={C.x} y="250" text-anchor="middle" class="zp-t-small">радиус Земли 6371 км</text>
			</svg>
			<p class="zp__label"><b>Слои Земли</b> в масштабе.</p>
		</div>
		<div>
			<svg class="zp__svg" viewBox="0 0 360 260" role="img" aria-label="Продольная волна: частицы колеблются вдоль направления, в котором бежит волна, и среда то сжимается, то растягивается. Поперечная волна: частицы колеблются поперёк направления волны, она бежит в 1,7 раза медленнее">
				<text x="12" y="22"><tspan class="zp-t-hl">P-волна</tspan>: частицы колеблются вдоль</text>
				<g data-wave="p">
					{Array.from({ length: COLS * ROWS }, (_, i) => (
						<circle class={i === 7 * ROWS + 1 ? 'zin-pt zin-pt--mark' : 'zin-pt'} r={i === 7 * ROWS + 1 ? 3.6 : 2.6} />
					))}
				</g>
				<text x="12" y="146"><tspan class="zp-t-hl">S-волна</tspan>: частицы колеблются поперёк</text>
				<g data-wave="s">
					{Array.from({ length: COLS * ROWS }, (_, i) => (
						<circle class={i === 7 * ROWS + 1 ? 'zin-pt zin-pt--mark' : 'zin-pt'} r={i === 7 * ROWS + 1 ? 3.6 : 2.6} />
					))}
				</g>
				<g class="zin-dir">
					<line x1="250" y1="112" x2="340" y2="112"></line>
					<path d="M340 112 l-8 -4.5 v9 z"></path>
					<line x1="250" y1="250" x2="340" y2="250"></line>
					<path d="M340 250 l-8 -4.5 v9 z"></path>
				</g>
				<text x="246" y="116" text-anchor="end" class="zp-t-small">волна бежит</text>
				<text x="246" y="254" text-anchor="end" class="zp-t-small">в 1,7 раза медленнее</text>
			</svg>
			<p class="zp__label"><b>Что делают частицы</b> в продольной и поперечной волнах. Красная частица колеблется около своего места.</p>
		</div>
	</div>
</figure>

<style is:global>
	.zin-mantle {
		fill: color-mix(in srgb, var(--ig-vy) 30%, var(--sl-color-gray-5));
	}
	.zin-outer {
		fill: color-mix(in srgb, var(--ig-v) 55%, var(--sl-color-gray-5));
	}
	.zin-inner {
		fill: var(--ig-v);
	}
	.zin-crust {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.5;
	}
	.zin-pt {
		fill: var(--sl-color-gray-2);
	}
	.zin-pt--mark {
		fill: var(--ig-vy);
	}
	.zin-dir line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.zin-dir path {
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	const ROWS = 4;
	for (const root of document.querySelectorAll<HTMLElement>('[data-zin]')) {
		const X0 = 22;
		const DX = 15; // spacing of the particles, px
		const DY = 16;
		const A = 5; // amplitude, px
		const T = 1.6; // period, s
		const LP = 150; // P wavelength, px
		const LS = LP / 1.7; // S wavelength: the same frequency, 1,7 times slower
		const waves = (['p', 's'] as const).map((k) => ({
			k,
			y0: k === 'p' ? 48 : 172,
			dots: Array.from(root.querySelectorAll<SVGCircleElement>(`[data-wave="${k}"] circle`)),
		}));
		let t = 0;
		const draw = () => {
			for (const w of waves) {
				const L = w.k === 'p' ? LP : LS;
				w.dots.forEach((d, i) => {
					const col = Math.floor(i / ROWS);
					const row = i % ROWS;
					const x = X0 + col * DX;
					const y = w.y0 + row * DY;
					const u = A * Math.sin(2 * Math.PI * (x / L - t / T));
					d.setAttribute('cx', (w.k === 'p' ? x + u : x).toFixed(1));
					d.setAttribute('cy', (w.k === 's' ? y + u : y).toFixed(1));
				});
			}
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
