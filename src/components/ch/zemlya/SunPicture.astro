---
/**
 * Two panels for «Высота Солнца в полдень», running through 2026 together (one year in 12 s, sun.ts).
 * Left: the Earth at Moscow's noon in a cut along the Moscow meridian. Parallel sunrays from the left; the axis is
 *   tilted so that the angle between the rays and the equator plane is the Sun's declination δ of the day; the
 *   observer at φ = 55,75°; the horizon is the tangent at the observer; the angles δ (at the centre), φ (at the
 *   centre) and h (at the observer, between the ray and the horizon) are drawn true, so h = 90° − φ + δ on sight.
 * Right: a beam of sunrays of a fixed width falls on level ground at the same h: the lit strip is (width)/sin h long,
 *   brighter when shorter; a square metre of the ground gets sin h of the power of square-on rays.
 */
import PicStyles from './PicStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
---

<PicStyles />
<figure class="zp zsun not-content" data-zsun>
	<div class="zp__grid">
		<div>
			<svg class="zp__svg" viewBox="0 0 360 260" role="img" aria-label="Земля в полдень в разрезе по меридиану Москвы. Солнечные лучи параллельны. Склонение δ — угол между лучами и плоскостью экватора, φ — широта Москвы, h — высота Солнца: угол между лучом и горизонтом. В течение года ось сохраняет направление, и δ меняется от −23,4° до +23,4°">
				<defs>
					<marker id={`zs-a-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
						<path class="zp-head" d="M0 0 L10 5 L0 10 z"></path>
					</marker>
				</defs>
				<g data-rays></g>
				<circle class="zp-earth" cx="210" cy="136" r="84"></circle>
				<path class="zp-nightside" d="M210 52 A84 84 0 0 1 210 220 Z"></path>
				<line class="zp-dash" x1="100" y1="136" x2="210" y2="136"></line>
				<line class="zp-axis" data-axis></line>
				<line class="zsun-eq" data-eq></line>
				<line class="zp-line" data-om></line>
				<line class="zsun-hor" data-hor></line>
				<line class="zsun-ray" data-mray></line>
				<path class="zp-arc" data-arc-d></path>
				<path class="zp-arc" data-arc-f></path>
				<path class="zp-arc zsun-arc-h" data-arc-h></path>
				<text class="zp-t-math" data-t-d>δ</text>
				<text class="zp-t-math" data-t-f>φ</text>
				<text class="zp-t-math zp-t-hl" data-t-h>h</text>
				<circle class="zsun-man" r="4" data-man></circle>
				<text class="zp-t-small" data-t-n>ось</text>
				<text class="zp-t-small" data-t-eq>экватор</text>
				<text class="zp-t-small" x="8" y="18">лучи Солнца</text>
				<text class="zp-t-small" text-anchor="end" data-t-hor>горизонт</text>
			</svg>
			<p class="zp__label" data-label-a>&nbsp;</p>
		</div>
		<div>
			<svg class="zp__svg" viewBox="0 0 360 260" role="img" aria-label="Пучок солнечных лучей одной и той же ширины падает на ровную землю. Чем ниже Солнце, тем на большую площадь растекается пучок и тем меньше мощность на каждый квадратный метр">
				<defs>
					<marker id={`zs-b-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
						<path class="zp-head" d="M0 0 L10 5 L0 10 z"></path>
					</marker>
				</defs>
				<rect class="zsun-ground" x="0" y="214" width="360" height="46"></rect>
				<path class="zsun-beam" data-beam></path>
				<g data-brays></g>
				<line class="zsun-strip" data-strip></line>
				<line class="zsun-cross" data-cross></line>
				<path class="zp-arc zsun-arc-h" data-barc></path>
				<text class="zp-t-math zp-t-hl" data-bh>h</text>
				<text class="zp-t-small" text-anchor="middle" data-t-strip>пятно на земле</text>
				<text class="zp-t-small" data-t-cross>тот же пучок поперёк</text>
			</svg>
			<p class="zp__label" data-label-b>&nbsp;</p>
		</div>
	</div>
	<figcaption class="zp__cap">
		Земля в полдень в разрезе по меридиану Москвы, лучи Солнца параллельны: высота Солнца <i>h</i> складывается из
		углов, <i>h</i> = 90° − <i>φ</i> + <i>δ</i>. Рядом — пучок лучей одной ширины при той же высоте Солнца: чем ниже
		Солнце, тем длиннее и бледнее пятно на земле. Оба рисунка идут по датам 2026 года.
	</figcaption>
</figure>

<style is:global>
	.zsun-eq {
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
		stroke-dasharray: 6 3;
	}
	.zsun-hor {
		stroke: var(--sl-color-white);
		stroke-width: 1.8;
	}
	.zsun-ray {
		stroke: var(--zp-sun);
		stroke-width: 2.4;
	}
	.zsun-arc-h {
		stroke-width: 2.2;
	}
	.zsun-man {
		fill: var(--ig-vy);
	}
	.zsun-ground {
		fill: color-mix(in srgb, var(--sl-color-green) 22%, var(--sl-color-gray-5));
	}
	.zsun-beam {
		fill: color-mix(in srgb, var(--zp-sun) 16%, transparent);
	}
	.zsun-strip {
		stroke: var(--zp-sun);
		stroke-width: 7;
	}
	.zsun-cross {
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
</style>

<script>
	import { loop } from '@components/intro/scene';
	import { sunAt, dateLabel, DEG } from './sun';

	const NS = 'http://www.w3.org/2000/svg';
	const f = (x: number) => x.toFixed(1);
	const comma = (x: number, d = 1) => x.toFixed(d).replace('.', ',').replace('-', '−');
	const LAT = 55.75;

	for (const root of document.querySelectorAll<HTMLElement>('[data-zsun]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const set = (e: Element, a: Record<string, string | number>) => {
			for (const [k, v] of Object.entries(a)) e.setAttribute(k, typeof v === 'number' ? f(v) : v);
		};
		const markerA = root.querySelectorAll('marker')[0].id;
		const markerB = root.querySelectorAll('marker')[1].id;
		// ---------- left panel ----------
		const O = { x: 210, y: 136 };
		const R = 84;
		const raysG = $<SVGGElement>('[data-rays]');
		for (const dy of [-66, -33, 0, 33, 66]) {
			const x2 = O.x - Math.sqrt(R * R - dy * dy);
			const ln = document.createElementNS(NS, 'line');
			set(ln, { x1: 6, y1: O.y + dy, x2: x2 - 2, y2: O.y + dy, class: 'zp-ray', 'marker-end': `url(#${markerA})` });
			raysG.append(ln);
		}
		// math angle (degrees, counterclockwise, y up) → a point on the screen
		const P = (a: number, r: number, c = O) => ({ x: c.x + r * Math.cos(a * DEG), y: c.y - r * Math.sin(a * DEG) });
		// arc from math angle a1 to a2 (a2 > a1) around c
		const arc = (c: { x: number; y: number }, r: number, a1: number, a2: number) => {
			const p1 = P(a1, r, c);
			const p2 = P(a2, r, c);
			return `M${f(p1.x)} ${f(p1.y)} A${r} ${r} 0 0 0 ${f(p2.x)} ${f(p2.y)}`;
		};
		const axis = $('[data-axis]');
		const eq = $('[data-eq]');
		const om = $('[data-om]');
		const hor = $('[data-hor]');
		const mray = $('[data-mray]');
		const man = $('[data-man]');
		const arcD = $('[data-arc-d]');
		const arcF = $('[data-arc-f]');
		const arcH = $('[data-arc-h]');
		const tD = $<SVGTextElement>('[data-t-d]');
		const tF = $('[data-t-f]');
		const tH = $('[data-t-h]');
		const tN = $('[data-t-n]');
		const tEq = $('[data-t-eq]');
		const tHor = $('[data-t-hor]');
		const labelA = $('[data-label-a]');
		// ---------- right panel ----------
		const GY = 214;
		const GX = 196; // centre of the lit strip
		const W = 52; // width of the beam across the rays
		const beam = $('[data-beam]');
		const braysG = $<SVGGElement>('[data-brays]');
		const brays = Array.from({ length: 5 }, () => {
			const ln = document.createElementNS(NS, 'line');
			set(ln, { class: 'zp-ray', 'marker-end': `url(#${markerB})` });
			braysG.append(ln);
			return ln;
		});
		const strip = $<SVGLineElement>('[data-strip]');
		const cross = $('[data-cross]');
		const barc = $('[data-barc]');
		const bh = $('[data-bh]');
		const tStrip = $('[data-t-strip]');
		const tCross = $('[data-t-cross]');
		const labelB = $('[data-label-b]');

		const draw = (day: number) => {
			const { dec } = sunAt(day);
			const h = 90 - LAT + dec;
			// left
			const aN = 90 + dec;
			const aE = 180 + dec;
			const aM = aE - LAT;
			const n1 = P(aN, R * 1.22);
			const n0 = P(aN + 180, R * 1.22);
			set(axis, { x1: n0.x, y1: n0.y, x2: n1.x, y2: n1.y });
			const e1 = P(aE, R);
			const e0 = P(aE + 180, R);
			set(eq, { x1: e0.x, y1: e0.y, x2: e1.x, y2: e1.y });
			const M = P(aM, R);
			set(om, { x1: O.x, y1: O.y, x2: M.x, y2: M.y });
			const t1 = P(aM + 90, 46, M);
			const t0 = P(aM - 90, 46, M);
			set(hor, { x1: t0.x, y1: t0.y, x2: t1.x, y2: t1.y });
			set(mray, { x1: 6, y1: M.y, x2: M.x, y2: M.y });
			set(man, { cx: M.x, cy: M.y });
			arcD.setAttribute('d', Math.abs(dec) > 0.5 ? (dec > 0 ? arc(O, 70, 180, aE) : arc(O, 70, aE, 180)) : '');
			const dm = P(180 + dec / 2, 78);
			set(tD, { x: dm.x - 14, y: dm.y + 5 });
			tD.style.opacity = Math.abs(dec) > 4 ? '1' : '0';
			arcF.setAttribute('d', arc(O, 30, aM, aE));
			const fm = P(aE - LAT / 2, 40);
			set(tF, { x: fm.x - 5, y: fm.y + 5 });
			arcH.setAttribute('d', arc(M, 30, 180, aM + 90));
			const hm = P(180 + h / 2, 42, M);
			set(tH, { x: hm.x - 6, y: hm.y + 6 });
			const nl = P(aN, R * 1.22 + 4);
			set(tN, { x: nl.x + 6, y: nl.y + 4 });
			const el = P(aE + 180, R + 6);
			set(tEq, { x: el.x - 2, y: el.y + 16 });
			set(tHor, { x: t1.x - 4, y: t1.y - 4 });
			labelA.innerHTML = `<b>${dateLabel(day)}:</b> <i>δ</i> = ${dec >= 0 ? '+' : ''}${comma(dec)}°, в Москве <i>h</i> = ${comma(h)}°`;
			// right
			const s = Math.sin(h * DEG);
			const c = Math.cos(h * DEG);
			const half = W / s / 2;
			const x0 = GX - half;
			const x1 = GX + half;
			const Lr = 260; // ray length back towards the Sun
			beam.setAttribute('d', `M${f(x0)} ${GY} L${f(x1)} ${GY} L${f(x1 - Lr * c)} ${f(GY - Lr * s)} L${f(x0 - Lr * c)} ${f(GY - Lr * s)} Z`);
			beam.style.opacity = String(0.35 + 0.65 * s);
			brays.forEach((ln, i) => {
				const x = x0 + ((i + 0.5) / brays.length) * (x1 - x0);
				set(ln, { x1: x - Lr * c, y1: GY - Lr * s, x2: x - 2 * c, y2: GY - 2 * s });
			});
			set(strip, { x1: x0, y1: GY + 3.5, x2: x1, y2: GY + 3.5 });
			strip.style.opacity = String(0.3 + 0.7 * s);
			// the same beam across the rays, a little above the ground
			const k = 70;
			const cx0 = { x: x0 - k * c, y: GY - k * s };
			set(cross, { x1: cx0.x, y1: cx0.y, x2: cx0.x + W * s, y2: cx0.y - W * c });
			barc.setAttribute('d', `M${f(x0 - 30)} ${GY} A30 30 0 0 1 ${f(x0 - 30 * c)} ${f(GY - 30 * s)}`);
			set(bh, { x: x0 - 44 * Math.cos((h / 2) * DEG) - 6, y: GY - 44 * Math.sin((h / 2) * DEG) + 6 });
			set(tStrip, { x: GX, y: GY + 26 });
			set(tCross, { x: cx0.x + W * s + 6, y: cx0.y - W * c - 2 });
			labelB.innerHTML = `На 1 м² земли приходится sin <i>h</i> ≈ <b>${Math.round(100 * s)}&nbsp;%</b> мощности отвесных лучей`;
		};
		let t = 0;
		const YEAR = 12; // s per year on the picture
		const START = 79; // 20 March
		draw(START);
		loop(root, (dt) => {
			t += dt;
			draw((START + (365 * t) / YEAR) % 365);
			return true;
		});
	}
</script>
