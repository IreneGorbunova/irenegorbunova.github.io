---
/**
 * The speed of a point of the Earth's surface. The Earth in a meridian cut: the axis, the equator, Moscow at
 * φ = 55,75° on the outline, the radius R to it and the radius R cos φ of the circle it runs along (the parallels are
 * drawn as ellipses, seen a little from above). Dots run along the equator and the parallel of Moscow with the same
 * angular speed; the speed arrows at the front are to one scale (0,13 px per m/s): 465 m/s and 262 m/s, 0 at the pole.
 */
import PicStyles from './PicStyles.astro';

const C = { x: 118, y: 132 };
const R = 100;
const PHI = 55.75;
const rad = (d: number) => (d * Math.PI) / 180;
const mY = C.y - R * Math.sin(rad(PHI));
const mR = R * Math.cos(rad(PHI));
const E = 0.18; // ellipse flattening of the parallels
const K = 0.13; // px per m/s
const vEq = 465;
const vM = 262;
const f = (x: number) => x.toFixed(1);
const half = (cx: number, cy: number, rx: number, ry: number, front: boolean) =>
	`M${f(cx - rx)} ${f(cy)} A${f(rx)} ${f(ry)} 0 0 ${front ? 0 : 1} ${f(cx + rx)} ${f(cy)}`;
const arcR = 28;
const uid = Math.random().toString(36).slice(2, 8);
---

<PicStyles />
<figure class="zp zp--one zrot not-content" data-zrot>
	<div class="zp__grid">
		<svg class="zp__svg" viewBox="0 0 360 262" role="img" aria-label="Земля в разрезе по меридиану. Точка на экваторе движется по окружности радиусом R со скоростью 465 м/с, точка на широте Москвы — по окружности радиусом R cos φ со скоростью 262 м/с, точка на полюсе стоит на месте">
			<defs>
				<marker id={`zr-a-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
					<path class="zp-head--blue" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<circle class="zp-earth zrot-earth" cx={C.x} cy={C.y} r={R}></circle>
			<!-- back halves of the parallels -->
			<path class="zp-dash" d={half(C.x, C.y, R, R * E, false)}></path>
			<path class="zp-dash" d={half(C.x, mY, mR, mR * E, false)}></path>
			<!-- the axis -->
			<line class="zp-axis" x1={C.x} y1={C.y - R - 14} x2={C.x} y2={C.y + R + 14}></line>
			<!-- front halves -->
			<path class="zrot-par" d={half(C.x, C.y, R, R * E, true)}></path>
			<path class="zrot-par" d={half(C.x, mY, mR, mR * E, true)}></path>
			<!-- R, R cos φ, φ -->
			<line class="zrot-r" x1={C.x} y1={C.y} x2={C.x + mR} y2={mY}></line>
			<line class="zrot-rc" x1={C.x} y1={mY} x2={C.x + mR} y2={mY}></line>
			<line class="zp-line" x1={C.x} y1={C.y} x2={C.x + R} y2={C.y}></line>
			<path class="zp-arc" d={`M${f(C.x + arcR)} ${C.y} A${arcR} ${arcR} 0 0 0 ${f(C.x + arcR * Math.cos(rad(PHI)))} ${f(C.y - arcR * Math.sin(rad(PHI)))}`}></path>
			<text class="zp-t-math" x={f(C.x + (arcR + 6) * Math.cos(rad(PHI / 2)))} y={f(C.y - (arcR + 6) * Math.sin(rad(PHI / 2)) + 5)}>φ</text>
			<text class="zp-t-math" x={f(C.x + mR * 0.55 + 4)} y={f(C.y - (C.y - mY) * 0.55 + 4)}>R</text>
			<text x={f(C.x + mR / 2)} y={f(mY - 7)} text-anchor="middle"><tspan class="zp-t-math">R</tspan> cos <tspan class="zp-t-math">φ</tspan></text>
			<!-- speeds at the front points, one scale -->
			<line class="zrot-v" x1={C.x} y1={C.y + R * E} x2={C.x + K * vEq} y2={C.y + R * E} marker-end={`url(#zr-a-${uid})`}></line>
			<line class="zrot-v" x1={C.x} y1={mY + mR * E} x2={C.x + K * vM} y2={mY + mR * E} marker-end={`url(#zr-a-${uid})`}></line>
			<circle class="zrot-dot" r="4" data-dot="eq"></circle>
			<circle class="zrot-dot" r="4" data-dot="m"></circle>
			<circle class="zrot-pole" cx={C.x} cy={C.y - R} r="3.5"></circle>
			<circle class="zrot-m" cx={C.x + mR} cy={mY} r="3.5"></circle>
			<!-- labels -->
			<text x="236" y={f(C.y - R + 4)}>полюс: <tspan class="zp-t-hl">0</tspan></text>
			<text x="236" y={f(mY + 4)}>Москва: <tspan class="zp-t-hl">262 м/с</tspan></text>
			<text x="236" y={f(C.y + 4)}>экватор: <tspan class="zp-t-hl">465 м/с</tspan></text>
			<text x={C.x + 6} y={C.y + R + 12} class="zp-t-small">ось вращения</text>
		</svg>
	</div>
	<figcaption class="zp__cap">
		За звёздные сутки все точки Земли делают по одному обороту. Точка на экваторе проходит за это время окружность
		радиусом <i>R</i>, а точка на широте <i>φ</i> — меньшую окружность, радиусом <i>R</i> cos <i>φ</i>. Синие стрелки — скорости
		в одном масштабе.
	</figcaption>
</figure>

<style is:global>
	.zrot-par {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
	}
	.zrot-r {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.zrot-rc {
		stroke: var(--ig-v);
		stroke-width: 2;
	}
	.zrot-v {
		stroke: var(--ig-vx);
		stroke-width: 2.4;
	}
	.zrot-dot {
		fill: var(--ig-vy);
	}
	.zrot-pole,
	.zrot-m {
		fill: var(--sl-color-white);
	}
	:root[data-theme='light'] .zrot-earth {
		fill: color-mix(in srgb, var(--ig-vx) 25%, var(--sl-color-gray-6));
	}
</style>

<script>
	import { loop } from '@components/intro/scene';

	for (const root of document.querySelectorAll<HTMLElement>('[data-zrot]')) {
		const C = { x: 118, y: 132 };
		const R = 100;
		const phi = (55.75 * Math.PI) / 180;
		const mY = C.y - R * Math.sin(phi);
		const mR = R * Math.cos(phi);
		const E = 0.18;
		const dots = [
			{ el: root.querySelector<SVGCircleElement>('[data-dot="eq"]')!, cy: C.y, rx: R },
			{ el: root.querySelector<SVGCircleElement>('[data-dot="m"]')!, cy: mY, rx: mR },
		];
		const PERIOD = 10; // s per turn on the picture
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			const th = (2 * Math.PI * t) / PERIOD;
			for (const d of dots) {
				d.el.setAttribute('cx', (C.x + d.rx * Math.sin(th)).toFixed(1));
				d.el.setAttribute('cy', (d.cy + d.rx * E * Math.cos(th)).toFixed(1));
				d.el.style.opacity = Math.cos(th) < 0 ? '0.35' : '1';
			}
			return true;
		});
	}
</script>
