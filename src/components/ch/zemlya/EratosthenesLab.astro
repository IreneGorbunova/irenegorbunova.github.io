---
/**
 * Eratosthenes' measurement. The Sun is so far that its rays are parallel. At noon on the summer solstice it stands
 * in the zenith at Syene; a gnomon in a city further north casts a shadow, and the angle α between the gnomon and
 * the ray equals the angle between the two cities as seen from the centre of the Earth.
 * The slider moves the second city along the meridian (α); the distance grows in proportion (5000 стадий for 7,2°),
 * so the circumference L = (360°/α)·l is the same for any city. «Плоская Земля»: every gnomon stands parallel to
 * the rays, and there is no shadow anywhere. The gnomons are drawn far too tall, the Earth to scale with itself.
 */
const uid = `zer-${Math.random().toString(36).slice(2, 8)}`;
const OX = 128;
const OY = 182;
const R = 104;
---

<figure class="zer not-content" data-zer data-geo={JSON.stringify({ OX, OY, R })}>
	<svg class="zer__svg" viewBox="0 0 400 300" role="img" aria-label="Опыт Эратосфена: параллельные лучи Солнца, Сиена и Александрия">
		<defs>
			<clipPath id={`${uid}-sky`}><rect x="0" y="0" width="242" height="300" /></clipPath>
		</defs>
		<g clip-path={`url(#${uid}-sky)`}>
			<g data-rays></g>
		</g>
		<text class="zer__t zer__t--sun" x="8" y="18">лучи Солнца</text>
		<g data-round>
			<circle class="zer__earth" cx={OX} cy={OY} r={R} />
			<line class="zer__rad" data-rad1 />
			<line class="zer__rad" data-rad2 />
			<path class="zer__arc" data-arc0 d="" />
			<text class="zer__t zer__t--a" data-a0></text>
			<circle class="zer__centre" cx={OX} cy={OY} r="2.2" />
			<text class="zer__t zer__t--dim" x={OX + 6} y={OY + 16}>центр Земли</text>
		</g>
		<g data-flat>
			<rect class="zer__earth" x="0" y={OY - R} width="242" height={300 - OY + R} />
		</g>
		<g data-cities>
			<line class="zer__gn" data-gn1 />
			<line class="zer__gn" data-gn2 />
			<line class="zer__shadow" data-sh2 />
			<circle class="zer__city" data-c1 r="3" />
			<circle class="zer__city" data-c2 r="3" />
			<text class="zer__t" data-l1>Сиена</text>
			<text class="zer__t" data-l2>Александрия</text>
		</g>
		<!-- the zoomed gnomon -->
		<rect class="zer__box" x="252" y="34" width="140" height="246" rx="10" />
		<text class="zer__t zer__t--dim" x="322" y="54" text-anchor="middle">гномон крупно:</text>
		<text class="zer__t zer__t--dim" x="322" y="70" text-anchor="middle" data-boxtitle>Александрия</text>
		<g data-zoom>
			<line class="zer__zray" data-zr1 />
			<line class="zer__zray" data-zr2 />
			<line class="zer__ground" x1="262" y1="250" x2="382" y2="250" />
			<line class="zer__zshadow" data-zsh />
			<line class="zer__zgn" x1="322" y1="250" x2="322" y2="130" />
			<line class="zer__zext" x1="322" y1="130" x2="322" y2="84" />
			<path class="zer__arc" data-arc1 d="" />
			<text class="zer__t zer__t--a" data-a1></text>
			<text class="zer__t zer__t--dim" data-shtext x="322" y="270" text-anchor="middle"></text>
		</g>
	</svg>

	<label class="zer__slider">
		<span data-sltitle>Угол тени <i>α</i></span>
		<input type="range" min="0" max="30" step="0.1" value="7.2" data-alpha aria-label="Угол между гномоном и лучом Солнца" />
	</label>
	<div class="zer__bar">
		<button type="button" class="zer__chip" data-alex>Александрия</button>
		<button type="button" class="zer__toggle" data-flat-btn aria-pressed="false">
			<span class="zer__switch" aria-hidden="true"></span> А если Земля плоская?
		</button>
	</div>
	<p class="zer__calc" data-calc aria-live="polite"></p>
	<figcaption class="zer__caption">
		Полдень дня летнего солнцестояния. Углы настоящие, а гномоны нарисованы во много раз выше, чем они есть. Справа —
		гномон второго города крупно.
	</figcaption>
</figure>

<style is:global>
	.zer {
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.zer i {
		font-family: var(--ig-font-math);
	}
	.zer__svg {
		display: block;
		width: 100%;
		max-width: 40rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.7rem;
		background: linear-gradient(#0d1430, #172447 60%, #1d2c52);
	}
	.zer__t {
		fill: rgb(235 238 255 / 0.92);
		font-size: 13px;
		font-family: var(--sl-font);
		paint-order: stroke;
		stroke: #0d1430;
		stroke-width: 3px;
	}
	.zer__t--sun {
		fill: #ffe39a;
	}
	.zer__t--dim {
		fill: rgb(235 238 255 / 0.65);
		font-size: 11.5px;
	}
	.zer__t--a {
		fill: #ffe39a;
		font-weight: 700;
		font-size: 13px;
	}
	.zer__ray {
		stroke: #ffd66b;
		stroke-width: 1;
		opacity: 0.55;
	}
	.zer__rayhead {
		fill: #ffd66b;
		opacity: 0.75;
	}
	.zer__earth {
		fill: #3d6a3a;
		stroke: #8fc48a;
		stroke-width: 1;
	}
	.zer__rad {
		stroke: rgb(235 238 255 / 0.6);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.zer__centre {
		fill: #fff;
	}
	.zer__arc {
		fill: rgb(255 214 107 / 0.25);
		stroke: #ffd66b;
		stroke-width: 1.2;
	}
	.zer__gn,
	.zer__zgn {
		stroke: #f4efe2;
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.zer__shadow,
	.zer__zshadow {
		stroke: #05070f;
		stroke-width: 3.2;
		stroke-linecap: round;
	}
	.zer__city {
		fill: #ff8fa3;
	}
	.zer__box {
		fill: rgb(5 8 20 / 0.55);
		stroke: rgb(235 238 255 / 0.25);
	}
	.zer__ground {
		stroke: #8fc48a;
		stroke-width: 2;
	}
	.zer__zray {
		stroke: #ffd66b;
		stroke-width: 1.4;
	}
	.zer__zext {
		stroke: rgb(244 239 226 / 0.6);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.zer__slider {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.7rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.zer__slider input {
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.zer__bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.5rem;
	}
	.zer__chip,
	.zer__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.3rem 0.85rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.zer__toggle {
		padding-left: 0.5rem;
	}
	.zer__chip:hover,
	.zer__toggle:hover {
		border-color: var(--sl-color-accent);
	}
	.zer__chip.is-on {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.zer__switch {
		position: relative;
		flex: none;
		width: 2rem;
		height: 1.1rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		transition: background-color 0.2s;
	}
	.zer__switch::after {
		content: '';
		position: absolute;
		top: 0.15rem;
		left: 0.15rem;
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		background: var(--sl-color-white);
		transition: transform 0.2s;
	}
	.zer__toggle[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
	}
	.zer__toggle[aria-pressed='true'] .zer__switch {
		background: var(--sl-color-accent);
	}
	.zer__toggle[aria-pressed='true'] .zer__switch::after {
		transform: translateX(0.9rem);
	}
	.zer__calc {
		min-height: 3em;
		margin: 0.6rem 0 0;
		padding: 0.5rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.zer__calc b {
		color: var(--sl-color-white);
	}
	.zer__caption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 30rem) {
		.zer {
			padding: 0.5rem;
		}
	}
</style>

<script>
	import { fmt, attrs } from '../luna/util';

	const DEG = Math.PI / 180;
	const NS = 'http://www.w3.org/2000/svg';
	const ALEX = 7.2;
	const STADIA = 5000; // for 7,2°

	for (const root of document.querySelectorAll<HTMLElement>('[data-zer]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const { OX, OY, R } = JSON.parse(root.dataset.geo!);
		const slider = q<HTMLInputElement>('[data-alpha]');
		const flatBtn = q<HTMLButtonElement>('[data-flat-btn]');
		const alexBtn = q<HTMLButtonElement>('[data-alex]');
		const rays = q<SVGGElement>('[data-rays]');
		const round = q<SVGGElement>('[data-round]');
		const flatG = q<SVGGElement>('[data-flat]');
		const calc = q<HTMLElement>('[data-calc]');
		const sltitle = q<HTMLElement>('[data-sltitle]');
		let flat = false;

		// vertical rays: stop at the ground
		const groundY = (x: number) => {
			if (flat) return OY - R;
			const dx = x - OX;
			return Math.abs(dx) < R ? OY - Math.sqrt(R * R - dx * dx) : 300;
		};
		const drawRays = () => {
			rays.replaceChildren();
			for (let x = 14; x < 242; x += 19) {
				const l = document.createElementNS(NS, 'line');
				attrs(l, { x1: x, y1: 26, x2: x, y2: groundY(x), class: 'zer__ray' });
				const h = document.createElementNS(NS, 'path');
				attrs(h, { d: 'M 0 5 L -3.2 -3 L 3.2 -3 Z', transform: `translate(${x} 40)`, class: 'zer__rayhead' });
				rays.append(l, h);
			}
		};
		const arcPath = (cx: number, cy: number, r: number, a0: number, a1: number) => {
			const p0 = [cx + r * Math.cos(a0), cy + r * Math.sin(a0)];
			const p1 = [cx + r * Math.cos(a1), cy + r * Math.sin(a1)];
			return `M ${cx} ${cy} L ${p0[0]} ${p0[1]} A ${r} ${r} 0 0 ${a1 > a0 ? 1 : 0} ${p1[0]} ${p1[1]} Z`;
		};

		const draw = () => {
			const a = Number(slider.value);
			const l = (STADIA * a) / ALEX;
			round.style.display = flat ? 'none' : '';
			flatG.style.display = flat ? '' : 'none';
			drawRays();
			// the cities: Syene on top, the second city to the north (left)
			const GN = 22; // drawn gnomon height
			let c1: number[], c2: number[], up2: number[];
			if (flat) {
				c1 = [OX, OY - R];
				c2 = [OX - R * a * DEG, OY - R];
				up2 = [0, -1];
			} else {
				const th = (-90 - a) * DEG; // angle of the second city from the centre (screen coordinates)
				c1 = [OX, OY - R];
				c2 = [OX + R * Math.cos(th), OY + R * Math.sin(th)];
				up2 = [Math.cos(th), Math.sin(th)];
				attrs(q('[data-rad1]'), { x1: OX, y1: OY, x2: c1[0], y2: c1[1] });
				attrs(q('[data-rad2]'), { x1: OX, y1: OY, x2: c2[0], y2: c2[1] });
				const show = a > 0.4;
				q('[data-arc0]').setAttribute('d', show ? arcPath(OX, OY, 30, -Math.PI / 2 - a * DEG, -Math.PI / 2) : '');
				const am = -Math.PI / 2 - (a * DEG) / 2;
				attrs(q('[data-a0]'), { x: OX + 40 * Math.cos(am) - 8, y: OY + 40 * Math.sin(am) + 2, 'text-anchor': 'end' });
				q('[data-a0]').textContent = show ? `α = ${fmt(a, 1)}°` : '';
			}
			attrs(q('[data-gn1]'), { x1: c1[0], y1: c1[1], x2: c1[0], y2: c1[1] - GN });
			const g2 = [c2[0] + up2[0] * GN, c2[1] + up2[1] * GN];
			attrs(q('[data-gn2]'), { x1: c2[0], y1: c2[1], x2: g2[0], y2: g2[1] });
			// the shadow of the second gnomon: where the ray through its top meets the ground
			let shEnd = c2;
			if (!flat && a > 0.05) {
				// line x = g2.x going down; meets the circle
				const dx = g2[0] - OX;
				const y = OY - Math.sqrt(Math.max(0, R * R - dx * dx));
				shEnd = [g2[0], y];
			}
			attrs(q('[data-sh2]'), { x1: c2[0], y1: c2[1], x2: shEnd[0], y2: shEnd[1] });
			attrs(q('[data-c1]'), { cx: c1[0], cy: c1[1] });
			attrs(q('[data-c2]'), { cx: c2[0], cy: c2[1] });
			attrs(q('[data-l1]'), { x: c1[0] + 7, y: c1[1] - 8, 'text-anchor': 'start' });
			const isAlex = Math.abs(a - ALEX) < 0.05;
			const l2 = q<SVGTextElement>('[data-l2]');
			l2.textContent = a < 0.05 ? '' : isAlex ? 'Александрия' : 'второй город';
			attrs(l2, { x: c2[0] + 4, y: c2[1] + 20, 'text-anchor': 'start' });
			// zoom: the gnomon stands vertically, the rays come from the south (the right) at α to it
			const za = flat ? 0 : a;
			const H = 120;
			const tip = [322, 130];
			const sn = Math.sin(za * DEG);
			const cs = Math.cos(za * DEG);
			const L1 = 90;
			const ray = (x0: number) => {
				const st = [x0 + sn * L1, tip[1] - cs * L1];
				const s2 = (250 - st[1]) / cs;
				return { x1: st[0], y1: st[1], x2: st[0] - sn * s2, y2: 250 };
			};
			attrs(q('[data-zr1]'), ray(tip[0]));
			attrs(q('[data-zr2]'), ray(tip[0] + 30));
			attrs(q('[data-zsh]'), { x1: 322, y1: 250, x2: 322 - H * Math.tan(za * DEG), y2: 250 });
			const showZ = za > 0.4;
			q('[data-arc1]').setAttribute('d', showZ ? arcPath(tip[0], tip[1], 30, -Math.PI / 2, -Math.PI / 2 + za * DEG) : '');
			const amz = -Math.PI / 2 + (za * DEG) / 2;
			attrs(q('[data-a1]'), { x: tip[0] + 40 * Math.cos(amz) + 2, y: tip[1] + 40 * Math.sin(amz) + 4, 'text-anchor': 'start' });
			q('[data-a1]').textContent = showZ ? 'α' : '';
			q('[data-shtext]').textContent = za > 0.05 ? 'тень' : 'тени нет';
			q('[data-boxtitle]').textContent = a < 0.05 ? 'Сиена' : isAlex ? 'Александрия' : 'второй город';
			alexBtn.classList.toggle('is-on', isAlex);
			// the calculation
			const lTxt = fmt(Math.round(l / 10) * 10, 0);
			if (flat) {
				sltitle.innerHTML = 'Второй город';
				calc.innerHTML =
					a < 0.05
						? 'Передвиньте второй город.'
						: `Второй город в ${lTxt} стадиях от Сиены, а <b>тени нет</b>: на плоской Земле все гномоны параллельны лучам. Значит, тень в Александрии, которую видел Эратосфен, говорит о том, что Земля круглая.`;
			} else {
				sltitle.innerHTML = 'Угол тени <i>α</i>';
				const n = 360 / a;
				calc.innerHTML =
					a < 0.05
						? 'Второй город совпал с Сиеной: тени нет и там, и тут. Передвиньте его на север.'
						: `<b>α = ${fmt(a, 1)}°</b> — это 1/${fmt(n, Math.abs(n - Math.round(n)) < 0.05 ? 0 : 1)} окружности. До Сиены <b>${lTxt} стадий</b>.<br/><i>L</i> = ${fmt(n, Math.abs(n - Math.round(n)) < 0.05 ? 0 : 1)} · ${lTxt} стадий ≈ <b>250 000 стадий</b>.`;
			}
		};
		slider.addEventListener('input', draw);
		alexBtn.addEventListener('click', () => {
			slider.value = String(ALEX);
			draw();
		});
		flatBtn.addEventListener('click', () => {
			flat = !flat;
			flatBtn.setAttribute('aria-pressed', String(flat));
			draw();
		});
		draw();
	}
</script>
