---
/** Frame and shared parts of the explanatory pictures of «Земля — планета» (panels, labels, arrows). Renders nothing. */
---

<style is:global>
	.zp {
		--zp-earth: color-mix(in srgb, var(--ig-vx) 55%, var(--sl-color-gray-4));
		--zp-night: color-mix(in srgb, var(--sl-color-black) 55%, transparent);
		--zp-sun: var(--ig-v);
		--zp-ir: var(--ig-vy);
		margin-block: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .zp {
		--zp-night: color-mix(in srgb, var(--sl-color-white) 30%, transparent);
	}
	.zp__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.zp--one .zp__grid {
		grid-template-columns: minmax(0, 1fr);
		max-width: 26rem;
		margin-inline: auto;
	}
	.zp__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		background: var(--sl-color-bg);
		user-select: none;
		-webkit-user-select: none;
	}
	.zp text {
		font-family: var(--__sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	.zp .zp-t-math {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 15px;
		fill: var(--sl-color-white);
	}
	.zp .zp-t-hl {
		fill: var(--ig-v);
		font-weight: 700;
	}
	.zp .zp-t-small {
		font-size: 11.5px;
	}
	.zp__label {
		margin: 0.45rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		color: var(--sl-color-gray-2);
	}
	.zp__label b {
		color: var(--sl-color-white);
	}
	.zp__label i {
		font-family: var(--ig-font-math);
	}
	.zp__cap {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-xs);
		line-height: 1.45;
		color: var(--sl-color-gray-3);
	}
	.zp__cap i {
		font-family: var(--ig-font-math);
	}
	.zp-earth {
		fill: var(--zp-earth);
	}
	.zp-nightside {
		fill: var(--zp-night);
	}
	.zp-line {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.zp-dash {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 4 4;
	}
	.zp-axis {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.8;
	}
	.zp-ray {
		fill: none;
		stroke: var(--zp-sun);
		stroke-width: 1.6;
	}
	.zp-arc {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.6;
	}
	.zp-head {
		fill: var(--zp-sun);
	}
	.zp-head--gray {
		fill: var(--sl-color-gray-2);
	}
	.zp-head--blue {
		fill: var(--ig-vx);
	}
	.zp-head--red {
		fill: var(--zp-ir);
	}
	@media (max-width: 40rem) {
		.zp__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
