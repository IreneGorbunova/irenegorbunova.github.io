<script>
	import { scene } from '@components/intro/scene';
	import { el, rng } from '../g7/kit';
	import { person, type Pose } from '../davlenie-zakon-paskalya/person';

	const f = (v: number) => v.toFixed(1);

	/** A snowflake of radius R around (0, 0): six arms with side branches; three kinds. */
	const flakePath = (R: number, kind: number) => {
		let d = '';
		for (let i = 0; i < 6; i++) {
			const a = (i * Math.PI) / 3 - Math.PI / 2;
			const ux = Math.cos(a);
			const uy = Math.sin(a);
			const at = (s: number, b: number, l: number) => {
				const x0 = ux * s * R;
				const y0 = uy * s * R;
				const bx = Math.cos(a + b);
				const by = Math.sin(a + b);
				return `M${f(x0)} ${f(y0)} L${f(x0 + bx * l * R)} ${f(y0 + by * l * R)} `;
			};
			d += `M0 0 L${f(ux * R)} ${f(uy * R)} `;
			if (kind === 0) {
				// a stellar dendrite: long side branches
				for (const [s, l] of [
					[0.3, 0.32],
					[0.55, 0.26],
					[0.78, 0.16],
				])
					d += at(s, Math.PI / 3, l) + at(s, -Math.PI / 3, l);
			} else if (kind === 1) {
				// a sector plate: a small hexagon in the middle, broad tips
				d += at(0.8, Math.PI / 3, 0.18) + at(0.8, -Math.PI / 3, 0.18) + at(0.62, Math.PI / 3, 0.12) + at(0.62, -Math.PI / 3, 0.12);
				const b = (i + 1) * (Math.PI / 3) - Math.PI / 2;
				d += `M${f(ux * 0.38 * R)} ${f(uy * 0.38 * R)} L${f(Math.cos(b) * 0.38 * R)} ${f(Math.sin(b) * 0.38 * R)} `;
			} else {
				// a fern-like star: many short branches
				for (let s = 0.22; s < 0.95; s += 0.13) {
					const l = 0.14 * (1 - s) + 0.05;
					d += at(s, Math.PI / 3, l) + at(s, -Math.PI / 3, l);
				}
			}
		}
		return d;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-tvintro]')) {
		// ---------------- the snow ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="snow"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 214;
			const S = 0.9; // px per см
			const H = 158;
			const u = S * H;
			const girl = person($<SVGGElement>('[data-girl]'), { s: S, H, girth: 0.9, gear: 'boot', coat: 'tv-coat' });
			const hipX = 110;
			const hip = { x: hipX, y: G - 8 * S - 0.468 * u };
			const sh = { x: hipX + 0.02 * u, y: hip.y - 0.27 * u };
			const hand = { x: sh.x + 0.27 * u, y: sh.y + 0.12 * u };
			const pose: Pose = {
				hip,
				lean: 0.05,
				ankles: [
					{ x: hipX + 0.05 * u, y: G - 8 * S },
					{ x: hipX - 0.06 * u, y: G - 8 * S },
				],
				feet: [0, 0],
				hands: [hand, { x: hipX - 0.01 * u, y: hip.y + 0.06 * u }],
				head: 0.38,
			};
			girl(pose);
			// the mitten (top of it), where the flakes land
			const mit = { x: hand.x, y: hand.y - 0.036 * u };
			$<SVGLineElement>('[data-callout]').setAttribute('x1', f(mit.x + 3));
			$<SVGLineElement>('[data-callout]').setAttribute('y1', f(mit.y));

			// the falling snow: 46 flakes, 40–60 px/s, swaying ±5 px
			const rnd = rng(7);
			const fall = $<SVGGElement>('[data-falling]');
			const flakes = Array.from({ length: 46 }, () => {
				const c = el('circle', { class: 'tv-snowdot', r: f(0.7 + rnd() * 1.1) });
				fall.append(c);
				return { c, x: rnd() * 360, y: rnd() * 240, v: 40 + rnd() * 20, ph: rnd() * 6.28, w: 0.8 + rnd() * 0.8 };
			});
			// the three flakes that land: they start 2,2 с (at 45 px/s) above the mitten
			const LAND = [2.4, 4.6, 6.6];
			const V = 45;
			const main = $<SVGGElement>('[data-flake]');
			const mains = LAND.map((_, i) => {
				const p = el('path', { d: flakePath(2.4, i), 'stroke-width': '0.7' });
				main.append(p);
				return p;
			});
			const dots = $<SVGGElement>('[data-dots]');
			const landed = LAND.map((_, i) => {
				const c = el('circle', { class: 'tv-snowdot', cx: f(mit.x - 3 + i * 3), cy: f(mit.y + 1 + (i % 2)), r: '1.1' });
				dots.append(c);
				return c;
			});
			// in the magnifier: about 20 times larger
			const zoom = $<SVGGElement>('[data-zoom]');
			const spots = [
				{ x: 258, y: 58, r: 20, rot: 8 },
				{ x: 300, y: 82, r: 17, rot: -12 },
				{ x: 262, y: 100, r: 15, rot: 20 },
			];
			const zf = spots.map((s, i) => {
				const p = el('path', { class: 'tv-zflake', d: flakePath(s.r, i), 'stroke-width': i === 1 ? '2.2' : '1.6' });
				zoom.append(p);
				return p;
			});
			const lens = $<SVGGElement>('[data-lens]');
			const RUN = 8.5;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				for (const fl of flakes) {
					const y = (fl.y + fl.v * t) % 250;
					fl.c.setAttribute('cx', f(fl.x + 5 * Math.sin(fl.ph + fl.w * t)));
					fl.c.setAttribute('cy', f(y - 5));
				}
				LAND.forEach((tl, i) => {
					const dt = tl - t;
					const show = dt > 0 && dt < 2.4;
					mains[i].style.display = show ? '' : 'none';
					if (show) {
						const y = mit.y - V * dt;
						const xx = mit.x - 3 + i * 3 + 6 * Math.sin(1.3 * dt + i) * Math.min(1, dt);
						mains[i].setAttribute('transform', `translate(${f(xx)} ${f(y)}) rotate(${f(dt * 40)})`);
					}
					landed[i].style.display = t >= tl ? '' : 'none';
					const k = Math.min(1, Math.max(0, (t - tl) / 0.35));
					const s = spots[i];
					zf[i].style.display = t >= tl ? '' : 'none';
					zf[i].setAttribute('transform', `translate(${s.x} ${s.y}) rotate(${s.rot}) scale(${f(1.25 - 0.25 * k)})`);
					zf[i].setAttribute('opacity', f(k));
				});
				lens.setAttribute('opacity', f(Math.min(1, Math.max(0, (t - LAND[0] + 0.2) / 0.4))));
			});
		}

		// ---------------- the kitchen ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="kitchen"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 1.9;
			const FY = 232;
			const Z = K / 2.2; // the cat and the objects are drawn in px for 2,2 px per см
			const TY = FY - 75 * K;
			const g = (980 * K) / 9; // px/s², slowed down 3 times: 207 px/s²
			const tFall = Math.sqrt((2 * (FY - TY)) / g); // 1,17 s
			// the cat, facing right; its paws stand on the table top a little behind the objects (y = TY − 4)
			const catG = $<SVGGElement>('[data-cat]');
			const mk = <K2 extends keyof SVGElementTagNameMap>(p: Element, tag: K2, a: Record<string, string | number>) => {
				const e = el(tag, a);
				p.append(e);
				return e;
			};
			const legsFar = mk(catG, 'g', { class: 'tv-cat-far' });
			const legLine = (p: Element) => {
				const o = mk(p, 'path', { class: 'tv-cat-leg-o', 'stroke-width': '7.4' });
				const i = mk(p, 'path', { class: 'tv-cat-leg', 'stroke-width': '6' });
				return (d: string) => (o.setAttribute('d', d), i.setAttribute('d', d));
			};
			const farLegs = [legLine(legsFar), legLine(legsFar)];
			const tail = mk(catG, 'path', { class: 'tv-cat', d: '' });
			mk(catG, 'path', { class: 'tv-cat', d: 'M-34 -26 Q-36 -46 -10 -47 Q22 -50 30 -42 Q38 -34 30 -22 Q0 -16 -34 -26 Z' });
			mk(catG, 'path', { class: 'tv-cat-stripe', d: 'M-20 -45 Q-18 -38 -22 -32 M-8 -47 Q-6 -40 -10 -33 M4 -47 Q6 -41 3 -34' });
			const nearLegs = [legLine(catG), legLine(catG)];
			const head = mk(catG, 'g', {});
			mk(head, 'path', { class: 'tv-cat', d: 'M-8 -9 L-6 -22 L1 -12 Z M4 -12 L9 -23 L12 -9 Z' });
			mk(head, 'circle', { class: 'tv-cat', r: '11' });
			mk(head, 'path', { class: 'tv-cat', d: 'M6 -2 Q16 -1 15 5 Q10 9 4 6 Z' });
			mk(head, 'path', { class: 'tv-cat-eye', d: 'M5 -4 Q7.5 -7 10 -4 Q7.5 -2 5 -4 Z' });
			mk(head, 'circle', { class: 'tv-cat-nose', cx: '14.6', cy: '0.6', r: '1.6' });
			mk(head, 'path', { class: 'tv-whisker', d: 'M12 3 L22 1 M12 4 L22 5 M12 5 L21 8' });
			// objects
			const ball = $<SVGGElement>('[data-ball]');
			const mug = $<SVGGElement>('[data-mug]');
			const mugBody = $<SVGPathElement>('[data-mugbody]');
			const glass = $<SVGGElement>('[data-glass]');
			const shardsG = $<SVGGElement>('[data-shards]');
			const OBJ = [
				{ x: 172, t: 1.0 }, // the ball: swatted at 1,0 s
				{ x: 236, t: 3.0 }, // the mug
				{ x: 300, t: 5.2 }, // the glass
			];
			const rnd = rng(11);
			const shards = Array.from({ length: 9 }, (_, i) => {
				const n = 3 + (i % 2);
				let d = 'M0 0';
				for (let k = 1; k < n; k++) {
					const a = (k / n) * 2 * Math.PI + rnd() * 0.6;
					const r = 3 + rnd() * 4;
					d += ` L${f(r * Math.cos(a))} ${f(r * Math.sin(a))}`;
				}
				const p = el('path', { class: 'tv-shard', d: d + ' Z' });
				shardsG.append(p);
				return { p, vx: (rnd() - 0.5) * 130, vy: -40 - rnd() * 70, rot: (rnd() - 0.5) * 700, dy: rnd() * 8 - 2 };
			});
			// a falling object: after the swat it slides 6 px forward in 0,15 s, then falls from the edge
			const drop = (t: number, t0: number) => {
				const s = t - t0;
				if (s < 0) return { y: TY, fly: -1 };
				if (s < 0.15) return { y: TY + (s / 0.15) * 0, fly: -1, slide: s / 0.15 };
				const tf = s - 0.15;
				return { y: Math.min(FY, TY + 0.5 * g * tf * tf), fly: tf };
			};
			const RUN = 8.6;
			scene(card, RUN, (x) => {
				const t = x * RUN;
				// the cat walks 30 px/s between stops; stops 0,6 s before each swat with its head 30 px behind the object
				// walking at 52 px/s (24 см/с); the cat arrives 0,5 s before each swat, its paw 30 px short of the object
				const W = 52;
				let cx = 64;
				let walking = false;
				let swat = 0;
				let tt = 0;
				let pos = 64;
				for (let i = 0; i < 3; i++) {
					const stop = OBJ[i].x - 44;
					const arrive = OBJ[i].t - 0.5;
					const start = arrive - (stop - pos) / W;
					if (t < start) break;
					if (t < arrive) {
						cx = pos + W * (t - start);
						walking = true;
						tt = t - start;
						break;
					}
					cx = pos = stop;
					const ds = t - OBJ[i].t;
					if (ds > -0.3 && ds < 0.35) swat = Math.sin(((ds + 0.3) / 0.65) * Math.PI);
				}
				catG.setAttribute('transform', `translate(${f(cx)} ${f(TY - 5)}) scale(${f(Z)})`);
				const ph = walking ? tt * 7 : 0;
				const legAt = (hx: number, hy: number, phase: number, paw = 0) => {
					const sw = Math.sin(ph + phase) * 5;
					const lift = Math.max(0, Math.cos(ph + phase)) * (walking ? 3 : 0);
					const fx = hx + sw + paw * 18;
					const fy = -lift - paw * 14;
					return `M${hx} ${hy} L${f((hx + fx) / 2 + 1)} ${f((hy + fy) / 2)} L${f(fx)} ${f(fy)}`;
				};
				farLegs[0](legAt(20, -26, Math.PI));
				farLegs[1](legAt(-24, -28, 0));
				nearLegs[0](legAt(26, -26, 0, swat));
				nearLegs[1](legAt(-28, -28, Math.PI));
				head.setAttribute('transform', `translate(38 -46) rotate(${f(swat * 18)})`);
				const wag = Math.sin(t * 2.2) * 6;
				tail.setAttribute('d', `M-32 -36 Q-50 -40 ${f(-52 + wag)} -62 Q${f(-54 + wag)} -70 ${f(-48 + wag)} -70 Q${f(-46 + wag)} -60 -30 -30 Z`);

				// the ball: falls, then bounces with e = 0,7 (heights × 0,49) and rolls a little to the right
				{
					const o = OBJ[0];
					const s = t - o.t;
					let y = TY;
					let xx = o.x;
					if (s > 0.15) {
						const tf = s - 0.15;
						xx = o.x - 8 * Math.min(tf, 3);
						let v = g * tFall; // speed at the floor
						let tLeft = tf - tFall;
						if (tLeft < 0) y = TY + 0.5 * g * tf * tf;
						else {
							y = FY;
							for (let k = 0; k < 12; k++) {
								v *= 0.7;
								const T = (2 * v) / g;
								if (T < 0.03) break;
								if (tLeft < T) {
									y = FY - (v * tLeft - 0.5 * g * tLeft * tLeft);
									break;
								}
								tLeft -= T;
							}
						}
					}
					ball.setAttribute('transform', `translate(${f(xx)} ${f(y - 11 * Z)}) scale(${f(Z)}) rotate(${f((xx - o.x) * 5)})`);
				}
				// the mug: tilts by 15° as it falls, lands on its bottom-left edge, bounces a little and keeps a dent there
				{
					const o = OBJ[1];
					const d = drop(t, o.t);
					let rot = 0;
					let y = d.y;
					const landed = d.fly > tFall;
					if (d.fly >= 0 && !landed) rot = -15 * (d.fly / tFall);
					if (landed) {
						const tb = d.fly - tFall;
						const v = 0.2 * g * tFall;
						const T = (2 * v) / g;
						y = tb < T ? FY - (v * tb - 0.5 * g * tb * tb) : FY;
						rot = tb < T ? -15 * (1 - tb / T) : 0;
					}
					mugBody.setAttribute('d', landed ? 'M-10 -20 L10 -20 L10 0 L-3 0 Q-6 -5 -10 -7 Z M-3 0 Q-5 -3 -10 -4' : 'M-10 -20 L10 -20 L10 0 L-10 0 Z');
					mug.setAttribute('transform', `translate(${f(o.x)} ${f(y)}) scale(${f(Z)}) rotate(${f(rot)})`);
				}
				// the glass: falls, then shatters into nine shards
				{
					const o = OBJ[2];
					const d = drop(t, o.t);
					const broken = d.fly > tFall;
					glass.style.display = broken ? 'none' : '';
					glass.setAttribute('transform', `translate(${o.x} ${f(d.y)}) scale(${f(Z)}) rotate(${f(d.fly > 0 ? (d.fly / tFall) * 24 : 0)})`);
					const tb = broken ? d.fly - tFall : 0;
					for (const sh of shards) {
						sh.p.style.display = broken ? '' : 'none';
						if (!broken) continue;
						// each shard flies until it is back on the floor (a little in front or behind)
						const tLand = (-sh.vy + Math.sqrt(sh.vy * sh.vy + 2 * g * Math.max(0, sh.dy))) / g;
						const tc = Math.min(tb, tLand);
						const sx = o.x + sh.vx * tc;
						const sy = FY - 3 + sh.vy * tc + 0.5 * g * tc * tc;
						sh.p.setAttribute('transform', `translate(${f(sx)} ${f(sy)}) rotate(${f(sh.rot * tc)})`);
					}
				}
			});
		}
	}
</script>
