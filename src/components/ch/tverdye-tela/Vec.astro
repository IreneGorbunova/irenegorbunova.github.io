---
/**
 * A vector label inside an SVG of this chapter: an italic letter with a small arrow over it (Irina, 28 Nov 2026: a
 * force named as a vector carries an arrow in figure labels too), an optional factor before it («4F⃗») and an optional
 * subscript. The arrow spans the letter only; letter widths are those of the math font at 14 px (F about 8,5 px).
 * Props: x, y (baseline), t (the letter), pre (a factor), sub, cls (text classes, e.g. «t-red»), anchor (start, middle,
 * end).
 */
interface Props {
	x: number;
	y: number;
	t: string;
	pre?: string;
	sub?: string;
	cls?: string;
	anchor?: 'start' | 'middle' | 'end';
}
const { x, y, t, pre = '', sub = '', cls = '', anchor = 'start' } = Astro.props;
const wPre = pre.length * 7.2;
const wT = 8.6;
const wSub = sub.length * 6.2;
const total = wPre + wT + wSub;
const x0 = anchor === 'start' ? x : anchor === 'middle' ? x - total / 2 : x - total;
const a0 = x0 + wPre + 1.6;
const a1 = x0 + wPre + wT + 1.2;
const ay = y - 13;
const d = `M${a0.toFixed(1)} ${ay} H${a1.toFixed(1)} M${(a1 - 2.6).toFixed(1)} ${ay - 2.2} L${a1.toFixed(1)} ${ay} L${(a1 - 2.6).toFixed(1)} ${ay + 2.2}`;
---

<g class={`tt-vec ${cls}`}>
	<text class={`t-i ${cls}`} x={x0} y={y}>{pre}{t}{sub && <tspan font-size="10" dy="3" font-style="normal">{sub}</tspan>}</text>
	<path class="tt-vec__arrow" d={d}></path>
</g>

<style is:global>
	.tt-vec__arrow {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tt-vec.t-red .tt-vec__arrow {
		stroke: var(--g7-red);
	}
</style>
