---
/**
 * Picture to «Виды деформации»: what happens inside a body at bending and at twisting (a scheme; the deformations are
 * greatly exaggerated, real ones are fractions of a percent). One loop of 5,2 с, as DeformPicture: the load grows for
 * 1,4 с, holds for 1 с, goes away in 1,2 с, rest 1,6 с.
 *
 * «Изгиб»: a beam 260 px long and 26 px thick on two supports 224 px apart; a force F⃗ pushes its middle down. The beam
 *   sags as a simply supported beam under a central load, w(ξ) = δ(3ξ − 4ξ³) for ξ = x/span ≤ ½ (δ = 14 px at the full
 *   load; the overhangs rise along the tangent at the supports); its cross-sections (thin lines) stay straight and turn
 *   across the bent axis (their turn drawn twice as large). Three round magnifiers: at the top the rows of atoms come
 *   closer (spacing −15 %, «сжатие», arrows inward), in the middle the spacing does not change («нейтральный слой»),
 *   at the bottom they move apart (+15 %, «растяжение», arrows outward). Real strains below 0,2 %.
 * «Кручение»: a round rod (radius 30 px, 166 px long) fixed in a wall is turned at its free end by a pair of forces F⃗
 *   and −F⃗ on the rim of a wheel at its end (oblique view: depth drawn at 0,4 of its length; the forces act at the
 *   nearest and the farthest point of the rim, where they are vertical). Each cross-section turns by φ(x) = Φ·x/L, so
 *   every line along the surface becomes a spiral turned by the angle γ = RΦ/L, and a small square on the surface
 *   becomes a rhombus: γ = 16° at the full load (Φ = 91°). A magnifier shows four rows of atoms shifted along each
 *   other («сдвиг»), each row by γ times the spacing more than the one below.
 */
import G7Styles from '../g7/G7Styles.astro';
import TtStyles from './TtStyles.astro';
import Vec from './Vec.astro';
---

<G7Styles />
<TtStyles />
<figure class="g7 g7--pic bt not-content" data-ttbend>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 340 244" role="img" aria-label="Изгиб: балка на двух опорах прогибается под силой. Верхние слои сжаты, атомы в них сближаются, нижние растянуты, атомы удаляются, средний слой не меняет длины">
			<text class="t-title" x="20" y="22">изгиб</text>
			<path class="bt-ground" d="M28 132 H312"></path>
			<path class="bt-hatch" d={Array.from({ length: 28 }, (_, k) => `M${30 + k * 10} 140 l8 -8`).join(' ')}></path>
			<path class="bt-support" d="M58 114 L48 132 L68 132 Z M282 114 L272 132 L292 132 Z"></path>
			<path class="bt-beam" data-beam d=""></path>
			<path class="bt-sec" data-secs d=""></path>
			<path class="bt-neutral" data-neutral d=""></path>
			<!-- leaders to the magnifiers -->
			<path class="bt-lead" data-lead0 d=""></path>
			<path class="bt-lead" data-lead1 d=""></path>
			<path class="bt-lead" data-lead2 d=""></path>
			<g data-fb>
				<line class="bt-force" x1="170" y1="0" x2="170" y2="0" data-fbl></line>
				<path class="bt-force-head" d="" data-fbh></path>
				<Vec x={162} y={60} t="F" cls="t-red" anchor="end" />
			</g>
			<g data-lens="0" transform="translate(262 50)">
				<circle class="bt-lens" r="28"></circle>
				<g data-atoms></g>
				<g data-arrows class="bt-comp"></g>
				<circle class="bt-ring" r="28"></circle>
			</g>
			<text class="t-small bt-comp-t" x="228" y="40" text-anchor="end">сжатие</text>
			<g data-lens="1" transform="translate(82 186)">
				<circle class="bt-lens" r="28"></circle>
				<g data-atoms></g>
				<circle class="bt-ring" r="28"></circle>
			</g>
			<text class="t-small" x="82" y="232" text-anchor="middle">нейтральный слой</text>
			<g data-lens="2" transform="translate(258 186)">
				<circle class="bt-lens" r="28"></circle>
				<g data-atoms></g>
				<g data-arrows class="bt-tens"></g>
				<circle class="bt-ring" r="28"></circle>
			</g>
			<text class="t-small bt-tens-t" x="258" y="232" text-anchor="middle">растяжение</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 340 244" role="img" aria-label="Кручение: стержень, закреплённый в стене, закручивают парой сил. Квадрат на его поверхности становится ромбом, слои атомов сдвигаются друг относительно друга">
			<text class="t-title" x="20" y="22">кручение</text>
			<rect class="bt-wall" x="20" y="38" width="14" height="128"></rect>
			<path class="bt-hatch" d={Array.from({ length: 13 }, (_, k) => `M20 ${46 + k * 10} l-8 8`).join(' ')}></path>
			<path class="bt-rod" d="M34 70 H200 V130 H34 Z"></path>
			<ellipse class="bt-end" cx="200" cy="100" rx="12" ry="30"></ellipse>
			<path class="bt-gen" data-gens d=""></path>
			<path class="bt-square" data-square d=""></path>
			<path class="bt-lead" data-lead3 d=""></path>
			<ellipse class="bt-wheel" cx="204" cy="100" rx="16" ry="40"></ellipse>
			<path class="bt-spokes" data-spokes d=""></path>
			<circle class="bt-hub" cx="204" cy="100" r="4"></circle>
			<g data-ft>
				<line class="bt-force" data-f1l x1="0" y1="0" x2="0" y2="0"></line>
				<path class="bt-force-head" data-f1h d=""></path>
				<line class="bt-force" data-f2l x1="0" y1="0" x2="0" y2="0"></line>
				<path class="bt-force-head" data-f2h d=""></path>
				<g data-f1t><Vec x={0} y={0} t="F" cls="t-red" /></g>
				<g data-f2t><Vec x={0} y={0} t="F" pre="−" cls="t-red" /></g>
			</g>
			<g data-lens="3" transform="translate(150 198)">
				<circle class="bt-lens" r="30"></circle>
				<g data-atoms></g>
				<g data-arrows class="bt-shear"></g>
				<circle class="bt-ring" r="30"></circle>
			</g>
			<text class="t-small" x="188" y="214">сдвиг</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Изгиб и кручение. В лупах — ряды атомов. При изгибе верхние слои балки сжаты, нижние растянуты, а средний не меняет длины. При кручении слои стержня сдвигаются друг относительно друга, и квадрат на его поверхности становится ромбом. Деформации сильно преувеличены: на самом деле это доли процента.
	</figcaption>
</figure>

<style is:global>
	.bt-ground {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.bt-hatch {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.bt-support,
	.bt-wall {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.bt-beam,
	.bt-rod {
		fill: color-mix(in oklab, var(--tt-steel) 70%, var(--g7-paper));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.bt-end {
		fill: color-mix(in oklab, var(--tt-steel) 85%, var(--sl-color-gray-2));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	.bt-sec,
	.bt-gen {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
		opacity: 0.8;
	}
	.bt-neutral {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-dasharray: 4 3;
	}
	.bt-square {
		fill: color-mix(in oklab, var(--tt-tens) 35%, transparent);
		stroke: var(--tt-tens);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.bt-wheel {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 40%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.bt-spokes {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.bt-hub {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.bt-lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.bt-force {
		stroke: var(--g7-red);
		stroke-width: 3;
	}
	.bt-force-head {
		fill: var(--g7-red);
	}
	.bt-lens {
		fill: var(--g7-paper);
	}
	.bt-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.bt-atom {
		fill: var(--tt-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.bt-arr {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.bt-comp .bt-arr {
		stroke: var(--tt-comp);
	}
	.bt-tens .bt-arr {
		stroke: var(--tt-tens);
	}
	.bt-shear .bt-arr {
		stroke: var(--tt-tens);
	}
	.g7__svg .bt-comp-t {
		fill: var(--tt-comp);
	}
	.g7__svg .bt-tens-t {
		fill: var(--tt-tens);
	}
</style>

<script>
	import { loop, ease, el } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	const D = Math.PI / 180;
	// the load over one loop of 5,2 s: rises 0…1,4, holds to 2,4, falls to 3,6, rest to 5,2
	const load = (t: number) => (t < 1.4 ? ease(t / 1.4) : t < 2.4 ? 1 : t < 3.6 ? 1 - ease((t - 2.4) / 1.2) : 0);
	const arrowHead = (x: number, y: number, ux: number, uy: number, s = 1) => {
		// a head of length 11 at (x, y) pointing along (ux, uy)
		const px = -uy;
		const py = ux;
		return `M${f(x)} ${f(y)} L${f(x - 11 * s * ux + 5.5 * s * px)} ${f(y - 11 * s * uy + 5.5 * s * py)} L${f(x - 11 * s * ux - 5.5 * s * px)} ${f(y - 11 * s * uy - 5.5 * s * py)} Z`;
	};
	const arrow = (x0: number, y0: number, x1: number, y1: number) => {
		const L = Math.hypot(x1 - x0, y1 - y0) || 1;
		const ux = (x1 - x0) / L;
		const uy = (y1 - y0) / L;
		return `M${f(x0)} ${f(y0)} L${f(x1)} ${f(y1)} M${f(x1 - 4 * ux - 3 * uy)} ${f(y1 - 4 * uy + 3 * ux)} L${f(x1)} ${f(y1)} L${f(x1 - 4 * ux + 3 * uy)} ${f(y1 - 4 * uy - 3 * ux)}`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-ttbend]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		// ---- bending
		const XL = 40;
		const XR = 300;
		const S0 = 58;
		const S1 = 282;
		const SPAN = S1 - S0;
		const TOP = 88;
		const HB = 26;
		const w = (x: number, d: number) => {
			const xi = (x - S0) / SPAN;
			if (xi < 0) return (-3 * d * (S0 - x)) / SPAN;
			if (xi > 1) return (-3 * d * (x - S1)) / SPAN;
			const z = Math.min(xi, 1 - xi);
			return d * (3 * z - 4 * z * z * z);
		};
		const slope = (x: number, d: number) => (w(x + 0.5, d) - w(x - 0.5, d)) / 1;
		const lens = [0, 1, 2, 3].map((i) => $<SVGGElement>(`[data-lens="${i}"]`));
		// atoms in the bending magnifiers: 3 rows of 5, spacing 9
		const rows = (g: SVGGElement, nx: number, ny: number) => {
			const a = g.querySelector('[data-atoms]')!;
			return Array.from({ length: nx * ny }, (_, k) => {
				const c = el('circle', { class: 'bt-atom', r: '3.2' });
				a.append(c);
				return { c, i: k % nx, j: Math.floor(k / nx) };
			});
		};
		const at0 = rows(lens[0], 5, 3);
		const at1 = rows(lens[1], 5, 3);
		const at2 = rows(lens[2], 5, 3);
		const at3 = rows(lens[3], 5, 4);
		const arrows = (g: SVGGElement, n: number) => {
			const a = g.querySelector('[data-arrows]')!;
			return Array.from({ length: n }, () => {
				const p = el('path', { class: 'bt-arr' });
				a.append(p);
				return p;
			});
		};
		const ar0 = arrows(lens[0], 2);
		const ar2 = arrows(lens[2], 2);
		const ar3 = arrows(lens[3], 2);
		const beam = $('[data-beam]');
		const secs = $('[data-secs]');
		const neutral = $('[data-neutral]');
		const fbl = $('[data-fbl]');
		const fbh = $('[data-fbh]');
		const fb = $<SVGGElement>('[data-fb]');
		const leads = [0, 1, 2, 3].map((i) => $(`[data-lead${i}]`));
		// ---- twisting
		const CY = 100;
		const R = 30;
		const X0 = 34;
		const XE = 200;
		const LR = XE - X0;
		const K = 0.4; // oblique view: depth drawn at 0,4
		const GAM = 16 * D;
		const PHI = (Math.tan(GAM) * LR) / R; // 1,59 rad = 91°
		const gens = $('[data-gens]');
		const square = $('[data-square]');
		const spokes = $('[data-spokes]');
		const ft = $<SVGGElement>('[data-ft]');
		const f1l = $('[data-f1l]');
		const f1h = $('[data-f1h]');
		const f2l = $('[data-f2l]');
		const f2h = $('[data-f2h]');
		const f1t = $<SVGGElement>('[data-f1t]');
		const f2t = $<SVGGElement>('[data-f2t]');
		const surf = (X: number, th: number) => ({ x: X + K * R * Math.cos(th), y: CY + R * Math.sin(th), vis: Math.cos(th) > 0 });
		const SQ = { x0: 100, x1: 126, th0: -0.4, th1: 0.4 };

		const draw = (t: number) => {
			const L = load(t);
			// ---- bending
			const d = 14 * L;
			let top = '';
			let bot = '';
			for (let x = XL; x <= XR; x += 4) {
				top += `${x === XL ? 'M' : 'L'}${x} ${f(TOP + w(x, d))} `;
				bot = `L${x} ${f(TOP + HB + w(x, d))} ` + bot;
			}
			beam.setAttribute('d', `${top}${bot}Z`);
			let n = '';
			for (let x = XL; x <= XR; x += 4) n += `${x === XL ? 'M' : 'L'}${x} ${f(TOP + HB / 2 + w(x, d))} `;
			neutral.setAttribute('d', n);
			let s = '';
			for (let x = XL + 20; x < XR; x += 20) {
				const sl = 2 * slope(x, d); // the turn of the section, doubled
				const yn = TOP + HB / 2 + w(x, d);
				s += `M${f(x + (HB / 2) * sl)} ${f(yn - HB / 2)} L${f(x - (HB / 2) * sl)} ${f(yn + HB / 2)} `;
			}
			secs.setAttribute('d', s);
			const yTop = TOP + w(170, d);
			fbl.setAttribute('y1', f(yTop - 46));
			fbl.setAttribute('y2', f(yTop - 8));
			fbh.setAttribute('d', arrowHead(170, yTop, 0, 1));
			fb.style.opacity = L > 0.02 ? '1' : '0';
			// leaders: top layer at x = 214, neutral at x = 120, bottom at x = 216
			leads[0].setAttribute('d', `M${f(262 - 20)} ${f(50 + 20)} L214 ${f(TOP + w(214, d) + 3)}`);
			leads[1].setAttribute('d', `M${f(82 + 14)} ${f(186 - 24)} L122 ${f(TOP + HB / 2 + w(122, d))}`);
			leads[2].setAttribute('d', `M${f(258 - 14)} ${f(186 - 24)} L226 ${f(TOP + HB + w(226, d) - 3)}`);
			// the magnifiers: spacing 9 × (1 ∓ 0,15 L)
			const place = (arr: { c: SVGCircleElement; i: number; j: number }[], k: number) => {
				for (const a of arr) {
					a.c.setAttribute('cx', f((a.i - 2) * 9 * k));
					a.c.setAttribute('cy', f((a.j - 1) * 9 + 3));
				}
			};
			place(at0, 1 - 0.15 * L);
			place(at1, 1);
			place(at2, 1 + 0.15 * L);
			const op = L > 0.05 ? '1' : '0';
			ar0[0].setAttribute('d', arrow(-21, -14, -9, -14));
			ar0[1].setAttribute('d', arrow(21, -14, 9, -14));
			ar2[0].setAttribute('d', arrow(-8, -14, -20, -14));
			ar2[1].setAttribute('d', arrow(8, -14, 20, -14));
			for (const p of [...ar0, ...ar2]) p.style.opacity = op;
			// ---- twisting
			const phiAt = (X: number) => (PHI * L * (X - X0)) / LR;
			let g = '';
			for (const th of [-1.2, -0.6, 0, 0.6, 1.2, 1.8, -1.8, 2.4, -2.4, Math.PI]) {
				let on = false;
				for (let X = X0; X <= XE + 0.01; X += 2) {
					const p = surf(X, th + phiAt(X));
					if (p.vis) {
						g += `${on ? 'L' : 'M'}${f(p.x)} ${f(p.y)} `;
						on = true;
					} else on = false;
				}
			}
			gens.setAttribute('d', g);
			// the square: its four edges sampled
			const edge: { x: number; y: number }[] = [];
			const N = 8;
			for (let k = 0; k <= N; k++) edge.push(surf(SQ.x0 + ((SQ.x1 - SQ.x0) * k) / N, SQ.th0 + phiAt(SQ.x0 + ((SQ.x1 - SQ.x0) * k) / N)));
			for (let k = 0; k <= N; k++) edge.push(surf(SQ.x1, SQ.th0 + ((SQ.th1 - SQ.th0) * k) / N + phiAt(SQ.x1)));
			for (let k = N; k >= 0; k--) edge.push(surf(SQ.x0 + ((SQ.x1 - SQ.x0) * k) / N, SQ.th1 + phiAt(SQ.x0 + ((SQ.x1 - SQ.x0) * k) / N)));
			for (let k = N; k >= 0; k--) edge.push(surf(SQ.x0, SQ.th0 + ((SQ.th1 - SQ.th0) * k) / N + phiAt(SQ.x0)));
			square.setAttribute('d', 'M' + edge.map((p) => `${f(p.x)} ${f(p.y)}`).join(' L') + ' Z');
			const sqc = surf((SQ.x0 + SQ.x1) / 2, phiAt((SQ.x0 + SQ.x1) / 2));
			leads[3].setAttribute('d', `M${f(150)} ${f(198 - 30)} L${f(sqc.x)} ${f(sqc.y + 9)}`);
			// the wheel on the end turns with it by Φ·L; the pair of forces acts on its rim at its nearest and farthest
			// points (the wheel turns under them, as a steering wheel turned hand over hand): tangent there, so vertical
			const pe = PHI * L;
			const WX = 204;
			const RW = 40;
			let sp = '';
			for (let k = 0; k < 3; k++) {
				const a = pe + (k * 2 * Math.PI) / 3;
				sp += `M${WX} ${CY} L${f(WX + K * RW * Math.cos(a))} ${f(CY + RW * Math.sin(a))} `;
			}
			spokes.setAttribute('d', sp);
			const FL = 40;
			const setF = (l: Element, h: Element, x: number, dir: number, lab: SVGGElement, lx: number, ly: number) => {
				l.setAttribute('x1', String(x));
				l.setAttribute('y1', String(CY));
				l.setAttribute('x2', String(x));
				l.setAttribute('y2', f(CY + dir * (FL - 8)));
				h.setAttribute('d', arrowHead(x, CY + dir * FL, 0, dir));
				lab.setAttribute('transform', `translate(${lx} ${ly})`);
			};
			setF(f1l, f1h, WX + K * RW, 1, f1t, WX + K * RW + 8, CY + 38);
			setF(f2l, f2h, WX - K * RW, -1, f2t, WX - K * RW + 8, CY - 44);
			ft.style.opacity = L > 0.02 ? '1' : '0';
			// the shear magnifier: 4 rows of 5, each row shifted by tan γ · 10 px more than the one below
			const sh = Math.tan(GAM * L) * 9;
			for (const a of at3) {
				a.c.setAttribute('cx', f((a.i - 2) * 9 + (1.5 - a.j) * sh));
				a.c.setAttribute('cy', f((a.j - 1.5) * 9));
			}
			ar3[0].setAttribute('d', arrow(-10, -23, 8, -23));
			ar3[1].setAttribute('d', arrow(10, 23, -8, 23));
			for (const p of ar3) p.style.opacity = op;
		};
		let t = 0;
		(root as HTMLElement & { ttDraw?: (t: number) => void }).ttDraw = (tt: number) => draw((t = tt));
		loop(root, (dt) => {
			if (root.hasAttribute('data-tt-freeze')) return false;
			t = (t + dt) % 5.2;
			draw(t);
			return true;
		});
		draw(0);
	}
</script>
