---
/**
 * Picture to the definitions of a single crystal and a polycrystal. Left: single crystals keep a regular shape with
 * flat faces — a quartz crystal (a six-sided prism with a pointed top) and a cube of rock salt. Right: a piece of
 * metal is made of many small grains (in steel typically 0,01–0,1 мм); the round field is a scheme of what a
 * microscope would show if it could resolve atoms (no microscope shows rows of atoms this way): each grain is a crystal of
 * its own, and the rows of atoms in neighbouring grains point in different directions (drawn as dot lattices turned
 * by 0°, 25°, 50° and 70°). Schematic, not to scale.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const grains = [
	{ d: 'M250 40 L292 32 L300 78 L262 92 L238 70 Z', a: 0 },
	{ d: 'M292 32 L340 40 L350 86 L300 78 Z', a: 25 },
	{ d: 'M238 70 L262 92 L256 140 L214 128 L206 82 Z', a: 50 },
	{ d: 'M262 92 L300 78 L350 86 L346 132 L300 150 L256 140 Z', a: 70 },
	{ d: 'M206 82 L238 70 L250 40 L214 30 L196 48 Z', a: 35 },
	{ d: 'M214 128 L256 140 L300 150 L346 132 L352 172 L200 172 Z', a: 12 },
	{ d: 'M250 40 L292 32 L340 40 L340 20 L214 20 L214 30 Z', a: 60 },
];
---

<G7Styles />
<figure class="g7 g7--pic mp not-content" data-monopoly>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 194" role="img" aria-label="Слева монокристаллы: кристалл кварца и кубик соли с ровными гранями. Справа схема металла под микроскопом: он состоит из мелких кристалликов, ряды атомов в которых повёрнуты в разные стороны">
			<defs>
				{grains.map((g, i) => (
					<pattern id={`mp-${uid}-${i}`} width="9" height="9" patternUnits="userSpaceOnUse" patternTransform={`rotate(${g.a})`}>
						<circle class="mp-atom" cx="4.5" cy="4.5" r="2.4" />
					</pattern>
				))}
				<clipPath id={`mp-c-${uid}`}><circle cx="276" cy="90" r="58"></circle></clipPath>
			</defs>
			<text class="t-title" x="84" y="20" text-anchor="middle">монокристаллы</text>
			<!-- quartz: a hexagonal prism with a pyramid -->
			<g transform="translate(52 160)">
				<path class="mp-q1" d="M-22 0 L-22 -70 L-8 -78 L-8 -6 Z"></path>
				<path class="mp-q2" d="M-8 -6 L-8 -78 L12 -78 L12 -6 Z"></path>
				<path class="mp-q3" d="M12 -6 L12 -78 L24 -70 L24 0 Z"></path>
				<path class="mp-q2" d="M-8 -78 L2 -112 L12 -78 Z"></path>
				<path class="mp-q1" d="M-22 -70 L2 -112 L-8 -78 Z"></path>
				<path class="mp-q3" d="M12 -78 L2 -112 L24 -70 Z"></path>
				<path class="mp-edge" d="M-22 0 V-70 L2 -112 L24 -70 V0 M-8 -6 V-78 L2 -112 M12 -6 V-78 L2 -112 M-8 -78 H12 M-22 -70 L-8 -78 M12 -78 L24 -70 M-22 0 L-8 -6 H12 L24 0"></path>
			</g>
			<text x="54" y="178" text-anchor="middle">кварц</text>
			<g transform="translate(124 132)">
				<path class="mp-s1" d="M-24 -14 L0 -27 L24 -14 L0 -1 Z"></path>
				<path class="mp-s2" d="M-24 -14 L0 -1 L0 28 L-24 15 Z"></path>
				<path class="mp-s3" d="M24 -14 L0 -1 L0 28 L24 15 Z"></path>
				<path class="mp-edge" d="M-24 -14 L0 -27 L24 -14 L0 -1 Z M0 -1 V28 M-24 -14 V15 L0 28 L24 15 V-14"></path>
			</g>
			<text x="124" y="178" text-anchor="middle">соль</text>
			<line class="mp-sep" x1="176" y1="10" x2="176" y2="182"></line>
			<text class="t-title" x="276" y="20" text-anchor="middle">поликристалл</text>
			<g clip-path={`url(#mp-c-${uid})`}>
				<rect class="mp-metal" x="210" y="24" width="140" height="140"></rect>
				{grains.map((g, i) => <path d={g.d} fill={`url(#mp-${uid}-${i})`} />)}
				{grains.map((g) => <path class="mp-bound" d={g.d} />)}
			</g>
			<circle class="mp-ring" cx="276" cy="90" r="58"></circle>
			<text x="276" y="168" text-anchor="middle">металл под микроскопом</text>
			<text x="276" y="184" text-anchor="middle">(схема)</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Монокристаллы — кварц и соль — сохраняют правильную форму с ровными гранями. Металл состоит из множества мелких кристалликов, сросшихся друг с другом; ряды атомов в них повёрнуты в разные стороны (схема).
	</figcaption>
</figure>

<style is:global>
	.mp-q1 {
		fill: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-3));
	}
	.mp-q2 {
		fill: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-gray-2));
	}
	.mp-q3 {
		fill: color-mix(in oklab, var(--ig-vx) 22%, var(--sl-color-gray-4));
	}
	.mp-s1 {
		fill: color-mix(in oklab, var(--sl-color-white) 70%, var(--ig-vx));
	}
	.mp-s2 {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 80%, var(--ig-vx));
	}
	.mp-s3 {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--ig-vx));
	}
	.mp-edge {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mp-sep {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.mp-metal {
		fill: var(--g7-steel);
	}
	.mp-atom {
		fill: var(--g7-steel-dark);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
	}
	.mp-bound {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.mp-ring {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
</style>
