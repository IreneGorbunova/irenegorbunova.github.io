---
/**
 * Picture to «Диаграмма растяжения»: the school stress–strain diagram of low-carbon steel, not to scale in ε (the
 * straight part is widened many times: really it ends at ε ≈ 0,1 %, the break comes at about 25–30 %; the caption says
 * so). O → A straight (Hooke's law, up to σп, the limit of proportionality), A → B slightly curved up to σуп (just above A), the yield plateau C → D
 * («текучесть»: the strain grows, the stress does not), D → E hardening up to the top E (σпч), E → K the stress falls
 * as a neck forms, K the break. The area under the curve up to B is shaded as the elastic zone, beyond it as the
 * plastic zone (legend under the picture).
 * A dot runs along the curve in 8 с. After it has passed the plateau, the load is taken off at P: the dot comes down
 * along a straight line parallel to OA to the ε axis at εост (the residual deformation), waits, goes back up the same
 * line and continues to the break. A mini wire beside the graph lengthens with the dot (its length follows the dot's
 * ε on the same widened scale), shortens a little when unloaded, narrows in a neck after E and breaks at K.
 */
import G7Styles from '../g7/G7Styles.astro';
import TtStyles from './TtStyles.astro';

const O = { x: 50, y: 220 };
const A = { x: 80, y: 110 };
const B = { x: 86, y: 101 };
const C = { x: 94, y: 98 };
const D = { x: 140, y: 98 };
const E = { x: 230, y: 40 };
const K = { x: 275, y: 70 };
const f = (v: number) => v.toFixed(1);
// the curve as a dense polyline of (x, y)
const curve: { x: number; y: number }[] = [];
for (let i = 0; i <= 12; i++) curve.push({ x: O.x + ((A.x - O.x) * i) / 12, y: O.y + ((A.y - O.y) * i) / 12 });
for (let i = 1; i <= 6; i++) {
	const u = i / 6;
	curve.push({ x: A.x + (B.x - A.x) * u, y: A.y + (B.y - A.y) * (2 * u - u * u) });
}
for (let i = 1; i <= 4; i++) curve.push({ x: B.x + ((C.x - B.x) * i) / 4, y: B.y + ((C.y - B.y) * i) / 4 });
for (let i = 1; i <= 10; i++) curve.push({ x: C.x + ((D.x - C.x) * i) / 10, y: C.y });
for (let i = 1; i <= 30; i++) {
	const u = i / 30;
	curve.push({ x: D.x + (E.x - D.x) * u, y: D.y - (D.y - E.y) * (1 - (1 - u) ** 2) });
}
for (let i = 1; i <= 15; i++) {
	const u = i / 15;
	curve.push({ x: E.x + (K.x - E.x) * u, y: E.y + (K.y - E.y) * u ** 1.6 });
}
const line = 'M' + curve.map((p) => `${f(p.x)} ${f(p.y)}`).join(' L');
const iB = curve.findIndex((p) => p.x >= B.x);
const elastic = 'M' + curve.slice(0, iB + 1).map((p) => `${f(p.x)} ${f(p.y)}`).join(' L') + ` L${B.x} ${O.y} Z`;
const plastic = 'M' + curve.slice(iB).map((p) => `${f(p.x)} ${f(p.y)}`).join(' L') + ` L${K.x} ${O.y} L${B.x} ${O.y} Z`;
---

<G7Styles />
<TtStyles />
<figure class="g7 g7--pic dg not-content" data-ttdiag data-curve={JSON.stringify(curve)}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Диаграмма растяжения мягкой стали: прямой участок до предела пропорциональности, предел упругости, площадка текучести, упрочнение до предела прочности, шейка и разрыв. Точка бежит по кривой; после снятия нагрузки она опускается по прямой, параллельной начальному участку, и остаётся остаточная деформация">
			<path class="dg-el" d={elastic}></path>
			<path class="dg-pl" d={plastic}></path>
			<path class="dg-axis" d={`M${O.x} 10 V${O.y} H300`}></path>
			<path class="dg-axis" d="M46 18 L50 10 L54 18 M292 216 L300 220 L292 224"></path>
			<text class="t-i" x="60" y="20">σ</text>
			<text class="t-i" x="296" y="210" text-anchor="end">ε</text>
			<text class="t-i" x="44" y="236" text-anchor="end">O</text>
			<path class="dg-curve" d={line}></path>
			<path class="dg-unload" data-unload d=""></path>
			<path class="dg-break" d={`M${K.x - 4} ${K.y - 8} L${K.x + 4} ${K.y - 2} L${K.x - 3} ${K.y + 2} L${K.x + 5} ${K.y + 8}`}></path>
			<circle class="dg-mark" cx={A.x} cy={A.y} r="2.6"></circle>
			<circle class="dg-mark" cx={B.x} cy={B.y} r="2.6"></circle>
			<circle class="dg-mark" cx={E.x} cy={E.y} r="2.6"></circle>
			<text class="t-i" x={A.x - 10} y={A.y + 8} text-anchor="end">σ<tspan class="t-small" font-style="normal" dy="3">п</tspan></text>
			<text class="t-i" x={B.x - 12} y={B.y - 8} text-anchor="end">σ<tspan class="t-small" font-style="normal" dy="3">уп</tspan></text>
			<text class="t-i" x={E.x} y={E.y - 12} text-anchor="middle">σ<tspan class="t-small" font-style="normal" dy="3">пч</tspan></text>
			<text class="t-small" x="117" y="84" text-anchor="middle">текучесть</text>
			<text class="t-small" x={K.x + 6} y={K.y + 24} text-anchor="middle">разрыв</text>
			<g data-res opacity="0">
				<path class="dg-res" data-resbar d=""></path>
				<text class="t-i" data-rest x="0" y="240" text-anchor="middle">ε<tspan class="t-small" font-style="normal" dy="3">ост</tspan></text>
			</g>
			<circle class="dg-dot" data-dot r="4.5" cx={O.x} cy={O.y}></circle>
			<!-- the mini wire -->
			<rect class="dg-grip" x="314" y="14" width="26" height="12" rx="2"></rect>
			<path class="dg-wire" data-w1 d=""></path>
			<path class="dg-wire" data-w2 d=""></path>
			<rect class="dg-grip" data-lowgrip x="314" y="0" width="26" height="12" rx="2"></rect>
		</svg>
	</div>
	<div class="dg__legend">
		<span><i class="dg-key dg-key--el"></i>упругая деформация</span>
		<span><i class="dg-key dg-key--pl"></i>пластическая деформация</span>
		<span class="dg__plain"><i>ε</i><sub>ост</sub> — остаточная деформация</span>
	</div>
	<figcaption class="g7__caption">Диаграмма растяжения мягкой стали. После снятия нагрузки точка опускается по прямой, параллельной начальному участку, и остаётся остаточная деформация. Рядом — образец: удлиняется, образует шейку и рвётся. Не в масштабе: прямой участок на самом деле кончается при <i>ε</i> ≈ 0,1&nbsp;%, а разрыв наступает при 25–30&nbsp;%.</figcaption>
</figure>

<style is:global>
	.dg__legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 1rem;
		margin: 0.5rem 0.25rem 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.dg__legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.dg__legend .dg__plain {
		display: inline;
	}
	.dg__legend i {
		font-family: var(--ig-font-math);
	}
	.dg-key {
		display: inline-block;
		width: 0.9rem;
		height: 0.7rem;
		border-radius: 0.2rem;
	}
	.dg-key--el,
	.dg-el {
		background: color-mix(in oklab, var(--tt-comp) 35%, transparent);
		fill: color-mix(in oklab, var(--tt-comp) 35%, transparent);
	}
	.dg-key--pl,
	.dg-pl {
		background: color-mix(in oklab, var(--tt-tens) 22%, transparent);
		fill: color-mix(in oklab, var(--tt-tens) 22%, transparent);
	}
	.dg-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.dg-curve {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.dg-unload,
	.dg-res {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.dg-res {
		stroke: var(--g7-gold);
		stroke-width: 2.4;
		stroke-dasharray: none;
	}
	.dg-break {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.dg-mark {
		fill: var(--sl-color-white);
	}
	.dg-dot {
		fill: var(--g7-blue);
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
	}
	.dg-grip {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.dg-wire {
		fill: var(--tt-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-ttdiag]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const curve: { x: number; y: number }[] = JSON.parse(root.dataset.curve!);
		const O = { x: 50, y: 220 };
		const SLOPE = (220 - 110) / (80 - 50); // of OA, px of σ per px of ε
		const XP = 180; // the load is taken off here
		const XE = 230;
		const XK = 275;
		const at = (x: number) => {
			for (let i = 1; i < curve.length; i++)
				if (curve[i].x >= x) {
					const a = curve[i - 1];
					const b = curve[i];
					const u = (x - a.x) / (b.x - a.x || 1);
					return a.y + (b.y - a.y) * u;
				}
			return curve[curve.length - 1].y;
		};
		const yP = at(XP);
		const XF = XP - (O.y - yP) / SLOPE; // the foot of the unloading line: ε_ост
		const dot = $('[data-dot]');
		const unload = $('[data-unload]');
		const res = $<SVGGElement>('[data-res]');
		const w1 = $('[data-w1]');
		const w2 = $('[data-w2]');
		const low = $('[data-lowgrip]');
		$('[data-resbar]').setAttribute('d', `M${O.x} ${O.y} H${f(XF)}`);
		$('[data-rest]').setAttribute('x', f((O.x + XF) / 2));
		// timeline (s): 0–3,4 O → P; 3,4–4,2 down to the foot; 4,2–4,8 wait; 4,8–5,6 up to P; 5,6–7,0 P → K; 7–8 broken
		const RUN = 8;
		const draw = (t: number) => {
			let x: number;
			let y: number;
			let shown = false;
			if (t < 3.4) {
				x = O.x + (XP - O.x) * ease(t / 3.4) ** 0.9;
				y = at(x);
			} else if (t < 5.6) {
				const k = t < 4.2 ? ease((t - 3.4) / 0.8) : t < 4.8 ? 1 : 1 - ease((t - 4.8) / 0.8);
				x = XP - (XP - XF) * k;
				y = yP + (O.y - yP) * k;
				shown = true;
			} else {
				x = XP + (XK - XP) * Math.min(1, (t - 5.6) / 1.4);
				y = at(x);
				shown = true;
			}
			dot.setAttribute('cx', f(x));
			dot.setAttribute('cy', f(y));
			unload.setAttribute('d', shown ? `M${f(XP)} ${f(yP)} L${f(XF)} ${O.y}` : '');
			res.setAttribute('opacity', t >= 4 ? '1' : '0');
			// the mini wire: grips at y = 26 and below; length 100 + 0,35·(x − 50) px, a neck after E, broken at K
			const len = 100 + 0.35 * (x - O.x);
			const yb = 26 + len;
			low.setAttribute('y', f(yb));
			const broken = t >= 7;
			const neck = x > XE ? Math.min(1, (x - XE) / (XK - XE)) : 0;
			const half = 4;
			const ym = 26 + len / 2;
			const shape = (ya: number, yb2: number) => {
				let d = '';
				let back = '';
				for (let k = 0; k <= 20; k++) {
					const yy = ya + ((yb2 - ya) * k) / 20;
					const g = Math.exp(-(((yy - ym) / 10) ** 2));
					const w = half * (1 - 0.06 * Math.min(1, (x - O.x) / 180)) * (1 - 0.75 * neck * g);
					d += `${k ? 'L' : 'M'}${f(327 - w)} ${f(yy)} `;
					back = `L${f(327 + w)} ${f(yy)} ` + back;
				}
				return d + back + 'Z';
			};
			if (broken) {
				w1.setAttribute('d', shape(26, ym - 3));
				w2.setAttribute('d', shape(ym + 3, yb));
			} else {
				w1.setAttribute('d', shape(26, yb));
				w2.setAttribute('d', '');
			}
			dot.style.opacity = broken && t > 7.2 ? '0' : '1';
		};
		let t = 0;
		(root as HTMLElement & { ttDraw?: (t: number) => void }).ttDraw = (tt: number) => draw((t = tt));
		loop(root, (dt) => {
			if (root.hasAttribute('data-tt-freeze')) return false;
			t = (t + dt) % RUN;
			draw(t);
			return true;
		});
		draw(0);
	}
</script>
