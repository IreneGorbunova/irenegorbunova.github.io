---
/**
 * Scheme to «Механическое напряжение» (not to scale; the elongation is exaggerated). Two wires of the same steel and the
 * same initial length l₀ hang from a beam. The first, of diameter d, holds a load m and is stretched by the force F⃗;
 * the second, of diameter 2d, holds a load 4m (force 4F⃗). Its cross-section is 4 times larger, so 4 times more bonds
 * between the particles share the load: both wires have the same stress σ = F/S and stretch by the same Δl.
 * The cross-sections are drawn as discs with the rows of atoms (along the wire) that hold the load: a triangular
 * packing of one spacing, the disc radius 1,82 spacings for the thin wire and 3,64 for the thick one, which holds
 * exactly 12 and 48 atoms (the packing centered on the middle of a triangle of atoms). The dashed line shows the first
 * wire before the load (length l₀); the brackets show l₀, l and Δl. Forces are red, as everywhere in this chapter;
 * the force arrows are drawn 24 px per F (the second is 4 times longer) and start at the lower end of each wire, where
 * the load pulls it (review, 28 Nov 2026); they are drawn over the loads, whose letters stand beside them.
 */
import G7Styles from '../g7/G7Styles.astro';
import TtStyles from './TtStyles.astro';
import Vec from './Vec.astro';

const r3 = Math.sqrt(3);
const disc = (R: number, a: number) => {
	const out: { x: number; y: number }[] = [];
	for (let i = -12; i <= 12; i++)
		for (let j = -12; j <= 12; j++) {
			const x = i + 0.5 * j + 0.5;
			const y = (j * r3) / 2 + r3 / 6;
			if (x * x + y * y <= R * R + 1e-9) out.push({ x: x * a, y: y * a });
		}
	return out;
};
const A = 9.4; // px per spacing of the atoms in the cross-sections
const R1 = 1.82 * A + 3.6; // the disc around 12 atoms
const R2 = 3.64 * A + 3.6;
const small = disc(1.82, A);
const big = disc(3.64, A);
const CA = { x: 168, y: 64 };
const CB = { x: 314, y: 70 };
---

<G7Styles />
<TtStyles />
<figure class="g7 g7--pic sp not-content">
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 244" role="img" aria-label="Две проволоки из одной стали и одной длины. Тонкая держит груз m, вдвое более толстая держит груз 4m и удлиняется так же. Сечение толстой в 4 раза больше: в нём 48 рядов атомов против 12">
			<rect class="sp-beam" x="20" y="14" width="240" height="12"></rect>
			<path class="sp-hatch" d={Array.from({ length: 24 }, (_, k) => `M${22 + k * 10} 14 l8 -8`).join(' ')}></path>
			<!-- the thin wire: before the load (dashed) and with the load m -->
			<line class="sp-wire-ghost" x1="58" y1="26" x2="58" y2="130"></line>
			<line class="sp-wire" x1="96" y1="26" x2="96" y2="150"></line>
			<rect class="sp-load" x="82" y="150" width="28" height="22" rx="3"></rect>
			<text class="t-i t-strong" x="114" y="166">m</text>
			<line class="sp-force" x1="96" y1="150" x2="96" y2="164"></line>
			<path class="sp-force-head" d="M90.5 163 L96 174 L101.5 163 Z"></path>
			<Vec x={104} y={188} t="F" cls="t-red" />
			<!-- dimensions of the thin wire -->
			<path class="sp-dim" d="M40 26 V130 M36 26 h8 M36 130 h8"></path>
			<text class="t-i" x="30" y="84" text-anchor="end">l<tspan font-size="10" dy="3">0</tspan></text>
			<path class="sp-guide" d="M58 130 H84"></path>
			<path class="sp-dim sp-dim--key" d="M78 130 V150 M74 130 h8 M74 150 h8"></path>
			<text class="t-i t-gold" x="70" y="146" text-anchor="end">Δl</text>
			<path class="sp-dim" d="M124 26 V150 M120 26 h8 M120 150 h8"></path>
			<text class="t-i" x="132" y="112">l</text>
			<!-- the thick wire with the load 4m: the same length l -->
			<line class="sp-wire sp-wire--thick" x1="226" y1="26" x2="226" y2="150"></line>
			<rect class="sp-load" x="200" y="150" width="52" height="40" rx="4"></rect>
			<text class="t-i t-strong" x="256" y="175">4m</text>
			<line class="sp-force" x1="226" y1="150" x2="226" y2="220"></line>
			<path class="sp-force-head" d="M220.5 219 L226 230 L231.5 219 Z"></path>
			<Vec x={234} y={222} t="F" pre="4" cls="t-red" />
			<!-- the cross-sections -->
			<path class="sp-guide" d={`M98 ${CA.y} H${(CA.x - R1 - 2).toFixed(1)}`}></path>
			<circle class="sp-cut" cx={CA.x} cy={CA.y} r={R1.toFixed(1)}></circle>
			{small.map((p) => <circle class="sp-atom" cx={(CA.x + p.x).toFixed(1)} cy={(CA.y + p.y).toFixed(1)} r="3.3"></circle>)}
			<text class="t-i t-strong" x={CA.x} y={(CA.y + R1 + 18).toFixed(1)} text-anchor="middle">S</text>
			<path class="sp-guide" d={`M229 ${CB.y} H${(CB.x - R2 - 2).toFixed(1)}`}></path>
			<circle class="sp-cut" cx={CB.x} cy={CB.y} r={R2.toFixed(1)}></circle>
			{big.map((p) => <circle class="sp-atom" cx={(CB.x + p.x).toFixed(1)} cy={(CB.y + p.y).toFixed(1)} r="3.3"></circle>)}
			<text class="t-i t-strong" x={CB.x} y={(CB.y + R2 + 18).toFixed(1)} text-anchor="middle">4S</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Вдвое толще — вчетверо больше площадь сечения: вчетверо больше связей между частицами держат вчетверо больший груз, и напряжение то же. Точки в сечениях — ряды атомов вдоль проволоки: 12 в тонкой и 48 в толстой. Пунктир — тонкая проволока до нагрузки; обе проволоки удлинились на одно и то же Δ<i>l</i>. Не в масштабе, удлинение преувеличено.</figcaption>
</figure>

<style is:global>
	.sp-beam {
		fill: var(--sl-color-gray-4);
	}
	.sp-hatch {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.sp-wire {
		stroke: var(--tt-steel);
		stroke-width: 3;
	}
	.sp-wire--thick {
		stroke-width: 6;
	}
	.sp-wire-ghost {
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-dasharray: 4 3;
	}
	.sp-load {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.sp-force {
		stroke: var(--g7-red);
		stroke-width: 3;
	}
	.sp-force-head {
		fill: var(--g7-red);
	}
	.sp-dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.sp-dim--key {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.sp-guide {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.sp-cut {
		fill: color-mix(in oklab, var(--tt-steel) 35%, var(--g7-paper));
		stroke: var(--tt-steel);
		stroke-width: 2;
	}
	.sp-atom {
		fill: var(--tt-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
</style>
