---
/**
 * Scheme to «Механическое напряжение» (not to scale; the elongation is exaggerated). A wire of initial length l₀
 * hangs from a beam; a load stretches it with a force F, and its length becomes l = l₀ + Δl. On the right, the cut
 * across the wire: the area S of its cross-section. The force F is red, as everywhere in this chapter.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow sp not-content">
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 236" role="img" aria-label="Проволока начальной длины l0 под действием груза удлинилась на дельта l и стала длиной l. Справа поперечное сечение проволоки площадью S">
			<rect class="sp-beam" x="40" y="14" width="120" height="12"></rect>
			<path class="sp-hatch" d={Array.from({ length: 12 }, (_, k) => `M${42 + k * 10} 14 l8 -8`).join(' ')}></path>
			<!-- before: the wire alone (dashed outline), after: with the load -->
			<line class="sp-wire-ghost" x1="74" y1="26" x2="74" y2="140"></line>
			<line class="sp-wire" x1="126" y1="26" x2="126" y2="166"></line>
			<rect class="sp-load" x="108" y="166" width="36" height="30" rx="3"></rect>
			<line class="sp-force" x1="126" y1="200" x2="126" y2="222"></line>
			<path class="sp-force-head" d="M120 220 L126 232 L132 220 Z"></path>
			<text class="t-i t-red" x="138" y="226">F</text>
			<!-- dimensions -->
			<path class="sp-dim" d="M52 26 V140 M48 26 h8 M48 140 h8"></path>
			<text class="t-i" x="34" y="88">l<tspan font-size="10" dy="3">0</tspan></text>
			<path class="sp-dim" d="M196 26 V166 M192 26 h8 M192 166 h8"></path>
			<text class="t-i" x="204" y="100">l</text>
			<path class="sp-dim sp-dim--key" d="M156 140 V166 M152 140 h8 M152 166 h8"></path>
			<path class="sp-guide" d="M74 140 H160"></path>
			<text class="t-i t-gold" x="164" y="158">Δl</text>
			<text class="t-small" x="74" y="156" text-anchor="middle">до</text>
			<text class="t-small" x="96" y="214" text-anchor="end">после</text>
			<!-- the cross-section -->
			<path class="sp-guide" d="M128 70 L246 70"></path>
			<ellipse class="sp-cut" cx="272" cy="70" rx="26" ry="26"></ellipse>
			<text class="t-i t-strong" x="272" y="76" text-anchor="middle">S</text>
			<text class="t-small" x="272" y="114" text-anchor="middle">поперечное</text>
			<text class="t-small" x="272" y="128" text-anchor="middle">сечение</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Проволока начальной длины <i>l</i><sub>0</sub> под действием силы <i>F</i> удлинилась на Δ<i>l</i>. Справа — её поперечное сечение площадью <i>S</i> (удлинение преувеличено).</figcaption>
</figure>

<style is:global>
	.sp-beam {
		fill: var(--sl-color-gray-4);
	}
	.sp-hatch {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.sp-wire,
	.sp-wire-ghost {
		stroke: var(--g7-steel-dark);
		stroke-width: 3;
	}
	.sp-wire {
		stroke: var(--sl-color-gray-2);
	}
	.sp-wire-ghost {
		stroke-dasharray: 4 3;
		opacity: 0.8;
	}
	.sp-load {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.sp-force {
		stroke: var(--g7-red);
		stroke-width: 3;
	}
	.sp-force-head {
		fill: var(--g7-red);
	}
	.sp-dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.sp-dim--key {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.sp-guide {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.sp-cut {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--g7-steel));
		stroke: var(--g7-blue);
		stroke-width: 2;
	}
</style>
