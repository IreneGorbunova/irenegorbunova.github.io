---
/**
 * Picture to the definition of crystalline bodies: a grain of table salt (a cube about 0,5 мм across) and, enlarged,
 * one face of its lattice: sodium and chlorine ions alternate in rows; the distance between neighbouring ions is
 * 0,28 нм (0,282 нм in NaCl), 26 px here. The ions are drawn in proportion to their radii (Na⁺ 0,102 нм, Cl⁻ 0,181 нм)
 * and tremble about their places: amplitude 1,6 px (about 6 % of the spacing, of the order of real thermal vibrations
 * at room temperature), the motion slowed down billions of times. The thin gray grid joins the places they tremble
 * about — the lattice.
 */
import G7Styles from '../g7/G7Styles.astro';

const A = 26; // px per 0,282 нм
const N = 7;
const X0 = 186;
const Y0 = 30;
const nodes = Array.from({ length: N * N }, (_, i) => ({ i: i % N, j: Math.floor(i / N) }));
const R = (rIon: number) => (rIon / 0.282) * A * 0.62; // drawn a little smaller than touching, to see the lattice
---

<G7Styles />
<figure class="g7 g7--pic lat not-content" data-lattice>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 244" role="img" aria-label="Крупинка поваренной соли — кубик. При огромном увеличении видно: ионы натрия и хлора чередуются в строгом порядке и дрожат около своих мест">
			<!-- the grain -->
			<g transform="translate(70 104)">
				<path class="lat-cube-top" d="M-34 -22 L0 -40 L34 -22 L0 -4 Z"></path>
				<path class="lat-cube-l" d="M-34 -22 L0 -4 L0 40 L-34 22 Z"></path>
				<path class="lat-cube-r" d="M34 -22 L0 -4 L0 40 L34 22 Z"></path>
				<path class="lat-cube-edge" d="M-34 -22 L0 -40 L34 -22 L0 -4 Z M0 -4 V40 M-34 -22 V22 L0 40 L34 22 V-22"></path>
			</g>
			<text x="70" y="168" text-anchor="middle">крупинка соли</text>
			<text class="t-small" x="70" y="183" text-anchor="middle">около 0,5&nbsp;мм</text>
			<path class="lat-zoom" d={`M86 70 L${X0 - 12} ${Y0 - 6} M86 120 L${X0 - 12} ${Y0 + (N - 1) * A + 12}`}></path>
			<rect class="lat-frame" x={X0 - 14} y={Y0 - 14} width={(N - 1) * A + 28} height={(N - 1) * A + 28} rx="6"></rect>
			<path class="lat-grid" d={Array.from({ length: N }, (_, k) => `M${X0} ${Y0 + k * A} H${X0 + (N - 1) * A} M${X0 + k * A} ${Y0} V${Y0 + (N - 1) * A}`).join(' ')}></path>
			<g data-ions>
				{nodes.map((n) => {
					const cl = (n.i + n.j) % 2 === 0;
					return <circle class={cl ? 'lat-cl' : 'lat-na'} cx={X0 + n.i * A} cy={Y0 + n.j * A} r={R(cl ? 0.181 : 0.102)} data-x={X0 + n.i * A} data-y={Y0 + n.j * A} />;
				})}
			</g>
			<path class="lat-bar" d={`M${X0} ${Y0 + (N - 1) * A + 24} h${A} M${X0} ${Y0 + (N - 1) * A + 20} v8 M${X0 + A} ${Y0 + (N - 1) * A + 20} v8`}></path>
			<text class="t-small" x={X0 + A + 6} y={Y0 + (N - 1) * A + 28}>0,28&nbsp;нм</text>
			<circle class="lat-na" cx="272" cy="214" r="4"></circle>
			<text class="t-small" x="280" y="217.5">натрий</text>
			<circle class="lat-cl" cx="272" cy="232" r="6.5"></circle>
			<text class="t-small" x="282" y="235.5">хлор</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Крупинка поваренной соли — кубик. Её ионы натрия и хлора чередуются в строгом порядке и дрожат около своих мест (движение замедлено в миллиарды раз). Серая сетка соединяет эти места — это кристаллическая решётка.
	</figcaption>
</figure>

<style is:global>
	.lat-cube-top {
		fill: color-mix(in oklab, var(--sl-color-white) 70%, var(--ig-vx));
	}
	.lat-cube-l {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 80%, var(--ig-vx));
	}
	.lat-cube-r {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--ig-vx));
	}
	.lat-cube-edge {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.lat-zoom {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.lat-frame {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.lat-grid {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.8;
	}
	.lat-na {
		fill: var(--g7-violet);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.lat-cl {
		fill: var(--g7-green);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
		opacity: 0.92;
	}
	.lat-bar {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-lattice]')) {
		const ions = [...root.querySelectorAll<SVGCircleElement>('[data-ions] circle')].map((c, k) => ({
			c,
			x: +c.dataset.x!,
			y: +c.dataset.y!,
			// two frequencies and phases per ion, so the trembling looks irregular
			p: [k * 1.7, k * 2.3, k * 0.9, k * 3.1],
			w: [5.1 + (k % 5) * 0.4, 4.3 + (k % 3) * 0.5],
		}));
		let t = 0;
		loop(root, (dt) => {
			t += dt;
			for (const o of ions) {
				const dx = 1.1 * Math.sin(o.w[0] * t + o.p[0]) + 0.5 * Math.sin(o.w[1] * 1.7 * t + o.p[1]);
				const dy = 1.1 * Math.sin(o.w[1] * t + o.p[2]) + 0.5 * Math.sin(o.w[0] * 1.3 * t + o.p[3]);
				o.c.setAttribute('cx', (o.x + dx).toFixed(2));
				o.c.setAttribute('cy', (o.y + dy).toFixed(2));
			}
			return true;
		});
	}
</script>
