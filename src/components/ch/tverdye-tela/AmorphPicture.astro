---
/**
 * Picture to the definition of amorphous bodies (a scheme, not to scale).
 * Above: the same atoms joined the same way — silicon (dark) with oxygen (light) on every bond — in crystalline
 *   quartz and in quartz glass. In the crystal every ring is the same and the pattern repeats across the picture; in
 *   the glass each atom still has the same neighbours (short-range order), but the rings are skewed, and the pattern
 *   does not repeat (no long-range order). The glass is the crystal net bent by a smooth random field plus a jitter
 *   of 18 % of the bond (a 2-D sketch after W. Zachariasen, 1932).
 * Below: two bodies heated by equal heaters at a steady rate (a qualitative graph of temperature against time). The
 *   crystalline block stays hard until its melting temperature, then melts at that temperature (the flat part), and
 *   only when it has melted does the liquid heat further. The amorphous rod on two supports has no flat part: it
 *   sags more and more as it warms and at last flows. The loop lasts 9 s.
 */
import G7Styles from '../g7/G7Styles.astro';

const b = 15;
let seed = 5;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
type P = { x: number; y: number };
const net = (x0: number, y0: number, w: number, h: number) => {
	const pts: P[] = [];
	const s3 = Math.sqrt(3);
	for (let r = -1; r < h / (1.5 * b) + 1; r++)
		for (let c = -1; c < w / (s3 * b) + 1; c++) {
			const x = c * s3 * b + (r % 2 ? (s3 / 2) * b : 0);
			const y = r * 1.5 * b;
			pts.push({ x: x0 + x, y: y0 + y }, { x: x0 + x, y: y0 + y + b });
		}
	const bonds: [number, number][] = [];
	for (let i = 0; i < pts.length; i++)
		for (let j = i + 1; j < pts.length; j++) if (Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y) < b * 1.05) bonds.push([i, j]);
	return { pts, bonds };
};
const W = 156;
const Hh = 112;
const cryst = net(14, 30, W, Hh);
const glass0 = net(190, 30, W, Hh);
const glass = {
	bonds: glass0.bonds,
	pts: glass0.pts.map((p) => {
		const u = p.x - 190;
		const v = p.y - 30;
		return {
			x: p.x + 7 * Math.sin(u / 23 + 1.3) * Math.cos(v / 31) + (rnd() - 0.5) * 0.36 * b,
			y: p.y + 7 * Math.cos(u / 27) * Math.sin(v / 19 + 0.7) + (rnd() - 0.5) * 0.36 * b,
		};
	}),
};
const inBox = (p: P, x0: number) => p.x > x0 - 2 && p.x < x0 + W + 2 && p.y > 26 && p.y < 30 + Hh + 4;
const draw = (n: { pts: P[]; bonds: [number, number][] }, x0: number) => ({
	bonds: n.bonds.filter(([i, j]) => inBox(n.pts[i], x0) && inBox(n.pts[j], x0)).map(([i, j]) => ({ a: n.pts[i], c: n.pts[j] })),
	si: n.pts.filter((p) => inBox(p, x0)),
});
const C = draw(cryst, 14);
const G = draw(glass, 190);
const f = (v: number) => v.toFixed(1);
---

<G7Styles />
<figure class="g7 g7--pic am not-content" data-amorph>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 160" role="img" aria-label="Слева атомы кристаллического кварца: все кольца одинаковы, узор повторяется. Справа кварцевое стекло: те же атомы и те же связи, но кольца перекошены и узор не повторяется">
			<text class="t-title" x="92" y="18" text-anchor="middle">кристалл кварца</text>
			<text class="t-title" x="268" y="18" text-anchor="middle">кварцевое стекло</text>
			{[C, G].map((n) => (
				<g>
					{n.bonds.map((bd) => <line class="am-bond" x1={f(bd.a.x)} y1={f(bd.a.y)} x2={f(bd.c.x)} y2={f(bd.c.y)} />)}
					{n.bonds.map((bd) => <circle class="am-o" cx={f((bd.a.x + bd.c.x) / 2)} cy={f((bd.a.y + bd.c.y) / 2)} r="2.6" />)}
					{n.si.map((p) => <circle class="am-si" cx={f(p.x)} cy={f(p.y)} r="3.6" />)}
				</g>
			))}
			<line class="am-sep" x1="180" y1="6" x2="180" y2="156"></line>
		</svg>
		<svg class="g7__svg" viewBox="0 0 360 196" role="img" aria-label="Два тела нагревают одинаково. Кристаллическое остаётся твёрдым до температуры плавления и плавится при ней, на графике горизонтальный участок. Аморфное постепенно размягчается и прогибается, горизонтального участка нет">
			<text class="t-title" x="92" y="16" text-anchor="middle">кристаллическое тело</text>
			<text class="t-title" x="268" y="16" text-anchor="middle">аморфное тело</text>
			<!-- the bodies -->
			<rect class="am-stand" x="58" y="74" width="68" height="5" rx="1"></rect>
			<path class="am-puddle" data-puddle d=""></path>
			<rect class="am-body" data-block x="72" y="44" width="40" height="30" rx="1.5"></rect>
			<path class="am-stand" d="M226 56 h8 v24 h-8 Z M302 56 h8 v24 h-8 Z"></path>
			<path class="am-body" data-rod d=""></path>
			<!-- the graphs: x from 30 to 160 (and 206 to 336), temperature from 182 (cold) up -->
			{[24, 200].map((x0) => (
				<g>
					<path class="am-axis" d={`M${x0} 98 V182 H${x0 + 140}`} />
					<path class="am-axis" d={`M${x0 - 3} 102 L${x0} 96 L${x0 + 3} 102 M${x0 + 134} 179 L${x0 + 140} 182 L${x0 + 134} 185`} />
					<text class="t-i" x={x0 + 5} y="106">t</text>
					<text class="t-small" x={x0 + 11} y="106">, °C</text>
					<text class="t-small" x={x0 + 138} y="194" text-anchor="end">время</text>
				</g>
			))}
			<path class="am-curve am-curve--ghost" d="M24 172 L60 136 L118 136 L150 106"></path>
			<path class="am-curve am-curve--ghost" d="M200 172 C240 150 270 130 340 104"></path>
			<path class="am-curve" data-c1 d=""></path>
			<path class="am-curve" data-c2 d=""></path>
			<circle class="am-dot" data-d1 r="4"></circle>
			<circle class="am-dot" data-d2 r="4"></circle>
			<path class="am-melt" d="M24 136 H118"></path>
			<text class="t-small" x="66" y="131" text-anchor="middle">плавится</text>
			<text class="t-small" x="270" y="168" text-anchor="middle">размягчается</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Схема. Вверху: в стекле те же атомы и те же связи, что в кристалле, но правильный узор не повторяется. Внизу: два тела нагревают одинаково — кристаллическое плавится при определённой температуре, аморфное постепенно размягчается.
	</figcaption>
</figure>

<style is:global>
	.am-bond {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.am-si {
		fill: var(--g7-blue);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.am-o {
		fill: var(--g7-red);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
	}
	.am-sep {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.am-stand {
		fill: var(--g7-wood-dark);
	}
	.am-body {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.am-puddle {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.am-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.am-curve {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.6;
		stroke-linejoin: round;
	}
	.am-curve--ghost {
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
	}
	.am-dot {
		fill: var(--g7-red);
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	.am-melt {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	// the crystal's curve: heating 0…0,25, melting 0,25…0,7 (flat), the liquid 0,7…0,95; the rod's curve: a smooth rise
	const c1 = (s: number) => {
		if (s < 0.25) return { x: 24 + (36 * s) / 0.25, y: 172 - (36 * s) / 0.25, melt: 0 };
		if (s < 0.7) return { x: 60 + (58 * (s - 0.25)) / 0.45, y: 136, melt: (s - 0.25) / 0.45 };
		const k = Math.min(1, (s - 0.7) / 0.25);
		return { x: 118 + 32 * k, y: 136 - 30 * k, melt: 1 };
	};
	// a cubic Bézier sampled by its parameter (close enough to time for a scheme)
	const bez = (s: number) => {
		const u = Math.min(1, s / 0.95);
		const p = [200, 240, 270, 340];
		const q = [172, 150, 130, 104];
		const B = (a: number[]) => (1 - u) ** 3 * a[0] + 3 * (1 - u) ** 2 * u * a[1] + 3 * (1 - u) * u * u * a[2] + u ** 3 * a[3];
		return { x: B(p), y: B(q), u };
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-amorph]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const curve1 = $<SVGPathElement>('[data-c1]');
		const curve2 = $<SVGPathElement>('[data-c2]');
		const d1 = $<SVGCircleElement>('[data-d1]');
		const d2 = $<SVGCircleElement>('[data-d2]');
		const block = $<SVGRectElement>('[data-block]');
		const puddle = $<SVGPathElement>('[data-puddle]');
		const rod = $<SVGPathElement>('[data-rod]');
		const RUN = 9;
		let t = 0;
		loop(root, (dt) => {
			t = (t + dt) % RUN;
			const s = Math.min(1, t / (RUN - 1.5));
			// the crystal
			let d = 'M24 172';
			for (let k = 1; k <= 40; k++) {
				const p = c1((s * k) / 40);
				d += ` L${f(p.x)} ${f(p.y)}`;
			}
			curve1.setAttribute('d', d);
			const p1 = c1(s);
			d1.setAttribute('cx', f(p1.x));
			d1.setAttribute('cy', f(p1.y));
			const h = 30 * (1 - p1.melt);
			block.setAttribute('y', f(74 - h));
			block.setAttribute('height', f(Math.max(0, h)));
			block.style.display = h > 0.3 ? '' : 'none';
			const pw = 20 + 26 * p1.melt;
			const ph = 3 + 4 * p1.melt;
			puddle.setAttribute('d', p1.melt > 0 ? `M${f(92 - pw)} 74 Q92 ${f(74 - 2 * ph)} ${f(92 + pw)} 74 Z` : '');
			// the amorphous rod: the sag grows with the temperature, slowly at first
			let e = 'M200 172';
			for (let k = 1; k <= 40; k++) {
				const p = bez((s * k) / 40);
				e += ` L${f(p.x)} ${f(p.y)}`;
			}
			curve2.setAttribute('d', e);
			const p2 = bez(s);
			d2.setAttribute('cx', f(p2.x));
			d2.setAttribute('cy', f(p2.y));
			const sag = 2 + 34 * Math.pow(p2.u, 2.2);
			const th = 7 - 2 * p2.u;
			rod.setAttribute('d', `M218 ${f(56 - th)} Q268 ${f(56 - th + 2 * sag)} 318 ${f(56 - th)} L318 56 Q268 ${f(56 + 2 * sag)} 218 56 Z`);
			return true;
		});
	}
</script>
