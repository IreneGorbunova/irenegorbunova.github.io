---
/**
 * Small pictures to «Где это встречается» (four panels: in a row on a computer, 2 × 2 on a phone; schemes, not to
 * scale).
 * «Кремний»: a single crystal of silicon is pulled slowly up out of a crucible of glowing melt on a seed, turning (the
 *   Czochralski method: a few millimetres an hour and about 10 turns a minute — sped up here: the ingot grows 18 px
 *   longer in 8 с, its bottom staying at the melt, and its stripes run round once a second); cut wafers lie beside it.
 * «Стекло»: a blowpipe turns (its stripes run along it) and the glowing gob of softened glass on its end swells into a
 *   bulb (radius 9 → 22 px in 5 с, then again); no person.
 * «Балка и труба»: cross-sections of an I-beam and a tube bent with the load from above: the upper flange compressed
 *   (cool, arrows inward), the lower one stretched (warm, arrows outward), the neutral layer dashed; the material is
 *   put where the strain is largest.
 * «Железобетон»: a concrete beam on two supports under a load, cut open near the bottom to show the steel bars, which
 *   take the tension (arrows outward); the concrete at the top is compressed (arrows inward).
 */
import G7Styles from '../g7/G7Styles.astro';
import TtStyles from './TtStyles.astro';
import Vec from './Vec.astro';

const uid = Math.random().toString(36).slice(2, 8);
const arr = (x0: number, x1: number, y: number) => {
	const s = Math.sign(x1 - x0);
	return `M${x0} ${y} H${x1} M${x1 - 4 * s} ${y - 3} L${x1} ${y} L${x1 - 4 * s} ${y + 3}`;
};
---

<G7Styles />
<TtStyles />
<figure class="g7 g7--pic us not-content" data-ttuses>
	<div class="g7__grid us__grid">
		<svg class="g7__svg" viewBox="0 0 180 160" role="img" aria-label="Монокристалл кремния медленно вытягивают из расплава, рядом лежат нарезанные пластины">
			<defs>
				<linearGradient id={`us-melt-${uid}`} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="us-hot-a"></stop>
					<stop offset="1" class="us-hot-b"></stop>
				</linearGradient>
			</defs>
			<text class="t-title" x="10" y="20">кремний</text>
			<line class="us-rod" x1="66" y1="26" x2="66" y2="40" data-rod></line>
			<g data-ingot>
				<path class="us-ingot" data-ingotp d=""></path>
				<path class="us-stripes" data-istripes d=""></path>
			</g>
			<path class="us-crucible" d="M30 112 H102 V140 Q66 152 30 140 Z"></path>
			<path fill={`url(#us-melt-${uid})`} d="M33 116 H99 V138 Q66 148 33 138 Z"></path>
			<ellipse class="us-meniscus" cx="66" cy="116" rx="16" ry="3"></ellipse>
			{[0, 1, 2, 3].map((k) => <ellipse class="us-wafer" cx={140} cy={142 - k * 6} rx="26" ry="7"></ellipse>)}
		</svg>
		<svg class="g7__svg" viewBox="0 0 180 160" role="img" aria-label="Стеклодувная трубка вращается, и комок размягчённого стекла на её конце раздувается в пузырь">
			<defs>
				<radialGradient id={`us-gob-${uid}`} cx="0.4" cy="0.4" r="0.7">
					<stop offset="0" class="us-hot-a"></stop>
					<stop offset="1" class="us-hot-b"></stop>
				</radialGradient>
			</defs>
			<text class="t-title" x="10" y="20">стекло</text>
			<rect class="us-pipe" x="6" y="84" width="112" height="8" rx="3"></rect>
			<path class="us-pipestripes" data-pstripes d=""></path>
			<circle data-gob cx="128" cy="88" r="9" fill={`url(#us-gob-${uid})`}></circle>
			<circle class="us-gobedge" data-gobedge cx="128" cy="88" r="9"></circle>
		</svg>
		<svg class="g7__svg" viewBox="0 0 180 160" role="img" aria-label="Сечения двутавровой балки и трубы при изгибе: верхняя полка сжата, нижняя растянута, середина почти не нагружена">
			<text class="t-title" x="10" y="20">балка и труба</text>
			<text class="t-small us-comp-t" x="90" y="40" text-anchor="middle">сжатие</text>
			<path class="us-comp" d="M20 48 H72 V58 H20 Z"></path>
			<path class="us-web" d="M42 58 H50 V100 H42 Z"></path>
			<path class="us-tens" d="M20 100 H72 V110 H20 Z"></path>
			<path class="us-comp" d="M106 79 A26 26 0 0 1 158 79 L150 79 A18 18 0 0 0 114 79 Z"></path>
			<path class="us-tens" d="M106 79 A26 26 0 0 0 158 79 L150 79 A18 18 0 0 1 114 79 Z"></path>
			<path class="us-neutral" d="M12 79 H168"></path>
			<path class="us-arr us-arr--c" d={arr(24, 36, 53) + ' ' + arr(68, 56, 53)}></path>
			<path class="us-arr us-arr--t" d={arr(36, 24, 105) + ' ' + arr(56, 68, 105)}></path>
			<text class="t-small us-tens-t" x="90" y="128" text-anchor="middle">растяжение</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 180 160" role="img" aria-label="Железобетонная балка на двух опорах под нагрузкой: внизу, где бетон растянут, лежат стальные стержни — арматура">
			<text class="t-title" x="10" y="20">железобетон</text>
			<line class="us-force" x1="90" y1="50" x2="90" y2="74"></line>
			<path class="us-force-head" d="M85 72 L90 82 L95 72 Z"></path>
			<Vec x={98} y={70} t="F" cls="t-red" />
			<rect class="us-concrete" x="12" y="82" width="156" height="30" rx="1"></rect>
			<rect class="us-cut" x="34" y="98" width="112" height="13"></rect>
			<path class="us-bar" d="M16 103 H164 M16 108 H164"></path>
			<path class="us-arr us-arr--c" d={arr(30, 50, 89) + ' ' + arr(150, 130, 89)}></path>
			<path class="us-arr us-arr--t" d={arr(70, 46, 124) + ' ' + arr(110, 134, 124)}></path>
			<path class="us-support" d="M26 112 L18 126 L34 126 Z M154 112 L146 126 L162 126 Z"></path>
			<text class="t-small us-comp-t" x="40" y="74" text-anchor="middle">сжатие</text>
			<text class="t-small us-tens-t" x="90" y="146" text-anchor="middle">растяжение</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Монокристалл кремния вытягивают из расплава; стеклодув раздувает размягчённое стекло; у балки и трубы при изгибе работают верхние и нижние слои (штриховая линия — нейтральный слой); в железобетонной балке растяжение внизу берут на себя стальные стержни. Схемы, не в масштабе.</figcaption>
</figure>

<style is:global>
	.us__grid {
		grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
		gap: 0.6rem;
	}
	@container (max-width: 30rem) {
		.us__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
		}
	}
	.us-hot-a {
		stop-color: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-white));
	}
	.us-hot-b {
		stop-color: color-mix(in oklab, var(--ig-v) 45%, var(--ig-vy));
	}
	.us-rod {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.us-ingot {
		fill: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.us-stripes,
	.us-pipestripes {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		opacity: 0.45;
	}
	.us-crucible {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-meniscus {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-white));
		opacity: 0.8;
	}
	.us-wafer {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-pipe {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-gobedge {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-gray-1));
		stroke-width: 1;
	}
	.us-comp {
		fill: color-mix(in oklab, var(--tt-comp) 60%, var(--g7-paper));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-tens {
		fill: color-mix(in oklab, var(--tt-tens) 60%, var(--g7-paper));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-web {
		fill: var(--tt-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-neutral {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.us-arr {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.us-arr--c {
		stroke: var(--tt-comp);
	}
	.us-arr--t {
		stroke: var(--tt-tens);
	}
	.us-comp .us-arr--c {
		stroke: var(--sl-color-black);
	}
	.g7__svg .us-comp-t {
		fill: var(--tt-comp);
	}
	.g7__svg .us-tens-t {
		fill: var(--tt-tens);
	}
	.us-concrete {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--ig-v));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-cut {
		fill: var(--sl-color-gray-5);
	}
	.us-bar {
		stroke: var(--tt-steel);
		stroke-width: 3;
	}
	.us-load {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.us-force {
		stroke: var(--g7-red);
		stroke-width: 2.5;
	}
	.us-force-head {
		fill: var(--g7-red);
	}
	.us-support {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-ttuses]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const ingotP = $('[data-ingotp]');
		const rod = $('[data-rod]');
		const ist = $('[data-istripes]');
		const pst = $('[data-pstripes]');
		const gob = $('[data-gob]');
		const gobE = $('[data-gobedge]');
		const draw = (t: number) => {
			// 18 px in 8 s, then a new one
			const up = ((t % 8) / 8) * 18;
			// the ingot grows from the melt: its bottom stays at the surface, its top goes up with the seed
			ingotP.setAttribute('d', `M60 ${f(40 - up)} L72 ${f(40 - up)} L80 ${f(52 - up)} L80 108 Q66 116 52 108 L52 ${f(52 - up)} Z`);
			rod.setAttribute('y2', f(40 - up));
			let s = '';
			for (let k = 0; k < 3; k++) {
				const ph = ((t + k / 3) % 1) * Math.PI;
				const x = 66 - 14 * Math.cos(ph);
				s += `M${f(x)} ${f(56 - up)} V${f(108 + 3 * Math.sin(ph))} `;
			}
			ist.setAttribute('d', s);
			// the blowpipe turns; the bulb swells (radius 9 → 22 in 5 s)
			let p = '';
			for (let k = 0; k < 8; k++) {
				const x = 10 + ((k * 14 + t * 20) % 108);
				p += `M${f(x)} 85 L${f(x + 4)} 91 `;
			}
			pst.setAttribute('d', p);
			const tt = t % 6;
			const r = 9 + 13 * Math.min(1, tt / 5) ** 0.7;
			for (const c of [gob, gobE]) {
				c.setAttribute('r', f(r));
				c.setAttribute('cx', f(118 + r));
			}
		};
		let t = 0;
		(root as HTMLElement & { ttDraw?: (t: number) => void }).ttDraw = (tt: number) => draw((t = tt));
		loop(root, (dt) => {
			if (root.hasAttribute('data-tt-freeze')) return false;
			t = (t + dt) % 24;
			draw(t);
			return true;
		});
		draw(0);
	}
</script>
