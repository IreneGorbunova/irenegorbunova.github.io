---
/**
 * Picture to «Анизотропия»: two crystals whose properties depend on the direction.
 *
 * «Исландский шпат»: a clear calcite rhombohedron about 2 см thick lies on a page printed with the word «КРИСТАЛЛ»;
 *   seen from above (slightly obliquely: the side faces show below the top face). Its top face is a rhombus with the
 *   real angles of a cleavage face of calcite, 101,9° and 78,1° (side 92 px). Through the crystal every letter is seen
 *   twice: one image stays in place (the ordinary one), the other is shifted along the short diagonal of the face, the
 *   plane that holds the optic axis (the extraordinary one). For light falling straight down the two beams separate
 *   by t·tg 6,2° ≈ 0,11 t, 2,2 мм for t = 2 см; drawn 10 px, larger (the caption says so). The crystal turns slowly
 *   about the vertical, one turn in 8 с: the shifted image goes round the other one with the crystal, the other stays.
 * «Слюда»: a block of mica (9 sheets, thickness exaggerated) on a table, side view; a thin blade (no hands) slides in
 *   between the two upper sheets and the top sheet peels off and bends up easily (it stays fastened at the far end);
 *   the blade goes out, the sheet lies back. Then the blade presses across the sheets from above: the block only
 *   shakes a little and does not split. Labels «вдоль слоёв — легко» and «поперёк — трудно» below the table, the
 *   current one bright. Loop of 8,5 с.
 */
import G7Styles from '../g7/G7Styles.astro';
import TtStyles from './TtStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const LINES = [62, 90, 118, 146, 174, 202];
const WORD = 'КРИСТАЛЛ КРИСТАЛЛ КРИСТАЛЛ';
const SHEETS = 9;
---

<G7Styles />
<TtStyles />
<figure class="g7 g7--pic an not-content" data-ttaniso data-uid={uid}>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 340 230" role="img" aria-label="Кристалл исландского шпата лежит на странице со словом «кристалл». Сквозь кристалл каждая буква видна дважды, и одно изображение поворачивается вместе с кристаллом">
			<defs>
				<clipPath id={`an-top-${uid}`}><path data-clip d=""></path></clipPath>
			</defs>
			<text class="t-title" x="20" y="22">исландский шпат</text>
			<rect class="an-paper" x="14" y="34" width="312" height="188" rx="4"></rect>
			<g class="an-print">
				{LINES.map((y) => <text class="an-word" x="26" y={y}>{WORD}</text>)}
			</g>
			<path class="an-side" data-side d=""></path>
			<path class="an-face" data-face d=""></path>
			<g clip-path={`url(#an-top-${uid})`}>
				<g class="an-print an-print--o">
					{LINES.map((y) => <text class="an-word" x="26" y={y}>{WORD}</text>)}
				</g>
				<g class="an-print an-print--e" data-ext>
					{LINES.map((y) => <text class="an-word" x="26" y={y}>{WORD}</text>)}
				</g>
			</g>
			<path class="an-edge" data-edge d=""></path>
		</svg>
		<svg class="g7__svg" viewBox="0 0 340 230" role="img" aria-label="Слюда: тонкое лезвие легко входит между листочками, и верхний листочек отслаивается. Поперёк листочков лезвие давит, но слюда не раскалывается">
			<text class="t-title" x="20" y="22">слюда</text>
			<rect class="an-table" x="10" y="170" width="320" height="10" rx="2"></rect>
			<g data-block>
				{Array.from({ length: SHEETS - 1 }, (_, k) => <rect class={`an-sheet ${k % 2 ? 'an-sheet--b' : ''}`} x="70" y={170 - 5 * (k + 1)} width="200" height="5"></rect>)}
				<path class="an-sheet an-sheet--top" data-top d=""></path>
			</g>
			<g data-knife>
				<path class="an-blade" d="M0 0 L80 -3 L80 3 Z"></path>
				<rect class="an-handle" x="80" y="-5" width="48" height="10" rx="3"></rect>
				<path class="an-rivet" d="M94 0 h0.1 M114 0 h0.1"></path>
			</g>
			<text class="t-small an-lab" data-l1 x="248" y="204" text-anchor="middle">вдоль слоёв — легко</text>
			<text class="t-small an-lab" data-l2 x="92" y="204" text-anchor="middle">поперёк — трудно</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Буквы под кристаллом исландского шпата двоятся, и одно изображение поворачивается вместе с кристаллом. Слюда легко расщепляется вдоль слоёв, а поперёк слоёв не раскалывается. Сдвиг изображений и толщина листочков преувеличены.</figcaption>
</figure>

<style is:global>
	.an-paper {
		fill: color-mix(in oklab, var(--sl-color-gray-6) 60%, var(--g7-paper));
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.g7__svg .an-word {
		font-family: var(--__sl-font);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .an-print--o .an-word,
	.g7__svg .an-print--e .an-word {
		fill: var(--sl-color-gray-1);
		opacity: 0.62;
	}
	.an-side {
		fill: color-mix(in oklab, var(--tt-glass) 55%, var(--g7-paper));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.an-face {
		fill: color-mix(in oklab, var(--tt-glass) 22%, var(--sl-color-gray-6));
	}
	.an-edge {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.an-table {
		fill: var(--g7-wood);
	}
	.an-sheet {
		fill: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	.an-sheet--b {
		fill: color-mix(in oklab, var(--ig-v) 28%, var(--sl-color-gray-4));
	}
	.an-sheet--top {
		stroke-linejoin: round;
	}
	.an-blade {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.an-handle {
		fill: var(--g7-wood-dark);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.an-rivet {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.g7__svg .an-lab {
		fill: var(--sl-color-gray-1);
		transition: opacity 0.3s;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const f = (v: number) => v.toFixed(1);
	const D = Math.PI / 180;
	type P = { x: number; y: number };
	/** Convex hull of points (monotone chain). */
	const hull = (pts: P[]) => {
		const p = [...pts].sort((a, b) => a.x - b.x || a.y - b.y);
		const cr = (o: P, a: P, b: P) => (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
		const lo: P[] = [];
		for (const q of p) {
			while (lo.length >= 2 && cr(lo[lo.length - 2], lo[lo.length - 1], q) <= 0) lo.pop();
			lo.push(q);
		}
		const up: P[] = [];
		for (const q of p.reverse()) {
			while (up.length >= 2 && cr(up[up.length - 2], up[up.length - 1], q) <= 0) up.pop();
			up.push(q);
		}
		return lo.slice(0, -1).concat(up.slice(0, -1));
	};
	const poly = (ps: P[]) => 'M' + ps.map((p) => `${f(p.x)} ${f(p.y)}`).join(' L') + ' Z';

	for (const root of document.querySelectorAll<HTMLElement>('[data-ttaniso]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		// ---- calcite: the top face, a rhombus of side 92 with angles 78,1° and 101,9°
		const C = { x: 170, y: 126 };
		const SIDE = 92;
		const HL = SIDE * Math.cos((78.1 / 2) * D); // half of the long diagonal
		const HS = SIDE * Math.sin((78.1 / 2) * D); // half of the short diagonal
		const TH = 9; // the side faces seen below the top face
		const SHIFT = 10;
		const clip = $('[data-clip]');
		const side = $('[data-side]');
		const face = $('[data-face]');
		const edge = $('[data-edge]');
		const ext = $<SVGGElement>('[data-ext]');
		// ---- mica
		const top = $('[data-top]');
		const knife = $<SVGGElement>('[data-knife]');
		const block = $<SVGGElement>('[data-block]');
		const l1 = $<SVGTextElement>('[data-l1]');
		const l2 = $<SVGTextElement>('[data-l2]');
		const YS = 130; // between the top sheet and the next one
		// the knife: its tip, its angle (rad; 0 = blade pointing left, handle to the right)
		const REST = { x: 352, y: YS, a: 0 };
		const IN = { x: 176, y: YS, a: 0 };
		const UP = { x: 150, y: 52, a: -Math.PI / 2 };
		const PRESS = { x: 112, y: 92, a: -Math.PI / 2 };
		const DOWN = { x: 112, y: 125, a: -Math.PI / 2 };
		type K = typeof REST;
		const mix = (a: K, b: K, u: number): K => {
			const e = ease(u);
			return { x: a.x + (b.x - a.x) * e, y: a.y + (b.y - a.y) * e, a: a.a + (b.a - a.a) * e };
		};
		const RUN = 8.5;
		const draw = (t: number) => {
			// calcite
			const psi = (2 * Math.PI * t) / 8;
			const ul = { x: Math.cos(psi), y: Math.sin(psi) };
			const us = { x: -Math.sin(psi), y: Math.cos(psi) };
			const rh = [
				{ x: C.x + HL * ul.x, y: C.y + HL * ul.y },
				{ x: C.x + HS * us.x, y: C.y + HS * us.y },
				{ x: C.x - HL * ul.x, y: C.y - HL * ul.y },
				{ x: C.x - HS * us.x, y: C.y - HS * us.y },
			];
			const low = rh.map((p) => ({ x: p.x, y: p.y + TH }));
			side.setAttribute('d', poly(hull([...rh, ...low])));
			face.setAttribute('d', poly(rh));
			clip.setAttribute('d', poly(rh));
			// the edges: the top face and the vertical edges that show
			let e = poly(rh);
			const h = hull([...rh, ...low]);
			for (let i = 0; i < 4; i++) if (h.some((q) => Math.abs(q.x - low[i].x) < 0.01 && Math.abs(q.y - low[i].y) < 0.01)) e += ` M${f(rh[i].x)} ${f(rh[i].y)} L${f(low[i].x)} ${f(low[i].y)}`;
			edge.setAttribute('d', e + ' ' + poly(h));
			ext.setAttribute('transform', `translate(${f(SHIFT * us.x)} ${f(SHIFT * us.y)})`);
			// mica: phases (s): 0–1,6 the blade slides in, 1,6–2,6 the sheet peels, 2,6–3,6 hold, 3,6–4,6 out, 4,6–5,4 up,
			// 5,4–6,2 down onto the block, 6,2–6,8 press (shake), 6,8–7,6 up and away, 7,6–8,5 back to the start
			let k: K;
			let peel = 0;
			let shake = 0;
			if (t < 1.6) k = mix(REST, IN, t / 1.6);
			else if (t < 3.6) {
				k = IN;
				peel = ease((t - 1.6) / 1);
			} else if (t < 4.6) {
				k = mix(IN, REST, (t - 3.6) / 1);
				peel = 1 - ease((t - 3.6) / 0.6);
			} else if (t < 5.4) k = mix({ ...REST, y: 70 }, UP, (t - 4.6) / 0.8);
			else if (t < 6.2) k = mix(UP, PRESS, (t - 5.4) / 0.8);
			else if (t < 6.8) {
				const u = (t - 6.2) / 0.6;
				k = { ...DOWN, y: PRESS.y + (DOWN.y - PRESS.y) * Math.min(1, u * 3) };
				shake = u > 0.33 ? Math.sin(u * 40) * (1 - u) * 1.4 : 0;
			} else if (t < 7.6) k = mix(DOWN, UP, (t - 6.8) / 0.8);
			else k = mix(UP, { ...REST, y: 70 }, (t - 7.6) / 0.9);
			knife.setAttribute('transform', `translate(${f(k.x)} ${f(k.y)}) rotate(${f(k.a / D)})`);
			knife.style.opacity = t > 4.45 && t < 4.6 ? '0' : '1';
			block.setAttribute('transform', `translate(0 ${f(shake)})`);
			// the top sheet: fastened at the left; to the right of x0 it lifts along a parabola, at most 20 px at its end
			const x0 = 150;
			let d1 = '';
			let d2 = '';
			for (let x = 70; x <= 270; x += 5) {
				const lift = peel * 20 * Math.max(0, (x - x0) / (270 - x0)) ** 2;
				d1 += `${x === 70 ? 'M' : 'L'}${x} ${f(YS - 5 - lift)} `;
				d2 = `L${x} ${f(YS - lift)} ` + d2;
			}
			top.setAttribute('d', d1 + d2 + 'Z');
			const along = t < 4.4;
			l1.style.opacity = along ? '1' : '0.35';
			l2.style.opacity = along ? '0.35' : '1';
		};
		let t = 0;
		(root as HTMLElement & { ttDraw?: (t: number) => void }).ttDraw = (tt: number) => draw((t = tt));
		loop(root, (dt) => {
			if (root.hasAttribute('data-tt-freeze')) return false;
			t = (t + dt) % RUN;
			draw(t);
			return true;
		});
		draw(0);
	}
</script>
