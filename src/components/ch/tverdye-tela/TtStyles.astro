---
/**
 * The colors of «Твёрдые тела», one per quantity and material in every figure of the chapter (renders nothing):
 * force F⃗ red (--g7-red); stretched bonds and «растяжение» warm (--tt-tens), compressed ones and «сжатие» cool
 * (--tt-comp); materials: steel blue-gray, copper copper-orange, aluminium light gray, cast iron dark gray.
 */
---

<style is:global>
	.g7 {
		--tt-tens: var(--ig-v);
		--tt-comp: var(--ig-vx);
		--tt-steel: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-3));
		--tt-copper: color-mix(in oklab, var(--ig-vy) 45%, var(--ig-v));
		--tt-al: var(--sl-color-gray-2);
		--tt-iron: color-mix(in oklab, var(--sl-color-gray-3) 55%, var(--sl-color-gray-4));
		--tt-glass: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-2));
	}
	:root[data-theme='light'] .g7 {
		--tt-al: var(--sl-color-gray-4);
		--tt-iron: color-mix(in oklab, var(--sl-color-gray-2) 55%, var(--sl-color-gray-3));
	}
	/* on a phone the small labels of this chapter's figures stay at 11 px or more on the screen */
	@media (max-width: 40rem) {
		.g7:is(.sp, .bt, .an, .yl, .dg, .br, .st, .df) .g7__svg .t-small {
			font-size: 12.5px;
		}
	}
	.g7.us .g7__svg text {
		font-size: 14px;
	}
	.g7.us .g7__svg .t-title {
		font-size: 15px;
	}
</style>
