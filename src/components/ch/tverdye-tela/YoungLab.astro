---
/**
 * Model «Проволока под грузом» (section «Закон Гука»): the school way to measure Young's modulus. A wire hangs from a
 * bracket; weights of 1 кг are put on a hanger at its lower end; a dial indicator (1 turn = 1 мм, 100 divisions of
 * 0,01 мм, a small counter of whole millimetres) rests on an arm fastened to the wire and shows its elongation.
 *
 * Physics: g = 9,8 м/с², F = mg, S = πd²/4, σ = F/S, ε = σ/E, Δl = εl₀. Young's moduli from the table «Young's Modulus
 * of Elasticity – Values for Common Materials» of The Engineering ToolBox (steel, structural ASTM-A36: 200 ГПа;
 * copper: 117 ГПа; aluminum: 69 ГПа; checked 28 Nov 2026), rounded to 10 ГПа: 200, 120 and 70 ГПа; the
 * chapter's text gives the same rounded values. All loads stay far below the elastic limits: the largest σ is
 * 49,9 МПа (4 кг on 1 мм), copper's limit in StretchLab is 70 МПа.
 * Numbers (checked with python): steel, l₀ = 1 м, d = 1 мм (S = 0,785 мм²): 1 кг → σ = 12,5 МПа, Δl = 0,062 мм;
 * 2 кг → 25,0 МПа, 0,125 мм; 3 кг → 37,4 МПа, 0,187 мм; 4 кг → 49,9 МПа, ε = 2,50·10⁻⁴, Δl = 0,250 мм. At 4 кг:
 * steel 2 м → 0,499 мм; steel d = 2 мм (S = 3,14 мм²) → 12,5 МПа, 0,062 мм; copper 1 м → 0,416 мм; aluminium 1 м →
 * 0,713 мм, 2 м → 1,426 мм.
 *
 * Drawing: the wire is drawn 110 px per metre; its elongation (below 1,5 мм, under 0,2 px) is not seen — the indicator
 * shows it (the caption says so); the wire's thickness is exaggerated (2 px for 1 мм, 4 px for 2 мм). The needle
 * turns to the new reading in about 0,5 с. Graph: σ (МПа, 0–60) against ε (10⁻⁴, 0–8); «Записать точку» puts the
 * current (ε, σ) there, colored by the material (steel blue-gray, copper copper-orange, aluminium light gray) and shaped
 * by the size (l₀, d), so points of one material and different sizes fall on one straight line through zero. No
 * readout of σ/ε or of E: the pupil computes it.
 */
import G7Styles from '../g7/G7Styles.astro';
import TtStyles from './TtStyles.astro';

const GX0 = 46;
const GX1 = 286;
const GY0 = 222;
const GY1 = 34;
const sx = (e: number) => GX0 + ((GX1 - GX0) * e) / 8; // e in 10⁻⁴
const sy = (s: number) => GY0 - ((GY0 - GY1) * s) / 60; // МПа
---

<G7Styles />
<TtStyles />
<figure class="g7 yl not-content" data-ttyoung>
	<div class="g7__grid yl__grid">
		<svg class="g7__svg yl__scene" viewBox="0 0 300 330" role="img" aria-label="Проволока висит на кронштейне, к её нижнему концу подвешивают грузы по 1 кг; стрелочный индикатор показывает удлинение">
			<rect class="yl-beam" x="30" y="10" width="200" height="12"></rect>
			<path class="yl-hatch" d={Array.from({ length: 20 }, (_, k) => `M${32 + k * 10} 10 l8 -8`).join(' ')}></path>
			<rect class="yl-clamp" x="80" y="20" width="20" height="10" rx="2"></rect>
			<line class="yl-wire" data-wire x1="90" y1="30" x2="90" y2="140"></line>
			<!-- l₀ -->
			<path class="yl-dim" data-dim d=""></path>
			<text class="t-small" data-l0t x="56" y="90" text-anchor="end"></text>
			<!-- the stand of the indicator: fastened to the bracket, not to the wire -->
			<path class="yl-stand" data-stand d=""></path>
			<g data-low>
				<!-- the arm on the wire and the hanger -->
				<rect class="yl-arm" x="84" y="-4" width="80" height="5" rx="1.5"></rect>
				<rect class="yl-armclamp" x="84" y="-7" width="12" height="11" rx="2"></rect>
				<path class="yl-hook" d="M90 4 V60 M76 61 H104"></path>
				<g data-weights></g>
				<text class="t-small" data-mt x="118" y="40"></text>
			</g>
			<g data-dial>
				<line class="yl-plunger" data-plunger x1="150" y1="0" x2="150" y2="0"></line>
				<circle class="yl-face" cx="150" cy="0" r="32"></circle>
				<g data-ticks></g>
				<circle class="yl-sub" cx="150" cy="12" r="8"></circle>
				<line class="yl-subneedle" data-subneedle x1="150" y1="12" x2="150" y2="6"></line>
				<line class="yl-needle" data-needle x1="150" y1="0" x2="150" y2="-27"></line>
				<circle class="yl-hub" cx="150" cy="0" r="2.6"></circle>
				<circle class="yl-rim" cx="150" cy="0" r="32"></circle>
			</g>
		</svg>
		<div class="yl__graph">
			<svg class="g7__svg" viewBox="0 0 300 262" role="img" aria-label="График зависимости механического напряжения от относительного удлинения с записанными точками">
				{[1, 2, 3, 4, 5, 6, 7, 8].map((e) => <line class="yl-grid" x1={sx(e)} y1={GY0} x2={sx(e)} y2={GY1}></line>)}
				{[10, 20, 30, 40, 50, 60].map((s) => <line class="yl-grid" x1={GX0} y1={sy(s)} x2={GX1} y2={sy(s)}></line>)}
				<path class="yl-axis" d={`M${GX0} ${GY1 - 26} V${GY0} H${GX1 + 6}`}></path>
				{[0, 2, 4, 6, 8].map((e) => <text class="t-small" x={sx(e)} y={GY0 + 15} text-anchor="middle">{e}</text>)}
				{[0, 20, 40, 60].map((s) => <text class="t-small" x={GX0 - 6} y={sy(s) + 4} text-anchor="end">{s}</text>)}
				<text class="t-i" x={GX0 + 8} y={GY1 - 12}>σ<tspan class="t-small" font-style="normal">, МПа</tspan></text>
				<text class="t-i" x={GX1} y={GY0 + 34} text-anchor="end">ε<tspan class="t-small" font-style="normal">, 10⁻⁴</tspan></text>
				<g data-pts></g>
				<path class="yl-now" data-now d=""></path>
			</svg>
			<div class="yl__legend">
				<span><i class="yl-key yl-key--steel"></i>сталь</span>
				<span><i class="yl-key yl-key--copper"></i>медь</span>
				<span><i class="yl-key yl-key--al"></i>алюминий</span>
				<span class="yl__shapes"><svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.5"></circle></svg>1&nbsp;м, 1&nbsp;мм</span>
				<span class="yl__shapes"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="9" height="9"></rect></svg>2&nbsp;м, 1&nbsp;мм</span>
				<span class="yl__shapes"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1 L11 10.5 L1 10.5 Z"></path></svg>1&nbsp;м, 2&nbsp;мм</span>
				<span class="yl__shapes"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0.5 L11.5 6 L6 11.5 L0.5 6 Z"></path></svg>2&nbsp;м, 2&nbsp;мм</span>
			</div>
		</div>
		<div class="g7__side yl__side">
			<div class="yl__ctl">
				<div class="yl__pick">
					<div class="g7__label">Материал</div>
					<div class="g7__seg" data-mat>
						<button type="button" class="g7__btn" aria-pressed="true" data-v="steel">Сталь</button>
						<button type="button" class="g7__btn" aria-pressed="false" data-v="copper">Медь</button>
						<button type="button" class="g7__btn" aria-pressed="false" data-v="al">Алюминий</button>
					</div>
				</div>
				<div class="yl__pick">
					<div class="g7__label">Длина <i>l</i><sub>0</sub></div>
					<div class="g7__seg" data-len>
						<button type="button" class="g7__btn" aria-pressed="true" data-v="1">1&nbsp;м</button>
						<button type="button" class="g7__btn" aria-pressed="false" data-v="2">2&nbsp;м</button>
					</div>
				</div>
				<div class="yl__pick">
					<div class="g7__label">Диаметр <i>d</i></div>
					<div class="g7__seg" data-dia>
						<button type="button" class="g7__btn" aria-pressed="true" data-v="1">1&nbsp;мм</button>
						<button type="button" class="g7__btn" aria-pressed="false" data-v="2">2&nbsp;мм</button>
					</div>
				</div>
				<div class="yl__load">
					<div class="g7__label">Груз</div>
					<div class="g7__row">
						<button type="button" class="g7__btn" data-minus aria-label="Снять 1 кг">−&nbsp;1&nbsp;кг</button>
						<output class="yl__m" data-m>0&nbsp;кг</output>
						<button type="button" class="g7__btn" data-plus aria-label="Добавить 1 кг">+&nbsp;1&nbsp;кг</button>
					</div>
					<div class="g7__row">
						<button type="button" class="g7__btn g7__btn--go" data-rec>Записать точку</button>
						<button type="button" class="g7__btn" data-clear>Очистить график</button>
					</div>
				</div>
			</div>
			<ul class="g7__read">
				<li><span>сила <i>F</i></span> <b data-F>0 Н</b></li>
				<li><span>площадь сечения <i>S</i></span> <b data-S>—</b></li>
				<li class="is-warm"><span>удлинение Δ<i>l</i></span> <b data-dl>0,000 мм</b></li>
				<li class="is-key"><span>напряжение <i>σ</i></span> <b data-sig>0 МПа</b></li>
				<li><span>относительное удлинение <i>ε</i></span> <b data-eps>0</b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Подвешивайте грузы по 1&nbsp;кг и записывайте точки на график. Удлинение меньше 1,5&nbsp;мм на рисунке не видно — его показывает индикатор: один оборот большой стрелки — 1&nbsp;мм, одно деление — 0,01&nbsp;мм, маленькая стрелка считает миллиметры. Толщина проволоки преувеличена.
	</figcaption>
</figure>

<style is:global>
	.yl__grid {
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
	}
	.yl__side {
		grid-column: 1 / -1;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 0.6rem 1.25rem;
	}
	.yl__side .g7__read {
		align-content: start;
	}
	.yl__ctl {
		display: grid;
		gap: 0.45rem;
		align-content: start;
	}
	.yl__load,
	.yl__pick {
		display: grid;
		gap: 0.45rem;
	}
	/* on a phone the load buttons and the readouts stand right under the picture, then the graph, then the choices
	   of material and size (review, 28 Nov 2026: the buttons were ~650 px below the picture) */
	@container (max-width: 36rem) {
		.yl__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.yl__side,
		.yl__ctl {
			display: contents;
		}
		.yl__scene {
			order: 0;
		}
		.yl__load {
			order: 1;
		}
		.yl__side .g7__read {
			order: 2;
		}
		.yl__graph {
			order: 3;
		}
		.yl__pick {
			order: 4;
		}
	}
	.yl__m {
		min-width: 3.2rem;
		text-align: center;
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.yl__legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.9rem;
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.yl__legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		white-space: nowrap;
	}
	.yl-key {
		display: inline-block;
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		border: 1px solid var(--sl-color-gray-1);
	}
	.yl-key--steel {
		background: var(--tt-steel);
	}
	.yl-key--copper {
		background: var(--tt-copper);
	}
	.yl-key--al {
		background: var(--tt-al);
	}
	.yl__shapes svg {
		width: 0.8rem;
		height: 0.8rem;
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
	}
	.yl-beam {
		fill: var(--sl-color-gray-4);
	}
	.yl-hatch {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.yl-clamp,
	.yl-armclamp {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.yl-wire {
		stroke: var(--tt-steel);
		stroke-width: 2;
	}
	[data-ttyoung][data-mat='copper'] .yl-wire {
		stroke: var(--tt-copper);
	}
	[data-ttyoung][data-mat='al'] .yl-wire {
		stroke: var(--tt-al);
	}
	.yl-dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.yl-stand {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linejoin: round;
	}
	.yl-arm {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.yl-hook {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.yl-weight {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	.yl-plunger {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.yl-face {
		fill: var(--sl-color-gray-6);
	}
	.yl-rim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
	.yl-tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.6;
	}
	.yl-tick--l {
		stroke-width: 1.1;
	}
	.yl-sub {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.yl-needle {
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.yl-subneedle {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.yl-hub {
		fill: var(--sl-color-gray-1);
	}
	.yl-grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.yl-axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.yl-pt {
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	.yl-pt--steel {
		fill: var(--tt-steel);
	}
	.yl-pt--copper {
		fill: var(--tt-copper);
	}
	.yl-pt--al {
		fill: var(--tt-al);
	}
	.yl-now {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.4;
		stroke-dasharray: 2 2;
	}
</style>

<script>
	import { el, fmt, loop, segment } from '../g7/kit';

	const G = 9.8;
	const E: Record<string, number> = { steel: 200000, copper: 120000, al: 70000 }; // МПа
	const GX0 = 46;
	const GX1 = 286;
	const GY0 = 222;
	const GY1 = 34;
	const sx = (e: number) => GX0 + ((GX1 - GX0) * e) / 8;
	const sy = (s: number) => GY0 - ((GY0 - GY1) * s) / 60;
	const f = (v: number) => v.toFixed(1);
	const PXM = 110; // px per metre of the wire
	const TOPY = 30;
	/** A marker of the size (l₀, d) at (x, y): circle, square, triangle, diamond. */
	const marker = (l0: number, d: number, x: number, y: number, r = 4.6) => {
		if (l0 === 1 && d === 1) return `M${f(x - r)} ${f(y)} a${r} ${r} 0 1 0 ${f(2 * r)} 0 a${r} ${r} 0 1 0 ${f(-2 * r)} 0 Z`;
		if (l0 === 2 && d === 1) return `M${f(x - r * 0.9)} ${f(y - r * 0.9)} h${f(1.8 * r)} v${f(1.8 * r)} h${f(-1.8 * r)} Z`;
		if (l0 === 1 && d === 2) return `M${f(x)} ${f(y - r * 1.1)} L${f(x + r * 1.05)} ${f(y + r * 0.85)} L${f(x - r * 1.05)} ${f(y + r * 0.85)} Z`;
		return `M${f(x)} ${f(y - r * 1.2)} L${f(x + r * 1.2)} ${f(y)} L${f(x)} ${f(y + r * 1.2)} L${f(x - r * 1.2)} ${f(y)} Z`;
	};
	const sci = (e: number) => {
		if (e === 0) return '0';
		const p = Math.floor(Math.log10(e));
		const m = e / 10 ** p;
		return `${fmt(m, 2)}·10<sup>−${-p}</sup>`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-ttyoung]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const st = { mat: 'steel', l0: 1, d: 1, m: 0 };
		const pts: { mat: string; l0: number; d: number; m: number; e: number; s: number }[] = [];
		let shown = 0; // the elongation the needle shows now, мм
		const ticks = $('[data-ticks]');
		for (let k = 0; k < 100; k++) {
			const a = (k * 3.6 * Math.PI) / 180;
			const long = k % 10 === 0;
			const r0 = long ? 24 : 27;
			ticks.append(el('line', { class: `yl-tick ${long ? 'yl-tick--l' : ''}`, x1: f(150 + r0 * Math.sin(a)), y1: f(-r0 * Math.cos(a)), x2: f(150 + 30 * Math.sin(a)), y2: f(-30 * Math.cos(a)) }));
		}
		for (let k = 0; k < 10; k++) {
			const a = (k * 36 * Math.PI) / 180;
			ticks.append(el('line', { class: 'yl-tick', x1: f(150 + 6 * Math.sin(a)), y1: f(12 - 6 * Math.cos(a)), x2: f(150 + 8 * Math.sin(a)), y2: f(12 - 8 * Math.cos(a)) }));
		}
		const weights = $('[data-weights]');
		const W = [0, 1, 2, 3].map((k) => {
			const r = el('rect', { class: 'yl-weight', x: '72', y: String(60 - 9 * (k + 1)), width: '36', height: '8', rx: '2' });
			weights.append(r);
			return r;
		});
		const calc = () => {
			const S = (Math.PI * st.d * st.d) / 4; // мм²
			const F = st.m * G;
			const s = F / S; // МПа
			const e = s / E[st.mat];
			return { S, F, s, e, dl: e * st.l0 * 1000 };
		};
		const outF = $('[data-F]');
		const outS = $('[data-S]');
		const outDl = $('[data-dl]');
		const outSig = $('[data-sig]');
		const outEps = $('[data-eps]');
		const outM = $('[data-m]');
		const ptsG = $('[data-pts]');
		const now = $('[data-now]');
		const drawPts = () => {
			ptsG.replaceChildren(...pts.map((p) => el('path', { class: `yl-pt yl-pt--${p.mat}`, d: marker(p.l0, p.d, sx(p.e * 1e4), sy(p.s)) })));
		};
		const scene = () => {
			const c = calc();
			root.dataset.mat = st.mat;
			// the scene is as tall as the wire needs (220 for 1 м, 330 for 2 м)
			$('.yl__scene').setAttribute('viewBox', `0 0 300 ${st.l0 === 1 ? 220 : 330}`);
			const yEnd = TOPY + PXM * st.l0 + (shown / 1000) * PXM;
			const wire = $('[data-wire]');
			wire.setAttribute('y2', f(yEnd));
			wire.style.strokeWidth = String(2 * st.d);
			$('[data-dim]').setAttribute('d', `M62 ${TOPY} V${f(TOPY + PXM * st.l0)} M58 ${TOPY} h8 M58 ${f(TOPY + PXM * st.l0)} h8`);
			const l0t = $('[data-l0t]');
			l0t.setAttribute('y', f(TOPY + (PXM * st.l0) / 2 + 4));
			l0t.innerHTML = `<tspan font-style="italic">l</tspan><tspan font-size="9" dy="3">0</tspan><tspan dy="-3"> = ${st.l0} м</tspan>`;
			$<SVGGElement>('[data-low]').setAttribute('transform', `translate(0 ${f(yEnd)})`);
			W.forEach((r, k) => (r.style.display = k < st.m ? '' : 'none'));
			const mt = $('[data-mt]');
			mt.textContent = st.m ? `${st.m} кг` : '';
			mt.setAttribute('y', f(60 - 4.5 * st.m + 4));
			// the dial: its center 50 px above the arm, its plunger rests on the arm 60 px right of the wire
			const base = TOPY + PXM * st.l0; // where the arm is without load (the dial is fixed there)
			const dy = base - 52;
			$<SVGGElement>('[data-dial]').setAttribute('transform', `translate(0 ${f(dy)})`);
			const pl = $('[data-plunger]');
			pl.setAttribute('y1', '32');
			pl.setAttribute('y2', f(52 - 4 + (shown / 1000) * PXM));
			$('[data-stand]').setAttribute('d', `M214 22 V${f(dy)} H182`);
			const a = (shown % 1) * 360;
			$('[data-needle]').setAttribute('transform', `rotate(${f(a)} 150 0)`);
			$('[data-subneedle]').setAttribute('transform', `rotate(${f(shown * 36)} 150 12)`);
			outM.textContent = `${st.m} кг`;
			outF.textContent = `${fmt(c.F, 1)} Н`;
			outS.textContent = `${fmt(c.S, st.d === 1 ? 3 : 2)} мм²`;
			outDl.textContent = `${fmt(c.dl, 3)} мм`;
			outSig.textContent = `${fmt(c.s, 1)} МПа`;
			outEps.innerHTML = sci(c.e);
			now.setAttribute('d', st.m ? marker(st.l0, st.d, sx(c.e * 1e4), sy(c.s), 6.5) : '');
			now.setAttribute('class', `yl-now`);
		};
		let target = 0;
		const wake = loop(root, (dt) => {
			const k = 1 - Math.exp(-dt / 0.14);
			shown += (target - shown) * k;
			if (Math.abs(target - shown) < 1e-5) shown = target;
			scene();
			return shown !== target;
		});
		const update = () => {
			target = calc().dl;
			scene();
			wake();
		};
		const pick = (sel: string, set: (v: string) => void) =>
			segment($(sel), (b) => {
				set(b.dataset.v!);
				update();
			});
		pick('[data-mat]', (v) => (st.mat = v));
		pick('[data-len]', (v) => (st.l0 = +v));
		pick('[data-dia]', (v) => (st.d = +v));
		$('[data-plus]').addEventListener('click', () => {
			st.m = Math.min(4, st.m + 1);
			update();
		});
		$('[data-minus]').addEventListener('click', () => {
			st.m = Math.max(0, st.m - 1);
			update();
		});
		$('[data-rec]').addEventListener('click', () => {
			const c = calc();
			const i = pts.findIndex((p) => p.mat === st.mat && p.l0 === st.l0 && p.d === st.d && p.m === st.m);
			if (i < 0) pts.push({ mat: st.mat, l0: st.l0, d: st.d, m: st.m, e: c.e, s: c.s });
			drawPts();
		});
		$('[data-clear]').addEventListener('click', () => {
			pts.length = 0;
			drawPts();
		});
		update();
		shown = target;
		scene();
	}
</script>
