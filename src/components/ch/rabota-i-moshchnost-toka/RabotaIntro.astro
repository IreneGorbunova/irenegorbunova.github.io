---
/**
 * Two short looping opening scenes of «Работа и мощность электрического тока». Only what one sees; the captions'
 * popovers explain.
 * Meter: an evening kitchen with the flat's electricity meter on the wall (3200 имп/кВт·ч, one flash = 1125 Дж).
 *   Only the ceiling lamp (60 Вт) is on: a flash every 18,75 s, so the LED stays dark. At 1,2 s the kettle (2000 Вт)
 *   is switched on: the meter now flashes every 1125 / 2060 ≈ 0,55 s. Real time: the flashes are computed from
 *   the energy E(t) = 60·t + 2000·(t − 1,2), a flash each time E passes a multiple of 1125 Дж.
 * Overload: a kettle (2000 Вт), an iron (2000 Вт) and an oil heater (1500 Вт) are plugged into one extension lead
 *   and switched on one after another; the lead carries 9,1 → 18,2 → 25 А. Its warming follows the heat I²R with
 *   a lag (shown as a tint and shimmer), and the socket breaker in the hallway panel trips. A real breaker at
 *   1,6 times its 16 А takes from seconds to minutes: shown fast. The lamp is on another line and stays lit.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const g1 = `ri-halo1-${uid}`;
const g2 = `ri-halo2-${uid}`;
const BREAKERS = [28, 58, 88];
---

<IntroFrame data-rintro>
	<div class="intro__card" data-scene="meter">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер, кухня. На стене счётчик электроэнергии с лампочкой. Пока горит только лампа под потолком, лампочка счётчика не мигает. Включили чайник — и она замигала часто-часто">
			<defs>
				<radialGradient id={g1}>
					<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.8"></stop>
					<stop offset="0.4" stop-color="var(--ig-v)" stop-opacity="0.25"></stop>
					<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<rect class="ri-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="ri-floor" x="0" y="204" width="360" height="36"></rect>
			<!-- the cable in the wall: from the meter to the socket -->
			<path class="ri-hidden" d="M 84 176 V 192 H 318 V 132"></path>
			<!-- the lamp under the ceiling, always on -->
			<polygon class="ri-cone" points="232,34 268,34 330,204 170,204"></polygon>
			<line class="ri-cord" x1="250" y1="0" x2="250" y2="18"></line>
			<circle cx="250" cy="36" r="42" fill={`url(#${g1})`}></circle>
			<circle class="ri-bulb" cx="250" cy="35" r="6"></circle>
			<path class="ri-shade" d="M 238 16 H 262 L 274 32 H 226 Z"></path>
			<!-- the meter -->
			<rect class="ri-case" x="24" y="36" width="120" height="140" rx="8"></rect>
			<text class="ri-brand" x="84" y="52" text-anchor="middle">СЧЁТЧИК</text>
			<rect class="ri-lcd" x="36" y="60" width="96" height="30" rx="3"></rect>
			<text class="ri-digits" x="84" y="82" text-anchor="middle">03725,4</text>
			<text class="ri-small" x="132" y="102" text-anchor="end">кВт·ч</text>
			<circle class="ri-led-ring" cx="44" cy="120" r="6.5"></circle>
			<circle class="ri-led" cx="44" cy="120" r="5" data-led></circle>
			<circle class="ri-led-glow" cx="44" cy="120" r="14" data-ledglow></circle>
			<text class="ri-small ri-small--imp" x="54" y="124">3200 имп/кВт·ч</text>
			<rect class="ri-cover" x="36" y="140" width="96" height="28" rx="3"></rect>
			<circle class="ri-screw" cx="48" cy="154" r="2.5"></circle>
			<circle class="ri-screw" cx="120" cy="154" r="2.5"></circle>
			<!-- the kitchen counter -->
			<rect class="ri-cabinet" x="194" y="158" width="166" height="46"></rect>
			<line class="ri-seam" x1="276" y1="162" x2="276" y2="200"></line>
			<rect class="ri-top" x="188" y="150" width="172" height="8" rx="1.5"></rect>
			<!-- the socket and the plug -->
			<rect class="ri-socket" x="304" y="104" width="28" height="28" rx="5"></rect>
			<circle class="ri-socket-ring" cx="318" cy="118" r="9"></circle>
			<rect class="ri-plug" x="311" y="111" width="14" height="14" rx="3"></rect>
			<path class="ri-cordline" d="M 268 147 C 292 148 304 140 318 125"></path>
			<!-- the kettle -->
			<path class="ri-k-body" d="M 222 144 L 226 102 Q 244 94 262 102 L 266 144 Z"></path>
			<rect class="ri-k-lid" x="230" y="94" width="28" height="6" rx="3"></rect>
			<path class="ri-k-line" d="M 264 108 Q 282 110 278 128 Q 276 138 266 140"></path>
			<path class="ri-k-body" d="M 226 110 L 212 101 L 215 98 L 227 104 Z"></path>
			<rect class="ri-k-base" x="216" y="144" width="56" height="6" rx="2"></rect>
			<rect class="ri-k-ind" x="238" y="132" width="12" height="6" rx="1.5"></rect>
			<rect class="ri-k-ind ri-k-ind--on" x="238" y="132" width="12" height="6" rx="1.5" data-ind></rect>
			<rect class="ri-k-switch" x="266" y="136" width="8" height="5" rx="1.5" data-switch></rect>
			<text class="ri-click" x="244" y="84" text-anchor="middle" data-click>щёлк</text>
		</svg>
		<div class="intro__foot">
			<p>Пока на кухне горел только свет, лампочка на счётчике не мигала. Включили чайник — и она <More term="замигала часто-часто">Счётчик считает энергию, которую расходуют все приборы в квартире. Каждая вспышка лампочки — одна и та же порция энергии. На этом счётчике написано «3200 имп/кВт·ч»: одна вспышка — 1125 Дж. Лампа под потолком расходует 60 Дж каждую секунду — одна вспышка примерно за 19 с. Вместе с чайником расходуется 2060 Дж в секунду — почти две вспышки в секунду. Подробнее — в разделе <a href="#счётчик-электроэнергии">«Счётчик электроэнергии»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="overload">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="В один удлинитель включены чайник, утюг и обогреватель. Их включают один за другим, шнур удлинителя нагревается, и в щитке на стене со щелчком отключается автомат. Показано быстрее, чем на самом деле">
			<defs>
				<radialGradient id={g2}>
					<stop offset="0" stop-color="var(--ig-v)" stop-opacity="0.8"></stop>
					<stop offset="0.4" stop-color="var(--ig-v)" stop-opacity="0.25"></stop>
					<stop offset="1" stop-color="var(--ig-v)" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<rect class="ri-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="ri-floor" x="0" y="196" width="360" height="44"></rect>
			<!-- the lamp: another line, stays on -->
			<polygon class="ri-cone" points="232,34 268,34 330,196 170,196"></polygon>
			<line class="ri-cord" x1="250" y1="0" x2="250" y2="18"></line>
			<circle cx="250" cy="36" r="42" fill={`url(#${g2})`}></circle>
			<circle class="ri-bulb" cx="250" cy="35" r="6"></circle>
			<path class="ri-shade" d="M 238 16 H 262 L 274 32 H 226 Z"></path>
			<!-- the panel with three breakers; the middle one feeds the sockets -->
			<rect class="ri-case" x="16" y="26" width="102" height="86" rx="5"></rect>
			<line class="ri-rail" x1="22" y1="69" x2="112" y2="69"></line>
			{
				BREAKERS.map((x, i) => (
					<g>
						<rect class={`ri-brk${i === 1 ? ' ri-brk--main' : ''}`} x={x} y="42" width="22" height="54" rx="3" />
						<rect class="ri-slot" x={x + 7} y="48" width="8" height="34" rx="2" />
						<rect class="ri-lever" x={x + 6} y="49" width="10" height="14" rx="2" data-lever={i === 1 ? '' : undefined} />
					</g>
				))
			}
			<text class="ri-click" x="67" y="128" text-anchor="middle" data-click>щёлк!</text>
			<!-- the wall socket and the extension lead; its cable carries the currents of all three appliances -->
			<rect class="ri-socket" x="134" y="146" width="24" height="24" rx="4"></rect>
			<circle class="ri-socket-ring" cx="146" cy="158" r="7.5"></circle>
			<rect class="ri-plug" x="140" y="152" width="12" height="12" rx="3"></rect>
			<g data-shimmer>
				<path class="ri-shimmer" d="M 150 186 q -4 -6 0 -12 q 4 -6 0 -12"></path>
				<path class="ri-shimmer" d="M 166 204 q -4 -6 0 -12 q 4 -6 0 -12"></path>
			</g>
			<path class="ri-lead" d="M 146 164 C 146 196 156 214 186 214" data-lead></path>
			<!-- the table -->
			<rect class="ri-top" x="172" y="128" width="146" height="6" rx="1.5"></rect>
			<rect class="ri-leg" x="180" y="134" width="5" height="62"></rect>
			<rect class="ri-leg" x="305" y="134" width="5" height="62"></rect>
			<!-- cords from the appliances to the extension block -->
			<path class="ri-cordline ri-cordline--thin" d="M 222 125 C 232 150 214 186 210 207"></path>
			<path class="ri-cordline ri-cordline--thin" d="M 296 122 C 302 162 248 180 243 207"></path>
			<path class="ri-cordline ri-cordline--thin" d="M 324 192 C 316 210 286 200 276 207"></path>
			<!-- the extension block -->
			<rect class="ri-block" x="186" y="206" width="114" height="16" rx="4"></rect>
			<circle class="ri-plug" cx="210" cy="214" r="5.5"></circle>
			<circle class="ri-plug" cx="243" cy="214" r="5.5"></circle>
			<circle class="ri-plug" cx="276" cy="214" r="5.5"></circle>
			<!-- the kettle -->
			<path class="ri-k-body" d="M 190 122 L 193 92 Q 205 86 217 92 L 220 122 Z"></path>
			<rect class="ri-k-lid" x="196" y="86" width="18" height="5" rx="2.5"></rect>
			<path class="ri-k-line" d="M 218 98 Q 230 100 228 112 Q 226 120 219 120"></path>
			<rect class="ri-k-base" x="186" y="122" width="38" height="6" rx="2"></rect>
			<circle class="ri-ind" cx="205" cy="116" r="2.6" data-ind="0"></circle>
			<!-- the iron, standing on its heel -->
			<path class="ri-k-body" d="M 252 126 q 3 -16 26 -18 h 10 a 5 5 0 0 1 5 5 v 13 z"></path>
			<path class="ri-k-line" d="M 270 108 q 0 -9 9 -9 h 9 a 4 4 0 0 1 4 4 v 7"></path>
			<rect class="ri-sole" x="250" y="124" width="45" height="4" rx="1"></rect>
			<circle class="ri-ind" cx="284" cy="116" r="2.6" data-ind="1"></circle>
			<!-- the oil heater -->
			<g class="ri-heater">
				{[322, 330, 338, 346].map((x) => <rect class="ri-k-body" x={x} y="140" width="7" height="50" rx="3.5" />)}
			</g>
			<rect class="ri-k-base" x="320" y="190" width="36" height="5" rx="2"></rect>
			<circle class="ri-ind" cx="350" cy="146" r="2.2" data-ind="2"></circle>
			<g data-waves>
				<path class="ri-wave" d="M 328 134 q -3 -5 0 -10 q 3 -5 0 -10"></path>
				<path class="ri-wave" d="M 342 134 q -3 -5 0 -10 q 3 -5 0 -10"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>В один удлинитель включили чайник, утюг и обогреватель. Шнур удлинителя <More term="стал горячим">Каждый прибор берёт из сети свой ток, а по шнуру удлинителя идут все три тока сразу: около 9 + 9 + 7 = 25 А. Чем больше ток, тем сильнее нагревается провод: при вдвое большем токе теплоты выделяется вчетверо больше. Подробнее — в разделе <a href="#закон-джоуля--ленца">«Закон Джоуля — Ленца»</a>.</More>, а вскоре в щитке со щелчком <More term="отключился автомат">Автоматический выключатель следит за силой тока. Если ток долго больше допустимого — для розеток обычно 16 А, — он отключает цепь, пока провода не перегрелись и не загорелась изоляция. Подробнее — в разделе <a href="#короткое-замыкание-и-предохранители">«Короткое замыкание и предохранители»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-rintro] {
		--ri-wall: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-5));
		--ri-hot: color-mix(in oklab, var(--ig-vy) 70%, var(--ig-v));
		--ri-led: rgb(255, 70, 50);
		--ri-plastic: var(--sl-color-gray-6);
		--ri-lcd: color-mix(in srgb, var(--sl-color-green) 22%, var(--sl-color-gray-6));
	}
	:root[data-theme='light'] [data-rintro] {
		--ri-wall: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-6));
		--ri-led: rgb(230, 30, 20);
		--ri-plastic: var(--sl-color-gray-7, var(--sl-color-black));
		--ri-lcd: color-mix(in srgb, var(--sl-color-green) 18%, var(--sl-color-gray-7, var(--sl-color-black)));
	}
	.ri-wall {
		fill: var(--ri-wall);
	}
	.ri-floor {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.ri-hidden {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}
	.ri-cone {
		fill: var(--ig-v);
		opacity: 0.1;
	}
	.ri-cord {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.ri-bulb {
		fill: var(--ig-v);
	}
	.ri-shade {
		fill: color-mix(in srgb, var(--ig-vy) 40%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ri-case {
		fill: var(--ri-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.ri-brand {
		font-size: 9px;
		letter-spacing: 0.08em;
		fill: var(--sl-color-gray-3);
	}
	.ri-lcd {
		fill: var(--ri-lcd);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.intro .ri-digits {
		font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		font-size: 19px;
		font-weight: 600;
		fill: var(--sl-color-white);
	}
	.ri-small {
		font-size: 9px;
		fill: var(--sl-color-gray-2);
	}
	.ri-small--imp {
		font-size: 10.5px;
	}
	.ri-led-ring {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ri-led {
		fill: color-mix(in srgb, var(--ri-led) 25%, var(--sl-color-gray-5));
	}
	.ri-led-glow {
		fill: var(--ri-led);
		opacity: 0;
		filter: blur(4px);
	}
	.ri-cover {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ri-screw {
		fill: var(--sl-color-gray-3);
	}
	.ri-cabinet {
		fill: color-mix(in srgb, var(--ig-v) 20%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ri-seam {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.ri-top,
	.ri-leg {
		fill: color-mix(in srgb, var(--ig-v) 30%, var(--sl-color-gray-4));
	}
	.ri-socket {
		fill: var(--ri-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ri-socket-ring {
		fill: var(--sl-color-gray-5);
	}
	.ri-plug {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ri-cordline {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.ri-cordline--thin {
		stroke-width: 2.4;
	}
	.ri-lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.ri-shimmer,
	.ri-wave {
		fill: none;
		stroke: var(--ri-hot);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	[data-shimmer],
	[data-waves] {
		opacity: 0;
	}
	.ri-k-body {
		fill: var(--ri-plastic);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.ri-k-lid,
	.ri-k-base,
	.ri-sole {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ri-k-line {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.ri-k-ind {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.ri-k-ind--on {
		fill: var(--ig-vx);
		opacity: 0;
	}
	.ri-k-switch {
		fill: var(--sl-color-gray-3);
	}
	.ri-ind {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	.ri-ind.is-on {
		fill: var(--ri-led);
	}
	.ri-click {
		font-size: 15px;
		font-weight: 700;
		fill: var(--ig-v);
		opacity: 0;
	}
	.ri-rail {
		stroke: var(--sl-color-gray-3);
		stroke-width: 6;
	}
	.ri-brk {
		fill: var(--ri-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.ri-brk--main {
		stroke: var(--ig-v);
		stroke-width: 1.6;
	}
	.ri-slot {
		fill: var(--sl-color-gray-5);
	}
	.ri-lever {
		fill: var(--sl-color-gray-2);
	}
	.ri-block {
		fill: var(--ri-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};
	const f2 = (v: number) => v.toFixed(2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-rintro]')) {
		// Meter: real time. Lamp 60 Вт all the time, the kettle 2000 Вт from T_ON; one flash = 1125 Дж.
		{
			const card = root.querySelector<HTMLElement>('[data-scene="meter"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const led = $<SVGCircleElement>('[data-led]');
			const glow = $<SVGCircleElement>('[data-ledglow]');
			const ind = $<SVGRectElement>('[data-ind]');
			const sw = $<SVGRectElement>('[data-switch]');
			const click = $<SVGTextElement>('[data-click]');
			const RUN = 7;
			const T_ON = 1.2;
			const P0 = 60;
			const P1 = 2000;
			const FLASH = 1125;
			const energy = (t: number) => P0 * t + P1 * Math.max(0, t - T_ON);
			// the moment when the energy reached E
			const when = (E: number) => (E <= P0 * T_ON ? E / P0 : T_ON + (E - P0 * T_ON) / (P0 + P1));
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const k = Math.floor(energy(t) / FLASH);
				const since = k > 0 ? t - when(k * FLASH) : Infinity;
				const lit = since < 0.1 ? 1 : since < 0.22 ? 1 - (since - 0.1) / 0.12 : 0;
				led.style.fill = lit > 0 ? `color-mix(in srgb, var(--ri-led) ${Math.round(25 + 75 * lit)}%, var(--sl-color-gray-5))` : '';
				glow.style.opacity = f2(0.8 * lit);
				const on = t >= T_ON;
				ind.style.opacity = on ? '1' : '0';
				sw.setAttribute('y', on ? '138' : '136');
				click.style.opacity = f2(on ? 1 - smooth(T_ON + 0.3, T_ON + 0.8, t) : 0);
			});
		}

		// Overload: the appliances switch on at ON[i]; the lead warms with a lag; the breaker trips at TRIP. 8 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="overload"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const inds = [0, 1, 2].map((i) => $<SVGCircleElement>(`[data-ind="${i}"]`));
			const lever = $<SVGRectElement>('[data-lever]');
			const lead = $<SVGPathElement>('[data-lead]');
			const shimmer = $<SVGGElement>('[data-shimmer]');
			const waves = $<SVGGElement>('[data-waves]');
			const click = $<SVGTextElement>('[data-click]');
			const RUN = 8;
			const ON = [0.6, 2.0, 3.4];
			const TRIP = 6.4;
			const I = [2000 / 220, 2000 / 220, 1500 / 220]; // А
			const I_ALL = I[0] + I[1] + I[2];
			const TAU = 1.2; // s, the lag of the lead's warming (shown fast)
			// heat of the lead relative to all three on: (ΣI)² / I_ALL², approached exponentially
			const heat = (t: number) => {
				const events = [...ON, TRIP];
				let h = 0;
				for (let k = 0; k < events.length; k++) {
					const a = events[k];
					if (t <= a) break;
					const b = k + 1 < events.length ? events[k + 1] : Infinity;
					const sum = k < 3 ? I.slice(0, k + 1).reduce((s, v) => s + v, 0) : 0;
					const target = (sum / I_ALL) ** 2;
					h = target + (h - target) * Math.exp(-(Math.min(t, b) - a) / TAU);
				}
				return h;
			};
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const tripped = t >= TRIP;
				inds.forEach((el, i) => el.classList.toggle('is-on', t >= ON[i] && !tripped));
				waves.style.opacity = f2(smooth(ON[2], ON[2] + 1, t) * (1 - smooth(TRIP, TRIP + 1.2, t)));
				const h = heat(t);
				lead.style.stroke = `color-mix(in oklab, var(--ri-hot) ${Math.round(85 * h)}%, var(--sl-color-gray-3))`;
				shimmer.style.opacity = f2(clamp((h - 0.35) / 0.5));
				lever.setAttribute('y', tripped ? '67' : '49');
				click.style.opacity = f2(tripped ? 1 - smooth(TRIP + 0.6, TRIP + 1.2, t) : 0);
			});
		}
	}
</script>
