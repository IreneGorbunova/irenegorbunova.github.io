---
/**
 * Picture to the Joule–Lenz law: why the heat grows as the SQUARE of the current.
 * The same nichrome wire R = 5 Ом at the currents 1 А and 2 А, side by side, on one clock (real time).
 * Charge is drawn as beads of 1 Кл (as in «Сила тока. Напряжение. Сопротивление», VoltagePicture), moving in the
 * direction of the current. At 1 А one bead passes the wire every second, at 2 А every half second. The voltage on
 * the wire is U = IR = 5 В or 10 В, so each coulomb leaves 5 Дж or 10 Дж of heat in it (a «+5 Дж» pops up).
 * Per second: 1 Кл · 5 Дж = 5 Дж and 2 Кл · 10 Дж = 20 Дж — four times more. The counters show t, q = It and
 * Q = Uq = I²Rt at the moment of the last bead (that moment is the t in the formula); the wire's glow grows with the heat per second.
 * The clock restarts after 10 s; it runs only while the picture is on screen.
 */
const PANELS = [
	{ I: 1, title: 'Ток 1 А' },
	{ I: 2, title: 'Ток 2 А' },
];
const R = 5;
// the wire: a zigzag between x = 90 and x = 210 on the line y = 60
const zig = (() => {
	let d = 'M 90 60';
	for (let x = 90, k = 0; x < 210; x += 7.5, k++) d += ` L ${x + 3.75} ${k % 2 ? 66 : 54} L ${x + 7.5} 60`;
	return d;
})();
---

<figure class="rjp not-content" data-rjp>
	<div class="rjp__panels">
		{
			PANELS.map((p) => (
				<div class="rjp__panel" data-panel data-i={p.I}>
					<p class="rjp__title">{p.title}</p>
					<svg class="rjp__svg" viewBox="0 0 300 112" role="img" aria-label={`Нихромовая проволока сопротивлением 5 Ом при токе ${p.I} А. Через неё каждую секунду проходит заряд ${p.I} Кл, и каждый кулон оставляет в ней ${p.I * R} Дж теплоты`}>
						<line class="rjp__lead" x1="0" y1="60" x2="90" y2="60" />
						<line class="rjp__lead" x1="210" y1="60" x2="300" y2="60" />
						<path class="rjp__glow" d={zig} data-glow />
						<path class="rjp__wire" d={zig} />
						<g data-beads />
						<g data-pops />
						<path class="rjp__arrow" d="M 14 30 H 58 M 50 25 L 58 30 L 50 35" />
						<text class="rjp__lbl" x="14" y="20">
							<tspan class="rjp__i">I</tspan>
						</text>
						<text class="rjp__lbl" x="150" y="96" text-anchor="middle">
							нихром, <tspan class="rjp__i">R</tspan> = 5 Ом
						</text>
					</svg>
					<p class="rjp__sum">
						За 1 с проходит <b>{p.I} Кл</b>, каждый кулон даёт <b>{p.I * R} Дж</b>: теплота за 1 с — <b class="rjp__hot">{p.I * p.I * R} Дж</b>.
					</p>
					<div class="rjp__formula" data-formula />
				</div>
			))
		}
	</div>
	<div class="rjp__buttons">
		<button type="button" class="rjp__btn" data-pause>Пауза</button>
		<button type="button" class="rjp__btn" data-reset>Сначала</button>
		<span class="rjp__key"><span class="rjp__bead" aria-hidden="true"></span> — заряд 1 Кл</span>
	</div>
	<figcaption class="rjp__legend">
		Проволока одна и та же. При токе 2 А через неё каждую секунду проходит вдвое больший заряд. И напряжение на ней
		вдвое больше, <i>U</i> = <i>IR</i> = 10 В, поэтому каждый кулон оставляет в проволоке вдвое больше теплоты — 10 Дж
		вместо 5 Дж. Вдвое больше кулонов, и каждый даёт вдвое больше: теплоты в 2 · 2 = 4 раза больше.
	</figcaption>
</figure>

<style is:global>
	.rjp {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.rjp__panels {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.rjp__panel {
		min-width: 0;
		padding: 0.5rem 0.6rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
	}
	.rjp__title {
		margin: 0;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.rjp__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.rjp__lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
	}
	.rjp__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.rjp__glow {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 70%, var(--ig-v));
		stroke-width: 9;
		stroke-linejoin: round;
		filter: blur(3px);
		opacity: 0;
	}
	.rjp__b,
	.rjp__bead {
		fill: var(--ig-vx);
		stroke: var(--sl-color-white);
		stroke-width: 1;
	}
	.rjp__bead {
		display: inline-block;
		width: 0.8em;
		height: 0.8em;
		border-radius: 50%;
		vertical-align: -0.05em;
		background: var(--ig-vx);
		border: 1px solid var(--sl-color-white);
	}
	.rjp__pop {
		font-size: 13px;
		font-weight: 700;
		fill: color-mix(in oklab, var(--ig-vy) 75%, var(--sl-color-white));
	}
	:root[data-theme='light'] .rjp__pop {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-black));
	}
	.rjp__arrow {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.rjp__lbl {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
		font-family: var(--__sl-font);
	}
	.rjp__i {
		font-family: var(--ig-font-math);
		font-style: italic;
		fill: var(--ig-v);
	}
	.rjp__sum {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.rjp__sum b {
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.rjp__sum .rjp__hot {
		color: var(--sl-color-text-accent);
	}
	.rjp__formula {
		min-height: 2.4em;
		overflow-x: auto;
		font-size: 0.95em;
	}
	.rjp__formula .katex-display {
		margin: 0.3rem 0 0;
	}
	.rjp__buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 0.75rem;
	}
	.rjp__btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.3rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.rjp__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.rjp__key {
		font-size: var(--sl-text-sm);
	}
	.rjp__legend {
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
	}
	.rjp__legend i {
		font-family: var(--ig-font-math);
	}
	@media (max-width: 40rem) {
		.rjp__panels {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { loop } from '@components/intro/scene';
	import { renderTex, tex } from './rm';

	const NS = 'http://www.w3.org/2000/svg';
	const R = 5; // Ом
	const D = 40; // svg units between beads of 1 Кл
	const MID = 150; // the middle of the wire
	const CYCLE = 10; // s, then the clock restarts
	const POP_LIFE = 1; // s

	for (const root of document.querySelectorAll<HTMLElement>('[data-rjp]')) {
		const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')].map((el) => {
			const I = Number(el.dataset.i);
			const gBeads = el.querySelector<SVGGElement>('[data-beads]')!;
			const beads = Array.from({ length: 12 }, () => {
				const c = document.createElementNS(NS, 'circle');
				c.setAttribute('r', '6');
				c.setAttribute('cy', '60');
				c.setAttribute('class', 'rjp__b');
				gBeads.appendChild(c);
				return c;
			});
			(el.querySelector<SVGPathElement>('[data-glow]')!).style.opacity = String(0.15 + 0.75 * Math.min(1, (I * I * R) / 20));
			return {
				I,
				U: I * R,
				beads,
				gPops: el.querySelector<SVGGElement>('[data-pops]')!,
				pops: [] as { el: SVGTextElement; born: number }[],
				formula: el.querySelector<HTMLElement>('[data-formula]')!,
				shown: -1,
			};
		});

		let t = 0;
		let running = true;
		const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;

		const formula = (p: (typeof panels)[number], k: number) => {
			const tk = k / p.I; // the moment of the k-th coulomb
			const Q = p.U * k;
			const src = k
				? `\\begin{aligned} Q &= (${p.I}~\\text{А})^2 \\cdot ${R}~\\text{Ом} \\cdot ${tex(tk, 1)}~\\text{с} \\\\ &= ${tex(Q, 0)}~\\text{Дж} \\end{aligned}`
				: 'Q = I^2 R t';
			renderTex(p.formula, src);
		};

		const draw = () => {
			for (const p of panels) {
				const k = Math.floor(p.I * t + 1e-9); // coulombs that have passed the middle of the wire
				// beads: bead j is at MID + D·(I·t − j)
				const first = Math.ceil(p.I * t - (300 - MID + 10) / D);
				p.beads.forEach((b, n) => {
					const j = first + n;
					const x = MID + D * (p.I * t - j);
					b.setAttribute('cx', x.toFixed(1));
					b.style.display = x < -10 || x > 310 ? 'none' : '';
				});
				if (k !== p.shown) {
					if (k > p.shown && k > 0) {
						const el = document.createElementNS(NS, 'text');
						el.setAttribute('class', 'rjp__pop');
						el.setAttribute('text-anchor', 'middle');
						el.setAttribute('x', String(MID));
						el.textContent = `+${p.U} Дж`;
						p.gPops.appendChild(el);
						p.pops.push({ el, born: k / p.I });
					}
					p.shown = k;
					formula(p, k);
				}
				p.pops = p.pops.filter((q) => {
					const age = t - q.born;
					if (age > POP_LIFE || age < 0) {
						q.el.remove();
						return false;
					}
					q.el.setAttribute('y', (46 - 34 * (age / POP_LIFE)).toFixed(1));
					q.el.style.opacity = (1 - (age / POP_LIFE) ** 2).toFixed(2);
					return true;
				});
			}
		};

		const reset = () => {
			t = 0;
			for (const p of panels) {
				p.pops.forEach((q) => q.el.remove());
				p.pops = [];
				p.shown = -1;
			}
			draw();
		};

		const wake = loop(root, (dt) => {
			if (!running) return false;
			t += dt;
			if (t >= CYCLE) reset();
			else draw();
			return true;
		});

		pauseBtn.addEventListener('click', () => {
			running = !running;
			pauseBtn.textContent = running ? 'Пауза' : 'Дальше';
			if (running) wake();
		});
		root.querySelector('[data-reset]')!.addEventListener('click', () => {
			reset();
			running = true;
			pauseBtn.textContent = 'Пауза';
			wake();
		});
		reset();
	}
</script>
