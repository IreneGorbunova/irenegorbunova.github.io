---
/**
 * Labelled schemes next to the definitions of the incandescent lamp and the electric heater:
 * an incandescent lamp (glass bulb filled with inert gas, tungsten filament coiled, lead-in wires with supports
 * on a glass stem, screw base, foot contact) and a tubular heating element as in a kettle or an iron (metal tube,
 * nichrome coil along its axis, insulating powder between them — in reality magnesium oxide — and a terminal rod).
 * The near half of the tube is cut away. «Включить» makes the filament glow white-yellow and the coil red.
 */
const coil = (x1: number, x2: number, y: number, r: number, step: number) => {
	let d = `M ${x1} ${y}`;
	for (let x = x1; x < x2 - 0.1; x += step) d += ` q ${step / 2} ${-2 * r} ${step} 0`;
	return d;
};
const fil = coil(72, 108, 80, 3.5, 3);
const spiral = (() => {
	let d = 'M 34 100';
	for (let x = 34; x < 204; x += 4) d += ` c 0 -14 8 -14 8 0 c 0 10 -4 10 -4 0`;
	return d;
})();
// the insulating powder: a deterministic sprinkle of dots
const dots: [number, number][] = [];
for (let i = 0; i < 150; i++) dots.push([34 + ((i * 37) % 172) + (i % 3), 80 + ((i * 53) % 40)]);
---

<figure class="rls not-content" data-rls>
	<div class="rls__panels">
		<div class="rls__panel">
			<p class="rls__title">Лампа накаливания</p>
			<svg class="rls__svg" viewBox="0 0 272 214" role="img" aria-label="Устройство лампы накаливания: стеклянная колба с инертным газом, вольфрамовая нить, держатели, цоколь и контакт">
				<circle class="rls__halo" cx="90" cy="80" r="60" />
				<path class="rls__glass" d="M 72 150 C 72 128 40 116 40 80 A 50 50 0 0 1 140 80 C 140 116 108 128 108 150 Z" />
				<path class="rls__stem" d="M 80 150 L 86 112 H 94 L 100 150 Z" />
				<path class="rls__lead" d="M 84 150 L 72 80 M 96 150 L 108 80 M 90 112 V 78" />
				<path class="rls__fil" d={fil} />
				<path class="rls__fil rls__fil--hot" d={fil} />
				<rect class="rls__base" x="70" y="150" width="40" height="40" rx="3" />
				<path class="rls__thread" d="M 70 158 L 110 162 M 70 168 L 110 172 M 70 178 L 110 182" />
				<path class="rls__tip" d="M 80 190 L 84 198 H 96 L 100 190 Z" />
				<g class="rls__labels">
					<path d="M 146 30 L 127 46 M 146 62 L 110 79 M 146 94 L 124 100 M 146 126 L 102 120 M 146 168 L 112 170 M 146 200 L 98 196" />
					<text x="150" y="34">стеклянная колба</text>
					<text x="150" y="66">вольфрамовая нить</text>
					<text x="150" y="98">инертный газ</text>
					<text x="150" y="130">держатели</text>
					<text x="150" y="172">цоколь</text>
					<text x="150" y="204">контакт</text>
				</g>
			</svg>
		</div>
		<div class="rls__panel">
			<p class="rls__title">Нагревательный элемент (ТЭН)</p>
			<svg class="rls__svg" viewBox="0 24 260 190" role="img" aria-label="Трубчатый нагревательный элемент в разрезе: металлическая трубка, внутри по оси нихромовая спираль, между ними изолирующий порошок, наружу выходит вывод">
				<rect class="rls__tube-in" x="30" y="78" width="180" height="44" />
				<g class="rls__powder">{dots.map(([x, y]) => <circle cx={x} cy={y} r="1.1" />)}</g>
				<line class="rls__rod" x1="6" y1="100" x2="36" y2="100" />
				<path class="rls__coil" d={spiral} />
				<path class="rls__coil rls__coil--hot" d={spiral} />
				<rect class="rls__tube" x="30" y="70" width="190" height="8" rx="3" />
				<rect class="rls__tube" x="30" y="122" width="190" height="8" rx="3" />
				<path class="rls__tube" d="M 210 70 H 214 A 30 30 0 0 1 214 130 H 210 Z" />
				<rect class="rls__tube" x="26" y="70" width="6" height="60" rx="2" />
				<g class="rls__labels">
					<path d="M 120 46 L 120 70 M 16 46 L 16 98 M 100 164 L 100 106 M 168 190 L 160 118" />
					<text x="120" y="40" text-anchor="middle">металлическая трубка</text>
					<text x="6" y="40">вывод</text>
					<text x="100" y="178" text-anchor="middle">нихромовая спираль</text>
					<text x="168" y="204" text-anchor="middle">изолирующий порошок</text>
				</g>
			</svg>
		</div>
	</div>
	<div class="rls__foot">
		<button type="button" class="rls__btn" data-on aria-pressed="false">Включить</button>
		<p>Такой нагревательный элемент стоит в чайнике, утюге, стиральной машине. Порошок не проводит ток, но хорошо проводит тепло.</p>
	</div>
</figure>

<style is:global>
	.rls {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
	}
	.rls__panels {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.rls__panel {
		min-width: 0;
	}
	.rls__title {
		margin: 0 0 0.25rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.rls__svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.rls__labels path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
	}
	.rls__labels text {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
		font-family: var(--__sl-font);
	}
	.rls__glass {
		fill: color-mix(in srgb, var(--ig-vx) 10%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	.rls__stem {
		fill: color-mix(in srgb, var(--sl-color-gray-4) 50%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rls__lead {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.rls__fil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.rls__fil--hot {
		stroke: rgb(255, 214, 120);
		filter: drop-shadow(0 0 3px rgb(255, 170, 60));
		opacity: 0;
		transition: opacity 0.4s;
	}
	.rls__halo {
		fill: rgba(255, 200, 100, 0.35);
		filter: blur(10px);
		opacity: 0;
		transition: opacity 0.5s;
	}
	.rls__base {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rls__thread {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.rls__tip {
		fill: var(--sl-color-gray-2);
	}
	.rls__tube {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.rls__tube-in {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 70%, transparent);
	}
	.rls__powder circle {
		fill: var(--sl-color-gray-3);
		opacity: 0.6;
	}
	.rls__rod {
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.rls__coil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	.rls__coil--hot {
		stroke: rgb(235, 80, 30);
		filter: drop-shadow(0 0 3px rgb(255, 90, 30));
		opacity: 0;
		transition: opacity 0.6s;
	}
	.rls.is-on .rls__fil--hot,
	.rls.is-on .rls__coil--hot,
	.rls.is-on .rls__halo {
		opacity: 1;
	}
	.rls__foot {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
	}
	.rls__foot p {
		margin: 0;
	}
	.rls__btn {
		flex: none;
		font: inherit;
		padding: 0.25rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.rls__btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
	}
	@media (max-width: 40rem) {
		.rls__panels {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-rls]')) {
		const btn = root.querySelector<HTMLButtonElement>('[data-on]')!;
		btn.addEventListener('click', () => {
			const on = !root.classList.contains('is-on');
			root.classList.toggle('is-on', on);
			btn.setAttribute('aria-pressed', String(on));
			btn.textContent = on ? 'Выключить' : 'Включить';
		});
	}
</script>
