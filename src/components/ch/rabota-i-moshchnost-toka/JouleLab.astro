		color: var(--sl-color-gray-2);
	}
	.rmjl__live:empty {
		display: none;
	}
	.rmjl__caption {
		margin-top: 0.8rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.rm-i {
		color: var(--ig-vx);
	}
