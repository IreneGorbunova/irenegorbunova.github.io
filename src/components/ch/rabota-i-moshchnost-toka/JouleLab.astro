---
/**
 * The classic experiment for the Joule–Lenz law: three wires of equal length (1 м) and cross-section (0,2 мм²) —
 * copper, steel and nichrome — are connected in series, so the current in them is the same. Each wire gets
 * Q = I²Rt; its temperature follows C·dT/dt = I²R − (convection + radiation), a still-air estimate for a
 * horizontal wire 0,5 мм thick. Resistances are taken constant (table values at 20 °C).
 */
const WIRES = [
	{ k: 'cu', name: 'Медь', rho: '0,017' },
	{ k: 'st', name: 'Сталь', rho: '0,10' },
	{ k: 'ni', name: 'Нихром', rho: '1,1' },
] as const;
const ROWY = [56, 126, 196];
// A wire drawn as a gentle spiral between two posts at x = 120 and x = 470.
const coil = (y: number) => {
	let d = `M120 ${y}`;
	for (let x = 120; x < 470; x += 14) d += ` q3.5 -7 7 0 q3.5 7 7 0`;
	return d;
};
---

<figure class="rmjl not-content" data-rmjl>
	<div class="rmjl__stage">
		<svg class="rmjl__svg" viewBox="0 0 600 250" role="img" aria-label="Три проволоки — медная, стальная и нихромовая — соединены последовательно с источником тока и амперметром">
			<defs>
				<filter id="rmjl-blur" x="-5%" y="-200%" width="110%" height="500%"><feGaussianBlur stdDeviation="3.5" /></filter>
			</defs>
			<!-- connecting leads: serpentine series circuit -->
			<path class="rmjl__lead" d="M60 220 V56 H120 M470 56 H520 V126 H470 M120 126 H80 V196 H120 M470 196 H540 V236 H60 V220" />
			<path class="rmjl__flow" d="M60 220 V56 H120 M470 56 H520 V126 H470 M120 126 H80 V196 H120 M470 196 H540 V236 H60" data-flow />
			<!-- source -->
			<g class="rmjl__src">
				<rect x="34" y="150" width="52" height="58" rx="6" />
				<text x="60" y="172" text-anchor="middle">источник</text>
				<text x="60" y="194" text-anchor="middle" class="rmjl__srcv" data-srcv>0 В</text>
			</g>
			<!-- ammeter -->
			<g class="rmjl__amm">
				<circle cx="300" cy="236" r="13" />
				<text x="300" y="241" text-anchor="middle">A</text>
			</g>
			{
				WIRES.map((w, i) => (
					<g class={`rmjl__wire rmjl__wire--${w.k}`} data-wire={w.k}>
						<path class="rmjl__shimmer" d={`M240 ${ROWY[i] - 12} q-4 -6 0 -12 q4 -6 0 -12 M300 ${ROWY[i] - 12} q-4 -6 0 -12 q4 -6 0 -12 M360 ${ROWY[i] - 12} q-4 -6 0 -12 q4 -6 0 -12`} data-shim />
						<path class="rmjl__metal" d={coil(ROWY[i])} />
						<path class="rmjl__halo" d={coil(ROWY[i])} filter="url(#rmjl-blur)" data-halo />
						<path class="rmjl__hot" d={coil(ROWY[i])} data-hot />
						<rect class="rmjl__post" x="112" y={ROWY[i] - 9} width="10" height="18" rx="2" />
						<rect class="rmjl__post" x="468" y={ROWY[i] - 9} width="10" height="18" rx="2" />
						<text class="rmjl__label" x="128" y={ROWY[i] - 16}>{w.name}</text>
						<text class="rmjl__temp" x="462" y={ROWY[i] - 16} text-anchor="end" data-temp>20 °C</text>
					</g>
				))
			}
		</svg>
	</div>

	<div class="rmjl__controls">
		<label class="rmjl__ctl">
			<span>Сила тока <i>I</i> = <b data-iout>3</b> А</span>
			<input type="range" min="0" max="5" step="0.1" value="3" data-i aria-label="Сила тока, ампер" />
		</label>
		<div class="rmjl__buttons">
			<button type="button" class="rmjl__btn rmjl__btn--primary" data-go>Замкнуть цепь</button>
			<button type="button" class="rmjl__btn" data-reset>Сначала</button>
			<span class="rmjl__clock">Время <i>t</i> = <b data-tout>0</b> с</span>
		</div>
	</div>

	<table class="rmjl__table">
		<thead>
			<tr><th>Проволока</th><th><i>ρ</i>, Ом·мм²/м</th><th><i>R</i>, Ом</th><th><i>Q</i>, Дж</th></tr>
		</thead>
		<tbody>
			{
				WIRES.map((w) => (
					<tr class={`rmjl__row rmjl__row--${w.k}`} data-row={w.k} tabindex="0" aria-label={`${w.name}: показать расчёт`}>
						<td>{w.name}</td>
						<td>{w.rho}</td>
						<td data-r />
						<td>
							<span class="rmjl__q">
								<span class="rmjl__qbar"><span data-qbar /></span>
								<span data-q>0</span>
							</span>
						</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<div class="rmjl__math" data-math></div>
	<p class="rmjl__live" data-live aria-live="polite"></p>

	<figcaption class="rmjl__caption">
		Проволоки одинаковой длины 1 м и одинакового сечения 0,2 мм² (толщина около 0,5 мм) натянуты на изоляторах в неподвижном
		воздухе. Удельные сопротивления — округлённые табличные значения; сопротивление проволок считаем неизменным (на самом деле
		при нагревании оно немного растёт). Температура — примерная оценка: проволока нагревается, пока теплота, которую она получает
		от тока, больше теплоты, которую она отдаёт воздуху. Заметно светиться металл начинает примерно с 500–550 °C. Нажмите на
		строку таблицы, чтобы увидеть расчёт для этой проволоки.
	</figcaption>
</figure>

<style is:global>
	.rmjl {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.rmjl i {
		font-family: var(--ig-font-math);
	}
	.rmjl__svg {
		display: block;
		width: 100%;
		height: auto;
		max-height: 22rem;
		overflow: visible;
	}
	.rmjl__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.rmjl__flow {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2.2;
		stroke-dasharray: 2 14;
		stroke-linecap: round;
		opacity: 0;
		transition: opacity 0.3s;
	}
	.rmjl.is-on .rmjl__flow {
		opacity: 0.9;
	}
	.rmjl__src rect {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.rmjl__src text,
	.rmjl__amm text,
	.rmjl__label,
	.rmjl__temp {
		font-family: var(--sl-font);
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	.rmjl__src text {
		font-size: 10px;
	}
	.rmjl__src .rmjl__srcv {
		font-size: 14px;
		fill: var(--sl-color-white);
		font-weight: 600;
	}
	.rmjl__amm circle {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.rmjl__amm text {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.rmjl__label {
		font-weight: 600;
		fill: var(--sl-color-white);
		font-size: 14px;
	}
	.rmjl__temp {
		font-variant-numeric: tabular-nums;
		font-size: 14px;
	}
	.rmjl__metal {
		fill: none;
		stroke-width: 3;
		stroke-linecap: round;
	}
	.rmjl__wire--cu .rmjl__metal {
		stroke: hsl(22, 70%, 52%);
	}
	.rmjl__wire--st .rmjl__metal {
		stroke: hsl(210, 8%, 62%);
	}
	.rmjl__wire--ni .rmjl__metal {
		stroke: hsl(40, 6%, 48%);
	}
	.rmjl__hot,
	.rmjl__halo {
		fill: none;
		stroke-linecap: round;
		opacity: 0;
	}
	.rmjl__hot {
		stroke-width: 3.2;
	}
	.rmjl__halo {
		stroke-width: 12;
	}
	.rmjl__shimmer {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
		stroke-linecap: round;
		opacity: 0;
	}
	.rmjl__controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1.2rem;
		margin-top: 0.6rem;
	}
	.rmjl__ctl {
		flex: 1 1 14rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.rmjl__ctl b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.rmjl__ctl input {
		width: 100%;
		accent-color: var(--ig-vx);
	}
	.rmjl__buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.rmjl__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.4rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.rmjl__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.rmjl__clock {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		min-width: 7.5rem;
	}
	.rmjl__clock b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.rmjl__table {
		width: 100%;
		margin-top: 0.8rem;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.rmjl__table th,
	.rmjl__table td {
		padding: 0.35rem 0.4rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		text-align: left;
		font-variant-numeric: tabular-nums;
	}
	.rmjl__table th {
		color: var(--sl-color-gray-2);
		font-weight: 500;
	}
	.rmjl__row {
		cursor: pointer;
		transition: background 0.25s;
	}
	.rmjl__row:hover,
	.rmjl__row.is-sel {
		background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
	}
	.rmjl__q {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.rmjl__qbar {
		flex: 1 1 auto;
		min-width: 2rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		overflow: hidden;
	}
