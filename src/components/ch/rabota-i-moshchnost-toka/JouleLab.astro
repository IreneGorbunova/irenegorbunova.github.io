	@media (max-width: 480px) {
		.rmjl__table th:nth-child(2),
		.rmjl__table td:nth-child(2) {
			display: none;
		}
	}
</style>

<script>
	import { glow, ru, ruG, tex, q, renderTex } from './rm';

	type W = 'cu' | 'st' | 'ni';
	const KEYS: W[] = ['cu', 'st', 'ni'];
	const L = 1; // м
	const S = 0.2; // мм²
	const D = 0.5e-3; // м, толщина проволоки
	const RHO: Record<W, number> = { cu: 0.017, st: 0.1, ni: 1.1 }; // Ом·мм²/м
	// heat capacity of 1 m of wire, Дж/°C: c·(плотность)·S·l
	const CAP: Record<W, number> = { cu: 400 * 8900 * S * 1e-6, st: 460 * 7800 * S * 1e-6, ni: 450 * 8400 * S * 1e-6 };
	const T0 = 20;
	const AREA = Math.PI * D * L; // м², поверхность проволоки
	const H_CONV = 50; // Вт/(м²·°C), конвекция у тонкой проволоки (оценка)
	const EPS = 0.8;
	const SIGMA = 5.67e-8;
	const R = Object.fromEntries(KEYS.map((k) => [k, (RHO[k] * L) / S])) as Record<W, number>;
	const RTOT = KEYS.reduce((s, k) => s + R[k], 0);
	const loss = (t: number) => {
		const T = t + 273.15;
		const Ta = T0 + 273.15;
		return H_CONV * AREA * (t - T0) + EPS * SIGMA * AREA * (T ** 4 - Ta ** 4);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-rmjl]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const iIn = $<HTMLInputElement>('[data-i]');
		const iOut = $<HTMLElement>('[data-iout]');
		const tOut = $<HTMLElement>('[data-tout]');
		const go = $<HTMLButtonElement>('[data-go]');
		const reset = $<HTMLButtonElement>('[data-reset]');
		const srcV = $<SVGTextElement>('[data-srcv]');
		const flow = $<SVGPathElement>('[data-flow]');
		const math = $<HTMLElement>('[data-math]');
		const live = $<HTMLElement>('[data-live]');
		const w = Object.fromEntries(
			KEYS.map((k) => {
				const g = $<SVGGElement>(`[data-wire="${k}"]`);
				const row = $<HTMLTableRowElement>(`[data-row="${k}"]`);
				return [
					k,
					{
						hot: g.querySelector<SVGPathElement>('[data-hot]')!,
						halo: g.querySelector<SVGPathElement>('[data-halo]')!,
						shim: g.querySelector<SVGPathElement>('[data-shim]')!,
						temp: g.querySelector<SVGTextElement>('[data-temp]')!,
						row,
						r: row.querySelector<HTMLElement>('[data-r]')!,
						q: row.querySelector<HTMLElement>('[data-q]')!,
						qbar: row.querySelector<HTMLElement>('[data-qbar]')!,
						T: T0,
						Q: 0,
					},
				];
			}),
		) as Record<W, any>;

		let I = Number(iIn.value);
		let on = false;
		let t = 0; // с, время с момента замыкания (или с последнего изменения тока)
		let sel: W = 'ni';
		let raf = 0;
		let lastNow = 0;
		let dash = 0;
		let lastShown = -1;

		for (const k of KEYS) w[k].r.textContent = ru(R[k], 3);

		const draw = () => {
			const tt = Math.floor(t);
			for (const k of KEYS) w[k].Q = I * I * R[k] * tt;
			const qmax = Math.max(1e-9, ...KEYS.map((k) => w[k].Q));
			for (const k of KEYS) {
				const s = w[k];
				const g = glow(s.T);
				s.hot.style.stroke = g.colour;
				s.hot.style.opacity = String(g.a);
				s.halo.style.stroke = g.colour;
				s.halo.style.opacity = String(0.85 * g.a);
				s.shim.style.opacity = String(Math.max(0, Math.min(0.7, (s.T - 45) / 150)));
				s.temp.textContent = `≈ ${s.T < 100 ? Math.round(s.T) : Math.round(s.T / 10) * 10} °C`;
				s.q.textContent = s.Q < 10 ? ru(s.Q, 1) : ruG(s.Q, 0);
				s.qbar.style.width = `${(100 * s.Q) / qmax}%`;
			}
			tOut.textContent = ru(t, 0);
			srcV.textContent = `${ru(on ? I * RTOT : 0, 1)} В`;
			root.classList.toggle('is-on', on && I > 0);
		};

		const formula = () => {
			const Rk = R[sel];
			const tt = Math.floor(t);
			const Qk = I * I * Rk * tt;
			renderTex(
				math,
				`\\begin{aligned}` +
					`${q('q', 'Q')} &= ${q('i', 'I')}^2 ${q('r', 'R')}\\,t = (${q('i', `${tex(I, 1)}~\\text{А}`)})^2 \\cdot ${q('r', `${tex(Rk, 3)}~\\text{Ом}`)} \\cdot ${tt}~\\text{с} \\\\` +
					`&${Math.abs(Qk - Math.round(Qk * 10) / 10) > 1e-9 ? '\\approx' : '='} ${q('q', `${tex(Qk, Qk < 10 ? 1 : 0)}~\\text{Дж}`)}` +
					`\\end{aligned}`,
			);
		};

		const step = (dt: number) => {
			const n = Math.ceil(dt / 0.02);
			const h = dt / n;
			for (let i = 0; i < n; i++) {
				for (const k of KEYS) {
					const s = w[k];
					const p = on ? I * I * R[k] : 0;
					s.T += ((p - loss(s.T)) / CAP[k]) * h;
					if (s.T < T0) s.T = T0;
				}
				if (on) t += h;
			}
		};

		const frame = (now: number) => {
			const dt = Math.max(0, Math.min(0.1, (now - lastNow) / 1000));
			lastNow = now;
			step(dt);
			if (on && I > 0 && !reduceMotion.matches) {
				dash -= dt * (6 + 8 * I);
				flow.style.strokeDashoffset = String(dash);
			}
			draw();
			if (Math.floor(t) !== lastShown) {
				lastShown = Math.floor(t);
				formula();
			}
			const cooling = !on && KEYS.some((k) => w[k].T > T0 + 0.5);
			if (on || cooling) raf = requestAnimationFrame(frame);
			else raf = 0;
		};
		const kick = () => {
			if (raf) return;
			lastNow = performance.now();
			raf = requestAnimationFrame(frame);
		};

		const restartCount = () => {
			t = 0;
			lastShown = -1;
		};

		go.addEventListener('click', () => {
			on = !on;
			go.textContent = on ? 'Разомкнуть цепь' : 'Замкнуть цепь';
			if (on) {
				restartCount();
				live.textContent = `Ток во всех трёх проволоках одинаковый: ${ru(I, 1)} А. Следите, какая нагревается сильнее.`;
			} else {
				live.textContent = 'Цепь разомкнута: тока нет, теплота больше не выделяется, и проволоки остывают.';
			}
			kick();
		});
		reset.addEventListener('click', () => {
			on = false;
			go.textContent = 'Замкнуть цепь';
			for (const k of KEYS) w[k].T = T0;
			restartCount();
			live.textContent = '';
			draw();
			formula();
		});
		iIn.addEventListener('input', () => {
			I = Number(iIn.value);
			iOut.textContent = ru(I, 1);
			if (on) {
				restartCount();
				live.textContent = 'Сила тока изменилась — отсчёт времени и теплоты начался заново.';
			}
			draw();
			formula();
			if (on) kick();
		});
		const pick = (k: W) => {
			sel = k;
			for (const o of KEYS) w[o].row.classList.toggle('is-sel', o === k);
			formula();
		};
		for (const k of KEYS) {
			w[k].row.addEventListener('click', () => pick(k));
			w[k].row.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					pick(k);
				}
			});
		}
		pick('ni');
		draw();
	}
</script>
