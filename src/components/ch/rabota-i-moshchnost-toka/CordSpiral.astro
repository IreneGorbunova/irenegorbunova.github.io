---
/**
 * Picture to the Joule–Lenz law: why the cord stays cold while the spiral glows. A 2 кВт, 220 В reflector heater
 * on its cord. The two copper cores of the cord (1,5 м each, 0,75 мм², R = 0,017 · 3 / 0,75 = 0,068 Ом) and the
 * nichrome spiral (R = U²/P = 220² / 2000 = 24,2 Ом) are in series: the same current I = P/U ≈ 9,1 А.
 * Heat each second I²R: spiral 2000 Дж, cord ≈ 5,6 Дж, 24,2 / 0,068 ≈ 356 times less. (The cord's own resistance
 * lowers the current by 0,3 %; the rounded numbers do not change.) «Тонкий шнур»: 0,25 мм², R = 0,204 Ом,
 * ≈ 17 Дж each second — three times more. Temperature is shown only as colour: the spiral heats up to a red-orange
 * glow, the cord keeps its colour (the thin one gets a warm tint, no glow). A «+… Дж» pops up from each every second.
 * Runs only while on screen.
 */
const COIL = (() => {
	// a coil seen from the side: 16 turns between x = 222 and x = 322 on the line y = 98
	const pts: string[] = [];
	const N = 16;
	const p = 100 / N;
	for (let i = 0; i <= N * 24; i++) {
		const th = (i / 24) * 2 * Math.PI;
		const x = 222 + (p * th) / (2 * Math.PI) + 3 * Math.cos(th) - 3;
		const y = 98 + 9 * Math.sin(th);
		pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
	}
	return pts.join(' ');
})();
const CORD = 'M32 98 C 32 150 46 184 84 186 L 196 186 C 212 186 222 184 234 181';
---

<figure class="rcs not-content" data-rcs>
	<svg class="rcs__svg" viewBox="0 0 360 214" role="img" aria-label="Обогреватель мощностью 2 кВт включён в розетку. Ток идёт по медным жилам шнура и по нихромовой спирали. Спираль раскаляется, а шнур остаётся холодным">
		<line class="rcs__floor" x1="0" y1="192" x2="360" y2="192" />
		<!-- the socket and the plug -->
		<rect class="rcs__socket" x="14" y="64" width="36" height="36" rx="6" />
		<circle class="rcs__ring" cx="32" cy="82" r="12" />
		<rect class="rcs__plug" x="23" y="73" width="18" height="18" rx="4" />
		<!-- the cord; in the middle its sheath is cut away to show the two copper cores -->
		<path class="rcs__sheath" d={CORD} data-sheath />
		<rect class="rcs__cut" x="104" y="178" width="72" height="16" data-cut />
		<path class="rcs__cutend" d="M104 180.5 v11 M176 180.5 v11" data-cutend />
		<path class="rcs__core" d="M100 183.6 H180 M100 188.4 H180" data-core />
		<!-- the heater: a reflector with a ceramic rod and the spiral, on a stand -->
		<rect class="rcs__stand" x="266" y="158" width="12" height="18" rx="2" />
		<rect class="rcs__base" x="232" y="174" width="80" height="13" rx="6" />
		<circle class="rcs__dish" cx="272" cy="98" r="64" />
		<circle class="rcs__warm" cx="272" cy="98" r="62" data-warm />
		<circle class="rcs__rim" cx="272" cy="98" r="50" />
		<circle class="rcs__rim" cx="272" cy="98" r="34" />
		<rect class="rcs__rod" x="214" y="93" width="116" height="10" rx="5" />
		<polyline class="rcs__halo" points={COIL} data-halo />
		<polyline class="rcs__coil" points={COIL} />
		<polyline class="rcs__hot" points={COIL} data-hot />
		<!-- the same current in both -->
		<g class="rcs__amp">
			<rect x="44" y="132" width="66" height="22" rx="11" />
			<text x="77" y="148" text-anchor="middle"><tspan class="rcs__i">I</tspan> = <tspan data-amp>0</tspan> А</text>
		</g>
		<g class="rcs__amp">
			<rect x="239" y="122" width="66" height="22" rx="11" />
			<text x="272" y="138" text-anchor="middle"><tspan class="rcs__i">I</tspan> = <tspan data-amp>0</tspan> А</text>
		</g>
		<text class="rcs__lbl" x="140" y="208" text-anchor="middle">медные жилы шнура</text>
		<text class="rcs__lbl" x="272" y="24" text-anchor="middle">нихромовая спираль</text>
		<g data-pops />
	</svg>

	<div class="rcs__controls">
		<button type="button" class="rcs__btn rcs__btn--primary" data-power aria-pressed="false">Включить</button>
		<div class="rcs__seg" role="group" aria-label="Толщина жил шнура">
			<button type="button" data-cord="0.75" aria-pressed="true">Обычный шнур</button>
			<button type="button" data-cord="0.25" aria-pressed="false">Тонкий шнур</button>
		</div>
	</div>

	<div class="rcs__cards">
		<div class="rcs__card">
			<p class="rcs__title"><span data-cordname>Шнур</span>: медь, <span class="nw" data-s>0,75 мм²</span></p>
			<p>Сила тока <span class="nw"><i>I</i> = <b><span data-amp>0</span> А</b></span></p>
			<p>Сопротивление <span class="nw"><i>R</i> = <b><span data-rc>0,068</span> Ом</b></span></p>
			<p>Теплота за 1 с: <b class="rcs__q nw"><span data-qc>0</span> Дж</b></p>
			<p class="rcs__state" data-statec>холодный</p>
		</div>
		<div class="rcs__card">
			<p class="rcs__title">Спираль: нихром</p>
			<p>Сила тока <span class="nw"><i>I</i> = <b><span data-amp>0</span> А</b></span></p>
			<p>Сопротивление <span class="nw"><i>R</i> = <b>24,2 Ом</b></span></p>
			<p>Теплота за 1 с: <b class="rcs__q nw"><span data-qs>0</span> Дж</b></p>
			<p class="rcs__state" data-states>холодная</p>
		</div>
	</div>

	<p class="rcs__ratio" data-ratio></p>
	<div class="rcs__math">
		<div data-math="c"></div>
		<div data-math="s"></div>
	</div>

	<figcaption class="rcs__legend">
		Шнур и спираль соединены последовательно, поэтому сила тока в них одна и та же. А сопротивления очень разные, и по
		закону Джоуля — Ленца <i>Q</i> = <i>I</i>²<i>Rt</i> во столько же раз различается теплота. Шнур — две медные жилы по
		1,5 м. У тонкого шнура сопротивление втрое больше, и теплоты в нём выделяется втрое больше, поэтому для мощных
		приборов берут шнуры и удлинители с толстыми жилами.
	</figcaption>
</figure>

<style is:global>
	.rcs {
		--rcs-copper: hsl(22, 70%, 52%);
		--rcs-nichrome: hsl(40, 6%, 52%);
		--rcs-hot: color-mix(in oklab, var(--ig-vy) 70%, var(--ig-v));
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.rcs i {
		font-family: var(--ig-font-math);
	}
	.rcs__svg {
		display: block;
		width: 100%;
		max-width: 34rem;
		height: auto;
		margin-inline: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.rcs__svg text {
		font-family: var(--__sl-font);
	}
	.rcs__floor {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}
	.rcs__socket {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rcs__ring {
		fill: var(--sl-color-gray-4);
	}
	.rcs__plug {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.rcs__sheath {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 11;
		stroke-linecap: round;
		transition: stroke-width 0.3s;
	}
	.rcs.is-thin .rcs__sheath {
		stroke-width: 7;
	}
	.rcs__cut {
		fill: var(--ig-surface);
	}
	.rcs__cutend {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.rcs__core {
		fill: none;
		stroke: var(--rcs-copper);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.rcs.is-thin .rcs__core {
		stroke-width: 1.3;
	}
	.rcs__stand {
		fill: var(--sl-color-gray-4);
	}
	.rcs__base {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.rcs__dish {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.rcs__warm {
		fill: var(--rcs-hot);
		opacity: 0;
		filter: blur(6px);
	}
	.rcs__rim {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.2;
	}
	.rcs__rod {
		fill: var(--sl-color-gray-4);
	}
	.rcs__coil,
	.rcs__hot,
	.rcs__halo {
		fill: none;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.rcs__coil {
		stroke: var(--rcs-nichrome);
		stroke-width: 1.8;
	}
	.rcs__hot {
		stroke-width: 2;
		opacity: 0;
	}
	.rcs__halo {
		stroke-width: 9;
		opacity: 0;
		filter: blur(4px);
	}
	.rcs__amp rect {
		fill: var(--ig-surface);
		stroke: var(--ig-vx);
		stroke-width: 1.5;
	}
	.rcs__amp text {
		font-size: 13px;
		font-weight: 600;
		fill: var(--sl-color-white);
	}
	.rcs__i {
		font-family: var(--ig-font-math);
		font-style: italic;
		fill: var(--ig-vx);
	}
	.rcs__lbl {
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	.rcs__pop {
		font-weight: 700;
		fill: color-mix(in oklab, var(--rcs-hot) 80%, var(--sl-color-white));
	}
	.rcs__pop--small {
		font-weight: 600;
	}
	:root[data-theme='light'] .rcs__pop {
		fill: color-mix(in oklab, var(--rcs-hot) 70%, var(--sl-color-black));
	}
	.rcs__controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 0.5rem;
	}
	.rcs__btn,
	.rcs__seg button {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.rcs__btn--primary {
		min-width: 7.5rem;
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.rcs__seg {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.rcs__seg button:hover {
		border-color: var(--sl-color-accent);
	}
	.rcs__seg button[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
	}
	.rcs__cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.rcs__card {
		min-width: 0;
		padding: 0.45rem 0.65rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		font-size: var(--sl-text-sm);
	}
	.rcs__card p {
		margin: 0;
	}
	.rcs__card b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.rcs__card .rcs__q {
		color: var(--sl-color-text-accent);
	}
	.rcs__title {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.rcs__state {
		margin-top: 0.15rem !important;
		font-style: italic;
	}
	.rcs__ratio {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		min-height: 1.5em;
	}
	.rcs__ratio b {
		color: var(--sl-color-white);
	}
	.rcs__math {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-around;
		gap: 0 1.5rem;
		font-size: 0.95em;
	}
	.rcs__math > div {
		max-width: 100%;
		overflow-x: auto;
	}
	.rcs__math .katex-display {
		margin: 0.4rem 0 0.1rem;
		padding: 0 3px; /* KaTeX draws ~2 px past its box, which made the box scroll */
	}
	.rcs__legend {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
	}
	@media (max-width: 40rem) {
		.rcs {
			padding: 0.75rem;
		}
		.rcs__card {
			padding-inline: 0.5rem;
		}
	}
</style>

<script>
	import { loop } from '@components/intro/scene';
	import { glow, renderTex, ru, tex } from './rm';

	const NS = 'http://www.w3.org/2000/svg';
	const U = 220; // В
	const P = 2000; // Вт, мощность обогревателя
	const I = P / U; // ≈ 9,09 А
	const RS = (U * U) / P; // 24,2 Ом, спираль
	const RHO = 0.017; // Ом·мм²/м, медь
	const L = 3; // м: две жилы по 1,5 м
	const T_ROOM = 20;
	const T_GLOW = 850; // °C, спираль открытого обогревателя светится красно-оранжевым (только цвет, число не показано)
	const POP_LIFE = 1; // с

	for (const root of document.querySelectorAll<HTMLElement>('[data-rcs]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const $$ = <T extends Element>(s: string) => [...root.querySelectorAll<T>(s)];
		const power = $<HTMLButtonElement>('[data-power]');
		const cordBtns = $$<HTMLButtonElement>('[data-cord]');
		const hot = $<SVGPolylineElement>('[data-hot]');
		const halo = $<SVGPolylineElement>('[data-halo]');
		const warm = $<SVGCircleElement>('[data-warm]');
		const sheath = $<SVGPathElement>('[data-sheath]');
		const gPops = $<SVGGElement>('[data-pops]');
		const amps = $$<HTMLElement>('[data-amp]');
		const out = {
			rc: $<HTMLElement>('[data-rc]'),
			s: $<HTMLElement>('[data-s]'),
			name: $<HTMLElement>('[data-cordname]'),
			qc: $<HTMLElement>('[data-qc]'),
			qs: $<HTMLElement>('[data-qs]'),
			statec: $<HTMLElement>('[data-statec]'),
			states: $<HTMLElement>('[data-states]'),
			ratio: $<HTMLElement>('[data-ratio]'),
		};

		let on = false;
		let S = 0.75; // мм²
		let T = T_ROOM; // °C, спираль
		let w = 0; // 0…1, насколько нагрелся тонкий шнур (только оттенок)
		let tick = 0; // с с момента включения, для «+… Дж»
		let pops: { el: SVGTextElement; age: number; y0: number }[] = [];

		const Rc = () => (RHO * L) / S;

		const numbers = () => {
			const rc = Rc();
			const thin = S < 0.5;
			root.classList.toggle('is-thin', thin);
			out.rc.textContent = ru(rc, 3);
			out.s.textContent = `${ru(S, 2)} мм²`;
			out.name.textContent = thin ? 'Тонкий шнур' : 'Шнур';
			const i = on ? I : 0;
			amps.forEach((a) => (a.textContent = ru(i, 1)));
			out.qc.textContent = ru(i * i * rc, i * i * rc < 10 ? 1 : 0);
			out.qs.textContent = ru(i * i * RS, 0);
			const n = Math.round(RS / rc);
			out.ratio.innerHTML = `Ток в шнуре и в спирали одинаковый, а сопротивление спирали в <b>${n}</b> раз больше. Поэтому и теплоты в ней за каждую секунду выделяется в <b>${n}</b> раз больше:`;
			root.dataset.rc = String(rc);
			const line = (sub: string, R: number, digits: number) =>
				`\\begin{aligned} Q_\\text{${sub}} &= (9{,}1~\\text{А})^2 \\cdot ${tex(R, digits)}~\\text{Ом} \\cdot 1~\\text{с} \\\\ &\\approx ${tex(I * I * R, I * I * R < 10 ? 1 : 0)}~\\text{Дж} \\end{aligned}`;
			renderTex($<HTMLElement>('[data-math="c"]'), line('шнура', rc, 3));
			renderTex($<HTMLElement>('[data-math="s"]'), line('спирали', RS, 1));
		};

		const states = () => {
			const thin = S < 0.5;
			out.states.textContent = on ? (T >= 500 ? 'раскалена докрасна' : 'нагревается') : T > 100 ? 'остывает' : 'холодная';
			out.statec.textContent = on ? (thin ? 'заметно нагревается' : 'почти не нагревается') : w > 0.1 ? 'остывает' : 'холодный';
		};

		const draw = () => {
			const g = glow(T);
			hot.style.stroke = g.colour;
			hot.style.opacity = g.a.toFixed(3);
			halo.style.stroke = g.colour;
			halo.style.opacity = (0.8 * g.a).toFixed(3);
			warm.style.opacity = (0.3 * g.a).toFixed(3);
			sheath.style.stroke = w > 0.005 ? `color-mix(in oklab, var(--rcs-hot) ${(40 * w).toFixed(1)}%, var(--sl-color-gray-3))` : '';
			root.dataset.t = T.toFixed(0);
			states();
		};

		const pop = (x: number, y: number, txt: string, size: number) => {
			const el = document.createElementNS(NS, 'text');
			el.setAttribute('class', size < 14 ? 'rcs__pop rcs__pop--small' : 'rcs__pop');
			el.setAttribute('text-anchor', 'middle');
			el.setAttribute('x', String(x));
			el.setAttribute('font-size', String(size));
			el.textContent = txt;
			gPops.appendChild(el);
			pops.push({ el, age: 0, y0: y });
		};

		const wake = loop(root, (dt) => {
			const target = on ? T_GLOW : T_ROOM;
			T += (target - T) * (1 - Math.exp(-dt / (on ? 1.5 : 2.5)));
			const wt = on && S < 0.5 ? 1 : 0;
			w += (wt - w) * (1 - Math.exp(-dt / 3));
			if (on) {
				tick += dt;
				if (tick >= 1) {
					tick -= 1;
					const qc = I * I * Rc();
					pop(140, 170, `+${ru(qc, qc < 10 ? 1 : 0)} Дж`, 12);
					pop(272, 82, `+${ru(I * I * RS, 0)} Дж`, 15);
				}
			}
			pops = pops.filter((q) => {
				q.age += dt;
				if (q.age > POP_LIFE) {
					q.el.remove();
					return false;
				}
				const f = q.age / POP_LIFE;
				q.el.setAttribute('y', (q.y0 - 26 * f).toFixed(1));
				q.el.style.opacity = (1 - f * f).toFixed(2);
				return true;
			});
			draw();
			return on || T > T_ROOM + 1 || w > 0.005 || pops.length > 0;
		});

		power.addEventListener('click', () => {
			on = !on;
			tick = 0;
			power.textContent = on ? 'Выключить' : 'Включить';
			power.setAttribute('aria-pressed', String(on));
			numbers();
			draw();
			wake();
		});
		for (const b of cordBtns)
			b.addEventListener('click', () => {
				S = Number(b.dataset.cord);
				cordBtns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
				numbers();
				draw();
				wake();
			});
		numbers();
		draw();
	}
</script>
