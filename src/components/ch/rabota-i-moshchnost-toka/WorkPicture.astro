---
/**
 * Picture to the definition of the work of current, A = Uq = UIt.
 * Charge is drawn as beads of 1 Кл (as in VoltagePicture and JoulePicture), moving through a heater spiral in the
 * direction of the current. Each coulomb that passes the middle of the spiral leaves U джоулей in it (a «+4 Дж» pops up).
 * The run lasts t seconds of real time, then the current stops and the result stays. Base: U = 4 В, I = 1 А, t = 5 с,
 * A = 20 Дж. Three toggles double U, I or t (each restarts the run), so the pupil sees that any of them doubles the work:
 * with double U each coulomb leaves twice as much; with double I twice as many coulombs pass each second (the beads move
 * twice as fast, the spacing stays); with double t the same flow lasts twice as long.
 * U and I cannot be chosen independently for one spiral (Ohm's law), so the spiral is made of the same wire with
 * R = U / I = 2, 4 or 8 Ом: its length (number of turns) is proportional to R. The glow grows with the power UI.
 * The counters t, q, A and the live line A = Uq = UIt show the values at the moment of the last coulomb (t = q / I).
 * Runs only while the picture is on screen.
 */
---

<figure class="wkp not-content" data-wkp>
	<div class="wkp__stage">
		<svg class="wkp__svg" viewBox="0 0 360 150" role="img" aria-label="Спираль нагревателя в цепи. Через неё проходят порции заряда по 1 Кл, и каждый кулон оставляет в спирали энергию, равную напряжению на ней">
			<path class="wkp__lead" data-lead-l />
			<path class="wkp__lead" data-lead-r />
			<path class="wkp__glow" data-glow />
			<path class="wkp__coil" data-coil />
			<g data-beads></g>
			<g data-pops></g>
			<path class="wkp__arrow" d="M 14 50 H 62 M 54 45 L 62 50 L 54 55" />
			<text class="wkp__lbl" x="14" y="38"><tspan class="wkp__i">I</tspan> = <tspan data-i-val>1</tspan> А</text>
			<path class="wkp__bracket" data-bracket />
			<text class="wkp__lbl" x="180" y="121" text-anchor="middle"><tspan class="wkp__i wkp__i--u">U</tspan> = <tspan data-u-val>4</tspan> В</text>
			<text class="wkp__lbl wkp__lbl--quiet" x="180" y="143" text-anchor="middle">спираль, <tspan class="wkp__i wkp__i--r">R</tspan> = <tspan data-r-val>4</tspan> Ом</text>
		</svg>
		<dl class="wkp__cnt">
			<div>
				<dt>время&nbsp;<i>t</i></dt>
				<dd data-t>0 с</dd>
			</div>
			<div>
				<dt>прошёл заряд&nbsp;<i>q</i></dt>
				<dd class="wkp__q" data-q>0 Кл</dd>
			</div>
			<div>
				<dt>работа тока&nbsp;<i>A</i></dt>
				<dd class="wkp__a" data-a>0 Дж</dd>
			</div>
		</dl>
		<div class="wkp__formula" data-formula></div>
	</div>

	<div class="wkp__buttons">
		<button type="button" class="wkp__btn" data-dbl="U" aria-pressed="false">Удвоить напряжение</button>
		<button type="button" class="wkp__btn" data-dbl="I" aria-pressed="false">Удвоить силу тока</button>
		<button type="button" class="wkp__btn" data-dbl="t" aria-pressed="false">Удвоить время</button>
		<button type="button" class="wkp__btn wkp__btn--quiet" data-reset>Сначала</button>
	</div>
	<p class="wkp__sum" data-sum></p>
	<p class="wkp__res" data-res aria-live="polite"></p>

	<figcaption class="wkp__legend">
		<span class="wkp__bead" aria-hidden="true"></span> — заряд 1 Кл. Работа тока показывает, сколько электрической энергии ток передал прибору. При
		напряжении 4&nbsp;В каждый кулон оставляет в спирали 4&nbsp;Дж, а за время <i>t</i> проходит заряд <i>q</i> = <i>It</i>.
		Поэтому <i>A</i> = <i>Uq</i> = <i>UIt</i>, и удвоение любой из трёх величин удваивает работу. Чтобы при вдвое
		большем напряжении ток остался прежним, спираль берут вдвое длиннее.
	</figcaption>
</figure>

<style is:global>
	.wkp {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.wkp i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.wkp__stage {
		padding: 0.5rem 0.6rem 0.4rem;
		border-radius: 0.8rem;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-gray-6);
	}
	.wkp__svg {
		display: block;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.wkp__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
	}
	.wkp__coil {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
		stroke-linejoin: round;
	}
	.wkp__glow {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vy) 70%, var(--ig-v));
		stroke-width: 10;
		stroke-linejoin: round;
		filter: blur(3px);
		opacity: 0;
		transition: opacity 0.6s;
	}
	.wkp__b {
		fill: var(--ig-vx);
		stroke: var(--sl-color-white);
		stroke-width: 1;
	}
	.wkp__pop {
		font-size: 14px;
		font-weight: 700;
		fill: color-mix(in oklab, var(--ig-vy) 75%, var(--sl-color-white));
		paint-order: stroke;
		stroke: var(--sl-color-black);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	:root[data-theme='light'] .wkp__pop {
		fill: color-mix(in oklab, var(--ig-vy) 70%, var(--sl-color-black));
	}
	.wkp__arrow {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.wkp__bracket {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 1.4;
	}
	.wkp__lbl {
		font-size: 14px;
		font-weight: 600;
		fill: var(--sl-color-white);
		font-family: var(--__sl-font);
	}
	.wkp__lbl--quiet {
		font-size: 12.5px;
		font-weight: 400;
		fill: var(--sl-color-gray-2);
	}
	.wkp__i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 400;
		fill: var(--ig-vx);
	}
	.wkp__i--u {
		fill: var(--ig-vy);
	}
	.wkp__i--r {
		fill: var(--sl-color-gray-2);
	}
	.wkp [data-hot] {
		fill: var(--sl-color-text-accent);
		font-weight: 800;
	}
	.wkp__cnt {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0.3rem 0 0;
		font-size: var(--sl-text-sm);
		text-align: center;
	}
	.wkp__cnt div {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.wkp__cnt dt {
		color: var(--sl-color-gray-2);
		line-height: 1.25;
	}
	.wkp__cnt dd {
		margin: 0;
		font-weight: 700;
		font-size: var(--sl-text-lg);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--sl-color-white);
	}
	.wkp__cnt .wkp__q {
		color: var(--sl-color-green-high);
	}
	.wkp__cnt .wkp__a {
		color: var(--ig-v);
	}
	.wkp__formula {
		min-height: 4.9em;
		margin-top: 0.4rem;
		padding: 0 0.3rem;
		border-radius: 0.6rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		display: grid;
		place-items: center;
		overflow-x: auto;
	}
	.wkp__formula .katex-display {
		margin: 0.3rem 0;
	}
	.wkp__formula .wkp-u {
		color: var(--ig-vy);
	}
	.wkp__formula .wkp-i {
		color: var(--ig-vx);
	}
	.wkp__formula .wkp-a {
		color: var(--ig-v);
	}
	.wkp__formula .wkp-q {
		color: var(--sl-color-green-high);
	}
	.wkp__buttons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.wkp__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.4rem 0.95rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.wkp__btn:hover {
		border-color: var(--sl-color-accent);
	}
	.wkp__btn[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.wkp__btn--quiet {
		color: var(--sl-color-gray-2);
		border-color: var(--sl-color-gray-5);
	}
	.wkp__sum,
	.wkp__res {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.wkp__res {
		min-height: 1.5em;
		margin-top: 0.2rem;
	}
	.wkp__sum b,
	.wkp__res b {
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.wkp__res .wkp__big {
		color: var(--sl-color-text-accent);
	}
	.wkp__legend {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
	}
	.wkp__bead {
		display: inline-block;
		width: 0.8em;
		height: 0.8em;
		border-radius: 50%;
		vertical-align: -0.05em;
		background: var(--ig-vx);
		border: 1px solid var(--sl-color-white);
	}
</style>

<script>
	import { loop } from '@components/intro/scene';
	import { renderTex, tex, ru } from './rm';

	const NS = 'http://www.w3.org/2000/svg';
	const MID = 180; // the middle of the spiral, svg units
	const Y = 78; // the line of the wire
	const D = 40; // svg units between beads of 1 Кл
	const TURN = 20 / 3; // svg units per turn of the spiral
	const PER_OHM = 20; // length of the spiral per ohm: the same wire, R ∝ length
	const POP_LIFE = 1; // s
	const BASE = { U: 4, I: 1, t: 5 };
	const A0 = BASE.U * BASE.I * BASE.t;
	const times = (n: number) => (n === 8 ? 'в 8 раз' : `в ${n} раза`);

	for (const root of document.querySelectorAll<HTMLElement>('[data-wkp]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const coil = $<SVGPathElement>('[data-coil]');
		const glow = $<SVGPathElement>('[data-glow]');
		const leadL = $<SVGPathElement>('[data-lead-l]');
		const leadR = $<SVGPathElement>('[data-lead-r]');
		const bracket = $<SVGPathElement>('[data-bracket]');
		const uVal = $<SVGTSpanElement>('[data-u-val]');
		const iVal = $<SVGTSpanElement>('[data-i-val]');
		const rVal = $<SVGTSpanElement>('[data-r-val]');
		const tOut = $<HTMLElement>('[data-t]');
		const qOut = $<HTMLElement>('[data-q]');
		const aOut = $<HTMLElement>('[data-a]');
		const formula = $<HTMLElement>('[data-formula]');
		const sum = $<HTMLElement>('[data-sum]');
		const res = $<HTMLElement>('[data-res]');
		const gPops = $<SVGGElement>('[data-pops]');
		const gBeads = $<SVGGElement>('[data-beads]');
		const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-dbl]')];
		const beads = Array.from({ length: 12 }, () => {
			const c = document.createElementNS(NS, 'circle');
			c.setAttribute('r', '6');
			c.setAttribute('cy', String(Y));
			c.setAttribute('class', 'wkp__b');
			gBeads.appendChild(c);
			return c;
		});

		const dbl = { U: false, I: false, t: false };
		let U = BASE.U;
		let I = BASE.I;
		let T = BASE.t;
		let t = 0; // time since the current was switched on
		let shown = -1; // coulombs counted
		let running = true;
		let clock = 0; // for the pops, also after the current stops
		let pops: { el: SVGTextElement; born: number }[] = [];

		const counters = (k: number) => {
			const tk = k / I; // the moment of the k-th coulomb
			tOut.textContent = `${ru(tk, 1)} с`;
			qOut.textContent = `${k} Кл`;
			aOut.textContent = `${U * k} Дж`;
			const u = '\\htmlClass{wkp-u}{U}';
			const i = '\\htmlClass{wkp-i}{I}';
			const a = '\\htmlClass{wkp-a}{A}';
			const q = '\\htmlClass{wkp-q}{q}';
			renderTex(
				formula,
				k
					? `\\begin{aligned} ${a} &= ${u}${q} = ${U}~\\text{В} \\cdot ${k}~\\text{Кл} = ${U * k}~\\text{Дж} \\\\ ${a} &= ${u}${i}t = ${U}~\\text{В} \\cdot ${I}~\\text{А} \\cdot ${tex(tk, 1)}~\\text{с} = ${U * k}~\\text{Дж} \\end{aligned}`
					: `${a} = ${u}${q} = ${u}${i}t`,
			);
		};

		const result = () => {
			const A = U * I * T;
			const n = A / A0;
			res.innerHTML =
				n === 1
					? `Работа тока за ${T} с — <b class="wkp__big">${A} Дж</b>. Удвойте напряжение, силу тока или время и сравните.`
					: `Работа тока за ${T} с — <b class="wkp__big">${A} Дж</b>, ${times(n)} больше, чем при ${BASE.U} В, ${BASE.I} А и ${BASE.t} с (${A0} Дж).`;
		};

		const drawBeads = () => {
			const first = Math.ceil(I * t - (360 - MID + 10) / D);
			beads.forEach((b, n) => {
				const x = MID + D * (I * t - (first + n));
				b.setAttribute('cx', x.toFixed(1));
				b.style.display = x < -10 || x > 370 ? 'none' : '';
			});
		};

		const drawPops = () => {
			pops = pops.filter((p) => {
				const age = clock - p.born;
				if (age > POP_LIFE) {
					p.el.remove();
					return false;
				}
				p.el.setAttribute('y', (Y - 16 - 48 * (age / POP_LIFE)).toFixed(1));
				p.el.style.opacity = (1 - (age / POP_LIFE) ** 2).toFixed(2);
				return true;
			});
		};

		const setup = () => {
			U = BASE.U * (dbl.U ? 2 : 1);
			I = BASE.I * (dbl.I ? 2 : 1);
			T = BASE.t * (dbl.t ? 2 : 1);
			const R = U / I;
			// the spiral: loops that step forward 2·TURN and back TURN, centred on MID
			const n = Math.round((PER_OHM * R) / TURN);
			const x0 = MID - ((n + 1) * TURN) / 2;
			let d = `M ${x0.toFixed(2)} ${Y}`;
			for (let k = 0; k < n; k++) d += ` c 0 -14 ${2 * TURN} -14 ${2 * TURN} 0 c 0 10 ${-TURN} 10 ${-TURN} 0`;
			coil.setAttribute('d', d);
			glow.setAttribute('d', d);
			const x1 = x0 + (n + 1) * TURN;
			leadL.setAttribute('d', `M 0 ${Y} H ${(x0 + 1).toFixed(2)}`);
			leadR.setAttribute('d', `M ${(x0 + n * TURN).toFixed(2)} ${Y} H 360`);
			bracket.setAttribute('d', `M ${x0.toFixed(2)} ${Y + 17} v 7 H ${x1.toFixed(2)} v -7`);
			uVal.textContent = String(U);
			iVal.textContent = String(I);
			rVal.textContent = String(R);
			for (const [el, on] of [
				[uVal, dbl.U],
				[iVal, dbl.I],
			] as const)
				if (on) el.setAttribute('data-hot', '');
				else el.removeAttribute('data-hot');
			sum.innerHTML = `Каждую секунду проходит <b>${I} Кл</b>, каждый кулон оставляет в спирали <b>${U} Дж</b>. Ток идёт <b>${T} с</b>.`;
			res.innerHTML = '';
			t = 0;
			shown = -1;
			pops.forEach((p) => p.el.remove());
			pops = [];
			running = true;
			glow.style.opacity = String(0.15 + (0.75 * U * I) / 16);
			counters(0);
			shown = 0;
			drawBeads();
			wake();
		};

		const wake = loop(root, (dt) => {
			clock += dt;
			if (running) {
				t = Math.min(T, t + dt);
				const k = Math.floor(I * t + 1e-9);
				if (k > shown) {
					for (let j = shown + 1; j <= k; j++) {
						const el = document.createElementNS(NS, 'text');
						el.setAttribute('class', 'wkp__pop');
						el.setAttribute('text-anchor', 'middle');
						el.setAttribute('x', String(MID));
						el.textContent = `+${U} Дж`;
						gPops.appendChild(el);
						pops.push({ el, born: clock });
					}
					shown = k;
					counters(k);
				}
				if (t >= T) {
					running = false;
					glow.style.opacity = '0';
					result();
				}
				drawBeads();
			}
			drawPops();
			return running || pops.length > 0;
		});

		for (const b of toggles) {
			b.addEventListener('click', () => {
				const key = b.dataset.dbl as keyof typeof dbl;
				dbl[key] = !dbl[key];
				b.setAttribute('aria-pressed', String(dbl[key]));
				setup();
			});
		}
		$('[data-reset]').addEventListener('click', setup);
		setup();
	}
</script>
