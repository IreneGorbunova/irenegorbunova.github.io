---
/**
 * Main model: six household appliances with their (rounded, typical) powers. For each one the reader sets
 * how many hours a day it works. The model draws the day's load curve P(t) — the area under it is the energy —
 * runs the electricity meter through the day, and counts energy per day and per month (30 days) in кВт·ч and
 * the payment at the chosen tariff. A click on an appliance shows the calculation A = Pt for it.
 */
import { DEVICES, ICONS, ICON_CSS, type DeviceKey } from './rm';

const KEYS: DeviceKey[] = ['kettle', 'iron', 'inc', 'led', 'tv', 'charger'];
const fmtH = (h: number) => String(h).replace('.', ',');
---

<figure class="rmhome not-content" data-rmhome>
	<div class="rmhome__devs">
		{
			KEYS.map((k) => (
				<div class="rmhome__dev" data-dev={k} style={`--dc: ${DEVICES[k].colour}`}>
					<button type="button" class="rmhome__pick" data-pick aria-pressed={k === 'kettle' ? 'true' : 'false'}>
						<span class="rmhome__icon">
							<svg class="rmi" viewBox="0 0 64 64" aria-hidden="true" set:html={ICONS[k]} />
						</span>
						<span class="rmhome__name">{DEVICES[k].name}</span>
						<span class="rmhome__power">
							<span class="rmhome__dot" />
							{DEVICES[k].P} Вт
						</span>
					</button>
					<label class="rmhome__slider">
						<span class="rmhome__hours">
							<output data-hout>{fmtH(DEVICES[k].hours)}</output> ч в сутки
						</span>
						<input type="range" min="0" max={DEVICES[k].max} step={DEVICES[k].step} value={DEVICES[k].hours} data-h aria-label={`${DEVICES[k].name}: сколько часов в сутки работает`} />
					</label>
				</div>
			))
		}
	</div>

	<div class="rmhome__day">
		<div class="rmhome__dayhead">
			<p class="rmhome__daytitle">Мощность в течение суток</p>
			<button type="button" class="rmhome__btn" data-zoom aria-pressed="false">Масштаб ×10</button>
			<span class="rmhome__clock" data-clock>00:00</span>
			<button type="button" class="rmhome__btn rmhome__btn--primary" data-play>Прожить сутки</button>
		</div>
		<div class="rmhome__graphbox" data-graphbox>
			<svg class="rmhome__graph" data-graph role="img" aria-label="График мощности всех приборов в течение суток"></svg>
		</div>
		<p class="rmhome__hint" data-hint>Площадь под графиком — это энергия, которую приборы потребили за сутки.</p>
	</div>

	<div class="rmhome__row">
		<div class="rmhome__meter" aria-label="Счётчик электроэнергии">
			<svg viewBox="0 0 200 150" class="rmhome__meter-svg" aria-hidden="true">
				<rect class="rmm-case" x="4" y="4" width="192" height="142" rx="10" />
				<text class="rmm-brand" x="18" y="24">СЧЁТЧИК ЭЛЕКТРОЭНЕРГИИ</text>
				<rect class="rmm-lcd" x="18" y="34" width="164" height="42" rx="4" />
				<g data-digits></g>
				<text class="rmm-unit" x="174" y="90" text-anchor="end">кВт·ч</text>
				<circle class="rmm-led" cx="30" cy="112" r="5" data-led />
				<text class="rmm-small" x="42" y="116">импульсы</text>
				<text class="rmm-small" x="182" y="116" text-anchor="end">220 В, 50 Гц</text>
				<rect class="rmm-term" x="40" y="128" width="120" height="12" rx="3" />
			</svg>
			<p class="rmhome__meter-cap">В начале суток счётчик показывал 1250,0 кВт·ч. Красная цифра — десятые доли киловатт-часа.</p>
		</div>
		<div class="rmhome__sum">
			<dl>
				<div><dt>Энергия за сутки</dt><dd data-day>—</dd></div>
				<div><dt>За месяц (30 дней)</dt><dd data-month>—</dd></div>
				<div>
					<dt>Тариф, ₽ за 1 кВт·ч</dt>
					<dd><input class="rmhome__tariff" type="number" min="1" max="30" step="0.1" value="7" data-tariff aria-label="Тариф: рублей за один киловатт-час" /></dd>
				</div>
				<div class="rmhome__pay"><dt>Плата за месяц</dt><dd data-pay>—</dd></div>
			</dl>
		</div>
	</div>

	<div class="rmhome__bars" data-bars>
		<p class="rmhome__barstitle">Кто сколько «съедает» за месяц</p>
		{
			KEYS.map((k) => (
				<div class="rmhome__bar" data-bar={k} style={`--dc: ${DEVICES[k].colour}`}>
					<span class="rmhome__barname">{DEVICES[k].name}</span>
					<span class="rmhome__bartrack"><span class="rmhome__barfill" data-fill /></span>
					<span class="rmhome__barval" data-val />
				</div>
			))
		}
	</div>

	<div class="rmhome__panel">
		<p class="rmhome__ptitle" data-ptitle></p>
		<div class="rmhome__math" data-math1></div>
		<div class="rmhome__math" data-math2></div>
	</div>
	<p class="rmhome__live" data-live aria-live="polite"></p>

	<figcaption class="rmhome__caption">
		Мощности приборов — типичные округлённые значения; точное значение написано на самом приборе или в его паспорте. Месяц
		считаем равным 30 дням. Тариф в вашем городе может быть другим — его пишут в квитанции за электроэнергию. В режиме
		«Прожить сутки» часы идут медленнее, пока работает чайник или утюг, — иначе их короткую работу не было бы видно.
	</figcaption>
</figure>

<style is:global set:html={ICON_CSS}></style>

