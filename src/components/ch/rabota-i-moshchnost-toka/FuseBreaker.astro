</style>

<script>
	import { glow } from './rm';

	const IN = 16; // А, both are rated 16 А
	const SPEED = 10; // the model clock runs 10 times faster while the current heats the protection
	const FUSE = { k: 0.5, tau: 100 }; // плавкая вставка
	const BM = { k: 0.6, tau: 74 }; // биметаллическая пластинка
	const T_MELT = 1085; // °C, copper
	const MAG_FROM = 3 * IN; // the electromagnet trips a B breaker from 3–5 Iн; take the lower bound for «at once»
	const BEND = 15.6; // px of bend of the strip's top at θ = 1
	const GAP = 11; // px between the strip's top and the latch when cold
	const ARM_LATCH = 48; // px from the latch pivot to where the strip touches it
	const REL = 5.5; // degrees: the latch lets the arm go
	const MAG_DEG = 12;
	const ru = (v: number) => String(Math.round(v));

	for (const root of document.querySelectorAll<HTMLElement>('[data-fbr]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const curBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-i]'));
		const stFuse = $<HTMLElement>('[data-st="fuse"]');
		const stBrk = $<HTMLElement>('[data-st="brk"]');
		const resetFuse = $<HTMLButtonElement>('[data-reset="fuse"]');
		const resetBrk = $<HTMLButtonElement>('[data-reset="brk"]');
		const fw = $<SVGPathElement>('[data-fw]');
		const fwGlow = $<SVGPathElement>('[data-fwglow]');
		const flash = $<SVGCircleElement>('[data-flash]');
		const bm = Array.from(root.querySelectorAll<SVGPathElement>('[data-bm]'));
		const latch = $<SVGGElement>('[data-latch]');
		const spring = $<SVGPathElement>('[data-spring]');
		const braid = $<SVGPathElement>('[data-braid]');
		const flowsFuse = Array.from(root.querySelectorAll<SVGPathElement>('[data-flow="fuse"]'));
		const flowsBrk = Array.from(root.querySelectorAll<SVGPathElement>('[data-flow="brk"]'));

		let I = 10; // chosen current, А
		// fuse
		let fuseOk = true;
		let thF = 0; // heat of the fusible wire, 1 = melts
		let tF = 0; // model seconds of the present overload
		// breaker
		let brkOn = true;
		let thB = 0; // heat of the strip, 1 = pushes the latch off
		let tB = 0;
		let mag = 0; // pull of the electromagnet on the latch, 0…1
		let armDeg = 0; // shown angle of the arm, for the spring
		let hotRetrip = false;
		let raf = 0;
		let last = 0;
		let dash = 0;

		const iFuse = () => (fuseOk ? I : 0);
		const iBrk = () => (brkOn ? I : 0);

		const put = (el: HTMLElement, html: string) => {
			if (el.dataset.html !== html) {
				el.dataset.html = html;
				el.innerHTML = html;
			}
		};
		const text = () => {
			// fuse
			if (!fuseOk) {
				/* the message written when it melted stays */
			} else if (I === 440) put(stFuse, `<b>Ток 440 А!</b> Проволочка раскаляется…`);
			else if (I > IN) put(stFuse, `<b>Ток 32 А</b>&nbsp;— вдвое больше 16 А. Проволочка нагревается… Прошло ${ru(tF)} с.`);
			else put(stFuse, `Ток 10 А меньше 16 А. Проволочка чуть тёплая, цепь замкнута.`);
			// breaker
			if (!brkOn) {
				/* the message written when it tripped stays */
			} else if (I === 440) put(stBrk, `<b>Ток 440 А!</b>`);
			else if (I > IN)
				put(stBrk, `<b>Ток 32 А.</b> Пластинка нагревается и медленно изгибается… Прошло ${ru(tB)} с. Электромагниту такого тока мало.`);
			else put(stBrk, `Ток 10 А меньше 16 А. Пластинка слегка тёплая и почти не изгибается.`);
		};

		const drawStatic = () => {
			root.dataset.current = String(I);
			root.dataset.fuse = fuseOk ? 'ok' : 'melted';
			root.dataset.brk = brkOn ? 'on' : 'off';
			resetFuse.disabled = fuseOk;
			resetBrk.disabled = brkOn;
			root.classList.toggle('is-flow-fuse', iFuse() > 0);
			root.classList.toggle('is-flow-brk', iBrk() > 0);
			curBtns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.i) === I)));
		};

		const drawHeat = () => {
			// fusible wire: invisible below about 500 °C, then dark red → orange → yellow
			const g = glow(20 + Math.min(1, thF) * (T_MELT - 20));
			fwGlow.style.stroke = g.colour;
			fwGlow.style.opacity = String(g.a);
			fw.style.stroke = g.a > 0 ? g.colour : '';
			// bimetallic strip: bends to the right and warms in colour
			const th = Math.min(1, thB);
			const d = BEND * th;
			bm[0].setAttribute('d', `M 202 176 Q 202 ${136 - d} ${(202 + d).toFixed(2)} 102`);
			bm[1].setAttribute('d', `M 206 176 Q 206 ${136 - d} ${(206 + d).toFixed(2)} 102`);
			const hot = `color-mix(in srgb, var(--ig-vy) ${Math.round(th * 85)}%, `;
			bm[0].style.stroke = `${hot}color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-3)))`;
			bm[1].style.stroke = `${hot}var(--sl-color-gray-2))`;
			braid.setAttribute('d', `M 194 82 C 194 94 ${(204 + d).toFixed(2)} 90 ${(204 + d).toFixed(2)} 102`);
			// the latch: pushed by the strip or pulled by the magnet
			const push = Math.max(0, (d - GAP) / ARM_LATCH);
			const deg = Math.max((Math.asin(Math.min(1, push)) * 180) / Math.PI, mag * MAG_DEG);
			latch.setAttribute('transform', `rotate(${deg.toFixed(2)} 220 150)`);
		};

		const drawSpring = () => {
			// a tension spring from the housing (y = 30) to the arm at x = 166; the arm turns about (124, 72)
			const yb = 72 - 42 * Math.sin((armDeg * Math.PI) / 180);
			const n = 7;
			const h = (yb - 34) / n;
			let s = `M 166 30 V 34`;
			for (let i = 0; i < n; i++) s += ` l ${i % 2 ? -5 : 5} ${(h / 2).toFixed(2)} l ${i % 2 ? 5 : -5} ${(h / 2).toFixed(2)}`;
			spring.setAttribute('d', s + ` V ${(yb - 2).toFixed(2)}`);
		};

		const meltFuse = (why: 'over' | 'sc') => {
			fuseOk = false;
			thF = 1;
			put(
				stFuse,
				why === 'sc'
					? `<b>Проволочка расплавилась</b> почти мгновенно и разорвала цепь. Пока замыкание не устранено, новая пробка тоже сгорит.`
					: `<b>Через ${ru(tF)} с проволочка расплавилась</b> и разорвала цепь. Нужна новая пробка.`,
			);
			flash.classList.remove('is-on');
			void flash.getBoundingClientRect();
			flash.classList.add('is-on');
			drawStatic();
		};
		const tripBrk = (why: 'over' | 'sc') => {
			brkOn = false;
			put(
				stBrk,
				why === 'sc'
					? `<b>Электромагнит сразу притянул защёлку</b>&nbsp;— автомат отключился за сотые доли секунды. Пластинка даже не успела нагреться.`
					: hotRetrip
						? `<b>Пластинка ещё не остыла</b>&nbsp;— автомат быстро отключился снова. Дайте ей остыть и уменьшите ток.`
						: `<b>Через ${ru(tB)} с пластинка изогнулась</b> и оттолкнула защёлку. Пружина разомкнула контакты.`,
			);
			hotRetrip = false;
			drawStatic();
		};

		const frame = (now: number) => {
			const dt = Math.max(0, Math.min(0.1, (now - last) / 1000));
			last = now;
			const sdt = dt * SPEED;
			// fuse
			const iF = iFuse();
			if (fuseOk && iF >= 100) {
				thF += dt / 0.35; // in reality hundredths of a second
				if (thF >= 1) meltFuse('sc');
			} else {
				const target = FUSE.k * (iF / IN) ** 2;
				thF = target + (thF - target) * Math.exp(-sdt / FUSE.tau);
				tF = iF > IN ? tF + sdt : 0;
				if (fuseOk && thF >= 1) meltFuse('over');
			}
			// breaker
			const iB = iBrk();
			if (iB >= MAG_FROM) {
				mag = Math.min(1, mag + dt / 0.12); // in reality hundredths of a second
			} else {
				mag = Math.max(0, mag - dt / 0.3);
				const target = BM.k * (iB / IN) ** 2;
				thB = target + (thB - target) * Math.exp(-sdt / BM.tau);
				tB = iB > IN ? tB + sdt : 0;
			}
			root.classList.toggle('is-magnet', iB >= MAG_FROM || mag > 0.5);
			drawHeat();
			// the latch lets the arm go when the strip has bent fully (θ = 1) or the magnet has pulled it past REL
			if (brkOn && (mag * MAG_DEG >= REL || thB >= 1)) tripBrk(mag * MAG_DEG >= REL ? 'sc' : 'over');
			const want = brkOn ? 0 : -14;
			armDeg += (want - armDeg) * Math.min(1, dt * 18);
			drawSpring();
			// current along the wires
			const speed = (i: number) => (i >= 100 ? 260 : 6 + 1.6 * i);
			dash -= dt;
			flowsFuse.forEach((f) => (f.style.strokeDashoffset = String(dash * speed(iF))));
			flowsBrk.forEach((f) => (f.style.strokeDashoffset = String(dash * speed(iB))));
			text();
			raf = requestAnimationFrame(frame);
		};

		curBtns.forEach((b) =>
			b.addEventListener('click', () => {
				I = Number(b.dataset.i);
				hotRetrip = false;
				tF = 0;
				tB = 0;
				drawStatic();
				text();
			}),
		);
		resetFuse.addEventListener('click', () => {
			fuseOk = true;
			thF = 0;
			tF = 0;
			drawStatic();
			text();
		});
		resetBrk.addEventListener('click', () => {
			brkOn = true;
			tB = 0;
			// a strip that is still hot keeps the latch off: the breaker trips again at once
			hotRetrip = I > IN && I < MAG_FROM && thB > 0.8;
			drawStatic();
			text();
		});

		drawStatic();
		drawHeat();
		drawSpring();
		text();
		new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (e.isIntersecting && !raf) {
					last = performance.now();
					raf = requestAnimationFrame(frame);
				} else if (!e.isIntersecting && raf) {
					cancelAnimationFrame(raf);
					raf = 0;
				}
			}
		}).observe(root);
	}
</script>
