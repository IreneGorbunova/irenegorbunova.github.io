---
/**
 * «Как защита разрывает цепь»: two labelled cutaway schemes side by side, both rated 16 А, with one control for the
 * current through them: норма 10 А, перегрузка 32 А, короткое замыкание 440 А (220 В / 0,5 Ом, as in the chapter).
 * - Plug fuse («пробка»): porcelain body, screw thread, bottom contact, a thin fusible wire (плавкая вставка) inside.
 *   It heats as dθ/dt = (0,5·(I/Iн)² − θ)/τ, τ = 100 с, and melts at θ = 1: below 1,41·Iн never (a gG 16 А link must
 *   carry 1,25·Iн = 20 А for an hour), at 2·Iн after 69 с (it must melt at 1,6·Iн within an hour; IEC 60269-1,
 *   conventional currents 1,25 / 1,6 Iн, 1 h for In ≤ 63 А). At 440 А it melts at once (in reality in hundredths of
 *   a second or faster; shown in 0,35 с).
 * - Circuit breaker («автомат», characteristic B16): current path terminal → moving contact arm → contacts → braid →
 *   bimetallic strip → electromagnet coil → terminal. A spring pulls the arm open; a steel latch holds it closed.
 *   Thermal release: the strip heats as dθ/dt = (0,6·(I/Iн)² − θ)/τ, τ = 74 с, bends towards the latch and pushes it
 *   off at θ = 1: below 1,29·Iн never, at 2·Iн after 40 с (IEC 60898-1, B curve: 1,13·Iн no trip for 1 h, 1,45·Iн trip
 *   within 1 h, 2,55·Iн trip in 1–60 с). Electromagnetic release: from 3–5·Iн (48–80 А) the coil pulls the latch at
 *   once (< 0,1 с at 5·Iн); 32 А is too little, 440 А trips it in hundredths of a second (shown in 0,12 с), before the
 *   strip warms. The model clock runs 10 times faster than real time while the current heats the protection.
 * The model runs only while it is on screen.
 */
const thread = (() => {
	let d = 'M 76 66 H 124';
	for (let y = 66; y < 136; y += 10) d += ` l 4 5 l -4 5`;
	d += ' H 76';
	for (let y = 136; y > 66; y -= 10) d += ` l -4 -5 l 4 -5`;
	return d + ' Z';
})();
const threadLines = Array.from({ length: 7 }, (_, i) => `M 76 ${71 + i * 10} L 124 ${76 + i * 10}`).join(' ');
const coil = Array.from({ length: 7 }, (_, i) => `<ellipse cx="${238 + i * 4}" cy="110" rx="2.2" ry="10"/>`).join('');
const CURRENTS = [
	{ I: 10, label: 'Норма', tag: '10 А' },
	{ I: 32, label: 'Перегрузка', tag: '32 А' },
	{ I: 440, label: 'Короткое замыкание', tag: '440 А' },
];
---

<figure class="fb not-content" data-fbr data-fuse="ok" data-brk="on" data-current="10">
	<p class="fb__title">Как защита разрывает цепь</p>
	<div class="fb__seg" role="group" aria-label="Сила тока в цепи">
		{
			CURRENTS.map((c, i) => (
				<button type="button" class={i === 2 ? 'is-danger' : ''} data-i={c.I} aria-pressed={i === 0 ? 'true' : 'false'}>
					{c.label}: <b class="fb__nw">{c.tag}</b>
				</button>
			))
		}
	</div>
	<div class="fb__panels">
		<div class="fb__panel">
			<p class="fb__name">Плавкий предохранитель («пробка»)</p>
			<svg class="fb__svg" viewBox="0 0 260 214" role="img" aria-label="Пробка в разрезе: фарфоровый корпус, резьба, контакт внизу, внутри тонкая проволочка — плавкая вставка">
				<path class="fb-wire" d="M 4 200 H 100 V 156"></path>
				<path class="fb-wire" d="M 126 116 H 256"></path>
				<path class="fb-flow" d="M 4 200 H 100 V 157" data-flow="fuse"></path>
				<path class="fb-flow" d="M 126 116 H 256" data-flow="fuse"></path>
				<rect class="fb-porc" x="62" y="16" width="76" height="50" rx="9"></rect>
				<path class="fb-rib" d="M 72 24 V 58 M 84 24 V 58 M 116 24 V 58 M 128 24 V 58"></path>
				<path class="fb-metal" d={thread}></path>
				<path class="fb-thread" d={threadLines}></path>
				<rect class="fb-porc" x="86" y="136" width="28" height="12" rx="2"></rect>
				<rect class="fb-metal" x="92" y="148" width="16" height="8" rx="2"></rect>
				<rect class="fb-window" x="93" y="26" width="14" height="118" rx="3"></rect>
				<path class="fb-strip" d="M 100 30 H 118 V 72"></path>
				<path class="fb-fw" d="M 100 148 V 30" data-fw></path>
				<path class="fb-fwglow" d="M 100 146 V 32" data-fwglow></path>
				<g class="fb-broken">
					<path d="M 100 148 V 100 M 100 30 V 78"></path>
					<circle cx="100" cy="98" r="2.6"></circle>
					<circle cx="100" cy="80" r="2.6"></circle>
				</g>
				<circle class="fb-flash" cx="100" cy="89" r="14" data-flash></circle>
				<g class="fb-lab">
					<path d="M 150 28 H 140 M 150 70 L 103 92 M 60 100 H 76 M 60 160 H 92"></path>
					<text x="154" y="26">фарфоровый</text>
					<text x="154" y="40">корпус</text>
					<text x="154" y="68">плавкая</text>
					<text x="154" y="82">вставка</text>
					<text x="56" y="104" text-anchor="end">резьба</text>
					<text x="56" y="164" text-anchor="end">контакт</text>
					<text class="fb-net" x="6" y="192">от сети</text>
					<text class="fb-net" x="256" y="134" text-anchor="end">к приборам</text>
				</g>
			</svg>
			<p class="fb__status" aria-live="polite" data-st="fuse"></p>
			<button type="button" class="fb__btn" data-reset="fuse" disabled>Ввернуть новую пробку</button>
		</div>
		<div class="fb__panel">
			<p class="fb__name">Автоматический выключатель («автомат»)</p>
			<svg class="fb__svg fb__svg--brk" viewBox="0 0 360 228" role="img" aria-label="Автомат в разрезе: рычаг, пружина, подвижный и неподвижный контакты, биметаллическая пластинка, стальная защёлка и электромагнит — катушка с сердечником">
				<rect class="fb-case" x="100" y="26" width="178" height="172" rx="8"></rect>
				<path class="fb-wire" d="M 118 0 V 66 Q 118 72 124 72"></path>
				<path class="fb-wire" d="M 204 180 V 188 H 240 V 120"></path>
				<path class="fb-wire" d="M 262 120 Q 266 124 266 134 V 228"></path>
				<path class="fb-flow" d="M 118 0 V 66 Q 118 72 124 72" data-flow="brk"></path>
				<path class="fb-flow" d="M 266 134 V 228" data-flow="brk"></path>
				<rect class="fb-slot" x="138" y="22" width="16" height="8" rx="2"></rect>
				<g data-handle><rect class="fb-handle" x="141" y="2" width="10" height="26" rx="3"></rect></g>
				<path class="fb-spring" d="" data-spring></path>
				<!-- fixed contact and the braid to the strip -->
				<rect class="fb-contact" x="188" y="78" width="12" height="4" rx="1"></rect>
				<path class="fb-braid" d="" data-braid></path>
				<!-- moving contact arm, pivot at (124, 72) -->
				<g data-arm>
					<path class="fb-arm" d="M 124 72 H 212"></path>
					<rect class="fb-contact" x="188" y="74" width="12" height="4" rx="1"></rect>
				</g>
				<circle class="fb-pivot" cx="124" cy="72" r="3.5"></circle>
				<!-- bimetallic strip: the left layer expands more, so a hot strip bends to the right -->
				<path class="fb-bm fb-bm--a" d="" data-bm="0"></path>
				<path class="fb-bm fb-bm--b" d="" data-bm="1"></path>
				<rect class="fb-anchor" x="196" y="174" width="16" height="8" rx="1.5"></rect>
				<!-- steel latch, pivot at (220, 150), its hook holds the arm down -->
				<g data-latch><path class="fb-latch" d="M 220 150 V 62 H 206 V 68"></path></g>
				<circle class="fb-pivot" cx="220" cy="150" r="3.5"></circle>
				<!-- electromagnet: coil on a steel core -->
				<rect class="fb-core" x="232" y="106" width="34" height="8" rx="1.5"></rect>
				<g class="fb-coil" data-coil set:html={coil}></g>
				<g class="fb-lab">
					<path d="M 280 16 H 154 M 280 62 H 224 M 278 96 L 266 104 M 96 42 H 162 M 96 92 L 186 80 M 96 140 H 200"></path>
					<text x="284" y="20">рычаг</text>
					<text x="284" y="66">защёлка</text>
					<text x="282" y="90">электро-</text>
					<text x="282" y="106">магнит</text>
					<text x="94" y="46" text-anchor="end">пружина</text>
					<text x="94" y="96" text-anchor="end">контакты</text>
					<text x="94" y="134" text-anchor="end">биметал-</text>
					<text x="94" y="150" text-anchor="end">лическая</text>
					<text x="94" y="166" text-anchor="end">пластинка</text>
					<text class="fb-net" x="112" y="12" text-anchor="end">вход</text>
					<text class="fb-net" x="260" y="222" text-anchor="end">выход</text>
				</g>
			</svg>
			<p class="fb__status" aria-live="polite" data-st="brk"></p>
			<button type="button" class="fb__btn" data-reset="brk" disabled>Включить автомат</button>
		</div>
	</div>
	<div class="fb__text">
		<p>Плавкая вставка&nbsp;— тонкая проволочка: при опасном токе она раскаляется, плавится и разрывает цепь. Перегоревшую пробку заменяют новой.</p>
		<p>
			В автомате два «сторожа». <b>Биметаллическая пластинка</b> спаяна из двух металлов, которые при нагревании удлиняются по-разному, поэтому
			горячая пластинка изгибается. При перегрузке она нагревается медленно и через некоторое время отталкивает защёлку. При коротком
			замыкании огромный ток превращает катушку в сильный <b>электромагнит</b>, и он сразу притягивает стальную защёлку. Освобождённый
			подвижный контакт пружина отводит вверх&nbsp;— цепь разомкнута.
		</p>
	</div>
	<figcaption class="fb__cap">
		Пробка и автомат рассчитаны на 16&nbsp;А. При перегрузке вдвое защита срабатывает не сразу: через десятки секунд или минуты, у разных
		предохранителей по-разному. Пока ток нагревает защиту, часы модели идут в&nbsp;10&nbsp;раз быстрее. Электромагнит автомата срабатывает, когда
		ток больше 16&nbsp;А в&nbsp;3–5&nbsp;раз и сильнее.
	</figcaption>
</figure>

<style is:global>
	.fb {
		--fb-metal: color-mix(in srgb, var(--sl-color-gray-3) 70%, var(--ig-v));
		--fb-porc: color-mix(in srgb, var(--sl-color-gray-5) 55%, var(--sl-color-gray-4));
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	:root[data-theme='light'] .fb {
		--fb-porc: color-mix(in srgb, var(--sl-color-gray-6) 40%, var(--ig-surface));
