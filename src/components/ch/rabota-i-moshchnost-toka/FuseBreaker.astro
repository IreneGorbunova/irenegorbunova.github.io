		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
		transition:
			background-color 0.25s,
			border-color 0.25s;
	}
	.fb__seg button:hover {
		border-color: var(--sl-color-accent);
	}
