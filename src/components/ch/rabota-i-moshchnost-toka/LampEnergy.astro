---
/**
 * «Куда уходит энергия лампы»: an incandescent lamp (60 Вт) and an LED lamp (9 Вт) that give the same light, side by
 * side, in the style of EnergyFlow (teplovye-dvigateli). Each lamp gets 100 cells of 1 Дж from the mains: they run
 * along the cord, turn into light or heat where the lamp makes them (the filament / the LED chips), leave through the
 * real exits (light out of the bulb, heat through the bulb and through the base or the housing) along streams whose
 * width is proportional to the share, and settle into two countable piles under each lamp, «Свет» and «Тепло»
 * (rows of 10). The flow starts by itself the first time the picture is on screen, pauses while it is off screen,
 * and runs again on «Ещё раз». Shares and their sources: lampFlow.ts.
 */
import { LAMPS, LAMP_IDS, BLOCK, CELL, PITCH, K, HOP, VIEW_W, VIEW_H } from './lampFlow';

const ROWS = [3, 10]; // reserved rows of 10 in the light and the heat piles, the same under both lamps
const PILE_NAMES = ['Свет', 'Тепло'];

const lamps = LAMP_IDS.map((id) => {
	const L = LAMPS[id];
	const streams = L.segs
		.map((g, i) => {
			const w = Math.max(1.4, K * g.bands.reduce((a, b) => a + L.s[b], 0));
			const k = g.bands.length > 1 ? 'e' : g.bands[0] === 0 ? '0' : '1';
			return `<path class="le-s le-k${k}" data-seg="${i}" stroke-width="${w.toFixed(2)}" d="${g.d}"/>`;
		})
		.join('');
	const tags = L.tags.map((t) => `<text class="le-tag le-minor" x="${t.x}" y="${t.y}" text-anchor="${t.a ?? 'middle'}">${t.t}</text>`).join('');
	let cells = '';
	for (let i = 0; i < 10; i++)
		for (let j = 0; j < 10; j++)
			cells += `<rect class="le-cell" x="${BLOCK[0] + j * PITCH}" y="${BLOCK[1] + i * PITCH}" width="${CELL}" height="${CELL}" rx="1.5"/>`;
	const svg =
		`<g class="le-m">${L.art}<path class="le-hop" data-hop d="${HOP}"/>${streams}${L.top}${tags}</g>` +
		`<g class="le-blk"><text class="le-blab" x="${BLOCK[0]}" y="14">из сети</text>` +
		`<text class="le-bval" x="${BLOCK[0]}" y="31">100 Дж</text>${cells}</g>`;
	const counts = [L.s[0], L.s[1] + L.s[2]];
	const piles = counts.map((n, p) =>
		Array.from({ length: n }, (_, k) => {
			const r = Math.floor(k / 10); // from the bottom
			const c = k % 10;
			// an empty thin column after five cells and an empty thin row between the lower and the upper fifty
			const row = ROWS[p] - r + (ROWS[p] > 5 && r < 5 ? 1 : 0);
			return { cls: 'le__cell', style: `grid-row:${row};grid-column:${c + 1 + (c >= 5 ? 1 : 0)}` };
		}),
	);
	return { id, L, svg, piles, counts };
});
---

<figure class="le not-content" data-le>
	<p class="le__title">Куда уходит энергия лампы</p>
	<div class="le__stage" data-stage>
		<div class="le__cols">
			{
				lamps.map(({ id, L, svg, piles }) => (
					<div class="le__col" data-lamp={id}>
						<p class="le__name">
							{L.name}, <span class="le__nw">{L.P} Вт</span>
						</p>
						<svg class="le__svg" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role="img" aria-label={L.label} data-svg set:html={svg} />
						{piles.map((cells, p) => (
							<div class={`le__pile le-p${p}`} data-pile={p}>
								<p class="le__pname">
									{PILE_NAMES[p]} <b class="le__pval" data-val></b>
								</p>
								<div class="le__cells" style={ROWS[p] > 5 ? `grid-template-rows:repeat(${ROWS[p] - 5}, var(--le-cell)) 0 repeat(5, var(--le-cell))` : `grid-template-rows:repeat(${ROWS[p]}, var(--le-cell))`}>
									{cells.map((c) => (
										<span class={c.cls} style={c.style} data-slot></span>
									))}
								</div>
							</div>
						))}
					</div>
				))
			}
		</div>
		<div class="le__fly" aria-hidden="true" data-fly></div>
	</div>
	<div class="le__ctl">
		<button type="button" class="le__run" data-run>Включить лампы</button>
		<span class="le__unit"><span class="le__unit-cell" aria-hidden="true"></span>одна клетка&nbsp;— 1&nbsp;Дж</span>
	</div>
	<div class="le__text">
		<p>
			Из каждых 100&nbsp;Дж электрической энергии лампа накаливания превращает в&nbsp;свет примерно <b>5&nbsp;Дж</b>, а светодиодная&nbsp;—
			примерно <b>30&nbsp;Дж</b>. Остальное становится теплом.
		</p>
		<p>
			Светят обе лампы одинаково: каждую секунду каждая излучает около 3&nbsp;Дж света (5&nbsp;% от 60&nbsp;Дж и 30&nbsp;% от 9&nbsp;Дж). Но
			лампе накаливания для этого нужна мощность <b>60&nbsp;Вт</b>, а светодиодной&nbsp;— <b>9&nbsp;Вт</b>, почти в&nbsp;7&nbsp;раз меньше. Во
			столько же раз меньше она расходует электроэнергии: за 1000&nbsp;часов работы&nbsp;— 9&nbsp;кВт·ч вместо 60&nbsp;кВт·ч.
		</p>
	</div>
	<figcaption class="le__cap">
		Доли примерные. Светом здесь считается только видимое излучение. У&nbsp;лампы накаливания тепло уходит в&nbsp;основном через колбу:
		невидимым тепловым излучением и с&nbsp;нагретым газом. У&nbsp;светодиодной&nbsp;— через корпус между цоколем и&nbsp;колпаком, поэтому он
		заметно нагревается.
	</figcaption>
</figure>

