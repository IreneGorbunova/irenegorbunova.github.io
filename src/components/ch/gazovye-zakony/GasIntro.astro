---
/**
 * Two short looping opening scenes of «Газовые законы». No terms of the chapter in the pictures; the captions'
 * popovers explain.
 * Bottle: an empty 0,5 l bottle with a slack rubber balloon on its neck stands in a basin; a kettle pours hot water
 *   (80 °C) into the basin. The air in the bottle warms from 20 to 80 °C at constant (atmospheric) pressure, its
 *   volume grows as T: V = 0,5 l · T/293 K, so 0,10 l goes into the balloon. The balloon is drawn to the scale of the
 *   bottle (the body is a cylinder of radius 28 px and height 100 px plus the shoulders: 266 000 px³ = 0,5 l), so at
 *   the end it is a sphere of radius about 24 px. Molecules (dots) move faster as √T; 3 of the 16 end in the balloon.
 * Syringe: a 20 ml syringe, its nozzle closed by a finger; a thumb pushes the plunger slowly from 20 to 10 ml (scale 7 px per ml; the rod is longer than the barrel, as in a real syringe). The
 *   temperature stays the same, so the dots keep their speed and get twice as dense; the pressure p = 100 кПа ·
 *   20 мл / V (Boyle–Mariotte) and the arrows of the air on the plunger grow twice.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const mArrow = `gi-ar-${uid}`;

// Bottle scene: the basin (trapezoid) and the bottle.
const BT = 138; // rim of the basin
const BB = 198; // inner bottom of the basin
const basinX = (y: number) => [92 + (16 * (y - BT)) / (BB - BT), 268 - (16 * (y - BT)) / (BB - BT)];
const [bl0, br0] = basinX(BT);
const [bl1, br1] = basinX(BB);
const BOTTLE = 'M152 190 Q152 196 158 196 L202 196 Q208 196 208 190 L208 100 Q208 84 188 76 L188 58 L172 58 L172 76 Q152 84 152 100 Z';

// Syringe scene: 0 ml at x = 66, 10 px per ml.
const X0 = 66;
const KML = 7;
const ticks = Array.from({ length: 21 }, (_, i) => i);
---

<IntroFrame data-gasintro>
	<div class="intro__card" data-scene="bottle">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Пустая бутылка с воздушным шариком на горлышке стоит в тазике. В тазик наливают горячую воду, воздух в бутылке нагревается и расширяется, и шарик надувается">
			<rect class="gi-wall" x="0" y="0" width="360" height="200"></rect>
			<rect class="gi-table" x="0" y="200" width="360" height="40"></rect>
			<line class="gi-edge" x1="0" y1="200" x2="360" y2="200"></line>
			<!-- hot water in the basin and its steam -->
			<path class="gi-water" data-water></path>
			<g class="gi-steam" data-steam>
				<path d="M112 128 q -6 -10 0 -20 t 0 -20"></path>
				<path d="M236 128 q 6 -10 0 -20 t 0 -20"></path>
				<path d="M254 124 q -6 -10 0 -20 t 0 -20"></path>
			</g>
			<!-- the air in the bottle and in the balloon -->
			<g data-dots></g>
			<path class="gi-bottle" d={BOTTLE}></path>
			<!-- the balloon on the neck -->
			<path class="gi-balloon" data-limp d="M171 54 Q164 46 157 52 Q149 61 153 74 Q157 84 164 78 Q169 70 172 60 Z"></path>
			<ellipse class="gi-balloon" data-gballoon cx="180" cy="48" rx="0" ry="0"></ellipse>
			<path class="gi-shine" data-bshine></path>
			<rect class="gi-sleeve" x="169" y="50" width="22" height="12" rx="3"></rect>
			<!-- the basin -->
			<path class="gi-basin" d={`M${bl0 - 4} ${BT} L${bl1} ${BB + 2} Q${bl1} ${BB + 4} ${bl1 + 4} ${BB + 4} L${br1 - 4} ${BB + 4} Q${br1} ${BB + 4} ${br1} ${BB + 2} L${br0 + 4} ${BT}`}></path>
			<!-- the kettle (rotated by the script about 310, 70) and its stream -->
			<path class="gi-stream" data-stream></path>
			<g data-kettle>
				<path class="gi-kettle" d="M290 58 L268 50 L266 54 L288 66 Z"></path>
				<path class="gi-kettle" d="M286 94 L292 52 Q310 40 328 52 L334 94 Q310 100 286 94 Z"></path>
				<circle class="gi-kettle" cx="310" cy="44" r="4"></circle>
				<path class="gi-handle" d="M330 56 Q352 66 333 88"></path>
			</g>
			<!-- the temperature of the air in the bottle -->
			<rect class="gi-pill" x="8" y="8" width="140" height="24" rx="12"></rect>
			<text class="gi-read" x="78" y="25" text-anchor="middle" data-temp>в бутылке 20 °C</text>
			<text class="gi-label" x="8" y="182" data-wlabel>вода 80 °C</text>
		</svg>
		<div class="intro__foot">
			<p>Пустую бутылку с воздушным шариком на горлышке поставили в горячую воду — и шарик <More term="надулся сам">Воздух в бутылке нагрелся от 20 до 80&nbsp;°C и расширился. Давление в нём осталось почти таким же, как снаружи, а объём вырос примерно на пятую часть: из бутылки объёмом 0,5&nbsp;л в шарик перешло около 0,1&nbsp;л воздуха. Подробнее — в разделе <a href="#закон-гей-люссака">«Закон Гей-Люссака»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="syringe">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Шприц, носик которого зажат пальцем. Большой палец медленно вдвигает поршень с 20 до 10 мл. Молекул воздуха в каждом кубическом сантиметре становится вдвое больше, и воздух давит на поршень вдвое сильнее">
			<defs>
				<marker id={mArrow} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
					<path class="gi-head" d="M0 0 L10 5 L0 10 z"></path>
				</marker>
			</defs>
			<rect class="gi-wall" x="0" y="0" width="360" height="240"></rect>
			<!-- the scale in ml -->
			<g class="gi-scale">
				{ticks.map((i) => <line x1={X0 + KML * i} x2={X0 + KML * i} y1={i % 5 === 0 ? 86 : 91} y2="97" />)}
				{[0, 5, 10, 15, 20].map((i) => (
					<text x={X0 + KML * i} y="80" text-anchor="middle">
						{i}
					</text>
				))}
				<text x={X0 + KML * 20 + 14} y="80">мл</text>
			</g>
			<!-- the air inside -->
			<g data-sdots></g>
			<g class="gi-arrows" data-sarrows>
				{[110, 120, 130].map((y) => <line x1="250" x2="262" y1={y} y2={y} marker-end={`url(#${mArrow})`} />)}
			</g>
			<!-- the plunger: stopper, rod and pad (moved by the script) -->
			<g data-plunger>
				<rect class="gi-stopper" x="0" y="101" width="10" height="38" rx="2"></rect>
				<rect class="gi-rod" x="10" y="116" width="100" height="8"></rect>
				<rect class="gi-rod" x="110" y="98" width="6" height="44" rx="2"></rect>
				<path class="gi-skin" d="M117 104 Q124 98 136 98 L164 98 L164 142 L136 142 Q124 142 117 136 Z"></path>
				<path class="gi-nail" d="M120 108 Q118 120 120 132"></path>
			</g>
			<!-- the barrel and the nozzle -->
			<path class="gi-barrel" d="M66 98 L222 98 M66 142 L222 142 M66 98 L66 142 M222 88 L222 152"></path>
			<path class="gi-barrel" d="M66 112 L48 116 L48 124 L66 128"></path>
			<!-- the finger on the nozzle -->
			<path class="gi-skin" d="M-10 96 L22 96 Q48 98 50 120 Q48 142 22 144 L-10 144 Z"></path>
			<path class="gi-nail" d="M30 104 Q38 120 30 136"></path>
			<!-- the pressure -->
			<rect class="gi-pill" x="8" y="182" width="170" height="24" rx="12"></rect>
			<text class="gi-read" x="93" y="199" text-anchor="middle" data-press>давление 100 кПа</text>
		</svg>
		<div class="intro__foot">
			<p>Если зажать пальцем носик шприца, поршень трудно вдвинуть: <More term="чем сильнее сжат воздух, тем сильнее он давит на поршень">Молекулы воздуха ударяют о поршень. Сожмите воздух вдвое — в каждом кубическом сантиметре окажется вдвое больше молекул, и давление станет вдвое больше: около 200&nbsp;кПа вместо 100&nbsp;кПа. Чтобы удержать так поршень шприца на 20&nbsp;мл, нужна сила около 30&nbsp;Н — как вес груза массой 3&nbsp;кг. Подробнее — в разделе <a href="#закон-бойля--мариотта">«Закон Бойля — Мариотта»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	.gi-wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.gi-table {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.gi-edge {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.gi-dot {
		fill: var(--sl-color-gray-2);
	}
	.gi-water {
		fill: color-mix(in srgb, var(--ig-vx) 45%, transparent);
	}
	.gi-steam path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.gi-bottle {
		fill: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.gi-balloon,
	.gi-sleeve {
		fill: color-mix(in srgb, var(--ig-vy) 55%, transparent);
		stroke: var(--ig-vy);
		stroke-width: 1.6;
	}
	.gi-shine {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-white) 70%, transparent);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.gi-basin {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linejoin: round;
	}
	.gi-stream {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, transparent);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.gi-kettle {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.gi-handle {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.gi-pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.gi-read {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.gi-label {
		font-size: 12px;
		fill: var(--sl-color-gray-1);
	}
	/* syringe scene */
	.gi-scale line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.gi-scale text {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.gi-barrel {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.gi-stopper {
		fill: var(--sl-color-gray-1);
	}
	.gi-rod {
		fill: color-mix(in srgb, var(--sl-color-white) 12%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.gi-skin {
		fill: color-mix(in srgb, var(--ig-v) 18%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.gi-nail {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.gi-arrows line {
		stroke: var(--ig-vx);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.gi-head {
		fill: var(--ig-vx);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';
	const ease = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
	const mk = (parent: Element, r: number) => {
		const c = document.createElementNS(NS, 'circle');
		c.setAttribute('class', 'gi-dot');
		c.setAttribute('r', String(r));
		parent.append(c);
		return c;
	};
	// a fixed pseudo-random sequence, the same on every load
	const rng = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
	type Dot = { c: SVGCircleElement; x: number; y: number; vx: number; vy: number };
	const dotsIn = (g: Element, n: number, r: () => number, box: [number, number, number, number], speed: number): Dot[] =>
		Array.from({ length: n }, () => {
			const a = r() * Math.PI * 2;
			const s = speed * (0.6 + 0.8 * r());
			return {
				c: mk(g, 1.8),
				x: box[0] + r() * (box[2] - box[0]),
				y: box[1] + r() * (box[3] - box[1]),
				vx: s * Math.cos(a),
				vy: s * Math.sin(a),
			};
		});
	/** Moves a dot by dt with elastic reflections inside [x0, x1] × [y0, y1]. */
	const move = (d: Dot, dt: number, k: number, x0: number, y0: number, x1: number, y1: number) => {
		d.x += d.vx * k * dt;
		d.y += d.vy * k * dt;
		if (d.x < x0) (d.x = 2 * x0 - d.x), (d.vx = Math.abs(d.vx));
		if (d.x > x1) (d.x = 2 * x1 - d.x), (d.vx = -Math.abs(d.vx));
		if (d.y < y0) (d.y = 2 * y0 - d.y), (d.vy = Math.abs(d.vy));
		if (d.y > y1) (d.y = 2 * y1 - d.y), (d.vy = -Math.abs(d.vy));
		d.x = Math.min(x1, Math.max(x0, d.x));
		d.y = Math.min(y1, Math.max(y0, d.y));
	};
	const clock = () => {
		let last = 0;
		return () => {
			const now = performance.now() / 1000;
			const dt = last ? Math.min(now - last, 0.05) : 0;
			last = now;
			return dt;
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-gasintro]')) {
		// ---------- Bottle: 8 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bottle"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const water = $<SVGPathElement>('[data-water]');
			const steam = $<SVGGElement>('[data-steam]');
			const stream = $<SVGPathElement>('[data-stream]');
			const kettle = $<SVGGElement>('[data-kettle]');
			const balloon = $<SVGEllipseElement>('[data-gballoon]');
			const limp = $<SVGPathElement>('[data-limp]');
			const shine = $<SVGPathElement>('[data-bshine]');
			const temp = $<SVGTextElement>('[data-temp]');
			const wlabel = $<SVGTextElement>('[data-wlabel]');
			const BT = 138;
			const BB = 198;
			const bx = (y: number) => [92 + (16 * (y - BT)) / (BB - BT), 268 - (16 * (y - BT)) / (BB - BT)];
			const r = rng(3);
			const BOX: [number, number, number, number] = [157, 102, 203, 191];
			const dots = dotsIn($('[data-dots]'), 16, r, BOX, 34);
			// places in the balloon (unit disc) for the dots that move there
			const inBalloon = [0, 1, 2].map(() => ({ u: r() * 1.2 - 0.6, v: r() * 1.2 - 0.6, ph: r() * 6.3 }));
			const tick = clock();
			const V0 = 0.5; // l
			const PX3 = 266000 / V0; // px³ per litre at the scale of the bottle
			scene(card, 8, (x) => {
				const dt = tick();
				const now = performance.now() / 1000;
				// the kettle tilts (0,03 → 0,08), pours (0,08 → 0,30) and goes back (0,30 → 0,36)
				const tilt = ease((x - 0.03) / 0.05) - ease((x - 0.3) / 0.06);
				const ang = -40 * tilt;
				kettle.setAttribute('transform', `rotate(${ang.toFixed(2)} 310 70)`);
				const a = (ang * Math.PI) / 180;
				const tx = 310 + -44 * Math.cos(a) - -16 * Math.sin(a);
				const ty = 70 + -44 * Math.sin(a) + -16 * Math.cos(a);
				const fill = ease((x - 0.08) / 0.22);
				const yw = BB - 2 - (BB - 2 - 152) * fill;
				const pouring = x > 0.08 && x < 0.3;
				stream.setAttribute('d', pouring ? `M${tx.toFixed(1)} ${ty.toFixed(1)} Q${(tx - 18).toFixed(1)} ${(ty + 6).toFixed(1)} 240 ${yw.toFixed(1)}` : '');
				const [l, rr] = bx(yw);
				const [l1, r1] = bx(BB);
				water.setAttribute('d', `M${l.toFixed(1)} ${yw.toFixed(1)} L${rr.toFixed(1)} ${yw.toFixed(1)} L${r1} ${BB + 2} L${l1} ${BB + 2} Z`);
				steam.style.opacity = String(0.8 * ease((x - 0.2) / 0.2));
				steam.setAttribute('transform', `translate(0 ${(-((now * 8) % 8)).toFixed(1)})`);
				wlabel.style.opacity = String(ease((x - 0.25) / 0.1));
				// the air in the bottle warms from 20 to 80 °C
				const t = 20 + 60 * ease((x - 0.15) / 0.75);
				const T = t + 273;
				temp.textContent = `в бутылке ${Math.round(t)} °C`;
				const vb = V0 * (T / 293 - 1); // l, gone into the balloon
				const rad = Math.cbrt((3 * vb * PX3) / (4 * Math.PI));
				// a slack balloon hangs from the neck; as air comes in it rises and rounds out
				const rx = Math.max(7, rad);
				const ry = Math.max(7, rad);
				const cy = 56 - ry;
				const round = Math.min(1, Math.max(0, (rad - 7) / 5));
				balloon.setAttribute('rx', rx.toFixed(1));
				balloon.setAttribute('ry', ry.toFixed(1));
				balloon.setAttribute('cy', cy.toFixed(1));
				balloon.style.opacity = String(round);
				limp.style.opacity = String(1 - round);
				shine.setAttribute('d', rad > 10 ? `M${(180 - rx * 0.55).toFixed(1)} ${(cy - ry * 0.2).toFixed(1)} A${(rx * 0.7).toFixed(1)} ${(ry * 0.7).toFixed(1)} 0 0 1 ${(180 - rx * 0.15).toFixed(1)} ${(cy - ry * 0.62).toFixed(1)}` : '');
				// molecules: speed ∝ √T; the share vb / (V0 + vb) of them is in the balloon
				const k = Math.sqrt(T / 293);
				const nb = Math.round((dots.length * vb) / (V0 + vb));
				dots.forEach((d, i) => {
					move(d, dt, k, BOX[0], BOX[1], BOX[2], BOX[3]);
					const j = dots.length - 1 - i;
					if (j < nb && rad > 8) {
						const p = inBalloon[j];
						d.c.setAttribute('cx', (180 + p.u * (rx - 5) + 1.5 * Math.sin(now * 3 + p.ph)).toFixed(1));
						d.c.setAttribute('cy', (cy + p.v * (ry - 5) + 1.5 * Math.cos(now * 2.6 + p.ph)).toFixed(1));
					} else {
						d.c.setAttribute('cx', d.x.toFixed(1));
						d.c.setAttribute('cy', d.y.toFixed(1));
					}
				});
			});
		}

		// ---------- Syringe: 6 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="syringe"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const plunger = $<SVGGElement>('[data-plunger]');
			const press = $<SVGTextElement>('[data-press]');
			const arrows = Array.from(card.querySelectorAll<SVGLineElement>('[data-sarrows] line'));
			const X0 = 66;
			const KML = 7;
			const r = rng(17);
			const dots = dotsIn($('[data-sdots]'), 24, r, [69, 102, X0 + KML * 20 - 3, 138], 40);
			const tick = clock();
			scene(card, 6, (x) => {
				const dt = tick();
				const V = 20 - 10 * ease((x - 0.1) / 0.6); // ml, pushed slowly: the temperature stays the same
				const face = X0 + KML * V;
				plunger.setAttribute('transform', `translate(${face.toFixed(1)} 0)`);
				const p = (100 * 20) / V; // кПа
				press.textContent = `давление ${Math.round(p)} кПа`;
				const len = 12 * (p / 100);
				for (const ln of arrows) {
					ln.setAttribute('x1', (face - 3 - len).toFixed(1));
					ln.setAttribute('x2', (face - 3).toFixed(1));
				}
				for (const d of dots) {
					move(d, dt, 1, 69, 102, face - 3, 138);
					d.c.setAttribute('cx', d.x.toFixed(1));
					d.c.setAttribute('cy', d.y.toFixed(1));
				}
			});
		}
	}
</script>
