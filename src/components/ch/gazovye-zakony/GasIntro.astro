			<rect class="gi-lid" x="11" y="22" width="22" height="5" rx="1.5"></rect>
			<path class="gi-jar gi-jar--b" d="M42 52 V36 Q42 33 45 33 H57 Q60 33 60 36 V52 Z"></path>
			<rect class="gi-lid" x="43" y="29.5" width="16" height="4" rx="1.5"></rect>
