<script>
	import { scene } from '@components/intro/scene';
	import { ROLL } from '@components/people/hand';
	import { gzArm } from './gzArm';
	const NS = 'http://www.w3.org/2000/svg';
	const ease = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x));
	const mkDot = (parent: Element, r: number) => {
		const c = document.createElementNS(NS, 'circle');
		c.setAttribute('class', 'gi-dot');
		c.setAttribute('r', String(r));
		parent.append(c);
		return c;
	};
	// a fixed pseudo-random sequence, the same on every load
	const rng = (seed: number) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
	type Dot = { c: SVGCircleElement; x: number; y: number; vx: number; vy: number };
	const dotsIn = (g: Element, n: number, r: () => number, box: [number, number, number, number], speed: number, rad: number): Dot[] =>
		Array.from({ length: n }, () => {
			const a = r() * Math.PI * 2;
			const s = speed * (0.6 + 0.8 * r());
			return { c: mkDot(g, rad), x: box[0] + r() * (box[2] - box[0]), y: box[1] + r() * (box[3] - box[1]), vx: s * Math.cos(a), vy: s * Math.sin(a) };
		});
	/** Moves a dot by dt with elastic reflections inside [x0, x1] × [y0, y1]. */
	const move = (d: Dot, dt: number, k: number, x0: number, y0: number, x1: number, y1: number) => {
		d.x += d.vx * k * dt;
		d.y += d.vy * k * dt;
		if (d.x < x0) (d.x = 2 * x0 - d.x), (d.vx = Math.abs(d.vx));
		if (d.x > x1) (d.x = 2 * x1 - d.x), (d.vx = -Math.abs(d.vx));
		if (d.y < y0) (d.y = 2 * y0 - d.y), (d.vy = Math.abs(d.vy));
		if (d.y > y1) (d.y = 2 * y1 - d.y), (d.vy = -Math.abs(d.vy));
		d.x = Math.min(x1, Math.max(x0, d.x));
		d.y = Math.min(y1, Math.max(y0, d.y));
	};
	const clock = () => {
		let last = 0;
		return () => {
			const now = performance.now() / 1000;
			const dt = last ? Math.min(now - last, 0.05) : 0;
			last = now;
			return dt;
		};
	};
	const f1 = (v: number) => v.toFixed(1);
	const DEG = Math.PI / 180;

	for (const root of document.querySelectorAll<HTMLElement>('[data-gasintro]')) {
		// ---------- Bottle: 8 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bottle"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const water = $<SVGPathElement>('[data-water]');
			const wfront = $<SVGPathElement>('[data-wfront]');
			const steam = $<SVGGElement>('[data-steam]');
			const stream = $<SVGPathElement>('[data-stream]');
			const kettle = $<SVGGElement>('[data-kettle]');
			const balloon = $<SVGEllipseElement>('[data-gballoon]');
			const limp = $<SVGPathElement>('[data-limp]');
			const shine = $<SVGPathElement>('[data-bshine]');
			const temp = $<SVGTextElement>('[data-temp]');
			const wlabel = $<SVGTextElement>('[data-wlabel]');
			const wpill = $<SVGRectElement>('[data-wpill]');
			const arm = gzArm($('[data-arm1]'), { Lh: 90, side: 'L', sleeve: 'hm-blue', reach: 400 });
			const BX = 105;
			const RIM = 155; // the basin's rim
			const FLOOR = 209; // the basin's floor
			const bx = (y: number) => [45 + (15 * (y - RIM)) / (FLOOR - RIM), 205 - (15 * (y - RIM)) / (FLOOR - RIM)];
			const r = rng(3);
			const BOX: [number, number, number, number] = [BX - 13, 126, BX + 13, 206];
			const dots = dotsIn($('[data-dots]'), 14, r, BOX, 30, 1.6);
			const inBalloon = [0, 1, 2].map(() => ({ u: r() * 1.2 - 0.6, v: r() * 1.2 - 0.6, ph: r() * 6.3 }));
			const tick = clock();
			const V0 = 0.5; // l
			const PX3 = 125000; // px³ per litre at 5 px per cm
			const NECK = 105; // top of the neck under the balloon's sleeve
			// the kettle: the grip on its handle at the origin; held at G0, carried to G1 and tilted by 35°
			const G0 = { x: 268, y: 26 };
			const G1 = { x: 252, y: 40 };
			const SPOUT = { x: -92, y: 44 };
			limp.setAttribute('d', `M${BX - 6} 106 Q${BX - 12} 98 ${BX - 18} 102 Q${BX - 25} 110 ${BX - 21} 122 Q${BX - 17} 130 ${BX - 12} 123 Q${BX - 8} 116 ${BX - 6} 110 Z`);
			scene(card, 8, (x) => {
				const dt = tick();
				const now = performance.now() / 1000;
				// carry (0,02 → 0,10), tilt (0,06 → 0,12), pour (0,12 → 0,34), back (0,34 → 0,44)
				const carry = ease((x - 0.02) / 0.08) - ease((x - 0.36) / 0.08);
				const tilt = ease((x - 0.06) / 0.06) - ease((x - 0.34) / 0.07);
				const ang = -35 * tilt;
				const a = ang * DEG;
				const gx = G0.x + (G1.x - G0.x) * carry;
				const gy = G0.y + (G1.y - G0.y) * carry;
				kettle.setAttribute('transform', `translate(${f1(gx)} ${f1(gy)}) rotate(${ang.toFixed(2)})`);
				// the hand round the top of the handle; the forearm goes up and to the right
				arm({ at: { x: gx, y: gy }, pose: 'grip', d: 0.14, dir: Math.PI / 2 + a, roll: ROLL.backViewer - 0.6, bend: 0.45 - a * 0.9 });
				const tx = gx + SPOUT.x * Math.cos(a) - SPOUT.y * Math.sin(a);
				const ty = gy + SPOUT.x * Math.sin(a) + SPOUT.y * Math.cos(a);
				const fill = ease((x - 0.12) / 0.22);
				const yw = FLOOR - 1 - (FLOOR - 1 - 169) * fill;
				const pouring = x > 0.125 && x < 0.34;
				stream.setAttribute('d', pouring ? `M${f1(tx)} ${f1(ty)} Q${f1(tx - 8)} ${f1(ty + 4)} 160 ${f1(yw)}` : '');
				const [l, rr] = bx(yw);
				const [l1, r1] = bx(FLOOR);
				const ry = 7 * ((rr - l) / 160);
				water.setAttribute('d', `M${f1(l)} ${f1(yw)} A${f1((rr - l) / 2)} ${f1(ry)} 0 0 0 ${f1(rr)} ${f1(yw)} L${f1(r1)} ${FLOOR} L${f1(l1)} ${FLOOR} Z`);
				water.style.opacity = fill > 0.01 ? '1' : '0';
				wfront.setAttribute('d', fill > 0.01 ? `M${f1(l)} ${f1(yw)} A${f1((rr - l) / 2)} ${f1(ry)} 0 0 0 ${f1(rr)} ${f1(yw)}` : '');
				steam.style.opacity = String(0.8 * ease((x - 0.2) / 0.2));
				steam.setAttribute('transform', `translate(0 ${f1(-((now * 8) % 8))})`);
				wlabel.style.opacity = wpill.style.opacity = String(ease((x - 0.3) / 0.08));
				// the air in the bottle warms from 20 to 80 °C
				const t = 20 + 60 * ease((x - 0.16) / 0.72);
				const T = t + 273;
				temp.textContent = `в бутылке ${Math.round(t)} °C`;
				const vb = V0 * (T / 293 - 1); // l, gone into the balloon
				const rad = Math.cbrt((3 * vb * PX3) / (4 * Math.PI));
				// a slack balloon hangs from the neck; as air comes in it rises and rounds out
				const R = Math.max(6, rad);
				const cy = NECK - R + 2;
				const round = Math.min(1, Math.max(0, (rad - 6) / 4));
				balloon.setAttribute('rx', f1(R));
				balloon.setAttribute('ry', f1(R));
				balloon.setAttribute('cy', f1(cy));
				balloon.style.opacity = String(round);
				limp.style.opacity = String(1 - round);
				shine.setAttribute('d', rad > 9 ? `M${f1(BX - R * 0.55)} ${f1(cy - R * 0.2)} A${f1(R * 0.7)} ${f1(R * 0.7)} 0 0 1 ${f1(BX - R * 0.15)} ${f1(cy - R * 0.62)}` : '');
				// molecules: speed ∝ √T; the share vb / (V0 + vb) of them is in the balloon
				const k = Math.sqrt(T / 293);
				const nb = Math.round((dots.length * vb) / (V0 + vb));
				dots.forEach((d, i) => {
					move(d, dt, k, BOX[0], BOX[1], BOX[2], BOX[3]);
					// the shoulders and the neck are narrower than the body
					const narrow = d.y < 138 ? Math.max(5, 13 - (138 - d.y) * 0.7) : 13;
					const cx = Math.min(BX + narrow, Math.max(BX - narrow, d.x));
					const j = dots.length - 1 - i;
					if (j < nb && rad > 7) {
						const p = inBalloon[j];
						d.c.setAttribute('cx', f1(BX + p.u * (R - 4) + 1.2 * Math.sin(now * 3 + p.ph)));
						d.c.setAttribute('cy', f1(cy + p.v * (R - 4) + 1.2 * Math.cos(now * 2.6 + p.ph)));
					} else {
						d.c.setAttribute('cx', f1(cx));
						d.c.setAttribute('cy', f1(d.y));
					}
				});
			});
		}
		// ---------- Ball: 7 s ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ball"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const ball = $<SVGGElement>('[data-ball]');
			const dent = $<SVGPathElement>('[data-dent]');
			const click = $<SVGGElement>('[data-click]');
			const shell = $<SVGPathElement>('[data-shell]');
			const lwater = $<SVGRectElement>('[data-lwater]');
			const lead = $<SVGLineElement>('[data-lead]');
			const btemp = $<SVGTextElement>('[data-btemp]');
			const steam2 = $<SVGGElement>('[data-steam2]');
			const S = 6; // px per cm
			const RB = 2 * S; // the ball's radius
			const WATER = 153; // water surface in the mug
			const FLOAT = WATER - (2 - 0.69) * S; // the ball's center when it floats (0,69 см under the water)
			const LH = 18 * S;
			const arm = gzArm($('[data-arm2]'), { Lh: LH, side: 'L', sleeve: 'hm-red', reach: 400 });
			// the spoon: drawn with its origin at the grip of the hand, the bowl 100 px (17 см) to the left
			const spoon = $<SVGGElement>('[data-spoon]');
			const G0 = { x: 286, y: 100 };
			const BOWL = { x: -100, y: -10 }; // the ball's center when it rests in the bowl
			const TIP = 14; // px from the bowl's middle to its tip
			const TILT = 14 * DEG;
			const gpx = 980 * S; // g in px/с²
			const rot = (p: { x: number; y: number }, a: number, o: { x: number; y: number }) => ({ x: o.x + p.x * Math.cos(a) - p.y * Math.sin(a), y: o.y + p.x * Math.sin(a) + p.y * Math.cos(a) });
			// the ball rolls to the tip with a = (5/7)·g·sin 12° and leaves it at the speed it gained
			const tRoll = 0.75;
			const aRoll = (5 / 7) * gpx * Math.sin(12 * DEG);
			const tLeave = tRoll + Math.sqrt((2 * TIP) / aRoll);
			const vLeave = aRoll * (tLeave - tRoll);
			// the magnifier: center (66, 72), ×4 → 24 px per cm, the ball's radius 48 px
			const LC = { x: 66, y: 72 };
			const RL = 48;
			const r = rng(11);
			const ldots = dotsIn($('[data-ldots]'), 12, r, [LC.x - 26, LC.y - 10, LC.x + 26, LC.y + 30], 26, 2.2);
			const tick = clock();
			const POP = 64; // °C when the dent pops
			// the dent: a cap of the shell pushed in, centered at the angle −130° (upper left), 1,5 см across
			const DA = -130 * DEG;
			const HALF = Math.asin(0.75 / 2); // half the angle of the cap
			const at = (aa: number, rr = RL) => ({ x: LC.x + rr * Math.cos(aa), y: LC.y + rr * Math.sin(aa) });
			const shellPath = (depth: number) => {
				const a0 = DA + HALF;
				const a1 = DA - HALF + 2 * Math.PI;
				const p0 = at(a0);
				const p1 = at(a1);
				// the cap pushed in: its middle goes from the sphere (RL) inward by RL(1 − cos HALF) + depth
				const mid = at(DA, RL - depth);
				// a quadratic through mid: control = 2·mid − (p0 + p1)/2
				const cx = 2 * mid.x - (p0.x + p1.x) / 2;
				const cy = 2 * mid.y - (p0.y + p1.y) / 2;
				return `M${f1(p0.x)} ${f1(p0.y)} A${RL} ${RL} 0 1 1 ${f1(p1.x)} ${f1(p1.y)} Q${f1(cx)} ${f1(cy)} ${f1(p0.x)} ${f1(p0.y)} Z`;
			};
			const inside = (px: number, py: number, depth: number) => {
				const dx = px - LC.x;
				const dy = py - LC.y;
				if (Math.hypot(dx, dy) > RL - 4) return false;
				return dx * Math.cos(DA) + dy * Math.sin(DA) < RL - depth - 5;
			};
			scene(card, 7, (x) => {
				const dt = tick();
				const now = performance.now() / 1000;
				const t = x * 7; // s
				// the spoon tilts by 14° (0,4 → 0,8 s); the hand takes it up and away (1,4 → 2,4 s)
				const tiltK = ease((t - 0.4) / 0.4) * (1 - ease((t - 1.4) / 0.6));
				const ang = -TILT * tiltK;
				const away = ease((t - 1.4) / 1.0);
				const G = { x: G0.x + 60 * away, y: G0.y - 190 * away };
				spoon.setAttribute('transform', `translate(${f1(G.x)} ${f1(G.y)}) rotate(${(ang / DEG).toFixed(2)})`);
				arm({ at: G, pose: 'grip', d: 0.06, dir: Math.PI / 2 + ang, roll: ROLL.backViewer, bend: 0.5 - 0.9 * ang });
				// the ball: in the bowl, rolls to the tip, falls freely, then floats with a damped bob
				let bx: number;
				let by: number;
				const angAt = (tt: number) => -TILT * ease((tt - 0.4) / 0.4);
				if (t < tLeave) {
					const s0 = t < tRoll ? 0 : 0.5 * aRoll * (t - tRoll) ** 2;
					const p = rot({ x: BOWL.x - s0, y: BOWL.y }, angAt(t), G0);
					bx = p.x;
					by = p.y;
				} else {
					const a0 = angAt(tLeave);
					const p0 = rot({ x: BOWL.x - TIP, y: BOWL.y }, a0, G0);
					const vx = -vLeave * Math.cos(a0);
					const vy = -vLeave * Math.sin(a0);
					const tf = (-vy + Math.sqrt(vy * vy + 2 * gpx * (FLOAT - p0.y))) / gpx;
					const s1 = t - tLeave;
					bx = p0.x + vx * Math.min(s1, tf);
					by = s1 < tf ? p0.y + vy * s1 + 0.5 * gpx * s1 * s1 : FLOAT + 4 * Math.exp(-(s1 - tf) / 0.25) * Math.sin(((s1 - tf) / 0.3) * Math.PI);
				}
				// the air in the ball warms after it lands (compressed time)
				const tLand = tLeave + 0.16;
				const inWater = t - tLand;
				const tc = inWater > 0 ? 80 - 60 * Math.exp(-inWater / 1.5) : 20;
				const tPop = tLand - 1.5 * Math.log((80 - POP) / 60);
				const pop = ease((t - tPop) / 0.12);
				const depth = 9.6 * (1 - pop); // 4 мм at ×4
				ball.setAttribute('transform', `translate(${f1(bx)} ${f1(by)})`);
				dent.style.opacity = String(1 - pop);
				click.style.opacity = String(t > tPop && t < tPop + 0.9 ? 1 - ease((t - tPop - 0.6) / 0.3) : 0);
				click.setAttribute('transform', `translate(${f1(bx + 6)} ${f1(by - RB - 2)})`);
				btemp.textContent = `в мячике ${Math.round(tc)} °C`;
				shell.setAttribute('d', shellPath(depth));
				// the water in the magnifier: the ball floats with 0,69 см under it
				const wl = LC.y + RL - 0.69 * 24 - (by - FLOAT) * 4;
				lwater.setAttribute('y', f1(t < tLand ? 200 : Math.min(200, wl)));
				lead.setAttribute('x2', f1(bx - 10));
				lead.setAttribute('y2', f1(by - 4));
				steam2.setAttribute('transform', `translate(0 ${f1(-((now * 7) % 8))})`);
				const k = Math.sqrt((tc + 273) / 293);
				for (const d of ldots) {
					const px = d.x;
					const py = d.y;
					move(d, dt, k, LC.x - RL + 4, LC.y - RL + 4, LC.x + RL - 4, LC.y + RL - 4);
					if (!inside(d.x, d.y, depth)) {
						// a blow on the shell: reflect from the wall (the normal is radial, or along DA at the dent)
						const dx = d.x - LC.x;
						const dy = d.y - LC.y;
						const nr = Math.hypot(dx, dy) || 1;
						const atDent = dx * Math.cos(DA) + dy * Math.sin(DA) >= RL - depth - 5 && Math.hypot(dx, dy) <= RL - 4;
						const n = atDent ? { x: Math.cos(DA), y: Math.sin(DA) } : { x: dx / nr, y: dy / nr };
						const vn = d.vx * n.x + d.vy * n.y;
						if (vn > 0) {
							d.vx -= 2 * vn * n.x;
							d.vy -= 2 * vn * n.y;
						}
						d.x = px;
						d.y = py;
					}
					d.c.setAttribute('cx', f1(d.x));
					d.c.setAttribute('cy', f1(d.y));
				}
			});
		}
	}
</script>
