---
/**
 * Two short looping opening scenes of «Газовые законы». No terms of the chapter in the pictures; the captions'
 * popovers explain. The hands are the shared people kit (gzArm.ts: a forearm with a kit hand entering from the edge).
 *
 * Bottle (a kitchen, 5 px per centimeter, 8 s): an empty 0,5 л bottle (6,5 см across, 20 см tall) with a slack
 *   rubber balloon on its neck stands in a basin (32 см across, 11 см deep) on the table. A hand holds a stovetop
 *   kettle by its top handle (the fingers round the handle) and tilts it by 35°, pouring hot water (80 °C) into the
 *   basin, 8 см deep. The air in the bottle warms from 20 to 80 °C at constant (atmospheric) pressure, so its volume
 *   grows as T: V = 0,5 л · T/293 К, and 0,10 л goes into the balloon, drawn to the same scale (a sphere of 0,10 л
 *   has a radius of 2,9 см = 14 px). The warming is compressed: a real bottle takes a few minutes. Dots stand for the
 *   air; they move faster as √T, and the share of them in the balloon is the share of the volume.
 * Ball (6 px per centimeter, 7 s): a table-tennis ball (Ø 40 мм, 2,7 г) with a dent 1,5 см across and 4 мм deep lies
 *   in a tablespoon held by a hand above a mug of hot water (80 °C). The spoon tilts by 14°, the ball rolls off its tip
 *   (a = 5/7·g·sin 12°), falls into the mug (real time) and floats with 0,69 см under the water (2,7 см³ displaced). The air inside warms:
 *   t = 80 − 60·e^(−τ/1,5 с) °C, compressed about ten times (a real ball takes 20–30 с). The volume of the ball stays
 *   almost the same, so the pressure grows as T: p = 101 кПа · T/293 К; when the air is 15 кПа above the outside
 *   (64 °C) the softened plastic gives way and the dent pops out with a click. The magnifier (×4) shows the ball in
 *   cross-section and the air inside; its dots move faster as √T.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const clipB = `gi-clip-${uid}`;
// kitchen tiles behind the table
const tiles = (y0: number, y1: number, w: number) => {
	let d = '';
	for (let y = y0; y <= y1; y += w) d += `M0 ${y} H360 `;
	for (let x = 0; x <= 360; x += w) d += `M${x} ${y0} V${y1} `;
	return d;
};
// Bottle scene geometry (5 px per cm): the bottle stands on the basin's floor at y = 209, its axis at x = 105.
const BX = 105;
const BOTTLE = `M${BX - 16} 206 Q${BX - 16} 209 ${BX - 13} 209 L${BX + 13} 209 Q${BX + 16} 209 ${BX + 16} 206 L${BX + 16} 140 Q${BX + 16} 128 ${BX + 7} 122 L${BX + 7} 110 L${BX - 7} 110 L${BX - 7} 122 Q${BX - 16} 128 ${BX - 16} 140 Z`;
---

