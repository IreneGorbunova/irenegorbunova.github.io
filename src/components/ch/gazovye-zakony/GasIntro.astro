			<line class="gi-edge" x1="0" y1="215" x2="360" y2="215"></line>
			<!-- the basin: back half of the rim, water, bottle, front wall -->
			<ellipse class="gi-rim-back" cx="125" cy="155" rx="80" ry="7"></ellipse>
			<path class="gi-basin-in" d="M45 155 L60 208 Q61 211 66 211 L184 211 Q189 211 190 208 L205 155 Z"></path>
