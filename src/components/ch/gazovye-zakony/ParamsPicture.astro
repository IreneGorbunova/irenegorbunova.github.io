---
/**
 * Picture to the macroscopic parameters: a gas in a cylinder under a piston and the devices that measure p, V and T.
 * The state is consistent: p = 100 кПа (manometer), V = 2,0 л (the scale on the cylinder, 36 px per литр), T = 300 К
 * (27 °C, the probe of a thermometer in the gas), so ν = pV/(RT) = 0,080 моль (as in GasLab). The mass m is «how
 * much gas»; the magnifier shows its molecules (dots, the only moving part; they move as at 300 К, slowed down).
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const clip = `prp-c-${uid}`;
const LPX = 36; // px per литр
const BOT = 210;
const yL = (v: number) => BOT - v * LPX;
const D = { x: 300, y: 125, r: 28 };
const dA = (p: number) => (-210 + (p / 200) * 240) * (Math.PI / 180);
---

<G7Styles />
<figure class="g7 g7--pic prp not-content" data-prp>
	<svg class="g7__svg" viewBox="0 0 360 258" role="img" aria-label="Газ в цилиндре под поршнем. Манометр показывает давление 100 кПа, шкала на цилиндре — объём 2 л, термометр — температуру 300 К. В лупе — молекулы газа">
		<defs>
			<clipPath id={clip}><circle cx="60" cy="66" r="44"></circle></clipPath>
		</defs>
		<!-- the cylinder with the gas and the piston -->
		<rect class="prp__base" x="138" y="214" width="74" height="6" rx="2"></rect>
		<rect class="prp__gas" x="150" y={yL(2)} width="50" height={2 * LPX}></rect>
		<g data-cdots></g>
		<rect class="prp__piston" x="150.5" y={yL(2) - 8} width="49" height="8" rx="1.5"></rect>
		<path class="prp__rod" d={`M175 ${yL(2) - 8} V${yL(2) - 40} M165 ${yL(2) - 40} H185`}></path>
		<path class="prp__glass" d={`M148 90 V${BOT + 2} H202 V90`}></path>
		<!-- the volume scale -->
		<g class="prp__vscale">
			{[1, 2, 3].map((v) => <line x1="142" x2="148" y1={yL(v)} y2={yL(v)} />)}
			{[1, 2, 3].map((v) => (
				<text x="139" y={yL(v) + 4} text-anchor="end">
					{v} л
				</text>
			))}
		</g>
		<!-- the thermometer: a probe in the gas and its display -->
		<path class="prp__cable" d="M96 170 Q124 170 130 186 Q134 198 148 198 H166"></path>
		<circle class="prp__probe" cx="168" cy="198" r="2.6"></circle>
		<rect class="prp__display" x="14" y="152" width="82" height="36" rx="5"></rect>
		<text class="prp__dbig" x="55" y="168" text-anchor="middle">300 К</text>
		<text class="prp__dsmall" x="55" y="182" text-anchor="middle">27 °C</text>
		<text class="prp__q prp__q--t" x="14" y="206">температура <tspan class="prp__i">T</tspan></text>
		<text class="prp__dev" x="14" y="221">термометр</text>
		<!-- the manometer -->
		<path class="prp__pipe" d={`M202 200 H${D.x} V${D.y + D.r}`}></path>
		<circle class="prp__dial" cx={D.x} cy={D.y} r={D.r}></circle>
		{Array.from({ length: 9 }, (_, i) => i * 25).map((p) => {
			const a = dA(p);
			const r1 = p % 100 === 0 ? D.r - 7 : D.r - 4;
			return <line class="prp__gt" x1={D.x + r1 * Math.cos(a)} y1={D.y + r1 * Math.sin(a)} x2={D.x + (D.r - 1.5) * Math.cos(a)} y2={D.y + (D.r - 1.5) * Math.sin(a)} />;
		})}
		{[0, 100, 200].map((p) => {
			const a = dA(p);
			return (
				<text class="prp__gl" x={D.x + (D.r + 11) * Math.cos(a)} y={D.y + (D.r + 11) * Math.sin(a) + 4} text-anchor="middle">
					{p}
				</text>
			);
		})}
		<text class="prp__gl" x={D.x} y={D.y + 18} text-anchor="middle">кПа</text>
		<line class="prp__needle" x1={D.x} y1={D.y} x2={D.x + 23 * Math.cos(dA(100))} y2={D.y + 23 * Math.sin(dA(100))}></line>
		<circle class="prp__hub" cx={D.x} cy={D.y} r="2.5"></circle>
		<text class="prp__q prp__q--p" x={D.x} y="52" text-anchor="middle">давление <tspan class="prp__i">p</tspan></text>
		<text class="prp__dev" x={D.x} y="67" text-anchor="middle">манометр</text>
		<text class="prp__q prp__q--v" x="175" y="238" text-anchor="middle">объём <tspan class="prp__i">V</tspan></text>
		<text class="prp__dev" x="175" y="253" text-anchor="middle">шкала цилиндра</text>
		<!-- the magnifier: the molecules of the gas -->
		<line class="prp__lead" x1="94" y1="91" x2="185" y2="160"></line>
		<circle class="prp__lensbg" cx="60" cy="66" r="44"></circle>
		<g clip-path={`url(#${clip})`}><g data-ldots></g></g>
		<circle class="prp__lens" cx="60" cy="66" r="44"></circle>
		<text class="prp__q" x="112" y="24">масса <tspan class="prp__i">m</tspan></text>
		<text class="prp__dev" x="112" y="39">сколько газа</text>
	</svg>
	<figcaption class="g7__caption">
		Давление, объём и температура газа измеряют приборами; масса — это сколько газа в цилиндре. В лупе — молекулы газа (движение замедлено).
	</figcaption>
</figure>

<style is:global>
	/* compact: the picture needs no more than 440 px of width */
	.prp .g7__svg {
		display: block;
		max-width: 440px;
		margin-inline: auto;
	}
	.prp .g7__svg text {
		font-size: 12.5px;
	}
	.g7__svg .prp__gas {
		fill: color-mix(in srgb, var(--ig-vx) 7%, var(--g7-paper));
	}
	.g7__svg .prp__dot {
		fill: var(--sl-color-gray-1);
	}
	.g7__svg .prp__piston {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.g7__svg .prp__rod {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.g7__svg .prp__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.g7__svg .prp__base {
		fill: var(--g7-wood);
	}
	.g7__svg .prp__vscale line {
		stroke: var(--g7-blue);
		stroke-width: 1.2;
	}
	.g7__svg .prp__vscale text {
		fill: var(--g7-blue);
	}
	.g7__svg .prp__cable {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.g7__svg .prp__probe {
		fill: var(--g7-red);
	}
	.g7__svg .prp__display {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.4;
	}
	.g7__svg .prp__dbig {
		font-weight: 700;
		font-size: 14px;
		fill: var(--g7-red);
	}
	.g7__svg .prp__dsmall {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .prp__pipe {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.g7__svg .prp__dial {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	.g7__svg .prp__gt {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.prp .g7__svg .prp__gl {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .prp__needle {
		stroke: var(--g7-gold);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.g7__svg .prp__hub {
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .prp__q {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.g7__svg .prp__q--p {
		fill: var(--g7-gold);
	}
	.g7__svg .prp__q--v {
		fill: var(--g7-blue);
	}
	.g7__svg .prp__q--t {
		fill: var(--g7-red);
	}
	.g7__svg .prp__i {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-weight: 400;
		font-size: 14px;
	}
	.g7__svg .prp__dev {
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .prp__lead {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.g7__svg .prp__lensbg {
		fill: color-mix(in srgb, var(--ig-vx) 7%, var(--g7-paper));
	}
	.g7__svg .prp__lens {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
	}
</style>

<script>
	import { el, loop } from '../g7/kit';

	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-prp]')) {
		let seed = 31;
		const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
		type D = { c: SVGCircleElement; x: number; y: number; vx: number; vy: number };
		const make = (g: Element, n: number, box: number[], sp: number, r: number): D[] =>
			Array.from({ length: n }, () => {
				const a = rnd() * 6.283;
				const s = sp * (0.6 + 0.8 * rnd());
				const c = el('circle', { class: 'prp__dot', r });
				g.append(c);
				return { c, x: box[0] + rnd() * (box[2] - box[0]), y: box[1] + rnd() * (box[3] - box[1]), vx: s * Math.cos(a), vy: s * Math.sin(a) };
			});
		const CB = [153, 141, 197, 207];
		const LB = [18, 24, 102, 108];
		const cd = make(root.querySelector('[data-cdots]')!, 12, CB, 22, 1.6);
		const ld = make(root.querySelector('[data-ldots]')!, 14, LB, 30, 2.6);
		const move = (d: D, dt: number, b: number[]) => {
			d.x += d.vx * dt;
			d.y += d.vy * dt;
			if (d.x < b[0] || d.x > b[2]) (d.vx = -d.vx), (d.x = Math.min(b[2], Math.max(b[0], d.x)));
			if (d.y < b[1] || d.y > b[3]) (d.vy = -d.vy), (d.y = Math.min(b[3], Math.max(b[1], d.y)));
			d.c.setAttribute('cx', f1(d.x));
			d.c.setAttribute('cy', f1(d.y));
		};
		loop(root, (dt) => {
			for (const d of cd) move(d, dt, CB);
			for (const d of ld) move(d, dt, LB);
			return true;
		});
		for (const d of [...cd, ...ld]) move(d, 0, [0, 0, 400, 400]);
	}
</script>
