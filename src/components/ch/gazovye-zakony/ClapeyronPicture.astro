---
/**
 * Picture to Clapeyron's equation: one gas (ν = 0,120 моль, νR = 1,00 Дж/К), two states. A screw press pushes the
 * piston in and a burner heats the gas at the same time; V and T change linearly in time:
 *   state 1: p₁ = 100 кПа, V₁ = 3,0 л, T₁ = 300 К; state 2: p₂ = 150 кПа, V₂ = 2,4 л, T₂ = 360 К;
 *   in between p = νRT/V (кПа = К / л, since νR = 1,00 Дж/К and 1 кПа·л = 1 Дж), so pV/T = 1,00 Дж/К all the way.
 * Loop of 9 s: hold 1 (0,6 s), 1 → 2 (3,4 s), hold 2 (1 s), back 2 → 1 with the burner off (3 s; the gas is let
 * cool and the screw turned back), hold. The point on the p–V graph leaves its trace.
 * Scale of the cylinder: cross-section 1 дм², 1 л = 1 дм of height = 30 px. Graph: V 0…3,5 л, p 0…175 кПа.
 */
import G7Styles from '../g7/G7Styles.astro';
const uid = Math.random().toString(36).slice(2, 8);
// graph geometry
const gx = (v: number) => 244 + (v / 3.5) * 104;
const gy = (p: number) => 186 - (p / 175) * 140;
---

<G7Styles />
<figure class="g7 g7--pic clp not-content" data-clp>
	<svg class="g7__svg" viewBox="0 0 360 222" role="img" aria-label="Поршень вдвигают винтом и одновременно нагревают газ горелкой; давление, объём и температура меняются, а отношение pV/T остаётся тем же" data-svg>
		<!-- the press: base, two posts, crossbar, screw with a wheel -->
		<rect class="clp__base" x="14" y="204" width="120" height="8" rx="2"></rect>
		<path class="clp__post" d="M24 204 V24 H124 V204"></path>
		<line class="clp__screw" x1="74" x2="74" y1="10" data-screw></line>
		<g data-wheel>
			<ellipse class="clp__wheel" cx="74" cy="12" rx="22" ry="5"></ellipse>
			<line class="clp__spoke" data-sp1 y1="12" y2="12"></line>
			<line class="clp__spoke" data-sp2 y1="12" y2="12"></line>
		</g>
		<!-- the cylinder (inner 57 … 91, bottom 170), the gas, the piston -->
		<rect class="clp__gas" x="57" width="34" y="80" height="90" data-gas></rect>
		<g data-dots></g>
		<rect class="clp__piston" x="57.5" width="33" y="72" height="8" rx="1.5" data-piston></rect>
		<path class="clp__glass" d="M55 40 V172 H93 V40"></path>
		<!-- the burner -->
		<path class="clp__flame" data-flame></path>
		<rect class="clp__burner" x="62" y="190" width="24" height="14" rx="2"></rect>
		<!-- readouts -->
		<text class="clp__rd clp__rd--p" x="130" y="58" data-rp></text>
		<text class="clp__rd clp__rd--v" x="130" y="82" data-rv></text>
		<text class="clp__rd clp__rd--t" x="130" y="106" data-rt></text>
		<rect class="clp__box" x="130" y="124" width="88" height="46" rx="8"></rect>
		<text class="clp__k" x="174" y="143" text-anchor="middle">pV/T</text>
		<text class="clp__kv" x="174" y="162" text-anchor="middle" data-rk></text>
		<!-- the p–V graph -->
		<path class="clp__grid" d={`M${gx(1)} 186 V40 M${gx(2)} 186 V40 M${gx(3)} 186 V40 M244 ${gy(50)} H352 M244 ${gy(100)} H352 M244 ${gy(150)} H352`}></path>
		<path class="clp__axis" d="M244 32 V186 H356 M240 40 L244 32 L248 40 M348 182 L356 186 L348 190"></path>
		{[1, 2, 3].map((v) => <text class="clp__tick" x={gx(v)} y="200" text-anchor="middle">{v}</text>)}
		{[50, 100, 150].map((p) => <text class="clp__tick" x="238" y={gy(p) + 4} text-anchor="end">{p}</text>)}
		<text class="clp__tick" x="238" y="200" text-anchor="end">0</text>
		<text class="clp__ax" x="252" y="30">p<tspan class="clp__unit" dx="2">, кПа</tspan></text>
		<text class="clp__ax" x="356" y="216" text-anchor="end">V<tspan class="clp__unit" dx="2">, л</tspan></text>
		<path class="clp__trace" data-trace></path>
		<circle class="clp__end" cx={gx(3)} cy={gy(100)} r="3.5"></circle>
		<circle class="clp__end" cx={gx(2.4)} cy={gy(150)} r="3.5"></circle>
		<text class="clp__num" x={gx(3) + 7} y={gy(100) + 15}>1</text>
		<text class="clp__num" x={gx(2.4) - 7} y={gy(150) - 7} text-anchor="end">2</text>
		<circle class="clp__pt" r="5" data-pt></circle>
	</svg>
	<figcaption class="g7__caption">
		Один и тот же газ: поршень вдвигают винтом и одновременно нагревают газ горелкой. Меняются давление, объём и температура, а отношение <i>pV</i>/<i>T</i> остаётся тем же. Цилиндр — в масштабе: площадь поршня 1&nbsp;дм², 1&nbsp;л — это 1&nbsp;дм высоты.
	</figcaption>
</figure>

<style is:global>
	/* compact: no more than 520 px wide */
	.clp .g7__svg {
		display: block;
		max-width: 520px;
		margin-inline: auto;
	}
	.clp .g7__svg text {
		font-size: 12.5px;
	}
	.g7__svg .clp__base {
		fill: var(--g7-wood);
	}
	.g7__svg .clp__post {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 4;
		stroke-linejoin: round;
	}
	.g7__svg .clp__screw {
		stroke: var(--g7-steel);
		stroke-width: 4;
		stroke-dasharray: 2 1.5;
	}
	.g7__svg .clp__wheel {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
	}
	.g7__svg .clp__spoke {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.g7__svg .clp__gas {
		fill: color-mix(in oklab, var(--g7-red) calc(var(--heat, 0) * 22%), var(--g7-paper));
	}
	.g7__svg .clp__dot {
		fill: var(--sl-color-gray-1);
	}
	.g7__svg .clp__piston {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.g7__svg .clp__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.g7__svg .clp__burner {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
	}
	.g7__svg .clp__flame {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--ig-vy));
		opacity: 0.9;
	}
	.g7__svg .clp__rd {
		font-family: var(--ig-font-math);
		font-weight: 700;
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}
	.g7__svg .clp__rd--p {
		fill: var(--g7-gold);
	}
	.g7__svg .clp__rd--v {
		fill: var(--g7-blue);
	}
	.g7__svg .clp__rd--t {
		fill: var(--g7-red);
	}
	.g7__svg .clp__box {
		fill: color-mix(in oklab, var(--sl-color-accent) 16%, var(--g7-paper));
		stroke: var(--sl-color-accent);
		stroke-width: 1.2;
	}
	.g7__svg .clp__k {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 13px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .clp__kv {
		font-weight: 700;
		font-size: 14px;
		fill: var(--sl-color-white);
	}
	.g7__svg .clp__grid {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.g7__svg .clp__axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.g7__svg .clp__tick {
		fill: var(--sl-color-gray-3);
	}
	.g7__svg .clp__ax {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .clp__unit {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 12px;
	}
	.g7__svg .clp__trace {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
	}
	.g7__svg .clp__end {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.g7__svg .clp__num {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.g7__svg .clp__pt {
		fill: var(--sl-color-accent);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
</style>

<script>
	import { el, fmt, loop } from '../g7/kit';

	const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
	const f1 = (v: number) => v.toFixed(1);
	const gx = (v: number) => 244 + (v / 3.5) * 104;
	const gy = (p: number) => 186 - (p / 175) * 140;
	const KPX = 30; // px per литр (1 дм)
	const BOTTOM = 170;
	const CYCLE = 9;
	for (const root of document.querySelectorAll<HTMLElement>('[data-clp]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const gas = q<SVGRectElement>('[data-gas]');
		const piston = q<SVGRectElement>('[data-piston]');
		const screw = q<SVGLineElement>('[data-screw]');
		const sp1 = q<SVGLineElement>('[data-sp1]');
		const sp2 = q<SVGLineElement>('[data-sp2]');
		const flame = q<SVGPathElement>('[data-flame]');
		const trace = q<SVGPathElement>('[data-trace]');
		const pt = q<SVGCircleElement>('[data-pt]');
		let seed = 13;
		const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
		const dots = Array.from({ length: 14 }, () => {
			const c = el('circle', { class: 'clp__dot', r: 1.7 });
			q('[data-dots]').append(c);
			const a = rnd() * 6.283;
			return { c, u: rnd(), v: rnd(), a };
		});
		let t = 0;
		const state = (u: number) => {
			const V = 3.0 - 0.6 * u;
			const T = 300 + 60 * u;
			return { V, T, p: T / V };
		};
		const draw = (dt: number) => {
			t = (t + dt) % CYCLE;
			// u: 0 → 1 (0,6 … 4,0 s), hold, 1 → 0 (5,0 … 8,0 s)
			const up = t < 4.6;
			const u = up ? ease((t - 0.6) / 3.4) : 1 - ease((t - 5.0) / 3.0);
			const { V, T, p } = state(u);
			const top = BOTTOM - V * KPX;
			gas.setAttribute('y', f1(top));
			gas.setAttribute('height', f1(BOTTOM - top));
			piston.setAttribute('y', f1(top - 8));
			screw.setAttribute('y2', f1(top - 8));
			// the wheel turns with the screw: 1 turn per 6 px of travel
			const ang = ((top - 80) / 6) * Math.PI * 2;
			for (const [s, k] of [[sp1, 0], [sp2, Math.PI / 2]] as const) {
				const c = Math.cos(ang + k);
				s.setAttribute('x1', f1(74 - 22 * c));
				s.setAttribute('x2', f1(74 + 22 * c));
			}
			// the flame burns while the gas is heated
			const heating = up && t > 0.5 && t < 4.1;
			const fh = heating ? 16 + 2 * Math.sin(t * 17) : 0;
			flame.setAttribute('d', fh > 0 ? `M66 190 Q66 ${f1(190 - fh * 0.6)} 74 ${f1(190 - fh)} Q82 ${f1(190 - fh * 0.6)} 82 190 Z` : '');
			svg.style.setProperty('--heat', u.toFixed(3));
			q('[data-rp]').textContent = `p = ${fmt(p, 0)} кПа`;
			q('[data-rv]').textContent = `V = ${fmt(V, 2)} л`;
			q('[data-rt]').textContent = `T = ${fmt(T, 0)} К`;
			q('[data-rk]').textContent = `${fmt((p * V) / T, 2)} Дж/К`;
			// the graph: the trace from state 1 to the current state
			const seg: string[] = [];
			for (let i = 0; i <= 30; i++) {
				const s = state((u * i) / 30);
				seg.push(`${f1(gx(s.V))} ${f1(gy(s.p))}`);
			}
			trace.setAttribute('d', u > 0.002 ? `M${seg.join(' L')}` : '');
			pt.setAttribute('cx', f1(gx(V)));
			pt.setAttribute('cy', f1(gy(p)));
			// the dots: speed ∝ √T, inside the gas
			const k = Math.sqrt(T / 300);
			const h = BOTTOM - top;
			for (const d of dots) {
				d.u += Math.cos(d.a) * dt * k * 1.1;
				d.v += (Math.sin(d.a) * dt * k * 1.1 * 34) / h;
				if (d.u < 0 || d.u > 1) (d.a = Math.PI - d.a), (d.u = Math.min(1, Math.max(0, d.u)));
				if (d.v < 0 || d.v > 1) (d.a = -d.a), (d.v = Math.min(1, Math.max(0, d.v)));
				d.c.setAttribute('cx', f1(60 + d.u * 28));
				d.c.setAttribute('cy', f1(top + 3 + d.v * (h - 6)));
			}
		};
		loop(root, (dt) => {
			draw(dt);
			return true;
		});
		draw(0);
	}
</script>
