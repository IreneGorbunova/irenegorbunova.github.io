---
/**
 * Interactive model: an ideal gas in a vessel with a piston.
 * Temperature sets the speeds of the molecules, the piston sets the volume, molecules can be pumped
 * in or let out. The pressure sensor counts the momentum the molecules give to the walls; the three
 * graphs p(V), V(T), p(T) show the state of the gas. In an isoprocess one of p, V, T is kept constant.
 * Physics: gas-sim.ts. Real proportions: 1 px = 1 mm, the piston area is 1 dm², so 1 l = 1 dm of height.
 */
import { W, PX_PER_L, T_MIN, T_MAX, V_MIN, V_MAX } from './gas-sim';

const uid = `gl-${Math.random().toString(36).slice(2, 8)}`;
const X0 = 92; // left edge of the box for the molecule centres
const YB = 390; // bottom of that box
const RD = 3.5; // radius of a dot
const WALL = 5;
const inL = X0 - RD;
const inR = X0 + W + RD;
const inB = YB + RD;
const glassTop = YB - V_MAX * PX_PER_L - RD - 16 - 8;
const grads = [0.5, 1, 1.5, 2, 2.5, 3].map((v) => ({ v, y: YB - v * PX_PER_L - RD }));
const TH_X = 324; // thermometer
const thY = (t: number) => 372 - (t / 700) * 262;
const thTicks = [100, 200, 300, 400, 500, 600];
const valveY0 = YB - 38;
const valveY1 = YB - 4;
---

<figure class="gl not-content" data-gaslab data-uid={uid}>
	<div class="gl__top">
		<div class="gl__scene-wrap">
			<svg
				class="gl__scene"
				viewBox="0 0 360 430"
				role="img"
				aria-label="Сосуд с газом под поршнем: точки — молекулы, справа термометр, снизу нагреватель, слева кран"
			>
				<defs>
					<clipPath id={`${uid}-gas`}>
						<rect x={inL} y={0} width={inR - inL} height={inB} />
					</clipPath>
					<linearGradient id={`${uid}-steel`} x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" class="gl__steel-hi" />
						<stop offset="1" class="gl__steel-lo" />
					</linearGradient>
				</defs>

				<!-- heater / thermostat plate -->
				<rect class="gl__heater" x={inL - 10} y={inB + WALL + 6} width={inR - inL + 20} height="10" rx="5" data-heater />

				<!-- gas region -->
				<rect class="gl__gasfill" x={inL} y="0" width={inR - inL} height={inB} data-gasfill />

				<!-- graduations (volume scale on the glass) -->
				<g class="gl__grad">
					{
						grads.map((g) => (
							<>
								<line x1={inL} x2={inL + (Number.isInteger(g.v) ? 10 : 6)} y1={g.y} y2={g.y} />
								<text x={inL - WALL - 6} y={g.y + 4.5} text-anchor="end">
									{String(g.v).replace('.', ',')}
								</text>
							</>
						))
					}
					<text class="gl__unit" x={inL - WALL - 6} y={glassTop + 6} text-anchor="end">
						<tspan font-style="italic">V</tspan>, л
					</text>
				</g>

				<!-- molecules -->
				<g clip-path={`url(#${uid}-gas)`}>
					<g data-flashes></g>
					<path class="gl__m gl__m0" data-m="0"></path>
					<path class="gl__m gl__m1" data-m="1"></path>
					<path class="gl__m gl__m2" data-m="2"></path>
					<path class="gl__m gl__m3" data-m="3"></path>
					<path class="gl__m gl__m4" data-m="4"></path>
				</g>

				<!-- valve on the left wall -->
				<g class="gl__valve" data-valve>
					<rect class="gl__pipe" x="22" y={valveY0} width={inL - WALL - 22} height={valveY1 - valveY0} />
					<g data-escapes></g>
					<g class="gl__tap-handle" data-tap>
						<line x1="48" x2="48" y1={(valveY0 + valveY1) / 2} y2={valveY0 - 17} />
						<circle cx="48" cy={valveY0 - 17} r="3.5" />
					</g>
					<circle class="gl__tap" cx="48" cy={(valveY0 + valveY1) / 2} r="9" />
					<path class="gl__flow" d="" data-flow />
				</g>

				<!-- glass -->
				<path
					class="gl__glass"
					d={`M ${inL - WALL} ${glassTop} V ${inB + WALL} H ${inR + WALL} V ${glassTop} H ${inR} V ${inB} H ${inL} V ${glassTop} Z`}
				/>
				<rect class="gl__valve-hole" x={inL - WALL - 0.5} y={valveY0} width={WALL + 1} height={valveY1 - valveY0} />

				<!-- piston, rod, handle, load, stops -->
				<g data-piston>
					<g class="gl__stops" data-stops>
						<path d={`M ${inL} -25 h 11 l -11 9 z`} />
						<path d={`M ${inR} -25 h -11 l 11 9 z`} />
					</g>
					<rect class="gl__rod" x={X0 + W / 2 - 4} y="-62" width="8" height="46" />
					<g class="gl__load" data-load>
						<rect x={X0 + W / 2 - 52} y="-42" width="104" height="26" rx="4" />
						<text x={X0 + W / 2} y="-24.5" text-anchor="middle">груз</text>
					</g>
					<g class="gl__handle" data-handle>
						<rect x={X0 + W / 2 - 38} y="-74" width="76" height="16" rx="8" />
						<path d={`M ${X0 + W / 2 - 22} -66 l 5 -4 l 5 4 M ${X0 + W / 2 + 12} -66 l 5 4 l 5 -4`} />
					</g>
					<rect class="gl__piston" x={inL} y="-16" width={inR - inL} height="16" rx="2" fill={`url(#${uid}-steel)`} />
					<rect class="gl__piston-face" x={inL} y="-2" width={inR - inL} height="2" />
					<g class="gl__lock" data-vlock transform={`translate(${X0 + W / 2 + 46} -78)`}>
						<path d="M -4.5 -3 v -3 a 4.5 4.5 0 0 1 9 0 v 3" />
						<rect x="-7" y="-3" width="14" height="11" rx="2" />
					</g>
					<rect class="gl__grab" x={inL - 10} y="-80" width={inR - inL + 20} height="84" data-grab />
				</g>

				<!-- thermometer -->
				<g class="gl__thermo">
					<rect class="gl__th-tube" x={TH_X - 6} y={thY(700) - 6} width="12" height={thY(0) - thY(700) + 12} rx="6" />
					<circle class="gl__th-bulb" cx={TH_X} cy={thY(0) + 14} r="11" />
					<rect class="gl__th-col" x={TH_X - 3} width="6" y={thY(300)} height={thY(0) - thY(300) + 10} data-thcol />
					{
						thTicks.map((t) => (
							<>
								<line x1={TH_X - 6} x2={TH_X - 1} y1={thY(t)} y2={thY(t)} />
								<text x={TH_X + 10} y={thY(t) + 4.5} class="gl__thlabel">
									{t}
								</text>
							</>
						))
					}
					<text class="gl__unit" x={TH_X + 2} y={thY(700) - 16} text-anchor="middle">
						<tspan font-style="italic">T</tspan>, К
					</text>
					<g class="gl__lock" data-tlock transform={`translate(${TH_X - 22} ${thY(700) - 2})`}>
						<path d="M -4.5 -3 v -3 a 4.5 4.5 0 0 1 9 0 v 3" />
						<rect x="-7" y="-3" width="14" height="11" rx="2" />
					</g>
				</g>
			</svg>
		</div>

		<div class="gl__panel">
			<div class="gl__modes" role="group" aria-label="Какой процесс проводим">
				<button type="button" class="gl__mode" data-mode="free" aria-pressed="true">
					Любой процесс<small>меняется всё</small>
				</button>
				<button type="button" class="gl__mode" data-mode="T" aria-pressed="false">
					Изотермический<small><i>T</i> = const</small>
				</button>
				<button type="button" class="gl__mode" data-mode="p" aria-pressed="false">
					Изобарный<small><i>p</i> = const</small>
				</button>
				<button type="button" class="gl__mode" data-mode="V" aria-pressed="false">
					Изохорный<small><i>V</i> = const</small>
				</button>
			</div>

			<label class="gl__slider" data-row="T">
				<span class="gl__slider-name">Температура <i>T</i></span>
				<output data-t-out>300 К</output>
				<input type="range" min={T_MIN} max={T_MAX} step="1" value="300" data-t-in />
			</label>
			<label class="gl__slider" data-row="V">
				<span class="gl__slider-name">Объём <i>V</i> <span class="gl__aside">— или тяните поршень</span></span>
				<output data-v-out>2,00 л</output>
				<input type="range" min={V_MIN} max={V_MAX} step="0.01" value="2" data-v-in />
			</label>

			<div class="gl__gas" data-row="N">
				<div class="gl__gas-text">
					<span class="gl__slider-name">Количество газа</span>
					<output data-n-out><i>ν</i> = 0,080 моль</output>
				</div>
				<div class="gl__gas-btns">
					<button type="button" class="gl__btn gl__btn--small" data-add>+ Накачать</button>
					<button type="button" class="gl__btn gl__btn--small" data-release>− Выпустить</button>
				</div>
			</div>

			<div class="gl__sensor">
				<div class="gl__sensor-text">
					<span class="gl__sensor-name">Датчик давления <span class="gl__aside">(удары молекул)</span></span>
					<strong data-pmeas>— кПа</strong>
				</div>
				<svg class="gl__spark" viewBox="0 0 150 46" preserveAspectRatio="none" aria-hidden="true">
					<path class="gl__spark-f" data-spark-f></path>
					<path class="gl__spark-m" data-spark-m></path>
				</svg>
			</div>

			<div class="gl__formula" data-formula aria-live="off"></div>
		</div>
	</div>

	<div class="gl__plot-tabs" role="group" aria-label="Какой график показать">
		<button type="button" aria-pressed="true" data-tab="0"><i>p</i>(<i>V</i>)</button>
		<button type="button" aria-pressed="false" data-tab="1"><i>V</i>(<i>T</i>)</button>
		<button type="button" aria-pressed="false" data-tab="2"><i>p</i>(<i>T</i>)</button>
	</div>
	<div class="gl__plots">
		<div class="gl__plot is-active">
			<p class="gl__plot-title"><i>p</i>(<i>V</i>)</p>
			<svg viewBox="0 0 240 196" data-plot="pV" role="img" aria-label="График зависимости давления от объёма"></svg>
		</div>
		<div class="gl__plot">
			<p class="gl__plot-title"><i>V</i>(<i>T</i>)</p>
			<svg viewBox="0 0 240 196" data-plot="VT" role="img" aria-label="График зависимости объёма от температуры"></svg>
		</div>
		<div class="gl__plot">
			<p class="gl__plot-title"><i>p</i>(<i>T</i>)</p>
			<svg viewBox="0 0 240 196" data-plot="pT" role="img" aria-label="График зависимости давления от температуры"></svg>
		</div>
	</div>

	<div class="gl__bar">
		<button type="button" class="gl__btn" data-play>Пауза</button>
		<button type="button" class="gl__btn" data-clear>Стереть след</button>
		<p class="gl__hint" data-hint aria-live="polite"></p>
	</div>

	<figcaption class="gl__legend">
		<span class="gl__ramp" aria-hidden="true"></span> Цвет молекулы — её скорость: от медленных к быстрым.
		Каждая точка изображает 0,001 моль азота (6·10<sup>20</sup> молекул), движение замедлено в 3000 раз.
		Столкновения молекул друг с другом не показаны: на давление они не влияют. Молекул в модели мало, поэтому
		показания датчика колеблются на несколько процентов: на маленьком графике сплошная линия — датчик, штриховая —
		давление по формуле. В среднем они совпадают. Точку состояния на графиках можно перетаскивать.
	</figcaption>
	<p class="gl__sr" data-live aria-live="polite"></p>
</figure>

<style is:global>
	.gl {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		--gl-gas: color-mix(in srgb, var(--ig-vx) 7%, transparent);
	}
	.gl i {
		font-family: var(--ig-font-math);
	}
	.gl__top {
		display: grid;
		grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
		gap: 1rem;
		align-items: start;
	}
	.gl__scene {
		display: block;
		width: 100%;
		height: auto;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}
	.gl__scene text {
		font-family: var(--__sl-font);
		font-size: 14px;
		fill: var(--sl-color-gray-3);
	}
	.gl__scene .gl__unit {
		fill: var(--sl-color-gray-2);
		font-size: 14px;
	}
	.gl__glass {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 22%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.gl__gasfill {
		fill: var(--gl-gas);
	}
	.gl__grad line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.gl__m {
		stroke: none;
	}
	.gl__m0 {
		fill: var(--ig-vx);
	}
	.gl__m1 {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--ig-v));
	}
	.gl__m2 {
		fill: var(--ig-v);
	}
	.gl__m3 {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--ig-vy));
	}
	.gl__m4 {
		fill: var(--ig-vy);
	}
	.gl__flash {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	.gl__heater {
		fill: color-mix(in oklab, var(--ig-vy) calc(var(--heat, 0.4) * 100%), var(--ig-vx));
		filter: drop-shadow(0 0 calc(2px + var(--heat-glow, 0.4) * 9px) color-mix(in oklab, var(--ig-vy) calc(var(--heat, 0.4) * 100%), var(--ig-vx)));
	}
	.gl__steel-hi {
		stop-color: var(--sl-color-gray-3);
	}
	.gl__steel-lo {
		stop-color: var(--sl-color-gray-4);
	}
	.gl__piston {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.gl__piston-face {
		fill: var(--sl-color-gray-2);
	}
	.gl__rod {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
	.gl__handle rect {
		fill: var(--sl-color-accent);
	}
	.gl__handle path {
		fill: none;
		stroke: var(--sl-color-black);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.gl__grab {
		fill: transparent;
		cursor: grab;
	}
	.gl.is-dragging .gl__grab {
		cursor: grabbing;
	}
	.gl[data-mode='V'] .gl__grab {
		cursor: not-allowed;
	}
	.gl[data-mode='V'] .gl__handle rect {
		fill: var(--sl-color-gray-4);
	}
	.gl__load rect {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-3);
	}
	.gl__scene .gl__load text {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
	}
	.gl__stops path {
		fill: var(--sl-color-gray-2);
	}
	.gl__lock rect {
		fill: var(--sl-color-accent);
	}
	.gl__lock path {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
	}
	.gl__load,
	.gl__stops,
	.gl__lock {
		opacity: 0;
		transition: opacity 0.35s;
	}
	.gl[data-mode='p'] .gl__load,
	.gl[data-mode='V'] .gl__stops,
	.gl[data-mode='V'] [data-vlock],
	.gl[data-mode='T'] [data-tlock] {
		opacity: 1;
	}
	.gl__th-tube {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 15%, transparent);
		stroke: var(--sl-color-gray-3);
	}
	.gl__th-bulb {
		fill: var(--ig-vy);
	}
	.gl__th-col {
		fill: var(--ig-vy);
	}
	.gl__thermo line {
		stroke: var(--sl-color-gray-3);
	}
	.gl__pipe {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 18%, transparent);
		stroke: var(--sl-color-gray-3);
	}
	.gl__valve-hole {
		fill: var(--gl-gas);
	}
	.gl__tap {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.gl__tap-handle {
		stroke: var(--sl-color-accent);
		stroke-width: 3.5;
		stroke-linecap: round;
		fill: var(--sl-color-accent);
		transform-origin: 48px 369px;
		transition: transform 0.3s;
	}
	.gl.is-valve-open .gl__tap-handle {
		transform: rotate(-90deg);
	}
	.gl__escape {
		fill: var(--ig-v);
	}
	.gl__flow {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* panel */
	.gl__panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.7rem;
		min-width: 0;
	}
	.gl__modes {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.4rem;
	}
	.gl__mode {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.05rem;
		margin: 0;
		padding: 0.4rem 0.7rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.25;
		text-align: start;
		color: var(--sl-color-white);
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.7rem;
		cursor: pointer;
		transition:
			background 0.2s,
			border-color 0.2s;
	}
	.gl__mode small {
		font-size: var(--sl-text-xs);
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
	.gl__mode:hover {
		border-color: var(--sl-color-accent);
	}
	.gl__mode[aria-pressed='true'] {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.gl__mode[aria-pressed='true'] small {
		color: var(--sl-color-black);
		opacity: 0.8;
	}
	.gl__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.15rem 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.gl__slider output,
	.gl__gas output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.gl__slider input {
		grid-column: 1 / -1;
		width: 100%;
		margin: 0;
		accent-color: var(--sl-color-accent);
	}
	.gl__slider.is-locked,
	.gl__gas.is-locked {
		opacity: 0.5;
	}
	.gl__slider.is-locked .gl__slider-name::after,
	.gl__gas.is-locked .gl__slider-name::after {
		content: ' — не меняется';
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	.gl__aside {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.gl__gas {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.gl__gas-text {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
		flex-wrap: wrap;
	}
	.gl__gas-btns {
		display: flex;
		gap: 0.4rem;
	}
	.gl__sensor {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.75rem;
		align-items: center;
		padding: 0.5rem 0.75rem;
		border-radius: 0.7rem;
		background: var(--sl-color-gray-6);
	}
	.gl__sensor-text {
		display: flex;
		flex-direction: column;
	}
	.gl__sensor-name {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.gl__sensor strong {
		font-size: var(--sl-text-2xl);
		line-height: 1.2;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.gl__spark {
		width: 100%;
		height: 46px;
	}
	.gl__spark-f {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
		vector-effect: non-scaling-stroke;
	}
	.gl__spark-m {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.6;
		vector-effect: non-scaling-stroke;
	}
	.gl__formula {
		min-height: 5.6rem;
		padding: 0.1rem 0.25rem;
		font-size: 0.95em;
