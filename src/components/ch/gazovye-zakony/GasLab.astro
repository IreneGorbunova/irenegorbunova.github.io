	.gl__iso--x {
		stroke-dasharray: 3 5;
		opacity: 0.85;
	}
	.gl__trail {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.55;
	}
	.gl__pt {
		fill: var(--ig-v);
		stroke: var(--ig-surface);
		stroke-width: 1.5;
	}
	.gl__halo {
		fill: var(--ig-v);
		opacity: 0.22;
	}

	.gl__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 0.75rem;
