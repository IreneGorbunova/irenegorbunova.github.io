		flex: 1 1 14rem;
		margin: 0;
		min-height: 1.4em;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.gl__btn {
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.45rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
