	.gl__ramp {
		display: inline-block;
		width: 3.2rem;
		height: 0.55rem;
		margin-right: 0.25rem;
		border-radius: 999px;
		vertical-align: 0.05rem;
		background: linear-gradient(90deg, var(--ig-vx), var(--ig-v), var(--ig-vy));
	}
	.gl__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.gl__plot-tabs {
		display: none;
	}
	@media (max-width: 50rem) {
		.gl__top {
			grid-template-columns: minmax(0, 1fr);
		}
		.gl__plot-tabs {
			display: flex;
			gap: 0.4rem;
			margin-top: 1rem;
		}
		.gl__plot-tabs button {
			flex: 1;
			margin: 0;
			padding: 0.35rem 0.5rem;
			font: inherit;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-white);
			background: transparent;
			border: 1px solid var(--sl-color-gray-4);
			border-radius: 999px;
			cursor: pointer;
		}
		.gl__plot-tabs button[aria-pressed='true'] {
			background: var(--sl-color-accent);
			border-color: var(--sl-color-accent);
			color: var(--sl-color-black);
		}
		.gl__plots {
			margin-top: 0.5rem;
		}
		.gl__plot:not(.is-active) {
			display: none;
		}
		.gl__scene-wrap {
			max-width: 26rem;
			margin-inline: auto;
		}
		.gl__plots {
			grid-template-columns: 1fr;
		}
		.gl__plot svg {
			max-width: 26rem;
			margin-inline: auto;
		}
		.gl__plot text {
			font-size: 13px;
		}
	}
	@media (max-width: 40rem) {
		.gl {
			padding: 0.75rem;
		}
	}
</style>

<script>
	import katex from 'katex';
	import {
		GasSim,
		R,
		M,
		NU_DOT,
		W,
		PX_PER_L,
		T_MIN,
		T_MAX,
		V_MIN,
		V_MAX,
		N_MIN,
		N_MAX,
		sigma,
	} from './gas-sim';

	type Mode = 'free' | 'T' | 'p' | 'V';
	type State = { T: number; V: number; p: number };
	type PlotKind = 'pV' | 'VT' | 'pT';

	const SVG_NS = 'http://www.w3.org/2000/svg';
	const X0 = 92;
	const YB = 390;
	const RD = 3.5;
	const V_RATE = 0.7; // л/с — поршень двигают плавно
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const capture = (e: Element, id: number) => {
		try {
			e.setPointerCapture(id);
		} catch {
			/* the pointer is already gone */
		}
	};

	const fmt = (v: number, d: number) =>
		v.toLocaleString('ru-RU', { minimumFractionDigits: d, maximumFractionDigits: d }).replace('-', '−');
	const tex = (v: number, d: number) => v.toFixed(d).replace('.', '{,}');
	const kpaDigits = (p: number) => (p < 10 ? 2 : p < 100 ? 1 : 0);
	const fmtKpa = (pa: number) => `${fmt(pa / 1e3, kpaDigits(pa / 1e3))} кПа`;
	const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
	const pOf = (nu: number, T: number, V: number) => (nu * R * T) / (V * 1e-3); // Па
	const NICE = [10, 20, 25, 50, 75, 100, 150, 200, 250, 300, 400, 500, 600, 800, 1000, 1200, 1500, 2000];
	const niceUp = (v: number) => NICE.find((n) => n >= v) ?? Math.ceil(v / 500) * 500;
	const tickStep = (max: number) => {
		const raw = max / 4;
		const pow = 10 ** Math.floor(Math.log10(raw));
		const m = [1, 2, 2.5, 5, 10].find((k) => k * pow >= raw)!;
		return m * pow;
	};
	const el = <K extends keyof SVGElementTagNameMap>(name: K, attrs: Record<string, string | number> = {}) => {
		const e = document.createElementNS(SVG_NS, name);
		for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
		return e;
	};

	/* ---------- plots ---------- */
	const PL = { L: 44, R: 226, T: 30, B: 166 };
	const ISO_NAMES: Record<Exclude<Mode, 'free'>, string> = { T: 'изотерма', p: 'изобара', V: 'изохора' };

	class Plot {
		kind: PlotKind;
		svg: SVGSVGElement;
		grid = el('g', { class: 'gl__grid' });
		ticks = el('g');
		iso = el('path', { class: 'gl__iso' });
		isoX = el('path', { class: 'gl__iso gl__iso--x' });
		isoLabel = el('text', { class: 'gl__isolabel' });
		trail = el('path', { class: 'gl__trail' });
		halo = el('circle', { class: 'gl__halo', r: 11 });
		pt = el('circle', { class: 'gl__pt', r: 5.5 });
		xMax = 1;
		yMax = 1;
		constructor(svg: SVGSVGElement, kind: PlotKind, uid: string) {
			this.svg = svg;
			this.kind = kind;
			const clipId = `${uid}-${kind}-clip`;
			const defs = el('defs');
			const cp = el('clipPath', { id: clipId });
			cp.append(el('rect', { x: PL.L, y: PL.T - 6, width: PL.R - PL.L + 6, height: PL.B - PL.T + 6 }));
			defs.append(cp);
			const clipped = el('g', { 'clip-path': `url(#${clipId})` });
			clipped.append(this.isoX, this.iso, this.trail);
			const axes = el('path', {
				class: 'gl__axis',
				d: `M ${PL.L} ${PL.T - 8} V ${PL.B} H ${PL.R + 8} M ${PL.L - 4} ${PL.T - 2} L ${PL.L} ${PL.T - 10} L ${PL.L + 4} ${PL.T - 2} M ${PL.R + 1} ${PL.B - 4} L ${PL.R + 9} ${PL.B} L ${PL.R + 1} ${PL.B + 4}`,
			});
			const [xn, yn] = { pV: ['V, л', 'p, кПа'], VT: ['T, К', 'V, л'], pT: ['T, К', 'p, кПа'] }[kind];
			const xName = el('text', { class: 'gl__axname', x: PL.R + 8, y: PL.B + 26, 'text-anchor': 'end' });
			xName.innerHTML = `<tspan font-style="italic">${xn[0]}</tspan>${xn.slice(1)}`;
			const yName = el('text', { class: 'gl__axname', x: PL.L + 9, y: PL.T - 14 });
			yName.innerHTML = `<tspan font-style="italic">${yn[0]}</tspan>${yn.slice(1)}`;
			svg.append(defs, this.grid, axes, this.ticks, clipped, this.isoLabel, this.halo, this.pt, xName, yName);
		}
		X(v: number) {
			return PL.L + (v / this.xMax) * (PL.R - PL.L);
		}
		Y(v: number) {
			return PL.B - (v / this.yMax) * (PL.B - PL.T);
		}
		/** Data value of the x and y axes for a state. */
		coords(s: State): [number, number] {
			if (this.kind === 'pV') return [s.V, s.p / 1e3];
			if (this.kind === 'VT') return [s.T, s.V];
			return [s.T, s.p / 1e3];
		}
		setAxes(xMax: number, yMax: number) {
			const changed = Math.abs(xMax - this.xMax) > 1e-9 || Math.abs(yMax - this.yMax) > 1e-6;
			this.xMax = xMax;
			this.yMax = yMax;
			if (!changed) return;
			this.grid.replaceChildren();
			this.ticks.replaceChildren();
			const xs = this.kind === 'pV' ? 1 : 200;
			const ys = this.kind === 'VT' ? 1 : tickStep(yMax);
			for (let v = xs; v <= xMax + 1e-9; v += xs) {
				this.grid.append(el('line', { x1: this.X(v), x2: this.X(v), y1: PL.B, y2: PL.T }));
				const t = el('text', { x: this.X(v), y: PL.B + 14, 'text-anchor': 'middle' });
				t.textContent = String(v);
				this.ticks.append(t);
			}
			for (let v = ys; v <= yMax + 1e-9; v += ys) {
				this.grid.append(el('line', { x1: PL.L, x2: PL.R, y1: this.Y(v), y2: this.Y(v) }));
				const t = el('text', { x: PL.L - 6, y: this.Y(v) + 4, 'text-anchor': 'end' });
				t.textContent = fmt(v, Number.isInteger(v) ? 0 : 1);
				this.ticks.append(t);
			}
			const z = el('text', { x: PL.L - 6, y: PL.B + 14, 'text-anchor': 'end' });
			z.textContent = '0';
			this.ticks.append(z);
		}
		/** Draw the isoline of the process through state s; nu is the amount of gas. */
		drawIso(mode: Mode, s: State, nu: number) {
			let d = '';
			let dx = '';
			type Lab = [number, number, 'start' | 'end'];
			let cands: Lab[] = [];
			const k = this.kind;
			const vert = (x: number): Lab[] => [
				[x + 5, PL.T + 12, 'start'],
				[x + 5, PL.B - 8, 'start'],
				[x - 5, PL.T + 12, 'end'],
			];
			const horiz = (y: number): Lab[] => [
				[PL.R - 2, y - 7, 'end'],
				[PL.L + 6, y - 7, 'start'],
				[PL.R - 2, y + 16, 'end'],
			];
			const origin = (slope: number) => {
				const tEnd = Math.min(this.xMax, this.yMax / slope);
				d = `M ${this.X(T_MIN)} ${this.Y(slope * T_MIN)} L ${this.X(tEnd)} ${this.Y(slope * tEnd)}`;
				dx = `M ${this.X(0)} ${this.Y(0)} L ${this.X(T_MIN)} ${this.Y(slope * T_MIN)}`;
				cands = [0.88, 0.55, 0.35].map((f): Lab => [this.X(f * tEnd) - 7, this.Y(slope * f * tEnd) - 5, 'end']);
			};
			if (mode === 'T') {
				if (k === 'pV') {
					const C = nu * R * s.T; // pV in кПа·л (1 кПа·л = 1 Дж)
					const pts: string[] = [];
					const v0 = Math.max(0.05, C / (this.yMax * 1.05));
					for (let i = 0; i <= 80; i++) {
						const v = v0 + ((this.xMax - v0) * i) / 80;
						pts.push(`${this.X(v).toFixed(1)},${this.Y(C / v).toFixed(1)}`);
					}
					d = `M ${pts.join(' L ')}`;
					cands = [
						[this.X(this.xMax) - 4, this.Y(C / this.xMax) - 8, 'end'],
						[this.X(this.xMax) - 4, this.Y(C / this.xMax) + 17, 'end'],
					];
				} else {
					d = `M ${this.X(s.T)} ${PL.B} V ${PL.T - 6}`;
					cands = vert(this.X(s.T));
				}
			} else if (mode === 'p') {
				const p = s.p / 1e3;
				if (k === 'pV' || k === 'pT') {
					d = `M ${PL.L} ${this.Y(p)} H ${PL.R}`;
					cands = horiz(this.Y(p));
				} else origin(((nu * R) / s.p) * 1e3); // V = νRT/p, л/К
			} else if (mode === 'V') {
				if (k === 'pV') {
					d = `M ${this.X(s.V)} ${PL.B} V ${PL.T - 6}`;
					cands = vert(this.X(s.V));
				} else if (k === 'VT') {
					d = `M ${PL.L} ${this.Y(s.V)} H ${PL.R}`;
					cands = horiz(this.Y(s.V));
				} else origin((nu * R) / (s.V * 1e-3) / 1e3); // p = νRT/V, кПа/К
			}
			this.iso.setAttribute('d', d);
			this.isoX.setAttribute('d', dx);
			if (mode === 'free' || !cands.length) {
				this.isoLabel.textContent = '';
				return;
			}
			// keep the label away from the state point
			const [a, b] = this.coords(s);
			const px = this.X(a);
			const py = this.Y(b);
			const dist = (c: Lab) => Math.hypot(c[0] + (c[2] === 'end' ? -26 : 26) - px, c[1] - 4 - py);
			const lab = cands.find((c) => dist(c) > 42) ?? cands.reduce((m, c) => (dist(c) > dist(m) ? c : m));
			this.isoLabel.textContent = ISO_NAMES[mode];
			this.isoLabel.setAttribute('x', lab[0].toFixed(1));
			this.isoLabel.setAttribute('y', Math.max(PL.T - 2, Math.min(PL.B - 6, lab[1])).toFixed(1));
			this.isoLabel.setAttribute('text-anchor', lab[2]);
		}
		drawTrail(trail: State[]) {
			if (trail.length < 2) {
				this.trail.setAttribute('d', '');
				return;
			}
			let d = '';
			for (let i = 0; i < trail.length; i++) {
				const [a, b] = this.coords(trail[i]);
				d += `${i ? 'L' : 'M'}${this.X(a).toFixed(1)} ${this.Y(b).toFixed(1)}`;
			}
			this.trail.setAttribute('d', d);
		}
		drawPoint(s: State) {
			const [a, b] = this.coords(s);
			const x = this.X(a);
			const y = this.Y(b);
			const out = y < PL.T - 4;
			for (const c of [this.pt, this.halo]) {
				c.setAttribute('cx', x.toFixed(1));
				c.setAttribute('cy', Math.max(PL.T - 4, y).toFixed(1));
				c.style.opacity = out ? '0.35' : '';
			}
		}
		/** Pointer position in data units. */
		toData(ev: PointerEvent): [number, number] {
			const m = this.svg.getScreenCTM();
			if (!m) return [0, 0];
			const pt = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
			return [((pt.x - PL.L) / (PL.R - PL.L)) * this.xMax, ((PL.B - pt.y) / (PL.B - PL.T)) * this.yMax];
		}
	}

	/* ---------- the model ---------- */
	for (const root of document.querySelectorAll<HTMLElement>('[data-gaslab]')) {
		const uid = root.dataset.uid!;
		const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const tIn = q<HTMLInputElement>('[data-t-in]');
		const vIn = q<HTMLInputElement>('[data-v-in]');
		const tOut = q<HTMLOutputElement>('[data-t-out]');
		const vOut = q<HTMLOutputElement>('[data-v-out]');
		const nOut = q<HTMLOutputElement>('[data-n-out]');
		const rowT = q<HTMLElement>('[data-row="T"]');
		const rowV = q<HTMLElement>('[data-row="V"]');
		const rowN = q<HTMLElement>('[data-row="N"]');
		const addBtn = q<HTMLButtonElement>('[data-add]');
		const relBtn = q<HTMLButtonElement>('[data-release]');
		const pMeasOut = q<HTMLElement>('[data-pmeas]');
		const sparkM = q<SVGPathElement>('[data-spark-m]');
		const sparkF = q<SVGPathElement>('[data-spark-f]');
		const formula = q<HTMLElement>('[data-formula]');
		const hint = q<HTMLElement>('[data-hint]');
		const live = q<HTMLElement>('[data-live]');
		const playBtn = q<HTMLButtonElement>('[data-play]');
		const piston = q<SVGGElement>('[data-piston]');
		const grab = q<SVGRectElement>('[data-grab]');
		const heater = q<SVGRectElement>('[data-heater]');
		const gasfill = q<SVGRectElement>('[data-gasfill]');
		const thCol = q<SVGRectElement>('[data-thcol]');
		const flashG = q<SVGGElement>('[data-flashes]');
		const escG = q<SVGGElement>('[data-escapes]');
		const flow = q<SVGPathElement>('[data-flow]');
		const scene = q<SVGSVGElement>('.gl__scene');
		const mPaths = [0, 1, 2, 3, 4].map((i) => q<SVGPathElement>(`[data-m="${i}"]`));
		const modeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode]'));
		const plots = (['pV', 'VT', 'pT'] as PlotKind[]).map((k) => new Plot(q<SVGSVGElement>(`[data-plot="${k}"]`), k, uid));

		const sim = new GasSim(80, 300, 2);
		sim.warmUp(8);

		let mode: Mode = 'free';
		let Tt = 300; // target temperature (slider)
		let Vt = 2; // target volume
		let Ts = 300; // current (smoothed) temperature
		let Vs = 2; // current volume
		let pLock = pOf(sim.nu, Ts, Vs);
		let pAxis = 200;
		let pAxisTarget = 200;
		let trail: State[] = [];
		let playing = !reduceMotion.matches;
		let visible = false;
		let raf = 0;
		let last = 0;
		let formulaKey = '';
		let narrowFormula = false;
		let formulaClock = 0;
		let liveClock = 0;
		let sparkClock = 0;
		const spark: { m: number; f: number }[] = [];
		let hintTimer = 0;

		const nu = () => sim.nu;
		const state = (): State => ({ T: Ts, V: Vs, p: pOf(nu(), Ts, Vs) });

		const say = (text: string, ms = 4000) => {
			hint.textContent = text;
			clearTimeout(hintTimer);
			if (ms) hintTimer = window.setTimeout(() => (hint.textContent = ''), ms);
		};

		/* --- flashes at the walls --- */
		type Flash = { c: SVGCircleElement; t: number };
		const flashes: Flash[] = [];
		for (let i = 0; i < 30; i++) {
			const c = el('circle', { class: 'gl__flash', r: 0 });
			c.style.opacity = '0';
			flashG.append(c);
			flashes.push({ c, t: 1 });
		}
		let flashCursor = 0;
		const addFlash = (x: number, y: number) => {
			const f = flashes[flashCursor];
			if (f.t < 0.12) return; // pool busy: skip
			flashCursor = (flashCursor + 1) % flashes.length;
			f.t = 0;
			f.c.setAttribute('cx', (X0 + x).toFixed(1));
			f.c.setAttribute('cy', (YB - y).toFixed(1));
		};
		type Esc = { c: SVGCircleElement; t: number; y: number };
		const escapes: Esc[] = [];
		const addEscape = (y: number) => {
			const c = el('circle', { class: 'gl__escape', r: RD });
			escG.append(c);
			escapes.push({ c, t: 0, y: YB - y });
		};

		/* --- drawing --- */
		const drawMolecules = () => {
			const s300 = sigma(300);
			const b = ['', '', '', '', ''];
			const r = RD;
			for (let i = 0; i < sim.n; i++) {
				const sp = Math.hypot(sim.vx[i], sim.vy[i]) / s300;
				const k = sp < 0.85 ? 0 : sp < 1.2 ? 1 : sp < 1.55 ? 2 : sp < 2 ? 3 : 4;
				const x = X0 + sim.x[i];
				const y = YB - sim.y[i];
				b[k] += `M${(x - r).toFixed(1)} ${y.toFixed(1)}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;
			}
			for (let k = 0; k < 5; k++) mPaths[k].setAttribute('d', b[k]);
		};

		const drawScene = () => {
			const h = Vs * PX_PER_L;
			piston.setAttribute('transform', `translate(0 ${(YB - h - RD).toFixed(2)})`);
			gasfill.setAttribute('y', (YB - h - RD).toFixed(2));
			gasfill.setAttribute('height', (h + 2 * RD).toFixed(2));
			const heat = (Ts - T_MIN) / (T_MAX - T_MIN);
			heater.style.setProperty('--heat', heat.toFixed(3));
			heater.style.setProperty('--heat-glow', Math.abs(heat - 0.4).toFixed(3));
			const top = 372 - (Ts / 700) * 262;
			thCol.setAttribute('y', top.toFixed(1));
			thCol.setAttribute('height', (372 - top + 10).toFixed(1));
		};

		const updateAxes = (dt: number) => {
			const s = state();
			const pk = s.p / 1e3;
			let maxSeen = pk;
			for (const t of trail) maxSeen = Math.max(maxSeen, t.p / 1e3);
			if (mode === 'T') pAxisTarget = niceUp(1.08 * (pOf(nu(), Ts, V_MIN) / 1e3));
			else if (mode === 'V') pAxisTarget = niceUp(1.08 * (pOf(nu(), T_MAX, Vs) / 1e3));
			else if (mode === 'p') pAxisTarget = niceUp(1.5 * pk);
			else pAxisTarget = niceUp(1.15 * maxSeen);
			pAxis = dt > 0 ? pAxis + (pAxisTarget - pAxis) * (1 - Math.exp(-dt / 0.25)) : pAxisTarget;
			if (Math.abs(pAxis - pAxisTarget) < 0.002 * pAxisTarget) pAxis = pAxisTarget;
			plots[0].setAxes(3.5, pAxis);
			plots[1].setAxes(700, 3.5);
			plots[2].setAxes(700, pAxis);
		};

		const drawPlots = () => {
			const s = state();
			for (const p of plots) {
				p.drawIso(mode, s, nu());
				p.drawTrail(trail);
				p.drawPoint(s);
			}
		};

		const pushTrail = () => {
			const s = state();
			const lastS = trail[trail.length - 1];
			if (
				!lastS ||
				Math.abs(lastS.T - s.T) / 700 + Math.abs(lastS.V - s.V) / 3.5 + Math.abs(lastS.p - s.p) / (pAxis * 1e3) > 0.004
			) {
				trail.push(s);
				if (trail.length > 900) trail.shift();
			}
		};

		const drawFormula = (force = false) => {
			const s = state();
			const n = nu();
			const pk = s.p / 1e3;
			const d = kpaDigits(pk);
			const lines: string[] = [];
			const frac = `\\dfrac{${tex(n, 3)} \\cdot 8{,}31 \\cdot ${tex(s.T, 0)}}{${tex(s.V, 2)} \\cdot 10^{-3}}~\\text{Па}`;
			// when the line does not fit the panel, the result goes to a second line
			lines.push(
				narrowFormula
					? `\\begin{aligned} p = \\dfrac{\\nu R T}{V} &= ${frac} \\\\ &\\approx ${tex(pk, d)}~\\text{кПа} \\end{aligned}`
					: `p = \\dfrac{\\nu R T}{V} = ${frac} \\approx ${tex(pk, d)}~\\text{кПа}`,
			);
			const cls = (t: string) => `\\htmlClass{gl-const}{${t}}`;
			if (mode === 'T') {
				lines.push(`pV = ${tex(pk, d)}~\\text{кПа} \\cdot ${tex(s.V, 2)}~\\text{л} = ${cls(`${tex(pk * s.V, 0)}~\\text{Дж}`)}`);
			} else if (mode === 'p') {
				lines.push(
					`\\dfrac{V}{T} = \\dfrac{${tex(s.V, 2)}~\\text{л}}{${tex(s.T, 0)}~\\text{К}} = ${cls(`${tex((s.V / s.T) * 1e3, 2)}~\\dfrac{\\text{мл}}{\\text{К}}`)}`,
				);
			} else if (mode === 'V') {
				lines.push(
					`\\dfrac{p}{T} = \\dfrac{${tex(pk, d)}~\\text{кПа}}{${tex(s.T, 0)}~\\text{К}} = ${cls(`${tex(s.p / s.T, 0)}~\\dfrac{\\text{Па}}{\\text{К}}`)}`,
				);
			} else {
				lines.push(
					`\\dfrac{pV}{T} = \\dfrac{${tex(pk, d)}~\\text{кПа} \\cdot ${tex(s.V, 2)}~\\text{л}}{${tex(s.T, 0)}~\\text{К}} = ${cls(`${tex((pk * s.V) / s.T, 3)}~\\dfrac{\\text{Дж}}{\\text{К}}`)}`,
				);
			}
			const key = lines.join('|');
			if (!force && key === formulaKey) return;
			formulaKey = key;
			const note =
				mode === 'T'
					? 'Произведение <i>pV</i> не меняется.'
					: mode === 'p'
						? 'Отношение <i>V</i>/<i>T</i> не меняется.'
						: mode === 'V'
							? 'Отношение <i>p</i>/<i>T</i> не меняется.'
							: '<i>pV</i>/<i>T</i> = <i>νR</i> меняется, только если накачать или выпустить газ.';
			formula.innerHTML =
				lines
					.map((l) =>
						katex.renderToString(l, {
							displayMode: true,
							throwOnError: false,
							trust: (c: { command: string }) => c.command === '\\htmlClass',
							strict: false,
						}),
					)
					.join('') + `<p class="gl__formula-note">${note}</p>`;
			const first = formula.querySelector<HTMLElement>('.katex-display');
			if (!narrowFormula && first && first.clientWidth > 0 && first.scrollWidth > first.clientWidth + 1) {
				narrowFormula = true;
				drawFormula(true);
			}
		};

		const drawSpark = () => {
			if (spark.length < 2) return;
			let lo = Infinity;
			let hi = -Infinity;
			for (const s of spark) {
				lo = Math.min(lo, s.m, s.f);
				hi = Math.max(hi, s.m, s.f);
			}
			const pad = Math.max((hi - lo) * 0.15, 0.06 * hi);
			lo -= pad;
			hi += pad;
			const n = 100;
			const X = (i: number) => (150 * (i + n - spark.length)) / (n - 1);
			const Y = (v: number) => 46 - ((v - lo) / (hi - lo)) * 46;
			let dm = '';
			let df = '';
			spark.forEach((s, i) => {
				dm += `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(s.m).toFixed(1)}`;
				df += `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(s.f).toFixed(1)}`;
			});
			sparkM.setAttribute('d', dm);
			sparkF.setAttribute('d', df);
		};

		const syncControls = () => {
			tIn.value = String(Math.round(Tt));
			vIn.value = Vt.toFixed(2);
			tOut.value = `${Math.round(Tt)} К (${fmt(Math.round(Tt) - 273, 0)} °C)`;
			vOut.value = `${fmt(Vt, 2)} л`;
			const n = nu();
			nOut.innerHTML = `<i>ν</i> = ${fmt(n, 3)} моль (${fmt(n * M * 1e3, 2)} г)`;
			tIn.disabled = mode === 'T';
			vIn.disabled = mode === 'V';
			rowT.classList.toggle('is-locked', mode === 'T');
			rowV.classList.toggle('is-locked', mode === 'V');
			rowN.classList.toggle('is-locked', mode !== 'free');
			addBtn.disabled = mode !== 'free' || sim.n + sim.toAdd >= N_MAX;
			relBtn.disabled = mode !== 'free' || sim.n - sim.toRelease <= N_MIN;
			root.classList.toggle('is-valve-open', sim.toRelease > 0 || sim.toAdd > 0);
		};

		/* --- control logic --- */
		/** Allowed temperature range in the isobaric process (the piston has stops at V_MIN and V_MAX). */
		const tRangeIsobaric = () => {
			const k = (nu() * R) / pLock; // м³/К
			return [Math.max(T_MIN, (V_MIN * 1e-3) / k), Math.min(T_MAX, (V_MAX * 1e-3) / k)];
		};
		const setT = (T: number) => {
			if (mode === 'T') return;
			if (mode === 'p') {
				const [a, b] = tRangeIsobaric();
				if (T < a - 0.5 || T > b + 0.5) say('Поршень упёрся в ограничитель: при этом давлении дальше менять температуру нельзя.');
				T = clamp(T, a, b);
				Vt = (nu() * R * T) / pLock / 1e-3;
			}
			Tt = clamp(T, T_MIN, T_MAX);
		};
		const setV = (V: number) => {
			if (mode === 'V') {
				say('В изохорном процессе объём не меняется: поршень закреплён.');
				return;
			}
			V = clamp(V, V_MIN, V_MAX);
			if (mode === 'p') {
				setT((pLock * V * 1e-3) / (nu() * R));
				return;
			}
			Vt = V;
		};
		const setP = (pPa: number) => {
			// change pressure by changing V (isothermal, free) or T (isochoric)
			if (mode === 'V') setT((pPa * Vs * 1e-3) / (nu() * R));
			else if (mode === 'T' || mode === 'free') setV((nu() * R * Ts) / pPa / 1e-3);
		};

		const setMode = (m: Mode) => {
			mode = m;
			root.dataset.mode = m;
			modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
			sim.toAdd = 0;
			sim.toRelease = 0;
			Tt = Ts;
			Vt = Vs;
			pLock = pOf(nu(), Ts, Vs);
			trail = [];
			pushTrail();
			const msg: Record<Mode, string> = {
				free: 'Меняйте температуру, объём и количество газа — давление подстроится само.',
				T: 'Температура закреплена. Двигайте поршень и следите за давлением.',
				p: 'На поршне груз, поршень движется свободно: давление постоянно. Нагревайте и охлаждайте газ.',
				V: 'Поршень закреплён. Нагревайте и охлаждайте газ и следите за давлением.',
			};
			say(msg[m], 6000);
			syncControls();
			if (!playing) settle();
		};

		/* --- time step --- */
		const advance = (dt: number) => {
			const n = nu();
			// temperature
			if (mode !== 'T') {
				let target = Tt;
				const step = (target - Ts) * (1 - Math.exp(-dt / 0.3));
				let dT = step;
				if (mode === 'p') {
					const maxRate = (V_RATE * 1e-3 * pLock) / (n * R); // К/с
					dT = clamp(step, -maxRate * dt, maxRate * dt);
				}
				Ts += dT;
				if (Math.abs(Tt - Ts) < 0.05) Ts = Tt;
			}
			// volume
			if (mode === 'p') Vs = (n * R * Ts) / pLock / 1e-3;
			else if (mode !== 'V') {
				const step = (Vt - Vs) * (1 - Math.exp(-dt / 0.12));
				Vs += clamp(step, -V_RATE * dt, V_RATE * dt);
				if (Math.abs(Vt - Vs) < 1e-4) Vs = Vt;
			}
			Vs = clamp(Vs, V_MIN, V_MAX);
			sim.T = Ts;
			const nBefore = sim.n;
			sim.step(dt, Vs * PX_PER_L, addFlash, addEscape);
			if (sim.n !== nBefore || sim.toAdd || sim.toRelease) {
				pLock = mode === 'p' ? pLock : pOf(nu(), Ts, Vs);
				syncControls();
			}
		};

		/** Jump to the targets at once (when paused or with reduced motion). */
		const settle = () => {
			if (mode !== 'T') Ts = Tt;
			if (mode === 'p') Vs = (nu() * R * Ts) / pLock / 1e-3;
			else if (mode !== 'V') Vs = Vt;
			sim.T = Ts;
			const hNew = Vs * PX_PER_L;
			// rescale positions and speeds as after a slow (equilibrium) change
			const k = hNew / sim.h;
			const s = Math.sqrt(Ts / Math.max(1, sim.gasTemperature()));
			for (let i = 0; i < sim.n; i++) {
				sim.y[i] *= k;
				sim.vx[i] *= s;
				sim.vy[i] *= s;
			}
			sim.h = hNew;
			sim.flux = sim.expectedFlux();
			pMeasOut.textContent = fmtKpa(sim.measuredPressure());
			pushTrail();
			updateAxes(0);
			render(0);
		};

		const render = (dt: number) => {
			drawMolecules();
			drawScene();
			for (const f of flashes) {
				if (f.t >= 1) continue;
				f.t = Math.min(1, f.t + dt / 0.32);
				f.c.setAttribute('r', (1.5 + 7 * f.t).toFixed(2));
				f.c.style.opacity = (0.75 * (1 - f.t)).toFixed(3);
			}
			for (let i = escapes.length - 1; i >= 0; i--) {
				const e = escapes[i];
				e.t += dt / 0.9;
				e.c.setAttribute('cx', (X0 - RD - 5 - 70 * e.t).toFixed(1));
				e.c.setAttribute('cy', e.y.toFixed(1));
				e.c.style.opacity = String(Math.max(0, 1 - e.t));
				if (e.t >= 1) {
					e.c.remove();
					escapes.splice(i, 1);
				}
			}
			const yMid = YB - 21;
			flow.setAttribute(
				'd',
				sim.toAdd > 0
					? `M 16 ${yMid - 9} l 9 9 l -9 9`
					: sim.toRelease > 0
						? `M 26 ${yMid - 9} l -9 9 l 9 9`
						: '',
			);
			pushTrail();
			drawPlots();
			formulaClock += dt;
			if (dt === 0 || formulaClock > 0.08) {
				formulaClock = 0;
				drawFormula();
			}
		};

		const frame = (now: number) => {
			const dt = Math.min(0.05, Math.max(0.001, (now - last) / 1000));
			last = now;
			// two substeps keep fast molecules from skipping through thin layers near the piston
			advance(dt / 2);
			advance(dt / 2);
			updateAxes(dt);
			render(dt);
			sparkClock += dt;
			if (sparkClock > 0.1) {
				sparkClock = 0;
				spark.push({ m: sim.measuredPressure(), f: pOf(nu(), Ts, Vs) });
				if (spark.length > 100) spark.shift();
				drawSpark();
				pMeasOut.textContent = fmtKpa(sim.measuredPressure());
			}
			liveClock += dt;
			if (liveClock > 2) {
				liveClock = 0;
				const s = state();
				live.textContent = `Давление ${fmtKpa(s.p)}, объём ${fmt(s.V, 2)} л, температура ${Math.round(s.T)} К.`;
			}
			raf = requestAnimationFrame(frame);
		};

		const run = () => {
			cancelAnimationFrame(raf);
			if (playing && visible) {
				last = performance.now();
				raf = requestAnimationFrame(frame);
			}
		};

		/* --- events --- */
		tIn.addEventListener('input', () => {
			setT(Number(tIn.value));
			syncControls();
			if (!playing) settle();
		});
		vIn.addEventListener('input', () => {
			setV(Number(vIn.value));
			syncControls();
			if (!playing) settle();
		});
		modeBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as Mode)));
		addBtn.addEventListener('click', () => {
			if (!playing) {
				say('Нажмите «Пуск» — молекулы влетают через кран, когда модель работает.');
				return;
			}
			sim.add(10);
			syncControls();
		});
		relBtn.addEventListener('click', () => {
			if (!playing) {
				say('Нажмите «Пуск» — молекулы вылетают через кран, когда модель работает.');
				return;
			}
			sim.release(10);
			say('Кран открыт: наружу вылетают молекулы, которые попадают в отверстие.');
			syncControls();
		});
		playBtn.addEventListener('click', () => {
			playing = !playing;
			playBtn.textContent = playing ? 'Пауза' : 'Пуск';
			if (!playing) settle();
			run();
		});
		q<HTMLButtonElement>('[data-clear]').addEventListener('click', () => {
			trail = [];
			pushTrail();
			updateAxes(0);
			drawPlots();
		});

		// drag the piston
		let dragging = false;
		const pistonFromEvent = (ev: PointerEvent) => {
			const m = scene.getScreenCTM();
			if (!m) return;
			const pt = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
			// the pointer holds the piston where it was grabbed
			setV((YB - RD - (pt.y + grabOffset)) / PX_PER_L);
			syncControls();
			if (!playing) settle();
		};
		let grabOffset = 0;
		grab.addEventListener('pointerdown', (ev) => {
			if (mode === 'V') {
				say('В изохорном процессе объём не меняется: поршень закреплён.');
				return;
			}
			const m = scene.getScreenCTM();
			if (!m) return;
			const pt = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
			grabOffset = YB - RD - Vs * PX_PER_L - pt.y;
			dragging = true;
			root.classList.add('is-dragging');
			capture(grab, ev.pointerId);
			ev.preventDefault();
		});
		grab.addEventListener('pointermove', (ev) => dragging && pistonFromEvent(ev));
		const endDrag = () => {
			dragging = false;
			root.classList.remove('is-dragging');
		};
		grab.addEventListener('pointerup', endDrag);
		grab.addEventListener('pointercancel', endDrag);

		// drag the state point on the graphs
		for (const p of plots) {
			let on = false;
			const apply = (ev: PointerEvent) => {
				const [a, b] = p.toData(ev);
				const n = nu();
				if (p.kind === 'pV') {
					if (mode === 'free') {
						const V = clamp(a, V_MIN, V_MAX);
						setV(V);
						setT((Math.max(b, 0.5) * 1e3 * V * 1e-3) / (n * R));
					} else if (mode === 'V') setP(Math.max(b, 0.5) * 1e3);
					else setV(a);
				} else if (p.kind === 'VT') {
					if (mode === 'free') {
						setT(a);
						setV(b);
					} else if (mode === 'T') setV(b);
					else setT(a);
				} else {
					if (mode === 'free') {
						const T = clamp(a, T_MIN, T_MAX);
						setT(T);
						setV((n * R * T) / (Math.max(b, 0.5) * 1e3) / 1e-3);
					} else if (mode === 'T') setP(Math.max(b, 0.5) * 1e3);
					else setT(a);
				}
				syncControls();
				if (!playing) settle();
			};
			p.svg.addEventListener('pointerdown', (ev) => {
				on = true;
				capture(p.svg, ev.pointerId);
				apply(ev);
				ev.preventDefault();
			});
			p.svg.addEventListener('pointermove', (ev) => on && apply(ev));
			p.svg.addEventListener('pointerup', () => (on = false));
			p.svg.addEventListener('pointercancel', () => (on = false));
		}

		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
		const plotBoxes = Array.from(root.querySelectorAll<HTMLElement>('.gl__plot'));
		tabs.forEach((t) =>
			t.addEventListener('click', () => {
				tabs.forEach((u) => u.setAttribute('aria-pressed', String(u === t)));
				plotBoxes.forEach((b, i) => b.classList.toggle('is-active', i === Number(t.dataset.tab)));
			}),
		);

		let formulaWidth = 0;
		new ResizeObserver(() => {
			if (Math.abs(formula.clientWidth - formulaWidth) < 1) return;
			formulaWidth = formula.clientWidth;
			narrowFormula = false;
			drawFormula(true);
		}).observe(formula);
		new IntersectionObserver(
			(entries) => {
				visible = entries[0].isIntersecting;
				run();
			},
			{ rootMargin: '100px' },
		).observe(root);
		reduceMotion.addEventListener('change', () => {
			playing = !reduceMotion.matches;
			playBtn.textContent = playing ? 'Пауза' : 'Пуск';
			run();
		});

		// first picture
		root.dataset.mode = mode;
		playBtn.textContent = playing ? 'Пауза' : 'Пуск';
		for (let i = 0; i < 60; i++) spark.push({ m: pOf(nu(), Ts, Vs), f: pOf(nu(), Ts, Vs) });
		syncControls();
		pushTrail();
		updateAxes(0);
		render(0);
		drawFormula(true);
		drawSpark();
		pMeasOut.textContent = fmtKpa(sim.measuredPressure());
		if (!playing) say('Нажмите «Пуск», чтобы молекулы задвигались.', 0);
	}
</script>
