		fill: var(--ig-vx);
	}
	.gl__grid line {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	.gl__axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.3;
		fill: none;
