	}

	/* plots */
	.gl__plots {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 1rem;
	}
	.gl__plot {
		padding: 0.35rem 0.25rem 0.1rem;
		border-radius: 0.7rem;
