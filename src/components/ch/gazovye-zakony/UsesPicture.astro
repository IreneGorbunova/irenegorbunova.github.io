---
/**
 * «Где это встречается»: four small panels (2 × 2 on a wide screen, one column on a phone), a one-line label under each.
 *   Вдох (loop 5 s): a person in profile (people kit, 172 см, 1,4 px per см, seen down to the thighs) with the lung and
 *     the diaphragm drawn over the chest. Inhale 2 s: the diaphragm goes down by 4 см (a deep breath), the lung grows,
 *     the pressure in it falls about 0,1 кПа below the outside and the air flows in (arrows at the nose); exhale 2,5 s.
 *   Кислородный баллон (static, 1,2 px per см): a 10 л cylinder (14 см across, 75 см tall) at 15 МПа and the dashed
 *     cube of the volume the same oxygen would take at 0,1 МПа: 10 л · 15/0,1 = 1500 л, a cube 1,14 м on a side.
 *   Метеозонд (static, 16 px per м): a person (people kit, 170 см) holds the cord of the balloon at the launch (2 м
 *     across); at 30 км (p ≈ 1,2 кПа, −47 °C) the same balloon is 8 м across: V₂/V₁ = (101,3/1,2)·(226/288) ≈ 66,
 *     diameter × 66^(1/3) ≈ 4,0. Both balloons and the person to one scale; the height is not to scale.
 *   Подушка безопасности (loop 4 s, 2,4 px per см): a steering wheel (38 см) seen from the side; the bag (about 60 л,
 *     48 см across) fills from the gas generator in the hub in 0,03 с, shown 20 times slower (0,6 с), then goes down.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
const mA = `usp-a-${uid}`;
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--pic usp not-content" data-usp>
	<div class="g7__grid is-two">
		<div class="usp__cell">
			<svg class="g7__svg" viewBox="0 0 200 176" role="img" aria-label="Человек делает вдох: диафрагма опускается, лёгкие расширяются, и воздух входит через нос" data-breath>
				<defs>
					<marker id={mA} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3.2" markerHeight="3.2" orient="auto"><path class="head--blue" d="M0,0 L10,5 L0,10 z"></path></marker>
				</defs>
				<g data-person></g>
				<path class="usp__lung" data-lung></path>
				<path class="usp__diaph" data-diaph></path>
				<path class="usp__trachea" data-trachea></path>
				<g data-air>
					<line class="usp__air" x1="0" y1="0" x2="0" y2="0" marker-end={`url(#${mA})`}></line>
					<line class="usp__air" x1="0" y1="0" x2="0" y2="0" marker-end={`url(#${mA})`}></line>
				</g>
			</svg>
			<p class="usp__name">Вдох</p>
		</div>
		<div class="usp__cell">
			<svg class="g7__svg" viewBox="0 0 200 176" role="img" aria-label="Кислородный баллон на 10 литров при давлении 15 мегапаскалей и штриховой куб объёмом 1500 литров — столько места занял бы тот же кислород при атмосферном давлении">
				<rect class="usp__floor" x="0" y="160" width="200" height="16"></rect>
				<!-- the cube of 1500 л: 1,14 м = 137 px -->
				<rect class="usp__cube" x="56" y="23" width="137" height="137"></rect>
				<text class="usp__big" x="124.5" y="88" text-anchor="middle">1500 л</text>
				<text class="usp__small" x="124.5" y="106" text-anchor="middle">при атмосферном</text>
				<text class="usp__small" x="124.5" y="121" text-anchor="middle">давлении</text>
				<!-- the cylinder: 14 × 75 см -->
				<rect class="usp__o2" x="18" y="72" width="17" height="88" rx="8"></rect>
				<rect class="usp__valve" x="23" y="62" width="7" height="11" rx="1.5"></rect>
				<path class="usp__pipe" d="M30 66 H38"></path>
				<circle class="usp__gauge" cx="44" cy="66" r="6"></circle>
				<path class="usp__needle" d="M44 66 L47.5 62"></path>
				<text class="usp__small" x="8" y="48">15 МПа</text>
				<text class="usp__small usp__vert" x="30" y="150" transform="rotate(-90 30 150)">10 л</text>
			</svg>
			<p class="usp__name">Кислородный баллон</p>
		</div>
		<div class="usp__cell">
			<svg class="g7__svg" viewBox="0 0 200 176" role="img" aria-label="Метеозонд при запуске размером 2 метра рядом с человеком и тот же шар на высоте 30 километров — около 8 метров" data-sonde>
				<rect class="usp__ground" x="0" y="164" width="62" height="12"></rect>
				<path class="usp__cord" d="M22 114 L22 137"></path>
				<circle class="usp__balloon" cx="22" cy="98" r="16"></circle>
				<text class="usp__small" x="41" y="102">2 м</text>
				<g data-person2></g>
				<circle class="usp__balloon" cx="132" cy="80" r="64.5"></circle>
				<path class="usp__dim" d="M67.5 80 H196.5 M67.5 76 V84 M196.5 76 V84"></path>
				<text class="usp__big usp__onb" x="132" y="72" text-anchor="middle">8 м</text>
				<text class="usp__small usp__onb" x="132" y="112" text-anchor="middle">на высоте 30 км</text>
				<path class="usp__cord" d="M132 144.5 V160"></path>
				<rect class="usp__payload" x="127" y="160" width="10" height="8" rx="1"></rect>
			</svg>
			<p class="usp__name">Метеозонд</p>
		</div>
		<div class="usp__cell">
			<svg class="g7__svg" viewBox="0 0 200 176" role="img" aria-label="Рулевое колесо сбоку: из его середины за сотые доли секунды надувается подушка безопасности" data-bag>
				<path class="usp__column" d="M58 96 L8 150"></path>
				<ellipse class="usp__bagshape" cx="58" cy="96" rx="0" ry="0" data-bagshape></ellipse>
				<ellipse class="usp__rim" cx="58" cy="96" rx="9" ry="45.6" transform="rotate(-18 58 96)"></ellipse>
				<rect class="usp__hub" x="52" y="88" width="12" height="16" rx="3" transform="rotate(-18 58 96)"></rect>
				<text class="usp__small" x="196" y="20" text-anchor="end" data-baglab>60 л за 0,03 с</text>
			</svg>
			<p class="usp__name">Подушка безопасности</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Метеозонд: шары и человек — в одном масштабе, высота — без масштаба. Подушка безопасности надувается за 0,03&nbsp;с, здесь — в 20&nbsp;раз медленнее.
	</figcaption>
</figure>

<style is:global>
	/* compact: four small pictures, at most 520 px wide together */
	.usp > .g7__grid {
		max-width: 520px;
		margin-inline: auto;
	}
	.usp__name {
		margin: 0.3rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.g7__svg .usp__lung {
		fill: color-mix(in srgb, var(--ig-vy) 35%, transparent);
		stroke: var(--ig-vy);
		stroke-width: 1.3;
	}
	.g7__svg .usp__diaph {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.g7__svg .usp__trachea {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.g7__svg .usp__air {
		stroke: var(--g7-blue);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.g7__svg .usp__floor,
	.g7__svg .usp__ground {
		fill: var(--g7-ground);
	}
	.g7__svg .usp__cube {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
		stroke: var(--g7-blue);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}
	.g7__svg .usp__big {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.g7__svg .usp__small {
		font-size: 12px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .usp__onb {
		fill: var(--sl-color-white);
	}
	.g7__svg .usp__o2 {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
	}
	.g7__svg .usp__valve {
		fill: var(--sl-color-gray-3);
	}
	.g7__svg .usp__pipe {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.g7__svg .usp__gauge {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.g7__svg .usp__needle {
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	.g7__svg .usp__balloon {
		fill: color-mix(in srgb, var(--sl-color-white) 22%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.g7__svg .usp__cord {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.g7__svg .usp__dim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.g7__svg .usp__payload {
		fill: var(--g7-gold);
	}
	.g7__svg .usp__column {
		stroke: var(--sl-color-gray-3);
		stroke-width: 8;
		stroke-linecap: round;
	}
	.g7__svg .usp__dash {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 3;
	}
	.g7__svg .usp__rim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 6;
	}
	.g7__svg .usp__hub {
		fill: var(--sl-color-gray-3);
	}
	.g7__svg .usp__bagshape {
		fill: hsl(40, 15%, 90%);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { figure } from '@components/people/body';

	const f1 = (v: number) => v.toFixed(1);
	const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
	for (const root of document.querySelectorAll<HTMLElement>('[data-usp]')) {
		// ---------- Вдох ----------
		{
			const svg = root.querySelector<SVGSVGElement>('[data-breath]')!;
			const s = 1.4;
			const H = 172;
			const u = s * H;
			const hip = { x: 88, y: 8 + (172 - 0.52 * H) * s };
			const g = svg.querySelector<SVGGElement>('[data-person]')!;
			const person = figure(g, { s, H, age: 'adult', clothes: 'indoor', prefix: 'hm', shirt: 'hm-green', hair: 'short', name: 'breath' });
			const ankY = hip.y + (0.52 - 0.045) * u;
			person.pose({
				hip,
				lean: 0,
				ankles: [
					{ x: hip.x + 0.02 * u, y: ankY },
					{ x: hip.x - 0.02 * u, y: ankY },
				],
				feet: [0, 0],
				planted: [true, true],
				hands: [
					{ arm: [Math.PI / 2 + 0.08, 0.2], pose: 'relaxed' },
					{ arm: [Math.PI / 2 - 0.05, 0.25], pose: 'relaxed' },
				],
			});
			const shoulderY = hip.y - 0.27 * u;
			const headC = { x: hip.x, y: hip.y - 0.4 * u };
			const headR = 0.064 * u;
			const lung = svg.querySelector('[data-lung]')!;
			const diaph = svg.querySelector('[data-diaph]')!;
			const trachea = svg.querySelector('[data-trachea]')!;
			const air = Array.from(svg.querySelectorAll<SVGLineElement>('[data-air] line'));
			const lx = hip.x + 2;
			const top = shoulderY + 6;
			trachea.setAttribute('d', `M${f1(headC.x + 0.4 * headR)} ${f1(headC.y + 0.9 * headR)} Q${f1(lx + 4)} ${f1(top - 10)} ${f1(lx + 3)} ${f1(top + 4)}`);
			const nose = { x: headC.x + 1.05 * headR, y: headC.y + 0.15 * headR };
			let t = 0;
			loop(svg, (dt) => {
				t = (t + dt) % 5;
				// inhale 0,3 … 2,3 s, exhale 2,6 … 5,0 s
				const k = t < 2.5 ? ease((t - 0.3) / 2) : 1 - ease((t - 2.6) / 2.3);
				const dy = 4 * s * k; // the diaphragm goes down by up to 4 см
				const w = 11 + 2 * k; // half-width of the lung
				const bot = top + 36 + dy;
				lung.setAttribute('d', `M${f1(lx)} ${f1(top)} Q${f1(lx + w + 4)} ${f1(top + 2)} ${f1(lx + w)} ${f1(bot - 8)} Q${f1(lx)} ${f1(bot - 3)} ${f1(lx - w)} ${f1(bot - 8)} Q${f1(lx - w - 3)} ${f1(top + 4)} ${f1(lx)} ${f1(top)} Z`);
				diaph.setAttribute('d', `M${f1(lx - w - 6)} ${f1(bot + 4)} Q${f1(lx)} ${f1(bot - 12)} ${f1(lx + w + 6)} ${f1(bot + 4)}`);
				// air at the nose: in while inhaling, out while exhaling
				const inhale = t > 0.3 && t < 2.3;
				const exhale = t > 2.6 && t < 4.9;
				air.forEach((a, i) => {
					const y = nose.y + (i - 0.5) * 7;
					const far = nose.x + 26;
					const near = nose.x + 7;
					const show = inhale || exhale;
					a.style.visibility = show ? 'visible' : 'hidden';
					a.setAttribute('x1', f1(inhale ? far : near));
					a.setAttribute('x2', f1(inhale ? near + 3 : far - 3));
					a.setAttribute('y1', f1(y));
					a.setAttribute('y2', f1(y));
				});
				return true;
			});
		}
		// ---------- Метеозонд: the person holds the cord ----------
		{
			const svg = root.querySelector<SVGSVGElement>('[data-sonde]')!;
			const s = 0.16; // px per см (16 px per м)
			const H = 170;
			const u = s * H;
			const g = svg.querySelector<SVGGElement>('[data-person2]')!;
			const person = figure(g, { s, H, age: 'adult', clothes: 'indoor', prefix: 'hm', shirt: 'hm-blue', hair: 'short', name: 'sonde' });
			const ground = 164;
			const ankY = ground - 7 * s;
			const hip = { x: 19, y: ground - 0.52 * u };
			person.pose({
				hip,
				lean: 0,
				ankles: [
					{ x: hip.x + 0.04 * u, y: ankY },
					{ x: hip.x - 0.03 * u, y: ankY },
				],
				feet: [0, 0],
				planted: [true, true],
				hands: [
					{ at: { x: 22, y: 137.5 }, pose: 'grip', d: 0.5, dir: -Math.PI / 2 + 0.2, contact: 'cord' },
					{ arm: [Math.PI / 2 + 0.1, 0.2], pose: 'relaxed' },
				],
			});
		}
		// ---------- Подушка безопасности ----------
		{
			const svg = root.querySelector<SVGSVGElement>('[data-bag]')!;
			const bag = svg.querySelector('[data-bagshape]')!;
			let t = 0;
			loop(svg, (dt) => {
				t = (t + dt) % 4;
				// fills 0,4 … 1,0 s (0,03 с × 20), stays, goes down 2,6 … 3,4 s
				const k = t < 2.5 ? ease((t - 0.4) / 0.6) : 1 - ease((t - 2.6) / 0.8);
				const R = 58 * k; // 24 см × 2,4 px
				bag.setAttribute('cx', f1(58 + R * 0.95));
				bag.setAttribute('cy', f1(96 - R * 0.1));
				bag.setAttribute('rx', f1(R));
				bag.setAttribute('ry', f1(R * 0.9));
				return true;
			});
		}
	}
</script>
