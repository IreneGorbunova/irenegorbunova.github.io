---
/**
 * «Трубка Бойля» (model before the Boyle–Mariotte law): a glass U-tube, the short arm closed at the top, the long arm
 * open. At the start the mercury stands at the same level in both arms and shuts off a column of air l = 240 мм at the
 * atmospheric pressure p₀ = 760 мм рт. ст. «Долить ртуть» pours mercury into the long arm (an animation of 1 с); the
 * level difference h grows in steps h = 0, 152, 380, 760, 1064, 1520 мм. The temperature stays the same, so the air
 * column follows p·l = const: p = p₀ + h (мм рт. ст.), l = 240 · 760/(760 + h) = 240, 200, 160, 120, 100, 80 мм
 * (the steps are chosen so that l is a whole number of millimeters). The two arms have equal cross-sections, so the
 * mercury in the short arm rises by s = 240 − l and in the long arm by s + h. Pressure in кПа: 1 мм рт. ст. = 133,3 Па
 * (101,3; 121,6; 152,0; 202,6; 243,2; 304,0 кПа). Every step adds a row to the table (h, p, l, p·l = 182 400 мм рт. ст.·мм)
 * and a point to the graph p(l); from three points on the dashed hyperbola p·l = 182 400 is drawn.
 *
 * Scale: heights 0,2 px per мм (1520 мм → 304 px), one scale for both arms; the tube is drawn about ten times wider
 * than a real one (inside 12 px = 60 мм) so that the air inside shows. Dots: the same 14 dots stand for the air; they
 * keep their speed (the temperature does not change) and get denser as the column gets shorter.
 */
import G7Styles from '../g7/G7Styles.astro';

const K = 0.2; // px per mm
const Y0 = 374; // the start level of the mercury in both arms
const XS = 100; // the short arm's axis
const XL = 170; // the long arm's axis
const W = 6; // half the inner width
const TOP_S = Y0 - 240 * K; // the closed top of the short arm
const TOP_L = Y0 - 1720 * K; // the open top of the long arm
const BEND = Y0 + 12; // the arms end here and the U begins
const R = (XL - XS) / 2;
// the glass: outer walls of the U (inner + 2,5 px)
const g = 2.5;
const outer = `M${XL + W + g} ${TOP_L} V${BEND} A${R + W + g} ${R + W + g} 0 0 1 ${XS - W - g} ${BEND} V${TOP_S + 2} Q${XS - W - g} ${TOP_S - W - g} ${XS} ${TOP_S - W - g} Q${XS + W + g} ${TOP_S - W - g} ${XS + W + g} ${TOP_S + 2} V${BEND} A${R - W - g} ${R - W - g} 0 0 0 ${XL - W - g} ${BEND} V${TOP_L}`;
const inner = `M${XS - W} ${TOP_S + 2} Q${XS - W} ${TOP_S - W} ${XS} ${TOP_S - W} Q${XS + W} ${TOP_S - W} ${XS + W} ${TOP_S + 2} V${BEND} A${R - W} ${R - W} 0 0 0 ${XL - W} ${BEND} V${TOP_L} H${XL + W} V${BEND} A${R + W} ${R + W} 0 0 1 ${XS - W} ${BEND} Z`;
// the ruler along the long arm: every 100 мм from the start level, labels every 500 мм
const ticks = Array.from({ length: 18 }, (_, i) => i * 100);
const uid = Math.random().toString(36).slice(2, 8);
---

<G7Styles />
<figure class="g7 btl not-content" data-btl>
	<div class="g7__grid btl__grid">
		<svg class="g7__svg btl__svg" viewBox="0 0 300 432" role="img" aria-label="U-образная стеклянная трубка: короткое колено запаяно и в нём заперт воздух, в длинное открытое колено доливают ртуть" data-svg>
			<defs>
				<marker id={`btl-a-${uid}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path class="head--gold" d="M0,0 L10,5 L0,10 z"></path></marker>
				<linearGradient id={`btl-hg-${uid}`} x1="0" x2="1" y1="0" y2="0">
					<stop offset="0" class="btl__hg1"></stop>
					<stop offset="0.45" class="btl__hg2"></stop>
					<stop offset="1" class="btl__hg1"></stop>
				</linearGradient>
			</defs>
			<!-- the board the tube is fixed to -->
			<rect class="btl__board" x="60" y={TOP_L - 18} width="150" height={BEND + R + 14 - (TOP_L - 18)} rx="6"></rect>
			<!-- ruler along the long arm -->
			<g class="btl__ruler">
				{ticks.map((t) => <line x1={XL + W + g + 2} x2={XL + W + g + (t % 500 === 0 ? 10 : 6)} y1={Y0 - t * K} y2={Y0 - t * K} />)}
				{[0, 500, 1000, 1500].map((t) => (
					<text x={XL + W + g + 13} y={Y0 - t * K + 4}>
						{t}
					</text>
				))}
				<text x={XL + W + g + 13} y={Y0 - 1700 * K + 4}>мм</text>
			</g>
			<path class="btl__glass-in" d={inner}></path>
			<!-- mercury: one path from the level in the short arm round the U to the level in the long arm -->
			<path class="btl__hg" data-hg fill={`url(#btl-hg-${uid})`}></path>
			<path class="btl__stream" data-stream></path>
			<!-- the air -->
			<g data-air></g>
			<path class="btl__glass" d={outer}></path>
			<path class="btl__shine" d={`M${XS - W + 2} ${TOP_S + 4} V${BEND - 4} M${XL - W + 2} ${TOP_L + 6} V${BEND - 4}`}></path>
			<!-- the funnel on the long arm -->
			<path class="btl__funnel" d={`M${XL - 16} ${TOP_L - 16} L${XL - W} ${TOP_L + 2} M${XL + 16} ${TOP_L - 16} L${XL + W} ${TOP_L + 2}`}></path>
			<!-- the air of the room presses on the mercury in the open arm -->
			<line class="arrow arrow--gold" x1={XL} x2={XL} y1={TOP_L - 24} y2={TOP_L - 6} marker-end={`url(#btl-a-${uid})`}></line>
			<text class="t-small btl__p0" x={XL - 22} y={TOP_L - 8} text-anchor="end">p₀ = 760 мм рт. ст.</text>
			<!-- the air column l -->
			<path class="btl__brk btl__brk--l" data-lbrk></path>
			<text class="t-blue t-halo btl__lab" data-llab text-anchor="end"></text>
			<!-- the level difference h -->
			<path class="btl__lvl" data-lvl></path>
			<path class="btl__brk btl__brk--h" data-hbrk></path>
			<text class="t-gold t-halo btl__lab" data-hlab></text>
		</svg>
		<div class="g7__side btl__side">
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-pour>Долить ртуть</button>
				<button type="button" class="g7__btn" data-reset>Начать заново</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Разность уровней ртути <i>h</i></span><b data-oh></b></li>
				<li class="is-warm"><span>Давление воздуха <i>p</i></span><b data-op></b></li>
				<li><span>То же в килопаскалях</span><b data-opk></b></li>
				<li class="is-key"><span>Длина столба воздуха <i>l</i></span><b data-ol></b></li>
			</ul>
			<div class="btl__tablewrap">
				<table class="btl__table">
					<thead>
						<tr><th><i>h</i>, мм</th><th><i>p</i>, мм рт. ст.</th><th><i>l</i>, мм</th><th><i>p</i> · <i>l</i></th></tr>
					</thead>
					<tbody data-rows></tbody>
				</table>
			</div>
			<svg class="g7__svg btl__graph" viewBox="0 0 260 176" role="img" aria-label="График зависимости давления воздуха от длины столба" data-graph>
				<path class="btl__grid-l" data-gridl></path>
				<path class="btl__axis" d="M36 10 V146 H250 M32 18 L36 10 L40 18 M242 142 L250 146 L242 150"></path>
				<text class="t-small" x="30" y="160" text-anchor="end">0</text>
				<g data-ticks></g>
				<text class="t-i btl__axname" x="44" y="16">p<tspan class="btl__unit" dx="2">, мм рт. ст.</tspan></text>
				<text class="t-i btl__axname" x="250" y="170" text-anchor="end">l<tspan class="btl__unit" dx="2">, мм</tspan></text>
				<path class="btl__hyp" data-hyp></path>
				<g data-pts></g>
			</svg>
		</div>
	</div>
	<figcaption class="g7__caption">
		Давление запертого воздуха <i>p</i> = <i>p</i>₀ + <i>h</i>: давление атмосферы и столба ртути высотой <i>h</i>. Высоты обоих колен — в одном масштабе; трубка нарисована примерно в 10&nbsp;раз толще настоящей, чтобы был виден воздух. Температура воздуха не меняется. Бойль ставил такой опыт в&nbsp;1661–1662&nbsp;годах с трубкой длиной около 2,5&nbsp;м.
	</figcaption>
</figure>

<style is:global>
	.btl__grid {
		grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
	}
	@container (max-width: 36rem) {
		.btl__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.btl__svg {
			max-width: 19rem;
			margin-inline: auto;
		}
	}
	.g7__svg .btl__board {
		fill: color-mix(in oklab, var(--ig-v) 16%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-5);
	}
	.g7__svg .btl__ruler line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.g7__svg .btl__ruler text {
		font-size: 11.5px;
		fill: var(--sl-color-gray-3);
	}
	.g7__svg .btl__glass-in {
		fill: color-mix(in srgb, var(--ig-vx) 6%, var(--g7-paper));
	}
	.g7__svg .btl__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.g7__svg .btl__shine {
		stroke: color-mix(in srgb, var(--sl-color-white) 35%, transparent);
		stroke-width: 1.2;
	}
	.btl__hg1 {
		stop-color: hsl(210, 8%, 58%);
	}
	.btl__hg2 {
		stop-color: hsl(210, 10%, 90%);
	}
	.g7__svg .btl__stream {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.g7__svg .btl__dot {
		fill: var(--g7-blue);
	}
	.g7__svg .btl__funnel {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.g7__svg .btl__p0 {
		fill: var(--g7-gold);
	}
	.g7__svg .btl__lab {
		font-size: 13px;
	}
	.g7__svg .btl__var {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
	}
	.g7__svg .btl__brk {
		fill: none;
		stroke-width: 1.3;
	}
	.g7__svg .btl__brk--l {
		stroke: var(--g7-blue);
	}
	.g7__svg .btl__brk--h {
		stroke: var(--g7-gold);
	}
	.g7__svg .btl__lvl {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.btl__tablewrap {
		overflow-x: auto;
	}
	.btl__table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-xs);
		font-variant-numeric: tabular-nums;
	}
	.btl__table th,
	.btl__table td {
		padding: 0.2rem 0.35rem;
		text-align: right;
		border-bottom: 1px solid var(--sl-color-gray-5);
		white-space: nowrap;
	}
	.btl__table th {
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}
	.btl__table td {
		color: var(--sl-color-white);
	}
	.btl__table td:last-child {
		color: var(--sl-color-text-accent);
		font-weight: 700;
	}
	.btl__table tbody tr:last-child td {
		background: color-mix(in oklab, var(--ig-v) 10%, transparent);
	}
	.g7__svg .btl__axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.g7__svg .btl__grid-l {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.g7__svg .btl__axname {
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .btl__unit {
		font-family: var(--__sl-font);
		font-style: normal;
		font-size: 11px;
	}
	.g7__svg .btl__hyp {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}
	.g7__svg .btl__pt {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
</style>

<script>
	import { el, fmt, fmtInt, loop } from '../g7/kit';

	const K = 0.2;
	const Y0 = 374;
	const XS = 100;
	const XL = 170;
	const W = 6;
	const TOP_S = Y0 - 240 * K;
	const TOP_L = Y0 - 1720 * K;
	const BEND = Y0 + 12;
	const R = (XL - XS) / 2;
	const P0 = 760; // мм рт. ст.
	const L0 = 240; // мм
	const STEPS = [0, 152, 380, 760, 1064, 1520]; // h, мм
	const KPA = 0.133322; // кПа per мм рт. ст.
	// the graph: l 0…260 мм → 36…246 px, p 0…2400 мм рт. ст. → 146…22 px
	const GX = (l: number) => 36 + (l / 260) * 210;
	const GY = (p: number) => 146 - (p / 2400) * 124;
	const f1 = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-btl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const hg = q<SVGPathElement>('[data-hg]');
		const stream = q<SVGPathElement>('[data-stream]');
		const airG = q<SVGGElement>('[data-air]');
		const lbrk = q<SVGPathElement>('[data-lbrk]');
		const llab = q<SVGTextElement>('[data-llab]');
		const hbrk = q<SVGPathElement>('[data-hbrk]');
		const hlab = q<SVGTextElement>('[data-hlab]');
		const lvl = q<SVGPathElement>('[data-lvl]');
		const pour = q<HTMLButtonElement>('[data-pour]');
		const reset = q<HTMLButtonElement>('[data-reset]');
		const rows = q<HTMLTableSectionElement>('[data-rows]');
		const pts = q<SVGGElement>('[data-pts]');
		const hyp = q<SVGPathElement>('[data-hyp]');
		// the graph's grid and ticks
		{
			let d = '';
			for (const l of [100, 200]) d += `M${f1(GX(l))} 146 V22 `;
			for (const p of [1000, 2000]) d += `M36 ${f1(GY(p))} H246 `;
			q('[data-gridl]').setAttribute('d', d);
			const tg = q('[data-ticks]');
			for (const l of [100, 200]) tg.append(el('text', { class: 't-small', x: f1(GX(l)), y: 160, 'text-anchor': 'middle' }, String(l)));
			for (const p of [1000, 2000]) tg.append(el('text', { class: 't-small', x: 30, y: f1(GY(p) + 4), 'text-anchor': 'end' }, fmtInt(p)));
		}
		// the air: dots in a column of unit length, scaled to l; they keep their speed
		let seed = 5;
		const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
		const air = Array.from({ length: 14 }, () => {
			const a = rnd() * Math.PI * 2;
			return { c: el('circle', { class: 'btl__dot', r: 1.6 }), u: rnd(), x: (rnd() - 0.5) * 2 * (W - 2), vu: 0.5 * Math.sin(a), vx: 9 * Math.cos(a) };
		});
		for (const d of air) airG.append(d.c);

		let step = 0; // index in STEPS
		let h = 0; // the current level difference (animated)
		let from = 0;
		let to = 0;
		let tAnim = 1;
		const lOf = (hh: number) => (L0 * P0) / (P0 + hh);
		const draw = () => {
			const l = lOf(h);
			const s = L0 - l; // the rise in the short arm
			const yS = Y0 - s * K; // the mercury level in the short arm
			const yL = Y0 - (s + h) * K; // in the long arm
			hg.setAttribute('d', `M${XS - W} ${f1(yS)} H${XS + W} V${BEND} A${R - W} ${R - W} 0 0 0 ${XL - W} ${BEND} V${f1(yL)} H${XL + W} V${BEND} A${R + W} ${R + W} 0 0 1 ${XS - W} ${BEND} Z`);
			// the air column from the closed top to the mercury
			const top = TOP_S - W + 2;
			const len = yS - top;
			for (const d of air) {
				const y = top + 2 + d.u * Math.max(1, len - 4);
				d.c.setAttribute('cx', f1(XS + d.x));
				d.c.setAttribute('cy', f1(y));
			}
			// the bracket of l (from the top of the column to the mercury), its label to the left
			const bx = XS - W - 9;
			lbrk.setAttribute('d', `M${bx + 4} ${f1(TOP_S)} H${bx} V${f1(yS)} H${bx + 4}`);
			llab.setAttribute('x', String(bx - 4));
			llab.setAttribute('y', f1((TOP_S + yS) / 2 + 4));
			llab.innerHTML = `<tspan class="btl__var">l</tspan> = ${Math.round(l)} мм`;
			// h: from the level in the short arm to the level in the long arm, beside the ruler
			const hx = XL + W + 44;
			const show = h > 2;
			lvl.setAttribute('d', show ? `M${XS + W + 2} ${f1(yS)} H${hx + 4}` : '');
			hbrk.setAttribute('d', show ? `M${hx - 4} ${f1(yS)} H${hx} V${f1(yL)} H${hx - 4}` : '');
			hlab.style.visibility = show ? 'visible' : 'hidden';
			hlab.setAttribute('x', String(hx + 4));
			hlab.setAttribute('y', f1((yS + yL) / 2 + 4));
			hlab.innerHTML = `<tspan class="btl__var">h</tspan> = ${Math.round(h)} мм`;
			// readouts
			const p = P0 + h;
			q('[data-oh]').textContent = `${fmtInt(h)} мм`;
			q('[data-op]').textContent = `${fmtInt(p)} мм рт. ст.`;
			q('[data-opk]').textContent = `${fmt(p * KPA, 1)} кПа`;
			q('[data-ol]').textContent = `${fmt(l, 0)} мм`;
			pour.disabled = step >= STEPS.length - 1 || tAnim < 1;
		};
		const addRow = (i: number) => {
			const hh = STEPS[i];
			const p = P0 + hh;
			const l = lOf(hh);
			const tr = document.createElement('tr');
			for (const v of [fmtInt(hh), fmtInt(p), fmt(l, 0), fmtInt(p * l)]) {
				const td = document.createElement('td');
				td.textContent = v;
				tr.append(td);
			}
			rows.append(tr);
			pts.append(el('circle', { class: 'btl__pt', cx: f1(GX(l)), cy: f1(GY(p)), r: 4 }));
			if (rows.children.length >= 3) {
				const c = L0 * P0;
				const seg: string[] = [];
				for (let ll = 76; ll <= 250; ll += 2) seg.push(`${f1(GX(ll))} ${f1(GY(c / ll))}`);
				hyp.setAttribute('d', `M${seg.join(' L')}`);
			}
		};
		const restart = () => {
			step = 0;
			h = 0;
			tAnim = 1;
			rows.textContent = '';
			pts.textContent = '';
			hyp.setAttribute('d', '');
			stream.setAttribute('d', '');
			addRow(0);
			draw();
		};
		let now = 0;
		const wake = loop(root, (dt) => {
			now += dt;
			// the dots move inside the column (the same speed at every length: the temperature is the same)
			const l = lOf(h);
			const lenPx = Math.max(6, l * K - 4);
			for (const d of air) {
				d.u += (d.vu * dt * 30) / lenPx;
				d.x += d.vx * dt;
				if (d.u < 0) (d.u = -d.u), (d.vu = Math.abs(d.vu));
				if (d.u > 1) (d.u = 2 - d.u), (d.vu = -Math.abs(d.vu));
				if (d.x < -(W - 2)) (d.x = -2 * (W - 2) - d.x), (d.vx = Math.abs(d.vx));
				if (d.x > W - 2) (d.x = 2 * (W - 2) - d.x), (d.vx = -Math.abs(d.vx));
			}
			if (tAnim < 1) {
				tAnim = Math.min(1, tAnim + dt / 1.0);
				const e = tAnim * tAnim * (3 - 2 * tAnim);
				h = from + (to - from) * e;
				const s = L0 - lOf(h);
				const yL = Y0 - (s + h) * K;
				stream.setAttribute('d', tAnim < 0.92 ? `M${XL + 1} ${TOP_L - 4} V${f1(yL)}` : '');
				if (tAnim === 1) addRow(step);
			}
			draw();
			return true;
		});
		pour.addEventListener('click', () => {
			if (step >= STEPS.length - 1 || tAnim < 1) return;
			from = STEPS[step];
			step++;
			to = STEPS[step];
			tAnim = 0;
			wake();
		});
		reset.addEventListener('click', () => {
			restart();
			wake();
		});
		restart();
	}
</script>
