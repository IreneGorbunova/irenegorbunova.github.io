<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { figure, ease, lerp, lerpPt, attach, ROLL, ANKLE_CM, type Pt, type HandTarget, type FigurePose } from '@components/people';

	const smooth = (a: number, b: number, t: number) => ease((t - a) / (b - a));
	const f = (v: number) => v.toFixed(2);
	// falling snowflakes: positions repeat every `period` s
	const flakes = (g: SVGGElement, n: number, box: { x: number; y: number; w: number; h: number }, seed: number) => {
		let s = seed;
		const rnd = () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
		const list = Array.from({ length: n }, () => {
			const c = el('circle', { class: 'pti-flake', r: (0.7 + rnd() * 0.9).toFixed(2) });
			g.append(c);
			return { c, x: rnd(), y: rnd(), v: 0.08 + rnd() * 0.06, w: rnd() * 6.28 };
		});
		return (t: number) => {
			for (const fl of list) {
				const y = (fl.y + fl.v * t) % 1;
				const x = fl.x + 0.02 * Math.sin(fl.w + t * 1.3);
				fl.c.setAttribute('cx', (box.x + ((x + 1) % 1) * box.w).toFixed(1));
				fl.c.setAttribute('cy', (box.y + y * box.h).toFixed(1));
			}
		};
	};
	/** Moves the near arm of a kit figure (its last three drawn parts: outline, sleeve, hand) into `layer`. */
	const nearArmTo = (g: SVGGElement, layer: SVGGElement) => {
		const root = g.firstElementChild!;
		const parts = [...root.children].slice(-3);
		for (const p of parts) layer.append(p);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-ptintro]')) {
		// ---------------- the lemons ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="lemons"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 2.2;
			const H = 165;
			const TT = 180;
			const BASE = 176;
			const LEDX = 320;
			const teen = figure($<SVGGElement>('[data-teen]'), { s: S, H, age: 'teen', clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'teen' });
			teen.backLayer(0, $<SVGGElement>('[data-hback]'));
			const clipG = $<SVGGElement>('[data-clip]');
			const wire = $<SVGPathElement>('[data-wire]');
			const led = $<SVGPathElement>('[data-led]');
			const halo = $<SVGCircleElement>('[data-halo]');
			const halo2 = $<SVGCircleElement>('[data-halo2]');
			const pool = $<SVGEllipseElement>('[data-pool]');
			const HIP: Pt = { x: 52, y: TT + 25 * S + 1 };
			const ankleY = TT + 75 * S - ANKLE_CM.trainer * S;
			const TIP = 15; // px from the grip to the tip of the clip's jaws (the clip is 7 см long)
			const NAIL: Pt = { x: 146, y: 159 }; // where the jaws bite the nail of the first lemon
			const AWAY: Pt = { x: 134, y: 140 }; // the jaws' tip in the first pose
			const DIR0 = 1.2; // rad, the fingers (and the clip) point down and forward
			const ON = 1.5;
			const OFF = 4.62;
			// the hand target is corrected so that the tip of the clip lands where it should
			let corr: Pt = { x: 0, y: 0 };
			const pose = (tipAt: Pt, dir: number, head: number): FigurePose => ({
				hip: HIP,
				lean: 0.12,
				head,
				ankles: [
					{ x: HIP.x + 92, y: ankleY },
					{ x: HIP.x + 82, y: ankleY },
				],
				feet: [0, 0],
				planted: [true, true],
				hands: [
					{ at: { x: tipAt.x - TIP * Math.cos(dir) + corr.x, y: tipAt.y - TIP * Math.sin(dir) + corr.y }, pose: 'pinch', dir, roll: -0.55, contact: 'clip' },
					{ at: { x: 120, y: BASE - 1 }, pose: 'flat', dir: 0.05, roll: ROLL.palmCw, contact: 'table' },
				],
			});
			scene(card, 7, (x) => {
				const t = 7 * x;
				const go = smooth(0.4, 1.45, t) * (1 - smooth(OFF, 5.4, t));
				const press = t > 1.42 && t < OFF ? 0.6 * Math.sin(Math.PI * Math.min(1, (t - 1.42) / 0.2)) : 0;
				const tip = lerpPt(AWAY, NAIL, go);
				tip.y += press;
				const dir = lerp(DIR0, 1.05, go);
				const head = lerp(0.34, 0.22, smooth(1.6, 2.3, t) * (1 - smooth(OFF, 5.2, t)));
				// two passes: the second corrects the hand so that the clip's tip is exactly at `tip`
				for (let k = 0; k < 2; k++) {
					const st = teen.pose(pose(tip, dir, head));
					const fr = st.grips[0];
					const got = { x: fr.x + TIP * Math.cos(fr.angle), y: fr.y + TIP * Math.sin(fr.angle) };
					corr = { x: corr.x + tip.x - got.x, y: corr.y + tip.y - got.y };
					attach(clipG, fr);
					// the lead leaves the back of the clip and lies along the table to the LED's right leg
					const tail = { x: fr.x - 9 * Math.cos(fr.angle), y: fr.y - 9 * Math.sin(fr.angle) };
					wire.setAttribute(
						'd',
						`M${f(tail.x)} ${f(tail.y)} C${f(tail.x - 14)} ${f(tail.y + 10)} ${f(tail.x - 10)} ${TT + 4} ${f(tail.x + 22)} ${TT + 3.2} S${LEDX + 22} ${TT + 4} ${LEDX + 6.2} ${BASE - 0.2}`,
					);
				}
				const lit = t >= ON && t < OFF ? 1 : 0;
				led.classList.toggle('is-on', !!lit);
				halo.setAttribute('opacity', String(0.75 * lit));
				halo2.setAttribute('opacity', String(0.9 * lit));
				pool.setAttribute('opacity', String(0.22 * lit));
			});
		}
		// ---------------- the car ----------------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="car"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.45;
			const K = 1.1;
			const H = 178;
			// two drawings of the same man: in the car (0,45 px per см) and in the magnifier (1,1 px per см)
			const small = { x: (x: number) => 30 + S * x, y: (y: number) => 204 - S * y };
			const big = { x: (x: number) => 150 + K * (x - 266), y: (y: number) => 70 - K * (y - 92) };
			const driver = figure($<SVGGElement>('[data-driver]'), { s: S, H, clothes: 'winter', shirt: 'hm-blue', gear: 'boot', covering: 'glove', name: 'driver' });
			const bigG = $<SVGGElement>('[data-driver-big]');
			const driverBig = figure(bigG, { s: K, H, clothes: 'winter', shirt: 'hm-blue', gear: 'boot', covering: 'glove', name: 'driver (magnifier)' });
			nearArmTo(bigG, $<SVGGElement>('[data-near-arm]'));
			driverBig.backLayer(0, $<SVGGElement>('[data-near-back]'));
			const keyG = $<SVGGElement>('[data-key]');
			const lensIn = $<SVGGElement>('[data-lens-in]');
			const car = $<SVGGElement>('[data-car]');
			const light = $<SVGGElement>('[data-light]');
			const lamp = $<SVGEllipseElement>('[data-lamp]');
			const puffs = $<SVGGElement>('[data-puffs]');
			const puffEls = Array.from({ length: 6 }, () => {
				const c = el('circle', { class: 'pti-puff', r: '0', opacity: '0' });
				puffs.append(c);
				return c;
			});
			const snow = flakes($<SVGGElement>('[data-flakes2]'), 26, { x: 0, y: -4, w: 360, h: 212 }, 3);
			const KEY = 1.4; // s, the starter turns
			const START = 3.6; // s, the engine runs
			// the light of the lamps relative to 12,6 В (see the header)
			const lightAt = (t: number) => {
				if (t < KEY) return 0.97;
				if (t < START) return lerp(0.97, 0.56, smooth(KEY, KEY + 0.15, t));
				return lerp(0.56, 1.5, smooth(START, START + 0.3, t));
			};
			// the cabin, см: the wheel rim edge-on, its plane at 69° (center 286; 90, 38 см across); the key on the column
			const WA = (69 * Math.PI) / 180;
			const rim = (u: number) => ({ x: 286 - 19 * u * Math.cos(WA), y: 90 + 19 * u * Math.sin(WA) }); // u from −1 (bottom) to 1 (top)
			const KEYP = { x: 298.6, y: 85 };
			const HIP = { x: 244, y: 50 };
			type Sp = { x: (x: number) => number; y: (y: number) => number };
			const P = (sp: Sp, q: { x: number; y: number }): Pt => ({ x: sp.x(q.x), y: sp.y(q.y) });
			const drive = (sp: Sp, fig: typeof driver, t: number) => {
				const toKey = smooth(KEY - 0.45, KEY - 0.05, t) * (1 - smooth(START + 0.15, START + 0.7, t));
				const turned = smooth(KEY - 0.1, KEY, t) * (1 - smooth(START, START + 0.08, t));
				const onWheel = rim(-0.55);
				const near: HandTarget =
					toKey > 0
						? { at: lerpPt(P(sp, onWheel), P(sp, KEYP), toKey), pose: toKey > 0.5 ? 'pinch' : 'grip', d: 3, dir: lerp(0.25, -0.05, toKey), roll: lerp(ROLL.backViewer + 0.3, -0.9 + 0.7 * turned, toKey), contact: toKey > 0.999 ? 'key' : undefined }
						: { at: P(sp, onWheel), pose: 'grip', d: 3, dir: 0.25, roll: ROLL.backViewer + 0.3, contact: 'wheel' };
				const st = fig.pose({
					hip: P(sp, HIP),
					lean: lerp(-0.28, -0.2, toKey),
					head: -0.05,
					ankles: [P(sp, { x: 322, y: 26 }), P(sp, { x: 316, y: 28 })],
					feet: [-0.4, -0.4],
					planted: [true, true],
					hands: [near, { at: P(sp, rim(0.62)), pose: 'grip', d: 3, dir: -0.9, roll: ROLL.backViewer, contact: 'wheel' }],
				});
				return { st, turned };
			};
			scene(card, 7, (x) => {
				const t = 7 * x;
				const Lt = lightAt(t);
				light.setAttribute('opacity', Math.min(1, 0.85 * Lt).toFixed(3));
				lamp.style.opacity = (0.35 + 0.65 * Math.min(1, 0.85 * Lt)).toFixed(2);
				// shaking: strong while the starter cranks, weak while the engine idles
				const amp = t >= KEY && t < START ? 0.7 : t >= START ? 0.2 : 0;
				const dy = amp * Math.sin(t * 2 * Math.PI * 13);
				const rot = amp * 0.35 * Math.sin(t * 2 * Math.PI * 9 + 1);
				car.setAttribute('transform', `translate(0 ${dy.toFixed(2)}) rotate(${rot.toFixed(2)} ${small.x(215)} ${small.y(30)})`);
				lensIn.setAttribute('transform', `translate(0 ${(dy * 2.4).toFixed(2)})`);
				drive(small, driver, t);
				const { turned } = drive(big, driverBig, t);
				// the key: seen from the side, its head narrows as it turns (by 70° for the start)
				const kx = big.x(KEYP.x);
				const ky = big.y(KEYP.y);
				const c = Math.cos((70 * Math.PI * turned) / 180);
				keyG.setAttribute('transform', `translate(${f(kx)} ${f(ky)}) rotate(-22) scale(1 ${f(Math.max(0.25, c))})`);
				// exhaust: a puff every 0,45 s once the engine runs
				puffEls.forEach((cEl, i) => {
					const age = t - START - i * 0.45;
					if (age < 0 || age > 2.4) {
						cEl.setAttribute('opacity', '0');
						return;
					}
					cEl.setAttribute('cx', (small.x(-6) - 9 * age).toFixed(1));
					cEl.setAttribute('cy', (small.y(33) - 5 * age - 2 * age * age).toFixed(1));
					cEl.setAttribute('r', (2 + 4.5 * age).toFixed(1));
					cEl.setAttribute('opacity', (0.75 * (1 - age / 2.4)).toFixed(2));
				});
				snow(t);
			});
		}
	}
</script>
