---
/**
 * Two short looping opening scenes of «Законы постоянного тока». No terms of the chapter in the pictures.
 *
 * Garland: a room on a winter evening, 0,85 px per centimeter. A girl (150 см, indoor clothes from
 *   mehanicheskaya-rabota/people.ts) holds the battery box of a fairy-light garland 10 м long that winds round a New
 *   Year tree (1,9 м with its stand). At 1,2 s her other hand presses the button, and all 30 lamps light at the same
 *   moment. A magnifier over the floor wire shows a piece of it with a 0,1 мм mark (320 px per мм): the free electrons
 *   (dots, their spacing not to scale) jiggle (their chaotic motion only hinted at: the real thermal speeds are about
 *   10^5 м/с) and, once the lamps are on, drift together at the real speed of 0,031 мм/с (10 px/с): 30 мА in a copper
 *   wire 0,3 мм across (S = 0,0707 мм², n = 8,5·10^28 м⁻³). Along 10 м that drift would take 3,7 days. Real time.
 * Car: a winter morning, 0,45 px per centimeter. A man (178 см, winter clothes from davlenie-zakon-paskalya/person.ts)
 *   sits in a car 4,3 м long with the headlights on; the beam falls on a garage door. 0–1,4 s: engine off, the battery
 *   gives the lamps ≈ 12,5 В; 1,4–3,6 s: the starter cranks (the car shakes), the battery gives ≈ 10,6 В (200 А through
 *   r ≈ 0,01 Ом); from 3,6 s the engine runs and the generator gives ≈ 14,2 В. The light of a halogen lamp goes roughly
 *   as U^3,4: 0,97, 0,56 and 1,5 of its light at 12,6 В; the opacity of the beam is 0,85 of these numbers (0,82,
 *   0,48, then 1 where it would exceed 1), the beam fades little before the door, and the garage door is a dark one, so the dimming to 0,58 of the light shows
 *   plainly; the lamp glass follows it above a floor of 0,35. Real time;
 *   the shaking of the car is exaggerated so that it shows.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

// the room of the garland scene
const G = 214; // the floor
// a fir tree: tiers of needles, from the top down (center x, top y, bottom y, half-width at the bottom)
const tiers = [
	[292, 48, 92, 22],
	[292, 70, 122, 33],
	[292, 98, 156, 42],
	[292, 130, 194, 52],
];
const tierPath = ([cx, y0, y1, w]: number[]) => {
	const n = 7;
	let d = `M${cx} ${y0}`;
	for (let i = 0; i <= n; i++) {
		const x = cx + w - (2 * w * i) / n;
		const y = y1 - (i % 2 ? 6 : 0);
		d += ` L${x.toFixed(1)} ${y}`;
	}
	return d + ' Z';
};
// the garland: from the bottom left of the tree it winds up across the tiers, sagging between the edges
const rows = [186, 168, 150, 132, 114, 96, 78, 62];
const halfAt = (y: number) => 6 + ((y - 48) / (194 - 48)) * 46;
let garland = `M248 ${rows[0]}`;
rows.forEach((y, i) => {
	if (i === 0) return;
	const from = i % 2 ? -1 : 1;
	const x0 = 292 + from * halfAt(rows[i - 1]) * 0.92;
	const x1 = 292 - from * halfAt(y) * 0.92;
	garland += ` Q${((x0 + x1) / 2).toFixed(1)} ${(Math.max(rows[i - 1], y) + 9).toFixed(1)} ${x1.toFixed(1)} ${y}`;
});
const floorBoards = [228, 236].map((y) => `M0 ${y} H360`).join(' ');

// the car scene: px = 30 + 0,45·x, py = 204 − 0,45·y, with x, y in centimeters
const S = 0.45;
const GY = 204;
const X = (x: number) => +(30 + S * x).toFixed(1);
const Y = (y: number) => +(GY - S * y).toFixed(1);
const pt = (x: number, y: number) => `${X(x)} ${Y(y)}`;
const arch = (cx: number, r: number) => `L${pt(cx + r, 38)} A${(r * S).toFixed(1)} ${(r * S).toFixed(1)} 0 0 0 ${pt(cx - r, 38)}`;
const body =
	`M${pt(0, 40)} L${pt(2, 84)} Q${pt(4, 96)} ${pt(20, 98)} L${pt(82, 103)} L${pt(140, 141)} Q${pt(148, 145)} ${pt(160, 145)} L${pt(250, 145)} ` +
	`Q${pt(262, 144)} ${pt(270, 138)} L${pt(318, 104)} L${pt(404, 92)} Q${pt(426, 88)} ${pt(430, 76)} L${pt(432, 44)} Q${pt(432, 38)} ${pt(424, 38)} ` +
	`${arch(345, 38)} ${arch(85, 38)} L${pt(6, 38)} Q${pt(0, 38)} ${pt(0, 40)} Z`;
const glass = `M${pt(150, 133)} L${pt(250, 136)} Q${pt(258, 135)} ${pt(264, 130)} L${pt(304, 103)} L${pt(140, 101)} Z`;
const windows = [glass].join('');
const flats: { x: number; y: number; lit: boolean }[] = [];
for (let r = 0; r < 4; r++)
	for (let c = 0; c < 9; c++) flats.push({ x: 14 + c * 31, y: 26 + r * 26, lit: (c * 7 + r * 3) % 5 === 1 || (c + r) % 7 === 3 });
---

<PeopleStyles />
<IntroFrame data-ptintro>
	<div class="intro__card" data-scene="garland">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Девочка нажимает кнопку на коробочке с батарейками, и вся гирлянда на ёлке загорается сразу. Лупа над проводом показывает, что электроны в нём почти не сдвинулись">
			<defs>
				<clipPath id="pti-lens"><circle cx="196" cy="174" r="29"></circle></clipPath>
				<radialGradient id="pti-glow">
					<stop offset="0" stop-color="currentColor" stop-opacity="0.9"></stop>
					<stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<rect class="pti-wall" x="0" y="0" width="360" height={G}></rect>
			<!-- the window with the winter night -->
			<rect class="pti-night" x="148" y="34" width="76" height="92" rx="2"></rect>
			<circle class="pti-moon" cx="206" cy="54" r="8"></circle>
			<circle class="pti-night" cx="210" cy="51" r="7"></circle>
			<g data-flakes1></g>
			<path class="pti-frame" d="M148 34 H224 V126 H148 Z M186 34 V126 M148 72 H224"></path>
			<rect class="pti-sill" x="142" y="126" width="88" height="5" rx="1"></rect>
			<path class="pti-curtain" d="M136 28 Q146 70 140 132 L152 132 Q156 80 150 28 Z M236 28 Q226 70 232 132 L220 132 Q216 80 222 28 Z"></path>
			<rect class="pti-rod" x="130" y="25" width="112" height="3" rx="1.5"></rect>
			<!-- a picture on the wall -->
			<rect class="pti-picture" x="22" y="40" width="40" height="30" rx="1"></rect>
			<path class="pti-hills" d="M25 66 L36 54 L44 61 L50 52 L59 66 Z"></path>
			<!-- floor -->
			<rect class="pti-skirting" x="0" y={G - 5} width="360" height="5"></rect>
			<rect class="pti-floor" x="0" y={G} width="360" height={240 - G}></rect>
			<path class="pti-board" d={floorBoards}></path>
			<!-- the tree -->
			<rect class="pti-trunk" x="288" y="190" width="8" height="10"></rect>
			<path class="pti-bucket" d="M274 198 H310 L306 214 H278 Z"></path>
			{tiers.map((t) => <path class="pti-needles" d={tierPath(t)} />)}
			<path class="pti-star" d="M292 38 l2.6 5.4 5.9 .8 -4.3 4.1 1 5.8 -5.2 -2.8 -5.2 2.8 1 -5.8 -4.3 -4.1 5.9 -.8 Z" data-star></path>
			<path class="pti-wire" d={garland}></path>
			<path class="pti-wire" data-lead d="M112 135 C120 170 124 212 150 212 L240 212 Q248 212 248 196 L248 186"></path>
			<g data-lamps></g>
			<!-- the girl and the battery box -->
			<g data-girl></g>
			<g data-box>
				<rect class="pti-box" x="101" y="129" width="11" height="7" rx="1.2"></rect>
				<rect class="pti-button" x="104.5" y="127.6" width="4" height="1.6" rx="0.6"></rect>
			</g>
			<g data-hand></g>
			<!-- the magnifier over the floor wire -->
			<line class="pti-handle" x1="216" y1="196" x2="228" y2="208"></line>
			<circle class="pti-lens-bg" cx="196" cy="174" r="29"></circle>
			<g clip-path="url(#pti-lens)">
				<rect class="pti-copper" x="160" y="151" width="80" height="26"></rect>
				<g data-ions></g>
				<g data-electrons></g>
			</g>
			<circle class="pti-lens" cx="196" cy="174" r="29"></circle>
			<path class="pti-scale" d="M180 197 h32 M180 194.5 v5 M212 194.5 v5"></path>
			<text class="pti-small" x="196" y="191" text-anchor="middle">0,1&nbsp;мм</text>
			<line class="pti-leader" x1="196" y1="203" x2="196" y2="211"></line>
		</svg>
		<div class="intro__foot">
			<p>
				Нажали кнопку — и вся гирлянда длиной 10 метров загорается в тот же миг, хотя{' '}
				<More term="электроны в её проводах ползут медленнее улитки">
					Под лупой — кусочек провода гирлянды с меткой 0,1&nbsp;мм. Электроны в нём движутся упорядоченно со скоростью около 0,03&nbsp;мм/с: вдоль всей гирлянды они ползли бы почти четверо суток. Но электрическое поле распространяется по проводам почти со скоростью света и приводит в движение свободные электроны сразу по всей длине. Об этом — в разделе{' '}
					<a href="#электрический-ток-сила-тока">«Электрический ток. Сила тока»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="car">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимним утром водитель заводит машину с включёнными фарами. Пока крутится стартер, свет фар на воротах гаража тускнеет, а когда двигатель заработал, снова становится ярким">
			<defs>
				<linearGradient id="pti-beam" x1="0" x2="1" y1="0" y2="0">
					<stop offset="0" class="pti-beam-a"></stop>
					<stop offset="1" class="pti-beam-b"></stop>
				</linearGradient>
				<radialGradient id="pti-spot">
					<stop offset="0" class="pti-beam-a"></stop>
					<stop offset="1" class="pti-beam-b"></stop>
				</radialGradient>
				<clipPath id="pti-glass"><path d={windows}></path></clipPath>
			</defs>
			<rect class="pti-sky" x="0" y="0" width="360" height="240"></rect>
			<!-- the house across the yard -->
			<rect class="pti-house" x="4" y="14" width="290" height="190"></rect>
			{flats.map((w) => <rect class={w.lit ? 'pti-flat pti-flat--lit' : 'pti-flat'} x={w.x} y={w.y} width="14" height="12" rx="0.8" />)}
			<rect class="pti-entrance" x="214" y="150" width="22" height="54"></rect>
			<rect class="pti-canopy" x="208" y="146" width="34" height="4"></rect>
			<!-- the garage on the right -->
			<rect class="pti-garage" x="318" y="118" width="46" height="86"></rect>
			<path class="pti-door-ribs" d="M322 134 H364 M322 144 H364 M322 154 H364 M322 164 H364 M322 174 H364 M322 184 H364 M322 194 H364"></path>
			<path class="pti-snow" d="M314 118 Q330 110 346 114 T366 116 V122 H314 Z"></path>
			<!-- the yard -->
			<path class="pti-snow" d="M0 198 Q80 193 160 197 T360 195 V240 H0 Z"></path>
			<path class="pti-drift" d="M300 204 Q314 190 330 196 Q344 186 360 192 V214 H300 Z"></path>
			<!-- the light of the headlights -->
			<g data-light>
				<path class="pti-beam" d="M222 167 L318 140 L318 204 L300 214 L222 172 Z"></path>
				<ellipse class="pti-spot" cx="326" cy="170" rx="22" ry="28"></ellipse>
				<ellipse class="pti-spot" cx="282" cy="206" rx="36" ry="5"></ellipse>
			</g>
			<g data-puffs></g>
			<!-- the car -->
			<g data-car>
				<g clip-path="url(#pti-glass)">
					<path class="pti-cabin" d={windows}></path>
					<path class="pti-seat" d={`M${pt(222, 44)} L${pt(214, 118)} Q${pt(212, 128)} ${pt(220, 128)} L${pt(226, 126)} L${pt(238, 50)} Z`}></path>
					<g data-driver></g>
					<path class="pti-wheel" d={`M${pt(279, 74)} L${pt(291, 106)}`}></path>
					<g data-near-hand></g>
				</g>
				<path class="pti-body" d={`${body} ${glass}`} fill-rule="evenodd"></path>
				<path class="pti-glass" d={glass}></path>
				<path class="pti-pillar" d={`M${pt(200, 140)} L${pt(203, 101)} L${pt(211, 101)} L${pt(208, 141)} Z`}></path>
				<path class="pti-seam" d={`M${pt(140, 101)} L${pt(318, 104)} M${pt(204, 101)} L${pt(206, 40)} M${pt(318, 104)} L${pt(312, 40)} M${pt(82, 103)} L${pt(140, 101)}`}></path>
				<rect class="pti-handlebar" x={X(186)} y={Y(92)} width={14 * S} height="1.6" rx="0.8"></rect>
				<rect class="pti-handlebar" x={X(290)} y={Y(94)} width={14 * S} height="1.6" rx="0.8"></rect>
				<path class="pti-mirror" d={`M${pt(304, 104)} L${pt(312, 112)} L${pt(318, 106)} L${pt(312, 100)} Z`}></path>
				<path class="pti-snow" d={`M${pt(142, 144)} Q${pt(150, 152)} ${pt(170, 151)} L${pt(246, 151)} Q${pt(260, 150)} ${pt(262, 144)} Z`}></path>
				<path class="pti-snow" d={`M${pt(330, 102)} Q${pt(360, 104)} ${pt(400, 96)} L${pt(404, 92)} L${pt(320, 103)} Z`}></path>
				<ellipse class="pti-headlight" data-lamp cx={X(424)} cy={Y(78)} rx="3.2" ry="2.4"></ellipse>
				<rect class="pti-tail" x={X(0) - 0.5} y={Y(86)} width="2.6" height="5" rx="1"></rect>
				<rect class="pti-pipe" x={X(-4)} y={Y(34)} width="6" height="2" rx="1"></rect>
				<rect class="pti-plate" x={X(430) - 1} y={Y(56)} width="2" height="8"></rect>
				{[85, 345].map((cx) => (
					<g>
						<circle class="pti-tyre" cx={X(cx)} cy={Y(31)} r={31 * S} />
						<circle class="pti-rim" cx={X(cx)} cy={Y(31)} r={18 * S} />
						<circle class="pti-hub" cx={X(cx)} cy={Y(31)} r={5 * S} />
					</g>
				))}
			</g>
			<g data-flakes2></g>
		</svg>
		<div class="intro__foot">
			<p>
				Зимним утром водитель заводит машину с включёнными фарами, и, пока крутится стартер,{' '}
				<More term="фары светят заметно слабее">
					Стартер берёт у аккумулятора ток около 200&nbsp;А. При таком токе заметная часть ЭДС аккумулятора приходится на его собственное, внутреннее сопротивление: напряжение на полюсах падает с 12,6 до 10–11&nbsp;В, и лампы светят почти вдвое слабее. Когда двигатель заработал, фары питает генератор, около 14&nbsp;В, и они светят даже ярче, чем вначале. Об этом — в разделе{' '}
					<a href="#закон-ома-для-полной-цепи">«Закон Ома для полной цепи»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-ptintro] {
		--pti-wall: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-6));
		--pti-floor: hsl(28, 32%, 34%);
		--pti-needles: hsl(150, 38%, 30%);
		--pti-night: hsl(225, 45%, 16%);
		--pti-snow: hsl(212, 30%, 82%);
		--pti-house: hsl(222, 18%, 24%);
		--pti-car: hsl(0, 52%, 46%);
		--pti-beam: hsl(50, 100%, 82%);
		--pti-copper: hsl(24, 60%, 62%);
		--pp-skin: hsl(26, 55%, 72%);
		--pp-line: hsl(222, 35%, 14%);
		--pp-pants: hsl(225, 25%, 34%);
		--pp-boot: hsl(24, 38%, 34%);
		--pp-fur: hsl(36, 40%, 84%);
		--pp-hat: var(--ig-v);
		--pp-scarf: hsl(150, 50%, 50%);
	}
	:root[data-theme='light'] [data-ptintro] {
		--pti-wall: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-7, #f6f6f6));
		--pti-floor: hsl(28, 40%, 62%);
		--pti-needles: hsl(150, 40%, 32%);
		--pti-snow: hsl(210, 45%, 95%);
		--pti-house: hsl(222, 16%, 46%);
		--pti-beam: hsl(48, 100%, 60%);
		--pti-copper: hsl(24, 70%, 55%);
		--pp-line: hsl(222, 30%, 22%);
		--pp-pants: hsl(225, 30%, 30%);
	}
	[data-ptintro] .pti-wall {
		fill: var(--pti-wall);
	}
	[data-ptintro] .pti-night {
		fill: var(--pti-night);
	}
	[data-ptintro] .pti-moon {
		fill: hsl(48, 80%, 86%);
	}
	[data-ptintro] .pti-frame {
		fill: none;
		stroke: hsl(0, 0%, 92%);
		stroke-width: 3;
	}
	[data-ptintro] .pti-sill {
		fill: hsl(0, 0%, 90%);
	}
	[data-ptintro] .pti-curtain {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-4));
		stroke: var(--pp-line);
		stroke-width: 0.5;
	}
	[data-ptintro] .pti-rod {
		fill: var(--sl-color-gray-3);
	}
	[data-ptintro] .pti-picture {
		fill: color-mix(in oklab, var(--ig-vx) 25%, var(--sl-color-gray-6));
		stroke: var(--pti-floor);
		stroke-width: 2.5;
	}
	[data-ptintro] .pti-hills {
		fill: hsl(150, 30%, 45%);
	}
	[data-ptintro] .pti-skirting {
		fill: color-mix(in oklab, var(--pti-floor) 70%, white);
	}
	[data-ptintro] .pti-floor {
		fill: var(--pti-floor);
	}
	[data-ptintro] .pti-board {
		fill: none;
		stroke: color-mix(in oklab, var(--pti-floor) 70%, black);
		stroke-width: 0.6;
	}
	[data-ptintro] .pti-trunk {
		fill: hsl(25, 40%, 30%);
	}
	[data-ptintro] .pti-bucket {
		fill: var(--ig-vy);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-ptintro] .pti-needles {
		fill: var(--pti-needles);
		stroke: color-mix(in oklab, var(--pti-needles) 70%, black);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	[data-ptintro] .pti-star {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-4));
		stroke: var(--pp-line);
		stroke-width: 0.5;
	}
	[data-ptintro] .pti-star.is-on {
		fill: var(--ig-v);
	}
	[data-ptintro] .pti-wire {
		fill: none;
		stroke: hsl(150, 20%, 18%);
		stroke-width: 1;
	}
	[data-ptintro] .pti-lamp-off {
		fill: hsl(0, 0%, 72%);
		stroke: var(--pp-line);
		stroke-width: 0.4;
	}
	[data-ptintro] .pti-lamp-on {
		stroke: hsl(0, 0%, 100%);
		stroke-width: 0.5;
	}
	[data-ptintro] .pti-box {
		fill: hsl(0, 0%, 22%);
		stroke: var(--pp-line);
		stroke-width: 0.6;
	}
	[data-ptintro] .pti-button {
		fill: var(--ig-vy);
	}
	[data-ptintro] .pti-lens-bg {
		fill: var(--sl-color-bg);
	}
	[data-ptintro] .pti-lens {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.4;
	}
	[data-ptintro] .pti-handle {
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-ptintro] .pti-leader {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	[data-ptintro] .pti-copper {
		fill: color-mix(in oklab, var(--pti-copper) 40%, var(--sl-color-bg));
		stroke: var(--pti-copper);
		stroke-width: 1;
	}
	[data-ptintro] .pti-ion {
		fill: color-mix(in oklab, var(--pti-copper) 70%, var(--sl-color-gray-3));
		opacity: 0.55;
	}
	[data-ptintro] .pti-e {
		fill: var(--ig-vx);
	}
	[data-ptintro] .pti-e.is-mark {
		fill: var(--ig-v);
		stroke: var(--pp-line);
		stroke-width: 0.5;
	}
	[data-ptintro] .pti-scale {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-ptintro] .pti-small {
		font-size: 9.5px;
		fill: var(--sl-color-gray-1);
		paint-order: stroke fill;
		stroke: var(--sl-color-bg);
		stroke-width: 2.5px;
	}
	[data-ptintro] .pti-flake {
		fill: hsl(0, 0%, 100%);
		opacity: 0.85;
	}
	:root[data-theme='light'] [data-ptintro] [data-flakes2] .pti-flake {
		fill: hsl(210, 40%, 80%);
	}
	/* the car scene */
	[data-ptintro] .pti-sky {
		fill: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-bg));
	}
	[data-ptintro] .pti-house {
		fill: var(--pti-house);
	}
	[data-ptintro] .pti-flat {
		fill: color-mix(in oklab, var(--pti-house) 70%, black);
	}
	[data-ptintro] .pti-flat--lit {
		fill: hsl(42, 85%, 70%);
	}
	[data-ptintro] .pti-entrance {
		fill: color-mix(in oklab, var(--pti-house) 60%, black);
	}
	[data-ptintro] .pti-canopy {
		fill: var(--pti-snow);
	}
	[data-ptintro] .pti-garage {
		fill: hsl(210, 10%, 34%);
		stroke: var(--pp-line);
		stroke-width: 0.8;
	}
	[data-ptintro] .pti-door-ribs {
		stroke: hsl(210, 10%, 26%);
		stroke-width: 1;
	}
	[data-ptintro] .pti-snow {
		fill: var(--pti-snow);
	}
	[data-ptintro] .pti-drift {
		fill: color-mix(in oklab, var(--pti-snow) 88%, var(--ig-vx));
	}
	[data-ptintro] .pti-beam {
		fill: url(#pti-beam);
	}
	[data-ptintro] .pti-spot {
		fill: url(#pti-spot);
	}
	[data-ptintro] .pti-beam-a {
		stop-color: var(--pti-beam);
		stop-opacity: 0.95;
	}
	[data-ptintro] .pti-beam-b {
		stop-color: var(--pti-beam);
		stop-opacity: 0.4;
	}
	[data-ptintro] .pti-body {
		fill: var(--pti-car);
		stroke: var(--pp-line);
		stroke-width: 0.9;
		stroke-linejoin: round;
	}
	[data-ptintro] .pti-cabin {
		fill: hsl(220, 25%, 22%);
	}
	[data-ptintro] .pti-seat {
		fill: hsl(220, 15%, 34%);
	}
	[data-ptintro] .pti-glass {
		fill: hsl(205, 60%, 75%);
		opacity: 0.22;
	}
	[data-ptintro] .pti-pillar {
		fill: var(--pti-car);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-ptintro] .pti-seam {
		fill: none;
		stroke: color-mix(in oklab, var(--pti-car) 60%, black);
		stroke-width: 0.7;
	}
	[data-ptintro] .pti-handlebar,
	[data-ptintro] .pti-plate {
		fill: hsl(0, 0%, 85%);
	}
	[data-ptintro] .pti-mirror {
		fill: color-mix(in oklab, var(--pti-car) 75%, black);
	}
	[data-ptintro] .pti-wheel {
		stroke: hsl(220, 10%, 12%);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-ptintro] .pti-headlight {
		fill: hsl(50, 100%, 88%);
		stroke: var(--pp-line);
		stroke-width: 0.5;
	}
	[data-ptintro] .pti-tail {
		fill: hsl(0, 90%, 45%);
	}
	[data-ptintro] .pti-pipe {
		fill: hsl(0, 0%, 45%);
	}
	[data-ptintro] .pti-tyre {
		fill: hsl(220, 10%, 14%);
	}
	[data-ptintro] .pti-rim {
		fill: hsl(210, 8%, 70%);
		stroke: hsl(210, 8%, 40%);
		stroke-width: 0.6;
	}
	[data-ptintro] .pti-hub {
		fill: hsl(210, 8%, 45%);
	}
	[data-ptintro] .pti-puff {
		fill: hsl(0, 0%, 92%);
	}
	/* the winter man (davlenie-zakon-paskalya/person.ts) */
	[data-ptintro] .pp-far {
		filter: brightness(0.78);
	}
	[data-ptintro] .pp-outline {
		fill: none;
		stroke: var(--pp-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-ptintro] .pp-pants,
	[data-ptintro] .pp-sleeve {
		fill: none;
		stroke: var(--pp-pants);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-ptintro] .pp-sleeve.pti-coat {
		stroke: var(--ig-vx);
	}
	[data-ptintro] .pp-coat.pti-coat {
		fill: var(--ig-vx);
		stroke: var(--pp-line);
		stroke-width: 0.8;
	}
	[data-ptintro] .pp-zip {
		fill: none;
		stroke: var(--pp-line);
		stroke-width: 0.7;
		opacity: 0.6;
	}
	[data-ptintro] .pp-skin {
		fill: var(--pp-skin);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-ptintro] .pp-ear {
		stroke-width: 0.5;
	}
	[data-ptintro] .pp-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-ptintro] .pp-eye {
		fill: var(--pp-line);
	}
	[data-ptintro] .pp-mouth {
		fill: none;
		stroke: var(--pp-line);
		stroke-width: 0.7;
		stroke-linecap: round;
	}
	[data-ptintro] .pp-hair {
		fill: hsl(25, 40%, 28%);
	}
	[data-ptintro] .pp-hat,
	[data-ptintro] .pp-pompom,
	[data-ptintro] .pp-mitten {
		fill: var(--pp-hat);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-ptintro] .pp-hat-band {
		fill: color-mix(in oklab, var(--pp-hat) 70%, var(--pp-line));
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-ptintro] .pp-scarf {
		fill: var(--pp-scarf);
		stroke: var(--pp-line);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}
	[data-ptintro] .pp-boot {
		fill: var(--pp-boot);
		stroke: var(--pp-line);
		stroke-width: 0.7;
	}
	[data-ptintro] .pp-sole {
		fill: var(--pp-line);
	}
	[data-ptintro] .pp-cuff {
		fill: var(--pp-fur);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { human, type HumanPose } from '../mehanicheskaya-rabota/people';
	import { person } from '../davlenie-zakon-paskalya/person';

	const smooth = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, u: number) => a + (b - a) * u;
	// falling snowflakes: positions repeat every `period` s
	const flakes = (g: SVGGElement, n: number, box: { x: number; y: number; w: number; h: number }, seed: number) => {
		let s = seed;
		const rnd = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
		const list = Array.from({ length: n }, () => {
			const c = el('circle', { class: 'pti-flake', r: (0.7 + rnd() * 0.9).toFixed(2) });
			g.append(c);
			return { c, x: rnd(), y: rnd(), v: 0.08 + rnd() * 0.06, w: rnd() * 6.28 };
		});
		return (t: number) => {
			for (const f of list) {
				const y = (f.y + f.v * t) % 1;
				const x = f.x + 0.02 * Math.sin(f.w + t * 1.3);
				f.c.setAttribute('cx', (box.x + ((x + 1) % 1) * box.w).toFixed(1));
				f.c.setAttribute('cy', (box.y + y * box.h).toFixed(1));
			}
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-ptintro]')) {
		{
			// the garland
			const card = root.querySelector<HTMLElement>('[data-scene="garland"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const G = 214;
			const S = 0.85;
			const H = 150;
			const u = S * H;
			const A = 7 * S * (H / 172);
			const girl = human($<SVGGElement>('[data-girl]'), { s: S, H, shirt: 'hm-green', hair: 'pony' });
			// the pressing hand is drawn in front of the box: a second copy of the arm only
			const hand = human($<SVGGElement>('[data-hand]'), { s: S, H, shirt: 'hm-green', hair: 'pony' });
			// of the second copy only the near arm and hand stay visible
			const hg = $<SVGGElement>('[data-hand]');
			[...hg.querySelectorAll(':scope > g > *')].forEach((n, i, all) => {
				if (i < all.length - 3) (n as SVGElement).style.display = 'none';
			});
			const hipX = 78;
			const lamps: { on: SVGCircleElement; glow: SVGCircleElement }[] = [];
			const path = card.querySelector<SVGPathElement>('.pti-wire')!;
			const L = path.getTotalLength();
			const colors = ['var(--ig-v)', 'var(--ig-vy)', 'var(--ig-vx)', 'hsl(150, 60%, 55%)'];
			const lg = $<SVGGElement>('[data-lamps]');
			for (let i = 0; i < 30; i++) {
				const p = path.getPointAtLength(((i + 0.5) / 30) * L);
				const glow = el('circle', { cx: p.x.toFixed(1), cy: p.y.toFixed(1), r: '6', fill: 'url(#pti-glow)', style: `color: ${colors[i % 4]}`, opacity: '0' });
				const on = el('circle', { class: 'pti-lamp-off', cx: p.x.toFixed(1), cy: p.y.toFixed(1), r: '1.7' });
				lg.append(glow, on);
				lamps.push({ on, glow });
			}
			const star = $<SVGPathElement>('[data-star]');
			// the magnified wire: copper ions in a lattice, electrons among them
			const ions = $<SVGGElement>('[data-ions]');
			for (let x = 162; x < 240; x += 8) for (const y of [156, 164, 172]) ions.append(el('circle', { class: 'pti-ion', cx: x + (y === 164 ? 4 : 0), cy: y, r: 1.6 }));
			const eg = $<SVGGElement>('[data-electrons]');
			const els = Array.from({ length: 14 }, (_, i) => {
				const c = el('circle', { class: i === 6 ? 'pti-e is-mark' : 'pti-e', r: i === 6 ? 2.6 : 2.1 });
				eg.append(c);
				return { c, x0: 164 + i * 5.6 + (i % 3) * 1.3, y0: 156 + ((i * 7) % 5) * 4, ph: i * 1.7 };
			});
			const snow = flakes($<SVGGElement>('[data-flakes1]'), 12, { x: 150, y: 36, w: 72, h: 88 }, 7);
			const PRESS = 1.2; // s
			const V = 10.0; // px per s: 0,031 мм/с at 320 px per мм
			scene(card, 6, (x) => {
				const t = 6 * x;
				const on = t >= PRESS;
				// the near hand goes to the button and presses it
				const reach = smooth((t - 0.2) / 0.9);
				const push = t > PRESS - 0.15 && t < PRESS + 0.35 ? 1.4 : 0;
				const nearHand = { x: lerp(92, 107, reach), y: lerp(152, 124.5 + push, reach) };
				const pose = {
					hip: { x: hipX, y: G - 0.505 * u },
					lean: 0.04,
					ankles: [
						{ x: hipX + 0.03 * u, y: G - A },
						{ x: hipX - 0.04 * u, y: G - A },
					] as [{ x: number; y: number }, { x: number; y: number }],
					feet: [0, 0] as [number, number],
					hands: [nearHand, { x: 104, y: 138 }] as [{ x: number; y: number }, { x: number; y: number }],
					// the index finger presses the button (the fingertip is the target), the wrist straight
					grips: [{ pose: 'tap' }, null] as HumanPose['grips'],
					head: on ? lerp(0.25, -0.12, smooth((t - PRESS - 0.4) / 0.8)) : 0.25,
				};
				girl(pose);
				hand(pose);
				for (const l of lamps) {
					l.on.setAttribute('class', on ? 'pti-lamp-on' : 'pti-lamp-off');
					l.on.style.fill = on ? l.glow.style.color : '';
					l.glow.setAttribute('opacity', on ? '1' : '0');
				}
				star.classList.toggle('is-on', on);
				// electrons: a small jiggle always, the slow drift to the left once the circuit is closed
				const d = on ? V * (t - PRESS) : 0;
				for (const e of els) {
					let ex = e.x0 - d + 1.2 * Math.sin(t * 9 + e.ph) + 0.8 * Math.sin(t * 13.7 + 2 * e.ph);
					while (ex < 160) ex += 80;
					const ey = e.y0 + 1.2 * Math.sin(t * 11 + 3 * e.ph);
					e.c.setAttribute('cx', ex.toFixed(1));
					e.c.setAttribute('cy', ey.toFixed(1));
				}
				snow(t);
			});
		}
		{
			// the car
			const card = root.querySelector<HTMLElement>('[data-scene="car"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 0.45;
			const X = (x: number) => 30 + S * x;
			const Y = (y: number) => 204 - S * y;
			const H = 178;
			const driver = person($<SVGGElement>('[data-driver]'), { s: S, H, girth: 1.05, gear: 'boot', coat: 'pti-coat' });
			const car = $<SVGGElement>('[data-car]');
			const light = $<SVGGElement>('[data-light]');
			const lamp = $<SVGEllipseElement>('[data-lamp]');
			const puffs = $<SVGGElement>('[data-puffs]');
			const puffEls = Array.from({ length: 6 }, () => {
				const c = el('circle', { class: 'pti-puff', r: '0', opacity: '0' });
				puffs.append(c);
				return c;
			});
			const snow = flakes($<SVGGElement>('[data-flakes2]'), 26, { x: 0, y: -4, w: 360, h: 212 }, 3);
			const KEY = 1.4; // s, the starter turns
			const START = 3.6; // s, the engine runs
			// the light of the lamps relative to 12,6 В (see the header)
			const lightAt = (t: number) => {
				if (t < KEY) return 0.97;
				if (t < START) return lerp(0.97, 0.56, smooth((t - KEY) / 0.15));
				return lerp(0.56, 1.5, smooth((t - START) / 0.3));
			};
			scene(card, 7, (x) => {
				const t = 7 * x;
				const Lt = lightAt(t);
				light.setAttribute('opacity', Math.min(1, 0.85 * Lt).toFixed(3));
				lamp.style.opacity = (0.35 + 0.65 * Math.min(1, 0.85 * Lt)).toFixed(2);
				// shaking: strong while the starter cranks, weak while the engine idles
				const amp = t >= KEY && t < START ? 0.7 : t >= START ? 0.2 : 0;
				const dy = amp * Math.sin(t * 2 * Math.PI * 13);
				const rot = amp * 0.35 * Math.sin(t * 2 * Math.PI * 9 + 1);
				car.setAttribute('transform', `translate(0 ${dy.toFixed(2)}) rotate(${rot.toFixed(2)} ${X(215)} ${Y(30)})`);
				// the driver: hands on the wheel; the near one goes to the key and back
				const toKey = smooth((t - (KEY - 0.4)) / 0.35) * (1 - smooth((t - (START + 0.3)) / 0.4));
				const hip = { x: X(244), y: Y(50) };
				driver({
					hip,
					lean: -0.28,
					ankles: [
						{ x: X(322), y: Y(26) },
						{ x: X(316), y: Y(28) },
					],
					feet: [-0.4, -0.4],
					hands: [
						{ x: lerp(X(287), X(289), toKey), y: lerp(Y(98), Y(82), toKey) },
						{ x: X(285), y: Y(101) },
					],
					head: -0.05,
				});
				// exhaust: a puff every 0,45 s once the engine runs
				puffEls.forEach((c, i) => {
					const age = t - START - i * 0.45;
					if (age < 0 || age > 2.4) {
						c.setAttribute('opacity', '0');
						return;
					}
					c.setAttribute('cx', (X(-6) - 9 * age).toFixed(1));
					c.setAttribute('cy', (Y(33) - 5 * age - 2 * age * age).toFixed(1));
					c.setAttribute('r', (2 + 4.5 * age).toFixed(1));
					c.setAttribute('opacity', (0.75 * (1 - age / 2.4)).toFixed(2));
				});
				snow(t);
			});
		}
	}
</script>
