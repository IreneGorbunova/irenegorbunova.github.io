---
/**
 * Two short looping opening scenes of «Законы постоянного тока» (grade 10). No terms of the chapter in the pictures or
 * the visible captions; each caption's popover names the notion and links to its section. People: the shared people
 * kit (src/components/people/). Grade 8 has the garland and the wall switch, grade 9 the crank lantern, so this
 * chapter shows a lemon battery and a car starter.
 *
 * Lemons (an evening kitchen, side view and a little from above; 2,2 px per см, real time, 7 с). A teenager (kit, 165 см,
 *   seated on a chair 46 см high at a table 75 см high; the hip joint is at the lower edge of the picture) has four
 *   lemons in a row on the table (8,5 × 6,5 см). In each lemon a galvanized (zinc-coated) nail and a copper plate
 *   2 см wide; short leads with crocodile clips join the copper of one lemon to the nail of the next. The copper of
 *   the last lemon is joined to one leg of a red LED (drawn about three times its real 5 мм so that it shows); a lead
 *   from the other leg ends in a clip that the teenager holds between the thumb and the index finger. At 0,4–1,45 с the
 *   hand brings the clip down onto the nail of the first lemon; from 1,5 с the LED glows faintly red (the room is dim);
 *   at 4,6 с the hand lifts the clip off again (the LED goes out at once) and returns to its first pose by 5,4 с.
 *   Physics: zinc and copper in lemon juice give about 0,9 В; four lemons one after another about 3,6 В, enough for a
 *   red LED (it needs about 1,8 В); the internal resistance of one lemon is of order 1 кОм, so the current is below
 *   1 мА (3,6 В / 4 кОм ≈ 0,9 мА): the LED glows dimly, and a flashlight bulb (0,3 А) would stay dark.
 * Car: a winter morning, 0,45 px per см. A man (kit, 178 см, winter clothes, gloves) sits in a car 4,3 м long with
 *   the headlights on; the beam falls on a garage door. A magnifier above the car shows the cabin 2,4 times larger
 *   (1,1 px per см; the door is cut away), the same pose of the same man drawn with the kit at that scale: his left
 *   (far) hand holds the steering wheel, his right (near) hand reaches the key at 0,95–1,35 с, holds it between the
 *   thumb and the index finger and turns it for the start (1,4–3,6 с), lets it spring back and returns to the wheel by
 *   4,3 с. 0–1,4 с engine off, the battery gives the lamps ≈ 12,5 В; 1,4–3,6 с the starter cranks (the car shakes),
 *   the battery gives ≈ 10,6 В (200 А through r ≈ 0,01 Ом); from 3,6 с the engine runs and the generator gives
 *   ≈ 14,2 В. The light of a halogen lamp goes roughly as U^3,4: 0,97, 0,56 and 1,5 of its light at 12,6 В; the
 *   opacity of the beam is 0,85 of these numbers (0,82, 0,48, then 1 where it would exceed 1), the beam fades little
 *   before the door, and the garage door is a dark one, so the dimming to 0,58 of the light shows plainly; the lamp
 *   glass follows it above a floor of 0,35. Real time; the shaking of the car is exaggerated so that it shows.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

const f1 = (v: number) => +v.toFixed(1);

// ---------------- the lemon scene (px; 2,2 px per см)
const TT = 180; // the front edge of the table top
const TB = 171; // its back edge
const BASE = 176; // where things stand on the table
const LEM = [150, 188, 226, 264]; // the lemons' centers
const LY = 169; // their center line (8,5 × 6,5 см: half 9,4 × 7,2 px)
const lemon = (cx: number) => {
	const a = 9.4;
	const b = 7.2;
	return `M${cx - a - 2} ${LY} Q${cx - a} ${LY - b * 0.95} ${cx} ${LY - b} Q${cx + a} ${LY - b * 0.95} ${cx + a + 2} ${LY} Q${cx + a} ${LY + b * 0.95} ${cx} ${LY + b} Q${cx - a} ${LY + b * 0.95} ${cx - a - 2} ${LY} Z`;
};
const NAIL = (cx: number) => cx - 4; // the nail's x
const CU = (cx: number) => cx + 4.6; // the copper plate's middle
const TOP = 156; // the top of the nails and plates
// a small crocodile clip at (x, y), pointing along angle a (deg), its lead going back
const clip = (x: number, y: number, a: number) =>
	`<g transform="translate(${x} ${y}) rotate(${a})"><path class="zl-clip" d="M-6 -1.6 L1.6 -0.5 L1.6 0.5 L-6 1.6 Z"></path><rect class="zl-boot" x="-10" y="-1.9" width="5" height="3.8" rx="1.2"></rect></g>`;
// leads between the lemons: copper of one → nail of the next
const leads = LEM.slice(0, 3).map((cx, i) => {
	const x0 = CU(cx);
	const x1 = NAIL(LEM[i + 1]);
	return { d: `M${x0} ${TOP + 2.5} C${x0 - 2} ${TOP - 14} ${x1 + 2} ${TOP - 14} ${x1} ${TOP + 2.5}`, x0, x1, cls: ['zl-lead--a', 'zl-lead--b', 'zl-lead--c'][i] };
});
// the LED: legs spread on the table, the dome above
const LEDX = 320;
const L4 = LEM[3];

// ---------------- the car scene: px = 30 + 0,45·x, py = 204 − 0,45·y, with x, y in centimeters
const S = 0.45;
const GY = 204;
const X = (x: number) => +(30 + S * x).toFixed(1);
const Y = (y: number) => +(GY - S * y).toFixed(1);
const pt = (x: number, y: number) => `${X(x)} ${Y(y)}`;
const arch = (cx: number, r: number) => `L${pt(cx + r, 38)} A${(r * S).toFixed(1)} ${(r * S).toFixed(1)} 0 0 0 ${pt(cx - r, 38)}`;
const body =
	`M${pt(0, 40)} L${pt(2, 84)} Q${pt(4, 96)} ${pt(20, 98)} L${pt(82, 103)} L${pt(140, 141)} Q${pt(148, 145)} ${pt(160, 145)} L${pt(250, 145)} ` +
	`Q${pt(262, 144)} ${pt(270, 138)} L${pt(318, 104)} L${pt(404, 92)} Q${pt(426, 88)} ${pt(430, 76)} L${pt(432, 44)} Q${pt(432, 38)} ${pt(424, 38)} ` +
	`${arch(345, 38)} ${arch(85, 38)} L${pt(6, 38)} Q${pt(0, 38)} ${pt(0, 40)} Z`;
const glass = `M${pt(150, 133)} L${pt(250, 136)} Q${pt(258, 135)} ${pt(264, 130)} L${pt(304, 103)} L${pt(140, 101)} Z`;
const flats: { x: number; y: number; lit: boolean }[] = [];
for (let r = 0; r < 4; r++)
	for (let c = 0; c < 9; c++) flats.push({ x: 14 + c * 31, y: 26 + r * 26, lit: (c * 7 + r * 3) % 5 === 1 || (c + r) % 7 === 3 });
// the cabin in the magnifier: 1,1 px per см around the point (266; 92) см, drawn at (150; 70) px, radius 54 px
const K = 1.1;
const LC = { x: 150, y: 70, r: 54 };
const lx = (x: number) => f1(LC.x + K * (x - 266));
const ly = (y: number) => f1(LC.y - K * (y - 92));
const lp = (x: number, y: number) => `${lx(x)} ${ly(y)}`;
// the steering wheel: center (286; 90) см, rim 38 см across seen edge-on, its plane at 69° to the horizontal
const WC = { x: 286, y: 90 };
const WA = 69; // deg
const lensSeat = `M${lp(221, 44)} L${lp(212, 118)} Q${lp(210, 130)} ${lp(219, 130)} L${lp(227, 128)} L${lp(238, 52)} Z M${lp(222, 40)} L${lp(266, 44)} Q${lp(272, 46)} ${lp(270, 54)} L${lp(226, 56)} Z`;
const lensWindow = `M${lp(196, 101)} L${lp(304, 103)} L${lp(264, 130)} Q${lp(258, 135)} ${lp(250, 136)} L${lp(196, 136)} Z`;
const lensDash = `M${lp(298, 100)} L${lp(304, 103)} L${lp(330, 100)} L${lp(330, 62)} L${lp(300, 64)} Q${lp(294, 80)} ${lp(298, 100)} Z`;
---

<PeopleStyles />
<IntroFrame data-ptintro>
	<div class="intro__card" data-scene="lemons">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер на кухне. На столе четыре лимона, в каждом гвоздь и медная пластинка, лимоны соединены проводами друг за другом. Подросток прикрепляет последний зажим к гвоздю первого лимона, и маленький красный светодиод на столе слабо загорается. Когда зажим снимают, светодиод гаснет">
			<defs>
				<linearGradient id="zl-dusk" x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" class="zl-dusk-a"></stop>
					<stop offset="1" class="zl-dusk-b"></stop>
				</linearGradient>
				<radialGradient id="zl-glow">
					<stop offset="0" class="zl-glow-a"></stop>
					<stop offset="0.35" class="zl-glow-b"></stop>
					<stop offset="1" class="zl-glow-c"></stop>
				</radialGradient>
			</defs>
			<!-- the room -->
			<rect class="zl-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="zl-window" x="206" y="16" width="84" height="80" rx="2"></rect>
			<path class="zl-city" d="M206 96 V80 H218 V72 H230 V84 H244 V66 H256 V78 H270 V70 H282 V86 H290 V96 Z"></path>
			<rect class="zl-citylight" x="222" y="76" width="3" height="3"></rect>
			<rect class="zl-citylight" x="248" y="70" width="3" height="3"></rect>
			<rect class="zl-citylight" x="274" y="76" width="3" height="3"></rect>
			<path class="zl-frame" d="M206 16 H290 V96 H206 Z M248 16 V96 M206 56 H290"></path>
			<rect class="zl-sill" x="200" y="96" width="96" height="5" rx="1"></rect>
			<rect class="zl-cabinet" x="304" y="6" width="58" height="62" rx="2"></rect>
			<path class="zl-cabinet-line" d="M333 8 V66 M326 34 V42 M340 34 V42"></path>
			<path class="zl-cord" d="M170 0 V30"></path>
			<path class="zl-shade" d="M160 42 L164 30 H176 L180 42 Z"></path>
			<rect class="zl-shelf" x="0" y="44" width="34" height="3"></rect>
			<rect class="zl-jar" x="6" y="30" width="9" height="14" rx="2"></rect>
			<rect class="zl-jar zl-jar--b" x="19" y="34" width="8" height="10" rx="2"></rect>
			<!-- the chair -->
			<rect class="zl-chair" x="8" y="118" width="8" height="122" rx="3"></rect>
			<rect class="zl-chair" x="4" y="112" width="18" height="9" rx="3"></rect>
			<!-- the table -->
			<path class="zl-top" d={`M100 ${TB} H360 V${TT} H96 Z`}></path>
			<rect class="zl-edge" x="96" y={TT} width="264" height="7"></rect>
			<rect class="zl-leg zl-leg--far" x="336" y={TT + 7} width="7" height={240 - TT - 7}></rect>
			<!-- the LED's light on the table -->
			<ellipse class="zl-pool" data-pool cx={LEDX} cy={BASE} rx="30" ry="6" opacity="0"></ellipse>
			<!-- a cutting board with a lemon half -->
			<rect class="zl-board" x="282" y={BASE - 3} width="26" height="4" rx="1.5"></rect>
			<path class="zl-lemon" d={`M286 ${BASE - 3} A8 6 0 0 1 302 ${BASE - 3} Z`}></path>
			<path class="zl-pulp" d={`M287.8 ${BASE - 3.6} A6.2 4.4 0 0 1 300.2 ${BASE - 3.6} Z`}></path>
			<!-- the lemons, nails and copper plates -->
			{LEM.map((cx) => (
				<g>
					<ellipse class="zl-shadow" cx={cx} cy={BASE + 0.5} rx="11" ry="2" />
					<path class="zl-lemon" d={lemon(cx)} />
					<ellipse class="zl-shine" cx={cx - 3} cy={LY - 3.5} rx="3.2" ry="1.4" />
					<path class="zl-nail" d={`M${NAIL(cx)} ${LY - 4} V${TOP}`} />
					<path class="zl-nailhead" d={`M${NAIL(cx) - 1.8} ${TOP} H${NAIL(cx) + 1.8}`} />
					<rect class="zl-cu" x={CU(cx) - 2.2} y={TOP + 0.5} width="4.4" height={LY - 4 - TOP} />
				</g>
			))}
			<!-- the leads between the lemons -->
			{leads.map((l) => (
				<g>
					<path class={`zl-lead ${l.cls}`} d={l.d} />
					<Fragment set:html={clip(l.x0, TOP + 3, 98)} />
					<Fragment set:html={clip(l.x1 + 0.6, TOP + 3, 82)} />
				</g>
			))}
			<!-- the LED and its lead from the last copper plate -->
			<path class="zl-lead zl-lead--d" d={`M${CU(L4)} ${TOP + 2.5} C${CU(L4) + 4} ${TOP - 18} ${LEDX - 16} ${TOP - 6} ${LEDX - 6.5} ${BASE - 1.5}`}></path>
			<Fragment set:html={clip(CU(L4), TOP + 3, 96)} />
			<Fragment set:html={clip(LEDX - 6.2, BASE - 2.2, 62)} />
			<path class="zl-ledleg" d={`M${LEDX - 1.2} ${BASE - 12} L${LEDX - 5.5} ${BASE} M${LEDX + 1.2} ${BASE - 12} L${LEDX + 6} ${BASE}`}></path>
			<circle class="zl-halo" data-halo cx={LEDX} cy={BASE - 15} r="18" fill="url(#zl-glow)" opacity="0"></circle>
			<path class="zl-led" data-led d={`M${LEDX - 2.3} ${BASE - 11.5} V${BASE - 16.5} A2.3 2.3 0 0 1 ${LEDX + 2.3} ${BASE - 16.5} V${BASE - 11.5} Z`}></path>
			<rect class="zl-ledrim" x={LEDX - 2.9} y={BASE - 12.3} width="5.8" height="1.3" rx="0.4"></rect>
			<!-- the held clip and its lead (drawn by the script), the far fingers of the near hand behind it -->
			<g data-hback></g>
			<path class="zl-lead zl-lead--e" data-wire></path>
			<g data-clip>
				<path class="zl-clip" d="M-2 -2.3 L6 -2 L15 -0.5 L15 0.5 L6 2 L-2 2.3 Z"></path>
				<path class="zl-teeth" d="M7 -1.5 L8 -0.7 L9 -1.3 L10 -0.6 L11 -1.1 L12 -0.5 L13 -0.8"></path>
				<rect class="zl-boot zl-boot--e" x="-9" y="-2.6" width="7.5" height="5.2" rx="1.6"></rect>
			</g>
			<g data-teen></g>
			<rect class="zl-leg" x="110" y={TT + 7} width="7" height={240 - TT - 7}></rect>
			<!-- dim evening light over everything but the LED -->
			<rect class="zl-dim" x="0" y="0" width="360" height="240"></rect>
			<circle class="zl-halo2" data-halo2 cx={LEDX} cy={BASE - 15} r="9" fill="url(#zl-glow)" opacity="0"></circle>
		</svg>
		<div class="intro__foot">
			<p>
				Четыре лимона с гвоздями и медными пластинками, соединённые проводами, зажигают{' '}
				<More term="светодиод">
					Лимон с цинковым гвоздём и медной пластинкой — источник тока: в соке идут химические реакции, и между металлами возникает около 0,9&nbsp;В. Четыре лимона, соединённые один за другим, дают около 3,6&nbsp;В — достаточно для красного светодиода. А лампочку фонарика они не зажгут: ток от лимонов меньше миллиампера. Почему — в разделах <a href="#электродвижущая-сила">«Электродвижущая сила»</a> и <a href="#соединение-источников">«Соединение источников»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="car">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зимним утром водитель заводит машину с включёнными фарами. В лупе видно, как он поворачивает ключ. Пока крутится стартер, свет фар на воротах гаража тускнеет, а когда двигатель заработал, снова становится ярким">
			<defs>
				<linearGradient id="pti-beam" x1="0" x2="1" y1="0" y2="0">
					<stop offset="0" class="pti-beam-a"></stop>
					<stop offset="1" class="pti-beam-b"></stop>
				</linearGradient>
				<radialGradient id="pti-spot">
					<stop offset="0" class="pti-beam-a"></stop>
					<stop offset="1" class="pti-beam-b"></stop>
				</radialGradient>
				<clipPath id="pti-glass"><path d={glass}></path></clipPath>
				<clipPath id="pti-lens"><circle cx={LC.x} cy={LC.y} r={LC.r}></circle></clipPath>
			</defs>
			<rect class="pti-sky" x="0" y="0" width="360" height="240"></rect>
			<!-- the house across the yard -->
			<rect class="pti-house" x="4" y="14" width="290" height="190"></rect>
			{flats.map((w) => <rect class={w.lit ? 'pti-flat pti-flat--lit' : 'pti-flat'} x={w.x} y={w.y} width="14" height="12" rx="0.8" />)}
			<rect class="pti-entrance" x="214" y="150" width="22" height="54"></rect>
			<rect class="pti-canopy" x="208" y="146" width="34" height="4"></rect>
			<!-- the garage on the right -->
			<rect class="pti-garage" x="318" y="118" width="46" height="86"></rect>
			<path class="pti-door-ribs" d="M322 134 H364 M322 144 H364 M322 154 H364 M322 164 H364 M322 174 H364 M322 184 H364 M322 194 H364"></path>
			<path class="pti-snow" d="M314 118 Q330 110 346 114 T366 116 V122 H314 Z"></path>
			<!-- the yard -->
			<path class="pti-snow" d="M0 198 Q80 193 160 197 T360 195 V240 H0 Z"></path>
			<path class="pti-drift" d="M300 204 Q314 190 330 196 Q344 186 360 192 V214 H300 Z"></path>
			<!-- the light of the headlights -->
			<g data-light>
				<path class="pti-beam" d="M222 167 L318 140 L318 204 L300 214 L222 172 Z"></path>
				<ellipse class="pti-spot" cx="326" cy="170" rx="22" ry="28"></ellipse>
				<ellipse class="pti-spot" cx="282" cy="206" rx="36" ry="5"></ellipse>
			</g>
			<g data-puffs></g>
			<!-- the car -->
			<g data-car>
				<g clip-path="url(#pti-glass)">
					<path class="pti-cabin" d={glass}></path>
					<path class="pti-seat" d={`M${pt(222, 44)} L${pt(214, 118)} Q${pt(212, 128)} ${pt(220, 128)} L${pt(226, 126)} L${pt(238, 50)} Z`}></path>
					<g data-driver></g>
					<path class="pti-wheel" d={`M${pt(279, 107.7)} L${pt(292.8, 72.3)}`}></path>
				</g>
				<path class="pti-body" d={`${body} ${glass}`} fill-rule="evenodd"></path>
				<path class="pti-glass" d={glass}></path>
				<path class="pti-pillar" d={`M${pt(200, 140)} L${pt(203, 101)} L${pt(211, 101)} L${pt(208, 141)} Z`}></path>
				<path class="pti-seam" d={`M${pt(140, 101)} L${pt(318, 104)} M${pt(204, 101)} L${pt(206, 40)} M${pt(318, 104)} L${pt(312, 40)} M${pt(82, 103)} L${pt(140, 101)}`}></path>
				<rect class="pti-handlebar" x={X(186)} y={Y(92)} width={14 * S} height="1.6" rx="0.8"></rect>
				<rect class="pti-handlebar" x={X(290)} y={Y(94)} width={14 * S} height="1.6" rx="0.8"></rect>
				<path class="pti-mirror" d={`M${pt(304, 104)} L${pt(312, 112)} L${pt(318, 106)} L${pt(312, 100)} Z`}></path>
				<path class="pti-snow" d={`M${pt(142, 144)} Q${pt(150, 152)} ${pt(170, 151)} L${pt(246, 151)} Q${pt(260, 150)} ${pt(262, 144)} Z`}></path>
				<path class="pti-snow" d={`M${pt(330, 102)} Q${pt(360, 104)} ${pt(400, 96)} L${pt(404, 92)} L${pt(320, 103)} Z`}></path>
				<ellipse class="pti-headlight" data-lamp cx={X(424)} cy={Y(78)} rx="3.2" ry="2.4"></ellipse>
				<rect class="pti-tail" x={X(0) - 0.5} y={Y(86)} width="2.6" height="5" rx="1"></rect>
				<rect class="pti-pipe" x={X(-4)} y={Y(34)} width="6" height="2" rx="1"></rect>
				<rect class="pti-plate" x={X(430) - 1} y={Y(56)} width="2" height="8"></rect>
				{[85, 345].map((cx) => (
					<g>
						<circle class="pti-tyre" cx={X(cx)} cy={Y(31)} r={31 * S} />
						<circle class="pti-rim" cx={X(cx)} cy={Y(31)} r={18 * S} />
						<circle class="pti-hub" cx={X(cx)} cy={Y(31)} r={5 * S} />
					</g>
				))}
			</g>
			<g data-flakes2></g>
			<!-- the magnifier: the cabin with the door cut away -->
			<path class="pti-leader" d={`M${LC.x + 8} ${LC.y + LC.r} L${X(268)} ${Y(112)}`}></path>
			<circle class="pti-lens-bg" cx={LC.x} cy={LC.y} r={LC.r}></circle>
			<g clip-path="url(#pti-lens)">
				<g data-lens-in>
					<rect class="pti-cabin" x={LC.x - LC.r} y={LC.y - LC.r - 4} width={2 * LC.r} height={2 * LC.r + 8}></rect>
					<path class="pti-lens-window" d={lensWindow}></path>
					<path class="pti-lens-frame" d={`M${lp(196, 101)} L${lp(304, 103)} M${lp(196, 136)} L${lp(250, 136)} Q${lp(258, 135)} ${lp(264, 130)} L${lp(304, 103)}`}></path>
					<path class="pti-seat" d={lensSeat}></path>
					<g data-driver-big></g>
					<path class="pti-dash" d={lensDash}></path>
					<circle class="pti-gauge" cx={lx(314)} cy={ly(90)} r="4.2"></circle>
					<path class="pti-needle" d={`M${lx(314)} ${ly(90)} l2.6 -2`}></path>
					<path class="pti-column" d={`M${lp(WC.x, WC.y)} L${lp(310, 80.5)}`}></path>
					<ellipse class="pti-rim-big" cx={lx(WC.x)} cy={ly(WC.y)} rx={f1(19 * K)} ry={f1(3.2 * K)} transform={`rotate(${WA} ${lx(WC.x)} ${ly(WC.y)})`}></ellipse>
					<circle class="pti-hubcap" cx={lx(WC.x)} cy={ly(WC.y)} r="2.4"></circle>
					<g data-near-back></g>
					<g data-key>
						<rect class="pti-key" x="-0.9" y="-1.6" width="4.6" height="3.2" rx="1.2"></rect>
						<rect class="pti-key-blade" x="-3.6" y="-0.55" width="3" height="1.1"></rect>
					</g>
					<g data-near-arm></g>
				</g>
			</g>
			<circle class="pti-lens" cx={LC.x} cy={LC.y} r={LC.r}></circle>
		</svg>
		<div class="intro__foot">
			<p>
				Зимним утром водитель заводит машину с включёнными фарами, и, пока крутится стартер,{' '}
				<More term="фары светят заметно слабее">
					Стартер берёт у аккумулятора ток около 200&nbsp;А. При таком токе заметная часть ЭДС аккумулятора приходится на его собственное, внутреннее сопротивление: напряжение на полюсах падает с 12,6 до 10–11&nbsp;В, и лампы светят почти вдвое слабее. Когда двигатель заработал, фары питает генератор, около 14&nbsp;В, и они светят даже ярче, чем вначале. Об этом — в разделе <a href="#закон-ома-для-полной-цепи">«Закон Ома для полной цепи»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

