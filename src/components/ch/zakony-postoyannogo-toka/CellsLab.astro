---
/**
 * «Соединение источников» (§ «Соединение источников», before the rule ℰ = ℰ₁ + ℰ₂ + …): a flashlight's holder drawn
 * open with four slots in a row, joined one after another. A tap on a slot (or Enter / Space on it) cycles: empty
 * (a metal jumper) → a source with «+» to the right → the source turned («+» to the left) → empty. The switch
 * «Батарейки / Лимоны» puts AA cells (ℰ = 1,5 В, r = 0,2 Ом) or lemons with a zinc nail and a copper plate
 * (ℰ = 0,9 В, r = 1000 Ом) into the occupied slots. The load is a flashlight lamp «6 В; 0,5 А», taken as a constant
 * R = 12 Ом (the caption says so). The voltmeter is joined to the ends of the holder, the ammeter, the key and the
 * lamp are in series. Ideal meters (the voltmeter takes no current, the ammeter has no resistance).
 * Physics: ℰ_б = Σ ±ℰᵢ (a turned source counts with a minus), r_б = Σ rᵢ over the occupied slots;
 * key closed: I = ℰ_б/(R + r_б), U = IR; key open: I = 0, U = ℰ_б. Readings are signed (the meters' «+» is on the
 * right end of the holder). The glow of the lamp grows with I²R, full at 3 Вт.
 * The model shows only what meters show (no sums written out): the reader finds the rule in it.
 * Check (cells): 1 → open 1,5 В; closed 0,123 А, 1,48 В; 2 → 0,242 А, 2,90 В; 3 → 0,357 А, 4,29 В; 4 → open 6,00 В,
 * closed 0,469 А, 5,63 В; three with one turned → open 1,50 В, closed 0,119 А, 1,43 В. Lemons: 4 → open 3,60 В,
 * closed 0,90 мА, 0,011 В, the lamp dark; 1 lemon → 0,89 мА.
 */
import G7Styles from '../g7/G7Styles.astro';

const SX = [40, 104, 168, 232]; // the slots' left edges, 62 px wide
const SY = 74; // the axis of the holder
---

<G7Styles />
<figure class="g7 cells not-content" data-cells>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 238" role="img" aria-label="Фонарик, открытый сбоку: четыре гнезда для батареек или лимонов, соединённых друг за другом. Вольтметр подключён к концам батареи; амперметр, ключ и лампа включены последовательно">
			<defs>
				<radialGradient id="cells-glow">
					<stop offset="0" class="cells-glow-a"></stop>
					<stop offset="1" class="cells-glow-b"></stop>
				</radialGradient>
			</defs>
			<!-- wires -->
			<path class="cells-wire" d="M34 74 H18 V196 H79 M105 196 H160 M192 196 H250 M274 196 H334 V74 H302"></path>
			<path class="cells-wire" d="M18 74 V36 H158 M182 36 H334 V74"></path>
			<circle class="cells-node" cx="18" cy="74" r="2.6"></circle>
			<circle class="cells-node" cx="334" cy="74" r="2.6"></circle>
			<!-- the holder -->
			<rect class="cells-tube" x="30" y="52" width="276" height="44" rx="10"></rect>
			<rect class="cells-tube-in" x="36" y="58" width="264" height="32" rx="6"></rect>
			{SX.map((x) => <rect class="cells-tab" x={x - 3} y="62" width="3" height="24" rx="1" />)}
			<rect class="cells-tab" x="296" y="62" width="3" height="24" rx="1"></rect>
			<rect class="cells-end" x="300" y="66" width="6" height="16" rx="1"></rect>
			<rect class="cells-end" x="30" y="66" width="6" height="16" rx="1"></rect>
			{SX.map((x, i) => (
				<g class="cells-slot" data-slot={i} tabindex="0" role="button" aria-label={`Гнездо ${i + 1}`}>
					<rect class="cells-hit" x={x} y="54" width="62" height="40" rx="4" />
					<g data-draw></g>
				</g>
			))}
			<!-- the voltmeter -->
			<circle class="cells-meter" cx="170" cy="36" r="12"></circle>
			<text class="t-strong" x="170" y="40.5" text-anchor="middle">V</text>
			<rect class="cells-disp" x="192" y="4" width="82" height="22" rx="4"></rect>
			<text class="t-strong t-num cells-dtext" x="268" y="20" text-anchor="end" data-vread></text>
			<!-- the ammeter -->
			<circle class="cells-meter" cx="92" cy="196" r="13"></circle>
			<text class="t-strong" x="92" y="200.5" text-anchor="middle">A</text>
			<rect class="cells-disp" x="52" y="212" width="80" height="22" rx="4"></rect>
			<text class="t-strong t-num cells-dtext" x="126" y="228" text-anchor="end" data-aread></text>
			<!-- the key -->
			<g class="cells-key" data-keypic tabindex="-1">
				<rect class="cells-hit" x="154" y="168" width="44" height="40" rx="4"></rect>
				<circle class="cells-contact" cx="160" cy="196" r="3.4"></circle>
				<circle class="cells-contact" cx="192" cy="196" r="3.4"></circle>
				<line class="cells-lever" data-lever x1="160" y1="196" x2="188" y2="178"></line>
			</g>
			<text class="t-small" x="176" y="222" text-anchor="middle">ключ</text>
			<!-- the lamp -->
			<circle data-glow cx="262" cy="196" r="34" fill="url(#cells-glow)" opacity="0"></circle>
			<circle class="cells-lamp" data-lamp cx="262" cy="196" r="12"></circle>
			<path class="cells-fil" data-fil d="M253.5 187.5 L270.5 204.5 M270.5 187.5 L253.5 204.5"></path>
			<text class="t-small" x="262" y="222" text-anchor="middle">лампа</text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" data-kind>
				<button type="button" class="g7__btn" data-v="cell" aria-pressed="true">Батарейки</button>
				<button type="button" class="g7__btn" data-v="lemon" aria-pressed="false">Лимоны</button>
			</div>
			<button type="button" class="g7__btn g7__btn--go" data-key>Замкнуть ключ</button>
			<p class="g7__note">Нажимайте на гнёзда фонарика: пусто → «+» вправо → «+» влево → пусто. Батарейка: <i>ℰ</i> = 1,5&nbsp;В, <i>r</i> = 0,2&nbsp;Ом; лимон: <i>ℰ</i> = 0,9&nbsp;В, <i>r</i> = 1000&nbsp;Ом.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Сопротивление лампы считаем постоянным, 12&nbsp;Ом. Приборы идеальные: через вольтметр ток не идёт, амперметр не имеет сопротивления. Знак «−» на приборе значит, что ток идёт в обратную сторону.</figcaption>
</figure>

<style is:global>
	.cells-wire {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.cells-node {
		fill: var(--g7-ink);
	}
	.cells-tube {
		fill: color-mix(in oklab, var(--g7-steel) 70%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.cells-tube-in {
		fill: color-mix(in oklab, var(--g7-steel) 25%, var(--g7-paper));
	}
	.cells-tab,
	.cells-end,
	.cells-jumper {
		fill: hsl(42, 30%, 70%);
		stroke: hsl(42, 20%, 38%);
		stroke-width: 0.6;
	}
	.cells-slot {
		cursor: pointer;
		outline: none;
	}
	.cells-hit {
		fill: transparent;
		stroke: none;
	}
	.cells-slot:focus-visible .cells-hit,
	.cells-slot:hover .cells-hit {
		stroke: var(--sl-color-accent);
		stroke-width: 1.6;
		stroke-dasharray: 4 3;
	}
	.cells-key {
		cursor: pointer;
	}
	.cells-aa {
		fill: hsl(0, 0%, 20%);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.cells-aa-band {
		fill: hsl(32, 90%, 52%);
	}
	.cells-nub {
		fill: hsl(210, 8%, 72%);
		stroke: hsl(210, 10%, 40%);
		stroke-width: 0.6;
	}
	.cells-lemon {
		fill: hsl(52, 90%, 58%);
		stroke: hsl(40, 70%, 28%);
		stroke-width: 0.9;
	}
	.cells-zn {
		stroke: hsl(210, 8%, 70%);
		stroke-width: 2.4;
	}
	.cells-cu {
		fill: hsl(22, 70%, 54%);
		stroke: hsl(20, 60%, 28%);
		stroke-width: 0.6;
	}
	.cells-lead {
		fill: none;
		stroke: hsl(210, 8%, 62%);
		stroke-width: 1.2;
	}
	.g7__svg .cells-sign {
		font-size: 13px;
		font-weight: 700;
	}
	.cells-meter {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.cells-disp {
		fill: color-mix(in oklab, var(--g7-green) 10%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.cells-contact {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.cells-lever {
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.cells-lamp {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.cells-fil {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.cells-glow-a {
		stop-color: hsl(48, 100%, 68%);
		stop-opacity: 0.95;
	}
	.cells-glow-b {
		stop-color: hsl(48, 100%, 68%);
		stop-opacity: 0;
	}
	@media (max-width: 40rem) {
		[data-cells] .g7__svg .t-small {
			font-size: 12.5px;
		}
	}
</style>

<script>
	import { el, fmt, segment } from '../g7/kit';

	const SX = [40, 104, 168, 232];
	const SY = 74;
	const R = 12; // Ом, the lamp
	const SRC = { cell: { e: 1.5, r: 0.2 }, lemon: { e: 0.9, r: 1000 } };
	for (const root of document.querySelectorAll<HTMLElement>('[data-cells]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const slots = [...root.querySelectorAll<SVGGElement>('[data-slot]')];
		const state = [1, 0, 0, 0]; // 0 empty, 1 «+» to the right, 2 «+» to the left
		let kind: 'cell' | 'lemon' = 'cell';
		let closed = false;
		const drawSlot = (i: number) => {
			const g = slots[i].querySelector<SVGGElement>('[data-draw]')!;
			g.replaceChildren();
			const x0 = SX[i];
			const cx = x0 + 31;
			const s = state[i];
			const names = ['пусто', '«+» вправо', '«+» влево'];
			slots[i].setAttribute('aria-label', `Гнездо ${i + 1}: ${s ? (kind === 'cell' ? 'батарейка' : 'лимон') + ', ' + names[s] : names[0]}`);
			if (!s) {
				g.append(el('rect', { class: 'cells-jumper', x: x0, y: SY - 2.5, width: 62, height: 5, rx: 1.5 }));
				return;
			}
			const dir = s === 1 ? 1 : -1; // where the «+» is
			const plusX = cx + dir * 24;
			const minusX = cx - dir * 24;
			if (kind === 'cell') {
				g.append(el('rect', { class: 'cells-aa', x: cx - 22, y: SY - 10, width: 44, height: 20, rx: 3 }));
				g.append(el('rect', { class: 'cells-aa-band', x: dir > 0 ? cx + 16 : cx - 22, y: SY - 10, width: 6, height: 20, rx: 2 }));
				g.append(el('rect', { class: 'cells-nub', x: dir > 0 ? cx + 22 : cx - 26, y: SY - 4, width: 4, height: 8, rx: 1 }));
				g.append(el('rect', { class: 'cells-nub', x: dir > 0 ? cx - 26 : cx + 22, y: SY - 7, width: 4, height: 14, rx: 1 }));
				const p = el('text', { class: 'cells-sign t-red', x: cx + dir * 9, y: SY + 4.5, 'text-anchor': 'middle' }, '+');
				const m = el('text', { class: 'cells-sign t-blue', x: cx - dir * 12, y: SY + 4.5, 'text-anchor': 'middle' }, '−');
				g.append(p, m);
			} else {
				// a lemon; the copper plate («+») and the nail («−») are joined to the slot's contacts by short leads
				const a = 19;
				const b = 12;
				g.append(el('path', { class: 'cells-lead', d: `M${cx + dir * 8} ${SY - 12} Q${cx + dir * 22} ${SY - 18} ${plusX + dir * 4} ${SY - 4}` }));
				g.append(el('path', { class: 'cells-lead', d: `M${cx - dir * 8} ${SY - 12} Q${cx - dir * 22} ${SY - 18} ${minusX - dir * 4} ${SY - 4}` }));
				g.append(el('path', { class: 'cells-lemon', d: `M${cx - a - 3} ${SY + 2} Q${cx - a} ${SY - b} ${cx} ${SY - b} Q${cx + a} ${SY - b} ${cx + a + 3} ${SY + 2} Q${cx + a} ${SY + b + 2} ${cx} ${SY + b + 2} Q${cx - a} ${SY + b + 2} ${cx - a - 3} ${SY + 2} Z` }));
				g.append(el('rect', { class: 'cells-cu', x: cx + dir * 8 - 2.5, y: SY - 15, width: 5, height: 12 }));
				g.append(el('path', { class: 'cells-zn', d: `M${cx - dir * 8} ${SY - 3} V${SY - 15}` }));
				g.append(el('text', { class: 'cells-sign t-red', x: cx + dir * 9, y: SY + 10, 'text-anchor': 'middle' }, '+'));
				g.append(el('text', { class: 'cells-sign t-blue', x: cx - dir * 8, y: SY + 10, 'text-anchor': 'middle' }, '−'));
			}
		};
		const update = () => {
			const src = SRC[kind];
			let E = 0;
			let r = 0;
			for (const s of state) {
				if (s) {
					E += s === 1 ? src.e : -src.e;
					r += src.r;
				}
			}
			const I = closed ? E / (R + r) : 0;
			const U = closed ? I * R : E;
			const P = I * I * R;
			const k = Math.min(1, P / 3);
			q('[data-vread]').textContent = `${Math.abs(U) >= 1 || U === 0 ? fmt(U, 2) : fmt(U, 3)} В`;
			q('[data-aread]').textContent = Math.abs(I) >= 0.1 || I === 0 ? `${fmt(I, 3)} А` : `${fmt(I * 1000, 2)} мА`;
			q('[data-glow]').setAttribute('opacity', (0.9 * k).toFixed(3));
			q<SVGElement>('[data-lamp]').style.fill = k > 0.001 ? `color-mix(in oklab, hsl(48, 100%, 70%) ${Math.round(100 * Math.sqrt(k))}%, var(--g7-paper))` : '';
			q<SVGElement>('[data-fil]').style.stroke = k > 0.001 ? `color-mix(in oklab, hsl(35, 100%, 55%) ${Math.round(100 * Math.min(1, 3 * Math.sqrt(k)))}%, var(--g7-ink))` : '';
			const lever = q('[data-lever]');
			lever.setAttribute('x2', closed ? '192' : '188');
			lever.setAttribute('y2', closed ? '193' : '178');
			const btn = q<HTMLButtonElement>('[data-key]');
			btn.textContent = closed ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			btn.setAttribute('aria-pressed', String(closed));
		};
		const redraw = () => {
			slots.forEach((_, i) => drawSlot(i));
			update();
		};
		slots.forEach((g, i) => {
			const tap = () => {
				state[i] = (state[i] + 1) % 3;
				drawSlot(i);
				update();
			};
			g.addEventListener('click', tap);
			g.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					tap();
				}
			});
		});
		const toggleKey = () => {
			closed = !closed;
			update();
		};
		q('[data-key]').addEventListener('click', toggleKey);
		q('[data-keypic]').addEventListener('click', toggleKey);
		segment(q('[data-kind]'), (b) => {
			kind = b.dataset.v as 'cell' | 'lemon';
			redraw();
		});
		redraw();
	}
</script>
