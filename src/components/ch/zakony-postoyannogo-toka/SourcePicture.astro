---
/**
 * «Что делает источник тока»: a source opened up (left) and the outer circuit with a lamp (right).
 * Inside the source, between its positive (top) and negative (bottom) plates, the electric field of the separated
 * charges pushes a positive charge down (F_эл, gold), while the outside forces push it up (F_ст, green) and carry it
 * from «−» to «+» (red circles with «+», rising). In the outer circuit the free electrons (blue dots) go from «−» along
 * the bottom wire, up through the lamp and back along the top wire into «+»; the direction of the current (red arrows)
 * is the opposite. Under the bottom wire a blue arrow labelled «электроны» shows their real motion (to the right), and
 * the red arrows of the current with the label «ток» stand on the other side of the wires (pointing left at the bottom).
 * Labels are 12 px (about 11 px on a 390 px phone). Symbolic speeds; the arrows show directions, not the sizes of the forces (in a source without a
 * current they are equal).
 */
import G7Styles from '../g7/G7Styles.astro';

// the outer circuit: from the top plate (+) to the right, down through the lamp, back to the bottom plate (−)
const LOOP = 'M150 46 H310 V104 M310 136 V182 H150';
---

<G7Styles />
<figure class="g7 g7--pic psrc not-content" data-psrc>
	<svg class="g7__svg" viewBox="0 0 360 222" role="img" aria-label="Источник тока в разрезе и лампа во внешней цепи. Внутри источника сторонние силы переносят положительные заряды от минуса к плюсу против электрических сил. Во внешней цепи электроны идут от минуса к плюсу, ток — от плюса к минусу">
		<defs>
			<marker id="psrc-r" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
			<marker id="psrc-g" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--green" d="M0,0 L10,5 L0,10 z"></path></marker>
			<marker id="psrc-b" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--blue" d="M0,0 L10,5 L0,10 z"></path></marker>
			<marker id="psrc-y" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="2.6" markerHeight="2.6" orient="auto"><path class="head--gold" d="M0,0 L10,5 L0,10 z"></path></marker>
		</defs>
		<!-- the source -->
		<rect class="psrc-case" x="26" y="30" width="124" height="168" rx="8"></rect>
		<rect class="psrc-plus" x="34" y="40" width="108" height="9" rx="2"></rect>
		<rect class="psrc-minus" x="34" y="179" width="108" height="9" rx="2"></rect>
		<text class="t-strong psrc-sign" x="18" y="50" text-anchor="middle">+</text>
		<text class="t-strong psrc-sign" x="18" y="190" text-anchor="middle">−</text>
		<g data-ions></g>
		<line class="arrow arrow--green" x1="112" y1="132" x2="112" y2="100" marker-end="url(#psrc-g)"></line>
		<text class="t-i t-green" x="120" y="112">F<tspan baseline-shift="sub" font-size="10">ст</tspan></text>
		<line class="arrow arrow--gold" x1="112" y1="140" x2="112" y2="168" marker-end="url(#psrc-y)"></line>
		<text class="t-i t-gold" x="120" y="166">F<tspan baseline-shift="sub" font-size="10">эл</tspan></text>
		<text x="88" y="22" text-anchor="middle">источник тока</text>
		<!-- the outer circuit -->
		<path class="psrc-wire" d={LOOP}></path>
		<g data-elec></g>
		<circle class="psrc-glow" data-glow cx="310" cy="120" r="22"></circle>
		<circle class="psrc-bulb" cx="310" cy="120" r="14"></circle>
		<path class="psrc-coil" d="M300 110 L320 130 M300 130 L320 110"></path>
		<line class="arrow arrow--red" x1="200" y1="34" x2="250" y2="34" marker-end="url(#psrc-r)"></line>
		<line class="arrow arrow--red" x1="250" y1="198" x2="200" y2="198" marker-end="url(#psrc-r)"></line>
		<line class="arrow arrow--blue" x1="196" y1="168" x2="246" y2="168" marker-end="url(#psrc-b)"></line>
		<text x="226" y="22" text-anchor="middle">ток</text>
		<text x="226" y="216" text-anchor="middle">ток</text>
		<text class="t-blue" x="221" y="158" text-anchor="middle">электроны</text>
		<text x="282" y="124" text-anchor="end">лампа</text>
	</svg>
	<figcaption class="g7__caption">
		Внутри источника сторонние силы <i>F</i><sub>ст</sub> переносят положительные заряды от «−» к «+» против электрических сил <i>F</i><sub>эл</sub>. Во внешней цепи электроны (синие точки и синяя стрелка) идут от «−» к «+», а ток направлен от «+» к «−». Скорости условные.
	</figcaption>
</figure>

<style is:global>
	.psrc-case {
		fill: color-mix(in oklab, var(--g7-steel) 30%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1.5;
	}
	.psrc-plus {
		fill: var(--g7-red);
	}
	.psrc-minus {
		fill: var(--g7-blue);
	}
	.g7__svg .psrc-sign {
		font-size: 16px;
	}
	.psrc-ion {
		fill: color-mix(in oklab, var(--g7-red) 35%, var(--g7-paper));
		stroke: var(--g7-red);
		stroke-width: 1.2;
	}
	.g7__svg .psrc-ion-t {
		font-size: 11px;
		font-weight: 700;
		fill: var(--g7-red);
	}
	.psrc-wire {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2.5;
	}
	.psrc-bulb {
		fill: color-mix(in oklab, var(--g7-gold) 35%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.psrc-coil {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.psrc-glow {
		fill: var(--g7-gold);
		opacity: 0.3;
	}
	.psrc-e {
		fill: var(--g7-blue);
	}
</style>

<script>
	import { el, loop, NS } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-psrc]')) {
		const ions = root.querySelector<SVGGElement>('[data-ions]')!;
		const elec = root.querySelector<SVGGElement>('[data-elec]')!;
		// positive charges rising inside the source (x positions avoid the arrows)
		const list = [44, 62, 80, 96, 54, 72, 90].map((x, i) => {
			const g = el('g', {});
			g.append(el('circle', { class: 'psrc-ion', r: 6 }), el('text', { class: 'psrc-ion-t', 'text-anchor': 'middle', y: 4 }, '+'));
			ions.append(g);
			return { g, x, ph: i / 7 };
		});
		// electrons along the outer wire, from «−» (bottom left) to «+» (top left)
		const path = document.createElementNS(NS, 'path');
		path.setAttribute('d', 'M150 182 H310 V46 H150');
		path.setAttribute('style', 'fill: none; stroke: none');
		elec.append(path);
		const L = path.getTotalLength();
		const es = Array.from({ length: 20 }, (_, i) => {
			const c = el('circle', { class: 'psrc-e', r: 2.6 });
			elec.append(c);
			return { c, s: (i / 20) * L };
		});
		let t = 0;
		const draw = () => {
			for (const p of list) {
				const u = (p.ph + t / 6) % 1;
				p.g.setAttribute('transform', `translate(${p.x} ${(172 - u * 112).toFixed(1)})`);
				p.g.setAttribute('opacity', (u < 0.08 ? u / 0.08 : u > 0.92 ? (1 - u) / 0.08 : 1).toFixed(2));
			}
			for (const e of es) {
				const s = (e.s + 22 * t) % L;
				const pt = path.getPointAtLength(s);
				// hide the electrons inside the bulb
				const inBulb = Math.abs(pt.x - 310) < 0.5 && pt.y > 104 && pt.y < 136;
				e.c.setAttribute('cx', pt.x.toFixed(1));
				e.c.setAttribute('cy', pt.y.toFixed(1));
				e.c.setAttribute('opacity', inBulb ? '0' : '1');
			}
		};
		draw();
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
