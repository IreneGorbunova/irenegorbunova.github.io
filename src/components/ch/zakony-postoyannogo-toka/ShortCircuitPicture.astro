---
/**
 * «Короткое замыкание» (§ «Короткое замыкание», after I_кз = ℰ/r). Two panels with the same idea: the poles of a source
 * joined by a piece of metal whose resistance is far below r, so I_кз ≈ ℰ/r.
 *   AA cell: ℰ = 1,5 В, r ≈ 0,2 Ом (a fresh alkaline cell, 0,15–0,3 Ом) shorted by a steel paper clip: I_кз ≈ 7,5 А;
 *     the clip warms up (orange tint and shimmer: the color of heat released, as the loss I²r in the chapter).
 *   Car battery: ℰ = 12,6 В, r ≈ 0,01 Ом, a wrench lying across its terminals: I_кз ≈ 1260 А; sparks flash at the
 *     contacts (a light loop of flashes).
 * Not to scale; the clip and the wrench are drawn larger than the sources would allow.
 */
import G7Styles from '../g7/G7Styles.astro';

const sub = (s: string) => `<tspan dy="3" font-size="9.5">${s}</tspan>`;
const sparks = [
	{ x: 42, y: 44 },
	{ x: 142, y: 44 },
];
---

<G7Styles />
<figure class="g7 g7--pic scp not-content" data-scp>
	<div class="g7__grid is-two">
		<div class="scp__cell">
			<svg class="g7__svg" viewBox="0 0 200 150" role="img" aria-label="Батарейка АА, полюса которой соединены скрепкой. ЭДС 1,5 вольта, внутреннее сопротивление около 0,2 ома, ток короткого замыкания около 7,5 ампера; скрепка нагревается">
				<path class="scp-shim" data-shim d="M60 26 q4 -5 0 -10 q-4 -5 0 -10 M95 26 q4 -5 0 -10 q-4 -5 0 -10 M130 26 q4 -5 0 -10 q-4 -5 0 -10"></path>
				<rect class="scp-aa" x="32" y="48" width="118" height="38" rx="4"></rect>
				<rect class="scp-aa-band" x="112" y="48" width="38" height="38" rx="4"></rect>
				<rect class="scp-metal" x="150" y="60" width="8" height="14" rx="2"></rect>
				<rect class="scp-metal" x="29" y="56" width="4" height="22" rx="1"></rect>
				<text class="t-strong scp-on-band" x="131" y="72" text-anchor="middle">+</text>
				<text class="t-strong t-blue" x="44" y="73" text-anchor="middle">−</text>
				<path class="scp-clip" data-clip d="M30 67 C14 67 14 34 34 34 H150 C170 34 172 67 158 67"></path>
				<text class="t-small" x="100" y="112" text-anchor="middle"><tspan class="t-i">ℰ</tspan> = 1,5 В, <tspan class="t-i">r</tspan> ≈ 0,2 Ом</text>
				<text x="100" y="138" text-anchor="middle" set:html={`<tspan class="t-i">I</tspan>${sub('кз')}<tspan dy="-3"> = </tspan><tspan class="t-i">ℰ</tspan>/<tspan class="t-i">r</tspan> ≈ 7,5 А`}></text>
			</svg>
			<p>Батарейка и скрепка</p>
		</div>
		<div class="scp__cell">
			<svg class="g7__svg" viewBox="0 0 200 150" role="img" aria-label="Автомобильный аккумулятор, на полюсах которого лежит гаечный ключ. ЭДС 12,6 вольта, внутреннее сопротивление около 0,01 ома, ток короткого замыкания около 1260 ампер; на контактах вспыхивают искры">
				<rect class="scp-car" x="24" y="56" width="136" height="50" rx="4"></rect>
				<rect class="scp-car-lid" x="24" y="52" width="136" height="10" rx="3"></rect>
				{[0, 1, 2, 3, 4, 5].map((i) => <circle class="scp-cap" cx={64 + i * 11} cy="57" r="2.4" />)}
				<rect class="scp-metal" x="36" y="44" width="12" height="9" rx="1.5"></rect>
				<rect class="scp-metal" x="136" y="44" width="12" height="9" rx="1.5"></rect>
				<text class="t-strong t-red" x="142" y="80" text-anchor="middle">+</text>
				<text class="t-strong t-blue" x="42" y="81" text-anchor="middle">−</text>
				<g transform="rotate(-3 92 40)">
					<path class="scp-wrench" d="M30 36 h10 l4 -5 h8 l-5 5 v8 l5 5 h-8 l-4 -5 h-10 Z M52 37 H134 V43 H52 Z M134 34 l6 -4 h10 l3 4 v12 l-3 4 h-10 l-6 -4 Z"></path>
					<circle class="scp-hole" cx="145" cy="40" r="3.4"></circle>
				</g>
				<g data-sparks>
					{sparks.map((p) => (
						<g transform={`translate(${p.x} ${p.y})`} class="scp-spark">
							<path class="scp-ray" d="M0 0 L-9 -10 M0 0 L2 -14 M0 0 L11 -8 M0 0 L-12 -2 M0 0 L13 1" />
							<circle class="scp-flash" r="3.4" />
						</g>
					))}
				</g>
				<text class="t-small" x="100" y="122" text-anchor="middle"><tspan class="t-i">ℰ</tspan> = 12,6 В, <tspan class="t-i">r</tspan> ≈ 0,01 Ом</text>
				<text x="100" y="140" text-anchor="middle" set:html={`<tspan class="t-i">I</tspan>${sub('кз')}<tspan dy="-3"> = </tspan><tspan class="t-i">ℰ</tspan>/<tspan class="t-i">r</tspan> ≈ 1260 А`}></text>
			</svg>
			<p>Автомобильный аккумулятор и гаечный ключ</p>
		</div>
	</div>
	<figcaption class="g7__caption">Полюса замкнуты кусками металла почти без сопротивления, а токи короткого замыкания разные: чем меньше внутреннее сопротивление источника, тем больше ток. Не повторяйте!</figcaption>
</figure>

<style is:global>
	.g7 {
		--zpt-useful: hsl(172, 62%, 48%);
		--zpt-loss: hsl(24, 95%, 58%);
	}
	:root[data-theme='light'] .g7 {
		--zpt-useful: hsl(174, 75%, 28%);
		--zpt-loss: hsl(22, 88%, 46%);
	}
	.g7__svg .scp-on-band {
		fill: hsl(0, 85%, 40%);
	}
	.scp__cell p {
		margin: 0.35rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.scp-aa {
		fill: hsl(0, 0%, 22%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.scp-aa-band {
		fill: hsl(32, 90%, 52%);
	}
	.scp-metal {
		fill: hsl(210, 8%, 72%);
		stroke: hsl(210, 10%, 40%);
		stroke-width: 0.8;
	}
	.scp-clip {
		fill: none;
		stroke: color-mix(in oklab, var(--zpt-loss) 70%, hsl(210, 8%, 75%));
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.scp-shim {
		fill: none;
		stroke: var(--zpt-loss);
		stroke-width: 1;
		opacity: 0.5;
	}
	.scp-car {
		fill: hsl(210, 10%, 26%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.scp-car-lid {
		fill: hsl(210, 10%, 36%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.scp-cap {
		fill: hsl(45, 70%, 55%);
	}
	.scp-wrench {
		fill: hsl(210, 8%, 66%);
		stroke: hsl(210, 10%, 34%);
		stroke-width: 0.9;
		stroke-linejoin: round;
	}
	.scp-hole {
		fill: var(--g7-paper);
		stroke: hsl(210, 10%, 34%);
		stroke-width: 0.8;
	}
	.scp-ray {
		fill: none;
		stroke: hsl(48, 100%, 70%);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.scp-flash {
		fill: hsl(50, 100%, 92%);
	}
</style>

<script>
	import { loop, rng } from '../g7/kit';

	for (const root of document.querySelectorAll<HTMLElement>('[data-scp]')) {
		const sparks = [...root.querySelectorAll<SVGGElement>('.scp-spark')];
		const shim = root.querySelector<SVGPathElement>('[data-shim]')!;
		const rnd = rng(11);
		let t = 0;
		const next = sparks.map(() => 0);
		const until = sparks.map(() => 0);
		loop(root, (dt) => {
			t += dt;
			// each contact flashes for 0,08–0,18 с at random moments, about three times a second
			sparks.forEach((g, i) => {
				if (t >= next[i]) {
					until[i] = t + 0.08 + 0.1 * rnd();
					next[i] = t + 0.2 + 0.35 * rnd();
					g.setAttribute('transform', g.getAttribute('transform')!.replace(/ rotate\([^)]*\)/, '') + ` rotate(${Math.round(360 * rnd())})`);
				}
				g.style.opacity = t < until[i] ? '1' : '0';
			});
			shim.style.opacity = (0.3 + 0.25 * Math.sin(t * 3)).toFixed(2);
			shim.setAttribute('transform', `translate(0 ${(-3 * ((t * 0.8) % 1)).toFixed(2)})`);
			return true;
		});
	}
</script>
