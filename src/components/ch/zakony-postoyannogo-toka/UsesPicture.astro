---
/**
 * Small pictures for «Где это встречается» of «Законы постоянного тока» (schemes, not to scale; static):
 *   1. Батарейка села: an old AA cell (ℰ ≈ 1,5 В, but r grown to about 2 Ом) on a voltmeter alone shows 1,5 В; with a
 *      small lamp (3 Ом) joined, I = 1,5/(3 + 2) = 0,3 А and the voltmeter shows U = IR = 0,9 В, the lamp is dim.
 *   2. Солнечная панель: 60 silicon cells (6 × 10) joined one after another (the dashed zigzag), about 0,6 В each:
 *      about 36 В at the panel's box.
 *   3. Батарея электромобиля: a battery pack cut open: in each group the cells stand side by side (joined in parallel:
 *      a larger current), the groups are joined one after another (in series: about 400 В); a few groups drawn.
 *   4. «Прикуривание»: two cars, bonnets open; the red cable joins «+» to «+», the black one «−» to «−»: the two
 *      batteries are joined in parallel.
 * Colors: «+» red, «−» blue (as in the whole chapter).
 */
import G7Styles from '../g7/G7Styles.astro';

const panelCells: { x: number; y: number }[] = [];
for (let r = 0; r < 6; r++) for (let c = 0; c < 10; c++) panelCells.push({ x: 40 + c * 13, y: 30 + r * 13 });
// the series zigzag through the panel: row by row, alternating direction
let zig = 'M46.5 36.5';
for (let r = 0; r < 6; r++) {
	const y = 36.5 + r * 13;
	zig += ` H${r % 2 ? 46.5 : 163.5}`;
	if (r < 5) zig += ` V${y + 13}`;
}
const groups = [0, 1, 2, 3];
---

<G7Styles />
<figure class="g7 g7--pic zuses not-content" data-zuses>
	<div class="g7__grid is-two">
		<div class="zuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Старая батарейка: без нагрузки вольтметр показывает 1,5 вольта, а когда подключена лампа — 0,9 вольта, и лампа светит тускло">
				<path class="zu-div" d="M100 12 V126"></path>
				{[0, 1].map((k) => (
					<g transform={`translate(${k * 100} 0)`}>
						<rect class="zu-aa" x="14" y="52" width="18" height="52" rx="3" />
						<rect class="zu-aa-band" x="14" y="52" width="18" height="16" rx="3" />
						<rect class="zu-metal" x="19" y="47" width="8" height="5" rx="1" />
						<text class="zu-t zu-plus" x="23" y="80" text-anchor="middle">+</text>
						<rect class="zu-meter" x="50" y="28" width="40" height="46" rx="4" />
						<rect class="zu-disp" x="54" y="32" width="32" height="16" rx="2" />
						<text class="zu-t zu-read" x="70" y="44.5" text-anchor="middle">{k ? '0,9 В' : '1,5 В'}</text>
						<circle class="zu-knob" cx="70" cy="61" r="7" />
						<path class="zu-red" d="M62 74 Q60 88 40 86 Q30 84 27 50" />
						<path class="zu-black" d="M78 74 Q80 112 40 112 Q26 112 23 104" />
						{k === 1 && (
							<>
								<circle class="zu-glow" cx="34" cy="22" r="13" />
								<circle class="zu-bulb" cx="34" cy="22" r="7" />
								<path class="zu-fil" d="M31 24 Q34 18 37 24" />
								<path class="zu-lampwire" d="M30 29 Q12 36 20 47 M38 29 Q48 70 31 100" />
							</>
						)}
					</g>
				))}
				<text class="zu-t" x="50" y="126" text-anchor="middle">без лампы</text>
				<text class="zu-t" x="150" y="126" text-anchor="middle">с лампой</text>
			</svg>
			<p>Батарейка села</p>
		</div>
		<div class="zuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Солнечная панель из 60 элементов по 0,6 вольта, соединённых один за другим: вместе около 36 вольт">
				<g class="zu-sun">
					<circle cx="18" cy="16" r="7" />
					<path d="M18 4 V6 M18 26 V28 M6 16 H8 M28 16 H30 M9.5 7.5 L11 9 M25 23 L26.5 24.5 M26.5 7.5 L25 9 M11 23 L9.5 24.5" />
				</g>
				<rect class="zu-frame" x="37" y="27" width="136" height="84" rx="2" />
				{panelCells.map((c) => <rect class="zu-pv" x={c.x} y={c.y} width="12" height="12" rx="0.8" />)}
				<path class="zu-zig" d={zig} />
				<rect class="zu-box" x="176" y="58" width="16" height="22" rx="2" />
				<path class="zu-red" d="M184 80 V96 Q184 104 176 106" />
				<path class="zu-black" d="M188 80 V100 Q188 112 178 114" />
				<text class="zu-t zu-strong" x="105" y="126" text-anchor="middle">60 × 0,6 В ≈ 36 В</text>
			</svg>
			<p>Солнечная панель</p>
		</div>
		<div class="zuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Батарея электромобиля в разрезе: в каждой группе элементы соединены параллельно, а группы между собой — последовательно, всего около 400 вольт">
				<rect class="zu-pack" x="8" y="24" width="184" height="76" rx="5" />
				{groups.map((gI) => (
					<g transform={`translate(${16 + gI * 44} 0)`}>
						<rect class="zu-group" x="0" y="32" width="36" height="60" rx="3" />
						{[0, 1, 2, 3, 4].map((r) => [0, 1, 2].map((c) => <circle class="zu-cyl" cx={8 + c * 10} cy={40 + r * 11} r="4" />))}
						<rect class="zu-busbar zu-busbar--p" x="3" y="34" width="30" height="2" />
						<rect class="zu-busbar zu-busbar--m" x="3" y="88" width="30" height="2" />
					</g>
				))}
				{[0, 1, 2].map((gI) => <path class="zu-link" d={`M${50 + gI * 44} 35 Q${56 + gI * 44} 62 ${62 + gI * 44} 89`} />)}
				<path class="zu-brace" d="M16 106 V110 H52 V106"></path>
				<text class="zu-t" x="10" y="122">параллельно</text>
				<path class="zu-arrow" d="M70 112 H188 M182 108 L188 112 L182 116"></path>
				<text class="zu-t" x="188" y="126" text-anchor="end">последовательно</text>
				<text class="zu-t zu-strong" x="100" y="16" text-anchor="middle">≈ 400 В</text>
			</svg>
			<p>Батарея электромобиля</p>
		</div>
		<div class="zuses__cell">
			<svg class="g7__svg" viewBox="0 0 200 134" role="img" aria-label="Две машины с открытыми капотами стоят друг напротив друга. Красный провод соединяет плюс одного аккумулятора с плюсом другого, чёрный — минус с минусом">
				<path class="zu-ground" d="M0 116 H200"></path>
				{[0, 1].map((k) => (
					<g transform={k ? 'translate(200 0) scale(-1 1)' : ''}>
						<path class="zu-car" d="M0 70 H44 L66 74 Q72 76 72 84 V104 Q72 108 68 108 H0 Z" />
						<path class="zu-hood" d="M24 72 L38 32 L45 34 L32 73 Z" />
						<rect class="zu-bay" x="30" y="72" width="38" height="8" rx="1" />
						<circle class="zu-tyre" cx="40" cy="108" r="9" />
						<rect class="zu-batt" x="40" y="60" width="22" height="13" rx="1.5" />
						<rect class="zu-post" x="43" y="56" width="4" height="4" />
						<rect class="zu-post" x="55" y="56" width="4" height="4" />
						<path class="zu-head" d="M68 82 h4 v6 h-4 Z" />
					</g>
				))}
				<path class="zu-cable-red" d="M57 56 Q100 28 143 56"></path>
				<path class="zu-cable-black" d="M45 56 Q100 12 155 56"></path>
				<text class="zu-t zu-plus zu-small" x="57" y="70.5" text-anchor="middle">+</text>
				<text class="zu-t zu-plus zu-small" x="143" y="70.5" text-anchor="middle">+</text>
				<text class="zu-t zu-minus zu-small" x="45" y="70.5" text-anchor="middle">−</text>
				<text class="zu-t zu-minus zu-small" x="155" y="70.5" text-anchor="middle">−</text>
			</svg>
			<p>«Прикуривание»</p>
		</div>
	</div>
</figure>

<style is:global>
	.zuses__cell p {
		margin: 0.35rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.g7__svg .zu-t {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	.g7__svg .zu-strong {
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.g7__svg .zu-plus {
		fill: var(--g7-red);
		font-weight: 700;
		font-size: 13px;
	}
	.g7__svg .zu-minus {
		fill: var(--g7-blue);
		font-weight: 700;
		font-size: 13px;
	}
	.g7__svg .zu-read {
		font-size: 10.5px;
		font-weight: 700;
		fill: hsl(150, 70%, 20%);
	}
	.g7__svg .zu-small {
		font-size: 11px;
	}
	.zu-div {
		stroke: var(--g7-faint);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.zu-aa {
		fill: hsl(0, 0%, 22%);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zu-aa-band {
		fill: hsl(32, 90%, 52%);
	}
	.zu-metal,
	.zu-post {
		fill: hsl(210, 8%, 72%);
		stroke: hsl(210, 10%, 40%);
		stroke-width: 0.6;
	}
	.zu-meter {
		fill: hsl(48, 85%, 55%);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zu-disp {
		fill: hsl(110, 30%, 78%);
		stroke: hsl(110, 20%, 40%);
		stroke-width: 0.6;
	}
	.zu-knob {
		fill: hsl(0, 0%, 25%);
		stroke: var(--g7-ink);
		stroke-width: 0.6;
	}
	.zu-red,
	.zu-cable-red {
		fill: none;
		stroke: hsl(0, 80%, 55%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.zu-black,
	.zu-cable-black {
		fill: none;
		stroke: hsl(220, 10%, 12%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	:root:not([data-theme='light']) .zu-black,
	:root:not([data-theme='light']) .zu-cable-black {
		stroke: hsl(220, 10%, 4%);
		filter: drop-shadow(0 0 0.6px hsl(0, 0%, 80%));
	}
	.zu-cable-red,
	.zu-cable-black {
		stroke-width: 2.4;
	}
	.zu-glow {
		fill: hsl(45, 100%, 65%);
		opacity: 0.22;
	}
	.zu-bulb {
		fill: color-mix(in oklab, hsl(45, 100%, 70%) 35%, var(--g7-paper));
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zu-fil {
		fill: none;
		stroke: hsl(25, 90%, 50%);
		stroke-width: 0.9;
	}
	.zu-lampwire {
		fill: none;
		stroke: hsl(210, 8%, 62%);
		stroke-width: 1.1;
	}
	.zu-sun {
		fill: hsl(45, 95%, 60%);
		stroke: hsl(45, 95%, 55%);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.zu-frame {
		fill: hsl(210, 10%, 70%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zu-pv {
		fill: hsl(222, 60%, 34%);
	}
	.zu-zig {
		fill: none;
		stroke: hsl(48, 90%, 66%);
		stroke-width: 0.9;
		stroke-dasharray: 2.5 2;
	}
	.zu-box {
		fill: hsl(0, 0%, 24%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zu-pack {
		fill: hsl(210, 10%, 30%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zu-group {
		fill: hsl(210, 12%, 40%);
		stroke: hsl(210, 10%, 20%);
		stroke-width: 0.8;
	}
	.zu-cyl {
		fill: hsl(150, 40%, 52%);
		stroke: hsl(150, 30%, 26%);
		stroke-width: 0.7;
	}
	.zu-busbar--p {
		fill: var(--g7-red);
	}
	.zu-busbar--m {
		fill: var(--g7-blue);
	}
	.zu-link {
		fill: none;
		stroke: hsl(42, 40%, 70%);
		stroke-width: 1.6;
	}
	.zu-brace,
	.zu-arrow {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zu-ground {
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.zu-car {
		fill: hsl(205, 55%, 48%);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.zu-hood {
		fill: hsl(205, 55%, 40%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zu-bay {
		fill: hsl(220, 10%, 18%);
	}
	.zu-tyre {
		fill: hsl(220, 10%, 14%);
		stroke: hsl(210, 8%, 60%);
		stroke-width: 1.4;
	}
	.zu-batt {
		fill: hsl(210, 10%, 26%);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.zu-head {
		fill: hsl(50, 90%, 80%);
	}
</style>
