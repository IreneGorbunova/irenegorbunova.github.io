---
/**
 * «Полная цепь»: a source with EMF ℰ (1,5…6 В) and internal resistance r (0,5…5 Ом), drawn as a dashed box with a
 * cell and a small resistor inside, feeds a rheostat R (0…20 Ом) through an ammeter and a key; a voltmeter is joined
 * to the poles of the source. Ideal meters (the ammeter 0 Ом, the voltmeter takes no current).
 * With the key closed: I = ℰ/(R + r), U = IR = ℰ − Ir; with the key open: I = 0, U = ℰ.
 * The free electrons (blue dots) go round the outer circuit against the current, at a speed proportional to the current
 * (10 px/с per ампер: millions of times faster than real). The glow of the rheostat and of the inner resistor grows
 * with the power released in each (I²R, I²r; full glow at 20 Вт).
 * Below, the graph U(I) on fixed axes: I 0…12 А (24 px per А), U 0…6 В (18 px per В). The line through (0; ℰ) and
 * (ℰ/r; 0) is the voltage at the poles for every R; the point is the present state of the circuit.
 * «Записать точку» leaves a dot (I; U) of the present state on the graph (up to 8; a state already recorded is not
 * doubled); the dots stay while R or the key change and are cleared by «Стереть точки» or by a change of ℰ or r.
 * Check: ℰ = 4,5 В, r = 1 Ом, R = 8 / 4 / 2 / 1 Ом → (0,5 А; 4 В), (0,9 А; 3,6 В), (1,5 А; 3 В), (2,25 А; 2,25 В); the
 * line through them meets the U axis at 4,5 В = ℰ and the I axis at 4,5 А = ℰ/r.
 */
import G7Styles from '../g7/G7Styles.astro';

const OX = 52;
const OY = 362;
const PI = 24; // px per А
const PU = 18; // px per В
const ticksI = [0, 2, 4, 6, 8, 10, 12];
const ticksU = [0, 1, 2, 3, 4, 5, 6];
---

<G7Styles />
<figure class="g7 fcl not-content" data-fcl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 392" role="img" aria-label="Цепь из источника тока с внутренним сопротивлением, реостата, амперметра и ключа; к полюсам источника подключён вольтметр. Ниже — график напряжения на полюсах источника в зависимости от силы тока">
			<defs>
				<radialGradient id="fcl-heat">
					<stop offset="0" class="fcl-heat-a"></stop>
					<stop offset="1" class="fcl-heat-b"></stop>
				</radialGradient>
			</defs>
			<!-- glows of the resistors -->
			<ellipse data-glow-r cx="195" cy="170" rx="26" ry="16" fill="url(#fcl-heat)" opacity="0"></ellipse>
			<ellipse data-glow-R cx="215" cy="60" rx="44" ry="18" fill="url(#fcl-heat)" opacity="0"></ellipse>
			<!-- wires -->
			<path class="fcl-wire" d="M120 170 H40 V60 H87 M113 60 H185 M245 60 H320 V96 M320 134 V170 H240"></path>
			<path class="fcl-wire" d="M100 170 V214 H167 M193 214 H260 V170"></path>
			<circle class="fcl-node" cx="100" cy="170" r="2.6"></circle>
			<circle class="fcl-node" cx="260" cy="170" r="2.6"></circle>
			<g data-elec></g>
			<!-- the source -->
			<rect class="fcl-box" x="120" y="146" width="120" height="48" rx="6"></rect>
			<path class="fcl-wire" d="M120 170 H146 M154 170 H180 M210 170 H240"></path>
			<line class="fcl-plate" x1="146" y1="156" x2="146" y2="184"></line>
			<line class="fcl-plate fcl-plate--short" x1="154" y1="162" x2="154" y2="178"></line>
			<rect class="fcl-res" x="180" y="164" width="30" height="12"></rect>
			<text class="t-i" x="150" y="143" text-anchor="middle">ℰ</text>
			<text class="t-i" x="195" y="160" text-anchor="middle">r</text>
			<circle class="fcl-node" cx="120" cy="170" r="3"></circle>
			<circle class="fcl-node" cx="240" cy="170" r="3"></circle>
			<text class="t-strong" x="126" y="190">+</text>
			<text class="t-strong" x="229" y="190">−</text>
			<!-- the ammeter -->
			<circle class="fcl-meter" cx="100" cy="60" r="13"></circle>
			<text class="t-strong" x="100" y="64.5" text-anchor="middle">A</text>
			<text class="t-strong t-num t-halo" x="100" y="40" text-anchor="middle" data-ia></text>
			<!-- the rheostat -->
			<rect class="fcl-res" x="185" y="53" width="60" height="14"></rect>
			<rect class="fcl-res-on" data-active x="185" y="53" width="0" height="14"></rect>
			<line class="fcl-var" x1="180" y1="80" x2="252" y2="38"></line>
			<path class="fcl-var-head" d="M252 38 l-9 1 l5 7 z"></path>
			<text class="t-i" x="215" y="30" text-anchor="middle">R</text>
			<text class="t-small t-num" x="215" y="94" text-anchor="middle" data-rv></text>
			<!-- the key -->
			<circle class="fcl-node" cx="320" cy="96" r="2.6"></circle>
			<circle class="fcl-node" cx="320" cy="134" r="2.6"></circle>
			<line class="fcl-blade" data-blade x1="320" y1="134" x2="320" y2="96"></line>
			<text class="t-small" x="312" y="119" text-anchor="end">ключ</text>
			<!-- the voltmeter -->
			<circle class="fcl-meter" cx="180" cy="214" r="13"></circle>
			<text class="t-strong" x="180" y="218.5" text-anchor="middle">V</text>
			<text class="t-strong t-num t-halo" x="226" y="232" text-anchor="middle" data-uv></text>

			<!-- the graph -->
			<path class="ln" d={`M${OX} ${OY} H${OX + 12 * PI + 10} M${OX} ${OY} V${OY - 6 * PU - 12}`}></path>
			{ticksI.map((i) => (
				<>
					<line class="fcl-grid" x1={OX + i * PI} x2={OX + i * PI} y1={OY} y2={OY - 6 * PU} />
					<text class="t-small t-num" x={OX + i * PI} y={OY + 16} text-anchor="middle">{i}</text>
				</>
			))}
			{ticksU.map((u) => (
				<>
					<line class="fcl-grid" x1={OX} x2={OX + 12 * PI} y1={OY - u * PU} y2={OY - u * PU} />
					<text class="t-small t-num" x={OX - 6} y={OY - u * PU + 4} text-anchor="end">{u}</text>
				</>
			))}
			<text class="t-small" x={OX + 12 * PI + 4} y={OY + 29} text-anchor="end"><tspan class="t-i">I</tspan>, А</text>
			<text class="t-small" x={OX - 30} y={OY - 6 * PU - 16}><tspan class="t-i">U</tspan>, В</text>
			<line class="fcl-line" data-line></line>
			<path class="fcl-guide" data-guide></path>
			<g data-dots></g>
			<circle class="fcl-point" data-point r="5"></circle>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>ЭДС источника <i>ℰ</i></span>
				<output data-out-emf></output>
				<input type="range" min="1.5" max="6" step="0.5" value="4.5" data-emf aria-label="ЭДС источника, вольты" />
			</label>
			<label class="g7__slider">
				<span>Внутреннее сопротивление <i>r</i></span>
				<output data-out-rin></output>
				<input type="range" min="0.5" max="5" step="0.5" value="1" data-rin aria-label="Внутреннее сопротивление источника, омы" />
			</label>
			<label class="g7__slider">
				<span>Сопротивление реостата <i>R</i></span>
				<output data-out-rext></output>
				<input type="range" min="0" max="20" step="0.5" value="8" data-rext aria-label="Сопротивление реостата, омы" />
			</label>
			<button type="button" class="g7__btn" data-key>Разомкнуть ключ</button>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-rec>Записать точку</button>
				<button type="button" class="g7__btn" data-clear>Стереть точки</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Амперметр, <i>I</i></span><b data-i></b></li>
				<li><span>Вольтметр, <i>U</i></span><b data-uread></b></li>
				<li><span>Внутри источника, <i>Ir</i></span><b data-ir></b></li>
				<li class="is-key"><span><i>U</i> + <i>Ir</i></span><b data-sum></b></li>
			</ul>
			<p class="g7__msg" data-msg hidden></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Приборы идеальные: амперметр не имеет сопротивления, через вольтметр ток не идёт. Точки — свободные электроны; их скорость пропорциональна силе тока, но в миллионы раз больше настоящей. Свечение резисторов растёт с выделяемой в них мощностью. На графике прямая — напряжение на полюсах при любом <i>R</i>, точка — то, что показывают приборы сейчас. «Записать точку» оставляет на графике показания приборов.
	</figcaption>
</figure>

<style is:global>
	.g7 {
		--zpt-useful: hsl(172, 62%, 48%);
		--zpt-loss: hsl(24, 95%, 58%);
	}
	:root[data-theme='light'] .g7 {
		--zpt-useful: hsl(174, 75%, 28%);
		--zpt-loss: hsl(22, 88%, 46%);
	}
	.fcl-wire {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2.2;
	}
	.fcl-node {
		fill: var(--g7-ink);
	}
	.fcl-box {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
	}
	.fcl-plate {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.fcl-plate--short {
		stroke-width: 5;
	}
	.fcl-res {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.fcl-res-on {
		fill: color-mix(in oklab, var(--g7-ink) 30%, transparent);
	}
	.fcl-var {
		stroke: var(--g7-ink);
		stroke-width: 1.4;
	}
	.fcl-var-head {
		fill: var(--g7-ink);
	}
	.fcl-meter {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.fcl-blade {
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.fcl-heat-a {
		stop-color: var(--zpt-loss);
		stop-opacity: 0.85;
	}
	.fcl-heat-b {
		stop-color: var(--zpt-loss);
		stop-opacity: 0;
	}
	.fcl-e {
		fill: var(--g7-blue);
	}
	.fcl-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.fcl-line {
		stroke: var(--g7-green);
		stroke-width: 2.4;
	}
	.fcl-guide {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.fcl-dot {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.8;
	}
	.fcl-point {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	@media (max-width: 40rem) {
		[data-fcl] .g7__svg .t-small {
			font-size: 12.5px;
		}
	}
</style>

<script>
	import { el, fmt, loop, NS } from '../g7/kit';

	const OX = 52;
	const OY = 362;
	const PI = 24;
	const PU = 18;
	for (const root of document.querySelectorAll<HTMLElement>('[data-fcl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const eIn = q<HTMLInputElement>('[data-emf]');
		const rIn = q<HTMLInputElement>('[data-rin]');
		const RIn = q<HTMLInputElement>('[data-rext]');
		const keyBtn = q<HTMLButtonElement>('[data-key]');
		let closed = true;
		let I = 0;
		// the electrons go from «−» round the outer circuit to «+»
		const path = document.createElementNS(NS, 'path');
		path.setAttribute('d', 'M240 170 H320 V60 H40 V170 H120');
		path.setAttribute('style', 'fill: none; stroke: none');
		const eg = q<SVGGElement>('[data-elec]');
		eg.append(path);
		const L = path.getTotalLength();
		const es = Array.from({ length: Math.floor(L / 18) }, (_, i) => {
			const c = el('circle', { class: 'fcl-e', r: 2.4 });
			eg.append(c);
			return { c, s: i * 18 };
		});
		let shift = 0;
		const placeElectrons = () => {
			for (const e of es) {
				const s = (e.s + shift) % L;
				const p = path.getPointAtLength(s);
				// hide the dots inside the meters and the rheostat
				const hidden = (Math.abs(p.y - 60) < 0.5 && ((p.x > 87 && p.x < 113) || (p.x > 185 && p.x < 245))) || (Math.abs(p.x - 320) < 0.5 && p.y > 96 && p.y < 134);
				e.c.setAttribute('cx', p.x.toFixed(1));
				e.c.setAttribute('cy', p.y.toFixed(1));
				e.c.setAttribute('opacity', hidden ? '0' : '1');
			}
		};
		const update = () => {
			const E = Number(eIn.value);
			const r = Number(rIn.value);
			const R = Number(RIn.value);
			I = closed ? E / (R + r) : 0;
			const U = closed ? I * R : E;
			q('[data-out-emf]').textContent = `${fmt(E, 1)} В`;
			q('[data-out-rin]').textContent = `${fmt(r, 1)} Ом`;
			q('[data-out-rext]').textContent = `${fmt(R, 1)} Ом`;
			q('[data-rv]').textContent = `${fmt(R, 1)} Ом`;
			q('[data-active]').setAttribute('width', ((60 * R) / 20).toFixed(1));
			q('[data-i]').textContent = `${fmt(I, 2)} А`;
			q('[data-uread]').textContent = `${fmt(U, 2)} В`;
			q('[data-ir]').textContent = `${fmt(I * r, 2)} В`;
			q('[data-sum]').textContent = `${fmt(U, 2)} + ${fmt(I * r, 2)} = ${fmt(U + I * r, 2)} В`;
			q('[data-ia]').textContent = `${fmt(I, 2)} А`;
			q('[data-uv]').textContent = `${fmt(U, 2)} В`;
			q('[data-blade]').setAttribute('x2', closed ? '320' : '340');
			q('[data-blade]').setAttribute('y2', closed ? '96' : '102');
			keyBtn.textContent = closed ? 'Разомкнуть ключ' : 'Замкнуть ключ';
			keyBtn.setAttribute('aria-pressed', String(!closed));
			q('[data-glow-R]').setAttribute('opacity', Math.min(0.85, (I * I * R) / 20).toFixed(2));
			q('[data-glow-r]').setAttribute('opacity', Math.min(0.85, (I * I * r) / 20).toFixed(2));
			// the graph
			const line = q('[data-line]');
			line.setAttribute('x1', String(OX));
			line.setAttribute('y1', (OY - E * PU).toFixed(1));
			line.setAttribute('x2', (OX + (E / r) * PI).toFixed(1));
			line.setAttribute('y2', String(OY));
			const px = OX + I * PI;
			const py = OY - U * PU;
			q('[data-point]').setAttribute('cx', px.toFixed(1));
			q('[data-point]').setAttribute('cy', py.toFixed(1));
			q('[data-guide]').setAttribute('d', `M${px.toFixed(1)} ${OY} V${py.toFixed(1)} H${OX}`);
			const msg = q<HTMLElement>('[data-msg]');
			msg.hidden = !(closed && R === 0);
			msg.textContent = 'R = 0: напряжение на полюсах равно нулю, а сила тока наибольшая — её ограничивает только внутреннее сопротивление источника.';
			placeElectrons();
		};
		loop(root, (dt) => {
			if (I <= 0) return true;
			shift = (shift + 10 * I * dt) % L;
			placeElectrons();
			return true;
		});
		// recorded points (I; U) for the present ℰ and r
		const dotsG = q<SVGGElement>('[data-dots]');
		let dots: { key: string; I: number; U: number }[] = [];
		const drawDots = () => {
			dotsG.replaceChildren(...dots.map((d) => el('circle', { class: 'fcl-dot', r: 3.6, cx: (OX + d.I * PI).toFixed(1), cy: (OY - d.U * PU).toFixed(1) })));
			q<HTMLButtonElement>('[data-clear]').disabled = !dots.length;
			q<HTMLButtonElement>('[data-rec]').disabled = dots.length >= 8;
		};
		q('[data-rec]').addEventListener('click', () => {
			const E = Number(eIn.value);
			const R = Number(RIn.value);
			const key = closed ? String(R) : 'open';
			if (dots.length >= 8 || dots.some((d) => d.key === key)) return;
			const Ii = closed ? E / (R + Number(rIn.value)) : 0;
			dots.push({ key, I: Ii, U: closed ? Ii * R : E });
			drawDots();
		});
		const clear = () => {
			dots = [];
			drawDots();
		};
		q('[data-clear]').addEventListener('click', clear);
		for (const i of [eIn, rIn]) i.addEventListener('input', clear);
		for (const i of [eIn, rIn, RIn]) i.addEventListener('input', update);
		drawDots();
		keyBtn.addEventListener('click', () => {
			closed = !closed;
			update();
		});
		update();
	}
</script>
