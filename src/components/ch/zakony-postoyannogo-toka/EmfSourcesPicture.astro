---
/**
 * «ЭДС разных источников тока» (§ «Электродвижущая сила», after the volt; replaces the old table). Seven small cards:
 * a drawing, the name, the EMF and the nature of the side forces (green, as the side forces everywhere in the chapter).
 * Values: a lemon with a zinc nail and a copper plate about 0,9 В (Zn–Cu in an acid electrolyte; 0,8–1 В measured);
 * a silicon solar cell about 0,6 В (open circuit, in sunlight); an AA cell 1,5 В; a phone's lithium-ion battery 3,7 В
 * (nominal); a «Крона» 9 В (six 1,5-В cells inside); a car battery 12,6 В (six lead cells of 2,1 В); a bicycle dynamo
 * about 6 В (its rated voltage; the EMF grows with the speed). Static schemes, not to scale.
 */
import G7Styles from '../g7/G7Styles.astro';

const cards = [
	{ k: 'lemon', name: 'Лимон с цинковым гвоздём и медной пластинкой', emf: 'около 0,9 В', why: 'химические реакции' },
	{ k: 'solar', name: 'Солнечный элемент (кремний)', emf: 'около 0,6 В', why: 'свет' },
	{ k: 'aa', name: 'Батарейка АА', emf: '1,5 В', why: 'химические реакции' },
	{ k: 'phone', name: 'Аккумулятор телефона', emf: '3,7 В', why: 'химические реакции' },
	{ k: 'krona', name: 'Батарейка «Крона» (шесть элементов внутри)', emf: '9 В', why: 'химические реакции' },
	{ k: 'car', name: 'Автомобильный аккумулятор (шесть банок по 2,1 В)', emf: '12,6 В', why: 'химические реакции' },
	{ k: 'dynamo', name: 'Велосипедный генератор (динамо на колесе)', emf: 'около 6 В', why: 'магнитное поле' },
];
---

<G7Styles />
<figure class="g7 g7--pic emfs not-content" data-emfs>
	<div class="emfs__grid">
		{cards.map((c) => (
			<div class="emfs__card">
				<svg class="emfs__svg" viewBox="0 0 96 60" role="img" aria-label={c.name}>
					{c.k === 'lemon' && (
						<>
							<path class="emfs-lemon" d="M14 40 Q16 24 48 23 Q80 24 82 40 Q80 56 48 57 Q16 56 14 40 Z" />
							<path class="emfs-lemon" d="M82 40 l6 -1.5 l-1 3 Z" />
							<ellipse class="emfs-shine" cx="38" cy="31" rx="10" ry="3" />
							<path class="emfs-zinc" d="M36 34 V6" />
							<path class="emfs-zinc emfs-head" d="M31 6 H41" />
							<rect class="emfs-cu" x="55" y="8" width="8" height="28" />
						</>
					)}
					{c.k === 'solar' && (
						<>
							<g class="emfs-sun">
								<circle cx="14" cy="13" r="7" />
								<path d="M14 1 V3 M14 23 V25 M2 13 H4 M24 13 H26 M5.5 4.5 L7 6 M21 20 L22.5 21.5 M22.5 4.5 L21 6 M7 20 L5.5 21.5" />
							</g>
							<path class="emfs-ray" d="M24 20 L38 30 M20 24 L32 36" />
							<rect class="emfs-cell" x="34" y="14" width="44" height="44" rx="2" />
							<path class="emfs-finger" d="M34 25 H78 M34 36 H78 M34 47 H78 M49 14 V58 M63 14 V58" />
						</>
					)}
					{c.k === 'aa' && (
						<>
							<rect class="emfs-aa" x="12" y="20" width="64" height="24" rx="3" />
							<rect class="emfs-aa-band" x="54" y="20" width="22" height="24" rx="3" />
							<rect class="emfs-metal" x="76" y="27" width="5" height="10" rx="1.5" />
						</>
					)}
					{c.k === 'phone' && (
						<>
							<rect class="emfs-li" x="14" y="16" width="68" height="34" rx="3" />
							<rect class="emfs-li-label" x="14" y="26" width="68" height="12" />
							<rect class="emfs-flex" x="34" y="8" width="16" height="9" rx="1" />
							<rect class="emfs-metal" x="37" y="10" width="3" height="5" rx="0.6" />
							<rect class="emfs-metal" x="44" y="10" width="3" height="5" rx="0.6" />
						</>
					)}
					{c.k === 'krona' && (
						<>
							<rect class="emfs-krona" x="30" y="16" width="36" height="42" rx="3" />
							<rect class="emfs-krona-band" x="30" y="34" width="36" height="12" />
							<circle class="emfs-metal" cx="40" cy="12" r="4.5" />
							<path class="emfs-metal" d="M51 8 h10 l2 4 l-2 4 h-10 l-2 -4 Z" />
						</>
					)}
					{c.k === 'car' && (
						<>
							<rect class="emfs-car" x="10" y="16" width="76" height="40" rx="3" />
							<rect class="emfs-car-lid" x="10" y="14" width="76" height="8" rx="2" />
							{[0, 1, 2, 3, 4, 5].map((i) => <circle class="emfs-cap" cx={21 + i * 10.8} cy="18" r="2.2" />)}
							<rect class="emfs-post" x="16" y="6" width="7" height="8" rx="1" />
							<rect class="emfs-post" x="73" y="6" width="7" height="8" rx="1" />
						</>
					)}
					{c.k === 'dynamo' && (
						<>
							<path class="emfs-tyre" d="M2 60 A58 58 0 0 1 60 2" />
							<path class="emfs-spoke" d="M2 60 L48 14 M2 60 L30 8" />
							<g transform="rotate(-40 66 30)">
								<rect class="emfs-dyn" x="56" y="22" width="34" height="16" rx="6" />
								<rect class="emfs-roller" x="50" y="25" width="7" height="10" rx="1.5" />
							</g>
						</>
					)}
				</svg>
				<p class="emfs__name">{c.name}</p>
				<p class="emfs__emf"><i>ℰ</i> {c.emf.startsWith('около') ? c.emf.replace('около ', '≈ ') : `= ${c.emf}`}</p>
				<p class="emfs__why">{c.why}</p>
			</div>
		))}
	</div>
	<figcaption class="g7__caption">ЭДС разных источников тока и природа их сторонних сил.</figcaption>
</figure>

<style is:global>
	.emfs__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@container (max-width: 34rem) {
		.emfs__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.emfs__card {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.45rem 0.5rem 0.55rem;
		border-radius: 0.6rem;
		background: var(--g7-paper);
	}
	.emfs__svg {
		display: block;
		width: 100%;
		height: auto;
		max-width: 8rem;
		margin: 0 auto 0.2rem;
	}
	.emfs__card p {
		margin: 0;
		line-height: 1.3;
	}
	.emfs__name {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.emfs__emf {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.emfs__why {
		font-size: var(--sl-text-xs);
		color: var(--g7-green);
		font-weight: 600;
	}
	.emfs-lemon {
		fill: hsl(52, 90%, 58%);
		stroke: hsl(40, 70%, 30%);
		stroke-width: 1;
	}
	.emfs-shine {
		fill: hsl(55, 100%, 88%);
		opacity: 0.6;
	}
	.emfs-zinc {
		stroke: hsl(210, 8%, 66%);
		stroke-width: 3;
	}
	.emfs-head {
		stroke-linecap: round;
	}
	.emfs-cu {
		fill: hsl(22, 70%, 54%);
		stroke: hsl(20, 60%, 28%);
		stroke-width: 0.8;
	}
	.emfs-sun {
		fill: hsl(45, 95%, 60%);
		stroke: hsl(45, 95%, 55%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.emfs-ray {
		stroke: hsl(45, 95%, 60%);
		stroke-width: 1.2;
		stroke-dasharray: 3 2;
	}
	.emfs-cell {
		fill: hsl(222, 60%, 32%);
		stroke: hsl(222, 40%, 18%);
		stroke-width: 1;
	}
	.emfs-finger {
		stroke: hsl(210, 20%, 80%);
		stroke-width: 0.9;
	}
	.emfs-aa {
		fill: hsl(0, 0%, 22%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.emfs-aa-band {
		fill: hsl(32, 90%, 52%);
	}
	.emfs-metal,
	.emfs-post {
		fill: hsl(210, 8%, 72%);
		stroke: hsl(210, 10%, 40%);
		stroke-width: 0.8;
	}
	.emfs-li {
		fill: hsl(210, 10%, 30%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.emfs-li-label {
		fill: hsl(205, 50%, 55%);
	}
	.emfs-flex {
		fill: hsl(32, 80%, 45%);
	}
	.emfs-krona {
		fill: hsl(0, 0%, 20%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.emfs-krona-band {
		fill: hsl(48, 90%, 55%);
	}
	.emfs-car {
		fill: hsl(210, 10%, 24%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.emfs-car-lid {
		fill: hsl(210, 10%, 34%);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.emfs-cap {
		fill: hsl(45, 70%, 55%);
	}
	.emfs-tyre {
		fill: none;
		stroke: hsl(220, 10%, 22%);
		stroke-width: 7;
	}
	.emfs-spoke {
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.emfs-dyn {
		fill: hsl(210, 8%, 70%);
		stroke: hsl(210, 10%, 36%);
		stroke-width: 1;
	}
	.emfs-roller {
		fill: hsl(210, 10%, 40%);
		stroke: hsl(210, 10%, 26%);
		stroke-width: 0.8;
	}
</style>
