---
/**
 * «Заряд — площадь под графиком силы тока» (§ «Электрический ток. Сила тока», after I = Δq/Δt).
 * The graph I(t) on equal-looking grid cells (1 с = 30 px across, 0,2 А = 30 px up): t 0…8 с, I 0…1,2 А. Two cases:
 * «Постоянный ток» I = 0,5 А (a horizontal line) and «Ток растёт» I = t/8 А (from 0 to 1 А). A time marker runs from
 * 0 to 8 с in 8 с of real time, holds 1,5 с and starts again; the area under the graph up to the marker is shaded, and
 * the readouts give Δq (the area) and Δq/Δt. Constant: Δq = 0,5t (2 Кл at 4 с, 4 Кл at 8 с); rising: Δq = t²/16
 * (1 Кл at 4 с, 4 Кл at 8 с), and Δq/Δt is then the mean current (0,25 А at 4 с, 0,5 А at 8 с). The strip above:
 * a piece of wire with its cross-section (gold); free electrons (blue) pass the section against the current (red
 * arrow) at a rate proportional to I. Colors: the current red, the charge Δq violet, the section gray (symbolic: 40 px/с per ампер; real drift speeds are about 0,1 мм/с).
 */
import G7Styles from '../g7/G7Styles.astro';

const OX = 46;
const OY = 242; // I = 0
const PT = 30; // px per с
const PA = 150; // px per А
const ts = [0, 1, 2, 3, 4, 5, 6, 7, 8];
const As = [0, 0.2, 0.4, 0.6, 0.8, 1, 1.2];
const num = (v: number) => String(v).replace('.', ',');
---

<G7Styles />
<figure class="g7 cgp not-content" data-cgp>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 320 266" role="img" aria-label="Сверху — кусок провода с сечением, через которое проходят электроны. Ниже — график силы тока от времени; закрашенная площадь под графиком до отметки времени равна прошедшему заряду">
			<!-- the strip: a piece of wire and its cross-section -->
			<rect class="cgp-wire" x="22" y="17" width="276" height="22" rx="11"></rect>
			<g data-elec></g>
			<ellipse class="cgp-sec" cx="160" cy="28" rx="4.5" ry="11"></ellipse>
			<path class="cgp-cur" d="M198 8 H246 M240 4 L247 8 L240 12"></path>
			<text class="t-small t-red" x="251" y="12">ток</text>
			<text class="t-small t-blue" x="24" y="12">электроны</text>
			<text class="t-small cgp-sec-t" x="160" y="12" text-anchor="middle">сечение</text>
			<!-- the graph -->
			{ts.map((t) => <line class="cgp-grid" x1={OX + t * PT} x2={OX + t * PT} y1={OY} y2={OY - 1.2 * PA} />)}
			{As.map((a) => <line class="cgp-grid" x1={OX} x2={OX + 8 * PT} y1={OY - a * PA} y2={OY - a * PA} />)}
			<path class="cgp-area" data-area></path>
			<text class="cgp-dq" data-dq text-anchor="middle">Δ<tspan class="t-i">q</tspan></text>
			<path class="ln" d={`M${OX} ${OY} H${OX + 8 * PT + 8} M${OX} ${OY} V${OY - 1.2 * PA - 8}`}></path>
			<path class="cgp-axhead" d={`M${OX + 8 * PT + 8} ${OY} l-6 -3 v6 z M${OX} ${OY - 1.2 * PA - 8} l-3 6 h6 z`}></path>
			{ts.map((t) => <text class="t-small t-num" x={OX + t * PT} y={OY + 13} text-anchor="middle">{t}</text>)}
			{As.map((a) => <text class="t-small t-num" x={OX - 5} y={OY - a * PA + 4} text-anchor="end">{num(a)}</text>)}
			<text class="t-small" x={OX + 8 * PT + 12} y={OY + 4}><tspan class="t-i">t</tspan>, с</text>
			<text class="t-small" x={OX + 8} y={OY - 1.2 * PA - 4}><tspan class="t-i">I</tspan>, А</text>
			<path class="cgp-line" data-line></path>
			<path class="cgp-mark" data-mark></path>
			<circle class="cgp-dot" data-dot r="4"></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" data-mode>
				<button type="button" class="g7__btn" data-v="const" aria-pressed="true">Постоянный ток</button>
				<button type="button" class="g7__btn" data-v="grow" aria-pressed="false">Ток растёт</button>
			</div>
			<ul class="g7__read" aria-live="off">
				<li><span>Время <i>Δt</i></span><b data-rt></b></li>
				<li><span>Сила тока <i>I</i> сейчас</span><b data-ri></b></li>
				<li class="cgp-q"><span>Заряд <i>Δq</i> (площадь)</span><b data-rq></b></li>
				<li class="is-key"><span><i>Δq</i>/<i>Δt</i></span><b data-rm></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Заряд, прошедший через сечение проводника, равен площади под графиком силы тока — так же, как перемещение равно <a href="../../kinematika/ravnouskorennoe-dvizhenie/#перемещение-при-равноускоренном-движении">площади под графиком скорости</a>. Скорость электронов условная.
	</figcaption>
</figure>

<style is:global>
	[data-cgp] .g7__read li.cgp-q {
		box-shadow: inset 3px 0 0 var(--g7-violet);
		background: color-mix(in oklab, var(--g7-violet) 14%, var(--sl-color-gray-6));
	}
	.cgp-wire {
		fill: color-mix(in oklab, hsl(24, 60%, 55%) 16%, var(--g7-paper));
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.cgp-sec {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 30%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.g7__svg .cgp-sec-t {
		fill: var(--sl-color-gray-2);
	}
	.cgp-e {
		fill: var(--g7-blue);
	}
	.cgp-cur {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.cgp-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.cgp-axhead {
		fill: var(--g7-ink);
	}
	.cgp-area {
		fill: color-mix(in oklab, var(--g7-violet) 34%, transparent);
	}
	.g7__svg .cgp-dq {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
		paint-order: stroke fill;
		stroke: color-mix(in oklab, var(--g7-violet) 34%, var(--g7-paper));
		stroke-width: 3px;
	}
	.cgp-line {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.cgp-mark {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.cgp-dot {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
</style>

<script>
	import { el, fmt, loop, segment } from '../g7/kit';

	const OX = 46;
	const OY = 242;
	const PT = 30;
	const PA = 150;
	const RUN = 8; // s
	const HOLD = 1.5; // s
	const V = 40; // px/с of the dots per ампер
	for (const root of document.querySelectorAll<HTMLElement>('[data-cgp]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let mode: 'const' | 'grow' = 'const';
		const I = (t: number) => (mode === 'const' ? 0.5 : t / 8);
		const Q = (t: number) => (mode === 'const' ? 0.5 * t : (t * t) / 16);
		// electrons in three rows; they move to the left (against the current)
		const eg = q<SVGGElement>('[data-elec]');
		const dots = Array.from({ length: 36 }, (_, i) => {
			const c = el('circle', { class: 'cgp-e', r: 2.1 });
			eg.append(c);
			return { c, x: 26 + ((i * 23) % 268) + (i % 3) * 3, y: [22, 28, 34][i % 3], ph: i * 1.3 };
		});
		const area = q('[data-area]');
		const dq = q<SVGTextElement>('[data-dq]');
		const line = q('[data-line]');
		const drawLine = () => line.setAttribute('d', mode === 'const' ? `M${OX} ${OY - 0.5 * PA} H${OX + 8 * PT}` : `M${OX} ${OY} L${OX + 8 * PT} ${OY - PA}`);
		let clock = 0;
		const draw = (t: number) => {
			const x = OX + t * PT;
			const y = OY - I(t) * PA;
			area.setAttribute('d', mode === 'const' ? `M${OX} ${OY} V${y} H${x} V${OY} Z` : `M${OX} ${OY} L${x.toFixed(1)} ${y.toFixed(1)} V${OY} Z`);
			// the label Δq inside the area once it is big enough
			const show = mode === 'const' ? t > 1.2 : t > 3.2;
			dq.style.display = show ? '' : 'none';
			if (show) {
				dq.setAttribute('x', (mode === 'const' ? OX + (t * PT) / 2 : OX + (2 * t * PT) / 3).toFixed(1));
				dq.setAttribute('y', (mode === 'const' ? OY - 0.25 * PA + 5 : OY - (I(t) * PA) / 3 + 5).toFixed(1));
			}
			q('[data-mark]').setAttribute('d', `M${x.toFixed(1)} ${OY} V${(OY - 1.2 * PA).toFixed(1)}`);
			q('[data-dot]').setAttribute('cx', x.toFixed(1));
			q('[data-dot]').setAttribute('cy', y.toFixed(1));
			q('[data-rt]').textContent = `${fmt(t, 1)} с`;
			q('[data-ri]').textContent = `${fmt(I(t), 2)} А`;
			q('[data-rq]').textContent = `${fmt(Q(t), 2)} Кл`;
			q('[data-rm]').textContent = t < 0.05 ? '—' : `${fmt(Q(t) / t, 2)} А`;
		};
		let shift = 0;
		loop(root, (dt) => {
			clock = (clock + dt) % (RUN + HOLD);
			const t = Math.min(RUN, clock);
			const run = clock < RUN;
			if (run) shift += V * I(t) * dt;
			for (const d of dots) {
				let x = d.x - shift;
				x = 26 + ((((x - 26) % 268) + 268) % 268);
				d.c.setAttribute('cx', x.toFixed(1));
				d.c.setAttribute('cy', (d.y + 0.8 * Math.sin(9 * clock + d.ph)).toFixed(1));
			}
			draw(t);
			return true;
		});
		segment(q('[data-mode]'), (b) => {
			mode = b.dataset.v as 'const' | 'grow';
			clock = 0;
			drawLine();
			draw(0);
		});
		drawLine();
		draw(0);
	}
</script>
