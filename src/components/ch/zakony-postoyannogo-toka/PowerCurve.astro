---
/**
 * «Мощность во внешней цепи»: a source with ℰ = 12 В and internal resistance r = 1, 2 or 4 Ом feeds a load R
 * (0…20 Ом). I = ℰ/(R + r); the full power of the source ℰI is split into the useful power in the load I²R and the
 * power I²r lost inside the source; the efficiency is η = R/(R + r).
 * The strip at the top is the full power at this moment, always the same width: its teal part is the useful power,
 * its orange part the loss (to scale within the strip). Below, the graph of the useful power against R on fixed axes:
 * Labels and the legend are 12 px (about 11 px on a 390 px phone), tick numbers 10,5 px.
 * R 0…20 Ом (14 px per Ом), P 0…40 Вт (4 px per Вт); the largest useful power ℰ²/4r = 36, 18 or 9 Вт is at R = r.
 */
import G7Styles from '../g7/G7Styles.astro';

const OX = 46;
const OY = 248;
const PR = 14;
const PP = 4;
---

<G7Styles />
<figure class="g7 pwc not-content" data-pwc>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 280" role="img" aria-label="Полоска делит полную мощность источника на полезную и потерянную внутри источника. Ниже — график полезной мощности в зависимости от внешнего сопротивления">
			<text x={OX} y="16" data-full></text>
			<rect class="pwc-lost" x={OX} y="22" width="280" height="18" rx="3"></rect>
			<rect class="pwc-use" data-use x={OX} y="22" width="0" height="18" rx="3"></rect>
			<text x={OX} y="56"><tspan class="pwc-t-use">■</tspan> во внешней цепи  <tspan class="pwc-t-lost">■</tspan> внутри источника</text>
			<path class="ln" d={`M${OX} ${OY} H${OX + 20 * PR + 8} M${OX} ${OY} V${OY - 40 * PP - 10}`}></path>
			{[0, 5, 10, 15, 20].map((R) => (
				<>
					<line class="pwc-grid" x1={OX + R * PR} x2={OX + R * PR} y1={OY} y2={OY - 40 * PP} />
					<text class="t-small t-num" x={OX + R * PR} y={OY + 16} text-anchor="middle">{R}</text>
				</>
			))}
			{[0, 10, 20, 30, 40].map((P) => (
				<>
					<line class="pwc-grid" x1={OX} x2={OX + 20 * PR} y1={OY - P * PP} y2={OY - P * PP} />
					<text class="t-small t-num" x={OX - 9} y={OY - P * PP + 4} text-anchor="end">{P}</text>
				</>
			))}
			<text x={OX + 20 * PR + 4} y={OY + 30} text-anchor="end"><tspan class="t-i">R</tspan>, Ом</text>
			<text x={OX - 34} y={OY - 40 * PP - 16}><tspan class="t-i">P</tspan>, Вт</text>
			<path class="pwc-curve" data-curve></path>
			<path class="pwc-guide" data-guide></path>
			<circle class="pwc-point" data-point r="5"></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<span class="g7__label">Внутреннее сопротивление <i>r</i></span>
				<div class="g7__seg" data-rs>
					<button type="button" class="g7__btn" data-v="1" aria-pressed="false">1&nbsp;Ом</button>
					<button type="button" class="g7__btn" data-v="2" aria-pressed="true">2&nbsp;Ом</button>
					<button type="button" class="g7__btn" data-v="4" aria-pressed="false">4&nbsp;Ом</button>
				</div>
			</div>
			<label class="g7__slider">
				<span>Внешнее сопротивление <i>R</i></span>
				<output data-out-rext></output>
				<input type="range" min="0" max="20" step="0.5" value="10" data-rext aria-label="Внешнее сопротивление, омы" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сила тока <i>I</i></span><b data-i></b></li>
				<li class="is-key"><span>Полезная мощность <i>I</i>²<i>R</i></span><b data-p></b></li>
				<li><span>Внутри источника <i>I</i>²<i>r</i></span><b data-pr></b></li>
				<li><span>Полная мощность ℰ<i>I</i></span><b data-pf></b></li>
				<li class="is-key"><span>КПД источника <i>η</i></span><b data-eta></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">ЭДС источника 12&nbsp;В. Полоска — полная мощность источника в этот момент (её ширина не меняется), бирюзовая часть — полезная мощность, оранжевая — нагрев самого источника. На графике — полезная мощность при разных <i>R</i>, точка — выбранное <i>R</i>.</figcaption>
</figure>

<style is:global>
	.g7 {
		--zpt-useful: hsl(172, 62%, 48%);
		--zpt-loss: hsl(24, 95%, 58%);
	}
	:root[data-theme='light'] .g7 {
		--zpt-useful: hsl(174, 75%, 28%);
		--zpt-loss: hsl(22, 88%, 46%);
	}
	.g7__svg .pwc-t-use {
		fill: var(--zpt-useful);
	}
	.g7__svg .pwc-t-lost {
		fill: var(--zpt-loss);
	}
	[data-pwc] .g7__read li.is-key {
		box-shadow: inset 3px 0 0 var(--zpt-useful);
		background: color-mix(in oklab, var(--zpt-useful) 14%, var(--sl-color-gray-6));
	}
	.pwc-lost {
		fill: color-mix(in oklab, var(--zpt-loss) 80%, transparent);
	}
	.pwc-use {
		fill: var(--zpt-useful);
	}
	.pwc-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.pwc-curve {
		fill: none;
		stroke: var(--zpt-useful);
		stroke-width: 2.4;
	}
	.pwc-guide {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.pwc-point {
		fill: var(--zpt-useful);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	@media (max-width: 40rem) {
		[data-pwc] .g7__svg .t-small {
			font-size: 12.5px;
		}
	}
</style>

<script>
	import { fmt, segment } from '../g7/kit';

	const OX = 46;
	const OY = 248;
	const PR = 14;
	const PP = 4;
	const E = 12;
	for (const root of document.querySelectorAll<HTMLElement>('[data-pwc]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const RIn = q<HTMLInputElement>('[data-rext]');
		let r = 2;
		const update = () => {
			const R = Number(RIn.value);
			const I = E / (R + r);
			const P = I * I * R;
			const Pr = I * I * r;
			const Pf = E * I;
			const eta = R / (R + r);
			q('[data-out-rext]').textContent = `${fmt(R, 1)} Ом`;
			q('[data-i]').textContent = `${fmt(I, 2)} А`;
			q('[data-p]').textContent = `${fmt(P, 1)} Вт`;
			q('[data-pr]').textContent = `${fmt(Pr, 1)} Вт`;
			q('[data-pf]').textContent = `${fmt(Pf, 1)} Вт`;
			q('[data-eta]').textContent = `${Math.round(eta * 100)} %`;
			q('[data-full]').textContent = `полная мощность источника: ${fmt(Pf, 1)} Вт`;
			q('[data-use]').setAttribute('width', (280 * eta).toFixed(1));
			let d = '';
			for (let k = 0; k <= 200; k++) {
				const x = k / 10;
				const p = (E * E * x) / ((x + r) * (x + r));
				d += `${k ? 'L' : 'M'}${(OX + x * PR).toFixed(1)} ${(OY - p * PP).toFixed(1)} `;
			}
			q('[data-curve]').setAttribute('d', d);
			const px = OX + R * PR;
			const py = OY - P * PP;
			q('[data-point]').setAttribute('cx', px.toFixed(1));
			q('[data-point]').setAttribute('cy', py.toFixed(1));
			q('[data-guide]').setAttribute('d', `M${px.toFixed(1)} ${OY} V${py.toFixed(1)} H${OX}`);
		};
		segment(q('[data-rs]'), (b) => {
			r = Number(b.dataset.v);
			update();
		});
		RIn.addEventListener('input', update);
		update();
	}
</script>
