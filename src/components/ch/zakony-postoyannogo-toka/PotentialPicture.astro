---
/**
 * «Потенциал вдоль цепи»: a circuit drawn in one line (school symbols) and, under it on the same horizontal scale, the
 * graph of the potential φ along it. The potential is drawn green, as in «Электростатика».
 *
 * mode="section" (§ «Закон Ома для участка цепи», after U = φ₁ − φ₂): a section A — wire — R₁ = 2 Ом — wire — R₂ — wire
 *   — B with φ_A = 6 В, φ_B = 0 (U = 6 В). Slider R₂ 1…6 Ом (step 0,5, default 4). I = U/(R₁ + R₂), U₁ = IR₁, U₂ = IR₂;
 *   the potential is flat along the wires (their resistance is neglected) and falls linearly across each resistor.
 *   Check: R₂ = 4 → 1 А, 2 В, 4 В; R₂ = 1 → 2 А, 4 В, 2 В; R₂ = 6 → 0,75 А, 1,5 В, 4,5 В. 26 px per вольт.
 * mode="loop" (§ «Закон Ома для полной цепи», after U = ℰ − Ir): the whole circuit unrolled from the «−» pole: the
 *   source (dashed box: the cell and its internal resistance r = 1 Ом), the wire, the load R, the wire back to the same
 *   «−» pole (the dashed line on top closes the loop). ℰ = 4,5 В. The side forces lift the potential by ℰ (drawn at one
 *   place, at the cell), it falls by Ir across r inside the source and by U = IR across the load, and comes back to the
 *   level it started from. Slider R 0…10 Ом (step 0,5, default 8). Check: R = 8 → 0,5 А, U = 4 В, Ir = 0,5 В;
 *   R = 2 → 1,5 А, 3 В, 1,5 В; R = 0 → 4,5 А, U = 0, Ir = 4,5 В. 30 px per вольт.
 */
import G7Styles from '../g7/G7Styles.astro';

interface Props {
	mode?: 'section' | 'loop';
}
const { mode = 'section' } = Astro.props;
const loop = mode === 'loop';
const OX = 40; // the φ axis
const OY = 244; // φ = 0
const PV = loop ? 30 : 26; // px per В
const VMAX = loop ? 5 : 6;
const LY = loop ? 46 : 40; // the line of the scheme
const ticks = Array.from({ length: VMAX + 1 }, (_, i) => i);
// x of the parts
const P = loop
	? { a: 52, cell: 62, r0: 82, r1: 118, plus: 132, R0: 196, R1: 256, b: 340 }
	: { a: 60, r10: 100, r11: 150, r20: 206, r21: 256, b: 340 };
---

<G7Styles />
<figure class={`g7 ppic not-content`} data-ppic={mode}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 268" role="img" aria-label={loop ? 'Вся цепь, развёрнутая в линию: источник с внутренним сопротивлением, провод, нагрузка, провод обратно к тому же полюсу. Ниже — график потенциала: в источнике он поднимается на ЭДС, внутри источника падает на Ir, на нагрузке падает на U и возвращается к начальному значению' : 'Участок цепи из двух резисторов и проводов между точками A и B. Ниже — график потенциала вдоль участка: вдоль проводов он почти не меняется, а на каждом резисторе падает'}>
			<!-- grid and axis -->
			{ticks.map((v) => <line class="ppic-grid" x1={OX} x2="350" y1={OY - v * PV} y2={OY - v * PV} />)}
			<path class="ln" d={`M${OX} ${OY} H352 M${OX} ${OY} V${OY - VMAX * PV - 10}`}></path>
			<path class="ppic-axh" d={`M${OX} ${OY - VMAX * PV - 14} l-3 7 h6 z`}></path>
			{ticks.map((v) => <text class="t-small t-num" x={OX - 5} y={OY - v * PV + 4} text-anchor="end">{v}</text>)}
			<text class="t-small" x={OX + 7} y={OY - VMAX * PV - 6}><tspan class="t-i">φ</tspan>, В</text>
			{
				loop ? (
					<>
						<!-- the scheme: from the «−» pole through the source, the load and back -->
						<path class="ppic-return" d={`M${P.b} ${LY} V12 H${P.a} V${LY}`} />
						<rect class="ppic-box" x={P.a + 4} y={LY - 16} width={P.plus - P.a - 8} height="32" rx="5" />
						<path class="ppic-wire" d={`M${P.a} ${LY} H${P.cell - 3} M${P.cell + 3} ${LY} H${P.r0} M${P.r1} ${LY} H${P.R0} M${P.R1} ${LY} H${P.b}`} />
						<line class="ppic-plate ppic-plate--short" x1={P.cell - 3} x2={P.cell - 3} y1={LY - 6} y2={LY + 6} />
						<line class="ppic-plate" x1={P.cell + 3} x2={P.cell + 3} y1={LY - 12} y2={LY + 12} />
						<rect class="ppic-res" x={P.r0} y={LY - 5} width={P.r1 - P.r0} height="10" />
						<rect class="ppic-res" x={P.R0} y={LY - 7} width={P.R1 - P.R0} height="14" />
						<circle class="ppic-node" cx={P.a} cy={LY} r="2.6" />
						<circle class="ppic-node" cx={P.plus} cy={LY} r="2.6" />
						<circle class="ppic-node" cx={P.b} cy={LY} r="2.6" />
						<text class="t-strong t-blue" x={P.a - 8} y={LY + 5} text-anchor="middle">−</text>
						<text class="t-strong t-red" x={P.plus + 5} y={LY - 7}>+</text>
						<text class="t-strong t-blue" x={P.b + 8} y={LY + 5} text-anchor="middle">−</text>
						<text class="t-i" x={(P.r0 + P.r1) / 2} y={LY - 8} text-anchor="middle">r</text>
						<text class="t-i" x={P.cell} y={LY - 19} text-anchor="middle">ℰ</text>
						<text class="t-i" x={(P.R0 + P.R1) / 2} y={LY - 11} text-anchor="middle">R</text>
						<text class="t-small" x={(P.a + P.plus) / 2} y={LY + 28} text-anchor="middle">источник</text>
						<path class="ppic-cur" d={`M${P.plus + 18} ${LY} H${P.plus + 46} M${P.plus + 40} ${LY - 4} L${P.plus + 47} ${LY} L${P.plus + 40} ${LY + 4}`} />
						<text class="t-small t-red" x={P.plus + 32} y={LY + 16} text-anchor="middle">ток</text>
					</>
				) : (
					<>
						<path class="ppic-wire" d={`M${P.a} ${LY} H${P.r10} M${P.r11} ${LY} H${P.r20} M${P.r21} ${LY} H${P.b}`} />
						<rect class="ppic-res" x={P.r10} y={LY - 7} width={P.r11 - P.r10} height="14" />
						<rect class="ppic-res" x={P.r20} y={LY - 7} width={P.r21 - P.r20} height="14" />
						<circle class="ppic-node" cx={P.a} cy={LY} r="3" />
						<circle class="ppic-node" cx={P.b} cy={LY} r="3" />
						<text class="t-strong" x={P.a} y={LY - 10} text-anchor="middle">A</text>
						<text class="t-strong" x={P.b} y={LY - 10} text-anchor="middle">B</text>
						<text x={(P.r10 + P.r11) / 2} y={LY - 14} text-anchor="middle"><tspan class="t-i">R</tspan><tspan baseline-shift="sub" font-size="9">1</tspan> = 2 Ом</text>
						<text x={(P.r20 + P.r21) / 2} y={LY - 14} text-anchor="middle" data-r2l></text>
						<path class="ppic-cur" d={`M${P.r11 + 14} ${LY} H${P.r11 + 42} M${P.r11 + 36} ${LY - 4} L${P.r11 + 43} ${LY} L${P.r11 + 36} ${LY + 4}`} />
						<text class="t-small t-red" x={P.r11 + 28} y={LY + 16} text-anchor="middle">ток</text>
					</>
				)
			}
			<!-- guides from the parts down to the graph -->
			<path class="ppic-guide" d={loop ? [P.cell, P.r0, P.r1, P.R0, P.R1].map((x) => `M${x} ${x === P.R0 || x === P.R1 ? LY + 10 : LY + 33} V${OY}`).join(' ') : [P.r10, P.r11, P.r20, P.r21].map((x) => `M${x} ${LY + 10} V${OY}`).join(' ')} />
			<!-- the graph and its brackets -->
			<path class="ppic-phi" data-phi></path>
			{loop && <path class="ppic-jump" data-jump></path>}
			<g data-brackets></g>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>{loop ? 'Сопротивление нагрузки ' : 'Сопротивление '}<i>R</i>{loop ? '' : <sub>2</sub>}</span>
				<output data-out></output>
				{loop ? <input type="range" min="0" max="10" step="0.5" value="8" data-r aria-label="Сопротивление нагрузки, омы" /> : <input type="range" min="1" max="6" step="0.5" value="4" data-r aria-label="Сопротивление второго резистора, омы" />}
			</label>
			<p class="g7__note">{loop ? <>ЭДС <i>ℰ</i> = 4,5&nbsp;В, внутреннее сопротивление <i>r</i> = 1&nbsp;Ом.</> : <>Напряжение на участке <i>U</i> = 6&nbsp;В.</>}</p>
			<ul class="g7__read" aria-live="polite">
				<li><span>Сила тока <i>I</i></span><b data-ri></b></li>
				{loop ? (
					<>
						<li class="is-key"><span>На нагрузке <i>U</i> = <i>IR</i></span><b data-r1></b></li>
						<li><span>Внутри источника <i>Ir</i></span><b data-r2></b></li>
					</>
				) : (
					<>
						<li><span><i>U</i><sub>1</sub> = <i>IR</i><sub>1</sub></span><b data-r1></b></li>
						<li><span><i>U</i><sub>2</sub> = <i>IR</i><sub>2</sub></span><b data-r2></b></li>
					</>
				)}
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		{loop ? (
			<>Сторонние силы поднимают потенциал на <i>ℰ</i>, часть подъёма <i>Ir</i> теряется внутри источника, остальное <i>U</i> = <i>ℰ</i> − <i>Ir</i> приходится на внешнюю цепь. Скачок в источнике для простоты показан в одном месте. Пунктир сверху замыкает цепь: конец линии — тот же полюс «−», что и начало.</>
		) : (
			<>Вдоль провода потенциал почти не меняется, а на каждом резисторе падает. Напряжение на участке — разность потенциалов его концов; на большем сопротивлении — большее напряжение.</>
		)}
	</figcaption>
</figure>

<style is:global>
	.ppic-grid {
		stroke: var(--g7-faint);
		stroke-width: 0.6;
	}
	.ppic-axh {
		fill: var(--g7-ink);
	}
	.ppic-wire {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.ppic-return {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	.ppic-box {
		fill: color-mix(in oklab, var(--g7-green) 10%, transparent);
		stroke: var(--g7-line);
		stroke-width: 1.1;
		stroke-dasharray: 5 3;
	}
	.ppic-res {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.ppic-plate {
		stroke: var(--g7-ink);
		stroke-width: 1.8;
	}
	.ppic-plate--short {
		stroke-width: 4.5;
	}
	.ppic-node {
		fill: var(--g7-ink);
	}
	.ppic-cur {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.ppic-guide {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.7;
		stroke-dasharray: 2 3;
		opacity: 0.7;
	}
	.ppic-phi {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 2.8;
		stroke-linejoin: round;
	}
	.ppic-jump {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 2.8;
	}
	.ppic-br {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.1;
	}
	.ppic-br--g {
		stroke: var(--g7-green);
	}
	@media (max-width: 40rem) {
		[data-ppic] .g7__svg .t-small {
			font-size: 12.5px;
		}
	}
</style>

<script>
	import { el, fmtTrim } from '../g7/kit';

	const OX = 40;
	const OY = 244;
	for (const root of document.querySelectorAll<HTMLElement>('[data-ppic]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const loop = root.dataset.ppic === 'loop';
		const PV = loop ? 30 : 26;
		const y = (v: number) => OY - v * PV;
		const inp = q<HTMLInputElement>('[data-r]');
		const br = q<SVGGElement>('[data-brackets]');
		// a vertical double arrow from level a to level b at x, and its label
		const bracket = (x: number, a: number, b: number, label: string, lx: number, anchor: 'start' | 'end', green = false) => {
			const y0 = y(a);
			const y1 = y(b);
			const h = Math.abs(y1 - y0);
			if (h > 7) {
				br.append(el('path', { class: green ? 'ppic-br ppic-br--g' : 'ppic-br', d: `M${x} ${y0 + 1} V${y1 - 1} M${x - 3} ${y0 + 5} L${x} ${y0 + 1} L${x + 3} ${y0 + 5} M${x - 3} ${y1 - 5} L${x} ${y1 - 1} L${x + 3} ${y1 - 5}` }));
			}
			const t = el('text', { x: lx, y: ((y0 + y1) / 2 + 4).toFixed(1), 'text-anchor': anchor, class: green ? 't-green t-halo' : 't-halo' });
			t.innerHTML = label;
			br.append(t);
			return t;
		};
		const sub = (s: string, i: string) => `<tspan class="t-i">${s}</tspan><tspan baseline-shift="sub" font-size="9">${i}</tspan>`;
		const V = (v: number) => `${fmtTrim(v, 2)} В`;
		const update = () => {
			const R = Number(inp.value);
			br.replaceChildren();
			if (loop) {
				const E = 4.5;
				const r = 1;
				const I = E / (R + r);
				const U = I * R;
				const Ir = I * r;
				// from the «−» pole (φ = 0): jump by ℰ at the cell, fall by Ir across r, flat, fall by U across R, flat
				q('[data-phi]').setAttribute('d', `M52 ${y(0)} H62 M62 ${y(E)} H82 L118 ${y(U)} H196 L256 ${y(0)} H340`);
				q('[data-jump]').setAttribute('d', `M62 ${y(0)} V${y(E) + 1} M58 ${y(E) + 8} L62 ${y(E) + 1} L66 ${y(E) + 8}`);
				const e = el('text', { x: 68, y: (y(E / 2) + 5).toFixed(1), class: 't-i t-green t-halo' });
				e.textContent = 'ℰ';
				br.append(e);
				const ir = bracket(124, E, U, '<tspan class="t-i">Ir</tspan>', 130, 'start');
				if (Math.abs(y(E) - y(U)) < 20) ir.setAttribute('y', String(y(E) - 4));
				const u = bracket(190, U, 0, '<tspan class="t-i">U</tspan>', 184, 'end');
				if (U < 0.01) {
					u.setAttribute('y', String(OY - 6));
					u.innerHTML = '<tspan class="t-i">U</tspan> = 0';
				}
				q('[data-out]').textContent = `${fmtTrim(R, 1)} Ом`;
				q('[data-ri]').textContent = `${fmtTrim(I, 2)} А`;
				q('[data-r1]').textContent = V(U);
				q('[data-r2]').textContent = V(Ir);
			} else {
				const U = 6;
				const R1 = 2;
				const I = U / (R1 + R);
				const U1 = I * R1;
				const U2 = I * R;
				q('[data-phi]').setAttribute('d', `M60 ${y(U)} H100 L150 ${y(U - U1)} H206 L256 ${y(0)} H340`);
				bracket(155, U, U - U1, `${sub('U', '1')} = ${V(U1)}`, 161, 'start');
				bracket(261, U - U1, 0, `${sub('U', '2')} = ${V(U2)}`, 267, 'start');
				bracket(350, U, 0, `<tspan class="t-i">U</tspan> = 6 В`, 344, 'end').setAttribute('y', String(y(5.3) + 4));
				q('[data-r2l]').innerHTML = `${sub('R', '2')} = ${fmtTrim(R, 1)} Ом`;
				q('[data-out]').textContent = `${fmtTrim(R, 1)} Ом`;
				q('[data-ri]').textContent = `${fmtTrim(I, 2)} А`;
				q('[data-r1]').textContent = V(U1);
				q('[data-r2]').textContent = V(U2);
			}
		};
		inp.addEventListener('input', update);
		update();
	}
</script>
