---
/**
 * «Электромагнитная волна» (picture, a slow looping animation). On the left a vertical antenna (two metal rods with a
 * generator «~» between them); its electrons («−», neutral color: red and blue are the poles of magnets) move up and
 * down together, 9 px either way. From the antenna a plane harmonic wave runs along the axis x:
 *   E (red) along y:  E = E₀·sin 2π(t/T − x/λ),   B (purple) along z:  B = B₀·sin 2π(t/T − x/λ),
 * in phase, as in a wave in vacuum; E × B points along +x, the way the wave runs (gold arrow c, the color of the
 * direction of a wave in «Волны. Длина волны»). At the antenna E points against the displacement (and so against the
 * acceleration) of the electrons, as the far field of a dipole does: electrons up — E down. The field is drawn
 * along one line only, two and a half wavelengths of a long wave (280 px, λ = 112 px), arrows every λ/8.
 * Scale: the lengths of the red and the purple arrows are drawn equal at the crests; their real ratio depends on the
 * units (in SI B₀ = E₀/c), so only the directions and the common rhythm are meant. Slowed down: the picture shows one
 * period in 2 с; a radio wave of 100 МГц has T = 10 нс, light about 2·10⁻¹⁵ с.
 * The camera can turn: «Наискосок» (yaw 35°, pitch 20°), «Сбоку» (E in the picture plane, B along the line of sight,
 * drawn as ⊙ / ⊗ whose size follows |B|), «Сверху» (B in the picture plane, E along the line of sight). A small triad
 * in the corner shows E, B and c from one point with right-angle marks, turning with the camera.
 */
import EvsStyles from './EvsStyles.astro';
---

<EvsStyles />
<figure class="g7 g7--pic evs not-content" data-evs-wave>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 284" role="img" aria-label="Электромагнитная волна бежит вдоль оси. Красные стрелки электрического поля направлены вверх и вниз, фиолетовые стрелки магнитного поля — вперёд и назад, перпендикулярно красным; обе меняются в такт. Золотая стрелка показывает, куда бежит волна; зелёная скобка — длина волны">
			<g data-ant>
				<path class="evs-rod" data-rods></path>
				<rect class="evs-gen" width="14" height="12" rx="2" data-gen></rect>
				<path class="evs-gen-wave" data-genw></path>
				<g data-elec></g>
			</g>
			<path class="evs-e-fill" data-efill></path>
			<path class="evs-b-fill" data-bfill></path>
			<path class="evs-axis" data-axis></path>
			<path class="evs-e-line" data-ecurve></path>
			<path class="evs-b-line" data-bcurve></path>
			<g data-vecs></g>
			<g data-lam>
				<path class="evs-lambda-guide" data-lamguide></path>
				<path class="evs-lambda" data-lambr></path>
				<text class="t-i t-l" font-size="15" text-anchor="middle" data-lamt>λ</text>
			</g>
			<path class="arrow arrow--gold" stroke-width="2.6" data-cs></path>
			<path class="head--gold" data-ch></path>
			<text class="t-i t-c" font-size="15" data-ct>c</text>
			<text class="t-i t-e" font-size="15" data-el>E</text>
			<path class="arrow--e" fill="none" stroke-width="1.1" data-ela></path>
			<text class="t-i t-b" font-size="15" data-bl>B</text>
			<path class="arrow--b" fill="none" stroke-width="1.1" data-bla></path>
			<g data-triad></g>
			<text class="t-small" x="104" y="236"><tspan class="t-i t-e" font-size="12">E</tspan> — электрическое поле</text>
			<text class="t-small" x="104" y="252"><tspan class="t-i t-b" font-size="12">B</tspan> — магнитное поле</text>
			<text class="t-small" x="104" y="268"><tspan class="t-i t-c" font-size="12">c</tspan> — направление распространения</text>
			<text class="t-small" x="104" y="220">«−» — электроны в антенне</text>
		</svg>
	</div>
	<div class="evs-bar">
		<span class="g7__label">Смотреть:</span>
		<div class="g7__seg" data-views>
			<button type="button" class="g7__btn" aria-pressed="true" data-v="0">наискосок</button>
			<button type="button" class="g7__btn" aria-pressed="false" data-v="1">сбоку</button>
			<button type="button" class="g7__btn" aria-pressed="false" data-v="2">сверху</button>
		</div>
		<button type="button" class="g7__btn" aria-pressed="false" data-pause>Пауза</button>
	</div>
	<figcaption class="g7__caption">
		Электроны в антенне колеблются вверх и вниз и порождают волну. В каждой точке на пути волны электрическое поле (красные стрелки, вектор <i>E</i>) и магнитное поле
		(фиолетовые стрелки, вектор <i>B</i>) меняются в такт. Они перпендикулярны друг другу и направлению, в котором
		бежит волна (золотая стрелка). Поле показано только вдоль одной линии; длины красных и фиолетовых стрелок
		условные. Движение замедлено в миллионы раз и больше.
	</figcaption>
</figure>

<style is:global>
	.evs .evs-rod {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 5;
		stroke-linecap: round;
	}
	.evs .evs-gen {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.evs .evs-gen-wave {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.evs .evs-electron {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.evs .evs-minus {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
</style>

<script>
	import { el, view, newVec, bracket, loop, ease, TAU } from './evs';

	const VIEWS: [number, number][] = [
		[35, 20],
		[0, 0],
		[0, 90],
	].map(([a, b]) => [(a * Math.PI) / 180, (b * Math.PI) / 180]);

	for (const fig of document.querySelectorAll<HTMLElement>('[data-evs-wave]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const CX = 168;
		const CY = 128;
		const X0 = -150;
		const X1 = 130;
		const LAM = 112;
		const T = 2;
		const A = 60; // px, the crest of both arrows
		const N = Math.round(((X1 - X0) / LAM) * 8);
		const xs = Array.from({ length: N + 1 }, (_, i) => X0 + ((X1 - X0) * i) / N);
		const RODS = 74;
		const elec = Array.from({ length: 6 }, () => {
			const g = el('g');
			g.append(el('circle', { class: 'evs-electron', r: 4 }), el('path', { class: 'evs-minus', d: 'M-2.2 0 H2.2' }));
			q('[data-elec]').append(g);
			return g;
		});
		const vecs = q<SVGGElement>('[data-vecs]');
		const groups = xs.map(() => {
			const g = el('g');
			const ge = el('g');
			const gb = el('g');
			g.append(gb, ge);
			vecs.append(g);
			return { g, ge, gb, e: newVec(ge, 'e'), b: newVec(gb, 'b') };
		});
		const triad = q<SVGGElement>('[data-triad]');
		const tri = {
			sq1: el('path', { class: 'evs-axis', 'stroke-width': 0.9 }),
			sq2: el('path', { class: 'evs-axis', 'stroke-width': 0.9 }),
			sq3: el('path', { class: 'evs-axis', 'stroke-width': 0.9 }),
			cs: el('path', { class: 'arrow arrow--gold', 'stroke-width': 2 }),
			ch: el('path', { class: 'head--gold' }),
		};
		triad.append(tri.sq1, tri.sq2, tri.sq3, tri.cs, tri.ch);
		const triE = newVec(triad, 'e');
		const triB = newVec(triad, 'b');
		const tLab = (cls: string, s: string, vec: boolean) => {
			const t = el('text', { class: `t-i ${cls}`, 'font-size': 13 });
			t.textContent = s;
			triad.append(t);
			const a = el('path', { class: cls === 't-e' ? 'arrow--e' : 'arrow--b', fill: 'none', 'stroke-width': 1 });
			if (vec) triad.append(a);
			return { t, a };
		};
		const tE = tLab('t-e', 'E', true);
		const tB = tLab('t-b', 'B', true);
		const tC = tLab('t-c', 'c', false);
		let a = VIEWS[0][0];
		let b = VIEWS[0][1];
		let from = VIEWS[0];
		let to = VIEWS[0];
		let turn = 1;
		let t = 0.4;
		let paused = false;
		let lastOrder = '';
		/** The small arrow over a letter set at (x, y) (the letter's baseline start). */
		const vecArrow = (x: number, y: number) => `M${x.toFixed(1)} ${(y - 14).toFixed(1)} h9 m-2.5 -2 l2.5 2 l-2.5 2`;
		const P = (p: { x: number; y: number }) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
		const head = (x1: number, y1: number, x2: number, y2: number, hl: number, hw: number) => {
			const L = Math.hypot(x2 - x1, y2 - y1) || 1;
			const ux = (x2 - x1) / L;
			const uy = (y2 - y1) / L;
			const ex = x2 - ux * hl;
			const ey = y2 - uy * hl;
			return {
				shaft: `M${x1.toFixed(1)} ${y1.toFixed(1)} L${(ex + ux * 0.4).toFixed(1)} ${(ey + uy * 0.4).toFixed(1)}`,
				head: `M${x2.toFixed(1)} ${y2.toFixed(1)} L${(ex - uy * hw).toFixed(1)} ${(ey + ux * hw).toFixed(1)} L${(ex + uy * hw).toFixed(1)} ${(ey - ux * hw).toFixed(1)} Z`,
			};
		};
		const draw = () => {
			const V = view(a, b, CX, CY);
			const ph = (x: number) => TAU * (t / T - (x - X0) / LAM);
			// the antenna: two rods along y with a generator between them; its electrons move together, up and down.
			// The far field of the antenna points against the acceleration of its charges: E(X0) ∝ −y of the electrons.
			const XA = X0 - 12;
			const r1 = V.p(XA, 7, 0);
			const r2 = V.p(XA, RODS, 0);
			const r3 = V.p(XA, -7, 0);
			const r4 = V.p(XA, -RODS, 0);
			q('[data-rods]').setAttribute('d', `M${P(r1)} L${P(r2)} M${P(r3)} L${P(r4)}`);
			const gc = V.p(XA, 0, 0);
			const gen = q('[data-gen]');
			gen.setAttribute('x', (gc.x - 7).toFixed(1));
			gen.setAttribute('y', (gc.y - 6).toFixed(1));
			q('[data-genw]').setAttribute('d', `M${(gc.x - 4.5).toFixed(1)} ${gc.y.toFixed(1)} q2.25 -3.2 4.5 0 t4.5 0`);
			const ye = -9 * Math.sin(TAU * (t / T));
			elec.forEach((e, j) => {
				const sgn = j < 3 ? 1 : -1;
				const y = sgn * (22 + 16 * (j % 3)) + ye;
				const pe = V.p(XA, y, 0);
				e.setAttribute('transform', `translate(${pe.x.toFixed(1)} ${pe.y.toFixed(1)})`);
			});
			// the axis and the two curves with their light fills
			const ax0 = V.p(X0 - 6, 0, 0);
			const ax1 = V.p(X1 + 4, 0, 0);
			q('[data-axis]').setAttribute('d', `M${P(ax0)} L${P(ax1)}`);
			let de = '';
			let db = '';
			for (let x = X0; x <= X1 + 0.01; x += 3.5) {
				const s = Math.sin(ph(x));
				de += `${x === X0 ? 'M' : 'L'}${P(V.p(x, A * s, 0))}`;
				db += `${x === X0 ? 'M' : 'L'}${P(V.p(x, 0, A * s))}`;
			}
			q('[data-ecurve]').setAttribute('d', de);
			q('[data-bcurve]').setAttribute('d', db);
			q('[data-efill]').setAttribute('d', `${de} L${P(V.p(X1, 0, 0))} L${P(V.p(X0, 0, 0))} Z`);
			q('[data-bfill]').setAttribute('d', `${db} L${P(V.p(X1, 0, 0))} L${P(V.p(X0, 0, 0))} Z`);
			// the arrows, nearer ones drawn later (the order depends on the camera only)
			const order = xs.map((x, i) => [V.p(x, 0, 0).depth, i]).sort((u, w) => u[0] - w[0]);
			const key = order.map((o) => o[1]).join(',');
			if (key !== lastOrder) {
				for (const [, i] of order) vecs.append(groups[i].g);
				lastOrder = key;
			}
			xs.forEach((x, i) => {
				const s = Math.sin(ph(x));
				const o = V.p(x, 0, 0);
				const pe = V.p(x, A * s, 0);
				const pb = V.p(x, 0, A * s);
				const g = groups[i];
				g.e(o.x, o.y, pe.x, pe.y, pe.depth - o.depth, Math.abs(s));
				g.b(o.x, o.y, pb.x, pb.y, pb.depth - o.depth, Math.abs(s));
				// the nearer of the two arrows on top
				if (pb.depth > pe.depth) g.g.append(g.gb);
				else g.g.append(g.ge);
			});
			// λ: between two neighboring crests of E, a bracket above them (hidden when E points at the viewer)
			const c0 = ((((t / T) * LAM) % LAM) + LAM) % LAM; // crests of E at x − X0 = (t/T − 1/4)·λ + nλ
			let xc = X0 + c0 - LAM / 4;
			while (xc < X0 + 6) xc += LAM;
			if (xc + LAM > X1) xc -= LAM;
			if (xc < X0) xc += LAM;
			const lamOn = Math.cos(b) > 0.5 && xc + LAM <= X1 + 0.5;
			const yb = A + 16;
			const p1 = V.p(xc, yb, 0);
			const p2 = V.p(xc + LAM, yb, 0);
			const c1 = V.p(xc, A + 2, 0);
			const c2 = V.p(xc + LAM, A + 2, 0);
			q('[data-lambr]').setAttribute('d', lamOn ? bracket(p1.x, p1.y, p2.x, p2.y) : '');
			q('[data-lamguide]').setAttribute('d', lamOn ? `M${P(c1)} L${P(p1)} M${P(c2)} L${P(p2)}` : '');
			const lt = q('[data-lamt]');
			lt.setAttribute('x', ((p1.x + p2.x) / 2).toFixed(1));
			lt.setAttribute('y', ((p1.y + p2.y) / 2 - 6).toFixed(1));
			lt.style.opacity = lamOn ? '1' : '0';
			// the direction of the wave
			const g1 = V.p(X1 + 8, 0, 0);
			const g2 = V.p(X1 + 40, 0, 0);
			const gh = head(g1.x, g1.y, g2.x, g2.y, 8, 4.5);
			q('[data-cs]').setAttribute('d', gh.shaft);
			q('[data-ch]').setAttribute('d', gh.head);
			const gl = V.p(X1 + 40, 0, 0);
			const ct = q('[data-ct]');
			ct.setAttribute('x', (gl.x - 6).toFixed(1));
			ct.setAttribute('y', (gl.y - 9).toFixed(1));
			// labels of the two fields at the far end, each with the arrow of a vector over it; a field that points
			// along the line of sight is labelled below the start of the axis instead
			const st = V.p(X1, 0, 0);
			const lpos = (tip: { x: number; y: number }) =>
				Math.hypot(tip.x - st.x, tip.y - st.y) < 0.4 * A ? { x: st.x + 22, y: st.y + 30 } : tip;
			const le = lpos(V.p(X1 + 10, A + 4, 0));
			const lb = lpos(V.p(X1 + 10, 0, A + 14));
			const setL = (txt: string, arr: string, p: { x: number; y: number }) => {
				const tx = q(txt);
				const x = Math.min(342, Math.max(8, p.x));
				const y = Math.max(22, Math.min(196, p.y + 5));
				tx.setAttribute('x', x.toFixed(1));
				tx.setAttribute('y', y.toFixed(1));
				q(arr).setAttribute('d', vecArrow(x, y));
			};
			setL('[data-el]', '[data-ela]', le);
			setL('[data-bl]', '[data-bla]', lb);
			// the triad in the corner
			const TV = view(a, b, 44, 248);
			const L = 26;
			const o = TV.p(0, 0, 0);
			const e = TV.p(0, L, 0);
			const bb = TV.p(0, 0, L);
			const c = TV.p(L + 4, 0, 0);
			triE(o.x, o.y, e.x, e.y, e.depth - o.depth, 1);
			triB(o.x, o.y, bb.x, bb.y, bb.depth - o.depth, 1);
			const th = head(o.x, o.y, c.x, c.y, 6, 3.2);
			tri.cs.setAttribute('d', th.shaft);
			tri.ch.setAttribute('d', th.head);
			const s = 6;
			const sq = (u: [number, number, number], w: [number, number, number]) => {
				const p1 = TV.p(u[0] * s, u[1] * s, u[2] * s);
				const p2 = TV.p((u[0] + w[0]) * s, (u[1] + w[1]) * s, (u[2] + w[2]) * s);
				const p3 = TV.p(w[0] * s, w[1] * s, w[2] * s);
				return `M${P(p1)} L${P(p2)} L${P(p3)}`;
			};
			tri.sq1.setAttribute('d', sq([1, 0, 0], [0, 1, 0]));
			tri.sq2.setAttribute('d', sq([1, 0, 0], [0, 0, 1]));
			tri.sq3.setAttribute('d', sq([0, 1, 0], [0, 0, 1]));
			const lab = (l: { t: SVGTextElement; a: SVGPathElement }, p: { x: number; y: number }, dx: number, dy: number) => {
				const x = p.x + dx - 4;
				const y = p.y + dy;
				l.t.setAttribute('x', x.toFixed(1));
				l.t.setAttribute('y', y.toFixed(1));
				l.a.setAttribute('d', `M${x.toFixed(1)} ${(y - 12).toFixed(1)} h8 m-2.2 -1.8 l2.2 1.8 l-2.2 1.8`);
			};
			const away = (p: { x: number; y: number }) => {
				const dx = p.x - o.x;
				const dy = p.y - o.y;
				const l = Math.hypot(dx, dy);
				return l < 4 ? [-12, -8] : [(dx / l) * 9, (dy / l) * 9 + 4];
			};
			const [ex, ey] = away(e);
			lab(tE, e, ex, ey);
			const [bx, by] = away(bb);
			lab(tB, bb, bx + (Math.hypot(bb.x - o.x, bb.y - o.y) < 4 ? -8 : 0), by + (Math.hypot(bb.x - o.x, bb.y - o.y) < 4 ? 26 : 0));
			const [cx, cy] = away(c);
			lab(tC, c, cx, cy);
		};
		const btns = [...fig.querySelectorAll<HTMLButtonElement>('[data-views] button')];
		for (const btn of btns)
			btn.addEventListener('click', () => {
				for (const o of btns) o.setAttribute('aria-pressed', String(o === btn));
				from = [a, b];
				to = VIEWS[Number(btn.dataset.v)];
				turn = 0;
				wake();
			});
		const pause = q<HTMLButtonElement>('[data-pause]');
		pause.addEventListener('click', () => {
			paused = !paused;
			pause.setAttribute('aria-pressed', String(paused));
			pause.textContent = paused ? 'Пуск' : 'Пауза';
			wake();
		});
		draw();
		const wake = loop(fig, (dt) => {
			if (!paused) t = (t + dt) % (T * 1000);
			if (turn < 1) {
				turn = Math.min(1, turn + dt / 0.9);
				const k = ease(turn);
				a = from[0] + (to[0] - from[0]) * k;
				b = from[1] + (to[1] - from[1]) * k;
			}
			draw();
			return !paused || turn < 1;
		});
	}
</script>
