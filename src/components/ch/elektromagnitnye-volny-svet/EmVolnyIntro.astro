---
/**
 * Two short looping opening scenes of «Электромагнитные волны. Свет как электромагнитная волна». No terms of the
 * chapter in the pictures or the visible captions; the captions' popovers explain. People: the people kit, in profile.
 *
 * Remote («Пульт»): an evening living room, 1,5 px per см (the teen is 158 см). A teen sits on a sofa with a TV remote
 *   in the near hand (lying along the fingers, which wrap round it from below, the thumb on its top) and a phone in the far hand. The
 *   teen raises the remote toward the TV (0,6 с), presses: the TV switches to another channel, but the remote's front
 *   end shows nothing. Then the far hand raises the phone (0,8 с) and holds it in front of the remote, its screen toward
 *   the teen; the remote now points at the phone's front camera. The round inset is the phone's screen: on every press
 *   (four presses, 0,8 с apart) a pale violet-white dot flickers at the remote's front end (bursts of 0,25 с with a
 *   flicker), while in the room the end stays dark. Then both hands go back to the lap (0,8 с).
 *   Physics: the LED of a remote sends near-infrared light of about 940 нм in short packets (a 38 кГц carrier); the eye
 *   does not see it, a camera sensor does and shows it pale violet-white. Many phones' main cameras have a filter
 *   against infrared, the front (selfie) cameras usually do not: so the phone looks at the remote with its front camera.
 *   The phone in front of the remote blocks it, so the TV does not change on the later presses.
 * Rainbow («Радуга»): a garden on a summer evening, 0,55 px per см (the gardener is 176 см). The Sun is low behind the
 *   gardener, 25° above the horizon; the long shadow falls forward (176 см / tg 25° = 3,8 м). The gardener holds a
 *   spray wand (60 см) in both hands and sprays fine drops up over a flower bed; the wand rises and falls slowly
 *   between 50° and 62° (a full sway in 4 с). About 900 drops fly true parabolas, g = 9,8 м/с², 6,0–7,6 м/с out of
 *   the nozzle, ±6° around the wand, in real time. A drop sends colored light to the gardener's eye when the angle
 *   between the line eye → drop and the direction away from the Sun (the line from the Sun through the eye) is 40–42,4°:
 *   at 42,4° red, at 40° violet (in between the colors of the spectrum by the angle).
 *   The colored band (12 thin wedges from the eye between these angles) shows only through the mist: it is masked by
 *   the drops themselves (soft spots 3,2 px round each drop). So it lies along two fixed lines from the eye: when the
 *   spray moves, other drops light up, but the band stays in its place; red on its outer (upper) side, violet inner.
 *   This is the side view: the picture shows which drops look colored to the gardener, not what a side viewer sees.
 * Plays only while visible (scene() from intro/scene.ts).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';
---

<PeopleStyles />
<IntroFrame data-evintro>
	<div class="intro__card" data-scene="remote">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вечер, комната. Подросток сидит на диване и нажимает кнопку пульта, направленного на телевизор: канал переключается, но на конце пульта не видно никакого огонька. Потом он держит перед пультом телефон, и на экране телефона в увеличенном круге видно, как при каждом нажатии мигает огонёк на конце пульта">
			<rect class="evi-wall" x="0" y="0" width="360" height="226"></rect>
			<rect class="evi-skirt" x="0" y="221" width="360" height="5"></rect>
			<rect class="evi-floor" x="0" y="226" width="360" height="14"></rect>
			<ellipse class="evi-rug" cx="200" cy="231" rx="120" ry="6"></ellipse>
			<!-- a floor lamp, dim -->
			<path class="evi-metal" d="M16 226 h14 M23 226 V96"></path>
			<path class="evi-lampshade" d="M12 96 l5 -20 h12 l5 20 Z"></path>
			<ellipse class="evi-lampglow" cx="23" cy="98" rx="26" ry="10"></ellipse>
			<!-- a picture on the wall -->
			<rect class="evi-frame" x="286" y="34" width="44" height="32" rx="1.5"></rect>
			<rect class="evi-pic" x="289" y="37" width="38" height="26"></rect>
			<path class="evi-pic-hill" d="M289 63 Q300 48 312 56 Q320 51 327 56 V63 Z"></path>
			<!-- the TV on a low cabinet -->
			<rect class="evi-cab" x="244" y="190" width="108" height="36" rx="2"></rect>
			<path class="evi-cab-line" d="M298 194 V222 M248 208 H350"></path>
			<rect class="evi-tvstand" x="294" y="178" width="8" height="12"></rect>
			<rect class="evi-tvfoot" x="282" y="187" width="32" height="3" rx="1"></rect>
			<rect class="evi-tv" x="246" y="104" width="104" height="74" rx="3"></rect>
			<g data-channels>
				<g data-ch="0">
					<rect class="evi-ch0-sky" x="250" y="108" width="96" height="66"></rect>
					<circle class="evi-ch0-sun" cx="322" cy="124" r="7"></circle>
					<path class="evi-ch0-hill" d="M250 174 V150 Q272 134 296 148 Q318 138 346 150 V174 Z"></path>
				</g>
				<g data-ch="1" style="opacity: 0">
					<rect class="evi-ch1-bg" x="250" y="108" width="96" height="66"></rect>
					<rect class="evi-ch1-field" x="250" y="146" width="96" height="28"></rect>
					<path class="evi-ch1-line" d="M298 146 V174 M250 160 H346"></path>
					<circle class="evi-ch1-ball" cx="284" cy="156" r="2.2"></circle>
					<path class="evi-ch1-stand" d="M250 132 H346 M250 140 H346"></path>
				</g>
			</g>
			<circle class="evi-tvled" cx="342" cy="176" r="1"></circle>
			<!-- the sofa -->
			<path class="evi-sofa-back" d="M0 106 h44 q6 0 6 6 v52 H0 Z"></path>
			<path class="evi-sofa" d="M0 160 h128 q6 0 6 6 v28 H0 Z"></path>
			<rect class="evi-sofa-leg" x="122" y="194" width="6" height="32"></rect>
			<rect class="evi-cushion" x="4" y="116" width="34" height="40" rx="7" transform="rotate(-8 21 136)"></rect>
			<!-- the teen, the phone behind the far hand, the remote in the near hand -->
			<g data-phone-back></g>
			<g data-phone>
				<rect class="evi-phone" x="-1.3" y="-11" width="2.6" height="22" rx="1"></rect>
				<path class="evi-phone-screen" d="M-1.6 -9.5 V9.5" data-pscreen></path>
			</g>
			<g data-remote-back></g>
			<g data-remote>
				<rect class="evi-remote" x="-11" y="-2.2" width="28" height="3.4" rx="1.4"></rect>
				<rect class="evi-remote-tip" x="14.6" y="-2.2" width="2.4" height="3.4" rx="1"></rect>
				<circle class="evi-remote-btn" cx="4" cy="-2.4" r="0.9" data-btn></circle>
			</g>
			<g data-teen></g>
			<!-- the inset: the phone's screen -->
			<g data-inset style="opacity: 0">
				<path class="evi-loupe-line" d="" data-iline></path>
				<circle class="evi-loupe" cx="212" cy="54" r="44"></circle>
				<clipPath id="evi-clip"><circle cx="212" cy="54" r="43"></circle></clipPath>
				<g clip-path="url(#evi-clip)">
					<rect class="evi-cam-bg" x="166" y="8" width="92" height="92"></rect>
					<ellipse class="evi-cam-hand" cx="216" cy="88" rx="34" ry="22"></ellipse>
					<rect class="evi-cam-remote" x="194" y="38" width="38" height="58" rx="9"></rect>
					<rect class="evi-cam-tip" x="196" y="40" width="34" height="14" rx="7"></rect>
					<circle class="evi-cam-led" cx="213" cy="47" r="3.2"></circle>
					<circle class="evi-cam-flash" cx="213" cy="47" r="9" data-flash></circle>
					<circle class="evi-cam-core" cx="213" cy="47" r="3" data-core></circle>
				</g>
				<circle class="evi-loupe-rim" cx="212" cy="54" r="44"></circle>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Когда нажимают кнопку пульта, глаз не видит на нём никакого огонька, а{' '}<More term="камера телефона">Пульт посылает к телевизору невидимое глазу инфракрасное излучение с длиной волны около 940&nbsp;нм. Матрица камеры его чувствует и показывает бледно-фиолетовым огоньком — раздел [«Шкала электромагнитных волн»](#шкала-электромагнитных-волн).</More>{' '}видит, как он мигает.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="rainbow">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Летний вечер в саду. Низкое солнце за спиной садовника, его длинная тень лежит впереди. Садовник брызгает из шланга вверх над клумбой, и в мелких брызгах появляется полоса радуги: сверху красная, снизу фиолетовая. Струя покачивается, а радуга остаётся на месте">
			<defs>
				<linearGradient id="evi-sky" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" class="evi-sky0"></stop>
					<stop offset="1" class="evi-sky1"></stop>
				</linearGradient>
				<radialGradient id="evi-sunglow">
					<stop offset="0" stop-color="hsl(42, 100%, 85%)" stop-opacity="0.9"></stop>
					<stop offset="1" stop-color="hsl(35, 100%, 70%)" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<rect x="0" y="0" width="360" height="240" fill="url(#evi-sky)"></rect>
			<circle cx="14" cy="98" r="34" fill="url(#evi-sunglow)"></circle>
			<circle class="evi-sun" cx="14" cy="98" r="8"></circle>
			<!-- far trees and a fence -->
			<path class="evi-trees" d="M150 196 q4 -40 22 -44 q20 2 22 30 q10 -26 30 -20 q18 8 14 34 q14 -22 32 -12 q14 12 10 30 q12 -14 30 -6 q10 8 12 18 V202 H150 Z"></path>
			<path class="evi-fence" d="M0 186 H360 M0 196 H360"></path>
			<path class="evi-fence-post" d="M8 182 V204 M40 182 V204 M72 182 V204 M104 182 V204 M136 182 V204 M168 182 V204 M200 182 V204 M232 182 V204 M264 182 V204 M296 182 V204 M328 182 V204"></path>
			<rect class="evi-lawn" x="0" y="202" width="360" height="38"></rect>
			<!-- the long shadow -->
			<path class="evi-shadow" data-shadow></path>
			<!-- the flower bed -->
			<path class="evi-bed" d="M196 214 Q262 204 352 212 L356 222 Q270 226 192 224 Z"></path>
			<g data-flowers></g>
			<!-- the hose on the ground -->
			<path class="evi-hose" data-hose></path>
			<g data-wand-back></g>
			<g data-wand-back-near></g>
			<g data-gardener></g>
			<path class="evi-wand" data-wandline></path>
			<path class="evi-nozzle" data-nozzle></path>
			<mask id="evi-mist-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="360" height="240">
				<g data-maskdrops filter="url(#evi-soft)"></g>
			</mask>
			<filter id="evi-soft" x="-5%" y="-5%" width="110%" height="110%"><feGaussianBlur stdDeviation="1.6"></feGaussianBlur></filter>
			<g data-drops></g>
			<g data-band mask="url(#evi-mist-mask)"></g>
		</svg>
		<div class="intro__foot">
			<p>
				Если встать спиной к низкому Солнцу и пустить из шланга мелкие брызги, в них появляется{' '}<More term="радуга">Каждая капля, как маленькая призма, преломляет белый солнечный свет, и он распадается на цвета. Красный край радуги снаружи, фиолетовый — внутри — раздел [«Дисперсия света»](#дисперсия-света).</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<script>
	import { scene } from '@components/intro/scene';
	import { DEG, type Pt } from '@components/people/core';
	import { figure, ANKLE_CM, type FigurePose, type HandTarget } from '@components/people/body';
	import { attach, attachAxis, ease } from '@components/people/motion';

	const NS = 'http://www.w3.org/2000/svg';
	const mk = <K extends keyof SVGElementTagNameMap>(p: Element, tag: K, a: Record<string, string | number> = {}) => {
		const e = document.createElementNS(NS, tag);
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
		p.append(e);
		return e;
	};
	const f = (v: number) => v.toFixed(1);
	const c01 = (x: number) => Math.min(1, Math.max(0, x));
	const rand = (k: number) => {
		const s = Math.sin(k * 127.1 + 311.7) * 43758.5453;
		return s - Math.floor(s);
	};
	/**
	 * Moves held things into a person's drawing just before the near arm (its sleeve outline, sleeve and hand), so they
	 * lie over the far arm, the legs and the body, and under the near hand's fingers.
	 */
	const beforeNearArm = (figG: Element, ...els: Element[]) => {
		const hand = figG.querySelector(':scope > g > .pk-hand[data-hand="R"]')!;
		const sleeveOutline = hand.previousElementSibling!.previousElementSibling!;
		for (const e of els) sleeveOutline.before(e);
	};
	const lerpP = (a: Pt, b: Pt, k: number): Pt => ({ x: a.x + (b.x - a.x) * k, y: a.y + (b.y - a.y) * k });
	/** The color of light of a wavelength in нм (a smooth fit of the spectrum). */
	const spectral = (nm: number) => {
		let r = 0;
		let g = 0;
		let b = 0;
		if (nm < 440) [r, b] = [-(nm - 440) / 60, 1];
		else if (nm < 490) [g, b] = [(nm - 440) / 50, 1];
		else if (nm < 510) [g, b] = [1, -(nm - 510) / 20];
		else if (nm < 580) [r, g] = [(nm - 510) / 70, 1];
		else if (nm < 645) [r, g] = [1, -(nm - 645) / 65];
		else r = 1;
		const c = (v: number) => Math.round(255 * Math.pow(Math.max(0, Math.min(1, v)), 0.8));
		return `rgb(${c(r)}, ${c(g)}, ${c(b)})`;
	};

	document.querySelectorAll<HTMLElement>('[data-evintro]').forEach((root) => {
		// ---------------- scene 1: the remote and the phone's camera
		{
			const card = root.querySelector<HTMLElement>('[data-scene="remote"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 8;
			const S = 1.5;
			const FLOOR = 226;
			const teen = figure($<SVGGElement>('[data-teen]'), { s: S, H: 158, age: 'teen', shirt: 'hm-blue', hair: 'short', name: 'remote-teen' });
			teen.backLayer(1, $<SVGGElement>('[data-phone-back]'));
			teen.backLayer(0, $<SVGGElement>('[data-remote-back]'));
			// the remote over the far arm (which reaches past it with the phone), under the near hand's fingers
			beforeNearArm($('[data-teen]'), $('[data-remote-back]'), $('[data-remote]'));
			const phone = $<SVGGElement>('[data-phone]');
			const remote = $<SVGGElement>('[data-remote]');
			const btn = $<SVGCircleElement>('[data-btn]');
			const inset = $<SVGGElement>('[data-inset]');
			const iline = $<SVGPathElement>('[data-iline]');
			const flash = $<SVGCircleElement>('[data-flash]');
			const core = $<SVGCircleElement>('[data-core]');
			const ch = [$<SVGGElement>('[data-ch="0"]'), $<SVGGElement>('[data-ch="1"]')];
			const u = S * 158;
			const ankleY = FLOOR - ANKLE_CM.trainer * S;
			const seat = { x: 62, y: 160 - 0.04 * u };
			// the hands: the remote held with the fingers down round it, the back of the hand to us, the thumb forward
			const remoteRest: Pt = { x: 104, y: 140 };
			const remoteAimTV: Pt = { x: 112, y: 120 };
			const remoteAimPhone: Pt = { x: 110, y: 118 };
			const phoneRest: Pt = { x: 92, y: 146 };
			const phoneUp: Pt = { x: 146, y: 112 };
			const PRESS = [1.25, 3.35, 4.15, 4.95, 5.75];
			const pose = (t: number): FigurePose => {
				const up1 = ease(c01((t - 0.3) / 0.6)) * (1 - ease(c01((t - 6.4) / 0.8)));
				const toPhone = ease(c01((t - 1.9) / 0.8));
				const ph = ease(c01((t - 1.8) / 0.8)) * (1 - ease(c01((t - 6.3) / 0.8)));
				const aim = lerpP(remoteAimTV, remoteAimPhone, toPhone);
				// a press: the hand dips by 0,6 px for 0,15 с
				const dip = PRESS.reduce((m, p) => Math.max(m, 1 - Math.abs(t - p) / 0.08), 0);
				const rAt = lerpP(remoteRest, aim, up1);
				rAt.y += 0.6 * Math.max(0, dip);
				// the remote lies along the fingers, the thumb on its top; it points at the TV, then at the phone
				const tvDir = Math.atan2(140 - rAt.y, 298 - rAt.x);
				const phDir = Math.atan2(phoneUp.y + 4 - rAt.y, phoneUp.x - rAt.x);
				const remoteDir = (1 - up1) * 8 * DEG + up1 * ((1 - toPhone) * tvDir + toPhone * phDir);
				const near: HandTarget = { at: rAt, pose: 'grip', d: 4.5, dir: remoteDir, roll: -Math.PI / 2, contact: 'remote' };
				const far: HandTarget = { at: lerpP(phoneRest, phoneUp, ph), pose: 'grip', d: 7, dir: (-25 + 35 * (1 - ph)) * DEG, roll: -Math.PI / 2 + 0.25, contact: 'phone' };
				return {
					hip: seat,
					lean: 0.18,
					head: 0.25 + 0.12 * ph,
					ankles: [{ x: 116, y: ankleY }, { x: 109, y: ankleY }],
					feet: [0, 0],
					hands: [near, far],
					planted: [true, true],
				};
			};
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const st = teen.pose(pose(t));
				attach(remote, st.grips[0]);
				attachAxis(phone, st.grips[1]);
				// the button lights while pressed
				const pressing = PRESS.some((p) => Math.abs(t - p) < 0.12);
				btn.classList.toggle('is-on', pressing);
				// the TV: the first press switches the channel
				const sw = c01((t - 1.3) / 0.15);
				ch[0].style.opacity = String(1 - sw);
				ch[1].style.opacity = String(sw);
				// the inset appears when the phone is up
				const ins = c01((t - 2.5) / 0.3) * (1 - c01((t - 6.2) / 0.3));
				inset.style.opacity = String(ins);
				const g = st.grips[1];
				iline.setAttribute('d', `M${f(g.x + 1)} ${f(g.y - 10)} L${f(176)} ${f(78)}`);
				// a burst: 0,25 с of flicker on each press after the phone is up
				let k = 0;
				for (const p of PRESS.slice(1)) {
					const tau = t - p + 0.05;
					if (tau >= 0 && tau < 0.25) k = 0.55 + 0.45 * Math.abs(Math.sin(tau * 90));
				}
				flash.style.opacity = String(0.85 * k);
				core.style.opacity = String(k > 0 ? 1 : 0);
			});
		}

		// ---------------- scene 2: the rainbow in the spray
		{
			const card = root.querySelector<HTMLElement>('[data-scene="rainbow"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RUN = 8;
			const S = 0.55; // px per см
			const GROUND = 214; // where the gardener stands
			const GX = 64; // the gardener's ankles
			const H = 176;
			const SUN = 25 * DEG;
			const man = figure($<SVGGElement>('[data-gardener]'), { s: S, H, age: 'adult', shirt: 'hm-green', hair: 'short', name: 'gardener' });
			man.backLayer(1, $<SVGGElement>('[data-wand-back]'));
			man.backLayer(0, $<SVGGElement>('[data-wand-back-near]'));
			const wandLine = $<SVGPathElement>('[data-wandline]');
			const nozzle = $<SVGPathElement>('[data-nozzle]');
			// the wand over the far hand and the body, under the near hand's fingers
			beforeNearArm($('[data-gardener]'), $('[data-wand-back-near]'), wandLine, nozzle);
			const u = S * H;
			const ankleY = GROUND - ANKLE_CM.trainer * S;
			const hip = { x: GX - 2, y: ankleY - (0.24 + 0.235) * u * 0.995 };
			const eye = { x: GX + 6, y: GROUND - 0.93 * H * S };
			// the shadow: from the feet forward, 176 см / tg 25° long
			const L = (H / Math.tan(SUN)) * S;
			$('[data-shadow]').setAttribute('d', `M${GX - 6} ${GROUND + 1} L${f(GX + L - 6)} ${GROUND + 5} Q${f(GX + L + 4)} ${GROUND + 6} ${f(GX + L - 6)} ${GROUND + 8} L${GX - 6} ${GROUND + 4} Z`);
			// flowers
			const fl = $('[data-flowers]');
			for (let i = 0; i < 26; i++) {
				const x = 200 + i * 6 + 3 * rand(i);
				const y = 214 + 6 * rand(i + 40) - 2;
				mk(fl, 'path', { class: 'evi-stalk', d: `M${f(x)} ${f(y + 8)} V${f(y)}` });
				mk(fl, 'circle', { class: `evi-flower evi-flower${i % 3}`, cx: f(x), cy: f(y), r: 1.8 });
			}
			// the wand: its angle sways between 50° and 62°, a full sway in 4 с
			const theta = (t: number) => (56 - 6 * Math.cos((2 * Math.PI * t) / 4)) * DEG;
			const REAR: Pt = { x: GX + 22 * S, y: GROUND - 96 * S }; // the near hand at the wand's rear end
			const WL = 60 * S;
			const wandPts = (t: number) => {
				const th = theta(t);
				const d = { x: Math.cos(th), y: -Math.sin(th) };
				const rear = { x: REAR.x + 2 * S * Math.sin(2 * Math.PI * t / 4), y: REAR.y };
				return { th, d, rear, front: { x: rear.x + d.x * 26 * S, y: rear.y + d.y * 26 * S }, tip: { x: rear.x + d.x * WL, y: rear.y + d.y * WL } };
			};
			// the drops: N drops, each born again every P s at the nozzle of that moment
			const N = 900;
			const P = 1.35;
			const dropsG = $('[data-drops]');
			const drops = Array.from({ length: N }, () => mk(dropsG, 'circle', { r: 0.9, class: 'evi-mist' }));
			// the colored band: thin wedges from the eye, 40…42,4° from the direction away from the Sun (that is 15…17,4°
			// above the horizon), violet at 40°, red at 42,4°; it shows only through the mist (a mask made of the drops)
			const maskG = $('[data-maskdrops]');
			const maskDrops = Array.from({ length: N }, () => mk(maskG, 'circle', { r: 0, fill: 'white', 'fill-opacity': 0.55 }));
			const band = $('[data-band]');
			for (let k = 0; k < 12; k++) {
				const a0 = 40 + (k * 2.4) / 12;
				const a1 = a0 + 2.4 / 12 + 0.02;
				const e0 = (a0 - 25) * DEG;
				const e1 = (a1 - 25) * DEG;
				const Rr = 420;
				mk(band, 'path', { d: `M${f(eye.x)} ${f(eye.y)} L${f(eye.x + Rr * Math.cos(e0))} ${f(eye.y - Rr * Math.sin(e0))} L${f(eye.x + Rr * Math.cos(e1))} ${f(eye.y - Rr * Math.sin(e1))} Z`, fill: spectral(400 + ((a0 + 0.1 - 40) / 2.4) * 300) });
			}
			const anti = { x: Math.cos(SUN), y: -Math.sin(SUN) }; // away from the Sun, physical (x right, y up)
			const hose = $<SVGPathElement>('[data-hose]');
			scene(card, RUN, (x) => {
				const t = RUN * x;
				const w = wandPts(t);
				const dir = 90 * DEG - w.th; // the fingers across the wand
				const near: HandTarget = { at: w.rear, pose: 'grip', d: 2.6, dir, roll: -Math.PI / 2, contact: 'wand' };
				const far: HandTarget = { at: w.front, pose: 'grip', d: 2.6, dir, roll: Math.PI / 2, contact: 'wand' };
				const st = man.pose({ hip, lean: 0.05, head: -0.12, ankles: [{ x: GX + 4, y: ankleY }, { x: GX - 8, y: ankleY }], feet: [0, 0], hands: [near, far], planted: [true, true] });
				// the wand along its axis through the near hand's grip
				const g0 = st.grips[0];
				const back = { x: g0.x - w.d.x * 4, y: g0.y - w.d.y * 4 };
				const end = { x: g0.x + w.d.x * WL, y: g0.y + w.d.y * WL };
				wandLine.setAttribute('d', `M${f(back.x)} ${f(back.y)} L${f(end.x)} ${f(end.y)}`);
				nozzle.setAttribute('d', `M${f(end.x - w.d.x * 2.5)} ${f(end.y - w.d.y * 2.5)} L${f(end.x + w.d.x * 1.2)} ${f(end.y + w.d.y * 1.2)}`);
				hose.setAttribute('d', `M${f(back.x)} ${f(back.y)} Q${f(back.x - 22)} ${f(back.y + 30)} ${f(GX - 30)} ${GROUND + 6} T${f(GX - 80)} ${GROUND + 10}`);
				for (let i = 0; i < N; i++) {
					const off = (i / N) * P;
					const n = Math.floor((t - off) / P);
					const born = n * P + off;
					const age = t - born;
					const seed = i * 13.7 + n * 7.31;
					const v = (600 + 160 * rand(seed)) * S; // px/s
					const th = theta(born) + (rand(seed + 1) - 0.5) * 12 * DEG;
					const g = 980 * S;
					const bornTip = wandPts(born).tip;
					const sx = bornTip.x;
					const sy = bornTip.y;
					const px = sx + v * Math.cos(th) * age;
					const py = sy - v * Math.sin(th) * age + 0.5 * g * age * age;
					const el = drops[i];
					if (py > GROUND + 4 || px > 362) {
						el.setAttribute('r', '0');
						maskDrops[i].setAttribute('r', '0');
						continue;
					}
					el.setAttribute('cx', f(px));
					el.setAttribute('cy', f(py));
					el.setAttribute('r', '0.9');
					const m = maskDrops[i];
					m.setAttribute('cx', f(px));
					m.setAttribute('cy', f(py));
					m.setAttribute('r', '3.2');
				}
			});
		}
	});
</script>

