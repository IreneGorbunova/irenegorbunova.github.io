---
/**
 * «Опыт Герца со стоячей волной» (model). Hertz's room seen from the side, 70 px per м. Left, the vibrator: two
 * vertical metal rods with balls and a spark gap between them, on an insulating stand above an induction coil; it
 * sparks four times a second (decoration, slowed: a real vibrator sparks many times faster and each spark rings for
 * microseconds). Its rods are a half wave long (λ/2 = 1,5; 1,0; 0,6 м), so they shrink when the frequency is raised.
 * Right, a large flat metal sheet on the wall, 4,0 м from the vibrator. A ruler on the floor from the sheet: 0 … 3,0 м.
 * The receiver, a short straight vertical wire with a small spark gap in its middle (along E) on an insulating stick,
 * is moved along the ruler (slider 0,00–3,00 м, step 0,05 м, or by dragging it); with every spark of the vibrator a
 * spark jumps in its gap. Not a ring: a small ring in the picture plane would answer to the magnetic field, whose
 * antinode is at the metal sheet; a wire along E honestly has its node of the spark at the sheet.
 *   With the sheet: the wave and its reflection make a standing wave with a node of E at the metal, so the spark's
 *   size and brightness are s = |sin(2πx/λ)| (x from the sheet): no spark at x = 0, λ/2, λ …; the fall of the wave
 *   with the distance from the vibrator is left out (all bright places are equally bright).
 *   Without the sheet: a running wave, no places without a spark; the spark fades as 1/r, s = (1 м)/r, r = 4,0 м − x.
 *   Readout «искра»: нет (s < 0,05), слабая (s < 0,7), яркая.
 * Vibrators (the frequencies are chosen for the model; Hertz's own waves were several meters long and, in his later
 * experiments with mirrors, well under a meter): длинный 100 МГц (λ = 3 м), средний 150 МГц (λ = 2 м), короткий
 * 250 МГц (λ = 1,2 м), λ = c/ν with c = 3·10⁸ м/с. Nodes on the ruler: 0; 1,5; 3,0 м — 0; 1; 2; 3 м — 0; 0,6; 1,2;
 * 1,8; 2,4; 3,0 м. «Отметить» puts a tick on the ruler at the ring (up to 6), «Показать волну» draws the gray
 * envelope of the standing wave (off at the start, so the nodes are first found by the spark).
 * The room is shortened (a real room is wider than the ruler) and drawn not to scale in height.
 */
import EvsStyles from './EvsStyles.astro';
const PX = 70;
const XS = 330; // the sheet's face
const xs = (m: number) => XS - m * PX;
---

<EvsStyles />
<figure class="g7 g7--stack evs not-content" data-evs-hertz>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 230" role="img" aria-label="Опыт Герца: слева вибратор с искровым промежутком, справа на стене металлический лист, на полу линейка от листа. Приёмник — провод с маленьким зазором — передвигают вдоль линейки; в его зазоре проскакивает искра, в некоторых местах её нет">
			<rect class="hz-wall" x="0" y="0" width="360" height="200"></rect>
			<rect class="hz-floor" x="0" y="200" width="360" height="30"></rect>
			<!-- the metal sheet -->
			<rect class="hz-sheet" x={XS} y="20" width="9" height="180"></rect>
			<path class="hz-sheet-shine" d={`M${XS + 3} 26 V194`}></path>
			<text class="t-small" x={XS - 4} y="16" text-anchor="end" data-sheettext>металлический лист</text>
			<!-- the envelope of the standing wave -->
			<path class="hz-env" data-env></path>
			<!-- the vibrator -->
			<g data-vib>
				<rect class="hz-coil" x={xs(4) - 16} y="172" width="32" height="20" rx="3"></rect>
				<path class="hz-coil-turns" d={`M${xs(4) - 12} 176 v12 M${xs(4) - 8} 176 v12 M${xs(4) - 4} 176 v12 M${xs(4)} 176 v12 M${xs(4) + 4} 176 v12 M${xs(4) + 8} 176 v12 M${xs(4) + 12} 176 v12`}></path>
				<rect class="hz-stand" x={xs(4) - 2} y="150" width="4" height="22"></rect>
				<path class="hz-wire" d=""></path>
				<path class="hz-rod" d="" data-rod></path>
				<circle class="hz-ball" r="3.4" data-b1></circle>
				<circle class="hz-ball" r="3.4" data-b2></circle>
				<circle class="hz-ball" r="6" data-e1></circle>
				<circle class="hz-ball" r="6" data-e2></circle>
				<path class="hz-spark" data-vspark></path>
				<text class="t-small" x={xs(4)} y="214" text-anchor="middle">вибратор</text>
			</g>
			<!-- the ruler on the floor -->
			<rect class="hz-ruler" x={xs(3) - 4} y="202" width={3 * PX + 8} height="10" rx="1.5"></rect>
			{
				Array.from({ length: 31 }, (_, i) => i).map((i) => (
					<path class="hz-rtick" d={`M${xs(i / 10).toFixed(1)} 202 V${i % 5 === 0 ? 208 : 205}`} />
				))
			}
			{
				[0, 0.5, 1, 1.5, 2, 2.5, 3].map((m) => (
					<text class="t-small" x={xs(m).toFixed(1)} y="224" text-anchor="middle">
						{m === 3 ? '3 м' : String(m).replace('.', ',')}
					</text>
				))
			}
			<g data-ticks></g>
			<!-- the receiver -->
			<g class="drag" data-rx>
				<rect x="-18" y="-26" width="36" height="118" fill="transparent"></rect>
				<path class="hz-stick" d="M0 21 V86"></path>
				<path class="hz-base" d="M-10 90 h20 l-3 -4 h-14 Z"></path>
				<path class="hz-rod" d="M0 -18 V-2.6 M0 2.6 V18"></path>
				<circle class="hz-ball" cx="0" cy="-2.6" r="1.8"></circle>
				<circle class="hz-ball" cx="0" cy="2.6" r="1.8"></circle>
				<circle class="hz-ball" cx="0" cy="-19" r="2.6"></circle>
				<circle class="hz-ball" cx="0" cy="19" r="2.6"></circle>
				<path class="hz-spark" data-rspark></path>
				<text class="t-small" x="9" y="-22" data-rxlabel>приёмник</text>
			</g>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<span class="g7__label">Вибратор:</span>
				<div class="g7__seg" data-vibs>
					<button type="button" class="g7__btn" aria-pressed="true" data-nu="100">длинный</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-nu="150">средний</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-nu="250">короткий</button>
				</div>
			</div>
			<label class="g7__slider"><span>Расстояние от листа <i>x</i></span><output data-xv>2,25 м</output><input type="range" min="0" max="3" step="0.05" value="2.25" data-x /></label>
			<ul class="g7__read">
				<li>Частота вибратора <b data-nuv>ν = 100 МГц</b></li>
				<li class="is-key">Искра в приёмнике <b data-sp>—</b></li>
			</ul>
			<div class="g7__row">
				<button type="button" class="g7__btn" data-mark>Отметить</button>
				<button type="button" class="g7__btn" data-clear>Стереть отметки</button>
			</div>
			<label class="evs-check"><input type="checkbox" data-nosheet /> Убрать металлический лист</label>
			<label class="evs-check"><input type="checkbox" data-env-on /> Показать волну</label>
		</div>
	</div>
	<figcaption class="g7__caption">
		Приёмник — провод с маленьким зазором — передвигают вдоль линейки. Искры замедлены, комната укорочена; частоты вибраторов выбраны для
		модели. Расстояние <i>x</i> отсчитывают от металлического листа.
	</figcaption>
</figure>

<style is:global>
	.evs .hz-wall {
		fill: color-mix(in oklab, var(--ig-v) 6%, var(--g7-paper));
	}
	.evs .hz-floor {
		fill: var(--g7-wood-dark);
	}
	.evs .hz-sheet {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.evs .hz-sheet-shine {
		stroke: color-mix(in oklab, var(--sl-color-white) 50%, transparent);
		stroke-width: 1;
	}
	.evs .hz-coil {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.evs .hz-coil-turns {
		stroke: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-3));
		stroke-width: 1.6;
	}
	.evs .hz-stand,
	.evs .hz-stick {
		fill: var(--g7-wood);
		stroke: var(--g7-wood);
		stroke-width: 3;
	}
	.evs .hz-stand {
		stroke-width: 0;
	}
	.evs .hz-base {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.evs .hz-wire {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.evs .hz-rod {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.evs .hz-ring {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2.4;
	}
	.evs .hz-ball {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.7;
	}
	.evs .hz-spark {
		fill: none;
		stroke: hsl(200, 100%, 85%);
		stroke-width: 1.6;
		stroke-linejoin: round;
		filter: drop-shadow(0 0 2px hsl(200, 100%, 70%));
	}
	:root[data-theme='light'] .evs .hz-spark {
		stroke: hsl(215, 90%, 50%);
		filter: drop-shadow(0 0 2px hsl(210, 100%, 70%));
	}
	.evs .hz-env {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 18%, transparent);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.evs .hz-ruler {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.6;
	}
	.evs .hz-rtick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	.evs .hz-mark {
		fill: var(--sl-color-accent);
		stroke: var(--g7-paper);
		stroke-width: 0.8;
	}
</style>

<script>
	import { loop, fmt } from './evs';
	import { svgPoint } from '../g7/kit';

	const PX = 70;
	const XS = 330;
	const xs = (m: number) => XS - m * PX;
	const YC = 110; // the height of the spark gaps
	const C = 3e8;
	const spark = (x: number, y: number, s: number, vertical: boolean, seed: number) => {
		if (s <= 0) return '';
		// a zigzag across a gap: along x for the vibrator's vertical gap, along y for the ring's gap at the top
		const n = 4;
		const L = 5.2 * Math.max(0.35, s);
		const w = 2.6 * s + 0.6;
		let d = '';
		for (let i = 0; i <= n; i++) {
			const u = -L / 2 + (L * i) / n;
			const o = i === 0 || i === n ? 0 : (i % 2 ? 1 : -1) * w * (0.6 + 0.4 * Math.sin(seed * 7.1 + i));
			const px = vertical ? x + o : x + u;
			const py = vertical ? y + u : y + o;
			d += `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`;
		}
		return d;
	};

	for (const fig of document.querySelectorAll<HTMLElement>('[data-evs-hertz]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('svg.g7__svg');
		const xin = q<HTMLInputElement>('[data-x]');
		const rx = q<SVGGElement>('[data-rx]');
		const ticks = q<SVGGElement>('[data-ticks]');
		let nu = 100e6;
		let x = 2.25;
		let t = 0;
		const marks: number[] = [];
		const lam = () => C / nu;
		const strength = () => {
			if (q<HTMLInputElement>('[data-nosheet]').checked) return 1 / (4 - x);
			return Math.abs(Math.sin((2 * Math.PI * x) / lam()));
		};
		const vib = () => {
			const half = (lam() / 2) * PX * 0.5; // each rod: a quarter wave
			const X = xs(4);
			q('[data-rod]').setAttribute('d', `M${X} ${YC - 3} V${(YC - half).toFixed(1)} M${X} ${YC + 3} V${(YC + half).toFixed(1)}`);
			q('[data-b1]').setAttribute('cx', String(X));
			q('[data-b1]').setAttribute('cy', String(YC - 3));
			q('[data-b2]').setAttribute('cx', String(X));
			q('[data-b2]').setAttribute('cy', String(YC + 3));
			q('[data-e1]').setAttribute('cx', String(X));
			q('[data-e1]').setAttribute('cy', (YC - half).toFixed(1));
			q('[data-e2]').setAttribute('cx', String(X));
			q('[data-e2]').setAttribute('cy', (YC + half).toFixed(1));
			q('.hz-wire').setAttribute('d', `M${X - 6} 172 Q${X - 14} ${YC + 30} ${X - 2} ${YC + 6} M${X + 6} 172 Q${X + 14} ${YC + 30} ${X + 2} ${YC + 6}`);
		};
		const env = () => {
			const on = q<HTMLInputElement>('[data-env-on]').checked;
			const noSheet = q<HTMLInputElement>('[data-nosheet]').checked;
			if (!on) return q('[data-env]').setAttribute('d', '');
			let top = '';
			let bot = '';
			for (let m = 0; m <= 3.5001; m += 0.025) {
				const a = 30 * (noSheet ? 1 / (4 - m) : Math.abs(Math.sin((2 * Math.PI * m) / lam())));
				top += `${m ? 'L' : 'M'}${xs(m).toFixed(1)} ${(YC - a).toFixed(1)}`;
				bot = `L${xs(m).toFixed(1)} ${(YC + a).toFixed(1)}` + bot;
			}
			q('[data-env]').setAttribute('d', `${top}${bot}Z`);
		};
		const sheet = () => {
			const off = q<HTMLInputElement>('[data-nosheet]').checked;
			for (const s of fig.querySelectorAll<SVGElement>('.hz-sheet, .hz-sheet-shine')) s.style.opacity = off ? '0' : '1';
			q<SVGTextElement>('[data-sheettext]').style.opacity = off ? '0' : '1';
		};
		const read = () => {
			const s = strength();
			q('[data-xv]').textContent = `${fmt(x, 2)} м`;
			q('[data-nuv]').textContent = `ν = ${Math.round(nu / 1e6)} МГц`;
			q('[data-sp]').textContent = s < 0.05 ? 'нет' : s < 0.7 ? 'слабая' : 'яркая';
			rx.setAttribute('transform', `translate(${xs(x).toFixed(1)} ${YC})`);
			// the label goes to the left of the receiver near the sheet
			const lab = q<SVGTextElement>('[data-rxlabel]');
			const left = x < 1;
			lab.setAttribute('x', left ? '-9' : '9');
			lab.setAttribute('text-anchor', left ? 'end' : 'start');
			xin.value = String(x);
			ticks.replaceChildren();
			for (const m of marks) {
				const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
				p.setAttribute('class', 'hz-mark');
				p.setAttribute('d', `M${xs(m).toFixed(1)} 201 l-4 -7 h8 Z`);
				ticks.append(p);
			}
		};
		const all = () => {
			vib();
			env();
			sheet();
			read();
		};
		xin.addEventListener('input', () => {
			x = Number(xin.value);
			read();
		});
		let drag = false;
		rx.addEventListener('pointerdown', (e) => {
			drag = true;
			rx.setPointerCapture((e as PointerEvent).pointerId);
			e.preventDefault();
		});
		rx.addEventListener('pointermove', (e) => {
			if (!drag) return;
			const p = svgPoint(svg, e as PointerEvent);
			x = Math.min(3, Math.max(0, Math.round(((XS - p.x) / PX) * 20) / 20));
			read();
		});
		rx.addEventListener('pointerup', () => (drag = false));
		rx.addEventListener('pointercancel', () => (drag = false));
		const btns = [...fig.querySelectorAll<HTMLButtonElement>('[data-vibs] button')];
		for (const b of btns)
			b.addEventListener('click', () => {
				for (const o of btns) o.setAttribute('aria-pressed', String(o === b));
				nu = Number(b.dataset.nu) * 1e6;
				all();
			});
		q('[data-mark]').addEventListener('click', () => {
			if (!marks.includes(x)) marks.push(x);
			if (marks.length > 6) marks.shift();
			read();
		});
		q('[data-clear]').addEventListener('click', () => {
			marks.length = 0;
			read();
		});
		q('[data-nosheet]').addEventListener('change', all);
		q('[data-env-on]').addEventListener('change', all);
		all();
		// the sparks: 4 a second, each 0,08 s, the ring's spark with the vibrator's
		loop(fig, (dt) => {
			t += dt;
			const ph = (t * 4) % 1;
			const on = ph < 0.32;
			const k = Math.floor(t * 4);
			const X = xs(4);
			q('[data-vspark]').setAttribute('d', on ? spark(X, YC, 0.9, true, k) : '');
			const s = strength();
			const rxp = xs(x);
			q('[data-rspark]').setAttribute('d', on && s >= 0.05 ? spark(0, 0, Math.min(1, s), true, k + 3) : '');
			(q('[data-rspark]') as SVGElement).style.opacity = String(Math.min(1, 0.35 + s));
			void rxp;
			return true;
		});
	}
</script>
