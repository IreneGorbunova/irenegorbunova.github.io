---
/**
 * Styles shared by the pictures and models of «Электромагнитные волны. Свет как электромагнитная волна» (grade 9),
 * scoped under `.evs` (every figure of the chapter has it next to `g7`). Renders nothing.
 *
 * One color per quantity in the whole chapter, matching the electromagnetism chapters of grade 9 (B purple, current
 * green, force gold) and «Волны. Длина волны» (the direction in which a wave runs gold, λ green):
 *   the electric field, vector E — red (--evs-e = --ig-vy);
 *   the magnetic field, vector B — purple (--evs-b = --sl-color-purple, as in «Магнитное поле. Индукция»);
 *   the direction in which the wave runs (speed c) — gold (--ig-v);
 *   the wavelength λ — green (--g7-green);
 *   current in a wire or an antenna — green as well (it never stands in one figure with a λ bracket).
 * Colors of light itself (the visible spectrum) are physical colors, fixed hues that read on both backgrounds.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<style is:global>
	.evs {
		--evs-e: var(--ig-vy);
		--evs-b: var(--sl-color-purple);
		--evs-c: var(--ig-v);
		--evs-l: var(--g7-green);
	}
	.evs .g7__svg .arrow--e {
		stroke: var(--evs-e);
	}
	.evs .g7__svg .head--e {
		fill: var(--evs-e);
	}
	.evs .g7__svg .arrow--b {
		stroke: var(--evs-b);
	}
	.evs .g7__svg .head--b {
		fill: var(--evs-b);
	}
	.evs .g7__svg .t-e {
		fill: var(--evs-e);
	}
	.evs .g7__svg .t-b {
		fill: var(--evs-b);
	}
	.evs .g7__svg .t-c {
		fill: var(--evs-c);
	}
	.evs .g7__svg .t-l {
		fill: var(--evs-l);
	}
	.evs .evs-e-line {
		fill: none;
		stroke: var(--evs-e);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.evs .evs-b-line {
		fill: none;
		stroke: var(--evs-b);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.evs .evs-e-fill {
		fill: color-mix(in oklab, var(--evs-e) 16%, transparent);
	}
	.evs .evs-b-fill {
		fill: color-mix(in oklab, var(--evs-b) 16%, transparent);
	}
	.evs .evs-axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.evs .evs-axis-dash {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}
	.evs .evs-plane {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 35%, transparent);
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.evs .evs-lambda {
		fill: none;
		stroke: var(--evs-l);
		stroke-width: 1.6;
	}
	.evs .evs-lambda-guide {
		stroke: var(--evs-l);
		stroke-width: 1;
		stroke-dasharray: 3 3;
		opacity: 0.8;
	}
	.evs .evs-faint {
		fill: var(--sl-color-gray-3);
	}
	.evs .evs-ink {
		fill: var(--g7-ink);
	}
	.evs .evs-tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.evs .evs-check {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.evs .evs-check input {
		accent-color: var(--sl-color-accent);
		width: 1.05rem;
		height: 1.05rem;
		margin: 0;
	}
	/* a darkened room (prism, colors of bodies): fixed dark in both themes, so that white and colored light read */
	.evs .pr-bg {
		fill: hsl(232, 30%, 9%);
	}
	.evs .g7__svg .pr-t {
		font-size: 10px;
		fill: hsl(228, 15%, 72%);
	}
	.g7--pic.evs {
		margin-block: 1.5rem;
		padding: 0.75rem;
	}
	.g7--pic.evs .g7__grid {
		grid-template-columns: minmax(0, 1fr);
	}
	.evs .evs-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-top: 0.6rem;
	}
</style>
