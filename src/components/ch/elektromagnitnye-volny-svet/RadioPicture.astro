---
/**
 * «Радиосвязь» (picture, a looping animation). Two rows so that it reads at 390 px.
 * Top, the transmitter, left to right: a microphone (the voice makes a sound current) → the modulator, which a
 * generator of high-frequency oscillations under it feeds → the transmitting antenna on its tower, which sends waves
 * (arcs) to the right and down to the receiving antenna.
 * Bottom, the receiver, right to left: the receiving antenna → «настройка» (a dial: it picks one station) → the
 * detector (a diode symbol: it keeps the sound current) → the loudspeaker.
 * Small dots run along the arrows (1 dot per 0,6 с, 60 px/s) to show the way of the signal.
 * Under them three graphs on one time axis, sliding to the left at 30 px/s: the sound oscillations (a slow sine,
 * period 150 px), the high-frequency oscillations (constant amplitude, period 12,5 px: 12 times faster) and the
 * modulated oscillations (the fast sine whose amplitude follows the sound: (1 + 0,6·sin)·sin). The real ratio of the
 * frequencies is from about 1 : 1000 (long and medium waves) to millions (FM, TV); here it is 1 : 12. Neutral colors
 * (green for the sound, as current in this group of chapters; gray for the high frequency): no E or B is drawn here.
 */
import EvsStyles from './EvsStyles.astro';
---

<EvsStyles />
<figure class="g7 g7--pic evs not-content" data-evs-radio>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 320" role="img" aria-label="Схема радиосвязи. Передатчик: микрофон, модулятор, в который подаёт колебания генератор высокой частоты, передающая антенна. Радиоволны идут к приёмной антенне. Приёмник: настройка на станцию, детектор, громкоговоритель. Внизу три графика: звуковые, высокочастотные и модулированные колебания">
			<text class="t-small" x="8" y="13">передатчик</text>
			<!-- microphone -->
			<g transform="translate(30 50)">
				<path class="rd-arc" d="M-20 -10 q-5 10 0 20 M-26 -14 q-7 14 0 28"></path>
				<rect class="rd-dev" x="-6" y="-16" width="12" height="20" rx="6"></rect>
				<path class="rd-line" d="M-9 -4 q0 12 9 12 q9 0 9 -12 M0 8 V20 M-7 20 H7"></path>
			</g>
			<text class="rd-t" x="30" y="84" text-anchor="middle">микрофон</text>
			<!-- modulator and generator -->
			<rect class="rd-box" x="82" y="34" width="72" height="30" rx="5"></rect>
			<text class="rd-t" x="118" y="53" text-anchor="middle">модулятор</text>
			<rect class="rd-box" x="82" y="80" width="72" height="34" rx="5"></rect>
			<text class="rd-t" x="118" y="94" text-anchor="middle">генератор</text>
			<text class="rd-t" x="118" y="106" text-anchor="middle">высокой частоты</text>
			<path class="rd-flow" d="M44 49 H80 M118 78 V66 M156 49 H198"></path>
			<path class="rd-head" d="M80 49 l-6 -3.2 v6.4 Z M118 66 l-3.2 6 h6.4 Z M198 49 l-6 -3.2 v6.4 Z"></path>
			<!-- the transmitting tower -->
			<g transform="translate(214 0)">
				<path class="rd-tower" d="M-12 112 L0 22 L12 112 M-9 90 H9 M-6 66 H6 M-3.5 44 H3.5 M-9 90 L6 66 M9 90 L-6 66 M-6 66 L3.5 44 M6 66 L-3.5 44"></path>
				<circle class="rd-tip" cx="0" cy="20" r="3"></circle>
			</g>
			<path class="rd-flow" d="M198 49 H209"></path>
			<text class="rd-t" x="214" y="126" text-anchor="middle">передающая антенна</text>
			<g data-waves></g>
			<!-- the receiver -->
			<text class="t-small" x="8" y="148">приёмник</text>
			<g transform="translate(322 0)">
				<path class="rd-mast" d="M0 220 V150 M-8 150 H8"></path>
				<circle class="rd-tip" cx="0" cy="150" r="2.4"></circle>
			</g>
			<text class="rd-t" x="322" y="234" text-anchor="middle">приёмная</text>
			<text class="rd-t" x="322" y="245" text-anchor="middle">антенна</text>
			<rect class="rd-box" x="212" y="176" width="88" height="34" rx="5"></rect>
			<circle class="rd-dial" cx="227" cy="193" r="9"></circle>
			<path class="rd-line" d="" data-needle></path>
			<text class="rd-t" x="267" y="196" text-anchor="middle">настройка</text>
			<rect class="rd-box" x="104" y="176" width="88" height="34" rx="5"></rect>
			<path class="rd-line" d="M110 193 H118 M118 186 V200 L128 193 Z M128 186 V200 M128 193 H134"></path>
			<text class="rd-t" x="162" y="196" text-anchor="middle">детектор</text>
			<g transform="translate(40 193)">
				<path class="rd-dev" d="M-14 -7 H-6 L4 -15 V15 L-6 7 H-14 Z"></path>
				<path class="rd-arc" d="M-22 -8 q-5 8 0 16 M-29 -13 q-7 13 0 26" transform="scale(-1 1)"></path>
			</g>
			<text class="rd-t" x="40" y="226" text-anchor="start" dx="-32">громкоговоритель</text>
			<path class="rd-flow" d="M318 193 H302 M210 193 H194 M102 193 H86"></path>
			<path class="rd-head" d="M302 193 l6 -3.2 v6.4 Z M194 193 l6 -3.2 v6.4 Z M86 193 l6 -3.2 v6.4 Z"></path>
			<g data-dots></g>
			<!-- the graphs -->
			<g data-graphs></g>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Звуковые колебания меняют амплитуду быстрых колебаний генератора — антенна излучает модулированную волну.
		В приёмнике детектор снова выделяет звуковые колебания. На графиках быстрые колебания всего в 12 раз чаще
		звуковых; на самом деле — в тысячи и даже миллионы раз.
	</figcaption>
</figure>

<style is:global>
	.evs .rd-box {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
	}
	.evs .g7__svg .rd-t {
		font-size: 9.5px;
		fill: var(--sl-color-gray-1);
	}
	.evs .rd-dev {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.evs .rd-line,
	.evs .rd-tower,
	.evs .rd-mast {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.evs .rd-tower {
		stroke: var(--g7-steel);
		stroke-width: 1.4;
	}
	.evs .rd-mast {
		stroke: var(--g7-steel);
		stroke-width: 2;
	}
	.evs .rd-tip {
		fill: var(--g7-steel);
	}
	.evs .rd-dial {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.evs .rd-arc {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-linecap: round;
	}
	.evs .rd-flow {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.evs .rd-head {
		fill: var(--sl-color-gray-3);
	}
	.evs .rd-dot {
		fill: var(--g7-green);
	}
	.evs .rd-wave {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.3;
	}
	.evs .rd-g-sound {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.6;
	}
	.evs .rd-g-hf {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.1;
	}
	.evs .rd-g-env {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 0.9;
		stroke-dasharray: 3 3;
		opacity: 0.8;
	}
</style>

<script>
	import { el, loop } from './evs';
	const f = (v: number) => v.toFixed(1);
	const GX = 112;
	const GW = 240;
	const TS = 150;
	const TC = TS / 12;
	const V = 30;
	const rows = [
		{ y: 268, label: ['звуковые', 'колебания'], kind: 'sound' },
		{ y: 293, label: ['высокочастотные', 'колебания'], kind: 'hf' },
		{ y: 318, label: ['модулированные', 'колебания'], kind: 'mod' },
	];
	for (const fig of document.querySelectorAll<HTMLElement>('[data-evs-radio]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const gg = q('[data-graphs]');
		// graph frames: each 16 px tall, centered on y − 8
		const H = 6.5;
		const paths = rows.map((r) => {
			const yc = r.y - 9;
			gg.append(el('path', { class: 'evs-axis-dash', d: `M${GX} ${yc} H${GX + GW}` }));
			const lab = el('text', { class: 'rd-t', x: GX - 6, y: yc - 2, 'text-anchor': 'end' });
			lab.textContent = r.label[0];
			const lab2 = el('text', { class: 'rd-t', x: GX - 6, y: yc + 8, 'text-anchor': 'end' });
			lab2.textContent = r.label[1];
			gg.append(lab, lab2);
			const p = el('path', { class: r.kind === 'sound' ? 'rd-g-sound' : 'rd-g-hf' });
			const env = el('path', { class: 'rd-g-env' });
			gg.append(env, p);
			return { ...r, yc, p, env };
		});
		const dots = q('[data-dots]');
		const ROUTE: [number, number][][] = [
			[
				[44, 49],
				[80, 49],
			],
			[
				[156, 49],
				[209, 49],
			],
			[
				[318, 193],
				[302, 193],
			],
			[
				[210, 193],
				[194, 193],
			],
			[
				[102, 193],
				[86, 193],
			],
		];
		const dotEls = ROUTE.map(() => Array.from({ length: 2 }, () => {
			const c = el('circle', { class: 'rd-dot', r: 2.2 });
			dots.append(c);
			return c;
		}));
		const waves = q('[data-waves]');
		const wEls = Array.from({ length: 4 }, () => {
			const p = el('path', { class: 'rd-wave' });
			waves.append(p);
			return p;
		});
		let t = 0;
		const draw = () => {
			for (const r of paths) {
				let d = '';
				let e = '';
				for (let x = 0; x <= GW; x += 1) {
					const tt = x + V * t; // the graphs slide left
					const s = Math.sin((2 * Math.PI * tt) / TS);
					const c = Math.sin((2 * Math.PI * tt) / TC);
					const y = r.kind === 'sound' ? s : r.kind === 'hf' ? c * 0.85 : (1 + 0.6 * s) * c * 0.55;
					d += `${x ? 'L' : 'M'}${f(GX + x)} ${f(r.yc - H * y)}`;
					if (r.kind === 'mod') e += `${x ? 'L' : 'M'}${f(GX + x)} ${f(r.yc - H * 0.55 * (1 + 0.6 * s))}`;
				}
				r.p.setAttribute('d', d);
				if (r.kind === 'mod') r.env.setAttribute('d', e);
			}
			ROUTE.forEach((seg, i) => {
				const [[x1, y1], [x2, y2]] = seg;
				const L = Math.hypot(x2 - x1, y2 - y1);
				dotEls[i].forEach((c, j) => {
					const u = ((t * 60 + j * 36) % 72) / L;
					const on = u <= 1;
					c.setAttribute('cx', f(x1 + (x2 - x1) * Math.min(u, 1)));
					c.setAttribute('cy', f(y1 + (y2 - y1) * Math.min(u, 1)));
					c.style.opacity = on ? '1' : '0';
				});
			});
			// arcs from the top of the tower (214, 20) spreading to the right and down toward the receiving antenna
			wEls.forEach((p, i) => {
				const r = ((t * 40 + i * 30) % 120) + 8;
				const a0 = -0.45;
				const a1 = 1.1;
				const P = (a: number) => `${f(214 + r * Math.cos(a))} ${f(20 + r * Math.sin(a))}`;
				p.setAttribute('d', `M${P(a0)} A${f(r)} ${f(r)} 0 0 1 ${P(a1)}`);
				p.style.opacity = String(0.9 * (1 - (r - 8) / 120));
			});
			q('[data-needle]').setAttribute('d', `M227 193 L${f(227 + 7 * Math.cos(-0.9))} ${f(193 + 7 * Math.sin(-0.9))}`);
		};
		draw();
		loop(fig, (dt) => {
			t += dt;
			draw();
			return true;
		});
	}
</script>
