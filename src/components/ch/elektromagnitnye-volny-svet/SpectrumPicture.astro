---
/**
 * «Видимый свет» (static picture). The visible band from 760 нм (left) to 380 нм (right) as a strip of real colors,
 * linear in λ, 0,684 px per нм (the same orientation as the scale of the chapter: long waves on the left). Above it the
 * seven color names in their ranges (the table of the chapter: красный 760–620, оранжевый 620–590, жёлтый 590–560,
 * зелёный 560–500, голубой 500–480, синий 480–450, фиолетовый 450–380 нм) with the boundaries as thin ticks on the
 * strip; under it the axis of λ (400, 500, 600, 700 нм) and the axis of the frequency ν = c/λ (c = 3·10⁸ м/с) with
 * 7,5; 6; 5; 4,3·10¹⁴ Гц at λ = 400, 500, 600, 698 нм. Beyond each end a gray strip: infrared on the left, ultraviolet
 * on the right — the eye does not see them. The colors are physical colors (fixed in both themes), dimmed toward the
 * ends of the band where the eye is less sensitive.
 */
import EvsStyles from './EvsStyles.astro';
const X1 = 50;
const X2 = 310;
const X = (nm: number) => X1 + ((760 - nm) / 380) * (X2 - X1);
// [name, from, to, where the label stands (нм, inside the range)]
const names: [string, number, number, number][] = [
	['красный', 760, 620, 690],
	['оранжевый', 620, 590, 610],
	['жёлтый', 590, 560, 575],
	['зелёный', 560, 500, 528],
	['голубой', 500, 480, 492],
	['синий', 480, 450, 465],
	['фиолетовый', 450, 380, 400],
];
const bounds = [620, 590, 560, 500, 480, 450];
const nus: [string, number][] = [
	['4,3', 3e8 / 4.3e14 * 1e9],
	['5', 600],
	['6', 500],
	['7,5', 400],
];
const uid = Math.random().toString(36).slice(2, 8);
---

<EvsStyles />
<figure class="g7 g7--pic evs not-content" data-evs-spectrum>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 132" role="img" aria-label="Видимый свет: полоска цветов от красного (760 нанометров) до фиолетового (380 нанометров): красный, оранжевый, жёлтый, зелёный, голубой, синий, фиолетовый. Под ней шкалы длины волны и частоты. По краям серые полосы инфракрасного и ультрафиолетового излучения, которых глаз не видит">
			<defs>
				<linearGradient id={`evs-spp-${uid}`} x1="0" y1="0" x2="1" y2="0" data-grad></linearGradient>
				<linearGradient id={`evs-ir-${uid}`} x1="0" y1="0" x2="1" y2="0">
					<stop offset="0" class="evs-gray-stop" stop-opacity="0"></stop>
					<stop offset="1" class="evs-gray-stop" stop-opacity="1"></stop>
				</linearGradient>
				<linearGradient id={`evs-uv-${uid}`} x1="0" y1="0" x2="1" y2="0">
					<stop offset="0" class="evs-gray-stop" stop-opacity="1"></stop>
					<stop offset="1" class="evs-gray-stop" stop-opacity="0"></stop>
				</linearGradient>
			</defs>
			{
				names.map(([n, , , at], i) => (
					<text class="evs-cname" x={X(at).toFixed(1)} y={i % 2 ? 30 : 16} text-anchor="middle">
						{n}
					</text>
				))
			}
			<rect x="4" y="38" width={X1 - 7} height="24" fill={`url(#evs-ir-${uid})`}></rect>
			<rect x={X2 + 3} y="38" width={356 - X2 - 3} height="24" fill={`url(#evs-uv-${uid})`}></rect>
			<rect x={X1} y="38" width={X2 - X1} height="24" fill={`url(#evs-spp-${uid})`}></rect>
			{bounds.map((nm) => <path class="evs-bound" d={`M${X(nm).toFixed(1)} 38 V62`} />)}
			<text class="t-small" x="24" y="76" text-anchor="middle">инфра-</text>
			<text class="t-small" x="24" y="87" text-anchor="middle">красное</text>
			<text class="t-small" x={(X2 + 358) / 2} y="76" text-anchor="middle">ультра-</text>
			<text class="t-small" x={(X2 + 358) / 2} y="87" text-anchor="middle">фиолет</text>
			<!-- λ -->
			<path class="evs-axis" d={`M${X1} 66 H${X2}`} />
			{
				[700, 600, 500, 400].map((nm) => (
					<g>
						<path class="evs-tick" d={`M${X(nm)} 66 V71`} />
						<text class="t-small" x={X(nm)} y="81" text-anchor="middle">
							{nm}
						</text>
					</g>
				))
			}
			<text class="t-small" x="180" y="94" text-anchor="middle">длина волны <tspan class="t-i">λ</tspan>, нм</text>
			<!-- ν -->
			<path class="evs-axis" d={`M${X1} 102 H${X2}`} />
			{
				nus.map(([t, nm]) => (
					<g>
						<path class="evs-tick" d={`M${X(nm).toFixed(1)} 102 V107`} />
						<text class="t-small" x={X(nm).toFixed(1)} y="117" text-anchor="middle">
							{t}
						</text>
					</g>
				))
			}
			<text class="t-small" x="180" y="129" text-anchor="middle">частота <tspan class="t-i">ν</tspan>, 10¹⁴ Гц</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Видимый свет — от красного (самые длинные волны, 760&nbsp;нм) до фиолетового (самые короткие, 380&nbsp;нм).
		Границы цветов приблизительные. Серые полосы по краям — инфракрасное и ультрафиолетовое излучение: глаз их не видит.
	</figcaption>
</figure>

<style is:global>
	.evs .g7__svg .evs-cname {
		font-size: 10px;
		fill: var(--sl-color-gray-1);
	}
	.evs .evs-bound {
		stroke: var(--g7-paper);
		stroke-width: 0.7;
		opacity: 0.55;
	}
	.evs .evs-gray-stop {
		stop-color: var(--sl-color-gray-4);
	}
</style>

<script>
	import { el, spectral } from './evs';
	for (const fig of document.querySelectorAll<HTMLElement>('[data-evs-spectrum]')) {
		const grad = fig.querySelector('[data-grad]')!;
		for (let i = 0; i <= 76; i++) grad.append(el('stop', { offset: (i / 76).toFixed(3), 'stop-color': spectral(760 - i * 5) }));
	}
</script>
