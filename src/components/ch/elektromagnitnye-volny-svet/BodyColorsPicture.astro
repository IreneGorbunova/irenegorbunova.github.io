---
/**
 * «Цвета тел» (picture, a looping animation, 8 с). A dark room: a lamp at the top left, a table with a red apple, a
 * green leaf and a sheet of white paper, an eye on the right. The lamp's light changes every 2 с: white → red →
 * green → blue. White light is drawn as three arrows (red, green, blue: the three parts the eye mixes into white);
 * a colored light as one arrow of its color. Each body sends to the eye only what it reflects, in the simplest model:
 * the apple reflects red, the leaf green, the paper all colors. A body looks the color of the light it reflects, and
 * black when it reflects nothing: in white light — red, green, white; in red — red, black, red; in green — black,
 * green, green; in blue — black, black, blue. The room is dark in both themes (a fixed dark panel, so the light
 * reads); the colors are physical colors.
 */
import EvsStyles from './EvsStyles.astro';
---

<EvsStyles />
<figure class="g7 g7--pic evs not-content" data-evs-bodies>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 210" role="img" aria-label="Лампа по очереди светит белым, красным, зелёным и синим светом на красное яблоко, зелёный лист и белую бумагу. К глазу идёт только отражённый свет: в красном свете лист кажется чёрным, в зелёном — яблоко, в синем — и яблоко, и лист, а бумага каждый раз принимает цвет лампы">
			<rect class="pr-bg" x="0" y="0" width="360" height="210" rx="8"></rect>
			<!-- the lamp -->
			<path class="bc-cord" d="M46 0 V14"></path>
			<path class="bc-shade" d="M30 30 L38 14 H54 L62 30 Z"></path>
			<ellipse class="bc-bulb" cx="46" cy="31" rx="7" ry="4" data-bulb></ellipse>
			<text class="pr-t" x="70" y="18" data-lamp>свет лампы: белый</text>
			<!-- the table -->
			<rect class="bc-table" x="88" y="158" width="244" height="7" rx="2"></rect>
			<rect class="bc-table" x="98" y="165" width="6" height="40"></rect>
			<rect class="bc-table" x="316" y="165" width="6" height="40"></rect>
			<!-- the apple -->
			<path class="bc-body" data-apple d="M130 158 C112 158 108 140 114 130 C119 122 127 123 130 127 C133 123 141 122 146 130 C152 140 148 158 130 158 Z"></path>
			<path class="bc-stem" d="M130 127 q1 -7 4 -10"></path>
			<!-- the leaf -->
			<path class="bc-body" data-leaf d="M182 156 C188 138 214 132 232 138 C222 154 200 160 182 156 Z"></path>
			<path class="bc-vein" d="M184 155 Q206 146 230 139"></path>
			<!-- the paper -->
			<path class="bc-body" data-paper d="M252 158 L262 148 H312 L302 158 Z"></path>
			<text class="pr-t" x="130" y="178" text-anchor="middle">яблоко</text>
			<text class="pr-t" x="207" y="178" text-anchor="middle">лист</text>
			<text class="pr-t" x="282" y="178" text-anchor="middle">бумага</text>
			<!-- the eye -->
			<g transform="translate(336 64)">
				<path class="bc-eye" d="M14 0 Q0 -11 -12 0 Q0 11 14 0 Z"></path>
				<circle class="bc-iris" cx="-4" cy="0" r="4.6"></circle>
				<circle cx="-5" cy="0" r="2" fill="hsl(230, 30%, 6%)"></circle>
			</g>
			<text class="pr-t" x="336" y="88" text-anchor="middle">глаз</text>
			<g data-rays></g>
		</svg>
	</div>
	<figcaption class="g7__caption">
		К глазу идёт только отражённый свет. Яблоко отражает красный, лист — зелёный, белая бумага — все цвета; тело,
		которое ничего не отражает, кажется чёрным. Белый свет нарисован тремя стрелками — красной, зелёной и синей.
	</figcaption>
</figure>

<style is:global>
	.evs .bc-cord {
		stroke: hsl(228, 10%, 45%);
		stroke-width: 1.2;
	}
	.evs .bc-shade {
		fill: hsl(228, 12%, 30%);
		stroke: hsl(228, 12%, 55%);
		stroke-width: 0.8;
	}
	.evs .bc-table {
		fill: hsl(30, 25%, 22%);
	}
	.evs .bc-body {
		stroke: hsl(228, 10%, 30%);
		stroke-width: 0.8;
		transition: fill 0.35s;
	}
	.evs .bc-stem {
		fill: none;
		stroke: hsl(30, 40%, 28%);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.evs .bc-vein {
		fill: none;
		stroke: hsla(0, 0%, 0%, 0.35);
		stroke-width: 0.8;
	}
	.evs .bc-eye {
		fill: hsl(0, 0%, 92%);
		stroke: hsl(228, 10%, 60%);
		stroke-width: 0.8;
	}
	.evs .bc-iris {
		fill: hsl(200, 45%, 45%);
	}
</style>

<script>
	import { el, loop } from './evs';
	const f = (v: number) => v.toFixed(1);
	const RGB = ['rgb(255, 70, 70)', 'rgb(70, 225, 100)', 'rgb(90, 130, 255)'];
	const LIGHTS: { name: string; c: number[] }[] = [
		{ name: 'белый', c: [1, 1, 1] },
		{ name: 'красный', c: [1, 0, 0] },
		{ name: 'зелёный', c: [0, 1, 0] },
		{ name: 'синий', c: [0, 0, 1] },
	];
	// what each body reflects (red, green, blue) and where light falls on it
	const BODIES = [
		{ sel: '[data-apple]', r: [0.9, 0.08, 0.08], at: [130, 126] },
		{ sel: '[data-leaf]', r: [0.08, 0.75, 0.12], at: [207, 141] },
		{ sel: '[data-paper]', r: [0.92, 0.92, 0.92], at: [284, 150] },
	];
	const LAMP = [46, 34];
	const EYE = [324, 64];
	const color = (k: number[]) => {
		const c = k.map((v) => Math.round(28 + 227 * v));
		return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
	};
	for (const fig of document.querySelectorAll<HTMLElement>('[data-evs-bodies]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const g = q('[data-rays]');
		const arrow = (x1: number, y1: number, x2: number, y2: number, c: string, off: number) => {
			const L = Math.hypot(x2 - x1, y2 - y1);
			const ux = (x2 - x1) / L;
			const uy = (y2 - y1) / L;
			const nx = -uy * off;
			const ny = ux * off;
			const a = [x1 + ux * 6 + nx, y1 + uy * 6 + ny];
			const b = [x2 - ux * 5 + nx, y2 - uy * 5 + ny];
			const h = 6;
			const bx = b[0] - ux * h;
			const by = b[1] - uy * h;
			g.append(
				el('path', { d: `M${f(a[0])} ${f(a[1])} L${f(bx)} ${f(by)}`, stroke: c, 'stroke-width': 1.4, fill: 'none' }),
				el('path', { d: `M${f(b[0])} ${f(b[1])} L${f(bx - uy * 2.8)} ${f(by + ux * 2.8)} L${f(bx + uy * 2.8)} ${f(by - ux * 2.8)} Z`, fill: c }),
			);
		};
		let cur = -1;
		const show = (i: number) => {
			const L = LIGHTS[i];
			g.replaceChildren();
			q('[data-lamp]').textContent = `свет лампы: ${L.name}`;
			q('[data-bulb]').setAttribute('fill', color(L.c));
			const on = [0, 1, 2].filter((j) => L.c[j] > 0);
			for (const b of BODIES) {
				const seen = b.r.map((r, j) => r * L.c[j]);
				q(b.sel).setAttribute('fill', color(seen));
				on.forEach((j, n) => arrow(LAMP[0], LAMP[1], b.at[0], b.at[1], RGB[j], (n - (on.length - 1) / 2) * 3.2));
				const back = [0, 1, 2].filter((j) => b.r[j] * L.c[j] > 0.5);
				back.forEach((j, n) => arrow(b.at[0], b.at[1], EYE[0], EYE[1], RGB[j], (n - (back.length - 1) / 2) * 3.2));
			}
		};
		let t = 0;
		show(0);
		loop(fig, (dt) => {
			t = (t + dt) % 8;
			const i = Math.floor(t / 2);
			if (i !== cur) {
				cur = i;
				show(i);
			}
			return true;
		});
	}
</script>
