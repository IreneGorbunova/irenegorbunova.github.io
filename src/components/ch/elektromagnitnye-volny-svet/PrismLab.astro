---
/**
 * «Призма Ньютона» (model). A narrow beam from a slit falls on an equilateral glass prism (apex 60°, side 96 px, base
 * horizontal) at the angle of incidence 50°; behind it a screen. Every ray is traced exactly in the picture plane:
 * Snell's law in vector form at each face (n_air = 1), angles true. Glass: n(λ) = A + B/λ², λ in мкм:
 *   крон (like BK7):  A = 1,5046, B = 0,00420 → n(700) = 1,5132, n(530) = 1,5196, n(400) = 1,5308;
 *   флинт (like F2):  A = 1,5943, B = 0,00892 → n(700) = 1,6125, n(530) = 1,6261, n(400) = 1,6501.
 * Deviation δ = i₁ + e₂ − 60° (checked against the outline): крон 38,34° / 38,89° / 39,89° (700 / 530 / 400 нм),
 * флинт 47,76° / 49,22° / 51,96°; white light 380–760 нм: крон 40,14–38,23°, флинт 52,69–47,47°.
 * Light: белый (21 rays, 380…760 нм every 19 нм, drawn in their colors and added up, so where they overlap they look
 * white) or one color behind a filter: красный 700 нм, зелёный 530 нм, фиолетовый 400 нм.
 * «Вторая призма» (Newton's experiment): the same prism turned over (the point reflection of the first one in the
 * middle of its exit face, moved 4 px away), so the two make a parallel plate: every color leaves parallel to the
 * incident beam and the colors gather into a white beam again; one color is only shifted, no new colors appear.
 * The colors on the screen are 1,5–5° apart, a few pixels at this distance, so the screen is shown enlarged 8 times
 * in the panel «На экране», a vertical strip with the top of the screen on top. The beam is taken 1,8 px wide (about 1 мм if the
 * prism's side is 5 см): each color is a band 14,4 px tall there, and the bands add up (screen blending), so with the second prism, where the colors
 * are shifted by less than a beam width, the spot is white with thin colored edges. «Показать нормали»: dashed normals at the points where the green (or the only) ray enters
 * and leaves the glass. The room is dark (a fixed dark panel in both themes, so that white and colored light read).
 */
import EvsStyles from './EvsStyles.astro';
const uid = Math.random().toString(36).slice(2, 8);
---

<EvsStyles />
<figure class="g7 g7--stack evs not-content" data-evs-prism>
	<div class="g7__grid">
		<svg class="g7__svg pr-room" viewBox="0 0 360 220" role="img" aria-label="Узкий пучок света из щели падает на стеклянную призму; за призмой экран. Белый свет призма разлагает на цвета: фиолетовый отклоняется сильнее всех, красный слабее всех. Вторая, перевёрнутая призма снова собирает цвета в белый пучок">
			<rect class="pr-bg" x="0" y="0" width="360" height="220" rx="8"></rect>
			<!-- the lamp with a slit -->
			<rect class="pr-lamp" x="4" y="112" width="26" height="34" rx="3"></rect>
			<rect class="pr-slit" x="29" y="125" width="5" height="8" rx="1"></rect>
			<rect class="pr-filter" x="35" y="118" width="5" height="22" rx="1" data-filter></rect>
			<text class="pr-t" x="17" y="160" text-anchor="middle">щель</text>
			<!-- the screen -->
			<rect class="pr-screen" x="334" y="18" width="8" height="196" rx="1.5"></rect>
			<text class="pr-t" x="330" y="14" text-anchor="end">экран</text>
			<g data-rays></g>
			<path class="pr-glass" data-p1></path>
			<path class="pr-glass" data-p2></path>
			<g data-spots></g>
			<path class="pr-normal" data-normals></path>
		</svg>
		<div class="g7__side">
			<div class="g7__row">
				<span class="g7__label">Свет:</span>
				<div class="g7__seg" data-light>
					<button type="button" class="g7__btn" aria-pressed="true" data-l="0">белый</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-l="700">красный</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-l="530">зелёный</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-l="400">фиолетовый</button>
				</div>
			</div>
			<div class="g7__row">
				<span class="g7__label">Стекло:</span>
				<div class="g7__seg" data-glass>
					<button type="button" class="g7__btn" aria-pressed="true" data-g="crown">крон</button>
					<button type="button" class="g7__btn" aria-pressed="false" data-g="flint">флинт</button>
				</div>
			</div>
			<label class="evs-check"><input type="checkbox" data-second /> Вторая призма</label>
			<label class="evs-check"><input type="checkbox" data-norm /> Показать нормали</label>
			<ul class="g7__read" data-read></ul>
			<div class="pr-zoom">
				<svg viewBox="0 0 60 164" class="pr-zoom__svg" aria-hidden="true">
					<defs><clipPath id={`pr-zc-${uid}`}><rect x="20" y="4" width="20" height="156" rx="1.5"></rect></clipPath></defs>
					<rect class="pr-bg" x="0" y="0" width="60" height="164" rx="5"></rect>
					<rect class="pr-screen" x="20" y="4" width="20" height="156" rx="1.5"></rect>
					<g data-zoom clip-path={`url(#pr-zc-${uid})`}></g>
				</svg>
				<p class="g7__note">На экране, увеличено в 8 раз. Пучок света имеет ширину, поэтому соседние цвета на краях пятна перекрываются.</p>
			</div>
		</div>
	</div>
	<figcaption class="g7__caption">
		Пучок падает на грань призмы под углом 50°. Ход лучей рассчитан по закону преломления, углы на рисунке
		настоящие. Цвета на экране расходятся всего на несколько градусов, поэтому экран показан ещё и увеличенным.
	</figcaption>
</figure>

<style is:global>
	.evs .pr-lamp {
		fill: hsl(228, 12%, 30%);
		stroke: hsl(228, 12%, 55%);
		stroke-width: 0.8;
	}
	.evs .pr-slit {
		fill: hsl(50, 100%, 92%);
	}
	.evs .pr-filter {
		fill: transparent;
		stroke: hsl(228, 12%, 55%);
		stroke-width: 0.6;
	}
	.evs .pr-screen {
		fill: hsl(228, 10%, 26%);
		stroke: hsl(228, 10%, 45%);
		stroke-width: 0.6;
	}
	.evs .pr-glass {
		fill: hsla(195, 60%, 75%, 0.14);
		stroke: hsla(195, 70%, 85%, 0.8);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.evs .pr-normal {
		fill: none;
		stroke: hsl(228, 15%, 70%);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
	}
	@container (min-width: 44rem) {
		.g7--stack.evs[data-evs-prism] .g7__side {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			column-gap: 1.25rem;
		}
	}
	/* colored light adds up: every ray, spot and band is blended on its own */
	.evs [data-rays] > *,
	.evs [data-spots] > *,
	.evs [data-zoom] > * {
		mix-blend-mode: screen;
	}
	.evs .pr-zoom {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 0.75rem;
		align-items: center;
	}
	.evs .pr-zoom__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}
</style>

<script>
	import { spectral, fmt } from './evs';
	import { el } from '../g7/kit';

	type P = { x: number; y: number };
	const GLASS = { crown: [1.5046, 0.0042], flint: [1.5943, 0.00892] } as const;
	const D2R = Math.PI / 180;
	const nOf = (g: keyof typeof GLASS, nm: number) => GLASS[g][0] + GLASS[g][1] / (nm / 1000) ** 2;
	// the first prism: base horizontal, apex up
	const BL: P = { x: 108, y: 140 };
	const BR: P = { x: 204, y: 140 };
	const AP: P = { x: 156, y: 140 - 96 * Math.sin(60 * D2R) };
	// the incident beam: 50° to the normal of the left face, i.e. 20° above the horizontal (screen y down)
	const D0: P = { x: Math.cos(20 * D2R), y: -Math.sin(20 * D2R) };
	const F: P = { x: BL.x + 0.5 * (AP.x - BL.x), y: BL.y + 0.5 * (AP.y - BL.y) };
	const S: P = { x: F.x - 112 * D0.x, y: F.y - 112 * D0.y };
	const XSCR = 334;
	// the second prism: the point reflection of the first in the middle of the exit face, moved 4 px out of it
	const M: P = { x: (AP.x + BR.x) / 2, y: (AP.y + BR.y) / 2 };
	// the outward normal of the face AP→BR (pointing right and up): turn the face direction by −90° on screen
	const fd = { x: BR.x - AP.x, y: BR.y - AP.y };
	const fl = Math.hypot(fd.x, fd.y);
	const ON: P = { x: -fd.y / fl, y: fd.x / fl };
	const out = ON.x > 0 ? ON : { x: -ON.x, y: -ON.y };
	const sh = (p: P): P => ({ x: 2 * M.x - p.x + 4 * out.x, y: 2 * M.y - p.y + 4 * out.y });
	const PR1 = [BL, AP, BR];
	const PR2 = [sh(BR), sh(AP), sh(BL)];

	const sub = (a: P, b: P): P => ({ x: a.x - b.x, y: a.y - b.y });
	const cross = (a: P, b: P) => a.x * b.y - a.y * b.x;
	const dot = (a: P, b: P) => a.x * b.x + a.y * b.y;

	/** Traces a ray through the prisms; returns the points of the path and the final direction. */
	const trace = (n: number, prisms: P[][]) => {
		let p = S;
		let d = D0;
		let inside = -1;
		const pts: P[] = [p];
		const hits: { at: P; nrm: P }[] = [];
		for (let step = 0; step < 8; step++) {
			let best = Infinity;
			let bk = -1;
			let bn: P = { x: 0, y: 0 };
			prisms.forEach((poly, k) => {
				for (let i = 0; i < 3; i++) {
					const a = poly[i];
					const b = poly[(i + 1) % 3];
					const e = sub(b, a);
					const den = cross(d, e);
					if (Math.abs(den) < 1e-12) continue;
					const w = sub(a, p);
					const t = cross(w, e) / den;
					const u = cross(w, d) / den;
					if (t > 1e-6 && u >= 0 && u <= 1 && t < best) {
						best = t;
						bk = k;
						const l = Math.hypot(e.x, e.y);
						bn = { x: -e.y / l, y: e.x / l };
					}
				}
			});
			if (bk < 0) break;
			p = { x: p.x + d.x * best, y: p.y + d.y * best };
			pts.push(p);
			// the normal against the ray
			if (dot(bn, d) > 0) bn = { x: -bn.x, y: -bn.y };
			hits.push({ at: p, nrm: bn });
			const n1 = inside >= 0 ? n : 1;
			const n2 = inside >= 0 ? 1 : n;
			const eta = n1 / n2;
			const cosi = -dot(bn, d);
			const kk = 1 - eta * eta * (1 - cosi * cosi);
			if (kk < 0) {
				d = { x: d.x + 2 * cosi * bn.x, y: d.y + 2 * cosi * bn.y };
				continue;
			}
			const c2 = Math.sqrt(kk);
			d = { x: eta * d.x + (eta * cosi - c2) * bn.x, y: eta * d.y + (eta * cosi - c2) * bn.y };
			inside = inside >= 0 ? -1 : bk;
		}
		// on to the screen
		const t = (XSCR - p.x) / d.x;
		const end = { x: XSCR, y: p.y + d.y * t };
		pts.push(end);
		const dev = (Math.atan2(-D0.y, D0.x) - Math.atan2(-d.y, d.x)) / D2R;
		return { pts, end, dev, hits };
	};

	const deg = (v: number) => `${fmt(v, 2)}°`;

	for (const fig of document.querySelectorAll<HTMLElement>('[data-evs-prism]')) {
		const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		let light = 0;
		let glass: keyof typeof GLASS = 'crown';
		const poly = (pp: P[]) => `M${pp.map((p) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' L')} Z`;
		q('[data-p1]').setAttribute('d', poly(PR1));
		q('[data-p2]').setAttribute('d', poly(PR2));
		const draw = () => {
			const second = q<HTMLInputElement>('[data-second]').checked;
			(q('[data-p2]') as SVGElement).style.display = second ? '' : 'none';
			const prisms = second ? [PR1, PR2] : [PR1];
			const nms = light ? [light] : Array.from({ length: 21 }, (_, i) => 760 - i * 19);
			const rays = q('[data-rays]');
			const spots = q('[data-spots]');
			const zoom = q('[data-zoom]');
			rays.replaceChildren();
			spots.replaceChildren();
			zoom.replaceChildren();
			const res = nms.map((nm) => ({ nm, ...trace(nOf(glass, nm), prisms) }));
			const w = light ? 1.8 : 1.1;
			const op = light ? 1 : 0.55;
			// the incident beam: white, or the filter's color
			rays.append(el('path', { d: `M${S.x.toFixed(1)} ${S.y.toFixed(1)} L${res[0].pts[1].x.toFixed(1)} ${res[0].pts[1].y.toFixed(1)}`, stroke: light ? spectral(light) : 'hsl(50, 100%, 96%)', 'stroke-width': 1.8, fill: 'none' }));
			for (const r of res) {
				const d = r.pts.slice(1).map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join('');
				rays.append(el('path', { d, stroke: spectral(r.nm), 'stroke-width': w, 'stroke-opacity': op, fill: 'none', 'stroke-linejoin': 'round' }));
				spots.append(el('ellipse', { cx: XSCR + 3, cy: r.end.y.toFixed(1), rx: 3, ry: light ? 2.2 : 1.6, fill: spectral(r.nm), opacity: light ? 1 : 0.8 }));
			}
			// the enlarged screen: 8 times about the hit of 530 нм (without the second prism) or the beam itself
			// the enlarged screen, 8 times, centered between the hits of 700 and 400 нм; the beam is 1,8 px wide (14,4 px
			// enlarged), so where the colors meet they overlap and add up (white where all of them meet)
			const ref = (trace(nOf(glass, 700), prisms).end.y + trace(nOf(glass, 400), prisms).end.y) / 2;
			for (const r of res) {
				const zy = 82 + 8 * (r.end.y - ref);
				zoom.append(el('rect', { x: 20, y: (zy - 7.2).toFixed(1), width: 20, height: 14.4, fill: spectral(r.nm), opacity: light ? 1 : 0.8 }));
			}
			q('[data-filter]').setAttribute('fill', light ? spectral(light) : 'transparent');
			// normals at the entry and exit points of the middle ray
			const mid = light ? res[0] : trace(nOf(glass, 530), prisms);
			let nd = '';
			if (q<HTMLInputElement>('[data-norm]').checked)
				for (const h of mid.hits) nd += `M${(h.at.x - 22 * h.nrm.x).toFixed(1)} ${(h.at.y - 22 * h.nrm.y).toFixed(1)} L${(h.at.x + 22 * h.nrm.x).toFixed(1)} ${(h.at.y + 22 * h.nrm.y).toFixed(1)}`;
			q('[data-normals]').setAttribute('d', nd);
			// readouts
			const rd = q('[data-read]');
			const li = (t: string, v: string, cls = '') => `<li class="${cls}">${t} <b>${v}</b></li>`;
			if (light) {
				const r = res[0];
				rd.innerHTML = li('Показатель преломления', `<i>n</i> = ${fmt(nOf(glass, light), 4)}`) + li('Угол отклонения', `δ = ${deg(Math.abs(r.dev) < 0.005 ? 0 : r.dev)}`, 'is-key');
			} else {
				const red = trace(nOf(glass, 700), prisms).dev;
				const vio = trace(nOf(glass, 400), prisms).dev;
				const z = (v: number) => (Math.abs(v) < 0.005 ? 0 : v);
				rd.innerHTML =
					li('Отклонение красного (700 нм)', deg(z(red))) +
					li('Отклонение фиолетового (400 нм)', deg(z(vio))) +
					li('Разница', deg(z(vio - red)), 'is-key');
			}
		};
		const seg = (sel: string, pick: (b: HTMLButtonElement) => void) => {
			const bs = [...fig.querySelectorAll<HTMLButtonElement>(`${sel} button`)];
			for (const b of bs)
				b.addEventListener('click', () => {
					for (const o of bs) o.setAttribute('aria-pressed', String(o === b));
					pick(b);
					draw();
				});
		};
		seg('[data-light]', (b) => (light = Number(b.dataset.l)));
		seg('[data-glass]', (b) => (glass = b.dataset.g as keyof typeof GLASS));
		q('[data-second]').addEventListener('change', draw);
		q('[data-norm]').addEventListener('change', draw);
		draw();
	}
</script>
