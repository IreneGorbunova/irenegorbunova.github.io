---
/**
 * «Датчик давления в жидкости»: a small box closed by a rubber film is joined by a hose to a U-shaped water
 * manometer and can be moved anywhere in a tank of liquid 50 см deep; the film can face up, down or sideways. The
 * pressure of the liquid at the depth h of the film's centre is p = g·ρ·h (g = 9,8 Н/кг; water 1000, kerosene 800,
 * sea water 1030, glycerin 1260 кг/м³). The manometer is filled with water, so its levels differ by
 * Δh = p/(g·1000 кг/м³): in water exactly the depth of the probe, in glycerin 1,26 times more. The tank and the
 * manometer share one scale, 4 px per centimeter, so the difference can be compared with the depth by eye. The largest
 * difference (glycerin, 48 см) is 60,5 см: each arm moves 30,2 см from its rest level, and the arms are 76 см long, so
 * the water never leaves the straight parts.
 * The film bends into the box: its sag grows from 1,5 px with no pressure to 7,5 px at 6000 Па (exaggerated; a real
 * film bends by a millimeter or so). Three small arrows press on the film; their length is proportional to p.
 */
import G7Styles from '../g7/G7Styles.astro';

const TOP = 84; // the surface of the liquid
const CM = 4;
const ML = 270; // the manometer: the axis of its left arm
const MR = 298; // the axis of its right arm
const MTOP = 14; // the open ends of the arms
const MBOT = 318; // where the arms turn into the bend
const REST = 166; // the level of the water in both arms with no pressure
const uid = Math.random().toString(36).slice(2, 8);
---

<G7Styles />
<figure class="g7 dpl not-content" data-dpl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 370 350" role="img" aria-label="Сосуд с жидкостью, датчик давления на шланге и водяной манометр" data-svg>
			<defs>
				<marker id={`dpl-${uid}-red`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="dpl__liquid" data-liquid x="20" y={TOP} width="210" height={50 * CM}></rect>
			<path class="dpl__tank" d={`M20 ${TOP - 16} V${TOP + 50 * CM} H230 V${TOP - 16}`}></path>
			{[0, 10, 20, 30, 40, 50].map((c) => (
				<>
					<line class="ln" x1="230" x2="238" y1={TOP + c * CM} y2={TOP + c * CM} />
					<text class="t-small t-num" x="241" y={TOP + c * CM + 4}>{c}</text>
				</>
			))}
			<text class="t-small" x="226" y={TOP + 50 * CM + 20} text-anchor="middle">глубина, см</text>
			<path class="dpl__hose" data-hose></path>
			<path class="ln-dash" data-hline></path>
			<g class="drag" data-probe>
				<rect x="-24" y="-24" width="48" height="48" fill="transparent"></rect>
				<g data-box>
					<rect class="dpl__box" x="-12" y="-7" width="24" height="14" rx="2"></rect>
					<path class="dpl__film" data-film></path>
					<g data-push>
						{[-7, 0, 7].map((dx) => <line class="dpl__push" x1={dx} x2={dx} y1="-20" y2="-9" marker-end={`url(#dpl-${uid}-red)`}></line>)}
					</g>
				</g>
			</g>
			<!-- the manometer, on the same scale as the tank -->
			<line class="ln-dash" x1={ML - 14} x2={MR + 14} y1={REST} y2={REST}></line>
			<path class="dpl__mwater" data-mwater></path>
			<path class="dpl__mano" d={`M${ML - 7} ${MTOP} V${MBOT} a21 21 0 0 0 42 0 V${MTOP} M${ML + 7} ${MTOP} V${MBOT} a7 7 0 0 0 14 0 V${MTOP}`}></path>
			<path class="dpl__bracket" data-mdiff></path>
			<text class="t-small t-num t-strong t-halo" data-mtext></text>
			<text class="t-small" x={(ML + MR) / 2} y="346" text-anchor="middle">манометр</text>
		</svg>
		<div class="g7__side">
			<label class="g7__select">
				Жидкость
				<select data-liq aria-label="Жидкость">
					<option value="1000">Вода, 1000 кг/м³</option>
					<option value="800">Керосин, 800 кг/м³</option>
					<option value="1030">Морская вода, 1030 кг/м³</option>
					<option value="1260">Глицерин, 1260 кг/м³</option>
				</select>
			</label>
			<label class="g7__slider">
				<span>Глубина датчика <i>h</i></span>
				<output data-out></output>
				<input type="range" min="0" max="48" step="1" value="10" data-h aria-label="Глубина датчика, сантиметры" />
			</label>
			<div class="g7__seg" role="group" aria-label="Куда обращена плёнка датчика" data-turn>
				<button type="button" class="g7__btn" aria-pressed="true" data-a="0">Плёнкой вверх</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-a="90">Вбок</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-a="180">Вниз</button>
			</div>
			<ol class="g7__lines" data-lines aria-live="polite"></ol>
		</div>
	</div>
	<figcaption class="g7__caption">
		Датчик можно перетаскивать по всему сосуду. Чем сильнее жидкость давит на плёнку, тем сильнее плёнка прогибается и тем больше разность уровней воды в манометре; прогиб плёнки на рисунке увеличен.
	</figcaption>
</figure>

<style is:global>
	.dpl__liquid {
		fill: var(--g7-water);
	}
	.dpl__tank {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.dpl__hose {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.dpl__box {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.dpl__film {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.dpl__push {
		stroke: var(--g7-red);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.dpl__mano {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
	}
	.dpl__mwater {
		fill: none;
		stroke: var(--g7-blue);
		stroke-opacity: 0.75;
		stroke-width: 12;
	}
	.dpl__bracket {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
</style>

<script>
	import { drag, fmt, fmtInt, k, segment, tex } from '../g7/kit';

	const TOP = 84;
	const CM = 4;
	const ML = 270;
	const MR = 298;
	const MTOP = 14;
	const MBOT = 318;
	const REST = 166;
	for (const root of document.querySelectorAll<HTMLElement>('[data-dpl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('[data-svg]');
		const hIn = q<HTMLInputElement>('[data-h]');
		const liq = q<HTMLSelectElement>('[data-liq]');
		const probe = q<SVGGElement>('[data-probe]');
		const pushes = [...root.querySelectorAll<SVGLineElement>('[data-push] line')];
		let x = 110;
		let turn = 0;
		const draw = () => {
			const h = Number(hIn.value); // см
			const rho = Number(liq.value);
			const p = 9.8 * rho * (h / 100);
			const y = TOP + h * CM;
			probe.setAttribute('transform', `translate(${x} ${y})`);
			q('[data-box]').setAttribute('transform', `rotate(${turn})`);
			// the film sags into the box, more with more pressure (exaggerated)
			const sag = 1.5 + (6 * Math.min(p, 6000)) / 6000;
			q('[data-film]').setAttribute('d', `M-12 -7 Q0 ${(-7 + 2 * sag).toFixed(2)} 12 -7`);
			const len = (13 * Math.min(p, 6000)) / 6000; // px
			for (const a of pushes) {
				a.setAttribute('y1', String(-8 - len - 2));
				a.style.opacity = p > 20 ? '1' : '0';
			}
			// the hose leaves the left side of the box (its back when the film faces sideways), goes up out of the tank
			// and into the top of the left arm
			const sx = turn === 90 ? x - 7 : x - 12;
			const up = Math.min(y - 24, TOP - 24);
			q('[data-hose]').setAttribute('d', `M${sx} ${y} C${sx - 12} ${y}, ${x - 24} ${y - 8}, ${x - 24} ${y - 22} V${up} C${x - 24} 4, ${ML - 20} 2, ${ML} ${MTOP + 6}`);
			q('[data-hline]').setAttribute('d', `M20 ${y} H230`);
			// the manometer: the level in the arm joined to the probe goes down, in the open arm up, by the same amount
			const dh = (p / 9800) * 100; // the difference of the levels, см
			const d = (dh * CM) / 2;
			q('[data-mwater]').setAttribute('d', `M${ML} ${REST + d} V${MBOT} a14 14 0 0 0 28 0 V${REST - d}`);
			const bx = MR + 12;
			q('[data-mdiff]').setAttribute('d', d > 1 ? `M${bx - 4} ${REST - d} h8 M${bx - 4} ${REST + d} h8 M${bx} ${REST - d} V${REST + d}` : '');
			const t = q<SVGTextElement>('[data-mtext]');
			t.setAttribute('x', String(bx + 6));
			t.setAttribute('y', String(REST + 4));
			t.textContent = `${fmt(dh, 1)}\u00a0см`;
			q('[data-liquid]').setAttribute('style', rho === 800 ? 'fill: color-mix(in srgb, var(--ig-v) 30%, transparent)' : rho === 1260 ? 'fill: color-mix(in srgb, var(--ig-vx) 16%, color-mix(in srgb, var(--ig-v) 12%, transparent))' : '');
			q('[data-out]').textContent = `${h}\u00a0см`;
			q('[data-lines]').innerHTML = [
				`<li>${k(`h = ${tex(fmt(h / 100, 2))}~\\text{м}`)}</li>`,
				`<li class="is-key">${k(`p = g\\rho h = 9{,}8 \\cdot ${rho} \\cdot ${tex(fmt(h / 100, 2))} = ${tex(fmtInt(p))}~\\text{Па}`)}</li>`,
				`<li class="is-text">Разность уровней в манометре — ${fmt(dh, 1)} см. Плёнка обращена ${turn === 0 ? 'вверх' : turn === 90 ? 'вбок' : 'вниз'}: на одной глубине давление одинаково во всех направлениях.</li>`,
			].join('');
		};
		hIn.addEventListener('input', draw);
		liq.addEventListener('change', draw);
		segment(q('[data-turn]'), (b) => {
			turn = Number(b.dataset.a);
			draw();
		});
		drag(probe, svg, {
			move: (pt) => {
				x = Math.min(212, Math.max(46, pt.x));
				hIn.value = String(Math.round(Math.min(48, Math.max(0, (pt.y - TOP) / CM))));
				draw();
			},
		});
		draw();
	}
</script>
