---
/**
 * Two short looping opening scenes of «Давление в жидкости. Сообщающиеся сосуды». No terms in the pictures.
 * Barrel: a closed barrel full of water with a thin tube 4 м high let into its lid; a mug of water is poured into
 *   the tube from a balcony. The water in the tube rises to 4 м, and the barrel bursts. (An experiment attributed
 *   to Pascal.) The heights are to scale: 40 px per metre.
 * Teapot: a teapot, seen cut in half, is filled from a tap. The water in the spout stands at the same level as in
 *   the pot all the time; when the level reaches the tip of the spout, the water runs out of it.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
---

<IntroFrame data-zhidintro>
	<div class="intro__card" data-scene="barrel">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="В бочку, полную воды, вставлена тонкая высокая трубка. В трубку вливают кружку воды, вода поднимается на четыре метра, и бочка лопается">
			<rect class="zh-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="zh-ground" x="0" y="216" width="360" height="24"></rect>
			<rect class="zh-wall" x="210" y="0" width="150" height="216"></rect>
			<rect class="zh-balcony" x="176" y="50" width="70" height="6"></rect>
			<path class="zh-rail" d="M178 50 V30 H244 V50 M200 30 V50 M222 30 V50"></path>
			<!-- the tube: 4 м above the barrel -->
			<rect class="zh-tubewater" data-col x="147" y="176" width="6" height="0"></rect>
			<path class="zh-tube" d="M146 16 V176 M154 16 V176"></path>
			<path class="zh-barrel" d="M118 176 q-10 20 0 40 h64 q10 -20 0 -40 Z"></path>
			<path class="zh-hoop" d="M114 188 h72 M114 204 h72"></path>
			<g data-burst>
				<path class="zh-jet" d="M112 190 l-30 -8 M112 200 l-34 6 M188 190 l30 -8 M188 200 l34 6 M130 216 l-10 14 M170 216 l10 14"></path>
				<path class="zh-crack" d="M124 180 l6 12 l-5 10 l7 12 M176 180 l-6 12 l5 10 l-7 12"></path>
			</g>
			<g data-mug><path class="zh-mug" d="M-8 -8 h16 v14 h-16 Z M8 -5 q8 4 0 8"></path></g>
			{[0, 1, 2, 3, 4].map((m) => (
				<>
					<line class="zh-axis" x1="96" x2="104" y1={176 - m * 40} y2={176 - m * 40} />
					<text class="zh-small" x="92" y={180 - m * 40} text-anchor="end">{m} м</text>
				</>
			))}
			<line class="zh-axis" x1="100" y1="16" x2="100" y2="176"></line>
			<text class="zh-note" x="222" y="120" data-note></text>
		</svg>
		<div class="intro__foot">
			<p>
				В бочку, полную воды, вставили длинную узкую трубку и влили в неё всего кружку воды.{' '}
				<More term="Бочка лопнула">
					Давление воды зависит не от того, сколько её налито, а от высоты её столба. В узкой трубке кружка воды поднялась на несколько метров — и давление на стенки бочки выросло так, что доски разошлись. Такой опыт приписывают французскому учёному Блезу Паскалю. Об этом — в разделе{' '}
					<a href="#расчёт-давления-жидкости">«Расчёт давления жидкости»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="pot">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Чайник в разрезе наполняют водой. В носике вода стоит на том же уровне, что и в самом чайнике">
			<defs>
				<clipPath id={`zh-pot-${uid}`}>
					<path d="M92 196 Q78 150 100 104 H200 Q222 150 208 196 Z M210 170 L282 96 L296 108 L214 196 Z"></path>
				</clipPath>
			</defs>
			<rect class="zh-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="zh-table" x="0" y="198" width="360" height="42"></rect>
			<g clip-path={`url(#zh-pot-${uid})`}>
				<rect class="zh-water" data-fill x="60" y="196" width="260" height="0"></rect>
			</g>
			<path class="zh-pot" d="M100 104 Q78 150 92 196 H208 Q215 186 214 196 L296 108 M282 96 L210 170 Q218 136 200 104"></path>
			<path class="zh-handle" d="M96 120 Q56 130 86 176"></path>
			<path class="zh-stream" data-stream d="M150 20 V104"></path>
			<rect class="zh-faucet" x="130" y="6" width="40" height="14" rx="4"></rect>
			<path class="zh-pour" data-pour d="M294 104 q14 6 12 40"></path>
			<line class="zh-level" data-level x1="60" x2="330" y1="196" y2="196"></line>
		</svg>
		<div class="intro__foot">
			<p>
				В чайник наливают воду. В носике она всё время стоит{' '}
				<More term="на том же уровне, что и в самом чайнике">
					Чайник и его носик соединены внизу, и вода свободно перетекает из одного в другой. В таких сосудах вода всегда устанавливается на одном уровне. Поэтому чайник нельзя наполнить выше кончика носика: вода польётся через него. Об этом — в разделе{' '}
					<a href="#сообщающиеся-сосуды">«Сообщающиеся сосуды»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-zhidintro] .zh-sky {
		fill: var(--sl-color-bg);
	}
	[data-zhidintro] .zh-ground,
	[data-zhidintro] .zh-table {
		fill: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	[data-zhidintro] .zh-wall {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-zhidintro] .zh-balcony {
		fill: var(--sl-color-gray-3);
	}
	[data-zhidintro] .zh-rail {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-zhidintro] .zh-tube {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	[data-zhidintro] .zh-tubewater,
	[data-zhidintro] .zh-water {
		fill: color-mix(in srgb, var(--ig-vx) 60%, transparent);
	}
	[data-zhidintro] .zh-barrel {
		fill: color-mix(in oklab, var(--ig-v) 50%, var(--sl-color-gray-4));
		stroke: hsl(28, 50%, 26%);
		stroke-width: 1.5;
	}
	[data-zhidintro] .zh-hoop {
		stroke: var(--sl-color-gray-1);
		stroke-width: 3;
	}
	[data-zhidintro] .zh-jet {
		fill: none;
		stroke: var(--ig-vx);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-crack {
		fill: none;
		stroke: hsl(28, 50%, 14%);
		stroke-width: 2;
	}
	[data-zhidintro] .zh-mug {
		fill: var(--ig-vy);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-zhidintro] .zh-axis {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-zhidintro] .zh-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-zhidintro] .zh-note {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-zhidintro] .zh-pot {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 3;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-handle {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-stream,
	[data-zhidintro] .zh-pour {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, transparent);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-faucet {
		fill: var(--sl-color-gray-3);
	}
	[data-zhidintro] .zh-level {
		stroke: var(--ig-vy);
		stroke-width: 1;
		stroke-dasharray: 5 4;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	for (const root of document.querySelectorAll<HTMLElement>('[data-zhidintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="barrel"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const col = $<SVGRectElement>('[data-col]');
			const burst = $<SVGGElement>('[data-burst]');
			const mug = $<SVGGElement>('[data-mug]');
			const note = $<SVGTextElement>('[data-note]');
			scene(card, 7, (x) => {
				const pour = clamp((x - 0.12) / 0.5); // the water rises in the tube
				const h = 160 * pour;
				col.setAttribute('y', String(176 - h));
				col.setAttribute('height', String(h));
				const tilt = x > 0.08 && pour < 1 ? -70 : 0;
				mug.setAttribute('transform', `translate(166 22) rotate(${tilt})`);
				const broke = x > 0.68;
				burst.style.opacity = broke ? '1' : '0';
				note.textContent = broke ? 'бочка лопнула' : pour > 0 ? `вода в трубке: ${(4 * pour).toFixed(1).replace('.', ',')} м` : '';
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="pot"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const fill = $<SVGRectElement>('[data-fill]');
			const stream = $<SVGPathElement>('[data-stream]');
			const pour = $<SVGPathElement>('[data-pour]');
			const level = $<SVGLineElement>('[data-level]');
			scene(card, 7, (x) => {
				// the level rises from the bottom (y = 196) to the tip of the spout (y = 104)
				const u = clamp(x / 0.8);
				const y = 196 - 92 * u;
				fill.setAttribute('y', y.toFixed(1));
				fill.setAttribute('height', (196 - y).toFixed(1));
				level.setAttribute('y1', y.toFixed(1));
				level.setAttribute('y2', y.toFixed(1));
				stream.setAttribute('d', `M150 20 V${Math.max(22, y).toFixed(1)}`);
				pour.style.opacity = u >= 1 ? '1' : '0';
			});
		}
	}
</script>
