---
/**
 * Two short looping opening scenes of «Давление в жидкости. Сообщающиеся сосуды». No terms of the chapter in the
 * pictures. Both scenes are drawn upright (300 × 340), so the tall barrel scene can keep its true scale.
 *
 * Barrel (an experiment attributed to Pascal; a legend, as the caption's popover says): a closed wooden barrel
 *   1,4 м high and 1 м across, full of water (its right half is drawn cut away so the water inside shows), stands
 *   under a balcony. A thin tube rises 4 м from its lid. A person (170 см) on the balcony leans over the railing and
 *   pours a mug of water into the funnel of the tube. The tube is 1 см wide inside, so 0,31 л — one mug — fills
 *   all 4 м of it (π·0,5²·400 см³). When the water in the tube reaches 4 м the barrel bursts: the bottom hoop slips
 *   and water spurts from the seams. A jet from a crack at height z flies with υ = √(2g(H − z)), H the height of the
 *   water surface (5,4 м above the ground while the tube is full, 1,4 м once it has emptied), and lands υ·√(2z/g)
 *   away; the jets are computed so, at the scale of the picture.
 *   Scale 50 px per metre for everything except the tube (drawn 4 px wide instead of 0,5 px) and the mug (drawn
 *   twice its size). The pouring is slowed down (3,4 с), the tube empties in 0,4 с instead of a fraction of a second,
 *   the jets are in real time.
 * Kettle: a kettle drawn cut in half stands in a sink and is filled from the tap with its lid open. The kettle is
 *   drawn at 6 px per см and scaled by 7/6 (7 px per см): the body is 16 см across and 17,7 см high, the spout starts
 *   low on its side and the lower lip of its tip is 13,2 см above the bottom. The tap gives 0,1 л/с; the level rises
 *   as in a body of revolution with the drawn profile plus the spout channel (2 см² across): 1,9 л up to the lip of
 *   the spout, 19 с of real filling, shown in 5,2 с (3,6 times faster). The water in the spout always stands at the
 *   same level as in the body; when the level reaches the lip, the water runs out of the spout and the level stops
 *   4,5 см below the rim. Then the tap is closed; the end of the stream falls freely in real time.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);

// ---- barrel scene geometry (px); 50 px per metre
const G = 328; // ground
const LID = 258; // top of the barrel, 1,4 м above the ground
const BXL = 109; // the barrel's left and right ends (at the lid and the bottom), 0,85 м apart
const BXR = 151;
const CUT = 130; // the axis; the right half of the barrel is cut away
const BQL = 101; // control points of the bulge: 1 м across in the middle
const BQR = 159;
const TX = 138; // the tube
const TTOP = LID - 200; // 4 м above the lid
const RAIL = 160; // front edge of the balcony
const FLOOR = 97; // balcony floor, 4,6 м above the ground
const HOUSE = 214;
const MID = (G + LID) / 2;
const barrelOut = `M${BXL} ${G} Q${BQL} ${MID} ${BXL} ${LID} H${BXR} Q${BQR} ${MID} ${BXR} ${G} Z`;
// the inside of the cut half: the wall is 3 px thick
const barrelIn = `M${CUT} ${LID + 3} H${BXR - 2.8} Q${BQR - 3} ${MID} ${BXR - 2.8} ${G - 3} H${CUT} Z`;
// staves on the left half
const staves = [114.5, 120, 125.5].map((x) => `M${x} ${G} Q${(x - (x - BQL) * 0.2).toFixed(1)} ${MID} ${x} ${LID}`).join(' ');
// half-width of the barrel at height y (the quadratic outline)
const bw = (y: number) => {
	const t = (G - y) / (G - LID);
	const xl = (1 - t) * (1 - t) * BXL + 2 * (1 - t) * t * BQL + t * t * BXL;
	return CUT - xl;
};
const hoops = [LID + 7, MID, G - 7];
const balusters: number[] = [];
for (let x = RAIL + 6; x < HOUSE; x += 6) balusters.push(x);

// ---- kettle scene: the sink in the picture's own pixels; the kettle is drawn at 6 px per см and scaled by 7/6
const KB = 318; // the bottom of the sink and of the kettle
const KC = 122; // the kettle's axis
const KS = 7 / 6;
---

<IntroFrame data-zhidintro>
	<div class="intro__card" data-scene="barrel">
		<svg class="intro__svg" viewBox="0 0 300 340" role="img" aria-label="Под балконом стоит бочка, полная воды; из её крышки поднимается тонкая трубка высотой четыре метра. Человек на балконе выливает в трубку одну кружку воды, вода в трубке поднимается до самого верха, и бочка лопается">
			<rect class="zh-sky" x="0" y="0" width="300" height="340"></rect>
			<path class="zh-cloud" d="M24 74 q4 -12 16 -8 q6 -10 18 -4 q12 -2 12 10 q6 4 0 8 h-44 q-8 -2 -2 -6 Z"></path>
			<path class="zh-bush" d="M6 328 q-6 -18 8 -22 q2 -16 18 -12 q12 -9 20 6 q12 2 8 28 Z"></path>
			<ellipse class="zh-puddle" data-puddle cx={CUT} cy={G + 2} rx="0" ry="0"></ellipse>
			<!-- the jets from the seams (drawn by the script) -->
			<path class="zh-jet" data-jets></path>
			<!-- the house: its side wall with windows, the balcony on the left -->
			<rect class="zh-house" x={HOUSE} y="0" width={300 - HOUSE} height={G}></rect>
			<path class="zh-house-edge" d={`M${HOUSE} 0 V${G}`}></path>
			<g class="zh-window">
				<rect x="240" y="40" width="40" height="56"></rect>
				<path d="M260 40 V96 M240 64 H280"></path>
				<rect x="240" y="226" width="40" height="56"></rect>
				<path d="M260 226 V282 M240 250 H280"></path>
			</g>
			<rect class="zh-sill" x="236" y="96" width="48" height="4"></rect>
			<rect class="zh-sill" x="236" y="282" width="48" height="4"></rect>
			<rect class="zh-slab" x={RAIL - 2} y={FLOOR} width={HOUSE - RAIL + 2} height="6"></rect>
			<rect class="zh-ground" x="0" y={G} width="300" height={340 - G}></rect>
			<path class="zh-grass" d="M60 328 l2 -6 l2 6 M84 328 l2 -4 l2 4 M180 328 l2 -6 l2 6 M196 328 l2 -5 l2 5"></path>
			<!-- the barrel -->
			<path class="zh-barrel" d={barrelOut}></path>
			<path class="zh-stave" d={staves}></path>
			<path class="zh-barrel-in" d={barrelIn}></path>
			<path class="zh-water" d={`M${CUT} ${LID + 3} H${BXR - 6} Q${BQR - 6} ${MID} ${BXR - 6} ${G - 6} H${CUT} Z`}></path>
			<path class="zh-cutedge" d={`M${CUT} ${LID} V${G}`}></path>
			{hoops.slice(0, 2).map((y) => <path class="zh-hoop" d={`M${(CUT - bw(y)).toFixed(1)} ${y} H${CUT}`} />)}
			{hoops.slice(0, 2).map((y) => <path class="zh-hoop" d={`M${(CUT + bw(y) - 3).toFixed(1)} ${y} h3.5`} />)}
			<g data-hoop>
				<path class="zh-hoop" d={`M${(CUT - bw(hoops[2])).toFixed(1)} ${hoops[2]} H${CUT} M${(CUT + bw(hoops[2]) - 3).toFixed(1)} ${hoops[2]} h3.5`}></path>
			</g>
			<path class="zh-crack" data-crack d={`M${BXL + 4} ${LID + 12} l4 14 l-3 12 l4 16 M${BXR - 4} ${LID + 14} l-3 13 l3 12 l-4 14`}></path>
			<path class="zh-lid" d={`M${BXL - 1} ${LID} H${BXR + 1}`}></path>
			<!-- the tube with its funnel -->
			<rect class="zh-water" data-col x={TX - 1.3} y={LID} width="2.6" height="0"></rect>
			<path class="zh-tube" d={`M${TX - 2} ${LID + 6} V${TTOP} M${TX + 2} ${LID + 6} V${TTOP}`}></path>
			<path class="zh-funnel" d={`M${TX - 2} ${TTOP} L${TX - 7} ${TTOP - 9} M${TX + 2} ${TTOP} L${TX + 7} ${TTOP - 9}`}></path>
			<!-- the height of the water in the tube -->
			<path class="zh-axis" d={`M${TX - 14} ${LID} V${TTOP} ${[1, 2, 3, 4].map((m) => `M${TX - 17} ${LID - m * 50} h6`).join(' ')}`}></path>
			{[1, 2, 3, 4].map((m) => (
				<text class="zh-small zh-halo" x={TX - 20} y={LID - m * 50 + 4} text-anchor="end">{m}&nbsp;м</text>
			))}
			<path class="zh-stream" data-pour></path>
			<!-- the person, drawn facing right and mirrored -->
			<g transform="matrix(-1 0 0 1 340 0)"><g data-man></g></g>
			<g data-mug>
				<path class="zh-mug" d="M-3 -3.6 H3 V2.8 Q3 3.6 2.2 3.6 H-2.2 Q-3 3.6 -3 2.8 Z"></path>
				<path class="zh-mug-h" d="M3 -2 Q5.6 -1.6 5.6 0.2 Q5.6 2 3 2.2"></path>
			</g>
			<!-- the railing in front of the person -->
			<path class="zh-rail" d={`M${RAIL} ${FLOOR} V${FLOOR - 50} H${HOUSE} ${balusters.map((x) => `M${x} ${FLOOR} V${FLOOR - 50}`).join(' ')}`}></path>
			<text class="zh-note zh-halo" x="10" y="186" data-note0></text>
			<text class="zh-note zh-halo" x="10" y="203" data-note1></text>
		</svg>
		<div class="intro__foot">
			<p>
				В бочку, полную воды, вставили длинную узкую трубку и влили в неё всего кружку воды.{' '}
				<More term="Бочка лопнула">
					Давление воды зависит не от того, сколько её налито, а от высоты её столба. В узкой трубке кружка воды поднялась на 4&nbsp;м — и давление на стенки бочки выросло так, что доски разошлись. Такой опыт приписывают французскому учёному Блезу Паскалю. Об этом — в разделе{' '}
					<a href="#расчёт-давления-жидкости">«Расчёт давления жидкости»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="pot">
		<svg class="intro__svg" viewBox="0 0 300 340" role="img" aria-label="Чайник в разрезе стоит в раковине и наполняется из крана. Вода в носике всё время стоит на том же уровне, что и в чайнике; когда она доходит до кончика носика, то выливается через носик, и чайник остаётся неполным">
			<defs>
				<clipPath id={`zh-in-${uid}`}>
					<path data-inside></path>
					<path data-inside-spout></path>
				</clipPath>
			</defs>
			<rect class="zh-kwall" x="0" y="0" width="300" height="340"></rect>
			<path class="zh-tiles" d="M0 50 H300 M0 100 H300 M0 150 H300 M0 200 H300 M25 0 V226 M75 0 V226 M125 0 V226 M175 0 V226 M225 0 V226 M275 0 V226"></path>
			<!-- the sink, cut: counter, basin, cabinet -->
			<rect class="zh-cabinet" x="0" y="230" width="300" height="110"></rect>
			<path class="zh-basin" d={`M20 230 L28 ${KB + 5} H284 L292 230 Z`}></path>
			<path class="zh-basin-in" d={`M25 230 L32 ${KB} H280 L287 230 Z`}></path>
			<rect class="zh-counter" x="0" y="225" width="22" height="7" rx="1"></rect>
			<rect class="zh-counter" x="290" y="225" width="10" height="7" rx="1"></rect>
			<!-- the tap -->
			<path class="zh-pipe" d={`M10 226 V80 Q10 56 34 56 H${KC - 8} Q${KC} 56 ${KC} 66 V72`}></path>
			<rect class="zh-nozzle" x={KC - 6} y="70" width="12" height="6" rx="2"></rect>
			<g data-lever>
				<path class="zh-lever" d="M0 0 L30 -7"></path>
				<circle class="zh-lever-knob" cx="0" cy="0" r="4"></circle>
			</g>
			<path class="zh-stream" data-tapstream></path>
			<path class="zh-stream" data-spill></path>
			<path class="zh-sinkwater" data-sinkwater></path>
			<!-- the kettle, cut in half -->
			<g transform={`translate(${KC} ${KB}) scale(${KS}) translate(${-KC} ${-KB})`}>
				<path class="zh-handle" d={`M${KC - 36} ${KB - 78} Q${KC - 74} ${KB - 84} ${KC - 72} ${KB - 54} Q${KC - 70} ${KB - 30} ${KC - 46} ${KB - 22}`}></path>
				<path class="zh-metal" data-outer-spout></path>
				<path class="zh-metal" data-outer></path>
				<path class="zh-inside" data-inside></path>
				<path class="zh-inside" data-inside-spout></path>
				<g clip-path={`url(#zh-in-${uid})`}>
					<rect class="zh-water" data-fill x={KC - 80} y={KB} width="260" height="0"></rect>
					<path class="zh-surface" data-surface></path>
				</g>
				<g data-lid>
					<path class="zh-lidp" d="M-1 0 H45 V-3 Q41 -13 22 -14 Q3 -13 -1 -3 Z"></path>
					<ellipse class="zh-lidp" cx="22" cy="-16" rx="5" ry="3"></ellipse>
				</g>
				<line class="zh-level" data-level x1={KC - 60} x2={KC + 130} y1={KB} y2={KB}></line>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				В чайник наливают воду. В носике она стоит{' '}
				<More term="на том же уровне, что и в самом чайнике">
					Чайник и его носик соединены внизу, и вода свободно перетекает из одного в другой. В таких сосудах вода всегда устанавливается на одном уровне. Об этом — в разделе{' '}
					<a href="#сообщающиеся-сосуды">«Сообщающиеся сосуды»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-zhidintro] {
		--zh-sky: color-mix(in oklab, var(--ig-vx) 16%, var(--sl-color-bg));
		--zh-water: color-mix(in srgb, var(--ig-vx) 62%, var(--sl-color-bg));
		--zh-wood: hsl(28, 42%, 40%);
		--zh-wood-dark: hsl(26, 45%, 22%);
		--zh-wood-light: hsl(30, 40%, 52%);
		--zh-iron: hsl(220, 8%, 30%);
		--zh-house: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-5));
		--zh-house-edge: color-mix(in oklab, var(--ig-v) 22%, var(--sl-color-gray-4));
		--zh-ground: color-mix(in oklab, hsl(110, 30%, 40%) 50%, var(--sl-color-gray-5));
		--zh-steel: hsl(210, 10%, 72%);
		--zh-steel-dark: hsl(210, 10%, 52%);
		--zh-kwall: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-bg));
		--zh-tile: color-mix(in oklab, var(--ig-vx) 18%, var(--sl-color-gray-5));
		--zh-pot: hsl(355, 62%, 52%);
		--zh-handle: hsl(222, 15%, 48%);
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
	}
	:root[data-theme='light'] [data-zhidintro] {
		--zh-water: color-mix(in srgb, var(--ig-vx) 55%, white);
		--zh-wood: hsl(28, 48%, 46%);
		--zh-wood-light: hsl(30, 45%, 60%);
		--zh-iron: hsl(220, 8%, 34%);
		--zh-house: hsl(36, 40%, 84%);
		--zh-house-edge: hsl(36, 30%, 66%);
		--zh-ground: hsl(100, 30%, 62%);
		--zh-steel: hsl(210, 12%, 80%);
		--zh-steel-dark: hsl(210, 10%, 50%);
		--zh-handle: hsl(222, 25%, 25%);
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
	}
	[data-zhidintro] .zh-sky {
		fill: var(--zh-sky);
	}
	[data-zhidintro] .zh-cloud {
		fill: color-mix(in oklab, var(--sl-color-white) 30%, var(--zh-sky));
	}
	[data-zhidintro] .zh-bush {
		fill: color-mix(in oklab, hsl(140, 40%, 36%) 80%, var(--sl-color-bg));
	}
	[data-zhidintro] .zh-ground {
		fill: var(--zh-ground);
	}
	[data-zhidintro] .zh-grass {
		fill: none;
		stroke: color-mix(in oklab, hsl(120, 40%, 40%) 80%, var(--sl-color-bg));
		stroke-width: 1.2;
	}
	[data-zhidintro] .zh-house {
		fill: var(--zh-house);
	}
	[data-zhidintro] .zh-house-edge {
		stroke: var(--zh-house-edge);
		stroke-width: 3;
	}
	[data-zhidintro] .zh-window rect {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-bg));
		stroke: var(--sl-color-white);
		stroke-width: 2.5;
	}
	[data-zhidintro] .zh-window path {
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	[data-zhidintro] .zh-sill,
	[data-zhidintro] .zh-slab {
		fill: var(--zh-house-edge);
	}
	[data-zhidintro] .zh-rail {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-barrel {
		fill: var(--zh-wood);
		stroke: var(--zh-wood-dark);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	[data-zhidintro] .zh-stave {
		fill: none;
		stroke: var(--zh-wood-dark);
		stroke-width: 0.8;
	}
	[data-zhidintro] .zh-barrel-in {
		fill: var(--zh-wood-light);
	}
	[data-zhidintro] .zh-cutedge {
		stroke: var(--zh-wood-dark);
		stroke-width: 1;
	}
	[data-zhidintro] .zh-lid {
		stroke: var(--zh-wood-dark);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-hoop {
		fill: none;
		stroke: var(--zh-iron);
		stroke-width: 2.4;
	}
	[data-zhidintro] .zh-crack {
		fill: none;
		stroke: var(--zh-wood-dark);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	[data-zhidintro] .zh-water {
		fill: var(--zh-water);
	}
	[data-zhidintro] .zh-puddle {
		fill: var(--zh-water);
		opacity: 0.8;
	}
	[data-zhidintro] .zh-jet,
	[data-zhidintro] .zh-stream {
		fill: none;
		stroke: var(--zh-water);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-tube,
	[data-zhidintro] .zh-funnel {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-zhidintro] .zh-axis {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-zhidintro] .zh-small {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-zhidintro] .zh-note {
		font-size: 13px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-zhidintro] .zh-halo {
		paint-order: stroke fill;
		stroke: var(--zh-sky);
		stroke-width: 4px;
		stroke-linejoin: round;
	}
	[data-zhidintro] .zh-mug {
		fill: var(--ig-v);
		stroke: var(--ph-line);
		stroke-width: 0.6;
	}
	[data-zhidintro] .zh-mug-h {
		fill: none;
		stroke: var(--ig-v);
		stroke-width: 1.2;
	}
	/* the kettle */
	[data-zhidintro] .zh-kwall {
		fill: var(--zh-kwall);
	}
	[data-zhidintro] .zh-tiles {
		fill: none;
		stroke: var(--zh-tile);
		stroke-width: 1.2;
	}
	[data-zhidintro] .zh-cabinet {
		fill: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-gray-5));
	}
	[data-zhidintro] .zh-counter {
		fill: var(--sl-color-gray-3);
	}
	[data-zhidintro] .zh-basin {
		fill: var(--zh-steel-dark);
	}
	[data-zhidintro] .zh-basin-in {
		fill: color-mix(in oklab, var(--zh-steel) 40%, var(--sl-color-bg));
	}
	[data-zhidintro] .zh-pipe {
		fill: none;
		stroke: var(--zh-steel);
		stroke-width: 7;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-nozzle {
		fill: var(--zh-steel-dark);
	}
	[data-zhidintro] .zh-lever {
		stroke: var(--zh-steel-dark);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-lever-knob {
		fill: var(--zh-steel);
		stroke: var(--zh-steel-dark);
	}
	[data-zhidintro] .zh-sinkwater {
		fill: var(--zh-water);
		opacity: 0.7;
	}
	[data-zhidintro] .zh-metal,
	[data-zhidintro] .zh-lidp {
		fill: var(--zh-pot);
		stroke: var(--ph-line);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	[data-zhidintro] .zh-inside {
		fill: color-mix(in oklab, var(--zh-pot) 24%, var(--sl-color-bg));
	}
	[data-zhidintro] .zh-surface {
		fill: none;
		stroke: color-mix(in oklab, var(--zh-water) 50%, white);
		stroke-width: 1.2;
	}
	[data-zhidintro] .zh-handle {
		fill: none;
		stroke: var(--zh-handle);
		stroke-width: 7;
		stroke-linecap: round;
	}
	[data-zhidintro] .zh-level {
		stroke: var(--sl-color-white);
		stroke-width: 1;
		stroke-dasharray: 5 4;
		opacity: 0.8;
	}
	/* the person (personHome.ts) */
	[data-zhidintro] .ph-far {
		filter: brightness(0.8);
	}
	[data-zhidintro] .ph-outline {
		fill: none;
		stroke: var(--ph-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-zhidintro] .ph-pants,
	[data-zhidintro] .ph-sleeve,
	[data-zhidintro] .ph-skin-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-zhidintro] .ph-pants {
		stroke: var(--ph-pants);
	}
	[data-zhidintro] .ph-skin-limb {
		stroke: var(--ph-skin);
	}
	[data-zhidintro] .ph-sleeve.zh-shirt {
		stroke: var(--ig-vy);
	}
	[data-zhidintro] .ph-shirt.zh-shirt {
		fill: var(--ig-vy);
		stroke: var(--ph-line);
		stroke-width: 0.6;
	}
	[data-zhidintro] .ph-belt {
		fill: var(--ph-line);
	}
	[data-zhidintro] .ph-collar {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-zhidintro] .ph-skin {
		fill: var(--ph-skin);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-zhidintro] .ph-ear {
		stroke-width: 0.4;
	}
	[data-zhidintro] .ph-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-zhidintro] .ph-eye {
		fill: var(--ph-line);
	}
	[data-zhidintro] .ph-brow,
	[data-zhidintro] .ph-mouth {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.5;
		stroke-linecap: round;
	}
	[data-zhidintro] .ph-hair {
		fill: var(--ph-hair);
	}
	[data-zhidintro] .ph-shoe {
		fill: var(--ph-shoe);
		stroke: var(--ph-line);
		stroke-width: 0.6;
	}
	[data-zhidintro] .ph-sole {
		fill: var(--ph-line);
	}
</style>
<script>
	import { scene } from '@components/intro/scene';
	import { person } from './personHome';

	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	const ease = (u: number) => {
		const t = clamp(u);
		return t * t * (3 - 2 * t);
	};
	const f = (v: number) => v.toFixed(1);
	const g = 9.8;

	for (const root of document.querySelectorAll<HTMLElement>('[data-zhidintro]')) {
		// ---------- the barrel ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="barrel"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 50; // px per metre
			const G = 328;
			const LID = 258;
			const TX = 138;
			const FLOOR = 97;
			const M = 340; // the person's group is mirrored: x' = M − x
			const col = $<SVGRectElement>('[data-col]');
			const mug = $<SVGGElement>('[data-mug]');
			const pourEl = $<SVGPathElement>('[data-pour]');
			const jets = $<SVGPathElement>('[data-jets]');
			const crack = $<SVGPathElement>('[data-crack]');
			const hoop = $<SVGGElement>('[data-hoop]');
			const puddle = $<SVGEllipseElement>('[data-puddle]');
			const note0 = $<SVGTextElement>('[data-note0]');
			const note1 = $<SVGTextElement>('[data-note1]');
			const pose = person($<SVGGElement>('[data-man]'), { s: K / 100, H: 170, girth: 1, shirt: 'zh-shirt' });
			const RUN = 8;
			const T_TILT = 0.8; // s to tip the mug
			const T_POUR = 3.4; // s of pouring: the tube fills
			const T_BURST = T_TILT + T_POUR + 0.3;
			// cracks: heights above the ground (m); the barrel's sides at that height (px)
			const cracks = [0.3, 0.6, 0.95];
			const side = (z: number) => {
				const t = z / 1.4;
				const xl = (1 - t) * (1 - t) * 109 + 2 * (1 - t) * t * 101 + t * t * 109;
				return { l: xl, r: 260 - xl };
			};
			const MUG = { x: TX + 4, y: 40 }; // the mug's center (world)
			const MS = 1.25; // the mug drawn twice its size: 8 × 9 см at 1 px per см

			scene(card, RUN, (x) => {
				const t = x * RUN;
				const tilt = t < T_TILT ? ease(t / T_TILT) : t < T_TILT + T_POUR ? 1 : 1 - ease((t - T_TILT - T_POUR) / 0.5);
				const ang = -112 * tilt;
				mug.setAttribute('transform', `translate(${MUG.x} ${MUG.y}) rotate(${f(ang)}) scale(${MS})`);
				// hands on the mug: the near one at its handle, the far one at its body
				const a = (ang * Math.PI) / 180;
				const rot = (px: number, py: number) => ({ x: MUG.x + MS * (px * Math.cos(a) - py * Math.sin(a)), y: MUG.y + MS * (px * Math.sin(a) + py * Math.cos(a)) });
				const hn = rot(5.4, 0.2);
				const hf = rot(-3.4, 1);
				pose({
					hip: { x: M - 171, y: FLOOR - 42.5 },
					lean: 0.55,
					ankles: [{ x: M - 176, y: FLOOR - 3.75 }, { x: M - 168, y: FLOOR - 3.75 }],
					feet: [0, 0],
					hands: [{ x: M - hn.x, y: hn.y }, { x: M - hf.x, y: hf.y }],
					head: 0.35,
				});
				// the tube fills while the mug pours
				const pour = clamp((t - T_TILT) / T_POUR);
				const pouring = t > T_TILT * 0.9 && t < T_TILT + T_POUR;
				const lip = rot(-3, -3.6);
				pourEl.setAttribute('d', pouring ? `M${f(lip.x)} ${f(lip.y)} Q${f(lip.x - 1)} ${f(lip.y + 5)} ${TX} ${LID - 200 - 6}` : '');
				const broke = t >= T_BURST;
				const hTube = broke ? 4 * (1 - clamp((t - T_BURST) / 0.4)) : 4 * pour;
				const hpx = hTube * K;
				col.setAttribute('y', f(LID - hpx));
				col.setAttribute('height', f(hpx + 4));
				crack.style.opacity = broke ? '1' : '0';
				const drop = broke ? ease((t - T_BURST) / 0.35) : 0;
				hoop.setAttribute('transform', `translate(0 ${f(5 * drop)}) rotate(${f(-4 * drop)} 130 321)`);
				// jets: υ = √(2g(H − z)), flight until the ground
				let d = '';
				if (broke) {
					const H = 1.4 + hTube;
					const grow = clamp((t - T_BURST) / 0.15);
					for (const z of cracks) {
						const v = Math.sqrt(2 * g * (H - z));
						const tf = Math.sqrt((2 * z) / g) * grow;
						for (const dir of [-1, 1]) {
							const s = side(z);
							const x0 = dir < 0 ? s.l : s.r;
							const y0 = G - z * K;
							d += `M${f(x0)} ${f(y0)}`;
							for (let i = 1; i <= 10; i++) {
								const tt = (tf * i) / 10;
								d += ` L${f(x0 + dir * v * tt * K)} ${f(y0 + 0.5 * g * tt * tt * K)}`;
							}
							d += ' ';
						}
					}
				}
				jets.setAttribute('d', d);
				const pw = broke ? clamp((t - T_BURST) / 3) : 0;
				puddle.setAttribute('rx', f(broke ? 40 + 80 * pw : 0));
				puddle.setAttribute('ry', f(broke ? 2.5 + 2 * pw : 0));
				note0.textContent = broke ? 'бочка' : pour > 0 ? 'вода в трубке:' : '';
				note1.textContent = broke ? 'лопнула' : pour > 0 ? `${(4 * pour).toFixed(1).replace('.', ',')}\u00a0м` : '';
			});
		}

		// ---------- the kettle ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="pot"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const KB = 318;
			const KC = 122;
			const KS = 7 / 6; // the kettle group is scaled about (KC, KB)
			const W = (x: number, y: number) => ({ x: KC + (x - KC) * KS, y: KB + (y - KB) * KS });
			const PX = 6; // px per centimetre inside the kettle group
			// the outer half-width of the body at height z above the bottom (px): a round teapot body on a foot
			const hwOut = (z: number) => {
				if (z < 4) return 30 + 4 * Math.sqrt(1 - ((4 - z) / 4) ** 2);
				if (z < 40) return 34 + 14 * Math.sin((Math.PI / 2) * ((z - 4) / 36));
				if (z <= 98) return 22 + 26 * Math.sqrt(Math.max(0, 1 - ((z - 40) / 58) ** 2));
				return 22;
			};
			const RIM = 106; // the top of the collar
			const hwIn = (z: number) => Math.max(0, hwOut(z) - 3.5);
			// the spout: a curve from inside the body, low on the right, up to its tip
			const P0 = { x: KC + 30, y: KB - 16 };
			const P1 = { x: KC + 80, y: KB - 16 };
			const P2 = { x: KC + 100, y: KB - 80 };
			const bez = (s: number) => ({
				x: (1 - s) ** 2 * P0.x + 2 * (1 - s) * s * P1.x + s * s * P2.x,
				y: (1 - s) ** 2 * P0.y + 2 * (1 - s) * s * P1.y + s * s * P2.y,
			});
			const tan = (s: number) => {
				const tx = 2 * (1 - s) * (P1.x - P0.x) + 2 * s * (P2.x - P1.x);
				const ty = 2 * (1 - s) * (P1.y - P0.y) + 2 * s * (P2.y - P1.y);
				const l = Math.hypot(tx, ty);
				return { x: tx / l, y: ty / l };
			};
			// a point at the side of the spout: w > 0 to the upper left of the direction of the curve
			const sp = (s: number, w: number) => {
				const p = bez(s);
				const t = tan(s);
				return { x: p.x + t.y * w, y: p.y - t.x * w };
			};
			const ribbon = (w0: number, w1: number) => {
				const left: string[] = [];
				const right: string[] = [];
				for (let i = 0; i <= 30; i++) {
					const s = i / 30;
					const w = w0 + (w1 - w0) * s;
					const a = sp(s, w);
					const c = sp(s, -w);
					left.push(`${f(a.x)} ${f(a.y)}`);
					right.unshift(`${f(c.x)} ${f(c.y)}`);
				}
				return `M${left.join(' L')} L${right.join(' L')} Z`;
			};
			// the body outline
			const pts: string[] = [];
			const ptsIn: string[] = [];
			for (let z = 0; z <= RIM; z += 2) pts.push(`${f(KC + hwOut(z))} ${f(KB - z)}`);
			for (let z = RIM; z >= 0; z -= 2) pts.push(`${f(KC - hwOut(z))} ${f(KB - z)}`);
			for (let z = 3.5; z <= RIM + 1; z += 1.5) ptsIn.push(`${f(KC + hwIn(z))} ${f(KB - z)}`);
			for (let z = RIM + 1; z >= 3.5; z -= 1.5) ptsIn.push(`${f(KC - hwIn(z))} ${f(KB - z)}`);
			// body and spout are separate paths: one path would leave a hole where they overlap
			$<SVGPathElement>('[data-outer]').setAttribute('d', `M${pts.join(' L')} Z`);
			$<SVGPathElement>('[data-outer-spout]').setAttribute('d', ribbon(8.5, 5));
			for (const p of card.querySelectorAll('[data-inside]')) p.setAttribute('d', `M${ptsIn.join(' L')} Z`);
			for (const p of card.querySelectorAll('[data-inside-spout]')) p.setAttribute('d', ribbon(5, 2.6));
			// the lower lip of the tip: the water cannot stand higher
			const lipLow = sp(1, -2.6);
			const zTip = KB - lipLow.y;
			// the volume (см³) up to the level z (px): a body of revolution plus the spout channel (about 2 см²)
			const zs: number[] = [];
			const vs: number[] = [];
			let vol = 0;
			for (let z = 3.5; z <= RIM; z += 0.5) {
				vol += Math.PI * (hwIn(z) / PX) ** 2 * (0.5 / PX) + (z > 6 ? 2 * (0.5 / PX) : 0);
				zs.push(z);
				vs.push(vol);
			}
			const zOf = (v: number) => {
				let i = 0;
				while (i < vs.length - 1 && vs[i] < v) i++;
				return zs[i];
			};
			const vTip = vs[zs.findIndex((z) => z >= zTip)];
			const Q = 100; // см³/с from the tap
			const T_OPEN = 0.3;
			const T_FULL = 5.5; // s of the scene when the level reaches the lip
			const SPEED = vTip / Q / (T_FULL - T_OPEN); // real seconds per second of the scene
			const T_CLOSE = 6.9;
			const RUN = 8;
			const fill = $<SVGRectElement>('[data-fill]');
			const surface = $<SVGPathElement>('[data-surface]');
			const level = $<SVGLineElement>('[data-level]');
			const tapStream = $<SVGPathElement>('[data-tapstream]');
			const spill = $<SVGPathElement>('[data-spill]');
			const sinkWater = $<SVGPathElement>('[data-sinkwater]');
			const lever = $<SVGGElement>('[data-lever]');
			const lid = $<SVGGElement>('[data-lid]');
			lid.setAttribute('transform', `translate(${KC - 22} ${KB - RIM}) rotate(-100)`);
			card.dataset.vtip = vTip.toFixed(0);
			card.dataset.ztip = (zTip / PX).toFixed(1);
			const lip = W(lipLow.x + 0.5, lipLow.y - 0.5);
			scene(card, RUN, (x) => {
				const t = x * RUN;
				const open = t < T_OPEN ? ease(t / T_OPEN) : t < T_CLOSE ? 1 : 1 - ease((t - T_CLOSE) / 0.3);
				lever.setAttribute('transform', `translate(10 66) rotate(${f(-30 * open)})`);
				const v = Q * SPEED * Math.max(0, Math.min(t, T_CLOSE) - T_OPEN);
				const over = v >= vTip;
				const z = over ? zTip : zOf(v);
				const y = KB - z;
				fill.setAttribute('y', f(y));
				fill.setAttribute('height', f(z + 2));
				surface.setAttribute('d', `M${KC - 80} ${f(y)} H${KC + 180}`);
				level.setAttribute('y1', f(y));
				level.setAttribute('y2', f(y));
				level.style.opacity = t > T_OPEN ? '0.8' : '0';
				// the stream from the tap; after closing, its tail falls freely (7 px per см, real time)
				const yw = W(KC, y).y;
				const dtc = Math.max(0, t - T_CLOSE);
				const top = 76 + 0.5 * 980 * 7 * dtc * dtc;
				tapStream.setAttribute('d', t > 0.05 && top < yw ? `M${KC} ${f(top)} V${f(yw)}` : '');
				// the spill out of the spout while the level is at the lip and the tap runs
				const spilling = over && t < T_CLOSE + 0.3;
				spill.setAttribute('d', spilling ? `M${f(lip.x)} ${f(lip.y)} Q${f(lip.x + 5)} ${f(lip.y + 1)} ${f(lip.x + 8)} ${f(lip.y + 14)} L${f(lip.x + 9)} ${KB}` : '');
				// the water collected in the sink
				const tOver = over ? Math.min(t, T_CLOSE + 0.3) - T_FULL : 0;
				const pool = clamp(tOver / 2);
				const px0 = lip.x + 9;
				sinkWater.setAttribute('d', pool > 0 ? `M${f(px0 - 34 * pool)} ${KB} Q${f(px0)} ${f(KB - 5 * pool)} ${f(Math.min(279, px0 + 30 * pool))} ${KB} Z` : '');
			});
		}
	}
</script>
