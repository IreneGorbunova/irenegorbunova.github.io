---
/**
 * «Сообщающиеся сосуды»: a wide jar 12 см wide, a narrow tube 3 см wide and a slanted tube 4 см wide (leaning by 30°
 * from the vertical, so its horizontal cut is 4/cos 30° ≈ 4,62 см wide). All three are flat in depth, so the widths
 * stand for the cross sections. A pipe under them joins them; it is full of water from the start. The tap sits on
 * that pipe right next to the jar: closed, it shuts the jar off from both tubes (the water in the tubes stands at the
 * top of the pipe, level 0); open, the water flows until the surfaces are at one level.
 *
 * The slider pours water into the jar up to the level L₀ (5…40 см) with the tap closed. The volume of water above the
 * pipe stays the same: 12·L_jar + (3 + 4,62)·L_tubes = 12·L₀, so the common level is L₀·12/(12 + 3 + 4/cos 30°) =
 * 0,612·L₀ (30 см → 18,3 см). The tap can be closed in the middle of the flow: the levels then stay different. The
 * flow is drawn as an exponential approach to the common level (time constant 0,8 s; a real flow through a thin
 * pipe would take longer). The tap is a plug cock: a plug with a bore turns by 90° together with its handle; handle
 * across the pipe = closed, along the pipe = open. Dashes in the pipe move while the water flows, faster when the
 * difference of the levels is larger. 4 px per centimeter.
 */
import G7Styles from '../g7/G7Styles.astro';

const B = 220; // the bottom of the vessels = the top of the pipe
const CM = 4;
const uid = Math.random().toString(36).slice(2, 8);
// x positions (px)
const JAR = [40, 88]; // 12 см
const TAP = 116;
const NAR = [168, 180]; // 3 см
const SL0 = 236; // the slanted tube at the bottom: left wall
const SLW = (4 / Math.cos(Math.PI / 6)) * CM; // its horizontal width, px
const SLDX = (B - 30) * Math.tan(Math.PI / 6); // the lean over its height
const SL1 = SL0 + SLW;
---

<G7Styles />
<figure class="g7 g7--wide vsl not-content" data-vsl>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 400 262" role="img" aria-label="Широкий сосуд, узкая трубка и наклонная трубка, соединённые внизу трубкой; у широкого сосуда на трубке кран" data-svg>
			<defs>
				<clipPath id={`vsl-a-${uid}`}><rect x={NAR[0]} y="30" width={NAR[1] - NAR[0]} height={B - 30}></rect></clipPath>
				<clipPath id={`vsl-b-${uid}`}><rect x={JAR[0]} y="30" width={JAR[1] - JAR[0]} height={B - 30}></rect></clipPath>
				<clipPath id={`vsl-c-${uid}`}><path d={`M${SL0} ${B} L${SL0 + SLDX} 30 H${SL1 + SLDX} L${SL1} ${B} Z`}></path></clipPath>
			</defs>
			<!-- the pipe, full of water from the start -->
			<rect class="vsl__water" x={JAR[0]} y={B} width={SL1 - JAR[0]} height="12"></rect>
			<rect class="vsl__water" data-wa x={NAR[0]} y={B} width={NAR[1] - NAR[0]} height="0" clip-path={`url(#vsl-a-${uid})`}></rect>
			<rect class="vsl__water" data-wb x={JAR[0]} y={B} width={JAR[1] - JAR[0]} height="0" clip-path={`url(#vsl-b-${uid})`}></rect>
			<rect class="vsl__water" data-wc x={SL0} y={B} width={SLW + SLDX + 4} height="0" clip-path={`url(#vsl-c-${uid})`}></rect>
			<path class="vsl__flow" data-flow d={`M${TAP + 14} ${B + 6} H${SL1 - 6} M${(NAR[0] + NAR[1]) / 2} ${B + 6} V${B - 2}`}></path>
			<path class="vsl__glass" d={`M${JAR[0]} 30 V${B + 12} H${SL1} V${B} L${SL1 + SLDX} 30 M${JAR[1]} 30 V${B} H${NAR[0]} V30 M${NAR[1]} 30 V${B} H${SL0} L${SL0 + SLDX} 30`}></path>
			<!-- the tap: a body on the pipe, a plug with a bore and a handle that turn together -->
			<rect class="vsl__body" x={TAP - 12} y={B - 4} width="24" height="20" rx="4"></rect>
			<g data-plug transform={`translate(${TAP} ${B + 6})`}>
				<circle class="vsl__plug" r="8"></circle>
				<rect class="vsl__bore" x="-2.6" y="-8" width="5.2" height="16"></rect>
				<path class="vsl__handle" d="M0 0 V-30"></path>
				<circle class="vsl__knob" cy="-30" r="3.5"></circle>
				<circle class="vsl__axle" r="2"></circle>
			</g>
			<text class="t-small" x={TAP} y={B + 30} text-anchor="middle">кран</text>
			<line class="vsl__level" data-level x1="20" x2="392" y1={B} y2={B}></line>
			{[0, 10, 20, 30, 40].map((c) => (
				<>
					<line class="ln" x1="22" x2="30" y1={B - c * CM} y2={B - c * CM} />
					<text class="t-small t-num" x="18" y={B - c * CM + 4} text-anchor="end">{c}</text>
				</>
			))}
			<text class="t-small" x="4" y="22">см</text>
			<text class="t-small" x={(JAR[0] + JAR[1]) / 2} y={B + 30} text-anchor="middle">широкий</text>
			<text class="t-small" x={(NAR[0] + NAR[1]) / 2} y={B + 30} text-anchor="middle">узкая</text>
			<text class="t-small" x={SL1 + 6} y={B + 30} text-anchor="middle">наклонная</text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Налито в широкий сосуд, до уровня</span>
				<output data-out></output>
				<input type="range" min="5" max="40" step="1" value="30" data-l aria-label="Уровень воды в широком сосуде до открытия крана, сантиметры" />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-tap>Открыть кран</button>
				<button type="button" class="g7__btn" data-again>Налить заново</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Широкий сосуд</span><b data-rb></b></li>
				<li><span>Узкая трубка</span><b data-ra></b></li>
				<li><span>Наклонная трубка</span><b data-rc></b></li>
			</ul>
			<p class="g7__msg" data-msg></p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Трубка под сосудами с самого начала заполнена водой, а кран отделяет от неё широкий сосуд. Уровень отсчитывается по вертикали от дна; воды при перетекании не становится ни больше, ни меньше.
	</figcaption>
</figure>

<style is:global>
	.vsl__water {
		fill: var(--g7-water);
	}
	.vsl__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.vsl__flow {
		fill: none;
		stroke: var(--g7-water-edge);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 3 7;
	}
	.vsl__body {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.vsl__plug {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.vsl__bore {
		fill: color-mix(in oklab, var(--ig-vx) 55%, var(--g7-paper));
	}
	.vsl__handle {
		stroke: var(--g7-red);
		stroke-width: 4.5;
		stroke-linecap: round;
	}
	.vsl__knob {
		fill: var(--g7-red);
	}
	.vsl.is-open .vsl__handle {
		stroke: var(--g7-green);
	}
	.vsl.is-open .vsl__knob {
		fill: var(--g7-green);
	}
	.vsl__axle {
		fill: var(--g7-ink);
	}
	.vsl__level {
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 5 4;
	}
</style>

<script>
	import { fmt, loop } from '../g7/kit';

	const B = 220;
	const CM = 4;
	const TAP = 116;
	const JAR = 12; // см, widths
	const TUBES = 3 + 4 / Math.cos(Math.PI / 6);
	for (const root of document.querySelectorAll<HTMLElement>('[data-vsl]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const lIn = q<HTMLInputElement>('[data-l]');
		const tapBtn = q<HTMLButtonElement>('[data-tap]');
		const flow = q<SVGPathElement>('[data-flow]');
		let open = false;
		let lb = Number(lIn.value); // the level in the jar, см
		let turn = 0; // 0 closed (handle up, bore across the pipe), 1 open (handle and bore along the pipe)
		let phase = 0;
		let rate = 0; // how fast the jar's level falls, см/с: for the dashes
		const tubes = () => (JAR * (Number(lIn.value) - lb)) / TUBES;
		const common = () => (JAR * Number(lIn.value)) / (JAR + TUBES);
		const draw = () => {
			const ls = tubes();
			for (const [key, level] of [['a', ls], ['b', lb], ['c', ls]] as const) {
				const r = q<SVGRectElement>(`[data-w${key}]`);
				r.setAttribute('y', String(B - level * CM));
				r.setAttribute('height', String(level * CM));
				q(`[data-r${key}]`).textContent = `${fmt(level, 1)}\u00a0см`;
			}
			q('[data-level]').setAttribute('y1', String(B - lb * CM));
			q('[data-level]').setAttribute('y2', String(B - lb * CM));
			q('[data-out]').textContent = `${lIn.value}\u00a0см`;
			q('[data-plug]').setAttribute('transform', `translate(${TAP} ${B + 6}) rotate(${90 * turn})`);
			root.classList.toggle('is-open', open);
			flow.style.opacity = String(Math.min(1, rate * 0.3));
			flow.setAttribute('stroke-dashoffset', String(-phase));
			tapBtn.textContent = open ? 'Закрыть кран' : 'Открыть кран';
			const diff = lb - ls;
			const msg = q('[data-msg]');
			msg.textContent = !open
				? ls < 0.05
					? 'Кран закрыт: широкий сосуд отделён от трубок, вода только в нём.'
					: diff > 0.05
						? 'Кран закрыт: вода больше не перетекает, и уровни остались разными.'
						: 'Кран закрыт, уровни уже одинаковые.'
				: diff > 0.05
					? 'Вода перетекает из широкого сосуда в трубки…'
					: 'Вода остановилась: во всех трёх сосудах её поверхность на одном уровне.';
			msg.classList.toggle('is-right', open && diff <= 0.05);
		};
		const wake = loop(root, (dt) => {
			const goal = open ? 1 : 0;
			turn += Math.sign(goal - turn) * Math.min(Math.abs(goal - turn), dt * 3);
			const before = lb;
			if (open && turn > 0.5) {
				const end = common();
				lb += (end - lb) * Math.min(1, dt * 1.25);
				if (Math.abs(lb - end) < 0.02) lb = end;
			}
			rate = dt > 0 ? Math.abs(before - lb) / dt : 0;
			phase = (phase + rate * 6 * dt) % 10;
			draw();
			return turn !== goal || rate > 0.001;
		});
		tapBtn.addEventListener('click', () => {
			open = !open;
			wake();
		});
		const pour = () => {
			open = false;
			turn = 0;
			rate = 0;
			lb = Number(lIn.value);
			draw();
		};
		q('[data-again]').addEventListener('click', pour);
		lIn.addEventListener('input', pour);
		draw();
	}
</script>
