---
/**
 * Picture «Давление на дно не зависит от формы сосуда»: three vessels with equal bottoms (4 см) are filled at the same
 * rate of rise to the same height, 12 см: one widening upward, one straight, one narrowing. Scale 10 px per см. Under
 * each bottom a gauge shows the pressure of the water on it, p = gρh (g = 9,8 Н/кг, ρ = 1000 кг/м³): the three needles
 * turn together and stop at the same 1176 Па, though the vessels hold very different amounts of water. Arrows on the
 * bottoms grow with p (20 px at 1176 Па). Full scale of a dial: 1500 Па over 240°. The water rises 12 см in 3 с, stays,
 * then runs out, and the picture repeats.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
// `glass` is the wall of the vessel, open at the top; `d` is its inside up to y = 30 (12 см above the bottom)
const shapes = [
	{ x: 60, d: 'M40 150 L10 30 H110 L80 150 Z', glass: 'M6 14 L40 150 H80 L114 14', name: 'воды много' },
	{ x: 180, d: 'M160 150 V30 H200 V150 Z', glass: 'M160 14 V150 H200 V14', name: 'воды меньше' },
	{ x: 300, d: 'M280 150 L294 30 H306 L320 150 Z', glass: 'M296 14 L280 150 H320 L304 14', name: 'воды мало' },
];
const DIAL_Y = 182;
const ticks = (cx: number) => {
	let d = '';
	for (let i = 0; i <= 6; i++) {
		const a = ((-120 + 40 * i) * Math.PI) / 180;
		d += `M${(cx + 10 * Math.sin(a)).toFixed(1)} ${(DIAL_Y - 10 * Math.cos(a)).toFixed(1)} L${(cx + 13 * Math.sin(a)).toFixed(1)} ${(DIAL_Y - 13 * Math.cos(a)).toFixed(1)} `;
	}
	return d;
};
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow pdx not-content" data-zh-pdx>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 252" role="img" aria-label="Три сосуда разной формы с одинаковой площадью дна наполняют водой до одной высоты. Манометры под днами показывают одно и то же давление">
			<defs>
				<clipPath id={`pdx-clip-${uid}`}>
					<rect data-clip x="0" y="150" width="360" height="0"></rect>
				</clipPath>
			</defs>
			<path class="ln-dash" d="M4 30 H356"></path>
			<g clip-path={`url(#pdx-clip-${uid})`}>
				{shapes.map((s) => <path class="pdx__water" d={s.d} />)}
			</g>
			{shapes.map((s) => (
				<>
					<path class="pdx__glass" d={s.glass} />
					<path class="pdx__arrows" data-arrows={s.x} />
					<path class="pdx__pipe" d={`M${s.x} 150 V${DIAL_Y - 15}`} />
					<circle class="pdx__dial" cx={s.x} cy={DIAL_Y} r="16" />
					<path class="pdx__ticks" d={ticks(s.x)} />
					<line class="pdx__needle" data-needle x1={s.x} y1={DIAL_Y} x2={s.x} y2={DIAL_Y - 11} />
					<circle class="pdx__hub" cx={s.x} cy={DIAL_Y} r="2" />
					<text class="t-strong t-num pdx__read" data-read x={s.x} y={DIAL_Y + 30} text-anchor="middle">0&nbsp;Па</text>
					<text class="t-small" x={s.x} y={DIAL_Y + 44} text-anchor="middle">{s.name}</text>
				</>
			))}
			<path class="ln" d="M130 30 v120 M126 30 h8 M126 150 h8"></path>
			<text class="t-i t-halo" x="136" y="94">h</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Сосуды наполняют водой до одной и той же высоты. Манометры под днами всё время показывают одинаковое давление, хотя воды в сосудах налито очень разное количество.
	</figcaption>
</figure>

<style is:global>
	.pdx__water {
		fill: var(--g7-water);
	}
	.pdx__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.pdx__arrows {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.pdx__pipe {
		stroke: var(--g7-steel-dark);
		stroke-width: 4;
	}
	.pdx__dial {
		fill: var(--g7-paper);
		stroke: var(--g7-steel);
		stroke-width: 2.5;
	}
	.pdx__ticks {
		stroke: var(--g7-line);
		stroke-width: 1.2;
	}
	.pdx__needle {
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.pdx__hub {
		fill: var(--g7-ink);
	}
	.pdx svg .pdx__read {
		font-size: 12px;
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const PX = 10; // px per см
	const H = 12; // см
	const P_FULL = 1500; // Па at the end of a dial's scale (240°)
	const CYCLE = 8;
	const f = (v: number) => v.toFixed(1);
	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	for (const root of document.querySelectorAll<HTMLElement>('[data-zh-pdx]')) {
		const clip = root.querySelector<SVGRectElement>('[data-clip]')!;
		const needles = [...root.querySelectorAll<SVGLineElement>('[data-needle]')];
		const reads = [...root.querySelectorAll<SVGTextElement>('[data-read]')];
		const arrows = [...root.querySelectorAll<SVGPathElement>('[data-arrows]')];
		let t = 0;
		const draw = () => {
			const h = t < 3 ? (H * t) / 3 : t < 6 ? H : H * (1 - clamp((t - 6) / 1));
			const y = 150 - h * PX;
			clip.setAttribute('y', f(y));
			clip.setAttribute('height', f(150 - y));
			const p = 9.8 * 1000 * (h / 100); // Па
			const ang = -120 + (240 * p) / P_FULL;
			const L = (20 * p) / 1176; // arrow length, px
			needles.forEach((n) => n.setAttribute('transform', `rotate(${f(ang)} ${n.getAttribute('x1')} ${n.getAttribute('y1')})`));
			reads.forEach((r) => (r.textContent = `${Math.round(p)}\u00a0Па`));
			arrows.forEach((a) => {
				const cx = Number(a.dataset.arrows);
				let d = '';
				if (L > 3)
					for (const dx of [-12, 0, 12]) {
						const x = cx + dx;
						d += `M${x} ${f(148 - L)} V147 M${x - 3} 143 L${x} 147 L${x + 3} 143 `;
					}
				a.setAttribute('d', d);
			});
		};
		draw();
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		});
	}
</script>
