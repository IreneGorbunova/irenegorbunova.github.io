---
/**
 * Picture «Давление на дно не зависит от формы сосуда»: three vessels with equal bottoms (40 px) and water to the
 * same height (120 px): one widening upward, one straight, one narrowing. The pressure on the bottom is the same
 * in all three, g·ρ·h, though the masses of the water differ several times. A static drawing.
 */
import G7Styles from '../g7/G7Styles.astro';

// `glass` is the wall of the vessel, open at the top; the water fills it up to y = 30
const shapes = [
	{ x: 60, d: 'M40 150 L10 30 H110 L80 150 Z', glass: 'M6 14 L40 150 H80 L114 14', name: 'воды много' },
	{ x: 180, d: 'M160 150 V30 H200 V150 Z', glass: 'M160 14 V150 H200 V14', name: 'воды меньше' },
	{ x: 300, d: 'M280 150 L294 30 H306 L320 150 Z', glass: 'M296 14 L280 150 H320 L304 14', name: 'воды мало' },
];
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow pdx not-content">
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 200" role="img" aria-label="Три сосуда разной формы с одинаковой площадью дна и одинаковой высотой воды: давление на дно во всех трёх одинаково">
			<path class="ln-dash" d="M4 30 H356"></path>
			{shapes.map((s) => (
				<>
					<path class="pdx__water" d={s.d} />
					<path class="pdx__glass" d={s.glass} />
					<text class="t-small" x={s.x} y="170" text-anchor="middle">{s.name}</text>
				</>
			))}
			<text class="t-strong" x="180" y="190" text-anchor="middle">давление воды на дно во всех трёх сосудах одинаково</text>
			<path class="ln" d="M130 30 v120 M126 30 h8 M126 150 h8"></path>
			<text class="t-i t-halo" x="136" y="94">h</text>
		</svg>
	</div>
</figure>

<style is:global>
	.pdx__water {
		fill: var(--g7-water);
	}
	.pdx__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.pdx svg .t-strong {
		font-size: 10.5px;
	}
</style>
