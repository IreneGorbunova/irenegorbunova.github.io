---
/**
 * Picture-experiment for the opening of «Давление в жидкости» (the auditor's ★: a tube with a rubber bottom, a vessel
 * with films on its walls). Two panels on one clock, water poured in three portions of 10 см each and then let out:
 *   «Резиновое дно» — a glass tube 6 см wide and 36 см long, its bottom tied over with a rubber film; the film sags
 *     more as the column of water above it grows;
 *   «Резиновые стенки» — a glass vessel 20 см wide and 36 см high with round holes in both side walls at 5, 15 and 25 см above the
 *     bottom, tied over with rubber films; a film bulges outward once the water covers it, the lower ones more, and the
 *     two films at one height equally.
 * Scale 4 px per см. The pressure of the water at a film is p = gρh (h its depth below the surface, g = 9,8 Н/кг):
 * at 30 см it is 2,94 кПа. The sag of a film is drawn proportional to p, 3 px per кПа (9 px at 30 см, that is about
 * 2 см): strongly exaggerated, real films sag by millimetres. Real time for the pouring: 10 см in 1,2 с.
 */
import G7Styles from '../g7/G7Styles.astro';

const S = 4; // px per см
// panel 1: the tube
const T1 = { l: 108, r: 132, top: 50, bot: 194 };
// panel 2: the vessel
const V2 = { l: 80, r: 160, top: 50, bot: 194 };
const HOLES = [5, 15, 25]; // см above the bottom
const R = 6; // half the hole, px (3 см across)
const ticks = [10, 20, 30];
---

<G7Styles />
<figure class="g7 g7--pic zfl not-content" data-zh-films>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 240 236" role="img" aria-label="В стеклянную трубку, дно которой затянуто резиновой плёнкой, наливают воду. Чем выше столб воды, тем сильнее плёнка прогибается вниз" data-p="tube">
			<text class="t-title" x="10" y="18">Резиновое дно</text>
			<text class="t-strong t-num zfl__read" x="10" y="38" data-read></text>
			<!-- the stand -->
			<rect class="zfl__base" x="20" y="222" width="70" height="7" rx="2"></rect>
			<line class="zfl__rod" x1="40" y1="222" x2="40" y2="62"></line>
			<path class="zfl__rod" d={`M40 96 H${T1.l - 3}`}></path>
			<rect class="zfl__clamp" x={T1.l - 6} y="90" width={T1.r - T1.l + 12} height="12" rx="3"></rect>
			<!-- the water and the film -->
			<path class="zfl__water" data-water></path>
			<path class="zfl__film" data-film></path>
			<path class="zfl__glass" d={`M${T1.l} ${T1.top} V${T1.bot} M${T1.r} ${T1.top} V${T1.bot}`}></path>
			<path class="zfl__thread" d={`M${T1.l - 1.5} ${T1.bot - 3} V${T1.bot + 1} M${T1.r + 1.5} ${T1.bot - 3} V${T1.bot + 1}`}></path>
			<!-- the ruler: centimetres above the film -->
			<path class="ln" d={`M${T1.r + 10} ${T1.bot} V${T1.bot - 30 * S} ${ticks.map((c) => `M${T1.r + 10} ${T1.bot - c * S} h5`).join(' ')}`}></path>
			{ticks.map((c) => <text class="t-small" x={T1.r + 18} y={T1.bot - c * S + 4}>{c}</text>)}
			<text class="t-small" x={T1.r + 18} y={T1.bot + 4}>0&nbsp;см</text>
			<path class="zfl__stream" data-stream></path>
			<g data-beaker></g>
			<path class="ln" d={`M${(T1.l + T1.r) / 2 + 4} ${T1.bot + 6} L${T1.r + 16} ${T1.bot + 16}`}></path>
			<text class="t-small" x={T1.r + 18} y={T1.bot + 20}>плёнка</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 240 236" role="img" aria-label="В стеклянный сосуд с отверстиями в боковых стенках, затянутыми резиновой плёнкой, наливают воду. Плёнки выгибаются наружу: нижние сильнее, а две плёнки на одной высоте одинаково" data-p="walls">
			<text class="t-title" x="10" y="18">Плёнки на стенках</text>
			<text class="t-strong t-num zfl__read" x="10" y="38" data-read></text>
			<rect class="zfl__table" x="10" y={V2.bot} width="220" height="6" rx="2"></rect>
			<path class="zfl__water" data-water></path>
			{HOLES.map(() => <path class="zfl__film" data-film />)}
			<path class="zfl__glass" data-walls></path>
			<path class="zfl__stream" data-stream></path>
			<g data-beaker></g>
			<path class="ln" d={`M${V2.r + 6} ${V2.bot - 25 * S} L${V2.r + 26} ${V2.bot - 25 * S - 14}`}></path>
			<text class="t-small" x={V2.r + 24} y={V2.bot - 25 * S - 18}>плёнка</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Чем выше столб воды над резиновой плёнкой, тем сильнее она прогибается — и на дне, и на стенках сосуда. Прогиб плёнок на рисунке сильно увеличен.
	</figcaption>
</figure>

<style is:global>
	.zfl__water {
		fill: var(--g7-water);
	}
	.zfl__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.zfl__film {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.zfl__thread {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.zfl__stream {
		fill: none;
		stroke: color-mix(in srgb, var(--ig-vx) 70%, transparent);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.zfl__base,
	.zfl__table {
		fill: var(--g7-wood);
	}
	.zfl__rod {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 3.5;
		stroke-linecap: round;
	}
	.zfl__clamp {
		fill: var(--g7-steel-dark);
	}
	.zfl__beaker {
		fill: color-mix(in srgb, var(--sl-color-gray-2) 10%, transparent);
		stroke: var(--g7-glass);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.zfl__beaker-water {
		fill: var(--g7-water);
	}
	.zfl__read {
		font-size: 13px;
	}
</style>

<script>
	import { el, loop } from '../g7/kit';

	const S = 4; // px per см
	const g = 9.8;
	const SAG = 3; // px per кПа
	const f = (v: number) => v.toFixed(1);
	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	// the clock: three portions (10 см each, 1,2 с) with pauses, a hold, then the water is let out
	const CYCLE = 11;
	const PORTIONS = [0.6, 2.8, 5.0];
	const T_DRAIN = 8.4;
	const level = (t: number) => {
		let h = 0;
		for (const t0 of PORTIONS) h += 10 * clamp((t - t0) / 1.2);
		if (t > T_DRAIN) h *= 1 - clamp((t - T_DRAIN) / 1.6);
		return h; // см
	};
	const pouring = (t: number) => PORTIONS.some((t0) => t > t0 - 0.25 && t < t0 + 1.25);
	const kPa = (depthCm: number) => (g * 1000 * Math.max(0, depthCm)) / 100 / 1000;

	// a beaker that tips to pour; returns the point where the water leaves its lip
	const beaker = (gEl: Element, cx: number, cy: number) => {
		const body = el('path', { class: 'zfl__beaker', d: 'M-12 -16 L-14 -18 H12 V14 Q12 16 10 16 H-10 Q-12 16 -12 14 Z' });
		const water = el('path', { class: 'zfl__beaker-water' });
		gEl.append(water, body);
		return (tilt: number) => {
			// tilt 0..1 → 0..−105°; the water inside stays horizontal (a rough fill for the eye)
			const a = -105 * tilt;
			gEl.setAttribute('transform', `translate(${cx} ${cy}) rotate(${f(a)})`);
			const fillTop = 2 + 10 * tilt;
			water.setAttribute('d', tilt > 0.8 ? '' : `M-11 ${f(fillTop)} H11 V14 H-11 Z`);
			const r = (a * Math.PI) / 180;
			return { x: cx + -14 * Math.cos(r) - -18 * Math.sin(r), y: cy + -14 * Math.sin(r) + -18 * Math.cos(r) };
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-zh-films]')) {
		const tube = root.querySelector<SVGSVGElement>('[data-p="tube"]')!;
		const walls = root.querySelector<SVGSVGElement>('[data-p="walls"]')!;
		// panel 1
		const T1 = { l: 108, r: 132, top: 50, bot: 194 };
		const w1 = tube.querySelector('[data-water]')!;
		const film1 = tube.querySelector('[data-film]')!;
		const st1 = tube.querySelector('[data-stream]')!;
		const read1 = tube.querySelector('[data-read]')!;
		const pour1 = beaker(tube.querySelector('[data-beaker]')!, 140, 26);
		// panel 2
		const V2 = { l: 80, r: 160, top: 50, bot: 194 };
		const HOLES = [5, 15, 25];
		const R = 6;
		const w2 = walls.querySelector('[data-water]')!;
		const films2 = [...walls.querySelectorAll('[data-film]')];
		const st2 = walls.querySelector('[data-stream]')!;
		const read2 = walls.querySelector('[data-read]')!;
		const pour2 = beaker(walls.querySelector('[data-beaker]')!, 170, 26);
		// the walls of the vessel with the holes left open
		let d = '';
		for (const x of [V2.l, V2.r]) {
			let y = V2.top;
			for (const c of [...HOLES].reverse()) {
				const yc = V2.bot - c * S;
				d += `M${x} ${y} V${yc - R} `;
				y = yc + R;
			}
			d += `M${x} ${y} V${V2.bot} `;
		}
		d += `M${V2.l - 1.2} ${V2.bot} H${V2.r + 1.2}`;
		walls.querySelector('[data-walls]')!.setAttribute('d', d);

		let t = 0;
		const draw = () => {
			const h = level(t);
			const yS = T1.bot - h * S;
			const tilt = pouring(t) ? 1 : 0;
			// panel 1: the bottom film sags by SAG px per кПа
			const sag = SAG * kPa(h);
			const mid = (T1.l + T1.r) / 2;
			film1.setAttribute('d', `M${T1.l - 1} ${T1.bot} Q${mid} ${f(T1.bot + 2 * sag)} ${T1.r + 1} ${T1.bot}`);
			w1.setAttribute('d', h > 0 ? `M${T1.l} ${f(yS)} H${T1.r} V${T1.bot} Q${mid} ${f(T1.bot + 2 * sag)} ${T1.l} ${T1.bot} Z` : '');
			const lip1 = pour1(easeTilt(t));
			st1.setAttribute('d', tilt ? `M${f(lip1.x)} ${f(lip1.y)} Q${f(lip1.x - 2)} ${f(lip1.y + 6)} ${f(lip1.x - 2)} ${f(Math.min(yS, T1.bot))}` : '');
			read1.textContent = `вода: ${Math.round(h)}\u00a0см`;
			// panel 2: the side films bulge outward by SAG px per кПа at their depth
			const y2 = V2.bot - h * S;
			let wd = h > 0 ? `M${V2.l} ${f(y2)} H${V2.r} V${V2.bot} H${V2.l} Z ` : '';
			HOLES.forEach((c, i) => {
				const yc = V2.bot - c * S;
				const b = SAG * kPa(h - c);
				films2[i].setAttribute('d', `M${V2.l} ${yc - R - 1} Q${f(V2.l - 2 * b)} ${yc} ${V2.l} ${yc + R + 1} M${V2.r} ${yc - R - 1} Q${f(V2.r + 2 * b)} ${yc} ${V2.r} ${yc + R + 1}`);
				if (h > c + R / S) wd += `M${V2.l} ${yc - R} Q${f(V2.l - 2 * b)} ${yc} ${V2.l} ${yc + R} Z M${V2.r} ${yc - R} Q${f(V2.r + 2 * b)} ${yc} ${V2.r} ${yc + R} Z `;
			});
			w2.setAttribute('d', wd);
			const lip2 = pour2(easeTilt(t));
			st2.setAttribute('d', tilt ? `M${f(lip2.x)} ${f(lip2.y)} Q${f(lip2.x - 2)} ${f(lip2.y + 6)} ${f(lip2.x - 2)} ${f(Math.min(y2, V2.bot))}` : '');
			read2.textContent = `вода: ${Math.round(h)}\u00a0см`;
		};
		const easeTilt = (tt: number) => {
			let best = 0;
			for (const t0 of PORTIONS) {
				const u = Math.min(clamp((tt - (t0 - 0.45)) / 0.3), clamp((t0 + 1.5 - tt) / 0.3));
				best = Math.max(best, u);
			}
			return best;
		};
		draw();
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw();
			return true;
		});
	}
</script>
