---
/**
 * «Две жидкости в сообщающихся сосудах»: a U-shaped tube with water; a second liquid that does not mix with water
 * (kerosene 800 кг/м³, sunflower oil 930 кг/м³, petrol 710 кг/м³) is poured into the right arm, a column of
 * height h₂ (5…30 см). At the level of the boundary between the liquids the pressures in the two arms are equal:
 * ρ₁·h₁ = ρ₂·h₂, so the water in the left arm stands h₁ = h₂·ρ₂/ρ₁ above that level. 5 px per centimeter.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 utb not-content" data-utb>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 260" role="img" aria-label="Изогнутая трубка с водой в левом колене и другой жидкостью в правом" data-svg>
			<path class="utb__water" data-water></path>
			<rect class="utb__oil" data-oil x="176" width="24"></rect>
			<path class="utb__glass" d="M100 20 V214 q0 26 26 26 h48 q26 0 26 -26 V20 M124 20 V210 q0 6 6 6 h40 q6 0 6 -6 V20"></path>
			<path class="ln-dash" data-base></path>
			<path class="ln" data-b1></path>
			<path class="ln" data-b2></path>
			<text class="t-i t-blue t-halo" data-t1>h<tspan class="utb__sub" dy="3">1</tspan></text>
			<text class="t-i t-gold t-halo" data-t2>h<tspan class="utb__sub" dy="3">2</tspan></text>
		</svg>
		<div class="g7__side">
			<label class="g7__select">
				Жидкость в правом колене
				<select data-liq aria-label="Жидкость в правом колене">
					<option value="800">Керосин, 800 кг/м³</option>
					<option value="930">Подсолнечное масло, 930 кг/м³</option>
					<option value="710">Бензин, 710 кг/м³</option>
				</select>
			</label>
			<label class="g7__slider">
				<span>Высота её столба <i>h</i><sub>2</sub></span>
				<output data-out></output>
				<input type="range" min="5" max="30" step="1" value="25" data-h aria-label="Высота столба второй жидкости, сантиметры" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>Высота столба воды <i>h</i><sub>1</sub></span><b data-h1></b></li>
				<li class="is-key"><span><i>h</i><sub>2</sub> : <i>h</i><sub>1</sub></span><b data-ratio></b></li>
				<li><span>Плотность воды : плотность жидкости</span><b data-rr></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Высоты столбов отсчитываются от уровня, на котором жидкости соприкасаются (пунктир). В левом колене — вода, 1000 кг/м³.
	</figcaption>
</figure>

<style is:global>
	.utb__water {
		fill: none;
		stroke: var(--g7-blue);
		stroke-opacity: 0.55;
		stroke-width: 24;
		stroke-linejoin: round;
	}
	.utb__oil {
		fill: color-mix(in oklab, var(--ig-v) 62%, transparent);
	}
	.utb__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
	}
	.utb svg .utb__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>

<script>
	import { fmt } from '../g7/kit';

	const CM = 5;
	const BASE = 190; // the level where the liquids meet
	for (const root of document.querySelectorAll<HTMLElement>('[data-utb]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const liq = q<HTMLSelectElement>('[data-liq]');
		const hIn = q<HTMLInputElement>('[data-h]');
		const draw = () => {
			const rho = Number(liq.value);
			const h2 = Number(hIn.value);
			const h1 = (h2 * rho) / 1000;
			const y1 = BASE - h1 * CM;
			const y2 = BASE - h2 * CM;
			q('[data-water]').setAttribute('d', `M112 ${y1} V212 q0 16 16 16 h44 q16 0 16 -16 V${BASE}`);
			const oil = q<SVGRectElement>('[data-oil]');
			oil.setAttribute('y', String(y2));
			oil.setAttribute('height', String(h2 * CM));
			q('[data-base]').setAttribute('d', `M60 ${BASE} H240`);
			q('[data-b1]').setAttribute('d', `M84 ${y1} h8 M84 ${BASE} h8 M88 ${y1} V${BASE}`);
			q('[data-b2]').setAttribute('d', `M208 ${y2} h8 M208 ${BASE} h8 M212 ${y2} V${BASE}`);
			q('[data-t1]').setAttribute('x', '62');
			q('[data-t1]').setAttribute('y', String((y1 + BASE) / 2 + 4));
			q('[data-t2]').setAttribute('x', '220');
			q('[data-t2]').setAttribute('y', String((y2 + BASE) / 2 + 4));
			q('[data-out]').textContent = `${h2} см`;
			q('[data-h1]').textContent = `${fmt(h1, 1)} см`;
			q('[data-ratio]').textContent = fmt(h2 / h1, 2);
			q('[data-rr]').textContent = fmt(1000 / rho, 2);
		};
		liq.addEventListener('change', draw);
		hIn.addEventListener('input', draw);
		draw();
	}
</script>
