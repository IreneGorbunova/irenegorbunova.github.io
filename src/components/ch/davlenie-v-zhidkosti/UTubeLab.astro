---
/**
 * «Две жидкости в сообщающихся сосудах»: a U-shaped tube of one width holds a fixed amount of water; with nothing
 * else in it the water stands at one level in both arms, 17 см above the bend (dotted line). A second liquid that does
 * not mix with water (kerosene 800 кг/м³, sunflower oil 930 кг/м³, petrol 710 кг/м³) is poured into the right arm, a
 * column of height h₂ (0…30 см). It pushes the water down in the right arm and up in the left arm by the same amount x,
 * because the water volume does not change. At the level of the boundary between the liquids the pressures in the two
 * arms are equal: ρ₁·h₁ = ρ₂·h₂, where h₁ = 2x is the water above that level, so x = h₁/2 = h₂·ρ₂/(2ρ₁). The largest
 * x is 13,95 см (oil, 30 см): the boundary is then 3 см above the bend, still in the straight part; the highest top of
 * the second liquid is 36,4 см (petrol, 30 см), under the open end at 40 см. 5 px per centimeter.
 * Each second liquid has its own tint (kerosene violet, oil gold, petrol green; colors are only to tell them apart)
 * and its name over its column.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 utb not-content" data-utb>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 262" role="img" aria-label="Изогнутая трубка с водой; в правое колено налита другая жидкость" data-svg>
			<path class="utb__water" data-water></path>
			<rect class="utb__oil" data-oil x="176" width="24"></rect>
			<path class="utb__glass" d="M100 12 V214 q0 26 26 26 h48 q26 0 26 -26 V12 M124 12 V210 q0 6 6 6 h40 q6 0 6 -6 V12"></path>
			<path class="utb__rest" d="M92 129 H208"></path>
			<text class="t-small" x="150" y="124" text-anchor="middle">было</text>
			<path class="ln-dash" data-base></path>
			<path class="ln" data-b1></path>
			<path class="ln" data-b2></path>
			<text class="t-i t-blue t-halo" data-t1>h<tspan class="utb__sub" dy="3">1</tspan></text>
			<text class="t-small t-halo utb__name" data-name x="188" text-anchor="middle"></text>
			<text class="t-i t-halo utb__h2" data-t2>h<tspan class="utb__sub" dy="3">2</tspan></text>
			<text class="t-small" x="112" y="256" text-anchor="middle">вода</text>
		</svg>
		<div class="g7__side">
			<label class="g7__select">
				Жидкость в правом колене
				<select data-liq aria-label="Жидкость в правом колене">
					<option value="800">Керосин, 800 кг/м³</option>
					<option value="930">Подсолнечное масло, 930 кг/м³</option>
					<option value="710">Бензин, 710 кг/м³</option>
				</select>
			</label>
			<label class="g7__slider">
				<span>Высота её столба <i>h</i><sub>2</sub></span>
				<output data-out></output>
				<input type="range" min="0" max="30" step="1" value="25" data-h aria-label="Высота столба второй жидкости, сантиметры" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>Высота столба воды <i>h</i><sub>1</sub></span><b data-h1></b></li>
				<li><span>Вода слева поднялась, справа опустилась на</span><b data-x></b></li>
				<li class="is-key"><span><i>h</i><sub>2</sub> : <i>h</i><sub>1</sub></span><b data-ratio></b></li>
				<li><span>Плотность воды : плотность жидкости</span><b data-rr></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Высоты столбов отсчитываются от уровня, на котором жидкости соприкасаются (пунктир); «было» — уровень воды, пока второй жидкости не было. Воды в трубке всё время одно и то же количество, её плотность 1000 кг/м³.
	</figcaption>
</figure>

<style is:global>
	.utb__water {
		fill: none;
		stroke: var(--g7-blue);
		stroke-opacity: 0.55;
		stroke-width: 24;
		stroke-linejoin: round;
	}
	.utb__oil {
		fill: color-mix(in oklab, var(--utb-liq) 62%, transparent);
	}
	.utb {
		--utb-liq: var(--g7-violet);
	}
	.utb[data-liquid='930'] {
		--utb-liq: var(--g7-gold);
	}
	.utb[data-liquid='710'] {
		--utb-liq: var(--g7-green);
	}
	.utb svg .utb__name {
		font-weight: 700;
		fill: var(--utb-liq);
	}
	.utb svg .utb__h2 {
		fill: var(--utb-liq);
	}
	.utb__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
	}
	.utb__rest {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-dasharray: 1.5 3;
		stroke-linecap: round;
	}
	.utb svg .utb__sub {
		font-size: 10px;
		font-style: normal;
		font-family: var(--__sl-font);
	}
</style>

<script>
	import { fmt } from '../g7/kit';

	const CM = 5;
	const NAMES: Record<number, string> = { 800: 'керосин', 930: 'масло', 710: 'бензин' };
	const REST = 129; // the water level with nothing else in the tube: 17 см above the bend (y = 214)
	for (const root of document.querySelectorAll<HTMLElement>('[data-utb]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const liq = q<HTMLSelectElement>('[data-liq]');
		const hIn = q<HTMLInputElement>('[data-h]');
		const draw = () => {
			const rho = Number(liq.value);
			const h2 = Number(hIn.value);
			const h1 = (h2 * rho) / 1000;
			const x = h1 / 2; // см: the water goes up on the left and down on the right by this much
			const base = REST + x * CM; // the boundary between the liquids
			const y1 = REST - x * CM;
			const y2 = base - h2 * CM;
			q('[data-water]').setAttribute('d', `M112 ${y1} V212 q0 16 16 16 h44 q16 0 16 -16 V${base}`);
			const oil = q<SVGRectElement>('[data-oil]');
			oil.setAttribute('y', String(y2));
			oil.setAttribute('height', String(h2 * CM));
			const show = h2 > 0 ? '1' : '0';
			for (const s of ['[data-base]', '[data-b1]', '[data-b2]', '[data-t1]', '[data-t2]', '[data-name]']) q<SVGElement>(s).style.opacity = show;
			root.dataset.liquid = String(rho);
			const name = q<SVGTextElement>('[data-name]');
			name.textContent = NAMES[rho] ?? '';
			name.setAttribute('y', String(y2 - 6));
			q('[data-base]').setAttribute('d', `M60 ${base} H240`);
			q('[data-b1]').setAttribute('d', `M84 ${y1} h8 M84 ${base} h8 M88 ${y1} V${base}`);
			q('[data-b2]').setAttribute('d', `M208 ${y2} h8 M208 ${base} h8 M212 ${y2} V${base}`);
			q('[data-t1]').setAttribute('x', '64');
			q('[data-t1]').setAttribute('y', String((y1 + base) / 2 + 4));
			q('[data-t2]').setAttribute('x', '220');
			q('[data-t2]').setAttribute('y', String((y2 + base) / 2 + 4));
			q('[data-out]').textContent = `${h2}\u00a0см`;
			q('[data-h1]').textContent = `${fmt(h1, 1)}\u00a0см`;
			q('[data-x]').textContent = `${fmt(x, 1)}\u00a0см`;
			q('[data-ratio]').textContent = h2 > 0 ? fmt(h2 / h1, 2) : '—';
			q('[data-rr]').textContent = fmt(1000 / rho, 2);
		};
		liq.addEventListener('change', draw);
		hIn.addEventListener('input', draw);
		draw();
	}
</script>
