---
/**
 * «Манометры»: an animated picture of the two school manometers, two panels on one clock of 11 с.
 *   «Жидкостный манометр» — a flat round box closed on top by a rubber film, joined by a rubber hose to a glass
 *     U-tube with colored water and a scale between the arms (marks every 1 см, numbers every 5 см, 0 at the rest
 *     level). A finger presses the film twice, lightly and then harder. The air in the box and the hose is squeezed,
 *     its pressure grows by p, and the water in the arm joined to the box goes down while in the open arm it goes up,
 *     each by Δh/2 (equal arms), until p = gρΔh (g = 9,8 Н/кг, ρ = 1000 кг/м³): a light press gives Δh = 4 см,
 *     392 Па, a hard one Δh = 10 см, 980 Па. Scale 4 px per см, as in DepthLab, so the two figures read alike.
 *     The film sag is drawn 0,9 px per см of Δh (9 px at 10 см): strongly exaggerated, a real film moves by a few
 *     millimeters, because squeezing the air by about 1 % is enough for 1 кПа.
 *   «Металлический манометр» — a Bourdon gauge with its face cut away: a brass tube of flattened cross-section bent
 *     into a 270° arc (radius 42 px), fixed at the socket and closed at its free end; the free end is joined by a
 *     lever (link) to a toothed sector that turns a small gear on the axis of the needle. The pressure from the vessel
 *     (through a pipe with a valve) rises from 0 to 250 кПа (about the pressure in a car tyre) and falls back. Under
 *     pressure the tube unbends: its curvature is drawn as κ = (1 − 0,1·p/400 кПа)/42 px with the arc length kept,
 *     so its tip moves by 16 px at 250 кПа (exaggerated: on a dial 6 см across that is about 6 мм, a real tip moves by
 *     1–3 мм). The needle turns in proportion to p, 270° for 0…400 кПа; the sector turns by about 19° at 250 кПа, so
 *     the drawn gears (radii 21 and 5 px) only show the idea: a real pair has a larger ratio. Both devices show the pressure above the air pressure around them;
 *     the chapter has not yet introduced atmospheric pressure, so the picture calls it «давление».
 *   Colors as in the chapter: the rubber film red, the hose gold, the glass gray, the water blue; the gas under
 *   pressure in the metal tube is tinted red, more strongly as p grows. Real time for the finger; the gauge pressure
 *   rises in 3 с.
 */
import G7Styles from '../g7/G7Styles.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

// panel 1: the liquid manometer
const ML = 180; // the axis of the left arm (joined to the box)
const MR = 224; // the axis of the right arm (open)
const MTOP = 52;
const MBOT = 196;
const REST = 124;
const CM = 4;
const BX = 70; // the center of the box
const FILM = 176; // the film at rest
// panel 2: the metal manometer
const C = { x: 140, y: 124 };
const R = 82; // the case
const R0 = 42; // the tube at rest
const PMAX = 400; // кПа, full scale
const dial = (p: number) => ((-135 + (270 * p) / PMAX) * Math.PI) / 180; // from straight up, clockwise
const at = (p: number, r: number) => ({ x: C.x + r * Math.sin(dial(p)), y: C.y - r * Math.cos(dial(p)) });
const ticks = Array.from({ length: 21 }, (_, i) => i * 20);
const P0 = { x: C.x + R0 * Math.cos((2 * Math.PI) / 3), y: C.y + R0 * Math.sin((2 * Math.PI) / 3) }; // the socket
const f = (v: number) => v.toFixed(1);
---

<G7Styles />
<KitStyles />
<figure class="g7 g7--pic zmn not-content" data-zh-mano>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 280 262" role="img" aria-label="Жидкостный манометр: коробочка с резиновой плёнкой соединена шлангом с U-образной трубкой с водой. Палец давит на плёнку, и вода в колене, соединённом с коробочкой, опускается, а в открытом колене поднимается" data-p="liquid">
			<text class="t-title" x="10" y="18">Жидкостный манометр</text>
			<text class="t-strong t-num zmn__read" x="10" y="38" data-read></text>
			<!-- the box on its stand -->
			<rect class="zmn__table" x="20" y="232" width="100" height="6" rx="2"></rect>
			<rect class="zmn__post" x={BX - 3} y="198" width="6" height="34"></rect>
			<rect class="zmn__box" x={BX - 24} y={FILM} width="48" height="22" rx="3"></rect>
			<path class="zmn__film" data-film></path>
			<!-- the hose: from the box to the top of the left arm -->
			<path class="zmn__hose" d={`M${BX + 24} 190 C${BX + 52} 190, 136 184, 136 160 V76 C136 42, ${ML} 34, ${ML} ${MTOP + 2}`}></path>
			<!-- the U-tube with water and the scale between the arms -->
			<path class="zmn__water" data-water></path>
			<path class="zmn__glass" d={`M${ML - 7} ${MTOP} V${MBOT} a29 29 0 0 0 58 0 V${MTOP} M${ML + 7} ${MTOP} V${MBOT} a15 15 0 0 0 30 0 V${MTOP}`}></path>
			<path class="ln" d={Array.from({ length: 21 }, (_, i) => `M${ML + 9} ${REST + (i - 10) * CM} h${i % 5 === 0 ? 7 : 4}`).join(' ')}></path>
			{[-10, -5, 0, 5, 10].map((c) => (
				<text class="t-small t-num" x={(ML + MR) / 2 + 4} y={REST + c * CM + 4} text-anchor="middle">{Math.abs(c)}</text>
			))}
			<path class="ln-dash" data-levels></path>
			<path class="zmn__bracket" data-bracket></path>
			<g data-dh-show>
				<text class="t-i" x={MR + 14} y={REST - 4}>Δh</text>
				<text class="t-small t-num t-strong" x={MR + 14} y={REST + 12} data-dh></text>
			</g>
			<!-- the hand (the shared people kit): the index finger presses the film, its tip at the group's origin -->
			<g data-finger></g>
			<!-- the labels -->
			<path class="ln" d={`M40 168 L${BX - 18} ${FILM} M48 207 L${BX - 18} 196 M131 112 L136 112 M${MR + 9} 70 L${MR + 14} 66 M${(ML + MR) / 2} 238 V230`}></path>
			<text class="t-small" x="4" y="153">резиновая</text>
			<text class="t-small" x="4" y="165">плёнка</text>
			<text class="t-small" x="4" y="211">коробочка</text>
			<text class="t-small" x="129" y="116" text-anchor="end">шланг</text>
			<text class="t-small" x={MR + 14} y="64">трубка</text>
			<text class="t-small" x={(ML + MR) / 2} y="250" text-anchor="middle">вода</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 280 262" role="img" aria-label="Металлический манометр со снятой крышкой: изогнутая металлическая трубка через рычаг и зубчатку поворачивает стрелку. Давление растёт, трубка немного разгибается, и стрелка поворачивается по шкале" data-p="metal">
			<text class="t-title" x="10" y="18">Металлический манометр</text>
			<text class="t-strong t-num zmn__read" x="10" y="38" data-read></text>
			<!-- the pipe from the vessel, the valve, the socket -->
			<path class="zmn__pipe" d={`M8 236 H${f(P0.x)} V${f(P0.y)}`}></path>
			<path class="zmn__gas" data-gas d={`M8 236 H${f(P0.x)} V${f(P0.y)}`}></path>
			<path class="zmn__valve" d="M50 228 L50 244 L66 236 Z M82 228 L82 244 L66 236 Z"></path>
			<path class="zmn__handle" d="M66 236 V220 M58 220 H74"></path>
			<rect class="zmn__nut" x={f(P0.x - 9)} y="206" width="18" height="10" rx="1.5"></rect>
			<!-- the case and the scale -->
			<circle class="zmn__face" cx={C.x} cy={C.y} r={R}></circle>
			<path class="zmn__ticks" d={ticks.map((p) => { const a = at(p, p % 100 === 0 ? 70 : 74); const b = at(p, 79); return `M${f(a.x)} ${f(a.y)} L${f(b.x)} ${f(b.y)}`; }).join(' ')}></path>
			{[0, 100, 200, 300, 400].map((p) => { const a = at(p, 61); return <text class="t-small t-num" x={f(a.x)} y={f(a.y + 4)} text-anchor="middle">{p}</text>; })}
			<text class="t-small" x={C.x} y={C.y + 64} text-anchor="middle">кПа</text>
			<rect class="zmn__socket" x={f(P0.x - 8)} y={f(P0.y - 6)} width="16" height="16" rx="2"></rect>
			<path class="zmn__tube" data-tube></path>
			<path class="zmn__tube-in" data-tube-in></path>
			<path class="zmn__link" data-link></path>
			<g data-sector>
				<path class="zmn__sector" d="M0 0 L-9 -19 A21 21 0 0 1 9 -19 Z"></path>
				<path class="zmn__teeth" d={Array.from({ length: 7 }, (_, i) => { const a = ((-112 + i * 7.3) * Math.PI) / 180; return `M${f(21 * Math.cos(a))} ${f(21 * Math.sin(a))} L${f(24 * Math.cos(a))} ${f(24 * Math.sin(a))}`; }).join(' ')}></path>
				<circle class="zmn__pin" cx="0" cy="0" r="2.2"></circle>
			</g>
			<g data-needle>
				<circle class="zmn__gear" cx="0" cy="0" r="5"></circle>
				<path class="zmn__needle" d="M-2.2 10 L0 -64 L2.2 10 Z"></path>
				<circle class="zmn__hub" cx="0" cy="0" r="3.5"></circle>
			</g>
			<circle class="zmn__case" cx={C.x} cy={C.y} r={R}></circle>
			<!-- the labels -->
			<path class="ln" d={`M48 106 L${C.x - R0 - 3} 112 M228 52 L${f(at(340, 79).x)} ${f(at(340, 79).y)} M228 124 L${C.x + 6} ${C.y} M228 160 L${C.x + 8} ${C.y + 10} M228 192 L${C.x + 28} ${C.y + 22}`}></path>
			<text class="t-small" x="4" y="96">изогнутая</text>
			<text class="t-small" x="4" y="108">трубка</text>
			<text class="t-small" x="230" y="55">шкала</text>
			<text class="t-small" x="230" y="128">стрелка</text>
			<text class="t-small" x="230" y="164">зубчатка</text>
			<text class="t-small" x="230" y="196">рычаг</text>
			<text class="t-small" x="66" y="214" text-anchor="middle">кран</text>
			<text class="t-small" x="8" y="256">к сосуду</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Палец давит на резиновую плёнку жидкостного манометра: воздух в коробочке и шланге сжимается и сильнее давит на воду, и в одном колене трубки она опускается, а в другом поднимается. В металлическом манометре давление внутри изогнутой трубки растёт, трубка чуть разгибается и через рычаг и зубчатку поворачивает стрелку. Прогиб плёнки и движение трубки на рисунке сильно увеличены.
	</figcaption>
</figure>

<style is:global>
	.zmn__read {
		font-size: 13px;
	}
	.zmn__table {
		fill: var(--g7-wood);
	}
	.zmn__post {
		fill: var(--g7-steel-dark);
	}
	.zmn__box {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.zmn__film {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.zmn__hose {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.zmn__glass {
		fill: none;
		stroke: var(--g7-glass);
		stroke-width: 2;
	}
	.zmn__water {
		fill: none;
		stroke: var(--g7-blue);
		stroke-opacity: 0.75;
		stroke-width: 12;
	}
	.zmn__bracket {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.zmn-kit-sleeve {
		stroke: color-mix(in oklab, var(--g7-violet) 45%, var(--sl-color-gray-5));
	}
	.zmn__face {
		fill: color-mix(in oklab, var(--sl-color-gray-6) 70%, var(--g7-paper));
	}
	.zmn__case {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 5;
	}
	.zmn__ticks {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.zmn__pipe {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 7;
		stroke-linejoin: round;
	}
	.zmn__gas,
	.zmn__tube-in {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.zmn__valve {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.zmn__handle {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.zmn__nut,
	.zmn__socket {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.zmn__tube {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 7;
		stroke-linecap: round;
	}
	.zmn__link {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.zmn__sector {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	.zmn__teeth {
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.zmn__pin,
	.zmn__hub {
		fill: var(--g7-ink);
	}
	.zmn__gear {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.4;
		stroke-dasharray: 1.6 1.4;
	}
	.zmn__needle {
		fill: var(--g7-ink);
	}
</style>

<script>
	import { ease, fmtInt, loop } from '../g7/kit';
	import { kitArm } from '../atmosfernoe-davlenie/kitArm';

	const ML = 180;
	const MR = 224;
	const MBOT = 196;
	const REST = 124;
	const CM = 4;
	const BX = 70;
	const FILM = 176;
	const C = { x: 140, y: 124 };
	const R0 = 42;
	const PMAX = 400;
	const SP = { x: C.x, y: C.y + 26 }; // the pivot of the toothed sector
	const ARM = 20; // the sector's arm, from the pivot to the lever
	const LINK = 17; // the lever, from the tip of the tube to the arm
	const f = (v: number) => v.toFixed(1);
	// the arm's direction with no pressure (the tip of the tube at 30° on the arc)
	const BETA0 = Math.atan2(C.y + R0 / 2 - SP.y, C.x + (R0 * Math.sqrt(3)) / 2 - LINK - SP.x);
	const lin = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
	const CYCLE = 11;
	// panel 1: two presses, Δh = 4 см and 10 см; each press: the finger comes down (0,35 of the time), then pushes
	const PRESSES = [
		{ t0: 0.8, push: 1.0, hold: 1.5, back: 0.8, dh: 4 },
		{ t0: 5.0, push: 1.0, hold: 2.2, back: 0.8, dh: 10 },
	];
	const finger = (t: number) => {
		for (const s of PRESSES) {
			const t1 = s.t0 + s.push;
			const t2 = t1 + s.hold;
			const t3 = t2 + s.back;
			if (t < s.t0 - 0.6 || t > t3 + 0.6) continue;
			// the approach: from 30 px above the film down to it, 0,6 с before the push and after the release
			const near = t < s.t0 ? ease(lin(t, s.t0 - 0.6, s.t0)) : t > t3 ? 1 - ease(lin(t, t3, t3 + 0.6)) : 1;
			const u = t < t1 ? ease(lin(t, s.t0, t1)) : t < t2 ? 1 : 1 - ease(lin(t, t2, t3));
			return { gap: 30 * (1 - near), dh: s.dh * u };
		}
		return { gap: 30, dh: 0 };
	};
	// panel 2: the pressure in кПа
	const pressure = (t: number) => 250 * (t < 4 ? ease(lin(t, 1, 4)) : 1 - ease(lin(t, 6.5, 9)));

	for (const root of document.querySelectorAll<HTMLElement>('[data-zh-mano]')) {
		const liq = root.querySelector<SVGSVGElement>('[data-p="liquid"]')!;
		const met = root.querySelector<SVGSVGElement>('[data-p="metal"]')!;
		const q1 = (s: string) => liq.querySelector(s)!;
		const q2 = (s: string) => met.querySelector(s)!;
		// a hand 14 см long (60 px) pointing down, the forearm from the upper left (the wrist bent by 66°)
		kitArm(q1('[data-finger]'), { Lh: 60, side: 'R', sleeve: 'zmn-kit-sleeve' })({ at: { x: 0, y: 0 }, pose: 'point', dir: Math.PI / 2, roll: -0.6, bend: -1.15 });
		const draw = (t: number) => {
			// the liquid manometer
			const { gap, dh } = finger(t);
			const sag = 0.9 * dh;
			q1('[data-film]').setAttribute('d', `M${BX - 23} ${FILM} Q${BX} ${f(FILM + 2 * sag)} ${BX + 23} ${FILM}`);
			q1('[data-finger]').setAttribute('transform', `translate(${BX} ${f(FILM + sag - gap)})`);
			const d = (dh * CM) / 2;
			q1('[data-water]').setAttribute('d', `M${ML} ${f(REST + d)} V${MBOT} a22 22 0 0 0 44 0 V${f(REST - d)}`);
			const show = dh > 0.3;
			// the dashed level lines stop at the scale so they do not cross its numbers
			const lv = (y: number) => `M${ML - 12} ${f(y)} H${ML + 8} M${MR - 8} ${f(y)} H${MR + 12}`;
			q1('[data-levels]').setAttribute('d', show ? lv(REST + d) + lv(REST - d) : '');
			(q1('[data-dh-show]') as SVGGElement).style.opacity = show ? '1' : '0';
			const bx = MR + 10;
			q1('[data-bracket]').setAttribute('d', show ? `M${bx - 3} ${f(REST - d)} h6 M${bx - 3} ${f(REST + d)} h6 M${bx} ${f(REST - d)} V${f(REST + d)}` : '');
			q1('[data-dh]').textContent = `${Math.round(dh)} см`;
			q1('[data-read]').textContent = `давление на плёнку: ${fmtInt(9.8 * 1000 * (Math.round(dh) / 100))} Па`;
			// the metal manometer: the tube unbends, the arc length stays
			const p = pressure(t);
			const eps = (0.1 * p) / PMAX;
			const r = R0 / (1 - eps);
			const a0 = (2 * Math.PI) / 3;
			const cx = C.x + (R0 - r) * Math.cos(a0);
			const cy = C.y + (R0 - r) * Math.sin(a0);
			const a1 = a0 + 1.5 * Math.PI * (1 - eps);
			const ex = cx + r * Math.cos(a1);
			const ey = cy + r * Math.sin(a1);
			const p0 = `M${f(C.x + R0 * Math.cos(a0))} ${f(C.y + R0 * Math.sin(a0))}`;
			const arc = `${p0} A${f(r)} ${f(r)} 0 1 1 ${f(ex)} ${f(ey)}`;
			q2('[data-tube]').setAttribute('d', arc);
			const tint = `color-mix(in srgb, var(--g7-red) ${Math.round(15 + (75 * p) / 250)}%, var(--g7-paper))`;
			for (const s of ['[data-tube-in]', '[data-gas]']) (q2(s) as SVGPathElement).style.stroke = tint;
			q2('[data-tube-in]').setAttribute('d', arc);
			// the lever: from the tip of the tube to the end of the sector's arm; the arm follows the tip
			const beta = Math.atan2(ey - SP.y, ex - LINK - SP.x);
			const ax = SP.x + ARM * Math.cos(beta);
			const ay = SP.y + ARM * Math.sin(beta);
			q2('[data-link]').setAttribute('d', `M${f(ex)} ${f(ey)} L${f(ax)} ${f(ay)} L${SP.x} ${SP.y}`);
			q2('[data-sector]').setAttribute('transform', `translate(${SP.x} ${SP.y}) rotate(${f(((beta - BETA0) * 180) / Math.PI)})`);
			q2('[data-needle]').setAttribute('transform', `translate(${C.x} ${C.y}) rotate(${f(-135 + (270 * p) / PMAX)})`);
			q2('[data-read]').textContent = `давление: ${Math.round(p)} кПа`;
		};
		let t = 0;
		draw(t);
		loop(root, (dt) => {
			t = (t + dt) % CYCLE;
			draw(t);
			return true;
		});
	}
</script>
