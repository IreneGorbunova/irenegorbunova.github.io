</style>

<script>
	import { el, loop } from '../g7/kit';
	import { ROLL } from '@components/people/hand';
	import { kitArm } from '../atmosfernoe-davlenie/kitArm';

	type Pt = { x: number; y: number };
	const f = (v: number) => v.toFixed(1);
	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	const ease = (u: number) => {
		const t = clamp(u);
		return t * t * (3 - 2 * t);
	};
	const g = 9.8;

	// area of a polygon below the horizontal line y = L (y down)
	const areaBelow = (poly: Pt[], L: number) => {
		const out: Pt[] = [];
		for (let i = 0; i < poly.length; i++) {
			const a = poly[i];
			const b = poly[(i + 1) % poly.length];
			const ain = a.y >= L;
			const bin = b.y >= L;
			if (ain) out.push(a);
			if (ain !== bin) {
				const k = (L - a.y) / (b.y - a.y);
				out.push({ x: a.x + (b.x - a.x) * k, y: L });
			}
		}
		let s = 0;
		for (let i = 0; i < out.length; i++) {
			const a = out[i];
			const b = out[(i + 1) % out.length];
			s += a.x * b.y - b.x * a.y;
		}
		return Math.abs(s) / 2;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-zh-where]')) {
		const panel = (k: string) => root.querySelector<SVGSVGElement>(`[data-p="${k}"]`)!;

		// ---------- 1. the teapot ----------
		const pot = panel('pot');
		const TB = 190;
		const TC = 100;
		const hwO = (z: number) => {
			if (z < 3) return 20 + 4 * Math.sqrt(1 - ((3 - z) / 3) ** 2);
			if (z < 28) return 24 + 16 * Math.sin((Math.PI / 2) * ((z - 3) / 25));
			if (z <= 70) return 16 + 24 * Math.sqrt(Math.max(0, 1 - ((z - 28) / 42) ** 2));
			return 16;
		};
		const cavity: Pt[] = [];
		for (let z = 3; z <= 74; z += 1) cavity.push({ x: TC + hwO(z) - 3, y: TB - z });
		for (let z = 74; z >= 3; z -= 1) cavity.push({ x: TC - hwO(z) + 3, y: TB - z });
		// the spout: a curve from the wall low on the right up to the tip
		const P0 = { x: TC + 21, y: TB - 14 };
		const P1 = { x: TC + 52, y: TB - 14 };
		const P2 = { x: TC + 64, y: TB - 64 };
		const bez = (s: number): Pt => ({ x: (1 - s) ** 2 * P0.x + 2 * (1 - s) * s * P1.x + s * s * P2.x, y: (1 - s) ** 2 * P0.y + 2 * (1 - s) * s * P1.y + s * s * P2.y });
		const side = (s: number, w: number): Pt => {
			const tx = 2 * (1 - s) * (P1.x - P0.x) + 2 * s * (P2.x - P1.x);
			const ty = 2 * (1 - s) * (P1.y - P0.y) + 2 * s * (P2.y - P1.y);
			const l = Math.hypot(tx, ty);
			const p = bez(s);
			return { x: p.x + (ty / l) * w, y: p.y - (tx / l) * w };
		};
		const ribbon = (w0: number, w1: number): Pt[] => {
			const a: Pt[] = [];
			const b: Pt[] = [];
			for (let i = 0; i <= 24; i++) {
				const s = i / 24;
				const w = w0 + (w1 - w0) * s;
				a.push(side(s, w));
				b.unshift(side(s, -w));
			}
			return [...a, ...b];
		};
		const toD = (p: Pt[]) => `M${p.map((q) => `${f(q.x)} ${f(q.y)}`).join(' L')} Z`;
		const channel = ribbon(4, 2.4);
		pot.querySelector('[data-pot-out-ch]')!.setAttribute('d', toD(ribbon(6.5, 4.2)));
		for (const e of pot.querySelectorAll('[data-pot-ch]')) e.setAttribute('d', toD(channel));
		const lipLocal = side(1, -2.4); // the lower lip of the tip
		const PIV = { x: TC + 24, y: TB }; // the teapot turns about the edge of its foot
		const potG = pot.querySelector<SVGGElement>('[data-pot]')!;
		const potWater = pot.querySelector<SVGRectElement>('[data-potwater]')!;
		const potLevel = pot.querySelector<SVGLineElement>('[data-potlevel]')!;
		const potStream = pot.querySelector<SVGPathElement>('[data-potstream]')!;
		const cupWater = pot.querySelector<SVGPathElement>('[data-cupwater]')!;
		// the hand: 15 см (70 px), the forearm 25 см (90 px) from the upper left; the grip on the handle's bar (6 px)
		const hold = kitArm(pot.querySelector<SVGGElement>('[data-pothand]')!, { Lh: 70, fore: 90, side: 'R', sleeve: 'zwh-kit-sleeve' });
		const GRIP = { x: TC - 58, y: TB - 44 };
		const FORE = Math.atan2(-0.53, -0.85); // the forearm's direction from the wrist, fixed in the picture
		const world = (p: Pt, th: number, lift: number): Pt => {
			const c = Math.cos(th);
			const s = Math.sin(th);
			const dx = p.x - PIV.x;
			const dy = p.y - PIV.y;
			return { x: PIV.x + dx * c - dy * s, y: PIV.y + dx * s + dy * c - lift };
		};
		const amount = (th: number, lift: number, L: number) => areaBelow(cavity.map((p) => world(p, th, lift)), L) + areaBelow(channel.map((p) => world(p, th, lift)), L);
		const V0 = amount(0, 0, TB - 40); // water 40 px deep in the upright teapot
		const CUP = { l: 186, r: 216, bot: 188 };
		let V = V0;
		let tPrev = -1;
		const POT_CYCLE = 10;
		const potDraw = (t: number) => {
			if (t < tPrev) V = V0; // a new cycle: the teapot is full again, the cup empty
			tPrev = t;
			const tilt = t < 1.2 ? 0 : t < 3.6 ? ease((t - 1.2) / 2.4) : t < 5.6 ? 1 : t < 7.6 ? 1 - ease((t - 5.6) / 2) : 0;
			const th = ((33 * Math.PI) / 180) * tilt;
			const lift = 46 * Math.min(1, tilt * 1.6);
			// the level: the line below which lies the amount V (bisection), but not above the lip
			let lo = 0;
			let hi = TB + 10;
			for (let i = 0; i < 40; i++) {
				const mid = (lo + hi) / 2;
				if (amount(th, lift, mid) > V) lo = mid;
				else hi = mid;
			}
			let L = (lo + hi) / 2;
			const lip = world(lipLocal, th, lift);
			let spilling = false;
			if (L < lip.y - 0.05) {
				L = lip.y;
				V = amount(th, lift, L);
				spilling = true;
			}
			potG.setAttribute('transform', `translate(0 ${f(-lift)}) rotate(${f((th * 180) / Math.PI)} ${PIV.x} ${PIV.y})`);
			potWater.setAttribute('transform', `rotate(${f((-th * 180) / Math.PI)} ${PIV.x} ${PIV.y}) translate(0 ${f(lift)})`);
			potWater.setAttribute('y', f(L));
			potLevel.setAttribute('y1', f(L));
			potLevel.setAttribute('y2', f(L));
			const cupFill = Math.min(24, ((V0 - V) / V0) * 70); // px of tea in the cup
			const cw = CUP.bot - cupFill;
			cupWater.setAttribute('d', cupFill > 0.3 ? `M${f(CUP.l + 1 + (188 - cw) * 0.15)} ${f(cw)} H${f(CUP.r - 1 - (188 - cw) * 0.15)} L${CUP.r - 3} ${CUP.bot} H${CUP.l + 3} Z` : '');
			potStream.setAttribute('d', spilling ? `M${f(lip.x)} ${f(lip.y)} Q${f(lip.x + 4)} ${f(lip.y + 4)} ${f(lip.x + 5)} ${f(cw)}` : '');
			// the fingers across the bar, turning with the teapot; the wrist bends by the rest (within ±70°)
			const bend = Math.atan2(Math.sin(FORE - Math.PI - th), Math.cos(FORE - Math.PI - th));
			hold({ at: world(GRIP, th, lift), pose: 'grip', d: 6 / 70, dir: th, roll: ROLL.backViewer, bend });
		};

		// ---------- 2. the gauge glass ----------
		const gauge = panel('gauge');
		const TANKG = { top: 52, bot: 196 };
		const GL = { x: 176, top: 74, bot: 182 };
		const gw = gauge.querySelector<SVGRectElement>('[data-glasswater]')!;
		const gl = gauge.querySelector<SVGLineElement>('[data-gaugelevel]')!;
		const gt = gauge.querySelector<SVGTextElement>('[data-gaugetag]')!;
		const gin = gauge.querySelector<SVGPathElement>('[data-in]')!;
		const gout = gauge.querySelector<SVGPathElement>('[data-out]')!;
		const GAUGE_CYCLE = 10;
		const gaugeDraw = (t: number) => {
			// the level between the joints of the glass, a smooth rise and fall
			const u = 0.5 - 0.5 * Math.cos((2 * Math.PI * t) / GAUGE_CYCLE);
			const y = GL.bot - 16 - u * (GL.bot - GL.top - 32);
			gw.setAttribute('y', f(y));
			gw.setAttribute('height', f(GL.bot - y));
			gl.setAttribute('y1', f(y));
			gl.setAttribute('y2', f(y));
			gt.setAttribute('y', f(y - 6));
			const filling = Math.sin((2 * Math.PI * t) / GAUGE_CYCLE) > 0;
			gin.style.opacity = filling ? '1' : '0.15';
			gout.style.opacity = filling ? '0.15' : '1';
			void TANKG;
		};

		// ---------- 3. the water tower ----------
		const tower = panel('tower');
		const tw = tower.querySelector<SVGRectElement>('[data-towerwater]')!;
		const tl = tower.querySelector<SVGLineElement>('[data-towerlevel]')!;
		const ttag = tower.querySelector<SVGTextElement>('[data-towertag]')!;
		const taps = [...tower.querySelectorAll<SVGPathElement>('[data-tapstream]')];
		const flowUp = tower.querySelector<SVGPathElement>('[data-flow-up]')!;
		const flowMain = tower.querySelector<SVGPathElement>('[data-flow-main]')!;
		const wheel = tower.querySelector<SVGPathElement>('[data-wheel]')!;
		const HOUSE = { top: 92, bot: 200 };
		const floorH = (HOUSE.bot - HOUSE.top) / 3;
		const TOWER_CYCLE = 10;
		let dash = [0, 0, 0];
		let dashMain = 0;
		let dashUp = 0;
		let spin = 0;
		const towerDraw = (t: number, dt: number) => {
			// taps open one by one (1, 2, 3 с) and close at 8 с; the pump runs all the time and keeps the level
			const open = [0, 1, 2].map((i) => t > 1 + i && t < 8);
			const nOpen = open.filter(Boolean).length;
			const level = 44 + 1.2 * nOpen; // the tank's water surface, px (it drops a little while taps run)
			tw.setAttribute('y', f(level));
			tw.setAttribute('height', f(66 - 5 - level));
			tl.setAttribute('y1', f(level));
			tl.setAttribute('y2', f(level));
			ttag.setAttribute('y', f(level - 5));
			taps.forEach((p, i) => {
				const yTap = HOUSE.bot - i * floorH - floorH + 12;
				const dh = yTap - level; // the tank's surface above the tap
				dash[i] = (dash[i] + dt * 6 * Math.sqrt(dh)) % 8;
				p.style.opacity = open[i] ? '1' : '0';
				p.style.strokeDashoffset = f(-dash[i]);
			});
			dashMain = (dashMain + dt * 10 * nOpen) % 12;
			flowMain.style.strokeDashoffset = f(-dashMain);
			flowMain.style.opacity = nOpen ? '1' : '0';
			dashUp = (dashUp + dt * 24) % 12;
			flowUp.style.strokeDashoffset = f(-dashUp);
			spin = (spin + dt * 360) % 360;
			wheel.setAttribute('transform', `rotate(${f(spin)} 155 190)`);
		};

		// ---------- 4. the lock ----------
		const lock = panel('lock');
		const LK = { gl: 132, gu: 288, bedLow: 206, bedUp: 160, low: 156, up: 104 };
		const chamber = lock.querySelector<SVGRectElement>('[data-chamber]')!;
		const ship = lock.querySelector<SVGGElement>('[data-ship]')!;
		const gateLow = lock.querySelector<SVGRectElement>('[data-gate-low]')!;
		const gateUp = lock.querySelector<SVGRectElement>('[data-gate-up]')!;
		const valveLow = lock.querySelector<SVGRectElement>('[data-valve-low]')!;
		const valveUp = lock.querySelector<SVGRectElement>('[data-valve-up]')!;
		const culvUp = lock.querySelector<SVGPathElement>('[data-culv-up]')!;
		const culvLow = lock.querySelector<SVGPathElement>('[data-culv-low]')!;
		const step = lock.querySelector<SVGTextElement>('[data-step]')!;
		const D0 = LK.low - LK.up; // the lift, px
		const FILL = 4; // s to fill or empty the chamber
		// the timeline, s
		const K = { enter: 2.6, closeLow: 3.4, valveUp: 3.7, filled: 7.7, openUp: 8.6, leave: 11.4, closeUp: 12.2, emptied: 16.2, openLow: 17 };
		const LOCK_CYCLE = 17.6;
		const GATE_LIFT = 80; // px the lower gate rises to let the ship through
		const GATE_SINK = 42; // px the upper gate sinks
		let dashLk = 0;
		const lockDraw = (t: number, dt: number) => {
			// the chamber's level: Δ(t) = Δ₀(1 − t/T)² towards the reach it is joined to
			let y = LK.low;
			if (t >= K.valveUp && t < K.closeUp) y = LK.up + D0 * (1 - clamp((t - K.valveUp) / FILL)) ** 2;
			if (t >= K.closeUp) y = LK.low - D0 * (1 - clamp((t - K.closeUp - 0.3) / FILL)) ** 2;
			chamber.setAttribute('y', f(y));
			chamber.setAttribute('height', f(LK.bedLow - y));
			// gates: 0 closed, 1 open (lifted)
			const low = t < K.enter ? 1 : t < K.closeLow ? 1 - ease((t - K.enter) / 0.8) : t < K.emptied ? 0 : ease((t - K.emptied) / 0.8);
			const up = t < K.filled ? 0 : t < K.openUp ? ease((t - K.filled - 0.1) / 0.8) : t < K.leave ? 1 : t < K.closeUp ? 1 - ease((t - K.leave) / 0.8) : 0;
			gateLow.setAttribute('transform', `translate(0 ${f(-GATE_LIFT * low)})`);
			gateUp.setAttribute('transform', `translate(0 ${f(GATE_SINK * up)})`);
			const vUp = t > K.valveUp - 0.3 && t < K.filled;
			const vLow = t > K.closeUp && t < K.emptied;
			valveUp.setAttribute('transform', `translate(0 ${vUp ? -12 : 0})`);
			valveLow.setAttribute('transform', `translate(0 ${vLow ? 12 : 0})`);
			dashLk = (dashLk + dt * 30) % 12;
			culvUp.style.opacity = vUp ? '1' : '0';
			culvLow.style.opacity = vLow ? '1' : '0';
			culvUp.style.strokeDashoffset = f(-dashLk);
			culvLow.style.strokeDashoffset = f(-dashLk);
			// the ship: in from the left at the lower level, out to the right at the upper level
			let sx = (LK.gl + LK.gu) / 2;
			let sy = y;
			let shown = true;
			if (t < K.enter) {
				sx = -40 + (sx + 40) * ease(t / K.enter);
				sy = LK.low;
			} else if (t >= K.openUp) {
				sx = sx + (480 - sx) * clamp((t - K.openUp) / (K.leave - K.openUp)) ** 1.4;
				sy = LK.up;
				shown = t < K.leave;
			}
			if (t >= K.leave) shown = false;
			ship.setAttribute('transform', `translate(${f(sx)} ${f(sy)})`);
			ship.style.opacity = shown ? '1' : '0';
			step.textContent =
				t < K.enter ? 'корабль входит в камеру' : t < K.valveUp ? 'нижние ворота закрываются' : t < K.filled ? 'вода сверху наполняет камеру' : t < K.leave ? 'корабль уходит вверх по реке' : t < K.emptied ? 'вода из камеры уходит вниз' : 'нижние ворота открываются';
		};

		// ---------- 5. the fountain ----------
		const fn = panel('fountain');
		const PXM = 20; // px per metre
		const NZ = { x: 286, y: 196 };
		const HJET = 6.3; // м
		const V0J = Math.sqrt(2 * g * HJET);
		const jet = fn.querySelector<SVGPathElement>("[data-zwh-jet]")!;
		const jetTag = fn.querySelector<SVGTextElement>('[data-jettag]')!;
		const flowFn = fn.querySelector<SVGPathElement>('[data-flow-fn]')!;
		const dropsG = fn.querySelector('[data-drops]')!;
		jet.setAttribute('d', `M${NZ.x} ${NZ.y} V${f(NZ.y - HJET * PXM)}`);
		jetTag.setAttribute('y', f(NZ.y - HJET * PXM + 4));
		const N = 26;
		const TFL = (2 * V0J) / g; // the flight of a drop up and back, s
		const drops = Array.from({ length: N }, (_, i) => {
			const c = el('circle', { class: 'zwh__drop', r: 1.8 });
			dropsG.append(c);
			return { c, phase: (i / N) * TFL, ang: (((i * 37) % 13) - 6) * 0.006 };
		});
		let dashFn = 0;
		const fountainDraw = (t: number, dt: number) => {
			for (const d of drops) {
				const tt = (t + d.phase) % TFL;
				const vx = V0J * Math.sin(d.ang);
				const vy = V0J * Math.cos(d.ang);
				const x = NZ.x + vx * tt * PXM;
				const y = NZ.y - (vy * tt - 0.5 * g * tt * tt) * PXM;
				d.c.setAttribute('cx', f(x));
				d.c.setAttribute('cy', f(Math.min(y, 200)));
				d.c.style.opacity = y > 199 ? '0' : '1';
			}
			dashFn = (dashFn + dt * 30) % 12;
			flowFn.style.strokeDashoffset = f(-dashFn);
		};

		let t = 0;
		const draw = (dt: number) => {
			potDraw(t % POT_CYCLE);
			gaugeDraw(t % GAUGE_CYCLE);
			towerDraw(t % TOWER_CYCLE, dt);
			lockDraw(t % LOCK_CYCLE, dt);
			fountainDraw(t, dt);
		};
		draw(0);
		loop(root, (dt) => {
			t += dt;
			draw(dt);
			return true;
		});
	}
</script>
