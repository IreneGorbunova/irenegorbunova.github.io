---
/**
 * Picture «"Золотое правило" механики в движении»: two panels play in a loop (7,5 с; the lift takes 3,4 с, slowed
 * down). Force arrows in both panels in one scale, 0,12 px per newton (P = 500 Н is 60 px).
 *   Рычаг — arms 0,3 м and 1,5 м (drawn at 100 px per metre), a load of weight P = 500 Н on the short arm, F = 100 Н
 *     on the long one (500 · 0,3 = 100 · 1,5). The bar turns from −9,59° to +9,59° (sin 9,59° = 1/6), so the short
 *     end rises by 2 · 0,3 · 1/6 = 0,1 м and the long end goes down by 0,5 м: the dashed arcs are the paths of the two
 *     ends, the brackets their heights h and 5h. Works: 100 Н · 0,5 м = 500 Н · 0,1 м = 50 Дж.
 *   Подвижный блок — P = 300 Н lifted by 2 м, F = 150 Н, 4 м of rope pulled out (not the numbers of the worked task
 *     that follows, so as not to give its answer away). Drawn at 18 px per metre; the wheel is drawn 1,8 м across and
 *     the man on the platform (48 px for 1,7 м) larger than to scale. One end of the rope is tied to the beam; the man
 *     pulls the free end up hand over hand (strokes of 16 px; one hand pulls, the other goes back down), and the
 *     pulled rope lies on the platform. Every point of the rope keeps its distance along the rope from the tied end,
 *     so the ticks (every 1 м of rope) stand still on the left strand and run round the wheel and up on the right one;
 *     the red mark starts just above the wheel and rises by exactly the length pulled out (the bracket 2h). The dashed
 *     outline marks where the load was at the start. Works: 150 Н · 4 м = 300 Н · 2 м = 600 Дж.
 * The ticks are short dark marks across the rope. The numbers under each panel are the paths so far; the smaller path is rounded to 0,1 and the larger one is
 * 5 or 2 times that rounded number, so they always agree.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic gr not-content" data-goldrule>
	<div class="g7__grid is-two">
		<div>
			<svg class="g7__svg" viewBox="0 0 240 262" role="img" aria-label="Рычаг с плечами 0,3 и 1,5 метра: короткий конец с грузом 500 ньютонов поднимается на 10 сантиметров, длинный конец под силой 100 ньютонов опускается на 50 сантиметров" data-p="lever">
				<g data-draw></g>
			</svg>
			<p class="gr__name">Рычаг</p>
			<p class="gr__sub">плечи 0,3&nbsp;м и 1,5&nbsp;м</p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 240 262" role="img" aria-label="Подвижный блок: человек на помосте тянет верёвку вверх с силой 150 ньютонов и вытягивает 4 метра верёвки, а груз 300 ньютонов поднимается на 2 метра" data-p="pulley">
				<g data-draw></g>
				<g data-man transform="matrix(-1 0 0 1 240 0)"></g>
				<g data-front></g>
			</svg>
			<p class="gr__name">Подвижный блок</p>
			<p class="gr__sub">груз 300&nbsp;Н поднимают на 2&nbsp;м</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Стрелки сил — в одном масштабе. Сила в 5 и в 2 раза меньше, зато её путь во столько же раз длиннее, и работа та же:
		100&nbsp;Н · 0,5&nbsp;м = 500&nbsp;Н · 0,1&nbsp;м, 150&nbsp;Н · 4&nbsp;м = 300&nbsp;Н · 2&nbsp;м.
	</figcaption>
</figure>

<style is:global>
	.gr__name {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.gr__sub {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.gr__bar {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.gr__steel {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.gr__load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.gr__rope {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
	}
	.gr__tick {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.gr__path {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.gr__ghost {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.gr__dim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.gr__thin {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.gr__axle {
		fill: var(--g7-ink);
	}
	.gr__plank {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.gr__post {
		stroke: var(--g7-wood-dark);
		stroke-width: 3;
	}
	.gr__coil {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	[data-goldrule] {
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
		--gr-shirt: hsl(150, 38%, 42%);
	}
	:root[data-theme='light'] [data-goldrule] {
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
		--gr-shirt: hsl(150, 40%, 38%);
	}
	[data-goldrule] .ph-far {
		filter: brightness(0.8);
	}
	[data-goldrule] .ph-outline {
		fill: none;
		stroke: var(--ph-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-goldrule] .ph-pants,
	[data-goldrule] .ph-sleeve,
	[data-goldrule] .ph-skin-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-goldrule] .ph-pants {
		stroke: var(--ph-pants);
	}
	[data-goldrule] .ph-skin-limb {
		stroke: var(--ph-skin);
	}
	[data-goldrule] .ph-sleeve.gr-shirt {
		stroke: var(--gr-shirt);
	}
	[data-goldrule] .ph-shirt.gr-shirt {
		fill: var(--gr-shirt);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-goldrule] .ph-belt {
		fill: var(--ph-line);
	}
	[data-goldrule] .ph-collar {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-goldrule] .ph-skin {
		fill: var(--ph-skin);
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-goldrule] .ph-ear {
		stroke-width: 0.3;
	}
	[data-goldrule] .ph-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-goldrule] .ph-eye {
		fill: var(--ph-line);
	}
	[data-goldrule] .ph-brow,
	[data-goldrule] .ph-mouth {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
		stroke-linecap: round;
	}
	[data-goldrule] .ph-hair {
		fill: var(--ph-hair);
	}
	[data-goldrule] .ph-shoe {
		fill: var(--ph-shoe);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-goldrule] .ph-sole {
		fill: var(--ph-line);
	}
</style>

<script>
	import { el, ease, fmt, loop } from '../g7/kit';
	import { person, type Pose } from '../davlenie-v-zhidkosti/personHome';

	const f = (v: number) => v.toFixed(2);
	const D = Math.PI / 180;
	const K = 0.12; // px per newton
	const CYCLE = 7.5;
	const T0 = 0.6;
	const T1 = 4.0;
	const T2 = 6.2;
	const T3 = 7.5;
	const phase = (t: number) => (t < T0 ? 0 : t < T1 ? ease((t - T0) / (T1 - T0)) : t < T2 ? 1 : 1 - ease((t - T2) / (T3 - T2)));
	const arrow = (x1: number, y1: number, x2: number, y2: number, color: 'red' | 'blue') => {
		const g = el('g', {});
		const L = Math.hypot(x2 - x1, y2 - y1);
		if (L < 0.5) return g;
		const ux = (x2 - x1) / L;
		const uy = (y2 - y1) / L;
		const hl = Math.min(8, L * 0.7);
		const bx = x2 - ux * hl;
		const by = y2 - uy * hl;
		g.append(
			el('line', { class: `arrow arrow--${color}`, x1: f(x1), y1: f(y1), x2: f(bx), y2: f(by) }),
			el('path', { class: `head--${color}`, d: `M${f(x2)} ${f(y2)} L${f(bx - uy * 4.5)} ${f(by + ux * 4.5)} L${f(bx + uy * 4.5)} ${f(by - ux * 4.5)} Z` }),
		);
		return g;
	};
	const dim = (x: number, ya: number, yb: number) => el('path', { class: 'gr__dim', d: `M${x - 3} ${f(ya)} H${x + 3} M${x} ${f(ya)} V${f(yb)} M${x - 3} ${f(yb)} H${x + 3}` });
	const txt = (x: number, y: number, s: string, cls: string, anchor = 'start') => el('text', { class: cls, x: f(x), y: f(y), 'text-anchor': anchor }, s);
	/** Hand over hand: the rope has moved by s px; one hand moves with it, the other goes back off the rope. */
	const handOverHand = (s: number, x: number, yFrom: number, yTo: number, off: number) => {
		const st = Math.abs(yTo - yFrom);
		const dir = Math.sign(yTo - yFrom);
		const n = Math.floor(s / st);
		const ph = s - n * st;
		const grip = { x, y: yFrom + dir * ph };
		const back = { x: x + off, y: yTo - dir * ph };
		return n % 2 === 0 ? [grip, back] : [back, grip];
	};


	// the lever: pivot O, arms 30 and 150 px
	const O = { x: 61, y: 100 };
	const L1 = 30;
	const GROUND = 196;
	const TY = 236; // the first line of the numbers under the drawing
	const L2 = 150;
	const TH = Math.asin(1 / 6);
	const drawLever = (g: SVGGElement, u: number) => {
		const th = -TH + 2 * TH * u;
		const c = Math.cos(th);
		const s = Math.sin(th);
		const left = { x: O.x - L1 * c, y: O.y - L1 * s };
		const right = { x: O.x + L2 * c, y: O.y + L2 * s };
		const left0 = { x: O.x - L1 * Math.cos(TH), y: O.y + L1 * Math.sin(TH) };
		const right0 = { x: O.x + L2 * Math.cos(TH), y: O.y - L2 * Math.sin(TH) };
		// the stand and the ground
		g.append(el('line', { class: 'gr__dim', x1: 4, x2: 236, y1: GROUND, y2: GROUND }), el('rect', { class: 'gr__steel', x: O.x - 4, y: O.y + 18, width: 8, height: GROUND - O.y - 18 }), el('path', { class: 'gr__steel', d: `M${O.x} ${O.y + 1} L${O.x + 11} ${O.y + 20} H${O.x - 11} Z` }));
		// the paths of the ends
		if (u > 0.002) {
			g.append(
				el('path', { class: 'gr__path', d: `M${f(left0.x)} ${f(left0.y)} A${L1} ${L1} 0 0 1 ${f(left.x)} ${f(left.y)}` }),
				el('path', { class: 'gr__path', d: `M${f(right0.x)} ${f(right0.y)} A${L2} ${L2} 0 0 1 ${f(right.x)} ${f(right.y)}` }),
			);
		}
		// the bar with its arms
		const bar = el('g', { transform: `rotate(${f(th / D)} ${O.x} ${O.y})` });
		bar.append(
			el('rect', { class: 'gr__bar', x: O.x - L1 - 5, y: O.y - 2.5, width: L1 + L2 + 10, height: 5, rx: 1.5 }),
			el('circle', { class: 'gr__axle', cx: O.x, cy: O.y, r: 2.4 }),
			txt(O.x - L1 / 2, O.y - 7, '0,3 м', 't-small t-halo', 'middle'),
			txt(O.x + L2 / 2, O.y - 7, '1,5 м', 't-small t-halo', 'middle'),
		);
		g.append(bar);
		// the load hangs from the short end
		const bt = left.y + 12;
		g.append(el('line', { class: 'gr__thin', x1: f(left.x), y1: f(left.y), x2: f(left.x), y2: f(bt) }), el('rect', { class: 'gr__load', x: f(left.x - 12), y: f(bt), width: 24, height: 20, rx: 2 }));
		g.append(arrow(left.x, bt + 10, left.x, bt + 10 + 500 * K, 'blue'), txt(left.x + 7, bt + 46, 'P', 't-i t-blue t-halo'));
		g.append(arrow(right.x, right.y - 3 - 100 * K, right.x, right.y - 3, 'red'), txt(right.x - 7, right.y - 13, 'F', 't-i t-red t-halo', 'end'));
		// heights
		const hpx = left0.y - left.y;
		if (hpx > 0.5) g.append(dim(13, left0.y, left.y), txt(9, (left0.y + left.y) / 2 + 5, 'h', 't-i t-halo', 'end'));
		if (right.y - right0.y > 0.5) g.append(dim(221, right0.y, right.y), txt(225, (right0.y + right.y) / 2 + 5, '5h', 't-i t-halo'));
		const h = Math.round(hpx * 10) / 10; // cm (1 px = 1 см)
		g.append(txt(120, TY, `сила F = 100\u00a0Н — путь ${fmt(5 * h, 1)}\u00a0см`, 't-num t-red', 'middle'), txt(120, TY + 20, `сила P = 500\u00a0Н — путь ${fmt(h, 1)}\u00a0см`, 't-num t-blue', 'middle'));
	};

	// the movable pulley: 18 px per metre; the man stands on a platform and pulls the free end up hand over hand
	const SC = 18;
	const R = 16;
	const CX = 100;
	const YC0 = 150;
	const BEAM = 14;
	const PF = 62; // the platform's top
	const MH = 48; // the man, px for 1,7 м
	const Y_TOP = 15; // the hands grip between these heights
	const Y_BOT = 31;
	const MARK0 = YC0 - 6; // the red mark on the rope at the start
	const drawPulley = (g: SVGGElement, fg: SVGGElement, pose: (p: Pose) => void, u: number) => {
		const rise = 2 * SC * u;
		const pulled = 2 * rise;
		const yc = YC0 - rise;
		const xl = CX - R;
		const xr = CX + R;
		const box = (y: number) => ({ top: y + R + 10, bottom: y + R + 32 });
		// the beam the rope is tied to, the platform and its posts
		let hatch = '';
		for (let x = 60; x < 104; x += 8) hatch += `M${x} ${BEAM - 8} l6 -6 `;
		g.append(el('rect', { class: 'gr__steel', x: 56, y: BEAM - 8, width: 50, height: 8 }), el('path', { class: 'gr__thin', d: hatch }));
		g.append(
			el('line', { class: 'gr__post', x1: 150, x2: 150, y1: PF + 6, y2: 226 }),
			el('line', { class: 'gr__post', x1: 226, x2: 226, y1: PF + 6, y2: 226 }),
			el('line', { class: 'gr__dim', x1: 136, x2: 240, y1: 226, y2: 226 }),
			el('rect', { class: 'gr__plank', x: 120, y: PF, width: 122, height: 6 }),
		);
		// where the load was at the start
		g.append(el('rect', { class: 'gr__ghost', x: CX - 13, y: box(YC0).top, width: 26, height: 22, rx: 2 }));
		// the rope: tied to the beam, under the wheel, up through the hands; the pulled rope lies on the platform
		const lenL = yc - BEAM;
		const lenA = Math.PI * R;
		const yEnd = Y_TOP - 3;
		const lenTot = lenL + lenA + (yc - yEnd);
		const coils = 1 + Math.floor(pulled / 14);
		for (let i = 0; i < coils; i++) g.append(el('ellipse', { class: 'gr__coil', cx: 126 + (i % 2), cy: f(PF - 1.8 - i * 1.4), rx: 5 + (i % 2), ry: 1.6 }));
		g.append(
			el('path', { class: 'gr__rope', d: `M${xl} ${BEAM} V${f(yc)} A${R} ${R} 0 0 0 ${xr} ${f(yc)} V${yEnd}` }),
			el('path', { class: 'gr__rope', d: `M${xr} ${yEnd} Q${xr + 1} ${yEnd - 4} ${xr + 4} ${yEnd - 2} Q${xr + 8} ${yEnd + 2} ${xr + 9} ${PF - 4}` }),
		);
		let ticks = '';
		for (let sg = SC; sg < lenTot - 2; sg += SC) {
			let x: number;
			let y: number;
			let tx: number;
			let ty: number;
			if (sg <= lenL) [x, y, tx, ty] = [xl, BEAM + sg, 0, 1];
			else if (sg <= lenL + lenA) {
				const a = Math.PI - (sg - lenL) / R;
				[x, y, tx, ty] = [CX + R * Math.cos(a), yc + R * Math.sin(a), Math.sin(a), -Math.cos(a)];
			} else [x, y, tx, ty] = [xr, yc - (sg - lenL - lenA), 0, -1];
			ticks += `M${f(x - ty * 3.6)} ${f(y + tx * 3.6)} L${f(x + ty * 3.6)} ${f(y - tx * 3.6)} `;
		}
		g.append(el('path', { class: 'gr__tick', d: ticks }));
		// the pulley with its holder and the load
		let sp = '';
		const turn = -rise / R;
		for (let i = 0; i < 3; i++) {
			const a = turn + (i * 2 * Math.PI) / 3;
			sp += `M${CX} ${f(yc)} L${f(CX + (R - 4) * Math.cos(a))} ${f(yc + (R - 4) * Math.sin(a))} `;
		}
		const b = box(yc);
		g.append(
			el('rect', { class: 'gr__steel', x: CX - 2.5, y: f(yc), width: 5, height: R + 6, rx: 1.5 }),
			el('circle', { class: 'gr__thin', cx: CX, cy: f(b.top - 3), r: 3 }),
			el('rect', { class: 'gr__load', x: CX - 13, y: f(b.top), width: 26, height: 22, rx: 2 }),
			el('circle', { class: 'gr__steel', cx: CX, cy: f(yc), r: R }),
			el('path', { class: 'gr__thin', d: sp }),
			el('circle', { class: 'gr__axle', cx: CX, cy: f(yc), r: 2.4 }),
		);
		// the man (his pose in the panel's coordinates; his group is mirrored)
		const [hn, hf] = handOverHand(pulled, xr + 0.5, Y_BOT, Y_TOP, 2.5);
		const m = (q: { x: number; y: number }) => ({ x: 240 - q.x, y: q.y });
		const ank = PF - (MH / 170) * 7.5;
		pose({ hip: m({ x: 133, y: PF - 0.5 * MH }), lean: 0.4, ankles: [m({ x: 128, y: ank }), m({ x: 138, y: ank })], feet: [0, 0], hands: [m(hn), m(hf)], head: 0.35 });
		// the red mark on the rope and its path 2h
		const my = MARK0 - pulled;
		fg.append(el('rect', { class: 'head--red', x: xr - 4, y: f(my - 2), width: 8, height: 4, rx: 1 }));
		// forces
		fg.append(arrow(CX, b.top + 11, CX, b.top + 11 + 300 * K, 'blue'), txt(CX + 7, b.top + 42, 'P', 't-i t-blue t-halo'));
		fg.append(arrow(xr - 8, 58, xr - 8, 58 - 150 * K, 'red'), txt(xr - 13, 52, 'F', 't-i t-red t-halo', 'end'));
		// heights
		if (rise > 0.5) {
			fg.append(dim(72, box(YC0).bottom, b.bottom), txt(67, (box(YC0).bottom + b.bottom) / 2 + 5, 'h', 't-i t-halo', 'end'));
			fg.append(dim(128, MARK0, my), txt(132, (MARK0 + my) / 2 + 5, '2h', 't-i t-halo'));
		}
		const h = Math.round((rise / SC) * 10) / 10;
		fg.append(txt(120, TY, `сила F = 150\u00a0Н — путь ${fmt(2 * h, 1)}\u00a0м`, 't-num t-red', 'middle'), txt(120, TY + 20, `сила P = 300\u00a0Н — путь ${fmt(h, 1)}\u00a0м`, 't-num t-blue', 'middle'));
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-goldrule]')) {
		const gl = root.querySelector<SVGGElement>('[data-p="lever"] [data-draw]')!;
		const gp = root.querySelector<SVGGElement>('[data-p="pulley"] [data-draw]')!;
		const fp = root.querySelector<SVGGElement>('[data-p="pulley"] [data-front]')!;
		const pose = person(root.querySelector<SVGGElement>('[data-p="pulley"] [data-man]')!, { s: MH / 170, H: 170, girth: 1, shirt: 'gr-shirt' });
		let t = 0;
		const frame = () => {
			const u = phase(t % CYCLE);
			gl.replaceChildren();
			gp.replaceChildren();
			fp.replaceChildren();
			drawLever(gl, u);
			drawPulley(gp, fp, pose, u);
		};
		frame();
		loop(root, (dt) => {
			t += dt;
			frame();
			return true;
		});
	}
</script>
