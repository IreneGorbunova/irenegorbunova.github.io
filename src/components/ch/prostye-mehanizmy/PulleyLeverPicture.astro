---
/**
 * Picture «Блок — это рычаг»: two panels in a loop (6 с; slowed down). The violet bar is the lever hidden in the
 * pulley at this moment: the horizontal diameter of the wheel between the two strands of the rope.
 *   Неподвижный блок — the pivot is the axle O; the strands pull at the ends of the diameter, both arms are the radius
 *     r: P · r = F · r, F = P. The load rises and the free end goes down by the same 20 px.
 *   Подвижный блок — one end of the rope is tied to the beam; the wheel rolls up that strand without slipping, so at
 *     every moment the point O where the wheel leaves the fixed strand stands still: it is the pivot. The weight of
 *     the load acts at the axle (arm r), the free strand pulls at the other end of the diameter (arm 2r):
 *     P · r = F · 2r, F = P/2. The wheel rises by 14 px, 28 px of rope are pulled out, the wheel turns by 14/r rad.
 * The people (personHome.ts, 60 and 48 px for 1,7 м, larger than to scale): in the first panel a man on the floor
 * pulls the rope down with both hands; in the second a man on a platform pulls the free end up hand over hand
 * (strokes of 15 px), and the pulled rope lies on the platform.
 * Forces in one scale: P = 400 Н is 48 px, F = 400 Н or 200 Н. The wheels (r = 34 px) are drawn much larger than in
 * the model of the chapter, so the arms can be read.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 g7--pic pl not-content" data-pulleylever>
	<div class="g7__grid is-two">
		<div>
			<svg class="g7__svg" viewBox="0 0 240 236" role="img" aria-label="Неподвижный блок как рычаг: опора — ось колеса, плечи обеих сил равны радиусу, сила равна весу груза" data-p="fixed">
				<g data-draw></g>
				<g data-man transform="matrix(-1 0 0 1 240 0)"></g>
				<g data-front></g>
			</svg>
			<p class="pl__name">Неподвижный блок</p>
			<p class="pl__sub">рычаг с равными плечами <i>r</i> и <i>r</i></p>
		</div>
		<div>
			<svg class="g7__svg" viewBox="0 0 240 236" role="img" aria-label="Подвижный блок как рычаг: опора — точка, где колесо касается закреплённой верёвки, плечо веса груза — радиус, плечо силы — диаметр, сила вдвое меньше веса" data-p="mov">
				<g data-draw></g>
				<g data-man transform="matrix(-1 0 0 1 240 0)"></g>
				<g data-front></g>
			</svg>
			<p class="pl__name">Подвижный блок</p>
			<p class="pl__sub">рычаг с плечами <i>r</i> и 2<i>r</i>, опора <i>O</i> — на закреплённой ветви</p>
		</div>
	</div>
	<figcaption class="g7__caption">
		Фиолетовая линия — рычаг, который «спрятан» в блоке, точка <i>O</i> — его опора. У подвижного блока плечо силы
		вдвое длиннее плеча веса, поэтому сила вдвое меньше.
	</figcaption>
</figure>

<style is:global>
	.pl__name {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.pl__sub {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.pl__steel {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pl__rim {
		fill: color-mix(in srgb, var(--g7-steel) 18%, transparent);
		stroke: var(--g7-steel);
		stroke-width: 5;
	}
	.pl__spoke {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 2;
	}
	.pl__load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pl__rope {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
	}
	.pl__thin {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.pl__lever {
		stroke: var(--g7-violet);
		stroke-width: 4.5;
		stroke-linecap: round;
	}
	.pl__pivot {
		fill: var(--g7-violet);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	.pl__dim {
		fill: none;
		stroke: var(--g7-violet);
		stroke-width: 1.2;
	}
	.pl__axle {
		fill: var(--g7-ink);
	}
	.g7__svg .t-violet {
		fill: var(--g7-violet);
	}
	.pl__plank {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.pl__post {
		stroke: var(--g7-wood-dark);
		stroke-width: 3;
	}
	.pl__coil {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	[data-pulleylever] {
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
		--pl-shirt: hsl(150, 38%, 42%);
	}
	:root[data-theme='light'] [data-pulleylever] {
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
		--pl-shirt: hsl(150, 40%, 38%);
	}
	[data-pulleylever] .ph-far {
		filter: brightness(0.8);
	}
	[data-pulleylever] .ph-outline {
		fill: none;
		stroke: var(--ph-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-pulleylever] .ph-pants,
	[data-pulleylever] .ph-sleeve,
	[data-pulleylever] .ph-skin-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-pulleylever] .ph-pants {
		stroke: var(--ph-pants);
	}
	[data-pulleylever] .ph-skin-limb {
		stroke: var(--ph-skin);
	}
	[data-pulleylever] .ph-sleeve.pl-shirt {
		stroke: var(--pl-shirt);
	}
	[data-pulleylever] .ph-shirt.pl-shirt {
		fill: var(--pl-shirt);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-pulleylever] .ph-belt {
		fill: var(--ph-line);
	}
	[data-pulleylever] .ph-collar {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-pulleylever] .ph-skin {
		fill: var(--ph-skin);
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-pulleylever] .ph-ear {
		stroke-width: 0.3;
	}
	[data-pulleylever] .ph-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-pulleylever] .ph-eye {
		fill: var(--ph-line);
	}
	[data-pulleylever] .ph-brow,
	[data-pulleylever] .ph-mouth {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
		stroke-linecap: round;
	}
	[data-pulleylever] .ph-hair {
		fill: var(--ph-hair);
	}
	[data-pulleylever] .ph-shoe {
		fill: var(--ph-shoe);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-pulleylever] .ph-sole {
		fill: var(--ph-line);
	}
</style>

<script>
	import { el, ease, loop } from '../g7/kit';
	import { person, type Pose } from '../davlenie-v-zhidkosti/personHome';

	const f = (v: number) => v.toFixed(2);
	const D = Math.PI / 180;
	const K = 0.12; // px per newton
	const R = 34;
	const CYCLE = 6;
	const phase = (t: number) => (t < 0.5 ? 0 : t < 2.9 ? ease((t - 0.5) / 2.4) : t < 4.4 ? 1 : 1 - ease((t - 4.4) / 1.6));
	const arrow = (x1: number, y1: number, x2: number, y2: number, color: 'red' | 'blue') => {
		const g = el('g', {});
		const L = Math.hypot(x2 - x1, y2 - y1);
		const ux = (x2 - x1) / L;
		const uy = (y2 - y1) / L;
		const hl = Math.min(8, L * 0.7);
		const bx = x2 - ux * hl;
		const by = y2 - uy * hl;
		g.append(
			el('line', { class: `arrow arrow--${color}`, x1: f(x1), y1: f(y1), x2: f(bx), y2: f(by) }),
			el('path', { class: `head--${color}`, d: `M${f(x2)} ${f(y2)} L${f(bx - uy * 4.5)} ${f(by + ux * 4.5)} L${f(bx + uy * 4.5)} ${f(by - ux * 4.5)} Z` }),
		);
		return g;
	};
	const txt = (x: number, y: number, s: string, cls: string, anchor = 'start') => el('text', { class: cls, x: f(x), y: f(y), 'text-anchor': anchor }, s);
	/** Hand over hand: the rope has moved by s px; one hand moves with it, the other goes back off the rope. */
	const handOverHand = (s: number, x: number, yFrom: number, yTo: number, off: number) => {
		const st = Math.abs(yTo - yFrom);
		const dir = Math.sign(yTo - yFrom);
		const n = Math.floor(s / st);
		const ph = s - n * st;
		const grip = { x, y: yFrom + dir * ph };
		const back = { x: x + off, y: yTo - dir * ph };
		return n % 2 === 0 ? [grip, back] : [back, grip];
	};
	const wheel = (cx: number, cy: number, turn: number) => {
		let sp = '';
		for (let i = 0; i < 3; i++) {
			const a = turn + (i * 2 * Math.PI) / 3;
			sp += `M${f(cx)} ${f(cy)} L${f(cx + (R - 6) * Math.cos(a))} ${f(cy + (R - 6) * Math.sin(a))} `;
		}
		return [el('circle', { class: 'pl__rim', cx: f(cx), cy: f(cy), r: R - 2.5 }), el('path', { class: 'pl__spoke', d: sp })];
	};
	const beam = (x: number, w: number) => {
		let d = '';
		for (let i = x + 4; i < x + w; i += 8) d += `M${i} 8 l6 -6 `;
		return [el('rect', { class: 'pl__steel', x, y: 8, width: w, height: 8 }), el('path', { class: 'pl__thin', d })];
	};

	type Pose_ = (p: Pose) => void;
	const mir = (q: { x: number; y: number }) => ({ x: 240 - q.x, y: q.y });
	const drawFixed = (g: SVGGElement, fg: SVGGElement, pose: Pose_, u: number) => {
		const d = 20 * u; // the load rises, the free end goes down
		const C = { x: 120, y: 66 };
		const xl = C.x - R;
		const xr = C.x + R;
		const top = 132 - d; // the load's top
		g.append(...beam(84, 72), el('rect', { class: 'pl__steel', x: C.x - 3, y: 16, width: 6, height: C.y - 16 }));
		g.append(el('line', { class: 'pl__dim', x1: 0, x2: 240, y1: 192, y2: 192, style: 'stroke: var(--g7-ink)' }));
		g.append(el('path', { class: 'pl__rope', d: `M${xl} ${f(top)} V${C.y} A${R} ${R} 0 0 1 ${xr} ${C.y} V190` }));
		for (let i = 0; i < 2 + Math.floor(d / 8); i++) g.append(el('ellipse', { class: 'pl__coil', cx: xr + 3 + (i % 2), cy: f(190 - i * 1.4), rx: 6, ry: 1.6 }));
		g.append(...wheel(C.x, C.y, d / R), el('rect', { class: 'pl__load', x: xl - 15, y: f(top), width: 30, height: 26, rx: 2 }));
		const ank = 192 - (60 / 170) * 7.5;
		pose({
			hip: mir({ x: 172, y: 163 }),
			lean: 0.1 + 0.2 * (d / 20),
			ankles: [mir({ x: 166, y: ank }), mir({ x: 177, y: ank })],
			feet: [0, 0],
			hands: [mir({ x: xr + 0.5, y: 136 + d }), mir({ x: xr + 0.5, y: 142 + d })],
			head: -0.3,
		});
		g = fg;
		// the lever
		g.append(el('line', { class: 'pl__lever', x1: xl, y1: C.y, x2: xr, y2: C.y }), el('circle', { class: 'pl__pivot', cx: C.x, cy: C.y, r: 4 }));
		g.append(txt(C.x, C.y + 17, 'O', 't-i t-violet t-halo', 'middle'), txt(C.x - R / 2, C.y - 7, 'r', 't-i t-violet t-halo', 'middle'), txt(C.x + R / 2, C.y - 7, 'r', 't-i t-violet t-halo', 'middle'));
		g.append(arrow(xl, C.y, xl, C.y + 400 * K, 'blue'), txt(xl - 7, C.y + 44, 'P', 't-i t-blue t-halo', 'end'));
		g.append(arrow(xr, C.y, xr, C.y + 400 * K, 'red'), txt(xr + 7, C.y + 44, 'F', 't-i t-red t-halo'));
		g.append(txt(120, 206, 'P · r = F · r', 't-i', 'middle'), txt(120, 226, 'F = P', 't-i t-strong', 'middle'));
	};

	const drawMov = (g: SVGGElement, fg: SVGGElement, pose: Pose_, u: number) => {
		const rise = 14 * u;
		const C = { x: 110, y: 112 - rise };
		const xl = C.x - R;
		const xr = C.x + R;
		const PF = 56; // the platform's top
		const Y_TOP = 13;
		const Y_BOT = 28;
		const yEnd = Y_TOP - 3;
		const top = C.y + R + 12; // the load's top
		g.append(...beam(xl - 30, 54));
		g.append(
			el('line', { class: 'pl__post', x1: 175, x2: 175, y1: PF + 6, y2: 192 }),
			el('line', { class: 'pl__post', x1: 230, x2: 230, y1: PF + 6, y2: 192 }),
			el('line', { class: 'pl__dim', x1: 160, x2: 240, y1: 192, y2: 192, style: 'stroke: var(--g7-ink)' }),
			el('rect', { class: 'pl__plank', x: 146, y: PF, width: 96, height: 6 }),
		);
		for (let i = 0; i < 1 + Math.floor((2 * rise) / 8); i++) g.append(el('ellipse', { class: 'pl__coil', cx: 153 + (i % 2), cy: f(PF - 1.8 - i * 1.4), rx: 5, ry: 1.6 }));
		g.append(
			el('path', { class: 'pl__rope', d: `M${xl} 16 V${f(C.y)} A${R} ${R} 0 0 0 ${xr} ${f(C.y)} V${yEnd}` }),
			el('path', { class: 'pl__rope', d: `M${xr} ${yEnd} Q${xr + 1} ${yEnd - 4} ${xr + 4} ${yEnd - 2} Q${xr + 8} ${yEnd + 2} ${xr + 9} ${PF - 4}` }),
		);
		g.append(
			el('rect', { class: 'pl__steel', x: C.x - 3, y: f(C.y), width: 6, height: R + 8, rx: 1.5 }),
			el('circle', { class: 'pl__thin', cx: C.x, cy: f(top - 3), r: 3.2 }),
			el('rect', { class: 'pl__load', x: C.x - 15, y: f(top), width: 30, height: 26, rx: 2 }),
			...wheel(C.x, C.y, -rise / R),
		);
		const [hn, hf] = handOverHand(2 * rise, xr + 0.5, Y_BOT, Y_TOP, 2.5);
		const ank = PF - (48 / 170) * 7.5;
		pose({ hip: mir({ x: 159, y: PF - 24 }), lean: 0.4, ankles: [mir({ x: 154, y: ank }), mir({ x: 164, y: ank })], feet: [0, 0], hands: [mir(hn), mir(hf)], head: 0.35 });
		g = fg;
		// the lever: from O on the fixed strand to the free strand
		g.append(el('line', { class: 'pl__lever', x1: xl, y1: f(C.y), x2: xr, y2: f(C.y) }), el('circle', { class: 'pl__axle', cx: C.x, cy: f(C.y), r: 2.6 }), el('circle', { class: 'pl__pivot', cx: xl, cy: f(C.y), r: 4.5 }));
		g.append(txt(xl - 8, C.y + 5, 'O', 't-i t-violet t-halo', 'end'), txt(C.x - R / 2, C.y - 7, 'r', 't-i t-violet t-halo', 'middle'));
		const yd = C.y - R - 10;
		g.append(el('path', { class: 'pl__dim', d: `M${xl} ${f(yd - 4)} V${f(yd + 4)} M${xl} ${f(yd)} H${xr} M${xr} ${f(yd - 4)} V${f(yd + 4)}` }), txt(C.x, yd - 5, '2r', 't-i t-violet t-halo', 'middle'));
		g.append(arrow(C.x, C.y, C.x, C.y + 400 * K, 'blue'), txt(C.x + 8, C.y + 44, 'P', 't-i t-blue t-halo'));
		g.append(arrow(xr, C.y, xr, C.y - 200 * K, 'red'), txt(xr + 7, C.y - 12, 'F', 't-i t-red t-halo'));
		g.append(txt(120, 206, 'P · r = F · 2r', 't-i', 'middle'), txt(120, 226, 'F = P/2', 't-i t-strong', 'middle'));
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-pulleylever]')) {
		const gf = root.querySelector<SVGGElement>('[data-p="fixed"] [data-draw]')!;
		const gm = root.querySelector<SVGGElement>('[data-p="mov"] [data-draw]')!;
		const ff = root.querySelector<SVGGElement>('[data-p="fixed"] [data-front]')!;
		const fm = root.querySelector<SVGGElement>('[data-p="mov"] [data-front]')!;
		const man = (k: string, H: number) => person(root.querySelector<SVGGElement>(`[data-p="${k}"] [data-man]`)!, { s: H / 170, H: 170, girth: 1, shirt: 'pl-shirt' });
		const pf = man('fixed', 60);
		const pm = man('mov', 48);
		let t = 0;
		const frame = () => {
			const u = phase(t % CYCLE);
			gf.replaceChildren();
			gm.replaceChildren();
			ff.replaceChildren();
			fm.replaceChildren();
			drawFixed(gf, ff, pf, u);
			drawMov(gm, fm, pm, u);
		};
		frame();
		loop(root, (dt) => {
			t += dt;
			frame();
			return true;
		});
	}
</script>
