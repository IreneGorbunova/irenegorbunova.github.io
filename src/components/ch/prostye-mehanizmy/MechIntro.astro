---
/**
 * Two short looping opening scenes of «Простые механизмы. Рычаг, блок». No terms of the chapter in the pictures.
 * The people are those of «Давление в жидкости» (../davlenie-v-zhidkosti/personHome.ts: light clothes, adult
 * proportions); the girl is drawn with a head 1,3 times larger, as a child of six has (about 6 heads tall).
 *
 * Seesaw: a board 4,4 м long on a trestle 0,5 м high (60 px per metre). A girl of 20 кг (115 см) sits 2 м to the
 *   left of the axle, her father of 80 кг (180 см) 2 м to the right. His side is down: the end of the board rests on
 *   the ground (the board is then tilted by 13,1°, sin = 0,5 м / 2,2 м). He moves toward the axle in three hops of
 *   0,5 м, his feet on the ground. At 0,5 м from the axle 80 кг · 0,5 м = 20 кг · 2 м: he lifts his feet, and the
 *   board comes level and stays so. (At exact balance a board stays at any tilt; the scene shows it level.)
 * Crowbar: a granite stone 0,62 × 0,5 × 0,5 м (about 400 кг, weight about 4000 Н) lies flat on the ground; to lift its
 *   near edge, turning it about the far edge, one has to push it up with about 2000 Н. The worker (175 см) puts the tip
 *   of a crowbar under the bevel of the edge (3 см above the ground) and the bar over a wooden block 12,6 см high,
 *   0,15 м from the tip; his hands are 1,5 м from the block, so the arms are 1 : 10 and he presses with 200 Н. The bar
 *   turns from 40° to 10°: the hands go down from 1,09 м to 0,39 м (70 см), the edge of the stone rises 7 см
 *   (0,15 м · (sin 40° − sin 10°)), and the stone tilts by 5,6°. 120 px per metre, true scale.
 *   The arrows are to one scale, 14 px per 200 Н: 200 Н, with which the hands press on the bar, and 2000 Н, with which
 *   the bar lifts the stone.
 * Both scenes are slowed down to read: 6 с and 5 с.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-mechintro>
	<div class="intro__card" data-scene="seesaw">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Отец и дочь сидят на качелях-доске. Сторона отца опущена до земли. Отец пересаживается ближе к опоре, и доска выравнивается">
			<rect class="mc-sky" x="0" y="0" width="360" height="240"></rect>
			<g class="mc-tree">
				<rect class="mc-trunk" x="322" y="120" width="8" height="90" rx="2"></rect>
				<circle class="mc-crown" cx="326" cy="104" r="28"></circle>
				<circle class="mc-crown" cx="306" cy="124" r="18"></circle>
				<circle class="mc-crown" cx="346" cy="122" r="20"></circle>
				<rect class="mc-trunk" x="20" y="140" width="6" height="68" rx="2"></rect>
				<circle class="mc-crown" cx="23" cy="128" r="20"></circle>
				<circle class="mc-crown" cx="10" cy="144" r="13"></circle>
			</g>
			<rect class="mc-ground" x="0" y="206" width="360" height="34"></rect>
			<path class="mc-trestle" d="M180 176 L160 206 M180 176 L200 206 M168 194 H192"></path>
			<g data-board>
				<rect class="mc-plank" x="48" y="170" width="264" height="6" rx="2.5"></rect>
			</g>
			<circle class="mc-axle" cx="180" cy="176" r="3.5"></circle>
			<g data-girl></g>
			<g transform="translate(360 0) scale(-1 1)"><g data-dad></g></g>
			<text class="mc-tag" data-tag-girl text-anchor="middle">20&nbsp;кг</text>
			<text class="mc-tag" data-tag-dad text-anchor="middle">80&nbsp;кг</text>
			<text class="mc-num" x="180" y="24" text-anchor="middle" data-dist></text>
		</svg>
		<div class="intro__foot">
			<p>
				Отец вчетверо тяжелее дочери, и качели перевешивают в его сторону. Он пересаживается{' '}
				<More term="вчетверо ближе к опоре">
					Груз на качелях действует тем сильнее, чем дальше он от опоры. Девочка массой 20&nbsp;кг в двух метрах от опоры уравновешивает отца массой 80&nbsp;кг, если он сядет в полуметре от опоры: 80 · 0,5 = 20 · 2. Об этом — в разделе{' '}
					<a href="#рычаг">«Рычаг»</a>.
				</More>, и качели приходят в равновесие.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="bar">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Рабочий наклонился и давит на длинный конец лома с силой 200 ньютонов. Короткий конец лома приподнимает край тяжёлого камня с силой 2000 ньютонов">
			<rect class="mc-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="mc-ground" x="0" y="214" width="360" height="26"></rect>
			<path class="mc-grass" d="M150 214 l3 -7 l2 7 M157 214 l2 -5 l2 5 M196 214 l2 -6 l3 6 M120 214 l2 -5 l2 5 M300 214 l2 -6 l2 6"></path>
			<path class="mc-gap" data-gap></path>
			<g data-stone>
				<path class="mc-stone" d="M0 0 L68 0 L76 -9 Q80 -16 80 -34 Q79 -46 68 -51 Q42 -58 18 -54 Q2 -50 -1 -36 Q-3 -18 0 0 Z"></path>
				<path class="mc-crack" d="M22 -50 Q30 -38 26 -24 M52 -54 Q56 -46 62 -42"></path>
			</g>
			<path class="mc-block" d="M74 214 V198.9 H90 V214 Z"></path>
			<path class="mc-block-grain" d="M77 203 H87 M76 208 H88"></path>
			<line class="mc-bar" data-bar></line>
			<g transform="translate(338 0) scale(-1 1)"><g data-worker></g></g>
			<g class="mc-marks" data-marks>
				<path class="mc-dim" data-dim-hand></path>
				<text class="mc-small mc-halo" data-dim-hand-t text-anchor="end">70&nbsp;см</text>
				<path class="mc-dim" data-dim-stone></path>
				<text class="mc-small mc-halo-g" data-dim-stone-t text-anchor="middle">7&nbsp;см</text>
			</g>
			<path class="mc-arrow mc-arrow--up" data-f-stone></path>
			<path class="mc-head mc-head--up" data-h-stone></path>
			<path class="mc-arrow mc-arrow--down" data-f-hand></path>
			<path class="mc-head mc-head--down" data-h-hand></path>
			<text class="mc-force mc-halo" data-t-stone text-anchor="start">2000&nbsp;Н</text>
			<text class="mc-small mc-halo" data-t-stone2 text-anchor="start">лом поднимает камень</text>
			<text class="mc-force mc-halo" data-t-hand text-anchor="end">200&nbsp;Н</text>
			<text class="mc-small mc-halo" data-t-hand2 text-anchor="end">руки давят на лом</text>
		</svg>
		<div class="intro__foot">
			<p>
				Камень, который не сдвинуть руками, рабочий приподнимает ломом.{' '}
				<More term="Сила нужна в десять раз меньше">
					Лом опирается на деревянный брусок возле самого камня. От бруска до рук рабочего в десять раз дальше, чем от бруска до камня, — и сила, которой хватает, чтобы приподнять край камня, в десять раз меньше. Зато руки проходят путь в десять раз больший, чем край камня: 70&nbsp;см против 7&nbsp;см. Об этом — в разделе{' '}
					<a href="#золотое-правило-механики">«Золотое правило механики»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-mechintro] {
		--mc-sky: color-mix(in oklab, var(--ig-vx) 12%, var(--sl-color-bg));
		--mc-ground: color-mix(in oklab, hsl(110, 30%, 40%) 50%, var(--sl-color-gray-5));
		--mc-crown: color-mix(in oklab, hsl(120, 35%, 38%) 55%, var(--sl-color-gray-5));
		--mc-wood: hsl(28, 45%, 46%);
		--mc-wood-dark: hsl(25, 45%, 28%);
		--mc-stone: color-mix(in oklab, var(--ig-vx) 10%, var(--sl-color-gray-3));
		--mc-bar: hsl(215, 10%, 62%);
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
	}
	:root[data-theme='light'] [data-mechintro] {
		--mc-ground: hsl(100, 30%, 62%);
		--mc-crown: hsl(120, 30%, 52%);
		--mc-wood: hsl(28, 50%, 52%);
		--mc-stone: hsl(215, 8%, 66%);
		--mc-bar: hsl(215, 12%, 30%);
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
	}
	[data-mechintro] .mc-sky {
		fill: var(--mc-sky);
	}
	[data-mechintro] .mc-ground {
		fill: var(--mc-ground);
	}
	[data-mechintro] .mc-grass {
		fill: none;
		stroke: color-mix(in oklab, var(--mc-ground) 60%, var(--sl-color-white));
		stroke-width: 1;
	}
	[data-mechintro] .mc-trunk {
		fill: var(--mc-wood-dark);
	}
	[data-mechintro] .mc-crown {
		fill: var(--mc-crown);
	}
	[data-mechintro] .mc-trestle {
		fill: none;
		stroke: var(--mc-wood-dark);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-mechintro] .mc-plank {
		fill: var(--mc-wood);
		stroke: var(--mc-wood-dark);
		stroke-width: 1;
	}
	[data-mechintro] .mc-axle {
		fill: var(--sl-color-gray-2);
		stroke: var(--ph-line);
		stroke-width: 1;
	}
	[data-mechintro] .mc-tag {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
		paint-order: stroke fill;
		stroke: var(--mc-sky);
		stroke-width: 3px;
	}
	[data-mechintro] .mc-num {
		font-size: 13px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-mechintro] .mc-stone {
		fill: var(--mc-stone);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.4;
		stroke-linejoin: round;
	}
	[data-mechintro] .mc-crack {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-1) 50%, var(--mc-stone));
		stroke-width: 1;
	}
	[data-mechintro] .mc-gap {
		fill: color-mix(in oklab, var(--sl-color-black) 55%, var(--mc-ground));
	}
	[data-mechintro] .mc-block {
		fill: var(--mc-wood);
		stroke: var(--mc-wood-dark);
		stroke-width: 1;
	}
	[data-mechintro] .mc-block-grain {
		fill: none;
		stroke: var(--mc-wood-dark);
		stroke-width: 0.6;
	}
	[data-mechintro] .mc-bar {
		stroke: var(--mc-bar);
		stroke-width: 4;
		stroke-linecap: round;
	}
	[data-mechintro] .mc-arrow {
		fill: none;
		stroke-width: 3;
		stroke-linecap: round;
	}
	/* one color per force in the chapter: the applied force (the hands) red, the load's force blue */
	[data-mechintro] .mc-arrow--up {
		stroke: var(--ig-vx);
	}
	[data-mechintro] .mc-head--up {
		fill: var(--ig-vx);
	}
	[data-mechintro] .mc-arrow--down {
		stroke: var(--ig-vy);
	}
	[data-mechintro] .mc-head--down {
		fill: var(--ig-vy);
	}
	[data-mechintro] .mc-force {
		font-size: 13px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-mechintro] .mc-small {
		font-size: 10.5px;
		fill: var(--sl-color-gray-1);
	}
	[data-mechintro] .mc-halo,
	[data-mechintro] .mc-halo-g {
		paint-order: stroke fill;
		stroke: var(--mc-sky);
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	[data-mechintro] .mc-halo-g {
		stroke: var(--mc-ground);
	}
	[data-mechintro] .mc-dim {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	/* the people (personHome.ts) */
	[data-mechintro] .ph-far {
		filter: brightness(0.8);
	}
	[data-mechintro] .ph-outline {
		fill: none;
		stroke: var(--ph-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-mechintro] .ph-pants,
	[data-mechintro] .ph-sleeve,
	[data-mechintro] .ph-skin-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-mechintro] .ph-pants {
		stroke: var(--ph-pants);
	}
	[data-mechintro] [data-girl] .ph-pants {
		stroke: hsl(275, 30%, 46%);
	}
	[data-mechintro] .ph-skin-limb {
		stroke: var(--ph-skin);
	}
	[data-mechintro] .ph-sleeve.mc-blue {
		stroke: var(--ig-vx);
	}
	[data-mechintro] .ph-shirt.mc-blue {
		fill: var(--ig-vx);
	}
	[data-mechintro] .ph-sleeve.mc-pink {
		stroke: var(--ig-vy);
	}
	[data-mechintro] .ph-shirt.mc-pink {
		fill: var(--ig-vy);
	}
	[data-mechintro] .ph-sleeve.mc-gold {
		stroke: var(--ig-v);
	}
	[data-mechintro] .ph-shirt.mc-gold {
		fill: var(--ig-v);
	}
	[data-mechintro] .ph-shirt {
		stroke: var(--ph-line);
		stroke-width: 0.6;
	}
	[data-mechintro] .ph-belt {
		fill: var(--ph-line);
	}
	[data-mechintro] .ph-collar {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-mechintro] .ph-skin {
		fill: var(--ph-skin);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-mechintro] .ph-ear {
		stroke-width: 0.4;
	}
	[data-mechintro] .ph-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-mechintro] .ph-eye {
		fill: var(--ph-line);
	}
	[data-mechintro] .ph-brow,
	[data-mechintro] .ph-mouth {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.5;
		stroke-linecap: round;
	}
	[data-mechintro] .ph-hair,
	[data-mechintro] .mc-tail {
		fill: var(--ph-hair);
	}
	[data-mechintro] .mc-tie {
		fill: var(--ig-vy);
	}
	[data-mechintro] .ph-shoe {
		fill: var(--ph-shoe);
		stroke: var(--ph-line);
		stroke-width: 0.6;
	}
	[data-mechintro] .ph-sole {
		fill: var(--ph-line);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { person, joint, type Pt } from '../davlenie-v-zhidkosti/personHome';

	const ease = (u: number) => {
		const t = clamp(u);
		return t * t * (3 - 2 * t);
	};
	const f = (v: number) => v.toFixed(1);
	const D = Math.PI / 180;
	const fmtD = (v: number) => v.toFixed(1).replace('.', ',');

	/** Makes the head of a person drawn by personHome `k` times larger (a child) and gives it a ponytail. */
	const childHead = (g: SVGGElement, k: number) => {
		const head = [...g.children].find((c) => c.tagName === 'g' && c.querySelector('.ph-hair')) as SVGGElement;
		const r = Number(head.querySelector('circle')!.getAttribute('r'));
		const tail = el('path', { class: 'mc-tail', d: `M${f(-0.75 * r)} ${f(-0.7 * r)} Q${f(-1.9 * r)} ${f(-0.6 * r)} ${f(-1.7 * r)} ${f(0.9 * r)} Q${f(-1.35 * r)} ${f(0.1 * r)} ${f(-0.85 * r)} ${f(-0.15 * r)} Z` });
		const tie = el('circle', { class: 'mc-tie', cx: f(-1.02 * r), cy: f(-0.55 * r), r: f(0.2 * r) });
		head.prepend(tail);
		head.append(tie);
		// after each pose: scale the head about its center and lift it so that it still sits on the neck
		return (lean: number) => {
			const tr = head.getAttribute('transform') ?? '';
			const m = /translate\(([-\d.]+) ([-\d.]+)\) rotate\(([-\d.]+)\)/.exec(tr);
			if (!m) return;
			const up = (k - 1) * r * 0.8;
			const x = Number(m[1]) + Math.sin(lean) * up;
			const y = Number(m[2]) - Math.cos(lean) * up;
			head.setAttribute('transform', `translate(${f(x)} ${f(y)}) rotate(${m[3]}) scale(${k})`);
		};
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-mechintro]')) {
		// ---------------- the seesaw
		{
			const card = root.querySelector<HTMLElement>('[data-scene="seesaw"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 60; // px per metre
			const s = K / 100; // px per см
			const G = 206;
			const PX = 180;
			const PY = 176; // the axle, under the board
			const TMAX = Math.asin((G - PY) / 132); // the board's end on the ground
			const board = $<SVGGElement>('[data-board]');
			const dist = $<SVGTextElement>('[data-dist]');
			const tagG = $<SVGTextElement>('[data-tag-girl]');
			const tagD = $<SVGTextElement>('[data-tag-dad]');
			const gGirl = $<SVGGElement>('[data-girl]');
			const gDad = $<SVGGElement>('[data-dad]');
			const girl = person(gGirl, { s, H: 115, girth: 0.95, shirt: 'mc-pink' });
			const kid = childHead(gGirl, 1.3);
			const dad = person(gDad, { s, H: 180, girth: 1.12, shirt: 'mc-blue' });
			const uG = 115 * s;
			const uD = 180 * s;
			const M = 360; // the father's group is mirrored: x' = M − x
			// a point of the board (along it from the axle, and up from its lower face) in the picture
			const onBoard = (th: number, lx: number, ly: number): Pt => ({
				x: PX + lx * Math.cos(th) + ly * Math.sin(th),
				y: PY + lx * Math.sin(th) - ly * Math.cos(th),
			});
			const HOPS = [0.1, 0.27, 0.44]; // starts of the three hops (part of the run), each 0,13 long
			scene(card, 6, (x) => {
				// the father's distance from the axle (m) and the phase of the current hop
				let d = 2;
				let hop = 0;
				let feet = 0; // 0…1: the feet are carried to their new place
				for (const h0 of HOPS) {
					const p = clamp((x - h0) / 0.13);
					d -= 0.5 * ease(p);
					if (p > 0 && p < 1) hop = Math.sin(Math.PI * p);
					if (p > 0.45 && p < 1) feet = Math.sin((Math.PI * (p - 0.45)) / 0.55);
				}
				// balance: the father lifts his feet, the board comes level
				const lift = ease((x - 0.66) / 0.2);
				const th = TMAX * (1 - lift);
				board.setAttribute('transform', `rotate(${f(th / D)} ${PX} ${PY})`);

				// the girl, 2 м to the left, faces right
				{
					const seat = onBoard(th, -2 * K, 6);
					const hip = { x: seat.x, y: seat.y - 0.05 * uG };
					const dir = { x: Math.cos(th), y: Math.sin(th) };
					const knee = { x: hip.x + dir.x * 0.23 * uG, y: hip.y + dir.y * 0.23 * uG };
					const ank = { x: knee.x + 0.03 * uG, y: knee.y + 0.225 * uG };
					const hand = onBoard(th, -2 * K + 0.2 * uG, 6);
					const lean = 0.22;
					girl({ hip, lean, ankles: [ank, { x: ank.x - 3, y: ank.y - 1 }], feet: [0.5, 0.45], hands: [hand, { x: hand.x - 2, y: hand.y }], head: -0.05 });
					kid(lean);
					tagG.setAttribute('x', f(hip.x));
					tagG.setAttribute('y', f(hip.y - 0.66 * uG));
				}
				// the father, d to the right, faces left (drawn in the mirrored group)
				{
					const seat = onBoard(th, d * K, 6);
					const hipW = { x: seat.x, y: seat.y - 0.05 * uD - 0.05 * K * hop };
					const lean = 0.12 + 0.3 * hop;
					// feet on the ground 0,42 м in front of the seat, carried after him in each hop; lifted at the end
					const grounded = { x: PX + (d - 0.42) * K, y: G - 7.5 * s - 0.06 * K * feet };
					const dir = { x: -Math.cos(th), y: -Math.sin(th) };
					const hanging = { x: hipW.x + dir.x * 0.22 * uD - 0.03 * uD, y: hipW.y + dir.y * 0.22 * uD + 0.2 * uD };
					const ankW = { x: grounded.x + (hanging.x - grounded.x) * lift, y: grounded.y + (hanging.y - grounded.y) * lift };
					const toM = (p: Pt): Pt => ({ x: M - p.x, y: p.y });
					const hip = toM(hipW);
					const a0 = toM(ankW);
					const a1 = { x: a0.x - 5, y: a0.y };
					// the hands rest on the knees
					const th2 = 0.24 * uD;
					const sh2 = 0.235 * uD;
					const k0 = joint(hip, a0, th2, sh2, 1).j;
					const k1 = joint(hip, a1, th2, sh2, 1).j;
					dad({
						hip,
						lean,
						ankles: [a0, a1],
						feet: [0.15 * lift, 0.15 * lift],
						hands: [
							{ x: k0.x - 0.02 * uD, y: k0.y - 0.035 * uD },
							{ x: k1.x - 0.03 * uD, y: k1.y - 0.035 * uD },
						],
						head: 0.05,
					});
					tagD.setAttribute('x', f(hipW.x));
					tagD.setAttribute('y', f(hipW.y - 0.6 * uD));
				}
				dist.textContent = `отец в ${fmtD(d)}\u00a0м от опоры${lift > 0.5 ? ': равновесие' : ''}`;
			});
		}

		// ---------------- the crowbar
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bar"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 120; // px per metre
			const s = K / 100;
			const G = 214;
			const FX = 78; // the edge of the block, on which the bar turns
			const HB = 0.03 + 0.15 * Math.sin(40 * D); // height of the block, m (12,6 см)
			const FY = G - HB * K;
			const SX = FX - 0.15 * Math.cos(40 * D) * K - 71.6; // far lower corner of the stone (the contact is 71,6 px from it)
			const bar = $<SVGLineElement>('[data-bar]');
			const stone = $<SVGGElement>('[data-stone]');
			const gap = $<SVGPathElement>('[data-gap]');
			const worker = person($<SVGGElement>('[data-worker]'), { s, H: 175, girth: 1.05, shirt: 'mc-gold' });
			const u = 175 * s;
			const ARM = 0.35 * u;
			const MW = 338; // the worker's group is mirrored: x' = MW − x
			const fS = $<SVGPathElement>('[data-f-stone]');
			const hS = $<SVGPathElement>('[data-h-stone]');
			const fH = $<SVGPathElement>('[data-f-hand]');
			const hH = $<SVGPathElement>('[data-h-hand]');
			const tS = $<SVGTextElement>('[data-t-stone]');
			const tS2 = $<SVGTextElement>('[data-t-stone2]');
			const tH = $<SVGTextElement>('[data-t-hand]');
			const tH2 = $<SVGTextElement>('[data-t-hand2]');
			const marks = $<SVGGElement>('[data-marks]');
			const PER = 14 / 200; // px per Н
			const at = (th: number, l: number): Pt => ({ x: FX + l * K * Math.cos(th), y: FY - l * K * Math.sin(th) });
			const arrow = (shaft: SVGPathElement, head: SVGPathElement, x: number, y0: number, y1: number, show: number) => {
				const dir = Math.sign(y1 - y0);
				shaft.setAttribute('d', `M${f(x)} ${f(y0)} V${f(y1 - dir * 6)}`);
				head.setAttribute('d', `M${f(x - 5)} ${f(y1 - dir * 8)} L${f(x + 5)} ${f(y1 - dir * 8)} L${f(x)} ${f(y1)} Z`);
				shaft.style.opacity = head.style.opacity = String(show);
			};
			const setT = (t: SVGTextElement, x: number, y: number, show: number) => {
				t.setAttribute('x', f(x));
				t.setAttribute('y', f(y));
				t.style.opacity = String(show);
			};
			const pose = (p: number, th: number) => {
				// hands on the bar 1,47 and 1,53 м from the block; the arms go from reaching forward to pressing down
				const hn = at(th, 1.47);
				const hf = at(th, 1.53);
				const toM = (q: Pt): Pt => ({ x: MW - q.x, y: q.y });
				const hm = toM(at(th, 1.5));
				const beta = (25 + 40 * p) * D; // the arms below the horizontal
				const reach = (0.88 + 0.06 * p) * ARM;
				const S = { x: hm.x - reach * Math.cos(beta), y: hm.y - reach * Math.sin(beta) };
				const lean = 0.55 + 0.45 * p;
				const a = 0.27 * u;
				const hip = { x: S.x - Math.sin(lean) * a, y: S.y + Math.cos(lean) * a };
				worker({
					hip,
					lean,
					ankles: [{ x: MW - 300, y: G - 7.5 * s }, { x: MW - 317, y: G - 7.5 * s }],
					feet: [0, 0],
					hands: [toM(hn), toM(hf)],
					head: 0.25 - 0.3 * p,
				});
			};
			scene(card, 5, (x) => {
				const p = ease((x - 0.12) / 0.62);
				const th = (40 - 30 * p) * D;
				const tip = at(th, -0.15);
				const end = at(th, 1.55);
				bar.setAttribute('x1', f(tip.x));
				bar.setAttribute('y1', f(tip.y));
				bar.setAttribute('x2', f(end.x));
				bar.setAttribute('y2', f(end.y));
				// the stone turns about its far lower corner; its bevel rests on the tip of the bar
				const rise = G - tip.y - 0.03 * K;
				const phi = Math.asin(Math.max(0, rise) / 71.6);
				stone.setAttribute('transform', `translate(${f(SX)} ${G}) rotate(${f(-phi / D)})`);
				const nx = SX + 68 * Math.cos(phi);
				const ny = G - 68 * Math.sin(phi);
				gap.setAttribute('d', `M${f(SX)} ${G} L${f(nx)} ${f(ny)} L${f(nx + 4)} ${G} Z`);
				pose(p, th);
				// forces, one scale: 200 Н down at the hands, 2000 Н up at the tip
				const show = clamp((x - 0.06) / 0.08);
				const hand = at(th, 1.5);
				arrow(fH, hH, hand.x, hand.y + 3, hand.y + 3 + 200 * PER + 2, show);
				arrow(fS, hS, tip.x, tip.y - 2, tip.y - 2 - 2000 * PER, show);
				setT(tS, tip.x + 8, tip.y - 2000 * PER + 8, show);
				setT(tS2, tip.x + 8, tip.y - 2000 * PER + 21, show);
				setT(tH, hand.x - 9, hand.y + 22, show);
				setT(tH2, hand.x - 9, hand.y + 34, show);
				// the paths, at the end: the hands 70 см, the edge of the stone 7 см
				const m = clamp((x - 0.8) / 0.1);
				marks.style.opacity = String(m);
				const h0 = at(40 * D, 1.5);
				const h1 = at(10 * D, 1.5);
				const xd = h0.x - 12;
				$<SVGPathElement>('[data-dim-hand]').setAttribute('d', `M${f(xd - 4)} ${f(h0.y)} H${f(h0.x - 4)} M${f(xd)} ${f(h0.y)} V${f(h1.y)} M${f(xd - 4)} ${f(h1.y)} H${f(h1.x - 8)}`);
				setT($<SVGTextElement>('[data-dim-hand-t]'), xd - 5, (h0.y + h1.y) / 2 + 4, 1);
				const t0 = at(40 * D, -0.15);
				const t1 = at(10 * D, -0.15);
				const xs = t1.x - 9;
				$<SVGPathElement>('[data-dim-stone]').setAttribute('d', `M${f(xs - 3)} ${f(t0.y)} H${f(xs + 3)} M${f(xs)} ${f(t0.y)} V${f(t1.y)} M${f(xs - 3)} ${f(t1.y)} H${f(xs + 3)} M${f(xs)} ${f(t0.y)} V${G + 6}`);
				setT($<SVGTextElement>('[data-dim-stone-t]'), xs, G + 17, 1);
			});
		}
	}
</script>
