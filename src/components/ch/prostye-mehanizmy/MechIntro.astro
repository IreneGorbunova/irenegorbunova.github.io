---
/**
 * Two short looping opening scenes of «Простые механизмы. Рычаг, блок». No terms of the chapter in the pictures.
 * Seesaw: a father of 80 кг and a daughter of 20 кг on a seesaw 4 м long (60 px per metre). The girl sits 2 м
 *   from the support; the father starts at 2 м (his side is down), moves toward the support, and at 0,5 м from it
 *   the plank comes level: 80 кг · 0,5 м = 20 кг · 2 м.
 * Crowbar: a worker lifts the edge of a stone that presses on the bar with 2000 Н by pushing the long end of a
 *   crowbar with 200 Н: the arms are 0,15 м and 1,5 м (1 : 10). The long end goes down 30 см, the stone rises 3 см.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-mechintro>
	<div class="intro__card" data-scene="seesaw">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Отец и дочь на качелях-балансире. Отец пересаживается ближе к опоре, и качели приходят в равновесие">
			<rect class="mc-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="mc-ground" x="0" y="196" width="360" height="44"></rect>
			<path class="mc-support" d="M180 150 L160 196 H200 Z"></path>
			<g data-plank>
				<rect class="mc-plank" x="60" y="144" width="240" height="8" rx="3"></rect>
				<!-- the daughter, 2 м to the left of the support -->
				<g transform="translate(64 144)">
					<circle class="mc-head" cx="0" cy="-30" r="6"></circle>
					<path class="mc-kid" d="M-5 -24 h10 v18 h-10 Z"></path>
					<path class="mc-leg" d="M0 -6 l8 4"></path>
				</g>
				<!-- the father -->
				<g data-dad>
					<circle class="mc-head" cx="0" cy="-48" r="8"></circle>
					<path class="mc-dad" d="M-8 -40 h16 v30 h-16 Z"></path>
					<path class="mc-leg" d="M0 -10 l-12 6"></path>
				</g>
			</g>
			<circle class="mc-pivot" cx="180" cy="148" r="4"></circle>
			<text class="mc-num" x="180" y="26" text-anchor="middle" data-dist></text>
			<text class="mc-label" x="64" y="222" text-anchor="middle">20 кг</text>
			<text class="mc-label" x="270" y="222" text-anchor="middle">80 кг</text>
		</svg>
		<div class="intro__foot">
			<p>
				Отец вчетверо тяжелее дочери, и качели перевешивают в его сторону. Он пересаживается{' '}
				<More term="вчетверо ближе к опоре">
					Груз на качелях действует тем сильнее, чем дальше он от опоры. Девочка массой 20&nbsp;кг в двух метрах от опоры уравновешивает отца массой 80&nbsp;кг, если он сядет в полуметре от неё: 80 · 0,5 = 20 · 2. Об этом — в разделе{' '}
					<a href="#рычаг">«Рычаг»</a>.
				</More>, и качели приходят в равновесие.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="bar">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Рабочий ломом приподнимает край тяжёлого камня: на длинный конец лома он давит слабо, а короткий конец поднимает камень">
			<rect class="mc-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="mc-ground" x="0" y="196" width="360" height="44"></rect>
			<g data-stone>
				<path class="mc-stone" d="M0 0 L8 -58 L44 -78 L86 -62 L96 0 Z"></path>
			</g>
			<path class="mc-prop" d="M112 196 l8 -14 l8 14 Z"></path>
			<line class="mc-bar" data-bar x1="0" y1="0" x2="0" y2="0"></line>
			<g data-worker>
				<circle class="mc-head" cx="0" cy="-70" r="8"></circle>
				<path class="mc-dad" d="M-8 -62 h16 v32 h-16 Z"></path>
				<path class="mc-leg" d="M-4 -30 V0 M4 -30 V0"></path>
				<path class="mc-arm" data-arm d="M0 -56 L-20 -40"></path>
			</g>
			<text class="mc-num" x="60" y="26" text-anchor="middle">2000 Н</text>
			<text class="mc-label" x="60" y="42" text-anchor="middle">давит камень</text>
			<text class="mc-num" x="290" y="26" text-anchor="middle">200 Н</text>
			<text class="mc-label" x="290" y="42" text-anchor="middle">давит рабочий</text>
		</svg>
		<div class="intro__foot">
			<p>
				Камень, который не сдвинуть руками, рабочий приподнимает ломом.{' '}
				<More term="Сила нужна в десять раз меньше">
					Лом опирается на подставку возле самого камня. От подставки до рук рабочего в десять раз дальше, чем от подставки до камня, — и сила, которой хватает, чтобы приподнять камень, в десять раз меньше его веса. Зато руки проходят путь в десять раз больший, чем край камня. Об этом — в разделе{' '}
					<a href="#золотое-правило-механики">«Золотое правило механики»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-mechintro] .mc-sky {
		fill: var(--sl-color-bg);
	}
	[data-mechintro] .mc-ground {
		fill: color-mix(in oklab, hsl(110, 30%, 42%) 60%, var(--sl-color-bg));
	}
	[data-mechintro] .mc-support,
	[data-mechintro] .mc-prop {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	[data-mechintro] .mc-plank {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: hsl(28, 50%, 26%);
		stroke-width: 1;
	}
	[data-mechintro] .mc-pivot {
		fill: var(--sl-color-gray-1);
	}
	[data-mechintro] .mc-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-mechintro] .mc-kid {
		fill: var(--ig-vy);
	}
	[data-mechintro] .mc-dad {
		fill: var(--ig-vx);
	}
	[data-mechintro] .mc-leg,
	[data-mechintro] .mc-arm {
		fill: none;
		stroke: hsl(225, 30%, 26%);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-mechintro] .mc-arm {
		stroke: var(--ig-vx);
	}
	[data-mechintro] .mc-num {
		font-size: 14px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-mechintro] .mc-label {
		font-size: 11px;
		fill: var(--sl-color-gray-2);
	}
	[data-mechintro] .mc-stone {
		fill: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	[data-mechintro] .mc-bar {
		stroke: var(--sl-color-gray-1);
		stroke-width: 5;
		stroke-linecap: round;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-mechintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="seesaw"]')!;
			const plank = card.querySelector<SVGGElement>('[data-plank]')!;
			const dad = card.querySelector<SVGGElement>('[data-dad]')!;
			const dist = card.querySelector<SVGTextElement>('[data-dist]')!;
			scene(card, 7, (x) => {
				// the father moves from 2 м to 0,5 м from the support between 15 % and 75 % of the run
				const d = 2 - 1.5 * ease((x - 0.15) / 0.6);
				dad.setAttribute('transform', `translate(${(180 + d * 60).toFixed(1)} 144)`);
				// the tilt follows the difference of the two products, 80·d − 20·2, and is limited by the ground
				const tilt = Math.min(14, Math.max(0, (80 * d - 40) * 0.35));
				plank.setAttribute('transform', `rotate(${tilt.toFixed(2)} 180 148)`);
				dist.textContent = `отец в ${d.toFixed(1).replace('.', ',')} м от опоры${d <= 0.5001 ? ': равновесие' : ''}`;
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="bar"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const bar = $<SVGLineElement>('[data-bar]');
			const stone = $<SVGGElement>('[data-stone]');
			const worker = $<SVGGElement>('[data-worker]');
			const arm = $<SVGPathElement>('[data-arm]');
			const PX = 120; // the support of the bar; 1 м = 120 px
			const PY = 182;
			scene(card, 6, (x) => {
				// the long end goes down by 30 см, the short end and the edge of the stone up by 3 см
				const u = ease((x - 0.2) / 0.5);
				const a = Math.atan(0.3 / 1.5) * (1 - u) - Math.atan(0.02 / 1.5) * u; // the tilt of the bar: long end up at first
				const xs = PX - 18 * Math.cos(a);
				const ys = PY + 18 * Math.sin(a);
				const xl = PX + 180 * Math.cos(a);
				const yl = PY - 180 * Math.sin(a);
				bar.setAttribute('x1', xs.toFixed(1));
				bar.setAttribute('y1', ys.toFixed(1));
				bar.setAttribute('x2', xl.toFixed(1));
				bar.setAttribute('y2', yl.toFixed(1));
				// the stone turns about its far lower corner; its near edge rests on the short end of the bar
				stone.setAttribute('transform', `translate(8 196) rotate(${(-((196 - ys - 0) / 96) * 57.3 * 0.9).toFixed(2)})`);
				worker.setAttribute('transform', 'translate(318 196)');
				arm.setAttribute('d', `M0 -56 L${(xl - 318).toFixed(1)} ${(yl - 196).toFixed(1)}`);
			});
		}
	}
</script>
