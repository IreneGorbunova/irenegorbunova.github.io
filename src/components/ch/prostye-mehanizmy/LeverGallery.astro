</style>

<script>
	import { el, loop } from '../g7/kit';
	import { joint } from '../davlenie-v-zhidkosti/personHome';

	const D = Math.PI / 180;
	const f = (v: number) => v.toFixed(1);
	type Pt = { x: number; y: number };
	const rot = (o: Pt, p: Pt, a: number): Pt => ({
		x: o.x + (p.x - o.x) * Math.cos(a) - (p.y - o.y) * Math.sin(a),
		y: o.y + (p.x - o.x) * Math.sin(a) + (p.y - o.y) * Math.cos(a),
	});
	const wave = (t: number, T: number) => 0.5 - 0.5 * Math.cos((2 * Math.PI * t) / T); // 0 → 1 → 0

	/** A force arrow: a shaft with a halo and a head, from p along the unit direction d, `len` px; and its label. */
	const force = (g: SVGGElement, n: 1 | 2) => {
		const halo = el('path', { class: 'lg-halo' });
		const sh = el('path', { class: `lg-f${n}` });
		const hd = el('path', { class: `lg-h${n}` });
		const lb = el('text', { class: `lg-l${n}`, 'text-anchor': 'middle' });
		lb.append(document.createTextNode('F'));
		const sub = el('tspan', { 'font-size': '10', dy: '3' }, String(n));
		lb.append(sub);
		g.append(halo, sh, hd, lb);
		return (p: Pt, d: Pt, len: number, lab: Pt, show = 1) => {
			const e = { x: p.x + d.x * len, y: p.y + d.y * len };
			const k = Math.min(7, len * 0.45);
			const s = `M${f(p.x)} ${f(p.y)} L${f(e.x - d.x * k)} ${f(e.y - d.y * k)}`;
			halo.setAttribute('d', `M${f(p.x)} ${f(p.y)} L${f(e.x)} ${f(e.y)}`);
			sh.setAttribute('d', s);
			const nx = -d.y;
			const ny = d.x;
			const hk = Math.max(6, k + 2);
			hd.setAttribute('d', `M${f(e.x)} ${f(e.y)} L${f(e.x - d.x * hk + nx * 4.5)} ${f(e.y - d.y * hk + ny * 4.5)} L${f(e.x - d.x * hk - nx * 4.5)} ${f(e.y - d.y * hk - ny * 4.5)} Z`);
			lb.setAttribute('x', f(lab.x));
			lb.setAttribute('y', f(lab.y));
			for (const x of [halo, sh, hd, lb]) x.style.opacity = String(show);
		};
	};
	const DOWN = { x: 0, y: 1 };
	const UP = { x: 0, y: -1 };
	const LEFT = { x: -1, y: 0 };

	/** A fist round a bar: the bar passes across the knuckles; p is the center, a the bar's direction (rad). */
	const fist = (g: SVGGElement, shoulder?: Pt, l1 = 50, l2 = 48, side: 1 | -1 = 1) => {
		// the arm from the shoulder to the wrist: a sleeve over the upper arm, a bare forearm, an outline under both
		const out = el('path', { class: 'lg-arm-out' });
		const up = el('path', { class: 'lg-sleeve' });
		const fo = el('path', { class: 'lg-forearm' });
		if (shoulder) g.append(out, up, fo);
		const h = el('g', {});
		h.append(
			el('rect', { class: 'lg-skin-fill', x: -7.5, y: -8, width: 15, height: 16, rx: 6 }),
			el('path', { class: 'lg-finger', d: 'M-3.5 -7 V4 M0 -7.5 V4.5 M3.5 -7 V4' }),
			el('path', { class: 'lg-skin-fill', d: 'M-7 2 Q-10 7 -4 8 L2 8 Q0 4 -7 2 Z' }),
		);
		g.append(h);
		return (p: Pt, a: number) => {
			h.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)}) rotate(${f(a / D + 90)})`);
			if (!shoulder) return;
			const { j, end } = joint(shoulder, p, l1, l2, side);
			out.setAttribute('d', `M${f(shoulder.x)} ${f(shoulder.y)} L${f(j.x)} ${f(j.y)} L${f(end.x)} ${f(end.y)}`);
			up.setAttribute('d', `M${f(shoulder.x)} ${f(shoulder.y)} L${f(j.x)} ${f(j.y)}`);
			fo.setAttribute('d', `M${f(j.x)} ${f(j.y)} L${f(end.x)} ${f(end.y)}`);
		};
	};

	/** Each panel: build(g) draws it and returns the frame function of the time t (s). */
	const panels: Record<string, (g: SVGGElement) => (t: number) => void> = {
		// ---------------- scissors (side view; the half with its ring on top carries the forces)
		sc(g) {
			const O = { x: 110, y: 108 };
			const paper = el('path', { class: 'lg-paper' });
			const flaps = el('path', { class: 'lg-paper-cut' });
			const half = (flip: number) => {
				const h = el('g', {});
				h.append(
					el('path', { class: 'lg-steel', d: `M-8 ${-6 * flip} Q40 ${-8 * flip} 126 ${-1 * flip} L126 ${0.6 * flip} L-8 ${2.5 * flip} Z` }),
					el('path', { class: 'lg-rod-light', d: `M-6 0 L-44 ${2 * flip}`, 'stroke-width': 6 }),
					el('ellipse', { class: 'lg-ring', cx: -60, cy: 3 * flip, rx: 17, ry: 11 }),
				);
				return h;
			};
			const a = half(1);
			const b = half(-1);
			g.append(paper, a, flaps, b, el('circle', { class: 'lg-pivot', cx: O.x, cy: O.y, r: 4.5 }));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			return (t) => {
				const phi = (3 + 13 * (1 - wave(t, 3))) * D;
				a.setAttribute('transform', `translate(${O.x} ${O.y}) rotate(${f(-phi / D)})`);
				b.setAttribute('transform', `translate(${O.x} ${O.y}) rotate(${f(phi / D)})`);
				// the paper, edge-on: whole to the right of the cut, its two cut edges along the blades
				const xc = O.x + Math.min(70, Math.max(14, 3 / Math.tan(phi)));
				paper.setAttribute('d', `M${f(xc)} ${O.y - 1.5} H236 V${O.y + 1.5} H${f(xc)} Z`);
				const back = 26;
				flaps.setAttribute('d', `M${f(xc)} ${O.y - 1} L${f(xc - back)} ${f(O.y - 2 - back * Math.tan(phi))} M${f(xc)} ${O.y + 1} L${f(xc - back)} ${f(O.y + 2 + back * Math.tan(phi))}`);
				const ring = rot(O, { x: O.x - 60, y: O.y - 3 }, phi);
				const cut = { x: xc + 2, y: O.y + (xc + 2 - O.x) * Math.tan(phi) + 2 };
				F1({ x: ring.x, y: ring.y - 11 }, DOWN, 18, { x: ring.x - 26, y: ring.y + 2 });
				F2(cut, DOWN, 18 * 60 / (xc + 2 - O.x), { x: cut.x + 14, y: cut.y + 26 });
			};
		},
		// ---------------- cutters
		cu(g) {
			const O = { x: 164, y: 104 };
			const half = (flip: number) => {
				const h = el('g', {});
				h.append(
					el('path', { class: 'lg-grip', d: `M-42 ${4 * flip} L-118 ${12 * flip}`, 'stroke-width': 9 }),
					el('path', { class: 'lg-rod', d: `M-6 0 L-42 ${4 * flip}`, 'stroke-width': 6 }),
					el('path', { class: 'lg-steel-dark', d: `M-10 ${-8 * flip} Q12 ${-14 * flip} 32 ${-2 * flip} L32 ${0.5 * flip} L-10 ${4 * flip} Z` }),
				);
				return h;
			};
			const a = half(1);
			const b = half(-1);
			const wire = el('path', { class: 'lg-wirel', d: `M${O.x + 18} 40 V${O.y - 3} M${O.x + 18} ${O.y + 3} V180` });
			g.append(wire, a, b, el('circle', { class: 'lg-wire', cx: O.x + 18, cy: O.y, r: 3 }), el('circle', { class: 'lg-pivot', cx: O.x, cy: O.y, r: 4.5 }));
			g.append(el('text', { class: 'lg-small', x: O.x + 12, y: 48, 'text-anchor': 'end' }, 'проволока'));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			return (t) => {
				const phi = (4 + 8 * (1 - wave(t, 2.6))) * D;
				a.setAttribute('transform', `translate(${O.x} ${O.y}) rotate(${f(-phi / D)})`);
				b.setAttribute('transform', `translate(${O.x} ${O.y}) rotate(${f(phi / D)})`);
				const end = rot(O, { x: O.x - 112, y: O.y - 11.5 }, phi);
				F1({ x: end.x, y: end.y - 4 }, DOWN, 10, { x: end.x + 2, y: end.y - 12 });
				F2({ x: O.x + 18, y: O.y + 3 }, DOWN, 70, { x: O.x + 34, y: O.y + 62 });
			};
		},
		// ---------------- wheelbarrow
		wb(g) {
			const A = { x: 46, y: 150 };
			const G = 174;
			g.append(el('rect', { class: 'lg-ground', x: 0, y: G, width: 240, height: 12 }));
			const body = el('g', {});
			body.append(
				el('path', { class: 'lg-woodline', d: `M${A.x} ${A.y} L150 134 L226 122` }),
				el('path', { class: 'lg-rod', d: 'M150 136 L150 173' }),
				el('path', { class: 'lg-steel', d: 'M52 106 L156 98 L148 134 L76 142 Z' }),
				el('path', { class: 'lg-sand', d: 'M56 106 Q100 80 152 99 Z' }),
				el('path', { class: 'lg-grip', d: 'M212 124 L228 121.5' }),
			);
			const wheel = el('g', {});
			wheel.append(el('circle', { class: 'lg-tyre', cx: A.x, cy: A.y, r: 24 }), el('circle', { class: 'lg-rim', cx: A.x, cy: A.y, r: 15 }), el('path', { class: 'lg-thin', d: `M${A.x - 15} ${A.y} H${A.x + 15} M${A.x} ${A.y - 15} V${A.y + 15}` }));
			g.append(wheel, body);
			g.append(el('ellipse', { class: 'lg-shirt', cx: 242, cy: 38, rx: 16, ry: 30 }));
			const hand = fist(g, { x: 226, y: 44 }, 44, 42, 1);
			g.append(el('circle', { class: 'lg-pivot', cx: A.x, cy: A.y, r: 4.5 }));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			return (t) => {
				const psi = -9 * wave(t, 3.6) * D;
				body.setAttribute('transform', `rotate(${f(psi / D)} ${A.x} ${A.y})`);
				const load = rot(A, { x: 104, y: 102 }, psi);
				const grip = rot(A, { x: 220, y: 123 }, psi);
				hand(grip, Math.atan2(-12, 76) + psi);
				F2(load, DOWN, 46, { x: load.x - 14, y: load.y + 24 });
				F1({ x: grip.x, y: grip.y - 8 }, UP, 46 * (58 / 174), { x: grip.x - 14, y: grip.y - 16 });
			};
		},
		// ---------------- crowbar
		cb(g) {
			const G = 150;
			const P = { x: 124, y: G - 3 - 25 * Math.sin(36 * D) }; // the top of the small stone under the bar
			let hatch = `M0 ${G} H240`;
			for (let x = 4; x < 240; x += 9) hatch += ` M${x} ${G} l-6 7`;
			g.append(el('path', { class: 'lg-gline', d: hatch }));
			const stone = el('path', { class: 'lg-stone', d: 'M0 0 L74 0 L82 -8 Q88 -32 78 -54 Q58 -68 24 -64 Q2 -58 0 -34 Z' });
			g.append(stone, el('path', { class: 'lg-stone', d: `M${f(P.x - 12)} ${G} Q${f(P.x - 11)} ${f(P.y)} ${f(P.x)} ${f(P.y)} Q${f(P.x + 11)} ${f(P.y)} ${f(P.x + 12)} ${G} Z` }));
			const bar = el('path', { class: 'lg-rod' });
			g.append(bar);
			g.append(el('ellipse', { class: 'lg-shirt', cx: 244, cy: 30, rx: 16, ry: 30 }));
			const hand = fist(g, { x: 230, y: 32 }, 40, 38, -1);
			g.append(el('circle', { class: 'lg-pivot', cx: f(P.x), cy: f(P.y), r: 4.5 }));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			return (t) => {
				const th = (36 - 14 * wave(t, 3.2)) * D;
				const tip = { x: P.x - 25 * Math.cos(th), y: P.y + 25 * Math.sin(th) };
				const end = { x: P.x + 104 * Math.cos(th), y: P.y - 104 * Math.sin(th) };
				const grip = { x: P.x + 100 * Math.cos(th), y: P.y - 100 * Math.sin(th) };
				bar.setAttribute('d', `M${f(tip.x)} ${f(tip.y)} L${f(end.x)} ${f(end.y)}`);
				const rise = Math.max(0, G - 3 - tip.y);
				const sx = tip.x - 78;
				stone.setAttribute('transform', `translate(${f(sx)} ${G}) rotate(${f(-Math.asin(rise / 80) / D)})`);
				hand(grip, -th);
				F1({ x: grip.x, y: grip.y + 8 }, DOWN, 10, { x: grip.x + 14, y: grip.y + 18 });
				F2(tip, DOWN, 40, { x: tip.x - 14, y: tip.y + 36 });
			};
		},
		// ---------------- nail puller
		np(g) {
			const B = 132; // top of the board
			const Hh = { x: 126, y: B }; // the heel
			g.append(el('rect', { class: 'lg-wood', x: 14, y: B, width: 212, height: 24, rx: 2 }));
			const nail = el('g', {});
			nail.append(
				el('path', { class: 'lg-nail-in', d: `M150 ${B + 1} V${B + 22}` }),
				el('path', { class: 'lg-nail', d: `M150 ${B - 9} V${B}` }),
				el('rect', { class: 'lg-steel-dark', x: 144, y: B - 12, width: 12, height: 3.5, rx: 1 }),
			);
			const tool = el('g', {});
			tool.append(
				el('path', { class: 'lg-rod', d: `M58 36 L${Hh.x - 4} ${B - 10} Q${Hh.x} ${B - 1} ${Hh.x + 8} ${B - 5}`, 'stroke-width': 7 }),
				el('path', { class: 'lg-steel-dark', d: `M${Hh.x + 4} ${B - 9} L158 ${B - 9} L158 ${B - 6.5} L${Hh.x + 9} ${B - 1} Z` }),
			);
			g.append(nail, tool);
			g.append(el('ellipse', { class: 'lg-shirt', cx: 0, cy: 48, rx: 16, ry: 30 }));
			const hand = fist(g, { x: 12, y: 46 }, 40, 38, -1);
			g.append(el('circle', { class: 'lg-pivot', cx: Hh.x, cy: Hh.y - 1, r: 4.5 }));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			return (t) => {
				const psi = -16 * wave(t, 3.4) * D;
				tool.setAttribute('transform', `rotate(${f(psi / D)} ${Hh.x} ${Hh.y})`);
				const claw = rot(Hh, { x: 150, y: B - 9 }, psi);
				nail.setAttribute('transform', `translate(0 ${f(claw.y - (B - 9))})`);
				const top = rot(Hh, { x: 64, y: 42 }, psi);
				hand(top, Math.atan2(B - 10 - 36, Hh.x - 4 - 58) + psi);
				F1({ x: top.x - 8, y: top.y }, LEFT, 12, { x: top.x - 16, y: top.y - 14 });
				F2({ x: 150, y: claw.y + 1 }, DOWN, 60, { x: 168, y: claw.y + 56 });
			};
		},
		// ---------------- oar, seen from above
		oa(g) {
			const L = { x: 92, y: 112 }; // the oarlock
			g.append(el('rect', { class: 'lg-water', x: 0, y: 26, width: 240, height: 168, rx: 6 }));
			g.append(el('path', { class: 'lg-wood', d: `M0 26 H40 Q84 58 ${L.x} ${L.y} Q84 166 40 194 H0 Z` }));
			g.append(el('path', { class: 'lg-gunwale', d: `M38 32 Q76 62 ${L.x - 7} ${L.y} Q76 162 38 188` }));
			g.append(el('rect', { class: 'lg-seat', x: 0, y: 62, width: 82, height: 14 }));
			g.append(el('ellipse', { class: 'lg-shirt', cx: 28, cy: 68, rx: 24, ry: 10 }));
			g.append(el('text', { class: 'lg-small', x: 6, y: 42 }, 'нос ↑'));
			g.append(el('text', { class: 'lg-small', x: 6, y: 186 }, 'лодка'));
			g.append(el('text', { class: 'lg-small', x: 168, y: 186 }, 'вода'));
			const ripples = el('path', { class: 'lg-ripple' });
			const oar = el('g', {});
			oar.append(el('path', { class: 'lg-woodline', d: 'M-66 0 L100 0', 'stroke-width': 4.5 }), el('ellipse', { class: 'lg-wood', cx: 120, cy: 0, rx: 24, ry: 7 }));
			g.append(ripples, oar, el('path', { class: 'lg-rod', d: `M${L.x - 3} ${L.y - 7} V${L.y + 7}`, 'stroke-width': 3 }));
			const h1 = fist(g, { x: 48, y: 70 }, 26, 26, -1);
			const h2 = fist(g, { x: 8, y: 70 }, 26, 26, 1);
			g.append(el('circle', { class: 'lg-skin-fill', cx: 28, cy: 66, r: 9 }), el('path', { class: 'lg-hair', d: 'M19 64 A9 9 0 0 1 37 64 Q28 60 19 64 Z' }));
			g.append(el('circle', { class: 'lg-pivot', cx: L.x, cy: L.y, r: 4.5 }));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			const T = 3;
			return (t) => {
				const ph = (t % T) / T;
				const stroke = ph < 0.6;
				const u = stroke ? ph / 0.6 : 1 - (ph - 0.6) / 0.4;
				const e = u * u * (3 - 2 * u);
				const psi = (-24 + 48 * e) * D;
				oar.setAttribute('transform', `translate(${L.x} ${L.y}) rotate(${f(psi / D)})`);
				oar.style.opacity = stroke ? '1' : '0.55';
				const handle = rot(L, { x: L.x - 56, y: L.y }, psi);
				h1(rot(L, { x: L.x - 46, y: L.y }, psi), psi);
				h2(rot(L, { x: L.x - 62, y: L.y }, psi), psi);
				const blade = rot(L, { x: L.x + 120, y: L.y }, psi);
				const show = stroke ? Math.min(1, Math.min(u, 1 - u) * 8) : 0;
				ripples.setAttribute('d', stroke ? `M${f(blade.x - 18)} ${f(blade.y + 14)} q9 5 18 0 q9 -5 18 0 M${f(blade.x - 12)} ${f(blade.y + 22)} q6 3 12 0 q6 -3 12 0` : '');
				F1({ x: handle.x, y: handle.y - 8 }, UP, 30, { x: handle.x + 14, y: handle.y - 28 }, show);
				F2(blade, UP, 30 * (56 / 120), { x: blade.x + 14, y: blade.y - 12 }, show);
			};
		},
		// ---------------- beam balance
		sk(g) {
			const P = { x: 120, y: 54 };
			g.append(el('path', { class: 'lg-rod', d: `M${P.x} ${P.y} V178`, 'stroke-width': 6 }), el('path', { class: 'lg-steel', d: 'M84 186 Q120 170 156 186 Z' }));
			const beam = el('path', { class: 'lg-rod', d: `M${P.x - 84} ${P.y} H${P.x + 84}`, 'stroke-width': 5 });
			const pan = (cls: 'box' | 'gold') => {
				const p = el('g', {});
				p.append(el('path', { class: 'lg-thin', d: 'M0 0 V12 L-24 52 M0 12 L24 52 M0 12 V52' }), el('path', { class: 'lg-steel', d: 'M-28 52 Q0 64 28 52 Z' }));
				if (cls === 'box') p.append(el('rect', { class: 'lg-box', x: -12, y: 32, width: 24, height: 20, rx: 2 }));
				else p.append(el('rect', { class: 'lg-gold', x: -15, y: 38, width: 12, height: 14, rx: 2 }), el('rect', { class: 'lg-gold', x: 3, y: 42, width: 11, height: 10, rx: 2 }));
				return p;
			};
			const lp = pan('box');
			const rp = pan('gold');
			g.append(beam, lp, rp, el('circle', { class: 'lg-pivot', cx: P.x, cy: P.y, r: 4.5 }));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			const T = 5;
			return (t) => {
				const tt = t % T;
				const a = 7 * Math.cos((2 * Math.PI * tt) / 1.6) * Math.exp(-tt / 1.3) * D;
				beam.setAttribute('transform', `rotate(${f(a / D)} ${P.x} ${P.y})`);
				const l = rot(P, { x: P.x - 80, y: P.y }, a);
				const r = rot(P, { x: P.x + 80, y: P.y }, a);
				lp.setAttribute('transform', `translate(${f(l.x)} ${f(l.y)})`);
				rp.setAttribute('transform', `translate(${f(r.x)} ${f(r.y)})`);
				F1(l, DOWN, 24, { x: l.x - 14, y: l.y + 18 });
				F2(r, DOWN, 24, { x: r.x + 15, y: r.y + 18 });
			};
		},
		// ---------------- forearm
		fa(g) {
			const S = { x: 66, y: 46 };
			const E = { x: 66, y: 136 };
			const upper = el('path', { class: 'lg-arm', d: `M${S.x} ${S.y - 6} L${E.x} ${E.y}`, 'stroke-width': 30 });
			const upperIn = el('path', { class: 'lg-arm-in', d: `M${S.x} ${S.y - 6} L${E.x} ${E.y}`, 'stroke-width': 28.5 });
			const fore = el('path', { class: 'lg-arm', 'stroke-width': 24 });
			const foreIn = el('path', { class: 'lg-arm-in', 'stroke-width': 22.5 });
			const humerus = el('path', { class: 'lg-bone', d: `M${S.x} ${S.y - 2} L${E.x} ${E.y - 3}` });
			const radius = el('path', { class: 'lg-bone', 'stroke-width': 4.5 });
			const muscle = el('path', { class: 'lg-muscle' });
			const palm = el('path', { class: 'lg-skin-fill' });
			const ball = el('circle', { class: 'lg-ball', r: 12 });
			const fingers = el('path', { class: 'lg-skin-fill' });
			g.append(upper, fore, upperIn, foreIn, humerus, radius, muscle, palm, ball, fingers, el('circle', { class: 'lg-pivot', cx: E.x, cy: E.y, r: 4.5 }));
			g.append(el('text', { class: 'lg-small', x: E.x - 4, y: E.y + 30, 'text-anchor': 'middle' }, 'локоть'));
			g.append(el('text', { class: 'lg-small', x: S.x - 22, y: S.y + 16, 'text-anchor': 'end' }, 'мышца'));
			g.append(el('path', { class: 'lg-thin', d: `M${S.x - 20} ${S.y + 12} L${S.x + 8} ${S.y + 22}` }));
			g.append(el('text', { class: 'lg-small', x: S.x - 22, y: S.y + 56, 'text-anchor': 'end' }, 'кость'));
			g.append(el('path', { class: 'lg-thin', d: `M${S.x - 20} ${S.y + 52} L${S.x - 2} ${S.y + 48}` }));
			const F1 = force(g, 1);
			const F2 = force(g, 2);
			return (t) => {
				const w0 = wave(t, 3.4);
				const b = -34 * w0 * D; // the forearm turns up
				const at = (l: number, n = 0) => ({ x: E.x + l * Math.cos(b) + n * Math.sin(b), y: E.y + l * Math.sin(b) - n * Math.cos(b) });
				const w = at(108);
				for (const p of [fore, foreIn]) p.setAttribute('d', `M${E.x} ${E.y} L${f(w.x)} ${f(w.y)}`);
				const r0 = at(5);
				radius.setAttribute('d', `M${f(r0.x)} ${f(r0.y)} L${f(w.x)} ${f(w.y)}`);
				// the palm, open upward, and the ball on it 126 px from the elbow
				const p0 = at(104, -9);
				const p1 = at(134, -6);
				const p2 = at(136, 4);
				const p3 = at(110, 9);
				palm.setAttribute('d', `M${f(p0.x)} ${f(p0.y)} L${f(p1.x)} ${f(p1.y)} Q${f(at(142, 0).x)} ${f(at(142, 0).y)} ${f(p2.x)} ${f(p2.y)} L${f(p3.x)} ${f(p3.y)} Z`);
				const c = at(126, 17);
				ball.setAttribute('cx', f(c.x));
				ball.setAttribute('cy', f(c.y));
				const q0 = at(134, 3);
				const q1 = at(141, 12);
				const q2 = at(137, 13);
				fingers.setAttribute('d', `M${f(q0.x)} ${f(q0.y)} Q${f(at(142, 6).x)} ${f(at(142, 6).y)} ${f(q1.x)} ${f(q1.y)} L${f(q2.x)} ${f(q2.y)} Q${f(at(136, 8).x)} ${f(at(136, 8).y)} ${f(at(131, 4).x)} ${f(at(131, 4).y)} Z`);
				// the biceps from the shoulder to 16 px from the elbow; it bulges more as the forearm rises
				const ins = at(16, 6);
				const top = { x: S.x + 4, y: S.y + 6 };
				const bulge = 14 + 6 * w0;
				const mid = { x: (top.x + ins.x) / 2 + bulge, y: (top.y + ins.y) / 2 };
				muscle.setAttribute('d', `M${f(top.x)} ${f(top.y)} Q${f(mid.x + 8)} ${f(mid.y - 6)} ${f(ins.x + 1)} ${f(ins.y - 2)} L${f(ins.x - 2)} ${f(ins.y + 1)} Q${f(mid.x - 10)} ${f(mid.y + 4)} ${f(top.x - 3)} ${f(top.y + 6)} Z`);
				const dir = { x: top.x - ins.x, y: top.y - ins.y };
				const dl = Math.hypot(dir.x, dir.y);
				F1(ins, { x: dir.x / dl, y: dir.y / dl }, 80, { x: ins.x + 26, y: ins.y - 56 });
				F2(c, DOWN, 10, { x: c.x + 20, y: c.y + 12 });
			};
		},
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-levgal]')) {
		const frames: ((t: number) => void)[] = [];
		for (const svg of root.querySelectorAll<SVGSVGElement>('svg[data-t]')) {
			const build = panels[svg.dataset.t!];
			if (build) frames.push(build(svg.querySelector<SVGGElement>('[data-art]')!));
		}
		let t = 0;
		for (const fr of frames) fr(0);
		loop(root, (dt) => {
			t += dt;
			for (const fr of frames) fr(t);
			return true;
		});
	}
</script>
