---
/**
 * Picture «Где встречаются рычаги»: eight small animated schemes in the order of the list in the text — scissors,
 * cutters, a wheelbarrow, a crowbar, a nail puller, an oar, a beam balance, the forearm. In each the axis (support) is a
 * gold dot, F₁ (red, as the applied force everywhere in the chapter) is the force we apply, F₂ (blue) the force we
 * overcome; every arrow starts at the point where its
 * force acts. The two arrows of one panel are drawn to one scale: their lengths are inversely proportional to the arms
 * in the drawing (the rule of moments), so the longer arm has the shorter arrow; the panels have different scales.
 * Not to scale otherwise; the motions are slowed down and exaggerated (a few degrees in reality). Where a hand applies
 * F₁, the arm is drawn up to the shoulder (the body is cut by the edge of the panel; the oar is seen from above, so the
 * rower is seen from above too).
 *
 * Ножницы — the half whose ring is on top: the fingers push its ring down (F₁, arm 56 px), the paper pushes its blade
 *   down (F₂, about 24 px from the axis): F₂ ≈ 2,3 F₁.
 * Кусачки — handles 112 px, the wire 16 px from the axis: F₂ = 7 F₁.
 * Тачка — the axis is the wheel's axle; the load's weight F₂ 58 px from it, the hands F₁ 178 px: F₁ ≈ 0,33 F₂.
 * Лом — arms 100 px and 25 px: F₂ = 4 F₁.
 * Гвоздодёр — the heel on the board is the axis; the hand pulls the top of the handle sideways (arm 100 px), the nail
 *   holds the claw (arm 20 px): F₂ = 5 F₁.
 * Весло — seen from above; the axis is the oarlock (уключина); the hands pull the handle toward the bow (arm 62 px),
 *   the water pushes the blade toward the bow (arm 120 px): F₂ ≈ 0,52 F₁. Arrows only during the stroke.
 * Весы — equal arms, equal forces; the beam swings and settles (a damped swing, 1,6 с period).
 * Предплечье — the axis is the elbow; the biceps pulls the forearm 16 px from it, the ball lies on the palm 128 px from
 *   it: F₁ = 8 F₂ (in a real arm 4–5 см and 35 см: eight to ten times).
 */
import G7Styles from '../g7/G7Styles.astro';

const W = 240;
const H = 210;
const tiles = [
	{ id: 'sc', title: 'Ножницы', note: 'F₁ — пальцы, F₂ — бумага' },
	{ id: 'cu', title: 'Кусачки', note: 'ручки длинные: F₁ в 7 раз меньше F₂' },
	{ id: 'wb', title: 'Тачка', note: 'опора — ось колеса, F₂ — вес груза' },
	{ id: 'cb', title: 'Лом', note: 'F₁ — руки, F₂ — камень давит на лом' },
	{ id: 'np', title: 'Гвоздодёр', note: 'опора — пятка, F₂ — гвоздь держится' },
	{ id: 'oa', title: 'Весло (вид сверху)', note: 'опора — уключина, F₂ — вода давит' },
	{ id: 'sk', title: 'Рычажные весы', note: 'плечи равны — силы равны' },
	{ id: 'fa', title: 'Предплечье', note: 'опора — локоть, F₁ — мышца' },
];
---

<G7Styles />
<figure class="g7 g7--pic lg not-content" data-levgal>
	<div class="lg__key" aria-hidden="true">
		<span><svg viewBox="0 0 14 14" width="14" height="14"><circle class="lg-pivot" cx="7" cy="7" r="5"></circle></svg><span>опора (ось вращения)</span></span>
		<span><svg viewBox="0 0 26 10" width="26" height="10"><path class="lg-f1" d="M1 5 H18"></path><path class="lg-h1" d="M25 5 L16 0.5 V9.5 Z"></path></svg><span><i>F</i><sub>1</sub> — сила, которую прикладываем</span></span>
		<span><svg viewBox="0 0 26 10" width="26" height="10"><path class="lg-f2" d="M1 5 H18"></path><path class="lg-h2" d="M25 5 L16 0.5 V9.5 Z"></path></svg><span><i>F</i><sub>2</sub> — сила, которую преодолеваем</span></span>
	</div>
	<div class="g7__grid is-two lg__grid">
		{tiles.map((t) => (
			<svg class="g7__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.title}: ${t.note}`} data-t={t.id}>
				<text class="t-title" x={W / 2} y="18" text-anchor="middle">{t.title}</text>
				<g data-art></g>
				<text class="t-small lg__note" x={W / 2} y={H - 7} text-anchor="middle">{t.note}</text>
			</svg>
		))}
	</div>
	<figcaption class="g7__caption">Стрелки одной картинки нарисованы в одном масштабе: у длинного плеча сила меньше. Движения замедлены и преувеличены.</figcaption>
</figure>

