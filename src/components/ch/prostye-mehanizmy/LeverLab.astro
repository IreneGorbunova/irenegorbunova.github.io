---
/**
 * «Рычаг»: a light ruler on an axle at its middle, with hooks every 5 см from 5 to 30 см on each side. Weights of
 * 1 Н each (0…6) hang on the left at the distance l₁ and on the right at l₂. The model shows the products F₁·l₁ and
 * F₂·l₂ (in Н·м, l in metres) but does not name them: the model stands in «Рычаг», before «Момент силы». The ruler
 * turns toward the larger product (the tilt grows with the difference, at most 8°, so the picture stays readable) and
 * is level when they are equal.
 * 5 px per centimeter. The weights hang on threads, always vertically. The force with which each stack pulls its hook,
 * F = n · 1 Н, is drawn along the thread from the hook down, 11 px per Н, and the stack hangs below the arrow (the thread
 * is as long as the arrow). Colors as in the whole chapter: the load's force blue. The arm of each force, the distance from the axle to the
 * vertical line through the hook, is drawn as a bracket above the ruler at its true horizontal length (l·cos of the
 * tilt, at most 1 % shorter than the distance on the ruler); its label gives the distance on the ruler.
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 190;
const CY = 76;
const S = 5; // px per см
const marks = [-6, -5, -4, -3, -2, -1, 1, 2, 3, 4, 5, 6];
---

<G7Styles />
<figure class="g7 g7--stack lev not-content" data-lev>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 258" role="img" aria-label="Рычаг с грузами на левом и правом плече; показаны силы и их плечи" data-svg>
			<path class="lev__stand" d={`M${CX} ${CY} L${CX - 22} 234 H${CX + 22} Z`}></path>
			<line class="lev__base" x1="40" x2="340" y1="234" y2="234"></line>
			<line class="lev__axis" x1={CX} x2={CX} y1="30" y2={CY - 6}></line>
			<g data-arms></g>
			<g data-beam>
				<rect class="lev__beam" x={CX - 32 * S} y={CY - 5} width={64 * S} height="10" rx="2"></rect>
				{marks.map((i) => (
					<>
						<line class="lev__mark" x1={CX + i * 5 * S} x2={CX + i * 5 * S} y1={CY - 5} y2={CY + 5} />
						<circle class="lev__hook" cx={CX + i * 5 * S} cy={CY + 7} r="1.8" />
						<text class="lev__n" x={CX + i * 5 * S} y={CY - 9} text-anchor="middle">{Math.abs(i) * 5}</text>
					</>
				))}
			</g>
			<g data-loads></g>
			<circle class="lev__pivot" cx={CX} cy={CY} r="5"></circle>
			<text class="t-small" x={CX} y="252" text-anchor="middle">числа на рычаге — расстояние от оси в сантиметрах</text>
		</svg>
		<div class="g7__side lev__side">
			<div class="lev__col">
				<p class="g7__label">Слева</p>
				<label class="g7__slider">
					<span>Грузов по 1&nbsp;Н</span>
					<output data-of1></output>
					<input type="range" min="0" max="6" step="1" value="2" data-f1 aria-label="Число грузов слева" />
				</label>
				<label class="g7__slider">
					<span>Плечо <i>l</i><sub>1</sub></span>
					<output data-ol1></output>
					<input type="range" min="5" max="30" step="5" value="15" data-l1 aria-label="Левое плечо, сантиметры" />
				</label>
			</div>
			<div class="lev__col">
				<p class="g7__label">Справа</p>
				<label class="g7__slider">
					<span>Грузов по 1&nbsp;Н</span>
					<output data-of2></output>
					<input type="range" min="0" max="6" step="1" value="1" data-f2 aria-label="Число грузов справа" />
				</label>
				<label class="g7__slider">
					<span>Плечо <i>l</i><sub>2</sub></span>
					<output data-ol2></output>
					<input type="range" min="5" max="30" step="5" value="10" data-l2 aria-label="Правое плечо, сантиметры" />
				</label>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Слева <i>F</i><sub>1</sub> · <i>l</i><sub>1</sub></span><b data-m1></b></li>
				<li><span>Справа <i>F</i><sub>2</sub> · <i>l</i><sub>2</sub></span><b data-m2></b></li>
			</ul>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
</figure>

<style is:global>
	.lev__side {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.lev__side .g7__read {
		grid-column: 1 / -1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.lev__side .g7__msg {
		grid-column: 1 / -1;
	}
	.lev__col {
		display: grid;
		gap: 0.4rem;
	}
	.lev__col .g7__label {
		margin: 0;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.lev__stand {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.lev__base {
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.lev__beam {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.lev__mark {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.lev__hook {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.9;
	}
	.lev svg .lev__n {
		font-size: 12px;
		font-weight: 600;
		fill: var(--sl-color-gray-2);
	}
	.lev__pivot {
		fill: var(--g7-ink);
		stroke: var(--g7-paper);
		stroke-width: 1.5;
	}
	.lev__axis,
	.lev__act {
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.lev__wire {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.lev__w {
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.lev__w--l {
		fill: var(--g7-steel);
	}
	.lev__w--r {
		fill: color-mix(in oklab, var(--g7-gold) 70%, var(--g7-paper));
	}
	.lev__fhalo {
		fill: none;
		stroke: var(--g7-paper);
		stroke-width: 6;
		stroke-linecap: round;
	}
	.lev__f {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.lev__fhead {
		fill: var(--g7-blue);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.lev__dim {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.6;
	}
	.lev svg .lev__ft {
		font-size: 12px;
		font-weight: 700;
		fill: var(--g7-blue);
	}
	.lev svg .lev__it {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 14px;
	}
	.lev svg .lev__lt {
		font-size: 12px;
		font-weight: 700;
		fill: var(--g7-green);
	}
	@container (max-width: 30rem) {
		.lev__side .g7__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { el, fmtTrim, loop } from '../g7/kit';

	const CX = 190;
	const CY = 76;
	const S = 5; // px per см
	const PER = 11; // px per Н
	const WH = 8; // height of one weight, px
	const D = Math.PI / 180;
	const f = (v: number) => v.toFixed(1);
	const nb = '\u00a0'; // a no-break space between a number and its unit
	for (const root of document.querySelectorAll<HTMLElement>('[data-lev]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const f1 = q<HTMLInputElement>('[data-f1]');
		const f2 = q<HTMLInputElement>('[data-f2]');
		const l1 = q<HTMLInputElement>('[data-l1]');
		const l2 = q<HTMLInputElement>('[data-l2]');
		const beam = q<SVGGElement>('[data-beam]');
		const loads = q<SVGGElement>('[data-loads]');
		const arms = q<SVGGElement>('[data-arms]');
		let angle = 0;
		const state = () => {
			const F1 = Number(f1.value);
			const F2 = Number(f2.value);
			const L1 = Number(l1.value);
			const L2 = Number(l2.value);
			return { F1, F2, L1, L2, M1: (F1 * L1) / 100, M2: (F2 * L2) / 100 };
		};
		const m = (v: number) => `${fmtTrim(v, 2)}${nb}Н·м`;
		const lm = (v: number) => `${fmtTrim(v / 100, 2)}${nb}м`;
		// a label «F₁ = 2 Н»: the letter italic, its index a subscript
		const label = (cls: string, x: number, y: number, anchor: string, letter: string, index: string, rest: string) => {
			const t = el('text', { class: `${cls} t-halo`, x: f(x), y: f(y), 'text-anchor': anchor });
			t.append(el('tspan', { class: 'lev__it' }, letter), el('tspan', { 'font-size': '9', dy: '3' }, index), el('tspan', { dy: '-3' }, rest));
			return t;
		};
		// a stack of n weights hanging from the hook at the distance l (см) on the side `side`, the beam turned by `angle`
		const hang = (side: number, n: number, l: number, cls: string) => {
			if (!n) return;
			const a = angle * D;
			const lx = side * l * S;
			const hx = CX + lx * Math.cos(a) - 7 * Math.sin(a);
			const hy = CY + lx * Math.sin(a) + 7 * Math.cos(a);
			// the force on the hook, along the thread down from it; the stack hangs below the arrow
			const y1 = hy + 1 + n * PER;
			const top = y1 + 5;
			loads.append(el('line', { class: 'lev__wire', x1: f(hx), x2: f(hx), y1: f(hy + 1.8), y2: f(top) }));
			for (let i = 0; i < n; i++) loads.append(el('rect', { class: `lev__w ${cls}`, x: f(hx - 9), y: f(top + i * (WH + 1)), width: 18, height: WH, rx: 2 }));
			const d = `M${f(hx)} ${f(hy + 1)} V${f(y1 - 5)}`;
			loads.append(el('path', { class: 'lev__fhalo', d }));
			loads.append(el('path', { class: 'lev__f', d }));
			loads.append(el('path', { class: 'lev__fhead', d: `M${f(hx - 4.5)} ${f(y1 - 7)} L${f(hx + 4.5)} ${f(y1 - 7)} L${f(hx)} ${f(y1)} Z` }));
			// its label beside the arrow: toward the axle, or away from it near the axle (clear of the stand)
			const ix = side < 0 ? '1' : '2';
			const out = l <= 10 ? -1 : 1;
			loads.append(label('lev__ft', hx - side * out * 9, Math.max(hy + 14, (hy + y1) / 2 + 5), side * out < 0 ? 'start' : 'end', 'F', ix, ` = ${n}${nb}Н`));
			// the arm: the line of action up to the bracket, and the bracket from the axle
			const yb = 34;
			arms.append(el('line', { class: 'lev__act', x1: f(hx), x2: f(hx), y1: f(yb - 4), y2: f(hy - 10) }));
			arms.append(el('path', { class: 'lev__dim', d: `M${CX} ${yb - 5} V${yb + 5} M${CX} ${yb} H${f(hx)} M${f(hx)} ${yb - 5} V${yb + 5}` }));
			arms.append(label('lev__lt', (CX + hx) / 2, yb - 8, 'middle', 'l', ix, ` = ${l}${nb}см`));
		};
		const draw = () => {
			const { F1, F2, L1, L2 } = state();
			beam.setAttribute('transform', `rotate(${angle.toFixed(2)} ${CX} ${CY})`);
			loads.replaceChildren();
			arms.replaceChildren();
			hang(-1, F1, L1, 'lev__w--l');
			hang(1, F2, L2, 'lev__w--r');
		};
		const setup = () => {
			const { F1, F2, L1, L2, M1, M2 } = state();
			q('[data-of1]').textContent = String(F1);
			q('[data-of2]').textContent = String(F2);
			q('[data-ol1]').textContent = `${L1}${nb}см`;
			q('[data-ol2]').textContent = `${L2}${nb}см`;
			q('[data-m1]').textContent = m(M1);
			q('[data-m2]').textContent = m(M2);
			const msg = q<HTMLElement>('[data-msg]');
			const eq = Math.abs(M1 - M2) < 1e-9;
			msg.classList.toggle('is-right', eq && M1 > 0);
			msg.textContent = eq
				? M1 > 0
					? `Рычаг в равновесии: ${F1}${nb}Н · ${lm(L1)} = ${F2}${nb}Н · ${lm(L2)}.`
					: 'Грузов нет: рычаг в равновесии.'
				: M1 > M2
					? `Перевешивает левая сторона: F₁ · l₁ = ${m(M1)} больше, чем F₂ · l₂ = ${m(M2)}.`
					: `Перевешивает правая сторона: F₂ · l₂ = ${m(M2)} больше, чем F₁ · l₁ = ${m(M1)}.`;
			draw();
			wake();
		};
		const wake = loop(root, (dt) => {
			const { M1, M2 } = state();
			const d = M2 - M1; // > 0: the right side goes down
			const want = Math.abs(d) < 1e-9 ? 0 : Math.sign(d) * Math.min(8, 2.5 + Math.abs(d) * 10);
			angle += (want - angle) * Math.min(1, dt * 5);
			if (Math.abs(want - angle) < 0.02) angle = want;
			draw();
			return angle !== want;
		});
		for (const i of [f1, f2, l1, l2]) i.addEventListener('input', setup);
		setup();
	}
</script>
