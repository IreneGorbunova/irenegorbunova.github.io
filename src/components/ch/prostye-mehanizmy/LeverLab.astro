---
/**
 * «Рычаг»: a light ruler on a pivot at its middle, with hooks every 5 см. Weights of 1 Н each (0…6) hang on the
 * left at the distance l₁ (5…25 см) and on the right at l₂. The moments are M₁ = F₁·l₁ and M₂ = F₂·l₂; the ruler
 * turns toward the larger moment (the tilt grows with the difference, at most 14°) and is level when they are
 * equal. 5,2 px per centimeter.
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 190;
const CY = 96;
---

<G7Styles />
<figure class="g7 g7--stack lev not-content" data-lev>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 220" role="img" aria-label="Рычаг с грузами на левом и правом плече" data-svg>
			<path class="lev__stand" d={`M${CX} ${CY} L${CX - 22} 196 H${CX + 22} Z`}></path>
			<line class="lev__base" x1="110" x2="270" y1="196" y2="196"></line>
			<g data-beam>
				<rect class="lev__beam" x={CX - 140} y={CY - 5} width="280" height="10" rx="2"></rect>
				{[-5, -4, -3, -2, -1, 1, 2, 3, 4, 5].map((i) => (
					<>
						<line class="lev__mark" x1={CX + i * 26} x2={CX + i * 26} y1={CY - 5} y2={CY + 5} />
						<text class="lev__n" x={CX + i * 26} y={CY - 10} text-anchor="middle">{Math.abs(i) * 5}</text>
					</>
				))}
				<g data-left></g>
				<g data-right></g>
			</g>
			<circle class="lev__pivot" cx={CX} cy={CY} r="5"></circle>
			<text class="t-small" x={CX} y="214" text-anchor="middle">числа на рычаге — расстояние от оси в сантиметрах</text>
		</svg>
		<div class="g7__side lev__side">
			<div class="lev__col">
				<p class="g7__label">Слева</p>
				<label class="g7__slider">
					<span>Грузов по 1 Н</span>
					<output data-of1></output>
					<input type="range" min="0" max="6" step="1" value="2" data-f1 aria-label="Число грузов слева" />
				</label>
				<label class="g7__slider">
					<span>Плечо <i>l</i><sub>1</sub></span>
					<output data-ol1></output>
					<input type="range" min="5" max="25" step="5" value="15" data-l1 aria-label="Левое плечо, сантиметры" />
				</label>
			</div>
			<div class="lev__col">
				<p class="g7__label">Справа</p>
				<label class="g7__slider">
					<span>Грузов по 1 Н</span>
					<output data-of2></output>
					<input type="range" min="0" max="6" step="1" value="1" data-f2 aria-label="Число грузов справа" />
				</label>
				<label class="g7__slider">
					<span>Плечо <i>l</i><sub>2</sub></span>
					<output data-ol2></output>
					<input type="range" min="5" max="25" step="5" value="10" data-l2 aria-label="Правое плечо, сантиметры" />
				</label>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>Момент слева <i>F</i><sub>1</sub><i>l</i><sub>1</sub></span><b data-m1></b></li>
				<li><span>Момент справа <i>F</i><sub>2</sub><i>l</i><sub>2</sub></span><b data-m2></b></li>
			</ul>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
</figure>

<style is:global>
	.lev__side {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.lev__side .g7__read {
		grid-column: 1 / -1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.lev__side .g7__msg {
		grid-column: 1 / -1;
	}
	.lev__col {
		display: grid;
		gap: 0.4rem;
	}
	.lev__col .g7__label {
		margin: 0;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.lev__stand {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.lev__base {
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.lev__beam {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.lev__mark {
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.lev svg .lev__n {
		font-size: 9px;
		fill: var(--sl-color-gray-2);
	}
	.lev__pivot {
		fill: var(--g7-ink);
	}
	.lev__wire {
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.lev__w {
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.lev__w--l {
		fill: var(--g7-blue);
	}
	.lev__w--r {
		fill: var(--g7-gold);
	}
	@container (max-width: 30rem) {
		.lev__side .g7__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { el, fmtTrim, loop } from '../g7/kit';

	const CX = 190;
	const CY = 96;
	for (const root of document.querySelectorAll<HTMLElement>('[data-lev]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const f1 = q<HTMLInputElement>('[data-f1]');
		const f2 = q<HTMLInputElement>('[data-f2]');
		const l1 = q<HTMLInputElement>('[data-l1]');
		const l2 = q<HTMLInputElement>('[data-l2]');
		const beam = q<SVGGElement>('[data-beam]');
		let angle = 0;
		const hang = (g: SVGGElement, side: number, n: number, l: number, cls: string) => {
			g.replaceChildren();
			if (!n) return;
			const x = CX + side * (l / 5) * 26;
			g.append(el('line', { class: 'lev__wire', x1: x, x2: x, y1: CY + 5, y2: CY + 18 }));
			for (let i = 0; i < n; i++) g.append(el('rect', { class: `lev__w ${cls}`, x: x - 9, y: CY + 18 + i * 11, width: 18, height: 10, rx: 2 }));
		};
		const state = () => {
			const F1 = Number(f1.value);
			const F2 = Number(f2.value);
			const L1 = Number(l1.value);
			const L2 = Number(l2.value);
			return { F1, F2, L1, L2, M1: (F1 * L1) / 100, M2: (F2 * L2) / 100 };
		};
		const setup = () => {
			const { F1, F2, L1, L2, M1, M2 } = state();
			hang(q<SVGGElement>('[data-left]'), -1, F1, L1, 'lev__w--l');
			hang(q<SVGGElement>('[data-right]'), 1, F2, L2, 'lev__w--r');
			q('[data-of1]').textContent = `${F1} Н`;
			q('[data-of2]').textContent = `${F2} Н`;
			q('[data-ol1]').textContent = `${L1} см`;
			q('[data-ol2]').textContent = `${L2} см`;
			q('[data-m1]').textContent = `${fmtTrim(M1, 2)} Н·м`;
			q('[data-m2]').textContent = `${fmtTrim(M2, 2)} Н·м`;
			const msg = q<HTMLElement>('[data-msg]');
			const eq = Math.abs(M1 - M2) < 1e-9;
			msg.classList.toggle('is-right', eq && M1 > 0);
			msg.textContent = eq ? (M1 > 0 ? `Рычаг в равновесии: ${F1} Н · ${L1} см = ${F2} Н · ${L2} см.` : 'Грузов нет: рычаг в равновесии.') : M1 > M2 ? 'Перевешивает левая сторона: её момент больше.' : 'Перевешивает правая сторона: её момент больше.';
			wake();
		};
		const wake = loop(root, (dt) => {
			const { M1, M2 } = state();
			const d = M2 - M1; // > 0: the right side goes down
			const want = d === 0 ? 0 : Math.sign(d) * Math.min(14, 4 + Math.abs(d) * 14);
			angle += (want - angle) * Math.min(1, dt * 5);
			beam.setAttribute('transform', `rotate(${angle.toFixed(2)} ${CX} ${CY})`);
			return Math.abs(want - angle) > 0.02;
		});
		for (const i of [f1, f2, l1, l2]) i.addEventListener('input', setup);
		setup();
	}
</script>
