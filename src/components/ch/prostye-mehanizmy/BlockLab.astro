	}
	/* the man (personHome.ts) */
	[data-blk] .ph-far {
		filter: brightness(0.8);
	}
	[data-blk] .ph-outline {
		fill: none;
		stroke: var(--ph-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-blk] .ph-pants,
	[data-blk] .ph-sleeve,
	[data-blk] .ph-skin-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-blk] .ph-pants {
		stroke: var(--ph-pants);
	}
	[data-blk] .ph-skin-limb {
		stroke: var(--ph-skin);
	}
	[data-blk] .ph-sleeve.blk-shirt {
		stroke: var(--blk-shirt);
