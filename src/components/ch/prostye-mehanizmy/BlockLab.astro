</style>

<script>
	import { el, fmt, fmtTrim, loop, segment } from '../g7/kit';
	import { person } from '../davlenie-v-zhidkosti/personHome';

	const M = 60; // px per metre
	const R = 12; // px, wheel radius
	const CEIL = 22;
	const FLOOR = 336;
	const GX = 126; // the fixed pulley
	const GY = 40;
	const DOWN = GX + R; // the strand the man pulls
	const LOAD_H = 28;
	const RIB0 = 58; // the red mark at the start, just under the top pulley
	const Y2 = 190; // the second movable pulley at the start
	const K = 0.12; // px per newton in the inset
	const BASE = 90; // the line the arrows of the inset start from
	const V = 0.8 * M; // px/s of the pulled rope
	const STROKE = 0.7 * M; // px, one pull of a hand
	const Y_TOP = FLOOR - 1.78 * M; // the hands grip between these heights
	const Y_BOT = Y_TOP + STROKE;
	const MIR = 300; // the man's group is mirrored: x' = MIR − x
	const f = (v: number) => v.toFixed(2);
	const loadW = (m: number) => 30 + 0.12 * m;

	type Seg = { k: 'L'; x1: number; y1: number; x2: number; y2: number } | { k: 'A'; cx: number; cy: number; a0: number; a1: number };
	const L = (x1: number, y1: number, x2: number, y2: number): Seg => ({ k: 'L', x1, y1, x2, y2 });
	const A = (cx: number, cy: number, a0: number, a1: number): Seg => ({ k: 'A', cx, cy, a0, a1 });
	const segLen = (s: Seg) => (s.k === 'L' ? Math.hypot(s.x2 - s.x1, s.y2 - s.y1) : R * Math.abs(s.a1 - s.a0));
	/** The point of the path at distance d from its start, with the direction of the path there. */
	const pointAt = (segs: Seg[], d: number) => {
		for (const s of segs) {
			const l = segLen(s);
			if (d <= l || s === segs[segs.length - 1]) {
				const u = Math.min(1, Math.max(0, d / l));
				if (s.k === 'L') return { x: s.x1 + (s.x2 - s.x1) * u, y: s.y1 + (s.y2 - s.y1) * u, tx: (s.x2 - s.x1) / l, ty: (s.y2 - s.y1) / l };
				const a = s.a0 + (s.a1 - s.a0) * u;
				const sg = Math.sign(s.a1 - s.a0);
				return { x: s.cx + R * Math.cos(a), y: s.cy + R * Math.sin(a), tx: -Math.sin(a) * sg, ty: Math.cos(a) * sg };
			}
			d -= l;
		}
		return { x: 0, y: 0, tx: 0, ty: 1 };
	};
	const pathD = (segs: Seg[]) => {
		let d = '';
		for (const s of segs) {
			if (s.k === 'L') d += `${d ? 'L' : 'M'}${f(s.x1)} ${f(s.y1)} L${f(s.x2)} ${f(s.y2)} `;
			else d += `A${R} ${R} 0 0 ${s.a1 > s.a0 ? 1 : 0} ${f(s.cx + R * Math.cos(s.a1))} ${f(s.cy + R * Math.sin(s.a1))} `;
		}
		return d;
	};
	/** A filled arrow from (x, y0) down by len px; the head shrinks with a short arrow. */
	const arrowDown = (x: number, y0: number, len: number, w = 1.3) => {
		if (len < 0.3) return '';
		const hl = Math.min(8, len);
		const hw = 1.2 + 3 * (hl / 8);
		const y1 = y0 + len - hl;
		return `M${f(x - w)} ${f(y0)} H${f(x + w)} V${f(y1)} H${f(x + hw)} L${f(x)} ${f(y0 + len)} L${f(x - hw)} ${f(y1)} H${f(x - w)} Z`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-blk]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const scene = q<SVGGElement>('[data-scene]');
		const marks = q<SVGGElement>('[data-marks]');
		const mIn = q<HTMLInputElement>('[data-m]');
		const pose = person(q<SVGGElement>('[data-man]'), { s: M / 100, H: 170, girth: 1, shirt: 'blk-shirt' });
		// the grid of the inset: cells of 100 Н
		const grid = q<SVGGElement>('[data-grid]');
		for (let i = 0; i <= 10; i++) grid.append(el('line', { class: i ? 'blk__cell' : 'blk__base', x1: 210, x2: 286, y1: BASE + i * 100 * K, y2: BASE + i * 100 * K }));
		let kind = 'fixed';
		let s = 0; // px of rope pulled
		let running = false;
		const gainOf = () => (kind === 'fixed' ? 1 : kind === 'mov' ? 2 : 4);

		const wheel = (x: number, y: number, turn: number) => {
			const g = el('g', {});
			g.append(el('circle', { class: 'blk__wheel', cx: x, cy: y, r: R }), el('circle', { class: 'blk__groove', cx: x, cy: y, r: R - 3 }));
			for (let i = 0; i < 3; i++) {
				const a = turn + (i * 2 * Math.PI) / 3;
				g.append(el('line', { class: 'blk__spoke', x1: x, y1: y, x2: f(x + (R - 4) * Math.cos(a)), y2: f(y + (R - 4) * Math.sin(a)) }));
			}
			g.append(el('circle', { class: 'blk__axle', cx: x, cy: y, r: 2.4 }));
			return g;
		};
		// the holder of a movable pulley: a strap from the axle down to a hook
		const strap = (x: number, y: number) => [
			el('rect', { class: 'blk__strap', x: x - 2.5, y, width: 5, height: R + 6, rx: 1.5 }),
			el('path', { class: 'blk__hook', d: `M${x} ${y + R + 5} V${y + R + 10} q0 4 3.5 4 q3 0 3 -3` }),
		];
		const load = (x: number, top: number, m: number) => {
			const w = loadW(m);
			return [
				el('circle', { class: 'blk__hook', cx: x, cy: top - 4, r: 4 }),
				el('rect', { class: 'blk__load', x: f(x - w / 2), y: f(top), width: f(w), height: LOAD_H, rx: 2 }),
				el('text', { class: 't-small blk__loadtext', x, y: f(top + LOAD_H / 2 + 4), 'text-anchor': 'middle' }, `${m}\u00a0кг`),
			];
		};

		const draw = () => {
			const m = Number(mIn.value);
			const P = 9.8 * m;
			const gain = gainOf();
			const F = P / gain;
			const hp = s / gain; // px: the load has risen by this much
			const top = FLOOR - LOAD_H - hp;
			const guide = [A(GX, GY, Math.PI, 2 * Math.PI), L(DOWN, GY, DOWN, FLOOR)];
			let rope: Seg[];
			let lx: number; // the load's center
			const parts: SVGElement[] = [];
			// the rope pulled out lies on the floor
			const coils = 2 + Math.floor(s / 24);
			for (let i = 0; i < coils; i++) parts.push(el('ellipse', { class: 'blk__coil', cx: DOWN + 2 + (i % 2 ? 3 : -2), cy: f(FLOOR - 2.2 - i * 1.6), rx: 8 + (i % 3), ry: 2.2 }));
			// the fixed pulley on its bracket; it turns by s/R
			parts.push(el('rect', { class: 'blk__strap', x: GX - 2.5, y: CEIL, width: 5, height: GY - CEIL, rx: 1 }));
			if (kind === 'fixed') {
				lx = GX - R;
				rope = [L(lx, top - 6, lx, GY), ...guide];
				parts.push(el('path', { class: 'blk__rope', d: pathD(rope) }), wheel(GX, GY, s / R), ...load(lx, top, m));
			} else if (kind === 'mov') {
				const x1 = GX - 2 * R;
				const y1 = top - 26;
				lx = x1;
				rope = [L(x1 - R, CEIL, x1 - R, y1), A(x1, y1, Math.PI, 0), L(x1 + R, y1, x1 + R, GY), ...guide];
				parts.push(el('path', { class: 'blk__rope', d: pathD(rope) }), wheel(GX, GY, s / R), ...strap(x1, y1), ...load(lx, top, m), wheel(x1, y1, -hp / R));
			} else {
				const x1 = GX - 3 * R;
				const y1 = top - 26;
				const x2 = GX - 2 * R;
				const y2 = Y2 - 2 * hp;
				lx = x1;
				rope = [L(x2 - R, CEIL, x2 - R, y2), A(x2, y2, Math.PI, 0), L(x2 + R, y2, x2 + R, GY), ...guide];
				const rope1 = [L(x1 - R, CEIL, x1 - R, y1), A(x1, y1, Math.PI, 0), L(x1 + R, y1, x1 + R, y2 + R + 13)];
				parts.push(
					el('path', { class: 'blk__rope', d: pathD(rope1) }),
					el('path', { class: 'blk__rope', d: pathD(rope) }),
					wheel(GX, GY, s / R),
					...strap(x2, y2),
					el('circle', { class: 'blk__hook', cx: x2, cy: y2 + R + 10, r: 3 }),
					wheel(x2, y2, (-2 * hp) / R),
					...strap(x1, y1),
					...load(lx, top, m),
					wheel(x1, y1, -hp / R),
				);
			}
			// the bracket h at the load
			const hx = lx - loadW(m) / 2 - 7;
			if (hp > 1) {
				parts.push(el('path', { class: 'blk__dim', d: `M${hx - 3} ${FLOOR} H${hx + 3} M${hx} ${FLOOR} V${f(FLOOR - hp)} M${hx - 3} ${f(FLOOR - hp)} H${hx + 3}` }));
				parts.push(el('text', { class: 't-i t-halo', x: hx - 4, y: f(FLOOR - hp / 2 + 5), 'text-anchor': 'end' }, 'h'));
			}
			scene.replaceChildren(...parts);

			// the marks on the pulled rope: ticks every 0,5 м and the red mark
			const lenT = rope.slice(0, -1).reduce((a, sg) => a + segLen(sg), 0); // to the start of the down strand
			const total = lenT + (FLOOR - GY);
			const sigR = lenT + s + (RIB0 - GY); // the red mark: its distance along the rope from the tied end
			const mk: SVGElement[] = [];
			for (let k = -12; k < 40; k++) {
				const sg = sigR - k * 0.5 * M;
				if (sg <= 1 || sg >= total - 4 || k === 0) continue;
				const p = pointAt(rope, sg);
				mk.push(el('line', { class: 'blk__tick', x1: f(p.x - p.ty * 2.4), y1: f(p.y + p.tx * 2.4), x2: f(p.x + p.ty * 2.4), y2: f(p.y - p.tx * 2.4) }));
			}
			const rp = pointAt(rope, sigR);
			mk.push(el('rect', { class: 'blk__ribbon', x: f(rp.x - 4), y: f(rp.y - 2), width: 8, height: 4, rx: 1 }));
			if (s > 1) {
				const bx = DOWN - 10;
				mk.push(el('path', { class: 'blk__dim', d: `M${bx - 3} ${RIB0} H${bx + 3} M${bx} ${RIB0} V${f(RIB0 + s)} M${bx - 3} ${f(RIB0 + s)} H${bx + 3}` }));
				mk.push(el('text', { class: 't-i t-halo', x: bx - 4, y: f(RIB0 + Math.min(s / 2, 60) + 5), 'text-anchor': 'end' }, 's'));
			}
			marks.replaceChildren(...mk);

			// hand over hand: one hand pulls down with the rope, the other goes back up off the rope
			const n = Math.floor(s / STROKE);
			const ph = s - n * STROKE;
			const pulling = { x: DOWN, y: Y_TOP + ph };
			const back = { x: DOWN + 3, y: Y_BOT - ph };
			const [hn, hf] = n % 2 === 0 ? [pulling, back] : [back, pulling];
			const loc = (p: { x: number; y: number }) => ({ x: MIR - p.x, y: p.y });
			pose({
				hip: { x: MIR - 158, y: FLOOR - 51 },
				lean: -0.06,
				ankles: [
					{ x: MIR - 152, y: FLOOR - 4.5 },
					{ x: MIR - 166, y: FLOOR - 4.5 },
				],
				feet: [0, 0],
				hands: [loc(hn), loc(hf)],
				head: -0.35,
			});

			// the inset
			q('[data-parrow]').setAttribute('d', arrowDown(226, BASE, P * K));
			q('[data-farrow]').setAttribute('d', arrowDown(270, BASE, F * K));
			const pv = q<SVGTextElement>('[data-pval]');
			pv.setAttribute('y', f(BASE + P * K + 13));
			pv.textContent = `${fmtTrim(P, 1)}\u00a0Н`;
			const fv = q<SVGTextElement>('[data-fval]');
			fv.setAttribute('y', f(BASE + F * K + 13));
			fv.textContent = `${fmtTrim(F, 1)}\u00a0Н`;

			q('[data-om]').textContent = `${m}\u00a0кг`;
			q('[data-p]').textContent = `${fmtTrim(P, 1)}\u00a0Н`;
			q('[data-f]').textContent = `${fmtTrim(F, 1)}\u00a0Н`;
			q('[data-h]').textContent = `${fmt(hp / M, 2)}\u00a0м`;
			q('[data-rope]').textContent = `${fmt(s / M, 2)}\u00a0м`;
			q('[data-a]').textContent = `${fmtTrim((F * s) / M, 0)}\u00a0Дж`;
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			s = Math.min(gainOf() * M, s + V * dt);
			draw();
			if (s >= gainOf() * M) running = false;
			return running;
		});
		const goBtn = q<HTMLButtonElement>('[data-go]');
		const heavyMsg = q<HTMLElement>('[data-heavy]');
		const MAX_FIXED = 60; // кг: the man (about 70 кг) cannot pull down harder than his weight
		const check = () => {
			const heavy = kind === 'fixed' && Number(mIn.value) > MAX_FIXED;
			goBtn.disabled = heavy;
			heavyMsg.hidden = !heavy;
		};
		goBtn.addEventListener('click', () => {
			if (goBtn.disabled) return;
			s = 0;
			running = true;
			wake();
		});
		mIn.addEventListener('input', () => {
			running = false;
			s = 0;
			check();
			draw();
		});
		segment(q('[data-kind]'), (b) => {
			kind = b.dataset.k!;
			running = false;
			s = 0;
			check();
			draw();
		});
		check();
		draw();
	}
</script>
