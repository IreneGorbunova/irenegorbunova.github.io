---
/**
 * «Блоки»: a load (10…100 кг) is lifted by h = 1 м. A man on the floor pulls the rope down hand over hand; the rope
 * runs over a fixed pulley at the ceiling. Three set-ups:
 *   Неподвижный — the load hangs on the rope itself: F = P, s = h;
 *   Подвижный — the load hangs on a movable pulley, one end of its rope is tied to the ceiling: F = P/2, s = 2h;
 *   Два подвижных — the load hangs on the first movable pulley; its rope goes from the ceiling round it and up to the
 *     hook of the second movable pulley; the rope of the second one is the one pulled: F = P/4, s = 4h.
 * The fixed pulley at the top only turns the force downwards (it is in all three set-ups, as the text says: «обычно
 * подвижный блок соединяют с неподвижным»). Pulleys and ropes are weightless, no friction: P = 9,8 Н/кг · m.
 *
 * Scale: heights and lengths 60 px per metre (the man is 1,7 м tall, the load rises 60 px, the rope moves 60, 120 or
 * 240 px); the wheels are drawn 40 см across, larger than real. The rope is pulled at 0,8 м/с (strokes of 0,7 м,
 * one hand pulls while the other goes up), so the lift takes 1,25, 2,5 or 5 с: the load rises slower when the force
 * is smaller. Every point of the pulled rope is followed along its path (the rope is tied at one end, so a point
 * keeps its distance along the rope from that end): the ticks every 0,5 м show how the rope runs over the wheels, and
 * the red mark, which starts just under the top pulley, comes down by exactly the length pulled out (the bracket s).
 * The pulled rope piles up on the floor.
 *
 * Forces: the inset draws P and F as arrows from one line in one fixed scale, 0,12 px per newton (one cell 100 Н), so
 * 980 Н is 118 px and 24,5 Н is 2,9 px: the ratio is always seen, nothing is stretched to a minimum length.
 * The man weighs about 70 кг (686 Н): pulling down, he cannot pull harder than his own weight, or the rope lifts
 * him. So with the fixed pulley alone the model lifts at most 60 кг (588 Н); above that the button is off and a
 * message says why. With movable pulleys the force is at most 980/2 = 490 Н, which he can manage.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 blk not-content" data-blk>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 350" role="img" aria-label="Человек вытягивает верёвку, перекинутую через блоки, и груз поднимается на 1 метр" data-svg>
			<rect class="blk__ceil" x="0" y="10" width="300" height="12"></rect>
			<path class="blk__hatch" d="M8 10 l8 -8 M28 10 l8 -8 M48 10 l8 -8 M68 10 l8 -8 M88 10 l8 -8 M108 10 l8 -8 M128 10 l8 -8 M148 10 l8 -8 M168 10 l8 -8 M188 10 l8 -8 M208 10 l8 -8 M228 10 l8 -8 M248 10 l8 -8 M268 10 l8 -8 M288 10 l8 -8"></path>
			<rect class="blk__ground" x="0" y="336" width="300" height="14"></rect>
			<line class="blk__floor" x1="0" x2="300" y1="336" y2="336"></line>
			<g data-scene></g>
			<g data-man transform="matrix(-1 0 0 1 300 0)"></g>
			<g data-marks></g>
			<text class="t-i t-red t-halo" x="143" y="216">F</text>
			<!-- the inset: P and F in one scale -->
			<rect class="blk__card" x="200" y="28" width="96" height="222" rx="6"></rect>
			<text class="t-small" x="248" y="44" text-anchor="middle">силы в одном</text>
			<text class="t-small" x="248" y="57" text-anchor="middle">масштабе</text>
			<g data-grid></g>
			<text class="t-i t-blue t-halo" x="226" y="82" text-anchor="middle">P</text>
			<text class="t-i t-red t-halo" x="270" y="82" text-anchor="middle">F</text>
			<path class="head--blue" data-parrow></path>
			<path class="head--red" data-farrow></path>
			<text class="t-small t-num t-halo" x="226" data-pval text-anchor="middle"></text>
			<text class="t-small t-num t-halo" x="270" data-fval text-anchor="middle"></text>
			<text class="t-small" x="248" y="243" text-anchor="middle">клетка — 100&nbsp;Н</text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Какие блоки" data-kind>
				<button type="button" class="g7__btn" aria-pressed="true" data-k="fixed">Неподвижный</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-k="mov">Подвижный</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-k="two">Два подвижных</button>
			</div>
			<label class="g7__slider">
				<span>Масса груза</span>
				<output data-om></output>
				<input type="range" min="10" max="100" step="10" value="40" data-m aria-label="Масса груза, килограммы" />
			</label>
			<button type="button" class="g7__btn g7__btn--go" data-go>Поднять груз на 1&nbsp;м</button>
			<p class="g7__msg" data-heavy hidden>
				Тянуть вниз сильнее своего веса нельзя: верёвка поднимет самого человека. Его масса около 70&nbsp;кг, поэтому с
				неподвижным блоком он поднимет груз не тяжелее 60&nbsp;кг. Возьмите подвижный блок.
			</p>
			<ul class="g7__read" aria-live="polite">
				<li><span>Вес груза <i>P</i></span><b data-p></b></li>
				<li class="is-key"><span>Сила, с которой тянут верёвку, <i>F</i></span><b data-f></b></li>
				<li><span>Груз поднялся на <i>h</i></span><b data-h></b></li>
				<li><span>Вытянуто верёвки <i>s</i></span><b data-rope></b></li>
				<li><span>Работа силы <i>F</i></span><b data-a></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Блоки и верёвки невесомые, трения нет; верхний неподвижный блок только меняет направление силы. Красная метка на
		верёвке опускается на столько, сколько верёвки вытянули.
	</figcaption>
</figure>

<style is:global>
	[data-blk] {
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
		--blk-shirt: hsl(150, 38%, 42%);
	}
	:root[data-theme='light'] [data-blk] {
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
		--blk-shirt: hsl(150, 40%, 38%);
	}
	.blk__ceil {
		fill: var(--g7-line);
	}
	.blk__hatch {
		stroke: var(--g7-line);
		stroke-width: 1.4;
	}
	.blk__ground {
		fill: var(--g7-ground);
	}
	.blk__floor {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.blk__rope {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.blk__coil {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.5;
	}
	.blk__tick {
		stroke: var(--g7-paper);
		stroke-width: 1.6;
	}
	.blk__ribbon {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 0.8;
	}
	.blk__wheel {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.blk__groove {
		fill: none;
