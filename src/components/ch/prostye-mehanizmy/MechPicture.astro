---
/**
 * Picture «Простые механизмы»: six small schemes: a lever, a pulley, a windlass, an inclined plane, a wedge, a
 * screw. Static drawings; the load is a dark box everywhere, the applied force a red arrow.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const items = [
	{ key: 'lever', name: 'Рычаг', ex: 'лом, ножницы, весы' },
	{ key: 'pulley', name: 'Блок', ex: 'подъёмный кран, флагшток' },
	{ key: 'windlass', name: 'Ворот', ex: 'колодец, руль, отвёртка' },
	{ key: 'plane', name: 'Наклонная плоскость', ex: 'пандус, горная дорога' },
	{ key: 'wedge', name: 'Клин', ex: 'топор, нож, игла' },
	{ key: 'screw', name: 'Винт', ex: 'болт, домкрат, тиски' },
];
---

<G7Styles />
<figure class="g7 g7--pic mch not-content">
	<div class="mch__grid">
		{
			items.map((it) => (
				<div>
					<svg class="g7__svg" viewBox="0 0 120 84" role="img" aria-label={`${it.name}: ${it.ex}`}>
						<defs>
							<marker id={`mch-${uid}-${it.key}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto">
								<path class="head--red" d="M0,0 L10,5 L0,10 z" />
							</marker>
						</defs>
						{it.key === 'lever' && (
							<>
								<path class="mch__body" d="M14 52 L106 32" />
								<path class="mch__fill" d="M44 62 l8 -16 l8 16 Z" />
								<rect class="mch__load" x="10" y="34" width="16" height="16" />
								<line class="arrow arrow--red" x1="104" y1="12" x2="104" y2="28" marker-end={`url(#mch-${uid}-${it.key})`} />
							</>
						)}
						{it.key === 'pulley' && (
							<>
								<line class="mch__body" x1="20" y1="8" x2="100" y2="8" />
								<circle class="mch__fill" cx="60" cy="24" r="13" />
								<path class="mch__rope" d="M47 24 V56 M73 24 V58" />
								<rect class="mch__load" x="39" y="56" width="16" height="16" />
								<line class="arrow arrow--red" x1="73" y1="56" x2="73" y2="72" marker-end={`url(#mch-${uid}-${it.key})`} />
							</>
						)}
						{it.key === 'windlass' && (
							<>
								<rect class="mch__fill" x="34" y="26" width="46" height="14" rx="7" />
								<path class="mch__body" d="M80 33 H96 V52" />
								<path class="mch__rope" d="M50 40 V60" />
								<rect class="mch__load" x="42" y="60" width="16" height="16" />
								<path class="mch__body" d="M28 20 V76 M86 20 V76" />
								<line class="arrow arrow--red" x1="104" y1="40" x2="104" y2="56" marker-end={`url(#mch-${uid}-${it.key})`} />
							</>
						)}
						{it.key === 'plane' && (
							<>
								<path class="mch__fill" d="M10 70 H110 V30 Z" />
								<rect class="mch__load" x="52" y="36" width="16" height="16" transform="rotate(-21.8 60 52)" />
								<line class="arrow arrow--red" x1="72" y1="38" x2="92" y2="30" marker-end={`url(#mch-${uid}-${it.key})`} />
							</>
						)}
						{it.key === 'wedge' && (
							<>
								<path class="mch__load" d="M16 76 V40 H52 L60 76 Z M104 76 V40 H68 L60 76 Z" />
								<path class="mch__fill" d="M44 16 H76 L60 74 Z" />
								<line class="arrow arrow--red" x1="60" y1="0" x2="60" y2="13" marker-end={`url(#mch-${uid}-${it.key})`} />
							</>
						)}
						{it.key === 'screw' && (
							<>
								<rect class="mch__fill" x="52" y="20" width="16" height="50" />
								<path class="mch__body" d="M52 28 L68 34 M52 38 L68 44 M52 48 L68 54 M52 58 L68 64" />
								<rect class="mch__load" x="36" y="8" width="48" height="12" rx="2" />
								<path class="mch__body" d="M30 72 H90" />
								<path class="arrow arrow--red" d="M92 20 q10 -6 0 -12" marker-end={`url(#mch-${uid}-${it.key})`} />
							</>
						)}
					</svg>
					<p class="mch__name">{it.name}</p>
					<p class="mch__ex">{it.ex}</p>
				</div>
			))
		}
	</div>
</figure>

<style is:global>
	.mch__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.mch__name {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.mch__ex {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.mch__body {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mch__fill {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.mch__rope {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.8;
	}
	.mch__load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	@container (max-width: 34rem) {
		.mch__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
