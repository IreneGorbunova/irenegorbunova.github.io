---
/**
 * Picture «Простые механизмы»: six small schemes, each a short loop of the mechanism at work (about 4,5 с, slowed
 * down; the tiles start a little apart). The load is a dark box everywhere, the force applied by a person a red
 * arrow, the force with which the mechanism acts on the load a blue one. Not to scale.
 * The people are the person of personHome.ts (../davlenie-v-zhidkosti/), whole, in the pose of the work; each tile
 * draws its person at its own size (64…70 px for 1,7 м, 46 px on the ramp), hands on what they hold.
 *   Рычаг — the arms are 13 и 46 px; the man leans on the long end and presses it down by 15 px (the bar turns from
 *     −6° to +10°), the load rises by 5 px.
 *   Блок — a fixed pulley on its holder under the beam; the man pulls the rope down by 14 px, the load rises 14 px,
 *     the wheel turns by the same length of its rim.
 *   Ворот — a well windlass seen from the front: the axle runs through holes in both posts, the crank is outside the
 *     right post; the man turns the handle, which goes round a circle seen nearly edge-on (the dashed ellipse); the
 *     red arrow is at the handle along its motion. One turn of the crank (radius 12 px) winds 2π · 5 px of rope on
 *     the drum (radius 5 px): the bucket rises by 31 px.
 *   Наклонная плоскость — a man walks up a ramp of 22° and pushes a box before him (steps of 12 px along the ramp).
 *   Клин — the man drives a wedge (half-angle 15,5°) into a log with three blows of a sledgehammer; the halves part
 *     by 2 · depth · tg 15,5°, turning about the bottom of the crack and resting on their outer edges (blue arrows:
 *     the wedge pushes them apart).
 *   Винт — a screw jack: the bar turns the screw two times, the screw rises by its pitch (4 px) each turn. The thread
 *     lines stay still on the screen: a screw that turns in a fixed nut slides along its own thread; the turning shows
 *     on the bar and on the arrow around the screw.
 */
import G7Styles from '../g7/G7Styles.astro';

const items = [
	{ key: 'lever', name: 'Рычаг', ex: 'лом, ножницы, весы' },
	{ key: 'pulley', name: 'Блок', ex: 'подъёмный кран, флагшток' },
	{ key: 'windlass', name: 'Ворот', ex: 'колодец, руль, отвёртка' },
	{ key: 'plane', name: 'Наклонная плоскость', ex: 'пандус, горная дорога' },
	{ key: 'wedge', name: 'Клин', ex: 'топор, нож, игла' },
	{ key: 'screw', name: 'Винт', ex: 'болт, домкрат, тиски' },
];
const labels: Record<string, string> = {
	lever: 'Рычаг: человек нажимает на длинный конец доски, и груз на коротком конце поднимается',
	pulley: 'Блок: человек тянет верёвку вниз, и груз поднимается',
	windlass: 'Ворот: человек вращает рукоятку, верёвка наматывается на вал, и ведро поднимается из колодца',
	plane: 'Наклонная плоскость: человек толкает ящик вверх по пандусу',
	wedge: 'Клин: человек бьёт кувалдой по клину, и клин раскалывает полено',
	screw: 'Винт: рукоятку вращают, и винт домкрата поднимает груз',
};
---

<G7Styles />
<figure class="g7 g7--pic mch not-content" data-mechpic>
	<div class="mch__grid">
		{
			items.map((it) => (
				<div>
					<svg class="g7__svg" viewBox="0 0 120 90" role="img" aria-label={`${labels[it.key]}. Примеры: ${it.ex}`} data-t={it.key}>
						<g data-draw />
						<g data-man />
						<g data-front />
					</svg>
					<p class="mch__name">{it.name}</p>
					<p class="mch__ex">{it.ex}</p>
				</div>
			))
		}
	</div>
</figure>

<style is:global>
	.mch__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.mch__name {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.mch__ex {
		margin: 0.1rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.mch__ground {
		stroke: var(--g7-ink);
		stroke-width: 1.6;
	}
	.mch__body {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mch__thin {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linecap: round;
	}
	.mch__dash {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	.mch__fill {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mch__steel {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.mch__stone {
		fill: var(--sl-color-gray-5);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.mch__hole {
		fill: var(--g7-paper);
	}
	.mch__rope {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
	}
	.mch__load {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.mch__skin {
		fill: var(--g7-skin);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.mch__grip {
		stroke: var(--g7-wood-dark);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.mch__shaft--red {
		stroke: var(--g7-red);
		stroke-width: 2;
		stroke-linecap: round;
		fill: none;
	}
	.mch__shaft--blue {
		stroke: var(--g7-blue);
		stroke-width: 2;
		stroke-linecap: round;
		fill: none;
	}
	[data-mechpic] {
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
		--mch-shirt: hsl(150, 38%, 42%);
	}
	:root[data-theme='light'] [data-mechpic] {
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
		--mch-shirt: hsl(150, 40%, 38%);
	}
	[data-mechpic] .ph-far {
		filter: brightness(0.8);
	}
	[data-mechpic] .ph-outline {
		fill: none;
		stroke: var(--ph-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-mechpic] .ph-pants,
	[data-mechpic] .ph-sleeve,
	[data-mechpic] .ph-skin-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-mechpic] .ph-pants {
		stroke: var(--ph-pants);
	}
	[data-mechpic] .ph-skin-limb {
		stroke: var(--ph-skin);
	}
	[data-mechpic] .ph-sleeve.mch-shirt {
		stroke: var(--mch-shirt);
	}
	[data-mechpic] .ph-shirt.mch-shirt {
		fill: var(--mch-shirt);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-mechpic] .ph-belt {
		fill: var(--ph-line);
	}
	[data-mechpic] .ph-collar {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-mechpic] .ph-skin {
		fill: var(--ph-skin);
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-mechpic] .ph-ear {
		stroke-width: 0.3;
	}
	[data-mechpic] .ph-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-mechpic] .ph-eye {
		fill: var(--ph-line);
	}
	[data-mechpic] .ph-brow,
	[data-mechpic] .ph-mouth {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
		stroke-linecap: round;
	}
	[data-mechpic] .ph-hair {
		fill: var(--ph-hair);
	}
	[data-mechpic] .ph-shoe {
		fill: var(--ph-shoe);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-mechpic] .ph-sole {
		fill: var(--ph-line);
	}
	@container (max-width: 34rem) {
		.mch__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

<script>
	import { el, ease, loop } from '../g7/kit';
	import { person, type Pose } from '../davlenie-v-zhidkosti/personHome';

	const f = (v: number) => v.toFixed(2);
	const D = Math.PI / 180;
	const CYCLE = 4.6; // s
	/** Phase of a loop: 0 → 1 while acting (from a to b), 1 while holding, then back to 0 (from c to d). */
	const phase = (t: number, a: number, b: number, c: number, d: number) => (t < a ? 0 : t < b ? ease((t - a) / (b - a)) : t < c ? 1 : t < d ? 1 - ease((t - c) / (d - c)) : 0);
	/** An arrow: a round shaft and a filled head, from (x1, y1) to (x2, y2). */
	const arrow = (x1: number, y1: number, x2: number, y2: number, color: 'red' | 'blue' = 'red') => {
		const g = el('g', {});
		const L = Math.hypot(x2 - x1, y2 - y1) || 1;
		const ux = (x2 - x1) / L;
		const uy = (y2 - y1) / L;
		const hl = Math.min(5.5, L * 0.6);
		const bx = x2 - ux * hl;
		const by = y2 - uy * hl;
		g.append(
			el('line', { class: `mch__shaft--${color}`, x1: f(x1), y1: f(y1), x2: f(bx), y2: f(by) }),
			el('path', { class: `head--${color}`, d: `M${f(x2)} ${f(y2)} L${f(bx - uy * 3.2)} ${f(by + ux * 3.2)} L${f(bx + uy * 3.2)} ${f(by - ux * 3.2)} Z` }),
		);
		return g;
	};
	const hatch = (x0: number, x1: number, y: number) => {
		let d = '';
		for (let x = x0 + 2; x < x1; x += 6) d += `M${x} ${y} l4 -4 `;
		return el('path', { class: 'mch__thin', d });
	};
	const spokes = (cx: number, cy: number, r: number, a: number) => {
		let d = '';
		for (let i = 0; i < 3; i++) d += `M${cx} ${cy} L${f(cx + r * Math.cos(a + (i * 2 * Math.PI) / 3))} ${f(cy + r * Math.sin(a + (i * 2 * Math.PI) / 3))} `;
		return el('path', { class: 'mch__thin', d });
	};

	type Pt = { x: number; y: number };
	/** Poses a tile's person; the pose is given in the tile's coordinates whichever way the person faces. */
	type Man = (p: Pose, opacity?: number) => void;
	type Draw = (g: SVGGElement, t: number, man: Man, fg: SVGGElement) => void;
	// each tile's person: height in px for 1,7 м, and whether it faces left (then its group is mirrored)
	const MEN: Record<string, { H: number; left: boolean }> = {
		lever: { H: 64, left: true },
		pulley: { H: 64, left: true },
		windlass: { H: 70, left: true },
		plane: { H: 46, left: false },
		wedge: { H: 66, left: true },
	};
	const flat = (H: number, x: number, ground: number): Pt => ({ x, y: ground - (H / 170) * 7.5 });

	const draws: Record<string, Draw> = {
		lever: (g, t, man, fg) => {
			const u = phase(t, 0.5, 2.3, 3.3, 4.3);
			const a = (-6 + 16 * u) * D; // the long end goes down
			const P = { x: 30, y: 48 };
			const bar = el('g', { transform: `rotate(${f(a / D)} ${P.x} ${P.y})` });
			bar.append(el('rect', { class: 'mch__fill', x: 8, y: 48, width: 70, height: 4, rx: 1 }), el('rect', { class: 'mch__load', x: 10, y: 36, width: 14, height: 12, rx: 1 }));
			const end = { x: P.x + 46 * Math.cos(a), y: P.y + 46 * Math.sin(a) };
			g.append(el('line', { class: 'mch__ground', x1: 4, x2: 116, y1: 80, y2: 80 }), el('path', { class: 'mch__steel', d: `M${P.x} ${P.y + 2} L${P.x + 9} 80 L${P.x - 9} 80 Z` }), bar);
			man({
				hip: { x: 92, y: 48 + 3 * u },
				lean: 0.3 + 0.25 * u,
				ankles: [flat(64, 87, 80), flat(64, 98, 80)],
				feet: [0, 0],
				hands: [
					{ x: end.x + 1, y: end.y - 3.5 },
					{ x: end.x + 4, y: end.y - 3.5 },
				],
				head: 0.25,
			});
			if (t < 3.3) fg.append(arrow(end.x - 7, end.y - 24, end.x - 7, end.y - 6));
		},
		pulley: (g, t, man, fg) => {
			const d = 14 * phase(t, 0.6, 2.4, 3.4, 4.4);
			const C = { x: 50, y: 22 };
			const r = 11;
			g.append(
				el('line', { class: 'mch__ground', x1: 4, x2: 116, y1: 84, y2: 84 }),
				el('rect', { class: 'mch__steel', x: 20, y: 4, width: 60, height: 5 }),
				el('rect', { class: 'mch__steel', x: C.x - 2.2, y: 9, width: 4.4, height: C.y - 9 }),
				el('path', { class: 'mch__rope', d: `M${C.x - r} ${f(68 - d)} V${C.y} A${r} ${r} 0 0 1 ${C.x + r} ${C.y} V82` }),
				el('ellipse', { class: 'mch__rope', cx: C.x + r + 3, cy: 82.5, rx: 6, ry: 1.6 }),
				el('circle', { class: 'mch__fill', cx: C.x, cy: C.y, r }),
				spokes(C.x, C.y, r - 2, d / r),
				el('circle', { class: 'head--ink', cx: C.x, cy: C.y, r: 1.8 }),
				el('rect', { class: 'mch__load', x: C.x - r - 8, y: f(68 - d), width: 16, height: 16, rx: 1 }),
			);
			man({
				hip: { x: 77, y: 53 },
				lean: 0.1 + 0.25 * (d / 14),
				ankles: [flat(64, 72, 84), flat(64, 83, 84)],
				feet: [0, 0],
				hands: [
					{ x: C.x + r + 0.5, y: 34 + d },
					{ x: C.x + r + 0.5, y: 40 + d },
				],
				head: -0.2,
			});
			if (t < 3.4) fg.append(arrow(C.x + r - 7, 40 + d, C.x + r - 7, 58 + d));
		},
		windlass: (g, t, man, fg) => {
			const u = phase(t, 0.4, 3.2, 3.6, 4.5);
			const phi = 2 * Math.PI * u; // one turn
			const RC = 12; // crank
			const AX = 70;
			const AY = 30;
			const pin = { x: AX + 0.42 * RC * Math.sin(phi), y: AY - RC * Math.cos(phi) };
			const yb = 84 - 5 * phi; // the bucket's bottom
			g.append(
				el('line', { class: 'mch__ground', x1: 2, x2: 118, y1: 82, y2: 82 }),
				el('rect', { class: 'mch__fill', x: 6, y: 20, width: 6, height: 62 }),
				el('rect', { class: 'mch__fill', x: 58, y: 20, width: 6, height: 62 }),
				el('rect', { class: 'mch__fill', x: 15, y: 25, width: 40, height: 10, rx: 3 }),
			);
			// rope turns on the drum: more of them as the rope is wound
			let coils = '';
			const n = 3 + Math.round(5 * u);
			for (let i = 0; i < n; i++) coils += `M${f(34.4 - (n - 1 - i) * 2.2)} 25.5 l1.6 9 `;
			g.append(el('path', { class: 'mch__rope', d: coils }), el('path', { class: 'mch__rope', d: `M36 35 V${f(yb - 16)}` }));
			// the bucket, and the stone rim of the well in front of it
			g.append(
				el('path', { class: 'mch__thin', d: `M29 ${f(yb - 12)} Q36 ${f(yb - 20)} 43 ${f(yb - 12)}` }),
				el('path', { class: 'mch__load', d: `M28 ${f(yb - 12)} H44 L42 ${f(yb)} H30 Z` }),
				el('rect', { class: 'mch__stone', x: 15, y: 70, width: 42, height: 12, rx: 1 }),
				el('path', { class: 'mch__thin', d: 'M27 70 V76 M38 76 V82 M48 70 V76 M15 76 H57' }),
			);
			// the axle through the holes of the posts, the crank outside the right post
			g.append(
				el('line', { class: 'mch__body', x1: 3, x2: AX, y1: AY, y2: AY }),
				el('ellipse', { class: 'mch__dash', cx: AX + 4.5, cy: AY, rx: 0.42 * RC, ry: RC }),
				el('line', { class: 'mch__body', x1: AX, y1: AY, x2: f(pin.x), y2: f(pin.y) }),
				el('line', { class: 'mch__grip', x1: f(pin.x), y1: f(pin.y), x2: f(pin.x + 8), y2: f(pin.y) }),
			);
			man({
				hip: { x: 92, y: 47 },
				lean: 0.15 + 0.08 * Math.sin(phi),
				ankles: [flat(70, 87, 82), flat(70, 98, 82)],
				feet: [0, 0],
				hands: [
					{ x: pin.x + 5.5, y: pin.y },
					{ x: pin.x + 2.5, y: pin.y },
				],
				head: 0.1,
			});
			if (t < 3.2) {
				const vx = 0.42 * RC * Math.cos(phi);
				const vy = RC * Math.sin(phi);
				const L = Math.hypot(vx, vy);
				const s0 = { x: pin.x + 4.5, y: pin.y };
				fg.append(arrow(s0.x + (vx / L) * 4, s0.y + (vy / L) * 4, s0.x + (vx / L) * 16, s0.y + (vy / L) * 16));
			}
		},
		plane: (g, t, man, fg) => {
			const ang = Math.atan2(42, 104);
			const ca = Math.cos(ang);
			const sa = Math.sin(ang);
			const at = (w: number): Pt => ({ x: 8 + ca * w, y: 80 - sa * w });
			const u = 34 + 58 * phase(t, 0.5, 3.0, 3.8, 4.5);
			const op = Math.min(1, t < 3.8 ? 1 : t < 4.1 ? 1 - (t - 3.8) / 0.3 : (t - 4.1) / 0.4);
			const b = at(u);
			// the box, its rear-bottom corner at b; a point (lx, ly) of the box in the tile
			const bp = (lx: number, ly: number): Pt => ({ x: b.x + lx * ca + ly * sa, y: b.y - lx * sa + ly * ca });
			const box = el('g', { transform: `translate(${f(b.x)} ${f(b.y)}) rotate(${f(-ang / D)})`, opacity: f(op) });
			box.append(el('rect', { class: 'mch__load', x: 0, y: -18, width: 18, height: 18, rx: 1 }));
			g.append(el('line', { class: 'mch__ground', x1: 4, x2: 116, y1: 80, y2: 80 }), el('path', { class: 'mch__fill', d: 'M8 80 H112 V38 Z' }), box);
			// walking: each foot stands while the hip passes over it, then swings 12 px forward
			const uh = u - 13;
			const S = 6;
			const foot = (k: number) => {
				const q = (uh - k * S) / (2 * S);
				const n = Math.floor(q);
				const fr = q - n;
				const P0 = k * S + n * 2 * S + S / 2;
				const w = fr < 0.5 ? P0 : P0 + 2 * S * ease((fr - 0.5) / 0.5);
				const lift = fr < 0.5 ? 0 : 2.2 * Math.sin(Math.PI * ((fr - 0.5) / 0.5));
				const p = at(w);
				return { x: p.x, y: p.y - 2 - lift };
			};
			const hip = at(uh);
			man(
				{
					hip: { x: hip.x, y: hip.y - 19 },
					lean: 0.75,
					ankles: [foot(0), foot(1)],
					feet: [-ang, -ang],
					hands: [bp(-0.5, -10), bp(-0.5, -13)],
					head: -0.3,
				},
				op,
			);
			if (t < 3.0) {
				const a0 = bp(21, -9);
				const a1 = bp(37, -9);
				fg.append(arrow(a0.x, a0.y, a1.x, a1.y));
			}
		},
		wedge: (g, t, man, fg) => {
			const TAPS = [0.6, 1.4, 2.2];
			let depth = 4;
			let hit = false;
			let lift = 0;
			for (const tp of TAPS) {
				if (t >= tp) depth += 5 * ease(Math.min(1, (t - tp) / 0.12));
				if (t >= tp && t < tp + 0.35) hit = true;
				// the hammer: up between blows, down at each blow
				const dt = t - (tp - 0.6);
				if (dt >= 0 && dt < 0.8) lift = Math.max(lift, dt < 0.45 ? ease(dt / 0.45) : dt < 0.6 ? 1 - (dt - 0.45) / 0.15 : 0);
			}
			const reset = t > 3.9;
			const op = Math.min(1, reset ? Math.max(0, 1 - (t - 3.9) / 0.3) + Math.max(0, (t - 4.2) / 0.4) : 1);
			if (t > 4.2) depth = 4;
			const X = 50; // the crack
			const top = 52; // the log's top
			const tipY = top + depth;
			const WH = 22; // the wedge's height
			const halfW = WH * Math.tan(15.5 * D); // half the width of its top
			const wtop = tipY - WH;
			const gap = 2 * depth * Math.tan(15.5 * D);
			const al = Math.asin(Math.min(0.3, gap / 2 / 28));
			// each half turns about the bottom of the crack and rests on its outer edge
			const lift0 = 38 * Math.sin(al);
			const scene = el('g', { opacity: f(op) });
			const half = (sgn: number) =>
				el('path', { class: 'mch__fill', d: sgn < 0 ? `M12 ${top} H${X} V80 H12 Z` : `M${X} ${top} H88 V80 H${X} Z`, transform: `translate(0 ${f(-lift0)}) rotate(${f((sgn * al) / D)} ${X} 80)` });
			const rings = el('path', { class: 'mch__thin', d: `M20 ${top + 8} H40 M60 ${top + 8} H80 M18 ${top + 18} H42 M58 ${top + 18} H82`, opacity: 0.5 });
			const wedge = el('path', { class: 'mch__steel', d: `M${f(X - halfW)} ${f(wtop)} H${f(X + halfW)} L${X} ${tipY} Z` });
			// the sledgehammer swings about the hands: at a blow its head lies on the wedge
			const hands = { x: X + 24, y: wtop - 2 };
			const ang = Math.atan2(-6, -24) + 55 * D * lift;
			const LH = Math.hypot(24, 6);
			const ux = Math.cos(ang);
			const uy = Math.sin(ang);
			const head = { x: hands.x + LH * ux, y: hands.y + LH * uy };
			const hammer = el('g', {});
			hammer.append(
				el('line', { class: 'mch__grip', x1: f(hands.x - 3 * ux), y1: f(hands.y - 3 * uy), x2: f(head.x), y2: f(head.y) }),
				el('rect', { class: 'mch__load', x: -4, y: -8, width: 8, height: 16, rx: 1, transform: `translate(${f(head.x)} ${f(head.y)}) rotate(${f(ang / D)})` }),
			);
			scene.append(half(-1), half(1), rings, wedge, hammer);
			g.append(el('line', { class: 'mch__ground', x1: 4, x2: 116, y1: 80, y2: 80 }), scene);
			man(
				{
					hip: { x: 93, y: 49 + 2 * (1 - lift) },
					lean: 0.35 - 0.15 * lift,
					ankles: [flat(66, 87, 80), flat(66, 99, 80)],
					feet: [0, 0],
					hands: [hands, { x: hands.x - 3 * ux, y: hands.y - 3 * uy }],
					head: 0.3,
				},
				op,
			);
			if (hit) fg.append(arrow(X - 12, tipY - 10, X - 28, tipY - 10, 'blue'), arrow(X + 12, tipY - 10, X + 28, tipY - 10, 'blue'));
		},
		screw: (g, t) => {
			const u = phase(t, 0.4, 3.0, 3.6, 4.5);
			const phi = 4 * Math.PI * u; // two turns
			const rise = (4 * phi) / (2 * Math.PI);
			const yT = 36 - rise; // the screw's top
			const cx = 60;
			// the thread lines: still on the screen, only where the screw is
			let thr = '';
			for (let y = 58; y > yT + 8; y -= 4) thr += `M${cx - 6} ${y + 1.5} L${cx + 6} ${y - 1.5} `;
			const bar = 26 * Math.cos(phi);
			const front = Math.sin(phi) >= 0;
			const knob = el('circle', { class: 'mch__steel', cx: f(cx + bar), cy: f(yT + 4), r: front ? 2.8 : 2.2 });
			g.append(
				el('line', { class: 'mch__ground', x1: 4, x2: 116, y1: 82, y2: 82 }),
				el('rect', { class: 'mch__steel', x: cx - 6, y: f(yT + 4), width: 12, height: f(58 - yT) }),
				el('path', { class: 'mch__thin', d: thr }),
				el('path', { class: 'mch__load', d: 'M42 82 L48 58 H72 L78 82 Z' }),
				el('rect', { class: 'mch__steel', x: cx - 9, y: f(yT), width: 18, height: 8, rx: 1.5 }),
				el('rect', { class: 'mch__steel', x: 36, y: f(yT - 4), width: 48, height: 4, rx: 1 }),
				el('rect', { class: 'mch__load', x: 44, y: f(yT - 18), width: 32, height: 14, rx: 1 }),
			);
			if (!front) g.append(knob);
			g.append(el('line', { class: 'mch__body', x1: f(cx - bar), y1: f(yT + 4), x2: f(cx + bar), y2: f(yT + 4) }));
			if (front) g.append(knob);
			// the turning: an arrow round the screw, in front of it
			if (t > 0.4 && t < 3.0) {
				// the ellipse round the collar: from its left end, under (in front of) the screw, to the angle th
				const rx = 30;
				const ry = 6;
				const cy = yT + 4;
				const th = 0.6;
				const ex = cx + rx * Math.cos(th);
				const ey = cy + ry * Math.sin(th);
				const vx = rx * Math.sin(th);
				const vy = -ry * Math.cos(th);
				const vl = Math.hypot(vx, vy);
				const [ux, uy] = [vx / vl, vy / vl];
				g.append(
					el('path', { class: 'mch__shaft--red', d: `M${cx - rx} ${f(cy)} A${rx} ${ry} 0 0 0 ${f(ex)} ${f(ey)}` }),
					el('path', { class: 'head--red', d: `M${f(ex + ux * 6)} ${f(ey + uy * 6)} L${f(ex - uy * 3.4)} ${f(ey + ux * 3.4)} L${f(ex + uy * 3.4)} ${f(ey - ux * 3.4)} Z` }),
				);
			}
		},
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-mechpic]')) {
		const tiles = [...root.querySelectorAll<SVGSVGElement>('svg[data-t]')].map((svg, i) => {
			const key = svg.dataset.t!;
			const mg = svg.querySelector<SVGGElement>('[data-man]')!;
			const spec = MEN[key];
			let man: Man = () => {};
			if (spec) {
				if (spec.left) mg.setAttribute('transform', 'matrix(-1 0 0 1 120 0)');
				const pose = person(mg, { s: spec.H / 170, H: 170, girth: 1, shirt: 'mch-shirt' });
				const m = (p: Pt) => (spec.left ? { x: 120 - p.x, y: p.y } : p);
				man = (p, opacity = 1) => {
					pose({ ...p, hip: m(p.hip), ankles: [m(p.ankles[0]), m(p.ankles[1])], hands: [m(p.hands[0]), m(p.hands[1])] });
					mg.setAttribute('opacity', f(opacity));
				};
			}
			return { g: svg.querySelector<SVGGElement>('[data-draw]')!, fg: svg.querySelector<SVGGElement>('[data-front]')!, draw: draws[key], man, lag: i * 0.35 };
		});
		let t = 0;
		const frame = () => {
			for (const tile of tiles) {
				tile.g.replaceChildren();
				tile.fg.replaceChildren();
				tile.draw(tile.g, (((t - tile.lag) % CYCLE) + CYCLE) % CYCLE, tile.man, tile.fg);
			}
		};
		frame();
		loop(root, (dt) => {
			t += dt;
			frame();
			return true;
		});
	}
</script>
