---
/**
 * «Плечо силы»: a wrench on a nut, seen from above. A hand pushes the handle with F = 100 Н at the distance r from
 * the axis of the nut (5…28 см); the direction of the force is turned from «along the handle, away from the nut» (0°)
 * through «across the handle» (90°) to «along the handle, toward the nut» (180°), with the slider or by dragging the
 * head of the arrow. The picture draws the line of action of the force (dashed), the perpendicular dropped on it from
 * the axis, with a right-angle mark, and that perpendicular is the arm: l = r·sin α. The moment M = F·l (Н·м) is drawn
 * as a curved arrow round the nut whose sweep is proportional to M (270° for 28 Н·м).
 * The nut is screwed on so tightly that it turns only with a moment of 15 Н·м or more (a car wheel nut needs about
 * 100 Н·м, a bicycle axle nut about 30 Н·м; a small M8 nut is screwed on with about 15–25 Н·м).
 * Colors as in the whole chapter: the applied force (the hand) red. 7 px per centimeter; the arrow of the force has a fixed length (the force does not change).
 * With `simple` only the arm is shown (for the section «Рычаг», where the moment has not been introduced yet).
 */
import G7Styles from '../g7/G7Styles.astro';

interface Props {
	simple?: boolean;
}
const { simple = false } = Astro.props;

const NX = 40;
const NY = 118;
const S = 7; // px per см
const hex = Array.from({ length: 6 }, (_, i) => {
	const a = (Math.PI / 3) * i + Math.PI / 6;
	return `${(NX + 11 * Math.cos(a)).toFixed(1)},${(NY + 11 * Math.sin(a)).toFixed(1)}`;
}).join(' ');
const ticks = [5, 10, 15, 20, 25];
---

<G7Styles />
<figure class="g7 g7--stack arm not-content" data-armlab data-simple={simple ? '1' : '0'}>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 380 236" role="img" aria-label="Гаечный ключ на гайке, вид сверху. Сила приложена к рукоятке; из оси гайки опущен перпендикуляр на линию действия силы — это плечо силы" data-svg>
			<g class="arm__wrench">
				<path class="arm__handle" d={`M${NX + 14} ${NY - 7} L${NX + 30 * S} ${NY - 6} Q${NX + 30 * S + 8} ${NY} ${NX + 30 * S} ${NY + 6} L${NX + 14} ${NY + 7} Z`}></path>
				<circle class="arm__ring" cx={NX} cy={NY} r="19"></circle>
				<polygon class="arm__nut" points={hex}></polygon>
				<circle class="arm__bolt" cx={NX} cy={NY} r="5.5"></circle>
				{ticks.map((t) => (
					<>
						<line class="arm__tick" x1={NX + t * S} x2={NX + t * S} y1={NY - 6} y2={NY + 6} />
						<text class="arm__tn" x={NX + t * S} y={NY + 18} text-anchor="middle">{t}</text>
					</>
				))}
				<text class="arm__tn" x={NX + 30 * S - 4} y={NY + 18} text-anchor="end">см</text>
			</g>
			<line class="arm__line" data-line></line>
			<g class="arm__moment" data-mom>
				<path class="arm__marc" data-marc></path>
				<path class="arm__mhead" data-mhead></path>
			</g>
			<path class="arm__right" data-right></path>
			<line class="arm__arm" data-arm></line>
			<circle class="arm__axis" cx={NX} cy={NY} r="2.6"></circle>
			<text class="arm__lt t-halo" data-lt><tspan class="arm__keyl">l</tspan><tspan></tspan></text>
			<circle class="arm__pt" data-pt r="3.2"></circle>
			<path class="arm__f" data-f></path>
			<path class="arm__fh" data-fh></path>
			<circle class="arm__grab drag" data-grab r="16"></circle>
			<text class="arm__ft t-halo" data-ft><tspan class="arm__keyl">F</tspan> = 100&nbsp;Н</text>
		</svg>
		<div class="g7__side arm__side">
			<label class="g7__slider">
				<span>Направление силы: угол с рукояткой</span>
				<output data-oa></output>
				<input type="range" min="0" max="180" step="5" value="60" data-a aria-label="Угол между силой и рукояткой, градусы" />
			</label>
			<label class="g7__slider">
				<span>Сила приложена на расстоянии от оси</span>
				<output data-or></output>
				<input type="range" min="5" max="28" step="1" value="25" data-r aria-label="Расстояние от оси гайки до точки приложения силы, сантиметры" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li class="is-key"><span>Плечо силы <i>l</i></span><b data-ol></b></li>
				<li class="arm__full"><span>Момент силы <i>M</i> = <i>F</i><i>l</i></span><b data-om></b></li>
			</ul>
			<p class="g7__msg" data-msg aria-live="polite"></p>
		</div>
	</div>
	<figcaption class="g7__caption">Штрихи — линия действия силы, зелёный отрезок — плечо <i>l</i>: перпендикуляр из оси гайки на эту линию. Стрелку силы можно поворачивать пальцем или мышью; сила всё время одна и та же — 100&nbsp;Н.</figcaption>
</figure>

<style is:global>
	.arm__side .g7__read {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	[data-armlab][data-simple='1'] .arm__full,
	[data-armlab][data-simple='1'] .arm__moment {
		display: none;
	}
	[data-armlab][data-simple='1'] .arm__side .g7__read {
		grid-template-columns: minmax(0, 1fr);
	}
	.arm__handle {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.arm__ring {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.arm__nut {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.arm__bolt {
		fill: var(--g7-faint);
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.arm__tick {
		stroke: var(--g7-ink);
		stroke-width: 0.8;
	}
	.arm svg .arm__tn {
		font-size: 9.5px;
		fill: var(--sl-color-gray-3);
	}
	.arm__line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
	}
	.arm__arm {
		stroke: var(--g7-green);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.arm__right {
		fill: none;
		stroke: var(--g7-green);
		stroke-width: 1.2;
	}
	.arm__axis {
		fill: var(--g7-ink);
	}
	.arm__pt {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.arm__f {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 3.2;
		stroke-linecap: round;
	}
	.arm__fh {
		fill: var(--g7-red);
	}
	.arm__grab {
		fill: color-mix(in oklab, var(--g7-red) 18%, transparent);
		stroke: var(--g7-red);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.arm__marc {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.arm__mhead {
		fill: var(--g7-gold);
	}
	.arm svg .arm__lt {
		font-size: 13px;
		font-weight: 700;
		fill: var(--g7-green);
	}
	.arm svg .arm__ft {
		font-size: 13px;
		font-weight: 700;
		fill: var(--g7-red);
	}
	.arm svg .arm__keyl {
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 15px;
	}
	@container (max-width: 30rem) {
		.arm__side .g7__read {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	import { fmtTrim, drag } from '../g7/kit';

	const NX = 40;
	const NY = 118;
	const S = 7; // px per см
	const F = 100; // Н
	const FLEN = 66; // px, the arrow of the force
	const NEED = 15; // Н·м, the nut turns from this moment on
	const D = Math.PI / 180;
	const nb = '\u00a0';
	const f = (v: number) => v.toFixed(1);
	for (const root of document.querySelectorAll<HTMLElement>('[data-armlab]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const simple = root.dataset.simple === '1';
		const svg = q<SVGSVGElement>('[data-svg]');
		const ia = q<HTMLInputElement>('[data-a]');
		const ir = q<HTMLInputElement>('[data-r]');
		const draw = () => {
			const a = Number(ia.value) * D;
			const r = Number(ir.value);
			const A = { x: NX + r * S, y: NY };
			const d = { x: Math.cos(a), y: Math.sin(a) };
			const tip = { x: A.x + FLEN * d.x, y: A.y + FLEN * d.y };
			// the force
			q('[data-pt]').setAttribute('cx', f(A.x));
			q('[data-pt]').setAttribute('cy', f(A.y));
			q('[data-f]').setAttribute('d', `M${f(A.x)} ${f(A.y)} L${f(tip.x - 9 * d.x)} ${f(tip.y - 9 * d.y)}`);
			const n = { x: -d.y, y: d.x };
			q('[data-fh]').setAttribute('d', `M${f(tip.x)} ${f(tip.y)} L${f(tip.x - 12 * d.x + 6 * n.x)} ${f(tip.y - 12 * d.y + 6 * n.y)} L${f(tip.x - 12 * d.x - 6 * n.x)} ${f(tip.y - 12 * d.y - 6 * n.y)} Z`);
			const grab = q('[data-grab]');
			grab.setAttribute('cx', f(tip.x));
			grab.setAttribute('cy', f(tip.y));
			const ft = q<SVGTextElement>('[data-ft]');
			if (d.y < 0.5) {
				// the force lies near the handle: its label goes under the arrow, clear of the handle and its numbers
				ft.setAttribute('x', f(Math.min(330, Math.max(56, tip.x - 8 * d.x))));
				ft.setAttribute('y', f(Math.max(tip.y, NY) + 42));
				ft.setAttribute('text-anchor', 'middle');
			} else {
				ft.setAttribute('x', f(tip.x + 20 * d.x));
				ft.setAttribute('y', f(tip.y + 20 * d.y + (d.y > 0.5 ? 9 : 4)));
				ft.setAttribute('text-anchor', d.x > 0.35 ? 'start' : d.x < -0.35 ? 'end' : 'middle');
			}
			// the line of action, across the whole picture
			q('[data-line]').setAttribute('x1', f(A.x - 600 * d.x));
			q('[data-line]').setAttribute('y1', f(A.y - 600 * d.y));
			q('[data-line]').setAttribute('x2', f(A.x + 600 * d.x));
			q('[data-line]').setAttribute('y2', f(A.y + 600 * d.y));
			// the foot of the perpendicular from the axis
			const t = (NX - A.x) * d.x + (NY - A.y) * d.y;
			const P = { x: A.x + t * d.x, y: A.y + t * d.y };
			const lcm = r * Math.sin(a); // см
			const lpx = lcm * S;
			const arm = q('[data-arm]');
			arm.setAttribute('x1', String(NX));
			arm.setAttribute('y1', String(NY));
			arm.setAttribute('x2', f(P.x));
			arm.setAttribute('y2', f(P.y));
			// the right-angle mark at the foot
			const right = q('[data-right]');
			if (lpx > 12) {
				const u = { x: (NX - P.x) / lpx, y: (NY - P.y) / lpx }; // from the foot toward the axis
				const k = 7;
				const sd = t > 0 ? -1 : 1; // the mark lies on the side of the line where the point A is
				const dd = { x: d.x * sd, y: d.y * sd };
				right.setAttribute('d', `M${f(P.x + k * u.x)} ${f(P.y + k * u.y)} L${f(P.x + k * u.x + k * dd.x)} ${f(P.y + k * u.y + k * dd.y)} L${f(P.x + k * dd.x)} ${f(P.y + k * dd.y)}`);
			} else right.setAttribute('d', '');
			const lt = q<SVGTextElement>('[data-lt]');
			const lr = Math.round(lcm * 10) / 10;
			lt.lastChild!.textContent = lpx > 3 ? ` = ${fmtTrim(lr, 1)}${nb}см` : ' = 0';
			// the label beside the middle of the arm, away from the line of action
			const mx = (NX + P.x) / 2;
			const my = (NY + P.y) / 2;
			const off = lpx > 3 ? { x: -(P.y - NY) / lpx, y: (P.x - NX) / lpx } : { x: 0, y: -1 };
			const sgn = off.y > 0 ? -1 : 1; // keep the label above the arm where possible
			const near = lpx < 40; // a short arm: its label stands above and to the right of the nut
			lt.setAttribute('x', f(near ? NX + 34 : mx + 16 * off.x * sgn));
			lt.setAttribute('y', f(near ? NY - 38 : my + 16 * off.y * sgn + 4));
			lt.setAttribute('text-anchor', near ? 'start' : 'middle');
			// the moment
			const M = (F * lcm) / 100;
			const sweep = Math.min(270, (M / 28) * 270) * D;
			const R = 30;
			const a0 = -100 * D; // the arc starts above the nut and goes clockwise
			const a1 = a0 + sweep;
			const p0 = { x: NX + R * Math.cos(a0), y: NY + R * Math.sin(a0) };
			const p1 = { x: NX + R * Math.cos(a1), y: NY + R * Math.sin(a1) };
			const marc = q('[data-marc]');
			const mhead = q('[data-mhead]');
			if (M >= 1.5) { // a shorter arc would be only its arrowhead
				const back = Math.min(sweep, 9 * D);
				const pb = { x: NX + R * Math.cos(a1 - back), y: NY + R * Math.sin(a1 - back) };
				marc.setAttribute('d', `M${f(p0.x)} ${f(p0.y)} A${R} ${R} 0 ${sweep > Math.PI ? 1 : 0} 1 ${f(pb.x)} ${f(pb.y)}`);
				const tg = { x: -Math.sin(a1), y: Math.cos(a1) };
				const nr = { x: Math.cos(a1), y: Math.sin(a1) };
				mhead.setAttribute('d', `M${f(p1.x + 4 * tg.x)} ${f(p1.y + 4 * tg.y)} L${f(p1.x - 8 * tg.x + 6 * nr.x)} ${f(p1.y - 8 * tg.y + 6 * nr.y)} L${f(p1.x - 8 * tg.x - 6 * nr.x)} ${f(p1.y - 8 * tg.y - 6 * nr.y)} Z`);
			} else {
				marc.setAttribute('d', '');
				mhead.setAttribute('d', '');
			}
			// readouts
			q('[data-oa]').textContent = `${ia.value}°`;
			q('[data-or]').textContent = `${r}${nb}см`;
			q('[data-ol]').textContent = `${fmtTrim(lr, 1)}${nb}см`;
			q('[data-om]').textContent = `${fmtTrim(M, 1)}${nb}Н·м`;
			const msg = q<HTMLElement>('[data-msg]');
			const deg = Number(ia.value);
			const ok = M >= NEED - 1e-9;
			msg.classList.toggle('is-right', !simple && ok);
			if (deg === 0 || deg === 180)
				msg.textContent = 'Сила направлена вдоль рукоятки: её линия проходит через ось гайки, плечо равно нулю, и ключ не поворачивается.';
			else if (simple)
				msg.textContent = deg === 90 ? `Сила перпендикулярна рукоятке: плечо равно расстоянию до точки приложения, ${r}${nb}см. Это самое большое плечо.` : `Плечо ${fmtTrim(lr, 1)}${nb}см — меньше, чем расстояние до точки приложения, ${r}${nb}см.`;
			else
				msg.textContent = ok
					? `Гайка поворачивается: момент ${fmtTrim(M, 1)}${nb}Н·м не меньше ${NEED}${nb}Н·м.`
					: `Гайка не поддаётся: момента ${fmtTrim(M, 1)}${nb}Н·м мало, нужно ${NEED}${nb}Н·м.`;
		};
		drag(q('[data-grab]'), svg, {
			move: (p) => {
				const r = Number(ir.value);
				const A = { x: NX + r * S, y: NY };
				let deg = (Math.atan2(p.y - A.y, p.x - A.x) * 180) / Math.PI;
				if (deg < -90) deg = 180;
				else if (deg < 0) deg = 0;
				ia.value = String(Math.round(deg / 5) * 5);
				draw();
			},
		});
		ia.addEventListener('input', draw);
		ir.addEventListener('input', draw);
		draw();
	}
</script>
