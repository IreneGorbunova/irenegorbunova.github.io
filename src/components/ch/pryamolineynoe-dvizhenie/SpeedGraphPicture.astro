---
/**
 * Graphs of the velocity projection υₓ(t) for three straight motions on one set of axes (t 0…6 с, 48 px per second;
 * υₓ −4…14 м/с, 10 px per м/с): speeding up υₓ = 2 + 1,5t (2 → 11 м/с), uniform υₓ = 5, braking υₓ = 12 − 2t
 * (12 → 0 м/с at 6 с). On the first line a step: Δt = 1 с (from 4 to 5 с), Δυₓ = 1,5 м/с (from 8 to 9,5 м/с), its legs in
 * the acceleration color. Each line (or its name) can be tapped: it is highlighted and a note shows its formula and
 * acceleration. The lines differ by dash: solid (speeding up), long dashes (uniform), dots (braking). Static.
 */
import PdStyles from './PdStyles.astro';
const T = (t: number) => 50 + t * 48;
const V = (v: number) => 30 + (14 - v) * 10;
const lines = [
	{ id: 'up', name: 'разгоняется', v0: 2, a: 1.5, lt: 5.5, ly: -10, anchor: 'middle', dx: 0 },
	{ id: 'eq', name: 'равномерно', v0: 5, a: 0, lt: 1.0, ly: -7, anchor: 'middle', dx: 0 },
	{ id: 'dn', name: 'тормозит', v0: 12, a: -2, lt: 0.9, ly: -6, anchor: 'start', dx: 6 },
];
const f = (v: number) => v.toFixed(1);
---

<PdStyles />
<figure class="g7 g7--pic pdm not-content" data-speedpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 230" role="img" aria-label="Графики проекции скорости от времени: у разгоняющегося тела прямая идёт вверх, у равномерно движущегося — горизонтально, у тормозящего — вниз">
			{[0, 1, 2, 3, 4, 5, 6].map((t) => <line class="pdm-grid" x1={T(t)} y1={V(14)} x2={T(t)} y2={V(-4)} />)}
			{[-4, -2, 0, 2, 4, 6, 8, 10, 12, 14].map((v) => (
				<>
					<line class="pdm-grid" x1={T(0)} y1={V(v)} x2={T(6)} y2={V(v)} />
					<text class="t-small t-num" x={T(0) - 5} y={V(v) + 3.5} text-anchor="end">{String(v).replace('-', '−')}</text>
				</>
			))}
			{[1, 2, 3, 4, 5, 6].map((t) => <text class="t-small t-num" x={T(t)} y={V(0) + 14} text-anchor="middle">{t}</text>)}
			<path class="ink" d={`M${T(0)} ${V(0)} H${T(6) + 10}`} />
			<path class="head--ink" d={`M${T(6) + 16} ${V(0)} l-9 -4 v8 Z`} />
			<path class="ink" d={`M${T(0)} ${V(-4)} V${V(14) - 8}`} />
			<path class="head--ink" d={`M${T(0)} ${V(14) - 14} l-4 9 h8 Z`} />
			<text x={T(6) + 14} y={V(0) - 8} text-anchor="end"><tspan class="t-i">t</tspan>, с</text>
			<text x={T(0) + 7} y={V(14) - 6}><tspan class="t-i">υ</tspan><tspan baseline-shift="sub" font-size="9">x</tspan>, м/с</text>
			<!-- the step on the first line -->
			<path class="sp-step" d={`M${T(4)} ${V(8)} H${T(5)} V${V(9.5)}`} />
			<text class="t-small t-red t-halo" x={(T(4) + T(5)) / 2} y={V(8) + 12} text-anchor="middle">Δ<tspan class="t-i">t</tspan> = 1 с</text>
			<text class="t-small t-red t-halo" x={T(5) + 3} y={V(8.75) + 3}>Δ<tspan class="t-i">υ</tspan><tspan baseline-shift="sub" font-size="8">x</tspan> = 1,5 м/с</text>
			{
				lines.map((l) => (
					<g class="sp-line" data-line={l.id} tabindex="0" role="button" aria-label={`Показать формулу: ${l.name}`}>
						<line class="sp-hit" x1={T(0)} y1={V(l.v0)} x2={T(6)} y2={V(l.v0 + 6 * l.a)} />
						<line class={`pdm-curve pdm-curve--v sp-vis sp-${l.id}`} x1={T(0)} y1={V(l.v0)} x2={T(6)} y2={V(l.v0 + 6 * l.a)} />
						<text class="t-blue sp-name t-halo" x={T(l.lt) + l.dx} y={V(l.v0 + l.lt * l.a) + l.ly} text-anchor={l.anchor}>{l.name}</text>
					</g>
				))
			}
		</svg>
		<p class="g7__msg" data-msg>Нажмите на любую прямую — появится её формула.</p>
	</div>
	<figcaption class="g7__caption">Чем круче идёт график скорости, тем больше модуль ускорения; у горизонтального графика ускорение равно нулю.</figcaption>
</figure>

<style is:global>
	[data-speedpic] .sp-step {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-dasharray: 3 2;
	}
	[data-speedpic] .sp-eq {
		stroke-dasharray: 9 5;
		stroke-linecap: butt;
	}
	[data-speedpic] .sp-dn {
		stroke-dasharray: 1 5;
	}
	[data-speedpic] .sp-line {
		cursor: pointer;
		outline: none;
	}
	[data-speedpic] .sp-hit {
		stroke: transparent;
		stroke-width: 16;
	}
	[data-speedpic] .sp-line.is-dim .sp-vis {
		opacity: 0.35;
	}
	[data-speedpic] .sp-line.is-on .sp-vis {
		stroke-width: 4.2;
	}
	[data-speedpic] .sp-line.is-on .sp-name {
		font-weight: 700;
	}
	[data-speedpic] .sp-line:focus-visible .sp-vis {
		stroke-width: 4.2;
	}
</style>

<script>
	import { k } from '../g7/kit';
	const NOTES: Record<string, string> = {
		up: `Разгоняется: ${k('\\upsilon_x = 2 + 1{,}5t')}, ускорение ${k('a_x = 1{,}5\\ \\text{м/с}^2')} — за каждую секунду скорость растёт на 1,5 м/с.`,
		eq: `Равномерно: ${k('\\upsilon_x = 5')} м/с всё время, ускорение ${k('a_x = 0')}.`,
		dn: `Тормозит: ${k('\\upsilon_x = 12 - 2t')}, ускорение ${k('a_x = -2\\ \\text{м/с}^2')} — за каждую секунду скорость падает на 2 м/с и через 6 с становится равной нулю.`,
	};
	for (const fig of document.querySelectorAll<HTMLElement>('[data-speedpic]')) {
		const msg = fig.querySelector<HTMLElement>('[data-msg]')!;
		const all = [...fig.querySelectorAll<SVGGElement>('[data-line]')];
		const pick = (g: SVGGElement) => {
			for (const o of all) {
				o.classList.toggle('is-on', o === g);
				o.classList.toggle('is-dim', o !== g);
			}
			msg.innerHTML = NOTES[g.dataset.line!];
		};
		for (const g of all) {
			g.addEventListener('click', () => pick(g));
			g.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					pick(g);
				}
			});
		}
	}
</script>
