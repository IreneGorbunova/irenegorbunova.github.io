---
/**
 * Styles shared by the pictures and models of «Прямолинейное движение» (grade 9), scoped under `.pdm` (every figure of
 * the chapter has it next to `g7`). Renders nothing. Road, grass, marks, graph grid, areas under graphs (gold above the
 * time axis, violet below), the stopwatch. Arrow colors come from G7Styles (arrow--blue velocity, arrow--red
 * acceleration, arrow--gold displacement).
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';
import { carCss } from '../ravnouskorennoe-dvizhenie/car';
const css = carCss('.pdm');
---

<G7Styles />
<PeopleStyles />
<Fragment set:html={`<style>${css}</style>`} />
<style is:global>
	.pdm .pdm-road {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 80%, var(--ig-vx) 6%);
	}
	.pdm .pdm-lane {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
		stroke-dasharray: 10 8;
	}
	.pdm .pdm-grass {
		fill: color-mix(in oklab, hsl(120, 40%, 45%) 30%, var(--g7-paper));
	}
	.pdm .pdm-grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 0.8;
	}
	.pdm .pdm-proj {
		stroke: var(--g7-gold);
		stroke-width: 5;
		stroke-linecap: butt;
		opacity: 0.85;
	}
	.pdm .pdm-drop {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.pdm .pdm-area {
		fill: color-mix(in srgb, var(--g7-gold) 30%, transparent);
		stroke: var(--g7-gold);
		stroke-width: 1;
	}
	.pdm .pdm-area--neg {
		fill: color-mix(in srgb, var(--g7-violet) 32%, transparent);
		stroke: var(--g7-violet);
	}
	.pdm .pdm-curve {
		fill: none;
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.pdm .pdm-curve--x {
		stroke: var(--g7-green);
	}
	.pdm .pdm-curve--v {
		stroke: var(--g7-blue);
	}
	.pdm .pdm-curve--off {
		stroke: var(--sl-color-gray-4);
		stroke-dasharray: 4 3;
	}
	.pdm .pdm-dot {
		fill: var(--sl-color-white);
		stroke: var(--g7-paper);
		stroke-width: 1.2;
	}
	.pdm .pdm-mark {
		fill: var(--sl-color-gray-2);
	}
	.pdm .pdm-ghost {
		opacity: 0.32;
	}
	.pdm .pdm-flag {
		fill: var(--g7-green);
	}
	.pdm .pdm-flag--end {
		fill: var(--g7-red);
	}
	.pdm .pdm-pole {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.pdm .pdm-watch {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.pdm .pdm-hand {
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.pdm .pdm-ctrl {
		display: grid;
		gap: 0.6rem;
	}
	.pdm .pdm-graphs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.pdm .pdm-graphs p {
		margin: 0 0 0.2rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-1);
	}
	@container (max-width: 34rem) {
		.pdm .pdm-graphs {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.pdm .pdm-check {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pdm .pdm-check input {
		accent-color: var(--sl-color-accent);
		width: 1.05rem;
		height: 1.05rem;
		margin: 0;
	}
</style>
