---
/**
 * The projection of a vector on an axis (static): three panels, each with an axis Ox from 0 to 6 м (27 px per metre)
 * and one displacement (gold) above it, dashed drops from its start and end to the axis and the projection thick on the
 * axis. (1) from x₀ = 1 м to x = 4 м: sₓ = 4 − 1 = +3 м (along the axis); (2) from x₀ = 5 м to x = 2 м:
 * sₓ = 2 − 5 = −3 м (against the axis); (3) a displacement across the axis, its start and end over x = 3 м: sₓ = 0.
 * The label of each displacement is s with a small arrow over it, as in the text.
 */
import PdStyles from './PdStyles.astro';
const X = (v: number) => 18 + v * 27;
const AY = 98; // the axis
const panels = [
	{ a: [1, 58], b: [4, 58], sx: '3 м' },
	{ a: [5, 58], b: [2, 58], sx: '−3 м' },
	{ a: [3, 84], b: [3, 26], sx: '0' },
];
const f = (v: number) => v.toFixed(1);
const head = (x1: number, y1: number, x2: number, y2: number) => {
	const L = Math.hypot(x2 - x1, y2 - y1);
	const ux = (x2 - x1) / L;
	const uy = (y2 - y1) / L;
	const bx = x2 - ux * 9;
	const by = y2 - uy * 9;
	return { shaft: `M${f(x1)} ${f(y1)} L${f(bx)} ${f(by)}`, head: `M${f(x2)} ${f(y2)} L${f(bx - uy * 5)} ${f(by + ux * 5)} L${f(bx + uy * 5)} ${f(by - ux * 5)} Z` };
};
---

<PdStyles />
<style is:global>
	[data-projpic] .sv-bar {
		stroke: var(--g7-gold);
		stroke-width: 1.1;
	}
</style>
<figure class="g7 g7--pic pdm not-content" data-projpic>
	<div class="g7__grid is-three">
		{
			panels.map((p) => {
				const xa = X(p.a[0]);
				const xb = X(p.b[0]);
				const ar = head(xa, p.a[1], xb, p.b[1]);
				return (
					<svg class="g7__svg" viewBox="0 0 200 140" role="img" aria-label={`Вектор перемещения и его проекция на ось x: s_x = ${p.sx}`}>
						<path class="pdm-drop" d={`M${f(xa)} ${p.a[1]} V${AY} M${f(xb)} ${p.b[1]} V${AY}`} />
						<path class="ink" d={`M8 ${AY} H184`} />
						<path class="head--ink" d={`M190 ${AY} l-9 -4 v8 Z`} />
						{[0, 1, 2, 3, 4, 5, 6].map((v) => (
							<>
								<line class="ln" x1={X(v)} y1={AY - 4} x2={X(v)} y2={AY + 4} />
								<text class="t-small t-num" x={X(v)} y={AY + 16} text-anchor="middle">{v}</text>
							</>
						))}
						<text x="186" y={AY - 9} text-anchor="end"><tspan class="t-i">x</tspan>, м</text>
						{xa === xb ? <circle class="head--gold" cx={xa} cy={AY} r="4" /> : <line class="pdm-proj" x1={xa} y1={AY} x2={xb} y2={AY} />}
						<path class={`arrow arrow--gold`} d={ar.shaft} />
						<path class="head--gold" d={ar.head} />
						<circle class="pdm-dot" cx={xa} cy={p.a[1]} r="2.6" />
						<g transform={`translate(${(xa + xb) / 2 + (xa === xb ? 13 : 0)} ${xa === xb ? 58 : p.a[1] - 9})`}>
							<text class="t-gold" x="0" y="0" text-anchor="middle"><tspan class="t-i">s</tspan></text>
							<path class="sv-bar" d="M-3.5 -12.5 H3" />
							<path class="head--gold" d="M5.5 -12.5 l-3.5 -2 v4 Z" />
						</g>
						<text class="t-title" x="100" y="133" text-anchor="middle"><tspan class="t-i">s</tspan><tspan baseline-shift="sub" font-size="9">x</tspan> = {p.sx}</text>
					</svg>
				);
			})
		}
	</div>
	<figcaption class="g7__caption">
		Перемещение показано золотой стрелкой, его проекция на ось — толстым золотым отрезком на оси. Проекция положительна, когда тело смещается по направлению оси, отрицательна — против оси и равна нулю, когда перемещение перпендикулярно оси.
	</figcaption>
</figure>
