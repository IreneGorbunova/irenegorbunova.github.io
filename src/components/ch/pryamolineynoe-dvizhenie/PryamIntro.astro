---
/**
 * Two short looping opening scenes of «Перемещение. Прямолинейное равномерное и равноускоренное движение» (grade 9).
 * No terms of the chapter in the pictures or the visible captions. People: the shared people kit (src/components/people/).
 *
 * Crossing (real time, 7,6 s): a man (178 см) with his hand on the shoulder of a boy (125 см) waits at a level crossing,
 *   0,55 px per centimeter. Behind the lowered barrier an electric train passes to the right at a steady 60 км/ч
 *   (16,7 м/с) along a track drawn farther away, at 9 px per metre (the train is about 6 times farther than the
 *   people). The cars are 21,5 м long over the couplers (an ordinary suburban car), so one car passes a point every
 *   21,5 / 16,7 = 1,29 с. The boy waves to the train with his raised open hand (his hand is about 7 px, so the kit draws it as a mitten
 *   shape: an index finger would not show; a wave reads at this size) and counts the cars aloud («раз», «два», …) each time a gap
 *   between two cars passes his line of sight: the counts come at equal intervals of 1,29 с. The red lamps of the
 *   crossing blink in turn, once a second each. Overhead wire on poles every 50 м; a pantograph on every second car.
 * Sled (real time, 4 s): a girl (a teenager, 160 см, winter clothes, mittens) sits on a round plastic sled (50 см) high on
 *   a straight icy slope of 18°, 34 px per metre along the slope, equal scales on both axes. She holds herself
 *   with flat palms on the snow, takes the handles of the sled (0,6 с) and slides. With friction coefficient 0,1 the
 *   acceleration is g(sin 18° − 0,1·cos 18°) = 2,10 м/с² (rounded to 2,1): from rest she covers 1,05 м in the first
 *   second, 3,15 м in the second and 5,25 м in the third (1 : 3 : 5), 9,45 м in all, and reaches 6,3 м/с (23 км/ч).
 *   Faint snapshots stay where she was 0, 1 and 2 с after the start, with time tags, so the growing gaps show at a
 *   glance. Snow falls slowly (about 1 м/с).
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import KitStyles from '@components/people/PeopleStyles.astro';

// crossing: the far scene (track) and the near one (people)
const RAIL = 148; // top of the rails, px
const GROUND = 234; // where the people stand
// sled: the slope through the start point at 18°
const SL = { x: 30, y: 96, a: (18 * Math.PI) / 180 };
const slopeY = (x: number) => SL.y + (x - SL.x) * Math.tan(SL.a);
const hillTop = `M0 ${slopeY(0).toFixed(1)} L360 ${slopeY(360).toFixed(1)} L360 240 L0 240 Z`; // she starts on the slope itself
const firs = [
	{ x: 214, b: 92, h: 36 },
	{ x: 238, b: 96, h: 28 },
	{ x: 300, b: 98, h: 42 },
	{ x: 330, b: 104, h: 30 },
	{ x: 120, b: 86, h: 24 },
];
const fir = (x: number, b: number, h: number) => {
	let tree = `M${x - 0.05 * h} ${b} h${0.1 * h} v${-0.15 * h} h${-0.1 * h} Z `;
	let snow = '';
	for (let i = 0; i < 3; i++) {
		const top = b - h + i * 0.26 * h;
		const bot = top + 0.46 * h;
		const w = 0.17 * h + 0.09 * h * i;
		tree += `M${x} ${top} L${x + w} ${bot} L${x - w} ${bot} Z `;
		snow += `M${x} ${top} L${x + w * 0.45} ${top + 0.21 * h} Q${x} ${top + 0.15 * h} ${x - w * 0.45} ${top + 0.21 * h} Z `;
	}
	return { tree, snow };
};
const firPaths = firs.map((t) => fir(t.x, t.b, t.h));
---

<KitStyles />
<IntroFrame data-pdintro>
	<div class="intro__card" data-scene="crossing">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Железнодорожный переезд. Мужчина и мальчик стоят у опущенного шлагбаума, мимо проносится электричка. Мальчик машет ей рукой и считает вагоны: раз, два, три, четыре — вагоны проходят мимо через равные промежутки времени">
			<rect class="pd-sky" x="0" y="0" width="360" height="240"></rect>
			<circle class="pd-sun" cx="300" cy="34" r="14"></circle>
			<!-- far: a forest edge and a few houses behind the track -->
			<path class="pd-forest" d="M0 120 Q14 98 28 112 Q40 92 56 108 Q70 94 84 110 L84 120 Z M150 120 Q164 100 178 112 Q194 90 210 110 Q226 96 240 112 Q256 100 270 116 L270 120 Z"></path>
			<path class="pd-house" d="M96 120 V100 L108 90 L120 100 V120 Z M276 120 V96 H310 V120 Z M318 120 V104 L330 95 L342 104 V120 Z"></path>
			<path class="pd-roof" d="M94 101 L108 88 L122 101 Z M274 97 H312 L306 90 H280 Z M316 105 L330 93 L344 105 Z"></path>
			<path class="pd-window" d="M103 106 h4 v5 h-4 Z M111 106 h4 v5 h-4 Z M282 102 h5 v5 h-5 Z M292 102 h5 v5 h-5 Z M302 102 h5 v5 h-5 Z M326 108 h5 v5 h-5 Z"></path>
			<!-- the embankment with ballast and sleepers -->
			<path class="pd-bank" d="M0 160 L0 150 Q180 147 360 150 L360 160 Z"></path>
			<rect class="pd-ballast" x="0" y={RAIL + 1} width="360" height="7"></rect>
			<path class="pd-sleepers" d={Array.from({ length: 46 }, (_, i) => `M${i * 8 + 2} ${RAIL + 2} h4`).join(' ')}></path>
			<line class="pd-rail" x1="0" y1={RAIL} x2="360" y2={RAIL}></line>
			<!-- the overhead wire on poles (50 м apart: 450 px, so one pole in the frame) -->
			<path class="pd-pole" d={`M64 ${RAIL + 2} V78 M64 84 H92`}></path>
			<path class="pd-wire" d="M0 86.5 Q64 84 128 86.5 T360 86.5"></path>
			<g data-train></g>
			<!-- near: the field, the road to the crossing -->
			<path class="pd-field" d={`M0 158 Q180 154 360 158 V240 H0 Z`}></path>
			<path class="pd-road" d="M150 158 L210 158 L300 240 L60 240 Z"></path>
			<path class="pd-road-edge" d="M150 158 L60 240 M210 158 L300 240"></path>
			<path class="pd-road-line" d="M178 162 L176 172 M175 180 L172 194 M171 204 L167 222"></path>
			<path class="pd-grass" d="M10 214 l3 -7 l2 7 M20 226 l2 -6 l3 6 M318 210 l3 -7 l2 7 M336 228 l2 -6 l3 6 M346 196 l2 -5 l2 5 M30 190 l2 -5 l2 5"></path>
			<!-- the crossing signal: a white cross and two red lamps -->
			<g transform="translate(324 0)">
				<rect class="pd-post" x="-1.6" y="150" width="3.2" height="62"></rect>
				<path class="pd-cross-edge" d="M-11 140 L11 156 M11 140 L-11 156"></path>
				<path class="pd-cross" d="M-11 140 L11 156 M11 140 L-11 156"></path>
				<rect class="pd-lampbox" x="-12" y="160" width="24" height="10" rx="5"></rect>
				<circle class="pd-lamp" data-lamp="0" cx="-6" cy="165" r="3.4"></circle>
				<circle class="pd-lamp" data-lamp="1" cx="6" cy="165" r="3.4"></circle>
			</g>
			<!-- the barrier, lowered -->
			<rect class="pd-post" x="20" y="174" width="5" height="44"></rect>
			<rect class="pd-cabinet" x="15" y="198" width="15" height="20" rx="1.5"></rect>
			<rect class="pd-arm" x="22" y="176" width="300" height="5" rx="2.5"></rect>
			<path class="pd-arm-stripe" d={Array.from({ length: 10 }, (_, i) => `M${40 + i * 30} 176 h14 v5 h-14 Z`).join(' ')}></path>
			<circle class="pd-arm-lamp" data-armlamp cx="300" cy="178.5" r="2"></circle>
			<g data-boy></g>
			<g data-man></g>
			<g class="pd-bubble" data-bubble opacity="0">
				<path class="pd-bubble-box" d="M0 0 h46 a6 6 0 0 1 6 6 v12 a6 6 0 0 1 -6 6 h-30 l-8 7 l1 -7 h-9 a6 6 0 0 1 -6 -6 v-12 a6 6 0 0 1 6 -6 Z"></path>
				<text class="pd-bubble-text" x="23" y="16.5" text-anchor="middle" data-count></text>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				Мальчик считает вагоны электрички, и{' '}
				<More term="каждый вагон проносится мимо за одно и то же время">
					Вагон электрички длиной 21,5&nbsp;м проходит мимо переезда за 1,3&nbsp;с, следующий — тоже за 1,3&nbsp;с. Электричка едет со скоростью 60&nbsp;км/ч и за каждую секунду проходит одно и то же расстояние, 16,7&nbsp;м. Такое движение называют прямолинейным равномерным. Об этом — в разделе{' '}
					<a href="#прямолинейное-равномерное-движение">«Прямолинейное равномерное движение»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="sled">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Снежная горка. Девочка садится на ледянку, берётся за ручки и съезжает вниз. Бледные снимки показывают, где она была через одну, две и три секунды: с каждой секундой расстояние между снимками всё больше">
			<rect class="pd-winter-sky" x="0" y="0" width="360" height="240"></rect>
			<path class="pd-far-hill" d="M0 112 Q60 74 130 92 Q200 64 270 86 Q320 70 360 84 V240 H0 Z"></path>
			<path class="pd-house2" d="M150 92 V76 L162 66 L174 76 V92 Z"></path>
			<path class="pd-roof2" d="M148 77 L162 64 L176 77 Z"></path>
			<path class="pd-lit" d="M157 80 h4 v5 h-4 Z M165 80 h4 v5 h-4 Z"></path>
			<path class="pd-fir" d={firPaths.map((p) => p.tree).join(' ')}></path>
			<path class="pd-fir-snow" d={firPaths.map((p) => p.snow).join(' ')}></path>
			<path class="pd-hill" d={hillTop}></path>
			<path class="pd-track" data-track d=""></path>
			<g data-ghosts></g>
			<g data-rider>
				<g data-sled-back></g>
				<g data-girl></g>
				<g data-sled-front></g>
			</g>
			<g data-tags></g>
			<g data-flakes></g>
		</svg>
		<div class="intro__foot">
			<p>
				Девочка съезжает с ледяной горки, и за каждую следующую секунду она{' '}
				<More term="проезжает больше, чем за предыдущую">
					Бледные снимки сделаны через каждую секунду. За первую секунду девочка проехала 1,05&nbsp;м, за вторую — 3,15&nbsp;м, за третью — 5,25&nbsp;м: расстояния относятся как 1&nbsp;:&nbsp;3&nbsp;:&nbsp;5. Её скорость за каждую секунду растёт на одно и то же значение, 2,1&nbsp;м/с. Такое движение называют прямолинейным равноускоренным. Об этом — в разделе{' '}
					<a href="#ускорение">«Ускорение»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

