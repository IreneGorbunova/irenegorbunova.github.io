<script>
	import { loop, scene } from '@components/intro/scene';
	import { el } from '../g7/kit';
	import { figure } from '@components/people/body';
	import { ease } from '@components/people/motion';
	import type { Pt } from '@components/people/core';

	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-pdintro]')) {
		// ---------------------------------------------------------------- the crossing
		{
			const card = root.querySelector<HTMLElement>('[data-scene="crossing"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const RAIL = 148;
			const GROUND = 234;
			const K = 9; // px per metre on the track
			const V = 60 / 3.6; // м/с
			const PITCH = 21.5 * K; // one car over the couplers, px
			const BODY = PITCH - 7; // the body, px (the gap of 7 px ≈ 0,8 м holds the couplers)
			const NCARS = 7;
			const RUN = 7.6;
			const X_SEE = 246; // the point of the track the boy looks at, px
			const FRONT0 = -12; // the front of the train at t = 0, px
			// car heights, metres above the rails
			const yOf = (m: number) => RAIL - m * K;
			const floor = yOf(1.25);
			const roof = yOf(4.3);

			// the train: cars from the front (car 0, with the cab, on the right) backward
			const train = $<SVGGElement>('[data-train]');
			for (let i = 0; i < NCARS; i++) {
				const g = el('g', { 'data-car': i });
				const x0 = -(i + 1) * PITCH + 3.5; // body from x0 to x0 + BODY (the train's front at x = 0)
				const x1 = x0 + BODY;
				const cab = i === 0;
				// bogies and wheels
				for (const bx of [x0 + 28, x1 - 28]) {
					g.append(el('rect', { class: 'pd-bogie', x: f1(bx - 13), y: f1(floor), width: 26, height: 5, rx: 1.5 }));
					for (const dx of [-8, 8]) g.append(el('circle', { class: 'pd-bogie', cx: f1(bx + dx), cy: f1(RAIL - 4.2), r: 4.2 }));
				}
				g.append(el('rect', { class: 'pd-bogie', x: f1(x0 + 44), y: f1(floor), width: f1(BODY - 88), height: 3.2 }));
				// the body: a rounded roof; the cab car has a sloping nose on the right
				const nose = cab ? `L${f1(x1 - 6)} ${f1(roof)} Q${f1(x1 + 2)} ${f1(roof + 2)} ${f1(x1 + 4)} ${f1(roof + 12)} L${f1(x1 + 5)} ${f1(floor)} ` : `L${f1(x1 - 3)} ${f1(roof)} Q${f1(x1)} ${f1(roof)} ${f1(x1)} ${f1(roof + 3)} L${f1(x1)} ${f1(floor)} `;
				g.append(el('path', { class: 'pd-car', d: `M${f1(x0)} ${f1(floor)} L${f1(x0)} ${f1(roof + 3)} Q${f1(x0)} ${f1(roof)} ${f1(x0 + 3)} ${f1(roof)} ${nose}Z` }));
				// a green band under the windows and a red stripe low on the body
				const bandEnd = cab ? x1 + 4.6 : x1;
				g.append(el('rect', { class: 'pd-car-band', x: f1(x0), y: f1(yOf(2.15)), width: f1(bandEnd - x0), height: 2.6 }));
				g.append(el('rect', { class: 'pd-car-stripe', x: f1(x0), y: f1(yOf(1.65)), width: f1(bandEnd - x0), height: 2.2 }));
				// windows between the doors
				const wy = yOf(3.6);
				const wh = yOf(2.5) - wy;
				for (let k = 0; k < 9; k++) {
					const wx = x0 + 32 + k * 14.2;
					if (cab && wx > x1 - 34) break;
					g.append(el('rect', { class: 'pd-glass', x: f1(wx), y: f1(wy), width: 10.5, height: f1(wh), rx: 1 }));
				}
				// doors near both ends
				for (const dx of cab ? [x0 + 10] : [x0 + 10, x1 - 24]) {
					g.append(el('rect', { class: 'pd-door', x: f1(dx), y: f1(yOf(3.75)), width: 14, height: f1(yOf(1.3) - yOf(3.75)) }));
					g.append(el('rect', { class: 'pd-glass', x: f1(dx + 2), y: f1(yOf(3.55)), width: 4, height: f1(wh * 0.85) }));
					g.append(el('rect', { class: 'pd-glass', x: f1(dx + 8), y: f1(yOf(3.55)), width: 4, height: f1(wh * 0.85) }));
				}
				if (cab) {
					g.append(el('path', { class: 'pd-glass', d: `M${f1(x1 - 26)} ${f1(wy)} L${f1(x1 - 4)} ${f1(wy)} L${f1(x1 + 2.5)} ${f1(wy + wh)} L${f1(x1 - 26)} ${f1(wy + wh)} Z` }));
					g.append(el('circle', { class: 'pd-headlight', cx: f1(x1 + 3.6), cy: f1(yOf(1.9)), r: 1.4 }));
				}
				// a pantograph on every second car, up to the wire (y ≈ 86)
				if (i % 2 === 1) {
					const px = x0 + BODY / 2;
					g.append(el('path', { class: 'pd-panto', d: `M${f1(px - 12)} ${f1(roof)} L${f1(px + 2)} ${f1(roof - 10)} L${f1(px - 6)} 87 M${f1(px - 14)} 87 H${f1(px + 2)}` }));
				}
				train.append(g);
			}

			// the people: the man behind the boy, both facing right, the man's hand on the boy's shoulder
			const S = 0.55; // px per centimeter
			const man = figure($<SVGGElement>('[data-man]'), { s: S, H: 178, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'man' });
			const boy = figure($<SVGGElement>('[data-boy]'), { s: S, H: 125, age: 'child', clothes: 'indoor', shirt: 'hm-gold', hair: 'short', shorts: true, name: 'boy' });
			const BOY_X = 180;
			const MAN_X = 158;
			// ankles and hips from the kit's skeleton (ankle 0,045 H, hip joint 0,48 H child / 0,52 H adult above the sole); the
			// hips stand 1 px lower than the straight leg so the knees are just unlocked
			const ankleY = GROUND - 0.045 * 125 * S;
			const ankleYm = GROUND - 0.045 * 178 * S;
			const HIP_B = { x: BOY_X, y: GROUND - 0.48 * 125 * S + 1 };
			const HIP_M = { x: MAN_X, y: GROUND - 0.52 * 178 * S + 1 };
			const bubble = $<SVGGElement>('[data-bubble]');
			const countText = $<SVGTextElement>('[data-count]');
			const lamps = [...card.querySelectorAll<SVGCircleElement>('[data-lamp]')];
			const armLamp = $<SVGCircleElement>('[data-armlamp]');
			const WORDS = ['раз', 'два', 'три', 'четыре', 'пять'];
			// the moments a gap between cars passes X_SEE
			const tFront = (X_SEE - FRONT0) / (V * K);
			const counts = Array.from({ length: 5 }, (_, k) => tFront + ((k + 1) * PITCH) / (V * K)).filter((t) => t < RUN);

			scene(card, RUN, (x) => {
				const t = RUN * x;
				const front = FRONT0 + V * K * t;
				train.setAttribute('transform', `translate(${f1(front)} 0)`);
				lamps.forEach((l, i) => l.classList.toggle('is-on', Math.floor(t * 2) % 2 === i));
				armLamp.classList.toggle('is-on', Math.floor(t * 2) % 2 === 0);
				// the count: the last gap that passed, the word for 0,9 с
				let n = -1;
				counts.forEach((tc, k) => {
					if (t >= tc) n = k;
				});
				const since = n >= 0 ? t - counts[n] : 99;
				// the boy waves to the train with his raised open hand: the forearm sways at 12 / 7,6 ≈ 1,6 Hz (a whole number
				// of waves per run, so the loop closes without a jerk); a small nod of the head at each count (0,45 с, eased)
				const nod = since < 0.45 ? Math.sin(Math.PI * ease(since / 0.45)) : 0;
				const wave = Math.sin((2 * Math.PI * 12 * t) / RUN);
				const head = -0.2 + 0.08 * nod;
				// the boy
				const bs = boy.shoulders(HIP_B, 0.02);
				const bstate = boy.pose({
					hip: HIP_B,
					lean: 0.02,
					head,
					ankles: [
						{ x: BOY_X + 3, y: ankleY },
						{ x: BOY_X - 3, y: ankleY },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ arm: [-0.55, 0.9 + 0.3 * wave], pose: 'open', roll: Math.PI / 2 }, // the upper arm forward and up, the forearm up, in front of the face
						{ at: { x: BOY_X + 0.5, y: bs[1].y + 0.33 * 125 * S }, pose: "relaxed" },
					],
				});
				// the man (drawn in front of the boy): his near hand lies on the boy's near shoulder, the palm down
				const sh: Pt = bstate.shoulders[0];
				man.pose({
					hip: HIP_M,
					lean: 0.03,
					head: -0.12,
					ankles: [
						{ x: MAN_X + 4, y: ankleYm },
						{ x: MAN_X - 5, y: ankleYm },
					],
					feet: [0, 0],
					planted: [true, true],
					hands: [
						{ at: { x: sh.x - 0.5, y: sh.y - 2.6 }, pose: 'flat', dir: 0.15, roll: 0, contact: 'boy-shoulder' },
						{ at: { x: MAN_X + 1, y: ankleYm - 0.43 * 178 * S }, pose: 'relaxed' },
					],
				});
				// the speech bubble above the boy's head
				if (n >= 0 && since < 0.9) {
					const pop = Math.min(1, since / 0.12);
					bubble.setAttribute('opacity', String(since > 0.75 ? (0.9 - since) / 0.15 : 1));
					bubble.setAttribute('transform', `translate(${BOY_X + 8} ${GROUND - 125 * S - 33}) scale(${(0.68 + 0.17 * pop).toFixed(3)})`);
					countText.textContent = WORDS[n];
				} else bubble.setAttribute('opacity', '0');
			});
		}

		// ---------------------------------------------------------------- the sled
		{
			const card = root.querySelector<HTMLElement>('[data-scene="sled"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const A = (18 * Math.PI) / 180;
			const P0 = { x: 30, y: 96 }; // the sled's contact point at the start
			const K = 34; // px per metre along the slope (equal axes)
			const ACC = 2.1; // м/с²
			const T_HOLD = 1.0; // s on the top before she slides
			const RUN = T_HOLD + 3;
			const S = 0.34; // px per centimeter
			const H = 160;
			const rider = $<SVGGElement>('[data-rider]');
			const girl = figure($<SVGGElement>('[data-girl]'), { s: S, H, age: 'teen', clothes: 'winter', shirt: 'hm-blue', gear: 'boot', name: 'girl' });
			const cm = (x: number, y: number): Pt => ({ x: x * S, y: y * S }); // local frame: x down the slope, y into the snow
			// the sled, in local centimeters: a dish 50 см across with a wall of 6 см, the front lip turned up, rope handles
			const back = $<SVGGElement>('[data-sled-back]');
			const front = $<SVGGElement>('[data-sled-front]');
			const sp = (pts: [number, number][]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${f1(x * S)} ${f1(y * S)}`).join(' ');
			// the dish in front of her (its wall hides the seat), the far handle behind her, the near one in front
			front.append(el('path', { class: 'pd-sled', d: `M${f1(-25 * S)} ${f1(-6 * S)} Q${f1(-25 * S)} 0 ${f1(-18 * S)} 0 L${f1(16 * S)} 0 Q${f1(25 * S)} 0 ${f1(28 * S)} ${f1(-9 * S)} L${f1(25.5 * S)} ${f1(-10 * S)} Q${f1(22 * S)} ${f1(-6 * S)} ${f1(15 * S)} ${f1(-6 * S)} L${f1(-22 * S)} ${f1(-6.5 * S)} Q${f1(-23.5 * S)} ${f1(-7 * S)} ${f1(-25 * S)} ${f1(-6 * S)} Z` }));
			front.append(el('path', { class: 'pd-sled-rim', d: `M${f1(-21 * S)} ${f1(-3 * S)} L${f1(15 * S)} ${f1(-2.6 * S)}` }));
			back.append(el('path', { class: 'pd-sled-rope', d: `M${f1(-3 * S)} ${f1(-6 * S)} Q${f1(0.5 * S)} ${f1(-13 * S)} ${f1(4 * S)} ${f1(-6 * S)}` })); // the far handle
			front.append(el('path', { class: 'pd-sled-rope', d: `M${f1(-4 * S)} ${f1(-6 * S)} Q${f1(-0.5 * S)} ${f1(-13 * S)} ${f1(3 * S)} ${f1(-6 * S)}` })); // the near handle
			const HANDLE = cm(-0.5, -9.4); // the grip point on the handles

			const ghosts = $<SVGGElement>('[data-ghosts]');
			const tags = $<SVGGElement>('[data-tags]');
			const track = $<SVGPathElement>('[data-track]');
			const where = (s: number): Pt => ({ x: P0.x + s * K * Math.cos(A), y: P0.y + s * K * Math.sin(A) });
			const place = (s: number) => {
				const p = where(s);
				return `translate(${f1(p.x)} ${f1(p.y)}) rotate(18)`;
			};
			// the pose, in the local frame; `u` 0…1: hands from the snow to the handles
			const pose = (u: number) => {
				const e = ease(u);
				const hip = cm(-4, -11);
				const snowN = cm(-22, 0);
				const snowF = cm(-18, 0);
				const lerp = (a: Pt, b: Pt) => ({ x: a.x + (b.x - a.x) * e, y: a.y + (b.y - a.y) * e - Math.sin(Math.PI * e) * 6 * S });
				const flatN = e < 0.5;
				girl.pose({
					hip,
					lean: -0.3 + 0.25 * e, // leaning back on the hands, then upright on the sled
					head: 0.12,
					ankles: [cm(44, -9.5), cm(41, -9)],
					feet: [-0.35, -0.35],
					hands: [
						{ at: lerp(snowN, HANDLE), pose: flatN ? 'flat' : 'grip', d: 1.5, dir: flatN ? 0 : undefined, roll: flatN ? 0 : undefined, contact: u <= 0 ? 'snow' : u >= 1 ? 'sled-handle' : undefined },
						{ at: lerp(snowF, { x: HANDLE.x + 1, y: HANDLE.y }), pose: flatN ? 'flat' : 'grip', d: 1.5, dir: flatN ? 0 : undefined, roll: flatN ? 0 : undefined, contact: u <= 0 ? 'snow' : u >= 1 ? 'sled-handle' : undefined },
					],
				});
			};
			// snapshots 0, 1 and 2 с after the start: the rider posed there and copied (the copies are plain drawings)
			const shots: SVGGElement[] = [];
			for (const ts of [0, 1, 2]) {
				const s = (ACC * ts * ts) / 2;
				pose(1);
				rider.setAttribute('transform', place(s));
				const c = rider.cloneNode(true) as SVGGElement;
				c.removeAttribute('data-rider');
				c.querySelectorAll('[data-person]').forEach((n) => n.removeAttribute('data-person'));
				c.classList.add('pd-ghost');
				ghosts.append(c);
				shots.push(c);
			}
			const tagEls = [0, 1, 2, 3].map((ts) => {
				const s = (ACC * ts * ts) / 2;
				const p = where(s);
				// the tag stands above the rider, along the normal of the slope
				const q = { x: p.x + 46 * Math.sin(A) - 2, y: p.y - 46 * Math.cos(A) };
				const g = el('g', { opacity: 0 });
				g.append(el('line', { class: 'pd-tag-line', x1: f1(q.x + 2), y1: f1(q.y + 3), x2: f1(q.x + 2), y2: f1(q.y + 9) }));
				const tx = el('text', { class: 'pd-tag', x: f1(q.x + 2), y: f1(q.y), 'text-anchor': 'middle' });
				tx.textContent = `${ts} с`;
				g.append(tx);
				tags.append(g);
				return g;
			});
			// falling snow: flakes at random places drift down at about 1 м/с and a little sideways
			const flakesG = $<SVGGElement>('[data-flakes]');
			let seed = 7;
			const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
			const flakes = Array.from({ length: 34 }, () => ({ x: rnd() * 360, y: rnd() * 240, r: 0.7 + rnd() * 0.9, v: 22 + rnd() * 16, ph: rnd() * 6.3 }));
			const flakeEls = flakes.map((fl) => {
				const c = el('circle', { class: 'pd-flake', r: f1(fl.r) });
				flakesG.append(c);
				return c;
			});

			scene(card, RUN, (x) => {
				const t = RUN * x;
				const ts = Math.max(0, t - T_HOLD); // time on the slope
				const s = (ACC * ts * ts) / 2;
				pose(t < 0.3 ? 0 : (t - 0.3) / 0.6);
				rider.setAttribute('transform', place(s));
				shots.forEach((g, i) => g.setAttribute('visibility', t >= T_HOLD + i ? 'visible' : 'hidden'));
				tagEls.forEach((g, i) => g.setAttribute('opacity', t >= T_HOLD + i ? '1' : '0'));
				const a = where(0);
				const b = where(s);
				track.setAttribute('d', s > 0.01 ? `M${f1(a.x)} ${f1(a.y + 0.6)} L${f1(b.x)} ${f1(b.y + 0.6)}` : '');
			});
			// the snow falls all the time, also while the end frame holds
			let tf = 0;
			const snow = () =>
				flakes.forEach((fl, i) => {
					const y = (((fl.y + fl.v * tf) % 250) + 250) % 250 - 5;
					flakeEls[i].setAttribute('cx', f1(fl.x + 4 * Math.sin(fl.ph + tf * 1.3)));
					flakeEls[i].setAttribute('cy', f1(y));
				});
			snow();
			loop(card, (dt) => {
				tf += dt;
				snow();
				return true;
			})();
		}
	}
</script>
