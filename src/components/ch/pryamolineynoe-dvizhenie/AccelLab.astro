---
/**
 * Model: displacement in uniformly accelerated motion. A road from −200 to 200 м (0,8 px per metre, ticks every 50 м),
 * x₀ = 0; a car with its velocity (blue, 3 px per м/с) and acceleration (red, 12 px per м/с²); a dot on the road at its
 * place after every whole second. Graphs for t 0…10 с: υₓ(t) (blue) with the figure under it from 0 to t shaded (a
 * trapezoid, or two triangles when the car turns back: gold above the time axis, violet below) and x(t) (green
 * parabola). υₓ = υ₀ₓ + aₓt, x = υ₀ₓt + aₓt²/2. The readouts compute the area geometrically ((υ₀ₓ + υₓ)/2 · t, or the
 * two triangles with their signs) and sₓ = x − x₀ from the car's place, and the path l (the sum of the triangles
 * without signs). With υ₀ₓ −10…10 м/с (step 1), aₓ −2…2 м/с² (step 0,5) and t ≤ 10 с, |x| ≤ 200 м (exactly 200 м
 * only at υ₀ₓ = ±10, aₓ = ±2, t = 10 с), so the road always holds the car. Real time; the car (4,4 м) is drawn 8 times
 * larger than the scale of the road. Under the road a magnifier shows −20…20 м ten times larger (8 px per metre, ticks every
 * metre): the dots of every whole second and the car's place (a gold triangle) when it is there, so that small
 * displacements (from rest at 2 м/с²: 1, 4, 9, 16 м) can be read.
 */
import PdStyles from './PdStyles.astro';
---

<PdStyles />
<figure class="g7 g7--stack pdm not-content" data-acclab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 170" role="img" aria-label="Прямая дорога с осью x и автомобилем; синяя стрелка — скорость, красная — ускорение; точки отмечают положение автомобиля через каждую секунду. Ниже — участок дороги от −20 до 20 метров, увеличенный в 10 раз">
			<rect class="pdm-grass" x="0" y="0" width="360" height="82"></rect>
			<rect class="pdm-road" x="0" y="44" width="360" height="26"></rect>
			<line class="pdm-lane" x1="0" y1="57" x2="360" y2="57"></line>
			<g data-marks></g>
			<g data-carwrap><g data-car></g></g>
			<g data-arrows></g>
			<path class="pdm-drop" data-drop d=""></path>
			<g data-axis></g>
			<!-- the magnifier: −20…20 м ten times larger -->
			<path class="ln-dash" d="M164 100 L18 120 M196 100 L342 120"></path>
			<rect class="al-zoom" x="12" y="120" width="336" height="46" rx="6"></rect>
			<text class="t-small" x="18" y="132">лупа ×10</text>
			<g data-zaxis></g>
			<g data-zmarks></g>
			<path class="head--gold" data-zcar d=""></path>
		</svg>
		<div class="pdm-graphs">
			<div>
				<p>Проекция скорости</p>
				<svg class="g7__svg" viewBox="0 0 200 156" role="img" aria-label="График проекции скорости от времени — прямая; закрашенная площадь под ним равна проекции перемещения"><g data-vg></g><path class="pdm-area" data-a1 d=""></path><path class="pdm-area pdm-area--neg" data-a2 d=""></path><path class="pdm-curve pdm-curve--v" data-vl d=""></path><circle class="pdm-dot" data-vd r="3.6"></circle></svg>
			</div>
			<div>
				<p>Координата</p>
				<svg class="g7__svg" viewBox="0 0 200 156" role="img" aria-label="График координаты от времени — парабола"><g data-xg></g><path class="pdm-curve pdm-curve--x" data-xl d=""></path><circle class="pdm-dot" data-xd r="3.6"></circle></svg>
			</div>
		</div>
		<div class="pdm-ctrl">
			<div class="g7__row">
				<label class="g7__slider" style="flex: 1 1 10rem"><span>Начальная скорость <i>υ</i><sub>0<i>x</i></sub></span><output data-o0></output><input type="range" min="-10" max="10" step="1" value="2" data-v0 aria-label="Проекция начальной скорости, метры в секунду" /></label>
				<label class="g7__slider" style="flex: 1 1 10rem"><span>Ускорение <i>a<sub>x</sub></i></span><output data-oa></output><input type="range" min="-2" max="2" step="0.5" value="1" data-a aria-label="Проекция ускорения, метры в секунду в квадрате" /></label>
				<label class="g7__slider" style="flex: 1 1 10rem"><span>Время <i>t</i></span><output data-ot></output><input type="range" min="0" max="10" step="0.5" value="0" data-t aria-label="Время, секунды" /></label>
			</div>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-go>Старт</button>
				<button type="button" class="g7__btn" data-reset>Сначала</button>
			</div>
			<ul class="g7__lines" data-calc></ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Синяя стрелка — скорость автомобиля, красная — ускорение, точки на дороге — где он был через каждую секунду. Площадь под графиком скорости, взятая со знаком, равна проекции перемещения: золотая часть — со знаком «плюс», фиолетовая — со знаком «минус». Внизу — участок дороги от −20 до 20&nbsp;м под лупой, в 10 раз крупнее. Часы идут как настоящие; автомобиль нарисован в 8 раз крупнее, чем в масштабе дороги.
	</figcaption>
</figure>

<style is:global>
	[data-acclab] .al-zoom {
		fill: color-mix(in oklab, var(--ig-v) 6%, var(--g7-paper));
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
</style>

<script>
	import { k, loop } from '../g7/kit';
	import { car } from '../ravnouskorennoe-dvizhenie/car';
	import { axisX, el, f1, fmt, graphFrame, newArrow } from './pd';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-acclab]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const K = 0.8;
		const X = (m: number) => 180 + m * K;
		const TMAX = 10;
		const in0 = $<HTMLInputElement>('[data-v0]');
		const inA = $<HTMLInputElement>('[data-a]');
		const inT = $<HTMLInputElement>('[data-t]');
		const go = $<HTMLButtonElement>('[data-go]');
		const wrap = $<SVGGElement>('[data-carwrap]');
		const pose = car($<SVGGElement>('[data-car]'), 0.064, 'cr-gold'); // ×8
		const vArrow = newArrow($<SVGGElement>('[data-arrows]'), 'blue');
		const aArrow = newArrow($<SVGGElement>('[data-arrows]'), 'red');
		const marks = $<SVGGElement>('[data-marks]');
		axisX($<SVGGElement>('[data-axis]'), { y: 96, xa: 12, xb: 348, X, from: -200, to: 200, step: 50, every: 100 });
		const XZ = (m: number) => 180 + m * 8; // the magnifier: 8 px per metre
		axisX($<SVGGElement>('[data-zaxis]'), { y: 148, xa: 20, xb: 340, X: XZ, from: -20, to: 20, step: 1, every: 5 });
		const zmarks = $<SVGGElement>('[data-zmarks]');
		const zcar = $<SVGPathElement>('[data-zcar]');
		const gv = graphFrame($<SVGGElement>('[data-vg]'), { x0: 40, y0: 14, w: 140, h: 120, t1: 10, tStep: 2, v0: -30, v1: 30, vStep: 10, vName: ['υ', 'x'], vUnit: 'м/с' });
		const gx = graphFrame($<SVGGElement>('[data-xg]'), { x0: 40, y0: 14, w: 140, h: 120, t1: 10, tStep: 2, v0: -200, v1: 200, vStep: 50, vEvery: 100, vName: ['x'], vUnit: 'м' });
		let t = 0;
		let running = false;
		let face = 1;
		const tx = (v: number, d = 2) => {
			let s = v.toFixed(d);
			if (s.includes('.')) s = s.replace(/0+$/, '').replace(/\.$/, '');
			if (s === '-0') s = '0';
			return s.replace('.', '{,}');
		};
		const par = (v: number) => (v < 0 ? `(${tx(v)})` : tx(v));
		const M = '\\ \\text{м}';
		const MS = '\\ \\tfrac{\\text{м}}{\\text{с}}';
		const draw = () => {
			const v0 = Number(in0.value);
			const a = Number(inA.value);
			$<HTMLOutputElement>('[data-o0]').textContent = `${fmt(v0, 0)} м/с`;
			$<HTMLOutputElement>('[data-oa]').textContent = `${fmt(a, 1)} м/с²`;
			$<HTMLOutputElement>('[data-ot]').textContent = `${fmt(t, 1)} с`;
			if (Number(inT.value) !== t) inT.value = String(t);
			const xOf = (s: number) => v0 * s + (a * s * s) / 2;
			const v = v0 + a * t;
			const x = xOf(t);
			// the car faces its motion; when it stops for a moment it keeps its last direction
			if (Math.abs(v) > 1e-6) face = v > 0 ? 1 : -1;
			else if (t === 0) face = a >= 0 ? 1 : -1;
			wrap.setAttribute('transform', `translate(${f1(X(x) + face * 14)} 66) scale(${face} 1)`);
			pose(0, 0, x * 100, Math.abs(v) > 1e-6 && a * v < 0);
			vArrow(X(x), 36, X(x) + v * 3, 36, 8, 4.5);
			aArrow(X(x), 28, X(x) + a * 12, 28, 7, 4);
			$('[data-drop]').setAttribute('d', `M${f1(X(x))} 70 V96`);
			marks.replaceChildren();
			zmarks.replaceChildren();
			for (let s = 0; s <= t + 1e-9; s++) {
				marks.append(el('circle', { class: 'pdm-mark', cx: f1(X(xOf(s))), cy: 74, r: 2 }));
				if (Math.abs(xOf(s)) <= 20) zmarks.append(el('circle', { class: 'pdm-mark', cx: f1(XZ(xOf(s))), cy: 140, r: 2.6 }));
			}
			// the car's place in the magnifier: a gold triangle pointing at the axis
			zcar.setAttribute('d', Math.abs(x) <= 20 ? `M${f1(XZ(x))} 146 l-4 -8 h8 Z` : '');
			// υx(t) and the figure under it
			$('[data-vl]').setAttribute('d', `M${f1(gv.T(0))} ${f1(gv.V(v0))} L${f1(gv.T(t))} ${f1(gv.V(v))}`);
			const vd = $<SVGCircleElement>('[data-vd]');
			vd.setAttribute('cx', f1(gv.T(t)));
			vd.setAttribute('cy', f1(gv.V(v)));
			const ts = a !== 0 ? -v0 / a : -1; // the moment the velocity is zero
			const turn = ts > 0 && ts < t;
			const poly = (t1: number, t2: number) => `M${f1(gv.T(t1))} ${f1(gv.V(0))} L${f1(gv.T(t1))} ${f1(gv.V(v0 + a * t1))} L${f1(gv.T(t2))} ${f1(gv.V(v0 + a * t2))} L${f1(gv.T(t2))} ${f1(gv.V(0))} Z`;
			const parts: [number, number][] = turn ? [[0, ts], [ts, t]] : t > 0 ? [[0, t]] : [];
			const posParts = parts.filter(([p, q]) => v0 + a * ((p + q) / 2) > 0);
			const negParts = parts.filter(([p, q]) => v0 + a * ((p + q) / 2) < 0);
			$('[data-a1]').setAttribute('d', posParts.map(([p, q]) => poly(p, q)).join(' '));
			$('[data-a2]').setAttribute('d', negParts.map(([p, q]) => poly(p, q)).join(' '));
			// x(t)
			let d = '';
			for (let i = 0; i <= 60; i++) {
				const s = (t * i) / 60;
				d += `${i ? 'L' : 'M'}${f1(gx.T(s))} ${f1(gx.V(xOf(s)))}`;
			}
			$('[data-xl]').setAttribute('d', d);
			const xd = $<SVGCircleElement>('[data-xd]');
			xd.setAttribute('cx', f1(gx.T(t)));
			xd.setAttribute('cy', f1(gx.V(x)));
			// the readouts
			const areas = parts.map(([p, q]) => ((v0 + a * p + v0 + a * q) / 2) * (q - p));
			const area = areas.reduce((u, w) => u + w, 0);
			const path = areas.reduce((u, w) => u + Math.abs(w), 0);
			const areaLine = turn
				? `${k(`\\tfrac{${tx(v0)}${MS} \\cdot ${tx(ts)}\\ \\text{с}}{2} + \\tfrac{${par(v)}${MS} \\cdot ${tx(t - ts)}\\ \\text{с}}{2} = ${tx(areas[0])}${M} ${areas[1] < 0 ? '-' : '+'} ${tx(Math.abs(areas[1]))}${M} = ${tx(area)}${M}`)}`
				: `${k(`\\tfrac{\\upsilon_{0x} + \\upsilon_x}{2}\\, t = \\tfrac{${tx(v0)} + ${par(v)}}{2}${MS} \\cdot ${tx(t)}\\ \\text{с} = ${tx(area)}${M}`)}`;
			$('[data-calc]').innerHTML = [
				`<li>${k(`\\upsilon_x = \\upsilon_{0x} + a_x t = ${tx(v0)}${MS} + ${par(a)}\\ \\tfrac{\\text{м}}{\\text{с}^2} \\cdot ${tx(t)}\\ \\text{с} = ${tx(v)}${MS}`)}</li>`,
				`<li>Площадь под графиком скорости: ${areaLine}</li>`,
				`<li class="is-key">По положению автомобиля: ${k(`s_x = x - x_0 = ${tx(x)}${M} - 0${M} = ${tx(x)}${M}`)}</li>`,
				`<li>Путь: ${k(`l = ${tx(path)}${M}`)}${turn ? ` (автомобиль развернулся через ${fmt(ts, 1)} с)` : ''}</li>`,
			].join('');
			go.textContent = running ? 'Пауза' : 'Старт';
		};
		const wake = loop(fig, (dt) => {
			if (!running) return false;
			t = Math.min(TMAX, t + dt);
			if (t >= TMAX) running = false;
			draw();
			return running;
		});
		go.addEventListener('click', () => {
			if (!running && t >= TMAX) t = 0;
			running = !running;
			draw();
			wake();
		});
		$('[data-reset]').addEventListener('click', () => {
			running = false;
			t = 0;
			draw();
		});
		inT.addEventListener('input', () => {
			running = false;
			t = Number(inT.value);
			draw();
		});
		for (const i of [in0, inA]) i.addEventListener('input', draw);
		draw();
	}
</script>
