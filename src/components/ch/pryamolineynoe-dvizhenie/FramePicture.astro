---
/**
 * The material point and the frame of reference (animated, real time, a loop of 15 s and 2 s of the end frame).
 * Above, «На карте»: a strip of a map from Москва to Тверь (the road about 170 км),
 *   the scale bar is set from the drawn road itself (50 км = 50/170 of its length, about 88 px, so the straight line
 *   Москва–Тверь, 287 px, comes out about 160 км, as on a real map); the car is a dot that runs along the road during the same 15 s (the trip itself takes about 2,5 h: this part is
 *   about 600 times faster than real time).
 * Below, «На дороге»: a straight road with an axis Ox from −100 to 400 м (0,64 px per metre, ticks every 50 м); the body
 *   of reference is a kilometre post «0» at the origin; a car drives to the right at 20 м/с from x₀ = 50 м,
 *   x = 50 + 20t, up to 350 м at t = 15 с; a stopwatch (one turn of the hand per 60 с) and the readouts t and x. The car
 *   (4,4 м) is drawn 6 times larger than the scale of the road (the caption says so).
 */
import PdStyles from './PdStyles.astro';
const X = (m: number) => 52 + m * 0.64;
const ticks = Array.from({ length: 11 }, (_, i) => -100 + i * 50);
---

<PdStyles />
<figure class="g7 g7--pic pdm not-content" data-framepic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 250" role="img" aria-label="Вверху карта: автомобиль едет из Москвы в Тверь и на карте выглядит точкой. Внизу прямая дорога с осью x, километровый столб с нулём — тело отсчёта, секундомер; автомобиль едет вправо, и его координата растёт на 20 метров каждую секунду">
			<!-- the map -->
			<rect class="fp-map" x="6" y="6" width="348" height="92" rx="6"></rect>
			<path class="fp-river" d="M6 70 Q60 58 110 74 T220 66 T354 78"></path>
			<path class="fp-forest" d="M70 20 q14 -6 26 2 q10 8 -4 14 q-18 4 -22 -16 Z M230 30 q18 -8 30 4 q6 12 -12 12 q-16 0 -18 -16 Z M150 80 q12 -4 20 2 q4 8 -8 9 q-12 0 -12 -11 Z"></path>
			<path class="fp-road" data-route d="M318 74 C292 70 280 56 256 52 S214 44 196 40 S150 46 128 40 S84 30 66 34 S44 40 34 34"></path>
			<circle class="fp-city" cx="318" cy="74" r="6"></circle>
			<circle class="fp-city" cx="34" cy="34" r="4.5"></circle>
			<text class="t-title" x="318" y="92" text-anchor="middle">Москва</text>
			<text class="t-title" x="34" y="56" text-anchor="middle">Тверь</text>
			<path class="ink" data-bar d=""></path>
			<text class="t-small" data-bartext x="175" y="83" text-anchor="middle">50 км</text>
			<circle class="fp-car-dot" data-mapcar r="3.4"></circle>
			<text class="t-small" x="352" y="18" text-anchor="end">на карте</text>
			<!-- the road -->
			<rect class="pdm-grass" x="6" y="106" width="348" height="138" rx="6"></rect>
			<rect class="pdm-road" x="6" y="150" width="348" height="26"></rect>
			<line class="pdm-lane" x1="6" y1="163" x2="354" y2="163"></line>
			<!-- the kilometre post at x = 0 -->
			<rect class="fp-post" x={X(0) - 4} y="128" width="8" height="22" rx="1.5"></rect>
			<text class="fp-post-num" x={X(0)} y="140" text-anchor="middle">0</text>
			<text class="t-small" x={X(0) + 9} y="142">тело отсчёта</text>
			<g data-car></g>
			<!-- the axis -->
			<path class="ink" d={`M14 200 H344`}></path>
			<path class="head--ink" d="M350 200 l-9 -4 v8 Z"></path>
			{ticks.map((m) => (
				<>
					<line class="ln" x1={X(m)} y1="196" x2={X(m)} y2="204" />
					{m % 100 === 0 && <text class="t-small t-num" x={X(m)} y="216" text-anchor="middle">{m === 0 ? '0' : String(m).replace('-', '−')}</text>}
				</>
			))}
			<text x="346" y="191" text-anchor="end"><tspan class="t-i">x</tspan>, м</text>
			<text class="t-small" x="14" y="236">система координат: ось <tspan class="t-i">x</tspan> вдоль дороги, начало у столба</text>
			<path class="pdm-drop" data-drop d=""></path>
			<circle class="head--gold" data-foot cy="200" r="3"></circle>
			<!-- the stopwatch -->
			<g transform="translate(332 128)">
				<rect class="pdm-watch" x="-3" y="-21" width="6" height="5" rx="1"></rect>
				<circle class="pdm-watch" r="15"></circle>
				{Array.from({ length: 12 }, (_, i) => <line class="ln" x1={(12 * Math.sin((i * Math.PI) / 6)).toFixed(1)} y1={(-12 * Math.cos((i * Math.PI) / 6)).toFixed(1)} x2={(14 * Math.sin((i * Math.PI) / 6)).toFixed(1)} y2={(-14 * Math.cos((i * Math.PI) / 6)).toFixed(1)} />)}
				<line class="pdm-hand" data-hand x1="0" y1="0" x2="0" y2="-11"></line>
				<text class="t-small" x="-19" y="4" text-anchor="end">часы</text>
			</g>
			<text class="t-title t-num" x="206" y="131" text-anchor="middle" data-read></text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		На карте путь в 170&nbsp;км так велик, что автомобиль можно считать точкой. Чтобы описать его движение по дороге, нужны тело отсчёта (столб), ось вдоль дороги и часы. Автомобиль на дороге нарисован в 6 раз крупнее, чем в масштабе оси.
	</figcaption>
</figure>

<style is:global>
	[data-framepic] .fp-map {
		fill: color-mix(in oklab, var(--ig-v) 8%, var(--g7-paper));
		stroke: var(--sl-color-gray-5);
	}
	[data-framepic] .fp-river {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-vx) 60%, var(--g7-paper));
		stroke-width: 2.5;
	}
	[data-framepic] .fp-forest {
		fill: color-mix(in oklab, hsl(130, 40%, 45%) 35%, var(--g7-paper));
	}
	[data-framepic] .fp-road {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-framepic] .fp-city {
		fill: var(--sl-color-gray-2);
	}
	[data-framepic] .fp-car-dot {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	[data-framepic] .fp-post {
		fill: var(--sl-color-gray-1);
		stroke: var(--sl-color-gray-4);
	}
	[data-framepic] .fp-post-num {
		font-size: 9px !important;
		font-weight: 700;
		fill: var(--g7-paper) !important;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { car } from '../ravnouskorennoe-dvizhenie/car';
	import { f1, fmt } from './pd';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-framepic]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const K = 0.64; // px per metre
		const X = (m: number) => 52 + m * K;
		const T = 15;
		const HOLD = 2;
		const route = $<SVGPathElement>('[data-route]');
		const RL = route.getTotalLength();
		const dot = $<SVGCircleElement>('[data-mapcar]');
		// an honest scale: the drawn road is 170 км long, so 50 км is 50/170 of its length
		const bar = (50 / 170) * RL;
		$('[data-bar]').setAttribute('d', `M150 88 h${f1(bar)} M150 85 V91 M${f1(150 + bar)} 85 V91`);
		$('[data-bartext]').setAttribute('x', f1(150 + bar / 2));
		const pose = car($<SVGGElement>('[data-car]'), 0.0384, 'cr-gold'); // 0,64 px per metre, ×6
		const hand = $<SVGLineElement>('[data-hand]');
		const read = $<SVGTextElement>('[data-read]');
		const drop = $<SVGPathElement>('[data-drop]');
		const foot = $<SVGCircleElement>('[data-foot]');
		let t = 0;
		const draw = () => {
			const tt = Math.min(t, T);
			const x = 50 + 20 * tt;
			const px = X(x);
			pose(px, 172, x * 100, false);
			const p = route.getPointAtLength(RL * (tt / T));
			dot.setAttribute('cx', f1(p.x));
			dot.setAttribute('cy', f1(p.y));
			const a = (tt / 60) * 2 * Math.PI;
			hand.setAttribute('x2', f1(11 * Math.sin(a)));
			hand.setAttribute('y2', f1(-11 * Math.cos(a)));
			read.innerHTML = `<tspan class="t-i">t</tspan> = ${fmt(tt, 1)} с, <tspan class="t-i">x</tspan> = ${Math.round(x)} м`;
			drop.setAttribute('d', `M${f1(px)} 174 V200`);
			foot.setAttribute('cx', f1(px));
		};
		draw();
		loop(fig, (dt) => {
			t += dt;
			if (t > T + HOLD) t = 0;
			draw();
			return true;
		});
	}
</script>
