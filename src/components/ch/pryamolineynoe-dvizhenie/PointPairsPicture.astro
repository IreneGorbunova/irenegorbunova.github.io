---
/**
 * Picture for the definition of the material point (Irina, 28 Nov 2026: «картинки, где тело наглядно можно принять за
 * материальную точку и нельзя»): two bodies, each in two problems. Four panels, two in a row (stacked on a phone, so
 * every panel carries its own title and its verdict). The grade-10 picture of «Материальная точка» (an airliner on a
 * dispatcher's map and at a jet bridge) and the map Москва — Тверь of FramePicture in this chapter are not repeated.
 *   1. «Поездка Москва — Нижний Новгород»: a map at 0,5 px per километр (latitude 55,6 px per degree, longitude
 *      31,1 px per degree = 55,6 · cos 56°); the road М-7 through Покров, Владимир and Гороховец from rough coordinates.
 *      The cities are 402 км apart in a straight line (computed), the road is longer; a car of 4,4 м is 90 000 times
 *      shorter than 400 км and would be 0,002 px long here, so it is a dot. One trip per 8 s (the real one takes about
 *      6 h: sped up, the caption says so), 1,5 s at the end. Scale bar 100 км = 50 px.
 *   2. «Въезд в гараж»: side view, to scale, 30 px per metre: a garage 6 м long inside, a car 4,4 м long (car.ts).
 *      The car rolls in, front first, from 7,4 м away and stops 0,5 м before the back wall (6 s, smooth start and stop,
 *      1,2 м/с on average, real time), waits 1,5 s, backs out the same way in 6 s and waits 1 s outside. Here the
 *      length of the car decides everything: the gap 0,5 м is marked (with a leader up to its label) while it stands
 *      inside.
 *   3. «Путь вокруг Солнца»: the orbit (149,6 млн км, drawn as a circle of 50 px; the eccentricity 0,017 is invisible),
 *      the Earth a dot going round counterclockwise as seen from the north. The orbit radius is 11 700 times the
 *      Earth's diameter (12 742 км): to scale the Earth would be 0,004 px, the Sun 0,5 px (drawn 8 px: larger than the
 *      scale, the caption says so). One year per 12 s.
 *   4. «Сутки: день и ночь»: the Earth seen from above the North Pole (radius 58 px), the Sun's rays from the left, the
 *      night half shaded; the Earth turns counterclockwise, one day per 12 s. Moscow (latitude 55,75°) is a red dot at
 *      58 · cos 55,75° = 32,6 px from the pole; a readout says whether it is day or night in Moscow. Here what matters is
 *      which side of the Earth faces the Sun: its size and its rotation.
 */
import PdStyles from './PdStyles.astro';
const f = (v: number) => v.toFixed(1);
// 1. the map: lon/lat → px
const MX = (lon: number) => 16 + (lon - 37) * 31.1;
const MY = (lat: number) => 100 - (lat - 56) * 55.6;
const pt = (lo: number, la: number) => ({ x: MX(lo), y: MY(la) });
const msk = pt(37.62, 55.76);
const pok = pt(39.18, 55.92);
const vla = pt(40.41, 56.13);
const gor = pt(42.69, 56.2);
const nn = pt(44.0, 56.33);
const road = `M${f(msk.x)} ${f(msk.y)} C${f(msk.x + 20)} ${f(msk.y - 2)} ${f(pok.x - 18)} ${f(pok.y + 4)} ${f(pok.x)} ${f(pok.y)} S${f(vla.x - 16)} ${f(vla.y + 3)} ${f(vla.x)} ${f(vla.y)} S${f(gor.x - 26)} ${f(gor.y + 4)} ${f(gor.x)} ${f(gor.y)} S${f(nn.x - 14)} ${f(nn.y + 6)} ${f(nn.x)} ${f(nn.y)}`;
// 2. the garage: 30 px per metre
const K = 30;
const GY = 128; // the ground
const WALL = 268; // the inner face of the back wall
const DOOR = WALL - 6 * K; // the open door: inner length 6 м
const HG = 2.3 * K; // the inner height
// 4. the Earth from above the North Pole
const E = { x: 168, y: 84, r: 58 };
// the arrow of rotation: an arc at 66 px from −0,5 to 0,55 rad (counterclockwise on the screen), its head ends at 0,7 rad
const RA = E.r + 8;
const PA = (th: number, r = RA) => `${f(E.x + r * Math.cos(th))} ${f(E.y - r * Math.sin(th))}`;
const spinHead = `M${PA(0.72)} L${PA(0.55, RA - 4)} L${PA(0.55, RA + 4)} Z`;
---

<PdStyles />
<figure class="g7 g7--pic pdm not-content" data-ppairs>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 290 176" role="img" aria-label="Карта: автомобиль едет из Москвы в Нижний Новгород, больше 400 километров. На карте он точка. Его можно считать материальной точкой">
			<rect class="pq-land" x="0" y="0" width="290" height="176" rx="6"></rect>
			<path class="pq-road" d={road} data-road></path>
			{[pok, gor].map((c) => <circle class="pq-town" cx={f(c.x)} cy={f(c.y)} r="2.2" />)}
			<circle class="pq-city" cx={f(msk.x)} cy={f(msk.y)} r="4.5"></circle>
			<circle class="pq-city" cx={f(vla.x)} cy={f(vla.y)} r="3"></circle>
			<circle class="pq-city" cx={f(nn.x)} cy={f(nn.y)} r="4.5"></circle>
			<text class="t-small" x={f(msk.x)} y={f(msk.y + 17)} text-anchor="middle">Москва</text>
			<text class="t-small" x={f(vla.x)} y={f(vla.y + 24)} text-anchor="middle">Владимир</text>
			<text class="t-small" x={f(nn.x)} y={f(nn.y + 24)} text-anchor="middle">Нижний Новгород</text>
			<circle class="pq-dot" r="3.4" data-mapcar></circle>
			<path class="ln" d="M14 50 h50 M14 46 V54 M64 46 V54"></path>
			<text class="t-small t-num" x="72" y="54">100&nbsp;км</text>
			<text class="t-title" x="10" y="20">Поездка Москва — Нижний Новгород</text>
			<text class="t-small" x="10" y="150">Путь в 90 000 раз длиннее машины.</text>
			<text class="t-title pq-yes" x="10" y="168">Можно считать точкой</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 290 176" role="img" aria-label="Тот же автомобиль въезжает в гараж длиной 6 метров и останавливается в половине метра от задней стены. Его нельзя считать материальной точкой: важна его длина">
			<rect class="pq-sky" x="0" y="0" width="290" height={GY} rx="6"></rect>
			<rect class="pq-ground" x="0" y={GY} width="290" height={176 - GY}></rect>
			<!-- the garage, cut open: the far wall, the roof, the back wall -->
			<rect class="pq-inside" x={DOOR} y={GY - HG} width={6 * K} height={HG}></rect>
			<rect class="pq-wall" x={DOOR - 4} y={GY - HG - 8} width={6 * K + 14} height="8"></rect>
			<rect class="pq-wall" x={WALL} y={GY - HG - 8} width="10" height={HG + 8}></rect>
			<rect class="pq-door" x={DOOR - 4} y={GY - HG} width="4" height="12"></rect>
			<g data-garcar></g>
			<path class="ln" d={`M${DOOR} ${GY - HG - 18} H${WALL} M${DOOR} ${GY - HG - 22} V${GY - HG - 14} M${WALL} ${GY - HG - 22} V${GY - HG - 14}`}></path>
			<text class="t-small t-num" x={(DOOR + WALL) / 2} y={GY - HG - 23} text-anchor="middle">гараж 6&nbsp;м</text>
			<g data-gap>
				<path class="pq-gap" d={`M${WALL - 0.5 * K} ${GY - 20} H${WALL} M${WALL - 0.5 * K} ${GY - 24} V${GY - 16} M${WALL} ${GY - 24} V${GY - 16}`}></path>
				<path class="pq-gap" d={`M${WALL - 0.25 * K} ${GY - 24} V${GY - 50}`}></path>
				<text class="t-small t-num pq-gaptext" x={WALL - 4} y={GY - 54} text-anchor="end">0,5&nbsp;м</text>
			</g>
			<text class="t-title" x="10" y="20">Въезд в гараж</text>
			<text class="t-small" x="10" y="150">Машина 4,4 м, гараж 6 м: важна её длина.</text>
			<text class="t-title pq-no" x="10" y="168">Нельзя считать точкой</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 290 176" role="img" aria-label="Земля движется вокруг Солнца по орбите радиусом 150 миллионов километров. На таком рисунке Земля — точка. Её можно считать материальной точкой">
			<rect class="pq-space" x="0" y="0" width="290" height="176" rx="6"></rect>
			<circle class="pq-orbit" cx="130" cy="84" r="50"></circle>
			<circle class="pq-sun" cx="130" cy="84" r="8"></circle>
			<text class="t-small" x="130" y="106" text-anchor="middle">Солнце</text>
			<path class="ln" d="M138 84 H180"></path>
			<text class="t-small t-num" x="188" y="88">150 млн км</text>
			<circle class="pq-earth" r="3.6" data-orbearth></circle>
			<text class="t-title" x="10" y="20">Путь Земли вокруг Солнца</text>
			<text class="t-small" x="10" y="150">Орбита в 12 000 раз больше Земли.</text>
			<text class="t-title pq-yes" x="10" y="168">Можно считать точкой</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 290 176" role="img" aria-label="Земля вращается вокруг своей оси, вид с Северного полюса. Солнце освещает её слева, правая половина в тени. Москва то на дневной, то на ночной стороне. Здесь Землю нельзя считать точкой">
			<rect class="pq-space" x="0" y="0" width="290" height="176" rx="6"></rect>
			{[52, 84, 116].map((y) => (
				<>
					<path class="pq-ray" d={`M14 ${y} H${f(E.x - Math.sqrt(E.r * E.r - (y - E.y) ** 2) - 12)}`} />
					<path class="pq-rayhead" d={`M${f(E.x - Math.sqrt(E.r * E.r - (y - E.y) ** 2) - 6)} ${y} l-8 -3.5 v7 Z`} />
				</>
			))}
			<text class="t-small" x="14" y="44">свет Солнца</text>
			<circle class="pq-globe" cx={E.x} cy={E.y} r={E.r}></circle>
			<g data-spin>
				<circle class="pq-lat" cx={E.x} cy={E.y} r="32.6"></circle>
				{[0, 1, 2, 3, 4, 5].map((i) => <path class="pq-mer" d={`M${E.x} ${E.y} L${f(E.x + E.r * Math.cos((i * Math.PI) / 3))} ${f(E.y - E.r * Math.sin((i * Math.PI) / 3))}`} />)}
			</g>
			<path class="pq-night" d={`M${E.x} ${E.y - E.r} A${E.r} ${E.r} 0 0 1 ${E.x} ${E.y + E.r} Z`}></path>
			<circle class="pq-pole" cx={E.x} cy={E.y} r="2.2"></circle>
			<circle class="pq-msk" r="4" data-msk></circle>
			<path class="pq-spinarrow" d={`M${PA(-0.5)} A${RA} ${RA} 0 0 0 ${PA(0.56)}`}></path>
			<path class="pq-spinhead" d={spinHead}></path>
			<text class="t-title" x="10" y="20">Сутки: день и ночь</text>
			<text class="t-small" x="10" y="150"><tspan class="pq-msktext">●</tspan> Москва: <tspan data-dn>день</tspan></text>
			<text class="t-title pq-no" x="10" y="168">Нельзя считать точкой</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Одно и то же тело в одной задаче можно считать точкой, а в другой нельзя. Въезд в гараж нарисован в масштабе и в реальном времени; поездка, год и сутки ускорены, Солнце нарисовано крупнее масштаба. Земля показана с Северного полюса.
	</figcaption>
</figure>

<style is:global>
	[data-ppairs] .pq-land {
		fill: color-mix(in oklab, var(--g7-green) 12%, var(--g7-paper));
	}
	[data-ppairs] .pq-road {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	[data-ppairs] .pq-town {
		fill: var(--sl-color-gray-3);
	}
	[data-ppairs] .pq-city {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	[data-ppairs] .pq-dot {
		fill: var(--g7-red);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	[data-ppairs] .pq-yes {
		fill: var(--g7-green) !important;
	}
	[data-ppairs] .pq-no {
		fill: var(--g7-red) !important;
	}
	[data-ppairs] .pq-sky {
		fill: var(--g7-sky);
	}
	[data-ppairs] .pq-ground {
		fill: var(--g7-ground);
	}
	[data-ppairs] .pq-inside {
		fill: color-mix(in oklab, var(--sl-color-gray-5) 70%, var(--g7-paper));
	}
	[data-ppairs] .pq-wall {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-ppairs] .pq-door {
		fill: var(--sl-color-gray-3);
	}
	[data-ppairs] .pq-gap {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.4;
	}
	[data-ppairs] .pq-gaptext {
		fill: var(--g7-gold) !important;
	}
	[data-ppairs] .pq-space {
		fill: color-mix(in oklab, var(--ig-vx) 7%, var(--g7-paper));
	}
	[data-ppairs] .pq-orbit {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.2;
		stroke-dasharray: 4 4;
	}
	[data-ppairs] .pq-sun {
		fill: var(--g7-gold);
	}
	[data-ppairs] .pq-earth {
		fill: var(--g7-blue);
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	[data-ppairs] .pq-ray {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.6;
	}
	[data-ppairs] .pq-rayhead {
		fill: var(--g7-gold);
	}
	[data-ppairs] .pq-globe {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--g7-paper));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	[data-ppairs] .pq-lat,
	[data-ppairs] .pq-mer {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-white) 45%, transparent);
		stroke-width: 0.9;
	}
	[data-ppairs] .pq-night {
		fill: color-mix(in oklab, black 55%, transparent);
	}
	[data-ppairs] .pq-pole {
		fill: var(--sl-color-gray-1);
	}
	[data-ppairs] .pq-msk {
		fill: var(--g7-red);
		stroke: var(--sl-color-white);
		stroke-width: 1.2;
	}
	[data-ppairs] .pq-msktext {
		fill: var(--g7-red);
	}
	[data-ppairs] .pq-spinarrow {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	[data-ppairs] .pq-spinhead {
		fill: var(--sl-color-gray-2);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { car } from '../ravnouskorennoe-dvizhenie/car';
	import { f1 } from './pd';

	const smooth = (u: number) => u * u * (3 - 2 * u);
	for (const fig of document.querySelectorAll<HTMLElement>('[data-ppairs]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		// 1. the trip: 8 s along the road, 1,5 s at the end
		const road = $<SVGPathElement>('[data-road]');
		const RL = road.getTotalLength();
		const dot = $<SVGCircleElement>('[data-mapcar]');
		// 2. the garage: 30 px per metre; in 6 s, wait 1,5 s, out 6 s, wait 1 s
		const K = 30;
		const GY = 128;
		const STOP = 268 - 0.5 * K;
		const START = STOP - 7.4 * K;
		const pose = car($<SVGGElement>('[data-garcar]'), K / 100, 'cr-gold');
		const gap = $<SVGGElement>('[data-gap]');
		// 3, 4. the orbit and the turning Earth: 12 s per turn, counterclockwise
		const orb = $<SVGCircleElement>('[data-orbearth]');
		const spin = $<SVGGElement>('[data-spin]');
		const msk = $<SVGCircleElement>('[data-msk]');
		const dn = $<SVGTSpanElement>('[data-dn]');
		const E = { x: 168, y: 84 };
		let t = 0;
		const draw = () => {
			const u = Math.min((t % 9.5) / 8, 1);
			const p = road.getPointAtLength(RL * u);
			dot.setAttribute('cx', f1(p.x));
			dot.setAttribute('cy', f1(p.y));
			const tg = t % 14.5;
			const w = tg < 6 ? smooth(tg / 6) : tg < 7.5 ? 1 : tg < 13.5 ? 1 - smooth((tg - 7.5) / 6) : 0;
			const x = START + (STOP - START) * w;
			pose(x, GY, ((x - START) / K) * 100, false);
			gap.style.visibility = tg >= 6 && tg < 7.5 ? 'visible' : 'hidden';
			const a = (2 * Math.PI * t) / 12;
			orb.setAttribute('cx', f1(130 + 50 * Math.cos(a)));
			orb.setAttribute('cy', f1(84 - 50 * Math.sin(a)));
			const b = a + 2.2; // Moscow starts on the day side
			spin.setAttribute('transform', `rotate(${f1((-b * 180) / Math.PI)} ${E.x} ${E.y})`);
			const mx = E.x + 32.6 * Math.cos(b);
			msk.setAttribute('cx', f1(mx));
			msk.setAttribute('cy', f1(E.y - 32.6 * Math.sin(b)));
			dn.textContent = mx < E.x ? 'день' : 'ночь';
		};
		draw();
		loop(fig, (dt) => {
			t += dt; // each panel takes its own phase from t (9,5 s, 14,5 s, 12 s), so t is never reset
			draw();
			return true;
		});
	}
</script>
