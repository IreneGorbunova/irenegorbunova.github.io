---
/**
 * Motion from rest (Galileo's inclined chute; animated, real time: 5 s of motion, 3 s of the end frame, loop). A
 * wooden chute 2,6 м long on trestles; a bronze ball released from rest rolls down with a = 0,20 м/с², s = 0,1t² м,
 * and passes small bells hung over the chute at 10, 40, 90, 160 and 250 см exactly at t = 1, 2, 3, 4, 5 с; each bell
 * swings and lights when passed. A seconds pendulum (period 2 с; its real length 99 см, drawn 3 times shorter) beats
 * every second at its turning points. Under the chute the distances of each second appear: 10, 30, 50, 70, 90 см, then
 * «1 : 3 : 5 : 7 : 9». For a solid ball rolling without slipping a = (5/7) g sin α, so sin α = 0,20 / 7,0 = 0,029,
 * α ≈ 1,6°. Scale 120 px per metre along the chute; the slope is drawn three times steeper (5°) and the ball (2 см)
 * four times larger (the caption says so).
 */
import PdStyles from './PdStyles.astro';
const A = (5 * Math.PI) / 180;
const S0 = { x: 26, y: 66 }; // the start of the ball's path (top of the chute), px
const K = 120;
const at = (m: number) => ({ x: S0.x + m * K * Math.cos(A), y: S0.y + m * K * Math.sin(A) });
const end = at(2.6);
const beg = at(-0.06);
const marks = [0.1, 0.4, 0.9, 1.6, 2.5];
const f = (v: number) => v.toFixed(1);
const legs = [0.25, 1.3, 2.2].map((m) => at(m)); // the last trestle clear of the label «250 см»
---

<PdStyles />
<figure class="g7 g7--pic pdm not-content" data-inclinepic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 214" role="img" aria-label="Длинный деревянный жёлоб с небольшим наклоном. Шар скатывается из покоя и каждую секунду проходит очередной колокольчик; за первую секунду он проходит 10 сантиметров, за вторую 30, за третью 50, за четвёртую 70, за пятую 90: как 1 : 3 : 5 : 7 : 9">
			<!-- the floor and the trestles -->
			<line class="ip-floor" x1="0" y1="150" x2="360" y2="150"></line>
			{legs.map((p) => <path class="ip-wood-dark" d={`M${f(p.x - 9)} 150 L${f(p.x - 2)} ${f(p.y + 8)} L${f(p.x + 2)} ${f(p.y + 8)} L${f(p.x + 9)} 150 L${f(p.x + 6)} 150 L${f(p.x)} ${f(p.y + 14)} L${f(p.x - 6)} 150 Z`} />)}
			<!-- the chute: a beam with a groove -->
			<path class="ip-wood" d={`M${f(beg.x)} ${f(beg.y + 5)} L${f(end.x)} ${f(end.y + 5)} L${f(end.x)} ${f(end.y + 13)} L${f(beg.x)} ${f(beg.y + 13)} Z`}></path>
			<path class="ip-groove" d={`M${f(beg.x)} ${f(beg.y + 5)} L${f(end.x)} ${f(end.y + 5)}`}></path>
			<path class="ip-grain" d={`M${f(beg.x + 20)} ${f(beg.y + 9.5)} L${f(end.x - 30)} ${f(end.y + 9.5)}`}></path>
			<!-- the bells on wires -->
			{marks.map((m, i) => {
				const p = at(m);
				return (
					<g data-bell={i}>
						<line class="ln" x1={f(p.x)} y1="12" x2={f(p.x)} y2={f(p.y - 14)} />
						<g class="ip-bell" transform={`translate(${f(p.x)} ${f(p.y - 14)})`}>
							<g data-swing>
								<path class="ip-bell-body" d="M-3.5 7 Q-3.5 0 0 0 Q3.5 0 3.5 7 Z" />
								<circle class="ip-bell-body" cx="0" cy="8" r="1.1" />
							</g>
						</g>
						<text class="t-small t-num" x={f(p.x)} y={f(p.y + 26)} text-anchor="middle">{Math.round(m * 100)} см</text>
					</g>
				);
			})}
			<line class="ip-wire" x1="0" y1="12" x2="360" y2="12"></line>
			<!-- the seconds pendulum, drawn 3 times shorter (40 px), at the left -->
			<g data-pend transform="translate(12 12)">
				<line class="ip-rod" x1="0" y1="0" x2="0" y2="0" data-rod></line>
				<circle class="ip-bob" r="4" data-bob></circle>
			</g>
			<circle class="ip-ball" data-ball r="4.8"></circle>
			<g data-lines></g>
			<text class="t-title" data-ratio x="180" y="207" text-anchor="middle" opacity="0">1 : 3 : 5 : 7 : 9</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Шар отпускают без толчка, маятник отбивает секунды. Колокольчики висят там, где шар оказывается через 1, 2, 3, 4 и 5 секунд. Наклон жёлоба нарисован втрое круче, шар вчетверо крупнее, а маятник втрое короче, чем в масштабе рисунка; время идёт как на самом деле.
	</figcaption>
</figure>

<style is:global>
	[data-inclinepic] .ip-floor {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	[data-inclinepic] .ip-wood {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	[data-inclinepic] .ip-wood-dark {
		fill: var(--g7-wood-dark);
	}
	[data-inclinepic] .ip-groove {
		stroke: var(--g7-wood-dark);
		stroke-width: 2.4;
	}
	[data-inclinepic] .ip-grain {
		stroke: var(--g7-wood-dark);
		stroke-width: 0.6;
		stroke-dasharray: 18 7 30 9;
	}
	[data-inclinepic] .ip-wire {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	[data-inclinepic] .ip-bell-body {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-3));
	}
	[data-inclinepic] .is-rung .ip-bell-body {
		fill: var(--ig-v);
		filter: drop-shadow(0 0 3px var(--ig-v));
	}
	[data-inclinepic] .ip-rod {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-inclinepic] .ip-bob,
	[data-inclinepic] .ip-ball {
		fill: color-mix(in oklab, var(--ig-v) 55%, hsl(25, 60%, 35%));
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { el, f1 } from './pd';

	for (const fig of document.querySelectorAll<HTMLElement>('[data-inclinepic]')) {
		const $ = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
		const A = (5 * Math.PI) / 180;
		const S0 = { x: 26, y: 66 };
		const K = 120;
		const at = (m: number) => ({ x: S0.x + m * K * Math.cos(A), y: S0.y + m * K * Math.sin(A) });
		const T = 5;
		const HOLD = 3;
		const LP = 40; // the seconds pendulum, px (3 times shorter than to scale)
		const AMP = 0.16; // rad
		const ball = $<SVGCircleElement>('[data-ball]');
		const rod = $<SVGLineElement>('[data-rod]');
		const bob = $<SVGCircleElement>('[data-bob]');
		const bells = [...fig.querySelectorAll<SVGGElement>('[data-bell]')];
		const lines = $<SVGGElement>('[data-lines]');
		const ratio = $<SVGTextElement>('[data-ratio]');
		const each = [10, 30, 50, 70, 90];
		const texts = each.map((cm, i) => {
			const tx = el('text', { class: 't-small', x: i < 3 ? 120 : 250, y: 166 + (i % 3) * 13, 'text-anchor': 'middle', opacity: 0 });
			tx.textContent = `за ${i + 1}-ю секунду — ${cm} см`;
			lines.append(tx);
			return tx;
		});
		let t = 0;
		const draw = () => {
			const tt = Math.min(t, T);
			const p = at(0.1 * tt * tt);
			// the ball lies in the groove: its center 4,8 px above the groove line, across the chute
			ball.setAttribute('cx', f1(p.x + 4.8 * Math.sin(A)));
			ball.setAttribute('cy', f1(p.y + 5 - 4.8 * Math.cos(A)));
			// the pendulum swings all the time: turning points at whole seconds
			const ph = AMP * Math.cos(Math.PI * t);
			rod.setAttribute('x2', f1(LP * Math.sin(ph)));
			rod.setAttribute('y2', f1(LP * Math.cos(ph)));
			bob.setAttribute('cx', f1(LP * Math.sin(ph)));
			bob.setAttribute('cy', f1(LP * Math.cos(ph)));
			bells.forEach((b, i) => {
				const since = tt - (i + 1);
				const rung = since >= -1e-6;
				b.classList.toggle('is-rung', rung && t <= T + HOLD);
				const sw = rung && since < 1.2 ? 22 * Math.exp(-2.5 * since) * Math.sin(10 * since) : 0;
				b.querySelector('[data-swing]')!.setAttribute('transform', `rotate(${f1(sw)})`);
				texts[i].setAttribute('opacity', rung ? '1' : '0');
			});
			ratio.setAttribute('opacity', tt >= T - 1e-6 ? '1' : '0');
		};
		draw();
		loop(fig, (dt) => {
			t += dt;
			if (t > T + HOLD) t = 0;
			draw();
			return true;
		});
	}
</script>
