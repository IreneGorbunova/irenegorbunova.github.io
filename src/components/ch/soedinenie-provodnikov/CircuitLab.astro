---
/**
 * Main model of the chapter: a source, an ammeter, a voltmeter and two or three lamps connected
 * in series, in parallel or mixed (lamp 1, then lamps 2 and 3 in parallel). Switching the circuit
 * moves the lamps and rewires them. Every lamp shows its voltage and current; its glow grows with
 * the power U·I (honest: equal power, equal glow). A lamp can be unscrewed by a click.
 * Free electrons (dots) drift against the current with a speed proportional to the current in that wire.
 */
import { L, lampPos } from './layout';

const uid = `spl-${Math.random().toString(36).slice(2, 8)}`;
const pos0 = lampPos('series', 3);
const cross = (r: number) => {
	const c = (r * Math.SQRT1_2).toFixed(2);
	return `M -${c} -${c} L ${c} ${c} M ${c} -${c} L -${c} ${c}`;
};
const R0 = [12, 12, 12];
---

<figure class="spl not-content" data-spl>
	<div class="spl__bar">
		<div class="spl__seg" role="radiogroup" aria-label="Способ соединения ламп">
			<button type="button" role="radio" aria-checked="true" class="is-on" data-mode="series">Последовательно</button>
			<button type="button" role="radio" aria-checked="false" data-mode="parallel">Параллельно</button>
			<button type="button" role="radio" aria-checked="false" data-mode="mixed">Смешанно</button>
		</div>
		<div class="spl__seg spl__seg--n" role="radiogroup" aria-label="Число ламп">
			<button type="button" role="radio" aria-checked="false" data-n="2">2 лампы</button>
			<button type="button" role="radio" aria-checked="true" class="is-on" data-n="3">3 лампы</button>
		</div>
	</div>

	<svg
		class="spl__circuit"
		viewBox={`0 0 ${L.W} ${L.H}`}
		role="img"
		aria-label="Электрическая цепь: источник тока, амперметр, вольтметр и лампы, соединённые выбранным способом"
	>
		<defs>
			<radialGradient id={`${uid}-glow`}>
				<stop offset="0" class="spl__g0"></stop>
				<stop offset="0.38" class="spl__g1"></stop>
				<stop offset="1" class="spl__g2"></stop>
			</radialGradient>
			<marker
				id={`${uid}-cur`}
				class="spl__curtip"
				viewBox="0 0 10 10"
				refX="7"
				refY="5"
				markerWidth="6"
				markerHeight="6"
				orient="auto"
			>
				<path d="M0,0 L10,5 L0,10 z"></path>
			</marker>
		</defs>

		<!-- fixed wires -->
		<g class="spl__wires">
			<path d={`M ${L.XBP} ${L.YB} H ${L.XL} V ${L.YM} H ${L.XN1}`}></path>
			<path d={`M ${L.XN2} ${L.YM} H ${L.XR} V ${L.YB} H ${L.XBN}`}></path>
			<path d={`M ${L.XVA} ${L.YB} V ${L.YV} H ${L.XVB} V ${L.YB}`}></path>
		</g>
		<circle class="spl__node" cx={L.XVA} cy={L.YB} r="4.5"></circle>
		<circle class="spl__node" cx={L.XVB} cy={L.YB} r="4.5"></circle>

		<!-- wires of the lamp region: rebuilt for every circuit -->
		<g class="spl__wires spl__region" data-region></g>
		<g class="spl__nodes" data-nodes></g>

		<!-- free electrons -->
		<g class="spl__dots" data-dots></g>

		<!-- direction of the current -->
		<line
			class="spl__current"
			x1={L.XL + 16}
			y1={300}
			x2={L.XL + 16}
			y2={244}
			marker-end={`url(#${uid}-cur)`}
			data-current></line>
		<text class="spl__current-name" x={L.XL + 28} y={280} data-current-name>I</text>

		<!-- source -->
		<g class="spl__source">
			<rect x={L.XBP - 6} y={L.YB - 26} width={L.XBN - L.XBP + 12} height="52" class="spl__source-bg"></rect>
			<line class="spl__plate spl__plate--plus" x1={L.XBP} y1={L.YB - 22} x2={L.XBP} y2={L.YB + 22}></line>
			<line class="spl__plate spl__plate--minus" x1={L.XBN} y1={L.YB - 11} x2={L.XBN} y2={L.YB + 11}></line>
			<text class="spl__sign" x={L.XBP - 14} y={L.YB + 40} text-anchor="middle">+</text>
			<text class="spl__sign" x={L.XBN + 14} y={L.YB + 40} text-anchor="middle">−</text>
		</g>

		<!-- ammeter -->
		<g class="spl__meter spl__meter--a">
			<circle class="spl__face" cx={L.XAM} cy={L.YB} r={L.RAM}></circle>
			<text class="spl__letter" x={L.XAM} y={L.YB + 6} text-anchor="middle">A</text>
		</g>
		<text class="spl__reading spl__reading--i" x={L.XAM} y={L.YB + 44} text-anchor="middle" data-read-i>0,167 А</text>

		<!-- voltmeter -->
		<g class="spl__meter spl__meter--v">
			<circle class="spl__face" cx={L.XVM} cy={L.YV} r={L.RVM}></circle>
			<text class="spl__letter" x={L.XVM} y={L.YV + 6} text-anchor="middle">V</text>
		</g>
		<text class="spl__reading spl__reading--u" x={L.XVB + 14} y={L.YV + 7} data-read-u>6 В</text>

		<!-- lamps -->
		<g data-lamps>
			{
				[0, 1, 2].map((k) => (
					<g class="spl__lamp" data-lamp={k} transform={`translate(${pos0[k][0]} ${pos0[k][1]})`}>
						<circle class="spl__halo" r="74" fill={`url(#${uid}-glow)`} opacity="0" data-halo />
						<circle class="spl__socket" r={L.RL} />
						<g class="spl__bulb">
							<circle class="spl__glass" r={L.RL} />
							<circle class="spl__heat" r={L.RL} opacity="0" data-heat />
							<path class="spl__cross" d={cross(L.RL)} />
							<path class="spl__cross spl__cross--hot" d={cross(L.RL)} opacity="0" data-hot />
						</g>
						<text class="spl__num" x="-27" y="-24" text-anchor="middle">
							{k + 1}
						</text>
						<circle
							class="spl__hit"
							r="32"
							tabindex="0"
							role="button"
							aria-label={`Лампа ${k + 1}: выкрутить или вкрутить`}
							data-hit
						/>
					</g>
				))
			}
		</g>
	</svg>

	<label class="spl__slider">
		<span>Напряжение источника <i>U</i></span>
		<output data-u-out>6 В</output>
		<input type="range" min="0" max="12" step="0.5" value="6" data-u />
	</label>

	<div class="spl__cards">
		{
			[0, 1, 2].map((k) => (
				<div class="spl__card" data-card={k}>
					<div class="spl__card-head">
						<span class="spl__ico" data-ico />
						<span class="spl__card-name">Лампа {k + 1}</span>
						<button type="button" class="spl__screw" data-screw>
							выкрутить
						</button>
					</div>
					<label class="spl__r">
						<span>
							<i>R</i>
							<sub>{k + 1}</sub>
						</span>
						<input type="range" min="6" max="30" step="1" value={R0[k]} data-r />
						<output data-r-out>{R0[k]} Ом</output>
					</label>
					<div class="spl__meters">
						<span class="spl__m spl__m--u">
							<span class="spl__msym">V</span>
							<span>
								<i>U</i>
								<sub>{k + 1}</sub>
								{' = '}
								<b data-uk>2 В</b>
							</span>
						</span>
						<span class="spl__m spl__m--i">
							<span class="spl__msym">A</span>
							<span>
								<i>I</i>
								<sub>{k + 1}</sub>
								{' = '}
								<b data-ik>0,167 А</b>
							</span>
						</span>
					</div>
				</div>
			))
		}
	</div>

	<div class="spl__formula" data-formula></div>
	<p class="spl__live" data-live aria-live="polite"></p>

	<figcaption class="spl__legend">
		<span class="spl__key-dot"></span>свободные электроны: движутся навстречу направлению тока <span class="spl__key-arrow"
		></span><i>I</i>. Чем больше сила тока в проводе, тем быстрее движутся точки (скорость показана условно). Нажмите на лампу,
		чтобы выкрутить её или вкрутить обратно. Яркость лампы растёт с произведением <i>UI</i> — мощностью тока. Сопротивление ламп
		считаем неизменным, приборы идеальными.
	</figcaption>
</figure>

<style is:global>
	.spl {
		--spl-u: var(--ig-vy);
		--spl-i: var(--ig-vx);
		--spl-r: var(--ig-v);
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.spl i,
	.spl__math {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	.spl__bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.spl__seg {
		display: inline-flex;
		flex-wrap: wrap;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		padding: 3px;
		gap: 2px;
	}
	.spl__seg button {
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.35rem 0.85rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background 0.25s,
			color 0.25s;
	}
	.spl__seg button:hover {
		color: var(--sl-color-white);
	}
	.spl__seg button.is-on {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.spl__seg button[disabled] {
		opacity: 0.35;
		cursor: not-allowed;
	}
	.spl__circuit {
		display: block;
		width: 100%;
		height: auto;
		user-select: none;
		-webkit-user-select: none;
	}
	.spl__wires path {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.spl__region {
		transition: opacity 0.2s;
	}
	.spl__region.is-fading,
	.spl__nodes.is-fading {
		opacity: 0;
	}
	.spl__region path.is-drawing {
		transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.spl__nodes {
		transition: opacity 0.3s;
	}
	.spl__node,
	.spl__nodes circle {
		fill: var(--sl-color-gray-2);
	}
	.spl__dots circle {
		fill: var(--spl-i);
	}
	.spl__current {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
		transition: opacity 0.3s;
	}
	.spl__curtip path {
		fill: var(--sl-color-gray-2);
	}
	.spl__current-name {
		fill: var(--sl-color-gray-2);
		font-family: var(--ig-font-math);
		font-style: italic;
		font-size: 19px;
		transition: opacity 0.3s;
	}
	.spl__source-bg {
		fill: var(--ig-surface);
	}
	.spl__plate {
		stroke: var(--sl-color-white);
	}
	.spl__plate--plus {
		stroke-width: 3;
	}
	.spl__plate--minus {
		stroke-width: 8;
	}
	.spl__sign {
		fill: var(--sl-color-gray-2);
		font-size: 20px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.spl__face {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
	}
	.spl__letter {
		fill: var(--sl-color-white);
		font-size: 17px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.spl__reading {
		font-size: 19px;
		font-weight: 700;
		font-family: var(--__sl-font);
		font-variant-numeric: tabular-nums;
	}
	.spl__reading--i {
		fill: var(--spl-i);
	}
	.spl__reading--u {
		fill: var(--spl-u);
	}
	.spl__g0 {
		stop-color: var(--ig-v);
		stop-opacity: 0.85;
	}
	.spl__g1 {
		stop-color: var(--ig-v);
		stop-opacity: 0.32;
	}
	.spl__g2 {
		stop-color: var(--ig-v);
		stop-opacity: 0;
	}
	.spl__halo {
		pointer-events: none;
	}
	.spl__lamp.is-hidden {
		pointer-events: none;
	}
	.spl__socket {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
		stroke-dasharray: 5 5;
	}
	.spl__bulb {
		transform-box: fill-box;
		transform-origin: 50% 50%;
		transition:
			transform 0.45s cubic-bezier(0.3, 0.7, 0.4, 1),
			opacity 0.45s;
	}
	.spl__lamp.is-out .spl__bulb {
		transform: translateY(-30px) rotate(-30deg);
		opacity: 0;
	}
	.spl__glass {
		fill: var(--ig-surface);
		stroke: var(--sl-color-white);
		stroke-width: 2.5;
	}
	.spl__heat {
		fill: var(--ig-v);
	}
	.spl__cross {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	.spl__cross--hot {
		stroke: var(--sl-color-black);
	}
	.spl__num {
		fill: var(--sl-color-gray-2);
		font-size: 16px;
		font-weight: 700;
		font-family: var(--__sl-font);
	}
	.spl__hit {
		fill: transparent;
		cursor: pointer;
		outline: none;
	}
	.spl__hit:focus-visible {
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		stroke-dasharray: 4 4;
	}

	/* controls */
	.spl__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.spl__slider output {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		color: var(--spl-u);
	}
	.spl__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--spl-u);
	}
	.spl__cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
		margin-top: 0.75rem;
	}
	.spl__cards.is-two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.spl__card {
		padding: 0.55rem 0.7rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		transition: opacity 0.3s;
	}
	.spl__card[hidden] {
		display: none;
	}
	.spl__card.is-out {
		border-style: dashed;
	}
	.spl__card-head {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.spl__card-name {
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.spl__ico {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
		border-radius: 50%;
		border: 1.5px solid var(--sl-color-gray-3);
		background: color-mix(in srgb, var(--ig-v) calc(var(--g, 0) * 100%), transparent);
		box-shadow: 0 0 calc(var(--g, 0) * 12px) color-mix(in srgb, var(--ig-v) calc(var(--g, 0) * 100%), transparent);
	}
	.spl__screw {
		margin-left: auto;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.spl__screw:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.spl__r {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.35rem;
	}
	.spl__r input {
		width: 100%;
		min-width: 0;
		accent-color: var(--spl-r);
	}
	.spl__r output {
		font-weight: 700;
		color: var(--spl-r);
		font-variant-numeric: tabular-nums;
		min-width: 3.6em;
		text-align: right;
	}
	.spl__meters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.9rem;
		margin-top: 0.3rem;
	}
	.spl__m {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.spl__m--u b {
		color: var(--spl-u);
	}
	.spl__m--i b {
		color: var(--spl-i);
	}
	.spl__msym {
		display: inline-grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 50%;
		border: 1.5px solid var(--sl-color-gray-3);
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.spl__formula {
		min-height: 6.5rem;
		margin: 0.75rem 0 0;
		padding: 0.3rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		display: grid;
		place-items: center;
		overflow-x: auto;
		text-align: center;
	}
	.spl__formula .katex-display {
		margin: 0.35rem 0;
		padding-inline: 4px;
	}
	.spl__formula .katex {
		font-size: 1.15em;
	}
	.spl__note {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.sp-u {
		color: var(--ig-vy);
	}
	.sp-i {
		color: var(--ig-vx);
	}
	.sp-r {
		color: var(--ig-v);
	}
	.spl__live {
		min-height: 1.5em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.spl__legend {
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
	.spl__key-dot {
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		margin: 0 0.35rem 0.1rem 0;
		border-radius: 50%;
		background: var(--spl-i);
		vertical-align: middle;
	}
	.spl__key-arrow {
		display: inline-block;
		width: 1.1rem;
		height: 2px;
		margin: 0 0.3rem 0.2rem 0.2rem;
		vertical-align: middle;
		background: var(--sl-color-gray-2);
		position: relative;
	}
	.spl__key-arrow::after {
		content: '';
		position: absolute;
		right: -2px;
		top: -4px;
		border: 5px solid transparent;
		border-left: 7px solid var(--sl-color-gray-2);
		border-right: 0;
	}
	@media (max-width: 50rem) {
		.spl__cards,
		.spl__cards.is-two {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 40rem) {
		.spl {
			padding: 0.75rem;
		}
		.spl__seg {
			border: 0;
			padding: 0;
			gap: 0.35rem;
		}
		.spl__seg button {
			padding: 0.3rem 0.75rem;
			border: 1px solid var(--sl-color-gray-4);
		}
		.spl__seg button.is-on {
			border-color: var(--sl-color-accent);
		}
		.spl__reading {
			font-size: 28px;
		}
		.spl__letter {
			font-size: 22px;
		}
		.spl__num {
			font-size: 24px;
		}
		.spl__sign {
			font-size: 28px;
		}
		.spl__current-name {
			font-size: 28px;
		}
		.spl__formula {
			padding-inline: 0.35rem;
		}
		.spl__formula .katex {
			font-size: 0.86em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.spl__bulb,
		.spl__region,
		.spl__nodes,
		.spl__region path.is-drawing {
			transition: none;
		}
	}
</style>

<script>
	import { L, lampPos, regionEdges, regionNodes, pathD, polyline, type Pt } from './layout';
	import { solve, num, tnum, isRounded, q, renderTex, type Mode, type Solution } from './sp';

	const SVG_NS = 'http://www.w3.org/2000/svg';
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const GAP = 16; // distance between neighbouring free electrons, px
	const SPEED = 40; // drift of the dots, px/s per ampere
	const JITTER = 1.1; // chaotic motion, px
	const PREF = 12; // power (W) at which the glow is full; brightness ∝ √(P/PREF)
	const MORPH = 0.75; // s

	type Wire = { line: ReturnType<typeof polyline>; cur: number; dots: SVGCircleElement[]; shift: number; drift: number };
	type Rest = { el: SVGCircleElement; x: number; y: number };

	const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

	for (const root of document.querySelectorAll<HTMLElement>('[data-spl]')) {
		const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const $$ = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel)];
		const regionG = $<SVGGElement>('[data-region]');
		const nodesG = $<SVGGElement>('[data-nodes]');
		const dotsG = $<SVGGElement>('[data-dots]');
		const readI = $<SVGTextElement>('[data-read-i]');
		const readU = $<SVGTextElement>('[data-read-u]');
		const curArrow = $<SVGLineElement>('[data-current]');
		const curName = $<SVGTextElement>('[data-current-name]');
		const uIn = $<HTMLInputElement>('[data-u]');
		const uOut = $<HTMLOutputElement>('[data-u-out]');
		const formula = $<HTMLElement>('[data-formula]');
		const live = $<HTMLElement>('[data-live]');
		const cardsBox = $<HTMLElement>('.spl__cards');
		const modeBtns = $$<HTMLButtonElement>('[data-mode]');
		const nBtns = $$<HTMLButtonElement>('[data-n]');
		const lamps = $$<SVGGElement>('[data-lamp]').map((g) => ({
			g,
			halo: g.querySelector<SVGCircleElement>('[data-halo]')!,
			heat: g.querySelector<SVGCircleElement>('[data-heat]')!,
			hot: g.querySelector<SVGPathElement>('[data-hot]')!,
			hit: g.querySelector<SVGCircleElement>('[data-hit]')!,
		}));
		const cards = $$<HTMLElement>('[data-card]').map((c) => ({
			c,
			r: c.querySelector<HTMLInputElement>('[data-r]')!,
			rOut: c.querySelector<HTMLOutputElement>('[data-r-out]')!,
			uk: c.querySelector<HTMLElement>('[data-uk]')!,
			ik: c.querySelector<HTMLElement>('[data-ik]')!,
			ico: c.querySelector<HTMLElement>('[data-ico]')!,
			screw: c.querySelector<HTMLButtonElement>('[data-screw]')!,
		}));

		// ---------- state ----------
		let mode: Mode = 'series';
		let n = 3;
		const on = [true, true, true];
		let rebuilding = false;
		const U = () => Number(uIn.value);
		const Rs = () => cards.slice(0, n).map((c) => Number(c.r.value));
		let sol: Solution = solve(mode, U(), Rs(), on.slice(0, n));
		const glow = [0, 0, 0]; // shown glow, follows the target smoothly

		// lamp positions: shown (x, y, alpha) and the morph between two layouts
		const pos = lampPos('series', 3).map((p) => ({ x: p[0], y: p[1], a: 1 }));
		let from = pos.map((p) => ({ ...p }));
		let to = pos.map((p) => ({ ...p }));
		let morphT = 1;
		const placeLamps = () =>
			lamps.forEach((l, k) => {
				l.g.setAttribute('transform', `translate(${pos[k].x.toFixed(2)} ${pos[k].y.toFixed(2)})`);
				l.g.style.opacity = pos[k].a.toFixed(3);
				l.g.classList.toggle('is-hidden', pos[k].a < 0.5);
			});

		// ---------- wires and electrons ----------
		const makeDot = () => {
			const el = document.createElementNS(SVG_NS, 'circle');
			el.setAttribute('r', '3.2');
			dotsG.append(el);
			return el;
		};
		const makeWire = (pts: Pt[], cur: number): Wire => {
			const line = polyline(pts);
			const count = Math.max(1, Math.round(line.total / GAP));
			return { line, cur, dots: Array.from({ length: count }, makeDot), shift: Math.random() * GAP, drift: 0 };
		};
		const mainWires: Wire[] = [
			makeWire(
				[
					[L.XBP, L.YB],
					[L.XL, L.YB],
					[L.XL, L.YM],
					[L.XN1, L.YM],
				],
				-1,
			),
			makeWire(
				[
					[L.XN2, L.YM],
					[L.XR, L.YM],
					[L.XR, L.YB],
					[L.XBN, L.YB],
				],
				-1,
			),
		];
		let regionWires: Wire[] = [];
		// electrons at rest in the voltmeter branch
		const rest: Rest[] = [];
		{
			const vPts: Pt[][] = [
				[
					[L.XVA, L.YB - GAP],
					[L.XVA, L.YV],
					[L.XVM - L.RVM - 4, L.YV],
				],
				[
					[L.XVM + L.RVM + 4, L.YV],
					[L.XVB, L.YV],
					[L.XVB, L.YB - GAP],
				],
			];
			for (const pts of vPts) {
				const p = polyline(pts);
				for (let s = 0; s <= p.total + 0.01; s += GAP) {
					const [x, y] = p.at(Math.min(s, p.total - 0.001));
					rest.push({ el: makeDot(), x, y });
				}
			}
		}
		const phases = new WeakMap<SVGCircleElement, [number, number, number, number]>();
		const phase = (el: SVGCircleElement) => {
			let ph = phases.get(el);
			if (!ph) {
				ph = [8 + Math.random() * 6, 8 + Math.random() * 6, Math.random() * 6.3, Math.random() * 6.3];
				phases.set(el, ph);
			}
			return ph;
		};
		const hidden = (x: number, y: number) => {
			if (Math.hypot(x - L.XAM, y - L.YB) < L.RAM + 2) return true;
			if (x > L.XBP - 4 && x < L.XBN + 4 && Math.abs(y - L.YB) < 6) return true;
			for (let k = 0; k < 3; k++) if (pos[k].a > 0.05 && Math.hypot(x - pos[k].x, y - pos[k].y) < L.RL + 1) return true;
			return false;
		};
		const currentOf = (w: Wire) => (rebuilding ? 0 : w.cur < 0 ? sol.I : sol.Ik[w.cur] ?? 0);
		const drawDots = (t: number, dt: number) => {
			const j = reduceMotion.matches ? 0 : JITTER;
			for (const w of [...mainWires, ...regionWires]) {
				const goal = SPEED * currentOf(w);
				w.drift += (goal - w.drift) * Math.min(1, dt / 0.08);
				if (!reduceMotion.matches) w.shift -= w.drift * dt; // electrons move against the current
				const gap = w.line.total / w.dots.length;
				w.dots.forEach((el, k) => {
					const [x, y] = w.line.at(k * gap + w.shift);
					const ph = phase(el);
					el.setAttribute('cx', (x + j * Math.sin(ph[0] * t + ph[2])).toFixed(2));
					el.setAttribute('cy', (y + j * Math.sin(ph[1] * t + ph[3])).toFixed(2));
					el.setAttribute('opacity', hidden(x, y) ? '0' : '1');
				});
			}
			for (const r of rest) {
				const ph = phase(r.el);
				r.el.setAttribute('cx', (r.x + j * Math.sin(ph[0] * t + ph[2])).toFixed(2));
				r.el.setAttribute('cy', (r.y + j * Math.sin(ph[1] * t + ph[3])).toFixed(2));
			}
		};

		const buildRegion = (animate: boolean) => {
			regionWires.forEach((w) => w.dots.forEach((d) => d.remove()));
			regionG.replaceChildren();
			nodesG.replaceChildren();
			const edges = regionEdges(mode, n);
			regionWires = edges.map((e) => makeWire(e.pts, e.cur));
			const paths = edges.map((e) => {
				const p = document.createElementNS(SVG_NS, 'path');
				p.setAttribute('d', pathD(e.pts));
				regionG.append(p);
				return p;
			});
			for (const [x, y] of regionNodes(mode)) {
				const c = document.createElementNS(SVG_NS, 'circle');
				c.setAttribute('cx', String(x));
				c.setAttribute('cy', String(y));
				c.setAttribute('r', '4.5');
				nodesG.append(c);
			}
			regionG.classList.remove('is-fading');
			nodesG.classList.remove('is-fading');
			if (animate && !reduceMotion.matches) {
				// the wires are "drawn in" from the entrance node
				for (const p of paths) {
					const len = p.getTotalLength();
					p.style.strokeDasharray = String(len);
					p.style.strokeDashoffset = String(len);
					p.getBoundingClientRect();
					p.classList.add('is-drawing');
					requestAnimationFrame(() => (p.style.strokeDashoffset = '0'));
				}
			}
		};

		// ---------- readings and formula ----------
		const unit = (v: number, u: string) => `${num(v)} ${u}`;
		const eq = (v: number) => (isRounded(v) ? '\\approx' : '=');
		const V = (v: number) => `${tnum(v)}~\\text{В}`;
		const A = (v: number) => `${tnum(v)}~\\text{А}`;
		const OM = (v: number) => `${tnum(v)}~\\text{Ом}`;
		const sub = (s: string, k: number) => `${s}_${k + 1}`;
		const note = (html: string) => {
			formula.innerHTML = `<p class="spl__note">${html}</p>`;
		};

		const showFormula = () => {
			const u = U();
			const R = Rs();
			const idx = R.map((_, k) => k);
			const inn = idx.filter((k) => on[k]);
			if (rebuilding) return note('Собираем цепь заново…');
			const rU = q('u', 'U');
			const rI = q('i', 'I');
			const rR = q('r', 'R');
			if (mode === 'series') {
				if (inn.length < n)
					return note(
						'Цепь разорвана: <span class="nw"><i>I</i> = 0</span>. Погасли все лампы — ток идёт по одному пути, и этот путь прерван.',
					);
				const Rt = sol.R;
				const lines = [
					`${rR} &= ${idx.map((k) => sub('R', k)).join(' + ')} = ${R.join(' + ')} = ${q('r', OM(Rt))},`,
					`${rI} &= \\dfrac{U}{R} = \\dfrac{${V(u)}}{${OM(Rt)}} ${eq(sol.I)} ${q('i', A(sol.I))},`,
					`${rU} &= ${idx.map((k) => sub('U', k)).join(' + ')} ${idx.some((k) => isRounded(sol.Uk[k]!)) ? '\\approx' : '='} ${idx.map((k) => tnum(sol.Uk[k]!)).join(' + ')} = ${q('u', V(u))}.`,
				];
				return renderTex(formula, `\\begin{aligned}${lines.join('\\\\')}\\end{aligned}`);
			}
			if (mode === 'parallel') {
				if (!inn.length) return note('Все лампы выкручены: <span class="nw"><i>I</i> = 0</span>.');
				const lines = [
					`${rI} &= ${inn.map((k) => sub('I', k)).join(' + ')} ${inn.some((k) => isRounded(sol.Ik[k])) ? '\\approx' : '='} ${inn.map((k) => tnum(sol.Ik[k])).join(' + ')} ${eq(sol.I)} ${q('i', A(sol.I))},`,
					u > 0
						? `${rR} &= \\dfrac{U}{I} ${isRounded(sol.I) ? '\\approx' : '='} \\dfrac{${V(u)}}{${A(sol.I)}} ${eq(sol.R)} ${q('r', OM(sol.R))}.`
						: `${rR} &${eq(sol.R)} ${q('r', OM(sol.R))}.`,
				];
				const tail =
					inn.length > 1
						? `<p class="spl__note">Общее сопротивление меньше самого маленького из сопротивлений ламп.</p>`
						: '';
				renderTex(formula, `\\begin{aligned}${lines.join('\\\\')}\\end{aligned}`);
				if (tail) formula.insertAdjacentHTML('beforeend', tail);
				return;
			}
			// mixed
			if (!on[0] || (!on[1] && !on[2]))
				return note(
					!on[0]
						? 'Лампа 1 стоит там, где цепь не разветвляется: через неё идёт весь ток. Без неё цепь разорвана, <span class="nw"><i>I</i> = 0</span>.'
						: 'Обе лампы разветвления выкручены — цепь разорвана, <span class="nw"><i>I</i> = 0</span>.',
				);
			let lines: string[];
			if (on[1] && on[2]) {
				const R23 = (R[1] * R[2]) / (R[1] + R[2]);
				lines = [
					`R_{23} &= \\dfrac{R_2 R_3}{R_2 + R_3} = \\dfrac{${R[1]} \\cdot ${R[2]}}{${R[1]} + ${R[2]}} ${eq(R23)} ${OM(R23)},`,
					`${rR} &= R_1 + R_{23} ${isRounded(R23) ? '\\approx' : '='} ${R[0]} + ${tnum(R23)} ${eq(sol.R)} ${q('r', OM(sol.R))},`,
				];
			} else {
				const k = on[1] ? 1 : 2;
				lines = [`${rR} &= R_1 + ${sub('R', k)} = ${R[0]} + ${R[k]} = ${q('r', OM(sol.R))},`];
			}
			lines.push(
				`${rI} &= \\dfrac{U}{R} ${isRounded(sol.R) ? '\\approx' : '='} \\dfrac{${V(u)}}{${OM(sol.R)}} ${eq(sol.I)} ${q('i', A(sol.I))}.`,
			);
			renderTex(formula, `\\begin{aligned}${lines.join('\\\\')}\\end{aligned}`);
		};

		const showReadings = () => {
			const u = U();
			uOut.value = `${num(u)} В`;
			const I = rebuilding ? 0 : sol.I;
			readI.textContent = unit(I, 'А');
			readU.textContent = unit(u, 'В');
			curArrow.style.opacity = I > 0 ? '1' : '0';
			curName.style.opacity = I > 0 ? '1' : '0';
			cards.forEach((c, k) => {
				c.c.hidden = k >= n;
				c.rOut.value = `${c.r.value} Ом`;
				c.c.classList.toggle('is-out', !on[k]);
				c.screw.textContent = on[k] ? 'выкрутить' : 'вкрутить';
				if (k >= n) return;
				const uk = rebuilding ? null : sol.Uk[k];
				c.uk.textContent = uk === null || uk === undefined ? '—' : unit(uk, 'В');
				c.ik.textContent = rebuilding ? '—' : unit(sol.Ik[k], 'А');
			});
			cardsBox.classList.toggle('is-two', n === 2);
			showFormula();
		};

		const recompute = () => {
			sol = solve(mode, U(), Rs(), on.slice(0, n));
			showReadings();
			wake();
		};

		// ---------- switching the circuit ----------
		const syncButtons = () => {
			modeBtns.forEach((b) => {
				const onBtn = b.dataset.mode === mode;
				b.classList.toggle('is-on', onBtn);
				b.setAttribute('aria-checked', String(onBtn));
				if (b.dataset.mode === 'mixed') b.disabled = n === 2;
			});
			nBtns.forEach((b) => {
				const onBtn = Number(b.dataset.n) === n;
				b.classList.toggle('is-on', onBtn);
				b.setAttribute('aria-checked', String(onBtn));
			});
		};
		const targets = () => {
			const p = lampPos(mode, n);
			return [0, 1, 2].map((k) =>
				k < n ? { x: p[k][0], y: p[k][1], a: 1 } : { x: pos[k].x, y: pos[k].y, a: 0 },
			);
		};
		const rewire = (message: string) => {
			syncButtons();
			from = pos.map((p) => ({ ...p }));
			to = targets();
			if (reduceMotion.matches) {
				to.forEach((t, k) => Object.assign(pos[k], t));
				placeLamps();
				morphT = 1;
				rebuilding = false;
				buildRegion(false);
			} else {
				rebuilding = true;
				morphT = 0;
				regionG.classList.add('is-fading');
				nodesG.classList.add('is-fading');
				regionWires.forEach((w) => w.dots.forEach((d) => d.remove()));
				regionWires = [];
			}
			live.textContent = message;
			recompute();
		};
		const finishMorph = () => {
			rebuilding = false;
			buildRegion(true);
			recompute();
		};

		const modeText: Record<Mode, string> = {
			series: 'Последовательно: лампы стоят одна за другой, ток через них один и тот же.',
			parallel: 'Параллельно: каждая лампа подключена к одним и тем же двум узлам — напряжение на всех одинаковое.',
			mixed: 'Смешанно: лампа 1 стоит последовательно, а лампы 2 и 3 — параллельно друг другу.',
		};
		modeBtns.forEach((b) =>
			b.addEventListener('click', () => {
				const m = b.dataset.mode as Mode;
				if (m === mode || b.disabled) return;
				mode = m;
				rewire(modeText[m]);
			}),
		);
		nBtns.forEach((b) =>
			b.addEventListener('click', () => {
				const v = Number(b.dataset.n);
				if (v === n) return;
				n = v;
				if (n === 3) on[2] = true;
				if (n === 2 && mode === 'mixed') mode = 'series';
				rewire(n === 2 ? 'Теперь в цепи две лампы.' : 'Добавили третью лампу.');
			}),
		);

		const toggleLamp = (k: number) => {
			if (k >= n) return;
			on[k] = !on[k];
			lamps[k].g.classList.toggle('is-out', !on[k]);
			recompute();
			const name = `Лампа ${k + 1}`;
			if (on[k]) {
				live.textContent = `${name} снова в цепи.`;
				return;
			}
			if (mode === 'series')
				live.textContent = `${name} выкручена — цепь разорвана, погасли все лампы. На пустом патроне вольтметр показал бы всё напряжение источника.`;
			else if (mode === 'parallel')
				live.textContent = `${name} выкручена — разорвана только её ветвь. Остальные лампы горят как прежде, а ток источника уменьшился.`;
			else if (k === 0) live.textContent = `${name} выкручена — через неё шёл весь ток, поэтому погасли все лампы.`;
			else
				live.textContent = `${name} выкручена — оставшиеся лампы теперь соединены последовательно. Сравните их яркость с прежней.`;
		};
		lamps.forEach((l, k) => {
			l.hit.addEventListener('click', () => toggleLamp(k));
			l.hit.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					toggleLamp(k);
				}
			});
		});
		cards.forEach((c, k) => {
			c.screw.addEventListener('click', () => toggleLamp(k));
			c.r.addEventListener('input', recompute);
		});
		uIn.addEventListener('input', recompute);

		// ---------- animation loop (runs only while the model is on screen) ----------
		let raf = 0;
		let last = 0;
		let visible = true;
		const frame = (now: number) => {
			const dt = Math.min((now - (last || now)) / 1000, 1 / 20);
			last = now;
			const t = now / 1000;
			if (morphT < 1) {
				morphT = Math.min(1, morphT + dt / MORPH);
				const e = ease(morphT);
				pos.forEach((p, k) => {
					p.x = from[k].x + (to[k].x - from[k].x) * e;
					p.y = from[k].y + (to[k].y - from[k].y) * e;
					p.a = from[k].a + (to[k].a - from[k].a) * e;
				});
				placeLamps();
				if (morphT >= 1) finishMorph();
			}
			let glowing = false;
			lamps.forEach((l, k) => {
				const P = !rebuilding && k < n ? (sol.Uk[k] ?? 0) * sol.Ik[k] : 0;
				const goal = Math.min(1, Math.sqrt(Math.max(P, 0) / PREF));
				glow[k] += (goal - glow[k]) * (reduceMotion.matches ? 1 : Math.min(1, dt / 0.12));
				if (Math.abs(goal - glow[k]) > 0.002) glowing = true;
				const g = glow[k];
				l.halo.setAttribute('opacity', Math.min(1, 1.3 * g).toFixed(3));
				l.halo.setAttribute('r', (40 + 46 * g).toFixed(1));
				l.heat.setAttribute('opacity', Math.min(0.95, g * 2).toFixed(3));
				l.hot.setAttribute('opacity', Math.min(1, g * 2).toFixed(3));
				cards[k].ico.style.setProperty('--g', g.toFixed(3));
			});
			drawDots(t, dt);
			const idle = reduceMotion.matches && morphT >= 1 && !glowing;
			if (visible && !idle) raf = requestAnimationFrame(frame);
			else raf = 0;
		};
		const wake = () => {
			if (!raf && visible) {
				last = 0;
				raf = requestAnimationFrame(frame);
			}
		};
		new IntersectionObserver((entries) => {
			visible = entries.some((e) => e.isIntersecting);
			if (visible) wake();
		}).observe(root);

		placeLamps();
		buildRegion(false);
		syncButtons();
		recompute();
		live.textContent = 'Переключайте способ соединения, меняйте напряжение и сопротивления, выкручивайте лампы.';
		drawDots(0, 0);
	}
</script>
