---
/**
 * Two short looping opening scenes of «Последовательное и параллельное соединение проводников». No numbers in the
 * pictures; the captions' popovers explain.
 * Garland: an old fir-tree garland, one wire with the bulbs one after another, plugged into a wall socket. One bulb's
 *   filament fails: the current through the whole chain flickers, so ALL the bulbs flicker together (they share one
 *   current), then all go dark at once. A ring marks the culprit.
 * Flat: a room with a ceiling lamp, a TV and a table lamp. The wall switch flips, the ceiling lamp goes out; the TV
 *   (its picture keeps moving) and the table lamp work on as before: each device is a branch of its own.
 * Plays only while visible.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

type P = [number, number];
/** A point of the quadratic Bezier a → c → b at t. */
const qb = (a: P, c: P, b: P, t: number): P => [
	(1 - t) ** 2 * a[0] + 2 * t * (1 - t) * c[0] + t * t * b[0],
	(1 - t) ** 2 * a[1] + 2 * t * (1 - t) * c[1] + t * t * b[1],
];
// The garland: three swags across the tree joined along its edges, then down to the floor and to the socket.
const SWAGS: { a: P; c: P; b: P; ts: number[] }[] = [
	{ a: [152, 68], c: [181, 88], b: [210, 70], ts: [0.25, 0.5, 0.75] },
	{ a: [226, 114], c: [180, 136], b: [134, 116], ts: [0.14, 0.38, 0.62, 0.86] },
	{ a: [118, 168], c: [180, 194], b: [242, 170], ts: [0.1, 0.3, 0.5, 0.7, 0.9] },
];
const q = (s: { a: P; c: P; b: P }) => `${s.a[0]} ${s.a[1]} Q ${s.c[0]} ${s.c[1]} ${s.b[0]} ${s.b[1]}`;
const GARLAND =
	`M ${q(SWAGS[0])} L ${SWAGS[1].a[0]} ${SWAGS[1].a[1]} Q ${SWAGS[1].c[0]} ${SWAGS[1].c[1]} ${SWAGS[1].b[0]} ${SWAGS[1].b[1]}` +
	` L ${SWAGS[2].a[0]} ${SWAGS[2].a[1]} Q ${SWAGS[2].c[0]} ${SWAGS[2].c[1]} ${SWAGS[2].b[0]} ${SWAGS[2].b[1]}` +
	` Q 254 198 272 203 L 304 203 Q 318 203 318 186`;
const COLORS = ['var(--ig-v)', 'var(--ig-vy)', 'var(--ig-vx)', 'var(--sd-green)'];
const BULBS = SWAGS.flatMap((s) => s.ts.map((t) => qb(s.a, s.c, s.b, t)));
const BAD = 5; // the bulb whose filament fails
const f1 = (v: number) => v.toFixed(1);
---

<IntroFrame data-sdintro>
	<div class="intro__card" data-scene="garland">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Ёлка с гирляндой из разноцветных лампочек, соединённых одним проводом, вилка в розетке. Одна лампочка мигает и перегорает — и сразу гаснут все лампочки гирлянды. Перегоревшая лампочка обведена кружком">
			<rect class="sd-wall" x="0" y="0" width="360" height="240"></rect>
			<rect class="sd-floor" x="0" y="206" width="360" height="34"></rect>
			<!-- the socket on the wall -->
			<rect class="sd-socket" x="306" y="160" width="24" height="26" rx="4"></rect>
			<rect class="sd-plug" x="311" y="170" width="14" height="16" rx="3"></rect>
			<!-- the tree -->
			<rect class="sd-trunk" x="172" y="190" width="16" height="16"></rect>
			<path class="sd-tree" d="M 180 96 L 266 194 Q 180 202 94 194 Z"></path>
			<path class="sd-tree" d="M 180 52 L 244 136 Q 180 144 116 136 Z"></path>
			<path class="sd-tree" d="M 180 20 L 224 84 Q 180 90 136 84 Z"></path>
			<path class="sd-star" d="M 180 6 L 183.5 14 L 192 14.6 L 185.5 20 L 187.6 28.4 L 180 24 L 172.4 28.4 L 174.5 20 L 168 14.6 L 176.5 14 Z"></path>
			<!-- the garland: one wire through all the bulbs -->
			<path class="sd-gwire" d={GARLAND}></path>
			{
				BULBS.map(([x, y], k) => (
					<g class="sd-bulb" data-bulb={k} style={`--c: ${COLORS[k % COLORS.length]}`}>
						<circle class="sd-bulb__halo" cx={f1(x)} cy={f1(y + 6.5)} r="11" />
						<rect class="sd-bulb__cap" x={f1(x - 2)} y={f1(y - 1)} width="4" height="3.5" rx="0.8" />
						<ellipse class="sd-bulb__glass" cx={f1(x)} cy={f1(y + 6.5)} rx="3.7" ry="5" />
					</g>
				))
			}
			<circle class="sd-ring" cx={f1(BULBS[BAD][0])} cy={f1(BULBS[BAD][1] + 5.5)} r="12" data-ring></circle>
		</svg>
		<div class="intro__foot">
			<p>В старой ёлочной гирлянде перегорела одна лампочка&nbsp;— и <More term="сразу погасли все остальные">Лампочки такой гирлянды соединены одна за другой — <b>последовательно</b>. У тока только один путь: через все лампочки по очереди. Перегоревшая нить разорвала этот путь, и ток прекратился во всей гирлянде. Подробнее — в разделе <a href="#последовательное-соединение">«Последовательное соединение»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="flat">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Комната: люстра под потолком, телевизор и настольная лампа. Выключатель на стене щёлкает, и люстра гаснет, а телевизор и настольная лампа продолжают работать">
			<rect class="sd-room" x="0" y="0" width="360" height="240"></rect>
			<rect class="sd-floor" x="0" y="204" width="360" height="36"></rect>
			<!-- light of the chandelier -->
			<path class="sd-cone" d="M 80 50 L 140 50 L 204 204 L 16 204 Z" data-cone></path>
			<!-- the chandelier: a rod, a curved arm and three small shades -->
			<line class="sd-cord" x1="110" y1="0" x2="110" y2="34"></line>
			<path class="sd-arm" d="M 84 36 Q 110 46 136 36"></path>
			{
				[84, 110, 136].map((x) => (
					<g>
						<circle class="sd-lampbulb" cx={x} cy={x === 110 ? 53 : 49} r="4" data-cbulb />
						<path class="sd-shade" d={`M ${x - 6} ${x === 110 ? 40 : 36} H ${x + 6} L ${x + 11} ${x === 110 ? 51 : 47} H ${x - 11} Z`} />
					</g>
				))
			}
			<!-- the wall switch -->
			<rect class="sd-switch" x="26" y="100" width="18" height="24" rx="3"></rect>
			<rect class="sd-rocker" x="30" y="104" width="10" height="8" rx="1.5" data-rocker></rect>
			<circle class="sd-ring" cx="35" cy="112" r="17" data-sring></circle>
			<!-- the TV on its stand -->
			<rect class="sd-stand" x="168" y="170" width="96" height="34" rx="3"></rect>
			<rect class="sd-tv" x="176" y="112" width="80" height="54" rx="4"></rect>
			<rect class="sd-tvleg" x="210" y="166" width="12" height="4"></rect>
			<svg x="181" y="117" width="70" height="44" viewBox="0 0 70 44" overflow="hidden">
				<rect class="sd-sky" x="0" y="0" width="70" height="44"></rect>
				<rect class="sd-field" x="0" y="26" width="70" height="18"></rect>
				<line class="sd-goal" x1="62" y1="16" x2="62" y2="30"></line>
				<line class="sd-goal" x1="62" y1="16" x2="68" y2="18"></line>
				<circle class="sd-ball" cx="20" cy="30" r="3" data-ball></circle>
			</svg>
			<!-- the table lamp on a little table -->
			<rect class="sd-table" x="290" y="158" width="56" height="5" rx="1.5"></rect>
			<line class="sd-tableleg" x1="296" y1="163" x2="296" y2="204"></line>
			<line class="sd-tableleg" x1="340" y1="163" x2="340" y2="204"></line>
			<path class="sd-tlight" d="M 308 124 L 328 124 L 342 158 L 294 158 Z"></path>
			<rect class="sd-tbase" x="310" y="152" width="16" height="6" rx="2"></rect>
			<line class="sd-tstem" x1="318" y1="152" x2="318" y2="124"></line>
			<circle class="sd-tbulb" cx="318" cy="124" r="4"></circle>
			<path class="sd-tshade" d="M 310 104 H 326 L 334 124 H 302 Z"></path>
		</svg>
		<div class="intro__foot">
			<p>Дома выключили люстру, а телевизор и настольная лампа <More term="работают как прежде">Все приборы в квартире подключены к сети <b>параллельно</b>: у каждого своя ветвь, и на каждом одно и то же напряжение сети. Выключатель разрывает только ветвь своей люстры, а другие ветви остаются замкнутыми. Подробнее — в разделе <a href="#параллельное-соединение">«Параллельное соединение»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-sdintro] {
		--sd-wall: color-mix(in srgb, var(--ig-vx) 12%, var(--sl-color-gray-6, #17181c));
		--sd-room: color-mix(in srgb, var(--ig-v) 8%, var(--sl-color-gray-5));
		--sd-green: var(--sl-color-green, #3fb950);
		--sd-tree: color-mix(in oklab, var(--sl-color-green, #3fb950) 42%, var(--sl-color-gray-5));
		--sd-plastic: var(--sl-color-gray-1);
		--sd-off: var(--sl-color-gray-4);
	}
	:root[data-theme='light'] [data-sdintro] {
		--sd-wall: color-mix(in srgb, var(--ig-vx) 10%, var(--sl-color-gray-6));
		--sd-room: color-mix(in srgb, var(--ig-v) 8%, var(--sl-color-gray-6));
		--sd-tree: color-mix(in oklab, var(--sl-color-green, #3fb950) 60%, var(--sl-color-gray-3));
		--sd-plastic: var(--sl-color-gray-7, #fff);
		--sd-off: var(--sl-color-gray-5);
	}
	.sd-wall {
		fill: var(--sd-wall);
	}
	.sd-room {
		fill: var(--sd-room);
	}
	.sd-floor {
		fill: color-mix(in srgb, var(--ig-v) 22%, var(--sl-color-gray-5));
	}
	.sd-socket {
		fill: var(--sd-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.sd-plug {
		fill: var(--sd-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.sd-trunk {
		fill: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-4));
	}
	.sd-tree {
		fill: var(--sd-tree);
		stroke: color-mix(in oklab, var(--sd-tree) 70%, var(--sl-color-black));
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.sd-star {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.6;
	}
	.sd-gwire {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
		opacity: 0.85;
	}
	.sd-bulb__halo {
		fill: var(--c);
		opacity: calc(0.35 * var(--on, 1));
	}
	.sd-bulb__cap {
		fill: var(--sl-color-gray-3);
	}
	.sd-bulb__glass {
		fill: color-mix(in oklab, var(--c) calc(100% * var(--on, 1)), var(--sd-off));
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.5;
	}
	.sd-ring {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2.4;
		stroke-dasharray: 3.5 2.5;
		opacity: 0;
	}
	/* the room */
	.sd-cone {
		fill: var(--ig-v);
		opacity: 0.16;
	}
	.sd-arm {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	.sd-cord {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.sd-shade,
	.sd-tshade {
		fill: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-3));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.sd-lampbulb,
	.sd-tbulb {
		fill: var(--ig-v);
	}
	.sd-switch {
		fill: var(--sd-plastic);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.sd-rocker {
		fill: var(--sl-color-gray-3);
	}
	.sd-stand {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.sd-tv {
		fill: var(--sl-color-gray-6, #222);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	.sd-tvleg {
		fill: var(--sl-color-gray-3);
	}
	.sd-sky {
		fill: color-mix(in srgb, var(--ig-vx) 55%, var(--sl-color-white));
	}
	.sd-field {
		fill: color-mix(in oklab, var(--sl-color-green, #3fb950) 75%, var(--sl-color-black));
	}
	.sd-goal {
		stroke: #fff;
		stroke-width: 1.2;
	}
	.sd-ball {
		fill: #fff;
		stroke: #333;
		stroke-width: 0.6;
	}
	.sd-table {
		fill: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-4));
	}
	.sd-tableleg {
		stroke: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-4));
		stroke-width: 3;
	}
	.sd-tlight {
		fill: var(--ig-v);
		opacity: 0.2;
	}
	.sd-tbase {
		fill: var(--sl-color-gray-3);
	}
	.sd-tstem {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-sdintro]')) {
		// Garland: lit; the failing filament makes the whole chain flicker (0,3 → 0,44), then all go dark; the ring
		// marks the burnt bulb from 0,55; 5 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="garland"]')!;
			const bulbs = [...card.querySelectorAll<SVGGElement>('[data-bulb]')];
			const ring = card.querySelector<SVGCircleElement>('[data-ring]')!;
			// one common current: every bulb gets the same brightness
			const FLICK = [1, 0.35, 1, 0.15, 0.9, 0, 0.7, 0.05, 0.5, 0];
			scene(card, 5, (x) => {
				let on = 1;
				if (x >= 0.44) on = 0;
				else if (x >= 0.3) on = FLICK[Math.min(FLICK.length - 1, Math.floor(((x - 0.3) / 0.14) * FLICK.length))];
				for (const b of bulbs) b.style.setProperty('--on', on.toFixed(2));
				const r = smooth(0.55, 0.62, x);
				ring.style.opacity = r.toFixed(2);
				const s = 1 + 0.12 * Math.sin(Math.PI * 2 * clamp((x - 0.62) / 0.19)) * r;
				const cx = ring.cx.baseVal.value;
				const cy = ring.cy.baseVal.value;
				ring.setAttribute('transform', `translate(${cx} ${cy}) scale(${s.toFixed(3)}) translate(${-cx} ${-cy})`);
			});
		}

		// Flat: the switch is marked (0,15 → 0,3), flips at 0,34; the ceiling lamp goes out; the TV and the table
		// lamp keep working (the TV's picture moves all the time); 5 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="flat"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const cone = $<SVGPathElement>('[data-cone]');
			const cbulbs = card.querySelectorAll<SVGCircleElement>('[data-cbulb]');
			const rocker = $<SVGRectElement>('[data-rocker]');
			const sring = $<SVGCircleElement>('[data-sring]');
			const ball = $<SVGCircleElement>('[data-ball]');
			scene(card, 5, (x) => {
				const off = x >= 0.34;
				rocker.setAttribute('y', off ? '112' : '104');
				const glow = 1 - smooth(0.34, 0.37, x);
				cone.style.opacity = (0.16 * glow).toFixed(3);
				for (const b of cbulbs) b.style.fill = off ? 'var(--sd-off)' : '';
				sring.style.opacity = (smooth(0.15, 0.22, x) * (1 - smooth(0.4, 0.5, x))).toFixed(2);
				// the TV shows a ball rolling to the goal and back, whatever the scene does
				const t = performance.now() / 1000;
				const u = (t % 3) / 3;
				const bx = 8 + 52 * (u < 0.5 ? u * 2 : 2 - u * 2);
				const by = 30 - 9 * Math.abs(Math.sin(Math.PI * 4 * u));
				ball.setAttribute('cx', bx.toFixed(1));
				ball.setAttribute('cy', by.toFixed(1));
			});
		}
	}
</script>
