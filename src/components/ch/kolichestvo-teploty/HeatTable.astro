---
/**
 * Table of specific heat capacities as bars (rounded school-table values, Дж/(кг·°C)).
 * Pick a substance, set the mass and the two temperatures — the formula Q = cm(t₂ − t₁) updates live.
 */
const ROWS: [string, string, number][] = [
	['Вода', 'воды', 4200],
	['Спирт', 'спирта', 2500],
	['Лёд', 'льда', 2100],
	['Керосин', 'керосина', 2100],
	['Подсолнечное масло', 'подсолнечного масла', 1700],
	['Воздух', 'воздуха', 1000],
	['Алюминий', 'алюминия', 920],
	['Кирпич', 'кирпича', 880],
	['Стекло', 'стекла', 840],
	['Песок (сухой)', 'сухого песка', 830],
	['Чугун', 'чугуна', 540],
	['Сталь', 'стали', 500],
	['Железо', 'железа', 460],
	['Медь', 'меди', 400],
	['Латунь', 'латуни', 400],
	['Цинк', 'цинка', 400],
	['Серебро', 'серебра', 250],
	['Олово', 'олова', 230],
	['Свинец', 'свинца', 140],
	['Золото', 'золота', 130],
];
---

<figure class="kttab not-content" data-kttab>
	<p class="kttab__head">Удельная теплоёмкость <i>c</i>, Дж/(кг·°C)</p>
	<div class="kttab__list" role="radiogroup" aria-label="Выберите вещество">
		{
			ROWS.map(([name, gen, c], i) => (
				<button type="button" class="kttab__row" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-name={name} data-gen={gen} data-c={c}>
					<span class="kttab__name">{name}</span>
					<span class="kttab__track">
						<span class="kttab__bar" style={`width: ${(100 * c) / 4200}%`} />
					</span>
					<span class="kttab__val">{c}</span>
				</button>
			))
		}
	</div>
	<p class="kttab__say" data-say aria-live="polite"></p>

	<div class="kttab__calc">
		<label class="kttab__slider">
			<span>Масса <i>m</i></span>
			<output data-out="m"></output>
			<input type="range" min="0.1" max="5" step="0.1" value="1" data-in="m" />
		</label>
		<label class="kttab__slider">
			<span>Начальная температура <i>t</i><sub>1</sub></span>
			<output data-out="t1"></output>
			<input type="range" min="-20" max="100" step="1" value="20" data-in="t1" />
		</label>
		<label class="kttab__slider">
			<span>Конечная температура <i>t</i><sub>2</sub></span>
			<output data-out="t2"></output>
			<input type="range" min="-20" max="100" step="1" value="30" data-in="t2" />
		</label>
	</div>
	<div class="kttab__math" data-math></div>
	<p class="kttab__note" data-note></p>
	<figcaption class="kttab__caption">
		Округлённые табличные значения. Нажмите на вещество, затем двигайте ползунки. Температуры можно менять только в тех пределах, где вещество не плавится и не кипит.
	</figcaption>
</figure>

<style is:global>
	.kttab {
		margin-block: 1.5rem 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.kttab i {
		font-family: var(--ig-font-math);
	}
	.kttab__head {
		margin: 0 0 0.5rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.kttab__list {
		display: grid;
		gap: 0.15rem;
	}
	.kttab__row {
		margin: 0;
		display: grid;
		grid-template-columns: minmax(6.5rem, 11rem) 1fr 3rem;
		align-items: center;
		gap: 0.6rem;
		padding: 0.15rem 0.4rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid transparent;
		border-radius: 0.5rem;
		cursor: pointer;
		text-align: left;
	}
	.kttab__row:hover {
		border-color: var(--sl-color-gray-4);
	}
	.kttab__row[aria-checked='true'] {
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
		color: var(--sl-color-white);
	}
	.kttab__track {
		height: 0.7rem;
		border-radius: 0.35rem;
		background: var(--sl-color-gray-6);
		overflow: hidden;
	}
	.kttab__bar {
		display: block;
		height: 100%;
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--ig-vx) 75%, transparent);
	}
	.kttab__row[aria-checked='true'] .kttab__bar {
		background: var(--sl-color-accent);
	}
	.kttab__val {
		text-align: right;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}
	.kttab__say {
		min-height: 3em;
		margin: 0.6rem 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	.kttab__calc {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.6rem 1.25rem;
	}
	.kttab__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.2rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.kttab__slider output {
		font-weight: 700;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.kttab__slider input {
		grid-column: 1 / -1;
		width: 100%;
		accent-color: var(--sl-color-accent);
	}
	.kttab__math {
		margin-top: 0.5rem;
		padding: 0.1rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		overflow-x: auto;
		overflow-y: hidden;
		min-height: 3.5rem;
	}
	.kttab__note {
		min-height: 1.5em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	.kttab .kt-q { color: var(--ig-v); }
	.kttab .kt-c { color: var(--ig-vx); }
	.kttab__caption {
		margin-top: 0.3rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.kttab {
			padding: 0.75rem;
		}
		.kttab__row {
			grid-template-columns: 7.2rem 1fr 2.6rem;
			gap: 0.4rem;
			font-size: var(--sl-text-xs);
		}
		.kttab__calc {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { ru, texInt, htmlInt, q, renderTex, DEG } from './kt';

	for (const root of document.querySelectorAll<HTMLElement>('[data-kttab]')) {
		const rows = Array.from(root.querySelectorAll<HTMLButtonElement>('.kttab__row'));
		const say = root.querySelector<HTMLElement>('[data-say]')!;
		const math = root.querySelector<HTMLElement>('[data-math]')!;
		const note = root.querySelector<HTMLElement>('[data-note]')!;
		const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
		const out = (k: string) => root.querySelector<HTMLOutputElement>(`[data-out="${k}"]`)!;
		let cur = rows[0];
		// keep the substance in its state: water liquid, ice solid, alcohol below its boiling point (78 °C)
		const RANGE: Record<string, [number, number]> = { Вода: [0, 100], Лёд: [-20, 0], Спирт: [-20, 78] };
		const limits = () => {
			const [lo, hi] = RANGE[cur.dataset.name!] ?? [-20, 100];
			for (const k of ['t1', 't2']) {
				const i = inp(k);
				i.min = String(lo);
				i.max = String(hi);
				i.value = String(Math.min(hi, Math.max(lo, Number(i.value))));
			}
		};

		const draw = () => {
			const c = Number(cur.dataset.c);
			const gen = cur.dataset.gen!;
			const m = Number(inp('m').value);
			const t1 = Number(inp('t1').value);
			const t2 = Number(inp('t2').value);
			out('m').value = `${ru(m, 1)} кг`;
			out('t1').value = `${t1} °C`;
			out('t2').value = `${t2} °C`;
			const ratio = 4200 / c;
			say.innerHTML =
				c === 4200
					? `Чтобы нагреть 1 кг воды на 1 °C, нужно передать ей 4200 Дж. Остывая на 1 °C, 1 кг воды отдаёт столько же — 4200 Дж. Это больше, чем у любого другого вещества в таблице.`
					: `Чтобы нагреть 1 кг ${gen} на 1 °C, нужно ${c} Дж — в ${ru(ratio, 1)} раза меньше, чем для воды. Остывая на 1 °C, 1 кг ${gen} отдаёт тоже ${c} Дж.`;
			const dt = t2 - t1;
			const Q = c * m * dt;
			const mT = ru(m, 1).replace(',', '{,}');
			const paren = (v: number) => (v < 0 ? `(${v})` : String(v));
			const narrow = root.clientWidth < 560;
			renderTex(
				math,
				`${narrow ? '\\begin{aligned}' : ''}${q('q', 'Q')} ${narrow ? '&' : ''}= ${q('c', 'c')}\\,m\\,(t_2 - t_1) = ${narrow ? '\\\\ &= ' : ''}${q('c', String(c))} \\cdot ${mT} \\cdot (${t2} - ${paren(t1)}) = ${q('q', `${Q < 0 ? '-' : ''}${texInt(Math.abs(Q))}~\\text{Дж}`)}${narrow ? '\\end{aligned}' : ''}`,
			);
			note.innerHTML =
				dt > 0
					? `Тело нагревается на ${dt} °C и <b>получает</b> ${htmlInt(Q)} Дж${Q >= 10000 ? ` = ${ru(Q / 1000, 1)} кДж` : ''}.`
					: dt < 0
						? `Тело остывает на ${-dt} °C и <b>отдаёт</b> ${htmlInt(-Q)} Дж${-Q >= 10000 ? ` = ${ru(-Q / 1000, 1)} кДж` : ''}. Знак «минус» и означает, что теплота отдана.`
						: 'Температура не меняется — теплота не передаётся: <i>Q</i> = 0.';
		};
		rows.forEach((r) =>
			r.addEventListener('click', () => {
				cur = r;
				rows.forEach((o) => o.setAttribute('aria-checked', String(o === r)));
				limits();
				draw();
			}),
		);
		['m', 't1', 't2'].forEach((k) => inp(k).addEventListener('input', draw));
		limits();
		draw();
	}
</script>
