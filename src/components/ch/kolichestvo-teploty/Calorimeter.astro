---
/**
 * The school calorimeter: a numbered cross-section with a legend.
 */
const LEGEND = [
	'термометр;',
	'наружный стакан из пластмассы;',
	'внутренний стакан из алюминия — в него наливают воду;',
	'вода;',
	'воздух между стаканами — он плохо проводит тепло, поэтому вода почти не обменивается теплом с комнатой;',
	'нагретое тело на нитке, которое опускают в воду;',
	'подставка из материала, который плохо проводит тепло: стаканы почти не касаются друг друга.',
];
// callout points (x, y) on the drawing, in the order of LEGEND (top to bottom, so the leader lines do not cross)
const PTS: [number, number][] = [
	[306, 80],
	[425, 100],
	[394, 130],
	[365, 200],
	[406, 240],
	[370, 290],
	[328, 365],
];
const LX = 470; // x of the number badges
const LY = [60, 110, 160, 210, 260, 310, 360];
---

<figure class="cal not-content">
	<svg class="cal__svg" viewBox="0 0 560 420" role="img" aria-label="Устройство калориметра в разрезе: внутренний алюминиевый стакан с водой стоит на подставке внутри наружного стакана, между ними воздух; в воде термометр и нагретое тело на нитке">
		<!-- outer vessel -->
		<path class="cal__outer" d="M 108 80 V 372 Q 108 392 128 392 H 412 Q 432 392 432 372 V 80 H 418 V 370 Q 418 378 410 378 H 130 Q 122 378 122 370 V 80 Z"></path>
		<!-- air gap -->
		<rect class="cal__air" x="122" y="80" width="296" height="298"></rect>
		<!-- stand -->
		<rect class="cal__stand" x="212" y="352" width="116" height="26" rx="4"></rect>
		<!-- inner cup with water -->
		<rect class="cal__water" x="152" y="176" width="236" height="170"></rect>
		<path class="cal__inner" d="M 146 96 V 346 Q 146 352 152 352 H 388 Q 394 352 394 346 V 96" fill="none"></path>
		<path class="cal__surface" d="M 152 176 H 388"></path>
		<!-- body on a thread -->
		<line class="cal__thread" x1="350" y1="20" x2="350" y2="262"></line>
		<rect class="cal__body" x="330" y="262" width="40" height="56" rx="4"></rect>
		<!-- thermometer -->
		<rect class="cal__thermo" x="294" y="18" width="12" height="270" rx="6"></rect>
		<rect class="cal__thermo-col" x="297" y="150" width="6" height="140" rx="3"></rect>
		<circle class="cal__thermo-bulb" cx="300" cy="294" r="10"></circle>
		<!-- callouts -->
		{
			PTS.map(([x, y], i) => (
				<g class="cal__call">
					<line x1={x} y1={y} x2={LX - 16} y2={LY[i]} />
					<circle cx={x} cy={y} r="3.5" />
					<circle class="cal__badge" cx={LX} cy={LY[i]} r="15" />
					<text x={LX} y={LY[i] + 6} text-anchor="middle">
						{i + 1}
					</text>
				</g>
			))
		}
	</svg>
	<ol class="cal__legend">
		{LEGEND.map((t) => <li>{t}</li>)}
	</ol>
</figure>

<style is:global>
	.cal {
		margin-block: 2rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.cal__svg {
		display: block;
		width: 100%;
		max-width: 34rem;
		height: auto;
		margin-inline: auto;
	}
	.cal__outer {
		fill: color-mix(in srgb, var(--ig-v) 70%, var(--sl-color-gray-4));
	}
	.cal__air {
		fill: color-mix(in srgb, var(--ig-vx) 8%, transparent);
	}
	.cal__stand {
		fill: color-mix(in srgb, var(--ig-v) 35%, var(--sl-color-gray-3));
	}
	.cal__water {
		fill: color-mix(in srgb, var(--ig-vx) 35%, transparent);
	}
	.cal__inner {
		stroke: var(--sl-color-gray-2);
		stroke-width: 6;
	}
	.cal__surface {
		stroke: var(--ig-vx);
		stroke-width: 2;
	}
	.cal__thread {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.cal__body {
		fill: color-mix(in srgb, var(--ig-vy) 55%, var(--sl-color-gray-3));
	}
	.cal__thermo {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.cal__thermo-col,
	.cal__thermo-bulb {
		fill: var(--ig-vy);
	}
	.cal__call line {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	.cal__call circle {
		fill: var(--sl-color-gray-1);
	}
	.cal__call .cal__badge {
		fill: var(--sl-color-accent);
	}
	.cal__call text {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-black);
	}
	.cal__legend {
		margin: 0.75rem 0 0;
		padding-left: 1.5rem;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}
	@media (max-width: 40rem) {
		.cal {
			padding: 0.75rem;
		}
		.cal__call text {
			font-size: 20px;
		}
	}
</style>
