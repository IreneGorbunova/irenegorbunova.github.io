---
/**
 * Two short looping opening scenes.
 * Beach: the sun heats sand and sea alike over 8:00 → 14:00 (6 s); sand 25 → 55 °C, sea 22 → 24 °C.
 * Kitchen: two identical burners; an empty steel pan reaches 200 °C in about 1 min, a pot of water boils
 * at 10 min (10 min in 8 s). Plays only while visible; with reduced motion shows the final state.
 */
// Thermometers of the beach: 0 °C at y = 190, 60 °C at y = 112 (1,3 px per °C).
const bt = (t: number) => 190 - 1.3 * t;
const flames = [-26, -13, 0, 13, 26];
const flame = (x: number) => `M ${x} 171 q -5 -6 0 -15 q 5 9 0 15 z`;
import IntroFrame from '@components/intro/IntroFrame.astro';
---

<IntroFrame data-ktintro>
	<div class="intro__card" data-scene="beach">
			<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Пляж: солнце одинаково светит на песок и на море; к двум часам дня песок нагрелся до 55 °C, а море только до 24 °C">
				<rect class="bc__sky" x="0" y="0" width="360" height="152" />
				<g class="bc__clock">
					<circle cx="22" cy="22" r="9" />
					<path d="M22 16 V22 L26 25" data-hand />
					<text x="37" y="28" data-clock>8:00</text>
				</g>
				<g class="bc__sun" data-sun>
					<circle r="15" />
					{Array.from({ length: 8 }, (_, i) => (
						<line x1="20" y1="0" x2="27" y2="0" transform={`rotate(${i * 45})`} />
					))}
				</g>
				<!-- sand and sea -->
				<path class="bc__sea" d="M168 150 H360 V240 H200 Q180 200 168 150 Z" />
				<g class="bc__waves">
					<path d="M200 170 q 10 -5 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0" />
					<path d="M210 196 q 10 -5 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0" />
					<path d="M222 222 q 10 -5 20 0 t 20 0 t 20 0 t 20 0 t 20 0 t 20 0" />
				</g>
				<path class="bc__sand" d="M0 150 H168 Q180 200 200 240 H0 Z" data-sand />
				<g class="bc__dots">
					{[[20, 170], [48, 190], [130, 175], [30, 220], [150, 215], [70, 228], [118, 200], [160, 185], [10, 200]].map(([x, y]) => (
						<circle cx={x} cy={y} r="1.6" />
					))}
				</g>
				<!-- heat shimmer over the sand -->
				<g class="bc__shim" data-shim>
					{[56, 128].map((x, i) => (
						<path style={`--d:${i * 0.7}s`} d={`M ${x} 146 q -5 -8 0 -16 q 5 -8 0 -16 q -5 -8 0 -16`} />
					))}
				</g>
				<!-- sunlight arrows (directions set by the script) -->
				<g class="bc__rays" data-rays>
					{[28, 156, 222, 336].map((x) => (
						<line data-ray={x} x1={x} y1="105" x2={x} y2="145" marker-end="url(#ktintro-arrow)" />
					))}
				</g>
				<defs>
					<marker id="ktintro-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
						<path class="bc__head" d="M 0 0 L 10 5 L 0 10 z" />
					</marker>
				</defs>
				<!-- thermometers -->
				{[92, 278].map((x, i) => (
					<g class="bc__thermo">
						<rect class="kti__tube" x={x - 3} y="104" width="6" height="88" rx="3" />
						{[0, 20, 40, 60].map((t) => (
							<line class="kti__tick" x1={x - 8} x2={x - 3} y1={bt(t)} y2={bt(t)} />
						))}
						<rect class="kti__col" x={x - 1.4} y={bt(25)} width="2.8" height="40" data-col={i} />
						<circle class="kti__col" cx={x} cy="194" r="5" />
						<rect class="kti__pill" x={x - 29} y="208" width="58" height="24" rx="12" />
						<text class="kti__read" x={x} y="225" text-anchor="middle" data-read={i}>25 °C</text>
					</g>
				))}
			</svg>
			<div class="intro__foot">
				<p>Солнце греет песок и море одинаково, а песок раскаляется, вода остаётся прохладной.</p>
				<button type="button" class="intro__again" data-again>Повторить</button>
			</div>
		</div>

	<div class="intro__card" data-scene="kitchen">
			<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Кухня: на двух одинаковых конфорках пустая сковорода за минуту нагревается до 200 °C, а кастрюля с водой закипает примерно через 10 минут">
				<rect class="kc__wall" x="0" y="0" width="360" height="240" />
				<g class="bc__clock">
					<circle cx="160" cy="26" r="9" />
					<path d="M157 14 h6 M160 17 V26" data-hand />
					<text x="175" y="32" data-clock>0:00</text>
				</g>
				<!-- stove with the readings on its front -->
				<rect class="kc__hob" x="8" y="171" width="344" height="20" rx="6" />
				<rect class="kc__front" x="20" y="191" width="320" height="49" />
				{[95, 265].map((x, i) => (
					<g>
						<rect class="kti__pill" x={x - 34} y="203" width="68" height="24" rx="12" />
						<text class="kti__read" x={x} y="220" text-anchor="middle" data-read={i}>20 °C</text>
					</g>
				))}
				{[95, 265].map((x) => (
					<g class="kc__flames">
						{flames.map((dx, j) => (
							<path style={`--d:${(j * 0.13).toFixed(2)}s`} d={flame(x + dx)} />
						))}
					</g>
				))}
				<!-- pan -->
				<g data-pan>
					<rect class="kc__handle" x="6" y="139" width="48" height="7" rx="3.5" />
					<path class="kc__pan" d="M50 136 H140 L134 154 Q133 156 130 156 H60 Q57 156 56 154 Z" data-panbody />
				</g>
				<g class="bc__shim" data-panshim>
					{[78, 112].map((x, i) => (
						<path style={`--d:${i * 0.6}s`} d={`M ${x} 128 q -4 -7 0 -14 q 4 -7 0 -14 q -4 -7 0 -14`} />
					))}
				</g>
				<!-- pot with water -->
				<rect class="kc__water" x="223" y="102" width="84" height="52" data-potwater />
				<g data-bubbles></g>
				<path class="kc__pot" d="M220 92 V151 Q220 156 225 156 H305 Q310 156 310 151 V92" />
				<path class="kc__ear" d="M220 104 h-9 M310 104 h9" />
				<g class="kc__steam" data-steam>
					{[-24, 0, 24].map((dx, i) => (
						<path style={`--d:${i * 0.5}s`} d={`M ${265 + dx} 90 q -6 -7 0 -14 q 6 -7 0 -14`} />
					))}
				</g>
			</svg>
			<div class="intro__foot">
				<p>Пустая сковорода раскаляется за минуту, а кастрюля с водой закипает минут через десять.</p>
				<button type="button" class="intro__again" data-again>Повторить</button>
			</div>
		</div>
</IntroFrame>

<style is:global>
	/* shared bits */
	.bc__clock circle {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	.bc__clock path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.bc__clock text {
		font-size: 17px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.kti__tube {
		fill: color-mix(in srgb, var(--sl-color-gray-1) 25%, var(--ig-surface));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	.kti__tick {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	.kti__col {
		fill: var(--sl-color-red);
	}
	.kti__pill {
		fill: var(--ig-surface);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
	}
	.kti__read {
		font-size: 16px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.bc__shim path {
		fill: none;
		stroke: var(--ig-vy);
		stroke-width: 2;
		stroke-linecap: round;
		opacity: 0;
		animation: ktintro-shim 1.4s ease-in infinite;
		animation-delay: var(--d);
	}
	@keyframes ktintro-shim {
		0% { opacity: 0; transform: translateY(4px); }
		40% { opacity: calc(0.75 * var(--heat, 0)); }
		100% { opacity: 0; transform: translateY(-10px); }
	}
	/* beach */
	.bc__sky {
		fill: color-mix(in srgb, var(--ig-vx) 16%, transparent);
	}
	.bc__sun circle {
		fill: var(--ig-v);
	}
	.bc__sun line {
		stroke: var(--ig-v);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.bc__sea {
		fill: color-mix(in srgb, var(--ig-vx) 50%, transparent);
	}
	.bc__waves path {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-white) 55%, transparent);
		stroke-width: 1.5;
		stroke-linecap: round;
		animation: ktintro-wave 3s ease-in-out infinite alternate;
	}
	.bc__waves path:nth-child(2) {
		animation-delay: -1s;
	}
	.bc__waves path:nth-child(3) {
		animation-delay: -2s;
	}
	@keyframes ktintro-wave {
		to { transform: translateX(-12px); }
	}
	.bc__sand {
		fill: color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-5));
	}
	.bc__dots circle {
		fill: color-mix(in srgb, var(--ig-v) 40%, var(--sl-color-gray-3));
	}
	.bc__rays line {
		stroke: var(--ig-v);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 6 5;
		animation: ktintro-flow 0.8s linear infinite;
	}
	.bc__head {
		fill: var(--ig-v);
	}
	@keyframes ktintro-flow {
		to { stroke-dashoffset: -11; }
	}
	/* kitchen */
	.kc__wall {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}
	.kc__hob {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-4);
	}
	.kc__front {
		fill: color-mix(in srgb, var(--sl-color-gray-5) 80%, var(--ig-surface));
	}
	.kc__flames path {
		fill: var(--ig-vx);
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: ktintro-flame 0.45s ease-in-out infinite alternate;
		animation-delay: var(--d);
	}
	@keyframes ktintro-flame {
		from { transform: scaleY(0.8); }
		to { transform: scaleY(1.1); }
	}
	.kc__handle {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-3);
	}
	.kc__pan {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
	}
	.kc__pot {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.kc__ear {
		stroke: var(--sl-color-gray-2);
		stroke-width: 4;
		stroke-linecap: round;
	}
	.kc__bubble {
		fill: none;
		stroke: color-mix(in srgb, var(--sl-color-white) 80%, transparent);
		stroke-width: 1.2;
	}
	.kc__steam path {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.5;
		stroke-linecap: round;
		opacity: 0;
		animation: ktintro-steam 1.6s ease-in infinite;
		animation-delay: var(--d);
	}
	@keyframes ktintro-steam {
		0% { opacity: 0; transform: translateY(2px); }
		30% { opacity: calc(0.8 * var(--steam, 0)); }
		100% { opacity: 0; transform: translateY(-12px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.bc__shim path,
		.bc__waves path,
		.bc__rays line,
		.kc__flames path,
		.kc__steam path {
			animation: none;
		}
		.bc__shim path {
			opacity: calc(0.6 * var(--heat, 0));
		}
		.kc__steam path {
			opacity: calc(0.7 * var(--steam, 0));
		}
	}
</style>

<script>
	import { tempColor } from './kt';
	import { scene, clamp, reduce } from '@components/intro/scene';

	const NS = 'http://www.w3.org/2000/svg';

	for (const root of document.querySelectorAll<HTMLElement>('[data-ktintro]')) {
		// Beach: 8:00 → 14:00 in 6 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="beach"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const sun = $<SVGGElement>('[data-sun]');
			const clock = $<SVGTextElement>('[data-clock]');
			const hand = $<SVGPathElement>('[data-hand]');
			const sand = $<SVGPathElement>('[data-sand]');
			const shim = $<SVGGElement>('[data-shim]');
			const rays = Array.from(card.querySelectorAll<SVGLineElement>('[data-ray]'));
			const cols = [0, 1].map((i) => $<SVGRectElement>(`[data-col="${i}"]`));
			const reads = [0, 1].map((i) => $<SVGTextElement>(`[data-read="${i}"]`));
			const by = (t: number) => 190 - 1.3 * t;
			scene(card, 6, (x) => {
				const h = 8 + 6 * x;
				const a = (Math.PI * (h - 6)) / 12;
				const sx = 180 - 150 * Math.cos(a);
				const sy = 140 - 105 * Math.sin(a);
				sun.setAttribute('transform', `translate(${sx.toFixed(1)} ${sy.toFixed(1)})`);
				// arrows along the sunlight, ending at the surface
				for (const r of rays) {
					const x2 = Number(r.dataset.ray);
					const dx = x2 - sx;
					const dy = 145 - sy;
					const k = 38 / Math.hypot(dx, dy);
					r.setAttribute('x1', (x2 - dx * k).toFixed(1));
					r.setAttribute('y1', (145 - dy * k).toFixed(1));
				}
				const hh = Math.floor(h);
				const mm = Math.floor((h - hh) * 60);
				clock.textContent = `${hh}:${String(mm).padStart(2, '0')}`;
				const ang = ((h % 12) / 12) * 2 * Math.PI;
				hand.setAttribute('d', `M22 22 L${(22 + 6 * Math.sin(ang)).toFixed(1)} ${(22 - 6 * Math.cos(ang)).toFixed(1)}`);
				const ts = 25 + 30 * (1 - (1 - x) ** 1.4);
				const tw = 22 + 2 * x;
				[ts, tw].forEach((t, i) => {
					cols[i].setAttribute('y', String(by(t)));
					cols[i].setAttribute('height', String(194 - by(t)));
					reads[i].textContent = `${Math.round(t)} °C`;
				});
				const heat = clamp((ts - 30) / 25);
				shim.style.setProperty('--heat', heat.toFixed(2));
				sand.style.fill = `color-mix(in srgb, var(--ig-vy) ${Math.round(28 * heat)}%, color-mix(in srgb, var(--ig-v) 45%, var(--sl-color-gray-5)))`;
			});
		}

		// Kitchen: 0 → 10 min in 8 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="kitchen"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const clock = $<SVGTextElement>('[data-clock]');
			const hand = $<SVGPathElement>('[data-hand]');
			const reads = [0, 1].map((i) => $<SVGTextElement>(`[data-read="${i}"]`));
			const panBody = $<SVGPathElement>('[data-panbody]');
			const panShim = $<SVGGElement>('[data-panshim]');
			const potWater = $<SVGRectElement>('[data-potwater]');
			const steam = $<SVGGElement>('[data-steam]');
			const bubG = $<SVGGElement>('[data-bubbles]');
			const bubbles = Array.from({ length: 12 }, (_, i) => {
				const c = document.createElementNS(NS, 'circle');
				c.setAttribute('class', 'kc__bubble');
				bubG.append(c);
				return { c, x: 230 + ((i * 37) % 70), ph: (i * 0.618) % 1, r: 1.6 + ((i * 7) % 3) * 0.6, v: 0.8 + ((i * 5) % 4) * 0.15 };
			});
			scene(card, 8, (x) => {
				const s = 600 * x; // simulated seconds
				const m = Math.floor(s / 60);
				const sec = Math.floor(s % 60);
				clock.textContent = `${m}:${String(sec).padStart(2, '0')}`;
				const ang = (s / 60) * 2 * Math.PI;
				hand.setAttribute('d', `M160 26 L${(160 + 6 * Math.sin(ang)).toFixed(1)} ${(26 - 6 * Math.cos(ang)).toFixed(1)}`);
				const tp = s >= 60 ? 200 : 20 + 180 * (1 - (1 - s / 60) ** 2);
				const tw = Math.min(100, 20 + (80 * s) / 600);
				reads[0].textContent = `${Math.round(tp)} °C`;
				reads[1].textContent = `${Math.round(tw)} °C`;
				const hp = clamp((tp - 20) / 180);
				panBody.style.fill = `color-mix(in srgb, var(--ig-vy) ${Math.round(18 * hp)}%, var(--sl-color-gray-4))`;
				panShim.style.setProperty('--heat', hp.toFixed(2));
				potWater.style.fill = `color-mix(in srgb, ${tempColor(0.45 * tw)} 50%, transparent)`;
				const boil = clamp((tw - 70) / 30);
				steam.style.setProperty('--steam', clamp((tw - 85) / 15).toFixed(2));
				const still = reduce();
				for (const b of bubbles) {
					const f = still ? b.ph : (b.ph + (performance.now() / 1000) * b.v) % 1;
					b.c.setAttribute('cx', String(b.x + 2 * Math.sin(f * 9 + b.ph * 6)));
					b.c.setAttribute('cy', (150 - f * 44).toFixed(1));
					b.c.setAttribute('r', String(b.r * (0.6 + 0.4 * f)));
					b.c.style.opacity = (boil * (f < 0.9 ? 1 : (1 - f) * 10)).toFixed(2);
				}
			});
		}
	}
</script>
