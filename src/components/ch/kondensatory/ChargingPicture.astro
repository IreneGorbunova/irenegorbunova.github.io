---
/**
 * How a source charges a capacitor (a loop of 9 s, slowed: a real capacitor in such a circuit charges in micro- to
 * milliseconds; the caption says so). A flat capacitor (plates seen in section), a source of 4,5 В and a switch.
 * 0,8 s: the switch closes; the free electrons of the wires (blue dots) drift: they leave the plate joined to «+» of the
 * source, pass through the source and come to the plate joined to «−»; no electron crosses the gap. The plates gain
 * «+» and «−» (six signs at the end), the gray field lines between them grow from nothing; the voltage across the plates
 * rises as U = 4,5 В · (1 − e^(−t/τ)) with τ = 0,8 s on the screen, and the current, the drift of the dots and the gold
 * arrows «направление тока» (opposite to the electrons' motion) fade as e^(−t/τ). 6,3 s: the switch opens; the signs,
 * the field and U = 4,5 В stay. The last 0,6 s the picture fades back to the start of the loop.
 * Colors as in «Электростатика»: «+» red, «−» blue, field lines gray, electrons blue dots, the direction of current gold.
 */
import G7Styles from '../g7/G7Styles.astro';

// the plates and the circuit
const PL = 150; // left plate (joined to «+»), outer face
const PR = 190; // right plate, outer face
const Y1 = 50;
const Y2 = 150;
const lines = [62, 81, 100, 119, 138];
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow chg not-content" data-chargepic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 232" role="img" aria-label="Зарядка конденсатора: при замкнутом ключе электроны по проводам уходят с одной пластины через источник на другую, пластины заряжаются, между ними возникает поле, напряжение растёт до 4,5 вольта" data-svg>
			<!-- the voltmeter across the plates -->
			<path class="chg__lead" d={`M136 34 L${PL + 3} ${Y1} M204 34 L${PR - 3} ${Y1}`}></path>
			<rect class="chg__meter" x="122" y="8" width="96" height="26" rx="5"></rect>
			<text class="t-strong t-num" x="170" y="26" text-anchor="middle" data-ut><tspan class="chg__i">U</tspan> = 0,0 В</text>
			<!-- the circuit -->
			<path class="chg__wire" d={`M${PL} 144 H70 V185 H150 M160 185 H210 M238 185 H270 V144 H${PR}`}></path>
			<path class="chg__bat" d="M150 173 V197"></path>
			<path class="chg__bat is-short" d="M160 178 V192"></path>
			<text class="t-small" x="143" y="172" text-anchor="middle">+</text>
			<text class="t-small" x="167" y="174" text-anchor="middle">−</text>
			<text class="t-small" x="155" y="212" text-anchor="middle">источник 4,5 В</text>
			<circle class="chg__pin" cx="210" cy="185" r="2.4"></circle>
			<circle class="chg__pin" cx="238" cy="185" r="2.4"></circle>
			<path class="chg__lever" data-lever></path>
			<!-- the field between the plates -->
			<g data-field>
				{lines.map((y) => (
					<>
						<path class="chg__line" d={`M${PL + 6} ${y} H${PR - 6}`} />
						<path class="chg__tip" d={`M${(PL + PR) / 2 + 4} ${y} l-6 -3 v6 Z`} />
					</>
				))}
			</g>
			<rect class="chg__plate" x={PL} y={Y1} width="6" height={Y2 - Y1} rx="1.5"></rect>
			<rect class="chg__plate" x={PR - 6} y={Y1} width="6" height={Y2 - Y1} rx="1.5"></rect>
			<g data-signs></g>
			<!-- the electrons of the wires and the direction of current -->
			<g data-dots></g>
			<g data-cur>
				<path class="chg__cur" d="M58 182 V158"></path>
				<path class="chg__curh" d="M58 150 l-4.5 9 h9 Z"></path>
				<path class="chg__cur" d="M282 150 V174"></path>
				<path class="chg__curh" d="M282 182 l-4.5 -9 h9 Z"></path>
			</g>
			<!-- the legend -->
			<circle class="chg__dot" cx="20" cy="225" r="2.6"></circle>
			<text class="t-small" x="28" y="229">электроны</text>
			<path class="chg__cur" d="M176 225 H196"></path>
			<path class="chg__curh" d="M204 225 l-9 -4.5 v9 Z"></path>
			<text class="t-small" x="210" y="229">направление тока</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Источник переносит электроны с одной обкладки на другую по проводам; через диэлектрик заряд не проходит. Зарядка сильно замедлена: на самом деле такой конденсатор заряжается за доли миллисекунды.</figcaption>
</figure>

<style is:global>
	[data-chargepic].g7--narrow .g7__grid {
		max-width: 27.5rem;
	}
	[data-chargepic] .chg__wire,
	[data-chargepic] .chg__lever {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-chargepic] .chg__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-chargepic] .chg__meter {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-chargepic] .chg__bat {
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
	}
	[data-chargepic] .chg__bat.is-short {
		stroke-width: 4.5;
	}
	[data-chargepic] .chg__pin {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	[data-chargepic] .chg__plate {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-chargepic] .chg__line {
		stroke: var(--sl-color-gray-3);
	}
	[data-chargepic] .chg__tip {
		fill: var(--sl-color-gray-3);
	}
	[data-chargepic] .chg__s {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-chargepic] .chg__s.is-p {
		stroke: var(--g7-red);
	}
	[data-chargepic] .chg__s.is-m {
		stroke: var(--g7-blue);
	}
	[data-chargepic] .chg__dot {
		fill: var(--g7-blue);
		stroke: var(--g7-paper);
		stroke-width: 0.6;
	}
	[data-chargepic] .chg__cur {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-chargepic] .chg__curh {
		fill: var(--g7-gold);
	}
	[data-chargepic] .chg__i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
</style>

<script>
	import { loop, fmt } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const PL = 150;
	const PR = 190;
	// the path of the electrons: from the left plate round through the source to the right plate
	const PATH: [number, number][] = [
		[PL, 144],
		[70, 144],
		[70, 185],
		[150, 185],
		[160, 185],
		[210, 185],
		[238, 185],
		[270, 185],
		[270, 144],
		[PR, 144],
	];
	const seg = PATH.slice(1).map((p, i) => Math.hypot(p[0] - PATH[i][0], p[1] - PATH[i][1]));
	const LEN = seg.reduce((a, b) => a + b, 0);
	const at = (s: number): [number, number] => {
		let r = ((s % LEN) + LEN) % LEN;
		for (let i = 0; i < seg.length; i++) {
			if (r <= seg[i]) {
				const k = r / seg[i];
				return [PATH[i][0] + (PATH[i + 1][0] - PATH[i][0]) * k, PATH[i][1] + (PATH[i + 1][1] - PATH[i][1]) * k];
			}
			r -= seg[i];
		}
		return PATH[PATH.length - 1];
	};
	const N = 24; // electrons drawn along the wires
	const TAU = 0.8; // s on the screen
	const T = 9;
	// the drift speed at the start: over the whole charging every electron moves on by exactly three spacings, so the
	// loop starts again with the dots where they were
	const V0 = (3 * LEN) / N / (TAU * (1 - Math.exp(-5.2 / TAU)));
	const SIGN_Y = [82, 96, 68, 110, 54, 124]; // from the middle out; the wires come to the plates' lower ends (y = 144)
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-chargepic]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const dotsG = $<SVGGElement>('[data-dots]');
		const dots = Array.from({ length: N }, () => {
			const c = document.createElementNS(NS, 'circle');
			c.setAttribute('class', 'chg__dot');
			c.setAttribute('r', '2.6');
			dotsG.append(c);
			return c;
		});
		const signsG = $<SVGGElement>('[data-signs]');
		const signs = SIGN_Y.map((y) => {
			const p = document.createElementNS(NS, 'path');
			p.setAttribute('class', 'chg__s is-p');
			p.setAttribute('d', `M${PL - 12} ${y} h7 M${PL - 8.5} ${y - 3.5} v7`);
			const m = document.createElementNS(NS, 'path');
			m.setAttribute('class', 'chg__s is-m');
			m.setAttribute('d', `M${PR + 5} ${y} h7`);
			signsG.append(p, m);
			return [p, m];
		});
		const field = $<SVGGElement>('[data-field]');
		const fieldLines = [...field.querySelectorAll<SVGPathElement>('.chg__line')];
		const cur = $<SVGGElement>('[data-cur]');
		const lever = $<SVGPathElement>('[data-lever]');
		const ut = $('[data-ut]');
		let t = 0;
		let s0 = 0; // how far the electrons have drifted, px
		const state = (tt: number) => {
			// the switch: closes 0,8–1,1 s, opens 6,3–6,6 s
			const closed = ease((tt - 0.8) / 0.3) * (1 - ease((tt - 6.3) / 0.3));
			const tc = tt - 1.1;
			const I = tc > 0 && tt < 6.3 ? Math.exp(-tc / TAU) : 0;
			const U = tc > 0 ? 4.5 * (1 - Math.exp(-Math.min(tc, 5.2) / TAU)) : 0;
			const fade = 1 - ease((tt - 8.4) / 0.6);
			return { closed, I, U, fade };
		};
		const draw = () => {
			const { closed, I, U, fade } = state(t);
			const a = (-32 * (1 - closed) * Math.PI) / 180;
			lever.setAttribute('d', `M210 185 L${(210 + 28 * Math.cos(a)).toFixed(1)} ${(185 + 28 * Math.sin(a)).toFixed(1)}`);
			dots.forEach((c, i) => {
				const [x, y] = at(s0 + (i * LEN) / N);
				c.setAttribute('cx', x.toFixed(1));
				c.setAttribute('cy', y.toFixed(1));
			});
			const k = U / 4.5;
			const n = Math.round(6 * k * fade);
			signs.forEach(([p, m], i) => {
				p.style.opacity = i < n ? '1' : '0';
				m.style.opacity = i < n ? '1' : '0';
			});
			field.style.opacity = (k * fade).toFixed(2);
			for (const l of fieldLines) l.setAttribute('stroke-width', (0.4 + 0.8 * k).toFixed(2));
			cur.style.opacity = I.toFixed(2);
			ut.innerHTML = `<tspan class="chg__i">U</tspan> = ${fmt(U * fade, 1)} В`;
		};
		loop(root, (dt) => {
			const { I } = state(t);
			s0 += V0 * I * dt;
			t += dt;
			if (t >= T) {
				t = 0;
				s0 = 0;
			}
			draw();
			return true;
		});
		draw();
	}
</script>
