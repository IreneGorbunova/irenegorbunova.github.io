---
/**
 * «Плоский конденсатор»: two square plates of area S = 50 … 400 см², d = 1 … 10 мм apart, the gap filled with air
 * (ε = 1), paraffin (ε = 2) or glass (ε = 7). With the switch closed the capacitor stays joined to a source of 100 В;
 * with it open the charge stays what it was. C = εε₀S/d with ε₀ = 8,85·10⁻¹² Ф/м; joined: U = 100 В, q = CU;
 * open: q fixed, U = q/C; in both cases E = U/d. Example: S = 100 см², d = 2 мм, air: C = 44,3 пФ, q = 4,43 нКл,
 * E = 50 кВ/м. Open the switch and double d: C = 22,1 пФ, U = 200 В, E stays 50 кВ/м.
 *
 * The drawing is a section: the length of a plate is the side of the square, √S (13 px per сантиметр: 92 … 260 px), the
 * gap is drawn 9 px per миллиметр — 6,9 times larger than the plates' scale, or it would be too thin to see (the
 * caption says so). The field lines are spaced inversely to E (8 px at 100 кВ/м, 80 px at 10 кВ/м, at most 120 px);
 * one sign on a plate stands for 0,5 нКл; the signs stand in up to two columns, at least 13 px apart, and when more
 * signs are due than fit, as many as fit are drawn (the caption says so).
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 pc not-content" data-platelab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 318" role="img" aria-label="Плоский конденсатор в разрезе: две пластины, диэлектрик между ними, линии поля и заряды на пластинах; источник подключается выключателем" data-svg>
			<rect class="pc__diel" data-diel></rect>
			<g data-lines></g>
			<rect class="pc__plate is-plus" data-p1 width="6"></rect>
			<rect class="pc__plate is-minus" data-p2 width="6"></rect>
			<g data-signs></g>
			<!-- wires, the switch and the source -->
			<path class="pc__wire" data-w></path>
			<path class="pc__bat" d="M145 280 V304 M155 286 V298"></path>
			<path class="pc__wire" d="M155 292 H173"></path>
			<path class="pc__wire" data-sw></path>
			<circle class="pc__pin" cx="173" cy="292" r="2.2"></circle>
			<circle class="pc__pin" cx="197" cy="292" r="2.2"></circle>
			<text class="t-small" x="150" y="315" text-anchor="middle">источник 100 В</text>
			<path class="pc__dim" data-dim></path>
			<text class="t-strong t-halo" data-dt text-anchor="middle">d</text>
			<text class="t-strong t-num t-halo" x="8" y="297" data-ut></text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Площадь пластины <i>S</i></span>
				<output data-os></output>
				<input type="range" min="50" max="400" step="10" value="100" data-s aria-label="Площадь пластины, квадратные сантиметры" />
			</label>
			<label class="g7__slider">
				<span>Расстояние <i>d</i></span>
				<output data-od></output>
				<input type="range" min="1" max="10" step="0.5" value="2" data-d aria-label="Расстояние между пластинами, миллиметры" />
			</label>
			<div class="g7__seg" role="group" aria-label="Диэлектрик" data-seg>
				<button type="button" class="g7__btn" aria-pressed="true" data-e="1">Воздух</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-e="2">Парафин</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-e="7">Стекло</button>
			</div>
			<button type="button" class="g7__btn g7__again" data-switch aria-pressed="true">Источник подключён</button>
			<ul class="g7__read" aria-live="polite">
				<li class="is-key"><span>ёмкость <i>C</i></span> <b data-c></b></li>
				<li><span>заряд <i>q</i></span> <b data-q></b></li>
				<li><span>напряжение <i>U</i></span> <b data-volt></b></li>
				<li><span>напряжённость <i>E</i></span> <b data-er></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Конденсатор показан в разрезе. Расстояние между пластинами нарисовано почти в 7&nbsp;раз крупнее, чем сами пластины, иначе зазор был бы не виден. Один знак на пластине — 0,5&nbsp;нКл (если знаков больше, чем помещается, показано столько, сколько поместилось); чем гуще линии, тем больше напряжённость.</figcaption>
</figure>

<style is:global>
	[data-platelab] .pc__diel {
		fill: transparent;
	}
	[data-platelab] .pc__diel.is-2 {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	[data-platelab] .pc__diel.is-7 {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-4));
	}
	[data-platelab] .pc__i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	[data-platelab] .pc__line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-platelab] .pc__plate {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-platelab] .is-plus {
		fill: var(--g7-red);
	}
	[data-platelab] .is-minus {
		fill: var(--g7-blue);
	}
	[data-platelab] .pc__s {
		fill: none;
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	[data-platelab] .pc__s.is-p {
		stroke: var(--g7-red);
	}
	[data-platelab] .pc__s.is-m {
		stroke: var(--g7-blue);
	}
	[data-platelab] .pc__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	[data-platelab] .pc__bat {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
	}
	[data-platelab] .pc__pin {
		fill: var(--sl-color-gray-2);
	}
	[data-platelab] .pc__dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
</style>

<script>
	import { el, segment } from '../g7/kit';
	import { sig, E0 } from '../elektrostatika/vec';

	const CX = 150;
	const CY = 146;
	const PS = 13; // px per см of the plates
	const PD = 9; // px per мм of the gap
	for (const root of document.querySelectorAll<HTMLElement>('[data-platelab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const sS = $<HTMLInputElement>('[data-s]');
		const sd = $<HTMLInputElement>('[data-d]');
		const sw = $<HTMLButtonElement>('[data-switch]');
		let eps = 1;
		let on = true;
		let qFixed = 0; // Кл, kept while the switch is open
		const state = () => {
			const S = +sS.value * 1e-4;
			const d = +sd.value * 1e-3;
			const C = (eps * E0 * S) / d;
			let q: number;
			let U: number;
			if (on) {
				U = 100;
				q = C * U;
			} else {
				q = qFixed;
				U = q / C;
			}
			return { S, d, C, q, U, E: U / d };
		};
		const draw = () => {
			const s = state();
			const a = Math.sqrt(+sS.value) * PS; // plate length, px
			const g = +sd.value * PD; // gap, px
			const top = CY - a / 2;
			const x1 = CX - g / 2 - 6;
			const x2 = CX + g / 2;
			const p1 = $('[data-p1]');
			const p2 = $('[data-p2]');
			for (const [p, x] of [[p1, x1], [p2, x2]] as const) {
				p.setAttribute('x', x.toFixed(1));
				p.setAttribute('y', top.toFixed(1));
				p.setAttribute('height', a.toFixed(1));
			}
			const diel = $('[data-diel]');
			diel.setAttribute('x', (CX - g / 2).toFixed(1));
			diel.setAttribute('y', top.toFixed(1));
			diel.setAttribute('width', g.toFixed(1));
			diel.setAttribute('height', a.toFixed(1));
			diel.setAttribute('class', `pc__diel is-${eps}`);
			// field lines, spaced inversely to E
			const lines = $<SVGGElement>('[data-lines]');
			lines.replaceChildren();
			const sp = Math.min(120, Math.max(8, 80 / (s.E / 1e4)));
			const n = Math.max(1, Math.floor(a / sp));
			for (let i = 0; i < n; i++) {
				const y = top + (a - (n - 1) * sp) / 2 + i * sp;
				lines.append(el('line', { class: 'pc__line', x1: (CX - g / 2).toFixed(1), y1: y.toFixed(1), x2: (CX + g / 2).toFixed(1), y2: y.toFixed(1) }));
			}
			// signs: one per 0,5 нКл, in up to four columns with rows at least 11 px apart, as many as fit
			const signs = $<SVGGElement>('[data-signs]');
			signs.replaceChildren();
			const rows = Math.max(1, Math.floor(a / 13));
			const k = Math.min(2 * rows, Math.round(s.q / 0.5e-9));
			const cols = Math.max(1, Math.ceil(k / rows));
			for (let c = 0; c < cols; c++) {
				const m = Math.floor(k / cols) + (c < k % cols ? 1 : 0); // as equal as possible
				for (let i = 0; i < m; i++) {
					const y = top + ((i + 0.5) * a) / m;
					const xp = x1 - 9 - 9 * c;
					const xm = x2 + 9 + 9 * c;
					signs.append(el('path', { class: 'pc__s is-p', d: `M${xp.toFixed(1)} ${y.toFixed(1)} h6 M${(xp + 3).toFixed(1)} ${(y - 3).toFixed(1)} v6` }));
					signs.append(el('path', { class: 'pc__s is-m', d: `M${xm.toFixed(1)} ${y.toFixed(1)} h6` }));
				}
			}
			// wires from the plates' lower ends to the source and the switch
			$('[data-w]').setAttribute('d', `M${(x1 + 3).toFixed(1)} ${(top + a).toFixed(1)} V292 H145 M${(x2 + 3).toFixed(1)} ${(top + a).toFixed(1)} V280 H219 V292 H197`);
			$('[data-sw]').setAttribute('d', on ? 'M173 292 L197 292' : 'M173 292 L193 278');
			// the gap marked above the plates
			$('[data-dim]').setAttribute('d', `M${(CX - g / 2).toFixed(1)} ${(top - 4).toFixed(1)} H${(CX + g / 2).toFixed(1)} M${(CX - g / 2).toFixed(1)} ${(top - 7).toFixed(1)} v6 M${(CX + g / 2).toFixed(1)} ${(top - 7).toFixed(1)} v6`);
			const dt = $('[data-dt]');
			dt.setAttribute('x', String(CX + g / 2 + 12));
			dt.setAttribute('y', (top - 1).toFixed(1));
			$('[data-ut]').innerHTML = `<tspan class="pc__i">U</tspan> = ${sig(s.U)} В`;
			$('[data-os]').textContent = `${sS.value} см²`;
			$('[data-od]').textContent = `${sd.value.replace('.', ',')} мм`;
			$('[data-c]').textContent = `${sig(s.C * 1e12)} пФ`;
			$('[data-q]').textContent = `${sig(s.q * 1e9)} нКл`;
			$('[data-volt]').textContent = `${sig(s.U)} В`;
			$('[data-er]').textContent = `${sig(s.E / 1000)} кВ/м`;
		};
		segment($('[data-seg]'), (b) => {
			eps = +b.dataset.e!;
			draw();
		});
		sw.addEventListener('click', () => {
			if (on) qFixed = state().q;
			on = !on;
			sw.setAttribute('aria-pressed', String(on));
			sw.textContent = on ? 'Источник подключён' : 'Источник отключён';
			draw();
		});
		for (const s of [sS, sd]) s.addEventListener('input', draw);
		draw();
	}
</script>
