---
/**
 * Two ways to join capacitors, static schemes with the charges on the plates.
 * Parallel: both capacitors get the voltage of the source; C₂ = 2C₁, so the second one holds twice the charge
 *   (2 and 4 signs); the charges add up.
 * Series: the source charges only the outer plates; the inner plates, joined to each other and to nothing else,
 *   share the charge by influence, so every plate carries the same |q| (3 signs each) while the voltages add up.
 * Colors: «+» red, «−» blue.
 */
import G7Styles from '../g7/G7Styles.astro';

const plus = (x: number, y: number) => `M${x - 3} ${y} h6 M${x} ${y - 3} v6`;
const minus = (x: number, y: number) => `M${x - 3} ${y} h6`;
---

<G7Styles />
<figure class="g7 g7--pic cn not-content" data-connpic>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 220 170" role="img" aria-label="Параллельное соединение двух конденсаторов: оба подключены к одному источнику, напряжение на них одинаковое, заряды складываются">
			<path class="cn__wire" d="M40 30 H180 M40 30 V48 M40 76 V120 M180 30 V48 M180 76 V120 M40 120 H180 M110 30 V64 M110 72 V120"></path>
			<path class="cn__plate" d="M26 48 H54 M26 76 H54"></path>
			<path class="cn__plate" d="M162 48 H198 M162 76 H198"></path>
			<path class="cn__plate cn__plate--bat" d="M98 64 H122"></path>
			<path class="cn__plate" d="M104 72 H116"></path>
			<path class="cn__p" d={[plus(34, 41), plus(46, 41)].join(' ')}></path>
			<path class="cn__m" d={[minus(34, 84), minus(46, 84)].join(' ')}></path>
			<path class="cn__p" d={[plus(166, 41), plus(176, 41), plus(186, 41), plus(196, 41)].join(' ')}></path>
			<path class="cn__m" d={[minus(166, 84), minus(176, 84), minus(186, 84), minus(196, 84)].join(' ')}></path>
			<text class="t-strong" x="62" y="66">C<tspan baseline-shift="sub" font-size="9">1</tspan></text>
			<text class="t-strong" x="158" y="66" text-anchor="end">C<tspan baseline-shift="sub" font-size="9">2</tspan></text>
			<text class="t-small" x="104" y="96" text-anchor="end">источник</text>
			<text class="t-title" x="110" y="14" text-anchor="middle">Параллельно</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 220 170" role="img" aria-label="Последовательное соединение двух конденсаторов: на всех пластинах заряды одинаковы по модулю, напряжения складываются">
			<path class="cn__wire" d="M20 60 H62 M82 60 H138 M158 60 H200 V140 H115 M105 140 H20 V60"></path>
			<path class="cn__plate" d="M62 44 V76 M82 44 V76"></path>
			<path class="cn__plate" d="M138 44 V76 M158 44 V76"></path>
			<path class="cn__plate cn__plate--bat" d="M105 132 V148 M115 136 V144"></path>
			<path class="cn__p" d={[plus(54, 46), plus(54, 60), plus(54, 74)].join(' ')}></path>
			<path class="cn__m" d={[minus(90, 46), minus(90, 60), minus(90, 74)].join(' ')}></path>
			<path class="cn__p" d={[plus(130, 46), plus(130, 60), plus(130, 74)].join(' ')}></path>
			<path class="cn__m" d={[minus(166, 46), minus(166, 60), minus(166, 74)].join(' ')}></path>
			<text class="t-strong" x="72" y="96" text-anchor="middle">C<tspan baseline-shift="sub" font-size="9">1</tspan></text>
			<text class="t-strong" x="148" y="96" text-anchor="middle">C<tspan baseline-shift="sub" font-size="9">2</tspan></text>
			<path class="cn__dim" d="M62 108 H82 M138 108 H158"></path>
			<text class="t-small" x="72" y="122" text-anchor="middle">U₁</text>
			<text class="t-small" x="148" y="122" text-anchor="middle">U₂</text>
			<text class="t-small" x="110" y="160" text-anchor="middle">источник</text>
			<text class="t-title" x="110" y="14" text-anchor="middle">Последовательно</text>
		</svg>
	</div>
	<figcaption class="g7__caption">При параллельном соединении напряжение на конденсаторах одинаковое, а заряды складываются. При последовательном заряды всех пластин одинаковы по модулю, а напряжения складываются.</figcaption>
</figure>

<style is:global>
	[data-connpic] .cn__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	[data-connpic] .cn__plate {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 4;
	}
	[data-connpic] .cn__plate--bat {
		stroke-width: 2.4;
	}
	[data-connpic] .cn__p,
	[data-connpic] .cn__m {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-connpic] .cn__p {
		stroke: var(--g7-red);
	}
	[data-connpic] .cn__m {
		stroke: var(--g7-blue);
	}
	[data-connpic] .cn__dim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 2 2;
	}
</style>
