---
/**
 * What a capacitor is: two panels, static.
 * 1) A flat capacitor in a slanting view (cavalier projection, the depth drawn up and to the right at half length):
 *    two plates with charges +q and −q, the dielectric between them, the uniform field (gray lines with arrows, drawn
 *    at the middle depth of the plates) inside and only faint fringes outside; S — the area of a plate, d — the gap
 *    (drawn much wider than in a real capacitor).
 * 2) The symbol of a capacitor on circuit diagrams, and the symbol of a variable one.
 * The rolled paper capacitor that was the third panel is now in KindsPicture.
 * Colors: «+» red, «−» blue, field lines gray.
 */
import G7Styles from '../g7/G7Styles.astro';

const lines = [0, 1, 2, 3, 4, 5, 6].map((i) => 52 + i * 14);
// the plates: front edges x = 70 (+) and 118 (−), y 40…140; the depth goes (22, −14)
const DX = 22;
const DY = -14;
const plate = (x: number) => `M${x} 40 L${x + DX} ${40 + DY} L${x + DX} ${140 + DY} L${x} 140 Z`;
---

<G7Styles />
<figure class="g7 g7--pic cp not-content" data-cappic>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 200 170" role="img" aria-label="Плоский конденсатор: две пластины площадью S на расстоянии d, с зарядами плюс q и минус q, между ними диэлектрик и однородное поле">
			<path class="cp__diel" d={`M70 40 L${70 + DX} ${40 + DY} H${118 + DX} V${140 + DY} L118 140 H70 Z`}></path>
			<path class="cp__fringe" d={`M${81} ${33} Q${105} ${16} ${129} ${33} M${81} ${133} Q${105} ${150} ${129} ${133}`}></path>
			<path class="cp__plate is-minus" d={plate(118)}></path>
			{lines.map((y) => (
				<>
					<line class="cp__line" x1="81" y1={y - 7} x2="129" y2={y - 7} />
					<path class="cp__tip" d={`M${108} ${y - 7} l-6 -3 v6 Z`} />
				</>
			))}
			<path class="cp__plate is-plus" d={plate(70)}></path>
			{lines.slice(0, 6).map((y) => (
				<>
					<path class="cp__s is-p" d={`M${81 - 3} ${y} h6 M${81} ${y - 3} v6`} />
					<path class="cp__s is-m" d={`M${129 - 3} ${y} h6`} />
				</>
			))}
			<path class="cp__dim" d="M70 148 H118 M70 143 v10 M118 143 v10"></path>
			<text class="t-strong cp__i" x="94" y="164" text-anchor="middle">d</text>
			<text class="t-strong t-halo cp__i" x="66" y="30" text-anchor="end">S</text>
			<text class="t-strong t-red" x="44" y="96" text-anchor="middle">+<tspan class="cp__i">q</tspan></text>
			<text class="t-strong t-blue" x="166" y="88" text-anchor="middle">−<tspan class="cp__i">q</tspan></text>
			<text class="t-small" x="150" y="14" text-anchor="middle">диэлектрик</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 170" role="img" aria-label="Обозначение конденсатора на схемах: две параллельные черты; у конденсатора переменной ёмкости их пересекает стрелка">
			<path class="cp__wire" d="M20 52 H90 M110 52 H180"></path>
			<path class="cp__sym" d="M90 28 V76 M110 28 V76"></path>
			<text class="t-small" x="100" y="96" text-anchor="middle">конденсатор</text>
			<path class="cp__wire" d="M20 128 H90 M110 128 H180"></path>
			<path class="cp__sym" d="M90 104 V152 M110 104 V152"></path>
			<path class="cp__var" d="M84 146 L124 106"></path>
			<path class="cp__varh" d="M128 102 l-9 2 l5 5 Z"></path>
			<text class="t-small" x="100" y="167" text-anchor="middle">переменной ёмкости</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Плоский конденсатор: поле почти целиком сосредоточено между пластинами; <i>S</i> — площадь пластины, <i>d</i> — расстояние между пластинами (на рисунке оно сильно увеличено). Обозначения на схемах: конденсатор и конденсатор переменной ёмкости.</figcaption>
</figure>

<style is:global>
	[data-cappic] .cp__diel {
		fill: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-gray-5));
	}
	[data-cappic] .cp__line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	[data-cappic] .cp__tip {
		fill: var(--sl-color-gray-2);
	}
	[data-cappic] .cp__plate {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
		stroke-linejoin: round;
		fill-opacity: 0.55;
	}
	[data-cappic] .cp__i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	[data-cappic] .cp__fringe {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-width: 0.9;
		stroke-dasharray: 2 2;
	}
	[data-cappic] .is-plus {
		fill: var(--g7-red);
	}
	[data-cappic] .is-minus {
		fill: var(--g7-blue);
	}
	[data-cappic] .cp__s {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-cappic] .cp__s.is-p {
		stroke: var(--g7-red);
	}
	[data-cappic] .cp__s.is-m {
		stroke: var(--g7-blue);
	}
	[data-cappic] .cp__dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-cappic] .cp__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-cappic] .cp__sym {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 4;
	}
	[data-cappic] .cp__var {
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
	[data-cappic] .cp__varh {
		fill: var(--sl-color-white);
	}
</style>
