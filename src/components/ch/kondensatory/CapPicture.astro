---
/**
 * What a capacitor is: three panels, static.
 * 1) A flat capacitor in section: two plates with charges +q and −q, a layer of dielectric between them, the uniform
 *    field (gray lines with arrows) inside and almost none outside; d — the gap, S — the area of a plate.
 * 2) The symbol of a capacitor on circuit diagrams, and the symbol of a variable one.
 * 3) A rolled paper capacitor: two strips of foil and two strips of waxed paper rolled together, shown half unrolled
 *    (the strips are drawn shorter than real ones, which are metres long).
 * Colors: «+» red, «−» blue, field lines gray.
 */
import G7Styles from '../g7/G7Styles.astro';

const lines = [0, 1, 2, 3, 4, 5, 6].map((i) => 34 + i * 14);
// the end of the roll: an Archimedean spiral r = 2 + 1,6·θ around (60, 100), five turns
const spiral = Array.from({ length: 200 }, (_, i) => {
	const th = (i / 199) * 10 * Math.PI;
	const r = 2 + 1.6 * th * (30 / (2 + 1.6 * 10 * Math.PI));
	return `${i ? 'L' : 'M'}${(60 + r * Math.cos(th)).toFixed(1)} ${(100 + r * Math.sin(th)).toFixed(1)}`;
}).join(' ');
---

<G7Styles />
<figure class="g7 g7--pic cp not-content" data-cappic>
	<div class="g7__grid is-three">
		<svg class="g7__svg" viewBox="0 0 200 170" role="img" aria-label="Плоский конденсатор в разрезе: две пластины с зарядами плюс q и минус q, между ними диэлектрик и однородное поле">
			<rect class="cp__diel" x="80" y="26" width="40" height="104"></rect>
			{lines.map((y) => (
				<>
					<line class="cp__line" x1="76" y1={y} x2="124" y2={y} />
					<path class="cp__tip" d={`M104 ${y} l-6 -3 v6 Z`} />
				</>
			))}
			<rect class="cp__plate is-plus" x="70" y="22" width="8" height="112" rx="1.5"></rect>
			<rect class="cp__plate is-minus" x="122" y="22" width="8" height="112" rx="1.5"></rect>
			{lines.map((y) => (
				<>
					<path class="cp__s is-p" d={`M60 ${y} h6 M63 ${y - 3} v6`} />
					<path class="cp__s is-m" d={`M134 ${y} h6`} />
				</>
			))}
			<path class="cp__dim" d="M78 146 H122 M78 141 v10 M122 141 v10"></path>
			<text class="t-strong" x="100" y="162" text-anchor="middle">d</text>
			<text class="t-strong t-red" x="40" y="82" text-anchor="middle">+q</text>
			<text class="t-strong t-blue" x="164" y="82" text-anchor="middle">−q</text>
			<text class="t-small" x="100" y="16" text-anchor="middle">диэлектрик</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 170" role="img" aria-label="Обозначение конденсатора на схемах: две параллельные черты; у конденсатора переменной ёмкости их пересекает стрелка">
			<path class="cp__wire" d="M20 52 H90 M110 52 H180"></path>
			<path class="cp__sym" d="M90 28 V76 M110 28 V76"></path>
			<text class="t-small" x="100" y="96" text-anchor="middle">конденсатор</text>
			<path class="cp__wire" d="M20 128 H90 M110 128 H180"></path>
			<path class="cp__sym" d="M90 104 V152 M110 104 V152"></path>
			<path class="cp__var" d="M84 146 L124 106"></path>
			<path class="cp__varh" d="M128 102 l-9 2 l5 5 Z"></path>
			<text class="t-small" x="100" y="167" text-anchor="middle">переменной ёмкости</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 170" role="img" aria-label="Бумажный конденсатор: две ленты фольги, проложенные бумагой, свёрнуты в рулон; рулон показан наполовину развёрнутым">
			<!-- the unrolled part: foil, paper, foil, paper, seen from the side and a little from above -->
			<path class="cp__paper" d="M70 104 L186 94 L186 104 L70 114 Z"></path>
			<path class="cp__foil is-p" d="M70 98 L184 88 L184 94 L70 104 Z"></path>
			<path class="cp__paper" d="M70 92 L182 82 L182 88 L70 98 Z"></path>
			<path class="cp__foil is-m" d="M70 86 L180 76 L180 82 L70 92 Z"></path>
			<!-- the roll -->
			<ellipse class="cp__roll" cx="60" cy="100" rx="34" ry="34"></ellipse>
			<path class="cp__spiral" d={spiral}></path>
			<path class="cp__lead" d="M44 66 V34 M76 66 V34"></path>
			<circle class="cp__dot is-p" cx="44" cy="66" r="3"></circle>
			<circle class="cp__dot is-m" cx="76" cy="66" r="3"></circle>
			<text class="t-small" x="132" y="70" text-anchor="middle">фольга</text>
			<text class="t-small" x="134" y="126" text-anchor="middle">бумага</text>
			<text class="t-small" x="60" y="160" text-anchor="middle">рулон</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Слева — плоский конденсатор в разрезе: поле почти целиком сосредоточено между пластинами. В середине — обозначения на схемах. Справа — бумажный конденсатор: длинные ленты фольги, проложенные бумагой, свёрнуты в рулон.</figcaption>
</figure>

<style is:global>
	[data-cappic] .cp__diel {
		fill: color-mix(in oklab, var(--ig-v) 20%, var(--sl-color-gray-5));
	}
	[data-cappic] .cp__line {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	[data-cappic] .cp__tip {
		fill: var(--sl-color-gray-2);
	}
	[data-cappic] .cp__plate {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-cappic] .is-plus,
	[data-cappic] .cp__dot.is-p,
	[data-cappic] .cp__foil.is-p {
		fill: var(--g7-red);
	}
	[data-cappic] .is-minus,
	[data-cappic] .cp__dot.is-m,
	[data-cappic] .cp__foil.is-m {
		fill: var(--g7-blue);
	}
	[data-cappic] .cp__s {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-cappic] .cp__s.is-p {
		stroke: var(--g7-red);
	}
	[data-cappic] .cp__s.is-m {
		stroke: var(--g7-blue);
	}
	[data-cappic] .cp__dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-cappic] .cp__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-cappic] .cp__sym {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 4;
	}
	[data-cappic] .cp__var {
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	[data-cappic] .cp__varh {
		fill: var(--g7-gold);
	}
	[data-cappic] .cp__paper {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-2));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.5;
	}
	[data-cappic] .cp__foil {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
		opacity: 0.85;
	}
	[data-cappic] .cp__roll {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-cappic] .cp__spiral {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-cappic] .cp__lead {
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
</style>
