---
/**
 * «Вспышка»: the capacitor of a photo flash, C = 200 … 2000 мкФ, is charged to U = 100 … 330 В («Зарядить», 2 s on
 * the screen; a real flash charges in a few seconds), then gives all its energy to the lamp («Вспышка»; about a
 * thousandth of a second in reality, here the glow fades in 0,6 s).
 *
 * Left: the graph of the voltage on the capacitor against the charge that has passed, U = q/C: a straight line from
 * zero. The work of the source to move the charge equals the area under the line; it grows as a triangle while the
 * capacitor charges and ends at W = qU/2 = CU²/2. The axes are scaled to the chosen C and U (their numbers say so);
 * the triangle is always drawn full size. Example: C = 1000 мкФ, U = 330 В: q = 0,33 Кл, W = 54,5 Дж, and if it is
 * given away in 0,001 с, the power is 54 кВт. Right: the capacitor with a gold column ∝ the energy stored (52 px for the largest, 108,9 Дж) and the
 * flash tube; its glow grows with the energy (radius ∝ √W).
 */
import G7Styles from '../g7/G7Styles.astro';

const GX = 34;
const GY = 176;
const GW = 150;
const GH = 140;
---

<G7Styles />
<figure class="g7 fv not-content" data-flashlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 210" role="img" aria-label="График напряжения на конденсаторе в зависимости от заряда: площадь под ним — энергия. Справа — лампа вспышки" data-svg>
			<path class="fv__tri" data-tri></path>
			<path class="fv__line" data-line></path>
			<path class="fv__axis" d={`M${GX} ${GY - GH - 8} V${GY} H${GX + GW + 8}`}></path>
			<path class="fv__dash" data-dash></path>
			<text class="t-small" x={GX - 4} y={GY - GH + 4} text-anchor="end" data-umax></text>
			<text class="t-small" x={GX - 4} y={GY + 4} text-anchor="end">0</text>
			<text class="t-small" x={GX + GW} y={GY + 14} text-anchor="middle" data-qmax></text>
			<text class="t-small" x={GX + 4} y={GY - GH - 10}><tspan class="t-i">U</tspan>, В</text>
			<text class="t-small" x={GX + GW + 8} y={GY + 28} text-anchor="end"><tspan class="t-i">q</tspan>, Кл</text>
			<text class="t-strong t-num t-halo" x={GX + 70} y={GY - 22} text-anchor="middle" data-w></text>
			<!-- the flash: the capacitor, the tube in its reflector -->
			<rect class="fv__cap" x="214" y="128" width="36" height="58" rx="6"></rect>
			<rect class="fv__fill" data-fill x="218" y="182" width="28" height="0" rx="3"></rect>
			<text class="t-small" x="232" y="202" text-anchor="middle">конденсатор</text>
			<path class="fv__wire" d="M232 128 V112 H272 M250 160 H296 V112"></path>
			<circle class="fv__glow" data-glow cx="284" cy="70" r="0"></circle>
			<path class="fv__refl" d="M256 50 H312 L304 88 H264 Z"></path>
			<rect class="fv__tube" data-tube x="266" y="64" width="36" height="9" rx="4.5"></rect>
			<path class="fv__wire" d="M272 112 V88 M296 112 V88"></path>
			<text class="t-small" x="284" y="42" text-anchor="middle">лампа</text>
		</svg>
		<div class="g7__side">
			<label class="g7__slider">
				<span>Ёмкость <i>C</i></span>
				<output data-oc></output>
				<input type="range" min="200" max="2000" step="100" value="1000" data-c aria-label="Ёмкость, микрофарады" />
			</label>
			<label class="g7__slider">
				<span>Напряжение <i>U</i></span>
				<output data-ou></output>
				<input type="range" min="100" max="330" step="10" value="330" data-u aria-label="Напряжение зарядки, вольты" />
			</label>
			<div class="g7__row">
				<button type="button" class="g7__btn g7__btn--go" data-charge>Зарядить</button>
				<button type="button" class="g7__btn" data-fire disabled>Вспышка</button>
			</div>
			<ul class="g7__read" aria-live="polite">
				<li><span>заряд <i>q</i> = <i>CU</i></span> <b data-q></b></li>
				<li class="is-key"><span>энергия <i>W</i></span> <b data-wr></b></li>
				<li><span>мощность, если разрядить за 0,001&nbsp;с</span> <b data-p></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Энергия конденсатора равна площади под графиком. Оси подстраиваются под выбранные <i>C</i> и <i>U</i>. Зарядка и вспышка замедлены: настоящая вспышка длится около тысячной доли секунды.</figcaption>
</figure>

<style is:global>
	[data-flashlab] .fv__tri {
		fill: color-mix(in oklab, var(--g7-gold) 35%, transparent);
	}
	[data-flashlab] .fv__line {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2.4;
	}
	[data-flashlab] .fv__axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-flashlab] .fv__dash {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	[data-flashlab] .fv__cap {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-flashlab] .fv__fill {
		fill: var(--g7-gold);
	}
	[data-flashlab] .fv__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	[data-flashlab] .fv__refl {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-flashlab] .fv__tube {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-flashlab] .fv__tube.is-on {
		fill: white;
	}
	[data-flashlab] .fv__glow {
		fill: color-mix(in oklab, var(--g7-gold) 30%, white);
		opacity: 0;
		filter: blur(4px);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { sig } from '../elektrostatika/vec';

	const GX = 34;
	const GY = 176;
	const GW = 150;
	const GH = 140;
	const WMAX = (2000e-6 * 330 * 330) / 2;
	for (const root of document.querySelectorAll<HTMLElement>('[data-flashlab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const sc = $<HTMLInputElement>('[data-c]');
		const su = $<HTMLInputElement>('[data-u]');
		const bc = $<HTMLButtonElement>('[data-charge]');
		const bf = $<HTMLButtonElement>('[data-fire]');
		let k = 0; // the part of the full charge on the capacitor, 0…1
		let act: 'none' | 'charge' | 'fire' = 'none';
		let t = 0;
		let flash = 0; // the glow, 0…1

		const draw = () => {
			const C = +sc.value * 1e-6;
			const U = +su.value;
			const qf = C * U;
			const q = qf * k;
			const u = U * k;
			const W = (q * u) / 2;
			$('[data-oc]').textContent = `${sc.value} мкФ`;
			$('[data-ou]').textContent = `${U} В`;
			$('[data-umax]').textContent = String(U);
			$('[data-qmax]').textContent = sig(qf);
			const x = GX + GW * k;
			const y = GY - GH * k;
			$('[data-line]').setAttribute('d', `M${GX} ${GY} L${x.toFixed(1)} ${y.toFixed(1)}`);
			$('[data-tri]').setAttribute('d', k > 0 ? `M${GX} ${GY} L${x.toFixed(1)} ${y.toFixed(1)} L${x.toFixed(1)} ${GY} Z` : '');
			$('[data-dash]').setAttribute('d', k > 0 ? `M${GX} ${y.toFixed(1)} H${x.toFixed(1)} V${GY}` : '');
			$('[data-w]').textContent = k > 0.02 ? `W = ${sig(W)} Дж` : '';
			$('[data-q]').textContent = `${sig(q)} Кл`;
			$('[data-wr]').textContent = `${sig(W)} Дж`;
			$('[data-p]').textContent = act === 'fire' || k >= 1 || flash > 0 ? `${sig(((C * U * U) / 2 / 0.001) / 1000)} кВт` : '—';
			const fill = $('[data-fill]');
			const h = 52 * (W / WMAX); // the gold column: the energy stored, 52 px for the largest 108,9 Дж
			fill.setAttribute('height', h.toFixed(1));
			fill.setAttribute('y', (182 - h).toFixed(1));
			const glow = $('[data-glow]');
			const Wf = (C * U * U) / 2;
			glow.setAttribute('r', (12 + 46 * Math.sqrt(Wf / WMAX)).toFixed(1));
			glow.style.opacity = String(flash);
			$('[data-tube]').classList.toggle('is-on', flash > 0.2);
		};

		const wake = loop(root, (dt) => {
			if (act === 'none') return false;
			t += dt;
			if (act === 'charge') {
				k = Math.min(1, t / 2);
				if (k >= 1) {
					act = 'none';
					bf.disabled = false;
					bc.disabled = false;
				}
			} else {
				// the energy leaves at once; the glow fades in 0,6 s
				k = 0;
				flash = Math.max(0, 1 - t / 0.6);
				if (t > 0.6) {
					act = 'none';
					flash = 0;
					bc.disabled = false;
				}
			}
			draw();
			return act !== 'none';
		});
		bc.addEventListener('click', () => {
			k = 0;
			flash = 0;
			act = 'charge';
			t = 0;
			bc.disabled = true;
			bf.disabled = true;
			wake();
		});
		bf.addEventListener('click', () => {
			if (k < 1) return;
			act = 'fire';
			t = 0;
			flash = 1;
			bf.disabled = true;
			bc.disabled = true;
			draw();
			wake();
		});
		const reset = () => {
			if (act !== 'none') return;
			k = 0;
			flash = 0;
			bf.disabled = true;
			draw();
		};
		sc.addEventListener('input', reset);
		su.addEventListener('input', reset);
		draw();
	}
</script>
