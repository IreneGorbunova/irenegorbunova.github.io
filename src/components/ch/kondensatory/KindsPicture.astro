---
/**
 * «Виды конденсаторов»: four small panels (2 × 2 on a wide screen, one column on a phone), schemes in our style, each
 * with the usual range of capacities.
 *   Бумажный (0,01–10 мкФ): two strips of foil and two of paper rolled together, shown half unrolled (taken from
 *     CapPicture; real strips are metres long).
 *   Керамический (1 пФ – 100 мкФ): a disc with two leads and a chip; the chip cut open shows the metal layers in the
 *     ceramic, joined in turn to its left and right ends.
 *   Электролитический (0,1–10 000 мкФ): a can with the «−» stripe and a shorter «−» lead; the cut-away shows the
 *     aluminium foil, the oxide layer (the dielectric; drawn very much thicker than it is: less than a micrometre, the
 *     caption says so), the paper soaked with electrolyte and the second foil.
 *   Воздушный переменной ёмкости (10–500 пФ): seen along its shaft, a stack of fixed plates (stator, half discs) and a
 *     stack of plates on the shaft (rotor). Animated, a loop of 6 s: the knob turns the rotor by 0 … 180° and back; the
 *     overlap of the half discs grows with the angle, and so does the capacity, C = 10 пФ + 490 пФ · angle / 180° (the
 *     violet bar and its number; violet is the color of C in the chapter).
 */
import G7Styles from '../g7/G7Styles.astro';

// the paper capacitor (as in CapPicture before): an Archimedean spiral at the end of the roll, five turns
const spiral = Array.from({ length: 200 }, (_, i) => {
	const th = (i / 199) * 10 * Math.PI;
	const r = 2 + 1.6 * th * (30 / (2 + 1.6 * 10 * Math.PI));
	return `${i ? 'L' : 'M'}${(60 + r * Math.cos(th)).toFixed(1)} ${(100 + r * Math.sin(th)).toFixed(1)}`;
}).join(' ');
// the variable capacitor: center and radii
const VC = { x: 74, y: 92 };
const RS = 44;
const RR = 40;
const half = (r: number, a0: number, cx = VC.x, cy = VC.y) => {
	const p = (a: number) => `${(cx + r * Math.cos(a)).toFixed(1)} ${(cy + r * Math.sin(a)).toFixed(1)}`;
	return `M${cx} ${cy} L${p(a0)} A${r} ${r} 0 0 1 ${p(a0 + Math.PI)} Z`;
};
---

<G7Styles />
<figure class="g7 g7--pic kn not-content" data-kindspic>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 220 150" role="img" aria-label="Бумажный конденсатор: две ленты фольги, проложенные бумагой, свёрнуты в рулон; ёмкость от 0,01 до 10 микрофарад">
			<text class="t-title" x="8" y="17">Бумажный</text>
			<text class="t-small t-num" x="8" y="32">0,01–10 мкФ</text>
			<g transform="translate(6 10) scale(0.88)">
				<path class="kn__paper" d="M70 104 L186 94 L186 104 L70 114 Z"></path>
				<path class="kn__foil is-p" d="M70 98 L184 88 L184 94 L70 104 Z"></path>
				<path class="kn__paper" d="M70 92 L182 82 L182 88 L70 98 Z"></path>
				<path class="kn__foil is-m" d="M70 86 L180 76 L180 82 L70 92 Z"></path>
				<ellipse class="kn__roll" cx="60" cy="100" rx="34" ry="34"></ellipse>
				<path class="kn__spiral" d={spiral}></path>
				<path class="kn__lead" d="M44 66 V40 M76 66 V40"></path>
				<circle class="kn__dot is-p" cx="44" cy="66" r="3"></circle>
				<circle class="kn__dot is-m" cx="76" cy="66" r="3"></circle>
			</g>
			<path class="kn__dash" d="M165 62 L160 79 M165 113 L163 100"></path>
			<text class="t-small" x="200" y="58" text-anchor="end">фольга</text>
			<text class="t-small" x="200" y="124" text-anchor="end">бумага</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 220 150" role="img" aria-label="Керамические конденсаторы: диск с выводами и маленький многослойный чип; в разрезе чипа видны металлические слои в керамике; ёмкость от 1 пикофарады до 100 микрофарад">
			<text class="t-title" x="8" y="17">Керамический</text>
			<text class="t-small t-num" x="8" y="32">1&nbsp;пФ – 100&nbsp;мкФ</text>
			<!-- the disc -->
			<path class="kn__lead" d="M38 100 V142 M58 100 V142"></path>
			<ellipse class="kn__disc" cx="48" cy="82" rx="24" ry="22"></ellipse>
			<text class="kn__mark" x="48" y="86" text-anchor="middle">104</text>
			<!-- the chip, whole and cut open (enlarged) -->
			<rect class="kn__cap" x="112" y="44" width="10" height="16" rx="1.5"></rect>
			<rect class="kn__cer" x="122" y="44" width="36" height="16"></rect>
			<rect class="kn__cap" x="158" y="44" width="10" height="16" rx="1.5"></rect>
			<path class="kn__dash" d="M112 60 L100 78 M168 60 L196 78"></path>
			<rect class="kn__cap" x="100" y="78" width="12" height="52" rx="2"></rect>
			<rect class="kn__cer" x="112" y="78" width="72" height="52"></rect>
			<rect class="kn__cap" x="184" y="78" width="12" height="52" rx="2"></rect>
			{[0, 1, 2, 3, 4, 5].map((i) => <rect class="kn__layer" x={i % 2 ? 120 : 112} y={84 + i * 8} width="64" height="2.4" />)}
			<text class="t-small" x="148" y="145" text-anchor="middle">слои металла в керамике</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 220 150" role="img" aria-label="Электролитический конденсатор: алюминиевый корпус с полосой «минус»; внутри фольга, тонкий слой окисла, бумага с электролитом и вторая фольга; ёмкость от 0,1 до 10 000 микрофарад">
			<text class="t-title" x="8" y="17">Электролитический</text>
			<text class="t-small t-num" x="8" y="32">0,1–10&nbsp;000 мкФ</text>
			<!-- the can -->
			<path class="kn__lead" d="M38 128 V146 M58 128 V140"></path>
			<path class="kn__can" d="M22 50 V122 A26 7 0 0 0 74 122 V50 Z"></path>
			<ellipse class="kn__lid" cx="48" cy="50" rx="26" ry="7"></ellipse>
			<path class="kn__lidx" d="M38 46 L58 54 M58 46 L38 54"></path>
			<path class="kn__stripe" d="M58 56 H70 V126 Q64 128 58 128 Z"></path>
			{[70, 86, 102, 118].map((y) => <path class="kn__minus" d={`M61 ${y} h6`} />)}
			<rect class="kn__win" x="28" y="78" width="16" height="22" rx="1"></rect>
			<path class="kn__dash" d="M44 78 L94 50 M44 100 L94 132"></path>
			<!-- the cut-away: the layers enlarged -->
			<rect class="kn__alu" x="94" y="50" width="44" height="18"></rect>
			<rect class="kn__ox" x="94" y="68" width="44" height="5"></rect>
			<rect class="kn__el" x="94" y="73" width="44" height="41"></rect>
			<rect class="kn__alu" x="94" y="114" width="44" height="18"></rect>
			<text class="t-small" x="144" y="63">фольга</text>
			<text class="t-small" x="144" y="79">окисел</text>
			<text class="t-small" x="144" y="97">электролит</text>
			<text class="t-small" x="144" y="127">фольга</text>
		</svg>

		<svg class="g7__svg" viewBox="0 0 220 150" role="img" aria-label="Воздушный конденсатор переменной ёмкости: при повороте ручки подвижные пластины входят между неподвижными, перекрытие и ёмкость растут; ёмкость от 10 до 500 пикофарад" data-varcap>
			<text class="t-title" x="8" y="17">Переменной ёмкости</text>
			<text class="t-small t-num" x="8" y="32">воздушный, 10–500 пФ</text>
			<!-- the stator stack (fixed, the lower half discs) -->
			{[2, 1, 0].map((k) => <path class={`kn__stator${k ? ' is-back' : ''}`} d={half(RS, 0, VC.x + 3 * k, VC.y - 3 * k)} />)}
			<!-- the rotor stack on the shaft -->
			<g data-rotor>
				{[2, 1, 0].map((k) => <path class={`kn__rotor${k ? ' is-back' : ''}`} data-k={k} />)}
			</g>
			<circle class="kn__knob" cx={VC.x} cy={VC.y} r="9"></circle>
			<path class="kn__mark2" data-mark></path>
			<text class="t-small" x={VC.x} y="146" text-anchor="middle">неподвижные пластины</text>
			<!-- the capacity bar -->
			<rect class="kn__bar" x="176" y="50" width="14" height="80" rx="2"></rect>
			<rect class="kn__barf" data-bar x="176" width="14" rx="2"></rect>
			<text class="t-small t-num" x="183" y="44" text-anchor="middle" data-cv></text>
			<text class="t-small" x="183" y="146" text-anchor="middle">ёмкость</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Конденсаторы называют по диэлектрику; под названием — их обычные ёмкости. Слой окисла нарисован намного толще, чем на самом деле: он тоньше микрометра. Поворот ручки вводит подвижные пластины между неподвижными — перекрытие и ёмкость растут.</figcaption>
</figure>

<style is:global>
	[data-kindspic] .kn__paper {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-2));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.5;
	}
	[data-kindspic] .kn__foil {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
		opacity: 0.85;
	}
	[data-kindspic] .kn__foil.is-p,
	[data-kindspic] .kn__dot.is-p {
		fill: var(--g7-red);
	}
	[data-kindspic] .kn__foil.is-m,
	[data-kindspic] .kn__dot.is-m {
		fill: var(--g7-blue);
	}
	[data-kindspic] .kn__roll {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-kindspic] .kn__spiral {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-kindspic] .kn__lead {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-kindspic] .kn__disc {
		fill: hsl(28, 70%, 48%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-kindspic] .kn__mark {
		font-size: 10px;
		font-weight: 700;
		fill: hsl(28, 40%, 15%);
	}
	[data-kindspic] .kn__cap {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.7;
	}
	[data-kindspic] .kn__cer {
		fill: hsl(35, 45%, 72%);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.7;
	}
	[data-kindspic] .kn__layer {
		fill: hsl(220, 10%, 45%);
	}
	[data-kindspic] .kn__dash {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
	}
	[data-kindspic] .kn__can {
		fill: color-mix(in oklab, var(--ig-vx) 45%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-kindspic] .kn__lid {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-kindspic] .kn__lidx {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-kindspic] .kn__stripe {
		fill: color-mix(in oklab, var(--sl-color-gray-1) 70%, var(--ig-vx));
	}
	[data-kindspic] .kn__minus {
		fill: none;
		stroke: var(--sl-color-gray-6);
		stroke-width: 2;
	}
	[data-kindspic] .kn__win {
		fill: var(--g7-paper);
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		stroke-dasharray: 2 2;
	}
	[data-kindspic] .kn__alu {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-kindspic] .kn__ox {
		fill: hsl(28, 65%, 55%);
	}
	[data-kindspic] .kn__el {
		fill: color-mix(in oklab, var(--ig-vx) 30%, var(--sl-color-gray-5));
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.6;
	}
	[data-kindspic] .kn__stator {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-kindspic] .kn__rotor {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 75%, transparent);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-kindspic] .is-back {
		opacity: 0.55;
	}
	[data-kindspic] .kn__knob {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-kindspic] .kn__mark2 {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-kindspic] .kn__bar {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-kindspic] .kn__barf {
		fill: var(--g7-violet);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const VC = { x: 74, y: 92 };
	const RR = 40;
	const half = (r: number, a0: number, cx: number, cy: number) => {
		const p = (a: number) => `${(cx + r * Math.cos(a)).toFixed(1)} ${(cy + r * Math.sin(a)).toFixed(1)}`;
		return `M${cx} ${cy} L${p(a0)} A${r} ${r} 0 0 1 ${p(a0 + Math.PI)} Z`;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-kindspic]')) {
		const svg = root.querySelector<SVGSVGElement>('[data-varcap]')!;
		const rotors = [...svg.querySelectorAll<SVGPathElement>('[data-k]')];
		const mark = svg.querySelector<SVGPathElement>('[data-mark]')!;
		const bar = svg.querySelector<SVGRectElement>('[data-bar]')!;
		const cv = svg.querySelector<SVGTextElement>('[data-cv]')!;
		let t = 0;
		const draw = () => {
			// the overlap angle 0 … 180° and back in 6 s
			const ov = 90 - 90 * Math.cos((2 * Math.PI * t) / 6);
			const a0 = Math.PI - (ov * Math.PI) / 180; // the rotor occupies [a0, a0 + 180°]; the stator [0, 180°]
			for (const r of rotors) {
				const k = +r.dataset.k!;
				r.setAttribute('d', half(RR, a0, VC.x + 3 * k, VC.y - 3 * k));
			}
			const am = a0 + Math.PI / 2;
			mark.setAttribute('d', `M${VC.x} ${VC.y} L${(VC.x + 8 * Math.cos(am)).toFixed(1)} ${(VC.y + 8 * Math.sin(am)).toFixed(1)}`);
			const C = 10 + (490 * ov) / 180;
			const h = (80 * C) / 500;
			bar.setAttribute('y', (130 - h).toFixed(1));
			bar.setAttribute('height', h.toFixed(1));
			cv.textContent = `${Math.round(C / 5) * 5} пФ`;
		};
		loop(svg, (dt) => {
			t = (t + dt) % 6;
			draw();
			return true;
		});
		draw();
	}
</script>
