---
/**
 * «Соединение конденсаторов» (replaces the static ConnPicture): two capacitors C₁, C₂ = 1 … 10 мкФ (step 1) joined in
 * parallel or in series to a source of U = 12 В.
 *   Parallel: both get 12 В; q₁ = C₁U, q₂ = C₂U; the battery takes q = q₁ + q₂, so C = q/U = C₁ + C₂.
 *     Example: C₁ = 2, C₂ = 6 мкФ → q₁ = 24, q₂ = 72, q = 96 мкКл, C = 8 мкФ.
 *   Series: the source charges only the outer plates; the inner plates, joined to each other and to nothing else, get
 *     their charges by influence (they appear 0,25 s later on the screen), so all plates carry the same |q|;
 *     C = C₁C₂/(C₁ + C₂), q = CU, U₁ = q/C₁, U₂ = q/C₂, U₁ + U₂ = 12 В.
 *     Example: 2 and 6 мкФ → C = 1,5 мкФ, q₁ = q₂ = 18 мкКл, U₁ = 9 В, U₂ = 3 В.
 * The charges are shown as signs next to the plates: one sign = 6 мкКл, a small sign for a remainder of 3 мкКл or more;
 * at most 20 signs per plate (120 мкКл: 10 мкФ at 12 В): one column up to 10 signs, else two columns of nearly equal
 * length, each filled from the middle out; the row of the wire stays empty. After a change the shown charges grow to their
 * new values in 0,5 s. Numbers: q and U to 0,1, C to 0,1 (trailing zeros dropped).
 * Colors: «+» red, «−» blue, as in the whole chapter.
 */
import G7Styles from '../g7/G7Styles.astro';
---

<G7Styles />
<figure class="g7 cl not-content" data-connlab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 320 268" role="img" aria-label="Два конденсатора, соединённые параллельно или последовательно и подключённые к источнику 12 вольт; заряды пластин показаны знаками" data-svg>
			<g data-par>
				<path class="cl__wire" d="M140 60 H70 V252 H155 M165 252 H250 V60 H178 M140 172 H70 M178 172 H250"></path>
				<rect class="cl__plate" x="134" y="12" width="6" height="96" rx="1.5"></rect>
				<rect class="cl__plate" x="172" y="12" width="6" height="96" rx="1.5"></rect>
				<rect class="cl__plate" x="134" y="124" width="6" height="96" rx="1.5"></rect>
				<rect class="cl__plate" x="172" y="124" width="6" height="96" rx="1.5"></rect>
				<text class="t-strong" x="210" y="20"><tspan class="cl__i">C</tspan><tspan class="cl__sub" dy="3">1</tspan></text>
				<text class="t-strong" x="210" y="132"><tspan class="cl__i">C</tspan><tspan class="cl__sub" dy="3">2</tspan></text>
			</g>
			<g data-ser>
				<path class="cl__wire" d="M100 104 H40 V252 H155 M165 252 H280 V104 H226 M138 104 H188"></path>
				<rect class="cl__plate" x="100" y="56" width="6" height="96" rx="1.5"></rect>
				<rect class="cl__plate" x="132" y="56" width="6" height="96" rx="1.5"></rect>
				<rect class="cl__plate" x="188" y="56" width="6" height="96" rx="1.5"></rect>
				<rect class="cl__plate" x="220" y="56" width="6" height="96" rx="1.5"></rect>
				<text class="t-strong" x="119" y="174" text-anchor="middle"><tspan class="cl__i">C</tspan><tspan class="cl__sub" dy="3">1</tspan></text>
				<text class="t-strong" x="207" y="174" text-anchor="middle"><tspan class="cl__i">C</tspan><tspan class="cl__sub" dy="3">2</tspan></text>
			</g>
			<g data-signs></g>
			<!-- the source in the bottom wire: the long line is «+» -->
			<path class="cl__bat" d="M155 240 V264"></path>
			<path class="cl__bat is-short" d="M165 245 V259"></path>
			<text class="t-small" x="172" y="242">12 В</text>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Соединение">
				<button type="button" class="g7__btn" aria-pressed="true" data-mode="par">Параллельно</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-mode="ser">Последовательно</button>
			</div>
			<label class="g7__slider">
				<span>Ёмкость <i>C</i><sub>1</sub></span>
				<output data-oc1></output>
				<input type="range" min="1" max="10" step="1" value="2" data-cap="1" aria-label="Ёмкость первого конденсатора, микрофарады" />
			</label>
			<label class="g7__slider">
				<span>Ёмкость <i>C</i><sub>2</sub></span>
				<output data-oc2></output>
				<input type="range" min="1" max="10" step="1" value="6" data-cap="2" aria-label="Ёмкость второго конденсатора, микрофарады" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>первый: <i>q</i><sub>1</sub>; <i>U</i><sub>1</sub></span> <b data-r1></b></li>
				<li><span>второй: <i>q</i><sub>2</sub>; <i>U</i><sub>2</sub></span> <b data-r2></b></li>
				<li><span>батарея: <i>q</i>; <i>U</i></span> <b data-rb></b></li>
				<li class="is-key"><span>ёмкость батареи <i>C</i> = <i>q</i>/<i>U</i></span> <b data-rc></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Источник поддерживает напряжение 12&nbsp;В. Один знак у пластины — 6&nbsp;мкКл, маленький знак — остаток от 3&nbsp;мкКл.</figcaption>
</figure>

<style is:global>
	[data-connlab] .cl__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	[data-connlab] .cl__plate {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-connlab] .cl__bat {
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
	}
	[data-connlab] .cl__bat.is-short {
		stroke-width: 4.5;
	}
	[data-connlab] .cl__i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	[data-connlab] .cl__sub {
		font-size: 9px;
	}
	[data-connlab] .cl__s {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-connlab] .cl__s.is-p {
		stroke: var(--g7-red);
	}
	[data-connlab] .cl__s.is-m {
		stroke: var(--g7-blue);
	}
	[data-connlab] .g7__read li span {
		min-width: 0;
	}
</style>

<script>
	import { loop, fmtTrim } from '../g7/kit';

	const NS = 'http://www.w3.org/2000/svg';
	const U = 12;
	const ROWS = [-9, 9, -18, 18, -27, 27, -36, 36, -45, 45]; // from the middle out; the wire's row (0) stays empty
	// the plates: x of the plate's face where its signs stand, the side of the signs, the middle y, the sign
	type Plate = { x: number; side: -1 | 1; y: number; plus: boolean; cap: 0 | 1; inner?: boolean };
	const PLATES: Record<'par' | 'ser', Plate[]> = {
		par: [
			{ x: 134, side: -1, y: 60, plus: true, cap: 0 },
			{ x: 178, side: 1, y: 60, plus: false, cap: 0 },
			{ x: 134, side: -1, y: 172, plus: true, cap: 1 },
			{ x: 178, side: 1, y: 172, plus: false, cap: 1 },
		],
		ser: [
			{ x: 100, side: -1, y: 104, plus: true, cap: 0 },
			{ x: 138, side: 1, y: 104, plus: false, cap: 0, inner: true },
			{ x: 188, side: -1, y: 104, plus: true, cap: 1, inner: true },
			{ x: 226, side: 1, y: 104, plus: false, cap: 1 },
		],
	};
	const solve = (mode: 'par' | 'ser', c1: number, c2: number) => {
		if (mode === 'par') return { q: [c1 * U, c2 * U], u: [U, U], C: c1 + c2 };
		const C = (c1 * c2) / (c1 + c2);
		const q = C * U;
		return { q: [q, q], u: [q / c1, q / c2], C };
	};
	/** A sign in column `col` (0 next to the plate) at row offset `row`. */
	const sign = (p: Plate, col: number, row: number, small: boolean) => {
		const x = p.x + p.side * (8 + col * 10);
		const y = p.y + row;
		const h = small ? 1.6 : 2.6;
		const d = p.plus ? `M${x - h} ${y} h${2 * h} M${x} ${y - h} v${2 * h}` : `M${x - h} ${y} h${2 * h}`;
		const e = document.createElementNS(NS, 'path');
		e.setAttribute('class', `cl__s ${p.plus ? 'is-p' : 'is-m'}`);
		e.setAttribute('d', d);
		return e;
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-connlab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const c1 = $<HTMLInputElement>('[data-cap="1"]');
		const c2 = $<HTMLInputElement>('[data-cap="2"]');
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
		const signsG = $<SVGGElement>('[data-signs]');
		let mode: 'par' | 'ser' = 'par';
		// shown charges of the two capacitors (outer and inner plates separately) and their targets
		let shown = [0, 0, 0, 0];
		let from = [0, 0, 0, 0];
		let t = 1; // s since the last change
		const target = () => {
			const s = solve(mode, +c1.value, +c2.value);
			return [s.q[0], s.q[0], s.q[1], s.q[1]];
		};
		const drawSigns = () => {
			signsG.replaceChildren();
			PLATES[mode].forEach((p, i) => {
				const q = shown[i];
				const n = Math.min(20, Math.floor(q / 6 + 1e-9));
				const rest = q - 6 * n;
				const m = n + (n < 20 && rest >= 3 - 1e-9 ? 1 : 0); // the last one small
				// one column up to 10 signs, else two columns of (nearly) equal length, each from the middle out
				const cols = m > 10 ? 2 : 1;
				let k = 0;
				for (let c = 0; c < cols; c++) {
					const size = Math.floor(m / cols) + (c < m % cols ? 1 : 0);
					for (let i = 0; i < size; i++, k++) signsG.append(sign(p, c, ROWS[i], k >= n));
				}
			});
		};
		const read = () => {
			const s = solve(mode, +c1.value, +c2.value);
			$('[data-oc1]').textContent = `${c1.value} мкФ`;
			$('[data-oc2]').textContent = `${c2.value} мкФ`;
			$('[data-r1]').textContent = `${fmtTrim(s.q[0], 1)} мкКл; ${fmtTrim(s.u[0], 1)} В`;
			$('[data-r2]').textContent = `${fmtTrim(s.q[1], 1)} мкКл; ${fmtTrim(s.u[1], 1)} В`;
			const qb = mode === 'par' ? s.q[0] + s.q[1] : s.q[0];
			$('[data-rb]').textContent = `${fmtTrim(qb, 1)} мкКл; ${U} В`;
			$('[data-rc]').textContent = `${fmtTrim(s.C, 1)} мкФ`;
			$<SVGGElement>('[data-par]').style.display = mode === 'par' ? '' : 'none';
			$<SVGGElement>('[data-ser]').style.display = mode === 'ser' ? '' : 'none';
		};
		const wake = loop(root, (dt) => {
			t += dt;
			const goal = target();
			const inner = PLATES[mode].map((p) => !!p.inner);
			shown = goal.map((g, i) => {
				const k = Math.min(1, Math.max(0, (t - (inner[i] ? 0.25 : 0)) / 0.5));
				return from[i] + (g - from[i]) * k * k * (3 - 2 * k);
			});
			drawSigns();
			return t < 0.8;
		});
		const change = (reset: boolean) => {
			from = reset ? [0, 0, 0, 0] : shown.slice();
			t = 0;
			read();
			wake();
		};
		btns.forEach((b) =>
			b.addEventListener('click', () => {
				mode = b.dataset.mode as 'par' | 'ser';
				btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				change(true);
			}),
		);
		c1.addEventListener('input', () => change(false));
		c2.addEventListener('input', () => change(false));
		shown = target();
		read();
		drawSigns();
	}
</script>
