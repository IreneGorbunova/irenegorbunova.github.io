---
/**
 * «Где это встречается»: five small pictures in the order of the list (3 + 2 on a wide screen, one column on a phone).
 *   Дефибриллятор: the device with its two electrodes and the energy on its screen (200 Дж).
 *   Клавиатура (animated, a loop of 3 s): a key in section; under it two plates, the upper one on the key. A press
 *     brings them from 3,5 мм to 1 мм apart (drawn 4 px per мм), so the capacity grows 3,5 times (C ∝ 1/d): the violet
 *     bar «C» (violet = capacity in the chapter) jumps up while the key is down.
 *   Сенсорный экран (animated, a loop of 6 s): the glass in section, two transparent electrodes under it, the gray field
 *     lines between them, some of them bulging above the glass. A bare finger (the people kit's hand, pointing down)
 *     touches the glass: two of the four lines now end on the finger, a conductor joined to the body, and the change of
 *     the capacity at that crossing, the bar «ΔC», is large. Then a finger in a knitted glove: the skin stays farther
 *     from the electrodes, only part of one line moves, and ΔC is about a fifth (a scheme, not to scale).
 *   Микрофон: a thin membrane in front of a fixed plate.
 *   Электробус: an electric bus that tops up its capacitors at a stop through a current collector on its roof.
 * Schemes, not photographs. The radio's variable capacitor moved to KindsPicture.
 */
import G7Styles from '../g7/G7Styles.astro';
import PeopleStyles from '@components/people/PeopleStyles.astro';

// the touch screen: the field lines between the electrodes (quadratic curves), their heights above the electrodes
const TL = [6, 12, 21, 31];
---

<G7Styles />
<PeopleStyles />
<figure class="g7 g7--pic us not-content" data-usespic>
	<div class="g7__grid us__grid">
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Дефибриллятор: прибор с экраном, на котором 200 джоулей, и два электрода на проводах">
			<rect class="us__box" x="20" y="34" width="92" height="62" rx="8"></rect>
			<rect class="us__screen" x="30" y="44" width="46" height="24" rx="2"></rect>
			<text class="t-strong t-num" x="53" y="61" text-anchor="middle">200 Дж</text>
			<circle class="us__btn" cx="94" cy="56" r="8"></circle>
			<path class="us__bolt" d="M95 50 L91 57 H96 L93 63"></path>
			<rect class="us__handle" x="40" y="26" width="52" height="8" rx="3"></rect>
			<path class="us__cable" d="M112 80 Q140 92 146 70 M112 86 Q150 112 170 84"></path>
			<rect class="us__pad" x="140" y="52" width="16" height="22" rx="4"></rect>
			<rect class="us__pad" x="164" y="66" width="16" height="22" rx="4"></rect>
			<text class="t-title" x="100" y="120" text-anchor="middle">Дефибриллятор</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Клавиатура: под клавишей две пластины; нажатие сближает их, и ёмкость растёт" data-keyb>
			<rect class="us__board" x="20" y="82" width="130" height="8" rx="1"></rect>
			<g data-key>
				<path class="us__keycap" d="M52 24 H118 L124 46 H46 Z"></path>
				<rect class="us__stem" x="80" y="46" width="10" height="14"></rect>
				<rect class="us__plate" x="56" y="60" width="58" height="4" rx="1"></rect>
			</g>
			<path class="us__spring" data-spring></path>
			<rect class="us__plate" x="56" y="78" width="58" height="4" rx="1"></rect>
			<text class="t-small" x="121" y="77">пластины</text>
			<path class="us__lead" data-plead></path>
			<!-- the capacity bar -->
			<rect class="us__barbg" x="180" y="22" width="12" height="74" rx="2"></rect>
			<rect class="us__barf" data-kbar x="180" width="12" rx="2"></rect>
			<text class="t-small" x="186" y="110" text-anchor="middle"><tspan class="t-i">C</tspan></text>
			<text class="t-title" x="100" y="124" text-anchor="middle">Клавиатура</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Сенсорный экран: под стеклом прозрачные проводники и поле между ними; голый палец забирает часть линий поля, палец в перчатке — почти нет" data-touch>
			<rect class="us__glass" x="8" y="70" width="158" height="12"></rect>
			<rect class="us__base" x="8" y="90" width="158" height="6"></rect>
			<g data-tl>
				{TL.map(() => <path class="us__fl" />)}
			</g>
			<rect class="us__elec" x="66" y="83" width="24" height="5" rx="1"></rect>
			<rect class="us__elec" x="110" y="83" width="24" height="5" rx="1"></rect>
			<g data-fbare></g>
			<g data-fglove></g>
			<text class="t-small" x="10" y="66">стекло</text>
			<text class="t-small" x="100" y="110" text-anchor="middle">прозрачные проводники</text>
			<rect class="us__barbg" x="176" y="22" width="12" height="74" rx="2"></rect>
			<rect class="us__barf" data-tbar x="176" width="12" rx="2"></rect>
			<text class="t-small" x="182" y="110" text-anchor="middle">Δ<tspan class="t-i">C</tspan></text>
			<text class="t-title" x="100" y="124" text-anchor="middle">Сенсорный экран</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Конденсаторный микрофон: тонкая мембрана перед неподвижной пластиной; звук колеблет мембрану, и меняется ёмкость">
			<path class="us__wave" d="M20 40 q6 10 0 20 q-6 10 0 20 M32 36 q8 14 0 28 q-8 14 0 28 M44 32 q10 18 0 36 q-10 18 0 36"></path>
			<rect class="us__mem" x="76" y="26" width="3" height="78" rx="1"></rect>
			<rect class="us__back" x="96" y="26" width="8" height="78" rx="1.5"></rect>
			<path class="us__cable" d="M77.5 104 V112 H150 M100 104 V108 H150"></path>
			<rect class="us__case" x="70" y="20" width="44" height="90" rx="6"></rect>
			<text class="t-small" x="70" y="16" text-anchor="middle">мембрана</text>
			<path class="us__lead" d="M133 60 L105 52"></path>
			<text class="t-small" x="136" y="64">пластина</text>
			<text class="t-title" x="100" y="126" text-anchor="middle">Микрофон</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Электробус на остановке: через токоприёмник на крыше за несколько десятков секунд подзаряжает конденсаторы большой ёмкости">
			<path class="us__wirep" d="M10 14 H190"></path>
			<path class="us__pole" d="M150 14 V96"></path>
			<rect class="us__bus" x="22" y="44" width="124" height="48" rx="8"></rect>
			{[0, 1, 2, 3].map((i) => <rect class="us__win" x={32 + i * 26} y="52" width="20" height="16" rx="2" />)}
			<rect class="us__door" x="128" y="54" width="12" height="34" rx="1"></rect>
			<path class="us__pant" d="M84 44 L96 24 L108 14 M96 24 L112 30"></path>
			<rect class="us__capbox" x="30" y="36" width="40" height="8" rx="2"></rect>
			<circle class="us__wheel" cx="50" cy="94" r="9"></circle>
			<circle class="us__wheel" cx="120" cy="94" r="9"></circle>
			<rect class="us__road" x="0" y="103" width="200" height="4"></rect>
			<text class="t-small" x="8" y="31">конденсаторы</text>
			<text class="t-title" x="100" y="122" text-anchor="middle">Электробус</text>
		</svg>
	</div>
</figure>

<style is:global>
	[data-usespic] .us__box,
	[data-usespic] .us__case {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-usespic] .us__case {
		fill: none;
	}
	[data-usespic] .us__screen {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-gray-3);
	}
	[data-usespic] .us__btn {
		fill: var(--g7-red);
	}
	[data-usespic] .us__bolt {
		fill: none;
		stroke: white;
		stroke-width: 1.6;
	}
	[data-usespic] .us__handle {
		fill: var(--sl-color-gray-4);
	}
	[data-usespic] .us__cable,
	[data-usespic] .us__wirep {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	[data-usespic] .us__pad {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-usespic] .us__wave {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.6;
	}
	[data-usespic] .us__mem {
		fill: var(--sl-color-gray-2);
	}
	[data-usespic] .us__back {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
	}
	[data-usespic] .us__pole {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-usespic] .us__bus {
		fill: color-mix(in oklab, hsl(150, 50%, 45%) 60%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-usespic] .us__win,
	[data-usespic] .us__door {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-5));
	}
	[data-usespic] .us__pant {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-usespic] .us__capbox {
		fill: var(--g7-steel-dark);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-usespic] .us__wheel {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-usespic] .us__road {
		fill: var(--sl-color-gray-4);
	}
	[data-usespic] .us__grid {
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.6rem;
	}
	[data-usespic] .us__grid > svg {
		grid-column: span 2;
	}
	[data-usespic] .us__grid > svg:nth-child(4) {
		grid-column: 2 / span 2;
	}
	@container (max-width: 36rem) {
		[data-usespic] .us__grid {
			grid-template-columns: minmax(0, 1fr);
			max-width: 20rem;
			margin-inline: auto;
		}
		[data-usespic] .us__grid > svg,
		[data-usespic] .us__grid > svg:nth-child(4) {
			grid-column: auto;
		}
	}
	[data-usespic] .us__board {
		fill: color-mix(in oklab, hsl(150, 40%, 35%) 60%, var(--sl-color-gray-4));
	}
	[data-usespic] .us__keycap {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	[data-usespic] .us__stem {
		fill: var(--sl-color-gray-4);
	}
	[data-usespic] .us__plate,
	[data-usespic] .us__elec {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-usespic] .us__spring,
	[data-usespic] .us__lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-usespic] .us__barbg {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-usespic] .us__barf {
		fill: var(--g7-violet);
	}
	[data-usespic] .us__glass {
		fill: color-mix(in oklab, var(--ig-vx) 22%, transparent);
		stroke: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-2));
		stroke-width: 0.8;
	}
	[data-usespic] .us__base {
		fill: var(--sl-color-gray-5);
	}
	[data-usespic] .us__fl {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	[data-usespic] .kd-sleeve-us {
		stroke: color-mix(in oklab, hsl(205, 50%, 45%) 60%, var(--sl-color-gray-4));
	}
	[data-usespic] .hm-glove {
		fill: hsl(205, 45%, 40%);
	}
</style>

<script>
	import { loop } from '../g7/kit';
	import { DEG } from '@components/people';
	import { kdArm } from './kdArm';

	const TL = [6, 12, 21, 31];
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-usespic]')) {
		// ---- the keyboard: 3,5 мм → 1 мм between the plates (4 px per мм), C ∝ 1/d
		{
			const svg = root.querySelector<SVGSVGElement>('[data-keyb]')!;
			const key = svg.querySelector<SVGGElement>('[data-key]')!;
			const spring = svg.querySelector<SVGPathElement>('[data-spring]')!;
			const lead = svg.querySelector<SVGPathElement>('[data-plead]')!;
			const bar = svg.querySelector<SVGRectElement>('[data-kbar]')!;
			let t = 0;
			const draw = () => {
				// rest 1 s, press 0,25 s, held 0,8 s, release 0,25 s, rest
				const k = ease((t - 1) / 0.25) * (1 - ease((t - 2.05) / 0.25));
				const dmm = 3.5 - 2.5 * k;
				const dy = (3.5 - dmm) * 4; // the key goes down by as much as the gap closes
				key.setAttribute('transform', `translate(0 ${dy.toFixed(1)})`);
				const top = 64 + dy;
				const n = 6;
				let d = `M100 ${top}`;
				for (let i = 1; i <= n; i++) d += ` L${i % 2 ? 106 : 94} ${(top + ((78 - top) * (i - 0.5)) / n).toFixed(1)}`;
				spring.setAttribute('d', `${d} L100 78`);
				lead.setAttribute('d', `M120 71 L115 ${(63 + dy).toFixed(1)} M120 75 L115 79`);
				const h = (74 * 1) / dmm; // 21 px at rest, 74 px pressed
				bar.setAttribute('y', (96 - h).toFixed(1));
				bar.setAttribute('height', h.toFixed(1));
			};
			loop(svg, (dt) => {
				t = (t + dt) % 3;
				draw();
				return true;
			});
			draw();
		}
		// ---- the touch screen
		{
			const svg = root.querySelector<SVGSVGElement>('[data-touch]')!;
			const lines = [...svg.querySelectorAll<SVGPathElement>('.us__fl')];
			const gBare = svg.querySelector<SVGGElement>('[data-fbare]')!;
			const gGlove = svg.querySelector<SVGGElement>('[data-fglove]')!;
			const bare = kdArm(gBare, { Lh: 110, side: 'R', sleeve: 'kd-sleeve-us', bare: 0.3 });
			const glove = kdArm(gGlove, { Lh: 110, side: 'R', sleeve: 'kd-sleeve-us', covering: 'glove', bare: 0 });
			const bar = svg.querySelector<SVGRectElement>('[data-tbar]')!;
			const TIP = { x: 100, y: 70 };
			let t = 0;
			const draw = () => {
				// 0–0,5 s the bare finger comes down, touches till 2,3 s, goes up by 2,8 s; 3–5,8 s the same in a glove
				const gl = t >= 2.9;
				const tt = gl ? t - 3 : t;
				const down = ease(tt / 0.5) * (1 - ease((tt - 2.3) / 0.5));
				const touch = ease((tt - 0.4) / 0.3) * (1 - ease((tt - 2.3) / 0.2));
				gBare.style.display = gl ? 'none' : '';
				gGlove.style.display = gl ? '' : 'none';
				(gl ? glove : bare)({ at: { x: TIP.x, y: TIP.y - 60 * (1 - down) }, pose: 'point', dir: 92 * DEG, roll: -Math.PI / 2 });
				// the lines: from the left electrode to the right one; the high ones end on a bare finger
				const pull = gl ? [0, 0, 0, 0.45] : [0, 0, 1, 1];
				lines.forEach((l, i) => {
					const k = pull[i] * touch;
					const s = { x: 84 - 4 * i, y: 83 };
					const e0 = { x: 116 + 4 * i, y: 83 };
					const c0 = { x: 100, y: 83 - 2 * TL[i] };
					const e1 = { x: TIP.x + (i - 2.5) * 3, y: TIP.y + 1 };
					const c1 = { x: 84 - 4 * i, y: 60 - 3 * i };
					const e = { x: e0.x + (e1.x - e0.x) * k, y: e0.y + (e1.y - e0.y) * k };
					const c = { x: c0.x + (c1.x - c0.x) * k, y: c0.y + (c1.y - c0.y) * k };
					l.setAttribute('d', `M${s.x} ${s.y} Q${c.x.toFixed(1)} ${c.y.toFixed(1)} ${e.x.toFixed(1)} ${e.y.toFixed(1)}`);
				});
				const h = 70 * touch * (gl ? 0.2 : 1);
				bar.setAttribute('y', (96 - h).toFixed(1));
				bar.setAttribute('height', h.toFixed(1));
			};
			loop(svg, (dt) => {
				t = (t + dt) % 6;
				draw();
				return true;
			});
			draw();
		}
	}
</script>
