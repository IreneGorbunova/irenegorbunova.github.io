---
/**
 * «Где это встречается»: four small static pictures — a defibrillator with its two electrodes and the energy on its
 * screen (200 Дж); the variable capacitor of a radio (the rotor plates slide between the stator plates when the knob
 * turns); a condenser microphone (a thin membrane in front of a fixed plate); an electric bus that tops up its
 * capacitors at a stop through a current collector on its roof. Schemes, not photographs.
 */
import G7Styles from '../g7/G7Styles.astro';

const stator = [0, 1, 2, 3, 4].map((i) => 30 + i * 9);
---

<G7Styles />
<figure class="g7 g7--pic us not-content" data-usespic>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Дефибриллятор: прибор с экраном, на котором 200 джоулей, и два электрода на проводах">
			<rect class="us__box" x="20" y="34" width="92" height="62" rx="8"></rect>
			<rect class="us__screen" x="30" y="44" width="46" height="24" rx="2"></rect>
			<text class="t-strong t-num" x="53" y="61" text-anchor="middle">200 Дж</text>
			<circle class="us__btn" cx="94" cy="56" r="8"></circle>
			<path class="us__bolt" d="M95 50 L91 57 H96 L93 63"></path>
			<rect class="us__handle" x="40" y="26" width="52" height="8" rx="3"></rect>
			<path class="us__cable" d="M112 80 Q140 92 146 70 M112 86 Q150 112 170 84"></path>
			<rect class="us__pad" x="140" y="52" width="16" height="22" rx="4"></rect>
			<rect class="us__pad" x="164" y="66" width="16" height="22" rx="4"></rect>
			<text class="t-title" x="100" y="120" text-anchor="middle">Дефибриллятор</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Конденсатор переменной ёмкости радиоприёмника: подвижные пластины входят между неподвижными, когда поворачивают ручку">
			{stator.map((y) => <rect class="us__stator" x="40" y={y} width="70" height="3" rx="1" />)}
			{stator.slice(0, 4).map((y) => <path class="us__rotor" d={`M84 ${y + 4.5} H140`} />)}
			<rect class="us__axle" x="138" y="28" width="5" height="44" rx="2"></rect>
			<circle class="us__knob" cx="160" cy="50" r="14"></circle>
			<path class="us__mark" d="M160 50 L168 40"></path>
			<path class="us__arrow" d="M150 82 Q160 90 172 82"></path>
			<path class="us__arrowh" d="M174 80 l-6 1 l3 5 Z"></path>
			<text class="t-small" x="74" y="22" text-anchor="middle">неподвижные пластины</text>
			<text class="t-small" x="104" y="88" text-anchor="middle">подвижные</text>
			<text class="t-title" x="100" y="120" text-anchor="middle">Настройка радиоприёмника</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Конденсаторный микрофон: тонкая мембрана перед неподвижной пластиной; звук колеблет мембрану, и меняется ёмкость">
			<path class="us__wave" d="M20 40 q6 10 0 20 q-6 10 0 20 M32 36 q8 14 0 28 q-8 14 0 28 M44 32 q10 18 0 36 q-10 18 0 36"></path>
			<rect class="us__mem" x="76" y="26" width="3" height="78" rx="1"></rect>
			<rect class="us__back" x="96" y="26" width="8" height="78" rx="1.5"></rect>
			<path class="us__cable" d="M77.5 104 V112 H150 M100 104 V108 H150"></path>
			<rect class="us__case" x="70" y="20" width="44" height="90" rx="6"></rect>
			<text class="t-small" x="70" y="16" text-anchor="middle">мембрана</text>
			<text class="t-small" x="136" y="64">пластина</text>
			<text class="t-title" x="100" y="126" text-anchor="middle">Микрофон</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 200 130" role="img" aria-label="Электробус на остановке: через токоприёмник на крыше за несколько секунд подзаряжает конденсаторы большой ёмкости">
			<path class="us__wirep" d="M10 14 H190"></path>
			<path class="us__pole" d="M150 14 V96"></path>
			<rect class="us__bus" x="22" y="44" width="124" height="48" rx="8"></rect>
			{[0, 1, 2, 3].map((i) => <rect class="us__win" x={32 + i * 26} y="52" width="20" height="16" rx="2" />)}
			<rect class="us__door" x="128" y="54" width="12" height="34" rx="1"></rect>
			<path class="us__pant" d="M84 44 L96 24 L108 14 M96 24 L112 30"></path>
			<rect class="us__capbox" x="30" y="36" width="40" height="8" rx="2"></rect>
			<circle class="us__wheel" cx="50" cy="94" r="9"></circle>
			<circle class="us__wheel" cx="120" cy="94" r="9"></circle>
			<rect class="us__road" x="0" y="103" width="200" height="4"></rect>
			<text class="t-small" x="8" y="31">конденсаторы</text>
			<text class="t-title" x="100" y="122" text-anchor="middle">Электробус</text>
		</svg>
	</div>
</figure>

<style is:global>
	[data-usespic] .us__box,
	[data-usespic] .us__case {
		fill: var(--sl-color-gray-5);
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-usespic] .us__case {
		fill: none;
	}
	[data-usespic] .us__screen {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-gray-3);
	}
	[data-usespic] .us__btn {
		fill: var(--g7-red);
	}
	[data-usespic] .us__bolt {
		fill: none;
		stroke: white;
		stroke-width: 1.6;
	}
	[data-usespic] .us__handle {
		fill: var(--sl-color-gray-4);
	}
	[data-usespic] .us__cable,
	[data-usespic] .us__wirep {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.6;
	}
	[data-usespic] .us__pad {
		fill: var(--g7-gold);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-usespic] .us__stator {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
	}
	[data-usespic] .us__rotor {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 3;
	}
	[data-usespic] .us__axle {
		fill: var(--sl-color-gray-3);
	}
	[data-usespic] .us__knob {
		fill: var(--sl-color-gray-4);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-usespic] .us__mark,
	[data-usespic] .us__arrow {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 1.6;
	}
	[data-usespic] .us__arrowh {
		fill: var(--sl-color-white);
	}
	[data-usespic] .us__wave {
		fill: none;
		stroke: var(--g7-blue);
		stroke-width: 1.6;
	}
	[data-usespic] .us__mem {
		fill: var(--g7-gold);
	}
	[data-usespic] .us__back {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.5;
	}
	[data-usespic] .us__pole {
		stroke: var(--sl-color-gray-3);
		stroke-width: 2;
	}
	[data-usespic] .us__bus {
		fill: color-mix(in oklab, hsl(150, 50%, 45%) 60%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-usespic] .us__win,
	[data-usespic] .us__door {
		fill: color-mix(in oklab, var(--ig-vx) 35%, var(--sl-color-gray-5));
	}
	[data-usespic] .us__pant {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-usespic] .us__capbox {
		fill: var(--g7-gold);
	}
	[data-usespic] .us__wheel {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-usespic] .us__road {
		fill: var(--sl-color-gray-4);
	}
</style>
