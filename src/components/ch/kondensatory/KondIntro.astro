<script>
	import { scene } from '@components/intro/scene';
	import { DEG, figure, mk, type FigurePose, type Pt, type HandShape, type V3 } from '@components/people';
	import { kdArm } from './kdArm';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
	const lerpP = (a: Pt, b: Pt, k: number): Pt => ({ x: lerp(a.x, b.x, k), y: lerp(a.y, b.y, k) });
	// a 3D direction scaled to a length (the thumb's bones of the kit: 0,24, 0,17, 0,13 hand lengths)
	const step = (p: V3, d: V3, l: number): V3 => {
		const n = Math.hypot(d[0], d[1], d[2]);
		return [p[0] + (d[0] / n) * l, p[1] + (d[1] / n) * l, p[2] + (d[2] / n) * l];
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-kondintro]')) {
		// ---------- the glove ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="glove"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const glove = $<SVGGElement>('[data-glove]');
			const bare = $<SVGGElement>('[data-bare]');
			// the phone is turned by −6° about (150, 116)
			const R6 = -6 * DEG;
			const rot = (p: Pt): Pt => ({ x: 150 + (p.x - 150) * Math.cos(R6) - (p.y - 116) * Math.sin(R6), y: 116 + (p.x - 150) * Math.sin(R6) + (p.y - 116) * Math.cos(R6) });
			// 11 px per см: a hand of 18 см is 198 px, a mitten of 20 см 220 px
			const tapG = kdArm(glove, { Lh: 198, side: 'R', sleeve: 'kd-sleeve-coat', covering: 'glove', bare: 0 });
			const tapB = kdArm(bare, { Lh: 198, side: 'R', sleeve: 'kd-sleeve-coat', bare: 0.18 });
			// the left mitten: the four fingers straight up behind the phone, the thumb round the left edge onto the front
			// (local frame of the kit: x along the fingers, y out of the back of the hand, z toward the thumb)
			const TB: V3 = [0.08, -0.03, 0.11];
			// the three bones turn by about 30° each, so the thumb bends smoothly round the edge
			const j1 = step(TB, [0.2, -0.04, 0.06], 0.24);
			const j2 = step(j1, [0.16, -0.09, -0.02], 0.17);
			const tip = step(j2, [0.1, -0.03, -0.06], 0.13);
			const mShape: HandShape = { f: [0, 1, 2, 3].map(() => [5 * DEG, 5 * DEG, 3 * DEG]), s: [2 * DEG, 0, -2 * DEG, -4 * DEG], th: [j1, j2, tip] };
			const mit = kdArm($<SVGGElement>('[data-mitten]'), { Lh: 220, side: 'L', sleeve: 'kd-sleeve-coat2', covering: 'mitten', bare: 0, back: $<SVGGElement>('[data-mback]'), armBehind: true });
			// the left edge of the phone at the middle of its thickness meets the web of the thumb (local point E)
			mit({ at: rot({ x: 111.5, y: 192 }), pose: 'grip', shape: mShape, contact: [0.33, -0.07, 0.17], dir: -96 * DEG, roll: Math.PI / 2 });
			const app = $<SVGGElement>('[data-app]');
			const ripple = $<SVGCircleElement>('[data-ripple]');
			const flakes = [...card.querySelectorAll<SVGCircleElement>('.kd-flake')].map((c) => ({ c, x: +c.getAttribute('cx')!, y: +c.getAttribute('cy')!, r: +c.getAttribute('r')! }));
			// the tip of the index finger touches the bus app (150, 166 on the phone)
			const TIP = rot({ x: 150, y: 166 });
			const NEAR = { x: TIP.x + 9, y: TIP.y - 2 };
			const OUT = { x: 400, y: 186 };
			const tapAt = (t: number, t0: number) => (t >= t0 && t < t0 + 0.3 ? Math.sin(((t - t0) / 0.3) * Math.PI) : 0);
			scene(card, 9, (x) => {
				const t = x * 9;
				// where the fingertip is: in, two taps, out, back bare, one tap, out
				let p = OUT;
				let gloved = true;
				if (t < 1) p = lerpP(OUT, NEAR, ease(t));
				else if (t < 2.4) p = lerpP(NEAR, TIP, tapAt(t, 1.2) + tapAt(t, 1.8));
				else if (t < 3.3) p = lerpP(NEAR, OUT, ease((t - 2.4) / 0.9));
				else {
					gloved = false;
					if (t < 4.3) p = lerpP(OUT, NEAR, ease((t - 3.4) / 0.9));
					else if (t < 5.4) p = lerpP(NEAR, TIP, tapAt(t, 4.6));
					// the hand leaves the view as it came, so the loop starts again with the view empty
					else p = lerpP(NEAR, OUT, ease((t - 5.4) / 1));
				}
				// the right hand from the right, its back to us, the index finger out, pointing a little down
				(gloved ? tapG : tapB)({ at: p, pose: 'point', dir: 176 * DEG, roll: -Math.PI / 2, bend: -8 * DEG });
				glove.style.display = gloved ? '' : 'none';
				bare.style.display = gloved ? 'none' : '';
				// only the bare finger makes the screen answer
				const touch = t > 4.7 ? Math.min(1, (t - 4.7) / 0.3) : 0;
				ripple.setAttribute('r', (touch > 0 && touch < 1 ? 13 * touch : 0).toFixed(1));
				app.setAttribute('opacity', String(ease((t - 4.9) / 0.4)));
				for (const f of flakes) {
					const y = ((f.y + t * 18 * f.r) % 250) - 5;
					const xx = f.x + 6 * Math.sin(t * 0.8 + f.y);
					f.c.setAttribute('cy', y.toFixed(1));
					f.c.setAttribute('cx', xx.toFixed(1));
				}
			});
		}
		// ---------- the flash ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="flash"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1;
			const FL = 228;
			const ANK = 7; // the ankle above the floor in trainers, см
			const H = 178;
			const u = S * H;
			const dadG = $<SVGGElement>('[data-dad]');
			const dad = figure(dadG, { s: S, H, clothes: 'indoor', shirt: 'hm-blue', hair: 'short', name: 'father' });
			// the camera between the body and the near arm: the near hand's fingers wrap round the grip in front of it
			const nearHand = dadG.querySelector(':scope > g > .pk-hand[data-hand="R"]')!;
			const limbOutline = nearHand.previousElementSibling!.previousElementSibling!;
			limbOutline.before($('[data-camback]'), $('[data-cam]'));
			const kidsG = $<SVGGElement>('[data-kids]');
			const kid1 = figure(mk(kidsG, 'g', {}), { s: S, H: 120, age: 'child', clothes: 'indoor', shirt: 'hm-red', hair: 'pony', dir: -1, name: 'girl' });
			const kid2 = figure(mk(kidsG, 'g', {}), { s: S, H: 132, age: 'child', clothes: 'indoor', shirt: 'hm-gold', hair: 'short', dir: -1, name: 'boy' });
			const cam = $<SVGGElement>('[data-cam]');
			const ready = $<SVGCircleElement>('[data-ready]');
			const beam = $<SVGPathElement>('[data-beam]');
			const lit = $<SVGRectElement>('[data-lit]');
			const head = $<SVGRectElement>('[data-head]');
			const fires = [...card.querySelectorAll<SVGPathElement>('[data-fire]')];
			const hip = { x: 70, y: FL - ANK - 0.99 * 0.475 * u };
			// the eye: head center 0,40 H above the hip joint, the eye 0,56 of the head radius in front of it
			const eye = { x: hip.x + 0.1 * 0.15 * u + Math.sin(0.03) * 0.4 * u + 0.56 * 0.064 * u, y: hip.y - 0.4 * u };
			// the children sit on high chairs (seat 55 см), facing the camera (to the left), hands on the table
			const sit = (x: number, uu: number, wave: number): FigurePose => {
				const hp = { x, y: FL - 55 - 0.03 * uu };
				const handY = 149;
				const raise = ease(wave);
				return {
					hip: hp,
					lean: 0.05,
					ankles: [hp, hp],
					legs: [
						[Math.PI - 0.05, 1.5],
						[Math.PI - 0.02, 1.45],
					],
					feet: [0.1, 0.1],
					hands: [
						wave > 0
							? { at: lerpP({ x: x - 0.2 * uu, y: handY }, { x: x - 0.14 * uu, y: hp.y - 0.36 * uu }, raise), pose: raise > 0.5 ? 'open' : 'flat', roll: lerp(0, -Math.PI / 2, raise), contact: raise < 0.05 ? 'table' : '' }
							: { at: { x: x - 0.2 * uu, y: handY }, pose: 'flat', dir: Math.PI, roll: 0, contact: 'table' },
						{ at: { x: x - 0.16 * uu, y: handY }, pose: 'flat', dir: Math.PI, roll: 0, contact: 'table' },
					],
				};
			};
			scene(card, 7, (x) => {
				const t = x * 7;
				// the camera comes up to the eye in 0,6 s and goes down after 5,6 s
				const up = ease(t / 0.6) * (1 - ease((t - 5.6) / 0.8));
				// at rest the camera is held in front of the belly; up, its back is at the eye
				const camP = lerpP({ x: hip.x + 0.17 * u, y: hip.y - 0.06 * u }, { x: eye.x + 15, y: eye.y }, up);
				cam.setAttribute('transform', `translate(${camP.x.toFixed(1)} ${camP.y.toFixed(1)})`);
				dad({
					hip,
					lean: 0.03,
					ankles: [
						{ x: hip.x + 0.03 * u, y: FL - ANK },
						{ x: hip.x - 0.05 * u, y: FL - ANK },
					],
					feet: [0, 0],
					planted: [true, true],
					// the near hand grips the right side of the camera body (the back of the hand to us, the fingers wrapped
					// round the grip, the thumb on top), the far hand
					// holds the lens from below, its fingers up round the barrel (mostly hidden behind the camera)
					hands: [
						{ at: { x: camP.x + 1, y: camP.y + 1 }, pose: 'grip', d: 4, dir: -12 * DEG, roll: -0.6, contact: 'camera grip' },
						{ at: { x: camP.x + 13, y: camP.y + 1 }, pose: 'grip', d: 7, dir: -80 * DEG, roll: Math.PI / 2, contact: 'lens' },
					],
					head: 0.05,
				});
				// the ready lamp: charging 0,6–3,1 s; the flash at 3,4 s; charging again from 3,6 s
				const charge = t < 3.4 ? ease((t - 0.6) / 2.5) : ease((t - 3.6) / 2.5);
				ready.style.opacity = String(0.15 + 0.85 * charge);
				const f = t >= 3.4 && t < 3.8 ? 1 - (t - 3.4) / 0.4 : 0;
				lit.setAttribute('opacity', (0.7 * f).toFixed(2));
				beam.setAttribute('opacity', (0.35 * f).toFixed(2));
				beam.setAttribute('transform', `translate(${(camP.x + 9).toFixed(1)} ${(camP.y - 17).toFixed(1)})`);
				head.style.fill = f > 0 ? 'white' : '';
				kid1(sit(262, 120, 0));
				// the boy waves after the flash: up in 0,6 s, waves, down by 5,6 s
				const w = t < 3.9 ? 0 : t < 4.5 ? (t - 3.9) / 0.6 : t < 5.0 ? 1 : Math.max(0, 1 - (t - 5.0) / 0.6);
				const pose2 = sit(318, 132, w);
				if (w >= 1 && t < 5.0) {
					// the wave: the raised hand goes 3 px to and fro, its fingers straight on from the forearm
					const h = pose2.hands[0] as { at: Pt };
					h.at = { x: h.at.x + 3 * Math.sin((t - 4.5) * 14), y: h.at.y };
				}
				kid2(pose2);
				fires.forEach((p, i) => p.setAttribute('transform', `translate(0 ${(0.6 * Math.sin(t * 13 + i * 2)).toFixed(2)})`));
			});
		}
	}
</script>
