</style>

<script>
	import { scene } from '@components/intro/scene';
	import { human, type HumanPose } from '../mehanicheskaya-rabota/people';
	import { armHand } from '../elektricheskiy-tok/armHand';

	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	const lerp = (a: number, b: number, k: number) => a + (b - a) * k;

	for (const root of document.querySelectorAll<HTMLElement>('[data-kondintro]')) {
		// ---------- the glove ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="glove"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const glove = $<SVGGElement>('[data-glove]');
			const bare = $<SVGGElement>('[data-bare]');
			const D = Math.PI / 180;
			const sleeve = 'color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4))';
			// 2,6 px per см: a hand of 19 см is 50 px from the wrist to the fingertips
			const tapG = armHand(glove, { Lh: 50, covering: 'glove', sleeve });
			const tapB = armHand(bare, { Lh: 50, sleeve });
			// the mitten round the left edge of the phone (the phone is turned by −6° about (141, 125))
			const mit = armHand($<SVGGElement>('[data-mitten]'), { Lh: 50, side: 'L', covering: 'mitten', sleeve });
			mit.backLayer($<SVGGElement>('[data-mback]'));
			const rot = (px: number, py: number) => ({ x: 141 + (px - 141) * Math.cos(-6 * D) - (py - 125) * Math.sin(-6 * D), y: 125 + (px - 141) * Math.sin(-6 * D) + (py - 125) * Math.cos(-6 * D) });
			mit.set({ at: rot(97, 168), pose: 'grip', d: 0.2, fore: -62 * D, dir: -6 * D, roll: 2.2 });
			const app = $<SVGGElement>('[data-app]');
			const ripple = $<SVGCircleElement>('[data-ripple]');
			const flakes = [...card.querySelectorAll<SVGCircleElement>('.kd-flake')].map((c) => ({ c, x: +c.getAttribute('cx')!, y: +c.getAttribute('cy')!, r: +c.getAttribute('r')! }));
			// the finger tip touches the bus icon at (151, 162) of the picture (the phone is turned by −6°)
			const TIP = { x: 151, y: 162 };
			const OUT = { x: 400, y: 150 };
			const tapAt = (t: number, t0: number) => (t >= t0 && t < t0 + 0.3 ? Math.sin(((t - t0) / 0.3) * Math.PI) : 0);
			scene(card, 9, (x) => {
				const t = x * 9;
				// where the hand is: in, two taps, out, back bare, one tap, rest
				let p = OUT;
				let gloved = true;
				if (t < 1) p = { x: lerp(OUT.x, TIP.x + 8, ease(t)), y: lerp(OUT.y, TIP.y, ease(t)) };
				else if (t < 2.4) p = { x: TIP.x + 8 - 8 * (tapAt(t, 1.2) + tapAt(t, 1.8)), y: TIP.y };
				else if (t < 3.2) p = { x: lerp(TIP.x + 8, OUT.x, ease((t - 2.4) / 0.8)), y: lerp(TIP.y, OUT.y + 20, ease((t - 2.4) / 0.8)) };
				else {
					gloved = false;
					if (t < 4.2) p = { x: lerp(OUT.x, TIP.x + 8, ease((t - 3.4) / 0.8)), y: lerp(OUT.y + 20, TIP.y, ease((t - 3.4) / 0.8)) };
					else if (t < 5.4) p = { x: TIP.x + 8 - 8 * tapAt(t, 4.6), y: TIP.y };
					// the hand leaves the view as it came, so the loop starts again without a jump
					else p = { x: lerp(TIP.x + 8, OUT.x, ease((t - 5.4) / 1)), y: lerp(TIP.y, OUT.y + 20, ease((t - 5.4) / 1)) };
				}
				// the right hand from the right, its back to us, the index finger out (fingers 8° below the horizontal)
				(gloved ? tapG : tapB).set({ at: p, pose: 'point', fore: 172 * D });
				glove.style.display = gloved ? '' : 'none';
				bare.style.display = gloved ? 'none' : '';
				// only the bare finger makes the screen answer
				const touch = t > 4.7 ? Math.min(1, (t - 4.7) / 0.3) : 0;
				ripple.setAttribute('r', (touch > 0 && touch < 1 ? 14 * touch : 0).toFixed(1));
				app.setAttribute('opacity', String(ease((t - 4.9) / 0.4)));
				for (const f of flakes) {
					const y = ((f.y + t * 18 * f.r) % 250) - 5;
					const xx = f.x + 6 * Math.sin(t * 0.8 + f.y);
					f.c.setAttribute('cy', y.toFixed(1));
					f.c.setAttribute('cx', xx.toFixed(1));
				}
			});
		}
		// ---------- the flash ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="flash"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const S = 1;
			const FL = 228;
			const H = 178;
			const u = S * H;
			const dad = human($<SVGGElement>('[data-dad]'), { s: S, H, shirt: 'hm-blue', hair: 'short' });
			const kid1 = human($<SVGGElement>('[data-kids]').appendChild(document.createElementNS('http://www.w3.org/2000/svg', 'g')), { s: S, H: 120, shirt: 'hm-red', hair: 'pony', dir: -1 });
			const kid2 = human($<SVGGElement>('[data-kids]').appendChild(document.createElementNS('http://www.w3.org/2000/svg', 'g')), { s: S, H: 132, shirt: 'hm-gold', hair: 'short', dir: -1 });
			const cam = $<SVGGElement>('[data-cam]');
			const ready = $<SVGCircleElement>('[data-ready]');
			const beam = $<SVGPathElement>('[data-beam]');
			const lit = $<SVGRectElement>('[data-lit]');
			const head = $<SVGRectElement>('[data-head]');
			const fires = [...card.querySelectorAll<SVGPathElement>('[data-fire]')];
			const dx = 70;
			const hip = { x: dx, y: FL - 0.505 * u };
			const A = 7 * S;
			// the children sit on chairs behind the table, facing the camera (to the left)
			const sit = (x: number, uu: number, seatY: number, wave: number): HumanPose => ({
				hip: { x, y: seatY },
				lean: 0,
				ankles: [
					{ x: x - 0.28 * uu, y: seatY + 0.22 * uu },
					{ x: x - 0.26 * uu, y: seatY + 0.22 * uu },
				],
				feet: [0, 0],
				hands: [
					{ x: x - 0.2 * uu, y: seatY - 0.05 * uu - wave },
					{ x: x - 0.18 * uu, y: seatY - 0.03 * uu },
				],
			});
			scene(card, 7, (x) => {
				const t = x * 7;
				// the camera comes up to the eye in 0,6 s and goes down after 5,6 s
				const up = ease(t / 0.6) * (1 - ease((t - 5.6) / 0.8));
				const eye = { x: hip.x + 0.04 * u + 10, y: hip.y - 0.42 * u };
				// at rest the camera is held in front of the belly, within reach of both hands
				const camP = { x: lerp(hip.x + 0.2 * u, eye.x + 8, up), y: lerp(hip.y - 0.04 * u, eye.y, up) };
				cam.setAttribute('transform', `translate(${camP.x.toFixed(1)} ${camP.y.toFixed(1)})`);
				dad({
					hip,
					lean: 0.03,
					ankles: [
						{ x: hip.x + 0.03 * u, y: FL - A },
						{ x: hip.x - 0.05 * u, y: FL - A },
					],
					feet: [0, 0],
					// the near hand holds the body of the camera, the far hand the lens from below
					hands: [
						{ x: camP.x - 7, y: camP.y + 4 },
						{ x: camP.x + 12, y: camP.y + 7 },
					],
					grips: [{ pose: 'grip' }, { pose: 'grip' }],
					head: 0.05,
				});
				// the ready lamp: charging 0,6–3,1 s; the flash at 3,4 s; charging again from 3,6 s
				const charge = t < 3.4 ? ease((t - 0.6) / 2.5) : ease((t - 3.6) / 2.5);
				ready.style.opacity = String(0.15 + 0.85 * charge);
				const f = t >= 3.4 && t < 3.8 ? 1 - (t - 3.4) / 0.4 : 0;
				lit.setAttribute('opacity', (0.7 * f).toFixed(2));
				beam.setAttribute('opacity', (0.35 * f).toFixed(2));
				beam.setAttribute('transform', `translate(${(camP.x + 9).toFixed(1)} ${(camP.y - 17).toFixed(1)})`);
				head.style.fill = f > 0 ? 'white' : '';
				kid1(sit(262, 120, 158, 0));
				kid2(sit(318, 132, 156, t > 3.9 && t < 5.6 ? 10 * Math.abs(Math.sin((t - 3.9) * 6)) : 0));
				fires.forEach((p, i) => p.setAttribute('transform', `translate(0 ${(0.6 * Math.sin(t * 13 + i * 2)).toFixed(2)})`));
			});
		}
	}
</script>
