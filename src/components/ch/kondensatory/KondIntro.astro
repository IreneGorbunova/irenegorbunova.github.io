---
/**
 * Two looping opening scenes of «Конденсаторы». No terms of the chapter in the pictures or in the visible captions.
 *
 * Glove: a close-up at a winter bus stop, about 2,6 px per сантиметр (a phone 7 × 15 см). A hand in a mitten holds a
 *   phone; the other hand, in a knitted glove, taps the bus app twice and nothing happens; the hand goes away, comes
 *   back without the glove, taps once — the app opens with the next buses. Real time.
 * Flash: a birthday at home, 1 px per сантиметр. A father (178 см) raises a camera with a flash unit; the ready lamp
 *   of the flash brightens as it charges (2,5 s); the flash fires: the room is lit for an instant (shown 0,4 s; a real
 *   flash lasts about a thousandth of a second); then the lamp goes dark and the flash starts charging again, as a
 *   real one does. Two children sit behind the table with a cake; the candles flicker.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
import PeopleStyles from '../mehanicheskaya-rabota/PeopleStyles.astro';

const icons = Array.from({ length: 12 }, (_, i) => ({ x: 108 + (i % 3) * 25, y: 72 + Math.floor(i / 3) * 27, c: ['a', 'b', 'c', 'd'][i % 4] }));
const flakes = Array.from({ length: 40 }, (_, i) => ({ x: (i * 71.3) % 360, y: (i * 43.7) % 240, r: 0.9 + ((i * 7) % 5) / 4 }));
// the birthday room
const FL2 = 228;
const stars = Array.from({ length: 14 }, (_, i) => ({ x: 252 + ((i * 23) % 76), y: 30 + ((i * 37) % 50) }));
const flags = Array.from({ length: 11 }, (_, i) => 20 + i * 30);
---

<PeopleStyles />
<IntroFrame data-kondintro>
	<div class="intro__card" data-scene="glove">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Зима, остановка. Рука в перчатке дважды нажимает на экран телефона, и ничего не происходит. Без перчатки палец касается экрана — и открывается расписание автобусов">
			<rect class="kd-sky" x="0" y="0" width="360" height="240"></rect>
			<path class="kd-house" d="M0 150 V96 H40 V80 H86 V110 H120 V150 Z M250 150 V90 H290 V70 H340 V150 Z"></path>
			<path class="kd-light" d="M10 104 h8 v8 h-8 Z M26 104 h8 v8 h-8 Z M50 90 h8 v8 h-8 Z M68 90 h8 v8 h-8 Z M50 124 h8 v8 h-8 Z M262 100 h8 v8 h-8 Z M300 82 h8 v8 h-8 Z M318 98 h8 v8 h-8 Z M300 114 h8 v8 h-8 Z"></path>
			<rect class="kd-snow" x="0" y="150" width="360" height="90"></rect>
			<rect class="kd-pole" x="44" y="40" width="4" height="200"></rect>
			<rect class="kd-sign" x="30" y="20" width="32" height="28" rx="3"></rect>
			<text class="kd-sign-a" x="46" y="41" text-anchor="middle">А</text>
			<!-- the snow falls behind the phone, so no flake lands on the screen text -->
			<g data-flakes>
				{flakes.map((f) => <circle class="kd-flake" cx={f.x} cy={f.y} r={f.r} />)}
			</g>
			<!-- the phone in a mitten -->
			<g data-mback></g>
			<g transform="rotate(-6 141 125)">
				<rect class="kd-phone" x="96" y="40" width="90" height="170" rx="13"></rect>
				<rect class="kd-screen" x="101" y="50" width="80" height="150" rx="6"></rect>
				<g data-home>
					<text class="kd-time" x="141" y="64" text-anchor="middle">8:12</text>
					{icons.map((ic) => <rect class={`kd-icon kd-icon--${ic.c}`} x={ic.x} y={ic.y} width="17" height="17" rx="4" />)}
					<path class="kd-busicon" d="M137 157 h12 v9 h-12 Z M139 159 h3 v3 h-3 Z M144 159 h3 v3 h-3 Z"></path>
				</g>
				<circle class="kd-ripple" data-ripple cx="143" cy="161" r="0"></circle>
				<g data-app opacity="0">
					<rect class="kd-app" x="101" y="50" width="80" height="150" rx="6"></rect>
					<text class="kd-app-t" x="141" y="70" text-anchor="middle">Остановка</text>
					<text class="kd-app-t" x="141" y="83" text-anchor="middle">«Школа»</text>
					<rect class="kd-row" x="108" y="94" width="66" height="30" rx="5"></rect>
					<text class="kd-app-big" x="116" y="115">12</text>
					<text class="kd-app-m" x="168" y="115" text-anchor="end">3 мин</text>
					<rect class="kd-row" x="108" y="130" width="66" height="30" rx="5"></rect>
					<text class="kd-app-big" x="116" y="151">5</text>
					<text class="kd-app-m" x="168" y="151" text-anchor="end">11 мин</text>
					<path class="kd-route" d="M112 182 Q128 168 144 182 T176 178"></path>
					<circle class="kd-busdot" cx="128" cy="175" r="3"></circle>
				</g>
				<rect class="kd-glass" x="101" y="50" width="80" height="150" rx="6" opacity="0.06"></rect>
			</g>
			<!-- the left hand in a mitten holds the phone by its left edge; the right hand, in a knitted glove or bare,
			     taps the screen (people kit; the fingers behind the phone are drawn behind it) -->
			<g data-mitten></g>
			<g data-hand>
				<g data-glove></g>
				<g data-bare></g>
			</g>
		</svg>
		<div class="intro__foot">
			<p>
				В перчатке экран телефона не слушается, а голым пальцем —{' '}
				<More term="откликается с первого касания">
					Под стеклом экрана — сетка прозрачных проводников. Вместе с ними палец, тоже проводник, образует крошечный конденсатор, и телефон замечает, где изменилась электроёмкость. Толстая ткань отодвигает палец, и изменение слишком мало. Подробнее — разделы{' '}
					<a href="#электроёмкость">«Электроёмкость»</a> и <a href="#ёмкость-плоского-конденсатора">«Ёмкость плоского конденсатора»</a>. Бывают перчатки с проводящими нитями в кончиках пальцев.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="flash">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="День рождения. Папа поднимает фотоаппарат со вспышкой; огонёк готовности на вспышке разгорается, потом яркая вспышка освещает детей за столом с тортом">
			<rect class="kd-wall" x="0" y="0" width="360" height={FL2}></rect>
			<rect class="kd-night" x="244" y="20" width="96" height="76" rx="2"></rect>
			{stars.map((s) => <circle class="kd-star" cx={s.x} cy={s.y} r="0.9" />)}
			<path class="kd-frame" d="M244 20 h96 v76 h-96 Z M292 20 v76"></path>
			<path class="kd-garland" d="M0 22 Q90 44 180 22 T360 22"></path>
			{flags.map((x, i) => <path class={`kd-flag kd-flag--${i % 3}`} d={`M${x} ${22 + 14 * Math.sin((x / 180) * Math.PI) ** 2 - 2} l8 0 l-4 10 Z`} />)}
			<rect class="kd-floor" x="0" y={FL2} width="360" height={240 - FL2}></rect>
			<g data-kids></g>
			<!-- the table and the cake -->
			<rect class="kd-cloth" x="150" y="150" width="190" height="10" rx="2"></rect>
			<path class="kd-cloth2" d="M152 160 H338 L332 196 H158 Z"></path>
			<rect class="kd-leg" x="160" y="196" width="6" height={FL2 - 196}></rect>
			<rect class="kd-leg" x="324" y="196" width="6" height={FL2 - 196}></rect>
			<rect class="kd-plate" x="168" y="146" width="56" height="4" rx="2"></rect>
			<rect class="kd-cake" x="174" y="126" width="44" height="20" rx="3"></rect>
			<path class="kd-cream" d="M174 130 q5 5 11 0 q5 5 11 0 q5 5 11 0 q5 5 11 0 V126 H174 Z"></path>
			{[182, 192, 202, 212].map((x) => (
				<>
					<rect class="kd-candle" x={x - 1.5} y="114" width="3" height="12" />
					<path class="kd-fire" data-fire d={`M${x} 106 q3 4 0 8 q-3 -4 0 -8 Z`} />
				</>
			))}
			<g data-dad></g>
			<g data-cam>
				<rect class="kd-cam" x="-14" y="-9" width="26" height="18" rx="3"></rect>
				<circle class="kd-lens" cx="14" cy="0" r="6"></circle>
				<rect class="kd-flashbody" x="-8" y="-24" width="13" height="15" rx="2"></rect>
				<rect class="kd-flashhead" data-head x="5" y="-23" width="4" height="12" rx="1"></rect>
				<circle class="kd-ready" data-ready cx="-5" cy="-19" r="2"></circle>
			</g>
			<path class="kd-beam" data-beam d="M0 0 L210 0 L200 110 Z" opacity="0"></path>
			<rect class="kd-lit" data-lit x="0" y="0" width="360" height="240" opacity="0"></rect>
		</svg>
		<div class="intro__foot">
			<p>
				Вспышка фотоаппарата несколько секунд копит энергию, а отдаёт её{' '}
				<More term="за тысячную долю секунды">
					Источник питания вспышки медленно заряжает конденсатор — огонёк на вспышке загорается, когда он заряжен. Потом конденсатор за тысячную долю секунды разряжается через лампу. Конденсатор ёмкостью 1000&nbsp;мкФ, заряженный до 330&nbsp;В, запасает около 54&nbsp;Дж, и мощность вспышки достигает 54&nbsp;кВт. Подробнее — раздел{' '}
					<a href="#энергия-заряженного-конденсатора">«Энергия заряженного конденсатора»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
