---
/**
 * «Заряд и напряжение»: a capacitor is joined to a source whose voltage U is set by the slider (0 … 12 В). Two
 * capacitors to choose: 2 мкФ and 5 мкФ. The charge of a plate is q = CU (up to 24 and 60 мкКл); one sign on a plate
 * stands for 5 мкКл (a small one for the remainder over 2,5). Every voltage visited leaves a dot on the graph q(U)
 * (gold for the first capacitor, green for the second): the dots of one capacitor lie on one straight line through
 * zero, and the readout shows that q/U does not change — this is the capacity. Graph: 15 px per вольт, 2,4 px per
 * микрокулон.
 */
import G7Styles from '../g7/G7Styles.astro';

const GX = 150; // the graph's origin
const GY = 172;
const PU = 15; // px per В
const PQ = 2.4; // px per мкКл
---

<G7Styles />
<figure class="g7 qu not-content" data-qulab>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 200" role="img" aria-label="Конденсатор, подключённый к источнику напряжения, и график зависимости его заряда от напряжения" data-svg>
			<!-- the capacitor and the source -->
			<path class="qu__wire" d="M54 80 H34 V164 H50 M90 80 H112 V164 H74"></path>
			<rect class="qu__plate is-plus" x="50" y="40" width="6" height="80" rx="1.5"></rect>
			<rect class="qu__plate is-minus" x="86" y="40" width="6" height="80" rx="1.5"></rect>
			<g data-signs></g>
			<path class="qu__bat" d="M56 152 V176 M66 158 V170"></path>
			<path class="qu__wire" d="M50 164 H56 M66 164 H74"></path>
			<text class="t-small" x="61" y="190" text-anchor="middle">источник</text>
			<text class="t-strong t-num t-halo" x="72" y="30" text-anchor="middle" data-qtext></text>
			<!-- the graph -->
			{[0, 2, 4, 6, 8, 10, 12].map((u) => (
				<>
					<line class="qu__grid" x1={GX + u * PU} y1={GY} x2={GX + u * PU} y2={GY - 60 * PQ} />
					<text class="t-small" x={GX + u * PU} y={GY + 13} text-anchor="middle">{u}</text>
				</>
			))}
			{[0, 20, 40, 60].map((q) => (
				<>
					<line class="qu__grid" x1={GX} y1={GY - q * PQ} x2={GX + 12 * PU} y2={GY - q * PQ} />
					<text class="t-small" x={GX - 4} y={GY - q * PQ + 4} text-anchor="end">{q}</text>
				</>
			))}
			<path class="qu__axis" d={`M${GX} ${GY - 60 * PQ - 6} V${GY} H${GX + 12 * PU + 6}`}></path>
			<text class="t-small" x={GX + 12 * PU} y={GY + 26} text-anchor="end"><tspan class="t-i">U</tspan>, В</text>
			<text class="t-small" x={GX + 4} y="18"><tspan class="t-i">q</tspan>, мкКл</text>
			<g data-dots></g>
			<circle class="qu__now" data-now r="4.5" cx={GX} cy={GY}></circle>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Какой конденсатор" data-seg>
				<button type="button" class="g7__btn" aria-pressed="true" data-c="2">Конденсатор 1</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-c="5">Конденсатор 2</button>
			</div>
			<label class="g7__slider">
				<span>Напряжение <i>U</i></span>
				<output data-ou></output>
				<input type="range" min="0" max="12" step="1" value="4" data-u aria-label="Напряжение, вольты" />
			</label>
			<ul class="g7__read" aria-live="polite">
				<li><span>заряд пластины <i>q</i></span> <b data-q></b></li>
				<li class="is-key"><span><i>q</i>/<i>U</i></span> <b data-ratio></b></li>
			</ul>
			<p class="g7__note">Каждое напряжение оставляет точку на графике: золотые точки — конденсатор&nbsp;1, зелёные — конденсатор&nbsp;2.</p>
		</div>
	</div>
	<figcaption class="g7__caption">Один знак на пластине — 5&nbsp;мкКл. Масштаб графика: 1&nbsp;В — 15&nbsp;px, 1&nbsp;мкКл — 2,4&nbsp;px.</figcaption>
</figure>

<style is:global>
	[data-qulab] .qu__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
	}
	[data-qulab] .qu__plate {
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-qulab] .is-plus {
		fill: var(--g7-red);
	}
	[data-qulab] .is-minus {
		fill: var(--g7-blue);
	}
	[data-qulab] .qu__bat {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
	}
	[data-qulab] .qu__s {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	[data-qulab] .qu__s.is-p {
		stroke: var(--g7-red);
	}
	[data-qulab] .qu__s.is-m {
		stroke: var(--g7-blue);
	}
	[data-qulab] .qu__grid {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}
	[data-qulab] .qu__axis {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.2;
	}
	[data-qulab] .qu__dot2 {
		fill: var(--g7-gold);
	}
	[data-qulab] .qu__dot5 {
		fill: var(--g7-green);
	}
	[data-qulab] .qu__now {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2;
	}
</style>

<script>
	import { el, segment } from '../g7/kit';

	const GX = 150;
	const GY = 172;
	const PU = 15;
	const PQ = 2.4;
	for (const root of document.querySelectorAll<HTMLElement>('[data-qulab]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const su = $<HTMLInputElement>('[data-u]');
		const dots = $<SVGGElement>('[data-dots]');
		const signs = $<SVGGElement>('[data-signs]');
		let C = 2; // мкФ
		const seen = new Set<string>();
		const draw = () => {
			const U = +su.value;
			const q = C * U; // мкКл
			$('[data-ou]').textContent = `${U} В`;
			$('[data-q]').textContent = `${q} мкКл`;
			$('[data-ratio]').textContent = U > 0 ? `${C} мкКл/В` : '—';
			$('[data-qtext]').textContent = `q = ${q} мкКл`;
			const key = `${C}:${U}`;
			if (!seen.has(key)) {
				seen.add(key);
				dots.append(el('circle', { class: `qu__dot${C}`, cx: GX + U * PU, cy: (GY - q * PQ).toFixed(1), r: 3.2 }));
			}
			const now = $('[data-now]');
			now.setAttribute('cx', String(GX + U * PU));
			now.setAttribute('cy', (GY - q * PQ).toFixed(1));
			// one sign per 5 мкКл on each plate, a small one for a remainder of 2,5 мкКл or more
			signs.replaceChildren();
			const whole = Math.floor(q / 5);
			const part = q - 5 * whole >= 2.5 ? 1 : 0;
			const n = whole + part;
			for (let i = 0; i < n; i++) {
				const y = 46 + (i + 0.5) * (68 / Math.max(n, 1));
				const h = i === n - 1 && part ? 2 : 3.2;
				signs.append(el('path', { class: 'qu__s is-p', d: `M${42 - h} ${y.toFixed(1)} h${2 * h} M42 ${(y - h).toFixed(1)} v${2 * h}` }));
				signs.append(el('path', { class: 'qu__s is-m', d: `M${100 - h} ${y.toFixed(1)} h${2 * h}` }));
			}
		};
		segment($('[data-seg]'), (b) => {
			C = +b.dataset.c!;
			draw();
		});
		su.addEventListener('input', draw);
		draw();
	}
</script>
