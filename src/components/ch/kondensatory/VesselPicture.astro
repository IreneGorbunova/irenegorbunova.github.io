---
/**
 * An analogy for C = q/U, not a law of electricity (the caption says so): two cylindrical vessels with bottoms of
 * S = 10 см² and 25 см² get the same water from two taps of one pipe, in five equal portions of 20 мл each. The volume
 * is V = S·h, as the charge is q = C·U: the same volume raises the level of the narrow vessel higher (h = V/S: 2, 4 …
 * 10 см against 0,8, 1,6 … 4 см). Scale: 12 px per сантиметр for heights and widths (the inner diameters are 3,57 and
 * 5,64 см: 43 and 68 px). Loop 8 s: five portions (each tap runs 0,8 s of every second), hold 2 s, drain 1 s.
 * The legend beside the drawing pairs the quantities: volume ↔ charge, level ↔ voltage, area of the bottom ↔ capacity.
 */
import G7Styles from '../g7/G7Styles.astro';

const PX = 12; // px per см
const Y0 = 180; // the bottom of both vessels
const HV = 12 * PX; // the vessels are 12 см tall
const vessels = [
	{ id: 'n', S: 10, cx: 90 },
	{ id: 'w', S: 25, cx: 190 },
].map((v) => ({ ...v, w: 2 * Math.sqrt(v.S / Math.PI) * PX }));
---

<G7Styles />
<figure class="g7 vp not-content" data-vesselpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 210" role="img" aria-label="Аналогия: в узкий и широкий сосуды наливают одинаковые порции воды; в узком уровень поднимается выше" data-svg>
			<text class="t-strong t-num" x="150" y="13" text-anchor="middle" data-vt></text>
			<path class="vp__pipe" d={`M${vessels[0].cx - 30} 22 H${vessels[1].cx + 30}`}></path>
			{vessels.map((v) => (
				<>
					<path class="vp__pipe" d={`M${v.cx} 22 V30`} />
					<rect class="vp__valve" x={v.cx - 5} y="17" width="10" height="9" rx="2" />
					<rect class="vp__stream" data-stream={v.id} x={v.cx - 1.5} y="31" width="3" height="0" />
					<!-- the glass: back rim, water, front -->
					<ellipse class="vp__rim-back" cx={v.cx} cy={Y0 - HV} rx={v.w / 2} ry={v.w * 0.12} />
					<path class="vp__water" data-water={v.id} />
					<ellipse class="vp__surf" data-surf={v.id} cx={v.cx} rx={v.w / 2} ry={v.w * 0.12} />
					<path class="vp__glass" d={`M${v.cx - v.w / 2} ${Y0 - HV} V${Y0} A${v.w / 2} ${v.w * 0.12} 0 0 0 ${v.cx + v.w / 2} ${Y0} V${Y0 - HV}`} />
					<ellipse class="vp__rim" cx={v.cx} cy={Y0 - HV} rx={v.w / 2} ry={v.w * 0.12} />
					<path class="vp__dim" data-dim={v.id} />
					<text class="t-small t-num" data-ht={v.id} text-anchor={v.id === 'n' ? 'end' : 'start'} />
					<text class="t-small t-num" x={v.cx} y="204" text-anchor="middle"><tspan class="vp__i">S</tspan>{` = ${v.S} см²`}</text>
				</>
			))}
		</svg>
		<div class="g7__side">
			<ul class="g7__read vp__legend">
				<li><span>объём воды <i>V</i></span> <b>↔ заряд <i>q</i></b></li>
				<li><span>высота уровня <i>h</i></span> <b>↔ напряжение <i>U</i></b></li>
				<li><span>площадь дна <i>S</i></span> <b>↔ электроёмкость <i>C</i></b></li>
				<li class="is-key"><span><i>V</i> = <i>S</i>·<i>h</i> ↔ <i>q</i> = <i>C</i>·<i>U</i></span></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">Это аналогия, а не закон электричества. В оба сосуда наливают одинаковые порции воды по 20&nbsp;мл, и в узком уровень поднимается выше. Так и одинаковый заряд создаёт на конденсаторе меньшей ёмкости большее напряжение.</figcaption>
</figure>

<style is:global>
	[data-vesselpic] .vp__pipe {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 5;
		stroke-linecap: round;
	}
	[data-vesselpic] .vp__valve {
		fill: var(--g7-steel-dark);
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	[data-vesselpic] .vp__stream {
		fill: var(--g7-water-edge);
		opacity: 0.8;
	}
	[data-vesselpic] .vp__water {
		fill: var(--g7-water);
	}
	[data-vesselpic] .vp__surf {
		fill: color-mix(in srgb, var(--ig-vx) 45%, transparent);
		stroke: var(--g7-water-edge);
		stroke-width: 0.8;
	}
	[data-vesselpic] .vp__glass,
	[data-vesselpic] .vp__rim,
	[data-vesselpic] .vp__rim-back {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
	}
	[data-vesselpic] .vp__rim-back {
		stroke: var(--sl-color-gray-4);
	}
	[data-vesselpic] .vp__dim {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-vesselpic] .vp__legend li {
		justify-content: flex-start;
		flex-wrap: wrap;
		gap: 0.2rem 0.45rem;
	}
	[data-vesselpic] .vp__legend b {
		font-weight: 600;
	}
	[data-vesselpic] .vp__i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
</style>

<script>
	import { loop, fmtTrim } from '../g7/kit';

	const PX = 12;
	const Y0 = 180;
	const V = [
		{ id: 'n', S: 10, cx: 90 },
		{ id: 'w', S: 25, cx: 190 },
	].map((v) => ({ ...v, w: 2 * Math.sqrt(v.S / Math.PI) * PX }));
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-vesselpic]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		let t = 0;
		const draw = () => {
			// 0–5 s: five portions of 20 мл; 5–7 s: hold; 7–8 s: drain
			let vol = 0;
			let flowing = false;
			if (t < 5) {
				const k = Math.floor(t);
				const f = t - k;
				vol = 20 * (k + Math.min(1, f / 0.8));
				flowing = f < 0.8;
			} else if (t < 7) vol = 100;
			else vol = 100 * (1 - ease(t - 7));
			$('[data-vt]').textContent = `одинаковый объём: ${Math.round(vol)} мл`;
			for (const v of V) {
				const h = vol / v.S; // см
				const y = Y0 - h * PX;
				const rx = v.w / 2;
				const ry = v.w * 0.12;
				$(`[data-water="${v.id}"]`).setAttribute('d', h > 0.01 ? `M${v.cx - rx} ${y} V${Y0} A${rx} ${ry} 0 0 0 ${v.cx + rx} ${Y0} V${y} Z` : '');
				const surf = $(`[data-surf="${v.id}"]`);
				surf.setAttribute('cy', y.toFixed(1));
				surf.style.display = h > 0.01 ? '' : 'none';
				const st = $(`[data-stream="${v.id}"]`);
				st.setAttribute('height', flowing ? Math.max(0, y - 31).toFixed(1) : '0');
				// the level: a dimension line on the outer side of each vessel
				const n = v.id === 'n';
				const xd = n ? v.cx - rx - 8 : v.cx + rx + 8;
				$(`[data-dim="${v.id}"]`).setAttribute('d', h > 0.05 ? `M${xd - 3} ${Y0} h6 M${xd} ${Y0} V${y.toFixed(1)} M${xd - 3} ${y.toFixed(1)} h6` : '');
				const ht = $(`[data-ht="${v.id}"]`);
				ht.setAttribute('x', String(n ? xd - 5 : xd + 5));
				ht.setAttribute('y', (Math.min(Y0 - 4, y + 4)).toFixed(1));
				ht.innerHTML = h > 0.05 ? `<tspan class="vp__i">h</tspan> = ${fmtTrim(h, 1)} см` : '';
			}
		};
		loop(root, (dt) => {
			t = (t + dt) % 8;
			draw();
			return true;
		});
		draw();
	}
</script>
