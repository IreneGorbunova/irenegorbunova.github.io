---
/**
 * The Leyden jar, a static scheme. Left: the jar of 1746: a glass jar with water, a brass rod through the cork and a
 * chain from the rod into the water; the outer «plate» was the hand that held the jar (shown as a dashed band round the
 * lower part of the glass, no hand drawn). Right: the later jar: tin foil inside and outside the lower part of the
 * glass, a ball on the rod, the chain to the inner foil. The labels in the middle point to both jars: the glass is the
 * dielectric; the water, later the foil, is the inner plate; the hand, later the foil, is the outer plate.
 */
import G7Styles from '../g7/G7Styles.astro';

const chain = (x0: number, y0: number, x1: number, y1: number, n = 9) =>
	Array.from({ length: n }, (_, i) => {
		const k = (i + 0.5) / n;
		const x = x0 + (x1 - x0) * k + (i % 2 ? 1.5 : -1.5);
		const y = y0 + (y1 - y0) * k;
		return `M${(x - 1.6).toFixed(1)} ${(y - 2.4).toFixed(1)} a1.6 2.4 0 1 0 0.01 0`;
	}).join(' ');
// a jar: glass from (x, 40) to (x + 64, 140), a neck, a cork
const jar = (x: number) => `M${x + 14} 36 V44 Q${x} 48 ${x} 60 V136 Q${x} 142 ${x + 6} 142 H${x + 58} Q${x + 64} 142 ${x + 64} 136 V60 Q${x + 64} 48 ${x + 50} 44 V36`;
const L = 20;
const R = 256;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow ly not-content" data-leydenpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 168" role="img" aria-label="Лейденская банка 1746 года: стеклянная банка с водой, латунный стержень и цепочка в воду, снаружи банку держали рукой. Позже: фольга внутри и снаружи банки и шарик на стержне">
			<!-- 1746: water inside, the hand outside (dashed band) -->
			<path class="ly__water" d={`M${L + 2.5} 84 H${L + 61.5} V136 Q${L + 61.5} 139.5 ${L + 58} 139.5 H${L + 6} Q${L + 2.5} 139.5 ${L + 2.5} 136 Z`}></path>
			<path class="ly__glass" d={jar(L)}></path>
			<path class="ly__hand" d={`M${L - 5} 92 V146 H${L + 69} V92`}></path>
			<rect class="ly__cork" x={L + 13} y="28" width="38" height="12" rx="2"></rect>
			<path class="ly__rod" d={`M${L + 32} 10 V60`}></path>
			<path class="ly__chain" d={chain(L + 32, 60, L + 30, 100)}></path>
			<text class="t-small" x={L + 32} y="162" text-anchor="middle">1746 год</text>
			<!-- later: foil inside and outside -->
			<path class="ly__foil" d={`M${R + 2.5} 80 H${R + 61.5} V136 Q${R + 61.5} 139.5 ${R + 58} 139.5 H${R + 6} Q${R + 2.5} 139.5 ${R + 2.5} 136 Z`}></path>
			<path class="ly__glass" d={jar(R)}></path>
			<path class="ly__foil is-out" d={`M${R - 3} 80 H${R} V136 Q${R} 142 ${R + 6} 142 H${R + 58} Q${R + 64} 142 ${R + 64} 136 V80 H${R + 67} V137 Q${R + 67} 145 ${R + 58} 145 H${R + 6} Q${R - 3} 145 ${R - 3} 137 Z`}></path>
			<rect class="ly__cork" x={R + 13} y="28" width="38" height="12" rx="2"></rect>
			<path class="ly__rod" d={`M${R + 32} 14 V60`}></path>
			<circle class="ly__ball" cx={R + 32} cy="12" r="7"></circle>
			<path class="ly__chain" d={chain(R + 32, 60, R + 33, 82, 5)}></path>
			<text class="t-small" x={R + 32} y="162" text-anchor="middle">позже</text>
			<!-- the labels, with leaders to both jars -->
			<path class="ly__leader" d={`M${L + 64} 66 L104 30 M236 30 L${R} 66`}></path>
			<text class="t-small" x="170" y="28" text-anchor="middle">стекло — диэлектрик</text>
			<path class="ly__leader" d={`M${L + 50} 110 L104 78 M236 78 L${R + 50} 110`}></path>
			<text class="t-small" x="170" y="70" text-anchor="middle">вода, потом фольга —</text>
			<text class="t-small" x="170" y="84" text-anchor="middle">внутренняя обкладка</text>
			<path class="ly__leader" d={`M${L + 69} 128 L104 124 M236 124 L${R + 67} 128`}></path>
			<text class="t-small" x="170" y="116" text-anchor="middle">рука, потом фольга —</text>
			<text class="t-small" x="170" y="130" text-anchor="middle">наружная обкладка</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Лейденская банка 1746&nbsp;года и более поздняя. Стекло разделяет две обкладки: внутри — вода, потом фольга; снаружи — ладонь, потом тоже фольга.</figcaption>
</figure>

<style is:global>
	[data-leydenpic].g7--narrow .g7__grid {
		max-width: 32rem;
	}
	[data-leydenpic] .ly__glass {
		fill: color-mix(in oklab, var(--ig-vx) 10%, transparent);
		stroke: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-gray-2));
		stroke-width: 2;
		stroke-linejoin: round;
	}
	[data-leydenpic] .ly__water {
		fill: var(--g7-water);
	}
	[data-leydenpic] .ly__hand {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.4;
		stroke-dasharray: 4 3;
	}
	[data-leydenpic] .ly__foil {
		fill: color-mix(in oklab, var(--sl-color-gray-2) 70%, var(--ig-vx));
		opacity: 0.75;
	}
	[data-leydenpic] .ly__foil.is-out {
		opacity: 0.95;
	}
	[data-leydenpic] .ly__cork {
		fill: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-2);
		stroke-width: 0.8;
	}
	[data-leydenpic] .ly__rod {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 3;
		stroke-linecap: round;
	}
	[data-leydenpic] .ly__ball {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.8;
	}
	[data-leydenpic] .ly__chain {
		fill: none;
		stroke: var(--g7-steel);
		stroke-width: 1;
	}
	[data-leydenpic] .ly__leader {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
	}
</style>
