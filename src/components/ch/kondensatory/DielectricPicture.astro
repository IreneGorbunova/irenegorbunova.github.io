---
/**
 * Why a dielectric raises the capacity (a loop of 8 s). A flat capacitor, charged and disconnected from the source, so
 * its charge q stays the same, is joined to a school electrometer (a needle on a rod in a round case; the rod to the
 * «−» plate, the case to the «+» plate: it shows the voltage whatever the sign). 0,8–2,3 s: a glass plate (ε = 7) comes down into the gap and fills it;
 * 2,3–3,5 s: the molecules of the glass (small ovals, «−» half blue, «+» half red) turn along the field, and bound
 * charges appear on the faces of the glass (smaller and paler than the plates' charges: «−» facing the «+» plate,
 * «+» facing the «−» plate). Of the 7 field lines that start on the «+» plate only 1 crosses the glass; 6 end on the
 * bound charges (the field inside is 7 times weaker). The voltage falls as U = q/C = 1400 В / (1 + 6p) for the
 * polarization p from 0 to 1: from 1400 В to 200 В; the needle turns by 62° · U / 1400 В. Then everything goes back:
 * 5,3–6,0 s the molecules turn away, 6,0–7,4 s the glass goes up.
 * The two stages are shown one after the other for clarity; in reality the glass polarizes as it enters (the caption
 * says so). The gap is drawn much wider than in a real capacitor.
 * Colors as in «Электростатика»: «+» red, «−» blue, field lines gray.
 */
import G7Styles from '../g7/G7Styles.astro';

const PL = 110; // the «+» plate, x of its left face (6 px thick)
const PR = 184; // the «−» plate
const Y1 = 50;
const Y2 = 170;
const GX0 = 119; // the glass
const GX1 = 181;
const slots = Array.from({ length: 7 }, (_, i) => Y1 + ((i + 0.5) * (Y2 - Y1)) / 7);
const rows = Array.from({ length: 6 }, (_, i) => (slots[i] + slots[i + 1]) / 2);
const cols = [135, 150, 165];
// fixed "random" angles of the molecules before they turn
const mols = rows.flatMap((y, i) => cols.map((x, j) => ({ x, y, a: ((i * 7 + j * 13) % 17) * 21 - 170 })));
const MID = 3; // the line that crosses the glass
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow dl not-content" data-dielpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 340 222" role="img" aria-label="Между пластинами заряженного конденсатора вдвигают стекло: его молекулы поворачиваются вдоль поля, на гранях стекла появляются связанные заряды, поле внутри ослабевает, и электрометр показывает меньшее напряжение" data-svg>
			<!-- wires (clear of the glass's way): the «−» plate to the rod of the electrometer, the «+» plate to its case -->
			<path class="dl__wire" d={`M${PR + 3} ${Y1} V36 H271`}></path>
			<path class="dl__wire" d={`M${PL + 3} ${Y2} V200 H275 V146`}></path>
			<!-- the field lines: stubs at the plates and the part inside the gap -->
			{slots.map((y, i) => (
				<>
					<path class="dl__line" d={`M${PL + 6} ${y} H${GX0 + 2} M${GX1 - 2} ${y} H${PR}`} />
					<g data-inner={i}>
						<path class="dl__line" d={`M${GX0 + 2} ${y} H${GX1 - 2}`} />
						<path class="dl__tip" d={`M${(PL + PR) / 2 + 9} ${y} l-6 -3 v6 Z`} />
					</g>
				</>
			))}
			<!-- the glass with its molecules and bound charges; it slides in from above -->
			<g data-glass>
				<rect class="dl__glass" x={GX0} y={Y1} width={GX1 - GX0} height={Y2 - Y1} rx="1.5"></rect>
				<g data-bound>
					{slots.map((y, i) =>
						i === MID ? null : (
							<>
								<circle class="dl__bc is-m" cx={GX0 + 5.5} cy={y} r="3.6" />
								<path class="dl__b is-m" d={`M${GX0 + 3.5} ${y} h4`} />
								<circle class="dl__bc is-p" cx={GX1 - 5.5} cy={y} r="3.6" />
								<path class="dl__b is-p" d={`M${GX1 - 7.5} ${y} h4 M${GX1 - 5.5} ${y - 2} v4`} />
							</>
						),
					)}
				</g>
				{mols.map((m) => (
					<g class="dl__mol" data-mol={m.a} transform={`translate(${m.x} ${m.y}) rotate(${m.a})`}>
						<path class="dl__mm" d="M0 -3 A5.5 3 0 0 0 0 3 Z" />
						<path class="dl__mp" d="M0 -3 A5.5 3 0 0 1 0 3 Z" />
					</g>
				))}
			</g>
			<!-- the plates and their charges -->
			<rect class="dl__plate" x={PL} y={Y1} width="6" height={Y2 - Y1} rx="1.5"></rect>
			<rect class="dl__plate" x={PR} y={Y1} width="6" height={Y2 - Y1} rx="1.5"></rect>
			{slots.map((y) => (
				<>
					<path class="dl__s is-p" d={`M${PL - 13} ${y} h7 M${PL - 9.5} ${y - 3.5} v7`} />
					<path class="dl__s is-m" d={`M${PR + 12} ${y} h7`} />
				</>
			))}
			<text class="t-small" x="150" y="187" text-anchor="middle" data-gl>стекло, <tspan class="dl__i">ε</tspan> = 7</text>
			<!-- the electrometer -->
			<circle class="dl__case" cx="275" cy="105" r="41"></circle>
			<path class="dl__scale" d="M250 76 A36 36 0 0 1 300 76"></path>
			{[-60, -40, -20, 0, 20, 40, 60].map((a) => <path class="dl__tick" d={`M${275 + 30 * Math.sin((a * Math.PI) / 180)} ${105 - 30 * Math.cos((a * Math.PI) / 180) - 0} L${275 + 34 * Math.sin((a * Math.PI) / 180)} ${105 - 34 * Math.cos((a * Math.PI) / 180)}`} />)}
			<path class="dl__rod" d="M275 40 V128"></path>
			<circle class="dl__ball" cx="275" cy="36" r="4.5"></circle>
			<path class="dl__needle" data-needle d="M275 76 V124"></path>
			<circle class="dl__pivot" cx="275" cy="100" r="2.2"></circle>
			<path class="dl__foot" d="M262 146 H288 M268 146 L264 154 M282 146 L286 154"></path>
			<text class="t-strong t-num" x="275" y="216" text-anchor="middle" data-ut><tspan class="dl__i">U</tspan> = 1400 В</text>
		</svg>
	</div>
	<figcaption class="g7__caption">Конденсатор отключён от источника, и его заряд не меняется. В стекле молекулы поворачиваются вдоль поля, на гранях стекла появляются связанные заряды, и на них заканчивается большинство линий: поле между пластинами слабеет, напряжение падает. Для наглядности стекло сначала вдвигается, а потом поляризуется; на самом деле это происходит сразу.</figcaption>
</figure>

<style is:global>
	[data-dielpic].g7--narrow .g7__grid {
		max-width: 28rem;
	}
	[data-dielpic] .dl__wire {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	[data-dielpic] .dl__line {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.1;
	}
	[data-dielpic] .dl__tip {
		fill: var(--sl-color-gray-3);
	}
	[data-dielpic] .dl__glass {
		fill: color-mix(in oklab, var(--ig-vx) 24%, transparent);
		stroke: color-mix(in oklab, var(--ig-vx) 60%, var(--sl-color-gray-2));
		stroke-width: 1;
	}
	[data-dielpic] .dl__mm {
		fill: color-mix(in oklab, var(--g7-blue) 75%, transparent);
	}
	[data-dielpic] .dl__mp {
		fill: color-mix(in oklab, var(--g7-red) 75%, transparent);
	}
	[data-dielpic] .dl__b {
		fill: none;
		stroke-width: 1.3;
		stroke-linecap: round;
		opacity: 0.8;
	}
	[data-dielpic] .dl__b.is-m,
	[data-dielpic] .dl__s.is-m {
		stroke: var(--g7-blue);
	}
	[data-dielpic] .dl__b.is-p,
	[data-dielpic] .dl__s.is-p {
		stroke: var(--g7-red);
	}
	[data-dielpic] .dl__bc {
		fill: var(--g7-paper);
		stroke-width: 1;
	}
	[data-dielpic] .dl__bc.is-m {
		stroke: var(--g7-blue);
	}
	[data-dielpic] .dl__bc.is-p {
		stroke: var(--g7-red);
	}
	[data-dielpic] .dl__i {
		font-family: var(--ig-font-math);
		font-style: italic;
	}
	[data-dielpic] .dl__s {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-dielpic] .dl__plate {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 0.6;
	}
	[data-dielpic] .dl__case {
		fill: color-mix(in oklab, var(--sl-color-gray-6) 70%, transparent);
		stroke: var(--sl-color-gray-2);
		stroke-width: 2;
	}
	[data-dielpic] .dl__scale,
	[data-dielpic] .dl__tick {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-dielpic] .dl__rod,
	[data-dielpic] .dl__foot {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 2.2;
		stroke-linecap: round;
	}
	[data-dielpic] .dl__ball {
		fill: var(--g7-steel);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-dielpic] .dl__needle {
		fill: none;
		stroke: var(--sl-color-white);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	[data-dielpic] .dl__pivot {
		fill: var(--sl-color-gray-1);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const Y1 = 50;
	const MID = 3;
	const ease = (u: number) => {
		const t = Math.min(1, Math.max(0, u));
		return t * t * (3 - 2 * t);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-dielpic]')) {
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const glass = $<SVGGElement>('[data-glass]');
		const bound = $<SVGGElement>('[data-bound]');
		const inner = [...root.querySelectorAll<SVGGElement>('[data-inner]')];
		const mols = [...root.querySelectorAll<SVGGElement>('[data-mol]')].map((g) => ({ g, a: +g.dataset.mol!, tr: g.getAttribute('transform')!.replace(/ rotate\(.*\)$/, '') }));
		const needle = $<SVGPathElement>('[data-needle]');
		const ut = $('[data-ut]');
		const gl = $<SVGTextElement>('[data-gl]');
		let t = 0;
		const draw = () => {
			// the glass: in 0,8–2,3 s, out 6,0–7,4 s; the polarization: on 2,3–3,5 s, off 5,3–6,0 s
			const ins = ease((t - 0.8) / 1.5) * (1 - ease((t - 6.0) / 1.4));
			const p = ease((t - 2.3) / 1.2) * (1 - ease((t - 5.3) / 0.7));
			glass.setAttribute('transform', `translate(0 ${(-(1 - ins) * (Y1 + 126)).toFixed(1)})`);
			bound.style.opacity = p.toFixed(2);
			for (const m of mols) m.g.setAttribute('transform', `${m.tr} rotate(${(m.a * (1 - p)).toFixed(1)})`);
			inner.forEach((g, i) => (g.style.opacity = i === MID ? '1' : (1 - p).toFixed(2)));
			gl.style.opacity = ease((ins - 0.85) / 0.15).toFixed(2);
			// q stays; C grows from C₀ to 7C₀ with the polarization
			const U = 1400 / (1 + 6 * p);
			const a = (62 * U) / 1400;
			const r = (a * Math.PI) / 180;
			needle.setAttribute('d', `M${(275 - 24 * Math.sin(r)).toFixed(1)} ${(100 + 24 * Math.cos(r)).toFixed(1)} L${(275 + 24 * Math.sin(r)).toFixed(1)} ${(100 - 24 * Math.cos(r)).toFixed(1)}`);
			ut.innerHTML = `<tspan class="dl__i">U</tspan> = ${Math.round(U / 10) * 10} В`;
		};
		loop(root, (dt) => {
			t = (t + dt) % 8;
			draw();
			return true;
		});
		draw();
	}
</script>
