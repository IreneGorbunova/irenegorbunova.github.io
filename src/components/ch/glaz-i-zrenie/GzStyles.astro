---
/**
 * Styles of the eye drawings of the chapter «Глаз и зрение». Renders nothing. The rays, lenses, controls and panels
 * come from the chapter «Линзы» (LzStyles: .lz, .lzd, .lz-ray, .lz-seg, .lz-slider, .lz-stats …).
 */
import LzStyles from '@components/ch/linzy/LzStyles.astro';
---

<LzStyles />

<style is:global>
	.gz {
		--gz-white: color-mix(in oklab, var(--sl-color-gray-1) 22%, var(--ig-surface));
		--gz-inside: color-mix(in oklab, var(--ig-vx) 7%, var(--ig-surface));
		--gz-edge: var(--sl-color-gray-3);
		--gz-retina: var(--ig-vy);
		--gz-iris: color-mix(in oklab, var(--ig-vx) 55%, var(--sl-color-gray-3));
		--gz-muscle: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-4));
	}
	:root[data-theme='light'] .gz {
		--gz-white: color-mix(in oklab, var(--sl-color-gray-5) 35%, white);
		--gz-inside: color-mix(in oklab, var(--ig-vx) 5%, white);
		--gz-muscle: color-mix(in oklab, var(--ig-vy) 40%, var(--sl-color-gray-5));
	}
	.gz-globe {
		fill: var(--gz-inside);
	}
	.gz-sclera {
		fill: none;
		stroke: var(--gz-white);
		stroke-width: 6;
		stroke-linejoin: round;
	}
	.gz-sclera-line {
		fill: none;
		stroke: var(--gz-edge);
		stroke-width: 1;
	}
	.gz-cornea {
		fill: none;
		stroke: var(--lz-glass-edge);
		stroke-width: 1.8;
	}
	.gz-chamber {
		fill: color-mix(in srgb, var(--ig-vx) 16%, transparent);
	}
	.gz-retina {
		fill: none;
		stroke: var(--gz-retina);
		stroke-width: 2.6;
		stroke-linecap: round;
		opacity: 0.85;
	}
	.gz-nerve {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--gz-white));
		stroke: var(--gz-edge);
		stroke-width: 1;
	}
	.gz-iris {
		fill: none;
		stroke: var(--gz-iris);
		stroke-width: 4.5;
		stroke-linecap: round;
	}
	.gz-ciliary {
		fill: var(--gz-muscle);
	}
	.gz-zonule {
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.8;
		opacity: 0.8;
	}
	.gz-lens {
		fill: var(--lz-glass);
		stroke: var(--lz-glass-edge);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.gz-glasses {
		fill: color-mix(in srgb, var(--ig-v) 18%, transparent);
		stroke: color-mix(in srgb, var(--ig-v) 75%, var(--sl-color-white));
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
	.gz-focus {
		fill: var(--sl-color-white);
		stroke: var(--ig-surface);
		stroke-width: 1.5;
	}
	.gz-lead {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 0.9;
	}
	.gz-image line {
		stroke: var(--sl-color-accent-high);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.gz-image polygon {
		fill: var(--sl-color-accent-high);
	}
	.gz-object line {
		stroke: var(--sl-color-white);
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.gz-object polygon {
		fill: var(--sl-color-white);
	}
	.gz-break {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.gz-tag {
		font-size: 10px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	.gz-tag--bad {
		fill: var(--ig-vy);
	}
	.gz-tag--good {
		fill: var(--sl-color-text-accent);
	}
</style>
