---
/**
 * Accommodation, two enlarged eyes (12 px per mm, real proportions). Left: a far point, the ciliary muscle relaxed,
 * the fibres pull the lens flat (accommodation 0, the eye 60 дптр). Right: a point 20 cm away, the muscle contracted,
 * the fibres slack, the lens rounder (+5 дптр, the eye 65 дптр); the relaxed lens is dashed. In both the rays meet
 * on the retina. The rays from 20 cm diverge only slightly: 4 mm of pupil over 200 mm.
 */
import GzStyles from './GzStyles.astro';
import EyeView from './EyeView.astro';
import { EYE_L } from './eye';

const L = EYE_L.normal;
const view: [number, number, number, number] = [-14, 22, -12.35, 12.35];
---

<GzStyles />
<figure class="lz lzd gz not-content">
	<div class="lzd__grid">
		<div class="lzd__panel">
			<EyeView L={L} a={0} view={view} label="Глаз смотрит на далёкий предмет: ресничная мышца расслаблена, волокна натянуты, хрусталик плоский. Лучи собираются на сетчатке" />
			<p class="lzd__label"><b>Далёкий предмет.</b> Мышца расслаблена, волокна натянуты, хрусталик более плоский.</p>
		</div>
		<div class="lzd__panel">
			<EyeView L={L} a={5} d={200} view={view} ghost label="Глаз смотрит на предмет в 20 сантиметрах: ресничная мышца сократилась, волокна ослабли, хрусталик стал выпуклее. Пунктиром показан расслабленный хрусталик. Лучи собираются на сетчатке" />
			<p class="lzd__label"><b>Предмет в 20&nbsp;см.</b> Мышца сократилась, волокна ослабли, хрусталик стал выпуклее (пунктир — его прежняя форма).</p>
		</div>
	</div>
	<figcaption class="lz-legend lzd__cap">
		Размеры настоящие, масштаб одинаковый по обеим осям. Лучи от близкой точки расходятся, и
		собрать их на сетчатке может только более выпуклый хрусталик — с большей оптической силой.
	</figcaption>
</figure>
