---
/**
 * Two short looping opening scenes of «Глаз и зрение». No numbers in the pictures; the captions' popovers explain.
 * Finger: what one eye sees — a finger about 20 cm in front of the face and a house outside the window. First the eye
 *   looks at the finger: the finger is sharp, the house blurred; then the gaze moves to the house and in about half a
 *   second (the time the lens needs to change its shape) the finger blurs and the house becomes sharp.
 * Pupil: an eye seen from the front, the iris 12 mm across (3,8 px per mm). The room is dim, the pupil about 7 mm. A
 *   lamp comes on: after a short delay the pupil narrows to about 2,5 mm within a second. The lamp goes out: the pupil
 *   widens again, more slowly (several seconds).
 * Plays only while visible.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = `gzi-${Math.random().toString(36).slice(2, 8)}`;
// iris texture: radial strokes
const FIBRES = Array.from({ length: 36 }, (_, i) => (i * 360) / 36);
---

<IntroFrame data-gzintro>
	<div class="intro__card" data-scene="finger">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Вид из глаз человека: за окном дом и дерево, перед лицом поднятый палец. Сначала палец виден чётко, а дом расплывается. Потом взгляд переходит на дом: дом становится чётким, а палец расплывается">
			<defs>
				<filter id={`${uid}-far`} x="-10%" y="-10%" width="120%" height="120%">
					<feGaussianBlur stdDeviation="0" data-blur-far></feGaussianBlur>
				</filter>
				<filter id={`${uid}-near`} x="-30%" y="-15%" width="160%" height="130%">
					<feGaussianBlur stdDeviation="0" data-blur-near></feGaussianBlur>
				</filter>
				<clipPath id={`${uid}-win`}>
					<rect x="44" y="22" width="272" height="168"></rect>
				</clipPath>
			</defs>
			<rect class="gzi-wall" x="0" y="0" width="360" height="240"></rect>
			<g clip-path={`url(#${uid}-win)`}>
				<g filter={`url(#${uid}-far)`}>
					<rect class="gzi-sky" x="30" y="10" width="300" height="190"></rect>
					<ellipse class="gzi-cloud" cx="96" cy="52" rx="26" ry="9"></ellipse>
					<ellipse class="gzi-cloud" cx="116" cy="46" rx="18" ry="9"></ellipse>
					<ellipse class="gzi-cloud" cx="262" cy="64" rx="22" ry="7"></ellipse>
					<rect class="gzi-ground" x="30" y="150" width="300" height="50"></rect>
					<!-- the house -->
					<rect class="gzi-house" x="196" y="104" width="78" height="52"></rect>
					<polygon class="gzi-roof" points="188,106 235,74 282,106"></polygon>
					<rect class="gzi-window" x="208" y="116" width="16" height="14"></rect>
					<rect class="gzi-window" x="246" y="116" width="16" height="14"></rect>
					<rect class="gzi-door" x="229" y="132" width="13" height="24"></rect>
					<rect class="gzi-chimney" x="258" y="80" width="8" height="16"></rect>
					<!-- the tree -->
					<rect class="gzi-trunk" x="104" y="118" width="7" height="36"></rect>
					<circle class="gzi-leaves" cx="107" cy="106" r="22"></circle>
					<circle class="gzi-leaves" cx="94" cy="118" r="14"></circle>
					<circle class="gzi-leaves" cx="121" cy="117" r="14"></circle>
				</g>
			</g>
			<!-- the window frame -->
			<rect class="gzi-frame" x="44" y="22" width="272" height="168"></rect>
			<line class="gzi-frame" x1="180" y1="22" x2="180" y2="190"></line>
			<rect class="gzi-sill" x="34" y="190" width="292" height="10"></rect>
			<!-- the finger and the hand, close to the eye -->
			<g filter={`url(#${uid}-near)`}>
				<path class="gzi-skin" d="M 150 240 L 152 196 Q 150 178 160 172 L 162 112 Q 163 92 178 92 Q 193 92 194 112 L 196 176 Q 214 180 216 200 L 218 240 Z"></path>
				<path class="gzi-nail" d="M 168 108 Q 168 98 178 98 Q 188 98 188 108 L 187 120 Q 178 124 169 120 Z"></path>
				<path class="gzi-crease" d="M 165 150 Q 178 154 191 150 M 166 158 Q 178 161 190 158"></path>
				<path class="gzi-crease" d="M 162 186 Q 176 196 196 186"></path>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Посмотрите на палец перед лицом — дом за окном расплывается. Переведите взгляд на дом, и <More term="расплывается уже палец">Глаз не может видеть чётко сразу и близкое, и далёкое. Чтобы рассмотреть предмет на другом расстоянии, хрусталик внутри глаза меняет форму, и на это нужно около полсекунды. Подробнее — в разделе <a href="#аккомодация">«Аккомодация»</a>.</More>.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="pupil">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Глаз крупно. В полутёмной комнате чёрный кружок в середине глаза большой. Загорается лампа — кружок быстро сужается. Лампа гаснет — он медленно расширяется снова">
			<defs>
				<clipPath id={`${uid}-lids`}>
					<path d="M 70 128 Q 180 30 290 128 Q 180 214 70 128 Z"></path>
				</clipPath>
				<radialGradient id={`${uid}-iris`}>
					<stop offset="0%" class="gzi-iris-in"></stop>
					<stop offset="100%" class="gzi-iris-out"></stop>
				</radialGradient>
			</defs>
			<rect class="gzi-face" x="0" y="0" width="360" height="240"></rect>
			<path class="gzi-brow" d="M 92 58 Q 180 10 274 52"></path>
			<path class="gzi-lidfold" d="M 78 116 Q 180 22 284 114"></path>
			<g clip-path={`url(#${uid}-lids)`}>
				<rect class="gzi-white" x="60" y="20" width="240" height="200"></rect>
				<circle cx="180" cy="125" r="46" fill={`url(#${uid}-iris)`}></circle>
				<g class="gzi-fibres">
					{FIBRES.map((a) => <line x1="180" y1="125" x2={180 + 44 * Math.cos((a * Math.PI) / 180)} y2={125 + 44 * Math.sin((a * Math.PI) / 180)} />)}
				</g>
				<circle class="gzi-limbus" cx="180" cy="125" r="46"></circle>
				<circle class="gzi-pupil" cx="180" cy="125" r="13" data-pupil></circle>
				<circle class="gzi-glint" cx="194" cy="111" r="5" data-glint></circle>
			</g>
			<path class="gzi-lid" d="M 70 128 Q 180 30 290 128 Q 180 214 70 128 Z"></path>
			<!-- the lamp and the dimness of the room -->
			<rect class="gzi-dark" x="0" y="0" width="360" height="240" data-dark></rect>
			<g data-lamp>
				<line class="gzi-cord" x1="320" y1="0" x2="320" y2="22"></line>
				<path class="gzi-shade" d="M 304 22 L 336 22 L 344 38 L 296 38 Z"></path>
				<circle class="gzi-bulb" cx="320" cy="42" r="6" data-bulb></circle>
			</g>
		</svg>
		<div class="intro__foot">
			<p>Когда загорается яркий свет, чёрный кружок в середине глаза <More term="быстро сужается">Это зрачок — отверстие в радужной оболочке, через которое свет попадает внутрь глаза. На ярком свету он сужается примерно до 2–3 мм, в темноте расширяется до 7–8 мм, и в глаз попадает больше света. Подробнее — в разделе <a href="#как-устроен-глаз">«Как устроен глаз»</a>.</More>, а в темноте снова расширяется.</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-gzintro] {
		--gzi-wall: color-mix(in oklab, var(--ig-v) 14%, var(--sl-color-gray-5));
		--gzi-sky: color-mix(in srgb, var(--ig-vx) 35%, var(--sl-color-gray-6, #17181c));
		--gzi-ground: color-mix(in oklab, hsl(110, 45%, 40%) 55%, var(--sl-color-gray-5));
		--gzi-skin: color-mix(in oklab, var(--ig-v) 45%, var(--sl-color-gray-2));
		--gzi-face: color-mix(in oklab, var(--ig-v) 35%, var(--sl-color-gray-3));
	}
	:root[data-theme='light'] [data-gzintro] {
		--gzi-wall: color-mix(in oklab, var(--ig-v) 10%, var(--sl-color-gray-6));
		--gzi-sky: color-mix(in srgb, var(--ig-vx) 30%, white);
		--gzi-ground: color-mix(in oklab, hsl(110, 45%, 45%) 60%, white);
		--gzi-skin: color-mix(in oklab, var(--ig-v) 40%, var(--sl-color-gray-5));
		--gzi-face: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-5));
	}
	.gzi-wall {
		fill: var(--gzi-wall);
	}
	.gzi-sky {
		fill: var(--gzi-sky);
	}
	.gzi-cloud {
		fill: var(--sl-color-white);
		opacity: 0.55;
	}
	:root[data-theme='light'] .gzi-cloud {
		fill: white;
		opacity: 0.9;
	}
	.gzi-ground {
		fill: var(--gzi-ground);
	}
	.gzi-house {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-2));
	}
	.gzi-roof {
		fill: var(--ig-vy);
	}
	.gzi-window {
		fill: var(--ig-vx);
		stroke: var(--sl-color-gray-6, #222);
		stroke-width: 1.5;
	}
	.gzi-door,
	.gzi-chimney {
		fill: color-mix(in oklab, var(--ig-vy) 45%, var(--sl-color-gray-5));
	}
	.gzi-trunk {
		fill: color-mix(in oklab, var(--ig-v) 35%, #4a2e18);
	}
	.gzi-leaves {
		fill: color-mix(in oklab, hsl(120, 50%, 32%) 80%, var(--sl-color-gray-5));
	}
	.gzi-frame {
		fill: none;
		stroke: color-mix(in oklab, var(--gzi-wall) 50%, var(--sl-color-white));
		stroke-width: 7;
	}
	.gzi-sill {
		fill: color-mix(in oklab, var(--gzi-wall) 40%, var(--sl-color-white));
	}
	.gzi-skin {
		fill: var(--gzi-skin);
		stroke: color-mix(in oklab, var(--gzi-skin) 70%, var(--sl-color-black));
		stroke-width: 1.2;
	}
	.gzi-nail {
		fill: color-mix(in oklab, var(--gzi-skin) 55%, white);
		stroke: color-mix(in oklab, var(--gzi-skin) 70%, var(--sl-color-black));
		stroke-width: 0.8;
	}
	.gzi-crease {
		fill: none;
		stroke: color-mix(in oklab, var(--gzi-skin) 60%, var(--sl-color-black));
		stroke-width: 1;
	}
	.gzi-face {
		fill: var(--gzi-face);
	}
	.gzi-brow {
		fill: none;
		stroke: color-mix(in oklab, var(--ig-v) 30%, #3b2a1c);
		stroke-width: 9;
		stroke-linecap: round;
	}
	.gzi-lidfold {
		fill: none;
		stroke: color-mix(in oklab, var(--gzi-face) 70%, var(--sl-color-black));
		stroke-width: 1.5;
	}
	.gzi-white {
		fill: #f1efe9;
	}
	.gzi-iris-in {
		stop-color: color-mix(in oklab, var(--ig-v) 45%, hsl(30, 55%, 30%));
	}
	.gzi-iris-out {
		stop-color: color-mix(in oklab, var(--ig-vx) 55%, hsl(200, 40%, 25%));
	}
	.gzi-fibres line {
		stroke: color-mix(in oklab, var(--ig-vx) 30%, hsl(30, 40%, 20%));
		stroke-width: 0.8;
		opacity: 0.5;
	}
	.gzi-limbus {
		fill: none;
		stroke: hsl(210, 35%, 18%);
		stroke-width: 2.5;
	}
	.gzi-pupil {
		fill: #070707;
	}
	.gzi-glint {
		fill: white;
	}
	.gzi-lid {
		fill: none;
		stroke: color-mix(in oklab, var(--gzi-face) 55%, var(--sl-color-black));
		stroke-width: 3.5;
		stroke-linejoin: round;
	}
	.gzi-dark {
		fill: #05060a;
	}
	.gzi-cord {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	.gzi-shade {
		fill: var(--sl-color-gray-3);
	}
	.gzi-bulb {
		fill: var(--ig-v);
	}
</style>

<script>
	import { scene, clamp } from '@components/intro/scene';

	const smooth = (a: number, b: number, x: number) => {
		const t = clamp((x - a) / (b - a));
		return t * t * (3 - 2 * t);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-gzintro]')) {
		// Finger: looking at the finger until 0,45, then the gaze moves to the house and the eye refocuses in about
		// half a second (0,45 → 0,53 of 6 s)
		{
			const card = root.querySelector<HTMLElement>('[data-scene="finger"]')!;
			const far = card.querySelector<SVGFEGaussianBlurElement>('[data-blur-far]')!;
			const near = card.querySelector<SVGFEGaussianBlurElement>('[data-blur-near]')!;
			scene(card, 6, (x) => {
				const u = smooth(0.45, 0.53, x); // 0: on the finger, 1: on the house
				far.setAttribute('stdDeviation', (3.2 * (1 - u)).toFixed(2));
				near.setAttribute('stdDeviation', (6 * u).toFixed(2));
			});
		}

		// Pupil: dim room, the pupil 7 mm (r = 13,4 px); the lamp comes on at 0,12; after 0,25 s the pupil narrows to
		// 2,5 mm (r = 4,8 px) within about a second; the lamp goes out at 0,55 and the pupil widens over about 3 s; 8 s
		{
			const card = root.querySelector<HTMLElement>('[data-scene="pupil"]')!;
			const pupil = card.querySelector<SVGCircleElement>('[data-pupil]')!;
			const glint = card.querySelector<SVGCircleElement>('[data-glint]')!;
			const dark = card.querySelector<SVGRectElement>('[data-dark]')!;
			const bulb = card.querySelector<SVGCircleElement>('[data-bulb]')!;
			const R_DARK = 13.4;
			const R_LIGHT = 4.8;
			scene(card, 8, (x) => {
				const on = x >= 0.12 && x < 0.55;
				const narrow = smooth(0.15, 0.27, x) * (1 - smooth(0.56, 0.95, x));
				pupil.setAttribute('r', (R_DARK - (R_DARK - R_LIGHT) * narrow).toFixed(2));
				dark.style.opacity = on ? '0' : '0.55';
				bulb.style.opacity = on ? '1' : '0.25';
				bulb.style.filter = on ? 'drop-shadow(0 0 10px var(--ig-v))' : '';
				glint.style.opacity = on ? '1' : '0.35';
			});
		}
	}
</script>
