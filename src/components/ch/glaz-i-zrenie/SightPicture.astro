---
/**
 * Short- or long-sightedness and its glasses, two enlarged eyes (12 px per mm, real proportions), rays from a far
 * point, the lens relaxed.
 *   myopic: the eyeball 1,2 mm longer than normal (−4 дптр): the rays meet 1,2 mm in front of the retina; glasses
 *     −4 дптр 12 mm in front of the optical centre: they meet on the retina (0,06 mm in front of it).
 *   hyperopic: 1,0 mm shorter (+4 дптр): the rays would meet 1,0 mm behind the retina; glasses +4 дптр: on it.
 */
import GzStyles from './GzStyles.astro';
import EyeView from './EyeView.astro';
import { EYE_L } from './eye';

interface Props {
	kind: 'myopic' | 'hyperopic';
}
const { kind } = Astro.props;
const L = EYE_L[kind];
const my = kind === 'myopic';
const Pg = my ? -4 : 4;
const view: [number, number, number, number] = [-15, 22, -12.35, 12.35];
---

<GzStyles />
<figure class="lz lzd gz not-content">
	<div class="lzd__grid">
		<div class="lzd__panel">
			<EyeView
				L={L}
				view={view}
				label={my
					? 'Близорукий глаз без очков: глазное яблоко длиннее нормального, лучи от далёкой точки собираются перед сетчаткой и на сетчатку падают расходящимся пучком'
					: 'Дальнозоркий глаз без очков: глазное яблоко короче нормального, лучи от далёкой точки при расслабленном хрусталике дошли бы до точки встречи только за сетчаткой (пунктир)'}
			/>
			<p class="lzd__label">
				<b>Без очков.</b>{' '}
				{my ? 'Лучи собираются перед сетчаткой, на ней — расплывчатое пятно.' : 'Лучи собрались бы за сетчаткой (пунктир), на ней — расплывчатое пятно.'}
			</p>
		</div>
		<div class="lzd__panel">
			<EyeView
				L={L}
				Pg={Pg}
				view={view}
				label={my
					? 'Тот же глаз в очках с рассеивающей линзой −4 диоптрии: лучи после очков расходятся и собираются точно на сетчатке'
					: 'Тот же глаз в очках с собирающей линзой +4 диоптрии: лучи после очков сходятся и собираются точно на сетчатке'}
			/>
			<p class="lzd__label">
				<b>{my ? 'Рассеивающие очки, −4 дптр.' : 'Собирающие очки, +4 дптр.'}</b>{' '}
				{my ? 'Лучи после очков расходятся и собираются на сетчатке.' : 'Лучи после очков сходятся и собираются на сетчатке.'}
			</p>
		</div>
	</div>
	<figcaption class="lz-legend lzd__cap">
		Лучи идут от далёкой точки, хрусталик расслаблен. {my ? 'Глазное яблоко на 1,2 мм длиннее нормального.' : 'Глазное яблоко на 1 мм короче нормального.'}{' '}
		Размеры настоящие, масштаб одинаковый по обеим осям. Точка на оси — место, где собираются лучи.
	</figcaption>
</figure>
