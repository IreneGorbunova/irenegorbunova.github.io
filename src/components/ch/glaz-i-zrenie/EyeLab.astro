---
/**
 * «Глаз и очки»: an eye looks at an arrow 3 cm tall. Top: the scene on a squeezed scale (from 7 cm to 10 m and
 * «очень далеко»); the arrow is dragged along it; a band shows where the eye sees sharply. Below: the same eye
 * enlarged (equal scales, real proportions, 16 px per mm), rays from the foot of the arrow (yellow) and the ray from
 * its tip through the optical centre (blue), the image on the retina.
 * Physics (eye.ts): the eye is one thin lens (cornea + crystalline lens), 60 дптр relaxed; the lens adds up to 6 дптр
 * (an adult of about forty). Normal eye: retina at 16,7 mm; short-sighted: 17,9 mm (−4 дптр); long-sighted: 15,6 mm
 * (+4 дптр). Glasses −6 … +6 дптр stand 12 mm in front of the optical centre and are traced exactly. The eye
 * accommodates by itself (τ = 0,2 s): as much as needed for a sharp image, within 0 … 6 дптр. A defocus under 0,3 дптр
 * counts as sharp. «Так видит глаз» blurs a small eye chart by 2,2 px per дптр of defocus.
 */
import GzStyles from './GzStyles.astro';

const W = 720;
const TICKS: [number, string][] = [
	[100, '10 см'],
	[250, '25 см'],
	[500, '50 см'],
	[1000, '1 м'],
	[2000, '2 м'],
	[5000, '5 м'],
];
const ROWS = ['Ш Б', 'М Н К', 'Ы М Б Ш'];
---

<GzStyles />
<figure class="lz gz gzl not-content" data-eye-lab>
	<svg class="lz__svg gzl__scene" viewBox={`0 0 ${W} 100`} role="group" aria-label="Глаз и предмет на сжатой шкале расстояний">
		<line class="lz-axis" x1="18" y1="56" x2="604" y2="56"></line>
		<line class="gzl__band" data-band x1="0" y1="56" x2="0" y2="56"></line>
		<g data-ticks>
			{
				TICKS.map(([, t]) => (
					<g>
						<line class="gzl__tick" y1="51" y2="61" />
						<text class="lz-t gzl__num" y="84" text-anchor="middle">
							{t}
						</text>
					</g>
				))
			}
			<text class="lz-t gzl__num" x="8" y="84">далеко</text>
		</g>
		<!-- the head, seen from the side, looking left -->
		<path class="gzl__head" d="M 720 4 L 662 4 Q 628 6 626 34 Q 625 44 621 50 L 612 62 Q 610 66 616 67 L 624 68 Q 622 76 628 80 Q 626 86 632 90 Q 640 96 660 96 L 720 96 Z"></path>
		<ellipse class="gzl__eye" cx="634" cy="56" rx="5" ry="3.2"></ellipse>
		<path class="gz-glasses gzl__specs" data-specs d="M 616 46 L 616 66"></path>
		<line class="gzl__temple" data-temple x1="617" y1="48" x2="668" y2="44"></line>
		<g class="gzl__obj" data-obj tabindex="0" role="slider" aria-label="Предмет. Стрелки влево и вправо — двигать" aria-valuemin="70">
			<rect class="gzl__grab" x="-20" y="16" width="40" height="46"></rect>
			<line x1="0" y1="56" x2="0" y2="31"></line>
			<polygon points="0,24 -5.5,33 5.5,33"></polygon>
			<text class="lz-t lz-t--small" y="14" text-anchor="middle">⟷</text>
		</g>
	</svg>

	<div class="gzl__main">
		<svg class="lz__svg gzl__eyesvg" data-eyesvg role="img" aria-label="Глаз крупно: лучи от предмета проходят через очки и хрусталик и попадают на сетчатку">
			<line class="lz-axis gz-axis" data-axis></line>
			<path class="gz-nerve" data-nerve></path>
			<path class="gz-globe" data-globe></path>
			<path class="gz-chamber" data-chamber></path>
			<path class="gz-retina" data-retina></path>
			<path class="gz-sclera" data-sclera></path>
			<path class="gz-cornea" data-cornea></path>
			<g data-zonules></g>
			<ellipse class="gz-ciliary" data-cil></ellipse>
			<ellipse class="gz-ciliary" data-cil></ellipse>
			<path class="gz-glasses" data-glasses></path>
			<g data-rays></g>
			<g class="lz-ray lz-ray--2" data-chief>
				<path class="lz-base"></path>
				<path class="lz-flow"></path>
			</g>
			<path class="gz-lens" data-lens></path>
			<path class="gz-iris" data-iris></path>
			<path class="gz-iris" data-iris></path>
			<g class="gz-image" data-image>
				<line></line>
				<polygon></polygon>
			</g>
			<circle class="gz-focus" r="4.5" data-focus></circle>
		</svg>
	</div>

	<div class="gzl__info">
		<div class="gzl__see">
			<div class="gzl__chart" data-chart>
				<svg viewBox="0 0 120 84" aria-hidden="true">
					{ROWS.map((r, i) => <text x="60" y={[30, 56, 76][i]} text-anchor="middle" font-size={[26, 17, 12][i]}>{r}</text>)}
				</svg>
			</div>
			<p class="gzl__see-cap" data-see-cap>Так видит глаз</p>
		</div>
		<dl class="lz-stats gzl__stats">
			<div><dt>Предмет</dt><dd data-s-d></dd></div>
			<div><dt>Оптическая сила глаза</dt><dd data-s-pow></dd></div>
			<div><dt>Хрусталик</dt><dd data-s-a></dd></div>
			<div><dt>Видит чётко</dt><dd data-s-range></dd></div>
		</dl>
	</div>

	<div class="lz-controls">
		<div class="lz-row">
			<span class="lz-row__label">Глаз:</span>
			<div class="lz-seg gzl__seg" role="group" aria-label="Какой глаз">
				<button type="button" aria-pressed="true" data-kind="normal">нормальный</button>
				<button type="button" aria-pressed="false" data-kind="myopic">близорукий</button>
				<button type="button" aria-pressed="false" data-kind="hyperopic">дальнозоркий</button>
			</div>
		</div>
		<label class="lz-slider gzl__gl">
			<span>Очки</span>
			<output data-g-out>без очков</output>
			<input type="range" min="-6" max="6" step="0.5" value="0" data-g />
		</label>
	</div>
	<p class="lz-live" data-live aria-live="polite"></p>
	<figcaption class="lz-legend">
		Тяните стрелку-предмет. Шкала сверху сжатая: от 7&nbsp;см до 10&nbsp;м; светлая полоса на ней — где глаз видит чётко.
		Внизу глаз крупно, размеры настоящие. <span class="lz-key" style="--c: var(--lz-r1)"></span>лучи от основания стрелки,
		<span class="lz-key" style="--c: var(--lz-r2)"></span>луч от её верхушки через оптический центр; точка на оси — где
		собираются лучи. Хрусталик сам становится выпуклее, насколько может. Это глаз взрослого лет сорока: хрусталик
		добавляет к 60&nbsp;дптр не больше 6&nbsp;дптр.
	</figcaption>
</figure>

<style is:global>
	.gzl__scene {
		touch-action: pan-y;
	}
	.gzl__tick {
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.2;
	}
	.gzl__num {
		font-size: 13px;
	}
	.gzl__band {
		stroke: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
		stroke-width: 9;
		stroke-linecap: round;
		transition:
			x1 0.25s,
			x2 0.25s;
	}
	.gzl__head {
		fill: color-mix(in oklab, var(--ig-v) 30%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	:root[data-theme='light'] .gzl__head {
		fill: color-mix(in oklab, var(--ig-v) 25%, var(--sl-color-gray-6));
	}
	.gzl__eye {
		fill: var(--sl-color-white);
		stroke: var(--sl-color-gray-3);
	}
	.gzl__temple {
		stroke: color-mix(in srgb, var(--ig-v) 75%, var(--sl-color-white));
		stroke-width: 1.6;
	}
	.gzl__obj {
		cursor: ew-resize;
		outline: none;
	}
	.gzl__obj line {
		stroke: var(--sl-color-white);
		stroke-width: 3.2;
		stroke-linecap: round;
	}
	.gzl__obj polygon {
		fill: var(--sl-color-white);
	}
	.gzl__obj:focus-visible line {
		stroke: var(--sl-color-accent);
	}
	.gzl__grab {
		fill: transparent;
		touch-action: none;
	}
	.gzl__main {
		margin-top: 0.5rem;
		border-top: 1px dashed var(--sl-color-gray-5);
		padding-top: 0.5rem;
	}
	.gzl__eyesvg {
		max-width: 46rem;
		margin-inline: auto;
	}
	.gzl__info {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 0.75rem;
		align-items: start;
		margin-top: 0.6rem;
	}
	.gzl__see {
		text-align: center;
	}
	.gzl__chart {
		overflow: hidden;
		border-radius: 0.5rem;
		background: #f7f5ef;
		border: 1px solid var(--sl-color-gray-5);
	}
	.gzl__chart svg {
		display: block;
		width: 100%;
		height: auto;
		transition: filter 0.2s;
	}
	.gzl__chart text {
		fill: #1a1a1a;
		font-family: 'PT Sans', Arial, sans-serif;
		font-weight: 700;
	}
	.gzl__see-cap {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.gzl__stats {
		margin: 0;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.gzl__stats dd {
		font-size: var(--sl-text-base);
		white-space: normal;
	}
	.gzl__seg button {
		padding-inline: 0.75rem;
	}
	@media (max-width: 40rem) {
		.gzl__num {
			font-size: 20px;
		}
		.gzl__info {
			grid-template-columns: minmax(0, 1fr);
		}
		.gzl__see {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			text-align: start;
		}
		.gzl__chart {
			flex: 0 0 7.5rem;
		}
		.gzl__stats dd {
			font-size: var(--sl-text-sm);
		}
		.gzl__seg button {
			font-size: var(--sl-text-xs);
			padding: 0.35rem 0.55rem;
		}
	}
</style>

<script>
	import {
		makeView,
		X,
		Y,
		pathD,
		closed,
		eyeParts,
		traceAxis,
		accommodation,
		defocus,
		sharpAt,
		imageHeight,
		hitRetina,
		globe,
		glassesPts,
		G,
		D0,
		A,
		TOL,
		EYE_L,
		fmt,
		type Kind,
	} from './eye';

	const NS = 'http://www.w3.org/2000/svg';
	const OBJ_H = 30; // mm, the arrow
	// the scale of the scene: 7 cm at x = 590, 10 m at x = 70, «далеко» (infinity) at x = 30
	const XN = 590;
	const XF = 70;
	const DN = 70;
	const DF = 10000;
	const K = (XN - XF) / Math.log(DF / DN);
	const xOf = (d: number) => (Number.isFinite(d) ? XN - K * Math.log(d / DN) : 30);
	const dOf = (x: number) => (x < 50 ? Infinity : DN * Math.exp((XN - Math.min(XN, x)) / K));
	const TICKS = [100, 250, 500, 1000, 2000, 5000];
	const V = makeView(-22, 22, -12.4, 12.4, 16);
	const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));
	const set = (el: Element, attrs: Record<string, string | number>) => {
		for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
	};
	const dist = (d: number) => {
		if (!Number.isFinite(d)) return 'очень далеко';
		if (d < 995) return `${fmt(d / 10, 0)} см`;
		return `${fmt(d / 1000, d < 9950 ? 1 : 0).replace(/,0$/, '')} м`;
	};
	const rangeText = (r: [number, number] | null) => {
		if (!r) return 'ничего';
		const [n, f] = r;
		const near = dist(n).replace('очень далеко', '∞');
		const far = Number.isFinite(f) && f < 20000 ? dist(f) : 'бесконечности';
		return `от ${near} до ${far}`;
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-eye-lab]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const qa = <T extends Element>(s: string) => Array.from(root.querySelectorAll<T>(s));
		const scene = q<SVGSVGElement>('.gzl__scene');
		const obj = q<SVGGElement>('[data-obj]');
		const band = q<SVGLineElement>('[data-band]');
		const specs = q<SVGPathElement>('[data-specs]');
		const temple = q<SVGLineElement>('[data-temple]');
		const svg = q<SVGSVGElement>('[data-eyesvg]');
		const raysG = q<SVGGElement>('[data-rays]');
		const chief = q<SVGGElement>('[data-chief]');
		const image = q<SVGGElement>('[data-image]');
		const focus = q<SVGCircleElement>('[data-focus]');
		const chart = q<SVGSVGElement>('[data-chart] svg');
		const seeCap = q<HTMLElement>('[data-see-cap]');
		const kindBtns = qa<HTMLButtonElement>('[data-kind]');
		const gIn = q<HTMLInputElement>('[data-g]');
		const gOut = q<HTMLOutputElement>('[data-g-out]');
		const live = q<HTMLElement>('[data-live]');
		const sD = q<HTMLElement>('[data-s-d]');
		const sP = q<HTMLElement>('[data-s-pow]');
		const sA = q<HTMLElement>('[data-s-a]');
		const sR = q<HTMLElement>('[data-s-range]');

		set(svg, { viewBox: `0 0 ${V.w} ${V.h.toFixed(1)}` });
		set(q('[data-axis]'), { x1: 0, x2: V.w, y1: Y(V, 0), y2: Y(V, 0) });
		// scale ticks of the scene
		qa<SVGGElement>('[data-ticks] > g').forEach((g, i) => {
			const x = xOf(TICKS[i]);
			set(g.querySelector('line')!, { x1: x, x2: x });
			g.querySelector('text')!.setAttribute('x', String(x));
		});

		const rays = Array.from({ length: 5 }, () => {
			const g = document.createElementNS(NS, 'g');
			g.setAttribute('class', 'lz-ray');
			const virt = document.createElementNS(NS, 'path');
			virt.setAttribute('class', 'lz-virt');
			const base = document.createElementNS(NS, 'path');
			base.setAttribute('class', 'lz-base');
			const flow = document.createElementNS(NS, 'path');
			flow.setAttribute('class', 'lz-flow');
			g.append(virt, base, flow);
			raysG.append(g);
			return { virt, base, flow };
		});
		const zon = Array.from({ length: 6 }, () => {
			const p = document.createElementNS(NS, 'path');
			p.setAttribute('class', 'gz-zonule');
			q('[data-zonules]').append(p);
			return p;
		});

		const st = { kind: 'normal' as Kind, d: 5000, Pg: 0 };
		let a = 0; // current accommodation, follows the target
		let L = EYE_L.normal; // current retina distance (tweened when the eye changes)
		let raf = 0;
		let last = 0;

		const drawEye = () => {
			const e = eyeParts(V, L, a);
			set(q('[data-globe]'), { d: e.globe });
			set(q('[data-sclera]'), { d: e.sclera });
			set(q('[data-cornea]'), { d: e.cornea });
			set(q('[data-chamber]'), { d: e.chamber });
			set(q('[data-retina]'), { d: e.retina });
			set(q('[data-nerve]'), { d: e.nerve });
			set(q('[data-lens]'), { d: e.lens });
			qa('[data-iris]').forEach((el, i) => el.setAttribute('d', e.iris[i]));
			qa('[data-cil]').forEach((el, i) => set(el, e.ciliary[i] as unknown as Record<string, number>));
			zon.forEach((p, i) => p.setAttribute('d', e.zonules[i]));
			const gp = st.Pg ? closed(V, glassesPts(st.Pg, 7.5)) : '';
			q('[data-glasses]').setAttribute('d', gp);

			// rays from the foot of the arrow
			const tr = traceAxis(st.d, st.Pg, L, a, V.xmin, 5);
			const f = tr.focus;
			const behind = f !== null && f > L + 0.02;
			tr.rays.forEach((r, i) => {
				const dd = pathD(V, r);
				rays[i].base.setAttribute('d', dd);
				rays[i].flow.setAttribute('d', dd);
				rays[i].virt.setAttribute('d', behind ? pathD(V, [r[r.length - 1], [Math.min(f!, V.xmax), 0]]) : '');
			});
			if (f !== null && f < V.xmax) {
				set(focus, { cx: X(V, f), cy: Y(V, 0) });
				focus.style.display = '';
			} else focus.style.display = 'none';

			// the ray from the tip through the optical centre, and the image
			const H = imageHeight(st.d, OBJ_H, st.Pg, L);
			if (Number.isFinite(st.d) && Math.abs(H) > 0.05) {
				const s = H / L;
				const hit = hitRetina(globe(L), [0, 0], s);
				const pts: [number, number][] = [];
				if (st.Pg) {
					const yg = -s * G; // at the glasses
					const sin = s + (yg * st.Pg) / 1000; // before them
					pts.push([V.xmin, yg + sin * (V.xmin + G)], [-G, yg]);
				} else pts.push([V.xmin, s * V.xmin]);
				pts.push([0, 0], hit);
				const dd = pathD(V, pts);
				chief.querySelectorAll('path').forEach((p) => p.setAttribute('d', dd));
				chief.style.display = '';
				const x0 = X(V, L);
				const y0 = Y(V, 0);
				const x1 = X(V, hit[0]);
				const y1 = Y(V, hit[1]);
				const len = Math.hypot(x1 - x0, y1 - y0);
				const ux = (x1 - x0) / len;
				const uy = (y1 - y0) / len;
				const hl = Math.min(9, len * 0.45);
				const hw = hl * 0.6;
				const bx = x1 - ux * hl;
				const by = y1 - uy * hl;
				set(image.querySelector('line')!, { x1: x0, y1: y0, x2: bx + ux * hl * 0.3, y2: by + uy * hl * 0.3 });
				image
					.querySelector('polygon')!
					.setAttribute('points', `${x1},${y1} ${bx - uy * hw},${by + ux * hw} ${bx + uy * hw},${by - ux * hw}`);
				image.style.display = '';
			} else {
				chief.style.display = 'none';
				image.style.display = 'none';
			}
		};

		const drawScene = () => {
			const x = xOf(st.d);
			obj.setAttribute('transform', `translate(${x.toFixed(1)} 0)`);
			set(obj, {
				'aria-valuenow': Number.isFinite(st.d) ? Math.round(st.d) : 100000,
				'aria-valuemax': 100000,
				'aria-valuetext': dist(st.d),
			});
			// the band of clear vision (with the depth of focus)
			const nearS = sharpAt(st.Pg, EYE_L[st.kind], A + TOL);
			const farS = sharpAt(st.Pg, EYE_L[st.kind], -TOL);
			if (!Number.isFinite(nearS)) set(band, { x1: 0, x2: 0, opacity: 0 });
			else {
				const x1 = Math.min(xOf(Math.max(nearS, DN)), XN);
				const x2 = Number.isFinite(farS) && farS < DF * 3 ? xOf(Math.min(farS, DF)) : 22;
				set(band, { x1: x1.toFixed(1), x2: x2.toFixed(1), opacity: 1 });
			}
			specs.style.display = st.Pg ? '' : 'none';
			temple.style.display = st.Pg ? '' : 'none';
		};

		const drawInfo = () => {
			const Lk = EYE_L[st.kind];
			const target = accommodation(st.d, st.Pg, Lk);
			const dv = defocus(st.d, st.Pg, Lk, target.a);
			const sharp = Math.abs(dv) < TOL;
			sD.textContent = dist(st.d);
			sP.textContent = `${fmt(D0 + a, 1)} дптр`;
			const aNow = Math.round(a * 10) / 10;
			sA.textContent = aNow < 0.05 ? 'расслаблен' : aNow > A - 0.05 ? `+${fmt(A, 0)} дптр, предел` : `выпуклее: +${fmt(aNow, 1)} дптр`;
			// the range of clear vision, with the depth of focus
			const nearS = sharpAt(st.Pg, Lk, A + TOL);
			const rt: [number, number] | null = Number.isFinite(nearS) ? [nearS, sharpAt(st.Pg, Lk, -TOL)] : null;
			sR.textContent = rangeText(rt);
			const blur = sharp ? 0 : Math.min(12, 2.2 * Math.abs(dv));
			chart.style.filter = blur ? `blur(${blur.toFixed(1)}px)` : '';
			seeCap.textContent = sharp ? 'Так видит глаз: чётко' : 'Так видит глаз: размыто';
			let msg: string;
			if (sharp) {
				msg =
					target.a < 0.05
						? '<b>Изображение на сетчатке — предмет виден чётко.</b> Хрусталик расслаблен.'
						: `<b>Изображение на сетчатке — предмет виден чётко.</b> Для этого хрусталик стал выпуклее, и оптическая сила глаза выросла на ${fmt(target.a, 1)} дптр.`;
			} else if (dv > 0) {
				msg = `<b>Лучи собираются перед сетчаткой</b> (точка на оси), а на сетчатке — расплывчатое пятно. Хрусталик расслаблен${st.Pg > 0 ? ', а собирающие очки только добавляют оптической силы' : ''}: сделать его ещё площе глаз не может.`;
			} else {
				msg = `<b>Лучи собрались бы за сетчаткой</b> (пунктир), а на сетчатке — расплывчатое пятно. Хрусталик уже стал выпуклее до предела, на ${fmt(A, 0)} дптр${st.Pg < 0 ? ', а рассеивающие очки отнимают оптическую силу' : ''}.`;
			}
			live.innerHTML = msg;
			gOut.value = st.Pg === 0 ? 'без очков' : `${st.Pg > 0 ? '+' : '−'}${fmt(Math.abs(st.Pg), 1).replace(/,0$/, '')} дптр, ${st.Pg > 0 ? 'собирающие' : 'рассеивающие'}`;
			kindBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === st.kind)));
		};

		// the eye follows its target: the lens accommodates in about 0,2 s, the eyeball morphs on a switch
		const tick = (now: number) => {
			const dt = Math.min(0.05, (now - (last || now)) / 1000);
			last = now;
			const Lk = EYE_L[st.kind];
			const target = accommodation(st.d, st.Pg, Lk).a;
			const k = 1 - Math.exp(-dt / 0.2);
			a += (target - a) * k;
			L += (Lk - L) * (1 - Math.exp(-dt / 0.15));
			const done = Math.abs(target - a) < 0.01 && Math.abs(Lk - L) < 0.002;
			if (done) {
				a = target;
				L = Lk;
			}
			drawEye();
			drawInfo();
			raf = done ? 0 : requestAnimationFrame(tick);
		};
		const update = () => {
			drawScene();
			drawInfo();
			if (!raf) {
				last = 0;
				raf = requestAnimationFrame(tick);
			}
		};

		// dragging the arrow
		let dragging = false;
		let off = 0;
		const sx = (e: PointerEvent) => new DOMPoint(e.clientX, e.clientY).matrixTransform(scene.getScreenCTM()!.inverse()).x;
		obj.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			dragging = true;
			off = xOf(st.d) - sx(e);
			scene.setPointerCapture(e.pointerId);
			e.preventDefault();
		});
		scene.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const x = clamp(sx(e) + off, 30, XN);
			let d = dOf(x);
			// snap to the marked distances
			for (const t of TICKS) if (Math.abs(xOf(t) - x) < 6) d = t;
			st.d = Number.isFinite(d) ? Math.round(d) : d;
			update();
		});
		const stop = () => (dragging = false);
		scene.addEventListener('pointerup', stop);
		scene.addEventListener('pointercancel', stop);
		obj.addEventListener('keydown', (e) => {
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			e.preventDefault();
			// steps along the marked distances and «далеко»
			const stops = [70, ...TICKS, 10000, Infinity];
			let i = stops.findIndex((s) => s >= st.d);
			if (i < 0) i = stops.length - 1;
			// left: farther away, right: closer to the eye
			if (e.key === 'ArrowLeft') i = stops[i] > st.d ? i : Math.min(stops.length - 1, i + 1);
			else i = Math.max(0, i - 1);
			st.d = stops[i];
			update();
		});
		kindBtns.forEach((b) =>
			b.addEventListener('click', () => {
				st.kind = b.dataset.kind as Kind;
				update();
			}),
		);
		gIn.addEventListener('input', () => {
			st.Pg = Number(gIn.value);
			drawEye();
			update();
		});

		gIn.value = '0';
		a = accommodation(st.d, st.Pg, L).a;
		drawScene();
		drawEye();
		drawInfo();
	}
</script>
