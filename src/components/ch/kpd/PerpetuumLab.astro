---
/**
 * «Вечный двигатель» with weights in channels (the overbalanced wheel, proposed many times since the Middle Ages). Eight
 * balls roll in eight straight channels fixed to the wheel. A channel runs from its inner end (48 px from the axle, at
 * the angle φ of its spoke) to its outer end (92 px from the axle, 70° further clockwise), so on the descending
 * (right) side the outer end is the lower one and the ball rolls out to the rim, while on the rising (left) side the
 * inner end is lower and the ball rolls in towards the axle. That is the inventor's idea: the right side seems always
 * heavier.
 *
 * The model is honest. A ball only ever rolls DOWN its channel: ds/dt = −k·(y_out − y_in)/l (s = 0 at the inner end,
 * 1 at the outer end, k = 3 1/с, l the channel's length; the ball stops at the end it reaches), so a ball never rises
 * by itself; only the wheel lifts it. The force of a ball on the wheel is its weight at its place, so the torque about
 * the axle is −Σ m·g·xᵢ (xᵢ the horizontal distance of ball i from the axle). The wheel turns as
 * θ'' = (torque)/I − c·θ' − a·sign θ' (friction in the axle, c = 0,1 1/с, a = 0,25 1/с², I constant), steps of 1/240 с.
 * Energy: the wheel's work on the balls equals the change of their height as carried by the wheel, and the rolling
 * only lowers them, so kinetic + potential energy can only decrease; the wheel must stop. It stops where the torques
 * balance: 3 balls far out on the right against 5 balls closer to the axle on the left (computed on load by letting
 * the wheel settle from rest). A push (θ' = −8 рад/с, clockwise, the way the inventor hoped it would turn) makes it go
 * round about one turn and stop within about 7 с (checked by running the same equations outside the page). Time scale
 * arbitrary (g chosen so that the motion is easy to watch); the drawing is a scheme, not to scale.
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 150;
const CY = 140;
---

<G7Styles />
<figure class="g7 g7--stack g7--narrow pm not-content" data-perpetuum>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 272" role="img" aria-label="Колесо с восемью шарами в наклонных желобах: справа шары скатываются к ободу, слева — к оси. Если колесо толкнуть, оно поворачивается и останавливается">
			<path class="pm__stand" d={`M${CX - 50} 264 L${CX} ${CY} L${CX + 50} 264 Z`}></path>
			<rect class="pm__base" x="60" y="262" width="180" height="8" rx="2"></rect>
			<g data-wheel>
				<circle class="pm__rim" cx={CX} cy={CY} r="104"></circle>
				{Array.from({ length: 8 }, (_, i) => <line class="pm__spoke" data-spoke={i} />)}
				{Array.from({ length: 8 }, (_, i) => <line class="pm__tube" data-tube={i} />)}
				{Array.from({ length: 8 }, (_, i) => <line class="pm__groove" data-groove={i} />)}
				{Array.from({ length: 8 }, (_, i) => <circle class="pm__ball" data-ballw={i} r="5.5" />)}
			</g>
			<circle class="pm__hub" cx={CX} cy={CY} r="7"></circle>
			<text class="t-small t-halo" x="290" y="20" text-anchor="end">справа грузы дальше от оси,</text>
			<text class="t-small t-halo" x="290" y="34" text-anchor="end">зато слева их больше</text>
		</svg>
		<div class="g7__row">
			<button type="button" class="g7__btn g7__btn--go" data-push>Толкнуть колесо</button>
			<span class="g7__note" data-state aria-live="polite">Колесо стоит.</span>
		</div>
	</div>
	<figcaption class="g7__caption">
		Колесо с шарами в желобах — один из самых известных «вечных двигателей». Шары сами только скатываются вниз: справа — к ободу, слева — к оси; поднимает их само колесо. Толкните его: оно сделает около оборота и остановится. Движение показано медленнее, чем было бы у настоящего колеса.
	</figcaption>
</figure>

<style is:global>
	.pm__stand {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.pm__base {
		fill: var(--g7-wood-dark);
	}
	.pm__rim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 4;
	}
	.pm__spoke {
		stroke: var(--g7-line);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.pm__tube {
		stroke: var(--g7-line);
		stroke-width: 15;
		stroke-linecap: round;
	}
	.pm__groove {
		stroke: var(--g7-paper);
		stroke-width: 11;
		stroke-linecap: round;
	}
	.pm__ball {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pm__hub {
		fill: var(--g7-ink);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const CX = 150;
	const CY = 140;
	const N = 8;
	const R1 = 48; // px, the inner end of a channel
	const R2 = 92; // px, the outer end
	const DEL = (-70 * Math.PI) / 180; // the outer end lies 70° further clockwise
	const KS = 3; // 1/с, how fast a ball rolls down a steep channel (a whole channel in about 1/3 с)
	const I = N * 62 * 62 * 1.2;
	const G = 900;
	const C = 0.1;
	const AF = 0.25;
	const DT = 1 / 240;
	const PUSH = 8; // рад/с
	type St = { th: number; w: number; s: number[] };
	/** The two ends of channel i (y up). */
	const ends = (th: number, i: number) => {
		const p = th + (i * 2 * Math.PI) / N;
		return [R1 * Math.cos(p), R1 * Math.sin(p), R2 * Math.cos(p + DEL), R2 * Math.sin(p + DEL)];
	};
	/** One step; returns false when the wheel and every ball are at rest. */
	const step = (st: St) => {
		let tq = 0;
		let rolling = false;
		for (let i = 0; i < N; i++) {
			const [xi, yi, xo, yo] = ends(st.th, i);
			const l = Math.hypot(xo - xi, yo - yi);
			// a ball rolls only down its channel and stops at an end
			const s = Math.min(1, Math.max(0, st.s[i] - (KS * (yo - yi) * DT) / l));
			if (Math.abs(s - st.s[i]) > 1e-9) rolling = true;
			st.s[i] = s;
			tq -= xi + s * (xo - xi);
		}
		const g = (tq / I) * G;
		if (Math.abs(st.w) < 0.03 && Math.abs(g) < AF && !rolling) {
			st.w = 0;
			return false;
		}
		st.w += (g - C * st.w - AF * Math.sign(st.w || g)) * DT;
		st.th += st.w * DT;
		return true;
	};
	// the wheel at rest: let it settle from any position
	const rest: St = { th: 0, w: 0, s: Array(N).fill(0.5) };
	for (let n = 0; n < 240 * 60 && step(rest); n++);

	for (const root of document.querySelectorAll<HTMLElement>('[data-perpetuum]')) {
		const spokes = [...root.querySelectorAll<SVGLineElement>('[data-spoke]')];
		const tubes = [...root.querySelectorAll<SVGLineElement>('[data-tube]')];
		const grooves = [...root.querySelectorAll<SVGLineElement>('[data-groove]')];
		const balls = [...root.querySelectorAll<SVGCircleElement>('[data-ballw]')];
		const state = root.querySelector<HTMLElement>('[data-state]')!;
		const st: St = { th: rest.th, w: 0, s: [...rest.s] };
		let acc = 0;
		let moving = false;
		const line = (e: SVGLineElement, x1: number, y1: number, x2: number, y2: number) => {
			e.setAttribute('x1', (CX + x1).toFixed(1));
			e.setAttribute('y1', (CY - y1).toFixed(1));
			e.setAttribute('x2', (CX + x2).toFixed(1));
			e.setAttribute('y2', (CY - y2).toFixed(1));
		};
		const draw = () => {
			for (let i = 0; i < N; i++) {
				const [xi, yi, xo, yo] = ends(st.th, i);
				line(spokes[i], 0, 0, xi, yi);
				line(tubes[i], xi, yi, xo, yo);
				line(grooves[i], xi, yi, xo, yo);
				const s = st.s[i];
				balls[i].setAttribute('cx', (CX + xi + s * (xo - xi)).toFixed(1));
				balls[i].setAttribute('cy', (CY - yi - s * (yo - yi)).toFixed(1));
			}
		};
		const wake = loop(root, (dt) => {
			if (!moving) return false;
			acc += dt;
			while (acc >= DT) {
				acc -= DT;
				if (!step(st)) {
					moving = false;
					state.textContent = 'Колесо остановилось.';
					break;
				}
			}
			draw();
			return moving;
		});
		root.querySelector('[data-push]')!.addEventListener('click', () => {
			st.w -= PUSH;
			acc = 0;
			moving = true;
			state.textContent = 'Колесо крутится…';
			wake();
		});
		draw();
	}
</script>
