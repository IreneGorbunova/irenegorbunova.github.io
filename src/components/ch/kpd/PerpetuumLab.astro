---
/**
 * «Вечный двигатель» with weights on spokes (a design proposed many times since the Middle Ages). Eight weights slide
 * along the spokes of a wheel: on the right side they roll out to the rim, on the left they roll in to the axle, so the
 * right side seems always heavier. The model computes the motion honestly. Each weight's distance from the axle is
 * fixed by the angle of its spoke, r(φ) = 62 + 30·tanh(4 cos φ) px (32…92 px), so the height of every weight, and the
 * energy of the wheel in the field of gravity U(θ) = Σ m·g·r(φᵢ)·sin φᵢ, depend only on the turn θ of the wheel and
 * repeat every 45°. The wheel turns as θ'' = −U'(θ)/I − c·θ' − a·sign θ' (friction in the axle: c = 0,4 1/с,
 * a = 0,4 1/с²; I taken constant), integrated in steps of 1/240 с. With no push it stands still at the lowest U:
 * fewer weights far out on the right balance more weights near the axle on the left. A push (θ' = −5,5 рад/с, the
 * way the inventor hoped it would turn) makes it go round about 1,3 turns, rock back and forth and stop within
 * about 7 с (checked by running the same equations outside the page). The time scale is arbitrary (g taken so that the motion is easy to watch).
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 150;
const CY = 140;
---

<G7Styles />
<figure class="g7 g7--stack g7--narrow pm not-content" data-perpetuum>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 268" role="img" aria-label="Колесо с восемью грузами на спицах: справа грузы откатываются к ободу, слева — к оси. Если колесо толкнуть, оно поворачивается, качается и останавливается">
			<path class="pm__stand" d={`M${CX - 50} 262 L${CX} ${CY} L${CX + 50} 262 Z`}></path>
			<rect class="pm__base" x="60" y="258" width="180" height="8" rx="2"></rect>
			<g data-wheel>
				<circle class="pm__rim" cx={CX} cy={CY} r="100"></circle>
				{Array.from({ length: 8 }, (_, i) => <line class="pm__spoke" data-spoke={i} />)}
				{Array.from({ length: 8 }, (_, i) => <circle class="pm__ball" data-ballw={i} r="9" />)}
			</g>
			<circle class="pm__hub" cx={CX} cy={CY} r="7"></circle>
			<text class="t-small t-halo" x="290" y="20" text-anchor="end">справа грузы дальше от оси,</text>
			<text class="t-small t-halo" x="290" y="34" text-anchor="end">зато слева их больше</text>
		</svg>
		<div class="g7__row">
			<button type="button" class="g7__btn g7__btn--go" data-push>Толкнуть колесо</button>
			<span class="g7__note" data-state aria-live="polite">Колесо стоит.</span>
		</div>
	</div>
	<figcaption class="g7__caption">
		Колесо с грузами на спицах — один из самых известных «вечных двигателей». Толкните его: оно повернётся, покачается и остановится.
	</figcaption>
</figure>

<style is:global>
	.pm__stand {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.pm__base {
		fill: var(--g7-wood-dark);
	}
	.pm__rim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 4;
	}
	.pm__spoke {
		stroke: var(--g7-line);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.pm__ball {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.pm__hub {
		fill: var(--g7-ink);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const CX = 150;
	const CY = 140;
	const N = 8;
	const rOf = (p: number) => 62 + 30 * Math.tanh(4 * Math.cos(p));
	const U = (th: number) => {
		let s = 0;
		for (let i = 0; i < N; i++) {
			const p = th + (i * 2 * Math.PI) / N;
			s += rOf(p) * Math.sin(p);
		}
		return s;
	};
	const dU = (th: number) => (U(th + 1e-4) - U(th - 1e-4)) / 2e-4;
	const I = N * 62 * 62 * 1.2;
	const G = 1500;
	const C = 0.4;
	const AF = 0.4;
	const DT = 1 / 240;
	// the wheel at rest: the lowest U
	let th0 = 0;
	let best = Infinity;
	for (let k = 0; k < 6284; k++) {
		const v = U(k / 1000);
		if (v < best) {
			best = v;
			th0 = k / 1000;
		}
	}
	for (const root of document.querySelectorAll<HTMLElement>('[data-perpetuum]')) {
		const spokes = [...root.querySelectorAll<SVGLineElement>('[data-spoke]')];
		const balls = [...root.querySelectorAll<SVGCircleElement>('[data-ballw]')];
		const state = root.querySelector<HTMLElement>('[data-state]')!;
		let th = th0;
		let w = 0;
		let acc = 0;
		let moving = false;
		const draw = () => {
			for (let i = 0; i < N; i++) {
				const p = th + (i * 2 * Math.PI) / N;
				const c = Math.cos(p);
				const s = Math.sin(p);
				spokes[i].setAttribute('x1', String(CX));
				spokes[i].setAttribute('y1', String(CY));
				spokes[i].setAttribute('x2', (CX + 100 * c).toFixed(1));
				spokes[i].setAttribute('y2', (CY - 100 * s).toFixed(1));
				const r = rOf(p);
				balls[i].setAttribute('cx', (CX + r * c).toFixed(1));
				balls[i].setAttribute('cy', (CY - r * s).toFixed(1));
			}
		};
		const wake = loop(root, (dt) => {
			if (!moving) return false;
			acc += dt;
			while (acc >= DT) {
				acc -= DT;
				const g = (-dU(th) / I) * G;
				if (Math.abs(w) < 0.03 && Math.abs(g) < AF) {
					w = 0;
					moving = false;
					state.textContent = 'Колесо остановилось.';
					break;
				}
				w += (g - C * w - AF * Math.sign(w || g)) * DT;
				th += w * DT;
			}
			draw();
			return moving;
		});
		root.querySelector('[data-push]')!.addEventListener('click', () => {
			w -= 5.5;
			acc = 0;
			moving = true;
			state.textContent = 'Колесо крутится…';
			wake();
		});
		draw();
	}
</script>
