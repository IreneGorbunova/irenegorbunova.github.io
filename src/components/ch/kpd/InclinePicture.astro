---
/**
 * Picture «Наклонная плоскость»: the same box (weight P = 100 Н) is raised by the same height in two ways, with no
 * friction. On the left it is pulled along an inclined plane of length l = 2 м and height h = 1 м (30°) with the force
 * F = P·h/l = 50 Н; on the right it is lifted straight up with F = P = 100 Н. The box on the plane goes 1,6 м along it
 * (from its rear corner 0,125 м above the foot until its front corner reaches the top), so it rises by 0,8 м; the box
 * on the right rises by the same 0,8 м. Both works come to 50 Н · 1,6 м = 100 Н · 0,8 м = 80 Дж.
 * Scale: 80 px per metre; the arrows 0,5 px per newton (P and F to one scale). The box is 27,5 см.
 * The motion takes 4 с, then the end is held for 2 с, and it starts again.
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const K = 80;
const GY = 168; // the ground
const PX = 214; // the left wall of the step
const PW = 56; // its width
const TOPY = GY - K; // its top, h = 1 м
const FX = PX - Math.sqrt(3) * K; // the foot of the plane
const f = (v: number) => v.toFixed(1);
// the label of l, along the plane inside the wedge
const IN = 14;
const nx = 0.5 * IN; // the inner normal of the slope (down-right)
const ny = 0.866 * IN;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow incp not-content" data-incpic>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 246" role="img" aria-label="Один и тот же ящик весом 100 ньютонов поднимают на одну и ту же высоту двумя способами: по наклонной плоскости длиной 2 метра и высотой 1 метр с силой 50 ньютонов и прямо вверх с силой 100 ньютонов. Работа в обоих случаях одна и та же">
			<defs>
				<marker id={`incpf-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`incpp-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path class="head--blue" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<text class="t-title" x="12" y="20">по наклонной плоскости</text>
			<text class="t-title" x="348" y="20" text-anchor="end">прямо вверх</text>
			<rect class="incp__ground" x="0" y={GY} width="360" height="5"></rect>
			<!-- the step, 1 м high, and the wedge leaning on it -->
			<rect class="incp__step" x={PX} y={TOPY} width={PW} height={K}></rect>
			<path class="incp__wedge" d={`M${f(FX)} ${GY} L${PX} ${TOPY} V${GY} Z`}></path>
			<!-- h and l -->
			<path class="incp__dim" d={`M${PX + PW - 8} ${TOPY + 2} V${GY - 2} M${PX + PW - 12} ${TOPY + 2} h8 M${PX + PW - 12} ${GY - 2} h8`}></path>
			<text class="t-halo incp__dimt" x={PX + PW - 13} y={TOPY + 44} text-anchor="end"><tspan class="t-i">h</tspan> = 1&nbsp;м</text>
			<text class="t-halo incp__dimt" transform={`translate(${f((FX + PX) / 2 + 2 * nx + 4)} ${f((GY + TOPY) / 2 + 2 * ny)}) rotate(-30)`} text-anchor="middle"><tspan class="t-i">l</tspan> = 2&nbsp;м</text>
			<!-- the level the boxes reach -->
			<path class="ln-dash" d={`M${PX + PW} ${f(GY - 0.8 * K)} H350`}></path>
			<!-- the box on the plane, with its arrows -->
			<g data-boxa>
				<rect class="incp__box" x="0" y="-22" width="22" height="22" rx="1.5"></rect>
				<path class="incp__boxline" d="M0 -11 H22 M11 -22 V0"></path>
			</g>
			<line class="arrow arrow--blue" data-pa marker-end={`url(#incpp-${uid})`}></line>
			<line class="arrow arrow--red" data-fa marker-end={`url(#incpf-${uid})`}></line>
			<text class="t-i t-blue t-halo" data-pat>P</text>
			<text class="t-i t-red t-halo" data-fat>F</text>
			<!-- the box lifted straight up -->
			<g data-boxb>
				<rect class="incp__box" x="-11" y="-22" width="22" height="22" rx="1.5"></rect>
				<path class="incp__boxline" d="M-11 -11 H11 M0 -22 V0"></path>
			</g>
			<line class="arrow arrow--blue" data-pb marker-end={`url(#incpp-${uid})`}></line>
			<line class="arrow arrow--red" data-fb marker-end={`url(#incpf-${uid})`}></line>
			<text class="t-i t-blue t-halo" data-pbt>P</text>
			<text class="t-i t-red t-halo" data-fbt>F</text>
			<!-- the readouts -->
			<text class="incp__read" x="12" y="216" data-ra></text>
			<text class="incp__read" x="12" y="238" data-rb></text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Ящик весом 100&nbsp;Н поднимают на одну и ту же высоту, трения нет. По плоскости вдвое длиннее её высоты сила вдвое меньше веса, зато путь вдвое длиннее — работа та же.
	</figcaption>
</figure>

<style is:global>
	.incp__ground {
		fill: var(--g7-ground);
	}
	.incp__step {
		fill: color-mix(in oklab, var(--g7-red) 30%, var(--g7-faint));
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.incp__wedge {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.incp__dim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .incp__dimt {
		font-size: 12px;
		fill: var(--g7-ink);
	}
	.incp__box {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.incp__boxline {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 0.6;
		opacity: 0.5;
	}
	.g7__svg .incp__read {
		font-size: 12.5px;
		fill: var(--g7-ink);
		font-variant-numeric: tabular-nums;
	}
</style>

<script>
	import { fmt, loop, ease } from '../g7/kit';

	const K = 80;
	const GY = 168;
	const PX = 214;
	const PW = 56;
	const FX = PX - Math.sqrt(3) * K;
	const C = Math.sqrt(3) / 2; // cos 30°
	const SN = 0.5;
	const FS = 0.5; // px per newton
	const BOX = 0.275; // м
	const BX = 312; // the axis of the box lifted straight up
	const RUN = 4;
	const HOLD = 2;
	const PRE = 0.6;
	const set = (e: Element, a: Record<string, number | string>) => {
		for (const [k, v] of Object.entries(a)) e.setAttribute(k, typeof v === 'number' ? v.toFixed(1) : v);
	};
	for (const root of document.querySelectorAll<HTMLElement>('[data-incpic]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const boxa = q<SVGGElement>('[data-boxa]');
		const boxb = q<SVGGElement>('[data-boxb]');
		const ra = q<SVGTextElement>('[data-ra]');
		const rb = q<SVGTextElement>('[data-rb]');
		let t = 0;
		const draw = () => {
			const u = ease((t - PRE) / RUN);
			const path = 1.6 * u; // м along the plane
			const rise = 0.8 * u; // м, both boxes
			// the box on the plane: its rear bottom corner at s м from the foot
			const s = 0.125 + path;
			const x0 = FX + s * C * K;
			const y0 = GY - s * SN * K;
			boxa.setAttribute('transform', `translate(${x0.toFixed(1)} ${y0.toFixed(1)}) rotate(-30)`);
			// its center: half the box along the plane and half up from it
			const h = (BOX * K) / 2;
			const ca = { x: x0 + h * C - h * SN, y: y0 - h * SN - h * C };
			set(q('[data-pa]'), { x1: ca.x, y1: ca.y, x2: ca.x, y2: ca.y + 100 * FS });
			set(q('[data-fa]'), { x1: ca.x, y1: ca.y, x2: ca.x + 50 * FS * C, y2: ca.y - 50 * FS * SN });
			set(q('[data-pat]'), { x: ca.x + 5, y: ca.y + 100 * FS - 2 });
			set(q('[data-fat]'), { x: ca.x + 50 * FS * C - 2, y: ca.y - 50 * FS * SN - 8 });
			// the box lifted straight up
			const yb = GY - rise * K;
			boxb.setAttribute('transform', `translate(${BX} ${yb.toFixed(1)})`);
			const cb = yb - h;
			set(q('[data-pb]'), { x1: BX + 4, y1: cb, x2: BX + 4, y2: cb + 100 * FS });
			set(q('[data-fb]'), { x1: BX - 4, y1: cb, x2: BX - 4, y2: cb - 100 * FS });
			set(q('[data-pbt]'), { x: BX + 9, y: cb + 100 * FS - 2 });
			set(q('[data-fbt]'), { x: BX - 18, y: cb - 100 * FS + 10 });
			ra.textContent = `по плоскости: 50 Н · ${fmt(path, 2)} м = ${fmt(50 * path, 0)} Дж`;
			rb.textContent = `прямо вверх: 100 Н · ${fmt(rise, 2)} м = ${fmt(100 * rise, 0)} Дж`;
		};
		loop(root, (dt) => {
			t += dt;
			if (t > PRE + RUN + HOLD) t = 0;
			draw();
			return true;
		})();
		draw();
	}
</script>
