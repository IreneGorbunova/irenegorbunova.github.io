---
/**
 * Picture «Серпантин»: a road up a mountain goes in loops. Above, the mountain (drawn schematically, not to scale) with
 * a serpentine road and a car driving up it (10 с up, then it starts again), and the straight way up its slope
 * (dashed). Below, both roads unrolled into inclined planes, to one scale (0,09 px per metre): the climb is 300 м; the
 * straight way is 600 м long (h/l = 1/2, 30°), the serpentine 3 км (h/l = 1/10, a usual grade of a mountain road).
 * Without friction the pull needed along the road is F = P·h/l: half the weight of the car on the straight way, a
 * tenth of it on the serpentine.
 */
import G7Styles from '../g7/G7Styles.astro';

const f = (v: number) => v.toFixed(1);
// the slopes of the mountain: left from (10, 166) to the peak (190, 28), right from the peak to (350, 166)
const xl = (y: number) => 10 + ((166 - y) / 138) * 180;
const xr = (y: number) => 350 - ((166 - y) / 138) * 160;
// the serpentine: six legs, each across the face and 20 px up, joined by hairpin bends
const ys = [160, 140, 120, 100, 80, 60, 46];
let road = '';
let side = 1; // 1: the leg goes to the right
let x = 186;
road += `M${x} ${ys[0] + 6} L${x} ${ys[0]}`;
for (let i = 0; i < ys.length - 1; i++) {
	const y1 = ys[i + 1];
	const xe = side > 0 ? xr(y1) - 16 : xl(y1) + 16;
	// the leg rises along the face, then a hairpin bend turns it back
	road += ` L${f(xe)} ${f(y1 + 4)} Q${f(xe + side * 9)} ${f(y1 + 2)} ${f(xe)} ${f(y1)}`;
	x = xe;
	side = -side;
}
road += ` L${f(193)} ${ys[ys.length - 1] - 4}`;
// the unrolled roads, 0,1 px per metre
const S = 0.09;
const H = 300 * S;
const run1 = Math.sqrt(600 ** 2 - 300 ** 2) * S;
const run2 = Math.sqrt(3000 ** 2 - 300 ** 2) * S;
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow srp not-content" data-serpentine>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 300" role="img" aria-label="Дорога в гору идёт петлями — серпантином, по ней едет машина. Внизу обе дороги, напрямик и серпантином, развёрнуты в наклонные плоскости одинаковой высоты: прямая дорога короткая и крутая, серпантин в пять раз длиннее и пологий">
			<rect class="srp__sky" x="0" y="0" width="360" height="168"></rect>
			<path class="srp__mount" d="M10 166 L70 120 L120 84 L160 50 L190 28 L222 52 L262 86 L304 124 L350 166 Z"></path>
			<path class="srp__snow" d="M172 42 L190 28 L210 43 L201 40 L194 46 L186 40 Z"></path>
			<path class="srp__road" d={road} data-road></path>
			<path class="srp__roadmid" d={road}></path>
			<!-- the straight way up the slope -->
			<path class="srp__straight" d="M52 166 L168 46"></path>
			<text class="t-small t-halo" x="44" y="112" text-anchor="middle">напрямик</text>
			<text class="t-small t-halo" x="300" y="104">серпантин</text>
			<g data-car>
				<rect class="srp__car" x="-6" y="-7" width="12" height="5" rx="1.5"></rect>
				<rect class="srp__car" x="-3.5" y="-10" width="6" height="4" rx="1"></rect>
				<circle class="srp__wheel" cx="-3.5" cy="-1.5" r="1.6"></circle>
				<circle class="srp__wheel" cx="3.5" cy="-1.5" r="1.6"></circle>
			</g>
			<rect class="srp__ground" x="0" y="166" width="360" height="3"></rect>
			<!-- both roads unrolled, to one scale -->
			<text class="t-small" x="12" y="190">обе дороги, развёрнутые в одном масштабе:</text>
			<path class="srp__plane srp__plane--steep" d={`M14 236 H${f(14 + run1)} V${236 - H} Z`}></path>
			<text class="srp__t" x={f(24 + run1)} y="218">напрямик: <tspan class="t-i">l</tspan> = 600&nbsp;м</text>
			<text class="srp__t" x={f(24 + run1)} y="234"><tspan class="t-i">F</tspan> = <tspan class="t-i">P</tspan> : 2</text>
			<path class="srp__plane" d={`M14 290 H${f(14 + run2)} V${290 - H} Z`}></path>
			<text class="srp__t" x="16" y="252">серпантин: <tspan class="t-i">l</tspan> = 3&nbsp;км, <tspan class="t-i">F</tspan> = <tspan class="t-i">P</tspan> : 10</text>
			<path class="srp__dim" d={`M${f(20 + run2)} ${290 - H} V290 M${f(17 + run2)} ${290 - H} h6 M${f(17 + run2)} 290 h6`}></path>
			<text class="srp__t" x={f(12 + run2)} y={f(284 - H)} text-anchor="end"><tspan class="t-i">h</tspan> = 300&nbsp;м</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Подъём на 300&nbsp;м: напрямик дорога короче, но так крута, что машине нужна сила тяги в половину её веса. Серпантин впятеро длиннее, зато сила нужна вдесятеро меньше веса (трение не учтено).
	</figcaption>
</figure>

<style is:global>
	.srp__sky {
		fill: var(--g7-sky);
	}
	.srp__mount {
		fill: color-mix(in oklab, hsl(110, 30%, 40%) 55%, var(--g7-faint));
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.srp__snow {
		fill: hsl(210, 30%, 97%);
		stroke: hsl(210, 15%, 70%);
		stroke-width: 0.6;
		opacity: 0.85;
	}
	.srp__road {
		fill: none;
		stroke: color-mix(in oklab, var(--sl-color-gray-3) 70%, var(--g7-faint));
		stroke-width: 5;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.srp__roadmid {
		fill: none;
		stroke: hsl(0, 0%, 100%);
		stroke-width: 0.6;
		stroke-dasharray: 3 3;
		opacity: 0.7;
	}
	.srp__straight {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-dasharray: 5 4;
	}
	.srp__car {
		fill: var(--g7-gold);
		stroke: var(--g7-paper);
		stroke-width: 0.6;
	}
	.srp__wheel {
		fill: var(--g7-ink);
	}
	.srp__ground {
		fill: var(--g7-ground);
	}
	.srp__plane {
		fill: color-mix(in oklab, var(--sl-color-gray-3) 50%, var(--g7-faint));
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.srp__plane--steep {
		stroke: var(--g7-red);
	}
	.srp__dim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .srp__t {
		font-size: 12px;
		fill: var(--g7-ink);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const RUN = 10;
	const HOLD = 1.2;
	for (const root of document.querySelectorAll<HTMLElement>('[data-serpentine]')) {
		const road = root.querySelector<SVGPathElement>('[data-road]')!;
		const car = root.querySelector<SVGGElement>('[data-car]')!;
		const L = road.getTotalLength();
		let t = 0;
		const draw = () => {
			const s = Math.min(1, t / RUN) * L;
			const p = road.getPointAtLength(s);
			const q = road.getPointAtLength(Math.min(L, s + 1));
			const dir = q.x >= p.x ? 1 : -1;
			const ang = (Math.atan2(q.y - p.y, Math.abs(q.x - p.x) + 1e-6) * 180) / Math.PI;
			car.setAttribute('transform', `translate(${p.x.toFixed(1)} ${(p.y + 2).toFixed(1)}) scale(${dir} 1) rotate(${ang.toFixed(1)})`);
		};
		loop(root, (dt) => {
			t += dt;
			if (t > RUN + HOLD) t = 0;
			draw();
			return true;
		})();
		draw();
	}
</script>
