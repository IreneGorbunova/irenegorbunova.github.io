---
/**
 * Picture «Полезная и полная работа»: water is wound up a well 10 м deep with a windlass, as in the opening scene, and
 * the same numbers. Water 100 Н: 100 Н · 10 м = 1000 Дж (the useful work). Bucket 10 Н: 100 Дж. Chain 1 Н per metre,
 * 10 м: only what still hangs is lifted, on average 5 м, so 50 Дж. Friction in the axle: 5 Н at the chain over 10 м,
 * 50 Дж. All the work of the person: 1200 Дж. Left, a scheme of the windlass (not to scale) with the parts that are
 * lifted; below, a bar of the work, 0,2667 px per joule (1200 Дж = 320 px), split into the same parts.
 */
import G7Styles from '../g7/G7Styles.astro';

const S = 320 / 1200;
const X = 20;
const parts = [
	{ key: 'water', J: 1000 },
	{ key: 'bucket', J: 100 },
	{ key: 'chain', J: 50 },
	{ key: 'fric', J: 50 },
];
let x = X;
const seg = parts.map((p) => {
	const s = { ...p, x, w: p.J * S };
	x += p.J * S;
	return s;
});
const f = (v: number) => v.toFixed(1);
const BY = 206; // the bar
const BH = 22;
const labels = [
	{ key: 'fric', y: 40, text: 'трение в оси: 50 Дж', to: [82, 37] },
	{ key: 'chain', y: 76, text: 'цепь: 50 Дж', to: [58, 84] },
	{ key: 'water', y: 116, text: 'вода: 100 Н · 10 м = 1000 Дж', to: [62, 134] },
	{ key: 'bucket', y: 146, text: 'ведро: 10 Н · 10 м = 100 Дж', to: [67, 140] },
];
---

<G7Styles />
<figure class="g7 g7--pic g7--narrow ww not-content" data-wellwork>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 360 272" role="img" aria-label="Ворот над колодцем поднимает ведро с водой. Работа человека, 1200 джоулей, складывается из подъёма воды, 1000 джоулей, подъёма ведра, 100 джоулей, подъёма цепи, 50 джоулей, и трения в оси, 50 джоулей. Полезна только работа по подъёму воды">
			<!-- the scheme of the windlass -->
			<rect class="ww__post" x="69" y="20" width="6" height="150"></rect>
			<rect class="ww__ground" x="0" y="170" width="150" height="6"></rect>
			<rect class="ww__shaft" x="30" y="174" width="56" height="8"></rect>
			<circle class="ww__drum" cx="72" cy="44" r="14"></circle>
			<circle class="ww__wound" cx="72" cy="44" r="15.5"></circle>
			<path class="ww__crank" d="M72 44 L94 30"></path>
			<circle class="ww__handle" cx="94" cy="30" r="3.5"></circle>
			<path class="ww__fric" d="M66 38 l-4 -4 M78 38 l4 -4 M66 50 l-4 4 M78 50 l4 4"></path>
			<path class="ww__chain" d="M57 44 V110"></path>
			<path class="ww__bail" d="M45 122 Q46 110 57 110 Q68 110 69 122"></path>
			<path class="ww__bucket" d="M45 122 H69 L66 146 H48 Z"></path>
			<path class="ww__water" d="M46.3 126 H67.7 L65.6 143 H48.4 Z"></path>
			<!-- what each part costs -->
			{
				labels.map((l) => (
					<g>
						<path class="ww__lead" d={`M${f(l.to[0])} ${l.to[1]} L124 ${l.y - 4} H130`} />
						<rect class={`ww__key ww--${l.key}`} x="132" y={l.y - 10} width="9" height="9" rx="2" />
						<text class="ww__t" x="146" y={l.y}>{l.text}</text>
					</g>
				))
			}
			<!-- the bar of the work -->
			<path class="ww__brace" d={`M${X} ${BY - 4} V${BY - 10} H${X + 320} V${BY - 4}`}></path>
			<text class="ww__t ww__strong" x={X + 160} y={BY - 15} text-anchor="middle">работа человека (затраченная) — 1200&nbsp;Дж</text>
			{seg.map((s) => <rect class={`ww__seg ww--${s.key}`} x={f(s.x)} y={BY} width={f(s.w)} height={BH} />)}
			<path class="ww__brace" d={`M${X} ${BY + BH + 4} V${BY + BH + 10} H${f(X + 1000 * S)} V${BY + BH + 4}`}></path>
			<text class="ww__t ww__useful" x={f(X + 500 * S)} y={BY + BH + 26} text-anchor="middle">полезная работа — 1000&nbsp;Дж</text>
			<path class="ww__brace" d={`M${f(X + 1000 * S + 2)} ${BY + BH + 4} V${BY + BH + 10} H${X + 320} V${BY + BH + 4}`}></path>
			<text class="ww__t" x={X + 320} y={BY + BH + 26} text-anchor="end">200&nbsp;Дж</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Человек поднимает не только воду, но и ведро с цепью и преодолевает трение в оси ворота. Полезна только работа по подъёму воды — 1000&nbsp;Дж из 1200&nbsp;Дж.
	</figcaption>
</figure>

<style is:global>
	.ww__post {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.ww__ground {
		fill: var(--g7-ground);
	}
	.ww__shaft {
		fill: hsl(25, 20%, 22%);
	}
	.ww__drum {
		fill: var(--g7-wood);
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.ww__wound {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 2.4;
		stroke-dasharray: 2.5 1.2;
	}
	.ww__crank {
		stroke: var(--g7-ink);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.ww__handle {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.ww__fric {
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.ww__chain {
		stroke: color-mix(in oklab, var(--g7-red) 55%, var(--g7-line));
		stroke-width: 2.4;
		stroke-dasharray: 3.5 1.6;
	}
	.ww__bail {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.ww__bucket {
		fill: color-mix(in oklab, var(--g7-red) 35%, var(--g7-steel));
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.ww__water {
		fill: var(--g7-green);
		opacity: 0.85;
	}
	.ww__lead {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.ww__brace {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.ww--water {
		fill: var(--g7-green);
	}
	.ww--bucket {
		fill: var(--g7-red);
	}
	.ww--chain {
		fill: color-mix(in oklab, var(--g7-red) 65%, var(--g7-paper));
	}
	.ww--fric {
		fill: color-mix(in oklab, var(--g7-red) 40%, var(--g7-paper));
	}
	.ww__seg {
		stroke: var(--g7-paper);
		stroke-width: 1;
	}
	.g7__svg .ww__t {
		font-size: 11.5px;
		fill: var(--g7-ink);
	}
	.g7__svg .ww__strong {
		font-weight: 600;
	}
	.g7__svg .ww__useful {
		fill: var(--g7-green);
		font-weight: 600;
	}
</style>
