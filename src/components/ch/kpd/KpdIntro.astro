---
/**
 * Two short looping opening scenes of «Коэффициент полезного действия». No terms of the chapter in the pictures.
 *
 * Well (48 px per metre). A person standing behind the well winds a bucket of water up with a windlass: both hands grip
 *   the handle of the crank (radius 0,3 м) at the far end of the axle, the crank and the drum (radius 0,15 м, cut through so that its turning shows) turn together,
 *   the chain winds on the drum. The well is drawn in section with a break: only its upper part and its lowest 2 м are
 *   shown, the middle 6,3 м are left out (the zigzag band). The bucket is lifted by 10 м: its bottom goes from 9,45 м
 *   below the ground to the top of the frame of the well, 0,55 м above the ground. The axle is 1,1 м above the ground. The drum makes
 *   10 м / (2π·0,15 м) ≈ 10,6 turns; the scene runs 9 с, about twice as fast as in life.
 *   Weights: water 100 Н, bucket 10 Н, chain 1 Н per metre (10 Н for 10 м); friction in the axle needs 5 Н at the
 *   chain. The counters after a lift of x м: lifting the water 100·x Дж; the work of the person
 *   100x + 10x + (10x − x²/2) + 5x Дж (the hanging chain gets shorter: only the part still hanging is lifted). At
 *   x = 10 м: 1000 Дж and 1200 Дж.
 *
 * Ramp (36 px per metre). A barrel that weighs 1000 Н is rolled into a lorry along planks 4 м long up to the floor of
 *   its body, 1 м above the road. The person walks behind the barrel, bent forward, both hands on it, and pushes with
 *   300 Н, though 250 Н would be enough without friction. The arrows from the center of the barrel are to one scale,
 *   0,08 px per newton: its weight 1000 Н (80 px) and the push 300 Н (24 px). The barrel rolls without slipping (turn =
 *   path / radius 0,32 м). The counters: lifting the barrel straight up, 1000 Дж; rolling it along the planks, 300·s Дж
 *   up to 1200 Дж. The scene runs 8 с, about twice as fast as in life.
 *
 * The person is the one of «Давление в жидкости» (../davlenie-v-zhidkosti/personHome.ts), 175 см tall.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';

const uid = Math.random().toString(36).slice(2, 8);
const f = (v: number) => v.toFixed(1);

// ---------- the well ----------
const K1 = 48;
const G = 130; // the ground
const XS = 105; // the axis of the shaft, and the chain
const RD = 0.15 * K1; // the drum
const XD = XS + RD; // the axle
const YD = G - 1.1 * K1;
const IN = 0.45 * K1; // half the inner width of the shaft
const WALL = 0.15 * K1;
const TOP = G - 0.55 * K1; // the top of the frame of the well
const BR0 = 183; // the break: from …
const BR1 = 193; // … to
const yLow = (z: number) => BR1 + K1 * (-7.4 - z);
const WATER = yLow(-9.35);
// the zigzag edges of the break
const zig = (y: number) => {
	let d = `M0 ${y}`;
	for (let x = 0; x < 360; x += 12) d += ` L${x + 6} ${y - 3} L${x + 12} ${y}`;
	return d;
};
let back = '';
for (let x = 360; x > 0; x -= 12) back += ` L${x - 6} ${BR1 - 3} L${x - 12} ${BR1}`;
const breakBand = `${zig(BR0)} L360 ${BR1}${back} Z`;
// the logs of the frame, seen end-on in the section
const logs = [0, 1, 2, 3].map((i) => TOP + WALL / 2 + i * WALL);
const DIMX = 54; // the gauge of the lift: from the bottom of the bucket at the start to its bottom at the end

// ---------- the ramp ----------
const K2 = 36;
const RDY = 220; // the road
const PX0 = 50; // the foot of the planks
const BED = RDY - K2; // the floor of the body, 1 м
const PX1 = PX0 + Math.sqrt(15) * K2; // the top of the planks
const BEDX1 = PX1 + 2.4 * K2;
const CAB0 = BEDX1 + 4;
const RW = 0.45 * K2;
const WY = RDY - RW; // the wheels' axles
---

<IntroFrame data-kpdintro>
	<div class="intro__card" data-scene="well">
		<svg class="intro__svg" viewBox="0 0 360 300" role="img" aria-label="Человек крутит ручку ворота над колодцем, барабан ворота вращается, цепь наматывается на него, и из глубины поднимается ведро с водой. Колодец показан в разрезе, его середина пропущена. Счётчики показывают работу по подъёму воды и всю работу человека">
			<defs>
				<clipPath id={`kpu-${uid}`}><rect x="0" y="0" width="360" height={BR0}></rect></clipPath>
				<clipPath id={`kpl-${uid}`}><rect x="0" y={BR1} width="360" height={300 - BR1}></rect></clipPath>
			</defs>
			<rect class="kp-sky" x="0" y="0" width="360" height={G}></rect>
			<path class="kp-bush" d="M296 131 q-8 -20 8 -26 q4 -16 20 -10 q14 -8 20 10 q14 4 8 26 Z"></path>
			<!-- the earth in section and the shaft -->
			<rect class="kp-earth" x="0" y={G} width="360" height={300 - G}></rect>
			<path class="kp-grass" d={`M0 ${G} H360`}></path>
			<path class="kp-pebbles" d="M20 150 h3 M240 160 h4 M300 220 h3 M170 250 h4 M30 268 h3 M210 284 h4 M330 150 h3 M190 205 h3"></path>
			<rect class="kp-shaft" x={XS - IN} y={TOP} width={2 * IN} height={300 - TOP}></rect>
			<rect class="kp-wellwater" x={XS - IN} y={WATER} width={2 * IN} height={300 - WATER}></rect>
			<path class="kp-ring" d={`M${XS - IN - 2} ${G} V300 M${XS + IN + 2} ${G} V300`}></path>
			<!-- the far wall of the frame (its inner side), the post and the roof -->
			<rect class="kp-backwall" x={XS - IN} y={TOP} width={2 * IN} height={G - TOP}></rect>
			<path class="kp-backlog" d={logs.slice(1).map((y) => `M${XS - IN} ${y - WALL / 2} H${XS + IN}`).join(' ')}></path>
			<path class="kp-roof" d={`M${XD - 46} 32 L${XD} 9 L${XD + 46} 32 L${XD + 43} 35 L${XD} 14 L${XD - 43} 35 Z`}></path>
			<!-- the person stands behind the well, at the far end of the axle; drawn facing right and mirrored -->
			<g transform={`matrix(-1 0 0 1 ${2 * (XD + 0.6 * K1)} 0)`}><g data-man></g></g>
			<!-- the crank at the far end of the axle, in front of the person; the far post; the drum cut through -->
			<path class="kp-crank" data-crank></path>
			<circle class="kp-handle" data-handle r="2.6"></circle>
			<rect class="kp-post" x={XD - 2.2} y="24" width="4.4" height={TOP - 24}></rect>
			<!-- the drum, cut through: it turns with the crank; the chain is wound on it -->
			<g data-drum>
				<circle class="kp-drumcut" r={RD}></circle>
				<circle class="kp-drumring" r={RD * 0.55}></circle>
				<path class="kp-drumcross" d={`M${-RD} 0 H${RD} M0 ${-RD} V${RD}`}></path>
				<circle class="kp-chainwound" r={RD + 1.2}></circle>
			</g>
			<circle class="kp-axle" cx={XD} cy={YD} r="1.6"></circle>
			<!-- the chain and the bucket, drawn twice: above the break and below it -->
			<path class="kp-chain" data-chain-up></path>
			<path class="kp-chain" data-chain-low></path>
			{
				['up', 'low'].map((k) => (
					<g clip-path={`url(#kp${k === 'up' ? 'u' : 'l'}-${uid})`}>
						<g data-bucket={k}>
							<path class="kp-bail" d="M-7.2 -13.4 Q-7 -19.6 0 -19.6 Q7 -19.6 7.2 -13.4" />
							<path class="kp-bucket" d="M-7.2 -13.4 H7.2 L5.8 0 H-5.8 Z" />
							<path class="kp-bwater" d="M-6.9 -11.6 H6.9 L6.75 -10.2 H-6.75 Z" />
							<path class="kp-bhoop" d="M-6.8 -9.2 H6.8 M-6.2 -3.6 H6.2" />
						</g>
					</g>
				))
			}
			<!-- the frame of the well in section: the logs seen end-on -->
			{[XS - IN - WALL / 2, XS + IN + WALL / 2].map((x) => logs.map((y) => <circle class="kp-log" cx={x} cy={y} r={WALL / 2} />))}
			<!-- the break: the middle of the well is left out -->
			<path class="kp-break" d={breakBand}></path>
			<path class="kp-breakline" d={`${zig(BR0)} ${zig(BR1)}`}></path>
			<!-- the lift, 10 м -->
			<path class="kp-dim" d={`M${DIMX} ${yLow(-9.45)} V${TOP} M${DIMX - 4} ${yLow(-9.45)} H${XS - 8} M${DIMX - 4} ${TOP} H${XS - IN - WALL}`}></path>
			<path class="kp-dimhead" d={`M${DIMX} ${TOP} l-3 7 h6 Z M${DIMX} ${yLow(-9.45)} l-3 -7 h6 Z`}></path>
			<text class="kp-label kp-halo" x={DIMX - 6} y={BR0 - 12} text-anchor="end">10&nbsp;м</text>
			<!-- the person, drawn facing right and mirrored -->
						<rect class="kp-pill" x="206" y="12" width="144" height="92" rx="10"></rect>
			<text class="kp-small" x="218" y="32">подъём воды</text>
			<text class="kp-num" x="218" y="52" data-a1>0&nbsp;Дж</text>
			<text class="kp-small" x="218" y="74">работа человека</text>
			<text class="kp-num" x="218" y="94" data-a2>0&nbsp;Дж</text>
		</svg>
		<div class="intro__foot">
			<p>
				Из колодца поднимают воду. Нужна только она, но вместе с водой приходится поднимать ведро и цепь:{' '}
				<More term="часть работы тратится не на то, ради чего её совершают">
					Вода в ведре весит 100&nbsp;Н, и чтобы поднять её на 10&nbsp;м, хватило бы работы 1000&nbsp;Дж. А человек совершает 1200&nbsp;Дж: остальное уходит на подъём ведра и цепи и на трение в вороте. Какая доля работы идёт на пользу, показывает коэффициент полезного действия. Об этом — в разделе{' '}
					<a href="#полезная-и-полная-работа">«Полезная и полная работа»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="ramp">
		<svg class="intro__svg" viewBox="0 0 360 300" role="img" aria-label="Человек, наклонившись, вкатывает бочку весом 1000 ньютонов по доскам в кузов грузовика и толкает её с силой 300 ньютонов. Счётчики показывают работу при подъёме бочки прямо вверх и при вкатывании по доскам">
			<defs>
				<marker id={`kpw-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto"><path class="kp-headw" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`kpf-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto"><path class="kp-headf" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="kp-sky" x="0" y="0" width="360" height={RDY}></rect>
			<path class="kp-cloud" d="M246 46 q4 -12 16 -8 q6 -10 18 -4 q12 -2 12 10 q6 4 0 8 h-44 q-8 -2 -2 -6 Z"></path>
			<rect class="kp-road" x="0" y={RDY} width="360" height={300 - RDY}></rect>
			<path class="kp-roadline" d={`M0 ${RDY + 30} H360`}></path>
			<!-- the lorry: the body with its floor 1 м above the road, the cab in front -->
			<rect class="kp-chassis" x={PX1 - 2} y={BED + 4} width={CAB0 + 60 - PX1} height="8"></rect>
			<path class="kp-mud" d={`M${PX1 + 14} ${WY} a${RW + 3} ${RW + 3} 0 0 1 ${2 * RW + 6} 0 M${CAB0 + 12} ${WY} a${RW + 3} ${RW + 3} 0 0 1 ${2 * RW + 6} 0`}></path>
			<rect class="kp-bodyfloor" x={PX1} y={BED} width={BEDX1 - PX1} height="4.5"></rect>
			<rect class="kp-side" x={PX1 + 6} y={BED - 17} width={BEDX1 - PX1 - 6} height="17" rx="1"></rect>
			<path class="kp-sideline" d={`M${PX1 + 6} ${BED - 8.5} H${BEDX1} ${[1, 2, 3].map((i) => `M${f(PX1 + 6 + (i * (BEDX1 - PX1 - 6)) / 4)} ${BED - 17} V${BED}`).join(' ')}`}></path>
			<!-- the tailgate, let down -->
			<rect class="kp-side" x={PX1 - 1} y={BED + 4} width="5" height="17" rx="1"></rect>
			<!-- the cab -->
			<path class="kp-cab" d={`M${CAB0} ${BED + 12} V${RDY - 2.3 * K2} H${CAB0 + 40} L${CAB0 + 50} ${RDY - 1.6 * K2} L${CAB0 + 62} ${RDY - 1.5 * K2} Q${CAB0 + 66} ${RDY - 1.45 * K2} ${CAB0 + 66} ${RDY - 1.3 * K2} V${BED + 12} Z`}></path>
			<path class="kp-glass" d={`M${CAB0 + 22} ${RDY - 2.18 * K2} H${CAB0 + 38} L${CAB0 + 46} ${RDY - 1.66 * K2} H${CAB0 + 22} Z`}></path>
			<path class="kp-door" d={`M${CAB0 + 18} ${RDY - 2.24 * K2} V${BED + 10} M${CAB0 + 26} ${BED - 6} h6`}></path>
			<rect class="kp-light" x={CAB0 + 62} y={RDY - 1.28 * K2} width="4" height="4" rx="1"></rect>
			<rect class="kp-bumper" x={CAB0 + 58} y={BED + 10} width="10" height="5" rx="1.5"></rect>
			{
				[PX1 + 17 + RW, CAB0 + 15 + RW].map((x) => (
					<g>
						<circle class="kp-tyre" cx={x} cy={WY} r={RW} />
						<circle class="kp-rim" cx={x} cy={WY} r={RW * 0.5} />
						<circle class="kp-hub" cx={x} cy={WY} r="2" />
					</g>
				))
			}
			<!-- the planks from the road to the floor of the body, 4 м -->
			<path class="kp-planks" d={`M${PX0} ${RDY} L${f(PX1)} ${BED} L${f(PX1)} ${BED + 4} L${PX0 + 15} ${RDY} Z`}></path>
			<!-- the person, behind the barrel -->
			<g data-man></g>
			<g data-barrel>
				<circle class="kp-barrel" r="11.5"></circle>
				<circle class="kp-chime" r="9.6"></circle>
				<g data-spin>
					<path class="kp-boards" d="M-4 -8.7 V8.7 M4 -8.7 V8.7"></path>
					<circle class="kp-bung" cx="0" cy="-5.5" r="1.4"></circle>
				</g>
			</g>
			<line class="kp-fw" data-w marker-end={`url(#kpw-${uid})`}></line>
			<line class="kp-ff" data-f marker-end={`url(#kpf-${uid})`}></line>
			<text class="kp-label kp-w kp-halo" data-wt>1000&nbsp;Н</text>
			<text class="kp-label kp-f kp-halo" data-ft>300&nbsp;Н</text>
			<rect class="kp-pill" x="12" y="12" width="176" height="92" rx="10"></rect>
			<text class="kp-small" x="24" y="32">поднять бочку прямо вверх</text>
			<text class="kp-num" x="24" y="52">1000&nbsp;Дж</text>
			<text class="kp-small" x="24" y="74">вкатить её по доскам</text>
			<text class="kp-num" x="24" y="94" data-a>0&nbsp;Дж</text>
		</svg>
		<div class="intro__foot">
			<p>
				Бочку вкатывают в кузов по доскам: так нужна сила в три с лишним раза меньше её веса. Но{' '}
				<More term="работы приходится совершить больше">
					Бочка весит 1000&nbsp;Н, а кузов на высоте 1&nbsp;м: чтобы поднять её прямо вверх, нужна работа 1000&nbsp;Дж. По доскам длиной 4&nbsp;м бочку толкают с силой 300&nbsp;Н — и совершают работу 1200&nbsp;Дж. Лишние 200&nbsp;Дж уходят на трение. Об этом — в разделе{' '}
					<a href="#наклонная-плоскость">«Наклонная плоскость»</a>.
				</More>, чем при подъёме прямо вверх.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-kpdintro] {
		--kp-sky: color-mix(in oklab, var(--ig-vx) 16%, var(--sl-color-bg));
		--kp-wood: hsl(28, 42%, 40%);
		--kp-wood-dark: hsl(26, 45%, 22%);
		--kp-wood-light: hsl(30, 40%, 52%);
		--kp-iron: hsl(220, 8%, 62%);
		--kp-earth: color-mix(in oklab, hsl(28, 35%, 30%) 70%, var(--sl-color-bg));
		--kp-shaft: hsl(25, 30%, 9%);
		--kp-grass: hsl(110, 35%, 40%);
		--kp-water: color-mix(in srgb, var(--ig-vx) 62%, var(--sl-color-bg));
		--kp-steel: hsl(210, 10%, 66%);
		--kp-steel-dark: hsl(210, 10%, 44%);
		--kp-road: color-mix(in oklab, var(--sl-color-gray-5) 80%, var(--sl-color-bg));
		--kp-cab: hsl(205, 55%, 45%);
		--kp-body: hsl(140, 22%, 36%);
		--kp-tyre: hsl(222, 15%, 14%);
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
	}
	:root[data-theme='light'] [data-kpdintro] {
		--kp-wood: hsl(28, 48%, 46%);
		--kp-wood-light: hsl(30, 45%, 60%);
		--kp-iron: hsl(220, 8%, 34%);
		--kp-earth: hsl(30, 35%, 70%);
		--kp-shaft: hsl(25, 25%, 32%);
		--kp-grass: hsl(110, 40%, 42%);
		--kp-water: color-mix(in srgb, var(--ig-vx) 55%, white);
		--kp-steel: hsl(210, 12%, 78%);
		--kp-steel-dark: hsl(210, 10%, 50%);
		--kp-road: hsl(220, 8%, 78%);
		--kp-cab: hsl(205, 60%, 52%);
		--kp-body: hsl(140, 28%, 46%);
		--kp-tyre: hsl(222, 15%, 22%);
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
	}
	[data-kpdintro] .kp-sky {
		fill: var(--kp-sky);
	}
	[data-kpdintro] .kp-cloud {
		fill: color-mix(in oklab, var(--sl-color-white) 30%, var(--kp-sky));
	}
	[data-kpdintro] .kp-bush {
		fill: color-mix(in oklab, hsl(140, 40%, 36%) 80%, var(--sl-color-bg));
	}
	[data-kpdintro] .kp-earth {
		fill: var(--kp-earth);
	}
	[data-kpdintro] .kp-grass {
		stroke: var(--kp-grass);
		stroke-width: 3;
	}
	[data-kpdintro] .kp-pebbles {
		stroke: color-mix(in oklab, var(--kp-earth) 60%, var(--sl-color-gray-2));
		stroke-width: 2;
		stroke-linecap: round;
	}
	[data-kpdintro] .kp-shaft {
		fill: var(--kp-shaft);
	}
	[data-kpdintro] .kp-wellwater {
		fill: var(--kp-water);
	}
	[data-kpdintro] .kp-ring {
		stroke: var(--sl-color-gray-3);
		stroke-width: 4;
	}
	[data-kpdintro] .kp-backwall {
		fill: color-mix(in oklab, var(--kp-wood-dark) 80%, var(--kp-shaft));
	}
	[data-kpdintro] .kp-backlog {
		stroke: color-mix(in oklab, var(--kp-wood) 60%, var(--kp-shaft));
		stroke-width: 1;
	}
	[data-kpdintro] .kp-post,
	[data-kpdintro] .kp-roof {
		fill: var(--kp-wood);
		stroke: var(--kp-wood-dark);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	[data-kpdintro] .kp-log,
	[data-kpdintro] .kp-drumcut {
		fill: var(--kp-wood-light);
		stroke: var(--kp-wood-dark);
		stroke-width: 1;
	}
	[data-kpdintro] .kp-drumring {
		fill: none;
		stroke: var(--kp-wood-dark);
		stroke-width: 0.6;
	}
	[data-kpdintro] .kp-drumcross {
		stroke: var(--kp-wood-dark);
		stroke-width: 1.4;
	}
	[data-kpdintro] .kp-chainwound {
		fill: none;
		stroke: var(--kp-steel);
		stroke-width: 2;
		stroke-dasharray: 2.4 1.2;
	}
	[data-kpdintro] .kp-chain {
		fill: none;
		stroke: var(--kp-steel);
		stroke-width: 1.8;
		stroke-dasharray: 3 1.6;
	}
	[data-kpdintro] .kp-bucket {
		fill: var(--kp-steel);
		stroke: var(--ph-line);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	[data-kpdintro] .kp-bwater {
		fill: var(--kp-water);
	}
	[data-kpdintro] .kp-bhoop {
		stroke: var(--kp-steel-dark);
		stroke-width: 1;
	}
	[data-kpdintro] .kp-bail {
		fill: none;
		stroke: var(--kp-steel-dark);
		stroke-width: 1.2;
	}
	[data-kpdintro] .kp-break {
		fill: var(--sl-color-bg);
	}
	[data-kpdintro] .kp-breakline {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 1;
	}
	[data-kpdintro] .kp-dim {
		fill: none;
		stroke: var(--sl-color-gray-2);
		stroke-width: 1;
	}
	[data-kpdintro] .kp-dimhead {
		fill: var(--sl-color-gray-2);
	}
	[data-kpdintro] .kp-crank {
		fill: none;
		stroke: var(--kp-iron);
		stroke-width: 3;
