		fill: var(--ph-line);
	}
</style>

<script>
	import { scene } from '@components/intro/scene';
	import { person, ANKLE } from '../davlenie-v-zhidkosti/personHome';

	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	const f = (v: number) => v.toFixed(1);
	const ease = (u: number) => {
		const t = clamp(u);
		return t * t * (3 - 2 * t);
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-kpdintro]')) {
		// ---------- the well ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="well"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 48;
			const G = 130;
			const XS = 105;
			const RD = 0.15 * K;
			const XD = XS + RD;
			const YD = G - 1.1 * K;
			const RC = 0.3 * K; // the crank
			const BR0 = 183;
			const BR1 = 193;
			const yUp = (z: number) => G - K * z;
			const yLow = (z: number) => BR1 + K * (-7.4 - z);
			const HIP = XD + 0.6 * K; // the hip joint (world x) at rest
			const M = 2 * HIP; // the person's group is mirrored: x' = M − x
			const S = K / 100;
			const pose = person($<SVGGElement>('[data-man]'), { s: S, H: 175, girth: 1, shirt: 'kp-shirt1' });
			const drum = $<SVGGElement>('[data-drum]');
			const crank = $<SVGPathElement>('[data-crank]');
			const handle = $<SVGCircleElement>('[data-handle]');
			const bUp = $<SVGGElement>('[data-bucket="up"]');
			const bLow = $<SVGGElement>('[data-bucket="low"]');
			const chUp = $<SVGPathElement>('[data-chain-up]');
			const chLow = $<SVGPathElement>('[data-chain-low]');
			const a1 = $<SVGTextElement>('[data-a1]');
			const a2 = $<SVGTextElement>('[data-a2]');
			const BAIL = 19.6; // px from the bottom of the bucket to the top of its bail
			// the lift (м) at the share u of the run: steady winding with a short start and stop
			const liftAt = (u: number) => {
				const e = 0.05;
				const v = 1 / (1 - e); // the steady speed, in lengths per run
				if (u < e) return 10 * ((v * u * u) / (2 * e));
				if (u > 1 - e) return 10 * (1 - (v * (1 - u) * (1 - u)) / (2 * e));
				return 10 * (v * (u - e / 2));
			};
			scene(card, 9, (x) => {
				const lift = liftAt(x);
				const zb = -9.45 + lift; // the bottom of the bucket, м above the ground
				// the drum and the crank turn together: angle = chain wound / drum radius (clockwise on the screen)
				const ang = lift / 0.15 + 2.4;
				drum.setAttribute('transform', `translate(${f(XD)} ${f(YD)}) rotate(${f((ang * 180) / Math.PI)})`);
				const hx = XD + RC * Math.cos(ang);
				const hy = YD + RC * Math.sin(ang);
				crank.setAttribute('d', `M${f(XD)} ${f(YD)} L${f(hx)} ${f(hy)}`);
				handle.setAttribute('cx', f(hx));
				handle.setAttribute('cy', f(hy));
				// the bucket and the chain, above and below the break
				const yu = yUp(zb);
				const yl = yLow(zb);
				bUp.setAttribute('transform', `translate(${XS} ${f(yu)})`);
				bLow.setAttribute('transform', `translate(${XS} ${f(yl)})`);
				const shift = ((lift * K) % 4.6).toFixed(2);
				chUp.setAttribute('d', `M${XS} ${f(YD)} V${f(Math.min(BR0, yu - BAIL))}`);
				chUp.style.strokeDashoffset = shift;
				chLow.setAttribute('d', yl - BAIL > BR1 ? `M${XS} ${BR1} V${f(yl - BAIL)}` : '');
				chLow.style.strokeDashoffset = shift;
				// the person sways toward the handle when it is far from them
				const c = Math.cos(ang);
				pose({
					hip: { x: M - (HIP + 2.9 * c), y: G - 0.85 * K + Math.abs(Math.sin(ang)) * 0.6 },
					lean: 0.45 - 0.15 * c,
					ankles: [
						{ x: M - (HIP - 0.14 * K), y: G - ANKLE * S },
						{ x: M - (HIP + 0.2 * K), y: G - ANKLE * S },
					],
					feet: [0, 0],
					hands: [
						{ x: M - hx, y: hy },
						{ x: M - hx - 1, y: hy + 0.5 },
					],
					head: 0.25,
				});
				a1.textContent = `${Math.round(100 * lift)}\u00a0Дж`;
				a2.textContent = `${Math.round(125 * lift - (lift * lift) / 2)}\u00a0Дж`;
			});
		}
		// ---------- the ramp ----------
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ramp"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const K = 36;
			const RDY = 220;
			const PX0 = 50;
			const BED = RDY - K;
			const PX1 = PX0 + Math.sqrt(15) * K;
			const SIN = 0.25;
			const COS = Math.sqrt(15) / 4;
			const R = 0.32 * K; // the barrel
			const S = K / 100;
			const FS = 0.08; // px per newton for the arrows
			const ground = (x: number) => (x < PX0 ? RDY : x < PX1 ? RDY - (x - PX0) * (SIN / COS) : BED);
			const slope = (x: number) => (x >= PX0 && x < PX1 ? -Math.asin(SIN) : 0);
			const pose = person($<SVGGElement>('[data-man]'), { s: S, H: 175, girth: 1.05, shirt: 'kp-shirt2' });
			const barrel = $<SVGGElement>('[data-barrel]');
			const spin = $<SVGGElement>('[data-spin]');
			const w = $<SVGLineElement>('[data-w]');
			const fl = $<SVGLineElement>('[data-f]');
			const wt = $<SVGTextElement>('[data-wt]');
			const ft = $<SVGTextElement>('[data-ft]');
			const a = $<SVGTextElement>('[data-a]');
			const STRIDE = 1.1 * K; // two steps
			// a foot of the walking person: planted while the hips pass over it, then carried a stride forward
			const foot = (hx: number, i: number) => {
				const ph = hx / STRIDE + i / 2;
				const n = Math.floor(ph);
				const c = ph - n;
				const plant = (n - i / 2) * STRIDE + STRIDE / 4;
				if (c < 0.5) return { x: plant, lift: 0 };
				const q = (c - 0.5) / 0.5;
				return { x: plant + STRIDE * ease(q), lift: 0.09 * K * Math.sin(Math.PI * q) };
			};
			scene(card, 8, (x) => {
				const sPath = 4 * ease(clamp((x - 0.03) / 0.94)); // м along the planks
				// the contact point on the planks and the center of the barrel
				const cx0 = PX0 + sPath * COS * K;
				const cy0 = RDY - sPath * SIN * K;
				const C = { x: cx0 - SIN * R, y: cy0 - COS * R };
				barrel.setAttribute('transform', `translate(${f(C.x)} ${f(C.y)})`);
				spin.setAttribute('transform', `rotate(${f(((sPath * K) / R) * (180 / Math.PI))})`);
				// the arrows from the center: the weight straight down, the push along the planks
				w.setAttribute('x1', f(C.x));
				w.setAttribute('y1', f(C.y));
				w.setAttribute('x2', f(C.x));
				w.setAttribute('y2', f(C.y + 1000 * FS));
				fl.setAttribute('x1', f(C.x));
				fl.setAttribute('y1', f(C.y));
				fl.setAttribute('x2', f(C.x + 300 * FS * COS));
				fl.setAttribute('y2', f(C.y - 300 * FS * SIN));
				wt.setAttribute('x', f(C.x + 5));
				wt.setAttribute('y', f(C.y + 1000 * FS - 6));
				ft.setAttribute('x', f(C.x + 6));
				ft.setAttribute('y', f(C.y - 19));
				// the person: the hands on the back of the barrel, the hips about 1 м behind its center
				const hx = C.x - 0.98 * K;
				const f0 = foot(hx, 0);
				const f1 = foot(hx, 1);
				const ank = (p: { x: number; lift: number }) => ({ x: p.x, y: ground(p.x) - ANKLE * S - p.lift });
				const gh = (ground(hx - 0.1 * K) + ground(hx + 0.1 * K)) / 2;
				const hand = (deg: number) => ({ x: C.x + R * Math.cos((deg * Math.PI) / 180), y: C.y + R * Math.sin((deg * Math.PI) / 180) });
				pose({
					hip: { x: hx, y: gh - 0.8 * K + Math.abs(Math.sin((Math.PI * hx) / (STRIDE / 2))) * 0.8 },
					lean: 1.02,
					ankles: [ank(f0), ank(f1)],
					feet: [slope(f0.x) + (f0.lift > 0 ? -0.15 : 0), slope(f1.x) + (f1.lift > 0 ? -0.15 : 0)],
					hands: [hand(212), hand(204)],
					head: 0, // bent over the barrel, the head within 40° of the body
				});
				a.textContent = `${Math.round(300 * sPath)}\u00a0Дж`;
			});
		}
	}
</script>
