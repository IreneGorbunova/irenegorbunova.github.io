---
/**
 * Two short looping opening scenes of «Коэффициент полезного действия». No terms of the chapter in the pictures.
 * Well: a bucket of water is wound up from a well 10 м deep. The water weighs 100 Н, the bucket with the chain
 *   20 Н. Two counters grow together: the work of lifting the water (to 1000 Дж) and the work of lifting everything
 *   (to 1200 Дж). 16 px per metre.
 * Ramp: a barrel that weighs 1000 Н is rolled into a lorry 1 м high along planks 4 м long (40 px per metre). It
 *   is pushed with 300 Н, though 250 Н would be enough without friction. The counters: lifting the barrel straight
 *   up, 1000 Дж; rolling it along the planks, 1200 Дж.
 */
import IntroFrame from '@components/intro/IntroFrame.astro';
import More from '@components/More.astro';
---

<IntroFrame data-kpdintro>
	<div class="intro__card" data-scene="well">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Из колодца глубиной 10 метров поднимают ведро с водой. Счётчики показывают работу по подъёму воды и работу по подъёму воды вместе с ведром и цепью">
			<rect class="kp-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="kp-earth" x="0" y="64" width="360" height="176"></rect>
			<rect class="kp-shaft" x="70" y="64" width="50" height="170"></rect>
			<rect class="kp-wellwater" x="70" y="224" width="50" height="10"></rect>
			<path class="kp-frame" d="M60 64 V28 M130 64 V28 M52 28 H138"></path>
			<rect class="kp-drum" x="74" y="22" width="42" height="12" rx="6"></rect>
			<path class="kp-crank" d="M116 28 H144 V44"></path>
			<line class="kp-chain" data-chain x1="95" y1="34" x2="95" y2="210"></line>
			<g data-bucket>
				<path class="kp-bucket" d="M-10 0 h20 l-3 16 h-14 Z"></path>
				<path class="kp-bwater" d="M-9 3 h18 l-0.6 3 h-16.8 Z"></path>
			</g>
			<rect class="kp-pill" x="170" y="60" width="176" height="110" rx="10"></rect>
			<text class="kp-small" x="182" y="82">подъём воды</text>
			<text class="kp-num" x="182" y="102" data-a1>0 Дж</text>
			<text class="kp-small" x="182" y="130">подъём воды, ведра и цепи</text>
			<text class="kp-num" x="182" y="150" data-a2>0 Дж</text>
		</svg>
		<div class="intro__foot">
			<p>
				Из колодца поднимают воду. Нужна только она, но вместе с водой приходится поднимать ведро и цепь:{' '}
				<More term="часть работы тратится не на то, ради чего её совершают">
					Чтобы поднять 10&nbsp;литров воды из колодца глубиной 10&nbsp;м, нужна работа 1000&nbsp;Дж. А совершить приходится 1200&nbsp;Дж: остальное уходит на подъём ведра и цепи. Какая доля работы идёт на пользу, показывает коэффициент полезного действия. Об этом — в разделе{' '}
					<a href="#полезная-и-полная-работа">«Полезная и полная работа»</a>.
				</More>.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>

	<div class="intro__card" data-scene="ramp">
		<svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="Бочку вкатывают в кузов грузовика по наклонным доскам">
			<rect class="kp-sky" x="0" y="0" width="360" height="240"></rect>
			<rect class="kp-road" x="0" y="200" width="360" height="40"></rect>
			<!-- the lorry: its floor is 1 м above the road -->
			<rect class="kp-lorry" x="214" y="160" width="130" height="8"></rect>
			<rect class="kp-lorry" x="300" y="112" width="44" height="48" rx="4"></rect>
			<circle class="kp-wheel" cx="246" cy="186" r="14"></circle>
			<circle class="kp-wheel" cx="318" cy="186" r="14"></circle>
			<path class="kp-planks" d="M59 200 L214 160 L214 166 L84 200 Z"></path>
			<g data-barrel>
				<circle class="kp-barrel" cx="0" cy="-14" r="14"></circle>
				<path class="kp-hoop" data-spokes d="M-14 -14 H14 M0 -28 V0"></path>
			</g>
			<g data-man>
				<circle class="kp-head" cx="0" cy="-44" r="7"></circle>
				<path class="kp-body" d="M0 -37 V-16 M0 -16 L-7 0 M0 -16 L7 0 M0 -32 L14 -24"></path>
			</g>
			<rect class="kp-pill" x="12" y="12" width="176" height="92" rx="10"></rect>
			<text class="kp-small" x="24" y="32">поднять бочку прямо вверх</text>
			<text class="kp-num" x="24" y="50">1000 Дж</text>
			<text class="kp-small" x="24" y="74">вкатить её по доскам</text>
			<text class="kp-num" x="24" y="92" data-a>0 Дж</text>
		</svg>
		<div class="intro__foot">
			<p>
				Бочку вкатывают в кузов по доскам: так нужна сила в три с лишним раза меньше её веса. Но{' '}
				<More term="работы приходится совершить больше">
					Бочка весит 1000&nbsp;Н, а кузов на высоте 1&nbsp;м: чтобы поднять её прямо вверх, нужна работа 1000&nbsp;Дж. По доскам длиной 4&nbsp;м бочку толкают с силой 300&nbsp;Н — и совершают работу 1200&nbsp;Дж. Лишние 200&nbsp;Дж уходят на трение. Об этом — в разделе{' '}
					<a href="#наклонная-плоскость">«Наклонная плоскость»</a>.
				</More>, чем при подъёме прямо вверх.
			</p>
			<button type="button" class="intro__again" data-again>Повторить</button>
		</div>
	</div>
</IntroFrame>

<style is:global>
	[data-kpdintro] .kp-sky {
		fill: var(--sl-color-bg);
	}
	[data-kpdintro] .kp-earth {
		fill: color-mix(in oklab, var(--ig-v) 24%, var(--sl-color-gray-5));
	}
	[data-kpdintro] .kp-shaft {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-3);
		stroke-width: 1.5;
	}
	[data-kpdintro] .kp-wellwater,
	[data-kpdintro] .kp-bwater {
		fill: var(--ig-vx);
	}
	[data-kpdintro] .kp-frame,
	[data-kpdintro] .kp-crank {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-kpdintro] .kp-drum {
		fill: color-mix(in oklab, var(--ig-v) 55%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1;
	}
	[data-kpdintro] .kp-chain {
		stroke: var(--sl-color-gray-2);
		stroke-width: 1.5;
		stroke-dasharray: 3 2;
	}
	[data-kpdintro] .kp-bucket {
		fill: var(--sl-color-gray-3);
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-kpdintro] .kp-pill {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	[data-kpdintro] .kp-small {
		font-size: 10px;
		fill: var(--sl-color-gray-2);
	}
	[data-kpdintro] .kp-num {
		font-size: 15px;
		font-weight: 700;
		fill: var(--sl-color-white);
	}
	[data-kpdintro] .kp-road {
		fill: var(--sl-color-gray-5);
	}
	[data-kpdintro] .kp-lorry {
		fill: color-mix(in oklab, var(--ig-vx) 50%, var(--sl-color-gray-4));
		stroke: var(--sl-color-gray-1);
		stroke-width: 1.2;
	}
	[data-kpdintro] .kp-wheel {
		fill: var(--sl-color-gray-2);
		stroke: var(--sl-color-gray-1);
		stroke-width: 3;
	}
	[data-kpdintro] .kp-planks {
		fill: color-mix(in oklab, var(--ig-v) 60%, var(--sl-color-gray-4));
		stroke: hsl(28, 50%, 26%);
		stroke-width: 1;
	}
	[data-kpdintro] .kp-barrel {
		fill: color-mix(in oklab, var(--ig-v) 46%, var(--sl-color-gray-4));
		stroke: hsl(28, 50%, 22%);
		stroke-width: 1.5;
	}
	[data-kpdintro] .kp-hoop {
		fill: none;
		stroke: hsl(28, 50%, 22%);
		stroke-width: 1.2;
	}
	[data-kpdintro] .kp-head {
		fill: hsl(26, 55%, 72%);
		stroke: hsl(20, 40%, 40%);
		stroke-width: 0.8;
	}
	[data-kpdintro] .kp-body {
		fill: none;
		stroke: var(--sl-color-gray-1);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>

<script>
	import { scene } from '@components/intro/scene';

	const clamp = (u: number) => Math.min(1, Math.max(0, u));
	for (const root of document.querySelectorAll<HTMLElement>('[data-kpdintro]')) {
		{
			const card = root.querySelector<HTMLElement>('[data-scene="well"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const bucket = $<SVGGElement>('[data-bucket]');
			const chain = $<SVGLineElement>('[data-chain]');
			const a1 = $<SVGTextElement>('[data-a1]');
			const a2 = $<SVGTextElement>('[data-a2]');
			scene(card, 7, (x) => {
				const u = clamp((x - 0.08) / 0.8); // the share of the 10 м already covered
				const y = 210 - 160 * u; // the water starts 10 м below the edge of the well: 160 px
				bucket.setAttribute('transform', `translate(95 ${y.toFixed(1)})`);
				chain.setAttribute('y2', y.toFixed(1));
				a1.textContent = `${Math.round(1000 * u)} Дж`;
				a2.textContent = `${Math.round(1200 * u)} Дж`;
			});
		}
		{
			const card = root.querySelector<HTMLElement>('[data-scene="ramp"]')!;
			const $ = <T extends Element>(s: string) => card.querySelector<T>(s)!;
			const barrel = $<SVGGElement>('[data-barrel]');
			const man = $<SVGGElement>('[data-man]');
			const spokes = $<SVGPathElement>('[data-spokes]');
			const a = $<SVGTextElement>('[data-a]');
			scene(card, 7, (x) => {
				const u = clamp((x - 0.08) / 0.8);
				// along the planks: from (72, 200) to (214, 160), 4 м
				const bx = 72 + 142 * u;
				const by = 198 - 40 * u;
				barrel.setAttribute('transform', `translate(${bx.toFixed(1)} ${by.toFixed(1)})`);
				// the barrel rolls without slipping: its turn is the path divided by its radius
				spokes.setAttribute('transform', `rotate(${(((147.5 * u) / 14) * 57.3).toFixed(1)} 0 -14)`);
				man.setAttribute('transform', `translate(${(bx - 24).toFixed(1)} ${(by + 7).toFixed(1)})`);
				a.textContent = `${Math.round(1200 * u)} Дж`;
			});
		}
	}
</script>
