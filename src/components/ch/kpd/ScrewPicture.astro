---
/**
 * Picture «Винт — свёрнутая наклонная плоскость», two panels.
 * Left (animated): a right triangle of paper is wound on a pencil, seen from above. One leg (150 px) lies along the
 *   pencil, the other (201 px) goes across it and is wound round. The pencil is drawn with radius 16 px, so one turn
 *   takes 2π·16 ≈ 100,5 px of paper and the leg across makes 2 turns; the slanting edge (red) becomes a helix that
 *   rises 170 / 2 = 85 px along the pencil per turn. A dashed outline keeps the place of the flat paper. Every frame computes, for each strip of the paper, the angle at
 *   which it lies on the pencil: angle = (wound length − distance from the pencil) / radius; only the upper half of the
 *   pencil is seen from above (the hidden half of the helix is not drawn). The pencil and the paper are drawn larger
 *   than in life. Cycle: 0,6 с still, 4 с winding, 1,5 с held, 2 с unwinding.
 * Right (still): a screw seen from the side. Its thread is the same helix: the crests on the near side slant one way,
 *   and the step of the thread (24 px here) is the height of the inclined plane wound round it; the length of the plane
 *   for one turn is the circumference.
 */
import G7Styles from '../g7/G7Styles.astro';

// the screw
const YB = 120; // its axis
const R = 24; // the outer radius of the thread
const Rc = 18; // the core
const P = 24; // the step
const X0 = 92; // where the thread starts
const X1 = 260; // the end of the screw
const crests: number[] = [];
for (let x = X0; x + P / 2 <= X1 - 4; x += P) crests.push(x);
const f = (v: number) => v.toFixed(1);
---

<G7Styles />
<figure class="g7 g7--pic scr not-content" data-screwpic>
	<div class="g7__grid is-two">
		<svg class="g7__svg" viewBox="0 0 300 250" role="img" aria-label="Бумажный прямоугольный треугольник наматывают на карандаш; его наклонный край ложится на карандаш винтовой линией, как резьба винта" data-pencil>
			<text class="t-small t-red" x="290" y="14" text-anchor="end">наклонный край бумаги</text>
			<path class="scr__ghost" d="M60 40 H230 L60 241 Z"></path>
			<path class="scr__flat" data-flat></path>
			<path class="scr__edge" data-flatedge></path>
			<!-- the pencil, seen from above -->
			<rect class="scr__pencil" x="34" y="24" width="212" height="32"></rect>
			<rect class="scr__facet" x="34" y="34" width="212" height="12"></rect>
			<path class="scr__wood" d="M246 24 L272 38 V42 L246 56 Z"></path>
			<path class="scr__lead" d="M272 38 L281 40 L272 42 Z"></path>
			<rect class="scr__eraser" x="18" y="25" width="10" height="30" rx="2"></rect>
			<rect class="scr__ferrule" x="27" y="24" width="8" height="32"></rect>
			<!-- the paper on the pencil and its edges -->
			<path class="scr__wound" data-wound></path>
			<path class="scr__woundline" data-woundline></path>
			<path class="scr__helix" data-helix></path>
			<text class="t-small" x="40" y="246" data-note>бумажный треугольник</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 300 250" role="img" aria-label="Винт сбоку. Его резьба — та же винтовая линия; расстояние между соседними витками — шаг резьбы">
			<text class="t-title" x="150" y="22" text-anchor="middle">винт</text>
			<!-- the head -->
			<path class="scr__head" d={`M${X0 - 52} ${YB - 40} H${X0 - 18} V${YB + 40} H${X0 - 52} Z`}></path>
			<path class="scr__headline" d={`M${X0 - 52} ${YB - 14} H${X0 - 18} M${X0 - 52} ${YB + 14} H${X0 - 18}`}></path>
			<!-- the core and the thread: the crests on the far side (dashed), the core, the crests on the near side (red) -->
			<path class="scr__back" d={crests.map((x) => `M${f(x + P / 2)} ${YB + R} L${f(x + P)} ${YB - R}`).join(' ')}></path>
			<rect class="scr__core" x={X0 - 18} y={YB - Rc} width={X1 - X0 + 18} height={2 * Rc}></rect>
			<path class="scr__teeth" d={`M${X0} ${YB - Rc} ${crests.map((x) => `L${f(x)} ${YB - R} L${f(x + P / 2)} ${YB - Rc}`).join(' ')} M${X0} ${YB + Rc} ${crests.map((x) => `L${f(x + P / 2)} ${YB + R} L${f(x + P)} ${YB + Rc}`).join(' ')}`}></path>
			<path class="scr__helix" d={crests.map((x) => `M${f(x)} ${YB - R} L${f(x + P / 2)} ${YB + R}`).join(' ')}></path>
			<!-- the step -->
			<path class="scr__dim" d={`M${crests[2]} ${YB - R - 4} V${YB - R - 22} M${crests[3]} ${YB - R - 4} V${YB - R - 22} M${crests[2]} ${YB - R - 16} H${crests[3]}`}></path>
			<path class="scr__dimhead" d={`M${crests[2]} ${YB - R - 16} l6 -3 v6 Z M${crests[3]} ${YB - R - 16} l-6 -3 v6 Z`}></path>
			<text class="t-small" x={(crests[2] + crests[3]) / 2} y={YB - R - 28} text-anchor="middle">шаг резьбы</text>
			<!-- one turn unrolled: an inclined plane -->
			<path class="scr__plane" d={`M${f(150 - Math.PI * R)} 214 H${f(150 + Math.PI * R)} V${214 - P} Z`}></path>
			<text class="t-small" x="150" y="231" text-anchor="middle">один виток, развёрнутый:</text>
			<text class="t-small" x="150" y="245" text-anchor="middle">основание — длина окружности, высота — шаг</text>
		</svg>
	</div>
	<figcaption class="g7__caption">
		Бумажный треугольник — наклонная плоскость. Намотайте его на карандаш, и наклонный край ляжет винтовой линией, как резьба винта.
	</figcaption>
</figure>

<style is:global>
	.scr {
		--scr-paper: hsl(44, 75%, 91%);
	}
	.scr__flat,
	.scr__wound {
		fill: var(--scr-paper);
	}
	.scr__flat {
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-linejoin: round;
	}
	.scr__ghost {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 0.8;
		stroke-dasharray: 3 3;
	}
	.scr__woundline {
		fill: none;
		stroke: color-mix(in oklab, var(--g7-line) 70%, var(--scr-paper));
		stroke-width: 0.8;
	}
	.scr__edge,
	.scr__helix {
		fill: none;
		stroke: var(--g7-red);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.scr__pencil {
		fill: hsl(45, 85%, 50%);
		stroke: hsl(35, 60%, 30%);
		stroke-width: 0.8;
	}
	.scr__facet {
		fill: hsl(48, 95%, 62%);
	}
	.scr__wood {
		fill: hsl(32, 55%, 72%);
		stroke: hsl(35, 60%, 30%);
		stroke-width: 0.8;
	}
	.scr__lead {
		fill: hsl(220, 10%, 25%);
	}
	.scr__eraser {
		fill: hsl(350, 65%, 70%);
	}
	.scr__ferrule {
		fill: hsl(210, 8%, 65%);
	}
	.scr__head,
	.scr__core {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.scr__headline {
		stroke: var(--g7-ink);
		stroke-width: 0.6;
		opacity: 0.5;
	}
	.scr__teeth {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}
	.scr__back {
		fill: none;
		stroke: var(--g7-line);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.scr__dim {
		fill: none;
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.scr__dimhead {
		fill: var(--g7-ink);
	}
	.scr__plane {
		fill: var(--g7-wood);
		stroke: var(--g7-red);
		stroke-width: 1.6;
		stroke-linejoin: round;
	}
</style>

<script>
	import { loop, ease } from '../g7/kit';

	const YP = 40; // the axis of the pencil
	const r = 16; // its radius
	const XA = 60; // the right-angle corner of the paper
	const HT = 170; // the leg along the pencil
	const BT = 2 * 2 * Math.PI * r; // the leg across: 2 turns
	const xOf = (v: number) => XA + HT * (1 - v / BT); // the slanting edge at the distance v from the pencil
	const f = (v: number) => v.toFixed(1);
	const PRE = 0.6;
	const WIND = 4;
	const HOLD = 1.5;
	const BACK = 2;
	for (const root of document.querySelectorAll<HTMLElement>('[data-screwpic]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const flat = q<SVGPathElement>('[data-flat]');
		const flatEdge = q<SVGPathElement>('[data-flatedge]');
		const wound = q<SVGPathElement>('[data-wound]');
		const woundLine = q<SVGPathElement>('[data-woundline]');
		const helix = q<SVGPathElement>('[data-helix]');
		const note = q<SVGTextElement>('[data-note]');
		let t = 0;
		const draw = () => {
			const u = t < PRE ? 0 : t < PRE + WIND ? ease((t - PRE) / WIND) : t < PRE + WIND + HOLD ? 1 : 1 - ease((t - PRE - WIND - HOLD) / BACK);
			const w = u * BT; // the length of paper already wound
			// the flat part: what is not yet wound, pulled up to the pencil
			flat.setAttribute('d', w < BT - 0.5 ? `M${XA} ${YP} H${f(xOf(w))} L${XA} ${f(YP + BT - w)} Z` : '');
			flatEdge.setAttribute('d', w < BT - 0.5 ? `M${f(xOf(w))} ${YP} L${XA} ${f(YP + BT - w)}` : '');
			note.setAttribute('y', f(Math.max(YP + 30, YP + BT - w + 14)));
			note.style.opacity = u < 0.6 ? '1' : '0';
			// the wound part: for each strip across the pencil, the visible (upper) half of the paper on it
			let d = '';
			const dx = 1.5;
			for (let x = XA; x < XA + HT; x += dx) {
				const vmax = BT * (1 - (x + dx / 2 - XA) / HT);
				const ve = Math.min(w, vmax);
				if (ve <= 0) continue;
				const a1 = (w - ve) / r;
				const a2 = w / r;
				if (a2 - a1 >= 2 * Math.PI) {
					d += `M${f(x)} ${YP - r}h${dx + 0.3}V${YP + r}h${-dx - 0.3}Z`;
					continue;
				}
				for (let k = 0; k < 4; k++) {
					const lo = Math.max(a1, Math.PI / 2 + 2 * Math.PI * k);
					const hi = Math.min(a2, (3 * Math.PI) / 2 + 2 * Math.PI * k);
					if (hi <= lo) continue;
					const y1 = YP - r * Math.sin(lo);
					const y2 = YP - r * Math.sin(hi);
					d += `M${f(x)} ${f(y1)}h${dx + 0.3}V${f(y2)}h${-dx - 0.3}Z`;
				}
			}
			wound.setAttribute('d', d);
			// the edges on the pencil: the slanting edge (a helix) and the first edge, along the pencil
			let hd = '';
			let pen = false;
			for (let v = 0; v <= w; v += 0.6) {
				const ph = (w - v) / r;
				const vis = Math.cos(ph) < 0;
				const x = xOf(v);
				const y = YP - r * Math.sin(ph);
				if (vis) {
					hd += `${pen ? 'L' : 'M'}${f(x)} ${f(y)}`;
					pen = true;
				} else pen = false;
			}
			helix.setAttribute('d', hd);
			const a0 = w / r;
			let wl = w > 0.5 ? `M${XA} ${YP - r} V${YP + r}` : '';
			if (w > 0.5 && Math.cos(a0) < 0) wl += ` M${XA} ${f(YP - r * Math.sin(a0))} H${XA + HT}`;
			woundLine.setAttribute('d', wl);
		};
		loop(root, (dt) => {
			t += dt;
			if (t > PRE + WIND + HOLD + BACK) t = 0;
			draw();
			return true;
		})();
		draw();
	}
</script>
