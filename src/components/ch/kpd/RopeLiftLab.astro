---
/**
 * «КПД при подъёме груза»: a man lifts a box of 10 кг (weight P = 98 Н, g = 9,8 Н/кг) straight up by 2 м with a rope
 * thrown over a fixed horizontal rod; there is no pulley, so the rope slides over the rod. The box hangs straight
 * down; the man stands aside and pulls his end at 60° below the horizontal, so the rope wraps 150° = 5π/6 of the rod.
 * When it slides evenly the pull is F = P·e^(μ·5π/6) (the rope friction formula of Euler; the reader gets only the
 * readout): «Без трения» μ = 0 → F = 98 Н; «Гладкая труба» μ = 0,15 → F = 145 Н; «Бревно» μ = 0,35 (rope on wood) →
 * F = 245 Н (e^0,916 = 2,50). The rope's weight is neglected; the box goes up evenly, and the man pulls out as much
 * rope as the box rises, h. Useful work P·h; work spent F·h; the difference is the work against friction (it heats the
 * rod and the rope); efficiency P/F: 100 %, 68 %, 40 %. Readouts follow the height as the box rises; at h = 2 м:
 * 196 Дж useful; 290 or 490 Дж spent (losses 94 or 294 Дж).
 * Drawing: 60 px per metre for the man (1,7 м), the box (40 см), the heights; the rod is drawn thicker than a real
 * pipe or log (radii 6 and 9 px = 10 and 15 см). The arrows of P and F to one scale, 0,25 px per newton; F is drawn beside the rope, along it. The man pulls
 * hand over hand: each hand grips and goes 0,6 м along the rope towards him, then lets go and goes back; the pulled
 * rope falls to the ground behind his hands. The lift takes 4 с (real
 * speed). Below, the band of the work spent splits into the useful work and the losses (widths proportional).
 */
import G7Styles from '../g7/G7Styles.astro';

const uid = Math.random().toString(36).slice(2, 8);
const K = 60;
const G = 300;
const RX = 168;
const RY = G - 3.4 * K;
---

<G7Styles />
<figure class="g7 rl not-content" data-ropelift>
	<div class="g7__grid">
		<svg class="g7__svg" viewBox="0 0 300 404" role="img" aria-label="Человек тянет верёвку, перекинутую через неподвижную перекладину, и поднимает ящик на 2 метра; внизу показано, какая часть затраченной работы полезна, а какая уходит на трение" data-svg>
			<defs>
				<marker id={`rlf-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path class="head--red" d="M0,0 L10,5 L0,10 z"></path></marker>
				<marker id={`rlp-${uid}`} viewBox="0 0 10 10" refX="7" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path class="head--blue" d="M0,0 L10,5 L0,10 z"></path></marker>
			</defs>
			<rect class="rl__ground" x="0" y={G} width="300" height="10"></rect>
			<line class="rl__floor" x1="0" x2="300" y1={G} y2={G}></line>
			<!-- the wall and the bracket that holds the rod (the rod goes into the depth of the picture) -->
			<rect class="rl__wall" x="262" y="40" width="38" height={G - 40}></rect>
			{Array.from({ length: 13 }, (_, i) => <line class="rl__brick" x1="262" x2="300" y1={60 + i * 20} y2={60 + i * 20} />)}
			{Array.from({ length: 13 }, (_, i) => <line class="rl__brick" x1={i % 2 ? 281 : 271} x2={i % 2 ? 281 : 271} y1={40 + i * 20} y2={60 + i * 20} />)}
			<rect class="rl__bracket" x={RX} y={RY - 3} width={262 - RX} height="6"></rect>
			<line class="rl__strut" x1="262" y1={RY + 44} x2="218" y2={RY + 3}></line>
			<!-- the rod is fixed to the bracket: it does not turn (Irina asked for a lift without a pulley) -->
			<text class="t-small t-halo" x="216" y={RY - 17} text-anchor="middle">неподвижная</text>
			<text class="t-small t-halo" x="216" y={RY - 8} text-anchor="middle">перекладина</text>
						<path class="ln" data-hmark></path>
			<text class="t-i t-halo" data-ht>h</text>
			<g data-coil></g>
			<path class="rl__rope" data-rope></path>
			<circle class="rl__rod" cx={RX} cy={RY} r="6" data-rod></circle>
			<g data-rings></g>
			<g data-box>
				<rect class="rl__box" x="-12" y="-24" width="24" height="24" rx="1.5"></rect>
				<path class="rl__boxline" d="M-12 -12 H12 M-4 -24 V-18 M4 -24 V-18"></path>
				<text class="t-small rl__boxt" x="0" y="-3" text-anchor="middle">10&nbsp;кг</text>
			</g>
			<g data-man></g>
			<line class="arrow arrow--blue" data-parrow marker-end={`url(#rlp-${uid})`}></line>
			<text class="t-i t-blue t-halo" data-pt>P</text>
			<line class="arrow arrow--red" data-farrow marker-end={`url(#rlf-${uid})`}></line>
			<text class="t-i t-red t-halo" data-ft>F</text>
			<g data-flow></g>
		</svg>
		<div class="g7__side">
			<div class="g7__seg" role="group" aria-label="Через что перекинута верёвка" data-rodkind>
				<button type="button" class="g7__btn" aria-pressed="false" data-mu="0">Без трения</button>
				<button type="button" class="g7__btn" aria-pressed="true" data-mu="0.15">Гладкая труба</button>
				<button type="button" class="g7__btn" aria-pressed="false" data-mu="0.35">Бревно</button>
			</div>
			<button type="button" class="g7__btn g7__btn--go" data-go>Поднять ящик на 2&nbsp;м</button>
			<ul class="g7__read" aria-live="polite">
				<li><span>Вес ящика <i>P</i></span><b>98&nbsp;Н</b></li>
				<li><span>Человек тянет с силой <i>F</i></span><b data-f></b></li>
				<li><span>Высота подъёма <i>h</i></span><b data-h></b></li>
				<li><span>Полезная работа <i>Ph</i></span><b data-ap></b></li>
				<li><span>Затраченная работа <i>Fh</i></span><b data-az></b></li>
				<li><span>Ушло на трение</span><b data-al></b></li>
				<li class="is-key"><span>КПД</span><b data-eta></b></li>
			</ul>
		</div>
	</div>
	<figcaption class="g7__caption">
		Ящик массой 10&nbsp;кг поднимают на верёвке, перекинутой через неподвижную перекладину. Свой конец верёвки человек вытягивает на столько же, на сколько поднимается ящик, — поэтому затраченная работа равна <i>Fh</i>. Верёвка трётся о перекладину, и часть работы уходит на нагревание перекладины и верёвки. Перекладина нарисована толще настоящей.
	</figcaption>
</figure>

<style is:global>
	.rl__ground {
		fill: var(--g7-ground);
	}
	.rl__floor {
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.rl__wall {
		fill: color-mix(in oklab, hsl(10, 45%, 50%) 40%, var(--sl-color-gray-5));
	}
	.rl__brick {
		stroke: var(--g7-faint);
		stroke-width: 1;
	}
	.rl__bracket {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-line);
		stroke-width: 0.8;
	}
	.rl__strut {
		stroke: var(--g7-steel-dark);
		stroke-width: 4;
	}
	.rl__rod {
		stroke: var(--g7-ink);
		stroke-width: 1.2;
	}
	.rl__rod--pipe {
		fill: var(--g7-steel);
	}
	.rl__rod--log {
		fill: var(--g7-wood);
	}
	.rl__ring {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 0.8;
	}
	.rl__rope {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.rl__box {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.rl__boxline {
		fill: none;
		stroke: var(--g7-wood-dark);
		stroke-width: 1;
	}
	.g7__svg .rl__boxt {
		font-size: 8px;
		fill: var(--g7-ink);
	}
	[data-ropelift] {
		--ph-skin: hsl(26, 55%, 72%);
		--ph-line: hsl(222, 35%, 14%);
		--ph-pants: hsl(225, 25%, 40%);
		--ph-shoe: hsl(24, 38%, 30%);
		--ph-hair: hsl(25, 40%, 28%);
		--rl-shirt: hsl(150, 38%, 42%);
	}
	:root[data-theme='light'] [data-ropelift] {
		--ph-line: hsl(222, 30%, 22%);
		--ph-pants: hsl(225, 30%, 32%);
		--rl-shirt: hsl(150, 40%, 38%);
	}
	[data-ropelift] .ph-far {
		filter: brightness(0.8);
	}
	[data-ropelift] .ph-outline {
		fill: none;
		stroke: var(--ph-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-ropelift] .ph-pants,
	[data-ropelift] .ph-sleeve,
	[data-ropelift] .ph-skin-limb {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	[data-ropelift] .ph-pants {
		stroke: var(--ph-pants);
	}
	[data-ropelift] .ph-skin-limb {
		stroke: var(--ph-skin);
	}
	[data-ropelift] .ph-sleeve.rl-shirt {
		stroke: var(--rl-shirt);
	}
	[data-ropelift] .ph-shirt.rl-shirt {
		fill: var(--rl-shirt);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-ropelift] .ph-belt {
		fill: var(--ph-line);
	}
	[data-ropelift] .ph-collar {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-ropelift] .ph-skin {
		fill: var(--ph-skin);
		stroke: var(--ph-line);
		stroke-width: 0.4;
	}
	[data-ropelift] .ph-ear {
		stroke-width: 0.3;
	}
	[data-ropelift] .ph-cheek {
		fill: hsl(355, 70%, 66%);
		opacity: 0.45;
	}
	[data-ropelift] .ph-eye {
		fill: var(--ph-line);
	}
	[data-ropelift] .ph-brow,
	[data-ropelift] .ph-mouth {
		fill: none;
		stroke: var(--ph-line);
		stroke-width: 0.4;
		stroke-linecap: round;
	}
	[data-ropelift] .ph-hair {
		fill: var(--ph-hair);
	}
	[data-ropelift] .ph-shoe {
		fill: var(--ph-shoe);
		stroke: var(--ph-line);
		stroke-width: 0.5;
	}
	[data-ropelift] .ph-sole {
		fill: var(--ph-line);
	}
</style>

<script>
	import { el, ease, fmt, loop, segment } from '../g7/kit';
	import { drawFlow } from '../g7/flow';
	import { person } from '../davlenie-v-zhidkosti/personHome';

	const K = 60; // px per metre
	const G = 300;
	const RX = 168;
	const RY = G - 3.4 * K;
	const P = 98; // Н
	const H = 2; // м
	const FS = 0.25; // px per newton
	const T = 4; // с, the lift
	const STROKE = 0.6; // м, one pull of a hand
	const A = Math.PI / 3; // the man's end of the rope goes 60° below the horizontal
	const WRAP = Math.PI / 2 + A; // 150°, how far the rope goes round the rod
	const D0 = 1.95; // м along the rope from the rod to the upper hand at the start
	const f1 = (v: number) => v.toFixed(1);

	for (const root of document.querySelectorAll<HTMLElement>('[data-ropelift]')) {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const rod = q<SVGCircleElement>('[data-rod]');
		const rings = q<SVGGElement>('[data-rings]');
		const pose = person(q<SVGGElement>('[data-man]'), { s: K / 100, H: 170, girth: 1, shirt: 'rl-shirt' });
		let mu = 0.15;
		let t = 0; // с since the start of the lift
		let running = false;
		const draw = () => {
			const r = mu === 0.35 ? 9 : 6;
			rod.setAttribute('r', String(r));
			rod.setAttribute('class', `rl__rod ${mu === 0.35 ? 'rl__rod--log' : 'rl__rod--pipe'}`);
			rings.replaceChildren();
			if (mu === 0.35) for (const rr of [3, 6]) rings.append(el('circle', { class: 'rl__ring', cx: RX, cy: RY, r: rr }));
			const F = P * Math.exp(mu * WRAP);
			const h = (H * Math.min(t, T)) / T;
			const xr = RX + r + 1;
			const rr = r + 1;
			// the man's side of the rope: from the tangent point T down-left at 60°
			const dx = -Math.cos(A);
			const dy = Math.sin(A);
			const tx = RX - rr * Math.sin(A);
			const ty = RY - rr * Math.cos(A);
			const at = (d: number) => ({ x: tx + dx * d * K, y: ty + dy * d * K });
			const boxBottom = G - h * K;
			const boxTop = boxBottom - 24;
			q('[data-box]').setAttribute('transform', `translate(${xr} ${f1(boxBottom)})`);
			// the hands: hand over hand, each pulls 0,6 м along the rope, then goes back while the other pulls
			const pulled = h / STROKE; // strokes so far
			const hand = (k: number) => {
				const u = (pulled + k) % 2;
				return at(D0 + (u < 1 ? STROKE * u : STROKE - STROKE * ease(u - 1)));
			};
			const hs = [hand(0.5), hand(1.5)];
			const low = hs[0].y > hs[1].y ? hs[0] : hs[1];
			q('[data-rope]').setAttribute('d', `M${f1(xr)} ${f1(boxTop)} V${RY} A${rr} ${rr} 0 0 0 ${f1(tx)} ${f1(ty)} L${f1(low.x)} ${f1(low.y)} V${G - 2}`);
			// the pulled rope lies in loops on the ground
			const coil = q<SVGGElement>('[data-coil]');
			coil.replaceChildren();
			const loops = 1 + Math.floor(h / 0.4);
			for (let i = 0; i < loops; i++) coil.append(el('ellipse', { class: 'rl__rope', cx: f1(low.x - 4 + i * 1.5), cy: G - 2 - i * 1.2, rx: 12, ry: 2.4 }));
			// the man stands aside, leans back a little and looks up
			pose({
				hip: { x: 84, y: G - 52 },
				lean: -0.16 - 0.04 * Math.sin((pulled * Math.PI) % Math.PI),
				ankles: [
					{ x: 96, y: G - 4.5 },
					{ x: 70, y: G - 4.5 },
				],
				feet: [0, 0],
				hands: [hs[0], hs[1]],
				head: -0.4,
			});
			// forces: the pull F beside the rope, along it; the weight P from the middle of the box
			const ox = Math.sin(A) * 8;
			const oy = Math.cos(A) * 8;
			const f0 = at(0.4);
			const fa = q('[data-farrow]');
			fa.setAttribute('x1', f1(f0.x + ox));
			fa.setAttribute('y1', f1(f0.y + oy));
			fa.setAttribute('x2', f1(f0.x + ox + dx * F * FS));
			fa.setAttribute('y2', f1(f0.y + oy + dy * F * FS));
			q('[data-ft]').setAttribute('x', f1(f0.x + ox + dx * F * FS * 0.5 + 6));
			q('[data-ft]').setAttribute('y', f1(f0.y + oy + dy * F * FS * 0.5 + 8));
			const pa = q('[data-parrow]');
			pa.setAttribute('x1', f1(xr + 18));
			pa.setAttribute('x2', f1(xr + 18));
			pa.setAttribute('y1', f1(boxBottom - 12));
			pa.setAttribute('y2', f1(boxBottom - 12 + P * FS));
			q('[data-pt]').setAttribute('x', f1(xr + 22));
			q('[data-pt]').setAttribute('y', f1(boxBottom - 2));
			// the height h: from the floor to the bottom of the box
			const hx = xr + 36;
			q('[data-hmark]').setAttribute('d', h > 0.02 ? `M${hx} ${G} V${f1(boxBottom)} M${hx - 4} ${G} h8 M${hx - 4} ${f1(boxBottom)} h8` : '');
			const ht = q('[data-ht]');
			ht.setAttribute('x', String(hx + 5));
			ht.setAttribute('y', f1((G + boxBottom) / 2 + 4));
			ht.style.display = h > 0.25 ? '' : 'none';
			const Ap = P * h;
			const Az = F * h;
			q('[data-f]').textContent = `${Math.round(F)} Н`;
			q('[data-h]').textContent = `${fmt(h, 2)} м`;
			q('[data-ap]').textContent = `${Math.round(Ap)} Дж`;
			q('[data-az]').textContent = `${Math.round(Az)} Дж`;
			q('[data-al]').textContent = `${Math.round(Az) - Math.round(Ap)} Дж`;
			q('[data-eta]').textContent = `${Math.round((100 * P) / F)} %`;
			drawFlow(q<SVGGElement>('[data-flow]'), 20, 336, 260, 26, P / F, { spent: 'затрачено', useful: 'полезная работа', lost: 'на трение' });
		};
		const wake = loop(root, (dt) => {
			if (!running) return false;
			t = Math.min(T, t + dt);
			draw();
			if (t >= T) running = false;
			return running;
		});
		q('[data-go]').addEventListener('click', () => {
			t = 0;
			running = true;
			wake();
		});
		segment(q('[data-rodkind]'), (b) => {
			mu = Number(b.dataset.mu);
			running = false;
			t = 0;
			draw();
		});
		draw();
	}
</script>
