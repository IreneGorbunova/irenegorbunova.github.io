---
/**
 * Picture «Как повышают КПД», three panels.
 * Подшипник (animated): a ball bearing in section. The outer ring is fixed, the shaft turns with the inner ring
 *   (raceway radius 34 px) at 0,9 rad/s, the 8 balls (radius 14 px) roll between the rings (outer raceway 62 px)
 *   without slipping: their centers (radius 48 px) go round at 0,9·34/(34 + 62) ≈ 0,32 rad/s, and each ball spins the
 *   other way at 0,32·48/14 ≈ 1,1 rad/s (a dot on each ball shows it). Slowed down.
 * Смазка (animated): the contact of two surfaces under a strong magnifier (the bumps are exaggerated). Dry: the bumps
 *   of the upper body catch on those of the lower one, and it rides up and down over them. With oil: a layer of oil
 *   keeps the surfaces apart, and the upper body glides level.
 * Лёгкий блок (still): two movable pulleys lift the same load of 10 кг without friction, as in the model «КПД блока»:
 *   F = 9,8·(m + m_б)/2, η = m/(m + m_б). Cast iron 2 кг: F = 58,8 Н, η = 83 %; light 0,5 кг: F = 51,5 Н, η = 95 %.
 */
import G7Styles from '../g7/G7Styles.astro';

const CX = 120;
const CY = 112;
const f = (v: number) => v.toFixed(1);
// the rough profiles of the magnified surfaces: a tooth every 20 px
const teeth = (y0: number, dir: number, x0: number, n: number) => {
	let d = `M${x0} ${y0}`;
	for (let i = 0; i < n; i++) d += ` l7 ${-dir * 7} l6 0 l7 ${dir * 7}`;
	return d;
};
const pulleys = [
	{ x: 64, r: 22, cls: 'kw__heavy', mass: '2 кг', F: '58,8', eta: '83' },
	{ x: 176, r: 12, cls: 'kw__light', mass: '0,5 кг', F: '51,5', eta: '95' },
];
---

<G7Styles />
<figure class="g7 g7--pic kw not-content" data-kpdways>
	<div class="g7__grid is-three">
		<svg class="g7__svg" viewBox="0 0 240 240" role="img" aria-label="Шарикоподшипник в разрезе: вал вращается, а шарики между кольцами катятся">
			<text class="t-title" x="120" y="20" text-anchor="middle">подшипник</text>
			<circle class="kw__housing" cx={CX} cy={CY} r="80"></circle>
			<circle class="kw__ring" cx={CX} cy={CY} r="70"></circle>
			<circle class="kw__race" cx={CX} cy={CY} r="62"></circle>
			<g data-cage>
				{Array.from({ length: 8 }, (_, i) => (
					<g transform={`rotate(${i * 45} ${CX} ${CY})`}>
						<g data-ball transform={`translate(${CX + 48} ${CY})`}>
							<circle class="kw__ball" r="13.6" />
							<circle class="kw__shine" cx="-4" cy="-4" r="3.5" />
							<circle class="kw__dot" cx="0" cy="8.5" r="2.2" />
						</g>
					</g>
				))}
			</g>
			<g data-shaft>
				<circle class="kw__ring" cx={CX} cy={CY} r="34"></circle>
				<circle class="kw__shaft" cx={CX} cy={CY} r="24"></circle>
				<path class="kw__key" d={`M${CX} ${CY} L${CX} ${CY - 22}`}></path>
			</g>
			<text class="t-small kw__shafttext" x={CX} y={CY + 14} text-anchor="middle">вал</text>
			<text class="t-small" x="120" y="222" text-anchor="middle">шарики катятся, а не скользят</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 240 240" role="img" aria-label="Под сильным увеличением: без смазки выступы трущихся поверхностей цепляются друг за друга, со смазкой их разделяет слой масла">
			<text class="t-title" x="120" y="20" text-anchor="middle">смазка</text>
			<text class="t-small" x="12" y="44">без смазки</text>
			<rect class="kw__lower" x="0" y="96" width="240" height="20"></rect>
			<path class="kw__lowerline" d={`${teeth(96, 1, 0, 12)} V116 H0 Z`}></path>
			<g data-dry>
				<path class="kw__upper" d={`M-40 58 H280 V${96 - 7} ${Array.from({ length: 16 }, () => 'l-7 7 l-6 0 l-7 -7').join(' ')} Z`}></path>
			</g>
			<text class="t-small" x="120" y="132" text-anchor="middle">выступы цепляются</text>
			<text class="t-small" x="12" y="156">со смазкой</text>
			<rect class="kw__lower" x="0" y="206" width="240" height="20"></rect>
			<rect class="kw__oil" x="0" y="190" width="240" height="18"></rect>
			<path class="kw__lowerline" d={`${teeth(206, 1, 0, 12)} V226 H0 Z`}></path>
			<g data-wet>
				<path class="kw__upper" d={`M-40 168 H280 V${196 - 7} ${Array.from({ length: 16 }, () => 'l-7 7 l-6 0 l-7 -7').join(' ')} Z`}></path>
			</g>
			<text class="t-small kw__oiltext" x="120" y="238" text-anchor="middle">слой масла разделяет выступы</text>
		</svg>
		<svg class="g7__svg" viewBox="0 0 240 240" role="img" aria-label="Два подвижных блока поднимают одинаковые грузы по 10 килограммов: с тяжёлым чугунным блоком массой 2 килограмма КПД 83 процента, с лёгким блоком массой 0,5 килограмма — 95 процентов">
			<text class="t-title" x="120" y="20" text-anchor="middle">лёгкий блок</text>
			<rect class="kw__ceil" x="10" y="30" width="220" height="6"></rect>
			{pulleys.map((p) => (
				<g>
					<path class="kw__rope" d={`M${p.x - p.r} 36 V100 A${p.r} ${p.r} 0 0 0 ${p.x + p.r} 100 V52`} />
					<circle class={p.cls} cx={p.x} cy="100" r={p.r} />
					<circle class="kw__axle" cx={p.x} cy="100" r="2.4" />
					<path class="kw__hook" d={`M${p.x} 100 V${100 + p.r + 8}`} />
					<rect class="kw__load" x={p.x - 16} y={100 + p.r + 8} width="32" height="26" rx="2" />
					<text class="t-small kw__loadtext" x={p.x} y={100 + p.r + 25} text-anchor="middle">10 кг</text>
					<text class="t-small" x={p.x} y="198" text-anchor="middle">блок {p.mass}</text>
					<text class="kw__t" x={p.x} y="214" text-anchor="middle"><tspan class="t-i">F</tspan> = {p.F}&nbsp;Н</text>
					<text class="kw__t kw__eta" x={p.x} y="231" text-anchor="middle">КПД {p.eta}&nbsp;%</text>
				</g>
			))}
		</svg>
	</div>
	<figcaption class="g7__caption">
		Подшипник заменяет скольжение качением, смазка разделяет трущиеся поверхности, лёгкий блок не приходится поднимать вместе с грузом. Выступы поверхностей сильно увеличены, вращение подшипника замедлено.
	</figcaption>
</figure>

<style is:global>
	.kw__housing {
		fill: var(--g7-faint);
		stroke: var(--g7-line);
		stroke-width: 1;
	}
	.kw__ring {
		fill: var(--g7-steel-dark);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.kw__race {
		fill: var(--g7-paper);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.kw__ball {
		fill: var(--g7-steel);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.kw__shine {
		fill: hsl(0, 0%, 100%);
		opacity: 0.5;
	}
	.kw__dot {
		fill: var(--g7-red);
	}
	.kw__shaft {
		fill: color-mix(in oklab, var(--g7-gold) 35%, var(--g7-steel));
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.kw__key {
		stroke: var(--g7-ink);
		stroke-width: 2.4;
		stroke-linecap: round;
	}
	.g7__svg .kw__shafttext {
		fill: var(--g7-ink);
		font-weight: 600;
	}
	.kw__lower,
	.kw__lowerline {
		fill: var(--g7-steel-dark);
	}
	.kw__lowerline {
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.kw__lower {
		stroke: none;
	}
	.kw__upper {
		fill: var(--g7-wood);
		stroke: var(--g7-ink);
		stroke-width: 1;
		stroke-linejoin: round;
	}
	.kw__oil {
		fill: color-mix(in oklab, var(--g7-gold) 60%, transparent);
	}
	.g7__svg .kw__oiltext {
		fill: var(--g7-gold);
	}
	.kw__ceil {
		fill: var(--g7-line);
	}
	.kw__rope {
		fill: none;
		stroke: var(--g7-gold);
		stroke-width: 2;
	}
	.kw__heavy {
		fill: hsl(220, 8%, 26%);
		stroke: var(--g7-ink);
		stroke-width: 1.5;
	}
	.kw__light {
		fill: hsl(210, 15%, 86%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.kw__axle {
		fill: var(--g7-ink);
	}
	.kw__hook {
		stroke: var(--g7-ink);
		stroke-width: 2;
	}
	.kw__load {
		fill: hsl(215, 12%, 42%);
		stroke: var(--g7-ink);
		stroke-width: 1;
	}
	.g7__svg .kw__loadtext {
		fill: hsl(0, 0%, 100%);
		font-weight: 600;
	}
	.g7__svg .kw__t {
		font-size: 12.5px;
		fill: var(--g7-ink);
	}
	.g7__svg .kw__eta {
		font-weight: 700;
		fill: var(--g7-green);
	}
</style>

<script>
	import { loop } from '../g7/kit';

	const CX = 120;
	const CY = 112;
	const W = 0.9; // rad/s, the shaft
	const WC = (W * 34) / (34 + 62); // the cage: the balls' centers
	const WB = -(WC * 48) / 14; // each ball about its own center
	const V = 14; // px/s, the sliding in the magnifier
	for (const root of document.querySelectorAll<HTMLElement>('[data-kpdways]')) {
		const shaft = root.querySelector<SVGGElement>('[data-shaft]')!;
		const cage = root.querySelector<SVGGElement>('[data-cage]')!;
		const balls = [...root.querySelectorAll<SVGGElement>('[data-ball]')];
		const dry = root.querySelector<SVGGElement>('[data-dry]')!;
		const wet = root.querySelector<SVGGElement>('[data-wet]')!;
		let t = 0;
		const draw = () => {
			const deg = (a: number) => ((a * 180) / Math.PI) % 360;
			shaft.setAttribute('transform', `rotate(${deg(W * t).toFixed(2)} ${CX} ${CY})`);
			cage.setAttribute('transform', `rotate(${deg(WC * t).toFixed(2)} ${CX} ${CY})`);
			// the ball's own turn: relative to the cage it turns at WB − WC
			for (const b of balls) b.setAttribute('transform', `translate(${CX + 48} ${CY}) rotate(${deg((WB - WC) * t).toFixed(2)})`);
			// the magnifier: the teeth repeat every 20 px
			const s = (V * t) % 20;
			const k = s / 20; // 0…1 over one tooth
			// dry: the upper body rides over the bumps: up while the tips climb the slopes, down again past them
			const lift = 7 * (k < 0.35 ? k / 0.35 : k < 0.65 ? 1 : (1 - k) / 0.35);
			dry.setAttribute('transform', `translate(${(s - 10).toFixed(2)} ${(-lift).toFixed(2)})`);
			wet.setAttribute('transform', `translate(${(s - 10).toFixed(2)} 0)`);
		};
		loop(root, (dt) => {
			t += dt;
			draw();
			return true;
		})();
		draw();
	}
</script>
