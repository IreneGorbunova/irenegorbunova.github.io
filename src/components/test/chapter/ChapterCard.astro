---
/**
 * The chapter's title card (test mode), under the title of every chapter instead of the bare constellation:
 *  - where the chapter stands: grade, section, «глава 4 из 6», the time it takes to read;
 *  - the section's constellation as an emblem (the live one of ChapterSky.astro is moved here by chapter.ts);
 *  - what lights the chapter's stars, as a list that ticks itself;
 *  - the four marks used in the text: «выучить», «сделать», «решить», «интересно» (chapter.ts and chapter.css);
 *  - «Полностью / Коротко»: the short view keeps the text, the definitions and the formulas and folds the models,
 *    the experiments, the derivations and the history, each to one row that opens by itself;
 *  - «Конспект главы»: the chapter's cards on one sheet, to print or to save as a picture (public/konspekt/, made
 *    by scripts/make-share.mjs).
 * Everything is hidden without test mode; the approved markup under the title stays as it is.
 */
import { CONSTELLATIONS } from '../../sky/constellations';
import type { SkySection } from '../../sky/sections';
import type { Step } from '../../sky/progress';
import { inline, tex, symbolsHtml } from '../../formulas/render';
import { plural } from '../map/words';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
	sec: SkySection;
}
const { sec } = Astro.props;
const { entry } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const slug = entry.id.split('/').pop()!;
const n = sec.chapters.findIndex((c) => c.id === entry.id) + 1;
const need = (sec.chapters[n - 1]?.need ?? 'm').split('') as Step[];
const sky = CONSTELLATIONS[sec.key];
const cards = entry.data.formulas ?? [];

// the time to read: the words of the chapter's own text at a pupil's pace, to the nearest five minutes
const PAGES = import.meta.glob('/src/content/docs/uchebnik/**/*.mdx', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const raw = PAGES[`/src/content/docs/${entry.id}.mdx`] ?? '';
const text = raw
	.replace(/^---[\s\S]*?---/, '')
	.replace(/^import .*$/gm, '')
	.replace(/\$\$[\s\S]*?\$\$/g, ' ')
	.replace(/\$[^$\n]*\$/g, ' ')
	.replace(/<[^>]*>/g, ' ')
	.replace(/\{[^}]*\}/g, ' ');
const minutes = Math.max(5, Math.round((text.match(/[\p{L}\p{N}]+/gu) ?? []).length / 110 / 5) * 5);

const GOAL: Record<Step, string> = {
	m: 'поработайте с моделью',
	d: 'пройдите вывод до конца',
	q: 'ответьте на вопрос',
	t: 'решите три задачи',
};
const MARKS = [
	['learn', 'выучить'],
	['do', 'сделать'],
	['solve', 'решить'],
	['more', 'интересно'],
] as const;
const url = `irenegorbunova.github.io/${entry.id}/`;
// the sheet as a picture, where scripts/make-share.mjs has made one
const picture = existsSync(join(process.cwd(), 'public/konspekt', `${slug}.png`)) ? `${base}konspekt/${slug}.png` : '';
---

<div class="ccard not-content" data-ccard={entry.id} data-ig-test data-pagefind-ignore>
	<div class="ccard__emblem">
		<div class="ccard__sky" data-ccard-emblem></div>
		<p class="ccard__skyname">{`созвездие ${sky.name}`}</p>
	</div>
	<div class="ccard__body">
		<p class="ccard__kicker">{`${sec.grade} · ${sec.section}`}</p>
		<p class="ccard__meta">
			{`Глава ${n} из ${sec.chapters.length}`}
			<span aria-hidden="true"> · </span>
			{`≈ ${minutes} мин чтения`}
		</p>
		<p class="ccard__h">Чтобы зажечь звёзды главы:</p>
		<ul class="ccard__goals">
			{
				need.map((r) => (
					<li class="ccard__goal" data-goal={r}>
						<span class="ccard__tick" aria-hidden="true" />
						{GOAL[r]}
						<span class="sr-only" data-sr>
							{' '}
							— ещё нет
						</span>
					</li>
				))
			}
		</ul>
		<p class="ccard__legend">
			<span class="ccard__legend-h">Метки в тексте:</span>
			{MARKS.map(([k, label]) => <span class="igm" data-igm={k}>{label}</span>)}
		</p>
	</div>
	<div class="ccard__foot">
		<div class="ccard__seg" role="group" aria-label="Вид главы">
			<button type="button" class="ccard__segbtn" data-view="full" aria-pressed="true">Полностью</button>
			<button type="button" class="ccard__segbtn" data-view="short" aria-pressed="false">Коротко</button>
		</div>
		{
			cards.length > 0 && (
				<button type="button" class="ccard__btn" data-konspekt-open>
					Конспект главы
				</button>
			)
		}
		<a class="ccard__link" href={`${base}uchebnik/nebo/`}>Моё небо</a>
		<p class="ccard__short" data-short-note hidden>
			Коротко: остались текст, определения и формулы. Модели, опыты, выводы формул и история свёрнуты — любой блок можно развернуть.
		</p>
	</div>

	{
		cards.length > 0 && (
			<dialog class="konspekt" data-konspekt aria-label="Конспект главы">
				<div class="konspekt__bar">
					<button type="button" class="ccard__btn ccard__btn--primary" data-konspekt-print>
						Распечатать
					</button>
					{picture && (
						<a class="ccard__btn" href={picture} download={`konspekt-${slug}.png`}>
							Сохранить картинкой
						</a>
					)}
					<button type="button" class="ccard__btn" data-konspekt-close>
						Закрыть
					</button>
				</div>
				<div class="konspekt__scroll">
					<article class="konspekt__sheet" data-konspekt-sheet>
						<header class="konspekt__head">
							<p class="konspekt__kicker">{`Конспект · ${sec.grade} · ${sec.section}`}</p>
							<h2 class="konspekt__title">{entry.data.title}</h2>
						</header>
						<ol class="konspekt__list">
							{cards.map((f) => (
								<li class="konspekt__item">
									<p class="konspekt__name" set:html={inline(f.name)} />
									{f.tex && <div class="konspekt__tex" set:html={tex(f.tex, true)} />}
									{f.def && <p class="konspekt__def" set:html={inline(f.def)} />}
									<Fragment set:html={symbolsHtml(f)} />
									{f.note && <p class="konspekt__note" set:html={inline(f.note)} />}
								</li>
							))}
						</ol>
						<footer class="konspekt__foot">
							<span>{plural(cards.length, 'карточка', 'карточки', 'карточек')} главы</span>
							<span>{url}</span>
						</footer>
					</article>
				</div>
			</dialog>
		)
	}
</div>

<script>
	if (document.documentElement.dataset.igTestmode === '1') import('./chapter').then((m) => m.start());
</script>

<style is:global>
	/* ---------- the four marks of the text ---------- */
	:root {
		--igm-learn: var(--ig-v);
		--igm-do: var(--ig-vx);
		--igm-solve: var(--ig-vy);
		--igm-more: hsl(265, 80%, 78%);
	}
	:root[data-theme='light'] {
		--igm-more: hsl(265, 45%, 45%);
	}
	[data-igm='learn'] {
		--igm-c: var(--igm-learn);
		--igm-shape: '■';
	}
	[data-igm='do'] {
		--igm-c: var(--igm-do);
		--igm-shape: '●';
	}
	[data-igm='solve'] {
		--igm-c: var(--igm-solve);
		--igm-shape: '▲';
	}
	[data-igm='more'] {
		--igm-c: var(--igm-more);
		--igm-shape: '★';
	}
	.igm,
	html[data-ig-testmode] .sl-heading-wrapper[data-igm]::before,
	html[data-ig-testmode] .sl-markdown-content :is(.ig-formula, .kf)::after {
		font-family: var(--sl-font);
		font-size: 0.7rem;
		font-weight: 700;
		font-style: normal;
		line-height: 1.4;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--igm-c);
	}
	.igm {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		white-space: nowrap;
	}
	.igm::before {
		content: var(--igm-shape);
		font-size: 0.85em;
		letter-spacing: 0;
	}
	/* a section of tasks or of history: the mark stands above its heading */
	html[data-ig-testmode] .sl-heading-wrapper[data-igm]::before {
		content: var(--igm-shape) '\00a0\00a0' attr(data-igm-label);
		display: block;
		margin-bottom: 0.15rem;
	}
	/* a formula with notes and the chapter's cards: something to learn */
	html[data-ig-testmode] .sl-markdown-content :is(.ig-formula, .kf) {
		position: relative;
		--igm-c: var(--igm-learn);
	}
	html[data-ig-testmode] .sl-markdown-content :is(.ig-formula, .kf)::after {
		content: '■\00a0\00a0выучить';
		position: absolute;
		top: -0.62rem;
		left: 0.9rem;
		padding: 0 0.45rem;
		background: var(--sl-color-bg);
		border-radius: 0.4rem;
	}

	/* ---------- the title card ---------- */
	html[data-ig-testmode] .csky {
		display: none;
	}
	.ccard {
		display: grid;
		grid-template-columns: minmax(5.5rem, 9.5rem) minmax(0, 1fr);
		gap: 0.25rem 1.25rem;
		margin-top: 1rem;
		padding: 1rem 1.1rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background:
			radial-gradient(ellipse at 12% 25%, var(--sl-color-accent-low), transparent 62%),
			var(--ig-surface);
		font-size: var(--sl-text-base);
		line-height: 1.45;
		color: var(--sl-color-white);
	}
	.ccard p {
		margin: 0;
	}
	.ccard__emblem {
		align-self: center;
		text-align: center;
	}
	.ccard__sky {
		min-height: 4rem;
	}
	.ccard__sky .cs--mini {
		width: 100%;
		--cs-dim: var(--sl-color-gray-3);
	}
	/* in the card the figure of the constellation shows faintly before its stars are lit */
	.ccard__sky .cs__lines line:not(.is-lit) {
		opacity: 0.35;
		stroke: var(--sl-color-gray-4);
	}
	.ccard__skyname {
		margin-top: 0.3rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ccard__kicker {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--sl-color-text-accent);
	}
	.ccard__meta {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ccard .ccard__h {
		margin-top: 0.65rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.ccard__goals {
		display: grid;
		gap: 0.3rem;
		margin: 0.35rem 0 0;
		padding: 0;
		list-style: none;
	}
	.ccard__goal {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}
	.ccard__tick {
		flex: none;
		display: grid;
		place-items: center;
		width: 1.15rem;
		height: 1.15rem;
		border: 1.5px solid var(--sl-color-gray-4);
		border-radius: 50%;
	}
	.ccard__goal.is-done {
		color: var(--sl-color-text-accent);
	}
	.ccard__goal.is-done .ccard__tick {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
	}
	.ccard__goal.is-done .ccard__tick::after {
		content: '';
		width: 0.3rem;
		height: 0.55rem;
		margin-top: -0.12rem;
		border: solid var(--sl-color-black);
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
	}
	.ccard .ccard__legend {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.9rem;
		margin-top: 0.75rem;
	}
	.ccard__legend-h {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ccard__foot {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-top: 0.8rem;
		padding-top: 0.8rem;
		border-top: 1px dashed var(--sl-color-gray-5);
	}
	.ccard__seg {
		display: inline-flex;
		padding: 2px;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
	}
	.ccard__segbtn,
	.ccard__btn,
	.igs-toggle {
		min-height: 40px;
		margin: 0;
		padding: 0 1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.2;
		border-radius: 999px;
		cursor: pointer;
	}
	.ccard__segbtn {
		border: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
	}
	.ccard__segbtn[aria-pressed='true'] {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.ccard__btn,
	.igs-toggle {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.ccard__btn:hover,
	.igs-toggle:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.ccard__btn--primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.ccard__btn--primary:hover {
		color: var(--sl-color-black);
	}
	.ccard :focus-visible,
	.konspekt :focus-visible,
	.igs-toggle:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.ccard__link {
		margin-left: auto;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
	.ccard .ccard__short {
		flex-basis: 100%;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.ccard__short[hidden] {
		display: none;
	}
	@media (max-width: 30rem) {
		.ccard {
			grid-template-columns: 5.5rem minmax(0, 1fr);
			gap: 0.25rem 0.85rem;
			padding: 0.85rem 0.85rem 0.8rem;
		}
		.ccard__emblem {
			align-self: start;
		}
	}

	/* ---------- «Коротко»: the optional sections fold to their headings ---------- */
	html[data-ig-short='1'] [data-igs-fold]:not([data-igs-open]) {
		display: none !important;
	}
	.igs-toggle {
		display: none;
		min-height: 34px;
		margin-left: 0.75rem;
		padding: 0 0.8rem;
		vertical-align: middle;
		font-family: var(--sl-font);
		color: var(--sl-color-gray-2);
	}
	html[data-ig-short='1'] .igs-toggle {
		display: inline-flex;
	}
	/* a folded model: its bar keeps the mark and «Показать модель»; «Полный экран» comes back with the model */
	.igf-bar .igs-toggle {
		margin-left: 0.6rem;
		margin-right: auto;
	}
	html[data-ig-short='1'] .igf-bar[data-igs-head]:not([data-igs-open]) .igf-open {
		display: none;
	}
	html[data-ig-short='1'] .sl-markdown-content .igf-bar[data-igs-head]:not([data-igs-open]) {
		justify-content: flex-start;
		padding: 0.35rem 0.75rem;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.8rem;
	}
	html[data-ig-short='1'] .sl-heading-wrapper[data-igs-head]:not([data-igs-open]) h3 {
		color: var(--sl-color-gray-2);
	}
	html[data-ig-short='1'] .sl-markdown-content .sl-heading-wrapper[data-igs-head]:not([data-igs-open]) {
		margin-top: 1.1rem;
	}
	html[data-ig-short='1'] .sl-heading-wrapper[data-igs-head]:not([data-igs-open]) h2 {
		font-size: 1.9rem;
		color: var(--sl-color-gray-2);
	}

	/* ---------- «Конспект главы» ---------- */
	.konspekt {
		width: min(100vw, 58rem);
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0 auto;
		padding: 0;
		border: 0;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
	}
	.konspekt[open] {
		display: flex;
		flex-direction: column;
	}
	.konspekt::backdrop {
		background: hsl(230 40% 4% / 0.82);
	}
	.konspekt__bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg-nav);
	}
	.konspekt__bar > :last-child {
		margin-left: auto;
	}
	.konspekt__scroll {
		flex: 1;
		min-height: 0;
		overflow: auto;
		overscroll-behavior: contain;
		padding: 1rem;
	}
	.konspekt__sheet {
		max-width: 50rem;
		margin: 0 auto;
		padding: 1.4rem 1.6rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
		line-height: 1.45;
	}
	.konspekt__sheet p {
		margin: 0;
	}
	.konspekt__kicker {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--sl-color-text-accent);
	}
	.konspekt__title {
		margin: 0.15rem 0 0.9rem;
		font-family: var(--ig-font-display);
		font-size: clamp(2rem, 6vw, 2.9rem);
		font-weight: 400;
		line-height: 1.1;
		color: var(--sl-color-white);
	}
	.konspekt__list {
		margin: 0;
		padding: 0;
		list-style: none;
		columns: 2 19rem;
		column-gap: 2rem;
	}
	.konspekt__item {
		break-inside: avoid;
		padding: 0.6rem 0 0.7rem;
		border-top: 1px dashed var(--sl-color-gray-5);
	}
	.konspekt__name {
		font-weight: 700;
		color: var(--sl-color-text-accent);
	}
	.konspekt__tex {
		margin: 0.4rem 0 0.2rem;
		overflow-x: auto;
	}
	.konspekt__tex .katex-display {
		margin: 0;
		text-align: left;
	}
	.konspekt__tex .katex-display > .katex {
		text-align: left;
	}
	.konspekt__sheet .konspekt__def {
		margin-top: 0.25rem;
	}
	.konspekt__sheet .kf-sym {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.konspekt__sheet .konspekt__note {
		margin-top: 0.3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.konspekt__foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-top: 0.4rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media print {
		html.ig-print-konspekt body > :not(.konspekt) {
			display: none !important;
		}
		html.ig-print-konspekt,
		html.ig-print-konspekt body {
			background: #fff !important;
		}
		html.ig-print-konspekt .konspekt {
			position: static;
			display: block;
			width: auto;
			height: auto;
			max-height: none;
			overflow: visible;
			background: #fff;
		}
		html.ig-print-konspekt .konspekt__bar {
			display: none;
		}
		html.ig-print-konspekt .konspekt__scroll {
			overflow: visible;
			padding: 0;
		}
		html.ig-print-konspekt .konspekt__sheet {
			max-width: none;
			padding: 0;
			border: 0;
			background: #fff;
		}
	}
</style>
