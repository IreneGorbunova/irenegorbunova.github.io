---
// The on/off switch of test mode on /uchebnik/test/ (src/plugins/testmode.mjs).
---

<p class="ig-testswitch">
	<button type="button" data-testswitch></button>
	<span data-testswitch-state></span>
</p>

<script>
	const KEY = 'ig:test';
	const btn = document.querySelector<HTMLButtonElement>('[data-testswitch]');
	const state = document.querySelector<HTMLElement>('[data-testswitch-state]');
	const isOn = () => {
		try {
			return localStorage.getItem(KEY) === '1';
		} catch {
			return false;
		}
	};
	const paint = () => {
		const on = isOn();
		if (btn) btn.textContent = on ? 'Выключить тестовый режим' : 'Включить тестовый режим';
		if (state) state.textContent = on ? 'Сейчас включён на этом устройстве.' : 'Сейчас выключен.';
		if (on) document.documentElement.dataset.igTestmode = '1';
		else delete document.documentElement.dataset.igTestmode;
	};
	btn?.addEventListener('click', () => {
		try {
			if (isOn()) localStorage.removeItem(KEY);
			else localStorage.setItem(KEY, '1');
		} catch {}
		paint();
	});
	paint();
</script>

<style>
	.ig-testswitch {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.ig-testswitch button {
		padding: 0.55rem 1.1rem;
		border: 0;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
</style>
