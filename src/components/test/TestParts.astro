---
// Mounts, on every textbook page, each component found in ./global/ (test mode, src/plugins/testmode.mjs).
// A pilot feature that needs a script or markup on every page puts one component there; nothing else is edited.
const mods = import.meta.glob<{ default: any }>('./global/*.astro', { eager: true });
const parts = Object.keys(mods)
	.sort()
	.map((k) => mods[k].default);
---

{parts.map((Part) => <Part />)}
