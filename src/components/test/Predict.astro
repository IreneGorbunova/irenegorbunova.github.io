---
/**
 * «Сначала предскажите, потом проверьте» (pilot, test mode only): a question before a model. The pupil fixes a
 * prediction, does the action in the model, and the verdict appears when the model reports that action
 * (CustomEvent 'ig:model-state' on its root, predict/triggers.ts) or after «Я проверил(а)».
 *
 * Usage: put it right before the model, on its own line:  <Predict id="kt-race-last" />  then  <HeatRace />.
 * The texts live in predict/questions.ts. gate={false} switches off the veil over the model.
 * Without test mode the block is display: none (data-ig-test) and its script does nothing, so the page and the
 * model stay exactly as approved. The block never touches the model's DOM: the veil is its own element laid over
 * the model's box.
 */
import { QUESTIONS } from './predict/questions';
import { html } from './predict/text';

interface Props {
	id: string;
	gate?: boolean;
}
const { id, gate = true } = Astro.props;
const q = QUESTIONS[id];
if (!q) throw new Error(`Predict: no question «${id}» in src/components/test/predict/questions.ts`);
if (q.myths.length !== q.options.length) throw new Error(`Predict «${id}»: one myth per option`);
const qid = `igp-${id}`;
const star = 'M12 1.5 L14.2 9.8 L22.5 12 L14.2 14.2 L12 22.5 L9.8 14.2 L1.5 12 L9.8 9.8 Z';
---

<div
	class="igp not-content"
	data-ig-test
	data-pagefind-ignore
	data-predict={id}
	data-answer={q.answer}
	data-trigger={q.trigger ?? ''}
	data-gate={gate ? '1' : '0'}
>
	<p class="igp__label">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d={star}></path></svg>
		Сначала предскажите
	</p>
	<p class="igp__q" id={qid} set:html={html(q.question)} />
	<div class="igp__opts" role="group" aria-labelledby={qid}>
		{
			q.options.map((o, i) => (
				<button type="button" class="igp__opt" data-opt={i} aria-pressed="false">
					<span class="igp__mark" aria-hidden="true" />
					<span class="igp__txt">
						<span class="igp__tag" data-tag />
						<span set:html={html(o)} />
					</span>
				</button>
			))
		}
	</div>
	<div class="igp__say" data-say aria-live="polite"></div>
	<div class="igp__foot" data-foot hidden>
		<button type="button" class="igp__done" data-done hidden>Я проверил(а)</button>
		<button type="button" class="igp__again" data-again>Спросить заново</button>
	</div>

	<div class="igp__veil" data-veil hidden>
		<div class="igp__veil-msg">
			<p>Сначала сделайте прогноз</p>
			<button type="button" class="igp__skip" data-skip>Пропустить</button>
		</div>
	</div>
	<button type="button" class="igp__pill" data-pill hidden>Итог вашего прогноза ↑</button>

	<template data-t="check"><p class="igp__check"><b>Теперь проверьте на модели.</b> <Fragment set:html={html(q.check)} /></p></template>
	{
		q.options.map((_, i) => (
			<template data-t={`v${i}`}>
				<div class="igp__verdict" data-kind={i === q.answer ? 'yes' : 'no'}>
					<p class="igp__vhead">{i === q.answer ? 'Прогноз подтвердился' : 'Получилось иначе'}</p>
					<p set:html={html(`${q.outcome} ${i === q.answer ? q.reason : q.myths[i]}`)} />
				</div>
			</template>
		))
	}
</div>

<style is:global>
	.igp {
		position: relative;
		z-index: 2; /* the veil lies over the model that follows */
		margin-block: 1.5rem 0;
		padding: 0.9rem 1rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		background: var(--ig-surface);
	}
	.igp [hidden] {
		display: none !important;
	}
	.igp i {
		font-family: var(--ig-font-math);
	}
	.igp__label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.4rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--sl-color-text-accent);
	}
	.igp__label svg {
		width: 0.95em;
		height: 0.95em;
		fill: currentColor;
		flex: none;
	}
	.igp__q {
		margin: 0 0 0.75rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.igp__opts {
		display: grid;
		gap: 0.5rem;
	}
	.igp__opt {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		width: 100%;
		min-height: 3rem;
		margin: 0;
		padding: 0.55rem 0.9rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.75rem;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-base);
		line-height: 1.35;
		text-align: left;
		cursor: pointer;
		transition:
			background 0.25s,
			border-color 0.25s,
			opacity 0.25s;
	}
	.igp__opt:hover {
		border-color: var(--sl-color-accent);
	}
	.igp__opt:focus-visible,
	.igp__done:focus-visible,
	.igp__again:focus-visible,
	.igp__skip:focus-visible,
	.igp__pill:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.igp__txt {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
	}
	.igp__mark {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		border: 1.5px solid var(--sl-color-gray-3);
		border-radius: 50%;
		font-size: 0.75rem;
		line-height: 1;
	}
	.igp__tag {
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		white-space: nowrap;
	}
	.igp__tag:empty {
		display: none;
	}
	.igp.is-locked .igp__opt {
		cursor: default;
	}
	.igp.is-locked .igp__opt:hover {
		border-color: var(--sl-color-gray-4);
	}
	.igp.is-locked .igp__opt:not(.is-chosen, .is-outcome) {
		opacity: 0.5;
	}
	.igp__opt.is-chosen,
	.igp.is-locked .igp__opt.is-chosen:hover {
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
	}
	.igp__opt.is-chosen .igp__mark {
		border-color: var(--sl-color-accent);
		background: radial-gradient(circle, var(--sl-color-accent) 0 42%, transparent 46%);
	}
	.igp__opt.is-outcome,
	.igp.is-locked .igp__opt.is-outcome:hover {
		border-color: var(--sl-color-green);
	}
	.igp__opt.is-outcome .igp__mark {
		border-color: var(--sl-color-green);
		background: var(--sl-color-green);
	}
	.igp__opt.is-outcome .igp__mark::after {
		content: '✓';
		color: var(--sl-color-black);
		font-weight: 700;
	}
	.igp__opt.is-outcome .igp__tag {
		background: var(--sl-color-green);
	}
	.igp__say {
		margin-top: 0.75rem;
	}
	.igp__say:empty {
		display: none;
	}
	.igp__check {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.igp__check b {
		color: var(--sl-color-white);
	}
	.igp__verdict {
		padding: 0.6rem 0.85rem;
		border-left: 3px solid var(--sl-color-green);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--sl-color-green) 12%, transparent);
		animation: igp-in 0.45s ease-out;
	}
	.igp__verdict[data-kind='no'] {
		border-left-color: var(--sl-color-orange);
		background: color-mix(in srgb, var(--sl-color-orange) 12%, transparent);
	}
	.igp__verdict p {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}
	.igp__verdict .igp__vhead {
		margin-bottom: 0.2rem;
		font-size: var(--sl-text-base);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	@keyframes igp-in {
		from {
			opacity: 0;
			transform: translateY(0.4rem);
		}
	}
	.igp__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin-top: 0.5rem;
	}
	.igp__done {
		min-height: 2.75rem;
		margin: 0;
		padding: 0.45rem 1.1rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		cursor: pointer;
	}
	.igp__again,
	.igp__skip {
		min-height: 2.75rem;
		margin: 0;
		padding: 0 0.3rem;
		border: 0;
		background: none;
		color: var(--sl-color-gray-3);
		font: inherit;
		font-size: var(--sl-text-sm);
		text-decoration: underline;
		text-decoration-style: dotted;
		text-underline-offset: 0.2em;
		cursor: pointer;
	}
	.igp__again:hover,
	.igp__skip:hover {
		color: var(--sl-color-text-accent);
	}

	/* the veil over the model: laid over the model's box by the script, the message follows the scroll */
	.igp__veil {
		position: absolute;
		z-index: 1;
		box-sizing: border-box;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding: 2rem 1rem;
		/* light: the setup stays readable for the prediction, but clearly not active yet */
		background: color-mix(in srgb, var(--sl-color-bg) 55%, transparent);
		cursor: pointer;
	}
	.igp__veil-msg {
		position: sticky;
		top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height) + 1.5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0.75rem 1.25rem 0.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		background: var(--ig-surface);
		box-shadow: 0 0.5rem 1.5rem color-mix(in srgb, var(--sl-color-black) 35%, transparent);
		text-align: center;
		cursor: default;
	}
	.igp__veil-msg p {
		margin: 0;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.igp__veil-msg p::before {
		content: '↑ ';
		color: var(--sl-color-text-accent);
	}

	/* after the verdict, while it is off screen */
	.igp__pill {
		position: fixed;
		left: 50%;
		bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
		z-index: 5;
		min-height: 2.75rem;
		margin: 0;
		padding: 0.45rem 1.2rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		background: var(--ig-surface);
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		white-space: nowrap;
		box-shadow: 0 0.4rem 1.2rem color-mix(in srgb, var(--sl-color-black) 40%, transparent);
		transform: translateX(-50%);
		cursor: pointer;
		animation: igp-fade 0.35s ease-out;
	}
	@keyframes igp-fade {
		from {
			opacity: 0;
		}
	}
	@media (max-width: 30rem) {
		.igp {
			padding: 0.8rem 0.75rem 0.9rem;
		}
		.igp__opt {
			padding-inline: 0.75rem;
		}
	}
</style>

<script>
	import { mount } from './predict/client';

	if (document.documentElement.dataset.igTestmode === '1') {
		// the script may be inlined once per block: mount each block once
		for (const root of document.querySelectorAll<HTMLElement>('[data-predict]:not([data-igp-on])')) {
			root.dataset.igpOn = '';
			mount(root);
		}
	}
</script>
