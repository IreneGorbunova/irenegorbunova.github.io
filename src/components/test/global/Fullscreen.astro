---
// «Полный экран» (test mode): a button above every model of a chapter opens the model on the whole screen, laid out
// to use the screen (../fullscreen/). On a page that is not a chapter nothing is rendered; on a chapter without test
// mode only a tiny loader runs and returns.
import Loader from '../fullscreen/Loader.astro';

const id = Astro.locals.starlightRoute?.entry?.id ?? '';
const isChapter = /^uchebnik\/\d+-klass\/[^/]+\/[^/]+$/.test(id);
---

{isChapter && <Loader />}
