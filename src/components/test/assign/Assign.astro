---
/**
 * «Задание классу» (pilot, 14 Nov 2026): the page /uchebnik/test/zadanie/.
 * Without a fragment it is the teacher's page: create an assignment (topic, number of tasks) → a link with a QR code;
 * check the pupils' result codes. With #a=… it is the pupil's page: their own variant, each answer checked once,
 * then a result code for the teacher. Everything stays in the browser (localStorage 'ig:assign', 'ig:assign-made').
 */
import { MAX_TASKS, MIN_TASKS } from './code';
import { TOPICS } from './topics';

const counts = Array.from({ length: MAX_TASKS - MIN_TASKS + 1 }, (_, i) => MIN_TASKS + i);
---

<div class="za not-content" data-za data-pagefind-ignore>
	<p class="za__nojs" data-za-nojs>Чтобы создать задание или решить его, включите в браузере JavaScript.</p>

	<section class="za__teacher" data-za-teacher hidden>
		<p class="za__lead">
			Задание для домашней работы: каждый ученик получит по ссылке свой вариант задач из тренажёра «Решите сами», введёт ответы и пришлёт вам короткий код с результатом.
		</p>
		<form class="za__card za__form" data-za-form>
			<label class="za__field">
				<span>Тема</span>
				<select class="za__select" data-za-topic>
					{Object.entries(TOPICS).map(([code, t]) => <option value={code}>{t.title}</option>)}
				</select>
			</label>
			<label class="za__field">
				<span>Число задач</span>
				<select class="za__select za__select--short" data-za-count>
					{counts.map((n) => <option value={n} selected={n === 5}>{n}</option>)}
				</select>
			</label>
			<button type="submit" class="za__btn za__btn--primary">Создать задание</button>
		</form>

		<div class="za__card za__made" data-za-made hidden>
			<p class="za__h">Задание готово</p>
			<p class="za__what" data-za-what></p>
			<div class="za__made-grid">
				<div class="za__qr" data-za-qr></div>
				<div class="za__made-text">
					<label class="za__field za__field--wide">
						<span>Ссылка для учеников</span>
						<input class="za__input za__input--link" type="text" readonly data-za-link />
					</label>
					<p class="za__row">
						<button type="button" class="za__btn za__btn--primary" data-za-copy>Скопировать ссылку</button>
						<a class="za__btn" data-za-try target="_blank" rel="noopener">Открыть как ученик</a>
					</p>
					<p class="za__done" data-za-copied aria-live="polite"></p>
					<p class="za__note">Отправьте ссылку в чат класса или покажите QR-код на уроке. Это задание сохранится на этом устройстве в списке ниже.</p>
				</div>
			</div>
		</div>

		<p class="za__h2">Проверить коды</p>
		<form class="za__card za__check" data-za-check>
			<label class="za__field za__field--wide">
				<span>Задание</span>
				<select class="za__select" data-za-pick></select>
			</label>
			<label class="za__field za__field--wide">
				<span>или ссылка на задание</span>
				<input class="za__input" type="text" inputmode="url" spellcheck="false" placeholder="https://…/zadanie/#a=…" data-za-paste />
			</label>
			<label class="za__field za__field--wide">
				<span>Коды учеников — по одному в строке, перед кодом можно написать имя</span>
				<textarea class="za__input za__codes" rows="6" spellcheck="false" placeholder="Иванов Пётр 3Y4KW-KJWKN" data-za-codes></textarea>
			</label>
			<p class="za__row">
				<button type="submit" class="za__btn za__btn--primary">Проверить</button>
			</p>
			<p class="za__done" data-za-check-msg aria-live="polite"></p>
			<div class="za__table-wrap" data-za-table></div>
		</form>
		<p class="za__honest">
			Код защищён только контрольной суммой в скрипте страницы, поэтому такое задание подходит для домашней работы, а не для контрольной с отметкой.
		</p>
	</section>

	<section class="za__pupil" data-za-pupil hidden></section>

	<p class="za__card za__bad" data-za-bad hidden>
		Ссылка на задание повреждена или неполная. Попросите учителя прислать её ещё раз.
	</p>
</div>

<style is:global>
	.za {
		margin-top: 1rem;
	}
	.za [hidden] {
		display: none !important;
	}
	.za__nojs {
		color: var(--sl-color-gray-2);
	}
	.za__lead {
		margin: 0 0 1.25rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--sl-color-white);
	}
	.za__card {
		margin: 0 0 1.5rem;
		padding: 1.1rem 1.25rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.za__form {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 0.9rem 1.25rem;
	}
	.za__field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.za__field--wide {
		width: 100%;
	}
	.za__field + .za__field--wide,
	.za__field--wide + .za__field--wide {
		margin-top: 0.9rem;
	}
	.za__select,
	.za__input {
		box-sizing: border-box;
		min-height: 44px;
		max-width: 100%;
		padding: 0.5rem 0.75rem;
		font: inherit;
		font-size: 1rem;
		color: var(--sl-color-white);
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.6rem;
	}
	.za__select--short {
		width: 6rem;
	}
	.za__input--link {
		width: 100%;
		font-size: var(--sl-text-sm);
	}
	.za__codes {
		width: 100%;
		min-height: 9rem;
		font-family: var(--__sl-font-mono, ui-monospace, monospace);
		line-height: 1.5;
		resize: vertical;
	}
	.za__select:focus,
	.za__input:focus {
		outline: none;
		border-color: var(--sl-color-accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
	}
	.za__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		margin: 0;
		padding: 0 1.1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		background: transparent;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		cursor: pointer;
	}
	.za__btn:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.za__btn--primary {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.za__btn--primary:hover {
		filter: brightness(1.08);
		color: var(--sl-color-black);
	}
	.za__btn:disabled {
		opacity: 0.55;
		cursor: default;
		filter: none;
	}
	.za__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.9rem 0 0;
	}
	.za__h {
		margin: 0;
		font-family: var(--ig-font-display);
		font-size: 1.9rem;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.za__h2 {
		margin: 2rem 0 0.75rem;
		font-family: var(--ig-font-display);
		font-size: 2.1rem;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.za__what {
		margin: 0.25rem 0 1rem;
		color: var(--sl-color-gray-2);
	}
	.za__made-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: flex-start;
	}
	.za__qr {
		flex: none;
		width: 168px;
		height: 168px;
		border-radius: 0.6rem;
		overflow: hidden;
		background: #fff;
	}
	.za__qr svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	.za__made-text {
		flex: 1 1 18rem;
		min-width: 0;
	}
	.za__done {
		min-height: 1.4em;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-green-high);
	}
	.za__note,
	.za__honest {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-3);
	}
	.za__honest {
		margin-top: -0.5rem;
	}
	.za__bad {
		color: var(--sl-color-white);
	}

	/* the teacher's table */
	.za__table-wrap {
		overflow-x: auto;
		margin-top: 0.75rem;
	}
	.za__table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
	}
	.za__table th,
	.za__table td {
		padding: 0.5rem 0.6rem;
		text-align: left;
		vertical-align: middle;
		border-bottom: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-white);
	}
	.za__table th {
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}
	.za__marks {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.25rem;
	}
	.za__mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.7rem;
		height: 1.7rem;
		padding: 0 0.3rem;
		border-radius: 0.45rem;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		border: 1px solid var(--sl-color-gray-4);
	}
	.za__mark.is-ok {
		color: var(--sl-color-black);
		background: var(--sl-color-green);
		border-color: var(--sl-color-green);
	}
	.za__mark.is-bad {
		color: var(--sl-color-red);
		border-color: var(--sl-color-red);
	}
	.za__status {
		min-width: 9.5rem;
	}
	.za__status.is-ok {
		color: var(--sl-color-green-high);
	}
	.za__status.is-bad {
		color: var(--sl-color-red-high);
	}
	.za__btn--small {
		min-height: 36px;
		padding: 0 0.8rem;
		font-size: var(--sl-text-xs);
		white-space: nowrap;
	}
	.za__var td {
		padding: 0.75rem 0.6rem 1rem;
		background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
	}
	.za__var ol {
		margin: 0;
		padding-left: 1.4em;
	}
	.za__var li + li {
		margin-top: 0.6rem;
	}
	.za__var-ans {
		display: block;
		margin-top: 0.2rem;
		color: var(--sl-color-gray-2);
	}

	/* the pupil's page */
	.za__meta {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.za__task {
		margin: 0 0 1rem;
		padding: 1rem 1.15rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.za__task.is-ok {
		border-color: color-mix(in srgb, var(--sl-color-green) 60%, var(--sl-color-gray-5));
	}
	.za__task.is-bad {
		border-color: color-mix(in srgb, var(--sl-color-red) 60%, var(--sl-color-gray-5));
	}
	.za__task-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.za__task-state.is-ok {
		color: var(--sl-color-green-high);
		font-weight: 600;
	}
	.za__task-state.is-bad {
		color: var(--sl-color-red-high);
		font-weight: 600;
	}
	.za__task-text {
		margin-top: 0.5rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--sl-color-white);
	}
	.za__answer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 0.75rem;
		margin-top: 0.9rem;
	}
	.za__answer label {
		color: var(--sl-color-gray-2);
	}
	.za__answer .za__input {
		width: 8.5rem;
		font-size: 1.1rem;
		font-variant-numeric: tabular-nums;
	}
	.za__answer .za__input:disabled {
		opacity: 1;
		color: var(--sl-color-gray-2);
		background: transparent;
	}
	.za__unit {
		white-space: nowrap;
		color: var(--sl-color-white);
	}
	.za__fb {
		min-height: 1.5em;
		margin: 0.7rem 0 0;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.za__fb b {
		color: var(--sl-color-white);
	}
	.za__fb.is-ok b {
		color: var(--sl-color-green-high);
	}
	.za__fb.is-bad b {
		color: var(--sl-color-red-high);
	}
	.za__sol {
		margin-top: 0.75rem;
	}
	.za__sol summary {
		min-height: 44px;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		list-style: none;
		cursor: pointer;
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	.za__sol summary::-webkit-details-marker {
		display: none;
	}
	.za__sol summary::before {
		content: '';
		width: 0.45em;
		height: 0.45em;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(-45deg);
		transition: transform 0.15s;
	}
	.za__sol[open] summary::before {
		transform: rotate(45deg);
	}
	.za__status small {
		color: var(--sl-color-gray-3);
	}
	.za__sol ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.za__sol li p {
		margin: 0.4rem 0 0;
	}
	.za__sol .katex-display {
		margin: 0.4rem 0;
		overflow-x: auto;
		overflow-y: hidden;
	}
	.za__progress {
		margin: 0 0 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.za__result {
		margin: 1.5rem 0 0;
		padding: 1.25rem;
		text-align: center;
		border: 1px solid var(--sl-color-accent);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.za__score {
		margin: 0;
		font-family: var(--ig-font-display);
		font-size: 2.6rem;
		line-height: 1.15;
		color: var(--sl-color-white);
	}
	.za__code {
		display: inline-block;
		margin: 0.75rem 0 0.25rem;
		padding: 0.4rem 0.9rem;
		font-family: var(--__sl-font-mono, ui-monospace, monospace);
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--sl-color-white);
		background: var(--sl-color-bg);
		border: 1px dashed var(--sl-color-gray-3);
		border-radius: 0.6rem;
		user-select: all;
	}
	.za__result .za__row {
		justify-content: center;
	}
	.za__result p {
		margin: 0.5rem 0 0;
	}
</style>

<script>
	import { start } from './assign';
	start();
</script>
