---
/**
 * A chapter's thumbnail on the course map: its first opening scene, one picture per theme (scripts/make-thumbs.mjs);
 * the one of the other theme stays display: none and, being lazy, is not even fetched. A chapter without an opening
 * scene gets a neutral night sky. Decorative: the chapter's title always stands next to it.
 */
interface Props {
	dark?: ImageMetadata;
	light?: ImageMetadata;
}
// always lazy, even at the top of the page: an eager image is fetched even when display: none
const { dark, light } = Astro.props;
const loading = 'lazy';
---

<span class="kthumb">
	{
		dark && light ? (
			<>
				<img class="kthumb__img kthumb__img--dark" src={dark.src} width={dark.width} height={dark.height} alt="" loading={loading} decoding="async" />
				<img class="kthumb__img kthumb__img--light" src={light.src} width={light.width} height={light.height} alt="" loading={loading} decoding="async" />
			</>
		) : (
			<span class="kthumb__none" aria-hidden="true" />
		)
	}
</span>
