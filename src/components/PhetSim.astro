---
/** Embedded PhET simulation (Russian version). */
interface Props {
	sim: string;
	title: string;
}
const { sim, title } = Astro.props;
const src = `https://phet.colorado.edu/sims/html/${sim}/latest/${sim}_ru.html`;
---

<figure class="phet not-content">
	<div class="phet__frame">
		<iframe src={src} title={title} loading="lazy" allowfullscreen></iframe>
	</div>
	<figcaption>
		«{title}» — <a href="https://phet.colorado.edu/ru/">PhET Interactive Simulations</a>,
		University of Colorado Boulder,
		<a href="https://creativecommons.org/licenses/by/4.0/deed.ru">CC BY 4.0</a>.
		<a href={src} target="_blank" rel="noopener">Открыть во весь экран</a>
	</figcaption>
</figure>

<style>
	.phet {
		margin-block: 2rem;
	}
	.phet__frame {
		aspect-ratio: 5 / 3;
		border-radius: 1rem;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	figcaption a {
		color: var(--sl-color-text-accent);
	}
</style>
