---
/**
 * The opening of a chapter: the law of the chapter met in everyday life, as 2–4 short looping scenes above the
 * formula cards. Each child is a card:
 *   <div class="intro__card" data-scene="…">
 *     <svg class="intro__svg" viewBox="0 0 360 240" role="img" aria-label="…">…</svg>
 *     <div class="intro__foot"><p>Caption; its key statement opens the explanation: <More term="…statement…">…</More></p>
 *       <button type="button" class="intro__again" data-again>Повторить</button></div>
 *   </div>
 * and the chapter's component animates it with `scene()` from ./scene.ts. Two columns on wide screens, one on phones.
 */
interface Props {
	[key: `data-${string}`]: string | boolean | undefined;
}
const rest = Astro.props;
---

<figure class="intro not-content" {...rest}>
	<div class="intro__grid">
		<slot />
	</div>
</figure>

<style is:global>
	.intro {
		margin-block: 1.5rem 2rem;
	}
	.intro__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.intro__card {
		display: flex;
		flex-direction: column;
		padding: 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--ig-surface);
	}
	.intro__svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		user-select: none;
		-webkit-user-select: none;
	}
	.intro text {
		font-family: var(--__sl-font);
	}
	.intro__foot {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.intro__foot p {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
	}
	.intro__again {
		flex: none;
		margin: 0;
		font: inherit;
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-4);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.intro__again:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.intro__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
